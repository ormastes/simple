# Off-Heap Message Queue (PriorityMailbox)
#
# Provides actor mailbox with priority support.

use types.{Capacity, MessageId, SenderId, ByteSize, Timestamp, Count}

# --- MessagePriority enum ---

enum MessagePriority:
    High
    Normal
    Low

    static fn to_i64(p: MessagePriority) -> i64:
        if p == MessagePriority.High: return 0
        if p == MessagePriority.Normal: return 1
        2

# --- SendResult enum ---

enum SendResult:
    Success
    QueueFull
    MailboxClosed

val SEND_SUCCESS = SendResult.Success
val SEND_QUEUE_FULL = SendResult.QueueFull
val SEND_MAILBOX_CLOSED = SendResult.MailboxClosed
val PRIORITY_MAILBOX_DEFAULT_CAPACITY: i64 = 1000

fn priority_mailbox_effective_capacity(requested: i64) -> i64:
    """Resolve an invalid capacity to the finite compatibility default."""
    if requested > 0:
        return requested
    PRIORITY_MAILBOX_DEFAULT_CAPACITY

fn priority_mailbox_effective_reserve(requested: i64, capacity: i64) -> i64:
    """Clamp priority reserve to the normalized finite queue capacity."""
    if requested <= 0:
        return 0
    if requested >= capacity:
        return capacity
    requested

# --- MailboxConfig ---

class MailboxConfig:
    capacity: Capacity
    off_heap: bool
    priority_enabled: bool
    high_priority_reserve: Capacity

    static fn with_priority() -> MailboxConfig:
        MailboxConfig(capacity: Capacity(value: PRIORITY_MAILBOX_DEFAULT_CAPACITY), off_heap: true, priority_enabled: true, high_priority_reserve: Capacity(value: 100))

    static fn unbounded() -> MailboxConfig:
        """Compatibility constructor; zero is no longer an unbounded mode."""
        MailboxConfig.default()

    static fn bounded(cap: Capacity) -> MailboxConfig:
        val capacity = priority_mailbox_effective_capacity(cap.value)
        MailboxConfig(capacity: Capacity(value: capacity), off_heap: true, priority_enabled: false, high_priority_reserve: Capacity(value: 0))

    static fn default() -> MailboxConfig:
        MailboxConfig(capacity: Capacity(value: PRIORITY_MAILBOX_DEFAULT_CAPACITY), off_heap: true, priority_enabled: false, high_priority_reserve: Capacity(value: 100))

# --- MessageRef ---

class MessageRef:
    id: MessageId
    sender_id: SenderId
    has_sender: bool
    priority: MessagePriority
    size_bytes: ByteSize
    timestamp_ms: Timestamp

    fn age_ms() -> i64:
        0

    fn is_stale(threshold_ms: i64) -> bool:
        self.age_ms() > threshold_ms

    static fn new(msg_id: i64, sender, priority: MessagePriority, size_bytes: i64, timestamp: i64) -> MessageRef:
        var sid = 0
        var has_s = false
        if sender.?:
            sid = sender
            has_s = true
        MessageRef(id: MessageId(value: msg_id), sender_id: SenderId(value: sid), has_sender: has_s, priority: priority, size_bytes: ByteSize(value: size_bytes), timestamp_ms: Timestamp(value: timestamp))

# --- MailboxStats ---

class MailboxStats:
    current_size: Count
    total_received: Count
    total_processed: Count
    total_dropped: Count
    off_heap_bytes: ByteSize
    peak_size: Count
    high_priority_count: Count

    fn throughput() -> f64:
        if self.total_received.value == 0:
            return 0.0
        self.total_processed.value * 1.0 / self.total_received.value

    fn drop_rate() -> f64:
        if self.total_received.value == 0:
            return 0.0
        self.total_dropped.value * 100.0 / self.total_received.value

    fn fmt() -> text:
        "MailboxStats(received={self.total_received.value}, processed={self.total_processed.value})"

    static fn new() -> MailboxStats:
        MailboxStats(current_size: Count(value: 0), total_received: Count(value: 0), total_processed: Count(value: 0), total_dropped: Count(value: 0), off_heap_bytes: ByteSize(value: 0), peak_size: Count(value: 0), high_priority_count: Count(value: 0))

# --- PriorityMailbox ---

class PriorityMailbox:
    config: MailboxConfig
    messages: [MessageRef]
    messages_ready: [MessageRef]
    high_messages: [MessageRef]
    high_messages_ready: [MessageRef]
    next_id: i64
    is_closed: bool
    stats: MailboxStats

    me send_normal(data_ref: i64, size_bytes: i64, sender) -> SendResult:
        self.send_with_priority(data_ref, size_bytes, sender, MessagePriority.Normal)

    me send_high(data_ref: i64, size_bytes: i64, sender) -> SendResult:
        self.send_with_priority(data_ref, size_bytes, sender, MessagePriority.High)

    me send_with_priority(data_ref: i64, size_bytes: i64, sender, priority: MessagePriority) -> SendResult:
        if self.is_closed:
            return SEND_MAILBOX_CLOSED
        val total = self.total_size()
        val is_high = priority == MessagePriority.High
        if not is_high:
            # Normal: respect capacity minus reserve.
            val effective_cap = self.config.capacity.value - self.config.high_priority_reserve.value
            if total >= effective_cap:
                self.stats.total_dropped = Count(value: self.stats.total_dropped.value + 1)
                self.stats.total_received = Count(value: self.stats.total_received.value + 1)
                return SEND_QUEUE_FULL
        else:
            # High priority: use the full finite capacity.
            if total >= self.config.capacity.value:
                self.stats.total_dropped = Count(value: self.stats.total_dropped.value + 1)
                self.stats.total_received = Count(value: self.stats.total_received.value + 1)
                return SEND_QUEUE_FULL
        val msg = MessageRef.new(self.next_id, sender, priority, size_bytes, 0)
        self.next_id = self.next_id + 1
        if is_high:
            self.high_messages.push(msg)
            self.stats.high_priority_count = Count(value: self.stats.high_priority_count.value + 1)
        else:
            self.messages.push(msg)
        self.stats.current_size = Count(value: self.stats.current_size.value + 1)
        self.stats.total_received = Count(value: self.stats.total_received.value + 1)
        self.stats.off_heap_bytes = ByteSize(value: self.stats.off_heap_bytes.value + size_bytes)
        if self.stats.current_size.value > self.stats.peak_size.value:
            self.stats.peak_size = self.stats.current_size
        SEND_SUCCESS

    me receive():
        # High priority first (two-stack queue: O(1) amortized dequeue)
        if self.high_messages_ready.len() == 0 and self.high_messages.len() > 0:
            self.high_messages.reverse()
            self.high_messages_ready = self.high_messages
            self.high_messages = []
        if self.high_messages_ready.len() > 0:
            val msg = self.high_messages_ready[self.high_messages_ready.len() - 1]
            self.high_messages_ready = self.high_messages_ready[0:self.high_messages_ready.len() - 1]
            self.stats.current_size = Count(value: self.stats.current_size.value - 1)
            self.stats.total_processed = Count(value: self.stats.total_processed.value + 1)
            self.stats.off_heap_bytes = ByteSize(value: self.stats.off_heap_bytes.value - msg.size_bytes.value)
            return msg
        # Normal priority (two-stack queue)
        if self.messages_ready.len() == 0 and self.messages.len() > 0:
            self.messages.reverse()
            self.messages_ready = self.messages
            self.messages = []
        if self.messages_ready.len() > 0:
            val msg = self.messages_ready[self.messages_ready.len() - 1]
            self.messages_ready = self.messages_ready[0:self.messages_ready.len() - 1]
            self.stats.current_size = Count(value: self.stats.current_size.value - 1)
            self.stats.total_processed = Count(value: self.stats.total_processed.value + 1)
            self.stats.off_heap_bytes = ByteSize(value: self.stats.off_heap_bytes.value - msg.size_bytes.value)
            return msg
        nil

    me select(pred: fn()):
        # High priority first, same precedence as receive()
        var hidx = self.high_messages_ready.len() - 1
        while hidx >= 0:
            val hmsg = self.high_messages_ready[hidx]
            if pred(hmsg):
                self.high_messages_ready.remove(hidx)
                self.stats.current_size = Count(value: self.stats.current_size.value - 1)
                self.stats.off_heap_bytes = ByteSize(
                    value: self.stats.off_heap_bytes.value - hmsg.size_bytes.value)
                return hmsg
            hidx = hidx - 1
        var hidx2 = 0
        for hmsg2 in self.high_messages:
            if pred(hmsg2):
                self.high_messages.remove(hidx2)
                self.stats.current_size = Count(value: self.stats.current_size.value - 1)
                self.stats.off_heap_bytes = ByteSize(
                    value: self.stats.off_heap_bytes.value - hmsg2.size_bytes.value)
                return hmsg2
            hidx2 = hidx2 + 1
        # Search ready queue first (oldest messages, FIFO order from the end)
        var idx = self.messages_ready.len() - 1
        while idx >= 0:
            val msg = self.messages_ready[idx]
            if pred(msg):
                self.messages_ready.remove(idx)
                self.stats.current_size = Count(value: self.stats.current_size.value - 1)
                self.stats.off_heap_bytes = ByteSize(
                    value: self.stats.off_heap_bytes.value - msg.size_bytes.value)
                return msg
            idx = idx - 1
        # Then search incoming queue (oldest first)
        var idx2 = 0
        for msg in self.messages:
            if pred(msg):
                self.messages.remove(idx2)
                self.stats.current_size = Count(value: self.stats.current_size.value - 1)
                self.stats.off_heap_bytes = ByteSize(
                    value: self.stats.off_heap_bytes.value - msg.size_bytes.value)
                return msg
            idx2 = idx2 + 1
        nil

    me select_by_sender(sid: i64):
        self.select(fn(m): m.sender_id.value == sid)

    fn total_size() -> i64:
        self.messages.len() + self.messages_ready.len() + self.high_messages.len() + self.high_messages_ready.len()

    fn is_empty() -> bool:
        self.total_size() == 0

    fn is_full() -> bool:
        self.total_size() >= self.config.capacity.value

    me clear():
        self.messages = []
        self.messages_ready = []
        self.high_messages = []
        self.high_messages_ready = []
        self.stats.current_size = Count(value: 0)
        self.stats.off_heap_bytes = ByteSize(value: 0)

    me drop_stale(threshold_ms: i64) -> i64:
        var dropped = 0
        var dropped_bytes = 0
        var new_msgs = []
        for msg in self.messages:
            if msg.is_stale(threshold_ms):
                dropped = dropped + 1
                dropped_bytes = dropped_bytes + msg.size_bytes.value
            else:
                new_msgs.push(msg)
        self.messages = new_msgs
        var new_msgs_ready = []
        for msg in self.messages_ready:
            if msg.is_stale(threshold_ms):
                dropped = dropped + 1
                dropped_bytes = dropped_bytes + msg.size_bytes.value
            else:
                new_msgs_ready.push(msg)
        self.messages_ready = new_msgs_ready
        var new_high = []
        for msg in self.high_messages:
            if msg.is_stale(threshold_ms):
                dropped = dropped + 1
                dropped_bytes = dropped_bytes + msg.size_bytes.value
            else:
                new_high.push(msg)
        self.high_messages = new_high
        var new_high_ready = []
        for msg in self.high_messages_ready:
            if msg.is_stale(threshold_ms):
                dropped = dropped + 1
                dropped_bytes = dropped_bytes + msg.size_bytes.value
            else:
                new_high_ready.push(msg)
        self.high_messages_ready = new_high_ready
        self.stats.current_size = Count(value: self.stats.current_size.value - dropped)
        self.stats.off_heap_bytes = ByteSize(value: self.stats.off_heap_bytes.value - dropped_bytes)
        dropped

    me close():
        self.is_closed = true

    fn get_stats() -> MailboxStats:
        MailboxStats(
            current_size: self.stats.current_size,
            total_received: self.stats.total_received,
            total_processed: self.stats.total_processed,
            total_dropped: self.stats.total_dropped,
            off_heap_bytes: self.stats.off_heap_bytes,
            peak_size: self.stats.peak_size,
            high_priority_count: self.stats.high_priority_count
        )

    fn fmt() -> text:
        "PriorityMailbox(size={self.total_size()}, closed={self.is_closed})"

    static fn unbounded() -> PriorityMailbox:
        """Compatibility spelling for a finite-default mailbox."""
        PriorityMailbox.new(MailboxConfig.unbounded())

    static fn default() -> PriorityMailbox:
        PriorityMailbox.new(MailboxConfig.default())

    static fn new(config: MailboxConfig) -> PriorityMailbox:
        # Normalize at the owning queue too, so direct aggregate construction
        # cannot smuggle zero/negative capacity back in as an unbounded mode.
        val capacity = priority_mailbox_effective_capacity(config.capacity.value)
        val reserve = priority_mailbox_effective_reserve(
            config.high_priority_reserve.value, capacity)
        val normalized = MailboxConfig(
            capacity: Capacity(value: capacity),
            off_heap: config.off_heap,
            priority_enabled: config.priority_enabled,
            high_priority_reserve: Capacity(value: reserve)
        )
        PriorityMailbox(
            config: normalized,
            messages: [],
            messages_ready: [],
            high_messages: [],
            high_messages_ready: [],
            next_id: 0,
            is_closed: false,
            stats: MailboxStats.new()
        )

export MailboxConfig, PriorityMailbox, MailboxStats, MessageRef, MessagePriority, SendResult
export SEND_SUCCESS, SEND_QUEUE_FULL, SEND_MAILBOX_CLOSED
export PRIORITY_MAILBOX_DEFAULT_CAPACITY, priority_mailbox_effective_capacity
