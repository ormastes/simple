# LLM Diagnostics — WebSocket Exporter
#
# Sends events to the dashboard over a WebSocket for live streaming.
# `ws_set_port` opens the client connection to the dashboard's local WebSocket
# endpoint; events are sent on that connection handle (never on the port number).

use std.nogc_async_mut.llm_diagnostics.types.{DiagEvent, SessionDiag}
use std.nogc_async_mut.llm_diagnostics.formatters.json_formatter.{
    format_event_json, format_session_json
}
use std.nogc_sync_mut.io.http_sffi.{ws_connect, ws_send_handle}

# WebSocket state (set by dashboard when it connects)
var WS_CONNECTED: bool = false
var WS_HANDLE: i64 = 0

fn ws_set_port(port: i64):
    """Connect to the dashboard WebSocket at ws://127.0.0.1:<port>/ and keep the handle."""
    WS_HANDLE = ws_connect("ws://127.0.0.1:{port}/").handle

fn ws_set_connected(connected: bool):
    WS_CONNECTED = connected

fn ws_export_event(event: DiagEvent):
    """Send single event to the connected dashboard."""
    if not WS_CONNECTED:
        return
    val json = format_event_json(event)
    ws_send_handle(WS_HANDLE, json)

fn ws_export_session(session: SessionDiag):
    """Send full session snapshot to the connected dashboard."""
    if not WS_CONNECTED:
        return
    val json = format_session_json(session)
    ws_send_handle(WS_HANDLE, json)
