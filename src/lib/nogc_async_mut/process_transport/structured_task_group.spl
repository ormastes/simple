# Process-codec adapter for the common structured owner/task lifecycle.
#
# A process boundary carries a bounded, versioned scalar frame.  It never
# carries a RuntimeValue, address, closure, or process-local resource handle.
# The receiving owner validates both the codec and the live publication lease
# before reconstructing the canonical result envelope.

use std.common.structural.parallel_commit.{
    OwnerSnapshotV1,
    ParallelResultKind,
    StructuredSpawnReceiptV1,
    StructuredTaskErrorCodeV1,
    StructuredTaskGroupV1,
    StructuredTaskWireResultV1,
    StructuredWaitReceiptV1,
    structured_task_error_reason,
    structured_task_wire_from_words,
    structured_task_wire_words
}

val STRUCTURED_PROCESS_FRAME_TAG_V1: text = "STP1"
val STRUCTURED_PROCESS_FRAME_MAX_BYTES_V1: i64 = 512
val STRUCTURED_PROCESS_FRAME_PARTS_V1: i64 = 12

fn structured_process_result_frame(wire: StructuredTaskWireResultV1) -> text:
    """Encode the fixed scalar result wire for an isolated process transport."""
    var frame = STRUCTURED_PROCESS_FRAME_TAG_V1
    for word in structured_task_wire_words(wire):
        frame = frame + "|" + word.to_string()
    frame

fn structured_process_result_wire(frame: text) -> StructuredTaskWireResultV1?:
    """Decode one bounded process frame and reject extra or partial fields."""
    if frame.len() == 0 or frame.len() > STRUCTURED_PROCESS_FRAME_MAX_BYTES_V1:
        return nil
    val parts = frame.split("|")
    if parts.len() != STRUCTURED_PROCESS_FRAME_PARTS_V1:
        return nil
    if parts[0] != STRUCTURED_PROCESS_FRAME_TAG_V1:
        return nil
    var words: [i64] = []
    var index = 1
    while index < parts.len():
        # The whole frame is bounded, and each scalar has a tighter bound so a
        # hostile child cannot turn integer parsing into unbounded work.
        if parts[index].len() == 0 or parts[index].len() > 24:
            return nil
        val parsed = parts[index].parse_int()
        if parsed == nil:
            return nil
        words.push(parsed as i64)
        index = index + 1
    structured_task_wire_from_words(words)

class ProcessStructuredTaskGroupV1:
    lifecycle: StructuredTaskGroupV1

    static fn create(snapshot: OwnerSnapshotV1, capacity: i64,
                     retain_failure_notifications: bool) -> ProcessStructuredTaskGroupV1:
        ProcessStructuredTaskGroupV1(lifecycle: StructuredTaskGroupV1.create(
            snapshot, capacity, retain_failure_notifications))

    me reserve(write_region: i64, kind: ParallelResultKind,
               deterministic_key: text) -> StructuredSpawnReceiptV1:
        var lifecycle = self.lifecycle
        val receipt = lifecycle.reserve(write_region, kind, deterministic_key)
        self.lifecycle = lifecycle
        receipt

    me accept_result_frame(task_id: i64, lease_token: i64,
                           frame: text) -> bool:
        """Accept one frame read from an owner-scoped process pipe/socket."""
        val wire_value = structured_process_result_wire(frame)
        var lifecycle = self.lifecycle
        if wire_value == nil:
            val failed = lifecycle.fail_task(task_id, lease_token,
                StructuredTaskErrorCodeV1.ResultTransportFailure,
                structured_task_error_reason(
                    StructuredTaskErrorCodeV1.ResultTransportFailure))
            self.lifecycle = lifecycle
            return failed
        val accepted = lifecycle.publish_wire_result(task_id, lease_token,
            wire_value as StructuredTaskWireResultV1)
        self.lifecycle = lifecycle
        accepted

    me cancel_task(task_id: i64) -> bool:
        var lifecycle = self.lifecycle
        val cancelled = lifecycle.cancel_task(task_id)
        self.lifecycle = lifecycle
        cancelled

    fn wait_all() -> StructuredWaitReceiptV1:
        self.lifecycle.wait_all()

    fn lifecycle_state() -> StructuredTaskGroupV1:
        self.lifecycle

export STRUCTURED_PROCESS_FRAME_TAG_V1, STRUCTURED_PROCESS_FRAME_MAX_BYTES_V1
export ProcessStructuredTaskGroupV1
export structured_process_result_frame, structured_process_result_wire
