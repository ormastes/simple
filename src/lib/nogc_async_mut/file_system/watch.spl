# File Watching
#
# Polling watcher over the real modification time (`file_modified_time`,
# mtime seconds, 0 when unavailable). Second-granularity: two writes within
# the same second are not distinguished.

use std.nogc_async_mut.file_system.types.{FileWatcher}
use std.nogc_async_mut.file_system.file_ops.{file_exists}
use std.nogc_async_mut.file_system.metadata.{file_modified_time}

fn watch_create(path: text) -> FileWatcher?:
    """Create file watcher, or nil when the file or its mtime is unavailable."""
    if not file_exists(path):
        return nil
    val modified = file_modified_time(path)
    if modified <= 0:
        return nil
    Some(FileWatcher(path: path, last_modified: modified))

fn watch_check(watcher: FileWatcher) -> bool:
    """True when the file's mtime differs from the recorded one."""
    val modified = file_modified_time(watcher.path)
    if modified <= 0:
        return false
    modified != watcher.last_modified

me watch_update(watcher: FileWatcher):
    """Update watcher timestamp (unchanged when the mtime is unavailable)."""
    val modified = file_modified_time(watcher.path)
    if modified > 0:
        watcher.last_modified = modified
