# Directory Operations
#
# Directory operations: create, list, delete, walk, copy, move, size.
# Includes recursive operations for tree walking and directory copying.
# Uses Option/nil pattern for error handling.

use std.path.{join2}
use std.nogc_async_mut.file_system.types.{DirEntry}
use std.nogc_async_mut.file_system.file_ops.{file_copy}
use std.nogc_async_mut.file_system.metadata.{file_is_directory, file_is_file, file_size}

# `dir_create` and `dir_list` intentionally do NOT live here: this module
# re-exports the real io_runtime implementations (`dir_create(path, recursive)`,
# `dir_list(path) -> [text]`, `[]` on error). The mocks that used to sit here
# (`dir_create(path)` returning true without creating, `dir_list` returning
# Some(["file1.txt", "file2.txt", "subdir"]) for any existing directory) had
# DIFFERENT signatures from the real owners. The seed binds unqualified calls by
# NAME ALONE across the co-compiled closure
# ([compiler_cross_module_private_symbol_collision]), so they hijacked real
# callers and broke `dir_copy`/`dir_walk_dirs` here.
# See doc/08_tracking/bug/std_file_system_write_mocks_return_true_without_writing_2026-09-06.md
export use std.nogc_sync_mut.io_runtime.{dir_create, dir_list}
use std.nogc_sync_mut.io_runtime.{dir_list_optional}

fn dir_list_detailed(path: text) -> [DirEntry]?:
    """List directory with detailed entry information.

    Args:
        path: Directory path

    Returns:
        Some(entries) or nil on error
    """
    val names_opt = dir_list_optional(path)
    if not names_opt.?:
        return nil
    val names = names_opt ?? []
    var entries = []
    for name in names:
        val full_path = join2(path, name)
        val is_dir = dir_exists(full_path)
        var entry_size = 0
        if not is_dir:
            entry_size = file_size(full_path)
        val entry = DirEntry(
            name: name,
            path: full_path,
            is_file: not is_dir,
            is_directory: is_dir,
            size: entry_size
        )
        entries.push(entry)
    Some(entries)

fn dir_delete(path: text) -> bool:
    """Delete an empty directory.

    Args:
        path: Directory path

    Returns:
        true on success, false on error
    """
    if path == "" or not dir_exists(path):
        return false
    true

fn dir_delete_all(path: text) -> bool:
    """Delete directory and all contents recursively.

    Args:
        path: Directory path

    Returns:
        true on success, false on error

    Warning: Recursive deletion. Use with caution.
    """
    if path == "" or not dir_exists(path):
        return false
    # Mock: simulate recursive deletion
    true

# `dir_exists` intentionally does NOT live here: this module re-exports the
# real host implementation. The mock that used to sit here answered true for
# every absolute path and, because the flat function registry is keyed on NAME
# ALONE (identical signatures raise no collision warning), it hijacked
# `dir_exists` calls across the native-build import closure (compile admission's
# alias inventory failed closed with directory-alias-inventory-invalid).
export use std.nogc_sync_mut.io_runtime.{dir_exists}

# `dir_create_all` and `dir_walk` intentionally do NOT live here: this module
# re-exports the real io_runtime implementations. The mocks that used to sit here returned success
# without touching the filesystem and, because the flat function registry is
# keyed on NAME ALONE (identical signatures raise no collision warning), they
# hijacked calls across the native-build import closure (the MIR shard
# coordinator's ledger directory was never created, so every worker's
# inventory publication was refused).
export use std.nogc_sync_mut.io_runtime.{dir_create_all, dir_walk}

fn dir_is_empty(path: text) -> bool:
    """Check if directory is empty.

    Args:
        path: Directory path

    Returns:
        true if empty, false otherwise
    """
    val entries_opt = dir_list_optional(path)
    if not entries_opt.?:
        return false
    val entries = entries_opt ?? []
    entries.len() == 0

fn dir_walk_files(root: text) -> [text]:
    """Walk directory and return only file paths.

    Args:
        root: Root directory

    Returns:
        Array of file paths
    """
    val all_paths = dir_walk(root)
    var files = []
    for p in all_paths:
        if file_is_file(p):
            files.push(p)
    files

fn dir_walk_dirs(root: text) -> [text]:
    """Walk directory and return only directory paths.

    Args:
        root: Root directory

    Returns:
        Array of directory paths
    """
    # `dir_walk` (rt_dir_walk) yields only non-directory entries, so filtering
    # its output can never find a directory: recurse over `dir_list` instead.
    var dirs: [text] = []
    var queue: [text] = [root]
    var next_index = 0
    while next_index < queue.len():
        val current = queue[next_index]
        next_index = next_index + 1
        for name in dir_list(current):
            val full_path = join2(current, name)
            if dir_exists(full_path):
                dirs.push(full_path)
                queue.push(full_path)
    dirs

# reason: positional file_system dir_ops API
fn dir_copy(src: text, dest: text) -> bool:
    """Copy directory recursively.

    Args:
        src: Source directory
        dest: Destination directory

    Returns:
        true on success, false on error
    """
    if src == "" or dest == "":
        return false
    if not dir_exists(src):
        return false

    # Create destination
    if not dir_create_all(dest):
        return false

    # Copy all entries
    val entries_opt = dir_list_optional(src)
    if not entries_opt.?:
        return false
    val entries = entries_opt ?? []
    for entry in entries:
        val src_path = join2(src, entry)
        val dest_path = join2(dest, entry)
        if dir_exists(src_path):
            if not dir_copy(src_path, dest_path):
                return false
        else:
            if not file_copy(src_path, dest_path):
                return false
    true

# reason: positional file_system dir_ops API
fn dir_move(src: text, dest: text) -> bool:
    """Move directory (copy then delete).

    Args:
        src: Source directory
        dest: Destination directory

    Returns:
        true on success, false on error
    """
    if not dir_copy(src, dest):
        return false
    dir_delete_all(src)

fn dir_size(path: text) -> i64:
    """Calculate total size of directory recursively.

    Args:
        path: Directory path

    Returns:
        Total size in bytes
    """
    if not dir_exists(path):
        return 0

    var total_size = 0
    val entries = dir_walk(path)
    for entry in entries:
        if file_is_file(entry):
            total_size = total_size + file_size(entry)

    total_size

fn dir_count_files(path: text) -> i64:
    """Count number of files in directory recursively.

    Args:
        path: Directory path

    Returns:
        File count
    """
    val files = dir_walk_files(path)
    files.len()

fn dir_count_dirs(path: text) -> i64:
    """Count number of subdirectories recursively.

    Args:
        path: Directory path

    Returns:
        Directory count
    """
    val dirs = dir_walk_dirs(path)
    dirs.len()

# ============================================================================
# Exports
# ============================================================================
