# File Permissions
#
# Permission management: get, set, convert between modes.
# Uses Unix-style permission bits (owner, group, others x read, write, execute).
# Reads come from stat(2) (`rt_file_mode`), writes from chmod(2)
# (`sffi.host.package_chmod`). Modes are ordinary integers: 0o755 is 493, 0o644 is
# 420, 0o444 is 292 (the old mocks passed DECIMAL 755/644/444 by mistake).

use std.nogc_async_mut.file_system.file_ops.{file_exists}
use std.nogc_async_mut.file_system.dir_ops.{dir_exists}
use std.nogc_async_mut.file_system.metadata.{file_mode_bits}
use std.nogc_async_mut.file_system.types.{Permission}

use std.nogc_sync_mut.sffi.host.{package_chmod}

fn permission_from_mode(mode: i64) -> Permission:
    """Convert Unix mode to Permission structure."""
    Permission(
        owner_read: (mode & 256) != 0,
        owner_write: (mode & 128) != 0,
        owner_exec: (mode & 64) != 0,
        group_read: (mode & 32) != 0,
        group_write: (mode & 16) != 0,
        group_exec: (mode & 8) != 0,
        other_read: (mode & 4) != 0,
        other_write: (mode & 2) != 0,
        other_exec: (mode & 1) != 0
    )

fn permission_to_mode(perm: Permission) -> i64:
    """Convert Permission structure to Unix mode."""
    var mode = 0
    if perm.owner_read:
        mode = mode + 256
    if perm.owner_write:
        mode = mode + 128
    if perm.owner_exec:
        mode = mode + 64
    if perm.group_read:
        mode = mode + 32
    if perm.group_write:
        mode = mode + 16
    if perm.group_exec:
        mode = mode + 8
    if perm.other_read:
        mode = mode + 4
    if perm.other_write:
        mode = mode + 2
    if perm.other_exec:
        mode = mode + 1
    mode

fn file_get_permissions(path: text) -> Permission?:
    """Get file permissions, or nil when they cannot be read."""
    val mode = file_mode_bits(path)
    if mode < 0:
        return nil
    Some(permission_from_mode(mode))

fn file_set_mode(path: text, mode: i64) -> bool:
    """Set permission bits with chmod(2). Returns false on error.

    Args:
        path: File path
        mode: Unix permission bits (e.g. 0o600)
    """
    if path == "" or mode < 0 or mode > 0o7777:
        return false
    if not file_exists(path) and not dir_exists(path):
        return false
    package_chmod(path, mode.to_i32()) == 0

fn file_set_permissions(path: text, perm: Permission) -> bool:
    """Set file permissions from a Permission structure."""
    file_set_mode(path, permission_to_mode(perm))

fn file_make_readonly(path: text) -> bool:
    """Make file read-only (0o444)."""
    file_set_mode(path, 0o444)

fn file_make_writable(path: text) -> bool:
    """Make file writable (0o644)."""
    file_set_mode(path, 0o644)

fn file_make_executable(path: text) -> bool:
    """Make file executable (0o755)."""
    file_set_mode(path, 0o755)
