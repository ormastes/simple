# Actor Scheduler - Round-Robin Message Dispatch
#
# @tag:api
# @tag:stdlib
#
# Single-threaded round-robin scheduler that processes actor mailboxes.
# The scheduler maintains a registry of actors and processes them
# one message at a time in round-robin order.
#
# Design:
#   - Single-threaded (no thread pool) -- safe, deterministic
#   - Round-robin across all actors with pending messages
#   - Reply store for ask-style request/response patterns
#   - Actors can be dynamically added and removed
#
# Usage:
#   use std.actor.scheduler.{ActorScheduler}
#   use std.actor.actor.{Actor, HandlerTable}
#   use std.actor.spawn.{ActorRef}
#
#   var sched = ActorScheduler.new()
#   var h = HandlerTable.new()
#   h.register("ping", \\args: "pong")
#   val ref = sched.register_actor(Actor.new(h))
#   ref.send("ping", [])
#   sched.run_until_idle()

use std.actor.actor.{Actor, HandlerTable, ActorState}
use std.actor.mailbox.{ActorMailbox, ActorMessage}
use std.env.variables.{env_has}

val ACTOR_READY_QUEUE_COMPACT_MIN_CONSUMED: i64 = 64
val ACTOR_REPLY_STORE_DEFAULT_CAPACITY: i64 = 256

fn actor_scheduler_ready_queue_should_compact(consumed: i64, total: i64) -> bool:
    """Amortize ready-queue prefix reclamation without an O(n) front pop."""
    if consumed <= 0 or total <= 0:
        return false
    if consumed >= total:
        return true
    # `consumed >= total - consumed` is the half-full test without a
    # multiplication overflow at large scheduler queues.
    consumed >= ACTOR_READY_QUEUE_COMPACT_MIN_CONSUMED
        and consumed >= total - consumed

# ================================================================
# Reply Store
# ================================================================

struct ReplyEntry:
    """Stores a reply value keyed by reply ID."""
    reply_id: i64
    value: text

struct ReplyStore:
    """Bounded reply reservations and completed results for ask messages."""
    entries: [ReplyEntry]
    reserved_reply_ids: [i64]
    next_reply_id: i64
    capacity: i64

impl ReplyStore:
    static fn new() -> ReplyStore:
        ReplyStore.with_capacity(ACTOR_REPLY_STORE_DEFAULT_CAPACITY)

    static fn with_capacity(requested_capacity: i64) -> ReplyStore:
        var capacity = requested_capacity
        if capacity <= 0:
            capacity = ACTOR_REPLY_STORE_DEFAULT_CAPACITY
        ReplyStore(entries: [], reserved_reply_ids: [], next_reply_id: 1,
            capacity: capacity)

    fn outstanding_count() -> i64:
        self.entries.len() + self.reserved_reply_ids.len()

    fn is_full() -> bool:
        self.outstanding_count() >= self.capacity

    me allocate_id() -> i64:
        """Reserve bounded reply capacity and allocate its unique ID.

        `-1` is an admission failure, never a valid reply ID. A reservation
        consumes capacity before the actor runs so completed replies cannot be
        silently dropped later.
        """
        if self.is_full():
            return -1
        val id = self.next_reply_id
        self.next_reply_id = self.next_reply_id + 1
        self.reserved_reply_ids.push(id)
        id

    me remove_reservation(reply_id: i64) -> bool:
        var found = false
        var remaining: [i64] = []
        for id in self.reserved_reply_ids:
            if id == reply_id:
                found = true
            else:
                remaining.push(id)
        self.reserved_reply_ids = remaining
        found

    me put(reply_id: i64, value: text) -> bool:
        """Publish a result only for an admission-time reservation."""
        if not self.remove_reservation(reply_id):
            return false
        self.entries.push(ReplyEntry(reply_id: reply_id, value: value))
        true

    fn get(reply_id: i64) -> text?:
        """Retrieve a reply value, or nil if not yet available."""
        for entry in self.entries:
            if entry.reply_id == reply_id:
                return Some(entry.value)
        nil

    fn has(reply_id: i64) -> bool:
        """Check if a reply is available."""
        for entry in self.entries:
            if entry.reply_id == reply_id:
                return true
        false

    me remove(reply_id: i64):
        """Remove a reply entry after it has been consumed."""
        var new_entries: [ReplyEntry] = []
        for entry in self.entries:
            if entry.reply_id != reply_id:
                new_entries.push(entry)
        self.entries = new_entries

    me cancel(reply_id: i64) -> bool:
        """Release a pending reservation or discard an unconsumed reply."""
        val reserved = self.remove_reservation(reply_id)
        val completed = self.has(reply_id)
        self.remove(reply_id)
        reserved or completed

# ================================================================
# Actor Scheduler
# ================================================================

class ActorScheduler:
    """Single mutable authority for one single-threaded actor scheduler.

    Manages a set of actors, processing one message from each actor
    in round-robin order. Supports fire-and-forget (send) and
    request-reply (ask) messaging patterns. A class handle is intentional:
    actor references and the global scheduler must update one registry, ready
    queue, reply store, and counter set rather than copied scheduler values.

    Fields:
        actors: Registry of all managed actors
        ready_queue: IDs of actors with pending messages
        replies: Reply store for ask-style messages
        total_dispatched: Total messages dispatched
        total_errors: Total dispatch errors (W2-6)
        trace_enabled: True when SIMPLE_ACTOR_TRACE env var is set (read once at construction)
    """
    actors: [Actor]
    ready_queue: [i64]
    ready_head: i64
    replies: ReplyStore
    total_dispatched: i64
    total_errors: i64
    trace_enabled: bool   # W2-6: set once at construction from env; zero cost on happy path

impl ActorScheduler:
    static fn new() -> ActorScheduler:
        """Create a new scheduler with the finite reply-policy default."""
        ActorScheduler.with_reply_capacity(ACTOR_REPLY_STORE_DEFAULT_CAPACITY)

    static fn with_reply_capacity(reply_capacity: i64) -> ActorScheduler:
        """Create a scheduler with one finite global ask-reply budget.

        Zero and negative requests resolve to the documented finite default;
        they are never an unbounded sentinel. Capacity is scheduler-owned so
        all copied ActorRef handles observe the same admission limit.
        """
        ActorScheduler(
            actors: [],
            ready_queue: [],
            ready_head: 0,
            replies: ReplyStore.with_capacity(reply_capacity),
            total_dispatched: 0,
            total_errors: 0,
            trace_enabled: env_has("SIMPLE_ACTOR_TRACE")
        )

    me register_actor(act: Actor) -> i64:
        """Register an actor with the scheduler.

        The actor is started and added to the ready queue.
        Returns the actor's ID for later reference.

        Args:
            act: Actor instance (will be started)

        Returns:
            Actor ID
        """
        act.start()
        val aid = act.id
        self.actors.push(act)
        if act.has_messages():
            self._enqueue_ready(aid)
        aid

    me unregister_actor(actor_id: i64) -> bool:
        """Remove an actor from the scheduler.

        Stops the actor and removes it from all internal structures.
        Returns false when this scheduler does not own the actor.
        """
        var new_actors: [Actor] = []
        var removed = false
        for act in self.actors:
            if act.id == actor_id:
                removed = true
                val abandoned = act.mailbox.drain()
                for message in abandoned:
                    match message.reply_id:
                        Some(reply_id): self.replies.cancel(reply_id)
                        nil: ()
                act.stop()
            else:
                new_actors.push(act)
        self.actors = new_actors
        self._remove_ready(actor_id)
        removed

    fn get_actor(actor_id: i64) -> Actor?:
        """Look up an actor by ID."""
        for act in self.actors:
            if act.id == actor_id:
                return Some(act)
        nil

    me send_message(actor_id: i64, method: text, args: [text]) -> bool:
        """Send a fire-and-forget message to an actor.

        Returns true if the message was enqueued successfully.
        """
        for act in self.actors:
            if act.id == actor_id:
                val msg = ActorMessage.fire_and_forget(method, args)
                val ok = act.mailbox.enqueue(msg)
                if ok:
                    self._enqueue_ready(actor_id)
                return ok
        false

    me ask_message(actor_id: i64, method: text, args: [text]) -> i64:
        """Send a message and allocate a reply ID.

        The caller can later retrieve the reply via get_reply(reply_id).
        Returns the reply ID, or -1 if the actor was not found.
        """
        for act in self.actors:
            if act.id == actor_id:
                val reply_id = self.replies.allocate_id()
                if reply_id < 0:
                    return -1
                val msg = ActorMessage.with_reply(method, args, reply_id)
                val ok = act.mailbox.enqueue(msg)
                if ok:
                    self._enqueue_ready(actor_id)
                    return reply_id
                self.replies.cancel(reply_id)
                return -1
        -1

    fn get_reply(reply_id: i64) -> text?:
        """Check for a reply to an ask-style message.

        Returns Some(value) if the reply has arrived, nil otherwise.
        """
        self.replies.get(reply_id)

    fn reply_capacity() -> i64:
        """Return this scheduler's finite ask-reply admission limit."""
        self.replies.capacity

    fn outstanding_reply_count() -> i64:
        """Return reserved plus completed-but-unconsumed reply entries."""
        self.replies.outstanding_count()

    me consume_reply(reply_id: i64) -> text?:
        """Get and remove a reply. Returns nil if not yet available."""
        val result = self.replies.get(reply_id)
        if result.?:
            self.replies.remove(reply_id)
        result

    me cancel_reply(reply_id: i64) -> bool:
        """Release an ask reservation or discard its completed reply.

        This is the explicit bounded-lifecycle counterpart to consume_reply.
        It does not retract a message already admitted to an actor mailbox.
        """
        self.replies.cancel(reply_id)

    # ================================================================
    # Scheduling Loop
    # ================================================================

    me run_once() -> bool:
        """Process one message from the next ready actor.

        Returns true if there are more messages to process.
        """
        if self._ready_pending_count() <= 0:
            self._refresh_ready_queue()
            if self._ready_pending_count() <= 0:
                return false

        # Cursor dequeue avoids an O(n) slice-shrink for every dispatched
        # message. `_enqueue_ready` scans only the active suffix, so an actor
        # can be requeued after this read without duplicate suppression seeing
        # its consumed predecessor.
        val actor_id = self.ready_queue[self.ready_head]
        self.ready_head = self.ready_head + 1
        if self.ready_head >= self.ready_queue.len():
            self.ready_queue = []
            self.ready_head = 0

        for act in self.actors:
            if act.id == actor_id:
                # Peek at the message to get reply_id before processing
                val msg_peek = act.mailbox.dequeue()
                if not msg_peek.?:
                    return self._ready_pending_count() > 0

                val the_msg = match msg_peek:
                    Some(msg):
                        msg
                    nil:
                        return self._ready_pending_count() > 0
                val result = act.handlers.dispatch(the_msg.method, the_msg.args)

                if result.is_ok():
                    act.processed_count = act.processed_count + 1
                    self.total_dispatched = self.total_dispatched + 1

                    # Store reply if requested
                    match the_msg.reply_id:
                        Some(rid):
                            val reply_published = self.replies.put(rid, result.value)
                            if not reply_published:
                                # cancel_reply() may release the reservation
                                # after mailbox admission but before dispatch.
                                # The handler still completed successfully;
                                # dropping its no-longer-owned reply is not a
                                # scheduler or handler error.
                                pass_do_nothing("cancelled reply was not retained")
                        nil:
                            pass_do_nothing("fire-and-forget message has no reply id")
                else:
                    match the_msg.reply_id:
                        Some(rid): self.replies.cancel(rid)
                        nil: ()
                    act.error_count = act.error_count + 1
                    act.last_error = result.error_msg
                    self.total_errors = self.total_errors + 1
                    # W2-6: optional per-message trace log (zero cost when flag unset)
                    if self.trace_enabled:
                        val aid = act.id
                        val method = the_msg.method
                        val err = result.error_msg
                        print("[SIMPLE_ACTOR_TRACE] actor={aid} method={method} error={err}")

                # Re-enqueue if more messages remain
                if act.has_messages():
                    self._enqueue_ready(actor_id)

                return self._ready_pending_count() > 0 or self._has_any_messages()

        self._ready_pending_count() > 0

    me run_until_idle():
        """Process all pending messages across all actors.

        Runs the round-robin loop until no actor has any pending messages.
        """
        var has_work = true
        while has_work:
            has_work = self.run_once()

    me run():
        """Alias for run_until_idle(). Processes all pending messages."""
        self.run_until_idle()

    me run_n(n: i64):
        """Process at most N messages, then return.

        Useful for cooperative scheduling or testing.

        Args:
            n: Maximum number of messages to process
        """
        var count = 0
        while count < n:
            val more = self.run_once()
            count = count + 1
            if not more:
                return

    # ================================================================
    # Internal Helpers
    # ================================================================

    fn _ready_pending_count() -> i64:
        val pending = self.ready_queue.len() - self.ready_head
        if pending < 0:
            return 0
        pending

    me _compact_ready_consumed_prefix_if_needed():
        if not actor_scheduler_ready_queue_should_compact(
            self.ready_head, self.ready_queue.len()):
            return
        if self.ready_head >= self.ready_queue.len():
            self.ready_queue = []
        else:
            self.ready_queue = self.ready_queue.slice(
                self.ready_head, self.ready_queue.len())
        self.ready_head = 0

    me _enqueue_ready(actor_id: i64):
        """Add actor to ready queue if not already present."""
        self._compact_ready_consumed_prefix_if_needed()
        var index = self.ready_head
        while index < self.ready_queue.len():
            if self.ready_queue[index] == actor_id:
                return
            index = index + 1
        self.ready_queue.push(actor_id)

    me _remove_ready(actor_id: i64):
        """Remove actor from ready queue."""
        var new_queue: [i64] = []
        var index = self.ready_head
        while index < self.ready_queue.len():
            if self.ready_queue[index] != actor_id:
                new_queue.push(self.ready_queue[index])
            index = index + 1
        self.ready_queue = new_queue
        self.ready_head = 0

    me _refresh_ready_queue():
        """Scan all actors and add those with pending messages."""
        for act in self.actors:
            if act.is_alive() and act.has_messages():
                self._enqueue_ready(act.id)

    fn _has_any_messages() -> bool:
        """Check if any actor has pending messages."""
        for act in self.actors:
            if act.is_alive() and act.has_messages():
                return true
        false

    # ================================================================
    # Queries
    # ================================================================

    fn actor_count() -> i64:
        """Return the number of registered actors."""
        self.actors.len()

    fn pending_message_count() -> i64:
        """Return total pending messages across all actors."""
        var total = 0
        for act in self.actors:
            total = total + act.mailbox.len()
        total

    fn stats_string() -> text:
        """Return scheduler statistics."""
        "Scheduler(actors={self.actors.len()}, dispatched={self.total_dispatched}, errors={self.total_errors}, pending={self.pending_message_count()})"

    # ----------------------------------------------------------------
    # W2-6: Per-actor error query API
    # ----------------------------------------------------------------

    fn actor_error_count(actor_id: i64) -> i64:
        """Return the number of handler errors recorded for this actor.

        Returns 0 if the actor is not registered. Zero allocation.
        """
        for act in self.actors:
            if act.id == actor_id:
                return act.error_count
        0

    fn actor_last_error(actor_id: i64) -> text:
        """Return the last handler error message for this actor.

        Returns empty string if no errors or actor not found. Zero allocation.
        """
        for act in self.actors:
            if act.id == actor_id:
                return act.last_error
        ""

# ================================================================
# Global Scheduler
# ================================================================

var _global_scheduler: ActorScheduler? = nil

fn get_scheduler() -> ActorScheduler:
    """Get or create the global actor scheduler.

    The global scheduler is a convenience for simple programs.
    For more control, create and manage your own ActorScheduler.
    """
    match _global_scheduler:
        Some(scheduler):
            scheduler
        nil:
            val scheduler = ActorScheduler.new()
            _global_scheduler = Some(scheduler)
            scheduler

fn run_all():
    """Run the global scheduler until all mailboxes are empty."""
    get_scheduler().run_until_idle()
