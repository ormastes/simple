# Platform Detection and System Information
#
# Functions for detecting OS, architecture, and retrieving system information.

use std.env.types.{rt_env_home, rt_hostname, rt_env_cwd}
use std.env.variables.{env_get}
use std.path.{join2}

use std.io_runtime.{process_run}

# No-shell existence probe, same as the established `is_char_device`
# precedent (nogc_sync_mut/io_runtime.spl) — used below to skip the
# `uname -s` shell-out entirely when `/bin/sh` is not present, instead of
# trapping on baremetal where `rt_process_run` is a TRAP_STUB. See
# doc/08_tracking/bug/simpleos_baremetal_backend_resolve_empty_override_rt_process_run_trap_2026-08-11.md
use std.io_runtime.{file_exists}

# ============================================================================
# Platform Detection
# ============================================================================

fn detect_os() -> text:
    """Detect operating system.

    Returns: "linux", "macos", "windows", "freebsd", "openbsd", "netbsd", or "unknown"

    Example:
        detect_os()  # "linux"
    """
    # Check OS environment variable for Windows.
    # NIL-GUARD (2026-08-02): env_get returns nil for an unset var and
    # `nil != ""` evaluates true, so the old guard let `.lower()` run on nil —
    # "method `lower` not found on type `nil`" during engine2d backend
    # auto-resolve (probe_metal -> is_macos -> detect_os), the first probe of
    # every `"auto"` resolution on a host without OS/OSTYPE exported. Same
    # for the chained `env_get("OSTYPE").lower()` below. Nil-check before
    # .lower(). See doc/08_tracking/bug/jit_method_lower_not_found_on_nil_backend_autoresolve_2026-08-02.md
    val os_env_raw = env_get("OS")
    val os_env = if os_env_raw == nil: "" else: os_env_raw.lower()
    if os_env.contains("windows"):
        return "windows"

    val ostype_raw = env_get("OSTYPE")
    val ostype = if ostype_raw == nil: "" else: ostype_raw.lower()
    if ostype.contains("linux"):
        return "linux"
    if ostype.contains("darwin") or ostype.contains("mac"):
        return "macos"
    if ostype.contains("freebsd"):
        return "freebsd"
    if ostype.contains("openbsd"):
        return "openbsd"
    if ostype.contains("netbsd"):
        return "netbsd"

    # OSTYPE is often a shell-local var that isn't exported into the process
    # environment (e.g. non-interactive `sh -c`), so fall back to `uname -s`
    # the same way std.nogc_sync_mut.env.platform.detect_os() does. Without
    # this, is_macos()/detect_os() silently report "unknown" on real macOS
    # whenever OSTYPE isn't set, which made GPU-backend "is this macOS" gates
    # (e.g. engine2d MetalBackend) fall back to software/CPU mirrors.
    # BAREMETAL GUARD (2026-08-11): `rt_process_run` is a TRAP_STUB on
    # baremetal targets (halts the kernel), while `rt_file_exists` is a
    # no-shell primitive there (NOP-stubbed to always-false on targets with
    # no VFS, or real VFS-backed on targets that have one — either way it
    # never traps). When `/bin/sh` is not reported present, skip the
    # shell-out and fall through to "unknown" instead of trapping. On every
    # hosted target `/bin/sh` exists, so this is a no-op there.
    if not file_exists("/bin/sh"):
        return "unknown"

    val uname = _platform_shell_output_trim("uname -s")
    if uname == "Linux":
        return "linux"
    if uname == "Darwin":
        return "macos"
    if uname == "FreeBSD":
        return "freebsd"
    if uname == "OpenBSD":
        return "openbsd"
    if uname == "NetBSD":
        return "netbsd"

    "unknown"

fn _platform_shell_output_trim(command: text) -> text:
    val result = process_run("/bin/sh", ["-c", command])
    val stdout = result[0]
    val code = result[2]
    if code == 0:
        stdout.trim()
    else:
        ""

fn detect_arch() -> text:
    """Detect CPU architecture.

    Returns: "x86_64", "aarch64", "arm", "i686", "riscv64", or "unknown"

    Example:
        detect_arch()  # "x86_64"
    """
    val os = detect_os()

    if os == "windows":
        # Windows: Use PROCESSOR_ARCHITECTURE
        val arch_env = env_get("PROCESSOR_ARCHITECTURE")
        if arch_env == "AMD64" or arch_env == "x64":
            return "x86_64"
        elif arch_env == "ARM64":
            return "aarch64"
        elif arch_env == "x86":
            return "i686"
        else:
            # NIL-GUARD (2026-08-02): same env_get-nil family as detect_os.
            return if arch_env == nil: "unknown" else: arch_env.lower()
    else:
        val hosttype_raw = env_get("HOSTTYPE")
        val hosttype = if hosttype_raw == nil: "" else: hosttype_raw.lower()
        if hosttype == "x86_64" or hosttype == "amd64":
            return "x86_64"
        elif hosttype == "aarch64" or hosttype == "arm64":
            return "aarch64"
        elif hosttype == "armv7l" or hosttype == "armv7":
            return "arm"
        elif hosttype == "i686" or hosttype == "i386":
            return "i686"
        elif hosttype == "riscv64":
            return "riscv64"

        val machtype_raw = env_get("MACHTYPE")
        val machtype = if machtype_raw == nil: "" else: machtype_raw.lower()
        if machtype.contains("x86_64") or machtype.contains("amd64"):
            return "x86_64"
        elif machtype.contains("aarch64") or machtype.contains("arm64"):
            return "aarch64"
        elif machtype.contains("armv7"):
            return "arm"
        elif machtype.contains("i686") or machtype.contains("i386"):
            return "i686"
        elif machtype.contains("riscv64"):
            return "riscv64"

    "unknown"

fn is_windows() -> bool:
    """Check if running on Windows.

    Example:
        is_windows()  # false on Linux
    """
    detect_os() == "windows"

fn is_unix() -> bool:
    """Check if running on Unix-like system.

    Example:
        is_unix()  # true on Linux/macOS
    """
    val os = detect_os()
    os == "linux" or os == "macos" or os == "freebsd" or os == "openbsd" or os == "netbsd"

fn is_linux() -> bool:
    """Check if running on Linux.

    Example:
        is_linux()  # true on Linux
    """
    detect_os() == "linux"

fn is_macos() -> bool:
    """Check if running on macOS.

    Example:
        is_macos()  # false on Linux
    """
    detect_os() == "macos"

# ============================================================================
# User Information
# ============================================================================

fn get_username() -> text:
    """Get current username.

    Example:
        get_username()  # "alice"
    """
    # Try USER first (Unix)
    var username = env_get("USER")
    if username != "":
        return username

    # Try USERNAME (Windows)
    username = env_get("USERNAME")
    if username != "":
        return username

    "unknown"

fn get_home_dir() -> text:
    """Get user home directory.

    Example:
        get_home_dir()  # "/home/alice"
    """
    val home = rt_env_home()
    if home != "" and home != nil:
        return home

    # Fallback to HOME environment variable
    val home_env = env_get("HOME")
    if home_env != "":
        return home_env

    # Windows fallback
    val userprofile = env_get("USERPROFILE")
    if userprofile != "":
        return userprofile

    "."

fn get_config_dir() -> text:
    """Get user configuration directory.

    Returns:
    - Linux: ~/.config
    - macOS: ~/Library/Application Support
    - Windows: %APPDATA%

    Example:
        get_config_dir()  # "/home/alice/.config"
    """
    val os = detect_os()

    if os == "windows":
        val appdata = env_get("APPDATA")
        if appdata != "":
            return appdata
        val home = get_home_dir()
        return join2(home, "AppData/Roaming")
    elif os == "macos":
        val home = get_home_dir()
        return join2(home, "Library/Application Support")
    else:
        # Linux and other Unix
        val xdg_config = env_get("XDG_CONFIG_HOME")
        if xdg_config != "":
            return xdg_config
        val home = get_home_dir()
        return join2(home, ".config")

fn get_cache_dir() -> text:
    """Get user cache directory.

    Returns:
    - Linux: ~/.cache
    - macOS: ~/Library/Caches
    - Windows: %LOCALAPPDATA%

    Example:
        get_cache_dir()  # "/home/alice/.cache"
    """
    val os = detect_os()

    if os == "windows":
        val localappdata = env_get("LOCALAPPDATA")
        if localappdata != "":
            return localappdata
        val home = get_home_dir()
        return join2(home, "AppData/Local")
    elif os == "macos":
        val home = get_home_dir()
        return join2(home, "Library/Caches")
    else:
        # Linux and other Unix
        val xdg_cache = env_get("XDG_CACHE_HOME")
        if xdg_cache != "":
            return xdg_cache
        val home = get_home_dir()
        return join2(home, ".cache")

fn get_data_dir() -> text:
    """Get user data directory.

    Returns:
    - Linux: ~/.local/share
    - macOS: ~/Library/Application Support
    - Windows: %APPDATA%

    Example:
        get_data_dir()  # "/home/alice/.local/share"
    """
    val os = detect_os()

    if os == "windows":
        val appdata = env_get("APPDATA")
        if appdata != "":
            return appdata
        val home = get_home_dir()
        return join2(home, "AppData/Roaming")
    elif os == "macos":
        val home = get_home_dir()
        return join2(home, "Library/Application Support")
    else:
        # Linux and other Unix
        val xdg_data = env_get("XDG_DATA_HOME")
        if xdg_data != "":
            return xdg_data
        val home = get_home_dir()
        return join2(home, ".local/share")

# ============================================================================
# System Information
# ============================================================================

fn get_hostname() -> text:
    """Get system hostname.

    Example:
        get_hostname()  # "my-computer"
    """
    val hostname = rt_hostname()
    if hostname != "" and hostname != nil:
        return hostname

    "localhost"

fn get_current_dir() -> text:
    """Get current working directory.

    Example:
        get_current_dir()  # "/home/alice/project"
    """
    val cwd = rt_env_cwd()
    if cwd != "" and cwd != nil:
        return cwd

    "."

fn get_temp_dir() -> text:
    """Get temporary directory.

    Example:
        get_temp_dir()  # "/tmp"
    """
    # Try TMPDIR first (Unix)
    var tmp = env_get("TMPDIR")
    if tmp != "":
        return tmp

    # Try TMP (Windows)
    tmp = env_get("TMP")
    if tmp != "":
        return tmp

    # Try TEMP (Windows)
    tmp = env_get("TEMP")
    if tmp != "":
        return tmp

    # Default fallbacks
    val os = detect_os()
    if os == "windows":
        "C:/Windows/Temp"
    else:
        "/tmp"
