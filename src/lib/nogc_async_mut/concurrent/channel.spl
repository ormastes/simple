"""
# No-GC Async Channel Facade

Channel operations are synchronous message-queue runtime primitives, so the
async family reuses the no-GC sync runtime-hook owner instead of declaring
duplicate hooks.
"""

export use std.nogc_sync_mut.concurrent.channel.{Channel, channel_new, channel_from_id}

export use std.nogc_sync_mut.concurrent.channel.{channel_send_by_id}

export use std.nogc_sync_mut.concurrent.channel.{channel_close_by_id, channel_send_i64_by_id}
