"""
# No-GC Async I/O Runtime

Compatibility facade over the no-GC sync I/O runtime backend.
"""

@allow(star_import) # reason: compatibility facade, re-exports backing family symbols
# dir_list and file_hash_sha256 are NOT declared by std.nogc_sync_mut.io_runtime
# (only rt_dir_list/dir_list_or_empty and rt_file_hash_sha256/*_or_empty forms);
# their canonical plain-name owners are io.dir_ops and io.file_ops.
export use std.nogc_sync_mut.io.dir_ops.{dir_list}
export use std.nogc_sync_mut.io.file_ops.{file_hash_sha256}
export use std.nogc_sync_mut.io_runtime.{
    ProcessResult, ShellResult, cli_arg_at, cli_arg_count, cwd, cwd_process, dir_create,
    dir_create_all, dir_exists, dir_list_optional, dir_remove, dir_remove_all, dir_walk,
    env_get, env_get_i64_process, env_get_nullable, env_get_opt, env_get_or, env_remove_process,
    env_set, env_set_process, exit, file_append_text, file_copy, file_delete, file_exists,
    file_hash_sha256_or_empty, file_move_cross_device, file_read,
    file_read_bytes, file_read_bytes_i64, file_read_bytes_result, file_read_nullable,
    file_read_result, file_read_text_at_nullable, file_rename, file_size, file_size_raw,
    file_size_signed, file_write, file_write_bytes, file_write_exact, get_args, getpid, hash_text,
    home, host_arch, host_os, is_char_device, is_dir, is_file, list_dir, mkdir_p, platform_name,
    process_is_running, process_kill, process_run, process_run_bounded, process_run_timeout,
    process_spawn_async, read_file, read_file_text, read_file_text_result, remove_file_if_exists,
    rename_path, rt_dir_create, rt_dir_create_all, rt_dir_exists, rt_dir_list, rt_dir_remove,
    rt_dir_remove_all, rt_dir_walk, rt_env_cwd, rt_env_get, rt_env_get_i64, rt_env_remove,
    rt_env_set, rt_exit, rt_file_copy, rt_file_delete, rt_file_exists, rt_file_hash_sha256,
    rt_file_is_char_device, rt_file_move, rt_file_read_bytes, rt_file_read_text, rt_file_rename,
    rt_file_size, rt_file_write_text, rt_getpid, rt_hash_text, rt_process_is_running,
    rt_process_kill, rt_process_run, rt_process_run_timeout, rt_process_spawn_async_value,
    rt_shell_exec, rt_thread_sleep, rt_time_now_monotonic_ms, rt_time_now_unix_micros, shell,
    shell_bool, shell_exec, shell_output, shell_output_trimmed, sys_get_args, thread_sleep,
    time_now_monotonic_ms, time_now_unix_micros, write_file
}
