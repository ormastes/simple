"""Socket-neutral, fail-closed TLS 1.3 HTTP application-record adapter."""

use os.tls13.server.{Tls13ServerContext}
use os.tls13.record13.{RecordKey, RecordResult, record13_encrypt_for_suite, record13_decrypt_for_suite}

val HTTP_TLS13_AES_128_GCM_SHA256: u16 = 0x1301u16
val HTTP_TLS13_AES_256_GCM_SHA384: u16 = 0x1302u16
val HTTP_TLS13_CHACHA20_POLY1305_SHA256: u16 = 0x1303u16
val HTTP_TLS13_APPLICATION_DATA: u8 = 0x17u8
val HTTP_TLS13_MAX_PLAINTEXT: u64 = 16384u64
val HTTP_TLS13_MAX_CIPHERTEXT_PAYLOAD: u64 = 16401u64
val HTTP_TLS13_MAX_BUFFERED_WIRE: u64 = 32812u64

class HttpTls13RecordSession:
    cipher_suite: u16
    client_key: RecordKey
    server_key: RecordKey
    client_seq: u64
    server_seq: u64
    pending_wire: [u8]

enum HttpTls13OpenAction:
    Ready(session: HttpTls13RecordSession)
    Close(reason: text)

enum HttpTls13ReceiveAction:
    NeedMore(session: HttpTls13RecordSession)
    Plaintext(session: HttpTls13RecordSession, data: [u8])
    Close(session: HttpTls13RecordSession, reason: text)

enum HttpTls13SendAction:
    WireRecord(session: HttpTls13RecordSession, record: [u8])
    Close(session: HttpTls13RecordSession, reason: text)

fn _http_tls13_supported_cipher(cipher_suite: u16) -> bool:
    cipher_suite == HTTP_TLS13_AES_128_GCM_SHA256

fn _http_tls13_copy_range(source: [u8], start: u64, count: u64) -> [u8]:
    var out: [u8] = []
    var index: u64 = 0u64
    while index < count:
        out.push(source[start + index])
        index = index + 1u64
    out

fn _http_tls13_append(left: [u8], right: [u8]) -> [u8]:
    var out: [u8] = []
    for byte in left:
        out.push(byte)
    for byte in right:
        out.push(byte)
    out

fn _http_tls13_receive_state(session: HttpTls13RecordSession, client_seq: u64,
                             pending_wire: [u8]) -> HttpTls13RecordSession:
    HttpTls13RecordSession(
        cipher_suite: session.cipher_suite, client_key: session.client_key,
        server_key: session.server_key, client_seq: client_seq,
        server_seq: session.server_seq, pending_wire: pending_wire)

fn _http_tls13_send_state(session: HttpTls13RecordSession,
                          server_seq: u64) -> HttpTls13RecordSession:
    HttpTls13RecordSession(
        cipher_suite: session.cipher_suite, client_key: session.client_key,
        server_key: session.server_key, client_seq: session.client_seq,
        server_seq: server_seq, pending_wire: session.pending_wire)

fn http_tls13_open(ctx: Tls13ServerContext) -> HttpTls13OpenAction:
    """Admit only suites whose current server context has correct app keys."""
    if ctx.cipher_suite == HTTP_TLS13_AES_256_GCM_SHA384:
        return HttpTls13OpenAction.Close("tls13_aes256_gcm_application_records_unimplemented")
    # record13 supports ChaCha with 32-byte keys, but server_handshake currently
    # derives this suite through the 16-byte AES traffic-key helper.
    if ctx.cipher_suite == HTTP_TLS13_CHACHA20_POLY1305_SHA256:
        return HttpTls13OpenAction.Close("tls13_chacha20_application_keys_unresolved")
    if not _http_tls13_supported_cipher(ctx.cipher_suite):
        return HttpTls13OpenAction.Close("tls13_application_cipher_unsupported")
    if ctx.client_app_key.len() != 16u64 or ctx.server_app_key.len() != 16u64:
        return HttpTls13OpenAction.Close("tls13_application_key_length_invalid")
    if ctx.client_app_iv.len() != 12u64 or ctx.server_app_iv.len() != 12u64:
        return HttpTls13OpenAction.Close("tls13_application_iv_length_invalid")
    HttpTls13OpenAction.Ready(HttpTls13RecordSession(
        cipher_suite: ctx.cipher_suite,
        client_key: RecordKey(key: ctx.client_app_key, iv: ctx.client_app_iv),
        server_key: RecordKey(key: ctx.server_app_key, iv: ctx.server_app_iv),
        client_seq: ctx.client_seq, server_seq: ctx.server_seq, pending_wire: []))

fn http_tls13_receive(session: HttpTls13RecordSession,
                      wire: [u8]) -> HttpTls13ReceiveAction:
    """Consume complete TLSCiphertext records without a plaintext fallback."""
    if not _http_tls13_supported_cipher(session.cipher_suite):
        return HttpTls13ReceiveAction.Close(session, "tls13_application_cipher_unsupported")
    if wire.len() + session.pending_wire.len() > HTTP_TLS13_MAX_BUFFERED_WIRE:
        return HttpTls13ReceiveAction.Close(session, "tls13_receive_buffer_limit")
    val buffered = _http_tls13_append(session.pending_wire, wire)
    var offset: u64 = 0u64
    var plaintext: [u8] = []
    var next_seq = session.client_seq
    while buffered.len() - offset >= 5u64:
        if (buffered[offset] != 0x17u8 or buffered[offset + 1u64] != 0x03u8 or
                buffered[offset + 2u64] != 0x03u8):
            return HttpTls13ReceiveAction.Close(session, "tls13_record_header_invalid")
        val payload_length = (buffered[offset + 3u64].to_u64() << 8u64) |
            buffered[offset + 4u64].to_u64()
        if payload_length < 17u64 or payload_length > HTTP_TLS13_MAX_CIPHERTEXT_PAYLOAD:
            return HttpTls13ReceiveAction.Close(session, "tls13_record_length_invalid")
        val record_length = 5u64 + payload_length
        if buffered.len() - offset < record_length:
            break
        if next_seq == 0xFFFFFFFFFFFFFFFFu64:
            return HttpTls13ReceiveAction.Close(session, "tls13_client_sequence_exhausted")
        val record = _http_tls13_copy_range(buffered, offset, record_length)
        match record13_decrypt_for_suite(session.cipher_suite, session.client_key,
                                         next_seq, record):
            case RecordResult.Ok(content_type, data):
                if content_type != HTTP_TLS13_APPLICATION_DATA.to_i64():
                    return HttpTls13ReceiveAction.Close(
                        session, "tls13_post_handshake_transition_unimplemented")
                if plaintext.len() + data.len() > HTTP_TLS13_MAX_PLAINTEXT:
                    return HttpTls13ReceiveAction.Close(session, "tls13_plaintext_batch_limit")
                plaintext = _http_tls13_append(plaintext, data)
                next_seq = next_seq + 1u64
            case RecordResult.Err(reason):
                return HttpTls13ReceiveAction.Close(session, reason)
        offset = offset + record_length
    val remaining = _http_tls13_copy_range(buffered, offset, buffered.len() - offset)
    val next = _http_tls13_receive_state(session, next_seq, remaining)
    if plaintext.len() == 0u64:
        return HttpTls13ReceiveAction.NeedMore(next)
    HttpTls13ReceiveAction.Plaintext(next, plaintext)

fn http_tls13_send(session: HttpTls13RecordSession,
                   plaintext: [u8]) -> HttpTls13SendAction:
    """Encrypt exactly one bounded TLS 1.3 application-data record."""
    if not _http_tls13_supported_cipher(session.cipher_suite):
        return HttpTls13SendAction.Close(session, "tls13_application_cipher_unsupported")
    if plaintext.len() == 0u64 or plaintext.len() > HTTP_TLS13_MAX_PLAINTEXT:
        return HttpTls13SendAction.Close(session, "tls13_plaintext_record_limit")
    if session.server_seq == 0xFFFFFFFFFFFFFFFFu64:
        return HttpTls13SendAction.Close(session, "tls13_server_sequence_exhausted")
    val record = record13_encrypt_for_suite(
        session.cipher_suite, session.server_key, session.server_seq,
        HTTP_TLS13_APPLICATION_DATA, plaintext)
    if record.len() < 22u64 or record.len() > 5u64 + HTTP_TLS13_MAX_CIPHERTEXT_PAYLOAD:
        return HttpTls13SendAction.Close(session, "tls13_record_encryption_failed")
    HttpTls13SendAction.WireRecord(
        _http_tls13_send_state(session, session.server_seq + 1u64), record)
