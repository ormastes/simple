"""
# Incremental HTTP/1.1 Request Parser

Streaming parser that processes partial data and resumes on next recv.
Designed for non-blocking I/O where data arrives in chunks.

## Usage

```simple
pub val parser = HttpRequestParser.new()

# Feed data as it arrives from recv completions
val consumed = parser.feed("GET / HTTP/1.1\r\nHost: example.com\r\n")
val consumed2 = parser.feed("\r\n")

if parser.is_complete():
    val request = parser.to_request("127.0.0.1")
```
"""

use std.http_server.types.{HttpRequestData}
use std.http_server.error.{HttpServerError}
use std.common.string_core.{string_bytes}
# Shared protocol core — same limits and header policy as the sync server
# (src/lib/common/net/http_core.spl). Enforced DURING parsing, before buffer
# growth, so an oversized request line/header/body cannot exhaust memory.
# Chunked framing detection and decoding also come from the core so the
# decoded size stays bounded and a "0\r\n\r\n" inside chunk DATA is never
# taken as the terminal chunk (the std.http.headers helpers are not used:
# their `index_of as common_index_of` aliased import is unresolvable on the
# deployed interpreter).
use std.common.net.http_core.{
    MAX_REQUEST_LINE, MAX_HEADER_COUNT, MAX_HEADER_LINE, MAX_BODY_SIZE,
    body_decision, decode_chunked_bounded, chunked_body_end_scan
}

# ============================================================================
# Parse State
# ============================================================================

enum ParseState:
    """State of the incremental parser."""
    RequestLine
    Headers
    Body
    Complete
    Error

# ============================================================================
# Incremental Parser
# ============================================================================

class HttpRequestParser:
    """Incremental HTTP/1.1 request parser.

    Feeds partial data via `feed()` and tracks parse progress.
    Once `is_complete()` returns true, call `to_request()` to
    get the parsed HttpRequestData.
    """
    state: ParseState
    buffer: text
    # Read cursor into `buffer` so request/header lines advance in O(1) without
    # slicing the remaining buffer on every line; compacted lazily at >= 4 KiB
    # when at least half of `buffer` is consumed, or on `reset()`.
    buf_pos: i64
    # Incoming socket fragments queued in O(1) per `feed()` and coalesced only
    # when header/request-line scanning sees a newline, or drained straight into
    # `body_chunks` when already in `ParseState.Body`.
    rx_chunks: [text]
    rx_pending_bytes: i64
    rx_scan_idx: i64
    # Observability counter: cumulative bytes materialized/compacted in `buffer`
    # while framing the request line and headers (linear O(N) vs pre-fix O(N^2)).
    pub header_copy_bytes: i64
    method: text
    path: text
    query: text
    version: text
    headers: [(text, text)]
    body: text
    # Body is accumulated as chunks and joined once on completion; appending
    # to `body` per feed rebuilt the whole retained body each time (O(n^2)).
    body_chunks: [text]
    body_len: i64
    # Test-observability hook: cumulative bytes copied while accumulating the
    # body. Linear in body size here; the pre-fix concat made it quadratic.
    body_copy_bytes: i64
    content_length: i64
    is_chunked_encoding: bool
    error_message: text
    max_request_line: i32
    max_header_count: i32
    max_header_line: i32
    max_body: i32

    static fn new() -> HttpRequestParser:
        """Create a new parser ready to receive data (shared default limits)."""
        HttpRequestParser.with_limits(MAX_REQUEST_LINE, MAX_HEADER_COUNT, MAX_HEADER_LINE, MAX_BODY_SIZE)

    static fn with_limits(max_request_line: i32, max_header_count: i32, max_header_line: i32, max_body: i32) -> HttpRequestParser:
        """Create a parser enforcing caller-supplied request limits."""
        HttpRequestParser(
            state: ParseState.RequestLine,
            buffer: "",
            buf_pos: 0,
            rx_chunks: [],
            rx_pending_bytes: 0,
            rx_scan_idx: 0,
            header_copy_bytes: 0,
            method: "",
            path: "",
            query: "",
            version: "",
            headers: [],
            body: "",
            body_chunks: [],
            body_len: 0,
            body_copy_bytes: 0,
            content_length: 0,
            is_chunked_encoding: false,
            error_message: "",
            max_request_line: max_request_line,
            max_header_count: max_header_count,
            max_header_line: max_header_line,
            max_body: max_body
        )

    me feed(data: text) -> Result<i64, HttpServerError>:
        """Feed data to the parser.

        Processes as much as possible and buffers the rest.

        Args:
            data: Raw bytes received from socket

        Returns:
            Number of bytes consumed, or ParseError
        """
        val data_len = data.byte_len()
        if data_len > 0:
            self.rx_chunks.push(data)
            self.rx_pending_bytes = self.rx_pending_bytes + data_len
        var consumed: i64 = 0

        while true:
            match self.state:
                ParseState.RequestLine:
                    var line_end = -1
                    if self.buf_pos < self.buffer.byte_len():
                        line_end = self.buffer.index_of("\r\n", self.buf_pos)
                    if line_end < 0 and self.rx_pending_bytes > 0 and self.rx_has_newline():
                        self.coalesce_rx_into_buffer()
                        line_end = self.buffer.index_of("\r\n", self.buf_pos)
                    # `.?` on an i64 is truthiness, so it wrongly rejected 0.
                    if line_end >= 0:
                        val line_len = line_end - self.buf_pos
                        # AC-2: enforce request-line length BEFORE parsing it.
                        if line_len > self.max_request_line:
                            return Err(self.fail("431 Request line too long: {line_len} bytes"))
                        val line = self.buffer.slice(self.buf_pos, line_end)
                        self.buf_pos = line_end + 2
                        consumed = consumed + line_len + 2
                        self.maybe_compact_buffer()
                        if not self.parse_request_line(line):
                            return Err(HttpServerError.ParseError(self.error_message))
                        self.state = ParseState.Headers
                    else:
                        # AC-2: bound buffer growth while waiting for CRLF — a
                        # client streaming an endless request line is cut off.
                        val unread_bytes = (self.buffer.byte_len() - self.buf_pos) + self.rx_pending_bytes
                        if unread_bytes > self.max_request_line + 2:
                            return Err(self.fail("431 Request line too long: {unread_bytes} bytes"))
                        return Ok(consumed)

                ParseState.Headers:
                    var line_end = -1
                    if self.buf_pos < self.buffer.byte_len():
                        line_end = self.buffer.index_of("\r\n", self.buf_pos)
                    if line_end < 0 and self.rx_pending_bytes > 0 and self.rx_has_newline():
                        self.coalesce_rx_into_buffer()
                        line_end = self.buffer.index_of("\r\n", self.buf_pos)
                    # `.?` on an i64 is truthiness, so it wrongly rejected 0.
                    if line_end >= 0:
                        val line_len = line_end - self.buf_pos
                        if line_len == 0:
                            # Empty line = end of headers
                            self.buf_pos = line_end + 2
                            consumed = consumed + 2
                            self.maybe_compact_buffer()
                            if not self.finalize_headers():
                                return Err(self.finalize_error())
                            if self.content_length > 0 or self.is_chunked_encoding:
                                self.state = ParseState.Body
                            else:
                                self.state = ParseState.Complete
                        else:
                            # AC-2: per-header line length limit
                            if line_len > self.max_header_line:
                                return Err(self.fail("431 Header line too long: {line_len} bytes"))
                            # AC-2: header count limit
                            if self.headers.len() >= self.max_header_count:
                                return Err(self.fail("431 Too many headers"))
                            val line = self.buffer.slice(self.buf_pos, line_end)
                            self.buf_pos = line_end + 2
                            consumed = consumed + line_len + 2
                            self.maybe_compact_buffer()
                            if not self.parse_header_line(line):
                                return Err(self.fail(self.error_message))
                    else:
                        # AC-2: bound buffer growth on a partial header line.
                        val unread_bytes = (self.buffer.byte_len() - self.buf_pos) + self.rx_pending_bytes
                        if unread_bytes > self.max_header_line + 2:
                            return Err(self.fail("431 Header line too long: {unread_bytes} bytes"))
                        return Ok(consumed)

                ParseState.Body:
                    if self.is_chunked_encoding:
                        val raw_unread = (self.buffer.byte_len() - self.buf_pos) + self.rx_pending_bytes
                        if self.rx_pending_bytes > 0 and self.rx_has_newline():
                            self.coalesce_rx_body()
                        if self.rx_pending_bytes == 0 and self.buf_pos < self.buffer.byte_len():
                            val buf_len = self.buffer.byte_len()
                            val chunk_view = if self.buf_pos == 0:
                                self.buffer
                            else:
                                self.buffer.slice(self.buf_pos, buf_len)
                            # Boundary-aware: walk chunk-size headers so "0\r\n\r\n"
                            # inside chunk DATA is never taken as the terminal
                            # 0-size chunk (a flat index_of scan truncated there).
                            val term = chunked_body_end_scan(chunk_view)
                            if term >= 0:
                                val raw = chunk_view.slice(0, term)
                                # RFC 7230 §4.1/§3.3.3: an invalid chunk-size line
                                # is a framing error, not an empty body (400), and
                                # the DECODED body must respect max_body (413).
                                val dec = decode_chunked_bounded(raw, self.max_body)
                                if dec.0 != "":
                                    if dec.0.starts_with("413"):
                                        return Err(self.fail_body_too_large(dec.0))
                                    return Err(self.fail(dec.0))
                                self.body = dec.1
                                consumed = consumed + term
                                self.buf_pos = self.buf_pos + term
                                self.maybe_compact_buffer()
                                self.state = ParseState.Complete
                            else:
                                if term == -2:
                                    # Framing already provably invalid.
                                    return Err(self.fail("400 Malformed chunked body: invalid chunk framing"))
                                # AC-2: bound raw chunked accumulation. Chunk framing
                                # overhead is small; max_body + max_header_line slack
                                # covers the worst legitimate case.
                                if raw_unread > self.max_body + self.max_header_line:
                                    return Err(self.fail_body_too_large("413 Chunked body too large: {raw_unread} bytes"))
                                return Ok(consumed)
                        else:
                            if raw_unread > self.max_body + self.max_header_line:
                                return Err(self.fail_body_too_large("413 Chunked body too large: {raw_unread} bytes"))
                            return Ok(consumed)
                    else:
                        val body_consumed = self.drain_content_length_body()
                        consumed = consumed + body_consumed
                        if not self.is_complete():
                            return Ok(consumed)

                ParseState.Complete:
                    return Ok(consumed)

                ParseState.Error:
                    return Err(HttpServerError.ParseError(self.error_message))

        Ok(consumed)

    fn header_copy_work() -> i64:
        """Cumulative bytes materialized/compacted while framing headers."""
        self.header_copy_bytes

    fn body_copy_work() -> i64:
        """Cumulative bytes copied while accumulating the body.

        Test-observability hook, not public API. Linear in body size for the
        chunk accumulator; the pre-fix per-feed concat made it quadratic in
        fragment count.
        """
        self.body_copy_bytes

    fn is_complete() -> bool:
        """Check if a complete request has been parsed."""
        match self.state:
            ParseState.Complete: true
            _: false

    fn has_error() -> bool:
        """Check if the parser encountered an error."""
        match self.state:
            ParseState.Error: true
            _: false

    fn to_request(peer_addr: text) -> HttpRequestData:
        """Convert parsed data to HttpRequestData.

        Should only be called after is_complete() returns true.

        Args:
            peer_addr: Remote address of the client

        Returns:
            Parsed request data
        """
        HttpRequestData(
            method: self.method,
            path: self.path,
            query: self.query,
            version: self.version,
            headers: self.headers,
            body: self.body,
            params: {},
            peer_addr: peer_addr
        )

    me reset():
        """Reset parser for next request on keep-alive connection."""
        if self.buf_pos > 0:
            val buf_len = self.buffer.byte_len()
            if self.buf_pos >= buf_len:
                self.buffer = ""
            else:
                self.buffer = self.buffer.slice(self.buf_pos, buf_len)
            self.buf_pos = 0
        self.rx_scan_idx = 0
        self.state = ParseState.RequestLine
        self.header_copy_bytes = 0
        self.method = ""
        self.path = ""
        self.query = ""
        self.version = ""
        self.headers = []
        self.body = ""
        self.body_chunks = []
        self.body_len = 0
        self.body_copy_bytes = 0
        self.content_length = 0
        self.is_chunked_encoding = false
        self.error_message = ""
        # Keep buffer and rx_chunks — may contain pipelined request data

    # ========================================================================
    # Internal Buffer & Chunk Management
    # ========================================================================

    me rx_has_newline() -> bool:
        """Scan only newly arrived rx_chunks for '\\n' so partial lines stay queued."""
        val count = self.rx_chunks.len()
        while self.rx_scan_idx < count:
            val chunk = self.rx_chunks[self.rx_scan_idx]
            if chunk.index_of("\n") >= 0:
                return true
            self.rx_scan_idx = self.rx_scan_idx + 1
        false

    me coalesce_rx_into_buffer():
        """Materialize `buffer[buf_pos..] + rx_chunks.join(\"\")` for header scanning."""
        if self.rx_pending_bytes <= 0:
            return
        val buf_len = self.buffer.byte_len()
        val unread = buf_len - self.buf_pos
        val chunk_count = self.rx_chunks.len()
        val incoming = if chunk_count == 1:
            self.rx_chunks[0]
        else:
            self.rx_chunks.join("")
        if unread <= 0:
            self.buffer = incoming
            self.buf_pos = 0
            self.header_copy_bytes = self.header_copy_bytes + self.rx_pending_bytes
        else:
            val tail = if self.buf_pos == 0:
                self.buffer
            else:
                self.buffer.slice(self.buf_pos, buf_len)
            self.buffer = tail + incoming
            self.buf_pos = 0
            self.header_copy_bytes = self.header_copy_bytes + unread + self.rx_pending_bytes
        self.rx_chunks = []
        self.rx_pending_bytes = 0
        self.rx_scan_idx = 0

    me coalesce_rx_body():
        """Materialize `buffer[buf_pos..] + rx_chunks.join(\"\")` for chunked-body framing."""
        if self.rx_pending_bytes <= 0:
            return
        val buf_len = self.buffer.byte_len()
        val unread = buf_len - self.buf_pos
        val chunk_count = self.rx_chunks.len()
        val incoming = if chunk_count == 1:
            self.rx_chunks[0]
        else:
            self.rx_chunks.join("")
        if unread <= 0:
            self.buffer = incoming
            self.buf_pos = 0
            self.body_copy_bytes = self.body_copy_bytes + self.rx_pending_bytes
        else:
            val tail = if self.buf_pos == 0:
                self.buffer
            else:
                self.buffer.slice(self.buf_pos, buf_len)
            self.buffer = tail + incoming
            self.buf_pos = 0
            self.body_copy_bytes = self.body_copy_bytes + unread + self.rx_pending_bytes
        self.rx_chunks = []
        self.rx_pending_bytes = 0
        self.rx_scan_idx = 0

    me maybe_compact_buffer():
        """Release fully consumed buffer or compact once cursor passes >= 4 KiB and 50%."""
        val buf_len = self.buffer.byte_len()
        if self.buf_pos >= buf_len:
            self.buffer = ""
            self.buf_pos = 0
        elif self.buf_pos >= 4096 and self.buf_pos * 2 >= buf_len:
            val rem = buf_len - self.buf_pos
            self.buffer = self.buffer.slice(self.buf_pos, buf_len)
            self.buf_pos = 0
            self.header_copy_bytes = self.header_copy_bytes + rem

    me drain_content_length_body() -> i64:
        """Drain buffered tail and queued `rx_chunks` straight into `body_chunks`."""
        var newly_consumed: i64 = 0
        var remaining = self.content_length - self.body_len

        val buf_len = self.buffer.byte_len()
        if self.buf_pos < buf_len and remaining > 0:
            val avail = buf_len - self.buf_pos
            if avail >= remaining:
                val piece = self.buffer.slice(self.buf_pos, self.buf_pos + remaining)
                self.body_chunks.push(piece)
                self.body_len = self.body_len + remaining
                self.body_copy_bytes = self.body_copy_bytes + remaining
                self.buf_pos = self.buf_pos + remaining
                self.maybe_compact_buffer()
                newly_consumed = newly_consumed + remaining
                self.body = self.body_chunks.join("")
                self.body_copy_bytes = self.body_copy_bytes + self.body_len
                self.state = ParseState.Complete
                return newly_consumed
            else:
                val piece = if self.buf_pos == 0:
                    self.buffer
                else:
                    self.buffer.slice(self.buf_pos, buf_len)
                self.body_chunks.push(piece)
                self.body_len = self.body_len + avail
                self.body_copy_bytes = self.body_copy_bytes + avail
                self.buffer = ""
                self.buf_pos = 0
                newly_consumed = newly_consumed + avail

        var idx: i64 = 0
        val total_chunks = self.rx_chunks.len()
        while idx < total_chunks:
            remaining = self.content_length - self.body_len
            val chunk = self.rx_chunks[idx]
            val clen = chunk.byte_len()
            if clen < remaining:
                self.body_chunks.push(chunk)
                self.body_len = self.body_len + clen
                self.body_copy_bytes = self.body_copy_bytes + clen
                self.rx_pending_bytes = self.rx_pending_bytes - clen
                newly_consumed = newly_consumed + clen
                idx = idx + 1
            elif clen == remaining:
                self.body_chunks.push(chunk)
                self.body_len = self.body_len + clen
                self.body_copy_bytes = self.body_copy_bytes + clen
                self.rx_pending_bytes = self.rx_pending_bytes - clen
                newly_consumed = newly_consumed + clen
                idx = idx + 1
                var rest_chunks: [text] = []
                while idx < total_chunks:
                    rest_chunks.push(self.rx_chunks[idx])
                    idx = idx + 1
                self.rx_chunks = rest_chunks
                if rest_chunks.len() == 0:
                    self.rx_pending_bytes = 0
                self.rx_scan_idx = 0
                self.body = self.body_chunks.join("")
                self.body_copy_bytes = self.body_copy_bytes + self.body_len
                self.state = ParseState.Complete
                return newly_consumed
            else:
                val body_part = chunk.slice(0, remaining)
                val tail_part = chunk.slice(remaining, clen)
                self.body_chunks.push(body_part)
                self.body_len = self.body_len + remaining
                self.body_copy_bytes = self.body_copy_bytes + remaining
                self.rx_pending_bytes = self.rx_pending_bytes - clen
                newly_consumed = newly_consumed + remaining
                self.buffer = tail_part
                self.buf_pos = 0
                idx = idx + 1
                var rest_chunks: [text] = []
                while idx < total_chunks:
                    rest_chunks.push(self.rx_chunks[idx])
                    idx = idx + 1
                self.rx_chunks = rest_chunks
                if rest_chunks.len() == 0:
                    self.rx_pending_bytes = 0
                self.rx_scan_idx = 0
                self.body = self.body_chunks.join("")
                self.body_copy_bytes = self.body_copy_bytes + self.body_len
                self.state = ParseState.Complete
                return newly_consumed

        if idx > 0:
            self.rx_chunks = []
            self.rx_pending_bytes = 0
            self.rx_scan_idx = 0
        newly_consumed

    # ========================================================================
    # Internal Parsing
    # ========================================================================

    me parse_request_line(line: text) -> bool:
        """Parse 'METHOD /path HTTP/1.1' line."""
        val parts = line.split(" ")
        if parts.len() < 3:
            self.error_message = "Malformed request line: {line}"
            self.state = ParseState.Error
            return false

        self.method = parts[0]
        val raw_path = parts[1]
        self.version = parts[2]

        # Split path and query string
        val qmark = raw_path.index_of("?")
        if qmark >= 0:
            self.path = raw_path.slice(0, qmark)
            self.query = raw_path.slice(qmark + 1, raw_path.byte_len())
        else:
            self.path = raw_path
            self.query = ""

        true

    me parse_header_line(line: text) -> bool:
        """Parse a single 'Name: Value' header line.

        A header without a non-empty field name is a framing error. Silently
        dropping it would let malformed input change the request semantics.
        """
        val colon = line.index_of(":")
        if colon <= 0:
            self.error_message = "400 Malformed header line"
            return false
        # Validate the wire spelling before trimming: whitespace before the
        # colon and controls at either edge must not disappear during parsing.
        val name = line.slice(0, colon)
        for code in string_bytes(name):
            val alpha = (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
            val digit = code >= 48 and code <= 57
            val symbol = (
                code == 33 or code == 35 or code == 36 or code == 37 or
                code == 38 or code == 39 or code == 42 or code == 43 or
                code == 45 or code == 46 or code == 94 or code == 95 or
                code == 96 or code == 124 or code == 126
            )
            if not alpha and not digit and not symbol:
                self.error_message = "400 Invalid header name"
                return false
        val raw_value = line.slice(colon + 1, line.byte_len())
        for code in string_bytes(raw_value):
            # RFC field values allow HTAB, SP, visible ASCII and obs-text.
            if (code < 32 and code != 9) or code == 127:
                self.error_message = "400 Invalid header value"
                return false
        val value = raw_value.trim()
        self.headers.push((name, value))
        true

    me finalize_headers() -> bool:
        """Apply the shared header/body policy after all headers are parsed.

        Delegates to http_core body_decision (chunked allowed on this
        transport): rejects duplicate/invalid Content-Length (400), oversized
        bodies (413), and Content-Length combined with chunked (400 smuggling
        ambiguity), then the Host policy (400 missing/duplicate/invalid Host,
        or Host disagreeing with an absolute-form target). Body framing is
        checked first so an oversized body still maps to 413. Returns false
        and enters Error state on rejection.
        """
        val d = body_decision(self.headers, self.max_body, true)
        if d.0 != "":
            self.error_message = d.0
            self.state = ParseState.Error
            return false
        val host_err = _async_request_host_error(self.headers, self.version, self.path)
        if host_err != "":
            self.error_message = host_err
            self.state = ParseState.Error
            return false
        self.content_length = d.1.to_i64()
        self.is_chunked_encoding = d.2
        true

    me fail(msg: text) -> HttpServerError:
        """Record a limit violation and return the matching parse error."""
        self.error_message = msg
        self.state = ParseState.Error
        HttpServerError.ParseError(msg)

    me fail_body_too_large(msg: text) -> HttpServerError:
        """Record an oversized-body violation (maps to 413)."""
        self.error_message = msg
        self.state = ParseState.Error
        HttpServerError.BodyTooLarge(msg)

    me finalize_error() -> HttpServerError:
        """Map the recorded finalize_headers rejection to an error variant."""
        if self.error_message.starts_with("413"):
            return HttpServerError.BodyTooLarge(self.error_message)
        HttpServerError.ParseError(self.error_message)

# ============================================================================
# Host policy (RFC 9112 §3.2) — parity with the sync parser's
# request_host_error, plus authority validation and absolute-form agreement.
# ============================================================================

# Returns (true, lower_authority) for an absolute-form target ("http://Host:1/a"
# -> (true, "host:1")), or (false, "") when the target is origin-form. `target`
# is the path component (the query was already split off by parse_request_line).
fn _async_absolute_form_authority(target: text) -> (bool, text):
    val lower = target.lower()
    var rest = ""
    if lower.starts_with("http://"):
        rest = lower.slice(7, lower.byte_len())
    elif lower.starts_with("https://"):
        rest = lower.slice(8, lower.byte_len())
    else:
        return (false, "")
    var end = rest.byte_len()
    for sep in ["/", "#"]:
        val i = rest.index_of(sep)
        if i >= 0 and i < end:
            end = i
    (true, rest.slice(0, end))

fn _async_is_port(s: text) -> bool:
    if s.byte_len() == 0 or s.byte_len() > 5:
        return false
    for code in string_bytes(s):
        if code < 48 or code > 57:
            return false
    true

# reg-name / IPv4 bytes: unreserved, sub-delims and pct-encoding (RFC 3986).
fn _async_is_reg_name(s: text) -> bool:
    if s.byte_len() == 0:
        return false
    val bytes = string_bytes(s)
    val total = bytes.len()
    var i = 0
    while i < total:
        val code = bytes[i]
        val alpha = (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
        val digit = code >= 48 and code <= 57
        # - . _ ~ ! $ & ' ( ) * + , ; =
        val other = (
            code == 45 or code == 46 or code == 95 or code == 126 or
            code == 33 or code == 36 or code == 38 or code == 39 or
            code == 40 or code == 41 or code == 42 or code == 43 or
            code == 44 or code == 59 or code == 61
        )
        if code == 37:
            if i + 2 >= total:
                return false
            if not _async_is_hex(bytes[i + 1]) or not _async_is_hex(bytes[i + 2]):
                return false
            i = i + 3
        elif alpha or digit or other:
            i = i + 1
        else:
            return false
    true

fn _async_is_hex(code: i64) -> bool:
    (code >= 48 and code <= 57) or (code >= 65 and code <= 70) or (code >= 97 and code <= 102)

# IP-literal body between brackets: hex digits, ':' and '.' (IPv6, with an
# optional trailing dotted IPv4).
fn _async_is_ip_literal_body(s: text) -> bool:
    if s.byte_len() == 0:
        return false
    for code in string_bytes(s):
        if not _async_is_hex(code) and code != 58 and code != 46:
            return false
    true

# A Host value must be exactly uri-host [ ":" port ]. Userinfo ("@"),
# whitespace, path delimiters, a malformed port and unbalanced IP-literal
# brackets are all rejected, so the authority cannot be split differently by
# a downstream component than it is here.
fn _async_host_authority_valid(host: text) -> bool:
    if host.starts_with("["):
        val close = host.index_of("]")
        if close < 0:
            return false
        if not _async_is_ip_literal_body(host.slice(1, close)):
            return false
        val after = host.slice(close + 1, host.byte_len())
        if after.byte_len() == 0:
            return true
        if not after.starts_with(":"):
            return false
        return _async_is_port(after.slice(1, after.byte_len()))
    val colon = host.index_of(":")
    if colon < 0:
        return _async_is_reg_name(host)
    _async_is_reg_name(host.slice(0, colon)) and _async_is_port(host.slice(colon + 1, host.byte_len()))

# Returns "" when the Host policy admits the request, else a 400 message.
# Every version other than HTTP/1.0 requires exactly one non-empty Host;
# duplicates are invalid even when equal. HTTP/1.0 keeps its optional-Host
# behavior, but a Host that is present must still be valid. An absolute-form
# target must carry a non-empty authority identical (case-insensitively) to
# Host — RFC 9112 §3.2 requires identity, so no default-port normalization.
fn _async_request_host_error(headers: [(text, text)], version: text, target: text) -> text:
    var host_count: i32 = 0
    var host_value = ""
    for header in headers:
        if header.0.lower() == "host":
            host_count = host_count + 1
            host_value = header.1
    if host_count == 0:
        if version != "HTTP/1.0":
            return "400 Missing Host header"
        return ""
    if host_count > 1:
        return "400 Multiple Host headers"
    if host_value == "":
        return "400 Empty Host header"
    if not _async_host_authority_valid(host_value):
        return "400 Invalid Host header"
    val target_authority = _async_absolute_form_authority(target)
    if target_authority.0:
        val authority = target_authority.1
        if authority == "" or authority != host_value.lower():
            return "400 Host does not match request-target authority"
    ""
