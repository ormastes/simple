"""
# HTTP Response Serialization

Serializes HttpResponseData into HTTP/1.1 wire format.
Supports plain body, chunked encoding, and sendfile hints.

## Usage

```simple
val resp = default_response_data(200, "OK", "<h1>Hello</h1>")
val bytes = serialize_response(resp)
# bytes = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n..."
```
"""

use std.http_server.types.{HttpResponseData, default_response_data}
use std.common.net.http_core.{response_body_framing_decision, response_declared_content_length}

fn status_reason(code: i64) -> text:
    if code == 200: return "OK"
    if code == 201: return "Created"
    if code == 204: return "No Content"
    if code == 301: return "Moved Permanently"
    if code == 302: return "Found"
    if code == 304: return "Not Modified"
    if code == 400: return "Bad Request"
    if code == 401: return "Unauthorized"
    if code == 403: return "Forbidden"
    if code == 404: return "Not Found"
    if code == 405: return "Method Not Allowed"
    if code == 408: return "Request Timeout"
    if code == 413: return "Payload Too Large"
    if code == 429: return "Too Many Requests"
    if code == 500: return "Internal Server Error"
    if code == 502: return "Bad Gateway"
    if code == 503: return "Service Unavailable"
    if code == 504: return "Gateway Timeout"
    "Unknown"

# ============================================================================
# Response Serialization
# ============================================================================

fn serialize_response(resp: HttpResponseData) -> text:
    """Serialize an HttpResponseData to HTTP/1.1 wire format.

    Args:
        resp: Response data to serialize

    Returns:
        Complete HTTP response as text
    """
    serialize_response_for_method(resp, "GET")

fn _response_selected_length(resp: HttpResponseData, request_method: text) -> i64:
    if resp.body_bytes.len() > 0:
        return resp.body_bytes.len()
    if resp.body.len() > 0:
        return resp.body.len()
    if resp.body_file != "" and resp.body_length > 0:
        return resp.body_length
    if request_method == "HEAD" or resp.status == 304:
        val declared = response_declared_content_length(resp.headers)
        if declared >= 0:
            return declared
    0

fn serialize_response_for_method(resp: HttpResponseData, request_method: text) -> text:
    var parts: [text] = []
    parts.push("HTTP/1.1 {resp.status} {resp.reason}\r\n")

    val body_len = _response_selected_length(resp, request_method)
    # `chunked` is retained for API compatibility, but this serializer has no
    # chunk codec.  Emit an exact Content-Length instead of claiming chunked
    # framing while appending raw payload bytes.
    val framing = response_body_framing_decision(
        request_method, resp.status, false)
    for header in resp.headers:
        val name = header.0
        val value = header.1
        val lower = name.lower()
        if lower != "content-length" and lower != "transfer-encoding" and
                lower != "trailer" and lower != "proxy-connection":
            parts.push("{name}: {value}\r\n")

    if framing.emit_transfer_encoding:
        parts.push("Transfer-Encoding: chunked\r\n")
    elif framing.emit_content_length:
        val framed_body_len = if framing.content_length_must_be_zero: 0 else: body_len
        parts.push("Content-Length: {framed_body_len}\r\n")

    parts.push("\r\n")

    if framing.transfer_body and resp.body.len() > 0:
        parts.push(resp.body)

    parts.join("")

# ============================================================================
# Response Builders
# ============================================================================

fn build_ok(body: text, content_type: text) -> HttpResponseData:
    """200 OK response with body."""
    HttpResponseData(
        status: 200,
        reason: "OK",
        headers: [
            ("Content-Type", content_type),
            ("Server", "SimpleServer")
        ],
        body: body,
        body_bytes: [],
        body_file: "",
        body_offset: 0,
        body_length: 0,
        chunked: false
    )

fn build_json(body: text) -> HttpResponseData:
    """200 OK JSON response."""
    build_ok(body, "application/json")

fn build_html(body: text) -> HttpResponseData:
    """200 OK HTML response."""
    build_ok(body, "text/html; charset=utf-8")

fn build_text(body: text) -> HttpResponseData:
    """200 OK plain text response."""
    build_ok(body, "text/plain; charset=utf-8")

fn build_redirect(url: text, status: i64) -> HttpResponseData:
    """Redirect response (301 or 302)."""
    val reason = match status:
        301: "Moved Permanently"
        302: "Found"
        307: "Temporary Redirect"
        308: "Permanent Redirect"
        _: "Found"

    HttpResponseData(
        status: status,
        reason: reason,
        headers: [
            ("Location", url),
            ("Server", "SimpleServer"),
            ("Content-Length", "0")
        ],
        body: "",
        body_bytes: [],
        body_file: "",
        body_offset: 0,
        body_length: 0,
        chunked: false
    )

fn build_error(status: i64, message: text) -> HttpResponseData:
    """Error response with HTML body."""
    val reason = status_reason(status)
    val body = "<html><head><title>{status} {reason}</title></head>" +
               "<body><h1>{status} {reason}</h1><p>{message}</p>" +
               "<hr><p>SimpleServer</p></body></html>"

    HttpResponseData(
        status: status,
        reason: reason,
        headers: [
            ("Content-Type", "text/html; charset=utf-8"),
            ("Server", "SimpleServer"),
            ("Connection", "close")
        ],
        body: body,
        body_bytes: [],
        body_file: "",
        body_offset: 0,
        body_length: 0,
        chunked: false
    )

fn build_not_found() -> HttpResponseData:
    """404 Not Found response."""
    build_error(404, "The requested resource was not found.")

fn build_method_not_allowed() -> HttpResponseData:
    """405 Method Not Allowed response."""
    build_error(405, "The request method is not allowed for this resource.")

fn build_request_timeout() -> HttpResponseData:
    """408 Request Timeout response."""
    build_error(408, "The server timed out waiting for the request.")

fn build_too_large() -> HttpResponseData:
    """413 Content Too Large response."""
    build_error(413, "The request body exceeds the maximum allowed size.")

fn build_internal_error() -> HttpResponseData:
    """500 Internal Server Error response."""
    build_error(500, "An internal server error occurred.")

fn build_service_unavailable() -> HttpResponseData:
    """503 Service Unavailable response."""
    build_error(503, "The server is temporarily unable to handle the request.")

fn build_phase_response(status: i64, reason: text, extra_headers: [(text, text)], body: text) -> HttpResponseData:
    """Build a response from a PhaseResult.Respond payload.

    Merges extra_headers (from middleware) into the standard Server header set.
    CRLF injection guard: header names or values containing \\r or \\n are dropped
    before the response is constructed.
    """
    var safe_headers: [(text, text)] = []
    for h in extra_headers:
        val hname = h.0
        val hval = h.1
        val name_bad = hname.contains("\r") or hname.contains("\n")
        val val_bad = hval.contains("\r") or hval.contains("\n")
        if not name_bad and not val_bad:
            safe_headers.push((hname, hval))

    var all_headers: [(text, text)] = [("Server", "SimpleServer")]
    for h in safe_headers:
        all_headers.push(h)

    HttpResponseData(
        status: status,
        reason: reason,
        headers: all_headers,
        body: body,
        body_bytes: [],
        body_file: "",
        body_offset: 0,
        body_length: 0,
        chunked: false
    )

# ============================================================================
# File Response (for static file handler)
# ============================================================================

fn build_file_response(path: text, content_type: text, size: i64) -> HttpResponseData:
    """Response that signals sendfile for zero-copy transfer.

    The body_file field tells the worker to use IoDriver.submit_sendfile()
    instead of sending body bytes.

    Args:
        path: Absolute file path
        content_type: MIME type
        size: File size in bytes

    Returns:
        Response with body_file set for sendfile
    """
    HttpResponseData(
        status: 200,
        reason: "OK",
        headers: [
            ("Content-Type", content_type),
            ("Content-Length", "{size}"),
            ("Server", "SimpleServer")
        ],
        body: "",
        body_bytes: [],
        body_file: path,
        body_offset: 0,
        body_length: size,
        chunked: false
    )

fn build_not_modified() -> HttpResponseData:
    """304 Not Modified response (for conditional requests)."""
    HttpResponseData(
        status: 304,
        reason: "Not Modified",
        headers: [("Server", "SimpleServer")],
        body: "",
        body_bytes: [],
        body_file: "",
        body_offset: 0,
        body_length: 0,
        chunked: false
    )

# ============================================================================
# Keep-Alive Header Helpers
# ============================================================================

fn add_keepalive_headers(resp: HttpResponseData, keepalive: bool, timeout_s: i64) -> HttpResponseData:
    """Add Connection and Keep-Alive headers."""
    var headers: [(text, text)] = []
    for header in resp.headers:
        val lower = header.0.lower()
        if lower != "connection" and lower != "keep-alive" and
                lower != "proxy-connection":
            headers.push(header)
    if keepalive:
        headers.push(("Connection", "keep-alive"))
        headers.push(("Keep-Alive", "timeout={timeout_s}"))
    else:
        headers.push(("Connection", "close"))

    HttpResponseData(
        status: resp.status,
        reason: resp.reason,
        headers: headers,
        body: resp.body,
        body_bytes: resp.body_bytes,
        body_file: resp.body_file,
        body_offset: resp.body_offset,
        body_length: resp.body_length,
        chunked: resp.chunked
    )

# ============================================================================
# Binary Response Serializer
# ============================================================================

fn serialize_response_bytes(resp: HttpResponseData) -> [u8]:
    """Serialize an HttpResponseData to HTTP/1.1 wire format as bytes.

    Uses body_bytes if non-empty, else the bytes of body: text.
    Content-Length is computed from the actual payload.

    Args:
        resp: Response data to serialize

    Returns:
        Complete HTTP response as [u8]
    """
    serialize_response_bytes_for_method(resp, "GET")

fn serialize_response_bytes_for_method(resp: HttpResponseData, request_method: text) -> [u8]:
    # Determine actual body payload
    val use_body_bytes = resp.body_bytes.len() > 0
    val body_len = _response_selected_length(resp, request_method)

    var out: [u8] = []
    # Status line
    out = _append_text_bytes(out, "HTTP/1.1 {resp.status} {resp.reason}\r\n")

    val framing = response_body_framing_decision(
        request_method, resp.status, false)
    # Headers
    for header in resp.headers:
        val name = header.0
        val value = header.1
        val lower = name.lower()
        if lower != "content-length" and lower != "transfer-encoding" and
                lower != "trailer" and lower != "proxy-connection":
            out = _append_text_bytes(out, "{name}: {value}\r\n")

    if framing.emit_transfer_encoding:
        out = _append_text_bytes(out, "Transfer-Encoding: chunked\r\n")
    elif framing.emit_content_length:
        val framed_body_len = if framing.content_length_must_be_zero: 0 else: body_len
        out = _append_text_bytes(out, "Content-Length: {framed_body_len}\r\n")

    out = _append_text_bytes(out, "\r\n")

    # Body
    if framing.transfer_body and use_body_bytes:
        out = out + resp.body_bytes
    elif framing.transfer_body and resp.body.len() > 0:
        out = _append_text_bytes(out, resp.body)

    out

fn _append_text_bytes(buf: [u8], s: text) -> [u8]:
    """Return `buf` extended with the UTF-8 bytes of `s`."""
    val bytes = _text_to_bytes(s)
    var out = buf + bytes
    out

fn _text_to_bytes(s: text) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < s.len():
        out.push(s.byte_at(i))
        i = i + 1
    out
