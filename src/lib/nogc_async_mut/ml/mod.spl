# Async ML Module
#
# Re-exports from async training and data pipeline submodules.
#
# This module provides async-compatible ML utilities that combine
# the pure ML library with async patterns for training workflows.
#
# Submodules:
#   - async_training: Training loops (train_epoch, evaluate_model, train_loop)
#   - data_pipeline: Batch prefetching and index shuffling

use std.nogc_async_mut.ml.async_training.{train_epoch, evaluate_model, train_loop}
use std.nogc_async_mut.ml.data_pipeline.{prefetch_batches, shuffle_indices}


# Loss and normalization surface is NOT defined here — it is re-exported from
# the pure nn modules so `std.ml` consumers get one definition, not a shadow.
pub use common.pure.nn.loss.{nll_loss, bce_with_logits_loss, kl_div_loss, cosine_embedding_loss, triplet_margin_loss, hinge_loss}
pub use common.pure.nn.norm.{BatchNorm2d, GroupNorm, InstanceNorm2d, batchnorm2d_create, groupnorm_create, instancenorm2d_create}
