# SPipe Alias Module
#
# Runtime-family alias for tests that import `std.nogc_async_mut.spipe`.
#
# A bare `use std.spec` does NOT re-export std.spec's own `pub fn`s through
# this alias, so `use std.spipe.{before_all, after_all}` warned "module does
# not provide it" and the hooks silently never ran. `export use std.spec.*`
# does not work either — the star form resolves `std.spec` to the spec/
# PACKAGE directory, not spec.spl. Name the hooks explicitly. See
# doc/08_tracking/bug/spipe_before_all_after_all_not_found_t32_hw_2026-07-20.md

use std.spec
use std.spec.{before_all, after_all}

export before_all
export after_all
