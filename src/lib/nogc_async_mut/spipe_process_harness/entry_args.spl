# Entry-argument normalisation for the SPipe process harness CLI.
#
# Measured `get_cli_args()` shapes: `bin/simple.exe run <script> a b` yields
# `[a, b]` (no program name, no script path). A host that prepends the program
# and/or script path yields `[program, script, a, b]`. Only those leading
# elements and the `spipe-process-harness` dispatch token are skipped; a known
# action is never skipped.

# Arguments left after the entry elements were removed.
pub struct HarnessArgs:
    items: [text]

fn is_known_action(arg: text) -> bool:
    arg == "state" or arg == "hook" or arg == "gate" or arg == "hud" or
        arg == "deploy" or arg == "goal" or arg == "help" or arg == "--help"

fn is_script_path(arg: text) -> bool:
    arg == "src/app/spipe_process_harness/main.spl" or
        arg.ends_with("/app/spipe_process_harness/main.spl") or
        arg.ends_with("\app\spipe_process_harness\main.spl")

fn is_program_name(arg: text) -> bool:
    if is_known_action(arg) or arg.starts_with("-"):
        return false
    arg == "simple" or arg.contains("/") or arg.contains("\\") or arg.ends_with(".exe")

pub fn strip_entry_args(raw: [text]) -> HarnessArgs:
    var start = 0
    var idx = 0
    while idx < raw.len():
        if is_script_path(raw[idx]):
            start = idx + 1
        idx = idx + 1
    if start == 0 and raw.len() > 0 and is_program_name(raw[0]):
        start = 1
    while start < raw.len() and raw[start] == "spipe-process-harness":
        start = start + 1
    var out: [text] = []
    while start < raw.len():
        out.push(raw[start])
        start = start + 1
    HarnessArgs(items: out)

export HarnessArgs, strip_entry_args
