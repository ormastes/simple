# SPipe process harness shared types.

# Closed set of LLM front-ends the harness adapts to. Any name the harness
# does not recognise parses to `Unknown` (stable fallback, never the raw text).
enum Provider:
    Claude
    Codex
    Gemini
    Kimi
    Unknown

# Whether the prevention gate demands a recorded user approval.
enum ApprovalRequirement:
    Required
    NotRequired

# Whether the user approved the SPipe state being rendered.
enum UserApproval:
    Approved
    Unapproved

# Prevention-gate outcome. The CLI maps it to a process exit status at the
# boundary (`src/app/spipe_process_harness/main.spl`).
enum GateVerdict:
    Allow
    Block

# Provider-reported session identifier carried in hook envelopes.
struct HookSessionId:
    value: text

# Model identifier as reported by the provider (e.g. "gpt-5", "sonnet").
struct ModelName:
    value: text

# SPipe feature slug selecting `.spipe/<slug>/`; blank means the harness default.
struct FeatureSlug:
    value: text

struct HarnessOptions:
    provider: Provider
    feature: FeatureSlug
    event: text
    model: ModelName
    session_id: HookSessionId
    raw_payload: text
    require_approval: bool

struct GateDecision:
    verdict: GateVerdict
    reason: text

struct HudSnapshot:
    model: text
    jj_worktree: text
    commit_id: text
    hours_remaining: text
    week_remaining: text
    goal: text

struct HookDeploySnippet:
    provider: Provider
    path: text
    content: text
