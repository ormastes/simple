# =============================================================================
# Packet Structure Functions
# MqttPacket: type, flags, headers, payload
# Headers and payload shapes depend on the packet type, so they are closed enums.
# =============================================================================

enum MqttHeaders:
    NoHeaders
    # (protocol_version, flags, keep_alive, client_id, will_topic, will_message,
    #  will_qos, will_retain, properties, will_properties, auth_method)
    Connect((i64, i64, i64, text, text?, text?, i64?, bool?, text?, text?, text?))
    # (session_present, return_code, properties)
    Connack((bool, i64, text?))
    # (topic, packet_id, properties)
    Publish((text, i64?, text?))
    # (packet_id, properties)
    PacketId((i64, text?))
    # (reason_code, properties)
    Reason((i64, text?))
    # (reason_code, auth_method, auth_data, properties)
    Auth((i64, text?, text?, text?))

enum MqttPayload:
    NoPayload
    Text(text)
    Filters([(text, i64)])
    Codes([i64])
    Topics([text])

struct MqttPacket:
    packet_type: i64
    flags: i64
    headers: MqttHeaders
    payload: MqttPayload

fn mqtt_create_packet(packet_type: i64, flags: i64, headers: MqttHeaders, payload: MqttPayload) -> MqttPacket:
    """Create an MQTT packet."""
    MqttPacket(packet_type: packet_type, flags: flags, headers: headers, payload: payload)

fn mqtt_packet_or_default(packet: MqttPacket?) -> MqttPacket:
    if val p = packet:
        return p
    MqttPacket(packet_type: 0, flags: 0, headers: MqttHeaders.NoHeaders, payload: MqttPayload.NoPayload)

fn mqtt_packet_type(packet: MqttPacket?) -> i64:
    """Get packet type from packet."""
    mqtt_packet_or_default(packet).packet_type

fn mqtt_packet_flags(packet: MqttPacket?) -> i64:
    """Get packet flags from packet."""
    mqtt_packet_or_default(packet).flags

fn mqtt_packet_headers(packet: MqttPacket?) -> MqttHeaders:
    """Get packet headers from packet."""
    mqtt_packet_or_default(packet).headers

fn mqtt_packet_payload(packet: MqttPacket?) -> MqttPayload:
    """Get packet payload from packet."""
    mqtt_packet_or_default(packet).payload

fn mqtt_set_packet_type(packet: MqttPacket?, packet_type: i64) -> MqttPacket:
    """Set packet type in packet."""
    val p = mqtt_packet_or_default(packet)
    MqttPacket(packet_type: packet_type, flags: p.flags, headers: p.headers, payload: p.payload)

fn mqtt_set_packet_flags(packet: MqttPacket?, flags: i64) -> MqttPacket:
    """Set packet flags in packet."""
    val p = mqtt_packet_or_default(packet)
    MqttPacket(packet_type: p.packet_type, flags: flags, headers: p.headers, payload: p.payload)

fn mqtt_set_packet_headers(packet: MqttPacket?, headers: MqttHeaders) -> MqttPacket:
    """Set packet headers in packet."""
    val p = mqtt_packet_or_default(packet)
    MqttPacket(packet_type: p.packet_type, flags: p.flags, headers: headers, payload: p.payload)

fn mqtt_set_packet_payload(packet: MqttPacket?, payload: MqttPayload) -> MqttPacket:
    """Set packet payload in packet."""
    val p = mqtt_packet_or_default(packet)
    MqttPacket(packet_type: p.packet_type, flags: p.flags, headers: p.headers, payload: payload)
