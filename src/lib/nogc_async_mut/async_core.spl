# async_core - Shared async vocabulary types
#
# The types every async tier agrees on. `async_embedded`, `async_host` and
# `async_unified` all import this module; it is the single place the shared
# spelling of an async error, a scheduling priority and a task state lives.
#
# Two of these types are declared here because they exist nowhere else in the
# tier (AsyncError, Priority). The other three are owned by the `async`
# subtree and are re-exported so importers get one consistent module.

export use std.async.poll.{Poll}
export use std.async.task.{TaskState}
export use std.async.cancellation.{CancellationToken}

enum AsyncError:
    """Error raised by an async runtime operation.

    - CapacityExceeded: a fixed-capacity scheduler or queue is full
    - Timeout: the operation did not complete inside its deadline
    - JoinError(msg): a task ended without producing a result
    """
    CapacityExceeded
    Timeout
    JoinError(text)

enum Priority:
    """Scheduling priority for an async task.

    Ordered most urgent first. `to_i32` returns the scheduler's sort key, in
    which a NUMERICALLY SMALLER value means MORE urgent -- schedulers in this
    tier select with `if pri < best_priority`, so Critical must be 0.
    """
    Critical
    High
    Normal
    Low

impl Priority:
    fn to_i32() -> i32:
        """Sort key: smaller is more urgent."""
        match self:
            case Priority.Critical: 0
            case Priority.High: 1
            case Priority.Normal: 2
            case Priority.Low: 3

    static fn from_i32(v: i32) -> Priority:
        """Inverse of `to_i32`. Values outside 0..3 clamp to the nearest end."""
        if v <= 0: return Priority.Critical
        if v == 1: return Priority.High
        if v == 2: return Priority.Normal
        Priority.Low
