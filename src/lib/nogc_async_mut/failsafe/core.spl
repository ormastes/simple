# Fail-Safe Framework Core
# Pure Simple implementation - no SFFI dependencies

type Count = i64
type GaugeValue = f64

# ============================================================================
# ERROR TYPES
# ============================================================================

pub enum ErrorSeverity:
    Debug
    Info
    Warning
    Error
    Critical
    Fatal

    fn to_string() -> text:
        match self:
            case Debug: "debug"
            case Info: "info"
            case Warning: "warning"
            case Error: "error"
            case Critical: "critical"
            case Fatal: "fatal"

    fn to_level() -> i64:
        match self:
            case Debug: 0
            case Info: 1
            case Warning: 2
            case Error: 3
            case Critical: 4
            case Fatal: 5

pub enum ErrorCategory:
    Network
    Timeout
    Validation
    Internal
    RateLimit
    TooManyRequests
    Panic
    Overflow
    DivisionByZero
    ResourceExhausted
    Exhausted

    fn to_string() -> text:
        match self:
            case Network: "network"
            case Timeout: "timeout"
            case Validation: "validation"
            case Internal: "internal"
            case RateLimit: "rate_limit"
            case TooManyRequests: "too_many_requests"
            case Panic: "panic"
            case Overflow: "overflow"
            case DivisionByZero: "division_by_zero"
            case ResourceExhausted: "resource_exhausted"
            case Exhausted: "exhausted"

    fn is_recoverable() -> bool:
        match self:
            case Network: true
            case Timeout: true
            case RateLimit: true
            case TooManyRequests: true
            case Panic: false
            case Internal: false
            case _: true

# ============================================================================
# FAIL-SAFE ERROR
# ============================================================================

pub class FailSafeError:
    category: ErrorCategory
    severity: ErrorSeverity
    message: text
    recoverable: bool
    retry_after_ms: i64

    static fn new(category: ErrorCategory, message: text) -> FailSafeError:
        return FailSafeError(
            category,
            ErrorSeverity.Error,
            message,
            category.is_recoverable(),
            0
        )

    fn with_severity(severity: ErrorSeverity) -> FailSafeError:
        return FailSafeError(
            self.category,
            severity,
            self.message,
            self.recoverable,
            self.retry_after_ms
        )

    fn with_retry(retry_after_ms: i64) -> FailSafeError:
        return FailSafeError(
            self.category,
            self.severity,
            self.message,
            true,
            retry_after_ms
        )

    fn as_unrecoverable() -> FailSafeError:
        return FailSafeError(
            self.category,
            self.severity,
            self.message,
            false,
            0
        )

    fn to_string() -> text:
        return "[{self.severity.to_string()}] {self.category.to_string()}: {self.message}"

# ============================================================================
# FAIL-SAFE RESULT
# ============================================================================

# Match through a parameter, not `self`: the self-hosted HIR rejects generic
# enum patterns on self subjects (same shape as async/poll.spl).
# @workaround bug=generic_enum_pattern_self_subject_hir_2026_10_22 reason=selfhosted_hir_rejects_generic_enum_patterns_on_self_field_subjects_but_accepts_parameter_subjects
fn failsafe_result_is_ok<T>(result: FailSafeResult<T>) -> bool:
    match result:
        case FailSafeResult.Ok(_): true
        case FailSafeResult.Err(_): false

fn failsafe_result_unwrap<T>(result: FailSafeResult<T>) -> T:
    match result:
        case FailSafeResult.Ok(v): v
        case FailSafeResult.Err(e): panic("unwrap on Err: {e.message}")

fn failsafe_result_unwrap_or<T>(result: FailSafeResult<T>, default: T) -> T:
    match result:
        case FailSafeResult.Ok(v): v
        case FailSafeResult.Err(_): default

pub enum FailSafeResult<T>:
    Ok(T)
    Err(FailSafeError)

    fn is_ok() -> bool:
        failsafe_result_is_ok(self)

    fn is_err() -> bool:
        return not self.is_ok()

    fn unwrap() -> T:
        failsafe_result_unwrap(self)

    fn unwrap_or(default: T) -> T:
        failsafe_result_unwrap_or(self, default)

# ============================================================================
# HEALTH STATUS
# ============================================================================

pub enum HealthStatus:
    Healthy
    Degraded
    Unhealthy

    fn to_string() -> text:
        match self:
            case Healthy: "healthy"
            case Degraded: "degraded"
            case Unhealthy: "unhealthy"

    fn is_healthy() -> bool:
        match self:
            case Healthy: true
            case _: false

# ============================================================================
# METRICS
# ============================================================================

pub class Counter:
    name: text
    value: Count

    static fn new(name: text) -> Counter:
        return Counter(name, 0)

    me inc():
        self.value = self.value + 1

    me add(n: i64):
        self.value = self.value + n

    me reset():
        self.value = 0

pub class Gauge:
    name: text
    value: GaugeValue

    static fn new(name: text) -> Gauge:
        return Gauge(name, 0.0)

    me set(v: f64):
        self.value = v

    me inc():
        self.value = self.value + 1.0

    me dec():
        self.value = self.value - 1.0

    me add(n: f64):
        self.value = self.value + n

    me sub(n: f64):
        self.value = self.value - n

pub class MetricsRegistry:
    counters: Dict<text, Counter>
    gauges: Dict<text, Gauge>

    static fn new() -> MetricsRegistry:
        return MetricsRegistry({}, {})

    # NOTE: index read + contains_key, not .get() — Dict<K, class> .get()
    # returns a corrupt payload under native codegen.
    me get_counter(name: text) -> Counter:
        if self.counters.contains_key(name):
            val existing = self.counters[name]
            return existing
        val c = Counter.new(name)
        self.counters[name] = c
        return c

    me get_gauge(name: text) -> Gauge:
        if self.gauges.contains_key(name):
            val existing = self.gauges[name]
            return existing
        val g = Gauge.new(name)
        self.gauges[name] = g
        return g

# ============================================================================
# LOGGING
# ============================================================================

pub enum LogLevel:
    Debug
    Info
    Warn
    Error

    fn to_string() -> text:
        match self:
            case Debug: "DEBUG"
            case Info: "INFO"
            case Warn: "WARN"
            case Error: "ERROR"

    fn to_i64() -> i64:
        match self:
            case Debug: 0
            case Info: 1
            case Warn: 2
            case Error: 3

pub class ConsoleLogger:
    min_level: LogLevel

    static fn new(min_level: LogLevel) -> ConsoleLogger:
        return ConsoleLogger(min_level)

    fn is_enabled(level: LogLevel) -> bool:
        return level.to_i64() >= self.min_level.to_i64()

    fn log(level: LogLevel, message: text):
        if self.is_enabled(level):
            print "[{level.to_string()}] {message}"
