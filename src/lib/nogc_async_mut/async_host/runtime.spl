# HostRuntime - Full-Featured Async Runtime
#
# Main runtime for host applications with work-stealing and structured concurrency.
# Supports both single-threaded and multi-threaded execution.

use std.async_core.{AsyncError, CancellationToken, Poll, Priority, TaskState}
use std.async_host.scheduler.{HostScheduler}
use std.async_host.handle.{HostTaskHandle}
use std.async_host.joinset.{HostJoinSet}
use std.thread_sffi.{thread_cpu_count}

enum RuntimeMode:
    """Runtime execution mode."""
    SingleThreaded    # All tasks on main thread
    MultiThreaded     # Tasks distributed across OS threads

class HostRuntime:
    """Complete async runtime for host applications.

    Combines scheduler, I/O, and timers.
    Supports both single-threaded and multi-threaded execution.

    Example (single-threaded):
        val runtime = HostRuntime.new()
        val handle = runtime.run_task(async: work())
        runtime.block_on(handle.join())

    Example (multi-threaded):
        val runtime = HostRuntime.multi_threaded(4)
        val handle = runtime.run_task(async: work())
        runtime.block_on(handle.join())
    """
    scheduler: HostScheduler
    next_id: usize
    mode: RuntimeMode
    num_threads: usize

    static fn new() -> HostRuntime:
        """Create single-threaded runtime.

        Returns:
            Runtime with 1 worker (main thread)
        """
        HostRuntime(
            scheduler: HostScheduler.new(1),
            next_id: 0,
            mode: RuntimeMode.SingleThreaded,
            num_threads: 1
        )

    static fn with_workers(count: usize) -> HostRuntime:
        """Create single-threaded runtime with multiple work queues.

        Note: This creates multiple queues but runs on single thread.
        For true parallelism, use multi_threaded().

        Args:
            count: Number of work queues

        Returns:
            Single-threaded runtime with work-stealing
        """
        HostRuntime(
            scheduler: HostScheduler.new(count),
            next_id: 0,
            mode: RuntimeMode.SingleThreaded,
            num_threads: 1
        )

    static fn multi_threaded(num_threads: usize) -> HostRuntime:
        """Create multi-threaded runtime with OS threads.

        Tasks are distributed across OS threads for true parallel execution.

        Args:
            num_threads: Number of OS threads (0 = auto-detect CPU count)

        Returns:
            Multi-threaded runtime

        Example:
            val runtime = HostRuntime.multi_threaded(4)
            # Spawns 4 OS worker threads
        """
        var threads = num_threads
        if threads == 0:
            threads = thread_cpu_count()
            if threads < 1:
                threads = 4  # fallback

        HostRuntime(
            scheduler: HostScheduler.new_multi_threaded(threads),
            next_id: 0,
            mode: RuntimeMode.MultiThreaded,
            num_threads: threads
        )

    fn is_multi_threaded() -> bool:
        """Check if runtime uses multiple OS threads.

        Returns:
            true if multi-threaded, false if single-threaded
        """
        match self.mode:
            case RuntimeMode.MultiThreaded: true
            case RuntimeMode.SingleThreaded: false

    me _schedule_handle<T>(priority: Priority, poll_fn: fn() -> Poll<()>) -> HostTaskHandle<T>:
        """Bind a handle to the scheduler's admitted lifetime, never a copy owner."""
        match self.scheduler.try_schedule(priority, poll_fn):
            case Err(message):
                HostTaskHandle(task_id: 9223372036854775807,
                    state: TaskState.Cancelled, result: nil,
                    error: Some(AsyncError.CapacityExceeded),
                    cancel_token: CancellationToken(token_id: -1, parent_id: -1),
                    wakers: [], context: nil)
            case Ok(id):
                match self.scheduler.task_context(id):
                    case Ok(context):
                        HostTaskHandle(task_id: id, state: TaskState.Pending,
                            result: nil, error: nil, cancel_token: context.lifetime,
                            wakers: [], context: Some(context))
                    case Err(message):
                        self.scheduler.cancel_task(id)
                        self.scheduler.reap_task(id)
                        HostTaskHandle(task_id: id, state: TaskState.Cancelled,
                            result: nil, error: Some(AsyncError.JoinError(message)),
                            cancel_token: CancellationToken(token_id: -1, parent_id: -1),
                            wakers: [], context: nil)

    me run_task<T>(f: fn() -> T) -> HostTaskHandle<T>:
        """Run task and return handle."""
        val poll_fn = \:
            f()
            Poll.Ready(())
        self._schedule_handle<T>(Priority.Normal, poll_fn)

    me run_task_with_priority<T>(f: fn() -> T, priority: Priority) -> HostTaskHandle<T>:
        """Run with specific priority."""
        val poll_fn = \:
            f()
            Poll.Ready(())
        self._schedule_handle<T>(priority, poll_fn)

    me run_result_task<T>(f: fn() -> Result<T, text>) -> HostTaskHandle<T>:
        """Run a Result-returning task and surface errors on the handle (W2-5 H3).

        When the task body returns Err(msg), the HostTaskHandle.error field is
        populated with AsyncError.JoinError(msg) and the scheduler records a
        death reason keyed by current_unified_task_key().
        Plain-value task bodies: use run_task() — zero overhead on that path.
        """
        val poll_fn = \:
            f()
            Poll.Ready(())
        # Result publication remains the existing separate caller obligation.
        self._schedule_handle<T>(Priority.Normal, poll_fn)

    me drain_result_errors<T>(handle: HostTaskHandle<T>, error_store: Option<text>) -> HostTaskHandle<T>:
        """Populate handle.error from error_store after task completion (W2-5 H3).

        Call after block_on() / run() to surface any Err from run_result_task.
        """
        match error_store:
            case Some(msg):
                var h = handle
                h.error = Some(AsyncError.JoinError(msg))
                self.scheduler.mark_task_error(handle.task_id, msg)
                h
            case nil:
                handle

    me block_on<T>(future: HostFuture<T>) -> T:
        """Block until future completes."""
        while true:
            while not future.is_ready():
                self.scheduler.run_one()
            match future.poll():
                case Poll.Ready(value):
                    return value
                case Poll.Pending:
                    self.scheduler.run_one()

    me run():
        """Run all pending tasks."""
        self.scheduler.run()

