# HTTP Headers Handling
#
# Provides HTTP header parsing, formatting, and manipulation.
# Includes canonicalization and duplicate-header policy.

use std.http.common.{parse_headers as common_parse_headers, parse_header as common_parse_header, format_headers as common_format_headers, parse_int as common_parse_int, index_of as common_index_of, hex_to_int as common_hex_to_int}

# ============================================================================
# HTTP Headers
# ============================================================================

# Parse list of header lines into list of (name, value) tuples
fn parse_headers(lines: list) -> list:
    return common_parse_headers(lines)

# Parse single header line
# Example: "Content-Type: application/json" -> ("Content-Type", "application/json")
fn parse_header(line: text) -> tuple:
    return common_parse_header(line)

# Format headers list into HTTP header text
fn format_headers(headers: list) -> text:
    return common_format_headers(headers)

# Get header value by name (case-insensitive)
# Returns nil if not found
fn get_header(headers: list, name: text) -> text?:
    val lower_name = name.lower()

    var i = 0
    while i < headers.length():
        val header = headers[i]
        val header_name = header[0]
        val header_value = header[1]

        val lower_header_name = header_name.lower()

        if lower_header_name == lower_name:
            return header_value

        i = i + 1

    return nil

# Set header value (replaces existing or adds new)
fn set_header(headers: list, name: text, value: text) -> list:
    val lower_name = name.lower()

    var found = false
    var new_headers = []
    var i = 0
    while i < headers.length():
        val header = headers[i]
        val header_name = header[0]
        val header_value = header[1]

        val lower_header_name = header_name.lower()

        if lower_header_name == lower_name:
            new_headers.push((name, value))
            found = true
        else:
            new_headers.push(header)

        i = i + 1

    if not found:
        new_headers.push((name, value))

    return new_headers

# Remove header by name (case-insensitive)
fn remove_header(headers: list, name: text) -> list:
    val lower_name = name.lower()

    var new_headers = []
    var i = 0
    while i < headers.length():
        val header = headers[i]
        val header_name = header[0]

        val lower_header_name = header_name.lower()

        if lower_header_name != lower_name:
            new_headers.push(header)

        i = i + 1

    return new_headers

# Normalize header name to standard case
# Example: "content-type" -> "Content-Type"
fn normalize_header_name(name: text) -> text:
    val parts = name.split("-")
    var normalized_parts = []

    var i = 0
    while i < parts.length():
        val part = parts[i]
        val capitalized = capitalize_word(part)
        normalized_parts.push(capitalized)
        i = i + 1

    return "-".join(normalized_parts)

# Capitalize first letter of word
fn capitalize_word(word: text) -> text:
    if word.length() == 0:
        return word

    val first = word[0].upper()
    val rest = word.substring(1, word.length()).lower()

    return first + rest

# Get content length from headers
fn get_content_length(headers: list) -> i64:
    val length_str = get_header(headers, "Content-Length")

    if length_str == nil:
        return 0

    return common_parse_int(length_str)

# Check if response uses chunked encoding
fn is_chunked(headers: list) -> bool:
    val encoding = get_header(headers, "Transfer-Encoding")

    if encoding == nil:
        return false

    val lower = encoding.lower()
    return lower.contains("chunked")

# ============================================================================
# Chunked Transfer Encoding
# ============================================================================

# Encode data using chunked transfer encoding
fn encode_chunked(data: text) -> text:
    val length = data.length()

    var result = to_hex_text(length)
    result = result + "\r\n"
    result = result + data
    result = result + "\r\n"
    result = result + "0\r\n\r\n"

    return result

# Convert integer to hex text
fn to_hex_text(n: i64) -> text:
    if n == 0:
        return "0"

    var digits: [text] = []
    var num = n

    while num > 0:
        val digit = num % 16
        val hex_chars = "0123456789abcdef"
        val hex_char = hex_chars[digit]

        digits.push(hex_char)
        num = num / 16

    # Reverse digits
    var parts: [text] = []
    var i = digits.len() - 1
    while i >= 0:
        parts.push(digits[i])
        i = i - 1
    return parts.join("")

# Decode chunked transfer encoded data (RFC 7230 §4.1).
#
# Grammar: chunk = chunk-size [ chunk-ext ] CRLF chunk-data CRLF, with
# chunk-size = 1*HEXDIG and last-chunk = 1*("0") [ chunk-ext ] CRLF.
# A size line that is not 1*HEXDIG is a SYNTAX ERROR, not a zero-length chunk,
# so it must never be read as end-of-body. Returning a truncated body for
# invalid framing lets this recipient's view of the message boundary diverge
# from an upstream proxy's (request smuggling). Per RFC 7230 §3.3.3 and §3.4 an
# invalid or incomplete chunked body is unrecoverable and must be rejected, so
# every framing error is surfaced as Err for the caller to answer 400.
fn decode_chunked(encoded: text) -> Result<text, text>:
    var parts: [text] = []
    var pos = 0
    var saw_last_chunk = false

    while pos < encoded.length():
        # Find end of chunk size line
        val size_end = common_index_of(encoded, "\r\n", pos)

        if size_end < 0:
            return Err("chunk size line not terminated by CRLF")

        # chunk-ext is legal syntax; strip it before validating the size token
        var size_str = encoded.substring(pos, size_end)
        val semi = header_find_char(size_str, ";")
        if semi >= 0:
            size_str = size_str.substring(0, semi)

        if not header_is_hex_digits(size_str):
            return Err("invalid chunk size (RFC 7230 4.1: chunk-size = 1*HEXDIG)")

        if not header_hex_fits_i64(size_str):
            return Err("chunk size overflows i64 (RFC 7230 4.1)")

        val chunk_size = parse_hex_text(size_str)

        if chunk_size == 0:
            saw_last_chunk = true
            break

        # Extract chunk data
        val data_start = size_end + 2
        val data_end = data_start + chunk_size

        if data_end > encoded.length():
            return Err("chunk data runs past end of body")

        val chunk_data = encoded.substring(data_start, data_end)
        parts.push(chunk_data)

        # chunk-data is followed by CRLF; a mismatch means the declared size
        # disagrees with the actual framing.
        if data_end + 2 > encoded.length():
            return Err("chunk data not terminated by CRLF")
        if encoded.substring(data_end, data_end + 2) != "\r\n":
            return Err("chunk data not terminated by CRLF")

        # Move past chunk data and trailing \r\n
        pos = data_end + 2

    if not saw_last_chunk:
        return Err("chunked body ended without a last-chunk")

    Ok(parts.join(""))

# Boundary-aware chunked body-end detector (RFC 7230 §4.1).
#
# Walks chunk-size lines so a "0\r\n\r\n" byte sequence inside chunk DATA is
# never mistaken for the terminal 0-size chunk — a flat index_of scan truncates
# any body whose payload happens to contain those 5 bytes.
#
# Returns:
#   >= 0  body complete; offset one past the CRLF that ends the last-chunk's
#         (possibly empty) trailer section — i.e. the full encoded length
#   -1    incomplete; a partial buffer mid-chunk, need more data
#   -2    framing error (invalid chunk-size line or bad chunk-data terminator);
#         run decode_chunked on the buffer for the specific Err reason
fn chunked_body_end(buffer: text) -> i64:
    var pos = 0
    while true:
        val size_end = common_index_of(buffer, "\r\n", pos)
        if size_end < 0:
            # chunk-size line not fully received yet
            return -1
        var size_str = buffer.substring(pos, size_end)
        val semi = header_find_char(size_str, ";")
        if semi >= 0:
            size_str = size_str.substring(0, semi)
        if not header_is_hex_digits(size_str):
            return -2
        if not header_hex_fits_i64(size_str):
            return -2
        val chunk_size = parse_hex_text(size_str)
        if chunk_size == 0:
            # last-chunk: skip optional trailer section, ends at an empty line
            var p = size_end + 2
            while true:
                val line_end = common_index_of(buffer, "\r\n", p)
                if line_end < 0:
                    return -1
                if line_end == p:
                    return line_end + 2
                p = line_end + 2
        val data_end = size_end + 2 + chunk_size
        if data_end + 2 > buffer.length():
            return -1
        if buffer.substring(data_end, data_end + 2) != "\r\n":
            return -2
        pos = data_end + 2
    -2

# Index of `ch` in `s`, or -1. Scans by index because text.index_of on a
# substring()-derived receiver returns nil for a non-zero match position.
fn header_find_char(s: text, ch: text) -> i64:
    var i = 0
    while i < s.length():
        if s[i] == ch:
            return i
        i = i + 1
    return -1

# RFC 7230 §4.1 chunk-size = 1*HEXDIG, where HEXDIG is RFC 5234 §B.1.
# An empty token is not 1*HEXDIG and is therefore invalid.
fn header_is_hex_digits(s: text) -> bool:
    if s.length() == 0:
        return false
    val hexdig = "0123456789abcdefABCDEF"
    var i = 0
    while i < s.length():
        val ch = s[i]
        var found = false
        var j = 0
        while j < hexdig.length():
            if hexdig[j] == ch:
                found = true
            j = j + 1
        if not found:
            return false
        i = i + 1
    return true

# RFC 7230 §4.1: a chunk-size that does not fit the implementation's integer
# type MUST be rejected, never wrapped. parse_hex_text accumulates
# `result * 16 + digit` with no overflow check, so a 17-hex-digit size wraps
# modulo 2^64: "10000000000000000" (2^64) reads back as **0** and is accepted as
# the terminal last-chunk, and "10000000000000005" reads back as 5. A peer that
# rejects the overflow disagrees with us about where the message ends — that is
# an HTTP request-smuggling primitive on a server AND on the proxy.
#
# 15 hex digits (max 0xFFFFFFFFFFFFFFF ~= 1.15e18) is the widest token that
# cannot overflow i64, and is ~1 exabyte — far past any real chunk.
fn header_hex_fits_i64(s: text) -> bool:
    var i = 0
    while i < s.length():
        if s[i] != "0":
            break
        i = i + 1
    return s.length() - i <= 15

# Parse hex text to integer
fn parse_hex_text(hex: text) -> i64:
    var result = 0
    var i = 0

    while i < hex.length():
        val ch = hex[i]
        val digit = hex_to_int(ch)

        result = result * 16
        result = result + digit

        i = i + 1

    return result

# Convert hex digit to integer
fn hex_to_int(ch: text) -> i64:
    return common_hex_to_int(ch)

# ============================================================================
# Range Header Handling
# ============================================================================

# Parse Range header
# Returns: (start, end) or nil if invalid
# Example: "bytes=0-1023" -> (0, 1023)
fn parse_range_header(header: text) -> tuple?:
    if not header.starts_with("bytes="):
        return nil

    val range_spec = header.substring(6, header.length())
    val dash_pos = range_spec.index_of("-")

    if dash_pos < 0:
        return nil

    val start_str = range_spec.substring(0, dash_pos)
    val end_str = range_spec.substring(dash_pos + 1, range_spec.length())

    var start = 0
    if start_str.length() > 0:
        start = common_parse_int(start_str)

    var end = 0
    if end_str.length() > 0:
        end = common_parse_int(end_str)

    return (start, end)

# Build Range header value
fn build_range_header(start: i64, end: i64) -> text:
    var result = "bytes="
    result = result + start.to_text()
    result = result + "-"
    result = result + end.to_text()

    return result

# ============================================================================
# Multipart Form Data
# ============================================================================

# Parse multipart form data
# Returns: list of (headers, body) tuples
fn parse_multipart(body: text, boundary: text) -> list:
    var delimiter = "--"
    delimiter = delimiter + boundary

    val parts_raw = body.split(delimiter)
    var parts = []

    var i = 0
    while i < parts_raw.length():
        val part_raw = parts_raw[i]

        # Skip empty parts and final boundary
        if part_raw.length() > 2:
            val part = parse_multipart_part(part_raw)
            if part != nil:
                parts.push(part)

        i = i + 1

    return parts

# Parse single multipart part
fn parse_multipart_part(part_text: text) -> tuple?:
    val lines = part_text.split("\r\n")

    # Find empty line separating headers from body
    var header_end = 0
    var i = 0
    while i < lines.length():
        val line = lines[i]
        if line == "":
            header_end = i
            break
        i = i + 1

    if header_end == 0:
        return nil

    # Parse headers
    var header_lines = []
    var j = 0
    while j < header_end:
        header_lines.push(lines[j])
        j = j + 1

    val headers = parse_headers(header_lines)

    # Parse body
    var body_lines = []
    var k = header_end + 1
    while k < lines.length():
        body_lines.push(lines[k])
        k = k + 1

    val body = "\r\n".join(body_lines)

    return (headers, body)

# Build multipart form data
fn build_multipart(parts: list, boundary: text) -> text:
    var result_parts: [text] = []

    var i = 0
    while i < parts.length():
        val part = parts[i]
        val headers = part[0]
        val body = part[1]

        result_parts.push("--")
        result_parts.push(boundary)
        result_parts.push("\r\n")

        val headers_text = format_headers(headers)
        result_parts.push(headers_text)

        result_parts.push("\r\n")
        result_parts.push(body)
        result_parts.push("\r\n")

        i = i + 1

    result_parts.push("--")
    result_parts.push(boundary)
    result_parts.push("--\r\n")

    return result_parts.join("")

# Generate random boundary string
fn generate_boundary() -> text:
    # Simplified - in real implementation would use random data
    return "----SimpleFormBoundary7MA4YWxkTrZu0gW"

# ============================================================================
# Header Canonicalization
# ============================================================================

fn canonicalize_headers(headers: list) -> list:
    var result = []
    var i = 0
    while i < headers.length():
        val header = headers[i]
        val name = normalize_header_name(header[0])
        val value = header[1]
        result.push((name, value))
        i = i + 1
    return result

# ============================================================================
# Duplicate Header Policy
# ============================================================================

fn singleton_header_names() -> [text]:
    ["content-type", "content-length", "host", "authorization",
     "date", "etag", "location", "server", "user-agent",
     "content-encoding", "transfer-encoding", "connection"]

fn is_singleton_header(name: text) -> bool:
    val lower = name.lower()
    val singletons = singleton_header_names()
    var i = 0
    while i < singletons.len():
        if singletons[i] == lower:
            return true
        i = i + 1
    false

fn deduplicate_headers_last_wins(headers: list) -> list:
    var seen: [text] = []
    var result = []
    var i = headers.length() - 1
    while i >= 0:
        val header = headers[i]
        val lower_name = header[0].lower()
        if is_singleton_header(lower_name):
            var already_seen = false
            var s = 0
            while s < seen.len():
                if seen[s] == lower_name:
                    already_seen = true
                    break
                s = s + 1
            if not already_seen:
                result.push(header)
                seen = seen.push(lower_name)
        else:
            result.push(header)
        i = i - 1
    var reversed = []
    var r = result.length() - 1
    while r >= 0:
        reversed.push(result[r])
        r = r - 1
    return reversed

fn validate_no_duplicate_singletons(headers: list) -> Result<list, text>:
    var seen: [text] = []
    var i = 0
    while i < headers.length():
        val header = headers[i]
        val lower_name = header[0].lower()
        if is_singleton_header(lower_name):
            var s = 0
            while s < seen.len():
                if seen[s] == lower_name:
                    return Err("duplicate singleton header: " + lower_name)
                s = s + 1
            seen = seen.push(lower_name)
        i = i + 1
    Ok(headers)

