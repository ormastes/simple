# Spec Module - Testing Framework
#
# SPipe testing framework for behavior-driven development (BDD).
# Provides describe/it/expect syntax for readable tests.
#
# Features:
#   - BDD-style test organization (describe, context, it)
#   - Rich matchers (to_equal, to_be, to_contain, etc.)
#   - Hooks (before, after, before_each, after_each)
#   - Test isolation and cleanup
#   - Conditional test execution
#   - Feature documentation generation
#
# Public API:
#   - use std.spec.{describe, it, expect}
#   - use std.spec.{before, after, before_each, after_each}
#   - use std.spec.decorators.{skip_it, pending_it}
#   - use std.spec.condition.{when, unless}
#
# Example:
#   describe "Calculator":
#     it "adds numbers":
#       expect(2 + 2).to_equal(4)

# All submodules are automatically available.

# The file and package entrypoints delegate to the same stateful owner.
export use std.nogc_sync_mut.spec.{
    describe,
    context,
    it,
    test,
    example,
    specify,
    step,
    slow_it,
    skip_it,
    pending,
    skip,
    before_context,
    skip_context,
    is_windows,
    is_unix,
    is_macos,
    is_linux,
    skip_on_windows,
    skip_on_linux,
    skip_on_macos,
    skip_on_unix,
    only_on_windows,
    only_on_linux,
    only_on_macos,
    only_on_unix,
    skip_on_baremetal,
    only_on_baremetal,
    skip_on_remote,
    only_on_remote,
    only_on_arch,
    skip_on_arch,
    skip_on_interpreter,
    only_on_interpreter,
    skip_if_missing_module,
    before_each,
    after_each,
    prevent,
    prevent_at_most,
    prevent_file,
    expect,
    expect_not,
    ExpectHelper,
    fail_assertion,
    fail_test,
    fail,
    check,
    check_msg,
    assert_eq,
    assert_ne,
    assert_true,
    assert_false,
    assert_nil,
    assert_not_nil,
    assert_equal,
    assert_not_equal,
    assert_contains,
    print_summary,
    get_exit_code,
    get_test_count,
    get_executed_test_count,
    aggregate_registry_begin,
    aggregate_owner_begin,
    aggregate_registry_select_case,
    aggregate_owner_end,
    aggregate_registry_finish
}

