@allow(star_import) # reason: compatibility facade, re-exports backing family symbols
# Compatibility facade: std.nogc_async_mut.path -> std.nogc_sync_mut.path
# Was a byte-identical duplicate implementation (28 duplicate-named public fns);
# under co-compilation every duplicate-named public fn collides in the seed's
# bare-name symbol table (Class B silent-win misdispatch — see
# doc/08_tracking/bug/duplicate_public_symbols_differing_return_types_jit_misdispatch_2026-08-09.md).
export use std.nogc_sync_mut.path.*
