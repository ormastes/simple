# Logical endpoint-network identities for the emulated `endpoint-v1` profile
# (design: doc/05_design/simple_container_macos_seatbelt.md 11.1, 11.7).
# Pure values only: no sockets, no host routing, no interface addresses. A
# logical address is understood by the broker and participating clients; it
# is never assigned to a process network stack and never authenticates.
# Routes are keyed by network + endpoint identity + port + protocol +
# generation, never by address/port alone.
use std.common.contracts.container.runtime_v1.{RuntimeIdentityV1}

pub const ENDPOINT_PROTOCOL_TCP_V1 = "tcp"
pub const ENDPOINT_TOKEN_MAX_V1: i64 = 128

# tenant/namespace/name select the logical network; `generation` is the
# persistent network generation. A bumped generation invalidates every
# address, lease and session issued under an older one.
pub struct EndpointNetworkIdV1:
    tenant: text
    namespace: text
    name: text
    generation: i64

# Immutable workload/attempt identity bound by the broker at admission. It is
# projected from the container owner's RuntimeIdentityV1; a workload can never
# supply or change it in later frames.
pub struct EndpointPrincipalV1:
    network: EndpointNetworkIdV1
    pod_uid: text
    attempt: i64
    provider_generation: i64
    node_boot_id: text

# A virtual endpoint inside one logical network.
pub struct VirtualEndpointV1:
    network: EndpointNetworkIdV1
    address: i64
    port: i64
    protocol: text

# Attempt-bound registration of one service endpoint. `lease_generation` is
# registry-monotonic: a superseded or retired lease is never reactivated.
pub struct RouteLeaseV1:
    lease_id: text
    service_name: text
    endpoint: VirtualEndpointV1
    owner: EndpointPrincipalV1
    lease_generation: i64
    policy_revision: i64

# An authorized route under one committed policy revision. `revoke_mode` is
# `revoke-existing` or `new-connections-only` (design 11.11).
pub struct ResolvedRouteV1:
    source: EndpointPrincipalV1
    lease: RouteLeaseV1
    policy_revision: i64
    egress_rule_id: text
    ingress_rule_id: text
    revoke_mode: text

pub fn endpoint_token_valid_v1(value: text) -> bool:
    if value == "" or value.len() > ENDPOINT_TOKEN_MAX_V1:
        return false
    for ch in value.chars():
        if not ((ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
                (ch >= "0" and ch <= "9") or ch == "-" or ch == "_" or ch == "."):
            return false
    true

pub fn endpoint_network_id_v1(tenant: text, namespace: text, name: text,
        generation: i64) -> Result<EndpointNetworkIdV1, text>:
    val network = EndpointNetworkIdV1(tenant: tenant, namespace: namespace, name: name,
        generation: generation)
    val _ok = endpoint_network_validate_v1(network)?
    Ok(network)

# Public struct values may bypass the constructor; consumers revalidate.
pub fn endpoint_network_validate_v1(network: EndpointNetworkIdV1) -> Result<bool, text>:
    if not endpoint_token_valid_v1(network.tenant): return Err("endpoint-network-tenant-invalid")
    if not endpoint_token_valid_v1(network.namespace): return Err("endpoint-network-namespace-invalid")
    if not endpoint_token_valid_v1(network.name): return Err("endpoint-network-name-invalid")
    if network.generation < 1: return Err("endpoint-network-generation-invalid")
    Ok(true)

# Generation-free network scope ("tenant/namespace/name"); tokens forbid "/".
pub fn endpoint_network_scope_v1(network: EndpointNetworkIdV1) -> text:
    network.tenant + "/" + network.namespace + "/" + network.name

# Full network key including generation.
pub fn endpoint_network_key_v1(network: EndpointNetworkIdV1) -> text:
    endpoint_network_scope_v1(network) + "#" + network.generation.to_text()

pub fn endpoint_network_same_v1(a: EndpointNetworkIdV1, b: EndpointNetworkIdV1) -> bool:
    endpoint_network_key_v1(a) == endpoint_network_key_v1(b)

pub fn endpoint_principal_from_runtime_v1(network: EndpointNetworkIdV1,
        runtime: RuntimeIdentityV1) -> Result<EndpointPrincipalV1, text>:
    val principal = EndpointPrincipalV1(network: network, pod_uid: runtime.pod_uid,
        attempt: runtime.attempt, provider_generation: runtime.provider_generation,
        node_boot_id: runtime.node_boot_id)
    val _ok = endpoint_principal_validate_v1(principal)?
    Ok(principal)

pub fn endpoint_principal_validate_v1(principal: EndpointPrincipalV1) -> Result<bool, text>:
    val _network = endpoint_network_validate_v1(principal.network)?
    if not endpoint_token_valid_v1(principal.pod_uid): return Err("endpoint-principal-pod-invalid")
    if principal.attempt < 1: return Err("endpoint-principal-attempt-invalid")
    if principal.provider_generation < 1: return Err("endpoint-principal-provider-generation-invalid")
    if not endpoint_token_valid_v1(principal.node_boot_id): return Err("endpoint-principal-boot-invalid")
    Ok(true)

pub fn endpoint_principal_key_v1(principal: EndpointPrincipalV1) -> text:
    endpoint_network_key_v1(principal.network) + "|" + principal.pod_uid + "|" +
        principal.attempt.to_text() + "|" + principal.provider_generation.to_text() + "|" +
        principal.node_boot_id

# True when `candidate` is a strictly newer incarnation of the same workload.
pub fn endpoint_principal_newer_v1(candidate: EndpointPrincipalV1, current: EndpointPrincipalV1) -> bool:
    if candidate.pod_uid != current.pod_uid: return false
    if candidate.attempt != current.attempt: return candidate.attempt > current.attempt
    candidate.provider_generation > current.provider_generation

pub fn endpoint_port_valid_v1(port: i64) -> bool:
    port >= 1 and port <= 65535

# V1 carries reliable streams only; UDP is a later, separately qualified phase.
pub fn endpoint_protocol_valid_v1(protocol: text) -> Result<bool, text>:
    if protocol == ENDPOINT_PROTOCOL_TCP_V1: return Ok(true)
    if protocol == "udp": return Err("endpoint-protocol-udp-unqualified")
    Err("endpoint-protocol-unsupported")

pub fn virtual_endpoint_v1(network: EndpointNetworkIdV1, address: i64, port: i64,
        protocol: text) -> Result<VirtualEndpointV1, text>:
    val _network = endpoint_network_validate_v1(network)?
    if address < 0 or address > 4294967295: return Err("endpoint-address-invalid")
    if not endpoint_port_valid_v1(port): return Err("endpoint-port-invalid")
    val _protocol = endpoint_protocol_valid_v1(protocol)?
    Ok(VirtualEndpointV1(network: network, address: address, port: port, protocol: protocol))

pub fn virtual_endpoint_key_v1(endpoint: VirtualEndpointV1) -> text:
    endpoint_network_key_v1(endpoint.network) + "|" + endpoint.address.to_text() + "|" +
        endpoint.port.to_text() + "|" + endpoint.protocol

# Canonical dotted-quad rendering of a logical IPv4-shaped address.
pub fn endpoint_logical_address_text_v1(address: i64) -> text:
    ((address >> 24) & 255).to_text() + "." + ((address >> 16) & 255).to_text() + "." +
        ((address >> 8) & 255).to_text() + "." + (address & 255).to_text()

# Strict canonical dotted decimal: four parts, 0..255, no leading zeros, no
# octal/hex/integer encodings (they must not alias a different address).
pub fn endpoint_logical_address_parse_v1(value: text) -> Result<i64, text>:
    val parts = value.split(".")
    if parts.len() != 4: return Err("endpoint-address-noncanonical")
    var result: i64 = 0
    for part in parts:
        if part == "" or part.len() > 3: return Err("endpoint-address-noncanonical")
        if part.len() > 1 and part.starts_with("0"): return Err("endpoint-address-noncanonical")
        var octet: i64 = 0
        for ch in part.chars():
            if ch < "0" or ch > "9": return Err("endpoint-address-noncanonical")
            octet = octet * 10 + (ch.char_code_at(0) - 48)
        if octet > 255: return Err("endpoint-address-noncanonical")
        result = (result << 8) | octet
    Ok(result)

export EndpointNetworkIdV1, EndpointPrincipalV1, VirtualEndpointV1, RouteLeaseV1, ResolvedRouteV1
export ENDPOINT_PROTOCOL_TCP_V1, ENDPOINT_TOKEN_MAX_V1
export endpoint_token_valid_v1, endpoint_network_id_v1, endpoint_network_validate_v1
export endpoint_network_scope_v1, endpoint_network_key_v1, endpoint_network_same_v1
export endpoint_principal_from_runtime_v1, endpoint_principal_validate_v1
export endpoint_principal_key_v1, endpoint_principal_newer_v1
export endpoint_port_valid_v1, endpoint_protocol_valid_v1, virtual_endpoint_v1, virtual_endpoint_key_v1
export endpoint_logical_address_text_v1, endpoint_logical_address_parse_v1
