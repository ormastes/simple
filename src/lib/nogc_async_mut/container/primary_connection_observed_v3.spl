# Planning consumes only the actual adapter's one-use inspection completion.
# No boolean, decoded observation or raw runtime record installs that marker.
use std.nogc_async_mut.container.api_v2.{SimpleContainerOwnerV2, simple_container_project_v2}
use std.nogc_async_mut.container.primary_connection_v2.ContainerPrimaryConnectionPlanTurnV2
use std.common.contracts.container.execution_v2.ContainerExecutionRequestV2
use std.common.contracts.container.runtime_v1.RuntimeIdentityV1
use std.common.contracts.container.stream_v2.{ContainerOutputIdentityV2, ContainerOutputResourcesV2}

pub fn simple_container_primary_connection_plan_observed_v3(owner: SimpleContainerOwnerV2,
        request: ContainerExecutionRequestV2, expected: RuntimeIdentityV1,
        identity: ContainerOutputIdentityV2, resources: ContainerOutputResourcesV2,
        installation_digest: text, journal_lease_digest: text, terminal_mode: text, timeout_ms: i64) -> ContainerPrimaryConnectionPlanTurnV2:
    val projected = simple_container_project_v2(owner, request)
    if projected.is_err(): return ContainerPrimaryConnectionPlanTurnV2(owner, nil, projected.unwrap_err())
    match owner:
        case SimpleContainerOwnerV2.Windows(scope, original):
            var adapter = original
            val plan = adapter.primary_connection_plan_observed_v3(request, expected, identity, resources,
                installation_digest, journal_lease_digest, terminal_mode, timeout_ms)
            val retained = SimpleContainerOwnerV2.Windows(scope, adapter)
            match plan:
                case Ok(value): ContainerPrimaryConnectionPlanTurnV2(retained, Some(value), "")
                case Err(error): ContainerPrimaryConnectionPlanTurnV2(retained, nil, error)
        case _: ContainerPrimaryConnectionPlanTurnV2(owner, nil, "container-direct-connection-provider-unsupported")
