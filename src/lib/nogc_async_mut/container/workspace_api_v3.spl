                pending: false, error: "container-workspace-linux-required")

pub struct ContainerWorkspacePrimaryObserveTurnV3:
    owner: SimpleContainerOwnerV2
    observation: Option<ContainerWorkspacePrimaryObservationV3>
    pending: bool
    error: text

pub fn simple_container_workspace_primary_observe_v3(owner: SimpleContainerOwnerV2,
        request: ContainerExecutionRequestV2) -> ContainerWorkspacePrimaryObserveTurnV3:
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val observed = adapter.workspace_primary_observe_v3(request)
            val retained = SimpleContainerOwnerV2.Linux(scope, observed.owner)
            ContainerWorkspacePrimaryObserveTurnV3(owner: retained,
                observation: observed.observation, pending: observed.pending, error: observed.error)
        case SimpleContainerOwnerV2.Windows(_, _):
            ContainerWorkspacePrimaryObserveTurnV3(owner: owner, observation: None,
                pending: false, error: "container-workspace-linux-required")

pub struct ContainerPrimaryTransportReturnTurnV3:
    owner: SimpleContainerOwnerV2
    error: text
    retirement: Option<ContainerPrimaryTransportRetirementV3> = nil

pub fn simple_container_primary_session_return_v3(owner: SimpleContainerOwnerV2,
        session: ContainerPrimaryAttachSessionV1) -> ContainerPrimaryTransportReturnTurnV3:
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val returned = adapter.primary_session_return_v3(session)
            var retained = ContainerPrimaryTransportReturnTurnV3(
                owner: SimpleContainerOwnerV2.Linux(scope, adapter), error: "")
            # Positive native consumption is captured even if later accounting
            # publication failed. It authorizes no Host/pane/source release.
            val native = adapter.primary_retirement_v3()
            if native.is_ok(): retained.retirement = Some(native.unwrap())
            retained.error = match returned:
                case Ok(_): ""
                case Err(reason): reason
            retained
        case SimpleContainerOwnerV2.Windows(_, _):
            ContainerPrimaryTransportReturnTurnV3(owner: owner,
                error: "container-primary-transport-linux-required")

pub fn simple_container_primary_attach_cleanup_v3(owner: SimpleContainerOwnerV2) -> ContainerPrimaryTransportReturnTurnV3:
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val cleaned = adapter.primary_attach_cleanup_v3()
            var retained = ContainerPrimaryTransportReturnTurnV3(
                owner: SimpleContainerOwnerV2.Linux(scope, adapter), error: "")
            # Positive native consumption is captured even if later accounting
            # publication failed. It authorizes no Host/pane/source release.
            val native = adapter.primary_retirement_v3()
            if native.is_ok(): retained.retirement = Some(native.unwrap())
            retained.error = match cleaned:
                case Ok(_): ""
                case Err(reason): reason
            retained
        case SimpleContainerOwnerV2.Windows(_, _):
            ContainerPrimaryTransportReturnTurnV3(owner: owner,
                error: "container-primary-transport-linux-required")

pub struct ContainerWorkspaceSourceCleanupTurnV3:
    owner: SimpleContainerOwnerV2
    source_returned: bool
    pending: bool
    error: text

pub fn simple_container_workspace_source_cleanup_v3(owner: SimpleContainerOwnerV2) -> ContainerWorkspaceSourceCleanupTurnV3:
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val closed = adapter.cleanup_workspace_source_v3()
            val retained = SimpleContainerOwnerV2.Linux(scope, closed.owner)
            ContainerWorkspaceSourceCleanupTurnV3(retained, closed.source_returned, closed.pending, closed.error)
        case SimpleContainerOwnerV2.Windows(_, _):
            ContainerWorkspaceSourceCleanupTurnV3(owner, false, false, "container-workspace-linux-required")

pub use std.nogc_async_mut.container.workspace_primary_retirement_v3.{ContainerPrimarySessionBindingV3,
    MachineWorkspacePrimarySessionBindingDataV3}

pub struct ContainerPrimarySessionBindingTurnV3:
    owner: SimpleContainerOwnerV2
    binding: Option<ContainerPrimarySessionBindingV3>
    error: text

pub fn simple_container_primary_session_binding_v3(owner: SimpleContainerOwnerV2,
        session: ContainerPrimaryAttachSessionV1) -> ContainerPrimarySessionBindingTurnV3:
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val actual = adapter.primary_session_binding_v3(session)
            val retained = SimpleContainerOwnerV2.Linux(scope, adapter)
            match actual:
                case Ok(binding): ContainerPrimarySessionBindingTurnV3(retained, Some(binding), "")
                case Err(reason): ContainerPrimarySessionBindingTurnV3(retained, None, reason)
        case SimpleContainerOwnerV2.Windows(_, _):
            ContainerPrimarySessionBindingTurnV3(owner, None, "container-primary-workspace-owner-required")
