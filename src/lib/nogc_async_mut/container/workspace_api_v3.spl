pub use std.nogc_async_mut.container.workspace_primary_retirement_v3.{ContainerPrimaryTransportRetirementV3, MachineWorkspacePrimaryRetirementDataV3}
# Common forwarding API for the installed workspace source lane. Returned
# turns retain the updated tagged owner; no caller receives raw reader/storage.
use std.nogc_async_mut.container.api_v2.SimpleContainerOwnerV2
use std.common.contracts.container.execution_v2.ContainerExecutionRequestV2
pub use std.nogc_async_mut.container.providers.linux.workspace_source_loan_v3.LinuxWorkspaceSourceLoanV3
use std.common.contracts.container.workspace_action_v3.ContainerWorkspaceActionV3
use std.common.contracts.container.effect_deadline_v1.ContainerEffectDeadlineV1
use std.common.contracts.container.runtime_v1.{RuntimeOperationV1}
pub use std.nogc_async_mut.container.providers.linux.fresh_epoch_workload_v2.ContainerWorkspacePrimaryObservationV3
use std.nogc_async_mut.container.terminal_session_v1.ContainerPrimaryAttachSessionV1

pub struct ContainerWorkspaceSourceTurnV3:
    owner: SimpleContainerOwnerV2
    source: Option<LinuxWorkspaceSourceLoanV3>
    pending: bool
    error: text

pub struct ContainerWorkspaceEnableTurnV3:
    owner: SimpleContainerOwnerV2
    error: text

pub fn simple_container_workspace_source_open_installed_v3(owner: SimpleContainerOwnerV2,
        request: ContainerExecutionRequestV2) -> ContainerWorkspaceSourceTurnV3:
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val opened = adapter.workspace_source_open_installed_v3(request)
            # Retain the exact adapter state before forwarding any result flags.
            val retained = SimpleContainerOwnerV2.Linux(scope, opened.owner)
            ContainerWorkspaceSourceTurnV3(owner: retained, source: opened.source,
                pending: opened.pending, error: opened.error)
        case SimpleContainerOwnerV2.Windows(_, _):
            ContainerWorkspaceSourceTurnV3(owner: owner, source: None,
                pending: false, error: "container-workspace-linux-required")

pub fn simple_container_enable_workspace_v3(owner: SimpleContainerOwnerV2,
        request: ContainerExecutionRequestV2, manifest_bytes: text, invocation_digest: text,
        full_invocation_source: text) -> ContainerWorkspaceEnableTurnV3:
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val enabled = adapter.enable_workspace_v3(request, manifest_bytes,
                invocation_digest, full_invocation_source)
            # The adapter can hold real cleanup progress on error.
            val retained = SimpleContainerOwnerV2.Linux(scope, enabled.owner)
            ContainerWorkspaceEnableTurnV3(owner: retained, error: enabled.error)
        case SimpleContainerOwnerV2.Windows(_, _):
            ContainerWorkspaceEnableTurnV3(owner: owner, error: "container-workspace-linux-required")

pub struct ContainerWorkspaceActionTurnV3:
    owner: SimpleContainerOwnerV2
    operation: Option<RuntimeOperationV1>
    pending: bool
    error: text

pub fn simple_container_workspace_begin_v3(owner: SimpleContainerOwnerV2,
        action: ContainerWorkspaceActionV3, request: ContainerExecutionRequestV2,
        deadline: Option<ContainerEffectDeadlineV1> = nil) -> ContainerWorkspaceActionTurnV3:
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val begun = adapter.workspace_begin_v3(action, request, deadline)
            val retained = SimpleContainerOwnerV2.Linux(scope, begun.owner)
            ContainerWorkspaceActionTurnV3(owner: retained, operation: begun.operation,
                pending: begun.pending, error: begun.error)
        case SimpleContainerOwnerV2.Windows(_, _):
            ContainerWorkspaceActionTurnV3(owner: owner, operation: None,
                pending: false, error: "container-workspace-linux-required")

