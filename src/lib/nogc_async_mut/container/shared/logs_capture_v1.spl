# Internal actual-capture turn. An empty/refused turn never means absence.
use std.common.contracts.container.runtime_v1.{RuntimeIdentityV1, runtime_state_empty}
use std.nogc_sync_mut.io.process_capture_evidence_v1.ProcessCaptureTurnV1

pub struct ContainerRuntimeLogsCaptureTurnV1:
    runtime: RuntimeIdentityV1
    capture: ProcessCaptureTurnV1

pub fn container_runtime_logs_capture_refused_v1(reason: text) -> ContainerRuntimeLogsCaptureTurnV1:
    ContainerRuntimeLogsCaptureTurnV1(runtime: runtime_state_empty().identity,
        capture: ProcessCaptureTurnV1(owner: nil, evidence: nil, error: reason))
