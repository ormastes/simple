# Shared canonical digest-body fragments for provider request identity.
# Each scalar is hashed separately and every vector carries an explicit count,
# so arbitrary argument text cannot alias another payload. The surrounding
# version/kind header and field set remain owned by each backend digest.
# Extracted from identical copies in the Windows Docker and Linux OCI request
# digests (design §16.5.6); output bytes are unchanged.
use std.common.crypto.sha256.sha256_text

# One `    - "<sha256>"` line per value.
pub fn container_digest_lines_v1(values: [text]) -> text:
    var body = ""
    for value in values: body = body + "    - \"" + sha256_text(value) + "\"\n"
    body

# `<count_key>: <n>` then `<list_key>:` then one hashed line per value.
pub fn container_digest_vector_v1(count_key: text, list_key: text, values: [text]) -> text:
    count_key + ": " + values.len().to_text() + "\n" + list_key + ":\n" + container_digest_lines_v1(values)

# Exact ordered argv equality used when matching a recorded effect command.
pub fn container_args_equal_v1(left: [text], right: [text]) -> bool:
    if left.len() != right.len(): return false
    var index = 0
    while index < left.len():
        if left[index] != right[index]: return false
        index = index + 1
    true
