# Common primary attachment entrypoint. Helper admission opens a charged
# transport; live Input and Geometry permissions remain separate.
use std.common.contracts.container.execution_v2.ContainerExecutionRequestV2
use std.common.contracts.container.runtime_v1.RuntimeIdentityV1
use std.common.contracts.container.stream_v2.{ContainerOutputIdentityV2, ContainerOutputResourcesV2,
    ContainerStreamPolicyV2, ContainerHelperAdmissionV2}
use std.common.contracts.container.primary_attach_v1.ContainerPrimaryAttachPlanV1
use std.nogc_async_mut.container.api_v2.{SimpleContainerOwnerV2, simple_container_project_v2}
use std.nogc_async_mut.container.terminal_session_v1.{ContainerPrimaryAttachSessionV1,
    container_primary_attach_session_v1}
use std.nogc_sync_mut.io.process_ops.{PipedProcessOwnedSpawnV2, PipedProcessOwnedTransferV2}

pub struct ContainerPrimaryAttachTurnV1:
    owner: SimpleContainerOwnerV2
    session: ContainerPrimaryAttachSessionV1?
    cleanup_spawn: PipedProcessOwnedSpawnV2?
    error: text

pub struct ContainerPrimaryAttachPlanTurnV1:
    owner: SimpleContainerOwnerV2
    plan: ContainerPrimaryAttachPlanV1?
    error: text

# A plan is integrity metadata for the distinct primary archive domain. It
# cannot authorize a helper launch or grant ongoing terminal control.
pub fn simple_container_primary_attach_plan_v1(owner: SimpleContainerOwnerV2,
        request: ContainerExecutionRequestV2, expected: RuntimeIdentityV1,
        identity: ContainerOutputIdentityV2, policy: ContainerStreamPolicyV2,
        resources: ContainerOutputResourcesV2, terminal_mode: text) -> ContainerPrimaryAttachPlanTurnV1:
    match simple_container_project_v2(owner, request):
        case Err(reason): return ContainerPrimaryAttachPlanTurnV1(owner, nil, reason)
        case Ok(_): pass
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            var retained = adapter
            val planned = retained.primary_attach_plan_v1(request, expected, identity, policy, resources, terminal_mode)
            val updated = SimpleContainerOwnerV2.Linux(scope, retained)
            match planned:
                case Ok(plan): ContainerPrimaryAttachPlanTurnV1(updated, Some(plan), "")
                case Err(reason): ContainerPrimaryAttachPlanTurnV1(updated, nil, reason)
        case SimpleContainerOwnerV2.Windows(_, _):
            ContainerPrimaryAttachPlanTurnV1(owner, nil, "container-primary-attach-windows-session-unavailable")

# Keep the actual provider and every acquired cleanup owner in the returned
# turn. A successful session means the controlled native transport is owned;
# it does not prove attach success, workload completion, or control permission.
pub fn simple_container_open_primary_attach_v1(owner: SimpleContainerOwnerV2,
        request: ContainerExecutionRequestV2, expected: RuntimeIdentityV1,
        plan: ContainerPrimaryAttachPlanV1, helper: ContainerHelperAdmissionV2,
        policy: ContainerStreamPolicyV2) -> ContainerPrimaryAttachTurnV1:
    match simple_container_project_v2(owner, request):
        case Err(reason): return ContainerPrimaryAttachTurnV1(owner, nil, nil, reason)
        case Ok(_): pass
    var retained_owner = owner
    val spawned = match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            var retained = adapter
            val result = retained.open_primary_attach_v1(request, expected, plan, helper, policy)
            retained_owner = SimpleContainerOwnerV2.Linux(scope, retained)
            result
        case SimpleContainerOwnerV2.Windows(_, _):
            return ContainerPrimaryAttachTurnV1(owner, nil, nil,
                "container-primary-attach-windows-session-unavailable")
    match spawned:
        case PipedProcessOwnedSpawnV2.Rejected(reason):
            ContainerPrimaryAttachTurnV1(retained_owner, nil, nil, reason)
        case PipedProcessOwnedSpawnV2.CleanupRequired(native, reference, reason):
            ContainerPrimaryAttachTurnV1(retained_owner, nil,
                Some(PipedProcessOwnedSpawnV2.CleanupRequired(native, reference, reason)), reason)
        case PipedProcessOwnedSpawnV2.Ready(native, reference):
            val opened = container_primary_attach_session_v1(plan, helper,
                PipedProcessOwnedTransferV2(owner: native, reference: reference))
            match opened.cleanup_transfer:
                case Some(cleanup):
                    return ContainerPrimaryAttachTurnV1(retained_owner, nil,
                        Some(PipedProcessOwnedSpawnV2.CleanupRequired(cleanup.owner,
                            Some(cleanup.reference), opened.error)), opened.error)
                case None: pass
            match opened.session:
                case Some(session): ContainerPrimaryAttachTurnV1(retained_owner, Some(session), nil, opened.error)
                case None:
                    val reason = "container-primary-attach-session-owner-unconfirmed:{opened.error}"
                    ContainerPrimaryAttachTurnV1(retained_owner, nil,
                        Some(PipedProcessOwnedSpawnV2.CleanupRequired(native, Some(reference), reason)), reason)
