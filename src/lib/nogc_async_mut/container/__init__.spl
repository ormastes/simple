# milestone_0021 V4 agent API (DESIGN 3.3): the lent factory and the transfer-chain forwards. The agent owner
# (nogc_sync_mut/orchestration/host_linux_service_agent_v4.spl) reaches them only through this module; the
# provider types it must hold (the post-transfer fresh owner, the workspace-root borrow) and the request codec
# its pure probe-request builder uses are re-exported here, not imported from container.providers.
export use std.nogc_async_mut.container.api_v2.{SimpleContainerCloseV2, SimpleContainerLentOpenV4,
    SimpleContainerAgentTurnV3, simple_container_open_lent_v4, simple_container_take_workspace_root_v3,
    simple_container_end_workspace_root_loan_v3, simple_container_end_service_loan_v3,
    simple_container_adopt_lent_workspace_reader_v3, simple_container_advance_workload_v3,
    simple_container_set_lifecycle_root_v3, simple_container_epoch_current_v3, simple_container_helper_dirs_v3,
    simple_container_validate_helper_template_v3, simple_container_settle_workspace_v3,
    simple_container_released_charge_digest_v3,
    simple_container_return_settled_workspace_source_v3, simple_container_close_workload_v3,
    simple_container_close_epoch_v3}
export use std.nogc_async_mut.container.providers.linux.fresh_epoch_workload_v2.{LinuxFreshWorkloadOwnerV2,
    LinuxFreshAgentTurnV3, LinuxFreshWorkloadCloseTurnV2}
export use std.nogc_async_mut.container.providers.linux.workspace_root_borrow_v3.LinuxWorkspaceRootBorrowV3
export use std.nogc_async_mut.container.providers.linux.request_v1.{LinuxOciRequestV1, linux_oci_request_digest_v1}
export use std.nogc_async_mut.container.providers.linux.request_codec_v1.{linux_oci_retained_request_encode_v1,
    linux_oci_retained_request_decode_v1}
