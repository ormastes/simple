# std.container — the ONE public Simple Container entry point.
#
# Applications, CI, build/test runners, Caret, smux and orchestrators import
# this module, never `container.providers.**` (enforced by
# scripts/check/check-container-provider-imports.shs). It re-exports the
# existing SimpleContainerOwnerV2 facade from api_v2.spl; there is no second
# facade, owner or state machine here. Provider adapters stay internal.
#
# Interoperability submodules:
#   std.container.oci     — pure OCI image/manifest/bundle codec + projection
#   std.container.policy  — portable capability/qualification contracts
# Design: doc/05_design/simple_container_macos_seatbelt.md §16.5.2.

export use std.nogc_async_mut.container.api_v2.{SimpleContainerOwnerV2,
    ContainerOperationTurnV2, ContainerAbsenceTurnV2, ContainerExecutionUserTurnV2,
    simple_container_observation_v2, simple_container_scope_v2, simple_container_backend_v2,
    simple_container_observe_v2, simple_container_open_v2, simple_container_project_v2,
    simple_container_action_project_v2, simple_container_read_v2, simple_container_apply_v2,
    simple_container_control_v2, simple_container_intent_v2, simple_container_recover_v2,
    simple_container_absence_v2, simple_container_execution_user_v2}
