# Endpoint projection through the single provider owner API. No route, runtime
# socket, private host keystore mount or credential injection is authorized.
use std.nogc_async_mut.container.api_v2.{SimpleContainerOwnerV2, simple_container_backend_v2}
use std.common.config_core.server_context_types_v1.{ServerConfigV1, ResolvedServerV1}
use std.common.config_core.server_context_resolve_v1.resolve_server_context_v1

pub struct ContainerServerDiscoveryV1:
    backend: text
    selection: ResolvedServerV1

pub fn simple_container_server_v1(owner: SimpleContainerOwnerV2, config: ServerConfigV1,
        consumer: text, explicit_server: text, explicit_context: text) -> Result<ContainerServerDiscoveryV1, text>:
    val backend = simple_container_backend_v2(owner)
    if backend != "linux-podman" and backend != "windows-docker-process":
        return Err("container-server-backend-unsupported")
    val selected = resolve_server_context_v1(config, consumer, explicit_server, explicit_context, true)?
    Ok(ContainerServerDiscoveryV1(backend: backend, selection: selected))
