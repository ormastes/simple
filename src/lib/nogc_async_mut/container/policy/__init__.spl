# std.container.policy — portable container capability and qualification
# contracts, re-exported from their single owners under
# std.common.contracts.container. No policy logic lives here.
#
# The Seatbelt-era filesystem/endpoint/sandbox-capability policy contracts
# (design §7, work item C2) are added to this export list when they land;
# until then this route exposes only the contracts that already exist.

export use std.common.contracts.container.host_capability_v1.{ContainerHostCapabilityV1,
    ContainerHostRequirementV1, container_host_admission_reason_v1,
    CONTAINER_CLIENT_PRIVILEGE_USER_V1, CONTAINER_CLIENT_PRIVILEGE_DELEGATED_V1,
    CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1, CONTAINER_ISOLATION_NATIVE_V1,
    CONTAINER_ISOLATION_NATIVE_SANDBOX_V1, CONTAINER_ISOLATION_VM_V1}
export use std.common.contracts.container.host_capability_sdn_v1.{CONTAINER_HOST_CAPABILITY_SDN_SCHEMA_V1,
    format_container_host_capability_sdn_v1, parse_container_host_capability_sdn_v1}
export use std.common.contracts.container.kernel_qualification_v1.{ContainerKernelQualificationProfileV1,
    container_kernel_qualification_profile_encode_v1, container_kernel_qualification_profile_decode_v1,
    container_kernel_qualification_profile_digest_v1}
