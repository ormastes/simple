# Common owner-preserving forwarding for the closed original-owner probe port.
use std.nogc_async_mut.container.api_v2.SimpleContainerOwnerV2
use std.common.contracts.container.execution_v2.ContainerExecutionRequestV2
use std.nogc_sync_mut.container.machine_fresh_probe_owner_v3.{MachineFreshProbeCallV3,
    MachineFreshProbeReplyV3, machine_fresh_probe_rejected_v3}

pub struct ContainerExecutionProbeTurnV3:
    owner: SimpleContainerOwnerV2
    result: MachineFreshProbeReplyV3

pub fn simple_container_probe_v3(owner: SimpleContainerOwnerV2,
        request: ContainerExecutionRequestV2, call: MachineFreshProbeCallV3) -> ContainerExecutionProbeTurnV3:
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val result = adapter.probe_v3(request, call)
            # Rebuild the same tag around the exact adapter after it forwarded
            # to the retained Fresh owner, before returning the reply.
            val retained = SimpleContainerOwnerV2.Linux(scope, adapter)
            ContainerExecutionProbeTurnV3(owner: retained, result: result)
        case SimpleContainerOwnerV2.Windows(_, _):
            ContainerExecutionProbeTurnV3(owner: owner,
                result: machine_fresh_probe_rejected_v3(call, "machine-probe-linux-required"))
