# Live terminal proofs remain opaque. Metadata decoding never constructs one.
use std.common.contracts.container.primary_connection_consumption_v2.ContainerPrimaryConnectionConsumptionV2
use std.nogc_sync_mut.io.windows_primary_connection_admission_v2.WindowsPrimaryConnectionAbandonmentV3
use std.nogc_async_mut.container.providers.windows.docker_engine_exchange_v3.WindowsPrimaryConnectionAttemptTerminalV3

pub enum ContainerPrimaryConnectionAttemptTerminalV3:
    Abandoned(proof: WindowsPrimaryConnectionAbandonmentV3)
    Attempt(proof: WindowsPrimaryConnectionAttemptTerminalV3)

pub fn container_primary_connection_attempt_bytes_v3(proof: ContainerPrimaryConnectionAttemptTerminalV3,
        record: ContainerPrimaryConnectionConsumptionV2) -> Result<text, text>:
    match proof:
        case ContainerPrimaryConnectionAttemptTerminalV3.Abandoned(value): value.bytes_v3(record)
        case ContainerPrimaryConnectionAttemptTerminalV3.Attempt(value): value.bytes_v3(record)
