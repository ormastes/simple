# 3.7 step 4: the amended transfer close_v2 (authority, R2, never-adopted R3, custody, phase closed). The root
# must already be taken and its loan ended (step 2), and the service loan ended (step 3); close_v2 refuses otherwise.
pub fn simple_container_close_epoch_v3(owner: SimpleContainerOwnerV2) -> SimpleContainerCloseV2:
    simple_container_close_v2(owner)

pub fn simple_container_close_v2(owner: SimpleContainerOwnerV2) -> SimpleContainerCloseV2:
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val closed = adapter.close_fresh_v2()
            val pending = if closed.owner.is_some(): Some(SimpleContainerOwnerV2.Linux(scope, closed.owner.unwrap())) else: nil
            SimpleContainerCloseV2(pending, closed.closed, closed.error)
        case SimpleContainerOwnerV2.Windows(_, _): SimpleContainerCloseV2(Some(owner), false, "container-api-lifecycle-retained")

pub fn simple_container_fresh_cleanup_v2(original: SimpleContainerFreshOpenV2) -> SimpleContainerFreshCleanupV2:
    var retained = original
    if val owner = retained.owner:
        val closed = simple_container_close_v2(owner)
        retained.owner = closed.owner
        if retained.error == "" and closed.error != "": retained.error = closed.error
        if not closed.closed or closed.owner.is_some(): return SimpleContainerFreshCleanupV2(Some(retained), false, retained.error)
    if val fresh = retained.fresh_cleanup:
        val closed = fresh.close_v2()
        retained.fresh_cleanup = closed.owner
        if retained.error == "" and closed.error != "": retained.error = closed.error
        if not closed.closed or closed.owner.is_some(): return SimpleContainerFreshCleanupV2(Some(retained), false, retained.error)
    if val admission = retained.admission_cleanup:
        val closed = machine_fresh_epoch_admission_turn_close_v1(admission)
        retained.admission_cleanup = closed.retained
        if retained.error == "" and closed.error != "": retained.error = closed.error
        if not closed.closed or closed.retained.is_some(): return SimpleContainerFreshCleanupV2(Some(retained), false, retained.error)
    SimpleContainerFreshCleanupV2(nil, true, retained.error)

pub struct ContainerOperationTurnV2:
    owner: SimpleContainerOwnerV2
    operation: RuntimeOperationV1

pub struct ContainerExecutionStatsTurnV1:
    owner: SimpleContainerOwnerV2
    observation: Option<ContainerExecutionStatsObservationV1>
    error: text

# Typed observations only. No spawn/action/WAL path and no unsupported fallback.
pub fn simple_container_stats_observe_v1(owner: SimpleContainerOwnerV2,
        original_request: ContainerExecutionRequestV2) -> ContainerExecutionStatsTurnV1:
    match owner:
        case SimpleContainerOwnerV2.Windows(_, _):
            return ContainerExecutionStatsTurnV1(owner: owner, observation: None,
                error: "optional-capability-unavailable:stats:windows-docker")
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val started = time_sample_monotonic_nanos_or_failure()
            if started <= 0: return ContainerExecutionStatsTurnV1(owner, None, "container-stats-monotonic-clock")
            val checked = container_api_request_scope_v2("linux-podman", scope, original_request)
            if checked.is_err(): return ContainerExecutionStatsTurnV1(owner, None, checked.unwrap_err())
            val result = adapter.stats_v1(original_request)
            val retained = SimpleContainerOwnerV2.Linux(scope, adapter)
            if result.is_err(): return ContainerExecutionStatsTurnV1(retained, None, result.unwrap_err())
            var observed = result.unwrap()
            val expected_scope = container_host_scope_bytes_v2(scope)
            val actual_scope = container_host_scope_bytes_v2(observed.scope)
            if (expected_scope.is_err() or actual_scope.is_err() or expected_scope.unwrap() != actual_scope.unwrap() or
                    observed.request_digest != original_request.plan.request_digest or
                    observed.runtime.pod_uid != original_request.plan.workload_uid or
                    observed.runtime.attempt != original_request.plan.attempt or
                    observed.runtime.operation_id != original_request.plan.operation_id):
                return ContainerExecutionStatsTurnV1(retained, None, "container-stats-api-binding")
            val finished = time_sample_monotonic_nanos_or_failure()
            if (observed.sample_started_monotonic_ns < started or finished < observed.sample_finished_monotonic_ns or
                    finished < started): return ContainerExecutionStatsTurnV1(retained, None, "container-stats-monotonic-clock")
            observed.sample_started_monotonic_ns = started
            observed.sample_finished_monotonic_ns = finished
            val shape = container_execution_stats_observation_validate_v1(observed)
            if shape.is_err(): return ContainerExecutionStatsTurnV1(retained, None, shape.unwrap_err())
            ContainerExecutionStatsTurnV1(retained, Some(observed), "")

pub struct ContainerExecutionConfigurationTurnV1:
    owner: SimpleContainerOwnerV2
    observation: ContainerExecutionConfigurationObservationV1?
    error: text

pub struct ContainerExecutionInputConfigurationTurnV1:
    owner: SimpleContainerOwnerV2
