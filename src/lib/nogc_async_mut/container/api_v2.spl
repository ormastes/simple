pub enum SimpleContainerOwnerV2:
    Linux(ContainerHostScopeV2, LinuxSimpleContainerAdapterV2)
    Windows(ContainerHostScopeV2, WindowsSimpleContainerAdapterV2)

pub struct SimpleContainerFreshOpenV2:
    owner: Option<SimpleContainerOwnerV2> = nil
    admission_cleanup: Option<MachineFreshEpochAdmissionTurnV1> = nil
    fresh_cleanup: Option<LinuxFreshWorkloadOwnerV2> = nil
    error: text = ""

pub struct SimpleContainerCloseV2:
    owner: Option<SimpleContainerOwnerV2>
    closed: bool
    error: text

pub struct SimpleContainerFreshCleanupV2:
    retained: Option<SimpleContainerFreshOpenV2>
    closed: bool
    error: text

# Principal is an actual scoped loan: the caller keeps its cleanup owner alive.
# A request DTO or policy string cannot choose this genuine installed factory.
pub fn simple_container_open_fresh_v2(principal: MachineLocalProcessPrincipalV1,
        template: GroupProcessStreamLaunchV2) -> SimpleContainerFreshOpenV2:
    val admitted = machine_container_authority_open_fresh_epoch_v1()
    if admitted.error != "" or admitted.owner.is_none():
        return SimpleContainerFreshOpenV2(admission_cleanup: Some(admitted), error: admitted.error)
    val transferred = admitted.owner.unwrap().transfer_workload_v2()
    if transferred.owner.is_none():
        var cleanup = admitted
        cleanup.owner = transferred.retained
        return SimpleContainerFreshOpenV2(admission_cleanup: Some(cleanup), error: transferred.error)
    val fresh = linux_fresh_workload_owner_v2(transferred.owner.unwrap(), principal, template)
    if transferred.error != "": return SimpleContainerFreshOpenV2(fresh_cleanup: Some(fresh), error: transferred.error)
    # Retain the actual native owner BEFORE any metadata validation can fail.
    val adapter = LinuxSimpleContainerAdapterV2.open_fresh_v2(fresh)
    if adapter.is_err(): return SimpleContainerFreshOpenV2(fresh_cleanup: Some(fresh), error: adapter.unwrap_err())
    val scope = fresh.scope_v2()
    if scope.is_err(): return SimpleContainerFreshOpenV2(fresh_cleanup: Some(fresh), error: scope.unwrap_err())
    SimpleContainerFreshOpenV2(owner: Some(SimpleContainerOwnerV2.Linux(scope.unwrap(), adapter.unwrap())))

# ---- milestone_0021 V4 agent API (3.3). Thin forwards: every turn retains the updated tagged owner. ----

# Step 4 of the lent factory (few's linux_workspace_root_open_lent_v4 runs steps 1-3). On an adapter failure the
# root loan is ended on the transfer and the fresh owner is returned as cleanup (`agent.fresh`).
pub struct SimpleContainerLentOpenV4:
    owner: Option<SimpleContainerOwnerV2> = None
    root: Option<LinuxWorkspaceRootBorrowV3> = None
    admission_cleanup: Option<MachineFreshEpochAdmissionOwnerV1> = None
    fresh_cleanup: Option<LinuxFreshWorkloadOwnerV2> = None
    error: text = ""

pub fn simple_container_open_lent_v4(admission: MachineFreshEpochAdmissionOwnerV1,
        native: LinuxServiceNativeIdentityBorrowV3, template: GroupProcessStreamLaunchV2) -> SimpleContainerLentOpenV4:
    val opened = linux_workspace_root_open_lent_v4(admission, native, template)
    if opened.fresh.is_none():
        return SimpleContainerLentOpenV4(root: opened.root, admission_cleanup: opened.admission_cleanup, error: opened.error)
    if opened.error != "":
        return SimpleContainerLentOpenV4(root: opened.root, fresh_cleanup: opened.fresh, error: opened.error)
    val fresh = opened.fresh.unwrap()
    val adapter = LinuxSimpleContainerAdapterV2.open_fresh_v2(fresh)
    if adapter.is_err():
        val failed = linux_workspace_root_open_fresh_failed_v4(fresh, adapter.unwrap_err())
        return SimpleContainerLentOpenV4(root: failed.root, fresh_cleanup: failed.fresh, error: failed.error)
    val scope = fresh.scope_v2()
    if scope.is_err():
        val failed = linux_workspace_root_open_fresh_failed_v4(fresh, scope.unwrap_err())
        return SimpleContainerLentOpenV4(root: failed.root, fresh_cleanup: failed.fresh, error: failed.error)
    SimpleContainerLentOpenV4(owner: Some(SimpleContainerOwnerV2.Linux(scope.unwrap(), adapter.unwrap())))

pub struct SimpleContainerAgentTurnV3:
    owner: SimpleContainerOwnerV2
    root: Option<LinuxWorkspaceRootBorrowV3> = None
    native: Option<LinuxServiceNativeIdentityBorrowV3> = None
    error: text = ""

fn simple_container_agent_step_v3(owner: SimpleContainerOwnerV2, kind: text,
        root: Option<LinuxWorkspaceRootBorrowV3> = None, native: Option<LinuxServiceNativeIdentityBorrowV3> = None,
        value: text = "") -> SimpleContainerAgentTurnV3:
    match owner:
        case SimpleContainerOwnerV2.Linux(scope, adapter):
            val turn = adapter.agent_step_v3(kind, root, native, value)
            SimpleContainerAgentTurnV3(owner: SimpleContainerOwnerV2.Linux(scope, turn.owner), root: turn.root,
                native: turn.native, error: turn.error)
        case SimpleContainerOwnerV2.Windows(_, _):
            SimpleContainerAgentTurnV3(owner: owner, root: root, native: native, error: "container-workspace-linux-required")

pub fn simple_container_take_workspace_root_v3(owner: SimpleContainerOwnerV2) -> SimpleContainerAgentTurnV3:
    simple_container_agent_step_v3(owner, "take-root")

pub fn simple_container_end_workspace_root_loan_v3(owner: SimpleContainerOwnerV2, root: LinuxWorkspaceRootBorrowV3) -> SimpleContainerAgentTurnV3:
    simple_container_agent_step_v3(owner, "end-root", Some(root))

pub fn simple_container_end_service_loan_v3(owner: SimpleContainerOwnerV2, native: LinuxServiceNativeIdentityBorrowV3) -> SimpleContainerAgentTurnV3:
    simple_container_agent_step_v3(owner, "end-service", None, Some(native))

pub fn simple_container_adopt_lent_workspace_reader_v3(owner: SimpleContainerOwnerV2) -> SimpleContainerAgentTurnV3:
