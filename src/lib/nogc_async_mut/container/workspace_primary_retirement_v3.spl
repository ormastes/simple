# Native-only read loan over the original canonical upper owner. A fabricated
# data/boolean/nil-ref return cannot substitute for invoking current_v3().
use std.nogc_sync_mut.container.machine_authority_v1.MachineFreshWorkloadTransferV2
use std.nogc_sync_mut.container.machine_fresh_workspace_primary_v3.{MachineWorkspacePrimaryCallV3,
    MachineWorkspacePrimaryReplyV3}
pub use std.nogc_sync_mut.container.machine_fresh_workspace_primary_v3.MachineWorkspacePrimaryRetirementDataV3

pub class ContainerPrimaryTransportRetirementV3:
    original: MachineFreshWorkloadTransferV2

    # Runtime origin/generation/canonical positive-retirement validation is
    # repeated through the actual owner. This never proves Host/pane settlement.
    pub fn current_v3() -> Result<MachineWorkspacePrimaryRetirementDataV3, text>:
        match self.original.primary_v3(MachineWorkspacePrimaryCallV3.Retirement):
            case MachineWorkspacePrimaryReplyV3.Retirement(actual): actual
            case _: Err("workspace-primary-retirement-turn-mismatch")

pub fn container_primary_transport_retirement_v3(original: MachineFreshWorkloadTransferV2) -> Result<ContainerPrimaryTransportRetirementV3, text>:
    val token = ContainerPrimaryTransportRetirementV3(original: original)
    val actual = token.current_v3()?
    Ok(token)

use std.nogc_async_mut.container.terminal_session_v1.ContainerPrimaryAttachSessionV1
pub use std.nogc_sync_mut.container.machine_fresh_workspace_primary_v3.MachineWorkspacePrimarySessionBindingDataV3

pub class ContainerPrimarySessionBindingV3:
    original: MachineFreshWorkloadTransferV2
    session: ContainerPrimaryAttachSessionV1

    # No snapshot can substitute for runtime canonical matching on every read.
    pub fn current_v3() -> Result<MachineWorkspacePrimarySessionBindingDataV3, text>:
        match self.original.primary_v3(MachineWorkspacePrimaryCallV3.SessionBinding(self.session)):
            case MachineWorkspacePrimaryReplyV3.SessionBinding(actual): actual
            case _: Err("workspace-primary-session-binding-turn-mismatch")

pub fn container_primary_session_binding_v3(original: MachineFreshWorkloadTransferV2,
        session: ContainerPrimaryAttachSessionV1) -> Result<ContainerPrimarySessionBindingV3, text>:
    val loan = ContainerPrimarySessionBindingV3(original: original, session: session)
    val actual = loan.current_v3()?
    Ok(loan)
