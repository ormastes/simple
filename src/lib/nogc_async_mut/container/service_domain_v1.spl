# Actual local machine-domain foundation; no wire constructor or remote-grant
# relabeling. Server integration must consume this owner, not a textual tag.
use std.common.contracts.container.machine_policy_v1.MachineContainerPolicyV1
use std.common.contracts.container.execution_v2.ContainerHostObservationV2
use std.nogc_sync_mut.container.machine_authority_v1.*
use std.nogc_sync_mut.orchestration.host_service_domain_v3.HostServiceDomainV3
use std.nogc_sync_mut.io.machine_local_process_principal_v1.MachineLocalProcessPrincipalV1
use std.common.contracts.container.local_session_v1.{LocalContainerRequestV1, local_container_request_bytes_v1}
use std.common.build_manager.group_process_stream_protocol_v2.GroupProcessStreamLaunchV2
use std.nogc_async_mut.container.providers.linux.fresh_epoch_creator_v1.*
use std.nogc_sync_mut.container.machine_fresh_epoch_cleanup_v1.machine_fresh_epoch_admission_turn_close_v1

pub class LocalContainerServiceDomainV1:
    authority: MachineContainerAuthorityV1

    pub fn current_policy_v1() -> Result<MachineContainerPolicyV1, text>:
        val policy = self.authority.current_policy_v1()?
        if policy.mode != "standalone": return Err("local-container-managed-authority-required")
        Ok(policy)

    pub fn observe_provider_v1() -> Result<ContainerHostObservationV2, text>:
        val policy = self.current_policy_v1()?
        self.authority.observe_provider_v1()

    pub fn journal_head_v1() -> Result<text, text>:
        val policy = self.current_policy_v1()?
        self.authority.journal_head_v1()

    # Actual direct-process authentication precedes the missing migration fence.
    # The owned foundation remains with the caller on every refusal; no fake
    # reservation, distributed grant, provider create or release is produced.
    pub fn process_admit_v1(request: LocalContainerRequestV1,
            principal: MachineLocalProcessPrincipalV1) -> Result<bool, text>:
        val actual = self.authority.validate_local_process_v1(principal)?
        val canonical = local_container_request_bytes_v1(request)?
        val policy = self.current_policy_v1()?
        if request.cpu_millis > policy.cpu_millis or request.memory_bytes > policy.memory_bytes:
            return Err("local-container-request-capacity-exceeded")
        val head = self.authority.journal_head_v1()?
        if head == "": return Err("local-container-migration-fence-unavailable")
        # Unknown retained history cannot be relabelled into a local grant.
        # No native termination/absence settlement capability exists here yet.
        Err("local-container-retained-admission-unavailable")

    pub fn close_v1() -> text:
        self.authority.close_v1()

pub enum LocalContainerServiceOpenV1:
    Rejected(reason: text)
    CleanupRequired(owner: MachineContainerAuthorityCleanupV1, reason: text)
    DomainCleanupRequired(owner: LocalContainerServiceDomainV1, reason: text)
    Ready(owner: LocalContainerServiceDomainV1)

pub enum ContainerServiceDomainV1:
    Managed(HostServiceDomainV3)
    Local(LocalContainerServiceDomainV1)

pub fn local_container_service_open_v1() -> LocalContainerServiceOpenV1:
    val authority = match machine_container_authority_open_local_v1():
        case MachineContainerAuthorityOpenV1.Rejected(reason):
            return LocalContainerServiceOpenV1.Rejected(reason)
        case MachineContainerAuthorityOpenV1.CleanupRequired(owner, reason):
            return LocalContainerServiceOpenV1.CleanupRequired(owner, reason)
        case MachineContainerAuthorityOpenV1.Ready(owner): owner
    val domain = LocalContainerServiceDomainV1(authority: authority)
    val policy = domain.current_policy_v1()
    if policy.is_err(): return LocalContainerServiceOpenV1.DomainCleanupRequired(domain, policy.unwrap_err())
    val observed = domain.observe_provider_v1()
    if observed.is_err(): return LocalContainerServiceOpenV1.DomainCleanupRequired(domain, observed.unwrap_err())
    # Ready means retained installed policy/provider/shared-writer foundation.
    # Reservation/delegation, workload execution and terminal adoption are not
    # exposed until their real admission and settlement ports are implemented.
    LocalContainerServiceOpenV1.Ready(domain)

# Explicit positive first-epoch entry. Never an implicit fallback for a
# generic missing/unknown ledger, a remote client's identity or legacy stores.
pub enum LocalFreshEpochServiceOpenV1:
    NotStarted(retained: MachineFreshEpochAdmissionTurnV1)
    Started(owner: LinuxFreshEpochProviderCreatorV1)
    Retained(owner: LinuxFreshEpochProviderCreatorV1, reason: text)

pub struct LocalFreshEpochServiceCloseTurnV1:
    retained: Option<LocalFreshEpochServiceOpenV1>
    closed: bool
    error: text

pub fn local_container_service_start_fresh_epoch_v1(template: GroupProcessStreamLaunchV2) -> LocalFreshEpochServiceOpenV1:
    val admitted = machine_container_authority_open_fresh_epoch_v1()
    if admitted.error != "" or admitted.owner.is_none(): return LocalFreshEpochServiceOpenV1.NotStarted(admitted)
    match linux_fresh_epoch_provider_start_v1(admitted.owner.unwrap(), template):
        case LinuxFreshEpochProviderOpenV1.Started(owner): LocalFreshEpochServiceOpenV1.Started(owner)
        case LinuxFreshEpochProviderOpenV1.Retained(owner, reason): LocalFreshEpochServiceOpenV1.Retained(owner, reason)

pub fn local_container_service_fresh_close_v1(original: LocalFreshEpochServiceOpenV1) -> LocalFreshEpochServiceCloseTurnV1:
    match original:
        case LocalFreshEpochServiceOpenV1.NotStarted(retained):
            val closed = machine_fresh_epoch_admission_turn_close_v1(retained)
            val pending = if closed.retained.is_some(): Some(LocalFreshEpochServiceOpenV1.NotStarted(closed.retained.unwrap())) else: nil
            LocalFreshEpochServiceCloseTurnV1(pending, closed.closed, closed.error)
        case LocalFreshEpochServiceOpenV1.Started(owner):
            val closed = owner.close_v1()
            val pending = if closed.owner.is_some(): Some(LocalFreshEpochServiceOpenV1.Started(closed.owner.unwrap())) else: nil
            LocalFreshEpochServiceCloseTurnV1(pending, closed.closed, closed.error)
        case LocalFreshEpochServiceOpenV1.Retained(owner, reason):
            val closed = owner.close_v1()
            val pending = if closed.owner.is_some(): Some(LocalFreshEpochServiceOpenV1.Retained(closed.owner.unwrap(), reason)) else: nil
            LocalFreshEpochServiceCloseTurnV1(pending, closed.closed, closed.error)
