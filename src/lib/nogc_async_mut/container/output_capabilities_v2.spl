use std.common.contracts.container.stream_v2.ContainerOutputPlanV2
use std.common.contracts.container.output_capabilities_v2.ContainerOutputCapabilitiesV2
use std.nogc_async_mut.container.api_v2.SimpleContainerOwnerV2

# The plan comes from the trusted output planner, not a decoded client packet.
# Startup without an actual plan can advertise planning, not this observation.
pub fn simple_container_output_capabilities_v2(owner: SimpleContainerOwnerV2,
        plan: ContainerOutputPlanV2) -> ContainerOutputCapabilitiesV2:
    match owner:
        case SimpleContainerOwnerV2.Linux(_, adapter): adapter.output_capabilities(plan)
        case SimpleContainerOwnerV2.Windows(_, _):
            ContainerOutputCapabilitiesV2(output_follow_supported: false,
                reason: "container-output-windows-transport-unsupported")
