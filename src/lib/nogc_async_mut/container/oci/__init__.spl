# std.container.oci — public OCI interoperability module of Simple Container.
#
# Pure image/manifest/descriptor/config decode, digest/size/path/platform
# validation, bundle import, OCI -> workload projection and OCI export. It
# owns no container attempt, lifecycle, journal, broker or engine; the
# projected workload is handed to the one std.container facade.
#
# The codec itself lives in std.common.oci (no IO, no hosted imports) so the
# SimpleOS kernel adapter src/os/services/container/oci_import.spl can share
# the same validator. Registry transport is not part of this module.
# Design: doc/05_design/simple_container_macos_seatbelt.md §16.5.2-16.5.5.

export use std.common.oci.descriptor_v1.{OciLimitsV1, OciPlatformV1, OciDescriptorV1,
    OCI_MEDIA_TYPE_INDEX_V1, OCI_MEDIA_TYPE_MANIFEST_V1, OCI_MEDIA_TYPE_CONFIG_V1,
    OCI_MEDIA_TYPE_LAYER_TAR_V1, OCI_MEDIA_TYPE_LAYER_GZIP_V1, OCI_MEDIA_TYPE_LAYER_ZSTD_V1,
    oci_limits_default_v1, oci_digest_valid_v1, oci_layer_path_valid_v1,
    oci_layer_whiteout_target_v1, oci_platform_matches_v1, oci_descriptor_decode_v1}
export use std.common.oci.image_v1.{OciImageReferenceV1, OciImageIndexV1, OciImageManifestV1,
    OciImageConfigV1, oci_image_reference_parse_v1, oci_image_index_decode_v1,
    oci_image_index_select_v1, oci_image_manifest_decode_v1, oci_image_config_decode_v1,
    oci_image_config_matches_manifest_v1, oci_blob_verify_v1, oci_blob_verify_text_v1}
export use std.common.oci.runtime_v1.{OciRuntimeMountV1, OciRuntimeConfigV1, OciBundleV1,
    oci_runtime_config_decode_v1, oci_bundle_import_v1}
export use std.common.oci.bundle_check_v1.{OciBundleCheckPolicyV1, oci_bundle_check_policy_default_v1}
export use std.common.oci.workload_v1.{OciWorkloadV1, OciExportV1, oci_backend_platform_os_v1,
    oci_bundle_to_workload_v1, oci_image_to_workload_v1, oci_export_v1}
