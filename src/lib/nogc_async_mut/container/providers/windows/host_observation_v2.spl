# Read-only provider observation leaf. No exchange, session, Host or admission imports.
use std.common.contracts.container.execution_v2.ContainerHostObservationV2
use std.nogc_sync_mut.io.windows_host_identity_v1.windows_host_identity_v1
use std.nogc_async_mut.container.providers.windows.docker_policy_codec_v1.windows_docker_policy_decode_v1
use std.nogc_async_mut.container.providers.windows.docker_runtime_v1.WindowsDockerRuntimeProviderV1
use std.common.crypto.sha256.sha256_text

pub fn windows_container_native_observe_v4(policy_bytes: text) -> Result<ContainerHostObservationV2, text>:
    val policy = windows_docker_policy_decode_v1(policy_bytes)?
    val native = windows_host_identity_v1()?
    if native.native_machine_id == "" or native.boot_counter < 0 or native.architecture == "":
        return Err("windows-container-native-host-observation-missing")
    if native.boot_assurance != "successful-boot-counter":
        return Err("windows-container-native-assurance-unsupported")
    # The counter is lower-assurance data, never a native boot incarnation.
    # Canonical policy is validated by decode; field hashes prevent ambiguity.
    val identity = "windows-container-provider-v2\n" + sha256_text(policy_bytes) + "\n" +
        sha256_text(native.native_machine_id) + "\n" + sha256_text(native.architecture)
    Ok(ContainerHostObservationV2(backend: "windows-docker-process",
        native_machine_id: native.native_machine_id, native_boot_id: "",
        provider_identity_digest: sha256_text(identity), execution_os: "windows",
        architecture: native.architecture, continuity_assurance: "machine-boot-counter-v1",
        boot_observation: native.boot_counter.to_text()))

# Finite startup/legacy observation retains the actual engine probe. Cooperative
# execution separately sequences the same engine check through its command owner.
pub fn windows_container_host_observe_v2(policy_bytes: text) -> Result<ContainerHostObservationV2, text>:
    val observed = windows_container_native_observe_v4(policy_bytes)?
    val policy = windows_docker_policy_decode_v1(policy_bytes)?
    var provider = WindowsDockerRuntimeProviderV1.new(policy)
    val engine = provider.probe()
    if not engine.engine_present or not engine.healthy:
        return Err("windows-container-engine-observation-failed:" + engine.reason)
    Ok(observed)
