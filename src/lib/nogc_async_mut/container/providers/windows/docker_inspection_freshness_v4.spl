# Both timestamps are actual time_sample_monotonic_nanos_or_failure samples.
# observed_ns is captured BEFORE inspect command admission and retained through
# native cleanup. Publication/completion time must never replace that bound.
pub fn windows_primary_inspection_fresh_v4(observed_ns: i64, now_ns: i64, installed_timeout_ms: i64) -> bool:
    val window_ms = if installed_timeout_ms < 1000: installed_timeout_ms else: 1000
    if observed_ns < 0 or now_ns < observed_ns or window_ms <= 0: return false
    now_ns - observed_ns <= window_ms * 1000000
