# Pure adapter admission helpers; extracted unchanged to keep the retained owner focused.
use std.common.contracts.container.runtime_v1.{RuntimeOperationV1, runtime_command_empty, runtime_state_empty, RUNTIME_STATUS_BLOCKED}

pub fn safe_state_root(root: text) -> bool:
    if root.len() < 4 or root.len() > 512: return false
    val drive = root.byte_at(0)
    if not ((drive >= 65 and drive <= 90) or (drive >= 97 and drive <= 122)): return false
    if root.byte_at(1) != 58 or root.byte_at(2) != 92: return false
    val tail = root.substring(2, root.byte_len())
    not root.contains("\0") and not root.contains("\n") and not root.contains("\r") and
        not root.contains("..") and not root.contains("\"") and not root.contains("|") and
        not root.contains("/") and not tail.contains(":")

pub fn rejected(action: text, reason: text, status: text = RUNTIME_STATUS_BLOCKED) -> RuntimeOperationV1:
    RuntimeOperationV1(status: status, operation: action, command: runtime_command_empty(),
        state: runtime_state_empty(), exit_code: -1, stdout: "", stderr: "", reason: reason)
