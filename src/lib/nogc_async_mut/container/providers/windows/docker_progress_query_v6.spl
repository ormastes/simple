# Pure query selection shared by finite/cooperative reduction. No process or
# capture completion is executed here; the retained runtime owns every effect.
use std.common.contracts.container.execution_v2.ContainerHostScopeV2
use std.common.contracts.container.runtime_v1.RuntimeCommandV1
use std.nogc_async_mut.container.providers.windows.docker_contract_v1.*
use std.nogc_async_mut.container.providers.windows.docker_observation_codec_v2.windows_docker_inspect_format_v2
use std.nogc_async_mut.container.providers.windows.docker_network_v6.windows_docker_network_inspect_command_v6
use std.nogc_async_mut.container.providers.windows.docker_server_environment_inspect_v5.windows_docker_server_environment_inspect_command_v5

pub fn windows_docker_progress_query_v6(policy: WindowsDockerPolicyV1, request: WindowsDockerRequestV1,
        scope: ContainerHostScopeV2?, stage: text, native_id: text,
        current: RuntimeCommandV1) -> Result<RuntimeCommandV1, text>:
    if stage == "engine" or stage == "engine-after":
        return Ok(windows_docker_command_v1(policy, "engine-info", ["info", "--format", WINDOWS_DOCKER_INFO_FORMAT_V1]))
    if stage == "network" or stage == "network-after": return windows_docker_network_inspect_command_v6(policy)
    if stage == "environment" or stage == "environment-after": return windows_docker_server_environment_inspect_command_v5(policy, native_id)
    if stage == "image":
        return Ok(windows_docker_command_v1(policy, "image-inspect", ["image", "inspect", "--format", WINDOWS_DOCKER_IMAGE_FORMAT_V1, request.image]))
    if stage == "inspect" or stage == "inspect-after":
        if not windows_docker_id_v1(native_id): return Err("docker-exact-native-id-required")
        return Ok(windows_docker_command_v1(policy, "inspect", ["container", "inspect", "--format", windows_docker_inspect_format_v2(request, scope), native_id]))
    if stage == "start": return Ok(windows_docker_command_v1(policy, "start", ["start", native_id]))
    Ok(current)
