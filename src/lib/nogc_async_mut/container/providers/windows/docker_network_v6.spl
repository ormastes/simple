# Administrator-approved pre-existing NAT network. No network creation, name
# fallback, host networking, global prune or endpoint/firewall guarantee.
use std.common.contracts.container.runtime_v1.RuntimeCommandV1
use std.nogc_async_mut.container.providers.windows.docker_contract_v1.{WindowsDockerPolicyV1,
    windows_docker_id_v1, windows_docker_command_v1}

pub const WINDOWS_DOCKER_NETWORK_FORMAT_V6 = "{{{{.Id}}}}|{{{{.Name}}}}|{{{{.Driver}}}}|{{{{.Scope}}}}|{{{{.Internal}}}}"
pub const WINDOWS_DOCKER_ATTACHED_NETWORK_FORMAT_V6 = "|{{{{len .NetworkSettings.Networks}}}}|{{{{range .NetworkSettings.Networks}}}}{{{{.NetworkID}}}}{{{{end}}}}"

pub fn windows_docker_network_inspect_command_v6(policy: WindowsDockerPolicyV1) -> Result<RuntimeCommandV1, text>:
    if not windows_docker_id_v1(policy.network_id): return Err("docker-network-policy-required")
    Ok(windows_docker_command_v1(policy, "network-inspect",
        ["network", "inspect", "--format", WINDOWS_DOCKER_NETWORK_FORMAT_V6, policy.network_id]))

pub fn windows_docker_network_observation_v6(policy: WindowsDockerPolicyV1, stdout: text) -> Result<bool, text>:
    if not windows_docker_id_v1(policy.network_id) or policy.network_name == "":
        return Err("docker-network-policy-required")
    if stdout.byte_len() > 1024: return Err("docker-network-observation-too-large")
    val expected = policy.network_id + "|" + policy.network_name + "|nat|local|false"
    if stdout.trim() != expected: return Err("docker-network-observation-mismatch")
    Ok(true)
