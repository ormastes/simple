use std.common.contracts.container.execution_v2.ContainerHostScopeV2
# Private-progress carrier shared by finite and cooperative Docker operations.
# Native command ownership is retained until cleanup; no caller-supplied reply
# can be injected into the provider's observation/authority methods.
use std.nogc_async_mut.container.providers.windows.docker_contract_v1.{WindowsDockerRequestV1, WindowsDockerPolicyV1}
use std.common.contracts.container.runtime_v1.{RuntimeCommandV1, RuntimeOperationV1}
use std.nogc_sync_mut.io.windows_command_owner_v2.WindowsCommandOwnerV2

pub class WindowsDockerProgressV2:
    request: WindowsDockerRequestV1
    action: text
    stage: text
    command: RuntimeCommandV1
    token: i64 = -1
    inspection_claimed: bool = false
    inspection_started_ns: i64 = -1
    scripted: bool = false
    origin_policy: Option<WindowsDockerPolicyV1> = None
    origin_scope: Option<ContainerHostScopeV2> = None
    native_id: text = ""
    stdout: text = ""
    stderr: text = ""
    admission_expiry_ms: i64 = 0
    effect_command: Option<RuntimeCommandV1> = None
    command_owner: Option<WindowsCommandOwnerV2> = None
    result: Option<RuntimeOperationV1> = None
    error: text = ""

    pub fn failure_v4() -> text: self.error

    pub fn completed_v2() -> bool: self.result.is_some() and self.command_owner.is_none()
    pub fn operation_v2() -> Option<RuntimeOperationV1>: self.result
