# Explicit public discovery data only. Never inherit host env or key material.
use std.common.contracts.container.execution_options_v1.OciEnvironmentEntryV1
use std.common.config_core.server_container_projection_v1.server_container_environment_validate_v1

pub fn windows_docker_server_environment_options_v5(environment: [OciEnvironmentEntryV1]) -> Result<[text], text>:
    if environment.len() == 0: return Ok([])
    if environment.len() != 3: return Err("docker-server-environment-triple-required")
    var folded: [text] = []
    var names: [text] = []
    var values: [text] = []
    var options: [text] = []
    for entry in environment:
        val key = entry.name.to_lower()
        if folded.contains(key): return Err("docker-server-environment-name-duplicate")
        folded.push(key)
        if entry.name != "SIMPLE_SERVERS_SDN" and entry.name != "SIMPLE_SERVER_CLIENT_SCOPE" and entry.name != "SIMPLE_SERVERS_CONFIG":
            return Err("docker-server-environment-name-restricted")
        if entry.value.byte_len() > 4096 or entry.value.contains("\0"):
            return Err("docker-server-environment-value-invalid")
        names.push(entry.name)
        values.push(entry.value)
        # SDN newlines, spaces and punctuation remain one argv element.
        options = options + ["--env", entry.name + "=" + entry.value]
    val valid = server_container_environment_validate_v1(names, values)?
    Ok(options)
