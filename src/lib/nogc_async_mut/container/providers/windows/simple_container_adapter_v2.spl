# Windows leaf behind the Simple Container V2 execution API. SOURCE-ONLY NOT_RUN.
# Native machine/boot observations come from the platform owner, never policy.
# state_root is validated caller scope, not a claim that this adapter journals.
# Recovery/cleanup require this instance's retained successful-create authority;
# reopening cannot import copied RuntimeIntentV1 as cleanup authorization.
use std.common.contracts.container.execution_v2.{ContainerHostScopeV2,
    ContainerExecutionRequestV2, ContainerHostObservationV2, ContainerRequestProjectionV2, ContainerActionProjectionV2, ContainerMountProjectionV2, ContainerServiceScopeBasisV2, ContainerServiceInventoryEntryV2, container_scope_fence_id_v2}
