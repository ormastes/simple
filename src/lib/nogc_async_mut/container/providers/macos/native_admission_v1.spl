# Native Mac admission owner. This is not a launch/lifecycle implementation.
# It preserves the common state while validating a proposed local Mac launch.
# No request, copied receipt, PID, entitlement boolean or exit code can promote
# a workload to running. Independent signed sandbox and descendant authority
# must be provided by a native owner before this gate can admit execution.

use std.common.contracts.container.runtime_v1.{
    RuntimeIdentityV1, RuntimeStateV1, RuntimeOperationV1,
    RUNTIME_PHASE_PREPARED, RUNTIME_STATUS_REJECTED, RUNTIME_STATUS_BLOCKED,
    runtime_command_empty}
use std.nogc_sync_mut.io.process_observation_v4.{process_observation_capabilities_v4}
use std.nogc_async_mut.container.providers.macos.executable_preflight_v1.{macos_executable_preflight_v1}

pub const MACOS_NATIVE_SANDBOX_ENGINE_V1 = "macos-native-sandbox-v1"

fn _mac_admission_result(state: RuntimeStateV1, status: text,
        reason: text) -> RuntimeOperationV1:
    RuntimeOperationV1(status: status, operation: "launch-preflight",
        command: runtime_command_empty(), state: state, exit_code: -1,
        stdout: "", stderr: "", reason: reason)

# Immutable admission state, not a native resource or launch lease. SimpleOS
# continues to own ContainerWorld and Windows owns its HCS handles separately.
pub class MacOsNativeSandboxAdmissionV1:
    state: RuntimeStateV1

    pub static fn prepare(identity: RuntimeIdentityV1) -> MacOsNativeSandboxAdmissionV1:
        MacOsNativeSandboxAdmissionV1(state: RuntimeStateV1(
            phase: RUNTIME_PHASE_PREPARED, identity: identity, exit_code: -1,
            reason: "macos-native-launch-not-admitted"))

    # Pure request checks execute before any host observation. Returns a
    # diagnostic, never an executable command or successful lifecycle receipt.
    pub fn validate_request(self, host_os: text, execution_os: text,
            isolation_class: text, architecture: text, image: [u8]) -> RuntimeOperationV1:
        if host_os != "macos" or execution_os != "macos" or isolation_class != "native-sandbox":
            return _mac_admission_result(self.state, RUNTIME_STATUS_REJECTED,
                "macos-native-exact-host-execution-isolation-required")
        val identity = self.state.identity
        if self.state.phase != RUNTIME_PHASE_PREPARED or self.state.exit_code != -1:
            return _mac_admission_result(self.state, RUNTIME_STATUS_REJECTED,
                "macos-native-prepared-state-required")
        if identity.pod_uid == "" or identity.attempt <= 0 or
                identity.provider_generation <= 0 or identity.operation_id == "" or
                identity.node_boot_id == "" or identity.native_id != "" or
                identity.engine != MACOS_NATIVE_SANDBOX_ENGINE_V1:
            return _mac_admission_result(self.state, RUNTIME_STATUS_REJECTED,
                "macos-native-invalid-attempt-identity")
        val format = macos_executable_preflight_v1(image, architecture)
        if not format.accepted:
            return _mac_admission_result(self.state, RUNTIME_STATUS_REJECTED, format.reason)
        # Format/identity validation does not manufacture native ownership.
        _mac_admission_result(self.state, RUNTIME_STATUS_BLOCKED,
            "macos-native-signed-sandbox-owner-required")

    # Live capability check supplements request validation. Even a future V4
    # process owner alone cannot establish an independent App Sandbox boundary.
    # No fallback to generic spawn, Podman, a VM or a process group is permitted.
    pub fn preflight(self, host_os: text, execution_os: text,
            isolation_class: text, architecture: text, image: [u8]) -> RuntimeOperationV1:
        val request = self.validate_request(host_os, execution_os, isolation_class, architecture, image)
        if request.status == RUNTIME_STATUS_REJECTED:
            return request
        val capability = match process_observation_capabilities_v4():
            case Ok(value): value
            case Err(reason):
                return _mac_admission_result(self.state, RUNTIME_STATUS_BLOCKED,
                    "macos-native-observation-error: " + reason)
        if not capability.available or capability.runtime_error != 0:
            return _mac_admission_result(self.state, RUNTIME_STATUS_BLOCKED,
                "macos-native-exact-process-owner-unavailable")
        request

export MacOsNativeSandboxAdmissionV1, MACOS_NATIVE_SANDBOX_ENGINE_V1
