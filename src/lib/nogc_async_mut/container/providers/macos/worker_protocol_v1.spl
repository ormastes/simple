# Bounded authenticated ingress for an independently launched Mac worker.
# This is a protocol owner, NOT a container/process/sandbox owner. Acceptance
# authenticates possession of a provisioned secret and consumes a sequence;
# it never proves code signing, XPC peer identity, launch, exit or cleanup.
# The embedding service must provision a fresh 32-byte secret and nonce over
# an OS-authenticated channel, retain one mutable session, and cap transport
# reads before allocation. Reconstructing/copying a session loses replay state.

use std.common.contracts.container.runtime_v1.{RuntimeIdentityV1}
use std.common.crypto.hmac.{hmac_sha256_bytes}
use std.common.crypto.types.{crypto_text_to_bytes}
use std.common.crypto.constant_time.{black_box}
use std.nogc_async_mut.container.providers.macos.native_admission_v1.{MACOS_NATIVE_SANDBOX_ENGINE_V1}

pub const MAC_WORKER_MAX_PAYLOAD_V1: i64 = 65536
pub const MAC_WORKER_MAX_FRAME_V1: i64 = 65610
pub const MAC_WORKER_MAX_SEQUENCE_V1: i64 = 1048576
pub const MAC_WORKER_SUBMIT_V1: i64 = 1
pub const MAC_WORKER_STATUS_V1: i64 = 2
pub const MAC_WORKER_CANCEL_V1: i64 = 3
pub const MAC_WORKER_CLOSE_V1: i64 = 4

# Wire: version:u8, operation:u8, sequence:u32le, length:u32le,
# nonce:32 bytes, payload:length bytes, HMAC-SHA256:32 bytes.
# HMAC covers a domain and canonical attempt identity followed by every wire
# byte except the tag. There is no ignored extension/trailing-byte space.
pub struct MacWorkerRequestV1:
    operation: i64
    sequence: i64
    payload: [u8]

fn _mac_worker_token(value: text) -> bool:
    if value == "" or value.len() > 128:
        return false
    for ch in value.chars():
        if not ((ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
                (ch >= "0" and ch <= "9") or ch == "-" or ch == "_" or ch == "."):
            return false
    true

fn _mac_worker_context(identity: RuntimeIdentityV1) -> Result<[i64], text>:
    if (not _mac_worker_token(identity.pod_uid) or identity.attempt <= 0 or
            identity.provider_generation <= 0 or not _mac_worker_token(identity.operation_id) or
            not _mac_worker_token(identity.node_boot_id) or identity.native_id != "" or
            identity.engine != MACOS_NATIVE_SANDBOX_ENGINE_V1):
        return Err("mac-worker-invalid-attempt-identity")
    # Tokens forbid delimiters; integer rendering is canonical decimal.
    val context = "simple.mac.worker.request.v1|" + identity.pod_uid + "|" +
        identity.attempt.to_text() + "|" + identity.provider_generation.to_text() + "|" +
        identity.operation_id + "|" + identity.node_boot_id + "|" + identity.engine + "|"
    Ok(crypto_text_to_bytes(context))

fn _mac_worker_key(key: [u8], nonce: [u8]) -> Result<[i64], text>:
    if key.len() != 32 or nonce.len() != 32:
        return Err("mac-worker-key-and-nonce-must-be-32-bytes")
    var result: [i64] = []
    for byte in key:
        result.push(byte as i64)
    Ok(result)

fn _mac_worker_u32(frame: [u8], offset: i64) -> i64:
    ((frame[offset] as i64) | ((frame[offset + 1] as i64) << 8) |
        ((frame[offset + 2] as i64) << 16) | ((frame[offset + 3] as i64) << 24))

fn _mac_worker_shape(operation: i64, sequence: i64, length: i64) -> Result<bool, text>:
    if sequence < 1 or sequence > MAC_WORKER_MAX_SEQUENCE_V1:
        return Err("mac-worker-sequence-out-of-range")
    if operation < MAC_WORKER_SUBMIT_V1 or operation > MAC_WORKER_CLOSE_V1:
        return Err("mac-worker-unknown-operation")
    if sequence == MAC_WORKER_MAX_SEQUENCE_V1 and operation != MAC_WORKER_CLOSE_V1:
        return Err("mac-worker-final-sequence-close-required")
    if length > MAC_WORKER_MAX_PAYLOAD_V1 or length < 0:
        return Err("mac-worker-payload-too-large")
    if operation == MAC_WORKER_SUBMIT_V1 and length == 0:
        return Err("mac-worker-submit-payload-required")
    if operation != MAC_WORKER_SUBMIT_V1 and length != 0:
        return Err("mac-worker-control-payload-forbidden")
    Ok(true)

fn _mac_worker_tag(key: [i64], context: [i64], frame: [u8], count: i64) -> [i64]:
    var message: [i64] = []
    for byte in context:
        message.push(byte)
    for index in 0..count:
        message.push(frame[index] as i64)
    hmac_sha256_bytes(key, message)

# Controller-side framing. Requires the same externally provisioned secret,
# fresh session nonce and attempt identity as the receiving service.
pub fn mac_worker_encode_request_v1(identity: RuntimeIdentityV1, key: [u8],
        nonce: [u8], operation: i64, sequence: i64, payload: [u8]) -> Result<[u8], text>:
    val context = _mac_worker_context(identity)?
    val secret = _mac_worker_key(key, nonce)?
    val _shape = _mac_worker_shape(operation, sequence, payload.len())?
    var frame: [u8] = [1, operation as u8]
    for value in [sequence, payload.len()]:
        for shift in 0..4:
            frame.push(((value >> (shift * 8)) & 255) as u8)
    for byte in nonce:
        frame.push(byte)
    for byte in payload:
        frame.push(byte)
    val tag = _mac_worker_tag(secret, context, frame, frame.len())
    for byte in tag:
        frame.push(byte as u8)
    Ok(frame)

pub class MacWorkerSessionV1:
    secret: [i64]
    context: [i64]
    nonce: [u8]
    next_sequence: i64
    submitted: bool
    cancelled: bool
    closed: bool

    pub static fn provision(identity: RuntimeIdentityV1, key: [u8],
            nonce: [u8]) -> Result<MacWorkerSessionV1, text>:
        val context = _mac_worker_context(identity)?
        val secret = _mac_worker_key(key, nonce)?
        Ok(MacWorkerSessionV1(secret: secret, context: context, nonce: nonce,
            next_sequence: 1, submitted: false, cancelled: false, closed: false))

    # Valid messages are consumed exactly once. All rejection paths preserve
    # sequence and protocol state. Submit payload stays opaque: the worker
    # must separately validate its workload schema and native launch policy.
    pub me receive(frame: [u8]) -> Result<MacWorkerRequestV1, text>:
        if self.closed:
            return Err("mac-worker-session-closed")
        if frame.len() < 74 or frame.len() > MAC_WORKER_MAX_FRAME_V1:
            return Err("mac-worker-frame-size-invalid")
        if frame[0] != 1:
            return Err("mac-worker-version-unsupported")
        val operation = frame[1] as i64
        val sequence = _mac_worker_u32(frame, 2)
        val length = _mac_worker_u32(frame, 6)
        val _shape = _mac_worker_shape(operation, sequence, length)?
        if frame.len() != 74 + length:
            return Err("mac-worker-frame-length-mismatch")
        if sequence != self.next_sequence:
            return Err("mac-worker-replay-or-sequence-gap")
        val tag_offset = 42 + length
        val tag = _mac_worker_tag(self.secret, self.context, frame, tag_offset)
        var difference: i64 = 0
        for index in 0..32:
            difference = difference | ((frame[10 + index] as i64) ^ (self.nonce[index] as i64))
            difference = difference | ((frame[tag_offset + index] as i64) ^ tag[index])
        if black_box(difference) != 0:
            return Err("mac-worker-authentication-failed")
        if operation == MAC_WORKER_SUBMIT_V1 and self.submitted:
            return Err("mac-worker-attempt-already-submitted")
        if operation == MAC_WORKER_CANCEL_V1 and (not self.submitted or self.cancelled):
            return Err("mac-worker-cancel-not-admissible")
        var payload: [u8] = []
        for index in 0..length:
            payload.push(frame[42 + index])
        if operation == MAC_WORKER_SUBMIT_V1:
            self.submitted = true
        if operation == MAC_WORKER_CANCEL_V1:
            self.cancelled = true
        if operation == MAC_WORKER_CLOSE_V1:
            self.closed = true
            # Drops this owner's reference; Simple array ownership does not
            # guarantee erasure of other copies of provisioned secrets.
            self.secret = []
        self.next_sequence = sequence + 1
        Ok(MacWorkerRequestV1(operation: operation, sequence: sequence, payload: payload))

export MacWorkerSessionV1, MacWorkerRequestV1, mac_worker_encode_request_v1
export MAC_WORKER_MAX_PAYLOAD_V1, MAC_WORKER_MAX_FRAME_V1, MAC_WORKER_MAX_SEQUENCE_V1
export MAC_WORKER_SUBMIT_V1, MAC_WORKER_STATUS_V1, MAC_WORKER_CANCEL_V1, MAC_WORKER_CLOSE_V1
