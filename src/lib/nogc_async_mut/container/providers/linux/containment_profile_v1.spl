# Installed candidate syntax and integrity only. Runtime digest is an observed
# trusted-local-admin mutable path, not a sealed executable or launch proof.
use std.common.string_core.str_len
use std.common.build_manager.contracts.{builder_digest_valid_v1, builder_identifier_valid_v1}
use std.common.crypto.sha256.sha256_text
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1

pub struct LinuxOciContainmentProfileV1:
    cli_policy_digest: text
    runtime_program: text
    runtime_digest: text
    runtime_name: text
    cgroup_manager: text

pub fn linux_oci_containment_profile_error_v1(profile: LinuxOciContainmentProfileV1) -> text:
    if not builder_digest_valid_v1(profile.cli_policy_digest) or not builder_digest_valid_v1(profile.runtime_digest):
        return "containment-profile-digest-invalid"
    val path = profile.runtime_program
    if (not path.starts_with("/") or path == "/" or str_len(path) > 4096 or
            path.ends_with("/") or path.contains("//")):
        return "containment-profile-runtime-path-invalid"
    for byte in path.bytes():
        if byte < 32 or byte == 127: return "containment-profile-runtime-path-invalid"
    for component in path.split("/"):
        if component == "." or component == "..": return "containment-profile-runtime-path-invalid"
    if (not builder_identifier_valid_v1(profile.runtime_name) or str_len(profile.runtime_name) > 64):
        return "containment-profile-runtime-name-invalid"
    if not ["systemd", "cgroupfs"].contains(profile.cgroup_manager): return "containment-profile-cgroup-manager-invalid"
    ""

pub fn linux_oci_containment_profile_encode_v1(profile: LinuxOciContainmentProfileV1) -> Result<text, text>:
    val error = linux_oci_containment_profile_error_v1(profile)
    if error != "": return Err(error)
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("linux-oci-containment-profile"),
        "cliPolicyDigest": SdnValue.String(profile.cli_policy_digest), "runtimeProgram": SdnValue.String(profile.runtime_program),
        "runtimeDigest": SdnValue.String(profile.runtime_digest), "runtimeName": SdnValue.String(profile.runtime_name),
        "cgroupManager": SdnValue.String(profile.cgroup_manager)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(source) > 16384: return Err("containment-profile-source-bound")
    Ok(source)

fn containment_text_v1(fields: Dict<text, SdnValue>, key: text) -> Result<text, text>:
    match fields[key]:
        case SdnValue.String(value): Ok(value)
        case _: Err("containment-profile-field-type")

pub fn linux_oci_containment_profile_decode_v1(source: text) -> Result<LinuxOciContainmentProfileV1, text>:
    if str_len(source) == 0 or str_len(source) > 16384: return Err("containment-profile-source-bound")
    val parsed = match sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: 16384, max_depth: 2,
            max_nodes: 32, max_rows: 0, max_cells: 0, max_columns: 8)):
        case Ok(value): value
        case Err(_): return Err("containment-profile-syntax")
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("containment-profile-object")
    val names = ["version", "kind", "cliPolicyDigest", "runtimeProgram", "runtimeDigest", "runtimeName", "cgroupManager"]
    if fields.len() != names.len(): return Err("containment-profile-fields")
    for name in names:
        if not fields.contains_key(name): return Err("containment-profile-fields")
    if fields["version"] != SdnValue.Int(1) or containment_text_v1(fields, "kind")? != "linux-oci-containment-profile":
        return Err("containment-profile-version-kind")
    val profile = LinuxOciContainmentProfileV1(cli_policy_digest: containment_text_v1(fields, "cliPolicyDigest")?,
        runtime_program: containment_text_v1(fields, "runtimeProgram")?, runtime_digest: containment_text_v1(fields, "runtimeDigest")?,
        runtime_name: containment_text_v1(fields, "runtimeName")?, cgroup_manager: containment_text_v1(fields, "cgroupManager")?)
    if linux_oci_containment_profile_encode_v1(profile)? != source: return Err("containment-profile-noncanonical")
    Ok(profile)

pub fn linux_oci_containment_profile_digest_v1(profile: LinuxOciContainmentProfileV1) -> Result<text, text>:
    Ok(sha256_text(linux_oci_containment_profile_encode_v1(profile)?))

pub fn linux_oci_containment_profile_match_v1(profile: LinuxOciContainmentProfileV1,
        cli_policy_digest: text, selected_digest: text) -> Result<bool, text>:
    val digest = linux_oci_containment_profile_digest_v1(profile)?
    if profile.cli_policy_digest != cli_policy_digest or digest != selected_digest:
        return Err("containment-profile-selection-mismatch")
    Ok(true)
