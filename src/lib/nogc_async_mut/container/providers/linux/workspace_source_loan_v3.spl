# Narrow borrowed view of a genuine workspace source capability. The loan
# carries no close, reader, storage, lease, root, or descriptor operation.
use std.nogc_async_mut.container.providers.linux.workspace_mount_owner_v1.{
    LinuxWorkspaceSourceOwnerV1, LinuxAgentWorkspaceStageTurnV1}
use std.common.contracts.container.execution_v2.ContainerRequestProjectionV2
use std.common.contracts.container.agent_executable_profile_v1.AgentExecutableProfileV1

pub class LinuxWorkspaceSourceLoanV3:
    owner: LinuxWorkspaceSourceOwnerV1

    pub fn agent_invocation_projection_v2(request_bytes: text, manifest_bytes: text,
            invocation_digest: text) -> Result<ContainerRequestProjectionV2, text>:
        self.owner.agent_invocation_projection_v2(request_bytes, manifest_bytes, invocation_digest)

    pub fn agent_invocation_program_match_v2(request_bytes: text, manifest_bytes: text,
            invocation_digest: text, agent_program: text, image_config_id: text) -> Result<bool, text>:
        self.owner.agent_invocation_program_match_v2(request_bytes, manifest_bytes,
            invocation_digest, agent_program, image_config_id)

    pub fn agent_executable_profile_v2(request_bytes: text, manifest_bytes: text,
            invocation_digest: text) -> Result<AgentExecutableProfileV1, text>:
        self.owner.agent_executable_profile_v2(request_bytes, manifest_bytes, invocation_digest)

    pub fn stage_agent_invocation_v2(request_bytes: text, manifest_bytes: text,
            invocation_digest: text, invocation_bytes: text) -> LinuxWorkspaceSourceLoanStageTurnV3:
        val staged: LinuxAgentWorkspaceStageTurnV1 = self.owner.stage_agent_invocation_v2(
            request_bytes, manifest_bytes, invocation_digest, invocation_bytes)
        # Capture returned custody before examining outcome fields. A failure
        # may still own cleanup progress and must remain reachable by the loan.
        val loan = LinuxWorkspaceSourceLoanV3(owner: staged.owner)
        LinuxWorkspaceSourceLoanStageTurnV3(loan: loan, ready: staged.ready,
            effect_attempted: staged.effect_attempted, error: staged.error)

pub struct LinuxWorkspaceSourceLoanStageTurnV3:
    loan: LinuxWorkspaceSourceLoanV3
    ready: bool
    effect_attempted: bool
    error: text

pub fn linux_workspace_source_loan_v3(actual: LinuxWorkspaceSourceOwnerV1) -> LinuxWorkspaceSourceLoanV3:
    LinuxWorkspaceSourceLoanV3(owner: actual)
