use std.nogc_sync_mut.container.machine_fresh_workload_lifecycle_v2.MachineFreshWorkloadActionResultV2
use std.nogc_sync_mut.io.machine_local_process_principal_v1.MachineLocalProcessPrincipalV1
use std.nogc_sync_mut.io.linux_container_containment_v1.LinuxContainerContainmentPopulationV1
