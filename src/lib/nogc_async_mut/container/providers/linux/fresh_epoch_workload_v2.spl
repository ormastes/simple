use std.nogc_sync_mut.io.linux_service_native_identity_v3.LinuxServiceNativeIdentityBorrowV3
use std.nogc_sync_mut.container.machine_fresh_epoch_record_v1.MachineFreshEpochRecordV1

pub class LinuxFreshWorkloadOwnerV2:
    transfer: MachineFreshWorkloadTransferV2
    # Scoped loan: caller retains ownership/cleanup of this genuine principal.
    # Its actual native handle is retained and rechecked before each admission.
    principal: Option<MachineLocalProcessPrincipalV1>
    template: GroupProcessStreamLaunchV2
    workspace_root: Option<LinuxWorkspaceRootBorrowV3> = nil

    pub fn scope_v2() -> Result<ContainerHostScopeV2, text>:
        if val principal = self.principal:
            val authenticated = principal.current_v1()?
        else:
            val authenticated = self.transfer.validate_owned_principal_v3()?
        self.transfer.scope_v2()

    pub fn observation_v2() -> Result<ContainerHostObservationV2, text>:
        val scope = self.scope_v2()?
        val epoch = self.transfer.current_v2()?
        val host = self.transfer.host_context_v2()?
        Ok(ContainerHostObservationV2(backend: "linux-podman", native_machine_id: host.native_machine_id,
            native_boot_id: host.native_boot_id, provider_identity_digest: epoch.provider_identity_digest,
            execution_os: "linux", architecture: host.architecture,
            continuity_assurance: "native-boot-incarnation-v1", boot_observation: ""))

    pub fn project_v2(request: ContainerExecutionRequestV2) -> Result<ContainerRequestProjectionV2, text>:
        if self.workspace_root.is_some(): return self.transfer.project_workspace_request_v3(request)
        val decoded = machine_fresh_workload_request_v2(self.scope_v2()?, request)?
        val retained = self.transfer.request_v2()
        if retained.is_ok() and retained.unwrap().request != request: return Err("machine-fresh-workload-request-changed")
        Ok(ContainerRequestProjectionV2(workload_uid: decoded.pod_uid, attempt: decoded.attempt,
            operation_id: decoded.operation_id, request_digest: request.plan.request_digest,
            cpu_millis: decoded.cpu_limit_millis, memory_bytes: decoded.memory_limit_bytes,
            timeout_ms: decoded.timeout_ms, has_devices: false, has_workspace: false))

    fn identity_v2(request: ContainerExecutionRequestV2) -> Result<RuntimeIdentityV1, text>:
        val projected = self.project_v2(request)?
        val scope = self.scope_v2()?
        Ok(RuntimeIdentityV1(pod_uid: request.plan.workload_uid, attempt: request.plan.attempt,
            provider_generation: scope.provider_generation, operation_id: request.plan.operation_id, engine: "podman",
            native_id: self.transfer.native_id_v2()?, node_boot_id: container_scope_fence_id_v2(scope)?))

    fn reply_v2(request: ContainerExecutionRequestV2, action: text, phase: text,
            result: MachineFreshWorkloadActionResultV2) -> Result<RuntimeOperationV1, text>:
        val identity = self.identity_v2(request)?
        Ok(RuntimeOperationV1(status: RUNTIME_STATUS_OK, operation: action,
            command: RuntimeCommandV1(action, result.program, result.arguments),
            state: RuntimeStateV1(phase, identity, -1, "actual-fresh-workload"),
            exit_code: result.exit_code, stdout: result.output, stderr: "", reason: "actual-fresh-workload"))

    fn refused_v2(action: text, reason: text) -> RuntimeOperationV1:
        var operation = runtime_operation_empty()
        operation.operation = action
        operation.command.operation = action
        operation.reason = reason
        operation.state.reason = reason
        operation

    fn done_v2(action: LinuxFreshWorkloadActionV2) -> bool:
        val actual = self.transfer.operation_v2(action)
        actual.is_ok() and actual.unwrap().state == "completed"

    fn perform_v2(action: text, request: ContainerExecutionRequestV2,
            deadline: Option<ContainerEffectDeadlineV1>) -> Result<RuntimeOperationV1, text>:
        val projected = self.project_v2(request)?
        if action == "prepare" or action == "create":
            if self.principal.is_none(): return Err("linux-fresh-workspace-typed-action-required")
            val reserved = self.transfer.reserve_v2(self.principal.unwrap(), request, self.template)?
            if action == "prepare": return self.reply_v2(request, action, RUNTIME_PHASE_PREPARED,
                MachineFreshWorkloadActionResultV2(true, "", 0, ""))
            if not self.done_v2(LinuxFreshWorkloadActionV2.PullImage):
                val pulled = self.transfer.run_action_v2(LinuxFreshWorkloadActionV2.PullImage, deadline)?
            val created = self.transfer.run_action_v2(LinuxFreshWorkloadActionV2.Create, deadline)?
            # A genuine successful created-config query, not a caller bool,
            # completes the private prerequisite for Start's once-only permit.
            val checked = self.transfer.verify_created_v2()?
            val correlated = self.configuration_v2("configuration", request)?
            return self.reply_v2(request, action, RUNTIME_PHASE_CREATED, created)
        val reserved = self.transfer.request_v2()?
        if reserved.request != request: return Err("machine-fresh-workload-request-changed")
        if action == "start":
            val started = self.transfer.run_action_v2(LinuxFreshWorkloadActionV2.Start, deadline)?
            val before = self.transfer.run_action_v2(LinuxFreshWorkloadActionV2.Inspect)?
            val associated = self.transfer.associate_v2()?
            val native = self.transfer.subject_v2()?
            if native.state != LinuxContainerContainmentPopulationV1.Populated: return Err("machine-fresh-workload-running-unproven")
            return self.reply_v2(request, action, RUNTIME_PHASE_RUNNING, started)
        if action == "stop":
            val stopped = self.transfer.run_action_v2(LinuxFreshWorkloadActionV2.Stop)?
            val native = self.transfer.subject_v2()?
            if native.state != LinuxContainerContainmentPopulationV1.EmptySnapshot: return Err("machine-fresh-workload-stop-unproven")
            return self.reply_v2(request, action, RUNTIME_PHASE_STOPPED, stopped)
        if action == "destroy":
            if not self.done_v2(LinuxFreshWorkloadActionV2.Stop):
                val stopped = self.transfer.run_action_v2(LinuxFreshWorkloadActionV2.Stop)?
            var removed = MachineFreshWorkloadActionResultV2(true, "", 0, "")
            if not self.done_v2(LinuxFreshWorkloadActionV2.Remove): removed = self.transfer.run_action_v2(LinuxFreshWorkloadActionV2.Remove)?
            if not self.done_v2(LinuxFreshWorkloadActionV2.Absence):
                val absent = self.transfer.run_action_v2(LinuxFreshWorkloadActionV2.Absence)?
            val settled = self.transfer.settle_v2()?
            return self.reply_v2(request, action, RUNTIME_PHASE_DESTROYED, removed)
        Err("linux-fresh-workload-action-unsupported")

    pub fn apply_v2(action: text, request: ContainerExecutionRequestV2,
            deadline: Option<ContainerEffectDeadlineV1> = nil) -> RuntimeOperationV1:
        match self.perform_v2(action, request, deadline):
            case Ok(operation): operation
            case Err(reason): self.refused_v2(action, reason)

    fn configuration_v2(action: text, request: ContainerExecutionRequestV2) -> Result<RuntimeOperationV1, text>:
        val projected = self.project_v2(request)?
        val record = self.transfer.request_v2()?
        if record.request != request: return Err("machine-fresh-workload-request-changed")
        val input = action == "input-configuration"
        val before_kind = if input: LinuxFreshWorkloadActionV2.InputConfigurationBefore else: LinuxFreshWorkloadActionV2.ConfigurationBefore
        val image_kind = if input: LinuxFreshWorkloadActionV2.InputConfigurationImage else: LinuxFreshWorkloadActionV2.ConfigurationImage
        val after_kind = if input: LinuxFreshWorkloadActionV2.InputConfigurationAfter else: LinuxFreshWorkloadActionV2.ConfigurationAfter
        # Three real, separately consumed same-writer actions. Image identity is
        # derived privately from the first actual container result by transfer.
        val before = self.transfer.run_action_v2(before_kind)?
        val image = self.transfer.run_action_v2(image_kind)?
        val after = self.transfer.run_action_v2(after_kind)?
        val observation = self.transfer.configuration_v2(after_kind)?
        val retained = self.intent_v2(request)?
        self.reply_v2(request, action, retained.phase,
            MachineFreshWorkloadActionResultV2(true, observation, 0, "", after.program, after.arguments))

    # Caller-principal workloads re-authenticate that caller; installed owners
    # (principal None) revalidate the transfer's own installed local principal.
    fn stats_principal_v1() -> Result<Option<MachineLocalPrincipalSnapshotV1>, text>:
        if val principal = self.principal: return Ok(Some(principal.current_v1()?))
        val owned = self.transfer.validate_owned_principal_v3()?
        Ok(None)

    pub fn stats_v1(request: ContainerExecutionRequestV2) -> Result<ContainerExecutionStatsObservationV1, text>:
        val principal = self.stats_principal_v1()?
        if self.transfer.request_projection_v3()? != request: return Err("container-stats-original-request-changed")
        val scope = self.scope_v2()?
        val counters = self.transfer.stats_v1()?
        val actual = RuntimeIdentityV1(pod_uid: request.plan.workload_uid, attempt: request.plan.attempt,
            provider_generation: scope.provider_generation, operation_id: request.plan.operation_id, engine: "podman",
            native_id: self.transfer.native_id_v2()?, node_boot_id: container_scope_fence_id_v2(scope)?)
        if self.stats_principal_v1()? != principal or self.transfer.request_projection_v3()? != request:
            return Err("container-stats-caller-or-request-changed")
        val observation = ContainerExecutionStatsObservationV1(scope: scope, runtime: actual,
            request_digest: request.plan.request_digest, source: "linux-cgroup2-original-container-root-and-descendants-v1",
            subject_identity_digest: counters.subject_identity_digest,
            sample_started_monotonic_ns: counters.sample_started_monotonic_ns,
            sample_finished_monotonic_ns: counters.sample_finished_monotonic_ns,
            cpu_usage_usec: counters.cpu_usage_usec, memory_current_bytes: counters.memory_current_bytes,
            pids_current: counters.pids_current, io: counters.io)
        container_execution_stats_observation_validate_v1(observation)?
        Ok(observation)

    pub fn read_v2(action: text, request: ContainerExecutionRequestV2) -> RuntimeOperationV1:
        if action == "configuration" or action == "input-configuration":
            val observed = self.configuration_v2(action, request)
            return if observed.is_ok(): observed.unwrap() else: self.refused_v2(action, observed.unwrap_err())
        if action != "inspect": return self.refused_v2(action, "linux-fresh-workload-read-action-unsupported:" + action)
        val checked = self.project_v2(request)
        if checked.is_err(): return self.refused_v2(action, checked.unwrap_err())
        if self.transfer.settled_v2().is_ok() and self.transfer.settled_v2().unwrap():
            val reply = self.reply_v2(request, action, RUNTIME_PHASE_DESTROYED, MachineFreshWorkloadActionResultV2(true, "", 0, ""))
            return if reply.is_ok(): reply.unwrap() else: self.refused_v2(action, reply.unwrap_err())
        val native = self.transfer.subject_v2()
        if native.is_err(): return self.refused_v2(action, native.unwrap_err())
        val phase = if native.unwrap().state == LinuxContainerContainmentPopulationV1.Populated: RUNTIME_PHASE_RUNNING else: RUNTIME_PHASE_EXITED
        val reply = self.reply_v2(request, action, phase, MachineFreshWorkloadActionResultV2(true, "", 0, ""))
        if reply.is_ok(): reply.unwrap() else: self.refused_v2(action, reply.unwrap_err())

    pub fn intent_v2(request: ContainerExecutionRequestV2) -> Result<RuntimeIntentV1, text>:
        val actual = self.identity_v2(request)?
        var phase = RUNTIME_PHASE_PREPARED
        if self.done_v2(LinuxFreshWorkloadActionV2.Create): phase = RUNTIME_PHASE_CREATED
        if self.transfer.settled_v2()?: phase = RUNTIME_PHASE_DESTROYED
        elif self.done_v2(LinuxFreshWorkloadActionV2.Start):
            val native = self.transfer.subject_v2()?
            if self.done_v2(LinuxFreshWorkloadActionV2.Stop):
                if native.state != LinuxContainerContainmentPopulationV1.EmptySnapshot: return Err("machine-fresh-workload-stop-unproven")
                phase = RUNTIME_PHASE_STOPPED
            else:
                if native.state != LinuxContainerContainmentPopulationV1.Populated: return Err("machine-fresh-workload-running-unproven")
                phase = RUNTIME_PHASE_RUNNING
        Ok(RuntimeIntentV1(actual.pod_uid, actual.attempt, actual.provider_generation, actual.operation_id,
            actual.engine, actual.native_id, actual.node_boot_id, phase))

    pub fn recover_v2(request: ContainerExecutionRequestV2, expected: RuntimeIntentV1) -> RuntimeOperationV1:
        val retained = self.intent_v2(request)
        if retained.is_err(): return self.refused_v2("recover", retained.unwrap_err())
        if retained.unwrap() != expected: return self.refused_v2("recover", "machine-fresh-workload-recovery-binding")
        # No new preparation, second writer, adoption by label or retry spawn.
        self.read_v2("inspect", request)

    # Admission of the real installed lease happens here, never in wire DTOs.
    # Canonical source phase is latched BEFORE quota/source effects; copied
    # startup aliases therefore cannot admit a second lease or close its writer.
    pub fn workspace_source_open_installed_v3(request: ContainerExecutionRequestV2) -> LinuxFreshWorkspaceSourceTurnV3:
        var retained = self
        if self.workspace_root.is_none():
            return LinuxFreshWorkspaceSourceTurnV3(retained, nil, false, "linux-workspace-installed-root-required")
        val authenticated = self.scope_v2()
        if authenticated.is_err(): return LinuxFreshWorkspaceSourceTurnV3(retained, nil, false, authenticated.unwrap_err())
        val opened = self.transfer.open_workspace_source_installed_v3(self.workspace_root.unwrap(), request)
        LinuxFreshWorkspaceSourceTurnV3(retained, opened.source, false, opened.error)

    pub fn cleanup_workspace_source_v3() -> LinuxFreshWorkspaceSourceCleanupTurnV3:
        val closed = self.transfer.cleanup_workspace_source_v3()
        if closed.is_err(): return LinuxFreshWorkspaceSourceCleanupTurnV3(self, false, true, closed.unwrap_err())
        val diagnostic = self.transfer.workspace_cleanup_diagnostic_v3()
        LinuxFreshWorkspaceSourceCleanupTurnV3(self, closed.unwrap(), not closed.unwrap(),
            if diagnostic.is_ok(): diagnostic.unwrap() else: diagnostic.unwrap_err())

    pub fn enable_workspace_v3(request: ContainerExecutionRequestV2, manifest_bytes: text,
            invocation_digest: text, full_invocation_source: text) -> LinuxFreshWorkspaceEnableTurnV3:
        val enabled = self.transfer.enable_workspace_source_v3(request, manifest_bytes, invocation_digest,
            full_invocation_source, self.template)
        LinuxFreshWorkspaceEnableTurnV3(self, if enabled.is_err(): enabled.unwrap_err() else: "")

    pub fn workspace_primary_observe_v3(request: ContainerExecutionRequestV2) -> LinuxFreshWorkspacePrimaryObserveTurnV3:
        val original = self.transfer.request_projection_v3()
        if original.is_err(): return LinuxFreshWorkspacePrimaryObserveTurnV3(self, nil, false, original.unwrap_err())
        if original.unwrap() != request: return LinuxFreshWorkspacePrimaryObserveTurnV3(self, nil, false, "machine-fresh-workspace-request-changed")
        val actual = self.transfer.observe_workspace_primary_v3()
        val observed = if actual.observation.is_some(): Some(ContainerWorkspacePrimaryObservationV3(owner: self)) else: nil
        LinuxFreshWorkspacePrimaryObserveTurnV3(self, observed, actual.pending, actual.error)

    # V3 probes are CPU-workload-only. The canonical transfer validates the
    # request before its live gate, preserving cleanup after uncertain effects.
    pub fn probe_v3(request: ContainerExecutionRequestV2, call: MachineFreshProbeCallV3) -> MachineFreshProbeReplyV3:
        match call:
            case MachineFreshProbeCallV3.Select(embedded, provider, index):
                if embedded != request: return machine_fresh_probe_rejected_v3(call, "machine-probe-original-request-mismatch")
                val actual = self.prepare_probe_request_v3(request, provider, index)
                if actual.is_err(): return machine_fresh_probe_rejected_v3(call, actual.unwrap_err())
            case _: pass
        self.transfer.probe_v3(request, call)

    fn prepare_probe_request_v3(request: ContainerExecutionRequestV2, provider: ProviderCliProviderV1, index: i64) -> Result<(), text>:
        val valid = machine_fresh_probe_request_validate_v3(self.scope_v2()?, request, provider, index)?
        if self.principal.is_some():
            val reserved = self.transfer.reserve_v2(self.principal.unwrap(), request, self.template)?
        else:
            val reserved = self.transfer.reserve_owned_v3(request, self.template)?
        Ok(())

    pub fn workspace_begin_v3(action: ContainerWorkspaceActionV3, request: ContainerExecutionRequestV2,
            deadline: Option<ContainerEffectDeadlineV1> = nil) -> LinuxFreshWorkspaceActionTurnV3:
        val begun = self.transfer.begin_workspace_action_v3(action, request, deadline)
        if begun.is_err(): return LinuxFreshWorkspaceActionTurnV3(self, nil, false, begun.unwrap_err())
        # Publishing this cursor is not process/runtime completion. The next
        # bounded step performs at most one admitted helper spawn or read/poll.
        LinuxFreshWorkspaceActionTurnV3(self, nil, true, "")

    pub fn workspace_step_v3(request: ContainerExecutionRequestV2) -> LinuxFreshWorkspaceActionTurnV3:
        val stepped = self.transfer.step_workspace_action_v3(request)
        if stepped.is_err(): return LinuxFreshWorkspaceActionTurnV3(self, nil, false, stepped.unwrap_err())
        LinuxFreshWorkspaceActionTurnV3(self, stepped.unwrap(), stepped.unwrap().is_none(), "")

    pub fn workspace_cancel_pending_v3(request: ContainerExecutionRequestV2) -> LinuxFreshWorkspaceActionTurnV3:
        val cancelled = self.transfer.cancel_workspace_pending_v3(request)
        if cancelled.is_err(): return LinuxFreshWorkspaceActionTurnV3(self, nil, true, cancelled.unwrap_err())
        LinuxFreshWorkspaceActionTurnV3(self, nil, not cancelled.unwrap(), "")

    pub fn primary_attach_plan_v3(request: ContainerExecutionRequestV2, expected: RuntimeIdentityV1,
            identity: ContainerOutputIdentityV2, policy: ContainerStreamPolicyV2,
            resources: ContainerOutputResourcesV2, terminal_mode: text) -> Result<ContainerPrimaryAttachPlanV1, text>:
        if self.workspace_root.is_none(): return Err("linux-fresh-workload-legacy-operation-unavailable")
        match self.transfer.primary_v3(MachineWorkspacePrimaryCallV3.Plan(request, expected, identity, policy, resources, terminal_mode)):
            case MachineWorkspacePrimaryReplyV3.Plan(actual): actual
            case _: Err("workspace-primary-plan-turn-mismatch")

    pub fn open_primary_attach_v3(request: ContainerExecutionRequestV2, expected: RuntimeIdentityV1,
            plan: ContainerPrimaryAttachPlanV1, helper: ContainerHelperAdmissionV2,
            policy: ContainerStreamPolicyV2) -> ContainerPrimaryOpenResultV1:
        # milestone_0022 N3 (16): no workspace root = refused before the provider call.
        if self.workspace_root.is_none():
            return ContainerPrimaryOpenResultV1(spawn: PipedProcessOwnedSpawnV2.Rejected("linux-fresh-workload-legacy-operation-unavailable"),
                refusal: ContainerPrimaryOpenRefusalV1.NoCustody)
        match self.transfer.primary_v3(MachineWorkspacePrimaryCallV3.Open(request, expected, plan, helper, policy)):
            case MachineWorkspacePrimaryReplyV3.Spawn(actual): actual
            # Not provably pre-spawn (16): typed CustodyAdvanced, never authorizes R.
            case _: ContainerPrimaryOpenResultV1(spawn: PipedProcessOwnedSpawnV2.Rejected("workspace-primary-spawn-turn-mismatch"),
                refusal: ContainerPrimaryOpenRefusalV1.CustodyAdvanced("turn-mismatch"))

    pub fn primary_session_handoff_v3(session: ContainerPrimaryAttachSessionV1) -> Result<(), text>:
        match self.transfer.primary_v3(MachineWorkspacePrimaryCallV3.SessionLoaned(session)):
            case MachineWorkspacePrimaryReplyV3.Completion(actual): actual
            case _: Err("workspace-primary-handoff-turn-mismatch")

    pub fn primary_construction_failed_v3(actual: PipedProcessOwnedTransferV2) -> Result<(), text>:
        match self.transfer.primary_v3(MachineWorkspacePrimaryCallV3.ConstructionFailed(actual)):
            case MachineWorkspacePrimaryReplyV3.Completion(result): result
            case _: Err("workspace-primary-construction-turn-mismatch")

    pub fn primary_session_return_v3(session: ContainerPrimaryAttachSessionV1) -> Result<(), text>:
        match self.transfer.primary_v3(MachineWorkspacePrimaryCallV3.SessionReturn(session)):
            case MachineWorkspacePrimaryReplyV3.Completion(actual): actual
            case _: Err("workspace-primary-return-turn-mismatch")

    pub fn primary_session_binding_v3(session: ContainerPrimaryAttachSessionV1) -> Result<ContainerPrimarySessionBindingV3, text>:
        container_primary_session_binding_v3(self.transfer, session)

    pub fn primary_retirement_v3() -> Result<ContainerPrimaryTransportRetirementV3, text>:
        container_primary_transport_retirement_v3(self.transfer)

    pub fn primary_attach_cleanup_v3() -> Result<(), text>:
        match self.transfer.primary_v3(MachineWorkspacePrimaryCallV3.FallbackCleanup):
            case MachineWorkspacePrimaryReplyV3.Completion(actual): actual
            case _: Err("workspace-primary-cleanup-turn-mismatch")

    # ---- milestone_0021 V4 twins (3.3): each delegates to the same transfer method; values are returned. ----
    pub fn epoch_current_v3() -> Result<MachineFreshEpochRecordV1, text>: self.transfer.epoch_current_v3()
    pub fn helper_dirs_v3() -> Result<[text], text>: self.transfer.helper_dirs_v3()
    pub fn validate_helper_template_v3(template: GroupProcessStreamLaunchV2) -> Result<(), text>:
        self.transfer.validate_helper_template_v3(template)

    # 3.7 step 2: the workspace-root loan leaves the owner before the workload close (the close retires the R3
    # the borrow aliases). After this the V7 close_v2 source cleanup branch no longer runs for this owner.
    pub fn take_workspace_root_v3() -> LinuxFreshAgentTurnV3:
        var retained = self
        val root = retained.workspace_root
        retained.workspace_root = None
        if root.is_none(): return LinuxFreshAgentTurnV3(owner: retained, error: "linux-workspace-installed-root-required")
        LinuxFreshAgentTurnV3(owner: retained, root: root)

    pub fn end_workspace_root_loan_v3(root: LinuxWorkspaceRootBorrowV3) -> LinuxFreshAgentTurnV3:
        var retained = self
        val ended = retained.transfer.end_workspace_root_loan_v3(root)
        retained.transfer = ended.owner
        LinuxFreshAgentTurnV3(owner: retained, root: ended.root, error: ended.error)

    pub fn end_service_loan_v3(native: LinuxServiceNativeIdentityBorrowV3) -> LinuxFreshAgentTurnV3:
        var retained = self
        val ended = retained.transfer.end_service_loan_v3(native)
        retained.transfer = ended.owner
        LinuxFreshAgentTurnV3(owner: retained, native: ended.native, error: ended.error)

    pub fn adopt_lent_workspace_reader_v3() -> LinuxFreshAgentTurnV3:
        var retained = self
        val adopted = retained.transfer.adopt_lent_workspace_reader_v3()
        retained.transfer = adopted.owner
        LinuxFreshAgentTurnV3(owner: retained, error: adopted.error)

    pub fn advance_workload_v3() -> LinuxFreshAgentTurnV3:
        var retained = self
        val advanced = retained.transfer.advance_workload_v3()
        retained.transfer = advanced.owner
        LinuxFreshAgentTurnV3(owner: retained, error: advanced.error)

    pub fn settle_workspace_v3() -> Result<(), text>: self.transfer.settle_workspace_v3()
    pub fn released_charge_digest_v3() -> Result<text, text>: self.transfer.released_charge_digest_v3()
    pub fn return_settled_workspace_source_v3() -> Result<bool, text>: self.transfer.return_settled_workspace_source_v3()
    pub fn close_workload_v3() -> Result<(), text>: self.transfer.close_workload_v3()

    # 3.4 step 4: the per-lifecycle helper root (pinned prefix + nonce + workload index), allowed only while the
    # current lifecycle holds no record. Only `root` changes; the record bytes do not include it.
    pub fn set_lifecycle_root_v3(root: text) -> LinuxFreshAgentTurnV3:
        var retained = self
        val checked = retained.transfer.lifecycle_root_check_v3(root)
        if checked.is_err(): return LinuxFreshAgentTurnV3(owner: retained, error: checked.unwrap_err())
        retained.template.root = root
        LinuxFreshAgentTurnV3(owner: retained)

    pub fn close_v2() -> LinuxFreshWorkloadCloseTurnV2:
        if self.workspace_root.is_some():
            # Resolve the canonical acquisition obligation, including one
            # created by another value-copy. This cannot clear staged/runtime
            # source custody or refund a quota whose absence is unproven.
            val source_cleanup = self.transfer.cleanup_workspace_source_v3()
        val closed = self.transfer.close_v2()
        var retained = self
        if val actual = closed.owner: retained.transfer = actual
        if not closed.closed or closed.owner.is_some(): return LinuxFreshWorkloadCloseTurnV2(Some(retained), false, closed.error)
        LinuxFreshWorkloadCloseTurnV2(nil, true, closed.error)

pub struct LinuxFreshAgentTurnV3:
    owner: LinuxFreshWorkloadOwnerV2
    root: Option<LinuxWorkspaceRootBorrowV3> = None
    native: Option<LinuxServiceNativeIdentityBorrowV3> = None
    error: text = ""

# milestone_0021 3.3, steps 1-3 of the V4 lent factory. It opens NO epoch, reader, storage or admission: it
# borrows the V4 service's ONE admission. Step 4 (adapter + tagged owner) is simple_container_open_lent_v4 in
# api_v2 because the adapter imports this module. Every failure returns the actual owner: the admission before
# the transfer, the fresh owner after it; the root loan (and a never-adopted R3) is ended before returning, and a
# refused end hands the root back in `root`.
pub struct LinuxWorkspaceRootOpenV4:
    fresh: Option<LinuxFreshWorkloadOwnerV2> = None
    root: Option<LinuxWorkspaceRootBorrowV3> = None
    admission_cleanup: Option<MachineFreshEpochAdmissionOwnerV1> = None
    error: text = ""

pub fn linux_workspace_root_open_lent_v4(admission: MachineFreshEpochAdmissionOwnerV1,
        native: LinuxServiceNativeIdentityBorrowV3, template: GroupProcessStreamLaunchV2) -> LinuxWorkspaceRootOpenV4:
    val lent = admission.lend_workspace_root_v1()
    if lent.error != "" or lent.root.is_none():
        return LinuxWorkspaceRootOpenV4(admission_cleanup: Some(lent.owner), error: lent.error)
    val root = lent.root.unwrap()
    val transferred = lent.owner.transfer_workload_lent_v3(native)
    if transferred.owner.is_none():
        # P2R1-F6: unreachable today (transfer_workload_lent_v3 returns Some(retained) on every refusal). If it is
        # ever reached the admission is lost; the root is kept for the caller's loan end and the error is never empty.
        if transferred.retained.is_none():
            return LinuxWorkspaceRootOpenV4(root: Some(root),
                error: if transferred.error != "": transferred.error else: "machine-fresh-lent-transfer-admission-lost")
        val retained = transferred.retained.unwrap()
        val ended = retained.end_workspace_root_loan_v1(root)
        val kept = if ended.error != "": ended.root else: None
        return LinuxWorkspaceRootOpenV4(root: kept, admission_cleanup: Some(ended.owner), error: transferred.error)
    # R3 stays in transfer.admission.workspace_reader until stage `source` adopts it into the AGENT lifecycle.
    val fresh = LinuxFreshWorkloadOwnerV2(transfer: transferred.owner.unwrap(), principal: None, template: template,
        workspace_root: Some(root))
    if transferred.error != "":
        return linux_workspace_root_open_fresh_failed_v4(fresh, transferred.error)
    LinuxWorkspaceRootOpenV4(fresh: Some(fresh))

# Post-transfer failure (T-06): the root leaves the fresh owner and its loan ends on the transfer; the fresh owner
# is the cleanup holder (`agent.fresh`), closed later through close_workload_v3's never-reserved branch.
pub fn linux_workspace_root_open_fresh_failed_v4(fresh: LinuxFreshWorkloadOwnerV2, reason: text) -> LinuxWorkspaceRootOpenV4:
    val taken = fresh.take_workspace_root_v3()
    if taken.root.is_none(): return LinuxWorkspaceRootOpenV4(fresh: Some(taken.owner), error: reason)
    val ended = taken.owner.end_workspace_root_loan_v3(taken.root.unwrap())
    LinuxWorkspaceRootOpenV4(fresh: Some(ended.owner), root: if ended.error != "": ended.root else: None, error: reason)

pub struct LinuxFreshWorkloadCloseTurnV2:
    owner: Option<LinuxFreshWorkloadOwnerV2>
    closed: bool
    error: text

# Only a genuine sealed transfer is accepted; no DATA factory or raw writer.
pub fn linux_fresh_workload_owner_v2(transfer: MachineFreshWorkloadTransferV2,
        principal: MachineLocalProcessPrincipalV1, template: GroupProcessStreamLaunchV2) -> LinuxFreshWorkloadOwnerV2:
    LinuxFreshWorkloadOwnerV2(transfer: transfer, principal: Some(principal), template: template)

pub struct LinuxFreshWorkspaceSourceTurnV3:
    owner: LinuxFreshWorkloadOwnerV2
    source: Option<LinuxWorkspaceSourceLoanV3>
    pending: bool
    error: text

pub struct LinuxFreshWorkspaceEnableTurnV3:
    owner: LinuxFreshWorkloadOwnerV2
    error: text

# Acquisition is closed over installed native owners. The only raw storage
# value is a private borrowed alias of the ONE writer wrapped below.
pub struct LinuxWorkspaceRootOpenV3:
    owner: Option<LinuxFreshWorkloadOwnerV2> = nil
    fresh_cleanup: Option<LinuxFreshWorkloadOwnerV2> = nil
    admission_cleanup: Option<MachineFreshEpochAdmissionTurnV1> = nil
    reader_cleanup: Option<LinuxMachinePolicyOwnerV1> = nil
    error: text = ""

pub fn linux_workspace_root_open_installed_v3(template: GroupProcessStreamLaunchV2) -> LinuxWorkspaceRootOpenV3:
    var retained = LinuxWorkspaceRootOpenV3()
    var acquisition = MachineFreshEpochAdmissionTurnV1()
    val epoch = match linux_installed_fresh_epoch_open_v1():
        case LinuxFreshEpochOpenV1.Rejected(reason):
            retained.error = reason
            return retained
        case LinuxFreshEpochOpenV1.CleanupRequired(owner, reason):
            acquisition.preparation = Some(owner)
            acquisition.error = reason
            retained.admission_cleanup = Some(acquisition)
            retained.error = reason
            return retained
        case LinuxFreshEpochOpenV1.Ready(owner): owner
    acquisition.preparation = Some(epoch)
    retained.admission_cleanup = Some(acquisition)
    val reader = match linux_machine_policy_open_v1():
        case LinuxMachinePolicyOpenV1.Rejected(reason):
            retained.error = reason
            return retained
        case LinuxMachinePolicyOpenV1.CleanupRequired(owner, reason):
            acquisition.cleanup = Some(MachineContainerAuthorityCleanupV1.LinuxReaderV3(owner))
            retained.admission_cleanup = Some(acquisition)
            retained.error = reason
            return retained
        case LinuxMachinePolicyOpenV1.Ready(owner): owner
    acquisition.cleanup = Some(MachineContainerAuthorityCleanupV1.LinuxReaderV3(reader))
    retained.admission_cleanup = Some(acquisition)
    val storage = match reader.open_storage_v1():
        case LinuxMachineStorageOpenV1.Rejected(reason):
            retained.error = reason
            return retained
        case LinuxMachineStorageOpenV1.CleanupRequired(owner, reason):
            acquisition.cleanup = Some(MachineContainerAuthorityCleanupV1.LinuxStorageV3(owner))
            retained.admission_cleanup = Some(acquisition)
            retained.error = reason
            return retained
        case LinuxMachineStorageOpenV1.Ready(owner): owner
    # Successful native storage acquisition transfers the first reader.
    acquisition.cleanup = Some(MachineContainerAuthorityCleanupV1.LinuxStorageV3(storage))
    retained.admission_cleanup = Some(acquisition)
    val source_reader = match linux_machine_policy_open_v1():
        case LinuxMachinePolicyOpenV1.Rejected(reason):
            retained.error = reason
            return retained
        case LinuxMachinePolicyOpenV1.CleanupRequired(owner, reason):
            retained.reader_cleanup = Some(owner)
            retained.error = reason
            return retained
        case LinuxMachinePolicyOpenV1.Ready(owner): owner
    retained.reader_cleanup = Some(source_reader)
    val borrowed = linux_workspace_root_borrow_v3(source_reader, storage)
    # Protected opt-in V2 profiles are checked BEFORE the first machine write.
    val profiles = borrowed.validate_profiles_v3()
    if profiles.is_err():
        retained.error = profiles.unwrap_err()
        return retained
    val wrapped = machine_storage_from_linux_v3(storage)
    if wrapped.owner.is_none():
        if val actual = wrapped.retained:
            acquisition.cleanup = Some(MachineContainerAuthorityCleanupV1.LinuxStorageV3(actual))
        retained.admission_cleanup = Some(acquisition)
        retained.error = wrapped.error
        return retained
    # From this point only the facade owns cleanup. Borrowed retains no close.
    acquisition.cleanup = nil
    val admitted = machine_container_authority_open_prepared_workspace_v3(wrapped.owner.unwrap(), epoch)
    retained.admission_cleanup = Some(admitted)
    if admitted.owner.is_none() or admitted.error != "":
        retained.error = admitted.error
        return retained
    val transferred = admitted.owner.unwrap().transfer_workload_v2()
    if transferred.owner.is_none():
        var pending = admitted
        pending.owner = transferred.retained
        retained.admission_cleanup = Some(pending)
        retained.error = transferred.error
        return retained
    var actual = LinuxFreshWorkloadOwnerV2(transfer: transferred.owner.unwrap(), principal: nil,
        template: template, workspace_root: Some(borrowed))
    # The transfer canonically invalidated startup aliases. Cleanup now belongs
    # only to this genuine transfer, never the old admission value-copy.
    retained.admission_cleanup = nil
    retained.fresh_cleanup = Some(actual)
    if transferred.error != "":
        retained.error = transferred.error
        return retained
    val adopted = actual.transfer.adopt_workspace_reader_v3(source_reader)
    actual.transfer = adopted.owner
    retained.reader_cleanup = adopted.retained_reader
    retained.fresh_cleanup = Some(actual)
    if adopted.error != "":
        retained.error = adopted.error
        return retained
    val authenticated = actual.scope_v2()
    if authenticated.is_err():
        val blocked = actual.transfer.restrict_workspace_startup_v3(authenticated.unwrap_err())
        retained.error = authenticated.unwrap_err()
        return retained
    retained.owner = Some(actual)
    retained.fresh_cleanup = nil
    retained

pub struct LinuxFreshWorkspaceSourceCleanupTurnV3:
    owner: LinuxFreshWorkloadOwnerV2
    source_returned: bool
    pending: bool
    error: text

pub struct LinuxFreshWorkspaceActionTurnV3:
    owner: LinuxFreshWorkloadOwnerV2
    operation: Option<RuntimeOperationV1>
    pending: bool
    error: text

# Borrowed real-owner observation. No snapshot constructor grants AgentObserved;
# each current call reobserves the original canonical native subject/custody.
pub class ContainerWorkspacePrimaryObservationV3:
    owner: LinuxFreshWorkloadOwnerV2

    pub fn current_v3() -> Result<LinuxFreshWorkspacePrimaryObservationV3, text>:
        val actual = self.owner.transfer.observe_workspace_primary_v3()
        if actual.error != "": return Err(actual.error)
        if actual.pending or actual.observation.is_none(): return Err("linux-workspace-primary-observation-pending")
        Ok(actual.observation.unwrap())

pub struct LinuxFreshWorkspacePrimaryObserveTurnV3:
    owner: LinuxFreshWorkloadOwnerV2
    observation: Option<ContainerWorkspacePrimaryObservationV3>
    pending: bool
    error: text
