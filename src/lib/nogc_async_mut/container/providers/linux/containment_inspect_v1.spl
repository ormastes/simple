# Inspect configuration observation only, not native capability/lifetime proof.
# Podman v5.2.5 define/container_inspect.go 240b09...; container_inspect.go ef4bac... .
use std.common.contracts.container.runtime_v1.{RuntimeCommandV1, RuntimeIdentityV1}
use std.common.build_manager.contracts.builder_digest_valid_v1
use std.common.string_core.str_len
use std.common.json.value.{JsonValue, json_value_get, json_value_as_text, json_value_keys}
use std.nogc_async_mut.container.providers.linux.execution_user_v2.linux_oci_flat_inspect_json_v2
use std.nogc_async_mut.container.providers.linux.request_v1.*
use std.nogc_async_mut.container.providers.linux.containment_profile_v1.*

pub struct LinuxOciContainmentInspectV1:
    pid: i64
    cgroup_path: text

pub fn linux_oci_containment_inspect_command_v1(native_id: text) -> Result<RuntimeCommandV1, text>:
    if not builder_digest_valid_v1(native_id): return Err("containment-full-native-id-required")
    val format = "{\"id\":{{json .Id}},\"pod_uid\":{{json (index .Config.Labels \"io.simpleorch.pod_uid\")}},\"attempt\":{{json (index .Config.Labels \"io.simpleorch.attempt\")}},\"node_boot_id\":{{json (index .Config.Labels \"io.simpleorch.node_boot_id\")}},\"provider_generation\":{{json (index .Config.Labels \"io.simpleorch.provider_generation\")}},\"operation_id\":{{json (index .Config.Labels \"io.simpleorch.operation_id\")}},\"pid\":{{json .State.Pid}},\"cgroup\":{{json .State.CgroupPath}},\"status\":{{json .State.Status}},\"runtime\":{{json .OCIRuntime}},\"manager\":{{json .HostConfig.CgroupManager}},\"cgroup_mode\":{{json .HostConfig.CgroupMode}},\"cgroups\":{{json .HostConfig.Cgroups}},\"pid_mode\":{{json .HostConfig.PidMode}},\"privileged\":{{json .HostConfig.Privileged}},\"effective_caps\":{{len .EffectiveCaps}},\"bounding_caps\":{{len .BoundingCaps}},\"no_new_privileges\":{{range .HostConfig.SecurityOpt}}{{if eq . \"no-new-privileges\"}}true{{end}}{{end}},\"readonly_rootfs\":{{json .HostConfig.ReadonlyRootfs}}}"
    Ok(RuntimeCommandV1(operation: "containment-inspect", program: "podman",
        args: ["container", "inspect", "--format", format, native_id]))

fn containment_inspect_field_v1(value: JsonValue, key: text) -> Result<JsonValue, text>:
    match json_value_get(value, key):
        case Some(found): Ok(found)
        case None: Err("containment-inspect-field-missing:" + key)

fn containment_inspect_text_v1(value: JsonValue, key: text) -> Result<text, text>:
    match json_value_as_text(containment_inspect_field_v1(value, key)?):
        case Some(found): Ok(found)
        case None: Err("containment-inspect-field-type:" + key)

pub fn linux_oci_containment_inspect_v1(raw: text, expected: RuntimeIdentityV1,
        request: LinuxOciRequestV1, profile: LinuxOciContainmentProfileV1) -> Result<LinuxOciContainmentInspectV1, text>:
    linux_oci_request_bounds_v1(request)?
    if (expected.engine != "podman" or not builder_digest_valid_v1(expected.native_id) or
            expected.pod_uid != request.pod_uid or expected.attempt != request.attempt or
            expected.operation_id != request.operation_id): return Err("containment-inspect-request-identity-mismatch")
    if (request.containment_profile_digest == "" or
            request.containment_profile_digest != linux_oci_containment_profile_digest_v1(profile)?):
        return Err("containment-inspect-profile-mismatch")
    val value = linux_oci_flat_inspect_json_v2(raw)?
    if json_value_keys(value).len() != 19: return Err("containment-inspect-fields")
    if (containment_inspect_text_v1(value, "id")? != expected.native_id or
            containment_inspect_text_v1(value, "pod_uid")? != expected.pod_uid or
            containment_inspect_text_v1(value, "attempt")? != expected.attempt.to_text() or
            containment_inspect_text_v1(value, "node_boot_id")? != expected.node_boot_id or
            containment_inspect_text_v1(value, "provider_generation")? != expected.provider_generation.to_text() or
            containment_inspect_text_v1(value, "operation_id")? != expected.operation_id):
        return Err("containment-inspect-identity-mismatch")
    if (containment_inspect_text_v1(value, "status")? != "running" or
            containment_inspect_text_v1(value, "runtime")? != profile.runtime_name or
            containment_inspect_text_v1(value, "manager")? != profile.cgroup_manager or
            containment_inspect_text_v1(value, "cgroup_mode")? != "private" or
            containment_inspect_text_v1(value, "pid_mode")? != "private" or
            containment_inspect_text_v1(value, "cgroups")? != "default"):
        return Err("containment-inspect-configuration-mismatch")
    if (containment_inspect_field_v1(value, "privileged")? != JsonValue.Bool(false) or
            containment_inspect_field_v1(value, "readonly_rootfs")? != JsonValue.Bool(true) or
            containment_inspect_field_v1(value, "no_new_privileges")? != JsonValue.Bool(true) or
            containment_inspect_field_v1(value, "effective_caps")? != JsonValue.Int(0) or
            containment_inspect_field_v1(value, "bounding_caps")? != JsonValue.Int(0)):
        return Err("containment-inspect-security-mismatch")
    val pid = match containment_inspect_field_v1(value, "pid")?:
        case JsonValue.Int(found): found
        case _: return Err("containment-inspect-pid-type")
    if pid <= 0 or pid > 2147483647: return Err("containment-inspect-pid-invalid")
    val cgroup = containment_inspect_text_v1(value, "cgroup")?
    if (not cgroup.starts_with("/") or cgroup == "/" or str_len(cgroup) > 4095 or
            cgroup.contains("//") or cgroup.ends_with("/")): return Err("containment-inspect-cgroup-invalid")
    for byte in cgroup.bytes():
        if byte < 32 or byte == 127: return Err("containment-inspect-cgroup-invalid")
    var owned = false
    for component in cgroup.split("/"):
        if component == "." or component == "..": return Err("containment-inspect-cgroup-invalid")
        if (component == "libpod-" + expected.native_id or component == "libpod-" + expected.native_id + ".scope" or
                component == "libpod-payload-" + expected.native_id): owned = true
    if not owned: return Err("containment-inspect-cgroup-container-mismatch")
    Ok(LinuxOciContainmentInspectV1(pid: pid, cgroup_path: cgroup))
