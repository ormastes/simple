# milestone_0045 retention release (owner decision 2, 2026-11-19): the container provider's effect for a controller-
# signed release of a retained workspace run. SOURCE_AUTHORED / NOT_RUN. Mechanism only: the caller has already verified
# and journaled the signed decision, holds the V4 workspace-root loan, and archives the returned facts.
#
# Per run since milestone_0047 (owner decision 1, 2026-11-19, "use worktree"): every run staged into its OWN child of
# the admin-provisioned leaf, so a release deletes ONLY that child. The leaf and its XFS project quota stay provisioned
# (the admin provisions once; nothing is re-provisioned after a release); only this process's lease HOLD is dropped.
#
#   1. ADMIT this release's own native lease of the provisioned leaf (full native re-proof: same pool, workspace
#      identity, project id and PROJINHERIT). An in-process holder (a retained workload custody) makes it EBUSY: refused.
#   2. Open a FRESH source with the archived request bytes (re-proves the keep-id mapping, the profile and the leaf).
#   3. If the run child is proven absent beneath the held leaf (no-follow), a crash already removed it before the
#      archive: a RESUMED release converges `absent-unmeasured` (owner decision 2, unchanged); a first issue refuses.
#   4. Otherwise remove the run child and its tree inside the keep-id mapping (remove_retained_tree_v1), close every
#      descriptor and the exclusion, then observe the leaf's lease: `run-removed` records the removed entry count and the
#      project usage that remains (the quota is SHARED by every retained run child, so it is not zero in general).
#   5. On every exit after step 1, drop this process's hold of the lease (workspace_storage_close_retained_v1: closes
#      the native descriptors exactly as process exit does; the leaf, project and quota stay), so the next workload
#      prepare admits the leaf afresh without a restart. The drop waits for a CONFIRMED source close: an unconfirmed
#      close (a live borrower of the token) or a failed drop keeps the hold, reported, and the next admission fails
#      closed with a native EBUSY until restart.
use std.nogc_async_mut.container.providers.linux.workspace_root_borrow_v3.LinuxWorkspaceRootBorrowV3
use std.nogc_async_mut.container.providers.linux.workspace_mount_owner_v1.{LinuxWorkspaceSourceOpenV1, LinuxWorkspaceSourceCloseV1}
use std.nogc_sync_mut.storage_roots.workspace_storage_owner_v1.{WorkspaceStorageLeaseV1, workspace_storage_observe_v1,
    workspace_storage_close_retained_v1}

# charge: "run-removed" | "absent-unmeasured" | "" on error. used_* and removed are -1 when unmeasured.
pub struct LinuxWorkspaceRetentionReleaseTurnV1:
    charge: text
    used_bytes: i64
    used_inodes: i64
    removed: i64
    error: text

fn retention_release_failed_v1(error: text) -> LinuxWorkspaceRetentionReleaseTurnV1:
    LinuxWorkspaceRetentionReleaseTurnV1(charge: "", used_bytes: -1, used_inodes: -1, removed: -1, error: error)

# The exit after admission: drop the in-process hold, then answer. A failed drop fails the turn (never a silent hold).
fn retention_release_drop_v1(lease: WorkspaceStorageLeaseV1,
        turn: LinuxWorkspaceRetentionReleaseTurnV1) -> LinuxWorkspaceRetentionReleaseTurnV1:
    val dropped = workspace_storage_close_retained_v1(lease)
    if dropped.is_ok(): return turn
    val prior = if turn.error != "": turn.error + ";" else: ""
    retention_release_failed_v1(prior + "workspace-retention-release-lease-drop:" + dropped.unwrap_err())

# The exit after the source was opened. The lease is dropped ONLY once the source confirms it closed (descriptors and
# the exclusion consumed; a close diagnostic is kept in the error). An unconfirmed close leaves a live borrower of the
# token, so the hold is KEPT (the next admission fails closed with a native EBUSY until restart), never dropped under it.
fn retention_release_after_close_v1(lease: WorkspaceStorageLeaseV1, closed: LinuxWorkspaceSourceCloseV1,
        turn: LinuxWorkspaceRetentionReleaseTurnV1) -> LinuxWorkspaceRetentionReleaseTurnV1:
    val prior = if turn.error != "": turn.error + ";" else: ""
    if not closed.closed:
        return retention_release_failed_v1(prior + "workspace-retention-release-source-close:" + closed.error +
            ";workspace-retention-release-hold-kept")
    if closed.error != "":
        return retention_release_drop_v1(lease, retention_release_failed_v1(prior + "workspace-retention-release-source-close:" +
            closed.error))
    retention_release_drop_v1(lease, turn)

fn retention_release_absent_v1(resumed: bool) -> LinuxWorkspaceRetentionReleaseTurnV1:
    if not resumed: return retention_release_failed_v1("workspace-retention-release-run-absent")
    LinuxWorkspaceRetentionReleaseTurnV1(charge: "absent-unmeasured", used_bytes: -1, used_inodes: -1, removed: -1, error: "")

# `resumed`: the caller journaled this release before (a re-issue). Only a resumed release converges `absent-unmeasured`.
pub fn linux_workspace_retention_release_v1(root: LinuxWorkspaceRootBorrowV3, request_bytes: text,
        resumed: bool) -> LinuxWorkspaceRetentionReleaseTurnV1:
    val admitted = root.admit_lease_v3()
    if admitted.is_err(): return retention_release_failed_v1(admitted.unwrap_err())
    val lease = admitted.unwrap()
    var removed: i64 = 0
    match root.open_source_v3(lease, request_bytes):
        case LinuxWorkspaceSourceOpenV1.Observed(source):
            val absent = source.retained_run_absent_v1(request_bytes)
            if absent.is_err():
                return retention_release_after_close_v1(lease, source.close_v1(), retention_release_failed_v1(absent.unwrap_err()))
            if absent.unwrap():
                return retention_release_after_close_v1(lease, source.close_v1(), retention_release_absent_v1(resumed))
            val gone = source.remove_retained_tree_v1(request_bytes)
            val closed = source.close_v1()
            if gone.is_err(): return retention_release_after_close_v1(lease, closed, retention_release_failed_v1(gone.unwrap_err()))
            if not closed.closed or closed.error != "":
                return retention_release_after_close_v1(lease, closed, retention_release_failed_v1(""))
            removed = gone.unwrap()
        case LinuxWorkspaceSourceOpenV1.CleanupRequired(source, reason):
            return retention_release_after_close_v1(lease, source.close_v1(), retention_release_failed_v1(reason))
        case LinuxWorkspaceSourceOpenV1.Rejected(_, _, _, reason):
            # Nothing was retained by the refused open: no borrower of the token remains.
            return retention_release_drop_v1(lease, retention_release_failed_v1(reason))
    val receipt = workspace_storage_observe_v1(lease)
    if receipt.is_err(): return retention_release_drop_v1(lease, retention_release_failed_v1(receipt.unwrap_err()))
    if receipt.unwrap().state != "retained":
        return retention_release_drop_v1(lease, retention_release_failed_v1("workspace-retention-release-leaf-not-retained"))
    retention_release_drop_v1(lease, LinuxWorkspaceRetentionReleaseTurnV1(charge: "run-removed", used_bytes: receipt.unwrap().used_bytes,
        used_inodes: receipt.unwrap().used_inodes, removed: removed, error: ""))

export LinuxWorkspaceRetentionReleaseTurnV1, linux_workspace_retention_release_v1
