# Exact-cleanup scope (AT-CTR-03). The run's destroy command may name ONLY the
# run's own native id; networks, volumes, prune and bulk removal are never part
# of cleanup. Sentinel network/volume resources are fixture-owned and carry the
# `simpleorch-sentinel-` prefix so a destroy can be proven not to touch them.
use std.common.contracts.container.runtime_v1.RuntimeCommandV1

pub val CLEANUP_SENTINEL_PREFIX_V1 = "simpleorch-sentinel-"
val CLEANUP_SENTINEL_LABEL_V1 = "io.simpleorch.sentinel="

pub struct CleanupSentinelV1:
    kind: text
    name: text
    fixture_id: text

fn cleanup_token_ok_v1(value: text) -> bool:
    if value == "" or value.starts_with("-"): return false
    for ch in value.chars():
        val ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "-" or ch == "_"
        if not ok: return false
    true

pub fn cleanup_sentinel_v1(kind: text, fixture_id: text, suffix: text) -> Result<CleanupSentinelV1, text>:
    if kind != "network" and kind != "volume": return Err("cleanup-sentinel-kind-invalid")
    if not cleanup_token_ok_v1(fixture_id) or not cleanup_token_ok_v1(suffix): return Err("cleanup-sentinel-name-invalid")
    Ok(CleanupSentinelV1(kind: kind, name: CLEANUP_SENTINEL_PREFIX_V1 + fixture_id + "-" + suffix, fixture_id: fixture_id))

fn cleanup_sentinel_command_v1(engine: text, operation: text, args: [text]) -> Result<RuntimeCommandV1, text>:
    if engine != "podman" and engine != "docker": return Err("cleanup-sentinel-engine-unsupported")
    Ok(RuntimeCommandV1(operation: operation, program: engine, args: args))

pub fn cleanup_sentinel_create_command_v1(engine: text, sentinel: CleanupSentinelV1) -> Result<RuntimeCommandV1, text>:
    cleanup_sentinel_command_v1(engine, "sentinel-create",
        [sentinel.kind, "create", "--label", CLEANUP_SENTINEL_LABEL_V1 + sentinel.fixture_id, sentinel.name])

pub fn cleanup_sentinel_inspect_command_v1(engine: text, sentinel: CleanupSentinelV1) -> Result<RuntimeCommandV1, text>:
    cleanup_sentinel_command_v1(engine, "sentinel-inspect", [sentinel.kind, "inspect", sentinel.name])

# Fixture teardown only; never reachable from the run's cleanup path.
pub fn cleanup_sentinel_remove_command_v1(engine: text, sentinel: CleanupSentinelV1) -> Result<RuntimeCommandV1, text>:
    cleanup_sentinel_command_v1(engine, "sentinel-remove", [sentinel.kind, "rm", sentinel.name])

# Empty string = in scope. Called by the OCI provider's real destroy path
# before any engine effect.
pub fn cleanup_destroy_scope_error_v1(engine: text, command: RuntimeCommandV1, native_id: text) -> text:
    if native_id.starts_with(CLEANUP_SENTINEL_PREFIX_V1): return "cleanup-target-is-sentinel"
    if command.operation != "destroy" or command.program != engine: return "cleanup-command-out-of-scope"
    val args = command.args
    var tail: [text] = []
    if engine == "runc":
        if args.len() < 4 or args[0] != "--root" or args[1] == "" or args[1].starts_with("-") or args[2] != "delete":
            return "cleanup-command-out-of-scope"
        var i = 3
        while i < args.len():
            tail = tail.push(args[i])
            i = i + 1
    else:
        if args.len() < 2 or args[0] != "rm": return "cleanup-command-out-of-scope"
        var j = 1
        while j < args.len():
            tail = tail.push(args[j])
            j = j + 1
    if tail == [native_id] or tail == ["--force", native_id]: return ""
    "cleanup-command-out-of-scope"

pub fn cleanup_sentinels_intact_v1(sentinels: [CleanupSentinelV1], inspect_exit_codes: [i64]) -> Result<bool, text>:
    if sentinels.len() == 0: return Err("cleanup-sentinel-required")
    if sentinels.len() != inspect_exit_codes.len(): return Err("cleanup-sentinel-observation-count")
    var index = 0
    for sentinel in sentinels:
        if inspect_exit_codes[index] != 0: return Err("cleanup-sentinel-removed:" + sentinel.name)
        index = index + 1
    Ok(true)
