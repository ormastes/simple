# Linux OCI LinuxOciRuntimeProviderV1.
#
# The provider owns the Linux edge only.  It uses argv vectors through the
# process facade and never builds a shell command.  Podman is the default
# engine because its supported Linux mode is rootless; Docker and bare runc
# are accepted only when explicitly selected by an already-positive host
# probe.  This module does not install tools, change uid maps, change kernel
# policy, or infer capability from an engine name.

pub use std.nogc_async_mut.container.providers.linux.engine_policy_v1.{LinuxOciEnginePolicyV1, LinuxOciEngineObservationV1}
use std.nogc_async_mut.container.providers.linux.engine_policy_v1.{linux_oci_engine_policy_error_v1,
    linux_oci_engine_observation_match_v1, linux_oci_engine_route_v1}
use std.nogc_async_mut.container.providers.linux.engine_observer_v1.linux_oci_engine_observe_v1
use std.common.contracts.container.command_v1.oci_command_parts_v1
pub use std.nogc_async_mut.container.providers.linux.request_v1.LinuxOciRequestV1
use std.nogc_async_mut.container.providers.linux.request_v1.{linux_oci_request_bounds_v1, linux_oci_request_digest_v1}
use std.common.contracts.container.bound_intent_v2.{RuntimeBoundIntentV2, runtime_bound_intent_encode_v2, runtime_bound_intent_decode_v2, runtime_bound_intent_match_v2}
use std.common.build_manager.contracts.builder_digest_valid_v1
use std.common.contracts.container.runtime_v1.{RuntimeIdentityV1,
    RuntimeCommandV1, RuntimeStateV1, RuntimeOperationV1, RuntimeValidationV1,
    RuntimeProbeV1, RuntimeIntentV1, RuntimeProviderContractV1,
    RuntimeProviderV1,
    RUNTIME_PHASE_PREPARED, RUNTIME_PHASE_CREATED, RUNTIME_PHASE_RUNNING,
    RUNTIME_PHASE_EXITED, RUNTIME_PHASE_STOPPED, RUNTIME_PHASE_DESTROYED,
    RUNTIME_PHASE_UNKNOWN, RUNTIME_STATUS_OK, RUNTIME_STATUS_REJECTED,
    RUNTIME_STATUS_BLOCKED, runtime_identity_empty, runtime_command_empty,
    runtime_state_empty, RUNTIME_PRIVILEGE_ROOTLESS, RUNTIME_PRIVILEGE_ROOT,
    RUNTIME_PRIVILEGE_UNKNOWN}
use std.nogc_sync_mut.io.process_ops.{process_run_timeout, process_run_bounded}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_publish_noreplace, file_remove, directory_fsync, file_is_regular_no_follow,
    file_read_regular_no_follow_bounded, file_lock, file_unlock}
use std.nogc_sync_mut.sffi.fs.{file_atomic_write_mode}

pub const OCI_ENGINE_PODMAN = "podman"
pub const OCI_ENGINE_DOCKER = "docker"
pub const OCI_ENGINE_RUNC = "runc"
pub const OCI_DEFAULT_ENGINE = OCI_ENGINE_PODMAN
pub const OCI_DEFAULT_TIMEOUT_MS: i64 = 30000
pub const OCI_DEFAULT_STOP_TIMEOUT_SECONDS: i64 = 10
pub const OCI_MAX_OUTPUT_BYTES: i64 = 1048576
pub const OCI_MAX_CPU_LIMIT_MILLIS: i64 = 92233720368547758
pub const OCI_MAX_RETAINED_RECORDS: i64 = 256
pub const OCI_MAX_RETAINED_DESTROYED: i64 = 64
pub const OCI_MAX_SCRIPTED_RESULTS: i64 = 512
pub const OCI_MAX_SCRIPTED_RETAINED_BYTES: i64 = 4194304
pub const OCI_MAX_SCRIPTED_ARGS_PER_RESULT: i64 = 256
const OCI_SCRIPTED_RESULT_OVERHEAD_BYTES: i64 = 128
const OCI_SCRIPTED_ARG_OVERHEAD_BYTES: i64 = 16

pub const OCI_REASON_PROVIDER_UNAVAILABLE = "oci-provider-live-execution-unavailable"

pub fn linux_oci_provider_contract() -> RuntimeProviderContractV1:
    RuntimeProviderContractV1(provider_id: "linux-oci-v1", version: 1,
        supports_recovery: true, supports_logs: true)

pub struct RootlessCapabilityEvidenceV1:
    uid: text
    username: text
    uid_map: text
    gid_map: text
    subuid: text
    subgid: text
    cgroup_controllers: text
    cgroup_subtree_control: text

pub struct ScriptedCommandResultV1:
    operation: text
    program: text
    args: [text]
    stdout: text
    stderr: text
    exit_code: i64

struct RuntimeExecResultV1:
    stdout: text
    stderr: text
    exit_code: i64
    matched: bool

# A class is used here so the in-memory ownership table is mutated only by the
# provider.  The table is an execution cache, not durable authority: recover()
# revalidates every identity against the native engine before adopting it.
pub class LinuxOciRuntimeProviderV1:
    platform: text
    engine: text
    state_dir: text
    node_boot_id: text
    provider_generation: i64
    timeout_ms: i64
    live_enabled: bool
    scripted: bool
    engine_policy: LinuxOciEnginePolicyV1?
    engine_baseline: LinuxOciEngineObservationV1?
    scripted_engine_observation: LinuxOciEngineObservationV1?
    # Explicit fixture opt-in: exact scripted effects with real owned journals.
    # Production constructors leave this false; live execution always journals.
    persist_scripted_journal: bool
    scripted_results: [ScriptedCommandResultV1]
    var intents: [RuntimeIntentV1]
    var request_bindings: Dict<text, RuntimeBoundIntentV2>
    var states: [RuntimeStateV1]
    var operation_sequence: i64
    var scripted_cursor: i64
    var executor_calls: i64

impl LinuxOciRuntimeProviderV1:
    pub static fn new(platform: text, engine: text, state_dir: text,
            node_boot_id: text, provider_generation: i64,
            live_enabled: bool = true,
            timeout_ms: i64 = OCI_DEFAULT_TIMEOUT_MS) -> LinuxOciRuntimeProviderV1:
        val effective_timeout = if timeout_ms > 0 then timeout_ms else OCI_DEFAULT_TIMEOUT_MS
        var provider = LinuxOciRuntimeProviderV1(platform: platform, engine: engine,
            state_dir: state_dir, node_boot_id: node_boot_id,
            provider_generation: provider_generation,
            timeout_ms: effective_timeout, live_enabled: live_enabled,
            scripted: false, engine_policy: nil, engine_baseline: nil, scripted_engine_observation: nil, persist_scripted_journal: false, scripted_results: [], intents: [], request_bindings: {}, states: [],
            operation_sequence: 0, scripted_cursor: 0, executor_calls: 0)
        provider

    pub static fn new_with_engine_policy(platform: text, engine: text, state_dir: text,
            node_boot_id: text, provider_generation: i64, policy: LinuxOciEnginePolicyV1,
            live_enabled: bool = true,
            timeout_ms: i64 = OCI_DEFAULT_TIMEOUT_MS) -> Result<LinuxOciRuntimeProviderV1, text>:
        val error = linux_oci_engine_policy_error_v1(policy)
        if error != "": return Err(error)
        if platform != "linux" or engine != OCI_ENGINE_PODMAN:
            return Err("engine-policy-linux-podman-required")
        if not live_enabled: return Err("engine-policy-live-observation-required")
        if timeout_ms <= 0: return Err("engine-policy-timeout-invalid")
        val provider = LinuxOciRuntimeProviderV1.new(platform, engine, state_dir,
            node_boot_id, provider_generation, true, timeout_ms)
        val config = provider.validate_probe_config()
        if not config.accepted: return Err(config.reason)
        val observed = linux_oci_engine_observe_v1(policy, if timeout_ms > 5000: 5000 else: timeout_ms)?
        provider.engine_policy = Some(policy)
        provider.engine_baseline = Some(observed)
        Ok(provider)

    # Explicit typed fixture injection; production construction never selects it.
    pub static fn scripted_with_engine_policy(platform: text, engine: text, state_dir: text,
            node_boot_id: text, provider_generation: i64, policy: LinuxOciEnginePolicyV1,
            baseline: LinuxOciEngineObservationV1, current: LinuxOciEngineObservationV1,
            results: [ScriptedCommandResultV1],
            timeout_ms: i64 = OCI_DEFAULT_TIMEOUT_MS) -> Result<LinuxOciRuntimeProviderV1, text>:
        val error = linux_oci_engine_policy_error_v1(policy)
        if error != "": return Err(error)
        if platform != "linux" or engine != OCI_ENGINE_PODMAN:
            return Err("engine-policy-linux-podman-required")
        val valid = linux_oci_engine_observation_match_v1(policy, baseline)?
        val provider = LinuxOciRuntimeProviderV1.scripted(platform, engine, state_dir,
            node_boot_id, provider_generation, results, timeout_ms)
        provider.engine_policy = Some(policy)
        provider.engine_baseline = Some(baseline)
        provider.scripted_engine_observation = Some(current)
        Ok(provider)

    pub fn engine_observation_v1() -> Result<LinuxOciEngineObservationV1, text>:
        val policy = match self.engine_policy:
            case Some(value): value
            case nil: return Err("engine-policy-required")
        val baseline = match self.engine_baseline:
            case Some(value): value
            case nil: return Err("engine-observation-baseline-required")
        val observed = if self.scripted:
            match self.scripted_engine_observation:
                case Some(value): value
                case nil: return Err("engine-scripted-observation-required")
        else:
            linux_oci_engine_observe_v1(policy, if self.timeout_ms > 5000: 5000 else: self.timeout_ms)?
        val valid = linux_oci_engine_observation_match_v1(policy, observed)?
        if observed.identity_digest != baseline.identity_digest: return Err("engine-observation-identity-changed")
        Ok(observed)

    # A deterministic executor seam for contract tests.  Each result is
    # matched by operation, program, and exact argv; an unmatched command is
    # a failed scripted execution, never an implicit success.
    pub static fn scripted(platform: text, engine: text, state_dir: text,
            node_boot_id: text, provider_generation: i64,
            results: [ScriptedCommandResultV1],
            timeout_ms: i64 = OCI_DEFAULT_TIMEOUT_MS,
            persist_scripted_journal: bool = false) -> LinuxOciRuntimeProviderV1:
        val effective_timeout = if timeout_ms > 0 then timeout_ms else OCI_DEFAULT_TIMEOUT_MS
        LinuxOciRuntimeProviderV1(platform: platform, engine: engine,
            state_dir: state_dir, node_boot_id: node_boot_id,
            provider_generation: provider_generation,
            timeout_ms: effective_timeout, live_enabled: true, scripted: true, engine_policy: nil, engine_baseline: nil, scripted_engine_observation: nil, persist_scripted_journal: persist_scripted_journal,
            scripted_results: _bounded_scripted_results(results), intents: [], request_bindings: {}, states: [],
            operation_sequence: 0, scripted_cursor: 0, executor_calls: 0)

    pub static fn scripted_with_intents(platform: text, engine: text,
            state_dir: text, node_boot_id: text, provider_generation: i64,
            intents: [RuntimeIntentV1],
            results: [ScriptedCommandResultV1],
            timeout_ms: i64 = OCI_DEFAULT_TIMEOUT_MS,
            persist_scripted_journal: bool = false) -> LinuxOciRuntimeProviderV1:
        val effective_timeout = if timeout_ms > 0 then timeout_ms else OCI_DEFAULT_TIMEOUT_MS
        LinuxOciRuntimeProviderV1(platform: platform, engine: engine,
            state_dir: state_dir, node_boot_id: node_boot_id,
            provider_generation: provider_generation,
            timeout_ms: effective_timeout, live_enabled: true, scripted: true, engine_policy: nil, engine_baseline: nil, scripted_engine_observation: nil, persist_scripted_journal: persist_scripted_journal,
            scripted_results: _bounded_scripted_results(results),
            intents: _bounded_intents(intents), request_bindings: {}, states: [],
            operation_sequence: 0, scripted_cursor: 0, executor_calls: 0)

    pub static fn scripted_with_bound_intents(platform: text, engine: text,
            state_dir: text, node_boot_id: text, provider_generation: i64,
            bounds: [RuntimeBoundIntentV2], results: [ScriptedCommandResultV1],
            timeout_ms: i64 = OCI_DEFAULT_TIMEOUT_MS,
            persist_scripted_journal: bool = false) -> LinuxOciRuntimeProviderV1:
        var identities: [RuntimeIntentV1] = []
        var bindings: Dict<text, RuntimeBoundIntentV2> = {}
        var index = 0
        while index < bounds.len() and index < OCI_MAX_RETAINED_RECORDS:
            val bound = bounds[index]
            identities.push(bound.identity)
            val key = bound.identity.pod_uid + "-" + bound.identity.attempt.to_text()
            bindings[key] = bound
            index = index + 1
        val provider = LinuxOciRuntimeProviderV1.scripted_with_intents(platform,
            engine, state_dir, node_boot_id, provider_generation, identities, results, timeout_ms, persist_scripted_journal)
        provider.request_bindings = bindings
        provider

    fn _probe() -> RuntimeProbeV1:
        val valid = self.validate_probe_config()
        if not valid.accepted:
            return RuntimeProbeV1(provider: "linux-oci-v1", engine: self.engine,
                engine_present: false, healthy: false, launch_capable: false,
                privilege: RUNTIME_PRIVILEGE_UNKNOWN, reason: valid.reason)
        if self.engine_policy.?:
            val observed = match self.engine_observation_v1():
                case Ok(value): value
                case Err(reason):
                    return RuntimeProbeV1(provider: "linux-oci-v1", engine: self.engine,
                        engine_present: false, healthy: false, launch_capable: false,
                        privilege: RUNTIME_PRIVILEGE_UNKNOWN, reason: reason)
            val capability = rootless_capability_error(_rootless_capability_evidence(observed.uid.to_text()))
            if capability != "":
                return RuntimeProbeV1(provider: "linux-oci-v1", engine: self.engine,
                    engine_present: true, healthy: true, launch_capable: false,
                    privilege: RUNTIME_PRIVILEGE_UNKNOWN, reason: capability)
            return RuntimeProbeV1(provider: "linux-oci-v1", engine: self.engine,
                engine_present: true, healthy: true, launch_capable: true,
                privilege: RUNTIME_PRIVILEGE_ROOTLESS,
                reason: "trusted-admin mutable-path observation matched; not sealed")
        if self.scripted:
            return RuntimeProbeV1(provider: "linux-oci-v1", engine: self.engine,
                engine_present: true, healthy: true, launch_capable: true,
                privilege: if self.engine == OCI_ENGINE_DOCKER then RUNTIME_PRIVILEGE_ROOT else RUNTIME_PRIVILEGE_ROOTLESS,
                reason: "scripted-provider")
        if not self.live_enabled:
            return RuntimeProbeV1(provider: "linux-oci-v1", engine: self.engine,
                engine_present: false, healthy: false, launch_capable: false,
                privilege: RUNTIME_PRIVILEGE_UNKNOWN,
                reason: OCI_REASON_PROVIDER_UNAVAILABLE)
        val run = process_run_timeout(self.engine, ["--version"], self.timeout_ms)
        if run.2.to_i64() != 0:
            return RuntimeProbeV1(provider: "linux-oci-v1", engine: self.engine,
                engine_present: false, healthy: false, launch_capable: false,
                privilege: RUNTIME_PRIVILEGE_UNKNOWN,
                reason: "engine-probe-failed: " + run.1.trim())
        var health_args: [text] = ["info", "--format"]
        if self.engine == OCI_ENGINE_DOCKER:
            health_args.push("{{.ServerVersion}}")
        else:
            health_args.push("{{.Host.Security.Rootless}}")
        val health = process_run_timeout(self.engine, health_args, self.timeout_ms)
        if health.2.to_i64() != 0 or health.0.trim() == "" or
                (self.engine == OCI_ENGINE_PODMAN and health.0.trim() != "true"):
            return RuntimeProbeV1(provider: "linux-oci-v1", engine: self.engine,
                engine_present: true, healthy: false, launch_capable: false,
                privilege: RUNTIME_PRIVILEGE_UNKNOWN,
                reason: "engine-health-or-launch-capability-unavailable: " + health.1.trim())
        if self.engine == OCI_ENGINE_PODMAN:
            val capability = rootless_capability_error(_rootless_capability_evidence())
            if capability != "":
                return RuntimeProbeV1(provider: "linux-oci-v1", engine: self.engine,
                    engine_present: true, healthy: true, launch_capable: false,
                    privilege: RUNTIME_PRIVILEGE_UNKNOWN, reason: capability)
        RuntimeProbeV1(provider: "linux-oci-v1", engine: self.engine,
            engine_present: true, healthy: true, launch_capable: true,
            privilege: if self.engine == OCI_ENGINE_DOCKER then RUNTIME_PRIVILEGE_ROOT else RUNTIME_PRIVILEGE_ROOTLESS,
            reason: "engine version and health/capability probes answered")

    fn validate_probe_config() -> RuntimeValidationV1:
        if self.platform != "linux":
            return RuntimeValidationV1(accepted: false,
                reason: "unsupported-platform: linux OCI provider received " + self.platform)
        if self.engine != OCI_ENGINE_PODMAN and self.engine != OCI_ENGINE_DOCKER:
            return RuntimeValidationV1(accepted: false,
                reason: "unsupported-engine: " + self.engine)
        if self.node_boot_id == "" or self.provider_generation <= 0:
            return RuntimeValidationV1(accepted: false,
                reason: "provider-identity-invalid")
        RuntimeValidationV1(accepted: true, reason: "")

    pub fn validate(request: LinuxOciRequestV1) -> RuntimeValidationV1:
        match linux_oci_request_bounds_v1(request):
            case Err(reason): return RuntimeValidationV1(accepted: false, reason: reason)
            case Ok(_): pass
        if request.environment.len() != 0 or request.working_directory != "":
            return RuntimeValidationV1(accepted: false, reason: "execution-options-not-admitted")
        if request.terminal_mode != "none":
            return RuntimeValidationV1(accepted: false, reason: "terminal-mode-not-admitted")
        if self.platform != "linux":
            return RuntimeValidationV1(accepted: false,
                reason: "unsupported-platform: linux OCI provider received " + self.platform)
        if self.engine != OCI_ENGINE_PODMAN and self.engine != OCI_ENGINE_DOCKER:
            return RuntimeValidationV1(accepted: false,
                reason: "unsupported-engine: " + self.engine)
        if self.state_dir == "":
            return RuntimeValidationV1(accepted: false, reason: "state-directory-empty")
        if self.state_dir.contains("..") or self.state_dir.contains("\n") or
                self.state_dir.contains("\r"):
            return RuntimeValidationV1(accepted: false,
                reason: "state-directory-unsafe")
        if self.node_boot_id == "":
            return RuntimeValidationV1(accepted: false, reason: "node-boot-id-empty")
        if self.provider_generation <= 0:
            return RuntimeValidationV1(accepted: false,
                reason: "provider-generation-invalid")
        if request.pod_uid == "":
            return RuntimeValidationV1(accepted: false, reason: "pod-uid-empty")
        if not _safe_token(request.pod_uid):
            return RuntimeValidationV1(accepted: false,
                reason: "pod-uid-contains-unsafe-character")
        if request.attempt <= 0:
            return RuntimeValidationV1(accepted: false, reason: "attempt-invalid")
        if request.operation_id != "" and not _safe_token(request.operation_id):
            return RuntimeValidationV1(accepted: false,
                reason: "operation-id-contains-unsafe-character")
        if request.image == "":
            return RuntimeValidationV1(accepted: false,
                reason: "image-empty")
        if not _locked_image(request.image):
            return RuntimeValidationV1(accepted: false,
                reason: "image-must-use-sha256-digest")
        if self.engine == OCI_ENGINE_RUNC:
            return RuntimeValidationV1(accepted: false,
                reason: "unsupported-engine: runc-lifecycle-not-qualified")
        if request.image.contains("\n") or request.image.contains("\r"):
            return RuntimeValidationV1(accepted: false,
                reason: "image-contains-control-character")
        val build_mode = request.build_input_root != "" or request.build_output_root != ""
        if build_mode and request.command.len() == 0:
            return RuntimeValidationV1(accepted: false, reason: "build-command-empty")
        match oci_command_parts_v1(request.command, request.args,
                request.replace_entrypoint or build_mode):
            case Err(reason): return RuntimeValidationV1(accepted: false, reason: reason)
            case Ok(_): pass
        if not (request.replace_entrypoint or build_mode):
            for item in request.command:
                if item == "":
                    return RuntimeValidationV1(accepted: false,
                        reason: "command-contains-empty-argument")
        for item in request.args:
            if item.contains("\n") or item.contains("\r"):
                return RuntimeValidationV1(accepted: false,
                    reason: "argument-contains-control-character")
        if request.cpu_limit_millis <= 0:
            return RuntimeValidationV1(accepted: false, reason: "cpu-limit-invalid")
        if request.cpu_limit_millis > OCI_MAX_CPU_LIMIT_MILLIS:
            return RuntimeValidationV1(accepted: false, reason: "cpu-limit-overflow")
        if request.memory_limit_bytes <= 0:
            return RuntimeValidationV1(accepted: false, reason: "memory-limit-invalid")
        if request.pid_limit <= 0:
            return RuntimeValidationV1(accepted: false, reason: "pid-limit-invalid")
        if request.network_policy != "bridge" and request.network_policy != "none":
            return RuntimeValidationV1(accepted: false, reason: "network-policy-unsupported")
        if request.filesystem_policy != "read-only":
            return RuntimeValidationV1(accepted: false, reason: "filesystem-policy-unsupported")
        RuntimeValidationV1(accepted: true, reason: "")

    # Reserve the logical attempt before any native side effect.  This is the
    # synchronous half of prepare_pod; the native engine is still untouched.
    me prepare_pod(request: LinuxOciRequestV1) -> RuntimeOperationV1:
        val valid = self.validate(request)
        if not valid.accepted:
            return self._rejected("prepare_pod", valid.reason, runtime_command_empty())
        val binding_error = self._request_binding_error(request)
        if binding_error != "":
            return self._rejected("prepare_pod", binding_error, runtime_command_empty())
        self._load_persisted_intent(request)
        val durable = self._durable_intent_for(request)
        if durable.operation_id != "" and not self._has_bound_intent(request):
            return self._rejected("prepare_pod", "intent-binding-required", runtime_command_empty())
        if durable.phase == RUNTIME_PHASE_DESTROYED:
            return self._rejected("prepare_pod", "attempt-already-destroyed",
                runtime_command_empty())
        val existing = self._find(request.pod_uid, request.attempt)
        if existing >= 0:
            val current = self.states[existing]
            return self._ok("prepare_pod", current,
                RuntimeCommandV1(operation: "prepare_pod", program: "", args: []),
                "logical attempt already prepared")
        while self.states.len() >= OCI_MAX_RETAINED_RECORDS:
            if not self._evict_oldest_destroyed(request.pod_uid, request.attempt):
                return self._rejected("prepare_pod", "state-capacity-exhausted",
                    runtime_command_empty())
        while not self.request_bindings.has(self._binding_key(request)) and
                self.request_bindings.len() >= OCI_MAX_RETAINED_RECORDS:
            if not self._evict_oldest_destroyed(request.pod_uid, request.attempt):
                return self._rejected("prepare_pod", "binding-capacity-exhausted", runtime_command_empty())
        val id = RuntimeIdentityV1(pod_uid: request.pod_uid,
            attempt: request.attempt, provider_generation: self.provider_generation,
            operation_id: if durable.operation_id != "": durable.operation_id
                elif request.operation_id != "": request.operation_id
                else: self._next_operation("create"), engine: self.engine,
            native_id: "", node_boot_id: self.node_boot_id)
        val state = RuntimeStateV1(phase: RUNTIME_PHASE_PREPARED,
            identity: id, exit_code: -1, reason: "prepared")
        if not self._remember_request_binding(request, RuntimeIntentV1(pod_uid: id.pod_uid,
                attempt: id.attempt, provider_generation: id.provider_generation,
                operation_id: id.operation_id, engine: id.engine, native_id: "",
                node_boot_id: id.node_boot_id, phase: RUNTIME_PHASE_PREPARED)):
            return self._rejected("prepare_pod", "intent-request-digest-invalid", runtime_command_empty())
        self.states.push(state)
        self._ok("prepare_pod", state,
            RuntimeCommandV1(operation: "prepare_pod", program: "", args: []),
            "prepared")

    # Materialize a non-running native workload.  An unavailable host lane is
    # a typed BLOCKED result and cannot mutate the state table.
    me create(request: LinuxOciRequestV1) -> RuntimeOperationV1:
        val valid = self.validate(request)
        if not valid.accepted:
            return self._rejected("create", valid.reason, runtime_command_empty())
        if (self.scripted and not self.persist_scripted_journal) or not self.live_enabled:
            return self._create_owned(request)
        # Serialize competing creates through reconciliation and the native call,
        # not just the final record write. The lock file is retained permanently.
        val lease = file_lock(self._journal_path(request) + ".create.lock", 5)
        if lease < 0:
            return self._rejected("create", "create-owner-lock-unavailable", runtime_command_empty())
        val result = self._create_owned(request)
        file_unlock(lease)
        result

    me _create_owned(request: LinuxOciRequestV1) -> RuntimeOperationV1:
        val valid = self.validate(request)
        if not valid.accepted:
            return self._rejected("create", valid.reason, runtime_command_empty())
        val binding_error = self._request_binding_error(request)
        if binding_error != "":
            return self._rejected("create", binding_error, runtime_command_empty())
        val index = self._find(request.pod_uid, request.attempt)
        if index < 0:
            val prepared = self.prepare_pod(request)
            if prepared.status != RUNTIME_STATUS_OK:
                return prepared
        val state_index = self._find(request.pod_uid, request.attempt)
        val current = self.states[state_index]
        self._load_persisted_intent(request)
        val saved_intent = self._durable_intent_for(request)
        if saved_intent.phase == RUNTIME_PHASE_DESTROYED:
            return self._rejected("create", "attempt-already-destroyed",
                runtime_command_empty())
        if current.phase == RUNTIME_PHASE_CREATED or
                current.phase == RUNTIME_PHASE_RUNNING or
                current.phase == RUNTIME_PHASE_EXITED or
                current.phase == RUNTIME_PHASE_STOPPED:
            return self._ok("create", current,
                RuntimeCommandV1(operation: "create", program: "", args: []),
                "idempotent existing native workload")
        if current.phase == RUNTIME_PHASE_DESTROYED:
            return self._rejected("create", "attempt-already-destroyed",
                runtime_command_empty())
        if saved_intent.operation_id != "":
            # A previous create may have timed out after native side effects.
            # Inspect/adopt the exact owned identity before permitting any
            # retry; ambiguity is returned to the caller and never duplicated.
            val recovery = self.recover(request)
            if recovery.status == RUNTIME_STATUS_OK or
                    recovery.reason != "native-recover-not-found":
                return recovery
            # Only an intent journaled before native create may be retried.
            # A later phase or a recorded native ID is evidence that create
            # succeeded once; absence now must not silently make a new one.
            if saved_intent.phase != RUNTIME_PHASE_PREPARED or
                    saved_intent.native_id != "":
                return self._rejected("create", "previous-native-workload-missing",
                    runtime_command_empty())
        val operation_id = if request.operation_id != "": request.operation_id
            elif saved_intent.operation_id != "": saved_intent.operation_id
            else: current.identity.operation_id
        val command = build_create_command(self.engine, self.state_dir, request,
            operation_id, self.provider_generation, self.node_boot_id)
        if command.0 != "":
            return self._rejected("create", command.0, runtime_command_empty())
        if not self.live_enabled:
            return self._blocked("create", OCI_REASON_PROVIDER_UNAVAILABLE, command.1)
        if not self._save_intent(request, operation_id, "", RUNTIME_PHASE_PREPARED):
            return self._rejected("create", "intent-journal-write-failed",
                runtime_command_empty())
        val run = self._execute(command.1)
        if not run.matched:
            return self._create_failure_with_recovery(request,
                self._rejected_with_output("create", current, command.1,
                    self._execution_failure_reason_v1(run, "scripted-command-not-found"), run.stdout, run.stderr, run.exit_code))
        if run.exit_code != 0:
            return self._create_failure_with_recovery(request,
                self._rejected_with_output("create", current, command.1,
                    "native-create-failed", run.stdout, run.stderr, run.exit_code))
        val native_id = run.stdout.trim().split("\n")[0].trim()
        if native_id == "":
            return self._create_failure_with_recovery(request,
                self._rejected_with_output("create", current, command.1,
                    "native-create-returned-empty-id", run.stdout, run.stderr, run.exit_code))
        var identity = current.identity
        identity.native_id = native_id
        identity.operation_id = operation_id
        val created = RuntimeStateV1(phase: RUNTIME_PHASE_CREATED,
            identity: identity, exit_code: -1, reason: "created")
        val created_index = self._find(request.pod_uid, request.attempt)
        if created_index < 0:
            return self._rejected_with_output("create", created, command.1,
                "state-evicted-during-create", run.stdout, run.stderr, run.exit_code)
        self.states[created_index] = created
        if not self._save_intent(request, operation_id, native_id, RUNTIME_PHASE_CREATED):
            val cleanup = self.destroy(request, true)
            var failed = self._rejected_with_output("create", created, command.1,
                "intent-journal-update-failed", run.stdout, run.stderr, run.exit_code)
            failed.reason = failed.reason + "; cleanup: " + cleanup.reason
            return failed
        self._ok("create", created, command.1, "created")

    me start(request: LinuxOciRequestV1) -> RuntimeOperationV1:
        val current_result = self._current_for(request, "start")
        if current_result.status != RUNTIME_STATUS_OK:
            return current_result
        self._load_persisted_intent(request)
        val index = self._find(request.pod_uid, request.attempt)
        val current = self.states[index]
        if current.phase == RUNTIME_PHASE_RUNNING:
            return self._ok("start", current,
                RuntimeCommandV1(operation: "start", program: "", args: []),
                "idempotent already-running workload")
        if current.phase != RUNTIME_PHASE_CREATED:
            return self._rejected("start", "invalid-state-for-start-" + current.phase,
                runtime_command_empty())
        val command = build_start_command(self.engine, self.state_dir,
            current.identity.native_id)
        if command.0 != "":
            return self._rejected("start", command.0, runtime_command_empty())
        if not self.live_enabled:
            return self._blocked("start", OCI_REASON_PROVIDER_UNAVAILABLE, command.1)
        val run = self._execute(command.1)
        if not run.matched:
            return self._rejected_with_output("start", current, command.1,
                self._execution_failure_reason_v1(run, "scripted-command-not-found"), run.stdout, run.stderr, run.exit_code)
        if run.exit_code != 0:
            return self._rejected_with_output("start", current, command.1,
                "native-start-failed", run.stdout, run.stderr, run.exit_code)
        val started = RuntimeStateV1(phase: RUNTIME_PHASE_RUNNING,
            identity: current.identity, exit_code: -1, reason: "running")
        self.states[index] = started
        self._ok("start", started, command.1, "started")

    me inspect(request: LinuxOciRequestV1) -> RuntimeOperationV1:
        val current_result = self._current_for(request, "inspect")
        if current_result.status != RUNTIME_STATUS_OK:
            return current_result
        val index = self._find(request.pod_uid, request.attempt)
        val current = self.states[index]
        val command = build_inspect_command(self.engine, self.state_dir,
            current.identity.native_id)
        if command.0 != "":
            return self._rejected("inspect", command.0, runtime_command_empty())
        if self.engine == OCI_ENGINE_RUNC:
            return self._rejected("inspect", "runc-recovery-requires-identity-labels",
                command.1)
        if not self.live_enabled:
            return self._blocked("inspect", OCI_REASON_PROVIDER_UNAVAILABLE, command.1)
        val run = self._execute(command.1)
        if not run.matched:
            return self._rejected_with_output("inspect", current, command.1,
                self._execution_failure_reason_v1(run, "scripted-command-not-found"), run.stdout, run.stderr, run.exit_code)
        if run.exit_code != 0:
            return self._rejected_with_output("inspect", current, command.1,
                "native-inspect-failed", run.stdout, run.stderr, run.exit_code)
        match recover_state_from_inspect(self.engine, run.stdout, request,
                current.identity.operation_id, current.identity.native_id,
                self.provider_generation, self.node_boot_id):
            case Err(reason):
                self._rejected_with_output("inspect", current, command.1,
                    reason, run.stdout, run.stderr, run.exit_code)
            case Ok(observed):
                self.states[index] = observed
                self._ok("inspect", observed, command.1, "inspected")

    me wait(request: LinuxOciRequestV1) -> RuntimeOperationV1:
        val current_result = self._current_for(request, "wait")
        if current_result.status != RUNTIME_STATUS_OK:
            return current_result
        val index = self._find(request.pod_uid, request.attempt)
        val current = self.states[index]
        if current.phase == RUNTIME_PHASE_EXITED or
                current.phase == RUNTIME_PHASE_STOPPED:
            return self._ok("wait", current,
                RuntimeCommandV1(operation: "wait", program: "", args: []),
                "idempotent terminal observation")
        if current.phase != RUNTIME_PHASE_RUNNING:
            return self._rejected("wait", "invalid-state-for-wait-" + current.phase,
                runtime_command_empty())
        val command = build_wait_command(self.engine, self.state_dir,
            current.identity.native_id)
        if command.0 != "":
            return self._rejected("wait", command.0, runtime_command_empty())
        if not self.live_enabled:
            return self._blocked("wait", OCI_REASON_PROVIDER_UNAVAILABLE, command.1)
        val run = self._execute(command.1)
        if not run.matched:
            return self._rejected_with_output("wait", current, command.1,
                self._execution_failure_reason_v1(run, "scripted-command-not-found"), run.stdout, run.stderr, run.exit_code)
        if run.exit_code != 0:
            return self._rejected_with_output("wait", current, command.1,
                "native-wait-failed", run.stdout, run.stderr, run.exit_code)
        val raw_code = run.stdout.trim()
        if raw_code == "" or raw_code.to_i64().to_text() != raw_code:
            return self._rejected_with_output("wait", current, command.1,
                "native-wait-returned-invalid-exit-code", run.stdout, run.stderr, run.exit_code)
        val exited = RuntimeStateV1(phase: RUNTIME_PHASE_EXITED,
            identity: current.identity, exit_code: raw_code.to_i64(), reason: "exited")
        self.states[index] = exited
        self._ok("wait", exited, command.1, "exited")

    pub fn logs(request: LinuxOciRequestV1) -> RuntimeOperationV1:
        val current_result = self._current_for(request, "logs")
        if current_result.status != RUNTIME_STATUS_OK:
            return current_result
        val index = self._find(request.pod_uid, request.attempt)
        val current = self.states[index]
        if current.phase != RUNTIME_PHASE_RUNNING and
                current.phase != RUNTIME_PHASE_EXITED and
                current.phase != RUNTIME_PHASE_STOPPED:
            return self._rejected("logs", "invalid-state-for-logs-" + current.phase,
                runtime_command_empty())
        val command = build_logs_command(self.engine, self.state_dir,
            current.identity.native_id)
        if command.0 != "":
            return self._rejected("logs", command.0, runtime_command_empty())
        if not self.live_enabled:
            return self._blocked("logs", OCI_REASON_PROVIDER_UNAVAILABLE, command.1)
        val run = self._execute(command.1)
        if not run.matched:
            return self._rejected_with_output("logs", current, command.1,
                self._execution_failure_reason_v1(run, "scripted-command-not-found"), run.stdout, run.stderr, run.exit_code)
        if run.exit_code != 0:
            return self._rejected_with_output("logs", current, command.1,
                "native-logs-failed", run.stdout, run.stderr, run.exit_code)
        RuntimeOperationV1(status: RUNTIME_STATUS_OK, operation: "logs",
            command: self._receipt_command_v1(command.1), state: current, exit_code: current.exit_code,
            stdout: run.stdout, stderr: run.stderr, reason: "observed")

    me stop(request: LinuxOciRequestV1) -> RuntimeOperationV1:
        val current_result = self._current_for(request, "stop")
        if current_result.status != RUNTIME_STATUS_OK:
            return current_result
        val index = self._find(request.pod_uid, request.attempt)
        val current = self.states[index]
        if current.phase == RUNTIME_PHASE_STOPPED or current.phase == RUNTIME_PHASE_EXITED:
            return self._ok("stop", current,
                RuntimeCommandV1(operation: "stop", program: "", args: []),
                "idempotent terminal stop")
        if current.phase != RUNTIME_PHASE_RUNNING and
                current.phase != RUNTIME_PHASE_CREATED:
            return self._rejected("stop", "invalid-state-for-stop-" + current.phase,
                runtime_command_empty())
        val command = build_stop_command(self.engine, self.state_dir,
            current.identity.native_id, OCI_DEFAULT_STOP_TIMEOUT_SECONDS)
        if command.0 != "":
            return self._rejected("stop", command.0, runtime_command_empty())
        if not self.live_enabled:
            return self._blocked("stop", OCI_REASON_PROVIDER_UNAVAILABLE, command.1)
        val run = self._execute(command.1)
        if not run.matched:
            return self._rejected_with_output("stop", current, command.1,
                self._execution_failure_reason_v1(run, "scripted-command-not-found"), run.stdout, run.stderr, run.exit_code)
        if run.exit_code != 0:
            return self._rejected_with_output("stop", current, command.1,
                "native-stop-failed", run.stdout, run.stderr, run.exit_code)
        val stopped = RuntimeStateV1(phase: RUNTIME_PHASE_STOPPED,
            identity: current.identity, exit_code: current.exit_code, reason: "stopped")
        self.states[index] = stopped
        if not self._save_intent(request, current.identity.operation_id,
                current.identity.native_id, RUNTIME_PHASE_STOPPED):
            return self._rejected_with_output("stop", stopped, command.1,
                "intent-journal-update-failed", run.stdout, run.stderr, run.exit_code)
        self._ok("stop", stopped, command.1, "stopped")

    me destroy(request: LinuxOciRequestV1, force: bool = false) -> RuntimeOperationV1:
        val valid = self.validate(request)
        if not valid.accepted:
            return self._rejected("destroy", valid.reason, runtime_command_empty())
        val binding_error = self._request_binding_error(request, true)
        if binding_error != "":
            return self._rejected("destroy", binding_error, runtime_command_empty())
        self._load_persisted_intent(request)
        val cached_index = self._find(request.pod_uid, request.attempt)
        if cached_index < 0:
            val durable = self._durable_intent_for(request)
            if durable.phase == RUNTIME_PHASE_DESTROYED:
                val identity = RuntimeIdentityV1(pod_uid: durable.pod_uid,
                    attempt: durable.attempt,
                    provider_generation: durable.provider_generation,
                    operation_id: durable.operation_id, engine: durable.engine,
                    native_id: durable.native_id, node_boot_id: durable.node_boot_id)
                val destroyed = RuntimeStateV1(phase: RUNTIME_PHASE_DESTROYED,
                    identity: identity, exit_code: -1, reason: "destroyed")
                return self._ok("destroy", destroyed,
                    RuntimeCommandV1(operation: "destroy", program: "", args: []),
                    "idempotent durable destroyed workload")
        val current_result = self._current_for(request, "destroy")
        if current_result.status != RUNTIME_STATUS_OK:
            return current_result
        val index = self._find(request.pod_uid, request.attempt)
        val current = self.states[index]
        if current.phase == RUNTIME_PHASE_DESTROYED:
            val saved = self._intent_for(request.pod_uid, request.attempt)
            if saved.phase != RUNTIME_PHASE_DESTROYED and
                    not self._save_intent(request, current.identity.operation_id,
                        current.identity.native_id, RUNTIME_PHASE_DESTROYED):
                return self._rejected("destroy", "intent-journal-update-failed",
                    runtime_command_empty())
            return self._ok("destroy", current,
                RuntimeCommandV1(operation: "destroy", program: "", args: []),
                "idempotent already-destroyed workload")
        if current.phase == RUNTIME_PHASE_RUNNING and not force:
            return self._rejected("destroy", "running-workload-requires-force",
                runtime_command_empty())
        if current.phase != RUNTIME_PHASE_CREATED and
                current.phase != RUNTIME_PHASE_RUNNING and
                current.phase != RUNTIME_PHASE_EXITED and
                current.phase != RUNTIME_PHASE_STOPPED:
            return self._rejected("destroy", "invalid-state-for-destroy-" + current.phase,
                runtime_command_empty())
        val command = build_destroy_command(self.engine, self.state_dir,
            current.identity.native_id, force)
        if command.0 != "":
            return self._rejected("destroy", command.0, runtime_command_empty())
        if not self.live_enabled:
            return self._blocked("destroy", OCI_REASON_PROVIDER_UNAVAILABLE, command.1)
        val run = self._execute(command.1)
        if not run.matched:
            return self._rejected_with_output("destroy", current, command.1,
                self._execution_failure_reason_v1(run, "scripted-command-not-found"), run.stdout, run.stderr, run.exit_code)
        if run.exit_code != 0:
            return self._rejected_with_output("destroy", current, command.1,
                "native-destroy-failed", run.stdout, run.stderr, run.exit_code)
        val destroyed = RuntimeStateV1(phase: RUNTIME_PHASE_DESTROYED,
            identity: current.identity, exit_code: current.exit_code, reason: "destroyed")
        self.states[index] = destroyed
        if not self._save_intent(request, current.identity.operation_id,
                current.identity.native_id, RUNTIME_PHASE_DESTROYED):
            return self._rejected_with_output("destroy", destroyed, command.1,
                "intent-journal-update-failed", run.stdout, run.stderr, run.exit_code)
        self._compact_destroyed()
        self._ok("destroy", destroyed, command.1, "destroyed")

    me recover(request: LinuxOciRequestV1) -> RuntimeOperationV1:
        val valid = self.validate(request)
        if not valid.accepted:
            return self._rejected("recover", valid.reason, runtime_command_empty())
        val binding_error = self._request_binding_error(request, true)
        if binding_error != "":
            return self._rejected("recover", binding_error, runtime_command_empty())
        if self.engine == OCI_ENGINE_RUNC:
            return self._rejected("recover", "runc-recovery-requires-identity-labels",
                runtime_command_empty())
        self._load_persisted_intent(request)
        val index = self._find(request.pod_uid, request.attempt)
        val saved_intent = self._durable_intent_for(request)
        if saved_intent.operation_id == "":
            return self._rejected("recover", "intent-binding-required", runtime_command_empty())
        if saved_intent.operation_id != "" and request.operation_id != "" and
                request.operation_id != saved_intent.operation_id:
            return self._rejected("recover", "intent-operation-id-mismatch",
                runtime_command_empty())
        if saved_intent.provider_generation > 0 and
                saved_intent.provider_generation != self.provider_generation:
            return self._rejected("recover", "intent-provider-generation-mismatch",
                runtime_command_empty())
        if saved_intent.node_boot_id != "" and
                saved_intent.node_boot_id != self.node_boot_id:
            return self._rejected("recover", "intent-node-boot-id-mismatch",
                runtime_command_empty())
        if saved_intent.engine != "" and saved_intent.engine != self.engine:
            return self._rejected("recover", "intent-engine-mismatch",
                runtime_command_empty())
        if saved_intent.phase == RUNTIME_PHASE_DESTROYED:
            val destroyed = _state_from_intent(saved_intent, RUNTIME_PHASE_DESTROYED,
                "destroyed")
            if index >= 0:
                self.states[index] = destroyed
            else:
                self.states.push(destroyed)
            return self._ok("recover", destroyed,
                RuntimeCommandV1(operation: "recover", program: "", args: []),
                "recovered durable destroyed tombstone")
        var expected_operation_id = request.operation_id
        var expected_native_id = ""
        if saved_intent.operation_id != "": expected_operation_id = saved_intent.operation_id
        if expected_native_id == "": expected_native_id = saved_intent.native_id
        var current = runtime_state_empty()
        if index >= 0:
            current = self.states[index]
            if current.phase != RUNTIME_PHASE_PREPARED:
                if expected_operation_id != "" and
                        current.identity.operation_id != expected_operation_id:
                    return self._rejected("recover", "state-operation-id-mismatch",
                        runtime_command_empty())
                expected_operation_id = current.identity.operation_id
                expected_native_id = current.identity.native_id
        if expected_operation_id == "":
            return self._rejected("recover", "recovery-operation-id-missing",
                runtime_command_empty())
        val lookup_name = match linux_oci_container_name(request.pod_uid, request.attempt):
            case Err(reason): return self._rejected("recover", reason, runtime_command_empty())
            case Ok(name): name
        val inspect_id = if expected_native_id != "" then expected_native_id else lookup_name
        val command = build_inspect_command(self.engine, self.state_dir, inspect_id)
        if command.0 != "":
            return self._rejected("recover", command.0, runtime_command_empty())
        if not self.live_enabled:
            return self._blocked("recover", OCI_REASON_PROVIDER_UNAVAILABLE, command.1)
        val run = self._execute(command.1)
        if not run.matched:
            return self._rejected_with_output("recover", current, command.1,
                self._execution_failure_reason_v1(run, "scripted-command-not-found"), run.stdout, run.stderr, run.exit_code)
        if run.exit_code != 0:
            if native_inspect_definitively_not_found(self.engine, run.exit_code,
                    run.stderr):
                return self._rejected_with_output("recover", current, command.1,
                    "native-recover-not-found", run.stdout, run.stderr, run.exit_code)
            return self._rejected_with_output("recover", current, command.1,
                "native-recover-inspect-failed", run.stdout, run.stderr, run.exit_code)
        match recover_state_from_inspect(self.engine, run.stdout, request,
                expected_operation_id, expected_native_id,
                self.provider_generation, self.node_boot_id):
            case Err(reason):
                self._rejected_with_output("recover", current, command.1,
                    reason, run.stdout, run.stderr, run.exit_code)
            case Ok(recovered):
                if index >= 0:
                    self.states[index] = recovered
                else:
                    while self.states.len() >= OCI_MAX_RETAINED_RECORDS:
                        if not self._evict_oldest_destroyed(
                                request.pod_uid, request.attempt):
                            return self._rejected("recover",
                                "state-capacity-exhausted", runtime_command_empty())
                    self.states.push(recovered)
                self._ok("recover", recovered, command.1, "recovered")

    pub fn state_for(request: LinuxOciRequestV1) -> RuntimeStateV1:
        val index = self._find(request.pod_uid, request.attempt)
        if index < 0:
            return runtime_state_empty()
        self.states[index]

    pub fn intent_for(request: LinuxOciRequestV1) -> RuntimeIntentV1:
        self._load_persisted_intent(request)
        self._durable_intent_for(request)

    pub fn persist_intent(request: LinuxOciRequestV1, operation_id: text) -> bool:
        val valid = self.validate(request)
        if not valid.accepted or operation_id == "" or not _safe_token(operation_id):
            return false
        self._save_intent(request, operation_id, "", RUNTIME_PHASE_PREPARED)

    pub fn retained_state_count() -> i64:
        self.states.len()

    pub fn retained_intent_count() -> i64:
        self.intents.len()

    # Counts every command executor entry, including unmatched scripted attempts.
    # Host capability/version probe subprocesses are outside this counter.
    pub fn executor_call_count() -> i64:
        self.executor_calls

    pub fn retained_scripted_result_count() -> i64:
        self.scripted_results.len()

    pub fn retained_scripted_byte_count() -> i64:
        _scripted_results_bytes(self.scripted_results)

    # The optional capabilities are explicit.  A caller must never interpret
    # empty output as a successful logs/stats observation.
    pub fn logs_unavailable() -> RuntimeOperationV1:
        RuntimeOperationV1(status: RUNTIME_STATUS_REJECTED, operation: "logs",
            command: runtime_command_empty(), state: runtime_state_empty(),
            exit_code: -1, stdout: "", stderr: "",
            reason: "optional-capability-unavailable: logs")

    pub fn stats_unavailable() -> RuntimeOperationV1:
        RuntimeOperationV1(status: RUNTIME_STATUS_REJECTED, operation: "stats",
            command: runtime_command_empty(), state: runtime_state_empty(),
            exit_code: -1, stdout: "", stderr: "",
            reason: "optional-capability-unavailable: stats")

    # New intent binds canonical request payload before create executes.
    # Legacy V1 identity-only records authorize exact-identity cleanup only;
    # their cleanup writer preserves V1 instead of inventing payload proof.
    # The caller owns a trusted state directory; no-clobber publication and
    # file/directory barriers protect journal admission, not hostile ancestors.
    fn _journal_path(request: LinuxOciRequestV1) -> text:
        self.state_dir + "/runtime-intent-" + request.pod_uid + "-" +
            request.attempt.to_text() + "-" + self.provider_generation.to_text()

    fn _intent_line(intent: RuntimeIntentV1) -> text:
        ["runtime-intent-v1", intent.pod_uid, intent.attempt.to_text(),
            intent.provider_generation.to_text(), intent.operation_id,
            intent.engine, intent.native_id, intent.node_boot_id,
            intent.phase].join("|")

    fn _read_legacy_intent(request: LinuxOciRequestV1) -> Result<RuntimeIntentV1, text>:
        val path = self._journal_path(request)
        if not file_exists(path): return Err("intent-absent")
        if not file_is_regular_no_follow(path): return Err("intent-file-not-regular")
        val content = match file_read_regular_no_follow_bounded(path, 8192):
            case Ok(value): value
            case Err(_): return Err("intent-file-unreadable")
        if not content.starts_with("runtime-intent-v1|"): return Err("intent-not-legacy")
        val fields = content.split("|")
        if fields.len() != 9: return Err("intent-legacy-invalid")
        if fields[1] != request.pod_uid or fields[2] != request.attempt.to_text() or
                fields[3] != self.provider_generation.to_text() or fields[5] != self.engine or
                fields[7] != self.node_boot_id:
            return Err("intent-scope-mismatch")
        if not _safe_token(fields[4]) or not _valid_intent_phase(fields[8]):
            return Err("intent-legacy-invalid")
        val row = RuntimeIntentV1(pod_uid: fields[1], attempt: request.attempt,
            provider_generation: self.provider_generation, operation_id: fields[4],
            engine: fields[5], native_id: fields[6], node_boot_id: fields[7], phase: fields[8])
        if self._intent_line(row) != content: return Err("intent-record-not-canonical")
        Ok(row)

    fn _retained_scope_error(request: LinuxOciRequestV1, row: RuntimeIntentV1) -> text:
        if row.pod_uid != request.pod_uid or row.attempt != request.attempt:
            return "intent-scope-mismatch"
        if row.provider_generation != self.provider_generation: return "intent-provider-generation-mismatch"
        if row.node_boot_id != self.node_boot_id: return "intent-node-boot-id-mismatch"
        if row.engine != self.engine: return "intent-engine-mismatch"
        ""

    fn _legacy_reconciliation_error(request: LinuxOciRequestV1,
            row: RuntimeIntentV1) -> text:
        if row.pod_uid != request.pod_uid or row.attempt != request.attempt or
                row.provider_generation != self.provider_generation or
                row.node_boot_id != self.node_boot_id or row.engine != self.engine:
            return "intent-scope-mismatch"
        if not builder_digest_valid_v1(row.native_id): return "legacy-native-id-unqualified"
        if row.operation_id == "" or not _safe_token(row.operation_id) or not _valid_intent_phase(row.phase):
            return "intent-legacy-invalid"
        if request.operation_id != "" and request.operation_id != row.operation_id:
            return "intent-operation-id-mismatch"
        ""

    fn _legacy_transition_error(previous: RuntimeIntentV1,
            current: RuntimeIntentV1) -> text:
        if previous.pod_uid != current.pod_uid or previous.attempt != current.attempt or
                previous.provider_generation != current.provider_generation or
                previous.operation_id != current.operation_id or previous.engine != current.engine or
                previous.native_id != current.native_id or previous.node_boot_id != current.node_boot_id:
            return "intent-scope-mismatch"
        if previous.phase == RUNTIME_PHASE_DESTROYED and current.phase != RUNTIME_PHASE_DESTROYED:
            return "attempt-already-destroyed"
        if current.phase != RUNTIME_PHASE_STOPPED and current.phase != RUNTIME_PHASE_DESTROYED:
            return "intent-legacy-transition-unsupported"
        if current.phase == RUNTIME_PHASE_STOPPED and previous.phase != RUNTIME_PHASE_RUNNING and
                previous.phase != RUNTIME_PHASE_CREATED and previous.phase != RUNTIME_PHASE_STOPPED:
            return "intent-legacy-transition-unsupported"
        ""

    fn _binding_key(request: LinuxOciRequestV1) -> text:
        request.pod_uid + "-" + request.attempt.to_text()

    fn _read_bound_intent(request: LinuxOciRequestV1) -> Result<RuntimeBoundIntentV2, text>:
        val path = self._journal_path(request)
        if not file_exists(path): return Err("intent-absent")
        if not file_is_regular_no_follow(path): return Err("intent-file-not-regular")
        val content = match file_read_regular_no_follow_bounded(path, 8192):
            case Ok(value): value
            case Err(_): return Err("intent-file-unreadable")
        val bound = runtime_bound_intent_decode_v2(content)?
        val row = bound.identity
        if row.pod_uid != request.pod_uid or row.attempt != request.attempt or
                row.provider_generation != self.provider_generation or
                row.node_boot_id != self.node_boot_id or row.engine != self.engine:
            return Err("intent-scope-mismatch")
        Ok(bound)

    fn _request_binding_error(request: LinuxOciRequestV1,
            allow_legacy: bool = false) -> text:
        val digest = match linux_oci_request_digest_v1(request):
            case Ok(value): value
            case Err(reason): return reason
        val key = self._binding_key(request)
        if self.request_bindings.has(key):
            val scope_error = self._retained_scope_error(request, self.request_bindings[key].identity)
            if scope_error != "": return scope_error
            match runtime_bound_intent_match_v2(self.request_bindings[key], digest, request.operation_id):
                case Err(reason): return reason
                case Ok(_): pass
        else:
            val cached = self._intent_for(request.pod_uid, request.attempt)
            if cached.operation_id != "":
                if not allow_legacy: return "intent-legacy-unbound"
                val legacy_error = self._legacy_reconciliation_error(request, cached)
                if legacy_error != "": return legacy_error
        match self._read_bound_intent(request):
            case Ok(bound):
                if not self.request_bindings.has(key) and self._intent_for(request.pod_uid, request.attempt).operation_id != "":
                    return "intent-binding-kind-mismatch"
                if self.request_bindings.has(key) and
                        self.request_bindings[key].identity.operation_id != bound.identity.operation_id:
                    return "intent-operation-id-mismatch"
                match runtime_bound_intent_match_v2(bound, digest, request.operation_id):
                    case Err(reason): return reason
                    case Ok(_): pass
            case Err(reason):
                if reason == "intent-legacy-unbound":
                    if not allow_legacy: return reason
                    if self.request_bindings.has(key): return "intent-binding-kind-mismatch"
                    match self._read_legacy_intent(request):
                        case Err(legacy_error): return legacy_error
                        case Ok(row): return self._legacy_reconciliation_error(request, row)
                if reason != "intent-absent": return reason
        ""

    fn _has_bound_intent(request: LinuxOciRequestV1) -> bool:
        if self.request_bindings.has(self._binding_key(request)): return true
        match self._read_bound_intent(request):
            case Ok(_): true
            case Err(_): false

    me _remember_request_binding(request: LinuxOciRequestV1, intent: RuntimeIntentV1) -> bool:
        match linux_oci_request_digest_v1(request):
            case Ok(digest):
                self.request_bindings[self._binding_key(request)] = RuntimeBoundIntentV2(
                    identity: intent, request_digest: digest)
                true
            case Err(_): false

    fn _write_intent_journal(request: LinuxOciRequestV1, legacy: bool = false) -> bool:
        val intent = self._intent_for(request.pod_uid, request.attempt)
        if legacy:
            if self._legacy_reconciliation_error(request, intent) != "": return false
            if self.scripted and not self.persist_scripted_journal: return true
            val path = self._journal_path(request)
            val lock = file_lock(path + ".lock", 5)
            if lock < 0: return false
            var allowed = false
            match self._read_legacy_intent(request):
                case Ok(previous):
                    allowed = self._legacy_transition_error(previous, intent) == ""
                case Err(_): allowed = false
            val written = if allowed: file_atomic_write_mode(path, self._intent_line(intent), 0o600) else: false
            val durable = written and directory_fsync(self.state_dir)
            file_unlock(lock)
            return durable
        val digest = match linux_oci_request_digest_v1(request):
            case Ok(value): value
            case Err(_): return false
        val bound = RuntimeBoundIntentV2(identity: intent, request_digest: digest)
        val bytes = match runtime_bound_intent_encode_v2(bound):
            case Ok(value): value
            case Err(_): return false
        if self.scripted and not self.persist_scripted_journal:
            return self._remember_request_binding(request, intent)
        if self.state_dir == "": return false
        val path = self._journal_path(request)
        val lock = file_lock(path + ".lock", 5)
        if lock < 0: return false
        # Re-read while holding the stable writer lock, before publication.
        var allowed = self._request_binding_error(request) == ""
        var first_publication = false
        match self._read_bound_intent(request):
            case Ok(previous):
                if previous.identity.operation_id != intent.operation_id: allowed = false
                if previous.identity.phase == RUNTIME_PHASE_DESTROYED and intent.phase != RUNTIME_PHASE_DESTROYED:
                    allowed = false
                if previous.identity.native_id != "" and previous.identity.native_id != intent.native_id:
                    allowed = false
            case Err(reason):
                if reason == "intent-absent": first_publication = true
                else: allowed = false
        var written = false
        if allowed:
            if first_publication:
                # Existence probes can miss dangling links. No-clobber publication
                # is the authoritative absence check before any native side effect.
                val staged = path + ".pending"
                if file_atomic_write_mode(staged, bytes, 0o600):
                    match file_publish_noreplace(staged, path):
                        case Ok(published): written = published
                        case Err(_): written = false
                    file_remove(staged)
            else:
                written = file_atomic_write_mode(path, bytes, 0o600)
        # The file helper flushes bytes; directory publication needs its own
        # barrier. Keep a written record on barrier failure for reconciliation.
        if written and not directory_fsync(self.state_dir): written = false
        file_unlock(lock)
        if written: return self._remember_request_binding(request, intent)
        false


    fn _read_persisted_intent(request: LinuxOciRequestV1) -> RuntimeIntentV1:
        match self._read_bound_intent(request):
            case Ok(bound):
                val digest = match linux_oci_request_digest_v1(request):
                    case Ok(value): value
                    case Err(_): return _empty_intent()
                match runtime_bound_intent_match_v2(bound, digest, request.operation_id):
                    case Ok(_):
                        val key = self._binding_key(request)
                        if self.request_bindings.has(key):
                            val cached = self.request_bindings[key]
                            if cached.request_digest != bound.request_digest or
                                    cached.identity.operation_id != bound.identity.operation_id:
                                return _empty_intent()
                        elif self._intent_for(request.pod_uid, request.attempt).operation_id != "":
                            return _empty_intent()
                        if self.request_bindings.has(key) or self.request_bindings.len() < OCI_MAX_RETAINED_RECORDS:
                            self.request_bindings[key] = bound
                        bound.identity
                    case Err(_): _empty_intent()
            case Err(reason):
                if reason == "intent-legacy-unbound":
                    match self._read_legacy_intent(request):
                        case Ok(row): return row
                        case Err(_): return _empty_intent()
                _empty_intent()

    me _load_persisted_intent(request: LinuxOciRequestV1):
        val loaded = self._read_persisted_intent(request)
        if loaded.operation_id == "": return
        var index = 0
        while index < self.intents.len():
            if self.intents[index].pod_uid == loaded.pod_uid and
                    self.intents[index].attempt == loaded.attempt:
                self.intents[index] = loaded
                return
            index = index + 1
        while self.intents.len() >= OCI_MAX_RETAINED_RECORDS:
            if not self._evict_oldest_destroyed(request.pod_uid, request.attempt):
                return
        self.intents.push(loaded)

    fn _durable_intent_for(request: LinuxOciRequestV1) -> RuntimeIntentV1:
        # Disk is re-read by binding checks; prefer its phase over stale cache.
        val persisted = self._read_persisted_intent(request)
        if persisted.operation_id != "": return persisted
        self._intent_for(request.pod_uid, request.attempt)

    fn _destroyed_count() -> i64:
        var count = 0
        for state in self.states:
            if state.phase == RUNTIME_PHASE_DESTROYED:
                count = count + 1
        count

    me _compact_destroyed():
        while self._destroyed_count() > OCI_MAX_RETAINED_DESTROYED:
            if not self._evict_oldest_destroyed("", 0):
                return

    me _evict_oldest_destroyed(except_pod_uid: text,
            except_attempt: i64) -> bool:
        var victim_uid = ""
        var victim_attempt = 0
        for state in self.states:
            if state.phase == RUNTIME_PHASE_DESTROYED and
                    (state.identity.pod_uid != except_pod_uid or
                     state.identity.attempt != except_attempt):
                victim_uid = state.identity.pod_uid
                victim_attempt = state.identity.attempt
                break
        if victim_uid == "":
            for intent in self.intents:
                if intent.phase == RUNTIME_PHASE_DESTROYED and
                        (intent.pod_uid != except_pod_uid or
                         intent.attempt != except_attempt):
                    victim_uid = intent.pod_uid
                    victim_attempt = intent.attempt
                    break
        if victim_uid == "": return false
        var kept_states: [RuntimeStateV1] = []
        for state in self.states:
            if state.identity.pod_uid != victim_uid or
                    state.identity.attempt != victim_attempt:
                kept_states.push(state)
        var kept_intents: [RuntimeIntentV1] = []
        for intent in self.intents:
            if intent.pod_uid != victim_uid or intent.attempt != victim_attempt:
                kept_intents.push(intent)
        self.states = kept_states
        self.intents = kept_intents
        var kept_bindings: Dict<text, RuntimeBoundIntentV2> = {}
        val victim_key = victim_uid + "-" + victim_attempt.to_text()
        for key in self.request_bindings.keys():
            if key != victim_key: kept_bindings[key] = self.request_bindings[key]
        self.request_bindings = kept_bindings
        true

    fn _find(request_pod_uid: text, request_attempt: i64) -> i64:
        var index = 0
        while index < self.states.len():
            val identity = self.states[index].identity
            if identity.pod_uid == request_pod_uid and identity.attempt == request_attempt:
                return index
            index = index + 1
        -1

    fn _intent_for(request_pod_uid: text, request_attempt: i64) -> RuntimeIntentV1:
        for intent in self.intents:
            if intent.pod_uid == request_pod_uid and intent.attempt == request_attempt:
                return intent
        _empty_intent()

    me _save_intent(request: LinuxOciRequestV1, operation_id: text,
            native_id: text, phase: text):
        while not self.request_bindings.has(self._binding_key(request)) and
                self.request_bindings.len() >= OCI_MAX_RETAINED_RECORDS:
            if not self._evict_oldest_destroyed(request.pod_uid, request.attempt): return false
        val previous_intent = self._intent_for(request.pod_uid, request.attempt)
        val legacy = previous_intent.operation_id != "" and not self._has_bound_intent(request)
        if self._request_binding_error(request, legacy) != "": return false
        val retained = self._durable_intent_for(request)
        if retained.operation_id != "":
            if retained.operation_id != operation_id: return false
            if retained.phase == RUNTIME_PHASE_DESTROYED and phase != RUNTIME_PHASE_DESTROYED: return false
            if retained.native_id != "" and retained.native_id != native_id: return false
        if legacy:
            val next = RuntimeIntentV1(pod_uid: request.pod_uid, attempt: request.attempt,
                provider_generation: self.provider_generation, operation_id: operation_id,
                engine: self.engine, native_id: native_id, node_boot_id: self.node_boot_id, phase: phase)
            if self._legacy_transition_error(previous_intent, next) != "": return false
        val binding_key = self._binding_key(request)
        if self.request_bindings.has(binding_key):
            if self.request_bindings[binding_key].identity.operation_id != operation_id: return false
        var index = 0
        while index < self.intents.len():
            if self.intents[index].pod_uid == request.pod_uid and
                    self.intents[index].attempt == request.attempt:
                val previous = self.intents[index]
                self.intents[index] = RuntimeIntentV1(pod_uid: request.pod_uid,
                    attempt: request.attempt, provider_generation: self.provider_generation,
                    operation_id: operation_id, engine: self.engine,
                    native_id: native_id, node_boot_id: self.node_boot_id, phase: phase)
                if self._write_intent_journal(request, legacy): return true
                self.intents[index] = previous
                return false
            index = index + 1
        while self.intents.len() >= OCI_MAX_RETAINED_RECORDS:
            if not self._evict_oldest_destroyed(request.pod_uid, request.attempt):
                return false
        val installed_binding = not legacy and not self.request_bindings.has(binding_key)
        if installed_binding:
            if not self._remember_request_binding(request, RuntimeIntentV1(pod_uid: request.pod_uid,
                    attempt: request.attempt, provider_generation: self.provider_generation,
                    operation_id: operation_id, engine: self.engine, native_id: native_id,
                    node_boot_id: self.node_boot_id, phase: phase)):
                return false
        self.intents.push(RuntimeIntentV1(pod_uid: request.pod_uid,
            attempt: request.attempt, provider_generation: self.provider_generation,
            operation_id: operation_id, engine: self.engine,
            native_id: native_id, node_boot_id: self.node_boot_id, phase: phase))
        if self._write_intent_journal(request, legacy): return true
        self.intents.pop()
        if installed_binding:
            var kept: Dict<text, RuntimeBoundIntentV2> = {}
            for key in self.request_bindings.keys():
                if key != binding_key: kept[key] = self.request_bindings[key]
            self.request_bindings = kept
        false


    fn _execution_failure_reason_v1(run: RuntimeExecResultV1, fallback: text) -> text:
        if self.engine_policy.? and not run.matched and run.stderr != "":
            return "engine-policy-refused: " + run.stderr
        fallback

    fn _receipt_command_v1(command: RuntimeCommandV1) -> RuntimeCommandV1:
        if command.program == "" or command.program != self.engine: return command
        if not self.engine_policy.?: return command
        val policy = self.engine_policy.unwrap()
        match linux_oci_engine_route_v1(policy, command.args):
            case Ok(arguments): RuntimeCommandV1(operation: command.operation,
                program: policy.executable_path, args: arguments)
            case Err(_): runtime_command_empty()

    fn _execute(command: RuntimeCommandV1) -> RuntimeExecResultV1:
        self.executor_calls = self.executor_calls + 1
        var routed = command
        if self.engine_policy.?:
            val observed = match self.engine_observation_v1():
                case Ok(value): value
                case Err(reason): return RuntimeExecResultV1(stdout: "", stderr: reason, exit_code: -1, matched: false)
            val policy = self.engine_policy.unwrap()
            routed.program = policy.executable_path
            routed.args = match linux_oci_engine_route_v1(policy, command.args):
                case Ok(value): value
                case Err(reason): return RuntimeExecResultV1(stdout: "", stderr: reason, exit_code: -1, matched: false)
        if self.scripted:
            if self.scripted_cursor >= self.scripted_results.len():
                return RuntimeExecResultV1(stdout: "", stderr: "scripted-command-not-found",
                    exit_code: -1, matched: false)
            val scripted = self.scripted_results[self.scripted_cursor]
            if scripted.operation == command.operation and
                    scripted.program == routed.program and
                    _args_equal(scripted.args, routed.args):
                self.scripted_cursor = self.scripted_cursor + 1
                if scripted.stdout.len() > OCI_MAX_OUTPUT_BYTES or
                        scripted.stderr.len() > OCI_MAX_OUTPUT_BYTES:
                    return RuntimeExecResultV1(stdout: "", stderr: "output-limit-exceeded",
                        exit_code: -1, matched: true)
                return RuntimeExecResultV1(stdout: scripted.stdout,
                    stderr: scripted.stderr, exit_code: scripted.exit_code,
                    matched: true)
            return RuntimeExecResultV1(stdout: "", stderr: "scripted-command-not-found",
                exit_code: -1, matched: false)
        if not self.live_enabled:
            return RuntimeExecResultV1(stdout: "", stderr: OCI_REASON_PROVIDER_UNAVAILABLE,
                exit_code: -1, matched: false)
        val run = process_run_bounded(routed.program, routed.args, self.timeout_ms,
            OCI_MAX_OUTPUT_BYTES)
        RuntimeExecResultV1(stdout: run.0, stderr: run.1,
            exit_code: run.2.to_i64(), matched: true)

    fn _create_failure_with_recovery(request: LinuxOciRequestV1,
            failure: RuntimeOperationV1) -> RuntimeOperationV1:
        val recovery = self.recover(request)
        if recovery.status == RUNTIME_STATUS_OK:
            return recovery
        var merged = failure
        merged.reason = failure.reason + "; recovery: " + recovery.reason
        merged

    me _next_operation(prefix: text) -> text:
        self.operation_sequence = self.operation_sequence + 1
        prefix + "-" + self.operation_sequence.to_text()

    fn _current_for(request: LinuxOciRequestV1, operation: text) -> RuntimeOperationV1:
        val valid = self.validate(request)
        if not valid.accepted:
            return self._rejected(operation, valid.reason, runtime_command_empty())
        val allow_legacy = operation == "inspect" or operation == "stop" or operation == "destroy"
        val binding_error = self._request_binding_error(request, allow_legacy)
        if binding_error != "":
            return self._rejected(operation, binding_error, runtime_command_empty())
        self._load_persisted_intent(request)
        val index = self._find(request.pod_uid, request.attempt)
        if index < 0:
            return self._rejected(operation, "attempt-not-prepared", runtime_command_empty())
        val durable = self._durable_intent_for(request)
        if durable.phase == RUNTIME_PHASE_DESTROYED:
            self.states[index] = _state_from_intent(durable, RUNTIME_PHASE_DESTROYED, "destroyed")
        val state = self.states[index]
        if durable.operation_id != "" and state.identity.operation_id != durable.operation_id:
            return self._rejected(operation, "state-operation-id-mismatch", runtime_command_empty())
        if durable.native_id != "" and state.identity.native_id != durable.native_id:
            return self._rejected(operation, "state-native-id-mismatch", runtime_command_empty())
        if state.identity.provider_generation != self.provider_generation:
            return self._rejected(operation, "provider-generation-mismatch",
                runtime_command_empty())
        if state.identity.node_boot_id != self.node_boot_id:
            return self._rejected(operation, "node-boot-id-mismatch", runtime_command_empty())
        self._ok(operation, state,
            RuntimeCommandV1(operation: operation, program: "", args: []), "")

    fn _ok(operation: text, state: RuntimeStateV1,
            command: RuntimeCommandV1, reason: text) -> RuntimeOperationV1:
        RuntimeOperationV1(status: RUNTIME_STATUS_OK, operation: operation,
            command: self._receipt_command_v1(command), state: state, exit_code: state.exit_code,
            stdout: "", stderr: "", reason: reason)

    fn _blocked(operation: text, reason: text,
            command: RuntimeCommandV1) -> RuntimeOperationV1:
        RuntimeOperationV1(status: RUNTIME_STATUS_BLOCKED, operation: operation,
            command: self._receipt_command_v1(command), state: runtime_state_empty(), exit_code: -1,
            stdout: "", stderr: "", reason: reason)

    fn _rejected(operation: text, reason: text,
            command: RuntimeCommandV1) -> RuntimeOperationV1:
        RuntimeOperationV1(status: RUNTIME_STATUS_REJECTED, operation: operation,
            command: self._receipt_command_v1(command), state: runtime_state_empty(), exit_code: -1,
            stdout: "", stderr: "", reason: reason)

    fn _rejected_with_output(operation: text, state: RuntimeStateV1,
            command: RuntimeCommandV1, reason: text, stdout: text, stderr: text,
            exit_code: i64) -> RuntimeOperationV1:
        RuntimeOperationV1(status: RUNTIME_STATUS_REJECTED, operation: operation,
            command: self._receipt_command_v1(command), state: state, exit_code: exit_code,
            stdout: stdout, stderr: stderr, reason: reason)

impl RuntimeProviderV1 for LinuxOciRuntimeProviderV1:
    me fn probe() -> RuntimeProbeV1:
        self._probe()

fn _empty_intent() -> RuntimeIntentV1:
    RuntimeIntentV1(pod_uid: "", attempt: 0, provider_generation: 0,
        operation_id: "", engine: "", native_id: "", node_boot_id: "",
        phase: "")

# Scripted execution is a contract-test seam, but it still has a hard retained
# cardinality bound so an accidentally large fixture cannot become a provider
# lifetime memory leak.
fn _bounded_scripted_results(results: [ScriptedCommandResultV1]) -> [ScriptedCommandResultV1]:
    var bounded: [ScriptedCommandResultV1] = []
    var retained_bytes = 0
    var index = 0
    while index < results.len() and index < OCI_MAX_SCRIPTED_RESULTS:
        if results[index].args.len() > OCI_MAX_SCRIPTED_ARGS_PER_RESULT:
            return bounded
        val result_bytes = _scripted_result_bytes(results[index])
        if result_bytes > OCI_MAX_SCRIPTED_RETAINED_BYTES - retained_bytes:
            return bounded
        bounded.push(results[index])
        retained_bytes = retained_bytes + result_bytes
        index = index + 1
    bounded

fn _scripted_result_bytes(result: ScriptedCommandResultV1) -> i64:
    var size = OCI_SCRIPTED_RESULT_OVERHEAD_BYTES + result.operation.len() +
        result.program.len() + result.stdout.len() + result.stderr.len() +
        result.args.len() * OCI_SCRIPTED_ARG_OVERHEAD_BYTES
    for arg in result.args:
        size = size + arg.len()
    size

fn _scripted_results_bytes(results: [ScriptedCommandResultV1]) -> i64:
    var size = 0
    for result in results:
        size = size + _scripted_result_bytes(result)
    size

fn _bounded_intents(intents: [RuntimeIntentV1]) -> [RuntimeIntentV1]:
    var bounded: [RuntimeIntentV1] = []
    var index = 0
    while index < intents.len() and index < OCI_MAX_RETAINED_RECORDS:
        bounded.push(intents[index])
        index = index + 1
    bounded

fn _safe_token(value: text) -> bool:
    if value == "": return false
    val allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
    var index = 0
    while index < value.len():
        if not allowed.contains(value.substring(index, index + 1)):
            return false
        index = index + 1
    true

fn _locked_image(value: text) -> bool:
    val marker = "@sha256:"
    val at = value.index_of(marker)
    if at < 1: return false
    val digest_start = at + marker.len()
    if value.len() - digest_start != 64: return false
    val hex = "0123456789abcdefABCDEF"
    var index = digest_start
    while index < value.len():
        if not hex.contains(value.substring(index, index + 1)):
            return false
        index = index + 1
    true

fn _valid_intent_phase(value: text) -> bool:
    value == RUNTIME_PHASE_PREPARED or value == RUNTIME_PHASE_CREATED or
        value == RUNTIME_PHASE_RUNNING or value == RUNTIME_PHASE_EXITED or
        value == RUNTIME_PHASE_STOPPED or value == RUNTIME_PHASE_DESTROYED

fn _args_equal(left: [text], right: [text]) -> bool:
    if left.len() != right.len(): return false
    var index = 0
    while index < left.len():
        if left[index] != right[index]: return false
        index = index + 1
    true

fn _read_probe_file(path: text) -> text:
    match file_read_regular_no_follow_bounded(path, OCI_MAX_OUTPUT_BYTES):
        case Ok(value): value
        case Err(_): ""

fn _state_from_intent(intent: RuntimeIntentV1, phase: text, reason: text) -> RuntimeStateV1:
    val identity = RuntimeIdentityV1(pod_uid: intent.pod_uid,
        attempt: intent.attempt, provider_generation: intent.provider_generation,
        operation_id: intent.operation_id, engine: intent.engine,
        native_id: intent.native_id, node_boot_id: intent.node_boot_id)
    RuntimeStateV1(phase: phase, identity: identity, exit_code: -1, reason: reason)

fn _effective_cgroup_dir(content: text) -> text:
    for line in content.split("\n"):
        if line.trim() == "0::/":
            return "/sys/fs/cgroup"
        if line.starts_with("0::/"):
            val relative = line.substring(4, line.len()).trim()
            if relative == "" or relative.contains("..") or relative.contains("\n") or
                    relative.contains("\r"):
                return ""
            return "/sys/fs/cgroup/" + relative
    ""

fn _rootless_capability_evidence(observed_uid: text = "") -> RootlessCapabilityEvidenceV1:
    var uid = observed_uid
    var username = ""
    if observed_uid == "":
        val uid_result = process_run_timeout("id", ["-u"], 5000)
        uid = if uid_result.2.to_i64() == 0 then uid_result.0.trim() else ""
        val username_result = process_run_timeout("id", ["-un"], 5000)
        username = if username_result.2.to_i64() == 0 then username_result.0.trim() else ""
    else:
        for line in _read_probe_file("/etc/passwd").split("\n"):
            val fields = line.split(":")
            if fields.len() == 7 and fields[2] == uid: username = fields[0]
    val cgroup_dir = _effective_cgroup_dir(_read_probe_file("/proc/self/cgroup"))
    RootlessCapabilityEvidenceV1(uid: uid, username: username,
        uid_map: _read_probe_file("/proc/self/uid_map"),
        gid_map: _read_probe_file("/proc/self/gid_map"),
        subuid: _read_probe_file("/etc/subuid"),
        subgid: _read_probe_file("/etc/subgid"),
        cgroup_controllers: if cgroup_dir == "" then "" else
            _read_probe_file(cgroup_dir + "/cgroup.controllers"),
        cgroup_subtree_control: if cgroup_dir == "" then "" else
            _read_probe_file(cgroup_dir + "/cgroup.subtree_control"))

fn _has_subid_range(content: text, uid: text, username: text) -> bool:
    if uid == "": return false
    for line in content.split("\n"):
        val fields = line.trim().split(":")
        if fields.len() == 3 and (fields[0] == uid or
                (username != "" and fields[0] == username)) and
                fields[1].to_i64() > 0 and fields[2].to_i64() > 0:
            return true
    false

fn _has_controller(content: text, expected: text) -> bool:
    val normalized = content.replace("+", "").replace("\n", " ").replace("\t", " ")
    for item in normalized.split(" "):
        if item == expected: return true
    false

fn _has_required_controllers(content: text) -> bool:
    _has_controller(content, "cpu") and _has_controller(content, "memory") and
        _has_controller(content, "pids")

pub fn rootless_capability_error(evidence: RootlessCapabilityEvidenceV1) -> text:
    if evidence.uid == "": return "rootless-uid-unavailable"
    if evidence.uid_map.trim() == "": return "rootless-uid-map-unavailable"
    if evidence.gid_map.trim() == "": return "rootless-gid-map-unavailable"
    if not _has_subid_range(evidence.subuid, evidence.uid, evidence.username):
        return "rootless-subuid-range-unavailable"
    if not _has_subid_range(evidence.subgid, evidence.uid, evidence.username):
        return "rootless-subgid-range-unavailable"
    if not _has_required_controllers(evidence.cgroup_controllers):
        return "rootless-cgroup-v2-controllers-unavailable"
    if not _has_required_controllers(evidence.cgroup_subtree_control):
        return "rootless-cgroup-delegation-unavailable"
    ""

pub fn native_inspect_definitively_not_found(engine: text, exit_code: i64,
        stderr: text) -> bool:
    val message = stderr.to_lower()
    if engine == OCI_ENGINE_PODMAN:
        return exit_code == 125 and (message.contains("no such container") or
            message.contains("no container with name or id"))
    if engine == OCI_ENGINE_DOCKER:
        return exit_code == 1 and (message.contains("no such container") or
            message.contains("no such object"))
    false

pub fn linux_oci_container_name(pod_uid: text, attempt: i64) -> Result<text, text>:
    if not _safe_token(pod_uid):
        return Err("pod-uid-contains-unsafe-character")
    if attempt <= 0:
        return Err("attempt-invalid")
    Ok("simpleorch-" + pod_uid + "-" + attempt.to_text())

fn _native_id_valid(native_id: text) -> bool:
    not native_id.starts_with("-") and _safe_token(native_id)

fn _base_command(engine: text, operation: text, state_dir: text,
        native_id: text) -> Result<RuntimeCommandV1, text>:
    if engine != OCI_ENGINE_PODMAN and engine != OCI_ENGINE_DOCKER and
            engine != OCI_ENGINE_RUNC:
        return Err("unsupported-engine: " + engine)
    if native_id == "" or not _native_id_valid(native_id):
        return Err("native-id-invalid")
    if engine == OCI_ENGINE_RUNC:
        if state_dir == "": return Err("state-directory-empty")
        return Ok(RuntimeCommandV1(operation: operation, program: engine,
            args: ["--root", state_dir, operation, native_id]))
    Ok(RuntimeCommandV1(operation: operation, program: engine,
        args: [operation, native_id]))

# Return `(error, command)` so command construction is fully testable without
# invoking a host runtime.
pub fn build_create_command(engine: text, state_dir: text,
        request: LinuxOciRequestV1, operation_id: text,
        provider_generation: i64, node_boot_id: text) -> (text, RuntimeCommandV1):
    match linux_oci_request_bounds_v1(request):
        case Err(reason): return (reason, runtime_command_empty())
        case Ok(_): pass
    if request.environment.len() != 0 or request.working_directory != "":
        return ("execution-options-not-admitted", runtime_command_empty())
    if request.terminal_mode != "none":
        return ("terminal-mode-not-admitted", runtime_command_empty())
    match linux_oci_container_name(request.pod_uid, request.attempt):
        case Err(reason): return (reason, runtime_command_empty())
        case Ok(name):
            if provider_generation <= 0:
                return ("provider-generation-invalid", runtime_command_empty())
            if node_boot_id == "":
                return ("node-boot-id-empty", runtime_command_empty())
            if operation_id == "":
                return ("operation-id-empty", runtime_command_empty())
            if engine != OCI_ENGINE_PODMAN and engine != OCI_ENGINE_DOCKER and
                    engine != OCI_ENGINE_RUNC:
                return ("unsupported-engine: " + engine, runtime_command_empty())
            if engine == OCI_ENGINE_RUNC:
                if request.replace_entrypoint:
                    return ("runc-entrypoint-override-unsupported", runtime_command_empty())
                if request.bundle_path == "":
                    return ("runc-bundle-path-empty", runtime_command_empty())
                return ("", RuntimeCommandV1(operation: "create", program: engine,
                    args: ["--root", state_dir, "create", "--bundle",
                        request.bundle_path, name]))
            if request.image == "":
                return ("image-empty", runtime_command_empty())
            if not _locked_image(request.image):
                return ("image-must-use-sha256-digest", runtime_command_empty())
            if request.cpu_limit_millis <= 0:
                return ("cpu-limit-invalid", runtime_command_empty())
            if request.cpu_limit_millis > OCI_MAX_CPU_LIMIT_MILLIS:
                return ("cpu-limit-overflow", runtime_command_empty())
            var args: [text] = ["create", "--name", name,
                "--label", "io.simpleorch.pod_uid=" + request.pod_uid,
                "--label", "io.simpleorch.attempt=" + request.attempt.to_text(),
                "--label", "io.simpleorch.node_boot_id=" + node_boot_id,
                "--label", "io.simpleorch.provider_generation=" + provider_generation.to_text(),
                "--label", "io.simpleorch.operation_id=" + operation_id,
                "--cpu-period", "100000",
                "--cpu-quota", (request.cpu_limit_millis * 100).to_text(),
                "--memory", request.memory_limit_bytes.to_text(),
                "--pids-limit", request.pid_limit.to_text(),
                "--network", request.network_policy,
                "--read-only", "--security-opt", "no-new-privileges",
                "--cap-drop", "ALL"]
            val build_mode = request.build_input_root != "" or request.build_output_root != ""
            if build_mode:
                if request.build_input_root == "" or request.build_output_root == "":
                    return ("build-root-incomplete", runtime_command_empty())
                if request.command.len() == 0:
                    return ("build-command-empty", runtime_command_empty())
            val command_parts = match oci_command_parts_v1(request.command, request.args,
                    request.replace_entrypoint or build_mode):
                case Ok(parts): parts
                case Err(reason): return (reason, runtime_command_empty())
            for option in command_parts.options:
                args.push(option)
            if build_mode:
                args.push("--mount")
                args.push("type=bind,source=" + request.build_input_root +
                    ",target=/simple-build/inputs,readonly")
                args.push("--mount")
                args.push("type=bind,source=" + request.build_output_root +
                    ",target=/simple-build/outputs")
            args.push(request.image)
            for value in command_parts.arguments:
                args.push(value)
            ("", RuntimeCommandV1(operation: "create", program: engine, args: args))

pub fn build_start_command(engine: text, state_dir: text,
        native_id: text) -> (text, RuntimeCommandV1):
    match _base_command(engine, "start", state_dir, native_id):
        case Err(reason): (reason, runtime_command_empty())
        case Ok(command): ("", command)

pub fn build_wait_command(engine: text, state_dir: text,
        native_id: text) -> (text, RuntimeCommandV1):
    if engine == OCI_ENGINE_RUNC:
        return ("runc-wait-requires-external-reaper", runtime_command_empty())
    match _base_command(engine, "wait", state_dir, native_id):
        case Err(reason): (reason, runtime_command_empty())
        case Ok(command): ("", command)

pub fn build_logs_command(engine: text, state_dir: text,
        native_id: text) -> (text, RuntimeCommandV1):
    if engine == OCI_ENGINE_RUNC:
        return ("optional-capability-unavailable: logs", runtime_command_empty())
    if native_id == "" or not _native_id_valid(native_id):
        return ("native-id-invalid", runtime_command_empty())
    ("", RuntimeCommandV1(operation: "logs", program: engine,
        args: ["logs", native_id]))

pub fn build_stop_command(engine: text, state_dir: text,
        native_id: text, timeout_seconds: i64) -> (text, RuntimeCommandV1):
    if timeout_seconds <= 0:
        return ("stop-timeout-invalid", runtime_command_empty())
    if engine == OCI_ENGINE_RUNC:
        match _base_command(engine, "kill", state_dir, native_id):
            case Err(reason): (reason, runtime_command_empty())
            case Ok(command): ("", command)
    else:
        if native_id == "" or not _native_id_valid(native_id):
            return ("native-id-invalid", runtime_command_empty())
        ("", RuntimeCommandV1(operation: "stop", program: engine,
            args: ["stop", "--time", timeout_seconds.to_text(), native_id]))

pub fn build_destroy_command(engine: text, state_dir: text,
        native_id: text, force: bool) -> (text, RuntimeCommandV1):
    if engine == OCI_ENGINE_RUNC:
        if native_id == "" or not _native_id_valid(native_id):
            return ("native-id-invalid", runtime_command_empty())
        var args: [text] = ["--root", state_dir, "delete"]
        if force: args.push("--force")
        args.push(native_id)
        return ("", RuntimeCommandV1(operation: "destroy", program: engine, args: args))
    if native_id == "" or not _native_id_valid(native_id):
        return ("native-id-invalid", runtime_command_empty())
    var args: [text] = ["rm"]
    if force: args.push("--force")
    args.push(native_id)
    ("", RuntimeCommandV1(operation: "destroy", program: engine, args: args))

pub fn build_inspect_command(engine: text, state_dir: text,
        native_id: text) -> (text, RuntimeCommandV1):
    if engine == OCI_ENGINE_RUNC:
        return ("runc-inspect-does-not-prove-provider-identity", runtime_command_empty())
    if native_id == "" or not _native_id_valid(native_id):
        return ("native-id-invalid", runtime_command_empty())
    # Four labels plus the native id and status are returned in a stable order.
    val format = "{{{{ index .Config.Labels \"io.simpleorch.pod_uid\" }}}}|" +
        "{{{{ index .Config.Labels \"io.simpleorch.attempt\" }}}}|" +
        "{{{{ index .Config.Labels \"io.simpleorch.node_boot_id\" }}}}|" +
        "{{{{ index .Config.Labels \"io.simpleorch.provider_generation\" }}}}|" +
        "{{{{ index .Config.Labels \"io.simpleorch.operation_id\" }}}}|" +
        "{{{{.Id}}}}|{{{{.State.Status}}}}"
    ("", RuntimeCommandV1(operation: "inspect", program: engine,
        args: ["inspect", "--format", format, native_id]))

pub fn recover_state_from_inspect(engine: text, output: text,
        request: LinuxOciRequestV1, expected_operation_id: text,
        expected_native_id: text, provider_generation: i64,
        node_boot_id: text) -> Result<RuntimeStateV1, text>:
    if engine == OCI_ENGINE_RUNC:
        return Err("runc-recovery-requires-identity-labels")
    val fields = output.trim().split("|")
    if fields.len() != 7:
        return Err("inspect-identity-shape-invalid")
    if fields[0] != request.pod_uid:
        return Err("inspect-pod-uid-mismatch")
    if fields[1] != request.attempt.to_text():
        return Err("inspect-attempt-mismatch")
    if fields[2] != node_boot_id:
        return Err("inspect-node-boot-id-mismatch")
    if fields[3] != provider_generation.to_text():
        return Err("inspect-provider-generation-mismatch")
    if fields[4] == "" or fields[4] != expected_operation_id:
        return Err("inspect-operation-id-mismatch")
    if fields[5] == "" or not _native_id_valid(fields[5]):
        return Err("inspect-native-id-invalid")
    if expected_native_id != "" and fields[5] != expected_native_id:
        return Err("inspect-native-id-mismatch")
    var phase = RUNTIME_PHASE_UNKNOWN
    if fields[6] == "created": phase = RUNTIME_PHASE_CREATED
    elif fields[6] == "running": phase = RUNTIME_PHASE_RUNNING
    elif fields[6] == "exited": phase = RUNTIME_PHASE_EXITED
    elif fields[6] == "stopped": phase = RUNTIME_PHASE_STOPPED
    elif fields[6] == "dead": phase = RUNTIME_PHASE_STOPPED
    else: return Err("inspect-state-unsupported: " + fields[6])
    Ok(RuntimeStateV1(phase: phase,
        identity: RuntimeIdentityV1(pod_uid: request.pod_uid,
            attempt: request.attempt, provider_generation: provider_generation,
            operation_id: fields[4], engine: engine,
            native_id: fields[5], node_boot_id: node_boot_id),
        exit_code: -1, reason: "recovered"))
