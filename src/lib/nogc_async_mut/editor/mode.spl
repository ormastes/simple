# SceneEditorMode — editor operating modes

# ============================================================================
# SceneEditorMode
# ============================================================================

enum SceneEditorMode:
    Edit2D
    Edit3D
    Play2D
    Play3D

impl SceneEditorMode:
    fn is_2d(self) -> bool:
        match self:
            SceneEditorMode.Edit2D => true
            SceneEditorMode.Play2D => true
            _ => false

    fn is_3d(self) -> bool:
        match self:
            SceneEditorMode.Edit3D => true
            SceneEditorMode.Play3D => true
            _ => false

    fn is_playing(self) -> bool:
        match self:
            SceneEditorMode.Play2D => true
            SceneEditorMode.Play3D => true
            _ => false

    fn is_editing(self) -> bool:
        match self:
            SceneEditorMode.Edit2D => true
            SceneEditorMode.Edit3D => true
            _ => false

    fn to_text(self) -> text:
        match self:
            SceneEditorMode.Edit2D => "Edit2D"
            SceneEditorMode.Edit3D => "Edit3D"
            SceneEditorMode.Play2D => "Play2D"
            SceneEditorMode.Play3D => "Play3D"
