# codex-impl
# Hosted bounded-preallocated mission admission wrapper for SimpleRing V1.
#
# This adapter proves that bounded hosted storage was created before Ready and that the
# selected mission profile/evidence is internally consistent. It is not a
# link-time static-topology proof, a compiler frame-layout proof, or proof that
# the host allocator was never used while constructing the underlying arrays.

use std.common.contracts.execution.async_profile_v1.{
    AsyncProfile, AsyncProfileError, AsyncProfilePreset, AsyncAssurance,
    AsyncMemory, AsyncRingMapping, async_profile_fingerprint_v1,
    async_profile_validate_v1
}
use std.common.contracts.execution.simple_ring_async_v1.{
    RingMappingGrade, RingToken, RingCompletion, RingTerminalKind,
    TaskPollResult
}
use std.nogc_async_mut.async_ring.simple_ring.{
    SimpleRing, SimpleRingError, RingReservation, RingSubmission,
    RingBatchPolicy, RingBatchCommitReceipt, RingCancelOutcome,
    RingResetReceipt, RingTelemetry
}

pub enum MissionRingLifecycle:
    Configuring
    Ready
    Quiesced

pub enum MissionRingEvidenceLevel:
    HostedPreallocatedV1

pub struct MissionRingEvidence:
    provider_mapping: RingMappingGrade
    fallback_selected: bool
    sealed_arena: bool
    arena_capacity: u64
    static_pool_ready: bool
    static_pool_capacity: u64
    task_slots: u64
    operation_slots: u64
    buffer_slots: u64
    trace_slots: u64
    deadline_slots: u64
    timer_slots: u64
    join_cancel_slots: u64
    maximum_frame_bytes: u64
    compiler_known_frame_bytes: u64

pub struct MissionRingAdmissionReceipt:
    profile_id: text
    profile_fingerprint: text
    owner_id: u64
    ring_id: u64
    capacity: u64
    evidence_level: MissionRingEvidenceLevel
    link_time_static_proven: bool
    allocation_free_proven: bool

pub struct MissionRingWake:
    token: RingToken
    wake_key: u64
    kind: RingTerminalKind

pub enum MissionRingAdapterError:
    InvalidOwner
    WrongOwner
    InvalidRingId
    InvalidCapacity
    NotConfiguring
    NotReady
    AlreadyQuiesced
    RingNotDrained
    NonMissionProfile
    UnsupportedMissionPreset
    ProfileRejected(AsyncProfileError)
    CapacityExceedsProfile
    DirectMappingRequired
    FallbackForbidden
    SealedArenaRequired
    ArenaCapacityInsufficient
    StaticPoolRequired
    StaticPoolCapacityInsufficient
    TaskCapacityInsufficient
    OperationCapacityInsufficient
    BufferCapacityInsufficient
    TraceCapacityInsufficient
    DeadlineCapacityInsufficient
    TimerCapacityInsufficient
    JoinCancelCapacityInsufficient
    FrameBoundRequired
    FrameBoundExceeded
    RingRejected(SimpleRingError)

class MissionSimpleRingAdapter<Op, Cpl>:
    owner_id_value: u64
    ring_id_value: u64
    capacity_value_field: i64
    lifecycle_value: MissionRingLifecycle
    ring_value: SimpleRing<Op, Cpl>
    profile_value: AsyncProfile?
    fingerprint_value: text

impl MissionSimpleRingAdapter<Op, Cpl>:
    static fn create(
        owner_id: u64, ring_id: u64, capacity: i64
    ) -> Result<MissionSimpleRingAdapter<Op, Cpl>, MissionRingAdapterError>:
        if owner_id == 0u64:
            return Err(MissionRingAdapterError.InvalidOwner)
        if ring_id == 0u64:
            return Err(MissionRingAdapterError.InvalidRingId)
        if capacity <= 0:
            return Err(MissionRingAdapterError.InvalidCapacity)
        val ring = match SimpleRing<Op, Cpl>.create(ring_id, owner_id, capacity):
            case Ok(value): value
            case Err(error): return Err(MissionRingAdapterError.RingRejected(error))
        Ok(MissionSimpleRingAdapter(
            owner_id_value: owner_id, ring_id_value: ring_id,
            capacity_value_field: capacity,
            lifecycle_value: MissionRingLifecycle.Configuring,
            ring_value: ring, profile_value: nil, fingerprint_value: ""))

    me configure(
        owner_id: u64, profile: AsyncProfile, evidence: MissionRingEvidence
    ) -> Result<MissionRingAdmissionReceipt, MissionRingAdapterError>:
        val owner_check = self._owner_check(owner_id)
        if val error = owner_check:
            return Err(error)
        if self.lifecycle_value != MissionRingLifecycle.Configuring:
            return Err(MissionRingAdapterError.NotConfiguring)
        match async_profile_validate_v1(profile):
            case Err(error): return Err(MissionRingAdapterError.ProfileRejected(error))
            case Ok(_): ()
        if profile.assurance != AsyncAssurance.Mission:
            return Err(MissionRingAdapterError.NonMissionProfile)
        if profile.preset != AsyncProfilePreset.MissionAlloc and
           profile.preset != AsyncProfilePreset.MissionPool:
            return Err(MissionRingAdapterError.UnsupportedMissionPreset)
        if profile.mapping != AsyncRingMapping.DirectRequired or
           evidence.provider_mapping != RingMappingGrade.Direct:
            return Err(MissionRingAdapterError.DirectMappingRequired)
        if profile.fallback_allowed or evidence.fallback_selected:
            return Err(MissionRingAdapterError.FallbackForbidden)
        if self.capacity_value_field.to_u64() > profile.bounds.max_operations:
            return Err(MissionRingAdapterError.CapacityExceedsProfile)
        if evidence.task_slots < profile.bounds.max_tasks:
            return Err(MissionRingAdapterError.TaskCapacityInsufficient)
        if evidence.operation_slots < profile.bounds.max_operations:
            return Err(MissionRingAdapterError.OperationCapacityInsufficient)
        if evidence.buffer_slots < profile.bounds.max_buffers:
            return Err(MissionRingAdapterError.BufferCapacityInsufficient)
        if evidence.trace_slots < profile.bounds.max_traces:
            return Err(MissionRingAdapterError.TraceCapacityInsufficient)
        if evidence.deadline_slots < profile.bounds.max_deadlines:
            return Err(MissionRingAdapterError.DeadlineCapacityInsufficient)
        if evidence.timer_slots < profile.bounds.max_deadlines:
            return Err(MissionRingAdapterError.TimerCapacityInsufficient)
        if evidence.join_cancel_slots < profile.bounds.max_tasks:
            return Err(MissionRingAdapterError.JoinCancelCapacityInsufficient)
        if evidence.maximum_frame_bytes == 0u64 or
           evidence.compiler_known_frame_bytes == 0u64:
            return Err(MissionRingAdapterError.FrameBoundRequired)
        if evidence.compiler_known_frame_bytes > evidence.maximum_frame_bytes:
            return Err(MissionRingAdapterError.FrameBoundExceeded)
        match profile.preset:
            case AsyncProfilePreset.MissionAlloc:
                if profile.memory != AsyncMemory.Arena or not evidence.sealed_arena:
                    return Err(MissionRingAdapterError.SealedArenaRequired)
                if evidence.arena_capacity < self.capacity_value_field.to_u64():
                    return Err(MissionRingAdapterError.ArenaCapacityInsufficient)
            case AsyncProfilePreset.MissionPool:
                if (profile.memory != AsyncMemory.Pool and
                    profile.memory != AsyncMemory.Static) or
                   not evidence.static_pool_ready:
                    return Err(MissionRingAdapterError.StaticPoolRequired)
                if evidence.static_pool_capacity < self.capacity_value_field.to_u64():
                    return Err(MissionRingAdapterError.StaticPoolCapacityInsufficient)
            case _:
                return Err(MissionRingAdapterError.UnsupportedMissionPreset)
        val fingerprint = async_profile_fingerprint_v1(profile)
        self.profile_value = profile
        self.fingerprint_value = fingerprint
        self.lifecycle_value = MissionRingLifecycle.Ready
        Ok(MissionRingAdmissionReceipt(
            profile_id: profile.profile_id, profile_fingerprint: fingerprint,
            owner_id: self.owner_id_value, ring_id: self.ring_id_value,
            capacity: self.capacity_value_field.to_u64(),
            evidence_level: MissionRingEvidenceLevel.HostedPreallocatedV1,
            link_time_static_proven: false, allocation_free_proven: false))

    me quiesce(owner_id: u64) -> Result<(), MissionRingAdapterError>:
        val owner_check = self._owner_check(owner_id)
        if val error = owner_check:
            return Err(error)
        if self.lifecycle_value == MissionRingLifecycle.Quiesced:
            return Err(MissionRingAdapterError.AlreadyQuiesced)
        if self.lifecycle_value != MissionRingLifecycle.Ready:
            return Err(MissionRingAdapterError.NotReady)
        if self.ring_value.occupancy() != 0u64:
            return Err(MissionRingAdapterError.RingNotDrained)
        self.lifecycle_value = MissionRingLifecycle.Quiesced
        Ok(())

    me reserve(
        owner_id: u64, task_key: u64
    ) -> Result<RingReservation, MissionRingAdapterError>:
        val ready = self._ready_check(owner_id)
        if val error = ready:
            return Err(error)
        self._map_ring_reservation(self.ring_value.reserve(owner_id, task_key))

    me release(
        owner_id: u64, reservation: RingReservation
    ) -> Result<(), MissionRingAdapterError>:
        val ready = self._ready_check(owner_id)
        if val error = ready:
            return Err(error)
        match self.ring_value.release(owner_id, reservation):
            case Ok(_): Ok(())
            case Err(error): Err(MissionRingAdapterError.RingRejected(error))

    me commit(
        owner_id: u64, reservation: RingReservation, operation: Op
    ) -> Result<TaskPollResult<Cpl>, MissionRingAdapterError>:
        val ready = self._ready_check(owner_id)
        if val error = ready:
            return Err(error)
        match self.ring_value.commit(owner_id, reservation, operation):
            case Ok(token): Ok(TaskPollResult.Pending(token))
            case Err(error): Err(MissionRingAdapterError.RingRejected(error))

    me commit_batch(
        owner_id: u64, task_keys: [u64], operations: [Op]
    ) -> Result<RingBatchCommitReceipt, MissionRingAdapterError>:
        val ready = self._ready_check(owner_id)
        if val error = ready:
            return Err(error)
        match self.ring_value.commit_batch(
            owner_id, task_keys, operations, RingBatchPolicy.AllOrNothing):
            case Ok(receipt): Ok(receipt)
            case Err(error): Err(MissionRingAdapterError.RingRejected(error))

    me provider_take(
        owner_id: u64
    ) -> Result<RingSubmission<Op>?, MissionRingAdapterError>:
        val ready = self._ready_check(owner_id)
        if val error = ready:
            return Err(error)
        match self.ring_value.provider_take(1):
            case Ok(value): Ok(value)
            case Err(error): Err(MissionRingAdapterError.RingRejected(error))

    me complete_success(
        owner_id: u64, submission: RingSubmission<Op>, value: Cpl
    ) -> Result<MissionRingWake, MissionRingAdapterError>:
        val ready = self._ready_check(owner_id)
        if val error = ready:
            return Err(error)
        match self.ring_value.complete_success(submission.token, value):
            case Ok(_): Ok(self._wake(submission, RingTerminalKind.Success))
            case Err(error): Err(MissionRingAdapterError.RingRejected(error))

    me complete_failure(
        owner_id: u64, submission: RingSubmission<Op>, error_text: text
    ) -> Result<MissionRingWake, MissionRingAdapterError>:
        val ready = self._ready_check(owner_id)
        if val error = ready:
            return Err(error)
        match self.ring_value.complete_failure(submission.token, error_text):
            case Ok(_): Ok(self._wake(submission, RingTerminalKind.Failure))
            case Err(error): Err(MissionRingAdapterError.RingRejected(error))

    me complete_cancelled(
        owner_id: u64, submission: RingSubmission<Op>, reason: text
    ) -> Result<MissionRingWake, MissionRingAdapterError>:
        val ready = self._ready_check(owner_id)
        if val error = ready:
            return Err(error)
        match self.ring_value.complete_cancelled(submission.token, reason):
            case Ok(_): Ok(self._wake(submission, RingTerminalKind.Cancelled))
            case Err(error): Err(MissionRingAdapterError.RingRejected(error))

    me take_completion(
        owner_id: u64
    ) -> Result<RingCompletion<Cpl>?, MissionRingAdapterError>:
        val ready = self._ready_check(owner_id)
        if val error = ready:
            return Err(error)
        match self.ring_value.take_completion(owner_id):
            case Ok(value): Ok(value)
            case Err(error): Err(MissionRingAdapterError.RingRejected(error))

    me cancel(owner_id: u64, token: RingToken) -> Result<RingCancelOutcome, MissionRingAdapterError>:
        val ready = self._ready_check(owner_id)
        if val error = ready:
            return Err(error)
        Ok(self.ring_value.cancel(owner_id, token))

    me reset(owner_id: u64) -> Result<RingResetReceipt, MissionRingAdapterError>:
        val ready = self._ready_check(owner_id)
        if val error = ready:
            return Err(error)
        match self.ring_value.reset(owner_id):
            case Ok(receipt): Ok(receipt)
            case Err(error): Err(MissionRingAdapterError.RingRejected(error))

    fn lifecycle() -> MissionRingLifecycle: self.lifecycle_value
    fn owner_id() -> u64: self.owner_id_value
    fn capacity() -> i64: self.capacity_value_field
    fn profile_fingerprint() -> text: self.fingerprint_value
    fn occupancy() -> u64: self.ring_value.occupancy()
    fn telemetry() -> RingTelemetry: self.ring_value.telemetry()

    fn _owner_check(owner_id: u64) -> MissionRingAdapterError?:
        if owner_id != self.owner_id_value:
            MissionRingAdapterError.WrongOwner
        else:
            nil

    fn _ready_check(owner_id: u64) -> MissionRingAdapterError?:
        val owner_check = self._owner_check(owner_id)
        if owner_check != nil:
            return owner_check
        if self.lifecycle_value != MissionRingLifecycle.Ready:
            return MissionRingAdapterError.NotReady
        nil

    fn _map_ring_reservation(
        result: Result<RingReservation, SimpleRingError>
    ) -> Result<RingReservation, MissionRingAdapterError>:
        match result:
            case Ok(value): Ok(value)
            case Err(error): Err(MissionRingAdapterError.RingRejected(error))

    fn _wake(submission: RingSubmission<Op>, kind: RingTerminalKind) -> MissionRingWake:
        MissionRingWake(token: submission.token, wake_key: submission.task_key, kind: kind)

export MissionRingLifecycle, MissionRingEvidenceLevel, MissionRingEvidence
export MissionRingAdmissionReceipt, MissionRingWake, MissionRingAdapterError
export MissionSimpleRingAdapter
