# Restrictive invocation DATA over an actual opaque contained compatibility
# selection. Policy/source/task DTOs do not grant TaskRef access or execution.
# No proof constructor, effect API, Host open, journal or terminal exists here.
use std.common.contracts.provider_cli.adapter_types_v1.{ProviderCliProviderV1, ProviderCliVersionDataV1}
use std.common.contracts.provider_cli.codex_interactive_v1.{ProviderCliCodexInteractiveRequestDataV1,
    plan_provider_cli_codex_interactive_v1}
use std.nogc_async_mut.llm.provider_cli_container_probe_v1.{ProviderCliContainedSelectionV1, ProviderCliContainedProbeReceiptV1,
    ProviderCliContainedProbeSnapshotV1}
use std.common.contracts.orchestration.desired_input_v1.{ControllerDesiredInputV1, controller_desired_input_encode_v1}
use std.common.contracts.orchestration.agent_policy_resolution_v1.AgentPolicyResolutionV1
use std.common.contracts.orchestration.agent_invocation_binding_v1.AgentTaskInputV1
use std.common.contracts.orchestration.resource_set_v1.{ResourceSetItemV1, resource_set_item_identity}
use std.common.contracts.container.execution_v2.container_host_scope_bytes_v2
use std.common.build_manager.contracts.builder_digest_valid_v1
use std.common.crypto.sha256.sha256_text
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical

pub struct ProviderCliInteractiveIntentDataV1:
    controller_id: text
    session_uid: text
    source_digest: text
    catalog_digest: text
    task_digest: text
    provider_version: text
    requested_image_ref: text
    image_config_id: text
    program_binding_digest: text
    scope_bytes: text
    provider_generation: i64
    program_prefix: [text]
    argv: [text]
    raw_prompt_digest: text
    expected_normalized_prompt_digest: text
    binding_digest: text

pub fn build_provider_cli_interactive_intent_data_v1(selection: ProviderCliContainedSelectionV1,
        version_receipt: ProviderCliContainedProbeReceiptV1, source: ControllerDesiredInputV1,
        policy: AgentPolicyResolutionV1, task: AgentTaskInputV1,
        request: ProviderCliCodexInteractiveRequestDataV1) -> Result<ProviderCliInteractiveIntentDataV1, text>:
    build_provider_cli_interactive_intent_from_data_v1(selection.version_data_v1(), selection.binding_digest_v1(),
        version_receipt.snapshot_v1(), source, policy, task, request)

# milestone_0021 F20: the V1 body over DATA (version, binding digest, version-probe snapshot), so a V4 agent can
# feed its V2 selection (`version_data_v2`, `binding_digest_v2`, receipt 0 `snapshot_v2()?.base`). No V1 change.
pub fn build_provider_cli_interactive_intent_from_data_v1(version: ProviderCliVersionDataV1, binding_digest: text,
        observed: ProviderCliContainedProbeSnapshotV1, source: ControllerDesiredInputV1,
        policy: AgentPolicyResolutionV1, task: AgentTaskInputV1,
        request: ProviderCliCodexInteractiveRequestDataV1) -> Result<ProviderCliInteractiveIntentDataV1, text>:
    val source_bytes = controller_desired_input_encode_v1(source)?
    if (not builder_digest_valid_v1(policy.source_digest) or not builder_digest_valid_v1(policy.catalog_digest) or
            source.source_digest != policy.source_digest or source.resource_identity !=
                resource_set_item_identity(ResourceSetItemV1.AgentSession(policy.session))):
        return Err("interactive-intent-retained-source-mismatch")
    if policy.session.agent.provider != "codex" or policy.session.session.frontend != "smux":
        return Err("interactive-intent-codex-smux-required")
    if task.ns != policy.session.meta.ns or task.reference != policy.session.agent.task_ref:
        return Err("interactive-intent-task-reference-mismatch")
    if task.content.byte_len() > 4096 or request.prompt != task.content:
        return Err("interactive-intent-task-prompt-mismatch")
    if not builder_digest_valid_v1(task.content_digest) or sha256_text(task.content) != task.content_digest:
        return Err("interactive-intent-task-content-mismatch")
    if (version.provider != ProviderCliProviderV1.Codex or observed.provider != version.provider or
            observed.probe_index != 0 or observed.program_binding_digest != binding_digest):
        return Err("interactive-intent-selection-receipt-mismatch")
    val planned = plan_provider_cli_codex_interactive_v1(version, request)?
    if policy.session.template.containers.len() != 1:
        return Err("interactive-intent-single-container-required")
    val container = policy.session.template.containers[0]
    if container.command.len() != 0 or container.args.len() != 0:
        return Err("interactive-intent-adapter-owned-command-required")
    if container.image != observed.configuration.requested_image_ref:
        return Err("interactive-intent-image-reference-unresolved-or-mismatched")
    if observed.program_prefix.len() != 1: return Err("interactive-intent-codex-program-mapping-required")
    var prefix: [text] = []
    var argv: [text] = []
    for argument in observed.program_prefix:
        prefix.push(argument)
        argv.push(argument)
    for argument in planned.argv: argv.push(argument)
    var bytes = 0
    var argument_digests: [SdnValue] = []
    for argument in argv:
        bytes = bytes + argument.byte_len()
        if bytes > 8192: return Err("interactive-intent-final-argv-byte-bound")
        argument_digests.push(SdnValue.String(sha256_text(argument)))
    val scope = container_host_scope_bytes_v2(observed.configuration.scope)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1),
        "kind": SdnValue.String("provider-cli-interactive-intent"), "mode": SdnValue.String("codex-root-interactive-argv-v1"),
        "sourceObjectDigest": SdnValue.String(sha256_text(source_bytes)), "sourceDigest": SdnValue.String(policy.source_digest),
        "catalogDigest": SdnValue.String(policy.catalog_digest), "taskNamespaceDigest": SdnValue.String(sha256_text(task.ns)),
        "taskReferenceDigest": SdnValue.String(sha256_text(task.reference)), "taskDigest": SdnValue.String(task.content_digest),
        "providerVersion": SdnValue.String(version.version),
        "requestedImageRefDigest": SdnValue.String(sha256_text(observed.configuration.requested_image_ref)),
        "imageConfigId": SdnValue.String(observed.configuration.image_config_id),
        "programBindingDigest": SdnValue.String(observed.program_binding_digest), "scopeDigest": SdnValue.String(sha256_text(scope)),
        "argumentDigests": SdnValue.Array(argument_digests), "rawPromptDigest": SdnValue.String(planned.raw_prompt_digest),
        "expectedNormalizedPromptDigest": SdnValue.String(planned.expected_normalized_prompt_digest),
        "terminalMode": SdnValue.String("tty"), "persistent": SdnValue.Bool(policy.session.session.persistent),
        "disconnectPolicy": SdnValue.String(policy.session.session.disconnect_policy),
        "repositoryRefDigest": SdnValue.String(sha256_text(policy.session.workspace.repository_ref)),
        "revisionRefDigest": SdnValue.String(sha256_text(policy.session.workspace.revision_ref)),
        "workspaceIsolation": SdnValue.String(policy.session.workspace.isolation),
        "workspaceRetention": SdnValue.String(policy.session.workspace.retention)}
    Ok(ProviderCliInteractiveIntentDataV1(controller_id: source.controller_id, session_uid: source.workload_uid,
        source_digest: policy.source_digest, catalog_digest: policy.catalog_digest, task_digest: task.content_digest,
        provider_version: version.version, requested_image_ref: observed.configuration.requested_image_ref,
        image_config_id: observed.configuration.image_config_id, program_binding_digest: observed.program_binding_digest,
        scope_bytes: scope, provider_generation: observed.configuration.scope.provider_generation,
        program_prefix: prefix, argv: argv, raw_prompt_digest: planned.raw_prompt_digest,
        expected_normalized_prompt_digest: planned.expected_normalized_prompt_digest,
        binding_digest: sha256_text(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")))
