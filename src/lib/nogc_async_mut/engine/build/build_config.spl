# Build Config — Target platforms and asset bundling
#
# Defines build targets (platform + arch) and asset bundle management
# for the game build pipeline.
#
# Usage:
#   val target = BuildTarget.windows_x64()
#   var bundle = AssetBundle.new("main_assets")
#   bundle.add_entry(AssetBundleEntry(
#       name: "player_tex",
#       source_path: "assets/player.png",
#       asset_type: "texture",
#       compressed: true,
#       size_bytes: 4096
#   ))

# ============================================================================
# BuildTarget — platform + architecture pair
# ============================================================================

struct BuildTarget:
    """Identifies a build target by platform, architecture, and debug mode."""
    platform: text
    arch: text
    debug_mode: bool

impl BuildTarget:
    static fn windows_x64() -> BuildTarget:
        """Create a Windows x86_64 debug target."""
        BuildTarget(platform: "windows", arch: "x86_64", debug_mode: true)

    static fn linux_x64() -> BuildTarget:
        """Create a Linux x86_64 debug target."""
        BuildTarget(platform: "linux", arch: "x86_64", debug_mode: true)

    static fn macos_arm64() -> BuildTarget:
        """Create a macOS aarch64 debug target."""
        BuildTarget(platform: "macos", arch: "aarch64", debug_mode: true)

    static fn web() -> BuildTarget:
        """Create a Web (wasm32) debug target."""
        BuildTarget(platform: "web", arch: "wasm32", debug_mode: true)

    fn triple() -> text:
        """Return the target triple string, e.g. 'x86_64-windows'."""
        self.arch + "-" + self.platform

# ============================================================================
# AssetBundleEntry — single asset in a bundle
# ============================================================================

struct AssetBundleEntry:
    """Describes a single asset within a bundle."""
    name: text
    source_path: text
    asset_type: text
    compressed: bool
    size_bytes: i64

# ============================================================================
# AssetBundle — collection of asset entries
# ============================================================================

class AssetBundle:
    """Manages a named collection of asset bundle entries."""
    name: text
    entries: [AssetBundleEntry]
    total_size: i64

impl AssetBundle:
    static fn new(name: text) -> AssetBundle:
        """Create an empty asset bundle with the given name."""
        AssetBundle(name: name, entries: [], total_size: 0)

    me add_entry(entry: AssetBundleEntry):
        """Add an asset entry and update total size."""
        self.total_size = self.total_size + entry.size_bytes
        self.entries.push(entry)

    fn entry_count() -> i32:
        """Return the number of entries in this bundle."""
        self.entries.len()

    fn total_compressed_size() -> i64:
        """Return the sum of size_bytes for compressed entries."""
        var sum: i64 = 0
        var i = 0
        while i < self.entries.len():
            if self.entries[i].compressed:
                sum = sum + self.entries[i].size_bytes
            i = i + 1
        sum

    fn find_by_type(asset_type: text) -> [AssetBundleEntry]:
        """Return all entries matching the given asset_type."""
        var result: [AssetBundleEntry] = []
        var i = 0
        while i < self.entries.len():
            if self.entries[i].asset_type == asset_type:
                result.push(self.entries[i])
            i = i + 1
        result
