"""Experimental device-initiated backend lane with explicit gate."""

use std.common.compute.placement_contracts.backend.{
    PlacementBackend,
    PlacementCapabilities,
    PlacementError,
    PlacementPlan,
    LeaseSet,
    TransferReceipt,
    CheckpointReceipt,
    RecoveryReceipt,
    PlacementRequestArenaRef
}
use std.common.compute.placement_contracts.semantic.{BackendId, ObjectSetView, DeviceMask}
use std.common.compute.placement_contracts.storage.{ArtifactId, artifact_id}
use std.common.compute.placement_contracts.planner.{PlacementBudget, CostEstimate}
use std.common.compute.placement_contracts.handles.{ObjectRef, object_ref}
use std.common.compute.placement_contracts.semantic.{PlacementRequestArena, Hash256}

class DeviceInitiatedPlacementBackend:
    pass_dn

impl PlacementBackend for DeviceInitiatedPlacementBackend:
    fn probe() -> PlacementCapabilities:
        PlacementCapabilities(
            backend: BackendId(value: "device_initiated"),
            available: true,
            production: false,
            supported_tiers: [],
            device_mask: DeviceMask(value: 0),
            reason: "experimental path gated"
        )

    fn plan(requests: PlacementRequestArenaRef, budget: PlacementBudget) -> PlacementPlan:
        PlacementPlan(
            reservations: request_ref(8),
            transfers: request_ref(9),
            evictions: request_ref(10),
            prefetches: request_ref(11),
            leases: request_ref(12),
            estimated_cost: budget_to_cost_estimate(budget),
            receipt_seed: Hash256(value: "device_initiated_seed")
        )

    fn acquire(plan: PlacementPlan) -> Result<LeaseSet, PlacementError>:
        Err(PlacementError.Unsupported)

    fn prefetch(plan: PlacementPlan) -> Result<TransferReceipt, PlacementError>:
        Err(PlacementError.Unsupported)

    fn checkpoint(objects: ObjectSetView) -> CheckpointReceipt:
        CheckpointReceipt(
            ok: true,
            root: artifact_id(digest: "", byte_len: 0),
            object_count: objects.objects.len() as i64,
            bytes_written: 0,
            error: ""
        )

    fn release(leases: LeaseSet):
        pass

    fn recover(root: ArtifactId) -> RecoveryReceipt:
        RecoveryReceipt(ok: false, root: root, recovered_objects: 0, error: "not-enabled")

fn request_ref(slot: u32) -> ObjectRef<PlacementRequestArena>:
    object_ref(object_slot: slot, generation: 1)

fn budget_to_cost_estimate(budget: PlacementBudget) -> CostEstimate:
    CostEstimate(
        cpu_work: 0,
        simd_work: 0,
        gpu_work: 0,
        host_to_device_bytes: 0,
        device_to_host_bytes: 0,
        ssd_read_bytes: 0,
        ssd_write_bytes: 0,
        synchronization_points: 0,
        predicted_latency_us: 0,
        confidence_milli: 0
    )

export DeviceInitiatedPlacementBackend
export request_ref, budget_to_cost_estimate
