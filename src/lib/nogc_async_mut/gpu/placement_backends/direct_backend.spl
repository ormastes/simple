"""Direct backend: optional capability-gated path, parity-checked against staged."""

use std.common.compute.placement_contracts.backend.{
    PlacementBackend,
    PlacementCapabilities,
    PlacementError,
    PlacementPlan,
    LeaseSet,
    TransferReceipt,
    CheckpointReceipt,
    RecoveryReceipt,
    PlacementRequestArenaRef
}
use std.common.compute.placement_contracts.semantic.{BackendId, ObjectSetView, Hash256, DeviceMask, PlacementRequestArena}
use std.common.compute.placement_contracts.handles.{ObjectRef, object_ref}
use std.common.compute.placement_contracts.planner.{CostEstimate}
use std.common.compute.placement_contracts.storage.{ArtifactId, artifact_id, artifact_id_valid}
use std.common.compute.placement_contracts.planner.{PlacementBudget}

class DirectPlacementBackend:
    pass_dn

impl PlacementBackend for DirectPlacementBackend:
    fn probe() -> PlacementCapabilities:
        PlacementCapabilities(
            backend: BackendId(value: "direct"),
            available: true,
            production: true,
            supported_tiers: [],
            device_mask: DeviceMask(value: 0),
            reason: "direct backend is optional and may be disabled"
        )

    fn plan(requests: PlacementRequestArenaRef, budget: PlacementBudget) -> PlacementPlan:
        PlacementPlan(
            reservations: request_ref(0),
            transfers: request_ref(1),
            evictions: request_ref(2),
            prefetches: request_ref(3),
            leases: request_ref(4),
            estimated_cost: budget_to_cost_estimate(budget),
            receipt_seed: object_ref_from_text("direct_seed")
        )

    fn acquire(plan: PlacementPlan) -> Result<LeaseSet, PlacementError>:
        Ok(LeaseSet(leases: []))

    fn prefetch(plan: PlacementPlan) -> Result<TransferReceipt, PlacementError>:
        Ok(TransferReceipt(
            artifact_id: artifact_id(digest: "", byte_len: 0),
            backend: "direct",
            sequence: 0,
            ring_slot: 0,
            bytes_transferred: 0,
            device_address: 0,
            checksum: "",
            completed: true,
            error: ""
        ))

    fn checkpoint(objects: ObjectSetView) -> CheckpointReceipt:
        CheckpointReceipt(
            ok: true,
            root: artifact_id(digest: "", byte_len: 0),
            object_count: objects.objects.len() as i64,
            bytes_written: 0,
            error: ""
        )

    fn release(leases: LeaseSet):
        pass

    fn recover(root: ArtifactId) -> RecoveryReceipt:
        if artifact_id_valid(root):
            RecoveryReceipt(ok: true, root: root, recovered_objects: 0, error: "")
        else:
            RecoveryReceipt(ok: false, root: root, recovered_objects: 0, error: "unsupported")

fn request_ref(slot: u32) -> ObjectRef<PlacementRequestArena>:
    object_ref(object_slot: slot, generation: 1)

fn budget_to_cost_estimate(budget: PlacementBudget) -> CostEstimate:
    CostEstimate(
        cpu_work: 0,
        simd_work: 0,
        gpu_work: budget.device_bytes,
        host_to_device_bytes: 0,
        device_to_host_bytes: 0,
        ssd_read_bytes: 0,
        ssd_write_bytes: 0,
        synchronization_points: 0,
        predicted_latency_us: 0,
        confidence_milli: 0
    )

fn object_ref_from_text(token: text) -> Hash256:
    Hash256(value: token)

export DirectPlacementBackend
export request_ref, budget_to_cost_estimate, object_ref_from_text
