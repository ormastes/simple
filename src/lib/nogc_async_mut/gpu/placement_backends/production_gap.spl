"""Concrete production blocker for the mandatory staged backend."""

class PlacementProductionGap:
    capability: text
    facade_checked: text
    missing_primitive: text
    resume_gate: text

fn staged_production_gap() -> PlacementProductionGap:
    PlacementProductionGap(capability: "bounded-host-pinned-to-device-u8-transfer", facade_checked: "std.gpu.usm.usm_malloc_host + std.nogc_sync_mut.cuda.mod memcpy/synchronize", missing_primitive: "none in the CUDA transfer facade; frozen acquire() still needs a device-address/lease owner", resume_gate: "caller supplies a valid device lease address; non-CUDA hosts remain deterministic simulation")

export PlacementProductionGap, staged_production_gap
