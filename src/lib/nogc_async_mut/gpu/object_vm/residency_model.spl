"""CPU-reference residency planner: admission, eviction, and reason receipts.

PLACE lane phase 4 ("Planner. Liveness + reuse-distance scoring;
eviction/prefetch plans") of
`doc/03_plan/platform/structural_compute/gpu_mmu_plan.md`, restricted to what
is decidable on CPU. No device allocation, no Vulkan, no SSD backend here.

Shared rule 4 ("No silent fallback — every fallback carries a reason receipt")
is the load-bearing property of this file: a residency MISS, an EVICTION and a
REJECTION each carry a receipt naming the slot, the tiers, the byte counts and
the bound that forced the outcome. A decision with an empty reason is a HIT and
nothing else.

Shared rule 3: this is the oracle. A real staged/direct backend must produce the
same decision sequence for the same inputs.

INTERPRETATION (the plan is silent; recorded, not decided here):
  * The frozen `PlacementRequest` addresses its inputs through an opaque
    `ObjectRef<PlacementRequestArena>` whose element layout the plan never
    specifies. This model therefore takes an explicit request list. When that
    arena layout is frozen, this list becomes its CPU decoding, not a rival.
  * The plan lists `retain_score` as a "heuristic" without defining it. Here it
    is: admission sets it from the request priority, a hit increments it, and
    the lowest-scoring unprotected arena is evicted first with slot order as the
    deterministic tie-break. Any other scoring is a different oracle.
  * The plan names no admission target tier. Admission places into DeviceLocal.
  * The plan gives no policy for an arena whose `home_tier` is itself a device
    tier. Such an arena cannot be demoted and is treated as unevictable; the
    rejection receipt counts it separately.
"""

use common.compute.placement_contracts.planner.{PlacementBudget}
use common.compute.placement_contracts.schema.{PLACEMENT_SCHEMA_VERSION, PLACEMENT_NO_EPOCH, residency_tier_is_device, residency_tier_name}
use nogc_async_mut.gpu.object_vm.descriptor_table.{ObjectVmDescriptorTable, object_vm_device_bytes, OBJECT_VM_UNKNOWN_SLOT, OBJECT_VM_STALE_GENERATION}

val OBJECT_VM_TIER_DEVICE_LOCAL: i64 = 0

val OBJECT_VM_BUDGET_UNSET: text = "object_vm_budget_unset"
val OBJECT_VM_BUDGET_EXHAUSTED: text = "object_vm_device_budget_exhausted"
val OBJECT_VM_RESIDENCY_MISS: text = "object_vm_residency_miss"
val OBJECT_VM_EVICTED: text = "object_vm_evicted"
val OBJECT_VM_TOO_LARGE: text = "object_vm_object_exceeds_budget"

pub enum ObjectVmDecisionKind:
    Hit
    Admitted
    Evicted
    Rejected

fn object_vm_decision_kind_to_u8(k: ObjectVmDecisionKind) -> i64:
    match k:
        case ObjectVmDecisionKind.Hit: 0
        case ObjectVmDecisionKind.Admitted: 1
        case ObjectVmDecisionKind.Evicted: 2
        case ObjectVmDecisionKind.Rejected: 3

# One request for device residency. `priority` seeds retain_score.
struct ObjectVmResidencyRequest:
    slot: i64
    generation: i64
    priority: i64

fn object_vm_residency_request(slot: i64, generation: i64, priority: i64) -> ObjectVmResidencyRequest:
    return ObjectVmResidencyRequest(slot: slot, generation: generation, priority: priority)

# `reason` is empty exactly when `kind` is Hit.
struct ObjectVmDecision:
    kind: ObjectVmDecisionKind
    slot: i64
    from_tier: i64
    to_tier: i64
    bytes: i64
    reason: text

# `reason` is empty exactly when `ok` is true. `table` is the post-plan table:
# the CPU reference applies its own decisions so eviction is observable.
struct ObjectVmPlacementPlan:
    schema_version: text
    ok: bool
    decisions: [ObjectVmDecision]
    hit_count: i64
    admit_count: i64
    evict_count: i64
    reject_count: i64
    device_bytes_used: i64
    device_bytes_limit: i64
    reason: text
    table: ObjectVmDescriptorTable

fn _ovm_decision(kind: ObjectVmDecisionKind, slot: i64, from_tier: i64, to_tier: i64, bytes: i64, reason: text) -> ObjectVmDecision:
    return ObjectVmDecision(
        kind: kind,
        slot: slot,
        from_tier: from_tier,
        to_tier: to_tier,
        bytes: bytes,
        reason: reason
    )

# Pick the eviction victim: lowest retain_score among live device-resident
# arenas that are unpinned, unleased, protected-free for this plan, and have a
# non-device home tier to fall back to. Returns -1 when none exists.
fn _ovm_pick_victim(t: ObjectVmDescriptorTable, protected: [i64]) -> i64:
    var best = -1
    var best_score = 0
    var i = 0
    while i < t.live.len():
        var eligible = t.live[i] == 1 and residency_tier_is_device(t.tier[i])
        if eligible and t.pinned[i] == 1: eligible = false
        if eligible and t.lease_count[i] > 0: eligible = false
        if eligible and protected[i] == 1: eligible = false
        if eligible and residency_tier_is_device(t.home_tier[i]): eligible = false
        if eligible:
            if best < 0 or t.retain_score[i] < best_score:
                best = i
                best_score = t.retain_score[i]
        i = i + 1
    return best

# Counts that make a rejection receipt actionable: the caller learns which
# protection class blocked reclaim, not just that reclaim failed.
fn _ovm_blocked_counts(t: ObjectVmDescriptorTable, protected: [i64]) -> [i64]:
    var pinned_n = 0
    var leased_n = 0
    var plan_n = 0
    var device_home_n = 0
    var i = 0
    while i < t.live.len():
        if t.live[i] == 1 and residency_tier_is_device(t.tier[i]):
            if t.pinned[i] == 1:
                pinned_n = pinned_n + 1
            elif t.lease_count[i] > 0:
                leased_n = leased_n + 1
            elif protected[i] == 1:
                plan_n = plan_n + 1
            elif residency_tier_is_device(t.home_tier[i]):
                device_home_n = device_home_n + 1
        i = i + 1
    return [pinned_n, leased_n, plan_n, device_home_n]

# CPU-reference residency plan. Requests are honoured in order; the order is
# part of the contract because eviction victims depend on it.
fn object_vm_plan_residency(table: ObjectVmDescriptorTable,
                            budget: PlacementBudget,
                            requests: [ObjectVmResidencyRequest]) -> ObjectVmPlacementPlan:
    var decisions: [ObjectVmDecision] = []

    # Fail closed on an unset bound. A zero device budget is NOT "unlimited" and
    # is never replaced by an invented default; the receipt names the field.
    if budget.device_bytes <= 0:
        return ObjectVmPlacementPlan(
            schema_version: PLACEMENT_SCHEMA_VERSION,
            ok: false,
            decisions: decisions,
            hit_count: 0,
            admit_count: 0,
            evict_count: 0,
            reject_count: 0,
            device_bytes_used: object_vm_device_bytes(table),
            device_bytes_limit: budget.device_bytes,
            reason: OBJECT_VM_BUDGET_UNSET
                + ": PlacementBudget.device_bytes=" + budget.device_bytes.to_text()
                + " requests=" + requests.len().to_text()
                + " unset bounds fail closed",
            table: table
        )

    var live = table.live
    var generations = table.generation
    var tiers = table.tier
    var homes = table.home_tier
    var lens = table.byte_len
    var addrs = table.device_address
    var epochs = table.lease_epoch
    var counts = table.lease_count
    var pins = table.pinned
    var scores = table.retain_score
    var next_address = table.next_address

    var protected: [i64] = []
    var p = 0
    while p < live.len():
        protected = protected.push(0)
        p = p + 1

    var used = object_vm_device_bytes(table)
    val limit = budget.device_bytes

    var hits = 0
    var admits = 0
    var evicts = 0
    var rejects = 0

    var r = 0
    while r < requests.len():
        val req = requests[r]
        val slot = req.slot

        if slot < 0 or slot >= live.len():
            decisions = decisions.push(_ovm_decision(ObjectVmDecisionKind.Rejected, slot, -1, -1, 0,
                OBJECT_VM_UNKNOWN_SLOT + ": slot=" + slot.to_text()
                    + " slot_count=" + live.len().to_text()))
            rejects = rejects + 1
            r = r + 1
            continue

        # A retired slot is a stale HANDLE, not an unknown slot: the same
        # ordering the descriptor table uses, so the two never disagree.
        if generations[slot] != req.generation or live[slot] != 1:
            decisions = decisions.push(_ovm_decision(ObjectVmDecisionKind.Rejected, slot, tiers[slot], -1, lens[slot],
                OBJECT_VM_STALE_GENERATION + ": slot=" + slot.to_text()
                    + " handle_generation=" + req.generation.to_text()
                    + " table_generation=" + generations[slot].to_text()
                    + " live=" + live[slot].to_text()))
            rejects = rejects + 1
            r = r + 1
            continue

        if residency_tier_is_device(tiers[slot]):
            protected[slot] = 1
            scores[slot] = scores[slot] + 1
            decisions = decisions.push(_ovm_decision(ObjectVmDecisionKind.Hit, slot, tiers[slot], tiers[slot], lens[slot], ""))
            hits = hits + 1
            r = r + 1
            continue

        val need = lens[slot]
        val from_tier = tiers[slot]

        if need > limit:
            decisions = decisions.push(_ovm_decision(ObjectVmDecisionKind.Rejected, slot, from_tier, OBJECT_VM_TIER_DEVICE_LOCAL, need,
                OBJECT_VM_TOO_LARGE + ": slot=" + slot.to_text()
                    + " bytes=" + need.to_text()
                    + " device_bytes_limit=" + limit.to_text()
                    + " single object cannot fit the device budget"))
            rejects = rejects + 1
            r = r + 1
            continue

        var admitted = false
        var blocked = false
        while not admitted and not blocked:
            if used + need <= limit:
                addrs[slot] = next_address
                next_address = next_address + need
                tiers[slot] = OBJECT_VM_TIER_DEVICE_LOCAL
                scores[slot] = req.priority
                protected[slot] = 1
                used = used + need
                decisions = decisions.push(_ovm_decision(ObjectVmDecisionKind.Admitted, slot, from_tier, OBJECT_VM_TIER_DEVICE_LOCAL, need,
                    OBJECT_VM_RESIDENCY_MISS + ": slot=" + slot.to_text()
                        + " from_tier=" + residency_tier_name(from_tier)
                        + " to_tier=" + residency_tier_name(OBJECT_VM_TIER_DEVICE_LOCAL)
                        + " bytes=" + need.to_text()
                        + " staged because the arena was not device resident"))
                admits = admits + 1
                admitted = true
            else:
                val snapshot = ObjectVmDescriptorTable(
                    live: live, generation: generations, tier: tiers, home_tier: homes,
                    byte_len: lens, device_address: addrs, lease_epoch: epochs,
                    lease_count: counts, pinned: pins, retain_score: scores,
                    next_epoch: table.next_epoch, next_address: next_address
                )
                val victim = _ovm_pick_victim(snapshot, protected)
                if victim < 0:
                    val blockers = _ovm_blocked_counts(snapshot, protected)
                    decisions = decisions.push(_ovm_decision(ObjectVmDecisionKind.Rejected, slot, from_tier, OBJECT_VM_TIER_DEVICE_LOCAL, need,
                        OBJECT_VM_BUDGET_EXHAUSTED + ": slot=" + slot.to_text()
                            + " need=" + need.to_text()
                            + " device_bytes_used=" + used.to_text()
                            + " device_bytes_limit=" + limit.to_text()
                            + " blocked_pinned=" + blockers[0].to_text()
                            + " blocked_leased=" + blockers[1].to_text()
                            + " blocked_by_this_plan=" + blockers[2].to_text()
                            + " blocked_device_home=" + blockers[3].to_text()))
                    rejects = rejects + 1
                    blocked = true
                else:
                    val victim_bytes = lens[victim]
                    val victim_to = homes[victim]
                    decisions = decisions.push(_ovm_decision(ObjectVmDecisionKind.Evicted, victim, tiers[victim], victim_to, victim_bytes,
                        OBJECT_VM_EVICTED + ": slot=" + victim.to_text()
                            + " retain_score=" + scores[victim].to_text()
                            + " bytes=" + victim_bytes.to_text()
                            + " to_tier=" + residency_tier_name(victim_to)
                            + " freeing device bytes for slot=" + slot.to_text()
                            + " need=" + need.to_text()))
                    tiers[victim] = victim_to
                    addrs[victim] = 0
                    epochs[victim] = PLACEMENT_NO_EPOCH
                    used = used - victim_bytes
                    evicts = evicts + 1
        r = r + 1

    val final_table = ObjectVmDescriptorTable(
        live: live, generation: generations, tier: tiers, home_tier: homes,
        byte_len: lens, device_address: addrs, lease_epoch: epochs,
        lease_count: counts, pinned: pins, retain_score: scores,
        next_epoch: table.next_epoch, next_address: next_address
    )

    var reason = ""
    if rejects > 0:
        reason = OBJECT_VM_BUDGET_EXHAUSTED + ": rejected=" + rejects.to_text()
            + " of " + requests.len().to_text() + " requests"

    return ObjectVmPlacementPlan(
        schema_version: PLACEMENT_SCHEMA_VERSION,
        ok: rejects == 0,
        decisions: decisions,
        hit_count: hits,
        admit_count: admits,
        evict_count: evicts,
        reject_count: rejects,
        device_bytes_used: used,
        device_bytes_limit: limit,
        reason: reason,
        table: final_table
    )

# Flatten a plan to one receipt line per non-hit decision. Hits contribute
# nothing: only fallbacks need receipts.
fn object_vm_plan_receipt(plan: ObjectVmPlacementPlan) -> text:
    if not plan.ok and plan.decisions.len() == 0:
        return plan.reason
    var parts: [text] = []
    var i = 0
    while i < plan.decisions.len():
        if plan.decisions[i].reason != "":
            parts = parts.push(plan.decisions[i].reason)
        i = i + 1
    return parts.join("; ")

export ObjectVmDecisionKind, ObjectVmResidencyRequest, ObjectVmDecision, ObjectVmPlacementPlan
export OBJECT_VM_TIER_DEVICE_LOCAL, OBJECT_VM_BUDGET_UNSET, OBJECT_VM_BUDGET_EXHAUSTED
export OBJECT_VM_RESIDENCY_MISS, OBJECT_VM_EVICTED, OBJECT_VM_TOO_LARGE
export object_vm_decision_kind_to_u8, object_vm_residency_request
export object_vm_plan_residency, object_vm_plan_receipt
