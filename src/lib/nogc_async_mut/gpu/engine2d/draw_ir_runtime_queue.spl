"""No-GC Draw IR runtime queue dispatch helpers.

This module owns the pure queue/payload side of Draw IR host-GPU dispatch.
Concrete rendering remains in backend-specific Engine2D modules; this layer
only decides whether a Draw IR batch becomes a runtime queue packet and records
the drain/dispatch receipt.
"""

use common.ui.draw_ir.{
    DRAW_IR_BACKEND_GPU,
    DrawIrBatch,
    draw_ir_composition,
    simple_2d_draw_ir_adv_plan
}
use common.ui.draw_ir_sdn.{draw_ir_to_sdn}
use common.contracts.execution.simple_ring_async_v1.{
    RingGeneration,
    RingPayloadLease,
    RingPayloadOwnership,
    RingToken
}
use common.gpu.engine2d.gpu_epoch.{
    ENGINE2D_GPU_PHASE_COMPLETED,
    ENGINE2D_GPU_PHASE_QUEUED,
    ENGINE2D_GPU_PHASE_RETIRED,
    ENGINE2D_GPU_PHASE_SUBMITTED,
    Engine2dGpuEpochReceipt,
    Engine2dGpuEpochRequest,
    engine2d_gpu_device_evidence_none,
    engine2d_gpu_epoch_admit,
    engine2d_gpu_epoch_advance,
    engine2d_gpu_truth_none
}
use std.nogc_async_mut.gpu.engine2d.backend_lane.{
    ENGINE2D_HOST_GPU_LANE_GPU,
    ENGINE2D_HOST_GPU_LANE_HOST,
    engine2d_host_gpu_lane_schedule
}
use std.nogc_async_mut.gpu.engine2d.host_gpu_event_queue.{
    ENGINE2D_HOST_GPU_RUNTIME_KIND_DRAW_IR,
    ENGINE2D_HOST_GPU_RUNTIME_LANE_GPU,
    Engine2dHostGpuRuntimeDispatchResult,
    Engine2dHostGpuRuntimeDrainResult,
    Engine2dHostGpuRuntimeQueue,
    Engine2dHostGpuRuntimeSubmitResult,
    engine2d_host_gpu_event,
    engine2d_host_gpu_event_handler_decision,
    engine2d_host_gpu_event_submit_to_runtime_payload_text,
    engine2d_host_gpu_runtime_emit_packet,
    engine2d_host_gpu_runtime_submit_with_payload,
    engine2d_host_gpu_runtime_submit_pending,
    engine2d_host_gpu_runtime_complete_pending,
    engine2d_host_gpu_runtime_drain,
    engine2d_host_gpu_runtime_dispatch_draw_ir
}
use std.diag.{dbg_stage, dbg_stage_on, dbg_event_hop, dbg_events_on, dbg_count, dbg_provenance}

struct Engine2dDrawIrPayloadSummary:
    schema: text
    batch_id: text
    source_kind: text
    source_id: text
    surface_id: text
    component_id: text
    command_count: i32
    packet_bytes: i64
    command_checksum: i64
    payload_sdn: text
    payload_sdn_bytes: i64
    summary: text

struct Engine2dDrawIrQueueDispatchResult:
    runtime_submit: Engine2dHostGpuRuntimeSubmitResult
    runtime_drain: Engine2dHostGpuRuntimeDrainResult
    runtime_dispatch: Engine2dHostGpuRuntimeDispatchResult
    queued_for_gpu: bool
    payload: Engine2dDrawIrPayloadSummary

struct Engine2dDrawIrDeferredReceipt:
    batch_id: text
    queue_handle: i64
    backend_handle: i64
    packet_id: i64
    packet_bytes: i64
    command_count: i64
    command_checksum: i64
    accepted: bool
    queued: bool
    terminal: bool
    status: text
    routing_evidence_only: bool
    device_execution_proven: bool
    diagnostic: text

fn _engine2d_draw_ir_deferred_receipt(batch: DrawIrBatch, queue: Engine2dHostGpuRuntimeQueue, packet_id: i64, packet_bytes: i64, command_count: i64, command_checksum: i64, accepted: bool, queued: bool, terminal: bool, status: text, diagnostic: text) -> Engine2dDrawIrDeferredReceipt:
    Engine2dDrawIrDeferredReceipt(
        batch_id: batch.batch_id,
        queue_handle: queue.queue_handle,
        backend_handle: queue.backend_handle,
        packet_id: packet_id,
        packet_bytes: packet_bytes,
        command_count: command_count,
        command_checksum: command_checksum,
        accepted: accepted,
        queued: queued,
        terminal: terminal,
        status: status,
        routing_evidence_only: true,
        device_execution_proven: false,
        diagnostic: diagnostic
    )

fn _engine2d_draw_ir_empty_submit(unit_id: text, status: text, diagnostic: text) -> Engine2dHostGpuRuntimeSubmitResult:
    Engine2dHostGpuRuntimeSubmitResult(submitted: false, status: status, queue_handle: 0, event_id: unit_id, packet_id: 0, packet_bytes: 0, payload_summary: "", diagnostic: diagnostic)

fn _engine2d_draw_ir_empty_drain(status: text, diagnostic: text) -> Engine2dHostGpuRuntimeDrainResult:
    Engine2dHostGpuRuntimeDrainResult(drained: 0, status: status, queue_handle: 0, last_backend_handle: 0, last_payload_size: 0, last_payload_hash: 0, last_payload_text: "", submitted_count: 0, completed_count: 0, last_status_code: 0, diagnostic: diagnostic)

fn _engine2d_draw_ir_empty_dispatch(status: text, diagnostic: text) -> Engine2dHostGpuRuntimeDispatchResult:
    Engine2dHostGpuRuntimeDispatchResult(dispatched: false, status: status, backend_name: "", queue_handle: 0, backend_handle: 0, payload_hash: 0, payload_size: 0, payload_text: "", diagnostic: diagnostic)

fn engine2d_draw_ir_payload_checksum(batch: DrawIrBatch) -> i64:
    var checksum: i64 = 0
    var i = 0
    while i < batch.commands.len():
        val command = batch.commands[i]
        checksum = (checksum + (i.to_i64() + 1) * 17) % 2147483647
        checksum = (checksum + command.kind.len().to_i64() * 31) % 2147483647
        checksum = (checksum + command.component_id.len().to_i64() * 37) % 2147483647
        checksum = (checksum + command.x.to_i64() * 41) % 2147483647
        checksum = (checksum + command.y.to_i64() * 43) % 2147483647
        checksum = (checksum + command.width.to_i64() * 47) % 2147483647
        checksum = (checksum + command.height.to_i64() * 53) % 2147483647
        checksum = (checksum + command.color.to_i64() * 59) % 2147483647
        checksum = (checksum + command.text_value.len().to_i64() * 61) % 2147483647
        i = i + 1
    checksum

fn engine2d_draw_ir_payload_summary_sdn_compat(batch: DrawIrBatch, packet_bytes: i64) -> Engine2dDrawIrPayloadSummary:
    """Compatibility/diagnostic payload adapter: serializes the batch to SDN text.

    This is the ONLY producer of DrawIR SDN text on this seam and it is retained
    for the legacy immediate-dispatch route and for human-readable diagnostics.
    It is not the packed hot path: it allocates a full SDN rendering of the
    batch per call. Registered packed ownership goes through
    `engine2d_draw_ir_runtime_queue_submit_packed`, which never serializes text.
    """
    val checksum = engine2d_draw_ir_payload_checksum(batch)
    val payload_sdn = draw_ir_to_sdn(draw_ir_composition("runtime-{batch.batch_id}", batch.batch_id, batch.backend_target, [batch]))
    val payload_sdn_bytes = payload_sdn.len().to_i64()
    Engine2dDrawIrPayloadSummary(
        schema: batch.schema,
        batch_id: batch.batch_id,
        source_kind: batch.source.source_kind,
        source_id: batch.source.source_id,
        surface_id: batch.embedding.surface_id,
        component_id: batch.embedding.component_id,
        command_count: batch.commands.len(),
        packet_bytes: packet_bytes,
        command_checksum: checksum,
        payload_sdn: payload_sdn,
        payload_sdn_bytes: payload_sdn_bytes,
        summary: "schema={batch.schema};batch={batch.batch_id};source={batch.source.source_kind}:{batch.source.source_id};surface={batch.embedding.surface_id};component={batch.embedding.component_id};commands={batch.commands.len()};bytes={packet_bytes};checksum={checksum};sdn_bytes={payload_sdn_bytes}"
    )

fn engine2d_draw_ir_runtime_queue_dispatch(batch: DrawIrBatch, selected_backend: text, command_count: i64, packet_bytes: i64, payload: Engine2dDrawIrPayloadSummary, queue: Engine2dHostGpuRuntimeQueue) -> Engine2dDrawIrQueueDispatchResult:
    var runtime_submit = _engine2d_draw_ir_empty_submit(batch.batch_id, "host", "Draw IR batch selected CPU path")
    var runtime_drain = _engine2d_draw_ir_empty_drain("empty", "runtime queue not used")
    var runtime_dispatch = _engine2d_draw_ir_empty_dispatch("host", "Draw IR batch selected CPU path")
    var queued_for_gpu = false
    if selected_backend == DRAW_IR_BACKEND_GPU:
        val lane_result = engine2d_host_gpu_lane_schedule(
            ENGINE2D_HOST_GPU_LANE_HOST,
            ENGINE2D_HOST_GPU_LANE_GPU,
            "draw_ir_delta",
            packet_bytes,
            queue.max_packet_bytes,
            false,
            false,
            queue.runtime_available,
            command_count
        )
        val event = engine2d_host_gpu_event(batch.batch_id, ENGINE2D_HOST_GPU_LANE_GPU, "draw_ir_delta", packet_bytes, queue.max_packet_bytes, false, false, false, queue.runtime_available)
        val decision = engine2d_host_gpu_event_handler_decision(event, lane_result)
        runtime_submit = engine2d_host_gpu_event_submit_to_runtime_payload_text(queue, decision, lane_result, payload.command_checksum, payload.payload_sdn)
        runtime_submit = engine2d_host_gpu_runtime_submit_with_payload(runtime_submit, payload.payload_sdn)
        queued_for_gpu = runtime_submit.submitted
        if dbg_stage_on() or dbg_events_on():
            dbg_stage("gpu_queue", "schedule")
            dbg_event_hop(batch.batch_id, "schedule", "backend={selected_backend} target={decision.target_lane} queue_required={decision.queue_required}")
            dbg_event_hop(batch.batch_id, "submit", "submitted={runtime_submit.submitted} status={runtime_submit.status} bytes={packet_bytes}")
    if queued_for_gpu:
        runtime_drain = engine2d_host_gpu_runtime_drain(queue, 1)
        runtime_dispatch = engine2d_host_gpu_runtime_dispatch_draw_ir(queue, runtime_drain, payload.command_checksum)
    if dbg_stage_on() or dbg_events_on():
        dbg_event_hop(batch.batch_id, "complete", "dispatched={runtime_dispatch.dispatched} status={runtime_dispatch.status}")
    if runtime_dispatch.dispatched:
        dbg_count("host_gpu.dispatched", 1)
    # Always-on provenance: claimed reflects our queue decision, actual reflects
    # the real runtime dispatch receipt. Fires loud only on a silent host<->gpu
    # divergence (e.g. queued for GPU but never dispatched). Reflects real state
    # only — never the removed fabricated estimated_ms speedup.
    val claimed_provenance = if queued_for_gpu: "gpu_batched" else: "host_committed"
    val actual_provenance = if runtime_dispatch.dispatched: "gpu_batched" else: "host_committed"
    dbg_provenance(claimed_provenance, actual_provenance, "engine2d_draw_ir_dispatch batch={batch.batch_id}")
    Engine2dDrawIrQueueDispatchResult(runtime_submit: runtime_submit, runtime_drain: runtime_drain, runtime_dispatch: runtime_dispatch, queued_for_gpu: queued_for_gpu, payload: payload)

fn engine2d_draw_ir_runtime_queue_dispatch_only(batch: DrawIrBatch, gpu_available: bool, queue: Engine2dHostGpuRuntimeQueue) -> Engine2dDrawIrQueueDispatchResult:
    val plan = simple_2d_draw_ir_adv_plan(batch, gpu_available)
    val packet_bytes = plan.command_count * 64
    val payload = engine2d_draw_ir_payload_summary_sdn_compat(batch, packet_bytes)
    engine2d_draw_ir_runtime_queue_dispatch(batch, plan.selected_backend, plan.command_count, packet_bytes, payload, queue)

fn engine2d_draw_ir_runtime_queue_submit_deferred(batch: DrawIrBatch, gpu_available: bool, queue: Engine2dHostGpuRuntimeQueue) -> Engine2dDrawIrDeferredReceipt:
    """Enqueue one bounded DrawIR route without draining or completing it.

    The packet contains only bounded routing metadata plus the caller-owned
    backend handle. It neither serializes DrawIR text nor claims that a packed
    payload is registered at that handle. The returned receipt proves queue
    admission only; callers advance the canonical runtime queue with
    `engine2d_host_gpu_runtime_submit_pending` and
    `engine2d_host_gpu_runtime_complete_pending`.
    """
    val plan = simple_2d_draw_ir_adv_plan(batch, gpu_available)
    val packet_bytes = plan.command_count * 64
    val checksum = engine2d_draw_ir_payload_checksum(batch)
    if plan.selected_backend != DRAW_IR_BACKEND_GPU:
        return _engine2d_draw_ir_deferred_receipt(batch, queue, 0, packet_bytes, plan.command_count, checksum, false, false, true, "host", "Draw IR batch selected CPU path")
    val lane_result = engine2d_host_gpu_lane_schedule(
        ENGINE2D_HOST_GPU_LANE_HOST,
        ENGINE2D_HOST_GPU_LANE_GPU,
        "draw_ir_delta",
        packet_bytes,
        queue.max_packet_bytes,
        false,
        false,
        queue.runtime_available,
        plan.command_count
    )
    val event = engine2d_host_gpu_event(batch.batch_id, ENGINE2D_HOST_GPU_LANE_GPU, "draw_ir_delta", packet_bytes, queue.max_packet_bytes, false, false, false, queue.runtime_available)
    val decision = engine2d_host_gpu_event_handler_decision(event, lane_result)
    if not decision.accepted or not decision.queue_required:
        return _engine2d_draw_ir_deferred_receipt(batch, queue, 0, packet_bytes, plan.command_count, checksum, false, false, true, "rejected", decision.reason)
    # Strict profile: an unavailable GPU backend schedules ok with
    # fallback_explicit set, which means "the caller may run this on the CPU".
    # A deferred GPU route has no CPU lane to fall back to, so it must reject
    # here instead of queueing a packet no device will ever execute.
    if lane_result.fallback_explicit:
        return _engine2d_draw_ir_deferred_receipt(batch, queue, 0, packet_bytes, plan.command_count, checksum, false, false, true, "rejected", "GPU backend unavailable; deferred routing has no CPU fallback lane")
    if queue.queue_handle <= 0:
        return _engine2d_draw_ir_deferred_receipt(batch, queue, 0, packet_bytes, plan.command_count, checksum, false, false, true, "runtime_unavailable", "runtime queue handle is not registered")
    if queue.backend_handle <= 0:
        return _engine2d_draw_ir_deferred_receipt(batch, queue, 0, packet_bytes, plan.command_count, checksum, false, false, true, "invalid_backend_handle", "positive backend handle required for deferred Draw IR routing")
    if packet_bytes > queue.max_packet_bytes:
        return _engine2d_draw_ir_deferred_receipt(batch, queue, 0, packet_bytes, plan.command_count, checksum, false, false, true, "packet_too_large", "packet exceeds runtime queue limit")
    val packet_id = engine2d_host_gpu_runtime_emit_packet(ENGINE2D_HOST_GPU_RUNTIME_LANE_GPU, ENGINE2D_HOST_GPU_RUNTIME_KIND_DRAW_IR, packet_bytes, queue.backend_handle)
    if packet_id <= 0:
        return _engine2d_draw_ir_deferred_receipt(batch, queue, 0, packet_bytes, plan.command_count, checksum, false, false, true, "queue_full_or_emit_failed", "bounded runtime queue rejected the packet")
    if dbg_stage_on() or dbg_events_on():
        dbg_stage("gpu_queue", "queued_deferred")
        dbg_event_hop(batch.batch_id, "enqueue", "status=queued packet_id={packet_id} bytes={packet_bytes} deferred=true")
    dbg_count("host_gpu.queued", 1)
    _engine2d_draw_ir_deferred_receipt(batch, queue, packet_id, packet_bytes, plan.command_count, checksum, true, true, false, "queued", "Draw IR routing metadata queued for deferred completion")

# --- Registered packed payload ownership (no SDN text on this path) ----------

fn engine2d_draw_ir_epoch_request_from_batch(batch: DrawIrBatch, profile: text, queue: Engine2dHostGpuRuntimeQueue, arena_handle: u64, queue_generation: u64, operation_generation: u64, scene_generation: u64, surface_generation: u64, arena_generation: u64) -> Engine2dGpuEpochRequest:
    """Freeze one DrawIR batch into a bounded epoch request with a registered payload lease.

    The lease names the arena the packed rows already live in; the request
    carries the batch's content hash, never its bytes and never its SDN text.
    """
    val command_count = batch.commands.len().to_i64()
    val packet_bytes = command_count * 64
    Engine2dGpuEpochRequest(
        profile: profile,
        queue_handle: queue.queue_handle,
        backend_handle: queue.backend_handle,
        queue_generation: queue_generation,
        operation_generation: operation_generation,
        scene_generation: scene_generation,
        surface_generation: surface_generation,
        arena_generation: arena_generation,
        payload_lease: RingPayloadLease(
            ownership: RingPayloadOwnership.RegisteredLease,
            owner_id: queue.backend_handle as u64,
            handle: arena_handle,
            generation: RingGeneration(value: arena_generation),
            byte_length: packet_bytes as u64
        ),
        command_count: command_count,
        packet_bytes: packet_bytes,
        content_hash: engine2d_draw_ir_payload_checksum(batch) as u64
    )

fn _engine2d_packed_refuse(request: Engine2dGpuEpochRequest, device_available: bool, available_capabilities: u32, diagnostic: text) -> Engine2dGpuEpochReceipt:
    var refused = engine2d_gpu_epoch_admit(request, nil, device_available, available_capabilities)
    refused.diagnostic = diagnostic
    refused

fn engine2d_draw_ir_runtime_queue_submit_packed(request: Engine2dGpuEpochRequest, queue: Engine2dHostGpuRuntimeQueue, device_available: bool, available_capabilities: u32) -> Engine2dGpuEpochReceipt:
    """Submit a registered packed payload as one bounded epoch; no text is serialized.

    Policy admission runs BEFORE the packet is emitted, so a refused profile
    never strands an orphan packet in the bounded queue. The emitted packet
    carries only routing metadata and the caller-owned backend handle: the
    packed rows stay in the arena named by the request's payload lease.
    """
    val preflight_token = RingToken(ring_id: queue.queue_handle as u64, slot: 0u64, generation: RingGeneration(value: request.queue_generation))
    val preflight = engine2d_gpu_epoch_admit(request, preflight_token, device_available, available_capabilities)
    if preflight.phase != ENGINE2D_GPU_PHASE_QUEUED:
        return preflight
    if queue.queue_handle <= 0:
        return _engine2d_packed_refuse(request, device_available, available_capabilities, "runtime queue handle is not registered")
    if queue.backend_handle <= 0:
        return _engine2d_packed_refuse(request, device_available, available_capabilities, "positive backend handle required for packed DrawIR routing")
    if request.packet_bytes > queue.max_packet_bytes:
        return _engine2d_packed_refuse(request, device_available, available_capabilities, "packet exceeds runtime queue limit")
    val packet_id = engine2d_host_gpu_runtime_emit_packet(ENGINE2D_HOST_GPU_RUNTIME_LANE_GPU, ENGINE2D_HOST_GPU_RUNTIME_KIND_DRAW_IR, request.packet_bytes, queue.backend_handle)
    if packet_id <= 0:
        return engine2d_gpu_epoch_admit(request, nil, device_available, available_capabilities)
    if dbg_stage_on() or dbg_events_on():
        dbg_stage("gpu_queue", "queued_packed")
        dbg_event_hop("packed", "enqueue", "status=queued packet_id={packet_id} bytes={request.packet_bytes} packed=true")
    dbg_count("host_gpu.queued", 1)
    val token = RingToken(ring_id: queue.queue_handle as u64, slot: packet_id as u64, generation: RingGeneration(value: request.queue_generation))
    engine2d_gpu_epoch_admit(request, token, device_available, available_capabilities)

fn engine2d_draw_ir_runtime_queue_complete_packed(receipt: Engine2dGpuEpochReceipt, queue: Engine2dHostGpuRuntimeQueue) -> Engine2dGpuEpochReceipt:
    """Advance one queued packed epoch through the compatibility provider phases.

    Routing evidence only: the provider exposes no queue-scoped fence or device
    timestamp, so the epoch advances with `engine2d_gpu_device_evidence_none()`
    and never claims device execution.
    """
    # TODO: [gpu][P2] with a real device attached, replace engine2d_gpu_device_evidence_none() here with provider evidence (binary identity, device name, driver identity, monotonic host submit/complete ns, negative control) and advance through ENGINE2D_GPU_PHASE_GPU_FINISHED so device_execution_proven can legitimately flip true
    val submitted = engine2d_host_gpu_runtime_submit_pending(queue, 1)
    if submitted.count <= 0:
        return receipt
    val advanced = engine2d_gpu_epoch_advance(receipt, ENGINE2D_GPU_PHASE_SUBMITTED, engine2d_gpu_device_evidence_none(), engine2d_gpu_truth_none())
    val completed = engine2d_host_gpu_runtime_complete_pending(queue, 1)
    if completed.count <= 0:
        return advanced
    engine2d_gpu_epoch_advance(advanced, ENGINE2D_GPU_PHASE_COMPLETED, engine2d_gpu_device_evidence_none(), engine2d_gpu_truth_none())

fn engine2d_draw_ir_runtime_queue_retire_packed(receipt: Engine2dGpuEpochReceipt, queue: Engine2dHostGpuRuntimeQueue) -> Engine2dGpuEpochReceipt:
    """Release the packed epoch's queue storage after completion; retirement is terminal.

    The compatibility provider retires a packet during completion, so the drain
    legitimately reports 0 here. Retirement is therefore gated on the completed
    phase and on the queue still being available, never on a drained count.
    """
    # TODO: [gpu][P2] with a real device attached, verify the arena named by the payload lease is only released after the device has signalled it is done with it; the compatibility provider has no fence, so this drain cannot prove that today
    if receipt.phase != ENGINE2D_GPU_PHASE_COMPLETED:
        return receipt
    val drained = engine2d_host_gpu_runtime_drain(queue, 1)
    if drained.status == "runtime_unavailable":
        return receipt
    engine2d_gpu_epoch_advance(receipt, ENGINE2D_GPU_PHASE_RETIRED, engine2d_gpu_device_evidence_none(), engine2d_gpu_truth_none())

