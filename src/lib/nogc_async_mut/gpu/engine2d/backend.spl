"""No-GC Engine2D backend traits and readback metadata helpers."""

class Engine2DReadback:
    # Must stay field-identical to std.gc_async_mut.gpu.engine2d.backend's
    # Engine2DReadback: type registration is keyed on the LEAF name, so the two
    # same-named declarations collide and the first-registered one supplies the
    # field layout for BOTH tiers (same hazard as the RenderBackend note below).
    # This mirror was missing device_identity, which JIT-failed every module
    # touching the gc-tier readback ("Cannot infer field type: 'device_identity'").
    pixels: [u32]
    source: text
    backend_handle: i64
    device_identity: i64
    pixel_count: i64
    checksum: i64

fn engine2d_readback_checksum(pixels: [u32]) -> i64:
    var checksum: i64 = 0
    var i = 0
    while i < pixels.len():
        checksum = (checksum + pixels[i].to_i64()) % 2147483647
        i = i + 1
    checksum

fn engine2d_readback_with_handle_reason(pixels: [u32], source: text, backend_handle: i64, reason: text) -> Engine2DReadback:
    engine2d_readback_with_handle(pixels, source, backend_handle)

fn engine2d_readback_with_reason(pixels: [u32], source: text, reason: text) -> Engine2DReadback:
    engine2d_readback_with_handle_reason(pixels, source, 0, reason)

fn engine2d_readback(pixels: [u32], source: text) -> Engine2DReadback:
    engine2d_readback_with_handle(pixels, source, 0)

fn engine2d_readback_with_handle(pixels: [u32], source: text, backend_handle: i64) -> Engine2DReadback:
    val checksum = engine2d_readback_checksum(pixels)
    Engine2DReadback(pixels: pixels, source: source, backend_handle: backend_handle, device_identity: 0, pixel_count: pixels.len().to_i64(), checksum: checksum)

trait RenderBackend:
    fn name() -> text
    me init(width: i32, height: i32) -> bool
    me shutdown()
    me clear(color: u32)
    me draw_rect(x: i32, y: i32, w: i32, h: i32, color: u32)
    me draw_rect_filled(x: i32, y: i32, w: i32, h: i32, color: u32)
    me draw_line(x1: i32, y1: i32, x2: i32, y2: i32, color: u32, thickness: i32)
    me draw_circle(cx: i32, cy: i32, r: i32, color: u32)
    me draw_circle_filled(cx: i32, cy: i32, r: i32, color: u32)
    me draw_rounded_rect(x: i32, y: i32, w: i32, h: i32, radius: i32, color: u32)
    me draw_triangle_filled(x1: i32, y1: i32, x2: i32, y2: i32, x3: i32, y3: i32, color: u32)
    me draw_gradient_rect(x: i32, y: i32, w: i32, h: i32, top_color: u32, bottom_color: u32)
    me draw_text(x: i32, y: i32, text_val: text, color: u32, font_size: i32)
    me draw_image(x: i32, y: i32, w: i32, h: i32, pixels: [u32])
    # Must stay in sync with std.gc_async_mut.gpu.engine2d.backend's
    # RenderBackend: the trait registry is keyed on the LEAF name, so the two
    # same-named declarations collide and the first-registered one supplies the
    # vtable slots for BOTH tiers. This mirror was missing draw_image_blend, so
    # every `RenderBackend.draw_image_blend()` lost its slot, fell back to
    # bare-name static dispatch, and hit CODEGEN-AMBIGUOUS-METHOD (30 candidates).
    me draw_image_blend(x: i32, y: i32, w: i32, h: i32, pixels: [u32])
    me set_clip(x: i32, y: i32, w: i32, h: i32)
    me clear_clip()
    me set_mask(mask_pixels: [u8], w: i32, h: i32)
    me clear_mask()
    me present()
    me submit_batch() -> bool
    fn read_pixels() -> [u32]
    fn read_pixels_with_source() -> Engine2DReadback
    fn width() -> i32
    fn height() -> i32

trait Engine2DExtended:
    me draw_text_bg(x: i32, y: i32, text_val: text, fg: u32, bg: u32, font_size: i32)

export Engine2DReadback
export engine2d_readback_checksum
export engine2d_readback_with_handle_reason
export engine2d_readback_with_reason
export engine2d_readback
export engine2d_readback_with_handle
export RenderBackend
export Engine2DExtended
