"""Virtio-gpu Venus ICD transport layer.

Serializes Vulkan API calls into virtio-gpu Venus protocol messages and
deserializes responses.  The dispatch structure is real; there is NO real
virtio-gpu transport wired up yet — no ring buffer, no device, no host
renderer.

FAIL-CLOSED BY DESIGN (2026-08-11): `_venus_transport_send` used to always
fabricate `VenusCallResult(is_ok: true, handle: <local counter>,
payload_size: 0)` regardless of whether any device existed. That reported
success for work that never happened. It now always reports
`VenusTransportError.unavailable` — the only honest answer, since
`_venus_device_available` has nothing real to check yet — and issues no
handle. See
doc/08_tracking/bug/vulkan_icd_virtio_and_gpu_probe_report_no_real_device_enumeration_2026-08-11.md.

When virtio transport is available, replace `_venus_device_available` with a
real device probe and `_venus_transport_send`'s success path with real
virtio-gpu ring buffer I/O. Keep the two failure shapes distinct:
  - `unavailable`: no virtio-gpu venus device/capset present (the normal
    case on this host and on any board today).
  - `failed`: a device was present and the operation genuinely errored.
Conflating them is how a real regression later reads as merely "not present".
"""

# ============================================================================
# Types
# ============================================================================

class VenusTransportConfig:
    device_path: text
    ring_size: i64
    protocol_version: i64

enum VenusCallStatus:
    Ok
    Unavailable
    Failed

class VenusCallResult:
    is_ok: bool
    error: text
    handle: i64
    payload_size: i64
    status: VenusCallStatus

enum VenusTransportError:
    Unavailable(text)
    Failed(text)

class VenusMessage:
    opcode: i64
    handle_in: i64
    size_in: i64

# ============================================================================
# Storage
# ============================================================================

var _venus_connected: bool = false
var _venus_device_path: text = ""
var _venus_ring_size: i64 = 0
var _venus_protocol_version: i64 = 0
var _venus_handle_ctr: i64 = 0

# Venus opcodes
var VENUS_OP_CREATE_INSTANCE: i64 = 1
var VENUS_OP_CREATE_DEVICE: i64 = 2
var VENUS_OP_ALLOCATE_MEMORY: i64 = 3
var VENUS_OP_CREATE_BUFFER: i64 = 4
var VENUS_OP_DESTROY_INSTANCE: i64 = 5

# ============================================================================
# Transport
# ============================================================================

# Real device availability check. There is no virtio-gpu venus transport
# implementation behind this yet (no ring buffer, no VIRTIO_GPU_CMD_*
# encode/decode, no host renderer handshake), so this is honestly always
# false today — matching the `qemu_only`/all-stages-false posture recorded
# for this backend in soc_profile.spl. This is the single place a future
# real transport wires in a genuine probe.
fn _venus_device_available() -> bool:
    false

fn _venus_transport_send(msg: VenusMessage) -> Result<VenusCallResult, VenusTransportError>:
    """Send a Venus protocol message over virtio-gpu.

    Fails closed: with no real transport wired up, this always reports
    `VenusTransportError.Unavailable` and issues no handle. When a real
    transport lands, this is where it writes to the virtio-gpu ring buffer
    and waits for the host renderer response, returning `Failed` for a
    genuine device-side error.
    """
    if not _venus_device_available():
        return Err(VenusTransportError.Unavailable("no-virtio-gpu-venus-device"))
    _venus_handle_ctr = _venus_handle_ctr + 1
    Ok(VenusCallResult(
        is_ok: true,
        error: "",
        handle: _venus_handle_ctr,
        payload_size: 0,
        status: VenusCallStatus.Ok
    ))

# Adapts a transport Result into the caller-facing VenusCallResult shape,
# preserving the unavailable/failed distinction in both `.error` (text, for
# existing callers) and `.status` (typed, so a caller cannot mistake
# unavailable for success by only checking a boolean).
fn _venus_result_from_transport(sent: Result<VenusCallResult, VenusTransportError>) -> VenusCallResult:
    match sent:
        Err(VenusTransportError.Unavailable(reason)):
            VenusCallResult(is_ok: false, error: "unavailable:{reason}", handle: 0, payload_size: 0, status: VenusCallStatus.Unavailable)
        Err(VenusTransportError.Failed(reason)):
            VenusCallResult(is_ok: false, error: "failed:{reason}", handle: 0, payload_size: 0, status: VenusCallStatus.Failed)
        Ok(result):
            result

# ============================================================================
# Public API
# ============================================================================

pub fn venus_icd_connect(device_path: text, ring_size: i64) -> bool:
    """Connect to a virtio-gpu Venus device.

    Args:
        device_path: path to the virtio-gpu device (e.g. "/dev/vgpu0")
        ring_size:   size of the virtio ring buffer

    Returns:
        true on success, false if device_path is empty.
    """
    if device_path == "":
        return false
    _venus_device_path = device_path
    _venus_ring_size = ring_size
    _venus_protocol_version = 1
    _venus_connected = true
    true

pub fn venus_icd_disconnect():
    """Disconnect from the virtio-gpu Venus device."""
    _venus_connected = false
    _venus_device_path = ""
    _venus_ring_size = 0
    _venus_handle_ctr = 0

pub fn venus_icd_is_connected() -> bool:
    """Return whether the transport is connected.

    Returns:
        true when connected, false otherwise.
    """
    _venus_connected

pub fn venus_icd_create_instance() -> VenusCallResult:
    """Create a Vulkan instance via Venus protocol.

    Returns:
        VenusCallResult with a new instance handle on success, or a typed
        unavailable/failed status — never a fabricated success.
    """
    if not _venus_connected:
        return VenusCallResult(is_ok: false, error: "not-connected", handle: 0, payload_size: 0, status: VenusCallStatus.Unavailable)
    val msg = VenusMessage(opcode: VENUS_OP_CREATE_INSTANCE, handle_in: 0, size_in: 0)
    _venus_result_from_transport(_venus_transport_send(msg))

pub fn venus_icd_create_device(instance_handle: i64) -> VenusCallResult:
    """Create a Vulkan device on a given instance.

    Args:
        instance_handle: handle from venus_icd_create_instance

    Returns:
        VenusCallResult with a new device handle on success, or a typed
        unavailable/failed status — never a fabricated success.
    """
    if not _venus_connected:
        return VenusCallResult(is_ok: false, error: "not-connected", handle: 0, payload_size: 0, status: VenusCallStatus.Unavailable)
    if instance_handle <= 0:
        return VenusCallResult(is_ok: false, error: "invalid-instance", handle: 0, payload_size: 0, status: VenusCallStatus.Failed)
    val msg = VenusMessage(opcode: VENUS_OP_CREATE_DEVICE, handle_in: instance_handle, size_in: 0)
    _venus_result_from_transport(_venus_transport_send(msg))

# @tag(device_handle=device_handle, size=step_count)
pub fn venus_icd_allocate_memory(device_handle: i64, size: i64) -> VenusCallResult:
    """Allocate device memory via Venus protocol.

    Args:
        device_handle: handle from venus_icd_create_device
        size:          allocation size in bytes

    Returns:
        VenusCallResult with a memory handle on success, or a typed
        unavailable/failed status — never a fabricated success.
    """
    if not _venus_connected:
        return VenusCallResult(is_ok: false, error: "not-connected", handle: 0, payload_size: 0, status: VenusCallStatus.Unavailable)
    if device_handle <= 0:
        return VenusCallResult(is_ok: false, error: "invalid-device", handle: 0, payload_size: 0, status: VenusCallStatus.Failed)
    val msg = VenusMessage(opcode: VENUS_OP_ALLOCATE_MEMORY, handle_in: device_handle, size_in: size)
    _venus_result_from_transport(_venus_transport_send(msg))

# @tag(device_handle=device_handle, size=step_count)
pub fn venus_icd_create_buffer(device_handle: i64, size: i64) -> VenusCallResult:
    """Create a buffer on a device via Venus protocol.

    Args:
        device_handle: handle from venus_icd_create_device
        size:          buffer size in bytes

    Returns:
        VenusCallResult with a buffer handle on success, or a typed
        unavailable/failed status — never a fabricated success.
    """
    if not _venus_connected:
        return VenusCallResult(is_ok: false, error: "not-connected", handle: 0, payload_size: 0, status: VenusCallStatus.Unavailable)
    if device_handle <= 0:
        return VenusCallResult(is_ok: false, error: "invalid-device", handle: 0, payload_size: 0, status: VenusCallStatus.Failed)
    val msg = VenusMessage(opcode: VENUS_OP_CREATE_BUFFER, handle_in: device_handle, size_in: size)
    _venus_result_from_transport(_venus_transport_send(msg))

pub fn venus_icd_destroy_instance(instance_handle: i64):
    """Destroy a Vulkan instance via Venus protocol.

    Args:
        instance_handle: handle from venus_icd_create_instance
    """
    if not _venus_connected:
        return
    if instance_handle <= 0:
        return
    val msg = VenusMessage(opcode: VENUS_OP_DESTROY_INSTANCE, handle_in: instance_handle, size_in: 0)
    _venus_transport_send(msg)

pub fn venus_icd_protocol_version() -> i64:
    """Return the Venus protocol version.

    Returns:
        Protocol version number (0 if not connected).
    """
    if not _venus_connected:
        return 0
    _venus_protocol_version
