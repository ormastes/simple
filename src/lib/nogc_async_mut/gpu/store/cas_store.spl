"""CAS store and checkpoint contracts for immutable placement artifacts."""
use std.common.compute.placement_contracts.storage.{ArtifactId, artifact_id, artifact_id_valid}
use std.common.compute.placement_contracts.semantic.{ObjectSetView, AnyObject, ObjectRef}
use std.common.compute.placement_contracts.backend.{CheckpointReceipt, RecoveryReceipt}
use std.common.base_encoding.utilities.{base_encoding_text_to_bytes as text_to_bytes}

class CasRecord:
    artifact: ArtifactId
    byte_len: i64
    manifest_root: ArtifactId
    bytes: [i64]

class CasManifest:
    root: ArtifactId
    object_ids: [ArtifactId]
    byte_count: i64

class CasObjectBinding:
    object_slot: u32
    generation: u32
    artifact: ArtifactId

class CasStore:
    """Pure in-memory CAS simulation for interface-first MMU development."""

    root_path: text
    records: [CasRecord]
    checkpoints: [CasManifest]
    object_bindings: [CasObjectBinding]

    static fn create(root_path: text) -> CasStore:
        CasStore(
            root_path: root_path,
            records: [],
            checkpoints: [],
            object_bindings: []
        )

    static fn open(root_path: text) -> Result<CasStore, text>:
        Ok(CasStore.create(root_path))

    fn write_bytes(self, payload: [i64], manifest_root: ArtifactId) -> ArtifactId:
        val digest = cas_store_digest(payload)
        val id = artifact_id(digest: digest, byte_len: payload.len())
        val existing = self._find_record_index(id)
        if existing < 0:
            self.records.push(CasRecord(
                artifact: id,
                byte_len: payload.len() as i64,
                manifest_root: manifest_root,
                bytes: payload
            ))
        id

    fn write_object_bytes(
        self,
        object: ObjectRef<AnyObject>,
        payload: [i64],
        manifest_root: ArtifactId
    ) -> ArtifactId:
        val artifact = self.write_bytes(payload, manifest_root)
        self._bind_object_artifact(object, artifact)
        artifact

    fn read_bytes(self, artifact: ArtifactId) -> [i64]?:
        val i = self._find_record_index(artifact)
        if i < 0:
            nil
        else:
            Some(self.records[i as i64].bytes)

    fn checkpoint(self, objects: ObjectSetView) -> CheckpointReceipt:
        var manifest_ids: [ArtifactId] = []
        var i = 0
        while i < objects.objects.len():
            val slot = objects.objects[i]
            val artifact = _lookup_artifact(self, slot)
            if val Some(found) = artifact:
                manifest_ids.push(found)
            else:
                return CheckpointReceipt(
                    ok: false,
                    root: ArtifactId(digest: "", byte_len: 0),
                    object_count: objects.objects.len() as i64,
                    bytes_written: 0,
                    error: "checkpoint-missing-artifact"
                )
            i = i + 1

        val checksum = cas_store_digest(_artifact_ids_to_bytes(manifest_ids))
        val bytes_total = manifest_ids.len() as i64
        val root = artifact_id(digest: checksum, byte_len: bytes_total)
        self.checkpoints.push(CasManifest(root: root, object_ids: manifest_ids, byte_count: bytes_total))
        CheckpointReceipt(ok: true, root: root, object_count: objects.objects.len(), bytes_written: bytes_total, error: "")

    fn recover(self, root: ArtifactId) -> RecoveryReceipt:
        val match_index = self._find_checkpoint_index(root)
        if match_index < 0:
            RecoveryReceipt(ok: false, root: root, recovered_objects: 0, error: "checkpoint-missing")
        else:
            val manifest = self.checkpoints[match_index as i64]
            if not _manifest_complete(self, manifest):
                RecoveryReceipt(ok: false, root: root, recovered_objects: 0, error: "checkpoint-corrupt-manifest")
            else:
                RecoveryReceipt(ok: true, root: root, recovered_objects: manifest.object_ids.len(), error: "")

    fn known_roots(self) -> [ArtifactId]:
        var result: [ArtifactId] = []
        var i = 0
        while i < self.checkpoints.len():
            result.push(self.checkpoints[i].root)
            i = i + 1
        result

    me fn _find_record_index(self, artifact: ArtifactId) -> i64:
        var i = 0
        while i < self.records.len():
            if self.records[i].artifact == artifact:
                return i
            i = i + 1
        -1

    me fn _find_checkpoint_index(self, root: ArtifactId) -> i64:
        var i = 0
        while i < self.checkpoints.len():
            if self.checkpoints[i].root == root:
                return i
            i = i + 1
        -1

    me fn _find_binding_index(self, object: ObjectRef<AnyObject>) -> i32:
        var i = 0
        while i < self.object_bindings.len():
            val binding = self.object_bindings[i]
            if binding.object_slot == object.object_slot and binding.generation == object.generation:
                return i as i32
            i = i + 1
        -1

    me fn _bind_object_artifact(self, object: ObjectRef<AnyObject>, artifact: ArtifactId):
        val existing = self._find_binding_index(object)
        if existing < 0:
            self.object_bindings.push(CasObjectBinding(
                object_slot: object.object_slot,
                generation: object.generation,
                artifact: artifact
            ))
        else:
            val index = existing as i64
            self.object_bindings[index] = CasObjectBinding(
                object_slot: object.object_slot,
                generation: object.generation,
                artifact: artifact
            )

fn _lookup_artifact(store: CasStore, object_ref: ObjectRef<AnyObject>) -> ArtifactId?:
    var i = 0
    while i < store.object_bindings.len():
        val binding = store.object_bindings[i]
        if binding.object_slot == object_ref.object_slot and binding.generation == object_ref.generation:
            return Some(binding.artifact)
        i = i + 1
    nil

fn _manifest_complete(store: CasStore, manifest: CasManifest) -> bool:
    var i = 0
    while i < manifest.object_ids.len():
        val artifact = manifest.object_ids[i]
        if not artifact_id_valid(artifact):
            return false
        if store._find_record_index(artifact) < 0:
            return false
        i = i + 1
    true

fn _artifact_ids_to_bytes(ids: [ArtifactId]) -> [i64]:
    var flat: [i64] = []
    var i = 0
    while i < ids.len():
        val bytes = text_to_bytes(ids[i].digest + ids[i].byte_len.to_text())
        var b = 0
        while b < bytes.len():
            flat.push(bytes[b] as i64)
            b = b + 1
        i = i + 1
    flat

fn cas_store_digest(payload: [i64]) -> text:
    var total: u64 = 1469598103934665603
    var i = 0
    while i < payload.len():
        total = total ^ ((payload[i] + 256) as u64)
        total = total * 1099511628211
        i = i + 1

    var hex: text = ""
    var shift = 60
    while shift >= 0:
        val nibble = (total >> shift) and 15
        hex = hex + _hex_nibble(nibble)
        shift = shift - 4
    hex + hex + hex + hex

fn _hex_nibble(v: u64) -> text:
    if v == 0: "0"
    elif v == 1: "1"
    elif v == 2: "2"
    elif v == 3: "3"
    elif v == 4: "4"
    elif v == 5: "5"
    elif v == 6: "6"
    elif v == 7: "7"
    elif v == 8: "8"
    elif v == 9: "9"
    elif v == 10: "a"
    elif v == 11: "b"
    elif v == 12: "c"
    elif v == 13: "d"
    elif v == 14: "e"
    else: "f"

fn cas_store_root(store: CasStore) -> ArtifactId:
    if store.checkpoints.len() == 0:
        artifact_id(digest: "", byte_len: 0)
    else:
        store.checkpoints[store.checkpoints.len() - 1].root

fn cas_store_recover(store: CasStore, root: ArtifactId) -> RecoveryReceipt:
    store.recover(root)

export CasRecord, CasManifest, CasObjectBinding, CasStore
export cas_store_digest, cas_store_root, cas_store_recover
