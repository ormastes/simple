# Owner-authoritative lifecycle for bounded environment-selected GPU tasks.
#
# This layer is deliberately device-inert. It retains exact provider-generation
# pins, image/device/source leases and backend callback authorities. A routing
# or completion receipt never claims a qualified GPU kernel or parser path.

use common.gpu.environment_variant_task_contract_v1.*
use std.nogc_async_mut.gpu.environment_variant_adapter_v1.*
use std.nogc_async_mut.gpu.environment_variant_native_authority_v1.*
use std.nogc_async_mut.gpu.environment_variant_native_task_bridge_v1.*
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.*
use std.nogc_sync_mut.composition.environment_variants.provider_generation_v2.*

pub enum GpuEnvironmentTaskErrorV1:
    NativeAuthorityUnavailable
    InvalidHostAuthority
    AdmissionRejected
    AdmissionMismatch
    StaleProviderGeneration
    ProviderPortUnknown
    TaskContractMismatch
    TaskCapacityExceeded
    DuplicateInvocation
    CounterOverflow
    TaskUnknown
    InvalidState
    CompletionUnknown
    CompletionMismatch
    TerminalFenceRequired
    SubmissionUncertain

# These fail-closed gates document the three native owner boundaries that do
# not yet exist. They must not be enabled merely because a caller supplies a
# well-shaped digest/receipt. Wiring requires independently retained mapper,
# allocator and backend queue/fence issuers.
pub const GPU_ENVIRONMENT_NATIVE_PROVIDER_MAPPER_AVAILABLE_V1: bool = false
pub const GPU_ENVIRONMENT_NATIVE_RESOURCE_OWNER_AVAILABLE_V1: bool = false
pub const GPU_ENVIRONMENT_NATIVE_CALLBACK_ISSUER_AVAILABLE_V1: bool = false

pub enum GpuEnvironmentProviderTerminalV1:
    Completed
    FailedDrained
    CancelledDrained
    Uncertain

pub struct GpuEnvironmentAdmittedProviderV1:
    admission_id: u64
    owner_identity: u64
    provider_handle: u64
    provider_generation: u64

pub struct GpuEnvironmentProviderPortV1:
    port_id: u64
    owner_identity: u64
    admission_id: u64

pub struct GpuEnvironmentTaskHandleV1:
    task_id: u64
    owner_identity: u64
    invocation_id: u64

pub struct GpuEnvironmentTaskSubmissionReceiptV1:
    submission_id: u64
    owner_identity: u64
    task_id: u64
    invocation_id: u64
    provider_generation: u64
    generation_pin_id: u64
    state: GpuTaskStateV1
    routing_evidence_only: bool
    device_execution_proven: bool
    native_call_pin_dependency: bool

pub struct GpuEnvironmentRetainedCompletionV1:
    completion_id: u64
    owner_identity: u64
    task_id: u64
    submission_id: u64

pub struct GpuEnvironmentProviderCallbackPortV1:
    port_id: u64
    owner_identity: u64
    provider_identity: EnvironmentDigest256V1
    variant_identity: EnvironmentDigest256V1
    provider_generation: u64
    callable_binding_identity: EnvironmentDigest256V1

pub struct GpuEnvironmentProviderCallbackAuthorityV1:
    callback_id: u64
    owner_identity: u64
    port_id: u64
    task_owner_identity: u64
    task_id: u64
    submission_id: u64

struct _GpuEnvironmentProviderCallbackRecordV1:
    handle: GpuEnvironmentProviderCallbackAuthorityV1
    terminal: GpuEnvironmentProviderTerminalV1
    fence_identity: EnvironmentDigest256V1
    completion_identity: EnvironmentDigest256V1
    readback_identity: EnvironmentDigest256V1
    readback_bytes: u64
    lease_generation: u64
    commit_observed: bool

var _next_gpu_environment_callback_owner_identity_v1: u64 = 1u64

pub class GpuEnvironmentProviderCallbackOwnerV1:
    var owner_identity: u64
    var next_handle: u64
    var ports: [GpuEnvironmentProviderCallbackPortV1]
    var callbacks: [_GpuEnvironmentProviderCallbackRecordV1]

    pub static fn create() -> GpuEnvironmentProviderCallbackOwnerV1:
        val candidate = _next_gpu_environment_callback_owner_identity_v1
        val identity = if candidate == 0u64 or candidate == 0xffffffffffffffffu64:
            0u64
        else:
            candidate
        if identity != 0u64 and identity != 0xffffffffffffffffu64:
            _next_gpu_environment_callback_owner_identity_v1 = identity + 1u64
        GpuEnvironmentProviderCallbackOwnerV1(
            owner_identity: identity, next_handle: 1u64, ports: [], callbacks: [])

pub struct GpuEnvironmentTaskCompletionReceiptV1:
    task_id: u64
    submission_id: u64
    invocation_id: u64
    provider_generation: u64
    lease_generation: u64
    state: GpuTaskStateV1
    terminal: GpuEnvironmentProviderTerminalV1
    fence_identity: EnvironmentDigest256V1
    completion_identity: EnvironmentDigest256V1
    readback_identity: EnvironmentDigest256V1
    readback_bytes: u64
    provider_completion_retained: bool
    routing_evidence_only: bool
    device_execution_proven: bool

pub struct GpuEnvironmentResourceLeaseAuthorityV1:
    authority_id: u64
    owner_identity: u64
    lease_identity: EnvironmentDigest256V1
    lease_generation: u64

struct _GpuEnvironmentResourceLeaseRecordV1:
    handle: GpuEnvironmentResourceLeaseAuthorityV1
    lease: GpuResourceLeaseV1
    source_arena_identity: EnvironmentDigest256V1
    output_arena_identity: EnvironmentDigest256V1
    actual_capacity_bytes: u64
    live: bool
    retained: bool

var _next_gpu_environment_resource_owner_identity_v1: u64 = 1u64

pub class GpuEnvironmentResourceLeaseOwnerV1:
    var owner_identity: u64
    var provider_binding_identity: EnvironmentDigest256V1
    var next_handle: u64
    var leases: [_GpuEnvironmentResourceLeaseRecordV1]

    pub static fn create(
        provider_binding_identity: EnvironmentDigest256V1
    ) -> GpuEnvironmentResourceLeaseOwnerV1:
        val candidate = _next_gpu_environment_resource_owner_identity_v1
        val identity = if candidate == 0u64 or candidate == 0xffffffffffffffffu64:
            0u64
        else:
            candidate
        if identity != 0u64 and identity != 0xffffffffffffffffu64:
            _next_gpu_environment_resource_owner_identity_v1 = identity + 1u64
        GpuEnvironmentResourceLeaseOwnerV1(
            owner_identity: identity,
            provider_binding_identity: provider_binding_identity,
            next_handle: 1u64, leases: [])

struct _GpuEnvironmentAdmissionRecordV1:
    handle: GpuEnvironmentAdmittedProviderV1
    activation: ProviderGenerationActivationV2
    evidence: ProviderActivationEvidenceV2
    admission_pin: ProviderGenerationPinV2
    mapping_authority: ProviderGenerationPinnedCacheAuthorityV2
    provider: GpuHostControlProviderV1
    image: GpuDeviceProgramImageV1
    image_authority: GpuDeviceProgramImageAuthorityV1
    device: GpuEnabledDeviceAuthorityV1

struct _GpuEnvironmentPortRecordV1:
    handle: GpuEnvironmentProviderPortV1
    callback_owner_identity: u64
    callback_port: GpuEnvironmentProviderCallbackPortV1
    live: bool

struct _GpuEnvironmentTaskRecordV1:
    handle: GpuEnvironmentTaskHandleV1
    admission: GpuEnvironmentAdmittedProviderV1
    image: GpuDeviceProgramImageV1
    device: GpuEnabledDeviceAuthorityV1
    lease: GpuResourceLeaseV1
    task: GpuBoundedTaskV1
    pin: ProviderGenerationPinV2
    resource_authority: GpuEnvironmentResourceLeaseAuthorityV1
    state: GpuTaskStateV1
    was_submitted: bool
    cancellation_requested: bool
    terminal_fence_observed: bool
    failure_drained: bool
    submission_uncertain: bool
    committed: bool
    completion_outstanding: bool
    terminal_consumed: bool
    submission: GpuEnvironmentTaskSubmissionReceiptV1?

struct _GpuEnvironmentCompletionRecordV1:
    handle: GpuEnvironmentRetainedCompletionV1
    terminal: GpuEnvironmentProviderTerminalV1
    fence_identity: EnvironmentDigest256V1
    completion_identity: EnvironmentDigest256V1
    readback_identity: EnvironmentDigest256V1
    readback_bytes: u64
    lease_generation: u64
    commit_observed: bool

var _next_gpu_environment_task_owner_identity_v1: u64 = 1u64

pub class GpuEnvironmentTaskOwnerV1:
    var owner_identity: u64
    var generation_manager: ProviderGenerationManagerV2
    var host: EnvironmentSnapshotV1
    var host_feature_words: [u64]
    var host_devices: [EnvironmentGpuDeviceV1]
    var resource_owner: GpuEnvironmentResourceLeaseOwnerV1
    var next_handle: u64
    var admissions: [_GpuEnvironmentAdmissionRecordV1]
    var ports: [_GpuEnvironmentPortRecordV1]
    var tasks: [_GpuEnvironmentTaskRecordV1]
    var completions: [_GpuEnvironmentCompletionRecordV1]

    pub static fn create(manager: ProviderGenerationManagerV2,
        host: EnvironmentSnapshotV1, feature_words: [u64],
        devices: [EnvironmentGpuDeviceV1],
        resource_owner: GpuEnvironmentResourceLeaseOwnerV1
    ) -> Result<GpuEnvironmentTaskOwnerV1, GpuEnvironmentTaskErrorV1>:
        if environment_snapshot_validate_v1(host, feature_words, devices) != Ok(()) or
           manager.manager_identity == 0u64 or resource_owner.owner_identity == 0u64 or
           not _digest_declared(resource_owner.provider_binding_identity):
            return Err(GpuEnvironmentTaskErrorV1.InvalidHostAuthority)
        val identity = _next_gpu_environment_task_owner_identity_v1
        if identity == 0u64 or identity == 0xffffffffffffffffu64:
            return Err(GpuEnvironmentTaskErrorV1.CounterOverflow)
        _next_gpu_environment_task_owner_identity_v1 = identity + 1u64
        # Snapshot caller-provided authority rows so later external mutation cannot
        # enlarge the admitted host feature/device ranges.
        var retained_features: [u64] = []
        for feature_word in feature_words: retained_features.push(feature_word)
        var retained_devices: [EnvironmentGpuDeviceV1] = []
        for host_device in devices: retained_devices.push(host_device)
        Ok(GpuEnvironmentTaskOwnerV1(
            owner_identity: identity, generation_manager: manager, host: host,
            host_feature_words: retained_features, host_devices: retained_devices,
            resource_owner: resource_owner,
            next_handle: 1u64, admissions: [], ports: [], tasks: [], completions: []))

fn _digest_declared(value: EnvironmentDigest256V1) -> bool:
    value.w0 != 0u64 or value.w1 != 0u64 or value.w2 != 0u64 or value.w3 != 0u64

fn _digest_same(left: EnvironmentDigest256V1, right: EnvironmentDigest256V1) -> bool:
    left.w0 == right.w0 and left.w1 == right.w1 and
        left.w2 == right.w2 and left.w3 == right.w3

fn _task_digest(value: EnvironmentDigest256V1) -> GpuTaskIdentityV1:
    GpuTaskIdentityV1(w0: value.w0, w1: value.w1, w2: value.w2, w3: value.w3)

pub fn gpu_environment_resource_lease_issue_v1(
    owner: GpuEnvironmentResourceLeaseOwnerV1,
    device: GpuEnabledDeviceAuthorityV1,
    lease: GpuResourceLeaseV1,
    source_arena_identity: EnvironmentDigest256V1,
    output_arena_identity: EnvironmentDigest256V1,
    actual_capacity_bytes: u64
) -> Result<GpuEnvironmentResourceLeaseAuthorityV1, GpuEnvironmentTaskErrorV1>:
    # Owner boundary called only after the provider/native allocator has issued
    # the exact source/output arenas. The returned opaque authority, not the
    # caller-shaped lease DTO, is what prepare retains and submit revalidates.
    if not GPU_ENVIRONMENT_NATIVE_RESOURCE_OWNER_AVAILABLE_V1:
        return Err(GpuEnvironmentTaskErrorV1.NativeAuthorityUnavailable)
    if owner.owner_identity == 0u64 or owner.next_handle == 0u64 or
       owner.next_handle == 0xffffffffffffffffu64 or owner.leases.len() >= 256 or
       not _digest_declared(source_arena_identity) or
       not _digest_declared(output_arena_identity) or
       _digest_same(source_arena_identity, output_arena_identity) or
       not _digest_declared(lease.lease_identity) or lease.lease_generation == 0u64 or
       not _digest_same(lease.device_identity, device.device_identity) or
       actual_capacity_bytes == 0u64 or actual_capacity_bytes != lease.leased_bytes or
       actual_capacity_bytes > device.maximum_buffer_bytes:
        return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    for existing in owner.leases:
        if _digest_same(existing.lease.lease_identity, lease.lease_identity) and existing.live:
            return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    val handle = GpuEnvironmentResourceLeaseAuthorityV1(
        authority_id: owner.next_handle, owner_identity: owner.owner_identity,
        lease_identity: lease.lease_identity, lease_generation: lease.lease_generation)
    owner.next_handle = owner.next_handle + 1u64
    owner.leases.push(_GpuEnvironmentResourceLeaseRecordV1(
        handle: handle, lease: lease, source_arena_identity: source_arena_identity,
        output_arena_identity: output_arena_identity,
        actual_capacity_bytes: actual_capacity_bytes, live: true, retained: false))
    Ok(handle)

fn _resource_lease_retain_v1(owner: GpuEnvironmentResourceLeaseOwnerV1,
    lease: GpuResourceLeaseV1, required_capacity: u64
) -> Result<GpuEnvironmentResourceLeaseAuthorityV1, GpuEnvironmentTaskErrorV1>:
    var i = 0
    while i < owner.leases.len():
        val current = owner.leases[i]
        if current.live and not current.retained and current.lease == lease and
           current.actual_capacity_bytes >= required_capacity:
            var updated = current; updated.retained = true; owner.leases[i] = updated
            return Ok(current.handle)
        i = i + 1
    Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)

fn _resource_lease_release_v1(owner: GpuEnvironmentResourceLeaseOwnerV1,
    authority: GpuEnvironmentResourceLeaseAuthorityV1
) -> bool:
    if authority.owner_identity != owner.owner_identity: return false
    var i = 0
    while i < owner.leases.len():
        if owner.leases[i].handle == authority and owner.leases[i].retained:
            var kept: [_GpuEnvironmentResourceLeaseRecordV1] = []
            var j = 0
            while j < owner.leases.len():
                if j != i: kept.push(owner.leases[j])
                j = j + 1
            owner.leases = kept
            return true
        i = i + 1
    false

pub fn gpu_environment_resource_lease_revoke_v1(
    owner: GpuEnvironmentResourceLeaseOwnerV1,
    authority: GpuEnvironmentResourceLeaseAuthorityV1
) -> bool:
    if authority.owner_identity != owner.owner_identity: return false
    var i = 0
    while i < owner.leases.len():
        if owner.leases[i].handle == authority and owner.leases[i].live:
            if owner.leases[i].retained:
                var updated = owner.leases[i]
                updated.live = false
                owner.leases[i] = updated
            else:
                var kept: [_GpuEnvironmentResourceLeaseRecordV1] = []
                var j = 0
                while j < owner.leases.len():
                    if j != i: kept.push(owner.leases[j])
                    j = j + 1
                owner.leases = kept
            return true
        i = i + 1
    false

fn _resource_lease_live_v1(owner: GpuEnvironmentResourceLeaseOwnerV1,
    authority: GpuEnvironmentResourceLeaseAuthorityV1
) -> bool:
    if authority.owner_identity != owner.owner_identity: return false
    for current in owner.leases:
        if current.handle == authority and current.live and current.retained: return true
    false

fn _resource_lease_retained_v1(owner: GpuEnvironmentResourceLeaseOwnerV1,
    authority: GpuEnvironmentResourceLeaseAuthorityV1
) -> bool:
    if authority.owner_identity != owner.owner_identity: return false
    for current in owner.leases:
        if current.handle == authority and current.retained: return true
    false

fn _callback_port_index(owner: GpuEnvironmentProviderCallbackOwnerV1,
    port: GpuEnvironmentProviderCallbackPortV1) -> i64:
    if port.owner_identity != owner.owner_identity: return -1
    var i = 0
    while i < owner.ports.len():
        if owner.ports[i] == port: return i
        i = i + 1
    -1

pub fn gpu_environment_provider_callback_port_register_v1(
    owner: GpuEnvironmentProviderCallbackOwnerV1,
    provider_identity: EnvironmentDigest256V1,
    variant_identity: EnvironmentDigest256V1,
    provider_generation: u64,
    callable_binding_identity: EnvironmentDigest256V1
) -> Result<GpuEnvironmentProviderCallbackPortV1, GpuEnvironmentTaskErrorV1>:
    if not GPU_ENVIRONMENT_NATIVE_CALLBACK_ISSUER_AVAILABLE_V1:
        return Err(GpuEnvironmentTaskErrorV1.NativeAuthorityUnavailable)
    if owner.owner_identity == 0u64 or owner.next_handle == 0u64 or
       owner.next_handle == 0xffffffffffffffffu64 or owner.ports.len() >= 256 or
       not _digest_declared(provider_identity) or not _digest_declared(variant_identity) or
       provider_generation == 0u64 or not _digest_declared(callable_binding_identity):
        return Err(GpuEnvironmentTaskErrorV1.ProviderPortUnknown)
    val port = GpuEnvironmentProviderCallbackPortV1(
        port_id: owner.next_handle, owner_identity: owner.owner_identity,
        provider_identity: provider_identity, variant_identity: variant_identity,
        provider_generation: provider_generation,
        callable_binding_identity: callable_binding_identity)
    owner.next_handle = owner.next_handle + 1u64
    owner.ports.push(port)
    Ok(port)

pub fn gpu_environment_provider_callback_port_valid_v1(
    owner: GpuEnvironmentProviderCallbackOwnerV1,
    port: GpuEnvironmentProviderCallbackPortV1
) -> bool:
    _callback_port_index(owner, port) >= 0

pub fn gpu_environment_provider_callback_record_v1(
    owner: GpuEnvironmentProviderCallbackOwnerV1,
    port: GpuEnvironmentProviderCallbackPortV1,
    submission: GpuEnvironmentTaskSubmissionReceiptV1,
    terminal: GpuEnvironmentProviderTerminalV1,
    fence_identity: EnvironmentDigest256V1,
    completion_identity: EnvironmentDigest256V1,
    readback_identity: EnvironmentDigest256V1,
    readback_bytes: u64,
    lease_generation: u64,
    commit_observed: bool
) -> Result<GpuEnvironmentProviderCallbackAuthorityV1, GpuEnvironmentTaskErrorV1>:
    # Backend callback boundary: terminal fields enter the task owner only via
    # this callback-owner-retained authority. The task lifecycle never accepts
    # raw caller-populated fence/readback digests as completion authority.
    if not GPU_ENVIRONMENT_NATIVE_CALLBACK_ISSUER_AVAILABLE_V1:
        return Err(GpuEnvironmentTaskErrorV1.NativeAuthorityUnavailable)
    if _callback_port_index(owner, port) < 0 or
       port.provider_generation != submission.provider_generation or
       submission.owner_identity == 0u64 or submission.task_id == 0u64 or
       submission.submission_id == 0u64 or lease_generation == 0u64:
        return Err(GpuEnvironmentTaskErrorV1.CompletionMismatch)
    for retained in owner.callbacks:
        if retained.handle.task_owner_identity == submission.owner_identity and
           retained.handle.task_id == submission.task_id and
           retained.handle.submission_id == submission.submission_id:
            return Err(GpuEnvironmentTaskErrorV1.InvalidState)
    if terminal == GpuEnvironmentProviderTerminalV1.Uncertain:
        if _digest_declared(fence_identity) or _digest_declared(completion_identity) or
           _digest_declared(readback_identity) or readback_bytes != 0u64 or commit_observed:
            return Err(GpuEnvironmentTaskErrorV1.CompletionMismatch)
    else:
        if not _digest_declared(fence_identity) or not _digest_declared(completion_identity):
            return Err(GpuEnvironmentTaskErrorV1.TerminalFenceRequired)
        if terminal == GpuEnvironmentProviderTerminalV1.Completed:
            if not commit_observed or not _digest_declared(readback_identity) or readback_bytes == 0u64:
                return Err(GpuEnvironmentTaskErrorV1.CompletionMismatch)
        elif commit_observed or _digest_declared(readback_identity) or readback_bytes != 0u64:
            return Err(GpuEnvironmentTaskErrorV1.CompletionMismatch)
    if owner.next_handle == 0u64 or owner.next_handle == 0xffffffffffffffffu64 or
       owner.callbacks.len() >= 256:
        return Err(GpuEnvironmentTaskErrorV1.TaskCapacityExceeded)
    val handle = GpuEnvironmentProviderCallbackAuthorityV1(
        callback_id: owner.next_handle, owner_identity: owner.owner_identity,
        port_id: port.port_id,
        task_owner_identity: submission.owner_identity, task_id: submission.task_id,
        submission_id: submission.submission_id)
    owner.next_handle = owner.next_handle + 1u64
    owner.callbacks.push(_GpuEnvironmentProviderCallbackRecordV1(
        handle: handle, terminal: terminal, fence_identity: fence_identity,
        completion_identity: completion_identity, readback_identity: readback_identity,
        readback_bytes: readback_bytes, lease_generation: lease_generation,
        commit_observed: commit_observed))
    Ok(handle)

fn _provider_callback_peek_v1(
    owner: GpuEnvironmentProviderCallbackOwnerV1,
    authority: GpuEnvironmentProviderCallbackAuthorityV1
) -> Result<_GpuEnvironmentProviderCallbackRecordV1, GpuEnvironmentTaskErrorV1>:
    if authority.owner_identity != owner.owner_identity:
        return Err(GpuEnvironmentTaskErrorV1.CompletionUnknown)
    var index: i64 = -1
    var i = 0
    while i < owner.callbacks.len():
        if owner.callbacks[i].handle == authority: index = i
        i = i + 1
    if index < 0: return Err(GpuEnvironmentTaskErrorV1.CompletionUnknown)
    Ok(owner.callbacks[index])

fn _provider_callback_consume_v1(
    owner: GpuEnvironmentProviderCallbackOwnerV1,
    authority: GpuEnvironmentProviderCallbackAuthorityV1
) -> Result<_GpuEnvironmentProviderCallbackRecordV1, GpuEnvironmentTaskErrorV1>:
    val pending = _provider_callback_peek_v1(owner, authority)
    if pending.is_err(): return Err(pending.unwrap_err())
    var index: i64 = -1
    var i = 0
    while i < owner.callbacks.len():
        if owner.callbacks[i].handle == authority: index = i
        i = i + 1
    val value = pending.unwrap()
    var kept: [_GpuEnvironmentProviderCallbackRecordV1] = []
    i = 0
    while i < owner.callbacks.len():
        if i != index: kept.push(owner.callbacks[i])
        i = i + 1
    owner.callbacks = kept
    Ok(value)

fn _next_handle(owner: GpuEnvironmentTaskOwnerV1) -> Result<u64, GpuEnvironmentTaskErrorV1>:
    if owner.next_handle == 0u64 or owner.next_handle == 0xffffffffffffffffu64:
        return Err(GpuEnvironmentTaskErrorV1.CounterOverflow)
    val value = owner.next_handle
    owner.next_handle = value + 1u64
    Ok(value)

fn _host_device_exact(owner: GpuEnvironmentTaskOwnerV1,
    authority: GpuEnabledDeviceAuthorityV1) -> bool:
    if authority.registry_generation != owner.host.snapshot_generation:
        return false
    var i: u32 = 0u32
    while i < owner.host.gpu_devices.count:
        val candidate_index = owner.host.gpu_devices.offset + i
        val candidate = owner.host_devices[candidate_index as i64]
        if _digest_same(candidate.device_identity, authority.device_identity):
            var duplicate_count = 0
            var j: u32 = 0u32
            while j < owner.host.gpu_devices.count:
                val other = owner.host_devices[(owner.host.gpu_devices.offset + j) as i64]
                if _digest_same(other.device_identity, authority.device_identity):
                    duplicate_count = duplicate_count + 1
                j = j + 1u32
            if duplicate_count != 1: return false
            if candidate.enabled_feature_words.count != 1u32 or
               candidate.enabled_feature_words.offset >= owner.host_feature_words.len() as u32:
                return false
            val enabled = owner.host_feature_words[candidate.enabled_feature_words.offset as i64]
            return candidate.api_id == authority.device_api_id and
                candidate.api_version == authority.enabled_api_version and
                enabled == authority.enabled_feature_bits and
                candidate.max_buffer_bytes == authority.maximum_buffer_bytes and
                candidate.max_workgroup_invocations == authority.maximum_workgroup_invocations and
                candidate.queue_family_count == authority.queue_family_count
        i = i + 1u32
    false

fn _admission_index(owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentAdmittedProviderV1) -> i64:
    if handle.owner_identity != owner.owner_identity: return -1
    var i = 0
    while i < owner.admissions.len():
        if owner.admissions[i].handle == handle: return i
        i = i + 1
    -1

fn _port_index(owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentProviderPortV1) -> i64:
    if handle.owner_identity != owner.owner_identity: return -1
    var i = 0
    while i < owner.ports.len():
        if owner.ports[i].handle == handle and owner.ports[i].live: return i
        i = i + 1
    -1

fn _task_index(owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentTaskHandleV1) -> i64:
    if handle.owner_identity != owner.owner_identity: return -1
    var i = 0
    while i < owner.tasks.len():
        if owner.tasks[i].handle == handle: return i
        i = i + 1
    -1

fn _completion_index(owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentRetainedCompletionV1) -> i64:
    if handle.owner_identity != owner.owner_identity: return -1
    var i = 0
    while i < owner.completions.len():
        if owner.completions[i].handle == handle: return i
        i = i + 1
    -1

pub fn gpu_environment_task_provider_admit_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    activation: ProviderGenerationActivationV2,
    evidence: ProviderActivationEvidenceV2,
    provider: GpuHostControlProviderV1,
    image: GpuDeviceProgramImageV1,
    image_authority: GpuDeviceProgramImageAuthorityV1,
    device: GpuEnabledDeviceAuthorityV1
) -> Result<GpuEnvironmentAdmittedProviderV1, GpuEnvironmentTaskErrorV1>:
    if not GPU_ENVIRONMENT_NATIVE_PROVIDER_MAPPER_AVAILABLE_V1:
        return Err(GpuEnvironmentTaskErrorV1.NativeAuthorityUnavailable)
    if owner.admissions.len() as u64 >= GPU_ENVIRONMENT_TASK_MAX_INFLIGHT_V1:
        return Err(GpuEnvironmentTaskErrorV1.TaskCapacityExceeded)
    if not provider_generation_active_matches_v2(owner.generation_manager, activation, evidence):
        return Err(GpuEnvironmentTaskErrorV1.StaleProviderGeneration)
    if not _digest_same(evidence.environment_identity, owner.host.snapshot_identity) or
       evidence.environment_generation != owner.host.snapshot_generation or
       not _digest_same(evidence.provider_identity, provider.provider_identity) or
       not _digest_same(evidence.variant_identity, provider.variant_identity) or
       activation.generation != provider.provider_generation or
       not _digest_same(evidence.artifact_identity, provider.artifact_digest) or
       not _digest_same(evidence.program_identity, image.program_identity) or
       not _digest_same(evidence.callable_binding_identity,
           owner.resource_owner.provider_binding_identity) or
       not _digest_same(evidence.abi_identity, provider.abi_identity) or
       not _digest_same(evidence.contract_identity, provider.api_contract_identity) or
       not _digest_same(owner.host.resource_layout_digest, image.resource_layout_digest) or
       image.required_effect_bits & owner.host.allowed_effect_bits != image.required_effect_bits or
       image.numerical_contract_id != owner.host.numerical_contract_id or
       not _host_device_exact(owner, device):
        return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    if gpu_environment_variant_admit_v1(provider, image, device) != Ok(()):
        return Err(GpuEnvironmentTaskErrorV1.AdmissionRejected)
    if gpu_device_program_image_authority_validate_v1(image, image_authority) != Ok(()):
        return Err(GpuEnvironmentTaskErrorV1.AdmissionRejected)
    val admission_pin = provider_generation_pin_v2(owner.generation_manager, activation)
    if admission_pin.is_err():
        return Err(GpuEnvironmentTaskErrorV1.StaleProviderGeneration)
    val mapping_result = provider_generation_pinned_cache_authority_v2(
        owner.generation_manager, admission_pin.unwrap())
    if mapping_result.is_err():
        _ = provider_generation_pin_release_v2(owner.generation_manager, admission_pin.unwrap())
        return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    val mapping = mapping_result.unwrap()
    if not _digest_same(mapping.provider_identity, provider.provider_identity) or
       not _digest_same(mapping.variant_identity, provider.variant_identity) or
       not _digest_same(mapping.artifact_identity, provider.artifact_digest) or
       not _digest_same(mapping.abi_identity, provider.abi_identity) or
       not _digest_same(mapping.contract_identity, provider.api_contract_identity) or
       not _digest_same(mapping.program_identity, image.program_identity) or
       not _digest_same(mapping.environment_identity, owner.host.snapshot_identity) or
       mapping.environment_generation != owner.host.snapshot_generation:
        _ = provider_generation_pin_release_v2(owner.generation_manager, admission_pin.unwrap())
        return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    val id_result = _next_handle(owner)
    if id_result.is_err():
        _ = provider_generation_pin_release_v2(owner.generation_manager, admission_pin.unwrap())
        return Err(id_result.unwrap_err())
    val id = id_result.unwrap()
    val handle = GpuEnvironmentAdmittedProviderV1(
        admission_id: id, owner_identity: owner.owner_identity,
        provider_handle: activation.provider_handle,
        provider_generation: activation.generation)
    owner.admissions.push(_GpuEnvironmentAdmissionRecordV1(
        handle: handle, activation: activation, evidence: evidence,
        admission_pin: admission_pin.unwrap(), mapping_authority: mapping,
        provider: provider, image: image, image_authority: image_authority,
        device: device))
    Ok(handle)

pub fn gpu_environment_task_provider_port_register_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    admitted: GpuEnvironmentAdmittedProviderV1,
    callback_owner: GpuEnvironmentProviderCallbackOwnerV1,
    callback_port: GpuEnvironmentProviderCallbackPortV1
) -> Result<GpuEnvironmentProviderPortV1, GpuEnvironmentTaskErrorV1>:
    val admission_index = _admission_index(owner, admitted)
    if admission_index < 0 or
       owner.ports.len() as u64 >= GPU_ENVIRONMENT_TASK_MAX_INFLIGHT_V1:
        return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    val admission = owner.admissions[admission_index]
    if not gpu_environment_provider_callback_port_valid_v1(callback_owner, callback_port) or
       not _digest_same(callback_port.provider_identity, admission.provider.provider_identity) or
       not _digest_same(callback_port.variant_identity, admission.provider.variant_identity) or
       callback_port.provider_generation != admission.provider.provider_generation or
       not _digest_same(callback_port.callable_binding_identity,
           admission.evidence.callable_binding_identity):
        return Err(GpuEnvironmentTaskErrorV1.ProviderPortUnknown)
    val id = _next_handle(owner)?
    val port = GpuEnvironmentProviderPortV1(
        port_id: id, owner_identity: owner.owner_identity,
        admission_id: admitted.admission_id)
    owner.ports.push(_GpuEnvironmentPortRecordV1(
        handle: port, callback_owner_identity: callback_owner.owner_identity,
        callback_port: callback_port, live: true))
    Ok(port)

pub fn gpu_environment_task_provider_port_close_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    port: GpuEnvironmentProviderPortV1
) -> Result<(), GpuEnvironmentTaskErrorV1>:
    val index = _port_index(owner, port)
    if index < 0: return Err(GpuEnvironmentTaskErrorV1.ProviderPortUnknown)
    for task_record in owner.tasks:
        if task_record.admission.admission_id == port.admission_id:
            return Err(GpuEnvironmentTaskErrorV1.InvalidState)
    var kept: [_GpuEnvironmentPortRecordV1] = []
    var i = 0
    while i < owner.ports.len():
        if i != index: kept.push(owner.ports[i])
        i = i + 1
    owner.ports = kept
    Ok(())

pub fn gpu_environment_task_provider_release_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    admitted: GpuEnvironmentAdmittedProviderV1
) -> Result<(), GpuEnvironmentTaskErrorV1>:
    val index = _admission_index(owner, admitted)
    if index < 0: return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    for task_record in owner.tasks:
        if task_record.admission == admitted:
            return Err(GpuEnvironmentTaskErrorV1.InvalidState)
    for port_record in owner.ports:
        if port_record.live and port_record.handle.admission_id == admitted.admission_id:
            return Err(GpuEnvironmentTaskErrorV1.InvalidState)
    val admission = owner.admissions[index]
    if not provider_generation_pinned_cache_authority_live_v2(
        owner.generation_manager, admission.admission_pin, admission.mapping_authority):
        return Err(GpuEnvironmentTaskErrorV1.StaleProviderGeneration)
    if provider_generation_pin_release_v2(
        owner.generation_manager, admission.admission_pin) != Ok(()):
        return Err(GpuEnvironmentTaskErrorV1.StaleProviderGeneration)
    var kept: [_GpuEnvironmentAdmissionRecordV1] = []
    var i = 0
    while i < owner.admissions.len():
        if i != index: kept.push(owner.admissions[i])
        i = i + 1
    owner.admissions = kept
    Ok(())

pub fn gpu_environment_task_prepare_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    admitted_provider: GpuEnvironmentAdmittedProviderV1,
    image: GpuDeviceProgramImageV1,
    enabled_device: GpuEnabledDeviceAuthorityV1,
    lease: GpuResourceLeaseV1,
    bounded_task: GpuBoundedTaskV1
) -> Result<GpuEnvironmentTaskHandleV1, GpuEnvironmentTaskErrorV1>:
    if owner.tasks.len() as u64 >= GPU_ENVIRONMENT_TASK_MAX_INFLIGHT_V1:
        return Err(GpuEnvironmentTaskErrorV1.TaskCapacityExceeded)
    if gpu_bounded_task_validate_v1(bounded_task) != Ok(()) or
       bounded_task.arena_capacity_bytes > lease.leased_bytes or
       bounded_task.arena_capacity_bytes > enabled_device.maximum_buffer_bytes:
        return Err(GpuEnvironmentTaskErrorV1.TaskContractMismatch)
    for current in owner.tasks:
        if current.handle.invocation_id == bounded_task.invocation_id:
            return Err(GpuEnvironmentTaskErrorV1.DuplicateInvocation)
    val admission_index = _admission_index(owner, admitted_provider)
    if admission_index < 0: return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    val admission = owner.admissions[admission_index]
    if not provider_generation_active_matches_v2(owner.generation_manager,
        admission.activation, admission.evidence) or
       not provider_generation_pinned_cache_authority_live_v2(
           owner.generation_manager, admission.admission_pin,
           admission.mapping_authority):
        return Err(GpuEnvironmentTaskErrorV1.StaleProviderGeneration)
    if admission.image != image or admission.device != enabled_device:
        return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    if bounded_task.provider_generation != admission.provider.provider_generation or
       bounded_task.lease_generation != lease.lease_generation or
       not gpu_task_identity_equal_v1(bounded_task.resource_layout_identity,
           _task_digest(image.resource_layout_digest)) or
       bounded_task.required_effect_bits != image.required_effect_bits or
       bounded_task.numerical_contract_id != image.numerical_contract_id:
        return Err(GpuEnvironmentTaskErrorV1.TaskContractMismatch)
    if gpu_environment_variant_lease_validate_v1(admission.provider, image,
        enabled_device, lease) != Ok(()):
        return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    val pin_result = provider_generation_pin_v2(owner.generation_manager,
        admission.activation)
    if pin_result.is_err():
        return Err(GpuEnvironmentTaskErrorV1.StaleProviderGeneration)
    val resource_authority = _resource_lease_retain_v1(
        owner.resource_owner, lease, bounded_task.arena_capacity_bytes)
    if resource_authority.is_err():
        _ = provider_generation_pin_release_v2(owner.generation_manager, pin_result.unwrap())
        return Err(resource_authority.unwrap_err())
    val id = _next_handle(owner)
    if id.is_err():
        _ = provider_generation_pin_release_v2(owner.generation_manager, pin_result.unwrap())
        _ = _resource_lease_release_v1(owner.resource_owner, resource_authority.unwrap())
        return Err(id.unwrap_err())
    val handle = GpuEnvironmentTaskHandleV1(task_id: id.unwrap(),
        owner_identity: owner.owner_identity, invocation_id: bounded_task.invocation_id)
    owner.tasks.push(_GpuEnvironmentTaskRecordV1(
        handle: handle, admission: admitted_provider, image: image,
        device: enabled_device, lease: lease, task: bounded_task,
        pin: pin_result.unwrap(), resource_authority: resource_authority.unwrap(),
        state: GpuTaskStateV1.Prepared,
        was_submitted: false, cancellation_requested: false,
        terminal_fence_observed: false, failure_drained: false,
        submission_uncertain: false, committed: false,
        completion_outstanding: false, terminal_consumed: false,
        submission: nil))
    Ok(handle)

pub fn gpu_environment_task_submit_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentTaskHandleV1,
    provider_port: GpuEnvironmentProviderPortV1
) -> Result<GpuEnvironmentTaskSubmissionReceiptV1, GpuEnvironmentTaskErrorV1>:
    val task_index = _task_index(owner, handle)
    if task_index < 0: return Err(GpuEnvironmentTaskErrorV1.TaskUnknown)
    val port_index = _port_index(owner, provider_port)
    if port_index < 0 or provider_port.admission_id != owner.tasks[task_index].admission.admission_id:
        return Err(GpuEnvironmentTaskErrorV1.ProviderPortUnknown)
    val admission_index = _admission_index(owner, owner.tasks[task_index].admission)
    if admission_index < 0: return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    if owner.tasks[task_index].state != GpuTaskStateV1.Prepared or
       not provider_generation_pin_live_v2(owner.generation_manager, owner.tasks[task_index].pin) or
       not provider_generation_pinned_cache_authority_live_v2(
           owner.generation_manager,
           owner.admissions[admission_index].admission_pin,
           owner.admissions[admission_index].mapping_authority) or
       not _resource_lease_live_v1(owner.resource_owner,
           owner.tasks[task_index].resource_authority):
        return Err(GpuEnvironmentTaskErrorV1.InvalidState)
    val id = _next_handle(owner)?
    val receipt = GpuEnvironmentTaskSubmissionReceiptV1(
        submission_id: id, owner_identity: owner.owner_identity,
        task_id: handle.task_id, invocation_id: handle.invocation_id,
        provider_generation: owner.tasks[task_index].task.provider_generation,
        generation_pin_id: owner.tasks[task_index].pin.pin_id,
        state: GpuTaskStateV1.Submitted, routing_evidence_only: true,
        device_execution_proven: false, native_call_pin_dependency: true)
    var record = owner.tasks[task_index]
    record.state = GpuTaskStateV1.Submitted
    record.was_submitted = true
    record.submission = receipt
    owner.tasks[task_index] = record
    Ok(receipt)

pub fn gpu_environment_task_native_authorities_consume_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentTaskHandleV1,
    native_provider: GpuNativeProviderAuthorityV1,
    native_image: GpuNativeDeviceProgramImageAuthorityV1,
    native_resource: GpuNativeResourceAuthorityV1
) -> Result<GpuNativeTaskAdmissionReceiptV1, GpuEnvironmentTaskErrorV1>:
    val task_index = _task_index(owner, handle)
    if task_index < 0: return Err(GpuEnvironmentTaskErrorV1.TaskUnknown)
    val record = owner.tasks[task_index]
    if record.state != GpuTaskStateV1.Prepared or record.was_submitted:
        return Err(GpuEnvironmentTaskErrorV1.InvalidState)
    val admission_index = _admission_index(owner, record.admission)
    if admission_index < 0:
        return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    val admission = owner.admissions[admission_index]
    val consumed = gpu_native_task_admission_consume_v1(
        admission.provider, record.image, record.device, record.lease,
        record.task, native_provider, native_image, native_resource)
    if consumed.is_err():
        val failure = consumed.unwrap_err()
        if failure == GpuNativeTaskBridgeErrorV1.InvalidTask:
            return Err(GpuEnvironmentTaskErrorV1.TaskContractMismatch)
        if failure == GpuNativeTaskBridgeErrorV1.AuthorityMismatch:
            return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
        return Err(GpuEnvironmentTaskErrorV1.NativeAuthorityUnavailable)
    Ok(consumed.unwrap())

pub fn gpu_environment_task_native_completion_consume_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentTaskHandleV1,
    native_provider: GpuNativeProviderAuthorityV1,
    native_image: GpuNativeDeviceProgramImageAuthorityV1,
    native_resource: GpuNativeResourceAuthorityV1,
    native_completion: GpuNativeCompletionAuthorityV1
) -> Result<GpuNativeTaskCompletionReceiptV1, GpuEnvironmentTaskErrorV1>:
    val task_index = _task_index(owner, handle)
    if task_index < 0: return Err(GpuEnvironmentTaskErrorV1.TaskUnknown)
    val record = owner.tasks[task_index]
    if not record.was_submitted or record.submission == nil or
       (record.state != GpuTaskStateV1.Submitted and
        record.state != GpuTaskStateV1.Cancelled) or
       record.terminal_consumed or record.terminal_fence_observed or
       record.committed:
        return Err(GpuEnvironmentTaskErrorV1.InvalidState)
    val admission_index = _admission_index(owner, record.admission)
    if admission_index < 0:
        return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    val admission = owner.admissions[admission_index]
    val consumed = gpu_native_task_completion_consume_v1(
        admission.provider, record.image, record.device, record.lease,
        record.task,
        native_provider, native_image, native_resource, native_completion)
    if consumed.is_err():
        val failure = consumed.unwrap_err()
        if failure == GpuNativeTaskBridgeErrorV1.InvalidTask:
            return Err(GpuEnvironmentTaskErrorV1.TaskContractMismatch)
        if failure == GpuNativeTaskBridgeErrorV1.AuthorityMismatch:
            return Err(GpuEnvironmentTaskErrorV1.CompletionMismatch)
        return Err(GpuEnvironmentTaskErrorV1.NativeAuthorityUnavailable)
    Ok(consumed.unwrap())

pub fn gpu_environment_task_completion_record_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentTaskHandleV1,
    provider_port: GpuEnvironmentProviderPortV1,
    submission: GpuEnvironmentTaskSubmissionReceiptV1,
    callback_owner: GpuEnvironmentProviderCallbackOwnerV1,
    callback_authority: GpuEnvironmentProviderCallbackAuthorityV1
) -> Result<GpuEnvironmentRetainedCompletionV1, GpuEnvironmentTaskErrorV1>:
    val task_index = _task_index(owner, handle)
    if task_index < 0: return Err(GpuEnvironmentTaskErrorV1.TaskUnknown)
    val port_index = _port_index(owner, provider_port)
    if port_index < 0 or provider_port.admission_id != owner.tasks[task_index].admission.admission_id or
       owner.ports[port_index].callback_owner_identity != callback_owner.owner_identity:
        return Err(GpuEnvironmentTaskErrorV1.ProviderPortUnknown)
    val record = owner.tasks[task_index]
    if not record.was_submitted or record.submission == nil or
       (record.state != GpuTaskStateV1.Submitted and record.state != GpuTaskStateV1.Cancelled):
        return Err(GpuEnvironmentTaskErrorV1.InvalidState)
    if record.completion_outstanding or record.terminal_consumed or
       record.terminal_fence_observed or record.committed:
        return Err(GpuEnvironmentTaskErrorV1.InvalidState)
    if record.submission.unwrap() != submission or submission.task_id != handle.task_id or
       submission.owner_identity != owner.owner_identity or
       submission.generation_pin_id != record.pin.pin_id or
       callback_authority.port_id != owner.ports[port_index].callback_port.port_id or
       callback_authority.task_owner_identity != owner.owner_identity or
       callback_authority.task_id != handle.task_id or
       callback_authority.submission_id != submission.submission_id:
        return Err(GpuEnvironmentTaskErrorV1.CompletionMismatch)
    if owner.completions.len() as u64 >= GPU_ENVIRONMENT_TASK_MAX_INFLIGHT_V1:
        return Err(GpuEnvironmentTaskErrorV1.TaskCapacityExceeded)
    val callback = _provider_callback_peek_v1(callback_owner, callback_authority)
    if callback.is_err(): return Err(callback.unwrap_err())
    val terminal_record = callback.unwrap()
    if terminal_record.lease_generation != record.lease.lease_generation or
       terminal_record.readback_bytes > record.task.output_arena.length:
        return Err(GpuEnvironmentTaskErrorV1.CompletionMismatch)
    # Reserve and validate the destination before consuming the only backend
    # event. Counter exhaustion can therefore never strand the task pin.
    val id = _next_handle(owner)?
    val consumed = _provider_callback_consume_v1(callback_owner, callback_authority)
    if consumed.is_err(): return Err(consumed.unwrap_err())
    val authority = GpuEnvironmentRetainedCompletionV1(
        completion_id: id, owner_identity: owner.owner_identity,
        task_id: handle.task_id, submission_id: submission.submission_id)
    owner.completions.push(_GpuEnvironmentCompletionRecordV1(
        handle: authority, terminal: terminal_record.terminal,
        fence_identity: terminal_record.fence_identity,
        completion_identity: terminal_record.completion_identity,
        readback_identity: terminal_record.readback_identity,
        readback_bytes: terminal_record.readback_bytes,
        lease_generation: terminal_record.lease_generation,
        commit_observed: terminal_record.commit_observed))
    var outstanding = owner.tasks[task_index]
    outstanding.completion_outstanding = true
    owner.tasks[task_index] = outstanding
    Ok(authority)

fn _completion_remove(owner: GpuEnvironmentTaskOwnerV1, index: i64):
    var kept: [_GpuEnvironmentCompletionRecordV1] = []
    var i = 0
    while i < owner.completions.len():
        if i != index: kept.push(owner.completions[i])
        i = i + 1
    owner.completions = kept

pub fn gpu_environment_task_complete_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentTaskHandleV1,
    retained_completion: GpuEnvironmentRetainedCompletionV1
) -> Result<GpuEnvironmentTaskCompletionReceiptV1, GpuEnvironmentTaskErrorV1>:
    val task_index = _task_index(owner, handle)
    if task_index < 0: return Err(GpuEnvironmentTaskErrorV1.TaskUnknown)
    val completion_index = _completion_index(owner, retained_completion)
    if completion_index < 0: return Err(GpuEnvironmentTaskErrorV1.CompletionUnknown)
    val completion = owner.completions[completion_index]
    val task_record = owner.tasks[task_index]
    if not task_record.completion_outstanding or task_record.terminal_consumed or
       task_record.committed or task_record.terminal_fence_observed or
       (task_record.state != GpuTaskStateV1.Submitted and
        task_record.state != GpuTaskStateV1.Cancelled) or
       completion.handle.task_id != handle.task_id or task_record.submission == nil or
       completion.handle.submission_id != task_record.submission.unwrap().submission_id:
        return Err(GpuEnvironmentTaskErrorV1.CompletionMismatch)
    _completion_remove(owner, completion_index)
    if completion.terminal == GpuEnvironmentProviderTerminalV1.Uncertain:
        var uncertain_record = owner.tasks[task_index]
        uncertain_record.submission_uncertain = true
        uncertain_record.completion_outstanding = false
        owner.tasks[task_index] = uncertain_record
        return Err(GpuEnvironmentTaskErrorV1.SubmissionUncertain)
    var updated = owner.tasks[task_index]
    updated.terminal_fence_observed = true
    updated.committed = completion.commit_observed
    updated.failure_drained = completion.terminal != GpuEnvironmentProviderTerminalV1.Completed
    updated.submission_uncertain = false
    updated.completion_outstanding = false
    updated.terminal_consumed = true
    updated.state = if completion.terminal == GpuEnvironmentProviderTerminalV1.Completed:
        GpuTaskStateV1.Completed
    else:
        GpuTaskStateV1.Cancelled
    owner.tasks[task_index] = updated
    Ok(GpuEnvironmentTaskCompletionReceiptV1(
        task_id: handle.task_id,
        submission_id: updated.submission.unwrap().submission_id,
        invocation_id: handle.invocation_id,
        provider_generation: updated.task.provider_generation,
        lease_generation: updated.lease.lease_generation,
        state: updated.state, terminal: completion.terminal,
        fence_identity: completion.fence_identity,
        completion_identity: completion.completion_identity,
        readback_identity: completion.readback_identity,
        readback_bytes: completion.readback_bytes,
        provider_completion_retained: true, routing_evidence_only: true,
        device_execution_proven: false))

pub fn gpu_environment_task_cancel_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentTaskHandleV1
) -> Result<GpuTaskStateV1, GpuEnvironmentTaskErrorV1>:
    val index = _task_index(owner, handle)
    if index < 0: return Err(GpuEnvironmentTaskErrorV1.TaskUnknown)
    if owner.tasks[index].state != GpuTaskStateV1.Prepared and
       owner.tasks[index].state != GpuTaskStateV1.Submitted:
        return Err(GpuEnvironmentTaskErrorV1.InvalidState)
    var record = owner.tasks[index]
    record.cancellation_requested = true
    record.terminal_fence_observed = not record.was_submitted
    record.state = GpuTaskStateV1.Cancelled
    owner.tasks[index] = record
    Ok(GpuTaskStateV1.Cancelled)

pub fn gpu_environment_task_fallback_decision_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentTaskHandleV1
) -> Result<GpuTaskFallbackDecisionV1, GpuEnvironmentTaskErrorV1>:
    val index = _task_index(owner, handle)
    if index < 0: return Err(GpuEnvironmentTaskErrorV1.TaskUnknown)
    val record = owner.tasks[index]
    if record.committed or record.state == GpuTaskStateV1.Completed:
        return Ok(GpuTaskFallbackDecisionV1.NotNeeded)
    if record.was_submitted and (not record.terminal_fence_observed or record.submission_uncertain):
        return Ok(GpuTaskFallbackDecisionV1.WaitForTerminalFence)
    Ok(gpu_task_missing_provider_decision_v1(
        record.task.fallback_policy, record.task.cpu_fallback_semantically_allowed))

pub fn gpu_environment_task_retire_v1(
    owner: GpuEnvironmentTaskOwnerV1,
    handle: GpuEnvironmentTaskHandleV1
) -> Result<(), GpuEnvironmentTaskErrorV1>:
    val index = _task_index(owner, handle)
    if index < 0: return Err(GpuEnvironmentTaskErrorV1.TaskUnknown)
    val record = owner.tasks[index]
    if record.was_submitted and not record.terminal_fence_observed:
        return Err(GpuEnvironmentTaskErrorV1.TerminalFenceRequired)
    if record.state != GpuTaskStateV1.Completed and record.state != GpuTaskStateV1.Cancelled:
        return Err(GpuEnvironmentTaskErrorV1.InvalidState)
    if not provider_generation_pin_live_v2(owner.generation_manager, record.pin):
        return Err(GpuEnvironmentTaskErrorV1.StaleProviderGeneration)
    if not _resource_lease_retained_v1(owner.resource_owner, record.resource_authority):
        return Err(GpuEnvironmentTaskErrorV1.AdmissionMismatch)
    _ = _resource_lease_release_v1(owner.resource_owner, record.resource_authority)
    if provider_generation_pin_release_v2(owner.generation_manager, record.pin) != Ok(()):
        return Err(GpuEnvironmentTaskErrorV1.StaleProviderGeneration)
    var kept: [_GpuEnvironmentTaskRecordV1] = []
    var i = 0
    while i < owner.tasks.len():
        if i != index: kept.push(owner.tasks[i])
        i = i + 1
    owner.tasks = kept
    Ok(())
