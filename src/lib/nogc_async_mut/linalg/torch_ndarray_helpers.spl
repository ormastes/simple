use std.ndarray.*
use std.common.torch.dyn_sffi_ops.{dyn_torch_tensor_abs_result, dyn_torch_tensor_empty_1d_result, dyn_torch_tensor_empty_2d_result, dyn_torch_tensor_empty_3d_result, dyn_torch_tensor_empty_4d_result, dyn_torch_tensor_exp_result, dyn_torch_tensor_full_1d_result, dyn_torch_tensor_full_2d_result, dyn_torch_tensor_full_3d_result, dyn_torch_tensor_full_4d_result, dyn_torch_tensor_gelu_result, dyn_torch_tensor_log_result, dyn_torch_tensor_neg_result, dyn_torch_tensor_ones_1d_result, dyn_torch_tensor_ones_2d_result, dyn_torch_tensor_ones_3d_result, dyn_torch_tensor_ones_4d_result, dyn_torch_tensor_pow_result, dyn_torch_tensor_rand_1d_result, dyn_torch_tensor_rand_2d_result, dyn_torch_tensor_rand_3d_result, dyn_torch_tensor_rand_4d_result, dyn_torch_tensor_randn_1d_result, dyn_torch_tensor_randn_2d_result, dyn_torch_tensor_randn_3d_result, dyn_torch_tensor_randn_4d_result, dyn_torch_tensor_relu_result, dyn_torch_tensor_sigmoid_result, dyn_torch_tensor_sqrt_result, dyn_torch_tensor_tanh_result, dyn_torch_tensor_zeros_1d_result, dyn_torch_tensor_zeros_2d_result, dyn_torch_tensor_zeros_3d_result, dyn_torch_tensor_zeros_4d_result}
use std.common.torch.dyn_sffi_tensor_ops.{dyn_torch_tensor_acos_result, dyn_torch_tensor_asin_result, dyn_torch_tensor_cos_result, dyn_torch_tensor_sin_result, dyn_torch_tensor_tan_result}
use std.linalg.linalg_core.{BackendError}

fn torch_arange_count(start: f64, end_value: f64, step: f64) -> i64:
    var count = 0
    var current = start
    if step > 0.0:
        while current < end_value:
            count = count + 1
            current = current + step
    else:
        while current > end_value:
            count = count + 1
            current = current + step
    count

fn torch_fill_handle_f64(shape: Shape, value: Float64, op: text) -> Result<i64, BackendError>:
    if shape.dims.len() < 1 or shape.dims.len() > 4:
        return Err(BackendError.BackendExecutionFailed("pytorch tensor owner constructors currently support 1-D through 4-D Float64 shapes"))
    var i = 0
    while i < shape.dims.len():
        if shape.dims[i].value < 0:
            return Err(BackendError.BackendExecutionFailed("pytorch tensor owner constructor dimensions must be non-negative"))
        i = i + 1
    var result: Result<i64, text> = Err("unsupported_fill_constructor")
    if shape.dims.len() == 1:
        if op == "zeros":
            result = dyn_torch_tensor_zeros_1d_result(shape.dims[0].value)
        elif op == "ones":
            result = dyn_torch_tensor_ones_1d_result(shape.dims[0].value)
        else:
            result = dyn_torch_tensor_full_1d_result(shape.dims[0].value, value.value)
    elif shape.dims.len() == 2:
        if op == "zeros":
            result = dyn_torch_tensor_zeros_2d_result(shape.dims[0].value, shape.dims[1].value)
        elif op == "ones":
            result = dyn_torch_tensor_ones_2d_result(shape.dims[0].value, shape.dims[1].value)
        else:
            result = dyn_torch_tensor_full_2d_result(shape.dims[0].value, shape.dims[1].value, value.value)
    elif shape.dims.len() == 3:
        if op == "zeros":
            result = dyn_torch_tensor_zeros_3d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value)
        elif op == "ones":
            result = dyn_torch_tensor_ones_3d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value)
        else:
            result = dyn_torch_tensor_full_3d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value, value.value)
    else:
        if op == "zeros":
            result = dyn_torch_tensor_zeros_4d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value, shape.dims[3].value)
        elif op == "ones":
            result = dyn_torch_tensor_ones_4d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value, shape.dims[3].value)
        else:
            result = dyn_torch_tensor_full_4d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value, shape.dims[3].value, value.value)
    match result:
        case Ok(handle): Ok(handle)
        case Err(reason): Err(BackendError.BackendExecutionFailed("pytorch fill constructor failed: " + reason))

fn torch_create_handle_f64(shape: Shape, op: text) -> Result<i64, BackendError>:
    if shape.dims.len() < 1 or shape.dims.len() > 4:
        return Err(BackendError.BackendExecutionFailed("pytorch tensor owner constructors currently support 1-D through 4-D Float64 shapes"))
    var i = 0
    while i < shape.dims.len():
        if shape.dims[i].value < 0:
            return Err(BackendError.BackendExecutionFailed("pytorch tensor owner constructor dimensions must be non-negative"))
        i = i + 1
    var result: Result<i64, text> = Err("unsupported_create_constructor")
    if shape.dims.len() == 1:
        if op == "empty":
            result = dyn_torch_tensor_empty_1d_result(shape.dims[0].value)
        elif op == "rand":
            result = dyn_torch_tensor_rand_1d_result(shape.dims[0].value)
        else:
            result = dyn_torch_tensor_randn_1d_result(shape.dims[0].value)
    elif shape.dims.len() == 2:
        if op == "empty":
            result = dyn_torch_tensor_empty_2d_result(shape.dims[0].value, shape.dims[1].value)
        elif op == "rand":
            result = dyn_torch_tensor_rand_2d_result(shape.dims[0].value, shape.dims[1].value)
        else:
            result = dyn_torch_tensor_randn_2d_result(shape.dims[0].value, shape.dims[1].value)
    elif shape.dims.len() == 3:
        if op == "empty":
            result = dyn_torch_tensor_empty_3d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value)
        elif op == "rand":
            result = dyn_torch_tensor_rand_3d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value)
        else:
            result = dyn_torch_tensor_randn_3d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value)
    else:
        if op == "empty":
            result = dyn_torch_tensor_empty_4d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value, shape.dims[3].value)
        elif op == "rand":
            result = dyn_torch_tensor_rand_4d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value, shape.dims[3].value)
        else:
            result = dyn_torch_tensor_randn_4d_result(shape.dims[0].value, shape.dims[1].value, shape.dims[2].value, shape.dims[3].value)
    match result:
        case Ok(handle): Ok(handle)
        case Err(reason): Err(BackendError.BackendExecutionFailed("pytorch create constructor failed: " + reason))

fn torch_unary_handle_f64(tensor_handle: i64, op: text) -> Result<i64, BackendError>:
    var result: Result<i64, text> = Err("unsupported_unary_op")
    if op == "abs":
        result = dyn_torch_tensor_abs_result(tensor_handle)
    elif op == "neg":
        result = dyn_torch_tensor_neg_result(tensor_handle)
    elif op == "square":
        result = dyn_torch_tensor_pow_result(tensor_handle, 2.0)
    elif op == "sqrt":
        result = dyn_torch_tensor_sqrt_result(tensor_handle)
    elif op == "relu":
        result = dyn_torch_tensor_relu_result(tensor_handle)
    elif op == "gelu":
        result = dyn_torch_tensor_gelu_result(tensor_handle)
    elif op == "exp":
        result = dyn_torch_tensor_exp_result(tensor_handle)
    elif op == "log":
        result = dyn_torch_tensor_log_result(tensor_handle)
    elif op == "sigmoid":
        result = dyn_torch_tensor_sigmoid_result(tensor_handle)
    elif op == "tanh":
        result = dyn_torch_tensor_tanh_result(tensor_handle)
    elif op == "sin":
        result = dyn_torch_tensor_sin_result(tensor_handle)
    elif op == "cos":
        result = dyn_torch_tensor_cos_result(tensor_handle)
    elif op == "tan":
        result = dyn_torch_tensor_tan_result(tensor_handle)
    elif op == "asin":
        result = dyn_torch_tensor_asin_result(tensor_handle)
    elif op == "acos":
        result = dyn_torch_tensor_acos_result(tensor_handle)
    else:
        return Err(BackendError.BackendExecutionFailed("unsupported pytorch tensor owner unary op"))
    match result:
        case Ok(handle): Ok(handle)
        case Err(reason): Err(BackendError.BackendExecutionFailed("pytorch unary " + op + " failed: " + reason))
