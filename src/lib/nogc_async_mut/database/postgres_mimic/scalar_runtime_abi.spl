"""Stable scalar-only ABI for parent-owned database operations.

The owner keeps all mutable state.  A call receives the owner token, a
resource token, an operation code, and one scalar argument; it returns a
result-cursor token.  The cursor is also owned by the owner and is inspected
through the scalar getters below.  Every boundary value is an ``i64``.
Boolean observations use ``PG_DB_ABI_FALSE`` and ``PG_DB_ABI_TRUE``.

The hosted runtime implementation lives in ``src/runtime/runtime_db.c`` and
the interpreter has a matching Rust owner. The wire/server adapter remains a
separate boundary and must release every result cursor after reading it.
"""

const PG_DB_ABI_FALSE: i64 = 0
const PG_DB_ABI_TRUE: i64 = 1
const PG_DB_ABI_INVALID_HANDLE: i64 = 0

const PG_DB_OP_ADMIT_CONNECTION: i64 = 1
const PG_DB_OP_BEGIN_DRAIN: i64 = 2
const PG_DB_OP_MARK_STARTED: i64 = 3
const PG_DB_OP_MARK_COMPLETED: i64 = 4
const PG_DB_OP_STARTED_COUNT: i64 = 5
const PG_DB_OP_COMPLETED_COUNT: i64 = 6
const PG_DB_OP_ACTIVE_COUNT: i64 = 7
const PG_DB_OP_IS_DRAINING: i64 = 8
const PG_DB_OP_MARK_STOPPED: i64 = 9
const PG_DB_OP_STOPPED_COUNT: i64 = 10

const PG_DB_STATUS_OK: i64 = 0
const PG_DB_STATUS_INVALID_HANDLE: i64 = 1
const PG_DB_STATUS_REJECTED: i64 = 2
const PG_DB_STATUS_UNKNOWN_OPERATION: i64 = 3
const PG_DB_STATUS_INVALID_ARGUMENT: i64 = 4

const PG_DB_RESULT_FIELD_OK: i64 = 1
const PG_DB_RESULT_FIELD_STATUS: i64 = 2
const PG_DB_RESULT_FIELD_VALUE: i64 = 3
const PG_DB_RESULT_FIELD_STARTED_COUNT: i64 = 4
const PG_DB_RESULT_FIELD_COMPLETED_COUNT: i64 = 5
const PG_DB_RESULT_FIELD_ACTIVE_COUNT: i64 = 6
const PG_DB_RESULT_FIELD_DRAINING: i64 = 7

const PG_WIRE_LIMIT_MAX_SESSIONS: i64 = 0
const PG_WIRE_LIMIT_READ_CHUNK: i64 = 1
const PG_WIRE_LIMIT_MAX_FRAME: i64 = 2
const PG_WIRE_LIMIT_MAX_PARAMETERS: i64 = 3
const PG_WIRE_LIMIT_MAX_BUFFER: i64 = 4
const PG_WIRE_LIMIT_MAX_RESPONSE: i64 = 5
const PG_WIRE_LIMIT_READ_TIMEOUT_MS: i64 = 6
const PG_WIRE_LIMIT_WRITE_TIMEOUT_MS: i64 = 7

# The owner/runtime implementation supplies these symbols.  Keep every
# parameter and return position scalar so no language value layout is shared.
extern fn rt_pg_db_control_create(owner_handle: i64,
    max_connections: i64) -> i64
extern fn rt_pg_db_control_operation(owner_handle: i64,
    control_handle: i64, operation: i64, argument: i64) -> i64
extern fn rt_pg_db_control_release(owner_handle: i64,
    control_handle: i64) -> i64

extern fn rt_pg_db_result_get(owner_handle: i64,
    result_cursor: i64, field: i64) -> i64
extern fn rt_pg_db_result_ok(owner_handle: i64,
    result_cursor: i64) -> i64
extern fn rt_pg_db_result_status(owner_handle: i64,
    result_cursor: i64) -> i64
extern fn rt_pg_db_result_value(owner_handle: i64,
    result_cursor: i64) -> i64
extern fn rt_pg_db_result_started_count(owner_handle: i64,
    result_cursor: i64) -> i64
extern fn rt_pg_db_result_completed_count(owner_handle: i64,
    result_cursor: i64) -> i64
extern fn rt_pg_db_result_active_count(owner_handle: i64,
    result_cursor: i64) -> i64
extern fn rt_pg_db_result_draining(owner_handle: i64,
    result_cursor: i64) -> i64
extern fn rt_pg_db_result_release(owner_handle: i64,
    result_cursor: i64) -> i64

# Immutable worker limits use a distinct scalar symbol family. The legacy
# aggregate registry remains isolated until its callers are migrated in one
# ownership-safe change.
extern fn rt_pg_wire_limits_scalar_new(owner_handle: i64,
    max_sessions: i64, read_chunk: i64, max_frame: i64,
    max_parameters: i64, max_buffer: i64, max_response: i64,
    read_timeout_ms: i64, write_timeout_ms: i64) -> i64
extern fn rt_pg_wire_limits_scalar_get(owner_handle: i64,
    limits_handle: i64, field: i64) -> i64
extern fn rt_pg_wire_limits_scalar_release(owner_handle: i64,
    limits_handle: i64) -> i64

# Immutable worker configuration is copied into a runtime-owned bounded record.
# Workers recover it only through scalar fields/bytes and rebuild local text.
extern fn rt_pg_wire_server_config_scalar_new(owner_handle: i64,
    ssl_policy: i64, user_ptr: i64, user_len: i64,
    database_ptr: i64, database_len: i64) -> i64
extern fn rt_pg_wire_server_config_scalar_get(owner_handle: i64,
    config_handle: i64, field: i64) -> i64
extern fn rt_pg_wire_server_config_scalar_byte(owner_handle: i64,
    config_handle: i64, which: i64, index: i64) -> i64
extern fn rt_pg_wire_server_config_scalar_release(owner_handle: i64,
    config_handle: i64) -> i64

export PG_DB_ABI_FALSE, PG_DB_ABI_TRUE, PG_DB_ABI_INVALID_HANDLE
export PG_DB_OP_ADMIT_CONNECTION, PG_DB_OP_BEGIN_DRAIN
export PG_DB_OP_MARK_STARTED, PG_DB_OP_MARK_COMPLETED
export PG_DB_OP_STARTED_COUNT, PG_DB_OP_COMPLETED_COUNT
export PG_DB_OP_ACTIVE_COUNT, PG_DB_OP_IS_DRAINING
export PG_DB_OP_MARK_STOPPED, PG_DB_OP_STOPPED_COUNT
export PG_DB_STATUS_OK, PG_DB_STATUS_INVALID_HANDLE, PG_DB_STATUS_REJECTED
export PG_DB_STATUS_UNKNOWN_OPERATION, PG_DB_STATUS_INVALID_ARGUMENT
export PG_DB_RESULT_FIELD_OK, PG_DB_RESULT_FIELD_STATUS
export PG_DB_RESULT_FIELD_VALUE, PG_DB_RESULT_FIELD_STARTED_COUNT
export PG_DB_RESULT_FIELD_COMPLETED_COUNT, PG_DB_RESULT_FIELD_ACTIVE_COUNT
export PG_DB_RESULT_FIELD_DRAINING
export PG_WIRE_LIMIT_MAX_SESSIONS, PG_WIRE_LIMIT_READ_CHUNK
export PG_WIRE_LIMIT_MAX_FRAME, PG_WIRE_LIMIT_MAX_PARAMETERS
export PG_WIRE_LIMIT_MAX_BUFFER, PG_WIRE_LIMIT_MAX_RESPONSE
export PG_WIRE_LIMIT_READ_TIMEOUT_MS, PG_WIRE_LIMIT_WRITE_TIMEOUT_MS
export rt_pg_db_control_create, rt_pg_db_control_operation
export rt_pg_db_control_release, rt_pg_db_result_get
export rt_pg_db_result_ok, rt_pg_db_result_status, rt_pg_db_result_value
export rt_pg_db_result_started_count, rt_pg_db_result_completed_count
export rt_pg_db_result_active_count, rt_pg_db_result_draining
export rt_pg_db_result_release
export rt_pg_wire_limits_scalar_new, rt_pg_wire_limits_scalar_get
export rt_pg_wire_limits_scalar_release
export rt_pg_wire_server_config_scalar_new, rt_pg_wire_server_config_scalar_get
export rt_pg_wire_server_config_scalar_byte, rt_pg_wire_server_config_scalar_release
