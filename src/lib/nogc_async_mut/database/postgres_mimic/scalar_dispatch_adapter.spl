"""Token-only pgwire dispatch adapters; lifecycle mutation remains parent-owned.

The admitted vertical slice below is scalar at the execution boundary:

* a frontend publishes a request and receives an ``i64`` request token;
* the owner claims an ``i64`` claim token and reads scalar metadata/bytes;
* a completion is an ``i64`` result receipt referring to an owner-held blob.

No Simple aggregate is passed through an extern declaration or retained by a
worker.  The ``poll``/``claim_text``/``publish_encoded`` helpers at the end of
the file are compatibility conveniences for the not-yet-migrated server
adapter; they immediately lower to the scalar API and are not the admitted
worker contract.
"""

extern fn rt_string_data(value: text) -> i64
extern fn rt_string_len(value: text) -> i64
extern fn rt_array_data_ptr_u8(value: [u8]) -> i64
extern fn rt_pg_dispatch_port_new() -> i64
extern fn rt_pg_dispatch_port_release(port: i64) -> i64
extern fn rt_pg_dispatch_port_pending_count(port: i64) -> i64
extern fn rt_pg_dispatch_startup(port: i64, connection: i64,
    user_ptr: i64, user_len: i64, database_ptr: i64, database_len: i64,
    application_ptr: i64, application_len: i64, deadline: i64) -> i64
extern fn rt_pg_dispatch_submit(port: i64, connection: i64, session: i64,
    payload_ptr: i64, payload_len: i64, deadline: i64) -> i64
extern fn rt_pg_dispatch_cancel(port: i64, connection: i64) -> i64
extern fn rt_pg_dispatch_terminate(port: i64, connection: i64, session: i64) -> i64
extern fn rt_pg_dispatch_result_poll(port: i64, request: i64) -> i64
extern fn rt_pg_dispatch_result_get(receipt: i64, field: i64) -> i64
extern fn rt_pg_dispatch_result_release(receipt: i64) -> i64
extern fn rt_pg_completion_blob_get(blob: i64, field: i64) -> i64
extern fn rt_pg_completion_blob_byte(blob: i64, index: i64) -> i64
extern fn rt_pg_completion_blob_release(blob: i64) -> i64
extern fn rt_pg_dispatch_owner_claim(port: i64) -> i64
extern fn rt_pg_dispatch_claim_get(claim: i64, field: i64) -> i64
extern fn rt_pg_dispatch_claim_text_meta(claim: i64, which: i64,
    field: i64) -> i64
extern fn rt_pg_dispatch_claim_text_byte(claim: i64, which: i64,
    index: i64) -> i64
extern fn rt_pg_dispatch_complete_by_claim(claim: i64, status: i64,
    value: i64) -> i64
extern fn rt_pg_dispatch_abort_claim(claim: i64, status: i64) -> i64
extern fn rt_pg_completion_blob_new_v1(ptr: i64, len: i64, session: i64,
    close: i64, operation: i64) -> i64

const PG_SCALAR_DISPATCH_RESULT_ID: i64 = 0
const PG_SCALAR_DISPATCH_RESULT_STATUS: i64 = 1
const PG_SCALAR_DISPATCH_RESULT_VALUE: i64 = 2
const PG_SCALAR_DISPATCH_BLOB_LENGTH: i64 = 0
const PG_SCALAR_DISPATCH_BLOB_SESSION: i64 = 2
const PG_SCALAR_DISPATCH_BLOB_CLOSE: i64 = 3
const PG_SCALAR_DISPATCH_BLOB_OPERATION: i64 = 4

struct PgScalarFrontendResult:
    operation: i64
    session_id: i64
    close_connection: bool
    bytes: [u8]

class PgScalarFrontendAdapter:
    port_token: i64
    config_token: i64
    connection_id: i64

    # Strict scalar request API. The byte ranges are borrowed for the call;
    # runtime_db copies them into its bounded queue before returning.
    fn publish_startup_scalars(user_ptr: i64, user_len: i64,
            database_ptr: i64, database_len: i64, application_ptr: i64,
            application_len: i64, deadline: i64) -> i64:
        rt_pg_dispatch_startup(self.port_token, self.connection_id,
            user_ptr, user_len, database_ptr, database_len,
            application_ptr, application_len, deadline)

    fn publish_query_scalars(session: i64, payload_ptr: i64,
            payload_len: i64, deadline: i64) -> i64:
        rt_pg_dispatch_submit(self.port_token, self.connection_id, session,
            payload_ptr, payload_len, deadline)

    # Compatibility text wrappers. They only extract scalar pointer/length
    # pairs, then call the strict scalar methods above.
    fn publish_startup(user: text, database: text, application: text,
            deadline: i64) -> i64:
        self.publish_startup_scalars(rt_string_data(user), rt_string_len(user),
            rt_string_data(database), rt_string_len(database),
            rt_string_data(application), rt_string_len(application), deadline)

    fn publish_query(session: i64, query: text, deadline: i64) -> i64:
        self.publish_query_scalars(session, rt_string_data(query),
            rt_string_len(query), deadline)

    fn cancel() -> i64: rt_pg_dispatch_cancel(self.port_token, self.connection_id)
    fn terminate(session: i64) -> i64:
        rt_pg_dispatch_terminate(self.port_token, self.connection_id, session)

    # Strict scalar receipt API. The receipt and its blob are owner-held
    # generation handles; callers must release both after reading them.
    fn poll_receipt(request: i64) -> i64:
        if request <= 0: return 0
        rt_pg_dispatch_result_poll(self.port_token, request)

    fn result_id(receipt: i64) -> i64:
        if receipt <= 0: return -1
        rt_pg_dispatch_result_get(receipt, PG_SCALAR_DISPATCH_RESULT_ID)

    fn result_status(receipt: i64) -> i64:
        if receipt <= 0: return -1
        rt_pg_dispatch_result_get(receipt, PG_SCALAR_DISPATCH_RESULT_STATUS)

    fn result_blob(receipt: i64) -> i64:
        if receipt <= 0: return 0
        rt_pg_dispatch_result_get(receipt, PG_SCALAR_DISPATCH_RESULT_VALUE)

    fn release_result(receipt: i64) -> bool:
        if receipt <= 0: return false
        rt_pg_dispatch_result_release(receipt) > 0

    fn blob_length(blob: i64) -> i64:
        if blob <= 0: return -1
        rt_pg_completion_blob_get(blob, PG_SCALAR_DISPATCH_BLOB_LENGTH)

    fn blob_session(blob: i64) -> i64:
        if blob <= 0: return -1
        rt_pg_completion_blob_get(blob, PG_SCALAR_DISPATCH_BLOB_SESSION)

    fn blob_close(blob: i64) -> i64:
        if blob <= 0: return -1
        rt_pg_completion_blob_get(blob, PG_SCALAR_DISPATCH_BLOB_CLOSE)

    fn blob_operation(blob: i64) -> i64:
        if blob <= 0: return -1
        rt_pg_completion_blob_get(blob, PG_SCALAR_DISPATCH_BLOB_OPERATION)

    fn blob_byte(blob: i64, index: i64) -> i64:
        if blob <= 0 or index < 0: return -1
        rt_pg_completion_blob_byte(blob, index)

    fn release_blob(blob: i64) -> bool:
        if blob <= 0: return false
        rt_pg_completion_blob_release(blob) > 0

    # Compatibility aggregate helper. It is deliberately implemented only in
    # terms of scalar handles and is not part of the worker boundary.
    fn poll(request: i64) -> PgScalarFrontendResult?:
        val receipt = self.poll_receipt(request)
        if receipt <= 0: return nil
        val status = self.result_status(receipt)
        val blob = self.result_blob(receipt)
        if status != 0 or blob <= 0:
            val _ = self.release_result(receipt)
            return nil
        val length = self.blob_length(blob)
        var bytes: [u8] = []
        var index = 0
        while index < length:
            val octet = self.blob_byte(blob, index)
            if octet < 0:
                val _ = self.release_blob(blob)
                val _ = self.release_result(receipt)
                return nil
            bytes.push(octet as u8)
            index = index + 1
        val result = PgScalarFrontendResult(
            operation: self.blob_operation(blob),
            session_id: self.blob_session(blob),
            close_connection: self.blob_close(blob) != 0,
            bytes: bytes)
        # Blob first, then its enclosing result receipt; each exactly once.
        val _ = self.release_blob(blob)
        val _ = self.release_result(receipt)
        Some(result)

class PgScalarDispatchOwner:
    port_token: i64

    fn claim_next() -> i64: rt_pg_dispatch_owner_claim(self.port_token)
    fn pending_count() -> i64:
        rt_pg_dispatch_port_pending_count(self.port_token)
    fn claim_request_id(claim: i64) -> i64:
        rt_pg_dispatch_claim_get(claim, 0)
    fn claim_operation(claim: i64) -> i64:
        rt_pg_dispatch_claim_get(claim, 1)
    fn claim_connection(claim: i64) -> i64:
        rt_pg_dispatch_claim_get(claim, 2)
    fn claim_session(claim: i64) -> i64:
        rt_pg_dispatch_claim_get(claim, 3)

    fn claim_deadline(claim: i64) -> i64:
        rt_pg_dispatch_claim_get(claim, 4)

    # Strict scalar text API. A worker may copy bytes into its own local
    # buffer, but no array is returned by the owner/runtime boundary.
    fn claim_text_length(claim: i64, which: i64) -> i64:
        if claim <= 0 or which < 0 or which > 2: return -1
        rt_pg_dispatch_claim_text_meta(claim, which, 0)

    fn claim_text_hash(claim: i64, which: i64) -> i64:
        if claim <= 0 or which < 0 or which > 2: return -1
        rt_pg_dispatch_claim_text_meta(claim, which, 1)

    fn claim_text_byte_at(claim: i64, which: i64, index: i64) -> i64:
        if claim <= 0 or which < 0 or which > 2 or index < 0: return -1
        rt_pg_dispatch_claim_text_byte(claim, which, index)

    fn claim_text(claim: i64, which: i64) -> [u8]:
        val length = rt_pg_dispatch_claim_text_meta(claim, which, 0)
        var bytes: [u8] = []
        var index = 0
        while index < length:
            val octet = rt_pg_dispatch_claim_text_byte(claim, which, index)
            if octet < 0: return []
            bytes.push(octet as u8)
            index = index + 1
        bytes

    fn abort_claim(claim: i64, status: i64) -> bool:
        if claim <= 0: return false
        val safe_status = if status == 0: 1 else status
        # The runtime invalidates the claim while publishing the abort. A
        # second abort or publish therefore fails closed and cannot complete
        # the parent gate twice.
        rt_pg_dispatch_abort_claim(claim, safe_status) > 0

    fn publish_blob(claim: i64, status: i64, blob: i64) -> bool:
        if claim <= 0 or blob <= 0: return false
        rt_pg_dispatch_complete_by_claim(claim, status, blob) > 0

    # Strict scalar encoded-result API. ``payload_ptr`` is borrowed only for
    # the call; the runtime copies it into an owner-held blob before the claim
    # is consumed. The pointer is never retained or transported.
    fn publish_encoded_scalars(claim: i64, operation: i64, session: i64,
            close_connection: i64, payload_ptr: i64, payload_len: i64,
            status: i64 = 0) -> bool:
        if (claim <= 0 or operation < 0 or operation > 4 or session < 0 or
                close_connection < 0 or close_connection > 1 or
                payload_ptr < 0 or payload_len < 0):
            return false
        val blob = rt_pg_completion_blob_new_v1(payload_ptr, payload_len,
            session, close_connection, operation)
        if blob <= 0: return false
        if not self.publish_blob(claim, status, blob):
            # A failed/duplicate claim completion must not leak the blob.
            val _ = rt_pg_completion_blob_release(blob)
            return false
        true

    # Compatibility convenience. It lowers the array to pointer/length before
    # entering the scalar runtime ABI; it is not the admitted worker method.
    fn publish_encoded(request: i64, operation: i64, session: i64,
            close_connection: bool, bytes: [u8]) -> bool:
        self.publish_encoded_scalars(request, operation, session,
            if close_connection: 1 else: 0, rt_array_data_ptr_u8(bytes),
            bytes.len())

# This owner is deliberately the only constructor for the non-live scalar
# dispatch readiness slice. It owns one runtime port token and exposes only
# scalar adapter views. It does not accept an aggregate dispatch gate, config
# aggregates,
# callbacks, or any other RuntimeValue at an external boundary.
class PgScalarDispatchPortV1:
    port_token: i64
    released: bool

    static fn create() -> PgScalarDispatchPortV1?:
        val token = rt_pg_dispatch_port_new()
        if token <= 0: return nil
        Some(PgScalarDispatchPortV1(port_token: token, released: false))

    fn frontend(connection_id: i64) -> PgScalarFrontendAdapter?:
        if self.released or connection_id <= 0: return nil
        # config_token is reserved for the separately scalarized config view;
        # zero means no config aggregate is admitted by this readiness slice.
        Some(PgScalarFrontendAdapter(port_token: self.port_token,
            config_token: 0, connection_id: connection_id))

    fn owner() -> PgScalarDispatchOwner?:
        if self.released: return nil
        Some(PgScalarDispatchOwner(port_token: self.port_token))

    me release() -> bool:
        if self.released: return false
        val released = rt_pg_dispatch_port_release(self.port_token) > 0
        if released: self.released = true
        released

export PG_SCALAR_DISPATCH_RESULT_ID, PG_SCALAR_DISPATCH_RESULT_STATUS
export PG_SCALAR_DISPATCH_RESULT_VALUE, PG_SCALAR_DISPATCH_BLOB_LENGTH
export PG_SCALAR_DISPATCH_BLOB_SESSION, PG_SCALAR_DISPATCH_BLOB_CLOSE
export PG_SCALAR_DISPATCH_BLOB_OPERATION
export PgScalarFrontendResult, PgScalarFrontendAdapter, PgScalarDispatchOwner
export PgScalarDispatchPortV1
