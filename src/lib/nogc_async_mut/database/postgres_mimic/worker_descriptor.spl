"""Scalar-only native handoff contract for pgwire socket workers.

No Simple aggregate, ``Any``, text, raw address, or borrowed object crosses
this SFFI.  ``control_id`` and ``dispatch_id`` name runtime-owned shared state;
``limits_id`` and ``config_id`` name immutable validated snapshots.  The
descriptor owns none of those resources: the parent remains canonical owner,
releases the descriptor only after join, then releases the named resources.
"""

const PG_WORKER_FIELD_WORKER_ID: i64 = 0
const PG_WORKER_FIELD_LISTENER_FD: i64 = 1
const PG_WORKER_FIELD_CONTROL_ID: i64 = 2
const PG_WORKER_FIELD_DISPATCH_ID: i64 = 3
const PG_WORKER_FIELD_LIMITS_ID: i64 = 4
const PG_WORKER_FIELD_CONFIG_ID: i64 = 5
const PG_WORKER_DESCRIPTOR_INVALID: i64 = -9223372036854775808

extern fn rt_pg_worker_descriptor_new(worker_id: i64, listener_fd: i64,
    control_id: i64, dispatch_id: i64, limits_id: i64, config_id: i64) -> i64
extern fn rt_pg_worker_descriptor_get(token: i64, field: i64) -> i64
extern fn rt_pg_worker_descriptor_release(token: i64) -> i64

struct PgWorkerScalarDescriptor:
    worker_id: i64
    listener_fd: i64
    control_id: i64
    dispatch_id: i64
    limits_id: i64
    config_id: i64

fn pg_worker_descriptor_valid(value: PgWorkerScalarDescriptor) -> bool:
    value.worker_id >= 0 and value.listener_fd >= 0 and
        value.control_id > 0 and value.dispatch_id > 0 and
        value.limits_id > 0 and value.config_id > 0

fn pg_worker_descriptor_publish(value: PgWorkerScalarDescriptor) -> i64:
    if not pg_worker_descriptor_valid(value): return 0
    rt_pg_worker_descriptor_new(value.worker_id, value.listener_fd,
        value.control_id, value.dispatch_id, value.limits_id, value.config_id)

fn pg_worker_descriptor_acquire(token: i64) -> PgWorkerScalarDescriptor?:
    val worker_id = rt_pg_worker_descriptor_get(token, PG_WORKER_FIELD_WORKER_ID)
    val listener_fd = rt_pg_worker_descriptor_get(token, PG_WORKER_FIELD_LISTENER_FD)
    val control_id = rt_pg_worker_descriptor_get(token, PG_WORKER_FIELD_CONTROL_ID)
    val dispatch_id = rt_pg_worker_descriptor_get(token, PG_WORKER_FIELD_DISPATCH_ID)
    val limits_id = rt_pg_worker_descriptor_get(token, PG_WORKER_FIELD_LIMITS_ID)
    val config_id = rt_pg_worker_descriptor_get(token, PG_WORKER_FIELD_CONFIG_ID)
    val value = PgWorkerScalarDescriptor(worker_id: worker_id,
        listener_fd: listener_fd, control_id: control_id,
        dispatch_id: dispatch_id, limits_id: limits_id, config_id: config_id)
    if not pg_worker_descriptor_valid(value): return nil
    value

fn pg_worker_descriptor_release(token: i64) -> bool:
    rt_pg_worker_descriptor_release(token) == 1

export PgWorkerScalarDescriptor, pg_worker_descriptor_valid
export pg_worker_descriptor_publish, pg_worker_descriptor_acquire
export pg_worker_descriptor_release, PG_WORKER_DESCRIPTOR_INVALID
