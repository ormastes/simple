"""Parent-owned scalar control operations for a future pgwire runtime port.

The parent owns this bounded generation registry and keeps the returned handle
until every worker has stopped using it. ``PgDbControlOpRequest`` and
``PgDbControlOpResult`` are pure-Simple owner-model values; despite containing
only scalar fields, they are aggregates and MUST NOT cross SFFI or a thread
boundary. The future worker port must flatten calls to scalar arguments such
as ``apply(owner_handle:i64, control_handle:i64, operation:i64,
argument:i64)`` and expose scalar status/value/counter getters. No text, enum,
aggregate, socket, or runtime object may cross that port. The current
implementation is deliberately pure Simple; server/runtime wiring is a
separate change.

Handles contain the registry namespace, slot, and generation.  A handle from a
different registry, a malformed value, or a released handle fails closed and
cannot read or mutate another slot.
"""

const PG_DB_CONTROL_OP_ADMIT_CONNECTION: i64 = 1
const PG_DB_CONTROL_OP_BEGIN_DRAIN: i64 = 2
const PG_DB_CONTROL_OP_MARK_STARTED: i64 = 3
const PG_DB_CONTROL_OP_MARK_COMPLETED: i64 = 4
const PG_DB_CONTROL_OP_STARTED_COUNT: i64 = 5
const PG_DB_CONTROL_OP_COMPLETED_COUNT: i64 = 6
const PG_DB_CONTROL_OP_ACTIVE_COUNT: i64 = 7
const PG_DB_CONTROL_OP_IS_DRAINING: i64 = 8

const PG_DB_CONTROL_STATUS_OK: i64 = 0
const PG_DB_CONTROL_STATUS_INVALID_HANDLE: i64 = 1
const PG_DB_CONTROL_STATUS_REJECTED: i64 = 2
const PG_DB_CONTROL_STATUS_UNKNOWN_OPERATION: i64 = 3
const PG_DB_CONTROL_STATUS_INVALID_ARGUMENT: i64 = 4

const PG_DB_CONTROL_INVALID: i64 = 0
const PG_DB_CONTROL_MAX_SLOTS: i64 = 1024
const PG_DB_CONTROL_SLOT_RADIX: i64 = 2048
const PG_DB_CONTROL_GENERATION_RADIX: i64 = 1000000
const PG_DB_CONTROL_NAMESPACE_STRIDE: i64 = 2048000000
const PG_DB_CONTROL_MAX_NAMESPACE: i64 = 4000000

struct PgDbControlOpRequest:
    handle: i64
    operation: i64
    argument: i64

struct PgDbControlOpResult:
    ok: bool
    status: i64
    value: i64
    started_count: i64
    completed_count: i64
    active_count: i64
    draining: bool

struct PgDbControlEntry:
    generation: i64
    live: bool
    max_connections: i64
    next_connection_id: i64
    active_count: i64
    started_count: i64
    completed_count: i64
    draining: bool

fn pg_db_control_empty_result(status: i64) -> PgDbControlOpResult:
    PgDbControlOpResult(ok: false, status: status, value: 0,
        started_count: 0, completed_count: 0, active_count: 0,
        draining: false)

class PgDbControlRegistry:
    namespace: i64
    capacity: i64
    entries: [PgDbControlEntry]

    static fn create(namespace: i64, capacity: i64 = 64) -> PgDbControlRegistry:
        val bounded_namespace = if namespace > 0 and
                namespace <= PG_DB_CONTROL_MAX_NAMESPACE: namespace else: 1
        val bounded_capacity = if capacity > 0 and
                capacity <= PG_DB_CONTROL_MAX_SLOTS: capacity
            elif capacity > PG_DB_CONTROL_MAX_SLOTS: PG_DB_CONTROL_MAX_SLOTS
            else: 1
        var entries: [PgDbControlEntry] = []
        var index = 0
        while index < bounded_capacity:
            entries.push(PgDbControlEntry(generation: 1, live: false,
                max_connections: 0, next_connection_id: 1,
                active_count: 0, started_count: 0, completed_count: 0,
                draining: false))
            index = index + 1
        PgDbControlRegistry(namespace: bounded_namespace,
            capacity: bounded_capacity, entries: entries)

    fn encode_handle(slot: i64, generation: i64) -> i64:
        self.namespace * PG_DB_CONTROL_NAMESPACE_STRIDE +
            generation * PG_DB_CONTROL_SLOT_RADIX + slot + 1

    fn decode_slot(handle: i64) -> i64:
        if handle <= 0: return -1
        if handle / PG_DB_CONTROL_NAMESPACE_STRIDE != self.namespace: return -1
        val remainder = handle % PG_DB_CONTROL_NAMESPACE_STRIDE
        val generation = remainder / PG_DB_CONTROL_SLOT_RADIX
        val local = remainder % PG_DB_CONTROL_SLOT_RADIX
        if generation <= 0 or local <= 0 or local > self.capacity: return -1
        val slot = local - 1
        if self.entries[slot].generation != generation or
                not self.entries[slot].live: return -1
        slot

    me create_control(max_connections: i64) -> i64:
        if max_connections <= 0: return PG_DB_CONTROL_INVALID
        var slot = 0
        while slot < self.capacity:
            val entry = self.entries[slot]
            if not entry.live and entry.generation < PG_DB_CONTROL_GENERATION_RADIX:
                self.entries[slot] = PgDbControlEntry(
                    generation: entry.generation, live: true,
                    max_connections: max_connections, next_connection_id: 1,
                    active_count: 0, started_count: 0, completed_count: 0,
                    draining: false)
                return self.encode_handle(slot, entry.generation)
            slot = slot + 1
        PG_DB_CONTROL_INVALID

    me release(handle: i64) -> bool:
        val slot = self.decode_slot(handle)
        if slot < 0: return false
        val entry = self.entries[slot]
        self.entries[slot] = PgDbControlEntry(
            generation: entry.generation + 1, live: false,
            max_connections: 0, next_connection_id: 1, active_count: 0,
            started_count: 0, completed_count: 0, draining: false)
        true

    fn snapshot(slot: i64, value: i64, status: i64, ok: bool) -> PgDbControlOpResult:
        val entry = self.entries[slot]
        PgDbControlOpResult(ok: ok, status: status, value: value,
            started_count: entry.started_count,
            completed_count: entry.completed_count,
            active_count: entry.active_count, draining: entry.draining)

    me apply(request: PgDbControlOpRequest) -> PgDbControlOpResult:
        val slot = self.decode_slot(request.handle)
        if slot < 0: return pg_db_control_empty_result(
            PG_DB_CONTROL_STATUS_INVALID_HANDLE)
        var entry = self.entries[slot]
        var value = 0
        if request.operation == PG_DB_CONTROL_OP_ADMIT_CONNECTION:
            if entry.draining or entry.active_count >= entry.max_connections:
                return self.snapshot(slot, 0, PG_DB_CONTROL_STATUS_REJECTED, false)
            value = entry.next_connection_id
            entry.next_connection_id = entry.next_connection_id + 1
            entry.active_count = entry.active_count + 1
        elif request.operation == PG_DB_CONTROL_OP_BEGIN_DRAIN:
            entry.draining = true
            value = entry.active_count
        elif request.operation == PG_DB_CONTROL_OP_MARK_STARTED:
            entry.started_count = entry.started_count + 1
            value = entry.started_count
        elif request.operation == PG_DB_CONTROL_OP_MARK_COMPLETED:
            if entry.active_count <= 0:
                return self.snapshot(slot, 0,
                    PG_DB_CONTROL_STATUS_INVALID_ARGUMENT, false)
            entry.active_count = entry.active_count - 1
            entry.completed_count = entry.completed_count + 1
            value = entry.completed_count
        elif request.operation == PG_DB_CONTROL_OP_STARTED_COUNT:
            value = entry.started_count
        elif request.operation == PG_DB_CONTROL_OP_COMPLETED_COUNT:
            value = entry.completed_count
        elif request.operation == PG_DB_CONTROL_OP_ACTIVE_COUNT:
            value = entry.active_count
        elif request.operation == PG_DB_CONTROL_OP_IS_DRAINING:
            value = if entry.draining: 1 else 0
        else:
            return self.snapshot(slot, 0,
                PG_DB_CONTROL_STATUS_UNKNOWN_OPERATION, false)
        self.entries[slot] = entry
        self.snapshot(slot, value, PG_DB_CONTROL_STATUS_OK, true)

    fn valid(handle: i64) -> bool: self.decode_slot(handle) >= 0

fn pg_db_control_registry(namespace: i64,
        capacity: i64 = 64) -> PgDbControlRegistry:
    PgDbControlRegistry.create(namespace, capacity)

fn pg_db_control_create(registry: PgDbControlRegistry,
        max_connections: i64) -> i64:
    registry.create_control(max_connections)

fn pg_db_control_apply(registry: PgDbControlRegistry,
        request: PgDbControlOpRequest) -> PgDbControlOpResult:
    registry.apply(request)

fn pg_db_control_admit(registry: PgDbControlRegistry, handle: i64) -> PgDbControlOpResult:
    registry.apply(PgDbControlOpRequest(handle: handle,
        operation: PG_DB_CONTROL_OP_ADMIT_CONNECTION, argument: 0))

fn pg_db_control_begin_drain(registry: PgDbControlRegistry,
        handle: i64) -> PgDbControlOpResult:
    registry.apply(PgDbControlOpRequest(handle: handle,
        operation: PG_DB_CONTROL_OP_BEGIN_DRAIN, argument: 0))

fn pg_db_control_started(registry: PgDbControlRegistry,
        handle: i64) -> PgDbControlOpResult:
    registry.apply(PgDbControlOpRequest(handle: handle,
        operation: PG_DB_CONTROL_OP_MARK_STARTED, argument: 0))

fn pg_db_control_completed(registry: PgDbControlRegistry,
        handle: i64) -> PgDbControlOpResult:
    registry.apply(PgDbControlOpRequest(handle: handle,
        operation: PG_DB_CONTROL_OP_MARK_COMPLETED, argument: 0))

fn pg_db_control_started_count(registry: PgDbControlRegistry,
        handle: i64) -> PgDbControlOpResult:
    registry.apply(PgDbControlOpRequest(handle: handle,
        operation: PG_DB_CONTROL_OP_STARTED_COUNT, argument: 0))

fn pg_db_control_completed_count(registry: PgDbControlRegistry,
        handle: i64) -> PgDbControlOpResult:
    registry.apply(PgDbControlOpRequest(handle: handle,
        operation: PG_DB_CONTROL_OP_COMPLETED_COUNT, argument: 0))

fn pg_db_control_release(registry: PgDbControlRegistry, handle: i64) -> bool:
    registry.release(handle)

export PgDbControlOpRequest, PgDbControlOpResult, PgDbControlEntry
export PgDbControlRegistry, pg_db_control_registry, pg_db_control_create
export pg_db_control_apply, pg_db_control_admit, pg_db_control_begin_drain
export pg_db_control_started, pg_db_control_completed
export pg_db_control_started_count, pg_db_control_completed_count
export pg_db_control_release
export PG_DB_CONTROL_OP_ADMIT_CONNECTION, PG_DB_CONTROL_OP_BEGIN_DRAIN
export PG_DB_CONTROL_OP_MARK_STARTED, PG_DB_CONTROL_OP_MARK_COMPLETED
export PG_DB_CONTROL_OP_STARTED_COUNT, PG_DB_CONTROL_OP_COMPLETED_COUNT
export PG_DB_CONTROL_OP_ACTIVE_COUNT, PG_DB_CONTROL_OP_IS_DRAINING
export PG_DB_CONTROL_STATUS_OK, PG_DB_CONTROL_STATUS_INVALID_HANDLE
export PG_DB_CONTROL_STATUS_REJECTED, PG_DB_CONTROL_STATUS_UNKNOWN_OPERATION
export PG_DB_CONTROL_STATUS_INVALID_ARGUMENT, PG_DB_CONTROL_INVALID
