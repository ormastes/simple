# Parallel-lex executor seam for wave-2.
#
# Deliberately returns an explicit contract failure in wave-1.

use std.common.structural.parse.contracts.{ParseError, ParseErrorCode, SourceSpan}
use std.common.structural.parse.output_plan.{ParseOutputRange}
use std.common.structural.parse.parse_types.{ParseDiagnosticArena, ParseDialect, ParseTokenArena}

struct LexChunkSummary:
    source_span: SourceSpan
    source_digest: text
    state_count: i64
    token_counts: [i64]
    diagnostic_counts: [i64]

struct LexChunkState:
    entry_state: i64
    exit_state: i64

struct ParallelLexPlan:
    summaries: [LexChunkSummary]
    states: [LexChunkState]
    token_ranges: [ParseOutputRange]
    diagnostic_ranges: [ParseOutputRange]
    region_ordinals: [i64]

struct ParallelLexOutput:
    tokens: ParseTokenArena
    diagnostics: ParseDiagnosticArena
    region_ordinals: [i64]

fn emit_parallel_tokens(dialect: ParseDialect, plan: ParallelLexPlan) -> Result<ParallelLexOutput, ParseError>:
    Err(ParseError(
        code: ParseErrorCode.UnsupportedMode,
        message: "emit_parallel_tokens is not implemented in wave-1",
        span: nil
    ))

fn compose_chunk_summaries(
    _program: ParseDialect,
    summaries: [LexChunkSummary]
) -> Result<[LexChunkState], ParseError>:
    Err(ParseError(
        code: ParseErrorCode.UnsupportedMode,
        message: "compose_chunk_summaries is not implemented in wave-1",
        span: nil
    ))

export LexChunkSummary
export LexChunkState
export ParallelLexPlan
export ParallelLexOutput
export compose_chunk_summaries
export emit_parallel_tokens
