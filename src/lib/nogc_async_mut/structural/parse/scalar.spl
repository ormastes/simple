# Scalar executor wrapper for the parser framework.

use std.common.structural.parse.parse_types.{ParseDialect, ParseRequest, ParseResult}
use std.common.structural.parse.parse_cpu_reference.{parse_run_cpu_reference}

fn parse_run_scalar(dialect: ParseDialect, request: ParseRequest) -> ParseResult:
    parse_run_cpu_reference(dialect, request)

fn parse_request_scalar(dialect: ParseDialect, request: ParseRequest) -> ParseResult:
    parse_run_cpu_reference(dialect, request)

export parse_run_scalar, parse_request_scalar
