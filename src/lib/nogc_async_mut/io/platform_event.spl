"""
# Platform Event — Cross-Platform Network Event Abstraction

Provides a unified API over platform-native I/O notification mechanisms.
The native provider supports Linux and macOS/FreeBSD descriptor notifications.
`poll_descriptors` returns copied FDs only; zero observations may also mean a
native syscall error. Legacy readiness triples are unavailable and fail explicitly.
Other platform backends remain unsupported.

## Backends

| Backend | Platform | Characteristics |
|---------|----------|----------------|
| Epoll | Linux | Level/edge-triggered, O(1) readiness notification |
| Kqueue | BSD/macOS | Level-triggered unless EV_CLEAR is requested |
| Iocp | Windows | Unsupported by current native provider |
| EventPorts | Solaris/illumos | Unsupported by current native provider |
| Poll | Other | Unsupported; create fails |

## Usage

```text
val pe = PlatformEvent.new()
val handle = pe.create()
pe.register(handle, socket_fd, EventMode.Read)
val observation = pe.poll_descriptors(handle, 64, 25)
pe.close(handle)
```
"""

use std.io.types.{IoError, IoErrorKind}
use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new_gate, mutex_try_lock_gate, mutex_unlock_gate}

# ============================================================================
# Enums
# ============================================================================

enum EventMode:
    """Interest mode for event registration.

    Encodes which I/O directions to monitor on a file descriptor.
    Maps to the extern ABI integer encoding: 0=Read, 1=Write, 2=ReadWrite.

    ```simple
    val mode = EventMode.Read
    val both = EventMode.ReadWrite
    ```
    """
    Read
    Write
    ReadWrite

enum EventBackend:
    """Platform-native I/O notification backend.

    Detected at runtime via `platform_name()`. Only one backend
    is active per process.

    ```simple
    val backend = detect_backend()
    # Returns EventBackend.Epoll on Linux
    ```
    """
    Epoll
    Kqueue
    Iocp
    EventPorts
    Poll

# ============================================================================
# Platform Detection
# ============================================================================

use std.io_runtime.{platform_name}

fn detect_backend() -> EventBackend:
    """Detect the best event notification backend for the current OS.

    Returns:
        EventBackend enum variant matching the running platform.
        Falls back to EventBackend.Poll on unknown platforms.

    Example:
        val backend = detect_backend()
        # Linux -> EventBackend.Epoll
        # macOS -> EventBackend.Kqueue
    """
    val platform = platform_name()
    if platform == "linux":
        EventBackend.Epoll
    else if platform == "macos" or platform == "freebsd":
        EventBackend.Kqueue
    else if platform == "windows":
        EventBackend.Iocp
    else if platform == "solaris" or platform == "illumos":
        EventBackend.EventPorts
    else:
        EventBackend.Poll

# ============================================================================
# EventMode <-> i64 Mapping
# ============================================================================

fn _mode_to_i64(mode: EventMode) -> i64:
    """Convert EventMode enum to extern ABI integer."""
    match mode:
        case EventMode.Read: 0
        case EventMode.Write: 1
        case EventMode.ReadWrite: 2

fn _i64_to_mode(value: i64) -> EventMode:
    """Convert extern ABI integer back to EventMode enum."""
    if value == 1:
        EventMode.Write
    else if value == 2:
        EventMode.ReadWrite
    else:
        EventMode.Read

# ============================================================================
# Extern Stubs — Per-Backend Native Functions
# ============================================================================

# Epoll (Linux) — delegates to the existing rt_event_loop_* implementation
@unsafe(reason: "creates a copyable raw epoll handle", capabilities: [ffi, raw_ptr])
extern fn rt_event_loop_create() -> i64
@unsafe(reason: "registers unbranded raw epoll and descriptor handles", capabilities: [ffi, raw_ptr])
extern fn rt_event_loop_register(loop_fd: i64, fd: i64, interest: i64, token: i64, edge: i64) -> i64
@unsafe(reason: "deregisters unbranded raw epoll and descriptor handles", capabilities: [ffi, raw_ptr])
extern fn rt_event_loop_deregister(loop_fd: i64, fd: i64) -> i64
@unsafe(reason: "polls a copyable raw epoll handle and returns a scalar count into process-global descriptor scratch", capabilities: [ffi, raw_ptr])
extern fn rt_event_loop_poll(loop_fd: i64, max_events: i64, timeout_ms: i64) -> i64
@unsafe(reason: "closes a copyable raw epoll handle", capabilities: [ffi, raw_ptr])
extern fn rt_event_loop_close(loop_fd: i64) -> i64

# Kqueue (BSD/macOS)
@unsafe(reason: "creates a copyable raw kqueue handle", capabilities: [ffi, raw_ptr])
extern fn rt_kqueue_create() -> i64
@unsafe(reason: "registers unbranded raw kqueue and descriptor handles", capabilities: [ffi, raw_ptr])
extern fn rt_kqueue_register(loop_fd: i64, fd: i64, interest: i64, token: i64, edge: i64) -> i64
@unsafe(reason: "deregisters unbranded raw kqueue and descriptor handles", capabilities: [ffi, raw_ptr])
extern fn rt_kqueue_deregister(loop_fd: i64, fd: i64) -> i64
@unsafe(reason: "polls a copyable raw kqueue handle and returns a scalar count into process-global descriptor scratch", capabilities: [ffi, raw_ptr])
extern fn rt_kqueue_poll(loop_fd: i64, max_events: i64, timeout_ms: i64) -> i64
@unsafe(reason: "closes a copyable raw kqueue handle", capabilities: [ffi, raw_ptr])
extern fn rt_kqueue_close(loop_fd: i64) -> i64

# IOCP (Windows)
# NOTE: IOCP is completion-based (proactor pattern). The register/poll API
# here provides a readiness-based facade. Internally IOCP uses
# GetQueuedCompletionStatusEx or WSAPoll as a transitional fallback.
@unsafe(reason: "creates a copyable raw IOCP handle", capabilities: [ffi, raw_ptr])
extern fn rt_iocp_create() -> i64
@unsafe(reason: "registers unbranded raw IOCP and descriptor handles", capabilities: [ffi, raw_ptr])
extern fn rt_iocp_register(loop_fd: i64, fd: i64, interest: i64, token: i64, edge: i64) -> i64
@unsafe(reason: "deregisters unbranded raw IOCP and descriptor handles", capabilities: [ffi, raw_ptr])
extern fn rt_iocp_deregister(loop_fd: i64, fd: i64) -> i64
@unsafe(reason: "polls a copyable raw IOCP handle and returns a scalar count (currently unsupported)", capabilities: [ffi, raw_ptr])
extern fn rt_iocp_poll(loop_fd: i64, max_events: i64, timeout_ms: i64) -> i64
@unsafe(reason: "closes a copyable raw IOCP handle", capabilities: [ffi, raw_ptr])
extern fn rt_iocp_close(loop_fd: i64) -> i64

# Event Ports (Solaris/illumos)
# NOTE: Event ports are one-shot by default — after receiving an event the fd
# must be re-associated via port_associate before the next poll.
@unsafe(reason: "creates a copyable raw event-port handle", capabilities: [ffi, raw_ptr])
extern fn rt_event_ports_create() -> i64
@unsafe(reason: "registers unbranded raw event-port and descriptor handles", capabilities: [ffi, raw_ptr])
extern fn rt_event_ports_register(loop_fd: i64, fd: i64, interest: i64, token: i64, edge: i64) -> i64
@unsafe(reason: "deregisters unbranded raw event-port and descriptor handles", capabilities: [ffi, raw_ptr])
extern fn rt_event_ports_deregister(loop_fd: i64, fd: i64) -> i64
@unsafe(reason: "polls a copyable raw event-port handle and returns a scalar count into process-global descriptor scratch", capabilities: [ffi, raw_ptr])
extern fn rt_event_ports_poll(loop_fd: i64, max_events: i64, timeout_ms: i64) -> i64
@unsafe(reason: "closes a copyable raw event-port handle", capabilities: [ffi, raw_ptr])
extern fn rt_event_ports_close(loop_fd: i64) -> i64

@unsafe(reason: "reads copied descriptors from native process-global poll scratch under canonical gate", capabilities: [ffi, raw_ptr])
extern fn rt_event_loop_poll_get_fd(index: i64) -> i64

var _event_descriptor_gate_v1: Mutex = mutex_new_gate(0)

pub struct DescriptorObservationV1:
    descriptors: [i64]
    status: text

pub fn descriptor_observation_v1(descriptors: [i64]) -> Result<DescriptorObservationV1, text>:
    if descriptors.len() > 256: return Err("event_descriptor_receipt_invalid")
    for fd in descriptors:
        if fd < 0: return Err("event_descriptor_receipt_invalid")
    # Zero may be timeout OR swallowed native syscall error; never assert idle.
    val status = if descriptors.len() == 0: "no_observation" else: "observed"
    Ok(DescriptorObservationV1(descriptors: descriptors, status: status))

# ============================================================================
# PlatformEvent — Cross-Platform Event Abstraction
# ============================================================================

@unsafe(reason: "raw platform-event facade owns copyable native handles and unverified poll results", capabilities: [ffi, raw_ptr])
class PlatformEvent:
    """Cross-platform event notification abstraction.

    Detects the native backend at construction time and dispatches all
    operations to the appropriate platform-specific extern functions.

    Linux uses epoll, macOS/FreeBSD use kqueue. Other hosts fail creation.
    Descriptor snapshots carry no direction, token or native error guarantee.

    Example:
        val pe = PlatformEvent.new()
        val handle = pe.create()
        pe.register(handle, socket_fd, EventMode.ReadWrite)
        val observation = pe.poll_descriptors(handle, 64, 25)
        pe.close(handle)
    """
    _backend: EventBackend

    static fn new() -> PlatformEvent:
        """Create a PlatformEvent with auto-detected backend.

        Returns:
            PlatformEvent configured for the current platform.
        """
        PlatformEvent(_backend: detect_backend())

    static fn with_backend(backend: EventBackend) -> PlatformEvent:
        """Create a PlatformEvent with a specific backend (for testing).

        Args:
            backend: The backend to use.

        Returns:
            PlatformEvent configured for the given backend.
        """
        PlatformEvent(_backend: backend)

    fn backend() -> EventBackend:
        """Return the active backend enum.

        Returns:
            The EventBackend variant in use.
        """
        self._backend

    fn backend_name() -> text:
        """Return the backend name as a string.

        Returns:
            One of: "epoll", "kqueue", "iocp", "event_ports", "poll"
        """
        match self._backend:
            case EventBackend.Epoll: "epoll"
            case EventBackend.Kqueue: "kqueue"
            case EventBackend.Iocp: "iocp"
            case EventBackend.EventPorts: "event_port"
            case EventBackend.Poll: "poll"

    fn create() -> i64:
        """Create a new event notification handle.

        Returns the platform-native event fd/handle, or -1 on error.
        - epoll: epoll_create1(0) fd
        - kqueue: kqueue() fd
        - IOCP: CreateIoCompletionPort handle (stub, returns handle id)
        - event_ports: port_create() fd (stub, returns handle id)
        - poll: -1 (no native support)

        Returns:
            Native event handle (>= 0) or -1 on error.
        """
        if self._backend != detect_backend(): return -1
        unsafe(capabilities: [ffi, raw_ptr]):
            match self._backend:
                case EventBackend.Epoll: rt_event_loop_create()
                case EventBackend.Kqueue: rt_kqueue_create()
                case EventBackend.Iocp: rt_iocp_create()
                case EventBackend.EventPorts: rt_event_ports_create()
                case EventBackend.Poll: -1

    fn register(handle: i64, fd: i64, mode: EventMode) -> bool:
        """Register an fd for level-triggered event monitoring.

        Args:
            handle: Event loop handle from create()
            fd: File descriptor to monitor
            mode: EventMode.Read, EventMode.Write, or EventMode.ReadWrite

        Platform notes:
            - epoll: EPOLL_CTL_ADD with EPOLLIN/EPOLLOUT
            - kqueue: EV_ADD with EVFILT_READ/EVFILT_WRITE (level-triggered via EV_CLEAR absent)
            - IOCP: WSAPoll registration (stub)
            - event_ports: port_associate with POLLIN/POLLOUT (one-shot by default)

        Returns:
            true on success, false on error.
        """
        if self._backend != detect_backend(): return false
        if handle < 0 or fd < 0:
            return false
        val interest = _mode_to_i64(mode)
        unsafe(capabilities: [ffi, raw_ptr]):
            match self._backend:
                case EventBackend.Epoll: rt_event_loop_register(handle, fd, interest, fd, 0) == 1
                case EventBackend.Kqueue: rt_kqueue_register(handle, fd, interest, fd, 0) == 1
                case EventBackend.Iocp: rt_iocp_register(handle, fd, interest, fd, 0) == 1
                case EventBackend.EventPorts: rt_event_ports_register(handle, fd, interest, fd, 0) == 1
                case EventBackend.Poll: false

    fn register_edge(handle: i64, fd: i64, mode: EventMode) -> bool:
        """Register an fd for edge-triggered event monitoring.

        Edge-triggered mode only notifies on state transitions. The caller
        must drain the fd fully on each notification.

        Args:
            handle: Event loop handle from create()
            fd: File descriptor to monitor
            mode: EventMode.Read, EventMode.Write, or EventMode.ReadWrite

        Platform notes:
            - epoll: adds EPOLLET flag
            - kqueue: edge-triggered by default (EV_CLEAR); this is a no-op upgrade
            - IOCP: not applicable (completion-based); behaves like level-triggered
            - event_ports: one-shot semantics; caller must re-associate after each event

        Returns:
            true on success, false on error.
        """
        if self._backend != detect_backend(): return false
        if handle < 0 or fd < 0:
            return false
        val interest = _mode_to_i64(mode)
        unsafe(capabilities: [ffi, raw_ptr]):
            match self._backend:
                case EventBackend.Epoll: rt_event_loop_register(handle, fd, interest, fd, 1) == 1
                case EventBackend.Kqueue: rt_kqueue_register(handle, fd, interest, fd, 1) == 1
                case EventBackend.Iocp: rt_iocp_register(handle, fd, interest, fd, 1) == 1
                case EventBackend.EventPorts: rt_event_ports_register(handle, fd, interest, fd, 1) == 1
                case EventBackend.Poll: false

    fn register_with_token(handle: i64, fd: i64, mode: EventMode, token: i64, edge: bool) -> bool:
        """Register an fd with explicit token and edge-trigger control.

        The current native provider discards tokens; descriptor observations
        do not return them. Legacy EventLoop.poll fails explicitly.

        Args:
            handle: Event loop handle from create()
            fd: File descriptor to monitor
            mode: EventMode.Read, EventMode.Write, or EventMode.ReadWrite
            token: Reserved native argument; current provider discards it
            edge: true for edge-triggered, false for level-triggered

        Returns:
            true on success, false on error.
        """
        if self._backend != detect_backend(): return false
        if handle < 0 or fd < 0:
            return false
        val interest = _mode_to_i64(mode)
        val edge_code = if edge: 1 else: 0
        unsafe(capabilities: [ffi, raw_ptr]):
            match self._backend:
                case EventBackend.Epoll: rt_event_loop_register(handle, fd, interest, token, edge_code) == 1
                case EventBackend.Kqueue: rt_kqueue_register(handle, fd, interest, token, edge_code) == 1
                case EventBackend.Iocp: rt_iocp_register(handle, fd, interest, token, edge_code) == 1
                case EventBackend.EventPorts: rt_event_ports_register(handle, fd, interest, token, edge_code) == 1
                case EventBackend.Poll: false

    fn deregister(handle: i64, fd: i64) -> bool:
        """Remove an fd from event monitoring.

        Args:
            handle: Event loop handle from create()
            fd: File descriptor to remove

        Platform notes:
            - epoll: EPOLL_CTL_DEL
            - kqueue: EV_DELETE for both read/write filters
            - IOCP: CancelIoEx or disassociate (stub)
            - event_ports: port_dissociate (stub)

        Returns:
            true on success, false on error.
        """
        if self._backend != detect_backend(): return false
        if handle < 0 or fd < 0:
            return false
        unsafe(capabilities: [ffi, raw_ptr]):
            match self._backend:
                case EventBackend.Epoll: rt_event_loop_deregister(handle, fd) == 1
                case EventBackend.Kqueue: rt_kqueue_deregister(handle, fd) == 1
                case EventBackend.Iocp: rt_iocp_deregister(handle, fd) == 1
                case EventBackend.EventPorts: rt_event_ports_deregister(handle, fd) == 1
                case EventBackend.Poll: false

    fn poll(handle: i64, max: i64, timeout_ms: i64) -> Result<[i64], text>:
        # Historical triple contract cannot be implemented by the native
        # descriptor-only ABI. Never label registration interests as readiness.
        Err("E-EVENT-ABI: native readiness flags and tokens unavailable; use poll_descriptors")

    fn poll_descriptors(handle: i64, max: i64, timeout_ms: i64) -> Result<DescriptorObservationV1, text>:
        if handle < 0 or max <= 0 or max > 256 or timeout_ms < 0 or timeout_ms > 25:
            return Err("event_descriptor_observation_invalid_bounds")
        if self._backend != detect_backend(): return Err("event_backend_host_mismatch")
        if self._backend != EventBackend.Epoll and self._backend != EventBackend.Kqueue:
            return Err("event_descriptor_observation_unsupported")
        val held: i64? = mutex_try_lock_gate(_event_descriptor_gate_v1)
        if held == nil: return Err("event_descriptor_observation_busy")
        # Copy the entire process-global native scratch under one gate. No
        # handle/borrowed native storage escapes; direct foreign callers must
        # not call the legacy native poll ABI concurrently with this owner.
        val count = unsafe(capabilities: [ffi, raw_ptr]):
            rt_event_loop_poll(handle, max, timeout_ms)
        var descriptors: [i64] = []
        var invalid = count < 0 or count > max
        if not invalid:
            for index in 0..count:
                val fd = unsafe(capabilities: [ffi, raw_ptr]):
                    rt_event_loop_poll_get_fd(index)
                if fd < 0: invalid = true
                descriptors.push(fd)
        val released = mutex_unlock_gate(_event_descriptor_gate_v1, 0)
        if released != 1: return Err("event_descriptor_gate_release_failed")
        if invalid: return Err("event_descriptor_receipt_invalid")
        descriptor_observation_v1(descriptors)

    fn close(handle: i64) -> bool:
        """Close the event notification handle and release resources.

        Args:
            handle: Event loop handle from create()

        Returns:
            true on success, false on error.
        """
        if handle < 0:
            return false
        unsafe(capabilities: [ffi, raw_ptr]):
            match self._backend:
                case EventBackend.Epoll: rt_event_loop_close(handle) == 0
                case EventBackend.Kqueue: rt_kqueue_close(handle) == 0
                case EventBackend.Iocp: rt_iocp_close(handle) == 0
                case EventBackend.EventPorts: rt_event_ports_close(handle) == 0
                case EventBackend.Poll: false

# Runtime completion-driver owner.  The raw rt_driver_* declarations stay in
# this already-sanctioned platform ABI module; consumers use the typed aliases
# below and never bind runtime symbols in product leaves.
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_create(queue_depth: i64) -> i64
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_destroy(handle: i64)
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_submit_open(handle: i64, path: text, flags: i64, mode: i64) -> i64
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_submit_read(handle: i64, fd: i64, buf_size: i64, offset: i64) -> i64
# `data` is text-expanded to (ptr, len) by the native lane (text_extern_abi
# index 2), giving the C/Rust (handle, fd, data, len, offset) ABI. An explicit
# len parameter here became a sixth word and shifted it into `offset`.
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_submit_write(handle: i64, fd: i64, data: text, offset: i64) -> i64
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_submit_close(handle: i64, fd: i64) -> i64
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_submit_fsync(handle: i64, fd: i64) -> i64
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_flush(handle: i64) -> i64
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_poll(handle: i64, max: i64, timeout_ms: i64) -> i64
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_poll_id(handle: i64, index: i64) -> i64
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_poll_result(handle: i64, index: i64) -> i64
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_poll_data(handle: i64, index: i64) -> text
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_backend_name(handle: i64) -> text
@unsafe(reason: "runtime completion-driver ABI owner", capabilities: [ffi, raw_ptr])
extern fn rt_driver_cancel(handle: i64, operation: i64) -> bool

fn platform_driver_create(queue_depth: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_create(queue_depth)

fn platform_driver_destroy(handle: i64):
    if handle >= 0:
        unsafe(capabilities: [ffi, raw_ptr]): rt_driver_destroy(handle)

fn platform_driver_submit_open(handle: i64, path: text, flags: i64, mode: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_submit_open(handle, path, flags, mode)

fn platform_driver_submit_read(handle: i64, fd: i64, length: i64, offset: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_submit_read(handle, fd, length, offset)

fn platform_driver_submit_write(handle: i64, fd: i64, data: text, offset: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_submit_write(handle, fd, data, offset)

fn platform_driver_submit_close(handle: i64, fd: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_submit_close(handle, fd)

fn platform_driver_submit_fsync(handle: i64, fd: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_submit_fsync(handle, fd)

fn platform_driver_flush(handle: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_flush(handle)

fn platform_driver_poll(handle: i64, timeout_ms: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_poll(handle, 1, timeout_ms)

fn platform_driver_poll_id(handle: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_poll_id(handle, 0)

fn platform_driver_poll_result(handle: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_poll_result(handle, 0)

fn platform_driver_poll_data(handle: i64) -> text:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_poll_data(handle, 0)

fn platform_driver_backend_name(handle: i64) -> text:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_backend_name(handle)

fn platform_driver_cancel(handle: i64, operation: i64) -> bool:
    unsafe(capabilities: [ffi, raw_ptr]): rt_driver_cancel(handle, operation)
