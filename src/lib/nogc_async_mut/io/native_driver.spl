"""Typed alias for the sanctioned platform completion-driver owner."""

use std.nogc_async_mut.io.platform_event.{
    platform_driver_create, platform_driver_destroy,
    platform_driver_submit_open, platform_driver_submit_read, platform_driver_submit_write,
    platform_driver_submit_close, platform_driver_submit_fsync, platform_driver_flush,
    platform_driver_poll, platform_driver_poll_id, platform_driver_poll_result,
    platform_driver_poll_data, platform_driver_backend_name, platform_driver_cancel
}

fn native_driver_create(queue_depth: i64) -> i64:
    platform_driver_create(queue_depth)

fn native_driver_destroy(handle: i64):
    platform_driver_destroy(handle)

fn native_driver_submit_open(handle: i64, path: text, flags: i64, mode: i64) -> i64:
    platform_driver_submit_open(handle, path, flags, mode)

fn native_driver_submit_read(handle: i64, fd: i64, length: i64, offset: i64) -> i64:
    platform_driver_submit_read(handle, fd, length, offset)

fn native_driver_submit_write(handle: i64, fd: i64, data: text, offset: i64) -> i64:
    platform_driver_submit_write(handle, fd, data, offset)

fn native_driver_submit_close(handle: i64, fd: i64) -> i64:
    platform_driver_submit_close(handle, fd)

fn native_driver_submit_fsync(handle: i64, fd: i64) -> i64:
    platform_driver_submit_fsync(handle, fd)

fn native_driver_flush(handle: i64) -> i64:
    platform_driver_flush(handle)

fn native_driver_poll(handle: i64, timeout_ms: i64) -> i64:
    platform_driver_poll(handle, timeout_ms)

fn native_driver_poll_id(handle: i64) -> i64:
    platform_driver_poll_id(handle)

fn native_driver_poll_result(handle: i64) -> i64:
    platform_driver_poll_result(handle)

fn native_driver_poll_data(handle: i64) -> text:
    platform_driver_poll_data(handle)

fn native_driver_backend_name(handle: i64) -> text:
    platform_driver_backend_name(handle)

fn native_driver_cancel(handle: i64, operation: i64) -> bool:
    platform_driver_cancel(handle, operation)

export native_driver_create, native_driver_destroy,
    native_driver_submit_open, native_driver_submit_read, native_driver_submit_write,
    native_driver_submit_close, native_driver_submit_fsync, native_driver_flush,
    native_driver_poll, native_driver_poll_id, native_driver_poll_result,
    native_driver_poll_data, native_driver_backend_name, native_driver_cancel
