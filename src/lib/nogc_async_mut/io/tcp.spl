        match TcpStream.connect(addr):
            case Ok(stream):
                Future(state: [], poll_result: Poll.Ready(Ok(AsyncTcpStream(stream: stream))))  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 MIR lowers the generic Future.from_value<T> callee body with T unsubstituted (E-MIR-TYPE-TypeParam, unaffected by explicit call-site type args); construct the Future record directly, identical to from_value's own body
