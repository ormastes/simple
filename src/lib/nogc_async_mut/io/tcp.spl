"""
# Async TCP I/O

No-GC async TCP is a ready-future facade over the no-GC synchronous TCP
backend. This keeps one runtime-facing TCP implementation while preserving the
async API shape used by higher-level async networking code.
"""

use std.async.future.{Future}
use std.async.poll.{Poll}
use std.io.async_traits.{AsyncRead, AsyncWrite, AsyncClose}
use std.io.types.{IoError, Shutdown}
use std.nogc_sync_mut.io.tcp.{TcpListener, TcpStream}

class AsyncTcpListener with AsyncClose:
    """Future-returning TCP listener backed by no-GC sync TCP."""
    listener: TcpListener

    static fn bind(addr: text) -> Future<Result<AsyncTcpListener, IoError>>:
        """Bind to address and start listening."""
        match TcpListener.bind(addr):
            case Ok(listener):
                Future(state: [], poll_result: Poll.Ready(Ok(AsyncTcpListener(listener: listener))))  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 MIR lowers the generic Future.from_value<T> callee body with T unsubstituted (E-MIR-TYPE-TypeParam, unaffected by explicit call-site type args); construct the Future record directly, identical to from_value's own body
            case Err(e):
                Future(state: [], poll_result: Poll.Ready(Err(e)))  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 MIR lowers the generic Future.from_value<T> callee body with T unsubstituted (E-MIR-TYPE-TypeParam, unaffected by explicit call-site type args); construct the Future record directly, identical to from_value's own body

    fn accept() -> Future<Result<AsyncTcpStream, IoError>>:
        """Accept incoming connection."""
        match self.listener.accept():
            case Ok(stream):
                Future(state: [], poll_result: Poll.Ready(Ok(AsyncTcpStream(stream: stream))))  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 MIR lowers the generic Future.from_value<T> callee body with T unsubstituted (E-MIR-TYPE-TypeParam, unaffected by explicit call-site type args); construct the Future record directly, identical to from_value's own body
            case Err(e):
                Future(state: [], poll_result: Poll.Ready(Err(e)))  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 MIR lowers the generic Future.from_value<T> callee body with T unsubstituted (E-MIR-TYPE-TypeParam, unaffected by explicit call-site type args); construct the Future record directly, identical to from_value's own body

    fn local_addr() -> Result<text, IoError>:
        """Get local bound address."""
        self.listener.local_addr()

    me close() -> Future<Result<(), IoError>>:
        """Close listener."""
        Future(state: [], poll_result: Poll.Ready(self.listener.close()))  # @workaround bug=mir-unresolved-method-20261031 reason=pinned stage2 MIR lowers the generic Future.from_value<T> callee body with T unsubstituted (E-MIR-TYPE-TypeParam, unaffected by explicit call-site type args); construct the Future record directly, identical to from_value's own body

    fn is_open() -> bool:
        """Check if listener is open."""
        self.listener.is_open()

