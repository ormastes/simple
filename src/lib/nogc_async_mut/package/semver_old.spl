@allow(unnamed_duplicate_typed_args) # reason: positional API -- arg order is conventional
# SemVer Parser and Constraint Matching
# Implements Semantic Versioning 2.0.0 specification

use std.nogc_async_mut.package.types.{Version, VersionConstraint}
use std.common.convert.{try_parse_int}

# ============================================================================
# Version Parsing
# ============================================================================

fn parse_version(s: text) -> Result<Version, text>:
    """Parse a semantic version string.

    Examples:
        1.2.3
        1.2.3-alpha.1
        1.2.3+build.123
        1.2.3-beta.2+exp.sha.5114f85
    """
    # Split by + to separate build metadata
    val parts = s.split("+")
    val version_part = parts[0]
    var build = nil
    if parts.len() > 1:
        build = Some(parts[1])

    # Split by - to separate prerelease
    val pre_parts = version_part.split("-")
    val core_version = pre_parts[0]
    var prerelease = nil
    if pre_parts.len() > 1:
        prerelease = Some(pre_parts[1])

    # Parse core version (MAJOR.MINOR.PATCH)
    val components = core_version.split(".")
    if components.len() != 3:
        return Err("Version must have exactly 3 components (MAJOR.MINOR.PATCH)")

    # Parse each component as integer
    val major = match parse_int_component(components[0]):
        case Ok(v): v
        case Err(e): return Err(e)
    val minor = match parse_int_component(components[1]):
        case Ok(v): v
        case Err(e): return Err(e)
    val patch = match parse_int_component(components[2]):
        case Ok(v): v
        case Err(e): return Err(e)

    Ok(Version(
        major: major,
        minor: minor,
        patch: patch,
        prerelease: prerelease,
        build: build
    ))

fn parse_int_component(s: text) -> Result<i64, text>:
    """Parse a version component as non-negative integer"""
    if s.is_empty():
        return Err("Version component cannot be empty")

    # Check for negative or non-numeric
    if s.starts_with("-"):
        return Err("Version component cannot be negative")

    val size = s.len()
    var i = 0
    while i < size:
        val ch = s.char_code_at(i)
        if ch < 48 or ch > 57:
            return Err("Version component must be numeric")
        i = i + 1

    # The legacy text.to_int intrinsic cannot represent parse failure reliably.
    # Digits were checked above; reject overflow through the fail-closed parser.
    val num = try_parse_int(s) ?? -1
    if num < 0:
        return Err("Version component must be non-negative")

    Ok(num)

# ============================================================================
# Version Comparison
# ============================================================================

fn version_equal(a: Version, b: Version) -> bool:
    """Check if two versions are equal (ignoring build metadata)"""
    a.major == b.major and
    a.minor == b.minor and
    a.patch == b.patch and
    a.prerelease == b.prerelease

fn version_greater(a: Version, b: Version) -> bool:
    """Check if version a > version b"""
    # Compare major version
    if a.major != b.major:
        return a.major > b.major

    # Compare minor version
    if a.minor != b.minor:
        return a.minor > b.minor

    # Compare patch version
    if a.patch != b.patch:
        return a.patch > b.patch

    # Compare prerelease (no prerelease > with prerelease)
    # Keep optional tests explicit: nested Some tuple patterns are not yet
    # reliable in the native bootstrap lowering (tracked 2026-09-23).
    match a.prerelease:
        Some(pre_a):
            match b.prerelease:
                Some(pre_b):
                    return pre_a > pre_b
                nil:
                    return false
        nil:
            match b.prerelease:
                Some(_):
                    return true
                nil:
                    return false

fn version_greater_or_equal(a: Version, b: Version) -> bool:
    """Check if version a >= version b"""
    version_equal(a, b) or version_greater(a, b)

fn version_less(a: Version, b: Version) -> bool:
    """Check if version a < version b"""
    not version_greater_or_equal(a, b)

# ============================================================================
# Constraint Parsing
# ============================================================================

fn parse_constraint(s: text) -> Result<VersionConstraint, text>:
    """Parse a version constraint string.

    Supported formats:
        ^1.2.3    - Caret (compatible with 1.2.3)
        ~1.2.3    - Tilde (patch-level changes)
        >=1.0.0, <2.0.0 - Range
        1.2.3     - Exact version
        *         - Any version
        >=1.2.3   - Greater or equal
        <2.0.0    - Less than
    """
    val trimmed = s.trim()

    # Wildcard
    if trimmed == "*":
        return Ok(VersionConstraint.Any)

    # Caret constraint (^1.2.3)
    if trimmed.starts_with("^"):
        val version_str = trimmed.substring(1)
        val version = match parse_version(version_str):
            case Ok(v): v
            case Err(e): return Err(e)
        return Ok(VersionConstraint.Caret(version: version))

    # Tilde constraint (~1.2.3)
    if trimmed.starts_with("~"):
        val version_str = trimmed.substring(1)
        val version = match parse_version(version_str):
            case Ok(v): v
            case Err(e): return Err(e)
        return Ok(VersionConstraint.Tilde(version: version))

    # Range constraint (>=1.0.0, <2.0.0)
    if trimmed.contains(","):
        return parse_range_constraint(trimmed)

    # Greater or equal (>=1.2.3)
    if trimmed.starts_with(">="):
        val version_str = trimmed.substring(2).trim()
        val version = match parse_version(version_str):
            case Ok(v): v
            case Err(e): return Err(e)
        return Ok(VersionConstraint.GreaterEqual(version: version))

    # Less than (<2.0.0)
    if trimmed.starts_with("<"):
        val version_str = trimmed.substring(1).trim()
        val version = match parse_version(version_str):
            case Ok(v): v
            case Err(e): return Err(e)
        return Ok(VersionConstraint.Less(version: version))

    # Exact version (1.2.3)
    val version = match parse_version(trimmed):
        case Ok(v): v
        case Err(e): return Err(e)
    Ok(VersionConstraint.Exact(version: version))

fn parse_range_constraint(s: text) -> Result<VersionConstraint, text>:
    """Parse a range constraint like '>=1.0.0, <2.0.0'"""
    val parts = s.split(",")
    if parts.len() != 2:
        return Err("Range must have exactly 2 parts")

    val left = parts[0].trim()
    val right = parts[1].trim()

    # Parse left bound (must be >=)
    if not left.starts_with(">="):
        return Err("Range left bound must be '>='")
    val min = match parse_version(left.substring(2).trim()):
        case Ok(v): v
        case Err(e): return Err(e)

    # Parse right bound (must be <)
    if not right.starts_with("<"):
        return Err("Range right bound must be '<'")
    val max = match parse_version(right.substring(1).trim()):
        case Ok(v): v
        case Err(e): return Err(e)

    # Validate range
    if not version_less(min, max):
        return Err("Invalid range: min must be less than max")

    Ok(VersionConstraint.Range(min: min, max: max))

# ============================================================================
# Constraint Satisfaction
# ============================================================================

fn satisfies(version: Version, constraint: VersionConstraint) -> bool:
    """Check if a version satisfies a constraint"""
    match constraint:
        case VersionConstraint.Any:
            true

        case VersionConstraint.Exact(exact_version):
            version_equal(version, exact_version)

        case VersionConstraint.Caret(base):
            satisfies_caret(version, base)

        case VersionConstraint.Tilde(base):
            satisfies_tilde(version, base)

        case VersionConstraint.Range(min, max):
            version_greater_or_equal(version, min) and version_less(version, max)

        case VersionConstraint.GreaterEqual(min_version):
            version_greater_or_equal(version, min_version)

        case VersionConstraint.Greater(min_version):
            version_greater(version, min_version)

        case VersionConstraint.LessEqual(max_version):
            version_less(version, max_version) or version_equal(version, max_version)

        case VersionConstraint.Less(v):
            "<" + v.to_string()

fn find_max_satisfying(versions: [Version], constraint: VersionConstraint) -> Version?:
    """Find the maximum version that satisfies the constraint"""
    var max_version = nil

    for version in versions:
        if satisfies(version, constraint):
            match max_version:
                case nil:
                    max_version = Some(version)
                case Some(current_max):
                    if version_greater(version, current_max):
                        max_version = Some(version)

    max_version
