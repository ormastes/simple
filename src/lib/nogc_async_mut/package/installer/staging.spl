# Installer Staging Directory
#
# Creates a common staging directory layout used by all backends.
# The staging dir mirrors the target filesystem structure.

use std.io_runtime (process_run, file_exists, file_copy, file_write, is_dir, dir_create)
use std.common.encoding.font_registry (selected_font_bundle_asset_pins, validate_selected_font_bundle_root)

use lib.nogc_async_mut.package.installer.types (InstallerConfig, InstallerPlatform)


fn staging_dir(config: InstallerConfig, platform: InstallerPlatform) -> text:
    """Get staging directory path for a platform."""
    "{config.output_dir}/staging-{platform.to_string()}"


fn create_staging_dir(config: InstallerConfig, platform: InstallerPlatform) -> Result<text, text>:
    """Create a staging directory with the standard file layout.
    Returns Ok(staging_path) or Err(message)."""

    if not prepare_staging_dir(config, platform):
        return Err("Failed to safely clean installer staging directory")
    val staging = staging_dir(config, platform)

    # Determine layout based on platform
    if platform == InstallerPlatform.WindowsExe:
        create_windows_layout(config, staging)
    else:
        create_unix_layout(config, staging)

fn prepare_staging_dir(config: InstallerConfig, platform: InstallerPlatform) -> bool:
    val output: text = config.output_dir.replace("\\", "/")
    if output == "" or output == "/": return false
    for part in output.split("/"):
        if part == "..": return false
    val staging = staging_dir(config, platform)
    remove_staging_entry(staging)

fn remove_staging_entry(staging: text) -> bool:
    val (_, _, exit_code) = process_run("rm", ["-rf", "--", staging])
    exit_code == 0 and not file_exists(staging) and not is_dir(staging)

fn create_unix_layout(config: InstallerConfig, staging: text) -> Result<text, text>:
    """Create FHS-compliant directory layout for Linux/macOS/FreeBSD.
    Layout:
      usr/local/bin/simple              (symlink)
      usr/local/lib/simple/simple       (binary)
      usr/local/lib/simple/lib/         (stdlib)
      usr/local/share/doc/simple-lang/  (docs)
    """
    for path in [
        "{staging}/usr/local/bin",
        "{staging}/usr/local/lib/simple/lib",
        "{staging}/usr/local/share/doc/simple-lang",
        "{staging}/usr/local/share/simple/assets/fonts",
    ]:
        if not dir_create(path, recursive: true):
            return Err("Failed to create installer directory {path}")

    # Copy binary
    val binary_src = "{config.source_dir}/simple"
    if not file_exists(binary_src):
        return Err("Release binary not found at {binary_src}")

    if not file_copy(binary_src, "{staging}/usr/local/lib/simple/simple"):
        return Err("Failed to stage release binary")
    val (_, _, chmod_code) = process_run("chmod", ["755", "{staging}/usr/local/lib/simple/simple"])
    if chmod_code != 0:
        return Err("Failed to set binary permissions")

    # Keep the installed asset root stable regardless of the caller's cwd.
    val wrapper = "#!/bin/sh\nexport SIMPLE_ASSET_ROOT=/usr/local/share/simple\nexec /usr/local/lib/simple/simple \"$@\"\n"
    if not file_write("{staging}/usr/local/bin/simple", wrapper):
        return Err("Failed to create launcher")
    val (_, _, wrapper_chmod_code) = process_run("chmod", ["755", "{staging}/usr/local/bin/simple"])
    if wrapper_chmod_code != 0:
        return Err("Failed to set launcher permissions")

    # Copy stdlib
    if is_dir("src/lib"):
        val (_, _, lib_copy_code) = process_run(
            "cp", ["-r", "src/lib/.", "{staging}/usr/local/lib/simple/lib/"])
        if lib_copy_code != 0:
            return Err("Failed to stage standard library")

    # Copy docs
    if file_exists("README.md"):
        if not file_copy("README.md", "{staging}/usr/local/share/doc/simple-lang/README.md"):
            return Err("Failed to stage README")

    if (not file_copy("LICENSE", "{staging}/usr/local/share/doc/simple-lang/LICENSE") or
            not file_copy("THIRD_PARTY_NOTICES.md", "{staging}/usr/local/share/doc/simple-lang/THIRD_PARTY_NOTICES.md")):
        return Err("Failed to stage license or third-party notices")

    if not is_dir("assets/fonts"):
        return Err("Bundled font assets not found at assets/fonts")
    if not copy_selected_font_bundle_assets("{staging}/usr/local/share/simple"):
        return Err("Failed to stage bundled font assets")
    if (not file_copy("LICENSE", "{staging}/usr/local/share/simple/LICENSE") or
            not file_copy("THIRD_PARTY_NOTICES.md", "{staging}/usr/local/share/simple/THIRD_PARTY_NOTICES.md")):
        return Err("Failed to stage license or third-party notices")
    if not validate_selected_font_bundle_root("{staging}/usr/local/share/simple"):
        return Err("Staged font assets or notices failed immutable validation")

    Ok(staging)


fn create_windows_layout(config: InstallerConfig, staging: text) -> Result<text, text>:
    """Create Windows installer layout.
    Layout:
      bin/simple.exe      (binary)
      lib/                (stdlib)
      doc/                (docs)
    """
    for path in [
        "{staging}/bin",
        "{staging}/lib",
        "{staging}/doc",
        "{staging}/assets/fonts",
    ]:
        if not dir_create(path, recursive: true):
            return Err("Failed to create installer directory {path}")

    # Copy binary (look for Windows binary)
    val binary_src = "{config.source_dir}/windows-x86_64/simple.exe"
    val binary_fallback = "{config.source_dir}/simple.exe"

    if file_exists(binary_src):
        if not file_copy(binary_src, "{staging}/bin/simple.exe"):
            return Err("Failed to stage Windows release binary")
    else if file_exists(binary_fallback):
        if not file_copy(binary_fallback, "{staging}/bin/simple.exe"):
            return Err("Failed to stage Windows release binary")
    else:
        return Err("Windows binary not found at {binary_src} or {binary_fallback}")

    # Copy stdlib
    if is_dir("src/lib"):
        val (_, _, lib_copy_code) = process_run(
            "cp", ["-r", "src/lib/.", "{staging}/lib/"])
        if lib_copy_code != 0:
            return Err("Failed to stage standard library")

    # Copy docs
    if file_exists("README.md"):
        if not file_copy("README.md", "{staging}/doc/README.md"):
            return Err("Failed to stage README")

    if (not file_copy("LICENSE", "{staging}/doc/LICENSE") or
            not file_copy("THIRD_PARTY_NOTICES.md", "{staging}/doc/THIRD_PARTY_NOTICES.md")):
        return Err("Failed to stage license or third-party notices")

    if not is_dir("assets/fonts"):
        return Err("Bundled font assets not found at assets/fonts")
    if not copy_selected_font_bundle_assets(staging):
        return Err("Failed to stage bundled font assets")
    if (not file_copy("LICENSE", "{staging}/LICENSE") or
            not file_copy("THIRD_PARTY_NOTICES.md", "{staging}/THIRD_PARTY_NOTICES.md")):
        return Err("Failed to stage license or third-party notices")
    if not validate_selected_font_bundle_root(staging):
        return Err("Staged font assets or notices failed immutable validation")

    Ok(staging)

fn copy_selected_font_bundle_assets(root: text) -> bool:
    for pin in selected_font_bundle_asset_pins():
        val destination = "{root}/{pin.path}"
        if not dir_create(staging_parent_dir(destination), recursive: true):
            return false
        if not file_copy(pin.path, destination):
            return false
    true

fn staging_parent_dir(path: text) -> text:
    var index = path.len() - 1
    while index > 0:
        if path.slice(index, index + 1) == "/":
            return path.slice(0, index)
        index = index - 1
    "."


fn clean_staging_dir(config: InstallerConfig, platform: InstallerPlatform):
    """Remove staging directory after package build."""
    prepare_staging_dir(config, platform)
