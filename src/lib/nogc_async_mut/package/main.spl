# Package Management System
# Commands: build, install, uninstall, list, verify

use std.io_runtime.{get_args}

# `fn main(args)` / `fn main(args: [text])` are not honoured by the current
# toolchain.  The typed form reads a non-array heap value as the array header:
# `args.len()` returned 8246223157400007265 (== ASCII "armsExpr") stably across
# runs with no argv, and SEGVs (rc=139) when argv is present.  The untyped form
# binds `args` to nil, so `args.len()` is -1 and every dispatch below silently
# fell through to `show_help()`.  Read the argv vector explicitly instead.
# See doc/08_tracking/bug/main_args_parameter_unsupported_breaks_mkfs_tools_2026-08-24.md
fn _user_args() -> [text]:
    val raw = get_args()
    var out: [text] = []
    var i = 1
    while i < raw.len():
        if raw[i] != "--":
            out.push(raw[i])
        i = i + 1
    return out

fn main():
    val args = _user_args()
    val cmd = if args.len() > 0: args[0] else: "help"

    match cmd:
        "build": PackageBuild.run(args[1:])
        "install": PackageInstall.run(args[1:])
        "uninstall": PackageUninstall.run(args[1:])
        "list": PackageList.run(args[1:])
        "verify": PackageVerify.run(args[1:])
        "upgrade": PackageUpgrade.run(args[1:])
        _: show_help()

fn show_help():
    print """
Simple Package Manager

Usage:
  simple package <command> [options]

Commands:
  build       Build a package (bootstrap or full)
  install     Install a package
  uninstall   Uninstall a package
  list        List installed packages
  verify      Verify package integrity
  upgrade     Upgrade an installed package

Build Options:
  --type=TYPE         Package type: bootstrap or full (default: bootstrap)
  --output=FILE       Output file path (default: auto-generated)
  --platform=PLATFORM Target platform (default: auto-detect)

Install Options:
  --prefix=DIR        Install prefix (default: ~/.local)
  --system            Install system-wide (/usr/local, requires root)
  --dry-run           Preview installation without making changes

Examples:
  simple package build --type=bootstrap --output=simple-bootstrap.spk
  simple package install simple-bootstrap.spk
  simple package install simple-bootstrap.spk --prefix=~/.local
  sudo simple package install simple-bootstrap.spk --system
  simple package uninstall
  simple package list
  simple package verify simple-bootstrap.spk
"""
