@no_gc

# backend_dispatch — real GPU SFFI / CPU dispatch for compute ops.
#
# Routes compute ops to a real device backend via SFFI (CUDA, HIP/ROCm, Metal,
# Vulkan) when that backend's driver/device is genuinely available and the
# reduction op lowers to a real GPU kernel. Fails closed whenever a requested
# device backend is unavailable or kernel launch/readback fails instead of
# silently computing on the CPU.

use std.nogc_async_mut.compute.exec_target.{ExecTarget, ComputeBackend}
use std.nogc_async_mut.compute.compute_ops.{ComputeStats, compute_reduce}
use std.nogc_async_mut.io.cuda_sffi.{
    cuda_available, cuda_driver_init, cuda_device_count,
    cuda_alloc, cuda_copy_to_device, cuda_free, cuda_copy_from_device,
    cuda_compile, cuda_unload, cuda_get_kernel,
    cuda_launch_config_1d, cuda_launch, cuda_sync
}
use std.nogc_async_mut.io.metal_sffi.{
    metal_available, metal_init, metal_device_count,
    metal_create_device, metal_destroy_device,
    metal_alloc_buffer, metal_free_buffer,
    metal_compile_shader, metal_destroy_shader,
    metal_create_compute_pipeline, metal_destroy_pipeline,
    metal_create_command_queue, metal_destroy_command_queue,
    metal_sffi_run_compute_frame
}
use std.gc_async_mut.gpu.rocm.hip_reduce.{HipReduceOp, HipReduceRequest, hip_reduce_device, hip_reduce_i64}
use std.nogc_async_mut.gpu.engine2d.sffi_vulkan.{
    vulkan_sffi_is_available, vulkan_sffi_init, vulkan_sffi_device_count,
    vulkan_sffi_alloc_buffer, vulkan_sffi_free_buffer,
    vulkan_sffi_compile_spirv, vulkan_sffi_destroy_shader,
    vulkan_sffi_create_compute_pipeline, vulkan_sffi_destroy_pipeline,
    vulkan_sffi_create_descriptor_set, vulkan_sffi_bind_buffer,
    vulkan_sffi_destroy_descriptor_set,
    vulkan_sffi_begin_compute, vulkan_sffi_bind_pipeline,
    vulkan_sffi_bind_descriptors, vulkan_sffi_dispatch,
    vulkan_sffi_end_compute, vulkan_sffi_submit_and_wait,
    vulkan_sffi_copy_to_buffer, vulkan_sffi_copy_to_buffer_u32,
    vulkan_sffi_read_buffer_bytes
}

@unsafe(reason: "raw OpenCL/WebGPU SFFI availability probe", capabilities: [ffi])
extern fn rt_opencl_is_available() -> i64
@unsafe(reason: "raw OpenCL context creation probe", capabilities: [ffi])
extern fn rt_opencl_create_context(platform: i64) -> i64
@unsafe(reason: "raw OpenCL context release cleanup", capabilities: [ffi])
extern fn rt_opencl_release_context(context: i64) -> bool
@unsafe(reason: "raw WebGPU availability probe", capabilities: [ffi])
extern fn rt_webgpu_is_available() -> i64
@unsafe(reason: "raw host staging allocation for Metal compute dispatch", capabilities: [ffi, raw_ptr])
extern fn rt_alloc(size: i64) -> i64
@unsafe(reason: "raw host staging release for Metal compute dispatch", capabilities: [ffi, raw_ptr])
extern fn rt_free(ptr: i64)
@unsafe(reason: "raw host i64 store for Metal compute staging", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)
@unsafe(reason: "raw host i64 read for Metal compute readback", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64
@unsafe(reason: "raw Metal buffer upload via host staging pointer", capabilities: [ffi, raw_ptr])
extern fn rt_metal_buffer_upload_raw(buffer: i64, data_ptr: i64, size: i64) -> i64
@unsafe(reason: "raw Metal buffer download via host staging pointer", capabilities: [ffi, raw_ptr])
extern fn rt_metal_buffer_download_raw(data_ptr: i64, buffer: i64, size: i64) -> i64

fn dispatch_backend_name(b: ComputeBackend) -> text:
    if b == ComputeBackend.Cuda:
        return "cuda"
    if b == ComputeBackend.Hip:
        return "hip"
    if b == ComputeBackend.OpenCl:
        return "opencl"
    if b == ComputeBackend.Vulkan:
        return "vulkan"
    if b == ComputeBackend.Metal:
        return "metal"
    if b == ComputeBackend.WebGpu:
        return "webgpu"
    if b == ComputeBackend.Scalar:
        return "scalar"
    if b == ComputeBackend.PureSimple:
        return "pure_simple"
    return "none"

# True iff real SFFI device execution is available for `backend_name`.
fn gpu_payload_present(backend_name: text) -> bool:
    if backend_name == "cuda":
        return cuda_available() and cuda_device_count() > 0
    if backend_name == "vulkan":
        return vulkan_sffi_is_available() and vulkan_sffi_init() and vulkan_sffi_device_count() > 0
    if backend_name == "metal":
        return metal_available() and metal_device_count() > 0
    if backend_name == "hip":
        return hip_reduce_device().is_ok()
    if backend_name == "opencl":
        unsafe(capabilities: [ffi]):
            if rt_opencl_is_available() <= 0:
                return false
            val ctx = rt_opencl_create_context(0)
            if ctx > 0:
                rt_opencl_release_context(ctx)
                return true
            return false
    if backend_name == "webgpu":
        unsafe(capabilities: [ffi]):
            return rt_webgpu_is_available() > 0
    false

# True when the target names a real device backend (not the CPU reference).
fn dispatch_is_device(target: ExecTarget) -> bool:
    val b = target.backend
    b == ComputeBackend.Cuda or b == ComputeBackend.Hip or b == ComputeBackend.OpenCl or b == ComputeBackend.Vulkan or b == ComputeBackend.Metal or b == ComputeBackend.WebGpu

# Outcome of a dispatched op: value, honest provenance stats, and fail-closed status.
class DispatchOutcome:
    value: i64
    stats: ComputeStats
    ok: bool
    error: text

    static fn create(value: i64, stats: ComputeStats) -> DispatchOutcome:
        DispatchOutcome(value: value, stats: stats, ok: true, error: "")

    static fn failed(backend: text, reason: text) -> DispatchOutcome:
        DispatchOutcome(
            value: 0,
            stats: ComputeStats(backend: backend, ran_on_cpu: false),
            ok: false,
            error: reason
        )

fn _probe_reduce_op_kind(op: fn(i64, i64) -> i64) -> i64:
    if op(0, 5) == 5 and op(10, 3) == 13 and op(-4, 9) == 5 and op(7, -2) == 5:
        return 0
    if op(1, 5) == 5 and op(10, 3) == 30 and op(-4, 9) == -36 and op(0, 7) == 0:
        return 1
    if op(10, 3) == 3 and op(3, 10) == 3 and op(-4, 9) == -4 and op(5, 5) == 5:
        return 2
    if op(10, 3) == 10 and op(3, 10) == 10 and op(-4, 9) == 9 and op(5, 5) == 5:
        return 3
    if op(5, 3) == 6 and op(10, 10) == 0 and op(12, 5) == 9:
        return 4
    if op(7, 3) == 3 and op(12, 10) == 8 and op(5, 2) == 0:
        return 5
    if op(4, 3) == 7 and op(12, 10) == 14 and op(5, 0) == 5:
        return 6
    -1

fn _i64_lo_u32(v: i64) -> u32:
    (v & 0xFFFFFFFF) as u32

fn _i64_hi_u32(v: i64) -> u32:
    ((v >> 32) & 0xFFFFFFFF) as u32

fn _push_i64_le(mut out: [u8], v: i64) -> [u8]:
    var k: i64 = 0
    var cur: i64 = v
    while k < 8:
        out.push((cur & 0xFF) as u8)
        cur = cur >> 8
        k = k + 1
    out

fn _decode_i64_le(bytes: [u8], offset: i64) -> i64:
    var lo: i64 = 0
    var shift: i64 = 0
    var i: i64 = 0
    while i < 4:
        lo = lo | ((bytes[offset + i].to_i64() & 0xFF) << shift)
        shift = shift + 8
        i = i + 1
    var hi: i64 = 0
    shift = 0
    while i < 8:
        hi = hi | ((bytes[offset + i].to_i64() & 0xFF) << shift)
        shift = shift + 8
        i = i + 1
    (hi << 32) | lo

