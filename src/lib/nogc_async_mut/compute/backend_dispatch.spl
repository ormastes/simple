    0xCAu8, 0x00u8, 0x00u8, 0x00u8, 0xE6u8, 0x01u8, 0x00u8, 0x00u8, 0xD5u8, 0x00u8, 0x00u8, 0x00u8, 0xF9u8, 0x00u8, 0x02u8, 0x00u8,
    0xB4u8, 0x00u8, 0x00u8, 0x00u8, 0xF8u8, 0x00u8, 0x02u8, 0x00u8, 0xB4u8, 0x00u8, 0x00u8, 0x00u8, 0x80u8, 0x00u8, 0x05u8, 0x00u8,
    0x06u8, 0x00u8, 0x00u8, 0x00u8, 0x12u8, 0x01u8, 0x00u8, 0x00u8, 0xD6u8, 0x01u8, 0x00u8, 0x00u8, 0x11u8, 0x01u8, 0x00u8, 0x00u8,
    0xF9u8, 0x00u8, 0x02u8, 0x00u8, 0xB1u8, 0x00u8, 0x00u8, 0x00u8, 0xF8u8, 0x00u8, 0x02u8, 0x00u8, 0xB3u8, 0x00u8, 0x00u8, 0x00u8,
    0x51u8, 0x00u8, 0x05u8, 0x00u8, 0x06u8, 0x00u8, 0x00u8, 0x00u8, 0x14u8, 0x01u8, 0x00u8, 0x00u8, 0xD7u8, 0x01u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x3Eu8, 0x00u8, 0x03u8, 0x00u8, 0xAAu8, 0x00u8, 0x00u8, 0x00u8, 0x14u8, 0x01u8, 0x00u8, 0x00u8,
    0x51u8, 0x00u8, 0x05u8, 0x00u8, 0x06u8, 0x00u8, 0x00u8, 0x00u8, 0x17u8, 0x01u8, 0x00u8, 0x00u8, 0xD7u8, 0x01u8, 0x00u8, 0x00u8,
    0x01u8, 0x00u8, 0x00u8, 0x00u8, 0x3Eu8, 0x00u8, 0x03u8, 0x00u8, 0xADu8, 0x00u8, 0x00u8, 0x00u8, 0x17u8, 0x01u8, 0x00u8, 0x00u8,
    0xFDu8, 0x00u8, 0x01u8, 0x00u8, 0x38u8, 0x00u8, 0x01u8, 0x00u8
    ]

fn _ptx_reduce_i64_kernel() -> text:
    ".version 7.0\n.target sm_52\n.address_size 64\n\n.visible .entry simple_reduce_i64(\n    .param .u64 param_buf,\n    .param .s64 param_count,\n    .param .s64 param_op,\n    .param .s64 param_init\n) {{\n    .reg .u64 %rd<4>;\n    .reg .s64 %r<8>;\n    .reg .pred %p<4>;\n    ld.param.u64 %rd0, [param_buf];\n    ld.param.s64 %r0, [param_count];\n    ld.param.s64 %r1, [param_op];\n    ld.param.s64 %r2, [param_init];\n    mov.s64 %r3, 0;\nloop_top:\n    setp.ge.s64 %p0, %r3, %r0;\n    @%p0 bra loop_done;\n    shl.b64 %rd2, %r3, 3;\n    add.u64 %rd3, %rd0, %rd2;\n    ld.global.s64 %r4, [%rd3];\n    setp.eq.s64 %p1, %r1, 0;\n    @%p1 add.s64 %r2, %r2, %r4;\n    setp.eq.s64 %p1, %r1, 1;\n    @%p1 mul.lo.s64 %r2, %r2, %r4;\n    setp.eq.s64 %p1, %r1, 2;\n    @%p1 min.s64 %r2, %r2, %r4;\n    setp.eq.s64 %p1, %r1, 3;\n    @%p1 max.s64 %r2, %r2, %r4;\n    setp.eq.s64 %p1, %r1, 4;\n    @%p1 xor.b64 %r2, %r2, %r4;\n    setp.eq.s64 %p1, %r1, 5;\n    @%p1 and.b64 %r2, %r2, %r4;\n    setp.eq.s64 %p1, %r1, 6;\n    @%p1 or.b64 %r2, %r2, %r4;\n    add.s64 %r3, %r3, 1;\n    bra loop_top;\nloop_done:\n    st.global.s64 [%rd0], %r2;\n    ret;\n}}\n"

fn _msl_reduce_i64_kernel() -> text:
    "#include <metal_stdlib>\nusing namespace metal;\nkernel void simple_reduce_i64(device long* buf [[buffer(0)]], uint gid [[thread_position_in_grid]]) {{\n    if (gid != 0) return;\n    long count = buf[0];\n    long op_kind = buf[1];\n    long acc = buf[2];\n    for (long i = 0; i < count; i++) {{\n        long v = buf[3 + i];\n        if (op_kind == 0) acc += v;\n        else if (op_kind == 1) acc *= v;\n        else if (op_kind == 2) {{ if (v < acc) acc = v; }}\n        else if (op_kind == 3) {{ if (v > acc) acc = v; }}\n        else if (op_kind == 4) acc ^= v;\n        else if (op_kind == 5) acc &= v;\n        else if (op_kind == 6) acc |= v;\n    }}\n    buf[2] = acc;\n}}\n"

fn _dispatch_reduce_vulkan_sffi(data: [i64], init: i64, op_kind: i64) -> DispatchOutcome:
    if not vulkan_sffi_is_available() or not vulkan_sffi_init() or vulkan_sffi_device_count() <= 0:
        return DispatchOutcome.failed("vulkan", "gpu-backend-unavailable:vulkan")
    val n = data.len().to_i64()
    val word_count = 6 + n * 2
    var words: [u32] = [0u32; word_count]
    words[0] = _i64_lo_u32(n)
    words[1] = _i64_hi_u32(n)
    words[2] = _i64_lo_u32(op_kind)
    words[3] = _i64_hi_u32(op_kind)
    words[4] = _i64_lo_u32(init)
    words[5] = _i64_hi_u32(init)
    var i: i64 = 0
    while i < n:
        words[6 + i * 2] = _i64_lo_u32(data[i])
        words[6 + i * 2 + 1] = _i64_hi_u32(data[i])
        i = i + 1
    val d_buf = vulkan_sffi_alloc_buffer(word_count * 4, 0x80)
    if d_buf <= 0:
        return DispatchOutcome.failed("vulkan", "vulkan-alloc-failed")
    var uploaded = vulkan_sffi_copy_to_buffer_u32(d_buf, words, 0)
    if not uploaded:
        # Native/AOT builds decline typed u32 upload; keep byte-payload fallback.
        var host_bytes: [u8] = []
        host_bytes = _push_i64_le(host_bytes, n)
        host_bytes = _push_i64_le(host_bytes, op_kind)
        host_bytes = _push_i64_le(host_bytes, init)
        var j: i64 = 0
        while j < n:
            host_bytes = _push_i64_le(host_bytes, data[j])
            j = j + 1
        uploaded = vulkan_sffi_copy_to_buffer(d_buf, host_bytes, 0)
    if not uploaded:
        vulkan_sffi_free_buffer(d_buf)
        return DispatchOutcome.failed("vulkan", "vulkan-upload-failed")
    val shader = vulkan_sffi_compile_spirv(_spirv_reduce_i64_kernel())
    if shader <= 0:
        vulkan_sffi_free_buffer(d_buf)
        return DispatchOutcome.failed("vulkan", "vulkan-spirv-compile-failed")
    val pipe = vulkan_sffi_create_compute_pipeline(shader, "main", 0)
    if pipe <= 0:
        vulkan_sffi_destroy_shader(shader)
        vulkan_sffi_free_buffer(d_buf)
        return DispatchOutcome.failed("vulkan", "vulkan-pipeline-create-failed")
    val desc = vulkan_sffi_create_descriptor_set(pipe)
    if desc <= 0 or not vulkan_sffi_bind_buffer(desc, 0, d_buf):
        if desc > 0:
            vulkan_sffi_destroy_descriptor_set(desc)
        vulkan_sffi_destroy_pipeline(pipe)
        vulkan_sffi_destroy_shader(shader)
        vulkan_sffi_free_buffer(d_buf)
        return DispatchOutcome.failed("vulkan", "vulkan-descriptor-bind-failed")
    val cmd = vulkan_sffi_begin_compute()
    val launched = (cmd > 0 and
        vulkan_sffi_bind_pipeline(cmd, pipe) and
        vulkan_sffi_bind_descriptors(cmd, desc) and
        vulkan_sffi_dispatch(cmd, 1, 1, 1) and
        vulkan_sffi_end_compute(cmd) and
        vulkan_sffi_submit_and_wait(cmd))
    val read_bytes = if launched: vulkan_sffi_read_buffer_bytes(d_buf, 8, 16) else: []
    vulkan_sffi_destroy_descriptor_set(desc)
    vulkan_sffi_destroy_pipeline(pipe)
    vulkan_sffi_destroy_shader(shader)
    vulkan_sffi_free_buffer(d_buf)
    if not launched or read_bytes.len().to_i64() != 8:
        return DispatchOutcome.failed("vulkan", "vulkan-dispatch-or-readback-failed")
    val out_val = _decode_i64_le(read_bytes, 0)
    DispatchOutcome.create(out_val, ComputeStats(backend: "vulkan", ran_on_cpu: false))

fn _dispatch_reduce_cuda_sffi(data: [i64], init: i64, op_kind: i64) -> DispatchOutcome:
    if not cuda_available() or not cuda_driver_init() or cuda_device_count() <= 0:
        return DispatchOutcome.failed("cuda", "gpu-backend-unavailable:cuda")
    val n = data.len().to_i64()
    val byte_count = (if n > 0: n else: 1) * 8
    var host_bytes: [u8] = []
    if n == 0:
        host_bytes = _push_i64_le(host_bytes, init)
    else:
        var i: i64 = 0
        while i < n:
            host_bytes = _push_i64_le(host_bytes, data[i])
            i = i + 1
    val d_buf = cuda_alloc(byte_count)
    if not d_buf.is_valid:
        return DispatchOutcome.failed("cuda", "cuda-alloc-failed")
    if not cuda_copy_to_device(d_buf, host_bytes):
        cuda_free(d_buf)
        return DispatchOutcome.failed("cuda", "cuda-upload-failed")
    val module = cuda_compile(_ptx_reduce_i64_kernel())
    if not module.is_valid:
        cuda_free(d_buf)
        return DispatchOutcome.failed("cuda", "cuda-ptx-compile-failed")
    val kfn = cuda_get_kernel(module, "simple_reduce_i64")
    val cfg = cuda_launch_config_1d(1, 1)
    val launched = kfn.is_valid and cuda_launch(kfn, cfg, [d_buf.ptr, n, op_kind, init]) and cuda_sync()
    val out_bytes = if launched: cuda_copy_from_device(d_buf, byte_count) else: []
    cuda_unload(module)
    cuda_free(d_buf)
    if not launched or out_bytes.len().to_i64() < 8:
        return DispatchOutcome.failed("cuda", "cuda-launch-or-readback-failed")
    DispatchOutcome.create(_decode_i64_le(out_bytes, 0), ComputeStats(backend: "cuda", ran_on_cpu: false))

fn _dispatch_reduce_metal_sffi(data: [i64], init: i64, op_kind: i64) -> DispatchOutcome:
    if not metal_available() or not metal_init() or metal_device_count() <= 0:
        return DispatchOutcome.failed("metal", "gpu-backend-unavailable:metal")
    val dev = metal_create_device(0)
    if not dev.is_valid:
        return DispatchOutcome.failed("metal", "metal-device-create-failed")
    val queue = metal_create_command_queue(dev)
    val shader = metal_compile_shader(dev, _msl_reduce_i64_kernel())
    val pipe = metal_create_compute_pipeline(dev, shader, "simple_reduce_i64")
    val n = data.len().to_i64()
    val byte_count = (3 + n) * 8
    val buf = metal_alloc_buffer(dev, byte_count)
    var host_ptr: i64 = 0
    unsafe(capabilities: [ffi, raw_ptr]):
        host_ptr = rt_alloc(byte_count)
    var uploaded = false
    if host_ptr != 0 and dev.is_valid and queue.is_valid and pipe.is_valid and buf.is_valid:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_ptr_write_i64(host_ptr, 0, n)
            rt_ptr_write_i64(host_ptr, 8, op_kind)
            rt_ptr_write_i64(host_ptr, 16, init)
            var i: i64 = 0
            while i < n:
                rt_ptr_write_i64(host_ptr, (3 + i) * 8, data[i])
                i = i + 1
            uploaded = rt_metal_buffer_upload_raw(buf.handle, host_ptr, byte_count) != 0
    val ran = uploaded and metal_sffi_run_compute_frame(queue.handle, pipe.handle, buf.handle, buf.handle, [0u8; 4], 1, 1, 1, 1, 1, 1)
    var downloaded = false
    var out_val: i64 = 0
    if ran and host_ptr != 0:
        unsafe(capabilities: [ffi, raw_ptr]):
            downloaded = rt_metal_buffer_download_raw(host_ptr, buf.handle, byte_count) != 0
            if downloaded:
                out_val = rt_ptr_read_i64(host_ptr, 16)
    if host_ptr != 0:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_free(host_ptr)
    metal_free_buffer(buf)
    metal_destroy_pipeline(pipe)
    metal_destroy_shader(shader)
    metal_destroy_command_queue(queue)
    metal_destroy_device(dev)
    if not downloaded:
        return DispatchOutcome.failed("metal", "metal-dispatch-or-readback-failed")
    DispatchOutcome.create(out_val, ComputeStats(backend: "metal", ran_on_cpu: false))

# HIP/ROCm: the runtime is loaded on demand by the GPU API (hip_compute). An
# absent ROCm install is "unavailable" without any library load, and an
# install with no GPU is "unavailable" once hipInit fails.
fn _hip_reduce_op(op_kind: i64) -> Option<HipReduceOp>:
    if op_kind == 0:
        return Some(HipReduceOp.Add)
    if op_kind == 1:
        return Some(HipReduceOp.Mul)
    if op_kind == 2:
        return Some(HipReduceOp.Min)
    if op_kind == 3:
        return Some(HipReduceOp.Max)
    if op_kind == 4:
        return Some(HipReduceOp.Xor)
    if op_kind == 5:
        return Some(HipReduceOp.And)
    if op_kind == 6:
        return Some(HipReduceOp.Or)
    None

fn _dispatch_reduce_hip(data: [i64], init: i64, op_kind: i64) -> DispatchOutcome:
    if hip_reduce_device().is_err():
        return DispatchOutcome.failed("hip", "gpu-backend-unavailable:hip")
    match _hip_reduce_op(op_kind):
        case Some(op):
            match hip_reduce_i64(HipReduceRequest(data: data, init: init, op: op)):
                case Ok(run):
                    DispatchOutcome.create(run.value, ComputeStats(backend: "hip", ran_on_cpu: false))
                case Err(msg):
                    DispatchOutcome.failed("hip", "hip-launch-or-readback-failed: " + msg)
        case None:
            DispatchOutcome.failed("hip", "hip-reduce-op-unsupported")

fn _dispatch_reduce_gpu_sffi(data: [i64], init: i64, op: fn(i64, i64) -> i64, target: ExecTarget) -> DispatchOutcome:
    val name = dispatch_backend_name(target.backend)
    val op_kind = _probe_reduce_op_kind(op)
    if op_kind < 0:
        return DispatchOutcome.failed(name, "unsupported-gpu-reduce-op")
    if target.backend == ComputeBackend.Vulkan:
        return _dispatch_reduce_vulkan_sffi(data, init, op_kind)
    if target.backend == ComputeBackend.Cuda:
        return _dispatch_reduce_cuda_sffi(data, init, op_kind)
    if target.backend == ComputeBackend.Metal:
        return _dispatch_reduce_metal_sffi(data, init, op_kind)
    if target.backend == ComputeBackend.Hip:
        return _dispatch_reduce_hip(data, init, op_kind)
    DispatchOutcome.failed(name, "gpu-backend-unavailable:" + name)

# Dispatch a reduce.
# CPU targets (`Scalar` / `PureSimple`) execute on the pure-Simple CPU reference.
# GPU device targets execute real GPU SFFI kernels and fail closed when the
# backend or kernel is unavailable (never silently falling back to CPU).
fn dispatch_reduce_i64(data: [i64], init: i64, op: fn(i64, i64) -> i64, target: ExecTarget) -> DispatchOutcome:
    val name = dispatch_backend_name(target.backend)
    if target.backend == ComputeBackend.NoneBackend:
        return DispatchOutcome.failed("none", "no-backend-resolved")
    if dispatch_is_device(target):
        return _dispatch_reduce_gpu_sffi(data, init, op, target)
    val reference = compute_reduce(data, init, op, target)
    DispatchOutcome.create(reference, ComputeStats.cpu(name))

# Result-returning variant of `dispatch_reduce_i64` for explicit fail-closed callers.
fn dispatch_reduce_i64_checked(data: [i64], init: i64, op: fn(i64, i64) -> i64, target: ExecTarget) -> Result<DispatchOutcome, text>:
    val outcome = dispatch_reduce_i64(data, init, op, target)
    if not outcome.ok:
        return Err(outcome.error)
    Ok(outcome)

# Explicit gate test seam preserved for legacy payload-gating specs.
# Production callers must use `dispatch_reduce_i64` or `dispatch_reduce_i64_checked`.
fn dispatch_reduce_i64_forced(data: [i64], init: i64, op: fn(i64, i64) -> i64, target: ExecTarget, payload_present: bool) -> DispatchOutcome:
    val name = dispatch_backend_name(target.backend)
    if dispatch_is_device(target) and payload_present:
        val gpu_outcome = _dispatch_reduce_gpu_sffi(data, init, op, target)
        if gpu_outcome.ok:
            return gpu_outcome
        val reference = compute_reduce(data, init, op, target)
        return DispatchOutcome.create(reference, ComputeStats(backend: name, ran_on_cpu: false))
    val reference = compute_reduce(data, init, op, target)
    DispatchOutcome.create(reference, ComputeStats.cpu(name))

# Fail-closed requirement signal for `require` mode.
fn dispatch_requirement_met(target: ExecTarget) -> bool:
    if target.backend == ComputeBackend.NoneBackend:
        return false
    if dispatch_is_device(target):
        return gpu_payload_present(dispatch_backend_name(target.backend))
    true

export DispatchOutcome
export gpu_payload_present, dispatch_is_device, dispatch_backend_name
export dispatch_reduce_i64, dispatch_reduce_i64_checked, dispatch_reduce_i64_forced, dispatch_requirement_met
