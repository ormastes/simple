# Migration bridge for the existing DebugCoordinator and SessionManager.
#
# The legacy SessionManager IDs are private backend-resource handles.  Public
# callers receive only DebugSessionId from the centrally owned DebugServiceV1.
# Backend mechanisms and the DebugCoordinator API remain unchanged.

use std.common.debug.contracts_v1.{
    DebugSessionId, DebugPolicyV1, DebugRootOperationV1, DebugPerturbationV1,
}
use std.common.debug.service_v1.{
    central_debug_service_v1_open, central_debug_service_v1_authorize,
    central_debug_service_v1_record, central_debug_service_v1_close,
}
use std.nogc_async_mut.debug.coordinator.{DebugCoordinator, FrameInfo, VarInfo, LocationInfo}

struct CoordinatorSessionBindingV1:
    session_id: DebugSessionId
    local_session_id: text
    open: bool

pub class DebugCoordinatorServiceAdapterV1:
    coordinator: DebugCoordinator
    bindings: [CoordinatorSessionBindingV1]

    static fn create(coordinator: DebugCoordinator) -> DebugCoordinatorServiceAdapterV1:
        DebugCoordinatorServiceAdapterV1(coordinator: coordinator, bindings: [])

    me bind(local_session_id: text, build_id: text, policy: DebugPolicyV1) -> Result<DebugSessionId, text>:
        if self.coordinator.session_manager.get_session(local_session_id).is_none():
            return Err("legacy coordinator session not found: {local_session_id}")
        for binding in self.bindings:
            if binding.open and binding.local_session_id == local_session_id:
                return Err("legacy coordinator resource is already bound to DebugServiceV1")
        val session_id = central_debug_service_v1_open(build_id, policy)?
        self.bindings.push(CoordinatorSessionBindingV1(
            session_id: session_id,
            local_session_id: local_session_id,
            open: true,
        ))
        central_debug_service_v1_record(session_id, DebugRootOperationV1.Observe, DebugPerturbationV1.Passive, "legacy.coordinator.bind", true, false, "")
        Ok(session_id)

    me run_session(session_id: DebugSessionId) -> Result<Nil, text>:
        val local_id = self.require_binding(session_id)?
        val receipt = central_debug_service_v1_authorize(session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative, "legacy.coordinator.run")
        if not receipt.allowed:
            return Err(receipt.reason)
        val result = self.coordinator.run_session(local_id)
        match result:
            case Ok(_): self.record_result(session_id, "legacy.coordinator.run.outcome", DebugPerturbationV1.Cooperative, true, "", true)
            case Err(reason): self.record_result(session_id, "legacy.coordinator.run.outcome", DebugPerturbationV1.Cooperative, false, reason, false)
        result

    me pause_session(session_id: DebugSessionId) -> Result<Nil, text>:
        val local_id = self.require_binding(session_id)?
        val receipt = central_debug_service_v1_authorize(session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Stopping, "legacy.coordinator.pause")
        if not receipt.allowed:
            return Err(receipt.reason)
        val result = self.coordinator.pause_session(local_id)
        match result:
            case Ok(_): self.record_result(session_id, "legacy.coordinator.pause.outcome", DebugPerturbationV1.Stopping, true, "", true)
            case Err(reason): self.record_result(session_id, "legacy.coordinator.pause.outcome", DebugPerturbationV1.Stopping, false, reason, false)
        result

    me resume_session(session_id: DebugSessionId) -> Result<Nil, text>:
        val local_id = self.require_binding(session_id)?
        val receipt = central_debug_service_v1_authorize(session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative, "legacy.coordinator.resume")
        if not receipt.allowed:
            return Err(receipt.reason)
        val result = self.coordinator.resume_session(local_id)
        match result:
            case Ok(_): self.record_result(session_id, "legacy.coordinator.resume.outcome", DebugPerturbationV1.Cooperative, true, "", true)
            case Err(reason): self.record_result(session_id, "legacy.coordinator.resume.outcome", DebugPerturbationV1.Cooperative, false, reason, false)
        result

    fn stack_trace_session(session_id: DebugSessionId) -> Result<[FrameInfo], text>:
        val local_id = self.require_binding(session_id)?
        val receipt = central_debug_service_v1_authorize(session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "legacy.coordinator.stack_trace")
        if not receipt.allowed:
            return Err(receipt.reason)
        self.coordinator.stack_trace_session(local_id)

    fn locals_session(session_id: DebugSessionId) -> Result<[VarInfo], text>:
        val local_id = self.require_binding(session_id)?
        val receipt = central_debug_service_v1_authorize(session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "legacy.coordinator.locals")
        if not receipt.allowed:
            return Err(receipt.reason)
        self.coordinator.locals_session(local_id)

    fn location_session(session_id: DebugSessionId) -> Result<LocationInfo, text>:
        val local_id = self.require_binding(session_id)?
        val receipt = central_debug_service_v1_authorize(session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "legacy.coordinator.location")
        if not receipt.allowed:
            return Err(receipt.reason)
        self.coordinator.location_session(local_id)

    me close(session_id: DebugSessionId) -> Result<Nil, text>:
        val index = self.binding_index(session_id)
        if index < 0 or not self.bindings[index].open:
            return Err("legacy coordinator resource is not bound to DebugServiceV1")
        val receipt = central_debug_service_v1_authorize(session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative, "legacy.coordinator.detach")
        if not receipt.allowed:
            return Err(receipt.reason)
        val result = self.coordinator.terminate_session(self.bindings[index].local_session_id)
        match result:
            case Err(reason):
                central_debug_service_v1_record(session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative, "legacy.coordinator.detach.outcome", false, false, reason)
                return Err(reason)
            case Ok(_): pass_do_nothing("legacy coordinator backend detached")
        central_debug_service_v1_record(session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative, "legacy.coordinator.detach.outcome", true, true, "")
        central_debug_service_v1_close(session_id)?
        var binding = self.bindings[index]
        binding.open = false
        self.bindings[index] = binding
        Ok(nil)

    fn require_binding(session_id: DebugSessionId) -> Result<text, text>:
        val index = self.binding_index(session_id)
        if index < 0 or not self.bindings[index].open:
            return Err("legacy coordinator resource is not bound to DebugServiceV1")
        Ok(self.bindings[index].local_session_id)

    fn binding_index(session_id: DebugSessionId) -> i64:
        for (index, binding) in self.bindings.enumerate():
            if binding.session_id.value == session_id.value:
                return index
        -1

    me record_result(session_id: DebugSessionId, action: text, perturbation: DebugPerturbationV1, allowed: bool, reason: text, execution_changed: bool):
        central_debug_service_v1_record(session_id, DebugRootOperationV1.Control, perturbation, action, allowed, execution_changed, reason)
