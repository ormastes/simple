# Cooperative cancellation: bounded generation-bound registry.
# One carrier owns this registry. Explicit release revokes every alias; children
# of a released parent fail closed. There is no implicit destructor or refcount.
use nogc_async_mut.async.poll.{Poll}
use nogc_async_mut.async.future.{Future}
use std.thread_sffi.{thread_current_id}

val CANCELLATION_REGISTRY_CAPACITY: i64 = 4096
val CANCELLATION_ID_MAX: i64 = 9223372036854775807
var _registry_ids: [i64] = []
var _registry_active: [bool] = []
var _registry_cancelled: [bool] = []
var _registry_parent: [i64] = []
# Module initialization binds the carrier once; constructors never race to
# assign the registry owner. Cross-carrier access is refused before mutation.
val _registry_thread: i64 = thread_current_id()
var _registry_live: i64 = 0

fn cancellation_registry_capacity() -> i64: CANCELLATION_REGISTRY_CAPACITY

fn cancellation_registry_live_count() -> i64:
    if _registry_thread != thread_current_id():
        return 0
    _registry_live

class CancellationToken:
    """Copyable cooperative cancellation lease.

    token_new()/new() preserve parent-to-child cancellation. release() ends
    the lifetime for ALL copies. Copying does not retain a lifetime; callers
    release only after dependent work is joined. Exhaustion returns an invalid,
    cancelled token. Tokens are confined to their registry's carrier thread.
    """
    token_id: i64
    parent_id: i64

fn token_new() -> CancellationToken: CancellationToken.new()

impl CancellationToken:
    static fn new() -> CancellationToken:
        """Admit a root into finite storage, or return a cancelled invalid token."""
        val caller = thread_current_id()
        if caller <= 0:
            return CancellationToken(token_id: -1, parent_id: -1)
        if _registry_thread != caller:
            return CancellationToken(token_id: -1, parent_id: -1)
        var slot: i64 = 0
        while slot < _registry_ids.len():
            if not _registry_active[slot]:
                val previous = _registry_ids[slot]
                # Retire exhausted slots permanently; NEVER wrap a generation.
                if previous <= CANCELLATION_ID_MAX - CANCELLATION_REGISTRY_CAPACITY:
                    val id = previous + CANCELLATION_REGISTRY_CAPACITY
                    _registry_ids[slot] = id
                    _registry_cancelled[slot] = false
                    _registry_parent[slot] = -1
                    _registry_active[slot] = true
                    _registry_live = _registry_live + 1
                    return CancellationToken(token_id: id, parent_id: -1)
            slot = slot + 1
        if _registry_ids.len() >= CANCELLATION_REGISTRY_CAPACITY:
            return CancellationToken(token_id: -1, parent_id: -1)
        val id = _registry_ids.len()
        _registry_ids = _registry_ids.push(id)
        _registry_active = _registry_active.push(true)
        _registry_cancelled = _registry_cancelled.push(false)
        _registry_parent = _registry_parent.push(-1)
        _registry_live = _registry_live + 1
        CancellationToken(token_id: id, parent_id: -1)

    fn is_valid() -> bool:
        if _registry_thread != thread_current_id() or self.token_id < 0:
            return false
        val slot = self.token_id % CANCELLATION_REGISTRY_CAPACITY
        if slot >= _registry_ids.len():
            return false
        _registry_active[slot] and _registry_ids[slot] == self.token_id

    me cancel():
        """Cancel a live generation; a stale copy cannot cancel its replacement."""
        if self.is_valid():
            val slot = self.token_id % CANCELLATION_REGISTRY_CAPACITY
            _registry_cancelled[slot] = true

    me release() -> bool:
        """Revoke once and reclaim storage; retained aliases become cancelled."""
        if not self.is_valid():
            return false
        val slot = self.token_id % CANCELLATION_REGISTRY_CAPACITY
        _registry_cancelled[slot] = true
        _registry_parent[slot] = -1
        _registry_active[slot] = false
        _registry_live = _registry_live - 1
        true

    fn is_cancelled() -> bool:
        """Bounded ancestry walk; invalid/released/stale/cyclic chains stop work."""
        if _registry_thread != thread_current_id() or self.token_id < 0:
            return true
        var current = self.token_id
        var steps: i64 = 0
        while steps < CANCELLATION_REGISTRY_CAPACITY:
            if current < 0:
                return true
            val slot = current % CANCELLATION_REGISTRY_CAPACITY
            if slot >= _registry_ids.len():
                return true
            if not _registry_active[slot] or _registry_ids[slot] != current:
                return true
            if _registry_cancelled[slot]:
                return true
            val parent = _registry_parent[slot]
            if parent < 0:
                return false
            current = parent
            steps = steps + 1
        true

    fn child() -> CancellationToken:
        """Admit a child of this live, uncancelled generation only."""
        if self.is_cancelled():
            return CancellationToken(token_id: -1, parent_id: -1)
        val child = CancellationToken.new()
        if child.is_valid():
            val slot = child.token_id % CANCELLATION_REGISTRY_CAPACITY
            _registry_parent[slot] = self.token_id
            return CancellationToken(token_id: child.token_id, parent_id: self.token_id)
        child

    fn guard_future() -> Future<bool>:
        """Poll-once cancellation snapshot; callers repoll at suspension points."""
        if self.is_cancelled():
            val ready: Poll<bool> = Poll.Ready(true)
            val future: Future<bool> = Future<bool>(state: [], poll_result: ready)
            future
        else:
            val pending: Poll<bool> = Poll.Pending
            val future: Future<bool> = Future<bool>(state: [], poll_result: pending)
            future
