# Go-style sleep — suspends the current cooperative task, not the OS thread.
#
# Surface:
#   sleep(ms) -> SleepFuture         — timer handle; Ready once deadline passes
#   sleep_blocking(ms)               — fallback: blocks the OS thread (no scheduler)
#   run_sleepers([SleepFuture])      — cooperative mini-scheduler: drives many
#                                      sleepers CONCURRENTLY (total ~= max, not sum),
#                                      parking the OS thread only until the
#                                      NEAREST deadline when every task is waiting
#                                      (same shape as Go's timer parking).
#   await_sleep(SleepFuture)         — drive a single sleeper to completion
#
# Design notes:
#   - Pure Simple; uses only existing externs (rt_thread_sleep) and
#     std.nogc_sync_mut.io.time_ops.time_now_unix_micros.
#   - std.async.runtime.Runtime cannot yet re-poll clock-based futures on its
#     own (Future.pending stays pending; wakers must be signalled externally),
#     so timer wake-up lives here. Runtime timer integration is filed as a
#     tracked todo (doc/08_tracking/todo/).

use std.nogc_async_mut.async.poll.{Poll}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}

extern fn rt_thread_sleep(millis: i64)

class SleepFuture:
    """A timer future: Ready(()) once now >= deadline (microsecond clock)."""
    deadline_us: i64

pub fn sleep(millis: i64) -> SleepFuture:
    """Go-style sleep handle firing millis ms from now (0 => immediately ready)."""
    SleepFuture(deadline_us: time_now_unix_micros() + millis * 1000)

impl SleepFuture:
    fn poll() -> Poll<()>:
        """Ready(()) when the deadline has passed, Pending otherwise."""
        if time_now_unix_micros() >= self.deadline_us:
            Poll.Ready(())
        else:
            Poll.Pending

    fn is_elapsed() -> bool:
        time_now_unix_micros() >= self.deadline_us

pub fn sleep_blocking(millis: i64):
    """Blocking fallback: parks the OS thread. Use when no scheduler is running."""
    if millis > 0:
        rt_thread_sleep(millis)

pub fn run_sleepers(sleepers: [SleepFuture]):
    """Drive all sleepers to completion cooperatively.

    Polls every sleeper each round; when all remaining are Pending, parks the
    OS thread until the NEAREST deadline, so N overlapping sleeps of X ms
    complete in ~X ms total, not N*X.
    """
    var remaining = sleepers.len()
    while remaining > 0:
        remaining = 0
        var nearest_us: i64 = 0
        var have_nearest = false
        for s in sleepers:
            match s.poll():
                case Poll.Ready(_):
                    pass
                case Poll.Pending:
                    remaining = remaining + 1
                    if (not have_nearest) or s.deadline_us < nearest_us:
                        nearest_us = s.deadline_us
                        have_nearest = true
        if remaining > 0 and have_nearest:
            val wait_us = nearest_us - time_now_unix_micros()
            if wait_us > 1000:
                rt_thread_sleep(wait_us / 1000)

pub fn await_sleep(s: SleepFuture):
    """Drive a single sleep handle to completion (suspending cooperatively)."""
    run_sleepers([s])
