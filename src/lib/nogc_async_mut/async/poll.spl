# Poll - Future Poll Result
#
# Result type for polling futures.

enum Poll<T>:
    """Result of polling a future.

    - Ready(value): Future completed with value
    - Pending: Future not yet ready
    """
    Ready(T)
    Pending

# Bind self to a local before matching: the self-hosted HIR rejects generic
# enum patterns matched directly on `self`/fields (subject type arguments
# resolve non-concrete) while a parameter/local of the declared generic type
# lowers cleanly.
# @workaround bug=generic_enum_pattern_self_subject_hir_2026_10_22 reason=selfhosted_hir_rejects_generic_enum_patterns_on_self_field_subjects_but_accepts_parameter_subjects
fn poll_is_ready<T>(poll: Poll<T>) -> bool:
    match poll:
        case Poll.Ready(_): true
        case Poll.Pending: false

fn poll_unwrap<T>(poll: Poll<T>) -> T:
    match poll:
        case Poll.Ready(value): value
        case Poll.Pending: panic("Poll is pending")

impl Poll<T>:
    fn is_ready() -> bool:
        """Check if future is ready."""
        poll_is_ready(self)

    fn is_pending() -> bool:
        """Check if future is pending."""
        not poll_is_ready(self)

    fn unwrap() -> T:
        """Unwrap ready value (panics if pending)."""
        poll_unwrap(self)
