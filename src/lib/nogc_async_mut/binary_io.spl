@allow(star_import) # reason: compatibility facade, re-exports backing family symbols
# Compatibility facade: std.nogc_async_mut.binary_io -> std.common.binary_io
# Was a semantically identical duplicate implementation (17 duplicate-named
# public fns + ByteOrder/BinaryReader/BinaryWriter/BinaryBufferedReader/BinaryBufferedWriter);
# under co-compilation every duplicate-named public fn collides in the seed's
# bare-name symbol table (Class B silent-win misdispatch — see
# doc/08_tracking/bug/duplicate_public_symbols_differing_return_types_jit_misdispatch_2026-08-09.md).
# The type names stay re-exported: compiler shb/macho/pe/debug importers reach
# them through this facade as std.binary_io.{BinaryReader, ...}.
export use std.common.binary_io.{
    ByteOrder, BinaryReader, BinaryWriter, BinaryBufferedReader, BinaryBufferedWriter,
    allocate_buffer, bytes_push_le, bytes_read_le_at, bytes_to_string, bytes_to_u16_be,
    bytes_to_u16_le, bytes_to_u32_be, bytes_to_u32_le, bytes_to_u64_be, bytes_to_u64_le,
    f32_from_bits, f32_to_bits, f64_from_bits, f64_to_bits, is_little_endian, spl_f64_to_bits,
    string_to_bytes, u16_to_bytes_be, u16_to_bytes_le, u32_to_bytes_be, u32_to_bytes_le,
    u64_to_bytes_be, u64_to_bytes_le
}
