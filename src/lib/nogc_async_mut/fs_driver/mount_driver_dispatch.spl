fn _driver_mmap_shared_writable_handle(driver: DriverInstance, handle: FileHandle, offset: i64, length: i64) -> Result<(), FsError>:
    val _ = driver
    val _ = handle
    val _ = offset
    val _ = length
    Err(FsError.Unsupported)

fn _driver_link_path_text(driver: DriverInstance, target: text, link_path: text) -> (DriverInstance, Result<(), FsError>):
    # Drivers are value structs: mutate a local copy and hand it back so the
    # mount table stores it (scalar state such as fd counters is otherwise lost).
    match driver:
        case DriverInstance.RamFs(d):
            var m = d
            val r = m.link(Path(raw: target), Path(raw: link_path))
            (DriverInstance.RamFs(m), r)
        case _: (driver, Err(FsError.Unsupported))

