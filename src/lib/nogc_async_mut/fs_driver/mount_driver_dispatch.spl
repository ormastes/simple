# Backend-neutral dispatch for MountTable.
#
# Keeping the exhaustive DriverInstance match arms here makes mount_table.spl
# own namespace, binding, and policy state while this module owns backend
# operation selection. Every operation is routed to the recorded instance;
# unsupported operations fail closed.

use std.fs_driver.types.{Path, StatInfo, FileStat, FileHandle, DirHandle, DirEntry, OpenFlags, MountOptions, ExecuteFileObservationV1}
use std.fs_driver.instance.{DriverInstance}
use std.fs_driver.error.{FsError}
use std.fs_driver.capability.{FsCapabilitySet}
use std.fs_driver.bytes_util.{alloc_zeroed_bytes, text_to_bytes_pure}

fn _driver_mount(driver: DriverInstance, opts: MountOptions) -> Result<DriverInstance, FsError>:
    """Mount the backend before it is registered in the table.

    Only FAT32 and RamFS declare a real mount()/mounted gate (Nvfs, NvfsPosix,
    and DbFs are always-ready from construction and expose no mount() at all),
    so those two are the only cases dispatched to a real call; the rest are a
    deliberate no-op Ok(driver).

    Returns the (possibly mutated) DriverInstance rather than (): struct
    parameters are value types here, so a `me fn mount()` called on the `d`
    bound inside a match arm mutates only that local copy — the caller must
    rebuild the DriverInstance from the mutated copy and use THAT value, not
    the original `driver` argument, or the `mounted` flag never reaches the
    entry stored in MountTable.mounts.
    """
    match driver:
        case DriverInstance.Fat32(d):
            var mutable_d = d
            val rc = mutable_d.mount(opts)
            if rc.is_err(): return Err(rc.unwrap_err())
            Ok(DriverInstance.Fat32(mutable_d))
        case DriverInstance.Nvfs(d):      Ok(driver)
        case DriverInstance.NvfsPosix(d): Ok(driver)
        case DriverInstance.RamFs(d):
            var mutable_d = d
            val rc = mutable_d.mount(opts)
            if rc.is_err(): return Err(rc.unwrap_err())
            Ok(DriverInstance.RamFs(mutable_d))
        case DriverInstance.DbFs(d):      Ok(driver)

fn _drop_count(result: Result<i64, FsError>) -> Result<(), FsError>:
    match result:
        case Err(e): Err(e)
        case Ok(_): Ok(())

fn _bytes_to_text_prefix(buf: [u8], count: i64) -> text:
    var out = ""
    var i: i64 = 0
    while i < count and i < buf.len() as i64:
        out = out + buf[i as i32].chr()
        i = i + 1
    out

fn _driver_name(driver: DriverInstance) -> text:
    match driver:
        case DriverInstance.Fat32(d):     d.name
        case DriverInstance.Nvfs(d):      d.name
        case DriverInstance.NvfsPosix(d): d.name
        case DriverInstance.RamFs(d):     d.name
        case DriverInstance.DbFs(d):      d.name

fn _driver_kind_name(driver: DriverInstance) -> text:
    """Return the canonical backend identity, independent of instance labels."""
    match driver:
        case DriverInstance.Fat32(_):     "fat32"
        case DriverInstance.Nvfs(_):      "nvfs"
        case DriverInstance.NvfsPosix(_): "nvfs"
        case DriverInstance.RamFs(_):     "ramfs"
        case DriverInstance.DbFs(_):      "dbfs"

fn _driver_dbfs_server_data_identity(driver: DriverInstance) -> Result<(i64, u64, u64), FsError>:
    """Project owner-derived durable DBFS identity; reject every other backend."""
    match driver:
        case DriverInstance.DbFs(d): d.issue_server_data_root_mount_identity()
        case _:                      Err(FsError.Unsupported)

fn _driver_dbfs_current_server_data_identity(driver: DriverInstance) -> Result<(i64, u64), FsError>:
    """Revalidate the durable DBFS instance and mutation epoch of a live root."""
    match driver:
        case DriverInstance.DbFs(d): d.server_data_root_instance_identity()
        case _:                      Err(FsError.Unsupported)

fn _driver_nvfs_root_identity(driver: DriverInstance) -> Result<(i64, u64, u64), FsError>:
    """Project the exact DBFS-backing owner of an NVFS root."""
    match driver:
        case DriverInstance.Nvfs(d): d.issue_root_mount_identity()
        case _:                      Err(FsError.Unsupported)

fn _driver_nvfs_current_root_identity(driver: DriverInstance) -> Result<(i64, u64), FsError>:
    """Revalidate the backing instance and mutation epoch of a live NVFS root."""
    match driver:
        case DriverInstance.Nvfs(d): d.root_mount_identity_current()
        case _:                      Err(FsError.Unsupported)

fn _driver_nvfs_device_instance_id(driver: DriverInstance) -> Result<i64, FsError>:
    """Return cleanup identity without requiring an unchanged mutation epoch."""
    match driver:
        case DriverInstance.Nvfs(d):
            val instance_id = d.device_instance_id()
            if instance_id <= 0: Err(FsError.StaleHandle) else: Ok(instance_id)
        case _:
            Err(FsError.Unsupported)

fn _driver_capabilities(driver: DriverInstance) -> FsCapabilitySet:
    match driver:
        case DriverInstance.Fat32(d):     d.capabilities()
        case DriverInstance.Nvfs(d):      d.capabilities()
        case DriverInstance.NvfsPosix(d): d.capabilities()
        case DriverInstance.RamFs(d):     d.capabilities()
        case DriverInstance.DbFs(d):      d.capabilities()

fn _driver_stat_path(driver: DriverInstance, path: Path) -> Result<StatInfo, FsError>:
    match driver:
        case DriverInstance.Fat32(d):     d.stat_path(path)
        case DriverInstance.Nvfs(d):      d.stat_path(path)
        case DriverInstance.NvfsPosix(d): d.stat_path(path)
        case DriverInstance.RamFs(d):     d.stat_path(path)
        case DriverInstance.DbFs(d):      d.stat_path(path)

fn _driver_fstat(driver: DriverInstance, handle: FileHandle) -> Result<FileStat, FsError>:
    match driver:
        case DriverInstance.Fat32(d):     d.fstat(handle)
        case DriverInstance.Nvfs(d):      d.fstat(handle)
        case DriverInstance.NvfsPosix(d): d.fstat(handle)
        case DriverInstance.RamFs(d):     d.fstat(handle)
        case DriverInstance.DbFs(d):      d.fstat(handle)

fn _driver_file_generation_v1(driver: DriverInstance, handle: FileHandle) -> Result<u64, FsError>:
    """Return the backend-owned generation of the file version behind handle.

    Zero is never a valid generation. Backends advance this value for every
    content mutation and fail closed for stale or unknown handles, allowing a
    MountTable snapshot to reject replacement without reopening its path.
    """
    match driver:
        case DriverInstance.Fat32(d):     d.file_generation_v1(handle)
        case DriverInstance.Nvfs(d):      d.file_generation_v1(handle)
        case DriverInstance.NvfsPosix(d): d.file_generation_v1(handle)
        case DriverInstance.DbFs(d):      d.file_generation_v1(handle)
        case DriverInstance.RamFs(_):     Err(FsError.Unsupported)

fn _driver_execute_observation_v1(
    driver: DriverInstance, handle: FileHandle
) -> Result<ExecuteFileObservationV1, FsError>:
    """Capture backend-neutral executable identity behind one retained handle."""
    match driver:
        case DriverInstance.Fat32(d): d.execute_observation_v1(handle)
        case DriverInstance.Nvfs(d): d.execute_observation_v1(handle)
        case DriverInstance.NvfsPosix(d): d.execute_observation_v1(handle)
        case DriverInstance.DbFs(d):
            d.execute_observation_v1(handle)
        case DriverInstance.RamFs(d):
            # RamFS predates file epochs. Preserve its retained-handle metadata
            # contract; mutation-epoch enforcement remains unsupported there.
            val stat = d.fstat(handle)?
            if _file_stat_is_directory(stat): return Err(FsError.InvalidArg)
            Ok(ExecuteFileObservationV1(contract_version: 1u32,
                object_identity: stat.inode, content_generation: 0u64,
                size: stat.size))

fn _driver_execute_observation_current_v1(
    driver: DriverInstance, handle: FileHandle, observation: ExecuteFileObservationV1
) -> bool:
    if observation.contract_version != 1u32:
        return false
    match driver:
        case DriverInstance.Fat32(d): d.execute_observation_current_v1(handle, observation)
        case DriverInstance.Nvfs(d): d.execute_observation_current_v1(handle, observation)
        case DriverInstance.NvfsPosix(d): d.execute_observation_current_v1(handle, observation)
        case _:
            val current = match _driver_execute_observation_v1(driver, handle):
                case Err(_): return false
                case Ok(value): value
            current.object_identity == observation.object_identity and
                current.content_generation == observation.content_generation and
                current.size == observation.size

fn _driver_open_path(driver: DriverInstance, path: Path, flags: OpenFlags) -> (DriverInstance, Result<FileHandle, FsError>):
    # Drivers are value structs: mutate a local copy and hand it back so the
    # mount table stores it (scalar state such as fd counters is otherwise lost).
    match driver:
        case DriverInstance.Fat32(d):
            var m = d
            val r = m.open_path(path, flags)
            (DriverInstance.Fat32(m), r)
        case DriverInstance.Nvfs(d):
            var m = d
            val r = m.open_path(path, flags)
            (DriverInstance.Nvfs(m), r)
        case DriverInstance.NvfsPosix(d):
            var m = d
            val r = m.open_path(path, flags)
            (DriverInstance.NvfsPosix(m), r)
        case DriverInstance.RamFs(d):
            var m = d
            val r = m.open(path, flags)
            (DriverInstance.RamFs(m), r)
        case DriverInstance.DbFs(d):
            var m = d
            val r = m.open_path(path, flags)
            (DriverInstance.DbFs(m), r)

