fn _driver_write_text_handle(driver: DriverInstance, handle: FileHandle, content: text) -> (DriverInstance, Result<(), FsError>):
    # Drivers are value structs: mutate a local copy and hand it back so the
    # mount table stores it (scalar state such as fd counters is otherwise lost).
    match driver:
        case DriverInstance.Fat32(d):
            var m = d
            val bytes = text_to_bytes_pure(content)
            val r = _drop_count(m.write(handle, 0, bytes))
            (DriverInstance.Fat32(m), r)
        case DriverInstance.Nvfs(d):
            var m = d
            val bytes = text_to_bytes_pure(content)
            val r = _drop_count(m.write(handle, 0, bytes))
            (DriverInstance.Nvfs(m), r)
        case DriverInstance.NvfsPosix(d):
            var m = d
            val bytes = text_to_bytes_pure(content)
            val r = _drop_count(m.write(handle, 0, bytes))
            (DriverInstance.NvfsPosix(m), r)
        case DriverInstance.DbFs(d):
            var m = d
            val r = m.write_handle(handle, content)
            (DriverInstance.DbFs(m), r)
        case _: (driver, Err(FsError.Unsupported))

fn _driver_pwrite_text_handle(driver: DriverInstance, handle: FileHandle, patch: text, offset: i64) -> (DriverInstance, Result<(), FsError>):
    # Drivers are value structs: mutate a local copy and hand it back so the
    # mount table stores it (scalar state such as fd counters is otherwise lost).
    match driver:
        case DriverInstance.Fat32(d):
            var m = d
            val bytes = text_to_bytes_pure(patch)
            val r = _drop_count(m.pwrite(handle, offset, bytes))
            (DriverInstance.Fat32(m), r)
        case DriverInstance.Nvfs(d):
            var m = d
            val bytes = text_to_bytes_pure(patch)
            val r = _drop_count(m.pwrite(handle, offset, bytes))
            (DriverInstance.Nvfs(m), r)
        case DriverInstance.NvfsPosix(d):
            var m = d
            val bytes = text_to_bytes_pure(patch)
            val r = _drop_count(m.pwrite(handle, offset, bytes))
            (DriverInstance.NvfsPosix(m), r)
        case DriverInstance.DbFs(d):
            var m = d
            val r = m.pwrite_handle(handle, patch, offset)
            (DriverInstance.DbFs(m), r)
        case _: (driver, Err(FsError.Unsupported))

fn _driver_pread_text_handle(driver: DriverInstance, handle: FileHandle, offset: i64, length: i64) -> Result<text, FsError>:
    match driver:
        case DriverInstance.Fat32(d):
            val buf = alloc_zeroed_bytes(length)
            match d.pread(handle, offset, buf):
                case Err(e): Err(e)
                case Ok(n): Ok(_bytes_to_text_prefix(buf, n))
        case DriverInstance.Nvfs(d):
            val buf = alloc_zeroed_bytes(length)
            match d.pread(handle, offset, buf):
                case Err(e): Err(e)
                case Ok(n): Ok(_bytes_to_text_prefix(buf, n))
        case DriverInstance.NvfsPosix(d):
            val buf = alloc_zeroed_bytes(length)
            match d.pread(handle, offset, buf):
                case Err(e): Err(e)
                case Ok(n): Ok(_bytes_to_text_prefix(buf, n))
        case DriverInstance.DbFs(d): d.pread_handle(handle, offset, length)
        case _:                      Err(FsError.Unsupported)

fn _driver_close_handle(driver: DriverInstance, handle: FileHandle) -> (DriverInstance, Result<(), FsError>):
    # Drivers are value structs: mutate a local copy and hand it back so the
    # mount table stores it (scalar state such as fd counters is otherwise lost).
    match driver:
        case DriverInstance.Fat32(d):
            var m = d
            val r = m.close(handle)
            (DriverInstance.Fat32(m), r)
        case DriverInstance.Nvfs(d):
            var m = d
            val r = m.close_handle(handle)
            (DriverInstance.Nvfs(m), r)
        case DriverInstance.NvfsPosix(d):
            var m = d
            val r = m.close_handle(handle)
            (DriverInstance.NvfsPosix(m), r)
        case DriverInstance.RamFs(d):
            var m = d
            val r = m.close(handle)
            (DriverInstance.RamFs(m), r)
        case DriverInstance.DbFs(d):
            var m = d
            val r = m.close_handle(handle)
            (DriverInstance.DbFs(m), r)
        case _: (driver, Err(FsError.Unsupported))

