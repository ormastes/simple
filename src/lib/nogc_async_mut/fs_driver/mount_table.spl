# MountTable — tracks active filesystem mounts.
#
# MountEntry associates a mount point path with a DriverInstance.
# MountTable provides mount/unmount/lookup/resolve operations.
# Longest-prefix match is used for path resolution.
#
# Source: doc/05_design/fs_driver_interface.md §3, §8.

use std.fs_driver.types.{Path, MountOptions, StatInfo, FileHandle, DirHandle, DirEntry, OpenFlags, ExecuteTrust}
use std.fs_driver.instance.{DriverInstance}
use std.fs_driver.error.{FsError}
use std.fs_driver.capability.{Capability, FsCapabilitySet, FS_CAPABILITY_V1}
use common.string_core.{str_char_at}
use std.fs_driver.mount_driver_dispatch.{_driver_name, _driver_capabilities, _driver_stat_path,
    _driver_fstat, _driver_open_path, _driver_opendir_path, _driver_readdir_handle,
    _driver_read_handle, _driver_mkdir_path, _driver_write_text_handle,
    _driver_pwrite_text_handle, _driver_pread_text_handle, _driver_close_handle,
    _driver_fsync, _driver_fdatasync, _file_stat_is_directory,
    _driver_unlink_path_text, _driver_rename_path_text, _driver_ftruncate_handle,
    _driver_mmap_shared_writable_handle, _driver_link_path_text}

val POSITIONED_DRIVER_MAX_BYTES: u64 = 0x7fffffffu64

enum PositionedDriverKind:
    Nvfs
    Dbfs

fn _bytes_to_text_prefix(buf: [u8], count: i64) -> text:
    var out = ""
    var i: i64 = 0
    while i < count and i < buf.len() as i64:
        out = out + buf[i as i32].chr()
        i = i + 1
    out
val MOUNT_ID_MAX: u32 = 0xFFFFFFFFu32
val HANDLE_ID_MAX: u64 = 0xFFFFFFFFFFFFFFFFu64
val MOUNT_TABLE_MAX_MOUNTS: i64 = 4096
val MOUNT_TABLE_MAX_OPEN_FILES: i64 = 65536
val MOUNT_TABLE_MAX_OPEN_DIRS: i64 = 65536
val MOUNT_TABLE_MAX_PATH_BYTES: i64 = 4096
val MOUNT_TABLE_MAX_IO_BYTES: i64 = 16 * 1024 * 1024
val MOUNT_TABLE_MAX_EXECUTABLE_BYTES: u64 = 281474976710656u64

fn _mount_path_canonical(path: text) -> bool:
    if path.len() == 0 or path.len() > MOUNT_TABLE_MAX_PATH_BYTES or
        not path.starts_with("/") or path.contains("\\") or
        path.contains("\0") or path.contains("\n") or path.contains("\r"):
        return false
    if path == "/":
        return true
    if path.ends_with("/") or path.contains("//") or path.contains("/./") or
        path.ends_with("/.") or path.contains("/../") or path.ends_with("/.."):
        return false
    true

fn _text_has_mount_prefix(source: text, prefix: text) -> bool:
    if prefix == "/":
        return source.starts_with("/")
    if source == prefix:
        return true
    if prefix.len() > source.len():
        return false
    var idx: i64 = 0
    while idx < prefix.len():
        if str_char_at(source, idx) != str_char_at(prefix, idx):
            return false
        idx = idx + 1
    if source.len() <= prefix.len():
        return false
    str_char_at(source, prefix.len()) == "/"

fn _driver_name(driver: DriverInstance) -> text:
    match driver:
        case DriverInstance.Fat32(d):     d.name
        case DriverInstance.Nvfs(d):      d.name
        case DriverInstance.NvfsPosix(d): d.name
        case DriverInstance.RamFs(d):     d.name
        case DriverInstance.DbFs(d):      d.name

fn _driver_stat_path(driver: DriverInstance, path: Path) -> Result<StatInfo, FsError>:
    match driver:
        case DriverInstance.Fat32(d):     d.stat_path(path)
        case DriverInstance.Nvfs(d):      d.stat_path(path)
        case DriverInstance.NvfsPosix(d): d.stat_path(path)
        case DriverInstance.RamFs(d):     d.stat_path(path)
        case DriverInstance.DbFs(d):      d.stat_path(path)

fn _driver_open_path(driver: DriverInstance, path: Path, flags: OpenFlags) -> Result<FileHandle, FsError>:
    match driver:
        case DriverInstance.Fat32(d):     d.open_path(path, flags)
        case DriverInstance.Nvfs(d):      d.open_path(path, flags)
        case DriverInstance.NvfsPosix(d): d.open_path(path, flags)
        case DriverInstance.RamFs(d):     d.open_path(path, flags)
        case DriverInstance.DbFs(d):      d.open_path(path, flags)

fn _driver_opendir_path(driver: DriverInstance, path: Path) -> Result<DirHandle, FsError>:
    match driver:
        case DriverInstance.Fat32(d):     d.opendir_path(path)
        case DriverInstance.Nvfs(d):      d.opendir_path(path)
        case DriverInstance.NvfsPosix(d): d.opendir_path(path)
        case DriverInstance.RamFs(d):     d.opendir_path(path)
        case DriverInstance.DbFs(d):      d.opendir_path(path)

fn _driver_readdir_handle(driver: DriverInstance, handle: DirHandle) -> Result<[DirEntry], FsError>:
    match driver:
        case DriverInstance.Fat32(d):     d.readdir_handle(handle)
        case DriverInstance.Nvfs(d):      d.readdir_handle(handle)
        case DriverInstance.NvfsPosix(d): d.readdir_handle(handle)
        case DriverInstance.RamFs(d):     d.readdir_handle(handle)
        case DriverInstance.DbFs(d):      d.readdir_handle(handle)

fn _driver_read_handle(driver: DriverInstance, handle: FileHandle, length: i64) -> Result<text, FsError>:
    match driver:
        case DriverInstance.Fat32(d):     d.read_handle(handle, length)
        case DriverInstance.Nvfs(d):      d.read_handle(handle, length)
        case DriverInstance.NvfsPosix(d): d.read_handle(handle, length)
        case DriverInstance.RamFs(d):     d.read_handle(handle, length)
        case DriverInstance.DbFs(d):      d.read_handle(handle, length)

fn _driver_mkdir_path(driver: DriverInstance, path: text, mode: u32) -> Result<(), FsError>:
    match driver:
        case DriverInstance.Fat32(d):     d.mkdir_path(path, mode)
        case DriverInstance.Nvfs(d):      d.mkdir_path(path, mode)
        case DriverInstance.NvfsPosix(d): d.mkdir_path(path, mode)
        case DriverInstance.RamFs(d):     d.mkdir_path(path, mode)
        case DriverInstance.DbFs(d):      d.mkdir_path(path, mode)

fn _driver_write_text_handle(driver: DriverInstance, handle: FileHandle, content: text) -> Result<(), FsError>:
    match driver:
        case DriverInstance.Nvfs(d):
            val bytes = text_to_bytes_pure(content)
            val written = d.write(handle, 0, bytes)
            match written:
                case Err(e):
                    Err(e)
                case Ok(_):
                    Ok(())
        case DriverInstance.NvfsPosix(d):
            val bytes = text_to_bytes_pure(content)
            val written = d.write(handle, 0, bytes)
            match written:
                case Err(e):
                    Err(e)
                case Ok(_):
                    Ok(())
        case DriverInstance.DbFs(d): d.write_handle(handle, content)
        case _:                      Err(FsError.Unsupported)

fn _driver_pwrite_text_handle(driver: DriverInstance, handle: FileHandle, patch: text, offset: i64) -> Result<(), FsError>:
    match driver:
        case DriverInstance.Nvfs(d):
            val bytes = text_to_bytes_pure(patch)
            val written = d.pwrite(handle, offset, bytes)
            match written:
                case Err(e):
                    Err(e)
                case Ok(_):
                    Ok(())
        case DriverInstance.NvfsPosix(d):
            val bytes = text_to_bytes_pure(patch)
            val written = d.pwrite(handle, offset, bytes)
            match written:
                case Err(e):
                    Err(e)
                case Ok(_):
                    Ok(())
        case DriverInstance.DbFs(d): d.pwrite_handle(handle, patch, offset)
        case _:                      Err(FsError.Unsupported)

fn _driver_pread_text_handle(driver: DriverInstance, handle: FileHandle, offset: i64, length: i64) -> Result<text, FsError>:
    match driver:
        case DriverInstance.Nvfs(d):
            val buf = alloc_zeroed_bytes(length)
            val read_n = d.pread(handle, offset, buf)
            match read_n:
                case Err(e):
                    Err(e)
                case Ok(n):
                    Ok(_bytes_to_text_prefix(buf, n))
        case DriverInstance.NvfsPosix(d):
            val buf = alloc_zeroed_bytes(length)
            val read_n = d.pread(handle, offset, buf)
            match read_n:
                case Err(e):
                    Err(e)
                case Ok(n):
                    Ok(_bytes_to_text_prefix(buf, n))
        case DriverInstance.DbFs(d): d.pread_handle(handle, offset, length)
        case _:                      Err(FsError.Unsupported)

fn _positioned_prefix(buf: [u8], count: i64) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < count and i < buf.len() as i64:
        out.push(buf[i as i32])
        i = i + 1
    out

fn _driver_positioned_read_bytes(
    driver: DriverInstance, kind: PositionedDriverKind,
    handle: FileHandle, offset: i64, length: i64
) -> Result<[u8], FsError>:
    match kind:
        case PositionedDriverKind.Nvfs:
            match driver:
                case DriverInstance.Nvfs(d):
                    var buf = alloc_zeroed_bytes(length)
                    val read_n = d.pread(handle, offset, buf)?
                    if read_n < 0 or read_n > length:
                        return Err(FsError.IoError(code: 0u32))
                    Ok(_positioned_prefix(buf, read_n))
                case DriverInstance.NvfsPosix(d):
                    var buf = alloc_zeroed_bytes(length)
                    val read_n = d.pread(handle, offset, buf)?
                    if read_n < 0 or read_n > length:
                        return Err(FsError.IoError(code: 0u32))
                    Ok(_positioned_prefix(buf, read_n))
                case _:
                    Err(FsError.Unsupported)
        case PositionedDriverKind.Dbfs:
            match driver:
                case DriverInstance.DbFs(d):
                    d.pread_bytes_handle(handle, offset, length)
                case _:
                    Err(FsError.Unsupported)

fn _driver_positioned_write_bytes(
    driver: DriverInstance, kind: PositionedDriverKind,
    handle: FileHandle, offset: i64, data: [u8]
) -> Result<i64, FsError>:
    match kind:
        case PositionedDriverKind.Nvfs:
            match driver:
                case DriverInstance.Nvfs(d): d.pwrite(handle, offset, data)
                case DriverInstance.NvfsPosix(d): d.pwrite(handle, offset, data)
                case _: Err(FsError.Unsupported)
        case PositionedDriverKind.Dbfs:
            match driver:
                case DriverInstance.DbFs(d): d.pwrite_bytes_handle(handle, offset, data)
                case _: Err(FsError.Unsupported)

fn _driver_close_handle(driver: DriverInstance, handle: FileHandle) -> Result<(), FsError>:
    match driver:
        case DriverInstance.Nvfs(d):      d.close_handle(handle)
        case DriverInstance.NvfsPosix(d): d.close_handle(handle)
        case DriverInstance.DbFs(d):      d.close_handle(handle)
        case DriverInstance.RamFs(d):     d.close(handle)
        case _:                           Ok(())

fn _driver_unlink_path_text(driver: DriverInstance, path: text) -> Result<(), FsError>:
    match driver:
        case DriverInstance.Nvfs(d):      d.unlink_path(path)
        case DriverInstance.NvfsPosix(d): d.unlink_path(path)
        case DriverInstance.DbFs(d):      d.unlink_path(path)
        case _:                           Err(FsError.Unsupported)

fn _driver_rename_path_text(driver: DriverInstance, old_path: text, new_path: text) -> Result<(), FsError>:
    match driver:
        case DriverInstance.Nvfs(d):      d.rename_path(old_path, new_path)
        case DriverInstance.NvfsPosix(d): d.rename_path(old_path, new_path)
        case DriverInstance.DbFs(d):      d.rename_path(old_path, new_path)
        case _:                           Err(FsError.Unsupported)

fn _driver_ftruncate_handle(driver: DriverInstance, handle: FileHandle, new_size: i64) -> Result<(), FsError>:
    match driver:
        case DriverInstance.Nvfs(d):      d.ftruncate_handle(handle, new_size)
        case DriverInstance.NvfsPosix(d): d.ftruncate_handle(handle, new_size)
        case DriverInstance.DbFs(d):      d.ftruncate_handle(handle, new_size)
        case _:                           Err(FsError.Unsupported)

fn _driver_mmap_shared_writable_handle(driver: DriverInstance, handle: FileHandle, offset: i64, length: i64) -> Result<(), FsError>:
    val _ = driver
    val _ = handle
    val _ = offset
    val _ = length
    Err(FsError.Unsupported)

fn _driver_link_path_text(driver: DriverInstance, target: text, link_path: text) -> Result<(), FsError>:
    val _ = target
    val _ = link_path
    match driver:
        case _: Err(FsError.Unsupported)

struct MountId:
    """Opaque mount table index. Assigned sequentially; not reused after unmount."""
    id: u32

    static fn null() -> MountId:
        MountId(id: 0)

    me fn is_null() -> bool:
        self.id == 0

struct MountEntry:
    """Single active mount.

    id           — unique mount table slot index.
    mount_point  — absolute path string at which this filesystem is mounted.
    driver       — concrete driver wrapped in DriverInstance.
    opts         — options negotiated at mount time.
    active_caps  — capabilities active after mount-time negotiation.
    """
    id:          MountId
    mount_point: text
    driver:      DriverInstance
    opts:        MountOptions
    active_caps: u32   # FsCapabilitySet.bits after negotiation
    capability_version: u32
    mount_generation: u64
    namespace_generation: u64
    content_generation: u64

struct MountResolution:
    """Resolved mount id plus path relative to the mounted filesystem."""
    mount_id: MountId
    relpath:  Path

struct OpenFileBinding:
    virtual_handle: u64
    mount_id: MountId
    inner_handle: FileHandle

struct ExecuteOpenBinding:
    """Owned, backend-neutral executable-open identity and generation snapshot."""
    mount_id: MountId
    backend_name: text
    file_handle: FileHandle
    mount_generation: u64
    namespace_generation: u64
    content_generation: u64
    size: i64

struct OpenDirBinding:
    virtual_handle: u64
    mount_id: MountId
    inner_handle: DirHandle

struct MountTable:
    """Registry of active mounts.

    mounts       — ordered list of MountEntry; lookup uses longest-prefix match.
    next_id      — next MountId to assign (monotonically increasing).

    Thread safety: callers are responsible for holding an appropriate lock
    before calling mutating methods (mount, unmount). Reads (lookup, resolve)
    may race only if the caller guarantees no concurrent mounts/unmounts.
    """
    mounts:           [MountEntry]
    next_id:          u32
    open_files:       [OpenFileBinding]
    next_file_handle: u64
    open_dirs:        [OpenDirBinding]
    next_dir_handle:  u64

impl MountTable:
    static fn new() -> MountTable:
        MountTable(mounts: [], next_id: 1, open_files: [], next_file_handle: 1001u64, open_dirs: [], next_dir_handle: 2001u64)

    me fn _file_binding(handle: FileHandle) -> OpenFileBinding?:
        var i: i32 = 0
        while i < self.open_files.len() as i32:
            if self.open_files[i].virtual_handle == handle.id:
                return Some(self.open_files[i])
            i = i + 1
        nil

    me fn _dir_binding(handle: DirHandle) -> OpenDirBinding?:
        var i: i32 = 0
        while i < self.open_dirs.len() as i32:
            if self.open_dirs[i].virtual_handle == handle.id:
                return Some(self.open_dirs[i])
            i = i + 1
        nil

    me fn _unbind_file_handle(handle: FileHandle):
        var i: i32 = 0
        while i < self.open_files.len() as i32:
            if self.open_files[i].virtual_handle == handle.id:
                self.open_files = self.open_files.remove(i)
                return
            i = i + 1

    me fn _unbind_dir_handle(handle: DirHandle):
        var i: i32 = 0
        while i < self.open_dirs.len() as i32:
            if self.open_dirs[i].virtual_handle == handle.id:
                self.open_dirs = self.open_dirs.remove(i)
                return
            i = i + 1

    me fn mount(path: text, driver: DriverInstance, opts: MountOptions) -> Result<MountId, FsError>:
        """Add a new mount at path.

        Fails with AlreadyExists if path is already a mount point.
        Assigns a fresh MountId and appends the entry.
        """
        if not _mount_path_canonical(path):
            return Err(FsError.InvalidArg)
        if self.mounts.len() >= MOUNT_TABLE_MAX_MOUNTS:
            return Err(FsError.TooLarge)
        for entry in self.mounts:
            if entry.mount_point == path:
                return Err(FsError.AlreadyExists)

        if self.next_id == MOUNT_ID_MAX:
            return Err(FsError.TooLarge)
        val supported = _driver_capabilities(driver)
        val required = FsCapabilitySet(bits: opts.require_caps)
        if (supported.bits & required.bits) != required.bits:
            return Err(FsError.Unsupported)
        val want = FsCapabilitySet(bits: opts.want_caps)
        # An empty request preserves historical mounts: all backend capabilities
        # are active unless the caller explicitly narrows the request.
        val active = if want.is_empty(): supported else supported.intersect(want)
        val id = MountId(id: self.next_id)
        self.next_id = self.next_id + 1
        val entry = MountEntry(
            id: id,
            mount_point: path,
            driver: driver,
            opts: opts,
            active_caps: active.bits,
            capability_version: FS_CAPABILITY_V1,
            mount_generation: 1u64,
            namespace_generation: 1u64,
            content_generation: 1u64
        )
        self.mounts = self.mounts.push(entry)
        Ok(id)

    me fn unmount(path: text) -> Result<(), FsError>:
        """Remove the mount at path.

        Fails with NotFound if no mount exists at exactly that path.
        Callers must ensure no open handles before calling unmount.
        """
        if not _mount_path_canonical(path):
            return Err(FsError.InvalidArg)
        var idx: i64 = -1
        var i: i64 = 0
        while i < self.mounts.len() as i64:
            if self.mounts[i as i32].mount_point == path:
                idx = i
            i = i + 1
        if idx < 0:
            return Err(FsError.NotFound)
        val mount_id = self.mounts[idx as i32].id
        for binding in self.open_files:
            if binding.mount_id == mount_id:
                return Err(FsError.Busy)
        for binding in self.open_dirs:
            if binding.mount_id == mount_id:
                return Err(FsError.Busy)
        self.mounts = self.mounts.remove(idx as i32)
        Ok(())

    me fn lookup_text(path: text) -> MountEntry?:
        """Return the MountEntry whose mount_point is the longest prefix of path."""
        var best_len: i64 = -1
        var best_idx: i32 = -1
        var i: i32 = 0
        while i < self.mounts.len() as i32:
            val mp = self.mounts[i].mount_point
            if _text_has_mount_prefix(path, mp):
                val mp_len = mp.len()
                if mp_len > best_len:
                    best_len = mp_len
                    best_idx = i
            i = i + 1
        if best_idx < 0:
            nil
        else:
            Some(self.mounts[best_idx])

    me fn positioned_read_bytes(
        file_object_id: u64, kind: PositionedDriverKind,
        offset: u64, length: u64
    ) -> Result<[u8], FsError>:
        """Read through one live MountTable virtual handle without a cursor."""
        if file_object_id == 0 or length > POSITIONED_DRIVER_MAX_BYTES:
            return Err(FsError.InvalidArg)
        if offset > 0x7fffffffffffffffu64 or offset + length < offset:
            return Err(FsError.InvalidArg)
        val binding_opt = self._file_binding(FileHandle(id: file_object_id))
        match binding_opt:
            case nil:
                Err(FsError.StaleHandle)
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        return _driver_positioned_read_bytes(
                            self.mounts[i].driver, kind, binding.inner_handle,
                            offset as i64, length as i64)
                    i = i + 1
                Err(FsError.StaleHandle)

    me fn positioned_write_bytes(
        file_object_id: u64, kind: PositionedDriverKind,
        offset: u64, data: [u8]
    ) -> Result<u64, FsError>:
        """Write through one live MountTable virtual handle without a cursor."""
        val length = data.len() as u64
        if file_object_id == 0 or length > POSITIONED_DRIVER_MAX_BYTES:
            return Err(FsError.InvalidArg)
        if offset > 0x7fffffffffffffffu64 or offset + length < offset:
            return Err(FsError.InvalidArg)
        val binding_opt = self._file_binding(FileHandle(id: file_object_id))
        match binding_opt:
            case nil:
                Err(FsError.StaleHandle)
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        val written = _driver_positioned_write_bytes(
                            self.mounts[i].driver, kind, binding.inner_handle,
                            offset as i64, data)?
                        if written < 0 or written > data.len() as i64:
                            return Err(FsError.IoError(code: 0u32))
                        return Ok(written as u64)
                    i = i + 1
                Err(FsError.StaleHandle)
    me fn lookup(path: Path) -> MountEntry?:
        """Return the MountEntry whose mount_point is the longest prefix of path."""
        if not _mount_path_canonical(path.raw):
            return nil
        self.lookup_text(path.raw)

    me fn resolve(path: Path) -> Result<MountResolution, FsError>:
        """Resolve path to a mount id plus relpath within that mount.

        relpath is the suffix of path after stripping the mount point prefix.
        Fails with NotFound if no mount covers path.
        """
        if not _mount_path_canonical(path.raw):
            return Err(FsError.InvalidArg)
        val entry_opt = self.lookup_text(path.raw)
        match entry_opt:
            case nil:
                Err(FsError.NotFound)
            case Some(entry):
                val mp_len = entry.mount_point.len()
                # FR-STORAGE-0004: do NOT use path.raw.slice() — broken in baremetal
                # Cranelift codegen. Build relpath by indexed char-copy instead.
                var rel_raw: text = ""
                var ci: i64 = mp_len
                if ci < path.raw.len() and str_char_at(path.raw, ci) == "/":
                    ci = ci + 1
                while ci < path.raw.len():
                    rel_raw = rel_raw + str_char_at(path.raw, ci)
                    ci = ci + 1
                val relpath: Path = Path(raw: rel_raw)
                Ok(MountResolution(mount_id: entry.id, relpath: relpath))

    me fn resolve_driver(path: text) -> Result<DriverInstance, FsError>:
        """Return the DriverInstance whose mount point best covers path."""
        val entry_opt = self.lookup_text(path)
        match entry_opt:
            case nil:
                Err(FsError.NotFound)
            case Some(entry):
                Ok(entry.driver)

    me fn stat(path: text) -> Result<StatInfo, FsError>:
        """Stat path via the appropriate mounted driver."""
        val resolved = self.resolve(Path(raw: path))
        match resolved:
            case Err(e):
                Err(e)
            case Ok(pair):
                val mount_id = pair.mount_id
                val relpath = pair.relpath
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == mount_id:
                        return _driver_stat_path(self.mounts[i].driver, relpath)
                    i = i + 1
                Err(FsError.NotFound)

    me fn open(path: text, flags: OpenFlags) -> Result<FileHandle, FsError>:
        """Open path for I/O via the appropriate mounted driver."""
        val resolved = self.resolve(Path(raw: path))
        match resolved:
            case Err(e):
                Err(e)
            case Ok(pair):
                val mount_id = pair.mount_id
                val relpath = pair.relpath
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == mount_id:
                        if self.next_file_handle == HANDLE_ID_MAX or
                            self.open_files.len() >= MOUNT_TABLE_MAX_OPEN_FILES:
                            return Err(FsError.TooLarge)
                        if (flags.bits & 64) != 0:
                            self._generation_available(mount_id, true)?
                        if (flags.bits & 512) != 0:
                            self._generation_available(mount_id, false)?
                        val opened = _driver_open_path(self.mounts[i].driver, relpath, flags)
                        match opened:
                            case Err(e):
                                return Err(e)
                            case Ok(inner):
                                val virtual_handle = self.next_file_handle
                                if virtual_handle == 0 or virtual_handle == 0xffffffffffffffffu64:
                                    val _ = _driver_close_handle(self.mounts[i].driver, inner)
                                    return Err(FsError.TooLarge)
                                self.next_file_handle = self.next_file_handle + 1u64
                                self.open_files = self.open_files.push(OpenFileBinding(
                                    virtual_handle: virtual_handle,
                                    mount_id: mount_id,
                                    inner_handle: inner
                                ))
                                if (flags.bits & 64) != 0:
                                    val generation_result = self._advance_generation(mount_id, true)
                                    if generation_result.is_err():
                                        self._unbind_file_handle(FileHandle(id: virtual_handle))
                                        _driver_close_handle(self.mounts[i].driver, inner)
                                        return Err(generation_result.unwrap_err())
                                if (flags.bits & 512) != 0:
                                    val generation_result = self._advance_generation(mount_id, false)
                                    if generation_result.is_err():
                                        self._unbind_file_handle(FileHandle(id: virtual_handle))
                                        _driver_close_handle(self.mounts[i].driver, inner)
                                        return Err(generation_result.unwrap_err())
                                return Ok(FileHandle(id: virtual_handle))
                    i = i + 1
                Err(FsError.NotFound)

    me fn open_for_execute(path: text, trust: ExecuteTrust) -> Result<ExecuteOpenBinding, FsError>:
        """Resolve once, enforce mount execute policy, and own the opened file."""
        val resolved = self.resolve(Path(raw: path))?
        var i: i32 = 0
        while i < self.mounts.len() as i32:
            if self.mounts[i].id == resolved.mount_id:
                val entry = self.mounts[i]
                if self.next_file_handle == HANDLE_ID_MAX or
                    self.open_files.len() >= MOUNT_TABLE_MAX_OPEN_FILES:
                    return Err(FsError.TooLarge)
                val caps = FsCapabilitySet(bits: entry.active_caps)
                if entry.opts.noexec or not caps.has(Capability.Execute):
                    return Err(FsError.Permission)
                if trust == ExecuteTrust.Untrusted and not entry.opts.allow_untrusted_exec:
                    return Err(FsError.Permission)
                val opened_result = _driver_open_path(entry.driver, resolved.relpath, OpenFlags.read_only())
                val opened = match opened_result:
                    case Err(error): return Err(error)
                    case Ok(handle): handle
                # Backends must reject directory handles from fstat or mark them
                # with the POSIX directory type bits; either result is denied.
                val stat_result = _driver_fstat(entry.driver, opened)
                val stat = match stat_result:
                    case Err(error):
                        _driver_close_handle(entry.driver, opened)
                        return Err(error)
                    case Ok(value): value
                if _file_stat_is_directory(stat):
                    _driver_close_handle(entry.driver, opened)
                    return Err(FsError.InvalidArg)
                if stat.size < 1u64 or stat.size > MOUNT_TABLE_MAX_EXECUTABLE_BYTES:
                    _driver_close_handle(entry.driver, opened)
                    return Err(FsError.TooLarge)
                val virtual_handle = self.next_file_handle
                self.next_file_handle = self.next_file_handle + 1u64
                self.open_files = self.open_files.push(OpenFileBinding(
                    virtual_handle: virtual_handle,
                    mount_id: entry.id,
                    inner_handle: opened
                ))
                return Ok(ExecuteOpenBinding(
                    mount_id: entry.id,
                    backend_name: _driver_name(entry.driver),
                    file_handle: FileHandle(id: virtual_handle),
                    mount_generation: entry.mount_generation,
                    namespace_generation: entry.namespace_generation,
                    content_generation: entry.content_generation,
                    size: stat.size as i64
                ))
            i = i + 1
        Err(FsError.NotFound)

    fn execute_binding_is_current(binding: ExecuteOpenBinding) -> bool:
        val open_binding = self._file_binding(binding.file_handle)
        match open_binding:
            case nil: return false
            case Some(value):
                if value.mount_id != binding.mount_id:
                    return false
        var i: i32 = 0
        while i < self.mounts.len() as i32:
            val entry = self.mounts[i]
            if entry.id == binding.mount_id:
                return entry.mount_generation == binding.mount_generation and
                    entry.namespace_generation == binding.namespace_generation and
                    entry.content_generation == binding.content_generation
            i = i + 1
        false

    me fn bump_namespace_generation(mount_id: MountId) -> Result<(), FsError>:
        self._advance_generation(mount_id, true)

    me fn bump_content_generation(mount_id: MountId) -> Result<(), FsError>:
        self._advance_generation(mount_id, false)

    me fn _advance_generation(mount_id: MountId, namespace: bool) -> Result<(), FsError>:
        var i: i32 = 0
        while i < self.mounts.len() as i32:
            if self.mounts[i].id == mount_id:
                var entry = self.mounts[i]
                if namespace:
                    if entry.namespace_generation == 0xFFFFFFFFFFFFFFFFu64:
                        return Err(FsError.TooLarge)
                    entry.namespace_generation = entry.namespace_generation + 1u64
                else:
                    if entry.content_generation == 0xFFFFFFFFFFFFFFFFu64:
                        return Err(FsError.TooLarge)
                    entry.content_generation = entry.content_generation + 1u64
                self.mounts[i] = entry
                return Ok(())
            i = i + 1
        Err(FsError.NotFound)

    fn _generation_available(mount_id: MountId, namespace: bool) -> Result<(), FsError>:
        var i: i32 = 0
        while i < self.mounts.len() as i32:
            if self.mounts[i].id == mount_id:
                val generation = if namespace:
                    self.mounts[i].namespace_generation
                else:
                    self.mounts[i].content_generation
                if generation == HANDLE_ID_MAX:
                    return Err(FsError.TooLarge)
                return Ok(())
            i = i + 1
        Err(FsError.NotFound)

    me fn opendir(path: text) -> Result<DirHandle, FsError>:
        """Open directory via the appropriate mounted driver."""
        val resolved = self.resolve(Path(raw: path))
        match resolved:
            case Err(e):
                Err(e)
            case Ok(pair):
                val mount_id = pair.mount_id
                val relpath = pair.relpath
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == mount_id:
                        if self.next_dir_handle == HANDLE_ID_MAX or
                            self.open_dirs.len() >= MOUNT_TABLE_MAX_OPEN_DIRS:
                            return Err(FsError.TooLarge)
                        val opened = _driver_opendir_path(self.mounts[i].driver, relpath)
                        match opened:
                            case Err(e):
                                return Err(e)
                            case Ok(inner):
                                val virtual_handle = self.next_dir_handle
                                self.next_dir_handle = self.next_dir_handle + 1u64
                                self.open_dirs = self.open_dirs.push(OpenDirBinding(
                                    virtual_handle: virtual_handle,
                                    mount_id: mount_id,
                                    inner_handle: inner
                                ))
                                return Ok(DirHandle(id: virtual_handle))
                    i = i + 1
                Err(FsError.NotFound)

    me fn readdir(handle: DirHandle) -> Result<[DirEntry], FsError>:
        """Read directory entries via the binding's recorded mount only."""
        val binding_opt = self._dir_binding(handle)
        match binding_opt:
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        return _driver_readdir_handle(self.mounts[i].driver, binding.inner_handle)
                    i = i + 1
            case nil: Err(FsError.StaleHandle)
        Err(FsError.StaleHandle)

    me fn read(handle: FileHandle, length: i64) -> Result<text, FsError>:
        """Read up to length bytes via the binding's recorded mount only."""
        if length < 0 or length > MOUNT_TABLE_MAX_IO_BYTES:
            return Err(FsError.TooLarge)
        val binding_opt = self._file_binding(handle)
        match binding_opt:
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        return _driver_read_handle(self.mounts[i].driver, binding.inner_handle, length)
                    i = i + 1
            case nil: Err(FsError.StaleHandle)
        Err(FsError.StaleHandle)

    me fn mkdir(path: text, mode: u32) -> Result<(), FsError>:
        """Create directory at path via the appropriate mounted driver."""
        val resolved = self.resolve(Path(raw: path))
        match resolved:
            case Err(e):
                Err(e)
            case Ok(pair):
                val mount_id = pair.mount_id
                val relpath = pair.relpath
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == mount_id:
                        self._generation_available(mount_id, true)?
                        val result = _driver_mkdir_path(self.mounts[i].driver, relpath.raw, mode)
                        if result.is_ok():
                            self._advance_generation(mount_id, true)?
                        return result
                    i = i + 1
                Err(FsError.NotFound)

    me fn block_device_for(path: text) -> Result<text, FsError>:
        """Return a text tag identifying the block device for the mount at path."""
        val entry_opt = self.lookup_text(path)
        match entry_opt:
            case nil:
                Err(FsError.NotFound)
            case Some(entry):
                Ok(_driver_name(entry.driver))

    me fn write(handle: FileHandle, content: text) -> Result<(), FsError>:
        """Write text content through the binding's recorded mount only."""
        if content.len() > MOUNT_TABLE_MAX_IO_BYTES:
            return Err(FsError.TooLarge)
        val binding_opt = self._file_binding(handle)
        match binding_opt:
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        self._generation_available(binding.mount_id, false)?
                        val result = _driver_write_text_handle(self.mounts[i].driver, binding.inner_handle, content)
                        if result.is_ok():
                            self._advance_generation(binding.mount_id, false)?
                        return result
                    i = i + 1
            case nil: Err(FsError.StaleHandle)
        Err(FsError.StaleHandle)

    me fn pwrite(handle: FileHandle, patch: text, offset: i64) -> Result<(), FsError>:
        """Write text patch through the binding's recorded mount only."""
        if offset < 0 or patch.len() > MOUNT_TABLE_MAX_IO_BYTES:
            return Err(FsError.TooLarge)
        val binding_opt = self._file_binding(handle)
        match binding_opt:
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        self._generation_available(binding.mount_id, false)?
                        val result = _driver_pwrite_text_handle(self.mounts[i].driver, binding.inner_handle, patch, offset)
                        if result.is_ok():
                            self._advance_generation(binding.mount_id, false)?
                        return result
                    i = i + 1
            case nil: Err(FsError.StaleHandle)
        Err(FsError.StaleHandle)

    me fn pread(handle: FileHandle, offset: i64, length: i64) -> Result<text, FsError>:
        """Read length chars through the binding's recorded mount only."""
        if offset < 0 or length < 0 or length > MOUNT_TABLE_MAX_IO_BYTES:
            return Err(FsError.TooLarge)
        val binding_opt = self._file_binding(handle)
        match binding_opt:
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        return _driver_pread_text_handle(self.mounts[i].driver, binding.inner_handle, offset, length)
                    i = i + 1
            case nil: Err(FsError.StaleHandle)
        Err(FsError.StaleHandle)

    me fn close(handle: FileHandle) -> Result<(), FsError>:
        """Close an open file handle through its recorded mount only."""
        val binding_opt = self._file_binding(handle)
        match binding_opt:
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        val r = _driver_close_handle(self.mounts[i].driver, binding.inner_handle)
                        if r.is_ok():
                            self._unbind_file_handle(handle)
                        return r
                    i = i + 1
            case nil: Err(FsError.StaleHandle)
        Err(FsError.StaleHandle)

    me fn fsync(handle: FileHandle) -> Result<(), FsError>:
        val binding_opt = self._file_binding(handle)
        match binding_opt:
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        val caps = FsCapabilitySet(bits: self.mounts[i].active_caps)
                        if not caps.has(Capability.DurableSync):
                            return Err(FsError.Unsupported)
                        return _driver_fsync(self.mounts[i].driver, binding.inner_handle)
                    i = i + 1
                Err(FsError.StaleHandle)
            case nil: Err(FsError.StaleHandle)

    me fn fdatasync(handle: FileHandle) -> Result<(), FsError>:
        val binding_opt = self._file_binding(handle)
        match binding_opt:
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        val caps = FsCapabilitySet(bits: self.mounts[i].active_caps)
                        if not caps.has(Capability.DurableSync):
                            return Err(FsError.Unsupported)
                        return _driver_fdatasync(self.mounts[i].driver, binding.inner_handle)
                    i = i + 1
                Err(FsError.StaleHandle)
            case nil: Err(FsError.StaleHandle)

    me fn unlink(path: text) -> Result<(), FsError>:
        """Remove a file from the filesystem."""
        val resolved = self.resolve(Path(raw: path))
        match resolved:
            case Err(e):
                Err(e)
            case Ok(pair):
                val mount_id = pair.mount_id
                val relpath = pair.relpath
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == mount_id:
                        self._generation_available(mount_id, true)?
                        val result = _driver_unlink_path_text(self.mounts[i].driver, relpath.raw)
                        if result.is_ok():
                            self._advance_generation(mount_id, true)?
                        return result
                    i = i + 1
                Err(FsError.NotFound)

    me fn rename(old_path: text, new_path: text) -> Result<(), FsError>:
        """Rename a file or directory."""
        val old_resolved = self.resolve(Path(raw: old_path))
        match old_resolved:
            case Err(e):
                Err(e)
            case Ok(old_pair):
                val new_resolved = self.resolve(Path(raw: new_path))
                match new_resolved:
                    case Err(e):
                        Err(e)
                    case Ok(new_pair):
                        if old_pair.mount_id.id != new_pair.mount_id.id:
                            return Err(FsError.InvalidArg)
                        var i: i32 = 0
                        while i < self.mounts.len() as i32:
                            if self.mounts[i].id == old_pair.mount_id:
                                self._generation_available(old_pair.mount_id, true)?
                                val result = _driver_rename_path_text(self.mounts[i].driver, old_pair.relpath.raw, new_pair.relpath.raw)
                                if result.is_ok():
                                    self._advance_generation(old_pair.mount_id, true)?
                                return result
                            i = i + 1
                        Err(FsError.NotFound)

    me fn ftruncate(handle: FileHandle, new_size: i64) -> Result<(), FsError>:
        """Truncate or extend through the binding's recorded mount only."""
        val binding_opt = self._file_binding(handle)
        match binding_opt:
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        self._generation_available(binding.mount_id, false)?
                        val result = _driver_ftruncate_handle(self.mounts[i].driver, binding.inner_handle, new_size)
                        if result.is_ok():
                            self._advance_generation(binding.mount_id, false)?
                        return result
                    i = i + 1
            case nil: Err(FsError.StaleHandle)
        Err(FsError.StaleHandle)

    me fn mmap_shared_writable(handle: FileHandle, offset: i64, length: i64) -> Result<(), FsError>:
        """Shared writable mmap requires a binding and recorded mount."""
        if offset < 0 or length <= 0 or length > MOUNT_TABLE_MAX_IO_BYTES:
            return Err(FsError.InvalidArg)
        val binding_opt = self._file_binding(handle)
        match binding_opt:
            case Some(binding):
                var i: i32 = 0
                while i < self.mounts.len() as i32:
                    if self.mounts[i].id == binding.mount_id:
                        self._generation_available(binding.mount_id, false)?
                        val result = _driver_mmap_shared_writable_handle(self.mounts[i].driver, binding.inner_handle, offset, length)
                        if result.is_ok():
                            self._advance_generation(binding.mount_id, false)?
                        return result
                    i = i + 1
                Err(FsError.StaleHandle)
            case nil: Err(FsError.StaleHandle)

    me fn link(target: text, link_path: text) -> Result<(), FsError>:
        """Hard link — always returns ENOTSUP; uses path-based resolution."""
        val entry_opt = self.lookup_text(target)
        match entry_opt:
            case nil:
                Err(FsError.NotFound)
            case Some(entry):
                _driver_link_path_text(entry.driver, target, link_path)
