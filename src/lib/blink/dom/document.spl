# Blink Document — DOM Document container with ready-state lifecycle.
#
# Provides: ReadyState, Document, document_new.

use std.blink.dom.node.{DomTree, dom_tree_new}
use std.blink.url.url_parser.{ParsedUrl, parse_url}

enum ReadyState:
    Loading
    Interactive
    Complete

class Document:
    dom: DomTree
    url: ParsedUrl
    title: text
    ready_state: ReadyState
    character_set: text
    content_type: text

    me set_title(new_title: text):
        me.title = new_title

    me set_ready_state(state: ReadyState):
        me.ready_state = state

    me create_element(tag_name: text) -> i64:
        me.dom.create_element(tag_name)

    fn is_loading() -> bool:
        self.ready_state == ReadyState.Loading

    fn is_complete() -> bool:
        self.ready_state == ReadyState.Complete

fn document_new(url_str: text) -> Document:
    Document(
        dom: dom_tree_new(),
        url: parse_url(url_str),
        title: "",
        ready_state: ReadyState.Loading,
        character_set: "UTF-8",
        content_type: "text/html"
    )

export ReadyState, Document, document_new
