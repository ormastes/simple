# Blink-style unified input event envelope.

enum EventType:
    MouseDown
    MouseUp
    MouseMove
    MouseWheel
    KeyDown
    KeyUp
    Char
    TouchStart
    TouchMove
    TouchEnd

struct ModifierFlags:
    bits: i64

struct Point:
    x: f64
    y: f64

struct TouchPoint:
    id: i64
    position: Point

class InputEvent:
    event_type: EventType
    position: Point
    timestamp: f64
    modifiers: i64
    key_code: i64
    char_code: i64
    touches: [TouchPoint]
    wheel_delta_x: f64
    wheel_delta_y: f64
    handled: bool

impl InputEvent:
    fn has_modifier(flag: i64) -> bool:
        (self.modifiers & flag) != 0

    fn is_mouse() -> bool:
        self.event_type == EventType.MouseDown or self.event_type == EventType.MouseUp or
            self.event_type == EventType.MouseMove or self.event_type == EventType.MouseWheel

    fn is_keyboard() -> bool:
        self.event_type == EventType.KeyDown or self.event_type == EventType.KeyUp or
            self.event_type == EventType.Char

    fn is_touch() -> bool:
        self.event_type == EventType.TouchStart or self.event_type == EventType.TouchMove or
            self.event_type == EventType.TouchEnd

    me mark_handled():
        self.handled = true

fn _input_event(event_type: EventType, position: Point, timestamp: f64, modifiers: i64) -> InputEvent:
    InputEvent(event_type: event_type, position: position, timestamp: timestamp,
        modifiers: modifiers, key_code: 0, char_code: 0, touches: [],
        wheel_delta_x: 0.0, wheel_delta_y: 0.0, handled: false)

fn mouse_event(event_type: EventType, x: f64, y: f64, timestamp: f64, modifiers: i64) -> InputEvent:
    _input_event(event_type, Point(x: x, y: y), timestamp, modifiers)

fn key_event(event_type: EventType, key_code: i64, timestamp: f64, modifiers: i64) -> InputEvent:
    val event = _input_event(event_type, Point(x: 0.0, y: 0.0), timestamp, modifiers)
    event.key_code = key_code
    event
fn char_event(char_code: i64, timestamp: f64, modifiers: i64) -> InputEvent:
    val event = _input_event(EventType.Char, Point(x: 0.0, y: 0.0), timestamp, modifiers)
    event.char_code = char_code
    event

fn touch_point(id: i64, x: f64, y: f64) -> TouchPoint:
    TouchPoint(id: id, position: Point(x: x, y: y))

fn touch_event(event_type: EventType, touches: [TouchPoint], timestamp: f64) -> InputEvent:
    val event = _input_event(event_type, Point(x: 0.0, y: 0.0), timestamp, 0)
    event.touches = touches
    event

fn wheel_event(x: f64, y: f64, delta_x: f64, delta_y: f64, timestamp: f64, modifiers: i64) -> InputEvent:
    val event = _input_event(EventType.MouseWheel, Point(x: x, y: y), timestamp, modifiers)
    event.wheel_delta_x = delta_x
    event.wheel_delta_y = delta_y
    event
