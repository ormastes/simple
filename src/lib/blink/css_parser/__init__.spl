# Blink CSS parser — tokenizer stage.
#
# This package will eventually host the CSS parser proper (selector +
# declaration-block builder) and cascade/matching logic. Today it exports
# only the CSS Syntax Level 3 tokenizer, which the parser will call as
# its first pipeline stage.
#
# Consumer contract:
#   - `tokenize_css(source: String) -> [CssToken]`
#       Returns a token list terminated by a single CssToken(Eof, ...).
#       Whitespace is skipped; comments are emitted as Comment tokens.
#
# Exports mirror the Skia `sksl` package layout for consistency across
# Blink/Skia frontends.

# tokenizer.spl re-exports
export CssTokenKind, CssToken
export tokenize_css

# parser.spl re-exports
#   - `parse_css(tokens) -> CssStyleSheet` — a whole stylesheet.
#   - `parse_inline_style(source) -> CssDeclarationBlock` — a raw inline
#       `style="..."` attribute value, with the dropped-declaration errors.
#   - `blink_parse_declarations(source) -> [CssDeclaration]` — the same, errors
#       dropped. Cross-module callers MUST use this prefixed name; the
#       unprefixed `parse_declarations` alias collides by name with
#       `gc_async_mut.gpu.browser_engine.style_block_parse.parse_declarations`,
#       which returns a different `CssDecl` type.
#   - At-rules are parsed into `at_rules` / `keyframes` on the sheet and are
#       NOT evaluated here — `std.blink.style.at_rules` evaluates a prelude
#       against a media environment and a support registry.
export CssDeclaration, CssStyleRule, CssStyleSheet, CssDeclarationBlock
export CssAtRule, CssKeyframe, CssKeyframesRule
export parse_css, parse_inline_style, parse_declarations, blink_parse_declarations
