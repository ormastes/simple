# Blink ScrollManager — per-element scroll offset tracking and clamping.
#
# Provides: OverflowBehavior, ScrollableArea, ScrollManager,
#           scrollable_area_new, scroll_manager_new.

enum OverflowBehavior:
    Auto
    Hidden
    Scroll
    Visible

class ScrollableArea:
    element_id: i64
    viewport_width: f64
    viewport_height: f64
    content_width: f64
    content_height: f64
    scroll_x: f64
    scroll_y: f64
    overflow_x: OverflowBehavior
    overflow_y: OverflowBehavior

    fn max_scroll_x() -> f64:
        val diff = self.content_width - self.viewport_width
        if diff > 0.0: diff else: 0.0

    fn max_scroll_y() -> f64:
        val diff = self.content_height - self.viewport_height
        if diff > 0.0: diff else: 0.0

    fn can_scroll_x() -> bool:
        match self.overflow_x:
            case Hidden: false
            case Visible: false
            case Scroll: self.max_scroll_x() > 0.0
            case Auto: self.max_scroll_x() > 0.0

    fn can_scroll_y() -> bool:
        match self.overflow_y:
            case Hidden: false
            case Visible: false
            case Scroll: self.max_scroll_y() > 0.0
            case Auto: self.max_scroll_y() > 0.0

    me scroll_by(dx: f64, dy: f64):
        if me.can_scroll_x():
            var nx = me.scroll_x + dx
            if nx < 0.0:
                nx = 0.0
            val mx = me.max_scroll_x()
            if nx > mx:
                nx = mx
            me.scroll_x = nx
        if me.can_scroll_y():
            var ny = me.scroll_y + dy
            if ny < 0.0:
                ny = 0.0
            val my = me.max_scroll_y()
            if ny > my:
                ny = my
            me.scroll_y = ny

fn scrollable_area_new(element_id: i64, viewport_width: f64, viewport_height: f64, content_width: f64, content_height: f64) -> ScrollableArea:
    ScrollableArea(
        element_id: element_id,
        viewport_width: viewport_width,
        viewport_height: viewport_height,
        content_width: content_width,
        content_height: content_height,
        scroll_x: 0.0,
        scroll_y: 0.0,
        overflow_x: OverflowBehavior.Auto,
        overflow_y: OverflowBehavior.Auto
    )

class ScrollManager:
    areas: [ScrollableArea]

    me register(area: ScrollableArea):
        var i: i64 = 0
        while i < me.areas.len():
            if me.areas[i].element_id == area.element_id:
                me.areas[i] = area
                return
            i = i + 1
        me.areas.push(area)

    fn find_area(element_id: i64) -> ScrollableArea?:
        var i: i64 = 0
        while i < self.areas.len():
            if self.areas[i].element_id == element_id:
                return Some(self.areas[i])
            i = i + 1
        None

    me scroll_element(element_id: i64, dx: f64, dy: f64) -> bool:
        var i: i64 = 0
        while i < me.areas.len():
            if me.areas[i].element_id == element_id:
                me.areas[i].scroll_by(dx, dy)
                return true
            i = i + 1
        false

fn scroll_manager_new() -> ScrollManager:
    ScrollManager(areas: [])

export OverflowBehavior, ScrollableArea, ScrollManager
export scrollable_area_new, scroll_manager_new
