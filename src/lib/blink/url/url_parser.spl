# Blink URL parser — WHATWG absolute-URL subset (mirrors Chromium's url::GURL).
#
# Scope (deliberately narrow — this is what the consumers need today):
#   - absolute URLs only: `scheme://host[:port][/path][?query][#fragment]`
#   - percent-encode / percent-decode over UTF-8 octets (RFC 3986 §2.5)
#   - application/x-www-form-urlencoded query splitting
#
# Not in scope: relative-URL resolution, IPv6 literal hosts, userinfo,
# IDNA host normalisation, default-port substitution (`port` is 0 when the
# authority carries no explicit port).

# ============================================================================
# ParsedUrl — result of parse_url.
# ============================================================================

class ParsedUrl:
    scheme: text
    host: text
    port: i64
    path: text
    query: text
    fragment: text
    is_valid: bool

# ============================================================================
# Byte helpers
# ============================================================================

# _hex_value — value of one hex digit byte, or -1 when not a hex digit.
fn _hex_value(b: i64) -> i64:
    if b >= 48 and b <= 57:
        return b - 48
    if b >= 65 and b <= 70:
        return b - 55
    if b >= 97 and b <= 102:
        return b - 87
    -1

# _to_hex — two uppercase hex digits for one octet.
fn _to_hex(n: i64) -> text:
    val digits = "0123456789ABCDEF"
    var out = digits[n / 16]
    out = out + digits[n % 16]
    out

# _utf8_bytes_to_text — decode an octet sequence to text.
# Ill-formed octets become U+FFFD, matching "UTF-8 decode without BOM".
fn _utf8_bytes_to_text(bytes: [i64]) -> text:
    var out = ""
    val n = bytes.len()
    var i = 0
    while i < n:
        val b0 = bytes[i]
        var size = 0
        var acc = 0
        if b0 < 0x80:
            size = 1
            acc = b0
        if b0 >= 0xc2 and b0 <= 0xdf:
            size = 2
            acc = b0 & 0x1f
        if b0 >= 0xe0 and b0 <= 0xef:
            size = 3
            acc = b0 & 0x0f
        if b0 >= 0xf0 and b0 <= 0xf4:
            size = 4
            acc = b0 & 0x07

        var cp = -1
        if size == 1:
            cp = acc
        if size > 1 and i + size <= n:
            var ok = true
            var k = 1
            var value = acc
            while k < size:
                val bk = bytes[i + k]
                if bk < 0x80 or bk > 0xbf:
                    ok = false
                else:
                    value = (value << 6) | (bk & 0x3f)
                k = k + 1
            if ok:
                cp = value

        if cp < 0:
            out = out + "\u{FFFD}"
            i = i + 1
        else:
            out = out + cp.chr()
            i = i + size
    out

# ============================================================================
# Percent-encoding
# ============================================================================

# percent_decode — replace every `%XX` escape with the octet it names.
# A malformed escape is left literal. Octets are UTF-8-decoded once at the end.
fn percent_decode(encoded: text) -> text:
    val raw = encoded.bytes()
    val n = raw.len()
    var out: [i64] = []
    var i = 0
    while i < n:
        val b = (raw[i] as i64) & 0xff
        var consumed = 1
        if b == 37 and i + 2 < n:
            val h1 = _hex_value((raw[i + 1] as i64) & 0xff)
            val h2 = _hex_value((raw[i + 2] as i64) & 0xff)
            if h1 >= 0 and h2 >= 0:
                out.push(h1 * 16 + h2)
                consumed = 3
            else:
                out.push(b)
        else:
            out.push(b)
        i = i + consumed
    _utf8_bytes_to_text(out)

# percent_encode — percent-encode every UTF-8 octet of `input` whose byte value
# is not listed in `allowed`.
fn percent_encode(input: text, allowed: [i64]) -> text:
    val raw = input.bytes()
    val n = raw.len()
    var parts: [text] = []
    var i = 0
    while i < n:
        val b = (raw[i] as i64) & 0xff
        if _byte_allowed(b, allowed):
            parts.push(b.chr())
        else:
            parts.push("%" + _to_hex(b))
        i = i + 1
    parts.join("")

# _byte_allowed — membership test over the caller-supplied allow list.
fn _byte_allowed(b: i64, allowed: [i64]) -> bool:
    var i = 0
    while i < allowed.len():
        if allowed[i] == b:
            return true
        i = i + 1
    false

# ============================================================================
# Query strings
# ============================================================================

# query_string_parse — split an application/x-www-form-urlencoded string into
# (name, value) pairs. `+` means space; escapes are percent-decoded.
# A field with no `=` yields an empty value. Empty fields are skipped.
fn query_string_parse(query: text) -> [(text, text)]:
    var pairs: [(text, text)] = []
    if query.len() == 0:
        return pairs
    val fields = query.split("&")
    var i = 0
    while i < fields.len():
        val field = fields[i]
        if field.len() > 0:
            val eq = field.index_of("=")
            var name = field
            var value = ""
            if eq >= 0:
                name = field[0:eq]
                value = field[(eq + 1):field.len()]
            pairs.push((_form_decode(name), _form_decode(value)))
        i = i + 1
    pairs

# _form_decode — form-urlencoded field decoding: `+` to space, then escapes.
fn _form_decode(field: text) -> text:
    percent_decode(field.replace("+", " "))

# ============================================================================
# URL parsing
# ============================================================================

# _is_scheme_text — scheme must be ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ).
fn _is_scheme_text(s: text) -> bool:
    val raw = s.bytes()
    val n = raw.len()
    if n == 0:
        return false
    var i = 0
    while i < n:
        val b = (raw[i] as i64) & 0xff
        val alpha = (b >= 65 and b <= 90) or (b >= 97 and b <= 122)
        val digit = b >= 48 and b <= 57
        if i == 0:
            if not alpha:
                return false
        else:
            if not (alpha or digit or b == 43 or b == 45 or b == 46):
                return false
        i = i + 1
    true

# _invalid_url — the shape returned for anything this parser rejects.
fn _invalid_url() -> ParsedUrl:
    ParsedUrl(scheme: "", host: "", port: 0, path: "", query: "",
              fragment: "", is_valid: false)

# parse_url — parse an absolute URL into its components.
# Returns is_valid=false (and all components empty) when the input is not a
# well-formed absolute URL with a non-empty scheme and host.
fn parse_url(input: text) -> ParsedUrl:
    if input.len() == 0:
        return _invalid_url()

    val sep = input.index_of("://")
    if sep <= 0:
        return _invalid_url()

    val scheme = input[0:sep].to_lower()
    if not _is_scheme_text(scheme):
        return _invalid_url()

    var rest = input[(sep + 3):input.len()]

    # Fragment first — it terminates every earlier component.
    var fragment = ""
    val hash_at = rest.index_of("#")
    if hash_at >= 0:
        fragment = rest[(hash_at + 1):rest.len()]
        rest = rest[0:hash_at]

    var query = ""
    val q_at = rest.index_of("?")
    if q_at >= 0:
        query = rest[(q_at + 1):rest.len()]
        rest = rest[0:q_at]

    var path = ""
    val slash_at = rest.index_of("/")
    var authority = rest
    if slash_at >= 0:
        authority = rest[0:slash_at]
        path = rest[slash_at:rest.len()]
    if path.len() == 0:
        path = "/"

    var host = authority
    var port = 0
    val colon_at = authority.index_of(":")
    if colon_at >= 0:
        host = authority[0:colon_at]
        val port_text = authority[(colon_at + 1):authority.len()]
        if not _is_digits(port_text):
            return _invalid_url()
        port = port_text.to_i64()

    if host.len() == 0:
        return _invalid_url()

    ParsedUrl(scheme: scheme, host: host.to_lower(), port: port, path: path,
              query: query, fragment: fragment, is_valid: true)

# _is_digits — non-empty ASCII digit run.
fn _is_digits(s: text) -> bool:
    val raw = s.bytes()
    val n = raw.len()
    if n == 0:
        return false
    var i = 0
    while i < n:
        val b = (raw[i] as i64) & 0xff
        if b < 48 or b > 57:
            return false
        i = i + 1
    true
