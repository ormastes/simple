# Blink style→layout bridge — blink.layout.style_bridge
#
# This is the module that makes the blink render lane a PIPELINE rather than a
# set of isolated units. Everything either side of it already existed and was
# individually proven; nothing joined them:
#
#   CSS text -> tokenize_css -> parse_css -> CssStyleSheet          (css_parser)
#   HTML tokens -> build_html_tree -> DomTree                       (html_parser)
#   (DomTree, node, parent style, sheet) -> ComputedStyle           (style.cascade)
#   >>> THIS MODULE <<<
#   BoxGeometry / BlockFlowBox / LayoutContext -> computed rects    (layout.block_flow)
#
# The gap it closes is concrete: the cascade produces a `ComputedStyle` (a typed
# property bag with `Length` values and CSS units), while block-flow layout
# consumes a `BoxGeometry` (bare `f64` CSS pixels plus a `BoxModel` edge record).
# No function converted one into the other, and no walk turned a DomTree plus a
# stylesheet into a populated `LayoutContext`.
#
# Provides: geometry_from_style, StyledLayout, build_styled_layout.
#
# Deliberate non-goals (this is wiring, not a new layout engine):
#   - No paint and no rasterisation. The output is a laid-out box tree with
#     computed rects and the resolved styles that produced them; turning that
#     into pixels is a separate lane.
#   - No HTML string entry point: `blink.html_parser` has a tree builder but no
#     tokenizer yet, so callers supply either tokens or a DomTree directly.
#   - Only the box-model properties `ComputedStyle` models reach layout
#     (width/height, all four margins, left/top padding). Borders and
#     right/bottom padding are not CSS-settable yet, so they stay zero.
#   - Non-`px` units contribute zero, exactly as `Length.to_px` documents.
#   - `display: none` subtrees are skipped entirely, which is the one layout
#     decision this module makes; everything else is left to block_flow.

use std.blink.dom.node.{DomTree, DomNode, NodeType}
use std.blink.entity.computed_style.{ComputedStyle, Display, computed_style_default}
use std.blink.css_parser.parser.{CssStyleSheet}
use std.blink.style.cascade.{resolve_style}
use std.blink.layout.block_flow.{
    BoxGeometry, BlockFlowBox, LayoutContext,
    block_flow_box_new, layout_context_new
}
use std.common.layout.box_model.{BoxModel}

# Line-height multiplier used to turn a resolved `font-size` into a text box's
# height, absent any real font metrics (this lane has no glyph/font-metrics
# reachable — see the module doc below). 1.2 is the CSS `normal` line-height
# keyword's typical UA resolution (e.g. Chromium/Firefox default stylesheets),
# so a text box at least occupies the same vertical space a real line box
# would at that font-size, rather than an arbitrary unrelated constant.
val TEXT_LINE_HEIGHT_MULTIPLIER = 1.2

# Build the box a single text node contributes to its containing block.
#
# Deliberately minimal (first step, not a text engine — see module doc):
#   - Height: `parent_style.font_size.to_px() * TEXT_LINE_HEIGHT_MULTIPLIER`.
#     Text nodes have no ComputedStyle of their own (the cascade only resolves
#     Elements), so font-size is read off the *parent's* resolved style, which
#     is exactly CSS inheritance for `font-size`.
#   - Width: the containing block's own content width (`container_width`,
#     already resolved in px by the caller). A per-character average-width
#     approximation was considered and rejected: it would invent a pixel
#     metric with no font backing it, whereas "fills the line box" is what a
#     block-level container's inline content does by default in CSS, and it
#     needs no extra data this lane doesn't already have.
#   - No line breaking: one box regardless of text length or container width.
fn _text_box_geometry(parent_style: ComputedStyle, container_width: f64) -> BoxGeometry:
    """Return the minimal single-line box geometry for a text node's content."""
    BoxGeometry(
        width: container_width,
        height: parent_style.font_size.to_px() * TEXT_LINE_HEIGHT_MULTIPLIER,
        spacing: BoxModel.zero()
    )

# Convert one resolved style into the geometry block-flow layout consumes.
# Every value goes through `Length.to_px`, so an `em`/`%` length contributes 0
# rather than a silently wrong pixel count.
pub fn geometry_from_style(style: ComputedStyle) -> BoxGeometry:
    """Return the BoxGeometry described by `style`'s box-model properties."""
    BoxGeometry(
        width: style.width.to_px(),
        height: style.height.to_px(),
        spacing: BoxModel(
            margin_top: style.margin_top.to_px(),
            margin_right: style.margin_right.to_px(),
            margin_bottom: style.margin_bottom.to_px(),
            margin_left: style.margin_left.to_px(),
            padding_top: style.padding_top.to_px(),
            padding_right: 0.0,
            padding_bottom: 0.0,
            padding_left: style.padding_left.to_px(),
            border_top: 0.0,
            border_right: 0.0,
            border_bottom: 0.0,
            border_left: 0.0
        )
    )

# The result of one style+layout pass: the laid-out arena plus the resolved
# style for each node that produced a box, kept in parallel arrays so a caller
# can ask "what colour is the box for node N" after layout has run.
pub class StyledLayout:
    """A laid-out box tree together with the ComputedStyle behind each box."""
    context: LayoutContext
    node_ids: [i64]
    styles: [ComputedStyle]

impl StyledLayout:
    fn style_for(node_id: i64) -> ComputedStyle?:
        """Resolved style of the box generated by `node_id`; nil when it made none."""
        var i = 0
        while i < self.node_ids.len():
            if self.node_ids[i as i32] == node_id:
                return Some(self.styles[i as i32])
            i = i + 1
        nil

    fn rect_for(node_id: i64) -> (f64, f64, f64, f64)?:
        """Laid-out (left, top, right, bottom) of `node_id`'s box; nil when absent."""
        match self.context.get_box(node_id):
            Some(b):
                Some((b.computed_rect.left, b.computed_rect.top,
                      b.computed_rect.right, b.computed_rect.bottom))
            None:
                nil

# Run the whole style→layout half of the render lane for one document.
#
# Walks `tree` from its root, resolves each Element node against `sheet` with
# its parent's resolved style, converts the result to geometry, and lays the
# resulting arena out in a `viewport_width` x `viewport_height` viewport. A
# non-empty Text node generates a minimal single-line box (see
# `_text_box_geometry` — no line breaking, no real font metrics); comment
# nodes still generate no box. The first element child of the document
# becomes the layout root.
pub fn build_styled_layout(
    tree: DomTree,
    sheet: CssStyleSheet,
    viewport_width: f64,
    viewport_height: f64
) -> StyledLayout:
    """Resolve styles across `tree` under `sheet` and lay the result out."""
    var ctx = layout_context_new(viewport_width, viewport_height)
    var node_ids: [i64] = []
    var styles: [ComputedStyle] = []

    # Explicit work stack of (node id, that node's parent style). Depth-first so
    # a child is always resolved after the parent whose style it inherits.
    var stack_ids: [i64] = []
    var stack_styles: [ComputedStyle] = []
    val root_style = computed_style_default()

    # Seed with the document root's element children.
    match tree.get_node(tree.root_id):
        Some(doc):
            var cid = doc.first_child
            while cid >= 0:
                stack_ids.push(cid)
                stack_styles.push(root_style)
                match tree.get_node(cid):
                    Some(c):
                        cid = c.next_sibling
                    None:
                        cid = -1
        None:
            pass_do_nothing()

    var layout_root = -1
    var si = 0
    while si < stack_ids.len():
        val nid = stack_ids[si as i32]
        val parent_style = stack_styles[si as i32]
        si = si + 1
        match tree.get_node(nid):
            Some(node):
                if node.node_type == NodeType.Element:
                    val style = resolve_style(tree, nid, parent_style, sheet)
                    if style.display != Display.None:
                        var box = block_flow_box_new(nid, geometry_from_style(style))
                        var kids: [i64] = []
                        var cid2 = node.first_child
                        while cid2 >= 0:
                            match tree.get_node(cid2):
                                Some(c2):
                                    if c2.node_type == NodeType.Element:
                                        kids.push(cid2)
                                        stack_ids.push(cid2)
                                        stack_styles.push(style)
                                    elif c2.node_type == NodeType.Text:
                                        # Text nodes generate a box directly here
                                        # (not via the work stack): they never
                                        # get their own cascade pass, so there is
                                        # nothing for the stack's Element branch
                                        # above to resolve for them.
                                        if c2.text_content.len() > 0:
                                            var tbox = block_flow_box_new(
                                                cid2,
                                                _text_box_geometry(style, box.geometry.width)
                                            )
                                            ctx.add_box(tbox)
                                            kids.push(cid2)
                                            node_ids.push(cid2)
                                            styles.push(style)
                                    cid2 = c2.next_sibling
                                None:
                                    cid2 = -1
                        box.children_ids = kids
                        ctx.add_box(box)
                        node_ids.push(nid)
                        styles.push(style)
                        if layout_root < 0:
                            layout_root = nid
            None:
                pass_do_nothing()

    # A `display: none` root leaves the arena empty; compute_layout no-ops then.
    ctx.set_root(layout_root)
    ctx.compute_layout()
    StyledLayout(context: ctx, node_ids: node_ids, styles: styles)
