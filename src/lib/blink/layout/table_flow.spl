# Blink table layout — blink.layout.table_flow
#
# This closes the table half of blocker 7 in
# doc/03_plan/ui/rendering/blink_wiring_plan.md.
#
# The ALGORITHM is not here. It lives in `common/layout/table_grid.spl`, which
# both blink and the live browser lane may import — blink is a LEAF (`blink`,
# `skia`, `common` only) so the live `layout_table.spl` is unreachable from it,
# and copying that file in would have grown the duplicate family the wiring
# plan exists to shrink. This module is the blink-shaped face: it takes cells
# whose text has been measured by `layout/inline_text.spl` (so widths are
# codepoint-correct, not `text.len()` UTF-8 bytes — see
# doc/08_tracking/bug/live_lane_inline_text_measure_counts_utf8_bytes_2026-08-11.md),
# asks `table_grid` to resolve the grid, and returns `SkRect`s.
#
# WHAT THIS ADDS OVER THE LIVE LANE
#
# `layout_table.spl:111 _compute_col_widths` divides the table width equally
# between columns and ignores content entirely. Here, `table-layout: auto` (the
# CSS default and what an unstyled `<table>` gets) sizes columns by their
# measured content, so a narrow column beside a wide one no longer takes half
# the table. `fixed_layout: true` still gives the equal division, which is the
# correct answer for `table-layout: fixed`.
#
# NOT MODELLED — inherited from `common/layout/table_grid.spl`, restated here so
# a caller reading only this file is not misled: no rowspan height
# redistribution, no `border-collapse: collapse`, no percentage or explicit
# column widths, no `<col>`, no caption, no vertical-align. Cell CONTENT is not
# laid out — this positions the cell boxes and the caller fills them.

use std.skia.entity.geometry.{SkRect}
use std.common.layout.table_grid.{
    TableCellSpec, TableGrid, table_cell, table_cell_spanning,
    resolve_table_grid, column_min_widths, column_max_widths
}
use std.blink.layout.inline_text.{InlineFont, inline_text_advance_width, layout_inline_text}

struct TableCellText:
    """A cell holding a single text run, before measurement."""
    row: i64
    col: i64
    colspan: i64
    rowspan: i64
    content: text

fn table_cell_text(row: i64, col: i64, content: text) -> TableCellText:
    """A 1x1 cell at (row, col) holding `content`."""
    TableCellText(row: row, col: col, colspan: 1, rowspan: 1, content: content)

fn table_cell_text_spanning(row: i64, col: i64, colspan: i64, rowspan: i64, content: text) -> TableCellText:
    """A spanning cell at (row, col) holding `content`."""
    TableCellText(row: row, col: col, colspan: colspan, rowspan: rowspan, content: content)

fn _longest_word_width(content: text, f: InlineFont) -> i64:
    """Width of the widest single space-separated word in `content`.

    This is the cell's minimum content width: a column can be squeezed until
    its longest unbreakable word just fits, and no narrower."""
    val words = content.split(" ")
    var widest: i64 = 0
    var i: i64 = 0
    while i < words.len():
        val w = inline_text_advance_width(words[i as i32], f)
        if w > widest:
            widest = w
        i = i + 1
    widest

fn measure_table_cells(cells: [TableCellText], f: InlineFont) -> [TableCellSpec]:
    """Measure each cell's intrinsic widths and one-line height.

    `min_width` is the widest word (the narrowest the cell may be squeezed to),
    `max_width` is the whole run on one line (its preferred width), and
    `content_height` is one line box — the height a cell needs BEFORE the
    column widths are known. `measure_table_cell_heights` re-measures once they
    are, which is when wrapping can actually be computed.

    Measurement goes through `layout/inline_text.spl`, so it counts Unicode
    codepoints and CJK double-width cells rather than UTF-8 bytes."""
    var out: [TableCellSpec] = []
    var i: i64 = 0
    while i < cells.len():
        val c = cells[i as i32]
        val pref = inline_text_advance_width(c.content, f)
        val minw = _longest_word_width(c.content, f)
        val one_line = layout_inline_text(c.content, pref + 1, f)
        out.push(TableCellSpec(
            row: c.row,
            col: c.col,
            colspan: c.colspan,
            rowspan: c.rowspan,
            min_width: minw as f64,
            max_width: pref as f64,
            content_height: one_line.height_px as f64
        ))
        i = i + 1
    out

fn layout_table(
    cells: [TableCellText],
    num_cols: i64,
    num_rows: i64,
    available_width: f64,
    border_spacing: f64,
    fixed_layout: bool,
    f: InlineFont
) -> TableGrid:
    """Resolve a text table's grid in two passes.

    Pass one measures every cell unwrapped and resolves the column widths from
    those intrinsic sizes. Pass two re-wraps each cell to the width its column
    actually received — a cell squeezed narrower than its preferred width takes
    more lines and so is taller — and re-resolves so the row heights reflect
    the wrapping. The column widths do not change between the passes because
    they were already derived from min/max content widths, which wrapping does
    not alter.

    Two passes is the minimum that can be correct: a single pass would size
    rows for unwrapped text and clip every wrapped cell."""
    val first = measure_table_cells(cells, f)
    val grid = resolve_table_grid(first, num_cols, num_rows, available_width, border_spacing, fixed_layout)

    var second: [TableCellSpec] = []
    var i: i64 = 0
    while i < cells.len():
        val c = cells[i as i32]
        val spec = first[i as i32]
        var col_w = grid.cell_width(c.col, c.colspan)
        if col_w < 1.0:
            col_w = 1.0
        val wrapped = layout_inline_text(c.content, col_w as i64, f)
        second.push(TableCellSpec(
            row: spec.row,
            col: spec.col,
            colspan: spec.colspan,
            rowspan: spec.rowspan,
            min_width: spec.min_width,
            max_width: spec.max_width,
            content_height: wrapped.height_px as f64
        ))
        i = i + 1

    resolve_table_grid(second, num_cols, num_rows, available_width, border_spacing, fixed_layout)

fn table_cell_rect(grid: TableGrid, origin_x: f64, origin_y: f64, row: i64, col: i64, colspan: i64, rowspan: i64) -> SkRect:
    """The rect of one cell, in the coordinates of a table whose content box
    starts at (`origin_x`, `origin_y`)."""
    val x = origin_x + grid.cell_x(col)
    val y = origin_y + grid.cell_y(row)
    SkRect(
        left: x,
        top: y,
        right: x + grid.cell_width(col, colspan),
        bottom: y + grid.cell_height(row, rowspan)
    )

fn table_rect(grid: TableGrid, origin_x: f64, origin_y: f64) -> SkRect:
    """The whole table's content box rect."""
    SkRect(
        left: origin_x,
        top: origin_y,
        right: origin_x + grid.width,
        bottom: origin_y + grid.height
    )
