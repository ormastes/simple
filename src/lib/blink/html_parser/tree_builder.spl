# Blink HTML tree builder — blink.html_parser.tree_builder
#
# Mirrors Chromium Blink's HTMLTreeBuilder (html_tree_builder.h) in
# reduced form: a stack of open elements drives the insertion point;
# tokens are appended into the arena DomTree from blink.dom.node.
#
# Deliberately NOT implemented (out of scope for the current spec):
# insertion modes ("before html", "in body", ...), implied tag synthesis
# (html/head/body), the adoption agency algorithm, foster parenting,
# active formatting elements, and doctype -> DocumentType node emission.
# Doctype tokens are ignored; mis-nested end tags pop to the nearest
# matching open element and are otherwise dropped.

use std.blink.dom.node.{NodeType, DomTree, dom_node_new, dom_tree_new}
use std.blink.html_parser.token.{HtmlToken, HtmlTokenKind}

fn is_void_element(name: text) -> bool:
    """HTML void elements never take children (WHATWG 13.1.2 subset)."""
    (name == "area" or name == "base" or name == "br" or name == "col" or
     name == "embed" or name == "hr" or name == "img" or name == "input" or
     name == "link" or name == "meta" or name == "source" or
     name == "track" or name == "wbr")

fn build_html_tree(tokens: [HtmlToken]) -> DomTree:
    """Build a DomTree from an HTML token stream (root DocumentNode at id 0)."""
    var tree = dom_tree_new()
    # Stack of open elements (Chromium HTMLElementStack); top is the
    # current insertion point, root when empty.
    var open_elements: [i64] = []
    for token in tokens:
        val current = if open_elements.len() > 0:
            open_elements[open_elements.len() - 1]
        else:
            tree.root_id
        match token.kind:
            HtmlTokenKind.StartTag:
                val id = tree.create_element(token.name)
                var i = 0
                while i < token.attributes.len():
                    tree.set_attribute(id, token.attributes[i].name, token.attributes[i].value)
                    i = i + 1
                tree.append_child(current, id)
                if not token.self_closing and not is_void_element(token.name):
                    open_elements.push(id)
            HtmlTokenKind.EndTag:
                # Pop up to and including the nearest matching open element;
                # unmatched end tags are dropped (no adoption agency).
                var depth = open_elements.len() - 1
                var found = -1
                while depth >= 0:
                    val nid = open_elements[depth]
                    match tree.get_node(nid):
                        Some(n):
                            if n.tag_name == token.name:
                                found = depth
                                depth = -1
                            else:
                                depth = depth - 1
                        None:
                            depth = depth - 1
                if found >= 0:
                    while open_elements.len() > found:
                        open_elements.pop()
            HtmlTokenKind.Character:
                val tid = tree.create_text(token.data)
                tree.append_child(current, tid)
            HtmlTokenKind.Comment:
                val cid = tree.nodes.len().to_i64()
                var cnode = dom_node_new(cid, NodeType.Comment)
                cnode.text_content = token.data
                tree.nodes.push(cnode)
                tree.append_child(current, cid)
            HtmlTokenKind.Doctype:
                pass_do_nothing()
            HtmlTokenKind.Eof:
                pass_do_nothing()
    tree
