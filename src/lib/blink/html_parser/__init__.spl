# Blink HTML parser — token types + tokenizer + tree builder.
#
# Pipeline: tokenize_html (tokenizer.spl) produces [HtmlToken];
# build_html_tree (tree_builder.spl) consumes them into a blink.dom.node
# DomTree. Layout mirrors css_parser/ and Chromium's core/html/parser/
# package.
#
# Consumer contract:
#   - `tokenize_html(html: text) -> [HtmlToken]`
#       Always ends in an Eof token.
#   - `build_html_tree(tokens: [HtmlToken]) -> DomTree`
#       Root DocumentNode is always id 0. Eof/Doctype tokens are ignored.

# token.spl re-exports
export HtmlTokenKind, HtmlAttribute, HtmlToken

# tokenizer.spl re-exports
export tokenize_html

# tree_builder.spl re-exports
export build_html_tree
