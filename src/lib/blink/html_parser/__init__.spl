# Blink HTML parser — token types + tree builder.
#
# Pipeline: tokenize_html (tokenizer.spl, NOT YET IMPLEMENTED) produces
# [HtmlToken]; build_html_tree (tree_builder.spl) consumes them into a
# blink.dom.node DomTree. Layout mirrors css_parser/ and Chromium's
# core/html/parser/ package.
#
# Consumer contract:
#   - `build_html_tree(tokens: [HtmlToken]) -> DomTree`
#       Root DocumentNode is always id 0. Eof/Doctype tokens are ignored.

# token.spl re-exports
export HtmlTokenKind, HtmlAttribute, HtmlToken

# tree_builder.spl re-exports
export build_html_tree
