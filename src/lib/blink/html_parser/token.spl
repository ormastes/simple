# Blink HTML parser tokens — blink.html_parser.token
#
# Mirrors Chromium Blink's HTMLToken (html_token.h): a flat token record
# with a kind discriminant, tag name, character/comment data, attribute
# list, and self-closing flag. Consumed by tokenizer.spl (producer, not
# yet implemented) and tree_builder.spl (consumer).

enum HtmlTokenKind:
    """HTMLToken::TokenType discriminants (Chromium kStartTag et al.)."""
    Doctype
    StartTag
    EndTag
    Comment
    Character
    Eof

struct HtmlAttribute:
    """A single tokenized attribute name-value pair."""
    name: text
    value: text

struct HtmlToken:
    """One HTML token: kind + name (tags), data (text/comments), attributes."""
    kind: HtmlTokenKind
    name: text
    data: text
    attributes: [HtmlAttribute]
    self_closing: bool
