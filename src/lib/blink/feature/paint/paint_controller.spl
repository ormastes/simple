# Blink PaintController — groups recorded DisplayItems into PaintChunks
# whenever PaintChunkProperties change.
#
# Provides: PaintController.

use std.blink.entity.paint_artifact.{PaintChunkProperties, PaintChunk, PaintArtifact}
use std.common.render_scene.paint_types.{DisplayItem}

class PaintController:
    items: [DisplayItem]
    chunks: [PaintChunk]
    current_props: PaintChunkProperties
    chunk_start: i64

    static fn new() -> PaintController:
        PaintController(
            items: [],
            chunks: [],
            current_props: PaintChunkProperties.root(),
            chunk_start: 0
        )

    me _flush_chunk():
        val end_idx = me.items.len()
        if end_idx > me.chunk_start:
            me.chunks.push(PaintChunk.create(me.chunk_start, end_idx, me.current_props))
            me.chunk_start = end_idx

    me update_properties(props: PaintChunkProperties):
        if not me.current_props.equals(props):
            me._flush_chunk()
            me.current_props = props

    me record_item(item: DisplayItem):
        me.items.push(item)

    me commit() -> PaintArtifact:
        me._flush_chunk()
        if me.items.len() == 0:
            return PaintArtifact.empty()
        PaintArtifact.create(me.items, me.chunks)

export PaintController
