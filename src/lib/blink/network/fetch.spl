# Blink Network Fetch — local file:// and scheme validation helper.
#
# Provides: FetchResponse, fetch_text.

use std.io_runtime.{file_exists, file_read}
use std.blink.url.url_parser.{parse_url}

class FetchResponse:
    status: i64
    body: text
    content_type: text

fn _content_type_for_path(path: text) -> text:
    if path.ends_with(".html") or path.ends_with(".htm"):
        return "text/html"
    if path.ends_with(".css"):
        return "text/css"
    if path.ends_with(".js"):
        return "application/javascript"
    if path.ends_with(".json"):
        return "application/json"
    "text/plain"

fn fetch_text(url_str: text) -> Result<FetchResponse, text>:
    if url_str.len() == 0:
        return Err("invalid URL: empty")

    if url_str.starts_with("file://"):
        val path = url_str[7:url_str.len()]
        if path.len() == 0:
            return Err("invalid file URL: empty path")
        if not file_exists(path):
            return Err("file not found: {path}")
        val body = file_read(path)
        return Ok(FetchResponse(
            status: 200,
            body: body,
            content_type: _content_type_for_path(path)
        ))

    val parsed = parse_url(url_str)
    if not parsed.is_valid:
        return Err("invalid URL: {url_str}")

    if parsed.scheme == "http" or parsed.scheme == "https":
        return Err("network fetch unavailable in offline mode for {parsed.scheme}")

    Err("unsupported scheme: {parsed.scheme}")

export FetchResponse, fetch_text
