# str_search_pure.spl — pure-Simple twins for the byte-oriented string search
# runtime symbols, written for the rt_* dual-implementation directive
# ("rt should be written in C and Simple, and use alias, and intensive tests").
#
# Pairs (see test/01_unit/lib/common/spec/dual_run_shadow_spec.spl):
#   str_ends_with      <-> rt_string_ends_with
#   str_last_index_of  <-> rt_string_rfind
#
# Both oracles work in BYTES, not characters:
#   * rt_string_ends_with is a memcmp tail test in the C runtime
#     (src/runtime/runtime_native.c) and `s.as_bytes().ends_with(...)` in the
#     Rust lane (interpreter_extern/sffi_string.rs:138).
#   * rt_string_rfind returns the last BYTE index, -1 when absent, and — this
#     is contractual, not incidental — the subject's BYTE LENGTH for an EMPTY
#     needle (sffi_string.rs:155).
#
# These twins therefore scan `.bytes()` and never index text with `[]`:
# `text.len()` is bytes but `text[i]` is CHARACTERS, so a `while i < s.len()`
# + `s[i]` scanner silently misbehaves on non-ASCII input. Every case in the
# dual-run spec includes multi-byte input for exactly that reason.

fn _bytes_equal_at(hay: [i64], needle: [i64], at: i64) -> bool:
    var j = 0
    var same = true
    while j < needle.len():
        if hay[at + j] != needle[j]:
            same = false
            j = needle.len()
        else:
            j = j + 1
    same

pub fn str_ends_with(s: text, suffix: text) -> bool:
    val hay = s.bytes()
    val tail = suffix.bytes()
    if tail.len() > hay.len():
        return false
    _bytes_equal_at(hay, tail, hay.len() - tail.len())

pub fn str_last_index_of(s: text, needle: text) -> i64:
    val hay = s.bytes()
    val pat = needle.bytes()
    # Contractual: an empty needle answers the subject's byte length, matching
    # the C runtime and the Rust lane. Returning 0 here would be a divergence.
    if pat.len() == 0:
        return hay.len()
    if pat.len() > hay.len():
        return -1
    var at = hay.len() - pat.len()
    var found = -1
    while at >= 0 and found < 0:
        if _bytes_equal_at(hay, pat, at):
            found = at
        at = at - 1
    found

# Pure-Simple twin for rt_simd_str_search (C kernel
# src/runtime/runtime_simd_dispatch.c, interpreter bridge
# interpreter_extern/simd.rs). Returns the FIRST byte index at which `needle`
# occurs in `s`, or -1 when it does not occur.
#
# Contract pinned by direct measurement against the oracle, not assumed:
# an empty needle answers 0 (NOT the subject's byte length — that is
# rt_string_rfind's contract, and getting the two confused is exactly the
# kind of divergence this twin exists to catch); an empty subject with a
# non-empty needle answers -1; both empty answers 0; a needle longer than
# the subject answers -1. Overlapping candidates resolve to the leftmost
# match. Scans `.bytes()` for the same reason the twins above do: `text.len()`
# is bytes but `text[i]` is characters.
pub fn str_first_index_of(s: text, needle: text) -> i64:
    val hay = s.bytes()
    val pat = needle.bytes()
    if pat.len() == 0:
        return 0
    if pat.len() > hay.len():
        return -1
    var at = 0
    var found = -1
    val last = hay.len() - pat.len()
    while at <= last and found < 0:
        if _bytes_equal_at(hay, pat, at):
            found = at
        at = at + 1
    found
