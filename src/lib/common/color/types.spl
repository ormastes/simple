# Source-backed color primitives used by browser paint and raster paths.

pub class Color:
    r: i64
    g: i64
    b: i64
    a: i64

    fn to_string(self) -> text:
        "rgba({self.r},{self.g},{self.b},{self.a})"

    # --- packed-u32 adapters -------------------------------------------
    #
    # The browser lanes carry colour as a packed `u32`, and they do NOT agree
    # on the byte order: `gpu/browser_engine/dom_color.spl` packs 0xRRGGBBAA,
    # while `simple_web_css_box_effects.spl`, `simple_web_engine2d_renderer.spl`
    # and `simple_web_html_layout_renderer_foundation.spl` (`argb()`) pack
    # 0xAARRGGBB. A single unnamed `to_u32()` would silently channel-swap half
    # of them, so both orders are spelled out and a caller must pick one.
    #
    # There is deliberately NO `to_u32()` on `Color?` that substitutes a colour
    # for nil. `nil` means "this module does not understand that syntax"; a
    # helper that turned it into opaque black would paint a wrong pixel that no
    # smoke test can see. Callers unwrap explicitly and decide what a failure
    # means for them (CSS says: drop the declaration).

    fn to_argb_u32(self) -> u32:
        """Pack as 0xAARRGGBB — the `argb()`/box-effects/engine2d convention."""
        (
            (self.a.to_u32() << 24) | (self.r.to_u32() << 16) |
            (self.g.to_u32() << 8) | self.b.to_u32()
        )

    fn to_rgba_u32(self) -> u32:
        """Pack as 0xRRGGBBAA — the `dom_color.spl` convention."""
        (
            (self.r.to_u32() << 24) | (self.g.to_u32() << 16) |
            (self.b.to_u32() << 8) | self.a.to_u32()
        )

fn _clamp_byte(value: i64) -> i64:
    if value < 0:
        return 0
    if value > 255:
        return 255
    value

pub fn from_rgba(r: i64, g: i64, b: i64, a: i64) -> Color:
    Color(r: _clamp_byte(r), g: _clamp_byte(g), b: _clamp_byte(b), a: _clamp_byte(a))

pub fn from_rgb(r: i64, g: i64, b: i64) -> Color:
    from_rgba(r, g, b, 255)

pub fn black() -> Color:
    from_rgb(0, 0, 0)

pub fn white() -> Color:
    from_rgb(255, 255, 255)

pub fn transparent() -> Color:
    from_rgba(0, 0, 0, 0)
