    if n == "coral": return from_rgba(255, 127, 80, 255)
    if n == "cornflowerblue": return from_rgba(100, 149, 237, 255)
    if n == "cornsilk": return from_rgba(255, 248, 220, 255)
    if n == "crimson": return from_rgba(220, 20, 60, 255)
    if n == "darkblue": return from_rgba(0, 0, 139, 255)
    if n == "darkcyan": return from_rgba(0, 139, 139, 255)
    if n == "darkgoldenrod": return from_rgba(184, 134, 11, 255)
    if n == "darkgray" or n == "darkgrey": return from_rgba(169, 169, 169, 255)
    if n == "darkgreen": return from_rgba(0, 100, 0, 255)
    if n == "darkkhaki": return from_rgba(189, 183, 107, 255)
    if n == "darkmagenta": return from_rgba(139, 0, 139, 255)
    if n == "darkolivegreen": return from_rgba(85, 107, 47, 255)
    if n == "darkorange": return from_rgba(255, 140, 0, 255)
    if n == "darkorchid": return from_rgba(153, 50, 204, 255)
    if n == "darkred": return from_rgba(139, 0, 0, 255)
    if n == "darksalmon": return from_rgba(233, 150, 122, 255)
    if n == "darkseagreen": return from_rgba(143, 188, 143, 255)
    if n == "darkslateblue": return from_rgba(72, 61, 139, 255)
    if n == "darkslategray" or n == "darkslategrey": return from_rgba(47, 79, 79, 255)
