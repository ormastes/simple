# Shared CSS colour parsing — the one home for turning CSS colour syntax into
# `common.color.types.Color`.
#
# Provides: named_color, parse_hex_color, parse_css_color.
#
# Every entry point returns `Color?`. A value this module does not understand
# is `nil`, never a substituted colour: a caller that silently swapped in black
# would paint a wrong pixel that no smoke test can see. Callers decide what an
# unparsable colour means for them (CSS says: drop the declaration).
#
# This module exists so the parsing lives in ONE place. `common` is importable
# from every lane, including leaf lanes such as `blink` that may not reach into
# `gc_async_mut`. Extend this table rather than starting a private copy.
#
# Coverage: the CSS Level 4 named-colour table (148 names including the `grey`
# and `aqua`/`fuchsia` aliases and `transparent`), `#RGB`/`#RGBA`/`#RRGGBB`/
# `#RRGGBBAA`, `rgb()`/`rgba()` and `hsl()`/`hsla()` in both the legacy
# comma-separated and the modern space-separated `/ alpha` forms, with
# percentage channels.
#
# Not covered (returns nil, on purpose): `currentColor`, `color()`, `lab()`,
# `lch()`, `oklab()`, `oklch()`, `hwb()`, `color-mix()`, `var()`, `calc()`.

use std.common.color.types.{Color, from_rgba}
use std.common.color.convert.{hsl_to_rgb}

# ============================================================================
# Named colours
# ============================================================================

pub fn named_color(name: text) -> Color?:
    """Return the CSS named colour `name` denotes, or nil when it is not one."""
    val n = name.to_lower()
    if n == "black": return from_rgba(0, 0, 0, 255)
    if n == "white": return from_rgba(255, 255, 255, 255)
    if n == "red": return from_rgba(255, 0, 0, 255)
    if n == "green": return from_rgba(0, 128, 0, 255)
    if n == "blue": return from_rgba(0, 0, 255, 255)
    if n == "transparent": return from_rgba(0, 0, 0, 0)
    if n == "yellow": return from_rgba(255, 255, 0, 255)
    if n == "orange": return from_rgba(255, 165, 0, 255)
    if n == "gray" or n == "grey": return from_rgba(128, 128, 128, 255)
    if n == "cyan" or n == "aqua": return from_rgba(0, 255, 255, 255)
    if n == "magenta" or n == "fuchsia": return from_rgba(255, 0, 255, 255)
    if n == "silver": return from_rgba(192, 192, 192, 255)
    if n == "maroon": return from_rgba(128, 0, 0, 255)
    if n == "olive": return from_rgba(128, 128, 0, 255)
    if n == "navy": return from_rgba(0, 0, 128, 255)
    if n == "teal": return from_rgba(0, 128, 128, 255)
    if n == "purple": return from_rgba(128, 0, 128, 255)
    if n == "lime": return from_rgba(0, 255, 0, 255)
    if n == "aliceblue": return from_rgba(240, 248, 255, 255)
    if n == "antiquewhite": return from_rgba(250, 235, 215, 255)
    if n == "aquamarine": return from_rgba(127, 255, 212, 255)
    if n == "azure": return from_rgba(240, 255, 255, 255)
