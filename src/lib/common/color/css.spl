# ============================================================================
# Hex notation
# ============================================================================

# One hex digit's value, or -1 when `c` is not a hex digit.
fn _hex_digit(c: text) -> i64:
    val table = "0123456789abcdef"
    val lowered = c.to_lower()
    var i = 0
    while i < 16:
        if table.slice(i, i + 1) == lowered:
            return i
        i = i + 1
    -1

# Two hex characters as one 0..255 byte, or -1 when either is not hex.
fn _hex_byte(s: text, at: i64) -> i64:
    val hi = _hex_digit(s.slice(at, at + 1))
    val lo = _hex_digit(s.slice(at + 1, at + 2))
    if hi < 0 or lo < 0:
        return -1
    hi * 16 + lo

# One hex character doubled into a 0..255 byte (`f` is `ff`), or -1.
fn _hex_nibble(s: text, at: i64) -> i64:
    val v = _hex_digit(s.slice(at, at + 1))
    if v < 0:
        return -1
    v * 17

pub fn parse_hex_color(raw: text) -> Color?:
    """Return the colour `raw` denotes in #RGB/#RGBA/#RRGGBB/#RRGGBBAA form, else nil."""
    val trimmed: text = raw.trim()
    val s: text = trimmed.to_lower()
    if not s.starts_with("#"):
        return nil
    if s.len() == 4:
        val r3 = _hex_nibble(s, 1)
        val g3 = _hex_nibble(s, 2)
        val b3 = _hex_nibble(s, 3)
        if r3 < 0 or g3 < 0 or b3 < 0:
            return nil
        return from_rgba(r3, g3, b3, 255)
    if s.len() == 5:
        val r4 = _hex_nibble(s, 1)
        val g4 = _hex_nibble(s, 2)
        val b4 = _hex_nibble(s, 3)
        val a4 = _hex_nibble(s, 4)
        if r4 < 0 or g4 < 0 or b4 < 0 or a4 < 0:
            return nil
        return from_rgba(r4, g4, b4, a4)
    if s.len() == 7:
        val r6 = _hex_byte(s, 1)
        val g6 = _hex_byte(s, 3)
        val b6 = _hex_byte(s, 5)
        if r6 < 0 or g6 < 0 or b6 < 0:
            return nil
        return from_rgba(r6, g6, b6, 255)
    if s.len() == 9:
        val r8 = _hex_byte(s, 1)
        val g8 = _hex_byte(s, 3)
        val b8 = _hex_byte(s, 5)
        val a8 = _hex_byte(s, 7)
        if r8 < 0 or g8 < 0 or b8 < 0 or a8 < 0:
            return nil
        return from_rgba(r8, g8, b8, a8)
    nil

# ============================================================================
# Numeric arguments
# ============================================================================

# True when `s` is a plain decimal number. `to_f64()` answers 0.0 for garbage,
# so every argument is checked for shape BEFORE it is converted — otherwise
# `rgb(red, 0, 0)` would parse as a valid black.
fn _is_number(s: text) -> bool:
    if s.len() == 0:
        return false
    var digits = 0
    var dots = 0
    var i = 0
    while i < s.len():
        val c = s.slice(i, i + 1)
        if c == "+" or c == "-":
            if i != 0:
                return false
        elif c == ".":
            dots = dots + 1
            if dots > 1:
                return false
        else:
            val code = s.char_code_at(i)
            if code < 48 or code > 57:
                return false
            digits = digits + 1
        i = i + 1
    digits > 0

fn _round_i64(v: f64) -> i64:
    if v < 0.0:
        return (v - 0.5) as i64
    (v + 0.5) as i64

fn _clamp(v: i64, lo: i64, hi: i64) -> i64:
    if v < lo:
        return lo
    if v > hi:
        return hi
    v

# Strip one trailing unit (`%`, `deg`) and report whether it was there.
fn _strip_suffix(s: text, suffix: text) -> text:
    if s.ends_with(suffix):
        return s.slice(0, s.len() - suffix.len())
    s

# An rgb() colour channel: `0..255`, or a percentage of 255. -1 on a bad token.
fn _rgb_channel(part: text) -> i64:
    val s: text = part.trim()
    if s.ends_with("%"):
        val body: text = _strip_suffix(s, "%")
        if not _is_number(body):
            return -1
        val pct = body.to_f64()
        return _clamp(_round_i64(pct * 255.0 / 100.0), 0, 255)
    if not _is_number(s):
        return -1
    val n = s.to_f64()
    _clamp(_round_i64(n), 0, 255)

# An alpha argument: `0..1`, or a percentage. -1 on a bad token.
fn _alpha_channel(part: text) -> i64:
    val s: text = part.trim()
    if s.ends_with("%"):
        val body: text = _strip_suffix(s, "%")
        if not _is_number(body):
            return -1
        val pct = body.to_f64()
        return _clamp(_round_i64(pct * 255.0 / 100.0), 0, 255)
    if not _is_number(s):
        return -1
    val n = s.to_f64()
    _clamp(_round_i64(n * 255.0), 0, 255)

# A percentage argument scaled to 0..100 (hsl saturation/lightness). -1 on a
# bad token. The `%` is required by CSS for these two.
fn _percent_arg(part: text) -> i64:
    val s: text = part.trim()
    if not s.ends_with("%"):
        return -1
    val body: text = _strip_suffix(s, "%")
    if not _is_number(body):
        return -1
    _clamp(_round_i64(body.to_f64()), 0, 100)

# A hue argument in degrees, normalised to 0..359. -1 on a bad token.
fn _hue_arg(part: text) -> i64:
    val trimmed: text = part.trim()
    val s: text = _strip_suffix(trimmed, "deg")
    if not _is_number(s):
        return -1
    var h = _round_i64(s.to_f64()) % 360
    if h < 0:
        h = h + 360
    h

# ============================================================================
# Functional notation
# ============================================================================

# Split the inside of a colour function into its arguments. Returns nil when
# the argument list is malformed. Both CSS forms are accepted:
#   legacy: `a, b, c` / `a, b, c, alpha`
#   modern: `a b c` / `a b c / alpha`
# Mixing them (a comma list with a `/`) is invalid, as is a trailing comma.
fn _split_args(inner_raw: text) -> [text]?:
    val inner: text = inner_raw.trim()
    if inner.len() == 0:
        return nil
    var has_comma = false
    var has_slash = false
    var i = 0
    while i < inner.len():
        val c = inner.slice(i, i + 1)
        if c == ",":
            has_comma = true
        elif c == "/":
            has_slash = true
        i = i + 1
    if has_comma and has_slash:
        return nil

    var parts: [text] = []
    var current = ""
    var j = 0
    while j < inner.len():
        val c = inner.slice(j, j + 1)
        val separator = (c == "," or c == "/" or c == " " or c == "\t" or c == "\n")
        if separator:
            if current.len() > 0:
                parts.push(current)
                current = ""
            # A leading comma or slash is a malformed list (`rgb(,1,2)`). A
            # separator after a value is fine — `rgb(1 2 3 / 0.5)` has a space
            # on both sides of the slash. A trailing one is caught below.
            elif parts.len() == 0:
                return nil
        else:
            current = current + c
        j = j + 1
    if current.len() > 0:
        parts.push(current)
    if inner.ends_with(",") or inner.ends_with("/"):
        return nil
    parts

# Return the text between the first `(` and the final `)` of `s`, or nil when
# `s` is not `name(...)`.
fn _fn_inner(s: text, name: text) -> text?:
    val prefix = name + "("
    if not s.starts_with(prefix):
        return nil
    if not s.ends_with(")"):
        return nil
    s.slice(prefix.len(), s.len() - 1)

# The optional fourth argument as a 0..255 alpha; 255 when absent, -1 when
# present but malformed. Computed by a helper rather than by reassigning a
# `var` inside the `if val` binding block — that write does not survive here.
fn _args_alpha(parts: [text]) -> i64:
    if parts.len() == 4:
        return _alpha_channel(parts[3 as i32])
    255

fn _parse_rgb_fn(inner: text) -> Color?:
    if val parts = _split_args(inner):
        if parts.len() < 3 or parts.len() > 4:
            return nil
        val r = _rgb_channel(parts[0 as i32])
        val g = _rgb_channel(parts[1 as i32])
        val b = _rgb_channel(parts[2 as i32])
        val a = _args_alpha(parts)
        if r < 0 or g < 0 or b < 0 or a < 0:
            return nil
        return from_rgba(r, g, b, a)
    nil

fn _parse_hsl_fn(inner: text) -> Color?:
    if val parts = _split_args(inner):
        if parts.len() < 3 or parts.len() > 4:
            return nil
        val h = _hue_arg(parts[0 as i32])
        val s = _percent_arg(parts[1 as i32])
        val l = _percent_arg(parts[2 as i32])
        val a = _args_alpha(parts)
        if h < 0 or s < 0 or l < 0 or a < 0:
            return nil
        val rgb = hsl_to_rgb(h, s, l)
        return from_rgba(rgb.r, rgb.g, rgb.b, a)
    nil

# ============================================================================
# Entry point
# ============================================================================

pub fn parse_css_color(raw: text) -> Color?:
    """Return the colour `raw` denotes, or nil when the syntax is unsupported."""
    val trimmed: text = raw.trim()
    val s: text = trimmed.to_lower()
    if s.len() == 0:
        return nil
    if s.starts_with("#"):
        return parse_hex_color(s)
    if val rgb_inner = _fn_inner(s, "rgba"):
        return _parse_rgb_fn(rgb_inner)
    if val rgb_inner2 = _fn_inner(s, "rgb"):
        return _parse_rgb_fn(rgb_inner2)
    if val hsl_inner = _fn_inner(s, "hsla"):
        return _parse_hsl_fn(hsl_inner)
    if val hsl_inner2 = _fn_inner(s, "hsl"):
        return _parse_hsl_fn(hsl_inner2)
    named_color(s)
