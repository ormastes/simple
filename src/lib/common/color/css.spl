    if n == "blueviolet": return from_rgba(138, 43, 226, 255)
    if n == "brown": return from_rgba(165, 42, 42, 255)
    if n == "burlywood": return from_rgba(222, 184, 135, 255)
    if n == "cadetblue": return from_rgba(95, 158, 160, 255)
