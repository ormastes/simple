# C-MIG-0041: pure-Simple text-keyed dict membership check.
#
# Reimplements the membership test performed by the C-backed extern
# `rt_dict_contains` (src/runtime/runtime_native.c:8162), but by hand-
# walking the dict's own key array (`.keys()`) and comparing each key by
# value with `==`, rather than delegating to the built-in `contains_key`
# method (which is the thin wrapper around the extern itself on the
# native lane). This is genuinely different machinery from both the C
# hash-table probe and the built-in method dispatch.

fn dict_has_key_text(d: {text: i64}, key: text) -> bool:
    val ks = d.keys()
    var i = 0
    while i < ks.len():
        if ks[i] == key:
            return true
        i = i + 1
    return false
