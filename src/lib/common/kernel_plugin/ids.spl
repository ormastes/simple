pub struct KpfId128:
    hi: u64
    lo: u64

pub struct KpfDigest256:
    w0: u64
    w1: u64
    w2: u64
    w3: u64

pub fn kpf_id128_zero() -> KpfId128:
    KpfId128(hi: 0, lo: 0)

pub fn kpf_id128_is_zero(value: KpfId128) -> bool:
    value.hi == 0 and value.lo == 0

pub fn kpf_id128_equal(left: KpfId128, right: KpfId128) -> bool:
    left.hi == right.hi and left.lo == right.lo

pub fn kpf_digest256_zero() -> KpfDigest256:
    KpfDigest256(w0: 0, w1: 0, w2: 0, w3: 0)

pub fn kpf_digest256_is_zero(value: KpfDigest256) -> bool:
    value.w0 == 0 and value.w1 == 0 and value.w2 == 0 and value.w3 == 0

pub fn kpf_digest256_equal(left: KpfDigest256, right: KpfDigest256) -> bool:
    left.w0 == right.w0 and left.w1 == right.w1 and left.w2 == right.w2 and left.w3 == right.w3
