pub enum KpfStatus:
    Ok
    AbiVersionUnsupported
    DescriptorTooShort
    SchemaIdentityMissing
    SchemaIdentityMismatch
    SchemaMajorUnsupported
    SchemaMinorUnsupported
    SchemaDigestMissing
    SchemaDigestMismatch
    ReservedFieldNonzero
    ContractCodeUnknown
    ContractInvalid
    LifecycleTransitionInvalid

impl KpfStatus:
    pub fn accepted() -> bool:
        match self:
            case Ok: true
            case _: false

    pub fn code() -> i32:
        match self:
            case Ok: 0
            case AbiVersionUnsupported: 1
            case DescriptorTooShort: 2
            case SchemaIdentityMissing: 3
            case SchemaIdentityMismatch: 4
            case SchemaMajorUnsupported: 5
            case SchemaMinorUnsupported: 6
            case SchemaDigestMissing: 7
            case SchemaDigestMismatch: 8
            case ReservedFieldNonzero: 9
            case ContractCodeUnknown: 10
            case ContractInvalid: 11
            case LifecycleTransitionInvalid: 12
