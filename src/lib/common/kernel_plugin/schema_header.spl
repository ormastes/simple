use common.kernel_plugin.ids.{KpfId128, KpfDigest256, kpf_id128_is_zero, kpf_id128_equal, kpf_digest256_is_zero, kpf_digest256_equal}
use common.kernel_plugin.status.KpfStatus

pub const KPF_ABI_VERSION_V1: u32 = 1
pub const KPF_SCHEMA_HEADER_V1_SIZE: u32 = 72

pub struct KpfSchemaHeaderV1:
    abi_version: u32
    struct_size: u32
    schema_id: KpfId128
    schema_major: u32
    schema_minor: u32
    schema_digest: KpfDigest256
    reserved0: u64

pub struct KpfSchemaRequirementV1:
    schema_id: KpfId128
    schema_major: u32
    minimum_minor: u32
    minimum_struct_size: u32
    schema_digest: KpfDigest256

pub fn kpf_validate_schema_header_v1(header: KpfSchemaHeaderV1, requirement: KpfSchemaRequirementV1) -> KpfStatus:
    if header.abi_version != KPF_ABI_VERSION_V1:
        return KpfStatus.AbiVersionUnsupported
    if header.struct_size < KPF_SCHEMA_HEADER_V1_SIZE or header.struct_size < requirement.minimum_struct_size:
        return KpfStatus.DescriptorTooShort
    if kpf_id128_is_zero(header.schema_id) or kpf_id128_is_zero(requirement.schema_id):
        return KpfStatus.SchemaIdentityMissing
    if not kpf_id128_equal(header.schema_id, requirement.schema_id):
        return KpfStatus.SchemaIdentityMismatch
    if header.schema_major != requirement.schema_major:
        return KpfStatus.SchemaMajorUnsupported
    if header.schema_minor < requirement.minimum_minor:
        return KpfStatus.SchemaMinorUnsupported
    if kpf_digest256_is_zero(header.schema_digest) or kpf_digest256_is_zero(requirement.schema_digest):
        return KpfStatus.SchemaDigestMissing
    if not kpf_digest256_equal(header.schema_digest, requirement.schema_digest):
        return KpfStatus.SchemaDigestMismatch
    if header.reserved0 != 0:
        return KpfStatus.ReservedFieldNonzero
    KpfStatus.Ok
