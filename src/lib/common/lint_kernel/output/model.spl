use common.kernel_plugin.ids.{KpfDigest256, KpfId128}
use common.lint_kernel.model.{DiagnosticV1, LintRunResultV1, SourceSpanV1}

pub struct LintOutputLocationV1:
    span: SourceSpanV1
    uri: text
    start_line: u32
    start_column: u32
    end_line: u32
    end_column: u32

pub struct LintRelatedLocationV1:
    location: LintOutputLocationV1
    message: text

pub enum LintFixApplicabilityV1:
    MachineApplicable
    MaybeIncorrect
    HasPlaceholders
    Unspecified

pub struct LintEditMetadataV1:
    provider_id: KpfId128
    language_id: KpfId128
    expected_snapshot_digest: KpfDigest256
    conflict_group: u64
    applicability: LintFixApplicabilityV1

pub struct LintTextEditV1:
    location: LintOutputLocationV1
    replacement: text
    metadata: LintEditMetadataV1

pub struct NormalizedLintDiagnosticV1:
    diagnostic: DiagnosticV1
    location: LintOutputLocationV1
    rule_name: text
    message: text
    help: text
    related: [LintRelatedLocationV1]
    fixes: [LintTextEditV1]

pub struct NormalizedLintOutputV1:
    result: LintRunResultV1
    diagnostics: [NormalizedLintDiagnosticV1]
