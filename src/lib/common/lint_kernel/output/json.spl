use common.lint_kernel.output.model.*
use common.lint_kernel.output.common.*

fn _location_json(location: LintOutputLocationV1) -> text:
    "{\"uri\":" + lint_output_quote(location.uri) + ",\"revision\":" + location.span.revision.to_string() + ",\"startByte\":" + location.span.start_byte.to_string() + ",\"endByte\":" + location.span.end_byte.to_string() + ",\"startLine\":" + location.start_line.to_string() + ",\"startColumn\":" + location.start_column.to_string() + ",\"endLine\":" + location.end_line.to_string() + ",\"endColumn\":" + location.end_column.to_string() + "}"

fn _related_json(items: [LintRelatedLocationV1]) -> text:
    var result = "["
    for index in 0..items.len():
        if index > 0: result = result + ","
        result = result + "{\"location\":" + _location_json(items[index].location) + ",\"message\":" + lint_output_quote(items[index].message) + "}"
    result + "]"

fn _fixes_json(items: [LintTextEditV1]) -> text:
    var result = "["
    for index in 0..items.len():
        if index > 0: result = result + ","
        val metadata = items[index].metadata
        result = result + "{\"location\":" + _location_json(items[index].location) + ",\"replacement\":" + lint_output_quote(items[index].replacement) + ",\"providerId\":" + lint_output_quote(lint_output_id(metadata.provider_id)) + ",\"languageId\":" + lint_output_quote(lint_output_id(metadata.language_id)) + ",\"expectedSnapshotDigest\":\"" + metadata.expected_snapshot_digest.w0.to_string() + "-" + metadata.expected_snapshot_digest.w1.to_string() + "-" + metadata.expected_snapshot_digest.w2.to_string() + "-" + metadata.expected_snapshot_digest.w3.to_string() + "\",\"conflictGroup\":" + metadata.conflict_group.to_string() + ",\"applicability\":" + lint_output_quote(metadata.applicability.to_string()) + "}"
    result + "]"

fn _diagnostic_json(item: NormalizedLintDiagnosticV1) -> text:
    "{\"ruleId\":" + lint_output_quote(lint_output_id(item.diagnostic.rule_id)) + ",\"ruleName\":" + lint_output_quote(item.rule_name) + ",\"providerId\":" + lint_output_quote(lint_output_id(item.diagnostic.provider_id)) + ",\"severity\":" + lint_output_quote(lint_output_severity(item.diagnostic.severity)) + ",\"category\":" + item.diagnostic.category.to_string() + ",\"message\":" + lint_output_quote(item.message) + ",\"help\":" + lint_output_quote(item.help) + ",\"location\":" + _location_json(item.location) + ",\"relatedLocations\":" + _related_json(item.related) + ",\"fixes\":" + _fixes_json(item.fixes) + "}"

pub fn lint_output_to_json(output: NormalizedLintOutputV1) -> text:
    val coverage = output.result.coverage
    val sorted = lint_output_sorted(output.diagnostics)
    var diagnostics = "["
    for index in 0..sorted.len():
        if index > 0: diagnostics = diagnostics + ","
        diagnostics = diagnostics + _diagnostic_json(sorted[index])
    diagnostics = diagnostics + "]"
    "{\"schemaVersion\":1,\"verdict\":" + lint_output_quote(lint_output_verdict(output.result.verdict)) + ",\"coverage\":{\"requestedUnits\":" + coverage.requested_unit_count.to_string() + ",\"admittedUnits\":" + coverage.admitted_unit_count.to_string() + ",\"completedUnits\":" + coverage.completed_unit_count.to_string() + ",\"partialUnits\":" + coverage.partial_unit_count.to_string() + ",\"notAnalyzedUnits\":" + coverage.not_analyzed_unit_count.to_string() + ",\"requestedRules\":" + coverage.requested_rule_count.to_string() + ",\"completedRules\":" + coverage.completed_rule_count.to_string() + ",\"skippedRules\":" + coverage.skipped_rule_count.to_string() + ",\"requestedPhases\":" + coverage.requested_phase_bits.to_string() + ",\"completedPhases\":" + coverage.completed_phase_bits.to_string() + "},\"diagnostics\":" + diagnostics + "}"
