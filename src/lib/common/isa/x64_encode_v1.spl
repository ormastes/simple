# MDSOC: feature dimension
# Pure x86-64 immediate encoders shared by the XRay x86-64 trampoline twin,
# the XRay sled template / native map and the native backend: the
# little-endian imm32 writer and the rel32 range check. Byte buffers are
# `[i64]` because that is the backend's and the twin's emission buffer type.

pub const X64_REL32_MAX_FORWARD_V1 = 2147483647
pub const X64_REL32_MAX_BACKWARD_V1 = 2147483648

pub fn x64_rel32_in_range_v1(displacement: i64) -> bool:
    displacement >= 0 - X64_REL32_MAX_BACKWARD_V1 and displacement <= X64_REL32_MAX_FORWARD_V1

# Append the low 32 bits of `value` little-endian (two's complement).
pub fn x64_push_imm32_le_v1(out: [i64], value: i64) -> [i64]:
    var bytes = out
    bytes.push(value & 255)
    bytes.push((value >> 8) & 255)
    bytes.push((value >> 16) & 255)
    bytes.push((value >> 24) & 255)
    bytes
