# MDSOC: feature dimension
# Pure x86-64 immediate encoders shared by the XRay x86-64 trampoline twin,
# the XRay sled template / native map and the native backend: the
# little-endian imm32 writer (re-exported from std.common.binary_io) and the
# rel32 range check. Byte buffers are `[i64]` because that is the backend's
# and the twin's emission buffer type.

pub const X64_REL32_MAX_FORWARD_V1 = 2147483647
pub const X64_REL32_MAX_BACKWARD_V1 = 2147483648

pub fn x64_rel32_in_range_v1(displacement: i64) -> bool:
    displacement >= 0 - X64_REL32_MAX_BACKWARD_V1 and displacement <= X64_REL32_MAX_FORWARD_V1

# Append the low 32 bits of `value` little-endian (two's complement): the
# shared std.common.binary_io writer, the same body the ELF writer emits with.
export use std.common.binary_io.{bytes_i64_push_u32_le as x64_push_imm32_le_v1}
