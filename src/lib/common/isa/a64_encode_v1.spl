# MDSOC: feature dimension
# Pure AArch64 instruction-word encoders shared by the XRay trampoline twin,
# the XRay sled template / native map and the native backend. Only the forms
# those emitters need: NOP, B/BL imm26 (with the branch range in words; the
# byte limits are the native map's displacement check), STP/LDP signed-offset
# X and Q pairs, LDR/STR unsigned offset, and ADD/SUB imm12. Immediates are masked exactly as the backend masks them.

# A BL/B reaches [-2^25, 2^25) instructions, i.e. [-2^27, 2^27) bytes; the
# last reachable forward byte displacement is one instruction short.
pub const A64_BRANCH26_MAX_FORWARD_BYTES_V1 = 134217724
pub const A64_BRANCH26_MAX_BACKWARD_BYTES_V1 = 134217728

pub fn a64_nop_v1() -> i64:
    0xD503201F

pub fn a64_branch26_words_in_range_v1(words: i64) -> bool:
    words >= -33554432 and words <= 33554431

# B / BL with a signed displacement in instructions.
pub fn a64_b_v1(words: i64) -> i64:
    0x14000000 | (words & 0x3FFFFFF)

pub fn a64_bl_v1(words: i64) -> i64:
    0x94000000 | (words & 0x3FFFFFF)

# STP/LDP Xt1, Xt2, [Xn, #offset] (signed offset, 64-bit, offset in bytes).
pub fn a64_stp_x_v1(rt: i64, rt2: i64, rn: i64, offset: i64) -> i64:
    0xA9000000 | (((offset / 8) & 0x7F) << 15) | (rt2 << 10) | (rn << 5) | rt

pub fn a64_ldp_x_v1(rt: i64, rt2: i64, rn: i64, offset: i64) -> i64:
    0xA9400000 | (((offset / 8) & 0x7F) << 15) | (rt2 << 10) | (rn << 5) | rt

# STP/LDP Qt1, Qt2, [Xn, #offset] (signed offset, 128-bit, offset in bytes).
pub fn a64_stp_q_v1(rt: i64, rt2: i64, rn: i64, offset: i64) -> i64:
    0xAD000000 | (((offset / 16) & 0x7F) << 15) | (rt2 << 10) | (rn << 5) | rt

pub fn a64_ldp_q_v1(rt: i64, rt2: i64, rn: i64, offset: i64) -> i64:
    0xAD400000 | (((offset / 16) & 0x7F) << 15) | (rt2 << 10) | (rn << 5) | rt

# STR/LDR Xt, [Xn, #offset] (unsigned offset, offset in bytes).
pub fn a64_str_x_v1(rt: i64, rn: i64, offset: i64) -> i64:
    0xF9000000 | (((offset / 8) & 0xFFF) << 10) | (rn << 5) | rt

pub fn a64_ldr_x_v1(rt: i64, rn: i64, offset: i64) -> i64:
    0xF9400000 | (((offset / 8) & 0xFFF) << 10) | (rn << 5) | rt

# ADD/SUB Xd, Xn, #imm12 (also MOV to/from SP when imm is 0).
pub fn a64_add_imm_v1(rd: i64, rn: i64, imm: i64) -> i64:
    0x91000000 | ((imm & 0xFFF) << 10) | (rn << 5) | rd

pub fn a64_sub_imm_v1(rd: i64, rn: i64, imm: i64) -> i64:
    0xD1000000 | ((imm & 0xFFF) << 10) | (rn << 5) | rd
