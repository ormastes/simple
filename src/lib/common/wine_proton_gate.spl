"""Wine Proton readiness gate: Proton-specific runtime prerequisites above Wine.

Layered on the Wine substrate full-wine gate (common.wine_substrate); Proton
readiness requires every Wine gate plus the 12 Proton launch features below.
"""

use common.wine_substrate.{wine_substrate_full_wine_gate}

pub fn wine_proton_required_features() -> [text]:
    [
        "steam-runtime",
        "pressure-vessel-container",
        "proton-launcher",
        "wine-full",
        "vulkan-loader",
        "vulkan-device",
        "dxvk",
        "vkd3d-proton",
        "steamworks-bridge",
        "controller-input",
        "shader-cache",
        "esync-or-fsync"
    ]

pub fn wine_proton_missing_features(features: text) -> [text]:
    var missing: [text] = []
    for feature in wine_proton_required_features():
        if not features.contains(feature):
            missing.push(feature)
    return missing

pub fn wine_proton_feature_gate(features: text) -> text:
    val missing = wine_proton_missing_features(features)
    if missing.len() == 0:
        return "ready"
    return "missing-" + missing[0]

pub fn wine_proton_fixture_features() -> text:
    var out = ""
    for feature in wine_proton_required_features():
        if out != "":
            out = out + " "
        out = out + feature
    return out

pub fn wine_proton_fixture_wine_gates() -> text:
    val gates = [
        "process",
        "exec_env",
        "vm",
        "renderer",
        "user32",
        "gdi32",
        "kernel32_core",
        "host",
        "posix",
        "registry",
        "pthread",
        "dynload",
        "audio",
        "fonts",
        "input",
        "pe_loader",
        "async",
        "nt_bridge"
    ]
    var out = ""
    for gate in gates:
        if out != "":
            out = out + " "
        out = out + gate + "=verified"
    return out

pub fn wine_proton_readiness_gate(wine_gates: text, features: text) -> text:
    val wine_state = wine_substrate_full_wine_gate(wine_gates)
    if wine_state != "ready":
        return "blocked-wine-" + wine_state
    return wine_proton_feature_gate(features)
