"""Complete opt-in SDN decoding with no recovery or discarded authored tokens.

Offsets and columns count original UTF-8 bytes. LF and CRLF are accepted; tabs
in indentation and bare CR are rejected. Comments start outside quoted text.
Inline collections allow whitespace/comments across lines but no trailing
commas. Colon and equals delimiters in scalar text require quoting. Empty block
fields mean null. Whitespace-bearing collection/table text must be quoted;
standalone and block-field bare text may contain spaces. Named-table rows must be deeper than the
header; anonymous root-table rows use root indentation. Quoted strings retain
the shared owner's unknown-escape and raw-multiline semantics.
"""

use std.common.sdn.value.{SdnValue}
use std.common.sdn.strict_types_v1.*
use std.common.sdn.structural_scalar_value_v1.{
    sdn_integer_from_span_v1, sdn_decode_quoted_scalar_v1, sdn_float_spelling_v1}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_located_v1}

pub fn sdn_strict_limits_valid_v1(limits: SdnStrictLimitsV1) -> bool:
    (limits.max_source_bytes >= 0 and limits.max_source_bytes <= 16777216 and
        limits.max_depth >= 1 and limits.max_depth <= 64 and
        limits.max_nodes >= 0 and limits.max_nodes <= 4000000 and
        limits.max_rows >= 0 and limits.max_rows <= 4000000 and
        limits.max_cells >= 0 and limits.max_cells <= 4000000 and
        limits.max_columns >= 0 and limits.max_columns <= 65536)

fn strict_input_issue_v1(code: text, message: text) -> SdnStrictIssueV1:
    SdnStrictIssueV1(code: code, message: message, offset: 0, line: 1, column: 1)

fn strict_byte_issue_v1(bytes: [u8], offset: i64, message: text) -> SdnStrictIssueV1:
    var line = 1
    var column = 1
    var index = 0
    while index < offset:
        if bytes[index] == 10u8:
            line = line + 1
            column = 1
        else:
            column = column + 1
        index = index + 1
    SdnStrictIssueV1(code: "invalid_utf8", message: message, offset: offset,
        line: line, column: column)

fn strict_integer_spelling_v1(spelling: text) -> bool:
    var index = 0
    if spelling.starts_with("-"): index = 1
    if index == spelling.len(): return false
    while index < spelling.len():
        val digit = spelling.byte_at(index)
        if digit < 48 or digit > 57: return false
        index = index + 1
    true


class StrictSdnReaderV1:
    source: text
    bytes: [u8]
    limits: SdnStrictLimitsV1
    cursor: i64 = 0
    indentation: i64 = 0
    nodes: i64 = 0
    rows: i64 = 0
    cells: i64 = 0

    fn byte_at(offset: i64) -> i64:
        if offset < 0 or offset >= self.bytes.len(): return -1
        self.bytes[offset].to_i64()

    fn peek() -> i64: self.byte_at(self.cursor)

    fn issue(code: text, message: text) -> SdnStrictIssueV1:
        var line = 1
        var column = 1
        var index = 0
        while index < self.cursor and index < self.bytes.len():
            if self.byte_at(index) == 10:
                line = line + 1
                column = 1
            else:
                column = column + 1
            index = index + 1
        SdnStrictIssueV1(code: code, message: message,
            offset: self.cursor, line: line, column: column)

    me charge(depth: i64) -> Result<bool, SdnStrictIssueV1>:
        if depth > self.limits.max_depth:
            return Err(self.issue("depth_limit", "SDN nesting exceeds configured depth"))
        if self.nodes >= self.limits.max_nodes:
            return Err(self.issue("node_limit", "SDN nodes exceed configured budget"))
        self.nodes = self.nodes + 1
        Ok(true)

    me skip_layout(multiline: bool):
        var scanning = true
        while scanning:
            val ch = self.peek()
            if ch == 32 or ch == 9:
                self.cursor = self.cursor + 1
            elif ch == 35:
                while self.peek() >= 0 and self.peek() != 10 and self.peek() != 13:
                    self.cursor = self.cursor + 1
            elif multiline and ch == 10:
                self.cursor = self.cursor + 1
            elif multiline and ch == 13 and self.byte_at(self.cursor + 1) == 10:
                self.cursor = self.cursor + 2
            else:
                scanning = false

    me finish_line() -> Result<bool, SdnStrictIssueV1>:
        self.skip_layout(false)
        if self.peek() == 10:
            self.cursor = self.cursor + 1
        elif self.peek() == 13 and self.byte_at(self.cursor + 1) == 10:
            self.cursor = self.cursor + 2
        elif self.peek() != -1:
            return Err(self.issue("trailing_content", "Unexpected content after SDN value"))
        Ok(true)

    me next_line() -> Result<bool, SdnStrictIssueV1>:
        while self.peek() >= 0:
            var width = 0
            while self.peek() == 32:
                width = width + 1
                self.cursor = self.cursor + 1
            if self.peek() == 9:
                return Err(self.issue("tab_indentation", "Indent SDN blocks with spaces"))
            if self.peek() == 35 or self.peek() == 10 or self.peek() == 13:
                self.finish_line()?
            elif self.peek() < 0:
                self.indentation = -1
                return Ok(false)
            else:
                self.indentation = width
                return Ok(true)
        self.indentation = -1
        Ok(false)

    # Locate a block entry delimiter without interpreting braces as interpolation
    # or separators inside quoted field names. Inline values are not scanned here.
    fn entry_delimiter() -> i64:
        var index = self.cursor
        var quoted = false
        while self.byte_at(index) >= 0:
            val ch = self.byte_at(index)
            if quoted:
                if ch == 92:
                    index = index + 2
                else:
                    if ch == 34: quoted = false
                    index = index + 1
            else:
                if ch == 10 or ch == 13 or ch == 35: return -1
                if ch == 34:
                    quoted = true
                elif ch == 58 or ch == 61 or ch == 124:
                    return index
                elif ch == 91 or ch == 93 or ch == 123 or ch == 125 or ch == 44:
                    return -1
                index = index + 1
        -1

    fn sequence_item() -> bool:
        self.peek() == 45 and (self.byte_at(self.cursor + 1) == 32 or
            self.byte_at(self.cursor + 1) == 10 or self.byte_at(self.cursor + 1) == 13 or
            self.byte_at(self.cursor + 1) == -1)

    me quoted() -> Result<text, SdnStrictIssueV1>:
        val start = self.cursor
        self.cursor = self.cursor + 1
        while self.peek() >= 0:
            val ch = self.peek()
            if ch == 92:
                if self.byte_at(self.cursor + 1) < 0:
                    return Err(self.issue("unterminated_quote", "Missing closing quote"))
                self.cursor = self.cursor + 2
            elif ch == 34:
                self.cursor = self.cursor + 1
                match sdn_decode_quoted_scalar_v1(self.source.substring(start, self.cursor)):
                    case Ok(value): return Ok(value)
                    case Err(reason): return Err(self.issue("quoted_scalar", reason))
            else:
                self.cursor = self.cursor + 1
        Err(self.issue("unterminated_quote", "Missing closing quote"))

    me key_until(separator: i64, depth: i64) -> Result<text, SdnStrictIssueV1>:
        self.charge(depth)?
        self.skip_layout(false)
        var name = ""
        if self.peek() == 34:
            name = self.quoted()?
            self.skip_layout(false)
        else:
            val start = self.cursor
            while self.peek() >= 0 and self.peek() != separator:
                val ch = self.peek()
                if ch == 10 or ch == 13 or ch == 35 or ch == 44 or ch == 34 or
                    ch == 91 or ch == 93 or ch == 123 or ch == 125 or ch == 124:
                    return Err(self.issue("invalid_key", "Invalid unquoted SDN key"))
                self.cursor = self.cursor + 1
            name = self.source.substring(start, self.cursor).trim()
        if name.len() == 0 or self.peek() != separator:
            return Err(self.issue("missing_key", "Require a nonempty key and separator"))
        self.cursor = self.cursor + 1
        Ok(name)

    me inline_value(depth: i64, allow_bare_spaces: bool) -> Result<SdnValue, SdnStrictIssueV1>:
        self.charge(depth)?
        self.skip_layout(true)
        val ch = self.peek()
        if ch == 34: return Ok(SdnValue.String(self.quoted()?))
        if ch == 91:
            self.cursor = self.cursor + 1
            var items: [SdnValue] = []
            self.skip_layout(true)
            if self.peek() == 93:
                self.cursor = self.cursor + 1
                return Ok(SdnValue.Array(items))
            while true:
                val item = self.inline_value(depth + 1, false)?
                items.push(item)
                self.skip_layout(true)
                if self.peek() == 93:
                    self.cursor = self.cursor + 1
                    return Ok(SdnValue.Array(items))
                if self.peek() != 44:
                    return Err(self.issue("array_separator", "Require comma or closing bracket"))
                self.cursor = self.cursor + 1
                self.skip_layout(true)
                if self.peek() == 93:
                    return Err(self.issue("trailing_comma", "Missing array member after comma"))
        if ch == 123:
            self.cursor = self.cursor + 1
            var entries: Dict<text, SdnValue> = {}
            self.skip_layout(true)
            if self.peek() == 125:
                self.cursor = self.cursor + 1
                return Ok(SdnValue.Dict(entries))
            while true:
                val name = self.key_until(58, depth + 1)?
                if entries.contains_key(name):
                    return Err(self.issue("duplicate_key", "Duplicate decoded SDN key"))
                self.skip_layout(true)
                val item = self.inline_value(depth + 1, false)?
                entries[name] = item
                self.skip_layout(true)
                if self.peek() == 125:
                    self.cursor = self.cursor + 1
                    return Ok(SdnValue.Dict(entries))
                if self.peek() != 44:
                    return Err(self.issue("dict_separator", "Require comma or closing brace"))
                self.cursor = self.cursor + 1
                self.skip_layout(true)
                if self.peek() == 125:
                    return Err(self.issue("trailing_comma", "Missing dictionary entry after comma"))
        if ch < 0 or ch == 44 or ch == 93 or ch == 125 or ch == 124:
            return Err(self.issue("missing_value", "Require an SDN value"))
        val start = self.cursor
        while self.peek() >= 0:
            val current = self.peek()
            if current == 10 or current == 13 or current == 35 or current == 44 or
                current == 93 or current == 125 or current == 124: break
            if current == 34 or current == 91 or current == 123 or current == 58 or current == 61:
                return Err(self.issue("unexpected_delimiter", "Structural delimiter inside bare scalar"))
            self.cursor = self.cursor + 1
        val spelling = self.source.substring(start, self.cursor).trim()
        if spelling.len() == 0: return Err(self.issue("missing_value", "Require an SDN value"))
        if not allow_bare_spaces and (spelling.contains(" ") or spelling.contains("\t")):
            return Err(self.issue("bare_whitespace", "Quote whitespace-bearing collection or table text"))
        if spelling == "null": return Ok(SdnValue.Null)
        if spelling == "true": return Ok(SdnValue.Bool(true))
        if spelling == "false": return Ok(SdnValue.Bool(false))
        if strict_integer_spelling_v1(spelling):
            val integer_bytes = spelling.bytes()
            match sdn_integer_from_span_v1(integer_bytes, 0, integer_bytes.len()):
                case Ok(value): return Ok(SdnValue.Int(value))
                case Err(reason): return Err(self.issue("integer_overflow", reason))
        if sdn_float_spelling_v1(spelling):
            val value = spelling.to_float()
            if value != value or value > 1.7976931348623157e308 or value < -1.7976931348623157e308:
                return Err(self.issue("nonfinite_float", "Finite SDN float required"))
            return Ok(SdnValue.Float(value))
        Ok(SdnValue.String(spelling))

    me table(level: i64, depth: i64, anonymous_root: bool) -> Result<SdnValue, SdnStrictIssueV1>:
        self.charge(depth)?
        self.cursor = self.cursor + 1
        var headers: [text] = []
        var names: Dict<text, bool> = {}
        while true:
            self.skip_layout(false)
            if self.peek() == 124:
                if headers.len() != 0:
                    return Err(self.issue("empty_column", "Missing column after comma"))
                self.cursor = self.cursor + 1
                break
            if headers.len() >= self.limits.max_columns:
                return Err(self.issue("column_limit", "Table exceeds configured column budget"))
            self.charge(depth + 1)?
            var name = ""
            if self.peek() == 34:
                name = self.quoted()?
            else:
                val start = self.cursor
                while self.peek() >= 0 and self.peek() != 44 and self.peek() != 124:
                    if self.peek() == 10 or self.peek() == 13 or self.peek() == 35 or self.peek() == 34:
                        return Err(self.issue("table_header", "Unterminated table header"))
                    self.cursor = self.cursor + 1
                name = self.source.substring(start, self.cursor).trim()
            self.skip_layout(false)
            if name.len() == 0: return Err(self.issue("empty_column", "Require nonempty column names"))
            if names.contains_key(name): return Err(self.issue("duplicate_column", "Duplicate decoded column name"))
            names[name] = true
            headers.push(name)
            if self.peek() == 124:
                self.cursor = self.cursor + 1
                break
            if self.peek() != 44:
                return Err(self.issue("table_header", "Require comma or closing pipe"))
            self.cursor = self.cursor + 1
        self.finish_line()?
        self.next_line()?
        var rows: [[SdnValue]] = []
        var row_indent = -1
        while self.peek() >= 0:
            if anonymous_root:
                if self.indentation != level:
                    return Err(self.issue("row_indentation", "Anonymous root rows use root indentation"))
                if self.entry_delimiter() >= 0 or self.sequence_item():
                    return Err(self.issue("multiple_roots", "Additional root after anonymous table"))
            elif self.indentation <= level:
                break
            if row_indent == -1: row_indent = self.indentation
            if row_indent != self.indentation:
                return Err(self.issue("row_indentation", "Table rows require consistent indentation"))
            if self.rows >= self.limits.max_rows:
                return Err(self.issue("row_limit", "Tables exceed configured row budget"))
            self.rows = self.rows + 1
            var row: [SdnValue] = []
            while true:
                if row.len() >= headers.len():
                    return Err(self.issue("row_width", "Table row has surplus cells"))
                if self.cells >= self.limits.max_cells:
                    return Err(self.issue("cell_limit", "Tables exceed configured cell budget"))
                self.cells = self.cells + 1
                self.skip_layout(false)
                if self.peek() < 0 or self.peek() == 10 or self.peek() == 13 or self.peek() == 35:
                    return Err(self.issue("missing_cell", "Table cells cannot be omitted"))
                val item = self.inline_value(depth + 1, false)?
                row.push(item)
                self.skip_layout(false)
                if self.peek() != 44: break
                self.cursor = self.cursor + 1
            if row.len() != headers.len():
                return Err(self.issue("row_width", "Table row has missing cells"))
            self.finish_line()?
            rows.push(row)
            self.next_line()?
        Ok(SdnValue.Table(headers, rows))

    me block_mapping(level: i64, depth: i64) -> Result<SdnValue, SdnStrictIssueV1>:
        self.charge(depth)?
        var entries: Dict<text, SdnValue> = {}
        while self.peek() >= 0 and self.indentation >= level:
            if self.indentation != level:
                return Err(self.issue("unexpected_indentation", "Unexpected mapping indentation"))
            val delimiter = self.entry_delimiter()
            if delimiter < 0:
                return Err(self.issue("mapping_entry", "Require a mapping field or named table"))
            val separator = self.byte_at(delimiter)
            var name = ""
            if separator == 124:
                self.charge(depth + 1)?
                val spelling = self.source.substring(self.cursor, delimiter).trim()
                if spelling.starts_with("\""):
                    match sdn_decode_quoted_scalar_v1(spelling):
                        case Ok(value): name = value
                        case Err(reason): return Err(self.issue("table_name", reason))
                else:
                    name = spelling
                if name.len() == 0: return Err(self.issue("table_name", "Require a named section"))
                self.cursor = delimiter
            else:
                name = self.key_until(separator, depth + 1)?
            if entries.contains_key(name):
                return Err(self.issue("duplicate_key", "Duplicate field or table section"))
            if separator == 124:
                val item = self.table(level, depth + 1, false)?
                entries[name] = item
            else:
                self.skip_layout(false)
                if self.peek() == 10 or self.peek() == 13 or self.peek() == -1:
                    self.finish_line()?
                    self.next_line()?
                    if self.peek() >= 0 and self.indentation > level:
                        val item = self.block(self.indentation, depth + 1)?
                        entries[name] = item
                    else:
                        self.charge(depth + 1)?
                        entries[name] = SdnValue.Null
                else:
                    val item = self.inline_value(depth + 1, true)?
                    entries[name] = item
                    self.finish_line()?
                    self.next_line()?
        Ok(SdnValue.Dict(entries))

    me block_sequence(level: i64, depth: i64) -> Result<SdnValue, SdnStrictIssueV1>:
        self.charge(depth)?
        var items: [SdnValue] = []
        while self.peek() >= 0 and self.indentation >= level:
            if self.indentation != level or not self.sequence_item():
                return Err(self.issue("sequence_entry", "Require a sequence item at the same indentation"))
            self.cursor = self.cursor + 1
            var item_level = level + 1
            while self.peek() == 32:
                self.cursor = self.cursor + 1
                item_level = item_level + 1
            self.skip_layout(false)
            if self.peek() == 10 or self.peek() == 13 or self.peek() == -1:
                self.finish_line()?
                self.next_line()?
                if self.peek() >= 0 and self.indentation > level:
                    val item = self.block(self.indentation, depth + 1)?
                    items.push(item)
                else:
                    self.charge(depth + 1)?
                    items.push(SdnValue.Null)
            elif self.entry_delimiter() >= 0:
                self.indentation = item_level
                val item = self.block_mapping(item_level, depth + 1)?
                items.push(item)
            else:
                val item = self.inline_value(depth + 1, true)?
                items.push(item)
                self.finish_line()?
                self.next_line()?
        Ok(SdnValue.Array(items))

    me block(level: i64, depth: i64) -> Result<SdnValue, SdnStrictIssueV1>:
        if self.sequence_item(): return self.block_sequence(level, depth)
        if self.peek() == 124: return self.table(level, depth, level == 0)
        if self.entry_delimiter() >= 0: return self.block_mapping(level, depth)
        val item = self.inline_value(depth, true)?
        self.finish_line()?
        self.next_line()?
        Ok(item)

fn strict_decode_bytes_v1(bytes: [u8], limits: SdnStrictLimitsV1) -> Result<SdnStrictDocumentV1, SdnStrictIssueV1>:
    var source = ""
    match validated_utf8_bytes_to_text_located_v1(bytes):
        case Ok(value): source = value
        case Err(issue): return Err(strict_byte_issue_v1(bytes, issue.offset, issue.message))
    var reader = StrictSdnReaderV1(source: source, bytes: bytes, limits: limits)
    reader.next_line()?
    if reader.peek() < 0:
        return Err(reader.issue("empty_document", "Require one SDN root"))
    if reader.indentation != 0:
        return Err(reader.issue("root_indentation", "SDN root must start at column one"))
    val value = reader.block(0, 1)?
    if reader.peek() >= 0:
        return Err(reader.issue("trailing_content", "Document did not consume all authored content"))
    Ok(SdnStrictDocumentV1(value: value, consumed_bytes: reader.cursor,
        nodes: reader.nodes, rows: reader.rows, cells: reader.cells))

pub fn sdn_parse_strict_bytes_v1(bytes: [u8], limits: SdnStrictLimitsV1) -> Result<SdnStrictDocumentV1, SdnStrictIssueV1>:
    if not sdn_strict_limits_valid_v1(limits):
        return Err(strict_input_issue_v1("invalid_limits", "Strict SDN limits are outside hard bounds"))
    if bytes.len() > limits.max_source_bytes:
        return Err(strict_input_issue_v1("source_limit", "SDN source exceeds configured byte budget"))
    strict_decode_bytes_v1(bytes, limits)

pub fn sdn_parse_strict_v1(source: text, limits: SdnStrictLimitsV1) -> Result<SdnStrictDocumentV1, SdnStrictIssueV1>:
    if not sdn_strict_limits_valid_v1(limits):
        return Err(strict_input_issue_v1("invalid_limits", "Strict SDN limits are outside hard bounds"))
    if source.len() > limits.max_source_bytes:
        return Err(strict_input_issue_v1("source_limit", "SDN source exceeds configured byte budget"))
    strict_decode_bytes_v1(source.bytes(), limits)

export sdn_parse_strict_v1, sdn_parse_strict_bytes_v1, sdn_strict_limits_valid_v1
