"""Explicit opt-in scalar/recursive-collection SDN candidate on shared ParseProgramV2.

Legacy parse remains the default. This API rejects unsupported syntax without
fallback and is not full SDN or Stage 4 admission. Grammar acceptance and node
commit are exclusively owned by the shared VM; projection reads committed nodes.
"""
use std.common.sdn.value.{SdnValue}
use std.common.sdn.structural_scalar_value_v1.{sdn_integer_from_span_v1, sdn_unescape_scalar_v1}
use std.common.sdn.structural_inline_lexer_v2.{sdn_inline_lex_checked_v2}
use std.common.sdn.structural_inline_issue_v2.{SdnInlineIssueV2}
use std.common.structural.parse.dialect.{GrammarProgram, ActionProgram}
use std.common.structural.parse.parse_types.{ParseTokenArena, parse_source_blob_from_text}
use std.common.structural.parse.program_v1.*
use std.common.structural.parse.program_output_v1.{ParseProgramOutputV1}
use std.common.structural.parse.grammar_cpu_v1.{parse_grammar_execute_v2}

pub struct SdnInlineCandidateV2:
    value: SdnValue
    tokens: ParseTokenArena
    syntax: ParseProgramOutputV1
    grammar_steps: i64

fn _inline_program_v2(limits: ParseProgramLimitsV1) -> Result<ParseProgramV2, text>:
    # Entry -> Value EOF; Value -> Array / Dict / literals / numeric / quoted / Word.
    # Array -> '[' (Value (',' Value)*)? ']'; Dict -> '{' (Pair (',' Pair)*)? '}'.
    # Pair -> (Word / QuotedKey) ':' Value. Choice rollback owns all actions.
    val grammar = GrammarProgram(contract_version: 1, entry_rules: [0],
        production_offsets: [0, 6, 105, 144, 183, 207], opcodes: [
        PG_CALL_V1, 1, 0,
        PG_END_V1, 0, 0,
        PG_CHOICE_V1, 15, 0,
        PG_CALL_V1, 2, 0,
        PG_COMMIT_V1, 102, 0,
        PG_CHOICE_V1, 24, 0,
        PG_CALL_V1, 3, 0,
        PG_COMMIT_V1, 102, 0,
        PG_CHOICE_V1, 36, 0,
        PG_MATCH_TOKEN_TEXT_V2, 0, 0,
        PG_ACTION_V1, 0, 0,
        PG_COMMIT_V1, 102, 0,
        PG_CHOICE_V1, 48, 0,
        PG_MATCH_TOKEN_TEXT_V2, 1, 0,
        PG_ACTION_V1, 1, 0,
        PG_COMMIT_V1, 102, 0,
        PG_CHOICE_V1, 60, 0,
        PG_MATCH_TOKEN_TEXT_V2, 2, 0,
        PG_ACTION_V1, 2, 0,
        PG_COMMIT_V1, 102, 0,
        PG_CHOICE_V1, 72, 0,
        PG_MATCH_KIND_V1, 1, 0,
        PG_ACTION_V1, 3, 0,
        PG_COMMIT_V1, 102, 0,
        PG_CHOICE_V1, 84, 0,
        PG_MATCH_KIND_V1, 6, 0,
        PG_ACTION_V1, 7, 0,
        PG_COMMIT_V1, 102, 0,
        PG_CHOICE_V1, 96, 0,
        PG_MATCH_KIND_V1, 10, 0,
        PG_ACTION_V1, 10, 0,
        PG_COMMIT_V1, 102, 0,
        PG_MATCH_KIND_V1, 5, 0,
        PG_ACTION_V1, 4, 0,
        PG_RETURN_V1, 0, 0,
        PG_MATCH_BYTE_V1, 91, 0,
        PG_ACTION_V1, 5, 0,
        PG_CHOICE_V1, 138, 0,
        PG_CALL_V1, 1, 0,
        PG_ACTION_V1, 6, 0,
        PG_COMMIT_V1, 123, 0,
        PG_CHOICE_V1, 138, 0,
        PG_MATCH_BYTE_V1, 44, 0,
        PG_CALL_V1, 1, 0,
        PG_ACTION_V1, 6, 0,
        PG_COMMIT_V1, 123, 0,
        PG_MATCH_BYTE_V1, 93, 0,
        PG_RETURN_V1, 0, 0,
        PG_MATCH_BYTE_V1, 123, 0,
        PG_ACTION_V1, 8, 0,
        PG_CHOICE_V1, 177, 0,
        PG_CALL_V1, 4, 0,
        PG_ACTION_V1, 9, 0,
        PG_COMMIT_V1, 162, 0,
        PG_CHOICE_V1, 177, 0,
        PG_MATCH_BYTE_V1, 44, 0,
        PG_CALL_V1, 4, 0,
        PG_ACTION_V1, 9, 0,
        PG_COMMIT_V1, 162, 0,
        PG_MATCH_BYTE_V1, 125, 0,
        PG_RETURN_V1, 0, 0,
        PG_CHOICE_V1, 192, 0,
        PG_MATCH_KIND_V1, 5, 0,
        PG_COMMIT_V1, 195, 0,
        PG_MATCH_KIND_V1, 10, 0,
        PG_ACTION_V1, 4, 0,
        PG_MATCH_BYTE_V1, 58, 0,
        PG_CALL_V1, 1, 0,
        PG_RETURN_V1, 0, 0])
    val actions = ActionProgram(contract_version: 1,
        action_offsets: [0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 30, 33], opcodes: [
        PA_CAPTURE_V1, 200, 0, PA_CAPTURE_V1, 201, 0,
        PA_CAPTURE_V1, 202, 0, PA_CAPTURE_V1, 203, 0,
        PA_CAPTURE_V1, 204, 0, PA_NODE_V1, 100, 0,
        PA_NODE_V1, 102, 2, PA_CAPTURE_V1, 205, 0,
        PA_NODE_V1, 110, 0, PA_NODE_V1, 112, 3, PA_CAPTURE_V1, 206, 0])
    parse_program_validate_v2(grammar, actions, [0, 4, 8, 13],
        "nulltruefalse".bytes(), limits)

fn _inline_value_v2(source: text, output: ParseProgramOutputV1) -> Result<SdnValue, text>:
    if output.roots.len() != 1 or output.diagnostics.len() != 0:
        return Err("invalid_semantic_output")
    val bytes = source.bytes()
    var values: [SdnValue] = []
    for node in output.nodes:
        if node.kind == 112:
            if node.child_count != 3 or node.child_start < 0 or
                node.child_start + 3 > output.children.len():
                return Err("invalid_semantic_output")
            val prior = output.children[node.child_start]
            val key = output.children[node.child_start + 1]
            val item = output.children[node.child_start + 2]
            if prior < 0 or key < 0 or item < 0 or prior >= values.len() or
                key >= values.len() or item >= values.len():
                return Err("invalid_semantic_output")
            match values[prior]:
                case SdnValue.Dict(entries):
                    match values[key]:
                        case SdnValue.String(name):
                            var next: Dict<text, SdnValue> = {}
                            for entry in entries.keys(): next[entry] = entries[entry]
                            next[name] = values[item]
                            values.push(SdnValue.Dict(next))
                        case _: return Err("invalid_semantic_output")
                case _: return Err("invalid_semantic_output")
        elif node.kind == 102:
            if node.child_count != 2 or node.child_start < 0 or
                node.child_start + 2 > output.children.len():
                return Err("invalid_semantic_output")
            val prior = output.children[node.child_start]
            val item = output.children[node.child_start + 1]
            if prior < 0 or item < 0 or prior >= values.len() or item >= values.len():
                return Err("invalid_semantic_output")
            match values[prior]:
                case SdnValue.Array(items):
                    # Build a fresh list: a nested array must never mutate a
                    # previously committed semantic value through aliasing.
                    var next: [SdnValue] = []
                    for element in items: next.push(element)
                    next.push(values[item])
                    values.push(SdnValue.Array(next))
                case _: return Err("invalid_semantic_output")
        else:
            if node.child_count != 0: return Err("invalid_semantic_output")
            if node.kind == 100:
                values.push(SdnValue.Array([]))
            elif node.kind == 110:
                values.push(SdnValue.Dict({}))
            elif node.kind == 200:
                values.push(SdnValue.Null)
            elif node.kind == 201:
                values.push(SdnValue.Bool(true))
            elif node.kind == 202:
                values.push(SdnValue.Bool(false))
            elif node.kind == 203:
                values.push(SdnValue.Int(sdn_integer_from_span_v1(bytes, node.start, node.count)?))
            elif node.kind == 206:
                if node.start < 0 or node.count < 2 or node.start + node.count > bytes.len():
                    return Err("invalid_semantic_output")
                val spelling = source.substring(node.start + 1, node.start + node.count - 1)
                values.push(SdnValue.String(sdn_unescape_scalar_v1(spelling)))
            elif node.kind == 205:
                if node.start < 0 or node.count <= 0 or node.start + node.count > bytes.len():
                    return Err("invalid_semantic_output")
                val spelling = source.substring(node.start, node.start + node.count)
                values.push(SdnValue.Float(spelling.to_float()))
            elif node.kind == 204:
                if node.start < 0 or node.count <= 0 or node.start + node.count > bytes.len():
                    return Err("invalid_semantic_output")
                values.push(SdnValue.String(source.substring(node.start, node.start + node.count)))
            else:
                return Err("invalid_semantic_output")
    val root = output.roots[0]
    if root < 0 or root != values.len() - 1: return Err("invalid_semantic_output")
    Ok(values[root])

pub fn sdn_inline_parse_checked_v2(source: text,
    limits: ParseProgramLimitsV1) -> Result<SdnInlineCandidateV2, SdnInlineIssueV2>:
    val tokens = sdn_inline_lex_checked_v2(source, limits)?
    val validation = _inline_program_v2(limits)
    if validation.is_err():
        return Err(SdnInlineIssueV2(phase: "program", code: validation.unwrap_err(), start: -1, count: 0))
    val program = validation.unwrap()
    val parsed = parse_grammar_execute_v2(program, parse_source_blob_from_text(source), tokens, 0, limits)
    if not parsed.ok:
        return Err(SdnInlineIssueV2(phase: "grammar", code: parsed.error, start: -1, count: 0))
    val projected = _inline_value_v2(source, parsed.output)
    if projected.is_err():
        return Err(SdnInlineIssueV2(phase: "projection", code: projected.unwrap_err(), start: -1, count: 0))
    val value = projected.unwrap()
    Ok(SdnInlineCandidateV2(value: value, tokens: tokens,
        syntax: parsed.output, grammar_steps: parsed.steps_used))

pub fn sdn_inline_parse_candidate_v2(source: text,
    limits: ParseProgramLimitsV1) -> Result<SdnInlineCandidateV2, text>:
    val result = sdn_inline_parse_checked_v2(source, limits)
    if result.is_err(): return Err(result.unwrap_err().code)
    Ok(result.unwrap())

export SdnInlineCandidateV2, SdnInlineIssueV2, sdn_inline_parse_candidate_v2, sdn_inline_parse_checked_v2
