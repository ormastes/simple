"""Versioned strict SDN syntax boundary; no schema or receipt trust is inferred."""

pub struct SdnStrictLimitsV1:
    max_source_bytes: i64 = 1048576
    max_depth: i64 = 64
    max_nodes: i64 = 250000
    max_rows: i64 = 100000
    max_cells: i64 = 1000000
    max_columns: i64 = 256

pub struct SdnStrictIssueV1:
    code: text
    message: text
    offset: i64
    line: i64
    column: i64

pub struct SdnStrictDocumentV1:
    value: SdnValue
    consumed_bytes: i64
    nodes: i64
    rows: i64
    cells: i64

use std.common.sdn.value.{SdnValue}

pub fn sdn_strict_limits_v1() -> SdnStrictLimitsV1:
    SdnStrictLimitsV1()

export SdnStrictLimitsV1, SdnStrictIssueV1, SdnStrictDocumentV1, sdn_strict_limits_v1
