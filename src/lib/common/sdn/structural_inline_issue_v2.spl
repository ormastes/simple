"""Candidate issue coordinates are zero-based UTF-8 byte offsets.

A negative start means the phase cannot provide a source location. A zero
count at a nonnegative start denotes an exact empty span, not missing data.
"""
pub struct SdnInlineIssueV2:
    phase: text
    code: text
    start: i64
    count: i64

export SdnInlineIssueV2
