"""Pure scalar conversion shared by legacy SDN and opt-in grammar candidates.

This module does not tokenize source or decide grammar acceptance.
"""
pub fn sdn_integer_from_span_v1(bytes: [u8], start: i64, count: i64) -> Result<i64, text>:
    if start < 0 or count <= 0 or start > bytes.len() or count > bytes.len() - start:
        return Err("invalid_integer_span")
    var cursor = start
    val negative = bytes[cursor] == 45u8
    if negative: cursor = cursor + 1
    if cursor == start + count: return Err("invalid_integer_span")
    # Accumulate negatively so INT64_MIN is representable. Guard before every
    # multiply/subtract; conversion never relies on overflow or text.to_int.
    var value: i64 = 0
    while cursor < start + count:
        val byte = bytes[cursor]
        if byte < 48u8 or byte > 57u8: return Err("invalid_integer_span")
        val digit = (byte - 48u8) as i64
        val last_digit = if negative: 8 else: 7
        if value < -922337203685477580 or
            (value == -922337203685477580 and digit > last_digit):
            return Err("integer_overflow")
        value = value * 10 - digit
        cursor = cursor + 1
    if negative: Ok(value) else: Ok(-value)


export sdn_integer_from_span_v1

pub fn sdn_unescape_scalar_v1(s: text) -> text:
    if not s.contains("\\"):
        return s
    # Accumulate parts and join ONCE; the old `out = out + ch` per character
    # was O(n^2) on every escaped string (each concat re-copied the prefix).
    var parts: [text] = []
    var i = 0
    while i < s.len():
        val ch = s.substring(i, i + 1)
        if ch == "\\" and i + 1 < s.len():
            val nx = s.substring(i + 1, i + 2)
            if nx == "n":
                parts.push("\n")
            else:
                if nx == "t":
                    parts.push("\t")
                else:
                    if nx == "r":
                        parts.push("\r")
                    else:
                        if nx == "\"" or nx == "\\":
                            parts.push(nx)
                        else:
                            parts.push(ch + nx)
            i = i + 2
        else:
            parts.push(ch)
            i = i + 1
    parts.join("")

export sdn_unescape_scalar_v1

pub fn sdn_decode_quoted_scalar_v1(source: text) -> Result<text, text>:
    """Decode one complete quoted scalar using the shared escape rules.

    An escaped quote does not terminate the scalar. Missing closing quotes and
    text after the closing quote are errors. Legacy unknown-escape and raw
    multiline content semantics are retained by the shared unescape function.
    """
    if not source.starts_with("\""):
        return Err("invalid quoted scalar")
    var cursor = 1
    while cursor < source.len():
        val ch = source.substring(cursor, cursor + 1)
        if ch == "\\":
            cursor = cursor + 2
        else:
            if ch == "\"":
                if cursor != source.len() - 1:
                    return Err("trailing content after quoted scalar")
                return Ok(sdn_unescape_scalar_v1(source.slice(1, cursor)))
            cursor = cursor + 1
    Err("unterminated quoted scalar")

export sdn_decode_quoted_scalar_v1

pub fn sdn_float_spelling_v1(spelling: text) -> bool:
    var index = 0
    if spelling.starts_with("-") or spelling.starts_with("+"): index = 1
    var digits = 0
    while index < spelling.len() and spelling.byte_at(index) >= 48 and spelling.byte_at(index) <= 57:
        index = index + 1
        digits = digits + 1
    var fractional = false
    if index < spelling.len() and spelling.byte_at(index) == 46:
        fractional = true
        index = index + 1
        while index < spelling.len() and spelling.byte_at(index) >= 48 and spelling.byte_at(index) <= 57:
            index = index + 1
            digits = digits + 1
    if digits == 0: return false
    var exponent = false
    if index < spelling.len() and (spelling.byte_at(index) == 101 or spelling.byte_at(index) == 69):
        exponent = true
        index = index + 1
        if index < spelling.len() and (spelling.byte_at(index) == 43 or spelling.byte_at(index) == 45):
            index = index + 1
        val start = index
        while index < spelling.len() and spelling.byte_at(index) >= 48 and spelling.byte_at(index) <= 57:
            index = index + 1
        if index == start: return false
    index == spelling.len() and (fractional or exponent)

export sdn_float_spelling_v1
