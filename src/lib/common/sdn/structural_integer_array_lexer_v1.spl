"""Exact byte-span adapter over the existing SDN lexer, for an ASCII subset.

The SDN lexer exposes kind/text but no source offsets. Restricting this adapter
to ASCII makes its substring indices and source byte positions agree. Recover
each span at the current cursor after spaces/tabs only; never search ahead.
Newline, comments, strings, nested collections, and noninteger words are outside
this candidate's single-line integer-array scope. The legacy lexer is unchanged.
"""
use std.common.sdn.structural_inline_lexer_v2.{sdn_inline_lex_v2}
use std.common.structural.parse.parse_types.{ParseTokenArena}
use std.common.structural.parse.program_v1.{ParseProgramLimitsV1}

pub val SDN_INTEGER_TOKEN_V1: u16 = 1u16
pub val SDN_OPEN_TOKEN_V1: u16 = 2u16
pub val SDN_CLOSE_TOKEN_V1: u16 = 3u16
pub val SDN_COMMA_TOKEN_V1: u16 = 4u16

pub fn sdn_integer_array_lex_v1(source: text, limits: ParseProgramLimitsV1) -> Result<ParseTokenArena, text>:
    sdn_inline_lex_v2(source, limits, false)

export SDN_INTEGER_TOKEN_V1, SDN_OPEN_TOKEN_V1, SDN_CLOSE_TOKEN_V1, SDN_COMMA_TOKEN_V1
export sdn_integer_array_lex_v1
