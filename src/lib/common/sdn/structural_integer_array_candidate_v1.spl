"""Opt-in SDN integer-array vertical slice; never a replacement SDN parser.

Pipeline: actual SDN lexer -> checked byte spans -> transactional grammar/action
VM -> exact SdnValue.Array projection. No call to the legacy parser occurs here.
Scope: one ASCII line, spaces/tabs, decimal i64 values with optional minus,
brackets, and comma separators. Empty arrays and leading zeroes are supported.
Malformed delimiters can differ from the permissive legacy parser; tests retain
those divergences and this candidate remains unadmitted. Full SDN, diagnostics,
lexer modes, and optimized arena/choice execution are not qualified by this slice.
"""
use std.common.sdn.structural_scalar_value_v1.{sdn_integer_from_span_v1}
use std.common.sdn.value.{SdnValue}
use std.common.sdn.structural_integer_array_lexer_v1.{sdn_integer_array_lex_v1}
use std.common.structural.parse.dialect.{GrammarProgram, ActionProgram}
use std.common.structural.parse.parse_types.{ParseTokenArena, parse_source_blob_from_text}
use std.common.structural.parse.program_v1.*
use std.common.structural.parse.program_output_v1.{ParseProgramOutputV1}
use std.common.structural.parse.grammar_cpu_v1.{parse_grammar_execute_v1}

pub struct SdnIntegerArrayCandidateV1:
    value: SdnValue
    tokens: ParseTokenArena
    syntax: ParseProgramOutputV1
    grammar_steps: i64

fn _integer_array_program_v1(limits: ParseProgramLimitsV1) -> Result<ParseProgramV1, text>:
    # Rule 0: '[' (integer (',' integer)*)? ']'. Rule 1 folds one item
    # onto a private two-child list node. No host parser decides acceptance.
    val grammar = GrammarProgram(contract_version: 1, entry_rules: [0], production_offsets: [0, 33, 42], opcodes: [
        PG_MATCH_BYTE_V1, 91, 0,
        PG_ACTION_V1, 0, 0,
        PG_CHOICE_V1, 27, 0,
        PG_CALL_V1, 1, 0,
        PG_COMMIT_V1, 15, 0,
        PG_CHOICE_V1, 27, 0,
        PG_MATCH_BYTE_V1, 44, 0,
        PG_CALL_V1, 1, 0,
        PG_COMMIT_V1, 15, 0,
        PG_MATCH_BYTE_V1, 93, 0,
        PG_END_V1, 0, 0,
        PG_MATCH_KIND_V1, 1, 0,
        PG_ACTION_V1, 1, 0,
        PG_RETURN_V1, 0, 0])
    val actions = ActionProgram(contract_version: 1, action_offsets: [0, 3, 9], opcodes: [
        PA_NODE_V1, 100, 0,
        PA_CAPTURE_V1, 101, 0, PA_NODE_V1, 102, 2])
    parse_program_validate_v1(grammar, actions, limits)


fn _array_from_output_v1(bytes: [u8], output: ParseProgramOutputV1) -> Result<SdnValue, text>:
    if output.roots.len() != 1 or output.diagnostics.len() != 0:
        return Err("invalid_semantic_output")
    var cursor = output.roots[0]
    if cursor != output.nodes.len() - 1: return Err("invalid_semantic_output")
    var reversed: [i64] = []
    var complete = false
    while not complete:
        if cursor < 0 or cursor >= output.nodes.len(): return Err("invalid_semantic_output")
        val node = output.nodes[cursor]
        if node.kind == 100:
            if cursor != 0 or node.child_count != 0: return Err("invalid_semantic_output")
            complete = true
        elif node.kind == 102:
            if node.child_count != 2 or node.child_start < 0 or
                output.children.len() < 2 or node.child_start > output.children.len() - 2:
                return Err("invalid_semantic_output")
            val prior = output.children[node.child_start]
            val item = output.children[node.child_start + 1]
            if prior < 0 or prior >= cursor or item < 0 or item >= cursor:
                return Err("invalid_semantic_output")
            val leaf = output.nodes[item]
            if leaf.kind != 101 or leaf.child_count != 0: return Err("invalid_semantic_output")
            val value = sdn_integer_from_span_v1(bytes, leaf.start, leaf.count)?
            reversed.push(value)
            cursor = prior
        else:
            return Err("invalid_semantic_output")
    if output.nodes.len() != 1 + 2 * reversed.len() or output.children.len() != 2 * reversed.len():
        return Err("invalid_semantic_output")
    var values: [SdnValue] = []
    var i = reversed.len()
    while i > 0:
        i = i - 1
        values.push(SdnValue.Int(reversed[i]))
    Ok(SdnValue.Array(values))

pub fn sdn_integer_array_parse_candidate_v1(source: text,
    limits: ParseProgramLimitsV1) -> Result<SdnIntegerArrayCandidateV1, text>:
    val tokens = sdn_integer_array_lex_v1(source, limits)?
    val program = _integer_array_program_v1(limits)?
    val source_blob = parse_source_blob_from_text(source)
    val parsed = parse_grammar_execute_v1(program, source_blob, tokens, 0, limits)
    if not parsed.ok: return Err(parsed.error)
    val value = _array_from_output_v1(source_blob.bytes, parsed.output)?
    Ok(SdnIntegerArrayCandidateV1(value: value, tokens: tokens,
        syntax: parsed.output, grammar_steps: parsed.steps_used))

export SdnIntegerArrayCandidateV1, sdn_integer_array_parse_candidate_v1
