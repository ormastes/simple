"""Resource validation for constructed SDN values, without source provenance."""
use std.common.sdn.value.{SdnValue}
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1, SdnStrictIssueV1}
use std.common.sdn.strict_v1.{sdn_strict_limits_valid_v1}

fn sdn_value_dictionary_count_v1(fields: Dict<text, SdnValue>) -> i64:
    # Explicit receiver type preserves allocation-free dictionary cardinality.
    # Current Phase2 probes and exact-node controls verify this primitive.
    fields.len()

class SdnValueBudgetV1:
    limits: SdnStrictLimitsV1
    nodes: i64 = 0
    rows: i64 = 0
    cells: i64 = 0
    text_bytes: i64 = 0
    fn issue(code: text) -> SdnStrictIssueV1:
        SdnStrictIssueV1(code: code, message: "Constructed SDN value exceeds " + code, offset: 0, line: 0, column: 0)
    me charge(depth: i64) -> Result<bool, SdnStrictIssueV1>:
        if depth > self.limits.max_depth: return Err(self.issue("depth_limit"))
        if self.nodes >= self.limits.max_nodes: return Err(self.issue("node_limit"))
        self.nodes = self.nodes + 1
        Ok(true)
    me charge_text(item: text) -> Result<bool, SdnStrictIssueV1>:
        val size = item.len()
        if size < 0: return Err(self.issue("invalid_value"))
        # Constructed values have no source spelling; cap retained text bytes
        # using the strict byte ceiling without inventing source provenance.
        if size > self.limits.max_source_bytes - self.text_bytes: return Err(self.issue("text_limit"))
        self.text_bytes = self.text_bytes + size
        Ok(true)
    me visit(value: SdnValue, depth: i64) -> Result<bool, SdnStrictIssueV1>:
        self.charge(depth)?
        match value:
            case Dict(fields):
                val count = sdn_value_dictionary_count_v1(fields)
                if count < 0: return Err(self.issue("invalid_value"))
                if count > (self.limits.max_nodes - self.nodes) / 2: return Err(self.issue("node_limit"))
                val names = fields.keys()
                if names.len() != count: return Err(self.issue("invalid_value"))
                for name in names:
                    self.charge_text(name)?
                    self.charge(depth + 1)?
                    self.visit(fields[name], depth + 1)?
            case String(item): self.charge_text(item)?
            case Array(items):
                if items.len() > self.limits.max_nodes - self.nodes: return Err(self.issue("node_limit"))
                for item in items: self.visit(item, depth + 1)?
            case Table(headers, rows):
                if headers.len() > self.limits.max_columns: return Err(self.issue("column_limit"))
                for header in headers:
                    self.charge_text(header)?
                    self.charge(depth + 1)?
                if rows.len() > self.limits.max_rows - self.rows: return Err(self.issue("row_limit"))
                self.rows = self.rows + rows.len()
                for row in rows:
                    if row.len() != headers.len(): return Err(self.issue("row_width"))
                    if row.len() > self.limits.max_cells - self.cells: return Err(self.issue("cell_limit"))
                    self.cells = self.cells + row.len()
                    for cell in row: self.visit(cell, depth + 1)?
            case _: ()
        Ok(true)

pub fn sdn_validate_value_limits_v1(value: SdnValue, limits: SdnStrictLimitsV1) -> Result<bool, SdnStrictIssueV1>:
    if not sdn_strict_limits_valid_v1(limits):
        return Err(SdnStrictIssueV1(code: "invalid_limits", message: "SDN limits outside hard bounds", offset: 0, line: 0, column: 0))
    var budget = SdnValueBudgetV1(limits: limits)
    budget.visit(value, 1)

export sdn_validate_value_limits_v1
