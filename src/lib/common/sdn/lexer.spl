# SDN Lexer — tokenize SDN source text.
#
# Provides: Token, TokenKind, Lexer, tokenize.

pub enum TokenKind:
    Word
    Colon
    LBracket
    RBracket
    LBrace
    RBrace
    Comma
    Newline

pub class Token:
    kind: TokenKind
    text: text

    static fn make(kind: TokenKind, text: text) -> Token:
        Token(kind: kind, text: text)

pub class Lexer:
    source: text

    static fn new(source: text) -> Lexer:
        Lexer(source: source)

    fn run(self) -> [Token]:
        tokenize(self.source)

fn _punct_kind(ch: text) -> TokenKind:
    if ch == ":":
        return TokenKind.Colon
    if ch == "[":
        return TokenKind.LBracket
    if ch == "]":
        return TokenKind.RBracket
    if ch == "{{":
        return TokenKind.LBrace
    if ch == "}}":
        return TokenKind.RBrace
    if ch == ",":
        return TokenKind.Comma
    TokenKind.Newline

fn tokenize(source: text) -> [Token]:
    var tokens: [Token] = []
    val n = source.byte_len()
    var word_start = -1
    var i = 0
    while i < n:
        val b = source.byte_at(i)
        if b == 32 or b == 9:
            if word_start >= 0:
                tokens.push(Token.make(TokenKind.Word, source.slice(word_start, i)))
                word_start = -1
        elif b == 58 or b == 91 or b == 93 or b == 123 or b == 125 or b == 44 or b == 10:
            if word_start >= 0:
                tokens.push(Token.make(TokenKind.Word, source.slice(word_start, i)))
                word_start = -1
            val ch = source.slice(i, i + 1)
            tokens.push(Token.make(_punct_kind(ch), ch))
        else:
            if word_start < 0:
                word_start = i
        i = i + 1
    if word_start >= 0:
        tokens.push(Token.make(TokenKind.Word, source.slice(word_start, n)))
    tokens
