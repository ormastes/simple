"""Actual SDN lexer adapter for a deliberately bounded ASCII inline subset.

Offsets are recovered in order, never searched. The opt-in quote mode retains
complete escaped string tokens. Block mappings, tables, comments, Unicode and
multiline source remain outside this candidate.
"""
use std.common.sdn.structural_inline_issue_v2.{SdnInlineIssueV2}
use std.common.sdn.lexer.{tokenize, TokenKind, Token}
use std.common.structural.parse.parse_types.{ParseTokenArena, PARSE_SCHEMA_ID}
use std.common.structural.parse.program_v1.{ParseProgramLimitsV1, parse_program_limits_valid_v1}

pub val SDN_INTEGER_TOKEN_V1: u16 = 1u16
pub val SDN_OPEN_TOKEN_V1: u16 = 2u16
pub val SDN_CLOSE_TOKEN_V1: u16 = 3u16
pub val SDN_COMMA_TOKEN_V1: u16 = 4u16

fn _integer_spelling_v1(bytes: [u8]) -> bool:
    if bytes.len() == 0: return false
    var i = 0
    if bytes[0] == 45u8: i = 1
    if i == bytes.len(): return false
    while i < bytes.len():
        if bytes[i] < 48u8 or bytes[i] > 57u8: return false
        i = i + 1
    true

fn _decimal_spelling_v2(bytes: [u8]) -> bool:
    var dots = 0
    var digits = 0
    var i = 0
    if bytes.len() > 0 and bytes[0] == 45u8: i = 1
    while i < bytes.len():
        if bytes[i] == 46u8:
            dots = dots + 1
        elif bytes[i] >= 48u8 and bytes[i] <= 57u8:
            digits = digits + 1
        else:
            return false
        i = i + 1
    dots == 1 and digits > 0

# Candidate-local string mode. Ordinary source runs are tokenized by the
# production SDN tokenizer. Quoted runs are single source tokens with escapes
# retained; neither this mode nor span recovery decides collection syntax.
fn _inline_tokens_v2(source: text) -> Result<[Token], SdnInlineIssueV2>:
    var tokens: [Token] = []
    var cursor = 0
    var run_start = 0
    while cursor < source.len():
        if source.substring(cursor, cursor + 1) != "\"":
            cursor = cursor + 1
            continue
        for token in tokenize(source.substring(run_start, cursor)): tokens.push(token)
        val start = cursor
        cursor = cursor + 1
        var closed = false
        while cursor < source.len():
            val ch = source.substring(cursor, cursor + 1)
            if ch == "\n" or ch == "\r": return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_multiline", start: cursor, count: 1))
            if ch == "\\":
                cursor = cursor + 2
            elif ch == "\"":
                cursor = cursor + 1
                closed = true
                break
            else:
                cursor = cursor + 1
        if not closed: return Err(SdnInlineIssueV2(phase: "lex", code: "unterminated_quoted_string", start: start, count: source.len() - start))
        tokens.push(Token.make(TokenKind.Word, source.substring(start, cursor)))
        run_start = cursor
    for token in tokenize(source.substring(run_start, cursor)): tokens.push(token)
    Ok(tokens)

pub fn sdn_inline_lex_checked_v2(source: text, limits: ParseProgramLimitsV1, allow_words: bool = true) -> Result<ParseTokenArena, SdnInlineIssueV2>:
    if not parse_program_limits_valid_v1(limits): return Err(SdnInlineIssueV2(phase: "limits", code: "invalid_limits", start: -1, count: 0))
    val bytes = source.bytes()
    if bytes.len() > limits.max_source_bytes: return Err(SdnInlineIssueV2(phase: "limits", code: "source_capacity", start: -1, count: 0))
    var offset = 0
    while offset < bytes.len():
        val byte = bytes[offset]
        if byte >= 128u8:
            # Text input is UTF-8. Include the complete first non-ASCII scalar;
            # never report only its leading byte or a character-index offset.
            var end = offset + 1
            while end < bytes.len() and bytes[end] >= 128u8 and bytes[end] < 192u8:
                end = end + 1
            return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_non_ascii", start: offset, count: end - offset))
        if allow_words and (byte == 10u8 or byte == 13u8):
            val width = if byte == 13u8 and offset + 1 < bytes.len() and bytes[offset + 1] == 10u8: 2 else: 1
            return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_multiline", start: offset, count: width))
        offset = offset + 1
    # Existing production lexer output, never synthetic test tokens. Its
    # temporary token allocation is bounded by source size, not max_tokens.
    val lexed = if allow_words: _inline_tokens_v2(source)? else: tokenize(source)
    var kinds: [u16] = []
    var starts: [u32] = []
    var counts: [u32] = []
    var cursor = 0
    for token in lexed:
        while cursor < bytes.len() and (bytes[cursor] == 32u8 or bytes[cursor] == 9u8):
            cursor = cursor + 1
        val spelling = token.text.bytes()
        if spelling.len() == 0 or spelling.len() > bytes.len() - cursor:
            return Err(SdnInlineIssueV2(phase: "lex", code: "lexer_source_mismatch", start: -1, count: 0))
        var i = 0
        while i < spelling.len():
            if spelling[i] != bytes[cursor + i]: return Err(SdnInlineIssueV2(phase: "lex", code: "lexer_source_mismatch", start: -1, count: 0))
            i = i + 1
        val kind = match token.kind:
            case TokenKind.Word:
                if allow_words and spelling.len() >= 2 and spelling[0] == 34u8:
                    10u16
                elif _integer_spelling_v1(spelling):
                    SDN_INTEGER_TOKEN_V1
                elif allow_words and _decimal_spelling_v2(spelling):
                    if spelling.len() > 128: return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_float_magnitude", start: cursor, count: spelling.len()))
                    6u16
                else:
                    if not allow_words: return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_integer_spelling", start: cursor, count: spelling.len()))
                    for byte in spelling:
                        if byte == 34u8: return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_quoted_string", start: cursor, count: spelling.len()))
                        if not ((byte >= 65u8 and byte <= 90u8) or
                            (byte >= 97u8 and byte <= 122u8) or
                            (byte >= 48u8 and byte <= 57u8) or byte == 95u8 or byte == 45u8):
                            return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_word_spelling", start: cursor, count: spelling.len()))
                    5u16
            case TokenKind.LBracket: SDN_OPEN_TOKEN_V1
            case TokenKind.RBracket: SDN_CLOSE_TOKEN_V1
            case TokenKind.Comma: SDN_COMMA_TOKEN_V1
            case TokenKind.LBrace:
                if not allow_words: return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_token", start: cursor, count: spelling.len()))
                7u16
            case TokenKind.RBrace:
                if not allow_words: return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_token", start: cursor, count: spelling.len()))
                8u16
            case TokenKind.Colon:
                if not allow_words: return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_token", start: cursor, count: spelling.len()))
                9u16
            case TokenKind.Newline: return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_multiline", start: cursor, count: spelling.len()))
            case _: return Err(SdnInlineIssueV2(phase: "lex", code: "unsupported_token", start: cursor, count: spelling.len()))
        if kinds.len() >= limits.max_tokens: return Err(SdnInlineIssueV2(phase: "limits", code: "token_capacity", start: cursor, count: spelling.len()))
        kinds.push(kind)
        starts.push(cursor as u32)
        counts.push(spelling.len() as u32)
        cursor = cursor + spelling.len()
    while cursor < bytes.len() and (bytes[cursor] == 32u8 or bytes[cursor] == 9u8):
        cursor = cursor + 1
    if cursor != bytes.len(): return Err(SdnInlineIssueV2(phase: "lex", code: "lexer_source_underfill", start: cursor, count: 0))
    Ok(ParseTokenArena(schema_id: PARSE_SCHEMA_ID, kind: kinds, start: starts, count: counts))

# Compatibility boundary: existing integer-array and inline callers retain
# their exact error codes without running the tokenizer a second time.
pub fn sdn_inline_lex_v2(source: text, limits: ParseProgramLimitsV1, allow_words: bool = true) -> Result<ParseTokenArena, text>:
    val result = sdn_inline_lex_checked_v2(source, limits, allow_words)
    if result.is_err(): return Err(result.unwrap_err().code)
    Ok(result.unwrap())

export sdn_inline_lex_v2, sdn_inline_lex_checked_v2
