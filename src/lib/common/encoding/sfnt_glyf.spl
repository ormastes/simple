    e[b + 8] = shift - 1
    e[b + 9] = w
    e[b + 10] = (x0 * 1024) >> 2
    e[b + 11] = ((((y0 * 1024) >> 2) + 8192) >> 14) << 14
    e[b + 12] = ((x1 - x0) * 1024 + (ax >> shift)) >> 2
    e[b + 13] = ((y1 - y0) * 1024 + (ay >> shift)) >> 2
    e[b + 14] = (ax >> (shift - 1)) >> 2
    e[b + 15] = (ay >> (shift - 1)) >> 2
    e[b + 16] = (x2 * 1024) >> 2
    e[b + 17] = ((((y2 * 1024) >> 2) + 8192) >> 14) << 14
    e[b + 18] = e[b + 10]
    e[b + 19] = e[b + 11]
    e[b + 22] = 1
    _aaa_update_quad(e, b)

# SkEdgeBuilder::combineVertical: 0 keep the new edge, 1 merged into `l`,
# 2 the two cancel (drop both).
fn _aaa_combine_vertical(e: [i64], n: i64, l: i64) -> i64:
    if e[l + 22] != 0 or e[l + 1] != 0 or e[n] != e[l]: return 0
    if e[n + 9] == e[l + 9]:
        if e[n + 5] == e[l + 4]:
            e[l + 4] = e[n + 4]
            e[l + 3] = e[l + 4]
            return 1
        if (if (e[n + 4] - e[l + 5]) < 0: 0 - (e[n + 4] - e[l + 5]) else: (e[n + 4] - e[l + 5])) < 256:
            e[l + 5] = e[n + 5]
            return 1
        return 0
    if (if (e[n + 4] - e[l + 4]) < 0: 0 - (e[n + 4] - e[l + 4]) else: (e[n + 4] - e[l + 4])) < 256:
        if (if (e[n + 5] - e[l + 5]) < 0: 0 - (e[n + 5] - e[l + 5]) else: (e[n + 5] - e[l + 5])) < 256: return 2
        if e[n + 5] < e[l + 5]:
            e[l + 4] = e[n + 5]
            e[l + 3] = e[l + 4]
            return 1
        e[l + 4] = e[l + 5]
        e[l + 3] = e[l + 4]
        e[l + 5] = e[n + 5]
        e[l + 9] = e[n + 9]
        return 1
    if (if (e[n + 5] - e[l + 5]) < 0: 0 - (e[n + 5] - e[l + 5]) else: (e[n + 5] - e[l + 5])) < 256:
        if e[n + 4] > e[l + 4]:
            e[l + 5] = e[n + 4]
            return 1
        e[l + 5] = e[l + 4]
        e[l + 4] = e[n + 4]
        e[l + 3] = e[l + 4]
        e[l + 9] = e[n + 9]
        return 1
    0

# Edge count after adding the line a->b (edges live at slots 2..).
fn _aaa_push_line(e: [i64], n: i64, ax: f64, ay: f64, bx: f64, by: f64) -> i64:
    # SkAnalyticEdge::setLine into slot n + 2, inline.
    val b = (n + 2) * 24
    var x0 = ((((((ax * 4.0) as f32) as f64) * 64.0) as i64)) * 256
    var y0 = (((((((((ay * 4.0) as f32) as f64) * 64.0) as i64)) * 256) + 8192) >> 14) << 14
    var x1 = ((((((bx * 4.0) as f32) as f64) * 64.0) as i64)) * 256
    var y1 = (((((((((by * 4.0) as f32) as f64) * 64.0) as i64)) * 256) + 8192) >> 14) << 14
    var w = 1
    if y0 > y1:
        val tx = x0
        x0 = x1
        x1 = tx
        val ty = y0
        y0 = y1
        y1 = ty
        w = -1
    val dy = (y1 - y0) >> 10
    if dy == 0: return n
    val dx = (x1 - x0) >> 10
    # QuickSkFDot6Div (dy > 0), fast path inline; then SkAnalyticEdge fields.
    val adx = if dx < 0: 0 - dx else: dx
    val slope = if dy >= 8 and dy < 1024 and adx < 4096: (dx * (4194304 / dy)) >> 6 else: _aaa_quick_div(dx, dy)
    val abs_slope = if slope < 0: 0 - slope else: slope
    e[b] = x0
    e[b + 1] = slope
    e[b + 2] = x0
    e[b + 3] = y0
    e[b + 4] = y0
    e[b + 5] = y1
    if dx == 0 or slope == 0:
        e[b + 6] = 2147483647
    elif abs_slope < 1024:
        e[b + 6] = if abs_slope == 0: 0 else: 4194304 / abs_slope
    else:
        val q = _aaa_quick_div(dy, dx)
        e[b + 6] = if q < 0: 0 - q else: q
    e[b + 7] = 0
    e[b + 8] = 0
    e[b + 9] = w
    e[b + 22] = 0
    if slope == 0 and n > 0:
        val c = _aaa_combine_vertical(e, b, b - 24)
        if c == 2: return n - 1
        if c == 1: return n
    n + 1

# SkChopQuadAtYExtrema (f32), then one edge per monotonic piece.
fn _aaa_push_quad(e: [i64], n: i64, p0x: f64, p0y: f64, p1x: f64, p1y: f64, p2x: f64, p2y: f64) -> i64:
    val ab = (((p0y - p1y) as f32) as f64)
    var bc = (((p1y - p2y) as f32) as f64)
    if ab < 0.0: bc = 0.0 - bc
    if not (ab == 0.0 or bc < 0.0):
        return if _aaa_set_quad(e, (n + 2) * 24, p0x, p0y, p1x, p1y, p2x, p2y): n + 1 else: n
    var numer = ab
    var denom = ((((((ab - p1y) as f32) as f64) + p2y) as f32) as f64)
    if numer < 0.0:
        numer = 0.0 - numer
        denom = 0.0 - denom
    if not (denom == 0.0 or numer == 0.0 or numer >= denom):
        val t = (((numer / denom) as f32) as f64)
        if t != 0.0:
            val ax = ((((p0x + ((((((p1x - p0x) as f32) as f64) * t) as f32) as f64)) as f32) as f64))
            val ay = ((((p0y + ((((((p1y - p0y) as f32) as f64) * t) as f32) as f64)) as f32) as f64))
            val cx = ((((p1x + ((((((p2x - p1x) as f32) as f64) * t) as f32) as f64)) as f32) as f64))
            val cy = ((((p1y + ((((((p2y - p1y) as f32) as f64) * t) as f32) as f64)) as f32) as f64))
            val mx = ((((ax + ((((((cx - ax) as f32) as f64) * t) as f32) as f64)) as f32) as f64))
            val my = ((((ay + ((((((cy - ay) as f32) as f64) * t) as f32) as f64)) as f32) as f64))
            val n1 = if _aaa_set_quad(e, (n + 2) * 24, p0x, p0y, ax, my, mx, my): n + 1 else: n
            return if _aaa_set_quad(e, (n1 + 2) * 24, mx, my, cx, my, p2x, p2y): n1 + 1 else: n1
    var fa = (((p0y - p1y) as f32) as f64)
    var fb = (((p1y - p2y) as f32) as f64)
    if fa < 0.0: fa = 0.0 - fa
    if fb < 0.0: fb = 0.0 - fb
    if _aaa_set_quad(e, (n + 2) * 24, p0x, p0y, p1x, if fa < fb: p0y else: p2y, p2x, p2y): n + 1 else: n

# --- blitter -----------------------------------------------------------------

fn _aaa_so(o: [i64], i: i64, aa: i64):
    if aa == 0: return
    if aa == 255:
        o[i] = 255
        return
    val p = (255 - aa) * o[i]
    o[i] = aa + (((p + 128) * 257) >> 16)

fn _aaa_real(o: [i64], x: i64, y: i64, aa: i64):
    val w = o[0]
    if x >= 0 and x < w and y >= 0 and y < o[1]:
        _aaa_so(o, 24 + w + y * (w + 32) + x, aa)

fn _aaa_flush(o: [i64]):
    val y = o[6]
    if y < 0: return
    val w = o[0]
    val row = 24 + w + y * (w + 32)
    var x = 0
    while x < w:
        # Untouched samples go four at a time: accumulated values are never
        # negative, and the 16 slots after the row are zero padding (a
        # counter or the outside of a 64 px gray glyph is most of the row).
        if o[8 + x] + o[9 + x] + o[10 + x] + o[11 + x] == 0:
            x = x + 4
        else:
            if o[8 + x] == 0:
                x = x + 1
            else:
                # A touched run is walked without the group test.
                while x < w and o[8 + x] != 0:
                    var a = o[8 + x]
                    if a > 247: a = 255
                    if a == 255:
                        o[row + x] = 255
                    elif a >= 8:
                        o[row + x] = a + (((((255 - a) * o[row + x]) + 128) * 257) >> 16)
                    o[8 + x] = 0
                    x = x + 1
    o[6] = -1

fn _aaa_check_y(o: [i64], y: i64):
    if y != o[6]:
        _aaa_flush(o)
        o[6] = y

fn _aaa_acc(o: [i64], x: i64, a: i64):
    val t = o[8 + x] + a
    o[8 + x] = if o[3] == 1: _aaa_min(255, t) else: (t - (t >> 8)) & 255

fn _aaa_add_safe_n(o: [i64], x: i64, y: i64, n: i64, a: i64):
    _aaa_check_y(o, y)
    if x >= o[4] and x + n <= o[5]:
        var i = 0
        while i < n:
            _aaa_acc(o, x + i, a)
            i = i + 1

fn _aaa_mask_at(o: [i64], x: i64, y: i64) -> i64:
    val w = o[0]
    24 + w + (w + 32) * (o[1] + y) + x

fn _aaa_madd(o: [i64], x: i64, y: i64, a: i64):
    val i = _aaa_mask_at(o, x, y)
    val t = o[i] + a
    o[i] = (t - (t >> 8)) & 255

fn _aaa_add_n(o: [i64], x: i64, y: i64, n: i64, a: i64):
    if y < 0 or y >= o[1]: return
    if o[2] == 1:
        var i = 0
        while i < n:
            _aaa_madd(o, x + i, y, a)
            i = i + 1
    else:
        _aaa_add_safe_n(o, x, y, n, a)

fn _aaa_real_v(o: [i64], x: i64, y: i64, h: i64, a: i64):
    var i = 0
    while i < h:
        if o[2] == 1:
            if a != 0 and y + i >= 0 and y + i < o[1]: o[_aaa_mask_at(o, x, y + i)] = a
        else:
            _aaa_real(o, x, y + i, a)
        i = i + 1

fn _aaa_real_anti_rect(o: [i64], x: i64, y: i64, w: i64, h: i64, la: i64, ra: i64):
    if la > 0: _aaa_real_v(o, x, y, h, la)
    var i = 0
    while i < w:
        _aaa_real_v(o, x + 1 + i, y, h, 255)
        i = i + 1
    if ra > 0: _aaa_real_v(o, x + 1 + w, y, h, ra)


# One coverage write of an already-scaled alpha. `real`: a whole-row strip
# whose neighbours are not too close (Skia's real blitter write, src-over);
# otherwise accumulated (mask plane: saturating; RLE row: saturating, or
# overflow-catching on a convex path). `assign`: the mask blitter's
# blitSingle stores instead of adding. Leaf helpers are inlined here and in
# the walkers: a call costs ~4x a statement on the interpreter lane.
fn _aaa_put(o: [i64], y: i64, x: i64, a: i64, real: bool, assign: bool):
    val w = o[0]
    if o[2] == 1:
        val i = 24 + w + (w + 32) * (o[1] + y) + x
        if real and assign:
            o[i] = a
        else:
            val t = o[i] + a
            o[i] = if t > 255: 255 else: t
    elif real:
        if a != 0 and x >= 0 and x < w:
            val i = 24 + w + y * (w + 32) + x
            if a == 255:
                o[i] = 255
            else:
                o[i] = a + (((((255 - a) * o[i]) + 128) * 257) >> 16)
    else:
        if y != o[6]:
            _aaa_flush(o)
            o[6] = y
        if x >= o[4] and x < o[5]:
            val t = o[8 + x] + a
            if o[3] == 1:
                o[8 + x] = if t > 255: 255 else: t
            else:
                o[8 + x] = (t - (t >> 8)) & 255

fn _aaa_alpha_above(al: [i64], off: i64, l: i64, r: i64, dy: i64, full: i64):
    val rr = ((r + 65535) >> 16)
    if rr == 0: return
    if rr == 1:
        al[off] = (((((rr << 17) - l - r) >> 9) * full) >> 8) & 255
        return
    val first = 65536 - l
    val last = r - ((rr - 1) << 16)
    val first_h = ((first * dy) >> 16)
    al[off] = (((first * first_h) >> 16) >> 9) & 255
    var a16 = (if (first_h + (dy >> 1)) > 2147483647: 2147483647 else: (if (first_h + (dy >> 1)) < -2147483648: -2147483648 else: (first_h + (dy >> 1))))
    var i = 1
    while i < rr - 1:
        al[off + i] = (a16 >> 8) & 255
        a16 = (if (a16 + dy) > 2147483647: 2147483647 else: (if (a16 + dy) < -2147483648: -2147483648 else: (a16 + dy)))
        i = i + 1
    al[off + rr - 1] = (full - ((((last >> 11) * (last >> 11) * (dy >> 11)) >> 8) & 255)) & 255

fn _aaa_alpha_below(al: [i64], off: i64, l: i64, r: i64, dy: i64, full: i64):
    val rr = ((r + 65535) >> 16)
    if rr == 0: return
    if rr == 1:
        al[off] = ((((((l + r) / 2) >> 8) & 255) * full) >> 8) & 255
        return
    val first = 65536 - l
    val last = r - ((rr - 1) << 16)
    val last_h = ((last * dy) >> 16)
    al[off + rr - 1] = (((last * last_h) >> 16) >> 9) & 255
    var a16 = (if (last_h + (dy >> 1)) > 2147483647: 2147483647 else: (if (last_h + (dy >> 1)) < -2147483648: -2147483648 else: (last_h + (dy >> 1))))
    var i = rr - 2
    while i > 0:
        al[off + i] = (a16 >> 8) & 255
        a16 = (if (a16 + dy) > 2147483647: 2147483647 else: (if (a16 + dy) < -2147483648: -2147483648 else: (a16 + dy)))
        i = i - 1
    al[off] = (full - ((((first >> 11) * (first >> 11) * (dy >> 11)) >> 8) & 255)) & 255

fn _aaa_trap_row_general(o: [i64], y: i64, ul: i64, ur: i64, ll: i64, lr: i64, ldy: i64, rdy: i64, full: i64, nrb: bool):
    val left = ul >> 16
    val len = ((lr + 65535) >> 16) - left
    val real = full == 255 and not nrb
    if len == 1:
        val a = (((ur - ul + lr - ll) / 2) >> 8) & 255
        _aaa_put(o, y, left, if real: a else: (a * full) >> 8, real, true)
        return
    # Skia keeps alpha = full and subtracts the coverage outside each edge,
    # clamped at 0; `cut` holds the subtracted amount (clamped at full), so
    # the row starts as a zero fill and alpha is full - cut.
    var cut: [i64] = [0; len + 1]
    var tmp: [i64] = [0; len + 1]
    val ul_i = ul >> 16
    val ll_i = (ll + 65535) >> 16
    if ul_i + 2 == ll_i:
        val first = (ul_i << 16) + 65536 - ul
        val a1 = (full - ((((first >> 11) * (first >> 11) * (ldy >> 11)) >> 8) & 255)) & 255
        val a2 = (((((ll - ul - first) >> 11) * ((ll - ul - first) >> 11) * (ldy >> 11)) >> 8) & 255)
        cut[0] = if a1 < full: a1 else: full
        cut[1] = if a2 < full: a2 else: full
    elif ll_i > ul_i:
        _aaa_alpha_below(tmp, ul_i - left, ul - (ul_i << 16), ll - (ul_i << 16), ldy, full)
        var k = ul_i - left
        val stop = ll_i - left
        while k < stop:
            cut[k] = if tmp[k] < full: tmp[k] else: full
            k = k + 1
    val ur_i = ur >> 16
    val lr_i = (lr + 65535) >> 16
    if ur_i + 2 == lr_i:
        val first = (ur_i << 16) + 65536 - ur
        val c1 = cut[len - 2] + ((((first >> 11) * (first >> 11) * (rdy >> 11)) >> 8) & 255)
        val c2 = cut[len - 1] + ((full - (((((lr - ur - first) >> 11) * ((lr - ur - first) >> 11) * (rdy >> 11)) >> 8) & 255)) & 255)
        cut[len - 2] = if c1 < full: c1 else: full
        cut[len - 1] = if c2 < full: c2 else: full
    elif lr_i > ur_i:
        _aaa_alpha_above(tmp, ur_i - left, ur - (ur_i << 16), lr - (ur_i << 16), rdy, full)
        var k = ur_i - left
        val stop = lr_i - left
        while k < stop:
            val c = cut[k] + tmp[k]
            cut[k] = if c < full: c else: full
            k = k + 1
    val w = o[0]
    if o[2] == 1:
        var i = 0
        var m = 24 + w + (w + 32) * (o[1] + y) + left
        while i < len:
            val t = o[m] + full - cut[i]
            o[m] = if t > 255: 255 else: t
            m = m + 1
            i = i + 1
    elif real:
        var i = if left < 0: 0 - left else: 0
        val stop = if left + len > w: w - left else: len
        var m = 24 + w + y * (w + 32) + left + i
        while i < stop:
            val a = 255 - cut[i]
