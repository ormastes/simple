use std.common.encoding.sfnt.{OtFont, OtTable, read_u16_be, read_i16_be, find_table, parse_offset_table}
use std.common.encoding.sfnt_cmap.{sfnt_cmap_glyph_id, sfnt_cmap_glyph_ids_into}
use std.common.encoding.sfnt_kern.{sfnt_blob_kern_face_info, sfnt_kern_face_pair_size_milli_px}
use std.common.encoding.sfnt_af_latin.{AF_LATIN_BLUE_CHARS, AF_LATIN_STANDARD_CHAR, af_latin_face_metrics, af_latin_scaled_metrics, af_latin_hint_points, af_latin_is_nonbase}

pub val SFNT_GLYPH_SELECTOR_CODEPOINT: i64 = 0
pub val SFNT_GLYPH_SELECTOR_INDEX: i64 = 1

pub val SFNT_GLYF_MOVE: i64 = 0
pub val SFNT_GLYF_LINE: i64 = 1
pub val SFNT_GLYF_QUAD: i64 = 2
pub val SFNT_GLYF_CLOSE: i64 = 3

class SfntGlyfCommand:
    verb: i64
    x1: f64
    y1: f64
    x2: f64
    y2: f64

class SfntGlyfOutline:
    commands: [SfntGlyfCommand]
    components: i64
    # The glyf points behind `commands` for the autohinter: x, y, tag per point
    # in font units; tag bit 0 = on-curve, bit 1 = last point of its contour.
    sgo_points: [i64]

class SfntGlyfBitmap:
    # Unique prefixes prevent receiver-blind native field lookup from selecting
    # the same-named GlyphBitmap/CachedGlyph offsets after type erasure.
    sgb_width: i64
    sgb_height: i64
    sgb_advance: i64
    sgb_bearing_x: i64
    sgb_bearing_y: i64
    sgb_pixels: [u8]

# Native canary: unit return with caller-owned fixed-array outputs.
fn sfnt_glyf_void_transport_probe(mut meta: [i64], mut pixels: [u8]):
    if meta.len() < 6 or pixels.len() < 4:
        return
    meta[0] = 20260727
    meta[1] = 4
    meta[2] = 8
    meta[3] = 12
    meta[4] = 4
    meta[5] = 909090
    pixels[0] = 17u8
    pixels[1] = 34u8
    pixels[2] = 51u8
    pixels[3] = 68u8

fn _table_is_bounded(font: OtFont, table: OtTable, minimum: i64) -> bool:
    val start = table.offset as i64
    val length = table.length as i64
    start >= 0 and length >= minimum and start <= font.blob.len() and length <= font.blob.len() - start

fn _active_has(active: [u32], glyph_id: u32) -> bool:
    for value in active:
        if value == glyph_id:
            return true
    false

fn _command(verb: i64, x1: f64, y1: f64, x2: f64, y2: f64) -> SfntGlyfCommand:
    SfntGlyfCommand(verb: verb, x1: x1, y1: y1, x2: x2, y2: y2)

fn _append_transformed(dst: [SfntGlyfCommand], src: [SfntGlyfCommand], xx: f64, xy: f64, yx: f64, yy: f64, dx: f64, dy: f64) -> [SfntGlyfCommand]:
    var out = dst
    for command in src:
        if command.verb == SFNT_GLYF_CLOSE:
            out = out.push(command)
        else:
            out = out.push(_command(command.verb,
                xx * command.x1 + xy * command.y1 + dx,
                yx * command.x1 + yy * command.y1 + dy,
                xx * command.x2 + xy * command.y2 + dx,
                yx * command.x2 + yy * command.y2 + dy))
    out

# Composite component points: FreeType transforms and rounds them to font units.
fn _append_transformed_points(mut dst: [i64], src: [i64], xx: f64, xy: f64, yx: f64, yy: f64, dx: f64, dy: f64):
    var i: i64 = 0
    while i + 2 < src.len():
        val x = src[i] as f64
        val y = src[i + 1] as f64
        dst.push(_floor_glyf(xx * x + xy * y + dx + 0.5))
        dst.push(_floor_glyf(yx * x + yy * y + dy + 0.5))
        dst.push(src[i + 2])
        i = i + 3

# `points` receives x, y, tag per point (see SfntGlyfOutline.sgo_points).
fn _parse_simple_slice(blob: [u8], start: i64, end: i64, contour_count: i64, mut points: [i64]) -> Option<[SfntGlyfCommand]>:
    if contour_count < 0 or start + 10 > end or contour_count > (end - start - 10) / 2:
        return None
    if contour_count == 0:
        if start + 12 > end:
            return None
        val instruction_length = read_u16_be(blob, start + 10) as i64
        if instruction_length > end - start - 12:
            return None
        return Some([])
    var endpoints: [i32] = []
    var previous: i32 = -1
    var i: i64 = 0
    while i < contour_count:
        val endpoint = read_u16_be(blob, start + 10 + i * 2) as i32
        if endpoint <= previous:
            return None
        endpoints.append(endpoint)
        previous = endpoint
        i = i + 1
    val point_count = previous as i64 + 1
    val instruction_offset = start + 10 + contour_count * 2
    if instruction_offset + 2 > end:
        return None
    val instruction_length = read_u16_be(blob, instruction_offset) as i64
    var pos = instruction_offset + 2
    if instruction_length > end - pos:
        return None
    pos = pos + instruction_length

    var flags: [u8] = []
    while flags.len() < point_count:
        if pos >= end:
            return None
        val flag = blob[pos]
        pos = pos + 1
        if (flag & 192) != 0:
            return None
        flags.append(flag)
        if (flag & 8) != 0:
            if pos >= end:
                return None
            val repeat_count = blob[pos] as i64
            pos = pos + 1
            if repeat_count > point_count - flags.len():
                return None
            var repeat: i64 = 0
            while repeat < repeat_count:
                flags.append(flag)
                repeat = repeat + 1

    var xs: [i32] = []
    var current: i32 = 0
    i = 0
    while i < point_count:
        val flag = flags[i]
        if (flag & 2) != 0:
            if pos >= end:
                return None
            val delta = blob[pos] as i32
            pos = pos + 1
            if (flag & 16) != 0:
                current = current + delta
            else:
                current = current - delta
        else:
            if (flag & 16) == 0:
                if pos + 2 > end:
                    return None
                current = current + read_i16_be(blob, pos)
                pos = pos + 2
        xs.append(current)
        i = i + 1

    var ys: [i32] = []
    current = 0
    i = 0
    while i < point_count:
        val flag = flags[i]
        if (flag & 4) != 0:
            if pos >= end:
                return None
            val delta = blob[pos] as i32
            pos = pos + 1
            if (flag & 32) != 0:
                current = current + delta
            else:
                current = current - delta
        else:
            if (flag & 32) == 0:
                if pos + 2 > end:
                    return None
                current = current + read_i16_be(blob, pos)
                pos = pos + 2
        ys.append(current)
        i = i + 1

    i = 0
    var point_contour: i64 = 0
    while i < point_count:
        var tag: i64 = if (flags[i] & 1) != 0: 1 else: 0
        if i == endpoints[point_contour] as i64:
            tag = tag | 2
            point_contour = point_contour + 1
        points.push(xs[i] as i64)
        points.push(ys[i] as i64)
        points.push(tag)
        i = i + 1

    var commands: [SfntGlyfCommand] = []
    var contour_start: i64 = 0
    var contour: i64 = 0
    while contour < contour_count:
        val contour_end = endpoints[contour] as i64
        val first_on = (flags[contour_start] & 1) != 0
        val last_on = (flags[contour_end] & 1) != 0
        var move_x: f64 = 0.0
        var move_y: f64 = 0.0
        var point = contour_start
        if first_on:
            move_x = xs[contour_start] as f64
            move_y = ys[contour_start] as f64
            point = contour_start + 1
        else:
            if last_on:
                move_x = xs[contour_end] as f64
                move_y = ys[contour_end] as f64
            else:
                move_x = (xs[contour_start] as f64 + xs[contour_end] as f64) / 2.0
                move_y = (ys[contour_start] as f64 + ys[contour_end] as f64) / 2.0
        commands = commands.push(_command(SFNT_GLYF_MOVE, move_x, move_y, 0.0, 0.0))
        while point <= contour_end:
            val x = xs[point] as f64
            val y = ys[point] as f64
            if (flags[point] & 1) != 0:
                commands = commands.push(_command(SFNT_GLYF_LINE, x, y, 0.0, 0.0))
            else:
                var next = point + 1
                var next_x = move_x
                var next_y = move_y
                var next_on = true
                if next <= contour_end:
                    next_x = xs[next] as f64
                    next_y = ys[next] as f64
                    next_on = (flags[next] & 1) != 0
                if next_on:
                    commands = commands.push(_command(SFNT_GLYF_QUAD, x, y, next_x, next_y))
                    point = point + 1
                else:
                    commands = commands.push(_command(SFNT_GLYF_QUAD, x, y, (x + next_x) / 2.0, (y + next_y) / 2.0))
            point = point + 1
        commands = commands.push(_command(SFNT_GLYF_CLOSE, 0.0, 0.0, 0.0, 0.0))
        contour_start = contour_end + 1
        contour = contour + 1
    Some(commands)

fn _f2dot14(blob: [u8], offset: i64) -> f64:
    (read_i16_be(blob, offset) as f64) / 16384.0

fn _parse_glyph(font: OtFont, glyf: OtTable, loca: OtTable, glyph_id: u32, num_glyphs: i64, long_loca: bool, depth: i64, active: [u32], components: i64) -> Option<SfntGlyfOutline>:
    if depth > 8 or glyph_id as i64 >= num_glyphs or _active_has(active, glyph_id):
        return None
    val entry_size: i64 = if long_loca: 4 else: 2
    val loca_pos = loca.offset as i64 + glyph_id as i64 * entry_size
    var relative_start: i64 = 0
    var relative_end: i64 = 0
    if long_loca:
        relative_start = ((blob_u32(font.blob, loca_pos)) as i64)
        relative_end = ((blob_u32(font.blob, loca_pos + 4)) as i64)
    else:
        relative_start = (read_u16_be(font.blob, loca_pos) as i64) * 2
        relative_end = (read_u16_be(font.blob, loca_pos + 2) as i64) * 2
    if relative_end < relative_start or relative_end > glyf.length as i64:
        return None
    val start = glyf.offset as i64 + relative_start
    val end = glyf.offset as i64 + relative_end
    if start == end:
        return Some(SfntGlyfOutline(commands: [], components: components, sgo_points: []))
    if end - start < 10:
        return None
    val contour_count = read_i16_be(font.blob, start) as i64
    if contour_count >= 0:
        # match unwrap, not `== None`/`.unwrap()`: Option compare/unwrap sinks
        # mis-evaluate on the baremetal native lane (2026-07-18 render-fault
        # chain); match Some/None is the kernel-proven form (applies to every
        # conversion in this file).
        var simple_points: [i64] = []
        val simple = _parse_simple_slice(font.blob, start, end, contour_count, simple_points)
        match simple:
            Some(simple_commands):
                return Some(SfntGlyfOutline(commands: simple_commands, components: components, sgo_points: simple_points))
            None:
                return None
    if contour_count != -1:
        return None

    var next_active = active
    next_active.append(glyph_id)
    var pos = start + 10
    var commands: [SfntGlyfCommand] = []
    var points: [i64] = []
    var total = components
    var more = true
    var last_flags: u16 = 0
    while more:
        total = total + 1
        if total > 64 or pos + 4 > end:
            return None
        val flags = read_u16_be(font.blob, pos)
        val child_id = read_u16_be(font.blob, pos + 2) as u32
        pos = pos + 4
        # ROUND_XY_TO_GRID (4) only applies to bytecode-hinted loads; Chrome
        # (FreeType light / autohint) places the offset unrounded, as here.
        if (flags & 2) == 0 or (flags & 57344) != 0 or (flags & 16) != 0 or (flags & 2048) != 0:
            return None
        if (flags & 256) != 0 and (flags & 32) != 0:
            return None
        var dx: f64 = 0.0
        var dy: f64 = 0.0
        if (flags & 1) != 0:
            if pos + 4 > end:
                return None
            dx = read_i16_be(font.blob, pos) as f64
            dy = read_i16_be(font.blob, pos + 2) as f64
            pos = pos + 4
        else:
            if pos + 2 > end:
                return None
            var ax = font.blob[pos] as i32
            var ay = font.blob[pos + 1] as i32
            if ax >= 128:
                ax = ax - 256
            if ay >= 128:
                ay = ay - 256
            dx = ax as f64
            dy = ay as f64
            pos = pos + 2
        var xx: f64 = 1.0
        var xy: f64 = 0.0
        var yx: f64 = 0.0
        var yy: f64 = 1.0
        val transform_bits = flags & 200
        if transform_bits == 8:
            if pos + 2 > end:
                return None
            xx = _f2dot14(font.blob, pos)
            yy = xx
            pos = pos + 2
        else:
            if transform_bits == 64:
                if pos + 4 > end:
                    return None
                xx = _f2dot14(font.blob, pos)
                yy = _f2dot14(font.blob, pos + 2)
                pos = pos + 4
            else:
                if transform_bits == 128:
                    if pos + 8 > end:
                        return None
                    xx = _f2dot14(font.blob, pos)
                    xy = _f2dot14(font.blob, pos + 2)
                    yx = _f2dot14(font.blob, pos + 4)
                    yy = _f2dot14(font.blob, pos + 6)
                    pos = pos + 8
                else:
                    if transform_bits != 0:
                        return None
        val child = _parse_glyph(font, glyf, loca, child_id, num_glyphs, long_loca, depth + 1, next_active, total)
        val parsed = match child:
            Some(value): value
            None: return None
        total = parsed.components
        commands = _append_transformed(commands, parsed.commands, xx, xy, yx, yy, dx, dy)
        _append_transformed_points(points, parsed.sgo_points, xx, xy, yx, yy, dx, dy)
        more = (flags & 32) != 0
        last_flags = flags
    if (last_flags & 256) != 0:
        if pos + 2 > end:
            return None
        val instruction_length = read_u16_be(font.blob, pos) as i64
        pos = pos + 2
        if instruction_length > end - pos:
            return None
        pos = pos + instruction_length
    if pos > end:
        return None
    Some(SfntGlyfOutline(commands: commands, components: total, sgo_points: points))

fn blob_u32(blob: [u8], offset: i64) -> u32:
    ((blob[offset] as u32) << 24) | ((blob[offset + 1] as u32) << 16) | ((blob[offset + 2] as u32) << 8) | (blob[offset + 3] as u32)

# Parse memo for the glyph entry points below. A cold text glyph used to parse
# the same font directory and glyph outline three times (measure, ink
# receipt, LCD outline); each directory parse is ~0.8 ms on the interpreter
# lane. The memo keeps the last blob and serves only a byte-equal blob
# (native array `==`, ~5 us for 277 KB), so another font or an edited blob
# parses afresh and clears the outlines. Values are stored bare and wrapped
# on return. Outlines are immutable after parse.
var _sfnt_memo_blob: [u8] = []
var _sfnt_memo_fonts: [OtFont] = []
var _sfnt_memo_outlines: Dict<i64, SfntGlyfOutline> = {}
var _sfnt_memo_outline_count: i64 = 0
val _SFNT_MEMO_OUTLINE_LIMIT: i64 = 4096

fn _sfnt_memo_holds(blob: [u8]) -> bool:
    _sfnt_memo_fonts.len() == 1 and blob.len() == _sfnt_memo_blob.len() and blob == _sfnt_memo_blob

fn _sfnt_font_memo(blob: [u8]) -> Option<OtFont>:
    if _sfnt_memo_holds(blob):
        return Some(_sfnt_memo_fonts[0])
    val font = match parse_offset_table(blob):
        Some(value): value
        None: return None
    _sfnt_memo_blob = blob
    _sfnt_memo_fonts = [font]
    _sfnt_memo_extents = {}
    _sfnt_memo_outlines = {}
    _sfnt_memo_outline_count = 0
    Some(font)

fn _sfnt_outline_memo(font: OtFont, glyph_id: u32) -> Option<SfntGlyfOutline>:
    if not _sfnt_memo_holds(font.blob):
        return parse_sfnt_glyf_outline(font, glyph_id)
    val key = glyph_id as i64
    if val Some(hit) = _sfnt_memo_outlines.get(key):
        return Some(hit)
    val outline = match parse_sfnt_glyf_outline(font, glyph_id):
        Some(value): value
        None: return None
    if _sfnt_memo_outline_count >= _SFNT_MEMO_OUTLINE_LIMIT:
        _sfnt_memo_outlines = {}
        _sfnt_memo_outline_count = 0
    _sfnt_memo_outlines[key] = outline
    _sfnt_memo_outline_count = _sfnt_memo_outline_count + 1
    Some(outline)

fn parse_sfnt_glyf_outline(font: OtFont, glyph_id: u32) -> Option<SfntGlyfOutline>:
    val head_table = match find_table(font, 1751474532):
        Some(value): value
        None: return None
    val maxp_table = match find_table(font, 1835104368):
        Some(value): value
        None: return None
    val loca_table = match find_table(font, 1819239265):
        Some(value): value
        None: return None
    val glyf_table = match find_table(font, 1735162214):
        Some(value): value
        None: return None
    if not _table_is_bounded(font, head_table, 54) or not _table_is_bounded(font, maxp_table, 6) or not _table_is_bounded(font, loca_table, 2) or not _table_is_bounded(font, glyf_table, 0):
        return None
    val num_glyphs = read_u16_be(font.blob, maxp_table.offset as i64 + 4) as i64
    val format = read_i16_be(font.blob, head_table.offset as i64 + 50)
    if num_glyphs <= 0 or glyph_id as i64 >= num_glyphs or (format != 0 and format != 1):
        return None
    val entry_size: i64 = if format == 1: 4 else: 2
    if (loca_table.length as i64) < (num_glyphs + 1) * entry_size:
        return None
    _parse_glyph(font, glyf_table, loca_table, glyph_id, num_glyphs, format == 1, 0, [], 0)

# Deprecated offset compatibility cannot establish loca-bounded glyph identity.
fn parse_sfnt_glyf_simple_at(font: OtFont, glyph_offset: u32) -> Option<SfntGlyfOutline>:
    val table = match find_table(font, 1735162214):
        Some(value): value
        None: return None
    val start = glyph_offset as i64
    var end = table.offset as i64 + table.length as i64
    if end > font.blob.len(): end = font.blob.len()
    if start < table.offset as i64 or start + 10 > end: return None
    val contour_count = read_i16_be(font.blob, start) as i64
    if contour_count < 0: return None
    var points: [i64] = []
    val commands = match _parse_simple_slice(font.blob, start, end, contour_count, points):
        Some(value): value
        None: return None
    Some(SfntGlyfOutline(commands: commands, components: 0, sgo_points: points))

fn _round_glyf_metric(value: f64) -> i64:
    # Compute the rounded float first, then cast ONCE. Casting inside both branches
    # (`if X: (a) as i64 else: (b) as i64`) lowers to a `CastElse` HIR node the JIT
    # cannot compile, which defers this whole hot glyph-rasterizer module to the
    # interpreter. Hoisting the cast out keeps the module JIT-lowerable.
    val rounded = if value >= 0.0: value + 0.5 else: value - 0.5
    rounded as i64

fn _ceil_glyf_dimension(value: f64) -> i64:
    if value < 1.0:
        return 1
    val whole = value as i64
    if value > whole as f64: whole + 1 else: whole

class _SfntBounds:
    left: f64
    top: f64
    right: f64
    bottom: f64

class _SfntEdge:
    y_top: f64
    y_bottom: f64
    x_top: f64
    dx_dy: f64
    direction: i64

# Vertical frame of the grayscale bitmap: its row count, the offset of its
# bottom edge above the baseline (the consumer's bearing_y: top row = baseline
# - bearing_y - height) and the outline y, in px, of its top edge.
# `sfnt_measure_glyph_into`, `sfnt_render_glyph_into` and
# `sfnt_glyph_gray_row_has_ink` all take it from here, so their receipts agree.
# Above Skia's LCD limit (48 device px) the frame is BASELINE-anchored: whole
# rows counted from the baseline, the outline kept at its true y. Chrome 159
# does the same there (Liberation Serif `H`, 96 device px: bottom row solid,
# top row partial; 60px at 1x ends on row 53). The old frame hung the bitmap
# from its own ink top and rounded the height up, so the ink bottom floated up
# to one row above the baseline, by a different fraction per glyph. At 48 px
# and below Chrome paints LCD (`sfnt_render_glyph_lcd_milli`, baseline-anchored
# already); the ink-top frame stays for this raster there, unmeasured.
val _SFNT_GRAY_BASELINE_ANCHOR_MIN_PX: i64 = 49

class _SfntGrayFrame:
    height: i64
    bearing_y: i64
    top: f64

fn _gray_frame(bounds: _SfntBounds, scale: f64, size_px: i64) -> _SfntGrayFrame:
    if size_px < _SFNT_GRAY_BASELINE_ANCHOR_MIN_PX:
        return _SfntGrayFrame(height: _ceil_glyf_dimension((bounds.bottom - bounds.top) * scale), bearing_y: _round_glyf_metric(bounds.top * scale), top: bounds.bottom * scale)
    # 0.001 px of slack keeps an outline that ends ON a row boundary (a cap
    # top at a whole px, a foot on the baseline) from claiming an empty row.
    val bottom_px = _floor_glyf(bounds.top * scale + 0.001)
    val top_px = _ceil_glyf(bounds.bottom * scale - 0.001)
    val height: i64 = if top_px > bottom_px: top_px - bottom_px else: 1
    _SfntGrayFrame(height: height, bearing_y: bottom_px, top: (bottom_px + height) as f64)

fn _outline_bounds(commands: [SfntGlyfCommand]) -> Option<_SfntBounds>:
    if commands.len() == 0: return None
    var first = true
    var left = 0.0
    var top = 0.0
    var right = 0.0
    var bottom = 0.0
    for command in commands:
        if command.verb != SFNT_GLYF_CLOSE:
            val count: i64 = if command.verb == SFNT_GLYF_QUAD: 2 else: 1
            var index: i64 = 0
            while index < count:
                val x = if index == 0: command.x1 else: command.x2
                val y = if index == 0: command.y1 else: command.y2
                if first:
                    left = x
                    right = x
                    top = y
                    bottom = y
                    first = false
                else:
                    if x < left: left = x
                    if x > right: right = x
                    if y < top: top = y
                    if y > bottom: bottom = y
                index = index + 1
    if first: None else: Some(_SfntBounds(left: left, top: top, right: right, bottom: bottom))

# The edge is built here rather than through a helper, and there is no
# `var result = edges` alias: a second live reference makes every push copy the
# whole array (interpreter lane, 500 edges: 6.8 ms against 3.3 ms, quadratic
# beyond), and a curve costs 16 of these calls.
fn _add_edge(edges: [_SfntEdge], ax: f64, ay: f64, bx: f64, by: f64) -> [_SfntEdge]:
    if ay == by: return edges
    if ay < by:
        return edges.push(_SfntEdge(y_top: ay, y_bottom: by, x_top: ax, dx_dy: (bx - ax) / (by - ay), direction: 1))
    edges.push(_SfntEdge(y_top: by, y_bottom: ay, x_top: bx, dx_dy: (ax - bx) / (ay - by), direction: -1))

fn _quad_edges(edges: [_SfntEdge], ax: f64, ay: f64, cx: f64, cy: f64, bx: f64, by: f64, depth: i64) -> [_SfntEdge]:
    if depth == 0: return _add_edge(edges, ax, ay, bx, by)
    val lx = (ax + cx) / 2.0
    val ly = (ay + cy) / 2.0
    val rx = (cx + bx) / 2.0
    val ry = (cy + by) / 2.0
    val mx = (lx + rx) / 2.0
    val my = (ly + ry) / 2.0
    # The last split's halves are the two chords a->m and m->b: emitted here,
    # which halves the recursive calls (31 -> 15 per curve) for the same points.
    if depth == 1:
        return _add_edge(_add_edge(edges, ax, ay, mx, my), mx, my, bx, by)
    val left = _quad_edges(edges, ax, ay, lx, ly, mx, my, depth - 1)
    _quad_edges(left, mx, my, rx, ry, bx, by, depth - 1)

fn _outline_edges(commands: [SfntGlyfCommand], scale: f64, left: f64, top: f64) -> [_SfntEdge]:
    _outline_edges_band(commands, scale, left, top, -1.0e300, 1.0e300)

# `_outline_edges` restricted to the commands whose y extent (raster space)
# meets [y_lo, y_hi]. A curve's chords stay inside the y range of its three
# control points (every split point is a midpoint of two of them), so a
# skipped command has no edge that a scanline inside the band can cross, and
# the kept edges are the same values in the same order.
fn _outline_edges_band(commands: [SfntGlyfCommand], scale: f64, left: f64, top: f64, y_lo: f64, y_hi: f64) -> [_SfntEdge]:
    var edges: [_SfntEdge] = []
    var pen_x = 0.0
    var pen_y = 0.0
    var move_x = 0.0
    var move_y = 0.0
    for command in commands:
        val x1 = command.x1 * scale - left
        val y1 = -command.y1 * scale - top
        if command.verb == SFNT_GLYF_MOVE:
            pen_x = x1
            pen_y = y1
            move_x = x1
            move_y = y1
        elif command.verb == SFNT_GLYF_LINE:
            if not ((pen_y < y_lo and y1 < y_lo) or (pen_y > y_hi and y1 > y_hi)):
                edges = _add_edge(edges, pen_x, pen_y, x1, y1)
            pen_x = x1
            pen_y = y1
        elif command.verb == SFNT_GLYF_QUAD:
            val x2 = command.x2 * scale - left
            val y2 = -command.y2 * scale - top
            if not ((pen_y < y_lo and y1 < y_lo and y2 < y_lo) or (pen_y > y_hi and y1 > y_hi and y2 > y_hi)):
                edges = _quad_edges(edges, pen_x, pen_y, x1, y1, x2, y2, 4)
            pen_x = x2
            pen_y = y2
        elif command.verb == SFNT_GLYF_CLOSE:
            if not ((pen_y < y_lo and move_y < y_lo) or (pen_y > y_hi and move_y > y_hi)):
                edges = _add_edge(edges, pen_x, pen_y, move_x, move_y)
            pen_x = move_x
            pen_y = move_y
    edges

# Per-pixel-row edge index for the scanline kernels below. Both kernels used to
# test EVERY edge for each of a pixel row's 4 sample scanlines; a curve is 16
# short edges, so a 16 px glyph has about 500 edges of which a row touches a
# few dozen. The result is one flat array: `rows[r] .. rows[r + 1]` (r <
# height) is the slice of `rows` holding the indices, ascending, of the edges
# whose y span can reach a sample in pixel row r. It is a SUPERSET filter only:
# a sample y in (r, r + 1) is crossed by an edge (`y_top <= sy` and
# `sy <= y_bottom`, whichever of the two is strict in the kernel) only when
# floor(y_top) <= r <= floor(y_bottom), which is exactly the range indexed
# here. The kernels keep their own exact test, and the ascending order keeps
# the insertion sort's tie order, so every coverage value is unchanged.
fn _edge_row_index(edges: [_SfntEdge], height: i64) -> [i64]:
    val count = edges.len()
    var firsts: [i64] = [0; count]
    var lasts: [i64] = [0; count]
    var cursor: [i64] = [0; height + 1]
    var total: i64 = 0
    var i: i64 = 0
    while i < count:
        val edge = edges[i]
        var first = _floor_glyf(edge.y_top)
        var last = _floor_glyf(edge.y_bottom)
        if first < 0: first = 0
        if last > height - 1: last = height - 1
        firsts[i] = first
        lasts[i] = last
        var span = first
        while span <= last:
            cursor[span] = cursor[span] + 1
            total = total + 1
            span = span + 1
        i = i + 1
    # counts -> start offsets (absolute positions in the returned array)
    var rows: [i64] = [0; height + 1 + total]
    var at: i64 = height + 1
    var r: i64 = 0
    while r < height:
        rows[r] = at
        at = at + cursor[r]
        cursor[r] = rows[r]
        r = r + 1
    rows[height] = at
    i = 0
    while i < count:
        var k = firsts[i]
        while k <= lasts[i]:
            rows[cursor[k]] = i
            cursor[k] = cursor[k] + 1
            k = k + 1
        i = i + 1
    rows

# Whole-bitmap coverage (4x4 supersample, 17 levels). Each pixel row gathers
# the edge crossings of its 4 sample scanlines in one pass over the row's
# edges and insertion-sorts each scanline's list. Sample j of a scanline
# (j = 4 * px + sample_x) sits at x = px + (2 * sample_x + 1) / 8 = (2j + 1) / 8
# and is inside when the signed sum of the crossings <= x is non-zero -- the
# same crossing expression, `<=` test, sample positions and integer winding
# sum as the per-sample sweep this replaced, so every coverage byte is
# unchanged. The sweep no longer visits samples: between two consecutive
# crossings the winding is constant, so each inside run of samples [a, b) is
# added at once -- its partial end pixels into `hits`, its whole pixels as
# +4 / -4 marks in `full` that one prefix pass per row resolves. Cost per
# scanline is O(crossings), not O(4 * width): the 16 interpreted sample steps
# per pixel were 4.7 s of the 4x css-layout render.
#
# The first sample a crossing c counts at is the least j with c <= (2j+1)/8,
# i.e. j = ceil((8c - 1) / 2). For |c| < 2^49 every step of that expression
# is exact in f64 (a power-of-two scale, a subtraction whose result is
# representable, a halving), and so is the sweep's own sample x, so the
# closed form names exactly the sample where the sweep's `xs[p] <= sx`
# first held. Values outside [0, samples) clamp, as the sweep's ends did.
# Returns width*height bytes.
fn _glyf_raster_alpha(edges: [_SfntEdge], width: i64, height: i64) -> [u8]:
    _glyf_raster_alpha_rows(edges, width, height, 0, height)

# Rows row_from .. row_end - 1 of `_glyf_raster_alpha`; the other rows stay 0.
fn _glyf_raster_alpha_rows(edges: [_SfntEdge], width: i64, height: i64, row_from: i64, row_end: i64) -> [u8]:
    var out: [u8] = [0u8; width * height]
    var hits: [i64] = [0; width + 1]
    var full: [i64] = [0; width + 1]
    # Four crossing lists (one per sample scanline), `stride` apart.
    val stride = edges.len() + 1
    var xs: [f64] = [0.0; stride * 4]
    var dirs: [i64] = [0; stride * 4]
    var counts: [i64] = [0; 4]
    var sys: [f64] = [0.0; 4]
    val samples = width * 4
    val last_sample = (samples - 1) as f64
    val rows = _edge_row_index(edges, height)
    var y: i64 = row_from
    while y < row_end:
        val row_end = rows[y + 1]
        var sample_y: i64 = 0
        while sample_y < 4:
            sys[sample_y] = y as f64 + (sample_y as f64 * 2.0 + 1.0) / 8.0
            counts[sample_y] = 0
            sample_y = sample_y + 1
        var k = rows[y]
        while k < row_end:
            val edge = edges[rows[k]]
            val y_top = edge.y_top
            val y_bottom = edge.y_bottom
            var s: i64 = 0
            while s < 4:
                val sy = sys[s]
                if sy >= y_bottom:
                    # sys ascends: no later scanline of this row meets the edge
                    s = 4
                else:
                    if y_top <= sy:
                        val crossing = edge.x_top + edge.dx_dy * (sy - y_top)
                        val base = s * stride
                        var at = counts[s]
                        while at > 0 and xs[base + at - 1] > crossing:
                            xs[base + at] = xs[base + at - 1]
                            dirs[base + at] = dirs[base + at - 1]
                            at = at - 1
                        xs[base + at] = crossing
                        dirs[base + at] = edge.direction
                        counts[s] = counts[s] + 1
                    s = s + 1
            k = k + 1
        sample_y = 0
        while sample_y < 4:
            val base = sample_y * stride
            val n = counts[sample_y]
            # Samples [run_from, first sample of crossing p) carry `winding`.
            var winding: i64 = 0
            var run_from: i64 = 0
            var p: i64 = 0
            while p <= n:
                var run_to = samples
                if p < n:
                    val first = (xs[base + p] * 8.0 - 1.0) / 2.0
                    if first <= 0.0:
                        run_to = 0
                    elif first <= last_sample:
                        run_to = first as i64
                        if (run_to as f64) < first:
                            run_to = run_to + 1
                if winding != 0 and run_to > run_from:
                    val pa = run_from / 4
                    val pb = run_to / 4
                    if pa == pb:
                        hits[pa] = hits[pa] + (run_to - run_from)
                    else:
                        hits[pa] = hits[pa] + (4 * (pa + 1) - run_from)
                        full[pa + 1] = full[pa + 1] + 4
                        full[pb] = full[pb] - 4
                        hits[pb] = hits[pb] + (run_to - 4 * pb)
                if p < n:
                    winding = winding + dirs[base + p]
                    run_from = run_to
                p = p + 1
            sample_y = sample_y + 1
        var whole: i64 = 0
        var cx: i64 = 0
        while cx < width:
            whole = whole + full[cx]
            out[y * width + cx] = ((hits[cx] + whole) * 255 / 16) as u8
            hits[cx] = 0
            full[cx] = 0
            cx = cx + 1
        hits[width] = 0
        full[width] = 0
        y = y + 1
    out


fn _hmtx(font: OtFont, long_metrics: i64, glyph_id: u32) -> Option<[i64]>:
    if long_metrics <= 0: return None
    val table = match find_table(font, 1752003704):
        Some(value): value
        None: return None
    val gid = glyph_id as i64
    val advance_index = if gid < long_metrics: gid else: long_metrics - 1
    val advance_pos = table.offset as i64 + advance_index * 4
    val bearing_pos = if gid < long_metrics: advance_pos + 2 else: table.offset as i64 + long_metrics * 4 + (gid - long_metrics) * 2
    val limit = table.offset as i64 + table.length as i64
    if advance_pos + 2 > limit or bearing_pos + 2 > limit: return None
    Some([read_u16_be(font.blob, advance_pos) as i64, read_i16_be(font.blob, bearing_pos) as i64])

fn rasterize_sfnt_glyf(font: OtFont, glyph_id: u32, size_px: i64) -> Option<SfntGlyfBitmap>:
    if size_px <= 0 or size_px > 512:
        return None
    val head_table = match find_table(font, 1751474532):
        Some(value): value
        None: return None
    val hhea_table = match find_table(font, 1751672161):
        Some(value): value
        None: return None
    val hmtx_table = match find_table(font, 1752003704):
        Some(value): value
        None: return None
    if not _table_is_bounded(font, head_table, 54) or not _table_is_bounded(font, hhea_table, 36) or not _table_is_bounded(font, hmtx_table, 4):
        return None
    val units_per_em = read_u16_be(font.blob, head_table.offset as i64 + 18) as i64
    val long_metrics = read_u16_be(font.blob, hhea_table.offset as i64 + 34) as i64
    if units_per_em == 0 or long_metrics == 0:
        return None
    var metric_end: i64 = 0
    if (glyph_id as i64) < long_metrics:
        metric_end = (glyph_id as i64 + 1) * 4
    else:
        metric_end = long_metrics * 4 + (glyph_id as i64 - long_metrics + 1) * 2
    if metric_end > hmtx_table.length as i64:
        return None
    val parsed_outline = match parse_sfnt_glyf_outline(font, glyph_id):
        Some(value): value
        None: return None
    val horizontal = match _hmtx(font, long_metrics, glyph_id):
        Some(value): value
        None: return None
    val commands = parsed_outline.commands
    val scale = size_px as f64 / units_per_em as f64
    var has_drawable_point = false
    for command in commands:
        if command.verb != SFNT_GLYF_CLOSE:
            has_drawable_point = true
    if not has_drawable_point:
        # Whitespace is a valid advance-only glyph, not a raster failure.
        return Some(SfntGlyfBitmap(
            sgb_width: 0, sgb_height: 0,
            sgb_advance: _round_glyf_metric(horizontal[0] as f64 * scale),
            sgb_bearing_x: _round_glyf_metric(horizontal[1] as f64 * scale),
            sgb_bearing_y: 0, sgb_pixels: []))
    val bounds = match _outline_bounds(commands):
        Some(value): value
        None: return None
    val em_w = bounds.right - bounds.left
    val em_h = bounds.bottom - bounds.top
    val raw_w = em_w * scale
    val raw_h = em_h * scale
    val width = _ceil_glyf_dimension(raw_w)
    val height = _ceil_glyf_dimension(raw_h)
    if raw_w < 0.0: return None
    if raw_h < 0.0: return None
    if width <= 0: return None
    if height <= 0: return None
    if width > 4096: return None
    if height > 4096: return None
    if width > 16777216 / height: return None
    val edges = _outline_edges(commands, scale, bounds.left * scale, -bounds.bottom * scale)
    val pixels = _glyf_raster_alpha(edges, width, height)
    Some(SfntGlyfBitmap(
        sgb_width: width,
        sgb_height: height,
        sgb_advance: _round_glyf_metric(horizontal[0] as f64 * scale),
        sgb_bearing_x: _round_glyf_metric(horizontal[1] as f64 * scale),
        sgb_bearing_y: _round_glyf_metric(bounds.top * scale),
        sgb_pixels: pixels
    ))

# Metrics-only advance (2026-09-12). `sfnt_measure_glyph_into` below is already
# raster-free, but it still calls `parse_sfnt_glyf_outline` + `_outline_bounds`
# to produce the glyph's ink width/height -- decoding every contour and point of
# the `glyf` entry. A caller that only wants the ADVANCE never looks at those:
# the advance comes from `hmtx` alone, and this function computes it with the
# byte-identical expression `_round_glyf_metric(horizontal[0] * scale)` that
# `sfnt_measure_glyph_into` uses, so the two agree exactly by construction.
# Measured on examples/06_io/ui/web_catalog/css-layout.html, the outline decode
# was 3,442 ms of the 3,846 ms spent in `measure_text_advances` -- 29 ms per
# advance-cache miss, and 89% of the whole measurement leaf.
#
# Writes meta[2] = advance, meta[3] = bearing_x, meta[6] = glyph_id and the
# success cookie meta[7] = 310031. Width/height/bearing_y are NOT written --
# a caller needing ink extents must use `sfnt_measure_glyph_into`.
#
# meta[18] = the SAME advance in MILLI-pixels (2026-09-13, round 12). meta[2]
# is rounded to a whole pixel and must stay that way -- every existing consumer
# reads it -- but rounding each glyph independently is what made a run of eight
# Menlo `M` (1233/2048 em = 9.633 px at 16) measure 8 x 10 = 80 px where Chrome
# accumulates fractionally and reports round(77.06) = 77. `measure_text_advances`
# sums meta[18] and emits `round(cum[i+1]) - round(cum[i])`, so the run total is
# the rounded exact total and every glyph position is an integer snap of the
# exact pen -- which is what Skia's subpixel positioning produces. Both fields
# come from one `horizontal[0] * scale`, so they can never disagree about the
# face. A face with whole-pixel advances yields meta[18] == meta[2] * 1000 and
# the emitted array is byte-identical to the pre-round-12 one.
fn sfnt_glyph_advance_into(blob: [u8], selector_kind: i64, selector_value: i64, size_px: i64, mut meta: [i64]):
    if meta.len() < 20: return
    meta[7] = 0
    if blob.len() == 0 or size_px <= 0 or size_px > 512:
        return
    val font = match parse_offset_table(blob):
        Some(value): value
        None: return
    var glyph_id: u32 = 0
    if selector_kind == SFNT_GLYPH_SELECTOR_CODEPOINT and selector_value >= 0 and selector_value <= 1114111:
        glyph_id = sfnt_cmap_glyph_id(font, selector_value as u32)
    else if selector_kind == SFNT_GLYPH_SELECTOR_INDEX and selector_value > 0 and selector_value <= 4294967295:
        glyph_id = selector_value as u32
    else:
        return
    if glyph_id == 0:
        return
    val head_table = match find_table(font, 1751474532):
        Some(value): value
        None: return
    val hhea_table = match find_table(font, 1751672161):
        Some(value): value
        None: return
    val hmtx_table = match find_table(font, 1752003704):
        Some(value): value
        None: return
    if not _table_is_bounded(font, head_table, 54) or not _table_is_bounded(font, hhea_table, 36) or not _table_is_bounded(font, hmtx_table, 4):
        return
    val units_per_em = read_u16_be(font.blob, head_table.offset as i64 + 18) as i64
    val long_metrics = read_u16_be(font.blob, hhea_table.offset as i64 + 34) as i64
    if units_per_em == 0 or long_metrics == 0:
        return
    var metric_end: i64 = 0
    if (glyph_id as i64) < long_metrics:
        metric_end = (glyph_id as i64 + 1) * 4
    else:
        metric_end = long_metrics * 4 + (glyph_id as i64 - long_metrics + 1) * 2
    if metric_end > hmtx_table.length as i64:
        return
    val horizontal = match _hmtx(font, long_metrics, glyph_id):
        Some(value): value
        None: return
    val scale = size_px as f64 / units_per_em as f64
    meta[2] = _round_glyf_metric(horizontal[0] as f64 * scale)
    meta[18] = _round_glyf_metric(horizontal[0] as f64 * scale * 1000.0)
    meta[3] = _round_glyf_metric(horizontal[1] as f64 * scale)
    meta[6] = glyph_id as i64
    meta[15] = selector_kind
    meta[16] = selector_value
    meta[17] = _round_glyf_metric(read_i16_be(font.blob, hhea_table.offset as i64 + 4) as f64 * scale)
    meta[7] = 310031

# Caller-owned metadata: width, height, advance, bearings, count, glyph, cookies, alpha.
fn sfnt_measure_glyph_into(blob: [u8], selector_kind: i64, selector_value: i64, size_px: i64, mut meta: [i64]):
    if meta.len() > 7:
        meta[7] = 0
    if meta.len() > 8:
        meta[8] = 0
    if meta.len() > 9:
        meta[9] = 0
    if meta.len() < 20: return
    if blob.len() == 0 or size_px <= 0 or size_px > 512:
        return
    val font = match _sfnt_font_memo(blob):
        Some(value): value
        None: return
    var glyph_id: u32 = 0
    if selector_kind == SFNT_GLYPH_SELECTOR_CODEPOINT and selector_value >= 0 and selector_value <= 1114111:
        glyph_id = sfnt_cmap_glyph_id(font, selector_value as u32)
    else if selector_kind == SFNT_GLYPH_SELECTOR_INDEX and selector_value > 0 and selector_value <= 4294967295:
        glyph_id = selector_value as u32
    else:
        return
    if glyph_id == 0:
        return
    val head_table = match find_table(font, 1751474532):
        Some(value): value
        None: return
    val hhea_table = match find_table(font, 1751672161):
        Some(value): value
        None: return
    val hmtx_table = match find_table(font, 1752003704):
        Some(value): value
        None: return
    if not _table_is_bounded(font, head_table, 54) or not _table_is_bounded(font, hhea_table, 36) or not _table_is_bounded(font, hmtx_table, 4):
        return
    val units_per_em = read_u16_be(font.blob, head_table.offset as i64 + 18) as i64
    val long_metrics = read_u16_be(font.blob, hhea_table.offset as i64 + 34) as i64
    if units_per_em == 0 or long_metrics == 0:
        return
    var metric_end: i64 = 0
    if (glyph_id as i64) < long_metrics:
        metric_end = (glyph_id as i64 + 1) * 4
    else:
        metric_end = long_metrics * 4 + (glyph_id as i64 - long_metrics + 1) * 2
    if metric_end > hmtx_table.length as i64:
        return
    val parsed_outline = match _sfnt_outline_memo(font, glyph_id):
        Some(value): value
        None: return
    val horizontal = match _hmtx(font, long_metrics, glyph_id):
        Some(value): value
        None: return
    val commands = parsed_outline.commands
    val scale = size_px as f64 / units_per_em as f64
    var has_drawable_point = false
    for command in commands:
        if command.verb != SFNT_GLYF_CLOSE:
            has_drawable_point = true
    if not has_drawable_point:
        meta[0] = 0
        meta[1] = 0
        meta[2] = _round_glyf_metric(horizontal[0] as f64 * scale)
        meta[18] = _round_glyf_metric(horizontal[0] as f64 * scale * 1000.0)
        meta[3] = _round_glyf_metric(horizontal[1] as f64 * scale)
        meta[4] = 0
        meta[5] = 0
        meta[6] = glyph_id as i64
        meta[15] = selector_kind
        meta[16] = selector_value
        meta[17] = _round_glyf_metric(read_i16_be(font.blob, hhea_table.offset as i64 + 4) as f64 * scale)
        meta[7] = 310031
        return
    val bounds = match _outline_bounds(commands):
        Some(value): value
        None: return
    val raw_w = (bounds.right - bounds.left) * scale
    val raw_h = (bounds.bottom - bounds.top) * scale
    val width = _ceil_glyf_dimension(raw_w)
    val frame = _gray_frame(bounds, scale, size_px)
    val height = frame.height
    meta[10] = 201
    meta[11] = raw_w as i64
    meta[12] = raw_h as i64
    meta[13] = width
    meta[14] = height
    if raw_w < 0.0: return
    meta[10] = 202
    if raw_h < 0.0: return
    meta[10] = 203
    if width <= 0: return
    meta[10] = 204
    if height <= 0: return
    meta[10] = 205
    if width > 4096: return
    meta[10] = 206
    if height > 4096: return
    meta[10] = 207
    if width > 16777216 / height: return
    meta[10] = 208
    meta[0] = width
    meta[1] = height
    meta[2] = _round_glyf_metric(horizontal[0] as f64 * scale)
    meta[18] = _round_glyf_metric(horizontal[0] as f64 * scale * 1000.0)
    meta[3] = _round_glyf_metric(horizontal[1] as f64 * scale)
    meta[4] = frame.bearing_y
    meta[5] = width * height
    meta[6] = glyph_id as i64
    meta[15] = selector_kind
    meta[16] = selector_value
    meta[17] = _round_glyf_metric(read_i16_be(font.blob, hhea_table.offset as i64 + 4) as f64 * scale)
    if meta.len() >= 20:
        meta[19] = _round_glyf_metric(bounds.left * scale)
    meta[7] = 310031

fn sfnt_render_glyph_into(blob: [u8], selector_kind: i64, selector_value: i64, size_px: i64, mut meta: [i64], mut pixels: [u8]):
    # Clear every available receipt even when the metadata array is truncated.
    # A nine-slot destination still contains the render completion cookie.
    if meta.len() > 8:
        meta[8] = 0
    if meta.len() > 9:
        meta[9] = 0
    if meta.len() < 20 or meta[7] != 310031 or meta[15] != selector_kind or meta[16] != selector_value or pixels.len() != meta[5]:
        return
    if size_px <= 0 or size_px > 512:
        return
    val font = match _sfnt_font_memo(blob):
        Some(value): value
        None: return
    var glyph_id: u32 = 0
    if selector_kind == SFNT_GLYPH_SELECTOR_CODEPOINT and selector_value >= 0 and selector_value <= 1114111:
        glyph_id = sfnt_cmap_glyph_id(font, selector_value as u32)
    else if selector_kind == SFNT_GLYPH_SELECTOR_INDEX and selector_value > 0 and selector_value <= 4294967295:
        glyph_id = selector_value as u32
    else:
        return
    if glyph_id == 0 or glyph_id as i64 != meta[6]:
        return
    if meta[0] == 0 and meta[1] == 0 and meta[5] == 0:
        meta[8] = 310032
        return
    val head_table = match find_table(font, 1751474532):
        Some(value): value
        None: return
    val hhea_table = match find_table(font, 1751672161):
        Some(value): value
        None: return
    val units_per_em = read_u16_be(font.blob, head_table.offset as i64 + 18) as i64
    val long_metrics = read_u16_be(font.blob, hhea_table.offset as i64 + 34) as i64
    if units_per_em == 0 or long_metrics == 0:
        return
    val parsed_outline = match _sfnt_outline_memo(font, glyph_id):
        Some(value): value
        None: return
    val horizontal = match _hmtx(font, long_metrics, glyph_id):
        Some(value): value
        None: return
    val commands = parsed_outline.commands
    val bounds = match _outline_bounds(commands):
        Some(value): value
        None: return
    val scale = size_px as f64 / units_per_em as f64
    val width = _ceil_glyf_dimension((bounds.right - bounds.left) * scale)
    val frame = _gray_frame(bounds, scale, size_px)
    val height = frame.height
    if width != meta[0] or height != meta[1] or width * height != meta[5]:
        return
    if _round_glyf_metric(horizontal[0] as f64 * scale) != meta[2] or _round_glyf_metric(horizontal[1] as f64 * scale) != meta[3] or frame.bearing_y != meta[4]:
        return
    val edges = _outline_edges(commands, scale, bounds.left * scale, 0.0 - frame.top)
    val alpha_buf = _glyf_raster_alpha(edges, width, height)
    var nonzero_alpha: i64 = 0
    var i: i64 = 0
    while i < width * height:
        val alpha = alpha_buf[i]
        pixels[i] = alpha
        if alpha > 0:
            nonzero_alpha = nonzero_alpha + 1
        i = i + 1
    meta[9] = nonzero_alpha
    meta[8] = 310032

# True when the bitmap `sfnt_render_glyph_into` writes for this glyph and size
# is PROVEN to hold a non-zero coverage byte, from its middle pixel row alone:
# the same outline, bounds, scale and edge arguments as the render, restricted
# to the commands that can reach that row, through the same kernel. A caller
# that needs only the render's "any ink" receipt (`meta[9] > 0`) and not its
# pixels asks this instead (about a tenth of the work). `false` proves
# nothing -- the ink may sit in another row -- so the caller then renders.
# reason: glyph id and pixel size are the sfnt-table domain; consumed by
# text_layout/font_renderer.spl, so it must be public.
# @allow(primitive_api)
pub fn sfnt_glyph_gray_row_has_ink(blob: [u8], glyph_id: i64, size_px: i64) -> bool:
    if size_px <= 0 or size_px > 512 or glyph_id <= 0 or glyph_id > 4294967295:
        return false
    val font = match _sfnt_font_memo(blob):
        Some(value): value
        None: return false
    val head_table = match find_table(font, 1751474532):
        Some(value): value
        None: return false
    val units_per_em = read_u16_be(font.blob, head_table.offset as i64 + 18) as i64
    if units_per_em == 0:
        return false
    val parsed_outline = match _sfnt_outline_memo(font, glyph_id as u32):
        Some(value): value
        None: return false
    val commands = parsed_outline.commands
    val bounds = match _outline_bounds(commands):
        Some(value): value
        None: return false
    val scale = size_px as f64 / units_per_em as f64
    val width = _ceil_glyf_dimension((bounds.right - bounds.left) * scale)
    val frame = _gray_frame(bounds, scale, size_px)
    val height = frame.height
    if width <= 0 or height <= 0 or width > 4096 or height > 4096:
        return false
    val row = height / 2
    val edges = _outline_edges_band(commands, scale, bounds.left * scale, 0.0 - frame.top, row as f64, (row + 1) as f64)
    val alpha = _glyf_raster_alpha_rows(edges, width, height, row, row + 1)
    var x: i64 = 0
    while x < width:
        if alpha[row * width + x] > 0:
            return true
        x = x + 1
    false

# LCD subpixel glyph (Chrome 159 / Skia LCD16 parity, 2026-11-16).
#
# Chrome 159 builds LCD glyphs through Skia's path route (2026-11-23, checked
# against Skia source and glyph_raster_shape_chrome159_spec): the hinted path
# is scaled 4x horizontally into an A8 mask filled with Skia's analytic AA
# (exact area, line ends snapped to quarter rows), then pack4xHToMask turns
# every 4 quarter-pixel samples into R,G,B with one 12-tap FIR per channel
# (/256, clamp 255). The SkMaskGamma preblend and the 5-bit
# LCD16 pack are applied by the compositor (engine2d lcd_s32_tables.spl).
# Unlike the grayscale
# path above, which snaps the glyph's left bbox edge onto a pixel boundary,
# the outline keeps its true pen-relative position: column 0 of the bitmap is
# pen-relative x `slg_bearing_x`, and `phase_q` shifts the outline right by
# phase_q/4 px (Skia's quarter-pixel positions). One padding pixel on each side
# holds the filter's one-pixel spread. Vertically the outline is baseline-anchored and
# hinted by the Latin autohinter in light mode (sfnt_af_latin.spl), so unlike
# sfnt_render_glyph_into (unhinted; hung from its ink top up to 48 px, see `_gray_frame`) its rows differ too.
class SfntLcdGlyph:
    slg_width: i64
    slg_height: i64
    slg_advance: i64
    slg_bearing_x: i64
    slg_bearing_y: i64
    # width*height average coverage, the grayscale stand-in for consumers
    # that read one alpha per pixel.
    slg_gray: [u8]
    # width*height*3 filtered subpixel coverage, R,G,B per pixel.
    slg_rgb: [u8]

val _SFNT_LCD_A8_PER_PX: i64 = 4
# Skia pack4xHToMask: one 12-tap FIR per LCD channel over the quarter-pixel A8
# samples 4x-4 .. 4x+7 of output pixel x, each summing to 272, then /256 and
# clamped to 255 (unrolled in sfnt_lcd_outline_raster):
#   R 3 11 28 51 64 57 36 16 5 1 0 0
#   G 0 2 8 22 43 61 61 43 22 8 2 0
#   B 0 0 1 5 16 36 57 64 51 28 11 3

fn _floor_glyf(value: f64) -> i64:
    val whole = value as i64
    if (whole as f64) > value: whole - 1 else: whole

fn _ceil_glyf(value: f64) -> i64:
    val whole = value as i64
    if (whole as f64) < value: whole + 1 else: whole

# --- LCD exact-area accumulation ------------------------------------------------
# Chrome 159 draws an LCD glyph as a path into a 4x-wide A8 mask (Skia
# SkScalerContext GenerateImageFromPath, `postScale(4, 1)`) with its analytic
# AA, i.e. each A8 sample (a quarter pixel wide, one pixel tall) holds the exact
# area of the glyph inside it. A 4-sub-scanline point-sampled model was fitted
# here before; it rounds a round stroke's edge to a quarter row, and its
# supersampled variant (SkScan_AntiPath) does not fit Chrome's straight stems.
# The accumulator is the signed-area / cover scheme (font-rs): every line adds
# its area to the cells it crosses and a row prefix sum gives the coverage.
# `a` holds `height` rows of `stride` cells; x is in A8 sample units.
# Skia's analytic edges snap every line end to a quarter row
# (SkAnalyticEdge SnapY, kDefaultAccuracy 2), so a hinted 16 px `H` bar whose
# top is 1/16 px above a row boundary leaves that row white, as in Chrome.
fn _lcd_area_line(mut a: [f64], stride: i64, height: i64, ax: f64, ay_raw: f64, bx: f64, by_raw: f64):
    # Ends snap to a quarter row: floor(y * 4 + 0.5) / 4. Floors and ceilings
    # are written out (a call costs ~2 us on the interpreter lane, more than
    # the arithmetic); where the value is non-negative truncation is the floor.
    val ay4 = ay_raw * 4.0 + 0.5
    var ay_q = ay4 as i64
    if (ay_q as f64) > ay4: ay_q = ay_q - 1
    val ay = (ay_q as f64) / 4.0
    val by4 = by_raw * 4.0 + 0.5
    var by_q = by4 as i64
    if (by_q as f64) > by4: by_q = by_q - 1
    val by = (by_q as f64) / 4.0
    if ay == by: return
    var dir = 1.0
    var x0 = ax
    var y0 = ay
    var x1 = bx
    var y1 = by
    if ay > by:
        dir = -1.0
        x0 = bx
        y0 = by
        x1 = ax
        y1 = ay
    if y1 <= 0.0 or y0 >= height as f64: return
    val dxdy = (x1 - x0) / (y1 - y0)
    var x = x0
    if y0 < 0.0:
        x = x - y0 * dxdy
    var row: i64 = if y0 < 0.0: 0 else: y0 as i64
    var row_end = y1 as i64
    if (row_end as f64) < y1: row_end = row_end + 1
    if row_end > height: row_end = height
    val limit = (stride - 2) as f64
    while row < row_end:
        val base = row * stride
        val top = if y0 > row as f64: y0 else: row as f64
        val bottom = if y1 < (row + 1) as f64: y1 else: (row + 1) as f64
        val dy = bottom - top
        var x_next = x + dxdy * dy
        val d = dy * dir
        var lo = if x < x_next: x else: x_next
        var hi = if x < x_next: x_next else: x
        if lo < 0.0: lo = 0.0
        if hi < 0.0: hi = 0.0
        if lo > limit: lo = limit
        if hi > limit: hi = limit
        val lo_floor = lo as i64
        var hi_ceil = hi as i64
        if (hi_ceil as f64) < hi: hi_ceil = hi_ceil + 1
        if hi_ceil <= lo_floor + 1:
            val mid = 0.5 * (lo + hi) - lo_floor as f64
            a[base + lo_floor] = a[base + lo_floor] + d - d * mid
            a[base + lo_floor + 1] = a[base + lo_floor + 1] + d * mid
        else:
            val s = 1.0 / (hi - lo)
            val lo_f = lo - lo_floor as f64
            val a0 = 0.5 * s * (1.0 - lo_f) * (1.0 - lo_f)
            val hi_f = hi - hi_ceil as f64 + 1.0
            val am = 0.5 * s * hi_f * hi_f
            a[base + lo_floor] = a[base + lo_floor] + d * a0
            if hi_ceil == lo_floor + 2:
                a[base + lo_floor + 1] = a[base + lo_floor + 1] + d * (1.0 - a0 - am)
            else:
                val a1 = s * (1.5 - lo_f)
                a[base + lo_floor + 1] = a[base + lo_floor + 1] + d * (a1 - a0)
                var xi = lo_floor + 2
                while xi < hi_ceil - 1:
                    a[base + xi] = a[base + xi] + d * s
                    xi = xi + 1
                val a2 = a1 + (hi_ceil - lo_floor - 3) as f64 * s
                a[base + hi_ceil - 1] = a[base + hi_ceil - 1] + d * (1.0 - a2 - am)
            a[base + hi_ceil] = a[base + hi_ceil] + d * am
        x = x_next
        row = row + 1

# Skia's analytic quadratic edge (SkAnalyticQuadraticEdge): the edge builder
# first chops a quad at its y extremum (SkChopQuadAtYExtrema, control y flattened
# onto the extremum), then each y-monotonic piece is cut into 2^shift chords
# from the curve's flatness (diff_to_shift on the 1/256 px points, AA shift 2),
# and every inner chord end is snapped to a quarter row with its x kept (or, for
# a chord at least 2 rows tall, to a whole row with x moved along the chord).
# Splitting every quad into 16 chords and snapping each end piled many vertices
# onto a crest's quarter row and drew round tops a step heavier than Chrome.
fn _lcd_area_quad(mut a: [f64], stride: i64, height: i64, ax: f64, ay: f64, cx: f64, cy: f64, bx: f64, by: f64):
    val denom = ay - 2.0 * cy + by
    if denom != 0.0:
        val t = (ay - cy) / denom
        if t > 0.0 and t < 1.0:
            val lx = ax + (cx - ax) * t
            val rx = cx + (bx - cx) * t
            val mx = lx + (rx - lx) * t
            val u = 1.0 - t
            val my = ay * u * u + 2.0 * cy * t * u + by * t * t
            _lcd_area_quad_mono(a, stride, height, ax, ay, lx, my, mx, my)
            _lcd_area_quad_mono(a, stride, height, mx, my, rx, my, bx, by)
            return
    _lcd_area_quad_mono(a, stride, height, ax, ay, cx, cy, bx, by)

fn _lcd_area_quad_mono(mut a: [f64], stride: i64, height: i64, ax: f64, ay: f64, cx: f64, cy: f64, bx: f64, by: f64):
    # 24.8 fixed point, bit length and quarter-row snaps written out (see
    # `_lcd_area_line`).
    val x0 = (ax * 256.0) as i64
    val y0 = (ay * 256.0) as i64
    val x1 = (cx * 256.0) as i64
    val y1 = (cy * 256.0) as i64
    val x2 = (bx * 256.0) as i64
    val y2 = (by * 256.0) as i64
    var ddx = (2 * x1 - x0 - x2) >> 2
    var ddy = (2 * y1 - y0 - y2) >> 2
    if ddx < 0: ddx = 0 - ddx
    if ddy < 0: ddy = 0 - ddy
    var dist = if ddx > ddy: ddx + ddy / 2 else: ddy + ddx / 2
    dist = (dist + 16) >> 5
    var bits: i64 = 0
    var rest = dist
    while rest > 0:
        rest = rest / 2
        bits = bits + 1
    var shift = bits >> 1
    if shift == 0: shift = 1
    if shift > 6: shift = 6
    val count = 1 << shift
    # Walk in increasing y like Skia, emit in the original direction.
    val down = ay <= by
    val sx = if down: ax else: bx
    val sy = if down: ay else: by
    val ex = if down: bx else: ax
    val ey = if down: by else: ay
    var xs: [f64] = [0.0; count + 1]
    var ys: [f64] = [0.0; count + 1]
    xs[0] = sx
    val sy4 = sy * 4.0 + 0.5
    var sy_q = sy4 as i64
    if (sy_q as f64) > sy4: sy_q = sy_q - 1
    ys[0] = (sy_q as f64) / 4.0
    val ey4 = ey * 4.0 + 0.5
    var ey_q = ey4 as i64
    if (ey_q as f64) > ey4: ey_q = ey_q - 1
    val last_y = (ey_q as f64) / 4.0
    var old_x = sx
    var old_y = sy
    var k: i64 = 1
    while k < count:
        val t = (k as f64) / (count as f64)
        val u = 1.0 - t
        val nx = sx * u * u + 2.0 * cx * t * u + ex * t * t
        val ny = sy * u * u + 2.0 * cy * t * u + ey * t * t
        val step_y = ny - old_y
        val step_x = nx - old_x
        val prev_x = xs[k - 1]
        val prev_y = ys[k - 1]
        var snap_y = 0.0
        var snap_x = nx
        if (step_y >= 2.0 or step_y <= -2.0) and (if step_y < 0.0: 0.0 - step_y else: step_y) * 64.0 > (if step_x < 0.0: 0.0 - step_x else: step_x):
            val nr = ny + 0.5
            var nr_q = nr as i64
            if (nr_q as f64) > nr: nr_q = nr_q - 1
            snap_y = nr_q as f64
            if snap_y > last_y: snap_y = last_y
            if ny != prev_y:
                snap_x = nx - (nx - prev_x) / (ny - prev_y) * (ny - snap_y)
        else:
            val n4 = ny * 4.0 + 0.5
            var n4_q = n4 as i64
            if (n4_q as f64) > n4: n4_q = n4_q - 1
            snap_y = (n4_q as f64) / 4.0
            if snap_y > last_y: snap_y = last_y
        xs[k] = snap_x
        ys[k] = snap_y
        old_x = nx
        old_y = ny
        k = k + 1
    xs[count] = ex
    ys[count] = last_y
    val n = count + 1
    var i: i64 = 0
    while i + 1 < n:
        if down:
            _lcd_area_line(a, stride, height, xs[i], ys[i], xs[i + 1], ys[i + 1])
        else:
            _lcd_area_line(a, stride, height, xs[n - 1 - i], ys[n - 1 - i], xs[n - 2 - i], ys[n - 2 - i])
        i = i + 1


# Signed area cells at `per_px` samples per pixel horizontally (4 = the LCD
# A8 row, 1 = whole-pixel exact area for gray glyphs).
fn _area_cells(commands: [SfntGlyfCommand], scale: f64, left: f64, top: f64, stride: i64, height: i64, per_px: i64) -> [f64]:
    var a: [f64] = [0.0; stride * height]
    var pen_x = 0.0
    var pen_y = 0.0
    var move_x = 0.0
    var move_y = 0.0
    val sx = scale * per_px as f64
    val lx = left * per_px as f64
    for command in commands:
        val x1 = command.x1 * sx - lx
        val y1 = -command.y1 * scale - top
        if command.verb == SFNT_GLYF_MOVE:
            pen_x = x1
            pen_y = y1
            move_x = x1
            move_y = y1
        elif command.verb == SFNT_GLYF_LINE:
            _lcd_area_line(a, stride, height, pen_x, pen_y, x1, y1)
            pen_x = x1
            pen_y = y1
        elif command.verb == SFNT_GLYF_QUAD:
            val x2 = command.x2 * sx - lx
            val y2 = -command.y2 * scale - top
            _lcd_area_quad(a, stride, height, pen_x, pen_y, x1, y1, x2, y2)
            pen_x = x2
            pen_y = y2
        elif command.verb == SFNT_GLYF_CLOSE:
            _lcd_area_line(a, stride, height, pen_x, pen_y, move_x, move_y)
            pen_x = move_x
            pen_y = move_y
    a

var _lcd_area_font_memo: Dict<text, bool> = {}
fn _lcd_area_font(font: OtFont, key: text) -> bool:
    if val Some(hit) = _lcd_area_font_memo.get(key):
        return hit
    # OS/2 ulUnicodeRange1 bit 15 (Devanagari) first: a font that does not
    # declare the block skips the ~3.5 ms cmap parse.
    var area = false
    if val Some(os2) = find_table(font, 1330851634):
        if os2.length >= 46 and ((blob_u32(font.blob, os2.offset as i64 + 42) >> 15) & 1) == 1:
            area = sfnt_cmap_glyph_id(font, 2325) != 0
    _lcd_area_font_memo[key] = area
    area

# --- Knot hinter: Devanagari-gated fonts only --------------------------------
# The Latin autohinter port (sfnt_af_latin.spl) hints every other font. A font
# behind the Devanagari gate (`_lcd_area_font`) keeps this older approximation
# (blue-zone knots plus horizontal-stem knots, one f64 map per glyph) until the
# port has the Devanagari style: with Latin edge hinting its low matras lose a
# row (devanagari_mark_position_chrome159_spec AC-8 / AC-10).
# Upgrade: the deva style (bug web_render_af_non_latin_styles_not_ported_2026-11-28),
# then delete this block.
# Hint reference extents (`_hint_glyph_y_extent`) per codepoint: the cmap
# lookup behind each costs ~7 ms, seven per hinted size.
var _sfnt_memo_extents: Dict<i64, [f64]> = {}
# --- Slight (y-only) autohinter approximation ---------------------------------
# Chrome on Linux renders through FreeType with hinting "slight": the latin
# autohinter, y direction only. Two effects reach the pixels at text sizes:
#   1. the y scale is adjusted so the x-height lands on a whole pixel
#      (fitted = floor(scaled + 40/64), af_latin_metrics_scale_dim), and
#   2. every blue zone (baseline, x-height, cap height, ascender, descender)
#      is snapped: reference to a whole pixel, overshoot collapsed onto it
#      unless it is at least half a pixel.
# Horizontal stem width/position snapping (edge hinting) is NOT modelled; glyph
# points between zones keep the (adjusted) scale. Knots are
# [font_y0, px_y0, font_y1, px_y1, ...] ascending in font_y; empty = unhinted.
var _lcd_hint_cache: Dict<text, [f64]> = {}

fn _hint_glyph_y_extent(font: OtFont, codepoint: i64) -> [f64]:
    if not _sfnt_memo_holds(font.blob):
        return _hint_glyph_y_extent_parsed(font, codepoint)
    if val Some(hit) = _sfnt_memo_extents.get(codepoint):
        return hit
    val extent = _hint_glyph_y_extent_parsed(font, codepoint)
    _sfnt_memo_extents[codepoint] = extent
    extent

fn _hint_glyph_y_extent_parsed(font: OtFont, codepoint: i64) -> [f64]:
    val gid = sfnt_cmap_glyph_id(font, codepoint as u32)
    if gid == 0: return []
    val outline = match _sfnt_outline_memo(font, gid):
        Some(value): value
        None: return []
    val bounds = match _outline_bounds(outline.commands):
        Some(value): value
        None: return []
    # _SfntBounds is min/max of font y: `top` = lowest y, `bottom` = highest y.
    val extent: [f64] = [bounds.top, bounds.bottom]
    extent

fn _hint_floor_half(value: f64) -> f64:
    _floor_glyf(value + 0.5) as f64

fn _hint_zone_knots(ref_y: f64, shoot_y: f64, is_top: bool, scale: f64) -> [f64]:
    val ref_px = ref_y * scale
    val fit = _hint_floor_half(ref_px)
    var gap = (shoot_y - ref_y) * scale
    if gap < 0.0: gap = 0.0 - gap
    if gap > 0.75: return []
    val gap64 = gap * 64.0
    val snapped = if gap64 < 32.0: 0.0 else: (if gap64 < 48.0: 0.5 else: 1.0)
    val shoot_fit = if is_top: fit + snapped else: fit - snapped
    if shoot_y == ref_y: [ref_y, fit]
    else if is_top: [ref_y, fit, shoot_y, shoot_fit]
    else: [shoot_y, shoot_fit, ref_y, fit]

fn _lcd_hint_knots(font: OtFont, units_per_em: i64, size_px: i64, size_milli: i64, stdw: f64) -> [f64]:
    # FreeType scales at the float size; only the 6..14 ppem x-height rule
    # reads the whole ppem (`size_px`).
    val size_f = size_milli as f64 / 1000.0
    val scale0 = size_f / units_per_em as f64
    val xe = _hint_glyph_y_extent(font, 120)
    val oe = _hint_glyph_y_extent(font, 111)
    val he = _hint_glyph_y_extent(font, 72)
    if xe.len() < 2 or oe.len() < 2 or he.len() < 2: return []
    val x_shoot = if oe[1] > xe[1]: oe[1] else: xe[1]
    val scaled = x_shoot * scale0
    if scaled <= 0.0: return []
    # FreeType rounds the x-height up more often (threshold 52/64 instead of
    # 40/64) for 6..14 ppem: its `increase-x-height` property defaults to 14.
    # FreeType works in 26.6 integers: the scaled x-height is rounded to 1/64
    # before the fit, so the ratio is fitted64 / scaled64, not fitted / scaled.
    val scaled64 = _hs_h64(scaled)
    var threshold64 = if size_px >= 6 and size_px <= 14: 52 else: 40
    var fitted64 = (scaled64 + threshold64) / 64 * 64
    # Measured against Chrome 159 (Liberation Sans, small_text_vertical_hint_chrome159_spec):
    # the round-up is refused once it would grow the em by 1.25 px or more
    # (FreeType's two-pixel cap on the scale change, over an effective
    # max_height of about 1.6 em). 10 px grows 1.19 px and rounds up (x-height
    # 6 rows); 8 px would grow 1.33 px and 6 px 1.46 px, and Chrome fits those
    # down instead (8 px `l` / `H` / x are 5 / 5 / 4 rows, 6 px 4 / 4 / 3).
    if threshold64 == 52 and size_f * (fitted64 as f64 / scaled64 as f64 - 1.0) >= 1.25:
        threshold64 = 40
        fitted64 = (scaled64 + threshold64) / 64 * 64
    val fitted = fitted64 as f64 / 64.0
    var scale = scale0
    if fitted > 0.0 and fitted64 != scaled64:
        val ratio = fitted64 as f64 / scaled64 as f64
        var tall = he[1] * scale0
        if tall < 0.0: tall = 0.0 - tall
        var grow = tall * (ratio - 1.0)
        if grow < 0.0: grow = 0.0 - grow
        if grow <= 2.0: scale = scale0 * ratio
    val ce = _hint_glyph_y_extent(font, 79)
    val le = _hint_glyph_y_extent(font, 108)
    val pe = _hint_glyph_y_extent(font, 112)
    val ge = _hint_glyph_y_extent(font, 103)
    var knots: [f64] = []
    knots = knots + _hint_zone_knots(0.0, if oe[0] < 0.0: oe[0] else: 0.0, false, scale)
    knots = knots + _hint_zone_knots(xe[1], oe[1], true, scale)
    knots = knots + _hint_zone_knots(he[1], if ce.len() >= 2: ce[1] else: he[1], true, scale)
    if le.len() >= 2 and le[1] > he[1]:
        knots = knots + _hint_zone_knots(le[1], le[1], true, scale)
    if pe.len() >= 2:
        knots = knots + _hint_zone_knots(pe[0], if ge.len() >= 2: ge[0] else: pe[0], false, scale)
    # ascending font_y, drop knots that would fold the mapping back
    var sorted: [f64] = []
    var pairs = knots.len() / 2
    var i: i64 = 0
    while i < pairs:
        val fy = knots[i * 2]
        val ty = knots[i * 2 + 1]
        var at = sorted.len() / 2
        sorted = sorted + [fy, ty]
        while at > 0 and sorted[(at - 1) * 2] > fy:
            sorted[at * 2] = sorted[(at - 1) * 2]
            sorted[at * 2 + 1] = sorted[(at - 1) * 2 + 1]
            at = at - 1
        sorted[at * 2] = fy
        sorted[at * 2 + 1] = ty
        i = i + 1
    var clean: [f64] = []
    var k: i64 = 0
    while k < sorted.len() / 2:
        val fy = sorted[k * 2]
        val ty = sorted[k * 2 + 1]
        val m = clean.len()
        if m == 0:
            clean = clean + [fy, ty]
        else if fy > clean[m - 2] and ty >= clean[m - 1]:
            clean = clean + [fy, ty]
        k = k + 1
    # last element carries the adjusted scale for extrapolation and stdw
    clean + [scale, stdw]

# Font y (units) -> hinted pixel y (y up, baseline 0).
fn _hint_map_y(knots: [f64], y: f64) -> f64:
    val n = knots.len() / 2 - 1
    val scale = knots[n * 2]
    if n <= 0: return y * scale
    if y <= knots[0]: return knots[1] + (y - knots[0]) * scale
    if y >= knots[(n - 1) * 2]: return knots[(n - 1) * 2 + 1] + (y - knots[(n - 1) * 2]) * scale
    var j: i64 = 0
    while j + 1 < n and knots[(j + 1) * 2] < y:
        j = j + 1
    val f0 = knots[j * 2]
    val f1 = knots[(j + 1) * 2]
    val t0 = knots[j * 2 + 1]
    val t1 = knots[(j + 1) * 2 + 1]
    t0 + (y - f0) * (t1 - t0) / (f1 - f0)

var _lcd_stdw_memo: Dict<text, f64> = {}

# FreeType's standard horizontal-stem width (`axis->widths[0]`) of font `fid`:
# the thinnest stem of the standard character `o`, in font units;
# AF_LATIN_CONSTANT(50) without one. It sizes the edge-merge distance. Per
# font: the cmap lookup behind it costs ~3.5 ms.
fn _lcd_stdw(font: OtFont, fid: text, units_per_em: i64) -> f64:
    if val Some(hit) = _lcd_stdw_memo.get(fid):
        return hit
    var stdw = 50.0 * units_per_em as f64 / 2048.0
    val o_gid = sfnt_cmap_glyph_id(font, 111)
    if o_gid != 0:
        if val Some(o_outline) = _sfnt_outline_memo(font, o_gid):
            val o_pairs = _hstem_pairs(_hstem_segments(o_outline.commands) + _hstem_round_extrema(o_outline.commands), units_per_em as f64)
            var p: i64 = 0
            var thinnest = 0.0
            while p < o_pairs.len() / 2:
                val w = o_pairs[p * 2 + 1] - o_pairs[p * 2]
                if w > 0.0 and (thinnest == 0.0 or w < thinnest): thinnest = w
                p = p + 1
            if thinnest > 0.0: stdw = thinnest
    _lcd_stdw_memo[fid] = stdw
    stdw

fn _lcd_hint_knots_cached(font: OtFont, fid: text, units_per_em: i64, size_px: i64, size_milli: i64) -> [f64]:
    val key = "{fid}|{size_px}|{size_milli}"
    if val Some(hit) = _lcd_hint_cache.get(key):
        return hit
    val knots = _lcd_hint_knots(font, units_per_em, size_px, size_milli, _lcd_stdw(font, fid, units_per_em))
    _lcd_hint_cache[key] = knots
    knots


# --- Horizontal-stem edge snapping (autohinter "light", y direction) ----------
# Chrome's FreeType latin autohinter also places the EDGES of horizontal stems
# (crossbars): stem width is NOT adjusted in light mode (it keeps the scaled
# outline width), only its position is fitted. Per glyph, a stem is a mutual
# nearest pair of opposite-direction near-horizontal line runs (lower run
# travels -x, upper +x: the ink is on the right of travel). An edge on a blue
# zone keeps the zone fit and the partner edge follows at the natural width;
# otherwise the stem centre snaps to a quarter-pixel lattice (width <= 1 px:
# k + 1/2; 1..1.5 px: k + 26/64; >= 1.5 px: an edge on a row boundary), all in
# 26.6 integers as FreeType does. Round (curve-extremum) edges pair the same
# way (_hstem_round_extrema): an arc keeps its natural width under its blue zone.
fn _hs_abs(v: i64) -> i64:
    if v < 0: 0 - v else: v

fn _hs_h64(v: f64) -> i64:
    _floor_glyf(v * 64.0 + 0.5)

fn _hs_round64(v: i64) -> i64:
    val t = v + 32
    val q = if t >= 0: t / 64 else: 0 - ((63 - t) / 64)
    q * 64

# Near-horizontal line runs (|dy| * 14 <= |dx|, FreeType's direction test) as
# [y, x_min, x_max, dir, key] rows; y is the run's mean, dir +1 travels +x,
# key is the command index (outline order, FreeType's segment order).
fn _hstem_segments(commands: [SfntGlyfCommand]) -> [f64]:
    var segs: [f64] = []
    var px = 0.0
    var py = 0.0
    var mx = 0.0
    var my = 0.0
    var ci = 0.0
    for c in commands:
        ci = ci + 1.0
        var ex = px
        var ey = py
        var line = false
        if c.verb == SFNT_GLYF_MOVE:
            px = c.x1
            py = c.y1
            mx = c.x1
            my = c.y1
        elif c.verb == SFNT_GLYF_LINE:
            ex = c.x1
            ey = c.y1
            line = true
        elif c.verb == SFNT_GLYF_QUAD:
            px = c.x2
            py = c.y2
        else:
            ex = mx
            ey = my
            line = true
        if line:
            val dx = ex - px
            val dy = ey - py
            val adx = if dx < 0.0: 0.0 - dx else: dx
            val ady = if dy < 0.0: 0.0 - dy else: dy
            if adx > 0.0 and ady * 14.0 <= adx:
                val lo = if dx < 0.0: ex else: px
                val hi = if dx < 0.0: px else: ex
                segs = segs + [(py + ey) / 2.0, lo, hi, if dx < 0.0: -1.0 else: 1.0, ci]
            px = ex
            py = ey
    segs

# Round edges of one contour, as the same [y, x_min, x_max, dir, key] rows as
# _hstem_segments. `pts` are the contour's points in order as [x, y, on, key]
# (on = 1.0 for an on-curve point; key = command index, the outline order). A round edge is an on-curve point
# with at least one off-curve neighbour whose two neighbours both lie on its
# near-horizontal tangent (FreeType's 1:14 direction test) and continue in the
# same x direction: the top or bottom of an arc. FreeType builds the same
# segment from the control-point / extremum / control-point run.
fn _hstem_round_contour(pts: [f64]) -> [f64]:
    var segs: [f64] = []
    var n = pts.len() / 4
    if n >= 2 and pts[(n - 1) * 4] == pts[0] and pts[(n - 1) * 4 + 1] == pts[1]:
        n = n - 1
    if n < 3: return segs
    var i: i64 = 0
    while i < n:
        val p = (i + n - 1) % n
        val q = (i + 1) % n
        if pts[i * 4 + 2] > 0.5 and (pts[p * 4 + 2] < 0.5 or pts[q * 4 + 2] < 0.5):
            val x = pts[i * 4]
            val y = pts[i * 4 + 1]
            val dxp = x - pts[p * 4]
            val dxn = pts[q * 4] - x
            var dyp = y - pts[p * 4 + 1]
            var dyn = pts[q * 4 + 1] - y
            if dyp < 0.0: dyp = 0.0 - dyp
            if dyn < 0.0: dyn = 0.0 - dyn
            val adxp = if dxp < 0.0: 0.0 - dxp else: dxp
            val adxn = if dxn < 0.0: 0.0 - dxn else: dxn
            if dxp * dxn > 0.0 and dyp * 14.0 <= adxp and dyn * 14.0 <= adxn:
                val lo = if dxp < 0.0: pts[q * 4] else: pts[p * 4]
                val hi = if dxp < 0.0: pts[p * 4] else: pts[q * 4]
                segs = segs + [y, lo, hi, if dxp < 0.0: -1.0 else: 1.0, pts[i * 4 + 3]]
        i = i + 1
    segs

# Round (curve-extremum) edges of every contour of the glyph.
fn _hstem_round_extrema(commands: [SfntGlyfCommand]) -> [f64]:
    var segs: [f64] = []
    var pts: [f64] = []
    var ci = 0.0
    for c in commands:
        ci = ci + 1.0
        if c.verb == SFNT_GLYF_MOVE:
            segs = segs + _hstem_round_contour(pts)
            pts = [c.x1, c.y1, 1.0, ci]
        elif c.verb == SFNT_GLYF_LINE:
            pts = pts + [c.x1, c.y1, 1.0, ci]
        elif c.verb == SFNT_GLYF_QUAD:
            pts = pts + [c.x1, c.y1, 0.0, ci, c.x2, c.y2, 1.0, ci]
    segs + _hstem_round_contour(pts)

# Index of the best partner of run `i`: the nearest opposite-direction run on
# the stem side with real x overlap and a plausible thickness, or -1.
fn _hstem_partner(segs: [f64], i: i64, upem: f64) -> i64:
    var best = -1
    var best_d = upem / 5.0
    val want = 0.0 - segs[i * 5 + 3]
    var j: i64 = 0
    while j < segs.len() / 5:
        if segs[j * 5 + 3] == want:
            val d = if segs[i * 5 + 3] < 0.0: segs[j * 5] - segs[i * 5] else: segs[i * 5] - segs[j * 5]
            val lo_x = if segs[i * 5 + 1] > segs[j * 5 + 1]: segs[i * 5 + 1] else: segs[j * 5 + 1]
            val hi_x = if segs[i * 5 + 2] < segs[j * 5 + 2]: segs[i * 5 + 2] else: segs[j * 5 + 2]
            if d > 0.0 and d <= best_d and hi_x - lo_x >= upem / 256.0:
                best = j
                best_d = d
        j = j + 1
    best

# Mutual stem pairs as [lo_y, hi_y, ...], ascending in lo_y, no duplicates.
fn _hstem_pairs(segs: [f64], upem: f64) -> [f64]:
    var pairs: [f64] = []
    var i: i64 = 0
    while i < segs.len() / 5:
        if segs[i * 5 + 3] < 0.0:
            val j = _hstem_partner(segs, i, upem)
            if j >= 0 and _hstem_partner(segs, j, upem) == i:
                val lo = segs[i * 5]
                val hi = segs[j * 5]
                var dup = false
                var k: i64 = 0
                while k < pairs.len() / 2:
                    if pairs[k * 2] == lo and pairs[k * 2 + 1] == hi: dup = true
                    k = k + 1
                if not dup:
                    var at = pairs.len() / 2
                    pairs = pairs + [lo, hi]
                    while at > 0 and pairs[(at - 1) * 2] > lo:
                        pairs[at * 2] = pairs[(at - 1) * 2]
                        pairs[at * 2 + 1] = pairs[(at - 1) * 2 + 1]
                        at = at - 1
                    pairs[at * 2] = lo
                    pairs[at * 2 + 1] = hi
        i = i + 1
    pairs

# Zone-fit pixel y of the knot within `tol` font units of `y`, as a 1-element
# list, or [] when `y` is on no blue zone.
fn _hstem_blue_fit(knots: [f64], n: i64, y: f64, tol: f64) -> [f64]:
    var best: [f64] = []
    var best_d = tol
    var i: i64 = 0
    while i < n:
        var d = knots[i * 2] - y
        if d < 0.0: d = 0.0 - d
        if d <= best_d:
            best_d = d
            best = [knots[i * 2 + 1]]
        i = i + 1
    best

# Inserts (fy, ty) keeping the list ascending and non-folding. Returns [] when
# it would fold the mapping; a knot already at that fy must agree.
fn _hstem_insert(base: [f64], fy: f64, ty: f64) -> [f64]:
    var out: [f64] = []
    var placed = false
    var i: i64 = 0
    while i < base.len() / 2:
        val bf = base[i * 2]
        val bt = base[i * 2 + 1]
        if bf - fy < 0.5 and fy - bf < 0.5:
            if bt - ty < 0.0001 and ty - bt < 0.0001: return base
            return []
        if not placed and fy < bf:
            out = out + [fy, ty]
            placed = true
        out = out + [bf, bt]
        i = i + 1
    if not placed: out = out + [fy, ty]
    var k: i64 = 1
    while k < out.len() / 2:
        if out[k * 2] <= out[(k - 1) * 2] or out[k * 2 + 1] < out[(k - 1) * 2 + 1]: return []
        k = k + 1
    out

# `cur` plus the knot (y -> zone fit) when `y` is on a blue zone and the knot
# does not fold the mapping.
fn _hstem_edge_knot(cur: [f64], zones: [f64], n: i64, y: f64, tol: f64) -> [f64]:
    val fit = _hstem_blue_fit(zones, n, y, tol)
    if fit.len() == 0: return cur
    val added = _hstem_insert(cur, y, fit[0])
    if added.len() > 0: added else: cur

fn _hstem_knots(commands: [SfntGlyfCommand], knots: [f64], upem: f64) -> [f64]:
    val m = knots.len()
    if m < 4: return knots
    val scale = knots[m - 2]
    val lsegs = _hstem_segments(commands)
    val segs = lsegs + _hstem_round_extrema(commands)
    val raw_pairs = _hstem_pairs(segs, upem)
    # FreeType merges same-direction segments closer than
    # min(stdw / 5, 0.25 px) into one EDGE at its first segment's position
    # (af_latin_hints_compute_edges): an `r`/`n` arch crest (round, on the
    # x-height overshoot) joins the flat stem top on the x-height reference,
    # so the arch's inner arc pairs with the REFERENCE edge, and a point
    # between the two follows that edge. reps[i] is segment i's edge position.
    val scale64 = knots[m - 2] * 64.0
    var thr64 = _hs_h64(_floor_glyf(knots[m - 1] / 5.0) as f64 * knots[m - 2])
    if thr64 > 16: thr64 = 16
    val thr = thr64 as f64 / scale64
    val ns = segs.len() / 5
    # Line runs and round extrema are each in outline order: merge the two.
    val nl = lsegs.len() / 5
    var order: [i64] = []
    var li: i64 = 0
    var ri: i64 = nl
    while li < nl or ri < ns:
        if ri >= ns or (li < nl and segs[li * 5 + 4] <= segs[ri * 5 + 4]):
            order = order.push(li)
            li = li + 1
        else:
            order = order.push(ri)
            ri = ri + 1
    var reps: [f64] = [0.0; ns]
    var edges: [i64] = []
    var oi: i64 = 0
    while oi < ns:
        val i = order[oi]
        reps[i] = segs[i * 5]
        val yi = segs[i * 5]
        val di = segs[i * 5 + 3]
        var found = false
        for e in edges:
            if segs[e * 5 + 3] == di:
                val d = yi - segs[e * 5]
                if d < thr and d > 0.0 - thr:
                    reps[i] = segs[e * 5]
                    found = true
                    break
        if not found: edges = edges.push(i)
        oi = oi + 1
    var pairs: [f64] = []
    var pi: i64 = 0
    while pi < raw_pairs.len():
        pairs = pairs.push(_hstem_rep(segs, reps, raw_pairs[pi]))
        pi = pi + 1
    val bounds = match _outline_bounds(commands):
        Some(value): value
        None: return knots
    var zones: [f64] = []
    var z: i64 = 0
    while z < m / 2 - 1:
        zones = zones + [knots[z * 2], knots[z * 2 + 1]]
        z = z + 1
    val n = zones.len() / 2
    val tol = upem / 40.0
    # FreeType fits EDGES, not the y axis: a blue zone moves only the edges this
    # glyph has on it, and every other point follows the glyph's own edges. So
    # the glyph's knots are its blue edges (and blue extrema), not every zone:
    # an `o` has no edge on the flat baseline reference, and a knot there would
    # squash the arc between the collapsed overshoot and the inner edge.
    var cur: [f64] = []
    cur = _hstem_edge_knot(cur, zones, n, _hstem_rep(segs, reps, bounds.top), tol)
    cur = _hstem_edge_knot(cur, zones, n, _hstem_rep(segs, reps, bounds.bottom), tol)
    var e: i64 = 0
    while e < segs.len() / 5:
        cur = _hstem_edge_knot(cur, zones, n, reps[e], tol)
        e = e + 1
    # The lowest blue extremum anchors the glyph: unanchored stems are placed
    # relative to the shift it receives from its zone fit.
    # FreeType keeps every original edge position (`opos`) as its own rounded
    # 26.6 value, so a stem's origin is anchor->pos + (opos - anchor->opos) in
    # integers. Adding a float shift first and rounding once picked the other
    # side of the 16 px `5` bowl stem (org_center 442 vs FreeType's 441, a
    # u_off/d_off tie) and drew the bowl top a whole row high.
    var shift64: i64 = 0
    val low = _hstem_blue_fit(zones, n, bounds.top, tol)
    val high = _hstem_blue_fit(zones, n, bounds.bottom, tol)
    if low.len() > 0: shift64 = _hs_h64(low[0]) - _hs_h64(bounds.top * scale)
    else if high.len() > 0: shift64 = _hs_h64(high[0]) - _hs_h64(bounds.bottom * scale)
    var s: i64 = 0
    while s < pairs.len() / 2:
        val lo = pairs[s * 2]
        val hi = pairs[s * 2 + 1]
        val len64 = _hs_h64(hi * scale) - _hs_h64(lo * scale)
        val lob = _hstem_blue_fit(zones, n, lo, tol)
        val hib = _hstem_blue_fit(zones, n, hi, tol)
        var pos_lo = 0
        var pos_hi = 0
        var place = true
        if lob.len() > 0 and hib.len() > 0:
            place = false
        else if lob.len() > 0:
            pos_lo = _hs_h64(lob[0])
            pos_hi = pos_lo + len64
        else if hib.len() > 0:
            pos_hi = _hs_h64(hib[0])
            pos_lo = pos_hi - len64
        else:
            val org_pos = _hs_h64(lo * scale) + shift64
            val org_center = org_pos + len64 / 2
            if len64 < 96:
                val u_off = if len64 <= 64: 32 else: 38
                val d_off = if len64 <= 64: 32 else: 26
                val c1 = _hs_round64(org_center)
                val e1 = _hs_abs(org_center - (c1 - u_off))
                val e2 = _hs_abs(org_center - (c1 + d_off))
                val centre = if e1 < e2: c1 - u_off else: c1 + d_off
                pos_lo = centre - len64 / 2
                pos_hi = centre + len64 / 2
            else:
                val p1 = _hs_round64(org_pos)
                val d1 = _hs_abs(p1 + len64 / 2 - org_center)
                val p2 = _hs_round64(org_pos + len64) - len64
                val d2 = _hs_abs(p2 + len64 / 2 - org_center)
                pos_lo = if d1 < d2: p1 else: p2
            if len64 >= 96: pos_hi = pos_lo + len64
        if place:
            val a = _hstem_insert(cur, lo, pos_lo as f64 / 64.0)
            if a.len() > 0:
                val b = _hstem_insert(a, hi, pos_hi as f64 / 64.0)
                if b.len() > 0:
                    cur = b
        s = s + 1
    # A merged segment's own points take its edge's position; every other
    # point keeps following the edges: a spike knot at the segment's y.
    var spikes: [f64] = []
    var t: i64 = 0
    while t < segs.len() / 5:
        val y = segs[t * 5]
        if reps[t] != y:
            val tail = cur + [scale, 0.0]
            spikes = spikes + [y - 0.5, _hint_map_y(tail, y - 0.5), y, _hint_map_y(tail, reps[t]), y + 0.5, _hint_map_y(tail, y + 0.5)]
        t = t + 1
    if spikes.len() == 0: return cur + [scale, 0.0]
    var all: [f64] = []
    var c: i64 = 0
    while c < cur.len() / 2:
        var near = false
        var k: i64 = 0
        while k < spikes.len() / 2:
            val d = spikes[k * 2] - cur[c * 2]
            if d < 0.5 and d > -0.5: near = true
            k = k + 1
        if not near: all = _hstem_put(all, cur[c * 2], cur[c * 2 + 1])
        c = c + 1
    var k2: i64 = 0
    while k2 < spikes.len() / 2:
        all = _hstem_put(all, spikes[k2 * 2], spikes[k2 * 2 + 1])
        k2 = k2 + 1
    all + [scale, 0.0]

# Edge position (see _hstem_knots) of font y `y`: the rep of the segment at
# `y`, or `y` itself when no segment sits there.
fn _hstem_rep(segs: [f64], reps: [f64], y: f64) -> f64:
    var i: i64 = 0
    while i < reps.len():
        if segs[i * 5] == y: return reps[i]
        i = i + 1
    y

# (fy, ty) inserted in ascending fy; a knot already at fy is kept.
fn _hstem_put(base: [f64], fy: f64, ty: f64) -> [f64]:
    var out: [f64] = []
    var placed = false
    var i: i64 = 0
    while i < base.len() / 2:
        if base[i * 2] == fy: return base
        if not placed and fy < base[i * 2]:
            out = out + [fy, ty]
            placed = true
        out = out + [base[i * 2], base[i * 2 + 1]]
        i = i + 1
    if not placed: out = out + [fy, ty]
    out

# The hinter works in 26.6 fixed point (FreeType af_*, and skrifa's port that
# Chrome 159 runs), so every hinted point lands on a 1/64 px grid in x as
# well as y: the 16 px `i` stem (136..316 units) becomes 69/64..159/64 px,
# the same as `l` (138..318 units), and Chrome draws both identically.
fn _hint_grid(v_px: f64, scale: f64) -> f64:
    (_floor_glyf(v_px * 64.0 + 0.5) as f64) / (64.0 * scale)

fn _hint_commands(commands: [SfntGlyfCommand], knots: [f64], scale: f64) -> [SfntGlyfCommand]:
    var out: [SfntGlyfCommand] = []
    for c in commands:
        if c.verb == SFNT_GLYF_CLOSE:
            out = out.push(c)
        else:
            out = out.push(_command(c.verb, _hint_grid(c.x1 * scale, scale), _hint_grid(_hint_map_y(knots, c.y1), scale), _hint_grid(c.x2 * scale, scale), _hint_grid(_hint_map_y(knots, c.y2), scale)))
    out

fn _scale_commands_x(commands: [SfntGlyfCommand], ratio: f64) -> [SfntGlyfCommand]:
    var out: [SfntGlyfCommand] = []
    for c in commands:
        if c.verb == SFNT_GLYF_CLOSE:
            out = out.push(c)
        else:
            out = out.push(_command(c.verb, c.x1 * ratio, c.y1, c.x2 * ratio, c.y2))
    out

var _af_face_memo: Dict<text, [i64]> = {}
var _af_scaled_memo: Dict<text, [i64]> = {}

# The autohinter's per-font metrics (standard width, blue zones) of font
# `fid`; empty when the font has no Latin blue zone (it is then not hinted).
# One cmap pass for the blue characters and the standard character.
fn _af_face(font: OtFont, fid: text, units_per_em: i64) -> [i64]:
    if val Some(hit) = _af_face_memo.get(fid):
        return hit
    var codepoints: [i64] = [AF_LATIN_STANDARD_CHAR]
    var ci: i64 = 0
    while ci < AF_LATIN_BLUE_CHARS.byte_len():
        val cp = AF_LATIN_BLUE_CHARS.char_code_at(ci)
        if cp != 124: codepoints.push(cp)
        ci = ci + 1
    var glyph_ids: [i64] = []
    while glyph_ids.len() < codepoints.len():
        glyph_ids.push(0)
    sfnt_cmap_glyph_ids_into(font, codepoints, glyph_ids)
    var std_pts: [i64] = []
    var blue_pts: [[i64]] = []
    var gi: i64 = 0
    while gi < glyph_ids.len():
        var pts: [i64] = []
        if glyph_ids[gi] > 0:
            if val Some(outline) = _sfnt_outline_memo(font, glyph_ids[gi] as u32):
                pts = outline.sgo_points
        if gi == 0: std_pts = pts
        else: blue_pts.push(pts)
        gi = gi + 1
    val face = af_latin_face_metrics(units_per_em, std_pts, blue_pts)
    _af_face_memo[fid] = face
    face

fn _af_scaled(face: [i64], fid: text, size64: i64) -> [i64]:
    val key = "{fid}|{size64}"
    if val Some(hit) = _af_scaled_memo.get(key):
        return hit
    val scaled = af_latin_scaled_metrics(face, size64)
    _af_scaled_memo[key] = scaled
    scaled

var _af_nonbase_fonts: Dict<text, bool> = {}
var _af_nonbase_memo: Dict<text, bool> = {}

# Whether glyph `glyph_id` is one of the autohinter's non-base glyphs (a
# spacing or combining accent, hinted without blue zones). FreeType marks the
# glyphs its cmap gives for the non-base codepoints; one cmap pass per font
# over those up to U+036F.
fn _af_glyph_nonbase(font: OtFont, fid: text, glyph_id: i64) -> bool:
    if not _af_nonbase_fonts.has(fid):
        var codepoints: [i64] = []
        var cp: i64 = 94
        while cp <= 879:
            if af_latin_is_nonbase(cp): codepoints.push(cp)
            cp = cp + 1
        var glyph_ids: [i64] = []
        while glyph_ids.len() < codepoints.len():
            glyph_ids.push(0)
        sfnt_cmap_glyph_ids_into(font, codepoints, glyph_ids)
        for gid in glyph_ids:
            if gid > 0: _af_nonbase_memo["{fid}|{gid}"] = true
        _af_nonbase_fonts[fid] = true
    _af_nonbase_memo.has("{fid}|{glyph_id}")

# The hinted outline as commands in font units of `scale` (hinted 26.6 px /
# (64 scale)), decomposed like FT_Outline_Decompose: an implied on-curve point
# is the truncating midpoint of its two HINTED controls.
fn _af_commands(pts: [i64], hinted: [i64], scale: f64) -> [SfntGlyfCommand]:
    val unit = 64.0 * scale
    var out: [SfntGlyfCommand] = []
    val n = pts.len() / 3
    var first: i64 = 0
    var i: i64 = 0
    while i < n:
        if (pts[i * 3 + 2] & 2) != 0:
            var limit = i
            var sx = hinted[first * 2]
            var sy = hinted[first * 2 + 1]
            var point = first + 1
            if (pts[first * 3 + 2] & 1) == 0:
                if (pts[i * 3 + 2] & 1) != 0:
                    sx = hinted[i * 2]
                    sy = hinted[i * 2 + 1]
                    limit = i - 1
                else:
                    sx = (sx + hinted[i * 2]) / 2
                    sy = (sy + hinted[i * 2 + 1]) / 2
                point = first
            out = out.push(_command(SFNT_GLYF_MOVE, sx as f64 / unit, sy as f64 / unit, 0.0, 0.0))
            while point <= limit:
                if (pts[point * 3 + 2] & 1) != 0:
                    out = out.push(_command(SFNT_GLYF_LINE, hinted[point * 2] as f64 / unit, hinted[point * 2 + 1] as f64 / unit, 0.0, 0.0))
                else:
                    var cx = hinted[point * 2]
                    var cy = hinted[point * 2 + 1]
                    var open = true
                    while open:
                        if point < limit:
                            point = point + 1
                            val vx = hinted[point * 2]
                            val vy = hinted[point * 2 + 1]
                            if (pts[point * 3 + 2] & 1) != 0:
                                out = out.push(_command(SFNT_GLYF_QUAD, cx as f64 / unit, cy as f64 / unit, vx as f64 / unit, vy as f64 / unit))
                                open = false
                            else:
                                out = out.push(_command(SFNT_GLYF_QUAD, cx as f64 / unit, cy as f64 / unit, ((cx + vx) / 2) as f64 / unit, ((cy + vy) / 2) as f64 / unit))
                                cx = vx
                                cy = vy
                        else:
                            out = out.push(_command(SFNT_GLYF_QUAD, cx as f64 / unit, cy as f64 / unit, sx as f64 / unit, sy as f64 / unit))
                            open = false
                point = point + 1
            out = out.push(_command(SFNT_GLYF_CLOSE, 0.0, 0.0, 0.0, 0.0))
            first = i + 1
        i = i + 1
    out

# reason: SFNT selector/size/phase scalars are the font-table domain;
# consumed by text_layout/font_renderer.spl, so it must be public.
# @allow(primitive_api)
pub fn sfnt_render_glyph_lcd(blob: [u8], selector_kind: i64, selector_value: i64, size_px: i64, phase_q: i64) -> Option<SfntLcdGlyph>:
    sfnt_render_glyph_lcd_milli(blob, selector_kind, selector_value, size_px, 0, phase_q)

# Chrome 159's font-cache-key size of a computed `font-size` (milli-px), in
# 26.6 (1/64 px). Blink keys its font cache on `trunc(f32(size) * 100)` and
# Skia hands FreeType that size truncated to 26.6, so 18.72 px rasterises at
# 1197/64 (font_cache_key_size_chrome159_spec). Every text lane takes its
# fractional size from here.
# reason: milli-px in, 1/64-px out; consumed by font_renderer and the raster lane.
# @allow(primitive_api)
pub fn sfnt_font_cache_key_size_26_6(size_milli: i64) -> i64:
    val size: f32 = ((size_milli as f64) / 1000.0) as f32
    val hundredths = (size * (100.0 as f32)) as i64
    val keyed: f32 = ((hundredths as f64) / 100.0) as f32
    (keyed * (64.0 as f32)) as i64

# Fractional-size twin (`font-size: 18.72px`). `x_milli` is the computed size
# in milli-px; 0 or a whole `size_px * 1000` is the plain whole-px glyph.
# Measured against Chrome 159 (Liberation Sans/Serif, 1x): 18.72 px and 19 px
# ink sit on the same rows, as do 13.28 px and 13 px. FreeType's light
# autohinter scales both axes at the 26.6 size (`sfnt_font_cache_key_size_26_6`,
# which the caller applies before `x_milli`)
# and fits the x-height to the pixel grid (13.3333 px mono caps are 10 rows, as
# in Chrome).
# reason: SFNT selector/size/phase scalars are the font-table domain;
# consumed by text_layout/font_renderer.spl, so it must be public.
# @allow(primitive_api)
pub fn sfnt_render_glyph_lcd_milli(blob: [u8], selector_kind: i64, selector_value: i64, size_px: i64, x_milli: i64, phase_q: i64) -> Option<SfntLcdGlyph>:
    if phase_q < 0 or phase_q > 3:
        return None
    val outline = match sfnt_lcd_glyph_outline(blob, selector_kind, selector_value, size_px, x_milli):
        Some(value): value
        None: return None
    sfnt_lcd_outline_raster(outline, phase_q)

# The half of an LCD glyph that does not depend on the quarter-pixel phase:
# the hinted outline, its scale, the unhinted x extent the phase shifts, the
# vertical frame and the advance. A glyph drawn at several phases (a text run
# uses up to four per glyph) parses, hints and frames once, and
# `sfnt_lcd_outline_frame` answers a cell's metrics without rastering it.
class SfntLcdOutline:
    slo_commands: [SfntGlyfCommand]
    slo_scale: f64
    slo_left: f64
    slo_right: f64
    slo_height: i64
    slo_raster_top: f64
    slo_bearing_y: i64
    slo_advance: i64
    # Exact-area mask instead of the Skia AAA port (see _lcd_area_outline_raster).
    slo_area: bool
    # Identity of the outline (font, glyph, size): the phase-0 mask memo key.
    slo_key: text

# reason: SFNT selector/size scalars are the font-table domain; consumed by
# text_layout/font_renderer.spl, so it must be public.
# @allow(primitive_api)
pub fn sfnt_lcd_glyph_outline(blob: [u8], selector_kind: i64, selector_value: i64, size_px: i64, x_milli: i64) -> Option<SfntLcdOutline>:
    _glyph_outline(blob, selector_kind, selector_value, size_px, x_milli, false)

# The same outline for a GRAYSCALE glyph above the LCD cutoff: unhinted, framed
# like `sfnt_render_glyph_into` (`_gray_frame`, baseline anchored), so the
# quarter-phase cells `sfnt_gray_outline_raster` builds sit on the rows the
# 4x4 path used. A glyph drawn at several phases parses and frames once.
# reason: SFNT selector/size scalars are the font-table domain; consumed by
# text_layout/font_renderer.spl.
# @allow(primitive_api)
pub fn sfnt_gray_glyph_outline(blob: [u8], selector_kind: i64, selector_value: i64, size_px: i64, x_milli: i64) -> Option<SfntLcdOutline>:
    _glyph_outline(blob, selector_kind, selector_value, size_px, x_milli, true)

fn _glyph_outline(blob: [u8], selector_kind: i64, selector_value: i64, size_px: i64, x_milli: i64, gray: bool) -> Option<SfntLcdOutline>:
    if size_px <= 0 or size_px > 512:
        return None
    if x_milli < 0 or x_milli > 512000:
        return None
    val font = match _sfnt_font_memo(blob):
        Some(value): value
        None: return None
    var glyph_id: u32 = 0
    if selector_kind == SFNT_GLYPH_SELECTOR_CODEPOINT and selector_value >= 0 and selector_value <= 1114111:
        glyph_id = sfnt_cmap_glyph_id(font, selector_value as u32)
    else if selector_kind == SFNT_GLYPH_SELECTOR_INDEX and selector_value > 0 and selector_value <= 4294967295:
        glyph_id = selector_value as u32
    else:
        return None
    if glyph_id == 0:
        return None
    val head_table = match find_table(font, 1751474532):
        Some(value): value
        None: return None
    val hhea_table = match find_table(font, 1751672161):
        Some(value): value
        None: return None
    if not _table_is_bounded(font, head_table, 54) or not _table_is_bounded(font, hhea_table, 36):
        return None
    val units_per_em = read_u16_be(font.blob, head_table.offset as i64 + 18) as i64
    val long_metrics = read_u16_be(font.blob, hhea_table.offset as i64 + 34) as i64
    if units_per_em == 0 or long_metrics == 0:
        return None
    val parsed_outline = match _sfnt_outline_memo(font, glyph_id):
        Some(value): value
        None: return None
    val horizontal = match _hmtx(font, long_metrics, glyph_id):
        Some(value): value
        None: return None
    val x_frac = x_milli > 0 and x_milli != size_px * 1000
    # A gray glyph is unhinted: its float size scales both axes (y too).
    val gray_frac = gray and x_frac
    val x_ratio = if x_frac and not gray_frac: x_milli as f64 / (size_px * 1000) as f64 else: 1.0
    val commands = if x_frac and not gray_frac: _scale_commands_x(parsed_outline.commands, x_ratio) else: parsed_outline.commands
    val bounds = match _outline_bounds(commands):
        Some(value): value
        None: return None
    val scale = if gray_frac: x_milli as f64 / (1000 * units_per_em) as f64 else: size_px as f64 / units_per_em as f64
    var height = _ceil_glyf_dimension((bounds.bottom - bounds.top) * scale)
    var raster_top = -bounds.bottom * scale
    var bearing_y = _round_glyf_metric(bounds.top * scale)
    var draw_commands = commands
    if gray:
        val frame = _gray_frame(bounds, scale, size_px)
        height = frame.height
        raster_top = 0.0 - frame.top
        bearing_y = frame.bearing_y
    # Font identity (blob length, head checkSumAdjustment): the key of the
    # per-font hint, stem-width and gate memos.
    val fid = "{font.blob.len()}|{blob_u32(font.blob, head_table.offset as i64 + 8)}"
    # Chrome hints a glyf outline with the Latin autohinter in light mode at
    # its 26.6 size.
    # ponytail: font-level gate. FreeType hints Devanagari glyphs in its
    # deva style (headline x-height, deva blue zones); the port only has
    # the Latin style, so a Devanagari font keeps the knot hinter and the
    # exact-area mask, which match Chrome on its marks
    # (devanagari_mark_position_chrome159_spec).
    # Upgrade: the deva style in sfnt_af_latin.spl, then drop the gate.
    val area = not gray and _lcd_area_font(font, fid)
    var hinted = false
    if area:
        val knots = _lcd_hint_knots_cached(font, fid, units_per_em, size_px, if x_frac: x_milli else: size_px * 1000)
        if knots.len() > 0:
            draw_commands = _hint_commands(commands, _hstem_knots(commands, knots, units_per_em as f64), scale)
            hinted = true
    else if not gray and parsed_outline.sgo_points.len() > 0:
        val face = _af_face(font, fid, units_per_em)
        if face.len() > 0:
            # `x_milli` is the 26.6 size rounded to milli-px (the callers derive it
            # from sfnt_font_cache_key_size_26_6), so this recovers it exactly.
            val size64 = if x_frac: (x_milli * 64 + 500) / 1000 else: size_px * 64
            val nonbase = if selector_kind == SFNT_GLYPH_SELECTOR_CODEPOINT: af_latin_is_nonbase(selector_value) else: _af_glyph_nonbase(font, fid, glyph_id as i64)
            draw_commands = _af_commands(parsed_outline.sgo_points, af_latin_hint_points(parsed_outline.sgo_points, face, _af_scaled(face, fid, size64), not nonbase), scale)
            hinted = true
    if hinted:
        val hinted_bounds = match _outline_bounds(draw_commands):
            Some(value): value
            None: return None
        val bottom_px = _floor_glyf(hinted_bounds.top * scale + 0.0001)
        val top_px = _ceil_glyf(hinted_bounds.bottom * scale - 0.0001)
        height = if top_px > bottom_px: top_px - bottom_px else: 1
        raster_top = 0.0 - (bottom_px + height) as f64
        bearing_y = bottom_px
    Some(SfntLcdOutline(
        slo_commands: draw_commands, slo_scale: scale,
        slo_left: bounds.left, slo_right: bounds.right,
        slo_height: height, slo_raster_top: raster_top, slo_bearing_y: bearing_y,
        slo_advance: _round_glyf_metric(horizontal[0] as f64 * scale * x_ratio), slo_area: area,
        slo_key: "{fid}|{glyph_id}|{size_px}|{x_milli}|{gray}"))

# --- Skia analytic AA LCD mask (SkScan_AAAPath) ---------------------------------
# Chrome 159 renders an LCD glyph (SkScalerContext::GenerateImageFromPath) by
# scaling the hinted path 4x in x into an A8 mask of 4W-8 samples and filling
# it with Skia's analytic AA scan converter: 16.16 fixed point, quarter-row
# snapped line ends, forward-differenced quad chords, per-strip alpha
# truncation, src-over writes for whole-row strips and saturating accumulation
# for partial ones. An exact-area accumulator over the same outline is a
# different raster (measured: 328 mismatching px on 27 round glyphs at 16 px
# vs 117 for Skia's own rasteriser on the same hinted outline). This is a port
# of that algorithm: non-convex walker (SafeRLE / mask blitter), convex walker
# (RunBased / mask), fat-rect fast path. Byte-exact against libskia's
# SkDrawBase + SkA8Blitter on Liberation Sans/Serif/Mono 11..44 px at all four
# quarter phases (2026-11-24, lcd_round_glyph_aaa_chrome159_spec).
#
# Edge record: one flat [i64], 24 slots per edge, addressed by base offset;
# base 0 = head sentinel, 24 = tail sentinel, -1 = none.
#   0 x  1 dx  2 upper_x  3 y  4 upper_y  5 lower_y  6 dy  7 curve_count
#   8 curve_shift  9 winding  10 qx  11 qy  12 qdx  13 qdy  14 qddx  15 qddy
#   16 qlast_x  17 qlast_y  18 snapped_x  19 snapped_y  20 prev  21 next
#   22 kind (0 line, 1 quad)
# Blitter state `o`: [0] width [1] height [2] mask? [3] saturating? [4] ir_left
# [5] ir_right [6] accumulated row (-1 none) [7] offset of sample (0, 0) of
# the result plane; then the accumulated row (width), the A8 plane and the
# mask plane (mask only). Plane rows have 16 zero samples each side (stride
# width + 32), so the LCD filter reads a shifted row in place.

# Skia gQuickInverseTable: trunc(2^22 / x) for 0 < |x| <= 1024.
fn _aaa_quick_div(a: i64, b: i64) -> i64:
    if (if b < 0: 0 - b else: b) >= 8 and (if b < 0: 0 - b else: b) < 1024 and (if a < 0: 0 - a else: a) < 4096:
        return (a * (if b == 0: 0 else: 4194304 / b)) >> 6
    if a >= -32768 and a <= 32767:
        return (a * 65536) / b
    var r = (a * 65536) / b
    if r > 2147483647: r = 2147483647
    if r < -2147483648: r = -2147483648
    r

fn _aaa_ceil_fixed(v: i64) -> i64:
    ((v + 65535) >> 16) << 16

fn _aaa_alpha(v: i64) -> i64:
    (255 * v + 32768) >> 16

fn _aaa_min(a: i64, b: i64) -> i64:
    if a < b: a else: b

fn _aaa_max(a: i64, b: i64) -> i64:
    if a > b: a else: b

fn _aaa_update_quad(e: [i64], b: i64) -> bool:
    var success = false
    var count = e[b + 7]
    var oldx = e[b + 10]
    var oldy = e[b + 11]
    var dx = e[b + 12]
    var dy = e[b + 13]
    val shift = e[b + 8]
    val last_y = e[b + 17]
    val sx = e[b + 18]
    val sy = e[b + 19]
    var newx = 0
    var newy = 0
    var nsx = 0
    var nsy = 0
    var going = true
    while going:
        var slope = 2147483647
        count = count - 1
        var num = 0
        var den = 0
        var steep = false
        if count > 0:
            val step_y = dy >> shift
            newx = oldx + (dx >> shift)
            newy = oldy + step_y
            val ady = if step_y < 0: 0 - step_y else: step_y
            if ady >= 131072 and (if dy < 0: 0 - dy else: dy) * 64 > (if dx < 0: 0 - dx else: dx):
                steep = true
                nsy = ((newy + 32768) >> 16) << 16
                if last_y < nsy: nsy = last_y
                den = (newy - sy) >> 10
            else:
                nsy = ((newy + 8192) >> 14) << 14
                if last_y < nsy: nsy = last_y
                den = (nsy - sy) >> 10
            num = (newx - sx) >> 10
            dx = dx + e[b + 14]
            dy = dy + e[b + 15]
        else:
            newx = e[b + 16]
            newy = last_y
            nsy = newy
            num = (newx - sx) >> 10
            den = (newy - sy) >> 10
        if den != 0:
            # QuickSkFDot6Div, fast path inline
            val an = if num < 0: 0 - num else: num
            val ad = if den < 0: 0 - den else: den
            slope = if ad >= 8 and ad < 1024 and an < 4096: (num * (4194304 / den)) >> 6 else: _aaa_quick_div(num, den)
        nsx = if steep: newx - ((slope * (newy - nsy)) >> 16) else: newx
        if slope < 2147483647:
            # SkAnalyticEdge::updateLine (the chord sx,sy -> nsx,nsy), inline.
            var ux0 = sx
            var uy0 = sy
            var uy1 = nsy
            var udx = (nsx - sx) >> 10
            if sy > nsy:
                e[b + 9] = 0 - e[b + 9]
                ux0 = nsx
                uy0 = nsy
                uy1 = sy
                udx = (sx - nsx) >> 10
            val udy = (uy1 - uy0) >> 10
            if udy != 0:
                val us = slope >> 10
                val uabs = if us < 0: 0 - us else: us
                e[b] = ux0
                e[b + 1] = slope
                e[b + 2] = ux0
                e[b + 3] = uy0
                e[b + 4] = uy0
                e[b + 5] = uy1
                if udx == 0 or slope == 0:
                    e[b + 6] = 2147483647
                elif uabs < 1024:
                    e[b + 6] = if uabs == 0: 0 else: 4194304 / uabs
                else:
                    val q = _aaa_quick_div(udy, udx)
                    e[b + 6] = if q < 0: 0 - q else: q
                success = true
        oldx = newx
        oldy = newy
        going = count > 0 and not success
    e[b + 10] = newx
    e[b + 11] = newy
    e[b + 12] = dx
    e[b + 13] = dy
    e[b + 18] = nsx
    e[b + 19] = nsy
    e[b + 7] = count
    success

fn _aaa_set_quad(e: [i64], b: i64, p0x: f64, p0y: f64, p1x: f64, p1y: f64, p2x: f64, p2y: f64) -> bool:
    var x0 = ((((p0x * 256.0) as f32) as f64)) as i64
    var y0 = ((((p0y * 256.0) as f32) as f64)) as i64
    val x1 = ((((p1x * 256.0) as f32) as f64)) as i64
    val y1 = ((((p1y * 256.0) as f32) as f64)) as i64
    var x2 = ((((p2x * 256.0) as f32) as f64)) as i64
    var y2 = ((((p2y * 256.0) as f32) as f64)) as i64
    var w = 1
    if y0 > y2:
        val tx = x0
        x0 = x2
        x2 = tx
        val ty = y0
        y0 = y2
        y2 = ty
        w = -1
    if ((y0 + 32) >> 6) == ((y2 + 32) >> 6): return false
    # SkFDot6 diff_to_shift, inline.
    val sdx = (x1 * 2 - x0 - x2) >> 2
    val sdy = (y1 * 2 - y0 - y2) >> 2
    val sax = if sdx < 0: 0 - sdx else: sdx
    val say = if sdy < 0: 0 - sdy else: sdy
    var dist = ((if sax > say: sax + (say >> 1) else: say + (sax >> 1)) + 16) >> 5
    var bits = 0
    while dist > 0:
        dist = dist >> 1
        bits = bits + 1
    var shift = bits >> 1
    if shift == 0: shift = 1
    elif shift > 6: shift = 6
    val ax = (x0 - x1 - x1 + x2) * 512
    val ay = (y0 - y1 - y1 + y2) * 512
