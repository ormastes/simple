        elif len == 2:
            val first = jl - 65536 - ul
            val px2 = ul >> 16
            val pa2 = ((((first >> 11) * (first >> 11) * (ldy >> 11)) >> 8) & 255)
            if real:
                if pa2 != 0 and px2 >= 0 and px2 < w:
                    val pi2 = rbase + px2
                    if pa2 == 255:
