        # SafeRLE addAntiH: clipped to the path's ir, one row check.
        if y != o[6]:
            _aaa_flush(o)
            o[6] = y
        var i = if o[4] - left > 0: o[4] - left else: 0
        val stop = if o[5] - left < len: o[5] - left else: len
        val sat = o[3] == 1
        while i < stop:
            val t = o[8 + left + i] + full - cut[i]
            if sat:
                o[8 + left + i] = if t > 255: 255 else: t
            else:
                o[8 + left + i] = (t - (t >> 8)) & 255
            i = i + 1

fn _aaa_trap_row(o: [i64], y: i64, ul0: i64, ur0: i64, ll0: i64, lr0: i64, ldy: i64, rdy: i64, full: i64, nrb: bool):
    if y < 0 or y >= o[1] or ul0 > ur0: return
    var ul = ul0
    var ur = ur0
    var ll = ll0
    var lr = lr0
    if ll > lr:
        # approximate intersection of the crossing edges
        var a = ul
        var b = ll
        if a > b:
            a = ll
            b = ul
        var c = ur
        var d = lr
        if c > d:
            c = lr
            d = ur
        if c > a: a = c
        if d < b: b = d
        ll = (a + b) / 2
        lr = ll
    if ul == ur and ll == lr: return
    if ul > ll:
        val t = ul
        ul = ll
        ll = t
    if ur > lr:
        val t = ur
        ur = lr
        lr = t
    val jl = ((ll + 65535) >> 16) << 16
    val jr = (ur >> 16) << 16
    if jl > jr:
        _aaa_trap_row_general(o, y, ul, ur, ll, lr, ldy, rdy, full, nrb)
        return
    if o[2] == 1:
        # Mask plane: every write is a saturating add (blitSingle assigns).
        val mb = 24 + o[0] + (o[0] + 32) * (o[1] + y)
        if ul < jl:
            val ln = (jl - ul + 65535) >> 16
            if ln == 1:
                val a = (((jl - ul + jl - ll) / 2) >> 8) & 255
                val i1 = mb + (ul >> 16)
                if full == 255 and not nrb:
                    o[i1] = a
                else:
                    val t1 = o[i1] + ((a * full) >> 8)
                    o[i1] = if t1 > 255: 255 else: t1
            elif ln == 2:
                val f = jl - 65536 - ul
                val i2 = mb + (ul >> 16)
                val t2 = o[i2] + ((((f >> 11) * (f >> 11) * (ldy >> 11)) >> 8) & 255)
                o[i2] = if t2 > 255: 255 else: t2
                val g = ll - ul - f
                val t3 = o[i2 + 1] + ((full - ((((g >> 11) * (g >> 11) * (ldy >> 11)) >> 8) & 255)) & 255)
                o[i2 + 1] = if t3 > 255: 255 else: t3
            else:
                _aaa_trap_row_general(o, y, ul, jl, ll, jl, ldy, 2147483647, full, nrb)
        if jl < jr:
            var si = mb + (jl >> 16)
            val stop = mb + (jr >> 16)
            while si < stop:
                val st = o[si] + full
                o[si] = if st > 255: 255 else: st
                si = si + 1
        if lr > jr:
            val rn = (lr - jr + 65535) >> 16
            if rn == 1:
                val a = (((ur - jr + lr - jr) / 2) >> 8) & 255
                val i4 = mb + (jr >> 16)
                if full == 255 and not nrb:
                    o[i4] = a
                else:
                    val t4 = o[i4] + ((a * full) >> 8)
                    o[i4] = if t4 > 255: 255 else: t4
            elif rn == 2:
                val f = jr + 65536 - ur
                val i5 = mb + (jr >> 16)
                val t5 = o[i5] + ((full - ((((f >> 11) * (f >> 11) * (rdy >> 11)) >> 8) & 255)) & 255)
                o[i5] = if t5 > 255: 255 else: t5
                val g = lr - ur - f
                val t6 = o[i5 + 1] + ((((g >> 11) * (g >> 11) * (rdy >> 11)) >> 8) & 255)
                o[i5 + 1] = if t6 > 255: 255 else: t6
            else:
                _aaa_trap_row_general(o, y, jr, ur, jr, lr, 2147483647, rdy, full, nrb)
        return
    val real = full == 255 and not nrb
    val w = o[0]
    val rbase = 24 + w + y * (w + 32)
    if ul < jl:
        val len = (jl - ul + 65535) >> 16
