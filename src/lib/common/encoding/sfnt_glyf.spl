            val px3 = (ul >> 16) + 1
            val pa3 = (full - (((((ll - ul - first) >> 11) * ((ll - ul - first) >> 11) * (ldy >> 11)) >> 8) & 255)) & 255
            if real:
                if pa3 != 0 and px3 >= 0 and px3 < w:
                    val pi3 = rbase + px3
                    if pa3 == 255:
                        o[pi3] = 255
                    else:
                        o[pi3] = pa3 + (((((255 - pa3) * o[pi3]) + 128) * 257) >> 16)
            else:
                if px3 >= o[4] and px3 < o[5]:
                    val pt3 = o[8 + px3] + pa3
                    o[8 + px3] = if pt3 > 255: 255 else: pt3
        else:
            _aaa_trap_row_general(o, y, ul, jl, ll, jl, ldy, 2147483647, full, nrb)
    if jl < jr:
        # blitFull: whole pixels of strip alpha `full`.
        val sx = jl >> 16
        val sn = (jr - jl) >> 16
        if real:
            var si = rbase + sx
            val stop = si + sn
            while si < stop:
                o[si] = 255
                si = si + 1
        else:
            if sx >= o[4] and sx + sn <= o[5]:
                var si = 8 + sx
                val stop = si + sn
                while si < stop:
