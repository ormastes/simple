# `_aaa_trap_row` for the gray phase record/replay route only: SafeRLE,
# non-convex (saturating accumulate), no mask plane; the row check is made
# once per call. Derived line for line from `_aaa_trap_row`: change both.
fn _aaa_trap_row_gray(o: [i64], y: i64, ul0: i64, ur0: i64, ll0: i64, lr0: i64, ldy: i64, rdy: i64, full: i64, nrb: bool):
    if y < 0 or y >= o[1] or ul0 > ur0: return
    var ul = ul0
    var ur = ur0
    var ll = ll0
    var lr = lr0
    if ll > lr:
        # approximate intersection of the crossing edges
        var a = ul
        var b = ll
        if a > b:
            a = ll
            b = ul
        var c = ur
        var d = lr
        if c > d:
            c = lr
            d = ur
        if c > a: a = c
        if d < b: b = d
        ll = (a + b) / 2
        lr = ll
    if ul == ur and ll == lr: return
    if ul > ll:
        val t = ul
        ul = ll
        ll = t
    if ur > lr:
        val t = ur
        ur = lr
        lr = t
