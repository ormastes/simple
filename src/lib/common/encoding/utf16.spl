# UTF-16 Encoding / Decoding
#
# Pure Simple implementation of UTF-16 codec.
# Supports both big-endian (UTF-16BE) and little-endian (UTF-16LE).
#
# UTF-16 encoding:
#   U+0000..U+D7FF, U+E000..U+FFFF  — single 16-bit code unit
#   U+10000..U+10FFFF                — surrogate pair (two 16-bit code units)
#     High surrogate: 0xD800 + ((cp - 0x10000) >> 10)
#     Low surrogate:  0xDC00 + ((cp - 0x10000) & 0x3FF)

use std.common.encoding.utf8.{utf8_decode_all}

# ============================================================================
# UTF-16 encode codepoint
# ============================================================================

fn utf16_encode_one(codepoint: i64) -> [i64]:
    """Encode a Unicode codepoint to UTF-16 code units (16-bit values).
    Returns 1 or 2 code units. Returns [0xFFFD] for invalid."""
    if codepoint < 0 or codepoint > 0x10FFFF:
        return [0xFFFD]
    if codepoint >= 0xD800 and codepoint <= 0xDFFF:
        return [0xFFFD]  # surrogates

    if codepoint < 0x10000:
        return [codepoint]

    # Surrogate pair
    val adjusted = codepoint - 0x10000
    val high = 0xD800 + (adjusted >> 10)
    val low = 0xDC00 + (adjusted & 0x3FF)
    [high, low]

# ============================================================================
# UTF-16 decode
# ============================================================================

fn utf16_decode_one(units: [i64], offset: i64) -> [i64]:
    """Decode one codepoint from UTF-16 code units starting at offset.
    Returns [codepoint, units_consumed]."""
    if offset < 0 or offset >= units.len():
        return [-1, 0]

    val raw0 = units[offset]
    if raw0 < 0 or raw0 > 0xFFFF:
        return [0xFFFD, 1]
    val u0 = raw0

    # Check for high surrogate
    if u0 >= 0xD800 and u0 <= 0xDBFF:
        if offset + 1 >= units.len():
            return [0xFFFD, 1]  # lone high surrogate
        val raw1 = units[offset + 1]
        if raw1 < 0 or raw1 > 0xFFFF:
            return [0xFFFD, 1]
        val u1 = raw1
        if u1 < 0xDC00 or u1 > 0xDFFF:
            return [0xFFFD, 1]  # invalid low surrogate
        val cp = 0x10000 + ((u0 - 0xD800) << 10) + (u1 - 0xDC00)
        return [cp, 2]

    # Lone low surrogate
    if u0 >= 0xDC00 and u0 <= 0xDFFF:
        return [0xFFFD, 1]

    [u0, 1]

# ============================================================================
# Bulk encode / decode
# ============================================================================

fn utf16_encode_all(codepoints: [i64]) -> [i64]:
    """Encode array of codepoints to UTF-16 code units."""
    var result: [i64] = []
    var i: i64 = 0
    while i < codepoints.len():
        val encoded = utf16_encode_one(codepoints[i])
        var j: i64 = 0
        while j < encoded.len():
            result.push(encoded[j])
            j = j + 1
        i = i + 1
    result

fn utf16_decode_all(units: [i64]) -> [i64]:
    """Decode UTF-16 code units to array of codepoints."""
    var result: [i64] = []
    var i: i64 = 0
    while i < units.len():
        val decoded = utf16_decode_one(units, i)
        result.push(decoded[0])
        # i is in bounds, so utf16_decode_one always consumes one valid/replaced
        # unit or two units for a valid surrogate pair.
        i = i + decoded[1]
    result

# ============================================================================
# UTF-16 to/from bytes (with endianness)
# ============================================================================

fn utf16_to_bytes_le(units: [i64]) -> [i64]:
    """Convert UTF-16 code units to little-endian byte array."""
    var result: [i64] = []
    var i: i64 = 0
    while i < units.len():
        val raw = units[i]
        val u = if raw < 0 or raw > 0xFFFF: 0xFFFD else: raw
        result.push(u & 0xFF)
        result.push((u >> 8) & 0xFF)
        i = i + 1
    result

fn utf16_to_bytes_be(units: [i64]) -> [i64]:
    """Convert UTF-16 code units to big-endian byte array."""
    var result: [i64] = []
    var i: i64 = 0
    while i < units.len():
        val raw = units[i]
        val u = if raw < 0 or raw > 0xFFFF: 0xFFFD else: raw
        result.push((u >> 8) & 0xFF)
        result.push(u & 0xFF)
        i = i + 1
    result

fn utf16_from_bytes_le(bytes: [i64]) -> [i64]:
    """Convert little-endian byte array to UTF-16 code units."""
    var result: [i64] = []
    var i: i64 = 0
    while i + 1 < bytes.len():
        val b0 = bytes[i]
        val b1 = bytes[i + 1]
        if b0 < 0 or b0 > 255 or b1 < 0 or b1 > 255:
            result.push(0xFFFD)
            i = i + 2
            continue
        val u = b0 | (b1 << 8)
        result.push(u)
        i = i + 2
    if i < bytes.len():
        result.push(0xFFFD)
    result

fn utf16_from_bytes_be(bytes: [i64]) -> [i64]:
    """Convert big-endian byte array to UTF-16 code units."""
    var result: [i64] = []
    var i: i64 = 0
    while i + 1 < bytes.len():
        val b0 = bytes[i]
        val b1 = bytes[i + 1]
        if b0 < 0 or b0 > 255 or b1 < 0 or b1 > 255:
            result.push(0xFFFD)
            i = i + 2
            continue
        val u = (b0 << 8) | b1
        result.push(u)
        i = i + 2
    if i < bytes.len():
        result.push(0xFFFD)
    result

# ============================================================================
# Cross-codec: UTF-16 <-> UTF-8
# ============================================================================

fn utf16_to_utf8(units: [i64]) -> [i64]:
    """Convert UTF-16 code units to UTF-8 byte array."""
    # Single pass: decode and encode without materializing a code-point array,
    # and without the per-code-unit [codepoint, consumed] array that calling
    # utf16_decode_one would allocate. The decode branches below mirror
    # utf16_decode_one exactly; utf16_decode_all stays the differential oracle.
    var result: [i64] = []
    val n = units.len()
    var i: i64 = 0
    while i < n:
        val raw0 = units[i]
        var codepoint: i64 = 0xFFFD
        var consumed: i64 = 1
        if raw0 >= 0 and raw0 <= 0xFFFF:
            if raw0 >= 0xD800 and raw0 <= 0xDBFF:
                # High surrogate: pair it only with a well-formed low surrogate.
                if i + 1 < n:
                    val raw1 = units[i + 1]
                    if raw1 >= 0xDC00 and raw1 <= 0xDFFF:
                        codepoint = 0x10000 + ((raw0 - 0xD800) << 10) + (raw1 - 0xDC00)
                        consumed = 2
            elif raw0 < 0xDC00 or raw0 > 0xDFFF:
                # Not a surrogate at all; lone low surrogates stay U+FFFD.
                codepoint = raw0
        # `codepoint` is always a valid scalar here (BMP non-surrogate, U+FFFD,
        # or a decoded pair), so these branches are utf8_encode_one's valid arms
        # written out — appending straight into `result` instead of allocating a
        # 1..4-element array per code point.
        if codepoint < 0x80:
            result.push(codepoint)
        elif codepoint < 0x800:
            result.push(0xC0 | (codepoint >> 6))
            result.push(0x80 | (codepoint & 0x3F))
        elif codepoint < 0x10000:
            result.push(0xE0 | (codepoint >> 12))
            result.push(0x80 | ((codepoint >> 6) & 0x3F))
            result.push(0x80 | (codepoint & 0x3F))
        else:
            result.push(0xF0 | (codepoint >> 18))
            result.push(0x80 | ((codepoint >> 12) & 0x3F))
            result.push(0x80 | ((codepoint >> 6) & 0x3F))
            result.push(0x80 | (codepoint & 0x3F))
        i = i + consumed
    result

fn utf8_to_utf16(bytes: [i64]) -> [i64]:
    """Convert UTF-8 byte array to UTF-16 code units."""
    val codepoints = utf8_decode_all(bytes)
    utf16_encode_all(codepoints)
