# Pure-Simple `kern` table reader (round 13, 2026-09-14).
#
# WHY THIS EXISTS
#
# The unmanaged / selected-blob text lane measures runs from the face's own
# `hmtx` advances (`sfnt_glyph_advance_into`). It applied NO kerning at all:
# `FontRenderer.horizontal_kern` answers a foreign `rt_fonts_horizontal_kern`
# address, which only the SFFI-dylib lane owns, so on the macOS system faces it
# returned 0 for every pair. Chrome kerns by default (`font-kerning: auto` is
# `normal` for horizontal text), so every run containing a kerned pair measured
# WIDER in Simple than in Chrome.
#
# WHICH FORMAT, MEASURED NOT ASSUMED
#
# Probed on this host's `/System/Library/Fonts/Helvetica.ttc`, face 0, repacked
# by `sfnt_ttc_extract_face` (which copies every table verbatim, `kern`
# included):
#
#   kern table: offset 369224, length 656
#   header:     version 0x00010000, nTables 1          <- APPLE (32-bit) header
#   subtable 0: length 648, coverage 0x0000            <- horizontal, format 0
#   format 0:   nPairs 105, then 105 x (left u16, right u16, value i16)
#
# Helvetica ships NO `GPOS`, so `kern` is the whole story for it and PairPos is
# not needed to kern this face. Both header shapes are read here anyway, because
# the two are trivially distinguished and a Windows-built face on another host
# would otherwise silently fall back to zero:
#
#   version 0x0000 (u16)      -> MS:    u16 version, u16 nTables; subtable
#                                       header u16 version, u16 length,
#                                       u16 coverage (format in the HIGH byte)
#   version 0x00010000 (u32)  -> Apple: u32 version, u32 nTables; subtable
#                                       header u32 length, u16 coverage
#                                       (format in the LOW byte), u16 tupleIndex
#
# Only horizontal, non-cross-stream, non-variation format-0 subtables are
# applied. Anything else (format 1/2/3, vertical, cross-stream, a variation
# tuple) is SKIPPED rather than guessed at, so an unsupported subtable answers
# the honest 0 this lane already answered instead of a wrong number.
#
# Values accumulate across subtables, which is what both specs say: a face may
# split its pairs over several tables and the applied kern is their sum.

use std.common.encoding.sfnt.{read_u16_be, read_i16_be, read_u32_be, parse_offset_table, find_table}

# 'kern', 'head' as big-endian u32 tags.
val SFNT_KERN_TAG: u32 = 0x6B65726Eu32
val SFNT_KERN_HEAD_TAG: u32 = 0x68656164u32

# Every `kern` subtable this reader understands, as a flat triple list:
# [subtable_pairs_offset, n_pairs, _reserved] per entry. Flat i64 lists rather
# than a struct array: this is read once per (face, pair) on a hot measuring
# path and the flat form avoids an aggregate copy per lookup.
fn _kern_format0_ranges(blob: [u8], table_offset: i64, table_length: i64) -> [i64]:
    var out: [i64] = []
    if table_offset < 0 or table_length < 4: return out
    if table_offset + table_length > blob.len(): return out
    val version32 = read_u32_be(blob, table_offset) as i64
    var apple = false
    var n_tables: i64 = 0
    var cursor: i64 = 0
    if version32 == 65536:
        apple = true
        if table_length < 8: return out
        n_tables = read_u32_be(blob, table_offset + 4) as i64
        cursor = table_offset + 8
    else:
        if (read_u16_be(blob, table_offset) as i64) != 0: return out
        n_tables = read_u16_be(blob, table_offset + 2) as i64
        cursor = table_offset + 4
    # A face declaring an absurd subtable count is malformed, not a reason to
    # scan the rest of the font: bound it before the walk.
    if n_tables <= 0 or n_tables > 64: return out
    val table_end = table_offset + table_length
    var i: i64 = 0
    while i < n_tables:
        if cursor + 6 > table_end: return out
        var sub_length: i64 = 0
        var coverage: i64 = 0
        var data_at: i64 = 0
        if apple:
            if cursor + 8 > table_end: return out
            sub_length = read_u32_be(blob, cursor) as i64
            coverage = read_u16_be(blob, cursor + 4) as i64
            # tupleIndex at cursor + 6; a variation tuple is not applied.
            data_at = cursor + 8
        else:
            sub_length = read_u16_be(blob, cursor + 2) as i64
            coverage = read_u16_be(blob, cursor + 4) as i64
            data_at = cursor + 6
        if sub_length < 6 or cursor + sub_length > table_end: return out
        var format: i64 = 0
        var horizontal = false
        var cross_stream = false
        var variation = false
        if apple:
            format = coverage & 255
            # Apple coverage: bit 15 vertical, bit 14 cross-stream, bit 13 variation.
            horizontal = (coverage & 32768) == 0
            cross_stream = (coverage & 16384) != 0
            variation = (coverage & 8192) != 0
        else:
            format = (coverage >> 8) & 255
            # MS coverage: bit 0 horizontal, bit 2 cross-stream.
            horizontal = (coverage & 1) != 0
            cross_stream = (coverage & 4) != 0
            variation = false
        if format == 0 and horizontal and not cross_stream and not variation:
            if data_at + 2 <= table_end:
                val n_pairs = read_u16_be(blob, data_at) as i64
                val pairs_at = data_at + 8
                if n_pairs > 0 and pairs_at + n_pairs * 6 <= table_end:
                    out.push(pairs_at)
                    out.push(n_pairs)
                    out.push(0)
        cursor = cursor + sub_length
        i = i + 1
    out

# Binary search one format-0 pair list. The spec REQUIRES the pairs to be sorted
# by the 32-bit key `(left << 16) | right`, and Helvetica's searchRange /
# entrySelector / rangeShift header exists precisely so a reader can binary
# search; a linear scan here would cost 105 reads per pair on every character.
fn _kern_lookup_range(blob: [u8], pairs_at: i64, n_pairs: i64, key: i64) -> i64:
    var lo: i64 = 0
    var hi: i64 = n_pairs - 1
    while lo <= hi:
        val mid = (lo + hi) / 2
        val at = pairs_at + mid * 6
        val mid_key = ((read_u16_be(blob, at) as i64) << 16) | (read_u16_be(blob, at + 2) as i64)
        if mid_key == key:
            return read_i16_be(blob, at + 4) as i64
        if mid_key < key:
            lo = mid + 1
        else:
            hi = mid - 1
    0

# Kerning for one ordered glyph pair, in FONT DESIGN UNITS. 0 when the face has
# no `kern` table, no format-0 horizontal subtable, or no entry for the pair --
# all three are "no kerning", which is the correct answer, not an error.
pub fn sfnt_blob_kern_pair_units(blob: [u8], left_glyph_id: i64, right_glyph_id: i64) -> i64:
    if left_glyph_id <= 0 or right_glyph_id <= 0: return 0
    if left_glyph_id > 65535 or right_glyph_id > 65535: return 0
    val font_opt = parse_offset_table(blob)
    if val Some(font) = font_opt:
        val table_opt = find_table(font, SFNT_KERN_TAG)
        if val Some(table) = table_opt:
            val ranges = _kern_format0_ranges(blob, table.offset as i64, table.length as i64)
            if ranges.len() == 0: return 0
            val key = (left_glyph_id << 16) | right_glyph_id
            var total: i64 = 0
            var i: i64 = 0
            while i + 2 < ranges.len():
                total = total + _kern_lookup_range(blob, ranges[i], ranges[i + 1], key)
                i = i + 3
            return total
    0

# Units per em, from `head`. 0 when the face has no usable `head`, which the
# callers treat as "cannot scale, so no kerning".
pub fn sfnt_units_per_em(blob: [u8]) -> i64:
    val font_opt = parse_offset_table(blob)
    if val Some(font) = font_opt:
        val head_opt = find_table(font, SFNT_KERN_HEAD_TAG)
        if val Some(head) = head_opt:
            val at = (head.offset as i64) + 18
            if at + 2 <= blob.len():
                val upem = read_u16_be(blob, at) as i64
                if upem >= 16 and upem <= 16384:
                    return upem
    0

# Kerning for one ordered glyph pair, in MILLI-PIXELS at `size_px`.
#
# Milli-pixels, not pixels, and deliberately: round 12 made the run pen a
# milli-pixel cumulative so that a run's width is `round(sum of exact)` rather
# than `sum of round(exact)`. A kern rounded to a whole pixel HERE would
# reintroduce exactly the per-item rounding that change removed -- Helvetica's
# "AV" pair is -80/2048 em = -0.625 px at 16, which rounds to -1 on its own but
# must contribute -0.625 to the cumulative. The rounding stays at the single
# boundary-difference step in `measure_text_advances`.
pub fn sfnt_blob_kern_pair_milli_px(blob: [u8], left_glyph_id: i64, right_glyph_id: i64, size_px: i64) -> i64:
    if size_px <= 0 or size_px > 512: return 0
    val units = sfnt_blob_kern_pair_units(blob, left_glyph_id, right_glyph_id)
    if units == 0: return 0
    val upem = sfnt_units_per_em(blob)
    if upem <= 0: return 0
    # Symmetric rounding about zero: kern values are predominantly negative and
    # a floor-toward-negative-infinity division would bias every pair one
    # milli-pixel tighter than its mirror.
    val scaled = units * size_px * 1000
    if scaled >= 0:
        (scaled + upem / 2) / upem
    else:
        -((-scaled + upem / 2) / upem)

val SFNT_HHEA_TAG: u32 = 0x68686561u32
val SFNT_OS2_TAG: u32 = 0x4F532F32u32

fn _sfnt_round_scaled_units(units: i64, size_px: i64, upem: i64) -> i64:
    (units * size_px + upem / 2) / upem

# The face's line metrics in font units: [ascent, descent, line_gap, upem],
# descent and gap non-negative, or [] when the blob has no usable tables
# (truncated or malformed blob, a TrueType COLLECTION header, no `hhea`).
# The table directory is parsed ONCE per call; callers memoise the result.
#
# Source, as Chrome does it on Linux (Skia over FreeType): the `OS/2` typo
# metrics when `fsSelection` bit 7 (USE_TYPO_METRICS) is set, else `hhea`.
# Measured, Chrome 159.0.8154.6, one-line block height at 16/32/64px:
#   Pagul            typo 1548/444/205  hhea 1850/444/62   -> 17/34/68
#   Lohit Devanagari typo  999/365/0    hhea 1121/515/266  -> 22/42/85
#   Laksaman         typo 1279/376/60   hhea 1270/687/30   -> 27/55/110
#   Gargi            typo 1638/410/0    hhea 1032/571/119  -> 32/64/128
# Every one is the typo prediction; the hhea ones are 17/37/74, 30/59/119,
# 31/64/127 and 27/54/108.
pub fn sfnt_blob_line_metric_units(blob: [u8]) -> [i64]:
    val font_opt = parse_offset_table(blob)
    if val Some(font) = font_opt:
        var upem: i64 = 0
        var ascent: i64 = 0
        var descent: i64 = 0
        var gap: i64 = 0
        val head_opt = find_table(font, SFNT_KERN_HEAD_TAG)
        if val Some(head) = head_opt:
            val head_at = (head.offset as i64) + 18
            if (head.length as i64) >= 20 and head_at + 2 <= blob.len():
                upem = read_u16_be(blob, head_at) as i64
        if upem < 16 or upem > 16384:
            return []
        val hhea_opt = find_table(font, SFNT_HHEA_TAG)
        if val Some(hhea) = hhea_opt:
            val hhea_at = hhea.offset as i64
            if (hhea.length as i64) >= 10 and hhea_at + 10 <= blob.len():
                ascent = read_i16_be(blob, hhea_at + 4) as i64
                descent = 0 - (read_i16_be(blob, hhea_at + 6) as i64)
                gap = read_i16_be(blob, hhea_at + 8) as i64
        val os2_opt = find_table(font, SFNT_OS2_TAG)
        if val Some(os2) = os2_opt:
            val os2_at = os2.offset as i64
            if (os2.length as i64) >= 74 and os2_at + 74 <= blob.len():
                # Bit 7 is defined from OS/2 version 4; in an older table it is
                # reserved and must not be read as USE_TYPO_METRICS. A face
                # that sets it with a non-positive typo ascent keeps `hhea`.
                val os2_version = read_u16_be(blob, os2_at) as i64
                val fs_selection = read_u16_be(blob, os2_at + 62) as i64
                val typo_ascent = read_i16_be(blob, os2_at + 68) as i64
                if os2_version >= 4 and (fs_selection / 128) % 2 == 1 and typo_ascent > 0:
                    ascent = typo_ascent
                    descent = 0 - (read_i16_be(blob, os2_at + 70) as i64)
                    gap = read_i16_be(blob, os2_at + 72) as i64
        if ascent <= 0:
            return []
        if descent < 0:
            descent = 0 - descent
        if gap < 0:
            gap = 0
        return [ascent, descent, gap, upem]
    []

# The used value of `line-height: normal`, in whole pixels, from
# `sfnt_blob_line_metric_units`, or 0 for an empty/invalid units row.
#
# Chrome's rule: ascent, descent and line gap are scaled and rounded EACH ON
# ITS OWN, then summed. Measured against Chrome 159.0.8154.6 on Linux (height
# of a one-line block):
#
#   face (upem 2048)              asc/desc/gap    12  13  16  24  32
#   Liberation Sans               1854/434/67     14  15  18  28  37
#   Liberation Serif              1825/443/87     15  16  18  27  37
#   Liberation Mono               1705/615/0      14  15  18  27  37
#   DejaVu Sans Mono              1901/483/0      14  15  19  28  38
#
# Rounding the SUM instead gives Liberation Serif 13.8 -> 14 at 12px against
# Chrome's 15, so the per-part rounding is what the table pins.
pub fn sfnt_line_metric_units_normal_line_height_px(units: [i64], size_px: i64) -> i64:
    if units.len() != 4 or size_px <= 0 or size_px > 512: return 0
    val upem = units[3]
    if upem <= 0: return 0
    (
        _sfnt_round_scaled_units(units[0], size_px, upem) +
        _sfnt_round_scaled_units(units[1], size_px, upem) +
        _sfnt_round_scaled_units(units[2], size_px, upem)
    )

pub fn sfnt_blob_normal_line_height_px(blob: [u8], size_px: i64) -> i64:
    sfnt_line_metric_units_normal_line_height_px(sfnt_blob_line_metric_units(blob), size_px)
