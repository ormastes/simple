# Base58 and Base58Check encoding/decoding.
#
# Implements the Bitcoin BIP-0058 Base58Check encoding used in
# cryptocurrency addresses and keys (BIP-32, BIP-44, etc.).
#
# Base58 alphabet (58 chars): 123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz
# Excluded: 0 (zero), O (capital o), I (capital i), l (lowercase L).
#
# Usage:
#   use std.common.encoding.base58.{base58_encode, base58_decode,
#       base58check_encode, base58check_decode, Base58Error}
#   val encoded = base58_encode(bytes)
#   val r = base58check_decode(address_text)
#
# References:
#   https://en.bitcoin.it/wiki/Base58Check_encoding
#   BIP-0058, BIP-0032
#
use std.crypto.sha256.{sha256_bytes}
use std.common.encoding.utf8.{char_from_code}

# ============================================================================
# Public types
# ============================================================================

enum Base58Error:
    """Error variants for base58 decoding operations."""
    InvalidChar
    InvalidChecksum
    TooShort

# ============================================================================
# Internal helpers — alphabet
# ============================================================================

fn _b58_alphabet_ord(pos: i64) -> i64:
    """Return the ASCII ordinal of alphabet[pos] (0..57).
    reason: positional base58 alphabet lookup"""
    # Alphabet: 123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz
    # Stored as a table of ordinals to avoid text indexing complexity.
    val a = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    a[pos].ord()

fn _b58_alpha_index_ord(char_ord: i64) -> i64:
    """Return base58 alphabet index of character with ASCII value char_ord,
    or -1 if not in alphabet.
    reason: positional base58 alphabet decode"""
    # Digit chars: '1'=49 .. '9'=57 → index 0..8
    if char_ord >= 49 and char_ord <= 57:
        return char_ord - 49
    # Uppercase: A=65..Z=90, skip I(73) and O(79)
    # A-H (65..72) → indices 9..16
    if char_ord >= 65 and char_ord <= 72:
        return 9 + (char_ord - 65)
    # J-N (74..78) → indices 17..21
    if char_ord >= 74 and char_ord <= 78:
        return 17 + (char_ord - 74)
    # P-Z (80..90) → indices 22..32
    if char_ord >= 80 and char_ord <= 90:
        return 22 + (char_ord - 80)
    # Lowercase: a=97..z=122, skip l(108)
    # a-k (97..107) → indices 33..43
    if char_ord >= 97 and char_ord <= 107:
        return 33 + (char_ord - 97)
    # m-z (109..122) → indices 44..57
    if char_ord >= 109 and char_ord <= 122:
        return 44 + (char_ord - 109)
    -1

fn _b58_list_all_zero(lst: [i64]) -> bool:
    """Return true if all elements in list are zero.
    reason: positional base58 encode all-digits-consumed check"""
    # `lst: [i64]`, not the untyped `list` type -- a `list`-typed function
    # PARAMETER is a third, independently-proven trigger for the campaign's
    # `<<3` tag-box miscompile (see
    # doc/08_tracking/bug/sha256_bytes_engine_divergence_rootcause_2026-07-29.md):
    # under the default engine, reading `lst[i]` inside a callee whose
    # parameter is declared `list` applies a spurious left-shift-by-3
    # BEFORE this function even runs, for EVERY caller shape tested
    # (a genuine untyped `list` argument built via `.push()`, and a typed
    # `[i64]` argument alike) -- e.g. element value 32 reads back as
    # `(32<<3)&0xFF == 0`. That silently made this exact function return
    # `true` ("all zero") for `[32]`, so `base58_encode([32])` returned ""
    # instead of "Z" -- a real, previously-undetected, silent-corruption
    # security bug (confirmed against an independent python3 base58
    # encoder), not hypothetical. Typing the parameter concretely as
    # `[i64]` (matching every real caller) avoids the trigger entirely
    # (proved safe in isolation for the `[i64]`-typed-parameter shape).
    var i = 0
    while i < lst.len():
        if (lst[i] & 0xFF) != 0:
            return false
        i = i + 1
    true

fn _b58_u8arr_to_list(bytes: [u8]) -> [i64]:
    """Convert [u8] to an [i64] byte-value array for sha256_bytes.
    reason: positional base58 sha256 bridge"""
    # Was `-> list` (untyped). Retyped to `[i64]` for the same reason as
    # `_b58_list_all_zero` above -- eliminates the untyped `list` type from
    # this file entirely rather than relying on any one crossing direction
    # happening to test safe.
    var l: [i64] = []
    var i = 0
    while i < bytes.len():
        l.push(bytes[i].to_i64() & 0xFF)
        i = i + 1
    l

fn _b58_list_get_byte(l: [i64], i: i64) -> i64:
    """Get element i from an [i64] byte array as an i64 byte value.
    reason: positional base58check checksum byte extraction"""
    # Was `l: list` (untyped). This was the exact site of the pass-8
    # sha256/base58check engine divergence: `_b58_double_sha256_first4`
    # calls this with `h2` (sha256_bytes's `[i64]` return value); reading
    # `l[i]` here under a `list`-typed parameter applied the same spurious
    # `<<3` shift under the default engine, giving a WRONG checksum (and
    # thus a wrong Base58Check address) while the interpreter was correct
    # -- see the root-cause doc referenced above. `[i64]` matches the only
    # real argument type and avoids the trigger.
    l[i] & 0xFF

# ============================================================================
# Base58 encode
# ============================================================================

fn base58_encode(input: [u8]) -> text:
    """Encode a byte array as a base58 string.
    Leading zero bytes map to leading '1' characters.
    reason: positional base58 encode"""
    val n = input.len()

    if n == 0:
        return ""

    # Count leading zero bytes
    var lzb = 0
    var i = 0
    var counting = true
    while counting and i < n:
        if (input[i].to_i64() & 0xFF) == 0:
            lzb = lzb + 1
            i = i + 1
        else:
            counting = false

    # Copy input to an [i64] array for in-place indexed assignment (was an
    # untyped `list` -- retyped to match `_b58_list_all_zero`'s now-`[i64]`
    # parameter; see that function's docstring for why).
    var work: [i64] = []
    var j = 0
    while j < n:
        work.push(input[j].to_i64() & 0xFF)
        j = j + 1

    # Collect base58 digits (LSB first) by repeated divmod-58 on byte array.
    # One pass: walk MSB→LSB with carry = (carry*256 + byte[k]) divmod 58;
    # quotient replaces byte[k], remainder is the next carry.
    var digits = []
    var all_done = false
    while not all_done:
        if _b58_list_all_zero(work):
            all_done = true
        else:
            var carry: i64 = 0
            var k = 0
            while k < work.len():
                val x = carry * 256 + (work[k] & 0xFF)
                work[k] = x / 58
                carry = x % 58
                k = k + 1
            digits.push(carry)

    # Build result: leading '1's for zero bytes, then digits MSB-first
    var result = ""
    var z = 0
    while z < lzb:
        result = result + "1"
        z = z + 1

    # Append digits in reverse (they were collected LSB-first)
    var d = digits.len() - 1
    while d >= 0:
        val alpha_ord = _b58_alphabet_ord(digits[d])
        # char_from_code, not `.chr()` -- `.chr()` is implemented only in
        # the tree-walking interpreter's method dispatch
        # (interpreter_method/primitives.rs), not in the JIT/native
        # codegen path, so it crashes ("Function 'i64.chr' not found")
        # under this engine's DEFAULT execution mode and only works when
        # SIMPLE_EXECUTION_MODE=interpret is forced (verified directly:
        # identical `65.chr()` fails under the default engine, succeeds
        # under forced interpret). Not a receiver-typing/erased-receiver
        # issue -- confirmed by testing an i64 literal, a typed local, a
        # function-result local, and a direct call-site receiver, all four
        # shapes fail identically under the default engine and all four
        # succeed identically under forced interpret. char_from_code is
        # documented as "byte value (0-255) to a single-byte text
        # character" (not a general Unicode codepoint converter -- it
        # returns U+FFFD for 128-255), but base58's alphabet is entirely
        # ASCII 49-122 (digits/letters), well within char_from_code's
        # correct range -- verified directly for the alphabet's own
        # endpoints (49='1', 122='z').
        result = result + char_from_code(alpha_ord)
        d = d - 1

    result

# ============================================================================
# Base58 decode
# ============================================================================

fn base58_decode(input: text) -> Result<[u8], Base58Error>:
    """Decode a base58-encoded string to a byte array.
    Returns Err(InvalidChar) if any character is not in the alphabet.
    reason: positional base58 decode"""
    val n = input.length()

    if n == 0:
        return Ok([])

    # Count leading '1' characters (ordinal 49)
    var lz1: i64 = 0
    var i: i64 = 0
    var counting_ones = true
    while counting_ones and i < n:
        if input[i].ord() == 49:
            lz1 = lz1 + 1
            i = i + 1
        else:
            counting_ones = false

    # Validate remaining chars and build index array
    var indices = []
    var k: i64 = lz1
    while k < n:
        val char_ord = input[k].ord()
        val idx = _b58_alpha_index_ord(char_ord)
        if idx == -1:
            return Err(Base58Error.InvalidChar)
        indices.push(idx)
        k = k + 1

    # Build big-endian byte buffer from base58 digits.
    # For each digit: multiply entire work buffer by 58 and add digit.
    # work is an untyped list; each element is 0..255.
    #
    # Stored LSB-first (work[0] = least-significant byte). Two distinct
    # default-engine (JIT/native codegen) miscompiles were root-caused here
    # (both dodged by this rewrite; interpreter is unaffected by either --
    # see doc/08_tracking/bug/base58_decode_reversed_polarity_rootcause_2026-07-29.md
    # for the full 20-variant shrink):
    #
    # 1. A `var` first assigned an EMPTY list literal (`var work = []`) gets
    #    a representation locked in at that first assignment; if the SAME
    #    variable is later reassigned wholesale to a different, non-empty
    #    list object (the original MSB-first version of this code did
    #    exactly that to prepend a new leading byte: `work = new_work`),
    #    every subsequent bracket-index read through `work` silently
    #    applies a spurious `<<3` shift (digit 5 reads back as 40; 57 as
    #    (57<<3) mod 256 = 200). Avoided: `work` is never reassigned to a
    #    different list object anywhere below, only appended/index-written.
    #
    # 2. Independently, growing a list via `.push()` (triggering a backing-
    #    store reallocation) in one iteration of an enclosing `while` loop,
    #    then index-reading/writing that SAME list in a LATER iteration of
    #    that loop, reads back garbage (not simply mis-shifted -- a stale
    #    base-pointer/spill-slot artifact; e.g. two digit=57 passes through
    #    the per-digit loop gave [137,103] instead of [35,13]). This is the
    #    coordinator-named "loop-carried variable spill/clobber" / native
    #    tuple-spill family. Avoided below by pre-sizing `work` to a safe
    #    upper bound BEFORE the per-digit loop starts (via a separate, non-
    #    loop-carried pure-push pre-loop -- proven safe in isolation), so
    #    the per-digit loop performs ONLY in-place index reads/writes and
    #    never calls `.push()` -- no reallocation ever happens while the
    #    per-digit loop is live.
    #
    # Upper bound: n base58 digits represent a value < 58^n, needing at most
    # ceil(n * log2(58)/8) ~= ceil(n*0.733) bytes in base 256 -- `n + 1`
    # bytes is always comfortably sufficient. Unused high-order (most
    # significant) slots stay 0 and are trimmed when emitting the result.
    var work = []
    var pre = 0
    val max_bytes = indices.len() + 1
    while pre < max_bytes:
        work.push(0)
        pre = pre + 1

    var di = 0
    while di < indices.len():
        val digit = indices[di]
        # Multiply by 58 and add digit (carry propagates LSB->MSB, i.e.
        # increasing index, since work is stored LSB-first here). `work` is
        # already fully pre-sized to max_bytes, so this loop only ever
        # index-reads/writes -- it never calls `.push()`.
        var carry: i64 = digit
        var wi: i64 = 0
        while wi < work.len():
            val x = work[wi] * 58 + carry
            work[wi] = x & 0xFF
            carry = x / 256
            wi = wi + 1
        di = di + 1

    # Find the highest used (nonzero, or within the pre-sized range) byte:
    # trim unused high-order pre-allocated zero slots that real carry
    # propagation never reached.
    var used_len = work.len()
    while used_len > 0 and (work[used_len - 1] & 0xFF) == 0:
        used_len = used_len - 1

    # Build result: lz1 zero bytes + work bytes emitted MSB-first (work is
    # stored LSB-first, so walk it backwards down to used_len).
    var result: [u8] = []
    var z = 0
    while z < lz1:
        result.push(0)
        z = z + 1
    var wi2 = used_len - 1
    while wi2 >= 0:
        val wv: i64 = work[wi2]
        result.push(wv.to_u8())
        wi2 = wi2 - 1

    Ok(result)

# ============================================================================
# SHA-256 bridge (for base58check)
# ============================================================================

fn _b58_double_sha256_first4(data: [u8]) -> [u8]:
    """Compute SHA-256(SHA-256(data)) and return first 4 bytes.
    reason: positional base58check checksum"""
    val l1 = _b58_u8arr_to_list(data)
    val h1 = sha256_bytes(l1)
    val h2 = sha256_bytes(h1)
    var result: [u8] = []
    result.push(_b58_list_get_byte(h2, 0))
    result.push(_b58_list_get_byte(h2, 1))
    result.push(_b58_list_get_byte(h2, 2))
    result.push(_b58_list_get_byte(h2, 3))
    result

# ============================================================================
# Base58Check encode/decode
# ============================================================================

fn base58check_encode(payload: [u8], version: i64) -> text:
    """Encode payload with version byte using Base58Check.
    prefix = [version] || payload; appends 4-byte double-SHA256 checksum.
    reason: positional base58check encode"""
    # Build prefix = [version_byte] || payload
    var prefix: [u8] = []
    prefix.push(version & 0xFF)
    var i = 0
    while i < payload.len():
        prefix.push(payload[i])
        i = i + 1

    # Compute checksum: first 4 bytes of SHA256(SHA256(prefix))
    val checksum = _b58_double_sha256_first4(prefix)

    # Build full = prefix || checksum
    var full: [u8] = []
    var j = 0
    while j < prefix.len():
        full.push(prefix[j])
        j = j + 1
    var kk = 0
    while kk < checksum.len():
        full.push(checksum[kk])
        kk = kk + 1

    base58_encode(full)

fn base58check_decode(input: text) -> Result<(i64, [u8]), Base58Error>:
    """Decode a Base58Check string into (version, payload).
    Returns Err(TooShort) if fewer than 5 bytes, Err(InvalidChecksum) on mismatch.
    reason: positional base58check decode"""
    val r = base58_decode(input)
    # Avoid `match`-with-`return` arm (the interpreter doesn't propagate a
    # `return` from inside a match-expression, leaving `bytes` bound to the
    # whole Result and crashing on `.len()`). Branch explicitly instead.
    if not r.is_ok():
        return Err(r.unwrap_err())
    val bytes = r.unwrap()
    if bytes.len() < 5:
        return Err(Base58Error.TooShort)

    val total = bytes.len()
    val prefix_len = total - 4

    # Extract prefix and expected checksum
    var prefix: [u8] = []
    var pi = 0
    while pi < prefix_len:
        prefix.push(bytes[pi])
        pi = pi + 1

    var expected_cs: [u8] = []
    var ci = prefix_len
    while ci < total:
        expected_cs.push(bytes[ci])
        ci = ci + 1

    # Compute actual checksum
    val actual_cs = _b58_double_sha256_first4(prefix)

    # Compare all 4 checksum bytes
    if (expected_cs[0].to_i64() & 0xFF) != (actual_cs[0].to_i64() & 0xFF):
        return Err(Base58Error.InvalidChecksum)
    if (expected_cs[1].to_i64() & 0xFF) != (actual_cs[1].to_i64() & 0xFF):
        return Err(Base58Error.InvalidChecksum)
    if (expected_cs[2].to_i64() & 0xFF) != (actual_cs[2].to_i64() & 0xFF):
        return Err(Base58Error.InvalidChecksum)
    if (expected_cs[3].to_i64() & 0xFF) != (actual_cs[3].to_i64() & 0xFF):
        return Err(Base58Error.InvalidChecksum)

    val version = prefix[0].to_i64() & 0xFF
    var payload_out: [u8] = []
    var xi = 1
    while xi < prefix.len():
        payload_out.push(prefix[xi])
        xi = xi + 1

    Ok((version, payload_out))
