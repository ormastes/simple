# Fail-closed comparator for Modern SSpec typed evidence (E0 lane).
#
# Every rule here exists because its absence produces a green result that
# describes nothing:
#
#   - a parse failure that yields an empty node set satisfies any subset oracle
#   - an unresolved selector silently checks nothing
#   - an ambiguous selector checks a different node than the manual claims
#   - a substring pattern passes on a value that merely contains the shape
#   - an ignore without a reason is indistinguishable from "we never looked"
#   - an all-ignore oracle asserts nothing about the production system
#   - an open document absorbs new fields without anyone deciding to
#
# Guide: doc/07_guide/infra/sspec_typed_evidence.md

use std.common.spec.evidence.model.{
    EvidenceSelector, EvidenceSelectorKind, selector_display,
    OracleMode, OracleCheck, OracleSpec, oracle_mode_name,
    EvidenceNode, CanonicalEvidence,
    EvidenceStatus, EvidenceCheckResult, ComparisonResult, check_result,
    evidence_status_name,
    ManualBlock, ManualBlockKind, EvidenceAudience, manual_block, manual_block_for
}

# ---------------------------------------------------------------------------
# Selector resolution
# ---------------------------------------------------------------------------

pub fn resolve_nodes(evidence: CanonicalEvidence, selector: EvidenceSelector) -> [EvidenceNode]:
    var found: [EvidenceNode] = []
    for node in evidence.nodes:
        if node.path == selector.path:
            found.push(node)
    found

fn cardinality_error(selector: EvidenceSelector, count: i64) -> text:
    if count == 0:
        return "selector resolved no node"
    "selector resolved {count} nodes, expected " + "{selector.cardinality}"

# ---------------------------------------------------------------------------
# Anchored pattern classes
# ---------------------------------------------------------------------------

fn is_hex_digit(c: text) -> bool:
    "0123456789abcdefABCDEF".contains(c)

fn is_decimal_digit(c: text) -> bool:
    "0123456789".contains(c)

fn is_alnum(c: text) -> bool:
    if is_decimal_digit(c):
        return true
    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(c)

# Patterns are class tokens ("hex:16", "digit:3", "alnum:*"), never regexes,
# and always match the WHOLE selected scalar. A length of "*" means one or
# more; an explicit count means exactly that many characters, so a value that
# is merely prefixed by the right shape fails.
pub fn pattern_matches(pattern: text, value: text) -> bool:
    val sep = pattern.index_of(":")
    if sep < 0:
        return false
    val class_name = pattern.slice(0, sep)
    val count_text = pattern.slice(sep + 1, pattern.len())
    if value.len() == 0:
        return false
    if count_text != "*":
        val want = count_text.to_i64()
        if value.len() != want:
            return false
    var i = 0
    while i < value.len():
        val c = value.slice(i, i + 1)
        var ok = false
        if class_name == "hex":
            ok = is_hex_digit(c)
        elif class_name == "digit":
            ok = is_decimal_digit(c)
        elif class_name == "alnum":
            ok = is_alnum(c)
        else:
            return false
        if not ok:
            return false
        i = i + 1
    true

# ---------------------------------------------------------------------------
# Multiset / sequence helpers
# ---------------------------------------------------------------------------

fn node_values(nodes: [EvidenceNode]) -> [text]:
    var out: [text] = []
    for node in nodes:
        out.push(node.value)
    out

fn remove_first(items: [text], wanted: text) -> [text]:
    var out: [text] = []
    var removed = false
    for item in items:
        if not removed and item == wanted:
            removed = true
        else:
            out.push(item)
    out

fn contains_value(items: [text], wanted: text) -> bool:
    for item in items:
        if item == wanted:
            return true
    false

# Multiplicity is preserved: two identical actual values do not satisfy an
# expectation of one, because a duplicated protocol field is a real defect.
fn multiset_equal(expected: [text], actual: [text]) -> bool:
    if expected.len() != actual.len():
        return false
    var remaining = actual
    for want in expected:
        if not contains_value(remaining, want):
            return false
        remaining = remove_first(remaining, want)
    remaining.len() == 0

fn sequence_equal(expected: [text], actual: [text]) -> bool:
    if expected.len() != actual.len():
        return false
    var i = 0
    while i < expected.len():
        if expected[i] != actual[i]:
            return false
        i = i + 1
    true

fn join_values(items: [text]) -> text:
    var out = ""
    var i = 0
    while i < items.len():
        if i > 0:
            out = out + ", "
        out = out + items[i]
        i = i + 1
    out

fn abs_i64(v: i64) -> i64:
    if v < 0:
        return 0 - v
    v

# ---------------------------------------------------------------------------
# Bindings (correlation)
# ---------------------------------------------------------------------------

pub struct EvidenceBinding:
    name: text
    value: text

fn binding_value(bindings: [EvidenceBinding], name: text) -> text:
    for binding in bindings:
        if binding.name == name:
            return binding.value
    ""

fn binding_exists(bindings: [EvidenceBinding], name: text) -> bool:
    for binding in bindings:
        if binding.name == name:
            return true
    false

# ---------------------------------------------------------------------------
# Vacuity gates
# ---------------------------------------------------------------------------

# A capture with no positive oracle observes the production system without
# asserting anything about it. Ignore checks do not count.
pub fn has_positive_oracle(spec: OracleSpec) -> bool:
    for check in spec.checks:
        if check.mode != OracleMode.ignore:
            return true
    false

pub fn ignores_have_reasons(spec: OracleSpec) -> bool:
    for check in spec.checks:
        if check.mode == OracleMode.ignore and check.reason == "":
            return false
        if check.mode == OracleMode.numeric_tolerance and check.tolerance > 0 and check.reason == "":
            return false
    true

# ---------------------------------------------------------------------------
# Comparator
# ---------------------------------------------------------------------------

fn failed_result(summary: text, checks: [EvidenceCheckResult]) -> ComparisonResult:
    ComparisonResult(status: EvidenceStatus.failed, summary: summary, checks: checks)

fn evaluate_check(
    evidence: CanonicalEvidence,
    check: OracleCheck,
    bindings: [EvidenceBinding]
) -> EvidenceCheckResult:
    val label = selector_display(check.selector)
    val mode_name = oracle_mode_name(check.mode)
    val nodes = resolve_nodes(evidence, check.selector)
    val count = nodes.len()

    if count == 0 and check.selector.optional:
        return check_result(label, mode_name, check.expected, "", EvidenceStatus.ignored, "optional selector absent")

    if check.selector.cardinality >= 0:
        if count != check.selector.cardinality:
            return check_result(
                label,
                mode_name,
                check.expected,
                "{count} node(s)",
                EvidenceStatus.failed,
                cardinality_error(check.selector, count)
            )
    elif count == 0:
        return check_result(label, mode_name, check.expected, "", EvidenceStatus.failed, "selector resolved no node")

    val actual = if count > 0: nodes[0].value else: ""

    match check.mode:
        case OracleMode.ignore:
            check_result(label, mode_name, "ignored", actual, EvidenceStatus.ignored, check.reason)
        case OracleMode.full_pattern:
            if pattern_matches(check.expected, actual):
                check_result(label, mode_name, check.expected, actual, EvidenceStatus.passed, "")
            else:
                check_result(label, mode_name, check.expected, actual, EvidenceStatus.failed, "value does not match the whole pattern")
        case OracleMode.multiset:
            val values = node_values(nodes)
            if multiset_equal(check.expected_items, values):
                check_result(label, mode_name, join_values(check.expected_items), join_values(values), EvidenceStatus.passed, "")
            else:
                check_result(label, mode_name, join_values(check.expected_items), join_values(values), EvidenceStatus.failed, "multiset mismatch")
        case OracleMode.ordered_sequence:
            val ordered = node_values(nodes)
            if sequence_equal(check.expected_items, ordered):
                check_result(label, mode_name, join_values(check.expected_items), join_values(ordered), EvidenceStatus.passed, "")
            else:
                check_result(label, mode_name, join_values(check.expected_items), join_values(ordered), EvidenceStatus.failed, "sequence mismatch")
        case OracleMode.numeric_tolerance:
            val want = check.expected.to_i64()
            val got = actual.to_i64()
            if abs_i64(got - want) <= check.tolerance:
                check_result(label, mode_name, check.expected, actual, EvidenceStatus.passed, check.reason)
            else:
                check_result(label, mode_name, check.expected, actual, EvidenceStatus.failed, "outside tolerance " + "{check.tolerance}")
        case OracleMode.semantic:
            if check.bind_name != "":
                return check_result(label, mode_name, "bind " + check.bind_name, actual, EvidenceStatus.passed, "captured for correlation")
            if check.expected.starts_with("$"):
                val name = check.expected.slice(1, check.expected.len())
                if not binding_exists(bindings, name):
                    return check_result(label, mode_name, check.expected, actual, EvidenceStatus.failed, "correlation binding " + name + " was never captured")
                val bound = binding_value(bindings, name)
                if bound == actual:
                    return check_result(label, mode_name, "same as " + name, actual, EvidenceStatus.passed, "")
                return check_result(label, mode_name, bound, actual, EvidenceStatus.failed, "correlation mismatch")
            if check.expected == actual:
                check_result(label, mode_name, check.expected, actual, EvidenceStatus.passed, "")
            else:
                check_result(label, mode_name, check.expected, actual, EvidenceStatus.failed, "value mismatch")
        case _:
            if check.expected == actual:
                check_result(label, mode_name, check.expected, actual, EvidenceStatus.passed, "")
            else:
                check_result(label, mode_name, check.expected, actual, EvidenceStatus.failed, "value mismatch")

fn check_covers(spec: OracleSpec, path: text) -> bool:
    for check in spec.checks:
        if check.selector.path == path:
            return true
    false

pub fn compare_evidence(evidence: CanonicalEvidence, spec: OracleSpec) -> ComparisonResult:
    if not evidence.parse_ok:
        return failed_result(
            "evidence failed to parse: " + evidence.parse_error,
            [check_result("<document>", "parse", "parsed evidence", "parse error", EvidenceStatus.failed, evidence.parse_error)]
        )

    if spec.checks.len() == 0:
        return failed_result(
            "oracle declares no checks",
            [check_result("<oracle>", "vacuity", "at least one check", "none", EvidenceStatus.failed, "an evidence capture must assert something")]
        )

    if not ignores_have_reasons(spec):
        return failed_result(
            "an ignored or tolerated value has no recorded reason",
            [check_result("<oracle>", "vacuity", "reason for every ignore/tolerance", "missing reason", EvidenceStatus.failed, "unexplained ignores hide unchecked fields")]
        )

    if not has_positive_oracle(spec):
        return failed_result(
            "oracle has no positive production check",
            [check_result("<oracle>", "vacuity", "at least one non-ignore check", "all ignored", EvidenceStatus.failed, "a capture that ignores everything verifies nothing")]
        )

    var results: [EvidenceCheckResult] = []
    var bindings: [EvidenceBinding] = []
    var failures = 0
    var positives = 0

    for check in spec.checks:
        val result = evaluate_check(evidence, check, bindings)
        if check.bind_name != "" and result.status == EvidenceStatus.passed:
            bindings.push(EvidenceBinding(name: check.bind_name, value: result.actual))
        if result.status == EvidenceStatus.failed:
            failures = failures + 1
        elif result.status == EvidenceStatus.passed and check.mode != OracleMode.ignore:
            positives = positives + 1
        results.push(result)

    if spec.closed:
        for node in evidence.nodes:
            if not check_covers(spec, node.path):
                failures = failures + 1
                results.push(check_result(
                    node.path,
                    "closed",
                    "declared field",
                    node.value,
                    EvidenceStatus.failed,
                    "undeclared field present under a closed oracle"
                ))

    # A pattern-only oracle that resolved nothing would otherwise report a
    # clean pass over an empty observation.
    if positives == 0 and failures == 0:
        return failed_result(
            "no positive check resolved against the evidence",
            results
        )

    if failures > 0:
        return failed_result("{failures} check(s) failed", results)

    ComparisonResult(
        status: EvidenceStatus.passed,
        summary: "{positives} check(s) passed",
        checks: results
    )

# ---------------------------------------------------------------------------
# Manual projection
# ---------------------------------------------------------------------------

# Docgen renders these blocks; the comparator never emits Markdown itself.
pub fn comparison_to_manual_blocks(title: text, result: ComparisonResult) -> [ManualBlock]:
    var rows: [text] = []
    rows.push("Selector | Mode | Expected | Actual | Result")
    for check in result.checks:
        rows.push(
            check.selector + " | " + check.mode + " | " + check.expected + " | "
            + check.actual + " | " + evidence_status_name(check.status)
        )
    [
        manual_block(ManualBlockKind.expected_actual, title, rows),
        manual_block_for(
            ManualBlockKind.paragraph,
            title,
            EvidenceAudience.qa,
            [evidence_status_name(result.status) + " — " + result.summary]
        )
    ]
