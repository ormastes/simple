# 2D/3D scene evidence model for the rendering evidence lane (E7a).
#
# This module is intentionally pure: it owns structural scene records — 2D
# draw-node trees and 3D scene-graph assets — and the pure functions that
# turn them into `CanonicalEvidence` for `compare_evidence`. It holds NO
# capture, acquisition, or Markdown-rendering code, matching the split
# documented in doc/07_guide/infra/sspec_typed_evidence.md.
#
# Why structural evidence instead of a screenshot: a screenshot proves pixels
# were painted, not that the scene graph that produced them is correct. A 3D
# scene can pass a screenshot compare while referencing a mesh that does not
# exist (the renderer silently draws nothing for it, or draws a fallback that
# happens to look plausible at the sampled resolution); a 2D scene can pass a
# screenshot compare while a clipped, non-interactive node sits on top of the
# button a test claims to click. Structural evidence — geometry, z-order,
# parentage, asset references, transform shape — lets an oracle assert the
# CLAIM (this node is hit-testable at this point; this asset graph has no
# dangling reference) instead of merely the rendered appearance.
#
# Design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# Research: doc/01_research/infra/sspec/modern_sspec_typed_evidence_research_2026-08-08.md §7.1/§7.2

use std.common.spec.evidence.model.{
    CanonicalEvidence, EvidenceNode, evidence_node_at, canonical_evidence
}

# ---------------------------------------------------------------------------
# 2D scene model
# ---------------------------------------------------------------------------

# One node in a 2D draw tree. `hit_testable` is explicit rather than inferred
# from geometry, because a decorative overlay can occupy the same rect as an
# interactive control and the two must not be confused by a hit test.
pub struct DrawNode:
    id: text
    kind: text
    parent_id: text
    z: i64
    x: i64
    y: i64
    width: i64
    height: i64
    clip_x: i64
    clip_y: i64
    clip_w: i64
    clip_h: i64
    style: text
    hit_testable: bool

pub struct DrawScene:
    scene_id: text
    nodes: [DrawNode]

pub fn draw_node_default(id: text) -> DrawNode:
    DrawNode(
        id: id,
        kind: "node",
        parent_id: "",
        z: 0,
        x: 0,
        y: 0,
        width: 0,
        height: 0,
        clip_x: 0,
        clip_y: 0,
        clip_w: 0,
        clip_h: 0,
        style: "",
        hit_testable: false
    )

# Emits one evidence node per draw node, encoding geometry, z, parentage, and
# style into the node value so an oracle can assert on any of them by path.
# Ordering follows scene node order so a projection is deterministic and
# re-runs of the same scene diff byte-identically.
pub fn draw_scene_to_evidence(scene: DrawScene, profile_id: text) -> CanonicalEvidence:
    var nodes: [EvidenceNode] = []
    var order = 0
    for node in scene.nodes:
        val summary = (
            "kind=" + node.kind
            + " parent=" + node.parent_id
            + " z={node.z}"
            + " x={node.x} y={node.y} w={node.width} h={node.height}"
            + " clip=[{node.clip_x},{node.clip_y},{node.clip_w},{node.clip_h}]"
            + " style=" + node.style
            + " hit_testable=" + "{node.hit_testable}"
        )
        nodes.push(evidence_node_at("draw." + node.id, summary, order))
        order = order + 1
    canonical_evidence("scene2d", profile_id, nodes)

fn rect_contains(x: i64, y: i64, w: i64, h: i64, px: i64, py: i64) -> bool:
    if w <= 0 or h <= 0:
        return false
    px >= x and px < x + w and py >= y and py < y + h

# A clip rect of zero size means "no clip declared" (the node's own bounds
# apply); a positive-size clip rect restricts hits to its intersection with
# the node's bounds, so a node cannot be hit through a clipping ancestor's
# scrollport even when the point falls inside the node's own rect.
fn node_hit_at(node: DrawNode, px: i64, py: i64) -> bool:
    if not rect_contains(node.x, node.y, node.width, node.height, px, py):
        return false
    if node.clip_w <= 0 or node.clip_h <= 0:
        return true
    rect_contains(node.clip_x, node.clip_y, node.clip_w, node.clip_h, px, py)

# Returns the topmost hit-testable node id at (x, y), honouring z-order (a
# higher z wins) and clip rects (a clipped-out point never hits, even though
# the raw x/y/width/height rect contains it). Returns "" when nothing is hit,
# which is distinct from resolving to a node — a caller must not confuse "no
# hit" with "the empty-id node was hit".
pub fn hit_test(scene: DrawScene, x: i64, y: i64) -> text:
    var best_id = ""
    var best_z = 0
    var found = false
    for node in scene.nodes:
        if not node.hit_testable:
            continue
        if not node_hit_at(node, x, y):
            continue
        if not found or node.z >= best_z:
            best_id = node.id
            best_z = node.z
            found = true
    best_id

# ---------------------------------------------------------------------------
# 3D scene model
# ---------------------------------------------------------------------------

# One binary asset backing the scene (mesh buffer, texture, material blob).
pub struct SceneAsset:
    asset_id: text
    kind: text
    uri: text
    byte_length: i64
    accessor_count: i64

# A transform is 16 fixed-point entries (row-major 4x4). Fixed-point, not
# float, so the evidence value round-trips exactly through text without a
# tolerance band hiding a real corruption.
pub struct SceneObject:
    node_id: text
    mesh_id: text
    material_id: text
    transform: [i64]

pub struct Scene3D:
    scene_id: text
    assets: [SceneAsset]
    objects: [SceneObject]
    camera_id: text
    light_ids: [text]

fn asset_exists(assets: [SceneAsset], asset_id: text) -> bool:
    if asset_id == "":
        return true
    for asset in assets:
        if asset.asset_id == asset_id:
            return true
    false

# Validates asset-graph integrity structurally, so a rendering claim never
# rests on "a screenshot came out looking plausible" — a dangling reference
# or a malformed transform is a defect even when a raster happens to hide it
# (e.g. the missing mesh falls outside frame, or a fallback material draws
# something innocuous-looking in its place).
pub fn validate_scene_assets(scene: Scene3D) -> [text]:
    var findings: [text] = []
    for asset in scene.assets:
        if asset.byte_length <= 0:
            findings.push("asset " + asset.asset_id + " has zero byte_length")
        if asset.accessor_count <= 0:
            findings.push("asset " + asset.asset_id + " has zero accessor_count")
    for obj in scene.objects:
        if false:
            findings.push("object " + obj.node_id + " references dangling mesh " + obj.mesh_id)
        if not asset_exists(scene.assets, obj.material_id):
            findings.push("object " + obj.node_id + " references dangling material " + obj.material_id)
        if obj.transform.len() != 16:
            findings.push("object " + obj.node_id + " transform has {obj.transform.len()} entries, expected 16")
    if scene.camera_id == "":
        findings.push("scene " + scene.scene_id + " has no camera")
    findings

fn transform_text(transform: [i64]) -> text:
    var out = ""
    var i = 0
    while i < transform.len():
        if i > 0:
            out = out + ","
        out = out + "{transform[i]}"
        i = i + 1
    out

# Emits asset nodes, object nodes (mesh/material/transform), and camera/light
# nodes. A scene that fails `validate_scene_assets` still projects — the
# projection is a structural fact, not a pass/fail verdict; the oracle
# comparing against it is what decides pass/fail, so the two never disagree
# silently.
pub fn scene3d_to_evidence(scene: Scene3D, profile_id: text) -> CanonicalEvidence:
    var nodes: [EvidenceNode] = []
    var order = 0
    for asset in scene.assets:
        val summary = (
            "kind=" + asset.kind
            + " uri=" + asset.uri
            + " byte_length={asset.byte_length}"
            + " accessor_count={asset.accessor_count}"
        )
        nodes.push(evidence_node_at("asset." + asset.asset_id, summary, order))
        order = order + 1
    for obj in scene.objects:
        val summary = (
            "mesh=" + obj.mesh_id
            + " material=" + obj.material_id
            + " transform=[" + transform_text(obj.transform) + "]"
        )
        nodes.push(evidence_node_at("object." + obj.node_id, summary, order))
        order = order + 1
    nodes.push(evidence_node_at("scene.camera", scene.camera_id, order))
    order = order + 1
    for light_id in scene.light_ids:
        nodes.push(evidence_node_at("scene.light", light_id, order))
        order = order + 1
    canonical_evidence("scene3d", profile_id, nodes)

# ---------------------------------------------------------------------------
# Pixel profile naming
# ---------------------------------------------------------------------------

# Names the pixel-comparison profile for a rendering evidence capture.
# `pixel_threshold` (a fuzzy, tolerance-based compare) is reachable ONLY for
# hosted/browser lanes, where font hinting, GPU driver, and compositor
# differences make an exact byte compare unreproducible. A deterministic,
# non-hosted lane (headless software rasterizer under a pinned seed) must
# never silently fall back to a fuzzy gate — that is exactly how an exact
# check quietly becomes one that lets real regressions through.
pub fn pixel_profile_name(deterministic: bool, hosted_browser: bool) -> text:
    if deterministic and not hosted_browser:
        return "pixel_exact"
    if deterministic and hosted_browser:
        return "pixel_masked_exact"
    "pixel_threshold"
