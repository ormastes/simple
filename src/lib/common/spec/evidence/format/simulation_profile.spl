# Simulation + performance/statistics evidence profiles (E7b, evidence manifest v1).
#
# This module is pure: it turns a recorded simulation run (or a batch of
# performance samples) into `CanonicalEvidence` nodes that the shared
# comparator in `evidence_comparator.spl` can check. It owns no acquisition,
# no plotting, and no Markdown — a provider elsewhere records the timeline and
# calls in here.
#
# f64 is banned in this layer. All magnitudes are scaled fixed-point integers
# (i64). Callers document their own scale (typically "milli-units": value *
# 1000 = one unit) alongside the field; this module does not assume a scale,
# it only preserves whatever integer the caller already scaled.
#
# Guide: doc/07_guide/infra/sspec_typed_evidence.md
# Research: doc/01_research/infra/sspec/modern_sspec_typed_evidence_research_2026-08-08.md §7.3

use std.common.spec.evidence.model.{
    EvidenceNode, CanonicalEvidence,
    evidence_node_at, canonical_evidence
}

# ---------------------------------------------------------------------------
# Simulation
# ---------------------------------------------------------------------------

# `seed` is required for the run to be reproducible evidence: without it the
# same model/version/solver can produce a different timeline on replay, and a
# trace nobody can reproduce is not evidence of anything.
pub struct SimulationRun:
    model_id: text
    model_version: text
    seed: text
    solver: text
    time_step_us: i64
    termination: text
    environment: text

# One sampled value of one signal at one simulated timestamp (microseconds).
pub struct TimelineEvent:
    t_us: i64
    signal: text
    value: i64

# A bound that must hold at EVERY timeline point for `signal`, not just the
# last one. `min_value`/`max_value` are inclusive.
pub struct InvariantSpec:
    name: text
    signal: text
    min_value: i64
    max_value: i64

# A single expected value for `signal` (e.g. the settled/final reading),
# checked with a tolerance band. `reason` is mandatory: a tolerance without a
# reason is how a real drift hides behind "close enough".
pub struct KpiSpec:
    name: text
    signal: text
    expected: i64
    tolerance: i64
    reason: text

pub fn simulation_run_is_valid(run: SimulationRun) -> bool:
    run.seed != ""

fn abs_i64(v: i64) -> i64:
    if v < 0:
        return 0 - v
    v

# Last-writer-wins per signal would let a transient breach in the middle of
# the run hide behind a fine final value, so every recorded point is checked.
pub fn check_invariants(events: [TimelineEvent], invariants: [InvariantSpec]) -> [text]:
    var findings: [text] = []
    for inv in invariants:
        for event in events:
            if event.signal == inv.signal:
                if event.value < inv.min_value or event.value > inv.max_value:
                    findings.push(
                        inv.name + ": signal " + inv.signal + " at t=" + "{event.t_us}"
                        + "us was " + "{event.value}" + ", outside ["
                        + "{inv.min_value}" + ", " + "{inv.max_value}" + "]"
                    )
    findings

# Evaluates each KPI against the LAST recorded sample of its signal (a KPI
# describes a settled/end-of-run expectation; use `check_invariants` for
# bounds that must hold throughout).
pub fn evaluate_kpis(events: [TimelineEvent], kpis: [KpiSpec]) -> [text]:
    var findings: [text] = []
    for kpi in kpis:
        var last_value = 0
        var found = false
        for event in events:
            if event.signal == kpi.signal:
                last_value = event.value
                found = true
        if not found:
            findings.push(kpi.name + ": signal " + kpi.signal + " was never recorded")
        elif abs_i64(last_value - kpi.expected) > kpi.tolerance:
            findings.push(
                kpi.name + ": signal " + kpi.signal + " was " + "{last_value}"
                + ", expected " + "{kpi.expected}" + " +/- " + "{kpi.tolerance}"
            )
    findings

fn simulation_run_nodes(run: SimulationRun) -> [EvidenceNode]:
    [
        evidence_node_at("simulation.model_id", run.model_id, 0),
        evidence_node_at("simulation.model_version", run.model_version, 1),
        evidence_node_at("simulation.seed", run.seed, 2),
        evidence_node_at("simulation.solver", run.solver, 3),
        evidence_node_at("simulation.time_step_us", "{run.time_step_us}", 4),
        evidence_node_at("simulation.termination", run.termination, 5),
        evidence_node_at("simulation.environment", run.environment, 6)
    ]

# Converts a recorded run + its timeline into canonical evidence. An unseeded
# run is refused: it would otherwise produce nodes that look checkable but
# describe a trace nobody can reproduce.
pub fn simulation_to_evidence(run: SimulationRun, events: [TimelineEvent], profile_id: text) -> CanonicalEvidence:
    if not simulation_run_is_valid(run):
        return CanonicalEvidence(
            kind: "simulation",
            profile_id: profile_id,
            parse_ok: false,
            parse_error: "simulation run has no recorded seed; its trace is not reproducible evidence",
            nodes: []
        )

    var nodes = simulation_run_nodes(run)
    var order = nodes.len()
    for event in events:
        nodes.push(evidence_node_at("simulation.timeline." + event.signal, "{event.value}@{event.t_us}us", order))
        order = order + 1

    canonical_evidence("simulation", profile_id, nodes)

# ---------------------------------------------------------------------------
# Performance / statistics
# ---------------------------------------------------------------------------

# `scale` documents the fixed-point scale of `samples` (e.g. 1000 for
# milli-units of `unit`); it is carried, never applied arithmetically here.
pub struct SampleSet:
    metric: text
    unit: text
    samples: [i64]
    scale: i64

pub fn sample_count(set: SampleSet) -> i64:
    set.samples.len()

pub fn sample_set_is_valid(set: SampleSet) -> bool:
    set.samples.len() > 0

pub fn sample_min(set: SampleSet) -> i64:
    var m = set.samples[0]
    for s in set.samples:
        if s < m:
            m = s
    m

pub fn sample_max(set: SampleSet) -> i64:
    var m = set.samples[0]
    for s in set.samples:
        if s > m:
            m = s
    m

# Integer mean, truncated toward zero — callers already scaled `samples`, so
# the result stays in the same fixed-point unit.
pub fn sample_mean_scaled(set: SampleSet) -> i64:
    var total: i64 = 0
    for s in set.samples:
        total = total + s
    total / set.samples.len()

fn sorted_copy(values: [i64]) -> [i64]:
    var out = values
    var i = 1
    while i < out.len():
        var j = i
        while j > 0 and out[j - 1] > out[j]:
            val tmp = out[j - 1]
            out[j - 1] = out[j]
            out[j] = tmp
            j = j - 1
        i = i + 1
    out

# Nearest-rank percentile: rank = ceil(p/100 * n), clamped to [1, n], 1-based.
# This is the classic nearest-rank definition (no interpolation), computed
# entirely in integer arithmetic. `min_samples` is a caller-declared floor
# below which a percentile is refused rather than reported, because a
# percentile computed from a handful of samples asserts a precision the data
# does not have.
pub fn sample_percentile(samples: [i64], p: i64, min_samples: i64) -> i64:
    if samples.len() < min_samples:
        return -1
    if samples.len() == 0:
        return -1
    val sorted = sorted_copy(samples)
    val n = sorted.len()
    var rank = (p * n + 99) / 100
    if rank < 1:
        rank = 1
    if rank > n:
        rank = n
    sorted[rank - 1]

fn sample_set_nodes(set: SampleSet) -> [EvidenceNode]:
    [
        evidence_node_at("sample_set.metric", set.metric, 0),
        evidence_node_at("sample_set.unit", set.unit, 1),
        evidence_node_at("sample_set.scale", "{set.scale}", 2),
        evidence_node_at("sample_set.count", "{sample_count(set)}", 3),
        evidence_node_at("sample_set.min", "{sample_min(set)}", 4),
        evidence_node_at("sample_set.max", "{sample_max(set)}", 5),
        evidence_node_at("sample_set.mean_scaled", "{sample_mean_scaled(set)}", 6)
    ]

# An empty sample set is refused, not reported as a passing zero: a zero mean
# / zero max over no observations looks like a clean measurement instead of
# the absence of one.
pub fn samples_to_evidence(set: SampleSet, profile_id: text) -> CanonicalEvidence:
    if not sample_set_is_valid(set):
        return CanonicalEvidence(
            kind: "sample_set",
            profile_id: profile_id,
            parse_ok: false,
            parse_error: "sample set " + set.metric + " has no samples",
            nodes: []
        )

    canonical_evidence("sample_set", profile_id, sample_set_nodes(set))

pub fn distribution_within(set: SampleSet, expected: i64, tolerance: i64) -> bool:
    if not sample_set_is_valid(set):
        return false
    abs_i64(sample_mean_scaled(set) - expected) <= tolerance
