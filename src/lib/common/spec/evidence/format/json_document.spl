# JSON document format adapter (E0 lane, evidence manifest v1).
#
# This module is intentionally pure: it turns a raw JSON document into the
# shared `CanonicalEvidence` record, addressed by RFC 6901 JSON Pointers, so
# `selector_json_pointer("/response/items/0")` resolves against it through
# the existing fail-closed `compare_evidence` comparator.
#
# Design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# Research: doc/01_research/infra/sspec/modern_sspec_typed_evidence_research_2026-08-08.md
#
# JSON parser reuse decision: `src/lib/common/json/parser.spl` already owns a
# tested tokenizer (`json_tokenize`) and string/number validators
# (`json_unescape_string`, escape/number validity), so this adapter reuses
# those directly instead of re-lexing JSON from scratch. It does NOT reuse
# `json_parse_object_at` / `json_parse_value_at`, because those build objects
# into a `{text: any}` Dict: a duplicate key silently overwrites its first
# occurrence there, and per doc/07_guide/language/dict_native_pitfalls.md
# `Dict.len()`/`.get()` are unreliable under native codegen for non-scalar
# values anyway. Instead this module walks the SAME token stream directly
# into a flat `[EvidenceNode]` list addressed by pointer path, so duplicate
# members simply become two nodes at the same path (exactly how
# `text_protocol.spl` already represents duplicate headers) and no Dict is
# ever built.
#
# Every rule below exists because its absence produces a green comparison
# that describes nothing:
#
#   - a malformed document that still yields a partial node set would satisfy
#     a subset oracle and read as a clean pass over data that isn't there
#   - silently overwriting a duplicate key would hide a duplicated field that
#     is either a real protocol event or a real bug
#   - splitting an escaped "/" or "~" inside a member name into extra pointer
#     segments would resolve the wrong node for that key
#   - collapsing an empty object/array to "no node" makes "absent" and
#     "empty" indistinguishable to every oracle

use std.common.spec.evidence.model.{
    EvidenceSelectorKind, EvidenceNode, CanonicalEvidence,
    canonical_evidence, canonical_evidence_parse_error
}
use std.common.json.parser.{json_tokenize, json_unescape_string}
use std.common.json.serializer.{json_beautify}

# ---------------------------------------------------------------------------
# RFC 6901 pointer escaping
# ---------------------------------------------------------------------------

# Per RFC 6901 §3: "~" encodes as "~0" and "/" encodes as "~1" inside a
# reference-token. "~" must be escaped first so a literal "~1" in a key is
# never mistaken for an escaped "/".
pub fn json_pointer_escape(name: text) -> text:
    var out = ""
    var i = 0
    while i < name.len():
        val c = name[i:i + 1]
        if c == "~":
            out = out + "~0"
        elif c == "/":
            out = out + "~1"
        else:
            out = out + c
        i = i + 1
    out

fn append_segment(pointer: text, segment: text) -> text:
    pointer + "/" + segment

# ---------------------------------------------------------------------------
# Token-stream walk -> flat evidence nodes
# ---------------------------------------------------------------------------

struct JsonWalk:
    ok: bool
    error: text
    pos: i64
    order: i64
    nodes: [EvidenceNode]

fn walk_ok(pos: i64, order: i64, nodes: [EvidenceNode]) -> JsonWalk:
    JsonWalk(ok: true, error: "", pos: pos, order: order, nodes: nodes)

fn walk_err(error: text, pos: i64) -> JsonWalk:
    JsonWalk(ok: false, error: error, pos: pos, order: 0, nodes: [])

fn push_leaf(nodes: [EvidenceNode], pointer: text, value: text, order: i64) -> [EvidenceNode]:
    var out = nodes
    out.push(EvidenceNode(
        path: pointer,
        kind: EvidenceSelectorKind.json_pointer,
        value: value,
        raw: value,
        order: order
    ))
    out

fn walk_value(
    tokens: [(text, text)],
    pos: i64,
    pointer: text,
    order: i64,
    nodes: [EvidenceNode]
) -> JsonWalk:
    if pos >= tokens.len():
        return walk_err("unexpected end of input", pos)
    val token = tokens[pos]
    val token_type = token.0
    val token_value = token.1
    if token_type == "STRING":
        return walk_ok(pos + 1, order + 1, push_leaf(nodes, pointer, json_unescape_string(token_value), order))
    if token_type == "NUMBER":
        return walk_ok(pos + 1, order + 1, push_leaf(nodes, pointer, token_value, order))
    if token_type == "TRUE" or token_type == "FALSE" or token_type == "NULL":
        return walk_ok(pos + 1, order + 1, push_leaf(nodes, pointer, token_value, order))
    if token_type == "LBRACKET":
        return walk_array(tokens, pos, pointer, order, nodes)
    if token_type == "LBRACE":
        return walk_object(tokens, pos, pointer, order, nodes)
    if token_type == "INVALID":
        return walk_err("invalid token: " + token_value, pos)
    walk_err("unexpected token: " + token_type, pos)

# An empty array still emits a node marking its presence at `pointer`, so an
# oracle checking `pointer` can tell "present and empty" apart from "absent".
fn walk_array(
    tokens: [(text, text)],
    pos: i64,
    pointer: text,
    order: i64,
    nodes: [EvidenceNode]
) -> JsonWalk:
    var p = pos + 1
    var element_count = 0
    var cur_order = order
    var cur_nodes = nodes
    while p < tokens.len():
        val token_type = tokens[p].0
        if token_type == "RBRACKET":
            if element_count == 0:
                cur_nodes = push_leaf(cur_nodes, pointer, "[]", cur_order)
                cur_order = cur_order + 1
            return walk_ok(p + 1, cur_order, cur_nodes)
        if element_count > 0:
            if token_type != "COMMA":
                return walk_err("expected comma in array", p)
            p = p + 1
        val child_pointer = append_segment(pointer, "{element_count}")
        val result = walk_value(tokens, p, child_pointer, cur_order, cur_nodes)
        if not result.ok:
            return result
        cur_nodes = result.nodes
        cur_order = result.order
        p = result.pos
        element_count = element_count + 1
    walk_err("unclosed array", p)

# An empty object still emits a node marking its presence at `pointer`, for
# the same absent-vs-empty reason as the array case above.
fn walk_object(
    tokens: [(text, text)],
    pos: i64,
    pointer: text,
    order: i64,
    nodes: [EvidenceNode]
) -> JsonWalk:
    var p = pos + 1
    var pair_count = 0
    var cur_order = order
    var cur_nodes = nodes
    while p < tokens.len():
        val token_type = tokens[p].0
        if token_type == "RBRACE":
            if pair_count == 0:
                cur_nodes = push_leaf(cur_nodes, pointer, "{}", cur_order)
                cur_order = cur_order + 1
            return walk_ok(p + 1, cur_order, cur_nodes)
        if pair_count > 0:
            if token_type != "COMMA":
                return walk_err("expected comma in object", p)
            p = p + 1
            if p >= tokens.len():
                return walk_err("unexpected end in object", p)
            if tokens[p].0 == "RBRACE":
                return walk_err("trailing comma in object", p)
        if p >= tokens.len():
            return walk_err("unexpected end in object", p)
        val key_token = tokens[p]
        if key_token.0 != "STRING":
            return walk_err("expected string key in object", p)
        # Duplicate keys are preserved as two nodes at the same pointer path
        # rather than overwritten — a `{}`-shaped map would silently keep
        # only the last occurrence.
        val key = json_unescape_string(key_token.1)
        p = p + 1
        if p >= tokens.len():
            return walk_err("unexpected end after key", p)
        if tokens[p].0 != "COLON":
            return walk_err("expected colon after key", p)
        p = p + 1
        val child_pointer = append_segment(pointer, json_pointer_escape(key))
        val result = walk_value(tokens, p, child_pointer, cur_order, cur_nodes)
        if not result.ok:
            return result
        cur_nodes = result.nodes
        cur_order = result.order
        p = result.pos
        pair_count = pair_count + 1
    walk_err("unclosed object", p)

# ---------------------------------------------------------------------------
# Document -> evidence
# ---------------------------------------------------------------------------

# Parses `raw` into `CanonicalEvidence` whose node paths are RFC 6901 JSON
# Pointers rooted at "" (the whole-document pointer). Malformed JSON is
# always a parse error, never a partial node set: an empty node set would
# satisfy any subset oracle and read as a clean pass over data that was
# never actually captured.
pub fn json_to_evidence(raw: text, profile_id: text) -> CanonicalEvidence:
    val tokens = json_tokenize(raw)
    if tokens.len() == 0:
        return canonical_evidence_parse_error("json_document", profile_id, "empty document")
    val result = walk_value(tokens, 0, "", 0, [])
    if not result.ok:
        return canonical_evidence_parse_error("json_document", profile_id, result.error)
    if result.pos != tokens.len():
        return canonical_evidence_parse_error("json_document", profile_id, "trailing data after JSON value")
    canonical_evidence("json_document", profile_id, result.nodes)

# Looks up the first node whose path equals `pointer`. Returns "" when no
# node has that path (callers that need to distinguish "absent" from "empty
# text" should inspect the evidence's node list directly instead).
pub fn json_pointer_resolve(evidence: CanonicalEvidence, pointer: text) -> text:
    for node in evidence.nodes:
        if node.path == pointer:
            return node.value
    ""

# ---------------------------------------------------------------------------
# Manual projection
# ---------------------------------------------------------------------------

fn split_lines(text_value: text) -> [text]:
    if text_value == "":
        return []
    var lines: [text] = []
    var current = ""
    var i = 0
    while i < text_value.len():
        val c = text_value[i:i + 1]
        if c == "\n":
            lines.push(current)
            current = ""
        else:
            current = current + c
        i = i + 1
    lines.push(current)
    lines

# Readers get pretty-printed JSON for the manual's narrative section, not the
# canonical one-liner nodes used for selector resolution — this is deliberate
# and mirrors `text_protocol.protocol_transcript_lines`. Reuses the existing
# `json_beautify` reparse/re-serialize path; on malformed input `json_beautify`
# returns the raw text unchanged, so this always returns at least one line.
pub fn json_pretty_lines(raw: text) -> [text]:
    split_lines(json_beautify(raw))
