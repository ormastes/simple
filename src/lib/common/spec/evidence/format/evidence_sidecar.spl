# Sidecar-manifest writer for typed-evidence Markdown manual generation.
#
# Proposed API from
# doc/08_tracking/test/sspec_binary_md_manual_status_2026-08-18.md § "Proposed
# API sketch": a spec run writes a small sidecar file next to (or mirroring)
# the spec's own path, and `spipe_docgen`'s already-wired
# `app.spipe_docgen.spipe_docgen.evidence_loader` reads it back and splices
# it into the generated `.md` manual as a real Markdown pipe table — no
# change to spipe_docgen's execution model, purely additive.
#
# Sidecar path convention (must match
# `evidence_loader.evidence_sidecar_path` exactly, or the generated manual
# silently drops the section):
#   - `SIMPLE_SPEC_EVIDENCE_DIR` unset (default): "{spec_path}.evidence.sdn",
#     co-located with the spec file.
#   - `SIMPLE_SPEC_EVIDENCE_DIR` set: "{dir}/{spec_path}.evidence.sdn",
#     mirroring the spec's relative path under that directory instead of
#     writing into the tracked spec tree. Parent directories are created as
#     needed.
#
# File format: canonical schema-versioned SDN from `sidecar_sdn.spl`.
# `emit_evidence` appends one typed block per call. Historical v1 key/value
# sidecars are displayed only through the explicit versioned importer; the
# writer refuses to append to v1 or final v2 records.
#
# Additive and append-only: repeated calls for the same spec append blocks to
# the SDN array while preserving existing manifest data.

use std.nogc_sync_mut.io.file_ops.{file_read, file_atomic_write, file_exists}
use std.nogc_sync_mut.io.dir_ops.{dir_create}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.common.spec.evidence.model.{EvidenceStatus, ManualBlockKind, EvidenceAudience, evidence_manifest, manual_block_for}
use std.common.spec.evidence.format.sidecar_sdn.{
    EvidenceSidecar, EvidenceSidecarSource, decode_evidence_sidecar_v2,
    encode_evidence_sidecar_v2, validate_evidence_sidecar_append,
    EVIDENCE_SIDECAR_V1_SCHEMA
}

pub val EVIDENCE_DIR_ENV: text = "SIMPLE_SPEC_EVIDENCE_DIR"

# Mirrors `evidence_loader.evidence_sidecar_path` — kept in sync by hand
# since the loader lives in `src/app/spipe_docgen` (an application module)
# and cannot be imported from `src/lib`.
pub fn evidence_sidecar_path(spec_path: text) -> text:
    val dir = env_get(EVIDENCE_DIR_ENV)
    if dir == "":
        return spec_path + ".evidence.sdn"
    dir + "/" + spec_path + ".evidence.sdn"

fn dirname(path: text) -> text:
    val parts = path.split("/")
    if parts.len() <= 1:
        return "."
    var out = ""
    var i = 0
    while i < parts.len() - 1:
        if i > 0:
            out = out + "/"
        out = out + parts[i]
        i = i + 1
    out

fn new_unverified_sidecar(spec_path: text) -> EvidenceSidecar:
    EvidenceSidecar(
        source: EvidenceSidecarSource.SchemaV2,
        manifest: evidence_manifest(
            "emit_evidence", "binary_layout", spec_path,
            "", "", "", "", "", "", EvidenceStatus.pending_review),
        subject_id: "", definition_sha256: "", expectation_sha256: "",
        blocks: [])

# Appends one rendered evidence block (already-formatted Markdown pipe-table
# lines, e.g. from `binary_layout.stacked_md_table`) to the sidecar file for
# `spec_path`, creating the manifest header only on the first write. Returns
# true on success.
pub fn emit_evidence(spec_path: text, section_title: text, md_lines: [text]) -> bool:
    val target = evidence_sidecar_path(spec_path)
    val parent = dirname(target)
    if parent != "." and parent != "":
        dir_create(parent, true)

    var existing = ""
    if file_exists(target):
        val read = file_read(target)
        if read == nil:
            return false
        existing = read ?? ""
        if existing.trim() == "":
            return false

    var sidecar = new_unverified_sidecar(spec_path)
    if existing.trim() != "":
        if existing.trim().starts_with("schema=" + EVIDENCE_SIDECAR_V1_SCHEMA):
            return false
        sidecar = match decode_evidence_sidecar_v2(existing):
            case Ok(value):
                value
            case Err(_): return false

    match validate_evidence_sidecar_append(sidecar, spec_path):
        case Ok(()): ()
        case Err(_): return false

    sidecar.blocks.push(manual_block_for(
        ManualBlockKind.table, section_title, EvidenceAudience.qa, md_lines))
    val encoded = encode_evidence_sidecar_v2(sidecar)
    val content = match encoded:
        case Ok(value): value
        case Err(_): return false
    file_atomic_write(target, content)
