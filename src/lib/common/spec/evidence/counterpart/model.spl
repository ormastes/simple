@allow(primitive_api)
# Counterpart Conformance — frozen Wave-0 contracts (ABI v1, schema v1).
#
# primitive_api is allowed here deliberately: these records mirror a frozen C
# ABI and an on-disk SDN schema, so counts, versions and predicate results are
# the wire types themselves. Wrapping `bool` and `i64` in newtypes at this layer
# would put a conversion between the contract and the bytes it describes.
#
# Pure records only. No acquisition, no dlopen, no Markdown. These are the
# shared types every counterpart lane consumes:
#
#   CounterpartPlan -> provider adapter -> RawResponse
#   -> converter graph -> LogicalArtifact (+ ExecutionReceipt, ProvenanceReceipt)
#   -> relation engine -> ComparisonMatrix
#   -> CanonicalEvidence -> Modern SSpec comparator -> ManualBlock
#
# Three planes are recorded separately and never collapsed: what the component
# semantically produced (LogicalArtifact), how it was produced
# (ExecutionReceipt), and why it is reproducible (ProvenanceReceipt). A GPU test
# that passes because the GPU path fell back to CPU is the failure this split
# exists to catch.
#
# Design: doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md
# Plan:   doc/03_plan/infra/counterpart/counterpart_conformance_parallel_agent_plan_2026-08-09.md

# ---------------------------------------------------------------------------
# Boundary identity
# ---------------------------------------------------------------------------

# NOTE: the `@allow(primitive_api)` above binds to the FIRST item in this file,
# so that item must be attributable. `pub val` is not, and putting the attribute
# above one makes the whole module fail to parse — while `bin/simple lint` still
# reports it clean. The two module constants therefore live just below this
# struct rather than at the top. See
# doc/08_tracking/bug/lint_reports_clean_on_module_that_fails_to_parse_2026-08-09.md

# `<domain>.<mdsoc-layer>.<stage>@<schema-version>`, e.g.
# "web.resolve.computed_style@1". Providers map their own component names onto
# these through their manifest; the ID is the only thing a plan names.
pub struct BoundaryId:
    domain: text
    layer: text
    stage: text
    schema_version: i64

pub val COUNTERPART_EXTENSION_SCHEMA: text = "simple.sspec.counterpart.v1"
pub val COUNTERPART_ABI_VERSION: i64 = 1

pub fn boundary_id(domain: text, layer: text, stage: text, schema_version: i64) -> BoundaryId:
    BoundaryId(domain: domain, layer: layer, stage: stage, schema_version: schema_version)

pub fn boundary_id_text(id: BoundaryId) -> text:
    id.domain + "." + id.layer + "." + id.stage + "@" + id.schema_version.to_text()

# Fail-closed parse: an unparseable boundary ID yields schema_version -1, which
# every downstream stage rejects. Never guess a default version.
pub fn parse_boundary_id(raw: text) -> BoundaryId:
    val at_parts = raw.split("@")
    if at_parts.len() != 2:
        return BoundaryId(domain: "", layer: "", stage: "", schema_version: -1)
    val dotted = at_parts[0].split(".")
    if dotted.len() != 3:
        return BoundaryId(domain: "", layer: "", stage: "", schema_version: -1)
    val version = at_parts[1].to_i64()
    if version < 1:
        return BoundaryId(domain: "", layer: "", stage: "", schema_version: -1)
    BoundaryId(
        domain: dotted[0],
        layer: dotted[1],
        stage: dotted[2],
        schema_version: version
    )

pub fn boundary_id_is_valid(id: BoundaryId) -> bool:
    (id.schema_version >= 1
        and id.domain != ""
        and id.layer != ""
        and id.stage != "")

# ---------------------------------------------------------------------------
# Plane 1: logical artifact — what was semantically produced
# ---------------------------------------------------------------------------

pub struct LogicalArtifact:
    boundary_id: text
    schema_id: text
    schema_version: i64
    item_count: i64
    canonical_hash: text
    artifact_ref: text

pub fn logical_artifact(
    boundary_id: text,
    schema_id: text,
    schema_version: i64,
    item_count: i64,
    canonical_hash: text,
    artifact_ref: text
) -> LogicalArtifact:
    LogicalArtifact(
        boundary_id: boundary_id,
        schema_id: schema_id,
        schema_version: schema_version,
        item_count: item_count,
        canonical_hash: canonical_hash,
        artifact_ref: artifact_ref
    )

# Vacuity guard. An artifact that resolved zero items is not evidence of
# agreement; it is evidence that nothing was compared.
pub fn logical_artifact_is_vacuous(artifact: LogicalArtifact) -> bool:
    (artifact.item_count <= 0
        or artifact.canonical_hash == ""
        or artifact.schema_id == ""
        or artifact.schema_version < 1)

# ---------------------------------------------------------------------------
# Plane 2: execution receipt — how it was produced
# ---------------------------------------------------------------------------

pub enum ExecutionMode:
    cpu_reference
    simd
    hybrid_vector_gpu
    resident_gpu
    vulkan
    cuda
    qemu_guest
    remote_hardware
    unknown

pub fn execution_mode_name(mode: ExecutionMode) -> text:
    match mode:
        ExecutionMode.cpu_reference => "cpu_reference"
        ExecutionMode.simd => "simd"
        ExecutionMode.hybrid_vector_gpu => "hybrid_vector_gpu"
        ExecutionMode.resident_gpu => "resident_gpu"
        ExecutionMode.vulkan => "vulkan"
        ExecutionMode.cuda => "cuda"
        ExecutionMode.qemu_guest => "qemu_guest"
        ExecutionMode.remote_hardware => "remote_hardware"
        ExecutionMode.unknown => "unknown"

pub fn execution_mode_is_gpu(mode: ExecutionMode) -> bool:
    match mode:
        ExecutionMode.resident_gpu => true
        ExecutionMode.hybrid_vector_gpu => true
        ExecutionMode.vulkan => true
        ExecutionMode.cuda => true
        _ => false

pub struct ExecutionReceipt:
    provider_id: text
    execution_mode: ExecutionMode
    device_identity: text
    queue_identity: text
    submission_count: i64
    fence_completed: bool
    device_origin_readback: bool
    fallback_used: bool
    dropped_events: i64
    completed: bool

pub fn execution_receipt_cpu(provider_id: text) -> ExecutionReceipt:
    ExecutionReceipt(
        provider_id: provider_id,
        execution_mode: ExecutionMode.cpu_reference,
        device_identity: "host-cpu",
        queue_identity: "",
        submission_count: 0,
        fence_completed: false,
        device_origin_readback: false,
        fallback_used: false,
        dropped_events: 0,
        completed: true
    )

# The GPU gate from the design, as data rather than as prose in a spec. Every
# clause must hold; a GPU lane that silently ran on CPU fails here.
pub fn execution_receipt_gpu_gate_failures(receipt: ExecutionReceipt) -> [text]:
    var failures: [text] = []
    if not execution_mode_is_gpu(receipt.execution_mode):
        failures.push("execution_mode=" + execution_mode_name(receipt.execution_mode) + " is not a GPU mode")
    if receipt.submission_count <= 0:
        failures.push("submission_count=" + receipt.submission_count.to_text() + " must be > 0")
    if not receipt.fence_completed:
        failures.push("fence_completed=false")
    if not receipt.device_origin_readback:
        failures.push("device_origin_readback=false")
    if receipt.fallback_used:
        failures.push("fallback_used=true")
    if receipt.dropped_events != 0:
        failures.push("dropped_events=" + receipt.dropped_events.to_text() + " must be 0")
    if not receipt.completed:
        failures.push("completed=false")
    if receipt.device_identity == "":
        failures.push("device_identity is empty")
    failures

# ---------------------------------------------------------------------------
# Plane 3: provenance receipt — why it is reproducible
# ---------------------------------------------------------------------------

pub struct ProvenanceReceipt:
    package_manifest_hash: text
    provider_manifest_hash: text
    input_hash: text
    converter_route_hash: text
    environment_profile: text
    run_id: text

pub fn provenance_receipt_is_complete(receipt: ProvenanceReceipt) -> bool:
    (receipt.package_manifest_hash != ""
        and receipt.provider_manifest_hash != ""
        and receipt.input_hash != ""
        and receipt.converter_route_hash != ""
        and receipt.environment_profile != ""
        and receipt.run_id != "")

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------

pub enum ProviderKind:
    native_in_process
    native_isolated_worker
    process_bridge
    qemu_guest_bridge
    remote_bridge

pub fn provider_kind_name(kind: ProviderKind) -> text:
    match kind:
        ProviderKind.native_in_process => "native_in_process"
        ProviderKind.native_isolated_worker => "native_isolated_worker"
        ProviderKind.process_bridge => "process_bridge"
        ProviderKind.qemu_guest_bridge => "qemu_guest_bridge"
        ProviderKind.remote_bridge => "remote_bridge"

# A provider that could not run is UNAVAILABLE, never PASS. `crashed` is kept
# distinct from `unavailable` on purpose: normalizing a crash into "provider not
# present" is how a real defect becomes a green run.
pub enum ProviderStatus:
    executed
    unavailable
    crashed
    timed_out
    rejected_manifest

pub fn provider_status_name(status: ProviderStatus) -> text:
    match status:
        ProviderStatus.executed => "executed"
        ProviderStatus.unavailable => "unavailable"
        ProviderStatus.crashed => "crashed"
        ProviderStatus.timed_out => "timed_out"
        ProviderStatus.rejected_manifest => "rejected_manifest"

pub struct ComponentManifest:
    component_id: text
    counterpart_boundary_id: text
    input_schema_id: text
    output_schema_id: text
    stateful: bool
    reset_supported: bool
    deterministic_claim: text
    supported_relations: [text]
    supported_execution_modes: [text]
    capability_requirements: [text]

# `independence_group` is what stops two wrappers over one upstream engine from
# being counted as two independent references.
pub struct ProviderManifest:
    provider_id: text
    provider_kind: ProviderKind
    independence_group: text
    abi_version: i64
    version: text
    artifact_hash: text
    license_spdx: text
    components: [ComponentManifest]

pub fn provider_manifest_component(
    manifest: ProviderManifest,
    component_id: text
) -> ComponentManifest?:
    for component in manifest.components:
        if component.component_id == component_id:
            return component
    nil

pub fn provider_manifest_rejections(manifest: ProviderManifest) -> [text]:
    var failures: [text] = []
    if manifest.provider_id == "":
        failures.push("provider_id is empty")
    if manifest.abi_version != COUNTERPART_ABI_VERSION:
        failures.push("abi_version=" + manifest.abi_version.to_text()
            + " expected " + COUNTERPART_ABI_VERSION.to_text())
    if manifest.independence_group == "":
        failures.push("independence_group is empty")
    if manifest.artifact_hash == "":
        failures.push("artifact_hash is empty")
    if manifest.license_spdx == "":
        failures.push("license_spdx is empty")
    if manifest.components.len() == 0:
        failures.push("manifest declares no components")
    for component in manifest.components:
        if not boundary_id_is_valid(parse_boundary_id(component.counterpart_boundary_id)):
            failures.push("component " + component.component_id
                + " has invalid boundary id '" + component.counterpart_boundary_id + "'")
    failures

# ---------------------------------------------------------------------------
# Conversion
# ---------------------------------------------------------------------------

pub enum ConversionLoss:
    identity
    representation_only
    canonicalizing
    semantic_projection
    diagnostic_only

pub fn conversion_loss_name(loss: ConversionLoss) -> text:
    match loss:
        ConversionLoss.identity => "identity"
        ConversionLoss.representation_only => "representation_only"
        ConversionLoss.canonicalizing => "canonicalizing"
        ConversionLoss.semantic_projection => "semantic_projection"
        ConversionLoss.diagnostic_only => "diagnostic_only"

# Ordered severity so a route's loss is the max of its edges.
pub fn conversion_loss_rank(loss: ConversionLoss) -> i64:
    match loss:
        ConversionLoss.identity => 0
        ConversionLoss.representation_only => 1
        ConversionLoss.canonicalizing => 2
        ConversionLoss.semantic_projection => 3
        ConversionLoss.diagnostic_only => 4

pub struct ConverterManifest:
    converter_id: text
    converter_version: text
    from_schema: text
    to_schema: text
    loss: ConversionLoss
    deterministic: bool
    preserved_dimensions: [text]
    dropped_dimensions: [text]
    preconditions: [text]

pub struct ConversionReceipt:
    converter_id: text
    converter_version: text
    input_hash: text
    output_hash: text
    loss: ConversionLoss
    dropped_dimensions: [text]
    assumptions_applied: [text]
    status: text

pub fn conversion_receipt(
    manifest: ConverterManifest,
    input_hash: text,
    output_hash: text,
    assumptions_applied: [text],
    status: text
) -> ConversionReceipt:
    ConversionReceipt(
        converter_id: manifest.converter_id,
        converter_version: manifest.converter_version,
        input_hash: input_hash,
        output_hash: output_hash,
        loss: manifest.loss,
        dropped_dimensions: manifest.dropped_dimensions,
        assumptions_applied: assumptions_applied,
        status: status
    )

# ---------------------------------------------------------------------------
# Relations and oracle authority
# ---------------------------------------------------------------------------

pub enum CounterpartRelation:
    byte_exact
    canonical_exact
    structural_equal
    semantic_equal
    ordered_equal
    multiset_equal
    numeric_bound
    trace_refinement
    cross_decode
    round_trip
    metamorphic
    image_exact
    image_masked_exact
    image_threshold

pub fn relation_name(relation: CounterpartRelation) -> text:
    match relation:
        CounterpartRelation.byte_exact => "byte_exact"
        CounterpartRelation.canonical_exact => "canonical_exact"
        CounterpartRelation.structural_equal => "structural_equal"
        CounterpartRelation.semantic_equal => "semantic_equal"
        CounterpartRelation.ordered_equal => "ordered_equal"
        CounterpartRelation.multiset_equal => "multiset_equal"
        CounterpartRelation.numeric_bound => "numeric_bound"
        CounterpartRelation.trace_refinement => "trace_refinement"
        CounterpartRelation.cross_decode => "cross_decode"
        CounterpartRelation.round_trip => "round_trip"
        CounterpartRelation.metamorphic => "metamorphic"
        CounterpartRelation.image_exact => "image_exact"
        CounterpartRelation.image_masked_exact => "image_masked_exact"
        CounterpartRelation.image_threshold => "image_threshold"

# An exact relation may never traverse a lossy converter. This predicate is the
# single place that rule is expressed; the converter graph and the relation
# engine both consult it rather than re-deriving it.
pub fn relation_requires_exactness(relation: CounterpartRelation) -> bool:
    match relation:
        CounterpartRelation.byte_exact => true
        CounterpartRelation.canonical_exact => true
        CounterpartRelation.image_exact => true
        _ => false

pub fn relation_max_permitted_loss_rank(relation: CounterpartRelation) -> i64:
    if relation_requires_exactness(relation):
        return conversion_loss_rank(ConversionLoss.canonicalizing)
    conversion_loss_rank(ConversionLoss.semantic_projection)

pub enum OracleAuthority:
    normative_vector
    normative_spec_rule
    independent_reference
    differential_peer
    self_execution_mode
    diagnostic_only

pub fn oracle_authority_name(authority: OracleAuthority) -> text:
    match authority:
        OracleAuthority.normative_vector => "normative_vector"
        OracleAuthority.normative_spec_rule => "normative_spec_rule"
        OracleAuthority.independent_reference => "independent_reference"
        OracleAuthority.differential_peer => "differential_peer"
        OracleAuthority.self_execution_mode => "self_execution_mode"
        OracleAuthority.diagnostic_only => "diagnostic_only"

# Higher binds tighter. Consensus among peers can never outrank a normative
# vector: three implementations sharing one defective upstream are not evidence.
pub fn oracle_authority_rank(authority: OracleAuthority) -> i64:
    match authority:
        OracleAuthority.normative_vector => 5
        OracleAuthority.normative_spec_rule => 4
        OracleAuthority.independent_reference => 3
        OracleAuthority.differential_peer => 2
        OracleAuthority.self_execution_mode => 1
        OracleAuthority.diagnostic_only => 0

pub fn oracle_authority_is_binding(authority: OracleAuthority) -> bool:
    oracle_authority_rank(authority) >= oracle_authority_rank(OracleAuthority.differential_peer)

# ---------------------------------------------------------------------------
# Plan
# ---------------------------------------------------------------------------

pub struct PlanSource:
    source_id: text
    provider_id: text
    component_id: text
    authority: OracleAuthority
    required: bool

pub fn plan_source(
    source_id: text,
    provider_id: text,
    component_id: text,
    authority: OracleAuthority,
    required: bool
) -> PlanSource:
    PlanSource(
        source_id: source_id,
        provider_id: provider_id,
        component_id: component_id,
        authority: authority,
        required: required
    )

pub struct PlanComparison:
    left_source_id: text
    right_source_id: text
    relation: CounterpartRelation
    tolerance: i64
    tolerance_reason: text

pub fn plan_comparison(
    left_source_id: text,
    right_source_id: text,
    relation: CounterpartRelation
) -> PlanComparison:
    PlanComparison(
        left_source_id: left_source_id,
        right_source_id: right_source_id,
        relation: relation,
        tolerance: 0,
        tolerance_reason: ""
    )

# A tolerance without a stated rationale is a fabricated expected value. The
# constructor makes the reason mandatory rather than optional.
pub fn plan_comparison_with_tolerance(
    left_source_id: text,
    right_source_id: text,
    relation: CounterpartRelation,
    tolerance: i64,
    tolerance_reason: text
) -> PlanComparison:
    PlanComparison(
        left_source_id: left_source_id,
        right_source_id: right_source_id,
        relation: relation,
        tolerance: tolerance,
        tolerance_reason: tolerance_reason
    )

pub struct CounterpartPlan:
    plan_id: text
    boundary_id: text
    environment_profile: text
    input_ref: text
    sources: [PlanSource]
    comparisons: [PlanComparison]
    require_gpu_receipt_source_ids: [text]

pub fn counterpart_plan(
    plan_id: text,
    boundary_id: text,
    environment_profile: text,
    input_ref: text,
    sources: [PlanSource],
    comparisons: [PlanComparison]
) -> CounterpartPlan:
    CounterpartPlan(
        plan_id: plan_id,
        boundary_id: boundary_id,
        environment_profile: environment_profile,
        input_ref: input_ref,
        sources: sources,
        comparisons: comparisons,
        require_gpu_receipt_source_ids: []
    )

# Fail-closed plan validation, run before any provider is loaded. Every clause
# here corresponds to an acceptance gate in the design doc.
pub fn counterpart_plan_rejections(plan: CounterpartPlan) -> [text]:
    var failures: [text] = []
    if plan.plan_id == "":
        failures.push("plan_id is empty")
    if not boundary_id_is_valid(parse_boundary_id(plan.boundary_id)):
        failures.push("invalid boundary id '" + plan.boundary_id + "'")
    if plan.environment_profile == "":
        failures.push("environment_profile is empty")
    if plan.input_ref == "":
        failures.push("input_ref is empty")
    if plan.sources.len() < 2:
        failures.push("plan needs at least one candidate and one oracle source")
    if plan.comparisons.len() == 0:
        failures.push("plan declares zero comparisons")

    var binding_sources: i64 = 0
    var known: [text] = []
    for source in plan.sources:
        if source.source_id == "":
            failures.push("source with empty source_id")
        if source.provider_id == "" or source.component_id == "":
            failures.push("source " + source.source_id + " is missing provider/component")
        for seen in known:
            if seen == source.source_id:
                failures.push("duplicate source_id " + source.source_id)
        known.push(source.source_id)
        if oracle_authority_is_binding(source.authority):
            binding_sources = binding_sources + 1
    if binding_sources == 0:
        failures.push("no binding oracle source: every source is diagnostic or self-mode")

    for comparison in plan.comparisons:
        if comparison.left_source_id == comparison.right_source_id:
            failures.push("comparison compares " + comparison.left_source_id + " with itself")
        if not plan_has_source(plan, comparison.left_source_id):
            failures.push("comparison references unknown source " + comparison.left_source_id)
        if not plan_has_source(plan, comparison.right_source_id):
            failures.push("comparison references unknown source " + comparison.right_source_id)
        if comparison.tolerance != 0 and comparison.tolerance_reason == "":
            failures.push("comparison " + comparison.left_source_id + "/"
                + comparison.right_source_id + " declares a tolerance with no reason")
    failures

pub fn plan_has_source(plan: CounterpartPlan, source_id: text) -> bool:
    for source in plan.sources:
        if source.source_id == source_id:
            return true
    false

pub fn plan_source_by_id(plan: CounterpartPlan, source_id: text) -> PlanSource?:
    for source in plan.sources:
        if source.source_id == source_id:
            return source
    nil

# ---------------------------------------------------------------------------
# Run result
# ---------------------------------------------------------------------------

pub struct SourceResult:
    source_id: text
    provider_id: text
    independence_group: text
    status: ProviderStatus
    artifact: LogicalArtifact
    execution: ExecutionReceipt
    provenance: ProvenanceReceipt
    conversions: [ConversionReceipt]
    diagnostics: [text]

pub struct ComparisonCell:
    left_source_id: text
    right_source_id: text
    relation: CounterpartRelation
    matched: bool
    mismatch_count: i64
    route_loss: ConversionLoss
    detail: text

pub struct CounterpartRun:
    plan_id: text
    boundary_id: text
    environment_profile: text
    sources: [SourceResult]
    matrix: [ComparisonCell]
    rejections: [text]

pub fn counterpart_run_sources_executed(run: CounterpartRun) -> i64:
    var count: i64 = 0
    for source in run.sources:
        match source.status:
            ProviderStatus.executed => count = count + 1
            _ => count = count
    count

pub fn counterpart_run_sources_unavailable(run: CounterpartRun) -> i64:
    var count: i64 = 0
    for source in run.sources:
        match source.status:
            ProviderStatus.executed => count = count
            _ => count = count + 1
    count

pub fn counterpart_run_comparisons_failed(run: CounterpartRun) -> i64:
    var count: i64 = 0
    for cell in run.matrix:
        if not cell.matched:
            count = count + 1
    count

# Independent references are counted by independence_group, not by provider
# count. Two wrappers over the same engine are one reference.
pub fn counterpart_run_independence_groups(run: CounterpartRun) -> [text]:
    var groups: [text] = []
    for source in run.sources:
        if source.independence_group != "":
            var seen = false
            for existing in groups:
                if existing == source.independence_group:
                    seen = true
            if not seen:
                groups.push(source.independence_group)
    groups

# The framework-wide vacuity gate: a run with nothing executed, nothing
# compared, or every artifact empty is a failure, not a pass.
pub fn counterpart_run_vacuity_failures(run: CounterpartRun) -> [text]:
    var failures: [text] = []
    if run.sources.len() == 0:
        failures.push("run executed zero sources")
    if run.matrix.len() == 0:
        failures.push("run performed zero comparisons")
    if counterpart_run_sources_executed(run) < 2:
        failures.push("fewer than two sources executed: nothing was differentially compared")
    if counterpart_run_independence_groups(run).len() < 2:
        failures.push("all executed sources share one independence group")
    for source in run.sources:
        match source.status:
            ProviderStatus.executed =>
                if logical_artifact_is_vacuous(source.artifact):
                    failures.push("source " + source.source_id + " produced a vacuous artifact")
            _ => failures.push("source " + source.source_id + " status="
                + provider_status_name(source.status))
    failures
