"""Canonical immutable trace schema for independently instrumented layer tests.

The schema is safe for production layer instrumentation, but no production
package imports a comparator, dynamic loader, or reference implementation.
Addresses, native handles, wall-clock timestamps, and mutable payload buffers
are intentionally not representable here.
"""

pub struct TraceEvent:
    schema_version: i64
    run_id: text
    sequence: i64
    monotonic_ns: i64
    layer_id: text
    operation: text
    object_id: text
    parent_id: text
    result_class: text
    error_class: text
    payload_digest: text
    scalar_fields: text
    environment_profile_id: text

pub struct NormalizedTrace:
    schema_version: i64
    run_id: text
    environment_profile_id: text
    events: [TraceEvent]

pub fn trace_event_normalized(event: TraceEvent) -> bool:
    event.schema_version > 0 and event.run_id != "" and event.sequence >= 0 and
        event.monotonic_ns >= 0 and event.layer_id != "" and event.operation != "" and
        event.result_class != "" and event.environment_profile_id != ""

pub fn normalized_trace_valid(trace: NormalizedTrace) -> bool:
    if trace.schema_version <= 0 or trace.run_id == "" or trace.environment_profile_id == "":
        return false
    var prior_sequence: i64 = -1
    var prior_ns: i64 = -1
    var index = 0
    while index < trace.events.len():
        val event = trace.events[index]
        if not trace_event_normalized(event) or event.schema_version != trace.schema_version:
            return false
        if event.run_id != trace.run_id or event.environment_profile_id != trace.environment_profile_id:
            return false
        if event.sequence <= prior_sequence or event.monotonic_ns < prior_ns:
            return false
        prior_sequence = event.sequence
        prior_ns = event.monotonic_ns
        index = index + 1
    true
