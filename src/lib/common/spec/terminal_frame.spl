# TerminalFrame — a mutable ANSI-interpreting terminal grid for the TUI
# driver lane (Agent F, typed-UI-interface wave 2).
#
# Relationship to `evidence/format/terminal_grid.spl` (E2): that module is a
# PURE snapshot model built from already-rendered plain rows and carries NO
# ANSI handling by contract. This module is the other half: it interprets a
# raw escape-sequence STREAM (what a real TUI renderer emits) into a
# cell-accurate frame. A finished TerminalFrame can be projected to plain
# rows and handed to `terminal_snapshot_from_rows` for the evidence lane.
#
# Supported (v1): CUP/HVP, CUU/CUD/CUF/CUB, EL, ED, SGR (8-color, bright
# 90-97/100-107, 256-color 38;5;n / 48;5;n, bold/dim/underline/reverse and
# their resets), CR/LF/BS/TAB, alt-screen enter/leave (?1049/?47) as a flag.
# Wide-char cells use the shared East-Asian-width table in
# `common/layout/text_metrics.spl` (common CJK/emoji ranges only — locale
# tailoring is a stated limitation, not implemented). Graphemes are
# per-codepoint with combining-mark attach; full UAX#29 clustering deferred.
#
# NOT supported (v1, deliberate): OSC sequences (skipped to terminator),
# scroll regions (DECSTBM), IME, cursor save/restore, PTY capture.
# Arch: doc/04_architecture/ui/testing/typed_ui_interface_arch.md §TUI evidence

use std.common.encoding.utf8.{text_codepoints, char_from_codepoint}
use std.common.layout.text_metrics.{codepoint_cells}

pub struct TerminalCell:
    grapheme: text
    width: i64
    continuation: bool
    fg: text
    bg: text
    attrs: text

pub struct TerminalFrame:
    width: i64
    height: i64
    cells: [TerminalCell]
    cursor_row: i64
    cursor_col: i64
    revision: i64
    alt_screen: bool
    # current SGR pen state (applies to subsequently printed cells)
    pen_fg: text
    pen_bg: text
    pen_attrs: text

pub fn terminal_frame_cell_default() -> TerminalCell:
    TerminalCell(grapheme: " ", width: 1, continuation: false, fg: "", bg: "", attrs: "")

pub fn terminal_frame_new(width: i64, height: i64) -> TerminalFrame:
    var cells: [TerminalCell] = []
    var i = 0
    while i < width * height:
        cells.push(terminal_frame_cell_default())
        i = i + 1
    TerminalFrame(
        width: width, height: height, cells: cells,
        cursor_row: 0, cursor_col: 0, revision: 0, alt_screen: false,
        pen_fg: "", pen_bg: "", pen_attrs: ""
    )

pub fn terminal_frame_cell(frame: TerminalFrame, row: i64, col: i64) -> TerminalCell:
    val idx = row * frame.width + col
    if idx < 0 or idx >= frame.cells.len():
        return terminal_frame_cell_default()
    frame.cells[idx]

fn blank_cell(frame: TerminalFrame) -> TerminalCell:
    # Erase operations paint with the current background, per ECMA-48 BCE.
    TerminalCell(grapheme: " ", width: 1, continuation: false, fg: "", bg: frame.pen_bg, attrs: "")

fn set_cell(frame: TerminalFrame, row: i64, col: i64, cell: TerminalCell) -> TerminalFrame:
    var f = frame
    val idx = row * f.width + col
    if idx >= 0 and idx < f.cells.len():
        f.cells[idx] = cell
    f

fn erase_range(frame: TerminalFrame, from_idx: i64, to_idx: i64) -> TerminalFrame:
    # erases cells [from_idx, to_idx) with the blank cell
    var f = frame
    var i = from_idx
    while i < to_idx:
        if i >= 0 and i < f.cells.len():
            f.cells[i] = blank_cell(f)
        i = i + 1
    f

fn scroll_up(frame: TerminalFrame) -> TerminalFrame:
    var f = frame
    var i = 0
    val last_row_start = (f.height - 1) * f.width
    while i < last_row_start:
        f.cells[i] = f.cells[i + f.width]
        i = i + 1
    while i < f.height * f.width:
        f.cells[i] = blank_cell(f)
        i = i + 1
    f

fn clamp(v: i64, lo: i64, hi: i64) -> i64:
    if v < lo:
        return lo
    if v > hi:
        return hi
    v

fn line_feed(frame: TerminalFrame) -> TerminalFrame:
    var f = frame
    f.cursor_row = f.cursor_row + 1
    if f.cursor_row >= f.height:
        f = scroll_up(f)
        f.cursor_row = f.height - 1
    f

# Attach a zero-width combining mark to the cell the cursor logically
# follows: the previous column, skipping over a continuation cell to the
# wide grapheme that owns it.
fn attach_combining(frame: TerminalFrame, mark: text) -> TerminalFrame:
    var f = frame
    var col = f.cursor_col - 1
    if col < 0:
        return f
    var cell = terminal_frame_cell(f, f.cursor_row, col)
    if cell.continuation and col > 0:
        col = col - 1
        cell = terminal_frame_cell(f, f.cursor_row, col)
    cell.grapheme = cell.grapheme + mark
    set_cell(f, f.cursor_row, col, cell)

fn print_grapheme(frame: TerminalFrame, grapheme: text, width: i64) -> TerminalFrame:
    var f = frame
    # wrap when the grapheme (incl. both wide-cell halves) will not fit
    if f.cursor_col + width > f.width:
        f.cursor_col = 0
        f = line_feed(f)
    var cell = TerminalCell(
        grapheme: grapheme, width: width, continuation: false,
        fg: f.pen_fg, bg: f.pen_bg, attrs: f.pen_attrs
    )
    f = set_cell(f, f.cursor_row, f.cursor_col, cell)
    f.cursor_col = f.cursor_col + 1
    if width == 2:
        var cont = terminal_frame_cell_default()
        cont.grapheme = ""
        cont.width = 0
        cont.continuation = true
        cont.fg = f.pen_fg
        cont.bg = f.pen_bg
        cont.attrs = f.pen_attrs
        f = set_cell(f, f.cursor_row, f.cursor_col, cont)
        f.cursor_col = f.cursor_col + 1
    f

# --- SGR -------------------------------------------------------------------

fn attrs_add(attrs: text, name: text) -> text:
    if attrs.contains(name):
        return attrs
    if attrs == "":
        return name
    attrs + " " + name

fn attrs_remove(attrs: text, name: text) -> text:
    var out = ""
    for token in attrs.split(" "):
        if token != name and token != "":
            if out == "":
                out = token
            else:
                out = out + " " + token
    out

fn apply_sgr(frame: TerminalFrame, params: [i64]) -> TerminalFrame:
    var f = frame
    var ps = params
    if ps.len() == 0:
        ps = [0]
    var i = 0
    while i < ps.len():
        val p = ps[i]
        if p == 0:
            f.pen_fg = ""
            f.pen_bg = ""
            f.pen_attrs = ""
        elif p == 1:
            f.pen_attrs = attrs_add(f.pen_attrs, "bold")
        elif p == 2:
            f.pen_attrs = attrs_add(f.pen_attrs, "dim")
        elif p == 4:
            f.pen_attrs = attrs_add(f.pen_attrs, "underline")
        elif p == 7:
            f.pen_attrs = attrs_add(f.pen_attrs, "reverse")
        elif p == 22:
            f.pen_attrs = attrs_remove(attrs_remove(f.pen_attrs, "bold"), "dim")
        elif p == 24:
            f.pen_attrs = attrs_remove(f.pen_attrs, "underline")
        elif p == 27:
            f.pen_attrs = attrs_remove(f.pen_attrs, "reverse")
        elif p >= 30 and p <= 37:
            val n = p - 30
            f.pen_fg = "{n}"
        elif p == 38:
            # 38;5;n — 256-color foreground
            if i + 2 < ps.len() and ps[i + 1] == 5:
                val n = ps[i + 2]
                f.pen_fg = "256:{n}"
                i = i + 2
        elif p == 39:
            f.pen_fg = ""
        elif p >= 40 and p <= 47:
            val n = p - 40
            f.pen_bg = "{n}"
        elif p == 48:
            if i + 2 < ps.len() and ps[i + 1] == 5:
                val n = ps[i + 2]
                f.pen_bg = "256:{n}"
                i = i + 2
        elif p == 49:
            f.pen_bg = ""
        elif p >= 90 and p <= 97:
            val n = p - 90
            f.pen_fg = "bright:{n}"
        elif p >= 100 and p <= 107:
            val n = p - 100
            f.pen_bg = "bright:{n}"
        i = i + 1
    f

# --- CSI dispatch ------------------------------------------------------------

fn param_or(params: [i64], idx: i64, fallback: i64) -> i64:
    if idx >= params.len():
        return fallback
    if params[idx] <= 0:
        return fallback
    params[idx]

fn apply_csi(frame: TerminalFrame, private_mode: bool, params: [i64], final_cp: i64) -> TerminalFrame:
    var f = frame
    if private_mode:
        # only alt-screen enter/leave is recognised: ?1049 / ?47 / ?1047
        val p = param_or(params, 0, 0)
        if p == 1049 or p == 47 or p == 1047:
            if final_cp == 104:      # 'h'
                f.alt_screen = true
                f = erase_range(f, 0, f.width * f.height)
                f.cursor_row = 0
                f.cursor_col = 0
            elif final_cp == 108:    # 'l'
                f.alt_screen = false
        return f
    if final_cp == 72 or final_cp == 102:   # 'H' CUP / 'f' HVP (1-based)
        f.cursor_row = clamp(param_or(params, 0, 1) - 1, 0, f.height - 1)
        f.cursor_col = clamp(param_or(params, 1, 1) - 1, 0, f.width - 1)
    elif final_cp == 65:                    # 'A' CUU
        f.cursor_row = clamp(f.cursor_row - param_or(params, 0, 1), 0, f.height - 1)
    elif final_cp == 66:                    # 'B' CUD
        f.cursor_row = clamp(f.cursor_row + param_or(params, 0, 1), 0, f.height - 1)
    elif final_cp == 67:                    # 'C' CUF
        f.cursor_col = clamp(f.cursor_col + param_or(params, 0, 1), 0, f.width - 1)
    elif final_cp == 68:                    # 'D' CUB
        f.cursor_col = clamp(f.cursor_col - param_or(params, 0, 1), 0, f.width - 1)
    elif final_cp == 75:                    # 'K' EL
        val mode = if params.len() == 0: 0 else: params[0]
        val row_start = f.cursor_row * f.width
        if mode == 0:
            f = erase_range(f, row_start + f.cursor_col, row_start + f.width)
        elif mode == 1:
            f = erase_range(f, row_start, row_start + f.cursor_col + 1)
        elif mode == 2:
            f = erase_range(f, row_start, row_start + f.width)
    elif final_cp == 74:                    # 'J' ED
        val mode = if params.len() == 0: 0 else: params[0]
        val cur = f.cursor_row * f.width + f.cursor_col
        if mode == 0:
            f = erase_range(f, cur, f.width * f.height)
        elif mode == 1:
            f = erase_range(f, 0, cur + 1)
        elif mode == 2:
            f = erase_range(f, 0, f.width * f.height)
    elif final_cp == 109:                   # 'm' SGR
        f = apply_sgr(f, params)
    # unknown final byte: ignored (v1 scope)
    f

# --- Feed --------------------------------------------------------------------

# Interpret a chunk of renderer output (plain text and/or ANSI escape
# sequences) into the frame. Returns the updated frame; `revision` is bumped
# once per feed call.
pub fn terminal_frame_feed(frame: TerminalFrame, input: text) -> TerminalFrame:
    var f = frame
    val cps = text_codepoints(input)
    var i = 0
    while i < cps.len():
        val cp = cps[i]
        if cp == 27:                             # ESC
            if i + 1 < cps.len() and cps[i + 1] == 91:   # '['  => CSI
                var j = i + 2
                var private_mode = false
                if j < cps.len() and cps[j] == 63:       # '?'
                    private_mode = true
                    j = j + 1
                var params: [i64] = []
                var cur = 0
                var have_digit = false
                var final_cp = 0
                while j < cps.len() and final_cp == 0:
                    val c = cps[j]
                    if c >= 48 and c <= 57:
                        cur = cur * 10 + (c - 48)
                        have_digit = true
                        j = j + 1
                    elif c == 59:                        # ';'
                        params.push(cur)
                        cur = 0
                        have_digit = false
                        j = j + 1
                    elif c >= 64 and c <= 126:           # final byte
                        final_cp = c
                    else:
                        j = j + 1                        # skip intermediates
                if final_cp != 0:
                    if have_digit:
                        params.push(cur)
                    f = apply_csi(f, private_mode, params, final_cp)
                    i = j + 1
                else:
                    i = cps.len()                        # truncated sequence
            elif i + 1 < cps.len() and cps[i + 1] == 93: # ']'  => OSC: skip to BEL/ST
                var j = i + 2
                var done = false
                while j < cps.len() and not done:
                    if cps[j] == 7:
                        done = true
                    elif cps[j] == 27 and j + 1 < cps.len() and cps[j + 1] == 92:
                        j = j + 1
                        done = true
                    else:
                        j = j + 1
                i = j + 1
            else:
                i = i + 2                                # other ESC x: skip
        elif cp == 13:                                   # CR
            f.cursor_col = 0
            i = i + 1
        elif cp == 10:                                   # LF
            f.cursor_col = 0
            f = line_feed(f)
            i = i + 1
        elif cp == 8:                                    # BS
            f.cursor_col = clamp(f.cursor_col - 1, 0, f.width - 1)
            i = i + 1
        elif cp == 9:                                    # TAB (next multiple of 8)
            f.cursor_col = clamp((f.cursor_col / 8 + 1) * 8, 0, f.width - 1)
            i = i + 1
        elif cp < 32:
            i = i + 1                                    # other C0: ignore
        else:
            val grapheme = char_from_codepoint(cp)
            val w = codepoint_cells(cp)
            if w == 0:
                f = attach_combining(f, grapheme)
            else:
                f = print_grapheme(f, grapheme, w)
            i = i + 1
    f.revision = f.revision + 1
    f

# --- Projections ---------------------------------------------------------------

pub fn terminal_frame_row_text(frame: TerminalFrame, row: i64) -> text:
    var out = ""
    var col = 0
    while col < frame.width:
        val cell = terminal_frame_cell(frame, row, col)
        if not cell.continuation:
            out = out + cell.grapheme
        col = col + 1
    out

pub fn terminal_frame_text(frame: TerminalFrame) -> [text]:
    var lines: [text] = []
    var row = 0
    while row < frame.height:
        lines.push(terminal_frame_row_text(frame, row))
        row = row + 1
    lines
