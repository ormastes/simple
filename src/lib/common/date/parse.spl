use std.common.date.types.{Date, from_ymd}

@allow(unnamed_duplicate_typed_args) # reason: positional API -- arg order is conventional
# Date Parsing Module
# Parse date strings in various formats

# ============================================================================
# Date Parsing
# ============================================================================

# Parse ISO 8601 date string "YYYY-MM-DD"
fn parse_iso8601(s: text) -> Date?:
    var parts = text_split(s, "-")
    if parts.len() != 3:
        return nil

    # Only nonempty decimal components can reach the integer conversion.
    # Bound each multiply/add before it happens so malformed input cannot wrap.
    for part in parts:
        if part.len() == 0:
            return nil
        var value: i64 = 0
        var index = 0
        while index < part.len():
            val character = text_substring(part, index, index + 1)
            if character < "0" or character > "9":
                return nil
            val digit = i64_from_text(character)
            if value > 922337203685477580 or (value == 922337203685477580 and digit > 7):
                return nil
            value = value * 10 + digit
            index = index + 1

    var year = i64_from_text(parts[0])
    var month = i64_from_text(parts[1])
    var day = i64_from_text(parts[2])

    return from_ymd(year, month, day)

# ============================================================================
# Helper Functions
# ============================================================================

# Convert text to integer
fn i64_from_text(s: text) -> i64:
    var result = 0
    var negative = false
    var i = 0
    var len = text_length(s)

    # Check for negative sign
    if len > 0:
        var first_char = text_substring(s, 0, 1)
        if first_char == "-":
            negative = true
            i = 1

    while i < len:
        var char = text_substring(s, i, i + 1)
        var digit = 0

        if char == "0":
            digit = 0
        if char == "1":
            digit = 1
        if char == "2":
            digit = 2
        if char == "3":
            digit = 3
        if char == "4":
            digit = 4
        if char == "5":
            digit = 5
        if char == "6":
            digit = 6
        if char == "7":
            digit = 7
        if char == "8":
            digit = 8
        if char == "9":
            digit = 9

        result = result * 10 + digit
        i = i + 1

    if negative:
        result = 0 - result

    return result

# Get text length
fn text_length(s: text) -> i64:
    return s.len()

# Get substring (simplified version for parsing)
fn text_substring(s: text, start: i64, end: i64) -> text:
    return s[start:end]

# Split text by delimiter (simplified)
fn text_split(s: text, delim: text) -> [text]:
    return s.split(delim)
