# Platform-neutral byte scan kernels shared by database and protocol code.
#
# FixedVec is the public SIMD facade, and the `_fixedvec_*` kernels below are
# written against it. They are NOT the current dispatch target, for two
# independently measured reasons recorded in
# doc/08_tracking/bug/fixedvec_splat_boxing_mismatch_breaks_simd_scan_2026-09-13.md:
#
#   1. CORRECTNESS. `fixedvec_splat(n, 16)` produces lanes whose runtime
#      representation differs from lanes read out of a `[u8]` (plain int vs
#      boxed u8). `==` between the two is silently false, so `cmp_eq(..).any()`
#      is false for every lane and a needle inside a complete chunk is never
#      found. Fuzzed: 544 mismatches over lengths 1..40.
#   2. COST. The chunk loop rebuilds a fresh 16-element `[u8]` with a per-byte
#      `push` before each `fixedvec_from_array`, which is strictly more work
#      than the scalar loop. Measured n=4096 x200: find_byte 2 ms scalar vs
#      44 ms, bytes_equal 3 ms vs 81 ms.
#
# So `simd_find_byte` / `simd_bytes_equal` delegate to the scalar oracle — the
# same call the precedent `simd_fill_row` makes for the same measured reason.
# The `_fixedvec_*` kernels stay, pinned by
# test/01_unit/lib/common/simd_scan_parity_spec.spl, so that when the boxing
# bug is fixed and a native backend lowers `fixedvec_from_array` in place, the
# parity spec goes green and the dispatch below is flipped back.

use std.simd.fixed.{fixedvec_from_array, fixedvec_splat}

val SIMD_SCAN_LANES: i64 = 16

fn scalar_bytes_equal(lhs: [u8], lhs_start: i64,
                      rhs: [u8], rhs_start: i64, len: i64) -> bool:
    if not simd_scan_span_valid(lhs.len(), lhs_start, len):
        return false
    if not simd_scan_span_valid(rhs.len(), rhs_start, len):
        return false
    var i = 0
    while i < len:
        if lhs[lhs_start + i] != rhs[rhs_start + i]:
            return false
        i = i + 1
    true

fn _fixedvec_bytes_equal(lhs: [u8], lhs_start: i64,
                         rhs: [u8], rhs_start: i64, len: i64) -> bool:
    if not simd_scan_span_valid(lhs.len(), lhs_start, len):
        return false
    if not simd_scan_span_valid(rhs.len(), rhs_start, len):
        return false
    var i = 0
    while i + SIMD_SCAN_LANES <= len:
        var left_lanes: [u8] = []
        var right_lanes: [u8] = []
        var lane = 0
        while lane < SIMD_SCAN_LANES:
            left_lanes.push(lhs[lhs_start + i + lane])
            right_lanes.push(rhs[rhs_start + i + lane])
            lane = lane + 1
        val left_vec = fixedvec_from_array(left_lanes)
        val right_vec = fixedvec_from_array(right_lanes)
        if not left_vec.cmp_eq(right_vec).all():
            return false
        i = i + SIMD_SCAN_LANES
    while i < len:
        if lhs[lhs_start + i] != rhs[rhs_start + i]:
            return false
        i = i + 1
    true

fn scalar_find_byte(bytes: [u8], start: i64, needle: u8) -> i64:
    if not simd_scan_span_valid(bytes.len(), start, 0):
        return -1
    var i = start
    while i < bytes.len():
        if bytes[i] == needle:
            return i
        i = i + 1
    -1

fn _fixedvec_find_byte(bytes: [u8], start: i64, needle: u8) -> i64:
    if not simd_scan_span_valid(bytes.len(), start, 0):
        return -1
    val needle_vec = fixedvec_splat(needle, SIMD_SCAN_LANES as i32)
    var i = start
    while i + SIMD_SCAN_LANES <= bytes.len():
        var lanes: [u8] = []
        var lane = 0
        while lane < SIMD_SCAN_LANES:
            lanes.push(bytes[i + lane])
            lane = lane + 1
        val mask = fixedvec_from_array(lanes).cmp_eq(needle_vec)
        if mask.any():
            var match_lane = 0
            while match_lane < SIMD_SCAN_LANES:
                if mask.lane_active(match_lane as i32):
                    return i + match_lane
                match_lane = match_lane + 1
        i = i + SIMD_SCAN_LANES
    while i < bytes.len():
        if bytes[i] == needle:
            return i
        i = i + 1
    -1

# ============================================================================
# Public dispatch — see the header for why this is the scalar oracle today.
# ============================================================================

fn simd_bytes_equal(lhs: [u8], lhs_start: i64,
                    rhs: [u8], rhs_start: i64, len: i64) -> bool:
    """Span equality. Scalar oracle: the FixedVec kernel is wrong and slower
    (see header + fixedvec_splat_boxing_mismatch bug record)."""
    scalar_bytes_equal(lhs, lhs_start, rhs, rhs_start, len)

fn simd_find_byte(bytes: [u8], start: i64, needle: u8) -> i64:
    """First index of `needle` at or after `start`, or -1. Scalar oracle for
    the same reason as simd_bytes_equal — the FixedVec chunk path never
    reports a hit inside a complete chunk."""
    scalar_find_byte(bytes, start, needle)

fn simd_scan_span_valid(size: i64, start: i64, len: i64) -> bool:
    start >= 0 and len >= 0 and start <= size and len <= size - start
