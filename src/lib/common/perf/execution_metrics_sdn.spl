# SDN persistence for stable execution subjects and volatile observations.

use std.common.perf.execution_metrics.{ResourceUsage, BudgetDecision, AnomalyDecision, BaselineState, resource_evidence_quality_name, termination_cause_name, decision_status_name, baseline_state_name}

pub struct ExecutionSubjectRecord:
    subject_id: text
    subject_kind: text
    policy_id: text
    required_phase_set_id: text

pub struct ExecutionRunRecord:
    run_id: text
    subject_id: text
    cohort_id: text
    started_at: text
    usage: ResourceUsage
    budget: BudgetDecision
    anomaly: AnomalyDecision
    artifact_digest: text

pub struct BaselineRecord:
    baseline_id: text
    cohort_id: text
    state: BaselineState
    generation: i64
    median_value: f64
    sample_count: i64
    sample_artifact_digest: text

fn _sdn_field(value: text) -> text:
    val escaped_slashes = value.replace("\\", "\\\\")
    val escaped_quotes = escaped_slashes.replace("\"", "\\\"")
    val escaped_newlines = escaped_quotes.replace("\n", "\\n")
    "\"{escaped_newlines}\""

pub fn serialize_execution_subjects(subjects: [ExecutionSubjectRecord]) -> text:
    var lines: [text] = [
        "# version: execution-metrics-1",
        "subjects |subject_id, subject_kind, policy_id, required_phase_set_id|"
    ]
    for subject in subjects:
        lines.push("    {_sdn_field(subject.subject_id)}, {_sdn_field(subject.subject_kind)}, {_sdn_field(subject.policy_id)}, {_sdn_field(subject.required_phase_set_id)}")
    lines.join("\n") + "\n"

pub fn serialize_execution_runs(runs: [ExecutionRunRecord]) -> text:
    var lines: [text] = [
        "# version: execution-metrics-1",
        "runs |run_id, subject_id, cohort_id, started_at, wall_ms, user_cpu_ms, system_cpu_ms, peak_tree_charge_bytes, peak_direct_child_rss_bytes, heap_live_end_bytes, heap_peak_bytes, io_read_bytes, io_write_bytes, pids_peak, evidence_quality, termination, signal, exit_code, budget_status, budget_reason, anomaly_status, anomaly_reason, artifact_digest|"
    ]
    for run in runs:
        val usage = run.usage
        lines.push("    {_sdn_field(run.run_id)}, {_sdn_field(run.subject_id)}, {_sdn_field(run.cohort_id)}, {_sdn_field(run.started_at)}, {usage.wall_ms}, {usage.user_cpu_ms}, {usage.system_cpu_ms}, {usage.peak_tree_charge_bytes}, {usage.peak_direct_child_rss_bytes}, {usage.heap_live_end_bytes}, {usage.heap_peak_bytes}, {usage.io_read_bytes}, {usage.io_write_bytes}, {usage.pids_peak}, {resource_evidence_quality_name(usage.evidence_quality)}, {termination_cause_name(usage.termination)}, {usage.signal}, {usage.exit_code}, {decision_status_name(run.budget.status)}, {_sdn_field(run.budget.reason)}, {decision_status_name(run.anomaly.status)}, {_sdn_field(run.anomaly.reason)}, {_sdn_field(run.artifact_digest)}")
    lines.join("\n") + "\n"

pub fn serialize_baseline_history(records: [BaselineRecord]) -> text:
    var lines: [text] = [
        "# version: execution-metrics-1",
        "baselines |baseline_id, cohort_id, state, generation, median_value, sample_count, sample_artifact_digest|"
    ]
    for record in records:
        lines.push("    {_sdn_field(record.baseline_id)}, {_sdn_field(record.cohort_id)}, {baseline_state_name(record.state)}, {record.generation}, {record.median_value}, {record.sample_count}, {_sdn_field(record.sample_artifact_digest)}")
    lines.join("\n") + "\n"
