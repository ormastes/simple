"""Provider-neutral values for process observation V1.

This common module contains no process authority and no runtime calls.  The
opaque lease and the operations which can create or consume it live beside the
existing owned-process implementation in `io/process_ops.spl`.
"""

pub enum ProcessObservationProviderV1:
    Unsupported
    Available

pub enum ObservedProcessStartStatusV1:
    Unsupported
    Started
    ExecFailed
    InvalidRequest
    ResourceExhausted
    ProviderFailed
    CleanupPending

pub enum ObservedProcessPollStatusV1:
    Unsupported
    Polled
    ReuseRejected
    Malformed
    Missing
    ProviderFailed
    CleanupPending

pub enum ObservedProcessResultStatusV1:
    Unsupported
    Collected
    ReuseRejected
    Malformed
    Missing
    ProviderFailed
    CleanupPending

pub enum ObservedProcessFailureReasonV1:
    None
    InvalidRequest
    ResourceExhausted
    ClockUnavailable
    PinFailed
    PipeFailed
    ForkFailed
    ExecFailed
    WaitFailed
    CleanupIncomplete
    MalformedReceipt

pub struct ObservedProcessRequestV1:
    command: text
    args: [text]
    deadline_ms: i64
    term_grace_ms: i64
    stdout_limit: i64
    stderr_limit: i64
    pin_executable: bool

pub struct ObservedProcessStreamV1:
    bytes: [u8]
    seen_bytes: i64
    retained_bytes: i64
    truncated: bool

pub struct ObservedProcessRusageV1:
    user_cpu_ms: i64
    system_cpu_ms: i64
    max_rss_kib: i64
    available: bool

pub struct ObservedExecutablePinV1:
    pinned: bool
    replacement_known: bool
    replacement_detected: bool
    digest: [u8]

pub struct ObservedProcessPollV1:
    status: ObservedProcessPollStatusV1
    pid: i64
    terminal: bool
    deadline_exceeded: bool
    term_sent: bool
    kill_sent: bool
    reaped: bool
    output_complete: bool
    eintr_retries: i64
    failure_reason: ObservedProcessFailureReasonV1
    stdout: ObservedProcessStreamV1
    stderr: ObservedProcessStreamV1

pub struct ObservedProcessResultV1:
    status: ObservedProcessResultStatusV1
    pid: i64
    exit_code: i64
    signal: i64
    deadline_exceeded: bool
    term_sent: bool
    kill_sent: bool
    reaped: bool
    output_complete: bool
    wall_time_ms: i64
    stdout: ObservedProcessStreamV1
    stderr: ObservedProcessStreamV1
    rusage: ObservedProcessRusageV1
    executable_pin: ObservedExecutablePinV1
    failure_reason: ObservedProcessFailureReasonV1

pub fn observed_process_empty_stream_v1() -> ObservedProcessStreamV1:
    ObservedProcessStreamV1(bytes: [], seen_bytes: 0, retained_bytes: 0,
        truncated: false)

pub fn observed_process_empty_rusage_v1() -> ObservedProcessRusageV1:
    ObservedProcessRusageV1(user_cpu_ms: 0, system_cpu_ms: 0,
        max_rss_kib: 0, available: false)

pub fn observed_process_empty_pin_v1() -> ObservedExecutablePinV1:
    ObservedExecutablePinV1(pinned: false, replacement_known: false,
        replacement_detected: false,
        digest: [])

pub fn observed_process_result_status_v1(
    status: ObservedProcessResultStatusV1
) -> ObservedProcessResultV1:
    ObservedProcessResultV1(
        status: status, pid: 0, exit_code: -1, signal: 0,
        deadline_exceeded: false, term_sent: false, kill_sent: false,
        reaped: false, output_complete: false, wall_time_ms: 0,
        stdout: observed_process_empty_stream_v1(),
        stderr: observed_process_empty_stream_v1(),
        rusage: observed_process_empty_rusage_v1(),
        executable_pin: observed_process_empty_pin_v1(),
        failure_reason: ObservedProcessFailureReasonV1.None)

export ProcessObservationProviderV1
export ObservedProcessStartStatusV1, ObservedProcessPollStatusV1
export ObservedProcessResultStatusV1, ObservedProcessRequestV1
export ObservedProcessFailureReasonV1
export ObservedProcessStreamV1, ObservedProcessRusageV1
export ObservedExecutablePinV1, ObservedProcessPollV1, ObservedProcessResultV1
export observed_process_empty_stream_v1, observed_process_empty_rusage_v1
export observed_process_empty_pin_v1, observed_process_result_status_v1
