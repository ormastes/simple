# Actual native slot vocabulary; these values never authorize a write.
pub enum ProcessInputWriteDispositionV1:
    Rejected
    Recorded
    Unknown

pub struct ProcessInputControlStateV1:
    controlled: bool
    active: bool
    revision: i64
    expires_monotonic_ns: i64
    current_attempt_sequence: i64
    last_attempt_sequence: i64
    last_accepted_bytes: i64
    last_status: i64
    last_disposition: ProcessInputWriteDispositionV1
    last_revision: i64
    last_expires_monotonic_ns: i64
    target_digest: text
    nonce_digest: text
    last_target_digest: text
    last_nonce_digest: text
