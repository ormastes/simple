"""Provider-neutral, fail-closed Process Observation V4 receipts.

This is deliberately a pure schema and reducer boundary.  It has no clock,
filesystem, process, FFI, or mutable host authority.  The 64-word packet is a
stable cross-owner ABI; a provider must never infer an unavailable child RSS
from a tree metric or the collector's own RSS.
"""

use std.common.process.deadline_v4.{ProcessObservationPhaseV4}
use std.common.string_core.{bytes_to_text}

pub const PROCESS_OBSERVATION_V4_VERSION: i64 = 4
pub const PROCESS_OBSERVATION_V4_WORDS: i64 = 64
pub const PROCESS_OBSERVATION_V4_DIGEST_BYTES: i64 = 32
pub const PROCESS_OBSERVATION_REQUEST_CODEC_V4: i64 = 1

# Fixed header and field positions. Host code must import these constants rather
# than duplicate magic indexes.
pub const POV4_VERSION: i64 = 0
pub const POV4_PACKET_KIND: i64 = 1
pub const POV4_WORD_COUNT: i64 = 2
pub const POV4_STATUS: i64 = 3
