struct Pov4ReadU64:
    value: i64
    offset: i64

struct Pov4ReadText:
    value: text
    offset: i64

fn pov4_packet_kind(value: i64) -> Result<ProcessObservationPacketKindV4, text>:
    match value:
        1: Ok(ProcessObservationPacketKindV4.Poll)
        2: Ok(ProcessObservationPacketKindV4.Frozen)
        3: Ok(ProcessObservationPacketKindV4.Ack)
        4: Ok(ProcessObservationPacketKindV4.CleanupFrozen)
        5: Ok(ProcessObservationPacketKindV4.CleanupAck)
        _: Err("process observation V4 packet kind is invalid")

fn pov4_status(value: i64) -> Result<ProcessObservationStatusV4, text>:
    match value:
        1: Ok(ProcessObservationStatusV4.Running)
        2: Ok(ProcessObservationStatusV4.Terminal)
        3: Ok(ProcessObservationStatusV4.Rejected)
        4: Ok(ProcessObservationStatusV4.CleanupPending)
        5: Ok(ProcessObservationStatusV4.ProviderFailed)
        _: Err("process observation V4 status is invalid")

fn pov4_phase(value: i64) -> Result<ProcessObservationPhaseV4, text>:
