pub enum ProcessObservationPacketKindV4:
    Unknown = 0
    Poll = 1
    Frozen = 2
    Ack = 3
    CleanupFrozen = 4
    CleanupAck = 5

pub enum ProcessObservationStatusV4:
    Unknown = 0
    Running = 1
    Terminal = 2
    Rejected = 3
    CleanupPending = 4
    ProviderFailed = 5

pub enum ProcessObservationFailurePhaseV4:
    Unknown = 0
    Admission = 1
    Execution = 2
    Wait = 3
    StreamDrain = 4
    Cleanup = 5
    Collection = 6
    Acknowledgement = 7

pub enum ProcessObservationFailureReasonV4:
    Unknown = 0
    InvalidRequest = 1
    InvalidSchema = 2
    ClockFailure = 3
    ExecFailure = 4
    WaitFailure = 5
    StreamReadFailure = 6
    ExecutionDeadline = 7
    CleanupDeadline = 8
    MemoryUnavailable = 9
    ProviderFailure = 10
    BindingMismatch = 11

