# Scalar owner progression only, never an encoded V4 process observation.
pub enum ProcessLaunchProgressV6:
    NoChild
    LaunchPending
    ObservationAvailable

pub const PROCESS_RESERVATION_LAUNCH_PENDING_V6: i64 = 6

pub fn process_launch_progress_decode_v6(value: i64) -> Result<ProcessLaunchProgressV6, text>:
    match value:
        case 0: Ok(ProcessLaunchProgressV6.NoChild)
        case 1: Ok(ProcessLaunchProgressV6.LaunchPending)
        case 2: Ok(ProcessLaunchProgressV6.ObservationAvailable)
        case _: Err("unknown deferred launch progress: {value}")
