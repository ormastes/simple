# Values delivered by the authenticated manager owner, never decoded from
# source tool arguments. A binding is evidence only after its issuer verifies it.
use std.common.source.contracts.{SourceViewSessionV1}

pub struct SourceAgentBindingV1:
    workspace_id: text
    principal_id: text
    agent_session_id: text
    session_generation: i64
    host_epoch: text
    expires_at_ms: i64

pub struct SourceHostedSessionV1:
    binding: SourceAgentBindingV1
    session: SourceViewSessionV1

pub struct SourceViewHostV1:
    host_epoch: text
    capacity: i64
    entries: [SourceHostedSessionV1]
