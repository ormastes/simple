# Source-view values have no filesystem, compiler or protocol dependencies.
# Ranges are half-open UTF-8 byte offsets, never display columns.

pub struct SourceSnapshotV1:
    snapshot_id: text
    document_uri: text
    source: text

pub struct SourceRangeV1:
    start_byte: i64
    end_byte: i64

pub struct SourceProjectionV1:
    snapshot_id: text
    source_text: text
    selected: [SourceRangeV1]
    omitted: [SourceRangeV1]
    completeness: text
    evidence_kind: text
    next_byte: i64

pub struct SourceViewPreferencesV1:
    line_numbers: bool
    inline_info: text
    virtual_hints: bool

pub struct SourcePreferenceReceiptV1:
    request_sequence: i64
    expected_version: i64
    setting: text
    desired: text

pub struct SourceViewSessionV1:
    workspace_id: text
    agent_session_id: text
    preferences_version: i64
    preferences: SourceViewPreferencesV1
    help_seen: bool
    active: bool
    highest_request_sequence: i64
    receipts: [SourcePreferenceReceiptV1]

# Native providers project their existing parser output into these values.
# A parent index addresses this snapshot's node array, never another parse.
pub struct SourceOutlineNodeV1:
    name: text
    qualified_name: text
    kind: text
    parent_index: i64
    full_range: SourceRangeV1
    header_range: SourceRangeV1
    body_range: SourceRangeV1

pub struct SourceOutlineIssueV1:
    message: text
    severity: text
    span: SourceRangeV1

pub struct SourceOutlineV1:
    snapshot_id: text
    provider_id: text
    provider_level: text
    syntax_status: text
    nodes: [SourceOutlineNodeV1]
    issues: [SourceOutlineIssueV1]
    total_issues: i64
    limitations: [text]

pub struct SourceFoldV1:
    label: text
    node_index: i64
    ranges: [SourceRangeV1]

pub struct SourceStructuredViewV1:
    mode: text
    projection: SourceProjectionV1
    visible_nodes: [i64]
    folds: [SourceFoldV1]
    next_index: i64
    target_index: i64
