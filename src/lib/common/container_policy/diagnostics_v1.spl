# Container-policy diagnostics adapter (design §12.1 DiagnosticSet, §18.1).
#
# No parallel rendering library: every refusal is a shared `DiagnosticV1`
# carrying a stable SCMAC-* code, the policy source reference as its file, the
# SDN line/column as its span, and the dotted schema path as a note.

use std.common.diagnostics.diagnostic_v1.{DiagnosticV1}
use std.common.diagnostics.span.{Span}
use std.common.contracts.orchestration.resource_v1.{RejectionV1}
use std.common.contracts.container.sandbox_capability_v1.{SCMAC_SCHEMA_001}

pub fn scmac_diagnostic_v1(code: text, message: text, source_ref: text, path: text,
                           line: i64, col: i64) -> DiagnosticV1:
    var d = DiagnosticV1.error(code, message).with_file(source_ref)
    if line > 0:
        d = d.with_span(Span.at(0, line, col))
    if path != "":
        d = d.with_note("path: " + path)
    d

# A strict-decode rejection becomes SCMAC-SCHEMA-001 with its exact span.
pub fn scmac_schema_diagnostic_v1(r: RejectionV1, source_ref: text) -> DiagnosticV1:
    val d = scmac_diagnostic_v1(SCMAC_SCHEMA_001, r.message, source_ref, r.path, r.line, r.col)
    d.with_note("kind: " + r.kind)

pub fn scmac_codes_of_v1(diags: [DiagnosticV1]) -> [text]:
    var out: [text] = []
    for d in diags:
        out.push(d.code)
    out
