# simple-endpoint-network-v1 schema
#
# Data-shape description of the logical network document decoded by
# endpoint_network_decode_v1.spl (design simple_container_macos_seatbelt §13.4).
# The decoder is authoritative. The CIDR allocates broker addresses only; it
# never configures a host interface, route, PF rule or VPN. Documents over
# 131072 bytes are refused before parsing; at most 256 rules.

simple_endpoint_network_v1_schema:
  version: 1
  required: [schema, name, namespace, generation, addressing, discovery, policy]
  fields:
    schema: "simple-endpoint-network-v1"
    name: identifier
    namespace: identifier
    generation: "1..9007199254740991"
    addressing:
      mode: "logical-ipv4"
      cidr: "a.b.c.d/n, canonical octets, n in 8..30, no host bits"
    discovery:
      suffix: lowercase-dns-name
      mode: "broker"
    policy:
      defaultIngress: "deny"   # fixed in v1
      defaultEgress: "deny"    # fixed in v1
      rules:
        sourceRole: "identifier or *"
        destinationService: "lowercase-dns-name or *"   # exactly one of
        destinationHost: "lowercase-dns-name or *"      # these two
        protocol: "tcp"
        port: "1..65535"
        action: [allow, deny]
  conflicts: >
    An allow rule and a deny rule that can match the same flow (same
    protocol and port; source role and destination equal or '*') are refused
    as SCMAC-NET-004, independent of rule order.
