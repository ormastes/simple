# simple-container-seatbelt-policy-v1 schema
#
# Data-shape description of the provider-policy document decoded by
# sandbox_policy_decode_v1.spl (design simple_container_macos_seatbelt §13.3).
# The decoder is authoritative; this file is for tooling that needs the shape
# without parsing Simple source. Strict profile: unknown or duplicate fields,
# wrong types and unsupported values are refused as SCMAC-SCHEMA-001 with the
# schema path and source line/column. Documents over 65536 bytes are refused
# before parsing.

simple_container_seatbelt_policy_v1_schema:
  version: 1
  required: [schema, name, backend, execution, filesystem, network, limits, cleanup]
  optional: [resources]
  fields:
    schema: "simple-container-seatbelt-policy-v1"
    name: identifier          # 1..128 of [A-Za-z0-9._-]
    backend: "macos-seatbelt-process"
    execution:
      os: "macos"
      isolation: "native-sandbox"
      evidenceProfile: [strict-owned-attempt-v1, finite-parent-owned-v1]
      allowUnsandboxedFallback: false   # fixed; true is refused
    filesystem:
      baseline: identifier
      workspace: identifier
      workspaceAccess: [read-only, read-write]
      privateHome: bool
      privateTemp: bool
      output: identifier
      denyCredentialRoots: bool
      denySiblingAttempts: bool
      grants:                 # optional, at most 128
        root: identifier      # private-home / private-temp are reserved
        ops: [read-data, read-metadata, write, execute, ipc]   # non-empty, no repeats
        recursive: bool       # ipc grants must be false
    network:
      profile: [endpoint-v1, pod-ip-v1]   # pod-ip-v1 decodes, admission refuses SCMAC-NET-001
      networkRef: identifier
      clientMode: [simple, proxy, simple-or-proxy]
      directIp: [deny, allow]             # allow refused unless qualified (SCMAC-NET-002)
      hostListen: [deny, allow]
      publish: [none]
      udp: [deny, allow]
    limits:
      maxStreams: "1..4096"
      maxQueuedBytes: "1..1073741824"
      maxFrameBytes: "1..16777216, <= maxQueuedBytes"
      connectTimeoutMs: "1..3600000"
      idleTimeoutMs: "1..86400000"
    resources:                # optional; refused unless enforcement is qualified (SCMAC-RESOURCE-001)
      hardMemoryLimit: memory-quantity
      hardCpuLimit: cpu-quantity
    cleanup:
      requireQualifiedAbsence: bool
      onUnknown: [quarantine, retain]
