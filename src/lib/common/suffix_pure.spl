# Pure-Simple byte-wise suffix check.
#
# C-MIG-0040 companion: `ends_with_text` mirrors the C-backed extern
# `rt_string_ends_with` (declared src/lib/text.spl, C definition
# src/runtime/runtime_native.c; interpreter-lane oracle
# src/compiler_rust/compiler/src/interpreter_extern/sffi_string.rs::
# rt_string_ends_with_fn, registered mod.rs:1889 —
# `s.as_bytes().ends_with(suffix.as_bytes())`) via an explicit
# byte-index tail comparison, not a re-wrap of either implementation.

# True iff `s` ends with `suffix`, compared byte-for-byte. An empty
# `suffix` always matches (every string ends with the empty string), and a
# `suffix` longer than `s` never matches.
pub fn ends_with_text(s: text, suffix: text) -> bool:
    val sb = s.bytes()
    val xb = suffix.bytes()
    val sn = sb.len()
    val xn = xb.len()
    if xn == 0:
        return true
    if xn > sn:
        return false
    val offset = sn - xn
    var i = 0
    while i < xn:
        if sb[offset + i] != xb[i]:
            return false
        i = i + 1
    return true
