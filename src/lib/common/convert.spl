# Type Conversion Functions
#
# Provides type conversion utilities for parsing and converting between types.
# Pure Simple implementation - no external dependencies.
#
# Functions:
# - digit_value: Get numeric value of a digit character
# - is_int_text: Whether text is a complete, valid integer literal
# - try_parse_int: FAIL-CLOSED parse -> i64? (nil on any invalid input)
# - try_parse_in_range / try_parse_i32 / try_parse_u16 / try_parse_u32 /
#   try_parse_u64: FAIL-CLOSED range-checked parses -> i64?
# - safe_parse_int: FAIL-OPEN parse (returns 0 on failure)
# - parse_u16: Parse text to unsigned 16-bit integer (0..65535), fail-open
# - parse_u32: Parse text to unsigned 32-bit integer (0..4294967295), fail-open
# - parse_u64: Parse text to unsigned 64-bit integer (0..i64 max), fail-open
# - i64_to_usize: Convert i64 to usize (clamps negatives to 0)
# - usize_to_i64: Convert usize to i64 (identity on this runtime)

# ============================================================================
# Helper: Digit Value Lookup
# ============================================================================

fn digit_value(ch: text) -> i64:
    """Get the numeric value of a digit character. Returns -1 for non-digits."""
    if ch == "0": return 0
    if ch == "1": return 1
    if ch == "2": return 2
    if ch == "3": return 3
    if ch == "4": return 4
    if ch == "5": return 5
    if ch == "6": return 6
    if ch == "7": return 7
    if ch == "8": return 8
    if ch == "9": return 9
    return -1

# ============================================================================
# Fail-CLOSED Integer Parsing  (use these for untrusted input)
# ============================================================================
#
# WHY THIS EXISTS
# ---------------
# The `text.to_int()` intrinsic is *typed* as an optional (`i64?`) but the
# runtime backing it (`rt_string_to_int` in src/runtime/runtime_native.c, and
# the Rust seed's equivalent) returns a plain `int64_t` -- nil is not
# representable, so it CANNOT fail.  Every invalid input ("", "abc", "0x1f",
# an overflowing value) comes back as the integer 0, indistinguishable from a
# legitimate "0".  Guards written as
#     val parsed = value.to_int()
#     if parsed == nil: return nil        # <-- DEAD CODE, never taken
# are therefore fail-OPEN: garbage is admitted as 0.  Where 0 is a meaningful
# value (session id, row id, port, index, count) that is a security defect.
#
# `try_parse_int` below is a pure-Simple, genuinely-optional replacement.
# Use it for anything that came from a file, a socket, a query string, an
# environment variable, or a user.
#
# CALLER NOTES (both measured on the JIT and the interpreter):
#  * Test the result with `== nil`, NEVER with `.?`.  `.?` on an i64 optional
#    is a zero-test, not a presence test -- it reports false for a valid
#    Some(0).  `x == nil` and `x ?? default` are correct.
#  * Return the bare value from an `i64?` function, NOT `Some(value)`.
#    Wrapping an i64 in an explicit `Some(...)` multiplies the payload by 8 on
#    the JIT backend (tag-box shift); the interpreter is unaffected.  See
#    doc/08_tracking/bug/to_int_optional_lies_and_some_i64_payload_shift_2026-07-27.md.

fn is_int_text(s: text) -> bool:
    """True when `s` is a complete, valid decimal integer literal.

    Accepts surrounding whitespace and a single leading `+` or `-`.
    Rejects empty text, embedded/trailing junk ("12abc"), hex ("0x1f"),
    digit separators ("1_000") and a bare sign.
    """
    val trimmed = s.trim()
    if trimmed.len() == 0:
        return false
    var start = 0
    if trimmed[0] == "-" or trimmed[0] == "+":
        start = 1
    if start >= trimmed.len():
        return false
    var i = start
    while i < trimmed.len():
        if digit_value(trimmed[i]) < 0:
            return false
        i = i + 1
    true

fn try_parse_int(s: text) -> i64?:
    """Fail-CLOSED parse of text to i64. Returns nil for ANY invalid input.

    Contract (absolute):
      ""                        -> nil
      "abc" / "12abc" / "abc12" -> nil
      "0x1f" / "1_000" / "+"    -> nil
      "0"                       -> 0        <- distinct from failure
      "12" / " 12 " / "+12"     -> 12
      "-12"                     -> -12
      magnitude > 2^60-1        -> nil    (portable ceiling, see below)
    """
    if not is_int_text(s):
        return nil
    val trimmed = s.trim()
    var start = 0
    var negative = false
    if trimmed[0] == "-":
        negative = true
        start = 1
    elif trimmed[0] == "+":
        start = 1
    var result = 0
    var i = start
    while i < trimmed.len():
        val d = digit_value(trimmed[i])
        # Overflow guard.  The ceiling is 2^60-1, NOT i64 max: on the JIT
        # backend an i64 is tag-boxed and loses its top 3 bits, so
        # 9223372036854775807 round-trips as -1 (measured; the interpreter is
        # exact).  Refusing above 2^60-1 keeps the result identical on both
        # engines instead of silently returning a mangled number.
        if result > 115292150460684697:
            return nil
        result = result * 10
        if result > 1152921504606846975 - d:
            return nil
        result = result + d
        i = i + 1
    # Bare value, never `Some(...)` -- see CALLER NOTES above.
    if negative:
        return 0 - result
    result

fn try_parse_in_range(s: text, min_val: i64, max_val: i64) -> i64?:
    """Fail-CLOSED parse constrained to [min_val, max_val]. nil if outside."""
    val parsed = try_parse_int(s)
    if parsed == nil:
        return nil
    val n: i64 = parsed ?? 0
    if n < min_val or n > max_val:
        return nil
    n

fn try_parse_i32(s: text) -> i64?:
    """Fail-CLOSED parse of a signed 32-bit value. nil if invalid or out of range."""
    try_parse_in_range(s, min_val: 0 - 2147483648, max_val: 2147483647)

fn try_parse_u16(s: text) -> i64?:
    """Fail-CLOSED parse of an unsigned 16-bit value. nil if invalid or out of range."""
    try_parse_in_range(s, min_val: 0, max_val: 65535)

fn try_parse_u32(s: text) -> i64?:
    """Fail-CLOSED parse of an unsigned 32-bit value. nil if invalid or out of range."""
    try_parse_in_range(s, min_val: 0, max_val: 4294967295)

fn try_parse_u64(s: text) -> i64?:
    """Fail-CLOSED parse of a non-negative value (capped at 2^60-1). nil if invalid."""
    try_parse_in_range(s, min_val: 0, max_val: 1152921504606846975)

# ============================================================================
# Lenient (fail-OPEN) Integer Parsing -- validated input ONLY
# ============================================================================
#
# These return 0 on failure by design.  They must not gate access to
# anything, because 0 is both "invalid" and a real value.  Prefer
# `try_parse_int` unless the caller has already proven the text is numeric.

fn safe_parse_int(s: text) -> i64:
    """Parse text to i64, returning 0 for invalid input.

    FAIL-OPEN: the 0 returned for "abc" is indistinguishable from the 0
    returned for "0". Use `try_parse_int` for untrusted text.
    """
    val trimmed = s.trim()
    if trimmed.len() == 0:
        return 0
    var start = 0
    var negative = false
    if trimmed[0] == "-":
        negative = true
        start = 1
    if start >= trimmed.len():
        return 0
    var result = 0
    var i = start
    while i < trimmed.len():
        val d = digit_value(trimmed[i])
        if d < 0:
            return 0
        result = result * 10 + d
        i = i + 1
    if negative:
        return -result
    result

# ============================================================================
# Unsigned Integer Parsing
# ============================================================================

fn parse_u16(s: text) -> i64:
    """Parse text as unsigned 16-bit integer. FAIL-OPEN: 0 for invalid or out-of-range input (use try_parse_u16 for untrusted text)."""
    val num = safe_parse_int(s)
    if num < 0 or num > 65535:
        0
    else:
        num

fn parse_u32(s: text) -> i64:
    """Parse text as unsigned 32-bit integer. FAIL-OPEN: 0 for invalid or out-of-range input (use try_parse_u32 for untrusted text)."""
    val num = safe_parse_int(s)
    if num < 0 or num > 4294967295:
        0
    else:
        num

fn parse_u64(s: text) -> i64:
    """Parse text as unsigned 64-bit integer. Limited to i64 max. FAIL-OPEN: 0 for invalid input (use try_parse_u64 for untrusted text)."""
    val num = safe_parse_int(s)
    if num < 0:
        0
    else:
        num

# ============================================================================
# Integer Type Conversions
# ============================================================================

fn i64_to_usize(n: i64) -> i64:
    """Convert i64 to usize. Clamps negative values to 0."""
    if n < 0:
        0
    else:
        n

fn usize_to_i64(n: i64) -> i64:
    """Convert usize to i64. Identity operation (runtime uses i64 for all integers)."""
    n

# ============================================================================
# Additional Conversion Utilities
# ============================================================================

fn to_bool(s: text) -> bool:
    """Convert text to boolean. Returns true for 'true', '1', 'yes', 'on'."""
    val lower = s.trim().to_lower()
    lower == "true" or lower == "1" or lower == "yes" or lower == "on"

fn bool_to_text(b: bool) -> text:
    """Convert boolean to text."""
    if b:
        "true"
    else:
        "false"

fn i64_to_text(n: i64) -> text:
    """Convert i64 to text."""
    "{n}"

fn f64_to_text(n: f64) -> text:
    """Convert f64 to text."""
    "{n}"
