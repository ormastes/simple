export cache_host_mutation_scope_available_v1, cache_host_commit_journal_v1
export cache_host_read_journal_v1
export cache_host_capture_durable_head_v2, cache_host_durable_head_valid_v2
export cache_host_gc_begin_v2, cache_host_gc_window_valid_v2
export cache_host_gc_root_page_v2, cache_host_gc_pin_page_v2
export cache_host_gc_open_candidate_v2, cache_host_gc_candidate_valid_v2
export cache_host_gc_unlink_candidate_v2
export cache_host_gc_finish_v2, cache_host_gc_abort_v2
export cache_host_release_durable_head_v2
