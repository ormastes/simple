struct AuthenticatedPeerReceiptV1:
    opaque_handle: i64
struct CacheReadinessReceiptV1:
    opaque_handle: i64
struct ExclusiveCacheLockReceiptV1:
    opaque_handle: i64
struct HostBootIdentityV1:
    opaque_handle: i64
struct DurableWriterEpochV1:
    opaque_handle: i64

# V3 handles are process-local capabilities. Constructing one from a scalar is
# not admission: every native operation revalidates registry kind, generation,
# root identity and live parent scope.
struct CacheNamespaceAuthorityV3:
    opaque_handle: i64
struct CacheNamespaceScopeV3:
    opaque_handle: i64
struct CacheNamespaceSyncedObjectV3:
    opaque_handle: i64
struct CacheNamespaceRecoveryV3:
    opaque_handle: i64
struct CacheNamespaceGcCandidateV3:
    opaque_handle: i64

enum CacheNamespaceModeV3:
    Publish
    Recover
    Collect

struct CacheNamespaceLimitsV3:
    max_roots: i64
    max_reader_domains: i64
    max_lease_records: i64
    max_synced_objects: i64
    max_page_bytes: i64
    max_candidates: i64

enum CacheNamespaceExpectedHeadV3:
    Genesis
    Selected([u8])

enum CacheNamespaceCommitStatusV3:
    Committed
    Replayed
    Conflict
    Invalid
    Unknown
    Unsupported
    Bounds
    Cancelled
    Stale
    IoBeforeMutation

enum CacheNamespaceResolutionV3:
    ExactCommitted
    ExactNotCommitted
    Unknown
    Invalid
    Unsupported
    Bounds
    Stale

fn cache_host_authenticate_peer_v1(root: CacheRootAuthorityV1,
                                   transport_peer: i64) -> AuthenticatedPeerReceiptV1:
    AuthenticatedPeerReceiptV1(opaque_handle: rt_cache_host_authenticate_peer_v1(
        root.opaque_handle, transport_peer))

fn cache_host_acquire_exclusive_lock_v1(root: CacheRootAuthorityV1,
                                        peer: AuthenticatedPeerReceiptV1) -> ExclusiveCacheLockReceiptV1:
    ExclusiveCacheLockReceiptV1(opaque_handle: rt_cache_host_acquire_exclusive_lock_v1(
        root.opaque_handle, peer.opaque_handle))

fn cache_host_boot_identity_v1(lock: ExclusiveCacheLockReceiptV1) -> HostBootIdentityV1:
    HostBootIdentityV1(opaque_handle: rt_cache_host_boot_identity_v1(lock.opaque_handle))

fn cache_host_advance_writer_epoch_v1(lock: ExclusiveCacheLockReceiptV1,
                                      boot: HostBootIdentityV1) -> DurableWriterEpochV1:
    DurableWriterEpochV1(opaque_handle: rt_cache_host_advance_writer_epoch_v1(
        lock.opaque_handle, boot.opaque_handle))

fn cache_host_publish_readiness_v1(lock: ExclusiveCacheLockReceiptV1,
                                   epoch: DurableWriterEpochV1,
                                   nonce: [u8]) -> CacheReadinessReceiptV1:
    CacheReadinessReceiptV1(opaque_handle: rt_cache_host_publish_readiness_v1(
        lock.opaque_handle, epoch.opaque_handle, nonce, nonce.len()))

# Only status 1 admits readiness. Current provider returns -1 unsupported.
fn cache_host_validate_readiness_v1(peer: AuthenticatedPeerReceiptV1,
                                    readiness: CacheReadinessReceiptV1,
                                    nonce: [u8], epoch: DurableWriterEpochV1) -> i64:
    rt_cache_host_validate_readiness_v1(peer.opaque_handle,
        readiness.opaque_handle, nonce, nonce.len(), epoch.opaque_handle)

fn cache_namespace_mode_code_v3(mode: CacheNamespaceModeV3) -> i64:
    match mode:
        case CacheNamespaceModeV3.Publish: 1
        case CacheNamespaceModeV3.Recover: 2
        case CacheNamespaceModeV3.Collect: 3

fn cache_namespace_expected_head_bytes_v3(
    expected: CacheNamespaceExpectedHeadV3,
) -> Result<[u8], CacheNamespaceCommitStatusV3>:
    match expected:
        case CacheNamespaceExpectedHeadV3.Genesis: Ok([])
        case CacheNamespaceExpectedHeadV3.Selected(bytes):
            if bytes.len() == 0:
                return Err(CacheNamespaceCommitStatusV3.Invalid)
            Ok(bytes)

fn cache_namespace_commit_status_v3(status: i64) -> CacheNamespaceCommitStatusV3:
    match status:
        case 1: CacheNamespaceCommitStatusV3.Committed
        case 2: CacheNamespaceCommitStatusV3.Replayed
        case 0: CacheNamespaceCommitStatusV3.Conflict
        case -2: CacheNamespaceCommitStatusV3.Unknown
        case -3: CacheNamespaceCommitStatusV3.Unsupported
        case -4: CacheNamespaceCommitStatusV3.Bounds
        case -5: CacheNamespaceCommitStatusV3.Cancelled
        case -6: CacheNamespaceCommitStatusV3.Stale
        case -7: CacheNamespaceCommitStatusV3.IoBeforeMutation
        case _: CacheNamespaceCommitStatusV3.Invalid

fn cache_namespace_resolution_v3(status: i64) -> CacheNamespaceResolutionV3:
    match status:
        case 1: CacheNamespaceResolutionV3.ExactCommitted
        case 0: CacheNamespaceResolutionV3.ExactNotCommitted
        case -2: CacheNamespaceResolutionV3.Unknown
        case -3: CacheNamespaceResolutionV3.Unsupported
        case -4: CacheNamespaceResolutionV3.Bounds
        case -6: CacheNamespaceResolutionV3.Stale
        case _: CacheNamespaceResolutionV3.Invalid

# Preserve Unsupported/Invalid as distinct fail-closed provider evidence.
# Exact status Committed alone means the complete namespace provider is admitted.
fn cache_host_namespace_available_v3() -> CacheNamespaceCommitStatusV3:
    cache_namespace_commit_status_v3(rt_cache_host_namespace_available_v3())

fn cache_host_namespace_open_v3(
    root: CacheRootAuthorityV1,
    lock: ExclusiveCacheLockReceiptV1,
    peer: AuthenticatedPeerReceiptV1,
    readiness: CacheReadinessReceiptV1,
    nonce: [u8],
    writer_epoch: DurableWriterEpochV1,
    limits: CacheNamespaceLimitsV3,
) -> Result<CacheNamespaceAuthorityV3, CacheNamespaceCommitStatusV3>:
    val raw = rt_cache_host_namespace_open_v3(
        root.opaque_handle, lock.opaque_handle, peer.opaque_handle,
        readiness.opaque_handle, nonce, nonce.len(), writer_epoch.opaque_handle,
        limits.max_roots, limits.max_reader_domains, limits.max_lease_records,
        limits.max_synced_objects, limits.max_page_bytes,
        limits.max_candidates)
    if raw > 0:
        return Ok(CacheNamespaceAuthorityV3(opaque_handle: raw))
    Err(cache_namespace_commit_status_v3(raw))

fn cache_host_namespace_begin_v3(
    namespace_authority: CacheNamespaceAuthorityV3,
    mode: CacheNamespaceModeV3,
    expected_head: CacheNamespaceExpectedHeadV3,
    live_reader_pin: CacheReaderPinAuthorityV1?,
) -> Result<CacheNamespaceScopeV3, CacheNamespaceCommitStatusV3>:
    val expected_bytes = match cache_namespace_expected_head_bytes_v3(expected_head):
        case Ok(bytes): bytes
        case Err(status): return Err(status)
    var pin_handle: i64 = 0
    match mode:
        case CacheNamespaceModeV3.Publish:
            match live_reader_pin:
                case Some(pin): pin_handle = pin.opaque_handle
                case nil: return Err(CacheNamespaceCommitStatusV3.Invalid)
        case _:
            match live_reader_pin:
                case Some(_): return Err(CacheNamespaceCommitStatusV3.Invalid)
                case nil: pass
    val raw = rt_cache_host_namespace_begin_v3(
        namespace_authority.opaque_handle, cache_namespace_mode_code_v3(mode),
        expected_bytes, expected_bytes.len(), pin_handle)
    if raw > 0:
        return Ok(CacheNamespaceScopeV3(opaque_handle: raw))
    Err(cache_namespace_commit_status_v3(raw))

fn cache_host_namespace_sync_object_v3(
    scope: CacheNamespaceScopeV3,
    object: CacheObjectAuthorityV1,
    kind: text,
    schema: i64,
    digest: text,
    expected_size: i64,
) -> Result<CacheNamespaceSyncedObjectV3, CacheNamespaceCommitStatusV3>:
    val kind_bytes = kind.bytes()
    val digest_bytes = digest.bytes()
    val raw = rt_cache_host_namespace_sync_object_v3(
        scope.opaque_handle, object.opaque_handle, kind_bytes,
        kind_bytes.len(), schema, digest_bytes, digest_bytes.len(),
        expected_size)
    if raw > 0:
        return Ok(CacheNamespaceSyncedObjectV3(opaque_handle: raw))
    Err(cache_namespace_commit_status_v3(raw))

fn cache_host_namespace_commit_selected_v3(
    scope: CacheNamespaceScopeV3,
    target_head: [u8],
    journal_append: [u8],
    synced_objects: [CacheNamespaceSyncedObjectV3],
) -> CacheNamespaceCommitStatusV3:
    var handles: [i64] = []
    for object in synced_objects:
        handles.push(object.opaque_handle)
    cache_namespace_commit_status_v3(rt_cache_host_namespace_commit_selected_v3(
        scope.opaque_handle, target_head, target_head.len(), journal_append,
        journal_append.len(), handles, handles.len()))

fn cache_host_namespace_recovery_capture_v3(
    scope: CacheNamespaceScopeV3,
) -> Result<CacheNamespaceRecoveryV3, CacheNamespaceCommitStatusV3>:
    val raw = rt_cache_host_namespace_recovery_capture_v3(scope.opaque_handle)
    if raw > 0:
        return Ok(CacheNamespaceRecoveryV3(opaque_handle: raw))
    Err(cache_namespace_commit_status_v3(raw))

fn cache_host_namespace_recovery_read_v3(
    recovery: CacheNamespaceRecoveryV3, part: i64, offset: i64,
    mut out: [u8]) -> i64:
    rt_cache_host_namespace_recovery_read_v3(
        recovery.opaque_handle, part, offset, out, out.len())

fn cache_host_namespace_resolve_operation_v3(
    recovery: CacheNamespaceRecoveryV3,
    writer_incarnation: i64,
    operation_digest: text,
    generation: i64,
    manifest_digest: text,
) -> CacheNamespaceResolutionV3:
    val operation_bytes = operation_digest.bytes()
    val manifest_bytes = manifest_digest.bytes()
    cache_namespace_resolution_v3(rt_cache_host_namespace_resolve_operation_v3(
        recovery.opaque_handle, writer_incarnation, operation_bytes,
        operation_bytes.len(), generation, manifest_bytes, manifest_bytes.len()))

fn cache_host_namespace_gc_roots_page_v3(
    scope: CacheNamespaceScopeV3, byte_cursor: i64, mut out: [u8]) -> i64:
    rt_cache_host_namespace_gc_roots_page_v3(
        scope.opaque_handle, byte_cursor, out, out.len())

fn cache_host_namespace_gc_open_candidate_v3(
    scope: CacheNamespaceScopeV3, kind: text, schema: i64,
    digest: text,
) -> Result<CacheNamespaceGcCandidateV3, CacheNamespaceCommitStatusV3>:
    val kind_bytes = kind.bytes()
    val digest_bytes = digest.bytes()
    val raw = rt_cache_host_namespace_gc_open_candidate_v3(
        scope.opaque_handle, kind_bytes, kind_bytes.len(), schema,
        digest_bytes, digest_bytes.len())
    if raw > 0:
        return Ok(CacheNamespaceGcCandidateV3(opaque_handle: raw))
    Err(cache_namespace_commit_status_v3(raw))

fn cache_host_namespace_gc_unlink_candidate_v3(
    scope: CacheNamespaceScopeV3,
    candidate: CacheNamespaceGcCandidateV3,
) -> CacheNamespaceCommitStatusV3:
    cache_namespace_commit_status_v3(
        rt_cache_host_namespace_gc_unlink_candidate_v3(
            scope.opaque_handle, candidate.opaque_handle))

fn cache_host_namespace_finish_v3(
    scope: CacheNamespaceScopeV3) -> CacheNamespaceCommitStatusV3:
    cache_namespace_commit_status_v3(
        rt_cache_host_namespace_finish_v3(scope.opaque_handle))

fn cache_host_namespace_abort_v3(
    scope: CacheNamespaceScopeV3) -> CacheNamespaceCommitStatusV3:
    cache_namespace_commit_status_v3(
        rt_cache_host_namespace_abort_v3(scope.opaque_handle))

fn cache_host_namespace_close_v3(
    namespace_authority: CacheNamespaceAuthorityV3,
) -> CacheNamespaceCommitStatusV3:
    cache_namespace_commit_status_v3(
        rt_cache_host_namespace_close_v3(namespace_authority.opaque_handle))

# Release is explicit so long-lived compiler clients do not retain peer/root
# descriptors and daemon shutdown drops readiness before its writer lock.
fn cache_host_release_peer_v1(peer: AuthenticatedPeerReceiptV1) -> i64:
    rt_cache_host_release_daemon_receipt_v1(peer.opaque_handle)

fn cache_host_release_lock_v1(lock: ExclusiveCacheLockReceiptV1) -> i64:
    rt_cache_host_release_daemon_receipt_v1(lock.opaque_handle)

fn cache_host_release_boot_v1(boot: HostBootIdentityV1) -> i64:
    rt_cache_host_release_daemon_receipt_v1(boot.opaque_handle)

# Process-real daemon entrypoints. `route` lazily launches on the first cache
# operation, authenticates the peer/nonce, reconnects once within 250 ms, and
# otherwise returns the anchored-spool route. Exact status 1 alone is daemon.
fn cache_daemon_serve_v1(root: text) -> i64:
    rt_cache_daemon_serve_v1(root)

fn cache_daemon_route_v1(root: text) -> i64:
    rt_cache_daemon_route_v1(root)

# --- Reconciliation: V1/V2 journal, durable-head and GC wrappers carried
# --- forward from the G successor lineage; the V3 names above are unchanged.

struct CacheDurableHeadAuthorityV2:
    opaque_handle: i64

struct CacheHostGcWindowV2:
    opaque_handle: i64

struct CacheHostGcCandidateV2:
    opaque_handle: i64

# Exact status meanings are intentionally transport-only.  Simple owns frame
# validation, operation identity, replay interpretation and journal recovery.
# commit: 1 appended, 2 exact durable replay, 0 stale/divergent head,
# -2 indeterminate after possible mutation, -1 unsupported/invalid.
fn cache_host_mutation_scope_available_v1() -> bool:
    rt_cache_host_mutation_scope_available_v1() == 1

fn cache_host_commit_journal_v1(
    lock: ExclusiveCacheLockReceiptV1,
    peer: AuthenticatedPeerReceiptV1,
    readiness: CacheReadinessReceiptV1,
    nonce: [u8],
    epoch: DurableWriterEpochV1,
    expected_bytes: i64,
    expected_prefix_digest: text,
    append_bytes: [u8],
) -> i64:
    rt_cache_host_commit_journal_v1(lock.opaque_handle, peer.opaque_handle,
        readiness.opaque_handle, nonce, nonce.len(), epoch.opaque_handle,
        expected_bytes, expected_prefix_digest.bytes(),
        expected_prefix_digest.len(), append_bytes, append_bytes.len())

# Returns the stable byte count or a negative transport/authority status.
fn cache_host_read_journal_v1(
    lock: ExclusiveCacheLockReceiptV1,
    peer: AuthenticatedPeerReceiptV1,
    readiness: CacheReadinessReceiptV1,
    nonce: [u8],
    epoch: DurableWriterEpochV1,
    mut out: [u8],
) -> i64:
    rt_cache_host_read_journal_v1(lock.opaque_handle, peer.opaque_handle,
        readiness.opaque_handle, nonce, nonce.len(), epoch.opaque_handle,
        out, out.len())

fn cache_host_capture_durable_head_v2(
    lock: ExclusiveCacheLockReceiptV1,
    peer: AuthenticatedPeerReceiptV1,
    readiness: CacheReadinessReceiptV1,
    nonce: [u8],
    epoch: DurableWriterEpochV1,
    expected_journal_bytes: i64,
    expected_journal_digest: text,
    journal_generation: i64,
    selected_superblock_generation: i64,
    selected_superblock_digest: text,
    root_count: i64,
) -> CacheDurableHeadAuthorityV2:
    CacheDurableHeadAuthorityV2(opaque_handle:
        rt_cache_host_capture_durable_head_v2(
            lock.opaque_handle, peer.opaque_handle, readiness.opaque_handle,
            nonce, nonce.len(), epoch.opaque_handle, expected_journal_bytes,
            expected_journal_digest.bytes(), expected_journal_digest.len(),
            journal_generation, selected_superblock_generation,
            selected_superblock_digest.bytes(), selected_superblock_digest.len(),
            root_count))

fn cache_host_durable_head_valid_v2(head: CacheDurableHeadAuthorityV2) -> bool:
    head.opaque_handle > 0

fn cache_host_gc_begin_v2(
    root: CacheRootAuthorityV1,
    head: CacheDurableHeadAuthorityV2,
    expected_even_reader_epoch: i64,
    max_root_count: i64,
    max_page_bytes: i64,
    max_candidates: i64,
) -> CacheHostGcWindowV2:
    CacheHostGcWindowV2(opaque_handle: rt_cache_host_gc_begin_v2(
        root.opaque_handle, head.opaque_handle, expected_even_reader_epoch,
        max_root_count, max_page_bytes, max_candidates))

fn cache_host_gc_window_valid_v2(window: CacheHostGcWindowV2) -> bool:
    window.opaque_handle > 0

fn cache_host_gc_root_page_v2(window: CacheHostGcWindowV2, byte_cursor: i64,
                              mut out: [u8]) -> i64:
    rt_cache_host_gc_root_page_v2(window.opaque_handle, byte_cursor,
        out, out.len())

fn cache_host_gc_pin_page_v2(window: CacheHostGcWindowV2, cursor: i64,
                             mut out: [u8]) -> i64:
    rt_cache_host_gc_pin_page_v2(window.opaque_handle, cursor, out, out.len())

fn cache_host_gc_open_candidate_v2(window: CacheHostGcWindowV2, kind: text,
                                   digest: text) -> CacheHostGcCandidateV2:
    CacheHostGcCandidateV2(opaque_handle: rt_cache_host_gc_open_candidate_v2(
        window.opaque_handle, kind, digest))

fn cache_host_gc_candidate_valid_v2(candidate: CacheHostGcCandidateV2) -> bool:
    candidate.opaque_handle > 0

fn cache_host_gc_unlink_candidate_v2(window: CacheHostGcWindowV2,
                                     candidate: CacheHostGcCandidateV2) -> i64:
    rt_cache_host_gc_unlink_candidate_v2(window.opaque_handle,
        candidate.opaque_handle)

fn cache_host_gc_finish_v2(window: CacheHostGcWindowV2,
                           expected_odd_epoch: i64) -> i64:
    rt_cache_host_gc_finish_v2(window.opaque_handle, expected_odd_epoch)

fn cache_host_gc_abort_v2(window: CacheHostGcWindowV2,
                          expected_odd_epoch: i64) -> i64:
    rt_cache_host_gc_abort_v2(window.opaque_handle, expected_odd_epoch)

fn cache_host_release_durable_head_v2(head: CacheDurableHeadAuthorityV2) -> i64:
    rt_cache_host_release_durable_head_v2(head.opaque_handle)

