# Sole common wrapper for daemon, mutation, GC, and namespace host receipts.
# The Linux provider implements V1/V2 primitives and V3 physical helpers, but
# V3 public namespace admission remains Unsupported until every issuer-owned
# participant is bound. Native C and non-Linux providers also remain closed.
# No text or bool is authority and wrapper values are not self-authenticating.

use common.cache_host_authority_v1.{CacheRootAuthorityV1, CacheObjectAuthorityV1,
    CacheReaderPinAuthorityV1}

