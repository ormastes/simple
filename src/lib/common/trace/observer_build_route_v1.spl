# Early hosted observer routing. This module deliberately imports only the V1
# contract: resolving an Off route must not evaluate a platform provider,
# compiler-rt dependency, native map, or executable-memory implementation.
# A candidate identifies the next admission authority; it is NOT permission to
# instrument, link a runtime, patch code, or advertise a supported ABI profile.
use std.common.trace.observer_contract_v1.{TraceInstrumentationV1, TraceBackendV1, TraceFailureV1}

pub enum TraceBuildRouteKindV1:
    Off
    LinuxLlvmCandidate
    LinuxSimpleCandidate

pub struct TraceBuildRouteV1:
    kind: TraceBuildRouteKindV1
    target: text
    backend: TraceBackendV1

# Stages 1/2 admit routing candidates only for the canonical hosted Linux GNU
# triples. Windows (including MinGW), SimpleOS, unknown triples and aliases do
# not inherit host support. An explicit target must never resolve via ambient
# host detection. New triples require their own source/profile review.
pub fn trace_build_route_v1(target: text, instrumentation: TraceInstrumentationV1, backend: TraceBackendV1) -> Result<TraceBuildRouteV1, TraceFailureV1>:
    if instrumentation == TraceInstrumentationV1.Off:
        return Ok(TraceBuildRouteV1(kind: TraceBuildRouteKindV1.Off, target: target, backend: TraceBackendV1.None))

    if target != "x86_64-unknown-linux-gnu" and target != "aarch64-unknown-linux-gnu":
        return Err(TraceFailureV1.UnsupportedTarget)

    match backend:
        case Auto:
            Ok(TraceBuildRouteV1(kind: TraceBuildRouteKindV1.LinuxLlvmCandidate, target: target, backend: TraceBackendV1.Llvm))
        case Llvm:
            Ok(TraceBuildRouteV1(kind: TraceBuildRouteKindV1.LinuxLlvmCandidate, target: target, backend: TraceBackendV1.Llvm))
        case Simple:
            Ok(TraceBuildRouteV1(kind: TraceBuildRouteKindV1.LinuxSimpleCandidate, target: target, backend: TraceBackendV1.Simple))
        case None:
            Err(TraceFailureV1.InvalidArgument)
