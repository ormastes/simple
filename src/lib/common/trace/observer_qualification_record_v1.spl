# Explicit native interoperability encoding for the compiler-owned SDN
# qualification receipt/catalog. Shape validation NEVER issues authority:
# callers can construct these values. Only the verified build/runtime binding
# may issue a profile handle associated with the actual loaded snapshot.
use std.common.trace.observer_contract_v1.{TraceFailureV1}

pub const TRACE_QUALIFICATION_BYTES_V1: i64 = 480
pub const TRACE_QUALIFICATION_DIGEST_COUNT_V1: i64 = 11
pub const TRACE_QUALIFICATION_MAGIC_V1: u64 = 0x0031565150525853u64
pub const TRACE_QUALIFICATION_REQUIRED_EVIDENCE_V1: u64 = 255

# Digest indices: approved receipt, Simple producer, runtime component manifest
# (objects + flags + ownership recipe), Clang, compiler-rt XRay, LLD, linked
# closure manifest, generated Simple ABI evidence, runtime ABI/thread evidence,
# foreign/initializer closure evidence, allocation evidence.
pub struct TraceQualificationRecordV1:
    target: u64
    profile: u64
    evidence_mask: u64
    max_contexts: u64
    buffer_bytes: u64
    resident_bytes: u64
    max_generations: u64
    metadata_reserve: u64
    word_bytes: u64
    digests: [[u8]]

# Target1=Linux x86_64; profile1=one startup activation, raw edges and retained
# armed hooks after recording stop. These codes do not admit other targets.
pub fn trace_qualification_record_validate_shape_v1(record: TraceQualificationRecordV1
        ) -> Result<bool, TraceFailureV1>:
    if record.target != 1 or record.word_bytes != 8:
        return Err(TraceFailureV1.UnsupportedTarget)
    if record.profile != 1 or record.evidence_mask != TRACE_QUALIFICATION_REQUIRED_EVIDENCE_V1:
        return Err(TraceFailureV1.UnsupportedProfile)
    if (record.max_contexts == 0 or record.max_contexts > 64 or
            record.buffer_bytes < 96 or record.buffer_bytes > 393216 or
            record.buffer_bytes % 96u64 != 0 or record.max_generations != 1 or
            record.metadata_reserve != 33554432 or record.resident_bytes > 67108864):
        return Err(TraceFailureV1.ResourceExhausted)
    # Bounds above precede arithmetic. Exact existing allocation includes the
    # descriptor80, pool64, slots32/context, channel128/context, max4096 map
    # entries16 each, and scratch96. Published storage is never recycled.
    val transport = (80u64 + 64u64 + 96u64 + 4096u64 * 16u64 +
        record.max_contexts * (32u64 + 128u64 + record.buffer_bytes))
    if record.resident_bytes < record.metadata_reserve + transport:
        return Err(TraceFailureV1.ResourceExhausted)
    if record.digests.len() != TRACE_QUALIFICATION_DIGEST_COUNT_V1:
        return Err(TraceFailureV1.InvalidArgument)
    for digest in record.digests:
        if digest.len() != 32: return Err(TraceFailureV1.InvalidArgument)
        var nonzero = false
        for byte in digest:
            if byte != 0: nonzero = true
        if not nonzero: return Err(TraceFailureV1.UnsupportedProfile)
    Ok(true)

fn trace_qualification_read_word_v1(bytes: [u8], offset: i64) -> u64:
    var word: u64 = 0
    for index in 0..8:
        word = word | ((bytes[offset + index] as u64) << (index * 8))
    word

pub fn trace_qualification_record_decode_v1(bytes: [u8]
        ) -> Result<TraceQualificationRecordV1, TraceFailureV1>:
    if bytes.len() != TRACE_QUALIFICATION_BYTES_V1:
        return Err(TraceFailureV1.InvalidArgument)
    if (trace_qualification_read_word_v1(bytes, 0) != TRACE_QUALIFICATION_MAGIC_V1 or
            trace_qualification_read_word_v1(bytes, 8) != 1 or
            trace_qualification_read_word_v1(bytes, 16) != 480):
        return Err(TraceFailureV1.InvalidArgument)
    for index in 96..128:
        if bytes[index] != 0: return Err(TraceFailureV1.InvalidArgument)
    var digests: [[u8]] = []
    for index in 0..TRACE_QUALIFICATION_DIGEST_COUNT_V1:
        var digest: [u8] = []
        for byte in 0..32: digest.push(bytes[128 + index * 32 + byte])
        digests.push(digest)
    val record = TraceQualificationRecordV1(target: trace_qualification_read_word_v1(bytes, 24),
        profile: trace_qualification_read_word_v1(bytes, 32),
        evidence_mask: trace_qualification_read_word_v1(bytes, 40),
        max_contexts: trace_qualification_read_word_v1(bytes, 48),
        buffer_bytes: trace_qualification_read_word_v1(bytes, 56),
        resident_bytes: trace_qualification_read_word_v1(bytes, 64),
        max_generations: trace_qualification_read_word_v1(bytes, 72),
        metadata_reserve: trace_qualification_read_word_v1(bytes, 80),
        word_bytes: trace_qualification_read_word_v1(bytes, 88), digests: digests)
    trace_qualification_record_validate_shape_v1(record)?
    Ok(record)

pub fn trace_qualification_record_encode_v1(record: TraceQualificationRecordV1
        ) -> Result<[u8], TraceFailureV1>:
    trace_qualification_record_validate_shape_v1(record)?
    val header: [u64] = [TRACE_QUALIFICATION_MAGIC_V1, 1u64, 480u64,
        record.target, record.profile, record.evidence_mask, record.max_contexts,
        record.buffer_bytes, record.resident_bytes, record.max_generations,
        record.metadata_reserve, record.word_bytes, 0u64, 0u64, 0u64, 0u64]
    var bytes: [u8] = []
    for word in header:
        for index in 0..8: bytes.push(((word >> (index * 8)) & 255u64) as u8)
    for digest in record.digests:
        for byte in digest: bytes.push(byte)
    Ok(bytes)
