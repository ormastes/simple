# Serial-owner reference state machine; NOT a TraceObserverV1 provider.
# The state is a caller-owned value (no module globals): whoever holds the
# `var` model is the single serialized owner, and nothing is shared between
# threads. Hook leases model admitted work, not OS-thread synchronization. No executable memory is touched
# and these operations do not qualify any target, ABI profile, or native hook.
# Production adapters must add map/profile admission and effectful activation.
use std.common.trace.observer_contract_v1.*
use std.common.trace.observer_config_v1.{trace_config_validate_v1}
use std.common.trace.observer_collector_v1.*

const TRACE_REFERENCE_MAX_RESIDENT_V1: u64 = 1024
const TRACE_REFERENCE_MAX_SITES_V1: i64 = 4096
const TRACE_REFERENCE_ID_MAX_V1: u64 = 18446744073709551615u64

pub struct TraceReferenceLeaseV1:
    session: TraceSessionV1
    context_id: u64
    lease_id: u64

# Resident selection identities are never deleted, even on logical release.
# They model retained bindings; they do not own or claim mapped native code.
pub struct TraceReferenceModelV1:
    resident: [TraceSelectionV1]
    incarnation: u64
    prepared: bool
    live: bool
    state: TraceSessionStateV1
    collector: [TraceReferenceCollectorV1]
    contexts: [u64]
    leases: [u64]
    next_lease: u64
    context_limit: u64
    event_mask: u64
    last_now: u64

impl TraceReferenceModelV1:
    static fn create() -> TraceReferenceModelV1:
        TraceReferenceModelV1(resident: [], incarnation: 0, prepared: false, live: false,
            state: TraceSessionStateV1.Drained, collector: [], contexts: [], leases: [],
            next_lease: 1, context_limit: 0, event_mask: 0, last_now: 0)

    fn valid(session: TraceSessionV1) -> bool:
        (self.live and session.slot == 1 and session.incarnation == self.incarnation and
            session.generation == self.incarnation)

    fn lease_index(lease: TraceReferenceLeaseV1) -> i64:
        if not self.valid(lease.session): return -1
        for index in 0..self.leases.len():
            if (self.leases[index] == lease.lease_id and
                    self.contexts[index] == lease.context_id):
                return index
        -1

    fn resident_generations() -> u64:
        self.resident.len().to_u64()

    me prepare(config: TraceConfigV1, selection: TraceSelectionV1
        ) -> Result<TracePreparedV1, TraceFailureV1>:
        if self.live or self.prepared: return Err(TraceFailureV1.Busy)
        trace_config_validate_v1(config)?
        if config.instrumentation == TraceInstrumentationV1.Off:
            return Err(TraceFailureV1.InstrumentationAbsent)
        if (config.consistency != TraceConsistencyV1.RawEdges or (config.event_mask & 256u64) != 0 or
                config.patch_mode != TracePatchModeV1.Quiescent):
            return Err(TraceFailureV1.UnsupportedConsistency)
        if (config.max_resident_generations > TRACE_REFERENCE_MAX_RESIDENT_V1 or
                self.resident.len().to_u64() >= config.max_resident_generations or
                config.buffer_bytes / TRACE_OBSERVER_EVENT_BYTES_V1 > TRACE_REFERENCE_MAX_RECORDS_V1.to_u64() or
                config.max_contexts > TRACE_REFERENCE_MAX_CONTEXTS_V1.to_u64()):
            return Err(TraceFailureV1.ResourceExhausted)
        if (selection.manifest_incarnation == 0 or selection.sites.len() == 0 or
                selection.sites.len() > TRACE_REFERENCE_MAX_SITES_V1):
            return Err(TraceFailureV1.InvalidMap)
        for index in 0..selection.sites.len():
            val site = selection.sites[index]
            if site.module_instance == 0 or site.site_id == 0:
                return Err(TraceFailureV1.InvalidMap)
            for earlier in 0..index:
                val previous = selection.sites[earlier]
                if previous.module_instance == site.module_instance and previous.site_id == site.site_id:
                    return Err(TraceFailureV1.InvalidMap)
        if self.incarnation == TRACE_REFERENCE_ID_MAX_V1:
            return Err(TraceFailureV1.ResourceExhausted)
        val incarnation = self.incarnation + 1u64
        val capacity = config.buffer_bytes / TRACE_OBSERVER_EVENT_BYTES_V1
        val collector = TraceReferenceCollectorV1.create(incarnation,
            capacity.to_i64(), config.max_contexts.to_i64())?
        # Commit only after validation/allocation succeeds; no partial preparation.
        self.collector = [collector]
        self.resident.push(selection)
        self.incarnation = incarnation
        self.context_limit = config.max_contexts
        self.event_mask = config.event_mask
        self.contexts = []
        self.leases = []
        self.next_lease = 1
        self.last_now = 0
        self.prepared = true
        Ok(TracePreparedV1(slot: 1, incarnation: incarnation))

    me start(prepared: TracePreparedV1
        ) -> Result<TraceSessionV1, TraceFailureV1>:
        if self.live: return Err(TraceFailureV1.Busy)
        if not self.prepared or prepared.slot != 1 or prepared.incarnation != self.incarnation:
            return Err(TraceFailureV1.InvalidHandle)
        self.prepared = false
        self.live = true
        self.state = TraceSessionStateV1.Active
        Ok(TraceSessionV1(slot: 1, incarnation: self.incarnation, generation: self.incarnation))

    me begin_hook(session: TraceSessionV1, context_id: u64
        ) -> Result<TraceReferenceLeaseV1, TraceFailureV1>:
        if not self.valid(session): return Err(TraceFailureV1.InvalidHandle)
        if self.state != TraceSessionStateV1.Active: return Err(TraceFailureV1.Busy)
        if context_id == 0: return Err(TraceFailureV1.InvalidArgument)
        for current in self.contexts:
            if current == context_id:
                var collector = self.collector[0]
                collector.count_loss()
                self.collector[0] = collector
                return Err(TraceFailureV1.Busy)
        if (self.leases.len().to_u64() >= self.context_limit or
                self.next_lease == TRACE_REFERENCE_ID_MAX_V1):
            return Err(TraceFailureV1.ResourceExhausted)
        val lease = TraceReferenceLeaseV1(session: session, context_id: context_id,
            lease_id: self.next_lease)
        self.next_lease = self.next_lease + 1u64
        self.contexts.push(context_id)
        self.leases.push(lease.lease_id)
        Ok(lease)

    me record(lease: TraceReferenceLeaseV1, event: TraceEventV1
        ) -> Result<bool, TraceFailureV1>:
        if self.lease_index(lease) < 0: return Err(TraceFailureV1.InvalidHandle)
        if self.state == TraceSessionStateV1.Faulted: return Err(TraceFailureV1.BackendFailure)
        if event.context_id != lease.context_id or event.generation != lease.session.generation:
            return Err(TraceFailureV1.InvalidArgument)
        val selection = self.resident[self.resident.len() - 1]
        var selected = false
        for site in selection.sites:
            if site.module_instance == event.module_instance and site.site_id == event.site_id:
                selected = true
                break
        val code = trace_event_kind_code_v1(event.kind)
        if code <= 3:
            if not selected: return Err(TraceFailureV1.InvalidMap)
            val bit = 1u64 << (code.to_u64() - 1u64)
            if (self.event_mask & bit) == 0: return Ok(false)
        var collector = self.collector[0]
        val result = collector.record(event)
        self.collector[0] = collector
        result

    me end_hook(lease: TraceReferenceLeaseV1
        ) -> Result<bool, TraceFailureV1>:
        val index = self.lease_index(lease)
        if index < 0: return Err(TraceFailureV1.InvalidHandle)
        var contexts: [u64] = []
        var leases: [u64] = []
        for current in 0..self.leases.len():
            if current != index:
                contexts.push(self.contexts[current])
                leases.push(self.leases[current])
        self.contexts = contexts
        self.leases = leases
        Ok(true)

    me request_stop(session: TraceSessionV1
        ) -> Result<TraceSessionStateV1, TraceFailureV1>:
        if not self.valid(session): return Err(TraceFailureV1.InvalidHandle)
        if self.state == TraceSessionStateV1.Active:
            self.state = TraceSessionStateV1.Draining
        Ok(self.state)

    me poll(session: TraceSessionV1, max_records: u32
        ) -> Result<TraceBatchV1, TraceFailureV1>:
        if not self.valid(session): return Err(TraceFailureV1.InvalidHandle)
        var collector = self.collector[0]
        val events = collector.poll(max_records)
        self.collector[0] = collector
        Ok(TraceBatchV1(events: events, state: self.state))

    # One bounded progress check with an injected monotonic clock. A production
    # drain waits/polls outside hooks; this reference never spins or sleeps. A
    # caller_context matching an issued hook is rejected before inspecting time.
    me drain_once(session: TraceSessionV1, caller_context: u64,
            now_ns: u64, deadline_ns: u64) -> Result<TraceDrainV1, TraceFailureV1>:
        if not self.valid(session): return Err(TraceFailureV1.InvalidHandle)
        for context in self.contexts:
            if context == caller_context: return Err(TraceFailureV1.Busy)
        if self.state == TraceSessionStateV1.Faulted: return Err(TraceFailureV1.BackendFailure)
        if self.state == TraceSessionStateV1.Active: return Err(TraceFailureV1.Busy)
        if now_ns < self.last_now: return Err(TraceFailureV1.InvalidArgument)
        self.last_now = now_ns
        val collector = self.collector[0]
        if self.leases.len() == 0 and collector.pending() == 0:
            self.state = TraceSessionStateV1.Drained
            return Ok(TraceDrainV1(state: self.state, stats: collector.stats()))
        if now_ns >= deadline_ns: return Err(TraceFailureV1.TimedOut)
        Ok(TraceDrainV1(state: TraceSessionStateV1.Draining, stats: collector.stats()))

    fn stats(session: TraceSessionV1
        ) -> Result<TraceStatsV1, TraceFailureV1>:
        if not self.valid(session): return Err(TraceFailureV1.InvalidHandle)
        val collector = self.collector[0]
        Ok(collector.stats())

    # Delivery is performed by poll. This bounded flush check never discards queued
    # records and does not stop an active capture or manufacture delivery evidence.
    me flush_once(session: TraceSessionV1, caller_context: u64,
            now_ns: u64, deadline_ns: u64) -> Result<TraceStatsV1, TraceFailureV1>:
        if not self.valid(session): return Err(TraceFailureV1.InvalidHandle)
        for context in self.contexts:
            if context == caller_context: return Err(TraceFailureV1.Busy)
        if self.state == TraceSessionStateV1.Faulted: return Err(TraceFailureV1.BackendFailure)
        if now_ns < self.last_now: return Err(TraceFailureV1.InvalidArgument)
        self.last_now = now_ns
        val collector = self.collector[0]
        if collector.pending() == 0: return Ok(collector.stats())
        if now_ns >= deadline_ns: return Err(TraceFailureV1.TimedOut)
        Err(TraceFailureV1.Busy)

    me fault(session: TraceSessionV1
        ) -> Result<TraceSessionStateV1, TraceFailureV1>:
        if not self.valid(session): return Err(TraceFailureV1.InvalidHandle)
        self.state = TraceSessionStateV1.Faulted
        var collector = self.collector[0]
        collector.count_backend_error()
        self.collector[0] = collector
        Ok(self.state)

    me release(session: TraceSessionV1) -> Result<bool, TraceFailureV1>:
        if not self.valid(session): return Err(TraceFailureV1.InvalidHandle)
        if self.state != TraceSessionStateV1.Drained: return Err(TraceFailureV1.Busy)
        self.live = false
        # Only the delivered record buffer is freed. Resident identities remain;
        # there is no provider/code/map unloading or generation-budget recycling.
        self.collector = []
        Ok(true)
