# ============================================================================
# common/trace/data/data_observation_aggregator_v1.spl — bounded per-worker
# numeric aggregation of data observations under the V1 trace facade
# lifecycle (plan W5, sections 10.3-10.7).
#
# One aggregator per worker; the worker is its single serialized owner, so
# nothing is shared and no lock exists (lockless by default). Workers' drained
# records merge with data_observation_merge_v1 outside any hook.
#
# Lifecycle mirrors TraceObserverV1: prepare(config, selection) -> start(gen)
# -> record* -> stop/resume -> drain. Data sites exist only when the compiled
# module carries a data-site manifest (`--xray` static switch: absent means no
# manifest and every selection fails with InstrumentationAbsent). Which sites
# record is chosen at runtime by the aspect-param selection
# (TraceSelectionV1), never by build configuration.
#
# Counts never silently become zero: an unselected site yields no record, a
# selected site that never fired yields a measured zero, saturation yields
# Overflowed, a refused observation yields Dropped and is counted as loss.
# Records are a separate family from TraceEventV1 (see
# data_observation_contracts.spl); the 96-byte edge channel is not used for
# them because its admission gate (and its C twin) accept V1 kinds only.
# Status: this is the aggregation and lifecycle contract. No compiled hook
# calls record() yet: data sites are generated by W2 (AttrRead/AttrWrite),
# and the provider adapter that owns these aggregators per worker comes with
# the native W5/W6 lane.
# ============================================================================

use std.common.trace.observer_contract_v1.*
use std.common.trace.data.data_observation_contracts.*

pub const DATA_AGGREGATOR_MAX_SITES_V1: i64 = 4096
const DATA_AGGREGATOR_U64_MAX_V1: u64 = 18446744073709551615u64

# One cold manifest row: what a compiled data site observes.
pub struct DataSiteV1:
    site_id: u32
    kind: DataObservationKindV1
    schema_index: u32
    attr_ordinal: u32
    op: DataCollectionOpV1

pub struct DataSiteManifestV1:
    module_instance: u64
    manifest_incarnation: u64
    sites: [DataSiteV1]

pub struct DataDrainV1:
    records: [DataObservationV1]
    stats: TraceStatsV1
    # false when any loss, saturation or activation gap was observed.
    complete: bool

fn data_probe_v1(site: DataSiteV1, module_instance: u64) -> DataObservationV1:
    DataObservationV1(kind: site.kind, generation: 1, module_instance: module_instance,
        site_id: site.site_id, schema_index: site.schema_index, attr_ordinal: site.attr_ordinal,
        op: site.op, count: data_metric_measured_v1(0), aux: data_metric_not_measured_v1(),
        representation_epoch: 0)

fn data_next_counter_v1(value: u64) -> u64:
    if value == DATA_AGGREGATOR_U64_MAX_V1: value else: value + 1u64

fn data_metric_add_v1(metric: DataMetricV1, delta: u64) -> DataMetricV1:
    match metric.state:
        case DataMetricStateV1.Measured:
            if metric.value > DATA_AGGREGATOR_U64_MAX_V1 - delta:
                data_metric_overflowed_v1()
            else:
                data_metric_measured_v1(metric.value + delta)
        case DataMetricStateV1.NotMeasured: data_metric_measured_v1(delta)
        case _: metric

# Incompleteness dominates: Overflowed > Dropped > Unsupported. Two measured
# sides sum (saturating). One measured and one unmeasured side is partial
# coverage, reported as Dropped rather than as a complete-looking sum; two
# unmeasured sides stay NotMeasured.
pub fn data_metric_merge_v1(a: DataMetricV1, b: DataMetricV1) -> DataMetricV1:
    val ca = data_metric_state_code_v1(a.state)
    val cb = data_metric_state_code_v1(b.state)
    if ca == 5 or cb == 5: return data_metric_overflowed_v1()
    if ca == 4 or cb == 4: return data_metric_dropped_v1()
    if ca == 3 or cb == 3: return data_metric_unsupported_v1()
    if ca == 2 and cb == 2: return data_metric_not_measured_v1()
    if ca == 2 or cb == 2: return data_metric_dropped_v1()
    data_metric_add_v1(a, b.value)

pub fn data_observation_merge_v1(a: DataObservationV1, b: DataObservationV1) -> Result<DataObservationV1, text>:
    if (data_observation_kind_code_v1(a.kind) != data_observation_kind_code_v1(b.kind) or
            a.generation != b.generation or a.module_instance != b.module_instance or
            a.site_id != b.site_id or a.schema_index != b.schema_index or
            a.attr_ordinal != b.attr_ordinal or
            data_collection_op_code_v1(a.op) != data_collection_op_code_v1(b.op) or
            a.representation_epoch != b.representation_epoch):
        return Err("observations of different sites, generations or epochs never merge")
    var merged = a
    merged.count = data_metric_merge_v1(a.count, b.count)
    merged.aux = data_metric_merge_v1(a.aux, b.aux)
    Ok(merged)

pub class DataObservationAggregatorV1:
    manifest: DataSiteManifestV1
    # site_id -> table index, built once in create; record() is O(1).
    site_slots: Dict<i64, i64>
    prepared: bool
    active: bool
    drained: bool
    generation: u64
    selected: [bool]
    ever_selected: [bool]
    counts: [DataMetricV1]
    aux: [DataMetricV1]
    recorded: u64
    lost: u64
    transitions: u64
    saturated: bool

impl DataObservationAggregatorV1:
    static fn create(manifest: DataSiteManifestV1) -> Result<DataObservationAggregatorV1, TraceFailureV1>:
        if manifest.module_instance == 0 or manifest.manifest_incarnation == 0:
            return Err(TraceFailureV1.InvalidArgument)
        if manifest.sites.len() > DATA_AGGREGATOR_MAX_SITES_V1:
            return Err(TraceFailureV1.ResourceExhausted)
        # Four independent tables; never share one array between fields.
        var selected: [bool] = []
        var ever: [bool] = []
        var counts: [DataMetricV1] = []
        var aux: [DataMetricV1] = []
        var slots: Dict<i64, i64> = {}
        for i in 0..manifest.sites.len():
            val site = manifest.sites[i]
            if site.site_id == 0 or not data_observation_valid_v1(data_probe_v1(site, manifest.module_instance)):
                return Err(TraceFailureV1.InvalidMap)
            if slots.contains_key(site.site_id as i64):
                return Err(TraceFailureV1.InvalidMap)
            slots[site.site_id as i64] = i
            selected.push(false)
            ever.push(false)
            counts.push(data_metric_not_measured_v1())
            aux.push(data_metric_not_measured_v1())
        Ok(DataObservationAggregatorV1(manifest: manifest, site_slots: slots, prepared: false, active: false,
            drained: false, generation: 0, selected: selected, ever_selected: ever,
            counts: counts, aux: aux, recorded: 0, lost: 0, transitions: 0, saturated: false))

    fn site_index(site_id: u32) -> i64:
        val key = site_id as i64
        if self.site_slots.contains_key(key): self.site_slots[key] else: -1

    # Validates the whole selection before changing anything.
    me apply_selection(selection: TraceSelectionV1) -> Result<bool, TraceFailureV1>:
        if self.manifest.sites.len() == 0:
            return Err(TraceFailureV1.InstrumentationAbsent)
        if selection.manifest_incarnation != self.manifest.manifest_incarnation:
            return Err(TraceFailureV1.InvalidMap)
        var wanted: [bool] = []
        for i in 0..self.manifest.sites.len():
            wanted.push(false)
        for site in selection.sites:
            if site.module_instance != self.manifest.module_instance:
                return Err(TraceFailureV1.InvalidMap)
            val index = self.site_index(site.site_id)
            if index < 0:
                return Err(TraceFailureV1.InvalidMap)
            wanted[index] = true
        for i in 0..wanted.len():
            if wanted[i] and not self.ever_selected[i]:
                self.ever_selected[i] = true
                self.counts[i] = data_metric_measured_v1(0)
            self.selected[i] = wanted[i]
        Ok(true)

    me prepare(config: TraceConfigV1, selection: TraceSelectionV1) -> Result<bool, TraceFailureV1>:
        if self.prepared or self.drained:
            return Err(TraceFailureV1.Busy)
        if config.instrumentation == TraceInstrumentationV1.Off:
            return Err(TraceFailureV1.InstrumentationAbsent)
        if config.consistency == TraceConsistencyV1.PairedSpans:
            return Err(TraceFailureV1.UnsupportedConsistency)
        self.apply_selection(selection)?
        self.prepared = true
        Ok(true)

    me start(generation: u64) -> Result<bool, TraceFailureV1>:
        if generation == 0:
            return Err(TraceFailureV1.InvalidArgument)
        if not self.prepared or self.drained or self.generation != 0:
            return Err(TraceFailureV1.InvalidHandle)
        self.generation = generation
        self.active = true
        Ok(true)

    # Runtime switch: closes admission. A later resume marks an activation
    # gap; the drain then reports itself incomplete.
    me stop():
        if self.active:
            self.active = false
            self.transitions = data_next_counter_v1(self.transitions)

    me resume() -> Result<bool, TraceFailureV1>:
        if self.generation == 0 or self.drained:
            return Err(TraceFailureV1.InvalidHandle)
        if not self.active:
            self.active = true
            self.transitions = data_next_counter_v1(self.transitions)
        Ok(true)

    # Aspect params may move the selection only while stopped.
    me reselect(selection: TraceSelectionV1) -> Result<bool, TraceFailureV1>:
        if self.active:
            return Err(TraceFailureV1.Busy)
        if self.drained or not self.prepared:
            return Err(TraceFailureV1.InvalidHandle)
        self.apply_selection(selection)

    # Hot path: numeric, bounded, no allocation beyond the fixed table.
    # false = not admitted (inactive or unselected); never counted as loss.
    me record(site_id: u32, delta: u64) -> bool:
        if not self.active:
            return false
        val index = self.site_index(site_id)
        if index < 0 or not self.selected[index]:
            return false
        val next = data_metric_add_v1(self.counts[index], delta)
        if data_metric_state_code_v1(next.state) == 5:
            self.saturated = true
        self.counts[index] = next
        self.recorded = data_next_counter_v1(self.recorded)
        true

    me record_aux(site_id: u32, delta: u64) -> bool:
        if not self.active:
            return false
        val index = self.site_index(site_id)
        if index < 0 or not self.selected[index]:
            return false
        self.aux[index] = data_metric_add_v1(self.aux[index], delta)
        true

    me record_aux_unsupported(site_id: u32):
        val index = self.site_index(site_id)
        if self.active and index >= 0 and self.selected[index]:
            self.aux[index] = data_metric_unsupported_v1()

    # An admitted observation that could not be kept (e.g. a busy hook).
    me record_dropped(site_id: u32):
        val index = self.site_index(site_id)
        if self.active and index >= 0 and self.selected[index]:
            if data_metric_state_code_v1(self.counts[index].state) != 5:
                self.counts[index] = data_metric_dropped_v1()
            self.lost = data_next_counter_v1(self.lost)

    me drain() -> Result<DataDrainV1, TraceFailureV1>:
        if self.generation == 0 or self.drained:
            return Err(TraceFailureV1.InvalidHandle)
        self.active = false
        self.drained = true
        var records: [DataObservationV1] = []
        var unsupported: u64 = 0
        for i in 0..self.manifest.sites.len():
            if self.ever_selected[i]:
                if data_metric_state_code_v1(self.aux[i].state) == 3:
                    unsupported = data_next_counter_v1(unsupported)
                val site = self.manifest.sites[i]
                records.push(DataObservationV1(kind: site.kind, generation: self.generation,
                    module_instance: self.manifest.module_instance, site_id: site.site_id,
                    schema_index: site.schema_index, attr_ordinal: site.attr_ordinal, op: site.op,
                    count: self.counts[i], aux: self.aux[i],
                    # One representation per session until W3 introduces epochs.
                    representation_epoch: 0))
        val stats = TraceStatsV1(generation: self.generation, recorded: self.recorded, lost: self.lost,
            transitions: self.transitions, unsupported_sites: unsupported, queue_high_water: 0, backend_errors: 0)
        Ok(DataDrainV1(records: records, stats: stats,
            complete: self.lost == 0 and self.transitions == 0 and not self.saturated))
