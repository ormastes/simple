# Sole public admission authority for the resident provider. Runtime readiness
# and a caller's profile/patch-mode values are not qualification evidence.
use std.common.trace.observer_contract_v1.*

pub fn trace_resident_capabilities_v1() -> TraceCapabilitiesV1:
    TraceCapabilitiesV1(backend: TraceBackendV1.None, target: "unqualified",
        abi_profiles: [], event_mask: 0, live_patching: false, paired_spans: false,
        instrumentation_present: false, max_buffer_bytes: 0, max_contexts: 0,
        max_depth: 0, max_resident_generations: 0,
        diagnostic: "resident provider admission closed: metadata, ABI, allocator, runtime integration and quiescent handoff unqualified")

pub fn trace_resident_require_qualified_v1() -> Result<bool, TraceFailureV1>:
    val capability = trace_resident_capabilities_v1()
    if capability.backend == TraceBackendV1.None or capability.abi_profiles.len() == 0:
        return Err(TraceFailureV1.UnsupportedProfile)
    # Changing advertised capabilities alone cannot admit activation. There
    # is no runtime-owned qualification receipt consumer implemented yet.
    Err(TraceFailureV1.UnsupportedProfile)
