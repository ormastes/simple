# Work duration is independent of finite ownership, liveness and cleanup leases.
pub fn builder_work_deadline_v1(started_ms: i64, timeout_ms: i64) -> i64:
    if timeout_ms == 0: 0 else: started_ms + timeout_ms

pub fn builder_work_deadline_expired_v1(now_ms: i64, deadline_ms: i64) -> bool:
    deadline_ms != 0 and now_ms >= deadline_ms
