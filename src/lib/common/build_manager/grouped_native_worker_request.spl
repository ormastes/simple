# Pure grouped-worker request protocol. The parent must not import the worker
# executable and its loader/JIT closure merely to encode a request.
use std.common.build_manager.codec.{BuilderWireReaderV1, builder_wire_line_v1}
use std.common.build_manager.contracts.{builder_digest_valid_v1, builder_identifier_valid_v1}

struct NativeGroupWorkerRequestV1:
    producer: text
    producer_digest: text
    group_manifest: text
    manifest_digest: text
    group_result: text
    source_root: text
    entry_source: text
    index_read_root: text
    run_id: text
    output_root: text
    backend: text
    threads: i64
    target: text
    timeout_ms: i64

fn native_group_worker_absolute_v1(path: text) -> bool:
    path.starts_with("/") or (path.len() > 2 and path[1:2] == ":" and
        (path[2:3] == "/" or path[2:3] == "\\"))

fn native_group_worker_parent_v1(path: text) -> text:
    val normalized = path.replace("\\", "/")
    val parts = normalized.split("/")
    if parts.len() <= 1: return ""
    parts[0:parts.len() - 1].join("/")

fn native_group_worker_request_valid_v1(request: NativeGroupWorkerRequestV1) -> text:
    if not builder_digest_valid_v1(request.producer_digest) or not builder_digest_valid_v1(request.manifest_digest):
        return "worker input digest invalid"
    if not builder_identifier_valid_v1(request.run_id):
        return "worker run identity invalid"
    for path in [request.producer, request.group_manifest, request.group_result,
            request.source_root, request.entry_source, request.index_read_root,
            request.output_root]:
        if not native_group_worker_absolute_v1(path) or path.contains("\0"):
            return "worker path must be absolute"
    val source = request.source_root.replace("\\", "/").lower()
    val entry = request.entry_source.replace("\\", "/").lower()
    if not entry.starts_with(source + "/") or
            native_group_worker_parent_v1(request.group_manifest).lower() !=
                native_group_worker_parent_v1(request.group_result).lower():
        return "worker entry or result root differs"
    val output = request.output_root.replace("\\", "/").lower()
    val attempt = native_group_worker_parent_v1(request.group_result).lower()
    if output == source or output.starts_with(source + "/") or
            source.starts_with(output + "/") or
            output == attempt or output.starts_with(attempt + "/") or
            attempt.starts_with(output + "/"):
        return "worker output root overlaps source or attempt"
    if request.backend != "llvm" and request.backend != "cranelift": return "worker backend invalid"
    if request.threads < 1 or request.threads > 256: return "worker thread bound invalid"
    if request.target == "" or request.target.contains("\0"): return "worker target invalid"
    if request.timeout_ms < 0 or request.timeout_ms > 86400000: return "worker timeout invalid"
    ""

fn native_group_worker_request_encode_v1(request: NativeGroupWorkerRequestV1) -> text:
    if native_group_worker_request_valid_v1(request) != "": return ""
    var payload = "SIMPLE-NATIVE-GROUP-WORKER-1\n"
    for field in [request.producer, request.producer_digest, request.group_manifest,
            request.manifest_digest, request.group_result, request.source_root,
            request.entry_source, request.index_read_root,
            request.run_id, request.output_root,
            request.backend, str(request.threads), request.target, str(request.timeout_ms)]:
        payload = payload + builder_wire_line_v1(field)
    payload

fn native_group_worker_request_decode_v1(payload: text) -> Result<NativeGroupWorkerRequestV1, text>:
    if payload.len() > 65536: return Err("worker request exceeds bound")
    var reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-NATIVE-GROUP-WORKER-1": return Err("worker request header differs")
    val request = NativeGroupWorkerRequestV1(reader.scalar(), reader.scalar(), reader.scalar(),
        reader.scalar(), reader.scalar(), reader.scalar(), reader.scalar(), reader.scalar(),
        reader.scalar(), reader.scalar(),
        reader.scalar(),
        reader.number(256, false), reader.scalar(), reader.number(86400000, false))
    if reader.complete_error() != "": return Err(reader.reason)
    if native_group_worker_request_encode_v1(request) != payload: return Err("worker request noncanonical")
    Ok(request)

export NativeGroupWorkerRequestV1
export native_group_worker_absolute_v1, native_group_worker_parent_v1
export native_group_worker_request_valid_v1, native_group_worker_request_encode_v1
export native_group_worker_request_decode_v1
