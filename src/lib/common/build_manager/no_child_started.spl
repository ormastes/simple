# Distinct from a reaped process tree: the native admission owner certifies that
# it rejected this request strictly before any CreateProcess attempt.
use std.common.build_manager.contracts.{builder_digest_valid_v1, builder_identifier_valid_v1, builder_text_valid_v1}
use std.common.build_manager.codec.{BuilderWireReaderV1, builder_wire_line_v1}

struct BuilderNoChildStartedV1:
    identity_digest: text
    host_id: text
    reason: text

fn builder_no_child_started_encode_v1(value: BuilderNoChildStartedV1) -> text:
    if not builder_digest_valid_v1(value.identity_digest) or not builder_identifier_valid_v1(value.host_id): return ""
    if value.reason == "" or not builder_text_valid_v1(value.reason): return ""
    "SIMPLE-NO-CHILD-STARTED-1\n" + builder_wire_line_v1(value.identity_digest) + builder_wire_line_v1(value.host_id) + builder_wire_line_v1(value.reason)

fn builder_no_child_started_decode_v1(payload: text) -> Result<BuilderNoChildStartedV1, text>:
    var reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-NO-CHILD-STARTED-1": return Err("invalid no-child-started header")
    val identity = reader.scalar()
    val host = reader.scalar()
    val reason = reader.scalar()
    val result = BuilderNoChildStartedV1(identity, host, reason)
    if reader.reason != "": return Err(reader.reason)
    if builder_no_child_started_encode_v1(result) != payload: return Err("invalid or noncanonical no-child-started receipt")
    Ok(result)

export BuilderNoChildStartedV1, builder_no_child_started_encode_v1, builder_no_child_started_decode_v1
