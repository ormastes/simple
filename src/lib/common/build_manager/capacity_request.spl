# Host-bound authority to acquire a fresh platform-owned task boundary.
# This transport sidecar does not change the compiler task/cache identity.
use std.common.build_manager.contracts.{builder_digest_valid_v1, builder_identifier_valid_v1}
use std.common.build_manager.codec.{BuilderWireReaderV1, builder_wire_line_v1}

struct BuilderCapacityRequestV1:
    identity_digest: text
    host_id: text
    policy: text

struct BuilderLinuxParentReceiptV1:
    identity_digest: text
    host_id: text
    path: text
    device: i64
    inode: i64

fn builder_capacity_request_encode_v1(value: BuilderCapacityRequestV1) -> text:
    if not builder_digest_valid_v1(value.identity_digest) or
            not builder_identifier_valid_v1(value.host_id) or
            value.policy != "owned-platform-boundary-v1": return ""
    "SIMPLE-CAPACITY-REQUEST-1\n" + builder_wire_line_v1(value.identity_digest) +
        builder_wire_line_v1(value.host_id) + builder_wire_line_v1(value.policy)

fn builder_capacity_request_decode_v1(payload: text,
        identity: text, host: text) -> Result<BuilderCapacityRequestV1, text>:
    var reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-CAPACITY-REQUEST-1": return Err("invalid capacity request header")
    val task_identity = reader.scalar()
    val host_id = reader.scalar()
    val policy = reader.scalar()
    val value = BuilderCapacityRequestV1(task_identity, host_id, policy)
    if reader.reason != "": return Err(reader.reason)
    if builder_capacity_request_encode_v1(value) != payload or
            value.identity_digest != identity or value.host_id != host:
        return Err("capacity request identity, host or policy differs")
    Ok(value)

export BuilderCapacityRequestV1, builder_capacity_request_encode_v1, builder_capacity_request_decode_v1

fn builder_linux_parent_receipt_encode_v1(value: BuilderLinuxParentReceiptV1) -> text:
    if not builder_digest_valid_v1(value.identity_digest) or
            not builder_identifier_valid_v1(value.host_id) or
            value.path != "/sys/fs/cgroup/simple-parent-" + value.identity_digest or
            value.device < 0 or value.device > 99999999999999999 or
            value.inode < 1 or value.inode > 99999999999999999: return ""
    "SIMPLE-LINUX-PARENT-1\n" + builder_wire_line_v1(value.identity_digest) +
        builder_wire_line_v1(value.host_id) + builder_wire_line_v1(value.path) +
        builder_wire_line_v1(str(value.device)) + builder_wire_line_v1(str(value.inode))

fn builder_linux_parent_receipt_decode_v1(payload: text,
        identity: text, host: text) -> Result<BuilderLinuxParentReceiptV1, text>:
    var reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-LINUX-PARENT-1": return Err("invalid Linux parent receipt header")
    val task_identity = reader.scalar()
    val host_id = reader.scalar()
    val path = reader.scalar()
    val device = reader.number(99999999999999999, false)
    val inode = reader.number(99999999999999999, false)
    val value = BuilderLinuxParentReceiptV1(task_identity, host_id, path, device, inode)
    if reader.reason != "": return Err(reader.reason)
    if builder_linux_parent_receipt_encode_v1(value) != payload or
            task_identity != identity or host_id != host:
        return Err("Linux parent receipt identity, host or resource differs")
    Ok(value)

export BuilderLinuxParentReceiptV1, builder_linux_parent_receipt_encode_v1, builder_linux_parent_receipt_decode_v1

struct BuilderCapacitySettlementV1:
    identity_digest: text
    host_id: text
    disposition: text

fn builder_capacity_settlement_encode_v1(value: BuilderCapacitySettlementV1) -> text:
    if not builder_digest_valid_v1(value.identity_digest) or
            not builder_identifier_valid_v1(value.host_id) or
            not ["no-parent-owned", "linux-parent-released", "windows-job-settled"].contains(value.disposition): return ""
    "SIMPLE-CAPACITY-SETTLED-1\n" + builder_wire_line_v1(value.identity_digest) +
        builder_wire_line_v1(value.host_id) + builder_wire_line_v1(value.disposition)

fn builder_capacity_settlement_decode_v1(payload: text, identity: text,
        host: text) -> Result<BuilderCapacitySettlementV1, text>:
    var reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-CAPACITY-SETTLED-1": return Err("missing capacity settlement proof")
    val task_identity = reader.scalar()
    val host_id = reader.scalar()
    val disposition = reader.scalar()
    val value = BuilderCapacitySettlementV1(task_identity, host_id, disposition)
    if reader.reason != "": return Err(reader.reason)
    if builder_capacity_settlement_encode_v1(value) != payload or
            task_identity != identity or host_id != host:
        return Err("capacity settlement identity, host or disposition differs")
    Ok(value)

export BuilderCapacitySettlementV1, builder_capacity_settlement_encode_v1, builder_capacity_settlement_decode_v1
