# Encoded execution metadata only. Scheduling authority stays in the existing
# compiler coordinator/artifact-service bridge; process authority stays native.
struct GroupedActionBindingV1:
    group_id: text
    action_id: text
    phase: text
    snapshot_digest: text
    cache_identity: text
    publishes_package: bool

struct GroupedActionLeaseV1:
    group_id: text
    action_id: text
    worker_id: text
    generation: i64
    lease_id: text
    snapshot_digest: text
    cache_identity: text
    completed: bool

struct GroupedReapReceiptV1:
    group_id: text
    action_id: text
    worker_id: text
    generation: i64
    lease_id: text
    snapshot_digest: text
    cache_identity: text
    tree_receipt_digest: text

export GroupedActionBindingV1, GroupedActionLeaseV1, GroupedReapReceiptV1
