# Static component table generator (Phase B, parallel-plan WP-14s).
#
# Emits a generated static-table module from a component catalog so a FULL
# REBUILD bakes in exactly the statically-resolved components. The fold
# verdict is never decided here: every entry is classified through
# resolve_component (via resolve_component_verdict,
# src/lib/common/structural/component/descriptor.spl), the single
# fail-closed §5.3 decision point — presence=off is ABSENT,
# placement=dynamic NEVER folds, placement=auto folds static only on a
# verified digest match and falls to dynamic on a stale digest.
#
# The generator therefore cannot fold a dynamic component and cannot skip a
# static one without resolve_component itself being wrong; any resolve error
# (missing digest, malformed catalog, duplicate id, bad schema version)
# aborts generation — never a partial table.
#
# Plan: doc/03_plan/compiler/startup_performance/startup_perf_plan_2026-08-17.md (Phase B)
# Parallel plan row: WP-14s, doc/03_plan/agent_tasks/startup_perf_parallel_plan_2026-08-17.md

use std.common.structural.component.descriptor.{
    ComponentDescriptorV1,
    component_descriptor_parse_sdn,
    component_catalog_v1_parse,
    resolve_component_verdict
}

# One folded/external row of the generated table.
struct StaticComponentTableRow:
    id: text
    version: text
    mode: text
    activation: text
    dynload_setting: text

struct StaticComponentTableOutcome:
    ok: bool
    reason: text
    folded: [StaticComponentTableRow]
    dynamic: [StaticComponentTableRow]
    absent: [text]

# Digest triple for one component id, spec-friendly flat text form:
#   "id|embedded_impl_hash|configured_impl_hash"
# Missing id -> empty pair, which resolve_component rejects fail-closed on
# the placement=auto path (missing_impl_digest).
fn static_component_digest_lookup(digests: [text], id: text) -> [text]:
    var out: [text] = []
    var idx = 0
    while idx < digests.len():
        val parts = digests[idx].split("|")
        if parts.len() == 3 and parts[0] == id:
            out.push(parts[1])
            out.push(parts[2])
            return out
        idx = idx + 1
    out

# Generate the table from an already-parsed versioned catalog.
fn static_component_table_generate(catalog: [ComponentDescriptorV1], digests: [text]) -> StaticComponentTableOutcome:
    var folded: [StaticComponentTableRow] = []
    var dyn_rows: [StaticComponentTableRow] = []
    var absent: [text] = []
    var idx = 0
    while idx < catalog.len():
        val id = catalog[idx].body.id
        val version = catalog[idx].body.version
        val dig = static_component_digest_lookup(digests, id)
        var embedded = ""
        var configured = ""
        if dig.len() == 2:
            embedded = dig[0]
            configured = dig[1]
        # Verdict grammar (descriptor.spl): "ok:<mode>:<activation>:<setting>"
        # or "err:<code>"; <setting> is comma key=value, colon-free.
        val verdict = resolve_component_verdict(catalog, id, embedded, configured)
        val parts = verdict.split(":")
        if parts.len() != 4 or parts[0] != "ok":
            return StaticComponentTableOutcome(ok: false, reason: "resolve_failed:" + id + ":" + verdict, folded: folded, dynamic: dyn_rows, absent: absent)
        val row = StaticComponentTableRow(id: id, version: version, mode: parts[1], activation: parts[2], dynload_setting: parts[3])
        if row.mode == "static":
            folded.push(row)
        elif row.mode == "dynamic":
            dyn_rows.push(row)
        elif row.mode == "absent":
            absent.push(id)
        else:
            return StaticComponentTableOutcome(ok: false, reason: "unknown_mode:" + id + ":" + row.mode, folded: folded, dynamic: dyn_rows, absent: absent)
        idx = idx + 1
    StaticComponentTableOutcome(ok: true, reason: "generated", folded: folded, dynamic: dyn_rows, absent: absent)

fn static_component_row_render(row: StaticComponentTableRow) -> text:
    row.id + "|" + row.version + "|" + row.mode + "|" + row.activation + "|" + row.dynload_setting

# Render the generated Simple module source. Folded-static rows are baked
# into static_component_table_entries(); placement=dynamic components are
# NEVER folded — they appear only as external ids in
# static_component_table_dynamic_ids(); absent components appear nowhere.
fn static_component_table_render_module(outcome: StaticComponentTableOutcome) -> text:
    var src = "# GENERATED by static_component_table_generate — DO NOT EDIT.\n"
    src = src + "# Folded-static rows are baked in on full rebuild; dynamic stays external.\n"
    src = src + "fn static_component_table_entries() -> [text]:\n"
    src = src + "    var rows: [text] = []\n"
    var idx = 0
    while idx < outcome.folded.len():
        src = src + "    rows.push(\"" + static_component_row_render(outcome.folded[idx]) + "\")\n"
        idx = idx + 1
    src = src + "    rows\n"
    src = src + "fn static_component_table_dynamic_ids() -> [text]:\n"
    src = src + "    var ids: [text] = []\n"
    idx = 0
    while idx < outcome.dynamic.len():
        src = src + "    ids.push(\"" + outcome.dynamic[idx].id + "\")\n"
        idx = idx + 1
    src = src + "    ids\n"
    src

# --- Spec-facing text verdicts (seed erases cross-module record fields in
# spec files, so specs consume flat text; these are pure projections). ---

fn static_component_ids_join(ids: [text]) -> text:
    var out = ""
    var idx = 0
    while idx < ids.len():
        if out != "":
            out = out + ","
        out = out + ids[idx]
        idx = idx + 1
    out

# "ok:folded=<ids>:dynamic=<ids>:absent=<ids>" or "err:<reason>".
fn static_component_table_verdict(source: text, digests: [text]) -> text:
    val parsed = component_descriptor_parse_sdn(source)
    if not parsed.ok:
        return "err:parse:" + parsed.reason
    val outcome = static_component_table_generate(component_catalog_v1_parse(source), digests)
    if not outcome.ok:
        return "err:" + outcome.reason
    var folded_ids: [text] = []
    var dyn_ids: [text] = []
    var idx = 0
    while idx < outcome.folded.len():
        folded_ids.push(outcome.folded[idx].id)
        idx = idx + 1
    idx = 0
    while idx < outcome.dynamic.len():
        dyn_ids.push(outcome.dynamic[idx].id)
        idx = idx + 1
    "ok:folded=" + static_component_ids_join(folded_ids) + ":dynamic=" + static_component_ids_join(dyn_ids) + ":absent=" + static_component_ids_join(outcome.absent)

# Generated module source for a catalog, or "err:<reason>".
fn static_component_table_module_source(source: text, digests: [text]) -> text:
    val parsed = component_descriptor_parse_sdn(source)
    if not parsed.ok:
        return "err:parse:" + parsed.reason
    val outcome = static_component_table_generate(component_catalog_v1_parse(source), digests)
    if not outcome.ok:
        return "err:" + outcome.reason
    static_component_table_render_module(outcome)
