# ============================================================================
# common/structural/clang/clang_codec.spl — CPU reference serializers
#
# CPU reference codec for the frozen CLANG-AST export contract v1
# (architecture §12.2/§12.6, §26 deliverable "CPU reference
# serializers/deserializers"). This is the ORACLE (shared rule 3): any future
# hybrid/resident or C++-side encoder must produce byte-identical output, and
# the oracle is never deleted.
#
# Layout (little-endian, no padding — see common/structural/wire.spl):
#
#   ClangEntityIdentity  68  envelope(8) | tu_artifact ArtifactId 20
#                            | ast_kind u32 4 | source SourceAnchor 36
#                            | semantic_usr u32 4 | local_ordinal u32 4
#
#   ClangAdapterCapability   envelope(8) | clang_major u16
#                            | ast_export_schema u16
#                            | matcher_adapter_version u16
#                            | transformer_adapter_version u16
#                            | llvm_ir_schema u16 | supported_features u32
#
#   ClangAstExport           envelope(8) | producer_clang_major u32
#                            | tu_artifact ArtifactId 20 | node_count u32
#                            | kind    u32 * n
#                            | parent  u32 * n
#                            | ordinal u32 * n
#                            | flags   u32 * n
#                            | usr     u32 * n
#                            | anchor  SourceAnchor(36) * n
#
# The export is COLUMN-MAJOR on the wire, not a row of interleaved node
# records. One `node_count` governs six parallel columns, the same shape the
# MAP lane's CSR shard uses, so a C1/C2 consumer can transfer a single column
# without a strided gather. The general "u32 count then elements" rule is
# preserved: there is exactly one count and it precedes every column.
#
# HARD REJECTS, never a silent default:
#   - wrong magic, wrong version, non-zero envelope reserved;
#   - a producer_clang_major outside the supported set (§12.6: "Reject unknown
#     majors rather than silently assuming ABI compatibility");
#   - a node flags word with a reserved bit set;
#   - a parent index that is not CLANG_ABSENT_ID and not strictly less than the
#     child index (preorder invariant — this is the check that makes a
#     corrupted arena fail loudly instead of silently reparenting a node);
#   - a declared node_count that does not exactly consume the buffer;
#   - trailing bytes after the record.
#
# NOTE on ClangAdapterCapability: a capability record describing an unsupported
# Clang major DECODES successfully and is REJECTED by
# `clang_capability_decide`, which returns a reason receipt. Those are
# deliberately separate: you must be able to read a foreign adapter's
# advertisement in order to say why you will not use it. Refusing to decode it
# would produce exactly the silent, reasonless fallback shared rule 4 forbids.
# The export record has no such split — there is no useful "read it to reject
# it" step for a payload you cannot interpret.
# ============================================================================

use std.common.structural.wire.{
    WIRE_ENVELOPE_LEN,
    wire_check_envelope,
    wire_get_u16,
    wire_get_u32,
    wire_has,
    wire_magic,
    wire_put_envelope,
    wire_put_u16,
    wire_put_u32
}
use std.common.structural.identity.entity_id.{
    ARTIFACT_ID_LEN,
    SOURCE_ANCHOR_LEN,
    SourceAnchor
}
use std.common.structural.identity.identity_codec.{
    artifact_id_put,
    artifact_id_read,
    source_anchor_put,
    source_anchor_read
}
use std.common.structural.clang.clang_types.{
    CLANG_ADAPTER_CAPABILITY_LEN,
    CLANG_AST_EXPORT_HEADER_LEN,
    CLANG_AST_NODE_LEN,
    CLANG_ENTITY_IDENTITY_LEN,
    CLANG_SCHEMA_VERSION,
    ClangAdapterCapability,
    ClangAstExport,
    ClangEntityIdentity,
    clang_adapter_capability,
    clang_ast_export,
    clang_empty_export,
    clang_entity_identity,
    clang_export_valid,
    clang_major_supported,
    clang_zero_artifact,
    clang_zero_capability,
    clang_zero_identity
}

fn clang_magic_entity_identity() -> i64:
    wire_magic("SCEI")

fn clang_magic_adapter_capability() -> i64:
    wire_magic("SCAP")

fn clang_magic_ast_export() -> i64:
    wire_magic("SCAX")

# ----------------------------------------------------------------------------
# Result carriers — same shape as the ID-TAG and MAP lanes', so a caller that
# already handles an EntityKeyResult handles these without a new idiom. An `ok`
# flag rather than an Option, because Option lowering differs across this
# repo's execution engines (ID-TAG conventions §2.3).
# ----------------------------------------------------------------------------

struct ClangEntityIdentityResult:
    ok: bool
    value: ClangEntityIdentity

struct ClangAdapterCapabilityResult:
    ok: bool
    value: ClangAdapterCapability

struct ClangAstExportResult:
    ok: bool
    value: ClangAstExport

fn clang_failed_export() -> ClangAstExport:
    clang_empty_export(clang_zero_artifact(), 0)

# ----------------------------------------------------------------------------
# ClangEntityIdentity — unframed field access
# ----------------------------------------------------------------------------

fn clang_entity_identity_put(out: [u8], id: ClangEntityIdentity) -> [u8]:
    var b = artifact_id_put(out, id.tu_artifact)
    b = wire_put_u32(b, id.ast_kind)
    b = source_anchor_put(b, id.source)
    b = wire_put_u32(b, id.semantic_usr)
    wire_put_u32(b, id.local_ordinal)

fn clang_entity_identity_read(data: [u8], off: i64) -> ClangEntityIdentity:
    """Bounds must already have been checked by the caller through `wire_has`,
    exactly as in the ID-TAG lane's readers."""
    val tu = artifact_id_read(data, off)
    val kind = wire_get_u32(data, off + ARTIFACT_ID_LEN)
    val anchor_off = off + ARTIFACT_ID_LEN + 4
    val anchor = source_anchor_read(data, anchor_off)
    val usr_off = anchor_off + SOURCE_ANCHOR_LEN
    clang_entity_identity(tu, kind, anchor, wire_get_u32(data, usr_off),
                          wire_get_u32(data, usr_off + 4))

# ----------------------------------------------------------------------------
# ClangEntityIdentity — framed record
# ----------------------------------------------------------------------------

fn encode_clang_entity_identity(id: ClangEntityIdentity) -> [u8]:
    val empty: [u8] = []
    val b = wire_put_envelope(empty, clang_magic_entity_identity(),
                              CLANG_SCHEMA_VERSION)
    clang_entity_identity_put(b, id)

fn decode_clang_entity_identity(data: [u8]) -> ClangEntityIdentityResult:
    if not wire_check_envelope(data, 0, clang_magic_entity_identity(),
                               CLANG_SCHEMA_VERSION):
        return ClangEntityIdentityResult(ok: false, value: clang_zero_identity())
    if data.len() != WIRE_ENVELOPE_LEN + CLANG_ENTITY_IDENTITY_LEN:
        return ClangEntityIdentityResult(ok: false, value: clang_zero_identity())
    ClangEntityIdentityResult(
        ok: true,
        value: clang_entity_identity_read(data, WIRE_ENVELOPE_LEN))

# ----------------------------------------------------------------------------
# ClangAdapterCapability — framed record
# ----------------------------------------------------------------------------

fn encode_clang_adapter_capability(cap: ClangAdapterCapability) -> [u8]:
    val empty: [u8] = []
    var b = wire_put_envelope(empty, clang_magic_adapter_capability(),
                              CLANG_SCHEMA_VERSION)
    b = wire_put_u16(b, cap.clang_major)
    b = wire_put_u16(b, cap.ast_export_schema)
    b = wire_put_u16(b, cap.matcher_adapter_version)
    b = wire_put_u16(b, cap.transformer_adapter_version)
    b = wire_put_u16(b, cap.llvm_ir_schema)
    wire_put_u32(b, cap.supported_features)

fn decode_clang_adapter_capability(data: [u8]) -> ClangAdapterCapabilityResult:
    """Decodes any well-framed advertisement, including one from an
    unsupported Clang major. Acceptance is a separate decision that carries a
    reason receipt — see `clang_capability_decide`."""
    if not wire_check_envelope(data, 0, clang_magic_adapter_capability(),
                               CLANG_SCHEMA_VERSION):
        return ClangAdapterCapabilityResult(ok: false,
                                            value: clang_zero_capability())
    if data.len() != WIRE_ENVELOPE_LEN + CLANG_ADAPTER_CAPABILITY_LEN:
        return ClangAdapterCapabilityResult(ok: false,
                                            value: clang_zero_capability())
    val o = WIRE_ENVELOPE_LEN
    ClangAdapterCapabilityResult(
        ok: true,
        value: clang_adapter_capability(wire_get_u16(data, o),
                                        wire_get_u16(data, o + 2),
                                        wire_get_u16(data, o + 4),
                                        wire_get_u16(data, o + 6),
                                        wire_get_u16(data, o + 8),
                                        wire_get_u32(data, o + 10)))

# ----------------------------------------------------------------------------
# ClangAstExport — framed record, column-major
# ----------------------------------------------------------------------------

fn clang_put_u32_column(out: [u8], col: [u32]) -> [u8]:
    var b = out
    var i = 0
    while i < col.len():
        b = wire_put_u32(b, col[i])
        i = i + 1
    b

fn encode_clang_ast_export(e: ClangAstExport) -> [u8]:
    """Returns an EMPTY buffer for a malformed arena. A producer must not be
    able to emit a record that the frozen decoder would reject; an empty buffer
    is unambiguously not a valid record (it fails the envelope check) so the
    failure surfaces at the first read instead of downstream."""
    val empty: [u8] = []
    if not clang_export_valid(e):
        return empty
    var b = wire_put_envelope(empty, clang_magic_ast_export(),
                              CLANG_SCHEMA_VERSION)
    b = wire_put_u32(b, e.producer_clang_major)
    b = artifact_id_put(b, e.tu_artifact)
    b = wire_put_u32(b, e.kind.len())
    b = clang_put_u32_column(b, e.kind)
    b = clang_put_u32_column(b, e.parent)
    b = clang_put_u32_column(b, e.ordinal)
    b = clang_put_u32_column(b, e.flags)
    b = clang_put_u32_column(b, e.usr)
    var i = 0
    while i < e.anchor.len():
        b = source_anchor_put(b, e.anchor[i])
        i = i + 1
    b

fn clang_read_u32_column(data: [u8], off: i64, n: i64) -> [u32]:
    var col: [u32] = []
    var i = 0
    while i < n:
        col.push(wire_get_u32(data, off + i * 4))
        i = i + 1
    col

fn decode_clang_ast_export(data: [u8]) -> ClangAstExportResult:
    if not wire_check_envelope(data, 0, clang_magic_ast_export(),
                               CLANG_SCHEMA_VERSION):
        return ClangAstExportResult(ok: false, value: clang_failed_export())
    if not wire_has(data, 0, WIRE_ENVELOPE_LEN + CLANG_AST_EXPORT_HEADER_LEN):
        return ClangAstExportResult(ok: false, value: clang_failed_export())
    val o = WIRE_ENVELOPE_LEN
    val major = wire_get_u32(data, o)
    if not clang_major_supported(major):
        # §12.6 — an unknown Clang major is rejected, not assumed compatible.
        return ClangAstExportResult(ok: false, value: clang_failed_export())
    val tu = artifact_id_read(data, o + 4)
    val n = wire_get_u32(data, o + 4 + ARTIFACT_ID_LEN)
    if n < 0:
        return ClangAstExportResult(ok: false, value: clang_failed_export())
    # The declared count must consume the buffer EXACTLY. Verified before any
    # column is allocated (ID-TAG conventions §2.3), and exact rather than
    # "at least" so trailing bytes are a rejection too.
    val expect = WIRE_ENVELOPE_LEN + CLANG_AST_EXPORT_HEADER_LEN + n * CLANG_AST_NODE_LEN
    if data.len() != expect:
        return ClangAstExportResult(ok: false, value: clang_failed_export())
    var base = o + CLANG_AST_EXPORT_HEADER_LEN
    val kind = clang_read_u32_column(data, base, n)
    base = base + n * 4
    val parent = clang_read_u32_column(data, base, n)
    base = base + n * 4
    val ordinal = clang_read_u32_column(data, base, n)
    base = base + n * 4
    val flags = clang_read_u32_column(data, base, n)
    base = base + n * 4
    val usr = clang_read_u32_column(data, base, n)
    base = base + n * 4
    var anchor: [SourceAnchor] = []
    var i = 0
    while i < n:
        anchor.push(source_anchor_read(data, base + i * SOURCE_ANCHOR_LEN))
        i = i + 1
    val e = clang_ast_export(tu, major, kind, parent, ordinal, flags, usr,
                             anchor)
    # Structural validity is checked on the DECODED arena, not on the raw
    # bytes: reserved flag bits and the preorder parent invariant are both
    # properties of the arena, and checking them in one place keeps the encoder
    # and decoder guarding exactly the same predicate.
    if not clang_export_valid(e):
        return ClangAstExportResult(ok: false, value: clang_failed_export())
    ClangAstExportResult(ok: true, value: e)
