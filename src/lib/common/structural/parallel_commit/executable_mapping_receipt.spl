# Pointer-free producer identity for executable mappings. A receipt names a
# mapping but never grants native address or release authority on its own.

pub const EXECUTABLE_MAPPING_RECEIPT_SCHEMA_V1: i64 = 1
pub const EXECUTABLE_MAPPING_RECEIPT_MAX_INSTANCE_BYTES: i64 = 256
pub const EXECUTABLE_MAPPING_RECEIPT_MAX_OWNER_BYTES: i64 = 4096
pub const EXECUTABLE_MAPPING_RECEIPT_MAX_KEY_BYTES: i64 = 4096

pub enum ExecutableMappingProducerKindV1:
    SegmentMapper
    SharedExecMapper

pub enum ExecutableMappingReleaseOutcomeV1:
    Released
    AlreadyReleased
    NotFound
    OwnerMismatch
    GenerationMismatch
    FinalUnpinRequired
    NativeReleaseFailed

pub struct ExecutableMappingReceiptV1:
    schema: i64
    producer_kind: ExecutableMappingProducerKindV1
    mapper_instance_id: text
    owner_id: text
    mapping_key: text
    mapping_generation: i64
    mapped_bytes: i64
    segment_count: i64

pub struct ExecutableMappingReleaseResultV1:
    receipt: ExecutableMappingReceiptV1
    outcome: ExecutableMappingReleaseOutcomeV1
    released_bytes: i64
    released_segments: i64
    attempt_id: i64

pub fn executable_mapping_receipt_v1(
        producer_kind: ExecutableMappingProducerKindV1,
        mapper_instance_id: text, owner_id: text, mapping_key: text,
        mapping_generation: i64, mapped_bytes: i64,
        segment_count: i64) -> ExecutableMappingReceiptV1:
    ExecutableMappingReceiptV1(
        schema: EXECUTABLE_MAPPING_RECEIPT_SCHEMA_V1,
        producer_kind: producer_kind,
        mapper_instance_id: mapper_instance_id,
        owner_id: owner_id,
        mapping_key: mapping_key,
        mapping_generation: mapping_generation,
        mapped_bytes: mapped_bytes,
        segment_count: segment_count)

pub fn executable_mapping_receipt_v1_well_formed(
        receipt: ExecutableMappingReceiptV1) -> bool:
    if receipt.schema != EXECUTABLE_MAPPING_RECEIPT_SCHEMA_V1 or
            receipt.mapper_instance_id.len() <= 0 or
            receipt.mapper_instance_id.len() > EXECUTABLE_MAPPING_RECEIPT_MAX_INSTANCE_BYTES or
            receipt.owner_id.len() <= 0 or
            receipt.owner_id.len() > EXECUTABLE_MAPPING_RECEIPT_MAX_OWNER_BYTES or
            receipt.mapping_key.len() <= 0 or
            receipt.mapping_key.len() > EXECUTABLE_MAPPING_RECEIPT_MAX_KEY_BYTES or
            receipt.mapping_generation <= 0 or receipt.mapped_bytes <= 0 or
            receipt.segment_count <= 0:
        return false
    true

pub fn executable_mapping_receipt_v1_same_identity(
        left: ExecutableMappingReceiptV1,
        right: ExecutableMappingReceiptV1) -> bool:
    if not executable_mapping_receipt_v1_well_formed(left) or
            not executable_mapping_receipt_v1_well_formed(right):
        return false
    if left.producer_kind != right.producer_kind or
            left.mapper_instance_id != right.mapper_instance_id or
            left.owner_id != right.owner_id or
            left.mapping_key != right.mapping_key or
            left.mapping_generation != right.mapping_generation or
            left.mapped_bytes != right.mapped_bytes or
            left.segment_count != right.segment_count:
        return false
    true

pub fn executable_mapping_release_result_v1(
        receipt: ExecutableMappingReceiptV1,
        outcome: ExecutableMappingReleaseOutcomeV1,
        released_bytes: i64, released_segments: i64,
        attempt_id: i64) -> ExecutableMappingReleaseResultV1:
    ExecutableMappingReleaseResultV1(
        receipt: receipt, outcome: outcome,
        released_bytes: released_bytes,
        released_segments: released_segments,
        attempt_id: attempt_id)

pub fn executable_mapping_release_result_v1_well_formed(
        result: ExecutableMappingReleaseResultV1) -> bool:
    if not executable_mapping_receipt_v1_well_formed(result.receipt) or
            result.attempt_id <= 0:
        return false
    if result.outcome == ExecutableMappingReleaseOutcomeV1.Released:
        return result.released_bytes == result.receipt.mapped_bytes and
            result.released_segments == result.receipt.segment_count
    result.released_bytes == 0 and result.released_segments == 0

pub fn executable_mapping_release_result_v1_matches(
        result: ExecutableMappingReleaseResultV1,
        receipt: ExecutableMappingReceiptV1,
        attempt_id: i64) -> bool:
    if not executable_mapping_release_result_v1_well_formed(result) or
            not executable_mapping_receipt_v1_same_identity(result.receipt, receipt):
        return false
    result.attempt_id == attempt_id
