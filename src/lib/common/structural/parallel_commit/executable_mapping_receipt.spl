# Pointer-free executable-mapping coordinates.
#
# This common leaf deliberately owns words, not native memory.  A mapper keeps
# its address and native free operation private; a higher lifecycle owner must
# provide the final-unpin proof before it can implement the release port.

val EXECUTABLE_MAPPING_RECEIPT_SCHEMA_V1: i64 = 1
val EXECUTABLE_MAPPING_RECEIPT_MAX_OWNER_BYTES: i64 = 1024
val EXECUTABLE_MAPPING_RECEIPT_MAX_KEY_BYTES: i64 = 4096

enum ExecutableMappingProducerKindV1:
    SegmentMapper
    SharedExecMapper

enum ExecutableMappingReleaseStatusV1:
    Released
    AlreadyReleased
    NotFound
    OwnerMismatch
    GenerationMismatch
    FinalUnpinRequired
    NativeReleaseFailed

"""A copyable coordinate issued only by the mapper that owns one mapping.

It intentionally contains no address, function pointer, native handle,
closure, or release callback.  `mapping_key` is an opaque owner-local key;
callers must not derive native authority from it.
"""
struct ExecutableMappingReceiptV1:
    schema: i64
    producer_kind: ExecutableMappingProducerKindV1
    owner_id: text
    mapping_key: text
    mapping_generation: i64
    mapped_bytes: i64
    segment_count: i64

struct ExecutableMappingReleaseResultV1:
    receipt: ExecutableMappingReceiptV1
    status: ExecutableMappingReleaseStatusV1

fn executable_mapping_receipt_v1(
        producer_kind: ExecutableMappingProducerKindV1,
        owner_id: text,
        mapping_key: text,
        mapping_generation: i64,
        mapped_bytes: i64,
        segment_count: i64) -> ExecutableMappingReceiptV1:
    ExecutableMappingReceiptV1(
        schema: EXECUTABLE_MAPPING_RECEIPT_SCHEMA_V1,
        producer_kind: producer_kind,
        owner_id: owner_id,
        mapping_key: mapping_key,
        mapping_generation: mapping_generation,
        mapped_bytes: mapped_bytes,
        segment_count: segment_count)

fn executable_mapping_receipt_v1_well_formed(value: ExecutableMappingReceiptV1) -> bool:
    value.schema == EXECUTABLE_MAPPING_RECEIPT_SCHEMA_V1
        and value.owner_id.len() > 0
        and value.owner_id.len() <= EXECUTABLE_MAPPING_RECEIPT_MAX_OWNER_BYTES
        and value.mapping_key.len() > 0
        and value.mapping_key.len() <= EXECUTABLE_MAPPING_RECEIPT_MAX_KEY_BYTES
        and value.mapping_generation > 0
        and value.mapped_bytes > 0
        and value.segment_count > 0

"""Final-unpin-only release boundary.

The common type contains no mapper implementation.  The future canonical
aspect owner may implement it only after the lower aspect-pack lease proves
that the exact generation reached final unpin.  This prevents a receipt copy
from becoming authority to free executable memory.
"""
trait ExecutableMappingReleasePortV1:
    fn release_after_final_unpin(receipt: ExecutableMappingReceiptV1,
                                 final_unpin_generation: i64) -> ExecutableMappingReleaseResultV1
