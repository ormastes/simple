# ============================================================================
# common/structural/mutation/mutation_codec.spl — CPU reference serializers
#
# CPU reference codec for the frozen MutationIR and conflict order (architecture
# §8.2/§8.3/§8.4/§8.5, §26 deliverable). This is the oracle: any future SIMD,
# CUDA or Vulkan mutation executor must accept exactly these bytes and any
# planner must produce them, which is what §30.5's "operation ordering is
# deterministic" and "conflicts never depend on thread scheduling" need in order
# to be testable at all.
#
# Layout (little-endian, no padding — see common/structural/wire.spl):
#
#   MutationEffect  21  reads u32 | writes u32 | creates u32 | deletes u32
#                       | invalidates u32 | flags u8
#
#   MutationOrigin   9  producer u8 | stable_name u32 | source_order u32
#
#   MutationOp     105  kind u8 | phase u8 | reserved u8
#                       | target EntityKey (32)
#                       | expected_revision ArtifactId (20)
#                       | payload u32 | precondition u32
#                       | origin MutationOrigin (9)
#                       | priority i32 (4) | stable_order u64 (8)
#                       | effect MutationEffect (21)
#
#   MutationPlan        envelope(8) | policy u8 | schema_version u32
#                       | op_count u32 | ops MutationOp * op_count
#
#   MutationCommitReceipt
#                  104  input_snapshot SnapshotId (28)
#                       | output_snapshot SnapshotId (28)
#                       | plan_hash Hash128 (16)
#                       | matched_entities u64 | applied_ops u64
#                       | skipped_ops u64 | conflicts u64
#
# HARD REJECTS, never a silent default:
#   - wrong magic, wrong version, non-zero envelope reserved;
#   - unknown MutationKind, MutationPhase, MutationProducer or ConflictPolicy
#     discriminant;
#   - a non-zero MutationOp.reserved byte;
#   - an EntityKindSet reserved bit, or a MutationEffect flags reserved bit;
#   - a phase byte that disagrees with the kind's derived phase;
#   - an op whose effect does not admit that it changes its own target kind;
#   - an empty op list, or ops not in strict §8.4 conflict order;
#   - a receipt reporting more conflicts than skips, an unchanged-output commit
#     that claims applied ops, or an applied commit whose output snapshot does
#     not supersede its input;
#   - trailing bytes after the record.
#
# The ORDER check matters here for the reason the arena checks mattered in the
# QUERY lane: a plan stored out of §8.4 order does not fail loudly, it commits a
# DIFFERENT snapshot depending on which evaluator walked it, and a mutation that
# quietly produces a scheduling-dependent result is exactly what §8 set out to
# replace. Both the order check and the effect check therefore run on ENCODE as
# well as decode.
# ============================================================================

use std.common.structural.wire.{
    WIRE_ENVELOPE_LEN,
    wire_check_envelope,
    wire_get_u32,
    wire_get_u64,
    wire_get_u8,
    wire_has,
    wire_magic,
    wire_put_envelope,
    wire_put_u32,
    wire_put_u64,
    wire_put_u8
}
use std.common.structural.identity.entity_id.{
    ARTIFACT_ID_LEN,
    ENTITY_KEY_LEN,
    HASH128_LEN,
    SNAPSHOT_ID_LEN,
    Hash128,
    hash128
}
use std.common.structural.identity.identity_codec.{
    artifact_id_put,
    artifact_id_read,
    entity_key_put,
    entity_key_read,
    hash128_put,
    hash128_read,
    identity_zero_artifact,
    snapshot_id_put,
    snapshot_id_read
}
use std.common.structural.mutation.mutation_contracts.{
    MUTATION_SCHEMA_VERSION,
    ConflictPolicy,
    MutationKind,
    conflict_policy_from_u8,
    conflict_policy_to_u8,
    conflict_policy_valid,
    entity_kind_set_valid,
    mutation_i32_from_u32,
    mutation_i32_to_u32,
    mutation_kind_from_u8,
    mutation_kind_to_u8,
    mutation_kind_valid,
    mutation_phase_to_u8,
    mutation_phase_valid,
    mutation_producer_from_u8,
    mutation_producer_to_u8,
    mutation_producer_valid
}
use std.common.structural.mutation.mutation_plan.{
    MUTATION_EFFECT_LEN,
    MUTATION_OP_LEN,
    MUTATION_ORIGIN_LEN,
    MUTATION_RECEIPT_LEN,
    MutationCommitReceipt,
    MutationEffect,
    MutationOp,
    MutationOrigin,
    MutationPlan,
    effect_flags_valid,
    mutation_commit_receipt,
    mutation_effect,
    mutation_effect_none,
    mutation_effect_well_formed,
    mutation_op,
    mutation_op_well_formed,
    mutation_origin,
    mutation_origin_zero,
    mutation_plan,
    mutation_plan_valid,
    mutation_receipt_well_formed
}

fn mutation_magic_effect() -> i64:
    wire_magic("SMEF")

fn mutation_magic_origin() -> i64:
    wire_magic("SMOR")

fn mutation_magic_op() -> i64:
    wire_magic("SMOP")

fn mutation_magic_plan() -> i64:
    wire_magic("SMPL")

fn mutation_magic_receipt() -> i64:
    wire_magic("SMRC")

# ----------------------------------------------------------------------------
# Result carriers — same shape as the ID-TAG, MAP and QUERY lanes', so a caller
# that already handles a QueryOpResult handles these without a new idiom.
# ----------------------------------------------------------------------------

struct MutationEffectResult:
    ok: bool
    value: MutationEffect

struct MutationOriginResult:
    ok: bool
    value: MutationOrigin

struct MutationOpResult:
    ok: bool
    value: MutationOp

struct MutationPlanResult:
    ok: bool
    value: MutationPlan

struct MutationReceiptResult:
    ok: bool
    value: MutationCommitReceipt

fn mutation_zero_bytes(extra: i64) -> [u8]:
    """A zero-filled buffer large enough for any embedded fixed record. Used
    only to synthesise the rejection carriers' identity fields."""
    var b: [u8] = []
    var i = 0
    while i < ENTITY_KEY_LEN + extra:
        b.push(0)
        i = i + 1
    b

fn mutation_zero_op() -> MutationOp:
    """The op-level rejection carrier. Deliberately NOT well formed — its effect
    is empty, which `mutation_op_well_formed` refuses — so a caller that ignores
    `ok` cannot mistake it for an op that legitimately changes nothing."""
    mutation_op(MutationKind.AddTag, entity_key_read(mutation_zero_bytes(0), 0),
                identity_zero_artifact(), 0, 0, mutation_origin_zero(), 0, 0,
                mutation_effect_none())

fn mutation_empty_plan() -> MutationPlan:
    """The plan-level rejection carrier: an empty op list, which
    `mutation_plan_valid` refuses."""
    val ops: [MutationOp] = []
    mutation_plan(ConflictPolicy.Reject, MUTATION_SCHEMA_VERSION, ops)

fn mutation_zero_receipt() -> MutationCommitReceipt:
    val zero = snapshot_id_read(mutation_zero_bytes(SNAPSHOT_ID_LEN), 0)
    mutation_commit_receipt(zero, zero, hash128(0, 0), 0, 0, 0, 0)

# ----------------------------------------------------------------------------
# MutationEffect
# ----------------------------------------------------------------------------

fn mutation_effect_put(out: [u8], e: MutationEffect) -> [u8]:
    var b = wire_put_u32(out, e.reads)
    b = wire_put_u32(b, e.writes)
    b = wire_put_u32(b, e.creates)
    b = wire_put_u32(b, e.deletes)
    b = wire_put_u32(b, e.invalidates)
    wire_put_u8(b, e.flags)

fn mutation_effect_read(data: [u8], off: i64) -> MutationEffectResult:
    if not wire_has(data, off, MUTATION_EFFECT_LEN):
        return MutationEffectResult(ok: false, value: mutation_effect_none())
    val reads = wire_get_u32(data, off)
    val writes = wire_get_u32(data, off + 4)
    val creates = wire_get_u32(data, off + 8)
    val deletes = wire_get_u32(data, off + 12)
    if not entity_kind_set_valid(reads):
        return MutationEffectResult(ok: false, value: mutation_effect_none())
    if not entity_kind_set_valid(writes):
        return MutationEffectResult(ok: false, value: mutation_effect_none())
    if not entity_kind_set_valid(creates):
        return MutationEffectResult(ok: false, value: mutation_effect_none())
    if not entity_kind_set_valid(deletes):
        return MutationEffectResult(ok: false, value: mutation_effect_none())
    val flags = wire_get_u8(data, off + 20)
    if not effect_flags_valid(flags):
        return MutationEffectResult(ok: false, value: mutation_effect_none())
    MutationEffectResult(ok: true,
                         value: mutation_effect(reads, writes, creates, deletes,
                                                wire_get_u32(data, off + 16),
                                                flags))

fn encode_mutation_effect(e: MutationEffect) -> [u8]:
    """Framed standalone effect summary. An ill-formed effect encodes to an
    EMPTY buffer rather than to bytes no decoder will accept."""
    var b: [u8] = []
    if not mutation_effect_well_formed(e):
        return b
    b = wire_put_envelope(b, mutation_magic_effect(), MUTATION_SCHEMA_VERSION)
    mutation_effect_put(b, e)

fn decode_mutation_effect(data: [u8]) -> MutationEffectResult:
    if not wire_check_envelope(data, 0, mutation_magic_effect(),
                               MUTATION_SCHEMA_VERSION):
        return MutationEffectResult(ok: false, value: mutation_effect_none())
    if data.len() != WIRE_ENVELOPE_LEN + MUTATION_EFFECT_LEN:
        return MutationEffectResult(ok: false, value: mutation_effect_none())
    mutation_effect_read(data, WIRE_ENVELOPE_LEN)

# ----------------------------------------------------------------------------
# MutationOrigin
# ----------------------------------------------------------------------------

fn mutation_origin_put(out: [u8], o: MutationOrigin) -> [u8]:
    var b = wire_put_u8(out, mutation_producer_to_u8(o.producer))
    b = wire_put_u32(b, o.stable_name)
    wire_put_u32(b, o.source_order)

fn mutation_origin_read(data: [u8], off: i64) -> MutationOriginResult:
    if not wire_has(data, off, MUTATION_ORIGIN_LEN):
        return MutationOriginResult(ok: false, value: mutation_origin_zero())
    val raw = wire_get_u8(data, off)
    if not mutation_producer_valid(raw):
        return MutationOriginResult(ok: false, value: mutation_origin_zero())
    MutationOriginResult(ok: true,
                         value: mutation_origin(mutation_producer_from_u8(raw),
                                                wire_get_u32(data, off + 1),
                                                wire_get_u32(data, off + 5)))

fn encode_mutation_origin(o: MutationOrigin) -> [u8]:
    var b: [u8] = []
    b = wire_put_envelope(b, mutation_magic_origin(), MUTATION_SCHEMA_VERSION)
    mutation_origin_put(b, o)

fn decode_mutation_origin(data: [u8]) -> MutationOriginResult:
    if not wire_check_envelope(data, 0, mutation_magic_origin(),
                               MUTATION_SCHEMA_VERSION):
        return MutationOriginResult(ok: false, value: mutation_origin_zero())
    if data.len() != WIRE_ENVELOPE_LEN + MUTATION_ORIGIN_LEN:
        return MutationOriginResult(ok: false, value: mutation_origin_zero())
    mutation_origin_read(data, WIRE_ENVELOPE_LEN)

# ----------------------------------------------------------------------------
# MutationOp
# ----------------------------------------------------------------------------

fn mutation_op_put(out: [u8], op: MutationOp) -> [u8]:
    var b = wire_put_u8(out, mutation_kind_to_u8(op.kind))
    b = wire_put_u8(b, mutation_phase_to_u8(op.phase))
    b = wire_put_u8(b, op.reserved)
    b = entity_key_put(b, op.target)
    b = artifact_id_put(b, op.expected_revision)
    b = wire_put_u32(b, op.payload)
    b = wire_put_u32(b, op.precondition)
    b = mutation_origin_put(b, op.origin)
    b = wire_put_u32(b, mutation_i32_to_u32(op.priority))
    b = wire_put_u64(b, op.stable_order)
    mutation_effect_put(b, op.effect)

fn mutation_op_reject() -> MutationOpResult:
    MutationOpResult(ok: false, value: mutation_zero_op())

fn mutation_op_read(data: [u8], off: i64) -> MutationOpResult:
    """Read one MutationOp, applying every per-op rule of §8.2/§8.3. The
    ARENA-position rules (strict §8.4 order across ops) are applied by the plan
    decoder, which is the only place the neighbouring ops are known."""
    if not wire_has(data, off, MUTATION_OP_LEN):
        return mutation_op_reject()
    val raw_kind = wire_get_u8(data, off)
    if not mutation_kind_valid(raw_kind):
        return mutation_op_reject()
    val raw_phase = wire_get_u8(data, off + 1)
    if not mutation_phase_valid(raw_phase):
        return mutation_op_reject()
    if wire_get_u8(data, off + 2) != 0:
        return mutation_op_reject()
    val target = entity_key_read(data, off + 3)
    val revision = artifact_id_read(data, off + 3 + ENTITY_KEY_LEN)
    var p = off + 3 + ENTITY_KEY_LEN + ARTIFACT_ID_LEN
    val payload = wire_get_u32(data, p)
    val precondition = wire_get_u32(data, p + 4)
    val origin_r = mutation_origin_read(data, p + 8)
    if not origin_r.ok:
        return mutation_op_reject()
    p = p + 8 + MUTATION_ORIGIN_LEN
    val priority = mutation_i32_from_u32(wire_get_u32(data, p))
    val stable_order = wire_get_u64(data, p + 4)
    val effect_r = mutation_effect_read(data, p + 12)
    if not effect_r.ok:
        return mutation_op_reject()
    val out = mutation_op(mutation_kind_from_u8(raw_kind), target, revision,
                          payload, precondition, origin_r.value, priority,
                          stable_order, effect_r.value)
    # The phase byte is derived from the kind, so a wire phase that disagrees
    # with the kind's phase is a forged ordering key and must not be accepted.
    if mutation_phase_to_u8(out.phase) != raw_phase:
        return mutation_op_reject()
    if not mutation_op_well_formed(out):
        return mutation_op_reject()
    MutationOpResult(ok: true, value: out)

fn encode_mutation_op(op: MutationOp) -> [u8]:
    """Framed standalone op. An ill-formed op encodes to an EMPTY buffer: a
    planner must not be able to put an op with an unrepresentative effect
    summary on the wire (§8.3)."""
    var b: [u8] = []
    if not mutation_op_well_formed(op):
        return b
    b = wire_put_envelope(b, mutation_magic_op(), MUTATION_SCHEMA_VERSION)
    mutation_op_put(b, op)

fn decode_mutation_op(data: [u8]) -> MutationOpResult:
    if not wire_check_envelope(data, 0, mutation_magic_op(),
                               MUTATION_SCHEMA_VERSION):
        return mutation_op_reject()
    if data.len() != WIRE_ENVELOPE_LEN + MUTATION_OP_LEN:
        return mutation_op_reject()
    mutation_op_read(data, WIRE_ENVELOPE_LEN)

# ----------------------------------------------------------------------------
# MutationPlan
# ----------------------------------------------------------------------------

val MUTATION_PLAN_HEADER_LEN: i64 = 9

fn mutation_plan_reject() -> MutationPlanResult:
    MutationPlanResult(ok: false, value: mutation_empty_plan())

fn encode_mutation_plan(p: MutationPlan) -> [u8]:
    """Serialize a plan. An invalid plan encodes to an EMPTY buffer rather than
    to bytes no decoder will accept — a planner must not be able to put an
    out-of-order op sequence on the wire, because §8.4's order is the whole
    determinism guarantee."""
    var b: [u8] = []
    if not mutation_plan_valid(p):
        return b
    b = wire_put_envelope(b, mutation_magic_plan(), MUTATION_SCHEMA_VERSION)
    b = wire_put_u8(b, conflict_policy_to_u8(p.policy))
    b = wire_put_u32(b, p.schema_version)
    b = wire_put_u32(b, p.ops.len())
    var i = 0
    while i < p.ops.len():
        b = mutation_op_put(b, p.ops[i])
        i = i + 1
    b

fn decode_mutation_plan(data: [u8]) -> MutationPlanResult:
    if not wire_check_envelope(data, 0, mutation_magic_plan(),
                               MUTATION_SCHEMA_VERSION):
        return mutation_plan_reject()
    if not wire_has(data, WIRE_ENVELOPE_LEN, MUTATION_PLAN_HEADER_LEN):
        return mutation_plan_reject()
    val raw_policy = wire_get_u8(data, WIRE_ENVELOPE_LEN)
    if not conflict_policy_valid(raw_policy):
        return mutation_plan_reject()
    val schema_version = wire_get_u32(data, WIRE_ENVELOPE_LEN + 1)
    # `op_count` is a u32 read back into an i64 binding BEFORE it is multiplied
    # by the record length. Doing the bound check at 32-bit width is the trap
    # that let a wrapped `offset + count` pass as well formed in two earlier
    # waves; at i64 width the product cannot wrap.
    val op_count: i64 = wire_get_u32(data, WIRE_ENVELOPE_LEN + 5)
    var off = WIRE_ENVELOPE_LEN + MUTATION_PLAN_HEADER_LEN
    if not wire_has(data, off, op_count * MUTATION_OP_LEN):
        return mutation_plan_reject()

    var ops: [MutationOp] = []
    var i = 0
    while i < op_count:
        val r = mutation_op_read(data, off)
        if not r.ok:
            return mutation_plan_reject()
        ops.push(r.value)
        off = off + MUTATION_OP_LEN
        i = i + 1

    if data.len() != off:
        return mutation_plan_reject()
    val out = mutation_plan(conflict_policy_from_u8(raw_policy), schema_version,
                            ops)
    # Re-run the full structural rule so decode accepts exactly the set encode
    # emits; this is what catches an op sequence stored out of §8.4 order.
    if not mutation_plan_valid(out):
        return mutation_plan_reject()
    MutationPlanResult(ok: true, value: out)

# ----------------------------------------------------------------------------
# MutationCommitReceipt
# ----------------------------------------------------------------------------

fn mutation_receipt_reject() -> MutationReceiptResult:
    MutationReceiptResult(ok: false, value: mutation_zero_receipt())

fn mutation_receipt_put(out: [u8], r: MutationCommitReceipt) -> [u8]:
    var b = snapshot_id_put(out, r.input_snapshot)
    b = snapshot_id_put(b, r.output_snapshot)
    b = hash128_put(b, r.plan_hash)
    b = wire_put_u64(b, r.matched_entities)
    b = wire_put_u64(b, r.applied_ops)
    b = wire_put_u64(b, r.skipped_ops)
    wire_put_u64(b, r.conflicts)

fn mutation_receipt_read(data: [u8], off: i64) -> MutationReceiptResult:
    if not wire_has(data, off, MUTATION_RECEIPT_LEN):
        return mutation_receipt_reject()
    val input = snapshot_id_read(data, off)
    val output = snapshot_id_read(data, off + SNAPSHOT_ID_LEN)
    var p = off + SNAPSHOT_ID_LEN + SNAPSHOT_ID_LEN
    val plan_hash = hash128_read(data, p)
    p = p + HASH128_LEN
    val out = mutation_commit_receipt(input, output, plan_hash,
                                      wire_get_u64(data, p),
                                      wire_get_u64(data, p + 8),
                                      wire_get_u64(data, p + 16),
                                      wire_get_u64(data, p + 24))
    if not mutation_receipt_well_formed(out):
        return mutation_receipt_reject()
    MutationReceiptResult(ok: true, value: out)

fn encode_mutation_receipt(r: MutationCommitReceipt) -> [u8]:
    """An internally-impossible receipt encodes to an EMPTY buffer. §30.5 says
    receipts "exactly explain applied, skipped, and rejected operations"; a
    receipt that survives only because nobody validated the writer is how that
    obligation quietly becomes untrue."""
    var b: [u8] = []
    if not mutation_receipt_well_formed(r):
        return b
    b = wire_put_envelope(b, mutation_magic_receipt(), MUTATION_SCHEMA_VERSION)
    mutation_receipt_put(b, r)

fn decode_mutation_receipt(data: [u8]) -> MutationReceiptResult:
    if not wire_check_envelope(data, 0, mutation_magic_receipt(),
                               MUTATION_SCHEMA_VERSION):
        return mutation_receipt_reject()
    if data.len() != WIRE_ENVELOPE_LEN + MUTATION_RECEIPT_LEN:
        return mutation_receipt_reject()
    mutation_receipt_read(data, WIRE_ENVELOPE_LEN)

export MutationEffectResult, MutationOriginResult, MutationOpResult
export MutationPlanResult, MutationReceiptResult
export MUTATION_PLAN_HEADER_LEN
export mutation_magic_effect, mutation_magic_origin, mutation_magic_op
export mutation_magic_plan, mutation_magic_receipt
export mutation_zero_op, mutation_empty_plan, mutation_zero_receipt
export mutation_effect_put, mutation_effect_read
export encode_mutation_effect, decode_mutation_effect
export mutation_origin_put, mutation_origin_read
export encode_mutation_origin, decode_mutation_origin
export mutation_op_put, mutation_op_read
export encode_mutation_op, decode_mutation_op
export encode_mutation_plan, decode_mutation_plan
export mutation_receipt_put, mutation_receipt_read
export encode_mutation_receipt, decode_mutation_receipt
