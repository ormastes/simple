# Concrete v1 spatial-layout input, island, scheduling, and receipt shapes.

use std.common.structural.execution.contracts.{LayoutExecutionProfile, LayoutReceipt}
use std.common.compute.placement_contracts.handles.{ArenaResidency}
use std.common.structural.invalidation.contracts.{DirtyMask, LayoutDependency}
use std.common.structural.mapping.contracts.{LayoutMapping, MappingGraph}

val LAYOUT_CONTRACT_VERSION: i64 = 1

pub enum LayoutArena:
    Marker

struct LayoutBox:
    id: i64
    x: i64
    y: i64
    width: i64
    height: i64

struct LayoutNodeInput:
    id: i64
    parent_id: i64
    profile_id: text
    formatting_boundary: bool
    layout_contained: bool
    oracle_box: LayoutBox
    dirty_bits: i64
    dirty: DirtyMask
    estimated_work: i64
    text_measure_required: bool
    required_fixed_point_iterations: i64

struct LayoutInputSnapshot:
    contract_version: i64
    nodes: [LayoutNodeInput]
    dependencies: [LayoutDependency]
    invalidated_ids: [i64]
    execution: LayoutExecutionProfile
    fixed_point_cap: i64
    arena_residency: ArenaResidency<LayoutArena>?

struct LayoutIsland:
    root_id: i64
    profile_id: text
    node_ids: [i64]
    estimated_work: i64
    dirty_bits: i64
    dirty: DirtyMask
    text_measure_required: bool
    required_fixed_point_iterations: i64

struct LayoutDiscovery:
    islands: [LayoutIsland]
    fault: text

struct LayoutWave:
    island_ids: [i64]

struct LayoutSchedule:
    waves: [LayoutWave]
    converged: bool
    iterations: i64
    reason: text

struct LayoutBackendDecision:
    backend: text
    reason: text
    cpu_us: i64
    gpu_us: i64

struct LayoutSnapshot:
    contract_version: i64
    boxes: [LayoutBox]
    islands: [LayoutIsland]
    waves: [LayoutWave]
    visited_island_ids: [i64]
    mappings: [LayoutMapping]
    mapping_graph: MappingGraph
    receipt: LayoutReceipt
    arena_residency: ArenaResidency<LayoutArena>?
    fault: text
    backend: text

fn layout_box(id: i64, x: i64, y: i64, width: i64, height: i64) -> LayoutBox:
    LayoutBox(id: id, x: x, y: y, width: width, height: height)

fn layout_node(
    id: i64,
    parent_id: i64,
    profile_id: text,
    formatting_boundary: bool,
    layout_contained: bool,
    oracle_box: LayoutBox,
    dirty_bits: i64,
    estimated_work: i64,
    text_measure_required: bool,
    required_fixed_point_iterations: i64
) -> LayoutNodeInput:
    LayoutNodeInput(
        id: id,
        parent_id: parent_id,
        profile_id: profile_id,
        formatting_boundary: formatting_boundary,
        layout_contained: layout_contained,
        oracle_box: oracle_box,
        dirty_bits: dirty_bits,
        dirty: DirtyMask.from_bits(dirty_bits),
        estimated_work: estimated_work,
        text_measure_required: text_measure_required,
        required_fixed_point_iterations: required_fixed_point_iterations
    )

fn layout_input(
    nodes: [LayoutNodeInput],
    dependencies: [LayoutDependency],
    invalidated_ids: [i64],
    execution: LayoutExecutionProfile,
    fixed_point_cap: i64
) -> LayoutInputSnapshot:
    LayoutInputSnapshot(
        contract_version: LAYOUT_CONTRACT_VERSION,
        nodes: nodes,
        dependencies: dependencies,
        invalidated_ids: invalidated_ids,
        execution: execution,
        fixed_point_cap: fixed_point_cap,
        arena_residency: nil
    )

fn layout_input_with_residency(
    nodes: [LayoutNodeInput],
    dependencies: [LayoutDependency],
    invalidated_ids: [i64],
    execution: LayoutExecutionProfile,
    fixed_point_cap: i64,
    arena_residency: ArenaResidency<LayoutArena>
) -> LayoutInputSnapshot:
    LayoutInputSnapshot(
        contract_version: LAYOUT_CONTRACT_VERSION,
        nodes: nodes,
        dependencies: dependencies,
        invalidated_ids: invalidated_ids,
        execution: execution,
        fixed_point_cap: fixed_point_cap,
        arena_residency: arena_residency
    )

export LAYOUT_CONTRACT_VERSION
export LayoutArena, LayoutBox, LayoutNodeInput, LayoutInputSnapshot, LayoutIsland, LayoutDiscovery
export LayoutWave, LayoutSchedule, LayoutBackendDecision, LayoutSnapshot
export layout_box, layout_node, layout_input, layout_input_with_residency
