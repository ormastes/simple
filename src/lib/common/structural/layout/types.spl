# Concrete v1 spatial-layout input, island, scheduling, and receipt shapes.

use std.common.structural.execution.contracts.{CostEstimate, LayoutExecutionProfile, StageReceipt}
use std.common.structural.invalidation.contracts.{DirtyMask, LayoutDependency}
use std.common.structural.mapping.contracts.{LayoutMapping, MappingGraph}

val LAYOUT_CONTRACT_VERSION: i64 = 1

val LAYOUT_LENGTH_AUTO = "auto"
val LAYOUT_LENGTH_PX = "px"
val LAYOUT_LENGTH_PERCENT = "percent"
val LAYOUT_LENGTH_VIEWPORT_HEIGHT = "viewport-height"

val LAYOUT_GPU_ADMISSION_TEXT: i64 = 1
val LAYOUT_GPU_ADMISSION_REPLACED: i64 = 2
val LAYOUT_GPU_ADMISSION_LEGACY_WIDGET_BOX: i64 = 4
val LAYOUT_GPU_ADMISSION_VIEWPORT_FILL: i64 = 8
val LAYOUT_GPU_ADMISSION_POSITIONED: i64 = 16
val LAYOUT_GPU_ADMISSION_SCROLLING: i64 = 32
val LAYOUT_GPU_ADMISSION_CONTENT_HIDDEN: i64 = 64
val LAYOUT_GPU_ADMISSION_INLINE_FLOW: i64 = 128
val LAYOUT_GPU_ADMISSION_UNSUPPORTED_TRACK: i64 = 256

struct LayoutBox:
    id: i64
    x: i64
    y: i64
    width: i64
    height: i64

struct LayoutFragment:
    id: i64
    node_id: i64
    box: LayoutBox
    kind: text
    fragment_index: i64

struct LayoutLineBox:
    node_id: i64
    line_index: i64
    box: LayoutBox
    text_start: i64
    text_end: i64

struct LayoutOverflow:
    node_id: i64
    clip_box: LayoutBox
    scroll_width: i64
    scroll_height: i64

struct LayoutTextMeasureRequest:
    node_id: i64
    content: text
    font_family: text
    font_size: i64
    language: text

struct LayoutTextMeasureResult:
    node_id: i64
    available: bool
    font_identity: text
    width: i64
    line_height: i64
    advances: [i64]
    reason: text

struct LayoutLength:
    unit: text
    value: i64

struct LayoutEdges:
    left: i64
    top: i64
    right: i64
    bottom: i64

struct LayoutBoxConstraints:
    width: LayoutLength
    height: LayoutLength
    min_width_px: i64
    max_width_px: i64
    min_height_px: i64
    max_height_px: i64
    border_box: bool
    padding: LayoutEdges
    border: LayoutEdges
    margin_left: LayoutLength
    margin_top: LayoutLength
    margin_right: LayoutLength
    margin_bottom: LayoutLength
    margin_auto_bits: i64
    gap_px: i64
    row_gap_px: i64
    column_gap_px: i64

struct LayoutFlexConstraints:
    direction: text
    wrap: text
    justify_content: text
    align_items: text
    align_self: text
    align_content: text
    grow: i64
    shrink: i64
    basis: LayoutLength
    order: i64
    direction_rtl: bool

struct LayoutGridConstraints:
    column_track_start: i64
    column_track_count: i64
    row_track_start: i64
    row_track_count: i64
    column_start: i64
    column_span: i64
    row_start: i64
    row_span: i64
    align_items_authored: bool

struct LayoutNodeSemantics:
    first_child_id: i64
    next_sibling_id: i64
    child_count: i64
    node_kind: text
    display: text
    box: LayoutBoxConstraints
    flex: LayoutFlexConstraints
    grid: LayoutGridConstraints
    gpu_admission_flags: i64

struct LayoutNodeInput:
    id: i64
    parent_id: i64
    profile_id: text
    formatting_boundary: bool
    layout_contained: bool
    semantics: LayoutNodeSemantics
    dirty_bits: i64
    dirty: DirtyMask
    estimated_work: i64
    text_measure_required: bool

struct LayoutInputSnapshot:
    contract_version: i64
    nodes: [LayoutNodeInput]
    dependencies: [LayoutDependency]
    invalidated_ids: [i64]
    text_requests: [LayoutTextMeasureRequest]
    viewport_width: i64
    viewport_height: i64
    grid_tracks: [i64]
    oracle_boxes: [LayoutBox]
    execution: LayoutExecutionProfile
    fixed_point_cap: i64

struct LayoutIsland:
    root_id: i64
    profile_id: text
    node_ids: [i64]
    estimated_work: i64
    dirty_bits: i64
    dirty: DirtyMask
    text_measure_required: bool
    gpu_admission_flags: i64

struct LayoutDiscovery:
    islands: [LayoutIsland]
    fault: text

struct LayoutWave:
    island_ids: [i64]

struct LayoutSchedule:
    waves: [LayoutWave]
    cyclic_island_ids: [i64]
    converged: bool
    iterations: i64
    reason: text

struct LayoutBackendDecision:
    backend: text
    reason: text
    cpu_us: i64
    gpu_us: i64

struct LayoutExecutionProof:
    candidate_backend: text
    executed_backend: text
    executed: bool
    submitted: bool
    synchronized: bool
    device_readback: bool
    oracle_verified: bool
    reason: text

struct LayoutSnapshot:
    contract_version: i64
    boxes: [LayoutBox]
    fragments: [LayoutFragment]
    line_boxes: [LayoutLineBox]
    overflows: [LayoutOverflow]
    islands: [LayoutIsland]
    waves: [LayoutWave]
    visited_island_ids: [i64]
    mappings: [LayoutMapping]
    mapping_graph: MappingGraph
    island_costs: [CostEstimate]
    execution_proof: LayoutExecutionProof
    receipt: StageReceipt
    fault: text
    backend: text

fn layout_box(id: i64, x: i64, y: i64, width: i64, height: i64) -> LayoutBox:
    LayoutBox(id: id, x: x, y: y, width: width, height: height)

fn layout_fragment(id: i64, node_id: i64, box: LayoutBox, kind: text, fragment_index: i64) -> LayoutFragment:
    LayoutFragment(id: id, node_id: node_id, box: box, kind: kind, fragment_index: fragment_index)

fn layout_line_box(
    node_id: i64,
    line_index: i64,
    box: LayoutBox,
    text_start: i64,
    text_end: i64
) -> LayoutLineBox:
    LayoutLineBox(
        node_id: node_id,
        line_index: line_index,
        box: box,
        text_start: text_start,
        text_end: text_end
    )

fn layout_overflow(node_id: i64, clip_box: LayoutBox, scroll_width: i64, scroll_height: i64) -> LayoutOverflow:
    LayoutOverflow(
        node_id: node_id,
        clip_box: clip_box,
        scroll_width: scroll_width,
        scroll_height: scroll_height
    )

fn layout_text_measure_request(
    node_id: i64,
    content: text,
    font_family: text,
    font_size: i64,
    language: text
) -> LayoutTextMeasureRequest:
    LayoutTextMeasureRequest(
        node_id: node_id,
        content: content,
        font_family: font_family,
        font_size: font_size,
        language: language
    )

fn layout_length_auto() -> LayoutLength:
    LayoutLength(unit: LAYOUT_LENGTH_AUTO, value: 0)

fn layout_length_px(value: i64) -> LayoutLength:
    LayoutLength(unit: LAYOUT_LENGTH_PX, value: value)

fn layout_length_percent(value: i64) -> LayoutLength:
    LayoutLength(unit: LAYOUT_LENGTH_PERCENT, value: value)

fn layout_length_viewport_height(value: i64) -> LayoutLength:
    LayoutLength(unit: LAYOUT_LENGTH_VIEWPORT_HEIGHT, value: value)

fn layout_edges(left: i64, top: i64, right: i64, bottom: i64) -> LayoutEdges:
    LayoutEdges(left: left, top: top, right: right, bottom: bottom)

fn layout_box_constraints_default() -> LayoutBoxConstraints:
    LayoutBoxConstraints(
        width: layout_length_auto(),
        height: layout_length_auto(),
        min_width_px: 0,
        max_width_px: 0,
        min_height_px: 0,
        max_height_px: 0,
        border_box: false,
        padding: layout_edges(0, 0, 0, 0),
        border: layout_edges(0, 0, 0, 0),
        margin_left: layout_length_px(0),
        margin_top: layout_length_px(0),
        margin_right: layout_length_px(0),
        margin_bottom: layout_length_px(0),
        margin_auto_bits: 0,
        gap_px: 0,
        row_gap_px: 0,
        column_gap_px: 0
    )

fn layout_flex_constraints_default() -> LayoutFlexConstraints:
    LayoutFlexConstraints(
        direction: "row",
        wrap: "nowrap",
        justify_content: "flex-start",
        align_items: "stretch",
        align_self: "auto",
        align_content: "stretch",
        grow: 0,
        shrink: 1,
        basis: layout_length_auto(),
        order: 0,
        direction_rtl: false
    )

fn layout_grid_constraints_default() -> LayoutGridConstraints:
    LayoutGridConstraints(
        column_track_start: 0,
        column_track_count: 0,
        row_track_start: 0,
        row_track_count: 0,
        column_start: -1,
        column_span: 1,
        row_start: -1,
        row_span: 1,
        align_items_authored: false
    )

fn layout_node_semantics_default(profile_id: text) -> LayoutNodeSemantics:
    LayoutNodeSemantics(
        first_child_id: 0,
        next_sibling_id: 0,
        child_count: 0,
        node_kind: "normal",
        display: profile_id,
        box: layout_box_constraints_default(),
        flex: layout_flex_constraints_default(),
        grid: layout_grid_constraints_default(),
        gpu_admission_flags: 0
    )

fn layout_node(
    id: i64,
    parent_id: i64,
    profile_id: text,
    formatting_boundary: bool,
    layout_contained: bool,
    dirty_bits: i64,
    estimated_work: i64,
    text_measure_required: bool,
    semantics: LayoutNodeSemantics
) -> LayoutNodeInput:
    LayoutNodeInput(
        id: id,
        parent_id: parent_id,
        profile_id: profile_id,
        formatting_boundary: formatting_boundary,
        layout_contained: layout_contained,
        semantics: semantics,
        dirty_bits: dirty_bits,
        dirty: DirtyMask.from_bits(dirty_bits),
        estimated_work: estimated_work,
        text_measure_required: text_measure_required
    )

fn layout_input(
    nodes: [LayoutNodeInput],
    dependencies: [LayoutDependency],
    invalidated_ids: [i64],
    execution: LayoutExecutionProfile,
    fixed_point_cap: i64,
    viewport_width: i64 = 0,
    viewport_height: i64 = 0,
    grid_tracks: [i64] = [],
    oracle_boxes: [LayoutBox] = []
) -> LayoutInputSnapshot:
    LayoutInputSnapshot(
        contract_version: LAYOUT_CONTRACT_VERSION,
        nodes: nodes,
        dependencies: dependencies,
        invalidated_ids: invalidated_ids,
        text_requests: [],
        viewport_width: viewport_width,
        viewport_height: viewport_height,
        grid_tracks: grid_tracks,
        oracle_boxes: oracle_boxes,
        execution: execution,
        fixed_point_cap: fixed_point_cap
    )

fn layout_input_with_text(
    nodes: [LayoutNodeInput],
    dependencies: [LayoutDependency],
    invalidated_ids: [i64],
    text_requests: [LayoutTextMeasureRequest],
    execution: LayoutExecutionProfile,
    fixed_point_cap: i64,
    viewport_width: i64 = 0,
    viewport_height: i64 = 0,
    grid_tracks: [i64] = [],
    oracle_boxes: [LayoutBox] = []
) -> LayoutInputSnapshot:
    LayoutInputSnapshot(
        contract_version: LAYOUT_CONTRACT_VERSION,
        nodes: nodes,
        dependencies: dependencies,
        invalidated_ids: invalidated_ids,
        text_requests: text_requests,
        viewport_width: viewport_width,
        viewport_height: viewport_height,
        grid_tracks: grid_tracks,
        oracle_boxes: oracle_boxes,
        execution: execution,
        fixed_point_cap: fixed_point_cap
    )

export LAYOUT_CONTRACT_VERSION
export LAYOUT_LENGTH_AUTO, LAYOUT_LENGTH_PX, LAYOUT_LENGTH_PERCENT, LAYOUT_LENGTH_VIEWPORT_HEIGHT
export LAYOUT_GPU_ADMISSION_TEXT, LAYOUT_GPU_ADMISSION_REPLACED, LAYOUT_GPU_ADMISSION_LEGACY_WIDGET_BOX
export LAYOUT_GPU_ADMISSION_VIEWPORT_FILL, LAYOUT_GPU_ADMISSION_POSITIONED, LAYOUT_GPU_ADMISSION_SCROLLING
export LAYOUT_GPU_ADMISSION_CONTENT_HIDDEN, LAYOUT_GPU_ADMISSION_INLINE_FLOW, LAYOUT_GPU_ADMISSION_UNSUPPORTED_TRACK
export LayoutBox, LayoutFragment, LayoutLineBox, LayoutOverflow
export LayoutTextMeasureRequest, LayoutTextMeasureResult
export LayoutLength, LayoutEdges, LayoutBoxConstraints, LayoutFlexConstraints, LayoutGridConstraints, LayoutNodeSemantics
export LayoutNodeInput, LayoutInputSnapshot, LayoutIsland, LayoutDiscovery
export LayoutWave, LayoutSchedule, LayoutBackendDecision, LayoutSnapshot
export LayoutExecutionProof
export layout_box, layout_fragment, layout_line_box, layout_overflow
export layout_text_measure_request, layout_node, layout_input, layout_input_with_text
export layout_length_auto, layout_length_px, layout_length_percent, layout_length_viewport_height
export layout_edges, layout_box_constraints_default, layout_flex_constraints_default, layout_grid_constraints_default
export layout_node_semantics_default
