# codex-impl
# Automatic @rt(hal) environment-access extraction ingress.
#
# Compiler-generated metadata is scalar and pointer-free.  The parent-owned
# binding remains the sole mutable plan authority; adapters retain ownership of
# argument/result storage and pass only checked offsets and capacities.

use std.common.structural.environment_instruction.contracts.*
use std.common.structural.environment_instruction.extraction.*
use std.common.structural.environment_instruction.hal_binding.*

val RT_HAL_AUTOMATIC_METADATA_SCHEMA_V1: i64 = 1
val RT_HAL_EXECUTED_ACCESS_SCHEMA_V3: i64 = 3

enum RtHalExecutedAccessStateV3:
    Issued
    Ready
    Consumed
    Poisoned

struct RtHalExecutedAccessReceiptV3:
    schema_version: i64
    operation_id: i64
    generation: i64
    instruction: EnvInstructionV1
    trace_identity_hi: i64
    trace_identity_lo: i64
    trace_cursor: i64
    trace_length: i64
    trace_capacity: i64
    result_length: i64
    execution_status: i64
    state: RtHalExecutedAccessStateV3

fn rt_hal_executed_access_receipt_v3(
        operation_id: i64, generation: i64,
        instruction: EnvInstructionV1,
        trace_identity_hi: i64, trace_identity_lo: i64,
        trace_cursor: i64, trace_length: i64, trace_capacity: i64,
        result_length: i64, execution_status: i64,
        state: RtHalExecutedAccessStateV3) -> RtHalExecutedAccessReceiptV3:
    RtHalExecutedAccessReceiptV3(RT_HAL_EXECUTED_ACCESS_SCHEMA_V3,
        operation_id, generation, instruction, trace_identity_hi,
        trace_identity_lo, trace_cursor, trace_length, trace_capacity,
        result_length, execution_status, state)

fn rt_hal_executed_access_receipt_v3_well_formed(
        value: RtHalExecutedAccessReceiptV3) -> bool:
    val digest = env_instruction_plan_digest_v1(value.instruction)
    val ready = value.state == RtHalExecutedAccessStateV3.Ready
        and value.execution_status == 0
    val terminal = value.state == RtHalExecutedAccessStateV3.Poisoned
        and value.execution_status != 0
    value.schema_version == RT_HAL_EXECUTED_ACCESS_SCHEMA_V3
        and value.operation_id > 0 and value.generation > 0
        and env_instruction_v1_well_formed(value.instruction)
        and value.instruction.sequence == value.trace_cursor
        and value.trace_cursor >= 0 and value.trace_cursor < 4096
        and value.trace_length == value.trace_cursor + 1
        and value.trace_capacity >= value.trace_length
        and value.trace_capacity <= 4096
        and digest.0 == value.trace_identity_hi
        and digest.1 == value.trace_identity_lo
        and value.result_length >= 0
        and value.result_length <= value.instruction.result_capacity
        and (ready or terminal)

fn rt_hal_executed_access_receipt_v3_matches(
        value: RtHalExecutedAccessReceiptV3,
        operation_id: i64, opcode: EnvOpcodeV1, capability_id: i64,
        invocation_id: i64, trace_identity_hi: i64,
        trace_identity_lo: i64, trace_cursor: i64,
        result_capacity: i64) -> bool:
    rt_hal_executed_access_receipt_v3_well_formed(value)
        and value.state == RtHalExecutedAccessStateV3.Ready
        and value.operation_id == operation_id
        and value.instruction.opcode == opcode
        and value.instruction.capability_id == capability_id
        and value.instruction.invocation_id == invocation_id
        and value.trace_identity_hi == trace_identity_hi
        and value.trace_identity_lo == trace_identity_lo
        and value.trace_cursor == trace_cursor
        and value.instruction.result_capacity == result_capacity

struct RtHalAutomaticAccessMetadataV1:
    schema_version: i64
    tagged_operation_id: i64
    invocation_id: i64
    sequence: i64
    opcode: EnvOpcodeV1
    capability_id: i64
    flags: i64
    argument_offset: i64
    argument_length: i64
    argument_capacity: i64
    result_offset: i64
    result_capacity: i64
    result_region_capacity: i64

fn rt_hal_automatic_access_metadata_v1(
        tagged_operation_id: i64, invocation_id: i64, sequence: i64,
        opcode: EnvOpcodeV1, capability_id: i64, flags: i64,
        argument_offset: i64, argument_length: i64,
        argument_capacity: i64, result_offset: i64,
        result_capacity: i64, result_region_capacity: i64)
        -> RtHalAutomaticAccessMetadataV1:
    RtHalAutomaticAccessMetadataV1(
        RT_HAL_AUTOMATIC_METADATA_SCHEMA_V1, tagged_operation_id,
        invocation_id, sequence, opcode, capability_id, flags,
        argument_offset, argument_length, argument_capacity, result_offset,
        result_capacity, result_region_capacity)

fn rt_hal_automatic_access_metadata_v1_well_formed(
        value: RtHalAutomaticAccessMetadataV1) -> bool:
    value.schema_version == RT_HAL_AUTOMATIC_METADATA_SCHEMA_V1
        and value.tagged_operation_id > 0
        and value.tagged_operation_id <= RT_HAL_ENV_OPERATION_MAX_V1
        and env_access_event_v1_well_formed(env_access_event_v1(
            value.invocation_id, value.sequence, value.opcode,
            value.capability_id, value.flags, value.argument_offset,
            value.argument_length, value.argument_capacity,
            value.result_offset, value.result_capacity,
            value.result_region_capacity))

struct RtHalAutomaticExtractionReceiptV1:
    instruction: EnvInstructionV1
    accepted: bool
    status: EnvInstructionStatusV1

class RtHalAutomaticExtractionOwnerV1:
    installed: bool
    binding: RtHalEnvironmentBindingV1

    me extract(metadata: RtHalAutomaticAccessMetadataV1)
            -> RtHalAutomaticExtractionReceiptV1:
        # Constant work: scalar validation plus the existing fixed cursor
        # update.  Mutation occurs only on this canonical owner; no stale owner
        # copy is returned to invite a second commit of the same sequence.
        val admitted = self.installed
            and rt_hal_automatic_access_metadata_v1_well_formed(metadata)
            and rt_hal_environment_binding_v1_well_formed(self.binding)
            and not self.binding.extraction.sealed
            and metadata.tagged_operation_id == self.binding.tagged_operation_id
            and metadata.invocation_id == self.binding.extraction.invocation_id
            and metadata.sequence == self.binding.extraction.next_sequence
            and rt_hal_environment_opcode_admitted_v1(
                metadata.tagged_operation_id, metadata.opcode)
        if not admitted:
            val rejected = _rt_hal_automatic_rejected_binding_v1(
                self.binding, metadata)
            self.binding = rejected.0
            return RtHalAutomaticExtractionReceiptV1(
                rejected.1, false, self.binding.extraction.status)
        val extracted = rt_hal_environment_extract_v1(self.binding,
            metadata.opcode, metadata.capability_id, metadata.flags,
            metadata.argument_offset, metadata.argument_length,
            metadata.argument_capacity, metadata.result_offset,
            metadata.result_capacity, metadata.result_region_capacity)
        self.binding = extracted.binding
        RtHalAutomaticExtractionReceiptV1(extracted.instruction,
            extracted.accepted, self.binding.extraction.status)

    me seal():
        self.binding = rt_hal_environment_binding_seal_v1(self.binding)

fn rt_hal_automatic_extraction_owner_v1(
        tagged_operation_id: i64, invocation_id: i64,
        instruction_capacity: i64) -> RtHalAutomaticExtractionOwnerV1:
    RtHalAutomaticExtractionOwnerV1(true,
        rt_hal_environment_binding_v1(tagged_operation_id, invocation_id,
                                      instruction_capacity))

fn rt_hal_automatic_extraction_owner_absent_v1()
        -> RtHalAutomaticExtractionOwnerV1:
    # Deliberately invalid scalar binding.  The hook seals it on first use and
    # never performs or records an environment effect.
    RtHalAutomaticExtractionOwnerV1(false,
        rt_hal_environment_binding_v1(0, 0, 0))

fn _rt_hal_automatic_rejected_binding_v1(
        binding: RtHalEnvironmentBindingV1,
        metadata: RtHalAutomaticAccessMetadataV1)
        -> (RtHalEnvironmentBindingV1, EnvInstructionV1):
    val cursor = binding.extraction
    val status = if cursor.instruction_count >= cursor.instruction_capacity:
        EnvInstructionStatusV1.Overflow
    else:
        EnvInstructionStatusV1.InvalidInstruction
    val failed = EnvExtractionCursorV1(cursor.invocation_id,
        cursor.instruction_capacity, cursor.next_sequence,
        cursor.instruction_count, cursor.plan_digest_hi,
        cursor.plan_digest_lo, status, true)
    # The rejected instruction is diagnostic scalar evidence only.  It cannot
    # advance the canonical cursor and may itself be ill-formed.
    val instruction = env_instruction_v1(metadata.invocation_id,
        metadata.sequence, metadata.opcode, metadata.capability_id,
        metadata.flags, metadata.argument_offset, metadata.argument_length,
        metadata.argument_capacity, metadata.result_offset,
        metadata.result_capacity, metadata.result_region_capacity)
    (RtHalEnvironmentBindingV1(binding.tagged_operation_id,
        binding.environment_schema_id, failed), instruction)

export RT_HAL_AUTOMATIC_METADATA_SCHEMA_V1
export RT_HAL_EXECUTED_ACCESS_SCHEMA_V3, RtHalExecutedAccessStateV3
export RtHalExecutedAccessReceiptV3, rt_hal_executed_access_receipt_v3
export rt_hal_executed_access_receipt_v3_well_formed
export rt_hal_executed_access_receipt_v3_matches
export RtHalAutomaticAccessMetadataV1
export rt_hal_automatic_access_metadata_v1
export rt_hal_automatic_access_metadata_v1_well_formed
export RtHalAutomaticExtractionOwnerV1, RtHalAutomaticExtractionReceiptV1
export rt_hal_automatic_extraction_owner_v1
export rt_hal_automatic_extraction_owner_absent_v1
