# ============================================================================
# common/structural/tagmap/tag_codec.spl — CPU reference serializers
#
# CPU reference codec for the frozen TagSchema / tag-value encoding
# (architecture §26 deliverable). This is the oracle: any future vectorized or
# GPU-resident tag encoder must produce byte-identical output.
#
# Layout (little-endian, no padding — see common/structural/wire.spl):
#
#   TagKey     13  namespace u32 | name u32 | value_type u8 | cardinality u8
#                  | lifetime u8 | merge_policy u8 | authority u8
#
#   TagSchema      envelope(8) | version u32 | key_count u32 | TagKey * count
#
#   TagValue       value_type u8 | payload (width depends on value_type)
#                    Marker 0 | Bool 1 | StringId 4 | EntityRef 8
#                    I64/U64/F64/SmallSet 8 | ArtifactId 20 | SourceAnchor 36
#
# Unknown enum discriminants are HARD REJECTED. A tag schema is a contract; a
# reader that silently coerced an unrecognised value_type would let two lanes
# disagree about a tag's meaning while both reported success.
# ============================================================================

use std.common.structural.wire.{
    WIRE_ENVELOPE_LEN,
    wire_check_envelope,
    wire_get_u32,
    wire_get_u64,
    wire_get_u8,
    wire_has,
    wire_magic,
    wire_put_envelope,
    wire_put_u32,
    wire_put_u64,
    wire_put_u8
}
use std.common.structural.identity.entity_id.{
    ARTIFACT_ID_LEN,
    ENTITY_REF_LEN,
    SOURCE_ANCHOR_LEN,
    entity_ref
}
use std.common.structural.identity.identity_codec.{
    artifact_id_put,
    artifact_id_read,
    entity_ref_put,
    entity_ref_read,
    identity_zero_artifact,
    source_anchor_put,
    source_anchor_read
}
use std.common.structural.tagmap.tag_schema.{
    TAGMAP_SCHEMA_VERSION,
    TAG_KEY_LEN,
    TagKey,
    TagSchema,
    TagValue,
    TagValueType,
    tag_authority_from_u8,
    tag_authority_to_u8,
    tag_authority_valid,
    tag_cardinality_from_u8,
    tag_cardinality_to_u8,
    tag_cardinality_valid,
    tag_key,
    tag_lifetime_from_u8,
    tag_lifetime_to_u8,
    tag_lifetime_valid,
    tag_merge_policy_from_u8,
    tag_merge_policy_to_u8,
    tag_merge_policy_valid,
    tag_schema,
    tag_value_type_from_u8,
    tag_value_type_to_u8,
    tag_value_type_valid
}

fn tagmap_magic_schema() -> i64:
    wire_magic("STSC")

fn tagmap_magic_value() -> i64:
    wire_magic("STVL")

# ----------------------------------------------------------------------------
# Result carriers
# ----------------------------------------------------------------------------

struct TagKeyResult:
    ok: bool
    value: TagKey

struct TagSchemaResult:
    ok: bool
    value: TagSchema

struct TagValueResult:
    ok: bool
    consumed: i64
    value: TagValue

fn tagmap_empty_key() -> TagKey:
    tag_key(0, 0,
            tag_value_type_from_u8(0),
            tag_cardinality_from_u8(0),
            tag_lifetime_from_u8(0),
            tag_merge_policy_from_u8(0),
            tag_authority_from_u8(0))

fn tagmap_empty_value() -> TagValue:
    TagValue(value_type: tag_value_type_from_u8(0),
             num: 0,
             ref: entity_ref(0, 0),
             artifact: identity_zero_artifact(),
             anchor: source_anchor_read(tagmap_zero_anchor_bytes(), 0))

fn tagmap_zero_anchor_bytes() -> [u8]:
    """A SOURCE_ANCHOR_LEN run of zero bytes, used to mint a zero SourceAnchor
    without depending on a default-construction rule."""
    var b: [u8] = []
    var i = 0
    while i < SOURCE_ANCHOR_LEN:
        b.push(0)
        i = i + 1
    b

# ----------------------------------------------------------------------------
# TagKey
# ----------------------------------------------------------------------------

fn tag_key_put(out: [u8], k: TagKey) -> [u8]:
    var b = wire_put_u32(out, k.namespace)
    b = wire_put_u32(b, k.name)
    b = wire_put_u8(b, tag_value_type_to_u8(k.value_type))
    b = wire_put_u8(b, tag_cardinality_to_u8(k.cardinality))
    b = wire_put_u8(b, tag_lifetime_to_u8(k.lifetime))
    b = wire_put_u8(b, tag_merge_policy_to_u8(k.merge_policy))
    wire_put_u8(b, tag_authority_to_u8(k.authority))

fn tag_key_read(data: [u8], off: i64) -> TagKeyResult:
    """Read one TagKey. Every enum slot is validated; an unknown discriminant
    fails the whole read rather than defaulting."""
    if not wire_has(data, off, TAG_KEY_LEN):
        return TagKeyResult(ok: false, value: tagmap_empty_key())
    val vt = wire_get_u8(data, off + 8)
    val cd = wire_get_u8(data, off + 9)
    val lt = wire_get_u8(data, off + 10)
    val mp = wire_get_u8(data, off + 11)
    val au = wire_get_u8(data, off + 12)
    if not tag_value_type_valid(vt):
        return TagKeyResult(ok: false, value: tagmap_empty_key())
    if not tag_cardinality_valid(cd):
        return TagKeyResult(ok: false, value: tagmap_empty_key())
    if not tag_lifetime_valid(lt):
        return TagKeyResult(ok: false, value: tagmap_empty_key())
    if not tag_merge_policy_valid(mp):
        return TagKeyResult(ok: false, value: tagmap_empty_key())
    if not tag_authority_valid(au):
        return TagKeyResult(ok: false, value: tagmap_empty_key())
    TagKeyResult(ok: true,
                 value: tag_key(wire_get_u32(data, off),
                                wire_get_u32(data, off + 4),
                                tag_value_type_from_u8(vt),
                                tag_cardinality_from_u8(cd),
                                tag_lifetime_from_u8(lt),
                                tag_merge_policy_from_u8(mp),
                                tag_authority_from_u8(au)))

# ----------------------------------------------------------------------------
# TagSchema
# ----------------------------------------------------------------------------

fn encode_tag_schema(s: TagSchema) -> [u8]:
    var b: [u8] = []
    b = wire_put_envelope(b, tagmap_magic_schema(), TAGMAP_SCHEMA_VERSION)
    b = wire_put_u32(b, s.version)
    b = wire_put_u32(b, s.keys.len())
    var i = 0
    while i < s.keys.len():
        b = tag_key_put(b, s.keys[i])
        i = i + 1
    b

fn decode_tag_schema(data: [u8]) -> TagSchemaResult:
    val empty: [TagKey] = []
    if not wire_check_envelope(data, 0, tagmap_magic_schema(), TAGMAP_SCHEMA_VERSION):
        return TagSchemaResult(ok: false, value: tag_schema(0, empty))
    if not wire_has(data, WIRE_ENVELOPE_LEN, 8):
        return TagSchemaResult(ok: false, value: tag_schema(0, empty))
    val version = wire_get_u32(data, WIRE_ENVELOPE_LEN)
    val count = wire_get_u32(data, WIRE_ENVELOPE_LEN + 4)
    var off = WIRE_ENVELOPE_LEN + 8
    # Reject a truncated or over-long buffer before allocating for `count`.
    if not wire_has(data, off, count * TAG_KEY_LEN):
        return TagSchemaResult(ok: false, value: tag_schema(0, empty))
    if data.len() != off + count * TAG_KEY_LEN:
        return TagSchemaResult(ok: false, value: tag_schema(0, empty))
    var keys: [TagKey] = []
    var i = 0
    while i < count:
        val kr = tag_key_read(data, off)
        if not kr.ok:
            return TagSchemaResult(ok: false, value: tag_schema(0, empty))
        keys.push(kr.value)
        off = off + TAG_KEY_LEN
        i = i + 1
    TagSchemaResult(ok: true, value: tag_schema(version, keys))

# ----------------------------------------------------------------------------
# TagValue
# ----------------------------------------------------------------------------

fn tag_value_payload_len(t: TagValueType) -> i64:
    """Frozen payload width per value type, excluding the 1-byte discriminant."""
    match t:
        case TagValueType.Marker: 0
        case TagValueType.Bool: 1
        case TagValueType.I64: 8
        case TagValueType.U64: 8
        case TagValueType.F64: 8
        case TagValueType.StringId: 4
        case TagValueType.EntityRef: ENTITY_REF_LEN
        case TagValueType.ArtifactId: ARTIFACT_ID_LEN
        case TagValueType.SourceAnchor: SOURCE_ANCHOR_LEN
        case TagValueType.SmallSet: 8

fn tag_value_put(out: [u8], v: TagValue) -> [u8]:
    var b = wire_put_u8(out, tag_value_type_to_u8(v.value_type))
    match v.value_type:
        case TagValueType.Marker: b
        case TagValueType.Bool:
            var one = 0
            if v.num != 0:
                one = 1
            wire_put_u8(b, one)
        case TagValueType.StringId: wire_put_u32(b, v.num)
        case TagValueType.EntityRef: entity_ref_put(b, v.ref)
        case TagValueType.ArtifactId: artifact_id_put(b, v.artifact)
        case TagValueType.SourceAnchor: source_anchor_put(b, v.anchor)
        case _: wire_put_u64(b, v.num)

fn tag_value_read(data: [u8], off: i64) -> TagValueResult:
    """Read one TagValue at `off`, reporting how many bytes it consumed so a
    caller walking a packed run can advance without a second dispatch."""
    if not wire_has(data, off, 1):
        return TagValueResult(ok: false, consumed: 0, value: tagmap_empty_value())
    val raw = wire_get_u8(data, off)
    if not tag_value_type_valid(raw):
        return TagValueResult(ok: false, consumed: 0, value: tagmap_empty_value())
    val vt = tag_value_type_from_u8(raw)
    val plen = tag_value_payload_len(vt)
    if not wire_has(data, off + 1, plen):
        return TagValueResult(ok: false, consumed: 0, value: tagmap_empty_value())
    val body = off + 1
    val total = 1 + plen
    var num = 0
    var eref = entity_ref(0, 0)
    var art = identity_zero_artifact()
    var anc = source_anchor_read(tagmap_zero_anchor_bytes(), 0)
    match vt:
        case TagValueType.Marker: num = 0
        case TagValueType.Bool: num = wire_get_u8(data, body)
        case TagValueType.StringId: num = wire_get_u32(data, body)
        case TagValueType.EntityRef: eref = entity_ref_read(data, body)
        case TagValueType.ArtifactId: art = artifact_id_read(data, body)
        case TagValueType.SourceAnchor: anc = source_anchor_read(data, body)
        case _: num = wire_get_u64(data, body)
    TagValueResult(ok: true, consumed: total,
                   value: TagValue(value_type: vt, num: num, ref: eref,
                                   artifact: art, anchor: anc))

fn encode_tag_value(v: TagValue) -> [u8]:
    """Framed standalone TagValue, for storage outside a packed tag run."""
    var b: [u8] = []
    b = wire_put_envelope(b, tagmap_magic_value(), TAGMAP_SCHEMA_VERSION)
    tag_value_put(b, v)

fn decode_tag_value(data: [u8]) -> TagValueResult:
    if not wire_check_envelope(data, 0, tagmap_magic_value(), TAGMAP_SCHEMA_VERSION):
        return TagValueResult(ok: false, consumed: 0, value: tagmap_empty_value())
    tag_value_read(data, WIRE_ENVELOPE_LEN)
