# ============================================================================
# common/structural/digest — FROZEN Hash256 wire contract v1
#
# Architecture §20.3, §21.3, §26 (contract freeze), §27 (lane ownership).
# Contract document:
#   doc/05_design/platform/structural_compute/hash256_contract_v1.md
#
# `Hash128` stays where it is, in structural/identity (ID-TAG lane). This
# module adds the 256-bit sibling that §26 named in three artifact groups and
# defined in none. It declares no record and no magic: `Hash256` is a field
# type that inherits its embedder's envelope and schema version.
#
# Explicit re-exports only — no `export use *`, which the linter flags for
# exposing unnecessary interface.
# ============================================================================

export use std.common.structural.digest.hash256.{
    HASH256_HEX_LEN,
    HASH256_LEN,
    HASH256_ZERO,
    hash256_byte,
    hash256_hex_nibble,
    hash256_hex_of_byte,
    hash256_hex_valid,
    hash256_is_zero
}

export use std.common.structural.digest.hash256_codec.{
    Hash256DecodeResult,
    Hash256EncodeResult,
    decode_hash256,
    encode_hash256,
    hash256_hex_len,
    hash256_put,
    hash256_read,
    hash256_region_valid
}
