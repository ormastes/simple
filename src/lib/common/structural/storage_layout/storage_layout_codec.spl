# Canonical wire and identity codec for the frozen StorageLayoutPlanV1 shape.
# This adds no fields to V1: any future semantic fields require a ratified V2.

use std.common.base_encoding.utilities.{
    text_to_bytes_linear,
    validated_utf8_bytes_to_text_linear
}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.structural.wire.{
    WIRE_ENVELOPE_LEN,
    wire_check_envelope,
    wire_get_u16,
    wire_get_u64,
    wire_get_u8,
    wire_magic,
    wire_put_envelope,
    wire_put_u16,
    wire_put_u64,
    wire_put_u8
}
use std.common.structural.storage_layout.storage_layout_contracts.{
    STORAGE_LAYOUT_SCHEMA_VERSION,
    StorageConversionPolicy,
    StorageLayoutKind,
    StorageLayoutPlanV1,
    storage_conversion_policy_to_u8,
    storage_layout_kind_to_u8,
    storage_layout_plan_v1,
    storage_layout_plan_v1_well_formed
}

val STORAGE_LAYOUT_WIRE_FIXED_LEN: i64 = WIRE_ENVELOPE_LEN + 32

struct StorageLayoutPlanDecodeResult:
    ok: bool
    value: StorageLayoutPlanV1
    reason: text

fn storage_layout_magic() -> i64:
    wire_magic("SPSL")

fn storage_layout_plan_zero() -> StorageLayoutPlanV1:
    storage_layout_plan_v1(0, StorageLayoutKind.AoS, 1, 1, false,
        StorageConversionPolicy.Never, "", "")

fn storage_layout_kind_valid(value: i64) -> bool:
    value >= 0 and value <= 7

fn storage_conversion_policy_valid(value: i64) -> bool:
    value >= 0 and value <= 3

fn storage_layout_kind_from_u8(value: i64) -> StorageLayoutKind:
    if value == 1: return StorageLayoutKind.SoA
    if value == 2: return StorageLayoutKind.AoSoA
    if value == 3: return StorageLayoutKind.Grouped
    if value == 4: return StorageLayoutKind.Tiled
    if value == 5: return StorageLayoutKind.Packed
    if value == 6: return StorageLayoutKind.FactoredIndex
    if value == 7: return StorageLayoutKind.ExternalFixed
    StorageLayoutKind.AoS

fn storage_conversion_policy_from_u8(value: i64) -> StorageConversionPolicy:
    if value == 1: return StorageConversionPolicy.OnDemand
    if value == 2: return StorageConversionPolicy.Cached
    if value == 3: return StorageConversionPolicy.Pinned
    StorageConversionPolicy.Never

fn storage_layout_append_bytes(out: [u8], source: [u8]) -> [u8]:
    var result = out
    var i = 0
    while i < source.len():
        result.push(source[i])
        i = i + 1
    result

fn storage_layout_slice(data: [u8], start: i64, length: i64) -> [u8]:
    var result: [u8] = []
    var i = 0
    while i < length:
        result.push(data[start + i])
        i = i + 1
    result

fn storage_layout_plan_v1_equal(left: StorageLayoutPlanV1,
                                right: StorageLayoutPlanV1) -> bool:
    left.contract_version == right.contract_version
        and left.logical_type_id == right.logical_type_id
        and storage_layout_kind_to_u8(left.layout) == storage_layout_kind_to_u8(right.layout)
        and left.block_width == right.block_width
        and left.alignment == right.alignment
        and left.abi_pinned == right.abi_pinned
        and storage_conversion_policy_to_u8(left.conversion) == storage_conversion_policy_to_u8(right.conversion)
        and left.policy_hash == right.policy_hash
        and left.decision_reason == right.decision_reason

fn encode_storage_layout_plan(value: StorageLayoutPlanV1) -> [u8]:
    var out: [u8] = []
    if not storage_layout_plan_v1_well_formed(value):
        return out
    val policy = text_to_bytes_linear(value.policy_hash)
    val reason = text_to_bytes_linear(value.decision_reason)
    if policy.len() > 128 or reason.len() > 64:
        return out
    out = wire_put_envelope(out, storage_layout_magic(), STORAGE_LAYOUT_SCHEMA_VERSION)
    out = wire_put_u64(out, value.logical_type_id)
    out = wire_put_u8(out, storage_layout_kind_to_u8(value.layout))
    out = wire_put_u8(out, storage_conversion_policy_to_u8(value.conversion))
    out = wire_put_u8(out, if value.abi_pinned: 1 else: 0)
    out = wire_put_u8(out, 0)
    out = wire_put_u64(out, value.block_width)
    out = wire_put_u64(out, value.alignment)
    out = wire_put_u16(out, policy.len())
    out = wire_put_u16(out, reason.len())
    out = storage_layout_append_bytes(out, policy)
    storage_layout_append_bytes(out, reason)

fn decode_storage_layout_plan(data: [u8]) -> StorageLayoutPlanDecodeResult:
    val zero = storage_layout_plan_zero()
    if data.len() < STORAGE_LAYOUT_WIRE_FIXED_LEN:
        return StorageLayoutPlanDecodeResult(ok: false, value: zero, reason: "truncated")
    if not wire_check_envelope(data, 0, storage_layout_magic(), STORAGE_LAYOUT_SCHEMA_VERSION):
        return StorageLayoutPlanDecodeResult(ok: false, value: zero, reason: "invalid-envelope")
    val off = WIRE_ENVELOPE_LEN
    val layout = wire_get_u8(data, off + 8)
    val conversion = wire_get_u8(data, off + 9)
    val abi = wire_get_u8(data, off + 10)
    if not storage_layout_kind_valid(layout) or not storage_conversion_policy_valid(conversion):
        return StorageLayoutPlanDecodeResult(ok: false, value: zero, reason: "unknown-enum")
    if abi > 1 or wire_get_u8(data, off + 11) != 0:
        return StorageLayoutPlanDecodeResult(ok: false, value: zero, reason: "invalid-reserved")
    val policy_len = wire_get_u16(data, off + 28)
    val reason_len = wire_get_u16(data, off + 30)
    if policy_len <= 0 or policy_len > 128 or reason_len <= 0 or reason_len > 64:
        return StorageLayoutPlanDecodeResult(ok: false, value: zero, reason: "invalid-text-length")
    val payload_len = policy_len + reason_len
    if payload_len < 0 or data.len() - STORAGE_LAYOUT_WIRE_FIXED_LEN != payload_len:
        return StorageLayoutPlanDecodeResult(ok: false, value: zero, reason: "invalid-wire-length")
    val policy_bytes = storage_layout_slice(data, STORAGE_LAYOUT_WIRE_FIXED_LEN, policy_len)
    val reason_bytes = storage_layout_slice(data,
        STORAGE_LAYOUT_WIRE_FIXED_LEN + policy_len, reason_len)
    val policy = match validated_utf8_bytes_to_text_linear(policy_bytes):
        Err(_): return StorageLayoutPlanDecodeResult(ok: false, value: zero, reason: "invalid-policy-utf8")
        Ok(value): value
    val decision_reason = match validated_utf8_bytes_to_text_linear(reason_bytes):
        Err(_): return StorageLayoutPlanDecodeResult(ok: false, value: zero, reason: "invalid-reason-utf8")
        Ok(value): value
    val value = storage_layout_plan_v1(wire_get_u64(data, off),
        storage_layout_kind_from_u8(layout), wire_get_u64(data, off + 12),
        wire_get_u64(data, off + 20), abi == 1,
        storage_conversion_policy_from_u8(conversion), policy, decision_reason)
    if not storage_layout_plan_v1_well_formed(value):
        return StorageLayoutPlanDecodeResult(ok: false, value: zero, reason: "invalid-plan")
    StorageLayoutPlanDecodeResult(ok: true, value: value, reason: "")

fn storage_layout_plan_v1_sha256(value: StorageLayoutPlanV1) -> text:
    val encoded = encode_storage_layout_plan(value)
    if encoded.len() == 0:
        return ""
    sha256_u8_hex(encoded)
