"""Canonical, bounded SCR2 boot-policy wire contract.

SBP2 is the exact Ed25519 signing body.  SBE2 carries SBP2 plus the detached
signature made by an independently pinned boot-media root.  The delegated
SCR2 public key is data authenticated by that root; it is never a root merely
because this record is present on the filesystem.
"""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.string_core.{bytes_to_text}
use std.common.structural.digest.hash256.{hash256_hex_valid}
use std.common.structural.digest.hash256_codec.{hash256_put, hash256_read}
use std.common.structural.wire.{
    wire_magic, wire_envelope_len, wire_check_envelope, wire_has,
    wire_get_u32, wire_put_envelope, wire_put_u8, wire_put_u32
}

pub const SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_BYTES: i64 = 65536
pub const SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_BODY_BYTES: i64 = 32768
pub const SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_IDENTITIES: i64 = 16
pub const SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_ROLES: i64 = 64

pub struct SimpleArtifactReceiptBootPolicySubjectV2:
    policy_identity: text
    delegated_signer_key_id: text
    delegated_public_key: [u8]
    delegated_public_key_sha256: text
    allowed_authority_identities: [text]
    allowed_roles: [text]
    allowed_targets: [ManifestTarget]

pub struct SimpleArtifactReceiptBootPolicyDecodedV2:
    subject: SimpleArtifactReceiptBootPolicySubjectV2
    signing_bytes: [u8]
    boot_signer_key_id: text
    detached_signature: [u8]
    expected_boot_root_sha256: text

class _BootPolicyReaderV2:
    data: [u8]
    offset: i64
    ok: bool
    retained: i64
    retained_limit: i64

    me read_u32() -> i64:
        if not self.ok or not wire_has(self.data, self.offset, 4):
            self.ok = false
            return 0
        val value = wire_get_u32(self.data, self.offset)
        self.offset = self.offset + 4
        value

    me read_text(maximum: i64) -> text:
        val size = self.read_u32()
        if not self.ok or size <= 0 or size > maximum or
            self.retained > self.retained_limit - size or
            not wire_has(self.data, self.offset, size):
            self.ok = false
            return ""
        var raw: [u8] = []
        var index: i64 = 0
        while index < size:
            val byte = self.data[self.offset + index] as i64
            if byte < 33 or byte > 126:
                self.ok = false
                return ""
            raw.push(byte.to_u8())
            index = index + 1
        self.offset = self.offset + size
        self.retained = self.retained + size
        bytes_to_text(raw)

    me read_bytes(maximum: i64) -> [u8]:
        val size = self.read_u32()
        if not self.ok or size <= 0 or size > maximum or
            self.retained > self.retained_limit - size or
            not wire_has(self.data, self.offset, size):
            self.ok = false
            return []
        var value: [u8] = []
        var index: i64 = 0
        while index < size:
            value.push(self.data[self.offset + index])
            index = index + 1
        self.offset = self.offset + size
        self.retained = self.retained + size
        value

fn _put_text_v2(out: [u8], value: text) -> [u8]:
    var next = wire_put_u32(out, value.len())
    var index: i64 = 0
    while index < value.len():
        next = wire_put_u8(next, value.char_code_at(index))
        index = index + 1
    next

fn _put_bytes_v2(out: [u8], value: [u8]) -> [u8]:
    var next = wire_put_u32(out, value.len())
    for byte in value: next = wire_put_u8(next, byte)
    next

fn _identity_valid_v2(value: text, maximum: i64) -> bool:
    if value.len() == 0 or value.len() > maximum or value.contains("*") or
        value.contains(":"):
        return false
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if code < 33 or code > 126: return false
        index = index + 1
    true

fn _target_equal_v2(left: ManifestTarget, right: ManifestTarget) -> bool:
    left.os == right.os and left.arch == right.arch and left.abi == right.abi

fn _canonical_targets_v2() -> [ManifestTarget]:
    [ManifestTarget(os: "simpleos", arch: "x86_64", abi: "simpleos"),
     ManifestTarget(os: "simpleos", arch: "aarch64", abi: "simpleos"),
     ManifestTarget(os: "simpleos", arch: "riscv64", abi: "simpleos")]

fn _subject_valid_v2(subject: SimpleArtifactReceiptBootPolicySubjectV2) -> bool:
    if not _identity_valid_v2(subject.policy_identity, 128) or
        not _identity_valid_v2(subject.delegated_signer_key_id, 128) or
        subject.delegated_public_key.len() != 32 or
        not hash256_hex_valid(subject.delegated_public_key_sha256) or
        sha256_u8_hex(subject.delegated_public_key) !=
            subject.delegated_public_key_sha256 or
        subject.allowed_authority_identities.len() == 0 or
        subject.allowed_authority_identities.len() >
            SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_IDENTITIES or
        subject.allowed_roles.len() == 0 or
        subject.allowed_roles.len() > SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_ROLES:
        return false
    var index: i64 = 0
    while index < subject.allowed_authority_identities.len():
        if not _identity_valid_v2(subject.allowed_authority_identities[index], 128):
            return false
        var prior: i64 = 0
        while prior < index:
            if subject.allowed_authority_identities[prior] ==
                subject.allowed_authority_identities[index]: return false
            prior = prior + 1
        index = index + 1
    index = 0
    while index < subject.allowed_roles.len():
        if not _identity_valid_v2(subject.allowed_roles[index], 64): return false
        var prior: i64 = 0
        while prior < index:
            if subject.allowed_roles[prior] == subject.allowed_roles[index]: return false
            prior = prior + 1
        index = index + 1
    val canonical_targets = _canonical_targets_v2()
    if subject.allowed_targets.len() != canonical_targets.len(): return false
    index = 0
    while index < canonical_targets.len():
        if not _target_equal_v2(subject.allowed_targets[index], canonical_targets[index]):
            return false
        index = index + 1
    true

pub fn simple_artifact_receipt_boot_policy_signing_encode_v2(
    subject: SimpleArtifactReceiptBootPolicySubjectV2,
) -> [u8]?:
    if not _subject_valid_v2(subject): return nil
    var out = wire_put_envelope([], wire_magic("SBP2"), 2)
    out = _put_text_v2(out, subject.policy_identity)
    out = _put_text_v2(out, subject.delegated_signer_key_id)
    out = _put_bytes_v2(out, subject.delegated_public_key)
    out = hash256_put(out, subject.delegated_public_key_sha256)
    out = wire_put_u32(out, subject.allowed_authority_identities.len())
    for authority in subject.allowed_authority_identities:
        out = _put_text_v2(out, authority)
    out = wire_put_u32(out, subject.allowed_roles.len())
    for role in subject.allowed_roles: out = _put_text_v2(out, role)
    out = wire_put_u32(out, subject.allowed_targets.len())
    for target in subject.allowed_targets:
        out = _put_text_v2(out, target.os)
        out = _put_text_v2(out, target.arch)
        out = _put_text_v2(out, target.abi)
    if out.len() > SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_BODY_BYTES: return nil
    Some(out)

pub fn simple_artifact_receipt_boot_policy_signing_decode_v2(
    bytes: [u8],
) -> SimpleArtifactReceiptBootPolicySubjectV2?:
    if bytes.len() == 0 or
        bytes.len() > SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_BODY_BYTES or
        not wire_check_envelope(bytes, 0, wire_magic("SBP2"), 2): return nil
    var reader = _BootPolicyReaderV2(
        data: bytes, offset: wire_envelope_len(), ok: true, retained: 0,
        retained_limit: SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_BODY_BYTES)
    val policy_identity = reader.read_text(128)
    val signer_key_id = reader.read_text(128)
    val public_key = reader.read_bytes(32)
    if not reader.ok or not wire_has(bytes, reader.offset, 32): return nil
    val public_key_sha256 = hash256_read(bytes, reader.offset)
    reader.offset = reader.offset + 32
    val authority_count = reader.read_u32()
    if not reader.ok or authority_count <= 0 or authority_count >
        SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_IDENTITIES: return nil
    var authorities: [text] = []
    var index: i64 = 0
    while reader.ok and index < authority_count:
        authorities.push(reader.read_text(128))
        index = index + 1
    val role_count = reader.read_u32()
    if not reader.ok or role_count <= 0 or
        role_count > SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_ROLES: return nil
    var roles: [text] = []
    index = 0
    while reader.ok and index < role_count:
        roles.push(reader.read_text(64))
        index = index + 1
    val target_count = reader.read_u32()
    if not reader.ok or target_count != 3: return nil
    var targets: [ManifestTarget] = []
    index = 0
    while reader.ok and index < target_count:
        targets.push(ManifestTarget(
            os: reader.read_text(64), arch: reader.read_text(64),
            abi: reader.read_text(64)))
        index = index + 1
    if not reader.ok or reader.offset != bytes.len(): return nil
    val subject = SimpleArtifactReceiptBootPolicySubjectV2(
        policy_identity: policy_identity,
        delegated_signer_key_id: signer_key_id,
        delegated_public_key: public_key,
        delegated_public_key_sha256: public_key_sha256,
        allowed_authority_identities: authorities,
        allowed_roles: roles, allowed_targets: targets)
    val canonical = simple_artifact_receipt_boot_policy_signing_encode_v2(subject)
    if not canonical.? or canonical.unwrap() != bytes: return nil
    Some(subject)

pub fn simple_artifact_receipt_boot_policy_envelope_encode_v2(
    subject: SimpleArtifactReceiptBootPolicySubjectV2,
    boot_signer_key_id: text,
    detached_signature: [u8],
    expected_boot_root_sha256: text,
) -> [u8]?:
    if not _identity_valid_v2(boot_signer_key_id, 128) or
        detached_signature.len() != 64 or
        not hash256_hex_valid(expected_boot_root_sha256): return nil
    val signing = simple_artifact_receipt_boot_policy_signing_encode_v2(subject)
    if not signing.?: return nil
    var out = wire_put_envelope([], wire_magic("SBE2"), 2)
    out = _put_bytes_v2(out, signing.unwrap())
    out = _put_text_v2(out, boot_signer_key_id)
    out = _put_bytes_v2(out, detached_signature)
    out = hash256_put(out, expected_boot_root_sha256)
    if out.len() > SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_BYTES: return nil
    Some(out)

pub fn simple_artifact_receipt_boot_policy_envelope_decode_v2(
    bytes: [u8],
) -> SimpleArtifactReceiptBootPolicyDecodedV2?:
    if bytes.len() == 0 or
        bytes.len() > SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_BYTES or
        not wire_check_envelope(bytes, 0, wire_magic("SBE2"), 2): return nil
    var reader = _BootPolicyReaderV2(
        data: bytes, offset: wire_envelope_len(), ok: true, retained: 0,
        retained_limit: SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_BYTES)
    val signing = reader.read_bytes(
        SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_BODY_BYTES)
    val boot_key_id = reader.read_text(128)
    val signature = reader.read_bytes(64)
    if not reader.ok or not wire_has(bytes, reader.offset, 32): return nil
    val root_sha256 = hash256_read(bytes, reader.offset)
    reader.offset = reader.offset + 32
    if not reader.ok or reader.offset != bytes.len(): return nil
    val subject = simple_artifact_receipt_boot_policy_signing_decode_v2(signing)
    if not subject.?: return nil
    val canonical = simple_artifact_receipt_boot_policy_envelope_encode_v2(
        subject.unwrap(), boot_key_id, signature, root_sha256)
    if not canonical.? or canonical.unwrap() != bytes: return nil
    Some(SimpleArtifactReceiptBootPolicyDecodedV2(
        subject: subject.unwrap(), signing_bytes: signing,
        boot_signer_key_id: boot_key_id, detached_signature: signature,
        expected_boot_root_sha256: root_sha256))
