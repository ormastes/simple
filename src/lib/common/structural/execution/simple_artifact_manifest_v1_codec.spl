# Canonical signing bytes for SimpleArtifactManifest v1.
#
# The signature field is deliberately excluded. The exact image hash is
# included as a separate subject so one signed manifest cannot admit another
# artifact merely by carrying a list that contains several hashes.

use std.common.contracts.execution.simpleos_executable_v1.{
    SimpleArtifactManifest, ManifestArgument, ManifestPreload,
    simple_artifact_manifest_bounds_validate_v1,
    SIMPLE_ARTIFACT_MANIFEST_MAX_COLLECTION_ITEMS_V1,
    SIMPLE_ARTIFACT_MANIFEST_MAX_ELEMENT_BYTES_V1,
    SIMPLE_ARTIFACT_MANIFEST_MAX_SIGNING_BODY_BYTES_V1
}
use std.common.structural.wire.{
    wire_magic, wire_put_envelope, wire_put_u8, wire_put_u32, wire_put_u64
}
use std.common.structural.digest.hash256.{hash256_hex_valid}
use std.common.structural.digest.hash256_codec.{hash256_put}

# Compatibility names for the original SAM1 public surface.  Their values are
# the authoritative installed-manifest bounds rather than a second, looser set.
pub const SIMPLE_ARTIFACT_MANIFEST_V1_MAX_TEXT_BYTES: i64 =
    SIMPLE_ARTIFACT_MANIFEST_MAX_ELEMENT_BYTES_V1
pub const SIMPLE_ARTIFACT_MANIFEST_V1_MAX_LIST_ITEMS: i64 =
    SIMPLE_ARTIFACT_MANIFEST_MAX_COLLECTION_ITEMS_V1
pub const SIMPLE_ARTIFACT_MANIFEST_V1_MAX_SIGNING_BYTES: i64 =
    SIMPLE_ARTIFACT_MANIFEST_MAX_SIGNING_BODY_BYTES_V1

pub struct SimpleArtifactManifestSigningBytesV1:
    ok: bool
    bytes: [u8]

fn _sam_reject() -> SimpleArtifactManifestSigningBytesV1:
    SimpleArtifactManifestSigningBytesV1(ok: false, bytes: [])

fn _sam_text_valid(value: text, allow_empty: bool) -> bool:
    if value.len() > SIMPLE_ARTIFACT_MANIFEST_V1_MAX_TEXT_BYTES:
        return false
    if not allow_empty and value.len() == 0:
        return false
    var i: i64 = 0
    while i < value.len():
        val code = value.char_code_at(i)
        if code < 32 or code > 126:
            return false
        i = i + 1
    true

fn _sam_put_text(out: [u8], value: text) -> [u8]:
    var bytes = wire_put_u32(out, value.len())
    var i: i64 = 0
    while i < value.len():
        bytes = wire_put_u8(bytes, value.char_code_at(i))
        i = i + 1
    bytes

fn _sam_text_list_valid(values: [text]) -> bool:
    if values.len() > SIMPLE_ARTIFACT_MANIFEST_V1_MAX_LIST_ITEMS:
        return false
    for value in values:
        if not _sam_text_valid(value, false):
            return false
    true

fn _sam_put_text_list(out: [u8], values: [text]) -> [u8]:
    var bytes = wire_put_u32(out, values.len())
    for value in values:
        bytes = _sam_put_text(bytes, value)
    bytes

fn _sam_arguments_valid(values: [ManifestArgument]) -> bool:
    if values.len() > SIMPLE_ARTIFACT_MANIFEST_V1_MAX_LIST_ITEMS:
        return false
    for value in values:
        if not _sam_text_valid(value.name, false) or
            not _sam_text_valid(value.value_kind, false) or
            not _sam_text_valid(value.default_value, true):
            return false
    true

fn _sam_put_arguments(out: [u8], values: [ManifestArgument]) -> [u8]:
    var bytes = wire_put_u32(out, values.len())
    for value in values:
        bytes = _sam_put_text(bytes, value.name)
        bytes = _sam_put_text(bytes, value.value_kind)
        bytes = wire_put_u8(bytes, if value.required: 1 else: 0)
        bytes = _sam_put_text(bytes, value.default_value)
    bytes

fn _sam_preloads_valid(values: [ManifestPreload]) -> bool:
    if values.len() > SIMPLE_ARTIFACT_MANIFEST_V1_MAX_LIST_ITEMS:
        return false
    for value in values:
        if value.maximum_bytes < 0 or
            not _sam_text_valid(value.source_arg, true) or
            not _sam_text_valid(value.fixed_path, true) or
            not _sam_text_valid(value.mode, false) or
            not _sam_text_valid(value.access, false) or
            not _sam_text_valid(value.hash_policy, false):
            return false
    true

fn _sam_put_preloads(out: [u8], values: [ManifestPreload]) -> [u8]:
    var bytes = wire_put_u32(out, values.len())
    for value in values:
        bytes = _sam_put_text(bytes, value.source_arg)
        bytes = _sam_put_text(bytes, value.fixed_path)
        bytes = _sam_put_text(bytes, value.mode)
        bytes = wire_put_u8(bytes, if value.required: 1 else: 0)
        bytes = wire_put_u64(bytes, value.maximum_bytes)
        bytes = _sam_put_text(bytes, value.access)
        bytes = wire_put_u8(bytes, if value.prefault: 1 else: 0)
        bytes = _sam_put_text(bytes, value.hash_policy)
    bytes

fn _sam_hashes_valid(values: [text]) -> bool:
    if values.len() == 0 or values.len() > SIMPLE_ARTIFACT_MANIFEST_V1_MAX_LIST_ITEMS:
        return false
    for value in values:
        if not hash256_hex_valid(value):
            return false
    true

fn _sam_put_hashes(out: [u8], values: [text]) -> [u8]:
    var bytes = wire_put_u32(out, values.len())
    for value in values:
        bytes = hash256_put(bytes, value)
    bytes

fn _sam_manifest_valid(m: SimpleArtifactManifest, image_hash: text) -> bool:
    if m.format_version != 1 or not hash256_hex_valid(image_hash):
        return false
    if not simple_artifact_manifest_bounds_validate_v1(m).ok:
        return false
    if m.resource_limits.max_memory_bytes < 0 or
        m.resource_limits.max_open_handles < 0 or
        m.resource_limits.max_threads < 0 or
        m.resource_limits.cpu_budget_us < 0:
        return false
    if not _sam_text_valid(m.artifact_kind, false) or
        not _sam_text_valid(m.target.os, false) or
        not _sam_text_valid(m.target.arch, false) or
        not _sam_text_valid(m.target.abi, false) or
        not _sam_text_valid(m.entrypoint, false) or
        not _sam_text_valid(m.namespace_template, false) or
        not _sam_text_valid(m.interpreter, true) or
        not _sam_text_valid(m.debug_identity, true):
        return false
    _sam_text_list_valid(m.required_abi_features) and
        _sam_text_list_valid(m.required_services) and
        _sam_text_list_valid(m.native_libraries) and
        _sam_text_list_valid(m.smf_libraries) and
        _sam_arguments_valid(m.argument_schema) and
        _sam_preloads_valid(m.startup_preloads) and
        _sam_hashes_valid(m.content_hashes)

pub fn encode_simple_artifact_manifest_v1_signing_bytes(
    m: SimpleArtifactManifest,
    image_hash: text
) -> SimpleArtifactManifestSigningBytesV1:
    if not _sam_manifest_valid(m, image_hash):
        return _sam_reject()
    var bytes = wire_put_envelope([], wire_magic("SAM1"), 1)
    bytes = hash256_put(bytes, image_hash)
    bytes = wire_put_u64(bytes, m.format_version)
    bytes = _sam_put_text(bytes, m.artifact_kind)
    bytes = _sam_put_text(bytes, m.target.os)
    bytes = _sam_put_text(bytes, m.target.arch)
    bytes = _sam_put_text(bytes, m.target.abi)
    bytes = _sam_put_text(bytes, m.entrypoint)
    bytes = _sam_put_text_list(bytes, m.required_abi_features)
    bytes = _sam_put_text_list(bytes, m.required_services)
    bytes = wire_put_u32(bytes, m.required_capabilities as i64)
    bytes = wire_put_u64(bytes, m.resource_limits.max_memory_bytes)
    bytes = wire_put_u64(bytes, m.resource_limits.max_open_handles)
    bytes = wire_put_u64(bytes, m.resource_limits.max_threads)
    bytes = wire_put_u64(bytes, m.resource_limits.cpu_budget_us)
    bytes = _sam_put_text(bytes, m.namespace_template)
    bytes = _sam_put_text_list(bytes, m.native_libraries)
    bytes = _sam_put_text_list(bytes, m.smf_libraries)
    bytes = _sam_put_text(bytes, m.interpreter)
    bytes = _sam_put_arguments(bytes, m.argument_schema)
    bytes = _sam_put_preloads(bytes, m.startup_preloads)
    bytes = _sam_put_hashes(bytes, m.content_hashes)
    bytes = _sam_put_text(bytes, m.debug_identity)
    if bytes.len() > SIMPLE_ARTIFACT_MANIFEST_V1_MAX_SIGNING_BYTES:
        return _sam_reject()
    SimpleArtifactManifestSigningBytesV1(ok: true, bytes: bytes)

export SIMPLE_ARTIFACT_MANIFEST_V1_MAX_TEXT_BYTES
export SIMPLE_ARTIFACT_MANIFEST_V1_MAX_LIST_ITEMS
export SIMPLE_ARTIFACT_MANIFEST_V1_MAX_SIGNING_BYTES
