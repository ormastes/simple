# Versioned execution-cost contract used by structural layout.

val STRUCTURAL_EXECUTION_CONTRACT_VERSION: i64 = 1

struct ExecutionProfile:
    contract_version: i64
    mode: text
    cpu_us: i64
    gpu_kernel_us: i64
    scheduling_us: i64
    host_to_device_bytes: i64
    device_to_host_bytes: i64
    synchronization_points: i64
    transfer_us_per_kib: i64
    sync_us: i64

type LayoutExecutionProfile = ExecutionProfile

struct CostEstimate:
    cpu_us: i64
    gpu_kernel_us: i64
    scheduling_us: i64
    host_to_device_bytes: i64
    device_to_host_bytes: i64
    synchronization_points: i64
    predicted_gpu_us: i64

struct StageReceipt:
    contract_version: i64
    stage: text
    backend: text
    mode: text
    input_hash: text
    output_hash: text
    item_count_in: i64
    item_count_out: i64
    bytes_read: i64
    bytes_written: i64
    fallback_count: i64
    fallback_reason: text
    malformed_count: i64
    overflow_flags: i64
    elapsed_us: i64
    deterministic_hash: text
    visited_island_ids: [i64]
    converged: bool
    iterations: i64
    cpu_us: i64
    gpu_us: i64

type LayoutReceipt = StageReceipt

fn layout_execution_profile(
    mode: text,
    cpu_us: i64,
    gpu_kernel_us: i64,
    scheduling_us: i64,
    host_to_device_bytes: i64,
    device_to_host_bytes: i64,
    synchronization_points: i64,
    transfer_us_per_kib: i64,
    sync_us: i64
) -> LayoutExecutionProfile:
    ExecutionProfile(
        contract_version: STRUCTURAL_EXECUTION_CONTRACT_VERSION,
        mode: mode,
        cpu_us: cpu_us,
        gpu_kernel_us: gpu_kernel_us,
        scheduling_us: scheduling_us,
        host_to_device_bytes: host_to_device_bytes,
        device_to_host_bytes: device_to_host_bytes,
        synchronization_points: synchronization_points,
        transfer_us_per_kib: transfer_us_per_kib,
        sync_us: sync_us
    )

export STRUCTURAL_EXECUTION_CONTRACT_VERSION
export ExecutionProfile, LayoutExecutionProfile, CostEstimate, StageReceipt, LayoutReceipt
export layout_execution_profile
