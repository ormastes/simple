# Canonical generic execution evidence (v2) plus layout-only v1 detail.

val STRUCTURAL_EXECUTION_CONTRACT_VERSION: i64 = 2
val LAYOUT_EXECUTION_CONTRACT_VERSION: i64 = 1

pub enum ExecutionMode:
    CpuReference
    HybridVectorGpu
    ResidentGpu

class Hash256:
    value: text

class StageId:
    value: text

class BackendId:
    value: text

struct CostEstimate:
    cpu_work: u64
    simd_work: u64
    gpu_work: u64
    host_to_device_bytes: u64
    device_to_host_bytes: u64
    ssd_read_bytes: u64
    ssd_write_bytes: u64
    synchronization_points: u32
    predicted_latency_us: u64
    confidence_milli: u16

struct StageReceipt:
    stage: StageId
    backend: BackendId
    mode: ExecutionMode
    input_root: Hash256
    output_root: Hash256
    item_count_in: u64
    item_count_out: u64
    bytes_read: u64
    bytes_written: u64
    fallback_count: u32
    malformed_count: u32
    overflow_flags: u64
    elapsed_us: u64
    deterministic_hash: Hash256

struct LayoutExecutionProfile:
    contract_version: i64
    mode: text
    cpu_us: i64
    gpu_kernel_us: i64
    scheduling_us: i64
    host_to_device_bytes: i64
    device_to_host_bytes: i64
    synchronization_points: i64
    transfer_us_per_kib: i64
    sync_us: i64

struct LayoutCostEstimate:
    cpu_us: i64
    gpu_kernel_us: i64
    scheduling_us: i64
    host_to_device_bytes: i64
    device_to_host_bytes: i64
    synchronization_points: i64
    predicted_gpu_us: i64

struct LayoutReceipt:
    contract_version: i64
    stage: text
    backend: text
    mode: text
    input_hash: text
    output_hash: text
    item_count_in: i64
    item_count_out: i64
    bytes_read: i64
    bytes_written: i64
    fallback_count: i64
    fallback_reason: text
    malformed_count: i64
    overflow_flags: i64
    elapsed_us: i64
    deterministic_hash: text
    visited_island_ids: [i64]
    converged: bool
    iterations: i64
    cpu_us: i64
    gpu_us: i64

fn layout_execution_profile(
    mode: text,
    cpu_us: i64,
    gpu_kernel_us: i64,
    scheduling_us: i64,
    host_to_device_bytes: i64,
    device_to_host_bytes: i64,
    synchronization_points: i64,
    transfer_us_per_kib: i64,
    sync_us: i64
) -> LayoutExecutionProfile:
    LayoutExecutionProfile(
        contract_version: LAYOUT_EXECUTION_CONTRACT_VERSION,
        mode: mode,
        cpu_us: cpu_us,
        gpu_kernel_us: gpu_kernel_us,
        scheduling_us: scheduling_us,
        host_to_device_bytes: host_to_device_bytes,
        device_to_host_bytes: device_to_host_bytes,
        synchronization_points: synchronization_points,
        transfer_us_per_kib: transfer_us_per_kib,
        sync_us: sync_us
    )

export STRUCTURAL_EXECUTION_CONTRACT_VERSION, LAYOUT_EXECUTION_CONTRACT_VERSION
export ExecutionMode, Hash256, StageId, BackendId, CostEstimate, StageReceipt
export LayoutExecutionProfile, LayoutCostEstimate, LayoutReceipt
export layout_execution_profile
