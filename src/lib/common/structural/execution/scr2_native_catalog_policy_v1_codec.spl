"""Canonical boot-root-signed native SCR2 executable catalog.

`SNC2` signs complete, bounded launch templates. `SNE2` envelopes that body
with the detached boot-root signature.  A row is not a legacy SAM1 manifest:
it is a root-authenticated policy keyed by the SCR2 subject's role, authority,
and exact target.  The SCR2 receipt remains the sole authority for artifact
digest, length, and delegated-release signature.
"""

use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestArgument, ManifestPreload, ManifestResourceLimits, ManifestTarget
}
use std.common.string_core.{bytes_to_text}
use std.common.structural.digest.hash256.{hash256_hex_valid}
use std.common.structural.digest.hash256_codec.{hash256_put, hash256_read}
use std.common.structural.wire.{
    wire_magic, wire_envelope_len, wire_check_envelope, wire_has,
    wire_get_u8, wire_get_u32, wire_get_u64, wire_put_envelope, wire_put_u8,
    wire_put_u32, wire_put_u64
}

pub const SCR2_NATIVE_CATALOG_POLICY_V1_MAX_BYTES: i64 = 262144
pub const SCR2_NATIVE_CATALOG_POLICY_V1_MAX_BODY_BYTES: i64 = 131072
pub const SCR2_NATIVE_CATALOG_POLICY_V1_MAX_ROWS: i64 = 64
pub const SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES: i64 = 4096
pub const SCR2_NATIVE_CATALOG_POLICY_V1_MAX_ITEMS: i64 = 64

pub struct Scr2NativeCatalogLaunchTemplateV1:
    artifact_kind: text
    required_abi_features: [text]
    required_services: [text]
    required_capabilities: u32
    resource_limits: ManifestResourceLimits
    namespace_template: text
    native_libraries: [text]
    smf_libraries: [text]
    interpreter: text
    argument_schema: [ManifestArgument]
    startup_preloads: [ManifestPreload]

pub struct Scr2NativeCatalogRecordV1:
    role: text
    authority_identity: text
    target: ManifestTarget
    canonical_path: text
    aliases: [text]
    entrypoint: text
    template: Scr2NativeCatalogLaunchTemplateV1

pub struct Scr2NativeCatalogSubjectV1:
    policy_identity: text
    delegated_signer_key_id: text
    delegated_public_key: [u8]
    delegated_public_key_sha256: text
    records: [Scr2NativeCatalogRecordV1]

pub struct Scr2NativeCatalogDecodedV1:
    subject: Scr2NativeCatalogSubjectV1
    signing_bytes: [u8]
    boot_signer_key_id: text
    detached_signature: [u8]
    expected_boot_root_sha256: text

class _Scr2NativeReaderV1:
    data: [u8]
    offset: i64
    ok: bool
    retained: i64

    me read_u8() -> i64:
        if not self.ok or not wire_has(self.data, self.offset, 1):
            self.ok = false
            return 0
        val value = wire_get_u8(self.data, self.offset)
        self.offset = self.offset + 1
        value

    me read_u32() -> i64:
        if not self.ok or not wire_has(self.data, self.offset, 4):
            self.ok = false
            return 0
        val value = wire_get_u32(self.data, self.offset)
        self.offset = self.offset + 4
        value

    me read_u64() -> i64:
        if not self.ok or not wire_has(self.data, self.offset, 8):
            self.ok = false
            return 0
        val value = wire_get_u64(self.data, self.offset)
        self.offset = self.offset + 8
        if value < 0: self.ok = false
        value

    me read_text(maximum: i64, allow_empty: bool) -> text:
        val size = self.read_u32()
        if not self.ok or size < 0 or size > maximum or
            (not allow_empty and size == 0) or
            self.retained > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_BODY_BYTES - size or
            not wire_has(self.data, self.offset, size):
            self.ok = false
            return ""
        var raw: [u8] = []
        var index: i64 = 0
        while index < size:
            val byte = self.data[self.offset + index] as i64
            if byte < 32 or byte > 126:
                self.ok = false
                return ""
            raw.push(byte.to_u8())
            index = index + 1
        self.offset = self.offset + size
        self.retained = self.retained + size
        bytes_to_text(raw)

    me read_bytes(maximum: i64) -> [u8]:
        val size = self.read_u32()
        if not self.ok or size <= 0 or size > maximum or
            self.retained > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_BODY_BYTES - size or
            not wire_has(self.data, self.offset, size):
            self.ok = false
            return []
        var value: [u8] = []
        var index: i64 = 0
        while index < size:
            value.push(self.data[self.offset + index])
            index = index + 1
        self.offset = self.offset + size
        self.retained = self.retained + size
        value

fn _nput_text(out: [u8], value: text) -> [u8]:
    var next = wire_put_u32(out, value.len())
    var index: i64 = 0
    while index < value.len():
        next = wire_put_u8(next, value.char_code_at(index))
        index = index + 1
    next

fn _nput_bytes(out: [u8], value: [u8]) -> [u8]:
    var next = wire_put_u32(out, value.len())
    for byte in value: next = wire_put_u8(next, byte)
    next

fn _ntext_valid(value: text, maximum: i64, allow_empty: bool) -> bool:
    if value.len() > maximum or (not allow_empty and value.len() == 0): return false
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if code < 32 or code > 126: return false
        index = index + 1
    true

fn _nid_valid(value: text, maximum: i64) -> bool:
    if not _ntext_valid(value, maximum, false) or value.contains("*") or
        value.contains(":"):
        return false
    true

fn _npath_valid(value: text, allow_empty: bool) -> bool:
    if allow_empty and value == "": return true
    _ntext_valid(value, SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES, false) and
        value.starts_with("/") and value != "/" and not value.ends_with("/") and
        not value.contains("\\") and not value.contains("//") and
        not value.contains("/./") and not value.contains("/../") and
        not value.ends_with("/.") and not value.ends_with("/..")

fn _ntarget_valid(target: ManifestTarget) -> bool:
    (target.os == "simpleos" and target.abi == "simpleos") and
        (target.arch == "x86_64" or target.arch == "aarch64" or
            target.arch == "riscv64")

fn _ntarget_equal(left: ManifestTarget, right: ManifestTarget) -> bool:
    left.os == right.os and left.arch == right.arch and left.abi == right.abi

fn _ntext_array_valid(values: [text], allow_empty: bool) -> bool:
    if values.len() > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_ITEMS: return false
    var index: i64 = 0
    while index < values.len():
        if not _ntext_valid(values[index], SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES,
            allow_empty): return false
        var prior: i64 = 0
        while prior < index:
            if values[prior] == values[index]: return false
            prior = prior + 1
        index = index + 1
    true

fn _npaths_valid(values: [text], canonical_path: text) -> bool:
    if values.len() > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_ITEMS: return false
    var index: i64 = 0
    while index < values.len():
        if not _npath_valid(values[index], false) or values[index] == canonical_path:
            return false
        var prior: i64 = 0
        while prior < index:
            if values[prior] == values[index]: return false
            prior = prior + 1
        index = index + 1
    true

fn _narguments_valid(values: [ManifestArgument]) -> bool:
    if values.len() > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_ITEMS: return false
    var index: i64 = 0
    while index < values.len():
        val value = values[index]
        if not _nid_valid(value.name, 128) or
            not _nid_valid(value.value_kind, 128) or
            not _ntext_valid(value.default_value,
                SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES, true): return false
        var prior: i64 = 0
        while prior < index:
            if values[prior].name == value.name: return false
            prior = prior + 1
        index = index + 1
    true

fn _npreloads_valid(values: [ManifestPreload]) -> bool:
    if values.len() > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_ITEMS: return false
    var index: i64 = 0
    while index < values.len():
        val value = values[index]
        if value.maximum_bytes < 0 or
            not _ntext_valid(value.source_arg, 128, true) or
            not _npath_valid(value.fixed_path, true) or
            not _nid_valid(value.mode, 64) or not _nid_valid(value.access, 64) or
            not _nid_valid(value.hash_policy, 64): return false
        if (value.source_arg == "") == (value.fixed_path == ""): return false
        var prior: i64 = 0
        while prior < index:
            if values[prior].source_arg == value.source_arg and
                values[prior].fixed_path == value.fixed_path: return false
            prior = prior + 1
        index = index + 1
    true

fn _ntemplate_valid(template: Scr2NativeCatalogLaunchTemplateV1) -> bool:
    if not _nid_valid(template.artifact_kind, 64) or
        template.resource_limits.max_memory_bytes < 0 or
        template.resource_limits.max_open_handles < 0 or
        template.resource_limits.max_threads < 0 or
        template.resource_limits.cpu_budget_us < 0 or
        not _ntext_valid(template.namespace_template,
            SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES, false) or
        not _npath_valid(template.interpreter, true): return false
    _ntext_array_valid(template.required_abi_features, false) and
        _ntext_array_valid(template.required_services, false) and
        _ntext_array_valid(template.native_libraries, false) and
        _ntext_array_valid(template.smf_libraries, false) and
        _narguments_valid(template.argument_schema) and
        _npreloads_valid(template.startup_preloads)

fn _nrecord_valid(record: Scr2NativeCatalogRecordV1) -> bool:
    _nid_valid(record.role, 64) and _nid_valid(record.authority_identity, 128) and
        _ntarget_valid(record.target) and _npath_valid(record.canonical_path, false) and
        _npaths_valid(record.aliases, record.canonical_path) and
        _npath_valid(record.entrypoint, false) and _ntemplate_valid(record.template)

fn _nrecord_same_key(left: Scr2NativeCatalogRecordV1,
    right: Scr2NativeCatalogRecordV1) -> bool:
    left.role == right.role and left.authority_identity == right.authority_identity and
        _ntarget_equal(left.target, right.target)

fn _nsubject_valid(subject: Scr2NativeCatalogSubjectV1) -> bool:
    if not _nid_valid(subject.policy_identity, 128) or
        not _nid_valid(subject.delegated_signer_key_id, 128) or
        subject.delegated_public_key.len() != 32 or
        not hash256_hex_valid(subject.delegated_public_key_sha256) or
        subject.records.len() == 0 or
        subject.records.len() > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_ROWS:
        return false
    # SHA-256 verification is performed by the boot-policy owner, keeping this
    # pure codec independent from crypto implementation details.
    var index: i64 = 0
    while index < subject.records.len():
        if not _nrecord_valid(subject.records[index]): return false
        var prior: i64 = 0
        while prior < index:
            if _nrecord_same_key(subject.records[prior], subject.records[index]):
                return false
            prior = prior + 1
        index = index + 1
    true

fn _nput_text_array(out: [u8], values: [text]) -> [u8]:
    var next = wire_put_u32(out, values.len())
    for value in values: next = _nput_text(next, value)
    next

fn _nread_text_array(reader: _Scr2NativeReaderV1, allow_empty: bool) -> [text]:
    val count = reader.read_u32()
    if not reader.ok or count < 0 or count > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_ITEMS:
        reader.ok = false
        return []
    var values: [text] = []
    var index: i64 = 0
    while reader.ok and index < count:
        values.push(reader.read_text(SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES,
            allow_empty))
        index = index + 1
    values

fn _nput_arguments(out: [u8], values: [ManifestArgument]) -> [u8]:
    var next = wire_put_u32(out, values.len())
    for value in values:
        next = _nput_text(next, value.name)
        next = _nput_text(next, value.value_kind)
        next = wire_put_u8(next, if value.required: 1 else: 0)
        next = _nput_text(next, value.default_value)
    next

fn _nread_arguments(reader: _Scr2NativeReaderV1) -> [ManifestArgument]:
    val count = reader.read_u32()
    if not reader.ok or count < 0 or count > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_ITEMS:
        reader.ok = false
        return []
    var values: [ManifestArgument] = []
    var index: i64 = 0
    while reader.ok and index < count:
        val name = reader.read_text(128, false)
        val kind = reader.read_text(128, false)
        val required = reader.read_u8()
        if required != 0 and required != 1: reader.ok = false
        val default_value = reader.read_text(SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES, true)
        values.push(ManifestArgument(name: name, value_kind: kind,
            required: required == 1, default_value: default_value))
        index = index + 1
    values

fn _nput_preloads(out: [u8], values: [ManifestPreload]) -> [u8]:
    var next = wire_put_u32(out, values.len())
    for value in values:
        next = _nput_text(next, value.source_arg)
        next = _nput_text(next, value.fixed_path)
        next = _nput_text(next, value.mode)
        next = wire_put_u8(next, if value.required: 1 else: 0)
        next = wire_put_u64(next, value.maximum_bytes)
        next = _nput_text(next, value.access)
        next = wire_put_u8(next, if value.prefault: 1 else: 0)
        next = _nput_text(next, value.hash_policy)
    next

fn _nread_preloads(reader: _Scr2NativeReaderV1) -> [ManifestPreload]:
    val count = reader.read_u32()
    if not reader.ok or count < 0 or count > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_ITEMS:
        reader.ok = false
        return []
    var values: [ManifestPreload] = []
    var index: i64 = 0
    while reader.ok and index < count:
        val source_arg = reader.read_text(128, true)
        val fixed_path = reader.read_text(SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES, true)
        val mode = reader.read_text(64, false)
        val required = reader.read_u8()
        val maximum = reader.read_u64()
        val access = reader.read_text(64, false)
        val prefault = reader.read_u8()
        val hash_policy = reader.read_text(64, false)
        if (required != 0 and required != 1) or (prefault != 0 and prefault != 1):
            reader.ok = false
        values.push(ManifestPreload(source_arg: source_arg, fixed_path: fixed_path,
            mode: mode, required: required == 1, maximum_bytes: maximum,
            access: access, prefault: prefault == 1, hash_policy: hash_policy))
        index = index + 1
    values

fn _nput_record(out: [u8], record: Scr2NativeCatalogRecordV1) -> [u8]:
    var next = _nput_text(out, record.role)
    next = _nput_text(next, record.authority_identity)
    next = _nput_text(next, record.target.os)
    next = _nput_text(next, record.target.arch)
    next = _nput_text(next, record.target.abi)
    next = _nput_text(next, record.canonical_path)
    next = _nput_text_array(next, record.aliases)
    next = _nput_text(next, record.entrypoint)
    val template = record.template
    next = _nput_text(next, template.artifact_kind)
    next = _nput_text_array(next, template.required_abi_features)
    next = _nput_text_array(next, template.required_services)
    next = wire_put_u32(next, template.required_capabilities as i64)
    next = wire_put_u64(next, template.resource_limits.max_memory_bytes)
    next = wire_put_u64(next, template.resource_limits.max_open_handles)
    next = wire_put_u64(next, template.resource_limits.max_threads)
    next = wire_put_u64(next, template.resource_limits.cpu_budget_us)
    next = _nput_text(next, template.namespace_template)
    next = _nput_text_array(next, template.native_libraries)
    next = _nput_text_array(next, template.smf_libraries)
    next = _nput_text(next, template.interpreter)
    next = _nput_arguments(next, template.argument_schema)
    _nput_preloads(next, template.startup_preloads)

fn _nread_record(reader: _Scr2NativeReaderV1) -> Scr2NativeCatalogRecordV1:
    val role = reader.read_text(64, false)
    val authority = reader.read_text(128, false)
    val target = ManifestTarget(os: reader.read_text(64, false),
        arch: reader.read_text(64, false), abi: reader.read_text(64, false))
    val canonical_path = reader.read_text(SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES, false)
    val aliases = _nread_text_array(reader, false)
    val entrypoint = reader.read_text(SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES, false)
    val artifact_kind = reader.read_text(64, false)
    val abi_features = _nread_text_array(reader, false)
    val services = _nread_text_array(reader, false)
    val capabilities = reader.read_u32()
    val limits = ManifestResourceLimits(max_memory_bytes: reader.read_u64(),
        max_open_handles: reader.read_u64(), max_threads: reader.read_u64(),
        cpu_budget_us: reader.read_u64())
    val namespace_template = reader.read_text(SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES, false)
    val native_libraries = _nread_text_array(reader, false)
    val smf_libraries = _nread_text_array(reader, false)
    val interpreter = reader.read_text(SCR2_NATIVE_CATALOG_POLICY_V1_MAX_TEXT_BYTES, true)
    val arguments = _nread_arguments(reader)
    val preloads = _nread_preloads(reader)
    Scr2NativeCatalogRecordV1(role: role, authority_identity: authority,
        target: target, canonical_path: canonical_path, aliases: aliases,
        entrypoint: entrypoint, template: Scr2NativeCatalogLaunchTemplateV1(
            artifact_kind: artifact_kind, required_abi_features: abi_features,
            required_services: services, required_capabilities: capabilities.to_u32(),
            resource_limits: limits, namespace_template: namespace_template,
            native_libraries: native_libraries, smf_libraries: smf_libraries,
            interpreter: interpreter, argument_schema: arguments,
            startup_preloads: preloads))

pub fn scr2_native_catalog_policy_signing_encode_v1(
    subject: Scr2NativeCatalogSubjectV1,
) -> [u8]?:
    if not _nsubject_valid(subject): return nil
    var out = wire_put_envelope([], wire_magic("SNC2"), 1)
    out = _nput_text(out, subject.policy_identity)
    out = _nput_text(out, subject.delegated_signer_key_id)
    out = _nput_bytes(out, subject.delegated_public_key)
    out = hash256_put(out, subject.delegated_public_key_sha256)
    out = wire_put_u32(out, subject.records.len())
    for record in subject.records: out = _nput_record(out, record)
    if out.len() > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_BODY_BYTES: return nil
    Some(out)

pub fn scr2_native_catalog_policy_signing_decode_v1(
    bytes: [u8],
) -> Scr2NativeCatalogSubjectV1?:
    if bytes.len() == 0 or bytes.len() > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_BODY_BYTES or
        not wire_check_envelope(bytes, 0, wire_magic("SNC2"), 1): return nil
    var reader = _Scr2NativeReaderV1(data: bytes, offset: wire_envelope_len(), ok: true,
        retained: 0)
    val identity = reader.read_text(128, false)
    val signer = reader.read_text(128, false)
    val key = reader.read_bytes(32)
    if not reader.ok or not wire_has(bytes, reader.offset, 32): return nil
    val key_hash = hash256_read(bytes, reader.offset)
    reader.offset = reader.offset + 32
    val count = reader.read_u32()
    if not reader.ok or count <= 0 or count > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_ROWS:
        return nil
    var records: [Scr2NativeCatalogRecordV1] = []
    var index: i64 = 0
    while reader.ok and index < count:
        records.push(_nread_record(reader))
        index = index + 1
    if not reader.ok or reader.offset != bytes.len(): return nil
    val subject = Scr2NativeCatalogSubjectV1(policy_identity: identity,
        delegated_signer_key_id: signer, delegated_public_key: key,
        delegated_public_key_sha256: key_hash, records: records)
    val canonical = scr2_native_catalog_policy_signing_encode_v1(subject)
    if not canonical.? or canonical.unwrap() != bytes: return nil
    Some(subject)

pub fn scr2_native_catalog_policy_envelope_encode_v1(
    subject: Scr2NativeCatalogSubjectV1, boot_signer_key_id: text,
    detached_signature: [u8], expected_boot_root_sha256: text,
) -> [u8]?:
    if not _nid_valid(boot_signer_key_id, 128) or detached_signature.len() != 64 or
        not hash256_hex_valid(expected_boot_root_sha256): return nil
    val signing = scr2_native_catalog_policy_signing_encode_v1(subject)
    if not signing.?: return nil
    var out = wire_put_envelope([], wire_magic("SNE2"), 1)
    out = _nput_bytes(out, signing.unwrap())
    out = _nput_text(out, boot_signer_key_id)
    out = _nput_bytes(out, detached_signature)
    out = hash256_put(out, expected_boot_root_sha256)
    if out.len() > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_BYTES: return nil
    Some(out)

pub fn scr2_native_catalog_policy_envelope_decode_v1(
    bytes: [u8],
) -> Scr2NativeCatalogDecodedV1?:
    if bytes.len() == 0 or bytes.len() > SCR2_NATIVE_CATALOG_POLICY_V1_MAX_BYTES or
        not wire_check_envelope(bytes, 0, wire_magic("SNE2"), 1): return nil
    var reader = _Scr2NativeReaderV1(data: bytes, offset: wire_envelope_len(), ok: true,
        retained: 0)
    val signing = reader.read_bytes(SCR2_NATIVE_CATALOG_POLICY_V1_MAX_BODY_BYTES)
    val boot_key_id = reader.read_text(128, false)
    val signature = reader.read_bytes(64)
    if not reader.ok or not wire_has(bytes, reader.offset, 32): return nil
    val root_hash = hash256_read(bytes, reader.offset)
    reader.offset = reader.offset + 32
    if not reader.ok or reader.offset != bytes.len(): return nil
    val subject = scr2_native_catalog_policy_signing_decode_v1(signing)
    if not subject.?: return nil
    val canonical = scr2_native_catalog_policy_envelope_encode_v1(
        subject.unwrap(), boot_key_id, signature, root_hash)
    if not canonical.? or canonical.unwrap() != bytes: return nil
    Some(Scr2NativeCatalogDecodedV1(subject: subject.unwrap(), signing_bytes: signing,
        boot_signer_key_id: boot_key_id, detached_signature: signature,
        expected_boot_root_sha256: root_hash))
