"""Canonical SAM2/SCR2 signed artifact receipt codec.

SAM2 is the exact Ed25519 signing body.  SCR2 carries that body, one detached
signature envelope, and the pinned public-key digest.  Unlike legacy SCR1,
the signing body binds the observed artifact length, its launch role, issuing
authority, target triple, installation names, and entrypoint.
"""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.string_core.{bytes_to_text}
use std.common.structural.digest.hash256.{hash256_hex_valid}
use std.common.structural.digest.hash256_codec.{hash256_put, hash256_read}
use std.common.structural.wire.{
    wire_magic, wire_envelope_len, wire_check_envelope, wire_has,
    wire_get_u32, wire_get_u64, wire_put_envelope, wire_put_u8,
    wire_put_u32, wire_put_u64
}

pub const SIMPLE_ARTIFACT_RECEIPT_V2_MAX_BYTES: i64 = 262144
pub const SIMPLE_ARTIFACT_RECEIPT_V2_MAX_SAM2_BYTES: i64 = 131072
pub const SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ROLE_BYTES: i64 = 64
pub const SIMPLE_ARTIFACT_RECEIPT_V2_MAX_AUTHORITY_BYTES: i64 = 128
pub const SIMPLE_ARTIFACT_RECEIPT_V2_MAX_TEXT_BYTES: i64 = 4096
pub const SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ALIASES: i64 = 64

pub struct SimpleArtifactReceiptSubjectV2:
    artifact_sha256: text
    artifact_byte_count: i64
    role: text
    authority_identity: text
    signature_algorithm: text
    signer_key_id: text
    signer_public_key_sha256: text
    target: ManifestTarget
    canonical_path: text
    aliases: [text]
    entrypoint: text

pub struct SimpleArtifactReceiptDecodedV2:
    subject: SimpleArtifactReceiptSubjectV2
    sam2_bytes: [u8]
    detached_signature: text
    expected_trust_root_sha256: text

class _ReceiptReaderV2:
    data: [u8]
    offset: i64
    ok: bool
    retained: i64

    me read_u32() -> i64:
        if not self.ok or not wire_has(self.data, self.offset, 4):
            self.ok = false
            return 0
        val value = wire_get_u32(self.data, self.offset)
        self.offset = self.offset + 4
        value

    me read_u64_nonnegative() -> i64:
        if not self.ok or not wire_has(self.data, self.offset, 8):
            self.ok = false
            return 0
        val value = wire_get_u64(self.data, self.offset)
        self.offset = self.offset + 8
        if value < 0: self.ok = false
        value

    me read_text(maximum: i64, allow_empty: bool) -> text:
        val size = self.read_u32()
        if not self.ok or size < 0 or size > maximum or
            (not allow_empty and size == 0) or
            self.retained > SIMPLE_ARTIFACT_RECEIPT_V2_MAX_SAM2_BYTES - size or
            not wire_has(self.data, self.offset, size):
            self.ok = false
            return ""
        var raw: [u8] = []
        var index: i64 = 0
        while index < size:
            val byte = self.data[self.offset + index] as i64
            if byte < 32 or byte > 126:
                self.ok = false
                return ""
            raw.push(byte.to_u8())
            index = index + 1
        self.offset = self.offset + size
        self.retained = self.retained + size
        bytes_to_text(raw)

    me read_bytes(maximum: i64) -> [u8]:
        val size = self.read_u32()
        if not self.ok or size <= 0 or size > maximum or
            not wire_has(self.data, self.offset, size):
            self.ok = false
            return []
        var value: [u8] = []
        var index: i64 = 0
        while index < size:
            value.push(self.data[self.offset + index])
            index = index + 1
        self.offset = self.offset + size
        value

fn _receipt_text_valid_v2(value: text, maximum: i64, allow_empty: bool) -> bool:
    if value.len() > maximum or (not allow_empty and value.len() == 0):
        return false
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if code < 32 or code > 126: return false
        index = index + 1
    true

fn _receipt_put_text_v2(out: [u8], value: text) -> [u8]:
    var next = wire_put_u32(out, value.len())
    var index: i64 = 0
    while index < value.len():
        next = wire_put_u8(next, value.char_code_at(index))
        index = index + 1
    next

fn _receipt_put_bytes_v2(out: [u8], value: [u8]) -> [u8]:
    var next = wire_put_u32(out, value.len())
    for byte in value: next = wire_put_u8(next, byte)
    next

fn _receipt_absolute_path_valid_v2(value: text) -> bool:
    if not _receipt_text_valid_v2(
        value, SIMPLE_ARTIFACT_RECEIPT_V2_MAX_TEXT_BYTES, false) or
        not value.starts_with("/") or value == "/" or value.ends_with("/") or
        value.contains("\\") or value.contains("//") or value.contains("/./") or
        value.contains("/../") or value.ends_with("/.") or
        value.ends_with("/.."):
        return false
    true

fn _receipt_subject_valid_v2(subject: SimpleArtifactReceiptSubjectV2) -> bool:
    if not hash256_hex_valid(subject.artifact_sha256) or
        subject.artifact_byte_count <= 0 or
        not _receipt_text_valid_v2(
            subject.role, SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ROLE_BYTES, false) or
        not _receipt_text_valid_v2(
            subject.authority_identity,
            SIMPLE_ARTIFACT_RECEIPT_V2_MAX_AUTHORITY_BYTES, false) or
        subject.signature_algorithm != "ed25519" or
        not _receipt_text_valid_v2(
            subject.signer_key_id,
            SIMPLE_ARTIFACT_RECEIPT_V2_MAX_AUTHORITY_BYTES, false) or
        subject.signer_key_id.contains(":") or
        not hash256_hex_valid(subject.signer_public_key_sha256) or
        not _receipt_text_valid_v2(
            subject.target.os, SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ROLE_BYTES, false) or
        not _receipt_text_valid_v2(
            subject.target.arch, SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ROLE_BYTES, false) or
        not _receipt_text_valid_v2(
            subject.target.abi, SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ROLE_BYTES, false) or
        not _receipt_absolute_path_valid_v2(subject.canonical_path) or
        not _receipt_absolute_path_valid_v2(subject.entrypoint) or
        subject.aliases.len() > SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ALIASES:
        return false
    var index: i64 = 0
    while index < subject.aliases.len():
        val alias = subject.aliases[index]
        if not _receipt_absolute_path_valid_v2(alias) or
            alias == subject.canonical_path:
            return false
        var prior: i64 = 0
        while prior < index:
            if subject.aliases[prior] == alias: return false
            prior = prior + 1
        index = index + 1
    true

pub fn simple_artifact_receipt_sam2_encode_v2(
    subject: SimpleArtifactReceiptSubjectV2,
) -> [u8]?:
    if not _receipt_subject_valid_v2(subject): return nil
    var out = wire_put_envelope([], wire_magic("SAM2"), 2)
    out = hash256_put(out, subject.artifact_sha256)
    out = wire_put_u64(out, subject.artifact_byte_count)
    out = _receipt_put_text_v2(out, subject.role)
    out = _receipt_put_text_v2(out, subject.authority_identity)
    out = _receipt_put_text_v2(out, subject.signature_algorithm)
    out = _receipt_put_text_v2(out, subject.signer_key_id)
    out = hash256_put(out, subject.signer_public_key_sha256)
    out = _receipt_put_text_v2(out, subject.target.os)
    out = _receipt_put_text_v2(out, subject.target.arch)
    out = _receipt_put_text_v2(out, subject.target.abi)
    out = _receipt_put_text_v2(out, subject.canonical_path)
    out = wire_put_u32(out, subject.aliases.len())
    for alias in subject.aliases: out = _receipt_put_text_v2(out, alias)
    out = _receipt_put_text_v2(out, subject.entrypoint)
    if out.len() > SIMPLE_ARTIFACT_RECEIPT_V2_MAX_SAM2_BYTES: return nil
    Some(out)

pub fn simple_artifact_receipt_sam2_decode_v2(
    bytes: [u8],
) -> SimpleArtifactReceiptSubjectV2?:
    if bytes.len() == 0 or
        bytes.len() > SIMPLE_ARTIFACT_RECEIPT_V2_MAX_SAM2_BYTES or
        not wire_check_envelope(bytes, 0, wire_magic("SAM2"), 2):
        return nil
    var reader = _ReceiptReaderV2(
        data: bytes, offset: wire_envelope_len(), ok: true, retained: 0)
    if not wire_has(bytes, reader.offset, 32): return nil
    val digest = hash256_read(bytes, reader.offset)
    reader.offset = reader.offset + 32
    val byte_count = reader.read_u64_nonnegative()
    val role = reader.read_text(SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ROLE_BYTES, false)
    val authority = reader.read_text(
        SIMPLE_ARTIFACT_RECEIPT_V2_MAX_AUTHORITY_BYTES, false)
    val algorithm = reader.read_text(
        SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ROLE_BYTES, false)
    val key_id = reader.read_text(
        SIMPLE_ARTIFACT_RECEIPT_V2_MAX_AUTHORITY_BYTES, false)
    if not reader.ok or not wire_has(bytes, reader.offset, 32): return nil
    val public_key_sha256 = hash256_read(bytes, reader.offset)
    reader.offset = reader.offset + 32
    val target = ManifestTarget(
        os: reader.read_text(SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ROLE_BYTES, false),
        arch: reader.read_text(SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ROLE_BYTES, false),
        abi: reader.read_text(SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ROLE_BYTES, false))
    val path = reader.read_text(SIMPLE_ARTIFACT_RECEIPT_V2_MAX_TEXT_BYTES, false)
    val alias_count = reader.read_u32()
    if not reader.ok or alias_count < 0 or
        alias_count > SIMPLE_ARTIFACT_RECEIPT_V2_MAX_ALIASES:
        return nil
    var aliases: [text] = []
    var index: i64 = 0
    while reader.ok and index < alias_count:
        aliases.push(reader.read_text(
            SIMPLE_ARTIFACT_RECEIPT_V2_MAX_TEXT_BYTES, false))
        index = index + 1
    val entrypoint = reader.read_text(
        SIMPLE_ARTIFACT_RECEIPT_V2_MAX_TEXT_BYTES, false)
    if not reader.ok or reader.offset != bytes.len(): return nil
    val subject = SimpleArtifactReceiptSubjectV2(
        artifact_sha256: digest, artifact_byte_count: byte_count,
        role: role, authority_identity: authority, target: target,
        signature_algorithm: algorithm, signer_key_id: key_id,
        signer_public_key_sha256: public_key_sha256,
        canonical_path: path, aliases: aliases, entrypoint: entrypoint)
    val canonical = simple_artifact_receipt_sam2_encode_v2(subject)
    if not canonical.? or canonical.unwrap() != bytes: return nil
    Some(subject)

pub fn simple_artifact_receipt_scr2_encode_v2(
    subject: SimpleArtifactReceiptSubjectV2,
    detached_signature: text,
    expected_trust_root_sha256: text,
) -> [u8]?:
    if not _receipt_text_valid_v2(detached_signature, 512, false) or
        not hash256_hex_valid(expected_trust_root_sha256):
        return nil
    val sam2 = simple_artifact_receipt_sam2_encode_v2(subject)
    if not sam2.?: return nil
    var out = wire_put_envelope([], wire_magic("SCR2"), 2)
    out = _receipt_put_bytes_v2(out, sam2.unwrap())
    out = _receipt_put_text_v2(out, detached_signature)
    out = hash256_put(out, expected_trust_root_sha256)
    if out.len() > SIMPLE_ARTIFACT_RECEIPT_V2_MAX_BYTES: return nil
    Some(out)

pub fn simple_artifact_receipt_scr2_decode_v2(
    bytes: [u8],
) -> SimpleArtifactReceiptDecodedV2?:
    if bytes.len() == 0 or bytes.len() > SIMPLE_ARTIFACT_RECEIPT_V2_MAX_BYTES or
        not wire_check_envelope(bytes, 0, wire_magic("SCR2"), 2):
        return nil
    var reader = _ReceiptReaderV2(
        data: bytes, offset: wire_envelope_len(), ok: true, retained: 0)
    val sam2 = reader.read_bytes(SIMPLE_ARTIFACT_RECEIPT_V2_MAX_SAM2_BYTES)
    val signature = reader.read_text(512, false)
    if not reader.ok or not wire_has(bytes, reader.offset, 32): return nil
    val root_hash = hash256_read(bytes, reader.offset)
    reader.offset = reader.offset + 32
    if reader.offset != bytes.len(): return nil
    val subject = simple_artifact_receipt_sam2_decode_v2(sam2)
    if not subject.?: return nil
    val canonical = simple_artifact_receipt_scr2_encode_v2(
        subject.unwrap(), signature, root_hash)
    if not canonical.? or canonical.unwrap() != bytes: return nil
    Some(SimpleArtifactReceiptDecodedV2(
        subject: subject.unwrap(), sam2_bytes: sam2,
        detached_signature: signature,
        expected_trust_root_sha256: root_hash))
