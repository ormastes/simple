# ============================================================================
# common/structural/mapping/mapping_edge.spl — FROZEN mapping contract v1
#
# Architecture: doc/04_architecture/compiler/mdsoc/
#   mdsoc_plus_tagged_structural_compute_architecture.md §6 (MappingGraph and
#   provenance), §26 (contract freeze), §27 (MAP lane owns structural/mapping).
#
# Wave 0b of the contract-freeze phase. Freezes artifact group 3 of §26:
# "MappingKind and compressed mapping format".
#
# Conventions are inherited unchanged from the ID-TAG lane (wave 0a): all
# integers little-endian, fixed width, no padding, no alignment; every enum is a
# u8 discriminant; every top-level record carries the 8-byte wire envelope; an
# unknown enum discriminant or a set reserved bit is a HARD REJECT, never a
# silent default. See common/structural/wire.spl and
# doc/05_design/platform/structural_compute/identity_tagmap_contract_v1.md.
#
# MappingKind itself is NOT redeclared here. It already exists in this lane's
# contracts.spl with exactly the §6.2 variants in exactly the §6.2 order, and is
# already imported by the layout lane and by
# src/compiler/00.common/structural_contracts/sidecars.spl. Two declarations of
# one wire enum is precisely how two lanes come to disagree about a discriminant
# while both report success, so this module imports the existing enum and adds
# the wire mapping to it.
#
# FROZEN: enum discriminants are wire values. A discriminant is never reused and
# never renumbered; new variants take the next free number.
# ============================================================================

use std.common.structural.identity.entity_id.{ENTITY_REF_LEN, EntityRef, entity_ref, entity_ref_equal}
use std.common.structural.mapping.contracts.{MappingKind}

val MAPPING_SCHEMA_VERSION: i64 = 1

# ----------------------------------------------------------------------------
# MappingKind (§6.2) — fully enumerated by the architecture; frozen as given,
# in declaration order, starting at 0.
# ----------------------------------------------------------------------------

fn mapping_kind_to_u8(k: MappingKind) -> i64:
    match k:
        case MappingKind.ParsedFrom: 0
        case MappingKind.ExpandedFrom: 1
        case MappingKind.DesugaredFrom: 2
        case MappingKind.ResolvedFrom: 3
        case MappingKind.LoweredFrom: 4
        case MappingKind.ClonedFrom: 5
        case MappingKind.InlinedFrom: 6
        case MappingKind.WovenFrom: 7
        case MappingKind.OptimizedFrom: 8
        case MappingKind.GeneratedFrom: 9
        case MappingKind.LinkedFrom: 10
        case MappingKind.Styles: 11
        case MappingKind.CascadesInto: 12
        case MappingKind.LayoutOf: 13
        case MappingKind.PaintOf: 14
        case MappingKind.HitRegionOf: 15
        case MappingKind.InvalidatedBy: 16

val MAPPING_KIND_MAX: i64 = 16
val MAPPING_KIND_COUNT: i64 = 17

fn mapping_kind_from_u8(v: i64) -> MappingKind:
    """Caller MUST gate on `mapping_kind_valid` first; this maps only known
    discriminants and pins anything else to ParsedFrom so the function stays
    total (same rule as tag_value_type_from_u8)."""
    match v:
        case 1: MappingKind.ExpandedFrom
        case 2: MappingKind.DesugaredFrom
        case 3: MappingKind.ResolvedFrom
        case 4: MappingKind.LoweredFrom
        case 5: MappingKind.ClonedFrom
        case 6: MappingKind.InlinedFrom
        case 7: MappingKind.WovenFrom
        case 8: MappingKind.OptimizedFrom
        case 9: MappingKind.GeneratedFrom
        case 10: MappingKind.LinkedFrom
        case 11: MappingKind.Styles
        case 12: MappingKind.CascadesInto
        case 13: MappingKind.LayoutOf
        case 14: MappingKind.PaintOf
        case 15: MappingKind.HitRegionOf
        case 16: MappingKind.InvalidatedBy
        case _: MappingKind.ParsedFrom

fn mapping_kind_valid(v: i64) -> bool:
    v >= 0 and v <= MAPPING_KIND_MAX

fn mapping_kind_equal(a: MappingKind, b: MappingKind) -> bool:
    mapping_kind_to_u8(a) == mapping_kind_to_u8(b)

# ----------------------------------------------------------------------------
# MappingKindSet (§6.4) — DERIVED, not stated by the architecture.
#
# §6.4 passes `kind_mask: MappingKindSet` to `forward` and `reverse` but never
# defines the type. The parameter name is `kind_mask` and §6.2 enumerates 17
# kinds, so the minimum vocabulary that reading actually distinguishes is a
# bitset with one bit per MappingKind discriminant. 17 bits do not fit a u16, so
# the smallest fixed width that holds the frozen enum is u32.
#
# Bits 17..31 are RESERVED and MUST be zero. A set reserved bit is a hard
# reject: a reader that ignored it would silently answer a query about kinds it
# does not know, which is the same failure mode as coercing an unknown enum
# discriminant.
#
# Raised back to the architecture owner for ratification — see §"Underspecified
# in §6" in the contract document.
# ----------------------------------------------------------------------------

val MAPPING_KIND_SET_LEN: i64 = 4
val MAPPING_KIND_SET_ALL: i64 = 0x1FFFF
val MAPPING_KIND_SET_EMPTY: i64 = 0

fn mapping_kind_set_valid(raw: i64) -> bool:
    """True when no reserved bit is set."""
    raw >= 0 and (raw & 0x1FFFF) == raw

fn mapping_kind_bit(k: MappingKind) -> i64:
    1 << mapping_kind_to_u8(k)

fn mapping_kind_set_add(set: i64, k: MappingKind) -> i64:
    set | mapping_kind_bit(k)

fn mapping_kind_set_contains(set: i64, k: MappingKind) -> bool:
    (set & mapping_kind_bit(k)) != 0

fn mapping_kind_set_of(kinds: [MappingKind]) -> i64:
    var s = MAPPING_KIND_SET_EMPTY
    var i = 0
    while i < kinds.len():
        s = mapping_kind_set_add(s, kinds[i])
        i = i + 1
    s

# ----------------------------------------------------------------------------
# MappingFlags (§6.2) — DERIVED, not enumerated by the architecture.
#
# §6.2 declares the field and never lists a single flag. Rather than invent a
# vocabulary, this freezes the wire SLOT (u32 bitfield) and defines only the
# bits that the surrounding prose actually forces into existence. Each bit
# below cites the sentence that requires it:
#
#   bit 0  WEIGHT_VALID — §6.2: "`weight_milli` is optional diagnostic
#          attribution". Without a bit there is no way to distinguish an edge
#          that attributes 0/1000 from an edge that supplied no attribution at
#          all, so "optional" is unrepresentable.
#
#   bit 1  SYNTHETIC — §6.5 `Synthesize`, and §6.1 "or synthesize entities":
#          the target of this edge has no true source origin. §6.1 opens by
#          arguing that a single source pointer is insufficient precisely
#          because entities are synthesized.
#
#   bit 2  DISCARDED — §6.5 `DiscardWithReason` plus "A pass cannot silently
#          drop origins." A dropped origin that is not recorded as an edge is
#          exactly the silent drop the rule forbids, so a discarded origin must
#          still be representable on the wire.
#
# Bits 3..31 are RESERVED and MUST be zero; a set reserved bit is a hard
# reject. Raised for ratification.
# ----------------------------------------------------------------------------

val MAPPING_FLAGS_LEN: i64 = 4
val MAPPING_FLAG_NONE: i64 = 0
val MAPPING_FLAG_WEIGHT_VALID: i64 = 1
val MAPPING_FLAG_SYNTHETIC: i64 = 2
val MAPPING_FLAG_DISCARDED: i64 = 4
val MAPPING_FLAGS_KNOWN: i64 = 7

fn mapping_flags_valid(raw: i64) -> bool:
    raw >= 0 and (raw & MAPPING_FLAGS_KNOWN) == raw

fn mapping_flags_has(flags: i64, bit: i64) -> bool:
    (flags & bit) != 0

# ----------------------------------------------------------------------------
# OriginPolicy (§6.5) — fully enumerated by the architecture; frozen as given.
#
# Declared per transformation, not per edge, so it is not part of MappingEdge.
# It is frozen here because it is the rule that governs which edges a pass is
# permitted to emit, and every lane must agree on its discriminants.
# ----------------------------------------------------------------------------

enum OriginPolicy:
    PreserveOneToOne
    Split
    Merge
    Clone
    Synthesize
    DiscardWithReason

fn origin_policy_to_u8(p: OriginPolicy) -> i64:
    match p:
        case OriginPolicy.PreserveOneToOne: 0
        case OriginPolicy.Split: 1
        case OriginPolicy.Merge: 2
        case OriginPolicy.Clone: 3
        case OriginPolicy.Synthesize: 4
        case OriginPolicy.DiscardWithReason: 5

val ORIGIN_POLICY_MAX: i64 = 5

fn origin_policy_from_u8(v: i64) -> OriginPolicy:
    match v:
        case 1: OriginPolicy.Split
        case 2: OriginPolicy.Merge
        case 3: OriginPolicy.Clone
        case 4: OriginPolicy.Synthesize
        case 5: OriginPolicy.DiscardWithReason
        case _: OriginPolicy.PreserveOneToOne

fn origin_policy_valid(v: i64) -> bool:
    v >= 0 and v <= ORIGIN_POLICY_MAX

# ----------------------------------------------------------------------------
# MappingEdge (§6.2)
#
# Field order on the wire is the declaration order given in §6.2:
#   from, to, kind, transform, flags, weight_milli.
#
# `transform: TransformInstanceId` has no declared width; TransformInstanceId
# appears exactly once in the whole repository, at that field declaration.
# Frozen at u32 under the scalar-width rule the ID-TAG lane already ratified in
# ae87d52fbdf (undeclared identity scalars are u32). Raised for ratification.
#
# `weight_milli: u16` is declared by §6.2 and frozen as given. Its meaning is
# thousandths, so 1000 is a whole share; §6.2's own worked example attributes
# 600/400 across two inputs.
# ----------------------------------------------------------------------------

val MAPPING_EDGE_LEN: i64 = 27

struct MappingEdge:
    """One provenance edge (§6.2). 27 bytes on the wire, no padding.

    `from` and `to` are snapshot-local EntityRefs, so an edge is only meaningful
    inside the shard's snapshot; durable provenance is obtained by resolving
    through EntityKey (§4.2), not by storing edges across revisions.
    """
    from_ref: EntityRef
    to_ref: EntityRef
    kind: MappingKind
    transform: u32
    flags: u32
    weight_milli: u16

fn mapping_edge(from_ref: EntityRef, to_ref: EntityRef, kind: MappingKind,
                transform: u32, flags: u32, weight_milli: u16) -> MappingEdge:
    MappingEdge(from_ref: from_ref, to_ref: to_ref, kind: kind,
                transform: transform, flags: flags, weight_milli: weight_milli)

fn mapping_edge_equal(a: MappingEdge, b: MappingEdge) -> bool:
    """Explicit field-wise equality, not engine struct equality, which differs
    between the interpreter and native codegen for nested structs."""
    entity_ref_equal(a.from_ref, b.from_ref)
        and entity_ref_equal(a.to_ref, b.to_ref)
        and mapping_kind_equal(a.kind, b.kind)
        and a.transform == b.transform
        and a.flags == b.flags
        and a.weight_milli == b.weight_milli

fn mapping_edge_weight_or_default(e: MappingEdge) -> i64:
    """§6.2 makes weight optional. An edge that did not set WEIGHT_VALID
    attributes a full share (1000 milli), because a merged instruction with no
    stated split still fully derives from each listed input."""
    if mapping_flags_has(e.flags, MAPPING_FLAG_WEIGHT_VALID):
        return e.weight_milli
    1000

fn mapping_zero_edge() -> MappingEdge:
    mapping_edge(entity_ref(0, 0), entity_ref(0, 0), MappingKind.ParsedFrom,
                 0, 0, 0)

# ----------------------------------------------------------------------------
# MappingShard — the compressed mapping format (§6.3)
#
# §6.3 states the storage form as four arrays:
#
#     from_offsets[]
#     from_edges[]
#     reverse_offsets[]    # built only when demanded
#     reverse_edges[]
#
# That is compressed sparse row. This freezes it with the invariants that make
# it decodable and verifiable:
#
#   - `from_offsets` has node_count + 1 entries, is non-decreasing, starts at 0
#     and ends at edge_count. Edges for node n are from_offsets[n]
#     .. from_offsets[n+1].
#   - `reverse_edges` holds u32 INDICES into from_edges, not duplicated edges.
#     §6.3 calls the structure "the reverse index" and says a stage "can emit
#     forward edges cheaply and construct the reverse index lazily"; an index
#     that duplicated every edge body would not be cheap and would let the two
#     copies disagree.
#   - The reverse arrays are optional, matching "built only when demanded".
#     Presence is carried by an explicit u8 rather than by a padded flags word,
#     because the wire convention forbids padding.
# ----------------------------------------------------------------------------

struct MappingShard:
    """A compressed sparse-adjacency provenance shard (§6.3)."""
    version: u32
    node_count: u32
    from_offsets: [u32]
    edges: [MappingEdge]
    has_reverse: bool
    reverse_node_count: u32
    reverse_offsets: [u32]
    reverse_edges: [u32]

fn mapping_shard_forward(version: u32, node_count: u32, from_offsets: [u32],
                         edges: [MappingEdge]) -> MappingShard:
    """A forward-only shard, the cheap form §6.3 says a stage emits first."""
    val no_off: [u32] = []
    val no_idx: [u32] = []
    MappingShard(version: version, node_count: node_count,
                 from_offsets: from_offsets, edges: edges,
                 has_reverse: false, reverse_node_count: 0,
                 reverse_offsets: no_off, reverse_edges: no_idx)

fn mapping_shard(version: u32, node_count: u32, from_offsets: [u32],
                 edges: [MappingEdge], reverse_node_count: u32,
                 reverse_offsets: [u32], reverse_edges: [u32]) -> MappingShard:
    MappingShard(version: version, node_count: node_count,
                 from_offsets: from_offsets, edges: edges,
                 has_reverse: true, reverse_node_count: reverse_node_count,
                 reverse_offsets: reverse_offsets, reverse_edges: reverse_edges)

fn mapping_offsets_well_formed(offsets: [u32], node_count: i64,
                               edge_count: i64) -> bool:
    """The CSR invariant, applied identically on encode and decode so no lane
    can emit a shard another lane must reject."""
    if offsets.len() != node_count + 1:
        return false
    if offsets[0] != 0:
        return false
    if offsets[node_count] != edge_count:
        return false
    var i = 1
    while i <= node_count:
        if offsets[i] < offsets[i - 1]:
            return false
        i = i + 1
    true

fn mapping_shard_valid(s: MappingShard) -> bool:
    """Full structural validity. This is the CPU reference rule: a GPU-resident
    or vectorized builder must accept exactly this set of shards."""
    if not mapping_offsets_well_formed(s.from_offsets, s.node_count, s.edges.len()):
        return false
    var i = 0
    while i < s.edges.len():
        if not mapping_flags_valid(s.edges[i].flags):
            return false
        i = i + 1
    if not s.has_reverse:
        return s.reverse_offsets.len() == 0 and s.reverse_edges.len() == 0
    # The reverse index is a CSR over reverse_edges, so its terminal offset is
    # the reverse_edges length, not the forward edge count. Those two differ
    # whenever an edge points at a target outside the reverse node range, which
    # a lazily built partial index legitimately does (§6.3).
    if not mapping_offsets_well_formed(s.reverse_offsets, s.reverse_node_count,
                                       s.reverse_edges.len()):
        return false
    if s.reverse_edges.len() > s.edges.len():
        return false
    var j = 0
    while j < s.reverse_edges.len():
        if s.reverse_edges[j] >= s.edges.len():
            return false
        j = j + 1
    true

fn mapping_shard_equal(a: MappingShard, b: MappingShard) -> bool:
    if a.version != b.version or a.node_count != b.node_count:
        return false
    if a.has_reverse != b.has_reverse:
        return false
    if a.from_offsets.len() != b.from_offsets.len():
        return false
    var i = 0
    while i < a.from_offsets.len():
        if a.from_offsets[i] != b.from_offsets[i]:
            return false
        i = i + 1
    if a.edges.len() != b.edges.len():
        return false
    var e = 0
    while e < a.edges.len():
        if not mapping_edge_equal(a.edges[e], b.edges[e]):
            return false
        e = e + 1
    if a.reverse_node_count != b.reverse_node_count:
        return false
    if a.reverse_offsets.len() != b.reverse_offsets.len():
        return false
    var r = 0
    while r < a.reverse_offsets.len():
        if a.reverse_offsets[r] != b.reverse_offsets[r]:
            return false
        r = r + 1
    if a.reverse_edges.len() != b.reverse_edges.len():
        return false
    var x = 0
    while x < a.reverse_edges.len():
        if a.reverse_edges[x] != b.reverse_edges[x]:
            return false
        x = x + 1
    true

# ----------------------------------------------------------------------------
# Forward / reverse traversal — the CPU reference implementation of the §6.4
# read port's `kind_mask` filtering.
# ----------------------------------------------------------------------------

fn mapping_forward_edges(s: MappingShard, node: i64, kind_mask: i64) -> [MappingEdge]:
    """Edges leaving `node` whose kind is in `kind_mask`. An out-of-range node
    yields the empty set rather than trapping: §4.1 makes an EntityRef
    snapshot-local, so querying a node this shard does not cover is a normal
    miss, not an error."""
    var out: [MappingEdge] = []
    if node < 0 or node >= s.node_count:
        return out
    var i = s.from_offsets[node]
    val end = s.from_offsets[node + 1]
    while i < end:
        if mapping_kind_set_contains(kind_mask, s.edges[i].kind):
            out.push(s.edges[i])
        i = i + 1
    out

fn mapping_reverse_edges(s: MappingShard, node: i64, kind_mask: i64) -> [MappingEdge]:
    """Edges arriving at `node`. Returns empty when the reverse index has not
    been built, which §6.3 permits; a caller that needs it must demand it."""
    var out: [MappingEdge] = []
    if not s.has_reverse:
        return out
    if node < 0 or node >= s.reverse_node_count:
        return out
    var i = s.reverse_offsets[node]
    val end = s.reverse_offsets[node + 1]
    while i < end:
        val idx = s.reverse_edges[i]
        if mapping_kind_set_contains(kind_mask, s.edges[idx].kind):
            out.push(s.edges[idx])
        i = i + 1
    out

fn mapping_build_reverse(s: MappingShard, reverse_node_count: u32) -> MappingShard:
    """Build the reverse index on demand (§6.3 'built only when demanded').

    Counting sort over `to_ref.local_index`, which keeps the produced shard
    deterministic: two builders that see the same forward edges in the same
    order produce byte-identical reverse arrays, which is what lets the golden
    vectors freeze the format at all.
    """
    var counts: [u32] = []
    var i = 0
    while i <= reverse_node_count:
        counts.push(0)
        i = i + 1
    var e = 0
    while e < s.edges.len():
        val t = s.edges[e].to_ref.local_index
        if t < reverse_node_count:
            counts[t + 1] = counts[t + 1] + 1
        e = e + 1
    var n = 1
    while n <= reverse_node_count:
        counts[n] = counts[n] + counts[n - 1]
        n = n + 1
    var cursor: [u32] = []
    var c = 0
    while c <= reverse_node_count:
        cursor.push(counts[c])
        c = c + 1
    # Sized from the prefix sum, not from edges.len(): an edge whose target sits
    # outside the reverse node range is not indexed, so a partial index is
    # shorter than the forward edge list.
    val indexed = counts[reverse_node_count]
    var idx: [u32] = []
    var z = 0
    while z < indexed:
        idx.push(0)
        z = z + 1
    var k = 0
    while k < s.edges.len():
        val t2 = s.edges[k].to_ref.local_index
        if t2 < reverse_node_count:
            idx[cursor[t2]] = k
            cursor[t2] = cursor[t2] + 1
        k = k + 1
    mapping_shard(s.version, s.node_count, s.from_offsets, s.edges,
                  reverse_node_count, counts, idx)
