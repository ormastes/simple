# ============================================================================
# common/structural/mapping/mapping_codec.spl — CPU reference serializers
#
# CPU reference codec for the frozen MappingKind / compressed mapping format
# (architecture §6.2/§6.3, §26 deliverable). This is the oracle: any future
# vectorized or GPU-resident mapping builder must produce byte-identical output.
#
# Layout (little-endian, no padding — see common/structural/wire.spl):
#
#   MappingEdge   27  from EntityRef 8 | to EntityRef 8 | kind u8 1
#                     | transform u32 4 | flags u32 4 | weight_milli u16 2
#
#   MappingKindSet    envelope(8) | mask u32
#
#   MappingShard      envelope(8) | version u32 | node_count u32
#                     | edge_count u32 | has_reverse u8
#                     | from_offsets u32 * (node_count + 1)
#                     | edges MappingEdge * edge_count
#                     | [ reverse_node_count u32
#                     |   reverse_index_count u32
#                     |   reverse_offsets u32 * (reverse_node_count + 1)
#                     |   reverse_edges u32 * reverse_index_count ]
#
# The bracketed tail is present only when has_reverse == 1 (§6.3: the reverse
# index is "built only when demanded").
#
# HARD REJECTS, never a silent default:
#   - wrong magic, wrong version, non-zero envelope reserved;
#   - unknown MappingKind discriminant;
#   - a MappingFlags or MappingKindSet reserved bit set;
#   - has_reverse outside {0, 1};
#   - a CSR offset array that is not (len == n+1, starts 0, non-decreasing,
#     ends at the edge count);
#   - a reverse edge index pointing past the forward edge list;
#   - trailing bytes after the record.
#
# The offset-array checks matter more here than anywhere in wave 0a: a
# corrupted CSR does not fail loudly, it silently reads a neighbouring node's
# provenance, and provenance that is wrong-but-plausible is exactly what §6.5
# forbids ("a pass cannot silently drop origins").
# ============================================================================

use std.common.structural.wire.{
    WIRE_ENVELOPE_LEN,
    wire_check_envelope,
    wire_get_u16,
    wire_get_u32,
    wire_get_u8,
    wire_has,
    wire_magic,
    wire_put_envelope,
    wire_put_u16,
    wire_put_u32,
    wire_put_u8
}
use std.common.structural.identity.entity_id.{ENTITY_REF_LEN}
use std.common.structural.identity.identity_codec.{entity_ref_put, entity_ref_read}
use std.common.structural.mapping.contracts.{MappingKind}
use std.common.structural.mapping.mapping_edge.{
    MAPPING_EDGE_LEN,
    MAPPING_SCHEMA_VERSION,
    MappingEdge,
    MappingShard,
    mapping_edge,
    mapping_flags_valid,
    mapping_kind_from_u8,
    mapping_kind_set_valid,
    mapping_kind_to_u8,
    mapping_kind_valid,
    mapping_offsets_well_formed,
    mapping_shard,
    mapping_shard_forward,
    mapping_shard_valid,
    mapping_zero_edge
}

fn mapping_magic_edge() -> i64:
    wire_magic("SMED")

fn mapping_magic_kind_set() -> i64:
    wire_magic("SMKS")

fn mapping_magic_shard() -> i64:
    wire_magic("SMSH")

# ----------------------------------------------------------------------------
# Result carriers — same shape as the ID-TAG lane's, so callers that already
# handle an EntityRefResult handle these without a new idiom.
# ----------------------------------------------------------------------------

struct MappingEdgeResult:
    ok: bool
    value: MappingEdge

struct MappingKindSetResult:
    ok: bool
    value: u32

struct MappingShardResult:
    ok: bool
    value: MappingShard

fn mapping_empty_shard() -> MappingShard:
    val off: [u32] = []
    val edges: [MappingEdge] = []
    mapping_shard_forward(0, 0, off, edges)

# ----------------------------------------------------------------------------
# MappingEdge
# ----------------------------------------------------------------------------

fn mapping_edge_put(out: [u8], e: MappingEdge) -> [u8]:
    var b = entity_ref_put(out, e.from_ref)
    b = entity_ref_put(b, e.to_ref)
    b = wire_put_u8(b, mapping_kind_to_u8(e.kind))
    b = wire_put_u32(b, e.transform)
    b = wire_put_u32(b, e.flags)
    wire_put_u16(b, e.weight_milli)

fn mapping_edge_read(data: [u8], off: i64) -> MappingEdgeResult:
    """Read one MappingEdge. The kind discriminant and the flags reserved bits
    are both validated; either failure fails the whole read."""
    if not wire_has(data, off, MAPPING_EDGE_LEN):
        return MappingEdgeResult(ok: false, value: mapping_zero_edge())
    val kind_off = off + ENTITY_REF_LEN + ENTITY_REF_LEN
    val raw_kind = wire_get_u8(data, kind_off)
    if not mapping_kind_valid(raw_kind):
        return MappingEdgeResult(ok: false, value: mapping_zero_edge())
    val flags = wire_get_u32(data, kind_off + 5)
    if not mapping_flags_valid(flags):
        return MappingEdgeResult(ok: false, value: mapping_zero_edge())
    MappingEdgeResult(ok: true,
                      value: mapping_edge(entity_ref_read(data, off),
                                          entity_ref_read(data, off + ENTITY_REF_LEN),
                                          mapping_kind_from_u8(raw_kind),
                                          wire_get_u32(data, kind_off + 1),
                                          flags,
                                          wire_get_u16(data, kind_off + 9)))

fn encode_mapping_edge(e: MappingEdge) -> [u8]:
    """Framed standalone MappingEdge, for storage outside a packed shard."""
    var b: [u8] = []
    b = wire_put_envelope(b, mapping_magic_edge(), MAPPING_SCHEMA_VERSION)
    mapping_edge_put(b, e)

fn decode_mapping_edge(data: [u8]) -> MappingEdgeResult:
    if not wire_check_envelope(data, 0, mapping_magic_edge(), MAPPING_SCHEMA_VERSION):
        return MappingEdgeResult(ok: false, value: mapping_zero_edge())
    if data.len() != WIRE_ENVELOPE_LEN + MAPPING_EDGE_LEN:
        return MappingEdgeResult(ok: false, value: mapping_zero_edge())
    mapping_edge_read(data, WIRE_ENVELOPE_LEN)

# ----------------------------------------------------------------------------
# MappingKindSet
# ----------------------------------------------------------------------------

fn encode_mapping_kind_set(mask: u32) -> [u8]:
    var b: [u8] = []
    b = wire_put_envelope(b, mapping_magic_kind_set(), MAPPING_SCHEMA_VERSION)
    wire_put_u32(b, mask)

fn decode_mapping_kind_set(data: [u8]) -> MappingKindSetResult:
    """A reserved bit in the mask is a hard reject. Silently masking it off
    would answer a `forward(entity, kind_mask)` query about kinds this reader
    does not know while reporting success."""
    if not wire_check_envelope(data, 0, mapping_magic_kind_set(), MAPPING_SCHEMA_VERSION):
        return MappingKindSetResult(ok: false, value: 0)
    if data.len() != WIRE_ENVELOPE_LEN + 4:
        return MappingKindSetResult(ok: false, value: 0)
    val mask = wire_get_u32(data, WIRE_ENVELOPE_LEN)
    if not mapping_kind_set_valid(mask):
        return MappingKindSetResult(ok: false, value: 0)
    MappingKindSetResult(ok: true, value: mask)

# ----------------------------------------------------------------------------
# MappingShard — the compressed mapping format
# ----------------------------------------------------------------------------

fn mapping_put_u32_array(out: [u8], xs: [u32]) -> [u8]:
    """Raw u32 run, no length prefix: every offset array's length is already
    implied by node_count, so a second count would be a field two lanes could
    disagree about."""
    var b = out
    var i = 0
    while i < xs.len():
        b = wire_put_u32(b, xs[i])
        i = i + 1
    b

fn encode_mapping_shard(s: MappingShard) -> [u8]:
    """Serialize a shard. An ill-formed shard encodes to an empty buffer rather
    than to bytes no decoder will accept — a producer must not be able to put a
    corrupt CSR on the wire."""
    var b: [u8] = []
    if not mapping_shard_valid(s):
        return b
    b = wire_put_envelope(b, mapping_magic_shard(), MAPPING_SCHEMA_VERSION)
    b = wire_put_u32(b, s.version)
    b = wire_put_u32(b, s.node_count)
    b = wire_put_u32(b, s.edges.len())
    var flag = 0
    if s.has_reverse:
        flag = 1
    b = wire_put_u8(b, flag)
    b = mapping_put_u32_array(b, s.from_offsets)
    var i = 0
    while i < s.edges.len():
        b = mapping_edge_put(b, s.edges[i])
        i = i + 1
    if not s.has_reverse:
        return b
    b = wire_put_u32(b, s.reverse_node_count)
    b = wire_put_u32(b, s.reverse_edges.len())
    b = mapping_put_u32_array(b, s.reverse_offsets)
    mapping_put_u32_array(b, s.reverse_edges)

fn mapping_read_u32_array(data: [u8], off: i64, count: i64) -> [u32]:
    var xs: [u32] = []
    var i = 0
    while i < count:
        xs.push(wire_get_u32(data, off + i * 4))
        i = i + 1
    xs

fn mapping_shard_reject() -> MappingShardResult:
    MappingShardResult(ok: false, value: mapping_empty_shard())

fn decode_mapping_shard(data: [u8]) -> MappingShardResult:
    if not wire_check_envelope(data, 0, mapping_magic_shard(), MAPPING_SCHEMA_VERSION):
        return mapping_shard_reject()
    if not wire_has(data, WIRE_ENVELOPE_LEN, 13):
        return mapping_shard_reject()
    val version = wire_get_u32(data, WIRE_ENVELOPE_LEN)
    val node_count = wire_get_u32(data, WIRE_ENVELOPE_LEN + 4)
    val edge_count = wire_get_u32(data, WIRE_ENVELOPE_LEN + 8)
    val raw_rev = wire_get_u8(data, WIRE_ENVELOPE_LEN + 12)
    # {0, 1} only. Any other byte means a producer this reader does not
    # understand wrote the field; guessing would fabricate provenance.
    if raw_rev > 1:
        return mapping_shard_reject()
    var off = WIRE_ENVELOPE_LEN + 13

    # Bound the two variable runs BEFORE allocating for the declared counts.
    if not wire_has(data, off, (node_count + 1) * 4):
        return mapping_shard_reject()
    val from_offsets = mapping_read_u32_array(data, off, node_count + 1)
    off = off + (node_count + 1) * 4
    if not mapping_offsets_well_formed(from_offsets, node_count, edge_count):
        return mapping_shard_reject()

    if not wire_has(data, off, edge_count * MAPPING_EDGE_LEN):
        return mapping_shard_reject()
    var edges: [MappingEdge] = []
    var i = 0
    while i < edge_count:
        val er = mapping_edge_read(data, off)
        if not er.ok:
            return mapping_shard_reject()
        edges.push(er.value)
        off = off + MAPPING_EDGE_LEN
        i = i + 1

    if raw_rev == 0:
        if data.len() != off:
            return mapping_shard_reject()
        return MappingShardResult(ok: true,
                                  value: mapping_shard_forward(version, node_count,
                                                               from_offsets, edges))

    if not wire_has(data, off, 8):
        return mapping_shard_reject()
    val rev_nodes = wire_get_u32(data, off)
    val rev_count = wire_get_u32(data, off + 4)
    off = off + 8
    if not wire_has(data, off, (rev_nodes + 1) * 4):
        return mapping_shard_reject()
    val rev_offsets = mapping_read_u32_array(data, off, rev_nodes + 1)
    off = off + (rev_nodes + 1) * 4
    if not mapping_offsets_well_formed(rev_offsets, rev_nodes, rev_count):
        return mapping_shard_reject()
    if not wire_has(data, off, rev_count * 4):
        return mapping_shard_reject()
    val rev_edges = mapping_read_u32_array(data, off, rev_count)
    off = off + rev_count * 4
    if data.len() != off:
        return mapping_shard_reject()
    val out = mapping_shard(version, node_count, from_offsets, edges,
                            rev_nodes, rev_offsets, rev_edges)
    # Re-run the full structural rule so decode accepts exactly the set encode
    # emits; this is what catches a reverse index pointing past the edge list.
    if not mapping_shard_valid(out):
        return mapping_shard_reject()
    MappingShardResult(ok: true, value: out)
