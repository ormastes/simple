# Versioned provenance contracts shared by structural-compute stages.

val STRUCTURAL_MAPPING_CONTRACT_VERSION: i64 = 1

enum MappingKind:
    ParsedFrom
    ExpandedFrom
    DesugaredFrom
    ResolvedFrom
    LoweredFrom
    ClonedFrom
    InlinedFrom
    WovenFrom
    OptimizedFrom
    GeneratedFrom
    LinkedFrom
    Styles
    CascadesInto
    LayoutOf
    PaintOf
    HitRegionOf
    InvalidatedBy

struct LayoutMapping:
    contract_version: i64
    source_id: i64
    target_id: i64
    kind: text
    mapping_kind: MappingKind

struct MappingGraph:
    contract_version: i64
    edges: [LayoutMapping]

fn mapping_graph(edges: [LayoutMapping]) -> MappingGraph:
    MappingGraph(contract_version: STRUCTURAL_MAPPING_CONTRACT_VERSION, edges: edges)

fn layout_of_mapping(source_id: i64, target_id: i64) -> LayoutMapping:
    LayoutMapping(
        contract_version: STRUCTURAL_MAPPING_CONTRACT_VERSION,
        source_id: source_id,
        target_id: target_id,
        kind: "LayoutOf",
        mapping_kind: MappingKind.LayoutOf
    )

fn hit_region_of_mapping(source_id: i64, target_id: i64) -> LayoutMapping:
    LayoutMapping(
        contract_version: STRUCTURAL_MAPPING_CONTRACT_VERSION,
        source_id: source_id,
        target_id: target_id,
        kind: "HitRegionOf",
        mapping_kind: MappingKind.HitRegionOf
    )

export STRUCTURAL_MAPPING_CONTRACT_VERSION, MappingKind, LayoutMapping, MappingGraph
export mapping_graph, layout_of_mapping, hit_region_of_mapping
