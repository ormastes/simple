# ============================================================================
# common/structural/resolve/resolve_frontier.spl — reachability + constraint
# propagation CPU reference (LINK lane, Lane FRONTIER)
#
# Architecture Part VII §18 (GraphResolveCore record/profile contract), §19
# (SMF link pipeline L0–L12: this backs stage L6_REACHABILITY and the
# `link.reachable` tag). Contract document:
# doc/05_design/platform/structural_compute/link_manager_contract_v1.md §6
# names "Reachability frontier / constraint-propagation batch layouts" as
# deliberately not frozen as a wire format in v1 (GPU-facing, frozen with the
# hybrid wave against real batch shapes). This module is the in-memory CPU
# reference algorithm the hybrid/resident lanes are measured against — never a
# wire codec.
#
# Index-based, no pointers: `ResolveEdge.from_index`/`to_index` address a node
# arena 0..node_count, the same convention as an `EntityRef.local_index`
# within one object (structural/identity/entity_id.spl §4.1), but scoped to a
# single caller-owned arena rather than the Object VM descriptor table.
#
# Composition only, no inheritance (repo rule): plain value structs, behaviour
# in free functions, same as resolve_types.spl / resolve_codec.spl.
#
# Decoders-style discipline: both entry points are total. An out-of-bounds
# edge or root index never traps and never silently skips a record — the call
# returns an explicit `ok: false` result instead.
# ============================================================================

# ----------------------------------------------------------------------------
# ResolveEdge — one directed edge in the reachability / constraint graph.
# ----------------------------------------------------------------------------

struct ResolveEdge:
    """One directed edge over a node arena indexed 0..node_count (§18). Used
    both by `reachable_mark` (link.reachable, stage L6) and by
    `propagate_constraints` (predecessor -> successor OR-merge)."""
    from_index: u32
    to_index: u32

# ----------------------------------------------------------------------------
# Result carriers — explicit `ok` structs, same rationale as resolve_codec.
# ----------------------------------------------------------------------------

struct ReachableResult:
    """Result of `reachable_mark`. `ok` is false when any edge or root index
    is out of bounds for `node_count`; `values` is then whatever had been
    computed before the bounds check failed (all-false on an edge-bounds
    failure detected up front)."""
    ok: bool
    values: [bool]

struct ConstraintPropagationResult:
    """Result of `propagate_constraints`. `ok` is false when an edge is out of
    bounds, `initial.len()` does not match `node_count`, or the fixpoint did
    not converge within the iteration cap. `values` carries the last computed
    state either way; `iterations` the number of propagation passes run."""
    ok: bool
    values: [u64]
    iterations: i64

# ----------------------------------------------------------------------------
# Bounds discipline shared by both entry points.
# ----------------------------------------------------------------------------

fn _edges_in_bounds(node_count: i64, edges: [ResolveEdge]) -> bool:
    for e in edges:
        if (e.from_index as i64) >= node_count:
            return false
        if (e.to_index as i64) >= node_count:
            return false
    true

fn _roots_in_bounds(node_count: i64, roots: [u32]) -> bool:
    for r in roots:
        if (r as i64) >= node_count:
            return false
    true

# ----------------------------------------------------------------------------
# Array builders — COLL019 forbids `arr[i] = v`, so every "set index i" is a
# rebuild via a push loop instead of an in-place mutation.
# ----------------------------------------------------------------------------

fn _false_array(n: i64) -> [bool]:
    var out: [bool] = []
    var i = 0
    while i < n:
        out.push(false)
        i = i + 1
    out

fn _bool_array_set_true(values: [bool], index: i64) -> [bool]:
    var out: [bool] = []
    var i = 0
    while i < values.len():
        if i == index:
            out.push(true)
        else:
            out.push(values[i])
        i = i + 1
    out

# ----------------------------------------------------------------------------
# reachable_mark — worklist BFS (§18 dead-strip / link.reachable, stage L6).
#
# Deterministic visit order: roots are processed in input order, and each
# dequeued node's outgoing edges are scanned in input order. A node already
# marked reachable is never re-enqueued, so a diamond (two paths into one
# node) marks it exactly once.
# ----------------------------------------------------------------------------

fn reachable_mark(node_count: i64, edges: [ResolveEdge], roots: [u32]) -> ReachableResult:
    if node_count < 0:
        return ReachableResult(ok: false, values: [])
    if not _edges_in_bounds(node_count, edges):
        return ReachableResult(ok: false, values: _false_array(node_count))
    if not _roots_in_bounds(node_count, roots):
        return ReachableResult(ok: false, values: _false_array(node_count))

    var values = _false_array(node_count)
    var worklist: [i64] = []

    for r in roots:
        val idx = r as i64
        if not values[idx]:
            values = _bool_array_set_true(values, idx)
            worklist.push(idx)

    var cursor = 0
    while cursor < worklist.len():
        val current = worklist[cursor]
        for e in edges:
            if (e.from_index as i64) == current:
                val to = e.to_index as i64
                if not values[to]:
                    values = _bool_array_set_true(values, to)
                    worklist.push(to)
        cursor = cursor + 1

    ReachableResult(ok: true, values: values)

# ----------------------------------------------------------------------------
# propagate_constraints — fixpoint bitwise-OR merge from predecessors.
#
# Each pass ("Jacobi" style, reading only the previous full state) computes
# next[i] = values[i] | OR over edges(_, i) of values[from]. Monotone OR over
# a fixed-width word converges no later than the graph's longest simple-path
# length, which can never exceed edges.len(); +1 covers the confirming pass
# that observes no change. Hitting the cap without convergence is an explicit
# failure (ok=false), never a silently-truncated partial success — it can
# only happen if the merge step itself is not monotone (a defect), since
# monotone OR is bounded by the cap by construction.
# ----------------------------------------------------------------------------

fn _propagate_once(node_count: i64, edges: [ResolveEdge], values: [u64]) -> [u64]:
    var out: [u64] = []
    var i = 0
    while i < node_count:
        var acc = values[i]
        for e in edges:
            if (e.to_index as i64) == i:
                acc = acc | values[e.from_index as i64]
        out.push(acc)
        i = i + 1
    out

fn _u64_arrays_equal(a: [u64], b: [u64]) -> bool:
    if a.len() != b.len():
        return false
    var i = 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    true

fn propagate_constraints(node_count: i64, edges: [ResolveEdge], initial: [u64]) -> ConstraintPropagationResult:
    if node_count < 0:
        return ConstraintPropagationResult(ok: false, values: [], iterations: 0)
    if not _edges_in_bounds(node_count, edges):
        return ConstraintPropagationResult(ok: false, values: initial, iterations: 0)
    if initial.len() != node_count:
        return ConstraintPropagationResult(ok: false, values: initial, iterations: 0)

    val cap = edges.len() + 1
    var values = initial
    var iterations = 0
    var changed = true
    while changed and iterations < cap:
        val next = _propagate_once(node_count, edges, values)
        changed = not _u64_arrays_equal(values, next)
        values = next
        iterations = iterations + 1

    if changed:
        return ConstraintPropagationResult(ok: false, values: values, iterations: iterations)
    ConstraintPropagationResult(ok: true, values: values, iterations: iterations)
