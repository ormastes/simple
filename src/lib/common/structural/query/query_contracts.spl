# ============================================================================
# common/structural/query/query_contracts.spl — FROZEN QueryIR contract v1
#
# Architecture: doc/04_architecture/compiler/mdsoc/
#   mdsoc_plus_tagged_structural_compute_architecture.md §7 (QueryIR: one engine,
#   multiple dialects), §26 (contract freeze), §27 (QUERY lane owns
#   structural/query).
#
# Wave 0c of the contract-freeze phase. Freezes artifact group 4 of §26:
# "QueryIR bytecode and capture format", and — by explicit hand-off from §6.4 —
# the `EntitySetView` type that §5.4, §6.4 and §7.5 all return or consume.
#
# Conventions are inherited unchanged from the ID-TAG lane (wave 0a) and the MAP
# lane (wave 0b): all integers little-endian, fixed width, no padding, no
# alignment; every enum is a u8 discriminant; every top-level record carries the
# 8-byte wire envelope; an unknown enum discriminant or a set reserved bit is a
# HARD REJECT, never a silent default. See common/structural/wire.spl and
# doc/05_design/platform/structural_compute/identity_tagmap_contract_v1.md.
#
# NOT REDECLARED HERE: `MappingKind` / `MappingKindSet` (MAP lane, imported by
# the codec for TraverseMapping operands), `EntityRef` / `SnapshotId` (ID-TAG
# lane), `ExecutionProfile` (EXEC lane, already in structural/execution). Two
# declarations of one wire type is precisely how two lanes come to disagree
# about a discriminant while both report success.
#
# FROZEN: enum discriminants are wire values. A discriminant is never reused and
# never renumbered; new variants take the next free number.
# ============================================================================

val QUERY_SCHEMA_VERSION: i64 = 1

# ----------------------------------------------------------------------------
# QueryDialect (§7.2) — fully enumerated by the architecture; frozen as given,
# in declaration order, starting at 0.
# ----------------------------------------------------------------------------

enum QueryDialect:
    Syntax
    Semantic
    Mir
    ClangAst
    LlvmIr
    Dom
    CssSelector
    LinkGraph
    LayoutGraph

fn query_dialect_to_u8(d: QueryDialect) -> i64:
    match d:
        case QueryDialect.Syntax: 0
        case QueryDialect.Semantic: 1
        case QueryDialect.Mir: 2
        case QueryDialect.ClangAst: 3
        case QueryDialect.LlvmIr: 4
        case QueryDialect.Dom: 5
        case QueryDialect.CssSelector: 6
        case QueryDialect.LinkGraph: 7
        case QueryDialect.LayoutGraph: 8

val QUERY_DIALECT_MAX: i64 = 8
val QUERY_DIALECT_COUNT: i64 = 9

fn query_dialect_from_u8(v: i64) -> QueryDialect:
    """Caller MUST gate on `query_dialect_valid` first; this maps only known
    discriminants and pins anything else to Syntax so the function stays total
    (same rule as mapping_kind_from_u8)."""
    match v:
        case 1: QueryDialect.Semantic
        case 2: QueryDialect.Mir
        case 3: QueryDialect.ClangAst
        case 4: QueryDialect.LlvmIr
        case 5: QueryDialect.Dom
        case 6: QueryDialect.CssSelector
        case 7: QueryDialect.LinkGraph
        case 8: QueryDialect.LayoutGraph
        case _: QueryDialect.Syntax

fn query_dialect_valid(v: i64) -> bool:
    v >= 0 and v <= QUERY_DIALECT_MAX

fn query_dialect_equal(a: QueryDialect, b: QueryDialect) -> bool:
    query_dialect_to_u8(a) == query_dialect_to_u8(b)

# ----------------------------------------------------------------------------
# QueryOpKind (§7.3) — fully enumerated by the architecture; frozen as given,
# in declaration order, starting at 0.
#
# §7.3's "domain extensions" list (call-target, use-def, compound selector,
# archive-member, formatting-context, ...) is deliberately NOT folded into this
# enum. §7.1 is explicit that domains share "a common QueryIR plus
# domain-specific operations"; folding CSS pseudo-classes and linker relocation
# targets into the core opcode space would make every dialect's additions a
# breaking change to every other dialect. The extension space is the reserved
# discriminant range above QUERY_OP_KIND_MAX, allocated by a future version bump
# — see the contract document.
# ----------------------------------------------------------------------------

enum QueryOpKind:
    SeedAll
    SeedKind
    SeedTag
    SeedTagValue
    FilterKind
    FilterTag
    FilterName
    FilterSourceRange
    TraverseParent
    TraverseChild
    TraverseAncestor
    TraverseDescendant
    TraverseSibling
    TraverseMapping
    TraverseReference
    Intersect
    Union
    Difference
    NegateWithinUniverse
    Capture
    StableSort
    Limit

fn query_op_kind_to_u8(k: QueryOpKind) -> i64:
    match k:
        case QueryOpKind.SeedAll: 0
        case QueryOpKind.SeedKind: 1
        case QueryOpKind.SeedTag: 2
        case QueryOpKind.SeedTagValue: 3
        case QueryOpKind.FilterKind: 4
        case QueryOpKind.FilterTag: 5
        case QueryOpKind.FilterName: 6
        case QueryOpKind.FilterSourceRange: 7
        case QueryOpKind.TraverseParent: 8
        case QueryOpKind.TraverseChild: 9
        case QueryOpKind.TraverseAncestor: 10
        case QueryOpKind.TraverseDescendant: 11
        case QueryOpKind.TraverseSibling: 12
        case QueryOpKind.TraverseMapping: 13
        case QueryOpKind.TraverseReference: 14
        case QueryOpKind.Intersect: 15
        case QueryOpKind.Union: 16
        case QueryOpKind.Difference: 17
        case QueryOpKind.NegateWithinUniverse: 18
        case QueryOpKind.Capture: 19
        case QueryOpKind.StableSort: 20
        case QueryOpKind.Limit: 21

val QUERY_OP_KIND_MAX: i64 = 21
val QUERY_OP_KIND_COUNT: i64 = 22

fn query_op_kind_from_u8(v: i64) -> QueryOpKind:
    """Caller MUST gate on `query_op_kind_valid` first."""
    match v:
        case 1: QueryOpKind.SeedKind
        case 2: QueryOpKind.SeedTag
        case 3: QueryOpKind.SeedTagValue
        case 4: QueryOpKind.FilterKind
        case 5: QueryOpKind.FilterTag
        case 6: QueryOpKind.FilterName
        case 7: QueryOpKind.FilterSourceRange
        case 8: QueryOpKind.TraverseParent
        case 9: QueryOpKind.TraverseChild
        case 10: QueryOpKind.TraverseAncestor
        case 11: QueryOpKind.TraverseDescendant
        case 12: QueryOpKind.TraverseSibling
        case 13: QueryOpKind.TraverseMapping
        case 14: QueryOpKind.TraverseReference
        case 15: QueryOpKind.Intersect
        case 16: QueryOpKind.Union
        case 17: QueryOpKind.Difference
        case 18: QueryOpKind.NegateWithinUniverse
        case 19: QueryOpKind.Capture
        case 20: QueryOpKind.StableSort
        case 21: QueryOpKind.Limit
        case _: QueryOpKind.SeedAll

fn query_op_kind_valid(v: i64) -> bool:
    v >= 0 and v <= QUERY_OP_KIND_MAX

fn query_op_kind_equal(a: QueryOpKind, b: QueryOpKind) -> bool:
    query_op_kind_to_u8(a) == query_op_kind_to_u8(b)

fn query_op_kind_is_seed(k: QueryOpKind) -> bool:
    """A seed op produces a set from the snapshot and consumes no input set;
    every other op consumes at least `input_a`. This is the rule that makes an
    op arena checkable: op 0 must be a seed, and a non-seed op's inputs must be
    earlier ops (§7.4's arena is a straight-line SoA program, not a graph)."""
    val v = query_op_kind_to_u8(k)
    v >= 0 and v <= 3

fn query_op_kind_is_binary(k: QueryOpKind) -> bool:
    """Intersect / Union / Difference are the only ops that take a second input
    set (§7.3's "deterministic set algebra"). NegateWithinUniverse is unary: its
    second operand is the request's `universe`, not another op."""
    val v = query_op_kind_to_u8(k)
    v >= 15 and v <= 17

# ----------------------------------------------------------------------------
# QueryDeterminism (§7.4) — DERIVED, not defined by the architecture.
#
# §7.4 declares `determinism: QueryDeterminism` as a QueryProgram field and
# never gives the type a definition anywhere in the document. Rather than invent
# a vocabulary, this freezes the wire SLOT (u8 discriminant) with exactly the
# levels the surrounding sections actually distinguish. Each cites its sentence:
#
#   0  SetDeterministic    — §7.1 promises "deterministic set algebra". The set
#      of resulting entities is reproducible; the ORDER is not guaranteed. This
#      is the level a GPU/SIMD evaluator reaches natively, before any sort: §7.3
#      provides `StableSort` as a separate op precisely because the preceding
#      operations do not already guarantee order.
#
#   1  OrderDeterministic  — §30.4: "scalar, SIMD, CUDA, and Vulkan evaluators
#      produce identical stable entity ... order". Set AND entity order are
#      reproducible across backends. A program that ends in `Limit` is only
#      meaningful at this level or above, since `Limit` on an unordered set
#      picks arbitrary members.
#
#   2  CaptureDeterministic — §30.4's same sentence says "identical stable
#      entity/capture order", naming captures separately from entities; §3093
#      requires "for each capture(join), stable source order". Set, entity order
#      AND per-capture binding order are all reproducible.
#
# The levels are MONOTONE: 2 implies 1 implies 0. That is why they are an
# ordered u8 and not a bitset — §21.4's fallback rule ("a fallback ... preserves
# stable ordering and hashes") needs to compare a backend's guarantee against a
# program's requirement, which is a >= test.
#
# Raised for ratification — see the contract document.
# ----------------------------------------------------------------------------

enum QueryDeterminism:
    SetDeterministic
    OrderDeterministic
    CaptureDeterministic

fn query_determinism_to_u8(d: QueryDeterminism) -> i64:
    match d:
        case QueryDeterminism.SetDeterministic: 0
        case QueryDeterminism.OrderDeterministic: 1
        case QueryDeterminism.CaptureDeterministic: 2

val QUERY_DETERMINISM_MAX: i64 = 2

fn query_determinism_from_u8(v: i64) -> QueryDeterminism:
    match v:
        case 1: QueryDeterminism.OrderDeterministic
        case 2: QueryDeterminism.CaptureDeterministic
        case _: QueryDeterminism.SetDeterministic

fn query_determinism_valid(v: i64) -> bool:
    v >= 0 and v <= QUERY_DETERMINISM_MAX

fn query_determinism_satisfies(provided: QueryDeterminism,
                               required: QueryDeterminism) -> bool:
    """Monotone comparison: a backend providing `provided` may run a program
    requiring `required`. Used by §21.4's no-silent-fallback rule."""
    query_determinism_to_u8(provided) >= query_determinism_to_u8(required)

# ----------------------------------------------------------------------------
# TagIndexSet (§5.6, §7.4) — wire SLOT only, DERIVED.
#
# `TagIndexSet` is used by §5.6's `TagDemand.required_indexes` and by §7.4's
# `QueryProgram.index_requirements`, and is never defined. It sits on the §5
# (ID-TAG) side of the boundary, so this lane freezes ONLY what QueryIR must put
# on the wire and leaves the naming of the eventual `TagIndexKind` enum to the
# ID-TAG lane:
#
#   - width u32, little-endian (same shape and same reasoning as §6.4's
#     ratified MappingKindSet: a "set of index kinds" is a bitset, and u32 is
#     the smallest fixed width that leaves room for the §5.3 table to grow);
#   - bit i means storage representation i of §5.3's five-row table, in table
#     order: DenseMarkerBitset(0), DenseScalarColumn(1), SparseRecords(2),
#     InvertedQueryIndex(3), SmallSetArena(4);
#   - bits 5..31 RESERVED and MUST be zero — hard reject.
#
# §5.3 is the only place in the document that enumerates index shapes, so its
# five rows are the minimum vocabulary the surrounding sections distinguish.
# Raised for ratification by the ID-TAG lane.
# ----------------------------------------------------------------------------

val TAG_INDEX_SET_LEN: i64 = 4
val TAG_INDEX_DENSE_MARKER: i64 = 1
val TAG_INDEX_DENSE_SCALAR: i64 = 2
val TAG_INDEX_SPARSE_RECORDS: i64 = 4
val TAG_INDEX_INVERTED_QUERY: i64 = 8
val TAG_INDEX_SMALL_SET: i64 = 16
val TAG_INDEX_SET_KNOWN: i64 = 31
val TAG_INDEX_SET_EMPTY: i64 = 0

fn tag_index_set_valid(raw: i64) -> bool:
    """True when no reserved bit is set. Silently masking a reserved bit off
    would run a query whose required index this reader cannot even name."""
    raw >= 0 and (raw & TAG_INDEX_SET_KNOWN) == raw

fn tag_index_set_contains(set: i64, bit: i64) -> bool:
    (set & bit) != 0

export QUERY_SCHEMA_VERSION
export QueryDialect, query_dialect_to_u8, query_dialect_from_u8
export query_dialect_valid, query_dialect_equal
export QUERY_DIALECT_MAX, QUERY_DIALECT_COUNT
export QueryOpKind, query_op_kind_to_u8, query_op_kind_from_u8
export query_op_kind_valid, query_op_kind_equal
export query_op_kind_is_seed, query_op_kind_is_binary
export QUERY_OP_KIND_MAX, QUERY_OP_KIND_COUNT
export QueryDeterminism, query_determinism_to_u8, query_determinism_from_u8
export query_determinism_valid, query_determinism_satisfies
export QUERY_DETERMINISM_MAX
export TAG_INDEX_SET_LEN, TAG_INDEX_SET_KNOWN, TAG_INDEX_SET_EMPTY
export TAG_INDEX_DENSE_MARKER, TAG_INDEX_DENSE_SCALAR, TAG_INDEX_SPARSE_RECORDS
export TAG_INDEX_INVERTED_QUERY, TAG_INDEX_SMALL_SET
export tag_index_set_valid, tag_index_set_contains
