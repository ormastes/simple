# ============================================================================
# common/structural/query/query_program.spl — FROZEN QueryIR bytecode + capture
#
# Architecture §7.3/§7.4 (core operations, program representation), §7.5
# (execution API), §26 (contract freeze), §27 (QUERY lane).
#
# This module freezes the four record shapes of §26's "QueryIR bytecode and
# capture format" artifact group, plus `EntitySetView`, which §6.4 explicitly
# handed to this lane:
#
#     "`EntitySetView` in particular is shared with the tag and query groups —
#      freezing them from inside the mapping group would pre-empt the
#      StageReceipt and QueryIR artifact groups."
#
# EntitySetView is NOT a StageReceipt field. §21.3 lists StageReceipt's 13
# fields and none of them is an entity-set view; the type §6.4 flagged as
# StageReceipt-shared is `MappingShardRef`, which stays open. So EntitySetView
# can be frozen here without pre-empting the concurrent StageReceipt lane.
#
# Conventions inherited from wave 0a/0b: little-endian, fixed width, no padding,
# no alignment; enums are u8; unknown discriminants and set reserved bits are
# HARD REJECTS.
# ============================================================================

use std.common.structural.query.query_contracts.{
    QueryDeterminism,
    QueryDialect,
    QueryOpKind,
    query_determinism_to_u8,
    query_determinism_valid,
    query_dialect_equal,
    query_op_kind_equal,
    query_op_kind_is_binary,
    query_op_kind_is_seed,
    query_op_kind_to_u8,
    tag_index_set_valid
}

# ----------------------------------------------------------------------------
# Sentinels
#
# One value, 0xFFFFFFFF, means "absent" for both an operand slot and a constant
# slot. A separate presence bitfield would be a second field two producers could
# disagree with the first about; §7.4's representation is an SoA bytecode, and
# an SoA column has no room for optionality other than a reserved value.
# ----------------------------------------------------------------------------

val QUERY_NO_INPUT: i64 = 0xFFFFFFFF
val QUERY_NO_CONSTANT: i64 = 0xFFFFFFFF
val QUERY_U32_MAX: i64 = 0xFFFFFFFF

# ----------------------------------------------------------------------------
# EntitySetOrder — DERIVED, not defined by the architecture.
#
# `EntitySetView` is returned by §5.4's `entities` / `entities_equal`, §6.4's
# `forward` / `reverse` / `trace_to_output`, and consumed as §7.5's `universe`.
# The document never gives it fields. Whatever else a view carries, it must
# carry its ordering guarantee, because §30.4 makes cross-backend order the
# QueryIR parity bar and §7.3 makes `StableSort` an explicit op — a view whose
# order is unknown cannot be fed to `Limit` and cannot be compared against
# another backend's output.
#
# Minimum vocabulary, each level cited:
#
#   0  Unordered         — §7.1 "deterministic set algebra": membership is
#      reproducible, order is not. The natural output of a GPU set operation.
#   1  EntityRefOrder    — ascending (object_slot, local_index). This is the
#      order §4.1's "hot arrays" and §6.3's CSR rows are already stored in, so
#      it is the order a scan produces for free.
#   2  StableSourceOrder — §3093 "for each capture(join), stable source order";
#      §30.4's "identical stable entity/capture order". What `StableSort`
#      produces and what a receipt hashes.
#
# NOT monotone (EntityRefOrder does not imply source order and vice versa), so
# unlike QueryDeterminism this is a plain discriminant, never compared with >=.
# Raised for ratification.
# ----------------------------------------------------------------------------

enum EntitySetOrder:
    Unordered
    EntityRefOrder
    StableSourceOrder

fn entity_set_order_to_u8(o: EntitySetOrder) -> i64:
    match o:
        case EntitySetOrder.Unordered: 0
        case EntitySetOrder.EntityRefOrder: 1
        case EntitySetOrder.StableSourceOrder: 2

val ENTITY_SET_ORDER_MAX: i64 = 2

fn entity_set_order_from_u8(v: i64) -> EntitySetOrder:
    match v:
        case 1: EntitySetOrder.EntityRefOrder
        case 2: EntitySetOrder.StableSourceOrder
        case _: EntitySetOrder.Unordered

fn entity_set_order_valid(v: i64) -> bool:
    v >= 0 and v <= ENTITY_SET_ORDER_MAX

fn entity_set_order_equal(a: EntitySetOrder, b: EntitySetOrder) -> bool:
    entity_set_order_to_u8(a) == entity_set_order_to_u8(b)

# ----------------------------------------------------------------------------
# EntitySetView (§5.4/§6.4/§7.5) — DERIVED.
#
# A view, not a container: §6.4 calls these "handle and view types rather than
# parts of the compressed mapping format". It therefore names an existing run of
# entities rather than carrying them.
#
#   object_slot  u32  — the Object VM descriptor holding the entity array. Same
#                       field, same width and same meaning as §4.1's
#                       `EntityRef.object_slot`; the descriptor is what carries
#                       "object generation, schema, snapshot epoch, and
#                       residency state", which is exactly the lease §4.1 says a
#                       reference is only valid under. The view does NOT repeat
#                       a SnapshotId: §7.5's QueryRequest already carries one,
#                       and a duplicated epoch is a field two sides can
#                       disagree about.
#   offset       u32  — index of the first element within that arena.
#   count        u32  — number of entities in the view.
#   order        u8   — EntitySetOrder, above.
#
# 13 bytes, no padding.
# ----------------------------------------------------------------------------

val ENTITY_SET_VIEW_LEN: i64 = 13

struct EntitySetView:
    """A borrowed, ordered-or-not run of entities inside one Object VM arena."""
    object_slot: u32
    offset: u32
    count: u32
    order: EntitySetOrder

fn entity_set_view(object_slot: u32, offset: u32, count: u32,
                   order: EntitySetOrder) -> EntitySetView:
    EntitySetView(object_slot: object_slot, offset: offset, count: count,
                  order: order)

fn entity_set_view_empty() -> EntitySetView:
    entity_set_view(0, 0, 0, EntitySetOrder.Unordered)

fn entity_set_view_equal(a: EntitySetView, b: EntitySetView) -> bool:
    """Explicit field-wise equality, not engine struct equality, which differs
    between the interpreter and native codegen for nested structs.

    Parenthesised because a bare line continuation after a comparison operator
    does not parse on the seed this contract is gated with; see
    .claude/rules/language.md "Multi-line booleans"."""
    (a.object_slot == b.object_slot
        and a.offset == b.offset
        and a.count == b.count
        and entity_set_order_equal(a.order, b.order))

fn entity_set_view_well_formed(v: EntitySetView) -> bool:
    """The one invariant a view can check on its own: the run must not wrap past
    the end of the u32 index space. A wrapped view does not fail loudly, it
    silently addresses the beginning of somebody else's arena.

    Both fields are WIDENED into i64 bindings first, and the bound is written as
    a subtraction rather than `offset + count <= MAX`. Adding two `u32` operands
    evaluates at 32-bit width and wraps, so the naive form reports a wrapped view
    as well-formed — the same 32-bit-width trap §5.4 already records for packing
    the TagValue SmallSet offset/count pair."""
    val off: i64 = v.offset
    val cnt: i64 = v.count
    off >= 0 and cnt >= 0 and off <= QUERY_U32_MAX and cnt <= QUERY_U32_MAX - off

# ----------------------------------------------------------------------------
# QueryOp — the bytecode word (§7.3 operations, §7.4 "SoA bytecode").
#
# §7.4 states the representation is "an SoA bytecode, not a graph of heap
# objects" and never gives the word its fields. A uniform fixed-width word is
# what makes an SoA layout possible at all, so this freezes one word that every
# §7.3 opcode fits into, with no per-opcode variable tail:
#
#   kind      u8   QueryOpKind discriminant.
#   reserved  u8   MUST be zero. §7.3 gives no evidence for any per-op flag, so
#                  rather than invent a flag vocabulary this freezes the slot
#                  and hard-rejects a non-zero byte. A future flag is a version
#                  bump, not a silent reinterpretation.
#   input_a   u32  Index of the producing op, or QUERY_NO_INPUT for a seed.
#   input_b   u32  Second input for Intersect/Union/Difference only.
#   operand   u32  Small inline immediate: the kind id for SeedKind/FilterKind,
#                  the depth bound for a Traverse*, the slot index for Capture,
#                  the row count for Limit. QUERY_NO_INPUT when unused.
#   constant  u32  Index into the program's constant arena (§7.4's
#                  `constants: ObjectRef<QueryConstantArena>`), or
#                  QUERY_NO_CONSTANT. This is where a TagKeyId, a TagValue
#                  payload, a MappingKindSet mask for TraverseMapping, an
#                  interned name for FilterName, or a source-range bound lives —
#                  none of which fit an inline u32 pair.
#
# 18 bytes, no padding. Field order on the wire is the declaration order above.
#
# The two-input/one-input split is the structural invariant that makes an op
# arena verifiable, and it matters for the same reason §6.3's CSR offsets did: a
# forward reference or a self reference does not fail loudly, it silently
# evaluates a different program than the one that was compiled.
# ----------------------------------------------------------------------------

val QUERY_OP_LEN: i64 = 18

struct QueryOp:
    """One straight-line QueryIR instruction. Its result is addressed by its own
    index in the op arena; the last op's result is the program's result."""
    kind: QueryOpKind
    reserved: u8
    input_a: u32
    input_b: u32
    operand: u32
    constant: u32

fn query_op(kind: QueryOpKind, input_a: u32, input_b: u32, operand: u32,
            constant: u32) -> QueryOp:
    QueryOp(kind: kind, reserved: 0, input_a: input_a, input_b: input_b,
            operand: operand, constant: constant)

fn query_op_seed(kind: QueryOpKind, operand: u32, constant: u32) -> QueryOp:
    query_op(kind, QUERY_NO_INPUT, QUERY_NO_INPUT, operand, constant)

fn query_op_unary(kind: QueryOpKind, input_a: u32, operand: u32,
                  constant: u32) -> QueryOp:
    query_op(kind, input_a, QUERY_NO_INPUT, operand, constant)

fn query_op_binary(kind: QueryOpKind, input_a: u32, input_b: u32) -> QueryOp:
    query_op(kind, input_a, input_b, QUERY_NO_INPUT, QUERY_NO_CONSTANT)

fn query_zero_op() -> QueryOp:
    query_op_seed(QueryOpKind.SeedAll, QUERY_NO_INPUT, QUERY_NO_CONSTANT)

fn query_op_equal(a: QueryOp, b: QueryOp) -> bool:
    (query_op_kind_equal(a.kind, b.kind)
        and a.reserved == b.reserved
        and a.input_a == b.input_a
        and a.input_b == b.input_b
        and a.operand == b.operand
        and a.constant == b.constant)

fn query_op_well_formed(op: QueryOp, index: i64, const_count: i64,
                        capture_count: i64) -> bool:
    """Structural rule for one op at position `index` in the arena.

    A seed takes no input set; every other op takes `input_a`; only the three
    set-algebra ops take `input_b`. Every input must name a STRICTLY EARLIER op,
    which is what keeps the arena a straight-line program (§7.4) rather than a
    graph, and makes evaluation order backend-independent (§30.4)."""
    if op.reserved != 0:
        return false
    if op.constant != QUERY_NO_CONSTANT and op.constant >= const_count:
        return false
    if query_op_kind_is_seed(op.kind):
        return op.input_a == QUERY_NO_INPUT and op.input_b == QUERY_NO_INPUT
    if op.input_a == QUERY_NO_INPUT or op.input_a >= index:
        return false
    if query_op_kind_is_binary(op.kind):
        if op.input_b == QUERY_NO_INPUT or op.input_b >= index:
            return false
    else:
        if op.input_b != QUERY_NO_INPUT:
            return false
    if query_op_kind_equal(op.kind, QueryOpKind.Capture):
        return op.operand != QUERY_NO_INPUT and op.operand < capture_count
    true

# ----------------------------------------------------------------------------
# CaptureKind — DERIVED, not defined by the architecture.
#
# §7.4 declares `captures: ObjectRef<CaptureSchema>` and §7.5 declares
# `captures: ObjectRef<CaptureArena>`; neither is given a definition. The
# document distinguishes exactly two things a capture can bind:
#
#   0  Entity     — §7.6's `Capture(join_point)` binds one join point; §7.8
#      requires the Clang adapter to "return canonical `EntityKey` captures".
#   1  EntitySet  — §7.3's `Capture` is an operation over an entity SET, and
#      §3093 iterates "for each capture(join)", which presupposes a capture can
#      hold more than one binding.
#
# No third kind is invented: §7.7's specificity value is a property of a
# compiled selector, not a capture, and captures of tag values would need a
# TagValue payload the document never asks a capture to carry. Raised for
# ratification.
#
# A capture's binding VALUE is a durable `EntityKey`, not a hot `EntityRef`
# (§7.8), because captures outlive the translation unit that produced them.
# That is a property of the runtime CaptureArena, not of this schema, which
# freezes only the slot table.
# ----------------------------------------------------------------------------

enum CaptureKind:
    Entity
    EntitySet

fn capture_kind_to_u8(k: CaptureKind) -> i64:
    match k:
        case CaptureKind.Entity: 0
        case CaptureKind.EntitySet: 1

val CAPTURE_KIND_MAX: i64 = 1

fn capture_kind_from_u8(v: i64) -> CaptureKind:
    match v:
        case 1: CaptureKind.EntitySet
        case _: CaptureKind.Entity

fn capture_kind_valid(v: i64) -> bool:
    v >= 0 and v <= CAPTURE_KIND_MAX

fn capture_kind_equal(a: CaptureKind, b: CaptureKind) -> bool:
    capture_kind_to_u8(a) == capture_kind_to_u8(b)

# ----------------------------------------------------------------------------
# CaptureSlot / CaptureSchema — the "capture format" half of §26's group.
#
#   name      u32  interned string id. Same width and same interning as
#                  §5.2's `TagKey.namespace` / `TagKey.name`, already frozen at
#                  u32 by the ID-TAG lane; a capture name and a tag name come
#                  out of the same string table.
#   kind      u8   CaptureKind.
#   reserved  u8   MUST be zero.
#
# 6 bytes per slot, no padding. A schema is the ordered slot table; a `Capture`
# op's `operand` is an index into it, which is why the op-arena rule above
# bounds that operand by the slot count.
# ----------------------------------------------------------------------------

val CAPTURE_SLOT_LEN: i64 = 6

struct CaptureSlot:
    name: u32
    kind: CaptureKind
    reserved: u8

fn capture_slot(name: u32, kind: CaptureKind) -> CaptureSlot:
    CaptureSlot(name: name, kind: kind, reserved: 0)

fn capture_slot_equal(a: CaptureSlot, b: CaptureSlot) -> bool:
    (a.name == b.name and capture_kind_equal(a.kind, b.kind)
        and a.reserved == b.reserved)

fn capture_zero_slot() -> CaptureSlot:
    capture_slot(0, CaptureKind.Entity)

fn capture_schema_well_formed(slots: [CaptureSlot]) -> bool:
    """Reserved bytes zero, and no duplicate slot NAME. A duplicated name does
    not fail loudly: `Capture(join_point)` written twice would bind two slots
    with one name and a consumer reading by name would silently get whichever
    the arena happened to lay down first."""
    var i = 0
    while i < slots.len():
        if slots[i].reserved != 0:
            return false
        var j = i + 1
        while j < slots.len():
            if slots[i].name == slots[j].name:
                return false
            j = j + 1
        i = i + 1
    true

# ----------------------------------------------------------------------------
# QueryProgram (§7.4)
#
# §7.4's field order is: dialect, schema_version, ops, constants, captures,
# index_requirements, determinism. On the wire the three `ObjectRef<...>` arenas
# serialize inline — a language-neutral schema (§26 deliverable 1) cannot ship a
# pointer into a host object table.
#
# `constants` is a u64 arena. §7.4 names `QueryConstantArena` and never gives it
# an element type; every constant §7.3's ops can reference — a TagKeyId, a
# TagValue `num` payload (§5.4 freezes that at u64), a MappingKindSet mask
# (§6.4, u32), an interned name (u32), a source-range bound (§4.3 anchors use
# u32 byte offsets) — fits in 64 bits, and a uniform element width is what keeps
# the arena SoA-addressable by index. Raised for ratification.
# ----------------------------------------------------------------------------

struct QueryProgram:
    dialect: QueryDialect
    schema_version: u32
    ops: [QueryOp]
    constants: [u64]
    captures: [CaptureSlot]
    index_requirements: u32
    determinism: QueryDeterminism

fn query_program(dialect: QueryDialect, schema_version: u32, ops: [QueryOp],
                 constants: [u64], captures: [CaptureSlot],
                 index_requirements: u32,
                 determinism: QueryDeterminism) -> QueryProgram:
    QueryProgram(dialect: dialect, schema_version: schema_version, ops: ops,
                 constants: constants, captures: captures,
                 index_requirements: index_requirements,
                 determinism: determinism)

fn query_program_equal(a: QueryProgram, b: QueryProgram) -> bool:
    if not query_dialect_equal(a.dialect, b.dialect):
        return false
    if a.schema_version != b.schema_version:
        return false
    if a.index_requirements != b.index_requirements:
        return false
    if query_determinism_to_u8(a.determinism) != query_determinism_to_u8(b.determinism):
        return false
    if a.ops.len() != b.ops.len() or a.constants.len() != b.constants.len():
        return false
    if a.captures.len() != b.captures.len():
        return false
    var i = 0
    while i < a.ops.len():
        if not query_op_equal(a.ops[i], b.ops[i]):
            return false
        i = i + 1
    var c = 0
    while c < a.constants.len():
        if a.constants[c] != b.constants[c]:
            return false
        c = c + 1
    var s = 0
    while s < a.captures.len():
        if not capture_slot_equal(a.captures[s], b.captures[s]):
            return false
        s = s + 1
    true

fn query_program_valid(p: QueryProgram) -> bool:
    """Full structural rule. Encode refuses to emit a program that fails it and
    decode refuses to accept one, so the accepted set is exactly the emitted
    set — the property that let wave 0b's shard codec catch a CSR whose reverse
    index pointed past the forward edge list."""
    if not query_determinism_valid(query_determinism_to_u8(p.determinism)):
        return false
    if not tag_index_set_valid(p.index_requirements):
        return false
    if p.schema_version < 0 or p.schema_version > QUERY_U32_MAX:
        return false
    # An empty op arena is not a program that selects nothing, it is a program
    # with no result at all. §7.5's `execute` must always have a result set.
    if p.ops.len() < 1:
        return false
    if not query_op_kind_is_seed(p.ops[0].kind):
        return false
    if not capture_schema_well_formed(p.captures):
        return false
    var i = 0
    while i < p.ops.len():
        if not query_op_well_formed(p.ops[i], i, p.constants.len(),
                                    p.captures.len()):
            return false
        i = i + 1
    true

fn query_program_capture_index(p: QueryProgram, name: u32) -> i64:
    """Index of the capture slot with `name`, or -1. Names are unique by
    `capture_schema_well_formed`, so the first hit is the only hit."""
    var i = 0
    while i < p.captures.len():
        if p.captures[i].name == name:
            return i
        i = i + 1
    0 - 1

export QUERY_NO_INPUT, QUERY_NO_CONSTANT, QUERY_U32_MAX
export EntitySetOrder, ENTITY_SET_ORDER_MAX
export entity_set_order_to_u8, entity_set_order_from_u8
export entity_set_order_valid, entity_set_order_equal
export ENTITY_SET_VIEW_LEN, EntitySetView, entity_set_view
export entity_set_view_empty, entity_set_view_equal, entity_set_view_well_formed
export QUERY_OP_LEN, QueryOp, query_op, query_op_seed, query_op_unary
export query_op_binary, query_zero_op, query_op_equal, query_op_well_formed
export CaptureKind, CAPTURE_KIND_MAX, capture_kind_to_u8, capture_kind_from_u8
export capture_kind_valid, capture_kind_equal
export CAPTURE_SLOT_LEN, CaptureSlot, capture_slot, capture_slot_equal
export capture_zero_slot, capture_schema_well_formed
export QueryProgram, query_program, query_program_equal, query_program_valid
export query_program_capture_index
