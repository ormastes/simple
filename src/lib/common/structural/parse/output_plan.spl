# Output-range planning helpers for canonical parse executors.
#
# The parser framework currently emits via dense spans in SoA arrays. This file
# defines one explicit planning API so count/scan/emit executors can be added
# without inventing local range conventions.

val PARSE_OUTPUT_RANGE_MAX: i64 = 0x7fffffff

struct ParseOutputRange:
    start: i64
    count: i64

struct ParseOutputCounts:
    tokens: i64
    nodes: i64
    children: i64
    tags: i64
    mappings: i64
    indexes: i64
    diagnostics: i64

struct ParseOutputRanges:
    tokens: ParseOutputRange
    nodes: ParseOutputRange
    children: ParseOutputRange
    tags: ParseOutputRange
    mappings: ParseOutputRange
    indexes: ParseOutputRange
    diagnostics: ParseOutputRange

fn _checked_count(v: i64, backend_max: i64, name: text) -> Result<i64, text>:
    if v < 0:
        return Err(name + ":negative_count")
    if v > backend_max:
        return Err(name + ":count_overflow")
    if v > PARSE_OUTPUT_RANGE_MAX:
        return Err(name + ":count_too_large")
    Ok(v)

fn checked_output_ranges(counts: ParseOutputCounts, backend_max: i64) -> Result<ParseOutputRanges, text>:
    if backend_max < 0:
        return Err("backend_max_negative")

    val tokens_count = _checked_count(counts.tokens, backend_max, "tokens")
    val tokens_count_value = match tokens_count:
        Ok(v) -> v
        Err(reason) -> return Err(reason)

    val nodes_count = _checked_count(counts.nodes, backend_max, "nodes")
    val nodes_count_value = match nodes_count:
        Ok(v) -> v
        Err(reason) -> return Err(reason)

    val children_count = _checked_count(counts.children, backend_max, "children")
    val children_count_value = match children_count:
        Ok(v) -> v
        Err(reason) -> return Err(reason)

    val tags_count = _checked_count(counts.tags, backend_max, "tags")
    val tags_count_value = match tags_count:
        Ok(v) -> v
        Err(reason) -> return Err(reason)

    val mappings_count = _checked_count(counts.mappings, backend_max, "mappings")
    val mappings_count_value = match mappings_count:
        Ok(v) -> v
        Err(reason) -> return Err(reason)

    val indexes_count = _checked_count(counts.indexes, backend_max, "indexes")
    val indexes_count_value = match indexes_count:
        Ok(v) -> v
        Err(reason) -> return Err(reason)

    val diagnostics_count = _checked_count(counts.diagnostics, backend_max, "diagnostics")
    val diagnostics_count_value = match diagnostics_count:
        Ok(v) -> v
        Err(reason) -> return Err(reason)

    var cursor = 0
    val tokens_range = ParseOutputRange(start: cursor, count: tokens_count_value)
    cursor = cursor + tokens_count_value
    val nodes_range = ParseOutputRange(start: cursor, count: nodes_count_value)
    cursor = cursor + nodes_count_value
    val children_range = ParseOutputRange(start: cursor, count: children_count_value)
    cursor = cursor + children_count_value
    val tags_range = ParseOutputRange(start: cursor, count: tags_count_value)
    cursor = cursor + tags_count_value
    val mappings_range = ParseOutputRange(start: cursor, count: mappings_count_value)
    cursor = cursor + mappings_count_value
    val indexes_range = ParseOutputRange(start: cursor, count: indexes_count_value)
    cursor = cursor + indexes_count_value
    val diagnostics_range = ParseOutputRange(start: cursor, count: diagnostics_count_value)

    Ok(ParseOutputRanges(
        tokens: tokens_range,
        nodes: nodes_range,
        children: children_range,
        tags: tags_range,
        mappings: mappings_range,
        indexes: indexes_range,
        diagnostics: diagnostics_range
    ))

export ParseOutputRange, ParseOutputCounts, ParseOutputRanges
export checked_output_ranges
