"""Owned semantic output for the opt-in scalar grammar core; no compiler AST effects."""

pub struct ParseProgramNodeV1:
    kind: i64
    start: i64
    count: i64
    value: i64
    child_start: i64
    child_count: i64

pub struct ParseProgramDiagnosticV1:
    code: i64
    start: i64
    count: i64

pub struct ParseProgramOutputV1:
    nodes: [ParseProgramNodeV1]
    children: [i64]
    diagnostics: [ParseProgramDiagnosticV1]
    roots: [i64]

pub struct ParseProgramExecutionV1:
    ok: bool
    error: text
    output: ParseProgramOutputV1
    steps_used: i64
    tokens_consumed: i64

pub fn parse_program_output_empty_v1() -> ParseProgramOutputV1:
    ParseProgramOutputV1(nodes: [], children: [], diagnostics: [], roots: [])

pub fn parse_program_output_copy_v1(value: ParseProgramOutputV1) -> ParseProgramOutputV1:
    var nodes: [ParseProgramNodeV1] = []
    var children: [i64] = []
    var diagnostics: [ParseProgramDiagnosticV1] = []
    var roots: [i64] = []
    for node in value.nodes: nodes.push(node)
    for child in value.children: children.push(child)
    for diagnostic in value.diagnostics: diagnostics.push(diagnostic)
    for root in value.roots: roots.push(root)
    ParseProgramOutputV1(nodes: nodes, children: children, diagnostics: diagnostics, roots: roots)

pub fn parse_program_execution_failed_v1(error: text, steps: i64) -> ParseProgramExecutionV1:
    ParseProgramExecutionV1(ok: false, error: error,
        output: parse_program_output_empty_v1(), steps_used: steps, tokens_consumed: 0)

export ParseProgramNodeV1, ParseProgramDiagnosticV1, ParseProgramOutputV1, ParseProgramExecutionV1
export parse_program_output_empty_v1, parse_program_output_copy_v1, parse_program_execution_failed_v1
