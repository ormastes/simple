# Parser dialect contracts and validated descriptor wrapper.
#
# This is the shared lane shape for wave-2 dialect description. Wave-1 execution
# still uses the existing parse_types ParseDialect; this file currently publishes
# both the richer planned structures and a compatibility validator/facade.

use std.common.structural.parse.contracts.{ParseError, ParseErrorCode}
use std.common.structural.parse.parse_types.{
    ParseLexProgram,
    ParseDialect as LegacyParseDialect,
    parse_dialect_lexical,
    parse_dialect_id
}

type ParseDialect = LegacyParseDialect

class LexContinuationState:
    mode: i64
    quote_kind: i64
    at_line_start: bool
    paren_depth: i64

class LexProgram:
    contract_version: i64
    state_count: i64
    start_state: i64
    max_gpu_states: i64
    opcodes: [i64]

class StructureProgram:
    contract_version: i64
    block_bytes: i64
    classification_mask: i64

class GrammarProgram:
    contract_version: i64
    entry_rules: [i64]
    production_offsets: [i64]
    opcodes: [i64]

class ActionProgram:
    contract_version: i64
    action_offsets: [i64]
    opcodes: [i64]

struct TagSchema:
    contract_version: i64
    key_ids: [i64]
    value_kinds: [i64]

struct MappingPolicy:
    emitted_kinds: [i64]

struct IncrementalPolicy:
    checkpoint_bytes: i64
    max_stabilization_bytes: i64
    reusable_entry_rules: [i64]

fn parse_dialect_validate_structure(dialect: ParseDialect) -> bool:
    if parse_dialect_id(dialect) == 0u32:
        false
    elif parse_dialect_id(dialect) == 0xFFFFFFFFu32:
        false
    else:
        true

fn validate_parse_dialect(dialect: ParseDialect) -> Result<(), ParseError>:
    if not parse_dialect_validate_structure(dialect):
        return Err(ParseError(
            code: ParseErrorCode.InvalidDialect,
            message: "invalid dialect identifier",
            span: nil
        ))
    Ok(())

fn parse_dialect_legacy(
    dialect_id: u32,
    lex_program: ParseLexProgram
) -> ParseDialect:
    parse_dialect_lexical(dialect_id, lex_program)

export ParseDialect
export LexContinuationState, LexProgram, StructureProgram
export GrammarProgram, ActionProgram
export TagSchema, MappingPolicy, IncrementalPolicy
export validate_parse_dialect, parse_dialect_legacy
export parse_dialect_validate_structure
