# Frozen parser-framework contracts (lane: parser_framework).
#
# This file intentionally keeps the shared contract layer minimal and aligned to
# the current wave-1 behavior while reserving seam points for SIMD/GPU/incremental.
# It intentionally does not redefine dialect/program/result bodies, which remain
# in parse_types.spl for this milestone.

use std.common.structural.identity.{SnapshotId}

val PARSE_CONTRACT_VERSION: i64 = 1

struct SourceSpan:
    byte_start: i64
    byte_end: i64

class SourceSnapshot:
    id: SnapshotId
    parent_id: SnapshotId?
    bytes: [u8]
    newline_starts: [i64]

enum ParseErrorCode:
    InvalidDialect
    InvalidSnapshot
    InvalidEdit
    InvalidSpan
    MalformedUtf
    CountOverflow
    BackendWidthOverflow
    OutputUnderfill
    OutputOverfill
    StalePrior
    UnsupportedMode
    RequiredModeUnavailable
    ExecutorFailed

struct ParseError:
    code: ParseErrorCode
    message: text
    span: SourceSpan?

enum ParseExecutionMode:
    Scalar
    Simd
    Gpu
    Incremental
    Auto

enum FallbackPolicy:
    AllowScalar
    RequireRequested

enum TagDemand:
    Off
    Tags
    TagsAndIndexes

struct ParseOutputMask:
    tokens: bool
    syntax: bool
    tags: bool
    mappings: bool
    indexes: bool
    diagnostics: bool

struct SourceAnchor:
    snapshot: SnapshotId
    span: SourceSpan

struct TextEdit:
    base_span: SourceSpan
    replacement: [u8]

struct QueryIndexKey:
    namespace_id: i64
    value_id: i64

struct QueryIndexRecord:
    key: QueryIndexKey
    node_id: i64

struct ParseErrorReceipt:
    backend: text
    mode: ParseExecutionMode
    stage: text
    output_hash: text
    item_count_in: i64
    item_count_out: i64
    malformed_count: i64

class SourceStringTable:
    byte_offsets: [i64]
    byte_lengths: [i64]
    bytes: [u8]

class TokenArena:
    kinds: [i64]
    byte_starts: [i64]
    byte_ends: [i64]
    value_ids: [i64]
    flags: [i64]

export PARSE_CONTRACT_VERSION
export ParseErrorCode, ParseError
export ParseExecutionMode, FallbackPolicy, TagDemand
export ParseOutputMask, SourceSpan, SourceAnchor, SourceSnapshot
export SourceStringTable, TokenArena
export TextEdit, QueryIndexKey, QueryIndexRecord
export ParseErrorReceipt
