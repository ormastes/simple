# ============================================================================
# common/structural/placement/placement_contracts.spl — frozen wire vocabulary
#
# PLACE lane (architecture §27). Freezes the wire discriminants, bitsets and
# comparison primitives for the PlacementRequest / PlacementPlan / lease-rules
# contract group (architecture §20.2, §20.3, §20.5, §26).
#
# Contract document:
#   doc/05_design/platform/structural_compute/placement_contract_v1.md
#
# NOTHING IS REDECLARED HERE. `ResidencyTier`, `AccessPattern`,
# `PersistencePolicy`, `ExecutionMode`, `Hash256`, `ObjectRef` and
# `ResidentView` already exist in src/lib/common/compute/placement_contracts/
# and are IMPORTED. `residency_tier_to_u8` / `_from_u8` / `_valid` /
# `_is_device`, `PLACEMENT_NO_SLOT` and `PLACEMENT_NO_EPOCH` are likewise
# already frozen in that directory's schema.spl and are re-used, not restated.
# Two declarations of one wire type is how lanes silently diverge.
#
# What this file adds is the part that directory has no encoder for: the u8
# discriminants of AccessPattern and PersistencePolicy, the ResidencyTierSet
# bitset, and the lease-lifetime vocabulary (§20.5) that the architecture
# declares but never defines.
# ============================================================================

use std.common.compute.placement_contracts.residency.{ResidencyTier}
use std.common.compute.placement_contracts.semantic.{AccessPattern, PersistencePolicy}
use std.common.compute.placement_contracts.schema.{
    PLACEMENT_SCHEMA_ID,
    RESIDENCY_TIER_MAX,
    residency_tier_is_device,
    residency_tier_to_u8,
    residency_tier_valid
}

# ----------------------------------------------------------------------------
# Version
#
# The wire envelope carries a u16 version. `PLACEMENT_SCHEMA_ID` in the sibling
# semantic directory is already 1; this constant is defined as an alias rather
# than a second source of truth, and the gate spec asserts the two are equal so
# they cannot drift apart.
# ----------------------------------------------------------------------------

val PLACE_SCHEMA_VERSION: i64 = 1

# ----------------------------------------------------------------------------
# Unsigned 64-bit comparison
#
# Simple has no unsigned 64-bit scalar. `wire_get_u64` returns the bit-identical
# i64, so a u64 at or above 2^63 comes back NEGATIVE. Every comparison of a
# decoded u64 must therefore go through these, never through a bare `<`.
#
# This is the 64-bit form of the width trap that has bitten two earlier waves at
# 32 bits (`offset + count <= U32_MAX` evaluated at u32 width and wrapped). The
# rule here is the same: widen or reinterpret deliberately, never compare raw.
# ----------------------------------------------------------------------------

fn place_u64_lt(a: i64, b: i64) -> bool:
    """Unsigned less-than over two i64 bit patterns. When the sign bits differ
    the negative operand is the LARGER unsigned value, so the result is decided
    by which side is negative, not by the signed comparison."""
    if (a < 0) != (b < 0):
        return b < 0
    a < b

fn place_u64_le(a: i64, b: i64) -> bool:
    not place_u64_lt(b, a)

fn place_u64_add_fits(a: i64, b: i64) -> bool:
    """True when `a + b` does not wrap past 2^64 - 1.

    `-1 - a` is exactly the bitwise complement of `a` in two's complement, i.e.
    the unsigned room left above `a`. The sum fits iff `b` is within that room.
    Computing the room instead of the sum is what keeps the check itself from
    wrapping — the defect this guards against."""
    place_u64_le(b, -1 - a)

# ----------------------------------------------------------------------------
# AccessPattern (§20.2 `access`)
#
# The enum already exists in placement_contracts/semantic.spl with no encoder.
# Declaration order there is the wire order, the same rule schema.spl applied
# to ResidencyTier.
# ----------------------------------------------------------------------------

val ACCESS_PATTERN_MAX: i64 = 4
val ACCESS_PATTERN_COUNT: i64 = 5

fn access_pattern_to_u8(v: AccessPattern) -> i64:
    match v:
        case AccessPattern.SequentialRead: 0
        case AccessPattern.RandomRead: 1
        case AccessPattern.ReadMostly: 2
        case AccessPattern.ReadWrite: 3
        case AccessPattern.WriteOnly: 4

fn access_pattern_from_u8(v: i64) -> AccessPattern:
    match v:
        case 1: AccessPattern.RandomRead
        case 2: AccessPattern.ReadMostly
        case 3: AccessPattern.ReadWrite
        case 4: AccessPattern.WriteOnly
        case _: AccessPattern.SequentialRead

fn access_pattern_valid(v: i64) -> bool:
    v >= 0 and v <= ACCESS_PATTERN_MAX

fn access_pattern_name(v: i64) -> text:
    match v:
        case 0: "SequentialRead"
        case 1: "RandomRead"
        case 2: "ReadMostly"
        case 3: "ReadWrite"
        case 4: "WriteOnly"
        case _: "InvalidAccessPattern"

# ----------------------------------------------------------------------------
# PersistencePolicy (§20.2 `persistence`)
# ----------------------------------------------------------------------------

val PERSISTENCE_POLICY_MAX: i64 = 3
val PERSISTENCE_POLICY_COUNT: i64 = 4

fn persistence_policy_to_u8(v: PersistencePolicy) -> i64:
    match v:
        case PersistencePolicy.Temporary: 0
        case PersistencePolicy.Checkpoint: 1
        case PersistencePolicy.Durable: 2
        case PersistencePolicy.Recomputable: 3

fn persistence_policy_from_u8(v: i64) -> PersistencePolicy:
    match v:
        case 1: PersistencePolicy.Checkpoint
        case 2: PersistencePolicy.Durable
        case 3: PersistencePolicy.Recomputable
        case _: PersistencePolicy.Temporary

fn persistence_policy_valid(v: i64) -> bool:
    v >= 0 and v <= PERSISTENCE_POLICY_MAX

fn persistence_policy_name(v: i64) -> text:
    match v:
        case 0: "Temporary"
        case 1: "Checkpoint"
        case 2: "Durable"
        case 3: "Recomputable"
        case _: "InvalidPersistencePolicy"

# ----------------------------------------------------------------------------
# ResidencyTierSet (§20.2 `required_tiers`)
#
# `ResidencyTierSet` exists in semantic.spl as `[ResidencyTier]`, which is a
# host-side carrier with no wire form. On the wire it is a u8 bitset, bit *i*
# = the tier whose discriminant is *i* in the already-frozen schema.spl
# numbering. Seven tiers fit in one byte with bit 7 left reserved, which is
# what keeps the whole request record byte-addressable.
# ----------------------------------------------------------------------------

val RESIDENCY_TIER_COUNT: i64 = 7

val TIER_SET_DEVICE_LOCAL: i64 = 1
val TIER_SET_DEVICE_SHARED: i64 = 2
val TIER_SET_HOST_PINNED: i64 = 4
val TIER_SET_HOST_HOT: i64 = 8
val TIER_SET_HOST_COLD: i64 = 16
val TIER_SET_SSD_CAS: i64 = 32
val TIER_SET_RECOMPUTABLE: i64 = 64

val TIER_SET_KNOWN: i64 = 127
val TIER_SET_EMPTY: i64 = 0

# Bits 0 and 1 are the two tiers schema.spl's `residency_tier_is_device` calls
# device-resident. Derived from that function, not restated as a literal.
val TIER_SET_DEVICE: i64 = 3

fn tier_set_valid(mask: i64) -> bool:
    """A tier set is well formed when no reserved bit is set. Bits 7..63 are
    reserved for tiers a later version may add; a set reserved bit is a HARD
    REJECT, never masked away, so an old reader cannot silently misread a newer
    writer's tier as absent."""
    mask >= 0 and (mask & TIER_SET_KNOWN) == mask

fn tier_set_contains(mask: i64, tier: i64) -> bool:
    if not residency_tier_valid(tier):
        return false
    (mask & (1 << tier)) != 0

fn tier_set_of(tier: ResidencyTier) -> i64:
    1 << residency_tier_to_u8(tier)

fn tier_set_has_device(mask: i64) -> bool:
    """True when the set names at least one tier whose bytes occupy the device
    budget. Delegates the device question to schema.spl rather than hardcoding
    which discriminants are device tiers."""
    var i = 0
    while i <= RESIDENCY_TIER_MAX:
        if (mask & (1 << i)) != 0 and residency_tier_is_device(i):
            return true
        i = i + 1
    false

# ----------------------------------------------------------------------------
# LeaseState — DERIVED. See the contract document's derivation table.
#
# §20.5 states the rule a lease enforces ("a raw address may be used only
# inside the lease epoch") but never says how a lease ENDS, which is exactly
# the gap that makes `EntityRef`'s "valid only while the referenced
# snapshot/object lease is valid" undecidable. The five states below are the
# minimum the surrounding sections actually distinguish:
#
#   Active(0)   §20.5, the ordinary in-epoch state.
#   Pinned(1)   §20.6 planner input "pin/in-flight status" and §31's
#               "pin/in-flight eviction prevention" gate.
#   InFlight(2) the same two sentences name pin and in-flight as SEPARATE
#               statuses, so they are two states, not one.
#   Released(3) §20.4 `fn release(leases: LeaseSet)` — ended by the holder.
#   Revoked(4)  §20.3's `evictions: ObjectRef<EvictionArena>` ends leases the
#               holder did not release; §30's "eviction/recovery, stale-handle"
#               gate and `PlacementError.StaleLease` are unreachable without a
#               state that distinguishes revocation from release.
#
# NOT monotone. Unlike QueryDeterminism these are never compared with `>=`;
# they are compared only through `lease_state_is_live`.
# ----------------------------------------------------------------------------

pub enum LeaseState:
    Active
    Pinned
    InFlight
    Released
    Revoked

val LEASE_STATE_MAX: i64 = 4
val LEASE_STATE_COUNT: i64 = 5

fn lease_state_to_u8(v: LeaseState) -> i64:
    match v:
        case LeaseState.Active: 0
        case LeaseState.Pinned: 1
        case LeaseState.InFlight: 2
        case LeaseState.Released: 3
        case LeaseState.Revoked: 4

fn lease_state_from_u8(v: i64) -> LeaseState:
    match v:
        case 1: LeaseState.Pinned
        case 2: LeaseState.InFlight
        case 3: LeaseState.Released
        case 4: LeaseState.Revoked
        case _: LeaseState.Active

fn lease_state_valid(v: i64) -> bool:
    v >= 0 and v <= LEASE_STATE_MAX

fn lease_state_name(v: i64) -> text:
    match v:
        case 0: "Active"
        case 1: "Pinned"
        case 2: "InFlight"
        case 3: "Released"
        case 4: "Revoked"
        case _: "InvalidLeaseState"

fn lease_state_is_live(v: i64) -> bool:
    """True for the three states in which the grant's device address may be
    dereferenced. This is the predicate §20.5's rule reduces to."""
    v >= 0 and v <= 2

fn lease_state_is_dead(v: i64) -> bool:
    v == 3 or v == 4

fn lease_state_prevents_eviction(v: i64) -> bool:
    """§20.6 lists pin/in-flight status as a planner input and §31 gates on
    'pin/in-flight eviction prevention'. An eviction plan that drops one of
    these is the defect that gate exists to catch."""
    v == 1 or v == 2

# ----------------------------------------------------------------------------
# LeaseAccess — DERIVED wire slot.
#
# §3.4: "GPU virtual-memory APIs separate address reservation, physical
# allocation, mapping, and ACCESS RIGHTS." The architecture adopts the explicit
# object-residency half of that sentence and never revisits the rights half, so
# the rights are frozen here as the minimum vocabulary §20.2's AccessPattern
# already distinguishes: read and write. No third right is invented — execute,
# atomics and coherence appear nowhere in the document.
#
# Bits 2..7 reserved, must be zero.
# ----------------------------------------------------------------------------

val LEASE_ACCESS_NONE: i64 = 0
val LEASE_ACCESS_READ: i64 = 1
val LEASE_ACCESS_WRITE: i64 = 2
val LEASE_ACCESS_KNOWN: i64 = 3

fn lease_access_valid(mask: i64) -> bool:
    mask >= 0 and (mask & LEASE_ACCESS_KNOWN) == mask

fn lease_access_contains(mask: i64, right: i64) -> bool:
    right != 0 and (mask & right) == right

fn lease_access_satisfies(granted: i64, required: i64) -> bool:
    """True when a grant carries every right a request needs. This is the check
    that makes an under-privileged lease a rejection rather than a fault at
    first write."""
    if not lease_access_valid(granted) or not lease_access_valid(required):
        return false
    (granted & required) == required

fn access_pattern_required_rights(v: i64) -> i64:
    """The rights an AccessPattern implies. `ReadMostly` is 'mostly' read, so
    it still writes; only `WriteOnly` drops the read right. This function is
    what ties §20.2's request field to the lease rights above, so a plan that
    grants a read-only lease for a ReadWrite request is detectable rather than
    a page fault later."""
    match v:
        case 0: LEASE_ACCESS_READ
        case 1: LEASE_ACCESS_READ
        case 2: LEASE_ACCESS_READ | LEASE_ACCESS_WRITE
        case 3: LEASE_ACCESS_READ | LEASE_ACCESS_WRITE
        case 4: LEASE_ACCESS_WRITE
        case _: LEASE_ACCESS_NONE

export PLACE_SCHEMA_VERSION, PLACEMENT_SCHEMA_ID
export place_u64_lt, place_u64_le, place_u64_add_fits
export ACCESS_PATTERN_MAX, ACCESS_PATTERN_COUNT
export access_pattern_to_u8, access_pattern_from_u8, access_pattern_valid
export access_pattern_name, access_pattern_required_rights
export PERSISTENCE_POLICY_MAX, PERSISTENCE_POLICY_COUNT
export persistence_policy_to_u8, persistence_policy_from_u8
export persistence_policy_valid, persistence_policy_name
export RESIDENCY_TIER_COUNT, TIER_SET_DEVICE_LOCAL, TIER_SET_DEVICE_SHARED
export TIER_SET_HOST_PINNED, TIER_SET_HOST_HOT, TIER_SET_HOST_COLD
export TIER_SET_SSD_CAS, TIER_SET_RECOMPUTABLE, TIER_SET_KNOWN
export TIER_SET_EMPTY, TIER_SET_DEVICE
export tier_set_valid, tier_set_contains, tier_set_of, tier_set_has_device
export LeaseState, LEASE_STATE_MAX, LEASE_STATE_COUNT
export lease_state_to_u8, lease_state_from_u8, lease_state_valid
export lease_state_name, lease_state_is_live, lease_state_is_dead
export lease_state_prevents_eviction
export LEASE_ACCESS_NONE, LEASE_ACCESS_READ, LEASE_ACCESS_WRITE
export LEASE_ACCESS_KNOWN
export lease_access_valid, lease_access_contains, lease_access_satisfies
