# codex-impl
# Bounded, init-only configuration owner for rt(hal) provider selection.

use std.common.structural.hal_provider.contracts.*

val HAL_RUNTIME_CONFIG_MAX_BYTES_V1: i64 = 1024
val HAL_RUNTIME_CONFIG_MAX_LINES_V1: i64 = 16

enum HalRuntimeConfigErrorV1:
    None
    SourceTooLarge
    TooManyLines
    MalformedLine
    UnknownKey
    DuplicateKey
    InvalidMode
    InvalidProvider
    InvalidEnabledSet
    PreferredDisabled
    OperationProviderMismatch

struct HalRuntimeConfigV1:
    valid: bool
    mode: HalRunMode
    preferred_provider: HalProviderKind
    enabled_providers_mask: i64
    error: HalRuntimeConfigErrorV1

struct HalConfiguredOperationV1:
    valid: bool
    mode: HalRunMode
    operation: HalOperationV1
    error: HalRuntimeConfigErrorV1

fn _hal_runtime_config_invalid(error: HalRuntimeConfigErrorV1) -> HalRuntimeConfigV1:
    HalRuntimeConfigV1(
        valid: false, mode: HalRunMode.AlphaCompare,
        preferred_provider: HalProviderKind.PureSimple,
        enabled_providers_mask: 0, error: error)

fn _hal_provider_count(mask: i64) -> i64:
    (if (mask & 1) != 0: 1 else: 0)
        + (if (mask & 2) != 0: 1 else: 0)
        + (if (mask & 4) != 0: 1 else: 0)

fn hal_runtime_config_v1(mode: HalRunMode,
                         preferred_provider: HalProviderKind,
                         enabled_providers_mask: i64) -> HalRuntimeConfigV1:
    if enabled_providers_mask <= 0 or enabled_providers_mask > HAL_PROVIDER_MASK_ALL:
        return _hal_runtime_config_invalid(
            HalRuntimeConfigErrorV1.InvalidEnabledSet)
    val preferred_mask = 1 << hal_provider_kind_to_i64(preferred_provider)
    if (enabled_providers_mask & preferred_mask) == 0:
        return _hal_runtime_config_invalid(
            HalRuntimeConfigErrorV1.PreferredDisabled)
    if (hal_run_mode_executes_all(mode)
            and _hal_provider_count(enabled_providers_mask) < 2):
        return _hal_runtime_config_invalid(
            HalRuntimeConfigErrorV1.InvalidEnabledSet)
    HalRuntimeConfigV1(
        valid: true, mode: mode, preferred_provider: preferred_provider,
        enabled_providers_mask: enabled_providers_mask,
        error: HalRuntimeConfigErrorV1.None)

fn hal_runtime_config_default_v1() -> HalRuntimeConfigV1:
    # No configuration is the safest migration posture: compare every
    # independent provider, stop before commit on any difference, and prefer
    # the Pure Simple result only after equivalence has been established.
    hal_runtime_config_v1(
        HalRunMode.AlphaCompare, HalProviderKind.PureSimple,
        HAL_PROVIDER_MASK_ALL)

fn _hal_parse_mode(value: text) -> (bool, HalRunMode):
    if value == "normal":
        return (true, HalRunMode.NormalPreferred)
    if value == "alpha":
        return (true, HalRunMode.AlphaCompare)
    if value == "beta":
        return (true, HalRunMode.BetaCompare)
    (false, HalRunMode.AlphaCompare)

fn _hal_parse_provider(value: text) -> (bool, HalProviderKind):
    if value == "pure":
        return (true, HalProviderKind.PureSimple)
    if value == "c":
        return (true, HalProviderKind.C)
    if value == "rust":
        return (true, HalProviderKind.Rust)
    (false, HalProviderKind.PureSimple)

fn _hal_parse_enabled(value: text) -> (bool, i64):
    if value == "":
        return (false, 0)
    var mask: i64 = 0
    var start: i64 = 0
    var cursor: i64 = 0
    while cursor <= value.len():
        if cursor == value.len() or value.char_code_at(cursor) == 44:
            val token = value.substring(start, cursor).trim()
            val parsed = _hal_parse_provider(token)
            if not parsed.0:
                return (false, 0)
            val bit = 1 << hal_provider_kind_to_i64(parsed.1)
            if (mask & bit) != 0:
                return (false, 0)
            mask = mask | bit
            start = cursor + 1
        cursor = cursor + 1
    (mask != 0, mask)

@init_phase
fn hal_runtime_config_parse_v1(source: text) -> HalRuntimeConfigV1:
    if source.len() == 0:
        return hal_runtime_config_default_v1()
    if source.len() > HAL_RUNTIME_CONFIG_MAX_BYTES_V1:
        return _hal_runtime_config_invalid(
            HalRuntimeConfigErrorV1.SourceTooLarge)
    var mode = HalRunMode.AlphaCompare
    var preferred = HalProviderKind.PureSimple
    var enabled: i64 = HAL_PROVIDER_MASK_ALL
    var seen: i64 = 0
    var line_count: i64 = 0
    var line_start: i64 = 0
    var cursor: i64 = 0
    while cursor <= source.len():
        if cursor == source.len() or source.char_code_at(cursor) == 10:
            line_count = line_count + 1
            if line_count > HAL_RUNTIME_CONFIG_MAX_LINES_V1:
                return _hal_runtime_config_invalid(
                    HalRuntimeConfigErrorV1.TooManyLines)
            val line = source.substring(line_start, cursor).trim()
            line_start = cursor + 1
            if line != "" and not line.starts_with("#"):
                val separator = line.index_of(":")
                if separator <= 0:
                    return _hal_runtime_config_invalid(
                        HalRuntimeConfigErrorV1.MalformedLine)
                val key = line.substring(0, separator).trim()
                val value = line.substring(separator + 1, line.len()).trim()
                var key_bit: i64 = 0
                if key == "mode":
                    key_bit = 1
                    val parsed = _hal_parse_mode(value)
                    if not parsed.0:
                        return _hal_runtime_config_invalid(
                            HalRuntimeConfigErrorV1.InvalidMode)
                    mode = parsed.1
                elif key == "preferred":
                    key_bit = 2
                    val parsed = _hal_parse_provider(value)
                    if not parsed.0:
                        return _hal_runtime_config_invalid(
                            HalRuntimeConfigErrorV1.InvalidProvider)
                    preferred = parsed.1
                elif key == "enabled":
                    key_bit = 4
                    val parsed = _hal_parse_enabled(value)
                    if not parsed.0:
                        return _hal_runtime_config_invalid(
                            HalRuntimeConfigErrorV1.InvalidEnabledSet)
                    enabled = parsed.1
                else:
                    return _hal_runtime_config_invalid(
                        HalRuntimeConfigErrorV1.UnknownKey)
                if (seen & key_bit) != 0:
                    return _hal_runtime_config_invalid(
                        HalRuntimeConfigErrorV1.DuplicateKey)
                seen = seen | key_bit
        cursor = cursor + 1
    hal_runtime_config_v1(mode, preferred, enabled)

fn hal_runtime_config_apply_v1(
        operation: HalOperationV1,
        config: HalRuntimeConfigV1) -> HalConfiguredOperationV1:
    if not config.valid:
        return HalConfiguredOperationV1(
            valid: false, mode: config.mode, operation: operation,
            error: config.error)
    if (config.enabled_providers_mask & ~operation.providers_mask) != 0:
        return HalConfiguredOperationV1(
            valid: false, mode: config.mode, operation: operation,
            error: HalRuntimeConfigErrorV1.OperationProviderMismatch)
    var configured = operation
    configured.providers_mask = config.enabled_providers_mask
    configured.preferred_provider = config.preferred_provider
    HalConfiguredOperationV1(
        valid: hal_operation_v1_well_formed(configured),
        mode: config.mode, operation: configured,
        error: if hal_operation_v1_well_formed(configured):
            HalRuntimeConfigErrorV1.None
        else:
            HalRuntimeConfigErrorV1.OperationProviderMismatch)

export HAL_RUNTIME_CONFIG_MAX_BYTES_V1, HAL_RUNTIME_CONFIG_MAX_LINES_V1
export HalRuntimeConfigErrorV1, HalRuntimeConfigV1, HalConfiguredOperationV1
export hal_runtime_config_v1, hal_runtime_config_default_v1
export hal_runtime_config_parse_v1, hal_runtime_config_apply_v1
