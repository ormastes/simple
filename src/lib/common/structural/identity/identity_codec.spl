# ============================================================================
# common/structural/identity/identity_codec.spl — CPU reference serializers
#
# The CPU reference codec for the frozen identity contract (architecture §26
# deliverable "CPU reference serializers/deserializers"). Per the shared lane
# rules, the CPU reference is the oracle and is never deleted; any future
# vectorized or GPU-resident encoder must produce byte-identical output.
#
# Layout (all little-endian, no padding — see common/structural/wire.spl):
#
#   Hash128            16  hi u64 | lo u64
#   ArtifactId         20  content_hash Hash128 | schema_version u32
#   EntityRef           8  object_slot u32 | local_index u32
#   EntityKey          32  artifact ArtifactId | schema u32 | local_identity u64
#   SemanticEntityKey  44  language u32 | qualified_name u32
#                          | signature_hash Hash128 | definition_artifact ArtifactId
#   SourceAnchor       36  file ArtifactId | byte_start u32 | byte_end u32
#                          | spelling_context u32 | expansion_context u32
#   SnapshotId         28  root_artifact ArtifactId | epoch u64
#
# Bare `*_put`/`*_read` functions are the unframed field codecs used when a
# record is embedded inside a larger structure. The `encode_*`/`decode_*` pairs
# wrap a single record in the 8-byte envelope for standalone storage.
#
# Decoders are total: they never trap on malformed input, they return a result
# struct carrying an `ok` flag. Explicit result structs are used in preference
# to Option because Option lowering differs across this repo's engines.
# ============================================================================

use std.common.structural.wire.{
    WIRE_ENVELOPE_LEN,
    wire_check_envelope,
    wire_get_u32,
    wire_get_u64,
    wire_has,
    wire_magic,
    wire_put_envelope,
    wire_put_u32,
    wire_put_u64
}
use std.common.structural.identity.entity_id.{
    ARTIFACT_ID_LEN,
    ENTITY_KEY_LEN,
    ENTITY_REF_LEN,
    IDENTITY_SCHEMA_VERSION,
    SEMANTIC_ENTITY_KEY_LEN,
    SNAPSHOT_ID_LEN,
    SOURCE_ANCHOR_LEN,
    ArtifactId,
    EntityKey,
    EntityRef,
    Hash128,
    SemanticEntityKey,
    SnapshotId,
    SourceAnchor,
    artifact_id,
    entity_key,
    entity_ref,
    hash128,
    semantic_entity_key,
    snapshot_id,
    source_anchor
}

# ----------------------------------------------------------------------------
# Record magics. Four ASCII bytes each, distinct per record type so that a
# mis-routed buffer is rejected rather than silently reinterpreted.
# ----------------------------------------------------------------------------

fn identity_magic_entity_ref() -> i64:
    wire_magic("SREF")

fn identity_magic_entity_key() -> i64:
    wire_magic("SKEY")

fn identity_magic_snapshot_id() -> i64:
    wire_magic("SSNP")

fn identity_magic_semantic_key() -> i64:
    wire_magic("SSEM")

fn identity_magic_source_anchor() -> i64:
    wire_magic("SANC")

# ----------------------------------------------------------------------------
# Result carriers
# ----------------------------------------------------------------------------

struct EntityRefResult:
    ok: bool
    value: EntityRef

struct EntityKeyResult:
    ok: bool
    value: EntityKey

struct SnapshotIdResult:
    ok: bool
    value: SnapshotId

struct SemanticEntityKeyResult:
    ok: bool
    value: SemanticEntityKey

struct SourceAnchorResult:
    ok: bool
    value: SourceAnchor

fn identity_zero_hash() -> Hash128:
    hash128(0, 0)

fn identity_zero_artifact() -> ArtifactId:
    artifact_id(identity_zero_hash(), 0)

# ----------------------------------------------------------------------------
# Unframed field codecs
# ----------------------------------------------------------------------------

fn hash128_put(out: [u8], h: Hash128) -> [u8]:
    var b = wire_put_u64(out, h.hi)
    wire_put_u64(b, h.lo)

fn hash128_read(data: [u8], off: i64) -> Hash128:
    hash128(wire_get_u64(data, off), wire_get_u64(data, off + 8))

fn artifact_id_put(out: [u8], a: ArtifactId) -> [u8]:
    var b = hash128_put(out, a.content_hash)
    wire_put_u32(b, a.schema_version)

fn artifact_id_read(data: [u8], off: i64) -> ArtifactId:
    artifact_id(hash128_read(data, off), wire_get_u32(data, off + 16))

fn entity_ref_put(out: [u8], e: EntityRef) -> [u8]:
    var b = wire_put_u32(out, e.object_slot)
    wire_put_u32(b, e.local_index)

fn entity_ref_read(data: [u8], off: i64) -> EntityRef:
    entity_ref(wire_get_u32(data, off), wire_get_u32(data, off + 4))

fn entity_key_put(out: [u8], k: EntityKey) -> [u8]:
    var b = artifact_id_put(out, k.artifact)
    b = wire_put_u32(b, k.schema)
    wire_put_u64(b, k.local_identity)

fn entity_key_read(data: [u8], off: i64) -> EntityKey:
    entity_key(artifact_id_read(data, off),
               wire_get_u32(data, off + ARTIFACT_ID_LEN),
               wire_get_u64(data, off + ARTIFACT_ID_LEN + 4))

fn snapshot_id_put(out: [u8], s: SnapshotId) -> [u8]:
    var b = artifact_id_put(out, s.root_artifact)
    wire_put_u64(b, s.epoch)

fn snapshot_id_read(data: [u8], off: i64) -> SnapshotId:
    snapshot_id(artifact_id_read(data, off),
                wire_get_u64(data, off + ARTIFACT_ID_LEN))

fn semantic_entity_key_put(out: [u8], k: SemanticEntityKey) -> [u8]:
    var b = wire_put_u32(out, k.language)
    b = wire_put_u32(b, k.qualified_name)
    b = hash128_put(b, k.signature_hash)
    artifact_id_put(b, k.definition_artifact)

fn semantic_entity_key_read(data: [u8], off: i64) -> SemanticEntityKey:
    semantic_entity_key(wire_get_u32(data, off),
                        wire_get_u32(data, off + 4),
                        hash128_read(data, off + 8),
                        artifact_id_read(data, off + 24))

fn source_anchor_put(out: [u8], a: SourceAnchor) -> [u8]:
    var b = artifact_id_put(out, a.file)
    b = wire_put_u32(b, a.byte_start)
    b = wire_put_u32(b, a.byte_end)
    b = wire_put_u32(b, a.spelling_context)
    wire_put_u32(b, a.expansion_context)

fn source_anchor_read(data: [u8], off: i64) -> SourceAnchor:
    source_anchor(artifact_id_read(data, off),
                  wire_get_u32(data, off + 20),
                  wire_get_u32(data, off + 24),
                  wire_get_u32(data, off + 28),
                  wire_get_u32(data, off + 32))

# ----------------------------------------------------------------------------
# Framed standalone records
# ----------------------------------------------------------------------------

fn encode_entity_ref(e: EntityRef) -> [u8]:
    var b: [u8] = []
    b = wire_put_envelope(b, identity_magic_entity_ref(), IDENTITY_SCHEMA_VERSION)
    entity_ref_put(b, e)

fn decode_entity_ref(data: [u8]) -> EntityRefResult:
    if not wire_check_envelope(data, 0, identity_magic_entity_ref(),
                               IDENTITY_SCHEMA_VERSION):
        return EntityRefResult(ok: false, value: entity_ref(0, 0))
    if not wire_has(data, WIRE_ENVELOPE_LEN, ENTITY_REF_LEN):
        return EntityRefResult(ok: false, value: entity_ref(0, 0))
    EntityRefResult(ok: true, value: entity_ref_read(data, WIRE_ENVELOPE_LEN))

fn encode_entity_key(k: EntityKey) -> [u8]:
    var b: [u8] = []
    b = wire_put_envelope(b, identity_magic_entity_key(), IDENTITY_SCHEMA_VERSION)
    entity_key_put(b, k)

fn decode_entity_key(data: [u8]) -> EntityKeyResult:
    val empty = entity_key(identity_zero_artifact(), 0, 0)
    if not wire_check_envelope(data, 0, identity_magic_entity_key(),
                               IDENTITY_SCHEMA_VERSION):
        return EntityKeyResult(ok: false, value: empty)
    if not wire_has(data, WIRE_ENVELOPE_LEN, ENTITY_KEY_LEN):
        return EntityKeyResult(ok: false, value: empty)
    EntityKeyResult(ok: true, value: entity_key_read(data, WIRE_ENVELOPE_LEN))

fn encode_snapshot_id(s: SnapshotId) -> [u8]:
    var b: [u8] = []
    b = wire_put_envelope(b, identity_magic_snapshot_id(), IDENTITY_SCHEMA_VERSION)
    snapshot_id_put(b, s)

fn decode_snapshot_id(data: [u8]) -> SnapshotIdResult:
    val empty = snapshot_id(identity_zero_artifact(), 0)
    if not wire_check_envelope(data, 0, identity_magic_snapshot_id(),
                               IDENTITY_SCHEMA_VERSION):
        return SnapshotIdResult(ok: false, value: empty)
    if not wire_has(data, WIRE_ENVELOPE_LEN, SNAPSHOT_ID_LEN):
        return SnapshotIdResult(ok: false, value: empty)
    SnapshotIdResult(ok: true, value: snapshot_id_read(data, WIRE_ENVELOPE_LEN))

fn encode_semantic_entity_key(k: SemanticEntityKey) -> [u8]:
    var b: [u8] = []
    b = wire_put_envelope(b, identity_magic_semantic_key(), IDENTITY_SCHEMA_VERSION)
    semantic_entity_key_put(b, k)

fn decode_semantic_entity_key(data: [u8]) -> SemanticEntityKeyResult:
    val empty = semantic_entity_key(0, 0, identity_zero_hash(),
                                    identity_zero_artifact())
    if not wire_check_envelope(data, 0, identity_magic_semantic_key(),
                               IDENTITY_SCHEMA_VERSION):
        return SemanticEntityKeyResult(ok: false, value: empty)
    if not wire_has(data, WIRE_ENVELOPE_LEN, SEMANTIC_ENTITY_KEY_LEN):
        return SemanticEntityKeyResult(ok: false, value: empty)
    SemanticEntityKeyResult(ok: true,
                            value: semantic_entity_key_read(data, WIRE_ENVELOPE_LEN))

fn encode_source_anchor(a: SourceAnchor) -> [u8]:
    var b: [u8] = []
    b = wire_put_envelope(b, identity_magic_source_anchor(), IDENTITY_SCHEMA_VERSION)
    source_anchor_put(b, a)

fn decode_source_anchor(data: [u8]) -> SourceAnchorResult:
    val empty = source_anchor(identity_zero_artifact(), 0, 0, 0, 0)
    if not wire_check_envelope(data, 0, identity_magic_source_anchor(),
                               IDENTITY_SCHEMA_VERSION):
        return SourceAnchorResult(ok: false, value: empty)
    if not wire_has(data, WIRE_ENVELOPE_LEN, SOURCE_ANCHOR_LEN):
        return SourceAnchorResult(ok: false, value: empty)
    SourceAnchorResult(ok: true, value: source_anchor_read(data, WIRE_ENVELOPE_LEN))
