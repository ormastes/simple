# ============================================================================
# common/structural/wire.spl — frozen wire primitives for structural contracts
#
# Owned by the ID-TAG lane (architecture §27). This is the shared wire port
# that every other structural contract lane (MAP, QUERY, MUTATE, INVALIDATE,
# EXEC, PLACE) reuses, so that all ten frozen artifact groups share one
# byte-level convention instead of inventing ten.
#
# It is a *frozen port* in the sense of gpu_web_scene plan §10 rule 12: it is
# not an ad-hoc utility file, it is part of the ID-TAG contract deliverable and
# is read-only to other lanes once merged.
#
# CONVENTIONS (see doc/05_design/platform/structural_compute/
# identity_tagmap_contract_v1.md for the normative statement):
#
#   - All integers are little-endian, fixed width, no padding, no alignment.
#   - All enums encode as a single u8 discriminant.
#   - All lists encode as u32 count followed by that many elements.
#   - Every top-level record carries an 8-byte envelope:
#         magic u32 (4 ASCII bytes, LE) | version u16 | reserved u16 (== 0)
#   - Decoders are total: they return an ok flag rather than trapping, and an
#     unknown enum discriminant is a HARD REJECT, never a silent default.
#     (Architecture §30.1: "stale ... references fail".)
# ============================================================================

# ----------------------------------------------------------------------------
# Envelope
# ----------------------------------------------------------------------------

val WIRE_ENVELOPE_LEN: i64 = 8

fn wire_envelope_len() -> i64:
    """Return the frozen envelope width without a cross-module global read."""
    WIRE_ENVELOPE_LEN

fn wire_magic(a: text) -> i64:
    """Pack a 4-character ASCII tag into a u32 magic, first char in the low byte."""
    if a.len() != 4:
        return 0
    var m = 0
    var i = 3
    while i >= 0:
        m = (m << 8) | (a.char_code_at(i) & 0xFF)
        i = i - 1
    m

# ----------------------------------------------------------------------------
# Unsigned little-endian writers
#
# Each writer appends to `out` and returns it. The `& 0xFF` after every shift
# is load-bearing: i64 `>>` sign-extends, so without the mask a u64 whose top
# bit is set would emit 0xFF filler in the high bytes.
# ----------------------------------------------------------------------------

fn wire_put_u8(out: [u8], v: i64) -> [u8]:
    var b = out
    b.push(v & 0xFF)
    b

fn wire_put_u16(out: [u8], v: i64) -> [u8]:
    var b = out
    b.push(v & 0xFF)
    b.push((v >> 8) & 0xFF)
    b

fn wire_put_u32(out: [u8], v: i64) -> [u8]:
    var b = out
    b.push(v & 0xFF)
    b.push((v >> 8) & 0xFF)
    b.push((v >> 16) & 0xFF)
    b.push((v >> 24) & 0xFF)
    b

fn wire_put_u64(out: [u8], v: i64) -> [u8]:
    var b = out
    var i = 0
    while i < 8:
        b.push((v >> (i * 8)) & 0xFF)
        i = i + 1
    b

fn wire_put_envelope(out: [u8], magic: i64, version: i64) -> [u8]:
    """Append the standard 8-byte record envelope."""
    var b = wire_put_u32(out, magic)
    b = wire_put_u16(b, version)
    b = wire_put_u16(b, 0)
    b

# ----------------------------------------------------------------------------
# Unsigned little-endian readers
#
# Readers take an explicit offset and are bounds-checked by the caller through
# `wire_has(...)`. They return the decoded value only; the caller advances the
# cursor by the fixed width, which keeps the decoders branch-free and makes the
# byte layout auditable at every call site.
# ----------------------------------------------------------------------------

fn wire_has(data: [u8], off: i64, need: i64) -> bool:
    """True when `need` bytes are readable at `off`."""
    off >= 0 and need >= 0 and off + need <= data.len()

fn wire_get_u8(data: [u8], off: i64) -> i64:
    data[off] & 0xFF

fn wire_get_u16(data: [u8], off: i64) -> i64:
    (data[off] & 0xFF) | ((data[off + 1] & 0xFF) << 8)

fn wire_get_u32(data: [u8], off: i64) -> i64:
    var value = 0
    var i = 3
    while i >= 0:
        value = (value << 8) | (data[off + i] & 0xFF)
        i = i - 1
    value

fn wire_get_u64(data: [u8], off: i64) -> i64:
    """Decode 8 LE bytes. A u64 above 2^63 comes back as a negative i64 with the
    identical bit pattern, so the round trip is exact even though Simple has no
    unsigned 64-bit scalar."""
    var v = 0
    var i = 7
    while i >= 0:
        v = (v << 8) | (data[off + i] & 0xFF)
        i = i - 1
    v

fn wire_check_envelope(data: [u8], off: i64, magic: i64, version: i64) -> bool:
    """True when a well-formed envelope with the exact magic and version sits at
    `off`. A version mismatch is a rejection, not a negotiation: architecture
    §26 freezes contracts, and §12.6 requires rejecting unknown versions rather
    than assuming compatibility."""
    if not wire_has(data, off, wire_envelope_len()):
        return false
    if wire_get_u32(data, off) != magic:
        return false
    if wire_get_u16(data, off + 4) != version:
        return false
    wire_get_u16(data, off + 6) == 0

# ----------------------------------------------------------------------------
# Hex rendering — the golden-vector interchange form
#
# Golden vectors are stored as lowercase hex so they diff cleanly in review and
# are readable from any language. See the golden-vector convention in the
# contract document.
# ----------------------------------------------------------------------------

val WIRE_HEX_DIGITS: text = "0123456789abcdef"

fn wire_to_hex(data: [u8]) -> text:
    """Lowercase, unseparated hex rendering of a byte buffer."""
    var s = ""
    var i = 0
    while i < data.len():
        val b = data[i] & 0xFF
        s = s + WIRE_HEX_DIGITS.substring(b >> 4, (b >> 4) + 1)
        s = s + WIRE_HEX_DIGITS.substring(b & 0x0F, (b & 0x0F) + 1)
        i = i + 1
    s
