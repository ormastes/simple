# Versioned layout dependency and dirty-mask contracts.

val STRUCTURAL_INVALIDATION_CONTRACT_VERSION: i64 = 1
val DIRTY_NONE: i64 = 0
val DIRTY_INTRINSIC_MEASURE: i64 = 1
val DIRTY_LAYOUT: i64 = 2
val DIRTY_HIT_TEST: i64 = 4
val DIRTY_RESOURCE: i64 = 8

struct DirtyMask:
    bits: i64

impl DirtyMask:
    static fn none() -> DirtyMask: DirtyMask(bits: DIRTY_NONE)
    static fn from_bits(bits: i64) -> DirtyMask: DirtyMask(bits: bits)
    fn contains(bits: i64) -> bool: (self.bits & bits) == bits
    fn merged(bits: i64) -> DirtyMask: DirtyMask(bits: self.bits | bits)

struct LayoutDependency:
    contract_version: i64
    producer_id: i64
    consumer_id: i64
    kind: text
    dirty_bits: i64
    invalidates: DirtyMask

fn layout_dependency(producer_id: i64, consumer_id: i64, kind: text, dirty_bits: i64) -> LayoutDependency:
    LayoutDependency(
        contract_version: STRUCTURAL_INVALIDATION_CONTRACT_VERSION,
        producer_id: producer_id,
        consumer_id: consumer_id,
        kind: kind,
        dirty_bits: dirty_bits,
        invalidates: DirtyMask.from_bits(dirty_bits)
    )

export STRUCTURAL_INVALIDATION_CONTRACT_VERSION
export DIRTY_NONE, DIRTY_INTRINSIC_MEASURE, DIRTY_LAYOUT, DIRTY_HIT_TEST, DIRTY_RESOURCE
export DirtyMask, LayoutDependency, layout_dependency
