# Versioned layout dependency and dirty-mask contracts.

val STRUCTURAL_INVALIDATION_CONTRACT_VERSION: i64 = 1

# These four are the canonical §9.1 wire bit positions, NOT a private shorthand.
# They were originally packed at 1/2/4/8 (bits 0..3) by the layout lane before
# the contract freeze existed, which made bit 0 mean *IntrinsicMeasure* here
# while meaning *Source* on the wire. Reconciled onto the canonical positions
# frozen in invalidation/dirty_mask.spl, so a DirtyMask built by the layout lane
# and a DirtyMask decoded off the wire now mean the same thing bit for bit.
#
# Each value below is identical to the correspondingly-named DIRTY_BIT_* in
# dirty_mask.spl, and the contract spec asserts that equality — and asserts that
# a mask composed from these encodes to the canonical golden bytes — so the two
# vocabularies cannot drift apart again without a gate failure.
#
# FROZEN: these are wire values. A bit is never reused and never renumbered; a
# new stage takes the next free bit and a version bump.
val DIRTY_NONE: i64 = 0
val DIRTY_INTRINSIC_MEASURE: i64 = 16384       # bit 14
val DIRTY_LAYOUT: i64 = 32768                  # bit 15
val DIRTY_HIT_TEST: i64 = 262144               # bit 18
val DIRTY_RESOURCE: i64 = 1048576              # bit 20

struct DirtyMask:
    bits: i64

impl DirtyMask:
    static fn none() -> DirtyMask: DirtyMask(bits: DIRTY_NONE)
    static fn from_bits(bits: i64) -> DirtyMask: DirtyMask(bits: bits)
    fn contains(bits: i64) -> bool: (self.bits & bits) == bits
    fn merged(bits: i64) -> DirtyMask: DirtyMask(bits: self.bits | bits)

struct LayoutDependency:
    contract_version: i64
    producer_id: i64
    consumer_id: i64
    kind: text
    dirty_bits: i64
    invalidates: DirtyMask

fn layout_dependency(producer_id: i64, consumer_id: i64, kind: text, dirty_bits: i64) -> LayoutDependency:
    LayoutDependency(
        contract_version: STRUCTURAL_INVALIDATION_CONTRACT_VERSION,
        producer_id: producer_id,
        consumer_id: consumer_id,
        kind: kind,
        dirty_bits: dirty_bits,
        invalidates: DirtyMask.from_bits(dirty_bits)
    )

export STRUCTURAL_INVALIDATION_CONTRACT_VERSION
export DIRTY_NONE, DIRTY_INTRINSIC_MEASURE, DIRTY_LAYOUT, DIRTY_HIT_TEST, DIRTY_RESOURCE
export DirtyMask, LayoutDependency, layout_dependency
