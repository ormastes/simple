# ============================================================================
# common/structural/invalidation/invalidation_edge.spl — FROZEN dependency-edge
# contract v1
#
# Architecture: doc/04_architecture/compiler/mdsoc/
#   mdsoc_plus_tagged_structural_compute_architecture.md §9.3 (Dependency
#   edges), §9.4 (InvalidationPort), §26 (contract freeze), §27 (INVALIDATE lane
#   owns structural/invalidation).
#
# Freezes the second half of artifact group 6 of §26: "DirtyMask and dependency
# edge format". The DirtyMask half is in dirty_mask.spl.
#
# The batch storage form is DELIBERATELY NOT A NEW SCHEME. §9.3's dependency
# graph is a producer -> consumer adjacency, which is the same shape as §6.3's
# provenance adjacency, so this module reuses the MAP lane's compressed sparse
# row layout and — importantly — its actual invariant checker
# (`mapping_offsets_well_formed`) rather than writing a second copy that could
# drift. A CSR rule enforced by two functions is a CSR rule with two meanings.
#
# NAMING. §9.3 spells these records `DependencyEdge` / `DependencyKind`. Both
# bare names are ALREADY TAKEN in this tree by unrelated types:
#
#   src/compiler/40.mono/monomorphize/note_sdn.spl  DependencyKind
#       (TypeParam / FieldType / InnerType / MethodDep — monomorphization type
#       dependencies) and DependencyEdge (from_inst/to_inst text pair);
#   src/compiler/90.tools/size/dependency_audit.spl DependencyEdge
#       (from_crate/to_crate crate-graph edge).
#
# Same name, different meaning, and the interpreter resolves struct names
# through a global registry, so declaring a third `DependencyEdge` risks
# silently rebinding those call sites rather than colliding loudly. Frozen here
# as `InvalidationEdge` / `InvalidationEdgeKind` / `InvalidationEdgeBatch`,
# leaving the existing types untouched — the same resolution the EXEC lane used
# when §21's `ExecutionProfile` collided with an existing measured-cost record.
# The architecture's §9.3 field names are preserved exactly; only the type
# spellings differ. Raised for ratification.
#
# FROZEN: enum discriminants are wire values. A discriminant is never reused and
# never renumbered; new variants take the next free number.
# ============================================================================

use std.common.structural.identity.entity_id.{EntityRef, entity_ref, entity_ref_equal}
use std.common.structural.mapping.mapping_edge.{mapping_offsets_well_formed}
use std.common.structural.invalidation.dirty_mask.{DIRTY_MASK_EMPTY, dirty_mask_valid}

# ----------------------------------------------------------------------------
# InvalidationEdgeKind (§9.3) — DERIVED, not enumerated by the architecture.
#
# §9.3 declares `kind: InvalidationEdgeKind` and never lists a variant. Rather than
# invent a vocabulary, this freezes exactly the six edge classes §9.3's own
# "Examples:" list distinguishes, in the order it lists them. Each variant cites
# the bullet that requires it:
#
#   0 SymbolExport    "exported symbol -> dependent module semantic artifact"
#   1 CustomProperty  "CSS custom property -> computed declarations that
#                      reference it"
#   2 SelectorMatch   "DOM class value -> candidate selector set"
#   3 LayoutGeometry  "computed width -> containing block layout"
#   4 FontMetric      "font metric -> text fragments and parent intrinsic size"
#   5 LinkRelocation  "input symbol -> relocation and output range"
#
# The six are not interchangeable: §9.5 requires a private implementation change
# to preserve dependents' semantic artifacts while still invalidating code
# generation and final linking, which is only expressible if a SymbolExport edge
# and a LinkRelocation edge are separately identifiable.
#
# Raised back to the architecture owner for ratification — see the
# "Underspecified in §9" section of the contract document.
# ----------------------------------------------------------------------------

enum InvalidationEdgeKind:
    SymbolExport
    CustomProperty
    SelectorMatch
    LayoutGeometry
    FontMetric
    LinkRelocation

fn invalidation_edge_kind_to_u8(k: InvalidationEdgeKind) -> i64:
    match k:
        case InvalidationEdgeKind.SymbolExport: 0
        case InvalidationEdgeKind.CustomProperty: 1
        case InvalidationEdgeKind.SelectorMatch: 2
        case InvalidationEdgeKind.LayoutGeometry: 3
        case InvalidationEdgeKind.FontMetric: 4
        case InvalidationEdgeKind.LinkRelocation: 5

val INVALIDATION_EDGE_KIND_MAX: i64 = 5
val INVALIDATION_EDGE_KIND_COUNT: i64 = 6

fn invalidation_edge_kind_from_u8(v: i64) -> InvalidationEdgeKind:
    """Caller MUST gate on `invalidation_edge_kind_valid` first; this maps only known
    discriminants and pins anything else to SymbolExport so the function stays
    total (same rule as mapping_kind_from_u8)."""
    match v:
        case 1: InvalidationEdgeKind.CustomProperty
        case 2: InvalidationEdgeKind.SelectorMatch
        case 3: InvalidationEdgeKind.LayoutGeometry
        case 4: InvalidationEdgeKind.FontMetric
        case 5: InvalidationEdgeKind.LinkRelocation
        case _: InvalidationEdgeKind.SymbolExport

fn invalidation_edge_kind_valid(v: i64) -> bool:
    v >= 0 and v <= INVALIDATION_EDGE_KIND_MAX

fn invalidation_edge_kind_equal(a: InvalidationEdgeKind, b: InvalidationEdgeKind) -> bool:
    invalidation_edge_kind_to_u8(a) == invalidation_edge_kind_to_u8(b)

# ----------------------------------------------------------------------------
# InvalidationEdge (§9.3)
#
# Field order on the wire is the declaration order given in §9.3:
#   producer, consumer, kind, invalidates.
#
# `invalidates` is declared as a DirtyMask; it is carried on the wire as the
# frozen u32 bitset (dirty_mask.spl) rather than as the struct, because the
# struct's `bits: i64` is a host representation and i64 is not a wire width.
# ----------------------------------------------------------------------------

val INVALIDATION_EDGE_LEN: i64 = 21

struct InvalidationEdge:
    """One dependency edge (§9.3). 21 bytes on the wire, no padding.

    `producer` and `consumer` are snapshot-local EntityRefs, so an edge is only
    meaningful inside the batch's snapshot; a dependency that must survive a
    revision is re-derived against EntityKey (§4.2), never stored across
    revisions. `invalidates` is the raw u32 DirtyMask bitset: the set of stages
    that go dirty in the CONSUMER when the PRODUCER changes.
    """
    producer: EntityRef
    consumer: EntityRef
    kind: InvalidationEdgeKind
    invalidates: u32

fn invalidation_edge(producer: EntityRef, consumer: EntityRef,
                   kind: InvalidationEdgeKind, invalidates: u32) -> InvalidationEdge:
    InvalidationEdge(producer: producer, consumer: consumer, kind: kind,
                   invalidates: invalidates)

fn invalidation_edge_equal(a: InvalidationEdge, b: InvalidationEdge) -> bool:
    """Explicit field-wise equality, not engine struct equality, which differs
    between the interpreter and native codegen for nested structs."""
    entity_ref_equal(a.producer, b.producer)
        and entity_ref_equal(a.consumer, b.consumer)
        and invalidation_edge_kind_equal(a.kind, b.kind)
        and a.invalidates == b.invalidates

fn invalidation_edge_valid(e: InvalidationEdge) -> bool:
    """An edge whose `invalidates` sets a reserved DirtyMask bit is rejected.
    An edge that invalidates NOTHING is also rejected: §9.3 exists to propagate
    invalidation, and a zero-mask edge is a graph entry that can never fire, so
    recording one is a producer bug that would otherwise sit undetected in the
    graph forever."""
    if not dirty_mask_valid(e.invalidates):
        return false
    e.invalidates != DIRTY_MASK_EMPTY

fn invalidation_zero_edge() -> InvalidationEdge:
    invalidation_edge(entity_ref(0, 0), entity_ref(0, 0),
                    InvalidationEdgeKind.SymbolExport, 0)

# ----------------------------------------------------------------------------
# InvalidationEdgeBatch (§9.4 `record_dependencies(edges: DependencyEdgeBatch)`)
#
# §9.4 names the batch type and never defines it. Frozen as compressed sparse
# row over PRODUCERS, identical in shape and invariants to §6.3's MappingShard:
#
#   - `producer_offsets` has producer_count + 1 entries, is non-decreasing,
#     starts at 0 and ends at edge_count. Edges leaving producer n are
#     producer_offsets[n] .. producer_offsets[n+1].
#   - `consumer_edges` holds u32 INDICES into `edges`, not duplicated edges, so
#     the two directions cannot disagree.
#   - The consumer (reverse) index is optional. `derive` (§9.4) walks producer
#     -> consumer and needs only the forward direction; `explain` (§9.4) walks
#     consumer -> producer and is the caller that must demand the reverse index.
#     Presence is carried by an explicit u8 rather than by a padded flags word,
#     because the wire convention forbids padding.
# ----------------------------------------------------------------------------

struct InvalidationEdgeBatch:
    """A compressed sparse-adjacency dependency batch (§9.3/§9.4)."""
    version: u32
    producer_count: u32
    producer_offsets: [u32]
    edges: [InvalidationEdge]
    has_reverse: bool
    consumer_count: u32
    consumer_offsets: [u32]
    consumer_edges: [u32]

fn invalidation_edge_batch_forward(version: u32, producer_count: u32,
                            producer_offsets: [u32],
                            edges: [InvalidationEdge]) -> InvalidationEdgeBatch:
    """A forward-only batch — what `record_dependencies` receives from a stage
    that has not been asked to explain anything yet."""
    val no_off: [u32] = []
    val no_idx: [u32] = []
    InvalidationEdgeBatch(version: version, producer_count: producer_count,
                    producer_offsets: producer_offsets, edges: edges,
                    has_reverse: false, consumer_count: 0,
                    consumer_offsets: no_off, consumer_edges: no_idx)

fn invalidation_edge_batch(version: u32, producer_count: u32, producer_offsets: [u32],
                    edges: [InvalidationEdge], consumer_count: u32,
                    consumer_offsets: [u32],
                    consumer_edges: [u32]) -> InvalidationEdgeBatch:
    InvalidationEdgeBatch(version: version, producer_count: producer_count,
                    producer_offsets: producer_offsets, edges: edges,
                    has_reverse: true, consumer_count: consumer_count,
                    consumer_offsets: consumer_offsets,
                    consumer_edges: consumer_edges)

fn invalidation_edge_batch_valid(b: InvalidationEdgeBatch) -> bool:
    """Full structural validity. This is the CPU reference rule, applied
    identically on encode and decode so no lane can emit a batch another lane
    must reject."""
    if not mapping_offsets_well_formed(b.producer_offsets, b.producer_count,
                                       b.edges.len()):
        return false
    var i = 0
    while i < b.edges.len():
        if not invalidation_edge_valid(b.edges[i]):
            return false
        i = i + 1
    if not b.has_reverse:
        return b.consumer_offsets.len() == 0 and b.consumer_edges.len() == 0
    # The consumer index is a CSR over consumer_edges, so its terminal offset is
    # the consumer_edges length, not the forward edge count. Those two differ
    # whenever an edge points at a consumer outside the indexed range, which a
    # lazily built partial index legitimately does.
    if not mapping_offsets_well_formed(b.consumer_offsets, b.consumer_count,
                                       b.consumer_edges.len()):
        return false
    if b.consumer_edges.len() > b.edges.len():
        return false
    var j = 0
    while j < b.consumer_edges.len():
        if b.consumer_edges[j] >= b.edges.len():
            return false
        j = j + 1
    true

fn invalidation_edge_batch_equal(a: InvalidationEdgeBatch, b: InvalidationEdgeBatch) -> bool:
    if a.version != b.version or a.producer_count != b.producer_count:
        return false
    if a.has_reverse != b.has_reverse:
        return false
    if a.producer_offsets.len() != b.producer_offsets.len():
        return false
    var i = 0
    while i < a.producer_offsets.len():
        if a.producer_offsets[i] != b.producer_offsets[i]:
            return false
        i = i + 1
    if a.edges.len() != b.edges.len():
        return false
    var e = 0
    while e < a.edges.len():
        if not invalidation_edge_equal(a.edges[e], b.edges[e]):
            return false
        e = e + 1
    if a.consumer_count != b.consumer_count:
        return false
    if a.consumer_offsets.len() != b.consumer_offsets.len():
        return false
    var r = 0
    while r < a.consumer_offsets.len():
        if a.consumer_offsets[r] != b.consumer_offsets[r]:
            return false
        r = r + 1
    if a.consumer_edges.len() != b.consumer_edges.len():
        return false
    var x = 0
    while x < a.consumer_edges.len():
        if a.consumer_edges[x] != b.consumer_edges[x]:
            return false
        x = x + 1
    true

# ----------------------------------------------------------------------------
# Traversal and propagation — the CPU reference semantics that make DirtyMask
# and InvalidationEdge one contract rather than two independent records.
# ----------------------------------------------------------------------------

fn invalidation_forward_edges(b: InvalidationEdgeBatch, producer: i64,
                            kind_mask: i64) -> [InvalidationEdge]:
    """Edges leaving `producer` whose invalidation mask intersects `kind_mask`.

    An out-of-range producer yields the empty set rather than trapping: §4.1
    makes an EntityRef snapshot-local, so querying a node this batch does not
    cover is a normal miss, not an error.
    """
    var out: [InvalidationEdge] = []
    if producer < 0 or producer >= b.producer_count:
        return out
    var i = b.producer_offsets[producer]
    val end = b.producer_offsets[producer + 1]
    while i < end:
        if (b.edges[i].invalidates & kind_mask) != 0:
            out.push(b.edges[i])
        i = i + 1
    out

fn invalidation_reverse_edges(b: InvalidationEdgeBatch, consumer: i64,
                            kind_mask: i64) -> [InvalidationEdge]:
    """Edges arriving at `consumer` — the §9.4 `explain` direction. Returns
    empty when the consumer index has not been built; a caller that needs it
    must demand it."""
    var out: [InvalidationEdge] = []
    if not b.has_reverse:
        return out
    if consumer < 0 or consumer >= b.consumer_count:
        return out
    var i = b.consumer_offsets[consumer]
    val end = b.consumer_offsets[consumer + 1]
    while i < end:
        val idx = b.consumer_edges[i]
        if (b.edges[idx].invalidates & kind_mask) != 0:
            out.push(b.edges[idx])
        i = i + 1
    out

fn invalidation_build_reverse(b: InvalidationEdgeBatch,
                            consumer_count: u32) -> InvalidationEdgeBatch:
    """Build the consumer index on demand.

    Counting sort over `consumer.local_index`, which keeps the produced batch
    deterministic: two builders that see the same forward edges in the same
    order produce byte-identical reverse arrays, which is what lets the golden
    vectors freeze the format at all.
    """
    var counts: [u32] = []
    var i = 0
    while i <= consumer_count:
        counts.push(0)
        i = i + 1
    var e = 0
    while e < b.edges.len():
        val t = b.edges[e].consumer.local_index
        if t < consumer_count:
            counts[t + 1] = counts[t + 1] + 1
        e = e + 1
    var n = 1
    while n <= consumer_count:
        counts[n] = counts[n] + counts[n - 1]
        n = n + 1
    var cursor: [u32] = []
    var c = 0
    while c <= consumer_count:
        cursor.push(counts[c])
        c = c + 1
    # Sized from the prefix sum, not from edges.len(): an edge whose consumer
    # sits outside the indexed range is not indexed, so a partial index is
    # shorter than the forward edge list.
    val indexed = counts[consumer_count]
    var idx: [u32] = []
    var z = 0
    while z < indexed:
        idx.push(0)
        z = z + 1
    var k = 0
    while k < b.edges.len():
        val t2 = b.edges[k].consumer.local_index
        if t2 < consumer_count:
            idx[cursor[t2]] = k
            cursor[t2] = cursor[t2] + 1
        k = k + 1
    invalidation_edge_batch(b.version, b.producer_count, b.producer_offsets, b.edges,
                     consumer_count, counts, idx)

fn invalidation_propagate_once(b: InvalidationEdgeBatch, producer: i64,
                             producer_dirty: i64) -> [i64]:
    """One relaxation step of §9.4 `derive`: given the stages that went dirty in
    `producer`, return the DirtyMask each consumer acquires, indexed by
    `consumer.local_index`.

    The reference rule is that an edge fires only when the producer is dirty in
    a stage the edge cares about, and when it fires it contributes exactly its
    own `invalidates` mask. `invalidates` is therefore both the trigger set and
    the effect set, which is what §9.3 declaring one field rather than two
    means. Budgeted multi-hop propagation (§9.4 `propagate`) is scheduler
    behaviour and is NOT part of the frozen contract; this single step is, so
    that every backend agrees on what one hop does.

    The result is sized by `producer_count + 1`, not by the edge list, so a
    consumer with no fired edge reads DIRTY_MASK_EMPTY instead of being absent.
    """
    var acc: [i64] = []
    var i = 0
    while i <= b.producer_count:
        acc.push(DIRTY_MASK_EMPTY)
        i = i + 1
    if producer < 0 or producer >= b.producer_count:
        return acc
    var j = b.producer_offsets[producer]
    val end = b.producer_offsets[producer + 1]
    while j < end:
        val e = b.edges[j]
        if (e.invalidates & producer_dirty) != 0:
            val t = e.consumer.local_index
            if t >= 0 and t <= b.producer_count:
                acc[t] = acc[t] | e.invalidates
        j = j + 1
    acc

export InvalidationEdgeKind, InvalidationEdge, InvalidationEdgeBatch
export INVALIDATION_EDGE_KIND_MAX, INVALIDATION_EDGE_KIND_COUNT, INVALIDATION_EDGE_LEN
export invalidation_edge_kind_to_u8, invalidation_edge_kind_from_u8, invalidation_edge_kind_valid
export invalidation_edge_kind_equal
export invalidation_edge, invalidation_edge_equal, invalidation_edge_valid
export invalidation_zero_edge
export invalidation_edge_batch, invalidation_edge_batch_forward, invalidation_edge_batch_valid
export invalidation_edge_batch_equal
export invalidation_forward_edges, invalidation_reverse_edges
export invalidation_build_reverse, invalidation_propagate_once
