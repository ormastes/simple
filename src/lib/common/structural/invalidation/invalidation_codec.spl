# ============================================================================
# common/structural/invalidation/invalidation_codec.spl — CPU reference
# serializers for the frozen DirtyMask / dependency-edge contract v1
#
# CPU reference codec for architecture §9.1/§9.3/§9.4 (§26 deliverable). This is
# the oracle: any future vectorized or GPU-resident dependency-graph builder
# must produce byte-identical output.
#
# Layout (little-endian, no padding — see common/structural/wire.spl):
#
#   DirtyMask         envelope(8) | mask u32
#
#   InvalidationEdge    21  producer EntityRef 8 | consumer EntityRef 8
#                         | kind u8 1 | invalidates u32 4
#
#   InvalidationEdgeBatch   envelope(8) | version u32 | producer_count u32
#                     | edge_count u32 | has_reverse u8
#                     | producer_offsets u32 * (producer_count + 1)
#                     | edges InvalidationEdge * edge_count
#                     | [ consumer_count u32
#                     |   consumer_index_count u32
#                     |   consumer_offsets u32 * (consumer_count + 1)
#                     |   consumer_edges u32 * consumer_index_count ]
#
# The bracketed tail is present only when has_reverse == 1.
#
# HARD REJECTS, never a silent default:
#   - wrong magic, wrong version, non-zero envelope reserved;
#   - unknown InvalidationEdgeKind discriminant;
#   - a DirtyMask reserved bit (21..31) set;
#   - an edge whose invalidation mask is empty;
#   - has_reverse outside {0, 1};
#   - a CSR offset array that is not (len == n+1, starts 0, non-decreasing,
#     ends at the declared count);
#   - a consumer index entry pointing past the forward edge list;
#   - trailing bytes after the record.
#
# WIDTH DISCIPLINE. Every declared count read off the wire is a u32 that can be
# as large as 4294967295, and every span this decoder computes from one
# (`(count + 1) * 4`, `count * INVALIDATION_EDGE_LEN`) is evaluated in i64, never
# at 32-bit width. That is deliberate and load-bearing: computed at u32 width,
# `producer_count + 1` wraps to 0 for the maximum count and the span check then
# passes trivially, admitting a record whose arrays were never present. The
# spec pins this with a maximum-count-on-a-short-buffer case.
# ============================================================================

use std.common.structural.wire.{
    WIRE_ENVELOPE_LEN,
    wire_check_envelope,
    wire_get_u32,
    wire_get_u8,
    wire_has,
    wire_magic,
    wire_put_envelope,
    wire_put_u32,
    wire_put_u8
}
use std.common.structural.identity.entity_id.{ENTITY_REF_LEN}
use std.common.structural.identity.identity_codec.{entity_ref_put, entity_ref_read}
use std.common.structural.mapping.mapping_edge.{mapping_offsets_well_formed}
use std.common.structural.invalidation.contracts.{DirtyMask}
use std.common.structural.invalidation.dirty_mask.{
    INVALIDATION_SCHEMA_VERSION,
    dirty_mask_from_raw,
    dirty_mask_valid
}
use std.common.structural.invalidation.invalidation_edge.{
    INVALIDATION_EDGE_LEN,
    InvalidationEdgeBatch,
    InvalidationEdge,
    invalidation_edge_batch,
    invalidation_edge_batch_forward,
    invalidation_edge_batch_valid,
    invalidation_edge,
    invalidation_edge_valid,
    invalidation_edge_kind_from_u8,
    invalidation_edge_kind_to_u8,
    invalidation_edge_kind_valid,
    invalidation_zero_edge
}

fn invalidation_magic_dirty_mask() -> i64:
    wire_magic("SDMK")

fn invalidation_magic_edge() -> i64:
    wire_magic("SDEP")

fn invalidation_magic_batch() -> i64:
    wire_magic("SDBA")

# ----------------------------------------------------------------------------
# Result carriers — same shape as the ID-TAG and MAP lanes', so callers that
# already handle an EntityRefResult or a MappingEdgeResult handle these without
# a new idiom.
# ----------------------------------------------------------------------------

struct DirtyMaskResult:
    ok: bool
    value: DirtyMask

struct InvalidationEdgeResult:
    ok: bool
    value: InvalidationEdge

struct InvalidationEdgeBatchResult:
    ok: bool
    value: InvalidationEdgeBatch

fn invalidation_empty_batch() -> InvalidationEdgeBatch:
    val off: [u32] = []
    val edges: [InvalidationEdge] = []
    invalidation_edge_batch_forward(0, 0, off, edges)

# ----------------------------------------------------------------------------
# DirtyMask
# ----------------------------------------------------------------------------

fn encode_dirty_mask(m: DirtyMask) -> [u8]:
    """Framed standalone DirtyMask. An out-of-range mask encodes to an empty
    buffer rather than to bytes no decoder will accept — the invariant is
    enforced on encode as well as decode, so a producer cannot put a reserved
    bit on the wire and blame the reader."""
    var b: [u8] = []
    if not dirty_mask_valid(m.bits):
        return b
    b = wire_put_envelope(b, invalidation_magic_dirty_mask(),
                          INVALIDATION_SCHEMA_VERSION)
    wire_put_u32(b, m.bits)

fn decode_dirty_mask(data: [u8]) -> DirtyMaskResult:
    """A reserved bit in the mask is a hard reject. Silently masking it off
    would report success while dropping an invalidation this reader does not
    understand, which is the one failure mode an invalidation framework must not
    have: the dropped stage is then never recomputed and the stale artifact is
    served as fresh."""
    if not wire_check_envelope(data, 0, invalidation_magic_dirty_mask(),
                               INVALIDATION_SCHEMA_VERSION):
        return DirtyMaskResult(ok: false, value: dirty_mask_from_raw(0))
    if data.len() != WIRE_ENVELOPE_LEN + 4:
        return DirtyMaskResult(ok: false, value: dirty_mask_from_raw(0))
    val raw = wire_get_u32(data, WIRE_ENVELOPE_LEN)
    if not dirty_mask_valid(raw):
        return DirtyMaskResult(ok: false, value: dirty_mask_from_raw(0))
    DirtyMaskResult(ok: true, value: dirty_mask_from_raw(raw))

# ----------------------------------------------------------------------------
# InvalidationEdge
# ----------------------------------------------------------------------------

fn invalidation_edge_put(out: [u8], e: InvalidationEdge) -> [u8]:
    var b = entity_ref_put(out, e.producer)
    b = entity_ref_put(b, e.consumer)
    b = wire_put_u8(b, invalidation_edge_kind_to_u8(e.kind))
    wire_put_u32(b, e.invalidates)

fn invalidation_edge_read(data: [u8], off: i64) -> InvalidationEdgeResult:
    """Read one InvalidationEdge. The kind discriminant and the invalidation mask
    are both validated; either failure fails the whole read."""
    if not wire_has(data, off, INVALIDATION_EDGE_LEN):
        return InvalidationEdgeResult(ok: false, value: invalidation_zero_edge())
    val kind_off = off + ENTITY_REF_LEN + ENTITY_REF_LEN
    val raw_kind = wire_get_u8(data, kind_off)
    if not invalidation_edge_kind_valid(raw_kind):
        return InvalidationEdgeResult(ok: false, value: invalidation_zero_edge())
    val mask = wire_get_u32(data, kind_off + 1)
    val e = invalidation_edge(entity_ref_read(data, off),
                            entity_ref_read(data, off + ENTITY_REF_LEN),
                            invalidation_edge_kind_from_u8(raw_kind),
                            mask)
    if not invalidation_edge_valid(e):
        return InvalidationEdgeResult(ok: false, value: invalidation_zero_edge())
    InvalidationEdgeResult(ok: true, value: e)

fn encode_invalidation_edge(e: InvalidationEdge) -> [u8]:
    """Framed standalone InvalidationEdge, for storage outside a packed batch."""
    var b: [u8] = []
    if not invalidation_edge_valid(e):
        return b
    b = wire_put_envelope(b, invalidation_magic_edge(),
                          INVALIDATION_SCHEMA_VERSION)
    invalidation_edge_put(b, e)

fn decode_invalidation_edge(data: [u8]) -> InvalidationEdgeResult:
    if not wire_check_envelope(data, 0, invalidation_magic_edge(),
                               INVALIDATION_SCHEMA_VERSION):
        return InvalidationEdgeResult(ok: false, value: invalidation_zero_edge())
    if data.len() != WIRE_ENVELOPE_LEN + INVALIDATION_EDGE_LEN:
        return InvalidationEdgeResult(ok: false, value: invalidation_zero_edge())
    invalidation_edge_read(data, WIRE_ENVELOPE_LEN)

# ----------------------------------------------------------------------------
# InvalidationEdgeBatch
# ----------------------------------------------------------------------------

fn invalidation_put_u32_array(out: [u8], xs: [u32]) -> [u8]:
    """Raw u32 run, no length prefix: every offset array's length is already
    implied by its node count, so a second count would be a field two lanes
    could disagree about."""
    var b = out
    var i = 0
    while i < xs.len():
        b = wire_put_u32(b, xs[i])
        i = i + 1
    b

fn encode_invalidation_edge_batch(b0: InvalidationEdgeBatch) -> [u8]:
    """Serialize a batch. An ill-formed batch encodes to an empty buffer rather
    than to bytes no decoder will accept — a producer must not be able to put a
    corrupt CSR on the wire."""
    var b: [u8] = []
    if not invalidation_edge_batch_valid(b0):
        return b
    b = wire_put_envelope(b, invalidation_magic_batch(),
                          INVALIDATION_SCHEMA_VERSION)
    b = wire_put_u32(b, b0.version)
    b = wire_put_u32(b, b0.producer_count)
    b = wire_put_u32(b, b0.edges.len())
    var flag = 0
    if b0.has_reverse:
        flag = 1
    b = wire_put_u8(b, flag)
    b = invalidation_put_u32_array(b, b0.producer_offsets)
    var i = 0
    while i < b0.edges.len():
        b = invalidation_edge_put(b, b0.edges[i])
        i = i + 1
    if not b0.has_reverse:
        return b
    b = wire_put_u32(b, b0.consumer_count)
    b = wire_put_u32(b, b0.consumer_edges.len())
    b = invalidation_put_u32_array(b, b0.consumer_offsets)
    invalidation_put_u32_array(b, b0.consumer_edges)

fn invalidation_read_u32_array(data: [u8], off: i64, count: i64) -> [u32]:
    var xs: [u32] = []
    var i = 0
    while i < count:
        xs.push(wire_get_u32(data, off + i * 4))
        i = i + 1
    xs

fn invalidation_edge_batch_reject() -> InvalidationEdgeBatchResult:
    InvalidationEdgeBatchResult(ok: false, value: invalidation_empty_batch())

fn decode_invalidation_edge_batch(data: [u8]) -> InvalidationEdgeBatchResult:
    if not wire_check_envelope(data, 0, invalidation_magic_batch(),
                               INVALIDATION_SCHEMA_VERSION):
        return invalidation_edge_batch_reject()
    if not wire_has(data, WIRE_ENVELOPE_LEN, 13):
        return invalidation_edge_batch_reject()
    val version = wire_get_u32(data, WIRE_ENVELOPE_LEN)
    # Widened into i64 bindings on the way out of the wire. `wire_get_u32`
    # already returns i64, and every span below is computed from these i64
    # bindings, so `producer_count + 1` cannot wrap to 0 at the maximum u32.
    val producer_count: i64 = wire_get_u32(data, WIRE_ENVELOPE_LEN + 4)
    val edge_count: i64 = wire_get_u32(data, WIRE_ENVELOPE_LEN + 8)
    val raw_rev = wire_get_u8(data, WIRE_ENVELOPE_LEN + 12)
    # {0, 1} only. Any other byte means a producer this reader does not
    # understand wrote the field; guessing would fabricate a dependency graph.
    if raw_rev > 1:
        return invalidation_edge_batch_reject()
    var off = WIRE_ENVELOPE_LEN + 13

    # Bound the two variable runs BEFORE allocating for the declared counts.
    if not wire_has(data, off, (producer_count + 1) * 4):
        return invalidation_edge_batch_reject()
    val producer_offsets = invalidation_read_u32_array(data, off,
                                                       producer_count + 1)
    off = off + (producer_count + 1) * 4
    if not mapping_offsets_well_formed(producer_offsets, producer_count,
                                       edge_count):
        return invalidation_edge_batch_reject()

    if not wire_has(data, off, edge_count * INVALIDATION_EDGE_LEN):
        return invalidation_edge_batch_reject()
    var edges: [InvalidationEdge] = []
    var i = 0
    while i < edge_count:
        val er = invalidation_edge_read(data, off)
        if not er.ok:
            return invalidation_edge_batch_reject()
        edges.push(er.value)
        off = off + INVALIDATION_EDGE_LEN
        i = i + 1

    if raw_rev == 0:
        if data.len() != off:
            return invalidation_edge_batch_reject()
        return InvalidationEdgeBatchResult(
            ok: true,
            value: invalidation_edge_batch_forward(version, producer_count,
                                            producer_offsets, edges))

    if not wire_has(data, off, 8):
        return invalidation_edge_batch_reject()
    val consumer_count: i64 = wire_get_u32(data, off)
    val index_count: i64 = wire_get_u32(data, off + 4)
    off = off + 8
    if not wire_has(data, off, (consumer_count + 1) * 4):
        return invalidation_edge_batch_reject()
    val consumer_offsets = invalidation_read_u32_array(data, off,
                                                       consumer_count + 1)
    off = off + (consumer_count + 1) * 4
    if not mapping_offsets_well_formed(consumer_offsets, consumer_count,
                                       index_count):
        return invalidation_edge_batch_reject()
    if not wire_has(data, off, index_count * 4):
        return invalidation_edge_batch_reject()
    val consumer_edges = invalidation_read_u32_array(data, off, index_count)
    off = off + index_count * 4
    if data.len() != off:
        return invalidation_edge_batch_reject()
    val out = invalidation_edge_batch(version, producer_count, producer_offsets, edges,
                               consumer_count, consumer_offsets, consumer_edges)
    # Re-run the full structural rule so decode accepts exactly the set encode
    # emits; this is what catches a consumer index pointing past the edge list.
    if not invalidation_edge_batch_valid(out):
        return invalidation_edge_batch_reject()
    InvalidationEdgeBatchResult(ok: true, value: out)

export DirtyMaskResult, InvalidationEdgeResult, InvalidationEdgeBatchResult
export invalidation_magic_dirty_mask, invalidation_magic_edge
export invalidation_magic_batch, invalidation_empty_batch
export encode_dirty_mask, decode_dirty_mask
export invalidation_edge_put, invalidation_edge_read
export encode_invalidation_edge, decode_invalidation_edge
export encode_invalidation_edge_batch, decode_invalidation_edge_batch
