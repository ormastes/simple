# ============================================================================
# common/structural/profile/profile_types.spl — FROZEN profile-descriptor
# contract v1 (§26 group 11: "ResolveProfile and SpatialLayoutProfile
# contracts").
#
# Architecture §17.3 (SpatialLayoutProfile interface + the eight initial
# layout profiles), §18.1/§18.2 (ResolveProfile interface, the core primitive
# list, and the three initial resolve profiles), §26 (contract freeze),
# Appendix A (port-to-implementor table). Contract document:
# doc/05_design/platform/structural_compute/profile_contract_v1.md
#
# WHAT THIS FREEZES, AND WHAT IT DELIBERATELY DOES NOT
#
# The *behavioural* traits already exist and are owned by other lanes:
#   - `ResolveProfile`        src/lib/common/structural/resolve/resolve_types.spl (LINK)
#   - `SpatialLayoutProfile`  src/lib/common/structural/layout/profile.spl        (LAYOUT)
# Those files are NOT edited here (§27 exclusive ownership + shared-file rule).
# A trait is not a contract artifact: it has no bytes, so it cannot be
# versioned, shipped across a language boundary, or golden-tested.
#
# What §26 asks for and what was missing is the language-neutral *descriptor*:
# the record a producer emits to declare which profile it is, which of the
# frozen interface steps it actually implements, which core primitives it
# consumes, and which execution properties the planner may rely on. That is
# `ResolveProfileDescriptor` and `SpatialLayoutProfileDescriptor` below.
#
# FROZEN: these record shapes, field widths, and enum/bit discriminants are
# contract v1. Any change is a schema-version bump plus new golden vectors,
# never an edit.
#
# Identity types (Hash128) are reused from the frozen ID-TAG contract — this
# lane mints no parallel identity model.
# ============================================================================

use std.common.structural.identity.entity_id.{Hash128, hash128, hash128_equal}

# Schema version for every record in this module.
val PROFILE_SCHEMA_VERSION: i64 = 1

# Widest unsigned value a u32 wire field can hold. Held as i64 on purpose: any
# sum of two u32 fields MUST be compared at 64-bit width, because `a + b` on
# two u32s wraps and a wrapped total then passes as well-formed.
val PROFILE_U32_MAX: i64 = 4294967295

# ----------------------------------------------------------------------------
# ResolveProfileKind — §18.2 names exactly three initial profiles. The
# vocabulary is closed: an unknown discriminant is a hard reject, never a
# "some other profile" fallback, because a consumer that cannot name the
# profile cannot know its resolution semantics (§18.2: "Profiles share
# GraphResolveCore primitives, never semantics").
# ----------------------------------------------------------------------------

enum ResolveProfileKind:
    SmfLink
    ClangOffloadLink
    WebResourceLink

fn resolve_profile_kind_to_u8(k: ResolveProfileKind) -> i64:
    match k:
        case ResolveProfileKind.SmfLink: 0
        case ResolveProfileKind.ClangOffloadLink: 1
        case ResolveProfileKind.WebResourceLink: 2

val RESOLVE_PROFILE_KIND_MAX: i64 = 2
val RESOLVE_PROFILE_KIND_COUNT: i64 = 3

fn resolve_profile_kind_from_u8(v: i64) -> ResolveProfileKind:
    """Caller MUST gate on `resolve_profile_kind_valid` first; unknown
    discriminants pin to SmfLink so the function stays total."""
    match v:
        case 1: ResolveProfileKind.ClangOffloadLink
        case 2: ResolveProfileKind.WebResourceLink
        case _: ResolveProfileKind.SmfLink

fn resolve_profile_kind_valid(v: i64) -> bool:
    v >= 0 and v <= RESOLVE_PROFILE_KIND_MAX

fn resolve_profile_kind_name(v: i64) -> text:
    """Frozen stable spelling, for SDN mirrors and cross-language bridges."""
    match v:
        case 0: "smf_link"
        case 1: "clang_offload_link"
        case 2: "web_resource_link"
        case _: ""

# ----------------------------------------------------------------------------
# Resolve step mask — one bit per method of the frozen six-step ResolveProfile
# interface (§18.1), in declaration order.
# ----------------------------------------------------------------------------

val RESOLVE_STEP_COLLECT: i64 = 1
val RESOLVE_STEP_GROUP_KEY: i64 = 2
val RESOLVE_STEP_RESOLVE_GROUP: i64 = 4
val RESOLVE_STEP_DERIVE_CONSTRAINTS: i64 = 8
val RESOLVE_STEP_PLAN_PLACEMENT: i64 = 16
val RESOLVE_STEP_EMIT: i64 = 32

val RESOLVE_STEP_ALL: i64 = 63

# Bits 6 and 7 are reserved and MUST be zero — the interface has six methods.
val RESOLVE_STEP_RESERVED: i64 = 192

# Steps without which a descriptor does not describe a resolve profile at all:
# collect/group_key/resolve_group produce the resolution, and emit is the only
# externally observable output (§18.1 `emit -> MutationPlanRef`).
# derive_constraints and plan_placement are genuinely optional: §18.2's
# WebResourceLinkProfile has no address space to place into.
val RESOLVE_STEP_MANDATORY: i64 = 39

# ----------------------------------------------------------------------------
# Resolve core mask — one bit per entry of the §18.1 "The core provides:" list,
# in listed order. A descriptor declares which core primitives it consumes so
# the planner can size shared arenas without running the profile.
# ----------------------------------------------------------------------------

val RESOLVE_CORE_HASH_INTERN: i64 = 1
val RESOLVE_CORE_STABLE_SORT_GROUP: i64 = 2
val RESOLVE_CORE_GROUP_REDUCTION: i64 = 4
val RESOLVE_CORE_REACHABILITY_FRONTIER: i64 = 8
val RESOLVE_CORE_CONSTRAINT_PROPAGATION: i64 = 16
val RESOLVE_CORE_SCAN_PLACEMENT: i64 = 32
val RESOLVE_CORE_PATCH_EMISSION: i64 = 64
val RESOLVE_CORE_RECEIPTS_DIAGNOSTICS: i64 = 128

val RESOLVE_CORE_ALL: i64 = 255

# The mask is a u16 on the wire; bits 8..15 are reserved and MUST be zero.
val RESOLVE_CORE_RESERVED: i64 = 65280

# Hash/intern, stable sort/group and deterministic group reduction are what
# "resolve" means; receipts are unconditional because §30 verification reads
# them for every stage.
val RESOLVE_CORE_MANDATORY: i64 = 135

# ----------------------------------------------------------------------------
# ResolveProfileDescriptor — 32 bytes on the wire.
#
#   off  size  field
#     0    16  profile_id      Hash128   interned profile-name identity
#    16     1  kind            u8        ResolveProfileKind
#    17     1  step_mask       u8        RESOLVE_STEP_*
#    18     2  core_mask       u16       RESOLVE_CORE_*
#    20     4  space_count     u32       distinct ResolveKey.space values used
#    24     4  stage_count     u32       pipeline stages the profile reports
#    28     4  reserved        u32       == 0
# ----------------------------------------------------------------------------

struct ResolveProfileDescriptor:
    """Language-neutral declaration of one ResolveProfile (§18). 32 bytes.

    `space_count` is how many distinct `ResolveKey.space` namespaces the
    profile mints; it is at least 1 because a profile with no namespace can
    never form a ResolveKey. `stage_count` is how many pipeline stages the
    profile reports StageReceipts for (SmfLinkProfile reports 13, L0..L12).
    """
    profile_id: Hash128
    kind: u32
    step_mask: u32
    core_mask: u32
    space_count: u32
    stage_count: u32

val RESOLVE_PROFILE_DESCRIPTOR_LEN: i64 = 32

fn resolve_profile_descriptor(
    profile_id: Hash128,
    kind: u32,
    step_mask: u32,
    core_mask: u32,
    space_count: u32,
    stage_count: u32
) -> ResolveProfileDescriptor:
    ResolveProfileDescriptor(
        profile_id: profile_id,
        kind: kind,
        step_mask: step_mask,
        core_mask: core_mask,
        space_count: space_count,
        stage_count: stage_count)

fn resolve_profile_descriptor_equal(a: ResolveProfileDescriptor, b: ResolveProfileDescriptor) -> bool:
    (hash128_equal(a.profile_id, b.profile_id)
        and a.kind == b.kind and a.step_mask == b.step_mask
        and a.core_mask == b.core_mask and a.space_count == b.space_count
        and a.stage_count == b.stage_count)

fn resolve_profile_zero_descriptor() -> ResolveProfileDescriptor:
    resolve_profile_descriptor(hash128(0, 0), 0, 0, 0, 0, 0)

# ----------------------------------------------------------------------------
# ResolveProfileDescriptor invariants. Enforced on ENCODE as well as decode:
# an ill-formed descriptor must never reach the wire, or the reject only fires
# on the far side of a network/file boundary where the producer is gone.
# ----------------------------------------------------------------------------

fn resolve_step_mask_valid(m: i64) -> bool:
    """No reserved bit set, and every mandatory step present."""
    (m & RESOLVE_STEP_RESERVED) == 0 and (m & RESOLVE_STEP_MANDATORY) == RESOLVE_STEP_MANDATORY

fn resolve_core_mask_valid(m: i64) -> bool:
    (m & RESOLVE_CORE_RESERVED) == 0 and (m & RESOLVE_CORE_MANDATORY) == RESOLVE_CORE_MANDATORY

fn resolve_profile_steps_agree_with_core(step_mask: i64, core_mask: i64) -> bool:
    """A declared step and the core primitive it is defined in terms of must
    agree; a descriptor claiming `derive_constraints` without constraint
    propagation, or `plan_placement` without scan placement, is describing a
    profile the core cannot run (§18.1)."""
    val dc = (step_mask & RESOLVE_STEP_DERIVE_CONSTRAINTS) != 0
    val cp = (core_mask & RESOLVE_CORE_CONSTRAINT_PROPAGATION) != 0
    if dc != cp:
        return false
    val pp = (step_mask & RESOLVE_STEP_PLAN_PLACEMENT) != 0
    val sp = (core_mask & RESOLVE_CORE_SCAN_PLACEMENT) != 0
    if pp != sp:
        return false
    # `emit` lowers to patch emission unconditionally.
    (core_mask & RESOLVE_CORE_PATCH_EMISSION) != 0

fn resolve_profile_counts_valid(space_count: i64, stage_count: i64) -> bool:
    """Both counts are u32 wire fields, and their total must fit a u32.

    THE SUM IS NEVER FORMED. Declaring the parameters `i64` does NOT widen a
    value that arrived from a `u32` struct field: measured in this tree, a
    helper `fn sum_probe(a: i64, b: i64) -> i64: val total: i64 = a + b`
    returns 4294967296 for `sum_probe(4294967295, 1)` but 0 for
    `sum_probe(d.space_count, d.stage_count)` holding the same values — the
    field's 32-bit width survives the parameter declaration and the addition
    wraps to zero, so a wrapped total passes as well-formed. The usual advice
    ("widen into i64 before comparing") is therefore not sufficient here.

    The check is instead written subtractively. `PROFILE_U32_MAX -
    space_count` cannot wrap at any width, because `space_count` has already
    been bounded to [1, PROFILE_U32_MAX] above.
    """
    if space_count < 1 or stage_count < 1:
        return false
    if space_count > PROFILE_U32_MAX or stage_count > PROFILE_U32_MAX:
        return false
    val headroom = PROFILE_U32_MAX - space_count
    stage_count <= headroom

fn resolve_profile_descriptor_valid(d: ResolveProfileDescriptor) -> bool:
    if not resolve_profile_kind_valid(d.kind):
        return false
    if not resolve_step_mask_valid(d.step_mask):
        return false
    if not resolve_core_mask_valid(d.core_mask):
        return false
    if not resolve_profile_steps_agree_with_core(d.step_mask, d.core_mask):
        return false
    resolve_profile_counts_valid(d.space_count, d.stage_count)

# ----------------------------------------------------------------------------
# SpatialLayoutProfileKind — §17.3 lists exactly eight initial profiles. The
# spelling vocabulary matches the LAYOUT lane's `LAYOUT_PROFILE_*` text
# constants byte for byte; the spec asserts that agreement so the two can
# never drift into two vocabularies for one concept.
#
# NOTE (reported for ratification): Appendix A's implementor line for
# `SpatialLayoutProfile` reads "block, inline, flex, grid, table, positioned,
# scroll" — seven, dropping `replaced` and spelling `absolute/sticky` as
# `positioned`. §17.3 is the normative list and has eight. This contract
# freezes §17.3's eight; Appendix A is treated as prose shorthand.
# ----------------------------------------------------------------------------

enum SpatialLayoutProfileKind:
    Block
    Inline
    Flex
    Grid
    Table
    AbsoluteSticky
    Scroll
    Replaced

fn layout_profile_kind_to_u8(k: SpatialLayoutProfileKind) -> i64:
    match k:
        case SpatialLayoutProfileKind.Block: 0
        case SpatialLayoutProfileKind.Inline: 1
        case SpatialLayoutProfileKind.Flex: 2
        case SpatialLayoutProfileKind.Grid: 3
        case SpatialLayoutProfileKind.Table: 4
        case SpatialLayoutProfileKind.AbsoluteSticky: 5
        case SpatialLayoutProfileKind.Scroll: 6
        case SpatialLayoutProfileKind.Replaced: 7

val LAYOUT_PROFILE_KIND_MAX: i64 = 7
val LAYOUT_PROFILE_KIND_COUNT: i64 = 8

fn layout_profile_kind_from_u8(v: i64) -> SpatialLayoutProfileKind:
    """Caller MUST gate on `layout_profile_kind_valid` first; unknown
    discriminants pin to Block so the function stays total."""
    match v:
        case 1: SpatialLayoutProfileKind.Inline
        case 2: SpatialLayoutProfileKind.Flex
        case 3: SpatialLayoutProfileKind.Grid
        case 4: SpatialLayoutProfileKind.Table
        case 5: SpatialLayoutProfileKind.AbsoluteSticky
        case 6: SpatialLayoutProfileKind.Scroll
        case 7: SpatialLayoutProfileKind.Replaced
        case _: SpatialLayoutProfileKind.Block

fn layout_profile_kind_valid(v: i64) -> bool:
    v >= 0 and v <= LAYOUT_PROFILE_KIND_MAX

fn layout_profile_kind_name(v: i64) -> text:
    """Frozen spelling — identical to the LAYOUT lane's LAYOUT_PROFILE_* text
    constants, asserted equal in profile_contract_spec.spl."""
    match v:
        case 0: "block"
        case 1: "inline"
        case 2: "flex"
        case 3: "grid"
        case 4: "table"
        case 5: "absolute-sticky"
        case 6: "scroll"
        case 7: "replaced"
        case _: ""

fn layout_profile_kind_gpu_eligible(v: i64) -> bool:
    """Frozen per-kind GPU eligibility (§17.3 + §29 Wave 8: "block/flex/grid
    GPU batches", "CPU fallback for text/irregular contexts"). Identical to
    the LAYOUT lane's `layout_profile_gpu_eligible`, asserted equal in the
    spec. Inline is excluded because line breaking and text shaping are
    sequential within a paragraph (§17.2); table and replaced are excluded as
    irregular contexts."""
    v == 0 or v == 2 or v == 3 or v == 5 or v == 6

# ----------------------------------------------------------------------------
# Layout step mask — one bit per behavioural method of the frozen
# SpatialLayoutProfile interface (§17.3), in declaration order. `profile_id`
# is not a step: it is the descriptor's own identity field.
# ----------------------------------------------------------------------------

val LAYOUT_STEP_DISCOVER: i64 = 1
val LAYOUT_STEP_ESTIMATE: i64 = 2
val LAYOUT_STEP_MEASURE: i64 = 4
val LAYOUT_STEP_ARRANGE: i64 = 8
val LAYOUT_STEP_VERIFY: i64 = 16

val LAYOUT_STEP_ALL: i64 = 31

# Bits 5..7 reserved, MUST be zero.
val LAYOUT_STEP_RESERVED: i64 = 224

# discover/estimate/arrange are what makes a layout profile; `measure` runs
# only for profiles that shape text, and `verify` only where an oracle
# snapshot exists (§17.3 takes `oracle: LayoutSnapshotRef?`).
val LAYOUT_STEP_MANDATORY: i64 = 11

# ----------------------------------------------------------------------------
# Layout flags (u16). Execution properties the scheduler may rely on without
# invoking the profile.
# ----------------------------------------------------------------------------

val LAYOUT_FLAG_GPU_ELIGIBLE: i64 = 1
val LAYOUT_FLAG_TEXT_MEASURE_REQUIRED: i64 = 2
val LAYOUT_FLAG_SEQUENTIAL_WITHIN_ISLAND: i64 = 4

val LAYOUT_FLAG_ALL: i64 = 7
val LAYOUT_FLAG_RESERVED: i64 = 65528

# ----------------------------------------------------------------------------
# GPU admission mask (u32) — the frozen nine-bit exclusion vocabulary already
# in use by the LAYOUT lane as LAYOUT_GPU_ADMISSION_* (values 1..256). Bits
# 9..31 are reserved and MUST be zero.
# ----------------------------------------------------------------------------

val LAYOUT_ADMISSION_ALL: i64 = 511
val LAYOUT_ADMISSION_RESERVED: i64 = 4294966784

# ----------------------------------------------------------------------------
# SpatialLayoutProfileDescriptor — 24 bytes on the wire.
#
#   off  size  field
#     0    16  profile_id      Hash128   interned profile-name identity
#    16     1  kind            u8        SpatialLayoutProfileKind
#    17     1  step_mask       u8        LAYOUT_STEP_*
#    18     2  flags           u16       LAYOUT_FLAG_*
#    20     4  admission_mask  u32       LAYOUT_GPU_ADMISSION_* exclusions
#
# There is no trailing reserved field: `flags` and `admission_mask` both carry
# their own reserved bits, which are hard-rejected when nonzero, so a spare
# word would add four bytes of nothing to every island descriptor.
# ----------------------------------------------------------------------------

struct SpatialLayoutProfileDescriptor:
    """Language-neutral declaration of one SpatialLayoutProfile (§17.3). 24
    bytes."""
    profile_id: Hash128
    kind: u32
    step_mask: u32
    flags: u32
    admission_mask: u32

val LAYOUT_PROFILE_DESCRIPTOR_LEN: i64 = 24

fn layout_profile_descriptor(
    profile_id: Hash128,
    kind: u32,
    step_mask: u32,
    flags: u32,
    admission_mask: u32
) -> SpatialLayoutProfileDescriptor:
    SpatialLayoutProfileDescriptor(
        profile_id: profile_id,
        kind: kind,
        step_mask: step_mask,
        flags: flags,
        admission_mask: admission_mask)

fn layout_profile_descriptor_equal(
    a: SpatialLayoutProfileDescriptor, b: SpatialLayoutProfileDescriptor) -> bool:
    (hash128_equal(a.profile_id, b.profile_id)
        and a.kind == b.kind and a.step_mask == b.step_mask
        and a.flags == b.flags and a.admission_mask == b.admission_mask)

fn layout_profile_zero_descriptor() -> SpatialLayoutProfileDescriptor:
    layout_profile_descriptor(hash128(0, 0), 0, 0, 0, 0)

# ----------------------------------------------------------------------------
# SpatialLayoutProfileDescriptor invariants — enforced on encode and decode.
# ----------------------------------------------------------------------------

fn layout_step_mask_valid(m: i64) -> bool:
    (m & LAYOUT_STEP_RESERVED) == 0 and (m & LAYOUT_STEP_MANDATORY) == LAYOUT_STEP_MANDATORY

fn layout_flags_valid(f: i64) -> bool:
    (f & LAYOUT_FLAG_RESERVED) == 0

fn layout_admission_mask_valid(m: i64) -> bool:
    m >= 0 and (m & LAYOUT_ADMISSION_RESERVED) == 0

fn layout_profile_flags_agree(kind: i64, step_mask: i64, flags: i64, admission_mask: i64) -> bool:
    """Cross-field consistency:

    1. `text_measure_required` iff the `measure` step is declared — the flag
       exists so the scheduler can skip the text port, and a flag that
       disagrees with the step set makes that skip unsound.
    2. `gpu_eligible` must equal the frozen per-kind eligibility. Eligibility
       is a property of the formatting context, not of an individual
       descriptor, so a descriptor cannot opt an inline profile into GPU.
    3. `gpu_eligible` excludes `sequential_within_island` — a batch that must
       run in order within its island is exactly what §17.2 keeps on the CPU.
    4. A non-GPU-eligible profile declares no GPU admission exclusions: it has
       no admission decision to filter.
    """
    val measure = (step_mask & LAYOUT_STEP_MEASURE) != 0
    val text_required = (flags & LAYOUT_FLAG_TEXT_MEASURE_REQUIRED) != 0
    if measure != text_required:
        return false
    val gpu = (flags & LAYOUT_FLAG_GPU_ELIGIBLE) != 0
    if gpu != layout_profile_kind_gpu_eligible(kind):
        return false
    if gpu and (flags & LAYOUT_FLAG_SEQUENTIAL_WITHIN_ISLAND) != 0:
        return false
    if not gpu and admission_mask != 0:
        return false
    true

fn layout_profile_descriptor_valid(d: SpatialLayoutProfileDescriptor) -> bool:
    if not layout_profile_kind_valid(d.kind):
        return false
    if not layout_step_mask_valid(d.step_mask):
        return false
    if not layout_flags_valid(d.flags):
        return false
    if not layout_admission_mask_valid(d.admission_mask):
        return false
    layout_profile_flags_agree(d.kind, d.step_mask, d.flags, d.admission_mask)

export PROFILE_SCHEMA_VERSION, PROFILE_U32_MAX
export ResolveProfileKind, ResolveProfileDescriptor
export RESOLVE_PROFILE_KIND_MAX, RESOLVE_PROFILE_KIND_COUNT
export RESOLVE_PROFILE_DESCRIPTOR_LEN
export RESOLVE_STEP_COLLECT, RESOLVE_STEP_GROUP_KEY, RESOLVE_STEP_RESOLVE_GROUP
export RESOLVE_STEP_DERIVE_CONSTRAINTS, RESOLVE_STEP_PLAN_PLACEMENT, RESOLVE_STEP_EMIT
export RESOLVE_STEP_ALL, RESOLVE_STEP_RESERVED, RESOLVE_STEP_MANDATORY
export RESOLVE_CORE_HASH_INTERN, RESOLVE_CORE_STABLE_SORT_GROUP
export RESOLVE_CORE_GROUP_REDUCTION, RESOLVE_CORE_REACHABILITY_FRONTIER
export RESOLVE_CORE_CONSTRAINT_PROPAGATION, RESOLVE_CORE_SCAN_PLACEMENT
export RESOLVE_CORE_PATCH_EMISSION, RESOLVE_CORE_RECEIPTS_DIAGNOSTICS
export RESOLVE_CORE_ALL, RESOLVE_CORE_RESERVED, RESOLVE_CORE_MANDATORY
export resolve_profile_kind_to_u8, resolve_profile_kind_from_u8
export resolve_profile_kind_valid, resolve_profile_kind_name
export resolve_profile_descriptor, resolve_profile_descriptor_equal
export resolve_profile_zero_descriptor, resolve_profile_descriptor_valid
export resolve_step_mask_valid, resolve_core_mask_valid
export resolve_profile_steps_agree_with_core, resolve_profile_counts_valid
export SpatialLayoutProfileKind, SpatialLayoutProfileDescriptor
export LAYOUT_PROFILE_KIND_MAX, LAYOUT_PROFILE_KIND_COUNT
export LAYOUT_PROFILE_DESCRIPTOR_LEN
export LAYOUT_STEP_DISCOVER, LAYOUT_STEP_ESTIMATE, LAYOUT_STEP_MEASURE
export LAYOUT_STEP_ARRANGE, LAYOUT_STEP_VERIFY
export LAYOUT_STEP_ALL, LAYOUT_STEP_RESERVED, LAYOUT_STEP_MANDATORY
export LAYOUT_FLAG_GPU_ELIGIBLE, LAYOUT_FLAG_TEXT_MEASURE_REQUIRED
export LAYOUT_FLAG_SEQUENTIAL_WITHIN_ISLAND
export LAYOUT_FLAG_ALL, LAYOUT_FLAG_RESERVED
export LAYOUT_ADMISSION_ALL, LAYOUT_ADMISSION_RESERVED
export layout_profile_kind_to_u8, layout_profile_kind_from_u8
export layout_profile_kind_valid, layout_profile_kind_name
export layout_profile_kind_gpu_eligible
export layout_profile_descriptor, layout_profile_descriptor_equal
export layout_profile_zero_descriptor, layout_profile_descriptor_valid
export layout_step_mask_valid, layout_flags_valid, layout_admission_mask_valid
export layout_profile_flags_agree
