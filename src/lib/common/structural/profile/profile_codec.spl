# ============================================================================
# common/structural/profile/profile_codec.spl — CPU reference serializers for
# the frozen profile-descriptor contract v1 (§26 group 11).
#
# The CPU reference is the oracle and is never deleted; any future vectorized
# or GPU-resident encoder must produce byte-identical output.
#
# Layout (little-endian, fixed width, no padding, no alignment — see
# common/structural/wire.spl):
#
#   ResolveProfileDescriptor        32  profile_id Hash128 | kind u8
#                                       | step_mask u8 | core_mask u16
#                                       | space_count u32 | stage_count u32
#                                       | reserved u32 (== 0)
#   SpatialLayoutProfileDescriptor  24  profile_id Hash128 | kind u8
#                                       | step_mask u8 | flags u16
#                                       | admission_mask u32
#
# DIVERGENCE FROM THE SIBLING CODECS, ON PURPOSE: the identity/mapping/resolve
# encoders return a bare `[u8]`, because their records are near-free-form
# (any u64 attribute bitset is legal). A profile descriptor is almost entirely
# invariant-bearing — closed kind vocabulary, reserved bits, and four
# cross-field agreements — so the shared freeze rule "enforce invariants on
# encode as well as decode" has real content here. Both encoders therefore
# return a result carrier and refuse to emit bytes for a descriptor that a
# conforming decoder would reject. An ill-formed descriptor never reaches the
# wire, instead of failing on the far side of a file or network boundary where
# the producer is already gone.
#
# Decoders are total: they never trap on malformed input, they return a result
# struct carrying an `ok` flag. Unknown discriminants, set reserved bits, and
# violated cross-field agreements are HARD REJECTS, never silent defaults.
# ============================================================================

use std.common.structural.wire.{
    WIRE_ENVELOPE_LEN,
    wire_check_envelope,
    wire_get_u8,
    wire_get_u16,
    wire_get_u32,
    wire_has,
    wire_magic,
    wire_put_envelope,
    wire_put_u16,
    wire_put_u32,
    wire_put_u8
}
use std.common.structural.identity.identity_codec.{hash128_put, hash128_read}
use std.common.structural.profile.profile_types.{
    LAYOUT_PROFILE_DESCRIPTOR_LEN,
    PROFILE_SCHEMA_VERSION,
    RESOLVE_PROFILE_DESCRIPTOR_LEN,
    ResolveProfileDescriptor,
    SpatialLayoutProfileDescriptor,
    layout_profile_descriptor,
    layout_profile_descriptor_valid,
    layout_profile_zero_descriptor,
    resolve_profile_descriptor,
    resolve_profile_descriptor_valid,
    resolve_profile_zero_descriptor
}

# ----------------------------------------------------------------------------
# Record magics. Distinct per record type so a mis-routed buffer is rejected
# rather than silently reinterpreted.
# ----------------------------------------------------------------------------

fn profile_magic_resolve() -> i64:
    wire_magic("SRPD")

fn profile_magic_layout() -> i64:
    wire_magic("SLPD")

# ----------------------------------------------------------------------------
# Result carriers
# ----------------------------------------------------------------------------

struct ProfileEncodeResult:
    """`bytes` is empty whenever `ok` is false — a rejected descriptor
    produces no partial buffer a caller could mistake for a record."""
    ok: bool
    bytes: [u8]

struct ResolveProfileDescriptorResult:
    ok: bool
    value: ResolveProfileDescriptor

struct LayoutProfileDescriptorResult:
    ok: bool
    value: SpatialLayoutProfileDescriptor

# ----------------------------------------------------------------------------
# Unframed field codecs — used when a descriptor is embedded in a larger
# structure (a profile catalog arena).
# ----------------------------------------------------------------------------

fn resolve_profile_descriptor_put(out: [u8], d: ResolveProfileDescriptor) -> [u8]:
    var b = hash128_put(out, d.profile_id)
    b = wire_put_u8(b, d.kind)
    b = wire_put_u8(b, d.step_mask)
    b = wire_put_u16(b, d.core_mask)
    b = wire_put_u32(b, d.space_count)
    b = wire_put_u32(b, d.stage_count)
    wire_put_u32(b, 0)

fn resolve_profile_descriptor_read(data: [u8], off: i64) -> ResolveProfileDescriptor:
    resolve_profile_descriptor(
        hash128_read(data, off),
        wire_get_u8(data, off + 16),
        wire_get_u8(data, off + 17),
        wire_get_u16(data, off + 18),
        wire_get_u32(data, off + 20),
        wire_get_u32(data, off + 24))

fn resolve_profile_descriptor_reserved_ok(data: [u8], off: i64) -> bool:
    """The trailing reserved u32 of an unframed ResolveProfileDescriptor must
    be 0."""
    wire_get_u32(data, off + 28) == 0

fn layout_profile_descriptor_put(out: [u8], d: SpatialLayoutProfileDescriptor) -> [u8]:
    var b = hash128_put(out, d.profile_id)
    b = wire_put_u8(b, d.kind)
    b = wire_put_u8(b, d.step_mask)
    b = wire_put_u16(b, d.flags)
    wire_put_u32(b, d.admission_mask)

fn layout_profile_descriptor_read(data: [u8], off: i64) -> SpatialLayoutProfileDescriptor:
    layout_profile_descriptor(
        hash128_read(data, off),
        wire_get_u8(data, off + 16),
        wire_get_u8(data, off + 17),
        wire_get_u16(data, off + 18),
        wire_get_u32(data, off + 20))

# ----------------------------------------------------------------------------
# Framed encode — invariant-checked
# ----------------------------------------------------------------------------

fn encode_resolve_profile_descriptor(d: ResolveProfileDescriptor) -> ProfileEncodeResult:
    val empty: [u8] = []
    if not resolve_profile_descriptor_valid(d):
        return ProfileEncodeResult(ok: false, bytes: empty)
    var b: [u8] = []
    b = wire_put_envelope(b, profile_magic_resolve(), PROFILE_SCHEMA_VERSION)
    ProfileEncodeResult(ok: true, bytes: resolve_profile_descriptor_put(b, d))

fn encode_layout_profile_descriptor(d: SpatialLayoutProfileDescriptor) -> ProfileEncodeResult:
    val empty: [u8] = []
    if not layout_profile_descriptor_valid(d):
        return ProfileEncodeResult(ok: false, bytes: empty)
    var b: [u8] = []
    b = wire_put_envelope(b, profile_magic_layout(), PROFILE_SCHEMA_VERSION)
    ProfileEncodeResult(ok: true, bytes: layout_profile_descriptor_put(b, d))

# ----------------------------------------------------------------------------
# Framed decode — total, hard-rejecting
# ----------------------------------------------------------------------------

fn decode_resolve_profile_descriptor(data: [u8]) -> ResolveProfileDescriptorResult:
    val zero = resolve_profile_zero_descriptor()
    if not wire_check_envelope(data, 0, profile_magic_resolve(), PROFILE_SCHEMA_VERSION):
        return ResolveProfileDescriptorResult(ok: false, value: zero)
    if not wire_has(data, WIRE_ENVELOPE_LEN, RESOLVE_PROFILE_DESCRIPTOR_LEN):
        return ResolveProfileDescriptorResult(ok: false, value: zero)
    if not resolve_profile_descriptor_reserved_ok(data, WIRE_ENVELOPE_LEN):
        return ResolveProfileDescriptorResult(ok: false, value: zero)
    val v = resolve_profile_descriptor_read(data, WIRE_ENVELOPE_LEN)
    if not resolve_profile_descriptor_valid(v):
        return ResolveProfileDescriptorResult(ok: false, value: zero)
    ResolveProfileDescriptorResult(ok: true, value: v)

fn decode_layout_profile_descriptor(data: [u8]) -> LayoutProfileDescriptorResult:
    val zero = layout_profile_zero_descriptor()
    if not wire_check_envelope(data, 0, profile_magic_layout(), PROFILE_SCHEMA_VERSION):
        return LayoutProfileDescriptorResult(ok: false, value: zero)
    if not wire_has(data, WIRE_ENVELOPE_LEN, LAYOUT_PROFILE_DESCRIPTOR_LEN):
        return LayoutProfileDescriptorResult(ok: false, value: zero)
    val v = layout_profile_descriptor_read(data, WIRE_ENVELOPE_LEN)
    if not layout_profile_descriptor_valid(v):
        return LayoutProfileDescriptorResult(ok: false, value: zero)
    LayoutProfileDescriptorResult(ok: true, value: v)

export ProfileEncodeResult, ResolveProfileDescriptorResult, LayoutProfileDescriptorResult
export profile_magic_resolve, profile_magic_layout
export resolve_profile_descriptor_put, resolve_profile_descriptor_read
export resolve_profile_descriptor_reserved_ok
export layout_profile_descriptor_put, layout_profile_descriptor_read
export encode_resolve_profile_descriptor, decode_resolve_profile_descriptor
export encode_layout_profile_descriptor, decode_layout_profile_descriptor
