# ============================================================================
# common/structural/receipt/receipt_types.spl — FROZEN receipt contract v1
#
# Architecture §21 (unified execution framework), §21.3 (stage receipt),
# §21.4 (fallback rules), §26 (contract freeze, artifact group 7:
# "StageReceipt and VerificationReceipt"), §6.4 (MappingShardRef is a field of
# both receipts and was deliberately left for THIS group to freeze).
#
# Contract document: doc/05_design/platform/structural_compute/
# receipt_contract_v1.md
#
# ---------------------------------------------------------------------------
# WHAT IS *NOT* DECLARED HERE, ON PURPOSE
# ---------------------------------------------------------------------------
# `StageReceipt` already exists, in
# src/lib/common/structural/execution/contracts.spl, and is already aliased as
# `LayoutReceipt` and read by ~20 modules. It is IMPORTED, never redeclared —
# two declarations of one wire record is how two lanes come to disagree about
# a field while both report success (the MAP lane hit the same situation with
# MappingKind and resolved it the same way).
#
# `ExecutionMode`, `StageId`, `BackendId` and `Hash256` likewise already exist
# in common/compute/placement_contracts/semantic.spl. `ExecutionMode` there
# carries exactly §21's three variants in exactly §21's order, so it is the
# frozen enum and is imported. structural/resolve/style_link_receipts.spl
# already imports that module by the same path, so this is an established
# edge, not a new lane dependency.
#
# `SourceOriginSet` and `EntitySetView` are NOT frozen here. §6.4 lists three
# deferred handle/view types; only `MappingShardRef` is stated there to be a
# field of StageReceipt and VerificationReceipt, so only that one belongs to
# this group. `EntitySetView` was owned by the QueryIR lane, which has since
# FROZEN it: 13 bytes, object_slot u32 | offset u32 | count u32 | order u8,
# magic SQSV, implemented in src/lib/common/structural/query/. It is no longer
# an open type; round-trip verified against the implementation 2026-08-02.
# `SourceOriginSet` is the return of MappingGraph::trace_to_source and is
# referenced by no receipt field anywhere in §21. §6.4 resolves its OWNERSHIP
# to MAP; what is still missing is the type itself, which exists nowhere in
# src/ and is the one genuinely open member of §6.4's original three.
#
# ---------------------------------------------------------------------------
# THE CONTRACT DEFECT THIS GROUP EXISTS TO FIX (§7 of the contract document)
# ---------------------------------------------------------------------------
# §21.3's StageReceipt carries `mode` and `fallback_count` and NOTHING ELSE
# about why the mode was reached. §21.4 lists eight fallback reasons, and one
# of them — "cost-model chooses CPU" — is a *planned* selection, while the
# other seven are *forced degradations*. Under §21.3 as written both produce
# `mode = CpuReference` with a non-zero `fallback_count` and are therefore
# INDISTINGUISHABLE on the wire.
#
# That is exactly the distinction the lane plan's "no silent fallback" rule
# depends on: cpu_selected-by-cost-policy is not gpu_fallback. §21.3 cannot
# express it. This lane therefore freezes three additional selection-provenance
# fields, and the reason is not invented — the in-tree StageReceipt already
# grew `candidate_backend` and `fallback_reason` for the same need before this
# freeze, which is corroboration that §21.3 is short, not that this lane is
# over-reaching.
#
#   requested_mode   what ExecutionProfile.mode asked for
#   mode             what actually ran        (already in §21.3)
#   candidate_backend  the backend the cost model first considered
#   backend          what actually ran        (already in §21.3)
#   fallback_reason  StageFallbackReason, §21.4's list as a closed u8 enum
#
# With those, the two cases separate cleanly and mechanically:
#
#   cost-policy CPU  requested HybridVectorGpu, ran CpuReference,
#                    reason = CostModelSelectedCpu  -> stage_fallback_is_policy
#   forced fallback  requested HybridVectorGpu, ran CpuReference,
#                    reason = DeviceLost (etc.)     -> stage_fallback_is_forced
#
# `stage_receipt_selection_consistent` makes the receipt self-checking: a
# receipt that ran in a different mode than it requested and reports reason
# None is REJECTED, because that is precisely the silent fallback §21.4
# forbids. A degradation that forgets to say why cannot be put on the wire.
# ============================================================================

use std.common.structural.identity.entity_id.{
    ArtifactId,
    EntityRef,
    Hash128,
    SNAPSHOT_ID_LEN,
    SnapshotId,
    artifact_id,
    entity_ref,
    entity_ref_equal,
    hash128,
    hash128_equal,
    snapshot_id,
    snapshot_id_equal
}
use std.common.structural.execution.contracts.{StageReceipt}
use std.common.compute.placement_contracts.semantic.{ExecutionMode}

val RECEIPT_SCHEMA_VERSION: i64 = 1

# ----------------------------------------------------------------------------
# ExecutionMode wire mapping
#
# The enum is imported, not redeclared. Discriminants follow §21's declaration
# order, which is also the declaration order in placement_contracts/semantic.
# ----------------------------------------------------------------------------

fn execution_mode_to_u8(m: ExecutionMode) -> i64:
    match m:
        case ExecutionMode.CpuReference: 0
        case ExecutionMode.HybridVectorGpu: 1
        case ExecutionMode.ResidentGpu: 2

val EXECUTION_MODE_MAX: i64 = 2
val EXECUTION_MODE_COUNT: i64 = 3

fn execution_mode_from_u8(v: i64) -> ExecutionMode:
    """Caller MUST gate on `execution_mode_valid` first. Total by construction,
    pinning unknown input to CpuReference, same rule as mapping_kind_from_u8."""
    match v:
        case 1: ExecutionMode.HybridVectorGpu
        case 2: ExecutionMode.ResidentGpu
        case _: ExecutionMode.CpuReference

fn execution_mode_valid(v: i64) -> bool:
    v >= 0 and v <= EXECUTION_MODE_MAX

fn execution_mode_equal(a: ExecutionMode, b: ExecutionMode) -> bool:
    execution_mode_to_u8(a) == execution_mode_to_u8(b)

fn execution_mode_uses_gpu(m: ExecutionMode) -> bool:
    """True for the two modes that place work on a device. §21.5's matrix
    distinguishes exactly these two from the scalar CPU column."""
    execution_mode_to_u8(m) > 0

# ----------------------------------------------------------------------------
# StageFallbackReason — §21.4's list, verbatim and closed.
#
# Nine discriminants: §21.4's eight lines in the order printed there, plus
# `None` at 0. `None` is DERIVED, not invented: §21.3 permits
# `fallback_count == 0`, so a receipt that did not fall back still has to put
# something in this slot, and a reserved/sentinel-free field would force a
# reader to guess. Zero-means-absent matches MAPPING_FLAG_NONE in wave 0b.
#
# Named `StageFallbackReason`, not `FallbackReason`, because
# src/compiler/80.driver/compilability.spl already declares an unrelated
# `FallbackReason` enumerating JIT-to-interpreter demotion causes. The two
# vocabularies must never be conflated: one is about which engine executes
# Simple code, this one is about whether a compute stage ran on the device it
# was planned for. Reusing the name would let a merge silently unify them.
# ----------------------------------------------------------------------------

enum StageFallbackReason:
    """Why a stage did not run in the mode that was requested (§21.4)."""
    None
    UnsupportedFeature
    ResourceBudgetExceeded
    QueueOverflow
    MalformedInput
    VerificationMismatch
    DeviceLost
    StorageError
    CostModelSelectedCpu

fn stage_fallback_reason_to_u8(r: StageFallbackReason) -> i64:
    match r:
        case StageFallbackReason.None: 0
        case StageFallbackReason.UnsupportedFeature: 1
        case StageFallbackReason.ResourceBudgetExceeded: 2
        case StageFallbackReason.QueueOverflow: 3
        case StageFallbackReason.MalformedInput: 4
        case StageFallbackReason.VerificationMismatch: 5
        case StageFallbackReason.DeviceLost: 6
        case StageFallbackReason.StorageError: 7
        case StageFallbackReason.CostModelSelectedCpu: 8

val STAGE_FALLBACK_REASON_MAX: i64 = 8
val STAGE_FALLBACK_REASON_COUNT: i64 = 9

fn stage_fallback_reason_from_u8(v: i64) -> StageFallbackReason:
    """Caller MUST gate on `stage_fallback_reason_valid` first."""
    match v:
        case 1: StageFallbackReason.UnsupportedFeature
        case 2: StageFallbackReason.ResourceBudgetExceeded
        case 3: StageFallbackReason.QueueOverflow
        case 4: StageFallbackReason.MalformedInput
        case 5: StageFallbackReason.VerificationMismatch
        case 6: StageFallbackReason.DeviceLost
        case 7: StageFallbackReason.StorageError
        case 8: StageFallbackReason.CostModelSelectedCpu
        case _: StageFallbackReason.None

fn stage_fallback_reason_valid(v: i64) -> bool:
    v >= 0 and v <= STAGE_FALLBACK_REASON_MAX

fn stage_fallback_reason_equal(a: StageFallbackReason,
                               b: StageFallbackReason) -> bool:
    stage_fallback_reason_to_u8(a) == stage_fallback_reason_to_u8(b)

fn stage_fallback_reason_to_text(r: StageFallbackReason) -> text:
    """The stable snake_case spelling. This is the ONLY sanctioned spelling:
    the in-tree StageReceipt.fallback_reason is a free-form `text` today and
    call sites write ad-hoc strings into it, which is why an unknown spelling
    must be rejected rather than passed through."""
    match r:
        case StageFallbackReason.None: ""
        case StageFallbackReason.UnsupportedFeature: "unsupported_feature"
        case StageFallbackReason.ResourceBudgetExceeded: "resource_budget_exceeded"
        case StageFallbackReason.QueueOverflow: "queue_overflow"
        case StageFallbackReason.MalformedInput: "malformed_input"
        case StageFallbackReason.VerificationMismatch: "verification_mismatch"
        case StageFallbackReason.DeviceLost: "device_lost"
        case StageFallbackReason.StorageError: "storage_error"
        case StageFallbackReason.CostModelSelectedCpu: "cost_model_selected_cpu"

fn stage_fallback_reason_from_text(s: text) -> i64:
    """Discriminant for a sanctioned spelling, or -1 for anything else.
    Returning -1 rather than a default is the hard-reject rule applied to the
    text form: a stage whose reason this build does not know must not be
    recorded as though it had not fallen back at all."""
    var i = 0
    while i <= STAGE_FALLBACK_REASON_MAX:
        if stage_fallback_reason_to_text(stage_fallback_reason_from_u8(i)) == s:
            return i
        i = i + 1
    -1

fn stage_fallback_is_policy(r: StageFallbackReason) -> bool:
    """A PLANNED selection, not a degradation. Exactly one of §21.4's eight
    lines is of this kind: "cost-model chooses CPU". §21.2 states the rule it
    implements — "the scheduler chooses GPU only when expected total cost ...
    beats the CPU path" — so choosing CPU there is the cost model working, not
    failing. This is the predicate that keeps cpu_selected out of the
    gpu_fallback bucket."""
    stage_fallback_reason_to_u8(r) == 8

fn stage_fallback_is_forced(r: StageFallbackReason) -> bool:
    """A DEGRADATION: the stage wanted the device and could not have it. These
    are the seven that an operator has to be able to alert on."""
    val d = stage_fallback_reason_to_u8(r)
    d >= 1 and d <= 7

# ----------------------------------------------------------------------------
# VerificationPolicy — §21.1 `verify(result, policy: VerificationPolicy)`.
#
# Named in a signature, never defined anywhere in the architecture and declared
# nowhere in the repository. Frozen here as the minimum vocabulary the
# surrounding sections actually distinguish, each variant traced to the
# sentence that forces it (contract document §7, item V1):
#
#   Off             §21 makes ExecutionProfile.verification a field, so it must
#                   be possible to ask for none.
#   DeterministicHash  §21.3 already carries `deterministic_hash`, and §29's
#                   gate is "cross-mode deterministic output" — comparing that
#                   one hash is a distinct, cheap policy.
#   Sampled         §20.8/§20.9 forbid per-node metadata and per-node cost;
#                   full verification of every item contradicts them, so a
#                   partial policy has to exist.
#   Full            the §29 gate has to be reachable exactly.
#   OracleCompare   §19.5's `verify(result, oracle: LayoutSnapshotRef?)` takes
#                   an OPTIONAL oracle, and §24's risk table lists "Clang
#                   oracle/fallback" — an oracle-present policy is therefore
#                   distinguished from every oracle-absent one.
# ----------------------------------------------------------------------------

enum VerificationPolicy:
    """How much checking a stage was asked to do (§21.1)."""
    Off
    DeterministicHash
    Sampled
    Full
    OracleCompare

fn verification_policy_to_u8(p: VerificationPolicy) -> i64:
    match p:
        case VerificationPolicy.Off: 0
        case VerificationPolicy.DeterministicHash: 1
        case VerificationPolicy.Sampled: 2
        case VerificationPolicy.Full: 3
        case VerificationPolicy.OracleCompare: 4

val VERIFICATION_POLICY_MAX: i64 = 4
val VERIFICATION_POLICY_COUNT: i64 = 5

fn verification_policy_from_u8(v: i64) -> VerificationPolicy:
    match v:
        case 1: VerificationPolicy.DeterministicHash
        case 2: VerificationPolicy.Sampled
        case 3: VerificationPolicy.Full
        case 4: VerificationPolicy.OracleCompare
        case _: VerificationPolicy.Off

fn verification_policy_valid(v: i64) -> bool:
    v >= 0 and v <= VERIFICATION_POLICY_MAX

fn verification_policy_equal(a: VerificationPolicy,
                             b: VerificationPolicy) -> bool:
    verification_policy_to_u8(a) == verification_policy_to_u8(b)

fn verification_policy_needs_oracle(p: VerificationPolicy) -> bool:
    """Only OracleCompare requires the optional oracle of §19.5 to be present."""
    verification_policy_to_u8(p) == 4

# ----------------------------------------------------------------------------
# VerificationOutcome
#
# §21.1 returns a VerificationReceipt from `verify`; nothing in the
# architecture says what a receipt reports. Minimum vocabulary, derived:
#   NotRun            follows directly from VerificationPolicy.Off.
#   Match / Mismatch  §21.4 lists "verification mismatch" as a fallback
#                     reason, so both outcomes are distinguished by name.
#   OracleUnavailable §19.5's oracle parameter is optional, so an
#                     OracleCompare request can fail to find one. Reporting
#                     that as Match would be a silent pass, which is the
#                     failure mode this whole lane exists to prevent.
# ----------------------------------------------------------------------------

enum VerificationOutcome:
    """What verification concluded."""
    NotRun
    Match
    Mismatch
    OracleUnavailable

fn verification_outcome_to_u8(o: VerificationOutcome) -> i64:
    match o:
        case VerificationOutcome.NotRun: 0
        case VerificationOutcome.Match: 1
        case VerificationOutcome.Mismatch: 2
        case VerificationOutcome.OracleUnavailable: 3

val VERIFICATION_OUTCOME_MAX: i64 = 3
val VERIFICATION_OUTCOME_COUNT: i64 = 4

fn verification_outcome_from_u8(v: i64) -> VerificationOutcome:
    match v:
        case 1: VerificationOutcome.Match
        case 2: VerificationOutcome.Mismatch
        case 3: VerificationOutcome.OracleUnavailable
        case _: VerificationOutcome.NotRun

fn verification_outcome_valid(v: i64) -> bool:
    v >= 0 and v <= VERIFICATION_OUTCOME_MAX

fn verification_outcome_equal(a: VerificationOutcome,
                              b: VerificationOutcome) -> bool:
    verification_outcome_to_u8(a) == verification_outcome_to_u8(b)

fn verification_outcome_is_clean(o: VerificationOutcome) -> bool:
    """ONLY `Match` is clean. NotRun and OracleUnavailable are explicitly not
    clean: treating "we did not check" as "it was fine" is the silent pass."""
    verification_outcome_to_u8(o) == 1

# ----------------------------------------------------------------------------
# MappingShardRef — §6.4's deferred handle, frozen here.
#
# §6.4 states it is the return of MappingGraph::finish() and "a field of
# StageReceipt and VerificationReceipt", and that it is "a handle ... rather
# than part of the compressed mapping format". A handle has to say WHICH shard,
# in WHICH snapshot, and has to be checkable against the shard it names —
# otherwise a stale handle silently reads another stage's provenance, which is
# what §6.5 forbids ("a pass cannot silently drop origins").
#
#   snapshot      §4.4 identity of the snapshot the shard belongs to
#   shard_index   dense index of the shard within that snapshot
#   edge_count    edges the shard had when the handle was taken; lets a reader
#                 detect a rebuilt shard without decompressing it
#   content_hash  Hash128 of the encoded shard bytes; the actual staleness
#                 check. Hash128 is reused from the ID-TAG lane rather than a
#                 new width being introduced.
#
# 52 bytes: SNAPSHOT_ID_LEN 28 + 4 + 4 + HASH128_LEN 16, no padding.
# ----------------------------------------------------------------------------

struct MappingShardRef:
    """Handle to one built mapping shard (§6.4)."""
    snapshot: SnapshotId
    shard_index: u32
    edge_count: u32
    content_hash: Hash128

val MAPPING_SHARD_REF_LEN: i64 = 52

fn mapping_shard_ref(snapshot: SnapshotId, shard_index: u32,
                     edge_count: u32, content_hash: Hash128) -> MappingShardRef:
    MappingShardRef(snapshot: snapshot, shard_index: shard_index,
                    edge_count: edge_count, content_hash: content_hash)

fn mapping_shard_ref_none() -> MappingShardRef:
    """The absent handle. A receipt that produced no mapping delta still has
    to fill the slot; an all-zero handle with edge_count 0 is that value, and
    `mapping_shard_ref_is_none` is how a reader tells it apart from a real
    handle to an empty shard (which carries a non-zero content hash)."""
    mapping_shard_ref(snapshot_id(identity_zero_artifact_ref(), 0), 0, 0,
                      hash128(0, 0))

fn mapping_shard_ref_is_none(r: MappingShardRef) -> bool:
    r.edge_count == 0 and hash128_equal(r.content_hash, hash128(0, 0))

fn mapping_shard_ref_equal(a: MappingShardRef, b: MappingShardRef) -> bool:
    (snapshot_id_equal(a.snapshot, b.snapshot)
        and a.shard_index == b.shard_index
        and a.edge_count == b.edge_count
        and hash128_equal(a.content_hash, b.content_hash))

# ----------------------------------------------------------------------------
# VerificationReceipt — §26 group 7, second half.
#
# Used in §21.1 and §19.5 signatures and DEFINED NOWHERE in the architecture.
# This is the type that most needed freezing and the one with the least text
# behind it; every field is traced in §7 of the contract document.
#
# It deliberately mirrors StageReceipt's identifying head (stage / backend /
# mode) so a verification receipt can be joined to the stage receipt it checks
# without a separate correlation id, and carries `origins` because §6.4 says
# MappingShardRef is a field of it.
# ----------------------------------------------------------------------------

struct VerificationReceipt:
    """Outcome of StageBackend::verify (§21.1)."""
    contract_version: i64
    stage: text
    backend: text
    mode: ExecutionMode
    policy: VerificationPolicy
    outcome: VerificationOutcome
    checked_count: i64
    mismatch_count: i64
    first_mismatch: EntityRef
    result_hash: text
    oracle_hash: text
    origins: MappingShardRef
    elapsed_us: i64

fn verification_receipt(stage: text, backend: text, mode: ExecutionMode,
                        policy: VerificationPolicy,
                        outcome: VerificationOutcome,
                        checked_count: i64, mismatch_count: i64,
                        first_mismatch: EntityRef,
                        result_hash: text, oracle_hash: text,
                        origins: MappingShardRef,
                        elapsed_us: i64) -> VerificationReceipt:
    VerificationReceipt(contract_version: RECEIPT_SCHEMA_VERSION,
                        stage: stage, backend: backend, mode: mode,
                        policy: policy, outcome: outcome,
                        checked_count: checked_count,
                        mismatch_count: mismatch_count,
                        first_mismatch: first_mismatch,
                        result_hash: result_hash, oracle_hash: oracle_hash,
                        origins: origins, elapsed_us: elapsed_us)

fn verification_receipt_not_run(stage: text, backend: text,
                                mode: ExecutionMode) -> VerificationReceipt:
    verification_receipt(stage, backend, mode, VerificationPolicy.Off,
                         VerificationOutcome.NotRun, 0, 0,
                         entity_ref(0, 0), "", "",
                         mapping_shard_ref_none(), 0)

fn verification_receipt_equal(a: VerificationReceipt,
                              b: VerificationReceipt) -> bool:
    (a.contract_version == b.contract_version
        and a.stage == b.stage
        and a.backend == b.backend
        and execution_mode_equal(a.mode, b.mode)
        and verification_policy_equal(a.policy, b.policy)
        and verification_outcome_equal(a.outcome, b.outcome)
        and a.checked_count == b.checked_count
        and a.mismatch_count == b.mismatch_count
        and entity_ref_equal(a.first_mismatch, b.first_mismatch)
        and a.result_hash == b.result_hash
        and a.oracle_hash == b.oracle_hash
        and mapping_shard_ref_equal(a.origins, b.origins)
        and a.elapsed_us == b.elapsed_us)

fn verification_receipt_consistent(v: VerificationReceipt) -> bool:
    """Structural rule enforced identically on encode and decode.

    Four ways a verification receipt can lie, all rejected:
      - Mismatch with mismatch_count 0, or a clean outcome with a non-zero
        one. A mismatch that reports zero mismatches is a silent pass.
      - mismatch_count above checked_count: more failures than checks.
      - OracleCompare requested but the outcome is not one that an oracle
        comparison can produce.
      - An oracle hash present when no oracle was consulted, which would let
        a reader believe a comparison happened."""
    if v.mismatch_count < 0 or v.checked_count < 0:
        return false
    if v.mismatch_count > v.checked_count:
        return false
    val is_mismatch = verification_outcome_to_u8(v.outcome) == 2
    if is_mismatch and v.mismatch_count == 0:
        return false
    if not is_mismatch and v.mismatch_count != 0:
        return false
    if verification_outcome_to_u8(v.outcome) == 0 and v.checked_count != 0:
        return false
    if v.oracle_hash != "" and not verification_policy_needs_oracle(v.policy):
        return false
    true

# ----------------------------------------------------------------------------
# StageReceipt selection provenance
#
# StageReceipt itself is imported, not redeclared. What this lane adds is the
# rule that makes §21.4's "fallback does not silently change semantics"
# mechanically checkable, plus the two accessors that answer the question the
# lane plan asks: was this CPU run chosen, or forced?
# ----------------------------------------------------------------------------

fn stage_receipt_fallback_reason(r: StageReceipt) -> i64:
    """Discriminant of the receipt's reason text, or -1 if the text is not a
    sanctioned spelling."""
    stage_fallback_reason_from_text(r.fallback_reason)

fn stage_receipt_cpu_selected(r: StageReceipt, requested: ExecutionMode) -> bool:
    """TRUE when the cost model chose the CPU path on purpose (§21.2).
    This is NOT a fallback in the operational sense and must not be counted as
    one, which is the whole point of separating it from the seven below."""
    (execution_mode_uses_gpu(requested)
        and not execution_mode_uses_gpu(execution_mode_from_u8(
            stage_receipt_mode_u8(r)))
        and stage_receipt_fallback_reason(r) == 8)

fn stage_receipt_gpu_fallback(r: StageReceipt, requested: ExecutionMode) -> bool:
    """TRUE when a device run was requested and a degradation prevented it."""
    val d = stage_receipt_fallback_reason(r)
    (execution_mode_uses_gpu(requested)
        and not execution_mode_uses_gpu(execution_mode_from_u8(
            stage_receipt_mode_u8(r)))
        and d >= 1 and d <= 7)

fn stage_receipt_mode_u8(r: StageReceipt) -> i64:
    """The in-tree StageReceipt stores `mode` as text. Map the three sanctioned
    spellings onto §21's discriminants; anything else is -1 and is rejected by
    the codec rather than defaulted to CpuReference, which would silently
    downgrade a GPU run's provenance."""
    match r.mode:
        case "cpu_reference": 0
        case "hybrid_vector_gpu": 1
        case "resident_gpu": 2
        case _: -1

fn execution_mode_to_text(m: ExecutionMode) -> text:
    """The stable snake_case spelling, matching §21.5's mode-matrix column
    names and the `fallback:` values already used in the architecture's
    worked examples (§30's `fallback: cpu_reference`)."""
    match m:
        case ExecutionMode.CpuReference: "cpu_reference"
        case ExecutionMode.HybridVectorGpu: "hybrid_vector_gpu"
        case ExecutionMode.ResidentGpu: "resident_gpu"

fn stage_receipt_selection_consistent(r: StageReceipt,
                                      requested: ExecutionMode) -> bool:
    """The no-silent-fallback rule, as a predicate.

    A stage that ran in a mode other than the one requested MUST name a
    reason, and a stage that ran in the requested mode MUST NOT claim one.
    Either violation is rejected on encode and on decode, so a degradation
    that forgets to explain itself cannot reach the wire at all."""
    val m = stage_receipt_mode_u8(r)
    if m < 0:
        return false
    val d = stage_receipt_fallback_reason(r)
    if d < 0:
        return false
    val diverged = m != execution_mode_to_u8(requested)
    if diverged and d == 0:
        return false
    if not diverged and d != 0:
        return false
    if r.fallback_count < 0 or r.malformed_count < 0:
        return false
    true

# `identity_zero_artifact` lives in identity_codec, which depends on this
# module's siblings; re-deriving the zero ArtifactId locally keeps the type
# module free of a codec dependency.
fn identity_zero_artifact_ref() -> ArtifactId:
    artifact_id(hash128(0, 0), 0)

export RECEIPT_SCHEMA_VERSION
export EXECUTION_MODE_COUNT, EXECUTION_MODE_MAX
export STAGE_FALLBACK_REASON_COUNT, STAGE_FALLBACK_REASON_MAX
export VERIFICATION_OUTCOME_COUNT, VERIFICATION_OUTCOME_MAX
export VERIFICATION_POLICY_COUNT, VERIFICATION_POLICY_MAX
export MAPPING_SHARD_REF_LEN
export MappingShardRef, StageFallbackReason, VerificationOutcome
export VerificationPolicy, VerificationReceipt
export execution_mode_equal, execution_mode_from_u8, execution_mode_to_text
export execution_mode_to_u8, execution_mode_uses_gpu, execution_mode_valid
export identity_zero_artifact_ref
export mapping_shard_ref, mapping_shard_ref_equal, mapping_shard_ref_is_none
export mapping_shard_ref_none
export stage_fallback_is_forced, stage_fallback_is_policy
export stage_fallback_reason_equal, stage_fallback_reason_from_text
