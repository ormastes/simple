# Component descriptor contract (research doc §5.1/§5.3, Phase B).
#
# Minimal pure-data descriptor for selectable components: id, version, the
# three independent dynload axes (presence/placement/activation), provided
# interfaces, and dependency ids. A fail-closed SDN-subset parser, a
# validation pass (unknown axis values, duplicate ids, dangling dependency
# references are explicit errors), and a resolve step producing the
# comma key=value axis-spec string consumed by dynsmf_dynload_setting_parse
# (src/os/smf/dynsmf_session.spl). Axis value sets are duplicated here as
# plain strings rather than importing os.smf, so std.common stays free of an
# os-layer dependency; the spec proves the handshake against the real parser.
#
# Research: doc/01_research/compiler/startup_performance/startup_perf_architecture_2026-08-17.md

struct ComponentDescriptor:
    id: text
    version: text
    presence: text
    placement: text
    activation: text
    provides: [text]
    dependencies: [text]

struct ComponentParseOutcome:
    ok: bool
    reason: text
    descriptors: [ComponentDescriptor]

struct ComponentValidation:
    ok: bool
    errors: [text]

fn component_presence_values() -> [text]:
    ["off", "auto", "on"]

fn component_placement_values() -> [text]:
    ["auto", "static", "dynamic"]

# Mirrors the landed dynsmf activation set. The research-doc defaults table
# also mentions "hotspot"; dynsmf_activation_valid does not accept it, so it
# is deliberately excluded here to keep the handshake fail-closed.
fn component_activation_values() -> [text]:
    ["startup", "command", "first_use", "manual"]

fn component_axis_value_valid(values: [text], v: text) -> bool:
    var idx = 0
    while idx < values.len():
        if values[idx] == v:
            return true
        idx = idx + 1
    false

fn component_descriptor_default(id: text, version: text) -> ComponentDescriptor:
    val empty: [text] = []
    val empty2: [text] = []
    ComponentDescriptor(id: id, version: version, presence: "auto", placement: "auto", activation: "first_use", provides: empty, dependencies: empty2)

fn component_list_value_parse(value: text) -> [text]:
    var out: [text] = []
    if value.trim() == "":
        return out
    val parts = value.split(",")
    var idx = 0
    while idx < parts.len():
        val item = parts[idx].trim()
        if item != "":
            out.push(item)
        idx = idx + 1
    out

# Parse an SDN-subset component catalog, fail closed. Grammar:
#
#   component:
#     id: optimizer.basic
#     version: 1
#     presence: auto
#     placement: auto
#     activation: command
#     provides: opt.basic, opt.inline
#     dependencies: compiler.frontend
#
# Blank lines and full-line `#` comments are ignored. Unknown keys, keys
# outside a `component:` block, a block without an id, and malformed lines
# are all hard parse failures — never silently skipped.
fn component_descriptor_parse_sdn(source: text) -> ComponentParseOutcome:
    var descriptors: [ComponentDescriptor] = []
    var in_block = false
    var cur = component_descriptor_default("", "")
    var have_id = false
    val lines = source.split("\n")
    var idx = 0
    while idx < lines.len():
        val line = lines[idx].trim()
        idx = idx + 1
        if line == "" or line.starts_with("#"):
            continue
        if line == "component:":
            if in_block:
                if not have_id:
                    return ComponentParseOutcome(ok: false, reason: "missing_id_in_component_block", descriptors: descriptors)
                descriptors.push(cur)
            in_block = true
            cur = component_descriptor_default("", "")
            have_id = false
            continue
        val sep = line.index_of(":")
        if sep < 0:
            return ComponentParseOutcome(ok: false, reason: "malformed_line:" + line, descriptors: descriptors)
        if not in_block:
            return ComponentParseOutcome(ok: false, reason: "key_outside_component_block:" + line, descriptors: descriptors)
        val key = line.substring(0, sep).trim()
        val value = line.substring(sep + 1, line.len()).trim()
        if key == "id":
            if value == "":
                return ComponentParseOutcome(ok: false, reason: "empty_id", descriptors: descriptors)
            cur.id = value
            have_id = true
        elif key == "version":
            cur.version = value
        elif key == "presence":
            cur.presence = value
        elif key == "placement":
            cur.placement = value
        elif key == "activation":
            cur.activation = value
        elif key == "provides":
            cur.provides = component_list_value_parse(value)
        elif key == "dependencies":
            cur.dependencies = component_list_value_parse(value)
        else:
            return ComponentParseOutcome(ok: false, reason: "unknown_key:" + key, descriptors: descriptors)
    if in_block:
        if not have_id:
            return ComponentParseOutcome(ok: false, reason: "missing_id_in_component_block", descriptors: descriptors)
        descriptors.push(cur)
    ComponentParseOutcome(ok: true, reason: "parsed", descriptors: descriptors)

# Validate a parsed catalog: unknown axis values, duplicate ids, and dangling
# dependency references are explicit errors. Always returns the full error
# list, never just the first hit.
fn component_catalog_validate(descriptors: [ComponentDescriptor]) -> ComponentValidation:
    var errors: [text] = []
    var seen: [text] = []
    var idx = 0
    while idx < descriptors.len():
        val d = descriptors[idx]
        if component_axis_value_valid(seen, d.id):
            errors.push("duplicate_id:" + d.id)
        else:
            seen.push(d.id)
        if not component_axis_value_valid(component_presence_values(), d.presence):
            errors.push("unknown_presence:" + d.id + ":" + d.presence)
        if not component_axis_value_valid(component_placement_values(), d.placement):
            errors.push("unknown_placement:" + d.id + ":" + d.placement)
        if not component_axis_value_valid(component_activation_values(), d.activation):
            errors.push("unknown_activation:" + d.id + ":" + d.activation)
        idx = idx + 1
    idx = 0
    while idx < descriptors.len():
        val d = descriptors[idx]
        var dep_idx = 0
        while dep_idx < d.dependencies.len():
            val dep = d.dependencies[dep_idx]
            if not component_axis_value_valid(seen, dep):
                errors.push("dangling_dependency:" + d.id + ":" + dep)
            dep_idx = dep_idx + 1
        idx = idx + 1
    ComponentValidation(ok: errors.len() == 0, errors: errors)

# Resolve step: effective per-component dynload setting string, in exactly
# the comma key=value grammar dynsmf_dynload_setting_parse accepts.
fn component_effective_dynload_setting(d: ComponentDescriptor) -> text:
    "presence=" + d.presence + ",placement=" + d.placement + ",activation=" + d.activation

# --- Versioned descriptor + fail-closed resolution (Phase B, plan §B1) ---
#
# ComponentDescriptorV1 wraps the parsed descriptor with an explicit schema
# version (composition, no inheritance). resolve_component implements the
# §5.3 decision table for one component and FAILS CLOSED: unknown component,
# unsupported schema version, malformed descriptor, ambiguous (duplicate)
# match, and a missing/mismatched-empty impl digest on placement=auto are
# all explicit typed errors — never a silent default.

struct ComponentDescriptorV1:
    schema_version: i64
    body: ComponentDescriptor

struct ComponentResolveError:
    code: text
    detail: text

# The concrete choice: mode is "absent" | "static" | "dynamic".
struct ComponentChoice:
    id: text
    version: text
    mode: text
    activation: text
    dynload_setting: text

fn component_descriptor_v1(body: ComponentDescriptor) -> ComponentDescriptorV1:
    ComponentDescriptorV1(schema_version: 1, body: body)

# Resolve one component id from a versioned catalog to a concrete choice.
# embedded_impl_hash / configured_impl_hash drive the placement=auto fold:
# matching non-empty hashes fold static; a stale static (hash mismatch)
# picks dynamic; placement=dynamic never folds; presence=off is ABSENT.
# Any empty digest on the placement=auto path is an explicit error.
fn resolve_component(catalog: [ComponentDescriptorV1], id: text, embedded_impl_hash: text, configured_impl_hash: text) -> Result<ComponentChoice, ComponentResolveError>:
    var bodies: [ComponentDescriptor] = []
    var idx = 0
    while idx < catalog.len():
        val entry = catalog[idx]
        if entry.schema_version != 1:
            return Err(ComponentResolveError(code: "unsupported_schema_version", detail: entry.body.id + ":" + entry.schema_version.to_text()))
        bodies.push(entry.body)
        idx = idx + 1
    val validation = component_catalog_validate(bodies)
    if not validation.ok:
        var detail = ""
        var eidx = 0
        while eidx < validation.errors.len():
            if detail != "":
                detail = detail + ";"
            detail = detail + validation.errors[eidx]
            eidx = eidx + 1
        return Err(ComponentResolveError(code: "malformed_descriptor", detail: detail))
    var found = component_descriptor_default("", "")
    var matches = 0
    idx = 0
    while idx < bodies.len():
        if bodies[idx].id == id:
            found = bodies[idx]
            matches = matches + 1
        idx = idx + 1
    if matches == 0:
        return Err(ComponentResolveError(code: "unknown_component", detail: id))
    if matches > 1:
        return Err(ComponentResolveError(code: "ambiguous_component", detail: id))
    var mode = ""
    if found.presence == "off":
        mode = "absent"
    elif found.placement == "static":
        mode = "static"
    elif found.placement == "dynamic":
        # placement=dynamic never folds, regardless of digests.
        mode = "dynamic"
    else:
        # placement=auto: fold static only on a verified digest match.
        if embedded_impl_hash == "" or configured_impl_hash == "":
            return Err(ComponentResolveError(code: "missing_impl_digest", detail: id))
        if embedded_impl_hash == configured_impl_hash:
            mode = "static"
        else:
            mode = "dynamic"
    Ok(ComponentChoice(id: found.id, version: found.version, mode: mode, activation: found.activation, dynload_setting: component_effective_dynload_setting(found)))

# --- Spec-facing accessor helpers ---
#
# The 2026-08-18 shared seed erases class-typed values crossing the
# module boundary into spec files ("undefined field ... on value of type
# 'object'"), so specs cannot read fields on returned records directly.
# These helpers keep every field access inside this module and hand specs
# plain text/bool/i64 verdicts. They add no policy: resolve_component
# above remains the single fail-closed decision point.

# "ok:<count>" on success, otherwise the parse failure reason.
fn component_parse_status(source: text) -> text:
    val outcome = component_descriptor_parse_sdn(source)
    if outcome.ok:
        "ok:" + outcome.descriptors.len().to_text()
    else:
        outcome.reason

# Build a versioned catalog from SDN source; parse failure yields an
# empty catalog (resolve_component then fails closed with unknown_component,
# and specs check component_parse_status first).
fn component_catalog_v1_parse(source: text) -> [ComponentDescriptorV1]:
    val outcome = component_descriptor_parse_sdn(source)
    var cat: [ComponentDescriptorV1] = []
    if not outcome.ok:
        return cat
    var idx = 0
    while idx < outcome.descriptors.len():
        cat.push(component_descriptor_v1(outcome.descriptors[idx]))
        idx = idx + 1
    cat

# Explicit constructor for spec fixtures, schema_version included so
# version sabotage is expressible.
fn component_v1_make(schema_version: i64, id: text, version: text, presence: text, placement: text, activation: text) -> ComponentDescriptorV1:
    var d = component_descriptor_default(id, version)
    d.presence = presence
    d.placement = placement
    d.activation = activation
    ComponentDescriptorV1(schema_version: schema_version, body: d)

# Text verdict over resolve_component: "ok:<mode>:<activation>:<dynload_setting>"
# or "err:<code>". Pure projection — no fallback, no defaulting.
fn resolve_component_verdict(catalog: [ComponentDescriptorV1], id: text, embedded_impl_hash: text, configured_impl_hash: text) -> text:
    match resolve_component(catalog, id, embedded_impl_hash, configured_impl_hash):
        Ok(choice) -> "ok:" + choice.mode + ":" + choice.activation + ":" + choice.dynload_setting
        Err(e) -> "err:" + e.code
