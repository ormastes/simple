# Independent pixels for the pinned 640x480 HTML/CSS corpus case 01.
# The three rectangles come from the authored CSS and SVG reference, never
# from the Web producer's DrawIR or either Vulkan backend.

use std.nogc_sync_mut.io.file_ops.{
    file_is_regular_no_follow, file_hash_sha256}
use std.common.crypto.sha256.{sha256_bytes}
use std.common.crypto.types.{bytes_to_hex}
use common.renderdoc.final_output_pixels.{
    FinalOutputCapture, final_output_canonical_rgba}

pub val CORPUS_CASE01_FIXTURE_ID: text = "corpus-01-solid-boxes-v1"
pub val CORPUS_CASE01_SOURCE_PATH: text =
    "test/fixtures/html_css/corpus/cases/01-solid-boxes.html"
pub val CORPUS_CASE01_SOURCE_SHA256: text =
    "2386d4aa5219ba762839a3897fa18d8775991243706668775bd8771a722737d2"
pub val CORPUS_CASE01_REFERENCE_PATH: text =
    "test/fixtures/html_css/corpus/references/01-solid-boxes.html"
pub val CORPUS_CASE01_REFERENCE_SHA256: text =
    "6f644ae156fec78dfecd7e50e7b5c5f0c59b8396bcd2dd6063a1227b6838ec31"
pub val CORPUS_CASE01_WIDTH: i32 = 640
pub val CORPUS_CASE01_HEIGHT: i32 = 480
pub val CORPUS_CASE01_RGBA_SHA256: text =
    "2f4d3fb17e0a1ab65cba1f3b3950f1cf67b51f2f09df5faac247c2dc858039e9"

fn corpus_case01_expected_rgba() -> Result<[i64], text>:
    if not file_is_regular_no_follow(CORPUS_CASE01_SOURCE_PATH) or
        file_hash_sha256(CORPUS_CASE01_SOURCE_PATH) !=
            CORPUS_CASE01_SOURCE_SHA256 or
        not file_is_regular_no_follow(CORPUS_CASE01_REFERENCE_PATH) or
        file_hash_sha256(CORPUS_CASE01_REFERENCE_PATH) !=
            CORPUS_CASE01_REFERENCE_SHA256:
        return Err("corpus-case01-source-or-reference-mismatch")
    var rgba: [i64] = []
    var y = 0
    while y < CORPUS_CASE01_HEIGHT:
        var x = 0
        while x < CORPUS_CASE01_WIDTH:
            var red: i64 = 255
            var green: i64 = 255
            var blue: i64 = 255
            if x >= 20 and x < 200 and y >= 20 and y < 120:
                green = 0
                blue = 0
            elif x >= 240 and x < 340 and y >= 30 and y < 210:
                red = 0
                green = 0
            elif x >= 380 and x < 560 and y >= 50 and y < 170:
                red = 0
                blue = 0
            rgba.push(red)
            rgba.push(green)
            rgba.push(blue)
            rgba.push(255)
            x = x + 1
        y = y + 1
    if bytes_to_hex(sha256_bytes(rgba)) != CORPUS_CASE01_RGBA_SHA256:
        return Err("corpus-case01-oracle-image-digest-mismatch")
    Ok(rgba)

fn corpus_case01_capture_matches_oracle(
    capture: FinalOutputCapture) -> Result<bool, text>:
    if capture.metadata.fixture_id != CORPUS_CASE01_FIXTURE_ID or
        capture.metadata.fixture_digest != CORPUS_CASE01_SOURCE_SHA256 or
        capture.metadata.width != CORPUS_CASE01_WIDTH.to_i64() or
        capture.metadata.height != CORPUS_CASE01_HEIGHT.to_i64() or
        capture.metadata.crop_x != 0 or capture.metadata.crop_y != 0 or
        capture.metadata.crop_width != CORPUS_CASE01_WIDTH.to_i64() or
        capture.metadata.crop_height != CORPUS_CASE01_HEIGHT.to_i64():
        return Err("corpus-case01-capture-domain-mismatch")
    val expected = corpus_case01_expected_rgba()?
    val actual = match final_output_canonical_rgba(capture):
        case Ok(value): value
        case Err(error): return Err("corpus-case01-capture-" + error.code)
    if actual.len() != 1228800 or expected.len() != 1228800:
        return Err("corpus-case01-capture-length-mismatch")
    var index = 0
    while index < 1228800:
        if actual[index] != expected[index]:
            return Ok(false)
        index = index + 1
    Ok(true)

export corpus_case01_expected_rgba, corpus_case01_capture_matches_oracle
