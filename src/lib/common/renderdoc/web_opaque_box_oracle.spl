# Independent pixel oracle for the pinned 16x16 Web box fixture. The image
# comes from the authored HTML/CSS geometry, never from Web DrawIR output.

use std.fs.{read_file}
use std.io_runtime.{file_exists}
use std.common.crypto.sha256.{sha256_text, sha256_bytes}
use std.common.crypto.types.{bytes_to_hex}
use common.renderdoc.final_output_pixels.{
    FinalOutputCapture, final_output_canonical_rgba}

pub val WEB_OPAQUE_BOX_FIXTURE_ID: text = "web-opaque-box-v1"
pub val WEB_OPAQUE_BOX_FIXTURE_PATH: text =
    "test/fixtures/simple_2d_skia/web_opaque_box_v1.html"
pub val WEB_OPAQUE_BOX_FIXTURE_SHA256: text =
    "79ddcc965609652c829456fd017767b49e5970bf9c749e7012b135da06e1bd70"
pub val WEB_OPAQUE_BOX_RGBA_SHA256: text =
    "204df3a7ca11c4633399761142e60ec5f3775aefe7e91a74863f107b9b647817"

fn web_opaque_box_expected_rgba() -> Result<[i64], text>:
    if not file_exists(WEB_OPAQUE_BOX_FIXTURE_PATH) or
        sha256_text(read_file(WEB_OPAQUE_BOX_FIXTURE_PATH)) !=
            WEB_OPAQUE_BOX_FIXTURE_SHA256:
        return Err("web-opaque-box-source-mismatch")
    var rgba: [i64] = []
    var y = 0
    while y < 16:
        var x = 0
        while x < 16:
            val foreground = x >= 4 and x < 12 and y >= 4 and y < 12
            rgba.push(if foreground: 39 else: 16)
            rgba.push(if foreground: 113 else: 32)
            rgba.push(if foreground: 199 else: 48)
            rgba.push(255)
            x = x + 1
        y = y + 1
    if bytes_to_hex(sha256_bytes(rgba)) != WEB_OPAQUE_BOX_RGBA_SHA256:
        return Err("web-opaque-box-oracle-image-digest-mismatch")
    Ok(rgba)

fn web_opaque_box_capture_matches_oracle(
    capture: FinalOutputCapture) -> Result<bool, text>:
    if capture.metadata.fixture_id != WEB_OPAQUE_BOX_FIXTURE_ID or
        capture.metadata.fixture_digest != WEB_OPAQUE_BOX_FIXTURE_SHA256:
        return Err("web-opaque-box-oracle-fixture-mismatch")
    if capture.metadata.width != 16 or capture.metadata.height != 16 or
        capture.metadata.crop_x != 0 or capture.metadata.crop_y != 0 or
        capture.metadata.crop_width != 16 or capture.metadata.crop_height != 16:
        return Err("web-opaque-box-oracle-capture-extent")
    val expected = web_opaque_box_expected_rgba()?
    val actual = match final_output_canonical_rgba(capture):
        case Ok(rgba): rgba
        case Err(err): return Err("web-opaque-box-oracle-capture-" + err.code)
    if actual.len() != 1024 or expected.len() != 1024:
        return Err("web-opaque-box-oracle-capture-length")
    var index = 0
    while index < 1024:
        if actual[index] != expected[index]:
            return Ok(false)
        index = index + 1
    Ok(true)

export web_opaque_box_expected_rgba, web_opaque_box_capture_matches_oracle
