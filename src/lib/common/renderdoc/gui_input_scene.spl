# Pinned visible text-input scene for GUI producer qualification.
# Widget layout and paint still come from the real widget_tree_to_draw_ir.

use std.common.crypto.sha256.{sha256_text}
use common.ui.builder.{text_input}
use common.ui.widget.{WidgetNode}
use common.ui.widget_draw_ir.{widget_tree_to_draw_ir}
use common.ui.draw_ir.{DrawIrComposition, DRAW_IR_BACKEND_GPU}

pub val GUI_INPUT_SCENE_ID: text = "gui-input-visible-160x40-v1"
pub val GUI_INPUT_WIDGET_ID: text = "qualification-text-input"
pub val GUI_INPUT_PLACEHOLDER: text = "Type"
pub val GUI_INPUT_EXPECTED_VALUE: text = "ACB"
pub val GUI_INPUT_FONT_FAMILY: text = "Noto Sans Mono"
pub val GUI_INPUT_FONT_SHA256: text =
    "2cb2adb378a8f574213e23df697050b83c54c27df465a2015552740b2769a081"
pub val GUI_INPUT_WIDTH: i32 = 160
pub val GUI_INPUT_HEIGHT: i32 = 40
pub val GUI_INPUT_POINTER_X: i32 = 10
pub val GUI_INPUT_POINTER_Y: i32 = 10

fn gui_input_scene_widget() -> WidgetNode:
    var input = text_input(GUI_INPUT_WIDGET_ID, GUI_INPUT_PLACEHOLDER)
    input = input.set_prop("value", "")
    input = input.set_prop("caret", "0")
    input = input.set_prop("ui_focus", "false")
    input = input.set_prop("font-family", GUI_INPUT_FONT_FAMILY)
    input

fn gui_input_scene_draw_ir(input: WidgetNode) -> DrawIrComposition:
    widget_tree_to_draw_ir(
        input, GUI_INPUT_WIDTH, GUI_INPUT_HEIGHT, DRAW_IR_BACKEND_GPU
    )

fn gui_input_scene_input_sha256() -> text:
    sha256_text(
        "scene={GUI_INPUT_SCENE_ID}\n" +
        "widget={GUI_INPUT_WIDGET_ID}\n" +
        "extent={GUI_INPUT_WIDTH}x{GUI_INPUT_HEIGHT}\n" +
        "placeholder={GUI_INPUT_PLACEHOLDER}\n" +
        "font_family={GUI_INPUT_FONT_FAMILY}\n" +
        "font_sha256={GUI_INPUT_FONT_SHA256}\n" +
        "pointer={GUI_INPUT_POINTER_X},{GUI_INPUT_POINTER_Y}\n" +
        "keys=A,B,left,C\n" +
        "value={GUI_INPUT_EXPECTED_VALUE}\n" +
        "caret=2\n"
    )

export gui_input_scene_widget, gui_input_scene_draw_ir,
    gui_input_scene_input_sha256
