# codex-impl
# Bounded line codec for SimpleOS backend render receipts carried over serial.

use std.nogc_async_mut_noalloc.baremetal.common.backend_render_receipt.{
    BackendRenderReceiptHeader,
    BackendRenderReceiptEvent,
    BackendRenderReceiptTrailer,
    BackendRenderReceiptHeaderV2,
    BackendRenderReceiptEventV2,
    BackendRenderReceiptTrailerV2,
    BACKEND_RENDER_RECEIPT_V2_SCHEMA,
    BACKEND_RENDER_RECEIPT_V2_VERSION,
    BACKEND_RENDER_RECEIPT_ENDIAN_BIG,
    BACKEND_RENDER_FIRMWARE_HASHED,
    BACKEND_RENDER_FIRMWARE_NOT_APPLICABLE_DIRECT_KERNEL,
    BACKEND_RENDER_OPERATION_PRESENT,
    BACKEND_RENDER_OPERATION_INPUT_IRQ,
    BACKEND_RENDER_OPERATION_WM_APPLY,
    BACKEND_RENDER_OPERATION_DAMAGE_COMMIT,
    backend_render_receipt_header_valid,
    backend_render_receipt_event_valid,
    backend_render_receipt_trailer_valid,
    backend_render_receipt_v2_header_valid,
    backend_render_receipt_v2_event_valid,
    backend_render_receipt_v2_trailer_valid,
    backend_render_receipt_v2_header_checksum,
    backend_render_receipt_v2_event_checksum,
    backend_render_receipt_v2_trailer_checksum
}
use common.renderdoc.simpleos_render_target_evidence.{
    SimpleOsRenderTargetEvidence,
    validate_simpleos_render_target_evidence
}

val BACKEND_RENDER_RECEIPT_WIRE_PREFIX: text = "BRR1"
val BACKEND_RENDER_RECEIPT_V2_WIRE_PREFIX: text = "BRR2"
val BACKEND_RENDER_RECEIPT_MAX_SERIAL_BYTES: i64 = 1048576
val BACKEND_RENDER_RECEIPT_MAX_LINE_BYTES: i64 = 512
val BACKEND_RENDER_RECEIPT_MAX_EVENTS: i64 = 64

class BackendRenderReceiptWireParse:
    valid: bool
    code: text
    wire_version: i64
    header: BackendRenderReceiptHeader?
    events: [BackendRenderReceiptEvent]
    trailer: BackendRenderReceiptTrailer?
    header_v2: BackendRenderReceiptHeaderV2?
    events_v2: [BackendRenderReceiptEventV2]
    trailer_v2: BackendRenderReceiptTrailerV2?

fn backend_render_receipt_header_line(header: BackendRenderReceiptHeader) -> text:
    "BRR1 H {_wire_hex(header.version.to_u64())} {_wire_hex(header.arch_code.to_u64())} {_wire_hex(header.runtime_code.to_u64())} {_wire_hex(header.backend_code.to_u64())} {_wire_hex(header.firmware_hash_word0)} {_wire_hex(header.firmware_hash_word1)} {_wire_hex(header.firmware_hash_word2)} {_wire_hex(header.firmware_hash_word3)} {_wire_hex(header.boot_id)} {_wire_hex(header.frame_id)} {_wire_hex(header.surface_handle)} {_wire_hex(header.width.to_u64())} {_wire_hex(header.height.to_u64())} {_wire_hex(header.stride.to_u64())} {_wire_hex(header.format_code.to_u64())}"

fn backend_render_receipt_event_line(event: BackendRenderReceiptEvent) -> text:
    "BRR1 E {_wire_hex(event.sequence.to_u64())} {_wire_hex(event.operation_code.to_u64())} {_wire_hex(event.resource_id)} {_wire_hex(event.state_before.to_u64())} {_wire_hex(event.state_after.to_u64())} {_wire_hex(event.value_hash)}"

fn backend_render_receipt_trailer_line(trailer: BackendRenderReceiptTrailer) -> text:
    val complete = if trailer.frame_complete: 1 else: 0
    "BRR1 T {_wire_hex(trailer.event_count.to_u64())} {_wire_hex(complete.to_u64())} {_wire_hex(trailer.pixel_hash_word0)} {_wire_hex(trailer.pixel_hash_word1)} {_wire_hex(trailer.pixel_hash_word2)} {_wire_hex(trailer.pixel_hash_word3)} {_wire_hex(trailer.nonblank_pixel_count)} {_wire_hex(trailer.reason_code.to_u64())}"

fn backend_render_receipt_v2_header_line(header: BackendRenderReceiptHeaderV2) -> text:
    "BRR2 H {_wire_hex(200u64)} {_wire_hex(header.schema_code.to_u64())} {_wire_hex(header.version.to_u64())} {_wire_hex(header.endian_code.to_u64())} {_wire_hex(header.arch_code.to_u64())} {_wire_hex(header.runtime_code.to_u64())} {_wire_hex(header.backend_code.to_u64())} {_wire_hex(header.firmware_status_code.to_u64())} {_wire_hex(header.firmware_hash_word0)} {_wire_hex(header.firmware_hash_word1)} {_wire_hex(header.firmware_hash_word2)} {_wire_hex(header.firmware_hash_word3)} {_wire_hex(header.source_identity_hash_word0)} {_wire_hex(header.source_identity_hash_word1)} {_wire_hex(header.source_identity_hash_word2)} {_wire_hex(header.source_identity_hash_word3)} {_wire_hex(header.source_revision_word0)} {_wire_hex(header.source_revision_word1)} {_wire_hex(header.source_revision_word2)} {_wire_hex(header.source_revision_nibbles.to_u64())} {_wire_hex(header.boot_id)} {_wire_hex(header.surface_handle)} {_wire_hex(header.width.to_u64())} {_wire_hex(header.height.to_u64())} {_wire_hex(header.stride.to_u64())} {_wire_hex(header.format_code.to_u64())} {_wire_hex(backend_render_receipt_v2_header_checksum(header))}"

fn backend_render_receipt_v2_event_line(event: BackendRenderReceiptEventV2) -> text:
    "BRR2 E {_wire_hex(112u64)} {_wire_hex(event.boot_id)} {_wire_hex(event.source_identity_hash_word0)} {_wire_hex(event.source_identity_hash_word1)} {_wire_hex(event.source_identity_hash_word2)} {_wire_hex(event.source_identity_hash_word3)} {_wire_hex(event.input_sequence)} {_wire_hex(event.operation_code.to_u64())} {_wire_hex(event.frame_id)} {_wire_hex(event.rendered_revision)} {_wire_hex(event.monotonic_event_us)} {_wire_hex(event.resource_id)} {_wire_hex(event.state_before.to_u64())} {_wire_hex(event.state_after.to_u64())} {_wire_hex(event.value_hash)} {_wire_hex(backend_render_receipt_v2_event_checksum(event))}"

fn backend_render_receipt_v2_trailer_line(trailer: BackendRenderReceiptTrailerV2) -> text:
    val complete = if trailer.frame_complete: 1 else: 0
    "BRR2 T {_wire_hex(104u64)} {_wire_hex(trailer.boot_id)} {_wire_hex(trailer.source_identity_hash_word0)} {_wire_hex(trailer.source_identity_hash_word1)} {_wire_hex(trailer.source_identity_hash_word2)} {_wire_hex(trailer.source_identity_hash_word3)} {_wire_hex(trailer.event_count.to_u64())} {_wire_hex(complete.to_u64())} {_wire_hex(trailer.pixel_hash_word0)} {_wire_hex(trailer.pixel_hash_word1)} {_wire_hex(trailer.pixel_hash_word2)} {_wire_hex(trailer.pixel_hash_word3)} {_wire_hex(trailer.nonblank_pixel_count)} {_wire_hex(trailer.reason_code.to_u64())} {_wire_hex(backend_render_receipt_v2_trailer_checksum(trailer))}"

fn backend_render_capture_control_line(
    kind: text,
    boot_id: u64,
    frame_id: u64
) -> text:
    if kind != "W" and kind != "A" and kind != "K":
        return ""
    "BRC1 {kind} {_wire_hex(boot_id)} {_wire_hex(frame_id)}"

fn backend_render_capture_ack_line(boot_id: u64, frame_id: u64) -> text:
    backend_render_capture_control_line("A", boot_id, frame_id)

fn _wire_invalid(code: text) -> BackendRenderReceiptWireParse:
    BackendRenderReceiptWireParse(
        valid: false, code: code, wire_version: 0, header: nil, events: [],
        trailer: nil, header_v2: nil, events_v2: [], trailer_v2: nil)

fn _wire_valid(
    header: BackendRenderReceiptHeader,
    events: [BackendRenderReceiptEvent],
    trailer: BackendRenderReceiptTrailer
) -> BackendRenderReceiptWireParse:
    BackendRenderReceiptWireParse(
        valid: true, code: "pass", wire_version: 1, header: Some(header),
        events: events, trailer: Some(trailer), header_v2: nil, events_v2: [],
        trailer_v2: nil)

fn _wire_valid_v2(
    header: BackendRenderReceiptHeaderV2,
    events: [BackendRenderReceiptEventV2],
    trailer: BackendRenderReceiptTrailerV2
) -> BackendRenderReceiptWireParse:
    BackendRenderReceiptWireParse(
        valid: true, code: "pass", wire_version: 2, header: nil, events: [],
        trailer: nil, header_v2: Some(header), events_v2: events,
        trailer_v2: Some(trailer))

fn _wire_hex(value: u64) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    var index: i64 = 0
    while index < 16:
        val shift = (15 - index) * 4
        val digit = ((value >> shift) & 15u64).to_i64()
        out = out + digits[digit].to_text()
        index = index + 1
    out

fn backend_render_receipt_v2_source_revision(
    header: BackendRenderReceiptHeaderV2
) -> text:
    if header.source_revision_nibbles == 10u32:
        return _wire_hex(header.source_revision_word0).slice(6, 16)
    if header.source_revision_nibbles == 40u32:
        return _wire_hex(header.source_revision_word0) +
            _wire_hex(header.source_revision_word1) +
            _wire_hex(header.source_revision_word2).slice(8, 16)
    ""

fn backend_render_receipt_v2_source_identity_hash(
    header: BackendRenderReceiptHeaderV2
) -> text:
    _wire_hex(header.source_identity_hash_word0) +
        _wire_hex(header.source_identity_hash_word1) +
        _wire_hex(header.source_identity_hash_word2) +
        _wire_hex(header.source_identity_hash_word3)

fn _wire_hex_value(value: text) -> Result<u64, text>:
    if value.len() != 16:
        return Err("invalid-width")
    var parsed: u64 = 0u64
    val digits = "0123456789abcdef"
    for character in value:
        val digit = digits.index_of(character.to_text())
        if digit < 0:
            return Err("invalid-hex")
        parsed = (parsed << 4) | digit.to_u64()
    Ok(parsed)

fn _wire_numbers(parts: [text], start: i64, count: i64) -> Result<[u64], text>:
    if parts.len() != start + count:
        return Err("field-count")
    var out: [u64] = []
    var index = start
    while index < parts.len():
        out.push(_wire_hex_value(parts[index])?)
        index = index + 1
    Ok(out)

fn _wire_u32(value: u64) -> Result<u32, text>:
    if value > 0xffffffffu64:
        return Err("u32-overflow")
    Ok(value.to_u32())

fn _wire_parse_header(parts: [text]) -> Result<BackendRenderReceiptHeader, text>:
    val values = _wire_numbers(parts, 2, 15)?
    val header = BackendRenderReceiptHeader(
        version: _wire_u32(values[0])?,
        arch_code: _wire_u32(values[1])?,
        runtime_code: _wire_u32(values[2])?,
        backend_code: _wire_u32(values[3])?,
        firmware_hash_word0: values[4],
        firmware_hash_word1: values[5],
        firmware_hash_word2: values[6],
        firmware_hash_word3: values[7],
        boot_id: values[8],
        frame_id: values[9],
        surface_handle: values[10],
        width: _wire_u32(values[11])?,
        height: _wire_u32(values[12])?,
        stride: _wire_u32(values[13])?,
        format_code: _wire_u32(values[14])?)
    if not backend_render_receipt_header_valid(header):
        return Err("invalid-header")
    Ok(header)

fn _wire_parse_event(parts: [text], expected_sequence: u32) -> Result<BackendRenderReceiptEvent, text>:
    val values = _wire_numbers(parts, 2, 6)?
    val event = BackendRenderReceiptEvent(
        sequence: _wire_u32(values[0])?,
        operation_code: _wire_u32(values[1])?,
        resource_id: values[2],
        state_before: _wire_u32(values[3])?,
        state_after: _wire_u32(values[4])?,
        value_hash: values[5])
    if not backend_render_receipt_event_valid(event, expected_sequence):
        return Err("invalid-event")
    Ok(event)

fn _wire_parse_trailer(parts: [text], observed_events: u32) -> Result<BackendRenderReceiptTrailer, text>:
    val values = _wire_numbers(parts, 2, 8)?
    if values[1] > 1u64:
        return Err("invalid-completion")
    val trailer = BackendRenderReceiptTrailer(
        event_count: _wire_u32(values[0])?,
        frame_complete: values[1] == 1u64,
        pixel_hash_word0: values[2],
        pixel_hash_word1: values[3],
        pixel_hash_word2: values[4],
        pixel_hash_word3: values[5],
        nonblank_pixel_count: values[6],
        reason_code: _wire_u32(values[7])?)
    if not backend_render_receipt_trailer_valid(trailer, observed_events):
        return Err("invalid-trailer")
    Ok(trailer)

fn _wire_parse_v2_header(parts: [text]) -> Result<BackendRenderReceiptHeaderV2, text>:
    val values = _wire_numbers(parts, 2, 27)?
    if values[0] != 200u64:
        return Err("invalid-record-length")
    val header = BackendRenderReceiptHeaderV2(
        schema_code: _wire_u32(values[1])?,
        version: _wire_u32(values[2])?,
        endian_code: _wire_u32(values[3])?,
        arch_code: _wire_u32(values[4])?,
        runtime_code: _wire_u32(values[5])?,
        backend_code: _wire_u32(values[6])?,
        firmware_status_code: _wire_u32(values[7])?,
        firmware_hash_word0: values[8],
        firmware_hash_word1: values[9],
        firmware_hash_word2: values[10],
        firmware_hash_word3: values[11],
        source_identity_hash_word0: values[12],
        source_identity_hash_word1: values[13],
        source_identity_hash_word2: values[14],
        source_identity_hash_word3: values[15],
        source_revision_word0: values[16],
        source_revision_word1: values[17],
        source_revision_word2: values[18],
        source_revision_nibbles: _wire_u32(values[19])?,
        boot_id: values[20],
        surface_handle: values[21],
        width: _wire_u32(values[22])?,
        height: _wire_u32(values[23])?,
        stride: _wire_u32(values[24])?,
        format_code: _wire_u32(values[25])?)
    if values[26] != backend_render_receipt_v2_header_checksum(header):
        return Err("checksum-mismatch")
    if not backend_render_receipt_v2_header_valid(header):
        if header.schema_code != BACKEND_RENDER_RECEIPT_V2_SCHEMA:
            return Err("unknown-schema")
        if header.version != BACKEND_RENDER_RECEIPT_V2_VERSION:
            return Err("unknown-version")
        if header.endian_code != BACKEND_RENDER_RECEIPT_ENDIAN_BIG:
            return Err("unknown-endian")
        if (header.firmware_status_code != BACKEND_RENDER_FIRMWARE_HASHED and
            header.firmware_status_code !=
                BACKEND_RENDER_FIRMWARE_NOT_APPLICABLE_DIRECT_KERNEL):
            return Err("unknown-firmware-status")
        return Err("invalid-header")
    Ok(header)

fn _wire_parse_v2_event(
    parts: [text],
    expected_input_sequence: u64,
    expected_operation_code: u32
) -> Result<BackendRenderReceiptEventV2, text>:
    val values = _wire_numbers(parts, 2, 16)?
    if values[0] != 112u64:
        return Err("invalid-record-length")
    val event = BackendRenderReceiptEventV2(
        boot_id: values[1],
        source_identity_hash_word0: values[2],
        source_identity_hash_word1: values[3],
        source_identity_hash_word2: values[4],
        source_identity_hash_word3: values[5],
        input_sequence: values[6],
        operation_code: _wire_u32(values[7])?,
        frame_id: values[8],
        rendered_revision: values[9],
        monotonic_event_us: values[10],
        resource_id: values[11],
        state_before: _wire_u32(values[12])?,
        state_after: _wire_u32(values[13])?,
        value_hash: values[14])
    if values[15] != backend_render_receipt_v2_event_checksum(event):
        return Err("checksum-mismatch")
    if (event.operation_code != BACKEND_RENDER_OPERATION_INPUT_IRQ and
        event.operation_code != BACKEND_RENDER_OPERATION_WM_APPLY and
        event.operation_code != BACKEND_RENDER_OPERATION_DAMAGE_COMMIT and
        event.operation_code != BACKEND_RENDER_OPERATION_PRESENT):
        return Err("unknown-operation")
    if not backend_render_receipt_v2_event_valid(
        event, expected_input_sequence, expected_operation_code):
        return Err("invalid-event")
    Ok(event)

fn _wire_parse_v2_trailer(
    parts: [text],
    observed_events: u32
) -> Result<BackendRenderReceiptTrailerV2, text>:
    val values = _wire_numbers(parts, 2, 15)?
    if values[0] != 104u64:
        return Err("invalid-record-length")
    if values[7] > 1u64:
        return Err("invalid-completion")
    val trailer = BackendRenderReceiptTrailerV2(
        boot_id: values[1],
        source_identity_hash_word0: values[2],
        source_identity_hash_word1: values[3],
        source_identity_hash_word2: values[4],
        source_identity_hash_word3: values[5],
        event_count: _wire_u32(values[6])?,
        frame_complete: values[7] == 1u64,
        pixel_hash_word0: values[8],
        pixel_hash_word1: values[9],
        pixel_hash_word2: values[10],
        pixel_hash_word3: values[11],
        nonblank_pixel_count: values[12],
        reason_code: _wire_u32(values[13])?)
    if values[14] != backend_render_receipt_v2_trailer_checksum(trailer):
        return Err("checksum-mismatch")
    if not backend_render_receipt_v2_trailer_valid(trailer, observed_events):
        return Err("invalid-trailer")
    Ok(trailer)

fn _wire_v2_expected_operation(event_index: i64) -> u32:
    if event_index == 0: return BACKEND_RENDER_OPERATION_INPUT_IRQ
    if event_index == 1: return BACKEND_RENDER_OPERATION_WM_APPLY
    if event_index == 2: return BACKEND_RENDER_OPERATION_DAMAGE_COMMIT
    if event_index == 3: return BACKEND_RENDER_OPERATION_PRESENT
    0u32

fn _wire_v2_event_identity_matches(
    header: BackendRenderReceiptHeaderV2,
    event: BackendRenderReceiptEventV2
) -> bool:
    event.boot_id == header.boot_id and
        event.source_identity_hash_word0 == header.source_identity_hash_word0 and
        event.source_identity_hash_word1 == header.source_identity_hash_word1 and
        event.source_identity_hash_word2 == header.source_identity_hash_word2 and
        event.source_identity_hash_word3 == header.source_identity_hash_word3

fn _wire_v2_trailer_identity_matches(
    header: BackendRenderReceiptHeaderV2,
    trailer: BackendRenderReceiptTrailerV2
) -> bool:
    trailer.boot_id == header.boot_id and
        trailer.source_identity_hash_word0 == header.source_identity_hash_word0 and
        trailer.source_identity_hash_word1 == header.source_identity_hash_word1 and
        trailer.source_identity_hash_word2 == header.source_identity_hash_word2 and
        trailer.source_identity_hash_word3 == header.source_identity_hash_word3

fn parse_backend_render_receipt_wire(serial_output: text) -> BackendRenderReceiptWireParse:
    if serial_output.len().to_i64() > BACKEND_RENDER_RECEIPT_MAX_SERIAL_BYTES:
        return _wire_invalid("serial-too-large")
    var header: BackendRenderReceiptHeader? = nil
    var events: [BackendRenderReceiptEvent] = []
    var trailer: BackendRenderReceiptTrailer? = nil
    var header_v2: BackendRenderReceiptHeaderV2? = nil
    var events_v2: [BackendRenderReceiptEventV2] = []
    var trailer_v2: BackendRenderReceiptTrailerV2? = nil
    var wire_version = 0
    var state = 0
    var record_count: i64 = 0
    for raw_line in serial_output.split("\n"):
        val line = raw_line.trim_end()
        val is_v1 = line.starts_with(BACKEND_RENDER_RECEIPT_WIRE_PREFIX + " ")
        val is_v2 = line.starts_with(BACKEND_RENDER_RECEIPT_V2_WIRE_PREFIX + " ")
        if line.starts_with("BRR") and not is_v1 and not is_v2:
            return _wire_invalid("unknown-version")
        if not is_v1 and not is_v2:
            continue
        val line_version = if is_v2: 2 else: 1
        if wire_version != 0 and wire_version != line_version:
            return _wire_invalid("mixed-wire-version")
        wire_version = line_version
        if line.len().to_i64() > BACKEND_RENDER_RECEIPT_MAX_LINE_BYTES:
            return _wire_invalid("line-too-large")
        record_count = record_count + 1
        if record_count > BACKEND_RENDER_RECEIPT_MAX_EVENTS + 2:
            return _wire_invalid("too-many-records")
        val parts = line.split(" ")
        if parts.len() < 2:
            return _wire_invalid("malformed-record")
        if is_v1 and parts[1] == "H":
            if state != 0:
                return _wire_invalid("duplicate-or-reordered-header")
            match _wire_parse_header(parts):
                Ok(value):
                    header = Some(value)
                    state = 1
                Err(code): return _wire_invalid(code)
        elif is_v1 and parts[1] == "E":
            if state != 1:
                return _wire_invalid("event-out-of-order")
            if events.len().to_i64() >= BACKEND_RENDER_RECEIPT_MAX_EVENTS:
                return _wire_invalid("too-many-events")
            match _wire_parse_event(parts, (events.len() + 1).to_u32()):
                Ok(value): events.push(value)
                Err(code): return _wire_invalid(code)
        elif is_v1 and parts[1] == "T":
            if state != 1:
                return _wire_invalid("trailer-out-of-order")
            match _wire_parse_trailer(parts, events.len().to_u32()):
                Ok(value):
                    trailer = Some(value)
                    state = 2
                Err(code): return _wire_invalid(code)
        elif is_v2 and parts[1] == "H":
            if state != 0:
                return _wire_invalid("duplicate-or-reordered-header")
            match _wire_parse_v2_header(parts):
                Ok(value):
                    header_v2 = Some(value)
                    state = 1
                Err(code): return _wire_invalid(code)
        elif is_v2 and parts[1] == "E":
            if state != 1:
                return _wire_invalid("event-out-of-order")
            if events_v2.len().to_i64() >= 4:
                return _wire_invalid("too-many-events")
            val expected_sequence = if events_v2.len() == 0:
                0u64
            else:
                events_v2[0].input_sequence
            match _wire_parse_v2_event(
                parts, expected_sequence,
                _wire_v2_expected_operation(events_v2.len().to_i64())):
                Ok(value):
                    if val Some(identity_header) = header_v2:
                        if not _wire_v2_event_identity_matches(
                            identity_header, value):
                            return _wire_invalid("receipt-identity-mismatch")
                    else:
                        return _wire_invalid("truncated-receipt")
                    if events_v2.len() > 0:
                        val previous = events_v2[events_v2.len() - 1]
                        if (value.frame_id != previous.frame_id or
                            value.rendered_revision != previous.rendered_revision):
                            return _wire_invalid("event-correlation-mismatch")
                        if value.monotonic_event_us <= previous.monotonic_event_us:
                            return _wire_invalid("nonmonotonic-event-time")
                    events_v2.push(value)
                Err(code): return _wire_invalid(code)
        elif is_v2 and parts[1] == "T":
            if state != 1:
                return _wire_invalid("trailer-out-of-order")
            match _wire_parse_v2_trailer(parts, events_v2.len().to_u32()):
                Ok(value):
                    if val Some(identity_header) = header_v2:
                        if not _wire_v2_trailer_identity_matches(
                            identity_header, value):
                            return _wire_invalid("receipt-identity-mismatch")
                    else:
                        return _wire_invalid("truncated-receipt")
                    trailer_v2 = Some(value)
                    state = 2
                Err(code): return _wire_invalid(code)
        else:
            return _wire_invalid("unknown-record-kind")
    if state != 2:
        return _wire_invalid("truncated-receipt")
    if wire_version == 1:
        if val Some(final_header) = header:
            if val Some(final_trailer) = trailer:
                return _wire_valid(final_header, events, final_trailer)
    elif wire_version == 2:
        if val Some(final_header_v2) = header_v2:
            if val Some(final_trailer_v2) = trailer_v2:
                return _wire_valid_v2(
                    final_header_v2, events_v2, final_trailer_v2)
    _wire_invalid("truncated-receipt")

fn backend_render_receipt_capture_identity_status(
    parsed: BackendRenderReceiptWireParse,
    capture_boot_id: u64,
    capture_frame_id: u64,
    capture_surface_handle: u64
) -> text:
    if not parsed.valid:
        return parsed.code
    if val Some(header) = parsed.header:
        if header.boot_id != capture_boot_id or header.frame_id != capture_frame_id:
            return "frame-correlation-mismatch"
        if header.surface_handle != capture_surface_handle:
            return "surface-correlation-mismatch"
        return "pass"
    if val Some(header_v2) = parsed.header_v2:
        if parsed.events_v2.len() != 4:
            return "truncated-receipt"
        val present = parsed.events_v2[3]
        if (header_v2.boot_id != capture_boot_id or
            present.frame_id != capture_frame_id):
            return "frame-correlation-mismatch"
        if header_v2.surface_handle != capture_surface_handle:
            return "surface-correlation-mismatch"
        return "pass"
    "truncated-receipt"

fn backend_render_receipt_target_status(
    parsed: BackendRenderReceiptWireParse,
    evidence: SimpleOsRenderTargetEvidence
) -> text:
    if not parsed.valid:
        return parsed.code
    val target_validation = validate_simpleos_render_target_evidence(evidence)
    if not target_validation.valid:
        return target_validation.code
    if val Some(header) = parsed.header:
        if val Some(trailer) = parsed.trailer:
            val firmware_hash = _wire_hex(header.firmware_hash_word0) +
                _wire_hex(header.firmware_hash_word1) +
                _wire_hex(header.firmware_hash_word2) +
                _wire_hex(header.firmware_hash_word3)
            val pixel_hash = _wire_hex(trailer.pixel_hash_word0) +
                _wire_hex(trailer.pixel_hash_word1) +
                _wire_hex(trailer.pixel_hash_word2) +
                _wire_hex(trailer.pixel_hash_word3)
            if evidence.firmware_hash != firmware_hash:
                return "firmware-correlation-mismatch"
            if (evidence.boot_id != header.boot_id.to_text() or
                evidence.frame_id != header.frame_id.to_text() or
                evidence.capture_boot_id != header.boot_id.to_text() or
                evidence.capture_frame_id != header.frame_id.to_text()):
                return "frame-correlation-mismatch"
            if evidence.surface_handle.to_u64() != header.surface_handle:
                return "surface-correlation-mismatch"
            if (evidence.width.to_u64() != header.width.to_u64() or
                evidence.height.to_u64() != header.height.to_u64() or
                evidence.stride.to_u64() != header.stride.to_u64()):
                return "dimension-correlation-mismatch"
            if (evidence.guest_pixel_hash != pixel_hash or
                evidence.capture_pixel_hash != pixel_hash):
                return "pixel-correlation-mismatch"
            return "pass"
    if val Some(header_v2) = parsed.header_v2:
        if val Some(trailer_v2) = parsed.trailer_v2:
            if parsed.events_v2.len() != 4:
                return "truncated-receipt"
            val present = parsed.events_v2[3]
            val firmware_hash = _wire_hex(header_v2.firmware_hash_word0) +
                _wire_hex(header_v2.firmware_hash_word1) +
                _wire_hex(header_v2.firmware_hash_word2) +
                _wire_hex(header_v2.firmware_hash_word3)
            val source_identity_hash =
                backend_render_receipt_v2_source_identity_hash(header_v2)
            val pixel_hash = _wire_hex(trailer_v2.pixel_hash_word0) +
                _wire_hex(trailer_v2.pixel_hash_word1) +
                _wire_hex(trailer_v2.pixel_hash_word2) +
                _wire_hex(trailer_v2.pixel_hash_word3)
            if evidence.firmware_status_code.to_u64() !=
               header_v2.firmware_status_code.to_u64():
                return "firmware-status-correlation-mismatch"
            if evidence.firmware_hash != firmware_hash:
                return "firmware-correlation-mismatch"
            if evidence.source_identity_hash != source_identity_hash:
                return "source-identity-correlation-mismatch"
            if evidence.source_revision !=
               backend_render_receipt_v2_source_revision(header_v2):
                return "source-revision-correlation-mismatch"
            if (evidence.boot_id != header_v2.boot_id.to_text() or
                evidence.frame_id != present.frame_id.to_text() or
                evidence.capture_boot_id != header_v2.boot_id.to_text() or
                evidence.capture_frame_id != present.frame_id.to_text()):
                return "frame-correlation-mismatch"
            if evidence.present_sequence.to_u64() != present.input_sequence:
                return "input-correlation-mismatch"
            if evidence.surface_handle.to_u64() != header_v2.surface_handle:
                return "surface-correlation-mismatch"
            if (evidence.width.to_u64() != header_v2.width.to_u64() or
                evidence.height.to_u64() != header_v2.height.to_u64() or
                evidence.stride.to_u64() != header_v2.stride.to_u64()):
                return "dimension-correlation-mismatch"
            if (evidence.guest_pixel_hash != pixel_hash or
                evidence.capture_pixel_hash != pixel_hash):
                return "pixel-correlation-mismatch"
            return "pass"
    "truncated-receipt"
