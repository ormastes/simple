# Independent pixels for the pinned 640x480 HTML/CSS corpus case 06.
# The clipped cyan rectangle comes from authored CSS and its reference,
# never from the Web producer's DrawIR or either Vulkan backend.

use std.nogc_sync_mut.io.file_ops.{
    file_is_regular_no_follow, file_hash_sha256}
use std.common.crypto.sha256.{sha256_bytes}
use std.common.crypto.types.{bytes_to_hex}
use common.renderdoc.final_output_pixels.{
    FinalOutputCapture, final_output_canonical_rgba}

pub val CORPUS_CASE06_FIXTURE_ID: text = "corpus-06-rectangular-clip-v1"
pub val CORPUS_CASE06_SOURCE_PATH: text =
    "test/fixtures/html_css/corpus/cases/06-rectangular-clip.html"
pub val CORPUS_CASE06_SOURCE_SHA256: text =
    "2c4677447453c4576f559a380d6585c3ddd1e14abbef7c77ac40a33dc1732000"
pub val CORPUS_CASE06_REFERENCE_PATH: text =
    "test/fixtures/html_css/corpus/references/06-rectangular-clip.html"
pub val CORPUS_CASE06_REFERENCE_SHA256: text =
    "ce0a659f466f71494f6672b44ecf4ad7f239652837ac33da78d8d2bb84a558c2"
pub val CORPUS_CASE06_WIDTH: i32 = 640
pub val CORPUS_CASE06_HEIGHT: i32 = 480
pub val CORPUS_CASE06_RGBA_SHA256: text =
    "0372ef52c5e58dfa59d71239609526592e022a00419f25e3eebc902d083debb1"

fn corpus_case06_expected_rgba() -> Result<[i64], text>:
    if not file_is_regular_no_follow(CORPUS_CASE06_SOURCE_PATH) or
        file_hash_sha256(CORPUS_CASE06_SOURCE_PATH) !=
            CORPUS_CASE06_SOURCE_SHA256 or
        not file_is_regular_no_follow(CORPUS_CASE06_REFERENCE_PATH) or
        file_hash_sha256(CORPUS_CASE06_REFERENCE_PATH) !=
            CORPUS_CASE06_REFERENCE_SHA256:
        return Err("corpus-case06-source-or-reference-mismatch")
    var rgba: [i64] = []
    var y = 0
    while y < CORPUS_CASE06_HEIGHT:
        var x = 0
        while x < CORPUS_CASE06_WIDTH:
            if x >= 80 and x < 200 and y >= 65 and y < 140:
                rgba.push(0)
                rgba.push(170)
                rgba.push(255)
            else:
                rgba.push(255)
                rgba.push(255)
                rgba.push(255)
            rgba.push(255)
            x = x + 1
        y = y + 1
    if bytes_to_hex(sha256_bytes(rgba)) != CORPUS_CASE06_RGBA_SHA256:
        return Err("corpus-case06-oracle-image-digest-mismatch")
    Ok(rgba)

fn corpus_case06_capture_matches_oracle(
    capture: FinalOutputCapture) -> Result<bool, text>:
    if capture.metadata.fixture_id != CORPUS_CASE06_FIXTURE_ID or
        capture.metadata.fixture_digest != CORPUS_CASE06_SOURCE_SHA256 or
        capture.metadata.width != CORPUS_CASE06_WIDTH.to_i64() or
        capture.metadata.height != CORPUS_CASE06_HEIGHT.to_i64() or
        capture.metadata.crop_x != 0 or capture.metadata.crop_y != 0 or
        capture.metadata.crop_width != CORPUS_CASE06_WIDTH.to_i64() or
        capture.metadata.crop_height != CORPUS_CASE06_HEIGHT.to_i64():
        return Err("corpus-case06-capture-domain-mismatch")
    val expected = corpus_case06_expected_rgba()?
    val actual = match final_output_canonical_rgba(capture):
        case Ok(value): value
        case Err(error): return Err("corpus-case06-capture-" + error.code)
    if actual.len() != 1228800 or expected.len() != 1228800:
        return Err("corpus-case06-capture-length-mismatch")
    var index = 0
    while index < 1228800:
        if actual[index] != expected[index]:
            return Ok(false)
        index = index + 1
    Ok(true)

export corpus_case06_expected_rgba, corpus_case06_capture_matches_oracle
