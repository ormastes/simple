# Pinned GUI source scene for the physical Vulkan qualification lane.
# Both states pass through the real widget layout and DrawIR producer.

use std.common.crypto.sha256.{sha256_text}
use common.ui.builder.{button}
use common.ui.theme_render_snapshot.{
    ThemeMaterialSemantics, ThemeRenderSnapshot, theme_material_sha256}
use common.ui.draw_ir.{DrawIrComposition, DRAW_IR_BACKEND_GPU}
use common.ui.widget_draw_ir.{widget_tree_to_draw_ir_with_theme}

pub val GUI_BUTTON_SCENE_ID: text = "gui-button-16x16-v1"
pub val GUI_BUTTON_WIDGET_ID: text = "qualification-button"
pub val GUI_BUTTON_LABEL: text = ""
pub val GUI_BUTTON_ACTION: text = "activate"
pub val GUI_BUTTON_SURFACE_ARGB: u32 = 0xFF101820u32
pub val GUI_BUTTON_RESTING_ARGB: u32 = 0xFF2771C7u32
pub val GUI_BUTTON_PRESSED_ARGB: u32 = 0xFF2D5A88u32

fn gui_button_qualification_theme() -> ThemeRenderSnapshot:
    # These opaque roles are fixed fixture input. The producer still resolves
    # the button's normal/pressed roles through ThemeRenderSnapshot.
    val material = ThemeMaterialSemantics(
        desktop_fill_rgba: GUI_BUTTON_SURFACE_ARGB,
        window_fill_rgba: GUI_BUTTON_SURFACE_ARGB,
        active_title_fill_rgba: GUI_BUTTON_RESTING_ARGB,
        inactive_title_fill_rgba: GUI_BUTTON_PRESSED_ARGB,
        surface_alpha_milli: 1000,
        backdrop_blur_px: 0,
        backdrop_saturation_milli: 1000,
        border_width_px: 0,
        border_rgba: GUI_BUTTON_SURFACE_ARGB,
        corner_radius_px: 0,
        active_shadows: [], inactive_shadows: [],
        font_family: "", font_size_px: 0, font_weight: 0,
        text_rgba: GUI_BUTTON_SURFACE_ARGB,
        secondary_text_rgba: GUI_BUTTON_SURFACE_ARGB,
        solid_fallback_rgba: GUI_BUTTON_SURFACE_ARGB,
        fallback_contrast_milli: 1000,
        window_gradient_available: false,
        window_gradient_start_rgba: GUI_BUTTON_SURFACE_ARGB,
        window_gradient_end_rgba: GUI_BUTTON_SURFACE_ARGB,
        window_gradient_source_css: ""
    )
    val material_sha = theme_material_sha256(material)
    val theme_input_sha = sha256_text(
        "scene={GUI_BUTTON_SCENE_ID}\n" +
        "widget={GUI_BUTTON_WIDGET_ID}\n" +
        "extent=16x16\n" +
        "surface_argb={GUI_BUTTON_SURFACE_ARGB}\n" +
        "resting_argb={GUI_BUTTON_RESTING_ARGB}\n" +
        "pressed_argb={GUI_BUTTON_PRESSED_ARGB}\n" +
        "material_sha256={material_sha}\n"
    )
    ThemeRenderSnapshot(
        id: GUI_BUTTON_SCENE_ID, family_id: "qualification",
        source_reference: "common.renderdoc.gui_button_scene",
        source_manifest_sha256: theme_input_sha,
        material_sha256: material_sha, composed_css: "",
        background_rgba: GUI_BUTTON_SURFACE_ARGB,
        foreground_rgba: GUI_BUTTON_SURFACE_ARGB,
        accent_rgba: GUI_BUTTON_RESTING_ARGB,
        material: material
    )

fn gui_button_fixture_scene(pressed: bool) -> DrawIrComposition:
    var root = button(GUI_BUTTON_WIDGET_ID, GUI_BUTTON_LABEL,
        GUI_BUTTON_ACTION)
    root = root.set_prop("ui_pressed", if pressed: "true" else: "false")
    widget_tree_to_draw_ir_with_theme(
        root, 16, 16, DRAW_IR_BACKEND_GPU, gui_button_qualification_theme())

fn gui_button_scene_input_sha256(pressed: bool) -> text:
    val theme = gui_button_qualification_theme()
    val state = if pressed: "true" else: "false"
    sha256_text("{theme.source_manifest_sha256}\n" +
        "widget={GUI_BUTTON_WIDGET_ID}\n" +
        "label={GUI_BUTTON_LABEL}\n" +
        "action={GUI_BUTTON_ACTION}\n" +
        "pressed={state}\n")

export gui_button_qualification_theme, gui_button_fixture_scene,
    gui_button_scene_input_sha256
