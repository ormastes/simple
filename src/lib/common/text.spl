# Common text utilities

val NL = "\n"

fn parse_i64(s: text) -> i64:
    s.trim().parse_int() ?? -1

fn trim(s: text) -> text:
    s.trim()

fn is_empty(s: text) -> bool:
    s.len() == 0

fn _json_escape_of(ch: text, code: i64) -> text:
    val hex = "0123456789abcdef"
    if ch == "\"": return "\\\""
    if ch == "\\": return "\\\\"
    if code == 8: return "\\b"
    if code == 12: return "\\f"
    if ch == "\n": return "\\n"
    if ch == "\r": return "\\r"
    if ch == "\t": return "\\t"
    "\\u00" + hex.char_at(code / 16) + hex.char_at(code % 16)

# Run-copying escape: clean byte runs are copied with one substring instead of
# per-char `result = result + ch` (which re-clones the whole result each
# iteration, O(n^2)). Byte offsets are tracked separately because substring/len
# are byte-indexed while chars() is char-indexed.
fn escape_json(s: text) -> text:
    val cs = s.chars()
    val n = cs.len()
    var parts = []
    var run_start = 0
    var bo = 0
    var i = 0
    while i < n:
        val ch = cs[i]
        val code = ch.char_code_at(0)
        if code < 32 or ch == "\"" or ch == "\\":
            if bo > run_start:
                parts.push(s.substring(run_start, bo))
            parts.push(_json_escape_of(ch, code))
            run_start = bo + ch.len()
        bo = bo + ch.len()
        i = i + 1
    if parts.len() == 0: return s
    if bo > run_start:
        parts.push(s.substring(run_start, bo))
    parts.join("")

fn not_empty(s: text) -> bool:
    s.len() > 0

# Direct scan, NOT `s.contains(sub)`: under the seed interpreter UFCS resolves
# that method call back to this free function (infinite recursion, depth-1000
# overflow in MIR lowering — 2026-07-24 NVMe rv32 gate).
fn contains(s: text, sub: text) -> bool:
    if sub.len() == 0: return true
    s.index_of(sub) >= 0

export parse_i64, trim, is_empty, not_empty, contains, escape_json, NL
