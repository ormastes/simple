# Stage-4 compiler provenance parsing and admission checks for x25519/ML-KEM flows.
#
# The format is an env-like "key=value" text envelope where duplicate keys are
# rejected and all values are consumed as-is with strict field validation.

mod lib.common.provenance.stage4_compiler_provenance

val _STAGE4_COMPILER_PROVENANCE_SCHEMA_V1 = "simple-bootstrap-stage4-provenance-v1"
val _STAGE4_COMPILER_PROVENANCE_SCHEMA_V2 = "simple-bootstrap-stage4-provenance-v2"
val _STAGE4_COMPILER_PROVENANCE_REQUIRED_ROOTS =
    "src/compiler:src/lib:src/app:src/runtime:examples/10_tooling"

class Stage4CompilerProvenance:
    schema: text
    status: text
    artifact_kind: text
    output_path: text
    output_sha256: text
    source_revision_kind: text
    source_revision: text
    source_roots: text
    producer_path: text
    producer_sha256: text
    provenance_helper_path: text
    provenance_helper_sha256: text
    parent_compiler_path: text
    parent_compiler_sha256: text
    stage3_provenance_path: text
    stage3_provenance_sha256: text
    build_log_path: text
    build_log_sha256: text
    essential_tools_log_path: text
    essential_tools_log_sha256: text
    completed_gate: text

fn _hex64(value: text) -> bool:
    if value.len() != 64:
        return false
    var index: i64 = 0
    while index < 64:
        val c = value[index:index + 1]
        if (c < "0" or c > "9") and (c < "a" or c > "f"):
            return false
        index = index + 1
    true

fn _parse_stage4_compiler_provenance_fields(
        encoded: text) -> Result<Dict<text, text>, text>:
    var fields: Dict<text, text> = {}
    for line in encoded.trim().split("\n"):
        val row = line.trim()
        if row == "": continue
        val separator = row.index_of("=")
        if separator <= 0:
            return Err("stage4-manifest-field-missing-key")
        val key = row[0:separator]
        val value = row.substring(separator + 1, row.len())
        if value == "": return Err("stage4-manifest-field-empty")
        if fields.has(key):
            return Err("stage4-manifest-duplicate-" + key)
        fields[key] = value
    Ok(fields)

fn _stage4_compiler_provenance_empty() -> Stage4CompilerProvenance:
    Stage4CompilerProvenance(
        schema: "",
        status: "",
        artifact_kind: "",
        output_path: "",
        output_sha256: "",
        source_revision_kind: "",
        source_revision: "",
        source_roots: "",
        producer_path: "",
        producer_sha256: "",
        provenance_helper_path: "",
        provenance_helper_sha256: "",
        parent_compiler_path: "",
        parent_compiler_sha256: "",
        stage3_provenance_path: "",
        stage3_provenance_sha256: "",
        build_log_path: "",
        build_log_sha256: "",
        essential_tools_log_path: "",
        essential_tools_log_sha256: "",
        completed_gate: "")

pub fn stage4_compiler_provenance_from_text(
        encoded: text) -> Stage4CompilerProvenance:
    val fields = match _parse_stage4_compiler_provenance_fields(encoded):
        case Ok(value): value
        case Err(_): return _stage4_compiler_provenance_empty()
    Stage4CompilerProvenance(
        schema: fields["schema"] ?? "",
        status: fields["status"] ?? "",
        artifact_kind: fields["artifact_kind"] ?? "",
        output_path: fields["output_path"] ?? "",
        output_sha256: fields["output_sha256"] ?? "",
        source_revision_kind: fields["source_revision_kind"] ?? "",
        source_revision: fields["source_revision"] ?? "",
        source_roots: fields["source_roots"] ?? "",
        producer_path: fields["producer_path"] ?? "",
        producer_sha256: fields["producer_sha256"] ?? "",
        provenance_helper_path: fields["provenance_helper_path"] ?? "",
        provenance_helper_sha256: fields["provenance_helper_sha256"] ?? "",
        parent_compiler_path: fields["parent_compiler_path"] ?? "",
        parent_compiler_sha256: fields["parent_compiler_sha256"] ?? "",
        stage3_provenance_path: fields["stage3_provenance_path"] ?? "",
        stage3_provenance_sha256: fields["stage3_provenance_sha256"] ?? "",
        build_log_path: fields["build_log_path"] ?? "",
        build_log_sha256: fields["build_log_sha256"] ?? "",
        essential_tools_log_path: fields["essential_tools_log_path"] ?? "",
        essential_tools_log_sha256: fields["essential_tools_log_sha256"] ?? "",
        completed_gate: fields["completed_gate"] ?? "")

pub fn stage4_compiler_provenance_reason(
        provenance: Stage4CompilerProvenance, actual_binary_sha256: text,
        actual_provenance_sha256: text) -> text:
    if not (provenance.schema == _STAGE4_COMPILER_PROVENANCE_SCHEMA_V1 or
            provenance.schema == _STAGE4_COMPILER_PROVENANCE_SCHEMA_V2):
        return "stage4-schema-invalid"
    if provenance.status != "pass":
        return "stage4-status-invalid"
    if provenance.artifact_kind != "pure-simple-full-cli":
        return "stage4-artifact-kind-invalid"
    if provenance.output_path == "":
        return "stage4-output-path-missing"
    if not _hex64(provenance.output_sha256):
        return "stage4-output-sha256-invalid"
    if actual_binary_sha256.len() != 64 or not _hex64(actual_binary_sha256):
        return "stage4-actual-binary-sha256-invalid"
    if provenance.output_sha256 != actual_binary_sha256:
        return "stage4-output-sha256-mismatch"
    if actual_provenance_sha256.len() != 64 or
            not _hex64(actual_provenance_sha256):
        return "stage4-actual-provenance-sha256-invalid"
    if provenance.source_revision_kind != "content-sha256":
        return "stage4-source-revision-kind-invalid"
    if not _hex64(provenance.source_revision):
        return "stage4-source-revision-invalid"
    if provenance.source_roots != _STAGE4_COMPILER_PROVENANCE_REQUIRED_ROOTS:
        return "stage4-source-roots-invalid"
    if provenance.completed_gate != "stage4-essential-tools-smoke":
        return "stage4-completed-gate-invalid"
    if not _hex64(provenance.producer_sha256) or
            not _hex64(provenance.provenance_helper_sha256) or
            not _hex64(provenance.parent_compiler_sha256) or
            not _hex64(provenance.stage3_provenance_sha256) or
            not _hex64(provenance.build_log_sha256) or
            not _hex64(provenance.essential_tools_log_sha256):
        return "stage4-transitive-hash-invalid"
    if provenance.producer_path == "" or provenance.provenance_helper_path == "" or
            provenance.parent_compiler_path == "" or
            provenance.stage3_provenance_path == "" or
            provenance.build_log_path == "" or
            provenance.essential_tools_log_path == "":
        return "stage4-path-missing"
    if provenance.source_revision == "" or provenance.output_path == "":
        return "stage4-field-missing"
    "ready"
