# Pure-Simple integer-exponent power, twin of the C runtime's `rt_math_pow`
# (src/runtime/runtime_native.c) for the exactly-representable subset.
#
# Machinery is deliberately different from the extern's libm `pow`: this is
# binary exponentiation by repeated multiplication, so agreement between the
# two is evidence rather than a shared implementation. Restricted to INTEGER
# exponents on purpose -- for a non-integer exponent libm's result is a
# correctly-rounded transcendental that repeated multiplication cannot claim
# to reproduce bit-for-bit, and a twin that pretended otherwise would make the
# dual-run harness certify a lie.
#
# Name is distinctive (not the bare `pow`) because the tree-walk interpreter
# resolves free functions by BARE NAME and would collide otherwise -- see
# doc/08_tracking/bug/crypto_types_text_to_bytes_collides_with_base_encoding_2026-08-21.md

# Raises `base` to a non-negative integer `exp` by binary exponentiation.
# `exp` of 0 yields 1.0 for every base, including 0.0, matching IEEE `pow`.
pub fn pow_int_exp_f64(base: f64, exp: i64) -> f64:
    if exp < 0:
        # Negative exponents go through the reciprocal of the positive case so
        # there is still exactly one multiplication path to audit.
        return 1.0 / pow_int_exp_f64(base, 0 - exp)
    var result = 1.0
    var b = base
    var e = exp
    while e > 0:
        if e % 2 == 1:
            result = result * b
        b = b * b
        e = e / 2
    return result
