# Limb primitives for the pure-Simple bignum layer.
#
# The bignum stack represents natural numbers in base 2^30 ("limbs"), stored
# little-endian in an `[i64]`. 30 bits is chosen so that a full 30 x 30
# single-limb product (< 2^60) still fits in a signed 64-bit integer with room
# to spare for an added carry — no 128-bit intermediate is ever needed, which
# keeps every operation expressible in portable pure Simple.
#
# Every function here is total and branch-shape-uniform on its limb inputs:
# `add_limbs` / `sub_limbs` compute the carry/borrow arithmetically rather than
# by comparison-and-branch, so the constant-time `fixed` layer built on top of
# them inherits a data-independent execution path.
#
# Pure functions only (src/lib/common tier): no I/O, no externs, no state.
#
# Usage: use std.math.bignum.limb.{LIMB_BITS, LIMB_BASE, LIMB_MASK, limb_mul, add_limbs, sub_limbs}

# =============================================================================
# Base Constants
# =============================================================================

pub val LIMB_BITS: i64 = 30
pub val LIMB_BASE: i64 = 1073741824
pub val LIMB_MASK: i64 = 1073741823

# =============================================================================
# Single-Limb Arithmetic
# =============================================================================

pub fn limb_mul(a: i64, b: i64) -> [i64]:
    """Multiply two limbs. Returns [low, high] with a*b = low + high*LIMB_BASE.

    Both inputs must be in [0, LIMB_MASK]. The exact product is < 2^60, so it
    is computed directly in i64 and then split — no double-word emulation.
    """
    val p = a * b
    val lo = p & LIMB_MASK
    val hi = (p >> LIMB_BITS) & LIMB_MASK
    [lo, hi]

pub fn add_limbs(a: i64, b: i64, carry_in: i64) -> [i64]:
    """Add two limbs plus a carry. Returns [sum_limb, carry_out].

    `a + b + carry_in` is at most 2*LIMB_MASK + 1 < 2^31, so the sum never
    overflows and the carry-out is just its bit LIMB_BITS.
    """
    val s = a + b + carry_in
    [s & LIMB_MASK, (s >> LIMB_BITS) & 1]

pub fn sub_limbs(a: i64, b: i64, borrow_in: i64) -> [i64]:
    """Subtract with borrow. Returns [diff_limb, borrow_out].

    Computed as `a - b - borrow_in + LIMB_BASE` so the intermediate is always
    non-negative; the borrow-out is then the complement of the carry bit, which
    avoids a value-dependent branch.
    """
    val d = a - b - borrow_in + LIMB_BASE
    val borrow_out = 1 - ((d >> LIMB_BITS) & 1)
    [d & LIMB_MASK, borrow_out]
