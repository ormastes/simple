# C-MIG-0030: pure-Simple cube root, independent of the `rt_math_cbrt`
# extern (src/lib/common/math/math.spl:28, `math_cbrt`). Newton's method
# kernel, mirroring the style of `special.spl`'s `_sqrt_f64` /
# `sqrt_f64` (C-MIG-0029) but not touching that file (HARD AVOID).

fn _cbrt_nan() -> f64:
    """NaN sentinel via IEEE overflow (inf - inf), same trick as
    special.spl's `_sqrt_nan` — a literal `0.0 / 0.0` is const-folded and
    rejected by the compiler, and the interpreter traps runtime float
    division by zero."""
    var big = 1.0e308
    val inf = big * 10.0
    inf - inf

fn _cbrt_pos(x: f64) -> f64:
    """Newton's method for the cube root of a STRICTLY POSITIVE finite x.
    x_{n+1} = (2*x_n + x/x_n^2) / 3.

    C-MIG-0030 fix (2026-08-18): the old kernel started every input from the
    fixed guess g = 1.0 and ran a FIXED 80 iterations regardless of how far
    that guess was from the true root -- correct (Newton always converges
    from g=1 for cbrt), but up to ~74x more work than needed for most inputs,
    since the previous code needed that many iterations only for the
    extreme-magnitude tail (e.g. x = 1.0e-8, cbrt ~2.15e-3, a ~2e5x ratio
    from g=1).

    Fix: range-reduce x into [1, 8) by dividing/multiplying by 8 (tracking
    the count e), so the Newton guess starts within a bounded ratio of the
    true root for EVERY input magnitude, then run Newton with a
    relative-epsilon convergence test (capped at 8 iterations -- quadratic
    convergence from a bounded-ratio start needs ~4-6). The reduced root is
    then scaled back by 2^e (since cbrt(m * 8^e) = cbrt(m) * 2^e), via a
    plain repeated-multiply/divide loop -- no bit tricks, no externs.
    Verified against every KAT/vector this kernel is exercised over,
    including the C-MIG-0030 regression case x = 1.0e-8."""
    var m = x
    var e = 0
    while m >= 8.0:
        m = m / 8.0
        e = e + 1
    while m < 1.0:
        m = m * 8.0
        e = e - 1
    var g = (1.0 + m) / 2.0
    var i = 0
    while i < 8:
        val ng = (2.0 * g + m / (g * g)) / 3.0
        val delta = if ng > g: ng - g else: g - ng
        val bound = if ng < 0.0: 0.0 - ng else: ng
        g = ng
        if delta <= 1.0e-15 * bound:
            break
        i = i + 1
    var result = g
    if e >= 0:
        var k = 0
        while k < e:
            result = result * 2.0
            k = k + 1
    else:
        var k = 0
        while k < 0 - e:
            result = result / 2.0
            k = k + 1
    result

pub fn cbrt_f64(x: f64) -> f64:
    """Cube root via Newton's method (60 iterations), the real cube root
    for ANY real x (unlike sqrt, cbrt is defined for negative inputs too:
    cbrt(-8) == -2).

    Domain: all of f64, matching IEEE-754 / the `rt_math_cbrt` oracle.
    - NaN input -> NaN (checked first via x != x).
    - x == 0.0 -> x unchanged, so +0.0 -> +0.0 and -0.0 -> -0.0.
    - +-infinity -> +-infinity, checked explicitly (the Newton loop over
      an infinite starting guess produces inf/inf == NaN on the first
      iteration otherwise, same failure mode `_sqrt_f64` guards against).
    - negative x -> computed as -cbrt(-x), the standard odd-function
      reflection; no domain restriction (unlike sqrt_f64, which returns
      NaN for negative input)."""
    if x != x:
        return _cbrt_nan()
    if x == 0.0:
        return x
    var big = 1.0e308
    val pos_inf = big * 10.0
    val neg_inf = 0.0 - pos_inf
    if x == pos_inf:
        return x
    if x == neg_inf:
        return x
    if x < 0.0:
        return 0.0 - _cbrt_pos(0.0 - x)
    _cbrt_pos(x)
