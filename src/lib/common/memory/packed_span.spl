# Packed span ABI (F2) — validated, generation-checked views over packed
# buffers, per doc plan §4.2 ("Simple WM/GUI/Web/2D Rendering Performance").
#
# `BufferSpanRef` is a safe HANDLE, never a raw host pointer. A registry
# resolves a ref against the registered backing object exactly once per
# submitted batch; a stale generation or any bounds/stride mismatch REFUSES
# with a typed code. FAIL-CLOSED: there is no silent fallback path — a
# caller that cannot obtain a valid resolution must route to the scalar
# oracle explicitly and must not claim packed/SIMD execution.
#
# Interpreter note: the tree-walk interpreter cannot expose a raw packed
# pointer for `[u32]` storage. This module therefore validates the VIEW
# (slot, generation, bounds, stride) in pure Simple; a native (C, never
# Rust) resolve that turns an OK verdict into `void*` base + byte length is
# a later, separate runtime addition. Until it exists, an OK verdict means
# "the window is valid for checked indexed access", nothing more.
#
# MEASURED 2026-08-06 (PR0 profiling lane), and it constrains this module's
# whole premise: `[u32]` IS NOT A PACKED PIXEL BUFFER. Probed directly, its
# storage has an 8-byte stride and its values are tagged `<< 3`. So a
# zero-copy span over a `[u32]` is impossible as that type stands, and the
# gather/scatter around the SIMD kernels is a REPRESENTATION CONVERSION, not
# wrapper sloppiness that a better ABI can delete.
#
# CORRECTED 2026-08-06 (F2b lane): an earlier revision of this header named
# `rt_typed_words_u32_*` as the credible packed basis. THAT WAS WRONG. Those
# accessors are 8-byte-stride reads masked to 32 bits — the same storage
# width as `[u32]`. Confirmed three ways: the C runtime reads
# `((int64_t*)array->data)[idx]` and its `elem_size` is binary (1 or 8, with
# NO 4-byte element size in the array runtime at all); the pure-Simple
# runtime hardcodes `idx * 8` in all four accessors; and the ROCm backend
# already mallocs a real `uint32_t[]` and gathers element-by-element to
# reach the device — the same conversion, appearing independently.
# The `RT_CORE_ARRAY_FLAG_U64_PACKED` flag controls TAGGING only, never
# width. The real packed basis is a BYTES array (`rt_byte_array_new`,
# elem_size 1) via the existing `rt_typed_bytes_u32_le_at/set`: 4 bytes per
# pixel, contiguous, directly consumable by a kernel.
# See doc/08_tracking/bug/rt_typed_words_u32_is_not_a_packed_pixel_basis_2026-08-06.md
#
# This module's validation is still
# correct and still fail-closed, but do not read it as evidence that a
# packed pointer over `[u32]` is one runtime function away — it is not.
# See doc/09_report/render_pipeline_profile_2026-08-06.md.

# NATIVE HALF (F2, landed 2026-08-08): `src/runtime/runtime_packed_span.c`
# now implements the `SimplePackedSpanV1` resolve described in
# doc/05_design/ui/perf/packed_span_v1_c_resolve_abi_2026-08-08.md. C turns an
# already-OK registry verdict into a real base pointer over a BYTES-basis
# array; it never sees `object_slot` / `object_generation`, because generation
# lifetime is a language-level ownership fact, not a memory fact. The registry
# verdict plus the C resolve together are the ONE check per submitted batch.
#
# C verdict codes are these codes NEGATED (one table, two sides), plus three
# C-only refusals: -6 WRONG_BASIS (backing is not a bytes array), -7 NO_BASE
# (this engine has no contiguous buffer to expose — the tree-walk interpreter
# boxes `[u8]` elements), -8 BAD_ARGS.
@unsafe(reason: "raw packed-byte allocation ABI", capabilities: [ffi])
extern fn rt_bytes_alloc(len: i64) -> [u8]
@unsafe(reason: "raw packed-span pointer projection ABI", capabilities: [ffi])
extern fn rt_packed_span_v1_resolve_base(arr: [u8], byte_offset: u32, byte_length: u32, element_count: u32, element_stride: u32) -> i64
@unsafe(reason: "raw packed-span verdict ABI", capabilities: [ffi])
extern fn rt_packed_span_v1_probe_verdict(basis_len: i64, byte_offset: u32, byte_length: u32, element_count: u32, element_stride: u32) -> i64
@unsafe(reason: "raw packed-span flags ABI", capabilities: [ffi])
extern fn rt_packed_span_v1_flags_bits() -> i64
@unsafe(reason: "raw packed-span verdict ABI", capabilities: [ffi])
extern fn rt_packed_span_v1_last_verdict() -> i64
@unsafe(reason: "raw packed-span rejection ABI", capabilities: [ffi])
extern fn rt_packed_span_v1_last_rejection() -> i64
@unsafe(reason: "raw packed-span counter ABI", capabilities: [ffi])
extern fn rt_packed_span_v1_rejected_count() -> i64
@unsafe(reason: "raw packed-span layout ABI", capabilities: [ffi])
extern fn rt_packed_span_v1_struct_size() -> i64

# C-side verdicts (negated Simple codes, plus the C-only refusals).
val PACKED_SPAN_C_OK: i64 = 0
val PACKED_SPAN_C_OUT_OF_BOUNDS: i64 = -3
val PACKED_SPAN_C_BAD_STRIDE: i64 = -4
val PACKED_SPAN_C_EMPTY: i64 = -5
val PACKED_SPAN_C_WRONG_BASIS: i64 = -6
val PACKED_SPAN_C_NO_BASE: i64 = -7

# `SimplePackedSpanV1` flag bits. Bit 2 (SIMD_SAFE) is COMPUTED by C from the
# real base alignment and length — never asserted by a caller.
val PACKED_SPAN_FLAG_CONTIGUOUS: i64 = 1
val PACKED_SPAN_FLAG_WRITABLE: i64 = 2
val PACKED_SPAN_FLAG_SIMD_SAFE: i64 = 4

# Verdict codes (plain integers — see the enum-match engine-divergence bugs
# filed 2026-08-06; integer codes behave identically on every engine).
val PACKED_SPAN_OK: i64 = 0
val PACKED_SPAN_STALE_GENERATION: i64 = 1
val PACKED_SPAN_BAD_SLOT: i64 = 2
val PACKED_SPAN_OUT_OF_BOUNDS: i64 = 3
val PACKED_SPAN_BAD_STRIDE: i64 = 4
val PACKED_SPAN_EMPTY: i64 = 5

struct BufferSpanRef:
    object_slot: u32
    object_generation: u32
    byte_offset: u32
    byte_length: u32
    element_count: u32
    element_stride: u32

# Registry of packed backing objects. One per session. Every column is a
# top-level field (parallel arrays) — no nested class fields, per the
# verified interpreter class-field value-copy divergence documented in
# `ui_scene_arena.spl`.
class PackedSpanRegistry:
    slot_byte_len: [u32]
    slot_generation: [u32]
    slot_live: [u32]
    slot_count: i64
    # Counted honest gate (project standard: a refusal is COUNTED and TYPED,
    # never a silent zero and never a fabricated success).
    resolve_call_count: i64
    rejected_op_count: i64
    last_rejection: i64
    # Elements admitted by an OK resolve. Divided by `resolve_call_count` this
    # is the checks-per-element ratio the F2 "one check per batch" property
    # claims — so the claim is measurable, not aspirational.
    admitted_element_count: i64

    static fn create(capacity: i64) -> PackedSpanRegistry:
        var lens: [u32] = []
        var gens: [u32] = []
        var live: [u32] = []
        var i = 0
        while i < capacity:
            lens.push(0)
            gens.push(0)
            live.push(0)
            i = i + 1
        PackedSpanRegistry(
            slot_byte_len: lens,
            slot_generation: gens,
            slot_live: live,
            slot_count: capacity,
            resolve_call_count: 0,
            rejected_op_count: 0,
            last_rejection: PACKED_SPAN_OK,
            admitted_element_count: 0)

    # Register a backing object of `byte_length` bytes. Returns the slot, or
    # -1 when the registry is full (fail closed — never overwrite a live slot).
    me register(byte_length: u32) -> i64:
        var i = 0
        while i < self.slot_count:
            if self.slot_live[i] == 0:
                self.slot_byte_len[i] = byte_length
                self.slot_generation[i] = self.slot_generation[i] + 1
                self.slot_live[i] = 1
                return i
            i = i + 1
        -1

    me generation_of(slot: i64) -> u32:
        if slot < 0 or slot >= self.slot_count:
            return 0
        self.slot_generation[slot]

    # Invalidate a slot: every outstanding ref against it becomes stale.
    me invalidate(slot: i64) -> bool:
        if slot < 0 or slot >= self.slot_count:
            return false
        if self.slot_live[slot] == 0:
            return false
        self.slot_live[slot] = 0
        self.slot_generation[slot] = self.slot_generation[slot] + 1
        true

    # The single validation gate. One call per submitted batch, not per pixel.
    # Records the verdict: OK admits `element_count` elements against ONE
    # check; anything else is a counted, typed refusal.
    me resolve(r: BufferSpanRef) -> i64:
        val verdict = self.check(r)
        self.resolve_call_count = self.resolve_call_count + 1
        if verdict == PACKED_SPAN_OK:
            self.admitted_element_count = self.admitted_element_count + (r.element_count as i64)
        else:
            self.rejected_op_count = self.rejected_op_count + 1
            self.last_rejection = verdict
        verdict

    # Pure verdict computation — no bookkeeping, so callers that need to probe
    # without disturbing the counters can use it.
    me check(r: BufferSpanRef) -> i64:
        val slot = r.object_slot as i64
        if slot < 0 or slot >= self.slot_count:
            return PACKED_SPAN_BAD_SLOT
        if self.slot_live[slot] == 0:
            return PACKED_SPAN_STALE_GENERATION
        if self.slot_generation[slot] != r.object_generation:
            return PACKED_SPAN_STALE_GENERATION
        if r.element_stride == 0:
            return PACKED_SPAN_BAD_STRIDE
        if r.element_count == 0 or r.byte_length == 0:
            return PACKED_SPAN_EMPTY
        if r.element_count * r.element_stride != r.byte_length:
            return PACKED_SPAN_BAD_STRIDE
        val end = (r.byte_offset as i64) + (r.byte_length as i64)
        if end > (self.slot_byte_len[slot] as i64):
            return PACKED_SPAN_OUT_OF_BOUNDS
        PACKED_SPAN_OK

fn packed_span_make(slot: i64, generation: u32, byte_offset: u32, element_count: u32, element_stride: u32) -> BufferSpanRef:
    BufferSpanRef(
        object_slot: slot as u32,
        object_generation: generation,
        byte_offset: byte_offset,
        byte_length: element_count * element_stride,
        element_count: element_count,
        element_stride: element_stride)

# Turn an already-OK registry verdict into a real base address or a typed C
# refusal. This performs exactly one C resolve and one base comparison.
#
# The caller MUST have obtained PACKED_SPAN_OK from `registry.resolve(r)`
# first: this function performs the MEMORY half of the check (basis, bounds,
# stride, emptiness, alignment) and deliberately not the OWNERSHIP half
# (slot liveness, generation). Calling it without the registry verdict skips
# the stale-generation gate, which C cannot see.
#
# The verdict is read only on the failure branch; success does not perform a
# second lookup, validation pass, allocation, or hash.
fn packed_span_resolve_base(backing: [u8], r: BufferSpanRef) -> Result<i64, i64>:
    var base: i64 = 0
    unsafe(capabilities: [ffi]):
        base = rt_packed_span_v1_resolve_base(backing, r.byte_offset, r.byte_length, r.element_count, r.element_stride)
    if base != 0:
        return Ok(base)
    unsafe(capabilities: [ffi]):
        Err(rt_packed_span_v1_last_verdict())

# Allocate a zeroed BYTES-BASIS buffer for probes and specs.
#
# MEASURED 2026-08-08 on the native engine (native-build, real C runtime): a
# `[u8]` built by `var buf: [u8] = []` + `push` is NOT a bytes-basis array —
# the C resolve refuses it with -6 WRONG_BASIS. Only `rt_bytes_alloc` produces
# the elem_size-1 storage the packed span ABI requires. This is the same
# representation trap already recorded for `[u32]`
# (doc/08_tracking/bug/rt_typed_words_u32_is_not_a_packed_pixel_basis_2026-08-06.md),
# now confirmed to extend to push-built `[u8]`. Do not "simplify" this back to
# a push loop: it silently turns every resolve into a refusal.
fn packed_span_probe_bytes(n: i64) -> [u8]:
    unsafe(capabilities: [ffi]):
        rt_bytes_alloc(n)

# Adjudicate a window against a declared basis length with NO base pointer.
# `basis_len < 0` means "not a bytes basis" (verdict -6). This can never return
# OK — the best verdict reachable is -7 NO_BASE — so it is a verdict oracle,
# never a way to obtain a pointer.
fn packed_span_probe_verdict(basis_len: i64, byte_offset: u32, byte_length: u32, element_count: u32, element_stride: u32) -> i64:
    unsafe(capabilities: [ffi]):
        rt_packed_span_v1_probe_verdict(basis_len, byte_offset, byte_length, element_count, element_stride)

fn packed_span_last_verdict() -> i64:
    unsafe(capabilities: [ffi]):
        rt_packed_span_v1_last_verdict()

fn packed_span_last_rejection() -> i64:
    unsafe(capabilities: [ffi]):
        rt_packed_span_v1_last_rejection()

fn packed_span_rejected_count() -> i64:
    unsafe(capabilities: [ffi]):
        rt_packed_span_v1_rejected_count()

fn packed_span_flags() -> i64:
    unsafe(capabilities: [ffi]):
        rt_packed_span_v1_flags_bits()

# sizeof(SimplePackedSpanV1). 40 on LP64 — asserted by the spec so a silent
# layout change cannot slip through.
fn packed_span_abi_struct_size() -> i64:
    unsafe(capabilities: [ffi]):
        rt_packed_span_v1_struct_size()

# Which backend an OK verdict actually authorises — MEASURED, never asserted.
#
# This is deliberately a live probe and not a constant: the C resolve exists
# now (src/runtime/runtime_packed_span.c), but the ENGINE decides whether it
# can hand back a real base. The tree-walk interpreter boxes `[u8]` elements
# and has no contiguous buffer, so it gets verdict -7 NO_BASE and this
# function keeps saying "scalar-oracle" there. Only an engine that actually
# returns a non-zero base gets to claim "native-packed-v1".
#
# This is the repo rule "never enable an optimization because a capability bit
# exists" made executable: the capability is proven per call, per engine.
fn packed_span_backend_name() -> text:
    val probe = packed_span_probe_bytes(64)
    val r = BufferSpanRef(object_slot: 0, object_generation: 0, byte_offset: 0, byte_length: 64, element_count: 16, element_stride: 4)
    match packed_span_resolve_base(probe, r):
        case Ok(_): "native-packed-v1"
        case Err(_): "scalar-oracle"

export PackedSpanRegistry, BufferSpanRef, packed_span_make, packed_span_backend_name
export packed_span_resolve_base, packed_span_last_verdict, packed_span_last_rejection
export packed_span_probe_bytes, packed_span_probe_verdict
export packed_span_rejected_count, packed_span_flags, packed_span_abi_struct_size
export PACKED_SPAN_OK, PACKED_SPAN_STALE_GENERATION, PACKED_SPAN_BAD_SLOT
export PACKED_SPAN_OUT_OF_BOUNDS, PACKED_SPAN_BAD_STRIDE, PACKED_SPAN_EMPTY
export PACKED_SPAN_C_OK, PACKED_SPAN_C_OUT_OF_BOUNDS, PACKED_SPAN_C_BAD_STRIDE
export PACKED_SPAN_C_EMPTY, PACKED_SPAN_C_WRONG_BASIS, PACKED_SPAN_C_NO_BASE
export PACKED_SPAN_FLAG_CONTIGUOUS, PACKED_SPAN_FLAG_WRITABLE, PACKED_SPAN_FLAG_SIMD_SAFE
