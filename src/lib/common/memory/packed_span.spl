# Packed span ABI (F2) — validated, generation-checked views over packed
# buffers, per doc plan §4.2 ("Simple WM/GUI/Web/2D Rendering Performance").
#
# `BufferSpanRef` is a safe HANDLE, never a raw host pointer. A registry
# resolves a ref against the registered backing object exactly once per
# submitted batch; a stale generation or any bounds/stride mismatch REFUSES
# with a typed code. FAIL-CLOSED: there is no silent fallback path — a
# caller that cannot obtain a valid resolution must route to the scalar
# oracle explicitly and must not claim packed/SIMD execution.
#
# Interpreter note: the tree-walk interpreter cannot expose a raw packed
# pointer for `[u32]` storage. This module therefore validates the VIEW
# (slot, generation, bounds, stride) in pure Simple; a native (C, never
# Rust) resolve that turns an OK verdict into `void*` base + byte length is
# a later, separate runtime addition. Until it exists, an OK verdict means
# "the window is valid for checked indexed access", nothing more.
#
# MEASURED 2026-08-06 (PR0 profiling lane), and it constrains this module's
# whole premise: `[u32]` IS NOT A PACKED PIXEL BUFFER. Probed directly, its
# storage has an 8-byte stride and its values are tagged `<< 3`. So a
# zero-copy span over a `[u32]` is impossible as that type stands, and the
# gather/scatter around the SIMD kernels is a REPRESENTATION CONVERSION, not
# wrapper sloppiness that a better ABI can delete.
#
# CORRECTED 2026-08-06 (F2b lane): an earlier revision of this header named
# `rt_typed_words_u32_*` as the credible packed basis. THAT WAS WRONG. Those
# accessors are 8-byte-stride reads masked to 32 bits — the same storage
# width as `[u32]`. Confirmed three ways: the C runtime reads
# `((int64_t*)array->data)[idx]` and its `elem_size` is binary (1 or 8, with
# NO 4-byte element size in the array runtime at all); the pure-Simple
# runtime hardcodes `idx * 8` in all four accessors; and the ROCm backend
# already mallocs a real `uint32_t[]` and gathers element-by-element to
# reach the device — the same conversion, appearing independently.
# The `RT_CORE_ARRAY_FLAG_U64_PACKED` flag controls TAGGING only, never
# width. The real packed basis is a BYTES array (`rt_byte_array_new`,
# elem_size 1) via the existing `rt_typed_bytes_u32_le_at/set`: 4 bytes per
# pixel, contiguous, directly consumable by a kernel.
# See doc/08_tracking/bug/rt_typed_words_u32_is_not_a_packed_pixel_basis_2026-08-06.md
#
# This module's validation is still
# correct and still fail-closed, but do not read it as evidence that a
# packed pointer over `[u32]` is one runtime function away — it is not.
# See doc/09_report/render_pipeline_profile_2026-08-06.md.

# Verdict codes (plain integers — see the enum-match engine-divergence bugs
# filed 2026-08-06; integer codes behave identically on every engine).
val PACKED_SPAN_OK: i64 = 0
val PACKED_SPAN_STALE_GENERATION: i64 = 1
val PACKED_SPAN_BAD_SLOT: i64 = 2
val PACKED_SPAN_OUT_OF_BOUNDS: i64 = 3
val PACKED_SPAN_BAD_STRIDE: i64 = 4
val PACKED_SPAN_EMPTY: i64 = 5

struct BufferSpanRef:
    object_slot: u32
    object_generation: u32
    byte_offset: u32
    byte_length: u32
    element_count: u32
    element_stride: u32

# Registry of packed backing objects. One per session. Every column is a
# top-level field (parallel arrays) — no nested class fields, per the
# verified interpreter class-field value-copy divergence documented in
# `ui_scene_arena.spl`.
class PackedSpanRegistry:
    slot_byte_len: [u32]
    slot_generation: [u32]
    slot_live: [u32]
    slot_count: i64
    # Counted honest gate (project standard: a refusal is COUNTED and TYPED,
    # never a silent zero and never a fabricated success).
    resolve_call_count: i64
    rejected_op_count: i64
    last_rejection: i64
    # Elements admitted by an OK resolve. Divided by `resolve_call_count` this
    # is the checks-per-element ratio the F2 "one check per batch" property
    # claims — so the claim is measurable, not aspirational.
    admitted_element_count: i64

    static fn create(capacity: i64) -> PackedSpanRegistry:
        var lens: [u32] = []
        var gens: [u32] = []
        var live: [u32] = []
        var i = 0
        while i < capacity:
            lens.push(0)
            gens.push(0)
            live.push(0)
            i = i + 1
        PackedSpanRegistry(
            slot_byte_len: lens,
            slot_generation: gens,
            slot_live: live,
            slot_count: capacity,
            resolve_call_count: 0,
            rejected_op_count: 0,
            last_rejection: PACKED_SPAN_OK,
            admitted_element_count: 0)

    # Register a backing object of `byte_length` bytes. Returns the slot, or
    # -1 when the registry is full (fail closed — never overwrite a live slot).
    me register(byte_length: u32) -> i64:
        var i = 0
        while i < self.slot_count:
            if self.slot_live[i] == 0:
                self.slot_byte_len[i] = byte_length
                self.slot_generation[i] = self.slot_generation[i] + 1
                self.slot_live[i] = 1
                return i
            i = i + 1
        -1

    me generation_of(slot: i64) -> u32:
        if slot < 0 or slot >= self.slot_count:
            return 0
        self.slot_generation[slot]

    # Invalidate a slot: every outstanding ref against it becomes stale.
    me invalidate(slot: i64) -> bool:
        if slot < 0 or slot >= self.slot_count:
            return false
        if self.slot_live[slot] == 0:
            return false
        self.slot_live[slot] = 0
        self.slot_generation[slot] = self.slot_generation[slot] + 1
        true

    # The single validation gate. One call per submitted batch, not per pixel.
    # Records the verdict: OK admits `element_count` elements against ONE
    # check; anything else is a counted, typed refusal.
    me resolve(r: BufferSpanRef) -> i64:
        val verdict = self.check(r)
        self.resolve_call_count = self.resolve_call_count + 1
        if verdict == PACKED_SPAN_OK:
            self.admitted_element_count = self.admitted_element_count + (r.element_count as i64)
        else:
            self.rejected_op_count = self.rejected_op_count + 1
            self.last_rejection = verdict
        verdict

    # Pure verdict computation — no bookkeeping, so callers that need to probe
    # without disturbing the counters can use it.
    me check(r: BufferSpanRef) -> i64:
        val slot = r.object_slot as i64
        if slot < 0 or slot >= self.slot_count:
            return PACKED_SPAN_BAD_SLOT
        if self.slot_live[slot] == 0:
            return PACKED_SPAN_STALE_GENERATION
        if self.slot_generation[slot] != r.object_generation:
            return PACKED_SPAN_STALE_GENERATION
        if r.element_stride == 0:
            return PACKED_SPAN_BAD_STRIDE
        if r.element_count == 0 or r.byte_length == 0:
            return PACKED_SPAN_EMPTY
        if r.element_count * r.element_stride != r.byte_length:
            return PACKED_SPAN_BAD_STRIDE
        val end = (r.byte_offset as i64) + (r.byte_length as i64)
        if end > (self.slot_byte_len[slot] as i64):
            return PACKED_SPAN_OUT_OF_BOUNDS
        PACKED_SPAN_OK

fn packed_span_make(slot: i64, generation: u32, byte_offset: u32, element_count: u32, element_stride: u32) -> BufferSpanRef:
    BufferSpanRef(
        object_slot: slot as u32,
        object_generation: generation,
        byte_offset: byte_offset,
        byte_length: element_count * element_stride,
        element_count: element_count,
        element_stride: element_stride)

# Which backend an OK verdict actually authorises. There is NO native
# `SimplePackedSpanV1` resolve in `src/runtime/` (verified absent repo-wide
# 2026-08-08), so an OK verdict authorises checked indexed access via the
# scalar oracle and NOTHING MORE. This function must keep returning
# "scalar-oracle" until a real C resolve lands — it exists so no caller can
# quietly start claiming SIMD execution the runtime cannot deliver.
# Design for the missing C half:
# doc/05_design/ui/perf/packed_span_v1_c_resolve_abi_2026-08-08.md
fn packed_span_backend_name() -> text:
    "scalar-oracle"

export PackedSpanRegistry, BufferSpanRef, packed_span_make, packed_span_backend_name
export PACKED_SPAN_OK, PACKED_SPAN_STALE_GENERATION, PACKED_SPAN_BAD_SLOT
export PACKED_SPAN_OUT_OF_BOUNDS, PACKED_SPAN_BAD_STRIDE, PACKED_SPAN_EMPTY
