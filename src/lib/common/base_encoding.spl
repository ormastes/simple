# Base encoding facade — top-level re-exports and convenience helpers.
#
# Consumers that import from std.common.base_encoding directly (not a sub-module):
#   use std.common.base_encoding.{bytes_to_text}   (github.spl)
#
# Sub-module consumers import from:
#   std.common.base_encoding.base64.{base64_encode, base64_decode}
#   std.common.base_encoding.utilities.{base_encoding_facade_text_to_bytes, line_wrap, line_unwrap}
#
# This file provides the top-level helpers only.  The sub-modules live in
# the base_encoding/ directory.

use std.common.encoding.utf8.{char_from_codepoint}

# ============================================================================
# Byte / text conversion helpers
# ============================================================================

fn bytes_to_text(data: [u8]) -> text:
    """Interpret a raw byte slice as UTF-8 text.

    Non-UTF-8 bytes are replaced with the Unicode replacement character U+FFFD.
    This mirrors Rust's String::from_utf8_lossy behaviour.
    """
    var result = ""
    var i = 0
    val n = data.len()
    while i < n:
        val b = data[i] as i64
        if b < 0x80:
            # ASCII fast path
            result = result + _char_from_code(b)
            i = i + 1
        else if b < 0xC0:
            # Unexpected continuation byte
            result = result + "�"
            i = i + 1
        else if b < 0xE0:
            # 2-byte sequence
            if i + 1 < n:
                val b2 = data[i + 1] as i64
                val cp = ((b & 0x1F) << 6) | (b2 & 0x3F)
                if (b2 & 0xC0) == 0x80 and cp >= 0x80:
                    result = result + _char_from_code(cp)
                    i = i + 2
                else:
                    result = result + "�"
                    i = i + 1
            else:
                result = result + "�"
                i = i + 1
        else if b < 0xF0:
            # 3-byte sequence
            if i + 2 < n:
                val b2 = data[i + 1] as i64
                val b3 = data[i + 2] as i64
                val cp = ((b & 0x0F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
                if (b2 & 0xC0) == 0x80 and (b3 & 0xC0) == 0x80 and cp >= 0x800 and not (cp >= 0xD800 and cp <= 0xDFFF):
                    result = result + _char_from_code(cp)
                    i = i + 3
                else:
                    result = result + "�"
                    i = i + 1
            else:
                result = result + "�"
                i = i + 1
        else:
            # 4-byte sequence (supplementary plane)
            if i + 3 < n:
                val b2 = data[i + 1] as i64
                val b3 = data[i + 2] as i64
                val b4 = data[i + 3] as i64
                val cp = ((b & 0x07) << 18) | ((b2 & 0x3F) << 12) | ((b3 & 0x3F) << 6) | (b4 & 0x3F)
                if b < 0xF8 and (b2 & 0xC0) == 0x80 and (b3 & 0xC0) == 0x80 and (b4 & 0xC0) == 0x80 and cp >= 0x10000 and cp <= 0x10FFFF:
                    result = result + _char_from_code(cp)
                    i = i + 4
                else:
                    result = result + "�"
                    i = i + 1
            else:
                result = result + "�"
                i = i + 1
    result

fn base_encoding_facade_text_to_bytes(s: text) -> [u8]:
    """Encode a text value as a UTF-8 byte slice."""
    # `text` is already stored as UTF-8, so copy its bytes out directly.
    # The previous hand-rolled encoder bounded its loop by `s.len()` -- a
    # BYTE count -- while indexing with `s.char_at(i)`, which is CODEPOINT
    # indexed. For ASCII the two counts coincide, but any multi-byte
    # codepoint makes the loop over-run the end of the string; `char_at`
    # then returns "" and `"" as i64` aborts with
    # `semantic: type mismatch: cannot cast str to i64`, so base_encoding_facade_text_to_bytes
    # failed outright on every non-ASCII input. Matches the already-correct
    # sibling in base_encoding/utilities.spl.
    var out: [u8] = []
    val raw = s.bytes()
    var i = 0
    val n = raw.len()
    while i < n:
        out = out.push(raw[i] as u8)
        i = i + 1
    out

fn _char_from_code(cp: i64) -> text:
    """Convert a Unicode code point to a single-character text.

    Uses the runtime string-from-char primitive.  Falls back to replacement
    character for values outside the valid Unicode range.
    """
    if cp < 0 or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF):
        return "�"
    # This used to call `cp.chr()`, which exists ONLY in the interpreter:
    # under the default (JIT) engine it aborts with
    # `Runtime error: Function 'i64.chr' not found`, so bytes_to_text failed
    # outright there -- for ASCII input too, not just non-ASCII, because the
    # ASCII fast path routes through this helper as well.
    # char_from_codepoint builds the character from a literal table slice and
    # rt_bytes_to_text, so it works on both engines.
    char_from_codepoint(cp)
