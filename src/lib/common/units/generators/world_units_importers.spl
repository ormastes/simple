# World-unit seed-row importers.
#
# Produces the standards-backed seed rows that `catalog/world_units_v1.sdn` is
# generated from, each carrying the STANDARD it was taken from. The attribution
# is the point: a unit row whose provenance is unrecorded cannot be re-derived
# or audited when the standard is revised.
#
# The model layer already existed; this module and `units.engine.unit_expr`
# were its two missing consumers. See
# doc/08_tracking/bug/world_units_engine_and_generators_modules_missing_2026-08-21.md

struct ImportedUnitRow:
    id: text
    symbol: text
    kind_id: text
    source: text
    # ISO 4217 alphabetic / UNECE Rec 20 / ISO 4217 numeric code, "" when the
    # row's standard does not assign one.
    code: text

fn imported_unit_row(id: text, symbol: text, kind_id: text, source: text, code: text) -> ImportedUnitRow:
    ImportedUnitRow(id: id, symbol: symbol, kind_id: kind_id, source: source, code: code)

fn import_ucum_seed_rows() -> [ImportedUnitRow]:
    """Rows whose canonical symbol is fixed by UCUM (Unified Code for Units of Measure)."""
    [
        imported_unit_row("metre", "m", "Length", "UCUM", ""),
        imported_unit_row("kilogram", "kg", "Mass", "UCUM", ""),
        imported_unit_row("second", "s", "Time", "UCUM", ""),
        imported_unit_row("hour", "h", "Time", "UCUM", "")
    ]

fn import_iso4217_seed_rows() -> [ImportedUnitRow]:
    """Currency rows from ISO 4217, maintained by SIX. `code` is the NUMERIC code."""
    [
        imported_unit_row("USD", "USD", "CurrencyAmount", "ISO 4217/SIX", "840")
    ]

fn import_unece_rec20_seed_rows() -> [ImportedUnitRow]:
    """Trade count rows from UNECE Recommendation 20."""
    [
        imported_unit_row("piece", "pc", "Count", "UNECE Rec 20", "H87"),
        imported_unit_row("dozen", "dz", "Count", "UNECE Rec 20", "DZN"),
        imported_unit_row("set", "set", "Count", "UNECE Rec 20", "SET")
    ]

fn import_iupac_seed_rows() -> [ImportedUnitRow]:
    """Chemistry concentration rows defined by the IUPAC Gold Book."""
    [
        imported_unit_row("mole_per_litre", "mol/L", "AmountOfSubstanceConcentration", "IUPAC Gold Book", "")
    ]

fn import_iec80000_13_seed_rows() -> [ImportedUnitRow]:
    """Binary information rows from IEC 80000-13 (the KiB/MiB prefixes)."""
    [
        imported_unit_row("kibibyte", "KiB", "Information", "IEC 80000-13", "")
    ]

fn import_all_world_unit_seed_rows() -> [ImportedUnitRow]:
    """Every standards-backed seed row, in standard order.

    Ten rows: 4 UCUM, 1 ISO 4217, 3 UNECE Rec 20, 1 IUPAC, 1 IEC 80000-13."""
    var rows: [ImportedUnitRow] = []
    for row in import_ucum_seed_rows():
        rows.push(row)
    for row in import_iso4217_seed_rows():
        rows.push(row)
    for row in import_unece_rec20_seed_rows():
        rows.push(row)
    for row in import_iupac_seed_rows():
        rows.push(row)
    for row in import_iec80000_13_seed_rows():
        rows.push(row)
    rows

fn imported_rows_have_unique_ids(rows: [ImportedUnitRow]) -> bool:
    """False as soon as two rows share an id.

    Two importers claiming the same id would silently overwrite one another in
    the generated catalog, so this is checked before any row is rendered."""
    var seen: [text] = []
    for row in rows:
        for existing in seen:
            if existing == row.id:
                return false
        seen.push(row.id)
    true

fn imported_rows_to_sdn(rows: [ImportedUnitRow]) -> text:
    """Render the rows as SDN, one `imported_unit <id>:` block each.

    `code:` is emitted only for rows whose standard assigns one, so an absent
    code stays absent rather than becoming an empty-string code."""
    var out = "imported_world_units:\n"
    for row in rows:
        out = out + "imported_unit {row.id}:\n"
        out = out + "    symbol: \"{row.symbol}\"\n"
        out = out + "    kind: \"{row.kind_id}\"\n"
        out = out + "    source: \"{row.source}\"\n"
        if row.code != "":
            out = out + "    code: \"{row.code}\"\n"
        out = out + "\n"
    out
