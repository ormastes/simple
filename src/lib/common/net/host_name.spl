# ============================================================================
# common/net/host_name.spl — checked DNS host name (ASCII LDH, no IP literals)
#
# IDNA is out of scope: callers must supply the punycode (A-label) form.
# ============================================================================

pub unit HostName: text

fn _host_label_valid(label: text) -> bool:
    if label.len() < 1 or label.len() > 63: return false
    if label.starts_with("-") or label.ends_with("-"): return false
    for ch in label:
        if not "abcdefghijklmnopqrstuvwxyz0123456789-".contains(ch): return false
    true

# True for IPv6 literals (contain ':') and dotted all-numeric IPv4-looking names.
pub fn host_name_is_ip_literal(value: text) -> bool:
    if value.contains(":"): return true
    if value == "": return false
    for label in value.split("."):
        if label == "": return false
        for ch in label:
            if not "0123456789".contains(ch): return false
    true

pub fn host_name_parse(value: text) -> Result<HostName, text>:
    if value == "": return Err("host name empty")
    for ch in value:
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" or ch == "\0":
            return Err("host name contains whitespace or control character")
    if host_name_is_ip_literal(value): return Err("host name is an IP literal")
    val lowered = value.lower()
    if lowered.len() > 253: return Err("host name longer than 253 characters")
    for ch in lowered:
        if ch.len() != 1: return Err("host name must be ASCII (IDNA unsupported)")
    for label in lowered.split("."):
        if not _host_label_valid(label): return Err("host name label invalid")
    Ok(HostName(lowered))
