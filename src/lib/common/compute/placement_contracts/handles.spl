"""Arena-granularity handles shared by GPU Object VM consumers."""

export use common.structural.identity.entity_id.{EntityRef, entity_ref}

class ObjectRef<T>:
    object_slot: u32
    generation: u32

class ResidentView<T>:
    device_address: u64
    length: u64
    object_slot: u32
    lease_epoch: u32

fn object_ref<T>(object_slot: u32, generation: u32) -> ObjectRef<T>:
    ObjectRef(object_slot: object_slot, generation: generation)

class ArenaResidency<T>:
    object: ObjectRef<T>
    entity_count: u64
    byte_len: u64

export ObjectRef, ResidentView, ArenaResidency, object_ref
