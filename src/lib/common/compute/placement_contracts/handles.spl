"""Arena-granularity handles shared by GPU Object VM consumers."""

class ObjectRef<T>:
    object_slot: u32
    generation: u32

class EntityRef:
    object_slot: u32
    local_index: u32

class ResidentView<T>:
    device_address: u64
    length: u64
    object_slot: u32
    lease_epoch: u32

fn object_ref<T>(object_slot: u32, generation: u32) -> ObjectRef<T>:
    ObjectRef(object_slot: object_slot, generation: generation)

fn entity_ref(object_slot: u32, local_index: u32) -> EntityRef:
    EntityRef(object_slot: object_slot, local_index: local_index)

export ObjectRef, EntityRef, ResidentView, object_ref, entity_ref
