"""Semantic ID and policy types used by placement and execution contracts."""

use common.compute.placement_contracts.handles.{ObjectRef}
use common.compute.placement_contracts.residency.{ResidencyTier}

pub enum AnyObject:
    Marker

pub enum ReservationArena:
    Marker

pub enum TransferArena:
    Marker

pub enum EvictionArena:
    Marker

pub enum PrefetchArena:
    Marker

pub enum LeaseArena:
    Marker

pub enum PlacementRequestArena:
    Marker

class Hash256:
    value: text

class StageId:
    value: text

class BackendId:
    value: text

pub enum ExecutionMode:
    CpuReference
    HybridVectorGpu
    ResidentGpu

pub enum AccessPattern:
    SequentialRead
    RandomRead
    ReadMostly
    ReadWrite
    WriteOnly

class ResidencyTierSet:
    tiers: [ResidencyTier]

class DeviceMask:
    bits: u64

class StageEpoch:
    value: u64

class CostUnit:
    value: u64

pub enum PersistencePolicy:
    Temporary
    Checkpoint
    Durable
    Recomputable

class AffinityGroupId:
    value: u64

class Deadline:
    timestamp_us: u64

class PlacementRequestArenaRef:
    object: ObjectRef<PlacementRequestArena>

class ObjectSetView:
    objects: [ObjectRef<AnyObject>]

export Hash256, StageId, BackendId, ResidencyTierSet, DeviceMask
export StageEpoch, CostUnit, AffinityGroupId, Deadline
export PlacementRequestArenaRef, ObjectSetView
