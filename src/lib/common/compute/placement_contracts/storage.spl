"""Content-addressed artifact identity shared by stores and placement backends."""

class ArtifactId:
    digest: text
    byte_len: i64

fn artifact_id(digest: text, byte_len: i64) -> ArtifactId:
    ArtifactId(digest: digest, byte_len: byte_len)

fn artifact_id_valid(id: ArtifactId) -> bool:
    if id.digest.len() != 64 or id.byte_len < 0: return false
    var index: i64 = 0
    while index < id.digest.len():
        val code = id.digest.char_code_at(index)
        val digit = code >= 48 and code <= 57
        val lower_hex = code >= 97 and code <= 102
        if not digit and not lower_hex: return false
        index = index + 1
    true

export ArtifactId, artifact_id, artifact_id_valid
