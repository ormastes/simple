# Iterator transformation functions

use std.iterator.create.{Iterator}

fn iter_take<T>(iter: Iterator<T>, n: i64) -> Iterator<T>:
    """Return an iterator that yields at most n elements.

    Previously this was `iter` -- the identity function -- so the bound was
    silently discarded and every `take(gen, n)` was unbounded.  A negative n is
    clamped to 0 (yield nothing) rather than being reinterpreted as unbounded.
    """
    var bound = n
    if bound < 0:
        bound = 0
    # An existing tighter bound must win: take(take(g, 2), 5) yields 2, not 5.
    if iter.limit >= 0 and iter.limit < bound:
        bound = iter.limit
    Iterator(state: iter.state, next_fn: iter.next_fn, limit: bound)

export iter_take
