# Iterator creation functions
#
# An Iterator is a lazy state machine: `state` is the value the iterator is
# currently sitting on, and `next_fn` advances it.
#
# `next_fn` receives the current state and returns a 2-tuple
# `(next_state, should_continue)`.  This is the contract std.generator has
# always documented and used; the older `fn(T) -> Option<T>` annotation here
# never matched a single call site and is not what any caller passes.
#
# `limit` is the maximum number of elements the iterator will yield.
# A negative limit means "unbounded" -- termination is then decided solely by
# the `should_continue` flag returned from `next_fn`.

class Iterator<T>:
    state: T
    next_fn: fn(T) -> (T, bool)
    limit: i64

fn iter_from_function<T>(initial: T, step_fn: fn(T) -> (T, bool)) -> Iterator<T>:
    """Create an unbounded iterator from an initial state and a step function."""
    Iterator(state: initial, next_fn: step_fn, limit: 0 - 1)

export Iterator, iter_from_function
