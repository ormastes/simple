# codex-impl
# Pure Simple owns this canonical provider comparison vocabulary.

pub enum RtHalProviderKind:
    PureSimple
    CComparator
    RustComparator
    Custom

pub struct RtHalProvider:
    provider_id: text
    kind: RtHalProviderKind
    abi_version: i64
    schema_version: i64
    query_capable: bool
    replay_capable: bool

pub enum RtHalOutcomeStatus:
    Value
    Error
    Blocked
    Unsupported
    TimedOut

pub struct RtHalOutcome:
    status: RtHalOutcomeStatus
    code: text
    value_hash: text
    effect_hash: text

pub struct RtHalComparison:
    providers: [RtHalProvider]
    worker_count: i64
    queue_capacity: i64
    timeout_ticks: i64
    max_output_bytes: i64
    require_all: bool

pub struct RtHalComparedResult:
    provider_ordinal: i64
    case_id: i64
    provider_id: text
    outcome: RtHalOutcome
    matches_pure: bool

pub enum RtHalOperationKind:
    Query
    Effectful

pub enum RtHalWorkMode:
    ExecuteQuery
    ExecuteEffect
    ReplayTrace

pub struct RtHalRequest:
    case_id: i64
    operation: RtHalOperationKind
    operation_id: text
    input_hash: text
    replay_hash: text

pub struct RtHalWorkItem:
    provider_ordinal: i64
    case_index: i64
    case_id: i64
    provider_id: text
    mode: RtHalWorkMode
    operation_id: text
    input_hash: text
    replay_hash: text
    supported: bool
    admission_code: text

pub struct RtHalChildResult:
    provider_ordinal: i64
    case_index: i64
    case_id: i64
    provider_id: text
    mode: RtHalWorkMode
    outcome: RtHalOutcome

pub fn rt_hal_provider_error(provider: RtHalProvider) -> text:
    if provider.provider_id.trim() == "":
        return "RTHAL-E-PROVIDER-ID"
    if provider.abi_version <= 0 or provider.schema_version <= 0:
        return "RTHAL-E-PROVIDER-ABI"
    if provider.kind != RtHalProviderKind.PureSimple and not provider.query_capable and not provider.replay_capable:
        return "RTHAL-E-PROVIDER-CAPABILITY"
    ""

pub fn rt_hal_comparison_error(comparison: RtHalComparison) -> text:
    if comparison.worker_count <= 0 or comparison.queue_capacity <= 0:
        return "RTHAL-E-BOUND"
    if comparison.worker_count > comparison.queue_capacity:
        return "RTHAL-E-BOUND"
    if comparison.timeout_ticks <= 0 or comparison.max_output_bytes <= 0:
        return "RTHAL-E-BOUND"
    if comparison.providers.len() <= 0 or comparison.providers.len() > comparison.queue_capacity:
        return "RTHAL-E-BOUND"
    var pure_count = 0
    var provider_index = 0
    for provider in comparison.providers:
        val provider_error = rt_hal_provider_error(provider)
        if provider_error != "":
            return provider_error
        if provider.kind == RtHalProviderKind.PureSimple:
            pure_count = pure_count + 1
            if provider_index != 0:
                return "RTHAL-E-PURE-ORDER"
        elif provider.abi_version != comparison.providers[0].abi_version or provider.schema_version != comparison.providers[0].schema_version:
            return "RTHAL-E-PROVIDER-ABI"
        var prior_index = 0
        while prior_index < provider_index:
            if comparison.providers[prior_index].provider_id == provider.provider_id:
                return "RTHAL-E-PROVIDER-DUPLICATE"
            prior_index = prior_index + 1
        provider_index = provider_index + 1
    if pure_count != 1:
        return "RTHAL-E-PURE-OWNER"
    ""

pub fn rt_hal_request_error(request: RtHalRequest) -> text:
    if request.case_id < 0 or request.operation_id.trim() == "" or request.input_hash.trim() == "":
        return "RTHAL-E-REQUEST"
    if request.operation == RtHalOperationKind.Effectful and request.replay_hash.trim() == "":
        return "RTHAL-E-UNSAFE-REPLAY"
    ""

pub fn rt_hal_requests_error(requests: [RtHalRequest]) -> text:
    if requests.len() <= 0:
        return "RTHAL-E-BOUND"
    var index = 0
    while index < requests.len():
        val request_error = rt_hal_request_error(requests[index])
        if request_error != "":
            return request_error
        if index > 0:
            if requests[index].case_id == requests[index - 1].case_id:
                return "RTHAL-E-CASE-DUPLICATE"
            if requests[index].case_id < requests[index - 1].case_id:
                return "RTHAL-E-CASE-ORDER"
        index = index + 1
    ""

# Returns -1 when fixed records plus provider/request text exceed the cap.
pub fn rt_hal_retained_plan_bytes(comparison: RtHalComparison, requests: [RtHalRequest], fixed_slot_bytes: i64) -> i64:
    if fixed_slot_bytes <= 0 or comparison.max_output_bytes <= 0:
        return -1
    if comparison.providers.len() <= 0 or requests.len() <= 0:
        return -1
    if requests.len() > comparison.queue_capacity / comparison.providers.len():
        return -1
    val slot_count = comparison.providers.len() * requests.len()
    if slot_count > comparison.max_output_bytes / fixed_slot_bytes:
        return -1
    var retained = slot_count * fixed_slot_bytes
    for provider in comparison.providers:
        if provider.provider_id.len() > comparison.max_output_bytes - retained:
            return -1
        retained = retained + provider.provider_id.len()
    for request in requests:
        if request.operation_id.len() > comparison.max_output_bytes - retained:
            return -1
        retained = retained + request.operation_id.len()
        if request.input_hash.len() > comparison.max_output_bytes - retained:
            return -1
        retained = retained + request.input_hash.len()
        if request.replay_hash.len() > comparison.max_output_bytes - retained:
            return -1
        retained = retained + request.replay_hash.len()
    retained

pub fn rt_hal_work_mode(provider: RtHalProvider, request: RtHalRequest) -> RtHalWorkMode:
    if provider.kind == RtHalProviderKind.PureSimple:
        if request.operation == RtHalOperationKind.Effectful:
            return RtHalWorkMode.ExecuteEffect
        return RtHalWorkMode.ExecuteQuery
    if request.operation == RtHalOperationKind.Effectful:
        return RtHalWorkMode.ReplayTrace
    RtHalWorkMode.ExecuteQuery

pub fn rt_hal_work_item_error(provider: RtHalProvider, request: RtHalRequest, mode: RtHalWorkMode) -> text:
    val request_error = rt_hal_request_error(request)
    if request_error != "":
        return request_error
    val required_mode = rt_hal_work_mode(provider, request)
    if mode != required_mode:
        if request.operation == RtHalOperationKind.Effectful:
            return "RTHAL-E-UNSAFE-REPLAY"
        return "RTHAL-E-RESULT-MODE"
    if provider.kind == RtHalProviderKind.PureSimple:
        if mode == RtHalWorkMode.ReplayTrace:
            return "RTHAL-E-PURE-OWNER"
        if mode == RtHalWorkMode.ExecuteQuery and not provider.query_capable:
            return "RTHAL-W-UNSUPPORTED"
        return ""
    if mode == RtHalWorkMode.ExecuteEffect:
        return "RTHAL-E-UNSAFE-REPLAY"
    if mode == RtHalWorkMode.ReplayTrace and not provider.replay_capable:
        return "RTHAL-W-UNSUPPORTED"
    if mode == RtHalWorkMode.ExecuteQuery and not provider.query_capable:
        return "RTHAL-W-UNSUPPORTED"
    ""

pub fn rt_hal_default_comparison(enable_c: bool, enable_rust: bool, worker_count: i64, queue_capacity: i64, timeout_ticks: i64, max_output_bytes: i64, require_all: bool) -> RtHalComparison:
    var providers: [RtHalProvider] = [RtHalProvider(
        provider_id: "pure-simple", kind: RtHalProviderKind.PureSimple,
        abi_version: 1, schema_version: 1, query_capable: true,
        replay_capable: true
    )]
    if enable_c:
        providers.push(RtHalProvider(
            provider_id: "c-comparator", kind: RtHalProviderKind.CComparator,
            abi_version: 1, schema_version: 1, query_capable: true,
            replay_capable: true
        ))
    if enable_rust:
        providers.push(RtHalProvider(
            provider_id: "rust-comparator", kind: RtHalProviderKind.RustComparator,
            abi_version: 1, schema_version: 1, query_capable: true,
            replay_capable: true
        ))
    RtHalComparison(
        providers: providers, worker_count: worker_count,
        queue_capacity: queue_capacity, timeout_ticks: timeout_ticks,
        max_output_bytes: max_output_bytes, require_all: require_all
    )

pub fn rt_hal_build_work_items(comparison: RtHalComparison, requests: [RtHalRequest]) -> [RtHalWorkItem]:
    var work: [RtHalWorkItem] = []
    if rt_hal_comparison_error(comparison) != "":
        return work
    if rt_hal_requests_error(requests) != "":
        return work
    if requests.len() <= 0 or requests.len() > comparison.queue_capacity / comparison.providers.len():
        return work
    var case_index = 0
    while case_index < requests.len():
        val request = requests[case_index]
        var provider_ordinal = 0
        while provider_ordinal < comparison.providers.len():
            val provider = comparison.providers[provider_ordinal]
            val mode = rt_hal_work_mode(provider, request)
            val admission_code = rt_hal_work_item_error(provider, request, mode)
            work.push(RtHalWorkItem(
                provider_ordinal: provider_ordinal, case_index: case_index,
                case_id: request.case_id, provider_id: provider.provider_id,
                mode: mode, operation_id: request.operation_id,
                input_hash: request.input_hash, replay_hash: request.replay_hash,
                supported: admission_code == "", admission_code: admission_code
            ))
            provider_ordinal = provider_ordinal + 1
        case_index = case_index + 1
    work

pub fn rt_hal_outcomes_match(pure: RtHalOutcome, candidate: RtHalOutcome) -> bool:
    (pure.status == candidate.status
        and pure.code == candidate.code
        and pure.value_hash == candidate.value_hash
        and pure.effect_hash == candidate.effect_hash)
