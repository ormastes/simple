# P10 — Duplicate-detection primitives: shingling, MinHash, SimHash.
#
# Design: doc/05_design/infra/spipe/spipe_knowledge_compiler_search_providers.md §7
# Plan:   doc/03_plan/infra/spipe/spipe_search_providers_impl_plan.md — P10
#
# Ground truth (verified 2026-08-31): no MinHash/SimHash/shingling existed
# anywhere in the tree before this file — this is greenfield, not extraction.
# Only `math_utils.spl`'s dense cosine and `features.spl`'s sparse
# token-frequency + cosine (compiler/90.tools/duplicate_check) predate this.
#
# Non-ASCII safety: shingles are built over an already-tokenized stream
# (`[text]` produced by the caller via the shared analyzer seam,
# `std.common.search.analyzer.analyze_field_v1` — never re-tokenized here) so
# this module never indexes `text` by byte or by codepoint itself. That
# sidesteps the `text.len()` (bytes) vs `s[i]`/`char_at` (chars) trap by
# construction instead of by careful arithmetic. All hashing/scoring below is
# fixed-point `i64` — no `f64` anywhere in this file.
#
# Fixed-point convention: similarity/jaccard estimates are scaled by
# `SIMILARITY_SCALE` (1_000_000), matching the fixed-point convention used
# elsewhere in this package (e.g. `SCORE_CONTRACT_ID = "bm25-fixed-v1"`).

pub val SIMILARITY_SCALE: i64 = 1000000
val HASH_MODULUS: i64 = 1000000007
val SIMHASH_BITS: i64 = 64

# --- Stable integer hash over a token/shingle string --------------------

pub fn stable_hash64(s: text) -> i64:
    """FNV-1a-style rolling hash over the string's bytes, folded into a
    positive i64 modulo a large prime. Deterministic and pure integer."""
    var hash: i64 = 1469598103934665603
    val bytes = s.bytes()
    var i = 0
    while i < bytes.len():
        hash = hash ^ (bytes[i] * 1)
        hash = (hash * 1099511628211) % HASH_MODULUS
        if hash < 0:
            hash = hash + HASH_MODULUS
        i = i + 1
    hash

# --- Shingling over a pre-tokenized stream -------------------------------

pub struct ShingleSetV1:
    hashes: [i64]

pub fn shingles_of_tokens(tokens: [text], k: i64) -> ShingleSetV1:
    """Build k-token (word) shingles from an already-tokenized stream and
    hash each window. k < 1 falls back to k = 1 (unigram shingles)."""
    val window = if k < 1: 1 else: k
    if tokens.len() == 0:
        return ShingleSetV1(hashes: [])
    var hashes: [i64] = []
    var i = 0
    val last_start = tokens.len() - window
    val bound = if last_start < 0: 0 else: last_start
    while i <= bound:
        var joined = ""
        var j = 0
        while j < window and (i + j) < tokens.len():
            if j > 0:
                joined = joined + ""
            joined = joined + tokens[i + j]
            j = j + 1
        hashes.push(stable_hash64(joined))
        i = i + 1
        if window > tokens.len():
            i = bound + 1
    ShingleSetV1(hashes: dedupe_sorted_i64(hashes))

fn dedupe_sorted_i64(values: [i64]) -> [i64]:
    var sorted: [i64] = values
    # insertion sort — shingle counts per document are small and bounded
    var i = 1
    while i < sorted.len():
        val v = sorted[i]
        var j = i - 1
        while j >= 0 and sorted[j] > v:
            sorted[j + 1] = sorted[j]
            j = j - 1
        sorted[j + 1] = v
        i = i + 1
    var out: [i64] = []
    var k = 0
    while k < sorted.len():
        if k == 0 or sorted[k] != sorted[k - 1]:
            out.push(sorted[k])
        k = k + 1
    out

# --- MinHash --------------------------------------------------------------

pub struct MinHashSignatureV1:
    values: [i64]

# Fixed small odd coefficients for the permutation family h_i(x) = (a_i*x + b_i) mod P.
# Deterministic across runs — required for pinned-report parity.
fn minhash_coeff_a(index: i64) -> i64:
    (index * 2654435761 + 1) % HASH_MODULUS

fn minhash_coeff_b(index: i64) -> i64:
    (index * 2246822519 + 7) % HASH_MODULUS

pub fn minhash_signature(shingles: ShingleSetV1, num_hashes: i64) -> MinHashSignatureV1:
    """Compute a MinHash signature of `num_hashes` values over a shingle set."""
    val n = if num_hashes < 1: 1 else: num_hashes
    var values: [i64] = []
    var h = 0
    while h < n:
        val a = minhash_coeff_a(h)
        val b = minhash_coeff_b(h)
        var min_val: i64 = -1
        var i = 0
        while i < shingles.hashes.len():
            var v = (a * shingles.hashes[i] + b) % HASH_MODULUS
            if v < 0:
                v = v + HASH_MODULUS
            if min_val < 0 or v < min_val:
                min_val = v
            i = i + 1
        if min_val < 0:
            min_val = 0
        values.push(min_val)
        h = h + 1
    MinHashSignatureV1(values: values)

pub fn minhash_jaccard_estimate(a: MinHashSignatureV1, b: MinHashSignatureV1) -> i64:
    """Estimate Jaccard similarity from two equal-length MinHash signatures,
    fixed-point scaled by SIMILARITY_SCALE. Returns 0 for mismatched/empty
    signatures."""
    if a.values.len() == 0 or a.values.len() != b.values.len():
        return 0
    var matches = 0
    var i = 0
    while i < a.values.len():
        if a.values[i] == b.values[i]:
            matches = matches + 1
        i = i + 1
    (matches * SIMILARITY_SCALE) / a.values.len()

# --- SimHash ----------------------------------------------------------------

pub struct SimHashFingerprintV1:
    bits: i64

pub fn simhash_fingerprint(shingles: ShingleSetV1) -> SimHashFingerprintV1:
    """Compute a 64-bit weighted-bit-vote SimHash fingerprint over a shingle
    set. Each shingle hash votes +1/-1 on each of the 64 bit positions;
    positions with a non-negative total set the corresponding output bit."""
    var totals: [i64] = []
    var bit = 0
    while bit < SIMHASH_BITS:
        totals.push(0)
        bit = bit + 1
    var i = 0
    while i < shingles.hashes.len():
        val h = shingles.hashes[i]
        var b = 0
        while b < SIMHASH_BITS:
            val bit_set = (h / pow2(b)) % 2 == 1
            if bit_set:
                totals[b] = totals[b] + 1
            else:
                totals[b] = totals[b] - 1
            b = b + 1
        i = i + 1
    var result: i64 = 0
    var b2 = 0
    while b2 < SIMHASH_BITS:
        if totals[b2] >= 0:
            result = result + pow2(b2)
        b2 = b2 + 1
    SimHashFingerprintV1(bits: result)

fn pow2(n: i64) -> i64:
    var r: i64 = 1
    var i = 0
    while i < n:
        r = r * 2
        i = i + 1
    r

pub fn hamming_distance64(a: i64, b: i64) -> i64:
    """Count differing bits between two 64-bit fingerprints, integer-only."""
    var x = a ^ b
    var count = 0
    var i = 0
    while i < SIMHASH_BITS:
        if (x / pow2(i)) % 2 == 1:
            count = count + 1
        i = i + 1
    count

pub fn simhash_similarity(a: SimHashFingerprintV1, b: SimHashFingerprintV1) -> i64:
    """Similarity from Hamming distance, fixed-point scaled by SIMILARITY_SCALE:
    1.0 for identical fingerprints, 0.0 for maximally different ones."""
    val dist = hamming_distance64(a.bits, b.bits)
    val remaining = SIMHASH_BITS - dist
    (remaining * SIMILARITY_SCALE) / SIMHASH_BITS
