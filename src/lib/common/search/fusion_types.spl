# Frozen §3.5/§5.3/§5.5 fusion and source records. Declarations only — P4
# (`src/app/spipe/fusion/*`) implements `rrf-fixed-v1` and the exact-identity
# dominance tier over these types. Zero algorithm lives here.

pub enum FusionSourceV1:
    Lexical
    Graph
    Semantic

pub struct SourceCandidateV1:
    document_id: text
    source_rank: i64
    source_score_milli: i64

pub struct SourceRankingV1:
    source: FusionSourceV1
    source_contract: text
    snapshot_id: text
    scope_digest: text
    candidates: [SourceCandidateV1]
    complete: bool
    source_digest: text

pub val RRF_FIXED_V1_ID: text  = "rrf-fixed-v1"
pub val RRF_DEFAULT_K: i64     = 60
pub val RRF_MIN_K: i64         = 1
pub val RRF_MAX_K: i64         = 10000
pub val RRF_DEFAULT_SOURCE_K: i64 = 1000
pub val RRF_MAX_SOURCE_K: i64  = 1000
pub val RRF_MAX_POOL: i64      = 3000
pub val RRF_BOOST_CAP_PERMILLE: i64 = 250

# Match tier for a fused hit. `ExactIdentity` sits OUTSIDE RRF (plan hazard
# §6.11): rank 1, no fused rank/score, never encoded as an IDF or score boost.
pub enum MatchTierV1:
    ExactIdentity
    Fused

pub struct FusedHitV1:
    document_id: text
    match_tier: MatchTierV1
    final_rank: i64
    rrf_raw_scaled: i64
    rrf_adjusted_scaled: i64

pub struct IdentityExplanationV1:
    resolved_uid: text
    matched_key: text
    alias_authority: text
    alias_status: text
    registry_generation: i64
    visibility_decision: text
    pinned_rank: i64

impl IdentityExplanationV1:
    fn has_frozen_pinned_rank() -> bool:
        self.pinned_rank == 1

pub struct FusionExplanationV1:
    contract: text
    k: i64
    source_k: i64
    source_names: [text]
    source_ranks: [i64]
    source_contributions_scaled: [i64]
    adjustments: [text]
    adjustment_caps_scaled: [i64]
    raw_sum_scaled: i64
    adjusted_sum_scaled: i64
    tie_break_document_id: text
