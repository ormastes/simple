# ============================================================================
# common/search/ranking.spl — lexical ranking (TF-IDF + Okapi BM25) -> Score
#
# Phase 2 of the custom-type alpha search team plan
# (doc/03_plan/lib/search/custom_type_alpha_search_team_plan_2026-06-15.md).
#
# Produces behavior-carrying `Score` values from term frequencies, document
# lengths, average document length, and document frequencies, plus a top-k
# selector over `Score`.
#
# WHY FIXED-POINT: f64 is unreliable across this repo's backends (returns
# 0.0 / garbage — MEMORY: "f64 Unreliable All Backends",
# bug interp_f64_nested_struct_payload_zero_2026-06-14). All arithmetic here is
# integer fixed-point. Internal precision is SCALE = 1_000_000; results are
# stored in `Score` at its native milli scale (raw = value * 1000) so the public
# values are deterministic and integer-verifiable.
#
# IDF uses the non-negative (Lucene) form  ln(1 + (N - df + 0.5)/(df + 0.5))
# so scores stay >= 0 and "higher is better" holds for top-k.
#
# `bm25-fixed-v1` is the checked contract used by providers and adapters.  Its
# operation order is frozen by the Knowledge Compiler search-provider design.
# This runtime has no i128, so every conceptual i128 operation first proves the
# same i64 result.  A value that cannot be represented fails with
# `score_overflow`; it is never wrapped, saturated, reassociated, or rounded.
#
# KNOWN BUGS designed around:
#   * no for-in over custom structs -> index/counter loops only.
#   * `text + i64` produces garbage -> never concatenate; we never build text.
# ============================================================================

use std.common.search.types.{Score}

# Internal fixed-point scale (1e6). Score's public scale is milli (1e3), so the
# bridge from internal raw -> Score.raw is `internal / SCALE_TO_MILLI`.
val SCALE: i64 = 1000000
val SCALE_TO_MILLI: i64 = 1000

# ln(2) * SCALE, used by range-reduction in `fixed_ln`.
val LN2_FIXED: i64 = 693147

# BM25 parameters as fixed-point constants (defaults k1 = 1.2, b = 0.75).
val K1_DEFAULT: i64 = 1200000
val B_DEFAULT: i64 = 750000
val I64_MAX_VALUE: i64 = 9223372036854775807
val I64_MIN_VALUE: i64 = -9223372036854775807 - 1

# Stable error codes.  Provider boundaries may carry these directly because
# they are members of the closed Wave-4 error vocabulary.
val BM25_INVALID_CORPUS_N: text = "invalid_corpus_n"
val BM25_INVALID_DOCUMENT_FREQUENCY: text = "invalid_document_frequency"
val BM25_INVALID_AVERAGE_LENGTH: text = "invalid_average_length"
val BM25_INVALID_DENOMINATOR: text = "invalid_denominator"
val BM25_INVALID_PARALLEL_ARRAYS: text = "invalid_parallel_arrays"
val BM25_INVALID_LOGARITHM_INPUT: text = "invalid_logarithm_input"
val BM25_SCORE_OVERFLOW: text = "score_overflow"
val BM25_INVALID_REQUEST: text = "invalid_request"
val BM25_LIMIT_EXCEEDED: text = "limit_exceeded"
val BM25_MAX_QUERY_TERMS: i64 = 128
val BM25_MAX_TERM_UTF8_BYTES: i64 = 4096

fn _checked_add_i64(a: i64, b: i64) -> Result<i64, text>:
    if b > 0 and a > I64_MAX_VALUE - b:
        return Err(BM25_SCORE_OVERFLOW)
    if b < 0 and a < I64_MIN_VALUE - b:
        return Err(BM25_SCORE_OVERFLOW)
    Ok(a + b)

fn _checked_mul_nonnegative(a: i64, b: i64) -> Result<i64, text>:
    if a < 0 or b < 0:
        return Err(BM25_SCORE_OVERFLOW)
    if a == 0 or b == 0:
        return Ok(0)
    if a > I64_MAX_VALUE / b:
        return Err(BM25_SCORE_OVERFLOW)
    Ok(a * b)

fn _checked_mul_signed_nonnegative(a: i64, b: i64) -> Result<i64, text>:
    if b < 0:
        return Err(BM25_SCORE_OVERFLOW)
    if a >= 0:
        return _checked_mul_nonnegative(a, b)
    if b == 0:
        return Ok(0)
    if a < I64_MIN_VALUE / b:
        return Err(BM25_SCORE_OVERFLOW)
    Ok(a * b)

fn _checked_div_nonnegative(a: i64, b: i64, invalid_code: text) -> Result<i64, text>:
    if a < 0:
        return Err(BM25_SCORE_OVERFLOW)
    if b <= 0:
        return Err(invalid_code)
    Ok(a / b)

fn _utf8_text_lt(a: text, b: text) -> bool:
    # Native `<` compares text pointers on some backends.  Contract ordering is
    # ascending unsigned UTF-8 bytes, so compare materialized bytes explicitly.
    val ab = a.bytes()
    val bb = b.bytes()
    var i = 0
    while i < ab.len() and i < bb.len():
        val av = ab[i].to_i64()
        val bv = bb[i].to_i64()
        if av < bv:
            return true
        if av > bv:
            return false
        i = i + 1
    ab.len() < bb.len()

struct Bm25TermTrace:
    average_length_scaled: i64
    ratio_scaled: i64
    norm_scaled: i64
    denominator_scaled: i64
    tf_scaled: i64
    idf_argument_scaled: i64
    idf_scaled: i64
    unweighted: i64
    weighted: i64

impl Bm25TermTrace:
    fn weighted_decimal() -> text: self.weighted.to_text()

fn _bm25_absent_trace() -> Bm25TermTrace:
    Bm25TermTrace(
        average_length_scaled: 0,
        ratio_scaled: 0,
        norm_scaled: 0,
        denominator_scaled: 0,
        tf_scaled: 0,
        idf_argument_scaled: 0,
        idf_scaled: 0,
        unweighted: 0,
        weighted: 0,
    )

# One authorized field of one document.  Field order and weight are derived by
# the canonical scorer rather than selected by a provider.
struct Bm25FieldV1:
    field_name: text
    term_keys: [text]
    term_frequencies: [i64]
    document_frequencies: [i64]
    document_length: i64
    total_field_length: i64
    num_docs: i64

impl Bm25FieldV1:
    static fn of(field_name: text, term_keys: [text],
                 term_frequencies: [i64], document_frequencies: [i64],
                 document_length: i64, total_field_length: i64,
                 num_docs: i64) -> Bm25FieldV1:
        Bm25FieldV1(
            field_name: field_name,
            term_keys: term_keys,
            term_frequencies: term_frequencies,
            document_frequencies: document_frequencies,
            document_length: document_length,
            total_field_length: total_field_length,
            num_docs: num_docs,
        )

# Internal normalized input consumed by the sole document accumulator.  A
# legacy average-based facade sets `has_canonical_term_keys=false`; only the
# canonical v1 wrapper may set it true after exact total-length validation.
struct _Bm25PreparedField:
    term_keys: [text]
    term_frequencies: [i64]
    document_frequencies: [i64]
    document_length: i64
    average_length_scaled: i64
    num_docs: i64
    weight_milli: i64
    k1: i64
    b: i64
    has_canonical_term_keys: bool

# ----------------------------------------------------------------------------
# Fixed-point primitives
# ----------------------------------------------------------------------------
fn fx_mul(a: i64, b: i64) -> i64:
    """Fixed-point multiply: (a * b) rescaled back down by SCALE."""
    (a * b) / SCALE

fn fx_div(a: i64, b: i64) -> i64:
    """Fixed-point divide: (a / b) keeping SCALE precision. b must be != 0."""
    (a * SCALE) / b

fn fx_from_int(n: i64) -> i64:
    """Lift a whole number into fixed-point."""
    n * SCALE

# ----------------------------------------------------------------------------
# Checked fixed_ln — exact bm25-fixed-v1 operation order
# ----------------------------------------------------------------------------
fn fixed_ln_checked(x: i64) -> Result<i64, text>:
    if x <= 0:
        return Err(BM25_INVALID_LOGARITHM_INPUT)
    var m = x
    var exponent: i64 = 0
    while m >= 2 * SCALE:
        m = m / 2
        exponent = _checked_add_i64(exponent, 1)?
    while m < SCALE:
        m = _checked_mul_nonnegative(m, 2)?
        exponent = _checked_add_i64(exponent, 0 - 1)?
    if m < SCALE or m >= 2 * SCALE:
        return Err(BM25_INVALID_LOGARITHM_INPUT)

    val y_numerator = _checked_mul_nonnegative(m - SCALE, SCALE)?
    val y_denominator = _checked_add_i64(m, SCALE)?
    val y = _checked_div_nonnegative(
        y_numerator, y_denominator, BM25_INVALID_DENOMINATOR)?
    val y_squared_product = _checked_mul_nonnegative(y, y)?
    val y_squared = _checked_div_nonnegative(
        y_squared_product, SCALE, BM25_INVALID_DENOMINATOR)?
    var power = y
    var sum = y
    var denominator: i64 = 3
    while denominator <= 13:
        val power_product = _checked_mul_nonnegative(power, y_squared)?
        power = _checked_div_nonnegative(
            power_product, SCALE, BM25_INVALID_DENOMINATOR)?
        val addend = _checked_div_nonnegative(
            power, denominator, BM25_INVALID_DENOMINATOR)?
        sum = _checked_add_i64(sum, addend)?
        denominator = _checked_add_i64(denominator, 2)?
    val series = _checked_mul_nonnegative(2, sum)?
    val exponent_part = _checked_mul_signed_nonnegative(exponent, LN2_FIXED)?
    _checked_add_i64(series, exponent_part)

# Legacy non-claiming facade.  New BM25 code calls `fixed_ln_checked` and
# propagates its typed failure; historical TF-IDF callers retain zero-on-error.
fn fixed_ln(x: i64) -> i64:
    val result = fixed_ln_checked(x)
    if result.is_err():
        return 0
    result.unwrap()

# ----------------------------------------------------------------------------
# IDF (inverse document frequency), fixed-point, non-negative (Lucene form)
# ----------------------------------------------------------------------------
# idf = ln(1 + (N - df + 0.5)/(df + 0.5)) = ln(1 + (2N - 2df + 1)/(2df + 1)).
# Halves are cleared to pure integers before the ratio so no f64 is touched.
fn _idf_fixed_checked(num_docs: i64, doc_freq: i64) -> Result<(i64, i64), text>:
    if num_docs <= 0:
        return Err(BM25_INVALID_CORPUS_N)
    if doc_freq < 0 or doc_freq > num_docs:
        return Err(BM25_INVALID_DOCUMENT_FREQUENCY)
    val twice_n = _checked_mul_nonnegative(2, num_docs)?
    val twice_df = _checked_mul_nonnegative(2, doc_freq)?
    val numerator_without_one = twice_n - twice_df
    val numerator = _checked_add_i64(numerator_without_one, 1)?
    val numerator_scaled = _checked_mul_nonnegative(numerator, SCALE)?
    val denominator = _checked_add_i64(twice_df, 1)?
    val ratio = _checked_div_nonnegative(
        numerator_scaled, denominator, BM25_INVALID_DENOMINATOR)?
    val argument = _checked_add_i64(SCALE, ratio)?
    val idf = fixed_ln_checked(argument)?
    Ok((argument, idf))

fn idf_fixed(num_docs: i64, doc_freq: i64) -> i64:
    val result = _idf_fixed_checked(num_docs, doc_freq)
    if result.is_err():
        return 0
    result.unwrap().1

# ----------------------------------------------------------------------------
# TF-IDF — simple lexical weight (tf * idf), fixed-point
# ----------------------------------------------------------------------------
fn tfidf_term_fixed(tf: i64, num_docs: i64, doc_freq: i64) -> i64:
    """Internal fixed-point tf-idf weight for one term in one document."""
    if tf <= 0:
        return 0
    val idf = idf_fixed(num_docs, doc_freq)
    fx_mul(fx_from_int(tf), idf)

# ----------------------------------------------------------------------------
# Canonical checked BM25 term/document scorers
# ----------------------------------------------------------------------------
fn _bm25_average_checked(total_field_length: i64,
                         num_docs: i64) -> Result<i64, text>:
    if num_docs <= 0:
        return Err(BM25_INVALID_CORPUS_N)
    if total_field_length <= 0:
        return Err(BM25_INVALID_AVERAGE_LENGTH)
    val total_scaled = _checked_mul_nonnegative(total_field_length, SCALE)?
    val average = _checked_div_nonnegative(
        total_scaled, num_docs, BM25_INVALID_CORPUS_N)?
    if average <= 0:
        return Err(BM25_INVALID_AVERAGE_LENGTH)
    Ok(average)

fn _bm25_term_from_average_checked(tf: i64, document_length: i64,
                                    average_length_scaled: i64,
                                    num_docs: i64,
                                    document_frequency: i64,
                                    weight_milli: i64,
                                    k1: i64, b: i64) -> Result<Bm25TermTrace, text>:
    if tf <= 0 or document_length < 0 or tf > document_length or (
        weight_milli < 0):
        return Err(BM25_INVALID_REQUEST)
    if num_docs <= 0:
        return Err(BM25_INVALID_CORPUS_N)
    if document_frequency < 0 or document_frequency > num_docs:
        return Err(BM25_INVALID_DOCUMENT_FREQUENCY)
    if average_length_scaled <= 0:
        return Err(BM25_INVALID_AVERAGE_LENGTH)
    if k1 < 0 or b < 0 or b > SCALE:
        return Err(BM25_INVALID_REQUEST)

    val document_scaled = _checked_mul_nonnegative(document_length, SCALE)?
    val document_scaled_twice = _checked_mul_nonnegative(document_scaled, SCALE)?
    val ratio = _checked_div_nonnegative(
        document_scaled_twice, average_length_scaled,
        BM25_INVALID_DENOMINATOR)?
    val weighted_ratio_product = _checked_mul_nonnegative(b, ratio)?
    val weighted_ratio = _checked_div_nonnegative(
        weighted_ratio_product, SCALE, BM25_INVALID_DENOMINATOR)?
    val norm = _checked_add_i64(SCALE - b, weighted_ratio)?
    val k_norm_product = _checked_mul_nonnegative(k1, norm)?
    val k_norm = _checked_div_nonnegative(
        k_norm_product, SCALE, BM25_INVALID_DENOMINATOR)?
    val tf_base = _checked_mul_nonnegative(tf, SCALE)?
    val denominator = _checked_add_i64(tf_base, k_norm)?
    if denominator <= 0:
        return Err(BM25_INVALID_DENOMINATOR)
    val k1_plus_scale = _checked_add_i64(k1, SCALE)?
    val tf_numerator = _checked_mul_nonnegative(tf, k1_plus_scale)?
    val tf_numerator_scaled = _checked_mul_nonnegative(tf_numerator, SCALE)?
    val tf_scaled = _checked_div_nonnegative(
        tf_numerator_scaled, denominator, BM25_INVALID_DENOMINATOR)?
    val idf_pair = _idf_fixed_checked(num_docs, document_frequency)?
    val idf_argument = idf_pair.0
    val idf = idf_pair.1
    val unweighted_product = _checked_mul_nonnegative(idf, tf_scaled)?
    val unweighted = _checked_div_nonnegative(
        unweighted_product, SCALE, BM25_INVALID_DENOMINATOR)?
    val weighted_product = _checked_mul_nonnegative(unweighted, weight_milli)?
    val weighted = _checked_div_nonnegative(
        weighted_product, 1000, BM25_INVALID_DENOMINATOR)?
    Ok(Bm25TermTrace(
        average_length_scaled: average_length_scaled,
        ratio_scaled: ratio,
        norm_scaled: norm,
        denominator_scaled: denominator,
        tf_scaled: tf_scaled,
        idf_argument_scaled: idf_argument,
        idf_scaled: idf,
        unweighted: unweighted,
        weighted: weighted,
    ))

fn _is_bm25_fixed_v1_weight(weight_milli: i64) -> bool:
    weight_milli == 1000 or weight_milli == 2000 or (
        weight_milli == 2500 or weight_milli == 4000)

fn bm25_fixed_v1_term_checked(tf: i64, document_length: i64,
                              total_field_length: i64, num_docs: i64,
                              document_frequency: i64,
                              weight_milli: i64) -> Result<Bm25TermTrace, text>:
    if document_length < 0 or total_field_length < 0:
        return Err(BM25_INVALID_REQUEST)
    if total_field_length < document_length:
        return Err(BM25_INVALID_AVERAGE_LENGTH)
    if not _is_bm25_fixed_v1_weight(weight_milli):
        return Err(BM25_INVALID_REQUEST)
    if tf < 0:
        return Err(BM25_INVALID_REQUEST)
    if num_docs < 0:
        return Err(BM25_INVALID_CORPUS_N)
    if document_frequency < 0 or document_frequency > num_docs:
        return Err(BM25_INVALID_DOCUMENT_FREQUENCY)
    # The normative absent contribution evaluates none of average, IDF,
    # normalization, denominator, or division.
    if tf == 0:
        return Ok(_bm25_absent_trace())
    if tf > document_length:
        return Err(BM25_INVALID_REQUEST)
    val average = _bm25_average_checked(total_field_length, num_docs)?
    _bm25_term_from_average_checked(
        tf, document_length, average, num_docs, document_frequency,
        weight_milli, K1_DEFAULT, B_DEFAULT)

# Compatibility name used by current provider and DBFS adapters.  It is a thin
# alias of the canonical term scorer and owns no arithmetic.
fn bm25_term_checked_trace(tf: i64, document_length: i64,
                           total_field_length: i64, num_docs: i64,
                           document_frequency: i64,
                           weight_milli: i64) -> Result<Bm25TermTrace, text>:
    bm25_fixed_v1_term_checked(
        tf, document_length, total_field_length, num_docs,
        document_frequency, weight_milli)

fn _bm25_field_ordinal(field_name: text) -> i64:
    if field_name == "identifier":
        return 0
    if field_name == "title":
        return 1
    if field_name == "heading":
        return 2
    if field_name == "classification":
        return 3
    if field_name == "body":
        return 4
    0 - 1

fn _bm25_field_weight(ordinal: i64) -> i64:
    if ordinal == 0 or ordinal == 1:
        return 4000
    if ordinal == 2:
        return 2500
    if ordinal == 3:
        return 2000
    if ordinal == 4:
        return 1000
    0 - 1

fn _validate_prepared_field(field: _Bm25PreparedField) -> Result<(), text>:
    val count = field.term_frequencies.len()
    if count != field.document_frequencies.len():
        return Err(BM25_INVALID_PARALLEL_ARRAYS)
    if count > BM25_MAX_QUERY_TERMS:
        return Err(BM25_LIMIT_EXCEEDED)
    if field.has_canonical_term_keys and count != field.term_keys.len():
        return Err(BM25_INVALID_PARALLEL_ARRAYS)
    if field.num_docs <= 0:
        return Err(BM25_INVALID_CORPUS_N)
    if field.document_length < 0:
        return Err(BM25_INVALID_REQUEST)
    if field.average_length_scaled < 0:
        return Err(BM25_INVALID_AVERAGE_LENGTH)
    if field.weight_milli < 0 or field.k1 < 0 or field.b < 0 or (
        field.b > SCALE):
        return Err(BM25_INVALID_REQUEST)
    var i = 0
    while i < count:
        if field.has_canonical_term_keys:
            if field.term_keys[i].bytes().len() <= 0:
                return Err(BM25_INVALID_REQUEST)
            if field.term_keys[i].bytes().len() > BM25_MAX_TERM_UTF8_BYTES:
                return Err(BM25_LIMIT_EXCEEDED)
            if i > 0:
                # Strict ordering simultaneously proves canonical order and
                # rejects duplicates. qtf is explanation metadata only.
                if not _utf8_text_lt(
                    field.term_keys[i - 1], field.term_keys[i]):
                    return Err(BM25_INVALID_PARALLEL_ARRAYS)
        val tf = field.term_frequencies[i]
        val df = field.document_frequencies[i]
        if tf < 0 or tf > field.document_length:
            return Err(BM25_INVALID_REQUEST)
        if df < 0 or df > field.num_docs:
            return Err(BM25_INVALID_DOCUMENT_FREQUENCY)
        if tf > 0 and field.average_length_scaled <= 0:
            return Err(BM25_INVALID_AVERAGE_LENGTH)
        i = i + 1
    Ok(())

fn _bm25_score_prepared_checked(
    fields: [_Bm25PreparedField]) -> Result<Score, text>:
    var internal_total: i64 = 0
    var field_index = 0
    while field_index < fields.len():
        val field = fields[field_index]
        _validate_prepared_field(field)?
        var field_total: i64 = 0
        var term_index = 0
        while term_index < field.term_frequencies.len():
            val tf = field.term_frequencies[term_index]
            val df = field.document_frequencies[term_index]
            if tf > 0:
                val trace = _bm25_term_from_average_checked(
                    tf, field.document_length, field.average_length_scaled,
                    field.num_docs, df, field.weight_milli,
                    field.k1, field.b)?
                field_total = _checked_add_i64(field_total, trace.weighted)?
            term_index = term_index + 1
        internal_total = _checked_add_i64(internal_total, field_total)?
        field_index = field_index + 1
    # The only internal-scale -> public-milli conversion in the canonical
    # document scorer, after ordered term and field accumulation.
    val public_score_milli = _checked_div_nonnegative(
        internal_total, SCALE_TO_MILLI, BM25_INVALID_DENOMINATOR)?
    Ok(Score.from_milli(public_score_milli))

fn bm25_fixed_v1_score_checked(fields: [Bm25FieldV1]) -> Result<Score, text>:
    var prepared: [_Bm25PreparedField] = []
    var prior_ordinal: i64 = 0 - 1
    var canonical_terms: [text] = []
    var field_index = 0
    while field_index < fields.len():
        val field = fields[field_index]
        val ordinal = _bm25_field_ordinal(field.field_name)
        if ordinal < 0:
            return Err(BM25_INVALID_REQUEST)
        if ordinal <= prior_ordinal:
            return Err(BM25_INVALID_PARALLEL_ARRAYS)
        prior_ordinal = ordinal
        if field.num_docs <= 0:
            return Err(BM25_INVALID_CORPUS_N)
        if field.document_length < 0 or field.total_field_length < 0:
            return Err(BM25_INVALID_REQUEST)
        if field.document_length > field.total_field_length:
            return Err(BM25_INVALID_AVERAGE_LENGTH)
        if field_index == 0:
            canonical_terms = field.term_keys
        else:
            if field.term_keys.len() != canonical_terms.len():
                return Err(BM25_INVALID_PARALLEL_ARRAYS)
            var key_index = 0
            while key_index < canonical_terms.len():
                if field.term_keys[key_index] != canonical_terms[key_index]:
                    return Err(BM25_INVALID_PARALLEL_ARRAYS)
                key_index = key_index + 1
        var average: i64 = 0
        if field.total_field_length > 0:
            average = _bm25_average_checked(
                field.total_field_length, field.num_docs)?
        prepared.push(_Bm25PreparedField(
            term_keys: field.term_keys,
            term_frequencies: field.term_frequencies,
            document_frequencies: field.document_frequencies,
            document_length: field.document_length,
            average_length_scaled: average,
            num_docs: field.num_docs,
            weight_milli: _bm25_field_weight(ordinal),
            k1: K1_DEFAULT,
            b: B_DEFAULT,
            has_canonical_term_keys: true,
        ))
        field_index = field_index + 1
    _bm25_score_prepared_checked(prepared)

fn bm25_fixed_v1_precedes(left_score: Score, left_document_id: text,
                          right_score: Score, right_document_id: text) -> bool:
    if left_score.is_greater_than(right_score):
        return true
    if left_score.is_less_than(right_score):
        return false
    _utf8_text_lt(left_document_id, right_document_id)

# Historical average-based helpers are non-claiming compatibility facades.
# They reuse the one checked term path but cannot prove exact total length or
# distinct term keys because those facts are absent from their signatures.
fn bm25_term_fixed(tf: i64, doc_len: i64, avg_doc_len_fixed: i64,
                   num_docs: i64, doc_freq: i64, k1: i64, b: i64) -> i64:
    if tf <= 0:
        return 0
    val result = _bm25_term_from_average_checked(
        tf, doc_len, avg_doc_len_fixed, num_docs, doc_freq, 1000, k1, b)
    if result.is_err():
        return 0
    result.unwrap().weighted

# ----------------------------------------------------------------------------
# Document-level scorers — sum term contributions, return a Score (milli scale)
# ----------------------------------------------------------------------------
# Parallel arrays describe one document's query-term occurrences:
#   tfs[i]       = term frequency of query term i in this document
#   doc_freqs[i] = number of documents containing query term i (df)
# Shared scalars: doc_len, avg_doc_len_fixed (avgdl already in fixed-point),
# num_docs (N). The fixed-point internal sum is rescaled to Score's milli scale.

fn bm25_score(tfs: [i64], doc_freqs: [i64], doc_len: i64,
              avg_doc_len_fixed: i64, num_docs: i64, k1: i64, b: i64) -> Score:
    """Legacy zero-on-error facade; not a bm25-fixed-v1 conformance API."""
    val result = bm25_score_checked(
        tfs, doc_freqs, doc_len, avg_doc_len_fixed, num_docs, k1, b)
    if result.is_err():
        return Score.zero()
    result.unwrap()

fn bm25_score_default(tfs: [i64], doc_freqs: [i64], doc_len: i64,
                      avg_doc_len_fixed: i64, num_docs: i64) -> Score:
    """BM25 with the standard defaults k1 = 1.2, b = 0.75."""
    bm25_score(tfs, doc_freqs, doc_len, avg_doc_len_fixed, num_docs,
               K1_DEFAULT, B_DEFAULT)

fn bm25_score_checked(tfs: [i64], doc_freqs: [i64], doc_len: i64,
                      avg_doc_len_value: i64, num_docs: i64,
                      k1: i64, b: i64) -> Result<Score, text>:
    _bm25_score_prepared_checked([_Bm25PreparedField(
        term_keys: [],
        term_frequencies: tfs,
        document_frequencies: doc_freqs,
        document_length: doc_len,
        average_length_scaled: avg_doc_len_value,
        num_docs: num_docs,
        weight_milli: 1000,
        k1: k1,
        b: b,
        has_canonical_term_keys: false,
    )])

fn bm25_score_default_checked(tfs: [i64], doc_freqs: [i64], doc_len: i64,
                              avg_doc_len_value: i64, num_docs: i64) -> Result<Score, text>:
    bm25_score_checked(tfs, doc_freqs, doc_len, avg_doc_len_value, num_docs,
                       K1_DEFAULT, B_DEFAULT)

fn tfidf_score(tfs: [i64], doc_freqs: [i64], num_docs: i64) -> Score:
    """TF-IDF score for one document (sum of tf*idf over query terms)."""
    var acc = 0
    var i = 0
    val n = tfs.len()
    while i < n:
        acc = acc + tfidf_term_fixed(tfs[i], num_docs, doc_freqs[i])
        i = i + 1
    Score.from_milli(acc / SCALE_TO_MILLI)

# ----------------------------------------------------------------------------
# avg_doc_len_fixed — helper to build the fixed-point average doc length
# ----------------------------------------------------------------------------
fn avg_doc_len_fixed_checked(doc_lens: [i64]) -> Result<i64, text>:
    val n = doc_lens.len()
    if n <= 0:
        return Err(BM25_INVALID_CORPUS_N)
    var total: i64 = 0
    var i = 0
    while i < n:
        if doc_lens[i] < 0:
            return Err(BM25_INVALID_AVERAGE_LENGTH)
        total = _checked_add_i64(total, doc_lens[i])?
        i = i + 1
    if total <= 0:
        return Err(BM25_INVALID_AVERAGE_LENGTH)
    _bm25_average_checked(total, n)

fn avg_doc_len_fixed(doc_lens: [i64]) -> i64:
    """Fixed-point mean of doc lengths (0 when empty). Keeps SCALE precision so
    a non-integer average does not collapse to an integer before BM25 uses it."""
    val result = avg_doc_len_fixed_checked(doc_lens)
    if result.is_err():
        return 0
    result.unwrap()

# ----------------------------------------------------------------------------
# ScoredDoc — a typed (id, Score) pair for ranked output
# ----------------------------------------------------------------------------
struct ScoredDoc:
    """A document id paired with its relevance Score, the unit of ranked
    output. `better_than` is the total order used by top-k: Score descending,
    ties broken by ascending id so ordering is deterministic across backends
    (never relies on sort stability)."""
    id: i64
    score: Score

impl ScoredDoc:
    static fn of(id: i64, score: Score) -> ScoredDoc:
        ScoredDoc(id: id, score: score)

    fn doc_id() -> i64:
        self.id

    fn relevance() -> Score:
        self.score

    fn better_than(other: ScoredDoc) -> bool:
        """True if self ranks strictly ahead of other: higher Score first,
        then lower id wins a tie."""
        if self.score.is_greater_than(other.score):
            return true
        if self.score.is_less_than(other.score):
            return false
        self.id < other.id

# ----------------------------------------------------------------------------
# top_k — selection of the k best-ranked ScoredDocs, fully ordered
# ----------------------------------------------------------------------------
# Partial selection sort: k passes, each pulling the current best by
# `better_than`. O(n*k); k is small for ranking (don't over-engineer a heap).
# Returns at most k docs in ranked (best-first) order. Negative or oversized k
# is clamped to [0, n].
fn top_k(docs: [ScoredDoc], k: i64) -> [ScoredDoc]:
    var out: [ScoredDoc] = []
    val n = docs.len()
    if n == 0:
        return out
    var limit = k
    if limit < 0:
        limit = 0
    if limit > n:
        limit = n
    # taken[i] marks docs already pulled into the result.
    var taken: [bool] = []
    var t = 0
    while t < n:
        taken.push(false)
        t = t + 1
    var picked = 0
    while picked < limit:
        var best = 0 - 1
        var j = 0
        while j < n:
            if not taken[j]:
                if best < 0:
                    best = j
                else:
                    if docs[j].better_than(docs[best]):
                        best = j
            j = j + 1
        if best < 0:
            return out
        taken[best] = true
        out.push(docs[best])
        picked = picked + 1
    out

# rank_all — convenience: full ranking (top_k with k = n).
fn rank_all(docs: [ScoredDoc]) -> [ScoredDoc]:
    """Rank every document best-first (BM25/TF-IDF order with id tie-break)."""
    top_k(docs, docs.len())
