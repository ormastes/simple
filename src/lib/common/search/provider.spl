use std.common.search.query.{SearchQuery}
use std.common.search.document.{SearchHit}
use std.common.search.snapshot.{SearchSnapshot, SearchIndexDelta}
use std.common.search.snapshot.{IndexApplyRequestV1, IndexCandidateV1, IndexPublishRequestV1, IndexPublishResultV1}
use std.common.search.top_k.{SearchPageV1}
use std.common.search.explain.{SearchExplanation}

struct SearchCapabilities:
    lexical: bool
    phrase: bool
    explain: bool
    incremental: bool
    score_contract: text
    stats: bool
    cancel: bool
    shutdown: bool

impl SearchCapabilities:
    static fn bm25_v1() -> SearchCapabilities:
        SearchCapabilities(lexical: true, phrase: false, explain: true, incremental: true, score_contract: "bm25-fixed-v1", stats: true, cancel: true, shutdown: true)

struct SearchStatsV1:
    logical_root: text
    document_count: i64
    index_bytes: i64
    cache_bytes: i64
    peak_rss_bytes: i64

struct CancelResultV1:
    target_request_id: text
    status: text

struct ShutdownResultV1:
    status: text

trait LexicalSearchPort:
    fn capabilities(self) -> SearchCapabilities
    fn snapshot(self) -> SearchSnapshot
    fn apply_delta(self, delta: SearchIndexDelta) -> Result<SearchSnapshot, text>
    fn query(self, query: SearchQuery) -> Result<[SearchHit], text>

trait SearchProvider:
    fn capabilities(self) -> SearchCapabilities
    fn index_open(self, mode: text, logical_root: text?, scope_digest: text) -> Result<SearchSnapshot, text>
    fn index_apply(self, request: IndexApplyRequestV1, scope_digest: text) -> Result<IndexCandidateV1, text>
    fn index_publish(self, request: IndexPublishRequestV1, scope_digest: text) -> Result<IndexPublishResultV1, text>
    fn search(self, snapshot_id: text, scope_digest: text, query: SearchQuery) -> Result<SearchPageV1, text>
    fn explain_document(self, snapshot_id: text, scope_digest: text, document_id: text, query: SearchQuery) -> Result<SearchExplanation, text>
    fn stats(self, logical_root: text, scope_digest: text) -> Result<SearchStatsV1, text>
    fn cancel(self, target_request_id: text) -> Result<CancelResultV1, text>
    fn shutdown(self, reason: text) -> Result<ShutdownResultV1, text>
