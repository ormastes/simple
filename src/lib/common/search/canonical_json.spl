# Frozen §14.9 canonical JSON seam. `spipe-canonical-json-v1` has exactly one
# implementation — the provider's bounded, NFC-enforcing, strictly-UTF8-
# increasing-key emitter/decoder pair under
# `app.spipe_knowledge_provider.canonical_json_emitter` /
# `.canonical_json_decoder`. This module is a THIN re-export seam over that
# pair so `std.common.search` consumers have one import path — it must never
# reimplement the algorithm, and must never delegate to
# `src/app/spipe/model/canonical.spl` (that encoder has no NFC key
# normalization, no duplicate-key rejection, and no schema integer bounds —
# plan correction §2.9). See `.claude/rules/vcs.md`'s lib-importing-app
# precedent (e.g. `src/lib/nogc_sync_mut/lsp/lsp_query.spl`) for why this
# direction of import is an established, accepted pattern in this tree.

use app.spipe_knowledge_provider.canonical_json_types.{ProviderJsonLimitsV1, ProviderCanonicalJsonResultV1}
use app.spipe_knowledge_provider.canonical_json_emitter.{ProviderCanonicalJsonOutputV1}

export use app.spipe_knowledge_provider.canonical_json_types.{ProviderJsonLimitsV1, ProviderCanonicalJsonResultV1}
export use app.spipe_knowledge_provider.canonical_json_emitter.{ProviderCanonicalJsonOutputV1}

pub val CANONICAL_JSON_V1_ID: text = "spipe-canonical-json-v1"
pub val CANONICAL_JSON_SAFE_INTEGER_MAX: i64 = 9007199254740991
