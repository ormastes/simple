use std.common.search.ranking.{avg_doc_len_fixed}

# Frozen §14.3/§14.10 score-contract identity. Already landed as arithmetic in
# ranking.spl (`SCALE`, `K1_DEFAULT`, `B_DEFAULT`, `LN2_FIXED`,
# `_bm25_field_ordinal`/`_bm25_field_weight`) — these are the public identity
# constants and closed field order/weight tuple, not a re-declaration of the
# arithmetic itself.
pub val BM25_FIXED_V1_ID: text = "bm25-fixed-v1"
pub val BM25_SCALE: i64      = 1000000
pub val BM25_K1: i64         = 1200000
pub val BM25_B: i64          =  750000
pub val BM25_LN2: i64        =  693147

pub val BM25_FIELD_NAMES: [text]   = ["identifier","title","heading","classification","body"]
pub val BM25_FIELD_WEIGHTS: [i64]  = [4000, 4000, 2500, 2000, 1000]

# Frozen §14.3 per-field corpus statistics. `average_length_scaled` is
# `floor(total_length * BM25_SCALE / num_docs)`.
struct FieldStatsV1:
    field: text
    num_docs: i64
    total_length: i64
    average_length_scaled: i64

impl FieldStatsV1:
    static fn of(field: text, num_docs: i64, total_length: i64) -> FieldStatsV1:
        var average_length_scaled = 0
        if num_docs > 0:
            average_length_scaled = (total_length * BM25_SCALE) / num_docs
        FieldStatsV1(field: field, num_docs: num_docs, total_length: total_length, average_length_scaled: average_length_scaled)

struct TermCorpusStat:
    term: text
    document_frequency: i64

impl TermCorpusStat:
    static fn of(term: text, document_frequency: i64) -> TermCorpusStat:
        TermCorpusStat(term: term, document_frequency: document_frequency)

struct CorpusStats:
    document_count: i64
    document_lengths: [i64]
    average_document_length_fixed: i64
    terms: [TermCorpusStat]

impl CorpusStats:
    static fn of(document_lengths: [i64], terms: [TermCorpusStat]) -> CorpusStats:
        CorpusStats(
            document_count: document_lengths.len(),
            document_lengths: document_lengths,
            average_document_length_fixed: avg_doc_len_fixed(document_lengths),
            terms: terms,
        )

    fn document_frequency(term: text) -> i64:
        var i = 0
        while i < self.terms.len():
            if self.terms[i].term == term:
                return self.terms[i].document_frequency
            i = i + 1
        0

