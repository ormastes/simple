use std.common.search.ranking.{avg_doc_len_fixed}

struct TermCorpusStat:
    term: text
    document_frequency: i64

impl TermCorpusStat:
    static fn of(term: text, document_frequency: i64) -> TermCorpusStat:
        TermCorpusStat(term: term, document_frequency: document_frequency)

struct CorpusStats:
    document_count: i64
    document_lengths: [i64]
    average_document_length_fixed: i64
    terms: [TermCorpusStat]

impl CorpusStats:
    static fn of(document_lengths: [i64], terms: [TermCorpusStat]) -> CorpusStats:
        CorpusStats(
            document_count: document_lengths.len(),
            document_lengths: document_lengths,
            average_document_length_fixed: avg_doc_len_fixed(document_lengths),
            terms: terms,
        )

    fn document_frequency(term: text) -> i64:
        var i = 0
        while i < self.terms.len():
            if self.terms[i].term == term:
                return self.terms[i].document_frequency
            i = i + 1
        0

