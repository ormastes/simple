use std.common.search.document.{SearchFacet}

struct SearchQuery:
    text_value: text
    filters: [SearchFacet]
    limit: i64
    cursor: text
    explain: bool

impl SearchQuery:
    static fn of(text_value: text, filters: [SearchFacet], limit: i64, cursor: text, explain: bool) -> SearchQuery:
        SearchQuery(text_value: text_value, filters: filters, limit: limit, cursor: cursor, explain: explain)

    fn bounded_limit(maximum: i64) -> i64:
        if self.limit < 0:
            return 0
        if self.limit > maximum:
            return maximum
        self.limit

struct EqualityFilterV1:
    name: text
    values: [text]

impl EqualityFilterV1:
    static fn of(name: text, values: [text]) -> EqualityFilterV1:
        EqualityFilterV1(name: name, values: values)

struct SearchQueryV1:
    query_text: text
    filters: [EqualityFilterV1]
    limit: i64
    cursor: text?
    explain: bool

impl SearchQueryV1:
    static fn of(query_text: text, filters: [EqualityFilterV1], limit: i64, cursor: text?, explain: bool) -> SearchQueryV1:
        SearchQueryV1(query_text: query_text, filters: filters, limit: limit, cursor: cursor, explain: explain)

    fn validate_bounds() -> Result<bool, text>:
        if self.query_text.len() > 4096:
            return Err("query_too_large")
        if self.filters.len() > 32 or self.limit < 1 or self.limit > 1000:
            return Err("invalid_limit_or_filters")
        var i = 0
        while i < self.filters.len():
            if self.filters[i].values.len() < 1 or self.filters[i].values.len() > 64:
                return Err("invalid_filter_values")
            i = i + 1
        Ok(true)
