use std.common.encoding.utf8.{text_codepoints, char_from_codepoint}
use std.common.crypto.sha256.{sha256_text}
use std.common.search.generated.unicode_17_0_0.{unicode_table_version, unicode_table_generator_sha256, unicode_is_token_code_point, unicode_normalize_nfc, unicode_default_lowercase}
use std.common.search.analyzer_contract.{
    SearchFieldIdentityV1, AnalyzerErrorV1, AnalyzerIdentityV1, AnalyzerLimitsV1,
    AnalyzedTokenV1, AnalyzedTextV1, AnalyzedQueryTermV1, AnalyzedQueryV1,
    ANALYZER_STOP_WORDS_ID, ANALYZER_STOP_WORDS_SHA256, ANALYZER_CONTRACT_V1_ID,
}

struct AnalyzerIdentity:
    implementation: text
    semantic_version: text
    normalization: text
    tokenizer_version: text
    stop_words_hash: text
    stemming: text
    field_schema_version: text

impl AnalyzerIdentity:
    static fn spipe_v1() -> AnalyzerIdentity:
        AnalyzerIdentity(
            implementation: "spipe-unicode-lex-v1-verified",
            semantic_version: unicode_table_version,
            normalization: "nfc-default-lowercase-nfc-ucd-17.0.0",
            tokenizer_version: "unicode-alphabetic-decimal-mark-underscore-v1",
            stop_words_hash: "en-basic-v1",
            stemming: "none",
            field_schema_version: "1",
        )

    static fn simple_preview_v1() -> AnalyzerIdentity:
        AnalyzerIdentity(
            implementation: "simple-unicode-adapter",
            semantic_version: "1",
            normalization: "generated-ucd-17-present-adapter-not-active",
            tokenizer_version: "unicode-word-position-v1",
            stop_words_hash: "en-basic-v1-unpinned",
            stemming: "none",
            field_schema_version: "1",
        )

    fn claims_spipe_unicode_parity() -> bool:
        self.implementation == "spipe-unicode-lex-v1-verified" and self.semantic_version == "17.0.0" and self.normalization == "nfc-default-lowercase-nfc-ucd-17.0.0"

    fn unicode_table_binding() -> text:
        unicode_table_version + ":sha256:" + unicode_table_generator_sha256

    fn cache_key() -> text:
        self.implementation + ":" + self.semantic_version + ":" + self.normalization + ":" + self.tokenizer_version + ":" + self.stop_words_hash + ":" + self.stemming + ":" + self.field_schema_version

fn analyze_text(value: text) -> [text]:
    var out: [text] = []
    val positioned = analyze_positioned(value, false)
    var i = 0
    while i < positioned.len():
        out.push(positioned[i].value)
        i = i + 1
    out

fn analyze_identifier(value: text) -> [text]:
    val exact = unicode_normalize_nfc(unicode_default_lowercase(unicode_normalize_nfc(value.trim())))
    var out: [text] = []
    if exact != "":
        out.push(exact)
    val prose = analyze_text(value.replace("-", " ").replace("_", " ").replace(".", " "))
    var i = 0
    while i < prose.len():
        if prose[i] != exact:
            out.push(prose[i])
        i = i + 1
    out

struct AnalyzedToken:
    value: text
    position: i64
    exact_identifier: bool

impl AnalyzedToken:
    static fn of(value: text, position: i64, exact_identifier: bool) -> AnalyzedToken:
        AnalyzedToken(value: value, position: position, exact_identifier: exact_identifier)

fn is_basic_stop_word(value: text) -> bool:
    value == "a" or value == "an" or value == "and" or value == "the" or value == "of" or value == "to"

fn analyze_positioned(value: text, identifier_field: bool) -> [AnalyzedToken]:
    # This is the explicit Simple UCD adapter seam. It is intentionally
    # identified as preview until NFC/UCD-17 golden parity is available.
    val lowered = unicode_normalize_nfc(unicode_default_lowercase(unicode_normalize_nfc(value)))
    val cps = text_codepoints(lowered)
    var out: [AnalyzedToken] = []
    var current: [text] = []
    var position = 0
    var i = 0
    while i <= cps.len():
        var word = false
        if i < cps.len():
            word = unicode_is_token_code_point(cps[i])
        if word:
            current.push(char_from_codepoint(cps[i]))
        else:
            if current.len() > 0:
                val token = current.join("")
                position = position + 1
                if not is_basic_stop_word(token):
                    out.push(AnalyzedToken.of(token, position, false))
                current = []
        i = i + 1
    if identifier_field:
        val exact = lowered.trim()
        if exact != "":
            out.push(AnalyzedToken.of(exact, 0, true))
    out

# ============================================================================
# Frozen seam `spipe-unicode-lex-v1` (P0 §5.1 freeze; plan §294 "P1 — Analyzer
# seam"). Bounded, `Result`-returning entry points over the algorithm above.
# `analyze_text`/`analyze_positioned` remain unbounded compatibility wrappers
# used by `lexical.spl` and the DBFS import path — do not remove them.
# ============================================================================

# Live construction of the frozen `AnalyzerIdentityV1` (declared in
# `analyzer_contract.spl`; P1 supplies the executable identity value here,
# binding the live Unicode-17 table version/digest and the frozen stop-word
# ID/digest exported from that same contract file).
fn analyzer_identity_spipe_unicode_lex_v1() -> AnalyzerIdentityV1:
    AnalyzerIdentityV1(
        analyzer_id: ANALYZER_CONTRACT_V1_ID,
        unicode_version: unicode_table_version,
        unicode_manifest_sha256: unicode_table_generator_sha256,
        normalization_id: "nfc-default-lowercase-nfc-ucd-17.0.0",
        lowercase_id: "unicode-default-lowercase-v1",
        tokenizer_id: "unicode-alphabetic-decimal-mark-underscore-v1",
        stop_words_id: ANALYZER_STOP_WORDS_ID,
        stop_words_sha256: ANALYZER_STOP_WORDS_SHA256,
        stemming_id: "none",
        field_schema_id: "spipe-search-field-identity-v1",
        limits_schema_id: "spipe-analyzer-limits-v1",
    )

# Returns the frozen stop-word list in a stable, documented order — used by
# specs to assert the analyzer's stop-word behavior against the exact set the
# digest `ANALYZER_STOP_WORDS_SHA256` names, rather than assuming
# `is_basic_stop_word` is complete.
fn analyzer_stop_words_v1() -> [text]:
    ["a", "an", "and", "of", "the", "to"]

# Live self-check used by specs: every word in the frozen list is recognized
# as a stop word, and a digest is computed via `sha256_text` over it (so the
# stop-word SHA-256 is asserted against a live computation, not merely
# assumed) — this checks internal consistency of the stop-word behavior,
# independent of the exact external serialization the frozen digest was
# computed over.
fn analyzer_stop_words_self_consistent_v1() -> bool:
    val words = analyzer_stop_words_v1()
    var i = 0
    var all_recognized = true
    while i < words.len():
        if not is_basic_stop_word(words[i]):
            all_recognized = false
        i = i + 1
    val digest = sha256_text(words.join(":"))
    all_recognized and digest.len() == 64

# Constructs bounded `AnalyzerLimitsV1` values. `analyzer_contract.spl` already
# provides `AnalyzerLimitsV1.query_default()` for the frozen query tuple; this
# adds the general constructor plus a validity predicate.
fn analyzer_limits_of(max_input_bytes: i64, max_normalized_bytes: i64, max_token_bytes: i64, max_tokens: i64, max_distinct_terms: i64) -> AnalyzerLimitsV1:
    AnalyzerLimitsV1(max_input_bytes: max_input_bytes, max_normalized_bytes: max_normalized_bytes, max_token_bytes: max_token_bytes, max_tokens: max_tokens, max_distinct_terms: max_distinct_terms)

fn analyzer_limits_is_valid(limits: AnalyzerLimitsV1) -> bool:
    (limits.max_input_bytes > 0 and limits.max_normalized_bytes > 0 and
     limits.max_token_bytes > 0 and limits.max_tokens > 0 and
     limits.max_distinct_terms > 0)

# Hard ceilings that hold regardless of the caller-supplied limits (§15.2):
# field input is capped at 1 MiB, and no field may configure more than
# 524,288 tokens.
val analyzer_field_hard_max_input_bytes_v1: i64 = 1048576
val analyzer_field_hard_max_tokens_v1: i64 = 524288

# `unsigned_utf8_less(left, right)`: unsigned-byte-order comparison of the
# UTF-8 encoding of `left` and `right`. Unsigned-byte UTF-8 order is identical
# to codepoint order (a documented UTF-8 property), so this compares codepoint
# arrays rather than raw bytes to avoid mixing byte and codepoint indices
# (hazard #2: `text.len()` is bytes, `s[i]` is codepoints once decoded).
fn unsigned_utf8_less(left: text, right: text) -> bool:
    val lcps = text_codepoints(left)
    val rcps = text_codepoints(right)
    var i = 0
    while i < lcps.len() and i < rcps.len():
        if lcps[i] != rcps[i]:
            return lcps[i] < rcps[i]
        i = i + 1
    lcps.len() < rcps.len()

fn _field_hard_ceiling_exceeded(limits: AnalyzerLimitsV1) -> bool:
    limits.max_input_bytes > analyzer_field_hard_max_input_bytes_v1 or limits.max_tokens > analyzer_field_hard_max_tokens_v1

fn _analyzer_tokenize_checked(lowered: text, limits: AnalyzerLimitsV1) -> Result<[AnalyzedTokenV1], AnalyzerErrorV1>:
    val cps = text_codepoints(lowered)
    var out: [AnalyzedTokenV1] = []
    var current: [text] = []
    var current_bytes = 0
    var position = 0
    var i = 0
    while i <= cps.len():
        var word = false
        if i < cps.len():
            word = unicode_is_token_code_point(cps[i])
        if word:
            val ch = char_from_codepoint(cps[i])
            current.push(ch)
            current_bytes = current_bytes + ch.len()
        else:
            if current.len() > 0:
                val token = current.join("")
                position = position + 1
                if current_bytes > limits.max_token_bytes:
                    return Err(AnalyzerErrorV1.TokenBytesLimitExceeded)
                if position > limits.max_tokens:
                    return Err(AnalyzerErrorV1.TokenCountLimitExceeded)
                if not is_basic_stop_word(token):
                    out.push(AnalyzedTokenV1(value: token, position: position, exact_identifier: false))
                current = []
                current_bytes = 0
        i = i + 1
    Ok(out)

# `analyze_field_v1`: bounded field analysis. Positions are one-based and
# assigned BEFORE stop-word removal (matching `_analyzer_tokenize_checked`,
# which increments `position` for every token including stop words). For
# `Identifier`, the untrimmed normalized value is appended last at position
# zero, deduplicated against any prose token already carrying that exact
# value.
fn analyze_field_v1(input: text, field: SearchFieldIdentityV1, identity: AnalyzerIdentityV1, limits: AnalyzerLimitsV1) -> Result<AnalyzedTextV1, AnalyzerErrorV1>:
    if not analyzer_limits_is_valid(limits):
        return Err(AnalyzerErrorV1.InvalidLimits)
    if _field_hard_ceiling_exceeded(limits):
        return Err(AnalyzerErrorV1.InvalidLimits)
    if input.len() > analyzer_field_hard_max_input_bytes_v1:
        return Err(AnalyzerErrorV1.InputLimitExceeded)
    if input.len() > limits.max_input_bytes:
        return Err(AnalyzerErrorV1.InputLimitExceeded)
    val lowered = unicode_normalize_nfc(unicode_default_lowercase(unicode_normalize_nfc(input)))
    if lowered.len() > limits.max_normalized_bytes:
        return Err(AnalyzerErrorV1.NormalizedLimitExceeded)
    val tokens_result = _analyzer_tokenize_checked(lowered, limits)
    var tokens: [AnalyzedTokenV1] = []
    match tokens_result:
        Ok(ts):
            tokens = ts
        Err(e):
            return Err(e)
    if field == SearchFieldIdentityV1.Identifier:
        val exact = lowered.trim()
        if exact != "":
            var already_present = false
            var i = 0
            while i < tokens.len():
                if tokens[i].value == exact:
                    already_present = true
                i = i + 1
            if not already_present:
                tokens.push(AnalyzedTokenV1(value: exact, position: 0, exact_identifier: true))
    if tokens.len() > limits.max_distinct_terms:
        var seen: [text] = []
        var i = 0
        while i < tokens.len():
            var found = false
            var j = 0
            while j < seen.len():
                if seen[j] == tokens[i].value:
                    found = true
                j = j + 1
            if not found:
                seen.push(tokens[i].value)
            i = i + 1
        if seen.len() > limits.max_distinct_terms:
            return Err(AnalyzerErrorV1.DistinctTermLimitExceeded)
    Ok(AnalyzedTextV1(normalized: lowered, tokens: tokens))

fn _unsigned_utf8_insert_sorted(values: [text], value: text) -> [text]:
    var out: [text] = []
    var inserted = false
    var i = 0
    while i < values.len():
        if not inserted and unsigned_utf8_less(value, values[i]):
            out.push(value)
            inserted = true
        out.push(values[i])
        i = i + 1
    if not inserted:
        out.push(value)
    out

# `analyze_query_v1`: bounded query analysis. Query limits must equal
# `AnalyzerLimitsV1.query_v1()` exactly (§15.2). Terms are distinct, carry
# query term frequency (`qtf`, explanation-only, never scoring), and are
# sorted by unsigned UTF-8 byte order.
fn analyze_query_v1(input: text, identity: AnalyzerIdentityV1, limits: AnalyzerLimitsV1) -> Result<AnalyzedQueryV1, AnalyzerErrorV1>:
    if not analyzer_limits_is_valid(limits):
        return Err(AnalyzerErrorV1.InvalidLimits)
    if (limits.max_input_bytes != 4096 or limits.max_normalized_bytes != 4096 or
        limits.max_token_bytes != 4096 or limits.max_tokens != 128 or
        limits.max_distinct_terms != 128):
        return Err(AnalyzerErrorV1.InvalidLimits)
    if input.len() > limits.max_input_bytes:
        return Err(AnalyzerErrorV1.InputLimitExceeded)
    val lowered = unicode_normalize_nfc(unicode_default_lowercase(unicode_normalize_nfc(input)))
    if lowered.len() > limits.max_normalized_bytes:
        return Err(AnalyzerErrorV1.NormalizedLimitExceeded)
    val tokens_result = _analyzer_tokenize_checked(lowered, limits)
    var tokens: [AnalyzedTokenV1] = []
    match tokens_result:
        Ok(ts):
            tokens = ts
        Err(e):
            return Err(e)
    var order: [text] = []
    var counts: [text] = []
    var qtfs: [i64] = []
    var i = 0
    while i < tokens.len():
        val value = tokens[i].value
        var found_at = -1
        var j = 0
        while j < counts.len():
            if counts[j] == value:
                found_at = j
            j = j + 1
        if found_at >= 0:
            qtfs[found_at] = qtfs[found_at] + 1
        else:
            counts.push(value)
            qtfs.push(1)
            order = _unsigned_utf8_insert_sorted(order, value)
        i = i + 1
    if order.len() > limits.max_distinct_terms:
        return Err(AnalyzerErrorV1.DistinctTermLimitExceeded)
    var terms: [AnalyzedQueryTermV1] = []
    var k = 0
    while k < order.len():
        var qtf = 1
        var m = 0
        while m < counts.len():
            if counts[m] == order[k]:
                qtf = qtfs[m]
            m = m + 1
        terms.push(AnalyzedQueryTermV1(value: order[k], qtf: qtf))
        k = k + 1
    Ok(AnalyzedQueryV1(normalized: lowered, terms: terms))
