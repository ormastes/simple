# candidate_lifecycle.spl — P2: state-machine LOGIC for the §14.16/§14.17
# candidate lifecycle (create -> publish|expire|error), built over the
# already-frozen wire records in snapshot.spl (CandidateRecordV1,
# PublicationRecordV1, DurableTerminalErrorV1, CandidateExpiryReceiptV1).
# This file owns no new wire shapes — only the transition functions the plan
# asked P2 to place here instead of editing the P0-owned snapshot.spl.

use std.common.search.snapshot.{CandidateRecordV1, PublicationRecordV1, DurableTerminalErrorV1, CandidateExpiryReceiptV1}

pub val CANDIDATE_STATUS_PENDING: text = "pending"
pub val CANDIDATE_STATUS_PUBLISHED: text = "published"
pub val CANDIDATE_STATUS_EXPIRED: text = "expired"
pub val CANDIDATE_STATUS_ERROR: text = "error"

# Creates a fresh, pending candidate with `expires_at_ms = created_at_ms + ttl_ms`.
pub fn create_candidate(candidate_uid: text, operation_id: text, payload_hash: text, base_logical_root: text, candidate_logical_root: text, created_at_ms: i64, ttl_ms: i64) -> CandidateRecordV1:
    CandidateRecordV1(
        candidate_uid: candidate_uid,
        operation_id: operation_id,
        payload_hash: payload_hash,
        base_logical_root: base_logical_root,
        candidate_logical_root: candidate_logical_root,
        created_at_ms: created_at_ms,
        expires_at_ms: created_at_ms + ttl_ms,
        status: CANDIDATE_STATUS_PENDING,
    )

pub fn is_expired_at(candidate: CandidateRecordV1, now_ms: i64) -> bool:
    now_ms >= candidate.expires_at_ms

# Publishes a pending, unexpired candidate whose base matches the caller's
# expectation. Never mutates the candidate in place — callers combine the
# returned `PublicationRecordV1` with their own bookkeeping to mark the
# candidate published.
pub fn publish_candidate(candidate: CandidateRecordV1, expected_base_logical_root: text, published_at_ms: i64) -> Result<PublicationRecordV1, text>:
    if candidate.status != CANDIDATE_STATUS_PENDING:
        return Err("candidate_not_pending")
    if is_expired_at(candidate, published_at_ms):
        return Err("candidate_expired")
    if candidate.base_logical_root != expected_base_logical_root:
        return Err("base_logical_root_mismatch")
    Ok(PublicationRecordV1(
        candidate_uid: candidate.candidate_uid,
        operation_id: candidate.operation_id,
        previous_logical_root: candidate.base_logical_root,
        logical_root: candidate.candidate_logical_root,
        published_at_ms: published_at_ms,
    ))

# Expires a pending candidate that has passed its TTL. Publishing after this
# point must be rejected by `publish_candidate` (status check + TTL check both
# guard it, so callers do not need to serialize the two).
pub fn expire_candidate(candidate: CandidateRecordV1, now_ms: i64) -> Result<CandidateExpiryReceiptV1, text>:
    if candidate.status != CANDIDATE_STATUS_PENDING:
        return Err("candidate_not_pending")
    if not is_expired_at(candidate, now_ms):
        return Err("candidate_not_expired")
    Ok(CandidateExpiryReceiptV1(
        candidate_uid: candidate.candidate_uid,
        operation_id: candidate.operation_id,
        base_logical_root: candidate.base_logical_root,
        expired_at_ms: now_ms,
    ))

# Records a durable terminal error for an operation that can never be
# retried as-is (distinct from a transient failure — the receipt is meant to
# be replay-checked against `payload_hash` the way `ReplayRecordV1` is).
pub fn terminal_error(operation_id: text, payload_hash: text, code: text, message: text, occurred_at_ms: i64) -> DurableTerminalErrorV1:
    DurableTerminalErrorV1(
        operation_id: operation_id,
        payload_hash: payload_hash,
        code: code,
        message: message,
        occurred_at_ms: occurred_at_ms,
    )
