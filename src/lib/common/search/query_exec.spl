# ============================================================================
# common/search/query_exec.spl — the missing query -> score orchestrator
#
# Closes doc/08_tracking/bug/golden_query_scoring_pipeline_unassembled_2026-08-31.md:
# every piece of the BM25 pipeline (analyzer, index_engine/segment, ranking,
# explain_build, field_stats, top_k) exists and is individually tested, but
# nothing wired analyze -> postings -> bm25_fixed_v1_score_checked ->
# explain into one "run this query against this corpus" entry point. This
# module IS that entry point. It reimplements no BM25 arithmetic of its own:
# every scored number here comes from `ranking.spl`'s
# `bm25_fixed_v1_score_checked` / `bm25_term_checked_trace`, every per-field
# aggregate comes from `field_stats.spl`, every tokenization comes from
# `analyzer.spl`, and top-k selection comes from `top_k.spl`.
#
# Two outputs are produced per hit:
#   * `QueryHitV1` (document_id/score_milli/matched_fields/source_rank) —
#     built directly from `top_k.spl`'s `exhaustive_top_k_v1`.
#   * `explanation_hash` — a sha256 over a hand-assembled canonical-JSON
#     rendering of the per-hit explanation. This is NOT built from
#     `explain_build.spl`'s `SearchExplanationV1` wire shape: that frozen
#     record uses different field names (`document_count` vs the oracle's
#     `N`, no `qtf`/`length_ratio_scaled`/`norm_scaled`/`denominator_scaled`/
#     `idf_argument_scaled` per term) than the ad hoc JS oracle object
#     hashed by golden_results.json (examples/05_stdlib/spipe/src/index/
#     bm25.js `finalizeExplanation` + logical_index.js `explainDocument`).
#     `build_field_explanation`/`build_explanation` ARE still called below
#     (see `field_explanation_for` / `explanation_for`) so the frozen
#     contract's own self-consistency is exercised on every hit; the
#     oracle-matching hash is assembled separately from the same
#     `Bm25TermTrace` values (via `bm25_term_checked_trace`, the one
#     checked-arithmetic entry point both paths share) so this module still
#     owns zero scoring arithmetic.
# ============================================================================

use std.common.crypto.sha256.{sha256_text}
use std.common.search.document.{ScopedSearchDocumentV1, SearchHitV1}
use std.common.search.analyzer.{analyze_field_v1, analyze_query_v1, analyzer_identity_spipe_unicode_lex_v1, analyzer_limits_of}
use std.common.search.analyzer_contract.{SearchFieldIdentityV1, AnalyzerLimitsV1, AnalyzedQueryV1}
use std.common.search.index_engine.{IndexEngine}
use std.common.search.corpus_stats.{BM25_FIELD_NAMES, BM25_FIELD_WEIGHTS, FieldStatsV1}
use std.common.search.field_stats.{build_field_stats}
use std.common.search.ranking.{Bm25FieldV1, bm25_fixed_v1_score_checked, bm25_term_checked_trace}
use std.common.search.explain_build.{FieldTermInputV1, FieldInputV1, build_field_explanation, build_explanation}
use std.common.search.explain.{FieldExplanationV1, TermContributionV1, SearchExplanationV1}
use std.common.search.top_k.{ExhaustiveCandidateV1, score_exhaustive_candidate, exhaustive_top_k_v1}
use std.common.search.query.{EqualityFilterV1}

val QUERY_EXEC_ANALYZE_FAILED: text = "query_analyze_failed"

struct QueryHitV1:
    document_id: text
    score_milli: i64
    matched_fields: [text]
    source_rank: i64
    explanation_hash: text

impl QueryHitV1:
    static fn of(document_id: text, score_milli: i64, matched_fields: [text],
                 source_rank: i64, explanation_hash: text) -> QueryHitV1:
        QueryHitV1(document_id: document_id, score_milli: score_milli,
                   matched_fields: matched_fields, source_rank: source_rank,
                   explanation_hash: explanation_hash)

fn _field_identity_of(name: text) -> SearchFieldIdentityV1:
    if name == "identifier":
        return SearchFieldIdentityV1.Identifier
    if name == "title":
        return SearchFieldIdentityV1.Title
    if name == "heading":
        return SearchFieldIdentityV1.Heading
    if name == "classification":
        return SearchFieldIdentityV1.Classification
    SearchFieldIdentityV1.Body

fn _document_field_value(doc: ScopedSearchDocumentV1, name: text) -> text:
    var i = 0
    while i < doc.fields.len():
        if doc.fields[i].name == name:
            return doc.fields[i].value
        i = i + 1
    ""

fn _matches_filters(doc: ScopedSearchDocumentV1, filters: [EqualityFilterV1]) -> bool:
    var i = 0
    while i < filters.len():
        val filter = filters[i]
        var found = false
        var j = 0
        while j < doc.facets.len():
            if doc.facets[j].name == filter.name:
                var k = 0
                while k < filter.values.len():
                    if doc.facets[j].value == filter.values[k]:
                        found = true
                    k = k + 1
            j = j + 1
        if not found:
            return false
        i = i + 1
    true

fn _count_term(tokens: [text], term: text) -> i64:
    var count = 0
    var i = 0
    while i < tokens.len():
        if tokens[i] == term:
            count = count + 1
        i = i + 1
    count

# Field-analysis limits used for corpus/document field bodies (NOT the
# query — the query MUST use `AnalyzerLimitsV1.query_default()`, enforced
# by `analyze_query_v1` itself). Generous but within the hard ceilings
# `analyzer.spl` enforces (<= 1 MiB input, <= 524288 tokens).
fn _field_analysis_limits() -> AnalyzerLimitsV1:
    analyzer_limits_of(1048576, 1048576, 4096, 524288, 524288)

# Every query term's analyzed token list for one document's one field,
# needed both for scoring (tf/df) and for the oracle-parity explanation.
fn _field_tokens(doc: ScopedSearchDocumentV1, field_name: text) -> Result<[text], text>:
    val identity = analyzer_identity_spipe_unicode_lex_v1()
    val analyzed = analyze_field_v1(_document_field_value(doc, field_name),
        _field_identity_of(field_name), identity, _field_analysis_limits())
    match analyzed:
        Err(_):
            Err(QUERY_EXEC_ANALYZE_FAILED)
        Ok(text_value):
            var out: [text] = []
            var i = 0
            while i < text_value.tokens.len():
                out.push(text_value.tokens[i].value)
                i = i + 1
            Ok(out)

fn _hex_digit(v: i64) -> text:
    val digits = "0123456789abcdef"
    digits[v]

fn _utf8_hex(s: text) -> text:
    val data = s.bytes()
    var out = ""
    var i = 0
    while i < data.len():
        val v = data[i].to_i64()
        out = out + _hex_digit(v / 16) + _hex_digit(v % 16)
        i = i + 1
    out

fn _json_quote(s: text) -> text:
    var out = "\""
    var i = 0
    while i < s.len():
        val c = s.substring(i, i + 1)
        if c == "\"":
            out = out + "\\\""
        elif c == "\\":
            out = out + "\\\\"
        else:
            out = out + c
        i = i + 1
    out + "\""

fn _decimal_or_null(present: bool, value: text) -> text:
    if present:
        return _json_quote(value)
    "null"

# One query term's per-field trace, prepared for both scoring (Bm25FieldV1)
# and the oracle-parity explanation JSON.
struct _TermRow:
    term: text
    qtf: i64
    tf: i64
    df: i64

# Per-document, per-field scoring/explanation context.
struct _FieldContext:
    field_name: text
    weight_milli: i64
    document_length: i64
    stats: FieldStatsV1
    rows: [_TermRow]

# One scored term row's oracle-shape JSON object (keys in ASCII-sorted
# order, matching JS `Object.keys(value).sort()` over
# examples/05_stdlib/spipe/src/index/logical_index.js's `terms.push(...)`
# objects — see file header for why this is hand-assembled rather than
# built from `TermContributionV1`, which does not carry every field the
# oracle's ad hoc object does).
fn _term_json(row: _TermRow, field: _FieldContext) -> Result<text, text>:
    if row.tf <= 0:
        val absent = "{\"denominator_scaled\":null,\"df\":" + row.df.to_text() +
            ",\"idf_argument_scaled\":null,\"idf_scaled\":null,\"kind\":\"absent\"" +
            ",\"length_ratio_scaled\":null,\"norm_scaled\":null,\"qtf\":" + row.qtf.to_text() +
            ",\"term\":" + _json_quote(row.term) + ",\"tf\":0,\"tf_scaled\":null" +
            ",\"unweighted\":\"0\",\"weighted\":\"0\"}"
        return Ok(absent)
    val trace = bm25_term_checked_trace(row.tf, field.document_length,
        field.stats.total_length, field.stats.num_docs, row.df, field.weight_milli)?
    val scored = "{\"denominator_scaled\":" + _json_quote(trace.denominator_scaled.to_text()) +
        ",\"df\":" + row.df.to_text() +
        ",\"idf_argument_scaled\":" + _json_quote(trace.idf_argument_scaled.to_text()) +
        ",\"idf_scaled\":" + _json_quote(trace.idf_scaled.to_text()) +
        ",\"kind\":\"scored\"" +
        ",\"length_ratio_scaled\":" + _json_quote(trace.ratio_scaled.to_text()) +
        ",\"norm_scaled\":" + _json_quote(trace.norm_scaled.to_text()) +
        ",\"qtf\":" + row.qtf.to_text() +
        ",\"term\":" + _json_quote(row.term) +
        ",\"tf\":" + row.tf.to_text() +
        ",\"tf_scaled\":" + _json_quote(trace.tf_scaled.to_text()) +
        ",\"unweighted\":" + _json_quote(trace.unweighted.to_text()) +
        ",\"weighted\":" + _json_quote(trace.weighted.to_text()) + "}"
    Ok(scored)

# One field's oracle-shape JSON object (keys ASCII-sorted: N first, since
# uppercase sorts before lowercase in JS's default string sort).
fn _field_json(field: _FieldContext) -> Result<(text, i64, bool), text>:
    var terms_json: [text] = []
    var field_total: i64 = 0
    var any_scored = false
    var i = 0
    while i < field.rows.len():
        terms_json.push(_term_json(field.rows[i], field)?)
        if field.rows[i].tf > 0:
            any_scored = true
            val trace = bm25_term_checked_trace(field.rows[i].tf, field.document_length,
                field.stats.total_length, field.stats.num_docs, field.rows[i].df, field.weight_milli)?
            field_total = field_total + trace.weighted
        i = i + 1
    val json = "{\"N\":" + field.stats.num_docs.to_text() +
        ",\"average_length_scaled\":" + _json_quote(field.stats.average_length_scaled.to_text()) +
        ",\"document_length\":" + field.document_length.to_text() +
        ",\"field\":" + _json_quote(field.field_name) +
        ",\"field_total\":" + _json_quote(field_total.to_text()) +
        ",\"terms\":[" + terms_json.join(",") + "]" +
        ",\"total_length\":" + field.stats.total_length.to_text() +
        ",\"weight_milli\":" + field.weight_milli.to_text() + "}"
    Ok((json, field_total, any_scored))

# Assembles the whole per-document explanation as oracle-shape canonical
# JSON (root keys ASCII-sorted) and returns
# (json_text, public_score_milli, matched_fields).
fn _explanation_json(document_id: text, scope_digest: text, logical_root: text,
                     fields: [_FieldContext]) -> Result<(text, i64, [text]), text>:
    var field_rows: [text] = []
    var internal_total: i64 = 0
    var matched: [text] = []
    var i = 0
    while i < fields.len():
        val built = _field_json(fields[i])?
        field_rows.push(built.0)
        internal_total = internal_total + built.1
        if built.2:
            matched.push(fields[i].field_name)
        i = i + 1
    val public_score_milli = internal_total / 1000
    val json = "{\"analyzer\":\"spipe-unicode-lex-v1\"" +
        ",\"contract\":\"bm25-explain-v1\"" +
        ",\"document_id\":" + _json_quote(document_id) +
        ",\"fields\":[" + field_rows.join(",") + "]" +
        ",\"internal_total\":" + _json_quote(internal_total.to_text()) +
        ",\"logical_index\":\"spipe-lexical-snapshot-v1\"" +
        ",\"logical_root\":" + _json_quote(logical_root) +
        ",\"public_score_milli\":" + public_score_milli.to_text() +
        ",\"scope_digest\":" + _json_quote(scope_digest) +
        ",\"score_contract\":\"bm25-fixed-v1\"" +
        ",\"tie_key_utf8_hex\":" + _json_quote(_utf8_hex(document_id)) + "}"
    Ok((json, public_score_milli, matched))

# Frozen self-consistency call into `explain_build.spl` — proves the
# module's own closed contract can be built from the same per-term inputs
# this orchestrator already computed, without asserting its bytes equal the
# oracle's (see file header). Returns the checked public_score_milli.
fn _frozen_explanation_check(document_id: text, scope_digest: text, logical_root: text,
                             fields: [_FieldContext]) -> Result<i64, text>:
    var field_inputs: [FieldInputV1] = []
    var i = 0
    while i < fields.len():
        var terms: [FieldTermInputV1] = []
        var j = 0
        while j < fields[i].rows.len():
            terms.push(FieldTermInputV1.of(fields[i].rows[j].term, fields[i].rows[j].tf, fields[i].rows[j].df))
            j = j + 1
        field_inputs.push(FieldInputV1.of(fields[i].field_name, fields[i].document_length, fields[i].stats, terms))
        i = i + 1
    val explanation = build_explanation("spipe-unicode-lex-v1", "spipe-lexical-snapshot-v1",
        scope_digest, logical_root, document_id, field_inputs)?
    Ok(explanation.public_score_milli)

# ----------------------------------------------------------------------------
# Public entry point.
# ----------------------------------------------------------------------------
# Runs `query_text`/`filters` against every document `engine` currently
# holds: analyzes the query (`analyze_query_v1`), analyzes every candidate
# document's fields (`analyze_field_v1`), builds per-field postings,
# scores every candidate with the canonical `bm25_fixed_v1_score_checked`,
# and returns the top `k` hits (`exhaustive_top_k_v1`'s tie-break) each
# carrying a sha256 explanation hash over an oracle-shape canonical JSON
# rendering of its explanation.
pub fn run_query_v1(engine: IndexEngine, query_text: text, filters: [EqualityFilterV1],
                    k: i64, scope_digest: text, logical_root: text) -> Result<[QueryHitV1], text>:
    val identity = analyzer_identity_spipe_unicode_lex_v1()
    val query_limits = AnalyzerLimitsV1.query_default()
    val aq_result = analyze_query_v1(query_text, identity, query_limits)
    var aq: AnalyzedQueryV1 = AnalyzedQueryV1(normalized: "", terms: [])
    match aq_result:
        Err(_):
            return Err(QUERY_EXEC_ANALYZE_FAILED)
        Ok(q):
            aq = q
    var query_terms: [text] = []
    var query_qtf: [i64] = []
    var ti = 0
    while ti < aq.terms.len():
        query_terms.push(aq.terms[ti].value)
        query_qtf.push(aq.terms[ti].qtf)
        ti = ti + 1

    val all_docs = engine.documents()
    val num_docs = all_docs.len()
    # `logical_root` is a caller-supplied parameter rather than
    # `engine.logical_root()`: `segment.spl` documents its own logical root
    # as a deliberate INTERIM stand-in (a delimited text encoding, not
    # canonical JSON) and states explicitly that it is "NOT canonical
    # JSON" — it does not and is not meant to equal the oracle's
    # canonical-JSON-based logical root that golden_results.json's
    # `explanation.logical_root` bytes were hashed against.

    # Per-field corpus stats + per-document token lists, computed once over
    # the whole live corpus (not the filtered candidate set — filters narrow
    # which documents may become hits, never the field corpus N/total_length).
    var field_lengths: [[i64]] = []
    var doc_field_tokens: [[[text]]] = []
    var fi = 0
    while fi < BM25_FIELD_NAMES.len():
        field_lengths.push([])
        fi = fi + 1
    var di = 0
    while di < num_docs:
        var per_field: [[text]] = []
        var fj = 0
        while fj < BM25_FIELD_NAMES.len():
            val tokens = _field_tokens(all_docs[di], BM25_FIELD_NAMES[fj])?
            per_field.push(tokens)
            field_lengths[fj].push(tokens.len())
            fj = fj + 1
        doc_field_tokens.push(per_field)
        di = di + 1

    var field_stats: [FieldStatsV1] = []
    var fk = 0
    while fk < BM25_FIELD_NAMES.len():
        field_stats.push(build_field_stats(BM25_FIELD_NAMES[fk], field_lengths[fk])?)
        fk = fk + 1

    # Document frequency per (field, query term), over the whole corpus.
    var doc_freq: [[i64]] = []
    var fm = 0
    while fm < BM25_FIELD_NAMES.len():
        var per_term: [i64] = []
        var tm = 0
        while tm < query_terms.len():
            var count = 0
            var dm = 0
            while dm < num_docs:
                if _count_term(doc_field_tokens[dm][fm], query_terms[tm]) > 0:
                    count = count + 1
                dm = dm + 1
            per_term.push(count)
            tm = tm + 1
        doc_freq.push(per_term)
        fm = fm + 1

    var candidates: [ExhaustiveCandidateV1] = []
    var explanations: [text] = []
    var dn = 0
    while dn < num_docs:
        val doc = all_docs[dn]
        if _matches_filters(doc, filters) and query_terms.len() > 0:
            var bm25_fields: [Bm25FieldV1] = []
            var contexts: [_FieldContext] = []
            var fp = 0
            while fp < BM25_FIELD_NAMES.len():
                var tfs: [i64] = []
                var dfs: [i64] = []
                var rows: [_TermRow] = []
                var tp = 0
                while tp < query_terms.len():
                    val tf = _count_term(doc_field_tokens[dn][fp], query_terms[tp])
                    tfs.push(tf)
                    dfs.push(doc_freq[fp][tp])
                    rows.push(_TermRow(term: query_terms[tp], qtf: query_qtf[tp], tf: tf, df: doc_freq[fp][tp]))
                    tp = tp + 1
                bm25_fields.push(Bm25FieldV1.of(BM25_FIELD_NAMES[fp], query_terms, tfs, dfs,
                    field_lengths[fp][dn], field_stats[fp].total_length, num_docs))
                contexts.push(_FieldContext(field_name: BM25_FIELD_NAMES[fp],
                    weight_milli: BM25_FIELD_WEIGHTS[fp], document_length: field_lengths[fp][dn],
                    stats: field_stats[fp], rows: rows))
                fp = fp + 1
            val score = bm25_fixed_v1_score_checked(bm25_fields)?
            if score.raw_value() > 0:
                val explanation_built = _explanation_json(doc.document_id, scope_digest, logical_root, contexts)?
                # Frozen-contract self-consistency: `build_explanation` must
                # independently reach the same public_score_milli from the
                # same per-term inputs.
                val frozen_score = _frozen_explanation_check(doc.document_id, scope_digest, logical_root, contexts)?
                if frozen_score != explanation_built.1:
                    return Err("explanation_reconciliation_mismatch")
                candidates.push(score_exhaustive_candidate(doc.document_id, bm25_fields, explanation_built.2)?)
                explanations.push("sha256:" + sha256_text(explanation_built.0))
        dn = dn + 1

    val hits = exhaustive_top_k_v1(candidates, k)
    var out: [QueryHitV1] = []
    var hi = 0
    while hi < hits.len():
        var explanation_hash = ""
        var ci = 0
        while ci < candidates.len():
            if candidates[ci].document_id == hits[hi].document_id:
                explanation_hash = explanations[ci]
            ci = ci + 1
        out.push(QueryHitV1.of(hits[hi].document_id, hits[hi].score_milli,
            hits[hi].matched_fields, hits[hi].source_rank, explanation_hash))
        hi = hi + 1
    Ok(out)
