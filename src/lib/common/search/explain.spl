use std.common.search.types.{Score}

struct SearchContribution:
    term: text
    field: text
    term_frequency: i64
    document_frequency: i64
    field_weight_milli: i64
    score: Score

impl SearchContribution:
    static fn of(term: text, field: text, term_frequency: i64, document_frequency: i64, field_weight_milli: i64, score: Score) -> SearchContribution:
        SearchContribution(term: term, field: field, term_frequency: term_frequency, document_frequency: document_frequency, field_weight_milli: field_weight_milli, score: score)

struct SearchExplanation:
    score_contract: text
    contributions: [SearchContribution]

impl SearchExplanation:
    static fn bm25_v1(contributions: [SearchContribution]) -> SearchExplanation:
        SearchExplanation(score_contract: "bm25-fixed-v1", contributions: contributions)

struct FieldExplanationV1:
    field: text
    document_count: i64
    total_length: i64
    average_length_scaled: text
    document_length: i64
    weight_milli: i64
    field_total: text

struct SearchExplanationV1:
    contract: text
    analyzer: text
    score_contract: text
    logical_index: text
    scope_digest: text
    logical_root: text
    document_id: text
    fields: [FieldExplanationV1]
    internal_total: text
    public_score_milli: i64
    tie_key_utf8_hex: text
