use std.common.search.types.{Score}

struct SearchContribution:
    term: text
    field: text
    term_frequency: i64
    document_frequency: i64
    field_weight_milli: i64
    score: Score

impl SearchContribution:
    static fn of(term: text, field: text, term_frequency: i64, document_frequency: i64, field_weight_milli: i64, score: Score) -> SearchContribution:
        SearchContribution(term: term, field: field, term_frequency: term_frequency, document_frequency: document_frequency, field_weight_milli: field_weight_milli, score: score)

struct SearchExplanation:
    score_contract: text
    contributions: [SearchContribution]

impl SearchExplanation:
    static fn bm25_v1(contributions: [SearchContribution]) -> SearchExplanation:
        SearchExplanation(score_contract: "bm25-fixed-v1", contributions: contributions)

struct FieldExplanationV1:
    field: text
    document_count: i64
    total_length: i64
    average_length_scaled: text
    document_length: i64
    weight_milli: i64
    field_total: text

# Frozen §14.14 per-term breakdown. Absent-term records carry the exact
# zeros/nulls the design specifies rather than being omitted; terms are
# ordered ascending unsigned UTF-8 bytes, fields in canonical authorized
# order. Intermediate magnitudes stay decimal STRINGS (I128Decimal), never
# JSON numbers — mixing number and string for the same field is forbidden.
struct TermContributionV1:
    term: text
    field: text
    present: bool
    term_frequency: i64
    document_frequency: i64
    idf_scaled: text
    tf_scaled: text
    weight_milli: i64
    contribution_scaled: text

impl TermContributionV1:
    static fn absent(term: text, field: text) -> TermContributionV1:
        TermContributionV1(term: term, field: field, present: false, term_frequency: 0, document_frequency: 0, idf_scaled: "0", tf_scaled: "0", weight_milli: 0, contribution_scaled: "0")

    static fn of(term: text, field: text, term_frequency: i64, document_frequency: i64, idf_scaled: text, tf_scaled: text, weight_milli: i64, contribution_scaled: text) -> TermContributionV1:
        TermContributionV1(term: term, field: field, present: true, term_frequency: term_frequency, document_frequency: document_frequency, idf_scaled: idf_scaled, tf_scaled: tf_scaled, weight_milli: weight_milli, contribution_scaled: contribution_scaled)

struct SearchExplanationV1:
    contract: text
    analyzer: text
    score_contract: text
    logical_index: text
    scope_digest: text
    logical_root: text
    document_id: text
    fields: [FieldExplanationV1]
    term_contributions: [TermContributionV1]
    internal_total: text
    public_score_milli: i64
    tie_key_utf8_hex: text
