# Frozen §15.2 analyzer identity and seam types. Declarations only — the
# working Unicode-17 algorithm lives in `analyzer.spl` (landed, correct); P1
# adds `analyze_field_v1`/`analyze_query_v1`/`unsigned_utf8_less` over it. Do
# not add executable logic here.

pub enum SearchFieldIdentityV1:
    Identifier
    Title
    Heading
    Classification
    Body

pub enum AnalyzerErrorV1:
    InvalidLimits
    InvalidFieldIdentity
    InputLimitExceeded
    InvalidUtf8
    NormalizedLimitExceeded
    TokenBytesLimitExceeded
    TokenCountLimitExceeded
    DistinctTermLimitExceeded

pub struct AnalyzerIdentityV1:
    analyzer_id: text
    unicode_version: text
    unicode_manifest_sha256: text
    normalization_id: text
    lowercase_id: text
    tokenizer_id: text
    stop_words_id: text
    stop_words_sha256: text
    stemming_id: text
    field_schema_id: text
    limits_schema_id: text

pub struct AnalyzerLimitsV1:
    max_input_bytes: i64
    max_normalized_bytes: i64
    max_token_bytes: i64
    max_tokens: i64
    max_distinct_terms: i64

impl AnalyzerLimitsV1:
    # Frozen query limits (plan §5.1): `AnalyzerLimitsV1(4096, 4096, 4096, 128, 128)`.
    static fn query_default() -> AnalyzerLimitsV1:
        AnalyzerLimitsV1(max_input_bytes: 4096, max_normalized_bytes: 4096, max_token_bytes: 4096, max_tokens: 128, max_distinct_terms: 128)

pub struct AnalyzedTokenV1:
    value: text
    position: i64
    exact_identifier: bool

pub struct AnalyzedTextV1:
    normalized: text
    tokens: [AnalyzedTokenV1]

pub struct AnalyzedQueryTermV1:
    value: text
    qtf: i64

pub struct AnalyzedQueryV1:
    normalized: text
    terms: [AnalyzedQueryTermV1]

# Frozen stop-word set identity (plan §15.2): `en-basic-v1`, sha256
# `6f0a7c26d3d0e3d06a2fbbbeaa1843294f83c3be26baf1c04651191e011510bf`. P1 asserts
# this against the live stop-word list rather than assuming it.
pub val ANALYZER_STOP_WORDS_ID: text = "en-basic-v1"
pub val ANALYZER_STOP_WORDS_SHA256: text = "6f0a7c26d3d0e3d06a2fbbbeaa1843294f83c3be26baf1c04651191e011510bf"
pub val ANALYZER_CONTRACT_V1_ID: text = "spipe-unicode-lex-v1"
