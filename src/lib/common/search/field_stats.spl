# ============================================================================
# common/search/field_stats.spl — per-field corpus statistics (P3)
#
# Builds the frozen `FieldStatsV1` record (§14.3, `corpus_stats.spl`) from raw
# per-document field lengths. Pure declaration-free arithmetic: this module
# owns no scoring, only the corpus-level aggregation `FieldStatsV1.of` needs.
#
# Fixed point only — `total_length`/`num_docs`/`average_length_scaled` are all
# i64. Never introduce an f64 accumulator here (see plan hazard #1).
# ============================================================================

use std.common.search.corpus_stats.{FieldStatsV1, BM25_FIELD_NAMES}

val FIELD_STATS_UNKNOWN_FIELD: text = "unknown_field"
val FIELD_STATS_INVALID_LENGTH: text = "invalid_field_length"
val FIELD_STATS_INVALID_FIELD_ORDER: text = "invalid_field_order"

fn _field_ordinal(field: text) -> i64:
    var i = 0
    while i < BM25_FIELD_NAMES.len():
        if BM25_FIELD_NAMES[i] == field:
            return i
        i = i + 1
    0 - 1

# Build the closed-form per-field statistics for one authorized field from the
# lengths of every live document counted in that field's corpus (a document
# absent from the field contributes 0, per §14.3's N = live documents in the
# field corpus).
fn build_field_stats(field: text, document_lengths: [i64]) -> Result<FieldStatsV1, text>:
    if _field_ordinal(field) < 0:
        return Err(FIELD_STATS_UNKNOWN_FIELD)
    var total: i64 = 0
    var i = 0
    while i < document_lengths.len():
        val length = document_lengths[i]
        if length < 0:
            return Err(FIELD_STATS_INVALID_LENGTH)
        total = total + length
        i = i + 1
    Ok(FieldStatsV1.of(field, document_lengths.len(), total))

# Build per-field statistics for a table of fields, each with its own
# document-length column. `fields` must be given in the canonical closed
# order (strictly ascending ordinal against `BM25_FIELD_NAMES`); a caller
# that wants only a subset of fields still must not reorder or duplicate one.
fn build_field_stats_table(fields: [text],
                           lengths_by_field: [[i64]]) -> Result<[FieldStatsV1], text>:
    if fields.len() != lengths_by_field.len():
        return Err(FIELD_STATS_INVALID_FIELD_ORDER)
    var out: [FieldStatsV1] = []
    var prior_ordinal: i64 = 0 - 1
    var i = 0
    while i < fields.len():
        val ordinal = _field_ordinal(fields[i])
        if ordinal < 0:
            return Err(FIELD_STATS_UNKNOWN_FIELD)
        if ordinal <= prior_ordinal:
            return Err(FIELD_STATS_INVALID_FIELD_ORDER)
        prior_ordinal = ordinal
        val stats = build_field_stats(fields[i], lengths_by_field[i])?
        out.push(stats)
        i = i + 1
    Ok(out)
