use std.common.search.analyzer.{AnalyzerIdentity}
use std.common.search.document.{SearchDocument}
use std.common.search.document.{ScopedSearchDocumentV1}

struct SearchIndexDelta:
    base_snapshot_id: text
    upserts: [SearchDocument]
    deletes: [text]

impl SearchIndexDelta:
    static fn of(base_snapshot_id: text, upserts: [SearchDocument], deletes: [text]) -> SearchIndexDelta:
        SearchIndexDelta(base_snapshot_id: base_snapshot_id, upserts: upserts, deletes: deletes)

struct SearchSnapshot:
    snapshot_id: text
    revision: text
    analyzer: AnalyzerIdentity
    score_contract: text
    documents: [SearchDocument]

impl SearchSnapshot:
    static fn of(snapshot_id: text, revision: text, analyzer: AnalyzerIdentity, documents: [SearchDocument]) -> SearchSnapshot:
        SearchSnapshot(snapshot_id: snapshot_id, revision: revision, analyzer: analyzer, score_contract: "bm25-fixed-v1", documents: documents)

    fn apply(delta: SearchIndexDelta, next_snapshot_id: text, next_revision: text) -> Result<SearchSnapshot, text>:
        if delta.base_snapshot_id != self.snapshot_id:
            return Err("snapshot_mismatch")
        var next: [SearchDocument] = []
        var i = 0
        while i < self.documents.len():
            val current = self.documents[i]
            var removed = false
            var d = 0
            while d < delta.deletes.len():
                if delta.deletes[d] == current.id:
                    removed = true
                d = d + 1
            var replaced = false
            var u = 0
            while u < delta.upserts.len():
                if delta.upserts[u].id == current.id:
                    replaced = true
                u = u + 1
            if not removed and not replaced:
                next.push(current)
            i = i + 1
        var u = 0
        while u < delta.upserts.len():
            next.push(delta.upserts[u])
            u = u + 1
        Ok(SearchSnapshot.of(next_snapshot_id, next_revision, self.analyzer, next))

struct IndexOperationV1:
    kind: text
    document_id: text
    before_revision: text?
    before_hash: text?
    after: ScopedSearchDocumentV1?

impl IndexOperationV1:
    static fn add(after: ScopedSearchDocumentV1) -> IndexOperationV1:
        IndexOperationV1(kind: "add", document_id: after.document_id, before_revision: nil, before_hash: nil, after: after)

    static fn replace(before_revision: text, before_hash: text, after: ScopedSearchDocumentV1) -> IndexOperationV1:
        IndexOperationV1(kind: "replace", document_id: after.document_id, before_revision: before_revision, before_hash: before_hash, after: after)

    static fn delete_present(document_id: text, before_revision: text, before_hash: text) -> IndexOperationV1:
        IndexOperationV1(kind: "delete", document_id: document_id, before_revision: before_revision, before_hash: before_hash, after: nil)

    static fn delete_absent(document_id: text) -> IndexOperationV1:
        IndexOperationV1(kind: "delete", document_id: document_id, before_revision: nil, before_hash: nil, after: nil)

    fn has_closed_preconditions() -> bool:
        if self.kind == "add":
            return self.before_revision == nil and self.before_hash == nil and self.after != nil
        if self.kind == "replace":
            return self.before_revision != nil and self.before_hash != nil and self.after != nil
        if self.kind == "delete":
            return (self.before_revision == nil and self.before_hash == nil) or (self.before_revision != nil and self.before_hash != nil)
        false

struct IndexApplyRequestV1:
    operation_id: text
    payload_hash: text
    base_logical_root: text
    operations: [IndexOperationV1]

struct IndexCandidateV1:
    status: text
    base_logical_root: text
    candidate_uid: text
    candidate_logical_root: text
    candidate_expires_at_ms: i64
    added: i64
    replaced: i64
    deleted: i64

struct IndexPublishRequestV1:
    operation_id: text
    payload_hash: text
    action: text
    candidate_uid: text
    expected_base_logical_root: text
    candidate_logical_root: text

struct IndexPublishResultV1:
    status: text
    previous_logical_root: text
    logical_root: text
    candidate_uid: text

struct OperationReceiptV1:
    operation_id: text
    payload_hash: text
    scope_digest: text
    outcome: text
    result_hash: text
    signature: text

struct ReplayRecordV1:
    operation_id: text
    payload_hash: text
    result_bytes_hash: text
    receipt: OperationReceiptV1

impl ReplayRecordV1:
    fn accepts(operation_id: text, payload_hash: text) -> Result<bool, text>:
        if operation_id != self.operation_id:
            return Err("operation_not_found")
        if payload_hash != self.payload_hash:
            return Err("operation_conflict")
        Ok(true)

# Frozen §14.16/§14.17 candidate lifecycle records. A candidate is a durable,
# expiring intermediate between `index_apply` and `index_publish`; publication
# and terminal-error records are the two ways a candidate resolves.
struct CandidateRecordV1:
    candidate_uid: text
    operation_id: text
    payload_hash: text
    base_logical_root: text
    candidate_logical_root: text
    created_at_ms: i64
    expires_at_ms: i64
    status: text

struct PublicationRecordV1:
    candidate_uid: text
    operation_id: text
    previous_logical_root: text
    logical_root: text
    published_at_ms: i64

struct DurableTerminalErrorV1:
    operation_id: text
    payload_hash: text
    code: text
    message: text
    occurred_at_ms: i64

struct CandidateExpiryReceiptV1:
    candidate_uid: text
    operation_id: text
    base_logical_root: text
    expired_at_ms: i64

# Frozen §14.16 query-side receipt, distinct from `OperationReceiptV1` (which
# binds a mutation). Provider adoption replaces the local
# `OperationReceiptBindingV1` shape — see recorded debt item 3.
struct QueryReceiptV1:
    request_id: text
    logical_root: text
    scope_digest: text
    query_digest: text
    result_hash: text
    signature: text
