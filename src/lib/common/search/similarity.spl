# P10 — sparse token-frequency vectors + fixed-point cosine similarity.
#
# Moved out of `src/compiler/90.tools/duplicate_check/{features,math_utils}.spl`
# (which used `f64`) into fixed-point `i64` here per the hard rule for this
# package. The tool keeps its own `f64`-based legacy path for compatibility
# report parity and calls this module for new pure-lexical scoring.
#
# Design: doc/05_design/infra/spipe/spipe_knowledge_compiler_search_providers.md §7

use std.common.search.fingerprint.{SIMILARITY_SCALE}

pub struct SparseTermVectorV1:
    terms: {text: i64}
    total: i64

pub fn build_sparse_vector(tokens: [text]) -> SparseTermVectorV1:
    """Build a sparse token-frequency vector from a pre-tokenized stream."""
    var counts: {text: i64} = {}
    var total = 0
    var i = 0
    while i < tokens.len():
        val t = tokens[i]
        val current = counts[t] ?? 0
        counts[t] = current + 1
        total = total + 1
        i = i + 1
    SparseTermVectorV1(terms: counts, total: total)

fn isqrt(value: i64) -> i64:
    """Integer square root via Newton's method — no f64 anywhere in this
    module."""
    if value <= 0:
        return 0
    var x = value
    var y = (x + 1) / 2
    while y < x:
        x = y
        y = (x + value / x) / 2
    x

pub fn cosine_similarity_fixed(a: SparseTermVectorV1, b: SparseTermVectorV1) -> i64:
    """Cosine similarity between two sparse frequency vectors, fixed-point
    scaled by SIMILARITY_SCALE. Returns 0 for an empty vector on either side."""
    if a.total == 0 or b.total == 0:
        return 0
    var dot: i64 = 0
    var sum_sq_a: i64 = 0
    var sum_sq_b: i64 = 0
    val a_keys = a.terms.keys()
    var i = 0
    while i < a_keys.len():
        val key = a_keys[i]
        val fa = a.terms[key]
        sum_sq_a = sum_sq_a + fa * fa
        i = i + 1
    val b_keys = b.terms.keys()
    var j = 0
    while j < b_keys.len():
        val key = b_keys[j]
        val fb = b.terms[key]
        sum_sq_b = sum_sq_b + fb * fb
        j = j + 1
    var k = 0
    while k < a_keys.len():
        val key = a_keys[k]
        if b.terms.has(key):
            dot = dot + a.terms[key] * b.terms[key]
        k = k + 1
    if sum_sq_a == 0 or sum_sq_b == 0:
        return 0
    # Avoid taking isqrt(sum_sq_a) and isqrt(sum_sq_b) independently — their
    # product loses precision whenever either magnitude isn't a perfect
    # square (e.g. self-similarity of a vector with sum_sq=6 would compute as
    # isqrt(6)*isqrt(6) = 2*2 = 4, not 6). Instead take the isqrt once, on the
    # already-squared-and-scaled ratio, so an exact self-comparison
    # (dot*dot == sum_sq_a*sum_sq_b) yields exactly SIMILARITY_SCALE.
    val numerator = dot * dot * SIMILARITY_SCALE * SIMILARITY_SCALE
    val denominator = sum_sq_a * sum_sq_b
    isqrt(numerator / denominator)
