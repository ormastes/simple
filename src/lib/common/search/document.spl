use std.common.search.types.{Score}
use std.common.search.explain.{SearchExplanationV1}

struct SearchFacet:
    name: text
    value: text

impl SearchFacet:
    static fn of(name: text, value: text) -> SearchFacet:
        SearchFacet(name: name, value: value)

struct SearchField:
    name: text
    value: text
    weight_milli: i64

impl SearchField:
    static fn of(name: text, value: text, weight_milli: i64) -> SearchField:
        SearchField(name: name, value: value, weight_milli: weight_milli)

struct SearchDocument:
    id: text
    revision: text
    fields: [SearchField]
    metadata: [SearchFacet]

impl SearchDocument:
    static fn of(id: text, revision: text, fields: [SearchField], metadata: [SearchFacet]) -> SearchDocument:
        SearchDocument(id: id, revision: revision, fields: fields, metadata: metadata)

    fn public_id() -> text: self.id

# Closed compiler-owned projection. SearchDocument above remains the legacy
# compatibility record; new trust boundaries use this versioned shape.
struct SearchDocumentV1:
    document_id: text
    revision: text
    fields: [SearchField]
    facets: [SearchFacet]
    visibility_digest: text
    content_hash: text

impl SearchDocumentV1:
    static fn of(document_id: text, revision: text, fields: [SearchField], facets: [SearchFacet], visibility_digest: text, content_hash: text) -> SearchDocumentV1:
        SearchDocumentV1(document_id: document_id, revision: revision, fields: fields, facets: facets, visibility_digest: visibility_digest, content_hash: content_hash)

    fn has_canonical_field_contract() -> bool:
        if self.fields.len() != 5:
            return false
        self.fields[0].name == "identifier" and self.fields[0].weight_milli == 4000 and
        self.fields[1].name == "title" and self.fields[1].weight_milli == 4000 and
        self.fields[2].name == "heading" and self.fields[2].weight_milli == 2500 and
        self.fields[3].name == "classification" and self.fields[3].weight_milli == 2000 and
        self.fields[4].name == "body" and self.fields[4].weight_milli == 1000

struct SearchScopeV1:
    principal_uid: text
    workspace_uid: text
    revision_id: text
    policy_version: text
    policy_digest: text
    project_uids: [text]
    visibility_partitions: [text]
    searchable_fields: [text]
    facet_names: [text]
    scope_digest: text

impl SearchScopeV1:
    static fn of(principal_uid: text, workspace_uid: text, revision_id: text, policy_version: text, policy_digest: text, project_uids: [text], visibility_partitions: [text], searchable_fields: [text], facet_names: [text], scope_digest: text) -> SearchScopeV1:
        SearchScopeV1(principal_uid: principal_uid, workspace_uid: workspace_uid, revision_id: revision_id, policy_version: policy_version, policy_digest: policy_digest, project_uids: project_uids, visibility_partitions: visibility_partitions, searchable_fields: searchable_fields, facet_names: facet_names, scope_digest: scope_digest)

struct ScopedFieldV1:
    name: text
    value: text

impl ScopedFieldV1:
    static fn of(name: text, value: text) -> ScopedFieldV1: ScopedFieldV1(name: name, value: value)

struct ScopedFacetV1:
    name: text
    value: text

impl ScopedFacetV1:
    static fn of(name: text, value: text) -> ScopedFacetV1: ScopedFacetV1(name: name, value: value)

struct ScopedSearchDocumentV1:
    document_id: text
    revision: text
    fields: [ScopedFieldV1]
    facets: [ScopedFacetV1]
    visibility_digest: text
    scoped_content_hash: text
    scope_digest: text

impl ScopedSearchDocumentV1:
    static fn of(document_id: text, revision: text, fields: [ScopedFieldV1], facets: [ScopedFacetV1], visibility_digest: text, scoped_content_hash: text, scope_digest: text) -> ScopedSearchDocumentV1:
        ScopedSearchDocumentV1(document_id: document_id, revision: revision, fields: fields, facets: facets, visibility_digest: visibility_digest, scoped_content_hash: scoped_content_hash, scope_digest: scope_digest)

    fn is_bound_to(scope: SearchScopeV1) -> bool:
        self.scope_digest == scope.scope_digest

struct SearchHit:
    document_id: text
    score: Score
    rank: i64

impl SearchHit:
    static fn of(document_id: text, score: Score, rank: i64) -> SearchHit:
        SearchHit(document_id: document_id, score: score, rank: rank)

# Frozen Wave-4 wire hit shape (design §14.11/§14.12). `explanation` is
# non-null iff the request asked for one; `matched_fields` is a subset of
# `BM25_FIELD_NAMES` (corpus_stats.spl), max 5 entries.
struct SearchHitV1:
    document_id: text
    score_milli: i64
    source_rank: i64
    matched_fields: [text]
    explanation: SearchExplanationV1?

impl SearchHitV1:
    static fn of(document_id: text, score_milli: i64, source_rank: i64, matched_fields: [text], explanation: SearchExplanationV1?) -> SearchHitV1:
        SearchHitV1(document_id: document_id, score_milli: score_milli, source_rank: source_rank, matched_fields: matched_fields, explanation: explanation)

    fn has_valid_rank() -> bool:
        self.source_rank >= 1 and self.source_rank <= 1000

    fn has_valid_matched_fields() -> bool:
        self.matched_fields.len() <= 5
