# Executable DebugWireV1 boundary for operations implemented by DebugServiceV1.
# Payloads use a deliberately small pipe-delimited V1 encoding. Fields which
# contain a pipe are rejected rather than guessed or silently truncated.

use std.common.debug.contracts_v1.{
    DebugWireV1, DebugSessionId, DebugRootOperationV1, DebugPerturbationV1,
    DebugProbeKindV1, DebugProbeV1, DebugEvidenceArtifactV1,
    DebugEvidenceManifestV1, DebugReceiptV1, debug_wire_negotiate_v1,
}
use std.common.debug.service_v1.{
    central_debug_service_v1_authorize, central_debug_service_v1_record,
    central_debug_service_v1_probes, central_debug_service_v1_apply_probe,
    central_debug_service_v1_remove_probe, central_debug_service_v1_export_evidence,
    central_debug_service_v1_receipts,
}

pub struct DebugWireExecutionResultV1:
    request_id: text
    command: text
    summary: text
    probes: [DebugProbeV1]
    manifest: Option<DebugEvidenceManifestV1>
    inspected_artifact: Option<DebugEvidenceArtifactV1>
    receipt: DebugReceiptV1

fn rejected_execution_v1(wire: DebugWireV1, reason: text) -> Result<DebugWireExecutionResultV1, text>:
    central_debug_service_v1_record(
        DebugSessionId(value: wire.session_id),
        DebugRootOperationV1.Observe,
        DebugPerturbationV1.Passive,
        "wire.execute.reject",
        false,
        false,
        reason,
    )
    Err(reason)

fn validate_envelope_v1(wire: DebugWireV1) -> Result<Nil, text>:
    val negotiated = debug_wire_negotiate_v1(wire.version)
    if not negotiated.accepted:
        return Err(negotiated.reason)
    if wire.request_id.trim() == "":
        return Err("debug wire request requires a request id")
    if wire.session_id.trim() == "":
        return Err("debug wire request requires a session id")
    if wire.payload_type != "debug-wire-command-v1":
        return Err("unsupported debug wire payload type")
    Ok(nil)

fn probe_kind_v1(value: text) -> Result<DebugProbeKindV1, text>:
    match value:
        case "stop": Ok(DebugProbeKindV1.Stop)
        case "log": Ok(DebugProbeKindV1.Log)
        case "trace": Ok(DebugProbeKindV1.Trace)
        case "watch": Ok(DebugProbeKindV1.Watch)
        case "count": Ok(DebugProbeKindV1.Count)
        case "snapshot": Ok(DebugProbeKindV1.Snapshot)
        case "dump": Ok(DebugProbeKindV1.Dump)
        case _: Err("unsupported debug probe kind")

fn perturbation_v1(value: text) -> Result<DebugPerturbationV1, text>:
    match value:
        case "passive": Ok(DebugPerturbationV1.Passive)
        case "cooperative": Ok(DebugPerturbationV1.Cooperative)
        case "stopping": Ok(DebugPerturbationV1.Stopping)
        case "mutating": Ok(DebugPerturbationV1.Mutating)
        case _: Err("unsupported debug perturbation")

fn artifact_v1(parts: [text], offset: i64) -> Result<DebugEvidenceArtifactV1, text>:
    if parts.len() < offset + 5:
        return Err("invalid evidence payload")
    if parts[offset].trim() == "" or parts[offset + 2].trim() == "":
        return Err("evidence artifacts require path and digest")
    if parts[offset + 3] != "true" and parts[offset + 3] != "false":
        return Err("evidence native field must be true or false")
    Ok(DebugEvidenceArtifactV1(
        path: parts[offset],
        media_type: parts[offset + 1],
        digest: parts[offset + 2],
        native: parts[offset + 3] == "true",
        privacy_label: parts[offset + 4],
    ))

fn result_v1(wire: DebugWireV1, summary: text, probes: [DebugProbeV1], manifest: Option<DebugEvidenceManifestV1>, artifact: Option<DebugEvidenceArtifactV1>, receipt: DebugReceiptV1) -> DebugWireExecutionResultV1:
    DebugWireExecutionResultV1(
        request_id: wire.request_id,
        command: wire.command,
        summary: summary,
        probes: probes,
        manifest: manifest,
        inspected_artifact: artifact,
        receipt: receipt,
    )

pub fn execute_debug_wire_v1(wire: DebugWireV1) -> Result<DebugWireExecutionResultV1, text>:
    match validate_envelope_v1(wire):
        case Err(reason): return rejected_execution_v1(wire, reason)
        case Ok(_): pass_do_nothing("wire envelope validated")

    val session_id = DebugSessionId(value: wire.session_id)
    if wire.operation == "control" and wire.domain == "evidence" and (wire.command == "reproduce" or wire.command == "replay"):
        return rejected_execution_v1(wire, "debug " + wire.command + " has no verified executor")

    if wire.operation == "probe" and wire.domain == "probe" and wire.command == "probe.list":
        if wire.payload.trim() != "":
            return rejected_execution_v1(wire, "probe.list payload must be empty")
        val receipt = central_debug_service_v1_authorize(session_id, DebugRootOperationV1.Probe, DebugPerturbationV1.Passive, "wire.execute.probe.list")
        if not receipt.allowed:
            return Err(receipt.reason)
        val probes = central_debug_service_v1_probes(session_id)
        return Ok(result_v1(wire, "listed {probes.len()} applied probes", probes, None, None, receipt))

    if wire.operation == "probe" and wire.domain == "probe" and wire.command == "probe.apply":
        val parts = wire.payload.split("|")
        if parts.len() != 5:
            return rejected_execution_v1(wire, "probe.apply payload must be kind|target|source-anchor|perturbation|expires-at-ns")
        val kind = match probe_kind_v1(parts[0]):
            case Ok(value): value
            case Err(reason): return rejected_execution_v1(wire, reason)
        val perturbation = match perturbation_v1(parts[3]):
            case Ok(value): value
            case Err(reason): return rejected_execution_v1(wire, reason)
        val expires_at = parts[4].to_i64()
        if expires_at == nil:
            return rejected_execution_v1(wire, "probe expiry must be an integer nanosecond timestamp")
        val probe = match central_debug_service_v1_apply_probe(session_id, kind, parts[1], parts[2], perturbation, expires_at ?? -1):
            case Ok(value): value
            case Err(reason): return Err(reason)
        val probes = central_debug_service_v1_probes(session_id)
        val receipts = central_debug_service_v1_receipts(session_id)
        val receipt = receipts[receipts.len() - 1]
        return Ok(result_v1(wire, "applied " + probe.probe_id, probes, None, None, receipt))

    if wire.operation == "probe" and wire.domain == "probe" and wire.command == "probe.remove":
        if wire.payload.trim() == "" or wire.payload.contains("|"):
            return rejected_execution_v1(wire, "probe.remove payload must be one probe id")
        match central_debug_service_v1_remove_probe(session_id, wire.payload):
            case Err(reason): return Err(reason)
            case Ok(_): pass_do_nothing("probe removed")
        val probes = central_debug_service_v1_probes(session_id)
        val receipts = central_debug_service_v1_receipts(session_id)
        val receipt = receipts[receipts.len() - 1]
        return Ok(result_v1(wire, "removed " + wire.payload, probes, None, None, receipt))

    if wire.operation == "evidence" and wire.domain == "evidence" and wire.command == "inspect":
        val parts = wire.payload.split("|")
        if parts.len() != 5:
            return rejected_execution_v1(wire, "inspect payload must be path|media-type|digest|native|privacy-label")
        val artifact = match artifact_v1(parts, 0):
            case Ok(value): value
            case Err(reason): return rejected_execution_v1(wire, reason)
        val receipt = central_debug_service_v1_authorize(session_id, DebugRootOperationV1.Evidence, DebugPerturbationV1.Passive, "wire.execute.evidence.inspect")
        if not receipt.allowed:
            return Err(receipt.reason)
        return Ok(result_v1(wire, "inspected " + artifact.path, [], None, Some(artifact), receipt))

    if wire.operation == "evidence" and wire.domain == "evidence" and wire.command == "evidence.export":
        val parts = wire.payload.split("|")
        if parts.len() != 6:
            return rejected_execution_v1(wire, "evidence.export payload must be captured-at-ns|path|media-type|digest|native|privacy-label")
        val captured_at = parts[0].to_i64()
        if captured_at == nil:
            return rejected_execution_v1(wire, "evidence capture time must be an integer nanosecond timestamp")
        val artifact = match artifact_v1(parts, 1):
            case Ok(value): value
            case Err(reason): return rejected_execution_v1(wire, reason)
        val manifest = match central_debug_service_v1_export_evidence(session_id, captured_at ?? -1, [artifact]):
            case Ok(value): value
            case Err(reason): return Err(reason)
        val receipts = central_debug_service_v1_receipts(session_id)
        val receipt = receipts[receipts.len() - 1]
        return Ok(result_v1(wire, "exported debug-evidence-v1", [], Some(manifest), None, receipt))

    rejected_execution_v1(wire, "unsupported executable debug wire command")
