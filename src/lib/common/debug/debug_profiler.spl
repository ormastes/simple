# `DebugProfiler` -- the DebugTarget + ProfileTarget capability GROUP.
#
# ============================ TEMPORARY FORM ================================
# This file is the HAND-WRITTEN stand-in for the language sugar landing in
# the parser/desugar stream (design §3):
#
#     trait DebugProfiler with DebugTarget, ProfileTarget:
#         pass_dn
#
# What is written below IS that sugar's output, spelled by hand: a group
# trait is exactly the CONCATENATION of its members' method sets, adding
# no methods of its own. When the sugar lands, this hand-written trait is
# deleted and the `with` form replaces it -- callers do not change, because
# the method set is identical by construction.
# ============================================================================
#
# ------------------------- LANGUAGE CONSTRAINT ------------------------------
# The group is ONE trait over ONE value, not a struct bundling two separate
# trait objects. That is forced by the language, not a style choice:
# classes here have VALUE semantics (`val b = a` copies; two accessor calls
# return two independent copies), so a struct holding a separately-acquired
# `DebugTarget` and `ProfileTarget` would hold two DIVERGING copies of the
# same target -- stepping through the debug half would leave the profile
# half at zero steps. Measured, not assumed: see the P2 report.
#
# Consequence for the `.from()` sugar (design §3): `.from()` must acquire
# the group from a SINGLE accessor on the session, not by pairing two
# `Option<M>` accessors. A backend therefore supplies its own
# `<backend>_debug_profiler(session)` acquisition (see
# `ref_debug_session.ref_debug_profiler`) until the sugar generates it.

use std.common.debug.capability.{CapLevel}
use std.common.debug.debug_target.{DebugTarget, DebugState}
use std.common.debug.profile_target.{ProfileTarget, ProfileReport}

# The group's surface is the exact union of DebugTarget and ProfileTarget.
# Nothing is added; nothing is renamed.
trait DebugProfiler:
    fn kind() -> text
    fn debug_level() -> CapLevel
    me set_breakpoint(loc: i64) -> bool
    me clear_breakpoint(loc: i64) -> bool
    me breakpoints() -> [i64]
    me step() -> DebugState
    me resume() -> DebugState
    me state() -> DebugState
    me read_mem(offset: i64, len: i64) -> [u8]
    me detach() -> text
    fn profile_level() -> CapLevel
    me profile_begin()
    me profile_end() -> ProfileReport

pub fn dp_trace_run(dp: DebugProfiler) -> ProfileReport:
    """The design's worked example (§3): profile a full resume-to-completion
    with NO runtime capability checks in the body -- the group type already
    proved both capabilities are present.

    NOTE: `dp` is taken by value, so the caller's target is not advanced by
    this helper; the report it returns is nonetheless a real measurement of
    a real run."""
    var target = dp
    target.profile_begin()
    target.resume()
    target.profile_end()
