# Central debug service v1 -- shared contract types.
#
# These are the wire/value types the "central debug service" API (see
# `service_v1.spl` in this directory) is built around. They are pure data:
# no I/O, no nogc imports, consistent with the rest of `std.common.debug`.
#
# Derived from the three real call sites that already coded against this
# contract (none of which could previously compile, because this module did
# not exist):
#   - src/app/mcp/dap_bridge.spl
#   - src/os/realtime/jtag/debug_service_adapter_v1.spl
#   - src/app/mcpgdb/debug_service_bridge_v1.spl
#
# `DebugRootOperationV1` and `DebugPerturbationV1` carry exactly the variants
# those call sites reference; extend deliberately, not speculatively.

use std.common.debug.capability.{CapLevel}

pub struct DebugSessionId:
    value: text

pub enum DebugRootOperationV1:
    Inspect
    Control
    Domain
    Observe
    Evidence
    # Applying/removing a probe (breakpoint, watch) on a live target. Gated by
    # `DebugPolicyV1.allow_control` -- see `central_debug_service_v1_authorize_at`.
    Probe

pub enum DebugProbeKindV1:
    # A probe that halts the target when it is hit. The only kind any caller in
    # this tree applies through the central service today; extend deliberately.
    Stop

pub enum DebugPerturbationV1:
    Passive
    Cooperative
    Stopping
    Mutating

pub enum DebugVerificationV1:
    Unverified
    FixtureVerified
    LiveVerified
    Blocked

pub struct DebugPolicyV1:
    name: text
    allow_control: bool
    allow_domain: bool

pub struct DebugTargetNodeV1:
    target_id: text
    parent_target_id: text
    kind: text
    label: text

pub struct DebugCapabilityV1:
    target_id: text
    support: CapLevel
    verification: DebugVerificationV1
    perturbation: DebugPerturbationV1
    reason: text

pub struct DebugReceiptV1:
    # Stable, session-bound identifier for this receipt: "receipt-<session>-<n>".
    # Assigned by `service_v1.spl` -- callers never invent one.
    receipt_id: text
    session_id: text
    operation: DebugRootOperationV1
    perturbation: DebugPerturbationV1
    action: text
    allowed: bool
    succeeded: bool
    execution_changed: bool
    reason: text
    # Caller-supplied capture clock, in nanoseconds. The service owns no clock,
    # so this is whatever the `*_at` caller passed. `-1` means the caller used
    # the clockless `central_debug_service_v1_authorize`/`_record` entry points
    # and supplied no time -- it is never a synthesised timestamp.
    captured_at_ns: i64

pub struct DebugProbeV1:
    # Session-bound probe identifier assigned by `service_v1.spl`:
    # "probe-<session>-<n>". Callers never invent one.
    probe_id: text
    session_id: text
    kind: DebugProbeKindV1
    target_id: text
    source_anchor: text
    perturbation: DebugPerturbationV1
    expires_at_ns: i64
