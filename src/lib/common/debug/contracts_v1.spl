# Versioned, backend-neutral contracts for unified debugging and evidence.

use std.common.debug.capability.{CapLevel}

pub enum DebugVerificationV1:
    LiveVerified
    FixtureVerified
    Unverified
    Blocked

pub enum DebugPerturbationV1:
    Passive
    Cooperative
    Stopping
    Mutating

pub enum DebugProvenanceV1:
    Observed
    Caused

pub enum DebugRootOperationV1:
    Observe
    Inspect
    Control
    Probe
    Profile
    Evidence
    Domain

pub struct DebugWireV1:
    version: text
    request_id: text
    session_id: text
    operation: text
    domain: text
    command: text
    payload_type: text
    payload: text

pub struct DebugWireNegotiationV1:
    accepted: bool
    local_major: i64
    peer_major: i64
    reason: text

pub fn debug_wire_negotiate_v1(peer_version: text) -> DebugWireNegotiationV1:
    if peer_version == "debug-wire-v1" or peer_version.starts_with("debug-wire-v1."):
        return DebugWireNegotiationV1(accepted: true, local_major: 1, peer_major: 1, reason: "")
    if peer_version.starts_with("debug-wire-v2"):
        return DebugWireNegotiationV1(accepted: false, local_major: 1, peer_major: 2, reason: "unsupported debug wire major")
    DebugWireNegotiationV1(accepted: false, local_major: 1, peer_major: -1, reason: "invalid debug wire version")

pub fn debug_wire_v1(request_id: text, session_id: text, operation: text, domain: text, command: text, payload_type: text, payload: text) -> DebugWireV1:
    DebugWireV1(
        version: "debug-wire-v1",
        request_id: request_id,
        session_id: session_id,
        operation: operation,
        domain: domain,
        command: command,
        payload_type: payload_type,
        payload: payload,
    )

pub struct DebugSessionId:
    value: text

pub struct DebugCapabilityV1:
    target_id: text
    support: CapLevel
    verification: DebugVerificationV1
    perturbation: DebugPerturbationV1
    reason: text

pub struct DebugTargetNodeV1:
    target_id: text
    parent_target_id: text
    kind: text
    label: text

pub enum DebugTargetEdgeKindV1:
    Owns
    Executes
    Calls
    Sends
    Renders
    Queries
    Boundary

pub struct DebugTargetEdgeV1:
    from_target_id: text
    to_target_id: text
    kind: DebugTargetEdgeKindV1
    boundary: text

pub struct DebugTargetGraphV1:
    session_id: DebugSessionId
    build_id: text
    nodes: [DebugTargetNodeV1]
    edges: [DebugTargetEdgeV1]
    capabilities: [DebugCapabilityV1]

pub struct DebugEventV1:
    event_id: text
    session_id: DebugSessionId
    build_id: text
    source_anchor: text
    symbol_id: text
    trace_id: text
    span_id: text
    task_id: text
    actor_id: text
    connection_id: text
    transaction_id: text
    query_id: text
    clock_name: text
    clock_value: i64
    privacy_label: text
    payload_type: text
    payload: text
    provenance: DebugProvenanceV1

pub struct DebugPolicyV1:
    allow_observe: bool
    allow_inspect: bool
    allow_control: bool
    allow_probe: bool
    allow_profile: bool
    allow_evidence: bool
    allow_mutation: bool
    allow_domain: bool
    redact_payloads: bool
    ttl_ms: i64
    rate_limit_per_minute: i64
    retention_ms: i64
    environment: text
    required_privilege: text

pub struct DebugAuthorizationContextV1:
    now_ns: i64
    environment: text
    privilege: text

pub fn debug_policy_observe_only_v1() -> DebugPolicyV1:
    DebugPolicyV1(
        allow_observe: true,
        allow_inspect: true,
        allow_control: false,
        allow_probe: false,
        allow_profile: true,
        allow_evidence: true,
        allow_mutation: false,
        allow_domain: false,
        redact_payloads: true,
        ttl_ms: 3600000,
        rate_limit_per_minute: 60,
        retention_ms: 86400000,
        environment: "any",
        required_privilege: "observe",
    )

pub fn debug_policy_development_v1() -> DebugPolicyV1:
    DebugPolicyV1(
        allow_observe: true,
        allow_inspect: true,
        allow_control: true,
        allow_probe: true,
        allow_profile: true,
        allow_evidence: true,
        allow_mutation: false,
        allow_domain: true,
        redact_payloads: true,
        ttl_ms: 3600000,
        rate_limit_per_minute: 600,
        retention_ms: 86400000,
        environment: "development",
        required_privilege: "debug",
    )

pub enum DebugProbeKindV1:
    Stop
    Log
    Trace
    Watch
    Count
    Snapshot
    Dump

pub enum DebugProbeStateV1:
    Applied
    Removed
    Expired
    Blocked

pub struct DebugProbeV1:
