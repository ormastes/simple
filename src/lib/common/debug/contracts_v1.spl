    kind: DebugProbeKindV1
    target_id: text
    source_anchor: text
    state: DebugProbeStateV1
    expires_at_ns: i64

pub struct DebugEvidenceArtifactV1:
    path: text
    media_type: text
    digest: text
    native: bool
    privacy_label: text

pub struct DebugEvidenceManifestV1:
    schema: text
    session_id: DebugSessionId
    build_id: text
    captured_at_ns: i64
    artifacts: [DebugEvidenceArtifactV1]

pub struct BoundaryFrameV1:
    from_runtime: text
    to_runtime: text
    source_anchor: text
    symbol_id: text
    generated_location: text

pub struct QueryDebugV1:
    engine: text
    dialect: text
    database: text
    schema: text
    connection_id: text
    transaction_id: text
    savepoint_id: text
    source_anchor: text
    trace_id: text
    task_id: text
    actor_id: text
    statement_digest: text
    sanitized_template: text
    bind_shape: text
    bind_types: text
    estimated_plan: text
    actual_plan: text
    elapsed_ns: i64
    rows: i64
    waits: text
    locks: text
    cache_stats: text
    buffer_stats: text
    error: text
    retries: i64
    raw_evidence: text

pub struct DebugReceiptV1:
    receipt_id: text
    session_id: DebugSessionId
    build_id: text
    operation: DebugRootOperationV1
    action: text
    actor: text
    timestamp_ns: i64
    perturbation: DebugPerturbationV1
    allowed: bool
    execution_changed: bool
    outcome: text
    reason: text

pub fn debug_verification_name_v1(value: DebugVerificationV1) -> text:
    match value:
        case DebugVerificationV1.LiveVerified: "live_verified"
        case DebugVerificationV1.FixtureVerified: "fixture_verified"
        case DebugVerificationV1.Unverified: "unverified"
        case DebugVerificationV1.Blocked: "blocked"

pub fn debug_perturbation_name_v1(value: DebugPerturbationV1) -> text:
    match value:
        case DebugPerturbationV1.Passive: "passive"
        case DebugPerturbationV1.Cooperative: "cooperative"
        case DebugPerturbationV1.Stopping: "stopping"
        case DebugPerturbationV1.Mutating: "mutating"

pub fn debug_operation_name_v1(value: DebugRootOperationV1) -> text:
    match value:
        case DebugRootOperationV1.Observe: "observe"
        case DebugRootOperationV1.Inspect: "inspect"
        case DebugRootOperationV1.Control: "control"
        case DebugRootOperationV1.Probe: "probe"
        case DebugRootOperationV1.Profile: "profile"
        case DebugRootOperationV1.Evidence: "evidence"
        case DebugRootOperationV1.Domain: "domain"
