# Fail-closed execution boundary for DebugWireV1 requests.

use std.common.debug.contracts_v1.{
    DebugWireV1, DebugSessionId, DebugReceiptV1, DebugRootOperationV1,
    DebugPerturbationV1, debug_wire_negotiate_v1,
}
use std.common.debug.service_v1.{
    central_debug_service_v1_authorize, central_debug_service_v1_record,
}

pub struct DebugWireDispatchResultV1:
    request_id: text
    operation: DebugRootOperationV1
    domain: text
    command: text
    receipt: DebugReceiptV1

fn wire_operation_v1(name: text) -> Result<DebugRootOperationV1, text>:
    match name:
        case "observe": Ok(DebugRootOperationV1.Observe)
        case "inspect": Ok(DebugRootOperationV1.Inspect)
        case "control": Ok(DebugRootOperationV1.Control)
        case "probe": Ok(DebugRootOperationV1.Probe)
        case "profile": Ok(DebugRootOperationV1.Profile)
        case "evidence": Ok(DebugRootOperationV1.Evidence)
        case "domain": Ok(DebugRootOperationV1.Domain)
        case _: Err("unsupported debug wire operation")

fn wire_command_allowed_v1(operation: DebugRootOperationV1, domain: text, command: text) -> bool:
    match operation:
        case DebugRootOperationV1.Observe:
            domain == "service" and command == "doctor"
        case DebugRootOperationV1.Inspect:
            domain == "service" and (command == "session.get" or command == "graph.get")
        case DebugRootOperationV1.Control:
            domain == "evidence" and (command == "reproduce" or command == "replay")
        case DebugRootOperationV1.Probe:
            domain == "probe" and (command == "probe.apply" or command == "probe.remove" or command == "probe.list")
        case DebugRootOperationV1.Profile:
            domain == "service" and command == "profile.capture"
        case DebugRootOperationV1.Evidence:
            domain == "evidence" and (command == "inspect" or command == "evidence.export")
        case DebugRootOperationV1.Domain:
            (domain == "sql" and command == "explain") or
                (domain == "browser" and command == "targets") or
                (domain == "embedded" and command == "snapshot")

fn wire_perturbation_v1(operation: DebugRootOperationV1, command: text) -> DebugPerturbationV1:
    match operation:
        case DebugRootOperationV1.Control: DebugPerturbationV1.Stopping
        case DebugRootOperationV1.Probe:
            if command == "probe.list": DebugPerturbationV1.Passive else: DebugPerturbationV1.Cooperative
        case DebugRootOperationV1.Domain:
            if command == "snapshot": DebugPerturbationV1.Cooperative else: DebugPerturbationV1.Passive
        case _: DebugPerturbationV1.Passive

fn reject_wire_v1(wire: DebugWireV1, reason: text) -> Result<DebugWireDispatchResultV1, text>:
    central_debug_service_v1_record(
        DebugSessionId(value: wire.session_id),
        DebugRootOperationV1.Observe,
        DebugPerturbationV1.Passive,
        "wire.reject",
        false,
        false,
        reason,
    )
    Err(reason)

pub fn dispatch_debug_wire_v1(wire: DebugWireV1) -> Result<DebugWireDispatchResultV1, text>:
    val negotiation = debug_wire_negotiate_v1(wire.version)
    if not negotiation.accepted:
        return reject_wire_v1(wire, negotiation.reason)
    if wire.request_id.trim() == "":
        return reject_wire_v1(wire, "debug wire request requires a request id")
    if wire.session_id.trim() == "":
        return reject_wire_v1(wire, "debug wire request requires a session id")
    val operation = match wire_operation_v1(wire.operation):
        case Ok(value): value
        case Err(reason): return reject_wire_v1(wire, reason)
    if wire.domain.trim() == "" or wire.command.trim() == "":
        return reject_wire_v1(wire, "debug wire request requires a domain and command")
    if not wire_command_allowed_v1(operation, wire.domain, wire.command):
        return reject_wire_v1(wire, "unsupported debug wire domain/command")

    val perturbation = wire_perturbation_v1(operation, wire.command)
    val receipt = central_debug_service_v1_authorize(
        DebugSessionId(value: wire.session_id),
        operation,
        perturbation,
        "wire." + wire.domain + "." + wire.command,
    )
    if not receipt.allowed:
        return Err(receipt.reason)
    Ok(DebugWireDispatchResultV1(
        request_id: wire.request_id,
        operation: operation,
        domain: wire.domain,
        command: wire.command,
        receipt: receipt,
    ))
