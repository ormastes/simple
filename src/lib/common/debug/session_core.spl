# The session core trait -- the ONLY runtime capability edge in the whole
# debug/profile design (design §2).
#
# Everything else in this library is statically checked. A session is the
# one place where "does this target actually support debugging / profiling
# on THIS host?" can only be answered at run time, so that question is
# concentrated into exactly two accessors returning `Option`.
#
# **Accessors are part of the core trait.** Every implementation MUST
# answer `debug()` and `profile()`; forgetting one is a compile error. A
# `None` is therefore always a truthful runtime absence (no device, no
# driver, no debug build) and NEVER an unimplemented hole -- which is what
# makes `None` safe for a tool to report to a user as "not supported here".

use std.common.debug.debug_target.{DebugTarget}
use std.common.debug.profile_target.{ProfileTarget}

pub struct AttachOpts:
    """Attach-time knobs, shared by host and GPU targets.

    NOTE (drift from design §2): the design references `AttachOpts` in
    `DebugSessionCore.attach` without defining it. This is the minimal
    definition that the ref/host/GPU lanes all need; later streams that
    require another knob should ADD a field with a default rather than
    changing an existing one's meaning.

    `step_budget`  hard cap on executed instructions (SVM-G lanes) or
                   interpreter steps (host). Exhausting it is a `timeout`
                   stop, not an error.
    `entry_pc`     where execution begins, in the target's `pc_kind` units.
    `log_cap`      capacity of the target's log ring, where it has one.
    `profile`      arm profiling instrumentation at attach. Some backends
                   (GPU PROF-1 step counting) cannot be enabled after the
                   program is uploaded, so this must be decided at attach.
    """
    step_budget: i64
    entry_pc: i64
    log_cap: i64
    profile: bool

pub fn attach_opts_default() -> AttachOpts:
    """Conservative defaults: a budget generous enough for unit-scale
    programs, entry at 0, the SVM-G default log capacity, profiling ON
    (measurement is cheap here and a silently-unprofiled session is a
    worse failure mode than a slightly slower one)."""
    AttachOpts(step_budget: 100000, entry_pc: 0, log_cap: 256, profile: true)

pub fn attach_opts_with_budget(budget: i64) -> AttachOpts:
    AttachOpts(step_budget: budget, entry_pc: 0, log_cap: 256, profile: true)

# ============================================================================
# The trait
# ============================================================================
#
# Contract every implementation owes:
#
#  * `kind()`      matches the `kind()` of the targets it hands out.
#                  Answerable BEFORE attach.
#  * `attach()`    "" on success; "skip:<reason>" when the host genuinely
#                  lacks the hardware/driver (a clean skip, not a failure);
#                  any other non-empty string is an error. The three cases
#                  are distinguished by prefix so a spec can assert a
#                  skip-clean host without treating it as green-by-accident.
#  * `debug()`     Some(target) once attached and debugging is supported;
#                  None before attach, after shutdown, or when the target
#                  cannot debug.
#  * `profile()`   same lifecycle rules as `debug()`.
#  * `shutdown()`  "" on clean shutdown. After it, `debug()`/`profile()`
#                  return None. Idempotent: a second shutdown returns "".
trait DebugSessionCore:
    fn kind() -> text
    me attach(source: text, opts: AttachOpts) -> text
    me debug() -> Option<DebugTarget>
    me profile() -> Option<ProfileTarget>
    me shutdown() -> text

pub fn attach_is_ok(result: text) -> bool:
    result == ""

pub fn attach_is_skip(result: text) -> bool:
    result.starts_with("skip:")

pub fn attach_is_error(result: text) -> bool:
    result != "" and not result.starts_with("skip:")
