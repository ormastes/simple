# Reference (host, no-GPU) implementation of the whole unified debug +
# profile capability stack, over the SVM-G host reference VM
# (`std.common.svmg.ref_vm.SvmgVm`).
#
# WHY THIS IS THE ANCHOR: `ref` is the only target that runs everywhere
# with no device, no driver, and no skip path. Every other backend (host
# DAP adapter, CUDA, Vulkan, Metal) is verified by diffing its behaviour
# against this one through the same vector tables, so the semantics
# implemented here ARE the contract -- not an approximation of it.
#
# Relationship to `ref_vm.spl`: this module is a strict CONSUMER. It does
# not modify the VM. It drives `SvmgVm.step()` one instruction at a time
# instead of calling `SvmgVm.run()`, reproducing `run()`'s own loop guards
# (budget exhaustion, running off the end of the code section) so that a
# debugged run and a plain run reach identical end states. `ref` needs no
# DBG-1 arena block at all: the step counter lives host-side, which is why
# its profile tier is `Emulated` for steps while `wall_ns` is genuinely
# measured.
#
# STRUCTURE NOTE: every behaviour is implemented ONCE, in a private `me
# _xxx` method on the class. The three `impl` blocks (DebugTarget,
# ProfileTarget, DebugProfiler) are pure forwarders to those. Writing the
# bodies inside an `impl` block instead would force either triplication or
# same-name self-recursion.

use std.common.debug.capability.{CapLevel}
use std.common.debug.debug_target.{
    DebugTarget, DebugState, debug_state_new,
    PC_KIND_SVMG, STOP_BREAKPOINT, STOP_STEP, STOP_HALT, STOP_TRAP, STOP_TIMEOUT,
}
use std.common.debug.profile_target.{ProfileTarget, ProfileReport, PROFILE_ABSENT, profile_report_new}
use std.common.debug.session_core.{DebugSessionCore, AttachOpts}
use std.common.debug.debug_profiler.{DebugProfiler}
use std.common.svmg.assembler.{svmg_asm}
use std.common.svmg.ref_vm.{SvmgVm, build_arena}
use std.common.svmg.sgp.{decode_sgp_header}
use std.common.svmg.mailbox_const.{ARENA_DATA_SIZE, RAM_SENTINEL_OFFSET, SENTINEL_TIMEOUT}

extern fn rt_time_now_nanos() -> i64

pub val REF_KIND: text = "ref"

fn _write_u32_le_local(arena: [u8], idx: i64, v: i64) -> [u8]:
    """Local little-endian u32 writer. `ref_vm.spl` has an identical private
    helper; it is duplicated here rather than exported because this module
    must not modify `ref_vm.spl` (that file is owned by the DBG-1 stream)."""
    var out = arena
    out[idx] = (v & 0xFF) as u8
    out[idx + 1] = ((v >> 8) & 0xFF) as u8
    out[idx + 2] = ((v >> 16) & 0xFF) as u8
    out[idx + 3] = ((v >> 24) & 0xFF) as u8
    out

fn _sorted_insert(list: [i64], value: i64) -> [i64]:
    """Insert keeping ascending order. Breakpoint lists are tiny (a handful
    of locations), so an insertion pass is cheaper than sorting."""
    var out: [i64] = []
    var inserted = false
    var i = 0
    while i < list.len():
        if not inserted and value < list[i]:
            out.push(value)
            inserted = true
        out.push(list[i])
        i = i + 1
    if not inserted:
        out.push(value)
    out

fn _contains(list: [i64], value: i64) -> bool:
    var i = 0
    while i < list.len():
        if list[i] == value:
            return true
        i = i + 1
    false

fn _without(list: [i64], value: i64) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < list.len():
        if list[i] != value:
            out.push(list[i])
        i = i + 1
    out

# ============================================================================
# The target
# ============================================================================

class RefDebugTarget:
    """One attached SVM-G program, single-stepped under host control.

    Implements `DebugTarget`, `ProfileTarget`, AND the `DebugProfiler`
    group -- one value carrying both capabilities, which is what makes
    group acquisition meaningful under value semantics."""
    vm: SvmgVm
    breaks: [i64]
    stop_reason: text
    executed_steps: i64
    detached: bool
    profiling_enabled: bool
    profile_armed: bool
    profile_start_steps: i64
    profile_start_wall: i64

    static fn new(vm: SvmgVm, profiling_enabled: bool) -> RefDebugTarget:
        RefDebugTarget(
            vm: vm,
            breaks: [],
            # A freshly attached target has not executed anything and has
            # not stopped for a reason yet -- it is stopped at entry,
            # which the contract spells "step" (a resumable stop) rather
            # than inventing a fourth start-only reason.
            stop_reason: STOP_STEP,
            executed_steps: 0,
            detached: false,
            profiling_enabled: profiling_enabled,
            profile_armed: false,
            profile_start_steps: 0,
            profile_start_wall: 0,
        )

    me _terminal_reason() -> text:
        """Map the VM's terminal flags onto the contract's stop reasons.
        Order matters: a trap also sets `halted`, and a timeout also sets
        `halted`, so the SPECIFIC causes are tested first and plain
        `halt` is the residue."""
        if self.vm.trapped:
            STOP_TRAP
        elif self.vm.timed_out:
            STOP_TIMEOUT
        else:
            STOP_HALT

    me _advance_one() -> bool:
        """Execute exactly one instruction, reproducing `SvmgVm.run()`'s
        loop guards. Returns true when an instruction actually executed,
        false when the VM was already (or just became) terminal without
        executing one.

        A breakpoint on the CURRENT location is deliberately not consulted
        here: `step` must always make progress, and `resume` checks
        breakpoints AFTER advancing, so neither can wedge on the location
        it is standing on."""
        if self.vm.halted:
            return false
        if self.vm.steps_remaining <= 0:
            self.vm.arena = _write_u32_le_local(self.vm.arena, RAM_SENTINEL_OFFSET, SENTINEL_TIMEOUT)
            self.vm.timed_out = true
            self.vm.halted = true
            return false
        if self.vm.pc >= self.vm.code.len():
            # Falling off the end of the code section is a clean exit(0),
            # identical to `run()`.
            self.vm.exit_clean(0)
            return false
        self.vm.steps_remaining = self.vm.steps_remaining - 1
        self.vm.step()
        self.executed_steps = self.executed_steps + 1
        true

    me _snapshot(reason: text) -> DebugState:
        """Build a DebugState from live VM fields. `stack`/`call_stack` are
        truncated to the LIVE portion (0..sp / 0..csp); handing back the
        fixed 256/32-slot backing arrays would report stale slots above the
        stack pointer as if they were live values."""
        var live_stack: [i64] = []
        var i = 0
        while i < self.vm.sp:
            live_stack.push(self.vm.stack[i])
            i = i + 1
        var live_calls: [i64] = []
        i = 0
        while i < self.vm.csp:
            live_calls.push(self.vm.callstack[i])
            i = i + 1
        debug_state_new(self.vm.pc, PC_KIND_SVMG, self.vm.sp, live_stack, live_calls, reason)

    # ---- the single implementation of every contract behaviour ----

    me _set_breakpoint(loc: i64) -> bool:
        if self.detached:
            return false
        if _contains(self.breaks, loc):
            return false
        self.breaks = _sorted_insert(self.breaks, loc)
        true

    me _clear_breakpoint(loc: i64) -> bool:
        if not _contains(self.breaks, loc):
            return false
        self.breaks = _without(self.breaks, loc)
        true

    me _step() -> DebugState:
        if self.detached:
            return self._snapshot(STOP_HALT)
        val moved = self._advance_one()
        if not moved or self.vm.halted:
            self.stop_reason = self._terminal_reason()
        elif _contains(self.breaks, self.vm.pc):
            # Landing ON a breakpoint by single-stepping still reports the
            # breakpoint -- a UI must not lose the fact that the next
            # resume would have stopped here anyway.
            self.stop_reason = STOP_BREAKPOINT
        else:
            self.stop_reason = STOP_STEP
        self._snapshot(self.stop_reason)

    me _resume() -> DebugState:
        if self.detached:
            return self._snapshot(STOP_HALT)
        var guard = true
        while guard:
            val moved = self._advance_one()
            if not moved or self.vm.halted:
                self.stop_reason = self._terminal_reason()
                guard = false
            elif _contains(self.breaks, self.vm.pc):
                self.stop_reason = STOP_BREAKPOINT
                guard = false
        self._snapshot(self.stop_reason)

    me _read_mem(offset: i64, len: i64) -> [u8]:
        # GPU targets read the DATA region; `ref` reads the same region of
        # the same GMB-1 arena, which is what makes the vectors portable.
        # Any out-of-range or non-positive request returns EMPTY -- never a
        # short buffer (which would read as a successful partial read) and
        # never a panic.
        if len <= 0:
            return []
        if offset < 0:
            return []
        if offset + len > ARENA_DATA_SIZE:
            return []
        var out: [u8] = []
        var i = 0
        while i < len:
            out.push(self.vm.arena[offset + i])
            i = i + 1
        out

    me _profile_level() -> CapLevel:
        # `steps` is EXACT here (host-side counting of real executed
        # instructions), but it is synthesized by the harness rather than
        # measured by a device timer, so the tier is Emulated. `wall_ns` is
        # a genuine host-clock measurement and says so in `detail`.
        if self.profiling_enabled:
            CapLevel.Emulated
        else:
            CapLevel.Unavailable

    me _profile_begin():
        # Last-begin-wins: re-arming without an intervening `end` restarts
        # the window rather than erroring, so a UI can re-arm freely.
        self.profile_armed = true
        self.profile_start_steps = self.executed_steps
        self.profile_start_wall = rt_time_now_nanos()

    me _profile_end() -> ProfileReport:
        if not self.profiling_enabled:
            return profile_report_new(
                CapLevel.Unavailable, PROFILE_ABSENT, PROFILE_ABSENT, PROFILE_ABSENT,
                "reason=profiling-disabled-at-attach",
            )
        if not self.profile_armed:
            # No matching `begin`: report absence honestly instead of
            # fabricating a zero-length window.
            return profile_report_new(
                CapLevel.Unavailable, PROFILE_ABSENT, PROFILE_ABSENT, PROFILE_ABSENT,
                "reason=profile_end-without-profile_begin",
            )
        val wall = rt_time_now_nanos() - self.profile_start_wall
        val steps = self.executed_steps - self.profile_start_steps
        self.profile_armed = false
        profile_report_new(
            CapLevel.Emulated,
            wall,
            # No device exists on the `ref` lane: device_ns is absent, not
            # zero. Backends that DO have a device timer fill this in.
            PROFILE_ABSENT,
            steps,
            "target=ref,steps=exact,wall=host-clock,device=none",
        )

impl DebugTarget for RefDebugTarget:
    fn kind() -> text:
        REF_KIND

    fn debug_level() -> CapLevel:
        # The host reference VM has genuine, exact instruction-level
        # control: it single-steps the real interpreter, not a model of
        # it. That is a Native debug capability even though it runs no
        # device -- `Emulated` would be a claim about debugging being
        # synthesized, which here it is not.
        CapLevel.Native

    me set_breakpoint(loc: i64) -> bool:
        self._set_breakpoint(loc)

    me clear_breakpoint(loc: i64) -> bool:
        self._clear_breakpoint(loc)

    me breakpoints() -> [i64]:
        self.breaks

    me step() -> DebugState:
        self._step()

    me resume() -> DebugState:
        self._resume()

    me state() -> DebugState:
        # Pure read: no VM field is touched, so repeated calls are equal.
        self._snapshot(self.stop_reason)

    me read_mem(offset: i64, len: i64) -> [u8]:
        self._read_mem(offset, len)

    me detach() -> text:
        # Idempotent by contract: the second call is a no-op returning "".
        self.detached = true
        ""

impl ProfileTarget for RefDebugTarget:
    fn profile_level() -> CapLevel:
        self._profile_level()

    me profile_begin():
        self._profile_begin()

    me profile_end() -> ProfileReport:
        self._profile_end()

impl DebugProfiler for RefDebugTarget:
    # The group impl -- exactly the union, every method forwarding to the
    # same single implementation the two member impls use.
    fn kind() -> text:
        REF_KIND

    fn debug_level() -> CapLevel:
        CapLevel.Native

    me set_breakpoint(loc: i64) -> bool:
        self._set_breakpoint(loc)

    me clear_breakpoint(loc: i64) -> bool:
        self._clear_breakpoint(loc)

    me breakpoints() -> [i64]:
        self.breaks

    me step() -> DebugState:
        self._step()

    me resume() -> DebugState:
        self._resume()

    me state() -> DebugState:
        self._snapshot(self.stop_reason)

    me read_mem(offset: i64, len: i64) -> [u8]:
        self._read_mem(offset, len)

    me detach() -> text:
        self.detached = true
        ""

    fn profile_level() -> CapLevel:
        self._profile_level()

    me profile_begin():
        self._profile_begin()

    me profile_end() -> ProfileReport:
        self._profile_end()

# ============================================================================
# The session
# ============================================================================

class RefDebugSession:
    """`DebugSessionCore` over the host SVM-G reference VM.

    `attach(source, opts)` takes SVM-G ASSEMBLY TEXT (the `svmg_asm`
    dialect) as `source` -- this lane has no file loading and no device
    upload, so the program text IS the source."""
    target: Option<RefDebugTarget>
    attached: bool

    static fn new() -> RefDebugSession:
        RefDebugSession(target: nil, attached: false)

impl DebugSessionCore for RefDebugSession:
    fn kind() -> text:
        REF_KIND

    me attach(source: text, opts: AttachOpts) -> text:
        if source.trim() == "":
            # An empty program is a caller ERROR, not a host-capability
            # skip: `ref` always exists, so it must never answer "skip:".
            return "error: empty SVM-G source"
        val code = svmg_asm(source)
        if code.len() == 0:
            return "error: SVM-G source assembled to zero bytes"
        val arena = build_arena(code, [], opts.step_budget, opts.entry_pc, opts.log_cap)
        val header = decode_sgp_header(arena)
        val vm = SvmgVm.new(header, code, arena)
        self.target = Some(RefDebugTarget.new(vm, opts.profile))
        self.attached = true
        ""

    me debug() -> Option<DebugTarget>:
        # None before attach and after shutdown -- a truthful runtime
        # absence, never an unimplemented hole.
        if not self.attached:
            return nil
        self.target

    me profile() -> Option<ProfileTarget>:
        if not self.attached:
            return nil
        self.target

    me shutdown() -> text:
        self.attached = false
        self.target = nil
        ""

pub fn ref_debug_profiler(session: RefDebugSession) -> Option<DebugProfiler>:
    """Group acquisition for the `ref` lane -- the hand-written twin of the
    generated `DebugProfiler.from(session)` (design §3).

    All-or-nothing: `Some` only when the session is attached AND both
    capabilities are usable. Because the group is one trait over one value
    (see debug_profiler.spl's language-constraint note), acquisition hands
    back the SINGLE target that carries both, not a pair."""
    var s = session
    if s.debug() == nil:
        return nil
    if s.profile() == nil:
        return nil
    s.target
