# The ONE profile interface shared by host (CPU) and every GPU lane
# (design §2 / §7). Tiered honesty is the whole point: a `ProfileReport`
# never reports a number it did not measure.
#
#   wall_ns    ALWAYS measured (host clock around the run). Present at
#              every tier, which makes it the cross-check for `device_ns`.
#   device_ns  Native tier ONLY (cuEvent / VkQuery / MTL GPU time). At any
#              other tier it is exactly -1 -- never 0, because 0 is a
#              legitimate (if implausible) measurement and would silently
#              read as "instantaneous" instead of "not measured".
#   steps      Emulated/VM instruction count, or the host interpreter's
#              step count. -1 when nothing counts steps.
#   detail     SDN-encoded backend extras, "" when there are none. This is
#              where a backend records WHICH pieces it measured when the
#              single `level` cannot say it (e.g. native wall clock but
#              emulated step counting).

use std.common.debug.capability.{CapLevel, cap_level_name}

pub val PROFILE_ABSENT: i64 = -1

pub struct ProfileReport:
    level: CapLevel
    wall_ns: i64
    device_ns: i64
    steps: i64
    detail: text

pub fn profile_report_new(level: CapLevel, wall_ns: i64, device_ns: i64, steps: i64, detail: text) -> ProfileReport:
    ProfileReport(
        level: level,
        wall_ns: wall_ns,
        device_ns: device_ns,
        steps: steps,
        detail: detail,
    )

pub fn profile_report_unavailable(detail: text) -> ProfileReport:
    """The canonical "this target cannot profile" report: every quantity
    absent, so no consumer can accidentally chart a zero."""
    ProfileReport(
        level: CapLevel.Unavailable,
        wall_ns: PROFILE_ABSENT,
        device_ns: PROFILE_ABSENT,
        steps: PROFILE_ABSENT,
        detail: detail,
    )

pub fn profile_has_device_time(report: ProfileReport) -> bool:
    """True only when a real device timer produced `device_ns`."""
    report.device_ns >= 0

pub fn profile_has_steps(report: ProfileReport) -> bool:
    report.steps >= 0

pub fn profile_report_summary(report: ProfileReport) -> text:
    """One-line human/`debug-doctor` rendering. Absent quantities print as
    `-` rather than as a number, so a glance cannot mistake them."""
    val wall = if report.wall_ns >= 0: "{report.wall_ns}ns" else: "-"
    val device = if report.device_ns >= 0: "{report.device_ns}ns" else: "-"
    val steps = if report.steps >= 0: "{report.steps}" else: "-"
    "{cap_level_name(report.level)} wall={wall} device={device} steps={steps}"

# ============================================================================
# The trait
# ============================================================================
#
# Contract every implementation owes:
#
#  * `profile_level()`  the tier of the PRIMARY device measurement. It is
#                       answerable before any run and must not change
#                       across a begin/end pair.
#  * `profile_begin()`  arms measurement and resets the counters. Calling
#                       it twice without an `end` restarts measurement from
#                       the second call (last-begin-wins) rather than
#                       erroring -- a debugger UI can re-arm freely.
#  * `profile_end()`    returns the report for the window since the last
#                       `begin`. Calling `end` with no matching `begin`
#                       returns an Unavailable report explaining so, never
#                       a fabricated zero.
trait ProfileTarget:
    fn profile_level() -> CapLevel
    me profile_begin()
    me profile_end() -> ProfileReport
