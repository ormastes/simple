# Central debug service v1 -- minimal reference implementation.
#
# Every debug-capable transport (MCP DAP bridge, mcpgdb, OpenOCD/JTAG) opens
# a session here, registers the targets/capabilities it can honestly claim,
# and gets a policy-gated authorize/record receipt trail before and after
# each live operation. This module owns only the session/authorization
# bookkeeping -- it never talks to a real target itself (see the three call
# sites named in `contracts_v1.spl`).
#
# In-process, module-level registry (mirrors the `DAP_SESSIONS` pattern
# already used by `src/app/mcp/dap_bridge.spl`) -- no nogc imports, so this
# stays usable from `common/`.

use .contracts_v1.{
    DebugSessionId, DebugPolicyV1, DebugReceiptV1, DebugCapabilityV1,
    DebugVerificationV1, DebugPerturbationV1, DebugRootOperationV1,
    DebugTargetNodeV1,
}

class _DebugSessionRecordV1:
    id: text
    build_id: text
    policy: DebugPolicyV1
    targets: [DebugTargetNodeV1]
    capabilities: [DebugCapabilityV1]
    closed: bool

var _DEBUG_SESSIONS_V1: [_DebugSessionRecordV1] = []
var _DEBUG_NEXT_ID_V1: i64 = 1
var _DEBUG_NEXT_RECEIPT_V1: i64 = 1

fn _next_receipt_id(session_id: DebugSessionId) -> text:
    """Session-bound receipt identifier. The session value is embedded so a
    receipt read back out of a bundle can be tied to the session that issued
    it without a side table."""
    val n = _DEBUG_NEXT_RECEIPT_V1
    _DEBUG_NEXT_RECEIPT_V1 = _DEBUG_NEXT_RECEIPT_V1 + 1
    "receipt-" + session_id.value + "-" + str(n)

pub fn central_debug_service_v1_session_count() -> i64:
    """Number of sessions that are currently OPEN. A closed session is retained
    for its receipt trail but is not counted, so open+close is observably
    balanced."""
    var n = 0
    for s in _DEBUG_SESSIONS_V1:
        if not s.closed: n = n + 1
    n

pub fn debug_policy_development_v1() -> DebugPolicyV1:
    """Permissive development-mode policy: Control and Domain operations are
    both allowed. Everything is still receipted -- nothing is silently
    skipped -- it just never denies. Stricter (e.g. observe-only) policies
    are a caller-constructed `DebugPolicyV1` value, not a separate type."""
    DebugPolicyV1(name: "development", allow_control: true, allow_domain: true)

pub fn debug_policy_observe_only_v1() -> DebugPolicyV1:
    """Denies Control and Domain operations; Inspect/Observe/Evidence still
    pass. Used by callers that only ever inspect a target."""
    DebugPolicyV1(name: "observe-only", allow_control: false, allow_domain: false)

fn _find_session(session_id: DebugSessionId) -> Option<_DebugSessionRecordV1>:
    for s in _DEBUG_SESSIONS_V1:
        if s.id == session_id.value and not s.closed:
            return Some(s)
    None

pub fn central_debug_service_v1_open(build_id: text, policy: DebugPolicyV1) -> Result<DebugSessionId, text>:
    if build_id.trim() == "":
        return Err("central debug service v1: build_id is required")
    val id = "dbgsvc-" + str(_DEBUG_NEXT_ID_V1)
    _DEBUG_NEXT_ID_V1 = _DEBUG_NEXT_ID_V1 + 1
    _DEBUG_SESSIONS_V1.push(_DebugSessionRecordV1(
        id: id, build_id: build_id, policy: policy, targets: [], capabilities: [], closed: false,
    ))
    Ok(DebugSessionId(value: id))

pub fn central_debug_service_v1_add_target(session_id: DebugSessionId, target: DebugTargetNodeV1, capability: DebugCapabilityV1) -> Result<(), text>:
    var found = false
    var new_sessions: [_DebugSessionRecordV1] = []
    for s in _DEBUG_SESSIONS_V1:
        if s.id == session_id.value and not s.closed:
            found = true
            var updated = s
            updated.targets.push(target)
            updated.capabilities.push(capability)
            new_sessions.push(updated)
        else:
            new_sessions.push(s)
    _DEBUG_SESSIONS_V1 = new_sessions
    if not found:
        return Err("central debug service v1: unknown or closed session " + session_id.value)
    Ok(nil)

pub fn central_debug_service_v1_authorize(session_id: DebugSessionId, operation: DebugRootOperationV1, perturbation: DebugPerturbationV1, action: text) -> DebugReceiptV1:
    match _find_session(session_id):
        case None:
            return DebugReceiptV1(
                receipt_id: _next_receipt_id(session_id),
                session_id: session_id.value, operation: operation, perturbation: perturbation,
                action: action, allowed: false, succeeded: false, execution_changed: false,
                reason: "central debug service v1: unknown or closed session",
            )
        case Some(s):
            var allowed = true
            var reason = ""
            if operation == DebugRootOperationV1.Control and not s.policy.allow_control:
                allowed = false
                reason = "policy '" + s.policy.name + "' denies Control operations"
            elif operation == DebugRootOperationV1.Domain and not s.policy.allow_domain:
                allowed = false
                reason = "policy '" + s.policy.name + "' denies Domain operations"
            DebugReceiptV1(
                receipt_id: _next_receipt_id(session_id),
                session_id: session_id.value, operation: operation, perturbation: perturbation,
                action: action, allowed: allowed, succeeded: false, execution_changed: false,
                reason: reason,
            )

pub fn central_debug_service_v1_record(session_id: DebugSessionId, operation: DebugRootOperationV1, perturbation: DebugPerturbationV1, action: text, succeeded: bool, execution_changed: bool, reason: text) -> DebugReceiptV1:
    DebugReceiptV1(
        receipt_id: _next_receipt_id(session_id),
        session_id: session_id.value, operation: operation, perturbation: perturbation,
        action: action, allowed: true, succeeded: succeeded, execution_changed: execution_changed,
        reason: reason,
    )

pub fn central_debug_service_v1_record_outcome(session_id: DebugSessionId, operation: DebugRootOperationV1, perturbation: DebugPerturbationV1, action: text, succeeded: bool, execution_changed: bool, reason: text) -> DebugReceiptV1:
    """Records the OUTCOME half of an authorize/record pair. Same shape as
    `central_debug_service_v1_record`; the separate name exists because the
    call sites record an outcome after an already-authorized operation."""
    central_debug_service_v1_record(session_id, operation, perturbation, action, succeeded, execution_changed, reason)

pub fn central_debug_service_v1_close(session_id: DebugSessionId) -> Result<(), text>:
    var found = false
    var new_sessions: [_DebugSessionRecordV1] = []
    for s in _DEBUG_SESSIONS_V1:
        if s.id == session_id.value:
            found = true
            var updated = s
            updated.closed = true
            new_sessions.push(updated)
        else:
            new_sessions.push(s)
    _DEBUG_SESSIONS_V1 = new_sessions
    if not found:
        return Err("central debug service v1: unknown session " + session_id.value)
    Ok(nil)
