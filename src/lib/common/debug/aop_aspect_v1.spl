# Safe, policy-checkable AOP instrumentation for debug investigations.

pub struct DebugAopFieldV1:
    name: text
    type_name: text

pub struct DebugAopScopeV1:
    scope_id: text
    owner_capsule: text
    joinpoint: text

pub struct DebugAopAspectV1:
    aspect_id: text
    stable_callsite_id: text
    fields: [DebugAopFieldV1]
    scope: DebugAopScopeV1
    read_only: bool = true
    contains_business_logic: bool = false
    mutates_program: bool = false
    sample_per_million: i64 = 1000000
    rate_limit_per_minute: i64 = 60
    ttl_ms: i64 = 3600000
    receipt_required: bool = true

pub fn debug_aop_aspect_v1(
    aspect_id: text,
    stable_callsite_id: text,
    fields: [DebugAopFieldV1],
    scope: DebugAopScopeV1,
) -> DebugAopAspectV1:
    DebugAopAspectV1(
        aspect_id: aspect_id,
        stable_callsite_id: stable_callsite_id,
        fields: fields,
        scope: scope,
    )

fn validate_debug_aop_fields_v1(fields: [DebugAopFieldV1]) -> Result<bool, text>:
    if fields.len() == 0:
        return Err("debug AOP aspect requires typed fields")
    for field in fields:
        if field.name == "" or field.type_name == "":
            return Err("debug AOP fields require name and type")
    Ok(true)

pub fn validate_debug_aop_aspect_v1(aspect: DebugAopAspectV1, mission_critical: bool) -> Result<bool, text>:
    if aspect.aspect_id == "":
        return Err("debug AOP aspect requires an id")
    if aspect.stable_callsite_id == "":
        return Err("debug AOP aspect requires a stable callsite id")
    validate_debug_aop_fields_v1(aspect.fields)?
    if aspect.scope.scope_id == "" or aspect.scope.owner_capsule == "" or aspect.scope.joinpoint == "":
        return Err("debug AOP aspect requires an explicit MDSOC scope")
    if aspect.scope.scope_id == "*" or aspect.scope.owner_capsule == "*" or aspect.scope.joinpoint == "*":
        return Err("debug AOP aspect forbids wildcard MDSOC scope")
    if aspect.contains_business_logic:
        return Err("debug AOP aspect must not contain business logic")
    if mission_critical and (aspect.mutates_program or not aspect.read_only):
        return Err("mission-critical debug AOP aspect must be read-only")
    if aspect.mutates_program or not aspect.read_only:
        return Err("debug AOP aspect must be read-only")
    if aspect.sample_per_million <= 0 or aspect.sample_per_million > 1000000:
        return Err("debug AOP sampling must be between 1 and 1000000 per million")
    if aspect.rate_limit_per_minute <= 0:
        return Err("debug AOP aspect requires a positive rate limit")
    if aspect.ttl_ms <= 0:
        return Err("debug AOP aspect requires a positive TTL")
    if not aspect.receipt_required:
        return Err("debug AOP aspect requires receipts")
    Ok(true)
