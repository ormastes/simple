# codex-impl
# Strict bounded SDN codec for compiler-injected RT/HAL cold-start plans.

use std.common.env_access.model.*
use std.common.sdn.value.{SdnValue}
use std.common.sdn.parser.{parse_untrusted, parse_with_issues}
use std.common.sdn.encode.{sdn_encode_canonical}

pub const ENV_ACCESS_PLAN_SCHEMA_V1 = "simple-env-access-plan-v1"
pub const ENV_ACCESS_PLAN_SDN_MAX_BYTES = 65536

pub struct EnvAccessPlanInstallV1:
    plan: EnvAccessPlan
    compare_c: bool
    compare_rust: bool
    c_tool_id: text
    rust_tool_id: text
    worker_count: i64
    queue_capacity: i64
    timeout_ticks: i64
    max_output_bytes: i64

fn install_error(value: EnvAccessPlanInstallV1) -> text:
    if (value.worker_count <= 0 or value.worker_count > 64 or
        value.queue_capacity <= 0 or value.queue_capacity > 16 or
        value.timeout_ticks <= 0 or value.timeout_ticks > 600000 or
        value.max_output_bytes <= 0 or value.max_output_bytes > 16777216): return "RTHAL-E-BOUND"
    if (not value.compare_c and value.c_tool_id != "") or
        (not value.compare_rust and value.rust_tool_id != ""): return "ENV-E-PLAN-SCHEMA: disabled comparator must not name a tool"
    if value.compare_c and value.c_tool_id == "": return "ENV-E-TOOL-NOT-ALLOWED"
    if value.compare_rust and value.rust_tool_id == "": return "ENV-E-TOOL-NOT-ALLOWED"
    if value.compare_c and value.compare_rust and value.c_tool_id == value.rust_tool_id:
        return "ENV-E-PLAN-SCHEMA: comparator tool identities must be distinct"
    var c_admitted = false
    var rust_admitted = false
    for tool in value.plan.allowed_tools:
        if tool.tool_id == value.c_tool_id: c_admitted = true
        if tool.tool_id == value.rust_tool_id: rust_admitted = true
    if value.compare_c and not c_admitted: return "ENV-E-TOOL-NOT-ALLOWED"
    if value.compare_rust and not rust_admitted: return "ENV-E-TOOL-NOT-ALLOWED"
    return ""

fn fields_exact(value: SdnValue, keys: [text], context: text) -> Result<Dict<text, SdnValue>, text>:
    match value:
        case SdnValue.Dict(fields):
            for key in fields.keys():
                if not keys.contains(key): return Err("ENV-E-PLAN-SCHEMA: unknown " + context + " field '" + key + "'")
            for key in keys:
                if not fields.contains_key(key): return Err("ENV-E-PLAN-SCHEMA: missing " + context + " field '" + key + "'")
            return Ok(fields)
        case _:
            return Err("ENV-E-PLAN-SCHEMA: " + context + " must be a dictionary")

fn field_text(fields: Dict<text, SdnValue>, key: text, context: text, empty: bool = false) -> Result<text, text>:
    match fields[key]:
        case SdnValue.String(value):
            if not empty and value == "": return Err("ENV-E-PLAN-SCHEMA: " + context + "." + key + " is empty")
            return Ok(value)
        case _: return Err("ENV-E-PLAN-SCHEMA: " + context + "." + key + " must be text")

fn field_int(fields: Dict<text, SdnValue>, key: text, context: text) -> Result<i64, text>:
    match fields[key]:
        case SdnValue.Int(value): return Ok(value)
        case _: return Err("ENV-E-PLAN-SCHEMA: " + context + "." + key + " must be integer")

fn field_bool(fields: Dict<text, SdnValue>, key: text, context: text) -> Result<bool, text>:
    match fields[key]:
        case SdnValue.Bool(value): return Ok(value)
        case _: return Err("ENV-E-PLAN-SCHEMA: " + context + "." + key + " must be boolean")

fn field_array(fields: Dict<text, SdnValue>, key: text, context: text) -> Result<[SdnValue], text>:
    match fields[key]:
        case SdnValue.Array(values): return Ok(values)
        case _: return Err("ENV-E-PLAN-SCHEMA: " + context + "." + key + " must be array")

fn text_array(value: SdnValue, context: text) -> Result<[text], text>:
    match value:
        case SdnValue.Array(values):
            if values.len() > 64: return Err("ENV-E-BOUND")
            var result: [text] = []
            for value_item in values:
                match value_item:
                    case SdnValue.String(item): result.push(item)
                    case _: return Err("ENV-E-PLAN-SCHEMA: " + context + " must contain text")
            return Ok(result)
        case _: return Err("ENV-E-PLAN-SCHEMA: " + context + " must be array")

fn parse_kind(value: text) -> Result<EnvAccessKind, text>:
    match value:
        case "read-env": return Ok(EnvAccessKind.ReadEnv)
        case "host-identity": return Ok(EnvAccessKind.HostIdentity)
        case "read-repo-file": return Ok(EnvAccessKind.ReadRepoFile)
        case "run-allowed-tool": return Ok(EnvAccessKind.RunAllowedTool)
        case "hardware-probe": return Ok(EnvAccessKind.HardwareProbe)
        case _: return Err("ENV-E-PLAN-SCHEMA: unknown instruction kind")

fn parse_instruction(value: SdnValue) -> Result<EnvAccessInstruction, text>:
    val fields = fields_exact(value, ["kind", "resource", "arguments", "timeout_ms", "max_stdout_bytes", "max_stderr_bytes"], "instruction")?
    val arguments = text_array(fields["arguments"], "instruction.arguments")?
    return Ok(EnvAccessInstruction(
        kind: parse_kind(field_text(fields, "kind", "instruction")?)?,
        resource: field_text(fields, "resource", "instruction", true)?,
        arguments: arguments,
        timeout_ms: field_int(fields, "timeout_ms", "instruction")?,
        max_stdout_bytes: field_int(fields, "max_stdout_bytes", "instruction")?,
        max_stderr_bytes: field_int(fields, "max_stderr_bytes", "instruction")?
    ))

fn parse_tool(value: SdnValue) -> Result<EnvToolIdentity, text>:
    val fields = fields_exact(value, ["tool_id", "canonical_path", "identity_hash"], "tool")?
    return Ok(EnvToolIdentity(
        tool_id: field_text(fields, "tool_id", "tool")?,
        canonical_path: field_text(fields, "canonical_path", "tool")?,
        identity_hash: field_text(fields, "identity_hash", "tool")?
    ))

fn parse_probe(value: SdnValue) -> Result<EnvHardwareProbeIdentity, text>:
    val fields = fields_exact(value, ["probe_id", "schema_id", "max_arguments", "max_timeout_ms", "max_stdout_bytes", "max_stderr_bytes"], "hardware_probe")?
    return Ok(EnvHardwareProbeIdentity(
        probe_id: field_text(fields, "probe_id", "hardware_probe")?,
        schema_id: field_text(fields, "schema_id", "hardware_probe")?,
        max_arguments: field_int(fields, "max_arguments", "hardware_probe")?,
        max_timeout_ms: field_int(fields, "max_timeout_ms", "hardware_probe")?,
        max_stdout_bytes: field_int(fields, "max_stdout_bytes", "hardware_probe")?,
        max_stderr_bytes: field_int(fields, "max_stderr_bytes", "hardware_probe")?
    ))

pub fn env_access_plan_parse_sdn_v1(source: text) -> Result<EnvAccessPlanInstallV1, text>:
    if source.len() == 0 or source.len() > ENV_ACCESS_PLAN_SDN_MAX_BYTES: return Err("ENV-E-PLAN-SIZE")
    match parse_untrusted(source):
        case Err(problem): return Err("ENV-E-PLAN-PARSE: " + problem)
        case Ok(_): ()
    match parse_with_issues(source):
        case Err(problem): return Err("ENV-E-PLAN-PARSE: " + problem)
        case Ok((root, issues)):
            if issues.len() != 0: return Err("ENV-E-PLAN-SCHEMA: duplicate fields are forbidden")
            val fields = fields_exact(root, ["schema", "version", "plan_id", "canonical_repo_root", "max_total_bytes", "max_processes", "instructions", "tools", "hardware_probes", "install"], "plan")?
            if field_text(fields, "schema", "plan")? != ENV_ACCESS_PLAN_SCHEMA_V1: return Err("ENV-E-PLAN-SCHEMA: unsupported schema")
            if field_int(fields, "version", "plan")? != 1: return Err("ENV-E-PLAN-VERSION")
            val instruction_values = field_array(fields, "instructions", "plan")?
            val tool_values = field_array(fields, "tools", "plan")?
            val probe_values = field_array(fields, "hardware_probes", "plan")?
            if instruction_values.len() > 1024 or tool_values.len() > 64 or probe_values.len() > 64: return Err("ENV-E-BOUND")
            var instructions: [EnvAccessInstruction] = []
            var tools: [EnvToolIdentity] = []
            var probes: [EnvHardwareProbeIdentity] = []
            for item in instruction_values: instructions.push(parse_instruction(item)?)
            for item in tool_values: tools.push(parse_tool(item)?)
            for item in probe_values: probes.push(parse_probe(item)?)
            val plan = EnvAccessPlan(
                plan_id: field_text(fields, "plan_id", "plan")?,
                canonical_repo_root: field_text(fields, "canonical_repo_root", "plan")?,
                instructions: instructions,
                max_total_bytes: field_int(fields, "max_total_bytes", "plan")?,
                max_processes: field_int(fields, "max_processes", "plan")?,
                allowed_tools: tools,
                allowed_hardware_probes: probes
            )
            val problem = env_access_plan_error(plan)
            if problem != "": return Err(problem)
            val install = fields_exact(fields["install"], ["compare_c", "compare_rust", "c_tool_id", "rust_tool_id", "worker_count", "queue_capacity", "timeout_ticks", "max_output_bytes"], "install")?
            val result = EnvAccessPlanInstallV1(
                plan: plan,
                compare_c: field_bool(install, "compare_c", "install")?,
                compare_rust: field_bool(install, "compare_rust", "install")?,
                c_tool_id: field_text(install, "c_tool_id", "install", true)?,
                rust_tool_id: field_text(install, "rust_tool_id", "install", true)?,
                worker_count: field_int(install, "worker_count", "install")?,
                queue_capacity: field_int(install, "queue_capacity", "install")?,
                timeout_ticks: field_int(install, "timeout_ticks", "install")?,
                max_output_bytes: field_int(install, "max_output_bytes", "install")?
            )
            val install_problem = install_error(result)
            if install_problem != "": return Err(install_problem)
            return Ok(result)

fn kind_text(kind: EnvAccessKind) -> text:
    match kind:
        case EnvAccessKind.ReadEnv: return "read-env"
        case EnvAccessKind.HostIdentity: return "host-identity"
        case EnvAccessKind.ReadRepoFile: return "read-repo-file"
        case EnvAccessKind.RunAllowedTool: return "run-allowed-tool"
        case EnvAccessKind.HardwareProbe: return "hardware-probe"

fn string_values(values: [text]) -> SdnValue:
    var result: [SdnValue] = []
    for value in values: result.push(SdnValue.String(value))
    return SdnValue.Array(result)

fn instruction_value(instruction: EnvAccessInstruction) -> SdnValue:
    var fields: Dict<text, SdnValue> = {}
    fields["kind"] = SdnValue.String(kind_text(instruction.kind))
    fields["resource"] = SdnValue.String(instruction.resource)
    fields["arguments"] = string_values(instruction.arguments)
    fields["timeout_ms"] = SdnValue.Int(instruction.timeout_ms)
    fields["max_stdout_bytes"] = SdnValue.Int(instruction.max_stdout_bytes)
    fields["max_stderr_bytes"] = SdnValue.Int(instruction.max_stderr_bytes)
    return SdnValue.Dict(fields)

fn tool_value(tool: EnvToolIdentity) -> SdnValue:
    var fields: Dict<text, SdnValue> = {}
    fields["tool_id"] = SdnValue.String(tool.tool_id)
    fields["canonical_path"] = SdnValue.String(tool.canonical_path)
    fields["identity_hash"] = SdnValue.String(tool.identity_hash)
    return SdnValue.Dict(fields)

fn probe_value(probe: EnvHardwareProbeIdentity) -> SdnValue:
    var fields: Dict<text, SdnValue> = {}
    fields["probe_id"] = SdnValue.String(probe.probe_id)
    fields["schema_id"] = SdnValue.String(probe.schema_id)
    fields["max_arguments"] = SdnValue.Int(probe.max_arguments)
    fields["max_timeout_ms"] = SdnValue.Int(probe.max_timeout_ms)
    fields["max_stdout_bytes"] = SdnValue.Int(probe.max_stdout_bytes)
    fields["max_stderr_bytes"] = SdnValue.Int(probe.max_stderr_bytes)
    return SdnValue.Dict(fields)

pub fn env_access_plan_encode_sdn_v1(value: EnvAccessPlanInstallV1) -> Result<text, text>:
    val problem = env_access_plan_error(value.plan)
    if problem != "": return Err(problem)
    val install_problem = install_error(value)
    if install_problem != "": return Err(install_problem)
    var instruction_values: [SdnValue] = []
    var tool_values: [SdnValue] = []
    var probe_values: [SdnValue] = []
    for instruction in value.plan.instructions: instruction_values.push(instruction_value(instruction))
    for tool in value.plan.allowed_tools: tool_values.push(tool_value(tool))
    for probe in value.plan.allowed_hardware_probes: probe_values.push(probe_value(probe))
    var install: Dict<text, SdnValue> = {}
    install["compare_c"] = SdnValue.Bool(value.compare_c)
    install["compare_rust"] = SdnValue.Bool(value.compare_rust)
    install["c_tool_id"] = SdnValue.String(value.c_tool_id)
    install["rust_tool_id"] = SdnValue.String(value.rust_tool_id)
    install["worker_count"] = SdnValue.Int(value.worker_count)
    install["queue_capacity"] = SdnValue.Int(value.queue_capacity)
    install["timeout_ticks"] = SdnValue.Int(value.timeout_ticks)
    install["max_output_bytes"] = SdnValue.Int(value.max_output_bytes)
    var root: Dict<text, SdnValue> = {}
    root["schema"] = SdnValue.String(ENV_ACCESS_PLAN_SCHEMA_V1)
    root["version"] = SdnValue.Int(1)
    root["plan_id"] = SdnValue.String(value.plan.plan_id)
    root["canonical_repo_root"] = SdnValue.String(value.plan.canonical_repo_root)
    root["max_total_bytes"] = SdnValue.Int(value.plan.max_total_bytes)
    root["max_processes"] = SdnValue.Int(value.plan.max_processes)
    root["instructions"] = SdnValue.Array(instruction_values)
    root["tools"] = SdnValue.Array(tool_values)
    root["hardware_probes"] = SdnValue.Array(probe_values)
    root["install"] = SdnValue.Dict(install)
    val encoded = sdn_encode_canonical(SdnValue.Dict(root))
    if encoded.len() > ENV_ACCESS_PLAN_SDN_MAX_BYTES: return Err("ENV-E-PLAN-SIZE")
    return Ok(encoded)
