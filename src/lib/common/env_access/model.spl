# codex-impl
# Typed environment-access plans. Arbitrary shell commands are intentionally absent.

pub enum EnvAccessKind:
    ReadEnv
    HostIdentity
    ReadRepoFile
    RunAllowedTool
    HardwareProbe

pub struct EnvAccessInstruction:
    kind: EnvAccessKind
    resource: text
    arguments: [text]
    timeout_ms: i64
    max_stdout_bytes: i64
    max_stderr_bytes: i64

pub enum EnvAccessStatus:
    Executed
    Blocked
    Unsupported
    Rejected
    TimedOut

pub enum EnvScenarioDisposition:
    Execute
    Skip
    Exclude

# A scenario may be omitted only through this typed record. Skip is a
# temporary environment absence; Exclude is a reviewed scope decision.
pub struct EnvScenarioSelection:
    scenario_id: text
    disposition: EnvScenarioDisposition
    reason: text
    owner: text
    tracking_id: text
    expires_or_version: text
    prerequisite: text
    artifact_paths: [text]
    resume_command: text

pub struct EnvAccessReceipt:
    plan_id: text
    instruction_index: i64
    status: EnvAccessStatus
    exit_code: i64
    stdout_hash: text
    stderr_hash: text
    discarded_bytes: i64
    reason: text
    prerequisite: text
    owner: text
    artifact_paths: [text]
    resume_command: text

# Capability implementations return raw bounded observations. Hashing and the
# final receipt are owned by the parent executor, never by the host adapter.
pub struct EnvAccessRawResult:
    status: EnvAccessStatus
    exit_code: i64
    stdout: text
    stderr: text
    discarded_bytes: i64
    elapsed_ms: i64
    reason: text
    prerequisite: text
    owner: text
    artifact_paths: [text]
    resume_command: text

pub struct EnvAccessPlan:
    plan_id: text
    canonical_repo_root: text
    instructions: [EnvAccessInstruction]
    max_total_bytes: i64
    max_processes: i64
    allowed_tools: [EnvToolIdentity]
    allowed_hardware_probes: [EnvHardwareProbeIdentity]

# Tools are admitted by stable logical ID and a pre-resolved executable path.
# Executors never search PATH or interpret resource text as a command.
pub struct EnvToolIdentity:
    tool_id: text
    canonical_path: text
    identity_hash: text

pub struct EnvHardwareProbeIdentity:
    probe_id: text
    schema_id: text
    max_arguments: i64
    max_timeout_ms: i64
    max_stdout_bytes: i64
    max_stderr_bytes: i64

fn env_text_too_long(value: text, maximum: i64) -> bool:
    value.len() > maximum

fn env_has_control(value: text) -> bool:
    for character in value.chars():
        val code = character.char_code_at(0)
        if code < 32 or code == 127:
            return true
    return false

fn env_exact_sha256(value: text) -> bool:
    if value.len() != 71 or not value.starts_with("sha256:"):
        return false
    var index = 7
    while index < value.len():
        val digit = value.substring(index, index + 1)
        if not "0123456789abcdef".contains(digit):
            return false
        index = index + 1
    return true

fn env_canonical_absolute_path(path: text) -> bool:
    if (path == "" or env_has_control(path) or path.contains("\\") or path.contains("/../") or
        path.ends_with("/..") or path.contains("//")):
        return false
    if path.starts_with("/"):
        return true
    # Canonical Windows paths use slash separators at this boundary.
    return path.len() >= 3 and path[1..3] == ":/"

pub fn env_canonical_evidence_artifact_path(path: text) -> bool:
    val value = path.trim()
    if (value == "" or value.len() > 4096 or value.starts_with("/") or
        value.contains("\\") or value.contains(":") or value.contains("//") or
        value == "." or value == ".." or value.starts_with("./") or
        value.starts_with("../") or value.contains("/../") or
        value.ends_with("/..") or value.ends_with("/")):
        return false
    not env_has_control(value)

fn env_tool_identity_error(tool: EnvToolIdentity) -> text:
    val tool_id = tool.tool_id.trim()
    if (tool_id == "" or env_has_control(tool_id) or env_text_too_long(tool_id, 128) or tool_id.contains("/") or
        tool_id.contains("\\") or tool_id.contains(":") or tool_id.contains(" ")):
        return "ENV-E-TOOL-ID"
    if env_text_too_long(tool.canonical_path, 4096) or not env_canonical_absolute_path(tool.canonical_path):
        return "ENV-E-TOOL-PATH"
    if not env_exact_sha256(tool.identity_hash):
        return "ENV-E-TOOL-IDENTITY"
    return ""

pub fn env_hardware_probe_identity_error(probe: EnvHardwareProbeIdentity) -> text:
    if (probe.probe_id.trim() == "" or probe.probe_id.len() > 128 or
        env_has_control(probe.probe_id) or probe.probe_id.contains("/") or
        probe.probe_id.contains("\\") or probe.probe_id.contains(":") or
        probe.probe_id.contains(" ")):
        return "ENV-E-PROBE-ID"
    if (probe.schema_id.trim() == "" or probe.schema_id.len() > 128 or
        env_has_control(probe.schema_id) or probe.schema_id.contains("/") or
        probe.schema_id.contains("\\") or probe.schema_id.contains(":") or
        probe.schema_id.contains(" ")):
        return "ENV-E-PROBE-SCHEMA"
    if (probe.max_arguments < 0 or probe.max_arguments > 64 or
        probe.max_timeout_ms <= 0 or probe.max_timeout_ms > 600000 or
        probe.max_stdout_bytes < 0 or probe.max_stdout_bytes > 16777216 or
        probe.max_stderr_bytes < 0 or probe.max_stderr_bytes > 16777216):
        return "ENV-E-PROBE-BOUND"
    return ""

pub fn env_access_instruction_error(instruction: EnvAccessInstruction) -> text:
    if instruction.resource.trim() == "" and instruction.kind != EnvAccessKind.HostIdentity:
        return "ENV-E-UNDECLARED"
    if env_has_control(instruction.resource) or env_text_too_long(instruction.resource, 4096):
        return "ENV-E-BOUND"
    if instruction.timeout_ms <= 0 or instruction.timeout_ms > 600000:
        return "ENV-E-BOUND"
    if (instruction.max_stdout_bytes < 0 or instruction.max_stdout_bytes > 16777216 or
        instruction.max_stderr_bytes < 0 or instruction.max_stderr_bytes > 16777216):
        return "ENV-E-BOUND"
    if instruction.arguments.len() > 64:
        return "ENV-E-BOUND"
    if instruction.kind == EnvAccessKind.ReadRepoFile:
        val path = instruction.resource.trim()
        if (path.starts_with("/") or path.contains("\\") or path.contains(":") or
            path == ".." or path.starts_with("../") or path.contains("/../") or path.ends_with("/..")):
            return "ENV-E-REPO-PATH"
        if instruction.arguments.len() != 0:
            return "ENV-E-ARGUMENT"
    if instruction.kind == EnvAccessKind.ReadEnv or instruction.kind == EnvAccessKind.HardwareProbe:
        val resource_id = instruction.resource.trim()
        if (env_text_too_long(resource_id, 128) or resource_id.contains("/") or
            resource_id.contains("\\") or resource_id.contains(":") or resource_id.contains(" ")):
            return "ENV-E-RESOURCE-ID"
    if instruction.kind == EnvAccessKind.HostIdentity:
        if instruction.resource.trim() != "" or instruction.arguments.len() != 0:
            return "ENV-E-HOST-IDENTITY"
    var argument_bytes = 0
    for argument in instruction.arguments:
        if env_has_control(argument) or env_text_too_long(argument, 1024):
            return "ENV-E-ARGUMENT"
        argument_bytes = argument_bytes + argument.len()
        if argument_bytes > 4096:
            return "ENV-E-ARGUMENT"
    return ""

pub fn env_access_plan_error(plan: EnvAccessPlan) -> text:
    if plan.plan_id.trim() == "" or env_has_control(plan.plan_id) or env_text_too_long(plan.plan_id, 128):
        return "ENV-E-PLAN-ID"
    if (plan.canonical_repo_root == "/" or plan.canonical_repo_root.ends_with("/") or
        not env_canonical_absolute_path(plan.canonical_repo_root) or
        env_text_too_long(plan.canonical_repo_root, 4096)):
        return "ENV-E-REPO-ROOT"
    if (plan.max_total_bytes <= 0 or plan.max_total_bytes > 67108864 or
        plan.max_processes < 0 or plan.max_processes > 64):
        return "ENV-E-BOUND"
    if (plan.instructions.len() > 1024 or plan.allowed_tools.len() > 64 or
        plan.allowed_hardware_probes.len() > 64):
        return "ENV-E-BOUND"
    var process_count = 0
    var declared_output_bytes = 0
    var tool_index = 0
    while tool_index < plan.allowed_tools.len():
        val tool = plan.allowed_tools[tool_index]
        val tool_problem = env_tool_identity_error(tool)
        if tool_problem != "":
            return tool_problem
        var prior_index = 0
        while prior_index < tool_index:
            if plan.allowed_tools[prior_index].tool_id == tool.tool_id:
                return "ENV-E-TOOL-DUPLICATE"
            prior_index = prior_index + 1
        tool_index = tool_index + 1
    var probe_index = 0
    while probe_index < plan.allowed_hardware_probes.len():
        val probe = plan.allowed_hardware_probes[probe_index]
        val probe_problem = env_hardware_probe_identity_error(probe)
        if probe_problem != "":
            return probe_problem
        var prior_probe_index = 0
        while prior_probe_index < probe_index:
            if plan.allowed_hardware_probes[prior_probe_index].probe_id == probe.probe_id:
                return "ENV-E-PROBE-DUPLICATE"
            prior_probe_index = prior_probe_index + 1
        probe_index = probe_index + 1
    for instruction in plan.instructions:
        val problem = env_access_instruction_error(instruction)
        if problem != "":
            return problem
        # Subtraction avoids overflowing while proving the aggregate capture
        # bound before any executor allocates buffers.
        if instruction.max_stdout_bytes > plan.max_total_bytes - declared_output_bytes:
            return "ENV-E-TOTAL-BYTES"
        declared_output_bytes = declared_output_bytes + instruction.max_stdout_bytes
        if instruction.max_stderr_bytes > plan.max_total_bytes - declared_output_bytes:
            return "ENV-E-TOTAL-BYTES"
        declared_output_bytes = declared_output_bytes + instruction.max_stderr_bytes
        if instruction.kind == EnvAccessKind.RunAllowedTool:
            process_count = process_count + 1
            var admitted = false
            for tool in plan.allowed_tools:
                if tool.tool_id == instruction.resource:
                    admitted = true
            if not admitted:
                return "ENV-E-TOOL-NOT-ALLOWED"
        if instruction.kind == EnvAccessKind.HardwareProbe:
            var probe_admitted = false
            for probe in plan.allowed_hardware_probes:
                if probe.probe_id == instruction.resource:
                    probe_admitted = true
                    if (instruction.arguments.len() > probe.max_arguments or
                        instruction.timeout_ms > probe.max_timeout_ms or
                        instruction.max_stdout_bytes > probe.max_stdout_bytes or
                        instruction.max_stderr_bytes > probe.max_stderr_bytes):
                        return "ENV-E-PROBE-BOUND"
            if not probe_admitted:
                return "ENV-E-PROBE-NOT-ALLOWED"
    if process_count > plan.max_processes:
        return "ENV-E-PROCESS-CAP"
    return ""

pub fn env_access_receipt_error(receipt: EnvAccessReceipt) -> text:
    if (receipt.plan_id.trim() == "" or env_text_too_long(receipt.plan_id, 128) or
        receipt.instruction_index < 0):
        return "ENV-E-RECEIPT-ID"
    if receipt.discarded_bytes < 0:
        return "ENV-E-BOUND"
    if (env_text_too_long(receipt.stdout_hash, 128) or env_text_too_long(receipt.stderr_hash, 128) or
        env_text_too_long(receipt.reason, 4096) or env_text_too_long(receipt.prerequisite, 4096) or
        env_text_too_long(receipt.owner, 256) or env_text_too_long(receipt.resume_command, 4096) or
        receipt.artifact_paths.len() > 64):
        return "ENV-E-BOUND"
    if (env_has_control(receipt.plan_id) or env_has_control(receipt.stdout_hash) or
        env_has_control(receipt.stderr_hash) or env_has_control(receipt.reason) or
        env_has_control(receipt.prerequisite) or env_has_control(receipt.owner) or
        env_has_control(receipt.resume_command)):
        return "ENV-E-CONTROL"
    for artifact_path in receipt.artifact_paths:
        if env_has_control(artifact_path) or env_text_too_long(artifact_path, 4096):
            return "ENV-E-BOUND"
    if receipt.status == EnvAccessStatus.Executed:
        if not env_exact_sha256(receipt.stdout_hash) or not env_exact_sha256(receipt.stderr_hash):
            return "ENV-E-RECEIPT-HASH"
    if (receipt.status == EnvAccessStatus.Blocked or
        receipt.status == EnvAccessStatus.Unsupported or
        receipt.status == EnvAccessStatus.Rejected or
        receipt.status == EnvAccessStatus.TimedOut):
        if (receipt.reason.trim() == "" or receipt.prerequisite.trim() == ""
            or receipt.owner.trim() == "" or receipt.resume_command.trim() == ""):
            return "ENV-B-BLOCKED-INCOMPLETE"
    return ""

# Receipts are committed in instruction order. This makes replay deterministic
# and validates in O(n) time without a map or any validation-time allocation.
pub fn env_access_receipts_error(plan: EnvAccessPlan, receipts: [EnvAccessReceipt]) -> text:
    val plan_problem = env_access_plan_error(plan)
    if plan_problem != "":
        return plan_problem
    if receipts.len() != plan.instructions.len():
        return "ENV-E-RECEIPT-COUNT"
    var index = 0
    while index < receipts.len():
        val receipt = receipts[index]
        val receipt_problem = env_access_receipt_error(receipt)
        if receipt_problem != "":
            return receipt_problem
        if receipt.plan_id != plan.plan_id or receipt.instruction_index != index:
            return "ENV-E-RECEIPT-ORDER"
        index = index + 1
    return ""

pub fn env_scenario_selection_error(selection: EnvScenarioSelection) -> text:
    if selection.scenario_id.trim() == "" or env_text_too_long(selection.scenario_id, 256):
        return "ENV-E-SCENARIO-ID"
    if (env_text_too_long(selection.reason, 4096) or env_text_too_long(selection.owner, 256) or
        env_text_too_long(selection.tracking_id, 256) or env_text_too_long(selection.expires_or_version, 128) or
        env_text_too_long(selection.prerequisite, 4096) or env_text_too_long(selection.resume_command, 4096) or
        selection.artifact_paths.len() > 64):
        return "ENV-E-BOUND"
    if (env_has_control(selection.scenario_id) or env_has_control(selection.reason) or
        env_has_control(selection.owner) or env_has_control(selection.tracking_id) or
        env_has_control(selection.expires_or_version) or
        env_has_control(selection.prerequisite) or
        env_has_control(selection.resume_command)):
        return "ENV-E-CONTROL"
    for artifact_path in selection.artifact_paths:
        if not env_canonical_evidence_artifact_path(artifact_path):
            return "ENV-E-ARTIFACT-PATH"
    if selection.disposition == EnvScenarioDisposition.Execute:
        if (selection.reason.trim() != "" or selection.owner.trim() != "" or
            selection.tracking_id.trim() != "" or selection.expires_or_version.trim() != "" or
            selection.prerequisite.trim() != "" or selection.artifact_paths.len() != 0 or
            selection.resume_command.trim() != ""):
            return "ENV-E-EXECUTE-METADATA"
        return ""
    if (selection.reason.trim() == "" or selection.owner.trim() == "" or
        selection.tracking_id.trim() == ""):
        return "ENV-E-OMISSION-REASON"
    if selection.disposition == EnvScenarioDisposition.Skip:
        if (selection.prerequisite.trim() == "" or
            selection.resume_command.trim() == "" or
            selection.artifact_paths.len() == 0):
            return "ENV-B-BLOCKED-INCOMPLETE"
    if selection.disposition == EnvScenarioDisposition.Exclude and selection.expires_or_version.trim() == "":
        return "ENV-E-EXCLUSION-STALE"
    return ""

pub fn env_scenario_execute(scenario_id: text) -> EnvScenarioSelection:
    return EnvScenarioSelection(
        scenario_id: scenario_id,
        disposition: EnvScenarioDisposition.Execute,
        reason: "",
        owner: "",
        tracking_id: "",
        expires_or_version: "",
        prerequisite: "",
        artifact_paths: [],
        resume_command: ""
    )

pub fn env_scenario_skip(scenario_id: text, reason: text, owner: text,
                         tracking_id: text, prerequisite: text,
                         artifact_paths: [text],
                         resume_command: text) -> EnvScenarioSelection:
    return EnvScenarioSelection(
        scenario_id: scenario_id,
        disposition: EnvScenarioDisposition.Skip,
        reason: reason,
        owner: owner,
        tracking_id: tracking_id,
        expires_or_version: "",
        prerequisite: prerequisite,
        artifact_paths: artifact_paths,
        resume_command: resume_command
    )

pub fn env_scenario_exclude(scenario_id: text, reason: text, owner: text,
                            tracking_id: text,
                            expires_or_version: text) -> EnvScenarioSelection:
    return EnvScenarioSelection(
        scenario_id: scenario_id,
        disposition: EnvScenarioDisposition.Exclude,
        reason: reason,
        owner: owner,
        tracking_id: tracking_id,
        expires_or_version: expires_or_version,
        prerequisite: "",
        artifact_paths: [],
        resume_command: ""
    )
