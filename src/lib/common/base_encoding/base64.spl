# Pure Simple Base64 encode/decode (RFC 4648).
#
# The former C runtime_base64.c has been deleted — this pure-Simple
# implementation is the sole base64 provider.
#
# NOTE: In Simple `and`/`or` are boolean operators; `&`/`|` are bitwise.
#
# Exported functions:
#   base64_encode(data: text) -> text
#   base64_decode(encoded: text) -> text
#   base64url_encode(data: text) -> text
#   base64url_encode_bytes(data: [u8]) -> text                    (binary-safe)
#   base64url_encode_i64_bytes(data: [i64]) -> text               (std.crypto bytes)
#   base64url_decode(encoded: text) -> text                       (lenient)
#   base64url_decode_strict(encoded: text) -> Result<text, Base64UrlError>

# ============================================================================
# Encoding table (RFC 4648 §4)
# ============================================================================

val ENCODE_TABLE = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

# ============================================================================
# Decode helper: maps ASCII ordinal → 6-bit value, or 255 for invalid.
# ============================================================================

use std.common.encoding.utf8.{char_from_codepoint}

fn _decode_char(c: i64) -> i64:
    """Return the 6-bit value for an ASCII base64 character, or 255 if invalid."""
    if c >= 65 and c <= 90:
        c - 65
    else if c >= 97 and c <= 122:
        c - 97 + 26
    else if c >= 48 and c <= 57:
        c - 48 + 52
    else if c == 43:   # '+'
        62
    else if c == 47:   # '/'
        63
    else:
        255

# ============================================================================
# Encode
# ============================================================================

fn _base64_encode_bytes(data: text) -> [u8]:
    """Text-taking wrapper over `_base64_encode_raw`. Kept as the entry point
    for `base64_encode` / `base64url_encode`, whose inputs are `text`."""
    _base64_encode_raw(data.bytes())

fn _base64_encode_raw(bytes: [u8]) -> [u8]:
    """Core RFC 4648 §4 encode loop, returning raw ASCII output bytes
    (with '=' padding) instead of text. Building a [u8] array with `push`
    and converting to text ONCE at the end (O(n)) replaces the former
    per-char `out = out + c` scalar text concatenation, which was O(n^2)
    and measured 44.7x slower than the C oracle in the codegen lane.

    ENCODE_BYTES is recomputed as a LOCAL below rather than hoisted to a
    module-level `val` — a module-level `[u8] val` indexed and pushed into
    another `[u8]` array corrupts the value under the codegen (JIT) lane
    (e.g. reads back as 8 instead of 65 for 'A'); a function-local array of
    the same bytes does not exhibit this. See
    doc/08_tracking/bug/jit_module_level_u8_array_index_push_corruption_2026-08-18.md."""
    val encode_bytes = ENCODE_TABLE.bytes()
    val n = bytes.len()
    var out_bytes: [u8] = []
    var i = 0
    while i < n:
        val b1 = bytes[i] as i64
        var b2: i64 = 0
        var b3: i64 = 0
        if i + 1 < n:
            b2 = bytes[i + 1] as i64
        if i + 2 < n:
            b3 = bytes[i + 2] as i64

        # Use & (bitwise AND) and | (bitwise OR) — not `and`/`or` (boolean)
        val idx0 = b1 >> 2
        val idx1 = ((b1 & 3) << 4) | (b2 >> 4)
        val idx2 = ((b2 & 15) << 2) | (b3 >> 6)
        val idx3 = b3 & 63

        out_bytes = out_bytes.push(encode_bytes[idx0])
        out_bytes = out_bytes.push(encode_bytes[idx1])
        if i + 1 < n:
            out_bytes = out_bytes.push(encode_bytes[idx2])
        else:
            out_bytes = out_bytes.push(61u8)  # '='
        if i + 2 < n:
            out_bytes = out_bytes.push(encode_bytes[idx3])
        else:
            out_bytes = out_bytes.push(61u8)  # '='

        i = i + 3
    out_bytes

pub fn base64_encode(data: text) -> text:
    """Encode arbitrary text as standard base64 (RFC 4648 §4, with '=' padding)."""
    _bytes_to_text(_base64_encode_bytes(data))

# ============================================================================
# Decode
# ============================================================================

pub fn base64_decode(encoded: text) -> text:
    """Decode standard base64 text (RFC 4648 §4).

    Whitespace is ignored. Invalid characters are skipped (lenient mode).
    Padding '=' terminates the current group.
    """
    val n = encoded.length()
    var out_bytes: [u8] = []
    var c0 = 0
    var c1 = 0
    var c2 = 0
    var c3 = 0
    var chunk_len = 0
    var pad_count = 0
    var i = 0
    val enc_bytes = encoded.bytes()
    while i < n:
        # Iterate BYTES, not codepoints. `n` is encoded.length(), which is a
        # BYTE count, while char_at(i) is CODEPOINT indexed -- so on any
        # non-ASCII input the loop over-ran the string. Worse, on the default
        # (JIT) engine `char_at(i) as i64` does not yield the code point at
        # all: it returns a raw pointer value (e.g. "e" -> 394395739456
        # instead of 233), so _decode_char rejected EVERY character and
        # base64_decode returned an empty string for all input, ASCII
        # included. The base64 alphabet is ASCII, so reading raw bytes is both
        # correct and what the RFC 4648 lenient-skip contract expects: any
        # byte outside the alphabet is simply skipped.
        val raw = enc_bytes[i] as i64
        i = i + 1

        # Skip whitespace (space, tab, LF, CR)
        if raw == 32 or raw == 9 or raw == 10 or raw == 13:
            pass_dn

        if raw == 61:  # '=' padding
            if chunk_len < 2:
                chunk_len = 0
                c0 = 0
                c1 = 0
                c2 = 0
                c3 = 0
                pad_count = 0
            else:
                pad_count = pad_count + 1
                chunk_len = chunk_len + 1
                if chunk_len == 4:
                    out_bytes = out_bytes.push(((c0 << 2) | (c1 >> 4)) as u8)
                    if pad_count < 2:
                        out_bytes = out_bytes.push((((c1 & 15) << 4) | (c2 >> 2)) as u8)
                    chunk_len = 0
                    c0 = 0
                    c1 = 0
                    c2 = 0
                    c3 = 0
                    pad_count = 0
        else:
            val v = _decode_char(raw)
            if v != 255:
                if pad_count > 0:
                    chunk_len = 0
                    c0 = 0
                    c1 = 0
                    c2 = 0
                    c3 = 0
                    pad_count = 0
                else if chunk_len == 0:
                    c0 = v
                else if chunk_len == 1:
                    c1 = v
                else if chunk_len == 2:
                    c2 = v
                else:
                    c3 = v
                chunk_len = chunk_len + 1
                if chunk_len == 4:
                    out_bytes = out_bytes.push(((c0 << 2) | (c1 >> 4)) as u8)
                    out_bytes = out_bytes.push((((c1 & 15) << 4) | (c2 >> 2)) as u8)
                    out_bytes = out_bytes.push((((c2 & 3) << 6) | c3) as u8)
                    chunk_len = 0
                    c0 = 0
                    c1 = 0
                    c2 = 0
                    c3 = 0

    # Handle incomplete final group (no explicit padding in stream)
    if chunk_len >= 2:
        out_bytes = out_bytes.push(((c0 << 2) | (c1 >> 4)) as u8)
    if chunk_len >= 3:
        out_bytes = out_bytes.push((((c1 & 15) << 4) | (c2 >> 2)) as u8)

    _bytes_to_text(out_bytes)

# ============================================================================
# Base64url variants (RFC 4648 §5): replaces +→-, /→_; no padding
# ============================================================================

pub fn base64url_encode(data: text) -> text:
    """Encode text as URL-safe base64 (RFC 4648 §5, no padding)."""
    _std_b64_to_url(_base64_encode_bytes(data))

pub fn base64url_encode_bytes(data: [u8]) -> text:
    """Encode arbitrary BINARY as URL-safe base64 (RFC 4648 §5, no padding).

    Sibling of `base64url_encode`, which takes `text`. Digest output (HMAC,
    SHA) is arbitrary binary: it contains 0x00 and bytes >= 0x80 that are not
    valid UTF-8, so routing it through the text-typed API is lossy. Both
    functions run the SAME core loop (`_base64_encode_raw`) and the SAME
    url-alphabet mapping (`_std_b64_to_url`), so for any input that happens
    to be valid text the two produce byte-identical output by construction,
    not by coincidence.
    """
    _std_b64_to_url(_base64_encode_raw(data))

pub fn base64url_encode_i64_bytes(data: [i64]) -> text:
    """`base64url_encode_bytes` for callers whose byte arrays are `[i64]`.

    `std.crypto` (`hmac_sha256_bytes`, `text_to_bytes`) represents bytes as
    `[i64]`, while this module represents them as `[u8]`. This adapter exists
    once here rather than being copy-pasted into every crypto caller. Each
    element is masked to its low 8 bits, so an out-of-range `[i64]` element
    cannot silently corrupt neighbouring output sextets.
    """
    val n = data.len()
    var bytes: [u8] = []
    var i = 0
    while i < n:
        bytes = bytes.push((data[i] & 255) as u8)
        i = i + 1
    base64url_encode_bytes(bytes)

fn _std_b64_to_url(std_bytes: [u8]) -> text:
    """Map standard base64 output bytes onto the url alphabet: '+'→'-',
    '/'→'_', and drop '=' padding (RFC 4648 §5)."""
    val n = std_bytes.len()
    var out_bytes: [u8] = []
    var i = 0
    while i < n:
        val b = std_bytes[i]
        if b == 43u8:      # '+'
            out_bytes = out_bytes.push(45u8)   # '-'
        else if b == 47u8: # '/'
            out_bytes = out_bytes.push(95u8)   # '_'
        else if b != 61u8: # skip '='
            out_bytes = out_bytes.push(b)
        i = i + 1
    _bytes_to_text(out_bytes)

pub fn base64url_decode(encoded: text) -> text:
    """Decode URL-safe base64 text (RFC 4648 §5).

    Replaces '-'→'+', '_'→'/', re-pads to 4-char boundary, then
    delegates to standard base64_decode. This is the pure-Simple
    replacement for the C extern rt_base64url_decode used in id_token.spl.
    """
    val enc_bytes = encoded.bytes()
    val n = enc_bytes.len()
    var out_bytes: [u8] = []
    var i = 0
    while i < n:
        val b = enc_bytes[i]
        if b == 45u8:      # '-'
            out_bytes = out_bytes.push(43u8)   # '+'
        else if b == 95u8: # '_'
            out_bytes = out_bytes.push(47u8)   # '/'
        else:
            out_bytes = out_bytes.push(b)
        i = i + 1

    # Re-add '=' padding to reach 4-char boundary
    val rem = out_bytes.len() % 4
    if rem == 2:
        out_bytes = out_bytes.push(61u8)
        out_bytes = out_bytes.push(61u8)
    else if rem == 3:
        out_bytes = out_bytes.push(61u8)

    base64_decode(_bytes_to_text(out_bytes))

# ============================================================================
# Strict base64url decode (RFC 4648 §3.3 — reject, do not repair)
# ============================================================================

enum Base64UrlError:
    """Why a string is not valid unpadded base64url (RFC 4648 §5).

    Variants:
      InvalidChar(i64)   — byte offset of the first byte outside [A-Za-z0-9-_].
                           '+', '/' and '=' are invalid here: they belong to
                           the STANDARD alphabet / padded form, not base64url.
      InvalidLength(i64) — the input length, whose mod-4 residue is 1. No
                           sequence of bytes encodes to such a length, so a
                           1-char tail is always truncation or corruption.
    """
    InvalidChar(i64)
    InvalidLength(i64)

pub fn base64url_decode_strict(encoded: text) -> Result<text, Base64UrlError>:
    """Decode unpadded URL-safe base64 (RFC 4648 §5), REJECTING invalid input.

    Strict sibling of `base64url_decode`, which is lenient (it silently skips
    out-of-alphabet bytes and so cannot tell a malformed segment from a
    well-formed one — see
    doc/08_tracking/bug/base64url_decode_accepts_invalid_alphabet_2026-08-18.md).
    Security-sensitive callers that decode untrusted input (JWT segments,
    password-reset tokens) should use THIS function.

    The lenient function's behaviour is deliberately unchanged; existing
    callers keep working.

    Contract:
      - Ok(text) for every valid unpadded base64url string, byte-identical to
        what `base64url_decode` returns for that same valid input.
      - Err(InvalidChar(i)) for any byte outside [A-Za-z0-9-_], including
        whitespace, '=' padding, and the standard-alphabet '+' and '/'.
      - Err(InvalidLength(n)) when n % 4 == 1.
      - Ok("") for the empty string: zero bytes encode to zero characters,
        residue 0, so empty IS valid base64url.
    """
    val enc_bytes = encoded.bytes()
    val n = enc_bytes.len()
    if n % 4 == 1:
        return Err(Base64UrlError.InvalidLength(n))
    var i = 0
    while i < n:
        val b = enc_bytes[i] as i64
        val ok = ((b >= 65 and b <= 90)      # A-Z
            or (b >= 97 and b <= 122)        # a-z
            or (b >= 48 and b <= 57)         # 0-9
            or b == 45                       # '-'
            or b == 95)                      # '_'
        if not ok:
            return Err(Base64UrlError.InvalidChar(i))
        i = i + 1
    Ok(base64url_decode(encoded))

# ============================================================================
# Internal: convert a raw byte array to text (UTF-8 interpretation)
# ============================================================================

fn _bytes_to_text(data: [u8]) -> text:
    """Interpret a raw byte slice as UTF-8 text.

    Non-UTF-8 bytes are replaced with '?'.
    Mirrors Rust's String::from_utf8_lossy behaviour.

    Uses char_from_codepoint, not `cp.chr()`: `chr` is an interpreter-only
    builtin, so on the default (JIT) engine every .chr() here yielded nothing
    and the public base64_decode returned an EMPTY string -- silently, with no
    error -- for all input including pure ASCII.
    """
    # Accumulate into an array and join ONCE at the end (O(n)) instead of
    # scalar `result = result + c` (O(n^2)) — same fix as the encode side.
    var parts: [text] = []
    var i = 0
    val n = data.len()
    while i < n:
        val b = data[i] as i64
        if b < 0x80:
            parts = parts.push(char_from_codepoint(b))
            i = i + 1
        else if b < 0xC0:
            parts = parts.push("?")
            i = i + 1
        else if b < 0xE0:
            if i + 1 < n:
                val b2 = data[i + 1] as i64
                val cp = ((b & 0x1F) << 6) | (b2 & 0x3F)
                parts = parts.push(char_from_codepoint(cp))
                i = i + 2
            else:
                parts = parts.push("?")
                i = i + 1
        else if b < 0xF0:
            if i + 2 < n:
                val b2 = data[i + 1] as i64
                val b3 = data[i + 2] as i64
                val cp = ((b & 0x0F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
                parts = parts.push(char_from_codepoint(cp))
                i = i + 3
            else:
                parts = parts.push("?")
                i = i + 1
        else:
            if i + 3 < n:
                val b2 = data[i + 1] as i64
                val b3 = data[i + 2] as i64
                val b4 = data[i + 3] as i64
                val cp = ((b & 0x07) << 18) | ((b2 & 0x3F) << 12) | ((b3 & 0x3F) << 6) | (b4 & 0x3F)
                parts = parts.push(char_from_codepoint(cp))
                i = i + 4
            else:
                parts = parts.push("?")
                i = i + 1
    parts.join("")
