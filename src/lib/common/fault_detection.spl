# Fault Detection State
#
# Pure-Simple port of the seed's `simple_common::fault_detection`
# (src/compiler_rust/common/src/fault_detection.rs): the timeout flag and the
# recursion-depth counter polled by the pure-Simple interpreter
# (src/app/interpreter/core/watchdog.spl, execution_guard.spl).
#
# This state belongs to the Simple interpreter, not to the host runtime: the
# seed's own TIMEOUT_EXCEEDED / RECURSION_DEPTH atomics are not readable from
# Simple and are not mirrored here.
#
# Timeout: there is no timer thread. `set_timeout_limit_secs` records a
# deadline on the monotonic clock and `is_timeout_exceeded` compares against
# it, so an unarmed poll is a flag read and an armed poll is one clock sample.

use std.nogc_sync_mut.io.time_ops.{time_sample_monotonic_nanos_or_failure}

export is_timeout_exceeded, set_timeout_exceeded, reset_timeout
export set_timeout_limit_secs, timeout_limit_secs, timeout_deadline_passed
export increment_recursion_depth, decrement_recursion_depth, current_recursion_depth
export get_max_recursion_depth, set_max_recursion_depth, reset_recursion_depth
export set_stack_overflow_detection_enabled, is_stack_overflow_detection_enabled

# ============================================================================
# Timeout detection
# ============================================================================

var timeout_exceeded: bool = false
var timeout_limit: i64 = 0          # seconds; 0 = no deadline armed
var timeout_start_nanos: i64 = 0    # monotonic sample taken when armed

fn timeout_deadline_passed(now_nanos: i64, start_nanos: i64, limit_secs: i64) -> bool:
    """True when `limit_secs` have elapsed between two monotonic samples.
    A limit <= 0 never expires. A failed clock sample (negative) fails closed:
    an armed deadline that cannot be measured counts as passed."""
    if limit_secs <= 0:
        return false
    if now_nanos < 0 or start_nanos < 0:
        return true
    now_nanos - start_nanos >= limit_secs * 1000000000

fn is_timeout_exceeded() -> bool:
    """Poll the timeout. Latches once the armed deadline has passed."""
    if timeout_exceeded:
        return true
    if timeout_limit <= 0:
        return false
    if timeout_deadline_passed(time_sample_monotonic_nanos_or_failure(), timeout_start_nanos, timeout_limit):
        timeout_exceeded = true
    timeout_exceeded

fn set_timeout_exceeded():
    """Mark the timeout as fired."""
    timeout_exceeded = true

fn reset_timeout():
    """Clear the timeout flag (call before each new execution)."""
    timeout_exceeded = false

fn set_timeout_limit_secs(secs: i64):
    """Arm a deadline `secs` seconds from now; a value <= 0 disarms it."""
    if secs > 0:
        timeout_limit = secs
        timeout_start_nanos = time_sample_monotonic_nanos_or_failure()
    else:
        timeout_limit = 0

fn timeout_limit_secs() -> i64:
    """The armed limit in seconds; 0 when no deadline is armed."""
    timeout_limit

# ============================================================================
# Stack overflow detection
# ============================================================================

var recursion_depth: i64 = 0
var max_recursion_depth: i64 = 1000
var stack_overflow_detection_enabled: bool = true

fn set_stack_overflow_detection_enabled(enabled: bool):
    stack_overflow_detection_enabled = enabled

fn is_stack_overflow_detection_enabled() -> bool:
    stack_overflow_detection_enabled

fn set_max_recursion_depth(limit: i64):
    max_recursion_depth = limit

fn get_max_recursion_depth() -> i64:
    max_recursion_depth

fn reset_recursion_depth():
    """Reset the depth counter (call before each new execution)."""
    recursion_depth = 0

fn current_recursion_depth() -> i64:
    recursion_depth

fn increment_recursion_depth() -> bool:
    """Enter a call. Returns false, leaving the depth unchanged, when detection
    is enabled and the depth is already at the limit."""
    if stack_overflow_detection_enabled and recursion_depth >= max_recursion_depth:
        return false
    recursion_depth = recursion_depth + 1
    true

fn decrement_recursion_depth():
    """Leave a call. Saturates at zero."""
    if recursion_depth > 0:
        recursion_depth = recursion_depth - 1
