# Window Protocol — WM input event and command types.
#
# Provides: WmInputEvent, WmCreateRequest, WmCloseRequest,
#           WmResizeRequest, WmMoveRequest, WM_EVENT_CLOSE.

use std.common.window_protocol.geometry.{WindowId, Point, Size, KeyCode, Modifiers, WmEventType}

val WM_EVENT_CLOSE = "wm_close"
val WM_EVENT_FOCUS = "wm_focus"
val WM_EVENT_RESIZE = "wm_resize"

struct WmStatus:
    value: i32

val WM_STATUS_OK = WmStatus(value: 0)
val WM_STATUS_ERROR = WmStatus(value: -1)
val WM_STATUS_NO_SPACE = WmStatus(value: -2)

class WmInputEvent:
    event_type: WmEventType
    window_id: WindowId
    point: Point
    key_code: KeyCode
    modifiers: Modifiers
    scroll_dx: f64
    scroll_dy: f64

    static fn key_down(window_id: WindowId, key_code: KeyCode, modifiers: Modifiers) -> WmInputEvent:
        WmInputEvent(
            event_type: WmEventType.KeyDown,
            window_id: window_id,
            point: Point(x: 0 as i32, y: 0 as i32),
            key_code: key_code,
            modifiers: modifiers,
            scroll_dx: 0.0,
            scroll_dy: 0.0
        )

    static fn mouse_move(window_id: WindowId, point: Point) -> WmInputEvent:
        WmInputEvent(
            event_type: WmEventType.MouseMove,
            window_id: window_id,
            point: point,
            key_code: KeyCode(code: 0 as u32, name: ""),
            modifiers: Modifiers.none(),
            scroll_dx: 0.0,
            scroll_dy: 0.0
        )

    static fn mouse_down(window_id: WindowId, point: Point, modifiers: Modifiers) -> WmInputEvent:
        WmInputEvent(
            event_type: WmEventType.MouseDown,
            window_id: window_id,
            point: point,
            key_code: KeyCode(code: 0 as u32, name: ""),
            modifiers: modifiers,
            scroll_dx: 0.0,
            scroll_dy: 0.0
        )

    static fn mouse_up(window_id: WindowId, point: Point, modifiers: Modifiers) -> WmInputEvent:
        WmInputEvent(
            event_type: WmEventType.MouseUp,
            window_id: window_id,
            point: point,
            key_code: KeyCode(code: 0 as u32, name: ""),
            modifiers: modifiers,
            scroll_dx: 0.0,
            scroll_dy: 0.0
        )

    static fn scroll(window_id: WindowId, point: Point, dx: f64, dy: f64, modifiers: Modifiers) -> WmInputEvent:
        WmInputEvent(
            event_type: WmEventType.Scroll,
            window_id: window_id,
            point: point,
            key_code: KeyCode(code: 0 as u32, name: ""),
            modifiers: modifiers,
            scroll_dx: dx,
            scroll_dy: dy
        )

struct WmCreateRequest:
    title: text
    size: Size
    parent_id: WindowId

struct WmCloseRequest:
    window_id: WindowId

struct WmResizeRequest:
    window_id: WindowId
    size: Size

struct WmMoveRequest:
    window_id: WindowId
    point: Point

struct WmCreateResponse:
    window_id: WindowId
    status: WmStatus

struct WmFocusEvent:
    window_id: WindowId
    focused: bool

fn wm_input_event(window_id: WindowId, kind: text, key_code: KeyCode, point: Point) -> WmInputEvent:
    var event_type = WmEventType.KeyDown
    if kind == WM_EVENT_CLOSE:
        event_type = WmEventType.Close
    elif kind == WM_EVENT_FOCUS:
        event_type = WmEventType.Focus
    elif kind == WM_EVENT_RESIZE:
        event_type = WmEventType.Resize
    WmInputEvent(
        event_type: event_type,
        window_id: window_id,
        point: point,
        key_code: key_code,
        modifiers: Modifiers.none(),
        scroll_dx: 0.0,
        scroll_dy: 0.0
    )

fn wm_focus_event(window_id: WindowId, focused: bool) -> WmFocusEvent:
    WmFocusEvent(window_id: window_id, focused: focused)
