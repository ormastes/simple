# Window Protocol — WM input event and command types.
#
# Provides: WmInputEvent, WmCreateRequest, WmCloseRequest,
#           WmResizeRequest, WmMoveRequest, WM_EVENT_CLOSE.

use std.common.window_protocol.geometry.{WindowId, Point, Size, KeyCode, Modifiers, WmEventType}

val WM_EVENT_CLOSE = "wm_close"
val WM_EVENT_FOCUS = "wm_focus"
val WM_EVENT_RESIZE = "wm_resize"
val WM_INPUT_TEXT_MAX_BYTES: u32 = 4096

struct WmStatus:
    value: i32

val WM_STATUS_OK = WmStatus(value: 0)
val WM_STATUS_ERROR = WmStatus(value: -1)
val WM_STATUS_NO_SPACE = WmStatus(value: -2)

struct WmCreateResponse:
    status: WmStatus
    window_id: WindowId

struct WmFocusEvent:
    window_id: WindowId
    focused: bool

fn wm_event_type_from_wire(tag: text) -> WmEventType:
    if tag == WM_EVENT_CLOSE:
        return WmEventType.Close
    if tag == WM_EVENT_FOCUS:
        return WmEventType.Focus
    if tag == WM_EVENT_RESIZE:
        return WmEventType.Resize
    WmEventType.Close

fn wm_input_event(window_id: WindowId, event_tag: text, key_code: KeyCode, point: Point) -> WmInputEvent:
    WmInputEvent(
        event_type: wm_event_type_from_wire(event_tag),
        window_id: window_id,
        point: point,
        key_code: key_code,
        modifiers: Modifiers.none(),
        scroll_dx: 0.0,
        scroll_dy: 0.0,
        committed_text: ""
    )

fn wm_focus_event(window_id: WindowId, focused: bool) -> WmFocusEvent:
    WmFocusEvent(window_id: window_id, focused: focused)

class WmInputEvent:
    event_type: WmEventType
    window_id: WindowId
    point: Point
    key_code: KeyCode
    modifiers: Modifiers
    scroll_dx: f64
    scroll_dy: f64
    committed_text: text

    static fn key_down(window_id: WindowId, key_code: KeyCode, modifiers: Modifiers) -> WmInputEvent:
        WmInputEvent(
            event_type: WmEventType.KeyDown,
            window_id: window_id,
            point: Point(x: 0 as i32, y: 0 as i32),
            key_code: key_code,
            modifiers: modifiers,
            scroll_dx: 0.0,
            scroll_dy: 0.0,
            committed_text: ""
        )

    static fn text_input(window_id: WindowId, committed_text: text) -> WmInputEvent:
        WmInputEvent(
            event_type: WmEventType.Text,
            window_id: window_id,
            point: Point.xy(0, 0),
            key_code: KeyCode(code: 0 as u32, name: ""),
            modifiers: Modifiers.none(),
            scroll_dx: 0.0,
            scroll_dy: 0.0,
            committed_text: committed_text
        )

    static fn mouse_move(window_id: WindowId, point: Point) -> WmInputEvent:
        WmInputEvent(
            event_type: WmEventType.MouseMove,
            window_id: window_id,
            point: point,
            key_code: KeyCode(code: 0 as u32, name: ""),
            modifiers: Modifiers.none(),
            scroll_dx: 0.0,
            scroll_dy: 0.0,
            committed_text: ""
        )

    static fn mouse_down(window_id: WindowId, point: Point, modifiers: Modifiers) -> WmInputEvent:
        WmInputEvent(
            event_type: WmEventType.MouseDown,
            window_id: window_id,
            point: point,
            key_code: KeyCode(code: 0 as u32, name: ""),
            modifiers: modifiers,
            scroll_dx: 0.0,
            scroll_dy: 0.0,
            committed_text: ""
        )

    static fn mouse_up(window_id: WindowId, point: Point, modifiers: Modifiers) -> WmInputEvent:
        WmInputEvent(
            event_type: WmEventType.MouseUp,
            window_id: window_id,
            point: point,
            key_code: KeyCode(code: 0 as u32, name: ""),
            modifiers: modifiers,
            scroll_dx: 0.0,
            scroll_dy: 0.0,
            committed_text: ""
        )

    static fn scroll(window_id: WindowId, point: Point, dx: f64, dy: f64, modifiers: Modifiers) -> WmInputEvent:
        WmInputEvent(
            event_type: WmEventType.Scroll,
            window_id: window_id,
            point: point,
            key_code: KeyCode(code: 0 as u32, name: ""),
            modifiers: modifiers,
            scroll_dx: dx,
            scroll_dy: dy,
            committed_text: ""
        )

struct WmCreateRequest:
    title: text
    size: Size
    parent_id: WindowId

struct WmCloseRequest:
    window_id: WindowId

struct WmResizeRequest:
    window_id: WindowId
    size: Size

struct WmMoveRequest:
    window_id: WindowId
    point: Point
