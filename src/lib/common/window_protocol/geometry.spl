# Window Protocol Geometry — coordinate types for the window manager protocol.
#
# Provides: WindowId, Point, Size, KeyCode, Modifiers, WmEventType.

struct WindowId:
    value: u64

struct Px:
    value: i32

    fn to_i32() -> i32:
        self.value

struct Point:
    x: i32
    y: i32

    static fn xy(x: i32, y: i32) -> Point:
        Point(x: x, y: y)

struct Size:
    width: u32
    height: u32

    static fn wh(width: i32, height: i32) -> Size:
        Size(width: width as u32, height: height as u32)

struct Rect:
    origin: Point
    size: Size

    static fn xywh(x: i32, y: i32, w: i32, h: i32) -> Rect:
        Rect(origin: Point(x: x, y: y), size: Size(width: w as u32, height: h as u32))

struct KeyCode:
    code: u32
    name: text

struct Modifiers:
    shift: bool
    ctrl: bool
    alt: bool
    meta: bool

    static fn none() -> Modifiers:
        Modifiers(shift: false, ctrl: false, alt: false, meta: false)

    static fn from_bits(bits: u32) -> Modifiers:
        Modifiers(
            shift: (bits & 1u32) != 0u32,
            ctrl: (bits & 2u32) != 0u32,
            alt: (bits & 4u32) != 0u32,
            meta: (bits & 8u32) != 0u32
        )

enum WmEventType:
    KeyDown
    KeyUp
    MouseDown
    MouseUp
    MouseMove
    Scroll
    Focus
    Blur
    Close
    Resize
    Move
    Text

    fn to_u32() -> u32:
        match self:
            WmEventType.KeyDown: 0u32
            WmEventType.KeyUp: 1u32
            WmEventType.MouseDown: 2u32
            WmEventType.MouseUp: 3u32
            WmEventType.MouseMove: 4u32
            WmEventType.Scroll: 5u32
            WmEventType.Focus: 6u32
            WmEventType.Blur: 7u32
            WmEventType.Close: 8u32
            WmEventType.Resize: 9u32
            WmEventType.Move: 10u32
            WmEventType.Text: 11u32

    static fn from_u32(tag: u32) -> WmEventType:
        match tag:
            0u32: WmEventType.KeyDown
            1u32: WmEventType.KeyUp
            2u32: WmEventType.MouseDown
            3u32: WmEventType.MouseUp
            4u32: WmEventType.MouseMove
            5u32: WmEventType.Scroll
            6u32: WmEventType.Focus
            7u32: WmEventType.Blur
            8u32: WmEventType.Close
            9u32: WmEventType.Resize
            10u32: WmEventType.Move
            11u32: WmEventType.Text
            _: WmEventType.MouseMove
