"""Shared edit claims, without IO, source mutation or admission authority.

An edit uses half-open byte coordinates in its immediate before buffer.
Adapters must replay ordered edits against each previous result; mixing
original-base and sequential coordinates is not permitted.
"""

pub enum EditOriginV1:
    Ide
    Spipe
    Scv
    Fs
    Git
    External

pub struct SourceEditV1:
    path: text
    old_snapshot: text
    old_start_byte: u64
    old_end_byte: u64
    new_bytes_digest: text
    new_byte_len: u64
    origin: EditOriginV1
    transaction_id: text

export EditOriginV1, SourceEditV1
