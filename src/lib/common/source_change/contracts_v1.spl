# Shared value contracts for IDE, Spipe, SCV and observed filesystem changes.
# Shape checks below are pure and bounded. They do NOT admit a byte transition,
# inventory root, immutable generation, durable revision, or TLDR freshness.
# Existing compiler snapshot/root owners retain their algorithms and authority.

use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}

pub enum EditOriginV1:
    Ide
    Spipe
    Scv
    Fs
    Git
    External

pub enum SourceSaveStateV1:
    Buffer
    Index
    Worktree
    Commit

pub struct SourceEditV1:
    path: text
    old_snapshot: text
    old_start_byte: u64
    old_end_byte: u64
    new_bytes_digest: text
    new_byte_len: u64
    origin: EditOriginV1
    transaction_id: text

pub struct SourceChangeBatchV1:
    schema: u32
    root_identity: text
    before_root_digest: text
    after_root_digest: text
    sequence: u64
    edits: [SourceEditV1]
    complete: bool

pub struct SourceFileCaptureV1:
    path: text
    file_identity: text
    source_bytes: [u8]
    content_digest: text

pub struct SourceSnapshotV1:
    schema: u32
    root_identity: text
    source_root_digest: text
    inventory_root_digest: text
    digest_algorithm: text
    path_normalization_policy: text
    byte_owner_id: text
    generation_token: text
    generation: u64
    sequence: u64
    save_state: SourceSaveStateV1
    complete: bool
    files: [SourceFileCaptureV1]

pub struct SourceChangeLimitsV1:
    max_path_bytes: u64
    max_identity_bytes: u64
    max_metadata_bytes: u64
    max_capture_bytes: u64
    max_files: u32
    max_edits: u32

pub struct SourceChangeShapeV1:
    valid: bool
    reason: text

fn source_change_shape_reject_v1(reason: text) -> SourceChangeShapeV1:
    SourceChangeShapeV1(valid: false, reason: reason)

pub fn source_change_path_shape_v1(path: text, max_bytes: u64) -> bool:
    """Check bounded repository-relative spelling; normalization is an owner gate."""
    if path == "" or (path.len() as u64) > max_bytes:
        return false
    if path.starts_with("/") or path.contains("\\"):
        return false
    if path.contains("\0"):
        return false
    for component in path.split("/"):
        if component == "" or component == "." or component == "..":
            return false
    true

pub fn source_change_batch_shape_v1(
    batch: SourceChangeBatchV1, limits: SourceChangeLimitsV1
) -> SourceChangeShapeV1:
    """Inspect event shape; a well-formed incomplete batch remains a hint.

    Edit coordinates address the original capture. Per-file ordering, replay,
    generation ownership, continuity and complete inventory need admission.
    """
    if batch.schema != 1:
        return source_change_shape_reject_v1("unsupported_schema")
    if batch.sequence == 0:
        return source_change_shape_reject_v1("invalid_sequence")
    if not sha256_lower_hex_valid(batch.root_identity) or
       not sha256_lower_hex_valid(batch.before_root_digest) or
       not sha256_lower_hex_valid(batch.after_root_digest):
        return source_change_shape_reject_v1("invalid_root_digest")
    if (batch.edits.len() as u64) > (limits.max_edits as u64):
        return source_change_shape_reject_v1("edit_count_over_bound")
    # Fixed root strings are metadata too. Subtract only after checking bounds.
    if limits.max_identity_bytes < 64 or limits.max_metadata_bytes < 192:
        return source_change_shape_reject_v1("metadata_over_bound")
    var remaining: u64 = limits.max_metadata_bytes - 192
    var remaining_payload: u64 = limits.max_capture_bytes
    for edit in batch.edits:
        if not source_change_path_shape_v1(edit.path, limits.max_path_bytes):
            return source_change_shape_reject_v1("invalid_path")
        if edit.old_snapshot == "" or edit.transaction_id == "":
            return source_change_shape_reject_v1("missing_edit_identity")
        if not sha256_lower_hex_valid(edit.new_bytes_digest):
            return source_change_shape_reject_v1("invalid_payload_digest")
        if edit.old_start_byte > edit.old_end_byte or
           edit.old_end_byte > limits.max_capture_bytes or
           edit.new_byte_len > limits.max_capture_bytes:
            return source_change_shape_reject_v1("byte_extent_over_bound")
        if (edit.old_snapshot.len() as u64) > limits.max_identity_bytes or
           (edit.transaction_id.len() as u64) > limits.max_identity_bytes:
            return source_change_shape_reject_v1("identity_over_bound")
        if edit.new_byte_len > remaining_payload:
            return source_change_shape_reject_v1("payload_over_bound")
        remaining_payload = remaining_payload - edit.new_byte_len
        for identity in [edit.path, edit.old_snapshot, edit.new_bytes_digest, edit.transaction_id]:
            val length: u64 = identity.len() as u64
            if length > remaining:
                return source_change_shape_reject_v1("metadata_over_bound")
            remaining = remaining - length
    SourceChangeShapeV1(valid: true, reason: "well_formed_change_batch")
