"""Bounded UTF8 text charging shared by typed table families."""
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}

pub class TraceCodecTextBudgetV1:
    max_field_bytes: i64
    max_text_bytes: i64
    used: i64 = 0
    me charge(fields: [text], path: text) -> Result<bool, TraceCodecIssueV1>:
        if (self.max_field_bytes < 0 or self.max_field_bytes > 1048576 or
            self.max_text_bytes < 0 or self.max_text_bytes > 16777216 or
            self.used < 0 or self.used > self.max_text_bytes):
            return Err(trace_codec_issue_v1("invalid_limits", path, "Text budget outside hard bounds"))
        for item in fields:
            if item.len() > self.max_field_bytes: return Err(trace_codec_issue_v1("field_limit", path, "Field exceeds byte budget"))
            if item.len() > self.max_text_bytes - self.used: return Err(trace_codec_issue_v1("text_limit", path, "Text exceeds aggregate budget"))
            self.used = self.used + item.len()
            match validated_utf8_bytes_to_text_linear(item.bytes()):
                case Ok(_): ()
                case Err(reason): return Err(trace_codec_issue_v1("invalid_utf8", path, reason))
            var index = 0
            while index < item.len():
                if item.byte_at(index) == 0: return Err(trace_codec_issue_v1("invalid_text", path, "NUL is not a document text character"))
                index = index + 1
        Ok(true)

export TraceCodecTextBudgetV1
