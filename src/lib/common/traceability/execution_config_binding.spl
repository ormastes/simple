# Structural binding between caller-authored pre-dispatch intent and a
# canonical execution-configuration snapshot. This is not worker attestation.
# @req REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
use std.common.traceability.run_request.{TraceRunRequest, validate_trace_run_request}
use std.common.traceability.run_selection.{validate_trace_request_selection}
use std.common.traceability.execution_config.{TraceExecutionConfiguration, validate_trace_execution_configuration}
use std.common.traceability.execution_config_codec.{trace_execution_configuration_id}

pub fn validate_trace_request_configuration(
    request: TraceRunRequest,
    config: TraceExecutionConfiguration
) -> Result<(), text>:
    validate_trace_run_request(request)?
    validate_trace_execution_configuration(config)?
    val config_id = trace_execution_configuration_id(config)?
    if request.configuration_id != config_id:
        return Err("trace request configuration ID does not match the canonical execution configuration")
    validate_trace_request_selection(request, config.shard_membership)?
    for planned in request.cases:
        if planned.lane_id != config.lane_id:
            return Err("planned trace case lane does not match execution configuration: " + planned.case_id)
    Ok(())
