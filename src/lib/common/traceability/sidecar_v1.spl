# Sidecar references: declared links that are bound by identity but are not
# graph claims, edges or locators (no pinned blob, no registered authority).
# @req REQ-TRC-015 REQ-TRC-021
use std.common.traceability.model.*
use std.common.traceability.legacy_bugs_v1.{LegacyBugRowV1, LegacyBugSourceV1}

pub struct TraceSidecarReferenceV1:
    source_kind: text
    from_id: text
    relation: text
    path: text
    locator: text
    authority: text

pub struct TraceSidecarSourceV1:
    kind: text
    path: text
    content_sha256: text
    row_count: i64

pub fn legacy_bug_sidecar_source_v1(source: LegacyBugSourceV1) -> TraceSidecarSourceV1:
    TraceSidecarSourceV1(kind: "bug-db/v1", path: source.path,
        content_sha256: source.content_sha256, row_count: source.rows.len())

pub fn legacy_bug_sidecar_references_v1(rows: [LegacyBugRowV1]) -> [TraceSidecarReferenceV1]:
    var references: [TraceSidecarReferenceV1] = []
    for row in rows:
        if row.file != "":
            references.push(TraceSidecarReferenceV1(source_kind: "bug-db/v1", from_id: row.id,
                relation: "located_in", path: row.file,
                locator: if row.line > 0: "line:" + row.line.to_text() else: "", authority: "legacy-row"))
        if row.reproducible_by != "":
            references.push(TraceSidecarReferenceV1(source_kind: "bug-db/v1", from_id: row.id,
                relation: "reproducible_by", path: row.reproducible_by, locator: "", authority: "legacy-row"))
    references

pub fn sidecar_references_from_v1(references: [TraceSidecarReferenceV1], from_id: text) -> [TraceSidecarReferenceV1]:
    var selected: [TraceSidecarReferenceV1] = []
    for reference in references:
        if reference.from_id == from_id: selected.push(reference)
    selected

pub fn sidecar_references_at_path_v1(references: [TraceSidecarReferenceV1], path: text) -> [TraceSidecarReferenceV1]:
    var selected: [TraceSidecarReferenceV1] = []
    for reference in references:
        if reference.path == path: selected.push(reference)
    selected
