# Strict versioned SDN transport for frozen run intent.
# @req REQ-TRC-003 REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
use std.common.sdn.value.{SdnValue}
use std.common.sdn.parser.{parse_with_spans_and_issues}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.traceability.schema.{trace_sdn_preflight}
use std.common.traceability.run_plan.{TracePlannedCase, TraceRunPlan, validate_trace_run_plan}

fn _run_plan_record(names: [text], values: [SdnValue]) -> SdnValue:
    var fields: Dict<text, SdnValue> = {}
    var i = 0
    while i < names.len():
        fields[names[i]] = values[i]
        i += 1
    SdnValue.Dict(fields)

fn _run_plan_text(value: text) -> SdnValue:
    SdnValue.String(value)

fn _run_plan_checked_record(value: SdnValue, names: [text]) -> Result<Dict<text, SdnValue>, text>:
    match value:
        case SdnValue.Dict(fields):
            if fields.len() != names.len():
                return Err("unexpected or missing fields in trace run plan")
            for name in names:
                if not fields.contains_key(name):
                    return Err("missing trace run plan field: " + name)
            Ok(fields)
        case _:
            Err("trace run plan record must be an SDN dictionary")

fn _run_plan_text_field(fields: Dict<text, SdnValue>, name: text) -> Result<text, text>:
    match fields[name]:
        case SdnValue.String(value): Ok(value)
        case _: Err("trace run plan field must be text: " + name)

pub fn encode_trace_run_plan(plan: TraceRunPlan) -> Result<text, text>:
    validate_trace_run_plan(plan)?
    var cases: [SdnValue] = []
    for planned in plan.cases:
        cases.push(_run_plan_record(
            ["case_id", "test_path", "case_name", "test_definition_id", "lane_id"],
            [_run_plan_text(planned.case_id), _run_plan_text(planned.test_path), _run_plan_text(planned.case_name), _run_plan_text(planned.test_definition_id), _run_plan_text(planned.lane_id)]))
    val root = _run_plan_record(
        ["schema", "run_id", "subject_id", "configuration_id", "expectation_id", "binary_id", "cases"],
        [_run_plan_text("simple.trace.run-plan/v1"), _run_plan_text(plan.run_id), _run_plan_text(plan.subject_id), _run_plan_text(plan.configuration_id), _run_plan_text(plan.expectation_id), _run_plan_text(plan.binary_id), SdnValue.Array(cases)])
    val encoded = sdn_encode_canonical(root)
    if encoded.len() > 1048576:
        return Err("trace run plan document exceeds 1 MiB")
    Ok(encoded)

pub fn decode_trace_run_plan(source: text) -> Result<TraceRunPlan, text>:
    trace_sdn_preflight(source)?
    val parsed = parse_with_spans_and_issues(source)?
    if parsed.2.len() > 0:
        return Err("invalid or duplicate trace run plan fields")
    val fields = _run_plan_checked_record(parsed.0, ["schema", "run_id", "subject_id", "configuration_id", "expectation_id", "binary_id", "cases"])?
    if _run_plan_text_field(fields, "schema")? != "simple.trace.run-plan/v1":
        return Err("unsupported trace run plan schema")
    val case_values = match fields["cases"]:
        case SdnValue.Array(values): values
        case _: return Err("trace run plan cases must be an SDN array")
    if case_values.len() > 65536:
        return Err("trace run plan exceeds 65536 planned cases")
    var cases: [TracePlannedCase] = []
    for item in case_values:
        val case_fields = _run_plan_checked_record(item, ["case_id", "test_path", "case_name", "test_definition_id", "lane_id"])?
        cases.push(TracePlannedCase(
            case_id: _run_plan_text_field(case_fields, "case_id")?,
            test_path: _run_plan_text_field(case_fields, "test_path")?,
            case_name: _run_plan_text_field(case_fields, "case_name")?,
            test_definition_id: _run_plan_text_field(case_fields, "test_definition_id")?,
            lane_id: _run_plan_text_field(case_fields, "lane_id")?))
    val plan = TraceRunPlan(
        run_id: _run_plan_text_field(fields, "run_id")?,
        subject_id: _run_plan_text_field(fields, "subject_id")?,
        configuration_id: _run_plan_text_field(fields, "configuration_id")?,
        expectation_id: _run_plan_text_field(fields, "expectation_id")?,
        binary_id: _run_plan_text_field(fields, "binary_id")?,
        cases: cases)
    validate_trace_run_plan(plan)?
    Ok(plan)
