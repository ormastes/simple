# Pure read-only TestDB query model: typed rows, qualification and pagination.
# Rows describe unverified framework observations; only a Passed status can
# qualify, and every absent identity is an explicit Missing variant.
use std.common.traceability.case_events.{TraceCaseEvent}
use std.common.crypto.sha256.{sha256_text}
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}

val TEST_QUERY_MAX_LIMIT: i64 = 1000

pub struct TestCasePath:
    value: text

pub struct TestCaseName:
    value: text

pub struct TestCaseKey:
    path: TestCasePath
    name: TestCaseName

pub struct TestRunId:
    value: text

pub struct TestPlannedCaseId:
    value: text

pub enum TestPlannedCaseIdentity:
    Recorded(id: TestPlannedCaseId)
    Missing

pub struct TestAttemptOrdinal:
    value: i64

pub enum TestAttemptIdentity:
    StreamOrder(ordinal: TestAttemptOrdinal)
    Missing

pub enum TestQueryStatus:
    Passed
    Failed
    Skipped
    Ignored
    QualifiedIgnore
    Pending
    InDevelopment
    FeatureGated
    Blocked
    NotFinished
    Cached
    Unknown(raw: text)

pub enum TestQualification:
    Pass
    NotPass

pub enum TestEvidenceProvenance:
    UnverifiedFrameworkObservation

pub struct TestQueryLimit:
    value: i64

# Opaque continuation token `tq1:<digest>:<offset>`. The digest binds it to the
# query identity (case, run, limit) and to the row snapshot it was issued over.
pub struct TestQueryCursor:
    token: text

pub struct TestQuery:
    case_key: TestCaseKey
    run_id: TestRunId?
    limit: TestQueryLimit
    cursor: TestQueryCursor?

pub struct TestQueryRow:
    case_key: TestCaseKey
    run_id: TestRunId
    planned_case: TestPlannedCaseIdentity
    attempt: TestAttemptIdentity
    status: TestQueryStatus
    qualification: TestQualification
    provenance: TestEvidenceProvenance

pub enum TestQueryTruncation:
    Complete
    Truncated(next: TestQueryCursor)

pub enum TestQueryCoverage:
    Full
    Partial

pub struct TestQueryPage:
    rows: [TestQueryRow]
    truncation: TestQueryTruncation
    coverage: TestQueryCoverage

pub enum TestQueryErrorKind:
    InvalidQuery
    UnknownRun
    StoreUnreadable

pub struct TestQueryError:
    kind: TestQueryErrorKind
    detail: text

pub fn parse_test_query_status(raw: text) -> TestQueryStatus:
    match raw:
        case "passed": TestQueryStatus.Passed
        case "failed": TestQueryStatus.Failed
        case "skipped": TestQueryStatus.Skipped
        case "ignored": TestQueryStatus.Ignored
        case "qualifiedignore": TestQueryStatus.QualifiedIgnore
        case "pending": TestQueryStatus.Pending
        case "in_development": TestQueryStatus.InDevelopment
        case "in-development": TestQueryStatus.InDevelopment
        case "feature_gated": TestQueryStatus.FeatureGated
        case "blocked": TestQueryStatus.Blocked
        case "not_finished": TestQueryStatus.NotFinished
        case "cached": TestQueryStatus.Cached
        case _: TestQueryStatus.Unknown(raw: raw)

# Only an executed-and-passed observation qualifies; skipped, gated, blocked,
# cached and unrecognised statuses are never PASS.
pub fn qualify_test_query_status(status: TestQueryStatus) -> TestQualification:
    match status:
        case TestQueryStatus.Passed: TestQualification.Pass
        case _: TestQualification.NotPass

fn _row(key: TestCaseKey, run_id: TestRunId, planned: TestPlannedCaseIdentity,
        attempt: TestAttemptIdentity, status: TestQueryStatus) -> TestQueryRow:
    TestQueryRow(case_key: key, run_id: run_id, planned_case: planned, attempt: attempt,
        status: status, qualification: qualify_test_query_status(status),
        provenance: TestEvidenceProvenance.UnverifiedFrameworkObservation)

# Each started event opens an attempt, closed by the next finished event of the
# same case. An unclosed attempt is NotFinished; a finished event without an
# open attempt has a Missing attempt identity. Attempts never merge.
pub fn project_run_case_rows(key: TestCaseKey, run_id: TestRunId,
        planned: TestPlannedCaseIdentity, events: [TraceCaseEvent]) -> [TestQueryRow]:
    var rows: [TestQueryRow] = []
    var open = false
    var ordinal = 0
    for event in events:
        if event.case_name != key.name.value:
            continue
        if event.phase == "started":
            if open:
                rows.push(_row(key, run_id, planned, TestAttemptIdentity.StreamOrder(ordinal: TestAttemptOrdinal(value: ordinal)), TestQueryStatus.NotFinished))
                ordinal = ordinal + 1
            open = true
        else:
            val status = parse_test_query_status(event.outcome)
            if open:
                rows.push(_row(key, run_id, planned, TestAttemptIdentity.StreamOrder(ordinal: TestAttemptOrdinal(value: ordinal)), status))
                ordinal = ordinal + 1
                open = false
            else:
                rows.push(_row(key, run_id, planned, TestAttemptIdentity.Missing, status))
    if open:
        rows.push(_row(key, run_id, planned, TestAttemptIdentity.StreamOrder(ordinal: TestAttemptOrdinal(value: ordinal)), TestQueryStatus.NotFinished))
    rows

fn _test_query_invalid(detail: text) -> TestQueryError:
    TestQueryError(kind: TestQueryErrorKind.InvalidQuery, detail: detail)

fn _row_is_partial(row: TestQueryRow) -> bool:
    match row.status:
        case TestQueryStatus.NotFinished: true
        case _:
            match row.attempt:
                case TestAttemptIdentity.Missing: true
                case TestAttemptIdentity.StreamOrder(_): false

fn _status_label(status: TestQueryStatus) -> text:
    match status:
        case TestQueryStatus.Passed: "passed"
        case TestQueryStatus.Failed: "failed"
        case TestQueryStatus.Skipped: "skipped"
        case TestQueryStatus.Ignored: "ignored"
        case TestQueryStatus.QualifiedIgnore: "qualifiedignore"
        case TestQueryStatus.Pending: "pending"
        case TestQueryStatus.InDevelopment: "in_development"
        case TestQueryStatus.FeatureGated: "feature_gated"
        case TestQueryStatus.Blocked: "blocked"
        case TestQueryStatus.NotFinished: "not_finished"
        case TestQueryStatus.Cached: "cached"
        case TestQueryStatus.Unknown(raw): "unknown:" + raw

fn _row_label(row: TestQueryRow) -> text:
    val planned = match row.planned_case:
        case TestPlannedCaseIdentity.Recorded(id): id.value
        case TestPlannedCaseIdentity.Missing: "-"
    val attempt = match row.attempt:
        case TestAttemptIdentity.StreamOrder(ordinal): ordinal.value.to_text()
        case TestAttemptIdentity.Missing: "-"
    row.run_id.value + "|" + planned + "|" + attempt + "|" + _status_label(row.status)

fn _cursor_prefix(rows: [TestQueryRow], query: TestQuery) -> text:
    var labels: [text] = []
    for row in rows:
        labels.push(_row_label(row))
    val run = match query.run_id:
        case Some(id): id.value
        case None: ""
    val shape = SdnValue.Dict({
        "schema": SdnValue.String("simple.test.query-cursor/v1"),
        "path": SdnValue.String(query.case_key.path.value),
        "name": SdnValue.String(query.case_key.name.value),
        "run": SdnValue.String(run), "limit": SdnValue.Int(query.limit.value),
        "rows": SdnValue.String(sha256_text(labels.join(";")))})
    "tq1:" + sha256_text(sdn_encode_canonical(shape)) + ":"

fn _cursor_offset(cursor: TestQueryCursor, prefix: text, rows: [TestQueryRow], limit: i64) -> Result<i64, TestQueryError>:
    if not cursor.token.starts_with(prefix):
        return Err(_test_query_invalid("cursor is not a token for this query and result snapshot; restart without --cursor"))
    val digits = cursor.token.substring(prefix.byte_len(), cursor.token.byte_len())
    if digits == "" or digits.len() > 9:
        return Err(_test_query_invalid("cursor offset is malformed"))
    for ch in digits.chars():
        if not "0123456789".contains(ch):
            return Err(_test_query_invalid("cursor offset is malformed"))
    val offset = digits.to_int()
    if digits != offset.to_text() or offset == 0 or offset >= rows.len() or offset % limit != 0:
        return Err(_test_query_invalid("cursor is not a continuation page"))
    Ok(offset)

pub fn paginate_test_query_rows(rows: [TestQueryRow], query: TestQuery) -> Result<TestQueryPage, TestQueryError>:
    val limit = query.limit.value
    if limit < 1 or limit > TEST_QUERY_MAX_LIMIT:
        return Err(_test_query_invalid("limit must be between 1 and 1000"))
    val prefix = _cursor_prefix(rows, query)
    val start = match query.cursor:
        case Some(cursor): _cursor_offset(cursor, prefix, rows, limit)?
        case None: 0
    var end = start + limit
    var truncation = TestQueryTruncation.Complete
    if end < rows.len():
        truncation = TestQueryTruncation.Truncated(next: TestQueryCursor(token: prefix + end.to_text()))
    else:
        end = rows.len()
    var page: [TestQueryRow] = []
    var coverage = TestQueryCoverage.Full
    for i in start..end:
        page.push(rows[i])
        if _row_is_partial(rows[i]):
            coverage = TestQueryCoverage.Partial
    Ok(TestQueryPage(rows: page, truncation: truncation, coverage: coverage))
