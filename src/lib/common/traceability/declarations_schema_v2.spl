"""Whole-document preflight precedes indexes and all override semantics."""
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}
use std.common.traceability.declarations_types_v1.{TraceDeclarationsCodecLimitsV1}
use std.common.traceability.declarations_types_v2.*
use std.common.traceability.declarations_schema_v1.{trace_declarations_limits_valid_v1, trace_declarations_validate_v1}
use std.common.traceability.declarations_wire_v2.*
use std.common.traceability.codec_fields_v1.*
use std.common.traceability.codec_text_budget_v1.{TraceCodecTextBudgetV1}

fn trace_operation_relation_check_v2(item: text, path: text) -> Result<bool, TraceCodecIssueV1>:
    trace_codec_enum_check_v1(item, ["specifies", "decomposes_to", "accepted_by", "verified_by", "targets", "implemented_by", "motivated_by",
        "described_by", "belongs_to", "generated_from", "observed_in", "produced", "depends_on", "supersedes"], path)

pub fn trace_declarations_validate_v2(document: TraceDeclarationsV2, limits: TraceDeclarationsCodecLimitsV1, for_encoding: bool = false) -> Result<bool, TraceCodecIssueV1>:
    if not trace_declarations_limits_valid_v1(limits): return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits outside hard bounds"))
    val base = document.base
    val counts = [base.claims.len(), base.aliases.len(), base.exceptions.len(), base.origins.len(), document.explicit_links.len(), document.replacement_scopes.len()]
    val widths = [5, 4, 10, 7, 10, 4]
    var rows = 0
    var cells = 0
    var index = 0
    for count in counts:
        if count > limits.max_records - rows: return Err(trace_codec_issue_v1("record_limit", "", "Combined declaration records exceed budget"))
        rows = rows + count
        val charge = count * widths[index]
        if charge > limits.sdn.max_cells - cells: return Err(trace_codec_issue_v1("cell_limit", "", "Combined declaration cells exceed budget"))
        cells = cells + charge
        index = index + 1
    if rows > limits.sdn.max_rows: return Err(trace_codec_issue_v1("row_limit", "", "Combined declaration rows exceed budget"))
    if limits.sdn.max_nodes < 63 or cells > limits.sdn.max_nodes - 63: return Err(trace_codec_issue_v1("node_limit", "", "Combined declaration nodes exceed budget"))
    if limits.sdn.max_depth < 3: return Err(trace_codec_issue_v1("depth_limit", "", "Declarations require depth three"))
    if limits.sdn.max_columns < 10: return Err(trace_codec_issue_v1("column_limit", "", "Declaration tables require ten columns"))
    var budget = TraceCodecTextBudgetV1(max_field_bytes: limits.max_field_bytes, max_text_bytes: limits.max_text_bytes)
    budget.charge([base.id, base.namespace], "")?
    for item in base.claims: budget.charge([item.id, item.from_id, item.relation, item.to_id, item.origin_id], "claims")?
    for item in base.aliases: budget.charge([item.id, item.from_id, item.to_id, item.origin_id], "aliases")?
    for item in base.exceptions:
        budget.charge([item.id, item.scope_kind, item.subject_id, item.rule_id, item.reason, item.owner, item.review_state, item.expires_at, item.origin_id], "exceptions")?
    for item in base.origins: budget.charge([item.id, item.origin_kind, item.path, item.extractor_version], "origins")?
    for item in document.explicit_links: budget.charge(trace_link_fields_v2(item), "explicit_links")?
    for item in document.replacement_scopes: budget.charge(trace_replacement_fields_v2(item), "replacement_scopes")?
    val cap = if limits.max_output_bytes < limits.sdn.max_source_bytes: limits.max_output_bytes else: limits.sdn.max_source_bytes
    if for_encoding and trace_declarations_output_size_v2(document) > cap:
        return Err(trace_codec_issue_v1("output_limit", "", "Exact output exceeds budget before indexes or rows"))
    trace_declarations_validate_v1(base, limits)?
    var origins: Dict<text, bool> = {}
    for item in base.origins: origins[item.id] = true
    var exceptions: Dict<text, i64> = {}
    index = 0
    for item in base.exceptions:
        exceptions[item.id] = index
        index = index + 1
    var operations: Dict<text, i64> = {}
    index = 0
    for item in document.explicit_links:
        val path = "explicit_links." + index.to_text()
        trace_codec_id_check_v1(item.id, path + ".id")?
        if operations.contains_key(item.id): return Err(trace_codec_issue_v1("duplicate_identifier", path + ".id", "Duplicate operation identity"))
        operations[item.id] = index
        trace_codec_id_check_v1(item.owner, path + ".owner")?
        trace_codec_id_check_v1(item.from_id, path + ".from_id")?
        trace_codec_id_check_v1(item.to_id, path + ".to_id")?
        trace_operation_relation_check_v2(item.relation, path + ".relation")?
        trace_codec_enum_check_v1(item.operation, ["add", "replace", "suppress"], path + ".operation")?
        if item.reason == "": return Err(trace_codec_issue_v1("empty_text", path + ".reason", "Operation reason required"))
        if not origins.contains_key(item.origin_id): return Err(trace_codec_issue_v1("missing_reference", path + ".origin_id", "Operation origin is absent"))
        if item.operation == "add":
            if item.replaces_rule != "" or item.exception_id != "": return Err(trace_codec_issue_v1("invalid_operation", path, "Add cannot replace or suppress a rule"))
        else:
            trace_codec_id_check_v1(item.replaces_rule, path + ".replaces_rule")?
            trace_codec_id_check_v1(item.exception_id, path + ".exception_id")?
            if not exceptions.contains_key(item.exception_id): return Err(trace_codec_issue_v1("missing_reference", path + ".exception_id", "Applicability exception is absent"))
            val exception = base.exceptions[exceptions[item.exception_id]]
            if exception.rule_id != item.replaces_rule: return Err(trace_codec_issue_v1("invalid_override", path + ".replaces_rule", "Exception names a different rule"))
        index = index + 1
    var scopes: Dict<text, bool> = {}
    index = 0
    for item in document.replacement_scopes:
        val path = "replacement_scopes." + index.to_text()
        trace_codec_id_check_v1(item.operation_id, path + ".operation_id")?
        if scopes.contains_key(item.operation_id): return Err(trace_codec_issue_v1("duplicate_identifier", path + ".operation_id", "Duplicate original operation scope"))
        scopes[item.operation_id] = true
        trace_codec_id_check_v1(item.from_id, path + ".from_id")?
        trace_codec_id_check_v1(item.to_id, path + ".to_id")?
        trace_operation_relation_check_v2(item.relation, path + ".relation")?
        if not operations.contains_key(item.operation_id): return Err(trace_codec_issue_v1("missing_reference", path + ".operation_id", "Scoped operation is absent"))
        if document.explicit_links[operations[item.operation_id]].operation != "replace":
            return Err(trace_codec_issue_v1("invalid_operation", path + ".operation_id", "Only replacement has a separate original scope"))
        index = index + 1
    for item in document.explicit_links:
        if item.operation == "replace" and not scopes.contains_key(item.id): return Err(trace_codec_issue_v1("missing_reference", "replacement_scopes", "Replacement requires an exact original tuple"))
    Ok(true)

export trace_declarations_validate_v2
