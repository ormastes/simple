"""Explicit operations are authored data; resolution owns applicability."""
use std.common.traceability.declarations_types_v1.{TraceDeclarationsV1}

pub struct TraceExplicitLinkV2:
    id: text
    owner: text
    from_id: text
    relation: text
    to_id: text
    operation: text
    replaces_rule: text
    reason: text
    origin_id: text
    exception_id: text

pub struct TraceReplacementScopeV2:
    operation_id: text
    from_id: text
    relation: text
    to_id: text

pub struct TraceDeclarationsV2:
    base: TraceDeclarationsV1
    explicit_links: [TraceExplicitLinkV2]
    replacement_scopes: [TraceReplacementScopeV2]

export TraceExplicitLinkV2, TraceReplacementScopeV2, TraceDeclarationsV2
