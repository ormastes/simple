# Dependency-complete invalidation planning. The extractor/store owns facts;
# this pure planner never substitutes changed paths for the existence universe.
# @req REQ-TRC-017

pub enum TraceDependencyKind:
    Artifact
    ExistingIdentity
    MissingIdentity
    UniqueIdentity
    Membership
    Configuration

pub struct TraceDependency:
    owner_path: text
    kind: TraceDependencyKind
    key: text

pub struct TraceInvalidationInput:
    known_paths: [text]
    changed_paths: [text]
    changed_identities: [text]
    changed_memberships: [text]
    changed_configurations: [text]
    dependencies: [TraceDependency]
    dependency_inventory_complete: bool
    policy_changed: bool
    extractor_changed: bool
    schema_changed: bool
    max_affected: i64

pub struct TraceInvalidation:
    affected_paths: [text]
    full_rebuild: bool
    complete: bool
    reasons: [text]

fn trace_changed_key(dependency: TraceDependency, input: TraceInvalidationInput, affected: [text]) -> bool:
    match dependency.kind:
        case TraceDependencyKind.Artifact:
            affected.contains(dependency.key)
        case TraceDependencyKind.ExistingIdentity:
            input.changed_identities.contains(dependency.key)
        case TraceDependencyKind.MissingIdentity:
            input.changed_identities.contains(dependency.key)
        case TraceDependencyKind.UniqueIdentity:
            input.changed_identities.contains(dependency.key)
        case TraceDependencyKind.Membership:
            input.changed_memberships.contains(dependency.key)
        case TraceDependencyKind.Configuration:
            input.changed_configurations.contains(dependency.key)

# Return a sound scope, or an explicit incomplete plan. Caller must rebuild
# when full_rebuild is set; that flag never claims a rebuild already happened.
pub fn plan_trace_invalidation(input: TraceInvalidationInput) -> TraceInvalidation:
    var affected: [text] = []
    var reasons: [text] = []
    if input.max_affected < 1:
        return TraceInvalidation(affected_paths: [], full_rebuild: true, complete: false,
            reasons: ["invalid invalidation budget"])
    val full = input.policy_changed or input.extractor_changed or input.schema_changed or not input.dependency_inventory_complete
    if input.policy_changed:
        reasons.push("policy identity changed")
    if input.extractor_changed:
        reasons.push("extractor identity changed")
    if input.schema_changed:
        reasons.push("schema identity changed")
    if not input.dependency_inventory_complete:
        reasons.push("dependency inventory incomplete; incremental reuse refused")
    var seeds = input.changed_paths
    if full:
        seeds = input.known_paths + input.changed_paths
    for path in seeds:
        if path == "":
            return TraceInvalidation(affected_paths: affected, full_rebuild: true, complete: false,
                reasons: ["empty artifact identity in changed or known path set"])
        if not affected.contains(path):
            if affected.len() >= input.max_affected:
                reasons.push("affected scope budget exhausted")
                return TraceInvalidation(affected_paths: affected, full_rebuild: full, complete: false, reasons: reasons)
            affected.push(path)
    # Each accepted owner adds at most one known/new artifact. Fixed point is
    # finite; a cycle does not cause repeated invalidation or an endless loop.
    var added = true
    while added:
        added = false
        for dependency in input.dependencies:
            if dependency.owner_path == "" or dependency.key == "":
                reasons.push("invalid dependency record; full rebuild required")
                return TraceInvalidation(affected_paths: affected, full_rebuild: true, complete: false, reasons: reasons)
            if not input.known_paths.contains(dependency.owner_path):
                reasons.push("dependency owner absent from base inventory")
                return TraceInvalidation(affected_paths: affected, full_rebuild: true, complete: false, reasons: reasons)
            if not affected.contains(dependency.owner_path) and trace_changed_key(dependency, input, affected):
                if affected.len() >= input.max_affected:
                    reasons.push("reverse dependency closure budget exhausted")
                    return TraceInvalidation(affected_paths: affected, full_rebuild: full, complete: false, reasons: reasons)
                affected.push(dependency.owner_path)
                added = true
    if affected.len() == 0:
        reasons.push("complete classifier found no affected facts")
    TraceInvalidation(affected_paths: affected, full_rebuild: full, complete: true, reasons: reasons)
