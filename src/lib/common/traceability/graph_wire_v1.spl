"""Graph-owned table layout with shared SDN scalar escaping."""
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical, sdn_encoded_text_size_v1}
use std.common.traceability.graph_types_v1.*

pub fn trace_graph_headers_v1(section: text) -> [text]:
    match section:
        case "inputs": ["path", "sha256", "bytes", "role"]
        case "nodes": ["id", "kind", "title"]
        case "test_definitions": ["entity_id", "test_kind", "identity_scope", "definition_id", "parameter_digest_available", "parameter_digest"]
        case "edges": ["id", "from_id", "relation", "to_id"]
        case "edge_origins": ["edge_id", "origin_kind", "origin_id", "declaration_path_available", "declaration_path", "span_available", "line", "column", "extractor_version"]
        case "locators": ["entity_id", "path_available", "path", "locator_kind", "locator"]
        case _: []

pub fn trace_graph_input_row_v1(item: TraceGraphInputV1) -> [SdnValue]:
    [SdnValue.String(item.path), SdnValue.String(item.sha256), SdnValue.Int(item.bytes), SdnValue.String(item.role)]

pub fn trace_graph_node_row_v1(item: TraceGraphNodeV1) -> [SdnValue]:
    [SdnValue.String(item.id), SdnValue.String(item.kind), SdnValue.String(item.title)]

pub fn trace_graph_test_row_v1(item: TraceGraphTestDefinitionV1) -> [SdnValue]:
    [SdnValue.String(item.entity_id), SdnValue.String(item.test_kind), SdnValue.String(item.identity_scope),
        SdnValue.String(item.definition_id), SdnValue.Bool(item.parameter_digest_available), SdnValue.String(item.parameter_digest)]

pub fn trace_graph_edge_row_v1(item: TraceGraphEdgeV1) -> [SdnValue]:
    [SdnValue.String(item.id), SdnValue.String(item.from_id), SdnValue.String(item.relation), SdnValue.String(item.to_id)]

pub fn trace_graph_origin_row_v1(item: TraceGraphOriginV1) -> [SdnValue]:
    [SdnValue.String(item.edge_id), SdnValue.String(item.origin_kind), SdnValue.String(item.origin_id),
        SdnValue.Bool(item.declaration_path_available), SdnValue.String(item.declaration_path),
        SdnValue.Bool(item.span_available), SdnValue.Int(item.line), SdnValue.Int(item.column), SdnValue.String(item.extractor_version)]

pub fn trace_graph_locator_row_v1(item: TraceGraphLocatorV1) -> [SdnValue]:
    [SdnValue.String(item.entity_id), SdnValue.Bool(item.path_available), SdnValue.String(item.path),
        SdnValue.String(item.locator_kind), SdnValue.String(item.locator)]

pub fn trace_graph_envelope_v1(document: TraceGraphV1) -> text:
    val snapshot = SdnValue.Dict({"id": SdnValue.String(document.snapshot.id),
        "kind": SdnValue.String(document.snapshot.kind), "complete": SdnValue.Bool(document.snapshot.complete)})
    val manifest = SdnValue.Dict({"input_set_id": SdnValue.String(document.manifest.input_set_id),
        "extractor_version": SdnValue.String(document.manifest.extractor_version), "rules_version": SdnValue.String(document.manifest.rules_version),
        "policy_id": SdnValue.String(document.manifest.policy_id), "complete": SdnValue.Bool(document.manifest.complete)})
    "schema: {name: simple.trace.graph, version: 1}\nsnapshot: " + sdn_encode_canonical(snapshot) +
        "\nmanifest: " + sdn_encode_canonical(manifest) + "\n"

pub fn trace_graph_envelope_size_v1(document: TraceGraphV1) -> i64:
    # Fixed names, punctuation and line endings; booleans and text are exact.
    val fixed = "schema: {name: simple.trace.graph, version: 1}\nsnapshot: {complete: , id: , kind: }\nmanifest: {complete: , extractor_version: , input_set_id: , policy_id: , rules_version: }\n"
    var size = fixed.len() + (if document.snapshot.complete: 4 else: 5) + (if document.manifest.complete: 4 else: 5)
    for item in [document.snapshot.id, document.snapshot.kind, document.manifest.extractor_version,
        document.manifest.input_set_id, document.manifest.policy_id, document.manifest.rules_version]:
        size = size + sdn_encoded_text_size_v1(item)
    size

fn trace_graph_text_sizes_v1(fields: [text]) -> i64:
    var size = 0
    for item in fields: size = size + sdn_encoded_text_size_v1(item)
    size

pub fn trace_graph_output_size_v1(document: TraceGraphV1) -> i64:
    # Caller first enforces hard record/text limits. Consequently the sum is
    # bounded below 128MiB, far below i64 overflow. No SDN row/key is allocated.
    var size = trace_graph_envelope_size_v1(document)
    for section in ["inputs", "nodes", "test_definitions", "edges", "edge_origins", "locators"]:
        size = size + section.len() + 4 + trace_graph_headers_v1(section).join(", ").len()
    for item in document.inputs:
        size = size + 11 + trace_graph_text_sizes_v1([item.path, item.sha256, item.role]) + item.bytes.to_text().len()
    for item in document.nodes:
        size = size + 9 + trace_graph_text_sizes_v1([item.id, item.kind, item.title])
    for item in document.test_definitions:
        size = size + 15 + trace_graph_text_sizes_v1([item.entity_id, item.test_kind, item.identity_scope, item.definition_id, item.parameter_digest]) + (if item.parameter_digest_available: 4 else: 5)
    for item in document.edges:
        size = size + 11 + trace_graph_text_sizes_v1([item.id, item.from_id, item.relation, item.to_id])
    for item in document.edge_origins:
        size = size + 21 + trace_graph_text_sizes_v1([item.edge_id, item.origin_kind, item.origin_id, item.declaration_path, item.extractor_version]) +
            (if item.declaration_path_available: 4 else: 5) + (if item.span_available: 4 else: 5) + item.line.to_text().len() + item.column.to_text().len()
    for item in document.locators:
        size = size + 13 + trace_graph_text_sizes_v1([item.entity_id, item.path, item.locator_kind, item.locator]) + (if item.path_available: 4 else: 5)
    size

pub fn trace_graph_row_size_v1(row: [SdnValue]) -> i64:
    var size = 5 + 2 * (row.len() - 1)
    for cell in row:
        match cell:
            case String(item): size = size + sdn_encoded_text_size_v1(item)
            case Bool(item): size = size + (if item: 4 else: 5)
            case Int(item): size = size + item.to_text().len()
            case _: size = size + sdn_encode_canonical(cell).len()
    size

pub fn trace_graph_tuple_key_v1(fields: [text]) -> text:
    # Length prefixes are unambiguous even when UTF8 paths contain delimiters.
    var parts: [text] = []
    for field in fields: parts.push(field.len().to_text() + ":" + field)
    parts.join("")

export trace_graph_headers_v1, trace_graph_input_row_v1, trace_graph_node_row_v1
export trace_graph_test_row_v1, trace_graph_edge_row_v1, trace_graph_origin_row_v1
export trace_graph_locator_row_v1, trace_graph_envelope_v1, trace_graph_row_size_v1, trace_graph_tuple_key_v1
export trace_graph_envelope_size_v1
export trace_graph_output_size_v1
