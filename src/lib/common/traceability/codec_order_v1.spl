"""Stable full-record byte ordering for bounded table families."""
fn trace_codec_byte_lt_v1(left: text, right: text) -> bool:
    var index = 0
    while index < left.len() and index < right.len():
        val a = left.byte_at(index)
        val b = right.byte_at(index)
        if a < b: return true
        if a > b: return false
        index = index + 1
    left.len() < right.len()

pub fn trace_codec_row_order_v1(keys: [text]) -> [i64]:
    val count = keys.len()
    var order: [i64] = [0; count]
    var scratch: [i64] = [0; count]
    var index = 0
    while index < count:
        order[index] = index
        index = index + 1
    var width = 1
    while width < count:
        var start = 0
        while start < count:
            val middle = if start + width < count: start + width else: count
            val end = if middle + width < count: middle + width else: count
            var left = start
            var right = middle
            var target = start
            while target < end:
                if right >= end or (left < middle and not trace_codec_byte_lt_v1(keys[order[right]], keys[order[left]])):
                    scratch[target] = order[left]
                    left = left + 1
                else:
                    scratch[target] = order[right]
                    right = right + 1
                target = target + 1
            start = end
        index = 0
        while index < count:
            order[index] = scratch[index]
            index = index + 1
        width = width * 2
    order

export trace_codec_row_order_v1
