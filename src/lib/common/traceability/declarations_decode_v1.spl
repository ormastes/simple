"""Strict authored-intent decoding; all claimed review/provenance remains data."""
use std.common.sdn.value.{SdnValue}
use std.common.sdn.strict_v1.{sdn_parse_strict_v1}
use std.common.sdn.value_limits_v1.{sdn_validate_value_limits_v1}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}
use std.common.traceability.codec_fields_v1.*
use std.common.traceability.declarations_types_v1.*
use std.common.traceability.declarations_wire_v1.{trace_declarations_headers_v1}
use std.common.traceability.declarations_schema_v1.{trace_declarations_limits_valid_v1, trace_declarations_validate_v1}

pub fn trace_declarations_from_value_v1(value: SdnValue, limits: TraceDeclarationsCodecLimitsV1) -> Result<TraceDeclarationsV1, TraceCodecIssueV1>:
    if not trace_declarations_limits_valid_v1(limits): return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits outside hard bounds"))
    match sdn_validate_value_limits_v1(value, limits.sdn):
        case Ok(_): ()
        case Err(issue): return Err(trace_codec_issue_v1(issue.code, "", issue.message))
    var envelope: Dict<text, SdnValue> = {}
    match value:
        case Dict(fields): envelope = fields
        case _: return Err(trace_codec_issue_v1("wrong_type", "", "Expected declaration dictionary"))
    if not envelope.contains_key("schema"): return Err(trace_codec_issue_v1("missing_field", "schema", "Missing schema declaration"))
    val schema = trace_codec_dict_v1(envelope["schema"], "schema", ["name", "version"])?
    if trace_codec_text_v1(schema["name"], "schema.name")? != "simple.trace.declarations":
        return Err(trace_codec_issue_v1("unsupported_family", "schema.name", "Declaration family required"))
    if trace_codec_int_v1(schema["version"], "schema.version")? != 1:
        return Err(trace_codec_issue_v1("schema_version", "schema.version", "Unsupported declaration major"))
    val root = trace_codec_dict_v1(value, "", ["schema", "id", "namespace", "claims", "aliases", "exceptions", "origins"])?
    var count = 0
    for section in ["claims", "aliases", "exceptions", "origins"]:
        match root[section]:
            case Table(_, rows):
                if rows.len() > limits.max_records - count: return Err(trace_codec_issue_v1("record_limit", section, "Declaration records exceed budget"))
                count = count + rows.len()
            case _: return Err(trace_codec_issue_v1("wrong_type", section, "Named table required"))
    val identity = trace_codec_text_v1(root["id"], "id")?
    val namespace = trace_codec_text_v1(root["namespace"], "namespace")?
    var claims: [TraceClaimV1] = []
    var index = 0
    for row in trace_codec_table_v1(root["claims"], "claims", trace_declarations_headers_v1("claims"))?:
        val path = "claims." + index.to_text()
        claims.push(TraceClaimV1(id: trace_codec_text_v1(row[0], path + ".id")?, from_id: trace_codec_text_v1(row[1], path + ".from_id")?,
            relation: trace_codec_text_v1(row[2], path + ".relation")?, to_id: trace_codec_text_v1(row[3], path + ".to_id")?, origin_id: trace_codec_text_v1(row[4], path + ".origin_id")?))
        index = index + 1
    var aliases: [TraceAliasDeclarationV1] = []
    index = 0
    for row in trace_codec_table_v1(root["aliases"], "aliases", trace_declarations_headers_v1("aliases"))?:
        val path = "aliases." + index.to_text()
        aliases.push(TraceAliasDeclarationV1(id: trace_codec_text_v1(row[0], path + ".id")?, from_id: trace_codec_text_v1(row[1], path + ".from_id")?,
            to_id: trace_codec_text_v1(row[2], path + ".to_id")?, origin_id: trace_codec_text_v1(row[3], path + ".origin_id")?))
        index = index + 1
    var exceptions: [TraceExceptionDeclarationV1] = []
    index = 0
    for row in trace_codec_table_v1(root["exceptions"], "exceptions", trace_declarations_headers_v1("exceptions"))?:
        val path = "exceptions." + index.to_text()
        exceptions.push(TraceExceptionDeclarationV1(id: trace_codec_text_v1(row[0], path + ".id")?, scope_kind: trace_codec_text_v1(row[1], path + ".scope_kind")?,
            subject_id: trace_codec_text_v1(row[2], path + ".subject_id")?, rule_id: trace_codec_text_v1(row[3], path + ".rule_id")?, reason: trace_codec_text_v1(row[4], path + ".reason")?,
            owner: trace_codec_text_v1(row[5], path + ".owner")?, review_state: trace_codec_text_v1(row[6], path + ".review_state")?,
            expires_available: trace_codec_bool_v1(row[7], path + ".expires_available")?, expires_at: trace_codec_text_v1(row[8], path + ".expires_at")?, origin_id: trace_codec_text_v1(row[9], path + ".origin_id")?))
        index = index + 1
    var origins: [TraceDeclarationOriginV1] = []
    index = 0
    for row in trace_codec_table_v1(root["origins"], "origins", trace_declarations_headers_v1("origins"))?:
        val path = "origins." + index.to_text()
        origins.push(TraceDeclarationOriginV1(id: trace_codec_text_v1(row[0], path + ".id")?, origin_kind: trace_codec_text_v1(row[1], path + ".origin_kind")?,
            path: trace_codec_text_v1(row[2], path + ".path")?, span_available: trace_codec_bool_v1(row[3], path + ".span_available")?,
            line: trace_codec_int_v1(row[4], path + ".line")?, column: trace_codec_int_v1(row[5], path + ".column")?, extractor_version: trace_codec_text_v1(row[6], path + ".extractor_version")?))
        index = index + 1
    val document = TraceDeclarationsV1(id: identity, namespace: namespace, claims: claims, aliases: aliases, exceptions: exceptions, origins: origins)
    trace_declarations_validate_v1(document, limits)?
    Ok(document)

pub fn trace_declarations_decode_v1(source: text, limits: TraceDeclarationsCodecLimitsV1) -> Result<TraceDeclarationsV1, TraceCodecIssueV1>:
    if not trace_declarations_limits_valid_v1(limits): return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits outside hard bounds"))
    match sdn_parse_strict_v1(source, limits.sdn):
        case Ok(parsed): trace_declarations_from_value_v1(parsed.value, limits)
        case Err(issue):
            val located = issue.code != "invalid_limits" and issue.code != "source_limit"
            Err(TraceCodecIssueV1(code: issue.code, path: "", message: issue.message,
                location_available: located, offset: issue.offset, line: if located: issue.line else: 0, column: if located: issue.column else: 0))

export trace_declarations_from_value_v1, trace_declarations_decode_v1
