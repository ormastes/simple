# One graph resolver for CLI, reports and viewer; all effects stay in adapters.
# @req REQ-TRC-002 REQ-TRC-004 REQ-TRC-005 REQ-TRC-006 REQ-TRC-019
use std.common.traceability.model.*
use std.common.traceability.schema.*
use std.common.traceability.conventions.*

fn graph_from_facts(facts: TraceFacts, edges: [TraceEdge], bindings: [TraceEdgeOrigin], diagnostics: [TraceDiagnostic], complete: bool) -> TraceGraph:
    TraceGraph(subject: facts.subject, input_manifest_id: facts.input_manifest_id, nodes: facts.nodes, test_definitions: facts.test_definitions, claims: facts.claims, edges: edges, edge_origins: bindings, origins: facts.origins, locators: facts.locators, diagnostics: diagnostics, generation_id: facts.generation_id, complete: complete)

fn claim_authorized(claim: TraceClaim, origin: TraceOrigin, policy: TracePolicy, snapshot_id: text) -> bool:
    var matches = 0
    for authority in policy.authorities:
        if authority.origin_id != claim.origin_id or authority.owner_path != origin.owner_path or authority.relation != claim.relation or authority.scope_id != claim.scope_id:
            continue
        if authority.expires_snapshot_id != "" and authority.expires_snapshot_id != snapshot_id:
            continue
        if claim.operation != TraceClaimOperation.Add:
            if not authority.allow_override or authority.review_id == "" or authority.reason == "":
                continue
        matches = matches + 1
    matches == 1

fn origin_relation_allowed(origin: TraceOrigin, relation: TraceRelation) -> bool:
    if origin.kind == TraceOriginKind.Convention:
        return relation == TraceRelation.Targets or relation == TraceRelation.GeneratedFrom
    if origin.kind == TraceOriginKind.RuntimeObservation:
        return relation == TraceRelation.ObservedIn or relation == TraceRelation.Produced
    if relation == TraceRelation.ObservedIn or relation == TraceRelation.Produced:
        return false
    if origin.kind == TraceOriginKind.CompilerIndex:
        return relation == TraceRelation.DependsOn or relation == TraceRelation.BelongsTo or relation == TraceRelation.Contains
    true

fn acyclic(relation: TraceRelation) -> bool:
    relation == TraceRelation.Contains or relation == TraceRelation.Aliases or relation == TraceRelation.Supersedes

# Search is bounded by graph vertices. Dependency cycles remain legal.
fn reaches(adjacency: Dict<text, [text]>, source: text, target: text) -> bool:
    var pending = [source]
    var seen: Dict<text, bool> = {}
    var cursor = 0
    while cursor < pending.len():
        val current = pending[cursor]
        cursor = cursor + 1
        if current == target:
            return true
        if seen.contains_key(current):
            continue
        seen[current] = true
        if adjacency.contains_key(current):
            for next_id in adjacency[current]:
                if not seen.contains_key(next_id):
                    pending.push(next_id)
    false

pub fn resolve_trace_graph(input: TraceFacts, policy: TracePolicy) -> TraceGraph:
    var diagnostics = input.diagnostics
    if not trace_id_valid(policy.id) or policy.max_nodes <= 0 or policy.max_claims <= 0:
        diagnostics.push(trace_diagnostic("TRACE-SDN-SCHEMA", input.subject.snapshot_id, policy.id, "", "", "policy identity and positive graph limits required"))
        return graph_from_facts(input, [], [], diagnostics, false)
    if input.nodes.len() > policy.max_nodes or input.claims.len() > policy.max_claims:
        diagnostics.push(trace_diagnostic("TRACE-SNAPSHOT-INCOMPLETE", input.subject.snapshot_id, policy.id, "", "", "graph input exceeds policy limit; no truncated qualification"))
        return graph_from_facts(input, [], [], diagnostics, false)
    val raw = graph_from_facts(input, [], [], [], false)
    val invalid = validate_trace_graph(raw)
    if invalid.len() > 0:
        for issue in invalid:
            diagnostics.push(issue)
        return graph_from_facts(input, [], [], diagnostics, false)
    var origin_map: Dict<text, TraceOrigin> = {}
    var node_map: Dict<text, TraceNodeKind> = {}
    var test_roles: Dict<text, bool> = {}
    for definition in input.test_definitions:
        test_roles[definition.node_id + "|" + test_kind_name(definition.kind)] = true
    for node in input.nodes:
        node_map[node.id] = node.kind
    for origin in input.origins:
        origin_map[origin.id] = origin
        if origin.kind == TraceOriginKind.Convention:
            diagnostics.push(trace_diagnostic("TRACE-AUTHORITY-CONFLICT", input.subject.snapshot_id, policy.id, origin.id, origin.id, "authored facts cannot impersonate a derived convention origin"))
            return graph_from_facts(input, [], [], diagnostics, false)
    var admitted: Dict<text, bool> = {}
    var overrides: Dict<text, [text]> = {}
    for claim in input.claims:
        val origin = origin_map[claim.origin_id]
        var valid = claim_authorized(claim, origin, policy, input.subject.snapshot_id) and origin_relation_allowed(origin, claim.relation)
        if origin.kind == TraceOriginKind.Convention:
            valid = false
        if not valid:
            diagnostics.push(trace_diagnostic("TRACE-AUTHORITY-CONFLICT", input.subject.snapshot_id, claim.rule_id, claim.id, claim.origin_id, "claim lacks unique registered authority or origin permits no such relation"))
            continue
        if claim.operation != TraceClaimOperation.Add:
            var matched = 0
            for rule in policy.conventions:
                if rule.id == claim.rule_id and rule.relation == claim.relation and convention_scope_applies(input, rule, claim.scope_id):
                    matched = matched + 1
            if matched != 1:
                diagnostics.push(trace_diagnostic("TRACE-STALE-OVERRIDE", input.subject.snapshot_id, claim.rule_id, claim.id, claim.origin_id, "override must match exactly one current mapping rule and source scope"))
                continue
            if claim.operation == TraceClaimOperation.Replace and claim.to_id != claim.scope_id:
                diagnostics.push(trace_diagnostic("TRACE-STALE-OVERRIDE", input.subject.snapshot_id, claim.rule_id, claim.id, claim.origin_id, "replacement endpoint must retain the named original source scope"))
                continue
            if claim.operation == TraceClaimOperation.Suppress and (claim.from_id != claim.scope_id or claim.to_id != ""):
                diagnostics.push(trace_diagnostic("TRACE-STALE-OVERRIDE", input.subject.snapshot_id, claim.rule_id, claim.id, claim.origin_id, "suppression must name the source scope and no replacement endpoint"))
                continue
            val key = claim.rule_id + "|" + claim.scope_id
            var group: [text] = []
            if overrides.contains_key(key):
                group = overrides[key]
            group.push(claim.id)
            overrides[key] = group
        admitted[claim.id] = true
    for key in overrides.keys():
        if overrides[key].len() > 1:
            for claim_id in overrides[key]:
                admitted[claim_id] = false
            diagnostics.push(trace_diagnostic("TRACE-AUTHORITY-CONFLICT", input.subject.snapshot_id, policy.id, key, "", "competing overrides for the same rule and scope"))
    val derived = derive_conventional_facts(input, policy.conventions)
    val derived_issues = validate_trace_graph(graph_from_facts(derived, [], [], [], false))
    if derived_issues.len() > 0:
        for issue in derived_issues:
            diagnostics.push(issue)
        return graph_from_facts(derived, [], [], diagnostics, false)
    for origin in derived.origins:
        origin_map[origin.id] = origin
    var active_overrides: Dict<text, bool> = {}
    for claim in input.claims:
        if claim.operation != TraceClaimOperation.Add and admitted.contains_key(claim.id) and admitted[claim.id]:
            active_overrides[claim.rule_id + "|" + claim.scope_id] = true
    # Mapping absence/ambiguity may be explicitly replaced or suppressed. The
    # claim, its authority and review remain in the graph; it grants no pass.
    for issue in derived.diagnostics.slice(input.diagnostics.len(), derived.diagnostics.len()):
        val key = issue.rule_id + "|" + issue.entity_id
        val mapping_issue = issue.code == "TRACE-MISSING-ENDPOINT" or issue.code == "TRACE-AMBIGUOUS-MAPPING"
        if not mapping_issue or not active_overrides.contains_key(key):
            diagnostics.push(issue)
    if derived.claims.len() > policy.max_claims:
        diagnostics.push(trace_diagnostic("TRACE-SNAPSHOT-INCOMPLETE", input.subject.snapshot_id, policy.id, "", "", "derived claims exceed policy limit"))
        return graph_from_facts(derived, [], [], diagnostics, false)
    var selected: Dict<text, TraceClaim> = {}
    for claim in derived.claims:
        val origin = origin_map[claim.origin_id]
        if origin.kind == TraceOriginKind.Convention:
            if active_overrides.contains_key(claim.rule_id + "|" + claim.scope_id):
                continue
        elif not admitted.contains_key(claim.id) or not admitted[claim.id]:
            continue
        if claim.operation == TraceClaimOperation.Suppress:
            continue
        if not node_map.contains_key(claim.from_id) or not node_map.contains_key(claim.to_id):
            diagnostics.push(trace_diagnostic("TRACE-MISSING-ENDPOINT", input.subject.snapshot_id, claim.rule_id, claim.id, claim.origin_id, "claim endpoint does not exist in this snapshot"))
            continue
        if not trace_endpoint_kinds_valid(claim.relation, node_map[claim.from_id], node_map[claim.to_id]):
            diagnostics.push(trace_diagnostic("TRACE-SDN-SCHEMA", input.subject.snapshot_id, claim.rule_id, claim.id, claim.origin_id, "claim relation has incompatible endpoint kinds"))
            continue
        if not trace_relation_test_role_valid(claim.relation, claim.to_id, test_roles):
            diagnostics.push(trace_diagnostic("TRACE-SDN-SCHEMA", input.subject.snapshot_id, claim.rule_id, claim.id, claim.origin_id, "test association lacks a declared acceptance/supporting role"))
            continue
        selected[claim.id] = claim
    var canonical: Dict<text, TraceEdge> = {}
    var bindings: Dict<text, TraceEdgeOrigin> = {}
    var single_targets: Dict<text, text> = {}
    var conflicting: Dict<text, bool> = {}
    for claim_id in trace_sorted_ids(selected.keys()):
        val claim = selected[claim_id]
        if claim.relation == TraceRelation.Aliases:
            val key = claim.from_id + "|aliases"
            if single_targets.contains_key(key) and single_targets[key] != claim.to_id:
                conflicting[key] = true
                diagnostics.push(trace_diagnostic("TRACE-AUTHORITY-CONFLICT", input.subject.snapshot_id, claim.rule_id, claim.from_id, claim.origin_id, "alias has competing canonical targets"))
            single_targets[key] = claim.to_id
        val id = trace_edge_id(claim.from_id, claim.relation, claim.to_id)
        canonical[id] = TraceEdge(id: id, from_id: claim.from_id, relation: claim.relation, to_id: claim.to_id)
        bindings[id + "|" + claim.origin_id] = TraceEdgeOrigin(edge_id: id, origin_id: claim.origin_id)
    var edges: [TraceEdge] = []
    var kept: Dict<text, bool> = {}
    var cycle_adjacency: Dict<text, [text]> = {}
    for id in trace_sorted_ids(canonical.keys()):
        val edge = canonical[id]
        if edge.relation == TraceRelation.Aliases and conflicting.contains_key(edge.from_id + "|aliases"):
            continue
        if acyclic(edge.relation):
            val source = relation_name(edge.relation) + "|" + edge.from_id
            val target = relation_name(edge.relation) + "|" + edge.to_id
            if reaches(cycle_adjacency, target, source):
                diagnostics.push(trace_diagnostic("TRACE-FORBIDDEN-CYCLE", input.subject.snapshot_id, policy.id, edge.id, "", "cycle in containment or identity continuity"))
                continue
            var next_ids: [text] = []
            if cycle_adjacency.contains_key(source):
                next_ids = cycle_adjacency[source]
            next_ids.push(target)
            cycle_adjacency[source] = next_ids
        edges.push(edge)
        kept[id] = true
    var origins: [TraceEdgeOrigin] = []
    for key in trace_sorted_ids(bindings.keys()):
        val binding = bindings[key]
        if kept.contains_key(binding.edge_id):
            origins.push(binding)
    var complete = input.complete
    for issue in diagnostics:
        if issue.severity == "error":
            complete = false
    if not input.complete:
        diagnostics.push(trace_diagnostic("TRACE-SNAPSHOT-INCOMPLETE", input.subject.snapshot_id, policy.id, "", "", "input inventory is incomplete"))
    graph_from_facts(derived, edges, origins, diagnostics, complete)
