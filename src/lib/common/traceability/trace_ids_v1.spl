"""Validated trace identifiers. Parsers in schema.spl are the only producers."""

pub struct TraceEntityIdV1:
    value: text

pub struct TracePathV1:
    value: text

pub struct TraceEdgeIdV1:
    value: text

pub struct TraceOriginIdV1:
    value: text

pub enum TraceTestRoleMarkV1:
    Present

pub struct TraceResultCountV1:
    value: i64

pub struct TraceSnapshotIdV1:
    value: text

pub struct TraceCursorV1:
    value: text

pub enum TracePageCompletenessV1:
    Complete
    Partial

export TraceSnapshotIdV1, TraceResultCountV1, TraceCursorV1, TracePageCompletenessV1, TraceTestRoleMarkV1, TraceEntityIdV1, TracePathV1, TraceEdgeIdV1, TraceOriginIdV1
