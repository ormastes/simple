# Reversible, CSV-safe scalar transport for opaque trace SDN text.
# Versioned column migration: new trace-owned fields store this `trace-utf8-hex/v1:`
# scalar; readers decode only this prefix. Existing database rows and generic
# SdnTable serialization remain untouched. Owner code must encode on write and
# decode on read for every punctuation-bearing trace field (including event
# IDs, paths, and names), and may not treat an unprefixed legacy value as v1.
# @req REQ-TRC-001 REQ-TRC-018
use std.common.text_bytes.{text_to_utf8_bytes, bytes_to_text}

val TRACE_STORAGE_SCALAR_PREFIX: text = "trace-utf8-hex/v1:"
val TRACE_STORAGE_SCALAR_MAX_BYTES: i64 = 1048576

fn _trace_storage_hex_digit(value: i64) -> text:
    "0123456789ABCDEF"[value]

fn _trace_storage_hex_value(ch: text) -> i64:
    "0123456789ABCDEF".index_of(ch)

pub fn encode_trace_storage_scalar(value: text) -> Result<text, text>:
    val bytes = text_to_utf8_bytes(value)
    if bytes.len() > TRACE_STORAGE_SCALAR_MAX_BYTES:
        return Err("trace storage scalar exceeds 1 MiB UTF-8 bound")
    var encoded_bytes: [text] = []
    for byte in bytes:
        val n = byte as i64
        encoded_bytes.push(_trace_storage_hex_digit(n / 16))
        encoded_bytes.push(_trace_storage_hex_digit(n % 16))
    Ok(TRACE_STORAGE_SCALAR_PREFIX + encoded_bytes.join(""))

pub fn decode_trace_storage_scalar(source: text) -> Result<text, text>:
    if source.len() > TRACE_STORAGE_SCALAR_PREFIX.len() + TRACE_STORAGE_SCALAR_MAX_BYTES * 2:
        return Err("trace storage scalar exceeds 1 MiB UTF-8 bound")
    if not source.starts_with(TRACE_STORAGE_SCALAR_PREFIX):
        return Err("unsupported trace storage scalar version")
    val payload = source.slice(TRACE_STORAGE_SCALAR_PREFIX.len(), source.len())
    # Text length and indexing need not use the same unit for Unicode. Reject
    # non-ASCII bytes before indexing the canonical hex alphabet by position.
    for byte in text_to_utf8_bytes(payload):
        if byte >= 128:
            return Err("trace storage scalar must use canonical uppercase hex")
    if payload.len() % 2 != 0:
        return Err("truncated trace storage scalar hex")
    if payload.len() / 2 > TRACE_STORAGE_SCALAR_MAX_BYTES:
        return Err("trace storage scalar exceeds 1 MiB UTF-8 bound")
    var bytes: [u8] = []
    var i = 0
    while i < payload.len():
        val high = _trace_storage_hex_value(payload[i])
        val low = _trace_storage_hex_value(payload[i + 1])
        if high < 0 or low < 0:
            return Err("trace storage scalar must use canonical uppercase hex")
        bytes.push(((high << 4) | low).to_u8())
        i += 2
    val decoded = bytes_to_text(bytes)
    val roundtrip = text_to_utf8_bytes(decoded)
    if roundtrip.len() != bytes.len():
        return Err("trace storage scalar is not valid UTF-8")
    i = 0
    while i < bytes.len():
        if roundtrip[i] != bytes[i]:
            return Err("trace storage scalar is not valid UTF-8")
        i += 1
    Ok(decoded)
