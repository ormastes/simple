# Reverse references: every authored claim touching one selected node, paged.
# Sibling of query_nodes_v1; one-hop node pages keep their own contract.
# @req REQ-TRC-015 REQ-TRC-021 REQ-TRC-023
use std.common.traceability.model.*
use std.common.traceability.schema.{trace_id_valid}
use std.common.traceability.query_nodes_v1.{trace_node_query_kind_v1}
use std.common.crypto.sha256.{sha256_text}
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}

pub struct TraceReferenceQueryV1:
    snapshot_id: text
    kind: text
    selected_id: text
    limit: i64 = 100
    cursor: text = ""

pub struct TraceReferenceV1:
    claim_id: text
    direction: text
    relation: text
    from_id: text
    to_id: text
    other_id: text
    other_kind: text
    other_title: text
    operation: text
    origin_id: text
    authority: text
    other_paths: [text]

pub struct TraceReferencePageV1:
    snapshot_id: text
    selected: TraceNode
    references: [TraceReferenceV1]
    total_count: i64
    next_cursor: text
    complete: bool
    locators: [TraceLocator]
    diagnostics: [TraceDiagnostic]

pub fn trace_reference_query_validate_v1(query: TraceReferenceQueryV1) -> Result<bool, text>:
    trace_node_query_kind_v1(query.kind)?
    if query.limit < 1 or query.limit > 200:
        return Err("TRACE-QUERY-INVALID: limit must be between 1 and 200")
    if not trace_id_valid(query.selected_id):
        return Err("TRACE-QUERY-INVALID: refs needs one canonical identity")
    if query.cursor.len() > 256:
        return Err("TRACE-QUERY-INVALID: query field exceeds its bound")
    Ok(true)

fn reference_cursor_prefix_v1(graph: TraceGraph, query: TraceReferenceQueryV1) -> text:
    val shape = SdnValue.Dict({
        "schema": SdnValue.String("simple.trace.reference-cursor/v1"),
        "snapshot": SdnValue.String(graph.subject.snapshot_id),
        "generation": SdnValue.String(graph.generation_id),
        "kind": SdnValue.String(query.kind), "selected": SdnValue.String(query.selected_id),
        "limit": SdnValue.Int(query.limit), "order": SdnValue.String("canonical-claim-id/v1")})
    "tr1:" + sha256_text(sdn_encode_canonical(shape)) + ":"

fn edge_key_v1(from_id: text, relation: TraceRelation, to_id: text) -> text:
    from_id + "\t" + relation_name(relation) + "\t" + to_id

pub fn query_trace_references_v1(graph: TraceGraph, query: TraceReferenceQueryV1) -> Result<TraceReferencePageV1, text>:
    """Return the selected node's authored references; never a graph export or qualification."""
    trace_reference_query_validate_v1(query)?
    if query.snapshot_id != graph.subject.snapshot_id or graph.generation_id == "":
        return Err("TRACE-QUERY-INVALID: snapshot mismatch or missing generation; resync required")
    if graph.claims.len() > 40000:
        return Err("TRACE-QUERY-BUDGET: claim inventory exceeds 40000")
    val kind = trace_node_query_kind_v1(query.kind)?
    var by_id: Dict<text, TraceNode> = {}
    for node in graph.nodes:
        if not trace_id_valid(node.id) or by_id.contains_key(node.id):
            return Err("TRACE-QUERY-INVALID: invalid or duplicate canonical identity")
        by_id[node.id] = node
    if not by_id.contains_key(query.selected_id):
        return Err("TRACE-QUERY-NOT-FOUND: identity is absent from the selected snapshot")
    val selected = by_id[query.selected_id]
    if selected.kind != kind:
        return Err("TRACE-QUERY-NOT-FOUND: identity is not of the requested kind")
    var registered: Dict<text, bool> = {}
    for edge in graph.edges:
        registered[edge_key_v1(edge.from_id, edge.relation, edge.to_id)] = true
    var claims_by_id: Dict<text, TraceClaim> = {}
    var claim_ids: [text] = []
    for claim in graph.claims:
        if claim.operation == TraceClaimOperation.Suppress: continue
        if claim.from_id != query.selected_id and claim.to_id != query.selected_id: continue
        if claims_by_id.contains_key(claim.id):
            return Err("TRACE-QUERY-INVALID: duplicate claim identity")
        claims_by_id[claim.id] = claim
        claim_ids.push(claim.id)
    claim_ids = trace_sorted_ids(claim_ids)
    val prefix = reference_cursor_prefix_v1(graph, query)
    var offset = 0
    if query.cursor != "":
        if not query.cursor.starts_with(prefix):
            return Err("TRACE-QUERY-CURSOR: snapshot, generation or query changed; resync required")
        val digits = query.cursor.substring(prefix.len(), query.cursor.len())
        if digits == "" or digits.len() > 5:
            return Err("TRACE-QUERY-CURSOR: malformed offset")
        for ch in digits.chars():
            if not "0123456789".contains(ch): return Err("TRACE-QUERY-CURSOR: malformed offset")
        offset = digits.to_int()
        if offset >= claim_ids.len() or offset == 0 or offset % query.limit != 0 or digits != offset.to_text():
            return Err("TRACE-QUERY-CURSOR: offset is not a continuation page")
    var end = offset + query.limit
    if end > claim_ids.len(): end = claim_ids.len()
    # Declared paths per endpoint identity: the bug/requirement <-> file link.
    var paths_by_entity: Dict<text, [text]> = {}
    for locator in graph.locators:
        var paths: [text] = if paths_by_entity.contains_key(locator.entity_id): paths_by_entity[locator.entity_id] else: []
        if not paths.contains(locator.path): paths.push(locator.path)
        paths_by_entity[locator.entity_id] = paths
    var references: [TraceReferenceV1] = []
    for index in offset..end:
        val claim = claims_by_id[claim_ids[index]]
        val outgoing = claim.from_id == query.selected_id
        val other_id = if outgoing: claim.to_id else: claim.from_id
        var other_kind = ""
        var other_title = ""
        if by_id.contains_key(other_id):
            other_kind = node_kind_name(by_id[other_id].kind)
            other_title = by_id[other_id].title
        val authority = if registered.contains_key(edge_key_v1(claim.from_id, claim.relation, claim.to_id)): "registered-edge" else: "authored-claim"
        references.push(TraceReferenceV1(claim_id: claim.id,
            direction: if outgoing: "outgoing" else: "incoming",
            relation: relation_name(claim.relation), from_id: claim.from_id, to_id: claim.to_id,
            other_id: other_id, other_kind: other_kind, other_title: other_title,
            operation: claim_operation_name(claim.operation), origin_id: claim.origin_id, authority: authority,
            other_paths: if paths_by_entity.contains_key(other_id): trace_sorted_ids(paths_by_entity[other_id]) else: []))
    var locators: [TraceLocator] = []
    for locator in graph.locators:
        if locator.entity_id == query.selected_id: locators.push(locator)
    val next = if end < claim_ids.len(): prefix + end.to_text() else: ""
    Ok(TraceReferencePageV1(snapshot_id: graph.subject.snapshot_id, selected: selected, references: references,
        total_count: claim_ids.len(), next_cursor: next, complete: next == "", locators: locators,
        diagnostics: graph.diagnostics))
