# Strict native SDN transport for pre-dispatch, unverified run intent.
# @req REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
use std.common.sdn.value.{SdnValue}
use std.common.sdn.parser.{parse_with_spans_and_issues}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.traceability.schema.{trace_sdn_preflight}
use std.common.traceability.run_plan.{TracePlannedCase}
use std.common.traceability.run_request.{TraceRunRequest, validate_trace_run_request}

fn _request_checked_record(value: SdnValue, names: [text]) -> Result<Dict<text, SdnValue>, text>:
    match value:
        case SdnValue.Dict(fields):
            if fields.len() != names.len():
                return Err("unexpected or missing fields in trace run request")
            for name in names:
                if not fields.contains_key(name):
                    return Err("missing trace run request field: " + name)
            Ok(fields)
        case _:
            Err("trace run request record must be an SDN dictionary")

fn _request_text_field(fields: Dict<text, SdnValue>, name: text) -> Result<text, text>:
    match fields[name]:
        case SdnValue.String(value): Ok(value)
        case _: Err("trace run request field must be text: " + name)

pub fn encode_trace_run_request(request: TraceRunRequest) -> Result<text, text>:
    validate_trace_run_request(request)?
    var cases: [SdnValue] = []
    for planned in request.cases:
        var fields: Dict<text, SdnValue> = {}
        fields["case_id"] = SdnValue.String(planned.case_id)
        fields["test_path"] = SdnValue.String(planned.test_path)
        fields["case_name"] = SdnValue.String(planned.case_name)
        fields["test_definition_id"] = SdnValue.String(planned.test_definition_id)
        fields["lane_id"] = SdnValue.String(planned.lane_id)
        cases.push(SdnValue.Dict(fields))
    var root: Dict<text, SdnValue> = {}
    root["schema"] = SdnValue.String("simple.trace.run-request/v1")
    root["subject_id"] = SdnValue.String(request.subject_id)
    root["configuration_id"] = SdnValue.String(request.configuration_id)
    root["expectation_id"] = SdnValue.String(request.expectation_id)
    root["binary_id"] = SdnValue.String(request.binary_id)
    root["cases"] = SdnValue.Array(cases)
    val encoded = sdn_encode_canonical(SdnValue.Dict(root))
    if encoded.len() > 1048576:
        return Err("trace run request document exceeds 1 MiB")
    Ok(encoded)

pub fn decode_trace_run_request(source: text) -> Result<TraceRunRequest, text>:
    trace_sdn_preflight(source)?
    val parsed = parse_with_spans_and_issues(source)?
    if parsed.2.len() > 0:
        return Err("invalid or duplicate trace run request fields")
    val fields = _request_checked_record(parsed.0, ["schema", "subject_id", "configuration_id", "expectation_id", "binary_id", "cases"])?
    if _request_text_field(fields, "schema")? != "simple.trace.run-request/v1":
        return Err("unsupported trace run request schema")
    val values = match fields["cases"]:
        case SdnValue.Array(items): items
        case _: return Err("trace run request cases must be an SDN array")
    if values.len() > 65536:
        return Err("trace run request exceeds 65536 planned cases")
    var cases: [TracePlannedCase] = []
    for value in values:
        val case_fields = _request_checked_record(value, ["case_id", "test_path", "case_name", "test_definition_id", "lane_id"])?
        cases.push(TracePlannedCase(
            case_id: _request_text_field(case_fields, "case_id")?,
            test_path: _request_text_field(case_fields, "test_path")?,
            case_name: _request_text_field(case_fields, "case_name")?,
            test_definition_id: _request_text_field(case_fields, "test_definition_id")?,
            lane_id: _request_text_field(case_fields, "lane_id")?))
    val request = TraceRunRequest(
        subject_id: _request_text_field(fields, "subject_id")?,
        configuration_id: _request_text_field(fields, "configuration_id")?,
        expectation_id: _request_text_field(fields, "expectation_id")?,
        binary_id: _request_text_field(fields, "binary_id")?,
        cases: cases)
    validate_trace_run_request(request)?
    Ok(request)
