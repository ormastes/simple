# Boundary validation. Claims may be unresolved; published edges may not dangle.
# @req REQ-TRC-001 REQ-TRC-006 REQ-TRC-007 REQ-TRC-020
use std.common.traceability.model.*

pub fn trace_id_valid(value: text) -> bool:
    if value == "" or value.len() > 1024:
        return false
    for ch in value.chars():
        if not "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:_./-".contains(ch):
            return false
    true

# Bounded structural guard, not a second SDN decoder. The shared parser currently
# accepts a numeric token through to_int without reporting overflow. Reject such
# tokens and unbalanced delimiters before using its span/duplicate-aware entry.
fn trace_integer_token_valid(token: text) -> bool:
    var digits = token
    var negative = false
    if digits.starts_with("-"):
        negative = true
        digits = digits.slice(1, digits.len())
    if digits == "":
        return true
    for ch in digits.chars():
        if not "0123456789".contains(ch):
            return true
    while digits.len() > 1 and digits.starts_with("0"):
        digits = digits.slice(1, digits.len())
    val bound = if negative: "9223372036854775808" else: "9223372036854775807"
    digits.len() < 19 or (digits.len() == 19 and not trace_text_less(bound, digits))

pub fn trace_sdn_preflight(source: text) -> Result<(), text>:
    if source.len() > 1048576:
        return Err("trace SDN document exceeds 1 MiB; use bounded graph partitions")
    var stack: [text] = []
    var quoted = false
    var escaped = false
    var comment = false
    var after_quote = false
    var token = ""
    for ch in source.chars():
        if comment:
            if ch == "\n":
                comment = false
            continue
        if quoted:
            if escaped:
                if not ["\\", "\"", "n", "r", "t"].contains(ch):
                    return Err("unsupported escape in SDN string")
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == "\"":
                quoted = false
                after_quote = true
            elif ch == "\n" or ch == "\r":
                return Err("unescaped line break in SDN quoted scalar")
            continue
        if after_quote:
            if ch == " " or ch == "\t":
                continue
            if not ",:]}\r\n#".contains(ch):
                return Err("unexpected data after SDN quoted scalar")
            after_quote = false
        if ch == "\"" or ch == "#" or "{}[],: \r\n\t".contains(ch):
            if not trace_integer_token_valid(token):
                return Err("integer exceeds signed 64-bit range")
            token = ""
        else:
            token = token + ch
        if ch == "\"":
            quoted = true
        elif ch == "#":
            comment = true
        elif ch == "{" or ch == "[":
            stack.push(ch)
            if stack.len() > 64:
                return Err("SDN nesting exceeds 64")
        elif ch == "}" or ch == "]":
            if stack.len() == 0:
                return Err("unmatched SDN closing delimiter")
            val expected = if ch == "}": "{" else: "["
            if stack[stack.len() - 1] != expected:
                return Err("mismatched SDN delimiter")
            stack = stack.slice(0, stack.len() - 1)
    if quoted or escaped or stack.len() > 0:
        return Err("unterminated SDN string or collection")
    if not trace_integer_token_valid(token):
        return Err("integer exceeds signed 64-bit range")
    Ok(())

pub fn trace_path_valid(path: text) -> bool:
    if path == "" or path.starts_with("/") or path.contains("\\") or path.contains(":"):
        return false
    for part in path.split("/"):
        if part == "" or part == "." or part == "..":
            return false
    not path.contains("\n") and not path.contains("\r") and not path.contains("\0")

pub fn parse_node_kind(value: text) -> Result<TraceNodeKind, text>:
    match value:
        case "feature": Ok(TraceNodeKind.Feature)
        case "requirement": Ok(TraceNodeKind.Requirement)
        case "acceptance_criterion": Ok(TraceNodeKind.AcceptanceCriterion)
        case "test_suite": Ok(TraceNodeKind.TestSuite)
        case "test_case": Ok(TraceNodeKind.TestCase)
        case "parameterized_case": Ok(TraceNodeKind.ParameterizedCase)
        case "source_file": Ok(TraceNodeKind.SourceFile)
        case "symbol": Ok(TraceNodeKind.Symbol)
        case "research": Ok(TraceNodeKind.Research)
        case "architecture": Ok(TraceNodeKind.Architecture)
        case "design": Ok(TraceNodeKind.Design)
        case "plan": Ok(TraceNodeKind.Plan)
        case "document": Ok(TraceNodeKind.Document)
        case "component": Ok(TraceNodeKind.Component)
        case "layer": Ok(TraceNodeKind.Layer)
        case "transform": Ok(TraceNodeKind.Transform)
        case "run": Ok(TraceNodeKind.Run)
        case "observation": Ok(TraceNodeKind.Observation)
        case "evidence_artifact": Ok(TraceNodeKind.EvidenceArtifact)
        case "exception": Ok(TraceNodeKind.Exception)
        case "bug": Ok(TraceNodeKind.Bug)
        case "decision": Ok(TraceNodeKind.Decision)
        case _: Err("unknown node kind: " + value)

pub fn parse_relation(value: text) -> Result<TraceRelation, text>:
    match value:
        case "specifies": Ok(TraceRelation.Specifies)
        case "decomposes_to": Ok(TraceRelation.DecomposesTo)
        case "accepted_by": Ok(TraceRelation.AcceptedBy)
        case "verified_by": Ok(TraceRelation.VerifiedBy)
        case "targets": Ok(TraceRelation.Targets)
        case "implemented_by": Ok(TraceRelation.ImplementedBy)
        case "motivated_by": Ok(TraceRelation.MotivatedBy)
        case "described_by": Ok(TraceRelation.DescribedBy)
        case "belongs_to": Ok(TraceRelation.BelongsTo)
        case "generated_from": Ok(TraceRelation.GeneratedFrom)
        case "observed_in": Ok(TraceRelation.ObservedIn)
        case "produced": Ok(TraceRelation.Produced)
        case "depends_on": Ok(TraceRelation.DependsOn)
        case "supersedes": Ok(TraceRelation.Supersedes)
        case "aliases": Ok(TraceRelation.Aliases)
        case "contains": Ok(TraceRelation.Contains)
        case _: Err("unknown relation: " + value)

pub fn parse_test_kind(value: text) -> Result<TraceTestKind, text>:
    match value:
        case "acceptance": Ok(TraceTestKind.Acceptance)
        case "unit": Ok(TraceTestKind.Unit)
        case "integration": Ok(TraceTestKind.Integration)
        case "component": Ok(TraceTestKind.Component)
        case "system": Ok(TraceTestKind.System)
        case "performance": Ok(TraceTestKind.Performance)
        case _: Err("unknown test kind: " + value)

pub fn parse_origin_kind(value: text) -> Result<TraceOriginKind, text>:
    match value:
        case "explicit": Ok(TraceOriginKind.Explicit)
        case "annotation": Ok(TraceOriginKind.Annotation)
        case "convention": Ok(TraceOriginKind.Convention)
        case "compiler_index": Ok(TraceOriginKind.CompilerIndex)
        case "runtime_observation": Ok(TraceOriginKind.RuntimeObservation)
        case _: Err("unknown origin kind: " + value)

pub fn parse_claim_operation(value: text) -> Result<TraceClaimOperation, text>:
    match value:
        case "add": Ok(TraceClaimOperation.Add)
        case "replace": Ok(TraceClaimOperation.Replace)
        case "suppress": Ok(TraceClaimOperation.Suppress)
        case _: Err("unknown claim operation: " + value)

pub fn trace_test_kind(kind: TraceNodeKind) -> bool:
    kind == TraceNodeKind.TestCase or kind == TraceNodeKind.ParameterizedCase

pub fn trace_implementation_kind(kind: TraceNodeKind) -> bool:
    kind == TraceNodeKind.SourceFile or kind == TraceNodeKind.Symbol or kind == TraceNodeKind.Component

pub fn trace_endpoint_kinds_valid(relation: TraceRelation, source: TraceNodeKind, target: TraceNodeKind) -> bool:
    match relation:
        case TraceRelation.Specifies:
            source == TraceNodeKind.Feature and target == TraceNodeKind.Requirement
        case TraceRelation.DecomposesTo:
            source == TraceNodeKind.Requirement and target == TraceNodeKind.AcceptanceCriterion
        case TraceRelation.AcceptedBy:
            source == TraceNodeKind.AcceptanceCriterion and trace_test_kind(target)
        case TraceRelation.VerifiedBy:
            (source == TraceNodeKind.Requirement or source == TraceNodeKind.AcceptanceCriterion) and trace_test_kind(target)
        case TraceRelation.Targets:
            (trace_test_kind(source) or source == TraceNodeKind.TestSuite) and trace_implementation_kind(target)
        case TraceRelation.ImplementedBy:
            (source == TraceNodeKind.Requirement or source == TraceNodeKind.Feature) and trace_implementation_kind(target)
        case TraceRelation.MotivatedBy:
            (source == TraceNodeKind.Requirement or source == TraceNodeKind.Feature) and (target == TraceNodeKind.Research or target == TraceNodeKind.Decision)
        case TraceRelation.DescribedBy:
            (source == TraceNodeKind.Feature or source == TraceNodeKind.Component) and (target == TraceNodeKind.Design or target == TraceNodeKind.Architecture or target == TraceNodeKind.Document)
        case TraceRelation.BelongsTo:
            target == TraceNodeKind.Component or target == TraceNodeKind.Layer or target == TraceNodeKind.Feature
        case TraceRelation.GeneratedFrom:
            source == TraceNodeKind.Document and (target == TraceNodeKind.TestSuite or trace_test_kind(target) or target == TraceNodeKind.Feature)
        case TraceRelation.ObservedIn:
            trace_test_kind(source) and target == TraceNodeKind.Observation
        case TraceRelation.Produced:
            source == TraceNodeKind.Observation and target == TraceNodeKind.EvidenceArtifact
        case TraceRelation.DependsOn:
            source == TraceNodeKind.Component or source == TraceNodeKind.Symbol or trace_test_kind(source)
        case TraceRelation.Supersedes:
            source == target
        case TraceRelation.Aliases:
            source == target
        case TraceRelation.Contains:
            source == TraceNodeKind.Feature or source == TraceNodeKind.Component or source == TraceNodeKind.Layer or source == TraceNodeKind.TestSuite or source == TraceNodeKind.Document

pub fn trace_edge_id(source: text, relation: TraceRelation, target: text) -> text:
    "edge:" + source.len().to_text() + ":" + source + ":" + relation_name(relation) + ":" + target.len().to_text() + ":" + target

pub fn trace_relation_test_role_valid(relation: TraceRelation, target: text, roles: Dict<text, bool>) -> bool:
    if relation == TraceRelation.AcceptedBy:
        return roles.contains_key(target + "|acceptance")
    if relation == TraceRelation.VerifiedBy:
        for kind in ["unit", "integration", "component", "system", "performance"]:
            if roles.contains_key(target + "|" + kind):
                return true
        return false
    true

pub fn validate_trace_graph(graph: TraceGraph) -> [TraceDiagnostic]:
    var issues: [TraceDiagnostic] = []
    val subject = graph.subject.snapshot_id
    if not trace_id_valid(subject) or not trace_id_valid(graph.generation_id) or not trace_id_valid(graph.input_manifest_id):
        issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, "identity", subject, "", "invalid snapshot, generation or input identity"))
    if graph.subject.repository_id == "" or graph.subject.kind == "" or graph.subject.object_format == "":
        issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, "subject", subject, "", "repository, subject kind and object format are required"))
    if graph.subject.revision_id == "" and graph.subject.tree_id == "":
        issues.push(trace_diagnostic("TRACE-SNAPSHOT-INCOMPLETE", subject, "subject", subject, "", "subject has no revision or frozen tree identity"))
    var nodes: Dict<text, TraceNodeKind> = {}
    for node in graph.nodes:
        if not trace_id_valid(node.id) or nodes.contains_key(node.id):
            issues.push(trace_diagnostic("TRACE-DUPLICATE-ID", subject, "node", node.id, "", "invalid or duplicate node identity"))
        nodes[node.id] = node.kind
    var origins: Dict<text, bool> = {}
    var definitions: Dict<text, bool> = {}
    for definition in graph.test_definitions:
        val key = definition.node_id + "|" + test_kind_name(definition.kind)
        if definitions.contains_key(key):
            issues.push(trace_diagnostic("TRACE-DUPLICATE-ID", subject, "test_definition", definition.node_id, "", "duplicate test role for one canonical node"))
        definitions[key] = true
        if not nodes.contains_key(definition.node_id) or not nodes.contains_key(definition.definition_id):
            issues.push(trace_diagnostic("TRACE-MISSING-ENDPOINT", subject, "test_definition", definition.node_id, "", "test definition or parameter base node is missing"))
        elif not trace_test_kind(nodes[definition.node_id]) or nodes[definition.definition_id] != TraceNodeKind.TestCase:
            issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, "test_definition", definition.node_id, "", "test facet must reference a case and a base test definition"))
        elif nodes[definition.node_id] == TraceNodeKind.ParameterizedCase:
            if definition.parameter_digest == "" or definition.node_id == definition.definition_id:
                issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, "test_definition", definition.node_id, "", "parameterized case requires separate base and parameter digest"))
        elif definition.definition_id != definition.node_id or definition.parameter_digest != "":
            issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, "test_definition", definition.node_id, "", "unparameterized case must identify itself and have no parameter digest"))
        if definition.definition_digest == "":
            issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, "test_definition", definition.node_id, "", "test definition content identity is required"))
    for origin in graph.origins:
        if not trace_id_valid(origin.id) or origins.contains_key(origin.id):
            issues.push(trace_diagnostic("TRACE-DUPLICATE-ID", subject, "origin", origin.id, origin.id, "invalid or duplicate origin identity"))
        if not trace_path_valid(origin.owner_path) or origin.rule_version == "":
            issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, "origin", origin.id, origin.id, "origin needs safe owner path and extractor/rule version"))
        origins[origin.id] = true
    var claims: Dict<text, bool> = {}
    for claim in graph.claims:
        if not trace_id_valid(claim.id) or claims.contains_key(claim.id):
            issues.push(trace_diagnostic("TRACE-DUPLICATE-ID", subject, "claim", claim.id, claim.origin_id, "invalid or duplicate claim identity"))
        claims[claim.id] = true
        if not origins.contains_key(claim.origin_id):
            issues.push(trace_diagnostic("TRACE-MISSING-ENDPOINT", subject, claim.rule_id, claim.id, claim.origin_id, "claim origin is missing"))
        if not trace_id_valid(claim.from_id) or (claim.operation != TraceClaimOperation.Suppress and not trace_id_valid(claim.to_id)):
            issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, claim.rule_id, claim.id, claim.origin_id, "claim endpoint identity is invalid"))
    var edges: Dict<text, bool> = {}
    for edge in graph.edges:
        if edge.id != trace_edge_id(edge.from_id, edge.relation, edge.to_id) or edges.contains_key(edge.id):
            issues.push(trace_diagnostic("TRACE-DUPLICATE-ID", subject, "edge", edge.id, "", "edge identity is noncanonical or duplicated"))
        edges[edge.id] = true
        if not nodes.contains_key(edge.from_id) or not nodes.contains_key(edge.to_id):
            issues.push(trace_diagnostic("TRACE-MISSING-ENDPOINT", subject, "edge", edge.id, "", "resolved edge has missing endpoint"))
        elif not trace_endpoint_kinds_valid(edge.relation, nodes[edge.from_id], nodes[edge.to_id]):
            issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, "edge", edge.id, "", "relation has invalid endpoint kinds"))
        elif not trace_relation_test_role_valid(edge.relation, edge.to_id, definitions):
            issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, "test_definition", edge.id, "", "test association lacks its required acceptance/supporting role"))
    var bindings: Dict<text, bool> = {}
    var explained: Dict<text, bool> = {}
    for binding in graph.edge_origins:
        val key = binding.edge_id + "|" + binding.origin_id
        if not edges.contains_key(binding.edge_id) or not origins.contains_key(binding.origin_id) or bindings.contains_key(key):
            issues.push(trace_diagnostic("TRACE-MISSING-ENDPOINT", subject, "edge_origin", binding.edge_id, binding.origin_id, "origin binding is dangling or duplicated"))
        bindings[key] = true
        explained[binding.edge_id] = true
    for edge in graph.edges:
        if not explained.contains_key(edge.id):
            issues.push(trace_diagnostic("TRACE-MISSING-ENDPOINT", subject, "edge_origin", edge.id, "", "resolved edge has no provenance"))
    var locations: Dict<text, bool> = {}
    for locator in graph.locators:
        val key = locator.entity_id + "|" + locator.path + "|" + locator.locator_kind + "|" + locator.locator
        if not nodes.contains_key(locator.entity_id) or not trace_path_valid(locator.path) or locator.blob_id == "" or locations.contains_key(key):
            issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, "locator", locator.entity_id, "", "locator needs unique safe pinned location and existing node"))
        locations[key] = true
    for diagnostic in graph.diagnostics:
        if diagnostic.subject_id != subject or diagnostic.code == "" or diagnostic.message == "" or (diagnostic.severity != "error" and diagnostic.severity != "warning" and diagnostic.severity != "info"):
            issues.push(trace_diagnostic("TRACE-SDN-SCHEMA", subject, "diagnostic", diagnostic.entity_id, diagnostic.origin_id, "invalid or mixed-subject diagnostic"))
        if graph.complete and diagnostic.severity == "error":
            issues.push(trace_diagnostic("TRACE-SNAPSHOT-INCOMPLETE", subject, "completeness", subject, "", "complete graph contains an error diagnostic"))
    issues
