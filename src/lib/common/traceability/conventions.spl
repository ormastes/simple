# Structural path rules never infer semantic acceptance or executed coverage.
# @req REQ-TRC-004 REQ-TRC-006 REQ-TRC-017
use std.common.traceability.model.*
use std.common.traceability.schema.*

pub fn convention_rule_valid(rule: TraceConventionRule) -> bool:
    (trace_id_valid(rule.id) and rule.version != "" and rule.source_root.ends_with("/") and
     rule.target_root.ends_with("/") and trace_path_valid(rule.source_root + "entry") and
     trace_path_valid(rule.target_root + "entry") and rule.source_suffix != "" and
     rule.target_suffix != "" and (rule.relation == TraceRelation.Targets or rule.relation == TraceRelation.GeneratedFrom))

pub fn convention_target_path(path: text, rule: TraceConventionRule) -> text:
    if not convention_rule_valid(rule) or not path.starts_with(rule.source_root) or not path.ends_with(rule.source_suffix):
        return ""
    val end = path.len() - rule.source_suffix.len()
    if end <= rule.source_root.len():
        return ""
    rule.target_root + path.slice(rule.source_root.len(), end) + rule.target_suffix

pub fn convention_scope_applies(facts: TraceFacts, rule: TraceConventionRule, scope: text) -> bool:
    for locator in facts.locators:
        if locator.entity_id == scope and locator.locator_kind == "file" and convention_target_path(locator.path, rule) != "":
            return true
    false

pub fn derive_conventional_facts(facts: TraceFacts, rules: [TraceConventionRule]) -> TraceFacts:
    var claims = facts.claims
    var origins = facts.origins
    var diagnostics = facts.diagnostics
    var paths: Dict<text, [text]> = {}
    for locator in facts.locators:
        if locator.locator_kind != "file":
            continue
        var candidates: [text] = []
        if paths.contains_key(locator.path):
            candidates = paths[locator.path]
        if not candidates.contains(locator.entity_id):
            candidates.push(locator.entity_id)
        paths[locator.path] = candidates
    var seen_rules: Dict<text, bool> = {}
    for rule in rules:
        if not convention_rule_valid(rule) or seen_rules.contains_key(rule.id):
            diagnostics.push(trace_diagnostic("TRACE-SDN-SCHEMA", facts.subject.snapshot_id, rule.id, "", "", "invalid or duplicate structural mapping rule"))
            continue
        seen_rules[rule.id] = true
        val origin_id = "convention:" + rule.id
        origins.push(TraceOrigin(id: origin_id, kind: TraceOriginKind.Convention, owner_path: "config/traceability.sdn", locator: rule.id, rule_version: rule.version))
        var scopes: Dict<text, bool> = {}
        for locator in facts.locators:
            if locator.locator_kind != "file":
                continue
            val target_path = convention_target_path(locator.path, rule)
            if target_path == "" or scopes.contains_key(locator.entity_id):
                continue
            scopes[locator.entity_id] = true
            if not paths.contains_key(target_path):
                diagnostics.push(trace_diagnostic("TRACE-MISSING-ENDPOINT", facts.subject.snapshot_id, rule.id, locator.entity_id, origin_id, "conventional target missing: " + target_path))
                continue
            val candidates = paths[target_path]
            if candidates.len() != 1:
                diagnostics.push(trace_diagnostic("TRACE-AMBIGUOUS-MAPPING", facts.subject.snapshot_id, rule.id, locator.entity_id, origin_id, "conventional path resolves to " + candidates.len().to_text() + " entities: " + target_path))
                continue
            # Both permitted rules discover source -> derived path, while their
            # semantic relation is test/document -> source/spec respectively.
            val target = candidates[0]
            claims.push(TraceClaim(id: "convention:" + rule.id + ":" + locator.entity_id + ":" + target, from_id: target, relation: rule.relation, to_id: locator.entity_id, origin_id: origin_id, operation: TraceClaimOperation.Add, rule_id: rule.id, scope_id: locator.entity_id))
    TraceFacts(subject: facts.subject, input_manifest_id: facts.input_manifest_id, nodes: facts.nodes, test_definitions: facts.test_definitions, claims: claims, origins: origins, locators: facts.locators, diagnostics: diagnostics, generation_id: facts.generation_id, complete: facts.complete)
