# Exact structural check between a pre-dispatch request and selected files.
# @req REQ-TRC-003 REQ-TRC-012 REQ-TRC-013
# This validates transport scope only; it does not prove case discovery or
# semantic coverage of any selected test source.
use std.common.traceability.run_request.{TraceRunRequest, validate_trace_run_request}

val TRACE_RUN_SELECTION_MAX_PATHS: i64 = 65536
val TRACE_RUN_SELECTION_MAX_PATH_BYTES: i64 = 4096
val TRACE_RUN_SELECTION_MAX_TOTAL_BYTES: i64 = 1048576

pub fn validate_trace_request_selection(request: TraceRunRequest, selected_paths: [text]) -> Result<(), text>:
    validate_trace_run_request(request)?
    if selected_paths.len() == 0:
        return Err("trace selection must contain at least one selected path")
    if selected_paths.len() > TRACE_RUN_SELECTION_MAX_PATHS:
        return Err("trace selection exceeds 65536 selected paths")
    var selected: Dict<text, bool> = {}
    var total_path_bytes: i64 = 0
    for path in selected_paths:
        if path == "":
            return Err("trace selection contains an empty path")
        if path.len() > TRACE_RUN_SELECTION_MAX_PATH_BYTES:
            return Err("trace selected path exceeds 4096 bytes")
        if path.len() > TRACE_RUN_SELECTION_MAX_TOTAL_BYTES - total_path_bytes:
            return Err("trace selected inventory exceeds 1 MiB")
        total_path_bytes += path.len()
        if selected.contains_key(path):
            return Err("trace selection contains duplicate path: " + path)
        selected[path] = true
    var covered: Dict<text, bool> = {}
    for planned in request.cases:
        if not selected.contains_key(planned.test_path):
            return Err("planned case path is not selected: " + planned.test_path)
        covered[planned.test_path] = true
    for path in selected_paths:
        if not covered.contains_key(path):
            return Err("selected path has no planned case: " + path)
    Ok(())
