# Shared evidence value contracts. Only an admitted adapter constructs context
# from actual artifact bytes, provenance and input equivalence; never decode
# AdmissionContext from candidate-authored SDN.

pub enum TraceOutcome:
    Passed
    Failed
    Skipped
    ExpectedFailure
    UnexpectedPass
    Cancelled
    Crashed
    TimedOut

pub enum TraceCompletion:
    Complete
    Incomplete
    Cancelled
    Crashed

export use std.common.traceability.model.{TraceTestKind}

pub enum TraceApplicability:
    Required
    NotApplicable
    Unknown

pub enum TraceSatisfactionPolicy:
    All
    Alternative

pub enum TraceQualificationStatus:
    Verified
    Failed
    Incomplete
    NotRun
    Stale
    NotApplicable

pub struct TraceObservation:
    id: text
    run_id: text
    case_id: text
    attempt: i64
    outcome: TraceOutcome
    executed: bool
    artifact_ids: [text]

pub struct TraceRun:
    id: text
    subject_id: text
    input_manifest_id: text
    definition_manifest_id: text
    configuration_id: text
    lane_id: text
    binary_id: text
    expectation_id: text
    planned_case_ids: [text]
    expected_shard_ids: [text]
    completed_shard_ids: [text]
    observations: [TraceObservation]
    completion: TraceCompletion

pub struct TraceApplicabilityDecision:
    obligation_id: text
    requirement_id: text
    criterion_id: text
    test_kind: TraceTestKind
    subject_id: text
    input_manifest_id: text
    configuration_id: text
    expectation_id: text
    review_id: text
    reason: text

pub struct AdmissionContext:
    subject_id: text
    input_manifest_id: text
    definition_manifest_id: text
    configuration_id: text
    lane_id: text
    binary_id: text
    expectation_id: text
    # Exact admitted copies, including outcome, attempt and artifact identities.
    # IDs alone do not authorize a different observation with the same ID.
    admitted_observations: [TraceObservation]
    # Owner admits only complete prior runs with equivalent full inputs and
    # verifies all attempts. Multiple prior attempts remain visible to policy.
    eligible_previous_observations: [TraceObservation]
    # Trusted policy owner verifies approval, expiry and scope before insertion.
    # Candidate declarations cannot populate this collection.
    reviewed_not_applicable: [TraceApplicabilityDecision]

pub struct TraceObligation:
    id: text
    requirement_id: text
    criterion_id: text
    test_kind: TraceTestKind
    case_ids: [text]
    applicability: TraceApplicability
    policy: TraceSatisfactionPolicy
    allow_expected_failure: bool
    allow_retry_pass: bool

pub struct TraceObligationResult:
    obligation_id: text
    requirement_id: text
    criterion_id: text
    test_kind: TraceTestKind
    status: TraceQualificationStatus
    selected_observation_ids: [text]
    reasons: [text]

pub struct TraceQualification:
    subject_id: text
    run_id: text
    results: [TraceObligationResult]
    structural_covered: i64
    structural_total: i64
    execution_covered: i64
    execution_total: i64
    complete: bool

pub struct TraceOutput:
    path: text
    content: text
