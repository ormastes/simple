# Offline, inert HTML projection. The publication owner supplies an admitted
# visibility selection; this renderer does not fetch source or authorize export.
use std.common.traceability.model.*
use std.common.traceability.schema.{validate_trace_graph}
use std.common.traceability.evidence_model.{TraceOutput}

pub fn trace_html_escape(value: text) -> text:
    value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;")

# Anchor encoding is reversible and independent of array order. Raw entity
# names are never used as HTML attributes, URLs, or filesystem paths.
fn trace_html_anchor(id: text) -> text:
    val hex = "0123456789abcdef"
    var result = "node-"
    for byte in id.bytes():
        val n = byte.to_i64()
        result = result + hex.substring(n / 16, n / 16 + 1)
        result = result + hex.substring(n % 16, n % 16 + 1)
    result

fn trace_html_link(id: text) -> text:
    "<a href=\"#" + trace_html_anchor(id) + "\">" + trace_html_escape(id) + "</a>"

# This structural view deliberately carries no run badge. Run qualification
# needs the separate admitted observation/input binding before publication.
# Never pass candidate-authored visibility claims as the admitted selection.
pub fn project_trace_html(graph: TraceGraph, visible_node_ids: [text]) -> Result<TraceOutput, text>:
    if validate_trace_graph(graph).len() != 0:
        return Err("HTML projection requires a schema-valid graph")
    var nodes: Dict<text, TraceNode> = {}
    for node in graph.nodes:
        nodes[node.id] = node
    var visible: Dict<text, bool> = {}
    for id in visible_node_ids:
        if not nodes.contains_key(id) or visible.contains_key(id):
            return Err("invalid or duplicate publication selection")
        visible[id] = true
    val ordered = trace_sorted_ids(visible.keys())
    var lines: [text] = ["<!doctype html>", "<html lang=\"en\"><head><meta charset=\"utf-8\">",
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
        "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; base-uri 'none'; form-action 'none'\">",
        "<title>Traceability snapshot</title></head><body><main>",
        "<h1>Traceability snapshot</h1>"]
    lines.push("<p>Snapshot: " + trace_html_escape(graph.subject.snapshot_id) + "</p>")
    lines.push("<p>Structural input: " + trace_html_escape(graph.input_manifest_id) + "</p>")
    lines.push("<p>Graph state: " + (if graph.complete: "complete structural snapshot" else: "incomplete structural snapshot") + "</p>")
    lines.push("<p>Visible nodes: " + ordered.len().to_text() + " of " + graph.nodes.len().to_text() + ". Hidden nodes remain outside this publication.</p>")
    lines.push("<p>Execution qualification: not included. A structural link does not prove a test ran.</p>")
    lines.push("<nav aria-label=\"Published entities\"><ul>")
    for id in ordered:
        lines.push("<li>" + trace_html_link(id) + "</li>")
    lines.push("</ul></nav>")
    var edges: Dict<text, TraceEdge> = {}
    var hidden_edges: i64 = 0
    for edge in graph.edges:
        if visible.contains_key(edge.from_id) and visible.contains_key(edge.to_id):
            edges[edge.id] = edge
        else:
            hidden_edges = hidden_edges + 1
    # Build adjacency once; rendering must not rescan all edges per entity.
    var adjacency: Dict<text, [text]> = {}
    for id in ordered:
        adjacency[id] = []
    for id in trace_sorted_ids(edges.keys()):
        val edge = edges[id]
        var outgoing = adjacency[edge.from_id]
        outgoing.push(id)
        adjacency[edge.from_id] = outgoing
        if edge.to_id != edge.from_id:
            var incoming = adjacency[edge.to_id]
            incoming.push(id)
            adjacency[edge.to_id] = incoming
    for id in ordered:
        val node = nodes[id]
        lines.push("<section id=\"" + trace_html_anchor(id) + "\"><h2>" + trace_html_escape(node.title) + "</h2>")
        lines.push("<p>" + trace_html_escape(id) + " — " + node_kind_name(node.kind) + "</p>")
        lines.push("<ul aria-label=\"Incoming and outgoing relations\">")
        for edge_id in adjacency[id]:
            val edge = edges[edge_id]
            lines.push("<li>" + trace_html_link(edge.from_id) + " — " + relation_name(edge.relation) + " → " + trace_html_link(edge.to_id) + "</li>")
        lines.push("</ul></section>")
    lines.push("<p>Relations omitted by publication scope: " + hidden_edges.to_text() + ".</p>")
    lines.push("<p>Snapshot diagnostics: " + graph.diagnostics.len().to_text() + ". Detailed diagnostics require an authorized graph view.</p>")
    lines.push("</main></body></html>")
    Ok(TraceOutput(path: "index.html", content: lines.join("\n") + "\n"))
