"""Single-pass supplied-fact indexes; file existence and test roles stay distinct."""
use std.common.traceability.conventions_types_v1.*
use std.common.traceability.conventions_policy_v1.{TraceConventionPolicyIndexV1}
use std.common.traceability.graph_types_v1.{TraceGraphV1}
use std.common.traceability.codec_fields_v1.{trace_codec_id_check_v1}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}

pub class TraceConventionIndexV1:
    nodes: Dict<text, text> = {}
    input_roles: Dict<text, text> = {}
    input_digests: Dict<text, text> = {}
    paths: Dict<text, [text]> = {}
    artifacts: Dict<text, [text]> = {}
    roles: Dict<text, [text]> = {}
    bindings: Dict<text, [text]> = {}
    binding_manifests: Dict<text, text> = {}
    seen: Dict<text, bool> = {}
    me paths_for(id: text) -> [text]:
        if self.paths.contains_key(id): self.paths[id] else: []
    me artifacts_for(kind: text, path: text) -> [text]:
        val key = kind + "|" + path
        if self.artifacts.contains_key(key): self.artifacts[key] else: []
    me roles_for(kind: text, path: text) -> [text]:
        val key = kind + "|" + path
        if self.roles.contains_key(key): self.roles[key] else: []
    me bindings_for(rule: text, suite: text, document: text) -> [text]:
        val key = rule + "|" + suite + "|" + document
        if self.bindings.contains_key(key): self.bindings[key] else: []

pub fn trace_convention_index_v1(graph: TraceGraphV1, policy: TraceConventionPolicyV1, registered: TraceConventionPolicyIndexV1) -> Result<TraceConventionIndexV1, TraceCodecIssueV1>:
    var result = TraceConventionIndexV1()
    for node in graph.nodes: result.nodes[node.id] = node.kind
    for input in graph.inputs:
        result.input_roles[input.path] = input.role
        result.input_digests[input.path] = input.sha256
    var definitions: Dict<text, text> = {}
    for definition in graph.test_definitions: definitions[definition.entity_id] = definition.test_kind
    for locator in graph.locators:
        if not locator.path_available: continue
        if locator.locator_kind == "file":
            val key = locator.entity_id + "|" + locator.path
            if not result.seen.contains_key("file|" + key):
                result.seen["file|" + key] = true
                var paths = result.paths_for(locator.entity_id)
                paths.push(locator.path)
                result.paths[locator.entity_id] = paths
                val kind = result.nodes[locator.entity_id]
                var artifacts = result.artifacts_for(kind, locator.path)
                artifacts.push(locator.entity_id)
                result.artifacts[kind + "|" + locator.path] = artifacts
        if locator.locator_kind == "scenario" and definitions.contains_key(locator.entity_id) and result.input_roles[locator.path] == "test":
            val kind = definitions[locator.entity_id]
            val key = kind + "|" + locator.path + "|" + locator.entity_id
            if not result.seen.contains_key("role|" + key):
                result.seen["role|" + key] = true
                var cases = result.roles_for(kind, locator.path)
                cases.push(locator.entity_id)
                result.roles[kind + "|" + locator.path] = cases
    var binding_ids: Dict<text, bool> = {}
    for binding in policy.generator_bindings:
        for id in [binding.id, binding.suite_id, binding.document_id, binding.rule_id, binding.generator_id]: trace_codec_id_check_v1(id, "generator_bindings")?
        if binding_ids.contains_key(binding.id): return Err(trace_codec_issue_v1("duplicate_identifier", "generator_bindings", "Binding IDs must be unique"))
        binding_ids[binding.id] = true
        if (not registered.rules.contains_key(binding.rule_id) or not result.nodes.contains_key(binding.suite_id) or
            not result.nodes.contains_key(binding.document_id) or not result.input_roles.contains_key(binding.manifest_path)):
            return Err(trace_codec_issue_v1("invalid_generator_binding", "generator_bindings", "Generator binding references absent captured facts"))
        if (policy.rules[registered.rules[binding.rule_id]].kind != "manual" or result.nodes[binding.suite_id] != "test_suite" or
            result.nodes[binding.document_id] != "generated_document" or result.input_roles[binding.manifest_path] != "policy" or
            result.input_digests[binding.manifest_path] != binding.manifest_sha256):
            return Err(trace_codec_issue_v1("invalid_generator_binding", "generator_bindings", "Generator manifest binding contradicts captured facts"))
        var ids = result.bindings_for(binding.rule_id, binding.suite_id, binding.document_id)
        ids.push(binding.id)
        result.bindings[binding.rule_id + "|" + binding.suite_id + "|" + binding.document_id] = ids
        result.binding_manifests[binding.id] = binding.manifest_path
    Ok(result)

export TraceConventionIndexV1, trace_convention_index_v1
