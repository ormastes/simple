"""Authored claims and exceptions are untrusted intent, never admission."""
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1, sdn_strict_limits_v1}

pub struct TraceDeclarationsCodecLimitsV1:
    sdn: SdnStrictLimitsV1
    max_records: i64 = 100000
    max_text_bytes: i64 = 1048576
    max_field_bytes: i64 = 4096
    max_output_bytes: i64 = 1048576

pub fn trace_declarations_codec_limits_v1() -> TraceDeclarationsCodecLimitsV1:
    TraceDeclarationsCodecLimitsV1(sdn: sdn_strict_limits_v1())

pub struct TraceClaimV1:
    id: text
    from_id: text
    relation: text
    to_id: text
    origin_id: text

pub struct TraceAliasDeclarationV1:
    id: text
    from_id: text
    to_id: text
    origin_id: text

pub struct TraceExceptionDeclarationV1:
    id: text
    scope_kind: text
    subject_id: text
    rule_id: text
    reason: text
    owner: text
    review_state: text
    expires_available: bool
    expires_at: text
    origin_id: text

pub struct TraceDeclarationOriginV1:
    id: text
    origin_kind: text
    path: text
    span_available: bool
    line: i64
    column: i64
    extractor_version: text

pub struct TraceDeclarationsV1:
    id: text
    namespace: text
    claims: [TraceClaimV1]
    aliases: [TraceAliasDeclarationV1]
    exceptions: [TraceExceptionDeclarationV1]
    origins: [TraceDeclarationOriginV1]

export TraceDeclarationsCodecLimitsV1, trace_declarations_codec_limits_v1
export TraceClaimV1, TraceAliasDeclarationV1, TraceExceptionDeclarationV1
export TraceDeclarationOriginV1, TraceDeclarationsV1
