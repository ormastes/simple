"""Whole-input preflight precedes policy and graph index allocation."""
use std.common.traceability.conventions_types_v1.*
use std.common.traceability.graph_types_v1.{TraceGraphV1}
use std.common.traceability.graph_budget_v1.{trace_graph_preflight_v1}
use std.common.traceability.codec_fields_v1.*
use std.common.traceability.codec_text_budget_v1.{TraceCodecTextBudgetV1}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}

pub class TraceConventionPolicyIndexV1:
    rules: Dict<text, i64> = {}
    groups: Dict<text, text> = {}
    exclusions: Dict<text, [text]> = {}
    group_rules: Dict<text, [i64]> = {}
    source_groups: Dict<text, [text]> = {}

fn trace_convention_root_valid_v1(root: text) -> bool:
    root.len() > 1 and root.ends_with("/") and trace_codec_path_valid_v1(root[0:root.len() - 1])

pub fn trace_convention_preflight_v1(graph: TraceGraphV1, policy: TraceConventionPolicyV1, limits: TraceConventionLimitsV1) -> Result<bool, TraceCodecIssueV1>:
    if (limits.max_rules < 0 or limits.max_rules > 4096 or
        limits.max_exclusions < 0 or limits.max_exclusions > 65536 or
        limits.max_bindings < 0 or limits.max_bindings > 65536 or
        limits.max_work < 0 or limits.max_work > 100000000 or
        limits.max_claims < 0 or limits.max_claims > 1000000 or
        limits.max_diagnostics < 0 or limits.max_diagnostics > 1000000 or
        limits.max_lookups < 0 or limits.max_lookups > 1000000 or
        limits.max_field_bytes < 0 or limits.max_field_bytes > 1048576 or
        limits.max_policy_text_bytes < 0 or limits.max_policy_text_bytes > 16777216 or
        limits.max_result_text_bytes < 0 or limits.max_result_text_bytes > 16777216):
        return Err(trace_codec_issue_v1("invalid_limits", "", "Convention limits outside hard bounds"))
    trace_graph_preflight_v1(graph, limits.graph)?
    if (policy.rules.len() > limits.max_rules or policy.exclusions.len() > limits.max_exclusions or
        policy.generator_bindings.len() > limits.max_bindings):
        return Err(trace_codec_issue_v1("record_limit", "policy", "Convention policy exceeds record budgets"))
    val work = 2 * graph.nodes.len() * policy.rules.len() + graph.inputs.len() + 2 * graph.nodes.len() + graph.locators.len() + graph.test_definitions.len() + policy.rules.len() + policy.exclusions.len() + policy.generator_bindings.len()
    if work > limits.max_work: return Err(trace_codec_issue_v1("work_limit", "", "Conservative work exceeds budget before indexes"))
    var budget = TraceCodecTextBudgetV1(max_field_bytes: limits.max_field_bytes, max_text_bytes: limits.max_policy_text_bytes)
    budget.charge([policy.id, policy.version], "policy")?
    for rule in policy.rules:
        budget.charge([rule.id, rule.group_id, rule.kind, rule.source_root, rule.target_root, rule.source_suffix, rule.target_suffix], "rules")?
    for exclusion in policy.exclusions: budget.charge([exclusion.group_id, exclusion.root, exclusion.reason], "exclusions")?
    for binding in policy.generator_bindings:
        budget.charge([binding.id, binding.suite_id, binding.document_id, binding.rule_id, binding.generator_id, binding.manifest_path, binding.manifest_sha256], "generator_bindings")?
    if not graph.snapshot.complete or not graph.manifest.complete:
        return Err(trace_codec_issue_v1("incomplete_inventory", "manifest", "Conventions require complete supplied inventory"))
    if policy.id != graph.manifest.policy_id or policy.version != graph.manifest.rules_version:
        return Err(trace_codec_issue_v1("policy_mismatch", "policy", "Policy identities do not match the captured manifest"))
    Ok(true)

pub fn trace_convention_policy_index_v1(policy: TraceConventionPolicyV1) -> Result<TraceConventionPolicyIndexV1, TraceCodecIssueV1>:
    trace_codec_id_check_v1(policy.id, "policy.id")?
    trace_codec_id_check_v1(policy.version, "policy.version")?
    var result = TraceConventionPolicyIndexV1()
    var index = 0
    for rule in policy.rules:
        trace_codec_id_check_v1(rule.id, "rule.id")?
        trace_codec_id_check_v1(rule.group_id, "rule.group_id")?
        trace_codec_enum_check_v1(rule.kind, ["unit", "integration", "component", "manual"], "rule.kind")?
        if result.rules.contains_key(rule.id): return Err(trace_codec_issue_v1("duplicate_identifier", "rule.id", "Rule IDs must be unique"))
        if result.groups.contains_key(rule.group_id) and result.groups[rule.group_id] != rule.kind:
            return Err(trace_codec_issue_v1("invalid_group", "rule.group_id", "One mapping group requires one kind"))
        if not trace_convention_root_valid_v1(rule.source_root) or not trace_convention_root_valid_v1(rule.target_root):
            return Err(trace_codec_issue_v1("invalid_path", "rule", "Registered directory prefixes must be canonical"))
        if rule.source_suffix == "" or rule.target_suffix == "" or rule.source_suffix.contains("/") or rule.target_suffix.contains("/"):
            return Err(trace_codec_issue_v1("invalid_suffix", "rule", "Nonempty filename suffixes required"))
        if not result.groups.contains_key(rule.group_id):
            val source_kind = if rule.kind == "unit": "source_file" else: (if rule.kind == "manual": "test_suite" else: "component")
            var groups = if result.source_groups.contains_key(source_kind): result.source_groups[source_kind] else: []
            groups.push(rule.group_id)
            result.source_groups[source_kind] = groups
        result.rules[rule.id] = index
        result.groups[rule.group_id] = rule.kind
        var members = if result.group_rules.contains_key(rule.group_id): result.group_rules[rule.group_id] else: []
        members.push(index)
        result.group_rules[rule.group_id] = members
        index = index + 1
    var seen_exclusions: Dict<text, bool> = {}
    for exclusion in policy.exclusions:
        if not result.groups.contains_key(exclusion.group_id): return Err(trace_codec_issue_v1("missing_reference", "exclusion.group_id", "Exclusion group is absent"))
        if not trace_convention_root_valid_v1(exclusion.root) or exclusion.reason == "":
            return Err(trace_codec_issue_v1("invalid_exclusion", "exclusions", "Canonical root and explicit reason required"))
        val key = exclusion.group_id + "|" + exclusion.root
        if seen_exclusions.contains_key(key): return Err(trace_codec_issue_v1("duplicate_record", "exclusions", "Duplicate group/root exclusion"))
        seen_exclusions[key] = true
        var roots = if result.exclusions.contains_key(exclusion.group_id): result.exclusions[exclusion.group_id] else: []
        roots.push(exclusion.root)
        result.exclusions[exclusion.group_id] = roots
    Ok(result)

export TraceConventionPolicyIndexV1, trace_convention_preflight_v1, trace_convention_policy_index_v1
