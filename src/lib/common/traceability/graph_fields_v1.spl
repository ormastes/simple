"""Exact primitive graph fields; no IO or permissive semantic coercions."""
use std.common.sdn.value.{SdnValue}
use std.common.traceability.types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}

fn trace_graph_field_path_v1(path: text, name: text) -> text:
    if path == "": name else: path + "." + name

fn trace_graph_field_lt_v1(left: text, right: text) -> bool:
    var index = 0
    while index < left.len() and index < right.len():
        if left.byte_at(index) < right.byte_at(index): return true
        if left.byte_at(index) > right.byte_at(index): return false
        index = index + 1
    left.len() < right.len()

pub fn trace_graph_dict_v1(value: SdnValue, path: text, names: [text]) -> Result<Dict<text, SdnValue>, TraceCodecIssueV1>:
    match value:
        case Dict(fields):
            var unknown = ""
            var found = false
            for name in fields.keys():
                if not names.contains(name) and (not found or trace_graph_field_lt_v1(name, unknown)):
                    unknown = name
                    found = true
            if found:
                return Err(trace_codec_issue_v1("unknown_field", trace_graph_field_path_v1(path, unknown), "Unknown semantic field"))
            for name in names:
                if not fields.contains_key(name):
                    return Err(trace_codec_issue_v1("missing_field", trace_graph_field_path_v1(path, name), "Missing required field"))
            Ok(fields)
        case _: Err(trace_codec_issue_v1("wrong_type", path, "Expected dictionary"))

pub fn trace_graph_text_v1(value: SdnValue, path: text) -> Result<text, TraceCodecIssueV1>:
    match value:
        case String(item): Ok(item)
        case _: Err(trace_codec_issue_v1("wrong_type", path, "Expected text"))

pub fn trace_graph_int_v1(value: SdnValue, path: text) -> Result<i64, TraceCodecIssueV1>:
    match value:
        case Int(item): Ok(item)
        case _: Err(trace_codec_issue_v1("wrong_type", path, "Expected integer"))

pub fn trace_graph_bool_v1(value: SdnValue, path: text) -> Result<bool, TraceCodecIssueV1>:
    match value:
        case Bool(item): Ok(item)
        case _: Err(trace_codec_issue_v1("wrong_type", path, "Expected boolean"))

pub fn trace_graph_table_v1(value: SdnValue, path: text, names: [text]) -> Result<[[SdnValue]], TraceCodecIssueV1>:
    match value:
        case Table(headers, rows):
            var unknown = ""
            var found = false
            for name in headers:
                if not names.contains(name) and (not found or trace_graph_field_lt_v1(name, unknown)):
                    unknown = name
                    found = true
            if found:
                return Err(trace_codec_issue_v1("unknown_field", path + "." + unknown, "Unknown table field"))
            var positions: [i64] = []
            for name in names:
                var position = -1
                var index = 0
                for header in headers:
                    if header == name:
                        if position >= 0: return Err(trace_codec_issue_v1("duplicate_field", path + "." + name, "Duplicate table field"))
                        position = index
                    index = index + 1
                if position < 0: return Err(trace_codec_issue_v1("missing_field", path + "." + name, "Missing table field"))
                positions.push(position)
            var ordered: [[SdnValue]] = []
            for row in rows:
                if row.len() != names.len(): return Err(trace_codec_issue_v1("row_width", path, "Wrong table row width"))
                var cells: [SdnValue] = []
                for position in positions: cells.push(row[position])
                ordered.push(cells)
            Ok(ordered)
        case _: Err(trace_codec_issue_v1("wrong_type", path, "Expected named table"))

pub fn trace_graph_identifier_valid_v1(item: text) -> bool:
    if item.len() == 0: return false
    var index = 0
    while index < item.len():
        val ch = item.byte_at(index)
        if not ((ch >= 48 and ch <= 57) or (ch >= 65 and ch <= 90) or
            (ch >= 97 and ch <= 122) or [46, 95, 58, 47, 64, 43, 45].contains(ch)):
            return false
        index = index + 1
    true

pub fn trace_graph_digest_valid_v1(item: text) -> bool:
    if item.len() != 64: return false
    var index = 0
    while index < 64:
        val ch = item.byte_at(index)
        if not ((ch >= 48 and ch <= 57) or (ch >= 97 and ch <= 102)): return false
        index = index + 1
    true

pub fn trace_graph_path_valid_v1(item: text) -> bool:
    if item.len() == 0 or item.starts_with("/"): return false
    for segment in item.split("/"):
        if segment == "" or segment == "." or segment == "..": return false
    var index = 0
    while index < item.len():
        if item.byte_at(index) == 0: return false
        index = index + 1
    true

pub fn trace_graph_enum_check_v1(item: text, names: [text], path: text) -> Result<bool, TraceCodecIssueV1>:
    if not names.contains(item): return Err(trace_codec_issue_v1("invalid_enum", path, "Unknown enum value"))
    Ok(true)

pub fn trace_graph_id_check_v1(item: text, path: text) -> Result<bool, TraceCodecIssueV1>:
    if not trace_graph_identifier_valid_v1(item): return Err(trace_codec_issue_v1("invalid_identifier", path, "Restricted ASCII identity required"))
    Ok(true)

export trace_graph_dict_v1, trace_graph_text_v1, trace_graph_int_v1, trace_graph_bool_v1
export trace_graph_table_v1, trace_graph_identifier_valid_v1, trace_graph_digest_valid_v1
export trace_graph_path_valid_v1, trace_graph_enum_check_v1, trace_graph_id_check_v1
