"""Compatibility graph field surface forwarded to the common owner."""
use std.common.sdn.value.{SdnValue}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1}
use std.common.traceability.codec_fields_v1.*

pub fn trace_graph_dict_v1(value: SdnValue, path: text, names: [text]) -> Result<Dict<text, SdnValue>, TraceCodecIssueV1>:
    trace_codec_dict_v1(value, path, names)

pub fn trace_graph_text_v1(value: SdnValue, path: text) -> Result<text, TraceCodecIssueV1>:
    trace_codec_text_v1(value, path)

pub fn trace_graph_int_v1(value: SdnValue, path: text) -> Result<i64, TraceCodecIssueV1>:
    trace_codec_int_v1(value, path)

pub fn trace_graph_bool_v1(value: SdnValue, path: text) -> Result<bool, TraceCodecIssueV1>:
    trace_codec_bool_v1(value, path)

pub fn trace_graph_table_v1(value: SdnValue, path: text, names: [text]) -> Result<[[SdnValue]], TraceCodecIssueV1>:
    trace_codec_table_v1(value, path, names)

pub fn trace_graph_identifier_valid_v1(item: text) -> bool:
    trace_codec_identifier_valid_v1(item)

pub fn trace_graph_digest_valid_v1(item: text) -> bool:
    trace_codec_digest_valid_v1(item)

pub fn trace_graph_path_valid_v1(item: text) -> bool:
    trace_codec_path_valid_v1(item)

pub fn trace_graph_enum_check_v1(item: text, names: [text], path: text) -> Result<bool, TraceCodecIssueV1>:
    trace_codec_enum_check_v1(item, names, path)

pub fn trace_graph_id_check_v1(item: text, path: text) -> Result<bool, TraceCodecIssueV1>:
    trace_codec_id_check_v1(item, path)

export trace_graph_dict_v1, trace_graph_text_v1, trace_graph_int_v1, trace_graph_bool_v1, trace_graph_table_v1, trace_graph_identifier_valid_v1, trace_graph_digest_valid_v1, trace_graph_path_valid_v1, trace_graph_enum_check_v1, trace_graph_id_check_v1
