"""Resource preflight before graph indexes, table rows or escaped sort keys."""
use std.common.sdn.strict_v1.{sdn_strict_limits_valid_v1}
use std.common.traceability.codec_text_budget_v1.{TraceCodecTextBudgetV1}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}
use std.common.traceability.graph_types_v1.*
use std.common.traceability.graph_wire_v1.{trace_graph_output_size_v1}

pub fn trace_graph_limits_valid_v1(limits: TraceGraphCodecLimitsV1) -> bool:
    (sdn_strict_limits_valid_v1(limits.sdn) and
        limits.max_records >= 0 and limits.max_records <= 1000000 and
        limits.max_text_bytes >= 0 and limits.max_text_bytes <= 16777216 and
        limits.max_field_bytes >= 0 and limits.max_field_bytes <= 1048576 and
        limits.max_output_bytes >= 0 and limits.max_output_bytes <= 16777216)

pub fn trace_graph_output_cap_v1(limits: TraceGraphCodecLimitsV1) -> i64:
    if limits.max_output_bytes < limits.sdn.max_source_bytes: limits.max_output_bytes else: limits.sdn.max_source_bytes

pub fn trace_graph_preflight_v1(document: TraceGraphV1, limits: TraceGraphCodecLimitsV1, for_encoding: bool = false) -> Result<bool, TraceCodecIssueV1>:
    if not trace_graph_limits_valid_v1(limits):
        return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits are outside hard bounds"))
    val counts = [document.inputs.len(), document.nodes.len(), document.test_definitions.len(),
        document.edges.len(), document.edge_origins.len(), document.locators.len()]
    val widths = [4, 3, 6, 4, 9, 5]
    var rows = 0
    var cells = 0
    var index = 0
    for count in counts:
        if count > limits.max_records - rows:
            return Err(trace_codec_issue_v1("record_limit", "", "Graph exceeds record budget"))
        rows = rows + count
        # count <= 1M and width <= 9; multiplication is bounded before use.
        val charge = count * widths[index]
        if charge > limits.sdn.max_cells - cells:
            return Err(trace_codec_issue_v1("cell_limit", "", "Graph exceeds SDN cell budget"))
        cells = cells + charge
        index = index + 1
    if rows > limits.sdn.max_rows: return Err(trace_codec_issue_v1("row_limit", "", "Graph exceeds SDN row budget"))
    if limits.sdn.max_nodes < 70 or cells > limits.sdn.max_nodes - 70:
        return Err(trace_codec_issue_v1("node_limit", "", "Graph exceeds SDN node budget"))
    if limits.sdn.max_depth < 3: return Err(trace_codec_issue_v1("depth_limit", "", "Graph requires SDN depth three"))
    if limits.sdn.max_columns < 9: return Err(trace_codec_issue_v1("column_limit", "", "Graph requires nine origin columns"))
    var budget = TraceCodecTextBudgetV1(max_field_bytes: limits.max_field_bytes, max_text_bytes: limits.max_text_bytes)
    budget.charge([document.snapshot.id, document.snapshot.kind, document.manifest.input_set_id,
        document.manifest.extractor_version, document.manifest.rules_version, document.manifest.policy_id], "manifest")?
    for item in document.inputs: budget.charge([item.path, item.sha256, item.role], "inputs")?
    for item in document.nodes: budget.charge([item.id, item.kind, item.title], "nodes")?
    for item in document.test_definitions:
        budget.charge([item.entity_id, item.test_kind, item.identity_scope, item.definition_id, item.parameter_digest], "test_definitions")?
    for item in document.edges: budget.charge([item.id, item.from_id, item.relation, item.to_id], "edges")?
    for item in document.edge_origins:
        budget.charge([item.edge_id, item.origin_kind, item.origin_id, item.declaration_path, item.extractor_version], "edge_origins")?
    for item in document.locators: budget.charge([item.entity_id, item.path, item.locator_kind, item.locator], "locators")?
    if for_encoding and trace_graph_output_size_v1(document) > trace_graph_output_cap_v1(limits):
        return Err(trace_codec_issue_v1("output_limit", "", "Exact graph output exceeds byte budget before indexes or rows"))
    Ok(true)

export trace_graph_limits_valid_v1, trace_graph_output_cap_v1, trace_graph_preflight_v1
