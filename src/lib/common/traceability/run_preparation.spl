# Pure binding acknowledgement for an owner-prepared v1 run plan.
# @req REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
# This value cannot prove a save, authenticate the writer, or admit evidence.
# The effectful owner emits it only after saving the exact plan successfully.
# Full selection/input closure, shards and attempts require a later contract;
# do not infer those bindings from the v1 request's caller-authored identities.
use std.common.sdn.value.{SdnValue}
use std.common.sdn.parser.{parse_with_spans_and_issues}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.traceability.schema.{trace_sdn_preflight}
use std.common.traceability.run_plan.{TraceRunPlan}
use std.common.traceability.run_plan_codec.{encode_trace_run_plan}
use std.common.traceability.run_request.{TraceRunRequest, materialize_trace_run_plan}
use std.common.traceability.run_request_codec.{encode_trace_run_request}

pub struct TraceRunPreparation:
    request_digest: text
    run_id: text
    plan_digest: text
    evidence_validity: text

fn preparation_digest(source: text) -> text:
    var bytes: [u8] = []
    for byte in source.bytes(): bytes.push(byte)
    "sha256:" + sha256_u8_hex(bytes)

fn preparation_digest_valid(value: text) -> bool:
    if value.len() != 71 or not value.starts_with("sha256:"):
        return false
    val bytes = value.bytes()
    for i in 7..bytes.len():
        val byte = bytes[i].to_i64()
        if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102)):
            return false
    true

fn validate_preparation_fields(value: TraceRunPreparation) -> Result<(), text>:
    if value.run_id == "":
        return Err("trace preparation run identity is empty")
    if value.run_id.len() > 1048576:
        return Err("trace preparation run identity exceeds 1 MiB")
    if not preparation_digest_valid(value.request_digest) or not preparation_digest_valid(value.plan_digest):
        return Err("trace preparation requires canonical SHA-256 digests")
    if value.evidence_validity != "unverified":
        return Err("trace preparation cannot grant evidence validity")
    Ok(())

pub fn build_trace_run_preparation(request: TraceRunRequest, plan: TraceRunPlan) -> Result<TraceRunPreparation, text>:
    val request_source = encode_trace_run_request(request)?
    val expected = materialize_trace_run_plan(request, plan.run_id)?
    val expected_source = encode_trace_run_plan(expected)?
    val plan_source = encode_trace_run_plan(plan)?
    if expected_source != plan_source:
        return Err("trace preparation plan differs from the exact request and allocated run")
    Ok(TraceRunPreparation(request_digest: preparation_digest(request_source), run_id: plan.run_id,
        plan_digest: preparation_digest(plan_source), evidence_validity: "unverified"))

# This establishes equality to the caller's expected request/plan, not that
# the values are trustworthy or that the purported owner durably saved them.
pub fn validate_trace_run_preparation(value: TraceRunPreparation, request: TraceRunRequest, plan: TraceRunPlan) -> Result<(), text>:
    validate_preparation_fields(value)?
    if value.run_id != plan.run_id:
        return Err("trace preparation run identity mismatch")
    val expected = build_trace_run_preparation(request, plan)?
    if value.request_digest != expected.request_digest:
        return Err("trace preparation request digest mismatch")
    if value.plan_digest != expected.plan_digest:
        return Err("trace preparation plan digest mismatch")
    Ok(())

pub fn encode_trace_run_preparation(value: TraceRunPreparation) -> Result<text, text>:
    validate_preparation_fields(value)?
    var fields: Dict<text, SdnValue> = {}
    fields["schema"] = SdnValue.String("simple.trace.run-preparation/v1")
    fields["request_digest"] = SdnValue.String(value.request_digest)
    fields["run_id"] = SdnValue.String(value.run_id)
    fields["plan_digest"] = SdnValue.String(value.plan_digest)
    fields["evidence_validity"] = SdnValue.String(value.evidence_validity)
    val encoded = sdn_encode_canonical(SdnValue.Dict(fields))
    if encoded.len() > 1048576:
        return Err("trace preparation document exceeds 1 MiB")
    Ok(encoded)

fn preparation_text_field(fields: Dict<text, SdnValue>, name: text) -> Result<text, text>:
    match fields[name]:
        case SdnValue.String(value): Ok(value)
        case _: Err("trace preparation field must be text: " + name)

pub fn decode_trace_run_preparation(source: text) -> Result<TraceRunPreparation, text>:
    trace_sdn_preflight(source)?
    val parsed = parse_with_spans_and_issues(source)?
    if parsed.2.len() > 0:
        return Err("invalid or duplicate trace preparation fields")
    val fields = match parsed.0:
        case SdnValue.Dict(value): value
        case _: return Err("trace preparation must be an SDN dictionary")
    val names = ["schema", "request_digest", "run_id", "plan_digest", "evidence_validity"]
    if fields.len() != names.len():
        return Err("unexpected or missing trace preparation fields")
    for name in names:
        if not fields.contains_key(name):
            return Err("missing trace preparation field: " + name)
    if preparation_text_field(fields, "schema")? != "simple.trace.run-preparation/v1":
        return Err("unsupported trace preparation schema")
    val value = TraceRunPreparation(
        request_digest: preparation_text_field(fields, "request_digest")?,
        run_id: preparation_text_field(fields, "run_id")?,
        plan_digest: preparation_text_field(fields, "plan_digest")?,
        evidence_validity: preparation_text_field(fields, "evidence_validity")?)
    validate_preparation_fields(value)?
    Ok(value)
