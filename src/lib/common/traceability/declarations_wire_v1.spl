"""Declaration schema layout and exact sizes before escaped allocation."""
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical, sdn_encoded_text_size_v1}
use std.common.traceability.declarations_types_v1.*

pub fn trace_declarations_headers_v1(section: text) -> [text]:
    match section:
        case "claims": ["id", "from_id", "relation", "to_id", "origin_id"]
        case "aliases": ["id", "from_id", "to_id", "origin_id"]
        case "exceptions": ["id", "scope_kind", "subject_id", "rule_id", "reason", "owner", "review_state", "expires_available", "expires_at", "origin_id"]
        case "origins": ["id", "origin_kind", "path", "span_available", "line", "column", "extractor_version"]
        case _: []

pub fn trace_declarations_prefix_v1(document: TraceDeclarationsV1) -> text:
    "schema: {name: simple.trace.declarations, version: 1}\nid: " + sdn_encode_canonical(SdnValue.String(document.id)) +
        "\nnamespace: " + sdn_encode_canonical(SdnValue.String(document.namespace)) + "\n"

fn trace_declarations_text_size_v1(fields: [text]) -> i64:
    var size = 0
    for field in fields: size = size + sdn_encoded_text_size_v1(field)
    size

pub fn trace_declarations_output_size_v1(document: TraceDeclarationsV1) -> i64:
    # Caller first enforces hard record/text bounds; sum is below128MiB.
    var size = "schema: {name: simple.trace.declarations, version: 1}\nid: \nnamespace: \n".len() +
        trace_declarations_text_size_v1([document.id, document.namespace])
    for section in ["claims", "aliases", "exceptions", "origins"]:
        size = size + section.len() + 4 + trace_declarations_headers_v1(section).join(", ").len()
    for item in document.claims:
        size = size + 13 + trace_declarations_text_size_v1([item.id, item.from_id, item.relation, item.to_id, item.origin_id])
    for item in document.aliases:
        size = size + 11 + trace_declarations_text_size_v1([item.id, item.from_id, item.to_id, item.origin_id])
    for item in document.exceptions:
        size = size + 23 + trace_declarations_text_size_v1([item.id, item.scope_kind, item.subject_id, item.rule_id, item.reason,
            item.owner, item.review_state, item.expires_at, item.origin_id]) + (if item.expires_available: 4 else: 5)
    for item in document.origins:
        size = size + 17 + trace_declarations_text_size_v1([item.id, item.origin_kind, item.path, item.extractor_version]) +
            (if item.span_available: 4 else: 5) + item.line.to_text().len() + item.column.to_text().len()
    size

pub fn trace_declarations_rows_v1(document: TraceDeclarationsV1, section: text) -> [[SdnValue]]:
    var rows: [[SdnValue]] = []
    match section:
        case "claims":
            for item in document.claims:
                rows.push([SdnValue.String(item.id), SdnValue.String(item.from_id), SdnValue.String(item.relation), SdnValue.String(item.to_id), SdnValue.String(item.origin_id)])
        case "aliases":
            for item in document.aliases:
                rows.push([SdnValue.String(item.id), SdnValue.String(item.from_id), SdnValue.String(item.to_id), SdnValue.String(item.origin_id)])
        case "exceptions":
            for item in document.exceptions:
                rows.push([SdnValue.String(item.id), SdnValue.String(item.scope_kind), SdnValue.String(item.subject_id), SdnValue.String(item.rule_id),
                    SdnValue.String(item.reason), SdnValue.String(item.owner), SdnValue.String(item.review_state), SdnValue.Bool(item.expires_available), SdnValue.String(item.expires_at), SdnValue.String(item.origin_id)])
        case "origins":
            for item in document.origins:
                rows.push([SdnValue.String(item.id), SdnValue.String(item.origin_kind), SdnValue.String(item.path), SdnValue.Bool(item.span_available),
                    SdnValue.Int(item.line), SdnValue.Int(item.column), SdnValue.String(item.extractor_version)])
        case _: ()
    rows

export trace_declarations_headers_v1, trace_declarations_prefix_v1
export trace_declarations_output_size_v1, trace_declarations_rows_v1
