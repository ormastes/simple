"""Bounded canonical declaration tables with preserved conflicting intent."""
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}
use std.common.traceability.declarations_types_v1.*
use std.common.traceability.declarations_wire_v1.*
use std.common.traceability.declarations_schema_v1.{trace_declarations_validate_v1}
use std.common.traceability.codec_order_v1.{trace_codec_row_order_v1}

pub fn trace_declarations_encode_v1(document: TraceDeclarationsV1, limits: TraceDeclarationsCodecLimitsV1) -> Result<text, TraceCodecIssueV1>:
    trace_declarations_validate_v1(document, limits, true)?
    val expected = trace_declarations_output_size_v1(document)
    val cap = if limits.max_output_bytes < limits.sdn.max_source_bytes: limits.max_output_bytes else: limits.sdn.max_source_bytes
    var parts: [text] = [trace_declarations_prefix_v1(document)]
    for section in ["claims", "aliases", "exceptions", "origins"]:
        parts.push(section + " |" + trace_declarations_headers_v1(section).join(", ") + "|\n")
        var keys: [text] = []
        for row in trace_declarations_rows_v1(document, section):
            val encoded = sdn_encode_canonical(SdnValue.Table([], [row]))
            keys.push(encoded[3:encoded.len()])
        for index in trace_codec_row_order_v1(keys): parts.push("    " + keys[index] + "\n")
    val output = parts.join("")
    if output.len() != expected or output.len() > cap: return Err(trace_codec_issue_v1("output_limit", "", "Declaration writer disagrees with exact preflight"))
    Ok(output)

export trace_declarations_encode_v1
