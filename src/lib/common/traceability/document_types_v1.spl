"""Explicit supported-family union and one authoritative strict budget."""
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1, sdn_strict_limits_v1}
use std.common.traceability.qualification_types_v1.{TraceQualificationV1}
use std.common.traceability.graph_types_v1.{TraceGraphV1}
use std.common.traceability.declarations_types_v1.{TraceDeclarationsV1}
use std.common.traceability.declarations_types_v2.{TraceDeclarationsV2}

pub enum TraceDocumentV1:
    Qualification(TraceQualificationV1)
    Graph(TraceGraphV1)
    Declarations(TraceDeclarationsV1)
    DeclarationsV2(TraceDeclarationsV2)

pub struct TraceDocumentCodecLimitsV1:
    sdn: SdnStrictLimitsV1
    max_text_bytes: i64 = 1048576
    max_output_bytes: i64 = 1048576
    max_table_records: i64 = 100000
    max_table_field_bytes: i64 = 4096
    max_selectors: i64 = 4096
    max_diagnostics: i64 = 100000

pub fn trace_document_codec_limits_v1() -> TraceDocumentCodecLimitsV1:
    TraceDocumentCodecLimitsV1(sdn: sdn_strict_limits_v1())

export TraceDocumentV1, TraceDocumentCodecLimitsV1, trace_document_codec_limits_v1
