"""One strict parse, then exact graph fields and normalized reference closure."""
use std.common.sdn.value.{SdnValue}
use std.common.sdn.value_limits_v1.{sdn_validate_value_limits_v1}
use std.common.sdn.strict_v1.{sdn_parse_strict_v1}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, TraceSnapshotV1, trace_codec_issue_v1}
use std.common.traceability.graph_types_v1.*
use std.common.traceability.graph_fields_v1.*
use std.common.traceability.graph_wire_v1.{trace_graph_headers_v1}
use std.common.traceability.graph_budget_v1.{trace_graph_limits_valid_v1}
use std.common.traceability.graph_schema_v1.{trace_graph_validate_v1}

fn trace_graph_value_decode_v1(value: SdnValue, limits: TraceGraphCodecLimitsV1) -> Result<TraceGraphV1, TraceCodecIssueV1>:
    var envelope: Dict<text, SdnValue> = {}
    match value:
        case Dict(fields): envelope = fields
        case _: return Err(trace_codec_issue_v1("wrong_type", "", "Expected graph dictionary"))
    if not envelope.contains_key("schema"): return Err(trace_codec_issue_v1("missing_field", "schema", "Missing schema declaration"))
    val schema = trace_graph_dict_v1(envelope["schema"], "schema", ["name", "version"])?
    val family = trace_graph_text_v1(schema["name"], "schema.name")?
    if family != "simple.trace.graph": return Err(trace_codec_issue_v1("unsupported_family", "schema.name", "Graph decoder does not support this family"))
    val version = trace_graph_int_v1(schema["version"], "schema.version")?
    if version != 1: return Err(trace_codec_issue_v1("schema_version", "schema.version", "Unsupported graph schema major"))
    val root = trace_graph_dict_v1(value, "", ["schema", "snapshot", "manifest", "inputs", "nodes", "test_definitions", "edges", "edge_origins", "locators"])?
    # Check the aggregate count before column reordering or typed collections.
    var count = 0
    for section in ["inputs", "nodes", "test_definitions", "edges", "edge_origins", "locators"]:
        match root[section]:
            case Table(_, rows):
                if rows.len() > limits.max_records - count: return Err(trace_codec_issue_v1("record_limit", section, "Graph exceeds record budget"))
                count = count + rows.len()
            case _: return Err(trace_codec_issue_v1("wrong_type", section, "Expected named table"))
    val snapshot_fields = trace_graph_dict_v1(root["snapshot"], "snapshot", ["id", "kind", "complete"])?
    val snapshot = TraceSnapshotV1(id: trace_graph_text_v1(snapshot_fields["id"], "snapshot.id")?,
        kind: trace_graph_text_v1(snapshot_fields["kind"], "snapshot.kind")?,
        complete: trace_graph_bool_v1(snapshot_fields["complete"], "snapshot.complete")?)
    val manifest_fields = trace_graph_dict_v1(root["manifest"], "manifest", ["input_set_id", "extractor_version", "rules_version", "policy_id", "complete"])?
    val manifest = TraceGraphManifestV1(input_set_id: trace_graph_text_v1(manifest_fields["input_set_id"], "manifest.input_set_id")?,
        extractor_version: trace_graph_text_v1(manifest_fields["extractor_version"], "manifest.extractor_version")?,
        rules_version: trace_graph_text_v1(manifest_fields["rules_version"], "manifest.rules_version")?,
        policy_id: trace_graph_text_v1(manifest_fields["policy_id"], "manifest.policy_id")?,
        complete: trace_graph_bool_v1(manifest_fields["complete"], "manifest.complete")?)
    var inputs: [TraceGraphInputV1] = []
    var index = 0
    for row in trace_graph_table_v1(root["inputs"], "inputs", trace_graph_headers_v1("inputs"))?:
        val path = "inputs." + index.to_text()
        inputs.push(TraceGraphInputV1(path: trace_graph_text_v1(row[0], path + ".path")?, sha256: trace_graph_text_v1(row[1], path + ".sha256")?,
            bytes: trace_graph_int_v1(row[2], path + ".bytes")?, role: trace_graph_text_v1(row[3], path + ".role")?))
        index = index + 1
    var nodes: [TraceGraphNodeV1] = []
    index = 0
    for row in trace_graph_table_v1(root["nodes"], "nodes", trace_graph_headers_v1("nodes"))?:
        val path = "nodes." + index.to_text()
        nodes.push(TraceGraphNodeV1(id: trace_graph_text_v1(row[0], path + ".id")?, kind: trace_graph_text_v1(row[1], path + ".kind")?, title: trace_graph_text_v1(row[2], path + ".title")?))
        index = index + 1
    var definitions: [TraceGraphTestDefinitionV1] = []
    index = 0
    for row in trace_graph_table_v1(root["test_definitions"], "test_definitions", trace_graph_headers_v1("test_definitions"))?:
        val path = "test_definitions." + index.to_text()
        definitions.push(TraceGraphTestDefinitionV1(entity_id: trace_graph_text_v1(row[0], path + ".entity_id")?,
            test_kind: trace_graph_text_v1(row[1], path + ".test_kind")?, identity_scope: trace_graph_text_v1(row[2], path + ".identity_scope")?,
            definition_id: trace_graph_text_v1(row[3], path + ".definition_id")?, parameter_digest_available: trace_graph_bool_v1(row[4], path + ".parameter_digest_available")?,
            parameter_digest: trace_graph_text_v1(row[5], path + ".parameter_digest")?))
        index = index + 1
    var edges: [TraceGraphEdgeV1] = []
    index = 0
    for row in trace_graph_table_v1(root["edges"], "edges", trace_graph_headers_v1("edges"))?:
        val path = "edges." + index.to_text()
        edges.push(TraceGraphEdgeV1(id: trace_graph_text_v1(row[0], path + ".id")?, from_id: trace_graph_text_v1(row[1], path + ".from_id")?,
            relation: trace_graph_text_v1(row[2], path + ".relation")?, to_id: trace_graph_text_v1(row[3], path + ".to_id")?))
        index = index + 1
    var origins: [TraceGraphOriginV1] = []
    index = 0
    for row in trace_graph_table_v1(root["edge_origins"], "edge_origins", trace_graph_headers_v1("edge_origins"))?:
        val path = "edge_origins." + index.to_text()
        origins.push(TraceGraphOriginV1(edge_id: trace_graph_text_v1(row[0], path + ".edge_id")?, origin_kind: trace_graph_text_v1(row[1], path + ".origin_kind")?,
            origin_id: trace_graph_text_v1(row[2], path + ".origin_id")?, declaration_path_available: trace_graph_bool_v1(row[3], path + ".declaration_path_available")?,
            declaration_path: trace_graph_text_v1(row[4], path + ".declaration_path")?, span_available: trace_graph_bool_v1(row[5], path + ".span_available")?,
            line: trace_graph_int_v1(row[6], path + ".line")?, column: trace_graph_int_v1(row[7], path + ".column")?, extractor_version: trace_graph_text_v1(row[8], path + ".extractor_version")?))
        index = index + 1
    var locators: [TraceGraphLocatorV1] = []
    index = 0
    for row in trace_graph_table_v1(root["locators"], "locators", trace_graph_headers_v1("locators"))?:
        val path = "locators." + index.to_text()
        locators.push(TraceGraphLocatorV1(entity_id: trace_graph_text_v1(row[0], path + ".entity_id")?, path_available: trace_graph_bool_v1(row[1], path + ".path_available")?,
            path: trace_graph_text_v1(row[2], path + ".path")?, locator_kind: trace_graph_text_v1(row[3], path + ".locator_kind")?, locator: trace_graph_text_v1(row[4], path + ".locator")?))
        index = index + 1
    val document = TraceGraphV1(snapshot: snapshot, manifest: manifest, inputs: inputs, nodes: nodes, test_definitions: definitions, edges: edges, edge_origins: origins, locators: locators)
    trace_graph_validate_v1(document, limits)?
    Ok(document)

pub fn trace_graph_from_value_v1(value: SdnValue, limits: TraceGraphCodecLimitsV1) -> Result<TraceGraphV1, TraceCodecIssueV1>:
    if not trace_graph_limits_valid_v1(limits): return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits outside hard bounds"))
    match sdn_validate_value_limits_v1(value, limits.sdn):
        case Ok(_): ()
        case Err(issue): return Err(trace_codec_issue_v1(issue.code, "", issue.message))
    trace_graph_value_decode_v1(value, limits)

pub fn trace_graph_decode_v1(source: text, limits: TraceGraphCodecLimitsV1) -> Result<TraceGraphV1, TraceCodecIssueV1>:
    if not trace_graph_limits_valid_v1(limits): return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits are outside hard bounds"))
    match sdn_parse_strict_v1(source, limits.sdn):
        case Ok(parsed): trace_graph_from_value_v1(parsed.value, limits)
        case Err(issue):
            val located = issue.code != "invalid_limits" and issue.code != "source_limit"
            Err(TraceCodecIssueV1(code: issue.code, path: "", message: issue.message,
                location_available: located, offset: issue.offset, line: if located: issue.line else: 0, column: if located: issue.column else: 0))

export trace_graph_decode_v1, trace_graph_from_value_v1
