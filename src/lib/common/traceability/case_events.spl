# Actual framework events are transport, not trusted qualification receipts.
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.sdn.parser.{parse_with_spans_and_issues}

# Per-event facts the runner can record cheaply. All optional: events written
# before these existed decode with every fact absent (never a guessed value).
pub struct TestEventAtMicros:
    value: i64

pub struct TestFailureSummary:
    value: text

pub struct TestHostTriple:
    value: text

pub struct TestBackendName:
    value: text

pub struct TraceCaseFacts:
    at: TestEventAtMicros? = None
    failure: TestFailureSummary? = None
    host: TestHostTriple? = None
    backend: TestBackendName? = None

pub struct TraceCaseEvent:
    case_name: text
    phase: text
    outcome: text
    facts: TraceCaseFacts? = None

pub fn encode_trace_case_event(event: TraceCaseEvent) -> text:
    var fields: Dict<text, SdnValue> = {}
    fields["schema"] = SdnValue.String("simple.trace.case-event/v1")
    fields["case_name"] = SdnValue.String(event.case_name)
    fields["phase"] = SdnValue.String(event.phase)
    fields["outcome"] = SdnValue.String(event.outcome)
    match event.facts:
        case Some(facts):
            match facts.at:
                case Some(at): fields["at_micros"] = SdnValue.Int(at.value)
                case None: pass
            match facts.failure:
                case Some(failure): fields["failure"] = SdnValue.String(failure.value)
                case None: pass
            match facts.host:
                case Some(host): fields["host"] = SdnValue.String(host.value)
                case None: pass
            match facts.backend:
                case Some(backend): fields["backend"] = SdnValue.String(backend.value)
                case None: pass
        case None: pass
    sdn_encode_canonical(SdnValue.Dict(fields))

# Canonical SDN payload is single-line even when case names contain newlines.
# An incomplete/truncated payload remains unparsable, never silently omitted.
pub fn collect_trace_case_events(output: text) -> text:
    var records: [text] = []
    val marker = "SIMPLE_TRACE_CASE_EVENT "
    for line in output.split("\n"):
        if line.starts_with(marker):
            records.push(line.substring(marker.len(), line.byte_len()).trim())
    if records.len() == 0:
        return ""
    "[" + records.join(", ") + "]"

# Sidecar framing: one complete canonical SDN dictionary document per LF.
# A final partial document is included so the decoder rejects it explicitly.
pub fn collect_trace_event_documents(source: text) -> text:
    var documents: [text] = []
    for line in source.split("\n"):
        if line.trim() != "":
            documents.push(line.trim())
    if documents.len() == 0:
        return ""
    "[" + documents.join(", ") + "]"

fn event_text(fields: Dict<text, SdnValue>, name: text) -> Result<text, text>:
    if not fields.contains_key(name):
        return Err("missing case-event field: " + name)
    match fields[name]:
        case SdnValue.String(value): Ok(value)
        case _: Err("case-event field must be text: " + name)

fn event_optional_text(fields: Dict<text, SdnValue>, name: text) -> Result<text?, text>:
    if not fields.contains_key(name):
        return Ok(None)
    Ok(Some(event_text(fields, name)?))

# Optional facts: only the known extra keys are accepted; a wrong type is an
# error, an absent key is an absent fact.
fn decode_event_facts(fields: Dict<text, SdnValue>) -> Result<TraceCaseFacts?, text>:
    for key in fields.keys():
        if key != "schema" and key != "case_name" and key != "phase" and key != "outcome" and key != "at_micros" and key != "failure" and key != "host" and key != "backend":
            return Err("unsupported case-event field: " + key)
    var at: TestEventAtMicros? = None
    if fields.contains_key("at_micros"):
        match fields["at_micros"]:
            case SdnValue.Int(micros):
                if micros < 0:
                    return Err("case-event at_micros must not be negative")
                at = Some(TestEventAtMicros(value: micros))
            case _: return Err("case-event field must be an integer: at_micros")
    var failure: TestFailureSummary? = None
    val failure_raw = event_optional_text(fields, "failure")?
    match failure_raw:
        case Some(text_value): failure = Some(TestFailureSummary(value: text_value))
        case None: pass
    var host: TestHostTriple? = None
    val host_raw = event_optional_text(fields, "host")?
    match host_raw:
        case Some(text_value): host = Some(TestHostTriple(value: text_value))
        case None: pass
    var backend: TestBackendName? = None
    val backend_raw = event_optional_text(fields, "backend")?
    match backend_raw:
        case Some(text_value): backend = Some(TestBackendName(value: text_value))
        case None: pass
    if fields.len() == 4:
        return Ok(None)
    Ok(Some(TraceCaseFacts(at: at, failure: failure, host: host, backend: backend)))

pub fn decode_trace_case_events(source: text) -> Result<[TraceCaseEvent], text>:
    if source == "" or source.len() > 4194304:
        return Err("case-event evidence absent or exceeds 4 MiB")
    val parsed = parse_with_spans_and_issues(source)?
    if parsed.2.len() > 0:
        return Err("invalid or duplicate case-event fields")
    val values = match parsed.0:
        case SdnValue.Array(items): items
        case _: return Err("case-event transport must be an SDN array")
    if values.len() > 65536:
        return Err("case-event transport exceeds 65536 events")
    var events: [TraceCaseEvent] = []
    for value in values:
        val fields = match value:
            case SdnValue.Dict(items): items
            case _: return Err("case-event must be a dictionary")
        if event_text(fields, "schema")? != "simple.trace.case-event/v1":
            return Err("unsupported case-event schema")
        val name = event_text(fields, "case_name")?
        val phase = event_text(fields, "phase")?
        val outcome = event_text(fields, "outcome")?
        val facts = decode_event_facts(fields)?
        if name == "":
            return Err("case-event name is empty")
        if phase == "started":
            if outcome != "not_finished":
                return Err("started event cannot claim an outcome")
        elif phase == "finished":
            if outcome != "passed" and outcome != "failed" and outcome != "pending":
                return Err("unknown case outcome")
        else:
            return Err("unknown case-event phase")
        events.push(TraceCaseEvent(case_name: name, phase: phase, outcome: outcome, facts: facts))
    Ok(events)

pub fn trace_case_events_completed(events: [TraceCaseEvent]) -> Result<[TraceCaseEvent], text>:
    var started: [text] = []
    var finished: [TraceCaseEvent] = []
    for event in events:
        if event.phase == "started":
            for prior in started:
                if prior == event.case_name:
                    return Err("duplicate case identity in event stream: " + event.case_name)
            started.push(event.case_name)
        else:
            var found = false
            for name in started:
                if name == event.case_name:
                    found = true
            if not found:
                return Err("case finished without a start event: " + event.case_name)
            for prior in finished:
                if prior.case_name == event.case_name:
                    return Err("case has multiple terminal events: " + event.case_name)
            finished.push(event)
    if started.len() == 0 or started.len() != finished.len():
        return Err("case-event stream is empty or interrupted")
    Ok(finished)
