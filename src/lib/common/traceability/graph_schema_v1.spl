"""Normalized data closure. This validator does not authenticate evidence."""
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}
use std.common.traceability.graph_types_v1.*
use std.common.traceability.graph_fields_v1.*
use std.common.traceability.graph_budget_v1.{trace_graph_preflight_v1}
use std.common.traceability.graph_wire_v1.{trace_graph_tuple_key_v1}

fn trace_graph_is_test_v1(kind: text) -> bool:
    kind == "test_case" or kind == "parameterized_case"

fn trace_graph_relation_valid_v1(relation: text, source: text, target: text, target_role: text) -> bool:
    val source_test = trace_graph_is_test_v1(source)
    val target_test = trace_graph_is_test_v1(target)
    match relation:
        case "specifies": source == "feature" and target == "requirement"
        case "decomposes_to": source == "requirement" and target == "criterion"
        case "accepted_by": source == "criterion" and target_test and target_role == "acceptance"
        case "verified_by": ["requirement", "criterion"].contains(source) and target_test and ["unit", "integration", "component"].contains(target_role)
        case "targets": source_test and ["source_file", "symbol", "component"].contains(target)
        case "implemented_by": ["feature", "requirement"].contains(source) and ["source_file", "symbol", "component"].contains(target)
        case "motivated_by": ["feature", "requirement"].contains(source) and ["research_section", "decision"].contains(target)
        case "described_by": ["feature", "component"].contains(source) and ["design_section", "architecture_section"].contains(target)
        case "belongs_to": ["component", "layer", "feature"].contains(target)
        case "generated_from": source == "generated_document" and ["test_suite", "graph"].contains(target)
        case "observed_in": source_test and target == "observation"
        case "produced": source == "observation" and target == "evidence_artifact"
        case "depends_on": (source_test or ["component", "symbol"].contains(source)) and (target_test or ["component", "symbol", "source_file"].contains(target))
        case "aliases": source == target
        case "supersedes": source == target
        case _: false

fn trace_graph_acyclic_v1(edges: [TraceGraphEdgeV1], relation: text) -> Result<bool, TraceCodecIssueV1>:
    var indegree: Dict<text, i64> = {}
    var adjacency: Dict<text, [text]> = {}
    for edge in edges:
        if edge.relation == relation:
            if not indegree.contains_key(edge.from_id): indegree[edge.from_id] = 0
            if not indegree.contains_key(edge.to_id): indegree[edge.to_id] = 0
            indegree[edge.to_id] = indegree[edge.to_id] + 1
            var children: [text] = []
            if adjacency.contains_key(edge.from_id): children = adjacency[edge.from_id]
            children.push(edge.to_id)
            adjacency[edge.from_id] = children
    var queue: [text] = []
    for identity in indegree.keys():
        if indegree[identity] == 0: queue.push(identity)
    var cursor = 0
    while cursor < queue.len():
        val identity = queue[cursor]
        if adjacency.contains_key(identity):
            for child in adjacency[identity]:
                indegree[child] = indegree[child] - 1
                if indegree[child] == 0: queue.push(child)
        cursor = cursor + 1
    if cursor != indegree.keys().len():
        return Err(trace_codec_issue_v1("cyclic_relation", "edges", "Cycle in acyclic relation " + relation))
    Ok(true)

pub fn trace_graph_validate_v1(document: TraceGraphV1, limits: TraceGraphCodecLimitsV1, for_encoding: bool = false) -> Result<bool, TraceCodecIssueV1>:
    trace_graph_preflight_v1(document, limits, for_encoding)?
    trace_graph_id_check_v1(document.snapshot.id, "snapshot.id")?
    trace_graph_enum_check_v1(document.snapshot.kind, ["worktree", "index", "git", "sj"], "snapshot.kind")?
    trace_graph_id_check_v1(document.manifest.input_set_id, "manifest.input_set_id")?
    trace_graph_id_check_v1(document.manifest.extractor_version, "manifest.extractor_version")?
    trace_graph_id_check_v1(document.manifest.rules_version, "manifest.rules_version")?
    trace_graph_id_check_v1(document.manifest.policy_id, "manifest.policy_id")?
    if document.snapshot.complete and not document.manifest.complete:
        return Err(trace_codec_issue_v1("inconsistent_result", "manifest.complete", "Complete snapshot requires complete manifest data"))
    var inputs: Dict<text, bool> = {}
    var index = 0
    for item in document.inputs:
        val path = "inputs." + index.to_text()
        if not trace_graph_path_valid_v1(item.path): return Err(trace_codec_issue_v1("invalid_path", path + ".path", "Repository-relative path required"))
        if inputs.contains_key(item.path): return Err(trace_codec_issue_v1("duplicate_identifier", path + ".path", "Duplicate manifest path"))
        inputs[item.path] = true
        if not trace_graph_digest_valid_v1(item.sha256): return Err(trace_codec_issue_v1("invalid_digest", path + ".sha256", "Lowercase SHA256 required"))
        if item.bytes < 0: return Err(trace_codec_issue_v1("invalid_counter", path + ".bytes", "Negative byte count"))
        trace_graph_enum_check_v1(item.role, ["source", "test", "document", "policy", "declaration", "evidence"], path + ".role")?
        index = index + 1
    val kinds = ["feature", "requirement", "criterion", "test_suite", "test_case", "parameterized_case",
        "source_file", "symbol", "component", "layer", "transform", "document", "research_section",
        "design_section", "architecture_section", "generated_document", "graph", "observation", "evidence_artifact", "exception", "decision", "bug"]
    var nodes: Dict<text, text> = {}
    index = 0
    for item in document.nodes:
        val path = "nodes." + index.to_text()
        trace_graph_id_check_v1(item.id, path + ".id")?
        trace_graph_enum_check_v1(item.kind, kinds, path + ".kind")?
        if nodes.contains_key(item.id): return Err(trace_codec_issue_v1("duplicate_identifier", path + ".id", "Duplicate node identity"))
        nodes[item.id] = item.kind
        index = index + 1
    var definitions: Dict<text, i64> = {}
    var parameters: Dict<text, bool> = {}
    index = 0
    for item in document.test_definitions:
        val path = "test_definitions." + index.to_text()
        if not nodes.contains_key(item.entity_id): return Err(trace_codec_issue_v1("missing_reference", path + ".entity_id", "Test entity is absent"))
        if not trace_graph_is_test_v1(nodes[item.entity_id]): return Err(trace_codec_issue_v1("invalid_definition", path + ".entity_id", "Only test entities have definitions"))
        if definitions.contains_key(item.entity_id): return Err(trace_codec_issue_v1("duplicate_identifier", path + ".entity_id", "Duplicate test definition"))
        definitions[item.entity_id] = index
        trace_graph_enum_check_v1(item.test_kind, ["acceptance", "unit", "integration", "component", "system", "performance"], path + ".test_kind")?
        trace_graph_enum_check_v1(item.identity_scope, ["stable", "revision"], path + ".identity_scope")?
        if nodes[item.entity_id] == "test_case":
            if item.definition_id != item.entity_id or item.parameter_digest_available or item.parameter_digest != "":
                return Err(trace_codec_issue_v1("invalid_definition", path, "Ordinary definition identity/digest contradicts its entity"))
        else:
            if not nodes.contains_key(item.definition_id): return Err(trace_codec_issue_v1("missing_reference", path + ".definition_id", "Parameterized base is absent"))
            if nodes[item.definition_id] != "test_case" or not item.parameter_digest_available or not trace_graph_digest_valid_v1(item.parameter_digest):
                return Err(trace_codec_issue_v1("invalid_definition", path, "Parameterized case requires ordinary base and digest"))
            val key = trace_graph_tuple_key_v1([item.definition_id, item.parameter_digest])
            if parameters.contains_key(key): return Err(trace_codec_issue_v1("duplicate_parameter", path, "Duplicate parameter identity for base definition"))
            parameters[key] = true
        index = index + 1
    for item in document.nodes:
        if trace_graph_is_test_v1(item.kind) and not definitions.contains_key(item.id):
            return Err(trace_codec_issue_v1("missing_reference", "test_definitions", "Test entity needs exactly one definition"))
    for item in document.test_definitions:
        if nodes[item.entity_id] == "parameterized_case":
            val base = document.test_definitions[definitions[item.definition_id]]
            if item.test_kind != base.test_kind or item.identity_scope != base.identity_scope:
                return Err(trace_codec_issue_v1("invalid_definition", "test_definitions", "Parameterized role/scope must match ordinary base"))
    var edge_ids: Dict<text, bool> = {}
    var edge_tuples: Dict<text, bool> = {}
    var aliases: Dict<text, bool> = {}
    index = 0
    for item in document.edges:
        val path = "edges." + index.to_text()
        trace_graph_id_check_v1(item.id, path + ".id")?
        if edge_ids.contains_key(item.id): return Err(trace_codec_issue_v1("duplicate_identifier", path + ".id", "Duplicate edge identity"))
        edge_ids[item.id] = true
        if not nodes.contains_key(item.from_id): return Err(trace_codec_issue_v1("missing_reference", path + ".from_id", "Missing edge source"))
        if not nodes.contains_key(item.to_id): return Err(trace_codec_issue_v1("missing_reference", path + ".to_id", "Missing edge target"))
        var target_role = ""
        if definitions.contains_key(item.to_id): target_role = document.test_definitions[definitions[item.to_id]].test_kind
        if not trace_graph_relation_valid_v1(item.relation, nodes[item.from_id], nodes[item.to_id], target_role):
            return Err(trace_codec_issue_v1("invalid_relation", path + ".relation", "Unknown relation or incompatible endpoints"))
        if (item.relation == "aliases" or item.relation == "supersedes") and definitions.contains_key(item.from_id):
            val source = document.test_definitions[definitions[item.from_id]]
            val target = document.test_definitions[definitions[item.to_id]]
            if source.test_kind != target.test_kind or source.identity_scope != target.identity_scope:
                return Err(trace_codec_issue_v1("invalid_relation", path + ".relation", "Historical test identities require same role/scope"))
        # Endpoints are resolved node IDs; aliases are retained, never folded.
        val key = trace_graph_tuple_key_v1([item.from_id, item.relation, item.to_id])
        if edge_tuples.contains_key(key): return Err(trace_codec_issue_v1("duplicate_edge", path, "Duplicate normalized endpoint/relation tuple"))
        edge_tuples[key] = true
        if item.relation == "aliases":
            if aliases.contains_key(item.from_id): return Err(trace_codec_issue_v1("alias_conflict", path, "Alias has multiple outgoing targets"))
            aliases[item.from_id] = true
        index = index + 1
    var origin_keys: Dict<text, bool> = {}
    var originated: Dict<text, bool> = {}
    index = 0
    for item in document.edge_origins:
        val path = "edge_origins." + index.to_text()
        if not edge_ids.contains_key(item.edge_id): return Err(trace_codec_issue_v1("missing_reference", path + ".edge_id", "Origin edge is absent"))
        trace_graph_enum_check_v1(item.origin_kind, ["explicit", "annotation", "convention", "compiler_index", "runtime_observation"], path + ".origin_kind")?
        trace_graph_id_check_v1(item.origin_id, path + ".origin_id")?
        trace_graph_id_check_v1(item.extractor_version, path + ".extractor_version")?
        if item.declaration_path_available != (item.declaration_path != ""):
            return Err(trace_codec_issue_v1("invalid_location", path + ".declaration_path", "Path availability contradicts text"))
        if item.declaration_path_available and not inputs.contains_key(item.declaration_path):
            return Err(trace_codec_issue_v1("missing_reference", path + ".declaration_path", "Located origin must resolve to manifest input"))
        if ((item.span_available and (not item.declaration_path_available or item.line < 1 or item.column < 1)) or
            (not item.span_available and (item.line != 0 or item.column != 0))):
            return Err(trace_codec_issue_v1("invalid_location", path, "Span coordinates contradict availability"))
        val key = trace_graph_tuple_key_v1([item.edge_id, item.origin_kind, item.origin_id,
            item.declaration_path_available.to_text(), item.declaration_path, item.span_available.to_text(),
            item.line.to_text(), item.column.to_text(), item.extractor_version])
        if origin_keys.contains_key(key): return Err(trace_codec_issue_v1("duplicate_record", path, "Duplicate corroborating origin record"))
        origin_keys[key] = true
        originated[item.edge_id] = true
        index = index + 1
    for item in document.edges:
        if not originated.contains_key(item.id): return Err(trace_codec_issue_v1("missing_origin", "edge_origins", "Every normalized edge needs provenance"))
    var locator_keys: Dict<text, bool> = {}
    index = 0
    for item in document.locators:
        val path = "locators." + index.to_text()
        if not nodes.contains_key(item.entity_id): return Err(trace_codec_issue_v1("missing_reference", path + ".entity_id", "Locator entity is absent"))
        trace_graph_enum_check_v1(item.locator_kind, ["file", "symbol", "scenario", "section", "cas"], path + ".locator_kind")?
        if item.path_available != (item.path != ""): return Err(trace_codec_issue_v1("invalid_location", path + ".path", "Path availability contradicts text"))
        if item.locator_kind == "cas":
            if item.path_available or not item.locator.starts_with("sha256:") or not trace_graph_digest_valid_v1(item.locator[7:item.locator.len()]):
                return Err(trace_codec_issue_v1("invalid_location", path, "CAS requires exact SHA256 reference and unavailable path"))
        else:
            if not item.path_available: return Err(trace_codec_issue_v1("invalid_location", path + ".path", "Source locator requires available path"))
            if not inputs.contains_key(item.path): return Err(trace_codec_issue_v1("missing_reference", path + ".path", "Locator path is absent from manifest"))
            if (item.locator_kind == "file" and item.locator != "") or (item.locator_kind != "file" and item.locator == ""):
                return Err(trace_codec_issue_v1("invalid_location", path + ".locator", "Locator text contradicts its kind"))
        val key = trace_graph_tuple_key_v1([item.entity_id, item.path_available.to_text(), item.path, item.locator_kind, item.locator])
        if locator_keys.contains_key(key): return Err(trace_codec_issue_v1("duplicate_record", path, "Duplicate locator record"))
        locator_keys[key] = true
        index = index + 1
    trace_graph_acyclic_v1(document.edges, "belongs_to")?
    trace_graph_acyclic_v1(document.edges, "aliases")?
    Ok(true)

export trace_graph_validate_v1
