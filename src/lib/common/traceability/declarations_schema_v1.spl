"""Validate authored data without resolving claims or granting exceptions."""
use std.common.sdn.strict_v1.{sdn_strict_limits_valid_v1}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}
use std.common.traceability.declarations_types_v1.*
use std.common.traceability.declarations_wire_v1.{trace_declarations_output_size_v1}
use std.common.traceability.codec_fields_v1.*
use std.common.traceability.codec_text_budget_v1.{TraceCodecTextBudgetV1}

pub fn trace_declarations_limits_valid_v1(limits: TraceDeclarationsCodecLimitsV1) -> bool:
    (sdn_strict_limits_valid_v1(limits.sdn) and limits.max_records >= 0 and limits.max_records <= 1000000 and
        limits.max_text_bytes >= 0 and limits.max_text_bytes <= 16777216 and
        limits.max_field_bytes >= 0 and limits.max_field_bytes <= 1048576 and
        limits.max_output_bytes >= 0 and limits.max_output_bytes <= 16777216)

fn trace_declarations_utc_valid_v1(item: text) -> bool:
    if item.len() != 20: return false
    for position in [4, 7]:
        if item.byte_at(position) != 45: return false
    if item.byte_at(10) != 84 or item.byte_at(13) != 58 or item.byte_at(16) != 58 or item.byte_at(19) != 90: return false
    var numbers: [i64] = []
    val starts = [0, 5, 8, 11, 14, 17]
    val widths = [4, 2, 2, 2, 2, 2]
    var part = 0
    for start in starts:
        var value = 0
        var index = start
        while index < start + widths[part]:
            val digit = item.byte_at(index) - 48
            if digit < 0 or digit > 9: return false
            value = value * 10 + digit
            index = index + 1
        numbers.push(value)
        part = part + 1
    val year = numbers[0]
    val month = numbers[1]
    val day = numbers[2]
    if year < 1 or month < 1 or month > 12 or day < 1 or numbers[3] > 23 or numbers[4] > 59 or numbers[5] > 59: return false
    val days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    var maximum = days[month - 1]
    if month == 2 and year % 4 == 0 and (year % 100 != 0 or year % 400 == 0): maximum = 29
    day <= maximum

pub fn trace_declarations_validate_v1(document: TraceDeclarationsV1, limits: TraceDeclarationsCodecLimitsV1, for_encoding: bool = false) -> Result<bool, TraceCodecIssueV1>:
    if not trace_declarations_limits_valid_v1(limits): return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits outside hard bounds"))
    val counts = [document.claims.len(), document.aliases.len(), document.exceptions.len(), document.origins.len()]
    val widths = [5, 4, 10, 7]
    var rows = 0
    var cells = 0
    var index = 0
    for count in counts:
        if count > limits.max_records - rows: return Err(trace_codec_issue_v1("record_limit", "", "Declaration records exceed budget"))
        rows = rows + count
        val charge = count * widths[index]
        if charge > limits.sdn.max_cells - cells: return Err(trace_codec_issue_v1("cell_limit", "", "Declaration cells exceed budget"))
        cells = cells + charge
        index = index + 1
    if rows > limits.sdn.max_rows: return Err(trace_codec_issue_v1("row_limit", "", "Declaration rows exceed budget"))
    if limits.sdn.max_nodes < 45 or cells > limits.sdn.max_nodes - 45: return Err(trace_codec_issue_v1("node_limit", "", "Declaration nodes exceed budget"))
    if limits.sdn.max_depth < 3: return Err(trace_codec_issue_v1("depth_limit", "", "Declarations require depth three"))
    if limits.sdn.max_columns < 10: return Err(trace_codec_issue_v1("column_limit", "", "Exceptions require ten columns"))
    var budget = TraceCodecTextBudgetV1(max_field_bytes: limits.max_field_bytes, max_text_bytes: limits.max_text_bytes)
    budget.charge([document.id, document.namespace], "")?
    for item in document.claims: budget.charge([item.id, item.from_id, item.relation, item.to_id, item.origin_id], "claims")?
    for item in document.aliases: budget.charge([item.id, item.from_id, item.to_id, item.origin_id], "aliases")?
    for item in document.exceptions:
        budget.charge([item.id, item.scope_kind, item.subject_id, item.rule_id, item.reason, item.owner, item.review_state, item.expires_at, item.origin_id], "exceptions")?
    for item in document.origins: budget.charge([item.id, item.origin_kind, item.path, item.extractor_version], "origins")?
    val output_cap = if limits.max_output_bytes < limits.sdn.max_source_bytes: limits.max_output_bytes else: limits.sdn.max_source_bytes
    if for_encoding and trace_declarations_output_size_v1(document) > output_cap:
        return Err(trace_codec_issue_v1("output_limit", "", "Exact declaration output exceeds budget before indexes or rows"))
    trace_codec_id_check_v1(document.id, "id")?
    trace_codec_id_check_v1(document.namespace, "namespace")?
    var origins: Dict<text, bool> = {}
    index = 0
    for item in document.origins:
        val path = "origins." + index.to_text()
        trace_codec_id_check_v1(item.id, path + ".id")?
        if origins.contains_key(item.id): return Err(trace_codec_issue_v1("duplicate_identifier", path + ".id", "Duplicate origin identity"))
        origins[item.id] = true
        trace_codec_enum_check_v1(item.origin_kind, ["explicit", "annotation"], path + ".origin_kind")?
        trace_codec_id_check_v1(item.extractor_version, path + ".extractor_version")?
        if not trace_codec_path_valid_v1(item.path): return Err(trace_codec_issue_v1("invalid_path", path + ".path", "Repository-relative origin path required"))
        if (item.span_available and (item.line < 1 or item.column < 1)) or (not item.span_available and (item.line != 0 or item.column != 0)):
            return Err(trace_codec_issue_v1("invalid_location", path, "Origin span contradicts availability"))
        index = index + 1
    var claims: Dict<text, bool> = {}
    index = 0
    for item in document.claims:
        val path = "claims." + index.to_text()
        trace_codec_id_check_v1(item.id, path + ".id")?
        if claims.contains_key(item.id): return Err(trace_codec_issue_v1("duplicate_identifier", path + ".id", "Duplicate claim identity"))
        claims[item.id] = true
        trace_codec_id_check_v1(item.from_id, path + ".from_id")?
        trace_codec_id_check_v1(item.to_id, path + ".to_id")?
        trace_codec_enum_check_v1(item.relation, ["specifies", "decomposes_to", "accepted_by", "verified_by", "targets", "implemented_by", "motivated_by",
            "described_by", "belongs_to", "generated_from", "observed_in", "produced", "depends_on", "supersedes"], path + ".relation")?
        if not origins.contains_key(item.origin_id): return Err(trace_codec_issue_v1("missing_reference", path + ".origin_id", "Claim origin is absent"))
        index = index + 1
    var aliases: Dict<text, bool> = {}
    index = 0
    for item in document.aliases:
        val path = "aliases." + index.to_text()
        trace_codec_id_check_v1(item.id, path + ".id")?
        if aliases.contains_key(item.id): return Err(trace_codec_issue_v1("duplicate_identifier", path + ".id", "Duplicate alias declaration identity"))
        aliases[item.id] = true
        trace_codec_id_check_v1(item.from_id, path + ".from_id")?
        trace_codec_id_check_v1(item.to_id, path + ".to_id")?
        if not origins.contains_key(item.origin_id): return Err(trace_codec_issue_v1("missing_reference", path + ".origin_id", "Alias origin is absent"))
        index = index + 1
    var exceptions: Dict<text, bool> = {}
    index = 0
    for item in document.exceptions:
        val path = "exceptions." + index.to_text()
        trace_codec_id_check_v1(item.id, path + ".id")?
        if exceptions.contains_key(item.id): return Err(trace_codec_issue_v1("duplicate_identifier", path + ".id", "Duplicate exception identity"))
        exceptions[item.id] = true
        trace_codec_enum_check_v1(item.scope_kind, ["entity", "feature", "requirement", "criterion", "input_path"], path + ".scope_kind")?
        if item.scope_kind == "input_path":
            if not trace_codec_path_valid_v1(item.subject_id): return Err(trace_codec_issue_v1("invalid_path", path + ".subject_id", "Exception input path is invalid"))
        else: trace_codec_id_check_v1(item.subject_id, path + ".subject_id")?
        trace_codec_id_check_v1(item.rule_id, path + ".rule_id")?
        trace_codec_id_check_v1(item.owner, path + ".owner")?
        if item.reason == "": return Err(trace_codec_issue_v1("empty_text", path + ".reason", "Exception requires a reason"))
        trace_codec_enum_check_v1(item.review_state, ["proposed", "reviewed", "rejected", "expired"], path + ".review_state")?
        if (item.expires_available and not trace_declarations_utc_valid_v1(item.expires_at)) or (not item.expires_available and item.expires_at != ""):
            return Err(trace_codec_issue_v1("invalid_expiry", path + ".expires_at", "Expiry availability/UTC calendar value is invalid"))
        if not origins.contains_key(item.origin_id): return Err(trace_codec_issue_v1("missing_reference", path + ".origin_id", "Exception origin is absent"))
        index = index + 1
    Ok(true)

export trace_declarations_limits_valid_v1, trace_declarations_validate_v1
