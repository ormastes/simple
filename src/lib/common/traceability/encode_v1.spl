"""One strict source parse and explicit dispatch of implemented families."""
use std.common.sdn.value.{SdnValue}
use std.common.sdn.strict_v1.{sdn_parse_strict_v1, sdn_strict_limits_valid_v1}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}
use std.common.traceability.document_types_v1.*
use std.common.traceability.qualification_types_v1.{TraceQualificationCodecLimitsV1}
use std.common.traceability.graph_types_v1.{TraceGraphCodecLimitsV1}
use std.common.traceability.declarations_types_v1.{TraceDeclarationsCodecLimitsV1}
use std.common.traceability.codec_fields_v1.{trace_codec_dict_v1, trace_codec_text_v1, trace_codec_int_v1}
use std.common.traceability.qualification_v1.{trace_qualification_from_value_v1, trace_qualification_encode_v1}
use std.common.traceability.graph_v1.{trace_graph_from_value_v1, trace_graph_encode_v1}
use std.common.traceability.declarations_v1.{trace_declarations_from_value_v1, trace_declarations_encode_v1}
use std.common.traceability.declarations_v2.{trace_declarations_from_value_v2, trace_declarations_encode_v2}
export use std.common.traceability.qualification_v1.{trace_qualification_encode_v1}

fn trace_document_limits_valid_v1(limits: TraceDocumentCodecLimitsV1) -> bool:
    (sdn_strict_limits_valid_v1(limits.sdn) and limits.max_text_bytes >= 0 and limits.max_text_bytes <= 16777216 and
        limits.max_output_bytes >= 0 and limits.max_output_bytes <= 16777216 and
        limits.max_table_records >= 0 and limits.max_table_records <= 1000000 and
        limits.max_table_field_bytes >= 0 and limits.max_table_field_bytes <= 1048576 and
        limits.max_selectors >= 0 and limits.max_selectors <= 65536 and
        limits.max_diagnostics >= 0 and limits.max_diagnostics <= 100000)

fn trace_document_qualification_limits_v1(limits: TraceDocumentCodecLimitsV1) -> TraceQualificationCodecLimitsV1:
    TraceQualificationCodecLimitsV1(sdn: limits.sdn, max_selectors: limits.max_selectors, max_diagnostics: limits.max_diagnostics,
        max_text_bytes: limits.max_text_bytes, max_output_bytes: limits.max_output_bytes)

fn trace_document_graph_limits_v1(limits: TraceDocumentCodecLimitsV1) -> TraceGraphCodecLimitsV1:
    TraceGraphCodecLimitsV1(sdn: limits.sdn, max_records: limits.max_table_records, max_field_bytes: limits.max_table_field_bytes,
        max_text_bytes: limits.max_text_bytes, max_output_bytes: limits.max_output_bytes)

fn trace_document_declarations_limits_v1(limits: TraceDocumentCodecLimitsV1) -> TraceDeclarationsCodecLimitsV1:
    TraceDeclarationsCodecLimitsV1(sdn: limits.sdn, max_records: limits.max_table_records, max_field_bytes: limits.max_table_field_bytes,
        max_text_bytes: limits.max_text_bytes, max_output_bytes: limits.max_output_bytes)

pub fn trace_document_decode_v1(source: text, limits: TraceDocumentCodecLimitsV1) -> Result<TraceDocumentV1, TraceCodecIssueV1>:
    if not trace_document_limits_valid_v1(limits): return Err(trace_codec_issue_v1("invalid_limits", "", "Document limits outside hard bounds"))
    var value = SdnValue.Null
    match sdn_parse_strict_v1(source, limits.sdn):
        case Ok(parsed): value = parsed.value
        case Err(issue):
            val located = issue.code != "invalid_limits" and issue.code != "source_limit"
            return Err(TraceCodecIssueV1(code: issue.code, path: "", message: issue.message,
                location_available: located, offset: issue.offset, line: if located: issue.line else: 0, column: if located: issue.column else: 0))
    var fields: Dict<text, SdnValue> = {}
    match value:
        case Dict(items): fields = items
        case _: return Err(trace_codec_issue_v1("wrong_type", "", "Expected document dictionary"))
    if not fields.contains_key("schema"): return Err(trace_codec_issue_v1("missing_field", "schema", "Missing schema declaration"))
    val schema = trace_codec_dict_v1(fields["schema"], "schema", ["name", "version"])?
    val family = trace_codec_text_v1(schema["name"], "schema.name")?
    if not ["simple.trace.qualification", "simple.trace.graph", "simple.trace.declarations"].contains(family):
        return Err(trace_codec_issue_v1("unsupported_family", "schema.name", "Document family is not implemented"))
    val version = trace_codec_int_v1(schema["version"], "schema.version")?
    if family == "simple.trace.declarations" and version == 2:
        return Ok(TraceDocumentV1.DeclarationsV2(trace_declarations_from_value_v2(value, trace_document_declarations_limits_v1(limits))?))
    if version != 1:
        return Err(trace_codec_issue_v1("schema_version", "schema.version", "Unsupported document schema major"))
    match family:
        case "simple.trace.qualification": Ok(TraceDocumentV1.Qualification(trace_qualification_from_value_v1(value, trace_document_qualification_limits_v1(limits))?))
        case "simple.trace.graph": Ok(TraceDocumentV1.Graph(trace_graph_from_value_v1(value, trace_document_graph_limits_v1(limits))?))
        case _: Ok(TraceDocumentV1.Declarations(trace_declarations_from_value_v1(value, trace_document_declarations_limits_v1(limits))?))

pub fn trace_document_encode_v1(document: TraceDocumentV1, limits: TraceDocumentCodecLimitsV1) -> Result<text, TraceCodecIssueV1>:
    if not trace_document_limits_valid_v1(limits): return Err(trace_codec_issue_v1("invalid_limits", "", "Document limits outside hard bounds"))
    match document:
        case Qualification(value): trace_qualification_encode_v1(value, trace_document_qualification_limits_v1(limits))
        case Graph(value): trace_graph_encode_v1(value, trace_document_graph_limits_v1(limits))
        case Declarations(value): trace_declarations_encode_v1(value, trace_document_declarations_limits_v1(limits))
        case DeclarationsV2(value): trace_declarations_encode_v2(value, trace_document_declarations_limits_v1(limits))

export trace_document_decode_v1, trace_document_encode_v1
