"""Closed document dispatch and public canonical qualification encoder facade."""

use std.common.traceability.types_v1.*
use std.common.traceability.qualification_v1.{trace_qualification_decode_v1, trace_qualification_encode_v1}

export use std.common.traceability.qualification_v1.{trace_qualification_encode_v1}

pub fn trace_document_decode_v1(source: text, limits: TraceQualificationCodecLimitsV1) -> Result<TraceDocumentV1, TraceCodecIssueV1>:
    val document = trace_qualification_decode_v1(source, limits)?
    Ok(TraceDocumentV1.Qualification(document))

pub fn trace_document_encode_v1(document: TraceDocumentV1, limits: TraceQualificationCodecLimitsV1) -> Result<text, TraceCodecIssueV1>:
    match document:
        case Qualification(value): trace_qualification_encode_v1(value, limits)

export trace_document_decode_v1, trace_document_encode_v1
