"""Fixed operation layout and exact size before escaped row allocation."""
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encoded_text_size_v1}
use std.common.traceability.declarations_types_v2.*
use std.common.traceability.declarations_wire_v1.{trace_declarations_output_size_v1}

pub fn trace_declarations_headers_v2(section: text) -> [text]:
    if section == "explicit_links":
        ["id", "owner", "from_id", "relation", "to_id", "operation", "replaces_rule", "reason", "origin_id", "exception_id"]
    else: ["operation_id", "from_id", "relation", "to_id"]

pub fn trace_link_fields_v2(item: TraceExplicitLinkV2) -> [text]:
    [item.id, item.owner, item.from_id, item.relation, item.to_id, item.operation, item.replaces_rule, item.reason, item.origin_id, item.exception_id]

pub fn trace_replacement_fields_v2(item: TraceReplacementScopeV2) -> [text]:
    [item.operation_id, item.from_id, item.relation, item.to_id]

pub fn trace_declarations_output_size_v2(document: TraceDeclarationsV2) -> i64:
    var size = trace_declarations_output_size_v1(document.base)
    for section in ["explicit_links", "replacement_scopes"]:
        size = size + section.len() + 4 + trace_declarations_headers_v2(section).join(", ").len()
    for item in document.explicit_links:
        size = size + 23
        for field in trace_link_fields_v2(item): size = size + sdn_encoded_text_size_v1(field)
    for item in document.replacement_scopes:
        size = size + 11
        for field in trace_replacement_fields_v2(item): size = size + sdn_encoded_text_size_v1(field)
    size

pub fn trace_declarations_rows_v2(document: TraceDeclarationsV2, section: text) -> [[SdnValue]]:
    var rows: [[SdnValue]] = []
    if section == "explicit_links":
        for item in document.explicit_links:
            var row: [SdnValue] = []
            for field in trace_link_fields_v2(item): row.push(SdnValue.String(field))
            rows.push(row)
    else:
        for item in document.replacement_scopes:
            var row: [SdnValue] = []
            for field in trace_replacement_fields_v2(item): row.push(SdnValue.String(field))
            rows.push(row)
    rows

export trace_declarations_headers_v2, trace_link_fields_v2, trace_replacement_fields_v2
export trace_declarations_output_size_v2, trace_declarations_rows_v2
