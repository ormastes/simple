"""Supplied convention facts are structural data, never admission authority."""
use std.common.traceability.envelope_types_v1.{TraceCountLimitV1, TraceByteLimitV1}
use std.common.traceability.graph_types_v1.{TraceGraphCodecLimitsV1, trace_graph_codec_limits_v1}
use std.common.traceability.qualification_types_v1.{TraceDiagnosticV1}
use std.common.traceability.envelope_types_v1.*

pub struct TraceConventionRuleV1:
    id: text
    group_id: text
    kind: text
    source_root: text
    target_root: text
    source_suffix: text
    target_suffix: text

pub struct TraceConventionExclusionV1:
    group_id: text
    root: text
    reason: text

pub struct TraceConventionGeneratorBindingV1:
    id: text
    suite_id: text
    document_id: text
    rule_id: text
    generator_id: text
    manifest_path: text
    manifest_sha256: text

pub struct TraceConventionPolicyV1:
    id: text
    version: text
    rules: [TraceConventionRuleV1]
    exclusions: [TraceConventionExclusionV1]
    generator_bindings: [TraceConventionGeneratorBindingV1] = []

pub struct TraceConventionLimitsV1:
    graph: TraceGraphCodecLimitsV1
    max_rules: TraceCountLimitV1 = TraceCountLimitV1(value: 256)
    max_exclusions: TraceCountLimitV1 = TraceCountLimitV1(value: 4096)
    max_bindings: TraceCountLimitV1 = TraceCountLimitV1(value: 4096)
    max_work: TraceCountLimitV1 = TraceCountLimitV1(value: 100000)
    max_claims: TraceCountLimitV1 = TraceCountLimitV1(value: 100000)
    max_diagnostics: TraceCountLimitV1 = TraceCountLimitV1(value: 100000)
    max_lookups: TraceCountLimitV1 = TraceCountLimitV1(value: 100000)
    max_policy_text_bytes: TraceByteLimitV1 = TraceByteLimitV1(value: 1048576)
    max_result_text_bytes: TraceByteLimitV1 = TraceByteLimitV1(value: 1048576)
    max_field_bytes: TraceByteLimitV1 = TraceByteLimitV1(value: 4096)

pub fn trace_convention_limits_v1() -> TraceConventionLimitsV1:
    TraceConventionLimitsV1(graph: trace_graph_codec_limits_v1())

pub struct TraceConventionClaimV1:
    from_id: text
    relation: text
    to_id: text
    rule_id: text
    source_path: text
    target_path: text

pub struct TraceConventionLookupV1:
    kind: text
    entity_id: text
    group_id: text
    rule_id: text
    path: text
    found: TraceLookupOutcomeV1
    candidate_ids: [text]

pub struct TraceConventionResolutionV1:
    snapshot_id: text
    input_set_id: text
    policy_id: text
    rules_version: text
    complete: TraceCompletenessV1
    claims: [TraceConventionClaimV1]
    diagnostics: [TraceDiagnosticV1]
    lookups: [TraceConventionLookupV1]

export TraceConventionRuleV1, TraceConventionExclusionV1, TraceConventionGeneratorBindingV1
export TraceConventionPolicyV1, TraceConventionLimitsV1, trace_convention_limits_v1
export TraceConventionClaimV1, TraceConventionLookupV1, TraceConventionResolutionV1
