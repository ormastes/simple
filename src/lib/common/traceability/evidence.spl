# Pure eligibility checks. Effects and trust admission belong to the runner
# owner; this module cannot certify bytes or a producer it has not observed.
use std.common.traceability.evidence_model.*
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}

pub fn trace_text_has(values: [text], value: text) -> bool:
    for item in values:
        if item == value:
            return true
    false

fn trace_unique_nonempty(values: [text]) -> bool:
    var seen: [text] = []
    for item in values:
        if item == "" or trace_text_has(seen, item):
            return false
        seen.push(item)
    true

fn trace_same_texts(left: [text], right: [text]) -> bool:
    if left.len() != right.len():
        return false
    var index = 0
    while index < left.len():
        if left[index] != right[index]:
            return false
        index = index + 1
    true

pub fn trace_same_observation(left: TraceObservation, right: TraceObservation) -> bool:
    (left.id == right.id and left.run_id == right.run_id and
        left.case_id == right.case_id and left.attempt == right.attempt and
        left.outcome == right.outcome and left.executed == right.executed and
        trace_same_texts(left.artifact_ids, right.artifact_ids))

pub fn trace_observation_admitted(observation: TraceObservation, context: AdmissionContext) -> bool:
    if observation.artifact_ids.len() == 0 or not trace_unique_nonempty(observation.artifact_ids):
        return false
    var matched = 0
    for admitted in context.admitted_observations:
        if admitted.id == observation.id:
            if not trace_same_observation(admitted, observation):
                return false
            matched = matched + 1
    matched == 1

pub fn trace_run_binding_matches(run: TraceRun, context: AdmissionContext) -> bool:
    (run.subject_id == context.subject_id and
        run.input_manifest_id == context.input_manifest_id and
        run.definition_manifest_id == context.definition_manifest_id and
        run.configuration_id == context.configuration_id and
        run.lane_id == context.lane_id and run.binary_id == context.binary_id and
        run.expectation_id == context.expectation_id)

pub fn trace_run_problems(run: TraceRun) -> [text]:
    var problems: [text] = []
    if (run.id == "" or run.subject_id == "" or run.input_manifest_id == "" or
        run.definition_manifest_id == "" or run.configuration_id == "" or
        run.lane_id == "" or run.binary_id == "" or run.expectation_id == ""):
        problems.push("TRC_RUN_IDENTITY: missing immutable run binding")
    if run.completion != TraceCompletion.Complete:
        problems.push("TRC_RUN_INCOMPLETE: run did not finish normally")
    if run.planned_case_ids.len() == 0:
        problems.push("TRC_ZERO_CASES: no planned cases")
    if not trace_unique_nonempty(run.planned_case_ids):
        problems.push("TRC_CASE_PLAN: empty or duplicated case identity")
    if (run.expected_shard_ids.len() == 0 or
        not trace_unique_nonempty(run.expected_shard_ids) or
        not trace_unique_nonempty(run.completed_shard_ids)):
        problems.push("TRC_SHARD_PLAN: invalid shard identity set")
    if run.expected_shard_ids.len() != run.completed_shard_ids.len():
        problems.push("TRC_MISSING_SHARD: shard cardinality mismatch")
    for shard in run.expected_shard_ids:
        if not trace_text_has(run.completed_shard_ids, shard):
            problems.push("TRC_MISSING_SHARD: " + shard)
    var ids: [text] = []
    for observation in run.observations:
        if observation.id == "" or trace_text_has(ids, observation.id):
            problems.push("TRC_OBSERVATION_ID: empty or duplicate observation")
        ids.push(observation.id)
        if (observation.run_id != run.id or observation.attempt < 1 or
            not trace_text_has(run.planned_case_ids, observation.case_id)):
            problems.push("TRC_OBSERVATION_BINDING: observation outside frozen plan")
        if not trace_unique_nonempty(observation.artifact_ids):
            problems.push("TRC_ARTIFACT_ID: empty or duplicate artifact identity")
        var attempt_count = 0
        for other in run.observations:
            if other.case_id == observation.case_id and other.attempt == observation.attempt:
                attempt_count = attempt_count + 1
        if attempt_count != 1:
            problems.push("TRC_ATTEMPT_CONFLICT: duplicate attempt number")
    for planned in run.planned_case_ids:
        var observed = false
        for observation in run.observations:
            if observation.case_id == planned:
                observed = true
        if not observed:
            problems.push("TRC_MISSING_CASE: " + planned)
    problems

pub fn trace_outcome_name(outcome: TraceOutcome) -> text:
    match outcome:
        TraceOutcome.Passed: "passed"
        TraceOutcome.Failed: "failed"
        TraceOutcome.Skipped: "skipped"
        TraceOutcome.ExpectedFailure: "expected_failure"
        TraceOutcome.UnexpectedPass: "unexpected_pass"
        TraceOutcome.Cancelled: "cancelled"
        TraceOutcome.Crashed: "crashed"
        TraceOutcome.TimedOut: "timed_out"

fn trace_sdn_texts(values: [text]) -> SdnValue:
    var items: [SdnValue] = []
    for value in values:
        items.push(SdnValue.String(value))
    SdnValue.Array(items)

pub fn encode_trace_run(run: TraceRun) -> text:
    var observations: [SdnValue] = []
    for observation in run.observations:
        var item: Dict<text, SdnValue> = {}
        item["id"] = SdnValue.String(observation.id)
        item["run_id"] = SdnValue.String(observation.run_id)
        item["case_id"] = SdnValue.String(observation.case_id)
        item["attempt"] = SdnValue.Int(observation.attempt)
        item["outcome"] = SdnValue.String(trace_outcome_name(observation.outcome))
        item["executed"] = SdnValue.Bool(observation.executed)
        item["artifact_ids"] = trace_sdn_texts(observation.artifact_ids)
        observations.push(SdnValue.Dict(item))
    var value: Dict<text, SdnValue> = {}
    value["schema"] = SdnValue.String("simple.trace.run/v1")
    value["id"] = SdnValue.String(run.id)
    value["subject_id"] = SdnValue.String(run.subject_id)
    value["input_manifest_id"] = SdnValue.String(run.input_manifest_id)
    value["definition_manifest_id"] = SdnValue.String(run.definition_manifest_id)
    value["configuration_id"] = SdnValue.String(run.configuration_id)
    value["lane_id"] = SdnValue.String(run.lane_id)
    value["binary_id"] = SdnValue.String(run.binary_id)
    value["expectation_id"] = SdnValue.String(run.expectation_id)
    value["planned_case_ids"] = trace_sdn_texts(run.planned_case_ids)
    value["expected_shard_ids"] = trace_sdn_texts(run.expected_shard_ids)
    value["completed_shard_ids"] = trace_sdn_texts(run.completed_shard_ids)
    value["observations"] = SdnValue.Array(observations)
    val completion = match run.completion:
        TraceCompletion.Complete: "complete"
        TraceCompletion.Incomplete: "incomplete"
        TraceCompletion.Cancelled: "cancelled"
        TraceCompletion.Crashed: "crashed"
    value["completion"] = SdnValue.String(completion)
    sdn_encode_canonical(SdnValue.Dict(value)) + "\n"
