"""Exact-field qualification-summary codec. Claimed status is untrusted data.

This v1 is the first CLI summary contract, not an admitted evidence evaluation.
Future obligation/evidence/refusal records require an explicitly versioned
schema and migration; they must never silently extend this exact-field major.
"""

use std.common.sdn.value.{SdnValue}
use std.common.sdn.strict_v1.{sdn_parse_strict_v1, sdn_strict_limits_valid_v1}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.common.traceability.types_v1.*

fn trace_qualification_limits_valid_v1(limits: TraceQualificationCodecLimitsV1) -> bool:
    (sdn_strict_limits_valid_v1(limits.sdn) and
        limits.max_selectors >= 0 and limits.max_selectors <= 65536 and
        limits.max_diagnostics >= 0 and limits.max_diagnostics <= 100000 and
        limits.max_text_bytes >= 0 and limits.max_text_bytes <= 16777216 and
        limits.max_output_bytes >= 0 and limits.max_output_bytes <= 16777216)

fn trace_field_path_v1(parent: text, name: text) -> text:
    if parent == "": name else: parent + "." + name

fn trace_exact_dict_v1(value: SdnValue, path: text, names: [text]) -> Result<Dict<text, SdnValue>, TraceCodecIssueV1>:
    match value:
        case Dict(fields):
            var unknown = ""
            var unknown_found = false
            for name in fields.keys():
                if not names.contains(name) and (not unknown_found or name < unknown):
                    unknown = name
                    unknown_found = true
            if unknown_found:
                return Err(trace_codec_issue_v1("unknown_field", trace_field_path_v1(path, unknown), "Unknown semantic field"))
            for name in names:
                if not fields.contains_key(name):
                    return Err(trace_codec_issue_v1("missing_field", trace_field_path_v1(path, name), "Missing required field"))
            Ok(fields)
        case _: Err(trace_codec_issue_v1("wrong_type", path, "Expected dictionary"))

fn trace_text_v1(value: SdnValue, path: text) -> Result<text, TraceCodecIssueV1>:
    match value:
        case String(item): Ok(item)
        case _: Err(trace_codec_issue_v1("wrong_type", path, "Expected text"))

fn trace_int_v1(value: SdnValue, path: text) -> Result<i64, TraceCodecIssueV1>:
    match value:
        case Int(item): Ok(item)
        case _: Err(trace_codec_issue_v1("wrong_type", path, "Expected integer"))

fn trace_bool_v1(value: SdnValue, path: text) -> Result<bool, TraceCodecIssueV1>:
    match value:
        case Bool(item): Ok(item)
        case _: Err(trace_codec_issue_v1("wrong_type", path, "Expected boolean"))

fn trace_array_v1(value: SdnValue, path: text) -> Result<[SdnValue], TraceCodecIssueV1>:
    match value:
        case Array(items): Ok(items)
        case _: Err(trace_codec_issue_v1("wrong_type", path, "Expected array"))

fn trace_enum_v1(value: SdnValue, path: text, names: [text]) -> Result<text, TraceCodecIssueV1>:
    val item = trace_text_v1(value, path)?
    if not names.contains(item): return Err(trace_codec_issue_v1("invalid_enum", path, "Unknown enum value"))
    Ok(item)

fn trace_identifier_v1(value: SdnValue, path: text) -> Result<text, TraceCodecIssueV1>:
    val item = trace_text_v1(value, path)?
    if item.len() == 0: return Err(trace_codec_issue_v1("invalid_identifier", path, "Empty canonical identity"))
    val punctuation = "._:/@+-"
    var index = 0
    while index < item.len():
        val ch = item.byte_at(index)
        if not ((ch >= 48 and ch <= 57) or (ch >= 65 and ch <= 90) or
            (ch >= 97 and ch <= 122) or punctuation.contains(item.substring(index, index + 1))):
            return Err(trace_codec_issue_v1("invalid_identifier", path, "Canonical identity requires restricted ASCII grammar"))
        index = index + 1
    Ok(item)

fn trace_nonempty_text_v1(value: SdnValue, path: text) -> Result<text, TraceCodecIssueV1>:
    val item = trace_text_v1(value, path)?
    if item.len() == 0: return Err(trace_codec_issue_v1("empty_text", path, "Required text is empty"))
    Ok(item)

fn trace_diagnostic_decode_v1(value: SdnValue, path: text, snapshot_id: text) -> Result<TraceDiagnosticV1, TraceCodecIssueV1>:
    val names = ["code", "severity", "entity", "path", "path_available", "span_available",
        "line", "column", "message", "snapshot_id", "rule_version", "origin", "repair"]
    val fields = trace_exact_dict_v1(value, path, names)?
    val code = trace_identifier_v1(fields["code"], path + ".code")?
    val severity = trace_enum_v1(fields["severity"], path + ".severity", ["info", "warning", "error"])?
    val entity = trace_identifier_v1(fields["entity"], path + ".entity")?
    val source_path = trace_text_v1(fields["path"], path + ".path")?
    val path_available = trace_bool_v1(fields["path_available"], path + ".path_available")?
    val span_available = trace_bool_v1(fields["span_available"], path + ".span_available")?
    val line = trace_int_v1(fields["line"], path + ".line")?
    val column = trace_int_v1(fields["column"], path + ".column")?
    val message = trace_nonempty_text_v1(fields["message"], path + ".message")?
    val subject = trace_identifier_v1(fields["snapshot_id"], path + ".snapshot_id")?
    val rule_version = trace_nonempty_text_v1(fields["rule_version"], path + ".rule_version")?
    # Origin is attributable source text, not the relationship-origin enum.
    val origin = trace_nonempty_text_v1(fields["origin"], path + ".origin")?
    val repair = trace_nonempty_text_v1(fields["repair"], path + ".repair")?
    if subject != snapshot_id:
        return Err(trace_codec_issue_v1("missing_reference", path + ".snapshot_id", "Diagnostic refers to another snapshot"))
    if path_available != (source_path.len() > 0):
        return Err(trace_codec_issue_v1("invalid_location", path + ".path", "Path availability contradicts path text"))
    if span_available and not path_available:
        return Err(trace_codec_issue_v1("invalid_location", path + ".span_available", "Located span requires an available path"))
    if (span_available and line < 1) or (not span_available and line != 0):
        return Err(trace_codec_issue_v1("invalid_location", path + ".line", "Line coordinate contradicts availability"))
    if (span_available and column < 1) or (not span_available and column != 0):
        return Err(trace_codec_issue_v1("invalid_location", path + ".column", "Column coordinate contradicts availability"))
    Ok(TraceDiagnosticV1(code: code, severity: severity, entity: entity,
        path: source_path, path_available: path_available, span_available: span_available,
        line: line, column: column, message: message, snapshot_id: subject,
        rule_version: rule_version, origin: origin, repair: repair))

fn trace_qualification_consistency_v1(document: TraceQualificationV1) -> Result<bool, TraceCodecIssueV1>:
    val evaluation = document.evaluation
    if not document.snapshot.complete and evaluation.complete:
        return Err(trace_codec_issue_v1("inconsistent_result", "evaluation.complete", "Incomplete snapshot cannot complete evaluation"))
    if evaluation.complete:
        if evaluation.exit_code != 0 and evaluation.exit_code != 1:
            return Err(trace_codec_issue_v1("inconsistent_result", "evaluation.exit_code", "Completed evaluation requires exit 0 or 1"))
    else:
        if evaluation.exit_code != 2 and evaluation.exit_code != 130:
            return Err(trace_codec_issue_v1("inconsistent_result", "evaluation.exit_code", "Incomplete evaluation requires exit 2 or 130"))
        if evaluation.qualification != "incomplete":
            return Err(trace_codec_issue_v1("inconsistent_result", "evaluation.qualification", "Incomplete evaluation cannot claim a terminal qualification"))
    if (evaluation.qualification == "satisfied" or evaluation.qualification == "not_applicable_reviewed") and evaluation.exit_code != 0:
        return Err(trace_codec_issue_v1("inconsistent_result", "evaluation.qualification", "Claimed successful qualification requires exit zero"))
    if evaluation.qualification == "unsatisfied" and evaluation.exit_code != 1:
        return Err(trace_codec_issue_v1("inconsistent_result", "evaluation.qualification", "Claimed unsatisfied qualification requires exit one"))
    if evaluation.exit_code == 1 and document.diagnostics.len() == 0:
        return Err(trace_codec_issue_v1("inconsistent_result", "diagnostics", "Violation result requires diagnostic reasons"))
    if evaluation.exit_code == 0:
        for diagnostic in document.diagnostics:
            if diagnostic.severity == "error":
                return Err(trace_codec_issue_v1("inconsistent_result", "diagnostics", "Exit zero contradicts an error diagnostic"))
    Ok(true)

# Shared semantic validator for decoding and encoding. No partial records escape.
fn trace_qualification_value_decode_v1(value: SdnValue, limits: TraceQualificationCodecLimitsV1) -> Result<TraceQualificationV1, TraceCodecIssueV1>:
    if not trace_qualification_limits_valid_v1(limits):
        return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits are outside hard bounds"))
    var envelope: Dict<text, SdnValue> = {}
    match value:
        case Dict(fields): envelope = fields
        case _: return Err(trace_codec_issue_v1("wrong_type", "", "Expected dictionary"))
    if not envelope.contains_key("schema"):
        return Err(trace_codec_issue_v1("missing_field", "schema", "Missing schema declaration"))
    val schema = trace_exact_dict_v1(envelope["schema"], "schema", ["name", "version"])?
    val family = trace_text_v1(schema["name"], "schema.name")?
    if family != "simple.trace.qualification":
        return Err(trace_codec_issue_v1("unsupported_family", "schema.name", "Qualification summary decoder does not support this family"))
    val version = trace_int_v1(schema["version"], "schema.version")?
    if version != 1: return Err(trace_codec_issue_v1("schema_version", "schema.version", "Unsupported qualification schema major"))
    val root = trace_exact_dict_v1(value, "", ["schema", "snapshot", "selection", "evaluation", "diagnostics"])?
    val snapshot_fields = trace_exact_dict_v1(root["snapshot"], "snapshot", ["id", "kind", "complete"])?
    val snapshot = TraceSnapshotV1(
        id: trace_identifier_v1(snapshot_fields["id"], "snapshot.id")?,
        kind: trace_enum_v1(snapshot_fields["kind"], "snapshot.kind", ["worktree", "index", "git", "sj"])?,
        complete: trace_bool_v1(snapshot_fields["complete"], "snapshot.complete")?)
    val selection_fields = trace_exact_dict_v1(root["selection"], "selection", ["paths", "full_repository"])?
    val selected = trace_array_v1(selection_fields["paths"], "selection.paths")?
    if selected.len() > limits.max_selectors:
        return Err(trace_codec_issue_v1("selector_limit", "selection.paths", "Too many explicit selectors"))
    var paths: [text] = []
    var index = 0
    for item in selected:
        val path = trace_nonempty_text_v1(item, "selection.paths." + index.to_text())?
        paths.push(path)
        index = index + 1
    val selection = TraceSelectionV1(paths: paths,
        full_repository: trace_bool_v1(selection_fields["full_repository"], "selection.full_repository")?)
    val evaluation_fields = trace_exact_dict_v1(root["evaluation"], "evaluation",
        ["scope", "profile", "kind", "complete", "exit_code", "qualification"])?
    val evaluation = TraceEvaluationV1(
        scope: trace_enum_v1(evaluation_fields["scope"], "evaluation.scope", ["all", "src", "spec", "doc"])?,
        profile: trace_enum_v1(evaluation_fields["profile"], "evaluation.profile", ["worktree", "commit", "push", "remote", "audit"])?,
        kind: trace_enum_v1(evaluation_fields["kind"], "evaluation.kind", ["structural", "evidence"])?,
        complete: trace_bool_v1(evaluation_fields["complete"], "evaluation.complete")?,
        exit_code: trace_int_v1(evaluation_fields["exit_code"], "evaluation.exit_code")?,
        qualification: trace_enum_v1(evaluation_fields["qualification"], "evaluation.qualification",
            ["satisfied", "unsatisfied", "incomplete", "not_applicable_reviewed"])?)
    val entries = trace_array_v1(root["diagnostics"], "diagnostics")?
    if entries.len() > limits.max_diagnostics:
        return Err(trace_codec_issue_v1("diagnostic_limit", "diagnostics", "Too many diagnostics"))
    var diagnostics: [TraceDiagnosticV1] = []
    index = 0
    for entry in entries:
        val diagnostic = trace_diagnostic_decode_v1(entry, "diagnostics." + index.to_text(), snapshot.id)?
        diagnostics.push(diagnostic)
        index = index + 1
    val document = TraceQualificationV1(snapshot: snapshot, selection: selection,
        evaluation: evaluation, diagnostics: diagnostics)
    trace_qualification_consistency_v1(document)?
    Ok(document)

pub fn trace_qualification_decode_v1(source: text, limits: TraceQualificationCodecLimitsV1) -> Result<TraceQualificationV1, TraceCodecIssueV1>:
    if not trace_qualification_limits_valid_v1(limits):
        return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits are outside hard bounds"))
    var value = SdnValue.Null
    match sdn_parse_strict_v1(source, limits.sdn):
        case Ok(document): value = document.value
        case Err(issue):
            val located = issue.code != "invalid_limits" and issue.code != "source_limit"
            return Err(TraceCodecIssueV1(code: issue.code, path: "", message: issue.message,
                location_available: located, offset: issue.offset,
                line: if located: issue.line else: 0, column: if located: issue.column else: 0))
    val document = trace_qualification_value_decode_v1(value, limits)?
    trace_qualification_preflight_v1(document, limits, false)?
    Ok(document)

fn trace_diagnostic_value_v1(item: TraceDiagnosticV1) -> SdnValue:
    SdnValue.Dict({"code": SdnValue.String(item.code), "severity": SdnValue.String(item.severity),
        "entity": SdnValue.String(item.entity), "path": SdnValue.String(item.path),
        "path_available": SdnValue.Bool(item.path_available), "span_available": SdnValue.Bool(item.span_available),
        "line": SdnValue.Int(item.line), "column": SdnValue.Int(item.column), "message": SdnValue.String(item.message),
        "snapshot_id": SdnValue.String(item.snapshot_id), "rule_version": SdnValue.String(item.rule_version),
        "origin": SdnValue.String(item.origin), "repair": SdnValue.String(item.repair)})

fn trace_qualification_value_v1(document: TraceQualificationV1, diagnostics: [SdnValue]) -> SdnValue:
    var selectors: [SdnValue] = []
    for path in document.selection.paths: selectors.push(SdnValue.String(path))
    SdnValue.Dict({
        "schema": SdnValue.Dict({"name": SdnValue.String("simple.trace.qualification"), "version": SdnValue.Int(1)}),
        "snapshot": SdnValue.Dict({"id": SdnValue.String(document.snapshot.id), "kind": SdnValue.String(document.snapshot.kind), "complete": SdnValue.Bool(document.snapshot.complete)}),
        "selection": SdnValue.Dict({"paths": SdnValue.Array(selectors), "full_repository": SdnValue.Bool(document.selection.full_repository)}),
        "evaluation": SdnValue.Dict({"scope": SdnValue.String(document.evaluation.scope), "profile": SdnValue.String(document.evaluation.profile), "kind": SdnValue.String(document.evaluation.kind),
            "complete": SdnValue.Bool(document.evaluation.complete), "exit_code": SdnValue.Int(document.evaluation.exit_code), "qualification": SdnValue.String(document.evaluation.qualification)}),
        "diagnostics": SdnValue.Array(diagnostics)})

fn trace_qualification_output_cap_v1(limits: TraceQualificationCodecLimitsV1) -> i64:
    if limits.max_output_bytes < limits.sdn.max_source_bytes:
        limits.max_output_bytes
    else:
        limits.sdn.max_source_bytes

fn trace_qualification_preflight_v1(document: TraceQualificationV1, limits: TraceQualificationCodecLimitsV1, for_encoding: bool) -> Result<bool, TraceCodecIssueV1>:
    if not trace_qualification_limits_valid_v1(limits):
        return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits are outside hard bounds"))
    if document.selection.paths.len() > limits.max_selectors:
        return Err(trace_codec_issue_v1("selector_limit", "selection.paths", "Too many explicit selectors"))
    if document.diagnostics.len() > limits.max_diagnostics:
        return Err(trace_codec_issue_v1("diagnostic_limit", "diagnostics", "Too many diagnostics"))
    val nodes = 37 + document.selection.paths.len() + 27 * document.diagnostics.len()
    if nodes > limits.sdn.max_nodes:
        return Err(trace_codec_issue_v1("node_limit", "", "Qualification exceeds SDN semantic node budget"))
    val depth = if document.selection.paths.len() > 0 or document.diagnostics.len() > 0: 4 else: 3
    if depth > limits.sdn.max_depth:
        return Err(trace_codec_issue_v1("depth_limit", "", "Qualification exceeds SDN nesting budget"))
    # Minimum canonical wire overhead: fixed names/punctuation/schema, shortest
    # bool/int spellings and final LF. Dynamic string bytes and array separators
    # are charged separately; quoting/escaping can only increase this lower bound.
    var output_floor = 252 + 164 * document.diagnostics.len()
    if document.selection.paths.len() > 1:
        output_floor = output_floor + 2 * (document.selection.paths.len() - 1)
    if document.diagnostics.len() > 1:
        output_floor = output_floor + 2 * (document.diagnostics.len() - 1)
    val output_cap = trace_qualification_output_cap_v1(limits)
    if for_encoding and output_floor > output_cap:
        return Err(trace_codec_issue_v1("output_limit", "", "Qualification minimum wire size exceeds byte budget"))
    var text_bytes = 0
    val basic = [document.snapshot.id, document.snapshot.kind, document.evaluation.scope,
        document.evaluation.profile, document.evaluation.kind, document.evaluation.qualification]
    for item in basic:
        if item.len() > limits.max_text_bytes - text_bytes:
            return Err(trace_codec_issue_v1("text_limit", "", "Qualification text exceeds budget"))
        text_bytes = text_bytes + item.len()
        if for_encoding and item.len() > output_cap - output_floor:
            return Err(trace_codec_issue_v1("output_limit", "", "Qualification text exceeds output byte budget"))
        output_floor = output_floor + item.len()
        if for_encoding:
            match validated_utf8_bytes_to_text_linear(item.bytes()):
                case Ok(_): ()
                case Err(reason): return Err(trace_codec_issue_v1("invalid_utf8", "", reason))
    for item in document.selection.paths:
        if item.len() > limits.max_text_bytes - text_bytes:
            return Err(trace_codec_issue_v1("text_limit", "selection.paths", "Selector text exceeds budget"))
        text_bytes = text_bytes + item.len()
        if for_encoding and item.len() > output_cap - output_floor:
            return Err(trace_codec_issue_v1("output_limit", "", "Qualification text exceeds output byte budget"))
        output_floor = output_floor + item.len()
        if for_encoding:
            match validated_utf8_bytes_to_text_linear(item.bytes()):
                case Ok(_): ()
                case Err(reason): return Err(trace_codec_issue_v1("invalid_utf8", "selection.paths", reason))
    for diagnostic in document.diagnostics:
        val fields = [diagnostic.code, diagnostic.severity, diagnostic.entity, diagnostic.path,
            diagnostic.message, diagnostic.snapshot_id, diagnostic.rule_version, diagnostic.origin, diagnostic.repair]
        for item in fields:
            if item.len() > limits.max_text_bytes - text_bytes:
                return Err(trace_codec_issue_v1("text_limit", "diagnostics", "Diagnostic text exceeds budget"))
            text_bytes = text_bytes + item.len()
            if for_encoding and item.len() > output_cap - output_floor:
                return Err(trace_codec_issue_v1("output_limit", "diagnostics", "Diagnostic text exceeds output byte budget"))
            output_floor = output_floor + item.len()
            if for_encoding:
                match validated_utf8_bytes_to_text_linear(item.bytes()):
                    case Ok(_): ()
                    case Err(reason): return Err(trace_codec_issue_v1("invalid_utf8", "diagnostics", reason))
    Ok(true)

fn trace_diagnostic_order_v1(keys: [text]) -> [i64]:
    val count = keys.len()
    var order: [i64] = [0; count]
    var scratch: [i64] = [0; count]
    var index = 0
    while index < count:
        order[index] = index
        index = index + 1
    var width = 1
    while width < count:
        var start = 0
        while start < count:
            val middle = if start + width < count: start + width else: count
            val end = if middle + width < count: middle + width else: count
            var left = start
            var right = middle
            var target = start
            while target < end:
                if right >= end or (left < middle and keys[order[left]] <= keys[order[right]]):
                    scratch[target] = order[left]
                    left = left + 1
                else:
                    scratch[target] = order[right]
                    right = right + 1
                target = target + 1
            start = end
        index = 0
        while index < count:
            order[index] = scratch[index]
            index = index + 1
        width = width * 2
    order

pub fn trace_qualification_encode_v1(document: TraceQualificationV1, limits: TraceQualificationCodecLimitsV1) -> Result<text, TraceCodecIssueV1>:
    trace_qualification_preflight_v1(document, limits, true)?
    val output_cap = trace_qualification_output_cap_v1(limits)
    var values: [SdnValue] = []
    var keys: [text] = []
    var output_floor = 1
    for item in document.diagnostics:
        val value = trace_diagnostic_value_v1(item)
        val key = sdn_encode_canonical(value)
        if key.len() > output_cap - output_floor:
            return Err(trace_codec_issue_v1("output_limit", "diagnostics", "Diagnostic output exceeds byte budget"))
        output_floor = output_floor + key.len()
        values.push(value)
        keys.push(key)
    val order = trace_diagnostic_order_v1(keys)
    var sorted: [SdnValue] = []
    for index in order: sorted.push(values[index])
    val value = trace_qualification_value_v1(document, sorted)
    trace_qualification_value_decode_v1(value, limits)?
    val output = sdn_encode_canonical(value) + "\n"
    if output.len() > output_cap:
        return Err(trace_codec_issue_v1("output_limit", "", "Qualification output exceeds byte budget"))
    Ok(output)

export trace_qualification_decode_v1, trace_qualification_encode_v1
