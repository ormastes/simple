"""Closed set of traceability enforcement profiles (plan section 6.4).

`worktree`, `commit`, `push`, `remote` and `audit` were already accepted by the
qualification decoder and stay decodable; `editor`, `ci` and `release` complete
the plan's table.
"""

pub enum TraceProfile:
    Worktree
    Editor
    Commit
    Push
    Remote
    Audit
    Ci
    Release

pub fn trace_profile_name_v1(profile: TraceProfile) -> text:
    match profile:
        case TraceProfile.Worktree: "worktree"
        case TraceProfile.Editor: "editor"
        case TraceProfile.Commit: "commit"
        case TraceProfile.Push: "push"
        case TraceProfile.Remote: "remote"
        case TraceProfile.Audit: "audit"
        case TraceProfile.Ci: "ci"
        case TraceProfile.Release: "release"

pub fn trace_profile_names_v1() -> [text]:
    ["worktree", "editor", "commit", "push", "remote", "audit", "ci", "release"]

pub fn trace_profile_parse_v1(name: text) -> Result<TraceProfile, text>:
    match name:
        case "worktree": Ok(TraceProfile.Worktree)
        case "editor": Ok(TraceProfile.Editor)
        case "commit": Ok(TraceProfile.Commit)
        case "push": Ok(TraceProfile.Push)
        case "remote": Ok(TraceProfile.Remote)
        case "audit": Ok(TraceProfile.Audit)
        case "ci": Ok(TraceProfile.Ci)
        case "release": Ok(TraceProfile.Release)
        case _: Err("unsupported profile: " + name)

export TraceProfile, trace_profile_name_v1, trace_profile_names_v1, trace_profile_parse_v1
