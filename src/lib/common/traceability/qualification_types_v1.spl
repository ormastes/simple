"""Existing qualification-summary major1 carriers."""
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1, sdn_strict_limits_v1}
use std.common.traceability.envelope_types_v1.{TraceSnapshotV1, TraceCountLimitV1, TraceByteLimitV1}
use std.common.traceability.envelope_types_v1.*

pub struct TraceQualificationCodecLimitsV1:
    sdn: SdnStrictLimitsV1
    max_selectors: TraceCountLimitV1 = TraceCountLimitV1(value: 4096)
    max_diagnostics: TraceCountLimitV1 = TraceCountLimitV1(value: 100000)
    max_text_bytes: TraceByteLimitV1 = TraceByteLimitV1(value: 1048576)
    max_output_bytes: TraceByteLimitV1 = TraceByteLimitV1(value: 1048576)

pub fn trace_qualification_codec_limits_v1() -> TraceQualificationCodecLimitsV1:
    TraceQualificationCodecLimitsV1(sdn: sdn_strict_limits_v1())

pub struct TraceSelectionV1:
    paths: [text]
    full_repository: TraceSelectionScopeV1

pub struct TraceEvaluationV1:
    scope: text
    profile: text
    kind: text
    complete: TraceCompletenessV1
    exit_code: TraceEvaluationExitCodeV1
    qualification: text

pub struct TraceDiagnosticV1:
    code: text
    severity: text
    entity: text
    path: text
    path_available: TraceAvailabilityV1
    span_available: TraceAvailabilityV1
    line: TraceLineNumberV1
    column: TraceColumnNumberV1
    message: text
    snapshot_id: text
    rule_version: text
    origin: text
    repair: text

pub struct TraceQualificationV1:
    snapshot: TraceSnapshotV1
    selection: TraceSelectionV1
    evaluation: TraceEvaluationV1
    diagnostics: [TraceDiagnosticV1]

export TraceQualificationCodecLimitsV1, trace_qualification_codec_limits_v1
export TraceSelectionV1, TraceEvaluationV1, TraceDiagnosticV1, TraceQualificationV1
