"""Convention-only structural claims; missing and ambiguous facts remain visible."""
use std.common.traceability.conventions_types_v1.*
use std.common.traceability.conventions_policy_v1.*
use std.common.traceability.conventions_index_v1.*
use std.common.traceability.conventions_result_v1.{TraceConventionResultBuilderV1}
use std.common.traceability.graph_types_v1.{TraceGraphV1}
use std.common.traceability.graph_schema_v1.{trace_graph_validate_v1}
use std.common.traceability.codec_text_budget_v1.{TraceCodecTextBudgetV1}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}

fn trace_convention_excluded_v1(registered: TraceConventionPolicyIndexV1, builder: TraceConventionResultBuilderV1, entity: text, group: text, rule: text, path: text) -> Result<bool, TraceCodecIssueV1>:
    var matches: [text] = []
    if registered.exclusions.contains_key(group):
        for root in registered.exclusions[group]:
            builder.work()?
            if path.starts_with(root): matches.push(root)
    builder.lookup("exclusion", entity, group, rule, path, matches)?
    Ok(matches.len() > 0)

fn trace_convention_group_v1(entity: text, path: text, group: text, policy: TraceConventionPolicyV1, registered: TraceConventionPolicyIndexV1, index: TraceConventionIndexV1, builder: TraceConventionResultBuilderV1) -> Result<bool, TraceCodecIssueV1>:
    val kind = registered.groups[group]
    var matching: [i64] = []
    var rule_ids: [text] = []
    for position in registered.group_rules[group]:
        builder.work()?
        val rule = policy.rules[position]
        if path.starts_with(rule.source_root) and path.ends_with(rule.source_suffix) and path.len() > rule.source_root.len() + rule.source_suffix.len():
            matching.push(position)
            rule_ids.push(rule.id)
    builder.lookup("group", entity, group, "", path, rule_ids)?
    if trace_convention_excluded_v1(registered, builder, entity, group, "", path)?: return Ok(true)
    if matching.len() == 0: return Ok(false)
    var candidate_paths: Dict<text, bool> = {}
    var rule_targets: Dict<text, text> = {}
    var conflict = false
    var unrecognized = false
    val target_kind = if kind == "manual": "generated_document" else: "test_suite"
    for position in matching:
        val rule = policy.rules[position]
        val start = rule.source_root.len()
        val end = path.len() - rule.source_suffix.len()
        if rule.target_root.len() + end - start + rule.target_suffix.len() > builder.limits.max_field_bytes:
            return Err(trace_codec_issue_v1("field_limit", "target", "Mapped target path exceeds field budget before allocation"))
        val target = rule.target_root + path[start:end] + rule.target_suffix
        val excluded = trace_convention_excluded_v1(registered, builder, entity, group, rule.id, target)?
        val artifacts = index.artifacts_for(target_kind, target)
        builder.lookup("artifact", entity, group, rule.id, target, artifacts)?
        var cases: [text] = []
        if kind != "manual":
            cases = index.roles_for(kind, target)
        elif artifacts.len() > 0 and index.input_roles[target] == "document": cases = artifacts
        builder.lookup("role", entity, group, rule.id, target, cases)?
        var recognized: [text] = []
        if not excluded:
            if artifacts.len() > 1: conflict = true
            if kind == "manual" and cases.len() > 0:
                for document in artifacts:
                    builder.work()?
                    val bindings = index.bindings_for(rule.id, entity, document)
                    builder.lookup("generator_binding", entity, group, rule.id, target, bindings)?
                    for binding in bindings:
                        builder.work()?
                        builder.lookup("generator_manifest", entity, group, rule.id, index.binding_manifests[binding], [binding])?
                    if bindings.len() == 1: recognized.push(document)
                    else:
                        if bindings.len() > 1: conflict = true
                        val code = if bindings.len() == 0: "missing_generator_binding" else: "ambiguous_generator_binding"
                        builder.diagnostic(code, entity, target, rule.id)?
            elif cases.len() > 0: recognized = artifacts
            if artifacts.len() > 0 and cases.len() == 0: unrecognized = true
        builder.lookup("target", entity, group, rule.id, target, recognized)?
        if recognized.len() == 1:
            candidate_paths[target] = true
            rule_targets[rule.id] = target
    val paths = candidate_paths.keys()
    if conflict or paths.len() > 1:
        builder.diagnostic("ambiguous_conventional_target", entity, path, group)?
        return Ok(true)
    if paths.len() == 0:
        val code = if unrecognized: "unrecognized_conventional_target" else: "missing_conventional_target"
        builder.diagnostic(code, entity, path, group)?
        return Ok(true)
    val target = paths[0]
    if kind == "manual":
        val documents = index.artifacts_for(target_kind, target)
        for position in matching:
            val rule = policy.rules[position]
            if rule_targets.contains_key(rule.id) and rule_targets[rule.id] == target:
                builder.claim(documents[0], "generated_from", entity, rule.id, path, target)?
    else:
        val cases = index.roles_for(kind, target)
        for position in matching:
            val rule = policy.rules[position]
            if rule_targets.contains_key(rule.id) and rule_targets[rule.id] == target:
                for case_id in cases: builder.claim(case_id, "targets", entity, rule.id, path, target)?
    Ok(true)

pub fn trace_resolve_conventions_v1(graph: TraceGraphV1, policy: TraceConventionPolicyV1, limits: TraceConventionLimitsV1) -> Result<TraceConventionResolutionV1, TraceCodecIssueV1>:
    trace_convention_preflight_v1(graph, policy, limits)?
    val registered = trace_convention_policy_index_v1(policy)?
    trace_graph_validate_v1(graph, limits.graph)?
    var budget = TraceCodecTextBudgetV1(max_field_bytes: limits.max_field_bytes, max_text_bytes: limits.max_result_text_bytes)
    budget.charge([graph.snapshot.id, graph.manifest.input_set_id, policy.id, policy.version], "result")?
    var builder = TraceConventionResultBuilderV1(limits: limits, text_budget: budget, result: TraceConventionResolutionV1(snapshot_id: graph.snapshot.id, input_set_id: graph.manifest.input_set_id, policy_id: policy.id, rules_version: policy.version, complete: false, claims: [], diagnostics: [], lookups: []))
    builder.work(graph.inputs.len() + graph.nodes.len() + graph.locators.len() + graph.test_definitions.len() + policy.rules.len() + policy.exclusions.len() + policy.generator_bindings.len())?
    val index = trace_convention_index_v1(graph, policy, registered)?
    for node in graph.nodes:
        builder.work()?
        if not registered.source_groups.contains_key(node.kind): continue
        val groups = registered.source_groups[node.kind]
        val paths = index.paths_for(node.id)
        if paths.len() != 1:
            if paths.len() == 0: builder.lookup("source", node.id, "", "", "", [])?
            for path in paths: builder.lookup("source", node.id, "", "", path, [node.id])?
            val code = if paths.len() == 0: "unlocated_conventional_source" else: "ambiguous_conventional_source"
            builder.diagnostic(code, node.id, "", "conventions")?
            continue
        val path = paths[0]
        val sources = index.artifacts_for(node.kind, path)
        builder.lookup("source", node.id, "", "", path, sources)?
        val input_role = index.input_roles[path]
        if ((node.kind == "source_file" and input_role != "source") or
            (node.kind == "test_suite" and input_role != "test") or
            (node.kind == "component" and input_role != "source" and input_role != "policy")):
            builder.diagnostic("unrecognized_conventional_source", node.id, path, "conventions")?
            continue
        if sources.len() != 1:
            val code = if sources.len() == 0: "unrecognized_conventional_source" else: "ambiguous_conventional_source"
            builder.diagnostic(code, node.id, path, "conventions")?
            continue
        var handled = false
        for group in groups:
            builder.work()?
            if trace_convention_group_v1(node.id, path, group, policy, registered, index, builder)?: handled = true
        if not handled: builder.diagnostic("unregistered_conventional_source", node.id, path, "conventions")?
    Ok(builder.finish())

export trace_resolve_conventions_v1
