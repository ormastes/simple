"""Typed qualification-summary data. These values carry no evidence authority."""

use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1, sdn_strict_limits_v1}

pub struct TraceCodecIssueV1:
    code: text
    path: text
    message: text
    location_available: bool
    offset: i64
    line: i64
    column: i64

pub fn trace_codec_issue_v1(code: text, path: text, message: text) -> TraceCodecIssueV1:
    TraceCodecIssueV1(code: code, path: path, message: message,
        location_available: false, offset: 0, line: 0, column: 0)

pub struct TraceQualificationCodecLimitsV1:
    sdn: SdnStrictLimitsV1
    max_selectors: i64 = 4096
    max_diagnostics: i64 = 100000
    max_text_bytes: i64 = 1048576
    max_output_bytes: i64 = 1048576

pub fn trace_qualification_codec_limits_v1() -> TraceQualificationCodecLimitsV1:
    TraceQualificationCodecLimitsV1(sdn: sdn_strict_limits_v1())

pub struct TraceSnapshotV1:
    id: text
    kind: text
    complete: bool

pub struct TraceSelectionV1:
    paths: [text]
    full_repository: bool

pub struct TraceEvaluationV1:
    scope: text
    profile: text
    kind: text
    complete: bool
    exit_code: i64
    qualification: text

pub struct TraceDiagnosticV1:
    code: text
    severity: text
    entity: text
    path: text
    path_available: bool
    span_available: bool
    line: i64
    column: i64
    message: text
    snapshot_id: text
    rule_version: text
    origin: text
    repair: text

pub struct TraceQualificationV1:
    snapshot: TraceSnapshotV1
    selection: TraceSelectionV1
    evaluation: TraceEvaluationV1
    diagnostics: [TraceDiagnosticV1]

pub enum TraceDocumentV1:
    Qualification(TraceQualificationV1)

export TraceCodecIssueV1, trace_codec_issue_v1, TraceQualificationCodecLimitsV1
export trace_qualification_codec_limits_v1, TraceSnapshotV1, TraceSelectionV1
export TraceEvaluationV1, TraceDiagnosticV1, TraceQualificationV1, TraceDocumentV1
