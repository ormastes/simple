"""Canonical named tables, exact bounded output, stable full-record byte sort."""
use std.common.sdn.value.{SdnValue}
use std.common.traceability.codec_order_v1.{trace_codec_row_order_v1}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}
use std.common.traceability.graph_types_v1.*
use std.common.traceability.graph_wire_v1.*
use std.common.traceability.graph_budget_v1.{trace_graph_output_cap_v1}
use std.common.traceability.graph_schema_v1.{trace_graph_validate_v1}

fn trace_graph_rows_v1(document: TraceGraphV1, section: text) -> [[SdnValue]]:
    var rows: [[SdnValue]] = []
    match section:
        case "inputs":
            for item in document.inputs: rows.push(trace_graph_input_row_v1(item))
        case "nodes":
            for item in document.nodes: rows.push(trace_graph_node_row_v1(item))
        case "test_definitions":
            for item in document.test_definitions: rows.push(trace_graph_test_row_v1(item))
        case "edges":
            for item in document.edges: rows.push(trace_graph_edge_row_v1(item))
        case "edge_origins":
            for item in document.edge_origins: rows.push(trace_graph_origin_row_v1(item))
        case "locators":
            for item in document.locators: rows.push(trace_graph_locator_row_v1(item))
        case _: ()
    rows

pub fn trace_graph_encode_v1(document: TraceGraphV1, limits: TraceGraphCodecLimitsV1) -> Result<text, TraceCodecIssueV1>:
    trace_graph_validate_v1(document, limits, true)?
    val cap = trace_graph_output_cap_v1(limits)
    var size = trace_graph_envelope_size_v1(document)
    if size > cap: return Err(trace_codec_issue_v1("output_limit", "", "Graph envelope exceeds byte budget before escaping"))
    val sections = ["inputs", "nodes", "test_definitions", "edges", "edge_origins", "locators"]
    # All strict counts/text bounds and reference closure passed before rows.
    # Exact scalar sizes are charged before any escaped row or sort key exists.
    var tables: [[[SdnValue]]] = []
    var headers: [text] = []
    for section in sections:
        val header = section + " |" + trace_graph_headers_v1(section).join(", ") + "|\n"
        if header.len() > cap - size: return Err(trace_codec_issue_v1("output_limit", section, "Graph header exceeds byte budget"))
        size = size + header.len()
        headers.push(header)
        val rows = trace_graph_rows_v1(document, section)
        for row in rows:
            val charge = trace_graph_row_size_v1(row)
            if charge > cap - size: return Err(trace_codec_issue_v1("output_limit", section, "Graph row exceeds byte budget before escaping"))
            size = size + charge
        tables.push(rows)
    var parts: [text] = [trace_graph_envelope_v1(document)]
    var section_index = 0
    for rows in tables:
        parts.push(headers[section_index])
        var keys: [text] = []
        for row in rows:
            # The common table writer owns scalar delimiters/escaping. Only
            # one bounded row is rendered, avoiding its full-table concat loop.
            val rendered = sdn_encode_canonical(SdnValue.Table([], [row]))
            keys.push(rendered[3:rendered.len()])
        for index in trace_codec_row_order_v1(keys): parts.push("    " + keys[index] + "\n")
        section_index = section_index + 1
    val output = parts.join("")
    if output.len() != size or output.len() > cap:
        return Err(trace_codec_issue_v1("output_limit", "", "Graph writer disagrees with preflight"))
    Ok(output)

export trace_graph_encode_v1
