"""Shared codec issues and snapshot data; no receipt authority."""

pub struct TraceCodecIssueV1:
    code: text
    path: text
    message: text
    location_available: bool
    offset: i64
    line: i64
    column: i64

pub fn trace_codec_issue_v1(code: text, path: text, message: text) -> TraceCodecIssueV1:
    TraceCodecIssueV1(code: code, path: path, message: message,
        location_available: false, offset: 0, line: 0, column: 0)

pub enum TraceCodecValidityV1:
    Valid
    Invalid

pub struct TraceCodecIntegerV1:
    value: i64

pub struct TraceCodecFlagV1:
    value: bool

pub struct TraceCodecRowIndexV1:
    value: i64

pub struct TraceGraphByteCountV1:
    value: i64

pub struct TraceCountLimitV1:
    value: i64

pub struct TraceByteLimitV1:
    value: i64

pub enum TraceGraphValidationModeV1:
    Decoding
    Encoding

pub struct TraceSnapshotV1:
    id: text
    kind: text
    complete: bool

export TraceCodecIssueV1, trace_codec_issue_v1, TraceSnapshotV1
export TraceCodecValidityV1, TraceCodecIntegerV1, TraceCodecFlagV1, TraceCodecRowIndexV1
export TraceCountLimitV1, TraceByteLimitV1
export TraceGraphByteCountV1, TraceGraphValidationModeV1
