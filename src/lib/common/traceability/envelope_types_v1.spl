"""Shared codec issues and snapshot data; no receipt authority."""

pub struct TraceCodecIssueV1:
    code: text
    path: text
    message: text
    location_available: TraceAvailabilityV1
    offset: TraceByteOffsetV1
    line: TraceLineNumberV1
    column: TraceColumnNumberV1

pub fn trace_codec_issue_v1(code: text, path: text, message: text) -> TraceCodecIssueV1:
    TraceCodecIssueV1(code: code, path: path, message: message,
        location_available: TraceAvailabilityV1.Absent, offset: TraceByteOffsetV1(value: 0),
        line: TraceLineNumberV1(value: 0), column: TraceColumnNumberV1(value: 0))

pub enum TraceCompletenessV1:
    Complete
    Incomplete

pub enum TraceAvailabilityV1:
    Available
    Absent

pub enum TraceChangeStateV1:
    Changed
    Unchanged

pub enum TraceRebuildScopeV1:
    Full
    Partial

pub enum TraceStageStateV1:
    Reached
    NotReached

pub enum TraceLookupOutcomeV1:
    Found
    NotFound

pub enum TraceExecutionStateV1:
    Executed
    NotExecuted

pub enum TraceSeedStateV1:
    Set
    Unset

pub enum TraceFailFastV1:
    FailFast
    Continue

pub enum TraceParallelismV1:
    Parallel
    Serial

pub enum TraceSelectionScopeV1:
    FullRepository
    SelectedPaths

pub struct TraceLineNumberV1:
    value: i64

pub struct TraceColumnNumberV1:
    value: i64

pub struct TraceByteOffsetV1:
    value: i64

pub struct TraceUsedCountV1:
    value: i64

pub struct TraceCoverageCountV1:
    value: i64

pub struct TraceTimeoutSecsV1:
    value: i64

pub struct TraceSeedV1:
    value: i64

pub struct TraceWorkerCountV1:
    value: i64

pub struct TraceShardIndexV1:
    value: i64

pub struct TraceShardCountV1:
    value: i64

pub struct TraceAttemptNumberV1:
    value: i64

pub struct TraceEvaluationExitCodeV1:
    value: i64

pub enum TraceCodecValidityV1:
    Valid
    Invalid

pub struct TraceCodecIntegerV1:
    value: i64

pub struct TraceCodecFlagV1:
    value: bool

pub struct TraceCodecRowIndexV1:
    value: i64

pub struct TraceGraphByteCountV1:
    value: i64

pub struct TraceCountLimitV1:
    value: i64

pub struct TraceByteLimitV1:
    value: i64

pub enum TraceGraphValidationModeV1:
    Decoding
    Encoding

pub struct TraceSnapshotV1:
    id: text
    kind: text
    complete: TraceCompletenessV1

export TraceCodecIssueV1, trace_codec_issue_v1, TraceSnapshotV1
export TraceCodecValidityV1, TraceCodecIntegerV1, TraceCodecFlagV1, TraceCodecRowIndexV1
export TraceCountLimitV1, TraceByteLimitV1
export TraceCompletenessV1, TraceAvailabilityV1, TraceChangeStateV1, TraceRebuildScopeV1, TraceStageStateV1, TraceLookupOutcomeV1, TraceExecutionStateV1
export TraceSeedStateV1, TraceFailFastV1, TraceParallelismV1, TraceSelectionScopeV1
export TraceLineNumberV1, TraceColumnNumberV1, TraceByteOffsetV1, TraceUsedCountV1, TraceCoverageCountV1
export TraceTimeoutSecsV1, TraceSeedV1, TraceWorkerCountV1, TraceShardIndexV1, TraceShardCountV1, TraceEvaluationExitCodeV1
export TraceAttemptNumberV1
export TraceGraphByteCountV1, TraceGraphValidationModeV1
