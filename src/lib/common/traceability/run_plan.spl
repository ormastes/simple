# Frozen execution intent and reconciliation of untrusted framework events.
# This pure kernel cannot admit evidence or establish qualification.
use std.common.traceability.case_events.{TraceCaseEvent}

val TRACE_RUN_PLAN_MAX_CASES: i64 = 65536

pub struct TracePlannedCase:
    case_id: text
    test_path: text
    case_name: text
    test_definition_id: text
    lane_id: text

pub struct TraceRunPlan:
    run_id: text
    subject_id: text
    configuration_id: text
    expectation_id: text
    binary_id: text
    cases: [TracePlannedCase]

pub struct TraceCaseAttempt:
    case_id: text
    started: bool
    finished: bool
    outcome: text

pub struct TraceRunCompletion:
    complete: bool
    attempts: [TraceCaseAttempt]
    missing_case_ids: [text]
    reason: text

# Actual events remain grouped by the exact source file that emitted them.
pub struct TraceCaseEventFile:
    test_path: text
    events: [TraceCaseEvent]

# Length-prefixing makes the path/name pair key unambiguous for arbitrary text.
fn _trace_case_scope_key(test_path: text, case_name: text) -> text:
    "{test_path.len()}:{test_path}{case_name}"

pub fn validate_trace_run_plan(plan: TraceRunPlan) -> Result<(), text>:
    if plan.run_id == "" or plan.subject_id == "" or plan.configuration_id == "" or plan.expectation_id == "" or plan.binary_id == "":
        return Err("trace run plan identity is incomplete")
    if plan.cases.len() == 0:
        return Err("feature trace run plan requires at least one planned case")
    if plan.cases.len() > TRACE_RUN_PLAN_MAX_CASES:
        return Err("trace run plan exceeds 65536 planned cases")
    var case_ids: Dict<text, bool> = {}
    var scoped_names: Dict<text, bool> = {}
    for planned in plan.cases:
        if planned.case_id == "" or planned.test_path == "" or planned.case_name == "" or planned.test_definition_id == "" or planned.lane_id == "":
            return Err("planned case identity is incomplete")
        if case_ids.contains_key(planned.case_id):
            return Err("duplicate planned case id: " + planned.case_id)
        case_ids[planned.case_id] = true
        val scoped_name = _trace_case_scope_key(planned.test_path, planned.case_name)
        if scoped_names.contains_key(scoped_name):
            return Err("duplicate planned path and case name: " + planned.test_path + " :: " + planned.case_name)
        scoped_names[scoped_name] = true
    Ok(())

# Reconcile actual observations against the separately frozen plan. A started
# prefix without a terminal event is retained as an incomplete attempt. A
# terminal failure is complete execution with outcome=failed, not a pass.
pub fn reconcile_trace_case_events(plan: TraceRunPlan, actual_files: [TraceCaseEventFile]) -> Result<TraceRunCompletion, text>:
    validate_trace_run_plan(plan)?
    if actual_files.len() > TRACE_RUN_PLAN_MAX_CASES:
        return Err("trace event file count exceeds plan budget")
    var planned_index: Dict<text, i64> = {}
    var planned_paths: Dict<text, bool> = {}
    var case_index: i64 = 0
    for planned in plan.cases:
        planned_index[_trace_case_scope_key(planned.test_path, planned.case_name)] = case_index
        planned_paths[planned.test_path] = true
        case_index = case_index + 1
    var file_paths: Dict<text, bool> = {}
    var started: [bool] = []
    var finished: [bool] = []
    var outcomes: [text] = []
    var attempts: [TraceCaseAttempt] = []
    var missing: [text] = []
    var i = 0
    while i < plan.cases.len():
        started.push(false)
        finished.push(false)
        outcomes.push("")
        i = i + 1
    var event_count: i64 = 0
    for file_events in actual_files:
        if file_events.test_path == "":
            return Err("trace event file path is empty")
        if file_paths.contains_key(file_events.test_path):
            return Err("duplicate trace event file path: " + file_events.test_path)
        if not planned_paths.contains_key(file_events.test_path):
            return Err("unknown trace event file: " + file_events.test_path)
        file_paths[file_events.test_path] = true
        event_count += file_events.events.len()
        if event_count > plan.cases.len() * 2:
            return Err("trace event count exceeds frozen plan budget")
        for event in file_events.events:
            if event.case_name == "":
                return Err("trace case event name is empty")
            val key = _trace_case_scope_key(file_events.test_path, event.case_name)
            val index = planned_index[key] ?? -1
            if index < 0:
                return Err("unknown trace case for planned file: " + file_events.test_path + " :: " + event.case_name)
            if event.phase == "started":
                if event.outcome != "not_finished":
                    return Err("started trace event has an invalid outcome")
                if started[index]:
                    return Err("duplicate trace case start: " + plan.cases[index].case_id)
                started[index] = true
            elif event.phase == "finished":
                if event.outcome != "passed" and event.outcome != "failed" and event.outcome != "pending":
                    return Err("finished trace event has an invalid outcome")
                if not started[index]:
                    return Err("trace case finished without a start: " + plan.cases[index].case_id)
                if finished[index]:
                    return Err("duplicate trace case terminal event: " + plan.cases[index].case_id)
                finished[index] = true
                outcomes[index] = event.outcome
            else:
                return Err("unknown trace case event phase: " + event.phase)
    var all_complete = true
    for i in 0..plan.cases.len():
        val case_id = plan.cases[i].case_id
        attempts.push(TraceCaseAttempt(case_id: case_id, started: started[i], finished: finished[i], outcome: outcomes[i]))
        if not finished[i] or outcomes[i] == "pending":
            all_complete = false
            missing.push(case_id)
    val reason = if all_complete: "all planned cases have terminal pass/fail observations" else: "planned cases are missing, interrupted, or pending"
    Ok(TraceRunCompletion(complete: all_complete, attempts: attempts, missing_case_ids: missing, reason: reason))
