"""Normalized graph data. Claimed manifest/provenance never grants authority."""
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1, sdn_strict_limits_v1}
use std.common.traceability.types_v1.{TraceSnapshotV1}

pub struct TraceGraphCodecLimitsV1:
    sdn: SdnStrictLimitsV1
    max_records: i64 = 100000
    max_text_bytes: i64 = 1048576
    max_field_bytes: i64 = 4096
    max_output_bytes: i64 = 1048576

pub fn trace_graph_codec_limits_v1() -> TraceGraphCodecLimitsV1:
    TraceGraphCodecLimitsV1(sdn: sdn_strict_limits_v1())

pub struct TraceGraphManifestV1:
    input_set_id: text
    extractor_version: text
    rules_version: text
    policy_id: text
    complete: bool

pub struct TraceGraphInputV1:
    path: text
    sha256: text
    bytes: i64
    role: text

pub struct TraceGraphNodeV1:
    id: text
    kind: text
    title: text

pub struct TraceGraphTestDefinitionV1:
    entity_id: text
    test_kind: text
    identity_scope: text
    definition_id: text
    parameter_digest_available: bool
    parameter_digest: text

pub struct TraceGraphEdgeV1:
    id: text
    from_id: text
    relation: text
    to_id: text

pub struct TraceGraphOriginV1:
    edge_id: text
    origin_kind: text
    origin_id: text
    declaration_path_available: bool
    declaration_path: text
    span_available: bool
    line: i64
    column: i64
    extractor_version: text

pub struct TraceGraphLocatorV1:
    entity_id: text
    path_available: bool
    path: text
    locator_kind: text
    locator: text

pub struct TraceGraphV1:
    snapshot: TraceSnapshotV1
    manifest: TraceGraphManifestV1
    inputs: [TraceGraphInputV1]
    nodes: [TraceGraphNodeV1]
    test_definitions: [TraceGraphTestDefinitionV1]
    edges: [TraceGraphEdgeV1]
    edge_origins: [TraceGraphOriginV1]
    locators: [TraceGraphLocatorV1]

export TraceGraphCodecLimitsV1, trace_graph_codec_limits_v1, TraceGraphManifestV1
export TraceGraphInputV1, TraceGraphNodeV1, TraceGraphTestDefinitionV1
export TraceGraphEdgeV1, TraceGraphOriginV1, TraceGraphLocatorV1, TraceGraphV1
