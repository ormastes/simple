"""Count/text/work charges precede result append and deterministic sort keys."""
use std.common.traceability.conventions_types_v1.*
use std.common.traceability.graph_wire_v1.{trace_graph_tuple_key_v1}
use std.common.traceability.codec_order_v1.{trace_codec_row_order_v1}
use std.common.traceability.codec_text_budget_v1.{TraceCodecTextBudgetV1}
use std.common.traceability.qualification_types_v1.{TraceDiagnosticV1}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}

pub class TraceConventionResultBuilderV1:
    limits: TraceConventionLimitsV1
    result: TraceConventionResolutionV1
    text_budget: TraceCodecTextBudgetV1
    used_work: i64 = 0
    seen_claims: Dict<text, bool> = {}
    seen_lookups: Dict<text, bool> = {}
    claim_keys: [text] = []
    diagnostic_keys: [text] = []
    lookup_keys: [text] = []
    me work(amount: i64 = 1) -> Result<bool, TraceCodecIssueV1>:
        if amount < 0 or amount > self.limits.max_work - self.used_work:
            return Err(trace_codec_issue_v1("work_limit", "", "Convention evaluation exhausted bounded work"))
        self.used_work = self.used_work + amount
        Ok(true)
    me claim(from_id: text, relation: text, to_id: text, rule_id: text, source_path: text, target_path: text) -> Result<bool, TraceCodecIssueV1>:
        self.work()?
        if self.result.claims.len() >= self.limits.max_claims: return Err(trace_codec_issue_v1("claim_limit", "claims", "Claim count exceeds budget"))
        val fields = [from_id, relation, to_id, rule_id, source_path, target_path]
        self.text_budget.charge(fields, "claims")?
        val key = trace_graph_tuple_key_v1(fields)
        if self.seen_claims.contains_key(key): return Ok(true)
        self.seen_claims[key] = true
        self.claim_keys.push(key)
        self.result.claims.push(TraceConventionClaimV1(from_id: from_id, relation: relation, to_id: to_id, rule_id: rule_id, source_path: source_path, target_path: target_path))
        Ok(true)
    me diagnostic(code: text, entity: text, path: text, origin: text) -> Result<bool, TraceCodecIssueV1>:
        self.work()?
        if self.result.diagnostics.len() >= self.limits.max_diagnostics: return Err(trace_codec_issue_v1("diagnostic_limit", "diagnostics", "Diagnostic count exceeds budget"))
        val message = "Conventional structural association could not be resolved"
        val repair = "Register or repair exact mapping, identity, role, exclusion or generator binding"
        val fields = [code, "error", entity, path, (path != "").to_text(), "false", "0", "0", message, self.result.snapshot_id, self.result.rules_version, origin, repair]
        self.text_budget.charge(fields, "diagnostics")?
        self.diagnostic_keys.push(trace_graph_tuple_key_v1(fields))
        self.result.diagnostics.push(TraceDiagnosticV1(code: code, severity: "error", entity: entity, path: path, path_available: path != "", span_available: false, line: 0, column: 0, message: message, snapshot_id: self.result.snapshot_id, rule_version: self.result.rules_version, origin: origin, repair: repair))
        Ok(true)
    me lookup(kind: text, entity: text, group: text, rule: text, path: text, ids: [text]) -> Result<bool, TraceCodecIssueV1>:
        self.work(ids.len() + 1)?
        if self.result.lookups.len() >= self.limits.max_lookups: return Err(trace_codec_issue_v1("lookup_limit", "lookups", "Lookup count exceeds budget"))
        val fields = [kind, entity, group, rule, path, (ids.len() > 0).to_text()]
        self.text_budget.charge(fields, "lookups")?
        for id in ids: self.text_budget.charge([id], "lookup.candidate_ids")?
        val order = trace_codec_row_order_v1(ids)
        var candidates: [text] = []
        var last = ""
        for index in order:
            if ids[index] != last:
                candidates.push(ids[index])
                last = ids[index]
        val key = trace_graph_tuple_key_v1(fields + candidates)
        if self.seen_lookups.contains_key(key): return Ok(true)
        self.seen_lookups[key] = true
        self.lookup_keys.push(key)
        self.result.lookups.push(TraceConventionLookupV1(kind: kind, entity_id: entity, group_id: group, rule_id: rule, path: path, found: candidates.len() > 0, candidate_ids: candidates))
        Ok(true)
    me finish() -> TraceConventionResolutionV1:
        var claims: [TraceConventionClaimV1] = []
        for index in trace_codec_row_order_v1(self.claim_keys): claims.push(self.result.claims[index])
        var diagnostics: [TraceDiagnosticV1] = []
        for index in trace_codec_row_order_v1(self.diagnostic_keys): diagnostics.push(self.result.diagnostics[index])
        var lookups: [TraceConventionLookupV1] = []
        for index in trace_codec_row_order_v1(self.lookup_keys): lookups.push(self.result.lookups[index])
        self.result.claims = claims
        self.result.diagnostics = diagnostics
        self.result.lookups = lookups
        self.result.complete = true
        self.result

export TraceConventionResultBuilderV1
