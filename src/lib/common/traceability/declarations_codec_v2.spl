"""Single-parse major2 adapter; no migration, policy or authority inference."""
use std.common.sdn.value.{SdnValue}
use std.common.sdn.strict_v1.{sdn_parse_strict_v1}
use std.common.sdn.value_limits_v1.{sdn_validate_value_limits_v1}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.traceability.envelope_types_v1.{TraceCodecIssueV1, trace_codec_issue_v1}
use std.common.traceability.declarations_types_v1.{TraceDeclarationsCodecLimitsV1}
use std.common.traceability.declarations_types_v2.*
use std.common.traceability.declarations_schema_v1.{trace_declarations_limits_valid_v1}
use std.common.traceability.declarations_schema_v2.{trace_declarations_validate_v2}
use std.common.traceability.declarations_v1.{trace_declarations_from_value_v1, trace_declarations_encode_v1}
use std.common.traceability.declarations_wire_v2.*
use std.common.traceability.codec_fields_v1.*
use std.common.traceability.codec_order_v1.{trace_codec_row_order_v1}

pub fn trace_declarations_from_value_v2(value: SdnValue, limits: TraceDeclarationsCodecLimitsV1) -> Result<TraceDeclarationsV2, TraceCodecIssueV1>:
    if not trace_declarations_limits_valid_v1(limits): return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits outside hard bounds"))
    match sdn_validate_value_limits_v1(value, limits.sdn):
        case Ok(_): ()
        case Err(issue): return Err(trace_codec_issue_v1(issue.code, "", issue.message))
    val root = trace_codec_dict_v1(value, "", ["schema", "id", "namespace", "claims", "aliases", "exceptions", "origins", "explicit_links", "replacement_scopes"])?
    val schema = trace_codec_dict_v1(root["schema"], "schema", ["name", "version"])?
    if trace_codec_text_v1(schema["name"], "schema.name")? != "simple.trace.declarations":
        return Err(trace_codec_issue_v1("unsupported_family", "schema.name", "Declaration family required"))
    if trace_codec_int_v1(schema["version"], "schema.version")? != 2:
        return Err(trace_codec_issue_v1("schema_version", "schema.version", "Explicit declaration major2 required"))
    var count = 0
    for section in ["claims", "aliases", "exceptions", "origins", "explicit_links", "replacement_scopes"]:
        match root[section]:
            case Table(_, rows):
                if rows.len() > limits.max_records - count: return Err(trace_codec_issue_v1("record_limit", section, "Combined records exceed budget"))
                count = count + rows.len()
            case _: return Err(trace_codec_issue_v1("wrong_type", section, "Named table required"))
    var base_schema: Dict<text, SdnValue> = {}
    base_schema["name"] = SdnValue.String("simple.trace.declarations")
    base_schema["version"] = SdnValue.Int(1)
    var base_root: Dict<text, SdnValue> = {}
    base_root["schema"] = SdnValue.Dict(base_schema)
    for field in ["id", "namespace", "claims", "aliases", "exceptions", "origins"]: base_root[field] = root[field]
    val base = trace_declarations_from_value_v1(SdnValue.Dict(base_root), limits)?
    var links: [TraceExplicitLinkV2] = []
    var index = 0
    for row in trace_codec_table_v1(root["explicit_links"], "explicit_links", trace_declarations_headers_v2("explicit_links"))?:
        val path = "explicit_links." + index.to_text()
        links.push(TraceExplicitLinkV2(id: trace_codec_text_v1(row[0], path + ".id")?, owner: trace_codec_text_v1(row[1], path + ".owner")?,
            from_id: trace_codec_text_v1(row[2], path + ".from_id")?, relation: trace_codec_text_v1(row[3], path + ".relation")?, to_id: trace_codec_text_v1(row[4], path + ".to_id")?,
            operation: trace_codec_text_v1(row[5], path + ".operation")?, replaces_rule: trace_codec_text_v1(row[6], path + ".replaces_rule")?, reason: trace_codec_text_v1(row[7], path + ".reason")?,
            origin_id: trace_codec_text_v1(row[8], path + ".origin_id")?, exception_id: trace_codec_text_v1(row[9], path + ".exception_id")?))
        index = index + 1
    var scopes: [TraceReplacementScopeV2] = []
    index = 0
    for row in trace_codec_table_v1(root["replacement_scopes"], "replacement_scopes", trace_declarations_headers_v2("replacement_scopes"))?:
        val path = "replacement_scopes." + index.to_text()
        scopes.push(TraceReplacementScopeV2(operation_id: trace_codec_text_v1(row[0], path + ".operation_id")?, from_id: trace_codec_text_v1(row[1], path + ".from_id")?,
            relation: trace_codec_text_v1(row[2], path + ".relation")?, to_id: trace_codec_text_v1(row[3], path + ".to_id")?))
        index = index + 1
    val document = TraceDeclarationsV2(base: base, explicit_links: links, replacement_scopes: scopes)
    trace_declarations_validate_v2(document, limits)?
    Ok(document)

pub fn trace_declarations_decode_v2(source: text, limits: TraceDeclarationsCodecLimitsV1) -> Result<TraceDeclarationsV2, TraceCodecIssueV1>:
    if not trace_declarations_limits_valid_v1(limits): return Err(trace_codec_issue_v1("invalid_limits", "", "Codec limits outside hard bounds"))
    match sdn_parse_strict_v1(source, limits.sdn):
        case Ok(parsed): trace_declarations_from_value_v2(parsed.value, limits)
        case Err(issue):
            val located = issue.code != "invalid_limits" and issue.code != "source_limit"
            Err(TraceCodecIssueV1(code: issue.code, path: "", message: issue.message,
                location_available: located, offset: issue.offset, line: if located: issue.line else: 0, column: if located: issue.column else: 0))

pub fn trace_declarations_encode_v2(document: TraceDeclarationsV2, limits: TraceDeclarationsCodecLimitsV1) -> Result<text, TraceCodecIssueV1>:
    trace_declarations_validate_v2(document, limits, true)?
    val expected = trace_declarations_output_size_v2(document)
    val base = trace_declarations_encode_v1(document.base, limits)?
    val old_prefix = "schema: {name: simple.trace.declarations, version: 1}\n"
    if not base.starts_with(old_prefix): return Err(trace_codec_issue_v1("writer_mismatch", "schema", "Base writer has unexpected schema spelling"))
    var parts: [text] = ["schema: {name: simple.trace.declarations, version: 2}\n" + base[old_prefix.len():base.len()]]
    for section in ["explicit_links", "replacement_scopes"]:
        parts.push(section + " |" + trace_declarations_headers_v2(section).join(", ") + "|\n")
        var keys: [text] = []
        for row in trace_declarations_rows_v2(document, section):
            val encoded = sdn_encode_canonical(SdnValue.Table([], [row]))
            keys.push(encoded[3:encoded.len()])
        for index in trace_codec_row_order_v1(keys): parts.push("    " + keys[index] + "\n")
    val output = parts.join("")
    val cap = if limits.max_output_bytes < limits.sdn.max_source_bytes: limits.max_output_bytes else: limits.sdn.max_source_bytes
    if output.len() != expected or output.len() > cap: return Err(trace_codec_issue_v1("output_limit", "", "Writer disagrees with exact preflight"))
    Ok(output)

export trace_declarations_from_value_v2, trace_declarations_decode_v2, trace_declarations_encode_v2
