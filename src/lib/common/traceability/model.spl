# Shared immutable trace records. Effects and execution admission belong to owners.
# @req REQ-TRC-001 REQ-TRC-003 REQ-TRC-007 REQ-TRC-016

pub enum TraceNodeKind:
    Feature
    Requirement
    AcceptanceCriterion
    TestSuite
    TestCase
    ParameterizedCase
    SourceFile
    Symbol
    Research
    Architecture
    Design
    Plan
    Document
    Component
    Layer
    Transform
    Run
    Observation
    EvidenceArtifact
    Exception
    Bug
    Decision

pub enum TraceRelation:
    Specifies
    DecomposesTo
    AcceptedBy
    VerifiedBy
    Targets
    ImplementedBy
    MotivatedBy
    DescribedBy
    BelongsTo
    GeneratedFrom
    ObservedIn
    Produced
    DependsOn
    Supersedes
    Aliases
    Contains

pub enum TraceOriginKind:
    Explicit
    Annotation
    Convention
    CompilerIndex
    RuntimeObservation

pub enum TraceClaimOperation:
    Add
    Replace
    Suppress

pub enum TraceTestKind:
    Acceptance
    Unit
    Integration
    Component
    System
    Performance

pub struct TraceTestDefinition:
    node_id: text
    kind: TraceTestKind
    definition_id: text
    parameter_digest: text
    definition_digest: text

pub struct SnapshotSubject:
    repository_id: text
    snapshot_id: text
    kind: text
    revision_id: text
    tree_id: text
    object_format: text

pub struct SnapshotArtifact:
    path: text
    blob_id: text
    content: text
    visibility: text

pub struct SnapshotInput:
    subject: SnapshotSubject
    artifacts: [SnapshotArtifact]
    complete: bool

pub struct TraceNode:
    id: text
    kind: TraceNodeKind
    title: text

pub struct TraceOrigin:
    id: text
    kind: TraceOriginKind
    owner_path: text
    locator: text
    rule_version: text

pub struct TraceClaim:
    id: text
    from_id: text
    relation: TraceRelation
    to_id: text
    origin_id: text
    operation: TraceClaimOperation
    rule_id: text
    scope_id: text

pub struct TraceEdge:
    id: text
    from_id: text
    relation: TraceRelation
    to_id: text

pub struct TraceEdgeOrigin:
    edge_id: text
    origin_id: text

pub struct TraceLocator:
    entity_id: text
    path: text
    locator_kind: text
    locator: text
    blob_id: text

pub struct TraceDiagnostic:
    code: text
    subject_id: text
    rule_id: text
    entity_id: text
    origin_id: text
    message: text
    severity: text

pub struct TraceGraph:
    subject: SnapshotSubject
    input_manifest_id: text
    nodes: [TraceNode]
    test_definitions: [TraceTestDefinition]
    claims: [TraceClaim]
    edges: [TraceEdge]
    edge_origins: [TraceEdgeOrigin]
    origins: [TraceOrigin]
    locators: [TraceLocator]
    diagnostics: [TraceDiagnostic]
    generation_id: text
    complete: bool

pub struct TraceFacts:
    subject: SnapshotSubject
    input_manifest_id: text
    nodes: [TraceNode]
    test_definitions: [TraceTestDefinition]
    claims: [TraceClaim]
    origins: [TraceOrigin]
    locators: [TraceLocator]
    diagnostics: [TraceDiagnostic]
    generation_id: text
    complete: bool

# Policies are supplied by the trusted owner, never read from candidate claims.
pub struct TraceAuthority:
    origin_id: text
    relation: TraceRelation
    scope_id: text
    owner_path: text
    allow_override: bool
    review_id: text
    reason: text
    expires_snapshot_id: text

pub struct TraceConventionRule:
    id: text
    source_root: text
    target_root: text
    source_suffix: text
    target_suffix: text
    relation: TraceRelation
    version: text

pub struct TracePolicy:
    id: text
    conventions: [TraceConventionRule]
    authorities: [TraceAuthority]
    max_nodes: i64
    max_claims: i64

pub struct TraceDocument:
    schema_name: text
    schema_version: i64
    graph: TraceGraph

pub struct TraceQuery:
    snapshot_id: text
    selected_id: text
    direction: text
    limit: i64
    cursor: text

pub struct TraceQueryResult:
    snapshot_id: text
    nodes: [TraceNode]
    edges: [TraceEdge]
    total_count: i64
    next_cursor: text
    complete: bool
    diagnostics: [TraceDiagnostic]

pub struct SourceSlice:
    snapshot_id: text
    blob_id: text
    path: text
    start_line: i64
    end_line: i64
    content: text

pub fn node_kind_name(kind: TraceNodeKind) -> text:
    match kind:
        case TraceNodeKind.Feature: "feature"
        case TraceNodeKind.Requirement: "requirement"
        case TraceNodeKind.AcceptanceCriterion: "acceptance_criterion"
        case TraceNodeKind.TestSuite: "test_suite"
        case TraceNodeKind.TestCase: "test_case"
        case TraceNodeKind.ParameterizedCase: "parameterized_case"
        case TraceNodeKind.SourceFile: "source_file"
        case TraceNodeKind.Symbol: "symbol"
        case TraceNodeKind.Research: "research"
        case TraceNodeKind.Architecture: "architecture"
        case TraceNodeKind.Design: "design"
        case TraceNodeKind.Plan: "plan"
        case TraceNodeKind.Document: "document"
        case TraceNodeKind.Component: "component"
        case TraceNodeKind.Layer: "layer"
        case TraceNodeKind.Transform: "transform"
        case TraceNodeKind.Run: "run"
        case TraceNodeKind.Observation: "observation"
        case TraceNodeKind.EvidenceArtifact: "evidence_artifact"
        case TraceNodeKind.Exception: "exception"
        case TraceNodeKind.Bug: "bug"
        case TraceNodeKind.Decision: "decision"

pub fn test_kind_name(kind: TraceTestKind) -> text:
    match kind:
        case TraceTestKind.Acceptance: "acceptance"
        case TraceTestKind.Unit: "unit"
        case TraceTestKind.Integration: "integration"
        case TraceTestKind.Component: "component"
        case TraceTestKind.System: "system"
        case TraceTestKind.Performance: "performance"

pub fn relation_name(relation: TraceRelation) -> text:
    match relation:
        case TraceRelation.Specifies: "specifies"
        case TraceRelation.DecomposesTo: "decomposes_to"
        case TraceRelation.AcceptedBy: "accepted_by"
        case TraceRelation.VerifiedBy: "verified_by"
        case TraceRelation.Targets: "targets"
        case TraceRelation.ImplementedBy: "implemented_by"
        case TraceRelation.MotivatedBy: "motivated_by"
        case TraceRelation.DescribedBy: "described_by"
        case TraceRelation.BelongsTo: "belongs_to"
        case TraceRelation.GeneratedFrom: "generated_from"
        case TraceRelation.ObservedIn: "observed_in"
        case TraceRelation.Produced: "produced"
        case TraceRelation.DependsOn: "depends_on"
        case TraceRelation.Supersedes: "supersedes"
        case TraceRelation.Aliases: "aliases"
        case TraceRelation.Contains: "contains"

pub fn origin_kind_name(kind: TraceOriginKind) -> text:
    match kind:
        case TraceOriginKind.Explicit: "explicit"
        case TraceOriginKind.Annotation: "annotation"
        case TraceOriginKind.Convention: "convention"
        case TraceOriginKind.CompilerIndex: "compiler_index"
        case TraceOriginKind.RuntimeObservation: "runtime_observation"

pub fn claim_operation_name(operation: TraceClaimOperation) -> text:
    match operation:
        case TraceClaimOperation.Add: "add"
        case TraceClaimOperation.Replace: "replace"
        case TraceClaimOperation.Suppress: "suppress"

pub fn trace_diagnostic(code: text, subject: text, rule: text, entity: text, origin: text, message: text) -> TraceDiagnostic:
    TraceDiagnostic(code: code, subject_id: subject, rule_id: rule, entity_id: entity, origin_id: origin, message: message, severity: "error")

# Byte comparison is deliberate: native text '<' compares pointer addresses.
pub fn trace_text_less(left: text, right: text) -> bool:
    val a = left.bytes()
    val b = right.bytes()
    var i = 0
    while i < a.len() and i < b.len():
        if a[i].to_i64() != b[i].to_i64():
            return a[i].to_i64() < b[i].to_i64()
        i = i + 1
    a.len() < b.len()

pub fn trace_sorted_ids(ids: [text]) -> [text]:
    if ids.len() < 2:
        return ids
    val middle = ids.len() / 2
    val left = trace_sorted_ids(ids.slice(0, middle))
    val right = trace_sorted_ids(ids.slice(middle, ids.len()))
    var out: [text] = []
    var i = 0
    var j = 0
    while i < left.len() and j < right.len():
        if trace_text_less(right[j], left[i]):
            out.push(right[j])
            j = j + 1
        else:
            out.push(left[i])
            i = i + 1
    while i < left.len():
        out.push(left[i])
        i = i + 1
    while j < right.len():
        out.push(right[j])
        j = j + 1
    out
