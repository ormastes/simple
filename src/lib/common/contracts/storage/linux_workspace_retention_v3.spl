# Historical retention DATA produced by the actual source owner. This cannot
# construct a source/native token, settle capacity, delete data, or free quota.
use std.common.contracts.container.linux_fresh_workspace_v3.LinuxFreshWorkspaceNativeRetirementSnapshotV3
use std.common.contracts.container.linux_fresh_workload_v2.LinuxFreshWorkloadClosureStateV2
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.crypto.sha256.sha256_text

pub struct LinuxWorkspaceCreationRetainedMetadataV3:
    parent_identity: [u8]
    root_identity: [u8]
    invocation_digest: text
    creation_plan_digest: text
    creation_receipts_digest: text
    uncertain_creation: bool

pub struct LinuxWorkspaceRetainedMetadataV3:
    native_retirement: LinuxFreshWorkspaceNativeRetirementSnapshotV3
    parent_identity: [u8]
    root_identity: [u8]
    retention: text
    creation_plan_digest: text
    creation_receipts_digest: text
    uncertain_creation: bool

pub fn linux_workspace_identity_copy_v3(source: [u8]) -> [u8]:
    var result: [u8] = []
    for value in source: result.push(value)
    result

pub fn linux_workspace_creation_metadata_copy_v3(value: LinuxWorkspaceCreationRetainedMetadataV3) -> LinuxWorkspaceCreationRetainedMetadataV3:
    LinuxWorkspaceCreationRetainedMetadataV3(parent_identity: linux_workspace_identity_copy_v3(value.parent_identity),
        root_identity: linux_workspace_identity_copy_v3(value.root_identity), invocation_digest: value.invocation_digest,
        creation_plan_digest: value.creation_plan_digest, creation_receipts_digest: value.creation_receipts_digest,
        uncertain_creation: value.uncertain_creation)

pub fn linux_workspace_retained_metadata_copy_v3(value: LinuxWorkspaceRetainedMetadataV3) -> LinuxWorkspaceRetainedMetadataV3:
    LinuxWorkspaceRetainedMetadataV3(native_retirement: value.native_retirement,
        parent_identity: linux_workspace_identity_copy_v3(value.parent_identity), root_identity: linux_workspace_identity_copy_v3(value.root_identity),
        retention: value.retention, creation_plan_digest: value.creation_plan_digest,
        creation_receipts_digest: value.creation_receipts_digest, uncertain_creation: value.uncertain_creation)

pub fn linux_workspace_retention_bytes_v3(values: [u8]) -> SdnValue:
    var encoded: [SdnValue] = []
    for value in values: encoded.push(SdnValue.Int(value as i64))
    SdnValue.Array(encoded)

pub fn linux_workspace_creation_metadata_encode_v3(value: LinuxWorkspaceCreationRetainedMetadataV3) -> text:
    val fields: Dict<text, SdnValue> = {"kind": SdnValue.String("linux-workspace-creation-retained"), "version": SdnValue.Int(3),
        "parentIdentity": linux_workspace_retention_bytes_v3(value.parent_identity), "rootIdentity": linux_workspace_retention_bytes_v3(value.root_identity),
        "invocationDigest": SdnValue.String(value.invocation_digest), "creationPlanDigest": SdnValue.String(value.creation_plan_digest),
        "creationReceiptsDigest": SdnValue.String(value.creation_receipts_digest), "uncertainCreation": SdnValue.Bool(value.uncertain_creation)}
    sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"

pub fn linux_workspace_retirement_snapshot_value_v3(value: LinuxFreshWorkspaceNativeRetirementSnapshotV3) -> SdnValue:
    val b = value.binding
    val binding: Dict<text, SdnValue> = {"bindingDigest": SdnValue.String(b.binding_digest),
        "machinePolicyDigest": SdnValue.String(b.machine_policy_digest), "providerPolicyDigest": SdnValue.String(b.provider_policy_digest),
        "workspaceProfileDigest": SdnValue.String(b.workspace_profile_digest), "agentProfileDigest": SdnValue.String(b.agent_profile_digest),
        "requestDigest": SdnValue.String(b.request_digest), "manifestDigest": SdnValue.String(b.manifest_digest),
        "invocationDigest": SdnValue.String(b.invocation_digest), "leaseBindingDigest": SdnValue.String(b.lease_binding_digest),
        "workspaceIdentityDigest": SdnValue.String(b.workspace_identity_digest), "directoryBindingDigest": SdnValue.String(b.directory_binding_digest),
        "sourceManifestDigest": SdnValue.String(b.source_manifest_digest), "bootstrapDigest": SdnValue.String(b.bootstrap_digest),
        "gitDigest": SdnValue.String(b.git_digest), "agentDigest": SdnValue.String(b.agent_digest),
        "imageConfigId": SdnValue.String(b.image_config_id), "serviceUid": SdnValue.Int(b.service_uid), "serviceGid": SdnValue.Int(b.service_gid)}
    val n = value.native
    val state = match n.state:
        case LinuxFreshWorkloadClosureStateV2.EmptyOriginalContainer: "empty-original-container"
        case LinuxFreshWorkloadClosureStateV2.RemovedOriginalContainer: "removed-original-container"
    val native: Dict<text, SdnValue> = {"state": SdnValue.String(state), "nativeId": SdnValue.String(n.native_id),
        "requestBindingDigest": SdnValue.String(n.request_binding_digest), "nativeBindingDigest": SdnValue.String(n.native_binding_digest),
        "cgroupDevice": SdnValue.Int(n.cgroup_device), "cgroupInode": SdnValue.Int(n.cgroup_inode),
        "cgroupMountId": SdnValue.Int(n.cgroup_mount_id), "processId": SdnValue.Int(n.process_id),
        "processStartTicks": SdnValue.Int(n.process_start_ticks), "partitionIdentityDigest": SdnValue.String(n.partition_identity_digest),
        "ownerGeneration": SdnValue.Int(n.owner_generation)}
    val fields: Dict<text, SdnValue> = {"binding": SdnValue.Dict(binding), "native": SdnValue.Dict(native),
        "subjectGeneration": SdnValue.Int(value.subject_generation), "providerGeneration": SdnValue.Int(value.provider_generation)}
    SdnValue.Dict(fields)

pub fn linux_workspace_retained_metadata_encode_v3(value: LinuxWorkspaceRetainedMetadataV3) -> text:
    val fields: Dict<text, SdnValue> = {"kind": SdnValue.String("linux-workspace-native-retired-retained"), "version": SdnValue.Int(3),
        "nativeRetirement": linux_workspace_retirement_snapshot_value_v3(value.native_retirement),
        "parentIdentity": linux_workspace_retention_bytes_v3(value.parent_identity), "rootIdentity": linux_workspace_retention_bytes_v3(value.root_identity),
        "retention": SdnValue.String(value.retention), "creationPlanDigest": SdnValue.String(value.creation_plan_digest),
        "creationReceiptsDigest": SdnValue.String(value.creation_receipts_digest), "uncertainCreation": SdnValue.Bool(value.uncertain_creation)}
    sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
