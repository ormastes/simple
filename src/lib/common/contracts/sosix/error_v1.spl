"""Typed SOSIX error vocabulary.

Compact, allocation-free record for hot paths: the kind is a `u8` constant
(same convention as `operation_v1` states), the native code is carried, and no
`text` lives in the record. `sosix_error_describe` formats on demand only.
`sosix_error_from_status` is the single place that maps a negative i32 status
(the `io_rw` / kernel-facing convention) to a kind.
"""

pub val SOSIX_ERROR_UNSUPPORTED: u8 = 1
pub val SOSIX_ERROR_INVALID_CAPABILITY: u8 = 2
pub val SOSIX_ERROR_INVALID_BUFFER: u8 = 3
pub val SOSIX_ERROR_QUEUE_FULL: u8 = 4
pub val SOSIX_ERROR_CANCELED: u8 = 5
pub val SOSIX_ERROR_TIMED_OUT: u8 = 6
pub val SOSIX_ERROR_NATIVE: u8 = 7

pub val SOSIX_NATIVE_DOMAIN_NONE: u8 = 0
pub val SOSIX_NATIVE_DOMAIN_POSIX: u8 = 1
pub val SOSIX_NATIVE_DOMAIN_SIMPLEOS: u8 = 2

# Kernel-facing negative status values (errno-shaped) that have a typed kind.
pub val SOSIX_STATUS_QUEUE_FULL: i32 = -11
pub val SOSIX_STATUS_TIMED_OUT: i32 = -110
pub val SOSIX_STATUS_CANCELED: i32 = -125

pub struct SosixError:
    kind: u8
    native_domain: u8
    native_code: i32
    transferred: u64

pub fn sosix_error_new(kind: u8) -> SosixError:
    SosixError(kind: kind, native_domain: SOSIX_NATIVE_DOMAIN_NONE, native_code: 0, transferred: 0)

pub fn sosix_error_from_status(status: i32, native_domain: u8, transferred: u64) -> SosixError:
    """Map a negative status to a typed error; a non-negative status is not an error and maps to Native/0."""
    var kind = SOSIX_ERROR_NATIVE
    if status == SOSIX_STATUS_QUEUE_FULL:
        kind = SOSIX_ERROR_QUEUE_FULL
    elif status == SOSIX_STATUS_TIMED_OUT:
        kind = SOSIX_ERROR_TIMED_OUT
    elif status == SOSIX_STATUS_CANCELED:
        kind = SOSIX_ERROR_CANCELED
    SosixError(kind: kind, native_domain: native_domain, native_code: status, transferred: transferred)

pub fn sosix_error_kind_name(kind: u8) -> text:
    if kind == SOSIX_ERROR_UNSUPPORTED:
        return "unsupported"
    if kind == SOSIX_ERROR_INVALID_CAPABILITY:
        return "invalid-capability"
    if kind == SOSIX_ERROR_INVALID_BUFFER:
        return "invalid-buffer"
    if kind == SOSIX_ERROR_QUEUE_FULL:
        return "queue-full"
    if kind == SOSIX_ERROR_CANCELED:
        return "canceled"
    if kind == SOSIX_ERROR_TIMED_OUT:
        return "timed-out"
    if kind == SOSIX_ERROR_NATIVE:
        return "native"
    "unknown"

pub fn sosix_error_describe(error: SosixError) -> text:
    "{sosix_error_kind_name(error.kind)} domain={error.native_domain} code={error.native_code} transferred={error.transferred}"

export SOSIX_ERROR_UNSUPPORTED, SOSIX_ERROR_INVALID_CAPABILITY, SOSIX_ERROR_INVALID_BUFFER
export SOSIX_ERROR_QUEUE_FULL, SOSIX_ERROR_CANCELED, SOSIX_ERROR_TIMED_OUT, SOSIX_ERROR_NATIVE
export SOSIX_NATIVE_DOMAIN_NONE, SOSIX_NATIVE_DOMAIN_POSIX, SOSIX_NATIVE_DOMAIN_SIMPLEOS
export SOSIX_STATUS_QUEUE_FULL, SOSIX_STATUS_TIMED_OUT, SOSIX_STATUS_CANCELED
export SosixError, sosix_error_new, sosix_error_from_status, sosix_error_kind_name, sosix_error_describe
