"""Frozen SOSIX service/operation ID table.

One table for every ID that exists in the tree today (SOSIX-G report §10 and
`os.sosix.host.service_contract`). Adding an ID is a contract-owner change; the
spec asserts the table is duplicate-free and that the redeclarations in
`file_operation_v1` and `os.sosix.host.service_contract` agree with it.
"""

pub val SOSIX_ID_TRACE_WRITE: u32 = 0x0001
pub val SOSIX_ID_CANCEL: u32 = 0x0002
pub val SOSIX_ID_HEALTH_PING: u32 = 0x0003
pub val SOSIX_ID_FS_READ_AT: u32 = 0x0101
pub val SOSIX_ID_FS_WRITE_AT: u32 = 0x0102
pub val SOSIX_ID_FS_STAT_HANDLE: u32 = 0x0103
pub val SOSIX_ID_NET_SEND: u32 = 0x0201
pub val SOSIX_ID_NET_RECV: u32 = 0x0202
pub val SOSIX_ID_NET_SEND_TO: u32 = 0x0203
pub val SOSIX_ID_NET_RECV_FROM: u32 = 0x0204
pub val SOSIX_ID_IPC_QUEUE_SEND: u32 = 0x0301
pub val SOSIX_ID_IPC_QUEUE_RECV: u32 = 0x0302
pub val SOSIX_ID_HOST_DISPLAY_PRESENT: u32 = 0x1001
pub val SOSIX_ID_HOST_DISPLAY_READBACK: u32 = 0x1002
pub val SOSIX_ID_HOST_INPUT_NEXT: u32 = 0x1101
pub val SOSIX_ID_HOST_TIMER_DEADLINE: u32 = 0x1201

pub fn sosix_service_ids_all() -> [u32]:
    [
        SOSIX_ID_TRACE_WRITE, SOSIX_ID_CANCEL, SOSIX_ID_HEALTH_PING,
        SOSIX_ID_FS_READ_AT, SOSIX_ID_FS_WRITE_AT, SOSIX_ID_FS_STAT_HANDLE,
        SOSIX_ID_NET_SEND, SOSIX_ID_NET_RECV, SOSIX_ID_NET_SEND_TO, SOSIX_ID_NET_RECV_FROM,
        SOSIX_ID_IPC_QUEUE_SEND, SOSIX_ID_IPC_QUEUE_RECV,
        SOSIX_ID_HOST_DISPLAY_PRESENT, SOSIX_ID_HOST_DISPLAY_READBACK,
        SOSIX_ID_HOST_INPUT_NEXT, SOSIX_ID_HOST_TIMER_DEADLINE
    ]

pub fn sosix_service_id_is_known(id: u32) -> bool:
    for known in sosix_service_ids_all():
        if known == id:
            return true
    false

pub fn sosix_service_ids_are_unique() -> bool:
    val all = sosix_service_ids_all()
    var i: i64 = 0
    while i < all.len():
        var j = i + 1
        while j < all.len():
            if all[i] == all[j]:
                return false
            j = j + 1
        i = i + 1
    true

export SOSIX_ID_TRACE_WRITE, SOSIX_ID_CANCEL, SOSIX_ID_HEALTH_PING
export SOSIX_ID_FS_READ_AT, SOSIX_ID_FS_WRITE_AT, SOSIX_ID_FS_STAT_HANDLE
export SOSIX_ID_NET_SEND, SOSIX_ID_NET_RECV, SOSIX_ID_NET_SEND_TO, SOSIX_ID_NET_RECV_FROM
export SOSIX_ID_IPC_QUEUE_SEND, SOSIX_ID_IPC_QUEUE_RECV
export SOSIX_ID_HOST_DISPLAY_PRESENT, SOSIX_ID_HOST_DISPLAY_READBACK
export SOSIX_ID_HOST_INPUT_NEXT, SOSIX_ID_HOST_TIMER_DEADLINE
export sosix_service_ids_all, sosix_service_id_is_known, sosix_service_ids_are_unique
