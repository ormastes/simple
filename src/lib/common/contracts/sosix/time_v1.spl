"""Pure SOSIX clock and deadline arithmetic shared by hosted and SimpleOS providers.

The provider owns the clock reading and wait mechanism. These helpers only
normalize unsigned nanosecond values and saturate unrepresentable deadlines.
"""

pub const SOSIX_TIME_U64_MAX_V1: u64 = 18446744073709551615u64

pub fn sosix_time_deadline_reached(deadline_ns: u64, now_ns: u64) -> bool:
    """Deadline zero means no deadline; otherwise equality counts as reached."""
    deadline_ns != 0u64 and now_ns >= deadline_ns

pub fn sosix_time_deadline_after(now_ns: u64, timeout_ns: u64) -> u64:
    """Add a relative duration without wrapping a deadline into the past."""
    if timeout_ns > SOSIX_TIME_U64_MAX_V1 - now_ns:
        SOSIX_TIME_U64_MAX_V1
    else:
        now_ns + timeout_ns

pub fn sosix_time_ceil_div_u64(value: u64, quantum: u64) -> u64:
    """Round a duration up to whole quanta without an overflowing addition."""
    if quantum == 0u64:
        return SOSIX_TIME_U64_MAX_V1
    val whole = value / quantum
    if value % quantum == 0u64: whole else: whole + 1u64

pub fn sosix_time_ticks_to_ns(ticks: u64, tick_ns: u64) -> u64:
    """Convert clock ticks to nanoseconds, saturating on overflow."""
    if tick_ns == 0u64:
        return SOSIX_TIME_U64_MAX_V1
    if ticks > SOSIX_TIME_U64_MAX_V1 / tick_ns:
        SOSIX_TIME_U64_MAX_V1
    else:
        ticks * tick_ns

pub fn sosix_time_deadline_from_ticks(
    now_ticks: u64, duration_ticks: u64, tick_ns: u64
) -> u64:
    """Form an absolute nanosecond deadline from a scheduler tick snapshot."""
    if duration_ticks > SOSIX_TIME_U64_MAX_V1 - now_ticks:
        return SOSIX_TIME_U64_MAX_V1
    sosix_time_ticks_to_ns(now_ticks + duration_ticks, tick_ns)

export SOSIX_TIME_U64_MAX_V1, sosix_time_deadline_reached
export sosix_time_deadline_after, sosix_time_ceil_div_u64
export sosix_time_ticks_to_ns, sosix_time_deadline_from_ticks
