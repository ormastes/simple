# Explicit owner policy. A checkpoint never resets the lifetime event cap.
pub struct DistributedOperationRetentionProfileV2:
    version: i64
    maximum_lifetime_events: i64
    maximum_tail_events: i64

pub fn distributed_operation_retention_profile_validate_v2(
        profile: DistributedOperationRetentionProfileV2, maximum_events: i64) -> Result<bool, text>:
    if profile.version != 1: return Err("OPERATION_CHECKPOINT_PROFILE_UNSUPPORTED")
    if (profile.maximum_lifetime_events < 1 or profile.maximum_lifetime_events > 100000 or
            profile.maximum_tail_events < 1 or
            profile.maximum_tail_events > profile.maximum_lifetime_events):
        return Err("OPERATION_CHECKPOINT_PROFILE_INVALID")
    if profile.maximum_lifetime_events != maximum_events:
        return Err("OPERATION_CHECKPOINT_PROFILE_MISMATCH")
    Ok(true)

pub fn distributed_operation_retention_profile_equal_v2(
        a: DistributedOperationRetentionProfileV2, b: DistributedOperationRetentionProfileV2) -> bool:
    (a.version == b.version and a.maximum_lifetime_events == b.maximum_lifetime_events and
        a.maximum_tail_events == b.maximum_tail_events)
