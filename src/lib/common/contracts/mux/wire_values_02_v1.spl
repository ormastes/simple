    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.ttl_ms)?)?
    Ok(size)

pub fn mux_wire_encode_mux_notify_v1(value: MuxNotifyV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxNotifyV1"),
        mux_wire_encode_mux_recipient_v1(value.recipient),
        mux_wire_encode_mux_message_kind_v1(value.kind),
        mux_wire_encode_text_v1(value.literal_text),
        mux_wire_encode_i64_v1(value.ttl_ms)])

pub fn mux_wire_decode_mux_notify_v1(value: SdnValue) -> Result<MuxNotifyV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 5)?
    mux_wire_tag_v1(fields, "MuxNotifyV1")?
    Ok(MuxNotifyV1(
        recipient: mux_wire_decode_mux_recipient_v1(fields[1])?,
        kind: mux_wire_decode_mux_message_kind_v1(fields[2])?,
        literal_text: mux_wire_decode_text_v1(fields[3])?,
        ttl_ms: mux_wire_decode_i64_v1(fields[4])?))
