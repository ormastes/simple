        mux_wire_encode_mux_object_ref_v1(value.pane),
        mux_wire_encode_mux_split_direction_v1(value.direction),
        mux_wire_encode_mux_split_size_v1(value.size),
        mux_wire_encode_mux_launch_v1(value.launch)])

pub fn mux_wire_decode_mux_split_pane_v1(value: SdnValue) -> Result<MuxSplitPaneV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 5)?
    mux_wire_tag_v1(fields, "MuxSplitPaneV1")?
    Ok(MuxSplitPaneV1(
        pane: mux_wire_decode_mux_object_ref_v1(fields[1])?,
        direction: mux_wire_decode_mux_split_direction_v1(fields[2])?,
        size: mux_wire_decode_mux_split_size_v1(fields[3])?,
        launch: mux_wire_decode_mux_launch_v1(fields[4])?))

