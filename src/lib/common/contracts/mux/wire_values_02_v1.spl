pub fn mux_wire_size_mux_notify_v1(value: MuxNotifyV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 34
    size = mux_wire_sum_v1(size, mux_wire_size_mux_recipient_v1(value.recipient)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_message_kind_v1(value.kind)?)?
