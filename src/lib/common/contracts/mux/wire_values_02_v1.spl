pub fn mux_wire_size_mux_named_key_v1(value: MuxNamedKeyV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxNamedKeyV1.Enter:
            var size: i64 = 14
            Ok(size)
        case MuxNamedKeyV1.Escape:
            var size: i64 = 16
            Ok(size)
        case MuxNamedKeyV1.Tab:
            var size: i64 = 10
            Ok(size)
        case MuxNamedKeyV1.Backspace:
            var size: i64 = 22
            Ok(size)
        case MuxNamedKeyV1.Delete:
            var size: i64 = 16
            Ok(size)
        case MuxNamedKeyV1.Up:
            var size: i64 = 8
            Ok(size)
        case MuxNamedKeyV1.Down:
            var size: i64 = 12
            Ok(size)
        case MuxNamedKeyV1.Left:
            var size: i64 = 12
            Ok(size)
        case MuxNamedKeyV1.Right:
            var size: i64 = 14
            Ok(size)
        case MuxNamedKeyV1.Home:
            var size: i64 = 12
            Ok(size)
        case MuxNamedKeyV1.End:
            var size: i64 = 10
            Ok(size)
        case MuxNamedKeyV1.PageUp:
            var size: i64 = 16
            Ok(size)
        case MuxNamedKeyV1.PageDown:
            var size: i64 = 20
            Ok(size)

pub fn mux_wire_encode_mux_named_key_v1(value: MuxNamedKeyV1) -> SdnValue:
    match value:
        case MuxNamedKeyV1.Enter: SdnValue.Array([SdnValue.String("Enter")])
        case MuxNamedKeyV1.Escape: SdnValue.Array([SdnValue.String("Escape")])
        case MuxNamedKeyV1.Tab: SdnValue.Array([SdnValue.String("Tab")])
        case MuxNamedKeyV1.Backspace: SdnValue.Array([SdnValue.String("Backspace")])
        case MuxNamedKeyV1.Delete: SdnValue.Array([SdnValue.String("Delete")])
        case MuxNamedKeyV1.Up: SdnValue.Array([SdnValue.String("Up")])
        case MuxNamedKeyV1.Down: SdnValue.Array([SdnValue.String("Down")])
        case MuxNamedKeyV1.Left: SdnValue.Array([SdnValue.String("Left")])
        case MuxNamedKeyV1.Right: SdnValue.Array([SdnValue.String("Right")])
        case MuxNamedKeyV1.Home: SdnValue.Array([SdnValue.String("Home")])
        case MuxNamedKeyV1.End: SdnValue.Array([SdnValue.String("End")])
        case MuxNamedKeyV1.PageUp: SdnValue.Array([SdnValue.String("PageUp")])
        case MuxNamedKeyV1.PageDown: SdnValue.Array([SdnValue.String("PageDown")])

pub fn mux_wire_decode_mux_named_key_v1(value: SdnValue) -> Result<MuxNamedKeyV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Enter":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.Enter)
    if tag == "Escape":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.Escape)
    if tag == "Tab":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.Tab)
    if tag == "Backspace":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.Backspace)
    if tag == "Delete":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.Delete)
    if tag == "Up":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.Up)
    if tag == "Down":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.Down)
    if tag == "Left":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.Left)
    if tag == "Right":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.Right)
    if tag == "Home":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.Home)
    if tag == "End":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.End)
    if tag == "PageUp":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.PageUp)
    if tag == "PageDown":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxNamedKeyV1.PageDown)
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_key_v1(value: MuxKeyV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxKeyV1.Named(item0):
            var size: i64 = 16
            size = mux_wire_sum_v1(size, mux_wire_size_mux_named_key_v1(item0)?)?
            Ok(size)
        case MuxKeyV1.Function(item0):
            var size: i64 = 22
            size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(item0)?)?
            Ok(size)
        case MuxKeyV1.Scalar(item0, item1, item2, item3):
            var size: i64 = 24
            size = mux_wire_sum_v1(size, mux_wire_size_u32_v1(item0)?)?
            size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(item1)?)?
            size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(item2)?)?
            size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(item3)?)?
            Ok(size)

pub fn mux_wire_encode_mux_key_v1(value: MuxKeyV1) -> SdnValue:
    match value:
        case MuxKeyV1.Named(item0): SdnValue.Array([SdnValue.String("Named"), mux_wire_encode_mux_named_key_v1(item0)])
        case MuxKeyV1.Function(item0): SdnValue.Array([SdnValue.String("Function"), mux_wire_encode_i64_v1(item0)])
        case MuxKeyV1.Scalar(item0, item1, item2, item3): SdnValue.Array([SdnValue.String("Scalar"), mux_wire_encode_u32_v1(item0), mux_wire_encode_bool_v1(item1), mux_wire_encode_bool_v1(item2), mux_wire_encode_bool_v1(item3)])

pub fn mux_wire_decode_mux_key_v1(value: SdnValue) -> Result<MuxKeyV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Named":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxKeyV1.Named(mux_wire_decode_mux_named_key_v1(fields[1])?))
    if tag == "Function":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxKeyV1.Function(mux_wire_decode_i64_v1(fields[1])?))
    if tag == "Scalar":
        if fields.len() != 5: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxKeyV1.Scalar(mux_wire_decode_u32_v1(fields[1])?, mux_wire_decode_bool_v1(fields[2])?, mux_wire_decode_bool_v1(fields[3])?, mux_wire_decode_bool_v1(fields[4])?))
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_array_mux_key_v1(value: [MuxKeyV1]) -> Result<i64, MuxWireErrorV1>:
    if value.len() > 16384: return Err(mux_wire_error_v1("array_limit"))
    var size: i64 = 2
    for item in value:
        size = mux_wire_sum_v1(size, 2)?
        size = mux_wire_sum_v1(size, mux_wire_size_mux_key_v1(item)?)?
    Ok(size)

pub fn mux_wire_encode_array_mux_key_v1(value: [MuxKeyV1]) -> SdnValue:
    var items: [SdnValue] = []
    for item in value: items.push(mux_wire_encode_mux_key_v1(item))
    SdnValue.Array(items)

pub fn mux_wire_decode_array_mux_key_v1(value: SdnValue) -> Result<[MuxKeyV1], MuxWireErrorV1>:
    val items = mux_wire_array_v1(value, -1)?
    var decoded: [MuxKeyV1] = []
    for item in items: decoded.push(mux_wire_decode_mux_key_v1(item)?)
    Ok(decoded)

pub fn mux_wire_size_mux_paste_v1(value: MuxPasteV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 30
    size = mux_wire_sum_v1(size, mux_wire_size_bytes_v1(value.bytes)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.bracketed)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.append_enter)?)?
    Ok(size)

pub fn mux_wire_encode_mux_paste_v1(value: MuxPasteV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxPasteV1"),
        mux_wire_encode_bytes_v1(value.bytes),
        mux_wire_encode_bool_v1(value.bracketed),
        mux_wire_encode_bool_v1(value.append_enter)])

pub fn mux_wire_decode_mux_paste_v1(value: SdnValue) -> Result<MuxPasteV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 4)?
    mux_wire_tag_v1(fields, "MuxPasteV1")?
    Ok(MuxPasteV1(
        bytes: mux_wire_decode_bytes_v1(fields[1])?,
        bracketed: mux_wire_decode_bool_v1(fields[2])?,
