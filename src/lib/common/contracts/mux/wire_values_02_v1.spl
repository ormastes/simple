# Fixed-arity typed SDN schema. Internal constructors require whole-envelope
# size preflight; use wire_envelope_v1 for public bounded byte conversion.
use std.common.sdn.value.{SdnValue}
use std.common.debug.capability.{CapLevel}
use std.common.contracts.mux.core_v1.*
use std.common.contracts.mux.execution_v1.*
use std.common.contracts.mux.observation_v1.*
use std.common.contracts.mux.wire_types_v1.*
use std.common.contracts.mux.wire_primitives_v1.*
use std.common.contracts.mux.wire_values_01_v1.*

pub fn mux_wire_size_mux_create_window_v1(value: MuxCreateWindowV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 44
    size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(value.session)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.name)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_launch_v1(value.launch)?)?
    Ok(size)

pub fn mux_wire_encode_mux_create_window_v1(value: MuxCreateWindowV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxCreateWindowV1"),
        mux_wire_encode_mux_object_ref_v1(value.session),
        mux_wire_encode_text_v1(value.name),
        mux_wire_encode_mux_launch_v1(value.launch)])

pub fn mux_wire_decode_mux_create_window_v1(value: SdnValue) -> Result<MuxCreateWindowV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 4)?
    mux_wire_tag_v1(fields, "MuxCreateWindowV1")?
    Ok(MuxCreateWindowV1(
        session: mux_wire_decode_mux_object_ref_v1(fields[1])?,
        name: mux_wire_decode_text_v1(fields[2])?,
        launch: mux_wire_decode_mux_launch_v1(fields[3])?))

pub fn mux_wire_size_mux_split_direction_v1(value: MuxSplitDirectionV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxSplitDirectionV1.Horizontal:
            var size: i64 = 24
            Ok(size)
        case MuxSplitDirectionV1.Vertical:
            var size: i64 = 20
            Ok(size)

pub fn mux_wire_encode_mux_split_direction_v1(value: MuxSplitDirectionV1) -> SdnValue:
    match value:
        case MuxSplitDirectionV1.Horizontal: SdnValue.Array([SdnValue.String("Horizontal")])
        case MuxSplitDirectionV1.Vertical: SdnValue.Array([SdnValue.String("Vertical")])

pub fn mux_wire_decode_mux_split_direction_v1(value: SdnValue) -> Result<MuxSplitDirectionV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Horizontal":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxSplitDirectionV1.Horizontal)
    if tag == "Vertical":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxSplitDirectionV1.Vertical)
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_split_size_v1(value: MuxSplitSizeV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxSplitSizeV1.Equal:
            var size: i64 = 14
            Ok(size)
        case MuxSplitSizeV1.Cells(item0):
            var size: i64 = 16
            size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(item0)?)?
            Ok(size)
        case MuxSplitSizeV1.Percent(item0):
            var size: i64 = 20
            size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(item0)?)?
            Ok(size)

pub fn mux_wire_encode_mux_split_size_v1(value: MuxSplitSizeV1) -> SdnValue:
    match value:
        case MuxSplitSizeV1.Equal: SdnValue.Array([SdnValue.String("Equal")])
        case MuxSplitSizeV1.Cells(item0): SdnValue.Array([SdnValue.String("Cells"), mux_wire_encode_i64_v1(item0)])
        case MuxSplitSizeV1.Percent(item0): SdnValue.Array([SdnValue.String("Percent"), mux_wire_encode_i64_v1(item0)])

pub fn mux_wire_decode_mux_split_size_v1(value: SdnValue) -> Result<MuxSplitSizeV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Equal":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxSplitSizeV1.Equal)
    if tag == "Cells":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxSplitSizeV1.Cells(mux_wire_decode_i64_v1(fields[1])?))
    if tag == "Percent":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxSplitSizeV1.Percent(mux_wire_decode_i64_v1(fields[1])?))
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_split_pane_v1(value: MuxSplitPaneV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 40
    size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(value.pane)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_split_direction_v1(value.direction)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_split_size_v1(value.size)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_launch_v1(value.launch)?)?
    Ok(size)

pub fn mux_wire_encode_mux_split_pane_v1(value: MuxSplitPaneV1) -> SdnValue:
