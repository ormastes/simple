pub fn mux_wire_decode_mux_recipient_v1(value: SdnValue) -> Result<MuxRecipientV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Client":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxRecipientV1.Client(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "Session":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxRecipientV1.Session(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "Pane":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxRecipientV1.Pane(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    Err(mux_wire_error_v1("unknown_variant"))

