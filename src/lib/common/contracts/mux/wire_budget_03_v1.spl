# Exact typed SDN node preflight, before allocating an SdnValue/hex string.
# A record/enum contributes array+tag; optional Some contributes array+tag;
# each scalar contributes1 and each collection contributes its container node.
use std.common.debug.capability.{CapLevel}
use std.common.contracts.mux.core_v1.*
use std.common.contracts.mux.execution_v1.*
use std.common.contracts.mux.observation_v1.*
use std.common.contracts.mux.wire_types_v1.*
use std.common.contracts.mux.wire_primitives_v1.*
use std.common.contracts.mux.wire_budget_01_v1.*
use std.common.contracts.mux.wire_budget_02_v1.*

pub fn mux_wire_nodes_mux_disconnect_v1(value: MuxDisconnectV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_request_receipt_v1(value.receipt)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_object_ref_v1(value.released_clients)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_cleanup_v1(value.cleanup)?)?
    Ok(nodes)

pub fn mux_wire_nodes_mux_wire_result_v1(value: MuxWireResultV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxWireResultV1.Connection(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_connection_v1(item0)?)?
            Ok(nodes)
        case MuxWireResultV1.Query(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_query_result_v1(item0)?)?
            Ok(nodes)
        case MuxWireResultV1.Mutation(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_mutation_v1(item0)?)?
            Ok(nodes)
        case MuxWireResultV1.Events(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_event_batch_v1(item0)?)?
            Ok(nodes)
        case MuxWireResultV1.Disconnect(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_disconnect_v1(item0)?)?
            Ok(nodes)

pub fn mux_wire_nodes_mux_error_v1(value: MuxErrorV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_error_kind_v1(value.kind)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_commit_state_v1(value.commit_state)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_u64_v1(value.observed_revision)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_object_ref_v1(value.affected)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    Ok(nodes)
