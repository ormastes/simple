# Full mandatory operation values; D1 discovery values remain unchanged.
# These records are untrusted messages, never owner authority or provider proof.
use std.common.contracts.mux.core_v1.*

pub val MUX_PAYLOAD_MAX_BYTES_V1: i64 = 1048576
pub val MUX_ARGUMENTS_MAX_V1: i64 = 256
pub val MUX_ENVIRONMENT_MAX_V1: i64 = 256
pub val MUX_CELLS_MAX_V1: i64 = 32767
pub val MUX_REQUEST_TIMEOUT_MAX_MS_V1: i64 = 30000

# Relative service budget, not a caller wall-clock timestamp. The owner starts
# its monotonic deadline on receipt and clamps to local policy/remaining lease.
# Repeated request IDs retain their original deadline; this cannot renew leases.
pub struct MuxDeadlineV1:
    timeout_ms: i64

pub struct MuxCellSizeV1:
    columns: i64
    rows: i64

pub struct MuxRectV1:
    x_cells: i64
    y_cells: i64
    width_cells: i64
    height_cells: i64

pub enum MuxLaunchModeV1:
    Exec(executable: text, argv: [text])
    Shell(command: text)

pub enum MuxEnvironmentChangeV1:
    Set(name: text, value: text)
    Remove(name: text)

pub struct MuxLaunchV1:
    mode: MuxLaunchModeV1
    cwd: text?
    environment: [MuxEnvironmentChangeV1]
    size: MuxCellSizeV1

pub enum MuxSplitDirectionV1:
    Horizontal
    Vertical

# Horizontal means top/bottom; Vertical means left/right. Cells is content
# extent on the split axis, excluding the separately reserved separator.
pub enum MuxSplitSizeV1:
    Equal
    Cells(count: i64)
    Percent(percent: i64)

pub enum MuxLayoutKindV1:
    Manual
    Tiled
    EvenHorizontal
    EvenVertical
    MainHorizontal
    MainVertical

pub enum MuxBorderV1:
    Hidden
    Single
    Double

pub enum MuxBorderStatusV1:
    Hidden
    Top
    Bottom

pub enum MuxNamedKeyV1:
    Enter
    Escape
    Tab
    Backspace
    Delete
    Up
    Down
    Left
    Right
    Home
    End
    PageUp
    PageDown

pub enum MuxKeyV1:
    Named(key: MuxNamedKeyV1)
    Function(number: i64)
    Scalar(codepoint: u32, control: bool, alt: bool, shift: bool)

pub struct MuxPasteV1:
    bytes: [u8]
    bracketed: bool
    append_enter: bool

pub enum MuxMessageKindV1:
    Info
    Warning
    Error

pub enum MuxRecipientV1:
    Client(target: MuxObjectRefV1)
    Session(target: MuxObjectRefV1)
    Pane(target: MuxObjectRefV1)

pub struct MuxNotifyV1:
    recipient: MuxRecipientV1
    kind: MuxMessageKindV1
    literal_text: text
    ttl_ms: i64

pub struct MuxCreateSessionV1:
    name: text
    first_window_name: text
    launch: MuxLaunchV1
    background: bool

pub struct MuxCreateWindowV1:
    session: MuxObjectRefV1
    name: text
    launch: MuxLaunchV1

pub struct MuxSplitPaneV1:
    pane: MuxObjectRefV1
    direction: MuxSplitDirectionV1
    size: MuxSplitSizeV1
    launch: MuxLaunchV1

pub struct MuxAttachClientV1:
    session: MuxObjectRefV1
    client_identity: text
    viewport: MuxCellSizeV1

# Separate owner-issued stop authority. A connect lease is NOT permission to
# destroy its namespace. The provider authenticates this token and membership.
pub struct MuxNamespaceStopV1:
    owner_id: text
    owner_generation: u64
    stop_token: text

pub enum MuxOperationV1:
    Connect
    Snapshot
    ResolveTarget
    Capture
    CurrentContext
    RequestStatus
    Capabilities
    PollEvents
    Disconnect
    CreateSession
    RenameSession
    TerminateSession
    StopOwnedNamespace
    CreateWindow
    RenameWindow
    TerminateWindow
    FocusWindow
    LaunchPane
    SplitPane
    TerminatePane
    FocusPane
    ResizePane
    ResizeWindow
    SelectLayout
    ToggleZoom
    HidePane
    ShowPane
    Rebalance
    SetPaneTitle
    SetPaneBorder
    SetPaneBorderStatus
    AttachClient
    DetachClient
    SetClientViewport
    SendLiteral
    SendKeys
    Paste
    SubmitShellCommand
    Notify

# All commands below are mandatory CoreMux operations. Unsupported is a
# pre-mutation error and blocks mandatory-provider admission, not success.
pub enum MuxCommandV1:
    CreateSession(spec: MuxCreateSessionV1)
    RenameSession(target: MuxObjectRefV1, name: text)
    TerminateSession(target: MuxObjectRefV1)
    StopOwnedNamespace(authorization: MuxNamespaceStopV1)
    CreateWindow(spec: MuxCreateWindowV1)
    RenameWindow(target: MuxObjectRefV1, name: text)
    TerminateWindow(target: MuxObjectRefV1)
    FocusWindow(client: MuxObjectRefV1, window: MuxObjectRefV1)
    LaunchPane(window: MuxObjectRefV1, launch: MuxLaunchV1)
    SplitPane(spec: MuxSplitPaneV1)
    TerminatePane(target: MuxObjectRefV1)
    FocusPane(client: MuxObjectRefV1, pane: MuxObjectRefV1)
    ResizePane(pane: MuxObjectRefV1, size: MuxCellSizeV1)
    ResizeWindow(window: MuxObjectRefV1, size: MuxCellSizeV1)
    SelectLayout(window: MuxObjectRefV1, layout: MuxLayoutKindV1)
    # tmux resize-pane -Z semantics: an already zoomed window restores, even
    # when pane names a different member. Focus/preserve-zoom is a separate op.
    ToggleZoom(window: MuxObjectRefV1, pane: MuxObjectRefV1)
    HidePane(pane: MuxObjectRefV1)
    ShowPane(pane: MuxObjectRefV1)
    Rebalance(window: MuxObjectRefV1)
    SetPaneTitle(pane: MuxObjectRefV1, title: text)
    SetPaneBorder(pane: MuxObjectRefV1, border: MuxBorderV1)
    SetPaneBorderStatus(pane: MuxObjectRefV1, status: MuxBorderStatusV1)
    AttachClient(spec: MuxAttachClientV1)
    DetachClient(client: MuxObjectRefV1)
    SetClientViewport(client: MuxObjectRefV1, size: MuxCellSizeV1)
    SendLiteral(pane: MuxObjectRefV1, bytes: [u8])
    SendKeys(pane: MuxObjectRefV1, keys: [MuxKeyV1])
    Paste(pane: MuxObjectRefV1, paste: MuxPasteV1)
    SubmitShellCommand(pane: MuxObjectRefV1, command: text)
    Notify(message: MuxNotifyV1)

# request_id is nonzero and scoped to handle lease + owner incarnation. Equal
# IDs with different payloads are InvalidRequest; receipt eviction means Unknown,
# never proof of NotApplied. Unsupported revision guards fail before mutation.
pub struct MuxRequestV1:
    handle: MuxHandleV1
    request_id: u64
    deadline: MuxDeadlineV1
    expected_revision: u64?
    command: MuxCommandV1

pub struct MuxDisconnectRequestV1:
    handle: MuxHandleV1
    request_id: u64
    deadline: MuxDeadlineV1

pub fn mux_command_operation_v1(command: MuxCommandV1) -> MuxOperationV1:
    match command:
        case MuxCommandV1.CreateSession(_): MuxOperationV1.CreateSession
        case MuxCommandV1.RenameSession(_, _): MuxOperationV1.RenameSession
        case MuxCommandV1.TerminateSession(_): MuxOperationV1.TerminateSession
        case MuxCommandV1.StopOwnedNamespace(_): MuxOperationV1.StopOwnedNamespace
        case MuxCommandV1.CreateWindow(_): MuxOperationV1.CreateWindow
        case MuxCommandV1.RenameWindow(_, _): MuxOperationV1.RenameWindow
        case MuxCommandV1.TerminateWindow(_): MuxOperationV1.TerminateWindow
        case MuxCommandV1.FocusWindow(_, _): MuxOperationV1.FocusWindow
        case MuxCommandV1.LaunchPane(_, _): MuxOperationV1.LaunchPane
        case MuxCommandV1.SplitPane(_): MuxOperationV1.SplitPane
        case MuxCommandV1.TerminatePane(_): MuxOperationV1.TerminatePane
        case MuxCommandV1.FocusPane(_, _): MuxOperationV1.FocusPane
        case MuxCommandV1.ResizePane(_, _): MuxOperationV1.ResizePane
        case MuxCommandV1.ResizeWindow(_, _): MuxOperationV1.ResizeWindow
        case MuxCommandV1.SelectLayout(_, _): MuxOperationV1.SelectLayout
        case MuxCommandV1.ToggleZoom(_, _): MuxOperationV1.ToggleZoom
        case MuxCommandV1.HidePane(_): MuxOperationV1.HidePane
        case MuxCommandV1.ShowPane(_): MuxOperationV1.ShowPane
        case MuxCommandV1.Rebalance(_): MuxOperationV1.Rebalance
        case MuxCommandV1.SetPaneTitle(_, _): MuxOperationV1.SetPaneTitle
        case MuxCommandV1.SetPaneBorder(_, _): MuxOperationV1.SetPaneBorder
        case MuxCommandV1.SetPaneBorderStatus(_, _): MuxOperationV1.SetPaneBorderStatus
        case MuxCommandV1.AttachClient(_): MuxOperationV1.AttachClient
        case MuxCommandV1.DetachClient(_): MuxOperationV1.DetachClient
        case MuxCommandV1.SetClientViewport(_, _): MuxOperationV1.SetClientViewport
        case MuxCommandV1.SendLiteral(_, _): MuxOperationV1.SendLiteral
        case MuxCommandV1.SendKeys(_, _): MuxOperationV1.SendKeys
        case MuxCommandV1.Paste(_, _): MuxOperationV1.Paste
        case MuxCommandV1.SubmitShellCommand(_, _): MuxOperationV1.SubmitShellCommand
        case MuxCommandV1.Notify(_): MuxOperationV1.Notify

pub fn mux_mandatory_operations_v1() -> [MuxOperationV1]:
    [
        MuxOperationV1.Connect,
        MuxOperationV1.Snapshot,
        MuxOperationV1.ResolveTarget,
        MuxOperationV1.Capture,
        MuxOperationV1.CurrentContext,
        MuxOperationV1.RequestStatus,
        MuxOperationV1.Capabilities,
        MuxOperationV1.PollEvents,
        MuxOperationV1.Disconnect,
        MuxOperationV1.CreateSession,
        MuxOperationV1.RenameSession,
        MuxOperationV1.TerminateSession,
        MuxOperationV1.StopOwnedNamespace,
        MuxOperationV1.CreateWindow,
        MuxOperationV1.RenameWindow,
        MuxOperationV1.TerminateWindow,
        MuxOperationV1.FocusWindow,
        MuxOperationV1.LaunchPane,
        MuxOperationV1.SplitPane,
        MuxOperationV1.TerminatePane,
        MuxOperationV1.FocusPane,
        MuxOperationV1.ResizePane,
        MuxOperationV1.ResizeWindow,
        MuxOperationV1.SelectLayout,
        MuxOperationV1.ToggleZoom,
        MuxOperationV1.HidePane,
        MuxOperationV1.ShowPane,
        MuxOperationV1.Rebalance,
        MuxOperationV1.SetPaneTitle,
        MuxOperationV1.SetPaneBorder,
        MuxOperationV1.SetPaneBorderStatus,
        MuxOperationV1.AttachClient,
        MuxOperationV1.DetachClient,
        MuxOperationV1.SetClientViewport,
        MuxOperationV1.SendLiteral,
        MuxOperationV1.SendKeys,
        MuxOperationV1.Paste,
        MuxOperationV1.SubmitShellCommand,
        MuxOperationV1.Notify,
    ]
