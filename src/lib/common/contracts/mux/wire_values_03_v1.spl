        return Ok(MuxCommandV1.SetClientViewport(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_mux_cell_size_v1(fields[2])?))
    if tag == "SendLiteral":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.SendLiteral(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_bytes_v1(fields[2])?))
    if tag == "SendKeys":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.SendKeys(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_array_mux_key_v1(fields[2])?))
    if tag == "Paste":
