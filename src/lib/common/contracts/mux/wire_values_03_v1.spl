pub fn mux_wire_decode_mux_command_v1(value: SdnValue) -> Result<MuxCommandV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "CreateSession":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.CreateSession(mux_wire_decode_mux_create_session_v1(fields[1])?))
    if tag == "RenameSession":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.RenameSession(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_text_v1(fields[2])?))
    if tag == "TerminateSession":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.TerminateSession(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "StopOwnedNamespace":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.StopOwnedNamespace(mux_wire_decode_mux_namespace_stop_v1(fields[1])?))
    if tag == "CreateWindow":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.CreateWindow(mux_wire_decode_mux_create_window_v1(fields[1])?))
    if tag == "RenameWindow":
