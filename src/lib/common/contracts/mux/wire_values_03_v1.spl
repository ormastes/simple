        return Ok(MuxCommandV1.FocusPane(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_mux_object_ref_v1(fields[2])?))
    if tag == "ResizePane":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.ResizePane(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_mux_cell_size_v1(fields[2])?))
    if tag == "ResizeWindow":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.ResizeWindow(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_mux_cell_size_v1(fields[2])?))
    if tag == "SelectLayout":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.SelectLayout(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_mux_layout_kind_v1(fields[2])?))
    if tag == "ToggleZoom":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.ToggleZoom(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_mux_object_ref_v1(fields[2])?))
    if tag == "HidePane":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.HidePane(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "ShowPane":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.ShowPane(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "Rebalance":
