        case MuxWireCallV1.Query(item0, item1, item2): SdnValue.Array([SdnValue.String("Query"), mux_wire_encode_mux_handle_v1(item0), mux_wire_encode_mux_query_v1(item1), mux_wire_encode_mux_deadline_v1(item2)])
        case MuxWireCallV1.Execute(item0): SdnValue.Array([SdnValue.String("Execute"), mux_wire_encode_mux_request_v1(item0)])
        case MuxWireCallV1.PollEvents(item0, item1, item2, item3): SdnValue.Array([SdnValue.String("PollEvents"), mux_wire_encode_mux_handle_v1(item0), mux_wire_encode_u64_v1(item1), mux_wire_encode_mux_event_limits_v1(item2), mux_wire_encode_mux_deadline_v1(item3)])
        case MuxWireCallV1.Disconnect(item0): SdnValue.Array([SdnValue.String("Disconnect"), mux_wire_encode_mux_disconnect_request_v1(item0)])

pub fn mux_wire_decode_mux_wire_call_v1(value: SdnValue) -> Result<MuxWireCallV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Connect":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxWireCallV1.Connect(mux_wire_decode_mux_connect_v1(fields[1])?, mux_wire_decode_mux_deadline_v1(fields[2])?))
    if tag == "Query":
        if fields.len() != 4: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxWireCallV1.Query(mux_wire_decode_mux_handle_v1(fields[1])?, mux_wire_decode_mux_query_v1(fields[2])?, mux_wire_decode_mux_deadline_v1(fields[3])?))
    if tag == "Execute":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxWireCallV1.Execute(mux_wire_decode_mux_request_v1(fields[1])?))
    if tag == "PollEvents":
        if fields.len() != 5: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxWireCallV1.PollEvents(mux_wire_decode_mux_handle_v1(fields[1])?, mux_wire_decode_u64_v1(fields[2])?, mux_wire_decode_mux_event_limits_v1(fields[3])?, mux_wire_decode_mux_deadline_v1(fields[4])?))
    if tag == "Disconnect":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxWireCallV1.Disconnect(mux_wire_decode_mux_disconnect_request_v1(fields[1])?))
    Err(mux_wire_error_v1("unknown_variant"))

