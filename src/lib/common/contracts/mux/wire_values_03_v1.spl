        return Ok(MuxCommandV1.RenameWindow(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_text_v1(fields[2])?))
    if tag == "TerminateWindow":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.TerminateWindow(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "FocusWindow":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.FocusWindow(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_mux_object_ref_v1(fields[2])?))
    if tag == "LaunchPane":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.LaunchPane(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_mux_launch_v1(fields[2])?))
    if tag == "SplitPane":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.SplitPane(mux_wire_decode_mux_split_pane_v1(fields[1])?))
    if tag == "TerminatePane":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
