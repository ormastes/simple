pub fn mux_wire_decode_mux_child_state_v1(value: SdnValue) -> Result<MuxChildStateV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Running":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxChildStateV1.Running(mux_wire_decode_i64_v1(fields[1])?))
    if tag == "Exited":
        if fields.len() != 4: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxChildStateV1.Exited(mux_wire_decode_i64_v1(fields[1])?, mux_wire_decode_optional_i64_v1(fields[2])?, mux_wire_decode_optional_text_v1(fields[3])?))
    if tag == "Unknown":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxChildStateV1.Unknown(mux_wire_decode_optional_i64_v1(fields[1])?, mux_wire_decode_text_v1(fields[2])?))
    Err(mux_wire_error_v1("unknown_variant"))
