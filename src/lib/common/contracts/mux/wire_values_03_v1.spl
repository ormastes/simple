        case MuxCommandV1.FocusWindow(item0, item1): SdnValue.Array([SdnValue.String("FocusWindow"), mux_wire_encode_mux_object_ref_v1(item0), mux_wire_encode_mux_object_ref_v1(item1)])
        case MuxCommandV1.LaunchPane(item0, item1): SdnValue.Array([SdnValue.String("LaunchPane"), mux_wire_encode_mux_object_ref_v1(item0), mux_wire_encode_mux_launch_v1(item1)])
        case MuxCommandV1.SplitPane(item0): SdnValue.Array([SdnValue.String("SplitPane"), mux_wire_encode_mux_split_pane_v1(item0)])
        case MuxCommandV1.TerminatePane(item0): SdnValue.Array([SdnValue.String("TerminatePane"), mux_wire_encode_mux_object_ref_v1(item0)])
        case MuxCommandV1.FocusPane(item0, item1): SdnValue.Array([SdnValue.String("FocusPane"), mux_wire_encode_mux_object_ref_v1(item0), mux_wire_encode_mux_object_ref_v1(item1)])
