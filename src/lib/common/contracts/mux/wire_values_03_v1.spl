    if tag == "SubmitShellCommand":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.SubmitShellCommand(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_text_v1(fields[2])?))
    if tag == "Notify":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommandV1.Notify(mux_wire_decode_mux_notify_v1(fields[1])?))
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_request_v1(value: MuxRequestV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 38
    size = mux_wire_sum_v1(size, mux_wire_size_mux_handle_v1(value.handle)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.request_id)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_deadline_v1(value.deadline)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_optional_u64_v1(value.expected_revision)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_command_v1(value.command)?)?
    Ok(size)

pub fn mux_wire_encode_mux_request_v1(value: MuxRequestV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxRequestV1"),
        mux_wire_encode_mux_handle_v1(value.handle),
        mux_wire_encode_u64_v1(value.request_id),
        mux_wire_encode_mux_deadline_v1(value.deadline),
        mux_wire_encode_optional_u64_v1(value.expected_revision),
        mux_wire_encode_mux_command_v1(value.command)])

pub fn mux_wire_decode_mux_request_v1(value: SdnValue) -> Result<MuxRequestV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 6)?
    mux_wire_tag_v1(fields, "MuxRequestV1")?
    Ok(MuxRequestV1(
        handle: mux_wire_decode_mux_handle_v1(fields[1])?,
