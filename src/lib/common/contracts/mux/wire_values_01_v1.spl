        mux_wire_encode_u64_v1(value.owner_generation),
        mux_wire_encode_mux_object_kind_v1(value.kind),
        mux_wire_encode_text_v1(value.object_id)])

pub fn mux_wire_decode_mux_object_ref_v1(value: SdnValue) -> Result<MuxObjectRefV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 5)?
