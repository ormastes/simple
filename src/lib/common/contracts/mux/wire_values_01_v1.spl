    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.styled)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.max_bytes)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_optional_text_v1(value.continuation)?)?
    Ok(size)

pub fn mux_wire_encode_mux_capture_v1(value: MuxCaptureV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxCaptureV1"),
        mux_wire_encode_mux_object_ref_v1(value.pane),
        mux_wire_encode_mux_capture_range_v1(value.range),
        mux_wire_encode_bool_v1(value.join_wrapped),
        mux_wire_encode_bool_v1(value.styled),
        mux_wire_encode_i64_v1(value.max_bytes),
        mux_wire_encode_optional_text_v1(value.continuation)])

pub fn mux_wire_decode_mux_capture_v1(value: SdnValue) -> Result<MuxCaptureV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 7)?
    mux_wire_tag_v1(fields, "MuxCaptureV1")?
    Ok(MuxCaptureV1(
        pane: mux_wire_decode_mux_object_ref_v1(fields[1])?,
        range: mux_wire_decode_mux_capture_range_v1(fields[2])?,
        join_wrapped: mux_wire_decode_bool_v1(fields[3])?,
        styled: mux_wire_decode_bool_v1(fields[4])?,
        max_bytes: mux_wire_decode_i64_v1(fields[5])?,
        continuation: mux_wire_decode_optional_text_v1(fields[6])?))

pub fn mux_wire_size_mux_query_v1(value: MuxQueryV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxQueryV1.Snapshot(item0, item1):
            var size: i64 = 24
            size = mux_wire_sum_v1(size, mux_wire_size_mux_scope_v1(item0)?)?
            size = mux_wire_sum_v1(size, mux_wire_size_mux_visibility_v1(item1)?)?
            Ok(size)
        case MuxQueryV1.ResolveTarget(item0, item1, item2):
            var size: i64 = 36
            size = mux_wire_sum_v1(size, mux_wire_size_text_v1(item0)?)?
            size = mux_wire_sum_v1(size, mux_wire_size_mux_object_kind_v1(item1)?)?
            size = mux_wire_sum_v1(size, mux_wire_size_mux_context_v1(item2)?)?
            Ok(size)
        case MuxQueryV1.Capture(item0):
            var size: i64 = 20
            size = mux_wire_sum_v1(size, mux_wire_size_mux_capture_v1(item0)?)?
            Ok(size)
        case MuxQueryV1.CurrentContext(item0):
            var size: i64 = 34
            size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(item0)?)?
            Ok(size)
        case MuxQueryV1.RequestStatus(item0):
            var size: i64 = 32
            size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(item0)?)?
            Ok(size)
        case MuxQueryV1.Capabilities:
            var size: i64 = 28
            Ok(size)

