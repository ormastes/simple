pub fn mux_wire_size_mux_capture_v1(value: MuxCaptureV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 40
    size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(value.pane)?)?
