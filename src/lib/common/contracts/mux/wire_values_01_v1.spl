    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.owner_id)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.owner_generation)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.lease_id)?)?
