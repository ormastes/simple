    if tag == "ResolveTarget":
        if fields.len() != 4: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxQueryV1.ResolveTarget(mux_wire_decode_text_v1(fields[1])?, mux_wire_decode_mux_object_kind_v1(fields[2])?, mux_wire_decode_mux_context_v1(fields[3])?))
