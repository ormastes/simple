            Ok(size)
        case MuxObjectKindV1.Pane:
            var size: i64 = 12
            Ok(size)
        case MuxObjectKindV1.Client:
            var size: i64 = 16
            Ok(size)

pub fn mux_wire_encode_mux_object_kind_v1(value: MuxObjectKindV1) -> SdnValue:
    match value:
        case MuxObjectKindV1.Session: SdnValue.Array([SdnValue.String("Session")])
        case MuxObjectKindV1.Window: SdnValue.Array([SdnValue.String("Window")])
        case MuxObjectKindV1.Pane: SdnValue.Array([SdnValue.String("Pane")])
        case MuxObjectKindV1.Client: SdnValue.Array([SdnValue.String("Client")])

pub fn mux_wire_decode_mux_object_kind_v1(value: SdnValue) -> Result<MuxObjectKindV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Session":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxObjectKindV1.Session)
    if tag == "Window":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxObjectKindV1.Window)
    if tag == "Pane":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxObjectKindV1.Pane)
    if tag == "Client":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxObjectKindV1.Client)
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_object_ref_v1(value: MuxObjectRefV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 40
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.owner_id)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.owner_generation)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_object_kind_v1(value.kind)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.object_id)?)?
    Ok(size)

pub fn mux_wire_encode_mux_object_ref_v1(value: MuxObjectRefV1) -> SdnValue:
