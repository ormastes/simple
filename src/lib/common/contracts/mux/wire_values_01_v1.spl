        owner_generation: mux_wire_decode_u64_v1(fields[2])?,
        kind: mux_wire_decode_mux_object_kind_v1(fields[3])?,
        object_id: mux_wire_decode_text_v1(fields[4])?))

pub fn mux_wire_size_mux_scope_v1(value: MuxScopeV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxScopeV1.Namespace:
            var size: i64 = 22
            Ok(size)
        case MuxScopeV1.Session(item0):
            var size: i64 = 20
            size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(item0)?)?
            Ok(size)
        case MuxScopeV1.Window(item0):
            var size: i64 = 18
            size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(item0)?)?
            Ok(size)

pub fn mux_wire_encode_mux_scope_v1(value: MuxScopeV1) -> SdnValue:
    match value:
        case MuxScopeV1.Namespace: SdnValue.Array([SdnValue.String("Namespace")])
        case MuxScopeV1.Session(item0): SdnValue.Array([SdnValue.String("Session"), mux_wire_encode_mux_object_ref_v1(item0)])
        case MuxScopeV1.Window(item0): SdnValue.Array([SdnValue.String("Window"), mux_wire_encode_mux_object_ref_v1(item0)])

pub fn mux_wire_decode_mux_scope_v1(value: SdnValue) -> Result<MuxScopeV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Namespace":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxScopeV1.Namespace)
    if tag == "Session":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxScopeV1.Session(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "Window":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxScopeV1.Window(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    Err(mux_wire_error_v1("unknown_variant"))

