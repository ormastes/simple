# Fixed-arity typed SDN schema. Internal constructors require whole-envelope
# size preflight; use wire_envelope_v1 for public bounded byte conversion.
use std.common.sdn.value.{SdnValue}
use std.common.debug.capability.{CapLevel}
use std.common.contracts.mux.core_v1.*
use std.common.contracts.mux.execution_v1.*
use std.common.contracts.mux.observation_v1.*
use std.common.contracts.mux.wire_types_v1.*
use std.common.contracts.mux.wire_primitives_v1.*

pub fn mux_wire_size_mux_backend_v1(value: MuxBackendV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxBackendV1.Smux:
            var size: i64 = 12
            Ok(size)
        case MuxBackendV1.Tmux:
            var size: i64 = 12
            Ok(size)

pub fn mux_wire_encode_mux_backend_v1(value: MuxBackendV1) -> SdnValue:
    match value:
        case MuxBackendV1.Smux: SdnValue.Array([SdnValue.String("Smux")])
        case MuxBackendV1.Tmux: SdnValue.Array([SdnValue.String("Tmux")])

pub fn mux_wire_decode_mux_backend_v1(value: SdnValue) -> Result<MuxBackendV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Smux":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxBackendV1.Smux)
    if tag == "Tmux":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxBackendV1.Tmux)
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_endpoint_policy_v1(value: MuxEndpointPolicyV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxEndpointPolicyV1.ExistingOnly:
            var size: i64 = 28
            Ok(size)
        case MuxEndpointPolicyV1.CreateOwned:
            var size: i64 = 26
            Ok(size)

pub fn mux_wire_encode_mux_endpoint_policy_v1(value: MuxEndpointPolicyV1) -> SdnValue:
    match value:
        case MuxEndpointPolicyV1.ExistingOnly: SdnValue.Array([SdnValue.String("ExistingOnly")])
        case MuxEndpointPolicyV1.CreateOwned: SdnValue.Array([SdnValue.String("CreateOwned")])

pub fn mux_wire_decode_mux_endpoint_policy_v1(value: SdnValue) -> Result<MuxEndpointPolicyV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "ExistingOnly":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEndpointPolicyV1.ExistingOnly)
    if tag == "CreateOwned":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEndpointPolicyV1.CreateOwned)
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_limits_v1(value: MuxLimitsV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 30
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.max_sessions)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.max_reply_bytes)?)?
    Ok(size)

pub fn mux_wire_encode_mux_limits_v1(value: MuxLimitsV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxLimitsV1"),
        mux_wire_encode_i64_v1(value.max_sessions),
        mux_wire_encode_i64_v1(value.max_reply_bytes)])

pub fn mux_wire_decode_mux_limits_v1(value: SdnValue) -> Result<MuxLimitsV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 3)?
    mux_wire_tag_v1(fields, "MuxLimitsV1")?
    Ok(MuxLimitsV1(
        max_sessions: mux_wire_decode_i64_v1(fields[1])?,
        max_reply_bytes: mux_wire_decode_i64_v1(fields[2])?))

pub fn mux_wire_size_mux_connect_v1(value: MuxConnectV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 38
    size = mux_wire_sum_v1(size, mux_wire_size_mux_backend_v1(value.backend)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.namespace)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_endpoint_policy_v1(value.endpoint_policy)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.client_identity)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_limits_v1(value.limits)?)?
    Ok(size)

pub fn mux_wire_encode_mux_connect_v1(value: MuxConnectV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxConnectV1"),
        mux_wire_encode_mux_backend_v1(value.backend),
        mux_wire_encode_text_v1(value.namespace),
        mux_wire_encode_mux_endpoint_policy_v1(value.endpoint_policy),
        mux_wire_encode_text_v1(value.client_identity),
        mux_wire_encode_mux_limits_v1(value.limits)])

pub fn mux_wire_decode_mux_connect_v1(value: SdnValue) -> Result<MuxConnectV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 6)?
    mux_wire_tag_v1(fields, "MuxConnectV1")?
    Ok(MuxConnectV1(
        backend: mux_wire_decode_mux_backend_v1(fields[1])?,
        namespace: mux_wire_decode_text_v1(fields[2])?,
        endpoint_policy: mux_wire_decode_mux_endpoint_policy_v1(fields[3])?,
        client_identity: mux_wire_decode_text_v1(fields[4])?,
        limits: mux_wire_decode_mux_limits_v1(fields[5])?))

