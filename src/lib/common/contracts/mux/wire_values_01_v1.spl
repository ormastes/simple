        return Ok(MuxQueryV1.CurrentContext(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "RequestStatus":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxQueryV1.RequestStatus(mux_wire_decode_u64_v1(fields[1])?))
    if tag == "Capabilities":
