        case MuxQueryV1.ResolveTarget(item0, item1, item2): SdnValue.Array([SdnValue.String("ResolveTarget"), mux_wire_encode_text_v1(item0), mux_wire_encode_mux_object_kind_v1(item1), mux_wire_encode_mux_context_v1(item2)])
