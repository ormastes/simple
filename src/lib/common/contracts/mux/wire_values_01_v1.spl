        include_exited: mux_wire_decode_bool_v1(fields[2])?))

pub fn mux_wire_size_optional_mux_object_ref_v1(value: MuxObjectRefV1?) -> Result<i64, MuxWireErrorV1>:
    match value:
        case nil: Ok(4)
        case Some(item): mux_wire_sum_v1(10, mux_wire_size_mux_object_ref_v1(item)?)

pub fn mux_wire_encode_optional_mux_object_ref_v1(value: MuxObjectRefV1?) -> SdnValue:
    match value:
        case nil: SdnValue.Null
        case Some(item): SdnValue.Array([SdnValue.String("some"), mux_wire_encode_mux_object_ref_v1(item)])

pub fn mux_wire_decode_optional_mux_object_ref_v1(value: SdnValue) -> Result<MuxObjectRefV1?, MuxWireErrorV1>:
    match value:
        case SdnValue.Null: Ok(nil)
        case _:
            val fields = mux_wire_array_v1(value, 2)?
            mux_wire_tag_v1(fields, "some")?
            Ok(Some(mux_wire_decode_mux_object_ref_v1(fields[1])?))

pub fn mux_wire_size_mux_context_v1(value: MuxContextV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 36
    size = mux_wire_sum_v1(size, mux_wire_size_optional_mux_object_ref_v1(value.client)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_optional_mux_object_ref_v1(value.session)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_optional_mux_object_ref_v1(value.window)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_optional_mux_object_ref_v1(value.pane)?)?
    Ok(size)

pub fn mux_wire_encode_mux_context_v1(value: MuxContextV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxContextV1"),
        mux_wire_encode_optional_mux_object_ref_v1(value.client),
        mux_wire_encode_optional_mux_object_ref_v1(value.session),
        mux_wire_encode_optional_mux_object_ref_v1(value.window),
        mux_wire_encode_optional_mux_object_ref_v1(value.pane)])

pub fn mux_wire_decode_mux_context_v1(value: SdnValue) -> Result<MuxContextV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 5)?
    mux_wire_tag_v1(fields, "MuxContextV1")?
    Ok(MuxContextV1(
        client: mux_wire_decode_optional_mux_object_ref_v1(fields[1])?,
        session: mux_wire_decode_optional_mux_object_ref_v1(fields[2])?,
        window: mux_wire_decode_optional_mux_object_ref_v1(fields[3])?,
        pane: mux_wire_decode_optional_mux_object_ref_v1(fields[4])?))

pub fn mux_wire_size_mux_capture_range_v1(value: MuxCaptureRangeV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxCaptureRangeV1.Screen:
            var size: i64 = 16
            Ok(size)
        case MuxCaptureRangeV1.AllHistory:
            var size: i64 = 24
            Ok(size)
        case MuxCaptureRangeV1.Lines(item0, item1):
            var size: i64 = 18
            size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(item0)?)?
            size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(item1)?)?
            Ok(size)

pub fn mux_wire_encode_mux_capture_range_v1(value: MuxCaptureRangeV1) -> SdnValue:
    match value:
        case MuxCaptureRangeV1.Screen: SdnValue.Array([SdnValue.String("Screen")])
        case MuxCaptureRangeV1.AllHistory: SdnValue.Array([SdnValue.String("AllHistory")])
        case MuxCaptureRangeV1.Lines(item0, item1): SdnValue.Array([SdnValue.String("Lines"), mux_wire_encode_i64_v1(item0), mux_wire_encode_i64_v1(item1)])

pub fn mux_wire_decode_mux_capture_range_v1(value: SdnValue) -> Result<MuxCaptureRangeV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Screen":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCaptureRangeV1.Screen)
    if tag == "AllHistory":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCaptureRangeV1.AllHistory)
    if tag == "Lines":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCaptureRangeV1.Lines(mux_wire_decode_i64_v1(fields[1])?, mux_wire_decode_i64_v1(fields[2])?))
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_optional_text_v1(value: text?) -> Result<i64, MuxWireErrorV1>:
    match value:
        case nil: Ok(4)
