# Fixed-arity typed SDN schema. Internal constructors require whole-envelope
# size preflight; use wire_envelope_v1 for public bounded byte conversion.
use std.common.sdn.value.{SdnValue}
use std.common.debug.capability.{CapLevel}
use std.common.contracts.mux.core_v1.*
use std.common.contracts.mux.execution_v1.*
use std.common.contracts.mux.observation_v1.*
use std.common.contracts.mux.wire_types_v1.*
use std.common.contracts.mux.wire_primitives_v1.*
use std.common.contracts.mux.wire_values_01_v1.*
use std.common.contracts.mux.wire_values_03_v1.*
use std.common.contracts.mux.wire_values_04_v1.*

pub fn mux_wire_size_mux_ingestion_v1(value: MuxIngestionV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxIngestionV1.NotPolled:
            var size: i64 = 22
            Ok(size)
        case MuxIngestionV1.NoNewOutput:
            var size: i64 = 26
            Ok(size)
        case MuxIngestionV1.Ingested:
            var size: i64 = 20
            Ok(size)

pub fn mux_wire_encode_mux_ingestion_v1(value: MuxIngestionV1) -> SdnValue:
    match value:
        case MuxIngestionV1.NotPolled: SdnValue.Array([SdnValue.String("NotPolled")])
        case MuxIngestionV1.NoNewOutput: SdnValue.Array([SdnValue.String("NoNewOutput")])
        case MuxIngestionV1.Ingested: SdnValue.Array([SdnValue.String("Ingested")])

pub fn mux_wire_decode_mux_ingestion_v1(value: SdnValue) -> Result<MuxIngestionV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "NotPolled":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxIngestionV1.NotPolled)
    if tag == "NoNewOutput":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxIngestionV1.NoNewOutput)
    if tag == "Ingested":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxIngestionV1.Ingested)
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_captured_v1(value: MuxCapturedV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 46
    size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(value.pane)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.observed_revision)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.content_revision)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_ingestion_v1(value.ingestion)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_bytes_v1(value.bytes)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.byte_extent)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.truncated)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_optional_text_v1(value.continuation)?)?
    Ok(size)

pub fn mux_wire_encode_mux_captured_v1(value: MuxCapturedV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxCapturedV1"),
        mux_wire_encode_mux_object_ref_v1(value.pane),
        mux_wire_encode_u64_v1(value.observed_revision),
        mux_wire_encode_u64_v1(value.content_revision),
        mux_wire_encode_mux_ingestion_v1(value.ingestion),
        mux_wire_encode_bytes_v1(value.bytes),
        mux_wire_encode_i64_v1(value.byte_extent),
        mux_wire_encode_bool_v1(value.truncated),
        mux_wire_encode_optional_text_v1(value.continuation)])

pub fn mux_wire_decode_mux_captured_v1(value: SdnValue) -> Result<MuxCapturedV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 9)?
    mux_wire_tag_v1(fields, "MuxCapturedV1")?
    Ok(MuxCapturedV1(
        pane: mux_wire_decode_mux_object_ref_v1(fields[1])?,
        observed_revision: mux_wire_decode_u64_v1(fields[2])?,
        content_revision: mux_wire_decode_u64_v1(fields[3])?,
        ingestion: mux_wire_decode_mux_ingestion_v1(fields[4])?,
        bytes: mux_wire_decode_bytes_v1(fields[5])?,
        byte_extent: mux_wire_decode_i64_v1(fields[6])?,
        truncated: mux_wire_decode_bool_v1(fields[7])?,
        continuation: mux_wire_decode_optional_text_v1(fields[8])?))

pub fn mux_wire_size_optional_mux_operation_v1(value: MuxOperationV1?) -> Result<i64, MuxWireErrorV1>:
    match value:
        case nil: Ok(4)
        case Some(item): mux_wire_sum_v1(10, mux_wire_size_mux_operation_v1(item)?)

pub fn mux_wire_encode_optional_mux_operation_v1(value: MuxOperationV1?) -> SdnValue:
    match value:
        case nil: SdnValue.Null
        case Some(item): SdnValue.Array([SdnValue.String("some"), mux_wire_encode_mux_operation_v1(item)])

pub fn mux_wire_decode_optional_mux_operation_v1(value: SdnValue) -> Result<MuxOperationV1?, MuxWireErrorV1>:
    match value:
        case SdnValue.Null: Ok(nil)
        case _:
            val fields = mux_wire_array_v1(value, 2)?
            mux_wire_tag_v1(fields, "some")?
            Ok(Some(mux_wire_decode_mux_operation_v1(fields[1])?))

pub fn mux_wire_size_mux_request_knowledge_v1(value: MuxRequestKnowledgeV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxRequestKnowledgeV1.Pending:
            var size: i64 = 18
            Ok(size)
        case MuxRequestKnowledgeV1.Retained:
            var size: i64 = 20
            Ok(size)
        case MuxRequestKnowledgeV1.Expired:
            var size: i64 = 18
            Ok(size)
        case MuxRequestKnowledgeV1.NotKnown:
            var size: i64 = 20
            Ok(size)

pub fn mux_wire_encode_mux_request_knowledge_v1(value: MuxRequestKnowledgeV1) -> SdnValue:
    match value:
        case MuxRequestKnowledgeV1.Pending: SdnValue.Array([SdnValue.String("Pending")])
        case MuxRequestKnowledgeV1.Retained: SdnValue.Array([SdnValue.String("Retained")])
        case MuxRequestKnowledgeV1.Expired: SdnValue.Array([SdnValue.String("Expired")])
        case MuxRequestKnowledgeV1.NotKnown: SdnValue.Array([SdnValue.String("NotKnown")])

pub fn mux_wire_decode_mux_request_knowledge_v1(value: SdnValue) -> Result<MuxRequestKnowledgeV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Pending":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxRequestKnowledgeV1.Pending)
    if tag == "Retained":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxRequestKnowledgeV1.Retained)
    if tag == "Expired":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxRequestKnowledgeV1.Expired)
    if tag == "NotKnown":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxRequestKnowledgeV1.NotKnown)
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_commit_state_v1(value: MuxCommitStateV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxCommitStateV1.NotApplied:
            var size: i64 = 24
            Ok(size)
        case MuxCommitStateV1.Applied:
            var size: i64 = 18
            Ok(size)
        case MuxCommitStateV1.Partial:
            var size: i64 = 18
            Ok(size)
        case MuxCommitStateV1.Unknown:
            var size: i64 = 18
            Ok(size)

pub fn mux_wire_encode_mux_commit_state_v1(value: MuxCommitStateV1) -> SdnValue:
    match value:
        case MuxCommitStateV1.NotApplied: SdnValue.Array([SdnValue.String("NotApplied")])
        case MuxCommitStateV1.Applied: SdnValue.Array([SdnValue.String("Applied")])
        case MuxCommitStateV1.Partial: SdnValue.Array([SdnValue.String("Partial")])
        case MuxCommitStateV1.Unknown: SdnValue.Array([SdnValue.String("Unknown")])

pub fn mux_wire_decode_mux_commit_state_v1(value: SdnValue) -> Result<MuxCommitStateV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "NotApplied":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommitStateV1.NotApplied)
    if tag == "Applied":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommitStateV1.Applied)
    if tag == "Partial":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommitStateV1.Partial)
    if tag == "Unknown":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxCommitStateV1.Unknown)
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_array_mux_object_ref_v1(value: [MuxObjectRefV1]) -> Result<i64, MuxWireErrorV1>:
    if value.len() > 16384: return Err(mux_wire_error_v1("array_limit"))
    var size: i64 = 2
    for item in value:
        size = mux_wire_sum_v1(size, 2)?
        size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(item)?)?
    Ok(size)

pub fn mux_wire_encode_array_mux_object_ref_v1(value: [MuxObjectRefV1]) -> SdnValue:
    var items: [SdnValue] = []
    for item in value: items.push(mux_wire_encode_mux_object_ref_v1(item))
    SdnValue.Array(items)

pub fn mux_wire_decode_array_mux_object_ref_v1(value: SdnValue) -> Result<[MuxObjectRefV1], MuxWireErrorV1>:
    val items = mux_wire_array_v1(value, -1)?
    var decoded: [MuxObjectRefV1] = []
    for item in items: decoded.push(mux_wire_decode_mux_object_ref_v1(item)?)
    Ok(decoded)

pub fn mux_wire_size_mux_error_kind_v1(value: MuxErrorKindV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxErrorKindV1.Unsupported:
            var size: i64 = 26
            Ok(size)
        case MuxErrorKindV1.InvalidRequest:
            var size: i64 = 32
            Ok(size)
        case MuxErrorKindV1.InvalidTarget:
            var size: i64 = 30
            Ok(size)
        case MuxErrorKindV1.PermissionDenied:
            var size: i64 = 36
            Ok(size)
        case MuxErrorKindV1.Unavailable:
            var size: i64 = 26
            Ok(size)
        case MuxErrorKindV1.StaleRevision:
            var size: i64 = 30
            Ok(size)
        case MuxErrorKindV1.Busy:
            var size: i64 = 12
            Ok(size)
        case MuxErrorKindV1.Timeout:
            var size: i64 = 18
            Ok(size)
        case MuxErrorKindV1.PartialFailure:
            var size: i64 = 32
            Ok(size)

pub fn mux_wire_encode_mux_error_kind_v1(value: MuxErrorKindV1) -> SdnValue:
    match value:
        case MuxErrorKindV1.Unsupported: SdnValue.Array([SdnValue.String("Unsupported")])
        case MuxErrorKindV1.InvalidRequest: SdnValue.Array([SdnValue.String("InvalidRequest")])
        case MuxErrorKindV1.InvalidTarget: SdnValue.Array([SdnValue.String("InvalidTarget")])
        case MuxErrorKindV1.PermissionDenied: SdnValue.Array([SdnValue.String("PermissionDenied")])
        case MuxErrorKindV1.Unavailable: SdnValue.Array([SdnValue.String("Unavailable")])
        case MuxErrorKindV1.StaleRevision: SdnValue.Array([SdnValue.String("StaleRevision")])
        case MuxErrorKindV1.Busy: SdnValue.Array([SdnValue.String("Busy")])
        case MuxErrorKindV1.Timeout: SdnValue.Array([SdnValue.String("Timeout")])
        case MuxErrorKindV1.PartialFailure: SdnValue.Array([SdnValue.String("PartialFailure")])

pub fn mux_wire_decode_mux_error_kind_v1(value: SdnValue) -> Result<MuxErrorKindV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Unsupported":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxErrorKindV1.Unsupported)
    if tag == "InvalidRequest":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxErrorKindV1.InvalidRequest)
    if tag == "InvalidTarget":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxErrorKindV1.InvalidTarget)
    if tag == "PermissionDenied":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxErrorKindV1.PermissionDenied)
    if tag == "Unavailable":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxErrorKindV1.Unavailable)
    if tag == "StaleRevision":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxErrorKindV1.StaleRevision)
    if tag == "Busy":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxErrorKindV1.Busy)
    if tag == "Timeout":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxErrorKindV1.Timeout)
    if tag == "PartialFailure":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxErrorKindV1.PartialFailure)
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_optional_mux_error_kind_v1(value: MuxErrorKindV1?) -> Result<i64, MuxWireErrorV1>:
    match value:
        case nil: Ok(4)
        case Some(item): mux_wire_sum_v1(10, mux_wire_size_mux_error_kind_v1(item)?)

pub fn mux_wire_encode_optional_mux_error_kind_v1(value: MuxErrorKindV1?) -> SdnValue:
    match value:
        case nil: SdnValue.Null
        case Some(item): SdnValue.Array([SdnValue.String("some"), mux_wire_encode_mux_error_kind_v1(item)])

pub fn mux_wire_decode_optional_mux_error_kind_v1(value: SdnValue) -> Result<MuxErrorKindV1?, MuxWireErrorV1>:
    match value:
        case SdnValue.Null: Ok(nil)
        case _:
            val fields = mux_wire_array_v1(value, 2)?
            mux_wire_tag_v1(fields, "some")?
            Ok(Some(mux_wire_decode_mux_error_kind_v1(fields[1])?))

pub fn mux_wire_size_mux_request_receipt_v1(value: MuxRequestReceiptV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 64
    size = mux_wire_sum_v1(size, mux_wire_size_mux_handle_v1(value.handle)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.request_id)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_optional_mux_operation_v1(value.operation)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_request_knowledge_v1(value.knowledge)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_commit_state_v1(value.commit_state)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_optional_u64_v1(value.prior_revision)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_optional_u64_v1(value.observed_revision)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_array_mux_object_ref_v1(value.affected)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_optional_mux_error_kind_v1(value.error_kind)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.detail)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.cleanup_pending)?)?
    Ok(size)

pub fn mux_wire_encode_mux_request_receipt_v1(value: MuxRequestReceiptV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxRequestReceiptV1"),
        mux_wire_encode_mux_handle_v1(value.handle),
        mux_wire_encode_u64_v1(value.request_id),
        mux_wire_encode_optional_mux_operation_v1(value.operation),
        mux_wire_encode_mux_request_knowledge_v1(value.knowledge),
        mux_wire_encode_mux_commit_state_v1(value.commit_state),
        mux_wire_encode_optional_u64_v1(value.prior_revision),
        mux_wire_encode_optional_u64_v1(value.observed_revision),
        mux_wire_encode_array_mux_object_ref_v1(value.affected),
        mux_wire_encode_optional_mux_error_kind_v1(value.error_kind),
        mux_wire_encode_text_v1(value.detail),
        mux_wire_encode_bool_v1(value.cleanup_pending)])

pub fn mux_wire_decode_mux_request_receipt_v1(value: SdnValue) -> Result<MuxRequestReceiptV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 12)?
    mux_wire_tag_v1(fields, "MuxRequestReceiptV1")?
    Ok(MuxRequestReceiptV1(
        handle: mux_wire_decode_mux_handle_v1(fields[1])?,
        request_id: mux_wire_decode_u64_v1(fields[2])?,
        operation: mux_wire_decode_optional_mux_operation_v1(fields[3])?,
        knowledge: mux_wire_decode_mux_request_knowledge_v1(fields[4])?,
        commit_state: mux_wire_decode_mux_commit_state_v1(fields[5])?,
        prior_revision: mux_wire_decode_optional_u64_v1(fields[6])?,
        observed_revision: mux_wire_decode_optional_u64_v1(fields[7])?,
        affected: mux_wire_decode_array_mux_object_ref_v1(fields[8])?,
        error_kind: mux_wire_decode_optional_mux_error_kind_v1(fields[9])?,
        detail: mux_wire_decode_text_v1(fields[10])?,
        cleanup_pending: mux_wire_decode_bool_v1(fields[11])?))

pub fn mux_wire_size_mux_query_result_v1(value: MuxQueryResultV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxQueryResultV1.Snapshot(item0):
            var size: i64 = 22
            size = mux_wire_sum_v1(size, mux_wire_size_mux_snapshot_v1(item0)?)?
            Ok(size)
        case MuxQueryResultV1.ResolvedTarget(item0):
            var size: i64 = 34
            size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(item0)?)?
            Ok(size)
        case MuxQueryResultV1.Captured(item0):
            var size: i64 = 22
            size = mux_wire_sum_v1(size, mux_wire_size_mux_captured_v1(item0)?)?
            Ok(size)
        case MuxQueryResultV1.Context(item0):
            var size: i64 = 20
            size = mux_wire_sum_v1(size, mux_wire_size_mux_context_v1(item0)?)?
            Ok(size)
        case MuxQueryResultV1.RequestReceipt(item0):
            var size: i64 = 34
            size = mux_wire_sum_v1(size, mux_wire_size_mux_request_receipt_v1(item0)?)?
            Ok(size)
        case MuxQueryResultV1.Capabilities(item0):
            var size: i64 = 30
            size = mux_wire_sum_v1(size, mux_wire_size_array_mux_operation_capability_v1(item0)?)?
            Ok(size)

pub fn mux_wire_encode_mux_query_result_v1(value: MuxQueryResultV1) -> SdnValue:
    match value:
        case MuxQueryResultV1.Snapshot(item0): SdnValue.Array([SdnValue.String("Snapshot"), mux_wire_encode_mux_snapshot_v1(item0)])
        case MuxQueryResultV1.ResolvedTarget(item0): SdnValue.Array([SdnValue.String("ResolvedTarget"), mux_wire_encode_mux_object_ref_v1(item0)])
        case MuxQueryResultV1.Captured(item0): SdnValue.Array([SdnValue.String("Captured"), mux_wire_encode_mux_captured_v1(item0)])
        case MuxQueryResultV1.Context(item0): SdnValue.Array([SdnValue.String("Context"), mux_wire_encode_mux_context_v1(item0)])
        case MuxQueryResultV1.RequestReceipt(item0): SdnValue.Array([SdnValue.String("RequestReceipt"), mux_wire_encode_mux_request_receipt_v1(item0)])
        case MuxQueryResultV1.Capabilities(item0): SdnValue.Array([SdnValue.String("Capabilities"), mux_wire_encode_array_mux_operation_capability_v1(item0)])

pub fn mux_wire_decode_mux_query_result_v1(value: SdnValue) -> Result<MuxQueryResultV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Snapshot":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxQueryResultV1.Snapshot(mux_wire_decode_mux_snapshot_v1(fields[1])?))
    if tag == "ResolvedTarget":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxQueryResultV1.ResolvedTarget(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "Captured":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxQueryResultV1.Captured(mux_wire_decode_mux_captured_v1(fields[1])?))
    if tag == "Context":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxQueryResultV1.Context(mux_wire_decode_mux_context_v1(fields[1])?))
    if tag == "RequestReceipt":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxQueryResultV1.RequestReceipt(mux_wire_decode_mux_request_receipt_v1(fields[1])?))
    if tag == "Capabilities":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxQueryResultV1.Capabilities(mux_wire_decode_array_mux_operation_capability_v1(fields[1])?))
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_cleanup_v1(value: MuxCleanupV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 34
    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.pending)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_array_mux_object_ref_v1(value.remaining)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.detail)?)?
    Ok(size)

pub fn mux_wire_encode_mux_cleanup_v1(value: MuxCleanupV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxCleanupV1"),
        mux_wire_encode_bool_v1(value.pending),
        mux_wire_encode_array_mux_object_ref_v1(value.remaining),
        mux_wire_encode_text_v1(value.detail)])

