pub fn mux_wire_size_array_mux_event_v1(value: [MuxEventV1]) -> Result<i64, MuxWireErrorV1>:
    if value.len() > 16384: return Err(mux_wire_error_v1("array_limit"))
    var size: i64 = 2
    for item in value:
        size = mux_wire_sum_v1(size, 2)?
        size = mux_wire_sum_v1(size, mux_wire_size_mux_event_v1(item)?)?
    Ok(size)

pub fn mux_wire_encode_array_mux_event_v1(value: [MuxEventV1]) -> SdnValue:
    var items: [SdnValue] = []
    for item in value: items.push(mux_wire_encode_mux_event_v1(item))
    SdnValue.Array(items)

pub fn mux_wire_decode_array_mux_event_v1(value: SdnValue) -> Result<[MuxEventV1], MuxWireErrorV1>:
    val items = mux_wire_array_v1(value, -1)?
    var decoded: [MuxEventV1] = []
    for item in items: decoded.push(mux_wire_decode_mux_event_v1(item)?)
