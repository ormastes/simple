        case MuxEventKindV1.ObjectChanged(item0): SdnValue.Array([SdnValue.String("ObjectChanged"), mux_wire_encode_mux_object_ref_v1(item0)])
        case MuxEventKindV1.ObjectTerminated(item0): SdnValue.Array([SdnValue.String("ObjectTerminated"), mux_wire_encode_mux_object_ref_v1(item0)])
        case MuxEventKindV1.ChildExited(item0, item1): SdnValue.Array([SdnValue.String("ChildExited"), mux_wire_encode_mux_object_ref_v1(item0), mux_wire_encode_mux_child_state_v1(item1)])
        case MuxEventKindV1.ContentAvailable(item0, item1): SdnValue.Array([SdnValue.String("ContentAvailable"), mux_wire_encode_mux_object_ref_v1(item0), mux_wire_encode_u64_v1(item1)])
        case MuxEventKindV1.LayoutChanged(item0): SdnValue.Array([SdnValue.String("LayoutChanged"), mux_wire_encode_mux_object_ref_v1(item0)])
        case MuxEventKindV1.Notification(item0): SdnValue.Array([SdnValue.String("Notification"), mux_wire_encode_mux_notification_receipt_v1(item0)])
        case MuxEventKindV1.LeaseRevoked: SdnValue.Array([SdnValue.String("LeaseRevoked")])

pub fn mux_wire_decode_mux_event_kind_v1(value: SdnValue) -> Result<MuxEventKindV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "ObjectCreated":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEventKindV1.ObjectCreated(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "ObjectChanged":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEventKindV1.ObjectChanged(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "ObjectTerminated":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEventKindV1.ObjectTerminated(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "ChildExited":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEventKindV1.ChildExited(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_mux_child_state_v1(fields[2])?))
    if tag == "ContentAvailable":
        if fields.len() != 3: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEventKindV1.ContentAvailable(mux_wire_decode_mux_object_ref_v1(fields[1])?, mux_wire_decode_u64_v1(fields[2])?))
    if tag == "LayoutChanged":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEventKindV1.LayoutChanged(mux_wire_decode_mux_object_ref_v1(fields[1])?))
    if tag == "Notification":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEventKindV1.Notification(mux_wire_decode_mux_notification_receipt_v1(fields[1])?))
    if tag == "LeaseRevoked":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEventKindV1.LeaseRevoked)
    Err(mux_wire_error_v1("unknown_variant"))

