    Ok(nodes)

pub fn mux_wire_nodes_optional_i64_v1(value: i64?) -> Result<i64, MuxWireErrorV1>:
    match value:
        case nil: Ok(1)
        case Some(item): mux_wire_node_sum_v1(2, 1)

pub fn mux_wire_nodes_mux_child_state_v1(value: MuxChildStateV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxChildStateV1.Running(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, 1)?
            Ok(nodes)
        case MuxChildStateV1.Exited(item0, item1, item2):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, 1)?
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_i64_v1(item1)?)?
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_text_v1(item2)?)?
            Ok(nodes)
        case MuxChildStateV1.Unknown(item0, item1):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_i64_v1(item0)?)?
            nodes = mux_wire_node_sum_v1(nodes, 1)?
            Ok(nodes)

pub fn mux_wire_nodes_mux_pane_state_v1(value: MuxPaneStateV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(value.identity)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(value.session)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(value.window)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_child_state_v1(value.child)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_rect_v1(value.rectangle)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_border_v1(value.border)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_border_status_v1(value.border_status)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    Ok(nodes)

