pub fn mux_wire_nodes_mux_evidence_v1(value: MuxEvidenceV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxEvidenceV1.NotRun:
            var nodes: i64 = 2
            Ok(nodes)
        case MuxEvidenceV1.Blocked(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, 1)?
            Ok(nodes)
        case MuxEvidenceV1.Qualified(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, 1)?
            Ok(nodes)

pub fn mux_wire_nodes_mux_operation_capability_v1(value: MuxOperationCapabilityV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_operation_v1(value.operation)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_cap_level_v1(value.level)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_backend_v1(value.backend)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_core_limits_v1(value.limits)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_text_v1(value.constraints)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_evidence_v1(value.evidence)?)?
    Ok(nodes)

