pub fn mux_wire_nodes_mux_snapshot_v1(value: MuxSnapshotV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_backend_v1(value.backend)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_handle_v1(value.handle)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_session_state_v1(value.sessions)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_window_state_v1(value.windows)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_pane_state_v1(value.panes)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_client_state_v1(value.clients)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_core_limits_v1(value.limits)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_operation_capability_v1(value.capabilities)?)?
    Ok(nodes)

