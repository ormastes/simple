pub fn mux_wire_nodes_mux_request_receipt_v1(value: MuxRequestReceiptV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_handle_v1(value.handle)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_mux_operation_v1(value.operation)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_request_knowledge_v1(value.knowledge)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_commit_state_v1(value.commit_state)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_u64_v1(value.prior_revision)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_u64_v1(value.observed_revision)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_object_ref_v1(value.affected)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_mux_error_kind_v1(value.error_kind)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    Ok(nodes)

pub fn mux_wire_nodes_mux_query_result_v1(value: MuxQueryResultV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxQueryResultV1.Snapshot(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_snapshot_v1(item0)?)?
            Ok(nodes)
        case MuxQueryResultV1.ResolvedTarget(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(item0)?)?
            Ok(nodes)
        case MuxQueryResultV1.Captured(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_captured_v1(item0)?)?
            Ok(nodes)
        case MuxQueryResultV1.Context(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_context_v1(item0)?)?
            Ok(nodes)
        case MuxQueryResultV1.RequestReceipt(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_request_receipt_v1(item0)?)?
            Ok(nodes)
        case MuxQueryResultV1.Capabilities(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_operation_capability_v1(item0)?)?
            Ok(nodes)

pub fn mux_wire_nodes_mux_cleanup_v1(value: MuxCleanupV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_object_ref_v1(value.remaining)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    Ok(nodes)

pub fn mux_wire_nodes_mux_notification_state_v1(value: MuxNotificationStateV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxNotificationStateV1.Queued:
            var nodes: i64 = 2
            Ok(nodes)
        case MuxNotificationStateV1.Rendered(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_object_ref_v1(item0)?)?
            Ok(nodes)
        case MuxNotificationStateV1.Expired:
            var nodes: i64 = 2
            Ok(nodes)

pub fn mux_wire_nodes_mux_notification_receipt_v1(value: MuxNotificationReceiptV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_notification_state_v1(value.state)?)?
    Ok(nodes)

pub fn mux_wire_nodes_optional_mux_notification_receipt_v1(value: MuxNotificationReceiptV1?) -> Result<i64, MuxWireErrorV1>:
    match value:
        case nil: Ok(1)
        case Some(item): mux_wire_node_sum_v1(2, mux_wire_nodes_mux_notification_receipt_v1(item)?)

pub fn mux_wire_nodes_mux_mutation_v1(value: MuxMutationV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_request_receipt_v1(value.receipt)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_object_ref_v1(value.created)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_object_ref_v1(value.changed)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_snapshot_v1(value.snapshot)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_cleanup_v1(value.cleanup)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_mux_notification_receipt_v1(value.notification)?)?
    Ok(nodes)

pub fn mux_wire_nodes_mux_event_kind_v1(value: MuxEventKindV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxEventKindV1.ObjectCreated(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(item0)?)?
            Ok(nodes)
        case MuxEventKindV1.ObjectChanged(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(item0)?)?
            Ok(nodes)
        case MuxEventKindV1.ObjectTerminated(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(item0)?)?
            Ok(nodes)
        case MuxEventKindV1.ChildExited(item0, item1):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(item0)?)?
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_child_state_v1(item1)?)?
            Ok(nodes)
        case MuxEventKindV1.ContentAvailable(item0, item1):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(item0)?)?
            nodes = mux_wire_node_sum_v1(nodes, 1)?
            Ok(nodes)
        case MuxEventKindV1.LayoutChanged(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(item0)?)?
            Ok(nodes)
        case MuxEventKindV1.Notification(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_notification_receipt_v1(item0)?)?
            Ok(nodes)
        case MuxEventKindV1.LeaseRevoked:
            var nodes: i64 = 2
            Ok(nodes)

pub fn mux_wire_nodes_mux_event_v1(value: MuxEventV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_u64_v1(value.causal_request_id)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_event_kind_v1(value.kind)?)?
    Ok(nodes)

pub fn mux_wire_nodes_array_mux_event_v1(value: [MuxEventV1]) -> Result<i64, MuxWireErrorV1>:
    if value.len() > 16384: return Err(mux_wire_error_v1("array_limit"))
    var nodes: i64 = 1
    for item in value: nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_event_v1(item)?)?
    Ok(nodes)

pub fn mux_wire_nodes_mux_event_batch_v1(value: MuxEventBatchV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_event_v1(value.events)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    Ok(nodes)
