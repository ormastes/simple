# Exact typed SDN node preflight, before allocating an SdnValue/hex string.
# A record/enum contributes array+tag; optional Some contributes array+tag;
# each scalar contributes1 and each collection contributes its container node.
use std.common.debug.capability.{CapLevel}
use std.common.contracts.mux.core_v1.*
use std.common.contracts.mux.execution_v1.*
use std.common.contracts.mux.observation_v1.*
use std.common.contracts.mux.wire_types_v1.*
use std.common.contracts.mux.wire_primitives_v1.*
use std.common.contracts.mux.wire_budget_01_v1.*

pub fn mux_wire_nodes_mux_wire_call_v1(value: MuxWireCallV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxWireCallV1.Connect(item0, item1):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_connect_v1(item0)?)?
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_deadline_v1(item1)?)?
            Ok(nodes)
        case MuxWireCallV1.Query(item0, item1, item2):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_handle_v1(item0)?)?
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_query_v1(item1)?)?
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_deadline_v1(item2)?)?
            Ok(nodes)
        case MuxWireCallV1.Execute(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_request_v1(item0)?)?
            Ok(nodes)
        case MuxWireCallV1.PollEvents(item0, item1, item2, item3):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_handle_v1(item0)?)?
            nodes = mux_wire_node_sum_v1(nodes, 1)?
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_event_limits_v1(item2)?)?
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_deadline_v1(item3)?)?
            Ok(nodes)
        case MuxWireCallV1.Disconnect(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_disconnect_request_v1(item0)?)?
            Ok(nodes)

pub fn mux_wire_nodes_mux_session_state_v1(value: MuxSessionStateV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(value.identity)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_mux_object_ref_v1(value.current_window)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    Ok(nodes)

pub fn mux_wire_nodes_array_mux_session_state_v1(value: [MuxSessionStateV1]) -> Result<i64, MuxWireErrorV1>:
    if value.len() > 16384: return Err(mux_wire_error_v1("array_limit"))
    var nodes: i64 = 1
    for item in value: nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_session_state_v1(item)?)?
    Ok(nodes)

pub fn mux_wire_nodes_mux_rect_v1(value: MuxRectV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    Ok(nodes)

pub fn mux_wire_nodes_mux_pane_rect_v1(value: MuxPaneRectV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(value.pane)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_rect_v1(value.rectangle)?)?
    Ok(nodes)

pub fn mux_wire_nodes_array_mux_pane_rect_v1(value: [MuxPaneRectV1]) -> Result<i64, MuxWireErrorV1>:
