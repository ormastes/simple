pub fn mux_wire_nodes_mux_layout_state_v1(value: MuxLayoutStateV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_layout_kind_v1(value.kind)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_cell_size_v1(value.canvas)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_array_mux_pane_rect_v1(value.rectangles)?)?
    Ok(nodes)

pub fn mux_wire_nodes_optional_mux_layout_state_v1(value: MuxLayoutStateV1?) -> Result<i64, MuxWireErrorV1>:
    match value:
        case nil: Ok(1)
        case Some(item): mux_wire_node_sum_v1(2, mux_wire_nodes_mux_layout_state_v1(item)?)

pub fn mux_wire_nodes_mux_window_state_v1(value: MuxWindowStateV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(value.identity)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(value.session)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_mux_object_ref_v1(value.active_pane)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_layout_state_v1(value.layout)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_mux_object_ref_v1(value.zoomed_pane)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_mux_layout_state_v1(value.restore_layout)?)?
    Ok(nodes)

pub fn mux_wire_nodes_array_mux_window_state_v1(value: [MuxWindowStateV1]) -> Result<i64, MuxWireErrorV1>:
