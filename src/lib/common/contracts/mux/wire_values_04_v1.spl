        case MuxOperationV1.SendKeys: SdnValue.Array([SdnValue.String("SendKeys")])
        case MuxOperationV1.Paste: SdnValue.Array([SdnValue.String("Paste")])
        case MuxOperationV1.SubmitShellCommand: SdnValue.Array([SdnValue.String("SubmitShellCommand")])
        case MuxOperationV1.Notify: SdnValue.Array([SdnValue.String("Notify")])

pub fn mux_wire_decode_mux_operation_v1(value: SdnValue) -> Result<MuxOperationV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Connect":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.Connect)
    if tag == "Snapshot":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.Snapshot)
    if tag == "ResolveTarget":
