pub fn mux_wire_size_mux_core_limits_v1(value: MuxCoreLimitsV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 50
    size = mux_wire_sum_v1(size, mux_wire_size_mux_limits_v1(value.discovery)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.max_windows)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.max_panes)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.max_clients)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.max_input_bytes)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.max_capture_bytes)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.max_events)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.max_request_timeout_ms)?)?
    Ok(size)

pub fn mux_wire_encode_mux_core_limits_v1(value: MuxCoreLimitsV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxCoreLimitsV1"),
        mux_wire_encode_mux_limits_v1(value.discovery),
        mux_wire_encode_i64_v1(value.max_windows),
        mux_wire_encode_i64_v1(value.max_panes),
        mux_wire_encode_i64_v1(value.max_clients),
        mux_wire_encode_i64_v1(value.max_input_bytes),
        mux_wire_encode_i64_v1(value.max_capture_bytes),
        mux_wire_encode_i64_v1(value.max_events),
        mux_wire_encode_i64_v1(value.max_request_timeout_ms)])

pub fn mux_wire_decode_mux_core_limits_v1(value: SdnValue) -> Result<MuxCoreLimitsV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 9)?
    mux_wire_tag_v1(fields, "MuxCoreLimitsV1")?
    Ok(MuxCoreLimitsV1(
        discovery: mux_wire_decode_mux_limits_v1(fields[1])?,
        max_windows: mux_wire_decode_i64_v1(fields[2])?,
        max_panes: mux_wire_decode_i64_v1(fields[3])?,
        max_clients: mux_wire_decode_i64_v1(fields[4])?,
        max_input_bytes: mux_wire_decode_i64_v1(fields[5])?,
        max_capture_bytes: mux_wire_decode_i64_v1(fields[6])?,
        max_events: mux_wire_decode_i64_v1(fields[7])?,
        max_request_timeout_ms: mux_wire_decode_i64_v1(fields[8])?))

