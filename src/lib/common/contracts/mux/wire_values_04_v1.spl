    if tag == "LaunchPane":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.LaunchPane)
    if tag == "SplitPane":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.SplitPane)
    if tag == "TerminatePane":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
