        return Ok(MuxOperationV1.CurrentContext)
    if tag == "RequestStatus":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.RequestStatus)
    if tag == "Capabilities":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.Capabilities)
    if tag == "PollEvents":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.PollEvents)
    if tag == "Disconnect":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.Disconnect)
    if tag == "CreateSession":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.CreateSession)
    if tag == "RenameSession":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.RenameSession)
    if tag == "TerminateSession":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.TerminateSession)
    if tag == "StopOwnedNamespace":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.StopOwnedNamespace)
    if tag == "CreateWindow":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.CreateWindow)
    if tag == "RenameWindow":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
