# Fixed-arity typed SDN schema. Internal constructors require whole-envelope
# size preflight; use wire_envelope_v1 for public bounded byte conversion.
use std.common.sdn.value.{SdnValue}
use std.common.debug.capability.{CapLevel}
use std.common.contracts.mux.core_v1.*
use std.common.contracts.mux.execution_v1.*
use std.common.contracts.mux.observation_v1.*
use std.common.contracts.mux.wire_types_v1.*
use std.common.contracts.mux.wire_primitives_v1.*
use std.common.contracts.mux.wire_values_01_v1.*
use std.common.contracts.mux.wire_values_02_v1.*
use std.common.contracts.mux.wire_values_03_v1.*

pub fn mux_wire_size_mux_pane_state_v1(value: MuxPaneStateV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 60
    size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(value.identity)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(value.session)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(value.window)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.legacy_id)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_i64_v1(value.index)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_child_state_v1(value.child)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.title)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.current_command)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_rect_v1(value.rectangle)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.focused)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.hidden)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_border_v1(value.border)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_border_status_v1(value.border_status)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.content_revision)?)?
    Ok(size)

pub fn mux_wire_encode_mux_pane_state_v1(value: MuxPaneStateV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxPaneStateV1"),
        mux_wire_encode_mux_object_ref_v1(value.identity),
        mux_wire_encode_mux_object_ref_v1(value.session),
        mux_wire_encode_mux_object_ref_v1(value.window),
        mux_wire_encode_text_v1(value.legacy_id),
        mux_wire_encode_i64_v1(value.index),
        mux_wire_encode_mux_child_state_v1(value.child),
        mux_wire_encode_text_v1(value.title),
        mux_wire_encode_text_v1(value.current_command),
        mux_wire_encode_mux_rect_v1(value.rectangle),
        mux_wire_encode_bool_v1(value.focused),
        mux_wire_encode_bool_v1(value.hidden),
        mux_wire_encode_mux_border_v1(value.border),
        mux_wire_encode_mux_border_status_v1(value.border_status),
        mux_wire_encode_u64_v1(value.content_revision)])

pub fn mux_wire_decode_mux_pane_state_v1(value: SdnValue) -> Result<MuxPaneStateV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 15)?
    mux_wire_tag_v1(fields, "MuxPaneStateV1")?
    Ok(MuxPaneStateV1(
        identity: mux_wire_decode_mux_object_ref_v1(fields[1])?,
        session: mux_wire_decode_mux_object_ref_v1(fields[2])?,
        window: mux_wire_decode_mux_object_ref_v1(fields[3])?,
        legacy_id: mux_wire_decode_text_v1(fields[4])?,
        index: mux_wire_decode_i64_v1(fields[5])?,
        child: mux_wire_decode_mux_child_state_v1(fields[6])?,
        title: mux_wire_decode_text_v1(fields[7])?,
        current_command: mux_wire_decode_text_v1(fields[8])?,
        rectangle: mux_wire_decode_mux_rect_v1(fields[9])?,
        focused: mux_wire_decode_bool_v1(fields[10])?,
        hidden: mux_wire_decode_bool_v1(fields[11])?,
        border: mux_wire_decode_mux_border_v1(fields[12])?,
        border_status: mux_wire_decode_mux_border_status_v1(fields[13])?,
        content_revision: mux_wire_decode_u64_v1(fields[14])?))

pub fn mux_wire_size_array_mux_pane_state_v1(value: [MuxPaneStateV1]) -> Result<i64, MuxWireErrorV1>:
    if value.len() > 16384: return Err(mux_wire_error_v1("array_limit"))
    var size: i64 = 2
    for item in value:
        size = mux_wire_sum_v1(size, 2)?
        size = mux_wire_sum_v1(size, mux_wire_size_mux_pane_state_v1(item)?)?
    Ok(size)

pub fn mux_wire_encode_array_mux_pane_state_v1(value: [MuxPaneStateV1]) -> SdnValue:
    var items: [SdnValue] = []
    for item in value: items.push(mux_wire_encode_mux_pane_state_v1(item))
    SdnValue.Array(items)

pub fn mux_wire_decode_array_mux_pane_state_v1(value: SdnValue) -> Result<[MuxPaneStateV1], MuxWireErrorV1>:
    val items = mux_wire_array_v1(value, -1)?
    var decoded: [MuxPaneStateV1] = []
    for item in items: decoded.push(mux_wire_decode_mux_pane_state_v1(item)?)
    Ok(decoded)

pub fn mux_wire_size_mux_client_state_v1(value: MuxClientStateV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 44
    size = mux_wire_sum_v1(size, mux_wire_size_mux_object_ref_v1(value.identity)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_context_v1(value.context)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_cell_size_v1(value.viewport)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.attached)?)?
    Ok(size)

pub fn mux_wire_encode_mux_client_state_v1(value: MuxClientStateV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxClientStateV1"),
        mux_wire_encode_mux_object_ref_v1(value.identity),
        mux_wire_encode_mux_context_v1(value.context),
        mux_wire_encode_mux_cell_size_v1(value.viewport),
        mux_wire_encode_bool_v1(value.attached)])

pub fn mux_wire_decode_mux_client_state_v1(value: SdnValue) -> Result<MuxClientStateV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 5)?
    mux_wire_tag_v1(fields, "MuxClientStateV1")?
    Ok(MuxClientStateV1(
        identity: mux_wire_decode_mux_object_ref_v1(fields[1])?,
        context: mux_wire_decode_mux_context_v1(fields[2])?,
        viewport: mux_wire_decode_mux_cell_size_v1(fields[3])?,
        attached: mux_wire_decode_bool_v1(fields[4])?))

pub fn mux_wire_size_array_mux_client_state_v1(value: [MuxClientStateV1]) -> Result<i64, MuxWireErrorV1>:
    if value.len() > 16384: return Err(mux_wire_error_v1("array_limit"))
    var size: i64 = 2
    for item in value:
        size = mux_wire_sum_v1(size, 2)?
        size = mux_wire_sum_v1(size, mux_wire_size_mux_client_state_v1(item)?)?
