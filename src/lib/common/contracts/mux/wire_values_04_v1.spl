pub fn mux_wire_size_mux_connection_v1(value: MuxConnectionV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 38
    size = mux_wire_sum_v1(size, mux_wire_size_mux_snapshot_v1(value.snapshot)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_lease_terms_v1(value.lease_terms)?)?
    Ok(size)

pub fn mux_wire_encode_mux_connection_v1(value: MuxConnectionV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxConnectionV1"),
        mux_wire_encode_mux_snapshot_v1(value.snapshot),
        mux_wire_encode_mux_lease_terms_v1(value.lease_terms)])

pub fn mux_wire_decode_mux_connection_v1(value: SdnValue) -> Result<MuxConnectionV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 3)?
    mux_wire_tag_v1(fields, "MuxConnectionV1")?
    Ok(MuxConnectionV1(
        snapshot: mux_wire_decode_mux_snapshot_v1(fields[1])?,
        lease_terms: mux_wire_decode_mux_lease_terms_v1(fields[2])?))
