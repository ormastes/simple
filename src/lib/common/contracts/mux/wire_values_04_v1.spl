        return Ok(MuxOperationV1.SendLiteral)
    if tag == "SendKeys":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.SendKeys)
    if tag == "Paste":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.Paste)
    if tag == "SubmitShellCommand":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.SubmitShellCommand)
    if tag == "Notify":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxOperationV1.Notify)
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_cap_level_v1(value: CapLevel) -> Result<i64, MuxWireErrorV1>:
    match value:
        case CapLevel.Native:
            var size: i64 = 16
            Ok(size)
        case CapLevel.Emulated:
            var size: i64 = 20
            Ok(size)
        case CapLevel.Unavailable:
            var size: i64 = 26
            Ok(size)

pub fn mux_wire_encode_cap_level_v1(value: CapLevel) -> SdnValue:
    match value:
        case CapLevel.Native: SdnValue.Array([SdnValue.String("native")])
        case CapLevel.Emulated: SdnValue.Array([SdnValue.String("emulated")])
        case CapLevel.Unavailable: SdnValue.Array([SdnValue.String("unavailable")])

pub fn mux_wire_decode_cap_level_v1(value: SdnValue) -> Result<CapLevel, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "native":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(CapLevel.Native)
    if tag == "emulated":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(CapLevel.Emulated)
    if tag == "unavailable":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(CapLevel.Unavailable)
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_evidence_v1(value: MuxEvidenceV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxEvidenceV1.NotRun:
            var size: i64 = 16
            Ok(size)
        case MuxEvidenceV1.Blocked(item0):
            var size: i64 = 20
            size = mux_wire_sum_v1(size, mux_wire_size_text_v1(item0)?)?
            Ok(size)
        case MuxEvidenceV1.Qualified(item0):
            var size: i64 = 24
            size = mux_wire_sum_v1(size, mux_wire_size_text_v1(item0)?)?
            Ok(size)

pub fn mux_wire_encode_mux_evidence_v1(value: MuxEvidenceV1) -> SdnValue:
    match value:
        case MuxEvidenceV1.NotRun: SdnValue.Array([SdnValue.String("NotRun")])
        case MuxEvidenceV1.Blocked(item0): SdnValue.Array([SdnValue.String("Blocked"), mux_wire_encode_text_v1(item0)])
        case MuxEvidenceV1.Qualified(item0): SdnValue.Array([SdnValue.String("Qualified"), mux_wire_encode_text_v1(item0)])

pub fn mux_wire_decode_mux_evidence_v1(value: SdnValue) -> Result<MuxEvidenceV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "NotRun":
        if fields.len() != 1: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEvidenceV1.NotRun)
    if tag == "Blocked":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEvidenceV1.Blocked(mux_wire_decode_text_v1(fields[1])?))
    if tag == "Qualified":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxEvidenceV1.Qualified(mux_wire_decode_text_v1(fields[1])?))
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_operation_capability_v1(value: MuxOperationCapabilityV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 70
    size = mux_wire_sum_v1(size, mux_wire_size_mux_operation_v1(value.operation)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_cap_level_v1(value.level)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_backend_v1(value.backend)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.backend_version)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.owner_id)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.owner_generation)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_core_limits_v1(value.limits)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_array_text_v1(value.constraints)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_evidence_v1(value.evidence)?)?
    Ok(size)

pub fn mux_wire_encode_mux_operation_capability_v1(value: MuxOperationCapabilityV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxOperationCapabilityV1"),
        mux_wire_encode_mux_operation_v1(value.operation),
        mux_wire_encode_cap_level_v1(value.level),
        mux_wire_encode_mux_backend_v1(value.backend),
        mux_wire_encode_text_v1(value.backend_version),
        mux_wire_encode_text_v1(value.owner_id),
        mux_wire_encode_u64_v1(value.owner_generation),
        mux_wire_encode_mux_core_limits_v1(value.limits),
        mux_wire_encode_array_text_v1(value.constraints),
        mux_wire_encode_mux_evidence_v1(value.evidence)])

pub fn mux_wire_decode_mux_operation_capability_v1(value: SdnValue) -> Result<MuxOperationCapabilityV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 10)?
    mux_wire_tag_v1(fields, "MuxOperationCapabilityV1")?
    Ok(MuxOperationCapabilityV1(
        operation: mux_wire_decode_mux_operation_v1(fields[1])?,
        level: mux_wire_decode_cap_level_v1(fields[2])?,
        backend: mux_wire_decode_mux_backend_v1(fields[3])?,
        backend_version: mux_wire_decode_text_v1(fields[4])?,
        owner_id: mux_wire_decode_text_v1(fields[5])?,
        owner_generation: mux_wire_decode_u64_v1(fields[6])?,
        limits: mux_wire_decode_mux_core_limits_v1(fields[7])?,
        constraints: mux_wire_decode_array_text_v1(fields[8])?,
        evidence: mux_wire_decode_mux_evidence_v1(fields[9])?))

pub fn mux_wire_size_array_mux_operation_capability_v1(value: [MuxOperationCapabilityV1]) -> Result<i64, MuxWireErrorV1>:
    if value.len() > 16384: return Err(mux_wire_error_v1("array_limit"))
    var size: i64 = 2
    for item in value:
        size = mux_wire_sum_v1(size, 2)?
        size = mux_wire_sum_v1(size, mux_wire_size_mux_operation_capability_v1(item)?)?
    Ok(size)

pub fn mux_wire_encode_array_mux_operation_capability_v1(value: [MuxOperationCapabilityV1]) -> SdnValue:
    var items: [SdnValue] = []
    for item in value: items.push(mux_wire_encode_mux_operation_capability_v1(item))
    SdnValue.Array(items)

pub fn mux_wire_decode_array_mux_operation_capability_v1(value: SdnValue) -> Result<[MuxOperationCapabilityV1], MuxWireErrorV1>:
    val items = mux_wire_array_v1(value, -1)?
    var decoded: [MuxOperationCapabilityV1] = []
    for item in items: decoded.push(mux_wire_decode_mux_operation_capability_v1(item)?)
    Ok(decoded)

pub fn mux_wire_size_mux_snapshot_v1(value: MuxSnapshotV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 50
    size = mux_wire_sum_v1(size, mux_wire_size_mux_backend_v1(value.backend)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.namespace)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_handle_v1(value.handle)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.revision)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_array_mux_session_state_v1(value.sessions)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_array_mux_window_state_v1(value.windows)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_array_mux_pane_state_v1(value.panes)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_array_mux_client_state_v1(value.clients)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_core_limits_v1(value.limits)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_array_mux_operation_capability_v1(value.capabilities)?)?
    Ok(size)

pub fn mux_wire_encode_mux_snapshot_v1(value: MuxSnapshotV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxSnapshotV1"),
        mux_wire_encode_mux_backend_v1(value.backend),
        mux_wire_encode_text_v1(value.namespace),
        mux_wire_encode_mux_handle_v1(value.handle),
        mux_wire_encode_u64_v1(value.revision),
        mux_wire_encode_array_mux_session_state_v1(value.sessions),
        mux_wire_encode_array_mux_window_state_v1(value.windows),
        mux_wire_encode_array_mux_pane_state_v1(value.panes),
        mux_wire_encode_array_mux_client_state_v1(value.clients),
        mux_wire_encode_mux_core_limits_v1(value.limits),
        mux_wire_encode_array_mux_operation_capability_v1(value.capabilities)])

pub fn mux_wire_decode_mux_snapshot_v1(value: SdnValue) -> Result<MuxSnapshotV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 11)?
    mux_wire_tag_v1(fields, "MuxSnapshotV1")?
    Ok(MuxSnapshotV1(
