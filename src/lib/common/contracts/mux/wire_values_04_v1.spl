pub fn mux_wire_encode_array_mux_client_state_v1(value: [MuxClientStateV1]) -> SdnValue:
    var items: [SdnValue] = []
    for item in value: items.push(mux_wire_encode_mux_client_state_v1(item))
    SdnValue.Array(items)

pub fn mux_wire_decode_array_mux_client_state_v1(value: SdnValue) -> Result<[MuxClientStateV1], MuxWireErrorV1>:
    val items = mux_wire_array_v1(value, -1)?
    var decoded: [MuxClientStateV1] = []
    for item in items: decoded.push(mux_wire_decode_mux_client_state_v1(item)?)
