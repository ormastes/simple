        sessions: mux_wire_decode_array_mux_session_state_v1(fields[5])?,
        windows: mux_wire_decode_array_mux_window_state_v1(fields[6])?,
        panes: mux_wire_decode_array_mux_pane_state_v1(fields[7])?,
        clients: mux_wire_decode_array_mux_client_state_v1(fields[8])?,
        limits: mux_wire_decode_mux_core_limits_v1(fields[9])?,
        capabilities: mux_wire_decode_array_mux_operation_capability_v1(fields[10])?))

pub fn mux_wire_size_mux_lease_terms_v1(value: MuxLeaseTermsV1) -> Result<i64, MuxWireErrorV1>:
