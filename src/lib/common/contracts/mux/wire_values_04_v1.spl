        case MuxOperationV1.CreateSession: SdnValue.Array([SdnValue.String("CreateSession")])
        case MuxOperationV1.RenameSession: SdnValue.Array([SdnValue.String("RenameSession")])
        case MuxOperationV1.TerminateSession: SdnValue.Array([SdnValue.String("TerminateSession")])
        case MuxOperationV1.StopOwnedNamespace: SdnValue.Array([SdnValue.String("StopOwnedNamespace")])
        case MuxOperationV1.CreateWindow: SdnValue.Array([SdnValue.String("CreateWindow")])
        case MuxOperationV1.RenameWindow: SdnValue.Array([SdnValue.String("RenameWindow")])
        case MuxOperationV1.TerminateWindow: SdnValue.Array([SdnValue.String("TerminateWindow")])
        case MuxOperationV1.FocusWindow: SdnValue.Array([SdnValue.String("FocusWindow")])
        case MuxOperationV1.LaunchPane: SdnValue.Array([SdnValue.String("LaunchPane")])
        case MuxOperationV1.SplitPane: SdnValue.Array([SdnValue.String("SplitPane")])
        case MuxOperationV1.TerminatePane: SdnValue.Array([SdnValue.String("TerminatePane")])
        case MuxOperationV1.FocusPane: SdnValue.Array([SdnValue.String("FocusPane")])
        case MuxOperationV1.ResizePane: SdnValue.Array([SdnValue.String("ResizePane")])
        case MuxOperationV1.ResizeWindow: SdnValue.Array([SdnValue.String("ResizeWindow")])
