# Fixed-arity typed SDN schema. Internal constructors require whole-envelope
# size preflight; use wire_envelope_v1 for public bounded byte conversion.
use std.common.sdn.value.{SdnValue}
use std.common.debug.capability.{CapLevel}
use std.common.contracts.mux.core_v1.*
use std.common.contracts.mux.execution_v1.*
use std.common.contracts.mux.observation_v1.*
use std.common.contracts.mux.wire_types_v1.*
use std.common.contracts.mux.wire_primitives_v1.*
use std.common.contracts.mux.wire_values_01_v1.*
use std.common.contracts.mux.wire_values_04_v1.*
use std.common.contracts.mux.wire_values_05_v1.*

pub fn mux_wire_size_mux_event_batch_v1(value: MuxEventBatchV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 46
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.owner_id)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.owner_generation)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.from_cursor)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.to_cursor)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_array_mux_event_v1(value.events)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.reconciliation_required)?)?
    Ok(size)

pub fn mux_wire_encode_mux_event_batch_v1(value: MuxEventBatchV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxEventBatchV1"),
        mux_wire_encode_text_v1(value.owner_id),
        mux_wire_encode_u64_v1(value.owner_generation),
        mux_wire_encode_u64_v1(value.from_cursor),
        mux_wire_encode_u64_v1(value.to_cursor),
        mux_wire_encode_array_mux_event_v1(value.events),
        mux_wire_encode_bool_v1(value.reconciliation_required)])

pub fn mux_wire_decode_mux_event_batch_v1(value: SdnValue) -> Result<MuxEventBatchV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 7)?
    mux_wire_tag_v1(fields, "MuxEventBatchV1")?
    Ok(MuxEventBatchV1(
        owner_id: mux_wire_decode_text_v1(fields[1])?,
        owner_generation: mux_wire_decode_u64_v1(fields[2])?,
        from_cursor: mux_wire_decode_u64_v1(fields[3])?,
        to_cursor: mux_wire_decode_u64_v1(fields[4])?,
        events: mux_wire_decode_array_mux_event_v1(fields[5])?,
        reconciliation_required: mux_wire_decode_bool_v1(fields[6])?))

pub fn mux_wire_size_mux_disconnect_v1(value: MuxDisconnectV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 44
    size = mux_wire_sum_v1(size, mux_wire_size_mux_request_receipt_v1(value.receipt)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.already_disconnected)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_array_mux_object_ref_v1(value.released_clients)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.revision)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_cleanup_v1(value.cleanup)?)?
    Ok(size)

pub fn mux_wire_encode_mux_disconnect_v1(value: MuxDisconnectV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxDisconnectV1"),
        mux_wire_encode_mux_request_receipt_v1(value.receipt),
        mux_wire_encode_bool_v1(value.already_disconnected),
        mux_wire_encode_array_mux_object_ref_v1(value.released_clients),
        mux_wire_encode_u64_v1(value.revision),
        mux_wire_encode_mux_cleanup_v1(value.cleanup)])

pub fn mux_wire_decode_mux_disconnect_v1(value: SdnValue) -> Result<MuxDisconnectV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 6)?
    mux_wire_tag_v1(fields, "MuxDisconnectV1")?
    Ok(MuxDisconnectV1(
        receipt: mux_wire_decode_mux_request_receipt_v1(fields[1])?,
        already_disconnected: mux_wire_decode_bool_v1(fields[2])?,
        released_clients: mux_wire_decode_array_mux_object_ref_v1(fields[3])?,
        revision: mux_wire_decode_u64_v1(fields[4])?,
        cleanup: mux_wire_decode_mux_cleanup_v1(fields[5])?))

pub fn mux_wire_size_mux_wire_result_v1(value: MuxWireResultV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxWireResultV1.Connection(item0):
            var size: i64 = 26
            size = mux_wire_sum_v1(size, mux_wire_size_mux_connection_v1(item0)?)?
            Ok(size)
        case MuxWireResultV1.Query(item0):
            var size: i64 = 16
            size = mux_wire_sum_v1(size, mux_wire_size_mux_query_result_v1(item0)?)?
            Ok(size)
        case MuxWireResultV1.Mutation(item0):
            var size: i64 = 22
            size = mux_wire_sum_v1(size, mux_wire_size_mux_mutation_v1(item0)?)?
            Ok(size)
        case MuxWireResultV1.Events(item0):
            var size: i64 = 18
            size = mux_wire_sum_v1(size, mux_wire_size_mux_event_batch_v1(item0)?)?
            Ok(size)
        case MuxWireResultV1.Disconnect(item0):
            var size: i64 = 26
            size = mux_wire_sum_v1(size, mux_wire_size_mux_disconnect_v1(item0)?)?
            Ok(size)

pub fn mux_wire_encode_mux_wire_result_v1(value: MuxWireResultV1) -> SdnValue:
    match value:
        case MuxWireResultV1.Connection(item0): SdnValue.Array([SdnValue.String("Connection"), mux_wire_encode_mux_connection_v1(item0)])
        case MuxWireResultV1.Query(item0): SdnValue.Array([SdnValue.String("Query"), mux_wire_encode_mux_query_result_v1(item0)])
        case MuxWireResultV1.Mutation(item0): SdnValue.Array([SdnValue.String("Mutation"), mux_wire_encode_mux_mutation_v1(item0)])
        case MuxWireResultV1.Events(item0): SdnValue.Array([SdnValue.String("Events"), mux_wire_encode_mux_event_batch_v1(item0)])
        case MuxWireResultV1.Disconnect(item0): SdnValue.Array([SdnValue.String("Disconnect"), mux_wire_encode_mux_disconnect_v1(item0)])

pub fn mux_wire_decode_mux_wire_result_v1(value: SdnValue) -> Result<MuxWireResultV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, -1)?
    if fields.len() == 0: return Err(mux_wire_error_v1("missing_tag"))
    val tag = mux_wire_decode_text_v1(fields[0])?
    if tag == "Connection":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxWireResultV1.Connection(mux_wire_decode_mux_connection_v1(fields[1])?))
    if tag == "Query":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxWireResultV1.Query(mux_wire_decode_mux_query_result_v1(fields[1])?))
    if tag == "Mutation":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxWireResultV1.Mutation(mux_wire_decode_mux_mutation_v1(fields[1])?))
    if tag == "Events":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxWireResultV1.Events(mux_wire_decode_mux_event_batch_v1(fields[1])?))
    if tag == "Disconnect":
        if fields.len() != 2: return Err(mux_wire_error_v1("variant_arity"))
        return Ok(MuxWireResultV1.Disconnect(mux_wire_decode_mux_disconnect_v1(fields[1])?))
    Err(mux_wire_error_v1("unknown_variant"))

pub fn mux_wire_size_mux_error_v1(value: MuxErrorV1) -> Result<i64, MuxWireErrorV1>:
    var size: i64 = 38
    size = mux_wire_sum_v1(size, mux_wire_size_mux_error_kind_v1(value.kind)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_text_v1(value.detail)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_u64_v1(value.request_id)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_mux_commit_state_v1(value.commit_state)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_optional_u64_v1(value.observed_revision)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_array_mux_object_ref_v1(value.affected)?)?
    size = mux_wire_sum_v1(size, mux_wire_size_bool_v1(value.cleanup_pending)?)?
    Ok(size)

pub fn mux_wire_encode_mux_error_v1(value: MuxErrorV1) -> SdnValue:
    SdnValue.Array([SdnValue.String("MuxErrorV1"),
        mux_wire_encode_mux_error_kind_v1(value.kind),
        mux_wire_encode_text_v1(value.detail),
        mux_wire_encode_u64_v1(value.request_id),
        mux_wire_encode_mux_commit_state_v1(value.commit_state),
        mux_wire_encode_optional_u64_v1(value.observed_revision),
        mux_wire_encode_array_mux_object_ref_v1(value.affected),
        mux_wire_encode_bool_v1(value.cleanup_pending)])

pub fn mux_wire_decode_mux_error_v1(value: SdnValue) -> Result<MuxErrorV1, MuxWireErrorV1>:
    val fields = mux_wire_array_v1(value, 8)?
    mux_wire_tag_v1(fields, "MuxErrorV1")?
    Ok(MuxErrorV1(
        kind: mux_wire_decode_mux_error_kind_v1(fields[1])?,
        detail: mux_wire_decode_text_v1(fields[2])?,
        request_id: mux_wire_decode_u64_v1(fields[3])?,
        commit_state: mux_wire_decode_mux_commit_state_v1(fields[4])?,
        observed_revision: mux_wire_decode_optional_u64_v1(fields[5])?,
        affected: mux_wire_decode_array_mux_object_ref_v1(fields[6])?,
        cleanup_pending: mux_wire_decode_bool_v1(fields[7])?))
