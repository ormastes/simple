pub fn mux_wire_nodes_mux_capture_v1(value: MuxCaptureV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(value.pane)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_capture_range_v1(value.range)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_text_v1(value.continuation)?)?
    Ok(nodes)

pub fn mux_wire_nodes_mux_query_v1(value: MuxQueryV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxQueryV1.Snapshot(item0, item1):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_scope_v1(item0)?)?
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_visibility_v1(item1)?)?
            Ok(nodes)
        case MuxQueryV1.ResolveTarget(item0, item1, item2):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, 1)?
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_kind_v1(item1)?)?
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_context_v1(item2)?)?
            Ok(nodes)
        case MuxQueryV1.Capture(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_capture_v1(item0)?)?
            Ok(nodes)
        case MuxQueryV1.CurrentContext(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(item0)?)?
            Ok(nodes)
        case MuxQueryV1.RequestStatus(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, 1)?
            Ok(nodes)
        case MuxQueryV1.Capabilities:
            var nodes: i64 = 2
            Ok(nodes)

pub fn mux_wire_nodes_optional_u64_v1(value: u64?) -> Result<i64, MuxWireErrorV1>:
