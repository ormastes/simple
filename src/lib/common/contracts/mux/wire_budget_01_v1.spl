pub fn mux_wire_nodes_optional_mux_object_ref_v1(value: MuxObjectRefV1?) -> Result<i64, MuxWireErrorV1>:
    match value:
        case nil: Ok(1)
        case Some(item): mux_wire_node_sum_v1(2, mux_wire_nodes_mux_object_ref_v1(item)?)

