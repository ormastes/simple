pub fn mux_wire_nodes_array_text_v1(value: [text]) -> Result<i64, MuxWireErrorV1>:
    if value.len() > 16384: return Err(mux_wire_error_v1("array_limit"))
    var nodes: i64 = 1
    for item in value: nodes = mux_wire_node_sum_v1(nodes, 1)?
    Ok(nodes)

