    match value:
        case MuxScopeV1.Namespace:
            var nodes: i64 = 2
            Ok(nodes)
        case MuxScopeV1.Session(item0):
            var nodes: i64 = 2
            nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_object_ref_v1(item0)?)?
            Ok(nodes)
