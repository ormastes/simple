    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_mux_object_ref_v1(value.window)?)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_optional_mux_object_ref_v1(value.pane)?)?
    Ok(nodes)

