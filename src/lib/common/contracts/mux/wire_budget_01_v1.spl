# Exact typed SDN node preflight, before allocating an SdnValue/hex string.
# A record/enum contributes array+tag; optional Some contributes array+tag;
# each scalar contributes1 and each collection contributes its container node.
use std.common.debug.capability.{CapLevel}
use std.common.contracts.mux.core_v1.*
use std.common.contracts.mux.execution_v1.*
use std.common.contracts.mux.observation_v1.*
use std.common.contracts.mux.wire_types_v1.*
use std.common.contracts.mux.wire_primitives_v1.*

# Acyclic frozen schema worst-case nesting including envelope root: 13.
# Arrays/options contribute one depth layer; records/enums add one container.
pub val MUX_WIRE_TYPED_MAX_DEPTH_V1: i64 = 13

pub fn mux_wire_node_sum_v1(left: i64, right: i64) -> Result<i64, MuxWireErrorV1>:
    if left < 0 or right < 0 or left > MUX_WIRE_MAX_NODES_V1 - right: return Err(mux_wire_error_v1("node_budget"))
    Ok(left + right)

pub fn mux_wire_nodes_mux_backend_v1(value: MuxBackendV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxBackendV1.Smux:
            var nodes: i64 = 2
            Ok(nodes)
        case MuxBackendV1.Tmux:
            var nodes: i64 = 2
            Ok(nodes)

pub fn mux_wire_nodes_mux_endpoint_policy_v1(value: MuxEndpointPolicyV1) -> Result<i64, MuxWireErrorV1>:
    match value:
        case MuxEndpointPolicyV1.ExistingOnly:
            var nodes: i64 = 2
            Ok(nodes)
        case MuxEndpointPolicyV1.CreateOwned:
            var nodes: i64 = 2
            Ok(nodes)

pub fn mux_wire_nodes_mux_limits_v1(value: MuxLimitsV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    Ok(nodes)

pub fn mux_wire_nodes_mux_connect_v1(value: MuxConnectV1) -> Result<i64, MuxWireErrorV1>:
    var nodes: i64 = 2
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_backend_v1(value.backend)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_endpoint_policy_v1(value.endpoint_policy)?)?
    nodes = mux_wire_node_sum_v1(nodes, 1)?
    nodes = mux_wire_node_sum_v1(nodes, mux_wire_nodes_mux_limits_v1(value.limits)?)?
    Ok(nodes)

