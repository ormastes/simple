# New binary-framed SDN route, not the legacy Smux line protocol.
use std.common.contracts.mux.core_v1.*
use std.common.contracts.mux.execution_v1.*
use std.common.contracts.mux.observation_v1.*

pub val MUX_WIRE_MAX_FRAME_V1: i64 = 4194304
pub val MUX_WIRE_MIN_FRAME_V1: i64 = 4096
pub val MUX_WIRE_MAX_DEPTH_V1: i64 = 64
pub val MUX_WIRE_MAX_NODES_V1: i64 = 250000

# Static codes only. Never embed peer text, endpoint credentials or pane content.
pub struct MuxWireErrorV1:
    code: text

pub enum MuxWireCallV1:
    Connect(options: MuxConnectV1, deadline: MuxDeadlineV1)
    Query(handle: MuxHandleV1, query: MuxQueryV1, deadline: MuxDeadlineV1)
    Execute(request: MuxRequestV1)
    PollEvents(handle: MuxHandleV1, cursor: u64, limits: MuxEventLimitsV1, deadline: MuxDeadlineV1)
    Disconnect(request: MuxDisconnectRequestV1)

pub enum MuxWireResultV1:
    Connection(connection: MuxConnectionV1)
    Query(result: MuxQueryResultV1)
    Mutation(mutation: MuxMutationV1)
    Events(events: MuxEventBatchV1)
    Disconnect(disconnect: MuxDisconnectV1)

pub enum MuxWireOutcomeV1:
    Success(result: MuxWireResultV1)
    Failure(failure: MuxErrorV1)

pub struct MuxWireRequestV1:
    correlation: u64
    auth_token: text
    call: MuxWireCallV1

pub struct MuxWireResponseV1:
    correlation: u64
    call_tag: text
    outcome: MuxWireOutcomeV1
