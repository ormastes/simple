# Public untrusted wire values. No publisher keys, authenticated flags or private owner state.
use std.common.contracts.distributed_control_v2.ExecutionGrantV2

struct DistributedSignedGrantV2:
    grant: ExecutionGrantV2
    issuer_id: text
    key_revision: i64
    signature: [u8]

struct DistributedSignedApprovalV2:
    approver_id: text
    key_revision: i64
    grant_digest: text
    request_digest: text
    policy_revision: i64
    session_generation: i64
    expires_at: i64
    signature: [u8]

