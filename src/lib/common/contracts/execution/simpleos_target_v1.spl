# Canonical target-native SimpleOS userland values (REQ-002/009/010).
#
# This contract intentionally contains no kernel or OS-port types.  Kernel
# triples remain owned by the platform catalog; consumers that advertise or
# build target-native userland import these values instead of spelling a
# second set of triples, ABIs, or firmware profiles.

pub const SIMPLEOS_TARGET_V1: i64 = 1

pub const SIMPLEOS_TARGET_V1_X86_64_TRIPLE: text = "x86_64-unknown-simpleos"
pub const SIMPLEOS_TARGET_V1_X86_64_ABI: text = "sysv"
pub const SIMPLEOS_TARGET_V1_X86_64_FIRMWARE: text = "LimineBios"

pub const SIMPLEOS_TARGET_V1_I686_TRIPLE: text = "i686-unknown-simpleos"
pub const SIMPLEOS_TARGET_V1_I686_ABI: text = "cdecl"
pub const SIMPLEOS_TARGET_V1_I686_FIRMWARE: text = "LimineBios"

pub const SIMPLEOS_TARGET_V1_AARCH64_TRIPLE: text = "aarch64-unknown-simpleos"
pub const SIMPLEOS_TARGET_V1_AARCH64_ABI: text = "aapcs64"
pub const SIMPLEOS_TARGET_V1_AARCH64_FIRMWARE: text = "RawLoader"

pub const SIMPLEOS_TARGET_V1_ARMV7_TRIPLE: text = "armv7-unknown-simpleos"
pub const SIMPLEOS_TARGET_V1_ARMV7_ABI: text = "eabihf"
pub const SIMPLEOS_TARGET_V1_ARMV7_FIRMWARE: text = "RawLoader"

pub const SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE: text = "riscv64gc-unknown-simpleos"
pub const SIMPLEOS_TARGET_V1_RISCV64GC_ABI: text = "lp64d"
pub const SIMPLEOS_TARGET_V1_RISCV64GC_FIRMWARE: text = "OpenSbi"

pub const SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE: text = "riscv32imac-unknown-simpleos"
pub const SIMPLEOS_TARGET_V1_RISCV32IMAC_ABI: text = "ilp32"
pub const SIMPLEOS_TARGET_V1_RISCV32IMAC_FIRMWARE: text = "OpenSbi"

pub fn simpleos_target_v1_is_userland_triple(target: text) -> bool:
    target == SIMPLEOS_TARGET_V1_X86_64_TRIPLE or
        target == SIMPLEOS_TARGET_V1_I686_TRIPLE or
        target == SIMPLEOS_TARGET_V1_AARCH64_TRIPLE or
        target == SIMPLEOS_TARGET_V1_ARMV7_TRIPLE or
        target == SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE or
        target == SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE

pub fn simpleos_target_v1_abi_for_triple(target: text) -> text:
    if target == SIMPLEOS_TARGET_V1_X86_64_TRIPLE:
        return SIMPLEOS_TARGET_V1_X86_64_ABI
    if target == SIMPLEOS_TARGET_V1_I686_TRIPLE:
        return SIMPLEOS_TARGET_V1_I686_ABI
    if target == SIMPLEOS_TARGET_V1_AARCH64_TRIPLE:
        return SIMPLEOS_TARGET_V1_AARCH64_ABI
    if target == SIMPLEOS_TARGET_V1_ARMV7_TRIPLE:
        return SIMPLEOS_TARGET_V1_ARMV7_ABI
    if target == SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE:
        return SIMPLEOS_TARGET_V1_RISCV64GC_ABI
    if target == SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE:
        return SIMPLEOS_TARGET_V1_RISCV32IMAC_ABI
    ""

pub fn simpleos_target_v1_firmware_for_triple(target: text) -> text:
    if target == SIMPLEOS_TARGET_V1_X86_64_TRIPLE:
        return SIMPLEOS_TARGET_V1_X86_64_FIRMWARE
    if target == SIMPLEOS_TARGET_V1_I686_TRIPLE:
        return SIMPLEOS_TARGET_V1_I686_FIRMWARE
    if target == SIMPLEOS_TARGET_V1_AARCH64_TRIPLE:
        return SIMPLEOS_TARGET_V1_AARCH64_FIRMWARE
    if target == SIMPLEOS_TARGET_V1_ARMV7_TRIPLE:
        return SIMPLEOS_TARGET_V1_ARMV7_FIRMWARE
    if target == SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE:
        return SIMPLEOS_TARGET_V1_RISCV64GC_FIRMWARE
    if target == SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE:
        return SIMPLEOS_TARGET_V1_RISCV32IMAC_FIRMWARE
    ""

pub fn simpleos_target_v1_canonical_triples() -> [text]:
    [
        SIMPLEOS_TARGET_V1_X86_64_TRIPLE,
        SIMPLEOS_TARGET_V1_I686_TRIPLE,
        SIMPLEOS_TARGET_V1_AARCH64_TRIPLE,
        SIMPLEOS_TARGET_V1_ARMV7_TRIPLE,
        SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE,
        SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE
    ]

export simpleos_target_v1_is_userland_triple
export simpleos_target_v1_abi_for_triple, simpleos_target_v1_firmware_for_triple
export simpleos_target_v1_canonical_triples
export SIMPLEOS_TARGET_V1
export SIMPLEOS_TARGET_V1_X86_64_TRIPLE, SIMPLEOS_TARGET_V1_X86_64_ABI
export SIMPLEOS_TARGET_V1_X86_64_FIRMWARE
export SIMPLEOS_TARGET_V1_I686_TRIPLE, SIMPLEOS_TARGET_V1_I686_ABI
export SIMPLEOS_TARGET_V1_I686_FIRMWARE
export SIMPLEOS_TARGET_V1_AARCH64_TRIPLE, SIMPLEOS_TARGET_V1_AARCH64_ABI
export SIMPLEOS_TARGET_V1_AARCH64_FIRMWARE
export SIMPLEOS_TARGET_V1_ARMV7_TRIPLE, SIMPLEOS_TARGET_V1_ARMV7_ABI
export SIMPLEOS_TARGET_V1_ARMV7_FIRMWARE
export SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE, SIMPLEOS_TARGET_V1_RISCV64GC_ABI
export SIMPLEOS_TARGET_V1_RISCV64GC_FIRMWARE
export SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE, SIMPLEOS_TARGET_V1_RISCV32IMAC_ABI
export SIMPLEOS_TARGET_V1_RISCV32IMAC_FIRMWARE
