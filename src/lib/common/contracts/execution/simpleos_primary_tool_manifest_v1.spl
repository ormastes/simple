# Closed, declaration-only primary userland tool profile (REQ-011).
# This module intentionally contains no source-tree discovery or runtime probes.

use common.contracts.execution.simpleos_tool_inventory_v1.{
    SimpleOsToolStatus, SimpleOsToolInventoryEntry, SIMPLEOS_TOOL_INVENTORY_V1,
    SIMPLEOS_TOOL_FULL_PROFILE
}
use common.contracts.execution.simpleos_target_v1.{
    simpleos_target_v1_canonical_triples
}

pub const SIMPLEOS_PRIMARY_TOOL_MANIFEST_V1: i64 = 1
pub const SIMPLEOS_PRIMARY_TOOL_RECEIPT_CONTRACT_V1: text =
    "ed25519:common.contracts.execution.simpleos_primary_tool_receipt_v1"

fn category_blocked(name: text, category: text) -> SimpleOsToolInventoryEntry:
    SimpleOsToolInventoryEntry(
        schema_version: SIMPLEOS_TOOL_INVENTORY_V1,
        profile: SIMPLEOS_TOOL_FULL_PROFILE,
        status: SimpleOsToolStatus.Blocked,
        canonical_name: name,
        source_owner: "os.tools.primary_userland_host",
        artifact_path: "",
        artifact_digest: "",
        capabilities: [category, "bounded-read-only-inspection"],
        target_triples: simpleos_target_v1_canonical_triples(),
        filesystems: ["FAT32", "DBFS", "NVFS"],
        version_contract: "{name} --version emits SimpleOS primary tools 1.0",
        help_contract: "{name} --help emits bounded read-only usage",
        operation_behavior_id: "{name}-bounded-host-snapshot-inspection-v1",
        error_behavior_id: "{name}-external-action-unsupported-v1",
        evidence_receipt_ids: [],
        blocker: "mutation and external I/O require a host capability provider"
    )

fn checksum_blocked(name: text) -> SimpleOsToolInventoryEntry:
    SimpleOsToolInventoryEntry(
        schema_version: SIMPLEOS_TOOL_INVENTORY_V1,
        profile: SIMPLEOS_TOOL_FULL_PROFILE,
        status: SimpleOsToolStatus.Blocked,
        canonical_name: name,
        source_owner: "os.tools.shell.checksum.checksum_tool",
        artifact_path: "/usr/bin/{name}",
        artifact_digest: "",
        capabilities: ["checksums", name],
        target_triples: simpleos_target_v1_canonical_triples(),
        filesystems: ["FAT32", "DBFS", "NVFS"],
        version_contract: "{name} --version emits SimpleOS core tools 1.0",
        help_contract: "{name} --help emits bounded FILE usage",
        operation_behavior_id: "{name}-file-cryptographic-digest-v1",
        error_behavior_id: "{name}-bounded-input-error-v1",
        evidence_receipt_ids: [],
        blocker: "simpleos-primary-checksum-target-execution-evidence-unavailable"
    )

fn text_blocked() -> SimpleOsToolInventoryEntry:
    SimpleOsToolInventoryEntry(
        schema_version: SIMPLEOS_TOOL_INVENTORY_V1,
        profile: SIMPLEOS_TOOL_FULL_PROFILE,
        status: SimpleOsToolStatus.Blocked,
        canonical_name: "grep",
        source_owner: "os.tools.shell.grep.grep_tool",
        artifact_path: "/usr/bin/grep",
        artifact_digest: "",
        capabilities: ["text-processing", "grep"],
        target_triples: simpleos_target_v1_canonical_triples(),
        filesystems: ["FAT32", "DBFS", "NVFS"],
        version_contract: "grep --version emits SimpleOS text tools 1.0",
        help_contract: "grep --help emits bounded PATTERN and FILE usage",
        operation_behavior_id: "grep-bounded-line-search-v1",
        error_behavior_id: "grep-bounded-input-error-v1",
        evidence_receipt_ids: [],
        blocker: "simpleos-primary-text-target-execution-evidence-unavailable"
    )

fn process_blocked() -> SimpleOsToolInventoryEntry:
    SimpleOsToolInventoryEntry(
        schema_version: SIMPLEOS_TOOL_INVENTORY_V1,
        profile: SIMPLEOS_TOOL_FULL_PROFILE,
        status: SimpleOsToolStatus.Blocked,
        canonical_name: "ps",
        source_owner: "os.tools.proc.ps_tool",
        artifact_path: "/usr/bin/ps",
        artifact_digest: "",
        capabilities: ["process-monitoring", "ps"],
        target_triples: simpleos_target_v1_canonical_triples(),
        filesystems: ["FAT32", "DBFS", "NVFS"],
        version_contract: "ps --version emits SimpleOS core tools 1.0",
        help_contract: "ps --help emits usage",
        operation_behavior_id: "process-list-tasks-v1",
        error_behavior_id: "process-list-tasks-error-v1",
        evidence_receipt_ids: [],
        blocker: "simpleos-primary-process-target-artifact-loader-unavailable")

pub fn simpleos_primary_tool_manifest_v1() -> [SimpleOsToolInventoryEntry]:
    [
        category_blocked("admin", "administration"),
        category_blocked("archive", "archive-compression"),
        category_blocked("network", "networking"),
        checksum_blocked("sha256sum"),
        checksum_blocked("md5sum"),
        text_blocked(),
        process_blocked(),
        category_blocked("package", "package-management")
    ]

pub fn simpleos_primary_tool_manifest_v1_is_closed(name: text) -> bool:
    for entry in simpleos_primary_tool_manifest_v1():
        if entry.canonical_name == name:
            return true
    false

export simpleos_primary_tool_manifest_v1, simpleos_primary_tool_manifest_v1_is_closed
export SIMPLEOS_PRIMARY_TOOL_MANIFEST_V1
export SIMPLEOS_PRIMARY_TOOL_RECEIPT_CONTRACT_V1
