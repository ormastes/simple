# SimpleOS executable manifest value contracts.
#
# This module owns the dependency-free value representation shared by startup,
# the kernel loader, and filesystem admission code. Policy, hashing,
# capability intersection, and target validation remain in the loader layer;
# common must not depend upward on `os.*` modules.
#
# The on-disk representation remains the existing LaunchMetadata descriptor and
# its sidecar/SMF/native trailer. These structs are its common typed projection,
# not a second manifest format.

pub struct ManifestTarget:
    """A target triple. `any` is an explicit wildcard; empty never matches."""
    os: text
    arch: text
    abi: text

pub struct ManifestResourceLimits:
    """Hard process ceilings; zero means the manifest has no opinion."""
    max_memory_bytes: i64
    max_open_handles: i64
    max_threads: i64
    cpu_budget_us: i64

pub struct ManifestArgument:
    """One declared startup argument accepted by the generated parser."""
    name: text
    value_kind: text
    required: bool
    default_value: text

pub struct ManifestPreload:
    """One declared startup preload; undeclared paths are never scanned."""
    source_arg: text
    fixed_path: text
    mode: text
    required: bool
    maximum_bytes: i64
    access: text
    prefault: bool
    hash_policy: text

pub struct ManifestCheck:
    """Plain validation outcome used by the loader policy adapter."""
    ok: bool
    reason: text

pub struct SimpleArtifactManifest:
    """The single SimpleOS executable descriptor value."""
    format_version: i64
    artifact_kind: text
    target: ManifestTarget
    entrypoint: text
    required_abi_features: [text]
    required_services: [text]
    required_capabilities: u32
    resource_limits: ManifestResourceLimits
    namespace_template: text
    native_libraries: [text]
    smf_libraries: [text]
    interpreter: text
    argument_schema: [ManifestArgument]
    startup_preloads: [ManifestPreload]
    content_hashes: [text]
    signature: text
    debug_identity: text
