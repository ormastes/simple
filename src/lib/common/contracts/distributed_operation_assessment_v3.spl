# Bounded non-authorizing observations. No native owner/ticket or expiry grant.
use std.common.contracts.distributed_operation_state_v2.DistributedOperationStateV2
use std.common.build_manager.contracts.builder_identifier_valid_v1

pub struct DistributedOperationAssessmentRequestV3:
    operation_ids: [text]

pub struct DistributedOperationAssessmentRecordV3:
    relative: text
    operation_id: text
    status: text
    payload: text
    reason: text

pub struct DistributedOperationAssessmentSnapshotV3:
    authority_digest: text
    revision: text
    sequence: i64
    operations: Dict<text, DistributedOperationStateV2>
    missing_operation_ids: [text]
    records: [DistributedOperationAssessmentRecordV3]

# Native text < can compare addresses. Select IDs by explicit UTF-8 order.
pub fn operation_assessment_id_before_v3(a: text, b: text) -> bool:
    var at = 0
    while at < a.byte_len() and at < b.byte_len():
        if a.byte_at(at) < b.byte_at(at): return true
        if a.byte_at(at) > b.byte_at(at): return false
        at = at + 1
    a.byte_len() < b.byte_len()

pub fn operation_assessment_request_validate_v3(request: DistributedOperationAssessmentRequestV3) -> Result<bool, text>:
    if request.operation_ids.len() > 4: return Err("OPERATION_ASSESSMENT_ID_LIMIT")
    var previous = ""
    for id in request.operation_ids:
        if not builder_identifier_valid_v1(id): return Err("OPERATION_ASSESSMENT_ID_INVALID")
        if not operation_assessment_id_before_v3(previous, id):
            return Err("OPERATION_ASSESSMENT_ID_ORDER_INVALID")
        previous = id
    Ok(true)
