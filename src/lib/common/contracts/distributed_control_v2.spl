# Shared value contracts for Caret, builder and CI admission.
# A validated value is not an authenticated identity or an OS sandbox.
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}

struct ExecutionEnvironmentV2:
    host_id: text
    execution_platform: text
    target_platform: text
    test_runtime: text
    isolation_class: text
    toolchain_digest: text
    sdk_digest: text
    abi: text
    isa: text
    optimization: text

struct ExecutionGrantV2:
    id: text
    principal: text
    project: text
    host_id: text
    operations: [text]
    environment_digest: text
    policy_revision: i64
    revocation_epoch: i64
    expires_at: i64
    maximum_memory_bytes: i64
    maximum_duration_ms: i64

struct OperationEnvelopeV2:
    version: i64
    id: text
    payload_digest: text
    principal: text
    project: text
    host_id: text
    operation: text
    environment_digest: text
    policy_revision: i64
    revocation_epoch: i64
    session_generation: i64
    memory_bytes: i64
    duration_ms: i64

fn distributed_environment_validate_v2(value: ExecutionEnvironmentV2) -> text:
    if not builder_identifier_valid_v1(value.host_id):
        return "ENV_HOST_INVALID"
    if not builder_identifier_valid_v1(value.execution_platform) or
            not builder_identifier_valid_v1(value.target_platform) or
            not builder_identifier_valid_v1(value.test_runtime):
        return "ENV_PLATFORM_INVALID"
    if value.isolation_class != "native-process" and value.isolation_class != "native-container" and
            value.isolation_class != "sandbox" and value.isolation_class != "vm" and
            value.isolation_class != "emulated":
        return "ENV_ISOLATION_INVALID"
    if not builder_digest_valid_v1(value.toolchain_digest) or not builder_digest_valid_v1(value.sdk_digest):
        return "ENV_DIGEST_INVALID"
    if not builder_identifier_valid_v1(value.abi) or not builder_identifier_valid_v1(value.isa) or
            not builder_identifier_valid_v1(value.optimization):
        return "ENV_CONFIGURATION_INVALID"
    ""

# Match every requested dimension; a cross-target build is not a native test.
fn distributed_environment_match_v2(requested: ExecutionEnvironmentV2, observed: ExecutionEnvironmentV2) -> text:
    val request_error = distributed_environment_validate_v2(requested)
    if request_error != "":
        return request_error
    val observed_error = distributed_environment_validate_v2(observed)
    if observed_error != "":
        return observed_error
    if requested.host_id != observed.host_id:
        return "ENV_NO_MATCH_HOST"
    if requested.execution_platform != observed.execution_platform:
        return "ENV_NO_MATCH_EXECUTION"
    if requested.target_platform != observed.target_platform:
        return "ENV_NO_MATCH_TARGET"
    if requested.test_runtime != observed.test_runtime:
        return "ENV_NO_MATCH_TEST_RUNTIME"
    if requested.isolation_class != observed.isolation_class:
        return "ENV_NO_MATCH_ISOLATION"
    if requested.toolchain_digest != observed.toolchain_digest:
        return "ENV_NO_MATCH_TOOLCHAIN"
    if requested.sdk_digest != observed.sdk_digest:
        return "ENV_NO_MATCH_SDK"
    if requested.abi != observed.abi:
        return "ENV_NO_MATCH_ABI"
    if requested.isa != observed.isa:
        return "ENV_NO_MATCH_ISA"
    if requested.optimization != observed.optimization:
        return "ENV_NO_MATCH_OPTIMIZATION"
    ""

# Caller authentication and durable operation admission are separate owners.
# This function checks a trusted grant against the exact requested values.
fn distributed_grant_authorize_v2(grant: ExecutionGrantV2, request: OperationEnvelopeV2,
        now: i64, current_policy_revision: i64, current_revocation_epoch: i64,
        current_session_generation: i64) -> text:
    if request.version != 2:
        return "VERSION_UNSUPPORTED"
    if not builder_identifier_valid_v1(grant.id) or not builder_identifier_valid_v1(request.id):
        return "IDENTITY_INVALID"
    if not builder_identifier_valid_v1(grant.principal) or not builder_identifier_valid_v1(grant.project) or
            not builder_identifier_valid_v1(grant.host_id) or not builder_identifier_valid_v1(request.operation):
        return "SCOPE_INVALID"
    if not builder_digest_valid_v1(request.payload_digest) or
            not builder_digest_valid_v1(request.environment_digest) or
            not builder_digest_valid_v1(grant.environment_digest):
        return "DIGEST_INVALID"
    if now < 0 or grant.expires_at <= now:
        return "GRANT_EXPIRED"
    if current_policy_revision <= 0 or grant.policy_revision != current_policy_revision or
            request.policy_revision != current_policy_revision:
        return "POLICY_STALE"
    if current_revocation_epoch < 0 or grant.revocation_epoch != current_revocation_epoch or
            request.revocation_epoch != current_revocation_epoch:
        return "GRANT_REVOKED"
    if current_session_generation <= 0 or request.session_generation != current_session_generation:
        return "SESSION_STALE"
    if request.principal != grant.principal or request.project != grant.project or request.host_id != grant.host_id:
        return "SCOPE_DENIED"
    if request.environment_digest != grant.environment_digest:
        return "ENVIRONMENT_DENIED"
    if grant.operations.len() == 0 or grant.operations.len() > 64:
        return "OPERATIONS_INVALID"
    var allowed = false
    for operation in grant.operations:
        if not builder_identifier_valid_v1(operation):
            return "OPERATIONS_INVALID"
        if operation == request.operation:
            allowed = true
    if not allowed:
        return "OPERATION_DENIED"
    if grant.maximum_memory_bytes <= 0 or grant.maximum_duration_ms <= 0 or
            request.memory_bytes <= 0 or request.duration_ms <= 0:
        return "BUDGET_INVALID"
    if request.memory_bytes > grant.maximum_memory_bytes or request.duration_ms > grant.maximum_duration_ms:
        return "BUDGET_EXCEEDED"
    ""
