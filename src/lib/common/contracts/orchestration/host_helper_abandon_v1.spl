# Controller-signed abandon of ONE charged V4 attach-broker helper row (milestone_0036, owner decision 2026-11-19: operator
# path beside the deadline reap). Twin of `service-handoff-abandon`: the record is DATA bound to a signed `helper-abandon`
# operation; it names the exact helper operation, its journal-derived request/receipt digests and the marker state the
# operator observed, and attests (in the signed bytes) that no native custody remains. It grants nothing by itself: the
# service verifies it, records it and only then releases the Host helper charge. Exactly one wire version is accepted.
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2, distributed_decode_operation_v2}
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_authority_codec_v2.*
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.common.crypto.sha256.sha256_text
use std.common.string_core.str_len
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1

pub val HOST_HELPER_ABANDON_WIRE_V1: text = "helper-abandon-v1"
pub val HOST_HELPER_ABANDON_OPERATION_V1: text = "helper-abandon"
pub val HOST_HELPER_ABANDON_CUSTODY_V1: text = "operator-attests-native-custody-gone"

pub struct HostHelperAbandonV1:
    wire_version: text
    # The charged helper row (NOT this command's own operation id) and the digests the service re-derives from its journal.
    operation_id: text
    operation_digest: text
    request_digest: text
    prepared_receipt_digest: text
    # Canonical marker text the operator saw (`state=..;pc=..;...;store=..`): the command voids only that state.
    observed: text
    custody: text
    physical_host_id: text

pub struct HostHelperAbandonProofV1:
    abandon: HostHelperAbandonV1
    operation: OperationEnvelopeV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

fn helper_abandon_fields_v1(source: text, maximum: i64, names: [text]) -> Result<Dict<text, SdnValue>, text>:
    if str_len(source) == 0 or str_len(source) > maximum: return Err("helper-abandon-source-size")
    val limits = SdnStrictLimitsV1(max_source_bytes: maximum, max_depth: 2, max_nodes: 24, max_rows: 0, max_cells: 0, max_columns: 12)
    val parsed = match sdn_parse_strict_v1(source, limits):
        case Ok(value): value
        case Err(issue): return Err("helper-abandon-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("helper-abandon-object-required")
    for key in fields.keys():
        if not names.contains(key): return Err("helper-abandon-unknown-field:" + key)
    for key in names:
        if not fields.contains_key(key): return Err("helper-abandon-missing-field:" + key)
    Ok(fields)

fn helper_abandon_text_v1(fields: Dict<text, SdnValue>, key: text) -> Result<text, text>:
    match fields[key]:
        case SdnValue.String(value): Ok(value)
        case _: Err("helper-abandon-text-required:" + key)

fn helper_abandon_integer_v1(fields: Dict<text, SdnValue>, key: text) -> Result<i64, text>:
    match fields[key]:
        case SdnValue.Int(value): Ok(value)
        case _: Err("helper-abandon-integer-required:" + key)

# Marker text grammar: lowercase letters, digits, `=`, `;`, `-`, `?`; bounded.
fn helper_abandon_observed_valid_v1(observed: text) -> bool:
    if str_len(observed) == 0 or str_len(observed) > 256: return false
    for index in 0..observed.byte_len():
        val byte = observed.byte_at(index) as i64
        val lower = byte >= 97 and byte <= 122
        val digit = byte >= 48 and byte <= 57
        if not (lower or digit or byte == 61 or byte == 59 or byte == 45 or byte == 63): return false
    true

pub fn host_helper_abandon_bytes_v1(abandon: HostHelperAbandonV1) -> Result<text, text>:
    if abandon.wire_version != HOST_HELPER_ABANDON_WIRE_V1: return Err("helper-abandon-version-unsupported")
    if (not builder_identifier_valid_v1(abandon.operation_id) or not builder_identifier_valid_v1(abandon.physical_host_id) or
            not builder_digest_valid_v1(abandon.operation_digest) or not builder_digest_valid_v1(abandon.request_digest) or
            not builder_digest_valid_v1(abandon.prepared_receipt_digest) or abandon.custody != HOST_HELPER_ABANDON_CUSTODY_V1 or
            not helper_abandon_observed_valid_v1(abandon.observed)):
        return Err("helper-abandon-value-invalid")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("helper-abandon"),
        "wireVersion": SdnValue.String(abandon.wire_version), "operationId": SdnValue.String(abandon.operation_id),
        "operationDigest": SdnValue.String(abandon.operation_digest), "requestDigest": SdnValue.String(abandon.request_digest),
        "preparedReceiptDigest": SdnValue.String(abandon.prepared_receipt_digest), "observed": SdnValue.String(abandon.observed),
        "custody": SdnValue.String(abandon.custody), "physicalHostId": SdnValue.String(abandon.physical_host_id)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(source) > 4096: return Err("helper-abandon-source-size")
    Ok(source)

pub fn host_helper_abandon_digest_v1(abandon: HostHelperAbandonV1) -> Result<text, text>:
    Ok(sha256_text(host_helper_abandon_bytes_v1(abandon)?))

pub fn host_helper_abandon_decode_v1(source: text) -> Result<HostHelperAbandonV1, text>:
    val fields = helper_abandon_fields_v1(source, 4096, ["version", "kind", "wireVersion", "operationId", "operationDigest",
        "requestDigest", "preparedReceiptDigest", "observed", "custody", "physicalHostId"])?
    if helper_abandon_integer_v1(fields, "version")? != 1: return Err("helper-abandon-version-unsupported")
    if helper_abandon_text_v1(fields, "kind")? != "helper-abandon": return Err("helper-abandon-version-unsupported")
    val abandon = HostHelperAbandonV1(wire_version: helper_abandon_text_v1(fields, "wireVersion")?,
        operation_id: helper_abandon_text_v1(fields, "operationId")?, operation_digest: helper_abandon_text_v1(fields, "operationDigest")?,
        request_digest: helper_abandon_text_v1(fields, "requestDigest")?,
        prepared_receipt_digest: helper_abandon_text_v1(fields, "preparedReceiptDigest")?,
        observed: helper_abandon_text_v1(fields, "observed")?, custody: helper_abandon_text_v1(fields, "custody")?,
        physical_host_id: helper_abandon_text_v1(fields, "physicalHostId")?)
    if host_helper_abandon_bytes_v1(abandon)? != source: return Err("helper-abandon-noncanonical")
    Ok(abandon)

# The signed envelope must be the `helper-abandon` kind, name this exact record by digest, and be for this host.
pub fn host_helper_abandon_match_v1(abandon: HostHelperAbandonV1, operation: OperationEnvelopeV2) -> Result<bool, text>:
    val _canonical = distributed_encode_operation_v2(operation)?
    if (operation.operation != HOST_HELPER_ABANDON_OPERATION_V1 or
            operation.payload_digest != host_helper_abandon_digest_v1(abandon)? or
            not builder_identifier_valid_v1(operation.id) or operation.host_id != abandon.physical_host_id):
        return Err("helper-abandon-operation-mismatch")
    Ok(true)

pub fn host_helper_abandon_proof_encode_v1(proof: HostHelperAbandonProofV1) -> Result<text, text>:
    val _matched = host_helper_abandon_match_v1(proof.abandon, proof.operation)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("helper-abandon-proof"),
        "abandon": SdnValue.String(host_helper_abandon_bytes_v1(proof.abandon)?),
        "operation": SdnValue.String(distributed_encode_operation_v2(proof.operation)?),
        "signedGrant": SdnValue.String(distributed_encode_signed_grant_v2(proof.signed)?),
        "signedApproval": SdnValue.String(distributed_encode_signed_approval_v2(proof.approval)?)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(source) > 262144: return Err("helper-abandon-proof-size")
    Ok(source)

pub fn host_helper_abandon_proof_decode_v1(source: text) -> Result<HostHelperAbandonProofV1, text>:
    val fields = helper_abandon_fields_v1(source, 262144, ["version", "kind", "abandon", "operation", "signedGrant", "signedApproval"])?
    if helper_abandon_integer_v1(fields, "version")? != 1: return Err("helper-abandon-version-unsupported")
    if helper_abandon_text_v1(fields, "kind")? != "helper-abandon-proof": return Err("helper-abandon-version-unsupported")
    val proof = HostHelperAbandonProofV1(abandon: host_helper_abandon_decode_v1(helper_abandon_text_v1(fields, "abandon")?)?,
        operation: distributed_decode_operation_v2(helper_abandon_text_v1(fields, "operation")?)?,
        signed: distributed_decode_signed_grant_v2(helper_abandon_text_v1(fields, "signedGrant")?)?,
        approval: distributed_decode_signed_approval_v2(helper_abandon_text_v1(fields, "signedApproval")?)?)
    if host_helper_abandon_proof_encode_v1(proof)? != source: return Err("helper-abandon-proof-noncanonical")
    Ok(proof)
