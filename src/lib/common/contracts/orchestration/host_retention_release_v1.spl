# Controller-signed release of ONE remote build's retained workspace (milestone_0045, owner decision 2, 2026-11-19).
# The record is DATA bound to a signed `retention-release` operation. Its Host part names the build row, its association
# digest and the Host's own settled evidence of that run (the archived outcome record, or the reap record), all of which
# the Host re-derives from its journal; its controller part is the controller's TERMINAL state of the same run (completed,
# failed or cancelled; `outcome-unknown` must first be abandoned to `failed`) with the digests of the controller row and
# outcome. The Host part alone (no controller state) never matches a signed operation. It grants nothing by itself: the
# Host verifies it, records it, and only then deletes the run's own workspace tree (milestone_0047). One wire version is accepted.
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2, distributed_decode_operation_v2}
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_authority_codec_v2.*
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.common.crypto.sha256.sha256_text
use std.common.string_core.str_len
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1

pub val HOST_RETENTION_RELEASE_WIRE_V1: text = "retention-release-v1"
val HOST_RETENTION_RELEASE_OPERATION_V1: text = "retention-release"
pub val HOST_RETENTION_RELEASE_STATES_V1: [text] = ["completed", "failed", "cancelled"]
val HOST_RETENTION_RELEASE_EVIDENCE_V1: [text] = ["outcome", "reaped"]
# Per run since milestone_0047 (owner decision 1): a release deletes ONLY the run's own child of the provisioned leaf; the
# leaf, its XFS project quota and native lease stay retained.
# run-removed: the run child and its tree were removed (removed >= 1, the child included); used_* are the provisioned
# project's remaining usage observed afterwards (shared by every retained run child, so not zero in general).
# absent-unmeasured (owner decision 2, unchanged): a resumed release found the run child already absent (a crash removed
# it before the archive); nothing was counted or measured.

pub struct HostRetentionReleaseV1:
    wire_version: text
    operation_id: text
    association_digest: text
    evidence: text
    evidence_digest: text
    physical_host_id: text
    controller_state: text = ""
    controller_row_digest: text = ""
    controller_outcome_digest: text = ""

pub struct HostRetentionReleaseProofV1:
    release: HostRetentionReleaseV1
    operation: OperationEnvelopeV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

# Effect facts of one release (DATA). used_* are -1 and removed is -1 only for absent-unmeasured.
pub struct HostRetentionReleaseEffectV1:
    charge: text
    used_bytes: i64
    used_inodes: i64
    removed: i64

pub struct HostRetentionReleasedV1:
    operation_id: text
    marker_digest: text
    charge: text
    used_bytes: i64
    used_inodes: i64
    removed: i64
    released_at_ms: i64

fn retention_fields_v1(source: text, maximum: i64, names: [text]) -> Result<Dict<text, SdnValue>, text>:
    if str_len(source) == 0 or str_len(source) > maximum: return Err("retention-release-source-size")
    val limits = SdnStrictLimitsV1(max_source_bytes: maximum, max_depth: 2, max_nodes: 24, max_rows: 0, max_cells: 0, max_columns: 12)
    val parsed = match sdn_parse_strict_v1(source, limits):
        case Ok(value): value
        case Err(issue): return Err("retention-release-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("retention-release-object-required")
    for key in fields.keys():
        if not names.contains(key): return Err("retention-release-unknown-field:" + key)
    for key in names:
        if not fields.contains_key(key): return Err("retention-release-missing-field:" + key)
    Ok(fields)

fn retention_text_v1(fields: Dict<text, SdnValue>, key: text) -> Result<text, text>:
    match fields[key]:
        case SdnValue.String(value): Ok(value)
        case _: Err("retention-release-text-required:" + key)

fn retention_integer_v1(fields: Dict<text, SdnValue>, key: text) -> Result<i64, text>:
    match fields[key]:
        case SdnValue.Int(value): Ok(value)
        case _: Err("retention-release-integer-required:" + key)

fn retention_controller_valid_v1(release: HostRetentionReleaseV1) -> bool:
    if release.controller_state == "":
        return release.controller_row_digest == "" and release.controller_outcome_digest == ""
    HOST_RETENTION_RELEASE_STATES_V1.contains(release.controller_state) and
        builder_digest_valid_v1(release.controller_row_digest) and builder_digest_valid_v1(release.controller_outcome_digest)

pub fn host_retention_release_bytes_v1(release: HostRetentionReleaseV1) -> Result<text, text>:
    if release.wire_version != HOST_RETENTION_RELEASE_WIRE_V1: return Err("retention-release-version-unsupported")
    if (not builder_identifier_valid_v1(release.operation_id) or not builder_identifier_valid_v1(release.physical_host_id) or
            not builder_digest_valid_v1(release.association_digest) or not builder_digest_valid_v1(release.evidence_digest) or
            not HOST_RETENTION_RELEASE_EVIDENCE_V1.contains(release.evidence) or not retention_controller_valid_v1(release)):
        return Err("retention-release-value-invalid")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("retention-release"),
        "wireVersion": SdnValue.String(release.wire_version), "operationId": SdnValue.String(release.operation_id),
        "associationDigest": SdnValue.String(release.association_digest), "evidence": SdnValue.String(release.evidence),
        "evidenceDigest": SdnValue.String(release.evidence_digest), "physicalHostId": SdnValue.String(release.physical_host_id),
        "controllerState": SdnValue.String(release.controller_state),
        "controllerRowDigest": SdnValue.String(release.controller_row_digest),
        "controllerOutcomeDigest": SdnValue.String(release.controller_outcome_digest)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(source) > 4096: return Err("retention-release-source-size")
    Ok(source)

pub fn host_retention_release_digest_v1(release: HostRetentionReleaseV1) -> Result<text, text>:
    Ok(sha256_text(host_retention_release_bytes_v1(release)?))

pub fn host_retention_release_decode_v1(source: text) -> Result<HostRetentionReleaseV1, text>:
    val fields = retention_fields_v1(source, 4096, ["version", "kind", "wireVersion", "operationId", "associationDigest",
        "evidence", "evidenceDigest", "physicalHostId", "controllerState", "controllerRowDigest", "controllerOutcomeDigest"])?
    if retention_integer_v1(fields, "version")? != 1: return Err("retention-release-version-unsupported")
    if retention_text_v1(fields, "kind")? != "retention-release": return Err("retention-release-version-unsupported")
    val release = HostRetentionReleaseV1(wire_version: retention_text_v1(fields, "wireVersion")?,
        operation_id: retention_text_v1(fields, "operationId")?, association_digest: retention_text_v1(fields, "associationDigest")?,
        evidence: retention_text_v1(fields, "evidence")?, evidence_digest: retention_text_v1(fields, "evidenceDigest")?,
        physical_host_id: retention_text_v1(fields, "physicalHostId")?, controller_state: retention_text_v1(fields, "controllerState")?,
        controller_row_digest: retention_text_v1(fields, "controllerRowDigest")?,
        controller_outcome_digest: retention_text_v1(fields, "controllerOutcomeDigest")?)
    if host_retention_release_bytes_v1(release)? != source: return Err("retention-release-noncanonical")
    Ok(release)

# The signed envelope must be the `retention-release` kind, name this exact FULL record (controller terminal state
# included) by digest, and be for this host.
pub fn host_retention_release_match_v1(release: HostRetentionReleaseV1, operation: OperationEnvelopeV2) -> Result<bool, text>:
    val _canonical = distributed_encode_operation_v2(operation)?
    if release.controller_state == "": return Err("retention-release-controller-unsettled")
    if (operation.operation != HOST_RETENTION_RELEASE_OPERATION_V1 or
            operation.payload_digest != host_retention_release_digest_v1(release)? or
            not builder_identifier_valid_v1(operation.id) or operation.host_id != release.physical_host_id):
        return Err("retention-release-operation-mismatch")
    Ok(true)

pub fn host_retention_release_proof_encode_v1(proof: HostRetentionReleaseProofV1) -> Result<text, text>:
    val _matched = host_retention_release_match_v1(proof.release, proof.operation)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("retention-release-proof"),
        "release": SdnValue.String(host_retention_release_bytes_v1(proof.release)?),
        "operation": SdnValue.String(distributed_encode_operation_v2(proof.operation)?),
        "signedGrant": SdnValue.String(distributed_encode_signed_grant_v2(proof.signed)?),
        "signedApproval": SdnValue.String(distributed_encode_signed_approval_v2(proof.approval)?)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(source) > 262144: return Err("retention-release-proof-size")
    Ok(source)

pub fn host_retention_release_proof_decode_v1(source: text) -> Result<HostRetentionReleaseProofV1, text>:
    val fields = retention_fields_v1(source, 262144, ["version", "kind", "release", "operation", "signedGrant", "signedApproval"])?
    if retention_integer_v1(fields, "version")? != 1: return Err("retention-release-version-unsupported")
    if retention_text_v1(fields, "kind")? != "retention-release-proof": return Err("retention-release-version-unsupported")
    val proof = HostRetentionReleaseProofV1(release: host_retention_release_decode_v1(retention_text_v1(fields, "release")?)?,
        operation: distributed_decode_operation_v2(retention_text_v1(fields, "operation")?)?,
        signed: distributed_decode_signed_grant_v2(retention_text_v1(fields, "signedGrant")?)?,
        approval: distributed_decode_signed_approval_v2(retention_text_v1(fields, "signedApproval")?)?)
    if host_retention_release_proof_encode_v1(proof)? != source: return Err("retention-release-proof-noncanonical")
    Ok(proof)

fn retention_effect_valid_v1(effect: HostRetentionReleaseEffectV1) -> bool:
    if effect.charge == "run-removed": return effect.used_bytes >= 0 and effect.used_inodes >= 0 and effect.removed >= 1
    if effect.charge == "absent-unmeasured": return effect.used_bytes == -1 and effect.used_inodes == -1 and effect.removed == -1
    false

pub fn host_retention_released_bytes_v1(released: HostRetentionReleasedV1) -> Result<text, text>:
    val effect = HostRetentionReleaseEffectV1(charge: released.charge, used_bytes: released.used_bytes,
        used_inodes: released.used_inodes, removed: released.removed)
    if (not builder_identifier_valid_v1(released.operation_id) or not builder_digest_valid_v1(released.marker_digest) or
            not retention_effect_valid_v1(effect) or released.released_at_ms < 0):
        return Err("retention-released-value-invalid")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("retention-released"),
        "operationId": SdnValue.String(released.operation_id), "markerDigest": SdnValue.String(released.marker_digest),
        "charge": SdnValue.String(released.charge), "usedBytes": SdnValue.Int(released.used_bytes),
        "usedInodes": SdnValue.Int(released.used_inodes), "removed": SdnValue.Int(released.removed),
        "releasedAtMs": SdnValue.Int(released.released_at_ms)}
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")

pub fn host_retention_released_decode_v1(source: text) -> Result<HostRetentionReleasedV1, text>:
    val fields = retention_fields_v1(source, 4096, ["version", "kind", "operationId", "markerDigest", "charge", "usedBytes",
        "usedInodes", "removed", "releasedAtMs"])?
    if retention_integer_v1(fields, "version")? != 1: return Err("retention-release-version-unsupported")
    if retention_text_v1(fields, "kind")? != "retention-released": return Err("retention-release-version-unsupported")
    val released = HostRetentionReleasedV1(operation_id: retention_text_v1(fields, "operationId")?,
        marker_digest: retention_text_v1(fields, "markerDigest")?, charge: retention_text_v1(fields, "charge")?,
        used_bytes: retention_integer_v1(fields, "usedBytes")?, used_inodes: retention_integer_v1(fields, "usedInodes")?,
        removed: retention_integer_v1(fields, "removed")?, released_at_ms: retention_integer_v1(fields, "releasedAtMs")?)
    if host_retention_released_bytes_v1(released)? != source: return Err("retention-released-noncanonical")
    Ok(released)

export HostRetentionReleaseV1, HostRetentionReleaseProofV1, HostRetentionReleaseEffectV1, HostRetentionReleasedV1
export HOST_RETENTION_RELEASE_WIRE_V1, HOST_RETENTION_RELEASE_STATES_V1
export host_retention_release_bytes_v1, host_retention_release_digest_v1, host_retention_release_decode_v1
export host_retention_release_match_v1, host_retention_release_proof_encode_v1, host_retention_release_proof_decode_v1
export host_retention_released_bytes_v1, host_retention_released_decode_v1
