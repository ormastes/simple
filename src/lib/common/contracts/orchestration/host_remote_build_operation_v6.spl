# milestone_0030 owner decision N10: the remote build is ONE authenticated V6 action, `remote-build`. Its payload is
# this canonical envelope: the sub-operation and the unchanged route frame (host_remote_build_frame_*_v4). The shape
# confers no authority: the Host domain route re-verifies every frame and the controller-signed pair at `open`.
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1

pub val HOST_REMOTE_BUILD_SUBS_V6 = ["open", "input", "start", "collect", "output", "cancel"]

pub struct HostRemoteBuildSubRequestV6:
    sub: text
    frame: text

# The Host-domain route action (host_service_domain_v3 HOST_REMOTE_BUILD_ACTIONS_V3 key) of a sub-operation.
pub fn host_remote_build_sub_domain_action_v6(sub: text) -> Result<text, text>:
    if not HOST_REMOTE_BUILD_SUBS_V6.contains(sub): return Err("host-remote-build-sub-unknown")
    Ok("host-remote-build-" + sub)

pub fn host_remote_build_sub_encode_v6(request: HostRemoteBuildSubRequestV6) -> Result<text, text>:
    if not HOST_REMOTE_BUILD_SUBS_V6.contains(request.sub): return Err("host-remote-build-sub-unknown")
    if request.frame == "": return Err("host-remote-build-sub-frame-required")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(6), "kind": SdnValue.String("host-remote-build-sub"),
        "sub": SdnValue.String(request.sub), "frame": SdnValue.String(request.frame)}
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)))

pub fn host_remote_build_sub_decode_v6(source: text) -> Result<HostRemoteBuildSubRequestV6, text>:
    if source.byte_len() < 1 or source.byte_len() > 2097152: return Err("host-remote-build-sub-size")
    val parsed = sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: 2097152, max_depth: 2, max_nodes: 16,
        max_rows: 0, max_cells: 0, max_columns: 8))
    if parsed.is_err(): return Err("host-remote-build-sub-syntax")
    val fields = match parsed.unwrap().value:
        case SdnValue.Dict(value): value
        case _: return Err("host-remote-build-sub-object")
    if fields.len() != 4 or not fields.contains_key("sub") or not fields.contains_key("frame"):
        return Err("host-remote-build-sub-fields")
    val sub = match fields["sub"]:
        case SdnValue.String(value): value
        case _: return Err("host-remote-build-sub-fields")
    val frame = match fields["frame"]:
        case SdnValue.String(value): value
        case _: return Err("host-remote-build-sub-fields")
    val request = HostRemoteBuildSubRequestV6(sub: sub, frame: frame)
    if host_remote_build_sub_encode_v6(request)? != source: return Err("host-remote-build-sub-noncanonical")
    Ok(request)

export HostRemoteBuildSubRequestV6, HOST_REMOTE_BUILD_SUBS_V6
export host_remote_build_sub_domain_action_v6, host_remote_build_sub_encode_v6, host_remote_build_sub_decode_v6
