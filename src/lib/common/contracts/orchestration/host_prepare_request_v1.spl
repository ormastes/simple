# Bounded SDN request envelope. Nested strings preserve the existing versioned
# operation/signature codecs. Decoding supplies data, never keys or authority.
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2, distributed_decode_operation_v2}
use std.common.contracts.distributed_authority_codec_v2.*
use std.common.contracts.orchestration.host_reservation_codec_v1.*
use std.common.contracts.orchestration.resource_v1.{RejectionV1, reject, as_dict, as_text, as_int, only_known, require}
use std.common.sdn.value.{SdnValue, SdnSpan}
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.common.sdn.encode.sdn_encode_canonical
use std.common.string_core.str_len

pub struct HostPrepareRequestV1:
    intent: HostReservationIntentV1
    operation: OperationEnvelopeV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

pub fn host_prepare_request_encode_v1(request: HostPrepareRequestV1) -> Result<text, text>:
    val matching = host_reservation_match_operation_v1(request.intent, request.operation)?
    val intent = host_reservation_encode_intent_v1(request.intent)?
    val operation = distributed_encode_operation_v2(request.operation)?
    val signed = distributed_encode_signed_grant_v2(request.signed)?
    val approval = distributed_encode_signed_approval_v2(request.approval)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1),
        "kind": SdnValue.String("host-prepare-request"), "reservation": SdnValue.String(intent),
        "operation": SdnValue.String(operation), "signedGrant": SdnValue.String(signed),
        "signedApproval": SdnValue.String(approval)}
    val encoded = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(encoded) > 1048576: return Err("host-prepare-request-too-large")
    Ok(encoded)

fn host_prepare_fields_v1(source: text) -> Result<[text], RejectionV1>:
    val limits = SdnStrictLimitsV1(max_source_bytes: 1048576, max_depth: 2,
        max_nodes: 16, max_rows: 0, max_cells: 0, max_columns: 8)
    val parsed = match sdn_parse_strict_v1(source, limits):
        case Ok(value): value
        case Err(issue): return Err(RejectionV1(kind: issue.code, path: "", message: issue.message, line: issue.line, col: issue.column))
    val spans: Dict<text, SdnSpan> = {}
    val fields = as_dict(parsed.value, "", spans)?
    only_known(fields, ["version", "kind", "reservation", "operation", "signedGrant", "signedApproval"], "", spans)?
    val version = as_int(require(fields, "version", "", spans)?, "version", spans)?
    if version != 1: return Err(reject("version", "version", "unsupported prepare request version", spans))
    val kind = as_text(require(fields, "kind", "", spans)?, "kind", spans)?
    if kind != "host-prepare-request": return Err(reject("kind", "kind", "unsupported prepare request kind", spans))
    var values: [text] = []
    for key in ["reservation", "operation", "signedGrant", "signedApproval"]:
        values.push(as_text(require(fields, key, "", spans)?, key, spans)?)
    Ok(values)

pub fn host_prepare_request_decode_v1(source: text) -> Result<HostPrepareRequestV1, text>:
    if str_len(source) > 1048576: return Err("host-prepare-request-too-large")
    val fields = match host_prepare_fields_v1(source):
        case Ok(value): value
        case Err(reason): return Err("host-prepare-request-invalid:" + reason.kind + ":" + reason.path)
    val limits = SdnStrictLimitsV1(max_source_bytes: 65536, max_depth: 3,
        max_nodes: 512, max_rows: 0, max_cells: 0, max_columns: 32)
    val parsed_intent = match sdn_parse_strict_v1(fields[0], limits):
        case Ok(value): value
        case Err(issue): return Err("host-prepare-reservation-invalid:" + issue.code)
    val spans: Dict<text, SdnSpan> = {}
    val intent = match host_reservation_decode_value_v1(parsed_intent.value, spans, fields[0]):
        case Ok(value): value
        case Err(reason): return Err("host-prepare-reservation-invalid:" + reason.kind + ":" + reason.path)
    if host_reservation_encode_intent_v1(intent)? != fields[0]: return Err("reservation-intent-not-canonical")
    val operation = distributed_decode_operation_v2(fields[1])?
    val signed = distributed_decode_signed_grant_v2(fields[2])?
    val approval = distributed_decode_signed_approval_v2(fields[3])?
    val request = HostPrepareRequestV1(intent: intent, operation: operation, signed: signed, approval: approval)
    val canonical = host_prepare_request_encode_v1(request)?
    if canonical != source: return Err("host-prepare-request-not-canonical")
    Ok(request)
