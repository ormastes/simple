# Aggregate parent/helper ceiling over an EXISTING host operation and ledger.
# A canonical payload/proof binds bytes, never grants publisher authority or
# reserves extra capacity. Host owner verifies signed grant+human approval and
# atomically charges parent AND all helpers in the SAME physical ledger.
use std.common.contracts.container.execution_v2.{ContainerHostScopeV2, container_host_scope_bytes_v2, container_host_scope_decode_v2, container_scope_fence_id_v2}
use std.common.contracts.orchestration.assignment_v1.{ControllerAssignmentBindingV1, controller_assignment_bytes_v1, controller_assignment_match_v1}
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2, distributed_decode_operation_v2}
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_authority_codec_v2.*
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.common.crypto.sha256.sha256_text
use std.common.string_core.str_len
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1

pub struct ControllerParentBudgetV1:
    parent_operation_id: text
    parent_operation_digest: text
    parent_assignment_digest: text
    maximum_cpu_millis: i64
    maximum_memory_bytes: i64
    scope: ContainerHostScopeV2

pub struct ControllerParentBudgetProofV1:
    budget: ControllerParentBudgetV1
    operation: OperationEnvelopeV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

fn parent_budget_fields_v1(source: text, maximum: i64, names: [text]) -> Result<Dict<text, SdnValue>, text>:
    if str_len(source) == 0 or str_len(source) > maximum: return Err("parent-budget-source-size")
    val limits = SdnStrictLimitsV1(max_source_bytes: maximum, max_depth: 2,
        max_nodes: 24, max_rows: 0, max_cells: 0, max_columns: 12)
    val parsed = match sdn_parse_strict_v1(source, limits):
        case Ok(value): value
        case Err(issue): return Err("parent-budget-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("parent-budget-object-required")
    for key in fields.keys():
        if not names.contains(key): return Err("parent-budget-unknown-field:" + key)
    for key in names:
        if not fields.contains_key(key): return Err("parent-budget-missing-field:" + key)
    Ok(fields)

fn parent_budget_text_v1(fields: Dict<text, SdnValue>, key: text) -> Result<text, text>:
    match fields[key]:
        case SdnValue.String(value): Ok(value)
        case _: Err("parent-budget-text-required:" + key)

fn parent_budget_integer_v1(fields: Dict<text, SdnValue>, key: text) -> Result<i64, text>:
    match fields[key]:
        case SdnValue.Int(value): Ok(value)
        case _: Err("parent-budget-integer-required:" + key)

pub fn controller_parent_budget_bytes_v1(budget: ControllerParentBudgetV1) -> Result<text, text>:
    if not builder_identifier_valid_v1(budget.parent_operation_id) or
            not builder_digest_valid_v1(budget.parent_operation_digest) or
            not builder_digest_valid_v1(budget.parent_assignment_digest) or
            budget.maximum_cpu_millis <= 0 or budget.maximum_memory_bytes <= 0:
        return Err("parent-budget-value-invalid")
    val scope = container_host_scope_bytes_v2(budget.scope)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("controller-parent-budget"),
        "parentOperationId": SdnValue.String(budget.parent_operation_id),
        "parentOperationDigest": SdnValue.String(budget.parent_operation_digest),
        "parentAssignmentDigest": SdnValue.String(budget.parent_assignment_digest),
        "maximumCpuMillis": SdnValue.Int(budget.maximum_cpu_millis), "maximumMemoryBytes": SdnValue.Int(budget.maximum_memory_bytes),
        "scope": SdnValue.String(scope)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(source) > 16384: return Err("parent-budget-source-size")
    Ok(source)

pub fn controller_parent_budget_digest_v1(budget: ControllerParentBudgetV1) -> Result<text, text>:
    val source = controller_parent_budget_bytes_v1(budget)?
    Ok(sha256_text(source))

pub fn controller_parent_budget_decode_v1(source: text) -> Result<ControllerParentBudgetV1, text>:
    val fields = parent_budget_fields_v1(source, 16384, ["version", "kind", "parentOperationId",
        "parentOperationDigest", "parentAssignmentDigest", "maximumCpuMillis", "maximumMemoryBytes", "scope"])?
    if parent_budget_integer_v1(fields, "version")? != 1 or parent_budget_text_v1(fields, "kind")? != "controller-parent-budget":
        return Err("parent-budget-version")
    val budget = ControllerParentBudgetV1(parent_operation_id: parent_budget_text_v1(fields, "parentOperationId")?,
        parent_operation_digest: parent_budget_text_v1(fields, "parentOperationDigest")?,
        parent_assignment_digest: parent_budget_text_v1(fields, "parentAssignmentDigest")?,
        maximum_cpu_millis: parent_budget_integer_v1(fields, "maximumCpuMillis")?,
        maximum_memory_bytes: parent_budget_integer_v1(fields, "maximumMemoryBytes")?,
        scope: container_host_scope_decode_v2(parent_budget_text_v1(fields, "scope")?)?)
    if controller_parent_budget_bytes_v1(budget)? != source: return Err("parent-budget-noncanonical")
    Ok(budget)

fn parent_budget_operation_v1(budget: ControllerParentBudgetV1, operation: OperationEnvelopeV2) -> Result<bool, text>:
    val canonical = distributed_encode_operation_v2(operation)?
    if operation.operation != "controller_helper_budget_v1" or
            operation.payload_digest != controller_parent_budget_digest_v1(budget)? or
            operation.memory_bytes != budget.maximum_memory_bytes or operation.duration_ms <= 0:
        return Err("parent-budget-operation-mismatch")
    Ok(true)

pub fn controller_parent_budget_match_v1(budget: ControllerParentBudgetV1,
        operation: OperationEnvelopeV2, parent_binding: ControllerAssignmentBindingV1,
        parent_controller_operation: OperationEnvelopeV2) -> Result<bool, text>:
    val valid = controller_parent_budget_bytes_v1(budget)?
    val matching = parent_budget_operation_v1(budget, operation)?
    val parent_matched = controller_assignment_match_v1(parent_binding, parent_controller_operation)?
    val parent_bytes = controller_assignment_bytes_v1(parent_binding)?
    val parent = parent_binding.host_operation
    if budget.parent_operation_id != parent.id or
            budget.parent_operation_digest != sha256_text(distributed_encode_operation_v2(parent)?) or
            budget.parent_assignment_digest != sha256_text(parent_bytes):
        return Err("parent-budget-parent-reference-mismatch")
    val intent = parent_binding.host_intent
    if budget.scope.physical_host_id != intent.physical_host_id or
            budget.scope.service_scope_id != intent.reservation.service_scope_id or
            budget.scope.provider_generation != intent.fence.provider_generation or
            container_scope_fence_id_v2(budget.scope)? != intent.fence.boot_id:
        return Err("parent-budget-scope-mismatch")
    if budget.maximum_cpu_millis < intent.reservation.cpu_millis or
            budget.maximum_memory_bytes < intent.reservation.memory_bytes:
        return Err("parent-budget-below-retained-parent")
    if operation.host_id != parent_binding.controller_id or operation.principal != parent.principal or
            operation.project != parent.project or operation.environment_digest != parent.environment_digest or
            operation.policy_revision != parent.policy_revision or operation.revocation_epoch != parent.revocation_epoch or
            operation.session_generation != parent.session_generation or operation.duration_ms > parent.duration_ms:
        return Err("parent-budget-controller-envelope-mismatch")
    Ok(true)

pub fn controller_parent_budget_proof_encode_v1(proof: ControllerParentBudgetProofV1) -> Result<text, text>:
    val matched = parent_budget_operation_v1(proof.budget, proof.operation)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("controller-parent-budget-proof"),
        "budget": SdnValue.String(controller_parent_budget_bytes_v1(proof.budget)?),
        "operation": SdnValue.String(distributed_encode_operation_v2(proof.operation)?),
        "signedGrant": SdnValue.String(distributed_encode_signed_grant_v2(proof.signed)?),
        "signedApproval": SdnValue.String(distributed_encode_signed_approval_v2(proof.approval)?)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(source) > 262144: return Err("parent-budget-proof-size")
    Ok(source)

pub fn controller_parent_budget_proof_decode_v1(source: text) -> Result<ControllerParentBudgetProofV1, text>:
    if str_len(source) > 262144: return Err("parent-budget-proof-size")
    val fields = parent_budget_fields_v1(source, 262144, ["version", "kind", "budget", "operation", "signedGrant", "signedApproval"])?
    if parent_budget_integer_v1(fields, "version")? != 1 or parent_budget_text_v1(fields, "kind")? != "controller-parent-budget-proof":
        return Err("parent-budget-proof-version")
    val proof = ControllerParentBudgetProofV1(budget: controller_parent_budget_decode_v1(parent_budget_text_v1(fields, "budget")?)?,
        operation: distributed_decode_operation_v2(parent_budget_text_v1(fields, "operation")?)?,
        signed: distributed_decode_signed_grant_v2(parent_budget_text_v1(fields, "signedGrant")?)?,
        approval: distributed_decode_signed_approval_v2(parent_budget_text_v1(fields, "signedApproval")?)?)
    if controller_parent_budget_proof_encode_v1(proof)? != source: return Err("parent-budget-proof-noncanonical")
    Ok(proof)
