# Untrusted signed input. Decoding does not grant task access or execution.
use std.common.contracts.orchestration.agent_task_object_v1.*
use std.common.contracts.orchestration.agent_task_use_v1.*
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_authority_codec_v2.*
use std.common.contracts.orchestration.resource_v1.{as_dict, only_known}
use std.common.sdn.value.{SdnValue, SdnSpan}
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.common.sdn.encode.sdn_encode_canonical

pub struct AgentTaskCommandV1:
    action: text
    body: text
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

pub fn agent_task_command_body_v1(action: text, body: text) -> Result<text, text>:
    if action == "retain":
        val task = agent_task_object_decode_v1(body)?
        return agent_task_object_encode_v1(task)
    if action == "use":
        val binding = agent_task_use_decode_v1(body)?
        return agent_task_use_encode_v1(binding)
    Err("agent-task-command-action")

pub fn agent_task_command_encode_v1(packet: AgentTaskCommandV1) -> Result<text, text>:
    val body = agent_task_command_body_v1(packet.action, packet.body)?
    if body != packet.body: return Err("agent-task-command-body-noncanonical")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1),
        "kind": SdnValue.String("controller-agent-task-command"),
        "action": SdnValue.String(packet.action), "body": SdnValue.String(body),
        "signedGrant": SdnValue.String(distributed_encode_signed_grant_v2(packet.signed)?),
        "signedApproval": SdnValue.String(distributed_encode_signed_approval_v2(packet.approval)?)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if source.byte_len() > 262144: return Err("agent-task-command-size")
    Ok(source)

fn task_command_text_v1(fields: Dict<text, SdnValue>, key: text) -> Result<text, text>:
    match fields[key]:
        case SdnValue.String(value): Ok(value)
        case _: Err("agent-task-command-text-required:" + key)

pub fn agent_task_command_decode_v1(source: text) -> Result<AgentTaskCommandV1, text>:
    if source.byte_len() == 0 or source.byte_len() > 262144: return Err("agent-task-command-size")
    val parsed = match sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: 262144,
            max_depth: 2, max_nodes: 16, max_rows: 0, max_cells: 0, max_columns: 8)):
        case Ok(value): value
        case Err(_): return Err("agent-task-command-syntax")
    val spans: Dict<text, SdnSpan> = {}
    val fields = match as_dict(parsed.value, "", spans):
        case Ok(value): value
        case Err(_): return Err("agent-task-command-object-required")
    val names = ["version", "kind", "action", "body", "signedGrant", "signedApproval"]
    if only_known(fields, names, "", spans).is_err(): return Err("agent-task-command-unknown-field")
    for key in names:
        if not fields.contains_key(key): return Err("agent-task-command-missing-field:" + key)
    match fields["version"]:
        case SdnValue.Int(value):
            if value != 1: return Err("agent-task-command-version")
        case _: return Err("agent-task-command-version")
    if task_command_text_v1(fields, "kind")? != "controller-agent-task-command":
        return Err("agent-task-command-kind")
    val packet = AgentTaskCommandV1(action: task_command_text_v1(fields, "action")?,
        body: task_command_text_v1(fields, "body")?,
        signed: distributed_decode_signed_grant_v2(task_command_text_v1(fields, "signedGrant")?)?,
        approval: distributed_decode_signed_approval_v2(task_command_text_v1(fields, "signedApproval")?)?)
    if agent_task_command_encode_v1(packet)? != source: return Err("agent-task-command-noncanonical")
    Ok(packet)
