# Versioned shared Simple Container API envelope. Canonical shape is not
# authorization: the host verifies proofs, actual provider projection and owner.
use std.common.contracts.container.execution_v2.*
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2, distributed_decode_operation_v2}
use std.common.contracts.distributed_authority_codec_v2.*
use std.common.contracts.orchestration.host_reservation_codec_v1.*
use std.common.contracts.orchestration.host_prepare_response_v1.{host_prepare_response_encode_v1, host_prepare_response_decode_v1}
use std.common.sdn.value.SdnValue
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.common.sdn.encode.sdn_encode_canonical
use std.common.string_core.str_len

pub struct HostExecuteRequestV2:
    intent: HostReservationIntentV1
    operation: OperationEnvelopeV2
    receipt: HostPreparedReservationReceiptV1
    execution: ContainerExecutionRequestV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

pub fn host_execute_request_encode_v2(request: HostExecuteRequestV2) -> Result<text, text>:
    val matching = host_reservation_match_operation_v1(request.intent, request.operation)?
    val plan = request.execution.plan
    val scope = ContainerHostScopeV2(physical_host_id: plan.physical_host_id,
        native_machine_id: plan.native_machine_id, service_scope_id: plan.service_scope_id,
        boot_id: plan.boot_id, provider_generation: plan.provider_generation,
        continuity_mode: plan.continuity_mode, continuity_id: plan.continuity_id)
    if plan.operation_id != request.operation.id or
            plan.physical_host_id != request.intent.physical_host_id or
            container_scope_fence_id_v2(scope)? != request.intent.fence.boot_id or
            plan.provider_generation != request.intent.fence.provider_generation or
            plan.service_scope_id != request.intent.reservation.service_scope_id:
        return Err("host-execute-v2-scope-mismatch")
    if container_execution_plan_digest_v2(plan)? != request.intent.plan_digest:
        return Err("host-execute-v2-plan-digest-mismatch")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(2),
        "kind": SdnValue.String("host-execute-request"),
        "reservation": SdnValue.String(host_reservation_encode_intent_v1(request.intent)?),
        "operation": SdnValue.String(distributed_encode_operation_v2(request.operation)?),
        "receipt": SdnValue.String(host_prepare_response_encode_v1(request.receipt, request.intent, request.operation)?),
        "execution": SdnValue.String(container_execution_request_encode_v2(request.execution)?),
        "signedGrant": SdnValue.String(distributed_encode_signed_grant_v2(request.signed)?),
        "signedApproval": SdnValue.String(distributed_encode_signed_approval_v2(request.approval)?)}
    val bytes = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(bytes) > 2097152: return Err("host-execute-v2-size")
    Ok(bytes)

pub fn host_execute_request_decode_v2(source: text) -> Result<HostExecuteRequestV2, text>:
    if str_len(source) == 0 or str_len(source) > 2097152: return Err("host-execute-v2-size")
    val limits = SdnStrictLimitsV1(max_source_bytes: 2097152, max_depth: 2,
        max_nodes: 24, max_rows: 0, max_cells: 0, max_columns: 12)
    val parsed = match sdn_parse_strict_v1(source, limits):
        case Ok(value): value
        case Err(issue): return Err("host-execute-v2-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("host-execute-v2-object")
    val allowed = ["version", "kind", "reservation", "operation", "receipt", "execution", "signedGrant", "signedApproval"]
    for key in fields.keys():
        if not allowed.contains(key): return Err("host-execute-v2-unknown-field")
    for key in allowed:
        if not fields.contains_key(key): return Err("host-execute-v2-missing:" + key)
    match fields["version"]:
        case SdnValue.Int(value):
            if value != 2: return Err("host-execute-v2-version")
        case _: return Err("host-execute-v2-version")
    var values: [text] = []
    for key in ["kind", "reservation", "operation", "receipt", "execution", "signedGrant", "signedApproval"]:
        match fields[key]:
            case SdnValue.String(value): values.push(value)
            case _: return Err("host-execute-v2-field-type:" + key)
    if values[0] != "host-execute-request": return Err("host-execute-v2-kind")
    val intent = host_reservation_decode_intent_v1(values[1])?
    val operation = distributed_decode_operation_v2(values[2])?
    val request = HostExecuteRequestV2(intent: intent, operation: operation,
        receipt: host_prepare_response_decode_v1(values[3], intent, operation)?,
        execution: container_execution_request_decode_v2(values[4])?,
        signed: distributed_decode_signed_grant_v2(values[5])?,
        approval: distributed_decode_signed_approval_v2(values[6])?)
    if host_execute_request_encode_v2(request)? != source: return Err("host-execute-v2-noncanonical")
    Ok(request)
