# Native full invocation DATA with explicit executable/budget policy. The old
# V1 manifest/codec is unchanged and is not accepted as native V2 input.
use std.common.contracts.orchestration.agent_workspace_invocation_v1.*
use std.common.contracts.container.agent_executable_profile_v1.{AgentExecutableProfileV1,
    agent_executable_profile_encode_v1, agent_executable_profile_decode_v1, agent_executable_profile_minimum_memory_v1}
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.crypto.sha256.sha256_text

pub struct AgentWorkspaceInvocationManifestV2:
    base: AgentWorkspaceInvocationManifestV1
    executable_profile: AgentExecutableProfileV1

pub fn agent_workspace_invocation_manifest_encode_v2(value: AgentWorkspaceInvocationManifestV2) -> Result<text, text>:
    val minimum = agent_executable_profile_minimum_memory_v1(value.executable_profile)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(2),
        "kind": SdnValue.String("agent-workspace-native-invocation"),
        "base": SdnValue.String(agent_workspace_invocation_manifest_encode_v1(value.base)?),
        "executableProfile": SdnValue.String(agent_executable_profile_encode_v1(value.executable_profile)?)}
    val bytes = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if bytes.byte_len() > 1048576: return Err("agent-workspace-native-manifest-size")
    Ok(bytes)

pub fn agent_workspace_invocation_manifest_digest_v2(value: AgentWorkspaceInvocationManifestV2) -> Result<text, text>:
    Ok(sha256_text(agent_workspace_invocation_manifest_encode_v2(value)?))

pub fn agent_workspace_invocation_manifest_decode_v2(source: text) -> Result<AgentWorkspaceInvocationManifestV2, text>:
    val fields = agent_workspace_fields_v1(source, 1048576, ["version", "kind", "base", "executableProfile"])?
    if agent_workspace_int_v1(fields, "version")? != 2 or agent_workspace_text_v1(fields, "kind")? != "agent-workspace-native-invocation":
        return Err("agent-workspace-native-manifest-version")
    val value = AgentWorkspaceInvocationManifestV2(base: agent_workspace_invocation_manifest_decode_v1(agent_workspace_text_v1(fields, "base")?)?,
        executable_profile: agent_executable_profile_decode_v1(agent_workspace_text_v1(fields, "executableProfile")?)?)
    if agent_workspace_invocation_manifest_encode_v2(value)? != source: return Err("agent-workspace-native-manifest-noncanonical")
    Ok(value)
