# Pure signed installation data. Policy schema/probing belongs exclusively to
# Common Container providers; a digest/decoded object is not live capability.
use std.common.contracts.container.execution_v2.*
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2, distributed_decode_operation_v2}
use std.common.contracts.distributed_authority_codec_v2.*
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.common.crypto.sha256.sha256_text
use std.common.string_core.str_len

pub struct HostContainmentInstallationIntentV1:
    operation_id: text
    enrollment_binding_digest: text
    scope: ContainerHostScopeV2
    provider_identity_digest: text
    containment_policy_bytes: text
    containment_policy_digest: text
    containment_identity_digest: text

pub struct HostContainmentInstallationRequestV1:
    intent: HostContainmentInstallationIntentV1
    operation: OperationEnvelopeV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

pub fn host_containment_installation_policy_v1(bytes: text) -> Result<bool, text>:
    if str_len(bytes) == 0 or str_len(bytes) > 1048576: return Err("host-containment-install-policy-size")
    val parsed = match sdn_parse_strict_v1(bytes, SdnStrictLimitsV1(max_source_bytes: 1048576,
            max_depth: 32, max_nodes: 65536, max_rows: 4096, max_cells: 65536, max_columns: 4096)):
        case Ok(value): value
        case Err(issue): return Err("host-containment-install-policy-syntax:" + issue.code)
    match parsed.value:
        case SdnValue.Dict(_): ()
        case _: return Err("host-containment-install-policy-object-required")
    if sdn_encode_canonical(parsed.value) + "\n" != bytes: return Err("host-containment-install-policy-noncanonical")
    Ok(true)

pub fn host_containment_installation_intent_encode_v1(value: HostContainmentInstallationIntentV1) -> Result<text, text>:
    if not builder_identifier_valid_v1(value.operation_id): return Err("host-containment-install-operation-id")
    for digest in [value.enrollment_binding_digest, value.provider_identity_digest, value.containment_policy_digest, value.containment_identity_digest]:
        if str_len(digest) != 64 or not builder_digest_valid_v1(digest): return Err("host-containment-install-digest")
    val policy = host_containment_installation_policy_v1(value.containment_policy_bytes)?
    if sha256_text(value.containment_policy_bytes) != value.containment_policy_digest: return Err("host-containment-install-policy-digest-mismatch")
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("host-containment-installation-intent"),
        "operationId": SdnValue.String(value.operation_id), "enrollmentBindingDigest": SdnValue.String(value.enrollment_binding_digest),
        "scope": SdnValue.String(container_host_scope_bytes_v2(value.scope)?),
        "providerIdentityDigest": SdnValue.String(value.provider_identity_digest),
        "containmentPolicyBytes": SdnValue.String(value.containment_policy_bytes), "containmentPolicyDigest": SdnValue.String(value.containment_policy_digest),
        "containmentIdentityDigest": SdnValue.String(value.containment_identity_digest)}
    val bytes = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(bytes) > 4194304: return Err("host-containment-install-source-size")
    Ok(bytes)

pub fn host_containment_installation_intent_digest_v1(value: HostContainmentInstallationIntentV1) -> Result<text, text>:
    Ok(sha256_text(host_containment_installation_intent_encode_v1(value)?))

fn containment_installation_fields_v1(source: text, names: [text]) -> Result<Dict<text, SdnValue>, text>:
    if str_len(source) == 0 or str_len(source) > 4194304: return Err("host-containment-install-source-size")
    val parsed = match sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: 4194304,
            max_depth: 2, max_nodes: 32, max_rows: 0, max_cells: 0, max_columns: 16)):
        case Ok(value): value
        case Err(issue): return Err("host-containment-install-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("host-containment-install-object-required")
    for name in fields.keys():
        if not names.contains(name): return Err("host-containment-install-unknown-field:" + name)
    for name in names:
        if not fields.contains_key(name): return Err("host-containment-install-missing-field:" + name)
    Ok(fields)

fn containment_installation_text_v1(fields: Dict<text, SdnValue>, name: text) -> Result<text, text>:
    match fields[name]:
        case SdnValue.String(value): Ok(value)
        case _: Err("host-containment-install-text-required:" + name)

pub fn host_containment_installation_intent_decode_v1(source: text) -> Result<HostContainmentInstallationIntentV1, text>:
    val fields = containment_installation_fields_v1(source, ["version", "kind", "operationId", "enrollmentBindingDigest", "scope", "providerIdentityDigest", "containmentPolicyBytes", "containmentPolicyDigest", "containmentIdentityDigest"])?
    if fields["version"] != SdnValue.Int(1) or containment_installation_text_v1(fields, "kind")? != "host-containment-installation-intent": return Err("host-containment-install-version")
    val value = HostContainmentInstallationIntentV1(operation_id: containment_installation_text_v1(fields, "operationId")?,
        enrollment_binding_digest: containment_installation_text_v1(fields, "enrollmentBindingDigest")?,
        scope: container_host_scope_decode_v2(containment_installation_text_v1(fields, "scope")?)?,
        provider_identity_digest: containment_installation_text_v1(fields, "providerIdentityDigest")?,
        containment_policy_bytes: containment_installation_text_v1(fields, "containmentPolicyBytes")?, containment_policy_digest: containment_installation_text_v1(fields, "containmentPolicyDigest")?,
        containment_identity_digest: containment_installation_text_v1(fields, "containmentIdentityDigest")?)
    if host_containment_installation_intent_encode_v1(value)? != source: return Err("host-containment-install-noncanonical")
    Ok(value)

pub fn host_containment_installation_match_operation_v1(intent: HostContainmentInstallationIntentV1,
        operation: OperationEnvelopeV2) -> Result<bool, text>:
    val encoded = distributed_encode_operation_v2(operation)?
    if (operation.operation != "host_containment_install_v1" or operation.id != intent.operation_id or
            operation.host_id != intent.scope.physical_host_id or operation.environment_digest != intent.provider_identity_digest or
            operation.payload_digest != host_containment_installation_intent_digest_v1(intent)?):
        return Err("host-containment-install-operation-mismatch")
    Ok(true)

pub fn host_containment_installation_request_encode_v1(value: HostContainmentInstallationRequestV1) -> Result<text, text>:
    val matched = host_containment_installation_match_operation_v1(value.intent, value.operation)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("host-containment-installation-request"),
        "intent": SdnValue.String(host_containment_installation_intent_encode_v1(value.intent)?),
        "operation": SdnValue.String(distributed_encode_operation_v2(value.operation)?),
        "signedGrant": SdnValue.String(distributed_encode_signed_grant_v2(value.signed)?),
        "signedApproval": SdnValue.String(distributed_encode_signed_approval_v2(value.approval)?)}
    val bytes = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(bytes) > 4194304: return Err("host-containment-install-source-size")
    Ok(bytes)

pub fn host_containment_installation_request_decode_v1(source: text) -> Result<HostContainmentInstallationRequestV1, text>:
    val fields = containment_installation_fields_v1(source, ["version", "kind", "intent", "operation", "signedGrant", "signedApproval"])?
    if fields["version"] != SdnValue.Int(1) or containment_installation_text_v1(fields, "kind")? != "host-containment-installation-request": return Err("host-containment-install-version")
    val value = HostContainmentInstallationRequestV1(intent: host_containment_installation_intent_decode_v1(containment_installation_text_v1(fields, "intent")?)?,
        operation: distributed_decode_operation_v2(containment_installation_text_v1(fields, "operation")?)?,
        signed: distributed_decode_signed_grant_v2(containment_installation_text_v1(fields, "signedGrant")?)?,
        approval: distributed_decode_signed_approval_v2(containment_installation_text_v1(fields, "signedApproval")?)?)
    if host_containment_installation_request_encode_v1(value)? != source: return Err("host-containment-install-noncanonical")
    Ok(value)
