# Controller-signed update/drain handoff record (AT-OPS-01, owner decisions D1-D4 of 2026-11-17).
# The OLD service owner drains, publishes this record on its own single journal and exits; the SUCCESSOR re-proves
# exclusion and adopts it. The record is DATA bound to a signed `service-handoff` operation; it grants nothing and
# transfers no live custody. Exactly one wire version is accepted (D4): any other is refused, never downgraded.
use std.common.contracts.container.execution_v2.{ContainerHostScopeV2, container_host_scope_bytes_v2, container_host_scope_decode_v2}
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2, distributed_decode_operation_v2}
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_authority_codec_v2.*
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.common.crypto.sha256.sha256_text
use std.common.string_core.str_len
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1

pub val HOST_SERVICE_HANDOFF_WIRE_V1: text = "service-handoff-v1"
pub val HOST_SERVICE_HANDOFF_OPERATION_V1: text = "service-handoff"

pub struct HostServiceHandoffV1:
    wire_version: text
    # 1-based position in this journal's handoff chain; the successor adopts only the next unconsumed one.
    sequence: i64
    # The draining owner's own incarnation scope and its published current record (path + digest), so the successor
    # proves it is reading the same journal the predecessor wrote.
    scope: ContainerHostScopeV2
    from_current_relative: text
    from_current_digest: text
    # sha256 of the encoded agent-slot operation retained at drain time, "" when nothing is retained.
    retained_operation_digest: text

pub struct HostServiceHandoffProofV1:
    handoff: HostServiceHandoffV1
    operation: OperationEnvelopeV2
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

fn service_handoff_fields_v1(source: text, maximum: i64, names: [text]) -> Result<Dict<text, SdnValue>, text>:
    if str_len(source) == 0 or str_len(source) > maximum: return Err("service-handoff-source-size")
    val limits = SdnStrictLimitsV1(max_source_bytes: maximum, max_depth: 2, max_nodes: 24, max_rows: 0, max_cells: 0, max_columns: 12)
    val parsed = match sdn_parse_strict_v1(source, limits):
        case Ok(value): value
        case Err(issue): return Err("service-handoff-syntax:" + issue.code)
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("service-handoff-object-required")
    for key in fields.keys():
        if not names.contains(key): return Err("service-handoff-unknown-field:" + key)
    for key in names:
        if not fields.contains_key(key): return Err("service-handoff-missing-field:" + key)
    Ok(fields)

fn service_handoff_text_v1(fields: Dict<text, SdnValue>, key: text) -> Result<text, text>:
    match fields[key]:
        case SdnValue.String(value): Ok(value)
        case _: Err("service-handoff-text-required:" + key)

fn service_handoff_integer_v1(fields: Dict<text, SdnValue>, key: text) -> Result<i64, text>:
    match fields[key]:
        case SdnValue.Int(value): Ok(value)
        case _: Err("service-handoff-integer-required:" + key)

pub fn host_service_handoff_bytes_v1(handoff: HostServiceHandoffV1) -> Result<text, text>:
    if handoff.wire_version != HOST_SERVICE_HANDOFF_WIRE_V1: return Err("service-handoff-version-unsupported")
    if (handoff.sequence <= 0 or not builder_digest_valid_v1(handoff.from_current_digest) or
            not handoff.from_current_relative.starts_with("linux-service-current/") or
            (handoff.retained_operation_digest != "" and not builder_digest_valid_v1(handoff.retained_operation_digest))):
        return Err("service-handoff-value-invalid")
    val scope = container_host_scope_bytes_v2(handoff.scope)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("service-handoff"),
        "wireVersion": SdnValue.String(handoff.wire_version), "sequence": SdnValue.Int(handoff.sequence),
        "scope": SdnValue.String(scope), "fromCurrentRelative": SdnValue.String(handoff.from_current_relative),
        "fromCurrentDigest": SdnValue.String(handoff.from_current_digest),
        "retainedOperationDigest": SdnValue.String(handoff.retained_operation_digest)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(source) > 16384: return Err("service-handoff-source-size")
    Ok(source)

pub fn host_service_handoff_digest_v1(handoff: HostServiceHandoffV1) -> Result<text, text>:
    Ok(sha256_text(host_service_handoff_bytes_v1(handoff)?))

pub fn host_service_handoff_decode_v1(source: text) -> Result<HostServiceHandoffV1, text>:
    val fields = service_handoff_fields_v1(source, 16384, ["version", "kind", "wireVersion", "sequence", "scope",
        "fromCurrentRelative", "fromCurrentDigest", "retainedOperationDigest"])?
    if service_handoff_integer_v1(fields, "version")? != 1 or service_handoff_text_v1(fields, "kind")? != "service-handoff":
        return Err("service-handoff-version-unsupported")
    val handoff = HostServiceHandoffV1(wire_version: service_handoff_text_v1(fields, "wireVersion")?,
        sequence: service_handoff_integer_v1(fields, "sequence")?,
        scope: container_host_scope_decode_v2(service_handoff_text_v1(fields, "scope")?)?,
        from_current_relative: service_handoff_text_v1(fields, "fromCurrentRelative")?,
        from_current_digest: service_handoff_text_v1(fields, "fromCurrentDigest")?,
        retained_operation_digest: service_handoff_text_v1(fields, "retainedOperationDigest")?)
    if host_service_handoff_bytes_v1(handoff)? != source: return Err("service-handoff-noncanonical")
    Ok(handoff)

# The signed envelope must be the `service-handoff` kind, name this exact record by digest, and be for this host.
pub fn host_service_handoff_match_v1(handoff: HostServiceHandoffV1, operation: OperationEnvelopeV2) -> Result<bool, text>:
    val canonical = distributed_encode_operation_v2(operation)?
    if (operation.operation != HOST_SERVICE_HANDOFF_OPERATION_V1 or operation.payload_digest != host_service_handoff_digest_v1(handoff)? or
            not builder_identifier_valid_v1(operation.id) or operation.host_id != handoff.scope.physical_host_id):
        return Err("service-handoff-operation-mismatch")
    Ok(true)

pub fn host_service_handoff_proof_encode_v1(proof: HostServiceHandoffProofV1) -> Result<text, text>:
    val matched = host_service_handoff_match_v1(proof.handoff, proof.operation)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("service-handoff-proof"),
        "handoff": SdnValue.String(host_service_handoff_bytes_v1(proof.handoff)?),
        "operation": SdnValue.String(distributed_encode_operation_v2(proof.operation)?),
        "signedGrant": SdnValue.String(distributed_encode_signed_grant_v2(proof.signed)?),
        "signedApproval": SdnValue.String(distributed_encode_signed_approval_v2(proof.approval)?)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if str_len(source) > 262144: return Err("service-handoff-proof-size")
    Ok(source)

pub fn host_service_handoff_proof_decode_v1(source: text) -> Result<HostServiceHandoffProofV1, text>:
    val fields = service_handoff_fields_v1(source, 262144, ["version", "kind", "handoff", "operation", "signedGrant", "signedApproval"])?
    if service_handoff_integer_v1(fields, "version")? != 1 or service_handoff_text_v1(fields, "kind")? != "service-handoff-proof":
        return Err("service-handoff-version-unsupported")
    val proof = HostServiceHandoffProofV1(handoff: host_service_handoff_decode_v1(service_handoff_text_v1(fields, "handoff")?)?,
        operation: distributed_decode_operation_v2(service_handoff_text_v1(fields, "operation")?)?,
        signed: distributed_decode_signed_grant_v2(service_handoff_text_v1(fields, "signedGrant")?)?,
        approval: distributed_decode_signed_approval_v2(service_handoff_text_v1(fields, "signedApproval")?)?)
    if host_service_handoff_proof_encode_v1(proof)? != source: return Err("service-handoff-proof-noncanonical")
    Ok(proof)
