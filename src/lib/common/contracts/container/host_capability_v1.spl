# Portable, value-only host capability contract. The platform leaf owns probe
# evidence and any delegated broker authorization. A matching value is useful
# for selection; it is not permission to create or start a workload.

pub const CONTAINER_CLIENT_PRIVILEGE_USER_V1 = "user"
pub const CONTAINER_CLIENT_PRIVILEGE_DELEGATED_V1 = "delegated"
pub const CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1 = "unavailable"

pub const CONTAINER_ISOLATION_NATIVE_V1 = "native-container"
pub const CONTAINER_ISOLATION_NATIVE_SANDBOX_V1 = "native-sandbox"
pub const CONTAINER_ISOLATION_VM_V1 = "virtual-machine"

pub struct ContainerHostCapabilityV1:
    host_os: text
    # Legacy field name: this is the workload execution OS. Native routes
    # require it to equal host_os; Simple Container does not run a guest VM.
    guest_os: text
    provider_id: text
    isolation_class: text
    client_privilege: text
    admin_setup: bool
    launch_capable: bool
    reason: text

pub struct ContainerHostRequirementV1:
    host_os: text
    guest_os: text
    isolation_class: text
    require_unprivileged_client: bool

fn _known_container_os_v1(value: text) -> bool:
    value == "linux" or value == "windows" or value == "freebsd" or
        value == "macos" or value == "simpleos"

# An empty result means that the provider's observed values admit this exact
# requirement. It does not attest that the caller may launch: delegated
# providers must check current scoped broker authorization at the leaf.
# Both user and delegated routes may keep the caller unprivileged. The
# admin_setup bit reports prior privileged setup; it does not authorize a
# delegated launch or make that route rootless.
pub fn container_host_admission_reason_v1(
        capability: ContainerHostCapabilityV1,
        requirement: ContainerHostRequirementV1) -> text:
    if capability.host_os == "" or capability.guest_os == "" or
            capability.provider_id == "":
        return "host-capability-identity-missing"
    if requirement.host_os == "" or requirement.guest_os == "":
        return "host-requirement-identity-missing"
    if not _known_container_os_v1(capability.host_os) or
            not _known_container_os_v1(capability.guest_os):
        return "host-capability-os-unsupported"
    if not _known_container_os_v1(requirement.host_os) or
            not _known_container_os_v1(requirement.guest_os):
        return "host-requirement-os-unsupported"
    if capability.isolation_class != CONTAINER_ISOLATION_NATIVE_V1 and
            capability.isolation_class != CONTAINER_ISOLATION_NATIVE_SANDBOX_V1 and
            capability.isolation_class != CONTAINER_ISOLATION_VM_V1:
        return "host-isolation-unsupported"
    if requirement.isolation_class != CONTAINER_ISOLATION_NATIVE_V1 and
            requirement.isolation_class != CONTAINER_ISOLATION_NATIVE_SANDBOX_V1 and
            requirement.isolation_class != CONTAINER_ISOLATION_VM_V1:
        return "required-isolation-unsupported"
    if capability.isolation_class == CONTAINER_ISOLATION_VM_V1 or
            requirement.isolation_class == CONTAINER_ISOLATION_VM_V1:
        return "virtual-machine-not-simple-container"
    if capability.client_privilege != CONTAINER_CLIENT_PRIVILEGE_USER_V1 and
            capability.client_privilege != CONTAINER_CLIENT_PRIVILEGE_DELEGATED_V1 and
            capability.client_privilege != CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1:
        return "host-client-privilege-invalid"
    if capability.host_os != requirement.host_os or
            capability.guest_os != requirement.guest_os:
        return "host-guest-os-mismatch"
    if capability.host_os != capability.guest_os:
        return "native-host-execution-os-mismatch"
    if capability.host_os == "macos" and
            capability.isolation_class == CONTAINER_ISOLATION_NATIVE_V1:
        return "macos-native-container-unsupported"
    if capability.host_os != "macos" and
            capability.isolation_class == CONTAINER_ISOLATION_NATIVE_SANDBOX_V1:
        return "native-sandbox-host-unsupported"
    if capability.isolation_class != requirement.isolation_class:
        return "host-isolation-mismatch"
    if not capability.launch_capable:
        return "host-launch-unavailable"
    if requirement.require_unprivileged_client and
            capability.client_privilege == CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1:
        return "unprivileged-client-unavailable"
    if capability.client_privilege == CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1:
        return "host-launch-unavailable"
    ""

export ContainerHostCapabilityV1, ContainerHostRequirementV1
export container_host_admission_reason_v1
export CONTAINER_CLIENT_PRIVILEGE_USER_V1, CONTAINER_CLIENT_PRIVILEGE_DELEGATED_V1
export CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1
export CONTAINER_ISOLATION_NATIVE_V1, CONTAINER_ISOLATION_NATIVE_SANDBOX_V1
export CONTAINER_ISOLATION_VM_V1
