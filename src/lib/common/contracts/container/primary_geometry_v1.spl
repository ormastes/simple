# Geometry request/receipt metadata. No decoder establishes live authority.
use std.common.contracts.mux.session_runtime_control_v1.{SessionRuntimeControlLeaseV1,
    SessionRuntimeControlTargetV1, SessionRuntimeControlKindV1, session_runtime_control_lease_check_v1,
    session_runtime_control_target_bytes_v1}
use std.common.build_manager.contracts.builder_digest_valid_v1
use std.common.crypto.sha256.sha256_text

pub struct ContainerPrimaryGeometryRequestV1:
    lease: SessionRuntimeControlLeaseV1
    target: SessionRuntimeControlTargetV1
    principal: text
    nonce: text
    attempt_sequence: i64
    columns: i64
    rows: i64
    request_digest: text

pub fn container_primary_geometry_request_check_v1(request: ContainerPrimaryGeometryRequestV1,
        now_ms: i64) -> Result<(), text>:
    if (request.attempt_sequence < 1 or request.attempt_sequence > 1152921504606846975 or
            request.columns < 1 or request.columns > 512 or request.rows < 1 or request.rows > 256 or
            request.columns * request.rows > 60000 or not builder_digest_valid_v1(request.request_digest) or
            request.lease.revision <= 0 or request.lease.revision > 1152921504606846975 or
            request.lease.expires_monotonic_ms > 1152921504606846975):
        return Err("primary-geometry-request-bound")
    session_runtime_control_lease_check_v1(request.lease, request.target, SessionRuntimeControlKindV1.Geometry,
        request.principal, sha256_text(request.nonce), request.lease.revision, now_ms)

pub fn container_primary_geometry_request_same_v1(left: ContainerPrimaryGeometryRequestV1,
        right: ContainerPrimaryGeometryRequestV1) -> Result<bool, text>:
    Ok(left.request_digest == right.request_digest and left.attempt_sequence == right.attempt_sequence and
        left.columns == right.columns and left.rows == right.rows and left.principal == right.principal and
        left.nonce == right.nonce and left.lease.kind == right.lease.kind and
        left.lease.principal_id == right.lease.principal_id and left.lease.revision == right.lease.revision and
        left.lease.nonce_digest == right.lease.nonce_digest and
        left.lease.issued_monotonic_ms == right.lease.issued_monotonic_ms and
        left.lease.expires_monotonic_ms == right.lease.expires_monotonic_ms and
        session_runtime_control_target_bytes_v1(left.target)? == session_runtime_control_target_bytes_v1(right.target)? and
        session_runtime_control_target_bytes_v1(left.lease.target)? == session_runtime_control_target_bytes_v1(right.lease.target)?)
