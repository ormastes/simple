# Host-neutral sandbox canary comparison (extracted from the macOS Seatbelt
# qualification model; S0 of the pure-Simple container plan). Pure: QUALIFIED
# only when every planned canary has a recorded result equal to its
# expectation and carrying a valid evidence digest. Provider-specific plans,
# manifests and reason prefixes stay in the provider.

use std.common.build_manager.contracts.builder_digest_valid_v1

pub const SANDBOX_CANARY_QUALIFIED_V1 = "qualified"
pub const SANDBOX_CANARY_UNQUALIFIED_V1 = "unqualified"
pub const SANDBOX_CANARY_REASON_NOT_PASSED_V1 = "canaries-not-passed"

pub struct SandboxCanaryPlanV1:
    id: text
    expected: text
    requirement: text

pub struct SandboxCanaryResultV1:
    id: text
    observed: text
    evidence_digest: text

pub struct SandboxCanaryStatusV1:
    status: text
    missing: [text]
    reason: text

pub fn sandbox_canary_status_v1(plan: [SandboxCanaryPlanV1],
        results: [SandboxCanaryResultV1]) -> SandboxCanaryStatusV1:
    var missing: [text] = []
    for canary in plan:
        var passed = false
        for result in results:
            if result.id == canary.id and result.observed == canary.expected and
                    builder_digest_valid_v1(result.evidence_digest):
                passed = true
        if not passed: missing.push(canary.id)
    if missing.len() > 0:
        return SandboxCanaryStatusV1(status: SANDBOX_CANARY_UNQUALIFIED_V1, missing: missing,
            reason: SANDBOX_CANARY_REASON_NOT_PASSED_V1)
    SandboxCanaryStatusV1(status: SANDBOX_CANARY_QUALIFIED_V1, missing: [], reason: "")

export SandboxCanaryPlanV1, SandboxCanaryResultV1, SandboxCanaryStatusV1, sandbox_canary_status_v1
export SANDBOX_CANARY_QUALIFIED_V1, SANDBOX_CANARY_UNQUALIFIED_V1, SANDBOX_CANARY_REASON_NOT_PASSED_V1
