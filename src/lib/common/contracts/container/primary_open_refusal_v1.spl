# milestone_0022 N3 (DESIGN 15.2, 16, 17(A)(B)): the typed reason a primary-attach
# open returned no native owner. Shared by the sync machine provider and the async
# container layer. DATA only: it is never a grant. ONLY `NoCustody` (refused before
# the provider captured primary custody) and `SpawnRejectedRetired` (a real spawn
# Rejected whose provider retirement was confirmed) may authorize the Host refusal
# record; `CustodyAdvanced` and the untyped `NotRefused` never do.
pub enum ContainerPrimaryOpenRefusalV1:
    NotRefused
    NoCustody
    SpawnRejectedRetired
    CustodyAdvanced(reason: text)

# allow(primitive_api): reviewed DATA predicate over a closed enum (milestone_0022 N3)
pub fn container_primary_open_refusal_authorizes_v1(refusal: ContainerPrimaryOpenRefusalV1) -> bool:
    match refusal:
        case ContainerPrimaryOpenRefusalV1.NoCustody: true
        case ContainerPrimaryOpenRefusalV1.SpawnRejectedRetired: true
        case _: false
