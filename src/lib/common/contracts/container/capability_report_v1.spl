# Container capability report contract (architecture simple_container_improvement
# §4.2). Value-only: the platform leaf owns probing, evidence, and any delegated
# broker authorization; this module only carries the reported values and the
# fail-closed admission decision. Simple has no trait syntax, so the
# report/requirement pair plus the admission reason function is the portable
# contract; a matching value is never permission to create or start a workload.
#
# Admission is fail-closed: a required capability is admitted only when the
# report affirms it and the report carries a non-empty evidence_revision. A
# requirement for memory_hard_limit (or limit update/reclaim/accounting) is
# admitted only with a known non-empty memory_accounting kind; unknown
# accounting kinds are rejected, never weakened to a convenient numeric knob,
# and a requirement is never silently weakened.

pub const CONTAINER_CLIENT_AUTHORITY_USER_V1 = "user"
pub const CONTAINER_CLIENT_AUTHORITY_DELEGATED_V1 = "delegated"
pub const CONTAINER_CLIENT_AUTHORITY_UNAVAILABLE_V1 = "unavailable"

pub const CONTAINER_ISOLATION_KIND_NATIVE_V1 = "native-container"
pub const CONTAINER_ISOLATION_KIND_NATIVE_SANDBOX_V1 = "native-sandbox"
pub const CONTAINER_ISOLATION_KIND_VM_V1 = "virtual-machine"

pub const CONTAINER_MEMORY_ACCOUNTING_CGROUP_V1 = "cgroup"
pub const CONTAINER_MEMORY_ACCOUNTING_JOB_COMMIT_V1 = "job-commit"
pub const CONTAINER_MEMORY_ACCOUNTING_JAIL_RSS_V1 = "jail-rss"
pub const CONTAINER_MEMORY_ACCOUNTING_SIMPLEOS_DOMAIN_V1 = "simpleos-domain"

# Observed/required capability bit; a domain unit, never a bare bool.
pub unit ContainerCapabilityFlagV1: bool

pub struct ContainerCapabilityReportV1:
    host_os: text
    host_arch: text
    guest_abi: text
    isolation_kind: text
    client_authority: text
    launch_qualified: ContainerCapabilityFlagV1
    filesystem_confinement: ContainerCapabilityFlagV1
    root_view_kind: text
    ephemeral_cleanup: ContainerCapabilityFlagV1
    durable_recovery: ContainerCapabilityFlagV1
    memory_accounting: text
    memory_hard_limit: ContainerCapabilityFlagV1
    memory_limit_update: ContainerCapabilityFlagV1
    memory_reclaim: ContainerCapabilityFlagV1
    readonly_file_backing_reuse: ContainerCapabilityFlagV1
    explicit_shared_memory: ContainerCapabilityFlagV1
    filesystem_save_load: ContainerCapabilityFlagV1
    process_checkpoint: ContainerCapabilityFlagV1
    provider_version: text
    evidence_revision: text

# required_* mirrors the report's enforceable fields. An empty text or false
# bool imposes no constraint; a set field must be affirmed by the report.
pub struct ContainerCapabilityRequirementV1:
    required_host_os: text
    required_host_arch: text
    required_guest_abi: text
    required_isolation_kind: text
    required_client_authority: text
    required_launch_qualified: ContainerCapabilityFlagV1
    required_filesystem_confinement: ContainerCapabilityFlagV1
    required_root_view_kind: text
    required_ephemeral_cleanup: ContainerCapabilityFlagV1
    required_durable_recovery: ContainerCapabilityFlagV1
    required_memory_accounting: text
    required_memory_hard_limit: ContainerCapabilityFlagV1
    required_memory_limit_update: ContainerCapabilityFlagV1
    required_memory_reclaim: ContainerCapabilityFlagV1
    required_readonly_file_backing_reuse: ContainerCapabilityFlagV1
    required_explicit_shared_memory: ContainerCapabilityFlagV1
    required_filesystem_save_load: ContainerCapabilityFlagV1
    required_process_checkpoint: ContainerCapabilityFlagV1

fn _known_container_os_v1(value: text) -> bool:
    value == "linux" or value == "windows" or value == "freebsd" or
        value == "macos" or value == "simpleos"

fn _known_isolation_kind_v1(value: text) -> bool:
    value == CONTAINER_ISOLATION_KIND_NATIVE_V1 or
        value == CONTAINER_ISOLATION_KIND_NATIVE_SANDBOX_V1 or
        value == CONTAINER_ISOLATION_KIND_VM_V1

fn _known_client_authority_v1(value: text) -> bool:
    value == CONTAINER_CLIENT_AUTHORITY_USER_V1 or
        value == CONTAINER_CLIENT_AUTHORITY_DELEGATED_V1 or
        value == CONTAINER_CLIENT_AUTHORITY_UNAVAILABLE_V1

fn _known_memory_accounting_v1(value: text) -> bool:
    value == CONTAINER_MEMORY_ACCOUNTING_CGROUP_V1 or
        value == CONTAINER_MEMORY_ACCOUNTING_JOB_COMMIT_V1 or
        value == CONTAINER_MEMORY_ACCOUNTING_JAIL_RSS_V1 or
        value == CONTAINER_MEMORY_ACCOUNTING_SIMPLEOS_DOMAIN_V1

pub fn container_capability_report_v1_empty() -> ContainerCapabilityReportV1:
    ContainerCapabilityReportV1(host_os: "", host_arch: "", guest_abi: "",
        isolation_kind: "", client_authority: "", launch_qualified: ContainerCapabilityFlagV1(false),
        filesystem_confinement: ContainerCapabilityFlagV1(false), root_view_kind: "",
        ephemeral_cleanup: ContainerCapabilityFlagV1(false), durable_recovery: ContainerCapabilityFlagV1(false),
        memory_accounting: "", memory_hard_limit: ContainerCapabilityFlagV1(false),
        memory_limit_update: ContainerCapabilityFlagV1(false), memory_reclaim: ContainerCapabilityFlagV1(false),
        readonly_file_backing_reuse: ContainerCapabilityFlagV1(false), explicit_shared_memory: ContainerCapabilityFlagV1(false),
        filesystem_save_load: ContainerCapabilityFlagV1(false), process_checkpoint: ContainerCapabilityFlagV1(false),
        provider_version: "", evidence_revision: "")

pub fn container_capability_requirement_v1_empty() -> ContainerCapabilityRequirementV1:
    ContainerCapabilityRequirementV1(required_host_os: "", required_host_arch: "",
        required_guest_abi: "", required_isolation_kind: "",
        required_client_authority: "", required_launch_qualified: ContainerCapabilityFlagV1(false),
        required_filesystem_confinement: ContainerCapabilityFlagV1(false), required_root_view_kind: "",
        required_ephemeral_cleanup: ContainerCapabilityFlagV1(false), required_durable_recovery: ContainerCapabilityFlagV1(false),
        required_memory_accounting: "", required_memory_hard_limit: ContainerCapabilityFlagV1(false),
        required_memory_limit_update: ContainerCapabilityFlagV1(false), required_memory_reclaim: ContainerCapabilityFlagV1(false),
        required_readonly_file_backing_reuse: ContainerCapabilityFlagV1(false),
        required_explicit_shared_memory: ContainerCapabilityFlagV1(false),
        required_filesystem_save_load: ContainerCapabilityFlagV1(false), required_process_checkpoint: ContainerCapabilityFlagV1(false))

fn _requirement_constrains_v1(requirement: ContainerCapabilityRequirementV1) -> bool:
    requirement.required_host_os != "" or requirement.required_host_arch != "" or
        requirement.required_guest_abi != "" or
        requirement.required_isolation_kind != "" or
        requirement.required_client_authority != "" or
        requirement.required_launch_qualified.value or
        requirement.required_filesystem_confinement.value or
        requirement.required_root_view_kind != "" or
        requirement.required_ephemeral_cleanup.value or
        requirement.required_durable_recovery.value or
        requirement.required_memory_accounting != "" or
        requirement.required_memory_hard_limit.value or
        requirement.required_memory_limit_update.value or
        requirement.required_memory_reclaim.value or
        requirement.required_readonly_file_backing_reuse.value or
        requirement.required_explicit_shared_memory.value or
        requirement.required_filesystem_save_load.value or
        requirement.required_process_checkpoint.value

# An empty result means the report's observed values admit this exact
# requirement. It does not attest that the caller may launch: delegated
# providers must check current scoped broker authorization at the leaf, and
# the evidence_revision only names the evidence the leaf must still hold.
pub fn container_capability_v1_admission_reason(
        report: ContainerCapabilityReportV1,
        requirement: ContainerCapabilityRequirementV1) -> text:
    if report.host_os == "" or report.host_arch == "" or
            report.guest_abi == "" or report.isolation_kind == "" or
            report.client_authority == "":
        return "capability-report-identity-missing"
    if not _known_container_os_v1(report.host_os):
        return "capability-report-os-unsupported"
    if not _known_isolation_kind_v1(report.isolation_kind):
        return "capability-report-isolation-unsupported"
    if not _known_client_authority_v1(report.client_authority):
        return "capability-report-client-authority-invalid"
    if report.memory_accounting != "" and
            not _known_memory_accounting_v1(report.memory_accounting):
        return "capability-report-memory-accounting-unknown"
    if requirement.required_host_os != "" and
            not _known_container_os_v1(requirement.required_host_os):
        return "capability-requirement-os-unsupported"
    if requirement.required_isolation_kind != "" and
            not _known_isolation_kind_v1(requirement.required_isolation_kind):
        return "capability-requirement-isolation-unsupported"
    if requirement.required_client_authority != "" and
            not _known_client_authority_v1(requirement.required_client_authority):
        return "capability-requirement-client-authority-invalid"
    if requirement.required_memory_accounting != "" and
            not _known_memory_accounting_v1(requirement.required_memory_accounting):
        return "capability-requirement-memory-accounting-unknown"
    if _requirement_constrains_v1(requirement) and report.evidence_revision == "":
        return "capability-evidence-missing"
    if requirement.required_host_os != "" and
            requirement.required_host_os != report.host_os:
        return "host-os-mismatch"
    if requirement.required_host_arch != "" and
            requirement.required_host_arch != report.host_arch:
        return "host-arch-mismatch"
    if requirement.required_guest_abi != "" and
            requirement.required_guest_abi != report.guest_abi:
        return "guest-abi-mismatch"
    if requirement.required_isolation_kind != "" and
            requirement.required_isolation_kind != report.isolation_kind:
        return "isolation-kind-mismatch"
    if requirement.required_client_authority != "" and
            requirement.required_client_authority != report.client_authority:
        return "client-authority-mismatch"
    if requirement.required_root_view_kind != "" and
            requirement.required_root_view_kind != report.root_view_kind:
        return "root-view-kind-mismatch"
    if requirement.required_memory_accounting != "" and
            requirement.required_memory_accounting != report.memory_accounting:
        return "memory-accounting-mismatch"
    # A report cannot be launch-qualified while it has no client authority.
    if requirement.required_launch_qualified.value and
            report.client_authority == CONTAINER_CLIENT_AUTHORITY_UNAVAILABLE_V1:
        return "client-authority-unavailable"
    if requirement.required_launch_qualified.value and not report.launch_qualified.value:
        return "launch-qualification-missing"
    if requirement.required_filesystem_confinement.value and
            not report.filesystem_confinement.value:
        return "filesystem-confinement-missing"
    if requirement.required_ephemeral_cleanup.value and not report.ephemeral_cleanup.value:
        return "ephemeral-cleanup-missing"
    if requirement.required_durable_recovery.value and not report.durable_recovery.value:
        return "durable-recovery-missing"
    if requirement.required_memory_hard_limit.value and not report.memory_hard_limit.value:
        return "memory-hard-limit-missing"
    if requirement.required_memory_limit_update.value and not report.memory_limit_update.value:
        return "memory-limit-update-missing"
    if requirement.required_memory_reclaim.value and not report.memory_reclaim.value:
        return "memory-reclaim-missing"
    if requirement.required_readonly_file_backing_reuse.value and
            not report.readonly_file_backing_reuse.value:
        return "readonly-file-backing-reuse-missing"
    if requirement.required_explicit_shared_memory.value and
            not report.explicit_shared_memory.value:
        return "explicit-shared-memory-missing"
    if requirement.required_filesystem_save_load.value and
            not report.filesystem_save_load.value:
        return "filesystem-save-load-missing"
    if requirement.required_process_checkpoint.value and not report.process_checkpoint.value:
        return "process-checkpoint-missing"
    if (requirement.required_memory_hard_limit.value or
            requirement.required_memory_limit_update.value or
            requirement.required_memory_reclaim.value or
            requirement.required_memory_accounting != "") and
            report.memory_accounting == "":
        return "memory-accounting-missing"
    ""

export ContainerCapabilityFlagV1
export ContainerCapabilityReportV1, ContainerCapabilityRequirementV1
export container_capability_v1_admission_reason
export container_capability_report_v1_empty, container_capability_requirement_v1_empty
export CONTAINER_CLIENT_AUTHORITY_USER_V1, CONTAINER_CLIENT_AUTHORITY_DELEGATED_V1
export CONTAINER_CLIENT_AUTHORITY_UNAVAILABLE_V1
export CONTAINER_ISOLATION_KIND_NATIVE_V1, CONTAINER_ISOLATION_KIND_NATIVE_SANDBOX_V1
export CONTAINER_ISOLATION_KIND_VM_V1
export CONTAINER_MEMORY_ACCOUNTING_CGROUP_V1, CONTAINER_MEMORY_ACCOUNTING_JOB_COMMIT_V1
export CONTAINER_MEMORY_ACCOUNTING_JAIL_RSS_V1, CONTAINER_MEMORY_ACCOUNTING_SIMPLEOS_DOMAIN_V1
