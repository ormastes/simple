# Pure-Simple container backend identity and capability mapping (architecture
# pure_simple_container 6). Maps what a SOSIX variant reports it enforces
# (SosixContainSupportV1) plus measured evidence onto the existing
# ContainerCapabilityReportV1. Fields not mapped stay false: nothing is
# affirmed that was not measured.

use std.common.contracts.container.capability_report_v1.{ContainerCapabilityReportV1,
    ContainerCapabilityFlagV1, container_capability_report_v1_empty,
    CONTAINER_CLIENT_AUTHORITY_USER_V1, CONTAINER_CLIENT_AUTHORITY_DELEGATED_V1,
    CONTAINER_CLIENT_AUTHORITY_UNAVAILABLE_V1,
    CONTAINER_ISOLATION_KIND_NATIVE_V1, CONTAINER_ISOLATION_KIND_NATIVE_SANDBOX_V1}
use std.common.contracts.container.backend_identity_v1.{CONTAINER_BACKEND_SIMPLE_PURE_PROCESS_V1,
    CONTAINER_ENGINE_SIMPLE_PURE_CONTAINER_V1}
use std.common.contracts.sosix.containment_v1.{SosixContainSupportV1, SosixContainQualifyResultV1,
    sosix_contain_canary_pass_v1,
    SOSIX_CONTAIN_CANARY_LAUNCH_EXIT_V1, SOSIX_CONTAIN_CANARY_TREE_EMPTY_V1,
    SOSIX_CONTAIN_CANARY_OWN_WRITE_V1, SOSIX_CONTAIN_CANARY_LOWER_READ_EXEC_V1,
    SOSIX_CONTAIN_CANARY_LOWER_WRITE_V1, SOSIX_CONTAIN_CANARY_USER_PRIVATE_WRITE_V1,
    SOSIX_CONTAIN_CANARY_OTHER_SCOPE_WRITE_V1, SOSIX_CONTAIN_CANARY_OTHER_SCOPE_PROCESS_V1,
    SOSIX_CONTAIN_CANARY_PROCESS_LIMIT_V1}
use std.common.crypto.sha256.{sha256_text}

# Explicit ': text' kept for frozen Stage 2/3 cold HIR receipt capture
# (cold-hir-abi-unresolved:unresolved-inference on aliased imported constants).
# @workaround bug=p3_cold_hir_unresolved_public_interfaces_2026-10-05 reason=ROOT-FIXED+STAGE3-GATED: pure-Simple surface const inference fixed (w8-2); keep explicit ': text' until Stage 3 native rebuild completes
pub const PURE_CONTAINER_BACKEND_V1: text = CONTAINER_BACKEND_SIMPLE_PURE_PROCESS_V1
pub const PURE_CONTAINER_ENGINE_V1: text = CONTAINER_ENGINE_SIMPLE_PURE_CONTAINER_V1
pub const PURE_CONTAINER_ROOT_VIEW_SPLIT_V1 = "hardlink-lower-split-upper"

pub struct PureContainerEvidenceV1:
    host_os: text
    host_arch: text
    guest_abi: text
    root_view_kind: text
    memory_cap_enforced: ContainerCapabilityFlagV1   # measured verdict only
    write_confinement_observed: ContainerCapabilityFlagV1   # measured: own-dir-write, lower-read-exec and the five deny canaries
    base_fully_linked: ContainerCapabilityFlagV1
    launch_observed: ContainerCapabilityFlagV1
    cleanup_observed: ContainerCapabilityFlagV1
    roots_digest: text
    evidence_revision: text
# The support contract has no availability field: a variant that enforces no
# axis at all (sosix_contain_support_none_v1, whatever mechanism name it
# carries) is unavailable.
fn _pure_support_available_v1(support: SosixContainSupportV1) -> bool:
    support.memory_hard_limit.value or support.process_limit.value or
        support.cpu_rate_limit.value or support.kill_all_descendants.value or
        support.write_confinement.value or support.read_confinement.value or
        support.network_isolation.value or support.pid_isolation.value or
        support.root_remap.value

fn _pure_client_authority_v1(support: SosixContainSupportV1) -> text:
    if not _pure_support_available_v1(support): return CONTAINER_CLIENT_AUTHORITY_UNAVAILABLE_V1
    if support.unprivileged.value: return CONTAINER_CLIENT_AUTHORITY_USER_V1
    CONTAINER_CLIENT_AUTHORITY_DELEGATED_V1

pub fn pure_container_capability_report_v1(support: SosixContainSupportV1,
        evidence: PureContainerEvidenceV1) -> ContainerCapabilityReportV1:
    var report = container_capability_report_v1_empty()
    val confined_write = support.write_confinement.value
    val confined_read = support.read_confinement.value
    val full = confined_write and confined_read and support.network_isolation.value and
        support.pid_isolation.value and support.root_remap.value
    report.host_os = evidence.host_os
    report.host_arch = evidence.host_arch
    report.guest_abi = evidence.guest_abi
    report.isolation_kind = if full: CONTAINER_ISOLATION_KIND_NATIVE_V1 else: CONTAINER_ISOLATION_KIND_NATIVE_SANDBOX_V1
    report.client_authority = _pure_client_authority_v1(support)
    report.launch_qualified = ContainerCapabilityFlagV1(evidence.launch_observed.value)
    report.filesystem_confinement = ContainerCapabilityFlagV1(confined_write and confined_read)
    report.root_view_kind = evidence.root_view_kind
    report.ephemeral_cleanup = ContainerCapabilityFlagV1(evidence.cleanup_observed.value)
    report.memory_accounting = support.memory_accounting
    report.memory_hard_limit = ContainerCapabilityFlagV1(
        support.memory_hard_limit.value and evidence.memory_cap_enforced.value)
    report.readonly_file_backing_reuse = ContainerCapabilityFlagV1(evidence.base_fully_linked.value)
    report.filesystem_save_load = ContainerCapabilityFlagV1(true)
    report.provider_version = PURE_CONTAINER_ENGINE_V1
    report.evidence_revision = evidence.evidence_revision
    report
# The one producer of evidence fields. Every flag derives from the qualify
# result alone (memory from its own evidence); a qualify run that did not
# complete or produced no evidence digest affirms nothing.
pub fn pure_container_evidence_from_qualify_v1(qualify: SosixContainQualifyResultV1,
        memory_enforced: ContainerCapabilityFlagV1, memory_digest: text,
        host_os: text, host_arch: text, guest_abi: text, root_view_kind: text,
        roots_digest: text) -> PureContainerEvidenceV1:
    val ran = qualify.reason == "" and qualify.evidence_digest != ""
    val launch = ran and sosix_contain_canary_pass_v1(qualify, SOSIX_CONTAIN_CANARY_LAUNCH_EXIT_V1).value
    val cleanup = ran and sosix_contain_canary_pass_v1(qualify, SOSIX_CONTAIN_CANARY_TREE_EMPTY_V1).value
    var write_ok = ran
    for id in [SOSIX_CONTAIN_CANARY_OWN_WRITE_V1, SOSIX_CONTAIN_CANARY_LOWER_READ_EXEC_V1,
            SOSIX_CONTAIN_CANARY_LOWER_WRITE_V1, SOSIX_CONTAIN_CANARY_USER_PRIVATE_WRITE_V1,
            SOSIX_CONTAIN_CANARY_OTHER_SCOPE_WRITE_V1, SOSIX_CONTAIN_CANARY_OTHER_SCOPE_PROCESS_V1,
            SOSIX_CONTAIN_CANARY_PROCESS_LIMIT_V1]:
        if not sosix_contain_canary_pass_v1(qualify, id).value: write_ok = false
    val memory = ran and memory_enforced.value and memory_digest != ""
    val revision = if not ran:
        ""
    else:
        "pure:" + sha256_text(qualify.evidence_digest + "\n" + memory_digest + "\n" + roots_digest)
    PureContainerEvidenceV1(host_os: host_os, host_arch: host_arch, guest_abi: guest_abi,
        root_view_kind: root_view_kind, memory_cap_enforced: ContainerCapabilityFlagV1(memory),
        write_confinement_observed: ContainerCapabilityFlagV1(write_ok),
        base_fully_linked: ContainerCapabilityFlagV1(false),
        launch_observed: ContainerCapabilityFlagV1(launch),
        cleanup_observed: ContainerCapabilityFlagV1(cleanup),
        roots_digest: roots_digest, evidence_revision: revision)


export PURE_CONTAINER_BACKEND_V1, PURE_CONTAINER_ENGINE_V1, PURE_CONTAINER_ROOT_VIEW_SPLIT_V1
export PureContainerEvidenceV1, pure_container_capability_report_v1, pure_container_evidence_from_qualify_v1
