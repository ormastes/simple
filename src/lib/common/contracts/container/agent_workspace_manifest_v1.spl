# Canonical bounded staging DATA. Never filesystem, mutation or execution authority.
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.common.build_manager.contracts.{builder_digest_valid_v1, builder_identifier_valid_v1}
use std.common.crypto.sha256.sha256_text

pub struct AgentWorkspaceFileV1:
    source_name: text
    relative_path: text
    digest: text
    size_bytes: i64

pub struct AgentWorkspaceManifestV1:
    profile_digest: text
    repository_ref: text
    revision_oid: text
    object_format: text
    source_manifest_digest: text
    slot_binding_digest: text
    attempt_leaf: text
    bootstrap_digest: text
    git_digest: text
    agent_digest: text
    files: [AgentWorkspaceFileV1]

#[allow(primitive_api)] reviewed DATA predicate/bound/umask word (milestone_0012 groupC)
pub fn agent_workspace_component_v1(value: text) -> bool:
    if value.byte_len() < 1 or value.byte_len() > 128 or value == "." or value == "..": return false
    for byte in value.bytes():
        if not ((byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or
                (byte >= 97 and byte <= 122) or byte == 45 or byte == 95 or byte == 46): return false
    true

#[allow(primitive_api)] reviewed DATA predicate/bound/umask word (milestone_0012 groupC)
pub fn agent_workspace_object_path_v1(path: text, format: text) -> bool:
    val parts = path.split("/")
    if parts.len() != 4 or parts[0] != "repo" or parts[1] != "objects": return false
    # Only loose objects initially. Packs/indexes require their own bounded parser profile.
    val count = if format == "sha1": 40 else: 64
    if parts[2].byte_len() != 2 or parts[3].byte_len() != count - 2: return false
    for byte in (parts[2] + parts[3]).bytes():
        if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102)): return false
    true

pub fn agent_workspace_files_value_v1(files: [AgentWorkspaceFileV1], format: text) -> Result<SdnValue, text>:
    if files.len() < 1 or files.len() > 32: return Err("agent-workspace-files-bound")
    var rows: [SdnValue] = []
    var seen: [text] = []
    var total: i64 = 0
    for file in files:
        if not agent_workspace_component_v1(file.source_name) or not agent_workspace_object_path_v1(file.relative_path, format):
            return Err("agent-workspace-file-path")
        if seen.contains(file.relative_path) or not builder_digest_valid_v1(file.digest) or file.size_bytes < 1 or file.size_bytes > 1048576:
            return Err("agent-workspace-file-bound")
        seen.push(file.relative_path)
        total = total + file.size_bytes
        if total > 8388608: return Err("agent-workspace-total-bound")
        val fields: Dict<text, SdnValue> = {"sourceName": SdnValue.String(file.source_name),
            "relativePath": SdnValue.String(file.relative_path), "digest": SdnValue.String(file.digest),
            "sizeBytes": SdnValue.Int(file.size_bytes)}
        rows.push(SdnValue.Dict(fields))
    Ok(SdnValue.Array(rows))

pub fn agent_workspace_files_digest_v1(files: [AgentWorkspaceFileV1], format: text) -> Result<text, text>:
    Ok(sha256_text(sdn_encode_canonical(agent_workspace_files_value_v1(files, format)?) + "\n"))

pub fn agent_workspace_manifest_encode_v1(value: AgentWorkspaceManifestV1) -> Result<text, text>:
    for digest in [value.profile_digest, value.source_manifest_digest, value.slot_binding_digest,
            value.bootstrap_digest, value.git_digest, value.agent_digest]:
        if not builder_digest_valid_v1(digest): return Err("agent-workspace-manifest-digest")
    if not builder_identifier_valid_v1(value.repository_ref) or not agent_workspace_component_v1(value.attempt_leaf):
        return Err("agent-workspace-manifest-reference")
    if value.object_format != "sha1" and value.object_format != "sha256": return Err("agent-workspace-object-format")
    val count = if value.object_format == "sha1": 40 else: 64
    if value.revision_oid.byte_len() != count: return Err("agent-workspace-revision")
    for byte in value.revision_oid.bytes():
        if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102)): return Err("agent-workspace-revision")
    val files = agent_workspace_files_value_v1(value.files, value.object_format)?
    if agent_workspace_files_digest_v1(value.files, value.object_format)? != value.source_manifest_digest:
        return Err("agent-workspace-source-manifest")
    val fields: Dict<text, SdnValue> = {"kind": SdnValue.String("agent-workspace-manifest"), "version": SdnValue.Int(1),
        "profileDigest": SdnValue.String(value.profile_digest), "repositoryRef": SdnValue.String(value.repository_ref),
        "revisionOid": SdnValue.String(value.revision_oid), "objectFormat": SdnValue.String(value.object_format),
        "sourceManifestDigest": SdnValue.String(value.source_manifest_digest), "slotBindingDigest": SdnValue.String(value.slot_binding_digest),
        "attemptLeaf": SdnValue.String(value.attempt_leaf), "bootstrapDigest": SdnValue.String(value.bootstrap_digest),
        "gitDigest": SdnValue.String(value.git_digest), "agentDigest": SdnValue.String(value.agent_digest), "files": files}
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")

pub fn agent_workspace_field_text_v1(fields: Dict<text, SdnValue>, key: text) -> Result<text, text>:
    if not fields.contains_key(key): return Err("agent-workspace-field:" + key)
    match fields[key]:
        case SdnValue.String(value): Ok(value)
        case _: Err("agent-workspace-text:" + key)

pub fn agent_workspace_manifest_decode_v1(source: text) -> Result<AgentWorkspaceManifestV1, text>:
    val parsed = match sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: 65536,
            max_depth: 4, max_nodes: 512, max_rows: 0, max_cells: 0, max_columns: 16)):
        case Ok(value): value
        case Err(_): return Err("agent-workspace-syntax")
    val fields = match parsed.value:
        case SdnValue.Dict(value): value
        case _: return Err("agent-workspace-object")
    if fields.len() != 13 or not fields.contains_key("kind") or not fields.contains_key("version") or not fields.contains_key("files"):
        return Err("agent-workspace-fields")
    if fields["kind"] != SdnValue.String("agent-workspace-manifest") or fields["version"] != SdnValue.Int(1): return Err("agent-workspace-version")
    val rows = match fields["files"]:
        case SdnValue.Array(value): value
        case _: return Err("agent-workspace-files")
    var files: [AgentWorkspaceFileV1] = []
    for row in rows:
        val entry = match row:
            case SdnValue.Dict(value): value
            case _: return Err("agent-workspace-file-object")
        if entry.len() != 4 or not entry.contains_key("sizeBytes"): return Err("agent-workspace-file-fields")
        val size = match entry["sizeBytes"]:
            case SdnValue.Int(value): value
            case _: return Err("agent-workspace-file-size")
        files.push(AgentWorkspaceFileV1(source_name: agent_workspace_field_text_v1(entry, "sourceName")?,
            relative_path: agent_workspace_field_text_v1(entry, "relativePath")?, digest: agent_workspace_field_text_v1(entry, "digest")?, size_bytes: size))
    val value = AgentWorkspaceManifestV1(profile_digest: agent_workspace_field_text_v1(fields, "profileDigest")?,
        repository_ref: agent_workspace_field_text_v1(fields, "repositoryRef")?, revision_oid: agent_workspace_field_text_v1(fields, "revisionOid")?,
        object_format: agent_workspace_field_text_v1(fields, "objectFormat")?, source_manifest_digest: agent_workspace_field_text_v1(fields, "sourceManifestDigest")?,
        slot_binding_digest: agent_workspace_field_text_v1(fields, "slotBindingDigest")?, attempt_leaf: agent_workspace_field_text_v1(fields, "attemptLeaf")?,
        bootstrap_digest: agent_workspace_field_text_v1(fields, "bootstrapDigest")?, git_digest: agent_workspace_field_text_v1(fields, "gitDigest")?,
        agent_digest: agent_workspace_field_text_v1(fields, "agentDigest")?, files: files)
    if agent_workspace_manifest_encode_v1(value)? != source: return Err("agent-workspace-noncanonical")
    Ok(value)
