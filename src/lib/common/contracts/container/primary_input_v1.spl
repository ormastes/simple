# Pure correlation/bounds only; an input lease is not minted by this module.
use std.common.contracts.container.primary_attach_v1.{ContainerPrimaryAttachPlanV1, container_primary_attach_plan_digest_v1}
use std.common.contracts.container.execution_v2.{ContainerHostScopeV2, container_host_scope_bytes_v2}
use std.common.contracts.container.exec_v3.exec_runtime_bytes_v3
use std.common.contracts.mux.session_runtime_control_v1.{SessionRuntimeControlTargetV1,
    SessionRuntimeControlLeaseV1, SessionRuntimeControlKindV1, session_runtime_control_target_validate_v1}

pub fn container_primary_input_plan_match_v1(plan: ContainerPrimaryAttachPlanV1,
        target: SessionRuntimeControlTargetV1) -> Result<(), text>:
    if container_primary_attach_plan_digest_v1(plan)? != plan.request_digest:
        return Err("primary-input-plan-digest")
    session_runtime_control_target_validate_v1(target)?
    val workload = plan.workload
    val scope = ContainerHostScopeV2(physical_host_id: workload.physical_host_id,
        service_scope_id: workload.service_scope_id, boot_id: workload.boot_id,
        provider_generation: workload.provider_generation, native_machine_id: workload.native_machine_id,
        continuity_mode: workload.continuity_mode, continuity_id: workload.continuity_id)
    if (container_host_scope_bytes_v2(target.scope)? != container_host_scope_bytes_v2(scope)? or
            exec_runtime_bytes_v3(target.runtime)? != exec_runtime_bytes_v3(plan.runtime)? or
            target.workload_request_digest != workload.request_digest or
            target.binding_digest != plan.identity.binding_digest or target.execution_kind != "primary" or
            target.native_exec_id != "" or target.exec_request_digest != ""):
        return Err("primary-input-target-plan-mismatch")
    Ok(())

pub fn container_primary_input_deadline_v1(lease: SessionRuntimeControlLeaseV1) -> Result<i64, text>:
    if (lease.kind != SessionRuntimeControlKindV1.Input or lease.revision <= 0 or
            lease.revision > 1152921504606846975 or lease.expires_monotonic_ms <= 0 or
            lease.expires_monotonic_ms > 1152921504606):
        return Err("primary-input-native-bound")
    Ok(lease.expires_monotonic_ms * 1000000)
