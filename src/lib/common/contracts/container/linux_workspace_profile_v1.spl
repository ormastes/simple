# Strict metadata for the fixed root-protected workspace-profile.sdn child.
# Decoding bytes does not establish installed provenance, quota or launch authority.
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.common.build_manager.contracts.builder_digest_valid_v1
use std.common.crypto.sha256.sha256_text
use std.common.contracts.container.execution_v2.ContainerMountProjectionV2
use std.common.contracts.storage.workspace_storage_v1.{WorkspaceStorageRequestV1, workspace_storage_request_valid_v1}
use std.common.contracts.container.linux_local_mounts_v5.linux_local_mounts_validate_v5

pub struct LinuxWorkspaceInstalledProfileV1:
    machine_policy_digest: text
    provider_policy_digest: text
    containment_profile_digest: text
    protected_parent: text
    leaf_name: text
    expected_pool_id: text
    expected_workspace_id: text
    quota_id: i64
    hard_bytes: i64
    guest_root: text
    read_only: bool

pub fn linux_workspace_storage_request_v1(profile: LinuxWorkspaceInstalledProfileV1) -> WorkspaceStorageRequestV1:
    WorkspaceStorageRequestV1(kind: "linux-xfs-project-v1", protected_parent: profile.protected_parent,
        leaf_name: profile.leaf_name, expected_pool_id: profile.expected_pool_id,
        expected_workspace_id: profile.expected_workspace_id, quota_id: profile.quota_id,
        hard_bytes: profile.hard_bytes, policy_digest: profile.machine_policy_digest)

pub fn linux_workspace_source_root_v1(profile: LinuxWorkspaceInstalledProfileV1) -> text:
    profile.protected_parent + "/" + profile.leaf_name

# milestone_0047 (owner decision 1, 2026-11-19, "use worktree"): every workspace run gets its OWN child of the provisioned
# leaf, named from its operation id. 68 bytes: within the 128-byte stage-leaf and journal path-segment limits.
pub fn linux_workspace_run_leaf_v1(operation_id: text) -> text:
    "run-" + sha256_text(operation_id)

# The run's ONLY workspace mount: the provisioned leaf stays the quota root and is never mounted or staged into.
pub fn linux_workspace_run_root_v1(profile: LinuxWorkspaceInstalledProfileV1, operation_id: text) -> text:
    linux_workspace_source_root_v1(profile) + "/" + linux_workspace_run_leaf_v1(operation_id)

# allow(primitive_api): reviewed kernel open-flag word / proc mount-id / tick DATA predicate (milestone_0012 groupD)
pub fn linux_workspace_paths_overlap_v1(left: text, right: text) -> bool:
    left == right or left.starts_with(right + "/") or right.starts_with(left + "/")

pub fn linux_workspace_installed_profile_validate_v1(profile: LinuxWorkspaceInstalledProfileV1) -> Result<(), text>:
    for digest in [profile.machine_policy_digest, profile.provider_policy_digest, profile.containment_profile_digest]:
        if not builder_digest_valid_v1(digest): return Err("workspace-profile-digest-invalid")
    if not workspace_storage_request_valid_v1(linux_workspace_storage_request_v1(profile)):
        return Err("workspace-profile-storage-invalid")
    val source = linux_workspace_source_root_v1(profile)
    val mount = ContainerMountProjectionV2(host_root: source, guest_root: profile.guest_root, read_only: profile.read_only)
    linux_local_mounts_validate_v5([mount], "", "", "")?
    # This state tree contains machine authority, journals and workspace locks;
    # it must never be reachable through a guest workspace mapping.
    if linux_workspace_paths_overlap_v1(source, "/var/lib/simple/container"):
        return Err("workspace-profile-machine-state-overlap")
    for root in ["/proc", "/sys", "/dev", "/etc", "/run"]:
        if linux_workspace_paths_overlap_v1(source, root): return Err("workspace-profile-host-root-overlap")
        if linux_workspace_paths_overlap_v1(profile.guest_root, root): return Err("workspace-profile-guest-system-overlap")
    Ok(())

pub fn linux_workspace_installed_profile_encode_v1(profile: LinuxWorkspaceInstalledProfileV1) -> Result<text, text>:
    linux_workspace_installed_profile_validate_v1(profile)?
    val fields: Dict<text, SdnValue> = {"kind": SdnValue.String("linux-installed-workspace"), "version": SdnValue.Int(1),
        "machinePolicyDigest": SdnValue.String(profile.machine_policy_digest),
        "providerPolicyDigest": SdnValue.String(profile.provider_policy_digest),
        "containmentProfileDigest": SdnValue.String(profile.containment_profile_digest),
        "protectedParent": SdnValue.String(profile.protected_parent), "leafName": SdnValue.String(profile.leaf_name),
        "expectedPoolId": SdnValue.String(profile.expected_pool_id), "expectedWorkspaceId": SdnValue.String(profile.expected_workspace_id),
        "quotaId": SdnValue.Int(profile.quota_id), "hardBytes": SdnValue.Int(profile.hard_bytes),
        "guestRoot": SdnValue.String(profile.guest_root), "readOnly": SdnValue.Bool(profile.read_only)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if source.byte_len() > 16384: return Err("workspace-profile-source-bound")
    Ok(source)

fn workspace_profile_text_v1(fields: Dict<text, SdnValue>, key: text) -> Result<text, text>:
    match fields[key]:
        case SdnValue.String(value): Ok(value)
        case _: Err("workspace-profile-text-required:" + key)

fn workspace_profile_int_v1(fields: Dict<text, SdnValue>, key: text) -> Result<i64, text>:
    match fields[key]:
        case SdnValue.Int(value): Ok(value)
        case _: Err("workspace-profile-integer-required:" + key)

pub fn linux_workspace_installed_profile_decode_v1(source: text) -> Result<LinuxWorkspaceInstalledProfileV1, text>:
    if source.byte_len() == 0 or source.byte_len() > 16384: return Err("workspace-profile-source-bound")
    val document = match sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: 16384,
            max_depth: 2, max_nodes: 32, max_rows: 0, max_cells: 0, max_columns: 16)):
        case Ok(value): value
        case Err(_): return Err("workspace-profile-syntax")
    val fields = match document.value:
        case SdnValue.Dict(value): value
        case _: return Err("workspace-profile-object-required")
    val keys = ["kind", "version", "machinePolicyDigest", "providerPolicyDigest", "containmentProfileDigest",
        "protectedParent", "leafName", "expectedPoolId", "expectedWorkspaceId", "quotaId", "hardBytes", "guestRoot", "readOnly"]
    if fields.len() != keys.len(): return Err("workspace-profile-fields")
    for key in keys:
        if not fields.contains_key(key): return Err("workspace-profile-fields")
    if fields["kind"] != SdnValue.String("linux-installed-workspace") or fields["version"] != SdnValue.Int(1):
        return Err("workspace-profile-kind-version")
    val read_only = match fields["readOnly"]:
        case SdnValue.Bool(value): value
        case _: return Err("workspace-profile-read-only-type")
    val profile = LinuxWorkspaceInstalledProfileV1(machine_policy_digest: workspace_profile_text_v1(fields, "machinePolicyDigest")?,
        provider_policy_digest: workspace_profile_text_v1(fields, "providerPolicyDigest")?,
        containment_profile_digest: workspace_profile_text_v1(fields, "containmentProfileDigest")?,
        protected_parent: workspace_profile_text_v1(fields, "protectedParent")?, leaf_name: workspace_profile_text_v1(fields, "leafName")?,
        expected_pool_id: workspace_profile_text_v1(fields, "expectedPoolId")?, expected_workspace_id: workspace_profile_text_v1(fields, "expectedWorkspaceId")?,
        quota_id: workspace_profile_int_v1(fields, "quotaId")?, hard_bytes: workspace_profile_int_v1(fields, "hardBytes")?,
        guest_root: workspace_profile_text_v1(fields, "guestRoot")?, read_only: read_only)
    if linux_workspace_installed_profile_encode_v1(profile)? != source: return Err("workspace-profile-noncanonical")
    Ok(profile)

pub fn linux_workspace_installed_profile_digest_v1(profile: LinuxWorkspaceInstalledProfileV1) -> Result<text, text>:
    Ok(sha256_text(linux_workspace_installed_profile_encode_v1(profile)?))
