# Typed OCI CLI command mapping. Options and workload arguments stay separate;
# no joining, shell interpolation or implicit command-language evaluation.
pub struct OciCommandPartsV1:
    options: [text]
    arguments: [text]

pub fn oci_command_parts_v1(command: [text], arguments: [text],
        replace_entrypoint: bool) -> Result<OciCommandPartsV1, text>:
    for value in command:
        if value.contains("\0"): return Err("command-contains-nul")
    for value in arguments:
        if value.contains("\0"): return Err("argument-contains-nul")
    if replace_entrypoint and command.len() == 0: return Err("entrypoint-command-empty")
    var options: [text] = []
    var tail: [text] = []
    var index = 0
    if replace_entrypoint:
        val executable = command[0].trim()
        if executable == "": return Err("entrypoint-command-empty")
        if executable.starts_with("-"): return Err("entrypoint-command-option-like")
        if executable.starts_with("[") or executable == "null":
            return Err("entrypoint-command-json-like")
        options = ["--entrypoint", command[0]]
        index = 1
    while index < command.len():
        tail.push(command[index])
        index = index + 1
    for argument in arguments:
        tail.push(argument)
    Ok(OciCommandPartsV1(options: options, arguments: tail))
