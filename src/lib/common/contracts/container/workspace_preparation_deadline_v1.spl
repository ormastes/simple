# Data carried only after the trusted Host verifies the DISTINCT
# workspace_prepare_v1 stage operation in its existing journal. Not a grant
# verifier, keeper launch deadline, workload digest or mapping digest.
use std.common.build_manager.contracts.{builder_digest_valid_v1, builder_identifier_valid_v1}

pub struct WorkspacePreparationDeadlineV1:
    request_digest: text
    operation_id: text
    expires_at_unix_ms: i64

pub fn workspace_preparation_deadline_v1(request_digest: text, operation_id: text,
        expires_at_unix_ms: i64) -> Result<WorkspacePreparationDeadlineV1, text>:
    if not builder_digest_valid_v1(request_digest): return Err("workspace-preparation-request-digest-invalid")
    if not builder_identifier_valid_v1(operation_id): return Err("workspace-preparation-operation-id-invalid")
    if expires_at_unix_ms <= 0: return Err("workspace-preparation-expiry-invalid")
    Ok(WorkspacePreparationDeadlineV1(request_digest: request_digest, operation_id: operation_id,
        expires_at_unix_ms: expires_at_unix_ms))

pub fn workspace_preparation_remaining_ms_v1(value: WorkspacePreparationDeadlineV1,
        expected_digest: text, expected_operation: text, now_unix_ms: i64) -> Result<i64, text>:
    val validated = workspace_preparation_deadline_v1(value.request_digest, value.operation_id, value.expires_at_unix_ms)?
    if value.request_digest != expected_digest: return Err("workspace-preparation-request-mismatch")
    if value.operation_id != expected_operation: return Err("workspace-preparation-operation-mismatch")
    if now_unix_ms < 0: return Err("workspace-preparation-clock-unavailable")
    if now_unix_ms >= value.expires_at_unix_ms: return Err("workspace-preparation-deadline-expired")
    Ok(value.expires_at_unix_ms - now_unix_ms)
