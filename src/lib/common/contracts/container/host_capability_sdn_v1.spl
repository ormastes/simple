# Bounded SDN inspection receipt for a copied host capability. This receipt
# describes discovery; it does not authorize delegated launch.

use std.common.contracts.container.host_capability_v1.{ContainerHostCapabilityV1,
    CONTAINER_ISOLATION_NATIVE_V1, CONTAINER_ISOLATION_NATIVE_SANDBOX_V1,
    CONTAINER_ISOLATION_VM_V1,
    CONTAINER_CLIENT_PRIVILEGE_USER_V1, CONTAINER_CLIENT_PRIVILEGE_DELEGATED_V1,
    CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1}

pub const CONTAINER_HOST_CAPABILITY_SDN_SCHEMA_V1 = "simple-container-host-capability-v1"

fn _known_os_v1(value: text) -> bool:
    value == "linux" or value == "windows" or value == "freebsd" or
        value == "macos" or value == "simpleos"

fn _safe_byte_v1(value: text, allow_controls: bool) -> bool:
    for byte in value.bytes():
        if (byte < 32 and (not allow_controls or
                (byte != 9 and byte != 10 and byte != 13))) or byte > 126:
            return false
    true

fn _encode_v1(value: text) -> Result<text, text>:
    if value.len() > 256 or not _safe_byte_v1(value, true):
        return Err("value-out-of-bounds")
    var out = value.replace("\\", "\\\\")
    out = out.replace("\"", "\\\"")
    out = out.replace("\n", "\\n")
    out = out.replace("\t", "\\t")
    out = out.replace("\r", "\\r")
    Ok(out)

fn _decode_v1(value: text) -> Result<text, text>:
    if value.len() > 768:
        return Err("encoded-value-out-of-bounds")
    var out = ""
    var index = 0
    while index < value.len():
        val ch = value.substring(index, index + 1)
        if ch == "\\":
            if index + 2 > value.len():
                return Err("malformed-escape")
            val code = value.substring(index + 1, index + 2)
            if code == "\"":
                out = out + "\""
            elif code == "\\":
                out = out + "\\"
            elif code == "n":
                out = out + "\n"
            elif code == "t":
                out = out + "\t"
            elif code == "r":
                out = out + "\r"
            else:
                return Err("malformed-escape")
            index = index + 2
        else:
            if ch == "\"":
                return Err("unescaped-value")
            out = out + ch
            index = index + 1
    if out.len() > 256 or not _safe_byte_v1(out, true):
        return Err("value-out-of-bounds")
    Ok(out)

fn _row_v1(field: text, value: text) -> Result<text, text>:
    match _encode_v1(value):
        case Err(reason): Err(reason)
        case Ok(encoded): Ok("    \"{field}\", \"{encoded}\"\n")

pub fn format_container_host_capability_sdn_v1(capability: ContainerHostCapabilityV1) -> Result<text, text>:
    var out = "container_host_capability |field, value|\n"
    out = out + _row_v1("schema", CONTAINER_HOST_CAPABILITY_SDN_SCHEMA_V1)?
    out = out + _row_v1("host_os", capability.host_os)?
    out = out + _row_v1("guest_os", capability.guest_os)?
    out = out + _row_v1("provider_id", capability.provider_id)?
    out = out + _row_v1("isolation_class", capability.isolation_class)?
    out = out + _row_v1("client_privilege", capability.client_privilege)?
    val admin_setup = if capability.admin_setup then "true" else: "false"
    val launch_capable = if capability.launch_capable then "true" else: "false"
    out = out + _row_v1("admin_setup", admin_setup)?
    out = out + _row_v1("launch_capable", launch_capable)?
    out = out + _row_v1("reason", capability.reason)?
    Ok(out)

pub fn parse_container_host_capability_sdn_v1(source: text) -> Result<ContainerHostCapabilityV1, text>:
    if source.len() > 4096 or not _safe_byte_v1(source.replace("\n", ""), false):
        return Err("receipt-out-of-bounds")
    val lines = source.split("\n")
    if lines.len() != 11 or lines[0] != "container_host_capability |field, value|" or lines[10] != "":
        return Err("receipt-shape-invalid")
    val fields = ["schema", "host_os", "guest_os", "provider_id", "isolation_class",
                  "client_privilege", "admin_setup", "launch_capable", "reason"]
    var values: [text] = []
    var i = 0
    while i < fields.len():
        val line = lines[i + 1]
        val prefix = "    \"{fields[i]}\", \""
        if not line.starts_with(prefix) or not line.ends_with("\""):
            return Err("receipt-field-invalid")
        val encoded = line.slice(prefix.len(), line.len() - 1)
        values.push(_decode_v1(encoded)?)
        i = i + 1
    if values[0] != CONTAINER_HOST_CAPABILITY_SDN_SCHEMA_V1:
        return Err("receipt-schema-invalid")
    if values[1] == "" or values[2] == "" or values[3] == "":
        return Err("host-capability-identity-missing")
    if not _known_os_v1(values[1]) or not _known_os_v1(values[2]):
        return Err("host-capability-os-unsupported")
    if values[4] != CONTAINER_ISOLATION_NATIVE_V1 and
            values[4] != CONTAINER_ISOLATION_NATIVE_SANDBOX_V1 and
            values[4] != CONTAINER_ISOLATION_VM_V1:
        return Err("host-isolation-unsupported")
    if values[5] != CONTAINER_CLIENT_PRIVILEGE_USER_V1 and
            values[5] != CONTAINER_CLIENT_PRIVILEGE_DELEGATED_V1 and
            values[5] != CONTAINER_CLIENT_PRIVILEGE_UNAVAILABLE_V1:
        return Err("host-client-privilege-invalid")
    if (values[6] != "true" and values[6] != "false") or
       (values[7] != "true" and values[7] != "false"):
        return Err("receipt-boolean-invalid")
    Ok(ContainerHostCapabilityV1(
        host_os: values[1], guest_os: values[2], provider_id: values[3],
        isolation_class: values[4], client_privilege: values[5],
        admin_setup: values[6] == "true", launch_capable: values[7] == "true",
        reason: values[8]))

export CONTAINER_HOST_CAPABILITY_SDN_SCHEMA_V1
export format_container_host_capability_sdn_v1, parse_container_host_capability_sdn_v1
