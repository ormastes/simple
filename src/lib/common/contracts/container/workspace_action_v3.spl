# Closed DATA selector. Only an actual retained workspace-enabled owner can
# begin/advance an action; this enum grants no launch or workload control.
pub enum ContainerWorkspaceActionV3:
    Prepare
    Create
    Configuration
    InputConfiguration
    Start
    Inspect
    Stop
    Destroy

pub fn container_workspace_action_name_v3(action: ContainerWorkspaceActionV3) -> text:
    match action:
        case ContainerWorkspaceActionV3.Prepare: "prepare"
        case ContainerWorkspaceActionV3.Create: "create"
        case ContainerWorkspaceActionV3.Configuration: "configuration"
        case ContainerWorkspaceActionV3.InputConfiguration: "input-configuration"
        case ContainerWorkspaceActionV3.Start: "start"
        case ContainerWorkspaceActionV3.Inspect: "inspect"
        case ContainerWorkspaceActionV3.Stop: "stop"
        case ContainerWorkspaceActionV3.Destroy: "destroy"
