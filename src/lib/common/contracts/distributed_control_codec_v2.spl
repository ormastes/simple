# Strict bounded V2 records; no dynamic shell source or implicit V1 interpretation.
use std.common.contracts.distributed_control_v2.*
use std.common.build_manager.codec.{BuilderWireReaderV1, builder_wire_line_v1}
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.common.crypto.sha256.sha256_text

val DISTRIBUTED_WIRE_MAX_BYTES_V2: i64 = 65536
val DISTRIBUTED_WIRE_INTEGER_MAX_V2: i64 = 9999999999999999

fn distributed_encode_environment_v2(value: ExecutionEnvironmentV2) -> Result<text, text>:
    val reason = distributed_environment_validate_v2(value)
    if reason != "": return Err(reason)
    var pieces: [text] = [builder_wire_line_v1("DBC_ENVIRONMENT_V2")]
    for field in [value.host_id, value.execution_platform, value.target_platform,
            value.test_runtime, value.isolation_class, value.toolchain_digest,
            value.sdk_digest, value.abi, value.isa, value.optimization]:
        pieces.push(builder_wire_line_v1(field))
    Ok(pieces.join(""))

fn distributed_environment_digest_v2(value: ExecutionEnvironmentV2) -> Result<text, text>:
    match distributed_encode_environment_v2(value):
        case Ok(payload): Ok(sha256_text(payload))
        case Err(reason): Err(reason)

fn distributed_decode_environment_v2(payload: text) -> Result<ExecutionEnvironmentV2, text>:
    if payload.len() > DISTRIBUTED_WIRE_MAX_BYTES_V2: return Err("WIRE_TOO_LARGE")
    val reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "DBC_ENVIRONMENT_V2": return Err("VERSION_UNSUPPORTED")
    val value = ExecutionEnvironmentV2(host_id: reader.scalar(),
        execution_platform: reader.scalar(), target_platform: reader.scalar(),
        test_runtime: reader.scalar(), isolation_class: reader.scalar(),
        toolchain_digest: reader.scalar(), sdk_digest: reader.scalar(),
        abi: reader.scalar(), isa: reader.scalar(), optimization: reader.scalar())
    val wire_error = reader.complete_error()
    if wire_error != "": return Err(wire_error)
    val reason = distributed_environment_validate_v2(value)
    if reason != "": return Err(reason)
    Ok(value)

fn distributed_operation_validate_v2(value: OperationEnvelopeV2) -> text:
    if value.version != 2: return "VERSION_UNSUPPORTED"
    for field in [value.id, value.principal, value.project, value.host_id, value.operation]:
        if not builder_identifier_valid_v1(field): return "IDENTITY_INVALID"
    if not builder_digest_valid_v1(value.payload_digest) or not builder_digest_valid_v1(value.environment_digest):
        return "DIGEST_INVALID"
    if value.policy_revision <= 0 or value.revocation_epoch < 0 or value.session_generation <= 0 or
            value.memory_bytes <= 0 or value.duration_ms <= 0:
        return "INTEGER_INVALID"
    for number in [value.policy_revision, value.revocation_epoch, value.session_generation,
            value.memory_bytes, value.duration_ms]:
        if number > DISTRIBUTED_WIRE_INTEGER_MAX_V2: return "INTEGER_TOO_LARGE"
    ""

fn distributed_encode_operation_v2(value: OperationEnvelopeV2) -> Result<text, text>:
    val reason = distributed_operation_validate_v2(value)
    if reason != "": return Err(reason)
    var pieces: [text] = [builder_wire_line_v1("DBC_OPERATION_V2")]
    for field in [value.id, value.payload_digest, value.principal, value.project,
            value.host_id, value.operation, value.environment_digest,
            "{value.policy_revision}", "{value.revocation_epoch}", "{value.session_generation}",
            "{value.memory_bytes}", "{value.duration_ms}"]:
        pieces.push(builder_wire_line_v1(field))
    Ok(pieces.join(""))

fn distributed_decode_operation_v2(payload: text) -> Result<OperationEnvelopeV2, text>:
    if payload.len() > DISTRIBUTED_WIRE_MAX_BYTES_V2: return Err("WIRE_TOO_LARGE")
    val reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "DBC_OPERATION_V2": return Err("VERSION_UNSUPPORTED")
    val value = OperationEnvelopeV2(version: 2, id: reader.scalar(),
        payload_digest: reader.scalar(), principal: reader.scalar(), project: reader.scalar(),
        host_id: reader.scalar(), operation: reader.scalar(), environment_digest: reader.scalar(),
        policy_revision: reader.number(DISTRIBUTED_WIRE_INTEGER_MAX_V2, false),
        revocation_epoch: reader.number(DISTRIBUTED_WIRE_INTEGER_MAX_V2, false),
        session_generation: reader.number(DISTRIBUTED_WIRE_INTEGER_MAX_V2, false),
        memory_bytes: reader.number(DISTRIBUTED_WIRE_INTEGER_MAX_V2, false),
        duration_ms: reader.number(DISTRIBUTED_WIRE_INTEGER_MAX_V2, false))
    val wire_error = reader.complete_error()
    if wire_error != "": return Err(wire_error)
    val reason = distributed_operation_validate_v2(value)
    if reason != "": return Err(reason)
    Ok(value)
