# Versioned provider planning DATA only. No type here is installed authority.
# AUTHORED_NOT_RUN: Simple compilation/spec execution remains unqualified.
pub enum ProviderCliProviderV1:
    Codex
    Claude
    Gemini
    Kimi

pub enum ProviderCliActionV1:
    Start
    Resume
    AuthInspect
    Interrupt

pub enum ProviderCliControlDataV1:
    Argv
    OwnedCancel
    ExternalCredentialInspectionRequired

pub enum ProviderCliOutputDataV1:
    JsonLines
    JsonDocument
    Text
    None

pub struct ProviderCliVersionDataV1:
    provider: ProviderCliProviderV1
    version: text

pub struct ProviderCliRequestDataV1:
    action: ProviderCliActionV1
    prompt: text = ""
    model: text = ""
    session_id: text = ""
    extra_args: [text] = []

# Never convert this DTO into legacy AgentLaunchPlan and call it verified.
# The actual consumer must plan again from its own captured probe selection.
pub struct ProviderCliPlanDataV1:
    provider: ProviderCliProviderV1
    version: text
    action: ProviderCliActionV1
    control: ProviderCliControlDataV1
    argv: [text]
    stdin_text: text
    output: ProviderCliOutputDataV1
    requires_external_containment: bool
    auth_mechanism: text
    credential_environment_names: [text] = []

pub struct ProviderCliHelpDataV1:
    provider: ProviderCliProviderV1
    version: text
    probe_index: i64
    stdout_digest: text
