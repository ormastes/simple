# Shared four-byte big-endian length prefix. No protocol or authority semantics.
pub fn bounded_frame_limit_v1(limit: i64) -> Result<bool, text>:
    if limit < 1 or limit > 16777216: return Err("frame_limit")
    Ok(true)

pub fn bounded_frame_header_v1(length: i64, limit: i64) -> Result<[u8], text>:
    val valid = bounded_frame_limit_v1(limit)?
    if length < 1 or length > limit: return Err("frame_length")
    Ok([((length / 16777216) % 256) as u8, ((length / 65536) % 256) as u8,
        ((length / 256) % 256) as u8, (length % 256) as u8])

pub fn bounded_frame_length_v1(header: [u8], limit: i64) -> Result<i64, text>:
    val valid = bounded_frame_limit_v1(limit)?
    if header.len() != 4: return Err("frame_header")
    var length: i64 = 0
    for byte in header: length = length * 256 + (byte as i64)
    if length < 1 or length > limit: return Err("frame_length")
    Ok(length)
