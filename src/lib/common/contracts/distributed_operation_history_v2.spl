# Canonical in-process history data, not a decoder/authority token. Consumers
# build once through history_batch for the actual fixed current owner.
pub struct DistributedOperationHistoryV2:
    envelope_digest: text
    admitted_sequence: i64
    last_from_state: text
    last_to_state: text
    last_outcome_digest: text
    last_sequence: i64
    last_commit_digest: text

pub struct DistributedOperationJournalHistoryBatchV2:
    authority_digest: text
    head_commit_digest: text
    head_sequence: i64
    revision_endpoints: Dict<text, i64>
    operations: Dict<text, DistributedOperationHistoryV2>
