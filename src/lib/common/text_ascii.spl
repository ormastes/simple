# ASCII-only text transforms, pure-Simple.
#
# C-MIG-0035 companion: `to_upper_ascii` mirrors the Rust-interpreter extern
# `rt_text_to_upper_ascii` (src/compiler_rust/compiler/src/interpreter_extern/
# simd.rs::rt_text_to_upper_ascii, registered mod.rs:1919) byte-for-byte for
# the ASCII range, via an explicit codepoint-value comparison plus a literal
# uppercase-alphabet lookup table -- genuinely different machinery from the
# extern's byte-map, and free of any new extern declaration.

val LOWER_ALPHABET = "abcdefghijklmnopqrstuvwxyz"
val UPPER_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

# Converts ASCII lowercase letters ('a'..'z') to uppercase; all other
# characters (including any non-ASCII codepoints) pass through unchanged,
# matching the extern's byte-wise (non-locale) semantics.
pub fn to_upper_ascii(s: text) -> text:
    var result = ""
    var i = 0
    val n = s.len()
    while i < n:
        val ch = s.char_at(i)
        val idx = LOWER_ALPHABET.index_of(ch)
        if idx >= 0 and ch.len() == 1:
            result = result + UPPER_ALPHABET.char_at(idx)
        else:
            result = result + ch
        i = i + 1
    return result
