# Canonical aspect activation and lifecycle owner (design §14).
#
# This module is the sole owner of mutable loader, activation, binding, pin,
# and unload state. Container and catalog siblings remain value/wire owners.

use std.common.string_core.{text_to_bytes}
use std.nogc_sync_mut.atomic.{AtomicI64, MemoryOrdering, atomic_i64_new}
use std.common.aspect_pack_container.*
use std.common.aspect_pack_catalog.*

# Preserve the original coarse binding-state ABI.
val APK_FC_BOUND: i64 = 0
val APK_FC_QUIESCING: i64 = 1
val APK_FC_UNLOADED: i64 = 2

# Detailed design §14.2 activation states. These are deliberately separate
# from APK_FC_*: existing callers use apk_facet_state_v1 as a coarse live-
# binding view, while apk_activation_state_v1 exposes staging/publication.
val APK_AS_CATALOGUED: i64 = 0
val APK_AS_INDEX_MAPPED: i64 = 1
val APK_AS_RESOLVING: i64 = 2
val APK_AS_CHUNKS_LOADED: i64 = 3
val APK_AS_RELOCATED: i64 = 4
val APK_AS_BOUND: i64 = 5
val APK_AS_ACTIVE: i64 = 6
val APK_AS_QUIESCING: i64 = 7
val APK_AS_UNLOADED: i64 = 8
val APK_AS_FAILED: i64 = 9

# design §14.7 unload result. `released` is true only when the binding was
# actually freed; `quiescing` is true when unload was accepted but the binding
# is still pinned and therefore MUST NOT be freed yet.
struct ApkUnloadResultV1:
    ok: bool
    error_code: text
    error_message: text
    facet_key: text
    quiescing: bool
    released: bool
    refcount: i64
    generation: i64

struct ApkFacetLoadV1:
    ok: bool
    found: bool
    error_code: text
    error_message: text
    facet_key: text
    pack_path: text
    module_id: text
    aspect_id: text
    activation: i64
    from_cache: bool
    payload: [u8]
    generation: i64

struct ApkFacetKeyPartsV1:
    ok: bool
    concrete_type_id: text
    facet_interface_id: text

struct ApkActivationClaimV1:
    ok: bool
    error_code: text
    error_message: text
    facet_key: text
    owner_id: text
    generation: i64
    attempt: i64
    state: i64
    owns: bool
    joined: bool
    terminal: bool

# ---------------------------------------------------------------- loader

var _ld_packs_opened: [i64] = []
var _ld_modules_decompressed: [i64] = []
var _ld_bytes_decompressed: [i64] = []
var _ld_cache_hits: [i64] = []
var _ld_last_error: [text] = []
var _ld_generation: [i64] = []
var _ld_expected_core_abi: [text] = []
var _ld_expected_variant_fingerprint: [text] = []
var _ld_expected_core_layout: [text] = []
var _ld_profile: [text] = []
var _ld_unloads: [i64] = []

var _fc_ld: [i64] = []
var _fc_key: [text] = []
var _fc_module: [text] = []
var _fc_aspect: [text] = []
var _fc_activation: [i64] = []
var _fc_pack: [text] = []
var _fc_off: [i64] = []
var _fc_len: [i64] = []
var _fc_pool: [u8] = []
var _fc_generation: [i64] = []
var _fc_state: [i64] = []
var _fc_refs: [i64] = []

var _pk_ld: [i64] = []
var _pk_path: [text] = []
var _pk_off: [i64] = []
var _pk_len: [i64] = []
var _pk_pool: [u8] = []

var _stk_ld: [i64] = []
var _stk_key: [text] = []

var _ld_operational_sealed: [bool] = []

val _ac_gate: AtomicI64 = atomic_i64_new(0)
val _ac_attempt_seq: AtomicI64 = atomic_i64_new(0)
val _ac_owner_seq: AtomicI64 = atomic_i64_new(0)
var _ac_ld: [i64] = []
var _ac_key: [text] = []
var _ac_generation: [i64] = []
var _ac_attempt: [i64] = []
var _ac_owner: [text] = []
var _ac_state: [i64] = []
var _ac_error: [text] = []

fn _apk_activation_lock_v1():
    var acquired = _ac_gate.compare_exchange(0, 1, MemoryOrdering.AcqRel, MemoryOrdering.Acquire)
    while not acquired:
        acquired = _ac_gate.compare_exchange(0, 1, MemoryOrdering.AcqRel, MemoryOrdering.Acquire)

fn _apk_activation_unlock_v1():
    _ac_gate.store(0, MemoryOrdering.Release)

fn _apk_activation_index_v1(ld: i64, facet_key: text) -> i64:
    var i = _ac_ld.len() - 1
    while i >= 0:
        if _ac_ld[i] == ld and _ac_key[i] == facet_key:
            return i
        i = i - 1
    -1

fn _apk_claim_result_v1(ok: bool, code: text, message: text, facet_key: text,
        owner_id: text, generation: i64, attempt: i64, state: i64,
        owns: bool, joined: bool, terminal: bool) -> ApkActivationClaimV1:
    ApkActivationClaimV1(ok: ok, error_code: code, error_message: message,
        facet_key: facet_key, owner_id: owner_id, generation: generation,
        attempt: attempt, state: state, owns: owns, joined: joined,
        terminal: terminal)

fn apk_activation_claim_v1(ld: i64, facet_key: text, owner_id: text) -> ApkActivationClaimV1:
    """Claim or join the one activation transaction for this facet generation.
    Exactly one owner receives owns; every concurrent loser receives the same
    attempt/generation and can observe its terminal state."""
    if facet_key == "" or owner_id == "":
        return _apk_claim_result_v1(false, "APK_ACTIVATION_ID_REQUIRED",
            "facet key and activation owner id are required", facet_key,
            owner_id, 0, 0, -1, false, false, true)
    _apk_activation_lock_v1()
    val prior = _apk_activation_index_v1(ld, facet_key)
    if prior >= 0 and _ac_state[prior] != APK_AS_UNLOADED:
        val state = _ac_state[prior]
        val terminal = state == APK_AS_ACTIVE or state == APK_AS_FAILED
        val owns = _ac_owner[prior] == owner_id and not terminal
        val message = _ac_error[prior]
        val generation = _ac_generation[prior]
        val attempt = _ac_attempt[prior]
        _apk_activation_unlock_v1()
        return _apk_claim_result_v1(true, "", message, facet_key, owner_id,
            generation, attempt, state, owns, not owns, terminal)
    val generation = _ld_generation[ld] + 1
    val attempt = _ac_attempt_seq.fetch_add(1, MemoryOrdering.AcqRel) + 1
    _ac_ld = _ac_ld.push(ld)
    _ac_key = _ac_key.push(facet_key)
    _ac_generation = _ac_generation.push(generation)
    _ac_attempt = _ac_attempt.push(attempt)
    _ac_owner = _ac_owner.push(owner_id)
    _ac_state = _ac_state.push(APK_AS_CATALOGUED)
    _ac_error = _ac_error.push("")
    _apk_activation_unlock_v1()
    _apk_claim_result_v1(true, "", "", facet_key, owner_id, generation,
        attempt, APK_AS_CATALOGUED, true, false, false)

fn _apk_activation_lease_index_v1(ld: i64, claim: ApkActivationClaimV1) -> i64:
    val i = _apk_activation_index_v1(ld, claim.facet_key)
    if i < 0:
        return -1
    if _ac_attempt[i] != claim.attempt or _ac_generation[i] != claim.generation:
        return -1
    if _ac_owner[i] != claim.owner_id or not claim.owns:
        return -1
    i

fn _apk_activation_next_allowed_v1(current: i64, next: i64) -> bool:
    (current == APK_AS_CATALOGUED and next == APK_AS_INDEX_MAPPED) or
        (current == APK_AS_INDEX_MAPPED and next == APK_AS_RESOLVING) or
        (current == APK_AS_RESOLVING and next == APK_AS_CHUNKS_LOADED) or
        (current == APK_AS_CHUNKS_LOADED and next == APK_AS_RELOCATED) or
        (current == APK_AS_RELOCATED and next == APK_AS_BOUND)

fn apk_activation_advance_v1(ld: i64, claim: ApkActivationClaimV1,
        expected_state: i64, next_state: i64) -> bool:
    """Owner-checked expected-state transition through private late stages.
    Skips, back-edges, and stale/non-owner leases are refused."""
    _apk_activation_lock_v1()
    val i = _apk_activation_lease_index_v1(ld, claim)
    if i < 0 or _ac_state[i] != expected_state or
            not _apk_activation_next_allowed_v1(expected_state, next_state):
        _apk_activation_unlock_v1()
        return false
    _ac_state[i] = next_state
    _apk_activation_unlock_v1()
    true

fn apk_activation_publish_v1(ld: i64, claim: ApkActivationClaimV1) -> bool:
    """Publish one staged Bound generation as Active exactly once."""
    _apk_activation_lock_v1()
    val i = _apk_activation_lease_index_v1(ld, claim)
    if i < 0 or _ac_state[i] != APK_AS_BOUND or
            _ld_generation[ld] + 1 != claim.generation:
        _apk_activation_unlock_v1()
        return false
    _ld_generation[ld] = claim.generation
    _ac_state[i] = APK_AS_ACTIVE
    _apk_activation_unlock_v1()
    true

fn apk_activation_fail_v1(ld: i64, claim: ApkActivationClaimV1,
        diagnostic: text) -> bool:
    """Fail a pre-publication attempt with one stable diagnostic."""
    if diagnostic == "":
        return false
    _apk_activation_lock_v1()
    val i = _apk_activation_lease_index_v1(ld, claim)
    if i < 0 or _ac_state[i] == APK_AS_ACTIVE or _ac_state[i] == APK_AS_FAILED or
            _ac_state[i] == APK_AS_QUIESCING or _ac_state[i] == APK_AS_UNLOADED:
        _apk_activation_unlock_v1()
        return false
    _ac_state[i] = APK_AS_FAILED
    _ac_error[i] = diagnostic
    _apk_activation_unlock_v1()
    true

fn apk_activation_state_v1(ld: i64, facet_key: text) -> i64:
    _apk_activation_lock_v1()
    val i = _apk_activation_index_v1(ld, facet_key)
    var state = -1
    if i >= 0:
        state = _ac_state[i]
    _apk_activation_unlock_v1()
    state

fn apk_activation_diagnostic_v1(ld: i64, facet_key: text) -> text:
    _apk_activation_lock_v1()
    val i = _apk_activation_index_v1(ld, facet_key)
    var diagnostic = ""
    if i >= 0:
        diagnostic = _ac_error[i]
    _apk_activation_unlock_v1()
    diagnostic

fn apk_loader_new() -> i64:
    """Create a loader with zeroed counters. Returns its handle."""
    val id = _ld_packs_opened.len()
    _ld_packs_opened = _ld_packs_opened.push(0)
    _ld_modules_decompressed = _ld_modules_decompressed.push(0)
    _ld_bytes_decompressed = _ld_bytes_decompressed.push(0)
    _ld_cache_hits = _ld_cache_hits.push(0)
    _ld_last_error = _ld_last_error.push("")
    _ld_generation = _ld_generation.push(0)
    _ld_expected_core_abi = _ld_expected_core_abi.push("")
    _ld_expected_variant_fingerprint = _ld_expected_variant_fingerprint.push("")
    _ld_expected_core_layout = _ld_expected_core_layout.push("")
    _ld_profile = _ld_profile.push("")
    _ld_unloads = _ld_unloads.push(0)
    _ld_operational_sealed = _ld_operational_sealed.push(false)
    id

fn apk_loader_seal_operational_state(ld: i64):
    """design §19 `lazy_io_after_start: deny` — SEAM: call this exactly once,
    from the runtime/scheduler component that owns application publication,
    right after it publishes the application (the same point
    `forbidden_io_diagnostic_scope_2026-08-19.md` §3 names as the natural
    site, immediately after `apk_activate_startup` succeeds). This module
    cannot observe "operational state" itself — it only accepts the bit.
    Irreversible: there is no unseal, matching the design's "fixed before
    operational state" framing (a resealed loader would let a violation slip
    through the gap)."""
    _ld_operational_sealed[ld] = true

fn apk_loader_is_operational_sealed(ld: i64) -> bool:
    """True once `apk_loader_seal_operational_state` has been called for this
    loader. Exposed so callers/specs can observe the flag without depending
    on its error-path side effect."""
    _ld_operational_sealed[ld]

fn apk_loader_generation(ld: i64) -> i64:
    """design §5.7: the loader's activation epoch — the number of facets
    successfully published so far. Never advances on a failed bind."""
    _ld_generation[ld]

fn apk_loader_set_expected_core_abi(ld: i64, expected_core_public_abi_hash: text):
    """design §17: opt in to enforcing `required_core_public_abi_hash`. Leave
    unset (default "") to SKIP the gate — this module cannot invent a value
    to check against, and comparing against a made-up one would be a fake
    gate; nothing in-tree publishes a real core ABI hash yet."""
    _ld_expected_core_abi[ld] = expected_core_public_abi_hash

fn apk_loader_set_expected_variant_fingerprint(ld: i64, expected_variant_fingerprint: text):
    """design §17: opt in to enforcing `variant_fingerprint`. Leave unset
    (default "") to SKIP the gate, same rationale as the core-ABI gate."""
    _ld_expected_variant_fingerprint[ld] = expected_variant_fingerprint

fn apk_loader_set_expected_core_layout(ld: i64, expected_core_layout_hash: text):
    """design §11.2/§17: opt in to enforcing `required_core_layout_hash` — the
    hash a module claims for the core\'s PRIVATE layout when it binds against
    more than the public surface. Leave unset ("") to SKIP the gate; the
    design itself says this field is "zero when public-only"."""
    _ld_expected_core_layout[ld] = expected_core_layout_hash

fn apk_loader_select_profile(ld: i64, profile_id: text):
    """design §9.6: select the deployment profile this process runs. Every
    subsequent routed acquisition resolves ONLY inside this profile\'s slice
    of the catalog. Empty ("") restores single-profile routing."""
    _ld_profile[ld] = profile_id

fn apk_loader_profile(ld: i64) -> text:
    _ld_profile[ld]

fn apk_loader_unloads(ld: i64) -> i64:
    """design §14.7: how many bindings this loader has RELEASED. A quiescing
    unload that could not free its binding does not move this counter."""
    _ld_unloads[ld]

fn apk_loader_packs_opened(ld: i64) -> i64:
    _ld_packs_opened[ld]

fn apk_loader_modules_decompressed(ld: i64) -> i64:
    _ld_modules_decompressed[ld]

fn apk_loader_bytes_decompressed(ld: i64) -> i64:
    _ld_bytes_decompressed[ld]

fn apk_loader_cache_hits(ld: i64) -> i64:
    _ld_cache_hits[ld]

fn apk_loader_last_error(ld: i64) -> text:
    _ld_last_error[ld]

fn apk_loader_register_pack(ld: i64, path: text, data: [u8]) -> bool:
    """Register pack bytes under a catalog-relative path. Duplicate path in
    the same loader fails closed. Registration does NOT open or validate the
    pack — that happens (and is counted) only on load."""
    var i = 0
    val n = _pk_ld.len()
    while i < n:
        if _pk_ld[i] == ld and _pk_path[i] == path:
            _ld_last_error[ld] = "pack already registered: {path}"
            return false
        i = i + 1
    _pk_ld = _pk_ld.push(ld)
    _pk_path = _pk_path.push(path)
    _pk_off = _pk_off.push(_pk_pool.len())
    _pk_len = _pk_len.push(data.len())
    var j = 0
    while j < data.len():
        _pk_pool = _pk_pool.push(data[j])
        j = j + 1
    _ld_last_error[ld] = ""
    true

fn _apk_facet_error(code: text, message: text) -> ApkFacetLoadV1:
    var empty: [u8] = []
    ApkFacetLoadV1(ok: false, found: false, error_code: code, error_message: message,
        facet_key: "", pack_path: "", module_id: "", aspect_id: "",
        activation: APK_ACT_OFF, from_cache: false, payload: empty, generation: 0)

fn apk_activation_stack_enter_v1(ld: i64, facet_key: text) -> bool:
    """design §21 E-APACK007: push (ld, facet_key) onto the activation stack.
    Returns false — a detected cycle — when the exact same key is already on
    it for this loader; the caller must not proceed with activation."""
    _apk_activation_lock_v1()
    var i = 0
    while i < _stk_ld.len():
        if _stk_ld[i] == ld and _stk_key[i] == facet_key:
            _ld_last_error[ld] = "activation cycle detected: {facet_key} is already being activated"
            _apk_activation_unlock_v1()
            return false
        i = i + 1
    _stk_ld = _stk_ld.push(ld)
    _stk_key = _stk_key.push(facet_key)
    _apk_activation_unlock_v1()
    true

fn apk_activation_stack_exit_v1(ld: i64, facet_key: text):
    """Pop the top of the activation stack. Callers use enter/exit in strict
    LIFO nesting, matching how _apk_acquire_facet wraps its own body."""
    _apk_activation_lock_v1()
    if _stk_ld.len() > 0 and _stk_ld[_stk_ld.len() - 1] == ld and
            _stk_key[_stk_key.len() - 1] == facet_key:
        _stk_ld.pop()
        _stk_key.pop()
    _apk_activation_unlock_v1()

fn _apk_facet_miss(facet_key: text) -> ApkFacetLoadV1:
    var empty: [u8] = []
    ApkFacetLoadV1(ok: true, found: false, error_code: "", error_message: "",
        facet_key: facet_key, pack_path: "", module_id: "", aspect_id: "",
        activation: APK_ACT_OFF, from_cache: false, payload: empty, generation: 0)

fn _apk_split_facet_key(facet_key: text) -> ApkFacetKeyPartsV1:
    """Split "{concrete_type_id}/{facet_interface_id}" at the FIRST '/'. Every
    catalog entry in this module follows that convention."""
    val raw = text_to_bytes(facet_key)
    var cut = -1
    var i = 0
    while i < raw.len():
        if cut < 0 and raw[i] == (47 as u8):
            cut = i
        i = i + 1
    if cut < 0:
        return ApkFacetKeyPartsV1(ok: false, concrete_type_id: "", facet_interface_id: "")
    ApkFacetKeyPartsV1(ok: true,
        concrete_type_id: _apk_read_text(raw, 0, cut),
        facet_interface_id: _apk_read_text(raw, cut + 1, raw.len() - cut - 1))

fn apk_facet_key_parts_v1(facet_key: text) -> ApkFacetKeyPartsV1:
    """design §14.1 FacetBindingRegistry key, part 1/2: decompose a facet key
    into (concrete_type_id, facet_interface_id). `ok` is false when the key
    carries no '/' separator."""
    _apk_split_facet_key(facet_key)

fn apk_try_facet_binding_v1(ld: i64, concrete_type_id: text, facet_interface_id: text) -> ApkFacetLoadV1:
    """design §14.1 FacetBindingRegistry key, part 2/2: look up an
    already-bound facet by the full (concrete_type_id, facet_interface_id)
    pair, same no-I/O contract as apk_try_facet. The returned `generation`
    field is the third element of the design's key — the activation epoch
    this exact binding was published under."""
    apk_try_facet(ld, "{concrete_type_id}/{facet_interface_id}")

fn apk_try_facet(ld: i64, facet_key: text) -> ApkFacetLoadV1:
    """Design §6.7 `try_facet`: NEVER performs I/O. Returns an already-bound
    facet or a clean miss — it never consults the catalog, never opens a pack
    and never decompresses, so none of the loader counters can move."""
    _apk_activation_lock_v1()
    var i = 0
    val n = _fc_ld.len()
    while i < n:
        if _fc_ld[i] == ld and _fc_key[i] == facet_key and _fc_state[i] == APK_FC_BOUND:
            var payload: [u8] = []
            var j = 0
            val base = _fc_off[i]
            val plen = _fc_len[i]
            while j < plen:
                payload.push(_fc_pool[base + j])
                j = j + 1
            _ld_cache_hits[ld] = _ld_cache_hits[ld] + 1
            _ld_last_error[ld] = ""
            val result = ApkFacetLoadV1(ok: true, found: true, error_code: "", error_message: "",
                facet_key: facet_key, pack_path: _fc_pack[i], module_id: _fc_module[i],
                aspect_id: _fc_aspect[i], activation: _fc_activation[i],
                from_cache: true, payload: payload, generation: _fc_generation[i])
            _apk_activation_unlock_v1()
            return result
        i = i + 1
    _apk_activation_unlock_v1()
    _apk_facet_miss(facet_key)

fn apk_load_facet(ld: i64, catalog: [u8], facet_key: text) -> ApkFacetLoadV1:
    """Design §6.7 `facet`: may load when the route's activation mode permits
    it. `off` (never included) and `manual` (explicit `aspect.load` only) are
    refused as explicit errors — never silently loaded."""
    _apk_acquire_facet(ld, catalog, facet_key, false)

fn apk_load_aspect_manual(ld: i64, catalog: [u8], facet_key: text) -> ApkFacetLoadV1:
    """Design §6.7 `aspect.load`: an explicit request, so `manual` routes are
    permitted here. `off` is still refused — that code is not in the image."""
    _apk_acquire_facet(ld, catalog, facet_key, true)

fn apk_activate_startup(ld: i64, catalog: [u8]) -> i64:
    """Bind every `startup` route before the application publishes itself
    (design §9.4). Returns the number bound; the first failure stops and is
    left in apk_loader_last_error."""
    val cat = apk_open_catalog_v1(catalog)
    if not cat.ok:
        _ld_last_error[ld] = cat.error_message
        return 0
    val keys = apk_catalog_startup_keys_v1(catalog, cat)
    var bound = 0
    var i = 0
    while i < keys.len():
        val got = _apk_acquire_facet(ld, catalog, keys[i], true)
        if not got.ok:
            return bound
        bound = bound + 1
        i = i + 1
    bound

fn _apk_activation_error_v1(ld: i64, claim: ApkActivationClaimV1,
        code: text, message: text) -> ApkFacetLoadV1:
    _ = apk_activation_fail_v1(ld, claim, message)
    _ld_last_error[ld] = message
    _apk_facet_error(code, message)

fn _apk_acquire_facet(ld: i64, catalog: [u8], facet_key: text, explicit: bool) -> ApkFacetLoadV1:
    """Routed load with one owner transaction per facet generation."""
    val request = _ac_owner_seq.fetch_add(1, MemoryOrdering.AcqRel) + 1
    apk_load_facet_owned_v1(ld, catalog, facet_key, explicit, "loader-request-{request}")

fn apk_load_facet_owned_v1(ld: i64, catalog: [u8], facet_key: text,
        explicit: bool, owner_id: text) -> ApkFacetLoadV1:
    """Drive a prior winning claim, or claim on behalf of this unique owner.
    Concurrent losers get APK_ACTIVATION_IN_PROGRESS and perform no pack I/O."""
    val cached = apk_try_facet(ld, facet_key)
    if cached.found:
        return cached
    if not explicit and _ld_operational_sealed[ld]:
        _ld_last_error[ld] = "E-APACK008 attempted lazy I/O in forbidden execution context: operational state is sealed, cannot lazy-load {facet_key}"
        return _apk_facet_error("E-APACK008", _ld_last_error[ld])
    _apk_acquire_facet_body(ld, catalog, facet_key, explicit, owner_id)

fn _apk_publish_loaded_facet_v1(ld: i64, claim: ApkActivationClaimV1,
        route: ApkCatalogRouteV1, load: ApkModuleLoadV1) -> bool:
    """Atomically publish the loaded payload row and its Active generation."""
    _apk_activation_lock_v1()
    val ai = _apk_activation_lease_index_v1(ld, claim)
    if ai < 0 or _ac_state[ai] != APK_AS_BOUND or
            _ld_generation[ld] + 1 != claim.generation:
        _apk_activation_unlock_v1()
        return false
    _fc_ld = _fc_ld.push(ld)
    _fc_key = _fc_key.push(claim.facet_key)
    _fc_module = _fc_module.push(load.module_id)
    _fc_aspect = _fc_aspect.push(load.aspect_id)
    _fc_activation = _fc_activation.push(route.activation)
    _fc_pack = _fc_pack.push(route.pack_path)
    _fc_off = _fc_off.push(_fc_pool.len())
    _fc_len = _fc_len.push(load.payload.len())
    _fc_generation = _fc_generation.push(claim.generation)
    _fc_state = _fc_state.push(APK_FC_BOUND)
    _fc_refs = _fc_refs.push(0)
    var k = 0
    while k < load.payload.len():
        _fc_pool = _fc_pool.push(load.payload[k])
        k = k + 1
    _ld_generation[ld] = claim.generation
    _ac_state[ai] = APK_AS_ACTIVE
    _apk_activation_unlock_v1()
    true

fn _apk_acquire_facet_body(ld: i64, catalog: [u8], facet_key: text,
        explicit: bool, owner_id: text) -> ApkFacetLoadV1:
    val cat = apk_open_catalog_v1(catalog)
    if not cat.ok:
        _ld_last_error[ld] = cat.error_message
        return _apk_facet_error(cat.error_code, cat.error_message)
    if apk_facet_state_v1(ld, facet_key) == APK_FC_QUIESCING:
        _ld_last_error[ld] = "aspect is quiescing and cannot be re-acquired: {facet_key}"
        return _apk_facet_error("APK_ASPECT_QUIESCING", _ld_last_error[ld])
    var route = apk_catalog_route_v1(catalog, cat, facet_key)
    if _ld_profile[ld] != "":
        route = apk_catalog_route_in_profile_v1(catalog, cat, _ld_profile[ld], facet_key)
    if not route.ok:
        _ld_last_error[ld] = route.error_message
        return _apk_facet_error(route.error_code, route.error_message)
    if not route.found:
        _ld_last_error[ld] = ""
        return _apk_facet_miss(facet_key)
    if route.activation == APK_ACT_OFF:
        _ld_last_error[ld] = "aspect is excluded from this image: {facet_key}"
        return _apk_facet_error("APK_ASPECT_EXCLUDED", _ld_last_error[ld])
    if route.activation == APK_ACT_MANUAL and not explicit:
        _ld_last_error[ld] = "manual aspect requires an explicit load: {facet_key}"
        return _apk_facet_error("APK_ASPECT_MANUAL", _ld_last_error[ld])

    val claim = apk_activation_claim_v1(ld, facet_key, owner_id)
    if not claim.ok:
        return _apk_facet_error(claim.error_code, claim.error_message)
    if not claim.owns:
        if claim.state == APK_AS_ACTIVE:
            return apk_try_facet(ld, facet_key)
        if claim.state == APK_AS_FAILED:
            _ld_last_error[ld] = claim.error_message
            return _apk_facet_error("APK_ACTIVATION_FAILED", claim.error_message)
        _ld_last_error[ld] = "activation already owned for {facet_key}; join attempt {claim.attempt}"
        return _apk_facet_error("APK_ACTIVATION_IN_PROGRESS", _ld_last_error[ld])

    var pidx = -1
    var i = 0
    while i < _pk_ld.len():
        if _pk_ld[i] == ld and _pk_path[i] == route.pack_path:
            pidx = i
        i = i + 1
    if pidx < 0:
        return _apk_activation_error_v1(ld, claim, "APK_PACK_MISSING",
            "routed pack is not deployed: {route.pack_path}")
    var pack: [u8] = []
    var j = 0
    val base = _pk_off[pidx]
    val plen = _pk_len[pidx]
    while j < plen:
        pack.push(_pk_pool[base + j])
        j = j + 1

    _apk_activation_lock_v1()
    _ld_packs_opened[ld] = _ld_packs_opened[ld] + 1
    _apk_activation_unlock_v1()
    val handle = apk_open_pack_v1(pack)
    if not handle.ok:
        return _apk_activation_error_v1(ld, claim, handle.error_code, handle.error_message)
    if not apk_activation_advance_v1(ld, claim, APK_AS_CATALOGUED, APK_AS_INDEX_MAPPED):
        return _apk_activation_error_v1(ld, claim, "APK_ACTIVATION_TRANSITION",
            "failed Catalogued to IndexMapped transition for {facet_key}")
    if not apk_activation_advance_v1(ld, claim, APK_AS_INDEX_MAPPED, APK_AS_RESOLVING):
        return _apk_activation_error_v1(ld, claim, "APK_ACTIVATION_TRANSITION",
            "failed IndexMapped to Resolving transition for {facet_key}")

    val load = apk_load_module_v1(pack, handle, route.module_id)
    if not load.ok:
        return _apk_activation_error_v1(ld, claim, load.error_code, load.error_message)
    if not load.found:
        return _apk_activation_error_v1(ld, claim, "APK_ROUTE_DANGLING",
            "catalog routed to a module absent from its pack: {route.module_id}")
    if not apk_activation_advance_v1(ld, claim, APK_AS_RESOLVING, APK_AS_CHUNKS_LOADED):
        return _apk_activation_error_v1(ld, claim, "APK_ACTIVATION_TRANSITION",
            "failed Resolving to ChunksLoaded transition for {facet_key}")

    if route.abi_hash != "" and route.abi_hash != load.module_abi_hash:
        return _apk_activation_error_v1(ld, claim, "APK_ABI_MISMATCH",
            "facet contract ABI mismatch for {facet_key}: catalog {route.abi_hash} vs module {load.module_abi_hash}")
    if _ld_expected_core_abi[ld] != "" and
            _ld_expected_core_abi[ld] != load.required_core_public_abi_hash:
        return _apk_activation_error_v1(ld, claim, "APK_CORE_ABI_MISMATCH",
            "core public ABI mismatch for {facet_key}: expected {_ld_expected_core_abi[ld]} vs module {load.required_core_public_abi_hash}")
    if _ld_expected_core_layout[ld] != "" and
            _ld_expected_core_layout[ld] != load.required_core_layout_hash:
        return _apk_activation_error_v1(ld, claim, "APK_CORE_LAYOUT_MISMATCH",
            "core layout hash mismatch for {facet_key}: expected {_ld_expected_core_layout[ld]} vs module {load.required_core_layout_hash}")
    if _ld_expected_variant_fingerprint[ld] != "" and
            _ld_expected_variant_fingerprint[ld] != load.variant_fingerprint:
        return _apk_activation_error_v1(ld, claim, "APK_VARIANT_MISMATCH",
            "variant fingerprint mismatch for {facet_key}: expected {_ld_expected_variant_fingerprint[ld]} vs module {load.variant_fingerprint}")
    if not apk_activation_advance_v1(ld, claim, APK_AS_CHUNKS_LOADED, APK_AS_RELOCATED):
        return _apk_activation_error_v1(ld, claim, "APK_ACTIVATION_TRANSITION",
            "failed ChunksLoaded to Relocated transition for {facet_key}")

    _apk_activation_lock_v1()
    _ld_modules_decompressed[ld] = _ld_modules_decompressed[ld] + load.modules_decompressed
    _ld_bytes_decompressed[ld] = _ld_bytes_decompressed[ld] + load.bytes_decompressed
    _apk_activation_unlock_v1()
    if not apk_activation_advance_v1(ld, claim, APK_AS_RELOCATED, APK_AS_BOUND):
        return _apk_activation_error_v1(ld, claim, "APK_ACTIVATION_TRANSITION",
            "failed Relocated to Bound transition for {facet_key}")
    if not _apk_publish_loaded_facet_v1(ld, claim, route, load):
        return _apk_activation_error_v1(ld, claim, "APK_ACTIVATION_PUBLISH",
            "failed atomic publication for {facet_key}")
    _ld_last_error[ld] = ""
    ApkFacetLoadV1(ok: true, found: true, error_code: "", error_message: "",
        facet_key: facet_key, pack_path: route.pack_path, module_id: load.module_id,
        aspect_id: load.aspect_id, activation: route.activation, from_cache: false,
        payload: load.payload, generation: claim.generation)

# ---------------------------------------------------------------- unload

fn _apk_fc_index(ld: i64, facet_key: text) -> i64:
    """Index of the LIVE (bound or quiescing) registry row for a key, or -1."""
    var i = 0
    while i < _fc_ld.len():
        if _fc_ld[i] == ld and _fc_key[i] == facet_key and _fc_state[i] != APK_FC_UNLOADED:
            return i
        i = i + 1
    -1

fn apk_facet_state_v1(ld: i64, facet_key: text) -> i64:
    """Coarse compatibility view: Bound, Quiescing, Unloaded, or -1."""
    _apk_activation_lock_v1()
    val i = _apk_fc_index(ld, facet_key)
    if i >= 0:
        val state = _fc_state[i]
        _apk_activation_unlock_v1()
        return state
    var j = 0
    while j < _fc_ld.len():
        if _fc_ld[j] == ld and _fc_key[j] == facet_key:
            _apk_activation_unlock_v1()
            return APK_FC_UNLOADED
        j = j + 1
    _apk_activation_unlock_v1()
    -1

fn apk_facet_refcount_v1(ld: i64, facet_key: text) -> i64:
    _apk_activation_lock_v1()
    val i = _apk_fc_index(ld, facet_key)
    if i < 0:
        _apk_activation_unlock_v1()
        return -1
    val refs = _fc_refs[i]
    _apk_activation_unlock_v1()
    refs

fn apk_facet_pin_v1(ld: i64, facet_key: text) -> bool:
    """Atomically check Active and take a FacetRef-style generation pin."""
    _apk_activation_lock_v1()
    val i = _apk_fc_index(ld, facet_key)
    if i < 0:
        _ld_last_error[ld] = "cannot pin an unbound facet: {facet_key}"
        _apk_activation_unlock_v1()
        return false
    val ai = _apk_activation_index_v1(ld, facet_key)
    if _fc_state[i] != APK_FC_BOUND or ai < 0 or _ac_state[ai] != APK_AS_ACTIVE:
        _ld_last_error[ld] = "cannot pin a quiescing facet: {facet_key}"
        _apk_activation_unlock_v1()
        return false
    _fc_refs[i] = _fc_refs[i] + 1
    _ld_last_error[ld] = ""
    _apk_activation_unlock_v1()
    true

fn apk_facet_unpin_v1(ld: i64, facet_key: text) -> bool:
    """Drop one pin; the final pin releases a Quiescing generation once."""
    _apk_activation_lock_v1()
    val i = _apk_fc_index(ld, facet_key)
    if i < 0:
        _ld_last_error[ld] = "cannot unpin an unbound facet: {facet_key}"
        _apk_activation_unlock_v1()
        return false
    if _fc_refs[i] <= 0:
        _ld_last_error[ld] = "unbalanced unpin for {facet_key}"
        _apk_activation_unlock_v1()
        return false
    _fc_refs[i] = _fc_refs[i] - 1
    if _fc_refs[i] == 0 and _fc_state[i] == APK_FC_QUIESCING:
        _fc_state[i] = APK_FC_UNLOADED
        _fc_len[i] = 0
        _ld_unloads[ld] = _ld_unloads[ld] + 1
        val ai = _apk_activation_index_v1(ld, _fc_key[i])
        if ai >= 0 and _ac_generation[ai] == _fc_generation[i]:
            _ac_state[ai] = APK_AS_UNLOADED
    _ld_last_error[ld] = ""
    _apk_activation_unlock_v1()
    true

fn apk_unload_facet_v1(ld: i64, facet_key: text) -> ApkUnloadResultV1:
    """Active -> Quiescing -> Unloaded under the same gate as pin."""
    _apk_activation_lock_v1()
    val ai = _apk_activation_index_v1(ld, facet_key)
    if ai >= 0 and _ac_state[ai] != APK_AS_ACTIVE and
            _ac_state[ai] != APK_AS_QUIESCING and
            _ac_state[ai] != APK_AS_UNLOADED and _ac_state[ai] != APK_AS_FAILED:
        _ld_last_error[ld] = "cannot unload a facet that is currently activating: {facet_key}"
        _apk_activation_unlock_v1()
        return ApkUnloadResultV1(ok: false, error_code: "APK_UNLOAD_ACTIVATING",
            error_message: "cannot unload a facet that is currently activating: {facet_key}",
            facet_key: facet_key, quiescing: false, released: false,
            refcount: -1, generation: 0)
    var si = 0
    while si < _stk_ld.len():
        if _stk_ld[si] == ld and _stk_key[si] == facet_key:
            _ld_last_error[ld] = "cannot unload a facet that is currently activating: {facet_key}"
            _apk_activation_unlock_v1()
            return ApkUnloadResultV1(ok: false, error_code: "APK_UNLOAD_ACTIVATING",
                error_message: "cannot unload a facet that is currently activating: {facet_key}",
                facet_key: facet_key, quiescing: false, released: false,
                refcount: -1, generation: 0)
        si = si + 1
    val idx = _apk_fc_index(ld, facet_key)
    if idx < 0:
        _ld_last_error[ld] = "no such bound facet: {facet_key}"
        _apk_activation_unlock_v1()
        return ApkUnloadResultV1(ok: false, error_code: "APK_UNLOAD_NOT_BOUND",
            error_message: "no such bound facet: {facet_key}",
            facet_key: facet_key, quiescing: false, released: false,
            refcount: -1, generation: 0)
    val gen = _fc_generation[idx]
    if _fc_refs[idx] > 0:
        _fc_state[idx] = APK_FC_QUIESCING
        if ai >= 0:
            _ac_state[ai] = APK_AS_QUIESCING
        val refs = _fc_refs[idx]
        _ld_last_error[ld] = ""
        _apk_activation_unlock_v1()
        return ApkUnloadResultV1(ok: true, error_code: "", error_message: "",
            facet_key: facet_key, quiescing: true, released: false,
            refcount: refs, generation: gen)
    _fc_state[idx] = APK_FC_UNLOADED
    _fc_len[idx] = 0
    _ld_unloads[ld] = _ld_unloads[ld] + 1
    if ai >= 0 and _ac_generation[ai] == _fc_generation[idx]:
        _ac_state[ai] = APK_AS_UNLOADED
    _ld_last_error[ld] = ""
    _apk_activation_unlock_v1()
    ApkUnloadResultV1(ok: true, error_code: "", error_message: "",
        facet_key: facet_key, quiescing: false, released: true,
        refcount: 0, generation: gen)
