# DrawIR paint-time affine transform — Stage 1 CPU/software paint path
# (GAP-4T, doc/05_design/ui/drawir_affine_transform_2026-07-31.md).
#
# Pure geometry computation only: given a DrawIrCommand's decomposed
# transform fields (added in draw_ir.spl, all defaulted to identity), compute
# the axis-aligned paint rect a CPU/software backend should hand to its
# existing `draw_rect_filled(x, y, w, h, color)` trait method.
#
# Handles, exactly (no approximation, integer-only fixed-point math):
#   - translation (implicit: command.x/y is always the pre-transform origin)
#   - scale about `transform_origin_{x,y}_pct` (uniform or non-uniform)
#   - quadrant rotation (0/90/180/270 degrees, mod 360) about the same origin
#
# Deliberately NOT handled at this stage (falls back to the untransformed
# rect rather than silently producing a wrong-looking approximation):
#   - skew (skew_x_deg_milli / skew_y_deg_milli != 0)
#   - non-quadrant rotation (e.g. 37 degrees) — that case stops being an
#     axis-aligned rect and needs the inverse-mapping rasterizer described as
#     Stage 3 in the design doc, which this stage does not implement.
#
# `command.has_transform == false` returns geometry byte-identical to reading
# command.x/y/width/height directly — this is what every backend does today,
# so this is the backward-compatibility property this module must preserve.

use common.ui.draw_ir.{DrawIrCommand, DrawIrRect}

fn _draw_ir_transform_min4(a: i32, b: i32, c: i32, d: i32) -> i32:
    var m = a
    if b < m:
        m = b
    if c < m:
        m = c
    if d < m:
        m = d
    m

fn _draw_ir_transform_max4(a: i32, b: i32, c: i32, d: i32) -> i32:
    var m = a
    if b > m:
        m = b
    if c > m:
        m = c
    if d > m:
        m = d
    m

pub fn draw_ir_command_is_identity_transform(command: DrawIrCommand) -> bool:
    """True when the command's decomposed transform fields are all at their
    identity default (matches what every pre-Stage-1 construction site
    already produces implicitly via the defaulted fields)."""
    (not command.has_transform) or (
        command.rotation_deg_milli == 0 and
        command.scale_x_pct == 100 and
        command.scale_y_pct == 100 and
        command.skew_x_deg_milli == 0 and
        command.skew_y_deg_milli == 0
    )

pub fn draw_ir_cpu_transform_paint_rect(command: DrawIrCommand) -> DrawIrRect:
    """Stage 1 CPU/software paint-path geometry: the axis-aligned rect a CPU
    backend should paint for this command, folding in scale + quadrant
    rotation about the transform origin. See module docstring for exactly
    which cases are exact vs. deferred."""
    if draw_ir_command_is_identity_transform(command):
        return DrawIrRect(
            present: true,
            x: command.x,
            y: command.y,
            width: command.width,
            height: command.height
        )

    val rotation = ((command.rotation_deg_milli % 360000) + 360000) % 360000
    val quadrant_ok = (
        rotation == 0 or rotation == 90000 or
        rotation == 180000 or rotation == 270000
    )
    if command.skew_x_deg_milli != 0 or command.skew_y_deg_milli != 0 or not quadrant_ok:
        return DrawIrRect(
            present: true,
            x: command.x,
            y: command.y,
            width: command.width,
            height: command.height
        )

    val anchor_x = command.x + (command.width * command.transform_origin_x_pct) / 100
    val anchor_y = command.y + (command.height * command.transform_origin_y_pct) / 100

    val scaled_width = (command.width * command.scale_x_pct) / 100
    val scaled_height = (command.height * command.scale_y_pct) / 100
    val p_left = ((command.x - anchor_x) * command.scale_x_pct) / 100
    val p_top = ((command.y - anchor_y) * command.scale_y_pct) / 100
    val p_right = p_left + scaled_width
    val p_bottom = p_top + scaled_height

    var cos_v = 1
    var sin_v = 0
    if rotation == 90000:
        cos_v = 0
        sin_v = 1
    elif rotation == 180000:
        cos_v = -1
        sin_v = 0
    elif rotation == 270000:
        cos_v = 0
        sin_v = -1

    val corner1_x = p_left * cos_v - p_top * sin_v
    val corner1_y = p_left * sin_v + p_top * cos_v
    val corner2_x = p_right * cos_v - p_top * sin_v
    val corner2_y = p_right * sin_v + p_top * cos_v
    val corner3_x = p_right * cos_v - p_bottom * sin_v
    val corner3_y = p_right * sin_v + p_bottom * cos_v
    val corner4_x = p_left * cos_v - p_bottom * sin_v
    val corner4_y = p_left * sin_v + p_bottom * cos_v

    val min_x = _draw_ir_transform_min4(corner1_x, corner2_x, corner3_x, corner4_x)
    val max_x = _draw_ir_transform_max4(corner1_x, corner2_x, corner3_x, corner4_x)
    val min_y = _draw_ir_transform_min4(corner1_y, corner2_y, corner3_y, corner4_y)
    val max_y = _draw_ir_transform_max4(corner1_y, corner2_y, corner3_y, corner4_y)

    DrawIrRect(
        present: true,
        x: anchor_x + min_x,
        y: anchor_y + min_y,
        width: max_x - min_x,
        height: max_y - min_y
    )

pub fn draw_ir_cpu_rasterize_solid_rect(command: DrawIrCommand) -> [u32]:
    """CPU/software paint path: rasterize the command's transformed paint
    rect (via `draw_ir_cpu_transform_paint_rect`) as a flat, row-major solid-
    fill pixel buffer of `command.color`, width-first then height. This is
    the same buffer shape `draw_image(x, y, w, h, pixels)` already accepts
    (`draw_ir_target.spl:39`), so a CPU backend can paint a transformed
    command through its existing trait surface with zero new methods. A
    command with no transform (or an identity transform) produces the exact
    same solid fill a plain `draw_rect_filled` call paints today — this is
    the backward-compatibility property under test."""
    val rect = draw_ir_cpu_transform_paint_rect(command)
    if rect.width <= 0 or rect.height <= 0:
        return []
    val total = rect.width * rect.height
    [command.color; total]
