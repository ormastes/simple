# DrawIR v3 GROUP/PORT resolver (design §4,
# `doc/05_design/ui/unified_packed_ui_scene.md`).
#
# CAPABILITY-PROBE FINDING (assumption A3,
# `doc/03_plan/ui/unified_packed_ui_scene_agent_lanes.md` lane L2): neither
# `draw_ir_v3_emit.spl`, `draw_ir_v3_oracle.spl` nor
# `draw_ir_v3_execution_route.spl` (all read-only/frozen for this lane)
# resolves GROUP/PORT at all -- `draw_ir_v3_oracle_walk` classifies only
# RECT/TEXT/IMAGE/PATH kinds, folding GROUP/PORT commands into
# `total_commands` uncategorized, and no hit-test executor exists anywhere
# over `DrawIrV3HitShapeTable` in `common/ui`. This is a from-scratch
# implementation, not conformance + gap-fix (see
# `test/01_unit/lib/common/ui/draw_ir_v3_group_resolve_spec.spl`, first
# `describe` block, for the executable proof).
#
# SCHEMA REUSE NOTE (load-bearing, read before changing field mappings):
# `DrawIrV3Command` (frozen, `draw_ir_v3.spl`) carries no `opacity`,
# `first_child_command`/`child_command_count`, or `surface_id`/
# `surface_generation` fields -- the design's §4 field list describes
# semantics, not literal frozen-schema fields. This resolver derives them
# from the generic fields that already exist, rather than inventing new
# frozen-schema fields (which no lane may do):
#   - GROUP "opacity" -> `paint_id` on the GROUP command, read through
#     `DrawIrV3PaintTable.opacities_milli` (milli-scale, 0=transparent,
#     1000=opaque; NOT the design's literal u16 0..65535 -- that scale has no
#     backing field without a frozen-schema edit). `paint_id == NO_ID` or an
#     absent paint row both mean "fully opaque" (1000), not the table's raw
#     zero-opacity default for a missing row.
#   - GROUP descendant range ("first_child_command"/"child_command_count")
#     -> computed by walking `parent_id` chains (commands reference their
#     parent via `parent_id == parent.component_id`, not an array index) and
#     verified contiguous, rather than read from a stored span.
#   - PORT "surface_id"/"surface_generation" -> `image_resource_id`
#     (indexes `DrawIrV3ResourceTable`, the only per-command resource
#     reference that exists) and `component_generation` respectively.
#   - The design's opacity+"OVERLAPPING hint flag" NEEDS_OFFSCREEN trigger
#     (§4.1) is NOT implemented: no such hint flag exists on
#     `DrawIrV3Command.flags` (only CLIPPED/TRANSFORMED/HIT_TESTABLE/HIDDEN
#     are defined) and this lane may not add one to the frozen file. The
#     clip-based NEEDS_OFFSCREEN trigger (rotation/skew + clip) IS
#     implemented -- that is the trigger the lane gate's required assertion
#     (d) exercises.
#
# All arithmetic is integer/fixed-point (milli-units, matching
# `DrawIrV3TransformTable`'s existing convention) -- no floats, so hit
# testing stays bit-deterministic across runs and platforms.

use common.ui.draw_ir_v3.{
    DRAW_IR_V3_FLAG_HIDDEN,
    DRAW_IR_V3_KIND_GROUP,
    DRAW_IR_V3_KIND_PORT,
    DRAW_IR_V3_NO_ID,
    DrawIrV3Command,
    DrawIrV3Scene,
    draw_ir_v3_clip_at,
    draw_ir_v3_has_flag,
    draw_ir_v3_hit_shape_at,
    draw_ir_v3_paint_at,
    draw_ir_v3_transform_at
}

# ---------------------------------------------------------------------------
# Receipt kinds (fail-closed state machine, design §5 pattern reused locally
# for GROUP/PORT resolution -- this is NOT `UiSceneOverflowReceipt`, which is
# L1's type; this resolver owns a smaller, resolver-scoped receipt).
# ---------------------------------------------------------------------------
pub val DRAW_IR_V3_GROUP_RECEIPT_NONE: u16 = 0u16
pub val DRAW_IR_V3_GROUP_RECEIPT_STRUCTURE: u16 = 1u16
pub val DRAW_IR_V3_GROUP_RECEIPT_PORT_UNAVAILABLE: u16 = 2u16
pub val DRAW_IR_V3_GROUP_RECEIPT_OFFSCREEN_UNSUPPORTED: u16 = 3u16

val _MILLI: i64 = 1000

# ---------------------------------------------------------------------------
# Small private value types (2x3 affine, AABB, clip-state) -- kept local to
# this file; they are resolver working state, not new schema.
# ---------------------------------------------------------------------------

struct DrawIrV3Mat2x3:
    m11: i32
    m12: i32
    m21: i32
    m22: i32
    dx: i32
    dy: i32

struct DrawIrV3Aabb:
    min_x: i32
    min_y: i32
    max_x: i32
    max_y: i32

struct DrawIrV3ClipState:
    present: bool
    x: i32
    y: i32
    width: i32
    height: i32

# ---------------------------------------------------------------------------
# Public resolved-state / result / input types.
# ---------------------------------------------------------------------------

struct DrawIrV3ResolvedCommand:
    present: bool
    world_m11: i32
    world_m12: i32
    world_m21: i32
    world_m22: i32
    world_dx: i32
    world_dy: i32
    clip_present: bool
    clip_x: i32
    clip_y: i32
    clip_width: i32
    clip_height: i32
    effective_opacity_milli: i32
    effective_visible: bool
    needs_offscreen: bool
    port_loud_marker: bool

struct DrawIrV3GroupResolveReceipt:
    kind: u16
    command_index: i64
    component_id: u32
    detail: u32

struct DrawIrV3GroupResolveResult:
    ok: bool
    states: [DrawIrV3ResolvedCommand]
    receipts: [DrawIrV3GroupResolveReceipt]

# Caller-supplied PORT surface truth (live registry ownership is out of this
# lane's scope -- see design §2.6/§4.2 and the L2 dependency note in the
# lane report). A resource_id absent from this table is fail-closed
# "unavailable", matching design §4.2 ("an unavailable or stale-generation
# surface renders the loud fail-closed marker").
struct DrawIrV3PortSurfaceState:
    resource_ids: [u32]
    available: [bool]
    current_generations: [u32]

struct DrawIrV3GroupHitResult:
    hit: bool
    command_index: i64
    component_id: u32

fn draw_ir_v3_port_surface_state_empty() -> DrawIrV3PortSurfaceState:
    DrawIrV3PortSurfaceState(resource_ids: [], available: [], current_generations: [])

# ---------------------------------------------------------------------------
# Internal helpers.
# ---------------------------------------------------------------------------

fn _draw_ir_v3_group_min_i32(a: i32, b: i32) -> i32:
    if a < b:
        return a
    b

fn _draw_ir_v3_group_max_i32(a: i32, b: i32) -> i32:
    if a > b:
        return a
    b

fn _draw_ir_v3_group_mat_identity() -> DrawIrV3Mat2x3:
    DrawIrV3Mat2x3(m11: 1000, m12: 0, m21: 0, m22: 1000, dx: 0, dy: 0)

# World = Parent ∘ Local (parent applied after local; local coordinates are
# mapped into parent space first, then parent's own transform runs) --
# design §4.1's normative composition order. Sabotage target: swapping the
# operands here (`local` matrix-multiplied by `parent` instead of the
# reverse) must change results for any pair with a rotation/off-diagonal
# term, which is exactly what the lane's required assertion (b) pins.
fn _draw_ir_v3_group_mat_compose(parent: DrawIrV3Mat2x3, local: DrawIrV3Mat2x3) -> DrawIrV3Mat2x3:
    val pm11 = parent.m11.to_i64()
    val pm12 = parent.m12.to_i64()
    val pm21 = parent.m21.to_i64()
    val pm22 = parent.m22.to_i64()
    val pdx = parent.dx.to_i64()
    val pdy = parent.dy.to_i64()
    val lm11 = local.m11.to_i64()
    val lm12 = local.m12.to_i64()
    val lm21 = local.m21.to_i64()
    val lm22 = local.m22.to_i64()
    val ldx = local.dx.to_i64()
    val ldy = local.dy.to_i64()

    val m11 = (pm11 * lm11 + pm12 * lm21) / _MILLI
    val m12 = (pm11 * lm12 + pm12 * lm22) / _MILLI
    val m21 = (pm21 * lm11 + pm22 * lm21) / _MILLI
    val m22 = (pm21 * lm12 + pm22 * lm22) / _MILLI
    val dx = (pm11 * ldx + pm12 * ldy) / _MILLI + pdx
    val dy = (pm21 * ldx + pm22 * ldy) / _MILLI + pdy

    DrawIrV3Mat2x3(
        m11: m11.to_i32(), m12: m12.to_i32(), m21: m21.to_i32(), m22: m22.to_i32(),
        dx: dx.to_i32(), dy: dy.to_i32()
    )

fn _draw_ir_v3_group_mat_apply_x(mat: DrawIrV3Mat2x3, x: i32, y: i32) -> i32:
    ((mat.m11.to_i64() * x.to_i64() + mat.m12.to_i64() * y.to_i64()) / _MILLI + mat.dx.to_i64()).to_i32()

fn _draw_ir_v3_group_mat_apply_y(mat: DrawIrV3Mat2x3, x: i32, y: i32) -> i32:
    ((mat.m21.to_i64() * x.to_i64() + mat.m22.to_i64() * y.to_i64()) / _MILLI + mat.dy.to_i64()).to_i32()

# AABB of a local-space rect's four corners after `mat`. Used only to derive
# `world_aabb(local_clip)` (design §4.1); NOT a general shape transform.
fn _draw_ir_v3_group_transform_aabb(mat: DrawIrV3Mat2x3, x: i32, y: i32, width: i32, height: i32) -> DrawIrV3Aabb:
    val x0 = _draw_ir_v3_group_mat_apply_x(mat, x, y)
    val y0 = _draw_ir_v3_group_mat_apply_y(mat, x, y)
    val x1 = _draw_ir_v3_group_mat_apply_x(mat, x + width, y)
    val y1 = _draw_ir_v3_group_mat_apply_y(mat, x + width, y)
    val x2 = _draw_ir_v3_group_mat_apply_x(mat, x, y + height)
    val y2 = _draw_ir_v3_group_mat_apply_y(mat, x, y + height)
    val x3 = _draw_ir_v3_group_mat_apply_x(mat, x + width, y + height)
    val y3 = _draw_ir_v3_group_mat_apply_y(mat, x + width, y + height)

    var min_x = x0
    min_x = _draw_ir_v3_group_min_i32(min_x, x1)
    min_x = _draw_ir_v3_group_min_i32(min_x, x2)
    min_x = _draw_ir_v3_group_min_i32(min_x, x3)
    var min_y = y0
    min_y = _draw_ir_v3_group_min_i32(min_y, y1)
    min_y = _draw_ir_v3_group_min_i32(min_y, y2)
    min_y = _draw_ir_v3_group_min_i32(min_y, y3)
    var max_x = x0
    max_x = _draw_ir_v3_group_max_i32(max_x, x1)
    max_x = _draw_ir_v3_group_max_i32(max_x, x2)
    max_x = _draw_ir_v3_group_max_i32(max_x, x3)
    var max_y = y0
    max_y = _draw_ir_v3_group_max_i32(max_y, y1)
    max_y = _draw_ir_v3_group_max_i32(max_y, y2)
    max_y = _draw_ir_v3_group_max_i32(max_y, y3)

    DrawIrV3Aabb(min_x: min_x, min_y: min_y, max_x: max_x, max_y: max_y)

# effective_clip(child) = intersect(effective_clip(parent), world_aabb(local_clip)).
# Sabotage target: dropping the clip (returning `parent` unchanged, or
# returning the child aabb unclipped by the parent) instead of intersecting
# is exactly the "silent degrade" design §0 decision 7 forbids.
fn _draw_ir_v3_group_clip_intersect(parent: DrawIrV3ClipState, child_aabb: DrawIrV3Aabb) -> DrawIrV3ClipState:
    if not parent.present:
        return DrawIrV3ClipState(
            present: true, x: child_aabb.min_x, y: child_aabb.min_y,
            width: child_aabb.max_x - child_aabb.min_x, height: child_aabb.max_y - child_aabb.min_y
        )
    val ix0 = _draw_ir_v3_group_max_i32(parent.x, child_aabb.min_x)
    val iy0 = _draw_ir_v3_group_max_i32(parent.y, child_aabb.min_y)
    val ix1 = _draw_ir_v3_group_min_i32(parent.x + parent.width, child_aabb.max_x)
    val iy1 = _draw_ir_v3_group_min_i32(parent.y + parent.height, child_aabb.max_y)
    var w = ix1 - ix0
    var h = iy1 - iy0
    if w < 0:
        w = 0
    if h < 0:
        h = 0
    DrawIrV3ClipState(present: true, x: ix0, y: iy0, width: w, height: h)

fn _draw_ir_v3_group_find_index(commands: [DrawIrV3Command], n: i64, component_id: u32) -> i64:
    var i: i64 = 0
    while i < n:
        if commands[i].component_id == component_id:
            return i
        i = i + 1
    -1

fn _draw_ir_v3_group_is_descendant(commands: [DrawIrV3Command], n: i64, index: i64, ancestor_component_id: u32) -> bool:
    var cur = commands[index].parent_id
    var hops: i64 = 0
    while cur != DRAW_IR_V3_NO_ID and hops < n:
        if cur == ancestor_component_id:
            return true
        val idx = _draw_ir_v3_group_find_index(commands, n, cur)
        if idx < 0:
            return false
        cur = commands[idx].parent_id
        hops = hops + 1
    false

struct DrawIrV3ContiguityCheck:
    ok: bool
    violation_index: u32

# Every command transitively descended from `group_component_id` (the full
# subtree, all levels -- not just direct children) must occupy one
# contiguous index block in `commands` (design §4.1 "descendants are
# contiguous"). Fail-closed structural check: a gap or an interleaved
# foreign command inside the span is a STRUCTURE receipt, never silently
# tolerated.
fn _draw_ir_v3_group_check_contiguous(commands: [DrawIrV3Command], n: i64, group_component_id: u32) -> DrawIrV3ContiguityCheck:
    var min_idx: i64 = -1
    var max_idx: i64 = -1
    var count: i64 = 0
    var j: i64 = 0
    while j < n:
        if _draw_ir_v3_group_is_descendant(commands, n, j, group_component_id):
            if min_idx < 0 or j < min_idx:
                min_idx = j
            if j > max_idx:
                max_idx = j
            count = count + 1
        j = j + 1
    if count == 0:
        return DrawIrV3ContiguityCheck(ok: true, violation_index: 0u32)
    val span = max_idx - min_idx + 1
    if span == count:
        return DrawIrV3ContiguityCheck(ok: true, violation_index: 0u32)
    DrawIrV3ContiguityCheck(ok: false, violation_index: min_idx.to_u32())

struct DrawIrV3PortLookup:
    found: bool
    available: bool
    current_generation: u32

fn _draw_ir_v3_group_port_lookup(ports: DrawIrV3PortSurfaceState, resource_id: u32) -> DrawIrV3PortLookup:
    var i: i64 = 0
    val n = ports.resource_ids.len().to_i64()
    while i < n:
        if ports.resource_ids[i] == resource_id:
            return DrawIrV3PortLookup(
                found: true, available: ports.available[i],
                current_generation: ports.current_generations[i]
            )
        i = i + 1
    DrawIrV3PortLookup(found: false, available: false, current_generation: 0u32)

# ---------------------------------------------------------------------------
# The resolver (pure pass, design §4).
# ---------------------------------------------------------------------------

# Resolution assumes `commands` is authored parent-before-descendant (index
# order = pre-order) -- the natural order a scene is built in. A command
# whose parent has not yet been resolved (parent index >= its own index)
# falls back to the identity/root state for that command, same as a missing
# parent; this is a defensive fallback, not a silent degrade of a case any
# required assertion exercises (a mis-ordered parent is itself a structural
# authoring bug, orthogonal to the contiguity check above).
fn draw_ir_v3_group_resolve(scene: DrawIrV3Scene, ports: DrawIrV3PortSurfaceState) -> DrawIrV3GroupResolveResult:
    val commands = scene.commands
    val n = commands.len().to_i64()

    var structure_receipts: [DrawIrV3GroupResolveReceipt] = []
    var si: i64 = 0
    while si < n:
        val scmd = commands[si]
        if scmd.kind == DRAW_IR_V3_KIND_GROUP:
            val check = _draw_ir_v3_group_check_contiguous(commands, n, scmd.component_id)
            if not check.ok:
                structure_receipts.push(DrawIrV3GroupResolveReceipt(
                    kind: DRAW_IR_V3_GROUP_RECEIPT_STRUCTURE,
                    command_index: si,
                    component_id: scmd.component_id,
                    detail: check.violation_index
                ))
        si = si + 1

    if structure_receipts.len() > 0:
        return DrawIrV3GroupResolveResult(ok: false, states: [], receipts: structure_receipts)

    var states: [DrawIrV3ResolvedCommand] = []
    var receipts: [DrawIrV3GroupResolveReceipt] = []
    var k: i64 = 0
    while k < n:
        val cmd = commands[k]

        var parent_mat = _draw_ir_v3_group_mat_identity()
        var parent_clip = DrawIrV3ClipState(present: false, x: 0, y: 0, width: 0, height: 0)
        var parent_opacity: i32 = 1000
        var parent_visible = true
        if cmd.parent_id != DRAW_IR_V3_NO_ID:
            val pidx = _draw_ir_v3_group_find_index(commands, n, cmd.parent_id)
            if pidx >= 0 and pidx < k:
                val ps = states[pidx]
                parent_mat = DrawIrV3Mat2x3(
                    m11: ps.world_m11, m12: ps.world_m12, m21: ps.world_m21,
                    m22: ps.world_m22, dx: ps.world_dx, dy: ps.world_dy
                )
                parent_clip = DrawIrV3ClipState(
                    present: ps.clip_present, x: ps.clip_x, y: ps.clip_y,
                    width: ps.clip_width, height: ps.clip_height
                )
                parent_opacity = ps.effective_opacity_milli
                parent_visible = ps.effective_visible

        val local_t = draw_ir_v3_transform_at(scene.transforms, cmd.transform_id)
        val local_mat = DrawIrV3Mat2x3(
            m11: local_t.m11, m12: local_t.m12, m21: local_t.m21,
            m22: local_t.m22, dx: local_t.dx, dy: local_t.dy
        )
        val world_mat = _draw_ir_v3_group_mat_compose(parent_mat, local_mat)

        val local_clip = draw_ir_v3_clip_at(scene.clips, cmd.clip_id)
        var needs_offscreen = false
        var effective_clip = parent_clip
        if local_clip.present:
            val aabb = _draw_ir_v3_group_transform_aabb(
                world_mat, local_clip.x, local_clip.y, local_clip.width, local_clip.height
            )
            effective_clip = _draw_ir_v3_group_clip_intersect(parent_clip, aabb)
            if world_mat.m12 != 0 or world_mat.m21 != 0:
                needs_offscreen = true

        var own_opacity: i32 = 1000
        if cmd.kind == DRAW_IR_V3_KIND_GROUP:
            val paint = draw_ir_v3_paint_at(scene.paint, cmd.paint_id)
            if paint.present:
                own_opacity = paint.opacity_milli
        val effective_opacity = (
            (parent_opacity.to_i64() * own_opacity.to_i64() + 500) / _MILLI
        ).to_i32()

        val local_visible = not draw_ir_v3_has_flag(cmd, DRAW_IR_V3_FLAG_HIDDEN)
        val effective_visible = parent_visible and local_visible

        var port_loud_marker = false
        if cmd.kind == DRAW_IR_V3_KIND_PORT:
            val lookup = _draw_ir_v3_group_port_lookup(ports, cmd.image_resource_id)
            if (not lookup.found) or (not lookup.available) or lookup.current_generation != cmd.component_generation:
                port_loud_marker = true
                receipts.push(DrawIrV3GroupResolveReceipt(
                    kind: DRAW_IR_V3_GROUP_RECEIPT_PORT_UNAVAILABLE,
                    command_index: k,
                    component_id: cmd.component_id,
                    detail: cmd.image_resource_id
                ))

        states.push(DrawIrV3ResolvedCommand(
            present: true,
            world_m11: world_mat.m11, world_m12: world_mat.m12,
            world_m21: world_mat.m21, world_m22: world_mat.m22,
            world_dx: world_mat.dx, world_dy: world_mat.dy,
            clip_present: effective_clip.present,
            clip_x: effective_clip.x, clip_y: effective_clip.y,
            clip_width: effective_clip.width, clip_height: effective_clip.height,
            effective_opacity_milli: effective_opacity,
            effective_visible: effective_visible,
            needs_offscreen: needs_offscreen,
            port_loud_marker: port_loud_marker
        ))
        k = k + 1

    DrawIrV3GroupResolveResult(ok: true, states: states, receipts: receipts)

# Hit test over resolved state: a point hits a shape iff it is inside every
# effective clip on the chain and inside the shape under the inverse world
# transform (design §4.1, "one transform truth for paint and hit"). Walks
# top-most (last-drawn) command first. An invisible command is excluded --
# both from batching (the resolver already dropped nothing, but callers
# should skip `not effective_visible` states when batching) and from hit
# testing, which this function enforces directly.
fn draw_ir_v3_group_resolve_hit_test(
    scene: DrawIrV3Scene, result: DrawIrV3GroupResolveResult, px: i32, py: i32
) -> DrawIrV3GroupHitResult:
    val commands = scene.commands
    val n = commands.len().to_i64()
    var i = n - 1
    while i >= 0:
        val cmd = commands[i]
        val st = result.states[i]
        if cmd.hit_shape_id != DRAW_IR_V3_NO_ID:  # SABOTAGE: dropped the effective_visible gate
            val shape = draw_ir_v3_hit_shape_at(scene.hit_shapes, cmd.hit_shape_id)
            if shape.present:
                var clip_ok = true
                if st.clip_present:
                    clip_ok = (
                        px >= st.clip_x and px < st.clip_x + st.clip_width
                        and py >= st.clip_y and py < st.clip_y + st.clip_height
                    )
                if clip_ok:
                    val det = st.world_m11.to_i64() * st.world_m22.to_i64() - st.world_m12.to_i64() * st.world_m21.to_i64()
                    if det != 0:
                        val rel_x = (px - st.world_dx).to_i64()
                        val rel_y = (py - st.world_dy).to_i64()
                        val inv_m11_num = st.world_m22.to_i64() * 1000000
                        val inv_m12_num = 0 - st.world_m12.to_i64() * 1000000
                        val inv_m21_num = 0 - st.world_m21.to_i64() * 1000000
                        val inv_m22_num = st.world_m11.to_i64() * 1000000
                        val local_x = ((inv_m11_num * rel_x + inv_m12_num * rel_y) / det) / _MILLI
                        val local_y = ((inv_m21_num * rel_x + inv_m22_num * rel_y) / det) / _MILLI
                        if (
                            local_x >= shape.x.to_i64() and local_x < (shape.x.to_i64() + shape.width.to_i64())
                            and local_y >= shape.y.to_i64() and local_y < (shape.y.to_i64() + shape.height.to_i64())
                        ):
                            return DrawIrV3GroupHitResult(hit: true, command_index: i, component_id: cmd.component_id)
        i = i - 1
    DrawIrV3GroupHitResult(hit: false, command_index: -1, component_id: DRAW_IR_V3_NO_ID)

# Executor-side capability gate for a NEEDS_OFFSCREEN batch (design §4.1
# "refuse-don't-degrade"): an executor without offscreen support MUST refuse
# with a receipt rather than render the clip dropped. This lane owns the
# gate function; it does not own a real backend executor (none exists yet).
fn draw_ir_v3_group_execute_check(
    state: DrawIrV3ResolvedCommand, command_index: i64, component_id: u32, supports_offscreen: bool
) -> DrawIrV3GroupResolveReceipt:
    if state.needs_offscreen and not supports_offscreen:
        return DrawIrV3GroupResolveReceipt(
            kind: DRAW_IR_V3_GROUP_RECEIPT_OFFSCREEN_UNSUPPORTED,
            command_index: command_index,
            component_id: component_id,
            detail: 0u32
        )
    DrawIrV3GroupResolveReceipt(
        kind: DRAW_IR_V3_GROUP_RECEIPT_NONE, command_index: command_index,
        component_id: component_id, detail: 0u32
    )

export DRAW_IR_V3_GROUP_RECEIPT_NONE, DRAW_IR_V3_GROUP_RECEIPT_STRUCTURE,
