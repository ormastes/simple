# Shared spreadsheet viewport geometry.
#
# Calc's terminal and web producers use this contract for the logical grid.
# Backends remain responsible for their own paint details (ANSI borders, CSS,
# pixels), while row/column order and cell sizing stay backend-independent.

use common.ui.builder.{grid_layout}
use common.ui.widget.{WidgetNode}

struct SpreadsheetGridMetrics:
    visible_columns: i32
    visible_rows: i32
    cell_width: i32
    row_header_width: i32

fn spreadsheet_grid_metrics(visible_columns: i32, visible_rows: i32, cell_width: i32, row_header_width: i32) -> SpreadsheetGridMetrics:
    SpreadsheetGridMetrics(
        visible_columns: visible_columns,
        visible_rows: visible_rows,
        cell_width: cell_width,
        row_header_width: row_header_width
    )

fn spreadsheet_grid_default_metrics() -> SpreadsheetGridMetrics:
    # The documented Calc viewport is a 20 x 30 sheet.  4 + 20 * 6 = 124,
    # which is the canonical terminal viewport width, not a TUI-local magic
    # number.
    spreadsheet_grid_metrics(20, 30, 6, 4)

fn spreadsheet_grid_width(metrics: SpreadsheetGridMetrics) -> i32:
    metrics.row_header_width + metrics.visible_columns * metrics.cell_width

fn spreadsheet_grid_column_label(column: i32) -> text:
    """Return the zero-based spreadsheet column label (A, ..., Z, AA...)."""
    var value = column + 1
    var out = ""
    while value > 0:
        val remainder = (value - 1) % 26
        out = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".char_at(remainder) + out
        value = (value - 1) / 26
    out

fn spreadsheet_grid_widget(id: text, cells: [WidgetNode], metrics: SpreadsheetGridMetrics) -> WidgetNode:
    """Create the canonical semantic grid consumed by common.ui.layout.

    `columns` makes compute_layout and web/CSS grid lowering use the same
    row-major placement as the Calc terminal projection.
    """
    var grid = grid_layout(id, cells)
    grid = grid.set_prop("columns", metrics.visible_columns.to_text())
    grid = grid.set_prop("cell_width", metrics.cell_width.to_text())
    grid = grid.set_prop("row_header_width", metrics.row_header_width.to_text())
    grid

export SpreadsheetGridMetrics
export spreadsheet_grid_metrics, spreadsheet_grid_default_metrics
export spreadsheet_grid_width, spreadsheet_grid_column_label, spreadsheet_grid_widget
