# Renderer-neutral, immutable-by-convention theme material values.
#
# These values are shared by hosted package resolution and generated
# bare-metal themes. All hashes use fixed-order integer serialization so a
# backend cannot reinterpret CSS text and silently change the theme identity.

use std.common.crypto.sha256.{sha256_text}
use common.ui.native_scalar_text.{ui_native_i64_text}

class ThemeShadowLayer:
    offset_x_px: i32
    offset_y_px: i32
    blur_radius_px: i32
    spread_radius_px: i32
    rgba: u32
    inset: bool

class ThemeMaterialSemantics:
    desktop_fill_rgba: u32
    window_fill_rgba: u32
    active_title_fill_rgba: u32
    inactive_title_fill_rgba: u32
    surface_alpha_milli: i32
    backdrop_blur_px: i32
    backdrop_saturation_milli: i32
    border_width_px: i32
    border_rgba: u32
    corner_radius_px: i32
    active_shadows: [ThemeShadowLayer]
    inactive_shadows: [ThemeShadowLayer]
    font_family: text
    font_size_px: i32
    font_weight: i32
    text_rgba: u32
    secondary_text_rgba: u32
    solid_fallback_rgba: u32
    fallback_contrast_milli: i32
    # Package resolution normalizes the `.wm-window` background into the
    # limited two-stop format Engine2D actually accepts. The colors are
    # already opaque: transparent CSS overlay stops have been composited over
    # `solid_fallback_rgba`, so a backend never needs to parse CSS or guess a
    # destination surface.
    window_gradient_available: bool
    window_gradient_start_rgba: u32
    window_gradient_end_rgba: u32
    window_gradient_source_css: text

class ThemeRenderSnapshot:
    id: text
    family_id: text
    source_reference: text
    source_manifest_sha256: text
    material_sha256: text
    composed_css: text
    background_rgba: u32
    foreground_rgba: u32
    accent_rgba: u32
    material: ThemeMaterialSemantics

fn _normalized_shadow_text(prefix: text, shadows: [ThemeShadowLayer]) -> text:
    var out = (
        prefix + ".count=" + ui_native_i64_text(shadows.len()) + "\n"
    )
    var index = 0
    for shadow in shadows:
        val key = prefix + "." + ui_native_i64_text(index as i64)
        out = (
            out + key + ".x=" +
            ui_native_i64_text(shadow.offset_x_px as i64) + "\n"
        )
        out = (
            out + key + ".y=" +
            ui_native_i64_text(shadow.offset_y_px as i64) + "\n"
        )
        out = (
            out + key + ".blur=" +
            ui_native_i64_text(shadow.blur_radius_px as i64) + "\n"
        )
        out = (
            out + key + ".spread=" +
            ui_native_i64_text(shadow.spread_radius_px as i64) + "\n"
        )
        out = (
            out + key + ".rgba=" +
            ui_native_i64_text(shadow.rgba as i64) + "\n"
        )
        out = (
            out + key + ".inset=" +
            (if shadow.inset: "true" else: "false") + "\n"
        )
        index = index + 1
    out

fn normalized_theme_material_text(material: ThemeMaterialSemantics) -> text:
    var out = "theme-material-v2\n"
    out = out + "desktop_fill_rgba=" + ui_native_i64_text(
        material.desktop_fill_rgba as i64
    ) + "\n"
    out = out + "window_fill_rgba=" + ui_native_i64_text(
        material.window_fill_rgba as i64
    ) + "\n"
    out = out + "active_title_fill_rgba=" + ui_native_i64_text(
        material.active_title_fill_rgba as i64
    ) + "\n"
    out = out + "inactive_title_fill_rgba=" + ui_native_i64_text(
        material.inactive_title_fill_rgba as i64
    ) + "\n"
    out = out + "surface_alpha_milli=" + ui_native_i64_text(
        material.surface_alpha_milli as i64
    ) + "\n"
    out = out + "backdrop_blur_px=" + ui_native_i64_text(
        material.backdrop_blur_px as i64
    ) + "\n"
    out = out + "backdrop_saturation_milli=" + ui_native_i64_text(
        material.backdrop_saturation_milli as i64
    ) + "\n"
    out = out + "border_width_px=" + ui_native_i64_text(
        material.border_width_px as i64
    ) + "\n"
    out = out + "border_rgba=" + ui_native_i64_text(
        material.border_rgba as i64
    ) + "\n"
    out = out + "corner_radius_px=" + ui_native_i64_text(
        material.corner_radius_px as i64
    ) + "\n"
    out = out + _normalized_shadow_text(
        "active_shadow", material.active_shadows
    )
    out = out + _normalized_shadow_text(
        "inactive_shadow", material.inactive_shadows
    )
    out = out + "font_family=" + material.font_family + "\n"
    out = out + "font_size_px=" + ui_native_i64_text(
        material.font_size_px as i64
    ) + "\n"
    out = out + "font_weight=" + ui_native_i64_text(
        material.font_weight as i64
    ) + "\n"
    out = out + "text_rgba=" + ui_native_i64_text(
        material.text_rgba as i64
    ) + "\n"
    out = out + "secondary_text_rgba=" + ui_native_i64_text(
        material.secondary_text_rgba as i64
    ) + "\n"
    out = out + "solid_fallback_rgba=" + ui_native_i64_text(
        material.solid_fallback_rgba as i64
    ) + "\n"
    out = out + "fallback_contrast_milli=" + ui_native_i64_text(
        material.fallback_contrast_milli as i64
    ) + "\n"
    out = (
        out + "window_gradient_available=" +
        (if material.window_gradient_available: "true" else: "false") + "\n"
    )
    out = out + "window_gradient_start_rgba=" + ui_native_i64_text(
        material.window_gradient_start_rgba as i64
    ) + "\n"
    out = out + "window_gradient_end_rgba=" + ui_native_i64_text(
        material.window_gradient_end_rgba as i64
    ) + "\n"
    out = (
        out + "window_gradient_source_css=" +
        material.window_gradient_source_css + "\n"
    )
    out

fn theme_material_sha256(material: ThemeMaterialSemantics) -> text:
    sha256_text(normalized_theme_material_text(material))

export ThemeShadowLayer, ThemeMaterialSemantics, ThemeRenderSnapshot
export normalized_theme_material_text, theme_material_sha256
