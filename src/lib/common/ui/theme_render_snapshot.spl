# Renderer-neutral, immutable-by-convention theme material values.
#
# These values are shared by hosted package resolution and generated
# bare-metal themes. All hashes use fixed-order integer serialization so a
# backend cannot reinterpret CSS text and silently change the theme identity.

use std.common.crypto.sha256.{sha256_text}
use common.ui.native_scalar_text.{ui_native_i64_text}

class ThemeShadowLayer:
    offset_x_px: i32
    offset_y_px: i32
    blur_radius_px: i32
    spread_radius_px: i32
    rgba: u32
    inset: bool

class ThemeMaterialSemantics:
    desktop_fill_rgba: u32
    window_fill_rgba: u32
    active_title_fill_rgba: u32
    inactive_title_fill_rgba: u32
    surface_alpha_milli: i32
    backdrop_blur_px: i32
    backdrop_saturation_milli: i32
    border_width_px: i32
    border_rgba: u32
    corner_radius_px: i32
    active_shadows: [ThemeShadowLayer]
    inactive_shadows: [ThemeShadowLayer]
    font_family: text
    font_size_px: i32
    font_weight: i32
    text_rgba: u32
    secondary_text_rgba: u32
    solid_fallback_rgba: u32
    fallback_contrast_milli: i32
    # Package resolution normalizes the `.wm-window` background into the
    # limited two-stop format Engine2D actually accepts. The colors are
    # already opaque: transparent CSS overlay stops have been composited over
    # `solid_fallback_rgba`, so a backend never needs to parse CSS or guess a
    # destination surface.
    window_gradient_available: bool
    window_gradient_start_rgba: u32
    window_gradient_end_rgba: u32
    window_gradient_source_css: text

class ThemeSemanticColors:
    # Real values are parsed from the same package base-CSS variables used to
    # build ResolvedThemePackage.ui_theme.colors. These class defaults are the
    # fallback for every OTHER construction site (generated fixtures, wire
    # decode, test fixtures) that predates this field and never sets it.
    info_rgba: u32 = 0xFF3B82F6u32
    success_rgba: u32 = 0xFF22C55Eu32
    warning_rgba: u32 = 0xFFF59E0Bu32
    error_rgba: u32 = 0xFFEF4444u32

class ThemeRenderSnapshot:
    id: text
    family_id: text
    source_reference: text
    source_manifest_sha256: text
    material_sha256: text
    composed_css: text
    background_rgba: u32
    foreground_rgba: u32
    accent_rgba: u32
    material: ThemeMaterialSemantics
    # Semantic status colors (info/success/warning/error). Deliberately a
    # top-level ThemeRenderSnapshot field, NOT part of ThemeMaterialSemantics
    # -- theme_material_sha256/normalized_theme_material_text hash only the
    # `material` sub-struct, so adding this field does not change the
    # material fingerprint's semantics. Defaults to the fixed constants
    # below so every pre-existing construction site keeps compiling.
    semantic: ThemeSemanticColors = ThemeSemanticColors()

fn _normalized_shadow_text(prefix: text, shadows: [ThemeShadowLayer]) -> text:
    var out = (
        prefix + ".count=" + ui_native_i64_text(shadows.len()) + "\n"
    )
    var index = 0
    for shadow in shadows:
        val key = prefix + "." + ui_native_i64_text(index as i64)
        out = (
            out + key + ".x=" +
            ui_native_i64_text(shadow.offset_x_px as i64) + "\n"
        )
        out = (
            out + key + ".y=" +
            ui_native_i64_text(shadow.offset_y_px as i64) + "\n"
        )
        out = (
            out + key + ".blur=" +
            ui_native_i64_text(shadow.blur_radius_px as i64) + "\n"
        )
        out = (
            out + key + ".spread=" +
            ui_native_i64_text(shadow.spread_radius_px as i64) + "\n"
        )
        out = (
            out + key + ".rgba=" +
            ui_native_i64_text(shadow.rgba as i64) + "\n"
        )
        out = (
            out + key + ".inset=" +
            (if shadow.inset: "true" else: "false") + "\n"
        )
        index = index + 1
    out

fn normalized_theme_material_text(material: ThemeMaterialSemantics) -> text:
    var out = "theme-material-v2\n"
    out = out + "desktop_fill_rgba=" + ui_native_i64_text(
        material.desktop_fill_rgba as i64
    ) + "\n"
    out = out + "window_fill_rgba=" + ui_native_i64_text(
        material.window_fill_rgba as i64
    ) + "\n"
    out = out + "active_title_fill_rgba=" + ui_native_i64_text(
        material.active_title_fill_rgba as i64
    ) + "\n"
    out = out + "inactive_title_fill_rgba=" + ui_native_i64_text(
        material.inactive_title_fill_rgba as i64
    ) + "\n"
    out = out + "surface_alpha_milli=" + ui_native_i64_text(
        material.surface_alpha_milli as i64
    ) + "\n"
    out = out + "backdrop_blur_px=" + ui_native_i64_text(
        material.backdrop_blur_px as i64
    ) + "\n"
    out = out + "backdrop_saturation_milli=" + ui_native_i64_text(
        material.backdrop_saturation_milli as i64
    ) + "\n"
    out = out + "border_width_px=" + ui_native_i64_text(
        material.border_width_px as i64
    ) + "\n"
    out = out + "border_rgba=" + ui_native_i64_text(
        material.border_rgba as i64
    ) + "\n"
    out = out + "corner_radius_px=" + ui_native_i64_text(
        material.corner_radius_px as i64
    ) + "\n"
    out = out + _normalized_shadow_text(
        "active_shadow", material.active_shadows
    )
    out = out + _normalized_shadow_text(
        "inactive_shadow", material.inactive_shadows
    )
    out = out + "font_family=" + material.font_family + "\n"
    out = out + "font_size_px=" + ui_native_i64_text(
        material.font_size_px as i64
    ) + "\n"
    out = out + "font_weight=" + ui_native_i64_text(
        material.font_weight as i64
    ) + "\n"
    out = out + "text_rgba=" + ui_native_i64_text(
        material.text_rgba as i64
    ) + "\n"
    out = out + "secondary_text_rgba=" + ui_native_i64_text(
        material.secondary_text_rgba as i64
    ) + "\n"
    out = out + "solid_fallback_rgba=" + ui_native_i64_text(
        material.solid_fallback_rgba as i64
    ) + "\n"
    out = out + "fallback_contrast_milli=" + ui_native_i64_text(
        material.fallback_contrast_milli as i64
    ) + "\n"
    out = (
        out + "window_gradient_available=" +
        (if material.window_gradient_available: "true" else: "false") + "\n"
    )
    out = out + "window_gradient_start_rgba=" + ui_native_i64_text(
        material.window_gradient_start_rgba as i64
    ) + "\n"
    out = out + "window_gradient_end_rgba=" + ui_native_i64_text(
        material.window_gradient_end_rgba as i64
    ) + "\n"
    out = (
        out + "window_gradient_source_css=" +
        material.window_gradient_source_css + "\n"
    )
    out

fn theme_material_sha256(material: ThemeMaterialSemantics) -> text:
    sha256_text(normalized_theme_material_text(material))

# =========================================================================
# Semantic role hierarchy (IDE extension kernel, lane L5, 2026-07-29)
#
# Extensions and kernel widgets ask for a *role* (`wm.titlebar`,
# `document.selection`, ...) instead of poking ThemeRenderSnapshot/
# ThemeMaterialSemantics fields directly. This keeps every consumer
# (Markdown/Writer/Sheets/Slides editors, WM chrome, extension theme
# contributions) aligned on one vocabulary and lets unknown roles fail soft
# (default foreground + a diagnostic flag) instead of crashing.
#
# ThemeRenderSnapshot carries real semantic status colors
# (info/success/warning/error) via the `semantic: ThemeSemanticColors`
# field below, sourced from the package base CSS in theme_package.spl's
# snapshot builder. `semantic.*`
# roles resolve to `snapshot.semantic.*`; the WCAG-contrast-checked
# constants in ThemeSemanticColors' field defaults are only the fallback
# used by construction sites that don't populate the field (generated
# fixtures, wire decode, test fixtures predating this change).
# =========================================================================

class ThemeRoleColor:
    role: text
    rgba: u32
    hex: text
    # false only when `role` was not recognized and the default foreground
    # was substituted — callers should surface this as a diagnostic, not a
    # crash.
    known: bool

val THEME_SEMANTIC_INFO_RGBA: u32 = 0xFF3B82F6u32
val THEME_SEMANTIC_SUCCESS_RGBA: u32 = 0xFF22C55Eu32
val THEME_SEMANTIC_WARNING_RGBA: u32 = 0xFFF59E0Bu32
val THEME_SEMANTIC_ERROR_RGBA: u32 = 0xFFEF4444u32

fn _theme_role_hex_digit(value: u32) -> text:
    val digits = "0123456789ABCDEF"
    digits.char_at(value.to_i64())

fn _theme_role_argb_to_hex(value: u32) -> text:
    val a = (value >> 24) & 0xFFu32
    val r = (value >> 16) & 0xFFu32
    val g = (value >> 8) & 0xFFu32
    val b = value & 0xFFu32
    "#{_theme_role_hex_digit(a >> 4)}{_theme_role_hex_digit(a & 0xFu32)}{_theme_role_hex_digit(r >> 4)}{_theme_role_hex_digit(r & 0xFu32)}{_theme_role_hex_digit(g >> 4)}{_theme_role_hex_digit(g & 0xFu32)}{_theme_role_hex_digit(b >> 4)}{_theme_role_hex_digit(b & 0xFu32)}"

# Resolve a semantic role name to an ARGB color, WITHOUT the `known` flag.
# Kept separate from `theme_role_color` so callers that only need the raw
# u32 (e.g. draw-IR fast paths) never carry the ThemeRoleColor aggregate.
fn _theme_role_rgba(snapshot: ThemeRenderSnapshot, role: text) -> u32:
    val material = snapshot.material
    # --- window manager chrome ---
    if role == "wm.titlebar":
        return material.active_title_fill_rgba
    if role == "wm.border":
        return material.border_rgba
    if role == "wm.controls":
        return snapshot.accent_rgba
    # --- workbench (IDE shell) ---
    if role == "workbench.activity_bar":
        return material.window_fill_rgba
    if role == "workbench.sidebar":
        return material.window_fill_rgba
    if role == "workbench.tab_bar":
        return material.inactive_title_fill_rgba
    if role == "workbench.editor":
        return snapshot.background_rgba
    if role == "workbench.panel":
        return material.window_fill_rgba
    if role == "workbench.status_bar":
        return material.active_title_fill_rgba
    if role == "workbench.focus_ring":
        return snapshot.accent_rgba
    # --- document (Writer / Markdown) ---
    if role == "document.paper":
        return snapshot.background_rgba
    if role == "document.text":
        return snapshot.foreground_rgba
    if role == "document.selection":
        return snapshot.accent_rgba
    if role == "document.cursor":
        return snapshot.accent_rgba
    if role == "document.heading":
        return material.text_rgba
    # --- sheet (Sheets) ---
    if role == "sheet.grid":
        return material.border_rgba
    if role == "sheet.header":
        return material.window_fill_rgba
    if role == "sheet.active_cell":
        return snapshot.accent_rgba
    if role == "sheet.error_cell":
        return snapshot.semantic.error_rgba
    # --- slide (Slides) ---
    if role == "slide.workspace":
        return material.desktop_fill_rgba
    if role == "slide.canvas":
        return snapshot.background_rgba
    if role == "slide.placeholder":
        return material.secondary_text_rgba
    # --- semantic status colors (see module note above) ---
    if role == "semantic.info":
        return snapshot.semantic.info_rgba
    if role == "semantic.success":
        return snapshot.semantic.success_rgba
    if role == "semantic.warning":
        return snapshot.semantic.warning_rgba
    if role == "semantic.error":
        return snapshot.semantic.error_rgba
    snapshot.foreground_rgba

fn theme_role_is_known(role: text) -> bool:
    """True when `role` is one of the roles theme_role_color resolves
    directly (rather than falling back to the default foreground)."""
    if role == "wm.titlebar": return true
    if role == "wm.border": return true
    if role == "wm.controls": return true
    if role == "workbench.activity_bar": return true
    if role == "workbench.sidebar": return true
    if role == "workbench.tab_bar": return true
    if role == "workbench.editor": return true
    if role == "workbench.panel": return true
    if role == "workbench.status_bar": return true
    if role == "workbench.focus_ring": return true
    if role == "document.paper": return true
    if role == "document.text": return true
    if role == "document.selection": return true
    if role == "document.cursor": return true
    if role == "document.heading": return true
    if role == "sheet.grid": return true
    if role == "sheet.header": return true
    if role == "sheet.active_cell": return true
    if role == "sheet.error_cell": return true
    if role == "slide.workspace": return true
    if role == "slide.canvas": return true
    if role == "slide.placeholder": return true
    if role == "semantic.info": return true
    if role == "semantic.success": return true
    if role == "semantic.warning": return true
    if role == "semantic.error": return true
    false

fn theme_role_color(snapshot: ThemeRenderSnapshot, role: text) -> ThemeRoleColor:
    """Resolve a semantic role (`wm.*`, `workbench.*`, `document.*`,
    `sheet.*`, `slide.*`, `semantic.*`) to a concrete color on `snapshot`.

    Unknown roles never crash: they resolve to the snapshot's default
    foreground color with `known: false` so callers can surface a
    diagnostic instead of rendering garbage."""
    val rgba = _theme_role_rgba(snapshot, role)
    val is_known = theme_role_is_known(role)
    ThemeRoleColor(
        role: role,
        rgba: rgba,
        hex: _theme_role_argb_to_hex(rgba),
        known: is_known
    )

# =========================================================================
# Extension theme-fragment validation
#
# Extensions contribute theme overrides as a role -> color dict. The kernel
# decodes the SDN contribution and calls this before installing it: only
# additions under a recognized namespace prefix are accepted. `ext.*` is
# reserved for extension-private roles that never collide with the built-in
# hierarchy above.
# =========================================================================

val THEME_ROLE_PREFIXES: [text] = ["wm.", "workbench.", "document.", "sheet.", "slide.", "semantic.", "ext."]

class ThemeFragmentIssue:
    key: text
    message: text

fn _theme_role_prefix_allowed(key: text) -> bool:
    for prefix in THEME_ROLE_PREFIXES:
        if key.starts_with(prefix):
            return true
    false

fn validate_theme_fragment(fragment: Dict<text, text>) -> [ThemeFragmentIssue]:
    """Validate an extension theme-contribution fragment (role -> color).

    Only keys under a recognized namespace prefix (wm./workbench./
    document./sheet./slide./semantic./ext.) are accepted; every other key
    is reported as an issue rather than silently applied."""
    var issues: [ThemeFragmentIssue] = []
    for key in fragment.keys():
        if key == "":
            issues = issues.push(ThemeFragmentIssue(key: key, message: "theme fragment key must not be empty"))
            continue
        if not _theme_role_prefix_allowed(key):
            issues = issues.push(ThemeFragmentIssue(key: key, message: "unknown role prefix (expected wm./workbench./document./sheet./slide./semantic./ext.)"))
    issues

export ThemeShadowLayer, ThemeMaterialSemantics, ThemeSemanticColors, ThemeRenderSnapshot
export normalized_theme_material_text, theme_material_sha256
export ThemeRoleColor, theme_role_color, theme_role_is_known
export ThemeFragmentIssue, validate_theme_fragment
export THEME_SEMANTIC_INFO_RGBA, THEME_SEMANTIC_SUCCESS_RGBA, THEME_SEMANTIC_WARNING_RGBA, THEME_SEMANTIC_ERROR_RGBA
