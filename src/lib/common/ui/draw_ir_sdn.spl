# Draw IR SDN interchange skin.
#
# This is intentionally hand-written. Draw IR remains the typed source of
# truth; SDN is a deterministic inspection/interchange representation.

use common.ui.draw_ir.{
    DRAW_IR_COMMAND_EDGE,
    DRAW_IR_COMMAND_RECT,
    DRAW_IR_SCHEMA_VERSION,
    DRAW_IR_SCHEMA_VERSION_V2,
    DRAW_IR_SCHEMA_VERSION_V4,
    DRAW_IR_RASTER_ALIASED_PIXEL_CENTER,
    DRAW_IR_RASTER_COVERAGE_AA,
    DrawEdge,
    DrawIrBatch,
    DrawIrCommand,
    DrawIrComposition,
    DrawIrAffine2D,
    DrawIrFractionalGeometry,
    DrawIrGlyphRunPayload,
    DrawIrPoint,
    DrawIrRect,
    DrawIrSourceInfo,
    DrawIrStyleProp,
    draw_edge,
    draw_ir_batch_with_source,
    draw_ir_batch_with_source_v4,
    draw_ir_composition,
    draw_ir_composition_v4,
    draw_ir_embedding_config,
    draw_ir_empty_glyph_run_payload,
    draw_ir_fractional_geometry,
    draw_ir_affine2d,
    draw_ir_glyph_run_payload,
    draw_ir_point,
    draw_ir_rect,
    draw_ir_source_info,
    draw_ir_style_prop
}
use std.common.base_encoding.utilities.{base_encoding_bytes_to_text as bytes_to_text}

val _DRAW_IR_SDN_MAX_GLYPHS: i32 = 4096

fn _draw_ir_sdn_escape(value: text) -> text:
    var escaped = value.replace("%", "%25")
    escaped = escaped.replace("\t", "%09")
    escaped = escaped.replace("\n", "%0A")
    escaped = escaped.replace(" ", "%20")
    escaped.replace("=", "%3D")

fn _draw_ir_sdn_unescape(value: text) -> text:
    var unescaped = value.replace("%3D", "=")
    unescaped = unescaped.replace("%20", " ")
    unescaped = unescaped.replace("%0A", "\n")
    unescaped = unescaped.replace("%09", "\t")
    unescaped.replace("%25", "%")

fn _draw_ir_sdn_token_starts_with(line_bytes: [i64], start: i64, end: i64, prefix_bytes: [i64]) -> bool:
    if end - start < prefix_bytes.len():
        return false
    var index: i64 = 0
    while index < prefix_bytes.len():
        if line_bytes[start + index] != prefix_bytes[index]:
            return false
        index = index + 1
    true

fn _draw_ir_sdn_byte_slice(source_bytes: [i64], start: i64, end: i64) -> text:
    var bytes: [u8] = []
    var index = start
    while index < end:
        bytes.push(source_bytes[index].to_u8())
        index = index + 1
    bytes_to_text(bytes)

fn _draw_ir_sdn_field(line: text, key: text) -> text:
    val prefix = "{key}="
    val line_bytes = line.bytes()
    val prefix_bytes = prefix.bytes()
    var start: i64 = 0
    while start < line.len():
        while start < line.len() and line_bytes[start] == 32:
            start = start + 1
        var end = start
        while end < line.len() and line_bytes[end] != 32:
            end = end + 1
        if _draw_ir_sdn_token_starts_with(line_bytes, start, end, prefix_bytes):
            return _draw_ir_sdn_unescape(_draw_ir_sdn_byte_slice(line_bytes, start + prefix_bytes.len(), end))
        start = end + 1
    ""

fn _draw_ir_sdn_has_field(line: text, key: text) -> bool:
    val prefix = "{key}="
    for part in line.split(" "):
        if part.starts_with(prefix):
            return true
    false

fn _draw_ir_sdn_i32(line: text, key: text) -> i32:
    val value = _draw_ir_sdn_field(line, key)
    _draw_ir_sdn_parse_i32(value)

fn _draw_ir_sdn_bool(line: text, key: text) -> bool:
    _draw_ir_sdn_field(line, key) == "true"

fn _draw_ir_sdn_digit(c: text) -> i32:
    if c == "0":
        return 0
    if c == "1":
        return 1
    if c == "2":
        return 2
    if c == "3":
        return 3
    if c == "4":
        return 4
    if c == "5":
        return 5
    if c == "6":
        return 6
    if c == "7":
        return 7
    if c == "8":
        return 8
    if c == "9":
        return 9
    -1

fn _draw_ir_sdn_parse_i32(value: text) -> i32:
    if value == "":
        return 0
    var sign = 1
    var i = 0
    if value[0] == "-":
        sign = -1
        i = 1
    var parsed: i64 = 0
    val limit: i64 = if sign < 0: 2147483648 else: 2147483647
    val value_len = value.len()
    while i < value_len:
        val digit = _draw_ir_sdn_digit(value[i])
        if digit < 0:
            return 0
        if parsed > (limit - digit.to_i64()) / 10:
            return 0
        parsed = parsed * 10 + digit.to_i64()
        i = i + 1
    (parsed * sign.to_i64()) as i32

fn _draw_ir_sdn_parse_u32(value: text) -> u32:
    var i = 0
    var parsed: i64 = 0
    val value_len = value.len()
    while i < value_len:
        val digit = _draw_ir_sdn_digit(value[i])
        if digit < 0:
            return 0u32
        if parsed > (4294967295 - digit.to_i64()) / 10:
            return 0u32
        parsed = parsed * 10 + digit.to_i64()
        i = i + 1
    parsed as u32

fn _draw_ir_sdn_u32(line: text, key: text) -> u32:
    val value = _draw_ir_sdn_field(line, key)
    _draw_ir_sdn_parse_u32(value)

# Reject malformed v3 coordinates instead of allowing text.to_f64() to turn
# garbage into zero. Exponent syntax is accepted for f64.to_string() output.
fn _draw_ir_sdn_decimal_valid(value: text) -> bool:
    if value.len() == 0:
        return false
    var index = 0
    if value[index] == "-" or value[index] == "+":
        index = index + 1
    var digits = 0
    while index < value.len() and _draw_ir_sdn_digit(value[index]) >= 0:
        digits = digits + 1
        index = index + 1
    if index < value.len() and value[index] == ".":
        index = index + 1
        while index < value.len() and _draw_ir_sdn_digit(value[index]) >= 0:
            digits = digits + 1
            index = index + 1
    if digits == 0:
        return false
    if index < value.len() and (value[index] == "e" or value[index] == "E"):
        index = index + 1
        if index < value.len() and (value[index] == "-" or value[index] == "+"):
            index = index + 1
        var exponent_digits = 0
        while index < value.len() and _draw_ir_sdn_digit(value[index]) >= 0:
            exponent_digits = exponent_digits + 1
            index = index + 1
        if exponent_digits == 0:
            return false
    index == value.len()

fn _draw_ir_sdn_decimal_has_nonzero_digit(value: text) -> bool:
    for digit in value:
        if digit == "e" or digit == "E":
            break
        if digit == "1" or digit == "2" or digit == "3" or digit == "4" or
                digit == "5" or digit == "6" or digit == "7" or digit == "8" or digit == "9":
            return true
    false

fn _draw_ir_sdn_f64(line: text, key: text) -> f64:
    val raw = _draw_ir_sdn_field(line, key)
    if not _draw_ir_sdn_decimal_valid(raw):
        panic("invalid Draw IR fractional coordinate: {key}")
    val value = raw.to_f64()
    if value != value or value > 1.0e300 or value < -1.0e300 or
            (value == 0.0 and _draw_ir_sdn_decimal_has_nonzero_digit(raw)):
        panic("non-finite Draw IR fractional coordinate: {key}")
    value

fn _draw_ir_sdn_parse_fractional_geometry(line: text) -> DrawIrFractionalGeometry?:
    val present = _draw_ir_sdn_field(line, "fractional_present")
    if present == "" or present == "false":
        return nil
    if present != "true":
        panic("invalid Draw IR fractional presence")
    draw_ir_fractional_geometry(
        _draw_ir_sdn_f64(line, "fractional_x"),
        _draw_ir_sdn_f64(line, "fractional_y"),
        _draw_ir_sdn_f64(line, "fractional_width"),
        _draw_ir_sdn_f64(line, "fractional_height")
    )

fn _draw_ir_sdn_parse_affine(line: text, source_schema: text) -> DrawIrAffine2D?:
    val present = _draw_ir_sdn_field(line, "affine_present")
    if source_schema != DRAW_IR_SCHEMA_VERSION_V4:
        if _draw_ir_sdn_has_field(line, "affine_present") or
                _draw_ir_sdn_has_field(line, "raster_policy"):
            panic("affine Draw IR fields require v4 schema")
        return nil
    if present == "false":
        return nil
    if present != "true":
        panic("invalid v4 affine presence field")
    draw_ir_affine2d(
        _draw_ir_sdn_f64(line, "affine_a"),
        _draw_ir_sdn_f64(line, "affine_b"),
        _draw_ir_sdn_f64(line, "affine_c"),
        _draw_ir_sdn_f64(line, "affine_d"),
        _draw_ir_sdn_f64(line, "affine_tx"),
        _draw_ir_sdn_f64(line, "affine_ty")
    )

fn _draw_ir_sdn_parse_raster_policy(line: text, source_schema: text) -> text:
    if source_schema != DRAW_IR_SCHEMA_VERSION_V4:
        return DRAW_IR_RASTER_ALIASED_PIXEL_CENTER
    val policy = _draw_ir_sdn_field(line, "raster_policy")
    if policy != DRAW_IR_RASTER_ALIASED_PIXEL_CENTER and policy != DRAW_IR_RASTER_COVERAGE_AA:
        panic("invalid v4 raster policy")
    policy

fn _draw_ir_sdn_valid_f64_field(line: text, key: text) -> bool:
    val raw = _draw_ir_sdn_field(line, key)
    if not _draw_ir_sdn_decimal_valid(raw):
        return false
    val value = raw.to_f64()
    value == value and value <= 1.0e300 and value >= -1.0e300 and
        (value != 0.0 or not _draw_ir_sdn_decimal_has_nonzero_digit(raw))

fn _draw_ir_sdn_v4_command_error(line: text) -> text:
    val fractional_present = _draw_ir_sdn_field(line, "fractional_present")
    val affine_present = _draw_ir_sdn_field(line, "affine_present")
    val policy = _draw_ir_sdn_field(line, "raster_policy")
    if fractional_present != "true" and fractional_present != "false":
        return "v4 fractional presence field required"
    if affine_present != "true" and affine_present != "false":
        return "v4 affine presence field required"
    if policy != DRAW_IR_RASTER_ALIASED_PIXEL_CENTER and policy != DRAW_IR_RASTER_COVERAGE_AA:
        return "v4 raster policy invalid"
    if affine_present == "true" and fractional_present != "true":
        return "v4 affine command requires fractional local geometry"
    if fractional_present == "true":
        if not _draw_ir_sdn_valid_f64_field(line, "fractional_x") or
                not _draw_ir_sdn_valid_f64_field(line, "fractional_y") or
                not _draw_ir_sdn_valid_f64_field(line, "fractional_width") or
                not _draw_ir_sdn_valid_f64_field(line, "fractional_height"):
            return "v4 fractional geometry invalid"
    elif (_draw_ir_sdn_has_field(line, "fractional_x") or
            _draw_ir_sdn_has_field(line, "fractional_y") or
            _draw_ir_sdn_has_field(line, "fractional_width") or
            _draw_ir_sdn_has_field(line, "fractional_height")):
        return "v4 fractional fields declared without presence"
    if affine_present == "true":
        if not _draw_ir_sdn_valid_f64_field(line, "affine_a") or
                not _draw_ir_sdn_valid_f64_field(line, "affine_b") or
                not _draw_ir_sdn_valid_f64_field(line, "affine_c") or
                not _draw_ir_sdn_valid_f64_field(line, "affine_d") or
                not _draw_ir_sdn_valid_f64_field(line, "affine_tx") or
                not _draw_ir_sdn_valid_f64_field(line, "affine_ty"):
            return "v4 affine matrix invalid"
        val local_width = _draw_ir_sdn_field(line, "fractional_width").to_f64()
        val local_height = _draw_ir_sdn_field(line, "fractional_height").to_f64()
        if local_width <= 0.0 or local_height <= 0.0:
            return "v4 affine local dimensions must be positive"
        val a = _draw_ir_sdn_field(line, "affine_a").to_f64()
        val b = _draw_ir_sdn_field(line, "affine_b").to_f64()
        val c = _draw_ir_sdn_field(line, "affine_c").to_f64()
        val d = _draw_ir_sdn_field(line, "affine_d").to_f64()
        val determinant = a * d - b * c
        if determinant == 0.0 or determinant != determinant or
                determinant > 1.0e300 or determinant < -1.0e300:
            return "v4 affine matrix is singular or non-finite"
    elif (_draw_ir_sdn_has_field(line, "affine_a") or
            _draw_ir_sdn_has_field(line, "affine_b") or
            _draw_ir_sdn_has_field(line, "affine_c") or
            _draw_ir_sdn_has_field(line, "affine_d") or
            _draw_ir_sdn_has_field(line, "affine_tx") or
            _draw_ir_sdn_has_field(line, "affine_ty")):
        return "v4 affine fields declared without presence"
    ""

fn _draw_ir_sdn_legacy_command_error(line: text, source_schema: text) -> text:
    val fractional_present = _draw_ir_sdn_field(line, "fractional_present")
    if source_schema == DRAW_IR_SCHEMA_VERSION_V2:
        if _draw_ir_sdn_has_field(line, "fractional_present") or
                _draw_ir_sdn_has_field(line, "fractional_x") or
                _draw_ir_sdn_has_field(line, "fractional_y") or
                _draw_ir_sdn_has_field(line, "fractional_width") or
                _draw_ir_sdn_has_field(line, "fractional_height"):
            return "v2 fractional fields forbidden"
    else:
        if fractional_present != "true" and fractional_present != "false":
            return "v3 fractional presence field invalid"
        if fractional_present == "true":
            if not _draw_ir_sdn_valid_f64_field(line, "fractional_x") or
                    not _draw_ir_sdn_valid_f64_field(line, "fractional_y") or
                    not _draw_ir_sdn_valid_f64_field(line, "fractional_width") or
                    not _draw_ir_sdn_valid_f64_field(line, "fractional_height"):
                return "v3 fractional geometry invalid"
        elif (_draw_ir_sdn_has_field(line, "fractional_x") or
                _draw_ir_sdn_has_field(line, "fractional_y") or
                _draw_ir_sdn_has_field(line, "fractional_width") or
                _draw_ir_sdn_has_field(line, "fractional_height")):
            return "v3 fractional fields declared without presence"
    if _draw_ir_sdn_has_field(line, "affine_present") or
            _draw_ir_sdn_has_field(line, "affine_a") or
            _draw_ir_sdn_has_field(line, "affine_b") or
            _draw_ir_sdn_has_field(line, "affine_c") or
            _draw_ir_sdn_has_field(line, "affine_d") or
            _draw_ir_sdn_has_field(line, "affine_tx") or
            _draw_ir_sdn_has_field(line, "affine_ty") or
            _draw_ir_sdn_has_field(line, "raster_policy"):
        return "v4 affine/policy fields require v4 schema"
    ""

fn _draw_ir_sdn_emit_rect(line: text, key: text, rect: DrawIrRect) -> text:
    line + " {key}_present={rect.present} {key}_x={rect.x} {key}_y={rect.y} {key}_width={rect.width} {key}_height={rect.height}"

fn _draw_ir_sdn_emit_styles(line: text, key: text, styles: [DrawIrStyleProp]) -> text:
    var parts: [text] = [line, " {key}_count={styles.len()}"]
    var index = 0
    for style in styles:
        parts.push(" {key}_{index}_key={_draw_ir_sdn_escape(style.key)} {key}_{index}_value={_draw_ir_sdn_escape(style.value)}")
        index = index + 1
    parts.join("")

fn _draw_ir_sdn_emit_points(line: text, key: text, points: [DrawIrPoint]) -> text:
    var parts: [text] = [line, " {key}_count={points.len()}"]
    var index = 0
    for point in points:
        parts.push(" {key}_{index}_x={point.x} {key}_{index}_y={point.y}")
        index = index + 1
    parts.join("")

fn _draw_ir_sdn_emit_glyph_run(line: text, glyph_run: DrawIrGlyphRunPayload) -> text:
    val lengths_match = (glyph_run.glyph_ids.len() == glyph_run.xs.len() and
        glyph_run.glyph_ids.len() == glyph_run.ys.len() and
        glyph_run.glyph_ids.len() == glyph_run.clusters.len())
    val count = if glyph_run.valid and lengths_match: glyph_run.glyph_ids.len() else: 0
    var parts: [text] = [line, " glyph_valid={count > 0} glyph_count={count}"]
    var index = 0
    while index < count:
        parts.push(" glyph_{index}_id={glyph_run.glyph_ids[index]} glyph_{index}_x={glyph_run.xs[index]} glyph_{index}_y={glyph_run.ys[index]} glyph_{index}_cluster={glyph_run.clusters[index]}")
        index = index + 1
    parts.join("")

fn _draw_ir_sdn_emit_advances(line: text, advances: [i32]) -> text:
    var parts: [text] = [line, " advance_count={advances.len()}"]
    var index = 0
    for advance in advances:
        parts.push(" advance_{index}={advance}")
        index = index + 1
    parts.join("")

fn _draw_ir_sdn_emit_command(command: DrawIrCommand, schema: text) -> text:
    var parts: [text] = ["\t\tcommand kind={command.kind} id={_draw_ir_sdn_escape(command.component_id)} x={command.x} y={command.y} width={command.width} height={command.height} color={command.color} text={_draw_ir_sdn_escape(command.text_value)} parent_id={_draw_ir_sdn_escape(command.parent_id)} image_uri={_draw_ir_sdn_escape(command.image_uri)}"]
    parts.push(_draw_ir_sdn_emit_rect("", "border", command.border_rect))
    parts.push(_draw_ir_sdn_emit_rect("", "content", command.content_rect))
    parts.push(_draw_ir_sdn_emit_rect("", "hit", command.hit_rect))
    parts.push(_draw_ir_sdn_emit_rect("", "clip", command.clip_rect))
    parts.push(_draw_ir_sdn_emit_styles("", "style", command.computed_style))
    parts.push(_draw_ir_sdn_emit_points("", "point", command.points))
    parts.push(_draw_ir_sdn_emit_advances("", command.advance_widths))
    parts.push(_draw_ir_sdn_emit_glyph_run("", command.glyph_run))
    parts.push(" fractional_present={command.fractional_geometry != nil}")
    if val fractional = command.fractional_geometry:
        parts.push(" fractional_x={fractional.x} fractional_y={fractional.y} fractional_width={fractional.width} fractional_height={fractional.height}")
    if schema == DRAW_IR_SCHEMA_VERSION_V4:
        if command.raster_policy != DRAW_IR_RASTER_ALIASED_PIXEL_CENTER and command.raster_policy != DRAW_IR_RASTER_COVERAGE_AA:
            panic("invalid v4 raster policy")
        if command.affine_transform != nil and command.fractional_geometry == nil:
            panic("v4 affine command requires fractional local geometry")
        parts.push(" affine_present={command.affine_transform != nil}")
        if val affine = command.affine_transform:
            parts.push(" affine_a={affine.a} affine_b={affine.b} affine_c={affine.c} affine_d={affine.d} affine_tx={affine.tx} affine_ty={affine.ty}")
        parts.push(" raster_policy={command.raster_policy}")
    elif command.affine_transform != nil or command.raster_policy != DRAW_IR_RASTER_ALIASED_PIXEL_CENTER:
        panic("v4 affine Draw IR command requires v4 composition")
    parts.push(" edge_present={command.edge != nil}")
    if val edge = command.edge:
        parts.push(" edge_id={_draw_ir_sdn_escape(edge.id)} edge_source={_draw_ir_sdn_escape(edge.source)} edge_target={_draw_ir_sdn_escape(edge.target)} edge_routing={_draw_ir_sdn_escape(edge.routing)}")
        parts.push(_draw_ir_sdn_emit_styles("", "edge_style", edge.style))
        parts.push(_draw_ir_sdn_emit_points("", "edge_point", edge.points))
    val encoded = parts.join("")
    if schema == DRAW_IR_SCHEMA_VERSION_V4:
        val error = _draw_ir_sdn_v4_command_error(encoded)
        if error != "":
            panic("{error}")
    encoded

fn _draw_ir_sdn_emit_batch(batch: DrawIrBatch, schema: text) -> text:
    val command_count = batch.commands.len()
    var lines: [text] = [""; command_count + 1]
    var write_idx = 0
    val header_parts: [text] = [
        "\tbatch id={_draw_ir_sdn_escape(batch.batch_id)} backend={batch.backend_target}",
        " surface={_draw_ir_sdn_escape(batch.embedding.surface_id)} component={_draw_ir_sdn_escape(batch.embedding.component_id)}",
        " x={batch.embedding.x} y={batch.embedding.y} width={batch.embedding.width} height={batch.embedding.height}",
        " layer={batch.embedding.layer} opacity={batch.embedding.opacity_milli} clip={batch.embedding.clip}",
        " source_kind={_draw_ir_sdn_escape(batch.source.source_kind)} source_id={_draw_ir_sdn_escape(batch.source.source_id)}",
        " html_tag={_draw_ir_sdn_escape(batch.source.html_tag)} html_node_id={_draw_ir_sdn_escape(batch.source.html_node_id)}",
        " css_selector={_draw_ir_sdn_escape(batch.source.css_selector)} css_class={_draw_ir_sdn_escape(batch.source.css_class)}",
        " style_key={_draw_ir_sdn_escape(batch.source.style_key)} style_revision={_draw_ir_sdn_escape(batch.source.style_revision)}"
    ]
    lines[write_idx] = header_parts.join("")
    write_idx = write_idx + 1
    for command in batch.commands:
        lines[write_idx] = _draw_ir_sdn_emit_command(command, schema)
        write_idx = write_idx + 1
    lines.join("\n")

fn draw_ir_to_sdn(composition: DrawIrComposition) -> text:
    if composition.schema != DRAW_IR_SCHEMA_VERSION_V2 and
            composition.schema != DRAW_IR_SCHEMA_VERSION and
            composition.schema != DRAW_IR_SCHEMA_VERSION_V4:
        panic("unsupported typed Draw IR schema")
    for batch in composition.batches:
        if batch.schema != composition.schema:
            panic("Draw IR composition/batch schema mismatch")
        if composition.schema == DRAW_IR_SCHEMA_VERSION_V2:
            for command in batch.commands:
                if command.fractional_geometry != nil:
                    panic("v2 Draw IR cannot encode fractional geometry")
    val batch_count = composition.batches.len()
    var lines: [text] = [""; batch_count + 2]
    var write_idx = 0
    # V2/V3 typed inputs still use the established v3 bytes. Explicit v4
    # compositions alone carry affine state and raster policy.
    val output_schema = if composition.schema == DRAW_IR_SCHEMA_VERSION_V4:
        DRAW_IR_SCHEMA_VERSION_V4
    else:
        DRAW_IR_SCHEMA_VERSION
    lines[write_idx] = "draw_ir schema={output_schema}"
    write_idx = write_idx + 1
    lines[write_idx] = "\tcomposition id={_draw_ir_sdn_escape(composition.composition_id)} scene_key={_draw_ir_sdn_escape(composition.scene_key)} backend={composition.backend_target}"
    write_idx = write_idx + 1
    for batch in composition.batches:
        lines[write_idx] = _draw_ir_sdn_emit_batch(batch, output_schema)
        write_idx = write_idx + 1
    lines.join("\n")

fn _draw_ir_sdn_parse_rect(line: text, key: text) -> DrawIrRect:
    DrawIrRect(
        present: _draw_ir_sdn_bool(line, "{key}_present"),
        x: _draw_ir_sdn_i32(line, "{key}_x"),
        y: _draw_ir_sdn_i32(line, "{key}_y"),
        width: _draw_ir_sdn_i32(line, "{key}_width"),
        height: _draw_ir_sdn_i32(line, "{key}_height")
    )

fn _draw_ir_sdn_parse_styles(line: text, key: text) -> [DrawIrStyleProp]:
    val count = _draw_ir_sdn_i32(line, "{key}_count")
    var styles: [DrawIrStyleProp] = []
    val parts = line.split(" ")
    if count <= 0 or count > parts.len().to_i32():
        return styles
    val prefix = "{key}_"
    var pending_key = ""
    var have_key = false
    for part in parts:
        val separator = part.find("=")
        if part.starts_with(prefix) and separator >= 0 and part.substring(0, separator).ends_with("_key"):
            pending_key = _draw_ir_sdn_unescape(part.substring(separator + 1, part.len()))
            have_key = true
        elif have_key and part.starts_with(prefix) and separator >= 0 and part.substring(0, separator).ends_with("_value"):
            styles.push(draw_ir_style_prop(pending_key, _draw_ir_sdn_unescape(part.substring(separator + 1, part.len()))))
            have_key = false
    if styles.len() != count:
        return []
    styles

fn _draw_ir_sdn_parse_points(line: text, key: text) -> [DrawIrPoint]:
    val count = _draw_ir_sdn_i32(line, "{key}_count")
    var points: [DrawIrPoint] = []
    val parts = line.split(" ")
    if count <= 0 or count > parts.len().to_i32():
        return points
    val prefix = "{key}_"
    var pending_x = 0
    var have_x = false
    for part in parts:
        val separator = part.find("=")
        if part.starts_with(prefix) and separator >= 0 and part.substring(0, separator).ends_with("_x"):
            pending_x = _draw_ir_sdn_parse_i32(part.substring(separator + 1, part.len()))
            have_x = true
        elif have_x and part.starts_with(prefix) and separator >= 0 and part.substring(0, separator).ends_with("_y"):
            points.push(draw_ir_point(pending_x, _draw_ir_sdn_parse_i32(part.substring(separator + 1, part.len()))))
            have_x = false
    if points.len() != count:
        return []
    points

fn _draw_ir_sdn_parse_glyph_run(line: text) -> DrawIrGlyphRunPayload:
    if not _draw_ir_sdn_bool(line, "glyph_valid"):
        return draw_ir_empty_glyph_run_payload()
    val count = _draw_ir_sdn_i32(line, "glyph_count")
    if count <= 0 or count > _DRAW_IR_SDN_MAX_GLYPHS:
        return draw_ir_empty_glyph_run_payload()
    var glyph_ids: [u32] = []
    var xs: [i32] = []
    var ys: [i32] = []
    var clusters: [i64] = []
    var index = 0
    var field = 0
    for part in line.split(" "):
        if index >= count:
            break
        val separator = part.find("=")
        if separator <= 0:
            continue
        val key = part.substring(0, separator)
        val value = part.substring(separator + 1, part.len())
        if field == 0 and key == "glyph_{index}_id":
            glyph_ids.push(_draw_ir_sdn_parse_u32(value))
            field = 1
        elif field == 1 and key == "glyph_{index}_x":
            xs.push(_draw_ir_sdn_parse_i32(value))
            field = 2
        elif field == 2 and key == "glyph_{index}_y":
            ys.push(_draw_ir_sdn_parse_i32(value))
            field = 3
        elif field == 3 and key == "glyph_{index}_cluster":
            clusters.push(_draw_ir_sdn_parse_i32(value).to_i64())
            field = 0
            index = index + 1
    if index != count or field != 0:
        return draw_ir_empty_glyph_run_payload()
    draw_ir_glyph_run_payload(glyph_ids, xs, ys, clusters, true)

fn _draw_ir_sdn_parse_advances(line: text) -> [i32]:
    val count = _draw_ir_sdn_i32(line, "advance_count")
    if count <= 0 or count > _DRAW_IR_SDN_MAX_GLYPHS:
        return []
    var advances: [i32] = []
    var index = 0
    for part in line.split(" "):
        if index >= count:
            break
        val separator = part.find("=")
        if separator > 0 and part.substring(0, separator) == "advance_{index}":
            val advance = _draw_ir_sdn_parse_i32(part.substring(separator + 1, part.len()))
            if advance < 0:
                return []
            advances.push(advance)
            index = index + 1
    if index != count:
        return []
    advances

fn _draw_ir_sdn_parse_edge(line: text) -> DrawEdge?:
    val edge_present = _draw_ir_sdn_field(line, "edge_present")
    if edge_present == "true":
        return draw_edge(
            _draw_ir_sdn_field(line, "edge_id"),
            _draw_ir_sdn_field(line, "edge_source"),
            _draw_ir_sdn_field(line, "edge_target"),
            _draw_ir_sdn_field(line, "edge_routing"),
            _draw_ir_sdn_parse_points(line, "edge_point"),
            _draw_ir_sdn_parse_styles(line, "edge_style")
        )
    elif edge_present == "" and _draw_ir_sdn_field(line, "kind") == DRAW_IR_COMMAND_EDGE:
        # Version-2 compatibility for payloads emitted before edge_present.
        return draw_edge(
            _draw_ir_sdn_field(line, "id"),
            _draw_ir_sdn_field(line, "source"),
            _draw_ir_sdn_field(line, "target"),
            _draw_ir_sdn_field(line, "routing"),
            [],
            []
        )
    nil

fn _draw_ir_sdn_parse_command(line: text, source_schema: text) -> DrawIrCommand:
    val affine = _draw_ir_sdn_parse_affine(line, source_schema)
    if affine != nil and _draw_ir_sdn_field(line, "fractional_present") != "true":
        panic("v4 affine command requires fractional local geometry")
    DrawIrCommand(
        kind: _draw_ir_sdn_field(line, "kind"),
        component_id: _draw_ir_sdn_field(line, "id"),
        x: _draw_ir_sdn_i32(line, "x"),
        y: _draw_ir_sdn_i32(line, "y"),
        width: _draw_ir_sdn_i32(line, "width"),
        height: _draw_ir_sdn_i32(line, "height"),
        color: _draw_ir_sdn_u32(line, "color"),
        text_value: _draw_ir_sdn_field(line, "text"),
        advance_widths: _draw_ir_sdn_parse_advances(line),
        border_rect: _draw_ir_sdn_parse_rect(line, "border"),
        content_rect: _draw_ir_sdn_parse_rect(line, "content"),
        hit_rect: _draw_ir_sdn_parse_rect(line, "hit"),
        clip_rect: _draw_ir_sdn_parse_rect(line, "clip"),
        computed_style: _draw_ir_sdn_parse_styles(line, "style"),
        edge: _draw_ir_sdn_parse_edge(line),
        parent_id: _draw_ir_sdn_field(line, "parent_id"),
        image_uri: _draw_ir_sdn_field(line, "image_uri"),
        points: _draw_ir_sdn_parse_points(line, "point"),
        glyph_run: _draw_ir_sdn_parse_glyph_run(line),
        fractional_geometry: _draw_ir_sdn_parse_fractional_geometry(line),
        affine_transform: affine,
        raster_policy: _draw_ir_sdn_parse_raster_policy(line, source_schema)
    )

fn _draw_ir_sdn_parse_source(line: text) -> DrawIrSourceInfo:
    draw_ir_source_info(
        _draw_ir_sdn_field(line, "source_kind"),
        _draw_ir_sdn_field(line, "source_id"),
        _draw_ir_sdn_field(line, "html_tag"),
        _draw_ir_sdn_field(line, "html_node_id"),
        _draw_ir_sdn_field(line, "css_selector"),
        _draw_ir_sdn_field(line, "css_class"),
        _draw_ir_sdn_field(line, "style_key"),
        _draw_ir_sdn_field(line, "style_revision")
    )

fn _draw_ir_sdn_batch_from_state(batch_line: text, commands: [DrawIrCommand], source_schema: text) -> DrawIrBatch:
    val batch = draw_ir_batch_with_source(
        _draw_ir_sdn_field(batch_line, "id"),
        _draw_ir_sdn_field(batch_line, "backend"),
        draw_ir_embedding_config(
            _draw_ir_sdn_field(batch_line, "surface"),
            _draw_ir_sdn_field(batch_line, "component"),
            _draw_ir_sdn_i32(batch_line, "x"),
            _draw_ir_sdn_i32(batch_line, "y"),
            _draw_ir_sdn_i32(batch_line, "width"),
            _draw_ir_sdn_i32(batch_line, "height"),
            _draw_ir_sdn_i32(batch_line, "layer"),
            _draw_ir_sdn_i32(batch_line, "opacity"),
            _draw_ir_sdn_bool(batch_line, "clip")
        ),
        commands,
        _draw_ir_sdn_parse_source(batch_line)
    )
    if source_schema == DRAW_IR_SCHEMA_VERSION_V4:
        return draw_ir_batch_with_source_v4(
            batch.batch_id, batch.backend_target, batch.embedding,
            batch.commands, batch.source)
    batch

fn _draw_ir_sdn_count_batches(lines: [text]) -> i32:
    var count = 0
    for raw_line in lines:
        val line = raw_line.trim()
        if line.starts_with("batch "):
            count = count + 1
    count

fn _draw_ir_sdn_count_commands(lines: [text], start_idx: i32) -> i32:
    var count = 0
    var idx = start_idx
    val line_count = lines.len()
    while idx < line_count:
        val line = lines[idx].trim()
        if line.starts_with("batch "):
            return count
        if line.starts_with("command "):
            count = count + 1
        idx = idx + 1
    count

fn _draw_ir_sdn_parse_commands(lines: [text], start_idx: i32, command_count: i32, source_schema: text) -> [DrawIrCommand]:
    if command_count == 0:
        return []
    var commands: [DrawIrCommand] = [draw_ir_rect("", 0, 0, 0, 0, 0u32); command_count]
    var write_idx = 0
    var idx = start_idx
    val line_count = lines.len()
    while idx < line_count and write_idx < command_count:
        val line = lines[idx].trim()
        if line.starts_with("batch "):
            return commands
        if line.starts_with("command "):
            commands[write_idx] = _draw_ir_sdn_parse_command(line, source_schema)
            write_idx = write_idx + 1
        idx = idx + 1
    commands

fn sdn_to_draw_ir(source: text) -> DrawIrComposition:
    var composition_id = ""
    var scene_key = ""
    var backend_target = ""
    val lines = source.split("\n")
    val source_schema = _draw_ir_sdn_field(lines[0], "schema")
    if source_schema != DRAW_IR_SCHEMA_VERSION and source_schema != DRAW_IR_SCHEMA_VERSION_V2 and source_schema != DRAW_IR_SCHEMA_VERSION_V4:
        panic("unsupported Draw IR SDN schema")
    val batch_count = _draw_ir_sdn_count_batches(lines)
    var batches: [DrawIrBatch] = []
    if batch_count > 0:
        batches = [draw_ir_batch_with_source("", "", draw_ir_embedding_config("", "", 0, 0, 0, 0, 0, 0, false), [], draw_ir_source_info("", "", "", "", "", "", "", "")); batch_count]
    var batch_idx = 0
    var idx = 0
    val line_count = lines.len()
    while idx < line_count:
        val line = lines[idx].trim()
        if line.starts_with("command "):
            val fractional_field = _draw_ir_sdn_field(line, "fractional_present")
            if source_schema != DRAW_IR_SCHEMA_VERSION_V2 and fractional_field == "":
                panic("missing v3 fractional presence field")
            if source_schema == DRAW_IR_SCHEMA_VERSION_V2 and fractional_field != "":
                panic("v2 Draw IR cannot declare fractional geometry")
            if source_schema == DRAW_IR_SCHEMA_VERSION_V4:
                val error = _draw_ir_sdn_v4_command_error(line)
                if error != "":
                    panic("{error}")
        if line.starts_with("composition "):
            composition_id = _draw_ir_sdn_field(line, "id")
            scene_key = _draw_ir_sdn_field(line, "scene_key")
            backend_target = _draw_ir_sdn_field(line, "backend")
        elif line.starts_with("batch "):
            val command_count = _draw_ir_sdn_count_commands(lines, idx + 1)
            val commands = _draw_ir_sdn_parse_commands(lines, idx + 1, command_count, source_schema)
            batches[batch_idx] = _draw_ir_sdn_batch_from_state(line, commands, source_schema)
            batch_idx = batch_idx + 1
        idx = idx + 1
    if source_schema == DRAW_IR_SCHEMA_VERSION_V4:
        return draw_ir_composition_v4(composition_id, scene_key, backend_target, batches)
    draw_ir_composition(composition_id, scene_key, backend_target, batches)

# Validate every accepted schema before constructing a batch so checked callers
# receive Err rather than an inner decoder panic or a partly defaulted value.
pub fn sdn_to_draw_ir_checked(source: text) -> Result<DrawIrComposition, text>:
    if source.trim() == "":
        return Err("empty Draw IR SDN")
    val lines = source.split("\n")
    if lines.len() == 0:
        return Err("Draw IR SDN header required")
    if not lines[0].trim().starts_with("draw_ir "):
        return Err("Draw IR SDN header required")
    val source_schema = _draw_ir_sdn_field(lines[0], "schema")
    if source_schema != DRAW_IR_SCHEMA_VERSION and source_schema != DRAW_IR_SCHEMA_VERSION_V2 and source_schema != DRAW_IR_SCHEMA_VERSION_V4:
        return Err("unsupported Draw IR SDN schema")
    var composition_count = 0
    var batch_count = 0
    var command_index = 0
    for raw_line in lines:
        val line = raw_line.trim()
        if line.starts_with("composition "):
            composition_count = composition_count + 1
            if composition_count != 1 or batch_count != 0:
                return Err("Draw IR composition order invalid")
        elif line.starts_with("batch "):
            if composition_count != 1:
                return Err("Draw IR batch requires composition")
            batch_count = batch_count + 1
        elif line.starts_with("command "):
            if batch_count == 0:
                return Err("Draw IR command requires batch")
            val error = if source_schema == DRAW_IR_SCHEMA_VERSION_V4:
                _draw_ir_sdn_v4_command_error(line)
            else:
                _draw_ir_sdn_legacy_command_error(line, source_schema)
            if error != "":
                return Err("command {command_index}: {error}")
            command_index = command_index + 1
    if composition_count != 1:
        return Err("Draw IR composition required")
    Ok(sdn_to_draw_ir(source))
