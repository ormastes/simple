# SceneDeltaRef (F3 completion, lane T5), per
# `doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md` §2 "F3 —
# UiSceneColumnArenaV2":
#
#   struct SceneDeltaRef:
#       scene_generation: u32
#       changed_table_mask: u32
#       dirty_range_start: u32
#       dirty_range_count: u32
#       damage_start: u32
#       damage_count: u32
#
# This file is the value type + acceptance contract only. Producing a
# `SceneDeltaRef` FROM a live `UiSceneColumnArenaV2` is
# `ui_scene_ports_v3.spl` in this same directory — kept separate so this file
# has no dependency on the arena's internal layout and can be reused by any
# future v2-compatible producer.
#
# Consumers (the Common Render Optimizer, §1 of the redesign plan) must never
# regress to an older generation than the one they already applied — a stale
# apply would silently paint over newer, still-unread pixels/state with older
# ones. `SceneDeltaCursor` below is the one place that refusal is enforced,
# so every consumer gets it for free instead of re-deriving the same
# strictly-monotonic check.

struct SceneDeltaRef:
    scene_generation: u32
    changed_table_mask: u32
    dirty_range_start: u32
    dirty_range_count: u32
    damage_start: u32
    damage_count: u32

# Verdict codes (integers, not enums — see the enum-match divergence bugs
# filed 2026-08-06; same convention as `ui_scene_column_arena_v2.spl`).
val SCENE_DELTA_V2_OK: i64 = 0
val SCENE_DELTA_V2_STALE_GENERATION: i64 = 1

fn scene_delta_ref_make(scene_generation: u32, changed_table_mask: u32,
                        dirty_range_start: u32, dirty_range_count: u32,
                        damage_start: u32, damage_count: u32) -> SceneDeltaRef:
    SceneDeltaRef(
        scene_generation: scene_generation, changed_table_mask: changed_table_mask,
        dirty_range_start: dirty_range_start, dirty_range_count: dirty_range_count,
        damage_start: damage_start, damage_count: damage_count)

# A consumer-side cursor: tracks the last accepted generation and refuses any
# delta that does not strictly advance it. `has_seen` distinguishes "no delta
# accepted yet" from "accepted generation 0" so a legitimate first delta at
# generation 0 is never mistaken for a stale replay.
class SceneDeltaCursor:
    last_seen_generation: u32
    has_seen: bool

    static fn create() -> SceneDeltaCursor:
        SceneDeltaCursor(last_seen_generation: 0, has_seen: false)

    # Accept `delta` if `delta.scene_generation` strictly advances the
    # cursor. On acceptance, updates the cursor and returns
    # SCENE_DELTA_V2_OK. On a stale/equal generation, the cursor is left
    # untouched and SCENE_DELTA_V2_STALE_GENERATION is returned — the
    # typed refusal this unit's acceptance criterion requires.
    me accept(delta: SceneDeltaRef) -> i64:
        if self.has_seen and delta.scene_generation <= self.last_seen_generation:
            return SCENE_DELTA_V2_STALE_GENERATION
        self.last_seen_generation = delta.scene_generation
        self.has_seen = true
        SCENE_DELTA_V2_OK

export SceneDeltaRef, SceneDeltaCursor
export SCENE_DELTA_V2_OK, SCENE_DELTA_V2_STALE_GENERATION
export scene_delta_ref_make
