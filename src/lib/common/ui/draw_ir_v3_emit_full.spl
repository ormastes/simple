    DRAW_IR_V3_FLAG_NONE,
    DRAW_IR_V3_RESOURCE_NONE,
    DRAW_IR_V3_HIT_RECT,
    DRAW_IR_V3_POINTER_POLICY_AUTO,
    DRAW_IR_V3_VERB_MOVE,
    DRAW_IR_V3_PROVENANCE_NONE,
    DrawIrV3Command,
    DrawIrV3Geometry,
    DrawIrV3Paint,
    DrawIrV3TextRun,
    DrawIrV3Glyph,
    DrawIrV3Resource,
    DrawIrV3PathSpan,
    DrawIrV3PathPoint,
    DrawIrV3Clip,
    DrawIrV3Transform,
    DrawIrV3HitShape,
    DrawIrV3Provenance,
    DrawIrV3Scene,
    DrawIrV3GeometryTable,
    DrawIrV3PaintTable,
    DrawIrV3TextRunTable,
    DrawIrV3ResourceTable,
    DrawIrV3PathPointTable,
    DrawIrV3ClipTable,
    DrawIrV3TransformTable,
    DrawIrV3HitShapeTable,
    DrawIrV3SourceProvenanceTable,
    draw_ir_v3_command,
    draw_ir_v3_empty_command,
    draw_ir_v3_empty_scene
}
use common.ui.ui_scene_counts.{
    UiSceneCounts,
    UiSceneRange,
    UiSceneRanges,
    UiSceneCapacityExtensionV1,
    UiSceneOverflowReceipt,
    UI_SCENE_TABLE_COMMANDS,
    UI_SCENE_TABLE_GEOMETRY,
    UI_SCENE_TABLE_PAINT,
    UI_SCENE_TABLE_TEXT_RUNS,
    UI_SCENE_TABLE_GLYPHS,
    UI_SCENE_TABLE_RESOURCES,
    UI_SCENE_TABLE_PATH_SPANS,
    UI_SCENE_TABLE_PATH_POINTS,
    UI_SCENE_TABLE_CLIPS,
    UI_SCENE_TABLE_TRANSFORMS,
    UI_SCENE_TABLE_HIT_SHAPES,
    UI_SCENE_TABLE_PROVENANCE_EDGES,
    UI_SCENE_TABLE_OWNER_RECORDS,
    UI_SCENE_TABLE_ACTION_BINDINGS,
    UI_PRODUCER_GUI,
    ui_scene_counts_zero,
