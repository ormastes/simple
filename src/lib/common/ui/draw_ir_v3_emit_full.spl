use common.ui.ui_scene_prepared2d.{Prepared2DBatch, UI_SCENE_PREPARED2D_FLAG_NONE}

# ===========================================================================
# Request/item vocabulary. One item is one thing the caller wants drawn;
# every item contributes exactly one COMMANDS row plus whichever optional
# side-table rows its `has_*` flags request. Unlike the A-E oracle, hidden
# culling and stroke/fill command splitting are NOT modelled here (out of
# scope for the exact-size table mechanics this lane is about) — every item
# is exactly one command.
# ===========================================================================

struct DrawIrV3FullEmitItem:
    kind: u16
    flags: u16
    component_id: u32          # DRAW_IR_V3_NO_ID => auto-assigned (stable ids)
    component_generation: u32
    parent_id: u32

    has_geometry: bool
    x: i32
    y: i32
    width: i32
    height: i32
    corner_radius: i32

    has_paint: bool
    fill_color: u32
    stroke_color: u32
    stroke_width_milli: i32
    opacity_milli: i32
    blend_mode: u16

    has_text_run: bool
    font_resource_id: u32
    font_size_milli: i32
    baseline_x: i32
    baseline_y: i32
    text_color: u32
    glyph_start: i64            # span into request.glyph_* columns
    glyph_count: i64

    has_resource: bool
    resource_kind: u16
    resource_format: u32
    resource_width: u32
    resource_height: u32
    resource_content_hash: i64

    has_path_span: bool
    fill_rule: u16
    point_start: i64             # span into request.point_* columns
    point_count: i64

    has_clip: bool
    clip_x: i32
    clip_y: i32
    clip_width: i32
    clip_height: i32
    clip_corner_radius: i32
    clip_parent_id: u32

    has_transform: bool
    m11: i32
    m12: i32
    m21: i32
    m22: i32
    dx: i32
    dy: i32

    has_hit_shape: bool
    hit_x: i32
    hit_y: i32
    hit_width: i32
    hit_height: i32
    hit_shape_kind: u16
    hit_flags: u16
    hit_z_index: i32
    hit_enabled: bool
    hit_pointer_policy: u16

    has_provenance: bool
    provenance_edge_kind: u16
    provenance_source_node_id: u32
    provenance_source_rule_id: u32
    provenance_source_span_start: u32
    provenance_source_span_len: u32

    # Every item gets exactly one OWNER_RECORDS row (unconditional).
    owner_producer_kind: u16
    owner_event_policy: u16
    owner_parent_owner_id: u32

    has_action_binding: bool
    action_app_id: u32
    action_app_generation: u32
    action_menu_revision: u32
    action_id: u32
    action_default_target_owner_id: u32

struct DrawIrV3FullEmitRequest:
    items: [DrawIrV3FullEmitItem]
    glyph_ids: [u32]
    glyph_xs: [i32]
    glyph_ys: [i32]
    glyph_clusters: [i64]
    point_xs: [i32]
    point_ys: [i32]
    point_verbs: [u16]
    first_component_id: u32

fn draw_ir_v3_full_item_blank() -> DrawIrV3FullEmitItem:
    DrawIrV3FullEmitItem(
        kind: DRAW_IR_V3_KIND_NONE, flags: DRAW_IR_V3_FLAG_NONE,
        component_id: DRAW_IR_V3_NO_ID, component_generation: 0u32, parent_id: DRAW_IR_V3_NO_ID,
        has_geometry: false, x: 0, y: 0, width: 0, height: 0, corner_radius: 0,
        has_paint: false, fill_color: 0u32, stroke_color: 0u32, stroke_width_milli: 0,
        opacity_milli: 1000, blend_mode: 0u16,
        has_text_run: false, font_resource_id: DRAW_IR_V3_NO_ID, font_size_milli: 0,
        baseline_x: 0, baseline_y: 0, text_color: 0u32, glyph_start: 0, glyph_count: 0,
        has_resource: false, resource_kind: DRAW_IR_V3_RESOURCE_NONE, resource_format: 0u32,
        resource_width: 0u32, resource_height: 0u32, resource_content_hash: 0,
        has_path_span: false, fill_rule: 0u16, point_start: 0, point_count: 0,
        has_clip: false, clip_x: 0, clip_y: 0, clip_width: 0, clip_height: 0,
        clip_corner_radius: 0, clip_parent_id: DRAW_IR_V3_NO_ID,
        has_transform: false, m11: 1000, m12: 0, m21: 0, m22: 1000, dx: 0, dy: 0,
        has_hit_shape: false, hit_x: 0, hit_y: 0, hit_width: 0, hit_height: 0,
        hit_shape_kind: DRAW_IR_V3_HIT_RECT, hit_flags: 0u16,
        hit_z_index: 0, hit_enabled: true, hit_pointer_policy: DRAW_IR_V3_POINTER_POLICY_AUTO,
        has_provenance: false, provenance_edge_kind: DRAW_IR_V3_PROVENANCE_NONE,
        provenance_source_node_id: DRAW_IR_V3_NO_ID, provenance_source_rule_id: DRAW_IR_V3_NO_ID,
        provenance_source_span_start: 0u32, provenance_source_span_len: 0u32,
        owner_producer_kind: UI_PRODUCER_GUI, owner_event_policy: 0u16,
        owner_parent_owner_id: DRAW_IR_V3_NO_ID,
        has_action_binding: false, action_app_id: 0u32, action_app_generation: 0u32,
        action_menu_revision: 0u32, action_id: 0u32, action_default_target_owner_id: DRAW_IR_V3_NO_ID
    )

fn draw_ir_v3_full_request_blank() -> DrawIrV3FullEmitRequest:
    DrawIrV3FullEmitRequest(
        items: [], glyph_ids: [], glyph_xs: [], glyph_ys: [], glyph_clusters: [],
        point_xs: [], point_ys: [], point_verbs: [], first_component_id: 0u32
    )

# ===========================================================================
# Stable component-id allocation: an item with an explicit `component_id`
# keeps it (stable across regenerations); an item left at the
# `DRAW_IR_V3_NO_ID` sentinel is assigned the next id from
# `request.first_component_id`, sequentially, deterministically.
# ===========================================================================

fn draw_ir_v3_full_assign_component_ids(request: DrawIrV3FullEmitRequest) -> DrawIrV3FullEmitRequest:
    var items = request.items
    var next_id = request.first_component_id
    var i = 0
    while i < items.len():
        var item = items[i]
        if item.component_id == DRAW_IR_V3_NO_ID:
            item.component_id = next_id
            next_id = next_id + 1u32
        items[i] = item
        i = i + 1
    DrawIrV3FullEmitRequest(
        items: items, glyph_ids: request.glyph_ids, glyph_xs: request.glyph_xs,
        glyph_ys: request.glyph_ys, glyph_clusters: request.glyph_clusters,
        point_xs: request.point_xs, point_ys: request.point_ys, point_verbs: request.point_verbs,
        first_component_id: request.first_component_id
    )

# ===========================================================================
# COUNT (design §5, Pass A): exact required rows per table, pure and
# repeatable. PREPARED_BATCHES and DIRTY_RANGES are derived tables (design
# §2.5: "construction is a pure function of scene + capability key") — this
# lane uses the simplest deterministic rule that is predictable at COUNT
# time and exactly reproducible at EMIT time from the finished scene alone:
# one Prepared2DBatch and one DirtyRange row covering the whole generation
# when it has at least one command, zero rows for an empty generation.
# ===========================================================================

fn draw_ir_v3_emit_full_count(request: DrawIrV3FullEmitRequest) -> UiSceneCounts:
    val items = request.items
    var commands = 0u32
    var geometry = 0u32
    var paint = 0u32
    var text_runs = 0u32
    var glyphs = 0u32
    var resources = 0u32
    var path_spans = 0u32
    var path_points = 0u32
    var clips = 0u32
    var transforms = 0u32
    var hit_shapes = 0u32
    var provenance_edges = 0u32
    var owner_records = 0u32
    var action_bindings = 0u32

    var i = 0
    while i < items.len():
        val item = items[i]
        commands = commands + 1u32
        if item.has_geometry:
            geometry = geometry + 1u32
        if item.has_paint:
            paint = paint + 1u32
        if item.has_text_run:
            text_runs = text_runs + 1u32
            glyphs = glyphs + (item.glyph_count as u32)
        if item.has_resource:
            resources = resources + 1u32
        if item.has_path_span:
            path_spans = path_spans + 1u32
            path_points = path_points + (item.point_count as u32)
        if item.has_clip:
            clips = clips + 1u32
        if item.has_transform:
            transforms = transforms + 1u32
        if item.has_hit_shape:
            hit_shapes = hit_shapes + 1u32
        if item.has_provenance:
            provenance_edges = provenance_edges + 1u32
        owner_records = owner_records + 1u32
        if item.has_action_binding:
            action_bindings = action_bindings + 1u32
        i = i + 1

    val prepared_batches = if commands > 0u32: 1u32 else: 0u32
    val dirty_ranges = if commands > 0u32: 1u32 else: 0u32

    UiSceneCounts(
        commands: commands, geometry: geometry, paint: paint, text_runs: text_runs,
        glyphs: glyphs, resources: resources, path_spans: path_spans, path_points: path_points,
        clips: clips, transforms: transforms, hit_shapes: hit_shapes,
        provenance_edges: provenance_edges, owner_records: owner_records,
        action_bindings: action_bindings, prepared_batches: prepared_batches,
        dirty_ranges: dirty_ranges
    )

# ===========================================================================
# Bounds-checked cursor writer over tables 0-11 (design §2.3). Backing
# storage is the accessor VIEW row type per table (array-of-structs) — the
# frozen `draw_ir_v3.spl` struct-of-arrays tables are assembled from these
# once, in `to_scene()`, never touched per-row. `written` reuses
# `UiSceneCounts`' per-table u32 shape as the absolute next-write index;
# `reserved` is this writer's pre-assigned `UiSceneRanges` window. A `put_*`
# past the physical array length returns false; `finish()` compares the
# relative written count (`cursor(t) = written[t] - reserved[t].start`)
# against `reserved[t].count` for every table, in table-id order, and
# returns the FIRST Deficit or Surplus found — Exact only when every table
# matches exactly (design §2.3: under-emission is as fatal as overflow).
# ===========================================================================

class DrawIrV3FullWriter:
    reserved: UiSceneRanges
    written: UiSceneCounts
    commands: [DrawIrV3Command]
    geometry: [DrawIrV3Geometry]
    paint: [DrawIrV3Paint]
    text_runs: [DrawIrV3TextRun]
    glyphs: [DrawIrV3Glyph]
    resources: [DrawIrV3Resource]
    path_spans: [DrawIrV3PathSpan]
    path_points: [DrawIrV3PathPoint]
    clips: [DrawIrV3Clip]
    transforms: [DrawIrV3Transform]
    hit_shapes: [DrawIrV3HitShape]
    provenance: [DrawIrV3Provenance]

    fn to_scene(scene_id: u32, generation: u32) -> DrawIrV3Scene:
        DrawIrV3Scene(
            schema: DRAW_IR_V3_SCHEMA_VERSION, schema_id: DRAW_IR_V3_SCHEMA_ID,
            scene_id: scene_id, generation: generation,
            commands: self.commands,
            geometry: _full_geometry_table_of(self.geometry),
            paint: _full_paint_table_of(self.paint),
            text_runs: _full_text_run_table_of(self.text_runs, self.glyphs),
            resources: _full_resource_table_of(self.resources),
            path_points: _full_path_point_table_of(self.path_spans, self.path_points),
            clips: _full_clip_table_of(self.clips),
            transforms: _full_transform_table_of(self.transforms),
            hit_shapes: _full_hit_shape_table_of(self.hit_shapes),
            provenance: _full_provenance_table_of(self.provenance)
        )

impl DrawIrV3Writer for DrawIrV3FullWriter:
    me put_command(row: DrawIrV3Command) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_COMMANDS)
        if idx >= self.commands.len().to_u32():
            return false
        self.commands[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_COMMANDS, idx + 1u32)
        true

    me put_geometry(row: DrawIrV3Geometry) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_GEOMETRY)
        if idx >= self.geometry.len().to_u32():
            return false
        self.geometry[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_GEOMETRY, idx + 1u32)
        true

    me put_paint(row: DrawIrV3Paint) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_PAINT)
        if idx >= self.paint.len().to_u32():
            return false
        self.paint[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_PAINT, idx + 1u32)
        true

    me put_text_run(row: DrawIrV3TextRun) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_TEXT_RUNS)
        if idx >= self.text_runs.len().to_u32():
            return false
        self.text_runs[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_TEXT_RUNS, idx + 1u32)
        true

    me put_glyph(row: DrawIrV3Glyph) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_GLYPHS)
        if idx >= self.glyphs.len().to_u32():
            return false
        self.glyphs[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_GLYPHS, idx + 1u32)
        true

    me put_resource(row: DrawIrV3Resource) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_RESOURCES)
        if idx >= self.resources.len().to_u32():
            return false
        self.resources[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_RESOURCES, idx + 1u32)
        true

    me put_path_span(row: DrawIrV3PathSpan) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_PATH_SPANS)
        if idx >= self.path_spans.len().to_u32():
            return false
        self.path_spans[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_PATH_SPANS, idx + 1u32)
        true

    me put_path_point(row: DrawIrV3PathPoint) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_PATH_POINTS)
        if idx >= self.path_points.len().to_u32():
            return false
        self.path_points[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_PATH_POINTS, idx + 1u32)
        true

    me put_clip(row: DrawIrV3Clip) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_CLIPS)
        if idx >= self.clips.len().to_u32():
            return false
        self.clips[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_CLIPS, idx + 1u32)
        true

    me put_transform(row: DrawIrV3Transform) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_TRANSFORMS)
        if idx >= self.transforms.len().to_u32():
            return false
        self.transforms[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_TRANSFORMS, idx + 1u32)
        true

    me put_hit_shape(row: DrawIrV3HitShape) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_HIT_SHAPES)
        if idx >= self.hit_shapes.len().to_u32():
            return false
        self.hit_shapes[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_HIT_SHAPES, idx + 1u32)
        true

    me put_provenance(row: DrawIrV3Provenance) -> bool:
        val idx = ui_scene_counts_at(self.written, UI_SCENE_TABLE_PROVENANCE_EDGES)
        if idx >= self.provenance.len().to_u32():
            return false
        self.provenance[idx.to_i64()] = row
        self.written = ui_scene_counts_set(self.written, UI_SCENE_TABLE_PROVENANCE_EDGES, idx + 1u32)
        true

    me cursor(table_id: u16) -> u32:
        val start = ui_scene_ranges_at(self.reserved, table_id).start
        val w = ui_scene_counts_at(self.written, table_id)
        w - start

    me finish() -> UiSceneWriteVerdict:
        val ids = [
            UI_SCENE_TABLE_COMMANDS, UI_SCENE_TABLE_GEOMETRY, UI_SCENE_TABLE_PAINT,
            UI_SCENE_TABLE_TEXT_RUNS, UI_SCENE_TABLE_GLYPHS, UI_SCENE_TABLE_RESOURCES,
            UI_SCENE_TABLE_PATH_SPANS, UI_SCENE_TABLE_PATH_POINTS, UI_SCENE_TABLE_CLIPS,
            UI_SCENE_TABLE_TRANSFORMS, UI_SCENE_TABLE_HIT_SHAPES, UI_SCENE_TABLE_PROVENANCE_EDGES
        ]
        var i = 0
        while i < ids.len():
            val t = ids[i]
            val reserved_count = ui_scene_ranges_at(self.reserved, t).count
            val written_count = self.cursor(t)
            if written_count < reserved_count:
                return UiSceneWriteVerdict.Deficit(table_id: t, n: reserved_count - written_count)
            if written_count > reserved_count:
                return UiSceneWriteVerdict.Surplus(table_id: t, n: written_count - reserved_count)
            i = i + 1
        UiSceneWriteVerdict.Exact

fn _full_fill_commands(n: u32) -> [DrawIrV3Command]:
    var out: [DrawIrV3Command] = []
    var i = 0u32
    while i < n:
        out.push(draw_ir_v3_empty_command())
        i = i + 1u32
    out

fn _full_fill_geometry(n: u32) -> [DrawIrV3Geometry]:
    var out: [DrawIrV3Geometry] = []
    val blank = DrawIrV3Geometry(present: false, x: 0, y: 0, width: 0, height: 0, corner_radius: 0)
    var i = 0u32
    while i < n:
        out.push(blank)
        i = i + 1u32
    out

fn _full_fill_paint(n: u32) -> [DrawIrV3Paint]:
    var out: [DrawIrV3Paint] = []
    val blank = DrawIrV3Paint(
        present: false, fill_color: 0u32, stroke_color: 0u32,
        stroke_width_milli: 0, opacity_milli: 0, blend_mode: 0u16
    )
    var i = 0u32
    while i < n:
        out.push(blank)
        i = i + 1u32
    out

fn _full_fill_text_run(n: u32) -> [DrawIrV3TextRun]:
    var out: [DrawIrV3TextRun] = []
    val blank = DrawIrV3TextRun(
        present: false, glyph_start: DRAW_IR_V3_NO_ID, glyph_count: 0u32,
        font_resource_id: DRAW_IR_V3_NO_ID, font_size_milli: 0,
        baseline_x: 0, baseline_y: 0, color: 0u32
    )
    var i = 0u32
    while i < n:
        out.push(blank)
        i = i + 1u32
    out

fn _full_fill_glyph(n: u32) -> [DrawIrV3Glyph]:
    var out: [DrawIrV3Glyph] = []
    val blank = DrawIrV3Glyph(present: false, glyph_id: 0u32, x: 0, y: 0, cluster: 0)
    var i = 0u32
    while i < n:
        out.push(blank)
        i = i + 1u32
    out

fn _full_fill_resource(n: u32) -> [DrawIrV3Resource]:
    var out: [DrawIrV3Resource] = []
    val blank = DrawIrV3Resource(
        present: false, kind: DRAW_IR_V3_RESOURCE_NONE, format: 0u32,
        width: 0u32, height: 0u32, content_hash: 0
    )
    var i = 0u32
    while i < n:
        out.push(blank)
        i = i + 1u32
    out

fn _full_fill_path_span(n: u32) -> [DrawIrV3PathSpan]:
    var out: [DrawIrV3PathSpan] = []
    val blank = DrawIrV3PathSpan(present: false, point_start: DRAW_IR_V3_NO_ID, point_count: 0u32, fill_rule: 0u16)
    var i = 0u32
    while i < n:
        out.push(blank)
        i = i + 1u32
    out

fn _full_fill_path_point(n: u32) -> [DrawIrV3PathPoint]:
    var out: [DrawIrV3PathPoint] = []
    val blank = DrawIrV3PathPoint(present: false, x: 0, y: 0, verb: DRAW_IR_V3_VERB_MOVE)
    var i = 0u32
    while i < n:
        out.push(blank)
        i = i + 1u32
    out

fn _full_fill_clip(n: u32) -> [DrawIrV3Clip]:
    var out: [DrawIrV3Clip] = []
    val blank = DrawIrV3Clip(
        present: false, x: 0, y: 0, width: 0, height: 0,
        corner_radius: 0, parent_id: DRAW_IR_V3_NO_ID
    )
    var i = 0u32
    while i < n:
        out.push(blank)
        i = i + 1u32
    out

fn _full_fill_transform(n: u32) -> [DrawIrV3Transform]:
    var out: [DrawIrV3Transform] = []
    val blank = DrawIrV3Transform(present: false, m11: 1000, m12: 0, m21: 0, m22: 1000, dx: 0, dy: 0)
    var i = 0u32
    while i < n:
        out.push(blank)
        i = i + 1u32
    out

fn _full_fill_hit_shape(n: u32) -> [DrawIrV3HitShape]:
    var out: [DrawIrV3HitShape] = []
    val blank = DrawIrV3HitShape(
        present: false, x: 0, y: 0, width: 0, height: 0,
        shape_kind: DRAW_IR_V3_HIT_RECT, hit_flags: 0u16, component_id: 0u32,
        z_index: 0, enabled: true, pointer_policy: DRAW_IR_V3_POINTER_POLICY_AUTO
    )
    var i = 0u32
    while i < n:
        out.push(blank)
        i = i + 1u32
    out

fn _full_fill_provenance(n: u32) -> [DrawIrV3Provenance]:
    var out: [DrawIrV3Provenance] = []
    val blank = DrawIrV3Provenance(
        present: false, command_index: DRAW_IR_V3_NO_ID, edge_kind: DRAW_IR_V3_PROVENANCE_NONE,
        source_node_id: DRAW_IR_V3_NO_ID, source_rule_id: DRAW_IR_V3_NO_ID,
        source_span_start: 0u32, source_span_len: 0u32
    )
    var i = 0u32
    while i < n:
        out.push(blank)
        i = i + 1u32
    out

# --- AoS -> frozen SoA table conversion (used only by `to_scene()`) --------

fn _full_geometry_table_of(rows: [DrawIrV3Geometry]) -> DrawIrV3GeometryTable:
    var xs: [i32] = []
    var ys: [i32] = []
    var widths: [i32] = []
    var heights: [i32] = []
    var radii: [i32] = []
    var i = 0
    while i < rows.len():
        val r = rows[i]
        xs.push(r.x)
        ys.push(r.y)
        widths.push(r.width)
        heights.push(r.height)
        radii.push(r.corner_radius)
        i = i + 1
    DrawIrV3GeometryTable(xs: xs, ys: ys, widths: widths, heights: heights, corner_radii: radii)

fn _full_paint_table_of(rows: [DrawIrV3Paint]) -> DrawIrV3PaintTable:
    var fills: [u32] = []
    var strokes: [u32] = []
    var widths: [i32] = []
    var opacities: [i32] = []
    var blends: [u16] = []
    var i = 0
    while i < rows.len():
        val r = rows[i]
        fills.push(r.fill_color)
        strokes.push(r.stroke_color)
        widths.push(r.stroke_width_milli)
        opacities.push(r.opacity_milli)
        blends.push(r.blend_mode)
        i = i + 1
    DrawIrV3PaintTable(
        fill_colors: fills, stroke_colors: strokes, stroke_widths_milli: widths,
        opacities_milli: opacities, blend_modes: blends
    )

fn _full_text_run_table_of(runs: [DrawIrV3TextRun], glyphs: [DrawIrV3Glyph]) -> DrawIrV3TextRunTable:
    var starts: [u32] = []
    var counts: [u32] = []
    var fonts: [u32] = []
    var sizes: [i32] = []
    var bxs: [i32] = []
    var bys: [i32] = []
    var colors: [u32] = []
    var i = 0
    while i < runs.len():
        val r = runs[i]
        starts.push(r.glyph_start)
        counts.push(r.glyph_count)
        fonts.push(r.font_resource_id)
        sizes.push(r.font_size_milli)
        bxs.push(r.baseline_x)
        bys.push(r.baseline_y)
        colors.push(r.color)
        i = i + 1
    var gids: [u32] = []
    var gxs: [i32] = []
    var gys: [i32] = []
    var gcl: [i64] = []
    var j = 0
    while j < glyphs.len():
        val g = glyphs[j]
        gids.push(g.glyph_id)
        gxs.push(g.x)
        gys.push(g.y)
        gcl.push(g.cluster)
        j = j + 1
    DrawIrV3TextRunTable(
        run_glyph_starts: starts, run_glyph_counts: counts, run_font_resource_ids: fonts,
        run_font_sizes_milli: sizes, run_baseline_xs: bxs, run_baseline_ys: bys, run_colors: colors,
        glyph_ids: gids, glyph_xs: gxs, glyph_ys: gys, glyph_clusters: gcl
    )

fn _full_resource_table_of(rows: [DrawIrV3Resource]) -> DrawIrV3ResourceTable:
    var kinds: [u16] = []
    var formats: [u32] = []
    var widths: [u32] = []
    var heights: [u32] = []
    var hashes: [i64] = []
    var i = 0
    while i < rows.len():
        val r = rows[i]
        kinds.push(r.kind)
        formats.push(r.format)
        widths.push(r.width)
        heights.push(r.height)
        hashes.push(r.content_hash)
        i = i + 1
    DrawIrV3ResourceTable(kinds: kinds, formats: formats, widths: widths, heights: heights, content_hashes: hashes)

fn _full_path_point_table_of(spans: [DrawIrV3PathSpan], points: [DrawIrV3PathPoint]) -> DrawIrV3PathPointTable:
    var starts: [u32] = []
    var counts: [u32] = []
    var rules: [u16] = []
    var i = 0
    while i < spans.len():
        val s = spans[i]
        starts.push(s.point_start)
        counts.push(s.point_count)
        rules.push(s.fill_rule)
        i = i + 1
    var xs: [i32] = []
    var ys: [i32] = []
    var verbs: [u16] = []
    var j = 0
    while j < points.len():
        val p = points[j]
        xs.push(p.x)
        ys.push(p.y)
        verbs.push(p.verb)
        j = j + 1
    DrawIrV3PathPointTable(
        span_point_starts: starts, span_point_counts: counts, span_fill_rules: rules,
        point_xs: xs, point_ys: ys, point_verbs: verbs
    )

fn _full_clip_table_of(rows: [DrawIrV3Clip]) -> DrawIrV3ClipTable:
    var xs: [i32] = []
    var ys: [i32] = []
    var widths: [i32] = []
    var heights: [i32] = []
    var radii: [i32] = []
    var parents: [u32] = []
    var i = 0
    while i < rows.len():
        val r = rows[i]
        xs.push(r.x)
        ys.push(r.y)
        widths.push(r.width)
        heights.push(r.height)
        radii.push(r.corner_radius)
        parents.push(r.parent_id)
        i = i + 1
    DrawIrV3ClipTable(xs: xs, ys: ys, widths: widths, heights: heights, corner_radii: radii, parent_ids: parents)

fn _full_transform_table_of(rows: [DrawIrV3Transform]) -> DrawIrV3TransformTable:
    var m11s: [i32] = []
    var m12s: [i32] = []
    var m21s: [i32] = []
    var m22s: [i32] = []
    var dxs: [i32] = []
    var dys: [i32] = []
    var i = 0
    while i < rows.len():
        val r = rows[i]
        m11s.push(r.m11)
        m12s.push(r.m12)
        m21s.push(r.m21)
        m22s.push(r.m22)
        dxs.push(r.dx)
        dys.push(r.dy)
        i = i + 1
    DrawIrV3TransformTable(m11s: m11s, m12s: m12s, m21s: m21s, m22s: m22s, dxs: dxs, dys: dys)

fn _full_hit_shape_table_of(rows: [DrawIrV3HitShape]) -> DrawIrV3HitShapeTable:
    var xs: [i32] = []
    var ys: [i32] = []
    var widths: [i32] = []
    var heights: [i32] = []
    var kinds: [u16] = []
    var flags: [u16] = []
    var components: [u32] = []
    var z_indices: [i32] = []
    var enableds: [bool] = []
    var pointer_policies: [u16] = []
    var i = 0
    while i < rows.len():
        val r = rows[i]
        xs.push(r.x)
        ys.push(r.y)
        widths.push(r.width)
        heights.push(r.height)
        kinds.push(r.shape_kind)
        flags.push(r.hit_flags)
        components.push(r.component_id)
        z_indices.push(r.z_index)
        enableds.push(r.enabled)
        pointer_policies.push(r.pointer_policy)
        i = i + 1
    DrawIrV3HitShapeTable(
        xs: xs, ys: ys, widths: widths, heights: heights,
        shape_kinds: kinds, hit_flags: flags, component_ids: components,
        z_indices: z_indices, enableds: enableds, pointer_policies: pointer_policies
    )

fn _full_provenance_table_of(rows: [DrawIrV3Provenance]) -> DrawIrV3SourceProvenanceTable:
    var cmds: [u32] = []
    var kinds: [u16] = []
    var nodes: [u32] = []
    var rules: [u32] = []
    var starts: [u32] = []
    var lens: [u32] = []
    var i = 0
    while i < rows.len():
        val r = rows[i]
        cmds.push(r.command_index)
        kinds.push(r.edge_kind)
        nodes.push(r.source_node_id)
        rules.push(r.source_rule_id)
        starts.push(r.source_span_start)
        lens.push(r.source_span_len)
        i = i + 1
    DrawIrV3SourceProvenanceTable(
        command_indices: cmds, edge_kinds: kinds, source_node_ids: nodes,
        source_rule_ids: rules, source_span_starts: starts, source_span_lens: lens
    )

fn draw_ir_v3_full_writer_create(physical: UiSceneCounts, reserved: UiSceneRanges) -> DrawIrV3FullWriter:
    var written = ui_scene_counts_zero()
    for t in 0..12:
        val tid = t as u16
        written = ui_scene_counts_set(written, tid, ui_scene_ranges_at(reserved, tid).start)

    DrawIrV3FullWriter(
        reserved: reserved, written: written,
        commands: _full_fill_commands(physical.commands),
        geometry: _full_fill_geometry(physical.geometry),
        paint: _full_fill_paint(physical.paint),
        text_runs: _full_fill_text_run(physical.text_runs),
        glyphs: _full_fill_glyph(physical.glyphs),
        resources: _full_fill_resource(physical.resources),
        path_spans: _full_fill_path_span(physical.path_spans),
        path_points: _full_fill_path_point(physical.path_points),
        clips: _full_fill_clip(physical.clips),
        transforms: _full_fill_transform(physical.transforms),
        hit_shapes: _full_fill_hit_shape(physical.hit_shapes),
        provenance: _full_fill_provenance(physical.provenance_edges)
    )

# ===========================================================================
# OWNER_RECORDS (table 12) / ACTION_BINDINGS (table 13) writers — same
# bounds-checked cursor + Deficit/Surplus contract as `DrawIrV3FullWriter`,
# one table each.
# ===========================================================================

class UiOwnerRecordWriter:
    reserved: UiSceneRange
    written: u32
    rows: [UiOwnerRecord]

    fn to_list() -> [UiOwnerRecord]:
        self.rows

impl UiOwnerWriter for UiOwnerRecordWriter:
    me put_owner_record(row: UiOwnerRecord) -> bool:
        if self.written >= self.rows.len().to_u32():
            return false
        self.rows[self.written.to_i64()] = row
        self.written = self.written + 1u32
        true

    me cursor() -> u32:
        self.written - self.reserved.start

    me finish() -> UiSceneWriteVerdict:
        val w = self.cursor()
        if w < self.reserved.count:
            return UiSceneWriteVerdict.Deficit(table_id: UI_SCENE_TABLE_OWNER_RECORDS, n: self.reserved.count - w)
        if w > self.reserved.count:
            return UiSceneWriteVerdict.Surplus(table_id: UI_SCENE_TABLE_OWNER_RECORDS, n: w - self.reserved.count)
        UiSceneWriteVerdict.Exact

fn ui_owner_record_writer_create(physical: u32, reserved: UiSceneRange) -> UiOwnerRecordWriter:
    var rows: [UiOwnerRecord] = []
    val blank = UiOwnerRecord(
        producer_kind: 0u16, event_policy: 0u16, semantic_id: 0u32,
        semantic_generation: 0u32, parent_owner_id: DRAW_IR_V3_NO_ID,
        action_binding_id: DRAW_IR_V3_NO_ID
    )
    var i = 0u32
    while i < physical:
        rows.push(blank)
        i = i + 1u32
    UiOwnerRecordWriter(reserved: reserved, written: reserved.start, rows: rows)

class UiActionBindingWriter:
    reserved: UiSceneRange
    written: u32
    rows: [MenuActionBinding]

    fn to_list() -> [MenuActionBinding]:
        self.rows

impl UiActionWriter for UiActionBindingWriter:
    me put_action_binding(row: MenuActionBinding) -> bool:
        if self.written >= self.rows.len().to_u32():
            return false
        self.rows[self.written.to_i64()] = row
        self.written = self.written + 1u32
        true

    me cursor() -> u32:
        self.written - self.reserved.start

    me finish() -> UiSceneWriteVerdict:
        val w = self.cursor()
        if w < self.reserved.count:
            return UiSceneWriteVerdict.Deficit(table_id: UI_SCENE_TABLE_ACTION_BINDINGS, n: self.reserved.count - w)
        if w > self.reserved.count:
            return UiSceneWriteVerdict.Surplus(table_id: UI_SCENE_TABLE_ACTION_BINDINGS, n: w - self.reserved.count)
        UiSceneWriteVerdict.Exact

fn ui_action_binding_writer_create(physical: u32, reserved: UiSceneRange) -> UiActionBindingWriter:
    var rows: [MenuActionBinding] = []
    val blank = MenuActionBinding(
        app_id: 0u32, app_generation: 0u32, menu_revision: 0u32,
        action_id: 0u32, default_target_owner_id: DRAW_IR_V3_NO_ID
    )
    var i = 0u32
    while i < physical:
        rows.push(blank)
        i = i + 1u32
    UiActionBindingWriter(reserved: reserved, written: reserved.start, rows: rows)

fn draw_ir_v3_verdict_is_exact(v: UiSceneWriteVerdict) -> bool:
    match v:
        case UiSceneWriteVerdict.Exact:
            true
        case UiSceneWriteVerdict.Deficit(table_id, n):
            false
        case UiSceneWriteVerdict.Surplus(table_id, n):
            false

# ===========================================================================
# EMIT (design §5, Pass D): write every item's rows into the pre-reserved
# ranges. Row ids are computed as `ranges.<table>.start + writer.cursor(t)`
# read immediately BEFORE the corresponding `put_*` call — the writer's own
# cursor advances in lockstep with sequential item-order writes, so this is
# exactly the same offset the L1 scan already assigned. Returns false on the
# first `put_*` refusal (defensive; capacity was already verified against
# these exact counts by the caller, so this should not trigger in practice).
# ===========================================================================

fn draw_ir_v3_emit_full_write_items(
    request: DrawIrV3FullEmitRequest, ranges: UiSceneRanges,
    draw: DrawIrV3FullWriter, owners: UiOwnerRecordWriter, actions: UiActionBindingWriter
) -> bool:
    val items = request.items
    var i = 0
    while i < items.len():
        val item = items[i]

        val geometry_id = if item.has_geometry: (ranges.geometry.start + draw.cursor(UI_SCENE_TABLE_GEOMETRY)) else: DRAW_IR_V3_NO_ID
        val paint_id = if item.has_paint: (ranges.paint.start + draw.cursor(UI_SCENE_TABLE_PAINT)) else: DRAW_IR_V3_NO_ID
        val text_run_id = if item.has_text_run: (ranges.text_runs.start + draw.cursor(UI_SCENE_TABLE_TEXT_RUNS)) else: DRAW_IR_V3_NO_ID
        val image_resource_id = if item.has_resource: (ranges.resources.start + draw.cursor(UI_SCENE_TABLE_RESOURCES)) else: DRAW_IR_V3_NO_ID
        val path_span_id = if item.has_path_span: (ranges.path_spans.start + draw.cursor(UI_SCENE_TABLE_PATH_SPANS)) else: DRAW_IR_V3_NO_ID
        val clip_id = if item.has_clip: (ranges.clips.start + draw.cursor(UI_SCENE_TABLE_CLIPS)) else: DRAW_IR_V3_NO_ID
        val transform_id = if item.has_transform: (ranges.transforms.start + draw.cursor(UI_SCENE_TABLE_TRANSFORMS)) else: DRAW_IR_V3_NO_ID
        val hit_shape_id = if item.has_hit_shape: (ranges.hit_shapes.start + draw.cursor(UI_SCENE_TABLE_HIT_SHAPES)) else: DRAW_IR_V3_NO_ID
        val command_id = ranges.commands.start + draw.cursor(UI_SCENE_TABLE_COMMANDS)

        val command = draw_ir_v3_command(
            item.kind, item.flags, item.component_id, item.component_generation, item.parent_id,
            geometry_id, paint_id, text_run_id, image_resource_id, path_span_id,
            clip_id, transform_id, hit_shape_id
        )
        if not draw.put_command(command):
            return false

        if item.has_geometry:
            if not draw.put_geometry(DrawIrV3Geometry(
                present: true, x: item.x, y: item.y, width: item.width,
                height: item.height, corner_radius: item.corner_radius
            )):
                return false

        if item.has_paint:
            if not draw.put_paint(DrawIrV3Paint(
                present: true, fill_color: item.fill_color, stroke_color: item.stroke_color,
                stroke_width_milli: item.stroke_width_milli, opacity_milli: item.opacity_milli,
                blend_mode: item.blend_mode
            )):
                return false

        if item.has_text_run:
            val glyph_start = ranges.glyphs.start + draw.cursor(UI_SCENE_TABLE_GLYPHS)
            if not draw.put_text_run(DrawIrV3TextRun(
                present: true, glyph_start: glyph_start, glyph_count: item.glyph_count as u32,
                font_resource_id: item.font_resource_id, font_size_milli: item.font_size_milli,
                baseline_x: item.baseline_x, baseline_y: item.baseline_y, color: item.text_color
            )):
                return false
            var g = 0
            while g < item.glyph_count:
                val src = item.glyph_start + g
                if not draw.put_glyph(DrawIrV3Glyph(
                    present: true, glyph_id: request.glyph_ids[src], x: request.glyph_xs[src],
                    y: request.glyph_ys[src], cluster: request.glyph_clusters[src]
                )):
                    return false
                g = g + 1

        if item.has_resource:
            if not draw.put_resource(DrawIrV3Resource(
                present: true, kind: item.resource_kind, format: item.resource_format,
                width: item.resource_width, height: item.resource_height,
                content_hash: item.resource_content_hash
            )):
                return false

        if item.has_path_span:
            val point_start = ranges.path_points.start + draw.cursor(UI_SCENE_TABLE_PATH_POINTS)
            if not draw.put_path_span(DrawIrV3PathSpan(
                present: true, point_start: point_start, point_count: item.point_count as u32,
                fill_rule: item.fill_rule
            )):
                return false
            var p = 0
            while p < item.point_count:
                val src = item.point_start + p
                if not draw.put_path_point(DrawIrV3PathPoint(
                    present: true, x: request.point_xs[src], y: request.point_ys[src],
                    verb: request.point_verbs[src]
                )):
                    return false
                p = p + 1

        if item.has_clip:
            if not draw.put_clip(DrawIrV3Clip(
                present: true, x: item.clip_x, y: item.clip_y, width: item.clip_width,
                height: item.clip_height, corner_radius: item.clip_corner_radius,
                parent_id: item.clip_parent_id
            )):
                return false

        if item.has_transform:
            if not draw.put_transform(DrawIrV3Transform(
                present: true, m11: item.m11, m12: item.m12, m21: item.m21,
                m22: item.m22, dx: item.dx, dy: item.dy
            )):
                return false

        if item.has_hit_shape:
            if not draw.put_hit_shape(DrawIrV3HitShape(
                present: true, x: item.hit_x, y: item.hit_y, width: item.hit_width,
                height: item.hit_height, shape_kind: item.hit_shape_kind,
                hit_flags: item.hit_flags, component_id: item.component_id,
                z_index: item.hit_z_index, enabled: item.hit_enabled,
                pointer_policy: item.hit_pointer_policy
            )):
                return false

        if item.has_provenance:
            if not draw.put_provenance(DrawIrV3Provenance(
                present: true, command_index: command_id, edge_kind: item.provenance_edge_kind,
                source_node_id: item.provenance_source_node_id, source_rule_id: item.provenance_source_rule_id,
                source_span_start: item.provenance_source_span_start, source_span_len: item.provenance_source_span_len
            )):
                return false

        val action_binding_id = if item.has_action_binding: (ranges.action_bindings.start + actions.cursor()) else: DRAW_IR_V3_NO_ID

        if not owners.put_owner_record(UiOwnerRecord(
            producer_kind: item.owner_producer_kind, event_policy: item.owner_event_policy,
            semantic_id: item.component_id, semantic_generation: item.component_generation,
            parent_owner_id: item.owner_parent_owner_id, action_binding_id: action_binding_id
        )):
            return false

        if item.has_action_binding:
            if not actions.put_action_binding(MenuActionBinding(
                app_id: item.action_app_id, app_generation: item.action_app_generation,
                menu_revision: item.action_menu_revision, action_id: item.action_id,
                default_target_owner_id: item.action_default_target_owner_id
            )):
                return false

        i = i + 1
    true

# ===========================================================================
# PREPARED_BATCHES (table 14) / DIRTY_RANGES (table 15): derived, pure
# function of the finished scene only (design §2.5). See the COUNT-time
# comment above for why the rule must stay exactly this simple.
# ===========================================================================

struct DrawIrV3FullDerived:
    batches: [Prepared2DBatch]
    dirty: [UiSceneRange]

fn draw_ir_v3_emit_full_derive(scene: DrawIrV3Scene) -> DrawIrV3FullDerived:
    val total = scene.commands.len()
    if total == 0:
        return DrawIrV3FullDerived(batches: [], dirty: [])
    val batch = Prepared2DBatch(
        first_command: 0u32, command_count: total as u32,
        target_surface_id: 0u32, pipeline_id: 0u32, resource_set_id: 0u32,
        resolved_clip_id: DRAW_IR_V3_NO_ID, resolved_transform_id: DRAW_IR_V3_NO_ID,
        flags: UI_SCENE_PREPARED2D_FLAG_NONE
    )
    val dirty = UiSceneRange(start: 0u32, count: total as u32)
    DrawIrV3FullDerived(batches: [batch], dirty: [dirty])

# ===========================================================================
# Outcome + top-level driver (design §5 state machine, whole pipeline).
# ===========================================================================

struct DrawIrV3EmitFullOutcome:
    emitted: bool
    overflow: UiSceneOverflowReceipt?
    write_verdict: UiSceneWriteVerdict?
    counts: UiSceneCounts
    scene: DrawIrV3Scene
    owners: [UiOwnerRecord]
    actions: [MenuActionBinding]
    prepared_batches: [Prepared2DBatch]
    dirty_ranges: [UiSceneRange]

fn _draw_ir_v3_emit_full_outcome_refused(receipt: UiSceneOverflowReceipt, counts: UiSceneCounts) -> DrawIrV3EmitFullOutcome:
    DrawIrV3EmitFullOutcome(
        emitted: false, overflow: receipt, write_verdict: nil, counts: counts,
        scene: draw_ir_v3_empty_scene(0u32, 0u32), owners: [], actions: [],
        prepared_batches: [], dirty_ranges: []
    )

fn _draw_ir_v3_emit_full_outcome_write_failed(verdict: UiSceneWriteVerdict, counts: UiSceneCounts) -> DrawIrV3EmitFullOutcome:
    DrawIrV3EmitFullOutcome(
        emitted: false, overflow: nil, write_verdict: verdict, counts: counts,
        scene: draw_ir_v3_empty_scene(0u32, 0u32), owners: [], actions: [],
        prepared_batches: [], dirty_ranges: []
    )

# COUNT -> SCAN -> VERIFY -> EMIT (design §5). VERIFY failure: nothing
# emitted anywhere, front generation untouched (represented here by the
# refused outcome's all-empty tables). EMIT failure (Deficit/Surplus on any
# of the three writers): generation invalidated, also all-empty — under-
# emission and over-emission are exactly as fatal as a capacity breach.
fn draw_ir_v3_emit_full_scene(
    request0: DrawIrV3FullEmitRequest, capacity: UiSceneCapacityExtensionV1,
    scene_id: u32, generation: u32, snapshot_id: u64,
    producer_kind: u16, producer_id: u32
) -> DrawIrV3EmitFullOutcome:
    val request = draw_ir_v3_full_assign_component_ids(request0)
    val counts = draw_ir_v3_emit_full_count(request)

    val receipt = ui_scene_verify(counts, capacity, producer_kind, producer_id, snapshot_id)
    if val r = receipt:
        return _draw_ir_v3_emit_full_outcome_refused(r, counts)

    val scanned = ui_scene_scan([counts])
    val ranges = scanned[0]

    var draw = draw_ir_v3_full_writer_create(counts, ranges)
    var owners = ui_owner_record_writer_create(counts.owner_records, ranges.owner_records)
    var actions = ui_action_binding_writer_create(counts.action_bindings, ranges.action_bindings)

    val ok = draw_ir_v3_emit_full_write_items(request, ranges, draw, owners, actions)
    if not ok:
        return _draw_ir_v3_emit_full_outcome_write_failed(
            UiSceneWriteVerdict.Surplus(table_id: UI_SCENE_TABLE_COMMANDS, n: 0u32), counts
        )

    val draw_verdict = draw.finish()
    if not draw_ir_v3_verdict_is_exact(draw_verdict):
        return _draw_ir_v3_emit_full_outcome_write_failed(draw_verdict, counts)

    val owner_verdict = owners.finish()
    if not draw_ir_v3_verdict_is_exact(owner_verdict):
        return _draw_ir_v3_emit_full_outcome_write_failed(owner_verdict, counts)

    val action_verdict = actions.finish()
    if not draw_ir_v3_verdict_is_exact(action_verdict):
        return _draw_ir_v3_emit_full_outcome_write_failed(action_verdict, counts)

    val scene = draw.to_scene(scene_id, generation)
    val owner_list = owners.to_list()
    val action_list = actions.to_list()
    val derived = draw_ir_v3_emit_full_derive(scene)

    DrawIrV3EmitFullOutcome(
        emitted: true, overflow: nil, write_verdict: nil, counts: counts,
        scene: scene, owners: owner_list, actions: action_list,
        prepared_batches: derived.batches, dirty_ranges: derived.dirty
    )

export DrawIrV3FullEmitItem, DrawIrV3FullEmitRequest, DrawIrV3EmitFullOutcome, DrawIrV3FullDerived,
    DrawIrV3FullWriter, UiOwnerRecordWriter, UiActionBindingWriter,
    draw_ir_v3_full_item_blank, draw_ir_v3_full_request_blank,
    draw_ir_v3_full_assign_component_ids,
    draw_ir_v3_emit_full_count,
    draw_ir_v3_full_writer_create, ui_owner_record_writer_create, ui_action_binding_writer_create,
    draw_ir_v3_verdict_is_exact,
    draw_ir_v3_emit_full_write_items, draw_ir_v3_emit_full_derive,
    draw_ir_v3_emit_full_scene
