use common.text_advanced.{escape_json}
use common.ui.access_types.{
    UiAccessNode,
    UiAccessProp,
    UiAccessSurface,
    UiAccessEvent,
    UiAccessSnapshot,
    UiAccessQueryResult,
    UiAccessEnsureResult,
    ui_access_widget_id_from_canonical
}

# =========================================================================
# Node matching
# =========================================================================
#
# Text matching is case-insensitive and searches the node's own text plus the
# identity fields and the human-facing props a widget carries its label in
# ("label", "value", "content", "placeholder", "title", "text"). A session-built
# button stores "OK" in props.label, not in text_value, so an identity-only
# matcher would never find it.

fn _access_ci_contains(haystack: text, needle: text) -> bool:
    if needle == "":
        return true
    if haystack == "":
        return false
    haystack.lower().contains(needle.lower())

fn _access_prop_is_texty(key: text) -> bool:
    key == "label" or key == "value" or key == "content" or key == "placeholder" or key == "title" or key == "text"

fn ui_access_node_matches_text(node: UiAccessNode, text_query: text) -> bool:
    """True when `text_query` occurs (case-insensitively) anywhere user-visible on `node`."""
    if text_query == "":
        return true
    if _access_ci_contains(node.text_value, text_query):
        return true
    if _access_ci_contains(node.widget_id, text_query):
        return true
    if _access_ci_contains(node.canonical_id, text_query):
        return true
    var i = 0
    while i < node.props.len():
        val prop = node.props[i]
        if _access_prop_is_texty(prop.key) and _access_ci_contains(prop.value, text_query):
            return true
        i = i + 1
    false

fn _access_node_matches_query(node: UiAccessNode, surface_id: text, kind: text, text_query: text, focused_only: bool) -> bool:
    if surface_id != "" and node.surface_id != surface_id:
        return false
    if kind != "" and node.kind != kind:
        return false
    if not ui_access_node_matches_text(node, text_query):
        return false
    if focused_only and not node.focused:
        return false
    true

fn ui_access_find_nodes(snapshot: UiAccessSnapshot, surface_id: text, kind: text, text_query: text, limit: i32) -> [UiAccessNode]:
    ui_access_find_nodes_filtered(snapshot, surface_id, kind, text_query, false, limit)

fn ui_access_find_nodes_filtered(snapshot: UiAccessSnapshot, surface_id: text, kind: text, text_query: text, focused_only: bool, limit: i32) -> [UiAccessNode]:
    val node_count = snapshot.nodes.len()
    if node_count == 0:
        return []
    var out: [UiAccessNode] = []
    var read_idx = 0
    while read_idx < node_count:
        val node = snapshot.nodes[read_idx]
        if _access_node_matches_query(node, surface_id, kind, text_query, focused_only):
            out = out.push(node)
            if limit > 0 and out.len() >= limit:
                return out
        read_idx = read_idx + 1
    out

fn ui_access_find_node(snapshot: UiAccessSnapshot, canonical_id: text) -> UiAccessNode?:
    var i = 0
    while i < snapshot.nodes.len():
        val node = snapshot.nodes[i]
        if node.canonical_id == canonical_id:
            return node
        i = i + 1
    nil

fn ui_access_find_surface(snapshot: UiAccessSnapshot, surface_id: text) -> UiAccessSurface?:
    var i = 0
    while i < snapshot.surfaces.len():
        val surface = snapshot.surfaces[i]
        if surface.surface_id == surface_id:
            return surface
        i = i + 1
    nil

# =========================================================================
# Declarative query layer
# =========================================================================

pub val UI_ACCESS_QUERY_DEFAULT_LIMIT: i32 = 50
pub val UI_ACCESS_QUERY_MAX_LIMIT: i32 = 1000

fn _access_query_failed(error: text, limit: i32) -> UiAccessQueryResult:
    UiAccessQueryResult(
        ok: false,
        error: error,
        nodes: [],
        count: 0,
        match_count: 0,
        total_count: 0,
        truncated: false,
        limit: limit
    )

fn ui_access_query_validate(surface_id: text, canonical_id: text, kind: text, text_query: text, focused_only: bool, limit: i32) -> text:
    """Return "" when the query is well formed, else a machine-readable error.

    A query with no predicate at all AND no positive cap is rejected rather than
    silently answered with the whole tree."""
    if limit < 0:
        return "invalid limit {limit}"
    if limit > UI_ACCESS_QUERY_MAX_LIMIT:
        return "limit {limit} exceeds maximum {UI_ACCESS_QUERY_MAX_LIMIT}"
    if canonical_id != "" and not canonical_id.contains("#"):
        return "invalid canonical_id {canonical_id}"
    if canonical_id == "" and surface_id == "" and kind == "" and text_query == "" and not focused_only and limit == 0:
        return "unbounded query: supply a predicate (surface_id, canonical_id, kind, text, focused_only) or a positive limit"
    ""

fn ui_access_query(snapshot: UiAccessSnapshot, surface_id: text, canonical_id: text, kind: text, text_query: text, focused_only: bool, limit: i32) -> UiAccessQueryResult:
    """Run a declarative widget query against a canonical snapshot.

    Selects by canonical id, surface, role (`kind`), free text, and the focused
    predicate. Fails closed on a malformed query."""
    val error = ui_access_query_validate(surface_id, canonical_id, kind, text_query, focused_only, limit)
    if error != "":
        return _access_query_failed(error, limit)

    if canonical_id != "":
        val node = ui_access_find_node(snapshot, canonical_id)
        if node == nil:
            return _access_query_failed("canonical node {canonical_id} not found", limit)
        if not _access_node_matches_query(node, surface_id, kind, text_query, focused_only):
            return UiAccessQueryResult(
                ok: true,
                error: "",
                nodes: [],
                count: 0,
                match_count: 0,
                total_count: 0,
                truncated: false,
                limit: limit
            )
        return UiAccessQueryResult(
            ok: true,
            error: "",
            nodes: [node],
            count: 1,
            match_count: 1,
            total_count: 1,
            truncated: false,
            limit: limit
        )

    var total = 0
    var kept: [UiAccessNode] = []
    var idx = 0
    while idx < snapshot.nodes.len():
        val candidate = snapshot.nodes[idx]
        if _access_node_matches_query(candidate, surface_id, kind, text_query, focused_only):
            total = total + 1
            if limit <= 0 or kept.len() < limit:
                kept = kept.push(candidate)
        idx = idx + 1
    val kept_count = kept.len()
    UiAccessQueryResult(
        ok: true,
        error: "",
        nodes: kept,
        count: kept_count,
        match_count: kept_count,
        total_count: total,
        truncated: total > kept_count,
        limit: limit
    )

fn ui_access_query_result(nodes: [UiAccessNode]) -> UiAccessQueryResult:
    """Wrap an already-selected node list as a query result (no cap applied)."""
    val node_count = nodes.len()
    UiAccessQueryResult(
        ok: true,
        error: "",
        nodes: nodes,
        count: node_count,
        match_count: node_count,
        total_count: node_count,
        truncated: false,
        limit: 0
    )

fn ui_access_query_to_json(result: UiAccessQueryResult) -> text:
    var parts: [text] = [
        "{",
        _access_json_pair("ok", _access_json_bool(result.ok)), ",",
        _access_json_pair("error", _access_json_str(result.error)), ",",
        _access_json_pair("count", "{result.count}"), ",",
        _access_json_pair("match_count", "{result.match_count}"), ",",
        _access_json_pair("total_count", "{result.total_count}"), ",",
        _access_json_pair("truncated", _access_json_bool(result.truncated)), ",",
        _access_json_pair("nodes", _access_nodes_to_json(result.nodes)),
        "}"
    ]
    parts.join("")

fn ui_access_query_snapshot_to_json(snapshot: UiAccessSnapshot, surface_id: text, canonical_id: text, kind: text, text_query: text, focused_only: bool, limit: i32) -> text:
    """Run a declarative query and serialize the result."""
    ui_access_query_to_json(ui_access_query(snapshot, surface_id, canonical_id, kind, text_query, focused_only, limit))

# =========================================================================
# Declarative ensure layer
# =========================================================================
#
# An expectation is evaluated over the query result and produces a `satisfied`
# verdict plus a machine-readable `reason` when unsatisfied. Reasons are stable
# codes (`query_invalid`, `no_match`, `unexpected_match`, `count_mismatch`,
# `state_mismatch`, `value_mismatch`, `unsupported_expectation`) followed by a
# detail clause.

fn _access_all_focused(nodes: [UiAccessNode]) -> bool:
    var i = 0
    while i < nodes.len():
        if not nodes[i].focused:
            return false
        i = i + 1
    true

fn _access_all_enabled(nodes: [UiAccessNode]) -> bool:
    var i = 0
    while i < nodes.len():
        if not nodes[i].enabled:
            return false
        i = i + 1
    true

fn _access_all_visible(nodes: [UiAccessNode]) -> bool:
    var i = 0
    while i < nodes.len():
        if not nodes[i].visible:
            return false
        i = i + 1
    true

fn _access_all_selected(nodes: [UiAccessNode]) -> bool:
    var i = 0
    while i < nodes.len():
        if not nodes[i].selected:
            return false
        i = i + 1
    true

fn _access_ensure(result: UiAccessQueryResult, expectation: text, expected_value: text, elapsed_ms: i64) -> UiAccessEnsureResult:
    var satisfied = false
    var reason = ""
    val found = result.match_count
    val wanted = if expectation == "": "exists" else: expectation.lower()

    if not result.ok:
        satisfied = false
        reason = "query_invalid: {result.error}"
    elif wanted == "exists" or wanted == "present" or wanted == "visible_exists":
        satisfied = found > 0
        if not satisfied:
            reason = "no_match: expected at least one node, found 0"
    elif wanted == "absent" or wanted == "missing" or wanted == "not_exists":
        satisfied = found == 0
        if not satisfied:
            reason = "unexpected_match: expected no node, found {found}"
    elif wanted == "match_count" or wanted == "count":
        if expected_value == "":
            satisfied = false
            reason = "count_mismatch: expectation match_count requires expected_value"
        else:
            val target = expected_value.to_i32()
            satisfied = found == target
            if not satisfied:
                reason = "count_mismatch: expected {target}, found {found}"
    elif wanted == "focused":
        satisfied = found > 0 and _access_all_focused(result.nodes)
        if not satisfied:
            reason = "state_mismatch: expected all {found} matched node(s) focused"
    elif wanted == "enabled":
        satisfied = found > 0 and _access_all_enabled(result.nodes)
        if not satisfied:
            reason = "state_mismatch: expected all {found} matched node(s) enabled"
    elif wanted == "visible":
        satisfied = found > 0 and _access_all_visible(result.nodes)
        if not satisfied:
            reason = "state_mismatch: expected all {found} matched node(s) visible"
    elif wanted == "selected" or wanted == "checked":
        satisfied = found > 0 and _access_all_selected(result.nodes)
        if not satisfied:
            reason = "state_mismatch: expected all {found} matched node(s) selected"
    elif wanted == "value":
        if found == 0:
            satisfied = false
            reason = "no_match: expected at least one node, found 0"
        else:
            val actual = ui_access_node_value(result.nodes[0])
            satisfied = actual == expected_value
            if not satisfied:
                reason = "value_mismatch: expected \"{expected_value}\", found \"{actual}\""
    elif wanted == "text":
        if found == 0:
            satisfied = false
            reason = "no_match: expected at least one node, found 0"
        else:
            satisfied = ui_access_node_matches_text(result.nodes[0], expected_value)
            if not satisfied:
                reason = "value_mismatch: expected text containing \"{expected_value}\""
    else:
        satisfied = false
        reason = "unsupported_expectation: {expectation}"

    UiAccessEnsureResult(
        satisfied: satisfied,
        reason: reason,
        expectation: wanted,
        expected_value: expected_value,
        match_count: found,
        total_count: result.total_count,
        truncated: result.truncated,
        nodes: result.nodes,
        elapsed_ms: elapsed_ms
    )

fn ui_access_ensure_result(snapshot: UiAccessSnapshot, surface_id: text, canonical_id: text, kind: text, text_query: text, focused_only: bool, limit: i32, expectation: text, expected_value: text) -> UiAccessEnsureResult:
    """Evaluate a declarative expectation over a bounded canonical query."""
    _access_ensure(ui_access_query(snapshot, surface_id, canonical_id, kind, text_query, focused_only, limit), expectation, expected_value, 0)

fn ui_access_ensure_to_json(snapshot: UiAccessSnapshot, surface_id: text, canonical_id: text, kind: text, text_query: text, focused_only: bool, limit: i32, expectation: text, expected_value: text, elapsed_ms: i64) -> text:
    """Evaluate an expectation and serialize the verdict."""
    val result = _access_ensure(ui_access_query(snapshot, surface_id, canonical_id, kind, text_query, focused_only, limit), expectation, expected_value, elapsed_ms)
    ui_access_ensure_result_to_json(result)

fn ui_access_ensure_result_to_json(result: UiAccessEnsureResult) -> text:
    var parts: [text] = [
        "{",
        _access_json_pair("satisfied", _access_json_bool(result.satisfied)), ",",
        _access_json_pair("expectation", _access_json_str(result.expectation)), ",",
        _access_json_pair("expected_value", _access_json_str(result.expected_value)), ",",
        _access_json_pair("reason", _access_json_str(result.reason)), ",",
        _access_json_pair("match_count", "{result.match_count}"), ",",
        _access_json_pair("total_count", "{result.total_count}"), ",",
        _access_json_pair("truncated", _access_json_bool(result.truncated)), ",",
        _access_json_pair("elapsed_ms", "{result.elapsed_ms}"), ",",
        _access_json_pair("nodes", _access_nodes_to_json(result.nodes)),
        "}"
    ]
    parts.join("")

# =========================================================================
# Values and actions
# =========================================================================

fn _access_node_prop(node: UiAccessNode, key: text) -> text:
    var i = 0
    while i < node.props.len():
        val prop = node.props[i]
        if prop.key == key:
            return prop.value
        i = i + 1
    ""

fn ui_access_node_value(node: UiAccessNode) -> text:
    # Explicit typed value first ("value" then "text" props); the derived
    # accessible name (text_value) is a display fallback only — since the
    # kind-aware accessible-name fix it also carries labels/titles, which
    # are NOT typed values.
    val explicit = _access_node_prop(node, "value")
    if explicit != "":
        return explicit
    val text_prop = _access_node_prop(node, "text")
    if text_prop != "":
        return text_prop
    node.text_value

fn ui_access_supports_value(node: UiAccessNode) -> bool:
    # Value-bearing kinds, or any node with an explicit value/text prop.
    # Deliberately NOT text_value: that now carries kind-derived accessible
    # names (button labels, panel titles), which are not writable values.
    (node.kind == "input" or node.kind == "textfield" or node.kind == "textarea"
        or _access_node_prop(node, "value") != "" or _access_node_prop(node, "text") != "")

fn ui_access_value_to_json(snapshot: UiAccessSnapshot, canonical_id: text) -> text:
    """Serialize the typed value of one canonical node."""
    val node = ui_access_find_node(snapshot, canonical_id)
    if node == nil:
        var missing: [text] = [
            "{",
            _access_json_pair("canonical_id", _access_json_str(canonical_id)), ",",
            _access_json_pair("supported", "false"), ",",
            _access_json_pair("error", _access_json_str("canonical node {canonical_id} not found")),
            "}"
        ]
        return missing.join("")
    var parts: [text] = [
        "{",
        _access_json_pair("canonical_id", _access_json_str(node.canonical_id)), ",",
        _access_json_pair("surface_id", _access_json_str(node.surface_id)), ",",
        _access_json_pair("widget_id", _access_json_str(node.widget_id)), ",",
        _access_json_pair("kind", _access_json_str(node.kind)), ",",
        _access_json_pair("supported", _access_json_bool(ui_access_supports_value(node))), ",",
        _access_json_pair("value", _access_json_str(ui_access_node_value(node))),
        "}"
    ]
    parts.join("")

fn ui_access_node_action_name(node: UiAccessNode, requested: text) -> text:
    """Resolve the dispatchable action name for an already-resolved node."""
    val wanted = if requested == "": "click" else: requested
    var i = 0
    while i < node.action_names.len():
        if node.action_names[i] == wanted:
            return wanted
        i = i + 1
    val verb = if wanted == "invoke" or wanted == "press" or wanted == "activate": "click" else: wanted
    "{verb}_{node.widget_id}"

fn ui_access_resolve_action_name(snapshot: UiAccessSnapshot, canonical_id: text, requested: text) -> text:
    """Resolve the dispatchable action name for a canonical node reference.

    An action the node declares is kept verbatim; anything else becomes a
    widget-targeted `{verb}_{widget_id}`, with the invoke/press aliases folded
    onto `click`."""
    val node = ui_access_find_node(snapshot, canonical_id)
    if node != nil:
        return ui_access_node_action_name(node, requested)
    val wanted = if requested == "": "click" else: requested
    val verb = if wanted == "invoke" or wanted == "press" or wanted == "activate": "click" else: wanted
    val widget_id = ui_access_widget_id_from_canonical(canonical_id)
    if widget_id == "":
        return verb
    "{verb}_{widget_id}"

# =========================================================================
# Snapshot serialization
# =========================================================================

fn ui_access_snapshot_to_text(snapshot: UiAccessSnapshot) -> text:
    "UiAccessSnapshot surfaces={snapshot.surfaces.len()} nodes={snapshot.nodes.len()} active={snapshot.active_surface}"

fn ui_access_snapshot_to_json(snapshot: UiAccessSnapshot) -> text:
    var parts: [text] = [
        "{",
        _access_json_pair("protocol_version", "{snapshot.protocol_version}"), ",",
        _access_json_pair("snapshot_revision", "{snapshot.snapshot_revision}"), ",",
        _access_json_pair("mode", _access_json_str(snapshot.mode)), ",",
        _access_json_pair("active_surface", _access_json_str(snapshot.active_surface)), ",",
        _access_json_pair("surfaces", _access_surfaces_to_json(snapshot.surfaces)), ",",
        _access_json_pair("nodes", _access_nodes_to_json(snapshot.nodes)), ",",
        _access_json_pair("recent_events", ui_access_events_to_json(snapshot.recent_events)),
        "}"
    ]
    parts.join("")

fn ui_access_surface_to_json(surface: UiAccessSurface) -> text:
    var parts: [text] = [
        "{",
        _access_json_pair("surface_id", _access_json_str(surface.surface_id)), ",",
        _access_json_pair("title", _access_json_str(surface.title)), ",",
        _access_json_pair("active", _access_json_bool(surface.active)), ",",
        _access_json_pair("window_id", _access_json_str(surface.window_id)), ",",
        _access_json_pair("app_id", _access_json_str(surface.app_id)), ",",
        _access_json_pair("root_canonical_id", _access_json_str(surface.root_canonical_id)),
        "}"
    ]
    parts.join("")

fn ui_access_surface_scope_to_json(snapshot: UiAccessSnapshot, surface_id: text) -> text:
    """Serialize one surface together with the nodes it owns.

    Returns "{}" when the surface is not present in the snapshot."""
    val surface = ui_access_find_surface(snapshot, surface_id)
    if surface == nil:
        return "{}"
    var owned: [UiAccessNode] = []
    var i = 0
    while i < snapshot.nodes.len():
        if snapshot.nodes[i].surface_id == surface_id:
            owned = owned.push(snapshot.nodes[i])
        i = i + 1
    var parts: [text] = [
        "{",
        _access_json_pair("surface_id", _access_json_str(surface.surface_id)), ",",
        _access_json_pair("title", _access_json_str(surface.title)), ",",
        _access_json_pair("active", _access_json_bool(surface.active)), ",",
        _access_json_pair("window_id", _access_json_str(surface.window_id)), ",",
        _access_json_pair("app_id", _access_json_str(surface.app_id)), ",",
        _access_json_pair("root_canonical_id", _access_json_str(surface.root_canonical_id)), ",",
        _access_json_pair("node_count", "{owned.len()}"), ",",
        _access_json_pair("nodes", _access_nodes_to_json(owned)),
        "}"
    ]
    parts.join("")

fn ui_access_events_to_json(events: [UiAccessEvent]) -> text:
    val event_count = events.len()
    if event_count == 0:
        return "[]"
    var parts: [text] = [""; event_count]
    var idx = 0
    while idx < event_count:
        parts[idx] = _access_event_to_json(events[idx])
        idx = idx + 1
    "[" + parts.join(",") + "]"

fn _access_surfaces_to_json(surfaces: [UiAccessSurface]) -> text:
    val surface_count = surfaces.len()
    if surface_count == 0:
        return "[]"
    var parts: [text] = [""; surface_count]
    var idx = 0
    while idx < surface_count:
        parts[idx] = ui_access_surface_to_json(surfaces[idx])
        idx = idx + 1
    "[" + parts.join(",") + "]"

fn _access_nodes_to_json(nodes: [UiAccessNode]) -> text:
    val node_count = nodes.len()
    if node_count == 0:
        return "[]"
    var parts: [text] = [""; node_count]
    var idx = 0
    while idx < node_count:
        parts[idx] = _access_node_to_json(nodes[idx])
        idx = idx + 1
    "[" + parts.join(",") + "]"

fn _access_node_to_json(node: UiAccessNode) -> text:
    var parts: [text] = [
        "{",
        _access_json_pair("canonical_id", _access_json_str(node.canonical_id)), ",",
        _access_json_pair("surface_id", _access_json_str(node.surface_id)), ",",
        _access_json_pair("widget_id", _access_json_str(node.widget_id)), ",",
        _access_json_pair("kind", _access_json_str(node.kind)), ",",
        _access_json_pair("visible", _access_json_bool(node.visible)), ",",
        _access_json_pair("focused", _access_json_bool(node.focused)), ",",
        _access_json_pair("enabled", _access_json_bool(node.enabled)), ",",
        _access_json_pair("selected", _access_json_bool(node.selected)), ",",
        _access_json_pair("text", _access_json_str(node.text_value)), ",",
        _access_json_pair("props", _access_props_to_json(node.props)), ",",
        _access_json_pair("child_ids", _access_text_array_to_json(node.child_ids)), ",",
        _access_json_pair("action_names", _access_text_array_to_json(node.action_names)),
        "}"
    ]
    parts.join("")

fn _access_props_to_json(props: [UiAccessProp]) -> text:
    var parts: [text] = []
    var i = 0
    while i < props.len():
        var duplicate = false
        var prior = 0
        while prior < i:
            if props[prior].key == props[i].key:
                duplicate = true
            prior = prior + 1
        if not duplicate:
            parts = parts.push(_access_json_pair(props[i].key, _access_json_str(props[i].value)))
        i = i + 1
    "{" + parts.join(",") + "}"

fn _access_event_to_json(event: UiAccessEvent) -> text:
    var parts: [text] = [
        "{",
        _access_json_pair("surface_id", _access_json_str(event.surface_id)), ",",
        _access_json_pair("widget_id", _access_json_str(event.widget_id)), ",",
        _access_json_pair("canonical_id", _access_json_str(event.canonical_id)), ",",
        _access_json_pair("event_kind", _access_json_str(event.event_kind)), ",",
        _access_json_pair("payload", _access_json_str(event.payload)), ",",
        _access_json_pair("sequence", "{event.sequence}"),
        "}"
    ]
    parts.join("")

fn _access_text_array_to_json(values: [text]) -> text:
    val value_count = values.len()
    if value_count == 0:
        return "[]"
    var parts: [text] = [""; value_count]
    var idx = 0
    while idx < value_count:
        parts[idx] = _access_json_str(values[idx])
        idx = idx + 1
    "[" + parts.join(",") + "]"

fn _access_json_pair(key: text, value: text) -> text:
    _access_json_str(key) + ":" + value

fn _access_json_bool(value: bool) -> text:
    if value:
        "true"
    else:
        "false"

fn _access_json_str(value: text) -> text:
    "\"" + escape_json(value) + "\""

export UI_ACCESS_QUERY_DEFAULT_LIMIT, UI_ACCESS_QUERY_MAX_LIMIT
