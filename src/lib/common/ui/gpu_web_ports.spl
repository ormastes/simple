# GPU Web Ports — frozen C0 contract: input/mutation/host-effect packets.
#
# Contract source (frozen; field names and widths are authoritative):
#   doc/03_plan/ui/gpu_web_scene_offload_mdsoc_plus_plan.md
#     §3 "GPU event model" (event records), §2 "Host effects are not full CPU
#     fallback", §9 "Stable ports".
# Shared lane rules:
#   doc/03_plan/platform/structural_compute/README.md
#
# All variable-length data (text, payloads) lives in fixed event/payload
# arenas and is referenced by offset + length. Packets carry index +
# generation, never host pointers. After C0 merge this file is read-only
# until an explicit schema-version change (isolation rule 3).

pub val GPU_WEB_PORTS_SCHEMA_VERSION: text = "simple-gpu-web-ports-v1"
pub val GPU_WEB_PORTS_SCHEMA_ID: u32 = 1u32

# ---------------------------------------------------------------------------
# Event kinds (GpuInputEvent.kind)
# ---------------------------------------------------------------------------

pub val GPU_EVENT_KIND_NONE: u16 = 0u16
pub val GPU_EVENT_KIND_POINTER_MOVE: u16 = 1u16
pub val GPU_EVENT_KIND_POINTER_DOWN: u16 = 2u16
pub val GPU_EVENT_KIND_POINTER_UP: u16 = 3u16
pub val GPU_EVENT_KIND_WHEEL: u16 = 4u16
pub val GPU_EVENT_KIND_KEY_DOWN: u16 = 5u16
pub val GPU_EVENT_KIND_KEY_UP: u16 = 6u16
pub val GPU_EVENT_KIND_TEXT_INPUT: u16 = 7u16
pub val GPU_EVENT_KIND_TIMER: u16 = 8u16
pub val GPU_EVENT_KIND_HOST_EFFECT_COMPLETION: u16 = 9u16

# ---------------------------------------------------------------------------
# Host effect kinds (GpuHostEffectRequest.effect_kind)
# ---------------------------------------------------------------------------

pub val HOST_EFFECT_NONE: u16 = 0u16
pub val HOST_EFFECT_FETCH: u16 = 1u16
pub val HOST_EFFECT_FILE: u16 = 2u16
pub val HOST_EFFECT_CLIPBOARD: u16 = 3u16
pub val HOST_EFFECT_IME: u16 = 4u16
pub val HOST_EFFECT_ACCESSIBILITY_SNAPSHOT: u16 = 5u16

# ---------------------------------------------------------------------------
# Frozen packet records (plan §3)
# ---------------------------------------------------------------------------

struct GpuInputEvent:
    sequence: u64
    scene_generation: u64
    timestamp_ns: u64

    kind: u16
    device_id: u16
    flags: u32

    x_fixed: i32
    y_fixed: i32
    delta_x_fixed: i32
    delta_y_fixed: i32

    key_code: u32
    text_offset: u32
    text_length: u32

struct GpuMutation:
    node_id: u32
    node_generation: u32
    field_id: u16
    operation: u16
    value_lo: u32
    value_hi: u32
    sequence: u32

struct GpuHostEffectRequest:
    event_sequence: u64
    effect_kind: u16
    continuation_id: u16
    payload_offset: u32
    payload_length: u32

struct GpuHostEffectCompletion:
    request_event_sequence: u64
    effect_kind: u16
    continuation_id: u16
    status: u16
    payload_offset: u32
    payload_length: u32

# Sealed resource packet: compressed bytes entering the shared/pinned ring
# (plan §5 "Resource flow"). Bytes live in the transport arena.
struct GpuResourcePacket:
    resource_id: u32
    resource_generation: u32
    media_kind: u16
    flags: u16
    byte_offset: u64
    byte_length: u64
    declared_width: u32
    declared_height: u32

# ---------------------------------------------------------------------------
# Stable ports (plan §9). Implementations live in backend capsules; the
# contract is method shape only — no state, no defaults.
# ---------------------------------------------------------------------------

trait GpuInputPacketPort:
    """CPU host appends normalized, coalescible input events for one epoch."""
    fn submit_events(events: [GpuInputEvent]) -> bool
    fn pending_count() -> i64

trait GpuResourcePacketPort:
    """CPU transport appends sealed compressed-resource packets."""
    fn submit_resources(packets: [GpuResourcePacket]) -> bool

trait GpuHostEffectRequestPort:
    """GPU-side bounded requests drained by the CPU host-effect service."""
    fn drain_requests(max_count: i64) -> [GpuHostEffectRequest]

trait GpuHostEffectCompletionPort:
    """CPU host returns effect completions as ordinary input events."""
    fn submit_completion(completion: GpuHostEffectCompletion) -> bool

trait GpuSceneEpochPort:
    """Scene-generation lifecycle: current generation and epoch commit."""
    fn current_generation() -> u64
    fn commit_epoch(mutations: [GpuMutation]) -> u64

export GPU_WEB_PORTS_SCHEMA_VERSION, GPU_WEB_PORTS_SCHEMA_ID,
    GPU_EVENT_KIND_NONE, GPU_EVENT_KIND_POINTER_MOVE, GPU_EVENT_KIND_POINTER_DOWN,
    GPU_EVENT_KIND_POINTER_UP, GPU_EVENT_KIND_WHEEL, GPU_EVENT_KIND_KEY_DOWN,
    GPU_EVENT_KIND_KEY_UP, GPU_EVENT_KIND_TEXT_INPUT, GPU_EVENT_KIND_TIMER,
    GPU_EVENT_KIND_HOST_EFFECT_COMPLETION,
    HOST_EFFECT_NONE, HOST_EFFECT_FETCH, HOST_EFFECT_FILE, HOST_EFFECT_CLIPBOARD,
    HOST_EFFECT_IME, HOST_EFFECT_ACCESSIBILITY_SNAPSHOT,
    GpuInputEvent, GpuMutation, GpuHostEffectRequest, GpuHostEffectCompletion,
    GpuResourcePacket,
    GpuInputPacketPort, GpuResourcePacketPort, GpuHostEffectRequestPort,
    GpuHostEffectCompletionPort, GpuSceneEpochPort
