# Runtime-independent scalar text projection for operational UI and WM
# identities. Theme hashing runs in the interpreter, native hosts, and
# freestanding preparation tools; depending on rt_raw_i64_to_string made the
# interpreter lane fail before it could compare package snapshots.

fn _ui_decimal_digit(value: i64) -> text:
    if value == 0: return "0"
    if value == 1: return "1"
    if value == 2: return "2"
    if value == 3: return "3"
    if value == 4: return "4"
    if value == 5: return "5"
    if value == 6: return "6"
    if value == 7: return "7"
    if value == 8: return "8"
    "9"

fn ui_native_i64_text(value: i64) -> text:
    if value == 0:
        return "0"
    # Negating the minimum signed value overflows; keep its canonical decimal
    # spelling explicit so hashing remains total across the full i64 domain.
    if value == -9223372036854775807 - 1:
        return "-9223372036854775808"
    var remaining = value
    var prefix = ""
    if remaining < 0:
        prefix = "-"
        remaining = 0 - remaining
    var digits = ""
    while remaining > 0:
        val digit = remaining - (remaining / 10) * 10
        digits = _ui_decimal_digit(digit) + digits
        remaining = remaining / 10
    prefix + digits
