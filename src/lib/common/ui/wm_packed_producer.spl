# wm_packed_producer.spl -- L8: UiPackedProducer adoption for the WM/shell
# compositor path: fail-closed background resolution + global menubar.
#
# Design authority: doc/05_design/ui/unified_packed_ui_scene.md sections 2.2, 6.
# Lane: L8, doc/03_plan/ui/unified_packed_ui_scene_agent_lanes.md.
#
# Adapts INTO the existing WM compositor
# (`shared_wm_scene_from_window_manager`, `shared_wm_scene_draw_ir_composition`,
# window_scene.spl/window_scene_draw_ir.spl) and the v2->v3 typed adapter
# (draw_ir_v2_to_v3.spl, lane L3) rather than re-deriving composition -- this
# lane does not edit any of them.
#
# BACKGROUND (gate d): `_wm_draw_ir_desktop_batch` only ever paints
# `scene.background.color` for kind=="color", else silently falls back to
# `theme.desktop_bg` for image/motion/unknown -- it never actually renders an
# image surface (no such path exists anywhere in the compositor today).
# # ponytail: no image-surface rendering added here; upgrade alongside a real
# compositor image path. Instead this lane calls the ALREADY-LANDED
# `shared_wm_scene_resolve_background` (fail-closed: unresolved/unsupported
# kinds return WM_BACKGROUND_UNRESOLVED_MARKER_COLOR, never a silent
# substitute) and patches its resolved `.color` onto the desktop command's
# own paint row after composition, so a failed resolution shows the loud
# marker regardless of what the compositor's own naive color check would
# have painted.
#
# MENUBAR (gates a/b): a FIXED-CAPACITY segment (`WM_MENUBAR_MAX_ITEMS`) is
# always emitted -- one GROUP command + exactly that many item RECT
# commands, real items from the active app's `AppMenuSnapshot` first,
# `visible:false` filler after (zero-size geometry, DRAW_IR_V3_FLAG_HIDDEN).
# This keeps every table's reserved count -- and therefore every OTHER
# producer's assigned range, and every non-menubar row within this
# producer's own range -- invariant across an `active_app_id` switch:
# switching apps only changes the CONTENTS of already-reserved menubar
# rows, never any range's size (design section 6: "focus switch patches
# only the menubar segment"). # ponytail: items render as solid rects, not
# shaped glyph text -- no font/glyph shaping wired here; upgrade alongside a
# real menu-bar renderer. # ponytail: WM_MENUBAR_MAX_ITEMS is a fixed
# ceiling, not a scrolling/overflow menubar -- upgrade if an app ever needs
# more items than fit.

use common.ui.window.{WindowManager}
use common.ui.window_surface_registry.{UiWindowSurfaceRegistry}
use common.ui.taskbar_model.{TaskbarModel}
use common.ui.window_scene.{
    BackgroundSpec,
    SharedWmWindow,
    shared_wm_scene_from_window_manager,
    shared_wm_scene_resolve_background,
    shared_wm_visible_windows
}
use common.ui.window_scene_draw_ir.{shared_wm_scene_draw_ir_composition}
use common.ui.draw_ir_v2_to_v3.{draw_ir_v2_to_v3}
use common.ui.draw_ir_v3.{
    DRAW_IR_V3_NO_ID,
    DRAW_IR_V3_KIND_GROUP,
    DRAW_IR_V3_KIND_RECT,
    DRAW_IR_V3_HIT_RECT,
    DRAW_IR_V3_FLAG_NONE,
    DRAW_IR_V3_FLAG_HIT_TESTABLE,
    DRAW_IR_V3_FLAG_HIDDEN,
    DrawIrV3Scene,
    DrawIrV3Command,
    DrawIrV3Geometry,
    DrawIrV3Paint,
    DrawIrV3PaintTable,
    DrawIrV3TextRun,
    DrawIrV3Glyph,
    DrawIrV3Resource,
    DrawIrV3PathSpan,
    DrawIrV3PathPoint,
    DrawIrV3Clip,
    DrawIrV3Transform,
    DrawIrV3HitShape,
    DrawIrV3Provenance
}
use common.ui.ui_scene_counts.{
    UiSceneCounts,
    UiSceneRanges,
    UiSceneOverflowReceipt,
    UI_PRODUCER_WM,
    UI_SCENE_TABLE_GEOMETRY,
    UI_SCENE_TABLE_PAINT,
    UI_SCENE_TABLE_HIT_SHAPES,
    UI_SCENE_OVERFLOW_DEFICIT,
    UI_SCENE_OVERFLOW_SURPLUS
}
use common.ui.ui_scene_owner_table.{UiOwnerRecord, MenuActionBinding, UI_SCENE_EVENT_POLICY_HIT_OPAQUE}
use common.ui.ui_scene_slice.{
    UiSceneSlice,
    UiSceneWriteVerdict,
    UiSceneEmitResult,
    DrawIrV3Writer,
    UiOwnerWriter,
    UiActionWriter,
    UiPackedProducer
}
use common.ui.app_menu_snapshot.{AppMenuSnapshot, app_menu_snapshot_blank}
use common.ui.app_menu_registry.{AppMenuRegistry}

val WM_MENUBAR_MAX_ITEMS: u32 = 12u32
val WM_MENUBAR_ITEM_WIDTH: i32 = 72
val WM_MENUBAR_ITEM_HEIGHT: i32 = 22
val WM_MENUBAR_ITEM_GAP: i32 = 4
val WM_MENUBAR_Y: i32 = 0
val WM_MENUBAR_BG_COLOR: u32 = 0xFF202020u32
val WM_MENUBAR_ITEM_COLOR: u32 = 0xFF3A3A3Au32

# Non-zero so a live owner record is trivially distinguishable from an
# unset/default one (design section 2.4 "live `semantic_generation`").
val WM_OWNER_GENERATION: u32 = 1u32

# See ui_gui_packed_producer.spl's `_gui_rebase_id` doc comment: table-row-
# index fields must be rebased to this producer's assigned
# `ranges.<table>.start` before being written; component_id/parent_id are
# identities, never rebased.
fn _wm_rebase_id(id: u32, start: u32) -> u32:
    if id == DRAW_IR_V3_NO_ID:
        DRAW_IR_V3_NO_ID
    else:
        id + start

struct WmPackedProducer:
    id_val: u32
    manager: WindowManager
    registry: UiWindowSurfaceRegistry
    taskbar: TaskbarModel
    width: i32
    height: i32
    background: BackgroundSpec
    menu_registry: AppMenuRegistry
    active_app_id: u32
    backend_target: text
    dpi_scale_milli: i32
    clock_label: text
    right_icon_count: i32

# `v3.commands[0]` is the "wm-desktop" batch's own GROUP wrapper -- every v2
# batch becomes one v3 GROUP command (draw_ir_v2_to_v3.spl's own header
# doc), and that GROUP's `paint_id` stays NO_ID because the desktop batch's
# embedding opacity is the default 1000 (`_v2v3_adapt_batch` only mints a
# paint row when opacity != 1000). The actual "desktop-background" RECT
# `_wm_draw_ir_desktop_batch` emits is that GROUP's sole child, immediately
# following it -- `v3.commands[1]`, verified by `parent_id == group_id`.
fn _wm_patch_background_color(v3: DrawIrV3Scene, color: u32) -> DrawIrV3Scene:
    if v3.commands.len() < 2:
        return v3
    val group_id = v3.commands[0].component_id
    if v3.commands[1].parent_id != group_id:
        return v3
    val paint_id = v3.commands[1].paint_id
    if paint_id == DRAW_IR_V3_NO_ID:
        return v3
    val idx = paint_id.to_i64()
    if idx < 0 or idx >= v3.paint.fill_colors.len().to_i64():
        return v3
    var fill_colors = v3.paint.fill_colors
    fill_colors[idx] = color
    DrawIrV3Scene(
        schema: v3.schema, schema_id: v3.schema_id, scene_id: v3.scene_id, generation: v3.generation,
        commands: v3.commands, geometry: v3.geometry,
        paint: DrawIrV3PaintTable(
            fill_colors: fill_colors, stroke_colors: v3.paint.stroke_colors,
            stroke_widths_milli: v3.paint.stroke_widths_milli, opacities_milli: v3.paint.opacities_milli,
            blend_modes: v3.paint.blend_modes
        ),
        text_runs: v3.text_runs, resources: v3.resources, path_points: v3.path_points, clips: v3.clips,
        transforms: v3.transforms, hit_shapes: v3.hit_shapes, provenance: v3.provenance
    )

struct WmPackedScene:
    v3: DrawIrV3Scene
    visible_windows: [SharedWmWindow]

fn _wm_build_scene(p: WmPackedProducer) -> WmPackedScene:
    var scene = shared_wm_scene_from_window_manager(p.manager, p.registry, p.width, p.height)
    scene.background = p.background
    val composition = shared_wm_scene_draw_ir_composition(scene, p.taskbar, p.backend_target, p.dpi_scale_milli, p.clock_label, p.right_icon_count)
    val v3_raw = draw_ir_v2_to_v3(composition)
    val resolution = shared_wm_scene_resolve_background(p.background, p.width, p.height, 0i64)
    val v3 = _wm_patch_background_color(v3_raw, resolution.color)
    WmPackedScene(v3: v3, visible_windows: shared_wm_visible_windows(scene))

# One owner record per visible window represents that window as a semantic
# node in its own right -- the anchor a nested GUI producer's `host_owner_id`
# points at (design section 4.1/research section 7 nested-WebView-chain
# hierarchy: ... -> GUI window-content root -> WM window). No corresponding
# hit_shape/command: not every ownership node needs to be independently
# clickable (mirrors L9's own owner-chain fixture ancestors). Chosen right
# after the menubar's own component-id range so it can never collide with
# an existing v3 command's component_id or the menubar group/items.
fn _wm_window_owner_base(v3: DrawIrV3Scene) -> u32:
    v3.commands.len().to_u32() + 1u32 + WM_MENUBAR_MAX_ITEMS

# Deterministic query for an assembler/test that needs to learn which
# semantic_id this producer will assign to visible window `window_index`
# (0-based, in `shared_wm_visible_windows` order) -- read the owner record
# back by this value rather than guessing the write-order arithmetic
# directly (see ui_scene_event_route.spl's own doc on cross-producer
# wiring).
fn wm_packed_producer_window_owner_semantic_id(p: WmPackedProducer, window_index: u32) -> u32:
    _wm_window_owner_base(_wm_build_scene(p).v3) + window_index

fn _wm_active_menu_snapshot(p: WmPackedProducer) -> AppMenuSnapshot:
    if val s = p.menu_registry.lookup(p.active_app_id):
        s
    else:
        app_menu_snapshot_blank()

struct WmMenubarItem:
    x: i32
    visible: bool
    action_id: u32
    default_target_owner_id: u32

# Fixed-length output (always WM_MENUBAR_MAX_ITEMS entries): real items from
# `snapshot` first, `visible:false` filler after -- see module doc, gate b.
fn _wm_menubar_items(snapshot: AppMenuSnapshot, registry: AppMenuRegistry) -> [WmMenubarItem]:
    var out: [WmMenubarItem] = []
    var i = 0u32
    var x = WM_MENUBAR_ITEM_GAP
    while i < WM_MENUBAR_MAX_ITEMS:
        if i < snapshot.item_count:
            val item = registry.item_at(snapshot.item_start + i)
            val action = registry.action_at(snapshot.action_start + i)
            out.push(WmMenubarItem(x: x, visible: true, action_id: item.action_id, default_target_owner_id: action.default_target_owner_id))
        else:
            out.push(WmMenubarItem(x: x, visible: false, action_id: DRAW_IR_V3_NO_ID, default_target_owner_id: DRAW_IR_V3_NO_ID))
        x = x + WM_MENUBAR_ITEM_WIDTH + WM_MENUBAR_ITEM_GAP
        i = i + 1u32
    out

fn _wm_counts_of(scene: WmPackedScene) -> UiSceneCounts:
    val v3 = scene.v3
    val n_wm_hit = v3.hit_shapes.xs.len().to_u32()
    val n_windows = scene.visible_windows.len().to_u32()
    UiSceneCounts(
        commands: v3.commands.len().to_u32() + 1u32 + WM_MENUBAR_MAX_ITEMS,
        geometry: v3.geometry.xs.len().to_u32() + 1u32 + WM_MENUBAR_MAX_ITEMS,
        paint: v3.paint.fill_colors.len().to_u32() + 1u32 + WM_MENUBAR_MAX_ITEMS,
        text_runs: v3.text_runs.run_glyph_starts.len().to_u32(),
        glyphs: v3.text_runs.glyph_ids.len().to_u32(),
        resources: v3.resources.kinds.len().to_u32(),
        path_spans: v3.path_points.span_point_starts.len().to_u32(),
        path_points: v3.path_points.point_xs.len().to_u32(),
        clips: v3.clips.xs.len().to_u32(),
        transforms: v3.transforms.m11s.len().to_u32(),
        hit_shapes: n_wm_hit + WM_MENUBAR_MAX_ITEMS,
        provenance_edges: v3.provenance.command_indices.len().to_u32(),
        owner_records: n_wm_hit + WM_MENUBAR_MAX_ITEMS + n_windows,
        action_bindings: WM_MENUBAR_MAX_ITEMS,
        prepared_batches: 0u32,
        dirty_ranges: 0u32
    )

fn _wm_verdict_is_exact(v: UiSceneWriteVerdict) -> bool:
    match v:
        UiSceneWriteVerdict.Exact:
            true
        UiSceneWriteVerdict.Deficit(table_id, n):
            false
        UiSceneWriteVerdict.Surplus(table_id, n):
            false

fn _wm_overflow_receipt(v: UiSceneWriteVerdict, producer_kind: u16, producer_id: u32, snapshot_id: u64) -> UiSceneOverflowReceipt:
    match v:
        UiSceneWriteVerdict.Deficit(table_id, n):
            UiSceneOverflowReceipt(
                table_id: table_id, kind: UI_SCENE_OVERFLOW_DEFICIT, required: n, capacity: 0u32,
                producer_kind: producer_kind, producer_id: producer_id, snapshot_id: snapshot_id
            )
        UiSceneWriteVerdict.Surplus(table_id, n):
            UiSceneOverflowReceipt(
                table_id: table_id, kind: UI_SCENE_OVERFLOW_SURPLUS, required: n, capacity: 0u32,
                producer_kind: producer_kind, producer_id: producer_id, snapshot_id: snapshot_id
            )
        UiSceneWriteVerdict.Exact:
            UiSceneOverflowReceipt(
                table_id: 0u16, kind: UI_SCENE_OVERFLOW_DEFICIT, required: 0u32, capacity: 0u32,
                producer_kind: producer_kind, producer_id: producer_id, snapshot_id: snapshot_id
            )

fn _wm_write_scene(scene: WmPackedScene, snapshot: AppMenuSnapshot, menubar_items: [WmMenubarItem], width: i32, ranges: UiSceneRanges, draw: DrawIrV3Writer, owners: UiOwnerWriter, actions: UiActionWriter):
    val v3 = scene.v3
    var i = 0
    while i < v3.commands.len():
        val c = v3.commands[i]
        draw.put_command(DrawIrV3Command(
            kind: c.kind, flags: c.flags,
            component_id: c.component_id, component_generation: c.component_generation, parent_id: c.parent_id,
            geometry_id: _wm_rebase_id(c.geometry_id, ranges.geometry.start),
            paint_id: _wm_rebase_id(c.paint_id, ranges.paint.start),
            text_run_id: _wm_rebase_id(c.text_run_id, ranges.text_runs.start),
            image_resource_id: _wm_rebase_id(c.image_resource_id, ranges.resources.start),
            path_span_id: _wm_rebase_id(c.path_span_id, ranges.path_spans.start),
            clip_id: _wm_rebase_id(c.clip_id, ranges.clips.start),
            transform_id: _wm_rebase_id(c.transform_id, ranges.transforms.start),
            hit_shape_id: _wm_rebase_id(c.hit_shape_id, ranges.hit_shapes.start)
        ))
        i = i + 1

    i = 0
    while i < v3.geometry.xs.len():
        draw.put_geometry(DrawIrV3Geometry(
            present: true, x: v3.geometry.xs[i], y: v3.geometry.ys[i],
            width: v3.geometry.widths[i], height: v3.geometry.heights[i],
            corner_radius: v3.geometry.corner_radii[i]
        ))
        i = i + 1

    i = 0
    while i < v3.paint.fill_colors.len():
        draw.put_paint(DrawIrV3Paint(
            present: true, fill_color: v3.paint.fill_colors[i],
            stroke_color: v3.paint.stroke_colors[i],
            stroke_width_milli: v3.paint.stroke_widths_milli[i],
            opacity_milli: v3.paint.opacities_milli[i],
            blend_mode: v3.paint.blend_modes[i]
        ))
        i = i + 1

    i = 0
    while i < v3.text_runs.run_glyph_starts.len():
        draw.put_text_run(DrawIrV3TextRun(
            present: true, glyph_start: _wm_rebase_id(v3.text_runs.run_glyph_starts[i], ranges.glyphs.start),
            glyph_count: v3.text_runs.run_glyph_counts[i],
            font_resource_id: v3.text_runs.run_font_resource_ids[i],
            font_size_milli: v3.text_runs.run_font_sizes_milli[i],
            baseline_x: v3.text_runs.run_baseline_xs[i],
            baseline_y: v3.text_runs.run_baseline_ys[i],
            color: v3.text_runs.run_colors[i]
        ))
        i = i + 1

    i = 0
    while i < v3.text_runs.glyph_ids.len():
        draw.put_glyph(DrawIrV3Glyph(
            present: true, glyph_id: v3.text_runs.glyph_ids[i],
            x: v3.text_runs.glyph_xs[i], y: v3.text_runs.glyph_ys[i],
            cluster: v3.text_runs.glyph_clusters[i]
        ))
        i = i + 1

    i = 0
    while i < v3.resources.kinds.len():
        draw.put_resource(DrawIrV3Resource(
            present: true, kind: v3.resources.kinds[i], format: v3.resources.formats[i],
            width: v3.resources.widths[i], height: v3.resources.heights[i],
            content_hash: v3.resources.content_hashes[i]
        ))
        i = i + 1

    i = 0
    while i < v3.path_points.span_point_starts.len():
        draw.put_path_span(DrawIrV3PathSpan(
            present: true, point_start: _wm_rebase_id(v3.path_points.span_point_starts[i], ranges.path_points.start),
            point_count: v3.path_points.span_point_counts[i],
            fill_rule: v3.path_points.span_fill_rules[i]
        ))
        i = i + 1

    i = 0
    while i < v3.path_points.point_xs.len():
        draw.put_path_point(DrawIrV3PathPoint(
            present: true, x: v3.path_points.point_xs[i], y: v3.path_points.point_ys[i],
            verb: v3.path_points.point_verbs[i]
        ))
        i = i + 1

    i = 0
    while i < v3.clips.xs.len():
        draw.put_clip(DrawIrV3Clip(
            present: true, x: v3.clips.xs[i], y: v3.clips.ys[i],
            width: v3.clips.widths[i], height: v3.clips.heights[i],
            corner_radius: v3.clips.corner_radii[i], parent_id: _wm_rebase_id(v3.clips.parent_ids[i], ranges.clips.start)
        ))
        i = i + 1

    i = 0
    while i < v3.transforms.m11s.len():
        draw.put_transform(DrawIrV3Transform(
            present: true, m11: v3.transforms.m11s[i], m12: v3.transforms.m12s[i],
            m21: v3.transforms.m21s[i], m22: v3.transforms.m22s[i],
            dx: v3.transforms.dxs[i], dy: v3.transforms.dys[i]
        ))
        i = i + 1

    # Every existing WM hit-shape row gets exactly one owner record
    # (symmetric with L7's rule: the oracle, not this lane, decides what's
    # hit-testable for the compositor's own commands). These commands are
    # copied through verbatim above (line ~289, component_generation
    # preserved), and draw_ir_v2_to_v3 sets component_generation: 0u32
    # unconditionally -- so the owner must use 0u32 too, not
    # WM_OWNER_GENERATION, or L9's recycled-slot check never matches.
    i = 0
    while i < v3.hit_shapes.xs.len():
        val comp_id = v3.hit_shapes.component_ids[i]
        draw.put_hit_shape(DrawIrV3HitShape(
            present: true, x: v3.hit_shapes.xs[i], y: v3.hit_shapes.ys[i],
            width: v3.hit_shapes.widths[i], height: v3.hit_shapes.heights[i],
            shape_kind: v3.hit_shapes.shape_kinds[i], hit_flags: v3.hit_shapes.hit_flags[i],
            component_id: comp_id,
            z_index: v3.hit_shapes.z_indices[i], enabled: v3.hit_shapes.enableds[i],
            pointer_policy: v3.hit_shapes.pointer_policies[i]
        ))
        owners.put_owner_record(UiOwnerRecord(
            producer_kind: UI_PRODUCER_WM, event_policy: UI_SCENE_EVENT_POLICY_HIT_OPAQUE,
            semantic_id: comp_id, semantic_generation: 0u32,
            parent_owner_id: DRAW_IR_V3_NO_ID, action_binding_id: DRAW_IR_V3_NO_ID
        ))
        i = i + 1

    i = 0
    while i < v3.provenance.command_indices.len():
        draw.put_provenance(DrawIrV3Provenance(
            present: true, command_index: _wm_rebase_id(v3.provenance.command_indices[i], ranges.commands.start),
            edge_kind: v3.provenance.edge_kinds[i],
            source_node_id: v3.provenance.source_node_ids[i],
            source_rule_id: v3.provenance.source_rule_ids[i],
            source_span_start: v3.provenance.source_span_starts[i],
            source_span_len: v3.provenance.source_span_lens[i]
        ))
        i = i + 1

    # Global menubar segment: one GROUP + WM_MENUBAR_MAX_ITEMS item RECTs,
    # contiguous in `commands` so draw_ir_v3_group_resolve.spl's parent_id-
    # chain walk sees a contiguous descendant range (module doc, gates a/b).
    # Unlike L6/L7's oracle-copied hit_shapes, these are cross-referenced
    # properly from the start: each item command's `hit_shape_id` points at
    # its own hit_shape row, whose `component_id` matches the command's own
    # `component_id` -- closing the gap L6/L7 left open for L9 to solve.
    val group_component_id = v3.commands.len().to_u32()

    val group_geometry_id = ranges.geometry.start + draw.cursor(UI_SCENE_TABLE_GEOMETRY)
    draw.put_geometry(DrawIrV3Geometry(present: true, x: 0, y: WM_MENUBAR_Y, width: width, height: WM_MENUBAR_ITEM_HEIGHT, corner_radius: 0))
    val group_paint_id = ranges.paint.start + draw.cursor(UI_SCENE_TABLE_PAINT)
    draw.put_paint(DrawIrV3Paint(present: true, fill_color: WM_MENUBAR_BG_COLOR, stroke_color: 0u32, stroke_width_milli: 0, opacity_milli: 1000, blend_mode: 0u16))
    draw.put_command(DrawIrV3Command(
        kind: DRAW_IR_V3_KIND_GROUP, flags: DRAW_IR_V3_FLAG_NONE,
        component_id: group_component_id, component_generation: 0u32, parent_id: DRAW_IR_V3_NO_ID,
        geometry_id: group_geometry_id, paint_id: group_paint_id,
        text_run_id: DRAW_IR_V3_NO_ID, image_resource_id: DRAW_IR_V3_NO_ID, path_span_id: DRAW_IR_V3_NO_ID,
        clip_id: DRAW_IR_V3_NO_ID, transform_id: DRAW_IR_V3_NO_ID, hit_shape_id: DRAW_IR_V3_NO_ID
    ))

    var ii = 0
    while ii < menubar_items.len():
        val item = menubar_items[ii]
        val item_component_id = group_component_id + 1u32 + ii.to_u32()
        val item_w = if item.visible: WM_MENUBAR_ITEM_WIDTH else: 0
        val item_h = if item.visible: WM_MENUBAR_ITEM_HEIGHT else: 0

        val item_geometry_id = ranges.geometry.start + draw.cursor(UI_SCENE_TABLE_GEOMETRY)
        draw.put_geometry(DrawIrV3Geometry(present: true, x: item.x, y: WM_MENUBAR_Y, width: item_w, height: item_h, corner_radius: 0))

        val item_paint_id = ranges.paint.start + draw.cursor(UI_SCENE_TABLE_PAINT)
        draw.put_paint(DrawIrV3Paint(present: true, fill_color: WM_MENUBAR_ITEM_COLOR, stroke_color: 0u32, stroke_width_milli: 0, opacity_milli: 1000, blend_mode: 0u16))

        val item_hit_shape_id = ranges.hit_shapes.start + draw.cursor(UI_SCENE_TABLE_HIT_SHAPES)
        draw.put_hit_shape(DrawIrV3HitShape(
            present: true, x: item.x, y: WM_MENUBAR_Y, width: item_w, height: item_h,
            shape_kind: DRAW_IR_V3_HIT_RECT, hit_flags: 0u16, component_id: item_component_id,
            z_index: 0, enabled: true, pointer_policy: 0u16
        ))

        # Minted content: this lane owns both the command and the owner
        # record at this one write site, so both must carry the SAME
        # generation (WM_OWNER_GENERATION) for L9's recycled-slot check to
        # match -- unlike the copied hit-shapes above, whose command
        # generation comes from the oracle (always 0u32) and can't be
        # chosen here.
        val item_flags = if item.visible: DRAW_IR_V3_FLAG_HIT_TESTABLE else: DRAW_IR_V3_FLAG_HIDDEN
        draw.put_command(DrawIrV3Command(
            kind: DRAW_IR_V3_KIND_RECT, flags: item_flags,
            component_id: item_component_id, component_generation: WM_OWNER_GENERATION, parent_id: group_component_id,
            geometry_id: item_geometry_id, paint_id: item_paint_id,
            text_run_id: DRAW_IR_V3_NO_ID, image_resource_id: DRAW_IR_V3_NO_ID, path_span_id: DRAW_IR_V3_NO_ID,
            clip_id: DRAW_IR_V3_NO_ID, transform_id: DRAW_IR_V3_NO_ID, hit_shape_id: item_hit_shape_id
        ))

        val action_binding_id = ranges.action_bindings.start + actions.cursor()
        actions.put_action_binding(MenuActionBinding(
            app_id: snapshot.app_id, app_generation: snapshot.app_generation, menu_revision: snapshot.menu_revision,
            action_id: item.action_id, default_target_owner_id: item.default_target_owner_id
        ))

        owners.put_owner_record(UiOwnerRecord(
            producer_kind: UI_PRODUCER_WM, event_policy: UI_SCENE_EVENT_POLICY_HIT_OPAQUE,
            semantic_id: item_component_id, semantic_generation: WM_OWNER_GENERATION,
            parent_owner_id: DRAW_IR_V3_NO_ID, action_binding_id: action_binding_id
        ))
        ii = ii + 1

    # One owner record per visible window (see _wm_window_owner_base's doc):
    # the anchor a nested GUI producer's `host_owner_id` points at.
    val window_owner_base = _wm_window_owner_base(v3)
    var wi = 0
    while wi < scene.visible_windows.len():
        owners.put_owner_record(UiOwnerRecord(
            producer_kind: UI_PRODUCER_WM, event_policy: UI_SCENE_EVENT_POLICY_HIT_OPAQUE,
            semantic_id: window_owner_base + wi.to_u32(), semantic_generation: WM_OWNER_GENERATION,
            parent_owner_id: DRAW_IR_V3_NO_ID, action_binding_id: DRAW_IR_V3_NO_ID
        ))
        wi = wi + 1

impl UiPackedProducer for WmPackedProducer:
    me producer_kind() -> u16:
        UI_PRODUCER_WM

    me producer_id() -> u32:
        self.id_val

    me count(snapshot_id: u64, counts: UiSceneCounts) -> UiSceneCounts:
        _wm_counts_of(_wm_build_scene(self))

    me emit(
        snapshot_id: u64, ranges: UiSceneRanges,
        draw: DrawIrV3Writer, owners: UiOwnerWriter, actions: UiActionWriter
    ) -> UiSceneEmitResult:
        val scene = _wm_build_scene(self)
        val snapshot = _wm_active_menu_snapshot(self)
        val menubar_items = _wm_menubar_items(snapshot, self.menu_registry)
        _wm_write_scene(scene, snapshot, menubar_items, self.width, ranges, draw, owners, actions)

        val draw_verdict = draw.finish()
        if not _wm_verdict_is_exact(draw_verdict):
            return UiSceneEmitResult.Refused(_wm_overflow_receipt(draw_verdict, self.producer_kind(), self.id_val, snapshot_id))

        val owner_verdict = owners.finish()
        if not _wm_verdict_is_exact(owner_verdict):
            return UiSceneEmitResult.Refused(_wm_overflow_receipt(owner_verdict, self.producer_kind(), self.id_val, snapshot_id))

        val action_verdict = actions.finish()
        if not _wm_verdict_is_exact(action_verdict):
            return UiSceneEmitResult.Refused(_wm_overflow_receipt(action_verdict, self.producer_kind(), self.id_val, snapshot_id))

        UiSceneEmitResult.Emitted(UiSceneSlice(
            scene_slot: self.id_val, scene_generation: 1u32,
            root_component_id: DRAW_IR_V3_NO_ID, ranges: ranges
        ))

export WmPackedProducer, WM_MENUBAR_MAX_ITEMS, wm_packed_producer_window_owner_semantic_id
