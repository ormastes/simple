# Pure evidence classification shared by host probes and tests.

fn _host_env_json_text(value: text) -> text:
    val escaped_slashes = value.replace("\\", "\\\\")
    val escaped_quotes = escaped_slashes.replace("\"", "\\\"")
    val escaped_newlines = escaped_quotes.replace("\n", "\\n")
    "\"{escaped_newlines}\""

fn _host_evidence_value_matches(evidence: text, key: text, expected: text) -> bool:
    val prefix = key + "="
    var found = false
    for line in evidence.replace("\r\n", "\n").split("\n"):
        if line.starts_with(prefix):
            if found:
                return false
            if expected == "":
                if line == prefix:
                    return false
            elif line != prefix + expected:
                return false
            found = true
    found

fn host_readback_evidence_passes(evidence: text) -> bool:
    _host_evidence_value_matches(evidence, "linux_hosted_wm_live_window_input_readback_source", "device_readback") and
        _host_evidence_value_matches(evidence, "linux_hosted_wm_live_window_framebuffer_status", "pass") and
        _host_evidence_value_matches(evidence, "linux_hosted_wm_live_window_glyph_crop_live_match", "true")

fn host_vulkan_evidence_passes(evidence: text) -> bool:
    _host_evidence_value_matches(evidence, "vulkan_engine2d_readback_status", "pass") and
        _host_evidence_value_matches(evidence, "vulkan_engine2d_readback_clear_source", "device_readback") and
        _host_evidence_value_matches(evidence, "vulkan_engine2d_readback_rect_source", "device_readback")

fn host_renderdoc_evidence_passes(evidence: text) -> bool:
    _host_evidence_value_matches(evidence, "rdoc_simple_gate_status", "pass") and
        _host_evidence_value_matches(evidence, "rdoc_simple_gate_capture_file_magic", "RDOC")

fn host_display_input_evidence_passes(evidence: text) -> bool:
    _host_evidence_value_matches(evidence, "linux_hosted_wm_live_window_event_origin", "screen") and
        _host_evidence_value_matches(evidence, "linux_hosted_wm_live_window_semantic_target_id", "") and
        _host_evidence_value_matches(evidence, "linux_hosted_wm_live_window_mutation_revision", "1")

struct HostCapabilityRow:
    name: text
    status: text
    reason: text
    evidence_path: text
    resume_command: text

    static fn create(name: text, status: text, reason: text, evidence_path: text, resume_command: text) -> HostCapabilityRow:
        HostCapabilityRow(
            name: name,
            status: status,
            reason: reason,
            evidence_path: evidence_path,
            resume_command: resume_command
        )

    fn validation_reason() -> text:
        if self.status != "pass" and self.status != "blocked" and self.status != "fail":
            return "invalid-status"
        if self.evidence_path == "":
            return "missing-evidence-path"
        if self.status == "pass" and self.reason != "":
            return "pass-has-reason"
        if self.status != "pass" and self.reason == "":
            return "{self.status}-without-reason"
        if self.status == "blocked" and self.resume_command == "":
            return "blocked-without-resume-command"
        ""

    fn to_json() -> text:
        "{\"name\":{_host_env_json_text(self.name)},\"status\":{_host_env_json_text(self.status)},\"reason\":{_host_env_json_text(self.reason)},\"evidence_path\":{_host_env_json_text(self.evidence_path)},\"resume_command\":{_host_env_json_text(self.resume_command)}}"

struct TestHostEnv:
    rows: [HostCapabilityRow]

    static fn create(rows: [HostCapabilityRow]) -> TestHostEnv:
        TestHostEnv(rows: rows)

    fn with_row(row: HostCapabilityRow) -> TestHostEnv:
        var rows = self.rows
        rows.push(row)
        TestHostEnv(rows: rows)

    fn validation_reason() -> text:
        val required = [
            "x86_simd",
            "arm_simd",
            "riscv_simd",
            "vulkan",
            "renderdoc",
            "display_input",
            "framebuffer_readback"
        ]
        var seen: [text] = []
        for row in self.rows:
            var known = false
            for name in required:
                if row.name == name:
                    known = true
            if not known:
                return "unknown-{row.name}"
            for name in seen:
                if row.name == name:
                    return "duplicate-{row.name}"
            val reason = row.validation_reason()
            if reason != "":
                return "{row.name}-{reason}"
            seen.push(row.name)
        for name in required:
            var found = false
            for row in self.rows:
                if row.name == name:
                    found = true
            if not found:
                return "missing-{name}"
        ""

    fn to_json() -> text:
        var rows_json = ""
        var i = 0
        while i < self.rows.len():
            if i > 0:
                rows_json = rows_json + ","
            rows_json = rows_json + self.rows[i].to_json()
            i = i + 1
        "{\"schema\":\"simple-test-host-env-v1\",\"validation_reason\":{_host_env_json_text(self.validation_reason())},\"rows\":[{rows_json}]}"

struct RenderPipelineReceipt:
    event_id: i64
    frame_id: i64
    mutation_revision: i64
    backend: text
    backend_handle: i64
    completed: bool
    readback_source: text
    width: i32
    height: i32
    stride: i32
    format: text
    checksum: i64
    nonblank_pixels: i64
    fallback_used: bool

    static fn create(event_id: i64, frame_id: i64, mutation_revision: i64, backend: text, backend_handle: i64, completed: bool, readback_source: text, width: i32, height: i32, stride: i32, format: text, checksum: i64, nonblank_pixels: i64, fallback_used: bool) -> RenderPipelineReceipt:
        RenderPipelineReceipt(
            event_id: event_id,
            frame_id: frame_id,
            mutation_revision: mutation_revision,
            backend: backend,
            backend_handle: backend_handle,
            completed: completed,
            readback_source: readback_source,
            width: width,
            height: height,
            stride: stride,
            format: format,
            checksum: checksum,
            nonblank_pixels: nonblank_pixels,
            fallback_used: fallback_used
        )

    fn validation_reason() -> text:
        if self.event_id <= 0:
            return "missing-event-id"
        if self.frame_id != self.event_id:
            return "event-frame-mismatch"
        if self.mutation_revision <= 0:
            return "missing-mutation-revision"
        if self.fallback_used:
            return "fallback-used"
        if self.backend != "vulkan":
            return "not-vulkan-backend"
        if self.backend_handle <= 0:
            return "missing-backend-handle"
        if not self.completed:
            return "submission-incomplete"
        if self.readback_source != "device_readback":
            return "not-device-readback"
        if self.width <= 0 or self.height <= 0:
            return "invalid-dimensions"
        if self.stride != self.width * 4:
            return "invalid-stride"
        if self.format != "argb8888":
            return "invalid-format"
        if self.checksum == 0:
            return "missing-checksum"
        if self.nonblank_pixels <= 0:
            return "blank-frame"
        ""
