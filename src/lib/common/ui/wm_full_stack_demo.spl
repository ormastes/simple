# One deterministic widget tree shared by headless and hosted WM lanes.

use common.ui.builder.{
    build_tree_with_title,
    button,
    column,
    image,
    label,
    scroll,
    text_field,
    with_height,
}
use common.ui.render_surface_widget.{
    RENDER_SURFACE_FIT_STRETCH,
    render_surface,
    render_surface_pointer_target,
}
use common.ui.layout.{compute_layout, find_rect}
use common.ui.widget.{UITree, WidgetNode}

# Local literal mirrors of common.io.window_event's scalar event-kind/action
# constants. Inlined instead of imported: this file was the ONLY WM-lane
# consumer of that module, and importing a `common.io.*` submodule trips
# WML001 (src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl)
# even though window_event.spl itself has zero host/extern calls -- it is
# pure scalar data, flagged only because of its directory name. Values must
# stay in sync with src/lib/common/io/window_event.spl by inspection.
val _WM_DEMO_WINDOW_EVENT_POINTER_MOVE: i64 = 6
val _WM_DEMO_WINDOW_EVENT_POINTER_BUTTON: i64 = 7
val _WM_DEMO_WINDOW_ACTION_PRESS: i64 = 1

val WM_FULL_STACK_DEMO_APP_ID: text = "org.simple.wm-full-stack-demo"
val WM_FULL_STACK_DEMO_IMAGE_URI: text = "wm-demo://image"
val WM_FULL_STACK_DEMO_2D_HANDLE: i64 = 101
val WM_FULL_STACK_DEMO_WEB_HANDLE: i64 = 102

class WmDemo2dState:
    rect_x: i32
    rect_y: i32
    dragging: bool
    drag_offset_x: i32
    drag_offset_y: i32

impl WmDemo2dState:
    static fn new() -> WmDemo2dState:
        WmDemo2dState(
            rect_x: 24,
            rect_y: 24,
            dragging: false,
            drag_offset_x: 0,
            drag_offset_y: 0
        )

    me pointer(kind: text, x: i32, y: i32) -> bool:
        if kind == "down":
            if (x >= self.rect_x and x < self.rect_x + 48 and
                y >= self.rect_y and y < self.rect_y + 28):
                self.dragging = true
                self.drag_offset_x = x - self.rect_x
                self.drag_offset_y = y - self.rect_y
                return true
            return false
        if kind == "up":
            val was_dragging = self.dragging
            self.dragging = false
            return was_dragging
        if kind == "move" and self.dragging:
            var next_x = x - self.drag_offset_x
            var next_y = y - self.drag_offset_y
            if next_x < 0:
                next_x = 0
            if next_y < 0:
                next_y = 0
            if next_x > 240 - 48:
                next_x = 240 - 48
            if next_y > 90 - 28:
                next_y = 90 - 28
            self.rect_x = next_x
            self.rect_y = next_y
            return true
        false

    me route_widget_pointer(
        root: WidgetNode,
        width: i32,
        height: i32,
        event_kind: i64,
        button: i64,
        action: i64,
        routed_client: bool,
        x: i32,
        y: i32,
    ) -> bool:
        if event_kind == _WM_DEMO_WINDOW_EVENT_POINTER_BUTTON:
            if button != 0:
                return false
            if action == _WM_DEMO_WINDOW_ACTION_PRESS:
                if self.dragging:
                    self.pointer("up", 0, 0)
                if not routed_client:
                    return false
                val target = render_surface_pointer_target(
                    root, width, height, "demo-surface-2d", x, y
                )
                if target.found:
                    return self.pointer(
                        "down", target.local_x, target.local_y
                    )
                return false
            return self.pointer("up", 0, 0)
        if (event_kind != _WM_DEMO_WINDOW_EVENT_POINTER_MOVE or
            not routed_client or not self.dragging):
            return false
        val target = render_surface_pointer_target(
            root, width, height, "demo-surface-2d", x, y
        )
        if target.found:
            return self.pointer("move", target.local_x, target.local_y)
        if val rect = find_rect(
            compute_layout(root, 0, 0, width, height),
            "demo-surface-2d"
        ):
            if rect.w > 0 and rect.h > 0:
                return self.pointer(
                    "move",
                    (x - rect.x) * 240 / rect.w,
                    (y - rect.y) * 90 / rect.h
                )
        false

    fn pixels(width: i32, height: i32) -> [u32]:
        var out: [u32] = []
        val rx = self.rect_x * width / 240
        val ry = self.rect_y * height / 90
        val rw = 48 * width / 240
        val rh = 28 * height / 90
        var y = 0
        while y < height:
            var x = 0
            while x < width:
                val inside = (
                    x >= rx and x < rx + rw and
                    y >= ry and y < ry + rh
                )
                out.push(if inside: 0xffffa000u32 else: 0xff15304au32)
                x = x + 1
            y = y + 1
        out

fn _demo_h(node: WidgetNode, height: i32) -> WidgetNode:
    with_height(node, height)

fn wm_full_stack_demo_tree(
    status: text, button_label: text, text_value: text
) -> UITree:
    val rows: [WidgetNode] = [
        _demo_h(label("demo-scroll-1", "Scrollable row one"), 24),
        _demo_h(label("demo-scroll-2", "Scrollable row two"), 24),
        _demo_h(label("demo-scroll-3", "Scrollable row three"), 24),
        _demo_h(label("demo-scroll-4", "Scrollable row four"), 24),
        _demo_h(label("demo-scroll-5", "Scrollable row five"), 24),
    ]
    var surface_2d = render_surface(
        "demo-surface-2d", WM_FULL_STACK_DEMO_2D_HANDLE,
        240, 90, RENDER_SURFACE_FIT_STRETCH
    )
    surface_2d = surface_2d.set_prop("capture_pointer", "true")
    val surface_web = render_surface(
        "demo-surface-web", WM_FULL_STACK_DEMO_WEB_HANDLE,
        240, 90, RENDER_SURFACE_FIT_STRETCH
    )
    val root = column("demo-root", [
        _demo_h(label("demo-static-text", "Simple Full Stack WM"), 24),
        _demo_h(image(
            "demo-image", WM_FULL_STACK_DEMO_IMAGE_URI, "Simple color image"
        ), 36),
        _demo_h(text_field(
            "demo-text-field", text_value, "Type Simple123"
        ), 30),
        _demo_h(button(
            "demo-button", button_label, "wm-demo.click"
        ), 32),
        scroll("demo-scroll", 72, rows),
        _demo_h(surface_2d, 90),
        _demo_h(surface_web, 90),
        _demo_h(label("demo-status", status), 24),
    ])
    build_tree_with_title(root, "Full Stack WM Demo", "glass-dark")
