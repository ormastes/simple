# GPU Event Core — W2 CPU-reference interpreter for the GPU event model.
#
# Contract source (frozen; ordering rules are authoritative):
#   doc/03_plan/ui/gpu_web_scene_offload_mdsoc_plus_plan.md
#     §3 "GPU event model" (deterministic order: event sequence -> capture/
#     target/bubble phase -> route position -> listener registration order
#     -> mutation sequence inside the listener), §11 "W2 -- GPU event core"
#     (acceptance: event route equals current CPU event semantics; stale
#     generation never mutates state; same event batch produces
#     deterministic mutation bytes over 1,000 repetitions).
#
# This file is the CPU reference: pure Simple, no FFI, no Dict (native
# codegen's Dict is broken -- see .claude/rules/code-style.md), lists and
# plain nested loops only. A device-resident W2 implementation may later
# live under src/lib/nogc_async_mut/gpu/engine2d/gpu_event/ and must match
# this reference's route/dispatch/journal ordering exactly.

use common.ui.gpu_web_ports.{
    GpuInputEvent, GpuMutation,
    GPU_EVENT_KIND_POINTER_MOVE, GPU_EVENT_KIND_WHEEL
}

# ---------------------------------------------------------------------------
# Listener table and route records
# ---------------------------------------------------------------------------

# phase: 0 = capture, 1 = target, 2 = bubble
pub val GPU_EVENT_PHASE_CAPTURE: u16 = 0u16
pub val GPU_EVENT_PHASE_TARGET: u16 = 1u16
pub val GPU_EVENT_PHASE_BUBBLE: u16 = 2u16

# Guard against a corrupt/cyclic parent-id array when walking to the root.
pub val GPU_EVENT_MAX_ROUTE_DEPTH: i64 = 256

struct GpuEventListener:
    node_id: u32
    phase: u16
    registration_order: u32
    handler_id: u32

struct GpuEventRouteStep:
    node_id: u32
    phase: u16
    listener_handler_id: u32

# ---------------------------------------------------------------------------
# Stale-event rejection (plan §3 step 1)
# ---------------------------------------------------------------------------

fn gpu_event_validate_generation(ev: GpuInputEvent, current_generation: u64) -> bool:
    """A stale event (scene_generation != current) must never mutate state."""
    ev.scene_generation == current_generation

# ---------------------------------------------------------------------------
# Coalescing (plan §3 step 2)
# ---------------------------------------------------------------------------

fn gpu_event_coalesce(events: [GpuInputEvent]) -> [GpuInputEvent]:
    """Merge consecutive runs of POINTER_MOVE (keep last position) and WHEEL
    (sum delta_x_fixed/delta_y_fixed, keep last position/timestamp). Every
    other kind passes through unchanged. Relative order is preserved."""
    var result: [GpuInputEvent] = []
    var i: i64 = 0
    val n: i64 = events.len()
    while i < n:
        val cur = events[i]
        if cur.kind == GPU_EVENT_KIND_POINTER_MOVE:
            var last = cur
            var j: i64 = i + 1
            while j < n and events[j].kind == GPU_EVENT_KIND_POINTER_MOVE:
                last = events[j]
                j = j + 1
            result = result.push(last)
            i = j
        else if cur.kind == GPU_EVENT_KIND_WHEEL:
            var sum_dx: i32 = cur.delta_x_fixed
            var sum_dy: i32 = cur.delta_y_fixed
            var last = cur
            var j: i64 = i + 1
            while j < n and events[j].kind == GPU_EVENT_KIND_WHEEL:
                sum_dx = sum_dx + events[j].delta_x_fixed
                sum_dy = sum_dy + events[j].delta_y_fixed
                last = events[j]
                j = j + 1
            val merged = GpuInputEvent(
                sequence: last.sequence,
                scene_generation: last.scene_generation,
                timestamp_ns: last.timestamp_ns,
                kind: last.kind,
                device_id: last.device_id,
                flags: last.flags,
                x_fixed: last.x_fixed,
                y_fixed: last.y_fixed,
                delta_x_fixed: sum_dx,
                delta_y_fixed: sum_dy,
                key_code: last.key_code,
                text_offset: last.text_offset,
                text_length: last.text_length,
            )
            result = result.push(merged)
            i = j
        else:
            result = result.push(cur)
            i = i + 1
    result

# ---------------------------------------------------------------------------
# Ancestor route (plan §3 step 4)
# ---------------------------------------------------------------------------

fn gpu_event_build_route(target_node: u32, parents: [u32]) -> [u32]:
    """Ancestor chain root -> target from a parent-id array indexed by node
    id (parents[node] == node means root). Guards against cycles/out-of-range
    parents with a max walk depth."""
    var chain: [u32] = []
    var node: u32 = target_node
    var depth: i64 = 0
    while depth < GPU_EVENT_MAX_ROUTE_DEPTH:
        chain = chain.push(node)
        val idx: i64 = node as i64
        if idx < 0 or idx >= parents.len():
            break
        val parent: u32 = parents[idx]
        if parent == node:
            break
        node = parent
        depth = depth + 1

    # chain is target -> ... -> root; reverse to root -> target.
    var route: [u32] = []
    var k: i64 = chain.len() - 1
    while k >= 0:
        route = route.push(chain[k])
        k = k - 1
    route

# ---------------------------------------------------------------------------
# Capture/target/bubble dispatch (plan §3 steps 5-7)
# ---------------------------------------------------------------------------

fn gpu_event_listeners_for_node_phase(node_id: u32, phase: u16, listeners: [GpuEventListener]) -> [GpuEventListener]:
    var matched: [GpuEventListener] = []
    var i: i64 = 0
    val n: i64 = listeners.len()
    while i < n:
        val l = listeners[i]
        if l.node_id == node_id and l.phase == phase:
            matched = matched.push(l)
        i = i + 1

    # Stable insertion sort by registration_order (ties keep insertion order).
    var sorted = matched
    val m: i64 = sorted.len()
    var a: i64 = 1
    while a < m:
        val key = sorted[a]
        var b: i64 = a - 1
        while b >= 0 and sorted[b].registration_order > key.registration_order:
            sorted[b + 1] = sorted[b]
            b = b - 1
        sorted[b + 1] = key
        a = a + 1
    sorted

fn gpu_event_route_steps_for_node(node_id: u32, phase: u16, listeners: [GpuEventListener]) -> [GpuEventRouteStep]:
    val ordered = gpu_event_listeners_for_node_phase(node_id, phase, listeners)
    var steps: [GpuEventRouteStep] = []
    var i: i64 = 0
    while i < ordered.len():
        val l = ordered[i]
        steps = steps.push(GpuEventRouteStep(node_id: l.node_id, phase: l.phase, listener_handler_id: l.handler_id))
        i = i + 1
    steps

fn gpu_event_dispatch(target_node: u32, parents: [u32], listeners: [GpuEventListener]) -> [GpuEventRouteStep]:
    """Deterministic order: capture phase root -> target (phase 0 on each
    ancestor, by registration_order), then target listeners (phase 1, by
    registration_order), then bubble target -> root (phase 2, by
    registration_order)."""
    val route: [u32] = gpu_event_build_route(target_node, parents)
    val route_len: i64 = route.len()
    var steps: [GpuEventRouteStep] = []
    if route_len == 0:
        return steps

    # Capture: root -> ... -> ancestor just above target.
    var i: i64 = 0
    while i < route_len - 1:
        val node_steps = gpu_event_route_steps_for_node(route[i], GPU_EVENT_PHASE_CAPTURE, listeners)
        var k: i64 = 0
        while k < node_steps.len():
            steps = steps.push(node_steps[k])
            k = k + 1
        i = i + 1

    # Target.
    val target_steps = gpu_event_route_steps_for_node(route[route_len - 1], GPU_EVENT_PHASE_TARGET, listeners)
    var t: i64 = 0
    while t < target_steps.len():
        steps = steps.push(target_steps[t])
        t = t + 1

    # Bubble: ancestor just above target -> ... -> root.
    var j: i64 = route_len - 2
    while j >= 0:
        val bubble_steps = gpu_event_route_steps_for_node(route[j], GPU_EVENT_PHASE_BUBBLE, listeners)
        var kk: i64 = 0
        while kk < bubble_steps.len():
            steps = steps.push(bubble_steps[kk])
            kk = kk + 1
        j = j - 1

    steps

# ---------------------------------------------------------------------------
# Deterministic mutation journal (plan §3 steps 8-9)
# ---------------------------------------------------------------------------

fn gpu_mutation_journal_commit(mutations: [GpuMutation]) -> [GpuMutation]:
    """Stable-sort the journal by sequence. No in-place application: this
    returns the ordered journal for a separate commit kernel to apply."""
    var sorted = mutations
    val n: i64 = sorted.len()
    var i: i64 = 1
    while i < n:
        val key = sorted[i]
        var j: i64 = i - 1
        while j >= 0 and sorted[j].sequence > key.sequence:
            sorted[j + 1] = sorted[j]
            j = j - 1
        sorted[j + 1] = key
        i = i + 1
    sorted

# ---------------------------------------------------------------------------
# Deterministic epoch hash (acceptance: deterministic mutation bytes)
# ---------------------------------------------------------------------------

pub val GPU_EVENT_FNV_OFFSET_BASIS: u64 = 0xCBF29CE484222325u64
pub val GPU_EVENT_FNV_PRIME: u64 = 1099511628211u64

fn gpu_event_fnv1a_byte(h: u64, byte: u64) -> u64:
    var x: u64 = h ^ (byte & 0xFFu64)
    x * GPU_EVENT_FNV_PRIME

fn gpu_event_fnv1a_u64_field(h: u64, value: u64) -> u64:
    var x: u64 = h
    x = gpu_event_fnv1a_byte(x, (value >> 0) & 0xFFu64)
    x = gpu_event_fnv1a_byte(x, (value >> 8) & 0xFFu64)
    x = gpu_event_fnv1a_byte(x, (value >> 16) & 0xFFu64)
    x = gpu_event_fnv1a_byte(x, (value >> 24) & 0xFFu64)
    x = gpu_event_fnv1a_byte(x, (value >> 32) & 0xFFu64)
    x = gpu_event_fnv1a_byte(x, (value >> 40) & 0xFFu64)
    x = gpu_event_fnv1a_byte(x, (value >> 48) & 0xFFu64)
    x = gpu_event_fnv1a_byte(x, (value >> 56) & 0xFFu64)
    x

fn gpu_event_epoch_hash(mutations: [GpuMutation]) -> u64:
    """Deterministic FNV-1a over each mutation's fields in order (node_id,
    node_generation, field_id, operation, value_lo, value_hi, sequence).
    Oracle handle for 'same event batch produces deterministic mutation
    bytes'."""
    var h: u64 = GPU_EVENT_FNV_OFFSET_BASIS
    var i: i64 = 0
    val n: i64 = mutations.len()
    while i < n:
        val m = mutations[i]
        h = gpu_event_fnv1a_u64_field(h, m.node_id as u64)
        h = gpu_event_fnv1a_u64_field(h, m.node_generation as u64)
        h = gpu_event_fnv1a_u64_field(h, m.field_id as u64)
        h = gpu_event_fnv1a_u64_field(h, m.operation as u64)
        h = gpu_event_fnv1a_u64_field(h, m.value_lo as u64)
        h = gpu_event_fnv1a_u64_field(h, m.value_hi as u64)
        h = gpu_event_fnv1a_u64_field(h, m.sequence as u64)
        i = i + 1
    h

export GPU_EVENT_PHASE_CAPTURE, GPU_EVENT_PHASE_TARGET, GPU_EVENT_PHASE_BUBBLE,
    GPU_EVENT_MAX_ROUTE_DEPTH, GPU_EVENT_FNV_OFFSET_BASIS, GPU_EVENT_FNV_PRIME,
    GpuEventListener, GpuEventRouteStep,
    gpu_event_validate_generation, gpu_event_coalesce, gpu_event_build_route,
    gpu_event_dispatch, gpu_mutation_journal_commit, gpu_event_epoch_hash
