# Scalar WM lifecycle state shared by hosted and freestanding adapters.

val WM_WINDOW_STATE_NORMAL: i32 = 1
val WM_WINDOW_STATE_MINIMIZED: i32 = 2
val WM_WINDOW_STATE_MAXIMIZED: i32 = 3
val WM_WINDOW_STATE_CLOSING: i32 = 4
val WM_WINDOW_STATE_CLOSED: i32 = 5

fn wm_window_state_accepts_input(state: i32) -> bool:
    state == WM_WINDOW_STATE_NORMAL or state == WM_WINDOW_STATE_MAXIMIZED

fn wm_window_state_before_minimize(state: i32) -> i32:
    if state == WM_WINDOW_STATE_MAXIMIZED:
        return WM_WINDOW_STATE_MAXIMIZED
    WM_WINDOW_STATE_NORMAL

fn wm_window_state_minimize(state: i32) -> i32:
    if state == WM_WINDOW_STATE_CLOSING or state == WM_WINDOW_STATE_CLOSED:
        return state
    WM_WINDOW_STATE_MINIMIZED

fn wm_window_state_maximize(state: i32) -> i32:
    if state == WM_WINDOW_STATE_CLOSING or state == WM_WINDOW_STATE_CLOSED:
        return state
    WM_WINDOW_STATE_MAXIMIZED

fn wm_window_state_restore(state: i32, state_before_minimize: i32) -> i32:
    if state == WM_WINDOW_STATE_MINIMIZED:
        if state_before_minimize == WM_WINDOW_STATE_MAXIMIZED:
            return WM_WINDOW_STATE_MAXIMIZED
        return WM_WINDOW_STATE_NORMAL
    if state == WM_WINDOW_STATE_MAXIMIZED:
        return WM_WINDOW_STATE_NORMAL
    state

fn wm_window_state_begin_close(state: i32) -> i32:
    if state == WM_WINDOW_STATE_CLOSED:
        return state
    WM_WINDOW_STATE_CLOSING

fn wm_window_state_finish_close(state: i32) -> i32:
    if state == WM_WINDOW_STATE_CLOSING or state == WM_WINDOW_STATE_CLOSED:
        return WM_WINDOW_STATE_CLOSED
    state

export WM_WINDOW_STATE_NORMAL
export WM_WINDOW_STATE_MINIMIZED
export WM_WINDOW_STATE_MAXIMIZED
export WM_WINDOW_STATE_CLOSING
export WM_WINDOW_STATE_CLOSED
export wm_window_state_accepts_input
export wm_window_state_before_minimize
export wm_window_state_minimize
export wm_window_state_maximize
export wm_window_state_restore
export wm_window_state_begin_close
export wm_window_state_finish_close
