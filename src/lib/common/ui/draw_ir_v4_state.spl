# Durable v4 geometry retained independently from legacy integer bounds.
# Record shapes follow the preserved draw-ir-v4-contract draft (2026-10-04).
pub val DRAW_IR_SCHEMA_VERSION_V4: text = "simple-draw-ir-v4"
pub val DRAW_IR_RASTER_ALIASED_PIXEL_CENTER: text = "aliased-pixel-center"
pub val DRAW_IR_RASTER_COVERAGE_AA: text = "coverage-aa"

struct DrawIrFractionalGeometry:
    x: f64
    y: f64
    width: f64
    height: f64

# Column vectors: (a*x + c*y + tx, b*x + d*y + ty).
struct DrawIrAffine2D:
    a: f64
    b: f64
    c: f64
    d: f64
    tx: f64
    ty: f64

fn draw_ir_fractional_equal(a: DrawIrFractionalGeometry?, b: DrawIrFractionalGeometry?) -> bool:
    if val left = a:
        if val right = b:
            return left.x == right.x and left.y == right.y and left.width == right.width and left.height == right.height
        return false
    b == nil

fn draw_ir_affine_equal(a: DrawIrAffine2D?, b: DrawIrAffine2D?) -> bool:
    if val left = a:
        if val right = b:
            return left.a == right.a and left.b == right.b and left.c == right.c and left.d == right.d and left.tx == right.tx and left.ty == right.ty
        return false
    b == nil

fn draw_ir_v4_payload_equal(geometry_a: DrawIrFractionalGeometry?, affine_a: DrawIrAffine2D?, raster_a: text,
    geometry_b: DrawIrFractionalGeometry?, affine_b: DrawIrAffine2D?, raster_b: text) -> bool:
    raster_a == raster_b and draw_ir_fractional_equal(geometry_a, geometry_b) and draw_ir_affine_equal(affine_a, affine_b)

export DrawIrFractionalGeometry, DrawIrAffine2D
export draw_ir_fractional_equal, draw_ir_affine_equal, draw_ir_v4_payload_equal
