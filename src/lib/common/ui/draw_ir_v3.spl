# Frozen DrawIR v3 contract types.
#
# Additive to `src/lib/common/ui/draw_ir.spl` (v2). v2 is NOT modified,
# wrapped, or deprecated by this file; the two schemas coexist and v2 stays
# the CPU-reference oracle.
#
# Source of truth: `doc/03_plan/ui/gpu_web_scene_offload_mdsoc_plus_plan.md`
# §6 "No-reallocation IR and scene memory" / "Additive DrawIR v3".
#
# Hard invariant of v3 (the entire point of the schema):
#   the render-hot structures contain no text keys and no nested dynamic
#   arrays.
#
# So every render-hot struct here is either:
#   * a fixed-width scalar record (`DrawIrV3Command`, the accessor views), or
#   * a struct-of-arrays side table whose columns are FLAT scalar arrays.
# Indirection lives in the side tables: a command carries u32 ids only.
# Variable-length payloads (glyphs, path points) are expressed as
# (start, count) spans into a flat column, never as a nested array.
#
# Text appears in exactly one place: the human-readable schema banner on
# `DrawIrV3Scene`, which is a host-side header and is never uploaded. The
# device-visible version marker is the numeric `schema_id`.

# --- schema version -------------------------------------------------------
# Contract changes = new schema version (structural_compute README rule 1).
pub val DRAW_IR_V3_SCHEMA_VERSION: text = "simple-draw-ir-v3"
# Numeric mirror of the version, for headers that may not carry text.
pub val DRAW_IR_V3_SCHEMA_ID: u32 = 3u32

# Absent / null side-table reference. Ids are 0-based flat indices, so the
# sentinel is the maximum u32 rather than 0.
pub val DRAW_IR_V3_NO_ID: u32 = 0xffffffffu32

# --- command kinds (u16) --------------------------------------------------
pub val DRAW_IR_V3_KIND_NONE: u16 = 0u16
pub val DRAW_IR_V3_KIND_RECT: u16 = 1u16
pub val DRAW_IR_V3_KIND_TEXT: u16 = 2u16
pub val DRAW_IR_V3_KIND_EDGE: u16 = 3u16
pub val DRAW_IR_V3_KIND_PATH: u16 = 4u16
pub val DRAW_IR_V3_KIND_IMAGE: u16 = 5u16
pub val DRAW_IR_V3_KIND_GROUP: u16 = 6u16
pub val DRAW_IR_V3_KIND_PORT: u16 = 7u16

# --- command flags (u16 bitmask) -----------------------------------------
pub val DRAW_IR_V3_FLAG_NONE: u16 = 0u16
pub val DRAW_IR_V3_FLAG_CLIPPED: u16 = 1u16
pub val DRAW_IR_V3_FLAG_TRANSFORMED: u16 = 2u16
pub val DRAW_IR_V3_FLAG_HIT_TESTABLE: u16 = 4u16
pub val DRAW_IR_V3_FLAG_HIDDEN: u16 = 8u16

# --- path point verbs (u16) ----------------------------------------------
pub val DRAW_IR_V3_VERB_MOVE: u16 = 0u16
pub val DRAW_IR_V3_VERB_LINE: u16 = 1u16
pub val DRAW_IR_V3_VERB_QUAD: u16 = 2u16
pub val DRAW_IR_V3_VERB_CUBIC: u16 = 3u16
pub val DRAW_IR_V3_VERB_CLOSE: u16 = 4u16

# --- resource kinds (u16) -------------------------------------------------
pub val DRAW_IR_V3_RESOURCE_NONE: u16 = 0u16
pub val DRAW_IR_V3_RESOURCE_IMAGE: u16 = 1u16
pub val DRAW_IR_V3_RESOURCE_FONT: u16 = 2u16
pub val DRAW_IR_V3_RESOURCE_VIDEO: u16 = 3u16

# --- hit shape kinds (u16) ------------------------------------------------
pub val DRAW_IR_V3_HIT_RECT: u16 = 0u16
pub val DRAW_IR_V3_HIT_ROUNDED_RECT: u16 = 1u16
pub val DRAW_IR_V3_HIT_ELLIPSE: u16 = 2u16

# --- provenance edge kinds (u16) -----------------------------------------
# MappingGraph edge kinds bound by the webrender lane plan.
pub val DRAW_IR_V3_PROVENANCE_NONE: u16 = 0u16
pub val DRAW_IR_V3_PROVENANCE_PAINT_OF: u16 = 1u16
pub val DRAW_IR_V3_PROVENANCE_HIT_REGION_OF: u16 = 2u16

# =========================================================================
# Command record — field names and widths are frozen by the plan verbatim.
# =========================================================================
struct DrawIrV3Command:
    kind: u16
    flags: u16

    component_id: u32
    component_generation: u32
    parent_id: u32

    geometry_id: u32
    paint_id: u32
    text_run_id: u32
    image_resource_id: u32
    path_span_id: u32
    clip_id: u32
    transform_id: u32
    hit_shape_id: u32

# =========================================================================
# Side tables (struct-of-arrays, flat scalar columns only).
# Struct names are prefixed `DrawIrV3*` because the interpreter keeps a
# global struct registry and bare `PaintTable` / `ClipTable` would collide.
# =========================================================================

struct DrawIrV3GeometryTable:
    xs: [i32]
    ys: [i32]
    widths: [i32]
    heights: [i32]
    corner_radii: [i32]

struct DrawIrV3PaintTable:
    fill_colors: [u32]
    stroke_colors: [u32]
    stroke_widths_milli: [i32]
    opacities_milli: [i32]
    blend_modes: [u16]

# Run columns index a flat glyph column via (glyph_start, glyph_count).
struct DrawIrV3TextRunTable:
    run_glyph_starts: [u32]
    run_glyph_counts: [u32]
    run_font_resource_ids: [u32]
    run_font_sizes_milli: [i32]
    run_baseline_xs: [i32]
    run_baseline_ys: [i32]
    run_colors: [u32]
    glyph_ids: [u32]
    glyph_xs: [i32]
    glyph_ys: [i32]
    glyph_clusters: [i64]

# v2 carried `image_uri: text`; v3 carries a numeric content hash instead.
struct DrawIrV3ResourceTable:
    kinds: [u16]
    formats: [u16]
    widths: [u32]
    heights: [u32]
    content_hashes: [i64]

# Span columns index a flat point column via (point_start, point_count).
struct DrawIrV3PathPointTable:
    span_point_starts: [u32]
    span_point_counts: [u32]
    span_fill_rules: [u16]
    point_xs: [i32]
    point_ys: [i32]
    point_verbs: [u16]

# Nesting is a parent-id chain, never a nested array.
struct DrawIrV3ClipTable:
    xs: [i32]
    ys: [i32]
    widths: [i32]
    heights: [i32]
    corner_radii: [i32]
    parent_ids: [u32]

# 2D affine, fixed point in milli-units: [m11 m12 dx; m21 m22 dy].
struct DrawIrV3TransformTable:
    m11s: [i32]
    m12s: [i32]
    m21s: [i32]
    m22s: [i32]
    dxs: [i32]
    dys: [i32]

struct DrawIrV3HitShapeTable:
    xs: [i32]
    ys: [i32]
    widths: [i32]
    heights: [i32]
    shape_kinds: [u16]
    hit_flags: [u16]
    component_ids: [u32]

# MappingGraph edges (`PaintOf`, `HitRegionOf`) as numeric columns.
struct DrawIrV3SourceProvenanceTable:
    command_indices: [u32]
    edge_kinds: [u16]
    source_node_ids: [u32]
    source_rule_ids: [u32]
    source_span_starts: [u32]
    source_span_lens: [u32]

# =========================================================================
# Accessor views. Every view carries `present`, mirroring the v2
# `DrawIrRect.present` convention, so a missing/sentinel id reads as absent
# instead of trapping.
# =========================================================================

struct DrawIrV3Geometry:
    present: bool
    x: i32
    y: i32
    width: i32
    height: i32
    corner_radius: i32

struct DrawIrV3Paint:
    present: bool
    fill_color: u32
    stroke_color: u32
    stroke_width_milli: i32
    opacity_milli: i32
    blend_mode: u16

struct DrawIrV3TextRun:
    present: bool
    glyph_start: u32
    glyph_count: u32
    font_resource_id: u32
    font_size_milli: i32
    baseline_x: i32
    baseline_y: i32
    color: u32

struct DrawIrV3Glyph:
    present: bool
    glyph_id: u32
    x: i32
    y: i32
    cluster: i64

struct DrawIrV3Resource:
    present: bool
    kind: u16
    format: u16
    width: u32
    height: u32
    content_hash: i64

struct DrawIrV3PathSpan:
    present: bool
    point_start: u32
    point_count: u32
    fill_rule: u16

struct DrawIrV3PathPoint:
    present: bool
    x: i32
    y: i32
    verb: u16

struct DrawIrV3Clip:
    present: bool
    x: i32
    y: i32
    width: i32
    height: i32
    corner_radius: i32
    parent_id: u32

struct DrawIrV3Transform:
    present: bool
    m11: i32
    m12: i32
    m21: i32
    m22: i32
    dx: i32
    dy: i32

struct DrawIrV3HitShape:
    present: bool
    x: i32
    y: i32
    width: i32
    height: i32
    shape_kind: u16
    hit_flags: u16
    component_id: u32

struct DrawIrV3Provenance:
    present: bool
    command_index: u32
    edge_kind: u16
    source_node_id: u32
    source_rule_id: u32
    source_span_start: u32
    source_span_len: u32

# =========================================================================
# Scene container. Host-side header + command buffer + the nine tables.
# `schema` is host-only text; `schema_id` is the device-visible marker.
# =========================================================================
struct DrawIrV3Scene:
    schema: text
    schema_id: u32
    scene_id: u32
    generation: u32
    commands: [DrawIrV3Command]
    geometry: DrawIrV3GeometryTable
    paint: DrawIrV3PaintTable
    text_runs: DrawIrV3TextRunTable
    resources: DrawIrV3ResourceTable
    path_points: DrawIrV3PathPointTable
    clips: DrawIrV3ClipTable
    transforms: DrawIrV3TransformTable
    hit_shapes: DrawIrV3HitShapeTable
    provenance: DrawIrV3SourceProvenanceTable

# --- index helpers --------------------------------------------------------

fn _draw_ir_v3_index(id: u32, length: i64) -> i64:
    if id == DRAW_IR_V3_NO_ID:
        return -1
    val idx = id.to_i64()
    if idx < 0 or idx >= length:
        return -1
    idx

fn _draw_ir_v3_id_of(length: i64) -> u32:
    length as u32

# =========================================================================
# Empty table constructors
# =========================================================================

fn draw_ir_v3_empty_geometry_table() -> DrawIrV3GeometryTable:
    DrawIrV3GeometryTable(xs: [], ys: [], widths: [], heights: [], corner_radii: [])

fn draw_ir_v3_empty_paint_table() -> DrawIrV3PaintTable:
    DrawIrV3PaintTable(
        fill_colors: [], stroke_colors: [], stroke_widths_milli: [],
        opacities_milli: [], blend_modes: []
    )

fn draw_ir_v3_empty_text_run_table() -> DrawIrV3TextRunTable:
    DrawIrV3TextRunTable(
        run_glyph_starts: [], run_glyph_counts: [], run_font_resource_ids: [],
        run_font_sizes_milli: [], run_baseline_xs: [], run_baseline_ys: [],
        run_colors: [], glyph_ids: [], glyph_xs: [], glyph_ys: [], glyph_clusters: []
    )

fn draw_ir_v3_empty_resource_table() -> DrawIrV3ResourceTable:
    DrawIrV3ResourceTable(kinds: [], formats: [], widths: [], heights: [], content_hashes: [])

fn draw_ir_v3_empty_path_point_table() -> DrawIrV3PathPointTable:
    DrawIrV3PathPointTable(
        span_point_starts: [], span_point_counts: [], span_fill_rules: [],
        point_xs: [], point_ys: [], point_verbs: []
    )

fn draw_ir_v3_empty_clip_table() -> DrawIrV3ClipTable:
    DrawIrV3ClipTable(
        xs: [], ys: [], widths: [], heights: [], corner_radii: [], parent_ids: []
    )

fn draw_ir_v3_empty_transform_table() -> DrawIrV3TransformTable:
    DrawIrV3TransformTable(m11s: [], m12s: [], m21s: [], m22s: [], dxs: [], dys: [])

fn draw_ir_v3_empty_hit_shape_table() -> DrawIrV3HitShapeTable:
    DrawIrV3HitShapeTable(
        xs: [], ys: [], widths: [], heights: [],
        shape_kinds: [], hit_flags: [], component_ids: []
    )

fn draw_ir_v3_empty_provenance_table() -> DrawIrV3SourceProvenanceTable:
    DrawIrV3SourceProvenanceTable(
        command_indices: [], edge_kinds: [], source_node_ids: [],
        source_rule_ids: [], source_span_starts: [], source_span_lens: []
    )

fn draw_ir_v3_empty_scene(scene_id: u32, generation: u32) -> DrawIrV3Scene:
    DrawIrV3Scene(
        schema: DRAW_IR_V3_SCHEMA_VERSION,
        schema_id: DRAW_IR_V3_SCHEMA_ID,
        scene_id: scene_id,
        generation: generation,
        commands: [],
        geometry: draw_ir_v3_empty_geometry_table(),
        paint: draw_ir_v3_empty_paint_table(),
        text_runs: draw_ir_v3_empty_text_run_table(),
        resources: draw_ir_v3_empty_resource_table(),
        path_points: draw_ir_v3_empty_path_point_table(),
        clips: draw_ir_v3_empty_clip_table(),
        transforms: draw_ir_v3_empty_transform_table(),
        hit_shapes: draw_ir_v3_empty_hit_shape_table(),
        provenance: draw_ir_v3_empty_provenance_table()
    )

# =========================================================================
# Command constructors
# =========================================================================

fn draw_ir_v3_empty_command() -> DrawIrV3Command:
    DrawIrV3Command(
        kind: DRAW_IR_V3_KIND_NONE,
        flags: DRAW_IR_V3_FLAG_NONE,
        component_id: 0u32,
        component_generation: 0u32,
        parent_id: DRAW_IR_V3_NO_ID,
        geometry_id: DRAW_IR_V3_NO_ID,
        paint_id: DRAW_IR_V3_NO_ID,
        text_run_id: DRAW_IR_V3_NO_ID,
        image_resource_id: DRAW_IR_V3_NO_ID,
        path_span_id: DRAW_IR_V3_NO_ID,
        clip_id: DRAW_IR_V3_NO_ID,
        transform_id: DRAW_IR_V3_NO_ID,
        hit_shape_id: DRAW_IR_V3_NO_ID
    )

fn draw_ir_v3_command(
    kind: u16, flags: u16,
    component_id: u32, component_generation: u32, parent_id: u32,
    geometry_id: u32, paint_id: u32, text_run_id: u32,
    image_resource_id: u32, path_span_id: u32, clip_id: u32,
    transform_id: u32, hit_shape_id: u32
) -> DrawIrV3Command:
    DrawIrV3Command(
        kind: kind,
        flags: flags,
        component_id: component_id,
        component_generation: component_generation,
        parent_id: parent_id,
        geometry_id: geometry_id,
        paint_id: paint_id,
        text_run_id: text_run_id,
        image_resource_id: image_resource_id,
        path_span_id: path_span_id,
        clip_id: clip_id,
        transform_id: transform_id,
        hit_shape_id: hit_shape_id
    )

fn draw_ir_v3_has_flag(command: DrawIrV3Command, flag: u16) -> bool:
    (command.flags & flag) != 0u16

# =========================================================================
# Table appends. Tables are immutable: an append returns a new table and the
# id of the appended row is the pre-append row count.
# =========================================================================

fn draw_ir_v3_geometry_next_id(table: DrawIrV3GeometryTable) -> u32:
    _draw_ir_v3_id_of(table.xs.len().to_i64())

fn draw_ir_v3_geometry_append(
    table: DrawIrV3GeometryTable, x: i32, y: i32, width: i32, height: i32, corner_radius: i32
) -> DrawIrV3GeometryTable:
    var xs = table.xs
    var ys = table.ys
    var widths = table.widths
    var heights = table.heights
    var radii = table.corner_radii
    xs.push(x)
    ys.push(y)
    widths.push(width)
    heights.push(height)
    radii.push(corner_radius)
    DrawIrV3GeometryTable(xs: xs, ys: ys, widths: widths, heights: heights, corner_radii: radii)

fn draw_ir_v3_geometry_at(table: DrawIrV3GeometryTable, id: u32) -> DrawIrV3Geometry:
    val idx = _draw_ir_v3_index(id, table.xs.len().to_i64())
    if idx < 0:
        return DrawIrV3Geometry(present: false, x: 0, y: 0, width: 0, height: 0, corner_radius: 0)
    DrawIrV3Geometry(
        present: true,
        x: table.xs[idx],
        y: table.ys[idx],
        width: table.widths[idx],
        height: table.heights[idx],
        corner_radius: table.corner_radii[idx]
    )

fn draw_ir_v3_paint_next_id(table: DrawIrV3PaintTable) -> u32:
    _draw_ir_v3_id_of(table.fill_colors.len().to_i64())

fn draw_ir_v3_paint_append(
    table: DrawIrV3PaintTable, fill_color: u32, stroke_color: u32,
    stroke_width_milli: i32, opacity_milli: i32, blend_mode: u16
) -> DrawIrV3PaintTable:
    var fills = table.fill_colors
    var strokes = table.stroke_colors
    var widths = table.stroke_widths_milli
    var opacities = table.opacities_milli
    var blends = table.blend_modes
    fills.push(fill_color)
    strokes.push(stroke_color)
    widths.push(stroke_width_milli)
    opacities.push(opacity_milli)
    blends.push(blend_mode)
    DrawIrV3PaintTable(
        fill_colors: fills, stroke_colors: strokes, stroke_widths_milli: widths,
        opacities_milli: opacities, blend_modes: blends
    )

fn draw_ir_v3_paint_at(table: DrawIrV3PaintTable, id: u32) -> DrawIrV3Paint:
    val idx = _draw_ir_v3_index(id, table.fill_colors.len().to_i64())
    if idx < 0:
        return DrawIrV3Paint(
            present: false, fill_color: 0u32, stroke_color: 0u32,
            stroke_width_milli: 0, opacity_milli: 0, blend_mode: 0u16
        )
    DrawIrV3Paint(
        present: true,
        fill_color: table.fill_colors[idx],
        stroke_color: table.stroke_colors[idx],
        stroke_width_milli: table.stroke_widths_milli[idx],
        opacity_milli: table.opacities_milli[idx],
        blend_mode: table.blend_modes[idx]
    )

fn draw_ir_v3_glyph_next_id(table: DrawIrV3TextRunTable) -> u32:
    _draw_ir_v3_id_of(table.glyph_ids.len().to_i64())

fn draw_ir_v3_glyph_append(
    table: DrawIrV3TextRunTable, glyph_id: u32, x: i32, y: i32, cluster: i64
) -> DrawIrV3TextRunTable:
    var ids = table.glyph_ids
    var xs = table.glyph_xs
    var ys = table.glyph_ys
    var clusters = table.glyph_clusters
    ids.push(glyph_id)
    xs.push(x)
    ys.push(y)
    clusters.push(cluster)
    DrawIrV3TextRunTable(
        run_glyph_starts: table.run_glyph_starts,
        run_glyph_counts: table.run_glyph_counts,
        run_font_resource_ids: table.run_font_resource_ids,
        run_font_sizes_milli: table.run_font_sizes_milli,
        run_baseline_xs: table.run_baseline_xs,
        run_baseline_ys: table.run_baseline_ys,
        run_colors: table.run_colors,
        glyph_ids: ids, glyph_xs: xs, glyph_ys: ys, glyph_clusters: clusters
    )

fn draw_ir_v3_glyph_at(table: DrawIrV3TextRunTable, id: u32) -> DrawIrV3Glyph:
    val idx = _draw_ir_v3_index(id, table.glyph_ids.len().to_i64())
    if idx < 0:
        return DrawIrV3Glyph(present: false, glyph_id: 0u32, x: 0, y: 0, cluster: 0)
    DrawIrV3Glyph(
        present: true,
        glyph_id: table.glyph_ids[idx],
        x: table.glyph_xs[idx],
        y: table.glyph_ys[idx],
        cluster: table.glyph_clusters[idx]
    )

fn draw_ir_v3_text_run_next_id(table: DrawIrV3TextRunTable) -> u32:
    _draw_ir_v3_id_of(table.run_glyph_starts.len().to_i64())

fn draw_ir_v3_text_run_append(
    table: DrawIrV3TextRunTable, glyph_start: u32, glyph_count: u32,
    font_resource_id: u32, font_size_milli: i32,
    baseline_x: i32, baseline_y: i32, color: u32
) -> DrawIrV3TextRunTable:
    var starts = table.run_glyph_starts
    var counts = table.run_glyph_counts
    var fonts = table.run_font_resource_ids
    var sizes = table.run_font_sizes_milli
    var bxs = table.run_baseline_xs
    var bys = table.run_baseline_ys
    var colors = table.run_colors
    starts.push(glyph_start)
    counts.push(glyph_count)
    fonts.push(font_resource_id)
    sizes.push(font_size_milli)
    bxs.push(baseline_x)
    bys.push(baseline_y)
    colors.push(color)
    DrawIrV3TextRunTable(
        run_glyph_starts: starts,
        run_glyph_counts: counts,
        run_font_resource_ids: fonts,
        run_font_sizes_milli: sizes,
        run_baseline_xs: bxs,
        run_baseline_ys: bys,
        run_colors: colors,
        glyph_ids: table.glyph_ids,
        glyph_xs: table.glyph_xs,
        glyph_ys: table.glyph_ys,
        glyph_clusters: table.glyph_clusters
    )

fn draw_ir_v3_text_run_at(table: DrawIrV3TextRunTable, id: u32) -> DrawIrV3TextRun:
    val idx = _draw_ir_v3_index(id, table.run_glyph_starts.len().to_i64())
    if idx < 0:
        return DrawIrV3TextRun(
            present: false, glyph_start: DRAW_IR_V3_NO_ID, glyph_count: 0u32,
            font_resource_id: DRAW_IR_V3_NO_ID, font_size_milli: 0,
            baseline_x: 0, baseline_y: 0, color: 0u32
        )
    DrawIrV3TextRun(
        present: true,
        glyph_start: table.run_glyph_starts[idx],
        glyph_count: table.run_glyph_counts[idx],
        font_resource_id: table.run_font_resource_ids[idx],
        font_size_milli: table.run_font_sizes_milli[idx],
        baseline_x: table.run_baseline_xs[idx],
        baseline_y: table.run_baseline_ys[idx],
        color: table.run_colors[idx]
    )

fn draw_ir_v3_resource_next_id(table: DrawIrV3ResourceTable) -> u32:
    _draw_ir_v3_id_of(table.kinds.len().to_i64())

fn draw_ir_v3_resource_append(
    table: DrawIrV3ResourceTable, kind: u16, format: u16,
    width: u32, height: u32, content_hash: i64
) -> DrawIrV3ResourceTable:
    var kinds = table.kinds
    var formats = table.formats
    var widths = table.widths
    var heights = table.heights
    var hashes = table.content_hashes
    kinds.push(kind)
    formats.push(format)
    widths.push(width)
    heights.push(height)
    hashes.push(content_hash)
    DrawIrV3ResourceTable(
        kinds: kinds, formats: formats, widths: widths,
        heights: heights, content_hashes: hashes
    )

fn draw_ir_v3_resource_at(table: DrawIrV3ResourceTable, id: u32) -> DrawIrV3Resource:
    val idx = _draw_ir_v3_index(id, table.kinds.len().to_i64())
    if idx < 0:
        return DrawIrV3Resource(
            present: false, kind: DRAW_IR_V3_RESOURCE_NONE, format: 0u16,
            width: 0u32, height: 0u32, content_hash: 0
        )
    DrawIrV3Resource(
        present: true,
        kind: table.kinds[idx],
        format: table.formats[idx],
        width: table.widths[idx],
        height: table.heights[idx],
        content_hash: table.content_hashes[idx]
    )

fn draw_ir_v3_path_point_next_id(table: DrawIrV3PathPointTable) -> u32:
    _draw_ir_v3_id_of(table.point_xs.len().to_i64())

fn draw_ir_v3_path_point_append(
    table: DrawIrV3PathPointTable, x: i32, y: i32, verb: u16
) -> DrawIrV3PathPointTable:
    var xs = table.point_xs
    var ys = table.point_ys
    var verbs = table.point_verbs
    xs.push(x)
    ys.push(y)
    verbs.push(verb)
    DrawIrV3PathPointTable(
        span_point_starts: table.span_point_starts,
        span_point_counts: table.span_point_counts,
        span_fill_rules: table.span_fill_rules,
        point_xs: xs, point_ys: ys, point_verbs: verbs
    )

fn draw_ir_v3_path_point_at(table: DrawIrV3PathPointTable, id: u32) -> DrawIrV3PathPoint:
    val idx = _draw_ir_v3_index(id, table.point_xs.len().to_i64())
    if idx < 0:
        return DrawIrV3PathPoint(present: false, x: 0, y: 0, verb: DRAW_IR_V3_VERB_MOVE)
    DrawIrV3PathPoint(
        present: true,
        x: table.point_xs[idx],
        y: table.point_ys[idx],
        verb: table.point_verbs[idx]
    )

fn draw_ir_v3_path_span_next_id(table: DrawIrV3PathPointTable) -> u32:
    _draw_ir_v3_id_of(table.span_point_starts.len().to_i64())

fn draw_ir_v3_path_span_append(
    table: DrawIrV3PathPointTable, point_start: u32, point_count: u32, fill_rule: u16
) -> DrawIrV3PathPointTable:
    var starts = table.span_point_starts
    var counts = table.span_point_counts
    var rules = table.span_fill_rules
    starts.push(point_start)
    counts.push(point_count)
    rules.push(fill_rule)
    DrawIrV3PathPointTable(
        span_point_starts: starts,
        span_point_counts: counts,
        span_fill_rules: rules,
        point_xs: table.point_xs,
        point_ys: table.point_ys,
        point_verbs: table.point_verbs
    )

fn draw_ir_v3_path_span_at(table: DrawIrV3PathPointTable, id: u32) -> DrawIrV3PathSpan:
    val idx = _draw_ir_v3_index(id, table.span_point_starts.len().to_i64())
    if idx < 0:
        return DrawIrV3PathSpan(
            present: false, point_start: DRAW_IR_V3_NO_ID, point_count: 0u32, fill_rule: 0u16
        )
    DrawIrV3PathSpan(
        present: true,
        point_start: table.span_point_starts[idx],
        point_count: table.span_point_counts[idx],
        fill_rule: table.span_fill_rules[idx]
    )

fn draw_ir_v3_clip_next_id(table: DrawIrV3ClipTable) -> u32:
    _draw_ir_v3_id_of(table.xs.len().to_i64())

fn draw_ir_v3_clip_append(
    table: DrawIrV3ClipTable, x: i32, y: i32, width: i32, height: i32,
    corner_radius: i32, parent_id: u32
) -> DrawIrV3ClipTable:
    var xs = table.xs
    var ys = table.ys
    var widths = table.widths
    var heights = table.heights
    var radii = table.corner_radii
    var parents = table.parent_ids
    xs.push(x)
    ys.push(y)
    widths.push(width)
    heights.push(height)
    radii.push(corner_radius)
    parents.push(parent_id)
    DrawIrV3ClipTable(
        xs: xs, ys: ys, widths: widths, heights: heights,
        corner_radii: radii, parent_ids: parents
    )

fn draw_ir_v3_clip_at(table: DrawIrV3ClipTable, id: u32) -> DrawIrV3Clip:
    val idx = _draw_ir_v3_index(id, table.xs.len().to_i64())
    if idx < 0:
        return DrawIrV3Clip(
            present: false, x: 0, y: 0, width: 0, height: 0,
            corner_radius: 0, parent_id: DRAW_IR_V3_NO_ID
        )
    DrawIrV3Clip(
        present: true,
        x: table.xs[idx],
        y: table.ys[idx],
        width: table.widths[idx],
        height: table.heights[idx],
        corner_radius: table.corner_radii[idx],
        parent_id: table.parent_ids[idx]
    )

fn draw_ir_v3_transform_next_id(table: DrawIrV3TransformTable) -> u32:
    _draw_ir_v3_id_of(table.m11s.len().to_i64())

fn draw_ir_v3_transform_append(
    table: DrawIrV3TransformTable, m11: i32, m12: i32, m21: i32, m22: i32, dx: i32, dy: i32
) -> DrawIrV3TransformTable:
    var a = table.m11s
    var b = table.m12s
    var c = table.m21s
    var d = table.m22s
    var xs = table.dxs
    var ys = table.dys
    a.push(m11)
    b.push(m12)
    c.push(m21)
    d.push(m22)
    xs.push(dx)
    ys.push(dy)
    DrawIrV3TransformTable(m11s: a, m12s: b, m21s: c, m22s: d, dxs: xs, dys: ys)

fn draw_ir_v3_transform_at(table: DrawIrV3TransformTable, id: u32) -> DrawIrV3Transform:
    val idx = _draw_ir_v3_index(id, table.m11s.len().to_i64())
    if idx < 0:
        return DrawIrV3Transform(present: false, m11: 1000, m12: 0, m21: 0, m22: 1000, dx: 0, dy: 0)
    DrawIrV3Transform(
        present: true,
        m11: table.m11s[idx],
        m12: table.m12s[idx],
        m21: table.m21s[idx],
        m22: table.m22s[idx],
        dx: table.dxs[idx],
        dy: table.dys[idx]
    )

fn draw_ir_v3_hit_shape_next_id(table: DrawIrV3HitShapeTable) -> u32:
    _draw_ir_v3_id_of(table.xs.len().to_i64())

fn draw_ir_v3_hit_shape_append(
    table: DrawIrV3HitShapeTable, x: i32, y: i32, width: i32, height: i32,
    shape_kind: u16, hit_flags: u16, component_id: u32
) -> DrawIrV3HitShapeTable:
    var xs = table.xs
    var ys = table.ys
    var widths = table.widths
    var heights = table.heights
    var kinds = table.shape_kinds
    var flags = table.hit_flags
    var components = table.component_ids
    xs.push(x)
    ys.push(y)
    widths.push(width)
    heights.push(height)
    kinds.push(shape_kind)
    flags.push(hit_flags)
    components.push(component_id)
    DrawIrV3HitShapeTable(
        xs: xs, ys: ys, widths: widths, heights: heights,
        shape_kinds: kinds, hit_flags: flags, component_ids: components
    )

fn draw_ir_v3_hit_shape_at(table: DrawIrV3HitShapeTable, id: u32) -> DrawIrV3HitShape:
    val idx = _draw_ir_v3_index(id, table.xs.len().to_i64())
    if idx < 0:
        return DrawIrV3HitShape(
            present: false, x: 0, y: 0, width: 0, height: 0,
            shape_kind: DRAW_IR_V3_HIT_RECT, hit_flags: 0u16, component_id: 0u32
        )
    DrawIrV3HitShape(
        present: true,
        x: table.xs[idx],
        y: table.ys[idx],
        width: table.widths[idx],
        height: table.heights[idx],
        shape_kind: table.shape_kinds[idx],
        hit_flags: table.hit_flags[idx],
        component_id: table.component_ids[idx]
    )

fn draw_ir_v3_provenance_next_id(table: DrawIrV3SourceProvenanceTable) -> u32:
    _draw_ir_v3_id_of(table.command_indices.len().to_i64())

fn draw_ir_v3_provenance_append(
    table: DrawIrV3SourceProvenanceTable, command_index: u32, edge_kind: u16,
    source_node_id: u32, source_rule_id: u32,
    source_span_start: u32, source_span_len: u32
) -> DrawIrV3SourceProvenanceTable:
    var commands = table.command_indices
    var kinds = table.edge_kinds
    var nodes = table.source_node_ids
    var rules = table.source_rule_ids
    var starts = table.source_span_starts
    var lens = table.source_span_lens
    commands.push(command_index)
    kinds.push(edge_kind)
    nodes.push(source_node_id)
    rules.push(source_rule_id)
    starts.push(source_span_start)
    lens.push(source_span_len)
    DrawIrV3SourceProvenanceTable(
        command_indices: commands, edge_kinds: kinds, source_node_ids: nodes,
        source_rule_ids: rules, source_span_starts: starts, source_span_lens: lens
    )

fn draw_ir_v3_provenance_at(table: DrawIrV3SourceProvenanceTable, id: u32) -> DrawIrV3Provenance:
    val idx = _draw_ir_v3_index(id, table.command_indices.len().to_i64())
    if idx < 0:
        return DrawIrV3Provenance(
            present: false, command_index: DRAW_IR_V3_NO_ID,
            edge_kind: DRAW_IR_V3_PROVENANCE_NONE, source_node_id: DRAW_IR_V3_NO_ID,
            source_rule_id: DRAW_IR_V3_NO_ID, source_span_start: 0u32, source_span_len: 0u32
        )
    DrawIrV3Provenance(
        present: true,
        command_index: table.command_indices[idx],
        edge_kind: table.edge_kinds[idx],
        source_node_id: table.source_node_ids[idx],
        source_rule_id: table.source_rule_ids[idx],
        source_span_start: table.source_span_starts[idx],
        source_span_len: table.source_span_lens[idx]
    )

# =========================================================================
# Scene-level command access
# =========================================================================

fn draw_ir_v3_scene_push_command(scene: DrawIrV3Scene, command: DrawIrV3Command) -> DrawIrV3Scene:
    var commands = scene.commands
    commands.push(command)
    DrawIrV3Scene(
        schema: scene.schema,
        schema_id: scene.schema_id,
        scene_id: scene.scene_id,
        generation: scene.generation,
        commands: commands,
        geometry: scene.geometry,
        paint: scene.paint,
        text_runs: scene.text_runs,
        resources: scene.resources,
        path_points: scene.path_points,
        clips: scene.clips,
        transforms: scene.transforms,
        hit_shapes: scene.hit_shapes,
        provenance: scene.provenance
    )

fn draw_ir_v3_scene_command_count(scene: DrawIrV3Scene) -> i64:
    scene.commands.len().to_i64()

fn draw_ir_v3_scene_command_at(scene: DrawIrV3Scene, index: i64) -> DrawIrV3Command:
    if index < 0 or index >= scene.commands.len().to_i64():
        return draw_ir_v3_empty_command()
    scene.commands[index]

export DRAW_IR_V3_SCHEMA_VERSION, DRAW_IR_V3_SCHEMA_ID, DRAW_IR_V3_NO_ID,
    DRAW_IR_V3_KIND_NONE, DRAW_IR_V3_KIND_RECT, DRAW_IR_V3_KIND_TEXT,
    DRAW_IR_V3_KIND_EDGE, DRAW_IR_V3_KIND_PATH, DRAW_IR_V3_KIND_IMAGE,
    DRAW_IR_V3_KIND_GROUP, DRAW_IR_V3_KIND_PORT,
    DRAW_IR_V3_FLAG_NONE, DRAW_IR_V3_FLAG_CLIPPED, DRAW_IR_V3_FLAG_TRANSFORMED,
    DRAW_IR_V3_FLAG_HIT_TESTABLE, DRAW_IR_V3_FLAG_HIDDEN,
    DRAW_IR_V3_VERB_MOVE, DRAW_IR_V3_VERB_LINE, DRAW_IR_V3_VERB_QUAD,
    DRAW_IR_V3_VERB_CUBIC, DRAW_IR_V3_VERB_CLOSE,
    DRAW_IR_V3_RESOURCE_NONE, DRAW_IR_V3_RESOURCE_IMAGE,
    DRAW_IR_V3_RESOURCE_FONT, DRAW_IR_V3_RESOURCE_VIDEO,
    DRAW_IR_V3_HIT_RECT, DRAW_IR_V3_HIT_ROUNDED_RECT, DRAW_IR_V3_HIT_ELLIPSE,
    DRAW_IR_V3_PROVENANCE_NONE, DRAW_IR_V3_PROVENANCE_PAINT_OF,
    DRAW_IR_V3_PROVENANCE_HIT_REGION_OF
