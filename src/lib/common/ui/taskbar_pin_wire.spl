val TASKBAR_PIN_WIRE_HEADER: text = "SIMPLE_TASKBAR_PINS_V1"

fn taskbar_pin_wire_field_valid(value: text) -> bool:
    value != "" and value.len() <= 256 and
        not value.contains("|") and
        not value.contains("\n") and
        not value.contains("\r")

fn taskbar_pin_wire_line(
    app_id: text, display_name: text, icon: text
) -> text:
    if (not taskbar_pin_wire_field_valid(app_id) or
        not taskbar_pin_wire_field_valid(display_name) or
        not taskbar_pin_wire_field_valid(icon)):
        return ""
    app_id + "|" + display_name + "|" + icon

fn taskbar_pin_wire_line_valid(line: text) -> bool:
    val fields = line.split("|")
    fields.len() == 3 and
        taskbar_pin_wire_field_valid(fields[0]) and
        taskbar_pin_wire_field_valid(fields[1]) and
        taskbar_pin_wire_field_valid(fields[2])

fn taskbar_pin_wire_app_id(line: text) -> text:
    if not taskbar_pin_wire_line_valid(line):
        return ""
    line.split("|")[0]

fn taskbar_pin_wire_display_name(line: text) -> text:
    if not taskbar_pin_wire_line_valid(line):
        return ""
    line.split("|")[1]

fn taskbar_pin_wire_icon(line: text) -> text:
    if not taskbar_pin_wire_line_valid(line):
        return ""
    line.split("|")[2]
