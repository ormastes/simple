# WM theme CSS/HTML parser — lets a user-provided stylesheet drive the WM
# chrome palette (titlebars, taskbar, desktop, close button) without editing
# any .spl source.
#
# Contract: 6 CSS custom properties, scoped to the WM chrome (distinct from
# the GUI widget theme's --ui-*/--app-* tokens resolved by SimpleTheme in
# common.ui.simple_theme — that pipeline stays untouched):
#   --wm-bg             desktop/compositor background
#   --wm-fg              titlebar/taskbar text color
#   --wm-accent           focused-titlebar / accent fill
#   --wm-surface          command lane / taskbar / window body fill
#   --wm-surface-hover     unfocused titlebar fill
#   --wm-error             close-button fill
#
# Any custom property missing or unparseable keeps the byte-identical
# default for that slot — see wm_chrome_colors_from_gui_tokens in
# wm_chrome_theme.spl, which this module hands its extracted tokens to
# rather than re-deriving WmChromeColors itself.
#
# Freestanding-safe: pure text scanning, no fs/env/allocator-heavy imports,
# so this module can be pulled into the in-guest/baremetal build too.

fn _wm_theme_text_index_of(haystack: text, needle: text) -> i64:
    if needle.len() == 0: return 0
    if needle.len() > haystack.len(): return -1
    var index: i64 = 0
    val limit = haystack.len() - needle.len()
    while index <= limit:
        if haystack.substring(index, index + needle.len()) == needle:
            return index
        index = index + 1
    -1
#
# Design note (2026-07-29, lane F2 — host-side wiring landed): the reusable
# lazy-apply entry point is apply_wm_css_theme_text() below — call it AFTER
# fs/VFS is available (e.g. after SIMPLE_WM_THEME_FILE is read on the hosted
# hosted_entry.spl path, or after a mounted /THEME.CSS is read on the guest
# freestanding path), never at module init. When a generated/package snapshot
# is active, it derives and re-installs an effective snapshot before retaining
# the exact chrome palette. Empty/garbage CSS text is a no-op, so whatever
# theme was already installed (defaults, or an earlier package/snapshot install)
# survives untouched — see simpleos_wm_theme_bootstrap.spl's
# apply_simpleos_css_theme_override() for the guest-side call point this
# hands off to.
#
# Guest desktop entries read a mounted /THEME.CSS only after VFS startup and
# feed this function through apply_simpleos_css_theme_override(). This parser
# remains deliberately free of fs/env access so that boot-order boundary stays
# explicit at the entry point.

use common.ui.wm_chrome_theme.{WmChromeColors, active_wm_theme_snapshot_present, active_wm_theme_snapshot_unchecked, apply_theme_render_snapshot_to_wm_chrome, register_wm_chrome_theme, theme_render_snapshot_with_wm_colors, wm_chrome_colors_from_gui_tokens}

# Unique `wtc_` field prefix dodges the most-fields-wins struct-inference
# landmine when multiple small text-only structs are in scope.
struct WmThemeCssTokens:
    wtc_bg: text
    wtc_fg: text
    wtc_accent: text
    wtc_surface: text
    wtc_surface_hover: text
    wtc_error: text

fn _wm_theme_is_ws(c: text) -> bool:
    if c == " ":
        return true
    if c == "\t":
        return true
    if c == "\n":
        return true
    if c == "\r":
        return true
    false

fn _wm_theme_skip_ws(css: text, pos: i64) -> i64:
    var i = pos
    val n = css.len()
    while i < n:
        if _wm_theme_is_ws(css.char_at(i)):
            i = i + 1
        else:
            return i
    i

fn _wm_theme_find_terminator(css: text, pos: i64) -> i64:
    # First of ';' or '}' at/after pos; end-of-text if neither appears.
    val rest = css.substring(pos, css.len())
    val semi = _wm_theme_text_index_of(rest, ";")
    val brace = _wm_theme_text_index_of(rest, "}")
    if semi < 0 and brace < 0:
        return css.len()
    if semi < 0:
        return pos + brace
    if brace < 0:
        return pos + semi
    if semi < brace:
        return pos + semi
    pos + brace

fn _wm_theme_css_value(css: text, prop: text) -> text:
    # Scans for `prop` followed (after optional whitespace) by ':'. This
    # ordering also disambiguates prefix collisions for free — e.g. a scan
    # for "--wm-surface" that lands on "--wm-surface-hover: ..." finds '-'
    # (not ':') right after the name and keeps searching past it, so it
    # never mismatches onto the longer property.
    var search_from = 0
    val css_len = css.len()
    while search_from < css_len:
        val remaining = css.substring(search_from, css_len)
        val rel = _wm_theme_text_index_of(remaining, prop)
        if rel < 0:
            return ""
        val name_start = search_from + rel
        val after_name = name_start + prop.len()
        val colon_pos = _wm_theme_skip_ws(css, after_name)
        if colon_pos < css_len and css.char_at(colon_pos) == ":":
            val value_start = colon_pos + 1
            val term = _wm_theme_find_terminator(css, value_start)
            return css.substring(value_start, term).trim()
        search_from = after_name
    ""

fn _wm_theme_strip_css_comments(css: text) -> text:
    # Comment-tolerant: `/* ... */` spans are dropped before scanning so a
    # commented-out `--wm-bg: #000;` never shadows the real declaration.
    var out = ""
    var rest = css
    while true:
        val start = _wm_theme_text_index_of(rest, "/*")
        if start < 0:
            return out + rest
        out = out + rest.substring(0, start)
        val after = rest.substring(start + 2, rest.len())
        val end = _wm_theme_text_index_of(after, "*/")
        if end < 0:
            return out
        rest = after.substring(end + 2, after.len())
    out

fn wm_theme_tokens_from_css(css: text) -> WmThemeCssTokens:
    """Scan raw CSS text for the 6 --wm-* custom properties. Absent/garbage
    tokens come back as "" — callers (wm_chrome_colors_from_gui_tokens) fall
    back to the default color for that slot."""
    val clean = _wm_theme_strip_css_comments(css)
    WmThemeCssTokens(
        wtc_bg: _wm_theme_css_value(clean, "--wm-bg"),
        wtc_fg: _wm_theme_css_value(clean, "--wm-fg"),
        wtc_accent: _wm_theme_css_value(clean, "--wm-accent"),
        wtc_surface: _wm_theme_css_value(clean, "--wm-surface"),
        wtc_surface_hover: _wm_theme_css_value(clean, "--wm-surface-hover"),
        wtc_error: _wm_theme_css_value(clean, "--wm-error")
    )

fn _wm_theme_extract_style_blocks(html: text) -> text:
    # Concatenates the contents of every <style>...</style> block. Simple
    # lowercase tag match (no full HTML/XML parsing needed for this).
    val lower = html.lower()
    val n = html.len()
    var out = ""
    var search_from = 0
    while search_from < n:
        val open_rel = _wm_theme_text_index_of(lower.substring(search_from, n), "<style")
        if open_rel < 0:
            return out
        val open_abs = search_from + open_rel
        val gt_rel = _wm_theme_text_index_of(lower.substring(open_abs, n), ">")
        if gt_rel < 0:
            return out
        val content_start = open_abs + gt_rel + 1
        val close_rel = _wm_theme_text_index_of(lower.substring(content_start, n), "</style")
        if close_rel < 0:
            return out + html.substring(content_start, n)
        val content_end = content_start + close_rel
        out = out + html.substring(content_start, content_end) + "\n"
        search_from = content_end
    out

fn wm_theme_tokens_from_html(html: text) -> WmThemeCssTokens:
    """Extract <style> block contents and parse those as CSS. A file with no
    <style> tags is treated as raw CSS, so plain .css files also work
    through this entry point."""
    val css = _wm_theme_extract_style_blocks(html)
    if css == "":
        return wm_theme_tokens_from_css(html)
    wm_theme_tokens_from_css(css)

fn wm_chrome_colors_from_css_text(content: text) -> WmChromeColors:
    """Top-level entry: user-provided .css or .html theme file text -> a
    full WmChromeColors palette, via the existing GUI-token bridge
    (wm_chrome_colors_from_gui_tokens) so per-slot default fallback stays in
    exactly one place."""
    val tokens = wm_theme_tokens_from_html(content)
    wm_chrome_colors_from_gui_tokens(
        tokens.wtc_bg,
        tokens.wtc_fg,
        tokens.wtc_accent,
        tokens.wtc_surface,
        tokens.wtc_surface_hover,
        tokens.wtc_error)

fn _wm_theme_tokens_all_absent(tokens: WmThemeCssTokens) -> bool:
    if tokens.wtc_bg != "":
        return false
    if tokens.wtc_fg != "":
        return false
    if tokens.wtc_accent != "":
        return false
    if tokens.wtc_surface != "":
        return false
    if tokens.wtc_surface_hover != "":
        return false
    if tokens.wtc_error != "":
        return false
    true

fn apply_wm_css_theme_text(content: text) -> bool:
    """Lazy wiring point: parse `content` (a loaded .css or .html theme
    file's text) and, if at least one of the 6 --wm-* tokens parsed,
    install the resulting palette so every chrome pipeline
    (wm_chrome_theme()) picks it up on the next scene projection. When a
    renderer-neutral snapshot is already active, first derive and install an
    effective snapshot with matching durable material/identity; this keeps
    theme wire, Draw IR, and cache consumers from observing the pre-override
    material fingerprint. The exact palette is then registered because the
    CSS --wm-error and compositor-only slots have no ThemeRenderSnapshot
    field. Returns true when an override was installed.

    Fallback contract: if none of the 6 tokens parse (content is empty,
    garbage, or has no recognizable --wm-* declarations at all), this is a
    no-op and returns false — the currently active chrome palette (byte-
    identical defaults, or whatever was registered before this call, e.g. a
    generated/package theme snapshot) is left untouched rather than being
    overwritten with an all-default WmChromeColors.

    Callers MUST invoke this only once fs/VFS access is available (after
    mount, never at module init) — see the design note atop this file."""
    val tokens = wm_theme_tokens_from_html(content)
    if _wm_theme_tokens_all_absent(tokens):
        return false
    val colors = wm_chrome_colors_from_gui_tokens(
        tokens.wtc_bg,
        tokens.wtc_fg,
        tokens.wtc_accent,
        tokens.wtc_surface,
        tokens.wtc_surface_hover,
        tokens.wtc_error)
    if active_wm_theme_snapshot_present():
        val base_snapshot = active_wm_theme_snapshot_unchecked()
        val effective_snapshot = theme_render_snapshot_with_wm_colors(
            base_snapshot, colors)
        apply_theme_render_snapshot_to_wm_chrome(effective_snapshot)
    # Keep CSS-only chrome values such as --wm-error exact after snapshot
    # projection, whose material vocabulary intentionally has no close-button
    # or command-lane fields.
    register_wm_chrome_theme(colors)
    true
