# GPU Web Receipt Contract — frozen C0 contract: epoch/fault/fallback receipts.
#
# Contract source (frozen):
#   doc/03_plan/ui/gpu_web_scene_offload_mdsoc_plus_plan.md
#     §1 (healthy-path receipts), §7 "Minimizing CPU fallback" (levels L0–L5,
#     cpu_selected vs gpu_fallback), §14 acceptance gates.
# Shared lane rules:
#   doc/03_plan/platform/structural_compute/README.md (rule 4: no silent
#   fallback — every fallback carries a reason receipt).
#
# The CPU never receives DOM/style/layout/DrawIR/pixels on the healthy path —
# only these compact records. A cost-policy CPU route is CPU_SELECTED and is
# NOT a fallback; reporting it as GPU success or hiding it are both defects.

pub val GPU_WEB_RECEIPT_SCHEMA_VERSION: text = "simple-gpu-web-receipt-v1"
pub val GPU_WEB_RECEIPT_SCHEMA_ID: u32 = 1u32

# ---------------------------------------------------------------------------
# Receipt kinds (plan §1)
# ---------------------------------------------------------------------------

pub val GPU_RECEIPT_EPOCH_COMPLETED: u16 = 1u16
pub val GPU_RECEIPT_HOST_EFFECT_REQUESTED: u16 = 2u16
pub val GPU_RECEIPT_CAPACITY_OVERFLOW: u16 = 3u16
pub val GPU_RECEIPT_UNSUPPORTED_FEATURE: u16 = 4u16
pub val GPU_RECEIPT_DEVICE_FAULT: u16 = 5u16
pub val GPU_RECEIPT_ACCESSIBILITY_SNAPSHOT: u16 = 6u16

# ---------------------------------------------------------------------------
# Fallback hierarchy (plan §7). Lower level = more GPU-resident.
# ---------------------------------------------------------------------------

pub val GPU_FALLBACK_L0_GPU_NATIVE: u16 = 0u16
pub val GPU_FALLBACK_L1_HOST_EFFECT: u16 = 1u16
pub val GPU_FALLBACK_L2_STAGE_SERVICE: u16 = 2u16
pub val GPU_FALLBACK_L3_SUBTREE_COMPAT: u16 = 3u16
pub val GPU_FALLBACK_L4_DOCUMENT_COMPAT: u16 = 4u16
pub val GPU_FALLBACK_L5_DEVICE_RECOVERY: u16 = 5u16

# Routing decisions distinct from fallback (plan §7 "Avoiding accidental
# fallback" rule 7).
pub val GPU_ROUTE_GPU: u16 = 0u16
pub val GPU_ROUTE_CPU_SELECTED: u16 = 1u16
pub val GPU_ROUTE_GPU_FALLBACK: u16 = 2u16

# Strict GPU verification accepts only L0/L1 (plan §7 targets).
fn gpu_fallback_is_strict_pass(level: u16) -> bool:
    return level <= GPU_FALLBACK_L1_HOST_EFFECT

# Standards compatibility profile accepts L0–L3, all reported.
fn gpu_fallback_is_compat_pass(level: u16) -> bool:
    return level <= GPU_FALLBACK_L3_SUBTREE_COMPAT

# ---------------------------------------------------------------------------
# Receipt records
# ---------------------------------------------------------------------------

struct GpuSceneEpochReceipt:
    kind: u16
    scene_generation: u64
    event_sequence_first: u64
    event_sequence_last: u64
    mutations_applied: u32
    host_effects_requested: u32
    fallback_level: u16
    route: u16
    elapsed_us: u64
    deterministic_hash_lo: u64
    deterministic_hash_hi: u64

struct GpuFaultReceipt:
    kind: u16
    scene_generation: u64
    fallback_level: u16
    # Numeric capability/feature bit that failed (plan §7 rule 2);
    # 0 when the fault is not feature-scoped (device loss, OOM).
    feature_bit: u32
    subtree_node_id: u32
    subtree_node_generation: u32
    reason_code: u32
    detail_offset: u32
    detail_length: u32

struct GpuOverflowReceipt:
    kind: u16
    scene_generation: u64
    # Which capacity-manifest bound overflowed; names the bound so the
    # rejection is diagnosable (capacity contract honesty rule).
    bound_id: u16
    requested: u64
    limit: u64

# ---------------------------------------------------------------------------
# Ports (plan §9)
# ---------------------------------------------------------------------------

trait GpuFaultReceiptPort:
    """Drain fault/overflow receipts; never returns pixels or scene state."""
    fn drain_faults(max_count: i64) -> [GpuFaultReceipt]
    fn drain_overflows(max_count: i64) -> [GpuOverflowReceipt]

trait GpuDebugSnapshotPort:
    """Explicit debug-only snapshot request (test/shadow mode; forbidden on
    the production healthy path)."""
    fn request_snapshot(scene_generation: u64) -> bool

export GPU_WEB_RECEIPT_SCHEMA_VERSION, GPU_WEB_RECEIPT_SCHEMA_ID,
    GPU_RECEIPT_EPOCH_COMPLETED, GPU_RECEIPT_HOST_EFFECT_REQUESTED,
    GPU_RECEIPT_CAPACITY_OVERFLOW, GPU_RECEIPT_UNSUPPORTED_FEATURE,
    GPU_RECEIPT_DEVICE_FAULT, GPU_RECEIPT_ACCESSIBILITY_SNAPSHOT,
    GPU_FALLBACK_L0_GPU_NATIVE, GPU_FALLBACK_L1_HOST_EFFECT,
    GPU_FALLBACK_L2_STAGE_SERVICE, GPU_FALLBACK_L3_SUBTREE_COMPAT,
    GPU_FALLBACK_L4_DOCUMENT_COMPAT, GPU_FALLBACK_L5_DEVICE_RECOVERY,
    GPU_ROUTE_GPU, GPU_ROUTE_CPU_SELECTED, GPU_ROUTE_GPU_FALLBACK,
    gpu_fallback_is_strict_pass, gpu_fallback_is_compat_pass,
    GpuSceneEpochReceipt, GpuFaultReceipt, GpuOverflowReceipt,
    GpuFaultReceiptPort, GpuDebugSnapshotPort
