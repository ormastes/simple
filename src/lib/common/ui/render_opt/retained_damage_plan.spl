# Backend-neutral bridge from retained DrawIR frame receipts to the shared
# multiscale CPU/Vulkan damage planner. DrawIR remains free of cache, tile,
# backend, and presentation state.

use common.ui.render_opt.retained_draw_ir_frame.{
    RetainedDrawIrReceipt, RETAINED_FRAME_REJECTED
}
use common.ui.render_opt.damage_tiles.DirtyTilePyramid
use common.ui.render_opt.damage_plan.{
    DamageFramePlan, build_damage_frame_plan
}

class RetainedDamagePlanReceipt:
    accepted: bool
    source_rect_count: i64
    marked_tile_count: i64
    plan: DamageFramePlan

fn retained_damage_plan(pyramid: DirtyTilePyramid,
                        receipt: RetainedDrawIrReceipt,
                        level: i64,
                        max_rects: i64,
                        full_threshold_percent: i64) -> RetainedDamagePlanReceipt:
    pyramid.begin_frame()
    var source_rect_count: i64 = 0
    if receipt.mode != RETAINED_FRAME_REJECTED:
        var i: i64 = 0
        val damage_len = receipt.damage_rects.len()
        while i + 3 < damage_len:
            pyramid.mark_rect(
                receipt.damage_rects[i], receipt.damage_rects[i + 1],
                receipt.damage_rects[i + 2], receipt.damage_rects[i + 3])
            source_rect_count = source_rect_count + 1
            i = i + 4
    val plan = build_damage_frame_plan(
        pyramid, level, max_rects, full_threshold_percent)
    RetainedDamagePlanReceipt(
        accepted: receipt.mode != RETAINED_FRAME_REJECTED,
        source_rect_count: source_rect_count,
        marked_tile_count: pyramid.dirty_count(level),
        plan: plan)

export RetainedDamagePlanReceipt, retained_damage_plan
