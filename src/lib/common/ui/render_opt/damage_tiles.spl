# Backend-agnostic multiscale damage tiles for retained DrawIR rendering.
# PropertyTrees remains the invalidation owner; this module indexes its exact
# rectangles for bounded CPU/GPU iteration without changing DrawIR.

use common.ui.render_opt.property_trees.{PropertyTrees}

class DirtyTilePyramid:
    viewport_w: i64
    viewport_h: i64
    tile_w: [i64]
    tile_h: [i64]
    cols: [i64]
    rows: [i64]
    level_offset: [i64]
    level_capacity: [i64]
    tile_epoch: [i64]
    dirty_id: [i64]
    dirty_len: [i64]
    frame_epoch: i64
    valid: bool

    static fn create(viewport_w: i64, viewport_h: i64,
                     tile_ws: [i64], tile_hs: [i64]) -> DirtyTilePyramid:
        var widths: [i64] = []
        var heights: [i64] = []
        var grid_cols: [i64] = []
        var grid_rows: [i64] = []
        var offsets: [i64] = []
        var capacities: [i64] = []
        var lengths: [i64] = []
        var total: i64 = 0
        var ok = viewport_w > 0 and viewport_h > 0
        if tile_ws.len() == 0 or tile_ws.len() != tile_hs.len():
            ok = false
        var level: i64 = 0
        while level < tile_ws.len() and ok:
            val tw = tile_ws[level]
            val th = tile_hs[level]
            if tw <= 0 or th <= 0:
                ok = false
            else:
                val c = (viewport_w - 1) / tw + 1
                val r = (viewport_h - 1) / th + 1
                if c <= 0 or r <= 0 or c > 2147483647 / r:
                    ok = false
                else:
                    val capacity = c * r
                    if capacity > 16777216 - total:
                        ok = false
                        level += 1
                        continue
                    widths.push(tw)
                    heights.push(th)
                    grid_cols.push(c)
                    grid_rows.push(r)
                    offsets.push(total)
                    capacities.push(capacity)
                    lengths.push(0)
                    total += capacity
            level += 1
        var epochs: [i64] = []
        var ids: [i64] = []
        var i: i64 = 0
        while i < total:
            epochs.push(0)
            ids.push(0)
            i += 1
        DirtyTilePyramid(
            viewport_w: viewport_w, viewport_h: viewport_h,
            tile_w: widths, tile_h: heights, cols: grid_cols,
            rows: grid_rows, level_offset: offsets,
            level_capacity: capacities, tile_epoch: epochs,
            dirty_id: ids, dirty_len: lengths, frame_epoch: 1,
            valid: ok)

    me level_count() -> i64:
        self.tile_w.len()

    me begin_frame():
        if self.frame_epoch == 9223372036854775807:
            var i: i64 = 0
            while i < self.tile_epoch.len():
                self.tile_epoch[i] = 0
                i += 1
            self.frame_epoch = 1
        else:
            self.frame_epoch = self.frame_epoch + 1
        var level: i64 = 0
        while level < self.dirty_len.len():
            self.dirty_len[level] = 0
            level += 1

    me mark_rect(x: i64, y: i64, w: i64, h: i64):
        if not self.valid or w <= 0 or h <= 0:
            return
        if x > 9223372036854775807 - w or y > 9223372036854775807 - h:
            return
        var x0 = x
        var y0 = y
        var x1 = x + w
        var y1 = y + h
        if x1 <= 0 or y1 <= 0 or x0 >= self.viewport_w or y0 >= self.viewport_h:
            return
        if x0 < 0: x0 = 0
        if y0 < 0: y0 = 0
        if x1 > self.viewport_w: x1 = self.viewport_w
        if y1 > self.viewport_h: y1 = self.viewport_h
        if x0 >= x1 or y0 >= y1:
            return
        var level: i64 = 0
        while level < self.tile_w.len():
            val tx0 = x0 / self.tile_w[level]
            val ty0 = y0 / self.tile_h[level]
            val tx1 = (x1 - 1) / self.tile_w[level]
            val ty1 = (y1 - 1) / self.tile_h[level]
            var ty = ty0
            while ty <= ty1:
                var tx = tx0
                while tx <= tx1:
                    val local_id = ty * self.cols[level] + tx
                    val slot = self.level_offset[level] + local_id
                    if self.tile_epoch[slot] != self.frame_epoch:
                        self.tile_epoch[slot] = self.frame_epoch
                        val out = self.level_offset[level] + self.dirty_len[level]
                        self.dirty_id[out] = local_id
                        self.dirty_len[level] = self.dirty_len[level] + 1
                    tx += 1
                ty += 1
            level += 1

    me dirty_count(level: i64) -> i64:
        if level < 0 or level >= self.dirty_len.len():
            return 0
        self.dirty_len[level]

    me dirty_rects(level: i64) -> [i64]:
        var rects: [i64] = []
        if level < 0 or level >= self.dirty_len.len():
            return rects
        var local_id: i64 = 0
        while local_id < self.level_capacity[level]:
            val slot = self.level_offset[level] + local_id
            if self.tile_epoch[slot] != self.frame_epoch:
                local_id += 1
                continue
            val tx = local_id % self.cols[level]
            val ty = local_id / self.cols[level]
            val x = tx * self.tile_w[level]
            val y = ty * self.tile_h[level]
            var w = self.tile_w[level]
            var h = self.tile_h[level]
            if x + w > self.viewport_w: w = self.viewport_w - x
            if y + h > self.viewport_h: h = self.viewport_h - y
            rects.push(x)
            rects.push(y)
            rects.push(w)
            rects.push(h)
            local_id += 1
        rects

fn damage_tiles_mark_property_damage(pyramid: DirtyTilePyramid,
                                     trees: PropertyTrees):
    var i: i64 = 0
    while i < trees.damage_len:
        pyramid.mark_rect(
            trees.damage_x[i] as i64, trees.damage_y[i] as i64,
            trees.damage_w[i] as i64, trees.damage_h[i] as i64)
        i += 1

export DirtyTilePyramid, damage_tiles_mark_property_damage
