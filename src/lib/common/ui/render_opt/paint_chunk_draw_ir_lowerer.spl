# Canonical full-frame PaintChunk -> DrawIR lowering seam for retained
# rendering.  It is intentionally conservative: every valid chunk is emitted
# in source order.  Visibility/occlusion must be wired only after the delta
# transaction can represent removals without leaving old commands alive.

use common.ui.render_opt.property_trees.PaintChunks
use common.ui.render_opt.paint_chunk_rasterizer.PaintChunkRects
use common.ui.draw_ir.{
    DrawIrCommand, DrawIrComposition, DrawIrEmbeddingConfig, DrawIrSourceInfo,
    draw_ir_rect, draw_ir_batch_with_source, draw_ir_composition
}
use common.ui.render_opt.draw_ir_delta.{
    DrawIrStableOp, DrawIrStableTransaction,
    draw_ir_stable_upsert, draw_ir_stable_remove,
    draw_ir_stable_transaction
}

struct PaintChunkDrawIrLowering:
    valid: bool
    reason: text
    commands: [DrawIrCommand]
    emitted_count: i64
    total_count: i64

# This adapter intentionally has no retained cache or executor ownership.  It
# makes the producer boundary explicit: a complete full lowering produces both
# the canonical composition and a transaction whose operations can be applied
# atomically by the retained DrawIR owner.  A future production caller must
# supply the source/embedding metadata and stable IDs; it must not reconstruct
# them from paint order or owners.
struct PaintChunkDrawIrCompositionResult:
    valid: bool
    reason: text
    composition: DrawIrComposition?
    commands: [DrawIrCommand]

struct PaintChunkDrawIrTransactionResult:
    valid: bool
    reason: text
    transaction: DrawIrStableTransaction?

fn _paint_chunk_draw_ir_invalid(reason: text, total_count: i64) -> PaintChunkDrawIrLowering:
    PaintChunkDrawIrLowering(
        valid: false, reason: reason, commands: [], emitted_count: 0,
        total_count: total_count)

fn _paint_chunk_draw_ir_i32(value: i64) -> bool:
    value >= -2147483648 and value <= 2147483647

fn _paint_chunk_draw_ir_rect_valid(rects: PaintChunkRects, index: i64) -> bool:
    val x = rects.rect_x[index]
    val y = rects.rect_y[index]
    val width = rects.rect_w[index]
    val height = rects.rect_h[index]
    val colour = rects.colour[index]
    _paint_chunk_draw_ir_i32(x) and _paint_chunk_draw_ir_i32(y) and
        width > 0 and height > 0 and _paint_chunk_draw_ir_i32(width) and
        _paint_chunk_draw_ir_i32(height) and colour >= 0 and colour <= 4294967295

# `stable_command_ids` is producer-owned: one nonempty, unique value per
# chunk, rather than an inferred owner ID.  This preserves repeated owners and
# gives a future upsert/remove transaction a durable command key.
fn paint_chunk_draw_ir_lower_full(chunks: PaintChunks, rects: PaintChunkRects,
                                  stable_command_ids: [text]) -> PaintChunkDrawIrLowering:
    val total = chunks.chunk_count
    if total < 0 or rects.rect_count != total or stable_command_ids.len() != total or
       chunks.owner.len() != total:
        return _paint_chunk_draw_ir_invalid("paint-chunk-draw-ir-shape-mismatch", total)

    var seen: Dict<text, bool> = {}
    var commands: [DrawIrCommand] = []
    var index: i64 = 0
    while index < total:
        val command_id = stable_command_ids[index]
        if command_id.len() == 0:
            return _paint_chunk_draw_ir_invalid("paint-chunk-draw-ir-empty-stable-id", total)
        if seen.has(command_id):
            return _paint_chunk_draw_ir_invalid("paint-chunk-draw-ir-duplicate-stable-id", total)
        if not _paint_chunk_draw_ir_rect_valid(rects, index):
            return _paint_chunk_draw_ir_invalid("paint-chunk-draw-ir-invalid-rect", total)
        seen[command_id] = true
        commands.push(draw_ir_rect(
            command_id,
            rects.rect_x[index].to_i32(), rects.rect_y[index].to_i32(),
            rects.rect_w[index].to_i32(), rects.rect_h[index].to_i32(),
            rects.colour[index].to_u32()))
        index = index + 1
    PaintChunkDrawIrLowering(
        valid: true, reason: "", commands: commands, emitted_count: commands.len(),
        total_count: total)

fn _paint_chunk_draw_ir_composition_invalid(reason: text) -> PaintChunkDrawIrCompositionResult:
    PaintChunkDrawIrCompositionResult(
        valid: false, reason: reason, composition: nil, commands: [])

# Wrap one complete ordered PaintChunk lowering in one source-owned batch.  No
# command is dropped or reordered here; culling remains a separate, disabled
# consumer until exact opaque proofs and a real production producer exist.
fn paint_chunk_draw_ir_lower_composition(
    chunks: PaintChunks, rects: PaintChunkRects, stable_command_ids: [text],
    composition_id: text, scene_key: text, backend_target: text, batch_id: text,
    embedding: DrawIrEmbeddingConfig, source: DrawIrSourceInfo
) -> PaintChunkDrawIrCompositionResult:
    if composition_id.len() == 0 or scene_key.len() == 0 or
       backend_target.len() == 0 or batch_id.len() == 0:
        return _paint_chunk_draw_ir_composition_invalid(
            "paint-chunk-draw-ir-invalid-composition-metadata")
    val lowered = paint_chunk_draw_ir_lower_full(chunks, rects, stable_command_ids)
    if not lowered.valid:
        return _paint_chunk_draw_ir_composition_invalid(lowered.reason)
    val batch = draw_ir_batch_with_source(
        batch_id, backend_target, embedding, lowered.commands, source)
    PaintChunkDrawIrCompositionResult(
        valid: true, reason: "",
        composition: draw_ir_composition(
            composition_id, scene_key, backend_target, [batch]),
        commands: lowered.commands)

fn _paint_chunk_draw_ir_transaction_invalid(reason: text) -> PaintChunkDrawIrTransactionResult:
    PaintChunkDrawIrTransactionResult(valid: false, reason: reason, transaction: nil)

# Build a complete stable-ID transaction from a trusted full lowering.  It
# emits an upsert for every target command (including unchanged ones) and a
# tombstone for every prior ID absent from the target.  This is intentionally
# not a delta optimizer: the transaction's value is atomic remove/reorder
# correctness, which must exist before visibility can suppress any command.
fn paint_chunk_draw_ir_full_transaction(
    previous: [DrawIrCommand], base_revision: text, target_revision: text,
    lowered: PaintChunkDrawIrCompositionResult
) -> PaintChunkDrawIrTransactionResult:
    if not lowered.valid or lowered.composition == nil:
        return _paint_chunk_draw_ir_transaction_invalid(
            "paint-chunk-draw-ir-invalid-full-lowering")
    if base_revision.len() == 0 or target_revision.len() == 0 or
       target_revision == base_revision:
        return _paint_chunk_draw_ir_transaction_invalid(
            "paint-chunk-draw-ir-invalid-transaction-revision")

    var target_ids: [text] = []
    var target_set: Dict<text, bool> = {}
    var operations: [DrawIrStableOp] = []
    for command in lowered.commands:
        val stable_id = command.component_id
        if stable_id.len() == 0 or target_set.has(stable_id):
            return _paint_chunk_draw_ir_transaction_invalid(
                "paint-chunk-draw-ir-invalid-target-identity")
        target_set[stable_id] = true
        target_ids.push(stable_id)
        operations.push(draw_ir_stable_upsert(stable_id, command))
    for command in previous:
        if not target_set.has(command.component_id):
            operations.push(draw_ir_stable_remove(command.component_id))
    PaintChunkDrawIrTransactionResult(
        valid: true, reason: "",
        transaction: draw_ir_stable_transaction(
            base_revision, target_revision, target_ids, operations))

export PaintChunkDrawIrLowering, PaintChunkDrawIrCompositionResult,
       PaintChunkDrawIrTransactionResult, paint_chunk_draw_ir_lower_full,
       paint_chunk_draw_ir_lower_composition,
       paint_chunk_draw_ir_full_transaction
