# Retained WM damage consumer (O2).  This is deliberately a bridge from the
# compositor-owned PropertyTrees damage sink to the shared retained scheduler:
# it does not add cache state, backend names, or producer IR to DrawIR.

use common.ui.render_opt.property_trees.PropertyTrees
use common.ui.render_opt.damage_tiles.DirtyTilePyramid
use common.ui.render_opt.retained_draw_ir_frame.{
    RetainedDrawIrReceipt, RETAINED_FRAME_PATCH, RETAINED_FRAME_REJECTED
}
use common.ui.render_opt.retained_damage_plan.retained_damage_plan
use common.ui.render_opt.retained_frame_schedule.{
    RetainedFrameSchedule, retained_frame_schedule
}

# Coarse accounting remains available for escalation; CPU raster plans use
# 64px tiles and an external retained presenter uses 32px tiles.  The values
# are declaration-level contract, never encoded in DrawIR.
val WM_DAMAGE_LEVEL_COARSE: i64 = 0
val WM_DAMAGE_LEVEL_CPU: i64 = 1
val WM_DAMAGE_LEVEL_PRESENTER: i64 = 2
val WM_DAMAGE_MAX_RECTS: i64 = 64
val WM_DAMAGE_FULL_THRESHOLD_PERCENT: i64 = 60

class WmRetainedDamageConsumer:
    pyramid: DirtyTilePyramid
    frame_generation: i64

    static fn create(viewport_w: i32, viewport_h: i32) -> WmRetainedDamageConsumer:
        val width = if viewport_w > 0: viewport_w.to_u32() else: 0u32
        val height = if viewport_h > 0: viewport_h.to_u32() else: 0u32
        WmRetainedDamageConsumer(
            pyramid: DirtyTilePyramid.create(
                width, height, [256u32, 64u32, 32u32],
                [256u32, 64u32, 32u32]),
            frame_generation: 0)

    fn planning_level(external_presenter: bool) -> i64:
        if external_presenter:
            return WM_DAMAGE_LEVEL_PRESENTER
        WM_DAMAGE_LEVEL_CPU

    # Copy one current PropertyTrees damage frame into a canonical retained
    # receipt.  The source remains property-tree owned; retained_damage_plan
    # advances the persistent pyramid epoch and never mutates `trees`.
    me schedule(trees: PropertyTrees, external_presenter: bool,
                frame_budget_ns: i64, measured_row_width: i64,
                measured_row_p95_ns: i64, budget_basis: text) -> RetainedFrameSchedule:
        self.frame_generation = self.frame_generation + 1
        var valid = trees.damage_len >= 0
        if (trees.damage_x.len() < trees.damage_len or
            trees.damage_y.len() < trees.damage_len or
            trees.damage_w.len() < trees.damage_len or
            trees.damage_h.len() < trees.damage_len):
            valid = false
        var rects: [i64] = []
        var index: i64 = 0
        if valid:
            while index < trees.damage_len:
                rects.push(trees.damage_x[index] as i64)
                rects.push(trees.damage_y[index] as i64)
                rects.push(trees.damage_w[index] as i64)
                rects.push(trees.damage_h[index] as i64)
                index = index + 1
        val receipt = RetainedDrawIrReceipt(
            mode: if valid: RETAINED_FRAME_PATCH else: RETAINED_FRAME_REJECTED,
            command_count: 0, command_writes: 0,
            frame_generation: self.frame_generation,
            reason: if valid: "wm-property-damage" else: "wm-property-damage-shape-invalid",
            damage_mode: 1, damage_rects: rects)
        val damage = retained_damage_plan(
            self.pyramid, receipt, self.planning_level(external_presenter),
            WM_DAMAGE_MAX_RECTS, WM_DAMAGE_FULL_THRESHOLD_PERCENT)
        retained_frame_schedule(
            damage, frame_budget_ns, measured_row_width,
            measured_row_p95_ns, budget_basis)

export WmRetainedDamageConsumer
export WM_DAMAGE_LEVEL_COARSE, WM_DAMAGE_LEVEL_CPU,
       WM_DAMAGE_LEVEL_PRESENTER
