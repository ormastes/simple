# Measured frame-budget admission for retained damage plans.
#
# Profiles are supplied as evidence (one full-width row p95), keeping this
# module backend/ISA neutral. Admission is deliberately separate from damage
# correctness: a rejected plan is still correct, but cannot honestly claim the
# requested frame rate on the measured operation mix.

use common.ui.render_opt.damage_plan.{
    DamageFramePlan, DAMAGE_PLAN_NONE, DAMAGE_PLAN_LOCAL, DAMAGE_PLAN_FULL
}

val DAMAGE_BUDGET_IDLE: i64 = 0
val DAMAGE_BUDGET_ADMIT_LOCAL: i64 = 1
val DAMAGE_BUDGET_ADMIT_FULL: i64 = 2
val DAMAGE_BUDGET_REJECT: i64 = 3
val DAMAGE_BUDGET_INVALID: i64 = 4

class DamageBudgetReceipt:
    status: i64
    admitted: bool
    frame_budget_ns: i64
    measured_row_width: i64
    measured_row_p95_ns: i64
    planned_pixels: i64
    maximum_pixels: i64
    predicted_ns: i64
    budget_basis: text

fn admit_damage_plan_budget(plan: DamageFramePlan,
                            frame_budget_ns: i64,
                            measured_row_width: i64,
                            measured_row_p95_ns: i64,
                            budget_basis: text) -> DamageBudgetReceipt:
    if (frame_budget_ns <= 0 or measured_row_width <= 0 or
        measured_row_p95_ns <= 0 or plan.planned_pixels < 0):
        return DamageBudgetReceipt(
            status: DAMAGE_BUDGET_INVALID, admitted: false,
            frame_budget_ns: frame_budget_ns,
            measured_row_width: measured_row_width,
            measured_row_p95_ns: measured_row_p95_ns,
            planned_pixels: plan.planned_pixels, maximum_pixels: 0,
            predicted_ns: 0, budget_basis: budget_basis)
    val maximum_pixels = (
        frame_budget_ns * measured_row_width) / measured_row_p95_ns
    val predicted_ns = (
        plan.planned_pixels * measured_row_p95_ns + measured_row_width - 1
    ) / measured_row_width
    if plan.mode == DAMAGE_PLAN_NONE:
        return DamageBudgetReceipt(
            status: DAMAGE_BUDGET_IDLE, admitted: true,
            frame_budget_ns: frame_budget_ns,
            measured_row_width: measured_row_width,
            measured_row_p95_ns: measured_row_p95_ns,
            planned_pixels: 0, maximum_pixels: maximum_pixels,
            predicted_ns: 0, budget_basis: budget_basis)
    val admitted = plan.planned_pixels <= maximum_pixels
    var status = DAMAGE_BUDGET_REJECT
    if admitted and plan.mode == DAMAGE_PLAN_LOCAL:
        status = DAMAGE_BUDGET_ADMIT_LOCAL
    elif admitted and plan.mode == DAMAGE_PLAN_FULL:
        status = DAMAGE_BUDGET_ADMIT_FULL
    DamageBudgetReceipt(
        status: status, admitted: admitted,
        frame_budget_ns: frame_budget_ns,
        measured_row_width: measured_row_width,
        measured_row_p95_ns: measured_row_p95_ns,
        planned_pixels: plan.planned_pixels,
        maximum_pixels: maximum_pixels,
        predicted_ns: predicted_ns, budget_basis: budget_basis)

export DamageBudgetReceipt, admit_damage_plan_budget
export DAMAGE_BUDGET_IDLE, DAMAGE_BUDGET_ADMIT_LOCAL,
       DAMAGE_BUDGET_ADMIT_FULL, DAMAGE_BUDGET_REJECT, DAMAGE_BUDGET_INVALID
