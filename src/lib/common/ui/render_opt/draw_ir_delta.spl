# DrawIR deltas for affected components only (lane O5), per
# `doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md` §7: "DrawIR
# deltas only for affected components; shaped-run + glyph caches." This file
# is the delta-generation half; the glyph-cache half is a separate in-flight
# lane touching `text_layout/font_renderer.spl` and is out of scope here.
#
# WHY THIS DOES NOT USE `paint_chunks_raster`'S CACHE KEY: O2/O3's key
# (`paint_chunks_raster` / `paint_chunk_rasterizer_run`, both in this
# directory) is documented and spec-proven (`paint_chunk_rasterizer_spec.spl`,
# top-of-file note) to be a GLOBAL per-scene key, not a per-chunk-content one:
# `revisions_chunk_grouping_rev` sums MONOTONIC per-kind counters across the
# WHOLE scene, so marking any one node's PAINT revision changes the sum every
# chunk is compared against, invalidating ALL chunks, not just the mutated
# one. It was tried here first (see git history of this file) and empirically
# confirmed to do exactly that: a single `revs.mark(node, REV_PAINT)` made a
# second delta call rebuild all 4 chunks again, not just the marked one --
# reintroducing the very defect this lane exists to eliminate. That key stays
# genuinely useful for O2/O3's own job (skip a full re-raster only when
# NOTHING changed this generation at all) but it cannot answer "which
# component changed", so it is not used for selection here.
#
# The genuinely per-component signal is O0's `RenderRevisions`, which marks
# the MINIMAL per-(node, kind) set by construction (module doc: "the
# load-bearing rule is the TRANSFORM row... it must never mark PAINT").
# Selection here is `revs.is_dirty(owner, REV_PAINT)` per chunk owner, full
# stop -- real per-component granularity, not a parallel dirty-tracking
# mechanism, since it is the SAME `RenderRevisions` instance O0 exposes.
# `PaintChunks`/`PaintChunkRects` (O1/O3) still supply the owner->geometry
# mapping this module reuses rather than re-deriving.
#
# BOOTSTRAP: a brand-new scene has no "previous frame" to diff against, so
# every node must be marked dirty once at creation (a real caller's job, same
# as any retained-mode scene graph) before the first `draw_ir_delta_build`
# call -- this module does not special-case an empty history.
#
# Interpreter-divergence constraint (same family as O0/O1/O3): every array is
# a TOP-LEVEL field of one holder struct/class; cross-object work is a free
# function taking holders as plain parameters. Integer verdict/kind codes
# only, no enums on the hot path.

use common.ui.render_opt.revisions.{RenderRevisions, REV_PAINT}
use common.ui.render_opt.property_trees.PaintChunks
use common.ui.render_opt.paint_chunk_rasterizer.PaintChunkRects
use common.ui.draw_ir.{DrawIrCommand, draw_ir_rect}

# Result of one delta build: only the chunks actually selected as changed,
# plus in-band accounting so a spec can assert proportionality directly
# instead of inferring it from timing.
struct DrawIrDeltaResult:
    changed_indices: [i64]
    changed_commands: [DrawIrCommand]
    built_count: i64
    reused_count: i64
    total_count: i64

# Build a DrawIR delta: exactly the chunks whose OWNER component has a real
# per-node PAINT mark this frame (`revs.is_dirty`, O0's minimal-marking
# guarantee). `rects` supplies geometry+colour in lockstep with `chunks`
# (same convention `paint_chunk_rasterizer_run` requires: `add_rect` calls in
# the same order as `add_chunk*` calls). `component_ids[owner]` supplies the
# stable text id `DrawIrCommand` needs. Chunks NOT selected are not read, not
# built, and do not appear in the result at all -- the proportionality proof
# this module exists for. Does not mutate `chunks`, `rects`, or `revs`;
# clearing consumed dirty flags (`revs.clear_dirty()`) at the frame boundary
# is the caller's decision, same as it already is for every other O0/O1/O3
# consumer -- this function only reads.
fn draw_ir_delta_build(chunks: PaintChunks, rects: PaintChunkRects,
                       revs: RenderRevisions, component_ids: [text]) -> DrawIrDeltaResult:
    var changed_indices: [i64] = []
    var changed_commands: [DrawIrCommand] = []
    var i: i64 = 0
    while i < chunks.chunk_count:
        val owner = chunks.owner[i] as i64
        if revs.is_dirty(owner, REV_PAINT):
            if i < rects.rect_count and owner < component_ids.len():
                val cmd = draw_ir_rect(
                    component_ids[owner], rects.rect_x[i].to_i32(), rects.rect_y[i].to_i32(),
                    rects.rect_w[i].to_i32(), rects.rect_h[i].to_i32(), rects.colour[i].to_u32())
                changed_commands.push(cmd)
                changed_indices.push(i)
        i = i + 1
    DrawIrDeltaResult(
        changed_indices: changed_indices, changed_commands: changed_commands,
        built_count: changed_indices.len(), reused_count: chunks.chunk_count - changed_indices.len(),
        total_count: chunks.chunk_count)

# Apply a delta onto last frame's FULL command list, producing this frame's
# full list WITHOUT rebuilding any command outside `delta.changed_indices`.
# Arrays are value types in Simple, so `prev` is copied on assignment; the
# caller's `prev` is left untouched. This is the function whose output must
# be identical, index-for-index, to a from-scratch full rebuild — the
# correctness contract this lane exists to prove.
fn draw_ir_delta_replay(prev: [DrawIrCommand], delta: DrawIrDeltaResult) -> [DrawIrCommand]:
    var out: [DrawIrCommand] = prev
    var k: i64 = 0
    while k < delta.changed_indices.len():
        val idx = delta.changed_indices[k]
        if idx >= 0 and idx < out.len():
            out[idx] = delta.changed_commands[k]
        k = k + 1
    out

# Stable-identity retained transaction used before any PaintChunk visibility
# filtering is allowed to affect execution.  The caller supplies the complete
# target identity order.  Upserts carry authoritative commands; removes are
# tombstones and never enter the staged executable list.
const DRAW_IR_STABLE_UPSERT: i64 = 1
const DRAW_IR_STABLE_REMOVE: i64 = 2

struct DrawIrStableOp:
    kind: i64
    stable_id: text
    command: DrawIrCommand?

struct DrawIrStableTransaction:
    base_revision: text
    target_revision: text
    target_ids: [text]
    operations: [DrawIrStableOp]

struct DrawIrStableApplyResult:
    valid: bool
    reason: text
    revision: text
    commands: [DrawIrCommand]

fn draw_ir_stable_upsert(stable_id: text, command: DrawIrCommand) -> DrawIrStableOp:
    DrawIrStableOp(kind: DRAW_IR_STABLE_UPSERT, stable_id: stable_id, command: command)

fn draw_ir_stable_remove(stable_id: text) -> DrawIrStableOp:
    DrawIrStableOp(kind: DRAW_IR_STABLE_REMOVE, stable_id: stable_id, command: nil)

fn draw_ir_stable_transaction(base_revision: text, target_revision: text,
                              target_ids: [text], operations: [DrawIrStableOp]) -> DrawIrStableTransaction:
    DrawIrStableTransaction(
        base_revision: base_revision, target_revision: target_revision,
        target_ids: target_ids, operations: operations)

fn _draw_ir_stable_reject(reason: text, revision: text,
                          previous: [DrawIrCommand]) -> DrawIrStableApplyResult:
    DrawIrStableApplyResult(
        valid: false, reason: reason, revision: revision, commands: previous)

# Validates revision continuity, the complete identity set, tombstones, and
# payload identity before constructing the next list off to the side.  The
# previous executable list is returned unchanged on every failure.
fn draw_ir_stable_apply(previous: [DrawIrCommand], current_revision: text,
                        transaction: DrawIrStableTransaction) -> DrawIrStableApplyResult:
    if current_revision != transaction.base_revision:
        return _draw_ir_stable_reject(
            "draw-ir-stable-revision-mismatch", current_revision, previous)
    if transaction.target_revision.len() == 0 or
       transaction.target_revision == transaction.base_revision:
        return _draw_ir_stable_reject(
            "draw-ir-stable-invalid-target-revision", current_revision, previous)

    var previous_by_id: Dict<text, DrawIrCommand> = {}
    for command in previous:
        val stable_id = command.component_id
        if stable_id.len() == 0 or previous_by_id.has(stable_id):
            return _draw_ir_stable_reject(
                "draw-ir-stable-invalid-previous-identity", current_revision, previous)
        previous_by_id[stable_id] = command

    var target_set: Dict<text, bool> = {}
    for stable_id in transaction.target_ids:
        if stable_id.len() == 0 or target_set.has(stable_id):
            return _draw_ir_stable_reject(
                "draw-ir-stable-invalid-target-identity", current_revision, previous)
        target_set[stable_id] = true

    var upserts: Dict<text, DrawIrCommand> = {}
    var removes: Dict<text, bool> = {}
    var operation_ids: Dict<text, bool> = {}
    for operation in transaction.operations:
        val stable_id = operation.stable_id
        if stable_id.len() == 0 or operation_ids.has(stable_id):
            return _draw_ir_stable_reject(
                "draw-ir-stable-duplicate-operation", current_revision, previous)
        operation_ids[stable_id] = true
        if operation.kind == DRAW_IR_STABLE_UPSERT:
            val payload = operation.command
            if payload == nil or payload.component_id != stable_id or not target_set.has(stable_id):
                return _draw_ir_stable_reject(
                    "draw-ir-stable-invalid-upsert", current_revision, previous)
            upserts[stable_id] = payload
        elif operation.kind == DRAW_IR_STABLE_REMOVE:
            if operation.command != nil or not previous_by_id.has(stable_id) or target_set.has(stable_id):
                return _draw_ir_stable_reject(
                    "draw-ir-stable-invalid-remove", current_revision, previous)
            removes[stable_id] = true
        else:
            return _draw_ir_stable_reject(
                "draw-ir-stable-invalid-operation", current_revision, previous)

    # A complete target set needs a tombstone for every disappeared identity
    # and an upsert for every newly introduced identity.
    for command in previous:
        val stable_id = command.component_id
        if not target_set.has(stable_id) and not removes.has(stable_id):
            return _draw_ir_stable_reject(
                "draw-ir-stable-incomplete-remove-set", current_revision, previous)
    for stable_id in transaction.target_ids:
        if not previous_by_id.has(stable_id) and not upserts.has(stable_id):
            return _draw_ir_stable_reject(
                "draw-ir-stable-incomplete-upsert-set", current_revision, previous)

    var staged: [DrawIrCommand] = []
    for stable_id in transaction.target_ids:
        if upserts.has(stable_id):
            staged.push(upserts[stable_id])
        else:
            staged.push(previous_by_id[stable_id])
    DrawIrStableApplyResult(
        valid: true, reason: "", revision: transaction.target_revision,
        commands: staged)

export DrawIrDeltaResult, draw_ir_delta_build, draw_ir_delta_replay,
       DrawIrStableOp, DrawIrStableTransaction, DrawIrStableApplyResult,
       DRAW_IR_STABLE_UPSERT, DRAW_IR_STABLE_REMOVE,
       draw_ir_stable_upsert, draw_ir_stable_remove,
       draw_ir_stable_transaction, draw_ir_stable_apply
