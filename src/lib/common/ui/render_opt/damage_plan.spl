# Shared CPU/Vulkan damage-frame planner (O2 -> G0).
#
# Converts one selected DirtyTilePyramid level into deterministic, exact,
# overlap-free device rectangles. Horizontal runs merge vertically only when
# x/width match and rows abut. Area/cap fallback is the full viewport, never a
# widened partial bounding box. No backend names or DrawIR schema fields.

use common.ui.render_opt.damage_tiles.DirtyTilePyramid

val DAMAGE_PLAN_NONE: i64 = 0
val DAMAGE_PLAN_LOCAL: i64 = 1
val DAMAGE_PLAN_FULL: i64 = 2

val DAMAGE_FALLBACK_NONE: i64 = 0
val DAMAGE_FALLBACK_AREA: i64 = 1
val DAMAGE_FALLBACK_CAP: i64 = 2
val DAMAGE_FALLBACK_INVALID: i64 = 3

class DamageFramePlan:
    rects: [i64]
    mode: i64
    source_tile_count: i64
    output_rect_count: i64
    merged_tile_count: i64
    dirty_pixels: i64
    planned_pixels: i64
    tiles_examined: i64
    vertical_candidates_examined: i64 = 0
    run_workspace_allocations: i64 = 0
    full_fallback_count: i64
    fallback_reason: i64

fn _damage_plan_none(tiles_examined: i64) -> DamageFramePlan:
    DamageFramePlan(
        rects: [], mode: DAMAGE_PLAN_NONE,
        source_tile_count: 0, output_rect_count: 0, merged_tile_count: 0,
        dirty_pixels: 0, planned_pixels: 0, tiles_examined: tiles_examined,
        vertical_candidates_examined: 0,
        run_workspace_allocations: 0,
        full_fallback_count: 0, fallback_reason: DAMAGE_FALLBACK_NONE)

fn _damage_plan_full(pyramid: DirtyTilePyramid, source_tiles: i64,
                     dirty_pixels: i64, tiles_examined: i64,
                     reason: i64) -> DamageFramePlan:
    val area = (pyramid.viewport_w as i64) * (pyramid.viewport_h as i64)
    DamageFramePlan(
        rects: [0, 0, pyramid.viewport_w as i64, pyramid.viewport_h as i64],
        mode: DAMAGE_PLAN_FULL,
        source_tile_count: source_tiles, output_rect_count: 1,
        merged_tile_count: 0, dirty_pixels: dirty_pixels,
        planned_pixels: area, tiles_examined: tiles_examined,
        vertical_candidates_examined: 0,
        run_workspace_allocations: 0,
        full_fallback_count: 1, fallback_reason: reason)

fn build_damage_frame_plan(pyramid: DirtyTilePyramid, level: i64,
                           max_rects: i64,
                           full_threshold_percent: i64) -> DamageFramePlan:
    val surface = (pyramid.viewport_w as i64) * (pyramid.viewport_h as i64)
    if surface <= 0:
        return _damage_plan_none(0)
    if (level < 0 or level >= pyramid.level_count or max_rects <= 0 or
        full_threshold_percent <= 0 or full_threshold_percent > 100):
        return _damage_plan_full(pyramid, 0, 0, 0, DAMAGE_FALLBACK_INVALID)

    val source_tiles = pyramid.dirty_count(level)
    if source_tiles == 0:
        return _damage_plan_none(0)
    val dirty_pixels = pyramid.dirty_pixels(level)
    if dirty_pixels * 100 >= surface * full_threshold_percent:
        return _damage_plan_full(
            pyramid, source_tiles, dirty_pixels, 0, DAMAGE_FALLBACK_AREA)

    val cols = pyramid.cols[level] as i64
    val rows = pyramid.rows[level] as i64
    val tw = pyramid.tile_w[level] as i64
    val th = pyramid.tile_h[level] as i64
    var rects: [i64] = []
    # Two fixed banks replace three fresh arrays per active row. Each bank can
    # hold the maximum possible number of one-tile runs in a row.
    val run_bank_capacity = cols
    val run_workspace_capacity = run_bank_capacity * 2
    var run_x: [i64] = [0; run_workspace_capacity]
    var run_w: [i64] = [0; run_workspace_capacity]
    var run_out: [i64] = [0; run_workspace_capacity]
    var previous_bank: i64 = 0
    var previous_len: i64 = 0
    var examined: i64 = 0
    var vertical_examined: i64 = 0
    var ty: i64 = 0
    while ty < rows:
        val current_bank = 1 - previous_bank
        val previous_offset = previous_bank * run_bank_capacity
        val current_offset = current_bank * run_bank_capacity
        var current_len: i64 = 0
        var previous_cursor: i64 = 0
        var tx = pyramid.dirty_row_min_tx(level, ty)
        val row_max_tx = pyramid.dirty_row_max_tx(level, ty)
        while tx >= 0 and tx <= row_max_tx and tx < cols:
            examined = examined + 1
            if pyramid.is_dirty(level, tx, ty):
                val run_start = tx
                tx = tx + 1
                while tx < cols and pyramid.is_dirty(level, tx, ty):
                    examined = examined + 1
                    tx = tx + 1
                val x0 = run_start * tw
                var x1 = tx * tw
                val y0 = ty * th
                var y1 = y0 + th
                if x1 > pyramid.viewport_w as i64:
                    x1 = pyramid.viewport_w as i64
                if y1 > pyramid.viewport_h as i64:
                    y1 = pyramid.viewport_h as i64
                val width = x1 - x0
                val height = y1 - y0
                var output_index: i64 = -1
                while (previous_cursor < previous_len and
                       run_x[previous_offset + previous_cursor] < x0):
                    vertical_examined = vertical_examined + 1
                    previous_cursor = previous_cursor + 1
                if previous_cursor < previous_len:
                    vertical_examined = vertical_examined + 1
                    if (run_x[previous_offset + previous_cursor] == x0 and
                        run_w[previous_offset + previous_cursor] == width):
                        val candidate = run_out[previous_offset + previous_cursor]
                        val offset = candidate * 4
                        if rects[offset + 1] + rects[offset + 3] == y0:
                            output_index = candidate
                if output_index >= 0:
                    rects[output_index * 4 + 3] = rects[output_index * 4 + 3] + height
                else:
                    output_index = rects.len() / 4
                    if output_index >= max_rects:
                        return _damage_plan_full(
                            pyramid, source_tiles, dirty_pixels, examined,
                            DAMAGE_FALLBACK_CAP)
                    rects.push(x0)
                    rects.push(y0)
                    rects.push(width)
                    rects.push(height)
                run_x[current_offset + current_len] = x0
                run_w[current_offset + current_len] = width
                run_out[current_offset + current_len] = output_index
                current_len = current_len + 1
            else:
                tx = tx + 1
        previous_bank = current_bank
        previous_len = current_len
        ty = ty + 1

    val output_count = rects.len() / 4
    DamageFramePlan(
        rects: rects, mode: DAMAGE_PLAN_LOCAL,
        source_tile_count: source_tiles, output_rect_count: output_count,
        merged_tile_count: source_tiles - output_count,
        dirty_pixels: dirty_pixels, planned_pixels: dirty_pixels,
        tiles_examined: examined, full_fallback_count: 0,
        vertical_candidates_examined: vertical_examined,
        run_workspace_allocations: 3,
        fallback_reason: DAMAGE_FALLBACK_NONE)

export DamageFramePlan, build_damage_frame_plan
export DAMAGE_PLAN_NONE, DAMAGE_PLAN_LOCAL, DAMAGE_PLAN_FULL
export DAMAGE_FALLBACK_NONE, DAMAGE_FALLBACK_AREA, DAMAGE_FALLBACK_CAP
export DAMAGE_FALLBACK_INVALID
