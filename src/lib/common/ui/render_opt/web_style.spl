# Web style: O(k) declaration application (lane W0), per
# `doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md` §6/§9/§11:
# "`PropertyId: u16` enum (append-only, generated), `Declaration {property,
# value_id, flags}`, `ComputedStyleHot` (display, position, visibility,
# opacity, color/background IDs, width/height value IDs, layout/paint flags)
# ... `apply_declarations` iterates only existing declarations -- O(k). Parse
# names->PropertyId once, values->typed once; intern immutable computed
# styles; selector indexes + invalidation sets."
#
# The target this module exists to make reachable: applying a k-declaration
# rule set to a node costs O(k) work, never O(PROPERTY_COUNT). The thing a
# future reader is most likely to undo by accident, because it looks tidier,
# is looping over every known PropertyId and checking "is it present" --
# that is the "restored wide property probing" sabotage named in plan §10;
# `apply_declarations` below only ever visits `decls.count` slots and nothing
# else, and `touched_count` exists specifically so a gate can prove that in
# a running program, not just by reading the loop bound.
#
# Interpreter-divergence constraint (see
# `doc/08_tracking/bug/class_field_reference_semantics_diverge_2026-08-06.md`):
# class-into-field assignment VALUE-COPIES under the tree-walk interpreter;
# only fn parameters alias. Every array/dict is therefore a TOP-LEVEL field,
# and every mutator here is a `me` method on the object that owns the field
# it writes (no cross-object free functions are needed in this module, unlike
# `property_trees.spl`'s `paint_chunks_sync`, because nothing here reaches
# through a second stored reference). Integer constants, not enums (open
# match-divergence defects) -- `PropertyId` is a `val i64` table, not a
# language enum, matching `PT_TRANSFORM` etc. in `property_trees.spl`.
#
# Composes with lane O1 (`property_trees.spl`): a `ComputedStyleHot`'s
# `layout_flags`/`paint_flags` are the input a future pass would use to
# decide whether a style change also bumps a property-tree revision; this
# module does not call into `property_trees.spl` itself, keeping W0
# independently testable.

# ---- PropertyId table (append-only; extend only by adding a new constant
# with the next free id and bumping PROPERTY_COUNT) ----
val PROP_DISPLAY: i64 = 0
val PROP_POSITION: i64 = 1
val PROP_VISIBILITY: i64 = 2
val PROP_OPACITY: i64 = 3
val PROP_COLOR: i64 = 4
val PROP_BACKGROUND: i64 = 5
val PROP_WIDTH: i64 = 6
val PROP_HEIGHT: i64 = 7
val PROPERTY_COUNT: i64 = 8

# Which computed-style bucket a property belongs to. DISPLAY/POSITION/WIDTH/
# HEIGHT change box geometry (layout); VISIBILITY/OPACITY/COLOR/BACKGROUND
# change only what gets painted, not where.
val WS_LAYOUT_FLAG: u32 = 1
val WS_PAINT_FLAG: u32 = 2

# Verdict codes.
val WS_OK: i64 = 0
val WS_BAD_PROPERTY: i64 = 1
val WS_BAD_INDEX: i64 = 2

# Parse names -> PropertyId once. `register` is idempotent: the same name
# always maps back to the same id, and an already-known name never grows
# the table. Built-in names are pre-registered by `create()` at the fixed
# ids above so the hot properties never pay a dict lookup; anything else
# (custom/vendor properties) gets an id appended past `PROPERTY_COUNT`.
class PropertyNames:
    name_to_id: Dict<text, i64>
    id_to_name: [text]
    next_id: i64

    static fn create() -> PropertyNames:
        var t = PropertyNames(name_to_id: {}, id_to_name: [], next_id: 0)
        t.register("display")
        t.register("position")
        t.register("visibility")
        t.register("opacity")
        t.register("color")
        t.register("background")
        t.register("width")
        t.register("height")
        t

    me register(name: text) -> i64:
        if self.name_to_id.contains_key(name):
            return self.name_to_id[name]
        val id = self.next_id
        self.name_to_id[name] = id
        self.id_to_name.push(name)
        self.next_id = id + 1
        id

    me id_for(name: text) -> i64:
        if self.name_to_id.contains_key(name):
            return self.name_to_id[name]
        -1

    me count() -> i64:
        self.next_id

# Parse values -> typed value ids once. Same value text always resolves to
# the same `value_id`; a repeated declaration (e.g. re-applying an unchanged
# stylesheet rule) never grows the table. `value_id` is opaque to this
# module -- callers that need the literal back use `text_for`.
class ValueInterner:
    text_to_id: Dict<text, i64>
    id_to_text: [text]
    next_id: i64

    static fn create() -> ValueInterner:
        ValueInterner(text_to_id: {}, id_to_text: [], next_id: 0)

    me intern(value: text) -> i64:
        if self.text_to_id.contains_key(value):
            return self.text_to_id[value]
        val id = self.next_id
        self.text_to_id[value] = id
        self.id_to_text.push(value)
        self.next_id = id + 1
        id

    me text_for(value_id: i64) -> text:
        if value_id < 0 or value_id >= self.id_to_text.len():
            return ""
        self.id_to_text[value_id]

    me count() -> i64:
        self.next_id

# A bounded set of declarations (e.g. one rule's body, or one node's inline
# style). Columnar, like `PropertyTrees`/`PaintChunks`: `property`/`value_id`/
# `flags` are parallel arrays, `count` is the only thing `apply_declarations`
# below is allowed to bound its loop on.
class DeclarationList:
    property: [i64]
    value_id: [i64]
    flags: [u32]
    count: i64

    static fn create() -> DeclarationList:
        DeclarationList(property: [], value_id: [], flags: [], count: 0)

    me add(property: i64, value_id: i64, flags: u32) -> i64:
        if property < 0:
            return WS_BAD_PROPERTY
        val idx = self.count
        self.property.push(property)
        self.value_id.push(value_id)
        self.flags.push(flags)
        self.count = idx + 1
        WS_OK

    me clear():
        self.property = []
        self.value_id = []
        self.flags = []
        self.count = 0

# The hot half of a computed style: the fields `apply_declarations` writes
# directly, plus the two summary bitsets a future layout/paint pass gates on.
# No cold side table here -- this lane only defines the eight hot
# properties named in the plan; a cold table with no properties in it would
# be unused code, so it stays out until a property that needs one lands.
class ComputedStyleHot:
    display: i64
    position: i64
    visibility: i64
    opacity: i64
    color_id: i64
    background_id: i64
    width_id: i64
    height_id: i64
    layout_flags: u32
    paint_flags: u32
    # Number of declarations `apply_declarations` has ever written into this
    # style. This is the sabotage-detection counter: it must equal the sum
    # of every `decls.count` ever applied, never `PROPERTY_COUNT` times that
    # -- a "wide property probing" regression (looping 0..PROPERTY_COUNT and
    # checking presence, instead of 0..decls.count) makes this diverge
    # immediately and observably.
    touched_count: i64

    static fn create() -> ComputedStyleHot:
        ComputedStyleHot(
            display: -1, position: -1, visibility: -1, opacity: -1,
            color_id: -1, background_id: -1, width_id: -1, height_id: -1,
            layout_flags: 0, paint_flags: 0, touched_count: 0)

# Apply a bounded declaration list to a computed style. O(k): the loop bound
# is `decls.count`, never `PROPERTY_COUNT` -- see the module doc and
# `touched_count` above for why that distinction is the entire point of this
# function. Unknown property ids are skipped (still counted as touched: the
# cost of visiting them is O(k), applying them is just a no-op) rather than
# failing the whole batch, since a forward-compatible stylesheet may declare
# a property this build does not know yet.
fn apply_declarations(style: ComputedStyleHot, decls: DeclarationList) -> i64:
    var i: i64 = 0
    while i < decls.count:
        val prop = decls.property[i]
        val vid = decls.value_id[i]
        if prop == PROP_DISPLAY:
            style.display = vid
            style.layout_flags = style.layout_flags | WS_LAYOUT_FLAG
        elif prop == PROP_POSITION:
            style.position = vid
            style.layout_flags = style.layout_flags | WS_LAYOUT_FLAG
        elif prop == PROP_WIDTH:
            style.width_id = vid
            style.layout_flags = style.layout_flags | WS_LAYOUT_FLAG
        elif prop == PROP_HEIGHT:
            style.height_id = vid
            style.layout_flags = style.layout_flags | WS_LAYOUT_FLAG
        elif prop == PROP_VISIBILITY:
            style.visibility = vid
            style.paint_flags = style.paint_flags | WS_PAINT_FLAG
        elif prop == PROP_OPACITY:
            style.opacity = vid
            style.paint_flags = style.paint_flags | WS_PAINT_FLAG
        elif prop == PROP_COLOR:
            style.color_id = vid
            style.paint_flags = style.paint_flags | WS_PAINT_FLAG
        elif prop == PROP_BACKGROUND:
            style.background_id = vid
            style.paint_flags = style.paint_flags | WS_PAINT_FLAG
        style.touched_count = style.touched_count + 1
        i = i + 1
    decls.count

# Intern immutable computed styles: two `ComputedStyleHot` instances whose
# hot fields are all equal collapse to the same `style_id`, so retained
# per-node state can store a small int instead of a duplicate struct.
# Immutable by contract -- callers must not mutate a `ComputedStyleHot`
# after interning it; a genuinely changed style is interned again and gets
# a (possibly new) id, it never overwrites the old entry in place.
class StyleInterner:
    key_to_id: Dict<text, i64>
    # column store of the interned fields, indexed by style_id
    display: [i64]
    position: [i64]
    visibility: [i64]
    opacity: [i64]
    color_id: [i64]
    background_id: [i64]
    width_id: [i64]
    height_id: [i64]
    layout_flags: [u32]
    paint_flags: [u32]
    next_id: i64
    # count of `intern` calls that returned an EXISTING id rather than
    # minting a new one; the dedup proof a gate checks.
    reuse_count: i64

    static fn create() -> StyleInterner:
        StyleInterner(
            key_to_id: {}, display: [], position: [], visibility: [],
            opacity: [], color_id: [], background_id: [], width_id: [],
            height_id: [], layout_flags: [], paint_flags: [],
            next_id: 0, reuse_count: 0)

    me key_of(style: ComputedStyleHot) -> text:
        style.display.to_text() + "|" + style.position.to_text() + "|" +
            style.visibility.to_text() + "|" + style.opacity.to_text() + "|" +
            style.color_id.to_text() + "|" + style.background_id.to_text() +
            "|" + style.width_id.to_text() + "|" + style.height_id.to_text()

    me intern(style: ComputedStyleHot) -> i64:
        val key = self.key_of(style)
        if self.key_to_id.contains_key(key):
            self.reuse_count = self.reuse_count + 1
            return self.key_to_id[key]
        val id = self.next_id
        self.key_to_id[key] = id
        self.display.push(style.display)
        self.position.push(style.position)
        self.visibility.push(style.visibility)
        self.opacity.push(style.opacity)
        self.color_id.push(style.color_id)
        self.background_id.push(style.background_id)
        self.width_id.push(style.width_id)
        self.height_id.push(style.height_id)
        self.layout_flags.push(style.layout_flags)
        self.paint_flags.push(style.paint_flags)
        self.next_id = id + 1
        id

    me count() -> i64:
        self.next_id

# Per-property invalidation set: which nodes have a pending style change for
# which property, since the set was last cleared. A future style/layout pass
# consumes this to recompute only the affected nodes' styles (still O(k) in
# the number of actual changes, not O(n) over every node in the tree) and to
# decide which of DISPLAY/POSITION/WIDTH/HEIGHT vs
# VISIBILITY/OPACITY/COLOR/BACKGROUND fired, so it can skip a layout pass
# when only paint-bucket properties changed.
class StyleInvalidation:
    node_id: [u32]
    property: [i64]
    len: i64

    static fn create() -> StyleInvalidation:
        StyleInvalidation(node_id: [], property: [], len: 0)

    me mark(node: u32, property: i64) -> i64:
        if property < 0:
            return WS_BAD_PROPERTY
        self.node_id.push(node)
        self.property.push(property)
        self.len = self.len + 1
        WS_OK

    me clear():
        self.node_id = []
        self.property = []
        self.len = 0

    # Count of pending entries for one property id -- O(len), i.e. O(k) in
    # the number of actual pending changes, never O(PROPERTY_COUNT) or
    # O(node count).
    me count_for_property(property: i64) -> i64:
        var n: i64 = 0
        var i: i64 = 0
        while i < self.len:
            if self.property[i] == property:
                n = n + 1
            i = i + 1
        n

    # Any pending entry at all for a layout-bucket property, so a caller can
    # skip a layout pass entirely when only paint-bucket properties changed.
    me has_layout_change() -> bool:
        var i: i64 = 0
        while i < self.len:
            val p = self.property[i]
            if p == PROP_DISPLAY or p == PROP_POSITION or
                    p == PROP_WIDTH or p == PROP_HEIGHT:
                return true
            i = i + 1
        false
