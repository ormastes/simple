# Backend-neutral retained DrawIR command owner for Web/GUI/WM frame switching.
# Seeds once, then applies canonical per-owner deltas in place. It owns no GPU,
# raster cache, atlas, or producer-specific semantic state.

use common.ui.draw_ir.{
    DrawIrCommand, DRAW_IR_COMMAND_RECT, DRAW_IR_COMMAND_IMAGE,
    DRAW_IR_COMMAND_TEXT
}
use common.ui.render_opt.draw_ir_delta.{
    DrawIrDeltaResult, draw_ir_delta_replay_into
}
use common.ui.render_opt.damage_plan.{
    DAMAGE_PLAN_NONE, DAMAGE_PLAN_LOCAL, DAMAGE_PLAN_FULL
}

val RETAINED_FRAME_IDLE: i64 = 0
val RETAINED_FRAME_FULL_SEED: i64 = 1
val RETAINED_FRAME_PATCH: i64 = 2
val RETAINED_FRAME_REJECTED: i64 = 3

class RetainedDrawIrReceipt:
    mode: i64
    command_count: i64
    command_writes: i64
    frame_generation: i64
    reason: text
    damage_mode: i64
    damage_rects: [i64]

class RetainedDrawIrFrame:
    commands: [DrawIrCommand]
    initialized: bool
    frame_generation: i64
    full_seed_count: i64
    patch_count: i64
    idle_count: i64
    rejected_count: i64
    total_command_writes: i64
    viewport_w: i64
    viewport_h: i64

    static fn create(viewport_w: i64 = 0, viewport_h: i64 = 0) -> RetainedDrawIrFrame:
        RetainedDrawIrFrame(
            commands: [], initialized: false, frame_generation: 0,
            full_seed_count: 0, patch_count: 0, idle_count: 0,
            rejected_count: 0, total_command_writes: 0,
            viewport_w: viewport_w, viewport_h: viewport_h)

    me seed(full_commands: [DrawIrCommand]) -> RetainedDrawIrReceipt:
        self.commands = full_commands
        self.initialized = true
        self.frame_generation = self.frame_generation + 1
        self.full_seed_count = self.full_seed_count + 1
        self.total_command_writes = self.total_command_writes + full_commands.len()
        RetainedDrawIrReceipt(
            mode: RETAINED_FRAME_FULL_SEED,
            command_count: self.commands.len(),
            command_writes: full_commands.len(),
            frame_generation: self.frame_generation,
            reason: "full-seed", damage_mode: DAMAGE_PLAN_FULL,
            damage_rects: self._full_damage())

    me apply(delta: DrawIrDeltaResult) -> RetainedDrawIrReceipt:
        if not self.initialized:
            return self._reject("unseeded")
        if delta.total_count != self.commands.len():
            return self._reject("command-count-changed")
        if (delta.built_count != delta.changed_indices.len() or
            delta.built_count != delta.changed_commands.len()):
            return self._reject("delta-shape-mismatch")
        if delta.built_count == 0:
            self.frame_generation = self.frame_generation + 1
            self.idle_count = self.idle_count + 1
            return RetainedDrawIrReceipt(
                mode: RETAINED_FRAME_IDLE,
                command_count: self.commands.len(), command_writes: 0,
                frame_generation: self.frame_generation, reason: "empty-delta",
                damage_mode: DAMAGE_PLAN_NONE, damage_rects: [])

        # Canonical delta_build emits strictly ascending indices. Requiring
        # that shape rejects duplicates and malformed ordering in O(changed).
        var previous: i64 = -1
        var i: i64 = 0
        while i < delta.changed_indices.len():
            val index = delta.changed_indices[i]
            if index <= previous or index < 0 or index >= self.commands.len():
                return self._reject("invalid-delta-index")
            previous = index
            i = i + 1
        var damage_rects: [i64] = []
        var full_damage = false
        i = 0
        while i < delta.changed_indices.len():
            val index = delta.changed_indices[i]
            if not self._append_command_damage(damage_rects, self.commands[index]):
                full_damage = true
            if not self._append_command_damage(damage_rects, delta.changed_commands[i]):
                full_damage = true
            i = i + 1
        if full_damage:
            damage_rects = self._full_damage()
        val applied = draw_ir_delta_replay_into(self.commands, delta)
        if applied != delta.built_count:
            return self._reject("delta-apply-mismatch")
        self.frame_generation = self.frame_generation + 1
        self.patch_count = self.patch_count + 1
        self.total_command_writes = self.total_command_writes + applied
        RetainedDrawIrReceipt(
            mode: RETAINED_FRAME_PATCH,
            command_count: self.commands.len(), command_writes: applied,
            frame_generation: self.frame_generation,
            reason: if full_damage: "delta-patch-full-damage" else: "delta-patch",
            damage_mode: if full_damage: DAMAGE_PLAN_FULL else: DAMAGE_PLAN_LOCAL,
            damage_rects: damage_rects)

    me _reject(reason: text) -> RetainedDrawIrReceipt:
        self.rejected_count = self.rejected_count + 1
        RetainedDrawIrReceipt(
            mode: RETAINED_FRAME_REJECTED,
            command_count: self.commands.len(), command_writes: 0,
            frame_generation: self.frame_generation, reason: reason,
            damage_mode: DAMAGE_PLAN_NONE, damage_rects: [])

    me _full_damage() -> [i64]:
        if self.viewport_w <= 0 or self.viewport_h <= 0:
            return []
        [0, 0, self.viewport_w, self.viewport_h]

    me _append_command_damage(mut rects: [i64], command: DrawIrCommand) -> bool:
        val bounded = (command.kind == DRAW_IR_COMMAND_RECT or
                       command.kind == DRAW_IR_COMMAND_IMAGE or
                       (command.kind == DRAW_IR_COMMAND_TEXT and
                        command.width > 0 and command.height > 0))
        if not bounded:
            return false
        var x0 = command.x as i64
        var y0 = command.y as i64
        var x1 = x0 + command.width as i64
        var y1 = y0 + command.height as i64
        if x0 < 0: x0 = 0
        if y0 < 0: y0 = 0
        if x1 > self.viewport_w: x1 = self.viewport_w
        if y1 > self.viewport_h: y1 = self.viewport_h
        if x1 > x0 and y1 > y0:
            rects.push(x0)
            rects.push(y0)
            rects.push(x1 - x0)
            rects.push(y1 - y0)
        true

export RetainedDrawIrFrame, RetainedDrawIrReceipt
export RETAINED_FRAME_IDLE, RETAINED_FRAME_FULL_SEED,
       RETAINED_FRAME_PATCH, RETAINED_FRAME_REJECTED
