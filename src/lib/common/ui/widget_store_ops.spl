# Process-local widget registry helpers used by the hub widget module.

use common.ui.widget_kind.{WidgetKind, LayoutKind}

struct WidgetNode:
    id: text

struct WidgetRecord:
    id: text
    kind: text
    layout: text
    visible: bool
    focused: bool

struct WidgetProp:
    node_id: text
    key: text
    value: text

# Duplicate-registration diagnostic (phase 1 identity safety).
# severity is "warning" (default mode: replacement still happens) or
# "error" (strict mode: replacement refused).
struct WidgetDupDiagnostic:
    id: text
    existing_kind: text
    new_kind: text
    existing_site: text
    new_site: text
    severity: text

# Strict-lookup result for find_widget_strict: exactly-one-or-error.
struct WidgetFindStrictResult:
    found: bool
    node_id: text
    error: text
    candidates: [text]

var _widget_registry: [WidgetRecord] = []
var _widget_props_store: [WidgetProp] = []
var _widget_registry_ready: bool = false
var _widget_props_ready: bool = false
var _widget_store_revision: i64 = 0
var _widget_dup_diagnostics: [WidgetDupDiagnostic] = []
var _widget_dup_ready: bool = false
var _widget_store_strict: bool = false
# Construction sites per widget id (empty when the caller never supplied one).
var _widget_sites: [WidgetProp] = []
var _widget_sites_ready: bool = false

fn set_widget_store_strict(flag: bool):
    _widget_store_strict = flag

fn widget_store_strict() -> bool:
    return _widget_store_strict

fn widget_dup_diagnostics() -> [WidgetDupDiagnostic]:
    if not _widget_dup_ready:
        return []
    return _widget_dup_diagnostics

fn widget_dup_warnings() -> [text]:
    val diags = widget_dup_diagnostics()
    val diag_count = diags.len()
    if diag_count == 0:
        return []
    var out: [text] = [""; diag_count]
    var i = 0
    while i < diag_count:
        out[i] = _widget_dup_message(diags[i])
        i = i + 1
    return out

fn clear_widget_dup_diagnostics():
    _widget_dup_diagnostics = []
    _widget_dup_ready = true

fn _widget_dup_message(diag: WidgetDupDiagnostic) -> text:
    var msg = "{diag.severity}: duplicate widget id '{diag.id}' (existing kind '{diag.existing_kind}', new kind '{diag.new_kind}')"
    if diag.existing_site != "" or diag.new_site != "":
        msg = msg + " [existing site '{diag.existing_site}', new site '{diag.new_site}']"
    return msg

fn _record_dup_diagnostic(diag: WidgetDupDiagnostic):
    if not _widget_dup_ready:
        _widget_dup_diagnostics = [diag]
        _widget_dup_ready = true
        return
    _widget_dup_diagnostics = _widget_dup_diagnostics.push(diag)

fn _widget_site_of(id: text) -> text:
    if not _widget_sites_ready:
        return ""
    var i = 0
    while i < _widget_sites.len():
        val entry = _widget_sites[i]
        if entry.node_id == id:
            return entry.value
        i = i + 1
    return ""

fn _set_widget_site(id: text, site: text):
    val entry = WidgetProp(node_id: id, key: "site", value: site)
    if not _widget_sites_ready:
        _widget_sites = [entry]
        _widget_sites_ready = true
        return
    val site_len = _widget_sites.len()
    var replaced = false
    var scan_idx = 0
    while scan_idx < site_len:
        if _widget_sites[scan_idx].node_id == id:
            replaced = true
            scan_idx = site_len
        scan_idx = scan_idx + 1
    var updated_len = site_len
    if not replaced:
        updated_len = site_len + 1
    var updated: [WidgetProp] = [entry; updated_len]
    var write_idx = 0
    while write_idx < site_len:
        val existing = _widget_sites[write_idx]
        if existing.node_id == id:
            updated[write_idx] = entry
        else:
            updated[write_idx] = existing
        write_idx = write_idx + 1
    if not replaced:
        updated[site_len] = entry
    _widget_sites = updated

fn widget_store_revision() -> i64:
    _widget_store_revision

fn bump_widget_store_revision():
    _widget_store_revision = _widget_store_revision + 1

fn parse_widget_kind(name: text) -> WidgetKind:
    return WidgetKind.from_wire(name)

fn parse_layout_kind(name: text) -> LayoutKind:
    return LayoutKind.from_wire(name)

fn parse_semantic_prop(name: text) -> text:
    val key = name.to_lower()
    match key:
        "app-background" => return "app_background"
        "app-surface" => return "app_surface"
        "widget-radius" => return "widget_radius"
        "widget-shadow" => return "widget_shadow"
        "text-primary" => return "text_primary"
        "text-secondary" => return "text_secondary"
        "accent-color" => return "accent_color"
        "icon-id" => return "icon_id"
        _ => return key

fn default_widget_record(id: text, kind: text) -> WidgetRecord:
    return WidgetRecord(id: id, kind: kind, layout: "vbox", visible: true, focused: false)

fn upsert_widget_record(record: WidgetRecord):
    upsert_widget_record_at(record, "")

# Upsert with an optional construction-site tag. Returns "" on success or
# an error message when strict mode refuses a conflicting re-registration.
# A conflict is a same-id record with a DIFFERENT kind, or a different
# non-empty construction site. Default (non-strict) mode keeps the legacy
# replace behavior but records a warning diagnostic instead of staying
# silent.
fn upsert_widget_record_at(record: WidgetRecord, site: text) -> text:
    if _widget_registry_ready:
        var probe_idx = 0
        while probe_idx < _widget_registry.len():
            val existing = _widget_registry[probe_idx]
            if existing.id == record.id:
                val existing_site = _widget_site_of(record.id)
                val kind_conflict = existing.kind != record.kind
                val site_conflict = site != "" and existing_site != "" and existing_site != site
                if kind_conflict or site_conflict:
                    val severity = if _widget_store_strict: "error" else: "warning"
                    val diag = WidgetDupDiagnostic(
                        id: record.id,
                        existing_kind: existing.kind,
                        new_kind: record.kind,
                        existing_site: existing_site,
                        new_site: site,
                        severity: severity)
                    _record_dup_diagnostic(diag)
                    if _widget_store_strict:
                        return _widget_dup_message(diag)
                probe_idx = _widget_registry.len()
            probe_idx = probe_idx + 1
    if site != "":
        _set_widget_site(record.id, site)
    _upsert_widget_record_raw(record)
    return ""

fn _upsert_widget_record_raw(record: WidgetRecord):
    val registry_len = _widget_registry.len()
    var replaced = false
    var scan_idx = 0
    while scan_idx < registry_len:
        if _widget_registry[scan_idx].id == record.id:
            replaced = true
            scan_idx = registry_len
        scan_idx = scan_idx + 1
    var updated_len = registry_len
    if not replaced:
        updated_len = registry_len + 1
    var updated: [WidgetRecord] = [record; updated_len]
    var write_idx = 0
    while write_idx < registry_len:
        val existing = _widget_registry[write_idx]
        if existing.id == record.id:
            updated[write_idx] = record
        else:
            updated[write_idx] = existing
        write_idx = write_idx + 1
    if not replaced:
        updated[registry_len] = record
    _widget_registry = updated
    _widget_registry_ready = true
    bump_widget_store_revision()

fn get_widget_record(id: text) -> WidgetRecord?:
    if not _widget_registry_ready:
        return nil
    var i = 0
    while i < _widget_registry.len():
        val record = _widget_registry[i]
        if record.id == id:
            return record
        i = i + 1
    return nil

fn require_widget_record(id: text) -> WidgetRecord:
    # Scan the registry directly instead of unwrapping the Optional from
    # get_widget_record: Option payload match loses the value under the
    # self-hosted runtime, which made every widget fall back to a default
    # "panel" record (empty widget shells / empty text mask).
    if _widget_registry_ready:
        var i = 0
        while i < _widget_registry.len():
            val record = _widget_registry[i]
            if record.id == id:
                return record
            i = i + 1
    val fallback = default_widget_record(id, "panel")
    upsert_widget_record(fallback)
    return fallback

fn get_widget(id: text) -> WidgetNode?:
    return WidgetNode(id: id)

fn get_widget_child_ids(id: text) -> [text]:
    return decode_child_ids(get_internal_prop(id, "ui_children"))

fn register_widget_child(parent_id: text, child_id: text):
    val existing = get_widget_child_ids(parent_id)
    for current_id in existing:
        if current_id == child_id:
            return
    val existing_len = existing.len()
    var updated: [text] = [child_id; existing_len + 1]
    var i = 0
    while i < existing_len:
        updated[i] = existing[i]
        i = i + 1
    updated[existing_len] = child_id
    set_internal_prop(parent_id, "ui_children", encode_child_ids(updated))

fn widget_props() -> [WidgetProp]:
    if not _widget_props_ready:
        return []
    return _widget_props_store

fn set_widget_props(props: [WidgetProp]):
    _widget_props_store = props
    _widget_props_ready = true
    bump_widget_store_revision()

fn get_internal_prop(node_id: text, key: text) -> text:
    if not _widget_props_ready:
        return ""
    var i = 0
    while i < _widget_props_store.len():
        val prop = _widget_props_store[i]
        if prop.node_id == node_id and prop.key == key:
            return prop.value
        i = i + 1
    return ""

fn set_internal_prop(node_id: text, key: text, value: text):
    val new_prop = WidgetProp(node_id: node_id, key: key, value: value)
    if not _widget_props_ready:
        _widget_props_store = [new_prop]
        _widget_props_ready = true
        bump_widget_store_revision()
        return
    val prop_len = _widget_props_store.len()
    var replaced = false
    var scan_idx = 0
    while scan_idx < prop_len:
        val prop = _widget_props_store[scan_idx]
        if prop.node_id == node_id and prop.key == key:
            replaced = true
            scan_idx = prop_len
        scan_idx = scan_idx + 1
    var updated_len = prop_len
    if not replaced:
        updated_len = prop_len + 1
    var props: [WidgetProp] = [new_prop; updated_len]
    var write_idx = 0
    while write_idx < prop_len:
        val prop = _widget_props_store[write_idx]
        if prop.node_id == node_id and prop.key == key:
            props[write_idx] = new_prop
        else:
            props[write_idx] = prop
        write_idx = write_idx + 1
    if not replaced:
        props[prop_len] = new_prop
    _widget_props_store = props
    bump_widget_store_revision()

fn encode_child_ids(ids: [text]) -> text:
    return ids.join(",")

fn decode_child_ids(blob: text) -> [text]:
    if blob == "":
        return []
    val parts = blob.split(",")
    var id_count = 0
    for part in parts:
        if part != "":
            id_count = id_count + 1
    if id_count == 0:
        return []
    var ids: [text] = [""; id_count]
    var write_idx = 0
    for part in parts:
        if part != "":
            ids[write_idx] = part
            write_idx = write_idx + 1
    return ids

# Collect every (id, path) pair in the subtree — FULL traversal, never
# first-match, so ambiguity is always detected.
fn _collect_widget_id_paths(node: WidgetNode, prefix: text) -> [WidgetProp]:
    val path = if prefix == "": node.id else: "{prefix}/{node.id}"
    var out: [WidgetProp] = [WidgetProp(node_id: node.id, key: "path", value: path)]
    for child in node.children():
        for entry in _collect_widget_id_paths(child, path):
            out = out.push(entry)
    return out

fn _find_widget_strict_in(root: WidgetNode, target_id: text) -> WidgetFindStrictResult:
    val entries = _collect_widget_id_paths(root, "")
    var match_count = 0
    for entry in entries:
        if entry.node_id == target_id:
            match_count = match_count + 1
    if match_count == 1:
        return WidgetFindStrictResult(found: true, node_id: target_id, error: "", candidates: [])
    if match_count > 1:
        var paths: [text] = []
        for entry in entries:
            if entry.node_id == target_id:
                paths = paths.push(entry.value)
        val joined_paths = paths.join(", ")
        return WidgetFindStrictResult(
            found: false,
            node_id: "",
            error: "ambiguous widget id '{target_id}': {match_count} matches: {joined_paths}",
            candidates: paths)
    # 0 matches: unknown id — suggest near misses (substring either way).
    val needle = target_id.to_lower()
    var suggestions: [text] = []
    for entry in entries:
        if suggestions.len() < 3:
            val candidate = entry.node_id.to_lower()
            if candidate != "" and needle != "" and (candidate.contains(needle) or needle.contains(candidate)):
                var seen = false
                for s in suggestions:
                    if s == entry.node_id:
                        seen = true
                if not seen:
                    suggestions = suggestions.push(entry.node_id)
    var msg = "unknown widget id '{target_id}'"
    if suggestions.len() > 0:
        val joined_suggestions = suggestions.join(", ")
        msg = msg + "; near misses: {joined_suggestions}"
    return WidgetFindStrictResult(found: false, node_id: "", error: msg, candidates: suggestions)

impl WidgetNode:
    static fn new(id: text, kind: text) -> WidgetNode:
        val handle = WidgetNode(id: id)
        upsert_widget_record(default_widget_record(id, kind))
        return handle

    fn kind_name() -> text:
        return require_widget_record(self.id).kind

    fn layout_name() -> text:
        return require_widget_record(self.id).layout

    fn is_visible() -> bool:
        return require_widget_record(self.id).visible

    fn is_focused() -> bool:
        return require_widget_record(self.id).focused

    fn kind() -> text: self.kind_name()
    fn layout() -> text: self.layout_name()
    fn visible() -> bool: self.is_visible()
    fn focused() -> bool: self.is_focused()

    fn set_prop(key: text, value: text) -> WidgetNode:
        set_internal_prop(self.id, parse_semantic_prop(key), value)
        return self

    fn add_child(child: WidgetNode) -> WidgetNode:
        register_widget_child(self.id, child.id)
        return self

    fn set_layout(layout: text) -> WidgetNode:
        val record = require_widget_record(self.id)
        upsert_widget_record(WidgetRecord(id: self.id, kind: record.kind, layout: parse_layout_kind(layout).to_wire(), visible: record.visible, focused: record.focused))
        return self

    fn set_visible(visible: bool) -> WidgetNode:
        val record = require_widget_record(self.id)
        upsert_widget_record(WidgetRecord(id: self.id, kind: record.kind, layout: record.layout, visible: visible, focused: record.focused))
        return self

    fn get_prop(key: text) -> text:
        return get_internal_prop(self.id, parse_semantic_prop(key))

    fn has_prop(key: text) -> bool:
        return get_internal_prop(self.id, parse_semantic_prop(key)) != ""

    fn prop_keys() -> [text]:
        var key_count = 0
        for prop in _widget_props_store:
            if prop.node_id == self.id:
                key_count = key_count + 1
        if key_count == 0:
            return []
        var keys: [text] = [""; key_count]
        var write_idx = 0
        for prop in _widget_props_store:
            if prop.node_id == self.id:
                keys[write_idx] = prop.key
                write_idx = write_idx + 1
        return keys

    fn children() -> [WidgetNode]:
        val child_ids = get_widget_child_ids(self.id)
        var child_count = 0
        for id in child_ids:
            if get_widget(id) != nil:
                child_count = child_count + 1
        if child_count == 0:
            return []
        var result: [WidgetNode] = [WidgetNode(id: ""); child_count]
        var write_idx = 0
        for id in child_ids:
            # WidgetNode is an id handle; construct it directly instead of
            # unwrapping the Optional (Option payload match loses the value
            # under the self-hosted runtime, yielding identity-less id:""
            # children — the empty-widget-shell / empty-text-mask bug).
            if get_widget(id) != nil:
                result[write_idx] = WidgetNode(id: id)
                write_idx = write_idx + 1
        return result

    fn child_count() -> i32:
        var count: i32 = 0
        for id in get_widget_child_ids(self.id):
            count = count + 1
        return count

    fn child_at(index: i32) -> WidgetNode?:
        if index < 0:
            return nil
        var i: i32 = 0
        for id in get_widget_child_ids(self.id):
            if i == index:
                return get_widget(id)
            i = i + 1
        return nil

    fn find_by_id(target_id: text) -> WidgetNode?:
        if self.id == target_id:
            return Some(self)
        for child in self.children():
            val found = child.find_by_id(target_id)
            match found:
                case Some(node):
                    return Some(node)
                case _:
                    pass
        return nil

    # Strict lookup: exactly-one-or-error. Never first-match — the whole
    # subtree is scanned so duplicate ids surface as an ambiguity error.
    fn find_widget_strict(target_id: text) -> WidgetFindStrictResult:
        return _find_widget_strict_in(self, target_id)

    fn collect_ids() -> [text]:
        var ids: [text] = [self.id]
        for child in self.children():
            for cid in child.collect_ids():
                ids.push(cid)
        return ids

    fn widget_summary() -> text:
        return "{self.id} ({self.kind_name()})"
