# UI Layout Engine
#
# Computes WidgetRect positions for a WidgetNode tree.
# Supports VBox (vertical stack), HBox (horizontal split),
# Grid, and Fixed layout modes with flex sizing.

use common.ui.widget.{WidgetNode, WidgetRect}

# =========================================================================
# DPI / scale helper
# =========================================================================

# Scale an i32 by an integer permille factor (1000 = identity, no-op). Kept
# as an explicit early-out so identity scaling never introduces integer
# division rounding even though `v * 1000 / 1000 == v` would anyway.
fn _apply_scale(v: i32, scale_permille: i32) -> i32:
    if scale_permille == 1000:
        return v
    (v * scale_permille) / 1000

# =========================================================================
# Layout Computation
# =========================================================================

# Scale an authored size constraint into device units. `max_*` accessors
# return -1 for "unset" (uncapped), which is a sentinel and not a length, so
# it must survive scaling unchanged — `_apply_scale(-1, 2000)` would give -2,
# still negative and still read as uncapped by clamp_dim, but the sentinel is
# pinned here rather than left to that coincidence.
fn _scaled_max(v: i32, scale_permille: i32) -> i32:
    if v < 0:
        return v
    _apply_scale(v, scale_permille)

fn compute_layout(node: WidgetNode, x: i32, y: i32, w: i32, h: i32, scale_permille: i32 = 1000) -> [WidgetRect]:
    """Compute layout rectangles for a widget tree.

    `scale_permille` is an integer DPI/UI scale factor in permille (1000 =
    1.0x, identity default — existing 4-arg callers are unaffected). It scales
    the requested (x, y, w, h) rect exactly once, here at the entry point, and
    is then carried down the tree as the factor for authored SIZE PROPS only
    (width/height/min_*/max_*, the scroll clip): those are written by callers
    in the same logical units as the x/y/w/h handed to this function, while
    every coordinate below this point is already in device units.

    The recursion therefore runs through `_layout_scaled`, which takes an
    already-scaled rect, so coordinates are never scaled twice while props are
    scaled at the one place they are read.
    """
    _layout_scaled(
        node,
        _apply_scale(x, scale_permille),
        _apply_scale(y, scale_permille),
        _apply_scale(w, scale_permille),
        _apply_scale(h, scale_permille),
        scale_permille)

# Layout body. (x, y, w, h) are ALREADY in device units; `scale_permille` is
# passed down purely to convert authored logical-unit props at their read
# sites. See compute_layout's docstring for why the two are separated.
fn _layout_scaled(node: WidgetNode, sx: i32, sy: i32, sw: i32, sh: i32, scale_permille: i32) -> [WidgetRect]:
    var rects: [WidgetRect] = [WidgetRect(id: node.id, x: sx, y: sy, w: sw, h: sh)]

    if not node.is_visible():
        return rects

    # Compute inner area (account for borders on panels)
    var inner_x = sx
    var inner_y = sy
    var inner_w = sw
    var inner_h = sh

    if node.kind_name() == "panel":
        # Panel has a 1-char border. Inset the ALREADY-SCALED rect (sx/sy/sw/
        # sh), never the raw args: `column()`/`row()`/`grid_layout()`/`panel()`
        # all build a WidgetKind.Panel, so this branch is the common container
        # path and insetting `x/y/w/h` here silently dropped DPI scaling for
        # every container subtree.
        inner_x = sx + 1
        inner_y = sy + 1
        inner_w = sw - 2
        inner_h = sh - 2

    # Scroll container clips inner height to max_height.
    #
    # inner_h is in DEVICE units (it derives from sh). `max_height` is authored
    # by the caller in LOGICAL units — builder.scroll(id, max_height, ...) takes
    # a plain i32 from code with no scale knowledge, the same units as the
    # x/y/w/h handed to compute_layout. Scale it here, at the same place and
    # exactly once, or the two sides of the comparison below are in different
    # units and the clip is meaningless at any non-identity scale. Because
    # scale_permille now reaches every level of the recursion, this holds for
    # a NESTED scroll container too, not only one sitting at the root.
    if node.kind_name() == "scroll":
        val max_h_str = node.get_prop("max_height")
        if max_h_str != "":
            val max_h = _apply_scale(max_h_str.to_int() ?? 0, scale_permille)
            if max_h > 0 and inner_h > max_h:
                inner_h = max_h

    if inner_w <= 0 or inner_h <= 0:
        return rects

    val visible_children = get_visible_children(node)
    if visible_children.len() == 0:
        return rects

    # Layout children based on layout kind
    if node.layout_name() == "vbox":
        val child_rects = layout_vbox(visible_children, inner_x, inner_y, inner_w, inner_h, scale_permille)
        for cr in child_rects:
            rects.push(cr)
    elif node.layout_name() == "hbox":
        val child_rects = layout_hbox(visible_children, inner_x, inner_y, inner_w, inner_h, scale_permille)
        for cr in child_rects:
            rects.push(cr)
    elif node.layout_name() == "grid":
        val child_rects = layout_grid(visible_children, inner_x, inner_y, inner_w, inner_h, get_grid_columns(node), scale_permille)
        for cr in child_rects:
            rects.push(cr)
    else:
        val child_rects = layout_fixed(visible_children, inner_x, inner_y, inner_w, inner_h, scale_permille)
        for cr in child_rects:
            rects.push(cr)

    return rects

fn get_visible_children(node: WidgetNode) -> [WidgetNode]:
    val children = node.children()
    var result: [WidgetNode] = []
    for child in children:
        if child.is_visible():
            result.push(child)
    return result

# =========================================================================
# VBox Layout (vertical stacking)
# =========================================================================

# (x, y, w, h) are in DEVICE units; `scale_permille` converts the authored
# logical-unit height props (height/min_height/max_height) at their read sites.
# It defaults to identity so a caller that lays out at 1.0x can omit it.
fn layout_vbox(children: [WidgetNode], x: i32, y: i32, w: i32, h: i32, scale_permille: i32 = 1000) -> [WidgetRect]:
    var rects: [WidgetRect] = []
    val count = children.len()
    if count == 0:
        return rects

    # Calculate sizes: fixed-height items first, then distribute remaining
    # free height in proportion to each child's `flex` weight — the same
    # policy layout_hbox applies on the other axis, so the two agree on both
    # weighting and the remainder invariant (awarded once, to the last
    # space-taking child). get_flex() defaults to 1, so children carrying no
    # flex prop still split the box equally, exactly as before.
    var total_fixed: i32 = 0
    var total_flex: i32 = 0

    for child in children:
        val fixed_h = _apply_scale(get_fixed_height(child), scale_permille)
        if fixed_h > 0:
            total_fixed = total_fixed + fixed_h
        else:
            val flex = get_flex(child)
            total_flex = total_flex + flex

    # Clamp remaining flex space at 0: when fixed children already overflow the
    # box, flex children get 0 height, never a negative size.
    var remaining = h - total_fixed
    if remaining < 0:
        remaining = 0
    val flex_unit = if total_flex > 0: remaining / total_flex else: 0
    val flex_remainder = if total_flex > 0: remaining - flex_unit * total_flex else: 0

    var cur_y = y
    var flex_idx: i32 = 0
    for child in children:
        val child_h = _apply_scale(get_fixed_height(child), scale_permille)
        var actual_h: i32 = 0
        if child_h > 0:
            actual_h = child_h
        else:
            val flex = get_flex(child)
            flex_idx = flex_idx + flex
            # Remainder guard, identical in form to layout_hbox's — see the
            # long comment there for why get_flex()'s clamp at 0 makes
            # flex_idx monotone, and why the `flex > 0` half is load-bearing
            # for TRAILING flex="0" children (without it they re-arm
            # `flex_idx >= total_flex` and collect a second copy).
            if flex > 0 and flex_idx >= total_flex:
                actual_h = flex * flex_unit + flex_remainder
            else:
                actual_h = flex * flex_unit

        actual_h = clamp_dim(
            actual_h,
            _apply_scale(get_min_height(child), scale_permille),
            _scaled_max(get_max_height(child), scale_permille))
        if actual_h > 0:
            val child_rects = _layout_scaled(child, x, cur_y, w, actual_h, scale_permille)
            for cr in child_rects:
                rects.push(cr)
            cur_y = cur_y + actual_h

    return rects

# =========================================================================
# HBox Layout (horizontal stacking)
# =========================================================================

# (x, y, w, h) are in DEVICE units; `scale_permille` converts the authored
# logical-unit width props (width/min_width/max_width) at their read sites.
# It defaults to identity so a caller that lays out at 1.0x can omit it.
fn layout_hbox(children: [WidgetNode], x: i32, y: i32, w: i32, h: i32, scale_permille: i32 = 1000) -> [WidgetRect]:
    var rects: [WidgetRect] = []
    val count = children.len()
    if count == 0:
        return rects

    # Calculate sizes: fixed-width items first, then distribute remaining
    var total_fixed: i32 = 0
    var total_flex: i32 = 0

    for child in children:
        val fixed_w = _apply_scale(get_fixed_width(child), scale_permille)
        if fixed_w > 0:
            total_fixed = total_fixed + fixed_w
        else:
            val flex = get_flex(child)
            total_flex = total_flex + flex

    # Clamp remaining flex space at 0: when fixed children already overflow the
    # box, flex children get 0 width, never a negative size.
    var remaining = w - total_fixed
    if remaining < 0:
        remaining = 0
    val flex_unit = if total_flex > 0: remaining / total_flex else: 0
    val flex_remainder = if total_flex > 0: remaining - flex_unit * total_flex else: 0

    var cur_x = x
    var flex_idx: i32 = 0
    for child in children:
        val fixed_w = _apply_scale(get_fixed_width(child), scale_permille)
        var actual_w: i32 = 0
        if fixed_w > 0:
            actual_w = fixed_w
        else:
            val flex = get_flex(child)
            flex_idx = flex_idx + flex
            # The integer-division remainder goes to the LAST child that
            # actually takes space, i.e. the last one with flex > 0. get_flex()
            # clamps at 0, so flex_idx is MONOTONE non-decreasing and only
            # positive-flex children advance it; the first child to push it up
            # to total_flex is therefore exactly the last positive-flex child,
            # and it is the only one that satisfies both halves of this guard.
            # That clamp is what makes this argument sound — a negative weight
            # would break monotonicity and re-admit a second award.
            #
            # The `flex > 0` half is load-bearing: adding 0 leaves flex_idx AT
            # total_flex, so without it every TRAILING flex="0" child re-armed
            # `flex_idx >= total_flex` and collected a second copy of the
            # remainder — w=10 with children flex=3 and flex=0 assigned 10+1
            # = 11px into a 10px box. A child that asked for zero width gets
            # zero width. layout_vbox applies the identical guard on the
            # other axis, so both agree on the invariant: remainder awarded
            # exactly once, to the last space-taking child.
            if flex > 0 and flex_idx >= total_flex:
                actual_w = flex * flex_unit + flex_remainder
            else:
                actual_w = flex * flex_unit

        actual_w = clamp_dim(
            actual_w,
            _apply_scale(get_min_width(child), scale_permille),
            _scaled_max(get_max_width(child), scale_permille))
        if actual_w > 0:
            val child_rects = _layout_scaled(child, cur_x, y, actual_w, h, scale_permille)
            for cr in child_rects:
                rects.push(cr)
            cur_x = cur_x + actual_w

    return rects

# =========================================================================
# Grid Layout
# =========================================================================

# Grid tracks are derived from the container rect, and `columns`/`col_span`
# are counts rather than lengths, so nothing here needs converting — but
# `scale_permille` still has to reach the children, whose own props do.
fn layout_grid(children: [WidgetNode], x: i32, y: i32, w: i32, h: i32, columns: i32 = 0, scale_permille: i32 = 1000) -> [WidgetRect]:
    var rects: [WidgetRect] = []
    val count = children.len()
    if count == 0:
        return rects

    var cols = columns
    if cols <= 0:
        # No explicit `columns` prop on the grid container — auto-calculate a
        # square-ish grid the way this function always has.
        cols = 1
        while cols * cols < count:
            cols = cols + 1

    # Placement pass: walk children in order, wrapping to a new row whenever
    # a child's col_span would overflow the remaining columns in the current
    # row. Recorded once (row/col/span per child) so the paint pass below
    # can't drift from this placement with separately-computed indices.
    var place_row: [i32] = []
    var place_col: [i32] = []
    var place_span: [i32] = []
    var cur_row = 0
    var cur_col = 0
    var max_row = 0
    for child in children:
        var span = get_col_span(child)
        if span > cols:
            span = cols
        if cur_col + span > cols:
            cur_row = cur_row + 1
            cur_col = 0
        if cur_row > max_row:
            max_row = cur_row
        place_row.push(cur_row)
        place_col.push(cur_col)
        place_span.push(span)
        cur_col = cur_col + span

    val rows = max_row + 1
    val cell_w = w / cols
    val cell_h = h / rows

    # Integer division truncates, so `cell_w * cols` and `cell_h * rows` fall
    # short of the container by up to cols-1 / rows-1 pixels. layout_hbox and
    # layout_vbox both document the invariant that the remainder is awarded
    # exactly once, to the LAST space-taking child, so children always sum to
    # the container; grid used to drop it, leaving an unpainted strip on the
    # right edge and along the bottom of every grid whose size is not an exact
    # multiple of its track count. Track edges are therefore computed as
    # absolute boundaries — base multiples for interior tracks, the container's
    # own far edge for the last one — so the awarded remainder lands in the
    # final column/row and every cell stays adjacent to its neighbour with no
    # gap and no overflow. A cell that SPANS to the last column inherits that
    # edge too, so a span never has to be widened separately. This is the same
    # policy grid_layout() in src/app/ui.render/layout.spl already applies
    # ("last column/row absorbs rounding remainder"), so the two grid
    # implementations in this repo agree.
    #
    # Note the invariant is over TRACKS, not children: it is the track grid
    # that covers the container exactly. hbox/vbox can say "children always
    # sum to the container" because every child sits on the one axis; a grid
    # cannot, because a row need not be full. With cols=4 and two children of
    # col_span=3, each child takes columns 0..2 of its own row and column 3 is
    # unoccupied in both rows — there is no cell there to paint. Awarding the
    # remainder to the last CHILD instead (the hbox reading) would make the
    # trailing child of a short row wider than the same column elsewhere,
    # breaking column alignment, which is why placement drives this, not
    # child order.
    var idx = 0
    for child in children:
        val grid_row = place_row[idx]
        val grid_col = place_col[idx]
        val span = place_span[idx]
        val cell_x = x + (grid_col * cell_w)
        val cell_y = y + (grid_row * cell_h)
        val col_end = grid_col + span
        val cell_right = if col_end >= cols: x + w else: x + (col_end * cell_w)
        val cell_bottom = if grid_row + 1 >= rows: y + h else: y + ((grid_row + 1) * cell_h)
        val cell_span_w = cell_right - cell_x
        val cell_span_h = cell_bottom - cell_y

        val child_rects = _layout_scaled(child, cell_x, cell_y, cell_span_w, cell_span_h, scale_permille)
        for cr in child_rects:
            rects.push(cr)
        idx = idx + 1

    return rects

# Explicit column count for a grid container (the `columns` prop). 0 (unset
# or non-positive) means "auto" — layout_grid falls back to the sqrt heuristic.
fn get_grid_columns(node: WidgetNode) -> i32:
    val v = node.get_prop("columns")
    if v != "":
        return v.to_int() ?? 0
    return 0

# Per-child column span for a grid cell (the `col_span` prop). Unset or < 1
# defaults to 1 (a single cell); layout_grid additionally clamps it to the
# container's column count.
fn get_col_span(node: WidgetNode) -> i32:
    val v = node.get_prop("col_span")
    if v != "":
        val s = v.to_int() ?? 1
        if s < 1:
            return 1
        return s
    return 1

# =========================================================================
# Fixed Layout (absolute positioning)
# =========================================================================

# (x, y, w, h) are in DEVICE units; `scale_permille` converts each child's
# authored logical-unit width/height props at their read sites. It defaults to
# identity so a caller that lays out at 1.0x can omit it.
fn layout_fixed(children: [WidgetNode], x: i32, y: i32, w: i32, h: i32, scale_permille: i32 = 1000) -> [WidgetRect]:
    val child_count = children.len()
    if child_count == 0:
        return []
    val first = children[0]
    val first_w = _apply_scale(get_fixed_width(first), scale_permille)
    val first_h = _apply_scale(get_fixed_height(first), scale_permille)
    val first_actual_w = if first_w > 0: first_w else: w
    val first_actual_h = if first_h > 0: first_h else: h
    var rects: [WidgetRect] = _layout_scaled(first, x, y, first_actual_w, first_actual_h, scale_permille)
    var idx = 1
    while idx < child_count:
        # Fixed layout uses the full parent area for each child
        val child = children[idx]
        val child_w = _apply_scale(get_fixed_width(child), scale_permille)
        val child_h = _apply_scale(get_fixed_height(child), scale_permille)
        val actual_w = if child_w > 0: child_w else: w
        val actual_h = if child_h > 0: child_h else: h
        val child_rects = _layout_scaled(child, x, y, actual_w, actual_h, scale_permille)
        for cr in child_rects:
            rects.push(cr)
        idx = idx + 1
    return rects

# =========================================================================
# Property Helpers
# =========================================================================

fn get_fixed_width(node: WidgetNode) -> i32:
    val w = node.get_prop("width")
    if w != "":
        return w.to_int() ?? 0
    return 0

fn get_fixed_height(node: WidgetNode) -> i32:
    val h = node.get_prop("height")
    if h != "":
        return h.to_int() ?? 0
    val kind = node.kind_name()
    if kind == "statusbar" or kind == "menubar":
        return 1
    if kind == "scroll":
        val max_h = node.get_prop("max_height")
        if max_h != "":
            return max_h.to_int() ?? 0
    if kind == "textarea":
        val rows = node.get_prop("rows")
        if rows != "":
            return rows.to_int() ?? 0
    return 0

# A flex weight is a share of the free space, so it is never negative. Clamping
# here rather than at the call sites keeps `total_flex` and the per-child
# weights consistent: a negative weight would make layout_hbox's running
# flex_idx non-monotone, so more than one child could satisfy
# `flex_idx >= total_flex` and the remainder would be awarded twice again (w=10
# with weights 5/-2/1 assigned 16px). It would also make flex_unit negative
# when the weights sum below zero.
fn get_flex(node: WidgetNode) -> i32:
    val f = node.get_prop("flex")
    if f != "":
        val v = f.to_int() ?? 1
        return if v > 0: v else: 0
    return 1

# Optional size constraints. min_* default 0 (no lower bound); max_* default -1
# meaning "unset" (no upper bound). max_height doubles as the scroll clip
# height, so capping to it is a no-op for scroll containers and a genuine cap
# elsewhere.
#
# These accessors return the value as AUTHORED, i.e. in logical units — the
# same units as the x/y/w/h handed to compute_layout. layout_vbox/layout_hbox
# compare them against device-unit sizes, so they convert with _apply_scale /
# _scaled_max at the read site, exactly as the scroll clip does. Keeping the
# conversion at the call site rather than in here is what lets the raw
# authored value stay observable to callers that want it.
fn get_min_width(node: WidgetNode) -> i32:
    val v = node.get_prop("min_width")
    if v != "":
        return v.to_int() ?? 0
    return 0

fn get_max_width(node: WidgetNode) -> i32:
    val v = node.get_prop("max_width")
    if v != "":
        return v.to_int() ?? -1
    return -1

fn get_min_height(node: WidgetNode) -> i32:
    val v = node.get_prop("min_height")
    if v != "":
        return v.to_int() ?? 0
    return 0

fn get_max_height(node: WidgetNode) -> i32:
    val v = node.get_prop("max_height")
    if v != "":
        return v.to_int() ?? -1
    return -1

# Clamp a computed size into [min_v, max_v], with max_v < 0 meaning uncapped.
# Never returns a negative size.
fn clamp_dim(size: i32, min_v: i32, max_v: i32) -> i32:
    var s = size
    if max_v >= 0 and s > max_v:
        s = max_v
    if s < min_v:
        s = min_v
    if s < 0:
        s = 0
    s

# =========================================================================
# Layout Lookup
# =========================================================================

fn find_rect_index(rects: [WidgetRect], id: text) -> i64:
    var index = 0
    while index < rects.len():
        if rects[index].id == id:
            return index
        index = index + 1
    -1

fn find_rect(rects: [WidgetRect], id: text) -> WidgetRect?:
    val index = find_rect_index(rects, id)
    if index >= 0:
        return rects[index]
    return nil
