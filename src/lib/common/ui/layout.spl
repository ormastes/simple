# UI Layout Engine
#
# Computes WidgetRect positions for a WidgetNode tree using shared
# ConstraintSpace, EdgeInsets, GapSpacing, and axis_distribute primitives
# from common.layout.constraint_space.
# Supports VBox (vertical stack), HBox (horizontal split), Grid, and Fixed modes.

use common.ui.widget.{WidgetNode, WidgetRect}
use common.layout.constraint_space.{
    LAYOUT_UNIT_CELLS, LAYOUT_UNIT_PIXELS,
    ConstraintSpace, EdgeInsets, GapSpacing, MinMaxSizes, LayoutBounds,
    AxisTrackSpec, AxisSlot, AxisDistributionResult,
    ui_constraint_space_cells, ui_constraint_space_pixels,
    clamp_span, axis_distribute
}

# =========================================================================
# DPI / scale helper
# =========================================================================

# Scale an i32 by an integer permille factor (1000 = identity, no-op). Kept
# as an explicit early-out so identity scaling never introduces integer
# division rounding even though `v * 1000 / 1000 == v` would anyway.
fn _apply_scale(v: i32, scale_permille: i32) -> i32:
    if scale_permille == 1000:
        return v
    (v * scale_permille) / 1000

# Scale an authored size constraint into device units. `max_*` accessors
# return -1 for "unset" (uncapped), which is a sentinel and not a length.
fn _scaled_max(v: i32, scale_permille: i32) -> i32:
    if v < 0:
        return v
    _apply_scale(v, scale_permille)

val PIXEL_PANEL_TITLE_HEIGHT: i32 = 18

# =========================================================================
# Property Parsing Helpers (Padding, Gap, Units)
# =========================================================================

fn _parse_ui_length(raw: text, default_val: i32) -> i32:
    """Parse a positive/zero integer or `<N>px` widget prop length."""
    var s = raw.trim()
    if s == "":
        return default_val
    if s.ends_with("px") and s.byte_len() > 2:
        s = s.substring(0, s.byte_len() - 2).trim()
    s.to_int() ?? default_val

fn _get_padding_insets(node: WidgetNode, scale_permille: i32) -> EdgeInsets:
    """Parse `padding` (1, 2, or 4 tokens) plus directional `padding_*` overrides."""
    var top: i32 = 0
    var right: i32 = 0
    var bottom: i32 = 0
    var left: i32 = 0
    val raw = node.get_prop("padding").trim()
    if raw != "":
        var vals: [i32] = []
        for tok in raw.split(" "):
            val t = tok.trim()
            if t != "":
                val parsed = _parse_ui_length(t, 0)
                vals.push(if parsed > 0: parsed else: 0)
        if vals.len() == 1:
            top = vals[0]
            right = vals[0]
            bottom = vals[0]
            left = vals[0]
        elif vals.len() == 2:
            top = vals[0]
            bottom = vals[0]
            right = vals[1]
            left = vals[1]
        elif vals.len() >= 4:
            top = vals[0]
            right = vals[1]
            bottom = vals[2]
            left = vals[3]
    val pt = node.get_prop("padding_top")
    if pt != "": top = _parse_ui_length(pt, top)
    val pr = node.get_prop("padding_right")
    if pr != "": right = _parse_ui_length(pr, right)
    val pb = node.get_prop("padding_bottom")
    if pb != "": bottom = _parse_ui_length(pb, bottom)
    val pl = node.get_prop("padding_left")
    if pl != "": left = _parse_ui_length(pl, left)
    EdgeInsets(
        top: _apply_scale(if top > 0: top else: 0, scale_permille),
        right: _apply_scale(if right > 0: right else: 0, scale_permille),
        bottom: _apply_scale(if bottom > 0: bottom else: 0, scale_permille),
        left: _apply_scale(if left > 0: left else: 0, scale_permille)
    )

fn _get_gap_spacing(node: WidgetNode, scale_permille: i32) -> GapSpacing:
    """Parse container `gap`, `row_gap`, and `column_gap`/`col_gap` props."""
    val base = _parse_ui_length(node.get_prop("gap"), 0)
    var rg = base
    var cg = base
    val raw_rg = node.get_prop("row_gap")
    if raw_rg != "":
        rg = _parse_ui_length(raw_rg, rg)
    val raw_cg = node.get_prop("column_gap")
    if raw_cg != "":
        cg = _parse_ui_length(raw_cg, cg)
    val raw_col_gap = node.get_prop("col_gap")
    if raw_col_gap != "":
        cg = _parse_ui_length(raw_col_gap, cg)
    GapSpacing(
        row_gap: _apply_scale(if rg > 0: rg else: 0, scale_permille),
        col_gap: _apply_scale(if cg > 0: cg else: 0, scale_permille)
    )

# =========================================================================
# Layout Computation & Constraint Space Entry Points
# =========================================================================

# Pixel hosts reserve a title band; terminals retain one-cell borders.
fn compute_pixel_layout(node: WidgetNode, x: i32, y: i32, w: i32, h: i32, scale_permille: i32 = 1000) -> [WidgetRect]:
    """Compute pixel-unit widget rectangles with DPI scale and panel title band."""
    val space = ui_constraint_space_pixels(w, h, scale_permille, PIXEL_PANEL_TITLE_HEIGHT)
    compute_layout_with_space(node, x, y, space)

fn compute_layout(node: WidgetNode, x: i32, y: i32, w: i32, h: i32, scale_permille: i32 = 1000, panel_title_height: i32 = 0) -> [WidgetRect]:
    """Compute widget rectangles (cell mode by default, or pixel title height when > 0)."""
    val space = if panel_title_height > 0:
        ui_constraint_space_pixels(w, h, scale_permille, panel_title_height)
    else:
        ui_constraint_space_cells(w, h, scale_permille)
    compute_layout_with_space(node, x, y, space)

# reason: origin (x, y) mirrors compute_layout's integer coordinate entry contract.
# @allow(primitive_api)
pub fn compute_layout_with_space(node: WidgetNode, x: i32, y: i32, space: ConstraintSpace) -> [WidgetRect]:
    """Compute widget rectangles driven explicitly by an immutable ConstraintSpace."""
    val sx = _apply_scale(x, space.scale_permille)
    val sy = _apply_scale(y, space.scale_permille)
    val sw = _apply_scale(space.available_w, space.scale_permille)
    val sh = _apply_scale(space.available_h, space.scale_permille)
    _layout_scaled(node, sx, sy, sw, sh, space.scale_permille, space.panel_title_height)

fn _layout_scaled(node: WidgetNode, sx: i32, sy: i32, sw: i32, sh: i32, scale_permille: i32, panel_title_height: i32) -> [WidgetRect]:
    var rects: [WidgetRect] = [WidgetRect(id: node.id, x: sx, y: sy, w: sw, h: sh)]

    if not node.is_visible():
        return rects

    val children = node.children()
    if children.len() == 0:
        return rects

    var inner_x = sx
    var inner_y = sy
    var inner_w = sw
    var inner_h = sh

    # Panel border stays a fixed 1 unit on every host; only the reserved pixel
    # title band scales with DPI so titles keep their proportion.
    if node.kind_name() == "panel":
        inner_x = sx + 1
        inner_y = sy + 1
        inner_w = sw - 2
        inner_h = sh - 2
        if node.get_prop("title") != "" and panel_title_height > 0:
            val title_h = _apply_scale(panel_title_height, scale_permille)
            inner_y = inner_y + title_h
            inner_h = inner_h - title_h

    # Apply container padding after panel border/title insets.
    val pad = _get_padding_insets(node, scale_permille)
    if pad.horizontal() > 0 or pad.vertical() > 0:
        val padded = pad.inset_bounds(inner_x, inner_y, inner_w, inner_h)
        inner_x = padded.x
        inner_y = padded.y
        inner_w = padded.w
        inner_h = padded.h

    # Scroll container clips inner height to scaled max_height.
    if node.kind_name() == "scroll":
        val max_h_str = node.get_prop("max_height")
        if max_h_str != "":
            val max_h = _apply_scale(max_h_str.to_int() ?? 0, scale_permille)
            if max_h > 0 and inner_h > max_h:
                inner_h = max_h

    if inner_w <= 0 or inner_h <= 0:
        return rects

    val visible_children = get_visible_children(node)
    if visible_children.len() == 0:
        return rects

    val gaps = _get_gap_spacing(node, scale_permille)
    val justify = node.get_prop("justify").trim()
    val layout_kind = node.layout_name()
    if layout_kind == "vbox":
        val child_rects = _layout_axis_children(visible_children, inner_x, inner_y, inner_w, inner_h, false, gaps.row_gap, justify, scale_permille, panel_title_height)
        for cr in child_rects:
            rects.push(cr)
    elif layout_kind == "hbox":
        val child_rects = _layout_axis_children(visible_children, inner_x, inner_y, inner_w, inner_h, true, gaps.col_gap, justify, scale_permille, panel_title_height)
        for cr in child_rects:
            rects.push(cr)
    elif layout_kind == "grid":
        val child_rects = _layout_grid_with_gaps(visible_children, inner_x, inner_y, inner_w, inner_h, get_grid_columns(node), gaps.col_gap, gaps.row_gap, scale_permille, panel_title_height)
        for cr in child_rects:
            rects.push(cr)
    else:
        val child_rects = layout_fixed(visible_children, inner_x, inner_y, inner_w, inner_h, scale_permille, panel_title_height)
        for cr in child_rects:
            rects.push(cr)

    return rects

fn get_visible_children(node: WidgetNode) -> [WidgetNode]:
    val children = node.children()
    var result: [WidgetNode] = []
    for child in children:
        if child.is_visible():
            result.push(child)
    return result

# =========================================================================
# Unified Axis Layout (shared by VBox and HBox via axis_distribute)
# =========================================================================

fn _build_axis_specs(children: [WidgetNode], horizontal: bool, scale_permille: i32) -> [AxisTrackSpec]:
    """Convert widget child props along the chosen axis into AxisTrackSpec items."""
    var specs: [AxisTrackSpec] = []
    for child in children:
        val fixed_v = _apply_scale(if horizontal: get_fixed_width(child) else: get_fixed_height(child), scale_permille)
        val min_v = _apply_scale(if horizontal: get_min_width(child) else: get_min_height(child), scale_permille)
        val max_v = _scaled_max(if horizontal: get_max_width(child) else: get_max_height(child), scale_permille)
        if fixed_v > 0:
            specs.push(AxisTrackSpec.fixed_item(fixed_v, min_v, max_v))
        else:
            specs.push(AxisTrackSpec.flex_item(get_flex(child), min_v, max_v))
    specs

fn _layout_axis_children(
    children: [WidgetNode],
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    horizontal: bool,
    gap: i32,
    justify: text,
    scale_permille: i32,
    panel_title_height: i32
) -> [WidgetRect]:
    """Shared vertical/horizontal stack allocator preserving UI flex remainder & clamping."""
    var rects: [WidgetRect] = []
    if children.len() == 0:
        return rects
    val avail_main = if horizontal: w else: h
    val specs = _build_axis_specs(children, horizontal, scale_permille)
    val dist = axis_distribute(avail_main, gap, justify, specs, true)
    var i: i32 = 0
    val count = children.len() as i32
    while i < count:
        val slot = dist.slots[i]
        if slot.size > 0:
            val cx = if horizontal: x + slot.offset else: x
            val cy = if horizontal: y else: y + slot.offset
            val cw = if horizontal: slot.size else: w
            val ch = if horizontal: h else: slot.size
            val child_rects = _layout_scaled(children[i], cx, cy, cw, ch, scale_permille, panel_title_height)
            for cr in child_rects:
                rects.push(cr)
        i = i + 1
    rects

# (x, y, w, h) are in DEVICE units; `scale_permille` converts authored
# logical-unit height/width props at their read sites.
fn layout_vbox(children: [WidgetNode], x: i32, y: i32, w: i32, h: i32, scale_permille: i32 = 1000, panel_title_height: i32 = 0) -> [WidgetRect]:
    """Lay out children vertically using the shared axis distributor."""
    _layout_axis_children(children, x, y, w, h, false, 0, "", scale_permille, panel_title_height)

fn layout_hbox(children: [WidgetNode], x: i32, y: i32, w: i32, h: i32, scale_permille: i32 = 1000, panel_title_height: i32 = 0) -> [WidgetRect]:
    """Lay out children horizontally using the shared axis distributor."""
    _layout_axis_children(children, x, y, w, h, true, 0, "", scale_permille, panel_title_height)

# =========================================================================
# Grid Layout (backed by shared axis_distribute track slots + gaps)
# =========================================================================

fn _build_equal_track_specs(track_count: i32) -> [AxisTrackSpec]:
    var specs: [AxisTrackSpec] = []
    var i: i32 = 0
    while i < track_count:
        specs.push(AxisTrackSpec.flex_item(1, 0, -1))
        i = i + 1
    specs

fn _layout_grid_with_gaps(
    children: [WidgetNode],
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    columns: i32,
    col_gap: i32,
    row_gap: i32,
    scale_permille: i32,
    panel_title_height: i32
) -> [WidgetRect]:
    """Lay out grid children with explicit/auto column tracks, col_span, gaps, and exact track remainder."""
    var rects: [WidgetRect] = []
    val count = children.len()
    if count == 0:
        return rects

    var cols = columns
    if cols <= 0:
        cols = 1
        while cols * cols < count:
            cols = cols + 1

    var place_row: [i32] = []
    var place_col: [i32] = []
    var place_span: [i32] = []
    var cur_row: i32 = 0
    var cur_col: i32 = 0
    var max_row: i32 = 0
    for child in children:
        var span = get_col_span(child)
        if span > cols:
            span = cols
        if cur_col + span > cols:
            cur_row = cur_row + 1
            cur_col = 0
        if cur_row > max_row:
            max_row = cur_row
        place_row.push(cur_row)
        place_col.push(cur_col)
        place_span.push(span)
        cur_col = cur_col + span

    val rows = max_row + 1
    val col_dist = axis_distribute(w, col_gap, "", _build_equal_track_specs(cols), true)
    val row_dist = axis_distribute(h, row_gap, "", _build_equal_track_specs(rows), true)

    var idx = 0
    for child in children:
        val grid_row = place_row[idx]
        val grid_col = place_col[idx]
        val span = place_span[idx]
        val start_col_slot = col_dist.slots[grid_col]
        val end_col_idx = if grid_col + span - 1 < cols: grid_col + span - 1 else: cols - 1
        val end_col_slot = col_dist.slots[end_col_idx]
        val row_slot = row_dist.slots[grid_row]

        val cell_x = x + start_col_slot.offset
        val cell_y = y + row_slot.offset
        val cell_span_w = (end_col_slot.offset + end_col_slot.size) - start_col_slot.offset
        val cell_span_h = row_slot.size

        val child_rects = _layout_scaled(child, cell_x, cell_y, cell_span_w, cell_span_h, scale_permille, panel_title_height)
        for cr in child_rects:
            rects.push(cr)
        idx = idx + 1

    rects

# Grid tracks are derived from the container rect, and `columns`/`col_span`
# are counts rather than lengths, so nothing here needs converting — but
# `scale_permille` still has to reach the children, whose own props do.
fn layout_grid(children: [WidgetNode], x: i32, y: i32, w: i32, h: i32, columns: i32 = 0, scale_permille: i32 = 1000, panel_title_height: i32 = 0) -> [WidgetRect]:
    """Lay out grid children into `columns` tracks (square-ish auto heuristic when <= 0)."""
    _layout_grid_with_gaps(children, x, y, w, h, columns, 0, 0, scale_permille, panel_title_height)

# Explicit column count for a grid container (the `columns` prop). 0 (unset
# or non-positive) means "auto" — layout_grid falls back to the sqrt heuristic.
fn get_grid_columns(node: WidgetNode) -> i32:
    val v = node.get_prop("columns")
    if v != "":
        return v.to_int() ?? 0
    return 0

# Per-child column span for a grid cell (the `col_span` prop). Unset or < 1
# defaults to 1 (a single cell); layout_grid additionally clamps it to the
# container's column count.
fn get_col_span(node: WidgetNode) -> i32:
    val v = node.get_prop("col_span")
    if v != "":
        val s = v.to_int() ?? 1
        if s < 1:
            return 1
        return s
    return 1

# =========================================================================
# Fixed Layout (absolute positioning)
# =========================================================================

fn layout_fixed(children: [WidgetNode], x: i32, y: i32, w: i32, h: i32, scale_permille: i32 = 1000, panel_title_height: i32 = 0) -> [WidgetRect]:
    val child_count = children.len()
    if child_count == 0:
        return []
    val first = children[0]
    val first_w = _apply_scale(get_fixed_width(first), scale_permille)
    val first_h = _apply_scale(get_fixed_height(first), scale_permille)
    val first_actual_w = if first_w > 0: first_w else: w
    val first_actual_h = if first_h > 0: first_h else: h
    var rects: [WidgetRect] = _layout_scaled(first, x, y, first_actual_w, first_actual_h, scale_permille, panel_title_height)
    var idx = 1
    while idx < child_count:
        val child = children[idx]
        val child_w = _apply_scale(get_fixed_width(child), scale_permille)
        val child_h = _apply_scale(get_fixed_height(child), scale_permille)
        val actual_w = if child_w > 0: child_w else: w
        val actual_h = if child_h > 0: child_h else: h
        val child_rects = _layout_scaled(child, x, y, actual_w, actual_h, scale_permille, panel_title_height)
        for cr in child_rects:
            rects.push(cr)
        idx = idx + 1
    return rects

# =========================================================================
# Property Helpers & Clamping
# =========================================================================

fn get_fixed_width(node: WidgetNode) -> i32:
    val w = node.get_prop("width")
    if w != "":
        return w.to_int() ?? 0
    return 0

fn get_fixed_height(node: WidgetNode) -> i32:
    val h = node.get_prop("height")
    if h != "":
        return h.to_int() ?? 0
    val kind = node.kind_name()
    if kind == "statusbar" or kind == "menubar":
        return 1
    if kind == "scroll":
        val max_h = node.get_prop("max_height")
        if max_h != "":
            return max_h.to_int() ?? 0
    if kind == "textarea":
        val rows = node.get_prop("rows")
        if rows != "":
            return rows.to_int() ?? 0
    return 0

fn get_flex(node: WidgetNode) -> i32:
    val f = node.get_prop("flex")
    if f != "":
        val v = f.to_int() ?? 1
        return if v > 0: v else: 0
    return 1

fn get_min_width(node: WidgetNode) -> i32:
    val v = node.get_prop("min_width")
    if v != "":
        return v.to_int() ?? 0
    return 0

fn get_max_width(node: WidgetNode) -> i32:
    val v = node.get_prop("max_width")
    if v != "":
        return v.to_int() ?? -1
    return -1

fn get_min_height(node: WidgetNode) -> i32:
    val v = node.get_prop("min_height")
    if v != "":
        return v.to_int() ?? 0
    return 0

fn get_max_height(node: WidgetNode) -> i32:
    val v = node.get_prop("max_height")
    if v != "":
        return v.to_int() ?? -1
    return -1

# Clamp a computed size into [min_v, max_v], with max_v < 0 meaning uncapped.
# Never returns a negative size.
fn clamp_dim(size: i32, min_v: i32, max_v: i32) -> i32:
    clamp_span(size, min_v, max_v)

# =========================================================================
# Layout Lookup
# =========================================================================

fn find_rect_index(rects: [WidgetRect], id: text) -> i64:
    var index = 0
    while index < rects.len():
        if rects[index].id == id:
            return index
        index = index + 1
    -1

fn find_rect(rects: [WidgetRect], id: text) -> WidgetRect?:
    val index = find_rect_index(rects, id)
    if index >= 0:
        return rects[index]
    return None
