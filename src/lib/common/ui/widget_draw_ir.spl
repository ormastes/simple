# widget_draw_ir.spl — Widget-tree → Draw-IR converter.
#
# Walks a laid-out WidgetNode tree (via compute_layout) and emits shared
# Draw-IR commands (rect / text / image) that engine2d `draw_ir_adv` can
# render directly. This is the preferred pipeline the UI docs call for:
# interactive apps stop hand-rolling draw calls and instead lay out widgets,
# then convert to Draw IR.
#
# Interaction state (hover / pressed / checked / focus / scroll offset) is read
# from the same process-local widget prop store the event router writes, so a
# re-conversion after an event shows the updated frame.
#
# Renderer support: engine2d draw_ir_adv executes RECT + TEXT + IMAGE commands
# and applies clipping per-batch (batch.embedding.clip). Scroll areas therefore
# become their own clipped batch with content offset by the scroll amount.
#
use common.ui.layout.{compute_layout, find_rect_index}
use common.ui.widget.{WidgetNode, WidgetRect}
use common.ui.theme_render_snapshot.{ThemeRenderSnapshot, theme_role_color}
use common.ui.theme_draw_ir_material.{
    theme_draw_ir_surface_command_color,
    theme_draw_ir_surface_initializer_color,
    theme_draw_ir_surface_style
}
use common.ui.wm_chrome_theme.{WmChromeColors, wm_chrome_theme, wm_chrome_colors_from_gui_tokens}
use common.ui.style.{UITheme}
use common.ui.glass.theme.{
    aqua_dark,
    aqua_light,
    glass_dark,
    glass_light,
    glass_obsidian_dark,
    glass_obsidian_light
}
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU,
    DrawIrBatch,
    DrawIrComposition,
    DrawIrCommand,
    draw_ir_batch_with_source,
    draw_ir_box_with_style,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_image_command,
    draw_ir_no_rect,
    draw_ir_rect,
    draw_ir_rect_bounds,
    draw_ir_source_gui_ast,
    DrawIrGlyphRunPayload,
    draw_ir_empty_glyph_run_payload,
    draw_ir_glyph_run_payload,
    draw_ir_text,
    draw_ir_text_resolved_font,
    draw_ir_text_shaped_font
}
use common.ui.glyph_bitmap_5x7.{glyph_index_for_char}
use std.common.encoding.font_registry.{simpleos_default_font_asset_candidate}
use std.nogc_sync_mut.text_layout.font_renderer.{resolve_font_metrics_with_language}

# =========================================================================
# Semantic widget roles
# =========================================================================

struct WidgetDrawIrTheme:
    surface: u32
    text_primary: u32
    text_secondary: u32
    accent: u32
    border: u32
    control_normal: u32
    control_hover: u32
    control_pressed: u32
    field: u32
    track: u32
    placeholder: u32
    status_info: u32
    status_success: u32
    status_warning: u32
    status_error: u32

fn widget_draw_ir_theme_from_snapshot(snapshot: ThemeRenderSnapshot) -> WidgetDrawIrTheme:
    """Resolve the canonical L5 roles once for Draw-IR widget projection."""
    WidgetDrawIrTheme(
        surface: theme_role_color(snapshot, "workbench.panel").rgba,
        text_primary: theme_role_color(snapshot, "document.text").rgba,
        text_secondary: theme_role_color(snapshot, "slide.placeholder").rgba,
        accent: theme_role_color(snapshot, "wm.controls").rgba,
        border: theme_role_color(snapshot, "wm.border").rgba,
        control_normal: theme_role_color(snapshot, "wm.controls").rgba,
        control_hover: theme_role_color(snapshot, "wm.titlebar").rgba,
        control_pressed: theme_role_color(snapshot, "workbench.tab_bar").rgba,
        field: theme_role_color(snapshot, "workbench.editor").rgba,
        track: theme_role_color(snapshot, "workbench.tab_bar").rgba,
        placeholder: theme_role_color(snapshot, "slide.placeholder").rgba,
        status_info: theme_role_color(snapshot, "semantic.info").rgba,
        status_success: theme_role_color(snapshot, "semantic.success").rgba,
        status_warning: theme_role_color(snapshot, "semantic.warning").rgba,
        status_error: theme_role_color(snapshot, "semantic.error").rgba
    )

fn _widget_draw_ir_theme_from_wm_chrome(chrome: WmChromeColors) -> WidgetDrawIrTheme:
    # Compatibility callers still consume the central installed theme rather
    # than owning a second fixed palette.
    WidgetDrawIrTheme(
        surface: chrome.window_body,
        text_primary: chrome.text_primary,
        text_secondary: chrome.text_primary,
        accent: chrome.accent,
        border: chrome.title_unfocused,
        control_normal: chrome.accent,
        control_hover: chrome.title_focused,
        control_pressed: chrome.title_unfocused,
        field: chrome.host_window_body,
        track: chrome.title_unfocused,
        placeholder: chrome.compositor_bg,
        status_info: chrome.accent,
        status_success: chrome.accent,
        status_warning: chrome.accent,
        status_error: chrome.accent
    )

fn _widget_draw_ir_theme_from_ui_theme(ui_theme: UITheme) -> WidgetDrawIrTheme:
    # Project a named UITheme's CSS tokens through the shared GUI->WM bridge
    # so this pipeline speaks the same palette as the chrome pipelines.
    val colors = ui_theme.colors
    _widget_draw_ir_theme_from_wm_chrome(wm_chrome_colors_from_gui_tokens(
        colors.background.to_css(),
        colors.foreground.to_css(),
        colors.accent.to_css(),
        colors.panel_bg,
        colors.hover_bg,
        colors.error.to_css()
    ))

fn _widget_draw_ir_theme_from_name(theme_name: text) -> WidgetDrawIrTheme:
    # Canonical name -> palette dispatch for this pipeline (same role as
    # glass/theme.spl's is_glass_theme; literals here are the mapping, not
    # call-site usage). Unknown names keep the installed wm_chrome palette.
    if theme_name == "glass_light":
        return _widget_draw_ir_theme_from_ui_theme(glass_light())
    if theme_name == "glass_dark":
        return _widget_draw_ir_theme_from_ui_theme(glass_dark())
    if theme_name == "glass_obsidian_dark":
        return _widget_draw_ir_theme_from_ui_theme(glass_obsidian_dark())
    if theme_name == "glass_obsidian_light":
        return _widget_draw_ir_theme_from_ui_theme(glass_obsidian_light())
    if theme_name == "aqua_light":
        return _widget_draw_ir_theme_from_ui_theme(aqua_light())
    if theme_name == "aqua_dark":
        return _widget_draw_ir_theme_from_ui_theme(aqua_dark())
    _widget_draw_ir_theme_from_wm_chrome(wm_chrome_theme())

fn _widget_draw_ir_theme_for_root(root: WidgetNode) -> WidgetDrawIrTheme:
    # UITree.with_theme stores the requested theme name on the root node;
    # honor it when present, keep the installed wm_chrome palette otherwise.
    val theme_name = root.get_prop("ui_tree_theme")
    if theme_name == "":
        return _widget_draw_ir_theme_from_wm_chrome(wm_chrome_theme())
    _widget_draw_ir_theme_from_name(theme_name)

val GLYPH_ADVANCE: i32 = 7

# =========================================================================
# Prop helpers
# =========================================================================

fn _prop_int(node: WidgetNode, key: text) -> i32:
    val raw = node.get_prop(key)
    if raw == "":
        return 0
    raw.to_int() ?? 0

fn _label_text(node: WidgetNode) -> text:
    val lbl = node.get_prop("label")
    if lbl != "":
        return lbl
    node.get_prop("content")

fn _button_color(node: WidgetNode, theme: WidgetDrawIrTheme) -> u32:
    if node.get_prop("ui_pressed") == "true":
        return theme.control_pressed
    if node.get_prop("ui_hover") == "true":
        return theme.control_hover
    theme.control_normal

fn _status_color(node: WidgetNode, theme: WidgetDrawIrTheme) -> u32:
    val status = node.get_prop("status")
    if status == "info":
        return theme.status_info
    if status == "success":
        return theme.status_success
    if status == "warning":
        return theme.status_warning
    if status == "error":
        return theme.status_error
    # Unknown and absent statuses deliberately remain neutral.
    theme.surface

fn _status_text(node: WidgetNode) -> text:
    val message = node.get_prop("message")
    if message != "":
        return message
    _label_text(node)

fn _scroll_content_height(node: WidgetNode, viewport_h: i32) -> i32:
    var height = 0
    for child in node.children():
        val fixed = _prop_int(child, "height")
        if fixed > 0:
            height = height + fixed
    if height < viewport_h:
        viewport_h
    else:
        height

# Height of one shared-5x7 glyph cell. The charset in
# `common.ui.glyph_bitmap_5x7` is fixed at 7 rows, and every consumer of a v3
# glyph (scene_raster, engine2d, the browser paint path) treats glyph.y as a
# BASELINE and derives the cell top as `y - 7`. Emitting `text_top + 7` here is
# therefore what makes the glyph cell land exactly on the text command's box.
val _WIDGET_GLYPH_CELL_H: i32 = 7

fn _charset_glyph_run(x: i32, y: i32, value: text, advances: [i32]) -> DrawIrGlyphRunPayload:
    """Build a glyph run for text the shaper does NOT handle.

    `resolve_font_metrics_with_language` only fills `glyph_run` when the string
    needs complex-script shaping (font_renderer.spl: `shaping_required:
    complex_script != 0`), so plain Latin text reached DrawIR v3 with
    `glyph_count=0` and every glyph consumer skipped it -- no target rendered
    any text at all. See
    doc/08_tracking/bug/packed_scene_text_runs_carry_zero_glyphs_2026-08-06.md.

    Glyph ids are charset indices into the shared 5x7 font, which is the id
    convention the rest of this pipeline already uses (engine2d/glyph.spl,
    the browser paint primitives, font_rasterizer) -- no second font mapping is
    invented here. `xs` are absolute pen positions accumulated from
    `advances`, matching the absolute coordinates the v2->v3 adapter passes
    through unchanged."""
    var glyph_ids: [u32] = []
    var xs: [i32] = []
    var ys: [i32] = []
    var clusters: [i64] = []
    val baseline = y + _WIDGET_GLYPH_CELL_H
    var pen = x
    var index = 0
    for ch in value:
        if index >= advances.len():
            # Advance table and character count disagree -- refuse rather than
            # emit a run whose glyphs would drift out of position.
            return draw_ir_empty_glyph_run_payload()
        glyph_ids.push(glyph_index_for_char(ch).to_u32())
        xs.push(pen)
        ys.push(baseline)
        clusters.push(index.to_i64())
        pen = pen + advances[index]
        index = index + 1
    if index != advances.len():
        return draw_ir_empty_glyph_run_payload()
    draw_ir_glyph_run_payload(glyph_ids, xs, ys, clusters, true)

fn _shift_glyph_run_y(run: DrawIrGlyphRunPayload, delta: i32) -> DrawIrGlyphRunPayload:
    """Move a glyph run vertically by `delta`.

    Callers that re-position a text command AFTER building it (see
    `_default_text_centered`) must move its glyphs too, otherwise the box moves
    and the text stays behind."""
    if not run.valid or delta == 0:
        return run
    var ys: [i32] = []
    var i = 0
    while i < run.ys.len():
        ys.push(run.ys[i] + delta)
        i = i + 1
    draw_ir_glyph_run_payload(run.glyph_ids, run.xs, ys, run.clusters, true)

fn _default_text(node: WidgetNode, component_id: text, x: i32, y: i32, value: text, color: u32) -> DrawIrCommand:
    val candidate = simpleos_default_font_asset_candidate()
    val language = node.get_prop("lang")
    val normalized_language = language.trim().lower()
    val requested_family = node.get_prop("font-family")
    val family = if requested_family != "": requested_family else if normalized_language != "" and normalized_language != "und": "sans" else: candidate.family
    val metrics = resolve_font_metrics_with_language(family, value, 12, language)
    if not metrics.valid:
        return draw_ir_text(component_id, x, y, value, color)
    if metrics.shaping_required:
        return draw_ir_text_shaped_font(component_id, x, y, value, color, metrics.family, metrics.identity, metrics.advances, metrics.width, metrics.line_height, 12, metrics.glyph_run)
    # Non-shaped (Latin/ASCII) text still needs glyphs: the v3 text-run table
    # carries ONLY glyphs -- it has no string field -- so a run with
    # glyph_count=0 is unrenderable downstream no matter what the consumer does.
    val synthesized = _charset_glyph_run(x, y, value, metrics.advances)
    if synthesized.valid:
        # Attach the run WITHOUT the shaped marker: its ids are charset
        # indices into the shared 5x7 bitmap font, not glyph ids of the
        # selected vector face. Claiming "font-shaping: selected-pure-simple"
        # here sent engine2d's vector-font lowering meaningless ids -- the
        # Vulkan 2D lane rendered "L row 0" as "(AliqA7". The v2->v3 adapter
        # only reads glyph_run.valid, and engine2d correctly takes the
        # resolved (text + real advances) lowering for unmarked commands.
        var command = draw_ir_text_resolved_font(component_id, x, y, value, color, metrics.family, metrics.identity, metrics.advances, metrics.width, metrics.line_height, 12)
        command.glyph_run = synthesized
        return command
    draw_ir_text_resolved_font(component_id, x, y, value, color, metrics.family, metrics.identity, metrics.advances, metrics.width, metrics.line_height, 12)

fn _default_text_centered(node: WidgetNode, component_id: text, x: i32, legacy_y: i32, box_y: i32, box_h: i32, value: text, color: u32) -> DrawIrCommand:
    var command = _default_text(node, component_id, x, legacy_y, value, color)
    if command.height > 0:
        val centered_y = box_y + (box_h - command.height) / 2
        # Move the glyphs with the box. Without this the run keeps the
        # pre-centering baseline and the text renders detached from its widget.
        command.glyph_run = _shift_glyph_run_y(command.glyph_run, centered_y - command.y)
        command.y = centered_y
    command

# =========================================================================
# Per-widget command emission. Coordinates are shifted by (ox, oy) so the
# same helper serves the absolute main batch (ox=oy=0) and a scroll batch
# (ox=scroll.x, oy=scroll.y+offset) whose embedding re-adds the origin.
# =========================================================================

fn _emit_widget(node: WidgetNode, rects: [WidgetRect], rect_index: i64, ox: i32, oy: i32, mut result: [DrawIrCommand], theme: WidgetDrawIrTheme):
    val rect = rects[rect_index]
    if rect.w <= 0 or rect.h <= 0:
        return
    val x = rect.x - ox
    val y = rect.y - oy
    val kind = node.kind_name()
    val mid_y = y + rect.h / 2

    if kind == "button":
        result.push(draw_ir_rect(rect.id, x, y, rect.w, rect.h, _button_color(node, theme)))
        val lbl = _label_text(node)
        if lbl != "":
            result.push(_default_text_centered(node, "{rect.id}-label", x + 6, mid_y, y, rect.h, lbl, theme.text_primary))
    elif kind == "checkbox":
        val box = 18
        val box_y = y + (rect.h - box) / 2
        result.push(draw_ir_rect("{rect.id}-box", x, box_y, box, box, theme.border))
        val inner_color = if node.get_prop("checked") == "true": theme.accent else: theme.field
        result.push(draw_ir_rect("{rect.id}-mark", x + 2, box_y + 2, box - 4, box - 4, inner_color))
        val lbl = _label_text(node)
        if lbl != "":
            result.push(_default_text_centered(node, "{rect.id}-label", x + box + 6, mid_y, y, rect.h, lbl, theme.text_primary))
    elif kind == "input" or kind == "textfield":
        result.push(draw_ir_rect(rect.id, x, y, rect.w, rect.h, theme.border))
        result.push(draw_ir_rect("{rect.id}-field", x + 2, y + 2, rect.w - 4, rect.h - 4, theme.field))
        val value = node.get_prop("value")
        if value != "":
            result.push(_default_text_centered(node, "{rect.id}-value", x + 5, mid_y, y, rect.h, value, theme.text_primary))
        else:
            # Empty field: show the placeholder so the widget's purpose is
            # visible before first input (previously nothing was emitted and
            # the field read as a bare box).
            val placeholder = node.get_prop("placeholder")
            if placeholder != "":
                result.push(_default_text_centered(node, "{rect.id}-placeholder", x + 5, mid_y, y, rect.h, placeholder, theme.text_secondary))
        if node.get_prop("ui_focus") == "true":
            val caret = _prop_int(node, "caret")
            val prefix = if caret > 0 and caret < value.len(): value.slice(0, caret) elif caret >= value.len(): value else: ""
            val prefix_command = _default_text(node, "{rect.id}-caret-metrics", 0, 0, prefix, theme.text_primary)
            val caret_x = x + 5 + (if prefix_command.computed_style.len() > 0: prefix_command.width else: caret * GLYPH_ADVANCE)
            result.push(draw_ir_rect("{rect.id}-caret", caret_x, y + 3, 2, rect.h - 6, theme.accent))
    elif kind == "progress":
        result.push(draw_ir_rect("{rect.id}-track", x, y, rect.w, rect.h, theme.track))
        var value = _prop_int(node, "value")
        if value < 0:
            value = 0
        if value > 100:
            value = 100
        val fill_w = rect.w * value / 100
        if fill_w > 0:
            result.push(draw_ir_rect("{rect.id}-fill", x, y, fill_w, rect.h, theme.accent))
    elif kind == "image":
        result.push(draw_ir_rect("{rect.id}-bg", x, y, rect.w, rect.h, theme.placeholder))
        val src = node.get_prop("src")
        if src != "":
            result.push(draw_ir_image_command(rect.id, x, y, rect.w, rect.h, src, []))
    elif kind == "text" or kind == "label" or kind == "heading":
        val lbl = _label_text(node)
        if lbl != "":
            result.push(_default_text_centered(node, rect.id, x + 2, mid_y, y, rect.h, lbl, theme.text_primary))
    elif kind == "status_chip" or kind == "toast":
        result.push(draw_ir_rect(rect.id, x, y, rect.w, rect.h, _status_color(node, theme)))
        val text = _status_text(node)
        if text != "":
            result.push(_default_text_centered(node, "{rect.id}-label", x + 6, mid_y, y, rect.h, text, theme.text_primary))
    elif kind == "scroll":
        result.push(draw_ir_rect("{rect.id}-track", x, y, rect.w, rect.h, theme.track))
        val bar_w = if rect.w >= 12: 8 else: rect.w
        val content_h = _scroll_content_height(node, rect.h)
        val max_scroll = content_h - rect.h
        var thumb_h = rect.h * rect.h / content_h
        if thumb_h < 12:
            thumb_h = 12
        if thumb_h > rect.h:
            thumb_h = rect.h
        val thumb_y = if max_scroll > 0:
            y + _prop_int(node, "scroll_offset") *
                (rect.h - thumb_h) / max_scroll
        else:
            y
        result.push(draw_ir_rect(
            "{rect.id}-scrollbar-track",
            x + rect.w - bar_w, y, bar_w, rect.h, theme.border
        ))
        result.push(draw_ir_rect(
            "{rect.id}-scrollbar-thumb",
            x + rect.w - bar_w, thumb_y, bar_w, thumb_h, theme.accent
        ))
    elif kind == "menubar":
        # Explicit bar fill; item text is emitted by the walk (children are
        # `text` widgets, spread horizontally by the builder's hbox layout).
        result.push(draw_ir_rect(rect.id, x, y, rect.w, rect.h, theme.track))
    elif kind == "statusbar":
        # The statusbar stores its text in `left`/`right` props, not `label`,
        # so the generic walk never drew it: the bar rendered as an empty
        # strip. Emit both sections here; the right section is right-aligned
        # using the measured text width (same probe pattern as the caret).
        result.push(draw_ir_rect(rect.id, x, y, rect.w, rect.h, theme.track))
        val left_text = node.get_prop("left")
        if left_text != "":
            result.push(_default_text_centered(node, "{rect.id}-left", x + 6, mid_y, y, rect.h, left_text, theme.text_primary))
        val right_text = node.get_prop("right")
        if right_text != "":
            val probe = _default_text(node, "{rect.id}-right-metrics", 0, 0, right_text, theme.text_primary)
            val right_w = if probe.computed_style.len() > 0: probe.width else: right_text.len() * GLYPH_ADVANCE
            result.push(_default_text_centered(node, "{rect.id}-right", x + rect.w - right_w - 6, mid_y, y, rect.h, right_text, theme.text_primary))
    elif kind == "switch":
        # Track + thumb. ON = accent track with the thumb parked right.
        val track_w = 36
        val track_h = 20
        val track_y = y + (rect.h - track_h) / 2
        val is_on = node.get_prop("checked") == "true"
        result.push(draw_ir_rect(rect.id, x, track_y, track_w, track_h, if is_on: theme.accent else: theme.track))
        val thumb = 16
        val thumb_x = if is_on: x + track_w - thumb - 2 else: x + 2
        result.push(draw_ir_rect("{rect.id}-thumb", thumb_x, track_y + 2, thumb, thumb, theme.text_primary))
    elif kind == "radio":
        val box = 18
        val box_y = y + (rect.h - box) / 2
        result.push(draw_ir_rect("{rect.id}-ring", x, box_y, box, box, theme.border))
        if node.get_prop("checked") == "true":
            result.push(draw_ir_rect("{rect.id}-dot", x + 4, box_y + 4, box - 8, box - 8, theme.accent))
        val lbl = _label_text(node)
        if lbl != "":
            result.push(_default_text_centered(node, "{rect.id}-label", x + box + 6, mid_y, y, rect.h, lbl, theme.text_primary))
    elif kind == "dropdown":
        # Closed control: field box, current value (value prop, else first
        # item), and a "v" affordance at the right edge.
        result.push(draw_ir_rect(rect.id, x, y, rect.w, rect.h, theme.border))
        result.push(draw_ir_rect("{rect.id}-field", x + 1, y + 1, rect.w - 2, rect.h - 2, theme.field))
        var current = node.get_prop("value")
        if current == "":
            val items = node.children()
            if items.len() > 0:
                current = items[0].get_prop("label")
        if current != "":
            result.push(_default_text_centered(node, "{rect.id}-value", x + 6, mid_y, y, rect.h, current, theme.text_primary))
        result.push(_default_text_centered(node, "{rect.id}-chevron", x + rect.w - 16, mid_y, y, rect.h, "v", theme.text_secondary))
    elif kind == "tabs":
        # Bar fill; the selected tab (prop "selected", default first) gets an
        # accent underline. Children text is emitted by the walk.
        result.push(draw_ir_rect(rect.id, x, y, rect.w, rect.h, theme.track))
        val sel = _prop_int(node, "selected")
        val kids = node.children()
        if kids.len() > 0:
            var sel_idx = if sel < kids.len(): sel else: 0
            val sel_rect_idx = find_rect_index(rects, kids[sel_idx].id)
            if sel_rect_idx >= 0:
                val sr = rects[sel_rect_idx]
                result.push(draw_ir_rect("{rect.id}-sel", sr.x, y + rect.h - 3, sr.w, 3, theme.accent))
    elif kind == "segmented_control":
        # Selected segment (prop "selected") gets the accent fill; children
        # text is emitted by the walk.
        val seg_sel = _prop_int(node, "selected")
        val seg_kids = node.children()
        var seg_i = 0
        while seg_i < seg_kids.len():
            val child_rect_idx = find_rect_index(rects, seg_kids[seg_i].id)
            if child_rect_idx >= 0:
                val cr = rects[child_rect_idx]
                result.push(draw_ir_rect("{rect.id}-seg{seg_i}", cr.x, cr.y, cr.w, cr.h, if seg_i == seg_sel: theme.accent else: theme.track))
            seg_i = seg_i + 1
    elif kind == "list":
        # Row banding under the item text the walk emits.
        val list_kids = node.children()
        var band_i = 0
        while band_i < list_kids.len():
            val band_rect_idx = find_rect_index(rects, list_kids[band_i].id)
            if band_rect_idx >= 0:
                val br = rects[band_rect_idx]
                if band_i % 2 == 0:
                    result.push(draw_ir_rect("{rect.id}-band{band_i}", x, br.y, rect.w, br.h, theme.track))
            band_i = band_i + 1
    elif kind == "table":
        # Header band with the "H1|H2" prop text; data rows are text children
        # emitted by the walk.
        result.push(draw_ir_rect(rect.id, x, y, rect.w, rect.h, theme.surface))
        val headers = node.get_prop("headers")
        if headers != "":
            val first_row = if node.children().len() > 0:
                val fr_idx = find_rect_index(rects, node.children()[0].id)
                if fr_idx >= 0: rects[fr_idx].y - y else: 20
            else:
                20
            result.push(draw_ir_rect("{rect.id}-header", x, y, rect.w, first_row, theme.track))
            result.push(_default_text_centered(node, "{rect.id}-header-text", x + 4, y + first_row / 2, y, first_row, headers, theme.text_primary))
    elif kind == "tree" or kind == "treenode":
        # Expansion marker + label text, top-anchored so nested children
        # (laid out over the node's remaining area) do not overlap the label.
        val label_text = _label_text(node)
        if label_text != "":
            result.push(_default_text(node, "{rect.id}-mark", x + 2, y + 2, ">", theme.text_secondary))
            result.push(_default_text(node, rect.id, x + 14, y + 2, label_text, theme.text_primary))
    elif kind == "divider":
        val line_y = y + rect.h / 2
        result.push(draw_ir_rect(rect.id, x, line_y, rect.w, 1, theme.border))
    else:
        # container / panel / unknown -> background surface
        result.push(draw_ir_rect(rect.id, x, y, rect.w, rect.h, theme.surface))

# =========================================================================
# Main-batch walk (absolute coords). Scroll subtrees are handled separately,
# so the walk draws the scroll frame but does not recurse into it.
# =========================================================================

fn _walk_main(node: WidgetNode, rects: [WidgetRect], mut result: [DrawIrCommand], theme: WidgetDrawIrTheme):
    if not node.is_visible():
        return
    val rect_index = find_rect_index(rects, node.id)
    if rect_index < 0:
        return
    _emit_widget(node, rects, rect_index, 0, 0, result, theme)
    if node.kind_name() == "scroll":
        return
    if node.kind_name() == "dropdown":
        # A closed dropdown's items are its option list, not visible content:
        # the emitter draws the current value, and the items only belong on
        # screen while the popup is open (not modeled here yet).
        return
    for child in node.children():
        _walk_main(child, rects, result, theme)

# =========================================================================
# Scroll batches: each scroll node becomes a clipped batch whose descendants
# are offset by the scroll amount. ponytail: nested scroll-in-scroll not
# supported (descendants are attributed to the outer scroll); add a
# depth-aware split if a real app needs it.
# =========================================================================

fn _walk_scroll_children(node: WidgetNode, rects: [WidgetRect], ox: i32, oy: i32, mut result: [DrawIrCommand], theme: WidgetDrawIrTheme):
    if not node.is_visible():
        return
    val rect_index = find_rect_index(rects, node.id)
    if rect_index >= 0:
        _emit_widget(node, rects, rect_index, ox, oy, result, theme)
    for child in node.children():
        _walk_scroll_children(child, rects, ox, oy, result, theme)

fn _build_scroll_batch(scroll_node: WidgetNode, rects: [WidgetRect], rect_index: i64, backend: text, theme: WidgetDrawIrTheme) -> DrawIrBatch:
    val srect = rects[rect_index]
    val offset = _prop_int(scroll_node, "scroll_offset")
    var cmds: [DrawIrCommand] = []
    for child in scroll_node.children():
        _walk_scroll_children(child, rects, srect.x, srect.y + offset, cmds, theme)
    val embedding = draw_ir_embedding_config("scroll-{scroll_node.id}", scroll_node.id, srect.x, srect.y, srect.w, srect.h, 5, 1000, true)
    val source = draw_ir_source_gui_ast(scroll_node.id, "widget-scroll", "1")
    draw_ir_batch_with_source("scroll-{scroll_node.id}", backend, embedding, cmds, source)

fn _collect_scroll_batches(node: WidgetNode, rects: [WidgetRect], backend: text, mut result: [DrawIrBatch], theme: WidgetDrawIrTheme):
    if not node.is_visible():
        return
    if node.kind_name() == "scroll":
        val rect_index = find_rect_index(rects, node.id)
        if rect_index >= 0:
            result.push(_build_scroll_batch(
                node, rects, rect_index, backend, theme
            ))
    for child in node.children():
        _collect_scroll_batches(child, rects, backend, result, theme)

# =========================================================================
# Root surface projection
# =========================================================================

# The scalar walker deliberately remains unchanged.  Only its root panel is
# upgraded to the package material; nested controls and scroll content keep
# their historic simple RECT semantics and never sample a backdrop themselves.
fn _widget_draw_ir_root_is_surface(root: WidgetNode) -> bool:
    val kind = root.kind_name()
    not (kind == "button" or kind == "checkbox" or
        kind == "input" or kind == "textfield" or
        kind == "progress" or kind == "image" or
        kind == "text" or kind == "label" or kind == "heading" or
        kind == "status_chip" or kind == "toast" or kind == "scroll")

fn _widget_draw_ir_root_surface_commands(root: WidgetNode, width: i32, height: i32, backend: text, snapshot: ThemeRenderSnapshot, commands: [DrawIrCommand]) -> [DrawIrCommand]:
    var out: [DrawIrCommand] = [draw_ir_rect(
        "{root.id}-surface-initializer", 0, 0, width, height,
        theme_draw_ir_surface_initializer_color(snapshot)
    )]
    var replaced = false
    val root_is_surface = _widget_draw_ir_root_is_surface(root)
    val raw_border = snapshot.material.border_width_px
    for command in commands:
        if (root_is_surface and not replaced and
            command.component_id == root.id):
            val max_inset = if command.width < command.height:
                command.width / 2
            else:
                command.height / 2
            val inset = if raw_border < 0: 0 elif raw_border > max_inset:
                max_inset
            else:
                raw_border
            val content_width = command.width - inset * 2
            val content_height = command.height - inset * 2
            out.push(draw_ir_box_with_style(
                root.id, command.x, command.y, command.width, command.height,
                theme_draw_ir_surface_command_color(
                    snapshot, true, "body", backend
                ),
                draw_ir_rect_bounds(
                    command.x, command.y, command.width, command.height
                ),
                draw_ir_rect_bounds(
                    command.x + inset, command.y + inset,
                    content_width, content_height
                ),
                draw_ir_no_rect(), draw_ir_no_rect(),
                theme_draw_ir_surface_style(snapshot, true, "body", backend)
            ))
            replaced = true
        else:
            out.push(command)
    out

# =========================================================================
# Public API
# =========================================================================

fn widget_tree_to_draw_ir_with_theme(root: WidgetNode, w: i32, h: i32, backend: text, snapshot: ThemeRenderSnapshot) -> DrawIrComposition:
    """Lay out `root` at (w, h) and project it to a Draw-IR composition.

    Batch 0 is the whole tree in absolute coordinates (unclipped). Each scroll
    area contributes an additional clipped batch whose content is shifted by
    its `scroll_offset`. The result renders through
    `engine2d_draw_ir_adv_composition[_with_images]`.
    """
    val theme = widget_draw_ir_theme_from_snapshot(snapshot)
    val rects = compute_layout(root, 0, 0, w, h)
    var main_cmds: [DrawIrCommand] = []
    _walk_main(root, rects, main_cmds, theme)
    main_cmds = _widget_draw_ir_root_surface_commands(
        root, w, h, backend, snapshot, main_cmds
    )
    val embedding = draw_ir_embedding_config("widget-root", root.id, 0, 0, w, h, 0, 1000, false)
    val source = draw_ir_source_gui_ast(root.id, "widget-tree", "1")
    val main_batch = draw_ir_batch_with_source("widget-main", backend, embedding, main_cmds, source)
    var batches: [DrawIrBatch] = [main_batch]
    _collect_scroll_batches(root, rects, backend, batches, theme)
    draw_ir_composition("widget-composition", "widget:{w}x{h}", backend, batches)

fn widget_tree_to_draw_ir(root: WidgetNode, w: i32, h: i32, backend: text) -> DrawIrComposition:
    val theme = _widget_draw_ir_theme_for_root(root)
    val rects = compute_layout(root, 0, 0, w, h)
    var main_cmds: [DrawIrCommand] = []
    _walk_main(root, rects, main_cmds, theme)
    val embedding = draw_ir_embedding_config("widget-root", root.id, 0, 0, w, h, 0, 1000, false)
    val source = draw_ir_source_gui_ast(root.id, "widget-tree", "1")
    val main_batch = draw_ir_batch_with_source("widget-main", backend, embedding, main_cmds, source)
    var batches: [DrawIrBatch] = [main_batch]
    _collect_scroll_batches(root, rects, backend, batches, theme)
    draw_ir_composition("widget-composition", "widget:{w}x{h}", backend, batches)

fn widget_tree_to_draw_ir_cpu(root: WidgetNode, w: i32, h: i32) -> DrawIrComposition:
    widget_tree_to_draw_ir(root, w, h, DRAW_IR_BACKEND_CPU)

export WidgetDrawIrTheme, widget_draw_ir_theme_from_snapshot
export widget_tree_to_draw_ir, widget_tree_to_draw_ir_with_theme, widget_tree_to_draw_ir_cpu
