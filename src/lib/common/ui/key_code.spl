# Canonical key-code vocabulary — the code space `HostInputEvent.Key.code` holds.
#
# WHY THIS FILE EXISTS
# --------------------
# Four input producers feed one `Key(code)` field from four different raw code
# spaces:
#
#   * PS/2 set-1 scancodes      -- src/os/drivers/input/ps2_keyboard.spl:58
#   * evdev KEY_* codes         -- src/os/drivers/virtio/virtio_input_ops.spl:52
#   * SDL2 keysyms (SDLK_*)     -- src/lib/nogc_sync_mut/io/window_sffi.spl:589
#   * winit virtual keycodes    -- src/os/compositor/hosted_input_backend.spl:71
#
# If the same physical keypress arrives as a different integer depending on
# which host is driving the screen, the "showcase logic is byte-identical
# across 2d/web/gui/wm, only the HAL differs" claim is false. This module owns
# the one code space and the raw -> canonical tables for every producer.
#
# WHAT WAS ADOPTED (ratification, not invention)
# ----------------------------------------------
# The canonical space is the **Windows virtual-key / W3C `KeyboardEvent.keyCode`
# space**. It was already latent in the repo and is simply ratified here:
#
#   * common/ui/host_input_event.spl:110-140 (`host_key_name`) already decodes
#     8/9/13/27/32/35..40/46 -- exactly VK.
#   * os/drivers/input/input_event.spl:46-53 (`is_modifier_key`) already treats
#     16/17/18/91 as the modifier codes -- exactly VK.
#   * os/compositor/hosted_input_backend.spl:77-123 already CONSUMES VK
#     integers from winit.
#
# The symbolic `Key` enum (ps2_keyboard.spl:42) stays exactly where it is and
# remains the symbolic vocabulary shared by the drivers. This module is
# deliberately integer-only: importing an `os.drivers.*` enum into
# `src/lib/common/ui/` would invert the layering, and every mapping needed here
# is raw-int -> canonical-int.
#
# CONVENTIONS
# -----------
# * Left/right modifier pairs collapse to ONE canonical code (CANON_SHIFT /
#   CANON_CTRL / CANON_ALT), matching the two existing sites above. Which side
#   was pressed belongs in `HostInputEvent.mods`, not in `code`.
# * Letters are UPPERCASE-ASCII (A=65) and digits are ASCII (0=48) regardless of
#   shift state; the shifted glyph belongs in `HostInputEvent.ch`.
# * Unmapped input returns CANON_UNKNOWN (0), never a guess.
# * Constants are `CANON_*`, not `KEY_*`, so they cannot collide with the evdev
#   `val KEY_A: u16 = 30` block in virtio_input_ops.spl.
#
# All tables are if/elif chains of `==`: a bare identifier in a `case` pattern
# is a capture binding rather than a value comparison in this toolchain (see the
# note at virtio_input_ops.spl:139), so `match` would silently fall through.

# ============================================================================
# Canonical codes (Windows VK / W3C keyCode)
# ============================================================================

val CANON_UNKNOWN: i64 = 0

val CANON_BACKSPACE: i64 = 8
val CANON_TAB: i64 = 9
val CANON_ENTER: i64 = 13
val CANON_SHIFT: i64 = 16
val CANON_CTRL: i64 = 17
val CANON_ALT: i64 = 18
val CANON_CAPSLOCK: i64 = 20
val CANON_ESCAPE: i64 = 27
val CANON_SPACE: i64 = 32
val CANON_PAGEUP: i64 = 33
val CANON_PAGEDOWN: i64 = 34
val CANON_END: i64 = 35
val CANON_HOME: i64 = 36
val CANON_LEFT: i64 = 37
val CANON_UP: i64 = 38
val CANON_RIGHT: i64 = 39
val CANON_DOWN: i64 = 40
val CANON_INSERT: i64 = 45
val CANON_DELETE: i64 = 46

val CANON_0: i64 = 48
val CANON_1: i64 = 49
val CANON_2: i64 = 50
val CANON_3: i64 = 51
val CANON_4: i64 = 52
val CANON_5: i64 = 53
val CANON_6: i64 = 54
val CANON_7: i64 = 55
val CANON_8: i64 = 56
val CANON_9: i64 = 57

val CANON_A: i64 = 65
val CANON_B: i64 = 66
val CANON_C: i64 = 67
val CANON_D: i64 = 68
val CANON_E: i64 = 69
val CANON_F: i64 = 70
val CANON_G: i64 = 71
val CANON_H: i64 = 72
val CANON_I: i64 = 73
val CANON_J: i64 = 74
val CANON_K: i64 = 75
val CANON_L: i64 = 76
val CANON_M: i64 = 77
val CANON_N: i64 = 78
val CANON_O: i64 = 79
val CANON_P: i64 = 80
val CANON_Q: i64 = 81
val CANON_R: i64 = 82
val CANON_S: i64 = 83
val CANON_T: i64 = 84
val CANON_U: i64 = 85
val CANON_V: i64 = 86
val CANON_W: i64 = 87
val CANON_X: i64 = 88
val CANON_Y: i64 = 89
val CANON_Z: i64 = 90

val CANON_META: i64 = 91

val CANON_F1: i64 = 112
val CANON_F2: i64 = 113
val CANON_F3: i64 = 114
val CANON_F4: i64 = 115
val CANON_F5: i64 = 116
val CANON_F6: i64 = 117
val CANON_F7: i64 = 118
val CANON_F8: i64 = 119
val CANON_F9: i64 = 120
val CANON_F10: i64 = 121
val CANON_F11: i64 = 122
val CANON_F12: i64 = 123

val CANON_SEMICOLON: i64 = 186
val CANON_EQUALS: i64 = 187
val CANON_COMMA: i64 = 188
val CANON_MINUS: i64 = 189
val CANON_PERIOD: i64 = 190
val CANON_SLASH: i64 = 191
val CANON_BACKTICK: i64 = 192
val CANON_LEFT_BRACKET: i64 = 219
val CANON_BACKSLASH: i64 = 220
val CANON_RIGHT_BRACKET: i64 = 221
val CANON_QUOTE: i64 = 222

# ============================================================================
# PS/2 scancode set 1 -> canonical
# ============================================================================
#
# Extended (E0-prefixed) keys are passed as the COMBINED 16-bit value:
# `0xE000 | second_byte`, e.g. Left arrow = 0xE04B. A single-byte signature
# could not express arrows / Home / End / Insert / Delete at all, all of which
# are E0-prefixed on set 1. Break codes (bit 0x80 on the final byte) must be
# stripped by the caller; press/release lives in `HostInputEvent.down`.

fn ps2_set1_to_canon(code: i64) -> i64:
    """Map a PS/2 scancode-set-1 make code to a canonical key code.

    Extended keys use `0xE000 | byte` (Left = 0xE04B). Returns CANON_UNKNOWN
    for anything unmapped."""
    # --- Extended (E0-prefixed) block ---------------------------------------
    if code == 0xE01C: return CANON_ENTER          # keypad Enter
    if code == 0xE01D: return CANON_CTRL           # right ctrl
    if code == 0xE038: return CANON_ALT            # right alt
    if code == 0xE047: return CANON_HOME
    if code == 0xE048: return CANON_UP
    if code == 0xE049: return CANON_PAGEUP
    if code == 0xE04B: return CANON_LEFT
    if code == 0xE04D: return CANON_RIGHT
    if code == 0xE04F: return CANON_END
    if code == 0xE050: return CANON_DOWN
    if code == 0xE051: return CANON_PAGEDOWN
    if code == 0xE052: return CANON_INSERT
    if code == 0xE053: return CANON_DELETE
    if code == 0xE05B: return CANON_META
    if code == 0xE05C: return CANON_META

    # --- Base block ---------------------------------------------------------
    if code == 0x01: return CANON_ESCAPE
    if code == 0x02: return CANON_1
    if code == 0x03: return CANON_2
    if code == 0x04: return CANON_3
    if code == 0x05: return CANON_4
    if code == 0x06: return CANON_5
    if code == 0x07: return CANON_6
    if code == 0x08: return CANON_7
    if code == 0x09: return CANON_8
    if code == 0x0A: return CANON_9
    if code == 0x0B: return CANON_0
    if code == 0x0C: return CANON_MINUS
    if code == 0x0D: return CANON_EQUALS
    if code == 0x0E: return CANON_BACKSPACE
    if code == 0x0F: return CANON_TAB
    if code == 0x10: return CANON_Q
    if code == 0x11: return CANON_W
    if code == 0x12: return CANON_E
    if code == 0x13: return CANON_R
    if code == 0x14: return CANON_T
    if code == 0x15: return CANON_Y
    if code == 0x16: return CANON_U
    if code == 0x17: return CANON_I
    if code == 0x18: return CANON_O
    if code == 0x19: return CANON_P
    if code == 0x1A: return CANON_LEFT_BRACKET
    if code == 0x1B: return CANON_RIGHT_BRACKET
    if code == 0x1C: return CANON_ENTER
    if code == 0x1D: return CANON_CTRL
    if code == 0x1E: return CANON_A
    if code == 0x1F: return CANON_S
    if code == 0x20: return CANON_D
    if code == 0x21: return CANON_F
    if code == 0x22: return CANON_G
    if code == 0x23: return CANON_H
    if code == 0x24: return CANON_J
    if code == 0x25: return CANON_K
    if code == 0x26: return CANON_L
    if code == 0x27: return CANON_SEMICOLON
    if code == 0x28: return CANON_QUOTE
    if code == 0x29: return CANON_BACKTICK
    if code == 0x2A: return CANON_SHIFT
    if code == 0x2B: return CANON_BACKSLASH
    if code == 0x2C: return CANON_Z
    if code == 0x2D: return CANON_X
    if code == 0x2E: return CANON_C
    if code == 0x2F: return CANON_V
    if code == 0x30: return CANON_B
    if code == 0x31: return CANON_N
    if code == 0x32: return CANON_M
    if code == 0x33: return CANON_COMMA
    if code == 0x34: return CANON_PERIOD
    if code == 0x35: return CANON_SLASH
    if code == 0x36: return CANON_SHIFT
    if code == 0x38: return CANON_ALT
    if code == 0x39: return CANON_SPACE
    if code == 0x3A: return CANON_CAPSLOCK
    if code == 0x3B: return CANON_F1
    if code == 0x3C: return CANON_F2
    if code == 0x3D: return CANON_F3
    if code == 0x3E: return CANON_F4
    if code == 0x3F: return CANON_F5
    if code == 0x40: return CANON_F6
    if code == 0x41: return CANON_F7
    if code == 0x42: return CANON_F8
    if code == 0x43: return CANON_F9
    if code == 0x44: return CANON_F10
    if code == 0x57: return CANON_F11
    if code == 0x58: return CANON_F12
    CANON_UNKNOWN

# ============================================================================
# evdev KEY_* (Linux input-event-codes.h) -> canonical
# ============================================================================
#
# evdev and PS/2 set-1 coincide over 0x01..0x39 and then diverge -- F11/F12 and
# the whole navigation cluster are at different numbers. Deliberately written
# as its own table with no shared helper, so a future edit to one cannot
# silently move the other. Numbers taken from virtio_input_ops.spl:52-131.

fn evdev_to_canon(code: i64) -> i64:
    """Map a Linux evdev KEY_* code to a canonical key code."""
    if code == 1: return CANON_ESCAPE
    if code == 2: return CANON_1
    if code == 3: return CANON_2
    if code == 4: return CANON_3
    if code == 5: return CANON_4
    if code == 6: return CANON_5
    if code == 7: return CANON_6
    if code == 8: return CANON_7
    if code == 9: return CANON_8
    if code == 10: return CANON_9
    if code == 11: return CANON_0
    if code == 12: return CANON_MINUS
    if code == 13: return CANON_EQUALS
    if code == 14: return CANON_BACKSPACE
    if code == 15: return CANON_TAB
    if code == 16: return CANON_Q
    if code == 17: return CANON_W
    if code == 18: return CANON_E
    if code == 19: return CANON_R
    if code == 20: return CANON_T
    if code == 21: return CANON_Y
    if code == 22: return CANON_U
    if code == 23: return CANON_I
    if code == 24: return CANON_O
    if code == 25: return CANON_P
    if code == 26: return CANON_LEFT_BRACKET
    if code == 27: return CANON_RIGHT_BRACKET
    if code == 28: return CANON_ENTER
    if code == 29: return CANON_CTRL
    if code == 30: return CANON_A
    if code == 31: return CANON_S
    if code == 32: return CANON_D
    if code == 33: return CANON_F
    if code == 34: return CANON_G
    if code == 35: return CANON_H
    if code == 36: return CANON_J
    if code == 37: return CANON_K
    if code == 38: return CANON_L
    if code == 39: return CANON_SEMICOLON
    if code == 40: return CANON_QUOTE
    if code == 41: return CANON_BACKTICK
    if code == 42: return CANON_SHIFT
    if code == 43: return CANON_BACKSLASH
    if code == 44: return CANON_Z
    if code == 45: return CANON_X
    if code == 46: return CANON_C
    if code == 47: return CANON_V
    if code == 48: return CANON_B
    if code == 49: return CANON_N
    if code == 50: return CANON_M
    if code == 51: return CANON_COMMA
    if code == 52: return CANON_PERIOD
    if code == 53: return CANON_SLASH
    if code == 54: return CANON_SHIFT
    if code == 56: return CANON_ALT
    if code == 57: return CANON_SPACE
    if code == 58: return CANON_CAPSLOCK
    if code == 59: return CANON_F1
    if code == 60: return CANON_F2
    if code == 61: return CANON_F3
    if code == 62: return CANON_F4
    if code == 63: return CANON_F5
    if code == 64: return CANON_F6
    if code == 65: return CANON_F7
    if code == 66: return CANON_F8
    if code == 67: return CANON_F9
    if code == 68: return CANON_F10
    if code == 87: return CANON_F11
    if code == 88: return CANON_F12
    if code == 96: return CANON_ENTER          # KEY_KPENTER
    if code == 97: return CANON_CTRL           # KEY_RIGHTCTRL
    if code == 100: return CANON_ALT           # KEY_RIGHTALT
    if code == 102: return CANON_HOME
    if code == 103: return CANON_UP
    if code == 104: return CANON_PAGEUP
    if code == 105: return CANON_LEFT
    if code == 106: return CANON_RIGHT
    if code == 107: return CANON_END
    if code == 108: return CANON_DOWN
    if code == 109: return CANON_PAGEDOWN
    if code == 110: return CANON_INSERT
    if code == 111: return CANON_DELETE
    if code == 125: return CANON_META          # KEY_LEFTMETA
    if code == 126: return CANON_META          # KEY_RIGHTMETA
    CANON_UNKNOWN

# ============================================================================
# SDL2 keysym (SDLK_*) -> canonical
# ============================================================================
#
# SDLK is ASCII for the printable range (letters are LOWERCASE, hence the -32)
# and 0x40000000-based for everything else. Note the arrow block is numerically
# out of order versus canonical: SDLK RIGHT=1073741903 < LEFT=904 < DOWN=905 <
# UP=906, whereas canonical is LEFT=37 < UP=38 < RIGHT=39 < DOWN=40. Transposing
# these is the single most likely error in this file; the spec pins all four.

fn sdl_keysym_to_canon(code: i64) -> i64:
    """Map an SDL2 keysym (SDLK_*) to a canonical key code."""
    # Lowercase ASCII letters -> uppercase canonical.
    if code >= 97 and code <= 122: return code - 32
    # ASCII digits are already canonical.
    if code >= 48 and code <= 57: return code

    if code == 8: return CANON_BACKSPACE
    if code == 9: return CANON_TAB
    if code == 13: return CANON_ENTER
    if code == 27: return CANON_ESCAPE
    if code == 32: return CANON_SPACE
    if code == 127: return CANON_DELETE        # SDLK_DELETE

    if code == 39: return CANON_QUOTE
    if code == 44: return CANON_COMMA
    if code == 45: return CANON_MINUS
    if code == 46: return CANON_PERIOD
    if code == 47: return CANON_SLASH
    if code == 59: return CANON_SEMICOLON
    if code == 61: return CANON_EQUALS
    if code == 91: return CANON_LEFT_BRACKET
    if code == 92: return CANON_BACKSLASH
    if code == 93: return CANON_RIGHT_BRACKET
    if code == 96: return CANON_BACKTICK

    if code == 1073741881: return CANON_CAPSLOCK
    if code == 1073741882: return CANON_F1
    if code == 1073741883: return CANON_F2
    if code == 1073741884: return CANON_F3
    if code == 1073741885: return CANON_F4
    if code == 1073741886: return CANON_F5
    if code == 1073741887: return CANON_F6
    if code == 1073741888: return CANON_F7
    if code == 1073741889: return CANON_F8
    if code == 1073741890: return CANON_F9
    if code == 1073741891: return CANON_F10
    if code == 1073741892: return CANON_F11
    if code == 1073741893: return CANON_F12

    if code == 1073741897: return CANON_INSERT
    if code == 1073741898: return CANON_HOME
    if code == 1073741899: return CANON_PAGEUP
    if code == 1073741901: return CANON_END
    if code == 1073741902: return CANON_PAGEDOWN
    if code == 1073741903: return CANON_RIGHT
    if code == 1073741904: return CANON_LEFT
    if code == 1073741905: return CANON_DOWN
    if code == 1073741906: return CANON_UP
    if code == 1073741912: return CANON_ENTER  # SDLK_KP_ENTER

    if code == 1073742048: return CANON_CTRL   # SDLK_LCTRL
    if code == 1073742049: return CANON_SHIFT  # SDLK_LSHIFT
    if code == 1073742050: return CANON_ALT    # SDLK_LALT
    if code == 1073742051: return CANON_META   # SDLK_LGUI
    if code == 1073742052: return CANON_CTRL   # SDLK_RCTRL
    if code == 1073742053: return CANON_SHIFT  # SDLK_RSHIFT
    if code == 1073742054: return CANON_ALT    # SDLK_RALT
    if code == 1073742055: return CANON_META   # SDLK_RGUI
    CANON_UNKNOWN

# ============================================================================
# winit virtual keycode -> canonical
# ============================================================================
#
# hosted_input_backend.spl:71-123 already decodes winit keycodes as VK integers
# (Escape 27, Enter 13, arrows 37..40, F1..F12 112..123, A..Z 65..90), so this
# producer is ALREADY in the canonical space. This function is therefore a
# validating identity: it exists so the spec can prove the winit lane agrees
# with the other three rather than assuming it, and so an unrecognised code is
# reported as CANON_UNKNOWN instead of passing through as a bogus code.

fn winit_keycode_to_canon(code: i64) -> i64:
    """Validate a winit virtual keycode as a canonical key code."""
    if code >= 65 and code <= 90: return code       # A..Z
    if code >= 48 and code <= 57: return code       # 0..9
    if code >= 112 and code <= 123: return code     # F1..F12
    if code == CANON_BACKSPACE: return code
    if code == CANON_TAB: return code
    if code == CANON_ENTER: return code
    if code == CANON_SHIFT: return code
    if code == CANON_CTRL: return code
    if code == CANON_ALT: return code
    if code == CANON_CAPSLOCK: return code
    if code == CANON_ESCAPE: return code
    if code == CANON_SPACE: return code
    if code == CANON_PAGEUP: return code
    if code == CANON_PAGEDOWN: return code
    if code == CANON_END: return code
    if code == CANON_HOME: return code
    if code == CANON_LEFT: return code
    if code == CANON_UP: return code
    if code == CANON_RIGHT: return code
    if code == CANON_DOWN: return code
    if code == CANON_INSERT: return code
    if code == CANON_DELETE: return code
    if code == CANON_META: return code
    if code == CANON_SEMICOLON: return code
    if code == CANON_EQUALS: return code
    if code == CANON_COMMA: return code
    if code == CANON_MINUS: return code
    if code == CANON_PERIOD: return code
    if code == CANON_SLASH: return code
    if code == CANON_BACKTICK: return code
    if code == CANON_LEFT_BRACKET: return code
    if code == CANON_BACKSLASH: return code
    if code == CANON_RIGHT_BRACKET: return code
    if code == CANON_QUOTE: return code
    CANON_UNKNOWN

# ============================================================================
# Naming / classification helpers
# ============================================================================

fn canon_key_name(code: i64) -> text:
    """Widget-layer name for a canonical code, in the vocabulary
    `widget_hit.widget_dispatch_key` understands. "" when the key has no name
    of its own (letters and digits carry their glyph in `ch` instead).

    A superset of `host_input_event.host_key_name`, and agreeing with it on
    every code that function handles."""
    if code == CANON_BACKSPACE: return "backspace"
    if code == CANON_TAB: return "tab"
    if code == CANON_ENTER: return "enter"
    if code == CANON_ESCAPE: return "escape"
    if code == CANON_SPACE: return "space"
    if code == CANON_END: return "end"
    if code == CANON_HOME: return "home"
    if code == CANON_LEFT: return "left"
    if code == CANON_UP: return "up"
    if code == CANON_RIGHT: return "right"
    if code == CANON_DOWN: return "down"
    if code == CANON_DELETE: return "delete"
    if code == CANON_INSERT: return "insert"
    if code == CANON_PAGEUP: return "pageup"
    if code == CANON_PAGEDOWN: return "pagedown"
    if code == CANON_SHIFT: return "shift"
    if code == CANON_CTRL: return "ctrl"
    if code == CANON_ALT: return "alt"
    if code == CANON_META: return "meta"
    if code == CANON_CAPSLOCK: return "capslock"
    if code >= CANON_F1 and code <= CANON_F12:
        return "f" + (code - CANON_F1 + 1).to_text()
    ""

fn canon_is_modifier(code: i64) -> bool:
    """True for the four modifier codes. Agrees with
    `input_event.KeyEvent.is_modifier_key` (16/17/18/91)."""
    if code == CANON_SHIFT: return true
    if code == CANON_CTRL: return true
    if code == CANON_ALT: return true
    if code == CANON_META: return true
    false

fn canon_is_letter(code: i64) -> bool:
    """True for CANON_A..CANON_Z."""
    code >= CANON_A and code <= CANON_Z

fn canon_is_digit(code: i64) -> bool:
    """True for CANON_0..CANON_9."""
    code >= CANON_0 and code <= CANON_9

export CANON_UNKNOWN
export CANON_BACKSPACE, CANON_TAB, CANON_ENTER, CANON_SHIFT, CANON_CTRL
export CANON_ALT, CANON_CAPSLOCK, CANON_ESCAPE, CANON_SPACE
export CANON_PAGEUP, CANON_PAGEDOWN, CANON_END, CANON_HOME
export CANON_LEFT, CANON_UP, CANON_RIGHT, CANON_DOWN
export CANON_INSERT, CANON_DELETE, CANON_META
export CANON_0, CANON_1, CANON_2, CANON_3, CANON_4
export CANON_5, CANON_6, CANON_7, CANON_8, CANON_9
export CANON_A, CANON_B, CANON_C, CANON_D, CANON_E, CANON_F, CANON_G
export CANON_H, CANON_I, CANON_J, CANON_K, CANON_L, CANON_M, CANON_N
export CANON_O, CANON_P, CANON_Q, CANON_R, CANON_S, CANON_T, CANON_U
export CANON_V, CANON_W, CANON_X, CANON_Y, CANON_Z
export CANON_F1, CANON_F2, CANON_F3, CANON_F4, CANON_F5, CANON_F6
export CANON_F7, CANON_F8, CANON_F9, CANON_F10, CANON_F11, CANON_F12
export CANON_SEMICOLON, CANON_EQUALS, CANON_COMMA, CANON_MINUS
export CANON_PERIOD, CANON_SLASH, CANON_BACKTICK
export CANON_LEFT_BRACKET, CANON_BACKSLASH, CANON_RIGHT_BRACKET, CANON_QUOTE
export ps2_set1_to_canon, evdev_to_canon, sdl_keysym_to_canon
export winit_keycode_to_canon
export canon_key_name, canon_is_modifier, canon_is_letter, canon_is_digit
