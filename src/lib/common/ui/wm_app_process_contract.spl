# Shared app-process contract for launching the same GUI app source either as a
# native host app or as a WM-managed child process.

struct WmFsAppBridgeRequest:
    kind: text
    source_path: text
    app_id: text
    title: text
    pid: i64
    window_w: i32
    window_h: i32
    content: text
    frame_path: text
    event_path: text
    frame_seq_path: text

# Event crossing the WM file bridge.
#
# The first six fields are the historic layout and must keep their meaning:
# `kind == "key"` has always shipped the keycode in `button`, and readers
# depend on that. The trailing four are ADDITIVE (defaulted, appended last in
# the wire encoding) so a document written by an older producer still decodes:
# - key_code: the keycode, duplicated out of `button` for clarity. 0 means
#             "not set" and readers fall back to `button`.
# - ch:       the printable character for a key event ("" = none). Must not
#             contain a newline; the line-oriented encoder strips them.
# - mods:     HOST_MOD_* bit flags (common.ui.host_input_event).
# - wheel:    wheel notches, positive = content scrolls down.
struct WmFsAppEvent:
    seq: i64
    kind: text
    x: i32
    y: i32
    button: i64
    pressed: bool
    key_code: i64 = 0
    ch: text = ""
    mods: i64 = 0
    wheel: i32 = 0

struct WmFsFrameReceipt:
    event_seq: i64
    frame_seq: i64
    backend: text
    readback_source: text
    backend_handle: i64
    device_identity: i64
    pixel_count: i64
    checksum: i64

val WM_APP_MODE_ENV: text = "SIMPLE_WM_APP_MODE"
val WM_APP_MODE_CLIENT: text = "client"
val WM_BRIDGE_FILE_ENV: text = "SIMPLE_WM_BRIDGE_FILE"
val WM_FRAME_FILE_ENV: text = "SIMPLE_WM_FRAME_FILE"
val WM_EVENT_FILE_ENV: text = "SIMPLE_WM_EVENT_FILE"
val WM_FRAME_SEQ_FILE_ENV: text = "SIMPLE_WM_FRAME_SEQ_FILE"
val WM_CLIENT_HOLD_ENV: text = "SIMPLE_WM_CLIENT_HOLD"

val WIDGET_SHOWCASE_APP_SOURCE: text = "examples/06_io/ui/widget_showcase_gui.spl"
val WIDGET_SHOWCASE_APP_ID: text = "/examples/widget-showcase"
val WIDGET_SHOWCASE_TITLE: text = "Widget Showcase"
val WIDGET_SHOWCASE_WM_WINDOW_TITLE_PREFIX: text = "gui"
val WIDGET_SHOWCASE_WINDOW_W: i32 = 528
val WIDGET_SHOWCASE_WINDOW_H: i32 = 692

val GRAPHICS_2D_SHOWCASE_APP_SOURCE: text = "examples/06_io/ui/graphics_2d_showcase_gui.spl"
val GRAPHICS_2D_SHOWCASE_APP_ID: text = "/examples/graphics-2d-showcase"
val GRAPHICS_2D_SHOWCASE_TITLE: text = "Graphics 2D Showcase"
val GRAPHICS_2D_SHOWCASE_WM_WINDOW_TITLE_PREFIX: text = "2d_showcase"
val GRAPHICS_2D_SHOWCASE_WINDOW_W: i32 = 808
val GRAPHICS_2D_SHOWCASE_WINDOW_H: i32 = 632

val WEB_STANDARDS_SHOWCASE_APP_SOURCE: text = "examples/06_io/ui/web_standards_showcase_gui.spl"
val WEB_STANDARDS_SHOWCASE_APP_ID: text = "/examples/web-standards-showcase"
val WEB_STANDARDS_SHOWCASE_TITLE: text = "Web Standards Showcase"
val WEB_STANDARDS_SHOWCASE_WM_WINDOW_TITLE_PREFIX: text = "web_showcase"
val WEB_STANDARDS_SHOWCASE_WINDOW_W: i32 = 88
val WEB_STANDARDS_SHOWCASE_WINDOW_H: i32 = 68
val WM_SHOWCASE_WINDOW_TITLE_PREFIX: text = "wm_showcase"

fn showcase_backend_token(raw: text) -> text:
    val backend = raw.trim().lower()
    if backend == "":
        return "simple_gui_simple_2d_software"
    if backend == "cpu" or backend == "software":
        return "simple_gui_simple_2d_software"
    if backend == "simd" or backend == "cpu_simd" or backend == "simd_cpu" or backend == "cpu-simd" or backend == "simd-cpu":
        return "simple_gui_simple_2d_simd"
    if backend == "vulkan":
        return "simple_gui_simple_2d_vulkan"
    if backend == "metal":
        return "simple_gui_simple_2d_metal"
    if backend == "tauri" or backend == "tauri2":
        return "tauri2"
    if backend == "electron":
        return "electron"
    if backend.starts_with("simple_gui_simple_web_"):
        return backend
    if backend.starts_with("simple_gui_simple_2d_"):
        return backend
    "simple_gui_simple_2d_software"

fn showcase_window_title(prefix: text, backend: text) -> text:
    prefix + "_showcase_backed_" + showcase_backend_token(backend)

fn wm_app_mode_is_client(mode: text) -> bool:
    mode == WM_APP_MODE_CLIENT

fn widget_showcase_window_title(backend: text) -> text:
    showcase_window_title(WIDGET_SHOWCASE_WM_WINDOW_TITLE_PREFIX, backend)

fn graphics_2d_showcase_window_title(backend: text) -> text:
    showcase_window_title(GRAPHICS_2D_SHOWCASE_WM_WINDOW_TITLE_PREFIX, backend)

fn web_standards_showcase_window_title(backend: text) -> text:
    showcase_window_title(WEB_STANDARDS_SHOWCASE_WM_WINDOW_TITLE_PREFIX, backend)

fn wm_showcase_window_title(backend: text) -> text:
    showcase_window_title(WM_SHOWCASE_WINDOW_TITLE_PREFIX, backend)

fn wm_widget_showcase_event_path(frame_path: text) -> text:
    frame_path + ".event"

fn wm_widget_showcase_frame_seq_path(frame_path: text) -> text:
    frame_path + ".seq"

fn wm_fs_app_event_seq_path(event_path: text, seq: i64) -> text:
    event_path + "." + seq.to_text()

fn wm_fs_frame_receipt_path(frame_path: text) -> text:
    frame_path + ".receipt"

fn wm_fs_frame_checksum(pixels: [u32]) -> i64:
    var checksum: i64 = 0
    var i = 0
    while i < pixels.len():
        # PPM transport preserves RGB only, so alpha must not change the
        # checksum used to correlate the encoded child frame with its receipt.
        checksum = (checksum + (pixels[i].to_i64() & 0x00FFFFFF) * ((i % 251) + 1)) % 2147483647
        i = i + 1
    checksum

fn wm_fs_frame_receipt(event_seq: i64, frame_seq: i64, backend: text, readback_source: text, backend_handle: i64, device_identity: i64, pixel_count: i64, checksum: i64) -> WmFsFrameReceipt:
    WmFsFrameReceipt(
        event_seq: event_seq,
        frame_seq: frame_seq,
        backend: backend,
        readback_source: readback_source,
        backend_handle: backend_handle,
        device_identity: device_identity,
        pixel_count: pixel_count,
        checksum: checksum
    )

fn wm_fs_frame_receipt_encode(receipt: WmFsFrameReceipt) -> text:
    "event_seq={receipt.event_seq}\nframe_seq={receipt.frame_seq}\nbackend={receipt.backend}\nreadback_source={receipt.readback_source}\nbackend_handle={receipt.backend_handle}\ndevice_identity={receipt.device_identity}\npixel_count={receipt.pixel_count}\nchecksum={receipt.checksum}\n"

fn wm_fs_frame_receipt_decode(doc: text) -> WmFsFrameReceipt:
    WmFsFrameReceipt(
        event_seq: _wm_bridge_i64(doc, "event_seq", -1),
        frame_seq: _wm_bridge_i64(doc, "frame_seq", 0),
        backend: _wm_bridge_value(doc, "backend"),
        readback_source: _wm_bridge_value(doc, "readback_source"),
        backend_handle: _wm_bridge_i64(doc, "backend_handle", 0),
        device_identity: _wm_bridge_i64(doc, "device_identity", 0),
        pixel_count: _wm_bridge_i64(doc, "pixel_count", 0),
        checksum: _wm_bridge_i64(doc, "checksum", 0)
    )

fn wm_fs_frame_receipt_valid(receipt: WmFsFrameReceipt, event_seq: i64, frame_seq: i64, requested_backend: text, expected_pixel_count: i64) -> bool:
    if receipt.event_seq != event_seq or receipt.frame_seq != frame_seq:
        return false
    if receipt.backend != requested_backend or receipt.pixel_count != expected_pixel_count or receipt.checksum <= 0:
        return false
    if requested_backend == "vulkan":
        return receipt.readback_source == "device_readback" and receipt.backend_handle > 0 and receipt.device_identity > 0
    receipt.readback_source != ""

fn wm_fs_frame_receipt_correlation(receipt_event_seq: i64, receipt_frame_seq: i64, expected_event_seq: i64, announced_frame_seq: i64) -> text:
    if receipt_frame_seq != announced_frame_seq or receipt_event_seq < expected_event_seq:
        return "pending"
    if receipt_event_seq > expected_event_seq:
        return "invalid"
    "ready"

fn wm_widget_showcase_content_text(source_path: text, frame_path: text, pid: i64) -> text:
    "source={source_path} frame={frame_path} pid={pid}"

fn wm_widget_showcase_bridge_request_sized(pid: i64, frame_path: text, window_w: i32, window_h: i32) -> WmFsAppBridgeRequest:
    wm_widget_showcase_bridge_request_sized_with_backend(pid, frame_path, window_w, window_h, "software")

fn wm_widget_showcase_bridge_request_sized_with_backend(pid: i64, frame_path: text, window_w: i32, window_h: i32, backend: text) -> WmFsAppBridgeRequest:
    WmFsAppBridgeRequest(
        kind: "create_window",
        source_path: WIDGET_SHOWCASE_APP_SOURCE,
        app_id: WIDGET_SHOWCASE_APP_ID,
        title: widget_showcase_window_title(backend),
        pid: pid,
        window_w: window_w,
        window_h: window_h,
        content: wm_widget_showcase_content_text(WIDGET_SHOWCASE_APP_SOURCE, frame_path, pid),
        frame_path: frame_path,
        event_path: wm_widget_showcase_event_path(frame_path),
        frame_seq_path: wm_widget_showcase_frame_seq_path(frame_path)
    )

fn wm_widget_showcase_bridge_request(pid: i64, frame_path: text) -> WmFsAppBridgeRequest:
    wm_widget_showcase_bridge_request_sized(pid, frame_path, WIDGET_SHOWCASE_WINDOW_W, WIDGET_SHOWCASE_WINDOW_H)

fn wm_fs_bridge_encode(req: WmFsAppBridgeRequest) -> text:
    "kind={req.kind}\nsource_path={req.source_path}\napp_id={req.app_id}\ntitle={req.title}\npid={req.pid}\nwindow_w={req.window_w}\nwindow_h={req.window_h}\ncontent={req.content}\nframe_path={req.frame_path}\nevent_path={req.event_path}\nframe_seq_path={req.frame_seq_path}\n"

fn _wm_bridge_value(doc: text, key: text) -> text:
    val prefix = key + "="
    val lines = doc.split("\n")
    var i = 0
    while i < lines.len():
        val line = lines[i]
        if line.starts_with(prefix):
            return line.substring(prefix.len(), line.len())
        i = i + 1
    ""

fn _wm_parse_i64(raw: text, fallback: i64) -> i64:
    if raw.len() == 0:
        return fallback
    val parsed = raw.to_i64()
    if parsed == 0:
        return if raw == "0" or raw == "-0" or raw == "0000": 0 else: fallback
    parsed

fn _wm_bridge_i64(doc: text, key: text, fallback: i64) -> i64:
    _wm_parse_i64(_wm_bridge_value(doc, key), fallback)

fn _wm_bridge_i32(doc: text, key: text) -> i32:
    val parsed = _wm_bridge_i64(doc, key, 0)
    parsed as i32

fn wm_fs_bridge_decode(doc: text) -> WmFsAppBridgeRequest:
    WmFsAppBridgeRequest(
        kind: _wm_bridge_value(doc, "kind"),
        source_path: _wm_bridge_value(doc, "source_path"),
        app_id: _wm_bridge_value(doc, "app_id"),
        title: _wm_bridge_value(doc, "title"),
        pid: _wm_bridge_i64(doc, "pid", 0),
        window_w: _wm_bridge_i32(doc, "window_w"),
        window_h: _wm_bridge_i32(doc, "window_h"),
        content: _wm_bridge_value(doc, "content"),
        frame_path: _wm_bridge_value(doc, "frame_path"),
        event_path: _wm_bridge_value(doc, "event_path"),
        frame_seq_path: _wm_bridge_value(doc, "frame_seq_path")
    )

fn wm_fs_app_event(seq: i64, kind: text, x: i32, y: i32, button: i64, pressed: bool) -> WmFsAppEvent:
    wm_fs_app_event_full(seq, kind, x, y, button, pressed, 0, "", 0, 0)

fn wm_fs_app_event_full(seq: i64, kind: text, x: i32, y: i32, button: i64, pressed: bool, key_code: i64, ch: text, mods: i64, wheel: i32) -> WmFsAppEvent:
    WmFsAppEvent(
        seq: seq, kind: kind, x: x, y: y, button: button, pressed: pressed,
        key_code: key_code, ch: ch, mods: mods, wheel: wheel
    )

fn wm_fs_key_event(seq: i64, keycode: i64, pressed: bool) -> WmFsAppEvent:
    wm_fs_app_event_full(seq, "key", 0, 0, keycode, pressed, keycode, "", 0, 0)

fn wm_fs_key_char_event(seq: i64, keycode: i64, ch: text, mods: i64, pressed: bool) -> WmFsAppEvent:
    """Key event carrying a printable character and modifier flags."""
    wm_fs_app_event_full(seq, "key", 0, 0, keycode, pressed, keycode, ch, mods, 0)

fn wm_fs_wheel_event(seq: i64, x: i32, y: i32, wheel: i32) -> WmFsAppEvent:
    """Wheel event. Positive `wheel` scrolls content down."""
    wm_fs_app_event_full(seq, "wheel", x, y, 0, false, 0, "", 0, wheel)

fn wm_fs_resize_event(seq: i64, w: i32, h: i32) -> WmFsAppEvent:
    """Surface resize; the new size travels in x / y."""
    wm_fs_app_event_full(seq, "resize", w, h, 0, false, 0, "", 0, 0)

fn _wm_event_ch_sanitized(ch: text) -> text:
    """The bridge encoding is line-oriented, so a `ch` may not carry newlines."""
    ch.replace("\n", "").replace("\r", "")

fn wm_fs_app_event_encode(ev: WmFsAppEvent) -> text:
    val x_text = "{ev.x}"
    val y_text = "{ev.y}"
    val ch_text = _wm_event_ch_sanitized(ev.ch)
    # The historic six keys keep their order first, so an older reader that
    # scans for them still parses; the additive four are appended.
    "seq={ev.seq}\nkind={ev.kind}\nx={x_text}\ny={y_text}\nbutton={ev.button}\npressed={ev.pressed}\nkey_code={ev.key_code}\nch={ch_text}\nmods={ev.mods}\nwheel={ev.wheel}\n"

fn wm_fs_app_event_decode(doc: text) -> WmFsAppEvent:
    WmFsAppEvent(
        seq: _wm_bridge_i64(doc, "seq", 0),
        kind: _wm_bridge_value(doc, "kind"),
        x: _wm_bridge_i32(doc, "x"),
        y: _wm_bridge_i32(doc, "y"),
        button: _wm_bridge_i64(doc, "button", 0),
        pressed: _wm_bridge_value(doc, "pressed") == "true",
        key_code: _wm_bridge_i64(doc, "key_code", 0),
        ch: _wm_bridge_value(doc, "ch"),
        mods: _wm_bridge_i64(doc, "mods", 0),
        wheel: _wm_bridge_i32(doc, "wheel")
    )

fn wm_widget_showcase_client_env(bridge_path: text, frame_path: text) -> {text: text}:
    var env: {text: text} = {}
    env[WM_APP_MODE_ENV] = WM_APP_MODE_CLIENT
    env[WM_BRIDGE_FILE_ENV] = bridge_path
    env[WM_FRAME_FILE_ENV] = frame_path
    env[WM_EVENT_FILE_ENV] = wm_widget_showcase_event_path(frame_path)
    env[WM_FRAME_SEQ_FILE_ENV] = wm_widget_showcase_frame_seq_path(frame_path)
    env[WM_CLIENT_HOLD_ENV] = "1"
    env

