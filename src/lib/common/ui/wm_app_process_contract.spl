        event_path: wm_graphics_2d_showcase_event_path(frame_path),
        frame_seq_path: wm_graphics_2d_showcase_frame_seq_path(frame_path)
    )

fn wm_graphics_2d_showcase_bridge_request(pid: i64, frame_path: text) -> WmFsAppBridgeRequest:
    wm_graphics_2d_showcase_bridge_request_sized(pid, frame_path, GRAPHICS_2D_SHOWCASE_WINDOW_W, GRAPHICS_2D_SHOWCASE_WINDOW_H)

fn wm_graphics_2d_showcase_client_env(bridge_path: text, frame_path: text) -> {text: text}:
    var env: {text: text} = {}
    env[WM_APP_MODE_ENV] = WM_APP_MODE_CLIENT
    env[WM_BRIDGE_FILE_ENV] = bridge_path
    env[WM_FRAME_FILE_ENV] = frame_path
    env[WM_EVENT_FILE_ENV] = wm_graphics_2d_showcase_event_path(frame_path)
    env[WM_FRAME_SEQ_FILE_ENV] = wm_graphics_2d_showcase_frame_seq_path(frame_path)
    env[WM_CLIENT_HOLD_ENV] = "1"
    env

