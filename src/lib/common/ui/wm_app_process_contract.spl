fn wm_graphics_2d_showcase_bridge_request_sized(pid: i64, frame_path: text, window_w: i32, window_h: i32) -> WmFsAppBridgeRequest:
    wm_graphics_2d_showcase_bridge_request_sized_with_backend(pid, frame_path, window_w, window_h, "software")

fn wm_graphics_2d_showcase_bridge_request_sized_with_backend(pid: i64, frame_path: text, window_w: i32, window_h: i32, backend: text) -> WmFsAppBridgeRequest:
