fn wm_graphics_2d_showcase_bridge_request_sized(pid: i64, frame_path: text, window_w: i32, window_h: i32) -> WmFsAppBridgeRequest:
    WmFsAppBridgeRequest(
        kind: "create_window",
        source_path: GRAPHICS_2D_SHOWCASE_APP_SOURCE,
        app_id: GRAPHICS_2D_SHOWCASE_APP_ID,
        title: GRAPHICS_2D_SHOWCASE_TITLE,
        pid: pid,
        window_w: window_w,
        window_h: window_h,
