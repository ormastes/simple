# ui_gui_packed_producer.spl -- L6: UiPackedProducer adoption for the GUI
# widget-tree/Panel2D rendering path.
#
# Design authority: doc/05_design/ui/unified_packed_ui_scene.md section 2.2.
# Lane: L6, doc/03_plan/ui/unified_packed_ui_scene_agent_lanes.md.
#
# Adapts INTO the existing production renderer (`widget_tree_to_draw_ir_cpu`,
# widget_draw_ir.spl) and the existing v2->v3 typed adapter
# (draw_ir_v2_to_v3.spl, lane L3) rather than re-deriving widget layout/paint
# -- this lane does not edit either file. Neither the widget tree nor the
# v2->v3 adapter carries any notion of hit-testing or ownership today
# (verified: widget_draw_ir.spl never sets `DrawIrCommand.hit_rect`, so the
# v3 HIT_SHAPES table the adapter produces is always empty). Interactive
# widgets (button/checkbox/input/textfield) are located independently via
# `compute_layout` + `WidgetNode.kind_name()` and get one HIT_SHAPES row and
# one OWNER_RECORDS row each, additive to the v2-oracle's own output -- this
# does not disturb pixel parity (gate d), which covers only the
# paint-visible tables (commands/geometry/paint/text/resources/path/clip/
# transform), never HIT_SHAPES/OWNER_RECORDS.

use common.ui.widget.{WidgetNode, WidgetRect}
use common.ui.layout.{compute_layout, find_rect_index}
use common.ui.widget_draw_ir.{widget_tree_to_draw_ir_cpu}
use common.ui.draw_ir_v2_to_v3.{draw_ir_v2_to_v3}
use common.ui.draw_ir_v3.{
    DRAW_IR_V3_NO_ID,
    DRAW_IR_V3_HIT_RECT,
    DrawIrV3Scene,
    DrawIrV3Command,
    DrawIrV3Geometry,
    DrawIrV3Paint,
    DrawIrV3TextRun,
    DrawIrV3Glyph,
    DrawIrV3Resource,
    DrawIrV3PathSpan,
    DrawIrV3PathPoint,
    DrawIrV3Clip,
    DrawIrV3Transform,
    DrawIrV3HitShape,
    DrawIrV3Provenance
}
use common.ui.ui_scene_counts.{
    UiSceneCounts,
    UiSceneRanges,
    UiSceneOverflowReceipt,
    UI_PRODUCER_GUI,
    UI_SCENE_OVERFLOW_DEFICIT,
    UI_SCENE_OVERFLOW_SURPLUS
}
use common.ui.ui_scene_owner_table.{UiOwnerRecord, UI_SCENE_EVENT_POLICY_HIT_OPAQUE}
use common.ui.ui_scene_slice.{
    UiSceneSlice,
    UiSceneWriteVerdict,
    UiSceneEmitResult,
    DrawIrV3Writer,
    UiOwnerWriter,
    UiActionWriter,
    UiPackedProducer
}

# Non-zero so a live owner record is trivially distinguishable from an
# unset/default one (design section 2.4 "live `semantic_generation`").
val GUI_INTERACTIVE_GENERATION: u32 = 1u32

# Table-row-index fields (geometry_id, paint_id, ...) are read back as
# ABSOLUTE indices into the assembled arena's combined per-table array
# (draw_ir_v3_group_resolve.spl and the L4 `ranges.<table>.start +
# cursor()` convention agree on this). This producer copies an
# already-self-consistent LOCAL scene from draw_ir_v2_to_v3 verbatim, so
# every id it carries must be rebased by this producer's assigned
# `ranges.<table>.start` before being written -- component_id/parent_id
# are identities (matched by value, not indexed), never rebased.
fn _gui_rebase_id(id: u32, start: u32) -> u32:
    if id == DRAW_IR_V3_NO_ID:
        DRAW_IR_V3_NO_ID
    else:
        id + start

fn _gui_is_interactive_kind(kind: text) -> bool:
    kind == "button" or kind == "checkbox" or kind == "input" or kind == "textfield"

# Recursive tree walk (calls INTO WidgetNode.children()/.kind_name(), does
# not touch widget_store*.spl). Depth-first, deterministic order -- repeated
# calls against the same tree state yield the same list in the same order,
# which is what makes count() and emit() agree on interactive[i]'s identity.
fn _gui_collect_interactive(node: WidgetNode, rects: [WidgetRect]) -> [WidgetRect]:
    var out: [WidgetRect] = []
    if _gui_is_interactive_kind(node.kind_name()):
        val idx = find_rect_index(rects, node.id)
        if idx >= 0:
            out.push(rects[idx])
    for child in node.children():
        for r in _gui_collect_interactive(child, rects):
            out.push(r)
    out

struct GuiPackedScene:
    v3: DrawIrV3Scene
    interactive: [WidgetRect]

fn _gui_build_scene(root: WidgetNode, width: i32, height: i32) -> GuiPackedScene:
    val composition = widget_tree_to_draw_ir_cpu(root, width, height)
    val v3 = draw_ir_v2_to_v3(composition)
    val rects = compute_layout(root, 0, 0, width, height)
    val interactive = _gui_collect_interactive(root, rects)
    GuiPackedScene(v3: v3, interactive: interactive)

fn _gui_counts_of(scene: GuiPackedScene) -> UiSceneCounts:
    val n_interactive = scene.interactive.len().to_u32()
    UiSceneCounts(
        commands: scene.v3.commands.len().to_u32(),
        geometry: scene.v3.geometry.xs.len().to_u32(),
        paint: scene.v3.paint.fill_colors.len().to_u32(),
        text_runs: scene.v3.text_runs.run_glyph_starts.len().to_u32(),
        glyphs: scene.v3.text_runs.glyph_ids.len().to_u32(),
        resources: scene.v3.resources.kinds.len().to_u32(),
        path_spans: scene.v3.path_points.span_point_starts.len().to_u32(),
        path_points: scene.v3.path_points.point_xs.len().to_u32(),
        clips: scene.v3.clips.xs.len().to_u32(),
        transforms: scene.v3.transforms.m11s.len().to_u32(),
        hit_shapes: scene.v3.hit_shapes.xs.len().to_u32() + n_interactive,
        provenance_edges: scene.v3.provenance.command_indices.len().to_u32(),
        owner_records: n_interactive,
        action_bindings: 0u32,
        prepared_batches: 0u32,
        dirty_ranges: 0u32
    )

fn _gui_verdict_is_exact(v: UiSceneWriteVerdict) -> bool:
    match v:
        UiSceneWriteVerdict.Exact:
            true
        UiSceneWriteVerdict.Deficit(table_id, n):
            false
        UiSceneWriteVerdict.Surplus(table_id, n):
            false

fn _gui_overflow_receipt(v: UiSceneWriteVerdict, producer_kind: u16, producer_id: u32, snapshot_id: u64) -> UiSceneOverflowReceipt:
    match v:
        UiSceneWriteVerdict.Deficit(table_id, n):
            UiSceneOverflowReceipt(
                table_id: table_id, kind: UI_SCENE_OVERFLOW_DEFICIT, required: n, capacity: 0u32,
                producer_kind: producer_kind, producer_id: producer_id, snapshot_id: snapshot_id
            )
        UiSceneWriteVerdict.Surplus(table_id, n):
            UiSceneOverflowReceipt(
                table_id: table_id, kind: UI_SCENE_OVERFLOW_SURPLUS, required: n, capacity: 0u32,
                producer_kind: producer_kind, producer_id: producer_id, snapshot_id: snapshot_id
            )
        UiSceneWriteVerdict.Exact:
            UiSceneOverflowReceipt(
                table_id: 0u16, kind: UI_SCENE_OVERFLOW_DEFICIT, required: 0u32, capacity: 0u32,
                producer_kind: producer_kind, producer_id: producer_id, snapshot_id: snapshot_id
            )

# Writes every row of `scene` into the externally-owned, pre-reserved
# writers, in table order. Order across DIFFERENT tables is irrelevant (each
# table has its own writer cursor); what matters is writing exactly the
# count `_gui_counts_of` reported for each table.
fn _gui_write_scene(scene: GuiPackedScene, ranges: UiSceneRanges, draw: DrawIrV3Writer, owners: UiOwnerWriter):
    var i = 0
    while i < scene.v3.commands.len():
        val c = scene.v3.commands[i]
        draw.put_command(DrawIrV3Command(
            kind: c.kind, flags: c.flags,
            component_id: c.component_id, component_generation: c.component_generation, parent_id: c.parent_id,
            geometry_id: _gui_rebase_id(c.geometry_id, ranges.geometry.start),
            paint_id: _gui_rebase_id(c.paint_id, ranges.paint.start),
            text_run_id: _gui_rebase_id(c.text_run_id, ranges.text_runs.start),
            image_resource_id: _gui_rebase_id(c.image_resource_id, ranges.resources.start),
            path_span_id: _gui_rebase_id(c.path_span_id, ranges.path_spans.start),
            clip_id: _gui_rebase_id(c.clip_id, ranges.clips.start),
            transform_id: _gui_rebase_id(c.transform_id, ranges.transforms.start),
            hit_shape_id: _gui_rebase_id(c.hit_shape_id, ranges.hit_shapes.start)
        ))
        i = i + 1

    i = 0
    while i < scene.v3.geometry.xs.len():
        draw.put_geometry(DrawIrV3Geometry(
            present: true, x: scene.v3.geometry.xs[i], y: scene.v3.geometry.ys[i],
            width: scene.v3.geometry.widths[i], height: scene.v3.geometry.heights[i],
            corner_radius: scene.v3.geometry.corner_radii[i]
        ))
        i = i + 1

    i = 0
    while i < scene.v3.paint.fill_colors.len():
        draw.put_paint(DrawIrV3Paint(
            present: true, fill_color: scene.v3.paint.fill_colors[i],
            stroke_color: scene.v3.paint.stroke_colors[i],
            stroke_width_milli: scene.v3.paint.stroke_widths_milli[i],
            opacity_milli: scene.v3.paint.opacities_milli[i],
            blend_mode: scene.v3.paint.blend_modes[i]
        ))
        i = i + 1

    i = 0
    while i < scene.v3.text_runs.run_glyph_starts.len():
        draw.put_text_run(DrawIrV3TextRun(
            present: true, glyph_start: _gui_rebase_id(scene.v3.text_runs.run_glyph_starts[i], ranges.glyphs.start),
            glyph_count: scene.v3.text_runs.run_glyph_counts[i],
            font_resource_id: scene.v3.text_runs.run_font_resource_ids[i],
            font_size_milli: scene.v3.text_runs.run_font_sizes_milli[i],
            baseline_x: scene.v3.text_runs.run_baseline_xs[i],
            baseline_y: scene.v3.text_runs.run_baseline_ys[i],
            color: scene.v3.text_runs.run_colors[i]
        ))
        i = i + 1

    i = 0
    while i < scene.v3.text_runs.glyph_ids.len():
        draw.put_glyph(DrawIrV3Glyph(
            present: true, glyph_id: scene.v3.text_runs.glyph_ids[i],
            x: scene.v3.text_runs.glyph_xs[i], y: scene.v3.text_runs.glyph_ys[i],
            cluster: scene.v3.text_runs.glyph_clusters[i]
        ))
        i = i + 1

    i = 0
    while i < scene.v3.resources.kinds.len():
        draw.put_resource(DrawIrV3Resource(
            present: true, kind: scene.v3.resources.kinds[i], format: scene.v3.resources.formats[i],
            width: scene.v3.resources.widths[i], height: scene.v3.resources.heights[i],
            content_hash: scene.v3.resources.content_hashes[i]
        ))
        i = i + 1

    i = 0
    while i < scene.v3.path_points.span_point_starts.len():
        draw.put_path_span(DrawIrV3PathSpan(
            present: true, point_start: _gui_rebase_id(scene.v3.path_points.span_point_starts[i], ranges.path_points.start),
            point_count: scene.v3.path_points.span_point_counts[i],
            fill_rule: scene.v3.path_points.span_fill_rules[i]
        ))
        i = i + 1

    i = 0
    while i < scene.v3.path_points.point_xs.len():
        draw.put_path_point(DrawIrV3PathPoint(
            present: true, x: scene.v3.path_points.point_xs[i], y: scene.v3.path_points.point_ys[i],
            verb: scene.v3.path_points.point_verbs[i]
        ))
        i = i + 1

    i = 0
    while i < scene.v3.clips.xs.len():
        draw.put_clip(DrawIrV3Clip(
            present: true, x: scene.v3.clips.xs[i], y: scene.v3.clips.ys[i],
            width: scene.v3.clips.widths[i], height: scene.v3.clips.heights[i],
            corner_radius: scene.v3.clips.corner_radii[i], parent_id: _gui_rebase_id(scene.v3.clips.parent_ids[i], ranges.clips.start)
        ))
        i = i + 1

    i = 0
    while i < scene.v3.transforms.m11s.len():
        draw.put_transform(DrawIrV3Transform(
            present: true, m11: scene.v3.transforms.m11s[i], m12: scene.v3.transforms.m12s[i],
            m21: scene.v3.transforms.m21s[i], m22: scene.v3.transforms.m22s[i],
            dx: scene.v3.transforms.dxs[i], dy: scene.v3.transforms.dys[i]
        ))
        i = i + 1

    i = 0
    while i < scene.v3.hit_shapes.xs.len():
        draw.put_hit_shape(DrawIrV3HitShape(
            present: true, x: scene.v3.hit_shapes.xs[i], y: scene.v3.hit_shapes.ys[i],
            width: scene.v3.hit_shapes.widths[i], height: scene.v3.hit_shapes.heights[i],
            shape_kind: scene.v3.hit_shapes.shape_kinds[i], hit_flags: scene.v3.hit_shapes.hit_flags[i],
            component_id: scene.v3.hit_shapes.component_ids[i]
        ))
        i = i + 1

    i = 0
    while i < scene.v3.provenance.command_indices.len():
        draw.put_provenance(DrawIrV3Provenance(
            present: true, command_index: _gui_rebase_id(scene.v3.provenance.command_indices[i], ranges.commands.start),
            edge_kind: scene.v3.provenance.edge_kinds[i],
            source_node_id: scene.v3.provenance.source_node_ids[i],
            source_rule_id: scene.v3.provenance.source_rule_ids[i],
            source_span_start: scene.v3.provenance.source_span_starts[i],
            source_span_len: scene.v3.provenance.source_span_lens[i]
        ))
        i = i + 1

    # Interactive-widget hit shapes + one owner record each (see module doc:
    # additive, not part of the v2 oracle's own output).
    var oi = 0
    while oi < scene.interactive.len():
        val r = scene.interactive[oi]
        val comp_id = oi.to_u32()
        draw.put_hit_shape(DrawIrV3HitShape(
            present: true, x: r.x, y: r.y, width: r.w, height: r.h,
            shape_kind: DRAW_IR_V3_HIT_RECT, hit_flags: 0u16, component_id: comp_id
        ))
        owners.put_owner_record(UiOwnerRecord(
            producer_kind: UI_PRODUCER_GUI, event_policy: UI_SCENE_EVENT_POLICY_HIT_OPAQUE,
            semantic_id: comp_id, semantic_generation: GUI_INTERACTIVE_GENERATION,
            parent_owner_id: DRAW_IR_V3_NO_ID, action_binding_id: DRAW_IR_V3_NO_ID
        ))
        oi = oi + 1

struct GuiPackedProducer:
    id_val: u32
    root: WidgetNode
    width: i32
    height: i32

impl UiPackedProducer for GuiPackedProducer:
    me producer_kind() -> u16:
        UI_PRODUCER_GUI

    me producer_id() -> u32:
        self.id_val

    me count(snapshot_id: u64, counts: UiSceneCounts) -> UiSceneCounts:
        _gui_counts_of(_gui_build_scene(self.root, self.width, self.height))

    me emit(
        snapshot_id: u64, ranges: UiSceneRanges,
        draw: DrawIrV3Writer, owners: UiOwnerWriter, actions: UiActionWriter
    ) -> UiSceneEmitResult:
        val scene = _gui_build_scene(self.root, self.width, self.height)
        _gui_write_scene(scene, ranges, draw, owners)

        val draw_verdict = draw.finish()
        if not _gui_verdict_is_exact(draw_verdict):
            return UiSceneEmitResult.Refused(_gui_overflow_receipt(draw_verdict, self.producer_kind(), self.id_val, snapshot_id))

        val owner_verdict = owners.finish()
        if not _gui_verdict_is_exact(owner_verdict):
            return UiSceneEmitResult.Refused(_gui_overflow_receipt(owner_verdict, self.producer_kind(), self.id_val, snapshot_id))

        val action_verdict = actions.finish()
        if not _gui_verdict_is_exact(action_verdict):
            return UiSceneEmitResult.Refused(_gui_overflow_receipt(action_verdict, self.producer_kind(), self.id_val, snapshot_id))

        UiSceneEmitResult.Emitted(UiSceneSlice(
            scene_slot: self.id_val, scene_generation: 1u32,
            root_component_id: DRAW_IR_V3_NO_ID, ranges: ranges
        ))

export GuiPackedProducer
