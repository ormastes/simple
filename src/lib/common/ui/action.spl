# Typed UI action wrapper (Phase 5 UI Typed Core RFC).
#
# `CommonAction` enumerates the library-known actions; `Action` is the open
# wrapper (`Builtin` for library actions, `Custom` for app-defined names);
# `IntoAction` lets an app-defined enum route into `Action` without the
# library having to enumerate every app's actions.
#
# The wire shape is unchanged: `UIEvent.Action(name: text)` still carries a
# single text field, produced by `Action.into_wire_name()`.

enum CommonAction:
    Save
    Cancel
    Confirm
    Dismiss
    Back
    Search
    ToggleSidebar

impl CommonAction:
    fn to_wire(self) -> text:
        """Wire name for a library-known action."""
        match self:
            CommonAction.Save => "save"
            CommonAction.Cancel => "cancel"
            CommonAction.Confirm => "confirm"
            CommonAction.Dismiss => "dismiss"
            CommonAction.Back => "back"
            CommonAction.Search => "search"
            CommonAction.ToggleSidebar => "toggle_sidebar"

enum Action:
    Builtin(action: CommonAction)
    Custom(name: text)

impl Action:
    fn into_wire_name(self) -> text:
        """Resolve a typed action to the text carried by UIEvent.Action."""
        match self:
            Action.Builtin(action):
                return action.to_wire()
            Action.Custom(name):
                return name

# Apps implement this on their own action enum to route into `Action`.
trait IntoAction:
    fn into_action(self) -> Action

impl IntoAction for CommonAction:
    fn into_action(self) -> Action:
        return Action.Builtin(action: self)

export CommonAction, Action, IntoAction
