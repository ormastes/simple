# Exact finite f64 transport for DrawIR semantic geometry. Decimal display
# formatting is not an interchange contract; fixed IEEE-754 hex avoids rounding.
use std.common.binary_io.{f64_to_bits, f64_from_bits}

fn draw_ir_f64_hex(value: f64) -> text:
    val bits = f64_to_bits(value)
    if ((bits >> 52) & 0x7ffu64) == 0x7ffu64:
        panic("DrawIR geometry must be finite")
    val digits = "0123456789abcdef"
    var out = ""
    var shift: i64 = 60
    while shift >= 0:
        val digit = ((bits >> shift) & 15u64) as i64
        out = out + digits.char_at(digit)
        shift = shift - 4
    out

fn draw_ir_f64_from_hex_checked(value: text) -> Result<f64, text>:
    if value.len() != 16:
        return Err("invalid DrawIR f64 width")
    var bits: u64 = 0u64
    var i: i64 = 0
    while i < 16:
        val byte = value.byte_at(i)
        var digit: i64 = -1
        if byte >= 48 and byte <= 57:
            digit = byte - 48
        elif byte >= 97 and byte <= 102:
            digit = byte - 87
        if digit < 0:
            return Err("invalid DrawIR f64 hexadecimal digit")
        bits = (bits << 4) | (digit as u64)
        i = i + 1
    if ((bits >> 52) & 0x7ffu64) == 0x7ffu64:
        return Err("DrawIR geometry must be finite")
    Ok(f64_from_bits(bits))

fn draw_ir_f64_from_hex(value: text) -> f64:
    match draw_ir_f64_from_hex_checked(value):
        Ok(number): number
        Err(error): panic(error)

export draw_ir_f64_hex, draw_ir_f64_from_hex, draw_ir_f64_from_hex_checked
