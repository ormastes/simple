#![allow(primitive_api)] # A2UI catalog descriptors carry boolean/flag metadata per protocol spec
# A2UI Basic Catalog Descriptors and Validation
#
# Pinned Basic catalog v1.0 component signatures, slot cardinality, property
# validation rules, and catalog function caller/activation contracts.
# Catalog IDs resolve only against registered host descriptors; never fetched.

use std.common.ui.a2ui.types.{
    a2ui_basic_catalog_id,
    A2uiValue,
    A2uiArgPresence,
    A2uiObjectEntry,
    A2uiComponentDef,
    a2ui_obj_get
}

pub enum A2uiSlotKind:
    NoSlot
    SingleChild
    ChildList

pub enum A2uiPropKind:
    AnyTextOrPath
    AnyBoolOrPath
    AnyNumberOrPath
    ActionOnly

pub struct A2uiPropSpec:
    name: text
    kind: A2uiPropKind
    required: bool

pub struct A2uiComponentSpec:
    name: text
    slot_name: text
    slot_kind: A2uiSlotKind
    requires_child: bool
    props: [A2uiPropSpec]
    positional_params: [text]

pub struct A2uiFunctionSpec:
    name: text
    catalog_id: text
    pure: bool
    allowed_callers: [text]
    requires_user_activation: bool

pub struct A2uiCatalog:
    catalog_id: text
    digest: text
    components: [A2uiComponentSpec]
    functions: [A2uiFunctionSpec]

pub fn a2ui_basic_catalog() -> A2uiCatalog:
    val components: [A2uiComponentSpec] = [
        A2uiComponentSpec(
            name: "Column",
            slot_name: "children",
            slot_kind: A2uiSlotKind.ChildList,
            requires_child: true,
            props: [
                A2uiPropSpec(name: "alignment", kind: A2uiPropKind.AnyTextOrPath, required: false),
                A2uiPropSpec(name: "distribution", kind: A2uiPropKind.AnyTextOrPath, required: false)
            ],
            positional_params: ["children"]
        ),
        A2uiComponentSpec(
            name: "Row",
            slot_name: "children",
            slot_kind: A2uiSlotKind.ChildList,
            requires_child: true,
            props: [
                A2uiPropSpec(name: "alignment", kind: A2uiPropKind.AnyTextOrPath, required: false),
                A2uiPropSpec(name: "distribution", kind: A2uiPropKind.AnyTextOrPath, required: false)
            ],
            positional_params: ["children"]
        ),
        A2uiComponentSpec(
            name: "List",
            slot_name: "children",
            slot_kind: A2uiSlotKind.ChildList,
            requires_child: false,
            props: [
                A2uiPropSpec(name: "direction", kind: A2uiPropKind.AnyTextOrPath, required: false),
                A2uiPropSpec(name: "alignment", kind: A2uiPropKind.AnyTextOrPath, required: false)
            ],
            positional_params: ["children"]
        ),
        A2uiComponentSpec(
            name: "Card",
            slot_name: "child",
            slot_kind: A2uiSlotKind.SingleChild,
            requires_child: true,
            props: [],
            positional_params: ["child"]
        ),
        A2uiComponentSpec(
            name: "Text",
            slot_name: "",
            slot_kind: A2uiSlotKind.NoSlot,
            requires_child: false,
            props: [
                A2uiPropSpec(name: "text", kind: A2uiPropKind.AnyTextOrPath, required: true),
                A2uiPropSpec(name: "variant", kind: A2uiPropKind.AnyTextOrPath, required: false)
            ],
            positional_params: ["text", "variant"]
        ),
        A2uiComponentSpec(
            name: "Button",
            slot_name: "child",
            slot_kind: A2uiSlotKind.SingleChild,
            requires_child: true,
            props: [
                A2uiPropSpec(name: "variant", kind: A2uiPropKind.AnyTextOrPath, required: false)
            ],
            positional_params: ["child", "action"]
        ),
        A2uiComponentSpec(
            name: "TextField",
            slot_name: "",
            slot_kind: A2uiSlotKind.NoSlot,
            requires_child: false,
            props: [
                A2uiPropSpec(name: "label", kind: A2uiPropKind.AnyTextOrPath, required: true),
                A2uiPropSpec(name: "value", kind: A2uiPropKind.AnyTextOrPath, required: false),
                A2uiPropSpec(name: "variant", kind: A2uiPropKind.AnyTextOrPath, required: false)
            ],
            positional_params: ["label", "value", "variant"]
        ),
        A2uiComponentSpec(
            name: "CheckBox",
            slot_name: "",
            slot_kind: A2uiSlotKind.NoSlot,
            requires_child: false,
            props: [
                A2uiPropSpec(name: "label", kind: A2uiPropKind.AnyTextOrPath, required: true),
                A2uiPropSpec(name: "value", kind: A2uiPropKind.AnyBoolOrPath, required: true)
            ],
            positional_params: ["label", "value"]
        )
    ]
    val functions: [A2uiFunctionSpec] = [
        A2uiFunctionSpec(
            name: "formatString",
            catalog_id: a2ui_basic_catalog_id(),
            pure: true,
            allowed_callers: ["binding", "agent", "renderer"],
            requires_user_activation: false
        ),
        A2uiFunctionSpec(
            name: "required",
            catalog_id: a2ui_basic_catalog_id(),
            pure: true,
            allowed_callers: ["binding", "renderer"],
            requires_user_activation: false
        ),
        A2uiFunctionSpec(
            name: "openUrl",
            catalog_id: a2ui_basic_catalog_id(),
            pure: false,
            allowed_callers: ["user_action"],
            requires_user_activation: true
        )
    ]
    A2uiCatalog(
        catalog_id: a2ui_basic_catalog_id(),
        digest: "sha256:basic_v1_0_1dbe86a9",
        components: components,
        functions: functions
    )

pub fn a2ui_catalog_find_component(catalog: A2uiCatalog, name: text) -> A2uiComponentSpec?:
    var i = 0
    while i < catalog.components.len():
        if catalog.components[i].name == name:
            return Some(catalog.components[i])
        i = i + 1
    None

pub fn a2ui_catalog_find_function(catalog: A2uiCatalog, name: text) -> A2uiFunctionSpec?:
    var i = 0
    while i < catalog.functions.len():
        if catalog.functions[i].name == name:
            return Some(catalog.functions[i])
        i = i + 1
    None

pub fn a2ui_catalog_check_function_call(
    catalog: A2uiCatalog,
    catalog_id: text,
    function_name: text,
    caller_id: text,
    user_activated: bool
) -> Result<A2uiFunctionSpec, text>:
    if catalog_id != catalog.catalog_id:
        return Err("unknown_function_catalog:" + catalog_id)
    val found = a2ui_catalog_find_function(catalog, function_name)
    val spec = match found:
        case Some(s): s
        case None: return Err("unknown_catalog_function:" + function_name)
    var caller_ok = false
    var i = 0
    while i < spec.allowed_callers.len():
        if spec.allowed_callers[i] == caller_id:
            caller_ok = true
        i = i + 1
    if not caller_ok:
        return Err("caller_not_allowed:" + caller_id + ":" + function_name)
    if spec.requires_user_activation and not user_activated:
        return Err("user_activation_required:" + function_name)
    Ok(spec)

fn _prop_value_matches(kind: A2uiPropKind, v: A2uiValue) -> bool:
    match kind:
        case A2uiPropKind.AnyTextOrPath:
            match v:
                case A2uiValue.Text(_): true
                case A2uiValue.Path(_): true
                case _: false
        case A2uiPropKind.AnyBoolOrPath:
            match v:
                case A2uiValue.Bool(_): true
                case A2uiValue.Path(_): true
                case _: false
        case A2uiPropKind.AnyNumberOrPath:
            match v:
                case A2uiValue.Number(_): true
                case A2uiValue.Int(_): true
                case A2uiValue.Path(_): true
                case _: false
        case A2uiPropKind.ActionOnly:
            false

pub fn a2ui_catalog_validate_component(
    catalog: A2uiCatalog,
    comp: A2uiComponentDef
) -> Result<bool, text>:
    if comp.id == "":
        return Err("empty_component_id")
    if comp.catalog_override != "" and comp.catalog_override != catalog.catalog_id:
        return Err("unregistered_catalog_override:" + comp.catalog_override)
    val found = a2ui_catalog_find_component(catalog, comp.component)
    val spec = match found:
        case Some(s): s
        case None: return Err("unknown_component:" + comp.component)
    # Check slot cardinality and required children.
    match spec.slot_kind:
        case A2uiSlotKind.NoSlot:
            if comp.child != "" or comp.children.len() > 0:
                return Err("slot_not_allowed:" + comp.component)
        case A2uiSlotKind.SingleChild:
            if comp.children.len() > 0:
                return Err("list_slot_on_single_child:" + comp.component)
            if spec.requires_child and comp.child == "":
                return Err("missing_required_child:" + comp.id)
        case A2uiSlotKind.ChildList:
            if comp.child != "":
                return Err("single_slot_on_child_list:" + comp.component)
            if spec.requires_child and comp.children.len() == 0:
                return Err("missing_required_children:" + comp.id)
    # Reject unknown properties (including Button(text=...) and table-only fields).
    var pi = 0
    while pi < comp.props.len():
        val entry = comp.props[pi]
        var matched = false
        var expected_kind = A2uiPropKind.AnyTextOrPath
        var si = 0
        while si < spec.props.len():
            if spec.props[si].name == entry.key:
                matched = true
                expected_kind = spec.props[si].kind
            si = si + 1
        if not matched:
            return Err("unknown_property:" + comp.component + "." + entry.key)
        if not _prop_value_matches(expected_kind, entry.value):
            return Err("invalid_property_type:" + comp.component + "." + entry.key)
        pi = pi + 1
    # Verify required properties are present.
    var ri = 0
    while ri < spec.props.len():
        val ps = spec.props[ri]
        if ps.required:
            match a2ui_obj_get(comp.props, ps.name):
                case A2uiArgPresence.Omitted:
                    return Err("missing_required_property:" + comp.id + "." + ps.name)
                case A2uiArgPresence.Present(_):
                    ()
        ri = ri + 1
    Ok(true)

export A2uiSlotKind, A2uiPropKind, A2uiPropSpec, A2uiComponentSpec, A2uiFunctionSpec, A2uiCatalog
export a2ui_basic_catalog, a2ui_catalog_find_component, a2ui_catalog_find_function
export a2ui_catalog_check_function_call, a2ui_catalog_validate_component
