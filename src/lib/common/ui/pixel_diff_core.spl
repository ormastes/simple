# Shared pure ARGB pixel-delta core.
#
# Used by the Chrome-vs-Simple catalog differ (app.ui.chrome_showcase.pixel_diff)
# and the rendering parity comparator (common.ui.rendering_parity), so the
# per-pixel channel arithmetic lives in exactly one place.

fn _pd_abs(v: i32) -> i32:
    if v < 0: 0 - v else: v

# Largest absolute R/G/B channel difference between two ARGB words (alpha ignored).
fn argb_channel_max_delta(a: u32, b: u32) -> i32:
    val dr = _pd_abs((((a >> 16) & 0xFFu32) as i32) - (((b >> 16) & 0xFFu32) as i32))
    val dg = _pd_abs((((a >> 8) & 0xFFu32) as i32) - (((b >> 8) & 0xFFu32) as i32))
    val db = _pd_abs(((a & 0xFFu32) as i32) - ((b & 0xFFu32) as i32))
    var m = dr
    if dg > m:
        m = dg
    if db > m:
        m = db
    m

# Absolute alpha-channel difference between two ARGB words.
fn argb_alpha_delta(a: u32, b: u32) -> i32:
    _pd_abs((((a >> 24) & 0xFFu32) as i32) - (((b >> 24) & 0xFFu32) as i32))
