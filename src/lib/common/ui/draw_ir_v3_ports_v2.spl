# DrawIR v3 Ports v2 — versioned submission port (design §2.6).
#
# Design authority: `doc/05_design/ui/unified_packed_ui_scene.md` §2.6.
# Lane: L1 (`doc/03_plan/ui/unified_packed_ui_scene_agent_lanes.md`).
#
# v1 (`draw_ir_v3_ports.spl`: `PackedDrawPort`, `DrawIrV3SubmitReceipt`) is
# frozen and NEVER edited in place (decision record #6). This file is
# purely additive: native submission by stable reference (`PackedSceneRef`,
# slot+generation), not by-value scene aggregates. Trait + value types
# only — implementations live in backend tiers (later lanes).

use common.ui.ui_scene_counts.{UiSceneRange}

pub val DRAW_IR_V3_PORTS_V2_SCHEMA_VERSION: text = "simple-draw-ir-v3-ports-v2"
pub val DRAW_IR_V3_PORTS_V2_SCHEMA_ID: u32 = 2u32

# ---------------------------------------------------------------------------
# Port-level submit refusal reasons (design §2.6): "stale generation,
# capability mismatch, capacity" are new codes here. Where the surface comes
# from the WM host seam, the refusal is the EXISTING `WmHost2dUnavailable`
# (`src/lib/nogc_async_mut/wm/host.spl`) — deliberately NOT re-encoded as a
# numeric reason in this receipt; design §2.6 forbids inventing a parallel
# "surface unavailable" type.
# ---------------------------------------------------------------------------
pub val DRAW_IR_V3_PORT_V2_REASON_OK: u16 = 0u16
pub val DRAW_IR_V3_PORT_V2_REASON_STALE_GENERATION: u16 = 1u16
pub val DRAW_IR_V3_PORT_V2_REASON_CAPABILITY_MISMATCH: u16 = 2u16
pub val DRAW_IR_V3_PORT_V2_REASON_CAPACITY: u16 = 3u16

# ---------------------------------------------------------------------------
# Stable scene reference (design §2.6). Submission is by reference, never by
# value.
# ---------------------------------------------------------------------------

struct PackedSceneRef:
    object_slot: u32          # MDSOC+/Object-VM slot
    object_generation: u32
    scene_id: u32
    scene_generation: u32

# Reference-by-range into the arena-owned PREPARED_BATCHES / DIRTY_RANGES
# tables submitted alongside a scene, mirroring `PackedSceneRef`'s
# slot+generation-not-by-value philosophy. Design §2.6 names these types
# (`Prepared2DRef`, `DirtyRangeRef`) in the `submit_scene_ref` signature
# without pinning their fields; this is the minimal shape consistent with
# `Prepared2DPlan` (design §2.5) — additive/renamable without ABI risk since
# no other lane consumes them yet.
struct Prepared2DRef:
    batches: UiSceneRange
    scene_generation: u32

struct DirtyRangeRef:
    dirty_upload: UiSceneRange
    scene_generation: u32

# One submit/present receipt (design §2.6 — same name/shape as specified;
# distinct from and not to be confused with v1's `DrawIrV3SubmitReceipt` in
# `draw_ir_v3_ports.spl`, which carries route/fallback_level/elapsed_us/
# deterministic_hash fields instead).
struct DrawIrV3SubmitReceipt:
    accepted: bool
    reason: u16
    scene_generation: u32
    commands_seen: u32

trait PackedDrawPortV2:
    fn capabilities() -> u32
    fn submit_scene_ref(
        scene: PackedSceneRef, prepared: Prepared2DRef, dirty: DirtyRangeRef
    ) -> DrawIrV3SubmitReceipt
    fn present(scene_generation: u32) -> bool

export DRAW_IR_V3_PORTS_V2_SCHEMA_VERSION, DRAW_IR_V3_PORTS_V2_SCHEMA_ID,
    DRAW_IR_V3_PORT_V2_REASON_OK, DRAW_IR_V3_PORT_V2_REASON_STALE_GENERATION,
    DRAW_IR_V3_PORT_V2_REASON_CAPABILITY_MISMATCH, DRAW_IR_V3_PORT_V2_REASON_CAPACITY,
    PackedSceneRef, Prepared2DRef, DirtyRangeRef, DrawIrV3SubmitReceipt,
    PackedDrawPortV2
