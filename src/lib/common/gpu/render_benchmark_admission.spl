# codex-impl
"""Fail-closed admission for comparable GPU renderer benchmark receipts."""

struct GpuRenderBenchmarkEvidence:
    runner: text
    fixture_hash: text
    event_script_hash: text
    width: i64
    height: i64
    pixel_format: text
    timing_boundary: text
    warmup_count: i64
    sample_count: i64
    backend: text
    device_identity: text
    source_revision: text
    binary_hash: text
    p50_ns: i64
    p95_ns: i64
    max_rss_bytes: i64
    upload_bytes: i64
    timed_buffer_allocation_count: i64
    retained_buffer_bytes: i64
    teardown_released_bytes: i64
    timed_full_frame_upload_count: i64
    timed_readback_bytes: i64
    capture_count: i64
    capture_readback_bytes: i64
    fence_completion_count: i64
    completion_poll_count: i64
    cpu_completion_wait_count: i64
    frame_ring_capacity: i64
    max_frames_in_flight: i64
    unconditional_submit_wait: bool
    event_generation_count: i64
    damage_area_pixels: i64
    fallback_used: bool
    device_execution_proven: bool

fn gpu_render_benchmark_evidence_admitted(
    evidence: GpuRenderBenchmarkEvidence) -> bool:
    evidence.runner != "" and evidence.fixture_hash != "" and
        evidence.event_script_hash != "" and evidence.width > 0 and
        evidence.height > 0 and evidence.pixel_format != "" and
        evidence.timing_boundary != "" and evidence.warmup_count > 0 and
        evidence.sample_count >= 20 and evidence.backend != "" and
        evidence.backend != "software" and evidence.device_identity != "" and
        evidence.source_revision != "" and evidence.binary_hash != "" and
        evidence.p50_ns > 0 and evidence.p95_ns >= evidence.p50_ns and
        evidence.max_rss_bytes > 0 and evidence.upload_bytes >= 0 and
        evidence.timed_buffer_allocation_count == 0 and
        evidence.retained_buffer_bytes > 0 and
        evidence.teardown_released_bytes >= evidence.retained_buffer_bytes and
        evidence.timed_full_frame_upload_count == 0 and
        evidence.timed_readback_bytes == 0 and evidence.capture_count >= 0 and
        evidence.capture_count <= 1 and
        evidence.capture_readback_bytes >= 0 and
        (evidence.capture_count > 0 or evidence.capture_readback_bytes == 0) and
        (evidence.capture_count == 0 or
         evidence.capture_readback_bytes == evidence.width * evidence.height * 4) and
        evidence.fence_completion_count >= evidence.sample_count and
        evidence.completion_poll_count >= evidence.sample_count and
        evidence.cpu_completion_wait_count == 0 and
        (evidence.frame_ring_capacity == 2 or
         evidence.frame_ring_capacity == 3) and
        evidence.max_frames_in_flight >= 2 and
        evidence.max_frames_in_flight <= evidence.frame_ring_capacity and
        not evidence.unconditional_submit_wait and
        evidence.event_generation_count >= evidence.sample_count and
        evidence.damage_area_pixels >= 0 and
        evidence.damage_area_pixels <= evidence.width * evidence.height * evidence.sample_count and
        not evidence.fallback_used and evidence.device_execution_proven

fn gpu_render_benchmark_pair_admission_reason(
    left: GpuRenderBenchmarkEvidence,
    right: GpuRenderBenchmarkEvidence) -> text:
    if not gpu_render_benchmark_evidence_admitted(left):
        return "left-evidence-not-admitted"
    if not gpu_render_benchmark_evidence_admitted(right):
        return "right-evidence-not-admitted"
    if left.fixture_hash != right.fixture_hash:
        return "fixture-mismatch"
    if left.event_script_hash != right.event_script_hash:
        return "event-script-mismatch"
    if left.width != right.width or left.height != right.height:
        return "viewport-mismatch"
    if left.pixel_format != right.pixel_format:
        return "pixel-format-mismatch"
    if left.timing_boundary != right.timing_boundary:
        return "timing-boundary-mismatch"
    if left.warmup_count != right.warmup_count:
        return "warmup-count-mismatch"
    if left.sample_count != right.sample_count:
        return "sample-count-mismatch"
    if left.device_identity != right.device_identity:
        return "device-identity-mismatch"
    "admitted"

fn gpu_render_benchmark_pair_admitted(left: GpuRenderBenchmarkEvidence,
                                      right: GpuRenderBenchmarkEvidence
                                      ) -> bool:
    gpu_render_benchmark_pair_admission_reason(left, right) == "admitted"

export GpuRenderBenchmarkEvidence, gpu_render_benchmark_evidence_admitted,
    gpu_render_benchmark_pair_admission_reason,
    gpu_render_benchmark_pair_admitted
