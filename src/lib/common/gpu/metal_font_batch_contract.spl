"""Device-free submission accounting for ordered Metal font flush spans."""

fn metal_font_frame_span_contract(text_count: i64, command_count: i64,
                                  commit_count: i64, wait_count: i64,
                                  completed_spans: i64) -> bool:
    """Every completed text span owns exactly one command, commit and wait.

    A primitive, readback or glyph-cap boundary may split one frame into
    several ordered spans. A span contains at least one text batch; empty
    flushes do not create spans. Failed or unaccounted submissions cannot
    balance the three counters against successful spans.
    """
    (completed_spans > 0 and completed_spans <= text_count and
        command_count == completed_spans and commit_count == completed_spans and
        wait_count == completed_spans)

fn metal_font_frame_batch_contract(text_count: i64, command_count: i64,
                                   commit_count: i64, wait_count: i64) -> bool:
    """One uninterrupted span keeps the original one-command contract."""
    metal_font_frame_span_contract(text_count, command_count, commit_count, wait_count, 1)

export metal_font_frame_span_contract
export metal_font_frame_batch_contract
