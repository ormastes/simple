# Scalar kernel oracle (lane P0) — the AUTHORITATIVE 8-bit rendering
# reference. Contract: doc/04_architecture/ui/rendering/exact_8bit_pixel_formula.md
#
# This is descriptive, not aspirational: it encodes what the shipped path
# already computes (`blend()` in gc_async_mut/gpu/engine2d/color.spl:74-119,
# which nogc_sync_mut/gpu/engine2d/simd_kernels.spl:416-445 already matches),
# so parity can be proven against REAL existing output. In particular the
# division is truncating FLOOR, not round-half-up. See §0/§3 of the contract
# for why "improving" that would turn a parity test into a mass-diff.
#
# Every ISA provider is certified against these functions and against the
# canonical hashes in the spec. A provider is registered only if bit-exact.
#
# All channel arithmetic is done in i64 and cast on store. u32 shift/mask
# round-trips have produced wrong pixels in this tree before (the `as u32`
# fix in _scalar_fill_row); i64 intermediates avoid that class entirely.

# --- pixel field extraction (contract §1) -----------------------------------

fn oracle_alpha(c: i64) -> i64:
    """Alpha channel, 0..=255. ARGB layout: bits 24..31."""
    (c >> 24) & 0xFF

fn oracle_red(c: i64) -> i64:
    """Red channel, 0..=255. ARGB layout: bits 16..23."""
    (c >> 16) & 0xFF

fn oracle_green(c: i64) -> i64:
    """Green channel, 0..=255. ARGB layout: bits 8..15."""
    (c >> 8) & 0xFF

fn oracle_blue(c: i64) -> i64:
    """Blue channel, 0..=255. ARGB layout: bits 0..7."""
    c & 0xFF

fn oracle_pack(a: i64, r: i64, g: i64, b: i64) -> i64:
    """Pack ARGB channels into one pixel value."""
    ((a & 0xFF) << 24) | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF)

# --- the single blend definition (contract §2) ------------------------------

fn oracle_src_over(s: i64, d: i64) -> i64:
    """Porter-Duff src-over on straight alpha, composited in premultiplied
    space and unpremultiplied by the output alpha.

    Both fast paths are NORMATIVE, not optimizations. The `sa == 0` return is
    the divide-by-zero guard: out_a = sa + dst_weight >= sa, so out_a is only
    provably non-zero once sa == 0 has been excluded. Removing it as
    "redundant" introduces a division by zero.
    """
    val sa = oracle_alpha(s)
    if sa == 255:
        return s
    if sa == 0:
        return d

    val da = oracle_alpha(d)
    val inv_a = 255 - sa
    # dst's premultiplied contribution, on the same 0..255 basis as sa, reused
    # for the alpha accumulation and for every channel below.
    val dst_weight = (da * inv_a) / 255
    val out_a = sa + dst_weight

    val out_r = (oracle_red(s) * sa + oracle_red(d) * dst_weight) / out_a
    val out_g = (oracle_green(s) * sa + oracle_green(d) * dst_weight) / out_a
    val out_b = (oracle_blue(s) * sa + oracle_blue(d) * dst_weight) / out_a
    oracle_pack(out_a, out_r, out_g, out_b)

fn oracle_modulate_alpha(colour: i64, coverage: i64) -> i64:
    """Coverage-modulated source colour (contract §7). Coverage scales ALPHA
    only; RGB rides through untouched because alpha is straight, not
    premultiplied."""
    val a = (oracle_alpha(colour) * (coverage & 0xFF)) / 255
    oracle_pack(a, oracle_red(colour), oracle_green(colour), oracle_blue(colour))

# --- clipping (contract §8) -------------------------------------------------
#
# Returned as a packed pair so a caller cannot use a clipped count with an
# unclipped offset. Bit 32+ carries the offset, low 32 bits the count; both
# are non-negative after clipping so no sign handling is needed.

fn oracle_clip_pack(offset: i64, count: i64) -> i64:
    """Pack a clipped (offset, count) pair into one value."""
    (offset << 32) | (count & 0xFFFFFFFF)

fn oracle_clip_offset(packed: i64) -> i64:
    """Clipped offset from a packed clip result."""
    packed >> 32

fn oracle_clip_count(packed: i64) -> i64:
    """Clipped count from a packed clip result."""
    packed & 0xFFFFFFFF

fn oracle_clip_span(offset: i64, count: i64, capacity: i64) -> i64:
    """Intersect [offset, offset+count) with [0, capacity).

    Never wraps, never saturates an out-of-range offset into range: content
    that falls outside is DROPPED, not relocated.
    """
    if count <= 0 or capacity <= 0:
        return oracle_clip_pack(0, 0)
    var start: i64 = offset
    var n: i64 = count
    if start < 0:
        # Drop the head; the paired source must advance by the same delta or
        # the copy shears — that is what oracle_clip_span_pair is for.
        n = n + start
        start = 0
    if start >= capacity:
        return oracle_clip_pack(0, 0)
    if start + n > capacity:
        n = capacity - start
    if n <= 0:
        return oracle_clip_pack(0, 0)
    oracle_clip_pack(start, n)

fn oracle_clip_span_pair(dst_offset: i64, src_offset: i64, count: i64,
                         dst_capacity: i64, src_capacity: i64) -> i64:
    """Clip a dst/src span pair, advancing BOTH offsets by the same head delta.

    Clipping the two independently is the shear bug: dropping 3 pixels from the
    destination head without dropping 3 from the source head misaligns every
    remaining pixel. Returns the packed dst pair; the caller recovers the src
    offset with oracle_clip_paired_src.
    """
    if count <= 0 or dst_capacity <= 0 or src_capacity <= 0:
        return oracle_clip_pack(0, 0)
    var d: i64 = dst_offset
    var s: i64 = src_offset
    var n: i64 = count
    # Head clip: whichever side starts negative sets the delta for both.
    var head: i64 = 0
    if d < 0 and (0 - d) > head:
        head = 0 - d
    if s < 0 and (0 - s) > head:
        head = 0 - s
    if head > 0:
        d = d + head
        s = s + head
        n = n - head
    if n <= 0 or d >= dst_capacity or s >= src_capacity:
        return oracle_clip_pack(0, 0)
    # Tail clip: the tighter of the two capacities wins.
    if d + n > dst_capacity:
        n = dst_capacity - d
    if s + n > src_capacity:
        n = src_capacity - s
    if n <= 0:
        return oracle_clip_pack(0, 0)
    (d << 32) | (n & 0xFFFFFFFF)

fn oracle_clip_paired_src(src_offset: i64, dst_offset: i64, clipped_dst: i64) -> i64:
    """Source offset matching a clipped dst pair — src advanced by the same
    head delta the destination lost."""
    src_offset + (oracle_clip_offset(clipped_dst) - dst_offset)

# --- kernel set v1 (contract §5) --------------------------------------------

fn oracle_fill_const(mut dst: [u32], offset: i64, count: i64, colour: i64):
    """fill_const: a STORE, not a blend. Source alpha is written verbatim."""
    if count <= 0:
        return
    var i: i64 = 0
    while i < count:
        dst[(offset + i).to_i32()] = colour as u32
        i = i + 1

fn oracle_copy_span(mut dst: [u32], dst_offset: i64, src: [u32],
                    src_offset: i64, count: i64):
    """copy_span with MEMMOVE semantics (contract §6).

    Descending iteration when dst_offset > src_offset is required, not an
    optimization: ascending iteration corrupts a right-shifting scroll, which
    is precisely what scroll_rect will exercise.
    """
    if count <= 0:
        return
    if dst_offset > src_offset:
        var i: i64 = count - 1
        while i >= 0:
            dst[(dst_offset + i).to_i32()] = src[(src_offset + i).to_i32()]
            i = i - 1
        return
    var j: i64 = 0
    while j < count:
        dst[(dst_offset + j).to_i32()] = src[(src_offset + j).to_i32()]
        j = j + 1

fn oracle_src_over_const(mut dst: [u32], offset: i64, count: i64, colour: i64):
    """src_over_const: blend one constant colour over each destination pixel."""
    if count <= 0:
        return
    val sa = oracle_alpha(colour)
    if sa == 0:
        return
    var i: i64 = 0
    while i < count:
        val idx = (offset + i).to_i32()
        dst[idx] = oracle_src_over(colour, dst[idx] as i64) as u32
        i = i + 1

fn oracle_src_over_image(mut dst: [u32], dst_offset: i64, src: [u32],
                         src_offset: i64, count: i64):
    """src_over_image: blend src[i] over dst[i], pixel by pixel."""
    if count <= 0:
        return
    var i: i64 = 0
    while i < count:
        val d_idx = (dst_offset + i).to_i32()
        val s_idx = (src_offset + i).to_i32()
        dst[d_idx] = oracle_src_over(src[s_idx] as i64, dst[d_idx] as i64) as u32
        i = i + 1

fn oracle_mask_src_over(mut dst: [u32], dst_offset: i64, colour: i64,
                        mask: [u32], mask_offset: i64, count: i64):
    """mask_src_over: coverage-modulated constant colour (contract §7)."""
    if count <= 0:
        return
    var i: i64 = 0
    while i < count:
        val m = mask[(mask_offset + i).to_i32()] as i64
        if m > 0:
            val d_idx = (dst_offset + i).to_i32()
            val s = oracle_modulate_alpha(colour, m)
            dst[d_idx] = oracle_src_over(s, dst[d_idx] as i64) as u32
        i = i + 1

# --- canonical hashing ------------------------------------------------------
#
# FNV-1a over the pixel values (not their byte image), so the hash is
# endianness-independent for the same reason the formula is (contract §1).
# A future ISA provider proves bit-exactness by reproducing these.

fn oracle_hash_span(buf: [u32], offset: i64, count: i64) -> i64:
    """FNV-1a/64 over buf[offset..offset+count), masked to 48 bits.

    Masked because a full 64-bit accumulator round-trips through i64 sign
    territory in this tree; 48 bits is well beyond collision risk for these
    fixtures and stays comfortably positive.
    """
    var h: i64 = 0xCBF29CE484222325
    if count <= 0:
        return h & 0xFFFFFFFFFFFF
    var i: i64 = 0
    while i < count:
        val v = buf[(offset + i).to_i32()] as i64
        var byte_idx: i64 = 0
        while byte_idx < 4:
            h = (h ^ ((v >> (byte_idx * 8)) & 0xFF)) & 0xFFFFFFFFFFFF
            h = (h * 0x100000001B3) & 0xFFFFFFFFFFFF
            byte_idx = byte_idx + 1
        i = i + 1
    h & 0xFFFFFFFFFFFF

export oracle_alpha, oracle_red, oracle_green, oracle_blue, oracle_pack
export oracle_src_over, oracle_modulate_alpha
export oracle_clip_pack, oracle_clip_offset, oracle_clip_count
export oracle_clip_span, oracle_clip_span_pair, oracle_clip_paired_src
export oracle_fill_const, oracle_copy_span, oracle_src_over_const
export oracle_src_over_image, oracle_mask_src_over, oracle_hash_span
