# Pure parsing policy shared by hosted GPU VM lanes.

use std.common.string_core.{string_to_byte_array}

fn positive_vm_step_budget(raw: text, fallback: i64) -> i64:
    # Environment budgets need at most 19 decimal digits. Bound temporary
    # trim/byte storage so an oversized environment value cannot amplify RSS.
    if raw.len() > 64:
        return fallback
    val bytes = string_to_byte_array(raw.trim())
    if bytes.len() == 0:
        return fallback
    var value: i64 = 0
    var i: i64 = 0
    while i < bytes.len():
        val byte = bytes[i] as i64
        if byte < 48 or byte > 57:
            return fallback
        val digit = byte - 48
        if value > (9223372036854775807 - digit) / 10:
            return fallback
        value = value * 10 + digit
        i = i + 1
    if value > 0: value else: fallback
