# Common GPU device types shared across all tiers.

enum GpuBackend:
    Cuda
    Vulkan
    Rocm
    Oneapi
    Metal
    None_

impl GpuBackend:
    fn to_text() -> text:
        match self:
            case Cuda: "CUDA"
            case Vulkan: "Vulkan"
            case Rocm: "ROCm"
            case Oneapi: "oneAPI"
            case Metal: "Metal"
            case None_: "None"

class Gpu:
    backend: GpuBackend
    device_id: i64
    is_initialized: bool

impl Gpu:
    fn is_valid() -> bool:
        self.is_initialized

    fn sync() -> bool:
        true

fn gpu_cuda(device_id: i64) -> Gpu:
    Gpu(backend: GpuBackend.Cuda, device_id: device_id, is_initialized: true)

fn gpu_vulkan(device_id: i64) -> Gpu:
    Gpu(backend: GpuBackend.Vulkan, device_id: device_id, is_initialized: true)

fn gpu_rocm(device_id: i64) -> Gpu:
    Gpu(backend: GpuBackend.Rocm, device_id: device_id, is_initialized: true)

fn gpu_oneapi(device_id: i64) -> Gpu:
    Gpu(backend: GpuBackend.Oneapi, device_id: device_id, is_initialized: true)

fn gpu_metal(device_id: i64) -> Gpu:
    Gpu(backend: GpuBackend.Metal, device_id: device_id, is_initialized: true)

fn gpu_none() -> Gpu:
    Gpu(backend: GpuBackend.None_, device_id: -1, is_initialized: true)

fn preferred_graphics_backend() -> GpuBackend:
    GpuBackend.Vulkan

export GpuBackend, Gpu
export gpu_cuda, gpu_vulkan, gpu_rocm, gpu_oneapi, gpu_metal, gpu_none
export preferred_graphics_backend
