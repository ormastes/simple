# Scalar Vulkan font-owner fault contract shared by Engine2D and Engine3D.
# Owners record these values only after a real production failure path.

enum FontOwnerFaultReceipt:
    None_
    CorruptAsset
    CorruptProgram
    UnsupportedFormat
    CompileFailure
    SubmitFailure
    DeviceLoss
    Unknown

val FONT_OWNER_FAULT_NONE: i64 = 0
val FONT_OWNER_FAULT_CORRUPT_ASSET: i64 = 1
val FONT_OWNER_FAULT_CORRUPT_PROGRAM: i64 = 2
val FONT_OWNER_FAULT_UNSUPPORTED_FORMAT: i64 = 4
val FONT_OWNER_FAULT_COMPILE_FAILURE: i64 = 8
val FONT_OWNER_FAULT_SUBMIT_FAILURE: i64 = 16
val FONT_OWNER_FAULT_DEVICE_LOSS: i64 = 32
val FONT_OWNER_FAULT_UNKNOWN: i64 = -1

fn font_owner_fault_code_from_reason(reason: text) -> i64:
    if reason == "":
        FONT_OWNER_FAULT_NONE
    elif (reason == "invalid-font-atlas" or reason == "invalid-font-quad" or
          reason == "invalid-font-batch" or reason == "invalid-font-params" or
          reason == "incomplete-font-cache-identity"):
        FONT_OWNER_FAULT_CORRUPT_ASSET
    elif (reason == "font-pipeline-artifact-hash-mismatch" or
          reason == "font-pipeline-artifact-mismatch"):
        FONT_OWNER_FAULT_CORRUPT_PROGRAM
    elif (reason == "compile-artifact-too-large" or reason == "invalid-spirv" or
          reason == "font-pipeline-semantics-mismatch" or
          reason == "unsupported-font-program-version" or
          reason == "vulkan-font-unsupported-format" or
          reason == "invalid-destination"):
        FONT_OWNER_FAULT_UNSUPPORTED_FORMAT
    elif (reason == "compile-artifact-unavailable" or
          reason == "glsl-compiler-unavailable" or
          reason == "pipeline-create-failed" or
          reason == "vulkan-font-program-compile-failed"):
        FONT_OWNER_FAULT_COMPILE_FAILURE
    elif (reason == "submit-failed" or
          reason == "atlas-allocation-failed" or
          reason == "params-allocation-failed" or
          reason == "initial-device-readback-failed" or
          reason == "font-dispatch-failed" or
          reason == "missing-command-cleanup-capability" or
          reason == "descriptor-cleanup-failed" or
          reason == "fence-wait-evidence-failed" or
          reason == "fence-cleanup-failed" or
          reason == "partial-framebuffer-restore-failed" or
          reason == "device-readback-does-not-match-cpu-oracle" or
          reason == "atlas-cleanup-failed" or reason == "cleanup-failed" or
          reason == "graphics-command-recording-failed" or
          reason == "graphics-submission-still-in-flight" or
          reason == "fenced-submit-unavailable" or
          reason == "fence-completion-unknown" or
          reason == "vulkan-graphics-command-begin-failed" or
          reason == "vulkan-font-adapter-init-failed" or
          reason == "vulkan-font-target-create-failed" or
          reason == "vulkan-font-adapter-not-ready" or
          reason == "vulkan-font-frame-already-active" or
          reason == "vulkan-font-frame-inactive" or
          reason == "vulkan-font-framebuffer-unavailable" or
          reason == "vulkan-font-atlas-pending-conflict" or
          reason == "vulkan-font-atlas-allocation-failed" or
          reason == "vulkan-font-atlas-upload-failed" or
          reason == "vulkan-font-atlas-retire-failed" or
          reason == "vulkan-font-vertex-upload-failed" or
          reason == "vulkan-font-readback-failed"):
        FONT_OWNER_FAULT_SUBMIT_FAILURE
    elif reason == "device-lost":
        FONT_OWNER_FAULT_DEVICE_LOSS
    else:
        FONT_OWNER_FAULT_UNKNOWN

fn font_owner_fault_receipt_from_reason(reason: text) -> FontOwnerFaultReceipt:
    match font_owner_fault_code_from_reason(reason):
        0 => FontOwnerFaultReceipt.None_
        1 => FontOwnerFaultReceipt.CorruptAsset
        2 => FontOwnerFaultReceipt.CorruptProgram
        4 => FontOwnerFaultReceipt.UnsupportedFormat
        8 => FontOwnerFaultReceipt.CompileFailure
        16 => FontOwnerFaultReceipt.SubmitFailure
        32 => FontOwnerFaultReceipt.DeviceLoss
        _ => FontOwnerFaultReceipt.Unknown

fn font_owner_fault_receipt_observed(receipt: FontOwnerFaultReceipt) -> bool:
    receipt != FontOwnerFaultReceipt.None_ and receipt != FontOwnerFaultReceipt.Unknown

fn font_owner_fault_code_observed(code: i64) -> bool:
    code > 0

fn font_owner_fault_receipt_bit(receipt: FontOwnerFaultReceipt) -> i64:
    match receipt:
        FontOwnerFaultReceipt.CorruptAsset => 1
        FontOwnerFaultReceipt.CorruptProgram => 2
        FontOwnerFaultReceipt.UnsupportedFormat => 4
        FontOwnerFaultReceipt.CompileFailure => 8
        FontOwnerFaultReceipt.SubmitFailure => 16
        FontOwnerFaultReceipt.DeviceLoss => 32
        _ => 0

export FontOwnerFaultReceipt
export FONT_OWNER_FAULT_NONE, FONT_OWNER_FAULT_CORRUPT_ASSET
export FONT_OWNER_FAULT_CORRUPT_PROGRAM, FONT_OWNER_FAULT_UNSUPPORTED_FORMAT
export FONT_OWNER_FAULT_COMPILE_FAILURE, FONT_OWNER_FAULT_SUBMIT_FAILURE
export FONT_OWNER_FAULT_DEVICE_LOSS, FONT_OWNER_FAULT_UNKNOWN
export font_owner_fault_code_from_reason, font_owner_fault_code_observed
export font_owner_fault_receipt_from_reason
export font_owner_fault_receipt_observed, font_owner_fault_receipt_bit
