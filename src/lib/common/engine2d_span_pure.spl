# Pure-Simple scalar reference for the engine2d SIMD span kernels defined in
# src/runtime/runtime_simd_dispatch.c:
#   rt_engine2d_simd_fill_span_u32   (:1659)
#   rt_engine2d_simd_copy_span_u32   (:1702)
#   rt_engine2d_simd_blend_span_u32  (:2073)
#
# These are the reference implementations the vectorised C path must agree
# with. The C side dispatches to AVX2 / SSE2 / NEON / RVV kernels that process
# whole vectors and then handle a scalar tail; the classic defect class is a
# wrong tail bound or a wrong clamp when count runs past either array. This
# module is deliberately a straight scalar loop with the bounds arithmetic
# written out, so a divergence at a non-multiple-of-vector-width length is
# visible rather than absorbed.
#
# Bounds contract mirrored from the C `engine2d_span_bounds` helper and the
# interpreter bridge (interpreter_extern/simd.rs:1474,1499,1551): a negative
# offset, a non-positive count, or an offset at/past the array end is a no-op
# returning dst unchanged; otherwise count is clamped to what BOTH arrays can
# supply.
#
# Pixels are packed straight-alpha 0xAARRGGBB held in i64 lanes.

# Src-over blend of one packed straight-alpha pixel, truncating integer
# division throughout — bit-exact with `engine2d_blend_pixel_u32`
# (interpreter_extern/simd.rs:1528) and the C `engine2d_blend_pixel`.
pub fn blend_pixel_u32_pure(s: i64, d: i64) -> i64:
    val sv = s & 4294967295
    val dv = d & 4294967295
    val sa = (sv >> 24) & 255
    if sa == 255:
        return sv
    if sa == 0:
        return dv
    val da = (dv >> 24) & 255
    val inv = 255 - sa
    val dst_weight = da * inv / 255
    val out_alpha = sa + dst_weight
    if out_alpha == 0:
        return 0
    val r = (((sv >> 16) & 255) * sa + ((dv >> 16) & 255) * dst_weight) / out_alpha
    val g = (((sv >> 8) & 255) * sa + ((dv >> 8) & 255) * dst_weight) / out_alpha
    val b = ((sv & 255) * sa + (dv & 255) * dst_weight) / out_alpha
    return (out_alpha << 24) | (r << 16) | (g << 8) | b

# Fill dst[offset .. offset+count) with `color`, clamped to dst's extent.
pub fn fill_span_u32_pure(dst: [i64], offset: i64, count: i64, color: i64) -> [i64]:
    var out = dst
    val dlen = dst.len()
    if offset < 0 or count <= 0 or offset >= dlen:
        return out
    var n = count
    if n > dlen - offset:
        n = dlen - offset
    var i = 0
    while i < n:
        out[offset + i] = color
        i = i + 1
    return out

# Copy src[src_offset ..) into dst[dst_offset ..) for `count` lanes, clamped
# to whichever array runs out first.
pub fn copy_span_u32_pure(dst: [i64], dst_offset: i64, src: [i64], src_offset: i64, count: i64) -> [i64]:
    var out = dst
    val dlen = dst.len()
    val slen = src.len()
    if dst_offset < 0 or src_offset < 0 or count <= 0:
        return out
    if dst_offset >= dlen or src_offset >= slen:
        return out
    var n = count
    if n > dlen - dst_offset:
        n = dlen - dst_offset
    if n > slen - src_offset:
        n = slen - src_offset
    var i = 0
    while i < n:
        out[dst_offset + i] = src[src_offset + i]
        i = i + 1
    return out

# Src-over blend src over dst for `count` lanes, same clamping as copy.
pub fn blend_span_u32_pure(dst: [i64], dst_offset: i64, src: [i64], src_offset: i64, count: i64) -> [i64]:
    var out = dst
    val dlen = dst.len()
    val slen = src.len()
    if dst_offset < 0 or src_offset < 0 or count <= 0:
        return out
    if dst_offset >= dlen or src_offset >= slen:
        return out
    var n = count
    if n > dlen - dst_offset:
        n = dlen - dst_offset
    if n > slen - src_offset:
        n = slen - src_offset
    var i = 0
    while i < n:
        out[dst_offset + i] = blend_pixel_u32_pure(src[src_offset + i], out[dst_offset + i])
        i = i + 1
    return out
