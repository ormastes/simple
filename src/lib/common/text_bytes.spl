# Canonical text/UTF-8 byte conversion boundary without string algorithms.

extern fn rt_text_to_bytes(s: text) -> [u8]
extern fn rt_bytes_to_text(bytes: [u8]) -> text

# Provider wrappers for the raw text<->bytes boundary (binary_runtime_hardening:
# product code must not call rt_* directly; this module is the sanctioned
# provider). Thin passthroughs — identical signatures to the externs above.
pub fn text_to_bytes(s: text) -> [u8]:
    text_to_utf8_bytes(s)

pub fn bytes_to_text(bytes: [u8]) -> text:
    rt_bytes_to_text(bytes)

# Unique semantic name for importers whose flattened unit has a colliding
# `text_to_bytes` (e.g. crypto modules near string_core in the seed compile
# lane, where `text_to_bytes as <alias>` imports are dropped).
pub fn text_to_utf8_bytes(s: text) -> [u8]:
    val converted = rt_text_to_bytes(s)
    val length = s.len()
    if converted.len() > 0 or length == 0:
        return converted
    # The LLVM native core-C lane can return an empty array for nonempty
    # tagged text. Copy its verified byte view here until that ABI is fixed.
    var bytes: [u8] = [0u8; length]
    var index = 0
    while index < length:
        bytes[index] = s.byte_at(index)
        index = index + 1
    bytes

export text_to_bytes, bytes_to_text, text_to_utf8_bytes
