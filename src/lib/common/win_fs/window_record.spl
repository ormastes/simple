# Window Record — per-window metadata stored in the /win FS tree.
#
# Provides: WindowState, Rect, BufferRef, WindowRecord, window_mark_destroyed.

use std.common.privilege.id_path.{IdPath, id_path_intern, id_path_to_text}

enum WindowState:
    Normal
    Minimized
    Maximized
    Hidden
    Destroyed

struct Rect:
    x: i32
    y: i32
    w: u32
    h: u32

struct BufferRef:
    kind: text
    handle: u64
    bytes: u64

class WindowRecord:
    wid: u64
    generation: u32
    app: text
    title: text
    state: WindowState
    geometry: Rect
    buffer_ref: BufferRef
    acl_id_path: IdPath

    static fn new(wid: u64, app: text, title: text) -> WindowRecord:
        WindowRecord(
            wid: wid,
            generation: 1 as u32,
            app: app,
            title: title,
            state: WindowState.Normal,
            geometry: Rect(x: 0 as i32, y: 0 as i32, w: 0 as u32, h: 0 as u32),
            buffer_ref: BufferRef(kind: "none", handle: 0 as u64, bytes: 0 as u64),
            acl_id_path: id_path_intern("")
        )

fn window_update_title(rec: WindowRecord, title: text) -> WindowRecord:
    WindowRecord(
        wid: rec.wid,
        generation: rec.generation + 1,
        app: rec.app,
        title: title,
        state: rec.state,
        geometry: rec.geometry,
        buffer_ref: rec.buffer_ref,
        acl_id_path: rec.acl_id_path
    )

fn window_mark_destroyed(rec: WindowRecord) -> WindowRecord:
    WindowRecord(
        wid: rec.wid,
        generation: rec.generation,
        app: rec.app,
        title: rec.title,
        state: WindowState.Destroyed,
        geometry: rec.geometry,
        buffer_ref: rec.buffer_ref,
        acl_id_path: rec.acl_id_path
    )

fn _window_state_text(state: WindowState) -> text:
    match state:
        WindowState.Normal:    "normal"
        WindowState.Minimized: "minimized"
        WindowState.Maximized: "maximized"
        WindowState.Hidden:    "hidden"
        WindowState.Destroyed: "destroyed"

# Canonical byte encoding of a WindowRecord, used by SPM clients (e.g.
# `src/app/simple_process_manager/wm_spm_client.spl`) to serialize a record
# for the `win_register` request body. Was imported and called with zero
# definition anywhere in the tree (see
# doc/08_tracking/bug/win_fs_window_record_encode_gap_and_entries_field_2026-07-20.md).
fn window_record_encode(rec: WindowRecord) -> [u8]:
    val state_text = _window_state_text(rec.state)
    val acl_text = id_path_to_text(rec.acl_id_path)
    # SpmService reads the full `generation` key and uses `acl` for authorization.
    "wid={rec.wid};generation={rec.generation};app={rec.app};title={rec.title};acl={acl_text};state={state_text};x={rec.geometry.x};y={rec.geometry.y};w={rec.geometry.w};h={rec.geometry.h}".bytes()

# Display name of a WindowState. Restored after the tree wipe
# (tree_wipe_module_damage_census_2026-08-04); imported by
# src/os/kernel/fs/win_vfs/win_vfs_driver.spl.
fn window_state_name(s: WindowState) -> text:
    match s:
        WindowState.Hidden:    "Hidden"
        WindowState.Normal:    "Normal"
        WindowState.Minimized: "Minimized"
        WindowState.Maximized: "Maximized"
        WindowState.Destroyed: "Destroyed"
