# Zstd compressed-block encoder (RFC 8878 Block_Type=2).
#
# v1 scope: LZ77 match finder (hash chain over 4-byte minimum matches), Raw or
# RLE literals, and Sequences coded with Predefined_Mode FSE tables only.
# Offsets are always coded as `offset + 3` (never a repeat-offset code).
# No Huffman literal coding.  Tables are built per call and passed down.

use std.common.compress.zstd_types.{ZSTD_LL_DEFAULT_DISTRIBUTION, ZSTD_ML_DEFAULT_DISTRIBUTION, ZSTD_OF_DEFAULT_DISTRIBUTION}
use std.common.compress.zstd_seq.{_zstd_decode_literal_length, _zstd_literal_length_extra_bits, _zstd_decode_match_length, _zstd_match_length_extra_bits}

val ZENC_MIN_MATCH: i64 = 4
val ZENC_BLOCK_SIZE: i64 = 131072
val ZENC_LL_LOG: i64 = 6
val ZENC_ML_LOG: i64 = 6
val ZENC_OF_LOG: i64 = 5

struct ZstdFseEnc:
    log: i64
    state_table: [i64]
    delta_nb: [i64]
    delta_find: [i64]

struct ZstdEncTables:
    ll_fse: ZstdFseEnc
    ml_fse: ZstdFseEnc
    of_fse: ZstdFseEnc
    ll_base: [i64]
    ll_bits: [i64]
    ml_base: [i64]
    ml_bits: [i64]

struct ZstdEncSeqs:
    starts: [i64]
    lls: [i64]
    mls: [i64]
    offs: [i64]

fn _zenc_highbit(value: i64) -> i64:
    var probe = value
    var bits = 0
    while probe > 1:
        probe = probe >> 1
        bits = bits + 1
    bits

fn _zenc_fill(n: i64, v: i64) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < n:
        out.push(v)
        i = i + 1
    out

# FSE_buildCTable: same spread as the decoder (-1 symbols at the table end).
fn _zenc_fse_build(counts: [i64], log: i64) -> ZstdFseEnc:
    val size = 1 << log
    val nsym = counts.len()
    var symtab = _zenc_fill(size, 0)
    var high = size - 1
    var s = 0
    while s < nsym:
        if counts[s] == -1:
            symtab[high] = s
            high = high - 1
        s = s + 1
    val step = (size >> 1) + (size >> 3) + 3
    val mask = size - 1
    var pos = 0
    s = 0
    while s < nsym:
        val c = counts[s]
        if c > 0:
            var k = 0
            while k < c:
                symtab[pos] = s
                pos = (pos + step) & mask
                while pos > high:
                    pos = (pos + step) & mask
                k = k + 1
        s = s + 1
    var cumul: [i64] = [0]
    s = 0
    while s < nsym:
        val c = counts[s]
        val w = if c == -1: 1 else: c
        cumul.push(cumul[s] + w)
        s = s + 1
    var st = _zenc_fill(size, 0)
    var u = 0
    while u < size:
        val sym = symtab[u]
        st[cumul[sym]] = size + u
        cumul[sym] = cumul[sym] + 1
        u = u + 1
    var dn: [i64] = []
    var df: [i64] = []
    var total = 0
    s = 0
    while s < nsym:
        val c = counts[s]
        if c == 0:
            dn.push(((log + 1) << 16) - (1 << log))
            df.push(0)
        elif c == -1 or c == 1:
            dn.push((log << 16) - (1 << log))
            df.push(total - 1)
            total = total + 1
        else:
            val mbo = log - _zenc_highbit(c - 1)
            dn.push((mbo << 16) - (c << mbo))
            df.push(total - c)
            total = total + c
        s = s + 1
    ZstdFseEnc(log: log, state_table: st, delta_nb: dn, delta_find: df)

fn _zenc_fse_init_state(t: ZstdFseEnc, sym: i64) -> i64:
    val dn = t.delta_nb[sym]
    val nb = (dn + 32768) >> 16
    val value = (nb << 16) - dn
    t.state_table[(value >> nb) + t.delta_find[sym]]

fn _zenc_ll_base_table() -> [i64]:
    var out: [i64] = []
    var c = 0
    while c < 36:
        match _zstd_decode_literal_length(c, 0):
            case Ok(v): out.push(v)
            case Err(_): out.push(0)
        c = c + 1
    out

fn _zenc_ll_bits_table() -> [i64]:
    var out: [i64] = []
    var c = 0
    while c < 36:
        match _zstd_literal_length_extra_bits(c):
            case Ok(v): out.push(v)
            case Err(_): out.push(0)
        c = c + 1
    out

fn _zenc_ml_base_table() -> [i64]:
    var out: [i64] = []
    var c = 0
    while c < 53:
        match _zstd_decode_match_length(c, 0):
            case Ok(v): out.push(v)
            case Err(_): out.push(0)
        c = c + 1
    out

fn _zenc_ml_bits_table() -> [i64]:
    var out: [i64] = []
    var c = 0
    while c < 53:
        match _zstd_match_length_extra_bits(c):
            case Ok(v): out.push(v)
            case Err(_): out.push(0)
        c = c + 1
    out

pub fn zstd_enc_tables() -> ZstdEncTables:
    ZstdEncTables(
        ll_fse: _zenc_fse_build(ZSTD_LL_DEFAULT_DISTRIBUTION, ZENC_LL_LOG),
        ml_fse: _zenc_fse_build(ZSTD_ML_DEFAULT_DISTRIBUTION, ZENC_ML_LOG),
        of_fse: _zenc_fse_build(ZSTD_OF_DEFAULT_DISTRIBUTION, ZENC_OF_LOG),
        ll_base: _zenc_ll_base_table(),
        ll_bits: _zenc_ll_bits_table(),
        ml_base: _zenc_ml_base_table(),
        ml_bits: _zenc_ml_bits_table()
    )

# Largest code whose baseline is <= value.
fn _zenc_code_for(base: [i64], value: i64, direct_below: i64, direct_add: i64) -> i64:
    if value < direct_below:
        return value - direct_add
    var c = base.len() - 1
    while c > 0 and base[c] > value:
        c = c - 1
    c

fn _zenc_hash(data: [u8], p: i64, bits: i64) -> i64:
    val v = (data[p] as i64) | ((data[p + 1] as i64) << 8) | ((data[p + 2] as i64) << 16) | ((data[p + 3] as i64) << 24)
    val x = v * 65599
    (x ^ (x >> 17)) & ((1 << bits) - 1)

fn _zenc_depth_for_level(level: i64) -> i64:
    if level <= 1:
        return 1
    if level == 2:
        return 4
    if level <= 5:
        return 8
    if level <= 9:
        return 16
    if level <= 18:
        return 32
    64

fn _zenc_hash_bits_for(n: i64, level: i64) -> i64:
    var cap = 16
    if level <= 1:
        cap = 14
    var bits = 8
    while bits < cap and (1 << bits) < n:
        bits = bits + 1
    bits

# LZ77 pass over the whole input.  Matches never cross a 128 KiB block end;
# history (the hash chains) does span blocks.  Offsets never exceed position,
# so they are always within a single-segment Window_Size == content size.
pub fn zstd_enc_find_sequences(data: [u8], level: i64) -> ZstdEncSeqs:
    val n = data.len()
    var starts: [i64] = []
    var lls: [i64] = []
    var mls: [i64] = []
    var offs: [i64] = []
    if n < 8:
        return ZstdEncSeqs(starts: starts, lls: lls, mls: mls, offs: offs)
    val depth = _zenc_depth_for_level(level)
    val hbits = _zenc_hash_bits_for(n, level)
    var head = _zenc_fill(1 << hbits, -1)
    var prev: [i64] = []
    if depth > 1:
        prev = _zenc_fill(n, -1)
    var bs = 0
    while bs < n:
        var be = bs + ZENC_BLOCK_SIZE
        if be > n:
            be = n
        var anchor = bs
        var i = bs
        while i + ZENC_MIN_MATCH <= be:
            val h = _zenc_hash(data, i, hbits)
            var best_len = 0
            var best_off = 0
            var cand = head[h]
            var d = depth
            val maxlen = be - i
            while cand >= 0 and d > 0:
                if best_len == 0 or data[cand + best_len] == data[i + best_len]:
                    var l = 0
                    while l < maxlen and data[cand + l] == data[i + l]:
                        l = l + 1
                    if l > best_len:
                        best_len = l
                        best_off = i - cand
                        if l >= maxlen:
                            d = 0
                if depth > 1:
                    cand = prev[cand]
                else:
                    cand = -1
                d = d - 1
            if best_len >= ZENC_MIN_MATCH and not (best_len == ZENC_MIN_MATCH and best_off >= 65536):
                starts.push(anchor)
                lls.push(i - anchor)
                mls.push(best_len)
                offs.push(best_off)
                val mend = i + best_len
                var p = i
                if depth > 1:
                    while p < mend and p + ZENC_MIN_MATCH <= n:
                        val hp = _zenc_hash(data, p, hbits)
                        prev[p] = head[hp]
                        head[hp] = p
                        p = p + 1
                else:
                    head[h] = i
                    val q = mend - 2
                    if q > i and q + ZENC_MIN_MATCH <= n:
                        head[_zenc_hash(data, q, hbits)] = q
                i = mend
                anchor = i
            else:
                if depth > 1:
                    prev[i] = head[h]
                head[h] = i
                i = i + 1
        bs = be
    ZstdEncSeqs(starts: starts, lls: lls, mls: mls, offs: offs)

# Pack (value, nbits) pairs, written first-to-last, into the backward bitstream
# with the trailing 1-bit end marker.
fn _zenc_pack(vals: [i64], nbs: [i64]) -> [u8]:
    var out: [u8] = []
    var acc = 0
    var nb = 0
    var i = 0
    while i < vals.len():
        val n = nbs[i]
        if n > 0:
            acc = acc | ((vals[i] & ((1 << n) - 1)) << nb)
            nb = nb + n
            while nb >= 8:
                out.push((acc & 255) as u8)
                acc = acc >> 8
                nb = nb - 8
        i = i + 1
    acc = acc | (1 << nb)
    nb = nb + 1
    while nb > 0:
        out.push((acc & 255) as u8)
        acc = acc >> 8
        nb = nb - 8
    out

fn _zenc_encode_sequences(seqs: ZstdEncSeqs, a: i64, b: i64, t: ZstdEncTables) -> [u8]:
    var vals: [i64] = []
    var nbs: [i64] = []
    val last = b - 1
    var llc = _zenc_code_for(t.ll_base, seqs.lls[last], 16, 0)
    var mlc = _zenc_code_for(t.ml_base, seqs.mls[last], 35, 3)
    var ofv = seqs.offs[last] + 3
    var ofc = _zenc_highbit(ofv)
    var st_ml = _zenc_fse_init_state(t.ml_fse, mlc)
    var st_of = _zenc_fse_init_state(t.of_fse, ofc)
    var st_ll = _zenc_fse_init_state(t.ll_fse, llc)
    vals.push(seqs.lls[last] - t.ll_base[llc])
    nbs.push(t.ll_bits[llc])
    vals.push(seqs.mls[last] - t.ml_base[mlc])
    nbs.push(t.ml_bits[mlc])
    vals.push(ofv - (1 << ofc))
    nbs.push(ofc)
    var j = last - 1
    while j >= a:
        llc = _zenc_code_for(t.ll_base, seqs.lls[j], 16, 0)
        mlc = _zenc_code_for(t.ml_base, seqs.mls[j], 35, 3)
        ofv = seqs.offs[j] + 3
        ofc = _zenc_highbit(ofv)
        # OF, ML, LL symbol transitions
        var nbo = (st_of + t.of_fse.delta_nb[ofc]) >> 16
        vals.push(st_of)
        nbs.push(nbo)
        st_of = t.of_fse.state_table[(st_of >> nbo) + t.of_fse.delta_find[ofc]]
        var nbm = (st_ml + t.ml_fse.delta_nb[mlc]) >> 16
        vals.push(st_ml)
        nbs.push(nbm)
        st_ml = t.ml_fse.state_table[(st_ml >> nbm) + t.ml_fse.delta_find[mlc]]
        var nbl = (st_ll + t.ll_fse.delta_nb[llc]) >> 16
        vals.push(st_ll)
        nbs.push(nbl)
        st_ll = t.ll_fse.state_table[(st_ll >> nbl) + t.ll_fse.delta_find[llc]]
        vals.push(seqs.lls[j] - t.ll_base[llc])
        nbs.push(t.ll_bits[llc])
        vals.push(seqs.mls[j] - t.ml_base[mlc])
        nbs.push(t.ml_bits[mlc])
        vals.push(ofv - (1 << ofc))
        nbs.push(ofc)
        j = j - 1
    vals.push(st_ml)
    nbs.push(ZENC_ML_LOG)
    vals.push(st_of)
    nbs.push(ZENC_OF_LOG)
    vals.push(st_ll)
    nbs.push(ZENC_LL_LOG)
    _zenc_pack(vals, nbs)

fn _zenc_literals_header(size: i64, lit_type: i64) -> [u8]:
    var out: [u8] = []
    if size <= 31:
        out.push((lit_type | (size << 3)) as u8)
    elif size <= 4095:
        val v = lit_type | (1 << 2) | (size << 4)
        out.push((v & 255) as u8)
        out.push(((v >> 8) & 255) as u8)
    else:
        val v = lit_type | (3 << 2) | (size << 4)
        out.push((v & 255) as u8)
        out.push(((v >> 8) & 255) as u8)
        out.push(((v >> 16) & 255) as u8)
    out

# Encode data[bs..be) as Compressed_Block content using sequences a..b of `seqs`.
# Returns [] when the caller should use a Raw/RLE block instead.
pub fn zstd_enc_block(data: [u8], bs: i64, be: i64, seqs: ZstdEncSeqs, a: i64, b: i64, t: ZstdEncTables) -> [u8]:
    if b <= a:
        return []
    var lits: [u8] = []
    var pos = bs
    var j = a
    while j < b:
        var k = 0
        val ll = seqs.lls[j]
        while k < ll:
            lits.push(data[pos + k])
            k = k + 1
        pos = pos + ll + seqs.mls[j]
        j = j + 1
    while pos < be:
        lits.push(data[pos])
        pos = pos + 1
    var out: [u8] = []
    var all_same = lits.len() >= 2
    var q = 1
    while all_same and q < lits.len():
        if lits[q] != lits[0]:
            all_same = false
        q = q + 1
    if all_same:
        val hdr = _zenc_literals_header(lits.len(), 1)
        var h = 0
        while h < hdr.len():
            out.push(hdr[h])
            h = h + 1
        out.push(lits[0])
    else:
        val hdr = _zenc_literals_header(lits.len(), 0)
        var h = 0
        while h < hdr.len():
            out.push(hdr[h])
            h = h + 1
        var x = 0
        while x < lits.len():
            out.push(lits[x])
            x = x + 1
    val nseq = b - a
    if nseq < 128:
        out.push(nseq as u8)
    elif nseq < 32512:
        out.push(((nseq >> 8) + 128) as u8)
        out.push((nseq & 255) as u8)
    else:
        val r = nseq - 32512
        out.push(255u8)
        out.push((r & 255) as u8)
        out.push(((r >> 8) & 255) as u8)
    out.push(0u8)
    val bits = _zenc_encode_sequences(seqs, a, b, t)
    var y = 0
    while y < bits.len():
        out.push(bits[y])
        y = y + 1
    out
