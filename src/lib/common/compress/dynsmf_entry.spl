# dynsmf_entry.spl — background-lane entry module for the compress bundle.
#
# Re-exports the primary compress / decompress entry point of each codec so a
# background-built SMF bundle can import a single module. crc32 and xxhash
# (compress dependencies) stay static.
#
# Module id: compress

export use std.common.compress.zstd.{zstd_compress_frame, zstd_decompress_frame}
export use std.common.compress.lz4.{lz4_compress_frame, lz4_decompress_frame}
export use std.common.compress.deflate.{deflate_compress, deflate_decompress}
export use std.common.compress.gzip.{gzip_compress, gzip_decompress}
export use std.common.compress.snappy.{snappy_compress, snappy_decompress}
export use std.common.compress.brotli.{brotli_compress, brotli_decompress}
export use std.common.compress.lzma2.{lzma2_compress_xz, lzma2_decompress_xz}
export use std.common.compress.zstd_dyn_abi.{simple_dyn_zstd_compress_frame_v1, simple_dyn_zstd_decompress_frame_v1}

fn compress_lib_ready() -> bool:
    true

export compress_lib_ready
