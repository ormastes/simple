"""Dynamic-first, static-fallback zstd facade.

`addr` is the resolved address of the matching shim in a loaded `compress`
component (see `os.smf.dynsmf_session.dynsmf_session_symbol_address` with
`simple_dyn_zstd_compress_frame_v1` / `simple_dyn_zstd_decompress_frame_v1`).
`addr == 0` (component absent) or a failed dynamic call runs the static codec.
"""

use os.posix.dynlib_sffi.{call_bytes_fn_v1}
use std.common.compress.types.{CompressionError}
use std.common.compress.zstd.{zstd_compress_frame, zstd_decompress_frame}
use std.common.compress.zstd_dyn_abi.{zstd_dyn_default_options}
use std.nogc_sync_mut.sffi.dyn_bytes_abi.{DYN_BYTES_ABI_MAX_LEN}

fn zstd_compress_frame_dyn(addr: i64, data: [u8]) -> [u8]:
    if addr != 0:
        val call = call_bytes_fn_v1(addr, data, data.len() + 64)
        if call.ok:
            return call.bytes
    zstd_compress_frame(data, zstd_dyn_default_options())

fn zstd_decompress_frame_dyn(addr: i64, data: [u8]) -> Result<[u8], CompressionError>:
    if addr != 0:
        # Initial guess only: a callee needing more reports the size and the
        # wrapper retries once, still bounded by DYN_BYTES_ABI_MAX_LEN.
        val guess = data.len() * 4 + 64
        val call = call_bytes_fn_v1(addr, data, if guess > DYN_BYTES_ABI_MAX_LEN: DYN_BYTES_ABI_MAX_LEN else: guess)
        if call.ok:
            return Ok(call.bytes)
    zstd_decompress_frame(data)

export zstd_compress_frame_dyn, zstd_decompress_frame_dyn
