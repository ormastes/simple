# C-MIG-0042: pure-Simple int-array repeat.
#
# Reimplements the array construction performed by the C-backed extern
# `rt_array_repeat` (src/runtime/runtime_native.c:6824, backing the
# `[value; count]` JIT/native array-repeat syntax), but via a plain
# append loop rather than the C side's fill-then-doubling-memcpy
# strategy (`data[0] = value; ... memcpy(data+filled, data, chunk)`).
# Genuinely different machinery: no doubling copy, just a straight
# linear push loop.

fn repeat_int_pure(value: i64, count: i64) -> [i64]:
    var out: [i64] = []
    var n = count
    if n < 0:
        n = 0
    var i = 0
    while i < n:
        out.push(value)
        i = i + 1
    return out
