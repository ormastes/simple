# mod.spl — Unified 2D interaction core (Phase 1 of
# doc/03_plan/ui/unified_2d_engine/unified_2d_interaction_2026-07-20.md):
# ordered hit stack, capture/target/bubble event routing, pointer capture,
# and PointerPolicy, shared by GUI widgets, the browser DOM and
# Engine2D/game nodes so paint order == hit order and every surface
# dispatches through one contract. Widget/browser/WM adapters are a LATER
# lane (slice item 6) -- this package ships only the surface-agnostic
# primitives.
#
# Usage:
#   use std.common.engine.interaction.{PointerEvent2D, HitProxy2D,
#     hit_stack, EventListener2D, dispatch, PointerRouter, hover_diff}
# or per-file, e.g.:
#   use std.common.engine.interaction.hit_test.{hit_stack, HitTestResult}

export use pointer_event.{POINTER_DOWN, POINTER_UP, POINTER_MOVE, POINTER_ENTER, POINTER_LEAVE, POINTER_OVER, POINTER_OUT, POINTER_CANCEL, POINTER_WHEEL, PHASE_NONE, PHASE_CAPTURE, PHASE_TARGET, PHASE_BUBBLE, PointerEvent2D}
export use hit_proxy.{POINTER_POLICY_AUTO, POINTER_POLICY_NONE, POINTER_POLICY_BOUNDING_BOX, POINTER_POLICY_PAINTED, POINTER_POLICY_FILL, POINTER_POLICY_STROKE, POINTER_POLICY_SELF_ONLY, POINTER_POLICY_CHILDREN_ONLY, POINTER_POLICY_TRANSLUCENT, HitProxy2D, paint_key_less}
export use hit_test.{HitRecord, HitTestResult, ancestor_path_of, hit_stack, HIT_TEST_ROUTE_OK, HIT_TEST_ROUTE_REFUSE_NO_HIT, HIT_TEST_ROUTE_REFUSE_STALE_GENERATION, HitTestRouteResult, hit_stack_validated}
export use event_route.{ACTION_NONE, ACTION_STOP_PROPAGATION, ACTION_STOP_IMMEDIATE, ACTION_PREVENT_DEFAULT, EventListener2D, DispatchOutcome, dispatch}
export use pointer_capture.{PointerRouter, effective_target, HoverDiff, hover_diff}
