# codex-impl
# Pure-Simple bounded guest driver logic for QEMU remote CUDA audio work.

struct SimpleAudioRemoteWork:
    generation: u64
    sequence: u64
    correlation_id: u64
    period_index: u64
    deadline_ns: u64
    frames: i64
    channels: i64
    kernel_frames: i64
    operation: text
    cpu_checksum: i64

struct SimpleAudioRemoteReceipt:
    generation: u64
    correlation_id: u64
    service_elapsed_ns: u64
    provider: text
    native_handle: i64
    device_identity: i64
    readback_checksum: i64
    normalized_error_millionths: i64
    status: text

class SimpleAudioRemoteRing:
    capacity: i64
    states: [text]
    generations: [u64]
    works: [SimpleAudioRemoteWork]
    receipts: [SimpleAudioRemoteReceipt]
    next_sequence: u64
    live_count: i64
    closed: bool

impl SimpleAudioRemoteRing:
    static fn create(requested_capacity: i64) -> SimpleAudioRemoteRing:
        var capacity = requested_capacity
        if capacity < 2:
            capacity = 2
        if capacity > 64:
            capacity = 64
        var states: [text] = []
        var generations: [u64] = []
        var works: [SimpleAudioRemoteWork] = []
        var receipts: [SimpleAudioRemoteReceipt] = []
        var i = 0
        while i < capacity:
            states.push("free")
            generations.push(1u64)
            works.push(SimpleAudioRemoteWork(generation: 0u64, sequence: 0u64, correlation_id: 0u64, period_index: 0u64, deadline_ns: 0u64, frames: 0, channels: 0, kernel_frames: 0, operation: "", cpu_checksum: 0))
            receipts.push(SimpleAudioRemoteReceipt(generation: 0u64, correlation_id: 0u64, service_elapsed_ns: 0u64, provider: "", native_handle: 0, device_identity: 0, readback_checksum: 0, normalized_error_millionths: 0, status: "empty"))
            i = i + 1
        SimpleAudioRemoteRing(capacity: capacity, states: states, generations: generations, works: works, receipts: receipts, next_sequence: 1u64, live_count: 0, closed: false)

    fn valid_slot(slot: i64) -> bool:
        slot >= 0 and slot < self.capacity

    me publish(slot: i64, correlation_id: u64, period_index: u64, period_started_ns: u64, period_duration_ns: u64, frames: i64, channels: i64, kernel_frames: i64, operation: text, cpu_checksum: i64) -> text:
        if self.closed:
            return "shutdown"
        if not self.valid_slot(slot):
            return "invalid-slot"
        if self.states[slot] != "free":
            return "queue-full"
        if correlation_id == 0u64 or period_duration_ns < 10u64 or frames <= 0 or channels <= 0 or kernel_frames <= 0:
            return "invalid-work"
        if operation != "partitioned-convolution" and operation != "hrtf-bank":
            return "unsupported-operation"
        val generation = self.generations[slot]
        val deadline = period_started_ns + (period_duration_ns * 3u64) / 5u64
        self.works[slot] = SimpleAudioRemoteWork(generation: generation, sequence: self.next_sequence, correlation_id: correlation_id, period_index: period_index, deadline_ns: deadline, frames: frames, channels: channels, kernel_frames: kernel_frames, operation: operation, cpu_checksum: cpu_checksum)
        self.states[slot] = "published"
        self.next_sequence = self.next_sequence + 1u64
        self.live_count = self.live_count + 1
        "published"

    me claim(slot: i64, generation: u64) -> text:
        if not self.valid_slot(slot):
            return "invalid-slot"
        if self.generations[slot] != generation:
            return "stale-generation"
        if self.states[slot] != "published":
            return "invalid-state"
        self.states[slot] = "processing"
        "claimed"

    me complete(slot: i64, receipt: SimpleAudioRemoteReceipt) -> text:
        if not self.valid_slot(slot):
            return "invalid-slot"
        val work = self.works[slot]
        if receipt.generation != work.generation or receipt.correlation_id != work.correlation_id:
            return "correlation-mismatch"
        if self.states[slot] != "processing":
            return "invalid-state"
        self.receipts[slot] = receipt
        self.states[slot] = "completed"
        "completed"

    me poll(slot: i64, generation: u64, now_ns: u64) -> text:
        if not self.valid_slot(slot):
            return "invalid-slot"
        if self.generations[slot] != generation:
            return "stale-generation"
        val work = self.works[slot]
        if now_ns > work.deadline_ns and self.states[slot] != "completed":
            return "cpu-fallback-timeout"
        if self.states[slot] != "completed":
            return "pending"
        val receipt = self.receipts[slot]
        # The host service clock has a different epoch. Use only the guest
        # observation clock for deadline admission; service_elapsed_ns is
        # diagnostic/performance evidence.
        if now_ns > work.deadline_ns:
            return "cpu-fallback-late"
        if receipt.service_elapsed_ns == 0u64:
            return "cpu-fallback-timing"
        if receipt.provider != "remote-host-cuda" or receipt.native_handle <= 0 or receipt.device_identity <= 0:
            return "cpu-fallback-provenance"
        if receipt.status != "device-readback" or receipt.readback_checksum == 0:
            return "cpu-fallback-readback"
        if receipt.normalized_error_millionths < 0 or receipt.normalized_error_millionths > 10:
            return "cpu-fallback-parity"
        "accepted-device-result"

    me release(slot: i64, generation: u64) -> text:
        if not self.valid_slot(slot):
            return "invalid-slot"
        if self.generations[slot] != generation:
            return "stale-generation"
        if self.states[slot] == "free":
            return "invalid-state"
        self.states[slot] = "free"
        self.generations[slot] = generation + 1u64
        self.live_count = self.live_count - 1
        "released"

    me shutdown() -> i64:
        var cancelled = 0
        var i = 0
        while i < self.capacity:
            if self.states[i] != "free":
                cancelled = cancelled + 1
                self.states[i] = "free"
                self.generations[i] = self.generations[i] + 1u64
            i = i + 1
        self.live_count = 0
        self.closed = true
        cancelled
