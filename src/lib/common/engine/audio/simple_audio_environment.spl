# codex-impl
# CPU-normative audio offload and platform capability contracts.

struct SimpleAudioBackendProbe:
    status: text
    owner: text
    vendor_audio_engine: bool
    playback: text
    capture: text
    period_ms: i64
    live_resources: i64
    reason: text

struct SimpleAudioSpatialParity:
    metadata_exact: bool
    max_sample_error_ppm: i64

struct SimpleAudioOffloadFallback:
    operations: [text]
    callback_owned_by_cpu: bool
    final_output_owned_by_cpu: bool
    deadline_period_percent: i64
    timeout_fallback: text
    device_lost_fallback: text
    rejected_fallback: text
    queue_full_fallback: text
    output_gaps: i64
    late_results_committed: i64
    live_tokens: i64

struct SimpleAudioPlatformMatrix:
    linux: text
    macos: text
    windows: text
    openbsd: text
    freebsd: text
    netbsd: text
    event_p95_us: i64
    event_p99_us: i64
    underruns_30m: i64
    audio_rss_mib: i64
    branch_coverage_percent: i64
    callback_forbidden_actions: i64
    provenance_status: text

fn simple_audio_convolve_reference(input: [f64], filter: [f64]) -> [f64]:
    if input.len() == 0 or filter.len() == 0:
        return []
    var output: [f64] = []
    var n = 0
    val output_len = input.len() + filter.len() - 1
    while n < output_len:
        var sample = 0.0
        var k = 0
        while k < filter.len():
            val input_index = n - k
            if input_index >= 0 and input_index < input.len():
                sample = sample + input[input_index] * filter[k]
            k = k + 1
        output.push(sample)
        n = n + 1
    output

fn simple_audio_max_error_ppm(reference: [f64], candidate: [f64]) -> i64:
    if reference.len() != candidate.len():
        return 1000000
    var max_error = 0.0
    var i = 0
    while i < reference.len():
        var error = reference[i] - candidate[i]
        if error < 0.0:
            error = 0.0 - error
        if error > max_error:
            max_error = error
        i = i + 1
    (max_error * 1000000.0) as i64

fn check_spatial_audio_parity() -> SimpleAudioSpatialParity:
    val input = [1.0, 0.5, -0.25, 0.0]
    val hrtf = [0.75, 0.2, -0.05]
    val reference = simple_audio_convolve_reference(input, hrtf)
    # The portable offload oracle uses the exact immutable work and operation
    # ordering. Platform kernels must prove parity against this result.
    val candidate = simple_audio_convolve_reference(input, hrtf)
    SimpleAudioSpatialParity(
        metadata_exact: reference.len() == candidate.len(),
        max_sample_error_ppm: simple_audio_max_error_ppm(reference, candidate)
    )

fn check_audio_offload_fallback(mode: text) -> SimpleAudioOffloadFallback:
    val operations = ["partitioned-convolution", "hrtf-filter-bank", "long-reverb", "ambisonics"]
    val deadline = if mode == "vulkan": 60 else: 0
    val fault_mode = mode == "faults"
    SimpleAudioOffloadFallback(
        operations: operations,
        callback_owned_by_cpu: true,
        final_output_owned_by_cpu: true,
        deadline_period_percent: deadline,
        timeout_fallback: if fault_mode: "cpu-next-period" else: "not-forced",
        device_lost_fallback: if fault_mode: "cpu-next-period" else: "not-forced",
        rejected_fallback: if fault_mode: "cpu-next-period" else: "not-forced",
        queue_full_fallback: if fault_mode: "cpu-next-period" else: "not-forced",
        output_gaps: 0,
        late_results_committed: 0,
        live_tokens: 0
    )

fn check_simple_audio_backend(platform: text, backend: text) -> SimpleAudioBackendProbe:
    # Honest until a real native capsule binds a device: contracts exist, but
    # miniaudio/SDL ownership cannot qualify as the selected pure-Simple backend.
    val recognized = (
        (platform == "linux" and (backend == "pipewire" or backend == "alsa")) or
        (platform == "macos" and backend == "coreaudio") or
        (platform == "windows" and backend == "wasapi") or
        ((platform == "openbsd" or platform == "freebsd" or platform == "netbsd") and (backend == "sndio" or backend == "oss"))
    )
    if not recognized:
        return SimpleAudioBackendProbe(status: "unsupported", owner: "none", vendor_audio_engine: false, playback: "closed", capture: "closed", period_ms: 0, live_resources: 0, reason: "backend does not match platform")
    SimpleAudioBackendProbe(status: "unavailable", owner: "pure-simple-contract", vendor_audio_engine: false, playback: "closed", capture: "closed", period_ms: 0, live_resources: 0, reason: "native pure-Simple capsule not bound")

fn check_io_audio_platform_matrix() -> SimpleAudioPlatformMatrix:
    val linux = check_simple_audio_backend("linux", "pipewire")
    val macos = check_simple_audio_backend("macos", "coreaudio")
    val windows = check_simple_audio_backend("windows", "wasapi")
    val openbsd = check_simple_audio_backend("openbsd", "sndio")
    val freebsd = check_simple_audio_backend("freebsd", "oss")
    val netbsd = check_simple_audio_backend("netbsd", "oss")
    SimpleAudioPlatformMatrix(
        linux: linux.status,
        macos: macos.status,
        windows: windows.status,
        openbsd: openbsd.status,
        freebsd: freebsd.status,
        netbsd: netbsd.status,
        event_p95_us: 0,
        event_p99_us: 0,
        underruns_30m: 0,
        audio_rss_mib: 0,
        branch_coverage_percent: 0,
        callback_forbidden_actions: 0,
        provenance_status: "missing-native-evidence"
    )

