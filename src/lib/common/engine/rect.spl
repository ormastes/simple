# Engine Rectangle Type
#
# Rect2: axis-aligned 2D rectangle defined by origin (x, y) plus dimensions (width, height).

pub class Rect2:
    """Axis-aligned 2D rectangle."""
    x: f64
    y: f64
    width: f64
    height: f64

    static fn zero() -> Rect2:
        Rect2(x: 0.0, y: 0.0, width: 0.0, height: 0.0)

    static fn new(x: f64, y: f64, width: f64, height: f64) -> Rect2:
        Rect2(x: x, y: y, width: width, height: height)

    static fn from_center(cx: f64, cy: f64, width: f64, height: f64) -> Rect2:
        Rect2(x: cx - width / 2.0, y: cy - height / 2.0, width: width, height: height)

impl Rect2:
    fn left() -> f64:
        self.x

    fn top() -> f64:
        self.y

    fn right() -> f64:
        self.x + self.width

    fn merge(other: Rect2) -> Rect2:
        """Smallest rect containing both self and other."""
        val nx = if self.x < other.x: self.x else: other.x
        val ny = if self.y < other.y: self.y else: other.y
        val nr = if self.right() > other.right(): self.right() else: other.right()
        val nb = if self.bottom() > other.bottom(): self.bottom() else: other.bottom()
        Rect2(x: nx, y: ny, width: nr - nx, height: nb - ny)

    fn expand(margin: f64) -> Rect2:
        Rect2(x: self.x - margin, y: self.y - margin, width: self.width + margin * 2.0, height: self.height + margin * 2.0)

    fn bottom() -> f64:
        self.y + self.height

    fn contains_point(px: f64, py: f64) -> bool:
        px >= self.x and px < self.right() and py >= self.y and py < self.bottom()

    fn intersects(other: Rect2) -> bool:
        not (other.x >= self.right() or
             other.right() <= self.x or
             other.y >= self.bottom() or
             other.bottom() <= self.y)

    fn is_empty() -> bool:
        self.width <= 0.0 or self.height <= 0.0

    fn to_string() -> text:
        "Rect2({self.x}, {self.y}, {self.width}x{self.height})"
