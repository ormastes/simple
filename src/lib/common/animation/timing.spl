# CSS animation timing functions (easing functions).
# One timing function is accepted at a time. List-valued and keyframe-local
# timing functions remain outside the bounded Simple Web profile.

enum TimingFunction:
    """CSS timing function variants."""
    Linear
    Ease
    EaseIn
    EaseOut
    EaseInOut
    CubicBezier(x1: f64, y1: f64, x2: f64, y2: f64)
    Steps(steps: i64, jump_type: text)

val CSS_TIMING_MAX_SOURCE_BYTES: i32 = 256
val CSS_TIMING_MAX_F64: f64 = 1.7976931348623157e308

fn _timing_f64(raw: text) -> f64?:
    if val parsed = raw.trim().parse_f64():
        if (
            parsed == parsed and
            parsed >= 0.0 - CSS_TIMING_MAX_F64 and
            parsed <= CSS_TIMING_MAX_F64
        ):
            return Some(parsed)
    nil

fn _timing_function_inner(value: text, name: text) -> text?:
    val prefix = name + "("
    if (
        not value.starts_with(prefix) or not value.ends_with(")") or
        value.len() <= prefix.len()
    ):
        return nil
    val inner = value.substring(prefix.len(), value.len() - 1)
    if inner.contains("(") or inner.contains(")"):
        return nil
    Some(inner)

fn _parse_cubic_bezier(value: text) -> TimingFunction?:
    if val inner = _timing_function_inner(value, "cubic-bezier"):
        val parts = inner.split(",")
        if parts.len() != 4:
            return nil
        if val x1 = _timing_f64(parts[0]):
            if val y1 = _timing_f64(parts[1]):
                if val x2 = _timing_f64(parts[2]):
                    if val y2 = _timing_f64(parts[3]):
                        if x1 >= 0.0 and x1 <= 1.0 and x2 >= 0.0 and x2 <= 1.0:
                            return Some(TimingFunction.CubicBezier(
                                x1, y1, x2, y2
                            ))
    nil

fn _normalized_step_position(raw: text) -> text:
    val position = raw.trim().lower()
    if position == "start":
        return "jump-start"
    if position == "end" or position == "":
        return "jump-end"
    if (
        position == "jump-start" or position == "jump-end" or
        position == "jump-none" or position == "jump-both"
    ):
        return position
    ""

fn _parse_steps(value: text) -> TimingFunction?:
    if value == "step-start":
        return Some(TimingFunction.Steps(1, "jump-start"))
    if value == "step-end":
        return Some(TimingFunction.Steps(1, "jump-end"))
    if val inner = _timing_function_inner(value, "steps"):
        val parts = inner.split(",")
        if parts.len() < 1 or parts.len() > 2:
            return nil
        if val steps = parts[0].trim().parse_i64():
            val position = if parts.len() == 2:
                _normalized_step_position(parts[1])
            else:
                "jump-end"
            if (
                steps > 0 and position != "" and
                not (steps == 1 and position == "jump-none")
            ):
                return Some(TimingFunction.Steps(steps, position))
    nil

fn parse_timing_function(timing_str: text) -> TimingFunction?:
    """Strictly parse one CSS timing function; invalid input returns nil."""
    if timing_str.len() > CSS_TIMING_MAX_SOURCE_BYTES:
        return nil
    val value = timing_str.trim().lower()
    if value == "linear":
        return Some(TimingFunction.Linear)
    if value == "ease":
        return Some(TimingFunction.Ease)
    if value == "ease-in":
        return Some(TimingFunction.EaseIn)
    if value == "ease-out":
        return Some(TimingFunction.EaseOut)
    if value == "ease-in-out":
        return Some(TimingFunction.EaseInOut)
    if value.starts_with("cubic-bezier("):
        return _parse_cubic_bezier(value)
    if value.starts_with("steps(") or value == "step-start" or value == "step-end":
        return _parse_steps(value)
    nil

fn evaluate_timing(timing: TimingFunction, t: f64, before: bool = false) -> f64:
    """Evaluate one parsed CSS timing function at input progress t."""
    match timing:
        TimingFunction.Linear:
            t
        TimingFunction.Ease:
            cubic_bezier_at(t, 0.25, 0.1, 0.25, 1.0)
        TimingFunction.EaseIn:
            cubic_bezier_at(t, 0.42, 0.0, 1.0, 1.0)
        TimingFunction.EaseOut:
            cubic_bezier_at(t, 0.0, 0.0, 0.58, 1.0)
        TimingFunction.EaseInOut:
            cubic_bezier_at(t, 0.42, 0.0, 0.58, 1.0)
        TimingFunction.CubicBezier(x1, y1, x2, y2):
            cubic_bezier_at(t, x1, y1, x2, y2)
        TimingFunction.Steps(steps, jump_type):
            evaluate_steps(t, steps, jump_type, before)

fn _cubic_start_gradient(x1: f64, y1: f64, x2: f64, y2: f64) -> f64:
    if x1 > 0.0:
        return y1 / x1
    if x2 > 0.0:
        return y2 / x2
    0.0

fn _cubic_end_gradient(x1: f64, y1: f64, x2: f64, y2: f64) -> f64:
    if x2 < 1.0:
        return (y2 - 1.0) / (x2 - 1.0)
    if x1 < 1.0:
        return (y1 - 1.0) / (x1 - 1.0)
    0.0

fn cubic_bezier_at(t: f64, x1: f64, y1: f64, x2: f64, y2: f64) -> f64:
    """Evaluate CSS cubic-bezier with endpoint tangent extrapolation."""
    if t < 0.0:
        return t * _cubic_start_gradient(x1, y1, x2, y2)
    if t > 1.0:
        return 1.0 + (t - 1.0) * _cubic_end_gradient(x1, y1, x2, y2)
    if t == 0.0 or t == 1.0:
        return t

    # The admitted x control points are monotonic. A bounded Newton/bisection
    # hybrid avoids both a false x-only "linear" shortcut and flat-derivative
    # early returns.
    var low = 0.0
    var high = 1.0
    var u = t
    var i = 0
    while i < 20:
        val x_u = cubic_bezier_component(u, x1, x2)
        val error = x_u - t
        if error.abs() < 1e-9:
            return cubic_bezier_component(u, y1, y2)
        if error < 0.0:
            low = u
        else:
            high = u
        val derivative = cubic_bezier_derivative(u, x1, x2)
        val newton = if derivative.abs() > 1e-9:
            u - error / derivative
        else:
            -1.0
        if newton > low and newton < high:
            u = newton
        else:
            u = (low + high) / 2.0
        i = i + 1
    cubic_bezier_component(u, y1, y2)

fn cubic_bezier_component(t: f64, c1: f64, c2: f64) -> f64:
    val mt = 1.0 - t
    3.0 * mt * mt * t * c1 + 3.0 * mt * t * t * c2 + t * t * t

fn cubic_bezier_derivative(t: f64, c1: f64, c2: f64) -> f64:
    val mt = 1.0 - t
    3.0 * (
        mt * mt * c1 + 2.0 * mt * t * (c2 - c1) +
        t * t * (1.0 - c2)
    )

fn evaluate_steps(
    t: f64, steps: i64, jump_type: text, before: bool = false
) -> f64:
    """Evaluate the CSS Easing step algorithm, including the before flag."""
    val jump_count = if jump_type == "jump-none":
        steps.to_f64() - 1.0
    elif jump_type == "jump-both":
        steps.to_f64() + 1.0
    else:
        steps.to_f64()
    if steps <= 0 or jump_count <= 0.0:
        return t

    val scaled = t * steps.to_f64()
    var current_step = scaled.floor()
    if jump_type == "jump-start" or jump_type == "jump-both":
        current_step = current_step + 1.0
    if before and scaled == scaled.floor():
        current_step = current_step - 1.0
    if t >= 0.0 and current_step < 0.0:
        current_step = 0.0
    if t <= 1.0 and current_step > jump_count:
        current_step = jump_count
    current_step / jump_count
