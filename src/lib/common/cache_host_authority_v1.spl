# Versioned opaque host authority for one compiler cache root.
#
# Handles are runtime-owned capabilities.  A validated relative spelling is
# never a security receipt: successful operations are bound to root/object
# descriptors by the host implementation.

extern fn rt_cache_host_open_root_v1(path: text) -> i64
extern fn rt_cache_host_open_read_v1(root: i64, relative: text) -> i64
extern fn rt_cache_host_open_child_v1(parent: i64, name: text, create: i64) -> i64
extern fn rt_cache_host_open_cas_kind_v1(parent: i64, name: text, create: i64) -> i64
extern fn rt_cache_host_open_cas_shard_v1(parent: i64, name: text, level: i64, create: i64) -> i64
extern fn rt_cache_host_open_cas_leaf_v1(parent: i64, name: text) -> i64
extern fn rt_cache_host_begin_reader_pin_v1(root: i64, epoch: i64, generation: i64,
    manifest: [u8], manifest_len: i64, process: [u8], process_len: i64,
    boot: [u8], boot_len: i64, namespace: [u8], namespace_len: i64,
    now: i64, ttl: i64) -> i64
extern fn rt_cache_host_validate_reader_pin_v1(pin: i64, epoch: i64, generation: i64,
    manifest: [u8], manifest_len: i64, process: [u8], process_len: i64,
    boot: [u8], boot_len: i64, namespace: [u8], namespace_len: i64,
    now: i64) -> i64
extern fn rt_cache_host_renew_reader_pin_v1(pin: i64, now: i64, ttl: i64) -> i64
extern fn rt_cache_host_release_reader_pin_v1(pin: i64, epoch: i64, generation: i64,
    manifest: [u8], manifest_len: i64, process: [u8], process_len: i64,
    boot: [u8], boot_len: i64, namespace: [u8], namespace_len: i64) -> i64
extern fn rt_cache_host_open_pinned_cas_v1(pin: i64, kind: text, digest: text,
    now: i64) -> i64
extern fn rt_cache_host_reader_gc_begin_v1(root: i64, expected_even: i64) -> i64
extern fn rt_cache_host_reader_gc_end_v1(root: i64, expected_odd: i64,
    generation: i64) -> i64
extern fn rt_cache_host_size_v1(object: i64, maximum: i64) -> i64
extern fn rt_cache_host_pread_receipt_v1(object: i64, offset: i64,
                                         out: [u8], capacity: i64) -> i64
extern fn rt_cache_host_secure_temp_v1(root: i64) -> i64
extern fn rt_cache_host_write_temp_v1(temp: i64, offset: i64,
                                      data: [u8], length: i64) -> i64
extern fn rt_cache_host_publish_noreplace_v1(temp: i64, relative: text) -> i64
extern fn rt_cache_host_quarantine_v1(root: i64, object: i64,
                                      relative: text) -> i64
extern fn rt_cache_host_fsync_v1(handle: i64) -> i64
extern fn rt_cache_host_close_v1(handle: i64) -> i64

struct CacheRootAuthorityV1:
    opaque_handle: i64

struct CacheObjectAuthorityV1:
    opaque_handle: i64

struct CacheTempAuthorityV1:
    opaque_handle: i64

struct CacheChildAuthorityV1:
    opaque_handle: i64

struct CacheCasKindAuthorityV1:
    opaque_handle: i64

struct CacheCasShard1AuthorityV1:
    opaque_handle: i64

struct CacheCasShard2AuthorityV1:
    opaque_handle: i64

struct CacheReaderPinAuthorityV1:
    opaque_handle: i64

struct AnchoredSpoolChildV1:
    opaque_handle: i64

fn cache_host_root_valid_v1(root: CacheRootAuthorityV1) -> bool: root.opaque_handle > 0
fn cache_host_child_valid_v1(child: CacheChildAuthorityV1) -> bool: child.opaque_handle > 0
fn cache_host_cas_kind_valid_v1(child: CacheCasKindAuthorityV1) -> bool: child.opaque_handle > 0
fn cache_host_cas_shard1_valid_v1(child: CacheCasShard1AuthorityV1) -> bool: child.opaque_handle > 0
fn cache_host_cas_shard2_valid_v1(child: CacheCasShard2AuthorityV1) -> bool: child.opaque_handle > 0
fn cache_host_object_valid_v1(object: CacheObjectAuthorityV1) -> bool: object.opaque_handle > 0
fn cache_host_temp_valid_v1(temp: CacheTempAuthorityV1) -> bool: temp.opaque_handle > 0

fn cache_host_open_root_v1(path: text) -> CacheRootAuthorityV1:
    CacheRootAuthorityV1(opaque_handle: rt_cache_host_open_root_v1(path))

fn cache_host_open_read_v1(root: CacheRootAuthorityV1,
                           relative: text) -> CacheObjectAuthorityV1:
    CacheObjectAuthorityV1(opaque_handle: rt_cache_host_open_read_v1(
        root.opaque_handle, relative))

fn cache_host_open_child_v1(root: CacheRootAuthorityV1, fixed_name: text,
                            create: bool) -> CacheChildAuthorityV1:
    CacheChildAuthorityV1(opaque_handle: rt_cache_host_open_child_v1(
        root.opaque_handle, fixed_name, if create: 1 else: 0))

fn cache_host_open_spool_child_v1(root: CacheRootAuthorityV1) -> AnchoredSpoolChildV1:
    AnchoredSpoolChildV1(opaque_handle: rt_cache_host_open_child_v1(
        root.opaque_handle, "spool", 1))

fn cache_host_open_read_child_v1(child: CacheChildAuthorityV1,
                                 relative: text) -> CacheObjectAuthorityV1:
    CacheObjectAuthorityV1(opaque_handle: rt_cache_host_open_read_v1(
        child.opaque_handle, relative))

fn cache_host_open_shard_child_v1(parent: CacheChildAuthorityV1, shard: text,
                                  create: bool) -> CacheChildAuthorityV1:
    CacheChildAuthorityV1(opaque_handle: rt_cache_host_open_child_v1(
        parent.opaque_handle, shard, if create: 1 else: 0))

fn cache_host_open_cas_kind_v1(parent: CacheChildAuthorityV1, kind: text,
                               create: bool) -> CacheCasKindAuthorityV1:
    CacheCasKindAuthorityV1(opaque_handle: rt_cache_host_open_cas_kind_v1(
        parent.opaque_handle, kind, if create: 1 else: 0))

fn cache_host_open_cas_shard1_v1(parent: CacheCasKindAuthorityV1, shard: text,
                                 create: bool) -> CacheCasShard1AuthorityV1:
    CacheCasShard1AuthorityV1(opaque_handle: rt_cache_host_open_cas_shard_v1(
        parent.opaque_handle, shard, 1, if create: 1 else: 0))

fn cache_host_open_cas_shard2_v1(parent: CacheCasShard1AuthorityV1, shard: text,
                                 create: bool) -> CacheCasShard2AuthorityV1:
    CacheCasShard2AuthorityV1(opaque_handle: rt_cache_host_open_cas_shard_v1(
        parent.opaque_handle, shard, 2, if create: 1 else: 0))

fn cache_host_open_cas_leaf_v1(parent: CacheCasShard2AuthorityV1,
                               leaf: text) -> CacheObjectAuthorityV1:
    CacheObjectAuthorityV1(opaque_handle: rt_cache_host_open_cas_leaf_v1(
        parent.opaque_handle, leaf))

fn cache_host_begin_reader_pin_v1(root: CacheRootAuthorityV1, epoch: i64,
        generation: i64, manifest: text, process: text, boot: text,
        namespace: text, now: i64, ttl: i64) -> CacheReaderPinAuthorityV1:
    val mb = manifest.bytes()
    val pb = process.bytes()
    val bb = boot.bytes()
    val nb = namespace.bytes()
    CacheReaderPinAuthorityV1(opaque_handle: rt_cache_host_begin_reader_pin_v1(
        root.opaque_handle, epoch, generation, mb, mb.len(), pb, pb.len(),
        bb, bb.len(), nb, nb.len(), now, ttl))

fn cache_host_validate_reader_pin_v1(pin: CacheReaderPinAuthorityV1, epoch: i64,
        generation: i64, manifest: text, process: text, boot: text,
        namespace: text, now: i64) -> bool:
    val mb = manifest.bytes()
    val pb = process.bytes()
    val bb = boot.bytes()
    val nb = namespace.bytes()
    rt_cache_host_validate_reader_pin_v1(pin.opaque_handle, epoch, generation,
        mb, mb.len(), pb, pb.len(), bb, bb.len(), nb, nb.len(), now) == 1

fn cache_host_renew_reader_pin_v1(pin: CacheReaderPinAuthorityV1,
                                  now: i64, ttl: i64) -> i64:
    rt_cache_host_renew_reader_pin_v1(pin.opaque_handle, now, ttl)

fn cache_host_open_pinned_cas_v1(pin: CacheReaderPinAuthorityV1, kind: text,
        digest: text, now: i64) -> CacheObjectAuthorityV1:
    CacheObjectAuthorityV1(opaque_handle: rt_cache_host_open_pinned_cas_v1(
        pin.opaque_handle, kind, digest, now))

fn cache_host_release_reader_pin_v1(pin: CacheReaderPinAuthorityV1, epoch: i64,
        generation: i64, manifest: text, process: text, boot: text,
        namespace: text) -> i64:
    val mb = manifest.bytes()
    val pb = process.bytes()
    val bb = boot.bytes()
    val nb = namespace.bytes()
    rt_cache_host_release_reader_pin_v1(pin.opaque_handle, epoch, generation,
        mb, mb.len(), pb, pb.len(), bb, bb.len(), nb, nb.len())

fn cache_host_reader_gc_begin_v1(root: CacheRootAuthorityV1,
                                 expected_even: i64) -> i64:
    rt_cache_host_reader_gc_begin_v1(root.opaque_handle, expected_even)

fn cache_host_reader_gc_end_v1(root: CacheRootAuthorityV1, expected_odd: i64,
                               generation: i64) -> i64:
    rt_cache_host_reader_gc_end_v1(root.opaque_handle, expected_odd, generation)

# Result meanings: >=0 is a stable same-handle byte count; -1 is an I/O or
# authority failure; -2 is a changed pre/read/post receipt and must be rejected.
fn cache_host_pread_receipt_v1(object: CacheObjectAuthorityV1, offset: i64,
                               mut out: [u8]) -> i64:
    rt_cache_host_pread_receipt_v1(object.opaque_handle, offset, out, out.len())

fn cache_host_size_v1(object: CacheObjectAuthorityV1, maximum: i64) -> i64:
    rt_cache_host_size_v1(object.opaque_handle, maximum)

fn cache_host_secure_temp_v1(root: CacheRootAuthorityV1) -> CacheTempAuthorityV1:
    CacheTempAuthorityV1(opaque_handle: rt_cache_host_secure_temp_v1(
        root.opaque_handle))

fn cache_host_secure_temp_child_v1(child: CacheChildAuthorityV1) -> CacheTempAuthorityV1:
    CacheTempAuthorityV1(opaque_handle: rt_cache_host_secure_temp_v1(
        child.opaque_handle))

fn cache_host_secure_cas_temp_v1(child: CacheCasShard2AuthorityV1) -> CacheTempAuthorityV1:
    CacheTempAuthorityV1(opaque_handle: rt_cache_host_secure_temp_v1(
        child.opaque_handle))

fn cache_host_secure_spool_temp_v1(child: AnchoredSpoolChildV1) -> CacheTempAuthorityV1:
    CacheTempAuthorityV1(opaque_handle: rt_cache_host_secure_temp_v1(
        child.opaque_handle))

fn cache_host_write_temp_v1(temp: CacheTempAuthorityV1, offset: i64,
                            data: [u8]) -> i64:
    rt_cache_host_write_temp_v1(temp.opaque_handle, offset, data, data.len())

# Returns 1 only for the unique immutable publisher, 0 when destination exists,
# and -1 on failure.  Existing destinations are never replaced.
fn cache_host_publish_noreplace_v1(temp: CacheTempAuthorityV1,
                                   relative: text) -> i64:
    rt_cache_host_publish_noreplace_v1(temp.opaque_handle, relative)

fn cache_host_quarantine_v1(root: CacheRootAuthorityV1,
                            object: CacheObjectAuthorityV1,
                            relative: text) -> i64:
    rt_cache_host_quarantine_v1(root.opaque_handle, object.opaque_handle,
                                relative)

fn cache_host_fsync_root_v1(root: CacheRootAuthorityV1) -> i64:
    rt_cache_host_fsync_v1(root.opaque_handle)

fn cache_host_close_child_v1(child: CacheChildAuthorityV1) -> i64:
    rt_cache_host_close_v1(child.opaque_handle)

fn cache_host_close_cas_kind_v1(child: CacheCasKindAuthorityV1) -> i64:
    rt_cache_host_close_v1(child.opaque_handle)

fn cache_host_close_cas_shard1_v1(child: CacheCasShard1AuthorityV1) -> i64:
    rt_cache_host_close_v1(child.opaque_handle)

fn cache_host_close_cas_shard2_v1(child: CacheCasShard2AuthorityV1) -> i64:
    rt_cache_host_close_v1(child.opaque_handle)

fn cache_host_close_spool_child_v1(child: AnchoredSpoolChildV1) -> i64:
    rt_cache_host_close_v1(child.opaque_handle)

fn cache_host_close_root_v1(root: CacheRootAuthorityV1) -> i64:
    rt_cache_host_close_v1(root.opaque_handle)

fn cache_host_close_object_v1(object: CacheObjectAuthorityV1) -> i64:
    rt_cache_host_close_v1(object.opaque_handle)

fn cache_host_close_temp_v1(temp: CacheTempAuthorityV1) -> i64:
    rt_cache_host_close_v1(temp.opaque_handle)

export CacheRootAuthorityV1, CacheChildAuthorityV1, AnchoredSpoolChildV1
export CacheCasKindAuthorityV1, CacheCasShard1AuthorityV1, CacheCasShard2AuthorityV1
export CacheObjectAuthorityV1, CacheTempAuthorityV1
export CacheReaderPinAuthorityV1
export cache_host_root_valid_v1, cache_host_child_valid_v1
export cache_host_cas_kind_valid_v1, cache_host_cas_shard1_valid_v1
export cache_host_cas_shard2_valid_v1, cache_host_object_valid_v1
export cache_host_temp_valid_v1
export cache_host_open_root_v1, cache_host_open_read_v1
export cache_host_open_child_v1, cache_host_open_spool_child_v1
export cache_host_open_read_child_v1, cache_host_open_shard_child_v1
export cache_host_open_cas_kind_v1, cache_host_open_cas_shard1_v1
export cache_host_open_cas_shard2_v1, cache_host_open_cas_leaf_v1
export cache_host_begin_reader_pin_v1, cache_host_validate_reader_pin_v1
export cache_host_renew_reader_pin_v1, cache_host_open_pinned_cas_v1
export cache_host_release_reader_pin_v1
export cache_host_reader_gc_begin_v1, cache_host_reader_gc_end_v1
export cache_host_pread_receipt_v1, cache_host_secure_temp_v1
export cache_host_size_v1
export cache_host_secure_temp_child_v1
export cache_host_secure_cas_temp_v1
export cache_host_secure_spool_temp_v1
export cache_host_write_temp_v1, cache_host_publish_noreplace_v1
export cache_host_quarantine_v1, cache_host_fsync_root_v1
export cache_host_close_root_v1, cache_host_close_object_v1
export cache_host_close_child_v1, cache_host_close_spool_child_v1
export cache_host_close_cas_kind_v1, cache_host_close_cas_shard1_v1
export cache_host_close_cas_shard2_v1
export cache_host_close_temp_v1
