# Versioned opaque host authority for one compiler cache root.
#
# Handles are runtime-owned capabilities.  A validated relative spelling is
# never a security receipt: successful operations are bound to root/object
# descriptors by the host implementation.

extern fn rt_cache_host_open_root_v1(path: text) -> i64
extern fn rt_cache_host_open_read_v1(root: i64, relative: text) -> i64
extern fn rt_cache_host_open_child_v1(parent: i64, name: text, create: i64) -> i64
extern fn rt_cache_host_pread_receipt_v1(object: i64, offset: i64,
                                         out: [u8], capacity: i64) -> i64
extern fn rt_cache_host_secure_temp_v1(root: i64) -> i64
extern fn rt_cache_host_write_temp_v1(temp: i64, offset: i64,
                                      data: [u8], length: i64) -> i64
extern fn rt_cache_host_publish_noreplace_v1(temp: i64, relative: text) -> i64
extern fn rt_cache_host_quarantine_v1(root: i64, object: i64,
                                      relative: text) -> i64
extern fn rt_cache_host_fsync_v1(handle: i64) -> i64
extern fn rt_cache_host_close_v1(handle: i64) -> i64

struct CacheRootAuthorityV1:
    opaque_handle: i64

struct CacheObjectAuthorityV1:
    opaque_handle: i64

struct CacheTempAuthorityV1:
    opaque_handle: i64

struct CacheChildAuthorityV1:
    opaque_handle: i64

struct AnchoredSpoolChildV1:
    opaque_handle: i64

fn cache_host_open_root_v1(path: text) -> CacheRootAuthorityV1:
    CacheRootAuthorityV1(opaque_handle: rt_cache_host_open_root_v1(path))

fn cache_host_open_read_v1(root: CacheRootAuthorityV1,
                           relative: text) -> CacheObjectAuthorityV1:
    CacheObjectAuthorityV1(opaque_handle: rt_cache_host_open_read_v1(
        root.opaque_handle, relative))

fn cache_host_open_child_v1(root: CacheRootAuthorityV1, fixed_name: text,
                            create: bool) -> CacheChildAuthorityV1:
    CacheChildAuthorityV1(opaque_handle: rt_cache_host_open_child_v1(
        root.opaque_handle, fixed_name, if create: 1 else: 0))

fn cache_host_open_spool_child_v1(root: CacheRootAuthorityV1) -> AnchoredSpoolChildV1:
    AnchoredSpoolChildV1(opaque_handle: rt_cache_host_open_child_v1(
        root.opaque_handle, "spool", 1))

fn cache_host_open_read_child_v1(child: CacheChildAuthorityV1,
                                 relative: text) -> CacheObjectAuthorityV1:
    CacheObjectAuthorityV1(opaque_handle: rt_cache_host_open_read_v1(
        child.opaque_handle, relative))

fn cache_host_open_shard_child_v1(parent: CacheChildAuthorityV1, shard: text,
                                  create: bool) -> CacheChildAuthorityV1:
    CacheChildAuthorityV1(opaque_handle: rt_cache_host_open_child_v1(
        parent.opaque_handle, shard, if create: 1 else: 0))

# Result meanings: >=0 is a stable same-handle byte count; -1 is an I/O or
# authority failure; -2 is a changed pre/read/post receipt and must be rejected.
fn cache_host_pread_receipt_v1(object: CacheObjectAuthorityV1, offset: i64,
                               mut out: [u8]) -> i64:
    rt_cache_host_pread_receipt_v1(object.opaque_handle, offset, out, out.len())

fn cache_host_secure_temp_v1(root: CacheRootAuthorityV1) -> CacheTempAuthorityV1:
    CacheTempAuthorityV1(opaque_handle: rt_cache_host_secure_temp_v1(
        root.opaque_handle))

fn cache_host_secure_temp_child_v1(child: CacheChildAuthorityV1) -> CacheTempAuthorityV1:
    CacheTempAuthorityV1(opaque_handle: rt_cache_host_secure_temp_v1(
        child.opaque_handle))

fn cache_host_secure_spool_temp_v1(child: AnchoredSpoolChildV1) -> CacheTempAuthorityV1:
    CacheTempAuthorityV1(opaque_handle: rt_cache_host_secure_temp_v1(
        child.opaque_handle))

fn cache_host_write_temp_v1(temp: CacheTempAuthorityV1, offset: i64,
                            data: [u8]) -> i64:
    rt_cache_host_write_temp_v1(temp.opaque_handle, offset, data, data.len())

# Returns 1 only for the unique immutable publisher, 0 when destination exists,
# and -1 on failure.  Existing destinations are never replaced.
fn cache_host_publish_noreplace_v1(temp: CacheTempAuthorityV1,
                                   relative: text) -> i64:
    rt_cache_host_publish_noreplace_v1(temp.opaque_handle, relative)

fn cache_host_quarantine_v1(root: CacheRootAuthorityV1,
                            object: CacheObjectAuthorityV1,
                            relative: text) -> i64:
    rt_cache_host_quarantine_v1(root.opaque_handle, object.opaque_handle,
                                relative)

fn cache_host_fsync_root_v1(root: CacheRootAuthorityV1) -> i64:
    rt_cache_host_fsync_v1(root.opaque_handle)

fn cache_host_close_child_v1(child: CacheChildAuthorityV1) -> i64:
    rt_cache_host_close_v1(child.opaque_handle)

fn cache_host_close_spool_child_v1(child: AnchoredSpoolChildV1) -> i64:
    rt_cache_host_close_v1(child.opaque_handle)

fn cache_host_close_root_v1(root: CacheRootAuthorityV1) -> i64:
    rt_cache_host_close_v1(root.opaque_handle)

fn cache_host_close_object_v1(object: CacheObjectAuthorityV1) -> i64:
    rt_cache_host_close_v1(object.opaque_handle)

fn cache_host_close_temp_v1(temp: CacheTempAuthorityV1) -> i64:
    rt_cache_host_close_v1(temp.opaque_handle)

export CacheRootAuthorityV1, CacheChildAuthorityV1, AnchoredSpoolChildV1
export CacheObjectAuthorityV1, CacheTempAuthorityV1
export cache_host_open_root_v1, cache_host_open_read_v1
export cache_host_open_child_v1, cache_host_open_spool_child_v1
export cache_host_open_read_child_v1, cache_host_open_shard_child_v1
export cache_host_pread_receipt_v1, cache_host_secure_temp_v1
export cache_host_secure_temp_child_v1
export cache_host_secure_spool_temp_v1
export cache_host_write_temp_v1, cache_host_publish_noreplace_v1
export cache_host_quarantine_v1, cache_host_fsync_root_v1
export cache_host_close_root_v1, cache_host_close_object_v1
export cache_host_close_child_v1, cache_host_close_spool_child_v1
export cache_host_close_temp_v1
