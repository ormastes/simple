# Token-budget elision for tool output headed for a model's context window.
#
# Mirrors context-mode's `smartTruncate` (truncate.ts): a 60% head / 40% tail
# byte budget snapped to line boundaries, with a separator naming what was
# dropped. The tail matters because errors and results land at the end.
#
# Language-agnostic and pure — no I/O — so any surface (spipe, ponytail,
# codebase search) can cap its output regardless of the source language.

# `text.len()` is BYTES in Simple; a line's on-wire cost is its bytes plus the
# newline that rejoins it.
fn _budget_line_bytes(line: text) -> i64:
    line.len() + 1

fn smart_truncate_bytes(raw: text, max_bytes: i64) -> text:
    """Return `raw` unchanged when it fits `max_bytes`, else head + tail.

    Head takes 60% of the budget, tail the remainder. Both are cut on line
    boundaries, so the result stays readable rather than ending mid-token.
    """
    if max_bytes <= 0:
        return raw
    if raw.len() <= max_bytes:
        return raw

    val lines = raw.split("\n")
    val head_budget = (max_bytes * 6) / 10
    val tail_budget = max_bytes - head_budget

    var head_lines: [text] = []
    var head_bytes: i64 = 0
    for line in lines:
        val cost = _budget_line_bytes(line)
        if head_bytes + cost > head_budget:
            break
        head_lines.push(line)
        head_bytes = head_bytes + cost

    var tail_rev: [text] = []
    var tail_bytes: i64 = 0
    var i = lines.len() - 1
    while i >= head_lines.len():
        val cost = _budget_line_bytes(lines[i])
        if tail_bytes + cost > tail_budget:
            break
        tail_rev.push(lines[i])
        tail_bytes = tail_bytes + cost
        i = i - 1

    var tail_lines: [text] = []
    var j = tail_rev.len() - 1
    while j >= 0:
        tail_lines.push(tail_rev[j])
        j = j - 1

    val skipped_lines = lines.len() - head_lines.len() - tail_lines.len()
    val skipped_bytes = raw.len() - head_bytes - tail_bytes
    val separator = "\n\n... [" + str(skipped_lines) + " lines / " + str(skipped_bytes)
        + " bytes truncated — showing first " + str(head_lines.len())
        + " + last " + str(tail_lines.len()) + " lines] ...\n\n"

    head_lines.join("\n") + separator + tail_lines.join("\n")
