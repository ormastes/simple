# Dedicated host memory-map and startup-file contract.
#
# This is the capability boundary shared by hosted POSIX/Linux and SimpleOS.
# It deliberately models POSIX protection/flag bits and mapping lifetime, but
# keeps platform calls out of common code.  Consumers can distinguish a native
# address mapping from a VFS-backed preload and must never infer zero-copy from
# a successful byte preload.

pub val HOST_PROT_NONE: i64 = 0x0
pub val HOST_PROT_READ: i64 = 0x1
pub val HOST_PROT_WRITE: i64 = 0x2
pub val HOST_PROT_EXEC: i64 = 0x4

pub val HOST_MAP_SHARED: i64 = 0x1
pub val HOST_MAP_PRIVATE: i64 = 0x2
pub val HOST_MAP_FIXED: i64 = 0x10
pub val HOST_MAP_ANONYMOUS: i64 = 0x20
pub val HOST_MAP_FAILED: i64 = -1

pub struct HostMapRequest:
    address_hint: i64
    length: i64
    protection: i64
    flags: i64
    fd: i64
    offset: i64

pub struct HostMappedRegion:
    ok: bool
    address: i64
    length: i64
    provider: text
    storage: text
    owns_mapping: bool
    error_code: i64
    error: text

pub struct HostFilePreload:
    ok: bool
    path: text
    bytes: [u8]
    byte_count: i64
    page_count: i64
    provider: text
    strategy: text
    native_mapping_used: bool
    error_code: i64
    error: text

pub fn host_map_request(
    address_hint: i64,
    length: i64,
    protection: i64,
    flags: i64,
    fd: i64 = -1,
    offset: i64 = 0
) -> HostMapRequest:
    HostMapRequest(
        address_hint: address_hint,
        length: length,
        protection: protection,
        flags: flags,
        fd: fd,
        offset: offset
    )

pub fn host_map_error(provider: text, error_code: i64, error: text) -> HostMappedRegion:
    HostMappedRegion(
        ok: false,
        address: HOST_MAP_FAILED,
        length: 0,
        provider: provider,
        storage: "none",
        owns_mapping: false,
        error_code: error_code,
        error: error
    )

pub fn host_map_success(provider: text, storage: text, address: i64, length: i64) -> HostMappedRegion:
    HostMappedRegion(
        ok: true,
        address: address,
        length: length,
        provider: provider,
        storage: storage,
        owns_mapping: true,
        error_code: 0,
        error: ""
    )

pub fn host_file_preload_error(path: text, provider: text, error_code: i64, error: text) -> HostFilePreload:
    HostFilePreload(
        ok: false,
        path: path,
        bytes: [],
        byte_count: 0,
        page_count: 0,
        provider: provider,
        strategy: "none",
        native_mapping_used: false,
        error_code: error_code,
        error: error
    )

pub fn host_file_preload_success(
    path: text,
    bytes: [u8],
    page_size: i64,
    provider: text,
    strategy: text,
    native_mapping_used: bool
) -> HostFilePreload:
    val count = bytes.len() as i64
    val pages = if count == 0: 0 else: (count + page_size - 1) / page_size
    HostFilePreload(
        ok: true,
        path: path,
        bytes: bytes,
        byte_count: count,
        page_count: pages,
        provider: provider,
        strategy: strategy,
        native_mapping_used: native_mapping_used,
        error_code: 0,
        error: ""
    )

pub fn host_protection_error(protection: i64) -> text:
    val known_protection = HOST_PROT_READ | HOST_PROT_WRITE | HOST_PROT_EXEC
    if (protection & ~known_protection) != 0:
        return "unknown-protection-flags"
    ""

pub fn host_mapped_region_releasable(region: HostMappedRegion) -> bool:
    region.ok and region.owns_mapping and region.address != HOST_MAP_FAILED and
        region.length > 0

pub fn host_map_request_error(request: HostMapRequest, page_size: i64) -> text:
    if request.length <= 0:
        return "length-must-be-positive"
    if request.address_hint < 0:
        return "address-hint-must-be-nonnegative"
    if request.offset < 0:
        return "offset-must-be-nonnegative"
    if page_size <= 0:
        return "page-size-must-be-positive"
    if request.offset % page_size != 0:
        return "offset-must-be-page-aligned"
    val protection_error = host_protection_error(request.protection)
    if protection_error != "":
        return protection_error
    val known_flags = HOST_MAP_SHARED | HOST_MAP_PRIVATE | HOST_MAP_FIXED | HOST_MAP_ANONYMOUS
    if (request.flags & ~known_flags) != 0:
        return "unknown-mapping-flags"
    val sharing = request.flags & (HOST_MAP_PRIVATE | HOST_MAP_SHARED)
    if sharing != HOST_MAP_PRIVATE and sharing != HOST_MAP_SHARED:
        return "choose-exactly-one-private-or-shared"
    val anonymous = (request.flags & HOST_MAP_ANONYMOUS) != 0
    if anonymous and request.fd >= 0:
        return "anonymous-map-must-not-name-fd"
    if not anonymous and request.fd < 0:
        return "file-map-requires-fd"
    ""

pub fn host_map_request_valid(request: HostMapRequest, page_size: i64) -> bool:
    host_map_request_error(request, page_size) == ""

pub fn host_map_is_anonymous_private(request: HostMapRequest) -> bool:
    (request.flags & HOST_MAP_ANONYMOUS) != 0 and
        (request.flags & HOST_MAP_PRIVATE) != 0 and
        (request.flags & HOST_MAP_SHARED) == 0 and
        request.fd < 0

trait DedicatedHost:
    fn host_name() -> text
    fn page_size() -> i64
    fn supports_file_backed_mmap() -> bool
    fn supports_shared_writable_mmap() -> bool
    me mmap(request: HostMapRequest) -> HostMappedRegion
    me mprotect(region: HostMappedRegion, protection: i64) -> bool
    me munmap(region: HostMappedRegion) -> bool
    me preload_readonly_file(path: text, page_size: i64) -> HostFilePreload
