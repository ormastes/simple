# JWT Claims — helpers for inspecting a decoded JWT claims list.
#
# Provides: get_claim, has_claim, current_timestamp.

@unsafe(reason: "raw wall-clock microsecond provider; negative i64 sentinel is failure", capabilities: [ffi])
extern fn rt_time_now_unix_micros() -> i64

# Return the Unix timestamp in seconds (used for exp/iat validation), or an
# explicit error.  The integer microsecond ABI is shared by interpreter and
# native execution; the legacy seconds symbol is not.
fn current_timestamp() -> Result<i64, text>:
    val micros = unsafe(capabilities: [ffi]):
        rt_time_now_unix_micros()
    if micros < 0:
        return Err("JWT clock unavailable")
    Ok(micros / 1000000)

# Look up a claim by key in the decoded pairs list.
# Returns the claim value as text, or "" if not found.
fn get_claim(claims: [(text, text)], key: text) -> text:
    var i = 0
    while i < claims.len():
        val pair = claims[i]
        if pair.0 == key:
            return pair.1
        i = i + 1
    ""

# Return true if the claims list contains the given key.
fn has_claim(claims: [(text, text)], key: text) -> bool:
    get_claim(claims, key).len() > 0
