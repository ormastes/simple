# Pure-Simple scalar reference for the lane-wise SIMD primitives dispatched in
# src/runtime/runtime_simd_dispatch.c:
#   rt_simd_shuffle_u8x16 (:2547)  — PSHUFB / TBL byte permute
#   rt_simd_add_i64x4     (:2454)  — AVX2 _mm256_add_epi64
#   rt_simd_sub_i64x4     (:2464)  — AVX2 _mm256_sub_epi64
#
# These are the reference semantics the vector instruction must reproduce.
# Lanes are carried as i64 so the reference can be written without depending
# on any SIMD type; the specs convert to Vec16u8 / Vec4i64 at the boundary.

# PSHUFB semantics, mirrored from the C kernel and the interpreter bridge
# (interpreter_extern/simd.rs:1734): each mask lane selects one source byte.
# Bit 7 set zeroes the output lane; otherwise the low 5 bits index a 32-byte
# window where 0..15 draws from `a` and 16..31 draws from `b`. The masking to
# 5 bits (not 4) is the part that is easy to get wrong.
#
# NOW DUAL-RUN (tranche E, test/01_unit/lib/common/spec/dual_run_tranche_e_spec.spl).
# The earlier note here said the oracle was unreachable because the bridge
# helper require_u8_field (interpreter_extern/simd.rs:1204) accepts only
# Value::Int against Vec16u8's u8-typed fields. Re-measured 2026-09-03: a
# Vec16u8 built by direct field construction from integer literals DOES reach
# the oracle, and a 16-lane mask exercising every branch (in-range `a` index,
# in-range `b` index, the 5-bit wrap, and three distinct bit-7 zeroing masks)
# returns byte-for-byte what this reference computes. The blocked path is
# narrower than the note claimed; see
# doc/08_tracking/bug/interpreter_vec16u8_extern_rejects_u8_fields_2026-09-02.md.
pub fn shuffle_u8x16_pure(a: [i64], b: [i64], mask: [i64]) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < 16:
        val m = mask[i] & 255
        if (m & 128) != 0:
            out.push(0)
        else:
            val idx = m & 31
            if idx < 16:
                out.push(a[idx] & 255)
            else:
                out.push(b[idx - 16] & 255)
        i = i + 1
    return out

# Lane-wise wrapping add / subtract of four i64 lanes. No carry crosses a lane
# boundary — that independence is the property the vector form must preserve.
pub fn add_i64x4_pure(a: [i64], b: [i64]) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < 4:
        out.push(a[i] + b[i])
        i = i + 1
    return out

pub fn sub_i64x4_pure(a: [i64], b: [i64]) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < 4:
        out.push(a[i] - b[i])
        i = i + 1
    return out

# --------------------------------------------------------------------------
# Tranche E additions: the remaining exact-semantics lane primitives.
# Every one below is EXACT — integer shifts and float COMPARISONS, never a
# float arithmetic op. rt_simd_fma_* and rt_simd_hadd_f32x4 are deliberately
# NOT twinned here: a fused multiply-add rounds once where a pure-Simple
# `a * b + c` rounds twice, and a horizontal sum depends on summation order,
# so either twin would either diverge on ordinary inputs or have to be tested
# only on contrived exactly-representable values — a semi-vacuous test.
# --------------------------------------------------------------------------

# One lane of rt_simd_shl_u64x4: logical left shift of an unsigned 64-bit
# lane. The u64 return type is load-bearing — measured on this tree, the same
# expression assigned to an inferred `val` produces SIGNED results (2^64-1 << 1
# printed as -2), while a `-> u64` typed function returns 18446744073709551614.
pub fn shl_u64_pure(x: u64, shift: i32) -> u64:
    return x << shift

# One lane of rt_simd_shr_u64x4: LOGICAL (zero-filling) right shift, not
# arithmetic. Verified against the oracle at the top bit: (2^64-1) >> 1 is
# 9223372036854775807, not -1.
pub fn shr_u64_pure(x: u64, shift: i32) -> u64:
    return x >> shift

# Horizontal maximum of four f32 lanes (rt_simd_hmax_f32x4). A max is a
# COMPARISON, so no rounding is introduced and the scalar reference is
# bit-exact against the vector kernel.
pub fn hmax_f32x4_pure(lanes: [f32]) -> f32:
    var best = lanes[0]
    var i = 1
    while i < 4:
        if lanes[i] > best:
            best = lanes[i]
        i = i + 1
    return best

# Horizontal minimum of four f32 lanes (rt_simd_hmin_f32x4). Same exactness
# argument as hmax_f32x4_pure.
pub fn hmin_f32x4_pure(lanes: [f32]) -> f32:
    var best = lanes[0]
    var i = 1
    while i < 4:
        if lanes[i] < best:
            best = lanes[i]
        i = i + 1
    return best

# --------------------------------------------------------------------------
# 512-bit (AVX-512 width) lane primitives.
#
# These are OS-INDEPENDENT and ARCH-INDEPENDENT by construction: they are
# ordinary Simple over [i64]/u64 with no intrinsic, no target gate and no
# platform header, so they compute the same answer on x86_64, aarch64 and
# riscv64, and under every OS. That is the point of a twin — the reference
# must be reproducible anywhere, so a divergence indicts the vector kernel
# rather than the machine it ran on.
#
# Every primitive here is EXACT — integer arithmetic, bit manipulation and
# comparisons only. No float arithmetic op appears, for the reason given in
# the tranche E header above: a twin that rounds differently from the kernel
# would either diverge on ordinary inputs or have to be tested on contrived
# values, which is a semi-vacuous test.
#
# NO rt_simd_* ORACLE EXISTS FOR THESE YET. src/runtime/runtime_simd_dispatch.c
# tops out at 256-bit (RT_SIMD_F64X4_BINOP / U64X4_BINOP / F32X8_BINOP; grep it
# for __AVX512 and you get nothing), so these cannot be registered as
# @dual_pair twins the way the 128/256-bit primitives above are. They are
# specified and tested standalone against hand-computed exact semantics, and
# become dual-runnable the moment a 512-bit kernel lands. This is stated
# rather than papered over: standalone tests pin the SEMANTICS but do not yet
# pin them against a second independent implementation.
# --------------------------------------------------------------------------

# VPCMPEQB with a 64-byte operand: compare 64 u8 lanes and return one bit per
# lane in a 64-bit mask (`_mm512_cmpeq_epi8_mask` -> `__mmask64`). Lane i maps
# to bit i. This replaces AVX2's compare-then-`movemask` pair, and is the
# primitive the AVX-512 byte-search kernels are built on.
#
# The `-> u64` return type is load-bearing for the same reason recorded on
# shl_u64_pure: with an inferred type an all-lanes-equal result prints as a
# signed -1 instead of 18446744073709551615.
pub fn cmpeq_u8x64_mask_pure(a: [i64], b: [i64]) -> u64:
    var mask: u64 = 0
    var i = 0
    while i < 64:
        if (a[i] & 255) == (b[i] & 255):
            val bit: u64 = 1
            val sh: i32 = i
            mask = mask | (bit << sh)
        i = i + 1
    return mask

# Index of the lowest set lane in a 64-lane mask, or 64 when the mask is
# empty. This is the `trailing_zeros()` the byte-search kernels call to turn a
# match mask into a byte offset. Returning 64 (not -1) for the empty mask
# matches what `u64::trailing_zeros` yields, which is the contract the kernel
# relies on when it tests the mask before consuming it.
pub fn mask_first_lane_pure(mask: u64) -> i64:
    var i = 0
    while i < 64:
        val bit: u64 = 1
        val sh: i32 = i
        if (mask & (bit << sh)) != 0:
            return i
        i = i + 1
    return 64

# Population count of a 64-lane mask — `count_ones()`. An AVX-512 UTF-8
# codepoint count is exactly this applied to a non-continuation-byte mask, so
# the reference belongs next to the mask that feeds it.
pub fn mask_lane_count_pure(mask: u64) -> i64:
    var n = 0
    var i = 0
    while i < 64:
        val bit: u64 = 1
        val sh: i32 = i
        if (mask & (bit << sh)) != 0:
            n = n + 1
        i = i + 1
    return n

# `_mm512_shuffle_epi8` over 64 bytes. The trap this encodes: unlike the
# 128-bit two-source PSHUFB twinned above, the AVX-512 form takes ONE source
# and does NOT cross 128-bit lane boundaries — each 16-byte lane is permuted
# independently, and the index is the low FOUR bits (0..15 within the lane),
# not five. Bit 7 set still zeroes the output byte. Writing this with a 5-bit
# index, or letting it index the whole 64-byte vector, is the natural mistake
# and is exactly what a twin is for.
pub fn shuffle_u8x64_pure(a: [i64], mask: [i64]) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < 64:
        val m = mask[i] & 255
        if (m & 128) != 0:
            out.push(0)
        else:
            val lane_base = (i / 16) * 16
            val idx = m & 15
            out.push(a[lane_base + idx] & 255)
        i = i + 1
    return out

# Lane-wise wrapping add / subtract of eight i64 lanes — the 512-bit widening
# of add_i64x4_pure / sub_i64x4_pure above. The property under test is the
# same: no carry crosses a lane boundary.
pub fn add_i64x8_pure(a: [i64], b: [i64]) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < 8:
        out.push(a[i] + b[i])
        i = i + 1
    return out

pub fn sub_i64x8_pure(a: [i64], b: [i64]) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < 8:
        out.push(a[i] - b[i])
        i = i + 1
    return out

# Horizontal maximum / minimum of eight i64 lanes. Comparisons, so exact — the
# same argument that admits hmax_f32x4_pure. Integer lanes additionally avoid
# the NaN-ordering question entirely.
pub fn hmax_i64x8_pure(lanes: [i64]) -> i64:
    var best = lanes[0]
    var i = 1
    while i < 8:
        if lanes[i] > best:
            best = lanes[i]
        i = i + 1
    return best

pub fn hmin_i64x8_pure(lanes: [i64]) -> i64:
    var best = lanes[0]
    var i = 1
    while i < 8:
        if lanes[i] < best:
            best = lanes[i]
        i = i + 1
    return best
