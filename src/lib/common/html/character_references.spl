# HTML character references — the one home for turning `&amp;`, `&#233;` and
# `&#x2014;` into the characters they denote.
#
# `common` is importable from every lane, including leaf lanes such as `blink`
# that may not reach into `gc_async_mut`, so this is where the decoding lives.
# `common.html.entities` delegates its legacy `decode_html_entity` /
# `decode_html_entities` API here rather than keeping a second table.
#
# ---------------------------------------------------------------------------
# NOTHING HERE EVER GUESSES.
# ---------------------------------------------------------------------------
# Every lookup returns `text?`, and `match_entity` returns an `EntityMatch`
# carrying an explicit `ok` flag and a human-readable `error`. An input this
# module does not understand is reported, never replaced by a plausible-looking
# character. Emitting a wrong character for a bad reference is exactly the class
# of bug that hides for months, because a wrong glyph looks like content while a
# reported failure does not.
#
# The four ways a reference can fail, all explicit:
#   1. UNTERMINATED — `&amp` or `&#39` with no `;` before the scan window ends.
#   2. UNKNOWN NAME — `&bogus;`, a name not in the table below.
#   3. MALFORMED NUMERIC — `&#;`, `&#x;`, `&#12z4;`, digits that do not parse.
#   4. OUT-OF-RANGE NUMERIC — NUL, a lone surrogate (U+D800..U+DFFF), or a
#      value above U+10FFFF. These are not characters and cannot be produced.
#
# In all four cases the caller's text keeps the source spelling verbatim: an
# undecodable `&bogus;` stays `&bogus;`. That is both the WHATWG-defined
# recovery and the only answer that loses no information.
#
# Deliberate, documented deviations from WHATWG 13.2.5.72:
#   - The terminating `;` is REQUIRED. The legacy semicolon-less forms
#     (`&amp` followed by a non-alphanumeric) are treated as unterminated and
#     left verbatim. Accepting them silently changes where a reference ends.
#   - The named table is the HTML 4 set plus the common typographic, currency,
#     maths and Greek names — not the full 2231-entry WHATWG table. A name
#     outside it is an explicit UNKNOWN NAME failure, never a substitution.
#     Extend this table; do not start a private copy beside it.
#
# Indexing note: this module works on `text.chars()` (a codepoint array)
# throughout and never mixes `text.len()`, which is a BYTE count, with
# `char_code_at`, which is codepoint-indexed. Mixing the two is a live defect
# elsewhere in the tree and is not reproduced here.

# Longest name in the table below is 8 chars (`thetasym`); a numeric reference
# tops out at `&#x10FFFF;`. 32 is a comfortable ceiling that also stops a stray
# `&` in prose from scanning to the end of a document.
#
# This is a FUNCTION, not a module-level `val`, on purpose. A module-level `val`
# initialised in one module and read from a JIT-compiled caller in another reads
# back as 0 (see `reference_jit_module_level_val_from_function_call_reads_zero`).
# A zero window here would make every reference look unterminated, so blink's
# tokenizer would pass `&amp;` through verbatim while the same call from an
# interpreted caller decoded it — a silent engine-dependent wrong answer. This
# was observed for real during development, not guarded against speculatively.
fn _max_reference_chars() -> i64:
    """Maximum characters scanned after `&` when looking for the `;`."""
    32

# =============================================================================
# EntityMatch — the result of reading one reference out of a character array.
# =============================================================================

struct EntityMatch:
    """One attempt to read a character reference at a given position.

    `ok` true: `value` holds the decoded characters and `consumed` counts the
    characters read starting at the `&`. `ok` false: `value` is empty,
    `consumed` is 0, and `error` says which of the four failures it was.
    """
    ok: bool
    value: text
    consumed: i64
    error: text

struct EntityDecode:
    """A decoded string plus every reference that could not be decoded."""
    value: text
    errors: [text]

# =============================================================================
# Named references
# =============================================================================

fn named_entity_code(name: text) -> i64:
    """Codepoint for the named reference `name` (no `&`/`;`), or -1 if unknown.

    Names are CASE-SENSITIVE per WHATWG: `&amp;` and `&AMP;` are both defined,
    `&Amp;` is not. The uppercase spellings that HTML actually defines are
    listed explicitly rather than folded.
    """
    # --- the five that must always work -------------------------------------
    if name == "amp": return 38
    if name == "AMP": return 38
    if name == "lt": return 60
    if name == "LT": return 60
    if name == "gt": return 62
    if name == "GT": return 62
    if name == "quot": return 34
    if name == "QUOT": return 34
    if name == "apos": return 39

    # --- Latin-1 supplement (HTML 4 / ISO-8859-1) ---------------------------
    if name == "nbsp": return 160
    if name == "iexcl": return 161
    if name == "cent": return 162
    if name == "pound": return 163
    if name == "curren": return 164
    if name == "yen": return 165
    if name == "brvbar": return 166
    if name == "sect": return 167
    if name == "uml": return 168
    if name == "copy": return 169
    if name == "COPY": return 169
    if name == "ordf": return 170
    if name == "laquo": return 171
    if name == "not": return 172
    if name == "shy": return 173
    if name == "reg": return 174
    if name == "REG": return 174
    if name == "macr": return 175
    if name == "deg": return 176
    if name == "plusmn": return 177
    if name == "sup2": return 178
    if name == "sup3": return 179
    if name == "acute": return 180
    if name == "micro": return 181
    if name == "para": return 182
    if name == "middot": return 183
    if name == "cedil": return 184
    if name == "sup1": return 185
    if name == "ordm": return 186
    if name == "raquo": return 187
    if name == "frac14": return 188
    if name == "frac12": return 189
    if name == "frac34": return 190
    if name == "iquest": return 191
    if name == "Agrave": return 192
    if name == "Aacute": return 193
    if name == "Acirc": return 194
    if name == "Atilde": return 195
    if name == "Auml": return 196
    if name == "Aring": return 197
    if name == "AElig": return 198
    if name == "Ccedil": return 199
    if name == "Egrave": return 200
    if name == "Eacute": return 201
    if name == "Ecirc": return 202
    if name == "Euml": return 203
    if name == "Igrave": return 204
    if name == "Iacute": return 205
    if name == "Icirc": return 206
    if name == "Iuml": return 207
    if name == "ETH": return 208
    if name == "Ntilde": return 209
    if name == "Ograve": return 210
    if name == "Oacute": return 211
    if name == "Ocirc": return 212
    if name == "Otilde": return 213
    if name == "Ouml": return 214
    if name == "times": return 215
    if name == "Oslash": return 216
    if name == "Ugrave": return 217
    if name == "Uacute": return 218
    if name == "Ucirc": return 219
    if name == "Uuml": return 220
    if name == "Yacute": return 221
    if name == "THORN": return 222
    if name == "szlig": return 223
    if name == "agrave": return 224
    if name == "aacute": return 225
    if name == "acirc": return 226
    if name == "atilde": return 227
    if name == "auml": return 228
    if name == "aring": return 229
    if name == "aelig": return 230
    if name == "ccedil": return 231
    if name == "egrave": return 232
    if name == "eacute": return 233
    if name == "ecirc": return 234
    if name == "euml": return 235
    if name == "igrave": return 236
    if name == "iacute": return 237
    if name == "icirc": return 238
    if name == "iuml": return 239
    if name == "eth": return 240
    if name == "ntilde": return 241
    if name == "ograve": return 242
    if name == "oacute": return 243
    if name == "ocirc": return 244
    if name == "otilde": return 245
    if name == "ouml": return 246
    if name == "divide": return 247
    if name == "oslash": return 248
    if name == "ugrave": return 249
    if name == "uacute": return 250
    if name == "ucirc": return 251
    if name == "uuml": return 252
    if name == "yacute": return 253
    if name == "thorn": return 254
    if name == "yuml": return 255

    # --- Latin extended / punctuation ---------------------------------------
    if name == "OElig": return 338
    if name == "oelig": return 339
    if name == "Scaron": return 352
    if name == "scaron": return 353
    if name == "Yuml": return 376
    if name == "fnof": return 402
    if name == "circ": return 710
    if name == "tilde": return 732
    if name == "ensp": return 8194
    if name == "emsp": return 8195
    if name == "thinsp": return 8201
    if name == "zwnj": return 8204
    if name == "zwj": return 8205
    if name == "lrm": return 8206
    if name == "rlm": return 8207
    if name == "ndash": return 8211
    if name == "mdash": return 8212
    if name == "lsquo": return 8216
    if name == "rsquo": return 8217
    if name == "sbquo": return 8218
    if name == "ldquo": return 8220
    if name == "rdquo": return 8221
    if name == "bdquo": return 8222
    if name == "dagger": return 8224
