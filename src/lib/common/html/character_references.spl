    if name == "lang": return 9001
    if name == "rang": return 9002
    if name == "loz": return 9674
    if name == "spades": return 9824
    if name == "clubs": return 9827
    if name == "hearts": return 9829
    if name == "diams": return 9830

    # --- Greek ---------------------------------------------------------------
    if name == "Alpha": return 913
    if name == "Beta": return 914
    if name == "Gamma": return 915
    if name == "Delta": return 916
    if name == "Epsilon": return 917
    if name == "Zeta": return 918
    if name == "Eta": return 919
    if name == "Theta": return 920
    if name == "Iota": return 921
    if name == "Kappa": return 922
    if name == "Lambda": return 923
    if name == "Mu": return 924
    if name == "Nu": return 925
