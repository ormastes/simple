    -1

fn named_entity(name: text) -> text?:
    """Return the character `name` denotes, or nil when the name is unknown.

    nil means UNKNOWN NAME. It never means "probably a `&`" — the caller keeps
    the source spelling so nothing is invented.
    """
    val code = named_entity_code(name)
    if code < 0:
        return nil
    code.to_char()

# =============================================================================
# Numeric references
# =============================================================================

fn _windows_1252_code(code: i64) -> i64:
    """Map a C1 numeric reference to the character HTML says it means.

    U+0080..U+009F are C1 controls, but every real document that writes
    `&#151;` means an em dash: the authors typed windows-1252 byte values.
    WHATWG 13.2.5.80 mandates this substitution table, so it is a SPECIFIED
    translation, not a guess — the one place in this module where the output
    codepoint differs from the input number, and it is required to.
    """
    if code == 128: return 8364
    if code == 130: return 8218
    if code == 131: return 402
    if code == 132: return 8222
    if code == 133: return 8230
    if code == 134: return 8224
    if code == 135: return 8225
    if code == 136: return 710
    if code == 137: return 8240
    if code == 138: return 352
    if code == 139: return 8249
    if code == 140: return 338
    if code == 142: return 381
    if code == 145: return 8216
    if code == 146: return 8217
    if code == 147: return 8220
    if code == 148: return 8221
    if code == 149: return 8226
    if code == 150: return 8211
    if code == 151: return 8212
    if code == 152: return 732
    if code == 153: return 8482
    if code == 154: return 353
    if code == 155: return 8250
    if code == 156: return 339
    if code == 158: return 382
    if code == 159: return 376
    # 129, 141, 143, 144, 157 have no windows-1252 meaning; they stay as-is.
    code

fn _digit_value(ch: i64, hex: bool) -> i64:
    """Digit value of codepoint `ch` in base 10 or 16, or -1 when not a digit."""
    if ch >= 48 and ch <= 57:
        return ch - 48
    if not hex:
        return -1
    if ch >= 97 and ch <= 102:
        return ch - 87
    if ch >= 65 and ch <= 70:
        return ch - 55
    -1

fn numeric_entity(body: text) -> text?:
    """Decode a numeric reference body — the part between `&#` and `;`.

    `body` is `"233"` for `&#233;` and `"x2014"` / `"X2014"` for `&#x2014;`.
    Returns nil for MALFORMED (no digits, a non-digit character) and for
    OUT-OF-RANGE (NUL, a lone surrogate, above U+10FFFF) input. Both are
    failures the caller must surface; neither yields a substitute character.
    """
    var rest = body
    var hex = false
    if body.starts_with("x") or body.starts_with("X"):
        hex = true
        rest = body.slice(1, body.len())
    val digits = rest.chars()
    if digits.len() == 0:
        return nil

    var code = 0
    var i = 0
    while i < digits.len():
        var d = -1
        match digits.at(i):
            Some(c):
                d = _digit_value(c.char_code_at(0), hex)
            None:
                d = -1
        if d < 0:
            return nil
        if hex:
            code = code * 16 + d
        else:
            code = code * 10 + d
        # Bail out before overflow rather than wrapping to a wrong codepoint.
        if code > 1114111:
            return nil
        i = i + 1

    if code == 0:
        return nil
    if code >= 55296 and code <= 57343:
        return nil
    if code > 1114111:
        return nil
    if code >= 128 and code <= 159:
        return _windows_1252_code(code).to_char()
    code.to_char()

# =============================================================================
# Matching one reference in a character array
# =============================================================================

fn match_entity(chars: [text], amp: i64) -> EntityMatch:
    """Read the character reference that starts at `chars[amp]` (an `&`).

    On success `consumed` counts every character from the `&` through the `;`
    inclusive, so a caller advances by exactly that. On failure `consumed` is 0
    and `error` names the failure; the caller must then emit the source
    characters verbatim.
    """
    val n = chars.len()
    var at_amp = false
    match chars.at(amp):
        Some(c):
            at_amp = c == "&"
        None:
            at_amp = false
    if not at_amp:
        return EntityMatch(ok: false, value: "", consumed: 0, error: "not a character reference: no '&' at this position")

    # Scan for the terminating ';' within the reference window.
    var j = amp + 1
    var semi = -1
    val window = _max_reference_chars()
    while j < n and j - amp <= window:
        var ch = ""
        match chars.at(j):
            Some(c):
                ch = c
            None:
                ch = ""
        if ch == ";":
            semi = j
            j = n
        else:
            # A second '&', or whitespace, ends any plausible reference. Stop
            # here so `Tom & Jerry; ok` does not swallow half the sentence.
            if ch == "&" or ch == " " or ch == "\t" or ch == "\n" or ch == "\r" or ch == "<":
                j = n
            else:
                j = j + 1

    if semi < 0:
        return EntityMatch(ok: false, value: "", consumed: 0, error: "unterminated character reference: no ';' found")

    var body = ""
    var k = amp + 1
    while k < semi:
        match chars.at(k):
            Some(c):
                body = body + c
            None:
                body = body
        k = k + 1

    if body == "":
        return EntityMatch(ok: false, value: "", consumed: 0, error: "empty character reference '&;'")

    val consumed = semi - amp + 1

    if body.starts_with("#"):
        val num_body = body.slice(1, body.len())
        val decoded = numeric_entity(num_body)
        if val d = decoded:
            return EntityMatch(ok: true, value: d, consumed: consumed, error: "")
        return EntityMatch(ok: false, value: "", consumed: 0, error: "malformed or out-of-range numeric character reference '&" + body + ";'")

    val named = named_entity(body)
    if val nv = named:
        return EntityMatch(ok: true, value: nv, consumed: consumed, error: "")
    EntityMatch(ok: false, value: "", consumed: 0, error: "unknown named character reference '&" + body + ";'")

# =============================================================================
# Whole-string decoding
# =============================================================================

fn decode_character_references_checked(input: text) -> EntityDecode:
    """Decode every character reference in `input`, collecting the failures.

    A reference that cannot be decoded is copied through EXACTLY as written and
    its reason is appended to `errors`, so a caller that cares (a validating
    parser, a spec) can see the problem while a caller that does not still gets
    readable text with nothing invented.
    """
    val chars = input.chars()
    val n = chars.len()
    var parts: [text] = []
    var errors: [text] = []
    var i = 0
    while i < n:
        var ch = ""
        match chars.at(i):
            Some(c):
                ch = c
            None:
                ch = ""
        if ch == "&":
            val m = match_entity(chars, i)
            if m.ok:
                parts.push(m.value)
                i = i + m.consumed
            else:
                errors.push(m.error)
                parts.push(ch)
                i = i + 1
        else:
            parts.push(ch)
            i = i + 1
    EntityDecode(value: parts.join(""), errors: errors)

fn decode_character_references(input: text) -> text:
    """Decode every character reference in `input`, leaving bad ones verbatim.

    Convenience over `decode_character_references_checked` for callers that
    want the text and treat an undecodable reference as literal content, which
    is what a browser does. Use the checked form when the failures matter.
    """
    decode_character_references_checked(input).value
