    if name == "euro": return 8364
    if name == "trade": return 8482
    if name == "TRADE": return 8482

    # --- arrows, maths, misc symbols ----------------------------------------
    if name == "larr": return 8592
    if name == "uarr": return 8593
    if name == "rarr": return 8594
    if name == "darr": return 8595
    if name == "harr": return 8596
    if name == "crarr": return 8629
    if name == "lArr": return 8656
    if name == "uArr": return 8657
    if name == "rArr": return 8658
    if name == "dArr": return 8659
    if name == "hArr": return 8660
    if name == "forall": return 8704
    if name == "part": return 8706
    if name == "exist": return 8707
    if name == "empty": return 8709
    if name == "nabla": return 8711
    if name == "isin": return 8712
    if name == "notin": return 8713
    if name == "ni": return 8715
    if name == "prod": return 8719
    if name == "sum": return 8721
    if name == "minus": return 8722
    if name == "lowast": return 8727
    if name == "radic": return 8730
    if name == "prop": return 8733
    if name == "infin": return 8734
    if name == "ang": return 8736
    if name == "and": return 8743
    if name == "or": return 8744
    if name == "cap": return 8745
    if name == "cup": return 8746
    if name == "int": return 8747
    if name == "there4": return 8756
    if name == "sim": return 8764
    if name == "cong": return 8773
    if name == "asymp": return 8776
    if name == "ne": return 8800
    if name == "equiv": return 8801
    if name == "le": return 8804
    if name == "ge": return 8805
    if name == "sub": return 8834
    if name == "sup": return 8835
