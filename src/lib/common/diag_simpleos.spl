# Allocation-free diagnostic counters for the freestanding render/input lane.
var _queued: i64 = 0
var _submitted: i64 = 0
var _completed: i64 = 0
var _drained: i64 = 0
var _dispatched: i64 = 0
var _provenance_mismatches: i64 = 0

fn dbg_stage_on() -> bool: false
fn dbg_events_on() -> bool: false
fn dbg_stage(component: text, stage: text): pass_dn
fn dbg_event_hop(chain_id: text, hop: text, detail: text): pass_dn

fn dbg_count(label: text, delta: i64):
    match label:
        "host_gpu.queued": _queued = _queued + delta
        "host_gpu.submitted": _submitted = _submitted + delta
        "host_gpu.completed": _completed = _completed + delta
        "host_gpu.drained": _drained = _drained + delta
        "host_gpu.dispatched": _dispatched = _dispatched + delta
        _: pass_dn

fn dbg_counter_value(label: text) -> i64:
    match label:
        "host_gpu.queued": _queued
        "host_gpu.submitted": _submitted
        "host_gpu.completed": _completed
        "host_gpu.drained": _drained
        "host_gpu.dispatched": _dispatched
        _: 0

fn dbg_provenance(claimed: text, actual: text, context: text) -> bool:
    if claimed == actual:
        return true
    _provenance_mismatches = _provenance_mismatches + 1
    false

export dbg_stage, dbg_stage_on, dbg_event_hop, dbg_events_on, dbg_count, dbg_counter_value, dbg_provenance
