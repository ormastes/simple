# Fresh typed byte-array concatenation for bootstrap producers without concat dispatch.
# Both inputs retain their values; the result always has independent array storage.

export bytes_concat_copy_v1

# @workaround bug=native_array_concat_dispatch_bootstrap_2026_10_16 recover=1986eb71e4ad1d334d795a4706c2bd06e7a0722b reason=baked bootstrap producer cannot dispatch array concat
fn bytes_concat_copy_v1(left: [u8], right: [u8]) -> [u8]:
    var out: [u8] = []
    var index: i64 = 0
    while index < left.len():
        out.push(left[index])
        index = index + 1
    index = 0
    while index < right.len():
        out.push(right[index])
        index = index + 1
    out
