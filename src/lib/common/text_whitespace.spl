# Space-token splitting with the established per-token trim contract.
# Kept independent of formatting and StringBuilder for compiler consumers.

pub fn split_whitespace(text: text) -> [text]:
    """Split text by whitespace, removing empty tokens.

    Example:
        split_whitespace("hello   world  \n foo")  # ["hello", "world", "foo"]
    """
    val parts = text.split(" ")
    var result: [text] = []

    for part in parts:
        val trimmed = part.trim()
        if trimmed.len() > 0:
            result.push(trimmed)

    return result
