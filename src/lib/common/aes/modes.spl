# AES-CTR (NIST SP 800-38A §6.5) and AES-CBC (§6.2) modes — pure Simple.
#
# Builds both modes on the AES block cipher in std.common.crypto.aes_gcm.
# Supports AES-128 (16-byte key) and AES-256 (32-byte key), selected by key
# length. The IV is the initial 128-bit counter block; for each successive
# block the entire counter block is incremented by 1 as a big-endian integer
# (the standard incrementing function), matching the SP 800-38A F.5 vectors
# and SSH aes128-ctr / aes256-ctr (RFC 4344).
#
# AES-CBC comes in two shapes sharing one chaining implementation:
#   aes_cbc_encrypt / aes_cbc_decrypt             — PKCS#7 padded (below)
#   aes_cbc_encrypt_blocks_no_padding /           — raw blocks, exact
#   aes_cbc_decrypt_blocks_no_padding               multiple-of-16 only
#                                                     (SQLCipher 4 page codec)
#
# All public inputs/outputs are [i64] byte lists (values 0-255). Encryption
# and decryption are the identical XOR-keystream operation for CTR; for CBC
# the ciphertext is always a whole number of 16-byte blocks (plus one PKCS#7
# block on the padded path).

use std.common.crypto.aes_gcm.{
    aes128_key_expansion,
    aes256_key_expansion,
    aes128_encrypt_block,
    aes256_encrypt_block,
    aes128_decrypt_block,
    aes256_decrypt_block
}

# Privileged native byte read (src/lib is allowed raw rt_*; mirrors aes_gcm.spl).
extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64

# Convert an [i64] byte list (values 0-255) into a native [u8] buffer.
fn _i64_to_u8(arr: [i64]) -> [u8]:
    var out: [u8] = []
    var i = 0
    val n = arr.len()
    while i < n:
        out.push((arr[i] & 0xFF).to_u8())
        i = i + 1
    out

# Overwrite a byte-list scratch buffer with zeros before it is dropped.
#
# WHY ELEMENT ASSIGNMENT: std.common.crypto.secure_memory's volatile wipe
# (secure_zero_*_slots) is the compiler-resistant owner, but its raw-pointer
# externs are not callable through every shipping toolchain (under the current
# bootstrap-seed test runner `rt_array_data_ptr_text` is an unknown extern and
# the i64-slot path reports unverified — see
# doc/08_tracking/bug/secure_memory_volatile_wipe_unavailable_under_seed_test_runner_2026-10-22.md).
# Element assignment is the plain-language wipe idiom already used by
# std.common.crypto.x25519_mlkem768.raw_workload_binding (`_raw_wipe`); it
# makes no readback guarantee, only that no stale bytes are left in the live
# buffer. These helpers take owned scratch, never caller secrets.
fn _zeroize_i64(scratch: [i64]):
    var i = 0
    val n = scratch.len()
    while i < n:
        scratch[i] = 0
        i = i + 1

fn _zeroize_u8(scratch: [u8]):
    var i = 0
    val n = scratch.len().to_i64()
    while i < n:
        scratch[i] = 0u8
        i = i + 1

# Big-endian increment-by-1 of a counter block (returns a fresh [i64]).
fn _ctr_increment(counter: [i64]) -> [i64]:
    val n = counter.len()
    # Add the carry from the least-significant byte upward into a reversed list.
    var rev: [i64] = []
    var carry = 1
    var i = n - 1
    while i >= 0:
        val sum = (counter[i] & 0xFF) + carry
        rev.push(sum & 0xFF)
        carry = (sum >> 8) & 1
        i = i - 1
    # Reverse back to big-endian byte order.
    var out: [i64] = []
    var j = rev.len() - 1
    while j >= 0:
        out.push(rev[j])
        j = j - 1
    out

# AES-CTR encryption. key: 16 bytes (AES-128) or 32 bytes (AES-256).
# iv: 16-byte initial counter block. Returns ciphertext of the same length
# as the plaintext (the final partial block uses a truncated keystream).
fn aes_ctr_encrypt(plaintext: [i64], key: [i64], iv: [i64]) -> [i64]:
    val is_256 = key.len() == 32
    val key_u8 = _i64_to_u8(key)
    val schedule = if is_256: aes256_key_expansion(key_u8) else: aes128_key_expansion(key_u8)

    # Mutable big-endian counter, initialised to the IV.
    var counter: [i64] = []
    var c = 0
    while c < iv.len():
        counter.push(iv[c])
        c = c + 1

    var out: [i64] = []
    val n = plaintext.len()
    var off = 0
    while off < n:
        val ctr_u8 = _i64_to_u8(counter)
        val keystream = if is_256: aes256_encrypt_block(ctr_u8, schedule) else: aes128_encrypt_block(ctr_u8, schedule)
        var b = 0
        while b < 16 and (off + b) < n:
            out.push(plaintext[off + b] ^ rt_bytes_u8_at(keystream, b))
            b = b + 1
        counter = _ctr_increment(counter)
        off = off + 16
    out

# AES-CTR decryption is identical to encryption (XOR of the same keystream).
fn aes_ctr_decrypt(ciphertext: [i64], key: [i64], iv: [i64]) -> [i64]:
    aes_ctr_encrypt(ciphertext, key, iv)

# ============================================================================
# AES-CBC mode (NIST SP 800-38A §6.2) with PKCS#7 padding (RFC 5652 §6.3)
#
# History: until 2026-08-08 `aes_cbc_encrypt`/`aes_cbc_decrypt` were
# undocumented aliases that simply called the CTR functions above — there was
# no chaining and no padding, while every caller's documentation claimed
# "AES-256-CBC with PKCS7 padding". See
# doc/08_tracking/bug/credential_store_aes_cbc_label_is_actually_ctr_with_deterministic_iv_2026-08-07.md
#
# Unlike CTR, CBC changes the message length: the ciphertext is always the
# plaintext length rounded UP to the next multiple of 16, and a plaintext that
# is already block-aligned still gains a full block of padding (so decryption
# can never be ambiguous about how much padding to strip).
#
# The IV is a caller-supplied parameter, exactly as for CTR. It MUST be
# unpredictable and fresh for every encryption, and must be stored alongside
# the ciphertext. Generating it is deliberately NOT this module's job:
# src/lib/common/** is the pure tier and has no OS randomness. Callers in the
# I/O tiers (e.g. std.terminal.credential.store) draw it from the OS CSPRNG.
# ============================================================================

# PKCS#7-pad `data` to a whole number of 16-byte blocks. A block-aligned input
# gains a full extra block (16 bytes of 0x10), per RFC 5652 §6.3.
fn _pkcs7_pad_16(data: [i64]) -> [i64]:
    var out: [i64] = []
    var i = 0
    val n = data.len()
    while i < n:
        out.push(data[i] & 0xFF)
        i = i + 1
    val pad_len = 16 - (n % 16)
    var p = 0
    while p < pad_len:
        out.push(pad_len)
        p = p + 1
    out

# Strip and VALIDATE PKCS#7 padding. Returns nil when the padding is invalid.
#
# This fails CLOSED on purpose: an invalid trailer is an explicit decryption
# failure, not plaintext.
#
# HISTORY: this local copy was written because std.common.aes.padding
# `pkcs7_unpad` used to return its input unchanged when validation failed,
# which under a wrong key handed raw padding bytes back to the caller as if
# they were plaintext. That is NO LONGER TRUE -- padding.spl now fails closed
# too and bounds the pad length by block_size. This copy is kept because it is
# specialised to a fixed 16-byte block and takes `[i64]`; a future consolidation
# onto `pkcs7_unpad(data, 16)` is reasonable. Do not cite padding.spl as
# fail-open. See doc/08_tracking/bug/jit_param_passed_list_element_read_returns_tagged_2026-08-08.md
fn _pkcs7_unpad_16(data: [i64]) -> [i64]?:
    val n = data.len()
    if n == 0 or (n % 16) != 0:
        return nil
    val pad_len = data[n - 1] & 0xFF
    if pad_len < 1 or pad_len > 16:
        return nil
    var p = 0
    while p < pad_len:
        if (data[n - 1 - p] & 0xFF) != pad_len:
            return nil
        p = p + 1
    var out: [i64] = []
    var i = 0
    val keep = n - pad_len
    while i < keep:
        out.push(data[i] & 0xFF)
        i = i + 1
    out

# AES-CBC encryption with PKCS#7 padding.
# key: 16 bytes (AES-128) or 32 bytes (AES-256). iv: 16 bytes, unpredictable
# and unique per encryption. Returns [] on invalid key/IV size.
fn aes_cbc_encrypt(plaintext: [i64], key: [i64], iv: [i64]) -> [i64]:
    if key.len() != 16 and key.len() != 32:
        return []
    if iv.len() != 16:
        return []
    val is_256 = key.len() == 32
    val schedule = if is_256: aes256_key_expansion(_i64_to_u8(key)) else: aes128_key_expansion(_i64_to_u8(key))

    val padded = _pkcs7_pad_16(plaintext)

    # `prev` is the IV for the first block and the previous ciphertext block
    # thereafter (the CBC chaining value).
    var prev: [i64] = []
    var c = 0
    while c < 16:
        prev.push(iv[c] & 0xFF)
        c = c + 1

    var out: [i64] = []
    var off = 0
    val n = padded.len()
    while off < n:
        # XOR the plaintext block with the chaining value, then encrypt it.
        var block: [i64] = []
        var b = 0
        while b < 16:
            block.push(padded[off + b] ^ prev[b])
            b = b + 1
        val enc = if is_256: aes256_encrypt_block(_i64_to_u8(block), schedule) else: aes128_encrypt_block(_i64_to_u8(block), schedule)
        var next: [i64] = []
        var e = 0
        while e < 16:
            val byte = rt_bytes_u8_at(enc, e)
            next.push(byte)
            out.push(byte)
            e = e + 1
        prev = next
        off = off + 16
    out

# AES-CBC decryption with PKCS#7 padding validation.
# Returns nil when the key/IV size is wrong, the ciphertext is not a non-empty
# multiple of 16 bytes, or the recovered padding is invalid (which is what a
# wrong key almost always produces).
fn aes_cbc_decrypt(ciphertext: [i64], key: [i64], iv: [i64]) -> [i64]?:
    if key.len() != 16 and key.len() != 32:
        return nil
    if iv.len() != 16:
        return nil
    val n = ciphertext.len()
    if n == 0 or (n % 16) != 0:
        return nil
    val is_256 = key.len() == 32
    val schedule = if is_256: aes256_key_expansion(_i64_to_u8(key)) else: aes128_key_expansion(_i64_to_u8(key))

    var prev: [i64] = []
    var c = 0
    while c < 16:
        prev.push(iv[c] & 0xFF)
        c = c + 1

    var padded: [i64] = []
    var off = 0
    while off < n:
        var block: [i64] = []
        var b = 0
        while b < 16:
            block.push(ciphertext[off + b] & 0xFF)
            b = b + 1
        # Inverse cipher, then XOR with the chaining value to undo the CBC XOR.
        val dec = if is_256: aes256_decrypt_block(_i64_to_u8(block), schedule) else: aes128_decrypt_block(_i64_to_u8(block), schedule)
        var d = 0
        while d < 16:
            padded.push(rt_bytes_u8_at(dec, d) ^ prev[d])
            d = d + 1
        prev = block
        off = off + 16

    _pkcs7_unpad_16(padded)

# ============================================================================
# AES-CBC raw block operations WITHOUT padding (NIST SP 800-38A §6.2 chaining)
#
# CONTRACT (SQLCipher 4 page-codec primitive — master plan §4.4, 2026-10-21)
# ---------------------------------------------------------------------------
#   aes_cbc_encrypt_blocks_no_padding(key, plaintext, iv)
#       -> Result<[i64], CbcNoPaddingError>
#   aes_cbc_decrypt_blocks_no_padding(key, ciphertext, iv)
#       -> Result<[i64], CbcNoPaddingError>
#
#   * key:   16 bytes (AES-128) or 32 bytes (AES-256), [i64] values 0-255.
#   * iv:    exactly 16 bytes; the CBC initial chaining value. Fresh and
#            unpredictable per encryption is the CALLER's job (the pure tier
#            has no OS randomness — see the PKCS#7 section above).
#   * data:  an exact multiple of 16 bytes. Nothing is padded, truncated, or
#            synthesized: N blocks in, N blocks out, so ciphertext length
#            ALWAYS equals plaintext length. A zero-length input is a valid
#            zero-block message and yields Ok([]).
#   * Any other length FAILS CLOSED with Err(InvalidDataLength(n)) — this is
#            the check that keeps 4000/4016-byte SQLCipher page bodies out of
#            the PKCS#7 wrapper above (plan §4.4 forbids routing page
#            plaintext through aes_cbc_encrypt).
#   * Wrong key or IV size fails closed with Err(InvalidKeyLength(n)) /
#     Err(InvalidIvLength(n)); neither function ever invents or strips bytes.
#   * These functions are the ONLY no-padding CBC entry points; aes_cbc_encrypt
#     / aes_cbc_decrypt (PKCS#7) above are unchanged and remain the padded
#     path for application-style callers.
#
# SECURITY NOTES
#   * Both directions chain over the existing FIPS 197-verified AES block
#     primitive from std.common.crypto.aes_gcm; AES itself is never
#     reimplemented here.
#   * CBC ciphertext is MALLEABLE: no integrity. Callers handling untrusted
#     ciphertext must authenticate before decrypting (the SQLCipher 4 codec
#     binds per-page HMAC-SHA512, plan §4.2).
#   * Scratch that transiently holds key or plaintext material — the expanded
#     key schedule, the per-block staging copy, and the chaining value — is
#     overwritten with zeros before being dropped. The compiler-resistant
#     volatile wipe in std.common.crypto.secure_memory is preferred but is not
#     callable through every shipping toolchain today (see the note on
#     _zeroize_i64/_zeroize_u8 above); the element-assignment wipe leaves no
#     stale bytes in the live buffer but makes no readback guarantee. The
#     caller's own key/plaintext lists remain the caller's responsibility.
# ============================================================================

# Why a no-padding input was rejected. The i64 payload is the offending length
# in bytes; the variant identifies WHICH contract clause failed, so callers
# can distinguish geometry errors from key/IV configuration errors.
enum CbcNoPaddingError:
    """Fail-closed rejection reasons for the no-padding CBC operations.

    Variants:
      InvalidKeyLength(n)   — key was not 16 (AES-128) or 32 (AES-256) bytes.
      InvalidIvLength(n)    — IV was not exactly 16 bytes.
      InvalidDataLength(n)  — input length was not a multiple of 16 bytes
                              (or, for page-codec callers, any length the
                              caller's profile does not admit).
    """
    InvalidKeyLength(i64)
    InvalidIvLength(i64)
    InvalidDataLength(i64)

# AES-CBC encryption WITHOUT padding over an exact multiple of 16 bytes.
# key: 16 or 32 bytes; iv: 16 bytes. Ok(ciphertext) has EXACTLY the same
# length as the plaintext; Err fails closed on any non-block-aligned length.
fn aes_cbc_encrypt_blocks_no_padding(key: [i64], plaintext: [i64], iv: [i64]) -> Result<[i64], CbcNoPaddingError>:
    if key.len() != 16 and key.len() != 32:
        return Err(CbcNoPaddingError.InvalidKeyLength(key.len()))
    if iv.len() != 16:
        return Err(CbcNoPaddingError.InvalidIvLength(iv.len()))
    val n = plaintext.len()
    if n % 16 != 0:
        return Err(CbcNoPaddingError.InvalidDataLength(n))
    val is_256 = key.len() == 32
    val key_u8 = _i64_to_u8(key)
    val schedule = if is_256: aes256_key_expansion(key_u8) else: aes128_key_expansion(key_u8)
    # The native key copy is no longer needed once the schedule exists.
    _zeroize_u8(key_u8)

    # `prev` is the IV for the first block and the previous ciphertext block
    # thereafter (the CBC chaining value). It is replaced, never mutated in
    # place, so each generation is volatile-wiped before being dropped.
    var prev: [i64] = []
    var c = 0
    while c < 16:
        prev.push(iv[c] & 0xFF)
        c = c + 1

    var out: [i64] = []
    var off = 0
    while off < n:
        # XOR the plaintext block with the chaining value, then encrypt it.
        var block: [i64] = []
        var b = 0
        while b < 16:
            block.push((plaintext[off + b] & 0xFF) ^ prev[b])
            b = b + 1
        val block_u8 = _i64_to_u8(block)
        val enc = if is_256: aes256_encrypt_block(block_u8, schedule) else: aes128_encrypt_block(block_u8, schedule)
        # Wipe the plaintext-derived staging block and its native copy.
        _zeroize_u8(block_u8)
        _zeroize_i64(block)
        var next: [i64] = []
        var e = 0
        while e < 16:
            val byte = rt_bytes_u8_at(enc, e)
            next.push(byte)
            out.push(byte)
            e = e + 1
        _zeroize_i64(prev)
        prev = next
        off = off + 16
    _zeroize_i64(prev)
    _zeroize_u8(schedule)
    Ok(out)

# AES-CBC decryption WITHOUT padding over an exact multiple of 16 bytes.
# key: 16 or 32 bytes; iv: 16 bytes. Ok(plaintext) has EXACTLY the same length
# as the ciphertext; Err fails closed on any non-block-aligned length. Unlike
# aes_cbc_decrypt, no padding is validated or stripped — the output is the raw
# recovered blocks, which is exactly what the page codec wants.
fn aes_cbc_decrypt_blocks_no_padding(key: [i64], ciphertext: [i64], iv: [i64]) -> Result<[i64], CbcNoPaddingError>:
    if key.len() != 16 and key.len() != 32:
        return Err(CbcNoPaddingError.InvalidKeyLength(key.len()))
    if iv.len() != 16:
        return Err(CbcNoPaddingError.InvalidIvLength(iv.len()))
    val n = ciphertext.len()
    if n % 16 != 0:
        return Err(CbcNoPaddingError.InvalidDataLength(n))
    val is_256 = key.len() == 32
    val key_u8 = _i64_to_u8(key)
    val schedule = if is_256: aes256_key_expansion(key_u8) else: aes128_key_expansion(key_u8)
    _zeroize_u8(key_u8)

    var prev: [i64] = []
    var c = 0
    while c < 16:
        prev.push(iv[c] & 0xFF)
        c = c + 1

    var out: [i64] = []
    var off = 0
    while off < n:
        var block: [i64] = []
        var b = 0
        while b < 16:
            block.push(ciphertext[off + b] & 0xFF)
            b = b + 1
        val block_u8 = _i64_to_u8(block)
        # Inverse cipher, then XOR with the chaining value to undo the CBC XOR.
        val dec = if is_256: aes256_decrypt_block(block_u8, schedule) else: aes128_decrypt_block(block_u8, schedule)
        _zeroize_u8(block_u8)
        _zeroize_i64(block)
        var d = 0
        while d < 16:
            out.push(rt_bytes_u8_at(dec, d) ^ prev[d])
            d = d + 1
        # dec held plaintext material until the XOR above; wipe it now.
        _zeroize_u8(dec)
        var next: [i64] = []
        var e = 0
        while e < 16:
            next.push(ciphertext[off + e] & 0xFF)
            e = e + 1
        _zeroize_i64(prev)
        prev = next
        off = off + 16
    _zeroize_i64(prev)
    _zeroize_u8(schedule)
    Ok(out)

export aes_ctr_encrypt
export aes_ctr_decrypt
export aes_cbc_encrypt
export aes_cbc_decrypt
export aes_cbc_encrypt_blocks_no_padding
export aes_cbc_decrypt_blocks_no_padding
export CbcNoPaddingError
