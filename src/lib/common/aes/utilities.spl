# AES Utilities Module
#
# This module contains utility functions for byte operations, conversions,
# key generation, and debugging

# Import dependencies (circular - types needs utilities for state_get)
use std.common.aes.types

# OS CSPRNG. Rust interpreter path: rand::rngs::OsRng (panics rather than
# degrading on entropy failure). Native path: src/runtime/runtime.c reads
# /dev/urandom. Backs generate_aes_key / generate_iv / generate_nonce below --
# do NOT reroute these through std.common.random_pure, which is an LCG that
# mirrors the same names.
extern fn rt_random_i64() -> i64

# Draw `count` uniformly-random bytes (0-255) from the OS CSPRNG.
fn csprng_bytes(count: i64) -> list:
    var out = []
    var i = 0
    while i < count:
        # One CSPRNG draw per byte; take the low byte, normalising the sign so
        # the result is exactly (value mod 256) with no modulo bias.
        var byte_val = rt_random_i64() % 256
        if byte_val < 0:
            byte_val = byte_val + 256
        out.append(byte_val)
        i = i + 1
    out

# =============================================================================
# BITWISE AND BYTE OPERATIONS
# =============================================================================

# XOR two bytes
# reason: positional aes utilities API
fn xor_byte(a: i64, b: i64) -> i64:
    # Ensure values are in byte range
    val a_mod = a % 256
    val b_mod = b % 256
    # Simple XOR using bitwise operations simulation
    val result = 0
    var bit = 1
    var temp_a = a_mod
    var temp_b = b_mod
    var sum = 0

    # Process each bit
    var i = 0
    while i < 8:
        val bit_a = temp_a % 2
        val bit_b = temp_b % 2
        val xor_bit = 0

        # XOR logic: different bits = 1, same bits = 0
        if bit_a == bit_b:
            # Both 0 or both 1: XOR = 0
            pass
        else:
            # Different: XOR = 1
            sum = sum + bit

        temp_a = temp_a / 2
        temp_b = temp_b / 2
        bit = bit * 2
        i = i + 1

    sum % 256

# XOR two blocks (16 bytes each)
# reason: positional aes utilities API
fn xor_blocks(block_a: list, block_b: list) -> list:
    var result = []
    var i = 0
    while i < 16:
        val xor_val = xor_byte(block_a[i], block_b[i])
        result.append(xor_val)
        i = i + 1
    result

# XOR a list of bytes
# reason: positional aes utilities API
fn xor_bytes_list(bytes_a: list, bytes_b: list) -> list:
    val len_a = bytes_a.length()
    val len_b = bytes_b.length()
    var min_len = 0

    if len_a < len_b:
        min_len = len_a
    else:
        min_len = len_b

    var result = []
    var i = 0
    while i < min_len:
        val xor_val = xor_byte(bytes_a[i], bytes_b[i])
        result.append(xor_val)
        i = i + 1
    result

# Galois Field (GF(2^8)) multiplication
# Used in MixColumns operation
# reason: positional aes utilities API
fn gmul(a: i64, b: i64) -> i64:
    var p = 0
    var temp_a = a % 256
    var temp_b = b % 256

    var i = 0
    while i < 8:
        # If bit is set in b, XOR with a
        if temp_b % 2 == 1:
            p = xor_byte(p, temp_a)

        # Check high bit of a
        val hi_bit_set = temp_a >= 128

        # Left shift a
        temp_a = (temp_a * 2) % 256

        # If high bit was set, reduce by AES polynomial 0x11b
        if hi_bit_set:
            temp_a = xor_byte(temp_a, 0x1b)

        # Right shift b
        temp_b = temp_b / 2
        i = i + 1

    p % 256

# =============================================================================
# BYTE/TEXT CONVERSION
# =============================================================================

# Convert text to byte list
#
# The RETURN type is spelled `[i64]` and NOT bare `list` deliberately, for the
# same reason bytes_to_text's parameter is (see the note below). A bare-`list`
# value handed across a module boundary reads its elements arithmetically
# SHIFTED LEFT BY 3 under the seed JIT, so every consumer in another module
# saw 8x the true byte. This function feeds the credential-store KDF
# (`hkdf_sha256(info: [i64])`), so the corruption changed the derived AES key.
# See doc/08_tracking/bug/credential_derive_key_nondeterministic_and_wrong_under_seed_jit_2026-08-08.md
fn aes_text_to_bytes(text: text) -> [i64]:
    var bytes: [i64] = []
    var i = 0
    val len = text.length()

    while i < len:
        val char = text[i]
        # Simple ASCII conversion (char code)
        val byte = char.ord()
        bytes.append(byte)
        i = i + 1
    bytes

# Convert byte list to text
#
# The parameter is spelled `[i64]` and NOT `list` / `list<i64>` deliberately.
# Under the seed JIT, reading `data[i]` from a param declared `list` or
# `list<i64>` yields the element arithmetically SHIFTED LEFT BY 3 (v*8), so
# `byte.chr()` would decode the wrong character for every byte. `[i64]` is the
# only spelling that reads correctly. See
# doc/08_tracking/bug/jit_param_passed_list_element_read_returns_tagged_2026-08-08.md
fn bytes_to_text(bytes: [i64]) -> text:
    var parts: [text] = []
    var i = 0
    val len = bytes.length()

    while i < len:
        val byte = bytes[i]
        val char = byte.chr()
        parts.push(char)
        i = i + 1
    parts.join("")

# Convert byte to hex string (2 digits)
fn byte_to_hex(byte: i64) -> text:
    val hex_chars = "0123456789abcdef"
    val b = byte % 256
    val high = b / 16
    val low = b % 16
    hex_chars[high] + hex_chars[low]

# Convert byte list to hex string
#
# `[i64]` and NOT `list` / `list<i64>` — same seed-JIT shift-left-3 defect as
# bytes_to_text. This one is security-load-bearing: the credential store
# serializes BOTH the KDF salt and the 32-byte AES key through this function
# ("v2:<hex_salt>:<hex_key>"). With a `list`-spelled param every emitted byte
# was b*8 mod 256, i.e. always ≡ 0 mod 8 — the stored key was neither the key
# that was derived nor a full-entropy one (~160 bits of the 256 survived), and
# the stored salt did not match the salt actually used, so regeneration could
# not reproduce the install's key.
# See doc/08_tracking/bug/credential_store_key_and_salt_corrupted_by_list_param_hex_2026-08-08.md
fn bytes_to_hex(bytes: [i64]) -> text:
    var parts: [text] = []
    var i = 0
    val len = bytes.length()

    while i < len:
        val hex = byte_to_hex(bytes[i])
        parts.push(hex)
        i = i + 1
    parts.join("")

# Convert hex digit to value
fn hex_digit_to_value(char: text) -> i64:
    val code = char.ord()

    # '0'-'9': 48-57
    if code >= 48:
        if code <= 57:
            return code - 48

    # 'a'-'f': 97-102
    if code >= 97:
        if code <= 102:
            return code - 97 + 10

    # 'A'-'F': 65-70
    if code >= 65:
        if code <= 70:
            return code - 65 + 10

    0

# Convert hex string to byte list
# NOTE: return type is [i64], not `list` / `list<i64>`. Under the seed JIT,
# element reads from a `list`-spelled container are silently shifted left by
# 3 in arithmetic (see doc/08_tracking/bug/
# credential_store_key_and_salt_corrupted_by_list_param_hex_2026-08-08.md and
# jit_param_passed_list_element_read_returns_tagged_2026-08-08.md). This
# function's output feeds directly into `credential_load_key` / the AES key
# path, so a `list` spelling here silently corrupts every decoded byte.
fn hex_to_bytes(hex: text) -> [i64]:
    var bytes = []
    var i = 0
    val len = hex.length()

    while i < len:
        if i + 1 < len:
            val high = hex_digit_to_value(hex[i])
            val low = hex_digit_to_value(hex[i + 1])
            val byte = high * 16 + low
            bytes.append(byte)
        i = i + 2
    bytes

# =============================================================================
# KEY AND IV GENERATION
# =============================================================================

# Validate key size
fn is_valid_key_size(key_size: i64) -> i64:
    if key_size == 16:
        return 1
    if key_size == 24:
        return 1
    if key_size == 32:
        return 1
    0

# Prepare key (pad or truncate to valid size)
fn prepare_key(key: text, target_size: i64) -> list:
    val key_bytes = aes_text_to_bytes(key)
    val key_len = key_bytes.length()

    if key_len == target_size:
        return key_bytes

    var prepared = []
    var i = 0
    while i < target_size:
        if i < key_len:
            prepared.append(key_bytes[i])
        else:
            prepared.append(0)
        i = i + 1
    prepared

# Extract key bytes from text (pad or truncate)
fn text_to_key_bytes(key: text, size: i64) -> list:
    prepare_key(key, size)

# Generate random AES key of specified size
fn generate_aes_key(size: i64) -> list:
    val valid = is_valid_key_size(size)
    if valid == 0:
        # Default to AES-128
        return generate_aes_key(16)

    csprng_bytes(size)

# Generate a random IV (16 bytes) from the OS CSPRNG.
#
# An IV/nonce must be unpredictable and, under CTR/GCM, never repeated.
# A previous revision expanded the CONSTANT seed 123 through an LCG, so this
# returned the identical 16 bytes on every call in every process. Under
# CTR/GCM that is a catastrophic keystream reuse (it leaks
# plaintext_A XOR plaintext_B outright); under CBC it leaks first-block
# equality. See the note on generate_iv_from_seed below.
fn generate_iv() -> list:
    csprng_bytes(16)

# Generate random nonce for CTR mode (16 bytes)
fn generate_nonce() -> list:
    csprng_bytes(16)

# DEPRECATED — NOT CRYPTOGRAPHICALLY SUITABLE. Do not use this for a cipher IV
# or nonce.
#
# This expands `seed` with a plain glibc-style LCG (x = x*1103515245 + 12345
# mod 2^31). It is fully deterministic and trivially predictable: the same seed
# always yields the same 16 bytes, and observing a few output bytes recovers
# the state. Reusing an IV under CTR/GCM leaks plaintext_A XOR plaintext_B
# outright; under CBC it leaks first-block equality.
#
# It had exactly one caller, the credential store, which seeded it from a
# checksum of the PLAINTEXT — see
# doc/08_tracking/bug/credential_store_aes_cbc_label_is_actually_ctr_with_deterministic_iv_2026-08-07.md
# That caller was fixed on 2026-08-08 and this function now has no callers.
#
# For a real IV/nonce, use the OS CSPRNG from an I/O tier (`rt_random_hex`,
# backed by OsRng), as std.terminal.credential.store now does. This function is
# retained only for deterministic test fixtures and reproducible vectors.
fn generate_iv_from_seed(seed: i64) -> list:
    var iv = []
    var current_seed = seed
    var i = 0

    while i < 16:
        current_seed = (current_seed * 1103515245 + 12345) % 2147483648
        val byte = current_seed % 256
        iv.append(byte)
        i = i + 1

    iv

# =============================================================================
# DEBUGGING AND TESTING UTILITIES
# =============================================================================

# Print state as 4x4 matrix
fn print_state(state: list) -> text:
    var parts: [text] = []
    var row = 0

    while row < 4:
        var col = 0
        while col < 4:
            val byte = state_get(state, row, col)
            val hex = byte_to_hex(byte)
            parts.push(hex + " ")
            col = col + 1
        parts.push("\n")
        row = row + 1

    parts.join("")

# Print block as hex
fn print_block(block: list) -> text:
    var parts: [text] = []
    var i = 0

    while i < block.length():
        val hex = byte_to_hex(block[i])
        parts.push(hex)
        if (i + 1) % 16 == 0:
            parts.push("\n")
        else:
            if (i + 1) % 4 == 0:
                parts.push(" ")
        i = i + 1

    parts.join("")

# Compare two blocks (for testing)
# reason: positional aes utilities API
fn blocks_equal(block_a: list, block_b: list) -> i64:
    val len_a = block_a.length()
    val len_b = block_b.length()

    if len_a != len_b:
        return 0

    var i = 0
    while i < len_a:
        if block_a[i] != block_b[i]:
            return 0
        i = i + 1

    1

# =============================================================================
# DATA INTEGRITY
# =============================================================================

# Simple checksum for data integrity
fn compute_checksum(data: list) -> i64:
    var sum = 0
    var i = 0
    val len = data.length()

    while i < len:
        sum = sum + data[i]
        i = i + 1

    sum % 256

# Add checksum to data
fn add_checksum(data: list) -> list:
    val checksum = compute_checksum(data)
    var result = []

    var i = 0
    val len = data.length()
    while i < len:
        result.append(data[i])
        i = i + 1

    result.append(checksum)
    result

# Verify and remove checksum
fn verify_checksum(data: list) -> list:
    val len = data.length()

    if len == 0:
        return data

    val stored_checksum = data[len - 1]

    var data_without_checksum = []
    var i = 0
    while i < len - 1:
        data_without_checksum.append(data[i])
        i = i + 1

    val computed_checksum = compute_checksum(data_without_checksum)

    # If checksums match, return data without checksum
    if stored_checksum == computed_checksum:
        return data_without_checksum

    # Otherwise return original data (checksum verification failed)
    data
