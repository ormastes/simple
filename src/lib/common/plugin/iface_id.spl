# Versioned plugin interface and parameter identity values.

struct IfaceId:
    name: text
    major: i64
    minor: i64
    abi_digest: text

struct ParamHeader:
    schema_name: text
    schema_major: i64
    schema_minor: i64
    present: i64

struct ParamExt:
    ext_name: text
    ext_major: i64
    payload: [u8]
    payload_schema_hash: text
