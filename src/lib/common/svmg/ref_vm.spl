# NOTE: `build_arena`/`read_sentinel`/`read_log`/`read_records`/
# `assemble_and_run` are plain `fn`, not `pub fn`, for the same
# `primitive_api`-lint reason documented in opcodes.spl and sgp.spl.

# SVM-G host reference VM (Task D2).
#
# Deterministic single-threaded interpreter of the SVM-G opcode set
# (opcodes.spl) executing on "thread 0 of workgroup 0" (design doc §4.1),
# against an in-memory GMB-1 mailbox arena (mailbox_const.spl). This is the
# host-side implementation CI runs without any GPU (design doc §4.5): the
# same conformance vectors (Task D3) that run here also run, unmodified, on
# the CUDA and Vulkan device implementations.
#
# Execution model:
#  - The SGP blob (header + code + data, sgp.spl) is uploaded at DATA
#    offset 0, exactly like the design specifies for the real device.
#  - Operand stack (256 slots) and call stack (32 frames) are fixed-size,
#    thread-private arrays -- no recursion in the *implementation*, matching
#    the Vulkan-compatible "flat dispatch loop" requirement.
#  - Integer values on the stack are always kept as signed 32-bit values
#    (wrapped after every arithmetic op); float values are carried as their
#    raw IEEE-754 bit pattern (converted to/from `f32` only at the point of
#    a float op), so the stack has one uniform representation.
#  - PARFOR fans a bounded body across the workgroup on real hardware; a
#    single-threaded host has exactly one thread, so PARFOR degenerates to
#    "execute the fanned bytes once, in place" -- semantically the thread-0
#    view of the same program, documented here rather than left implicit.
#  - Buffered mailbox servicing only (design §3.2): PUTC appends to the LOG
#    ring, RESULT appends to the RECORD ring, EXIT writes the sentinel --
#    all inside the returned arena, which callers can drain with the
#    `read_*` helpers below or by reading the raw bytes directly.
#
# Implementation note: the interpreter is a class (SvmgVm) with `me`
# methods, not a function with nested closures -- nested `fn` in this
# language can READ outer locals but cannot MUTATE them (see
# .claude/memory/reference_*nested_closure* notes), which would silently
# break every push/pop/trap helper if written as inner functions.

use std.common.binary_io.{f32_from_bits, f32_to_bits}
use std.common.encoding.utf8.{char_from_codepoint}
use std.common.string_builder.{StringBuilder}
use std.common.svmg.opcodes.*
use std.common.svmg.sgp.{SgpHeader, SGP_HEADER_SIZE, sgp_header_new, encode_sgp_header, decode_sgp_header}
use std.common.svmg.mailbox_const.*

pub val OPERAND_STACK_SIZE: i64 = 256
pub val CALL_STACK_SIZE: i64 = 32

pub struct ResultRecord:
    seq: i64
    passed: i64
    value: i64

pub struct VmRunResult:
    arena: [u8]
    log_cap: i64
    sentinel: i64
    halted: bool
    trapped: bool
    timed_out: bool
    steps_used: i64
    record_count: i64
    # DBG-1: true when this launch stopped because of a DEBUG reason
    # (breakpoint hit or single-step completion) rather than HALT/TRAP/budget.
    # Always false when DBG_FLAGS == 0.
    debug_break: bool
    # PROF-1: instructions retired, ACCUMULATED across resumes (see
    # DBG_STEP_COUNT_OFFSET in mailbox_const.spl). Always 0 when
    # DBG_FLAGS == 0 -- use `steps_used` for the per-launch count.
    step_count: i64

# ============================================================================
# Little-endian byte helpers (plain arrays).
# ============================================================================

fn _u8_at(bytes: [u8], idx: i64) -> i64:
    bytes[idx] as i64

fn _u16_le_at(bytes: [u8], idx: i64) -> i64:
    (bytes[idx] as i64) | ((bytes[idx + 1] as i64) << 8)

fn _i16_le_at(bytes: [u8], idx: i64) -> i64:
    val u = _u16_le_at(bytes, idx)
    if u >= 32768: u - 65536 else: u

fn _u32_le_at(bytes: [u8], idx: i64) -> i64:
    (bytes[idx] as i64) | ((bytes[idx + 1] as i64) << 8) | ((bytes[idx + 2] as i64) << 16) | ((bytes[idx + 3] as i64) << 24)

fn _write_u8(arena: [u8], idx: i64, v: i64) -> [u8]:
    var out = arena
    out[idx] = (v & 0xFF) as u8
    out

fn _write_u32_le(arena: [u8], idx: i64, v: i64) -> [u8]:
    var out = arena
    out[idx] = (v & 0xFF) as u8
    out[idx + 1] = ((v >> 8) & 0xFF) as u8
    out[idx + 2] = ((v >> 16) & 0xFF) as u8
    out[idx + 3] = ((v >> 24) & 0xFF) as u8
    out

fn _read_u32_arena(arena: [u8], idx: i64) -> i64:
    _u32_le_at(arena, idx)

fn _write_u32_le_many(arena: [u8], base: i64, vals: [i64], count: i64) -> [u8]:
    """Write `count` u32s starting at ABSOLUTE arena offset `base`.

    Exists purely so a bulk save (the 256-slot operand stack, the 32-frame
    call stack) costs ONE array clone instead of `count` of them: arrays are
    value types here, so `_write_u32_le` in a loop would copy the whole
    128 KiB arena per field. `base` is absolute, like every other offset in
    this file -- SVM-G STORE/LOAD and the DBG-1 block all address the arena
    by absolute byte offset, never relative to a data offset."""
    var out = arena
    var i = 0
    while i < count:
        val v = vals[i] & 0xFFFFFFFF
        val idx = base + i * 4
        out[idx] = (v & 0xFF) as u8
        out[idx + 1] = ((v >> 8) & 0xFF) as u8
        out[idx + 2] = ((v >> 16) & 0xFF) as u8
        out[idx + 3] = ((v >> 24) & 0xFF) as u8
        i = i + 1
    out

# ============================================================================
# i32 wraparound helpers
# ============================================================================

fn _wrap_i32(v: i64) -> i64:
    val u = v & 0xFFFFFFFF
    if u >= 0x80000000: u - 0x100000000 else: u

fn _to_u32_bits(v: i64) -> i64:
    v & 0xFFFFFFFF

# ============================================================================
# Arena construction
# ============================================================================

fn build_arena(code: [u8], data_init: [u8], step_budget: i64, entry_pc: i64, log_cap: i64) -> [u8]:
    """Build a full 128 KiB GMB-1 arena with an SGP blob uploaded at DATA+0.

    `data_init` is placed immediately after the code section (both are
    "within DATA", per design §4.2); the remainder of the DATA region, and
    the whole REG/LOG/RECORD region, start zeroed.
    """
    val code_off = SGP_HEADER_SIZE
    val code_len = code.len()
    val data_off = code_off + code_len
    val data_len = data_init.len()
    if data_off + data_len > ARENA_DATA_SIZE:
        panic("svmg: SGP blob ({data_off + data_len} bytes) exceeds DATA region ({ARENA_DATA_SIZE} bytes)")
    if REG_BASE_OFFSET + REG_BLOCK_SIZE + 8 + log_cap > ARENA_TOTAL_SIZE:
        panic("svmg: log_cap {log_cap} does not fit in the arena's REG/LOG/RECORD region")

    val header = sgp_header_new(code_off, code_len, data_off, data_len, step_budget, entry_pc)
    val header_bytes = encode_sgp_header(header)

    # Build a zeroed ARENA_TOTAL_SIZE (128 KiB) buffer by doubling
    # (1, 2, 4, ... 131072 = 2^17 = ARENA_TOTAL_SIZE exactly) instead of
    # pushing one byte at a time: arrays are value types here, so a
    # one-at-a-time push loop clones the whole array on every push and
    # costs O(n^2) -- geometric doubling costs O(n) total and is the
    # difference between milliseconds and a multi-minute hang for a
    # 128 KiB buffer under the interpreter.
    var arena: [u8] = [0]
    while arena.len() < ARENA_TOTAL_SIZE:
        arena = arena + arena

    var i = 0
    while i < header_bytes.len():
        arena[i] = header_bytes[i]
        i = i + 1
    i = 0
    while i < code.len():
        arena[code_off + i] = code[i]
        i = i + 1
    i = 0
    while i < data_init.len():
        arena[data_off + i] = data_init[i]
        i = i + 1

    arena = _write_u32_le(arena, LOG_CAP_OFFSET, log_cap)
    arena

# ============================================================================
# Mailbox drain helpers -- read directly from a returned arena.
# ============================================================================

fn read_sentinel(arena: [u8]) -> i64:
    _read_u32_arena(arena, RAM_SENTINEL_OFFSET)

fn read_log(arena: [u8], log_cap: i64) -> text:
    """Decode the LOG ring's used bytes (0..LOG_HEAD) as text."""
    val head = _read_u32_arena(arena, LOG_HEAD_OFFSET)
    val builder = StringBuilder.new()
    var i = 0
    while i < head and i < log_cap:
        builder.push(char_from_codepoint(_u8_at(arena, LOG_DATA_OFFSET + i)))
        i = i + 1
    builder.to_text()

fn read_records(arena: [u8], log_cap: i64, count: i64) -> [ResultRecord]:
    """Decode the first `count` RECORD ring entries (count comes from
    VmRunResult.record_count -- GMB-1 has no record-counter register, so a
    caller with only the raw arena and no known count should treat this as
    best-effort and stop at the first all-zero record instead)."""
    val base = record_ring_base_offset(log_cap)
    var out: [ResultRecord] = []
    var i = 0
    while i < count:
        val off = base + i * RECORD_SIZE
        val seq = _read_u32_arena(arena, off)
        val passed = _read_u32_arena(arena, off + 4)
        # `value` is decoded as a SIGNED i32 (matching SVM-G's signed-i32
        # stack semantics, e.g. SAR of a negative operand), not the raw
        # unsigned u32 wire pattern -- seq/passed stay unsigned since
        # they're a counter and a boolean-ish flag, not program-level ints.
        val value_raw = _read_u32_arena(arena, off + 8)
        val value = if value_raw >= 0x80000000: value_raw - 0x100000000 else: value_raw
        out.push(ResultRecord(seq: seq, passed: passed, value: value))
        i = i + 1
    out

# ============================================================================
# DBG-1 block accessors (host side).
#
# These are the ONLY sanctioned way to poke the debug block: a host debugger
# (and, later, the CUDA/Vulkan/Metal wrappers) writes flags + breakpoints
# into the arena, launches, then reads the saved state back out. All offsets
# are ABSOLUTE arena byte offsets -- see mailbox_const.spl's layout comment.
# ============================================================================

fn dbg_set_flags(arena: [u8], flags: i64) -> [u8]:
    """Set DBG_FLAGS (see DBG_FLAG_* in mailbox_const.spl)."""
    _write_u32_le(arena, DBG_FLAGS_OFFSET, flags)

fn dbg_read_flags(arena: [u8]) -> i64:
    _read_u32_arena(arena, DBG_FLAGS_OFFSET)

fn dbg_set_breakpoints(arena: [u8], pcs: [i64]) -> [u8]:
    """Install the breakpoint table. Panics rather than silently truncating
    when more than DBG_MAX_BREAKPOINTS are supplied -- a dropped breakpoint
    is a debugger that lies about where it stopped. The 'table full' case is
    a conformance vector precisely because the failure mode must be loud."""
    if pcs.len() > DBG_MAX_BREAKPOINTS:
        panic("svmg dbg1: {pcs.len()} breakpoints exceeds DBG_MAX_BREAKPOINTS ({DBG_MAX_BREAKPOINTS})")
    var out = _write_u32_le(arena, DBG_BREAK_COUNT_OFFSET, pcs.len())
    out = _write_u32_le_many(out, DBG_BREAK_PCS_OFFSET, pcs, pcs.len())
    out

fn dbg_read_break_count(arena: [u8]) -> i64:
    _read_u32_arena(arena, DBG_BREAK_COUNT_OFFSET)

fn dbg_read_breakpoint(arena: [u8], idx: i64) -> i64:
    _read_u32_arena(arena, DBG_BREAK_PCS_OFFSET + idx * 4)

fn dbg_read_saved_pc(arena: [u8]) -> i64:
    _read_u32_arena(arena, DBG_SAVED_PC_OFFSET)

fn dbg_read_saved_sp(arena: [u8]) -> i64:
    _read_u32_arena(arena, DBG_SAVED_SP_OFFSET)

fn dbg_read_saved_csp(arena: [u8]) -> i64:
    _read_u32_arena(arena, DBG_SAVED_CSP_OFFSET)

fn dbg_read_step_count(arena: [u8]) -> i64:
    _read_u32_arena(arena, DBG_STEP_COUNT_OFFSET)

fn dbg_read_saved_stack_slot(arena: [u8], idx: i64) -> i64:
    """Saved operand-stack slot `idx`, decoded as a SIGNED i32 -- the operand
    stack carries signed i32 values (see the module docstring), so an
    unsigned readback would misreport every negative operand."""
    val raw = _read_u32_arena(arena, DBG_SAVED_STACK_OFFSET + idx * 4)
    if raw >= 0x80000000: raw - 0x100000000 else: raw

fn dbg_read_saved_call_slot(arena: [u8], idx: i64) -> i64:
    """Saved call-stack frame `idx` (a return pc -- always non-negative)."""
    _read_u32_arena(arena, DBG_SAVED_CALLS_OFFSET + idx * 4)

# ============================================================================
# Interpreter
# ============================================================================

class SvmgVm:
    arena: [u8]
    code: [u8]
    stack: [i64]
    sp: i64
    callstack: [i64]
    csp: i64
    pc: i64
    steps_remaining: i64
    initial_step_budget: i64
    log_cap: i64
    halted: bool
    trapped: bool
    timed_out: bool
    seq: i64
    record_count: i64
    # --- DBG-1 / PROF-1 state. All inert when dbg_flags == 0. ---
    dbg_flags: i64
    dbg_breaks: [i64]
    dbg_break_count: i64
    resumed: bool
    debug_break: bool
    step_count: i64

    static fn new(header: SgpHeader, code: [u8], arena_in: [u8]) -> SvmgVm:
        var stack: [i64] = []
        var i = 0
        while i < OPERAND_STACK_SIZE:
            stack.push(0)
            i = i + 1
        var callstack: [i64] = []
        i = 0
        while i < CALL_STACK_SIZE:
            callstack.push(0)
            i = i + 1

        # DBG-1 launch-time restore (design §3, kernel change 1). When
        # DBG_FLAGS is 0 -- the only state any pre-DBG-1 arena can be in,
        # since build_arena zeroes the whole REG/LOG/RECORD region -- every
        # branch below is skipped and the VM starts exactly as it always
        # did: pc = entry_pc, empty stacks, step_count 0.
        val dbg_flags = _read_u32_arena(arena_in, DBG_FLAGS_OFFSET)
        val dbg_on = (dbg_flags & DBG_FLAG_ENABLED) != 0
        var dbg_breaks: [i64] = []
        var dbg_break_count = 0
        var start_pc = header.entry_pc
        var start_sp = 0
        var start_csp = 0
        var resumed = false
        var step_count = 0
        var start_seq = 0
        var start_record_count = 0
        if dbg_on:
            dbg_break_count = _read_u32_arena(arena_in, DBG_BREAK_COUNT_OFFSET)
            if dbg_break_count > DBG_MAX_BREAKPOINTS:
                panic("svmg dbg1: DBG_BREAK_COUNT {dbg_break_count} exceeds DBG_MAX_BREAKPOINTS ({DBG_MAX_BREAKPOINTS})")
            i = 0
            while i < dbg_break_count:
                dbg_breaks.push(_read_u32_arena(arena_in, DBG_BREAK_PCS_OFFSET + i * 4))
                i = i + 1
            step_count = _read_u32_arena(arena_in, DBG_STEP_COUNT_OFFSET)
            if (dbg_flags & DBG_FLAG_RESUME) != 0:
                resumed = true
                start_seq = _read_u32_arena(arena_in, DBG_SAVED_SEQ_OFFSET)
                start_record_count = _read_u32_arena(arena_in, DBG_SAVED_RECORD_COUNT_OFFSET)
                start_pc = _read_u32_arena(arena_in, DBG_SAVED_PC_OFFSET)
                start_sp = _read_u32_arena(arena_in, DBG_SAVED_SP_OFFSET)
                start_csp = _read_u32_arena(arena_in, DBG_SAVED_CSP_OFFSET)
                i = 0
                while i < OPERAND_STACK_SIZE:
                    val raw = _read_u32_arena(arena_in, DBG_SAVED_STACK_OFFSET + i * 4)
                    stack[i] = if raw >= 0x80000000: raw - 0x100000000 else: raw
                    i = i + 1
                i = 0
                while i < CALL_STACK_SIZE:
                    callstack[i] = _read_u32_arena(arena_in, DBG_SAVED_CALLS_OFFSET + i * 4)
                    i = i + 1

        SvmgVm(
            arena: arena_in,
            code: code,
            stack: stack,
            sp: start_sp,
            callstack: callstack,
            csp: start_csp,
            pc: start_pc,
            steps_remaining: header.step_budget,
            initial_step_budget: header.step_budget,
            log_cap: _read_u32_arena(arena_in, LOG_CAP_OFFSET),
            halted: false,
            trapped: false,
            timed_out: false,
            seq: start_seq,
            record_count: start_record_count,
            dbg_flags: dbg_flags,
            dbg_breaks: dbg_breaks,
            dbg_break_count: dbg_break_count,
            resumed: resumed,
            debug_break: false,
            step_count: step_count,
        )

    me pop() -> i64:
        if self.sp <= 0:
            panic("svmg: operand stack underflow")
        self.sp = self.sp - 1
        self.stack[self.sp]

    me push(v: i64):
        if self.sp >= OPERAND_STACK_SIZE:
            panic("svmg: operand stack overflow")
        self.stack[self.sp] = v
        self.sp = self.sp + 1

    me push_bool(cond: bool):
        if cond:
            self.push(1)
        else:
            self.push(0)

    me peek() -> i64:
        self.stack[self.sp - 1]

    me pop_f32() -> f32:
        f32_from_bits(_to_u32_bits(self.pop()) as u32)

    me push_f32(v: f32):
        self.push(_wrap_i32(f32_to_bits(v) as i64))

    me write_record(pass_val: i64, value: i64):
        val base = record_ring_base_offset(self.log_cap)
        val off = base + self.record_count * RECORD_SIZE
        self.arena = _write_u32_le(self.arena, off, self.seq)
        self.arena = _write_u32_le(self.arena, off + 4, pass_val)
        self.arena = _write_u32_le(self.arena, off + 8, value)
        self.record_count = self.record_count + 1
        self.seq = self.seq + 1

    me append_log_byte(b: i64):
        val head = _read_u32_arena(self.arena, LOG_HEAD_OFFSET)
        val slot = head % self.log_cap
        self.arena = _write_u8(self.arena, LOG_DATA_OFFSET + slot, b)
        self.arena = _write_u32_le(self.arena, LOG_HEAD_OFFSET, head + 1)
        self.seq = self.seq + 1

    me exit_clean(code_val: i64):
        self.arena = _write_u32_le(self.arena, RAM_SENTINEL_OFFSET, SENTINEL_EXIT_MASK | (code_val & 0xFFFF))
        self.seq = self.seq + 1
        self.halted = true

    me trap(trap_value: i64):
        self.write_record(0, trap_value)
        self.arena = _write_u32_le(self.arena, RAM_SENTINEL_OFFSET, SENTINEL_EXIT_MASK | TRAP_OOB_EXIT_CODE)
        self.trapped = true
        self.halted = true

    me bounds_ok(offset: i64, width: i64) -> bool:
        offset >= 0 and offset + width <= ARENA_DATA_SIZE

    me step():
        val pc = self.pc
        val opcode = _u8_at(self.code, pc)
        val kind = operand_kind_of(opcode)
        val operand_len = operand_byte_len(kind)
        val pc_next = pc + 1 + operand_len

        if opcode == OP_NOP:
            self.pc = pc_next
        elif opcode == OP_HALT:
            self.exit_clean(_u8_at(self.code, pc + 1))
        elif opcode == OP_TRAP:
            self.trap(_u8_at(self.code, pc + 1))
        elif opcode == OP_PUSHI:
            self.push(_wrap_i32(_u32_le_at(self.code, pc + 1)))
            self.pc = pc_next
        elif opcode == OP_PUSHF:
            self.push(_wrap_i32(_u32_le_at(self.code, pc + 1)))
            self.pc = pc_next
        elif opcode == OP_DUP:
            self.push(self.peek())
            self.pc = pc_next
        elif opcode == OP_DROP:
            self.pop()
            self.pc = pc_next
        elif opcode == OP_SWAP:
            val y = self.pop()
            val x = self.pop()
            self.push(y)
            self.push(x)
            self.pc = pc_next
        elif opcode == OP_ADD:
            val b = self.pop()
            val a = self.pop()
            self.push(_wrap_i32(a + b))
            self.pc = pc_next
        elif opcode == OP_SUB:
            val b = self.pop()
            val a = self.pop()
            self.push(_wrap_i32(a - b))
            self.pc = pc_next
        elif opcode == OP_MUL:
            val b = self.pop()
            val a = self.pop()
            self.push(_wrap_i32(a * b))
            self.pc = pc_next
        elif opcode == OP_DIV:
            val b = self.pop()
            val a = self.pop()
            if b == 0:
                self.trap(TRAP_DIV0)
            else:
                self.push(_wrap_i32(a / b))
                self.pc = pc_next
        elif opcode == OP_REM:
            val b = self.pop()
            val a = self.pop()
            if b == 0:
                self.trap(TRAP_DIV0)
            else:
                self.push(_wrap_i32(a % b))
                self.pc = pc_next
        elif opcode == OP_FADD:
            val b = self.pop_f32()
            val a = self.pop_f32()
            self.push_f32(a + b)
            self.pc = pc_next
        elif opcode == OP_FSUB:
            val b = self.pop_f32()
            val a = self.pop_f32()
            self.push_f32(a - b)
            self.pc = pc_next
        elif opcode == OP_FMUL:
            val b = self.pop_f32()
            val a = self.pop_f32()
            self.push_f32(a * b)
            self.pc = pc_next
        elif opcode == OP_FDIV:
            val b = self.pop_f32()
            val a = self.pop_f32()
            self.push_f32(a / b)
            self.pc = pc_next
        elif opcode == OP_AND:
            val b = self.pop()
            val a = self.pop()
            self.push(_wrap_i32(a & b))
            self.pc = pc_next
        elif opcode == OP_OR:
            val b = self.pop()
            val a = self.pop()
            self.push(_wrap_i32(a | b))
            self.pc = pc_next
        elif opcode == OP_XOR:
            val b = self.pop()
            val a = self.pop()
            self.push(_wrap_i32(a ^ b))
            self.pc = pc_next
        elif opcode == OP_SHL:
            val b = self.pop()
            val a = self.pop()
            self.push(_wrap_i32(a << (b & 31)))
            self.pc = pc_next
        elif opcode == OP_SHR:
            val b = self.pop()
            val a = self.pop()
            self.push(_wrap_i32(_to_u32_bits(a) >> (b & 31)))
            self.pc = pc_next
        elif opcode == OP_SAR:
            val b = self.pop()
            val a = self.pop()
            self.push(_wrap_i32(a >> (b & 31)))
            self.pc = pc_next
        elif opcode == OP_EQ:
            val b = self.pop()
            val a = self.pop()
            self.push_bool(a == b)
            self.pc = pc_next
        elif opcode == OP_NE:
            val b = self.pop()
            val a = self.pop()
            self.push_bool(a != b)
            self.pc = pc_next
        elif opcode == OP_LT:
            val b = self.pop()
            val a = self.pop()
            self.push_bool(a < b)
            self.pc = pc_next
        elif opcode == OP_LE:
            val b = self.pop()
            val a = self.pop()
            self.push_bool(a <= b)
            self.pc = pc_next
        elif opcode == OP_GT:
            val b = self.pop()
            val a = self.pop()
            self.push_bool(a > b)
            self.pc = pc_next
        elif opcode == OP_GE:
            val b = self.pop()
            val a = self.pop()
            self.push_bool(a >= b)
            self.pc = pc_next
        elif opcode == OP_FEQ:
            val b = self.pop_f32()
            val a = self.pop_f32()
            self.push_bool(a == b)
            self.pc = pc_next
        elif opcode == OP_FNE:
            val b = self.pop_f32()
            val a = self.pop_f32()
            self.push_bool(a != b)
            self.pc = pc_next
        elif opcode == OP_FLT:
            val b = self.pop_f32()
            val a = self.pop_f32()
            self.push_bool(a < b)
            self.pc = pc_next
        elif opcode == OP_FLE:
            val b = self.pop_f32()
            val a = self.pop_f32()
            self.push_bool(a <= b)
            self.pc = pc_next
        elif opcode == OP_FGT:
            val b = self.pop_f32()
            val a = self.pop_f32()
            self.push_bool(a > b)
            self.pc = pc_next
        elif opcode == OP_FGE:
            val b = self.pop_f32()
            val a = self.pop_f32()
            self.push_bool(a >= b)
            self.pc = pc_next
        elif opcode == OP_LOAD32:
            val offset = self.pop()
            if not self.bounds_ok(offset, 4):
                self.trap(TRAP_OOB)
            else:
                self.push(_wrap_i32(_u32_le_at(self.arena, offset)))
                self.pc = pc_next
        elif opcode == OP_STORE32:
            val value = self.pop()
            val offset = self.pop()
            if not self.bounds_ok(offset, 4):
                self.trap(TRAP_OOB)
            else:
                self.arena = _write_u32_le(self.arena, offset, value)
                self.pc = pc_next
        elif opcode == OP_LOAD8:
            val offset = self.pop()
            if not self.bounds_ok(offset, 1):
                self.trap(TRAP_OOB)
            else:
                self.push(_u8_at(self.arena, offset))
                self.pc = pc_next
        elif opcode == OP_STORE8:
            val value = self.pop()
            val offset = self.pop()
            if not self.bounds_ok(offset, 1):
                self.trap(TRAP_OOB)
            else:
                self.arena = _write_u8(self.arena, offset, value)
                self.pc = pc_next
        elif opcode == OP_JMP:
            val rel = _i16_le_at(self.code, pc + 1)
            self.pc = pc_next + rel
        elif opcode == OP_JZ:
            val rel = _i16_le_at(self.code, pc + 1)
            val cond = self.pop()
            if cond == 0:
                self.pc = pc_next + rel
            else:
                self.pc = pc_next
        elif opcode == OP_JNZ:
            val rel = _i16_le_at(self.code, pc + 1)
            val cond = self.pop()
            if cond != 0:
                self.pc = pc_next + rel
            else:
                self.pc = pc_next
        elif opcode == OP_CALL:
            val target = _u16_le_at(self.code, pc + 1)
            if self.csp >= CALL_STACK_SIZE:
                panic("svmg: call stack overflow")
            self.callstack[self.csp] = pc_next
            self.csp = self.csp + 1
            self.pc = target
        elif opcode == OP_RET:
            if self.csp <= 0:
                self.exit_clean(0)
            else:
                self.csp = self.csp - 1
                self.pc = self.callstack[self.csp]
        elif opcode == OP_SYS_PUTC:
            val ch = self.pop()
            self.append_log_byte(ch)
            self.pc = pc_next
        elif opcode == OP_SYS_EXIT:
            val code_val = self.pop()
            self.exit_clean(code_val)
        elif opcode == OP_SYS_RESULT:
            val value = self.pop()
            val pass_val = self.pop()
            self.write_record(pass_val, value)
            self.pc = pc_next
        elif opcode == OP_TID:
            self.push(0)
            self.pc = pc_next
        elif opcode == OP_NTID:
            self.push(1)
            self.pc = pc_next
        elif opcode == OP_PARFOR:
            # Single host thread == the whole workgroup: the fanned region
            # is simply the next instructions, executed once as thread 0.
            # See module docstring.
            self.pc = pc_next
        else:
            panic("svmg: unimplemented opcode 0x{opcode}")

    me is_breakpoint(pc_val: i64) -> bool:
        var i = 0
        while i < self.dbg_break_count:
            if self.dbg_breaks[i] == pc_val:
                return true
            i = i + 1
        false

    me save_debug_state():
        """Design §3, kernel change 3: on EVERY halt with bit0 set, park the
        full execution state in the DBG-1 block so "why did it stop" is
        always inspectable and so the next launch can resume from here."""
        self.arena = _write_u32_le(self.arena, DBG_SAVED_PC_OFFSET, self.pc)
        self.arena = _write_u32_le(self.arena, DBG_SAVED_SP_OFFSET, self.sp)
        self.arena = _write_u32_le(self.arena, DBG_SAVED_CSP_OFFSET, self.csp)
        self.arena = _write_u32_le(self.arena, DBG_STEP_COUNT_OFFSET, self.step_count)
        self.arena = _write_u32_le(self.arena, DBG_SAVED_SEQ_OFFSET, self.seq)
        self.arena = _write_u32_le(self.arena, DBG_SAVED_RECORD_COUNT_OFFSET, self.record_count)
        self.arena = _write_u32_le_many(self.arena, DBG_SAVED_STACK_OFFSET, self.stack, OPERAND_STACK_SIZE)
        self.arena = _write_u32_le_many(self.arena, DBG_SAVED_CALLS_OFFSET, self.callstack, CALL_STACK_SIZE)

    me halt_debug_break():
        self.arena = _write_u32_le(self.arena, RAM_SENTINEL_OFFSET, SENTINEL_DEBUG_BREAK)
        self.debug_break = true
        self.halted = true

    me run() -> VmRunResult:
        # Single hoisted bool: when DBG_FLAGS == 0 the loop below is the
        # pre-DBG-1 loop plus one already-computed boolean test per
        # iteration, and NOTHING else -- no arena reads, no table scan, no
        # extra writes, and the debug fields are never touched.
        val dbg_on = (self.dbg_flags & DBG_FLAG_ENABLED) != 0
        val single_step = dbg_on and (self.dbg_flags & DBG_FLAG_SINGLE_STEP) != 0
        var first_instruction = true

        while not self.halted:
            if self.steps_remaining <= 0:
                self.arena = _write_u32_le(self.arena, RAM_SENTINEL_OFFSET, SENTINEL_TIMEOUT)
                self.timed_out = true
                self.halted = true
                break
            if self.pc >= self.code.len():
                self.exit_clean(0)
                break
            if dbg_on:
                # Breakpoint check BEFORE executing, so a break leaves pc ON
                # the breakpoint and resuming re-executes that instruction
                # exactly once. The `first_instruction and self.resumed`
                # suppression is what makes that true: without it, resuming
                # from a breakpoint would immediately re-break on the very
                # same pc and the debugger could never make progress.
                if not (first_instruction and self.resumed) and self.is_breakpoint(self.pc):
                    self.halt_debug_break()
                    break
            self.steps_remaining = self.steps_remaining - 1
            self.step()
            if dbg_on:
                self.step_count = self.step_count + 1
                # Single-step stops AFTER one instruction -- but only if that
                # instruction did not already halt the VM itself (HALT, TRAP,
                # SYS_EXIT). A program that ended is not "stopped at a
                # breakpoint", and reporting it as one would make
                # resume-to-completion loop forever.
                if single_step and not self.halted:
                    self.halt_debug_break()
                    break
            first_instruction = false

        if dbg_on:
            self.save_debug_state()

        VmRunResult(
            arena: self.arena,
            log_cap: self.log_cap,
            sentinel: read_sentinel(self.arena),
            halted: self.halted,
            trapped: self.trapped,
            timed_out: self.timed_out,
            steps_used: self.initial_step_budget - self.steps_remaining,
            record_count: self.record_count,
            debug_break: self.debug_break,
            step_count: self.step_count,
        )

pub fn run(header: SgpHeader, code: [u8], arena_in: [u8]) -> VmRunResult:
    """Execute an SGP program's code section against `arena_in`.

    `arena_in` must already be a full GMB-1 arena (see `build_arena`) with
    the SGP blob installed; `header`/`code` are the already-decoded header
    and the code-section bytes.
    """
    val vm = SvmgVm.new(header, code, arena_in)
    vm.run()

fn run_arena(code: [u8], arena_in: [u8]) -> VmRunResult:
    """Launch against an EXISTING arena, re-decoding the SGP header from it.

    This is the resume entry point: hand back the arena a previous launch
    returned (with DBG_FLAG_RESUME set) and execution continues from the
    saved state, with the LOG ring, RECORD ring and DATA region exactly as
    the earlier launch left them -- the same "persisted arena" continuity the
    device wrappers get for free, because the arena IS the device buffer."""
    val header = decode_sgp_header(arena_in)
    run(header, code, arena_in)

fn assemble_and_run(code: [u8], step_budget: i64, entry_pc: i64) -> VmRunResult:
    """Convenience entry point: build a default-sized arena around `code`
    (assembled bytes) with an empty DATA-init region and the default LOG
    ring capacity, then run it."""
    val arena = build_arena(code, [], step_budget, entry_pc, DEFAULT_LOG_CAP)
    val header = decode_sgp_header(arena)
    run(header, code, arena)
