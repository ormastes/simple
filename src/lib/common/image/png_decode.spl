# PNG Decode — bounded PNG (every color type and bit depth, Adam7 interlacing, tRNS) to ARGB [u32]

use std.common.image.deflate_inflate.{deflate_inflate_zlib_bounded}
use std.common.compress.gzip.{gzip_crc32}

struct PngImage:
    """Decoded PNG image as ARGB pixel buffer."""
    pixels: [u32]
    width: i32
    height: i32

val PNG_SIG_0: u8 = 137
val PNG_SIG_1: u8 = 80
val PNG_SIG_2: u8 = 78
val PNG_SIG_3: u8 = 71
val PNG_SIG_4: u8 = 13
val PNG_SIG_5: u8 = 10
val PNG_SIG_6: u8 = 26
val PNG_SIG_7: u8 = 10
val PNG_MAX_DIMENSION: i64 = 4096
val PNG_MAX_PIXELS: i64 = 16777216

fn _png_chunk_is(ct0: u8, ct1: u8, ct2: u8, ct3: u8,
                 a: i64, b: i64, c: i64, d: i64) -> bool:
    ct0.to_i64() == a and ct1.to_i64() == b and
        ct2.to_i64() == c and ct3.to_i64() == d

fn _png_chunk_type_byte_valid(byte: u8) -> bool:
    (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)

fn _png_chunk_type_valid(ct0: u8, ct1: u8, ct2: u8, ct3: u8) -> bool:
    (_png_chunk_type_byte_valid(ct0) and _png_chunk_type_byte_valid(ct1) and
        ct2 >= 65 and ct2 <= 90 and _png_chunk_type_byte_valid(ct3))

fn _png_chunk_crc(data: [u8], type_offset: i64, chunk_len: i64) -> u32:
    var crc_data: [u8] = []
    var i: i64 = type_offset
    val end_offset = type_offset + 4 + chunk_len
    while i < end_offset:
        crc_data.push(data[i])
        i = i + 1
    gzip_crc32(crc_data)

fn decode_png_to_argb(data: [u8]) -> Result<PngImage, text>:
    decode_png_to_argb_bounded(data, PNG_MAX_PIXELS)

fn decode_png_to_argb_bounded(data: [u8], max_pixels: i64) -> Result<PngImage, text>:
    """Strictly decode a bounded PNG: every color type / bit depth the spec
    allows (16-bit samples keep their high byte), Adam7 interlacing, and tRNS
    transparency."""
    if max_pixels <= 0:
        return Err("PNG pixel limit is invalid")
    val pixel_limit = if max_pixels < PNG_MAX_PIXELS: max_pixels else: PNG_MAX_PIXELS
    if data.len() < 33:
        return Err("PNG data is truncated")
    if (data[0] != PNG_SIG_0 or data[1] != PNG_SIG_1 or
        data[2] != PNG_SIG_2 or data[3] != PNG_SIG_3 or
        data[4] != PNG_SIG_4 or data[5] != PNG_SIG_5 or
        data[6] != PNG_SIG_6 or data[7] != PNG_SIG_7):
        return Err("Invalid PNG signature")

    var img_width: i32 = 0
    var img_height: i32 = 0
    var color_type: u8 = 0
    var bit_depth: u8 = 0
    var palette: [u32] = []
    var trns: [u8] = []
    var seen_trns = false
    var interlaced = false
    var seen_ihdr = false
    var seen_plte = false
    var seen_idat = false
    var idat_ended = false
    var seen_iend = false
    var idat_data: [u8] = []
    var pos: i64 = 8

    while pos < data.len():
        val remaining = data.len() - pos
        if remaining < 12:
            return Err("PNG chunk is truncated")
        val chunk_len = read_u32_be(data, pos).to_i64()
        if chunk_len > remaining - 12:
            return Err("PNG chunk length exceeds remaining input")

        val ct0 = data[pos + 4]
        val ct1 = data[pos + 5]
        val ct2 = data[pos + 6]
        val ct3 = data[pos + 7]
        if not _png_chunk_type_valid(ct0, ct1, ct2, ct3):
            return Err("PNG chunk type is invalid")
        val chunk_data = pos + 8
        val crc_offset = chunk_data + chunk_len
        val chunk_end = crc_offset + 4
        if _png_chunk_crc(data, pos + 4, chunk_len) != read_u32_be(data, crc_offset):
            return Err("PNG chunk CRC is invalid")

        val is_ihdr = _png_chunk_is(ct0, ct1, ct2, ct3, 73, 72, 68, 82)
        val is_plte = _png_chunk_is(ct0, ct1, ct2, ct3, 80, 76, 84, 69)
        val is_idat = _png_chunk_is(ct0, ct1, ct2, ct3, 73, 68, 65, 84)
        val is_iend = _png_chunk_is(ct0, ct1, ct2, ct3, 73, 69, 78, 68)

        if not seen_ihdr and not is_ihdr:
            return Err("IHDR must be the first PNG chunk")

        if is_ihdr:
            if seen_ihdr or pos != 8 or chunk_len != 13:
                return Err("PNG IHDR chunk is invalid")
            val width64 = read_u32_be(data, chunk_data).to_i64()
            val height64 = read_u32_be(data, chunk_data + 4).to_i64()
            if (width64 <= 0 or height64 <= 0 or
                width64 > PNG_MAX_DIMENSION or height64 > PNG_MAX_DIMENSION):
                return Err("PNG dimensions exceed decoder limits")
            val pixels64 = width64 * height64
            if pixels64 > pixel_limit:
                return Err("PNG dimensions exceed decoder limits")
            bit_depth = data[chunk_data + 8]
            color_type = data[chunk_data + 9]
            if not _png_format_supported(color_type, bit_depth):
                return Err("PNG bit depth or color type is unsupported")
            if (data[chunk_data + 10] != 0 or data[chunk_data + 11] != 0 or
                data[chunk_data + 12] > 1):
                return Err("PNG compression, filter, or interlace method is unsupported")
            interlaced = data[chunk_data + 12] == 1
            img_width = width64.to_i32()
            img_height = height64.to_i32()
            seen_ihdr = true
        else if is_plte:
            if seen_plte or seen_idat or chunk_len == 0 or chunk_len > 768 or chunk_len % 3 != 0:
                return Err("PNG PLTE chunk is invalid")
            # Grayscale images must not carry a palette (PNG spec 11.2.3).
            if color_type == 0 or color_type == 4:
                return Err("PNG PLTE chunk is invalid")
            if color_type == 3 and chunk_len / 3 > (1 << bit_depth.to_i64()):
                return Err("PNG PLTE chunk is invalid")
            var e: i64 = 0
            while e < chunk_len / 3:
                val p = chunk_data + e * 3
                palette.push(0xFF000000u32 | (data[p].to_u32() << 16) |
                    (data[p + 1].to_u32() << 8) | data[p + 2].to_u32())
                e = e + 1
            seen_plte = true
        else if _png_chunk_is(ct0, ct1, ct2, ct3, 116, 82, 78, 83):
            # tRNS: per-index alpha (palette) or one transparent sample value
            # (gray: 2 bytes, RGB: 6 bytes); must precede IDAT.
            if seen_trns or seen_idat:
                return Err("PNG tRNS chunk is invalid")
            val trns_ok = if color_type == 3:
                seen_plte and chunk_len <= palette.len()
            elif color_type == 0:
                chunk_len == 2
            elif color_type == 2:
                chunk_len == 6
            else:
                false
            if not trns_ok:
                return Err("PNG tRNS chunk is invalid")
            var t: i64 = 0
            while t < chunk_len:
                trns.push(data[chunk_data + t])
                t = t + 1
            seen_trns = true
        else if is_idat:
            if idat_ended:
                return Err("PNG IDAT chunks must be consecutive")
            seen_idat = true
            var i: i64 = 0
            while i < chunk_len:
                idat_data.push(data[chunk_data + i])
                i = i + 1
        else:
            if seen_idat:
                idat_ended = true
            if is_iend:
                if chunk_len != 0 or not seen_idat or chunk_end != data.len():
                    return Err("PNG IEND chunk is invalid")
                seen_iend = true
            else if ct0 >= 65 and ct0 <= 90:
                return Err("PNG contains an unsupported critical chunk")

        pos = chunk_end
        if seen_iend:
            break

    if not seen_iend or idat_data.len() == 0:
        return Err("PNG is missing IDAT or IEND")
    if color_type == 3 and not seen_plte:
        return Err("PNG palette image is missing PLTE")

    val channels: i64 = _png_channels(color_type)
    val depth = bit_depth.to_i64()
    val w64 = img_width.to_i64()
    val h64 = img_height.to_i64()
    # Filter unit `bpp`: bytes per complete pixel, at least 1.
    val filter_bpp64 = if channels * depth >= 8: channels * depth / 8 else: 1

    if not interlaced and depth == 8 and (color_type == 2 or color_type == 6):
        # 8-bit truecolor, non-interlaced: the original fast path, unchanged
        # except for the optional tRNS transparent color on RGB.
        val stride64 = w64 * channels
        val expected64 = (stride64 + 1) * h64
        val inflate_result = deflate_inflate_zlib_bounded(idat_data, expected64)
        var inflated: [u8] = []
        match inflate_result:
            Ok(bytes): inflated = bytes
            Err(message): return Err("PNG IDAT: {message}")
        if inflated.len() != expected64:
            return Err("PNG scanline data length does not match IHDR")
        val reconstructed = _png_unfilter(
            inflated, img_height, filter_bpp64.to_i32(), stride64.to_i32())
        if reconstructed.len() != stride64 * h64:
            return Err("PNG scanline filter is invalid")
        var pixels: [u32] = []
        val total_pixels = w64 * h64
        var i: i64 = 0
        while i < total_pixels:
            val px_start = i * channels
            val r = reconstructed[px_start].to_u32()
            val g = reconstructed[px_start + 1].to_u32()
            val b = reconstructed[px_start + 2].to_u32()
            var a: u32 = if color_type == 6: reconstructed[px_start + 3].to_u32() else: 255
            if seen_trns and color_type == 2 and
               r == trns[1].to_u32() and g == trns[3].to_u32() and b == trns[5].to_u32() and
               trns[0] == 0u8 and trns[2] == 0u8 and trns[4] == 0u8:
                a = 0
            pixels.push((a << 24) | (r << 16) | (g << 8) | b)
            i = i + 1
        return Ok(PngImage(pixels: pixels, width: img_width, height: img_height))

    # General path: any supported depth (1/2/4/8/16) and Adam7 interlacing.
    # A non-interlaced image is the single pass (0, 0, 1, 1).
    val passes: [[i64]] = if interlaced:
        [[0, 0, 8, 8], [4, 0, 8, 8], [0, 4, 4, 8], [2, 0, 4, 4],
         [0, 2, 2, 4], [1, 0, 2, 2], [0, 1, 1, 2]]
    else:
        [[0, 0, 1, 1]]
    var expected64: i64 = 0
    for ps in passes:
        val pw = _png_pass_extent(w64, ps[0], ps[2])
        val ph = _png_pass_extent(h64, ps[1], ps[3])
        if pw > 0 and ph > 0:
            expected64 = expected64 + ((pw * channels * depth + 7) / 8 + 1) * ph
    val inflate_result = deflate_inflate_zlib_bounded(idat_data, expected64)
    var inflated: [u8] = []
    match inflate_result:
        Ok(bytes): inflated = bytes
        Err(message): return Err("PNG IDAT: {message}")
    if inflated.len() != expected64:
        return Err("PNG scanline data length does not match IHDR")

    var pixels: [u32] = [0u32; w64 * h64]
    var offset: i64 = 0
    for ps in passes:
        val pw = _png_pass_extent(w64, ps[0], ps[2])
        val ph = _png_pass_extent(h64, ps[1], ps[3])
        if pw == 0 or ph == 0:
            continue
        val stride64 = (pw * channels * depth + 7) / 8
        val pass_len = (stride64 + 1) * ph
        val reconstructed = _png_unfilter(
            inflated.slice(offset, offset + pass_len), ph.to_i32(),
            filter_bpp64.to_i32(), stride64.to_i32())
        if reconstructed.len() != stride64 * ph:
            return Err("PNG scanline filter is invalid")
        offset = offset + pass_len
        var row: i64 = 0
        while row < ph:
            val row_start = row * stride64
            val y = ps[1] + row * ps[3]
            var col: i64 = 0
            while col < pw:
                val x = ps[0] + col * ps[2]
                match _png_pixel_argb(
                    reconstructed, row_start, col, color_type, depth, channels,
                    palette, trns, seen_trns
                ):
                    Ok(px): pixels[y * w64 + x] = px
                    Err(message): return Err(message)
                col = col + 1
            row = row + 1

    Ok(PngImage(pixels: pixels, width: img_width, height: img_height))

fn _png_pass_extent(full: i64, start: i64, step: i64) -> i64:
    """Pixels of one Adam7 pass along an axis of length `full`."""
    if full <= start:
        return 0
    (full - start + step - 1) / step

fn _png_sample(row_bytes: [u8], row_start: i64, index: i64, depth: i64) -> i64:
    """Sample number `index` (pixel * channels + channel) of a scanline at
    `depth` bits: packed MSB first below 8 bits, big-endian at 16."""
    if depth == 16:
        val at = row_start + index * 2
        return (row_bytes[at].to_i64() << 8) | row_bytes[at + 1].to_i64()
    _png_packed_sample(row_bytes, row_start, index, depth)

fn _png_sample_8bit(sample: i64, depth: i64) -> u32:
    """Scale a sample of `depth` bits to 0..255 (16-bit keeps its high byte)."""
    if depth == 16:
        return (sample >> 8).to_u32()
    if depth == 8:
        return sample.to_u32()
    (sample * 255 / ((1 << depth) - 1)).to_u32()

fn _png_trns_key(trns: [u8], k: i64) -> i64:
    (trns[k * 2].to_i64() << 8) | trns[k * 2 + 1].to_i64()

fn _png_pixel_argb(
    row_bytes: [u8], row_start: i64, col: i64, color_type: u8, depth: i64,
    channels: i64, palette: [u32], trns: [u8], seen_trns: bool
) -> Result<u32, text>:
    val base = col * channels
    if color_type == 3:
        val index = _png_sample(row_bytes, row_start, base, depth)
        if index >= palette.len():
            return Err("PNG palette index out of range")
        var px = palette[index]
        if index < trns.len():
            px = (px & 0x00FFFFFFu32) | (trns[index].to_u32() << 24)
        return Ok(px)
    if color_type == 0 or color_type == 4:
        val raw = _png_sample(row_bytes, row_start, base, depth)
        val gray = _png_sample_8bit(raw, depth)
        var a: u32 = 255
        if color_type == 4:
            a = _png_sample_8bit(_png_sample(row_bytes, row_start, base + 1, depth), depth)
        elif seen_trns and _png_trns_key(trns, 0) == raw:
            a = 0
        return Ok((a << 24) | (gray << 16) | (gray << 8) | gray)
    val rr = _png_sample(row_bytes, row_start, base, depth)
    val rg = _png_sample(row_bytes, row_start, base + 1, depth)
    val rb = _png_sample(row_bytes, row_start, base + 2, depth)
    var a: u32 = 255
    if color_type == 6:
        a = _png_sample_8bit(_png_sample(row_bytes, row_start, base + 3, depth), depth)
    elif seen_trns and _png_trns_key(trns, 0) == rr and
         _png_trns_key(trns, 1) == rg and _png_trns_key(trns, 2) == rb:
        a = 0
    Ok((a << 24) | (_png_sample_8bit(rr, depth) << 16) |
        (_png_sample_8bit(rg, depth) << 8) | _png_sample_8bit(rb, depth))

fn _png_channels(color_type: u8) -> i64:
    if color_type == 2: return 3
    if color_type == 4: return 2
    if color_type == 6: return 4
    1

fn _png_format_supported(color_type: u8, bit_depth: u8) -> bool:
    """Every PNG color type / bit depth combination the spec allows:
    truecolor (2, 6) and gray+alpha (4) at 8/16 bits, grayscale (0) at
    1/2/4/8/16, palette (3) at 1/2/4/8."""
    if color_type == 2 or color_type == 4 or color_type == 6:
        return bit_depth == 8 or bit_depth == 16
    if color_type == 0:
        return bit_depth == 1 or bit_depth == 2 or bit_depth == 4 or bit_depth == 8 or bit_depth == 16
    if color_type == 3:
        return bit_depth == 1 or bit_depth == 2 or bit_depth == 4 or bit_depth == 8
    false

fn _png_packed_sample(row_bytes: [u8], row_start: i64, col: i64, depth: i64) -> i64:
    """Sample `col` of a scanline packed at `depth` bits (1/2/4/8), MSB first."""
    if depth == 8:
        return row_bytes[row_start + col].to_i64()
    val bit = col * depth
    val byte = row_bytes[row_start + bit / 8].to_i64()
    val shift = 8 - depth - (bit % 8)
    (byte >> shift) & ((1 << depth) - 1)

fn read_u32_be(data: [u8], offset: i64) -> u32:
    (data[offset].to_u32() << 24) |
        (data[offset + 1].to_u32() << 16) |
        (data[offset + 2].to_u32() << 8) |
        data[offset + 3].to_u32()

fn decompress_idat(compressed: [u8], width: i32, height: i32, color_type: u8) -> [u8]:
    """Strict zlib decode and filter reconstruction for supported PNG scanlines."""
    if width <= 0 or height <= 0 or (color_type != 2 and color_type != 6):
        return []
    val channels: i64 = if color_type == 6: 4 else: 3
    val pixels = width.to_i64() * height.to_i64()
    if (width.to_i64() > PNG_MAX_DIMENSION or height.to_i64() > PNG_MAX_DIMENSION or
        pixels > PNG_MAX_PIXELS):
        return []
    val stride64 = width.to_i64() * channels
    val expected64 = (stride64 + 1) * height.to_i64()
    val result = deflate_inflate_zlib_bounded(compressed, expected64)
    match result:
        Ok(inflated):
            if inflated.len() != expected64:
                return []
            reconstruct_scanlines(inflated, width, height, channels.to_i32(), stride64.to_i32())
        Err(_): []

fn reconstruct_scanlines(data: [u8], width: i32, height: i32, bpp: i32, stride: i32) -> [u8]:
    """Reverse PNG filters, rejecting invalid filters and non-exact input."""
    if width <= 0 or height <= 0 or bpp <= 0 or stride <= 0:
        return []
    if width.to_i64() * bpp.to_i64() != stride.to_i64():
        return []
    _png_unfilter(data, height, bpp, stride)

fn _png_unfilter(data: [u8], height: i32, bpp: i32, stride: i32) -> [u8]:
    """Reverse PNG filters for `height` scanlines of `stride` bytes; `bpp` is
    the filter unit (bytes per complete pixel, at least 1). Rejects invalid
    filter types and inexact input with an empty result."""
    if height <= 0 or bpp <= 0 or stride <= 0:
        return []
    val expected = (stride.to_i64() + 1) * height.to_i64()
    if data.len() != expected:
        return []

    var pixels: [u8] = []
    var prev_row: [u8] = []
    var init: i32 = 0
    while init < stride:
        prev_row.push(0)
        init = init + 1

    var row: i32 = 0
    var data_pos: i64 = 0
    while row < height:
        val filter_type = data[data_pos].to_i32()
        if filter_type < 0 or filter_type > 4:
            return []
        data_pos = data_pos + 1
        var current_row: [u8] = []
        var col: i32 = 0
        while col < stride:
            val raw_byte = data[data_pos].to_i32()
            data_pos = data_pos + 1
            var reconstructed: i32 = raw_byte
            if filter_type == 1:
                val a: i32 = if col >= bpp: current_row[col - bpp].to_i32() else: 0
                reconstructed = (raw_byte + a) % 256
            else if filter_type == 2:
                reconstructed = (raw_byte + prev_row[col].to_i32()) % 256
            else if filter_type == 3:
                val a: i32 = if col >= bpp: current_row[col - bpp].to_i32() else: 0
                reconstructed = (raw_byte + (a + prev_row[col].to_i32()) / 2) % 256
            else if filter_type == 4:
                val a: i32 = if col >= bpp: current_row[col - bpp].to_i32() else: 0
                val b = prev_row[col].to_i32()
                val c: i32 = if col >= bpp: prev_row[col - bpp].to_i32() else: 0
                reconstructed = (raw_byte + paeth_predictor(a, b, c)) % 256
            current_row.push(reconstructed.to_u8())
            pixels.push(reconstructed.to_u8())
            col = col + 1
        prev_row = current_row
        row = row + 1
    pixels

fn paeth_predictor(a: i32, b: i32, c: i32) -> i32:
    """Paeth predictor function per PNG spec."""
    val p = a + b - c
    val pa = abs_i32(p - a)
    val pb = abs_i32(p - b)
    val pc = abs_i32(p - c)
    if pa <= pb and pa <= pc:
        return a
    if pb <= pc:
        return b
    c

fn abs_i32(x: i32) -> i32:
    if x < 0: return -x
    x
