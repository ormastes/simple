# JPEG Decode — bounded baseline/extended-sequential + progressive Huffman
# JPEG (JFIF/EXIF/Adobe) to ARGB [u32].
#
# Input is untrusted network bytes: every read is bounds-checked, frame
# dimensions are checked against `max_pixels` before anything is allocated,
# and entropy decoding is bounded by the MCU count (corrupt data cannot loop).
#
# Supported: 8-bit precision, 1 (grayscale) or 3 (YCbCr / Adobe RGB)
# components, any H/V sampling factors 1..4 (4:4:4, 4:2:2, 4:2:0, 4:4:0, ...),
# restart intervals, progressive spectral selection + successive approximation.
# The IDCT and color conversion reproduce libjpeg's `jidctint` (islow) and
# `jdcolor` integer arithmetic and libjpeg-turbo's default "fancy" chroma
# upsampling (h2v1, h2v2, h1v2; other ratios replicate), so output is
# bit-identical to `djpeg -dct int`.
# Rejected with an error: 12-bit precision, lossless (SOF3), arithmetic coding
# (SOF9+), hierarchical frames, CMYK/YCCK (4 components), DNL-defined height.
# EXIF orientation is parsed and RECORDED in `exif_orientation` (1..8) but is
# NOT applied to the pixel buffer; callers that honor it must rotate.

struct JpegImage:
    """Decoded JPEG image as ARGB pixel buffer (row-major, alpha 255)."""
    pixels: [u32]
    width: i32
    height: i32
    exif_orientation: i32
    progressive: bool

val JPEG_MAX_DIMENSION: i64 = 16384
val JPEG_MAX_PIXELS: i64 = 16777216

# Zigzag position k -> natural (row-major) coefficient index.
val _JPEG_ZIGZAG: [i64] = [
    0, 1, 8, 16, 9, 2, 3, 10,
    17, 24, 32, 25, 18, 11, 4, 5,
    12, 19, 26, 33, 40, 48, 41, 34,
    27, 20, 13, 6, 7, 14, 21, 28,
    35, 42, 49, 56, 57, 50, 43, 36,
    29, 22, 15, 23, 30, 37, 44, 51,
    58, 59, 52, 45, 38, 31, 39, 46,
    53, 60, 61, 54, 47, 55, 62, 63
]

# libjpeg jidctint.c fixed-point constants (CONST_BITS = 13).
val _FIX_0_298631336: i64 = 2446
val _FIX_0_390180644: i64 = 3196
val _FIX_0_541196100: i64 = 4433
val _FIX_0_765366865: i64 = 6270
val _FIX_0_899976223: i64 = 7373
val _FIX_1_175875602: i64 = 9633
val _FIX_1_501321110: i64 = 12299
val _FIX_1_847759065: i64 = 15137
val _FIX_1_961570560: i64 = 16069
val _FIX_2_053119869: i64 = 16819
val _FIX_2_562915447: i64 = 20995
val _FIX_3_072711026: i64 = 25172

# Huffman fast-path lookahead width.
val _JPEG_LOOK_BITS: i64 = 9
val _JPEG_LOOK_SIZE: i64 = 512

fn decode_jpeg_to_argb(data: [u8]) -> Result<JpegImage, text>:
    decode_jpeg_to_argb_bounded(data, JPEG_MAX_PIXELS)

fn jpeg_signature_valid(data: [u8]) -> bool:
    """SOI marker followed by the start of another marker."""
    data.len() >= 4 and data[0] == 255u8 and data[1] == 216u8 and data[2] == 255u8

fn decode_jpeg_to_argb_bounded(data: [u8], max_pixels: i64) -> Result<JpegImage, text>:
    """Strictly decode a bounded JPEG. `max_pixels` (capped at
    JPEG_MAX_PIXELS) is enforced from the SOF header before allocation."""
    if max_pixels <= 0:
        return Err("JPEG pixel limit is invalid")
    val pixel_limit = if max_pixels < JPEG_MAX_PIXELS: max_pixels else: JPEG_MAX_PIXELS
    if data.len() < 4:
        return Err("JPEG data is truncated")
    if not jpeg_signature_valid(data):
        return Err("Invalid JPEG signature")
    var dec = _jpeg_decoder_new(data, pixel_limit)
    val err = dec.run()
    if err != "":
        return Err(err)
    Ok(JpegImage(
        pixels: dec.out_pixels,
        width: dec.width.to_i32(),
        height: dec.height.to_i32(),
        exif_orientation: dec.exif_orientation.to_i32(),
        progressive: dec.progressive
    ))

fn _jpeg_u16(data: [u8], pos: i64) -> i64:
    (data[pos].to_i64() << 8) | data[pos + 1].to_i64()

fn _jpeg_zero_i64(n: i64) -> [i64]:
    [0; n]

fn _jpeg_fill_i64(n: i64, v: i64) -> [i64]:
    [v; n]

fn _jpeg_clamp(v: i64) -> i64:
    if v < 0:
        return 0
    if v > 255:
        return 255
    v

fn _jpeg_decoder_new(data: [u8], pixel_limit: i64) -> _JpegDecoder:
    _JpegDecoder(
        data: data,
        pixel_limit: pixel_limit,
        pos: 2,
        bitbuf: 0,
        bitcnt: 0,
        hit_marker: false,
        overrun: 0,
        error: "",
        width: 0,
        height: 0,
        progressive: false,
        seen_sof: false,
        ncomp: 0,
        comp_id: _jpeg_zero_i64(4),
        comp_h: _jpeg_zero_i64(4),
        comp_v: _jpeg_zero_i64(4),
        comp_tq: _jpeg_zero_i64(4),
        comp_bw: _jpeg_zero_i64(4),
        comp_bh: _jpeg_zero_i64(4),
        comp_coef_off: _jpeg_zero_i64(4),
        comp_q_ready: _jpeg_zero_i64(4),
        comp_q: _jpeg_zero_i64(256),
        comp_pred: _jpeg_zero_i64(4),
        hmax: 1,
        vmax: 1,
        mcux: 0,
        mcuy: 0,
        coef: [],
        qt: _jpeg_zero_i64(256),
        qt_defined: _jpeg_zero_i64(4),
        huff_defined: _jpeg_zero_i64(8),
        huff_look: _jpeg_zero_i64(8 * 512),
        huff_maxcode: _jpeg_fill_i64(8 * 18, -1),
        huff_valptr: _jpeg_zero_i64(8 * 17),
        huff_mincode: _jpeg_zero_i64(8 * 17),
        huff_val: _jpeg_zero_i64(8 * 256),
        restart_interval: 0,
        eobrun: 0,
        adobe_transform: -1,
        exif_orientation: 1,
        ws: _jpeg_zero_i64(64),
        scan_comp: _jpeg_zero_i64(4),
        scan_td: _jpeg_zero_i64(4),
        scan_ta: _jpeg_zero_i64(4),
        scan_ns: 0,
        scan_ss: 0,
        scan_se: 0,
        scan_ah: 0,
        scan_al: 0,
        planes: [],
        plane_off: _jpeg_zero_i64(4),
        plane_stride: _jpeg_zero_i64(4),
        out_pixels: []
    )

class _JpegDecoder:
    """Whole-image JPEG decoder state. Fields are flat arrays indexed by
    component (0..3) or Huffman slot (DC 0..3, AC 4..7) to keep the hot
    loops free of nested containers."""
    data: [u8]
    pixel_limit: i64
    pos: i64
    bitbuf: i64
    bitcnt: i64
    hit_marker: bool
    overrun: i64
    error: text
    width: i64
    height: i64
    progressive: bool
    seen_sof: bool
    ncomp: i64
    comp_id: [i64]
    comp_h: [i64]
    comp_v: [i64]
    comp_tq: [i64]
    comp_bw: [i64]
    comp_bh: [i64]
    comp_coef_off: [i64]
    comp_q_ready: [i64]
    comp_q: [i64]
    comp_pred: [i64]
    hmax: i64
    vmax: i64
    mcux: i64
    mcuy: i64
    coef: [i64]
    qt: [i64]
    qt_defined: [i64]
    huff_defined: [i64]
    huff_look: [i64]
    huff_maxcode: [i64]
    huff_valptr: [i64]
    huff_mincode: [i64]
    huff_val: [i64]
    restart_interval: i64
    eobrun: i64
    adobe_transform: i64
    exif_orientation: i64
    ws: [i64]
    scan_comp: [i64]
    scan_td: [i64]
    scan_ta: [i64]
    scan_ns: i64
    scan_ss: i64
    scan_se: i64
    scan_ah: i64
    scan_al: i64
    planes: [i64]
    plane_off: [i64]
    plane_stride: [i64]
    out_pixels: [u32]

    # ------------------------------------------------------------------
    # Marker / segment parsing
    # ------------------------------------------------------------------

    me run() -> text:
        """Parse every marker segment through EOI, then reconstruct pixels.
        Returns "" on success or an error message."""
        var seen_scan = false
        loop:
            # Find the next marker: skip stray bytes, then 0xFF fill bytes.
            while self.pos < self.data.len() and self.data[self.pos] != 255u8:
                self.pos = self.pos + 1
            while self.pos < self.data.len() and self.data[self.pos] == 255u8:
                self.pos = self.pos + 1
            if self.pos >= self.data.len():
                return "JPEG data is truncated (missing EOI)"
            val marker = self.data[self.pos].to_i64()
            self.pos = self.pos + 1
            if marker == 0xD9:
                break
            if marker == 0x00 or marker >= 0xD0 and marker <= 0xD7:
                # A stuffed 0xFF00 or a stray RST in trailing scan padding:
                # tolerated, no payload.
                continue
            if marker == 0xD8 or marker == 0x01:
                return "JPEG marker sequence is invalid"
            if self.pos + 2 > self.data.len():
                return "JPEG segment is truncated"
            val seg_len = _jpeg_u16(self.data, self.pos)
            if seg_len < 2 or self.pos + seg_len > self.data.len():
                return "JPEG segment length exceeds input"
            val body = self.pos + 2
            val body_len = seg_len - 2
            self.pos = self.pos + seg_len
            var err = ""
            if marker == 0xC0 or marker == 0xC1 or marker == 0xC2:
                err = self.parse_sof(body, body_len, marker == 0xC2)
            elif marker >= 0xC3 and marker <= 0xCF and marker != 0xC4 and marker != 0xC8:
                err = if marker >= 0xC9: "arithmetic-coded JPEG is unsupported" else: "lossless or hierarchical JPEG is unsupported"
            elif marker == 0xC4:
                err = self.parse_dht(body, body_len)
            elif marker == 0xDB:
                err = self.parse_dqt(body, body_len)
            elif marker == 0xDD:
                if body_len != 2:
                    err = "JPEG DRI segment is invalid"
                else:
                    self.restart_interval = _jpeg_u16(self.data, body)
            elif marker == 0xDA:
                err = self.parse_sos(body, body_len)
                if err == "":
                    err = self.decode_scan()
                    seen_scan = true
            elif marker == 0xDC:
                err = "JPEG DNL-defined height is unsupported"
            elif marker == 0xE1:
                self.parse_exif(body, body_len)
            elif marker == 0xEE:
                # Adobe APP14: "Adobe" + version(2) + flags0(2) + flags1(2) + transform(1)
                if body_len >= 12 and self.data[body] == 65u8 and self.data[body + 1] == 100u8 and self.data[body + 2] == 111u8 and self.data[body + 3] == 98u8 and self.data[body + 4] == 101u8:
                    self.adobe_transform = self.data[body + 11].to_i64()
            # Other APPn / COM / unknown non-SOF segments are skipped.
            if err != "":
                return err
        if not self.seen_sof:
            return "JPEG is missing a frame header"
        if not seen_scan:
            return "JPEG is missing scan data"
        self.reconstruct()

    me parse_sof(body: i64, body_len: i64, progressive: bool) -> text:
        if self.seen_sof:
            return "JPEG contains more than one frame"
        if body_len < 6:
            return "JPEG SOF segment is truncated"
        val precision = self.data[body].to_i64()
        if precision != 8:
            return "JPEG sample precision is unsupported"
        val h = _jpeg_u16(self.data, body + 1)
        val w = _jpeg_u16(self.data, body + 3)
        val nc = self.data[body + 5].to_i64()
        if h == 0:
            return "JPEG DNL-defined height is unsupported"
        if w == 0:
            return "JPEG width is invalid"
        if w > JPEG_MAX_DIMENSION or h > JPEG_MAX_DIMENSION or w * h > self.pixel_limit:
            return "JPEG dimensions exceed decoder limits"
        if nc != 1 and nc != 3:
            return "JPEG component count is unsupported"
        if body_len != 6 + nc * 3:
            return "JPEG SOF segment length is invalid"
        var hmax: i64 = 1
        var vmax: i64 = 1
        var c: i64 = 0
        while c < nc:
            val p = body + 6 + c * 3
            val cid = self.data[p].to_i64()
            val hv = self.data[p + 1].to_i64()
            val tq = self.data[p + 2].to_i64()
            val ch = hv >> 4
            val cv = hv & 15
            if ch < 1 or ch > 4 or cv < 1 or cv > 4 or tq > 3:
                return "JPEG component sampling or table is invalid"
            var d: i64 = 0
            while d < c:
                if self.comp_id[d] == cid:
                    return "JPEG component identifiers are duplicated"
                d = d + 1
            self.comp_id[c] = cid
            self.comp_h[c] = ch
            self.comp_v[c] = cv
            self.comp_tq[c] = tq
            if ch > hmax:
                hmax = ch
            if cv > vmax:
                vmax = cv
            c = c + 1
        # Every component's factors must divide the maxima (libjpeg rule);
        # this keeps replication upsampling exact and bounds the block count.
        c = 0
        while c < nc:
            if hmax % self.comp_h[c] != 0 or vmax % self.comp_v[c] != 0:
                return "JPEG sampling factors are unsupported"
            c = c + 1
        self.width = w
        self.height = h
        self.ncomp = nc
        self.hmax = hmax
        self.vmax = vmax
        self.progressive = progressive
        self.mcux = (w + 8 * hmax - 1) / (8 * hmax)
        self.mcuy = (h + 8 * vmax - 1) / (8 * vmax)
        var total: i64 = 0
        c = 0
        while c < nc:
            self.comp_bw[c] = self.mcux * self.comp_h[c]
            self.comp_bh[c] = self.mcuy * self.comp_v[c]
            self.comp_coef_off[c] = total
            total = total + self.comp_bw[c] * self.comp_bh[c] * 64
            c = c + 1
        self.coef = _jpeg_zero_i64(total)
        self.seen_sof = true
        ""

    me parse_dqt(body: i64, body_len: i64) -> text:
        var p = body
        val end = body + body_len
        while p < end:
            val pq_tq = self.data[p].to_i64()
            val pq = pq_tq >> 4
            val tq = pq_tq & 15
            if tq > 3 or pq > 1:
                return "JPEG DQT segment is invalid"
            val entry = if pq == 0: 1 else: 2
            if p + 1 + 64 * entry > end:
                return "JPEG DQT segment is truncated"
            var k: i64 = 0
            while k < 64:
                val v = if pq == 0: self.data[p + 1 + k].to_i64() else: _jpeg_u16(self.data, p + 1 + k * 2)
                self.qt[tq * 64 + _JPEG_ZIGZAG[k]] = v
                k = k + 1
            self.qt_defined[tq] = 1
            p = p + 1 + 64 * entry
        ""

    me parse_dht(body: i64, body_len: i64) -> text:
        var p = body
        val end = body + body_len
        while p < end:
            if p + 17 > end:
                return "JPEG DHT segment is truncated"
            val tc_th = self.data[p].to_i64()
            val tc = tc_th >> 4
            val th = tc_th & 15
            if tc > 1 or th > 3:
                return "JPEG DHT table class or id is invalid"
            val slot = tc * 4 + th
            var total: i64 = 0
            var l: i64 = 1
            while l <= 16:
                total = total + self.data[p + l].to_i64()
                l = l + 1
            if total > 256 or p + 17 + total > end:
                return "JPEG DHT segment is invalid"
            var i: i64 = 0
            while i < total:
                self.huff_val[slot * 256 + i] = self.data[p + 17 + i].to_i64()
                i = i + 1
            i = 0
            while i < _JPEG_LOOK_SIZE:
                self.huff_look[slot * _JPEG_LOOK_SIZE + i] = 0
                i = i + 1
            # Canonical code generation (JPEG Annex C) with overflow check.
            var code: i64 = 0
            var k: i64 = 0
            l = 1
            while l <= 16:
                val count = self.data[p + l].to_i64()
                self.huff_valptr[slot * 17 + l] = k
                self.huff_mincode[slot * 17 + l] = code
                var n: i64 = 0
                while n < count:
                    if l <= _JPEG_LOOK_BITS:
                        val shift = _JPEG_LOOK_BITS - l
                        val base = code << shift
                        var f: i64 = 0
                        while f < (1 << shift):
                            self.huff_look[slot * _JPEG_LOOK_SIZE + base + f] = (l << 8) | self.huff_val[slot * 256 + k]
                            f = f + 1
                    code = code + 1
                    k = k + 1
                    n = n + 1
                if code > (1 << l):
                    return "JPEG Huffman table is oversubscribed"
                self.huff_maxcode[slot * 18 + l] = if count > 0: code - 1 else: -1
                code = code << 1
                l = l + 1
            self.huff_defined[slot] = 1
            p = p + 17 + total
        ""

    me parse_sos(body: i64, body_len: i64) -> text:
        if not self.seen_sof:
            return "JPEG scan precedes the frame header"
        if body_len < 1:
            return "JPEG SOS segment is truncated"
        val ns = self.data[body].to_i64()
        if ns < 1 or ns > 4 or ns > self.ncomp or body_len != 4 + ns * 2:
            return "JPEG SOS segment is invalid"
        var blocks_in_mcu: i64 = 0
        var i: i64 = 0
        while i < ns:
            val cid = self.data[body + 1 + i * 2].to_i64()
            val tables = self.data[body + 2 + i * 2].to_i64()
            var ci: i64 = -1
            var c: i64 = 0
            while c < self.ncomp:
                if self.comp_id[c] == cid:
                    ci = c
                c = c + 1
            if ci < 0:
                return "JPEG scan references an unknown component"
            var j: i64 = 0
            while j < i:
                if self.scan_comp[j] == ci:
                    return "JPEG scan repeats a component"
                j = j + 1
            val td = tables >> 4
            val ta = tables & 15
            if td > 3 or ta > 3:
                return "JPEG scan Huffman table id is invalid"
            self.scan_comp[i] = ci
            self.scan_td[i] = td
            self.scan_ta[i] = ta
            blocks_in_mcu = blocks_in_mcu + self.comp_h[ci] * self.comp_v[ci]
            i = i + 1
        if ns > 1 and blocks_in_mcu > 10:
            return "JPEG scan MCU is too large"
        self.scan_ns = ns
        val p = body + 1 + ns * 2
        val ss = self.data[p].to_i64()
        val se = self.data[p + 1].to_i64()
        val ah = self.data[p + 2].to_i64() >> 4
        val al = self.data[p + 2].to_i64() & 15
        if self.progressive:
            if ss > se or se > 63 or ah > 13 or al > 13:
                return "JPEG progressive scan parameters are invalid"
            if ss == 0 and se != 0:
                return "JPEG progressive DC scan has AC coefficients"
            if ss > 0 and ns != 1:
                return "JPEG progressive AC scan is interleaved"
        elif ss != 0 or se != 63 or ah != 0 or al != 0:
            return "JPEG sequential scan parameters are invalid"
        self.scan_ss = ss
        self.scan_se = se
        self.scan_ah = ah
        self.scan_al = al
        # Snapshot quantization tables on a component's first scan and make
        # sure every Huffman table this scan uses exists.
        i = 0
        while i < ns:
            val ci = self.scan_comp[i]
            if self.comp_q_ready[ci] == 0:
                val tq = self.comp_tq[ci]
                if self.qt_defined[tq] == 0:
                    return "JPEG quantization table is undefined"
                var k: i64 = 0
                while k < 64:
                    self.comp_q[ci * 64 + k] = self.qt[tq * 64 + k]
                    k = k + 1
                self.comp_q_ready[ci] = 1
            val needs_dc = ss == 0 and ah == 0
            val needs_ac = se > 0 and (not self.progressive or ss > 0)
            if needs_dc and self.huff_defined[self.scan_td[i]] == 0:
                return "JPEG DC Huffman table is undefined"
            if needs_ac and self.huff_defined[4 + self.scan_ta[i]] == 0:
                return "JPEG AC Huffman table is undefined"
            i = i + 1
        ""

    me parse_exif(body: i64, body_len: i64):
        """Record the EXIF IFD0 Orientation tag (0x0112). Malformed EXIF is
        ignored (orientation stays 1); it never fails the decode."""
        if body_len < 14:
            return
        if not (self.data[body] == 69u8 and self.data[body + 1] == 120u8 and self.data[body + 2] == 105u8 and self.data[body + 3] == 102u8 and self.data[body + 4] == 0u8 and self.data[body + 5] == 0u8):
            return
        val tiff = body + 6
        val tiff_len = body_len - 6
        val b0 = self.data[tiff].to_i64()
        val b1 = self.data[tiff + 1].to_i64()
        var little = false
        if b0 == 73 and b1 == 73:
            little = true
        elif not (b0 == 77 and b1 == 77):
            return
        val ifd = self._exif_u32(tiff, 4, little)
        if ifd < 8 or ifd + 2 > tiff_len:
            return
        val count = self._exif_u16(tiff, ifd, little)
        var e: i64 = 0
        while e < count:
            val entry = ifd + 2 + e * 12
            if entry + 12 > tiff_len:
                return
            if self._exif_u16(tiff, entry, little) == 0x0112:
                val v = self._exif_u16(tiff, entry + 8, little)
                if v >= 1 and v <= 8:
                    self.exif_orientation = v
                return
            e = e + 1

    fn _exif_u16(base: i64, off: i64, little: bool) -> i64:
        val a = self.data[base + off].to_i64()
        val b = self.data[base + off + 1].to_i64()
        if little: (b << 8) | a else: (a << 8) | b

    fn _exif_u32(base: i64, off: i64, little: bool) -> i64:
        val lo = self._exif_u16(base, off, little)
        val hi = self._exif_u16(base, off + 2, little)
        if little: (hi << 16) | lo else: (lo << 16) | hi

    # ------------------------------------------------------------------
    # Entropy-coded segment bit reader
    # ------------------------------------------------------------------

    me fill_bits():
        """Top the bit buffer up to at least 25 bits. At a marker (or the
        end of input) zero bytes are fed instead; `overrun` counts them."""
        while self.bitcnt < 25:
            var b: i64 = 0
            if self.hit_marker or self.pos >= self.data.len():
                self.overrun = self.overrun + 1
            else:
                b = self.data[self.pos].to_i64()
                if b == 255:
                    val nxt = if self.pos + 1 < self.data.len(): self.data[self.pos + 1].to_i64() else: -1
                    if nxt == 0:
                        self.pos = self.pos + 2
                    else:
                        # A marker: leave pos on the 0xFF for the marker scanner.
                        self.hit_marker = true
                        self.overrun = self.overrun + 1
                        b = 0
                else:
                    self.pos = self.pos + 1
            self.bitbuf = ((self.bitbuf << 8) | b) & 0xFFFFFFFFFF
            self.bitcnt = self.bitcnt + 8

    me get_bits(n: i64) -> i64:
        if n == 0:
            return 0
        if self.bitcnt < n:
            self.fill_bits()
        self.bitcnt = self.bitcnt - n
        (self.bitbuf >> self.bitcnt) & ((1 << n) - 1)

    me decode_huff(slot: i64) -> i64:
        """Decode one symbol; -1 on an invalid code."""
        if self.bitcnt < 16:
            self.fill_bits()
        val peek = (self.bitbuf >> (self.bitcnt - _JPEG_LOOK_BITS)) & (_JPEG_LOOK_SIZE - 1)
        val e = self.huff_look[slot * _JPEG_LOOK_SIZE + peek]
        if e > 0:
            self.bitcnt = self.bitcnt - (e >> 8)
            return e & 255
        var l: i64 = _JPEG_LOOK_BITS + 1
        while l <= 16:
            val code = (self.bitbuf >> (self.bitcnt - l)) & ((1 << l) - 1)
            if code <= self.huff_maxcode[slot * 18 + l]:
                self.bitcnt = self.bitcnt - l
                val idx = self.huff_valptr[slot * 17 + l] + code - self.huff_mincode[slot * 17 + l]
                if idx < 0 or idx > 255:
                    return -1
                return self.huff_val[slot * 256 + idx]
            l = l + 1
        -1

    me receive_extend(s: i64) -> i64:
        if s == 0:
            return 0
        val v = self.get_bits(s)
        if v < (1 << (s - 1)):
            return v - (1 << s) + 1
        v

    me reset_bits():
        self.bitbuf = 0
        self.bitcnt = 0

    me process_restart() -> text:
        """Consume the RSTn marker that ends a restart interval and reset
        the DC predictors / EOB run."""
        self.reset_bits()
        self.hit_marker = false
        self.overrun = 0
        # Skip any padding up to the marker.
        while self.pos + 1 < self.data.len() and not (self.data[self.pos] == 255u8 and self.data[self.pos + 1] != 0u8 and self.data[self.pos + 1] != 255u8):
            self.pos = self.pos + 1
        if self.pos + 1 >= self.data.len():
            return "JPEG restart marker is missing"
        val m = self.data[self.pos + 1].to_i64()
        if m < 0xD0 or m > 0xD7:
            return "JPEG restart marker is missing"
        self.pos = self.pos + 2
        var c: i64 = 0
        while c < 4:
            self.comp_pred[c] = 0
            c = c + 1
        self.eobrun = 0
        ""

    # ------------------------------------------------------------------
    # Scan decoding
    # ------------------------------------------------------------------

    me decode_scan() -> text:
        self.reset_bits()
        self.hit_marker = false
        self.overrun = 0
        self.eobrun = 0
        var c: i64 = 0
        while c < 4:
            self.comp_pred[c] = 0
            c = c + 1
        var units: i64 = 0
        var mcus_w: i64 = 0
        if self.scan_ns == 1:
            # Non-interleaved: the component's own block grid, not MCU-padded.
            val ci = self.scan_comp[0]
            val cw = (self.width * self.comp_h[ci] + self.hmax - 1) / self.hmax
            val ch = (self.height * self.comp_v[ci] + self.vmax - 1) / self.vmax
            mcus_w = (cw + 7) / 8
            units = mcus_w * ((ch + 7) / 8)
        else:
            mcus_w = self.mcux
            units = self.mcux * self.mcuy
        var n: i64 = 0
        var since_restart: i64 = 0
        while n < units:
            if self.restart_interval > 0 and since_restart == self.restart_interval:
                val rerr = self.process_restart()
                if rerr != "":
                    return rerr
                since_restart = 0
            val ux = n % mcus_w
            val uy = n / mcus_w
            var err = ""
            if self.scan_ns == 1:
                val ci = self.scan_comp[0]
                err = self.decode_block(0, self.comp_coef_off[ci] + (uy * self.comp_bw[ci] + ux) * 64)
            else:
                var i: i64 = 0
                while i < self.scan_ns and err == "":
                    val ci = self.scan_comp[i]
                    var v: i64 = 0
                    while v < self.comp_v[ci] and err == "":
                        var h: i64 = 0
                        while h < self.comp_h[ci] and err == "":
                            val bx = ux * self.comp_h[ci] + h
                            val by = uy * self.comp_v[ci] + v
                            err = self.decode_block(i, self.comp_coef_off[ci] + (by * self.comp_bw[ci] + bx) * 64)
                            h = h + 1
                        v = v + 1
                    i = i + 1
            if err != "":
                return err
            # Entropy data ran out (truncation) well past the last real byte.
            if self.overrun > 4 and not self.hit_marker:
                return "JPEG entropy-coded data is truncated"
            n = n + 1
            since_restart = since_restart + 1
        self.reset_bits()
        ""

    me decode_block(scan_index: i64, base: i64) -> text:
        val ci = self.scan_comp[scan_index]
        if not self.progressive:
            return self.decode_block_sequential(ci, self.scan_td[scan_index], 4 + self.scan_ta[scan_index], base)
        if self.scan_ss == 0:
            if self.scan_ah == 0:
                val t = self.decode_huff(self.scan_td[scan_index])
                if t < 0 or t > 16:
                    return "JPEG Huffman code is invalid"
                val diff = self.receive_extend(t)
                self.comp_pred[ci] = self.comp_pred[ci] + diff
                self.coef[base] = self.comp_pred[ci] * (1 << self.scan_al)
            else:
                if self.get_bits(1) != 0:
                    self.coef[base] = self.coef[base] | (1 << self.scan_al)
            return ""
        if self.scan_ah == 0:
            return self.decode_ac_first(4 + self.scan_ta[scan_index], base)
        self.decode_ac_refine(4 + self.scan_ta[scan_index], base)

    me decode_block_sequential(ci: i64, dc_slot: i64, ac_slot: i64, base: i64) -> text:
        val t = self.decode_huff(dc_slot)
        if t < 0 or t > 16:
            return "JPEG Huffman code is invalid"
        val diff = self.receive_extend(t)
        self.comp_pred[ci] = self.comp_pred[ci] + diff
        self.coef[base] = self.comp_pred[ci]
        var k: i64 = 1
        while k < 64:
            val rs = self.decode_huff(ac_slot)
            if rs < 0:
                return "JPEG Huffman code is invalid"
            val r = rs >> 4
            val s = rs & 15
            if s == 0:
                if r != 15:
                    break
                k = k + 16
            else:
                k = k + r
                if k > 63:
                    return "JPEG AC coefficient index is out of range"
                self.coef[base + _JPEG_ZIGZAG[k]] = self.receive_extend(s)
                k = k + 1
        ""

    me decode_ac_first(ac_slot: i64, base: i64) -> text:
        if self.eobrun > 0:
            self.eobrun = self.eobrun - 1
            return ""
        var k = self.scan_ss
        while k <= self.scan_se:
            val rs = self.decode_huff(ac_slot)
            if rs < 0:
                return "JPEG Huffman code is invalid"
            val r = rs >> 4
            val s = rs & 15
            if s == 0:
                if r < 15:
                    self.eobrun = (1 << r) - 1
                    if r > 0:
                        self.eobrun = self.eobrun + self.get_bits(r)
                    break
                k = k + 16
            else:
                k = k + r
                if k > self.scan_se:
                    return "JPEG AC coefficient index is out of range"
                self.coef[base + _JPEG_ZIGZAG[k]] = self.receive_extend(s) * (1 << self.scan_al)
                k = k + 1
        ""

    me refine_nonzero(idx: i64, p1: i64):
        """Successive-approximation correction bit for a nonzero coefficient."""
        if self.get_bits(1) != 0:
            val cur = self.coef[idx]
            if (cur & p1) == 0:
                self.coef[idx] = if cur >= 0: cur + p1 else: cur - p1

    me decode_ac_refine(ac_slot: i64, base: i64) -> text:
        """libjpeg decode_mcu_AC_refine for one block."""
        val p1 = 1 << self.scan_al
        val se = self.scan_se
        var k = self.scan_ss
        if self.eobrun == 0:
            while k <= se:
                val rs = self.decode_huff(ac_slot)
                if rs < 0:
                    return "JPEG Huffman code is invalid"
                var r = rs >> 4
                var s = rs & 15
                if s != 0:
                    if s != 1:
                        return "JPEG refinement coefficient is invalid"
                    s = if self.get_bits(1) != 0: p1 else: -p1
                elif r != 15:
                    self.eobrun = 1 << r
                    if r > 0:
                        self.eobrun = self.eobrun + self.get_bits(r)
                    break
                # Skip r zero-history coefficients (refining nonzero ones on
                # the way); stop on the target zero coefficient.
                var stop = false
                while k <= se and not stop:
                    val idx = base + _JPEG_ZIGZAG[k]
                    if self.coef[idx] != 0:
                        self.refine_nonzero(idx, p1)
                        k = k + 1
                    elif r == 0:
                        stop = true
                    else:
                        r = r - 1
                        k = k + 1
                if s != 0:
                    if k > se:
                        return "JPEG AC coefficient index is out of range"
                    self.coef[base + _JPEG_ZIGZAG[k]] = s
                k = k + 1
        if self.eobrun > 0:
            while k <= se:
                val idx = base + _JPEG_ZIGZAG[k]
                if self.coef[idx] != 0:
                    self.refine_nonzero(idx, p1)
                k = k + 1
            self.eobrun = self.eobrun - 1
        ""

    # ------------------------------------------------------------------
    # Reconstruction: dequantize + IDCT + upsample + color convert
    # ------------------------------------------------------------------

    me reconstruct() -> text:
        var total: i64 = 0
        var c: i64 = 0
        while c < self.ncomp:
            if self.comp_q_ready[c] == 0:
                return "JPEG component has no scan data"
            self.plane_off[c] = total
            self.plane_stride[c] = self.comp_bw[c] * 8
            total = total + self.comp_bw[c] * 8 * self.comp_bh[c] * 8
            c = c + 1
        self.planes = _jpeg_zero_i64(total)
        c = 0
        while c < self.ncomp:
            var by: i64 = 0
            while by < self.comp_bh[c]:
                var bx: i64 = 0
                while bx < self.comp_bw[c]:
                    self.idct_block(c, self.comp_coef_off[c] + (by * self.comp_bw[c] + bx) * 64,
                        self.plane_off[c] + by * 8 * self.plane_stride[c] + bx * 8)
                    bx = bx + 1
                by = by + 1
            c = c + 1
        self.coef = []
        self.color_convert()
        ""

    me idct_block(c: i64, cbase: i64, obase: i64):
        """libjpeg jpeg_idct_islow (CONST_BITS 13, PASS1_BITS 2), range
        limited to 0..255 after the +128 level shift."""
        val qbase = c * 64
        val stride = self.plane_stride[c]
        # Pass 1: columns -> workspace.
        var col: i64 = 0
        while col < 8:
            val i0 = cbase + col
            val q0 = qbase + col
            val c1 = self.coef[i0 + 8]
            val c2 = self.coef[i0 + 16]
            val c3 = self.coef[i0 + 24]
            val c4 = self.coef[i0 + 32]
            val c5 = self.coef[i0 + 40]
            val c6 = self.coef[i0 + 48]
            val c7 = self.coef[i0 + 56]
            if c1 == 0 and c2 == 0 and c3 == 0 and c4 == 0 and c5 == 0 and c6 == 0 and c7 == 0:
                val dcval = (self.coef[i0] * self.comp_q[q0]) << 2
                var r: i64 = 0
                while r < 8:
                    self.ws[col + r * 8] = dcval
                    r = r + 1
            else:
                val d0 = self.coef[i0] * self.comp_q[q0]
                val d1 = c1 * self.comp_q[q0 + 8]
                val d2 = c2 * self.comp_q[q0 + 16]
                val d3 = c3 * self.comp_q[q0 + 24]
                val d4 = c4 * self.comp_q[q0 + 32]
                val d5 = c5 * self.comp_q[q0 + 40]
                val d6 = c6 * self.comp_q[q0 + 48]
                val d7 = c7 * self.comp_q[q0 + 56]
                val z1 = (d2 + d6) * _FIX_0_541196100
                val tmp2 = z1 - d6 * _FIX_1_847759065
                val tmp3 = z1 + d2 * _FIX_0_765366865
                val tmp0 = (d0 + d4) << 13
                val tmp1 = (d0 - d4) << 13
                val tmp10 = tmp0 + tmp3
                val tmp13 = tmp0 - tmp3
                val tmp11 = tmp1 + tmp2
                val tmp12 = tmp1 - tmp2
                val o1 = d7 + d1
                val o2 = d5 + d3
                val o3 = d7 + d3
                val o4 = d5 + d1
                val z5 = (o3 + o4) * _FIX_1_175875602
                val zz1 = o1 * (0 - _FIX_0_899976223)
                val zz2 = o2 * (0 - _FIX_2_562915447)
                val zz3 = o3 * (0 - _FIX_1_961570560) + z5
                val zz4 = o4 * (0 - _FIX_0_390180644) + z5
                val t0 = d7 * _FIX_0_298631336 + zz1 + zz3
                val t1 = d5 * _FIX_2_053119869 + zz2 + zz4
                val t2 = d3 * _FIX_3_072711026 + zz2 + zz3
                val t3 = d1 * _FIX_1_501321110 + zz1 + zz4
                self.ws[col] = (tmp10 + t3 + 1024) >> 11
                self.ws[col + 56] = (tmp10 - t3 + 1024) >> 11
                self.ws[col + 8] = (tmp11 + t2 + 1024) >> 11
                self.ws[col + 48] = (tmp11 - t2 + 1024) >> 11
                self.ws[col + 16] = (tmp12 + t1 + 1024) >> 11
                self.ws[col + 40] = (tmp12 - t1 + 1024) >> 11
                self.ws[col + 24] = (tmp13 + t0 + 1024) >> 11
                self.ws[col + 32] = (tmp13 - t0 + 1024) >> 11
            col = col + 1
        # Pass 2: rows -> samples.
        var row: i64 = 0
        while row < 8:
            val w = row * 8
            val o = obase + row * stride
            val w1 = self.ws[w + 1]
            val w2 = self.ws[w + 2]
            val w3 = self.ws[w + 3]
            val w4 = self.ws[w + 4]
            val w5 = self.ws[w + 5]
            val w6 = self.ws[w + 6]
            val w7 = self.ws[w + 7]
            if w1 == 0 and w2 == 0 and w3 == 0 and w4 == 0 and w5 == 0 and w6 == 0 and w7 == 0:
                val dc = _jpeg_clamp(((self.ws[w] + 16) >> 5) + 128)
                var x: i64 = 0
                while x < 8:
                    self.planes[o + x] = dc
                    x = x + 1
            else:
                val w0 = self.ws[w]
                val z1 = (w2 + w6) * _FIX_0_541196100
                val tmp2 = z1 - w6 * _FIX_1_847759065
                val tmp3 = z1 + w2 * _FIX_0_765366865
                val tmp0 = (w0 + w4) << 13
                val tmp1 = (w0 - w4) << 13
                val tmp10 = tmp0 + tmp3
                val tmp13 = tmp0 - tmp3
                val tmp11 = tmp1 + tmp2
                val tmp12 = tmp1 - tmp2
                val o1 = w7 + w1
                val o2 = w5 + w3
                val o3 = w7 + w3
                val o4 = w5 + w1
                val z5 = (o3 + o4) * _FIX_1_175875602
                val zz1 = o1 * (0 - _FIX_0_899976223)
                val zz2 = o2 * (0 - _FIX_2_562915447)
                val zz3 = o3 * (0 - _FIX_1_961570560) + z5
                val zz4 = o4 * (0 - _FIX_0_390180644) + z5
                val t0 = w7 * _FIX_0_298631336 + zz1 + zz3
                val t1 = w5 * _FIX_2_053119869 + zz2 + zz4
                val t2 = w3 * _FIX_3_072711026 + zz2 + zz3
                val t3 = w1 * _FIX_1_501321110 + zz1 + zz4
                self.planes[o] = _jpeg_clamp(((tmp10 + t3 + 131072) >> 18) + 128)
                self.planes[o + 7] = _jpeg_clamp(((tmp10 - t3 + 131072) >> 18) + 128)
                self.planes[o + 1] = _jpeg_clamp(((tmp11 + t2 + 131072) >> 18) + 128)
                self.planes[o + 6] = _jpeg_clamp(((tmp11 - t2 + 131072) >> 18) + 128)
                self.planes[o + 2] = _jpeg_clamp(((tmp12 + t1 + 131072) >> 18) + 128)
                self.planes[o + 5] = _jpeg_clamp(((tmp12 - t1 + 131072) >> 18) + 128)
                self.planes[o + 3] = _jpeg_clamp(((tmp13 + t0 + 131072) >> 18) + 128)
                self.planes[o + 4] = _jpeg_clamp(((tmp13 - t0 + 131072) >> 18) + 128)
            row = row + 1

    fn sample_at(c: i64, x: i64, y: i64) -> i64:
        self.planes[self.plane_off[c] + y * self.plane_stride[c] + x]

    fn upsample_plane(c: i64) -> [i64]:
        """Full-resolution (width x height) samples for component `c`, using
        libjpeg-turbo's default ("fancy") triangle filters for 2:1
        horizontal (h2v1), 2:1 both (h2v2) and 1:2 vertical (h1v2)
        expansion; other ratios replicate (libjpeg int_upsample). Edge
        context rows/columns replicate the last real sample, as libjpeg's
        context buffers do."""
        val w = self.width
        val h = self.height
        val hx = self.hmax / self.comp_h[c]
        val vx = self.vmax / self.comp_v[c]
        # Real (non-padding) extent of the downsampled component.
        val dw = (w * self.comp_h[c] + self.hmax - 1) / self.hmax
        val dh = (h * self.comp_v[c] + self.vmax - 1) / self.vmax
        var out: [i64] = [0; w * h]
        if hx == 2 and vx == 1 and dw > 2:
            var y: i64 = 0
            while y < h:
                var i: i64 = 0
                while i < dw:
                    val cur = self.sample_at(c, i, y) * 3
                    val left = if i == 0: self.sample_at(c, 0, y) else: self.sample_at(c, i - 1, y)
                    val right = if i == dw - 1: self.sample_at(c, i, y) else: self.sample_at(c, i + 1, y)
                    val x0 = 2 * i
                    if x0 < w:
                        out[y * w + x0] = if i == 0: cur / 3 else: (cur + left + 1) >> 2
                    if x0 + 1 < w:
                        out[y * w + x0 + 1] = if i == dw - 1: cur / 3 else: (cur + right + 2) >> 2
                    i = i + 1
                y = y + 1
            return out
        if hx == 2 and vx == 2 and dw > 2:
            var y: i64 = 0
            while y < h:
                val inrow = y / 2
                val near = if y % 2 == 0: inrow - 1 else: inrow + 1
                val nrow = if near < 0: 0 elif near > dh - 1: dh - 1 else: near
                var last: i64 = 0
                var cur_sum = self.sample_at(c, 0, inrow) * 3 + self.sample_at(c, 0, nrow)
                var i: i64 = 0
                while i < dw:
                    val nxt = if i + 1 < dw: self.sample_at(c, i + 1, inrow) * 3 + self.sample_at(c, i + 1, nrow) else: 0
                    val x0 = 2 * i
                    if x0 < w:
                        out[y * w + x0] = if i == 0: (cur_sum * 4 + 8) >> 4 else: (cur_sum * 3 + last + 8) >> 4
                    if x0 + 1 < w:
                        out[y * w + x0 + 1] = if i == dw - 1: (cur_sum * 4 + 7) >> 4 else: (cur_sum * 3 + nxt + 7) >> 4
                    last = cur_sum
                    cur_sum = nxt
                    i = i + 1
                y = y + 1
            return out
        if hx == 1 and vx == 2:
            var y: i64 = 0
            while y < h:
                val inrow = y / 2
                val upper = y % 2 == 0
                val near = if upper: inrow - 1 else: inrow + 1
                val nrow = if near < 0: 0 elif near > dh - 1: dh - 1 else: near
                val bias = if upper: 1 else: 2
                var x: i64 = 0
                while x < w:
                    out[y * w + x] = (self.sample_at(c, x, inrow) * 3 + self.sample_at(c, x, nrow) + bias) >> 2
                    x = x + 1
                y = y + 1
            return out
        var y: i64 = 0
        while y < h:
            val row = self.plane_off[c] + (y / vx) * self.plane_stride[c]
            var x: i64 = 0
            while x < w:
                out[y * w + x] = self.planes[row + x / hx]
                x = x + 1
            y = y + 1
        out

    me color_convert():
        """Upsample each plane to full resolution and convert to ARGB.
        YCbCr uses libjpeg jdcolor fixed point (SCALEBITS 16)."""
        val n = self.width * self.height
        var out: [u32] = [0u32; n]
        if self.ncomp == 1:
            val gray = self.upsample_plane(0)
            var i: i64 = 0
            while i < n:
                val g = gray[i].to_u32()
                out[i] = 0xFF000000u32 | (g << 16) | (g << 8) | g
                i = i + 1
            self.out_pixels = out
            return
        val rgb = self.adobe_transform == 0 or self.adobe_transform < 0 and self.comp_id[0] == 82 and self.comp_id[1] == 71 and self.comp_id[2] == 66
        val p0 = self.upsample_plane(0)
        val p1 = self.upsample_plane(1)
        val p2 = self.upsample_plane(2)
        self.planes = []
        var i: i64 = 0
        while i < n:
            val a = p0[i]
            if rgb:
                out[i] = 0xFF000000u32 | (a.to_u32() << 16) | (p1[i].to_u32() << 8) | p2[i].to_u32()
            else:
                val cb = p1[i] - 128
                val cr = p2[i] - 128
                val r = _jpeg_clamp(a + ((91881 * cr + 32768) >> 16))
                val g = _jpeg_clamp(a + ((0 - 22554 * cb - 46802 * cr + 32768) >> 16))
                val bl = _jpeg_clamp(a + ((116130 * cb + 32768) >> 16))
                out[i] = 0xFF000000u32 | (r.to_u32() << 16) | (g.to_u32() << 8) | bl.to_u32()
            i = i + 1
        self.out_pixels = out
