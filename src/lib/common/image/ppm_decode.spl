# PPM image decoder — supports P6 (binary RGB) format.
#
# Consumers import:
#   decode_ppm_to_argb(data: [u8]) -> Result<PpmImage, text>
#   PpmImage  (struct with width, height, pixels: [u32])
#
# The decoder is more lenient than the strict PPM spec: it skips comment
# lines beginning with '#' and handles \r\n line endings.

pub struct PpmImage:
    """Decoded PPM image with ARGB pixel data."""
    width: i32
    height: i32
    # Pixel buffer in row-major order: pixel[y*width+x] = 0xAARRGGBB
    pixels: [u32]

# ============================================================================
# Internal helpers
# ============================================================================

fn _ppm_is_whitespace(b: u8) -> bool:
    b == 32 or b == 9 or b == 10 or b == 13

fn _ppm_skip_whitespace_and_comments(data: [u8], pos: i64) -> i64:
    """Advance `pos` past whitespace and comment lines."""
    var p = pos
    val n = data.len()
    while p < n:
        val b = data[p]
        if _ppm_is_whitespace(b):
            p = p + 1
        else if b == 35:  # '#'
            while p < n and data[p] != 10:
                p = p + 1
        else:
            return p
    p

fn _ppm_read_int(data: [u8], pos: i64) -> (i64, i64):
    """Read a decimal integer starting at pos; return (value, new_pos)."""
    var p = _ppm_skip_whitespace_and_comments(data, pos)
    var v: i64 = 0
    val n = data.len()
    while p < n:
        val b = data[p] as i64
        if b >= 48 and b <= 57:  # '0'..'9'
            v = v * 10 + (b - 48)
            p = p + 1
        else:
            return (v, p)
    (v, p)

# ============================================================================
# Public API
# ============================================================================

pub fn decode_ppm_to_argb(data: [u8]) -> Result<PpmImage, text>:
    """Decode a P6 (binary PPM) byte buffer into an ARGB pixel array.

    Returns Ok(PpmImage) on success, Err(message) on parse failure.
    Only supports maxval <= 255 (8-bit channels).
    """
    val n = data.len()
    if n < 7:
        return Err("PPM data too short")
    # Magic: "P6"
    if data[0] != 80 or data[1] != 54:  # 'P' == 80, '6' == 54
        return Err("PPM: not a P6 file (expected magic 'P6')")
    var pos: i64 = 2
    val (width_i64, p1) = _ppm_read_int(data, pos)
    pos = p1
    val (height_i64, p2) = _ppm_read_int(data, pos)
    pos = p2
    val (maxval, p3) = _ppm_read_int(data, pos)
    pos = p3
    if width_i64 <= 0 or height_i64 <= 0:
        return Err("PPM: invalid dimensions {width_i64}x{height_i64}")
    if width_i64 > 2147483647 or height_i64 > 2147483647:
        return Err("PPM: invalid dimensions {width_i64}x{height_i64}")
    if height_i64 > 0 and width_i64 > 715827882 / height_i64:
        return Err("PPM: dimensions too large {width_i64}x{height_i64}")
    if maxval <= 0 or maxval > 255:
        return Err("PPM: unsupported maxval {maxval} (only 1-255 supported)")
    # After maxval there is exactly one whitespace byte before the pixel data
    if pos >= n:
        return Err("PPM: truncated before pixel data")
    pos = pos + 1  # consume the single whitespace separator
    val width = width_i64 as i32
    val height = height_i64 as i32
    val pixel_count = width_i64 * height_i64
    val byte_count = pixel_count * 3
    if pos + byte_count > n:
        return Err("PPM: pixel data truncated (need {byte_count} bytes, have {n - pos})")
    var pixels: [u32] = [0u32; pixel_count]
    var i: i64 = 0
    while i < pixel_count:
        val base = pos + i * 3
        val r = data[base] as i64
        val g = data[base + 1] as i64
        val b = data[base + 2] as i64
        # Scale if maxval != 255
        val rs = if maxval == 255: r else: (r * 255) / maxval
        val gs = if maxval == 255: g else: (g * 255) / maxval
        val bs = if maxval == 255: b else: (b * 255) / maxval
        # Pack as 0xAARRGGBB (fully opaque)
        val argb = (0xFF000000 as i64) | (rs << 16) | (gs << 8) | bs
        pixels[i] = argb as u32
        i = i + 1
    Ok(PpmImage(width: width, height: height, pixels: pixels))

fn _ppm_flat_pattern(rgb: i64, npix: i32) -> [u8]:
    """`npix` copies of one RGB triple, built by doubling with write_span."""
    var pat: [u8] = [0; npix * 3]
    pat[0] = (rgb >> 16) & 0xFF
    pat[1] = (rgb >> 8) & 0xFF
    pat[2] = rgb & 0xFF
    var filled = 1
    while filled < npix:  # cpu-lane-loop-ok: log2(npix) doublings
        var step = filled
        if filled + step > npix:
            step = npix - filled
        pat.write_span(pat, (filled * 3) as i64, 0, (step * 3) as i64)
        filled = filled + step
    pat

pub fn encode_ppm_p6(width: u32, height: u32, pixels: [u32]) -> [u8]:
    """Encode an ARGB pixel buffer to P6 PPM bytes.

    Alpha is discarded; channels are written as 8-bit RGB triplets.
    """
    # Store masked integer values (never `expr as u8`): an explicit `as u8` cast on
    # an element produces a u8-tagged value that the [u8]->extern marshalling drops,
    # so the resulting buffer reaches rt_file_write_bytes / socket writes as empty.
    # Masked integers store and marshal correctly.
    #
    # Pre-size the buffer and index-assign (O(n)) rather than repeated `out.push`
    # reassignment, which is O(n^2) under the interpreter and times out on
    # full-resolution frames. Header: "P6\n<width> <height>\n255\n".
    # Header bytes come from `.bytes()`, never `char_at(i) as i64`: compiled
    # (jit/cranelift) code parses a one-digit text cast, so "6" stored 6 and
    # the frame began `P\x06` (doc/08_tracking/bug/
    # char_at_as_i64_parses_digit_jit_ppm_header_2026-11-23.md).
    val header = "P6\n{width} {height}\n255\n".bytes()
    val hlen = header.len()
    val max_pixels = (2147483647 - hlen) / 3
    val width_i64 = width as i64
    val height_i64 = height as i64
    if height_i64 > 0 and width_i64 > max_pixels / height_i64:
        return []
    val count = width_i64 * height_i64
    if count > pixels.len():
        return []
    val total = hlen + (count as i32) * 3
    var out: [u8] = [0; total]
    var hi = 0
    while hi < hlen:
        out[hi] = (header[hi] as i64) & 255
        hi = hi + 1
    # Each row is built in `rowb` and copied out with one write_span; rowb
    # keeps the previous row's bytes, so (measured on 4x catalog frames,
    # where about half the rows repeat the row above and most mixed blocks
    # repeat the block above):
    #   - a row equal to the row above re-copies rowb unchanged;
    #   - a flat row is one write_span of a pre-built RGB pattern;
    #   - in a mixed row, a flat 64-pixel block is one pattern write_span, a
    #     block equal to the block above is already in rowb, and only the
    #     remaining blocks pay three byte stores per pixel.
    # Every byte is the same as the per-pixel encoding.
    val w_i = width_i64 as i32
    val h_i = height_i64 as i32
    val blk = 64
    val rlen = w_i * 3
    var rowb: [u8] = [0; rlen]
    var prev: [u32] = []
    var row_rgb: i64 = -1
    var row_pat: [u8] = []
    var blk_rgb: i64 = -1
    var blk_pat: [u8] = []
    var y = 0
    var o = hlen
    while y < h_i and w_i > 0:  # cpu-lane-loop-ok: one iteration per image row; flat rows and blocks are bulk spans
        val base = y * w_i
        # Copy the row out with write_span (packed-aware): slicing the frame
        # itself makes the interpreter materialize a boxed view of every
        # pixel (~1.2 GB transient on a 4x catalog frame).
        var row: [u32] = [0u32; w_i]
        row.write_span(pixels, 0, base as i64, w_i as i64)
        if y > 0 and row == prev:
            out.write_span(rowb, o as i64, 0, rlen as i64)
        else:
            val lo = row.min()
            if lo == row.max():
                val rgb = (lo as i64) & 0xFFFFFF
                if rgb != row_rgb:
                    row_pat = _ppm_flat_pattern(rgb, w_i)
                    row_rgb = rgb
                rowb.write_span(row_pat, 0, 0, rlen as i64)
            else:
                var x = 0
                while x < w_i:  # cpu-lane-loop-ok: one iteration per 64-pixel block
                    var n = blk
                    if x + n > w_i:
                        n = w_i - x
                    val seg = row.slice(x, x + n)
                    val slo = seg.min()
                    if slo == seg.max():
                        val rgb = (slo as i64) & 0xFFFFFF
                        if rgb != blk_rgb:
                            blk_pat = _ppm_flat_pattern(rgb, blk)
                            blk_rgb = rgb
                        rowb.write_span(blk_pat, (x * 3) as i64, 0, (n * 3) as i64)
                    elif y == 0 or seg != prev.slice(x, x + n):
                        var q = x * 3
                        for px32 in seg:  # cpu-lane-loop-ok: fresh mixed block, per-pixel stores
                            val argb = px32 as i64
                            rowb[q] = (argb >> 16) & 0xFF
                            rowb[q + 1] = (argb >> 8) & 0xFF
                            rowb[q + 2] = argb & 0xFF
                            q = q + 3
                    x = x + n
            out.write_span(rowb, o as i64, 0, rlen as i64)
        prev = row
        o = o + rlen
        y = y + 1
    out
