# Callback iteration over arrays. Indices are zero-based; indexed callbacks
# receive (value, index), matching the standalone iterable API.

pub fn each<T>(items: [T], visit: fn(T) -> void):
    """Visit each element once in array order; an empty array invokes nothing."""
    var index = 0
    while index < items.len():
        visit(items[index])
        index = index + 1

pub fn each_with_index<T>(items: [T], visit: fn(T, i64) -> void):
    """Visit each element and its zero-based index in array order."""
    var index = 0
    while index < items.len():
        visit(items[index], index)
        index = index + 1
