# Canonical bounded device-event queue shared by hosted and SimpleOS drivers.

struct SimpleDeviceEvent:
    sequence: u64
    monotonic_ns: u64
    device_clock_frames: u64
    device_id: i64
    stream_id: i64
    correlation_id: u64
    kind: text
    status: text

class SimpleDeviceEventRing:
    capacity: i64
    next_sequence: u64
    last_monotonic_ns: u64
    closed: bool
    queued: [SimpleDeviceEvent]

    static fn create(requested_capacity: i64) -> SimpleDeviceEventRing:
        var bounded = requested_capacity
        if bounded < 2:
            bounded = 2
        if bounded > 4096:
            bounded = 4096
        SimpleDeviceEventRing(capacity: bounded, next_sequence: 1u64, last_monotonic_ns: 0u64, closed: false, queued: [])

    me publish(monotonic_ns: u64, device_clock_frames: u64, device_id: i64, stream_id: i64, correlation_id: u64, kind: text, status: text) -> text:
        if self.closed:
            return "shutdown"
        if self.queued.len() >= self.capacity:
            return "queue-full"
        var ordered_ns = monotonic_ns
        if ordered_ns < self.last_monotonic_ns:
            ordered_ns = self.last_monotonic_ns
        self.queued.push(SimpleDeviceEvent(sequence: self.next_sequence, monotonic_ns: ordered_ns, device_clock_frames: device_clock_frames, device_id: device_id, stream_id: stream_id, correlation_id: correlation_id, kind: kind, status: status))
        self.next_sequence = self.next_sequence + 1u64
        self.last_monotonic_ns = ordered_ns
        "published"

    me drain() -> [SimpleDeviceEvent]:
        val result = self.queued
        self.queued = []
        result

    me shutdown(monotonic_ns: u64, device_id: i64) -> text:
        if self.closed:
            return "shutdown"
        if self.queued.len() < self.capacity:
            self.publish(monotonic_ns, 0u64, device_id, -1, 0u64, "shutdown", "completed")
        self.closed = true
        "completed"

export SimpleDeviceEvent, SimpleDeviceEventRing
