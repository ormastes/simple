enum FileReadPolicyV1:
    auto_map
    must_map
    prefer_map
    buffered

enum FileViewTransportV1:
    mapped
    buffered

fn file_read_policy_attempts_mapping_v1(policy: FileReadPolicyV1) -> bool:
    policy != FileReadPolicyV1.buffered

fn file_read_policy_allows_fallback_v1(policy: FileReadPolicyV1) -> bool:
    policy != FileReadPolicyV1.must_map

fn file_read_policy_selects_mapping_v1(
    policy: FileReadPolicyV1,
    mapping_supported: bool,
    regular_file: bool,
    file_size: u64,
    requested_length: u64,
    address_space_budget: u64
) -> bool:
    if not file_read_policy_attempts_mapping_v1(policy):
        return false
    if not mapping_supported or not regular_file:
        return false
    if requested_length == 0 or requested_length > file_size:
        return false
    if requested_length > address_space_budget:
        return false
    if policy == FileReadPolicyV1.auto_map:
        return requested_length >= 65536
    true

export FileReadPolicyV1, FileViewTransportV1
export file_read_policy_attempts_mapping_v1
export file_read_policy_allows_fallback_v1
export file_read_policy_selects_mapping_v1
