# Scalar shortcut classification at the normalized window-event boundary.

use common.io.window_event.{
    WINDOW_ACTION_PRESS,
    WINDOW_MOD_ALT,
    WINDOW_MOD_CTRL,
    WINDOW_MOD_SHIFT,
}

val WINDOW_WM_SHORTCUT_NONE: i32 = 0
val WINDOW_WM_SHORTCUT_FOCUS_NEXT: i32 = 1
val WINDOW_WM_SHORTCUT_CLOSE: i32 = 2
val WINDOW_WM_SHORTCUT_MINIMIZE: i32 = 3
val WINDOW_WM_SHORTCUT_TOGGLE_MAXIMIZE: i32 = 4

fn window_wm_shortcut_action(
    key: i64, action: i64, modifiers: i64
) -> i32:
    if action != WINDOW_ACTION_PRESS:
        return WINDOW_WM_SHORTCUT_NONE
    val alt = (modifiers & WINDOW_MOD_ALT) != 0
    val ctrl = (modifiers & WINDOW_MOD_CTRL) != 0
    val shift = (modifiers & WINDOW_MOD_SHIFT) != 0
    if alt and key == 258:
        return WINDOW_WM_SHORTCUT_FOCUS_NEXT
    if alt and key == 293:
        return WINDOW_WM_SHORTCUT_CLOSE
    if ctrl and key == 77:
        if shift:
            return WINDOW_WM_SHORTCUT_TOGGLE_MAXIMIZE
        return WINDOW_WM_SHORTCUT_MINIMIZE
    WINDOW_WM_SHORTCUT_NONE

export WINDOW_WM_SHORTCUT_NONE
export WINDOW_WM_SHORTCUT_FOCUS_NEXT, WINDOW_WM_SHORTCUT_CLOSE
export WINDOW_WM_SHORTCUT_MINIMIZE, WINDOW_WM_SHORTCUT_TOGGLE_MAXIMIZE
export window_wm_shortcut_action
