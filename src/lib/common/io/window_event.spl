# Normalized scalar window-event contract shared by hosted and SimpleOS
# adapters. Variable UTF-8 text stays in WindowEventLoop's bounded arena.

val WINDOW_STATUS_OK: i64 = 0
val WINDOW_STATUS_EMPTY: i64 = 1
val WINDOW_STATUS_UNSUPPORTED: i64 = 2
val WINDOW_STATUS_INVALID_HANDLE: i64 = 3
val WINDOW_STATUS_OVERFLOW: i64 = 4
val WINDOW_STATUS_INVALID_ARGUMENT: i64 = 5
val WINDOW_STATUS_BACKEND_ERROR: i64 = 6

val WINDOW_EVENT_NONE: i64 = 0
val WINDOW_EVENT_CLOSE: i64 = 1
val WINDOW_EVENT_FOCUS: i64 = 2
val WINDOW_EVENT_RESIZE: i64 = 3
val WINDOW_EVENT_KEY: i64 = 4
val WINDOW_EVENT_TEXT: i64 = 5
val WINDOW_EVENT_POINTER_MOVE: i64 = 6
val WINDOW_EVENT_POINTER_BUTTON: i64 = 7
val WINDOW_EVENT_WHEEL: i64 = 8

val WINDOW_ACTION_RELEASE: i64 = 0
val WINDOW_ACTION_PRESS: i64 = 1
val WINDOW_ACTION_REPEAT: i64 = 2

val WINDOW_MOD_SHIFT: i64 = 1
val WINDOW_MOD_CTRL: i64 = 2
val WINDOW_MOD_ALT: i64 = 4
val WINDOW_MOD_SUPER: i64 = 8

val WINDOW_HANDLE_GENERATION_BASE: i64 = 4294967296
val WINDOW_EVENT_WORDS: i64 = 16

fn window_generation_handle(index: i64, generation: i64) -> i64:
    if index < 0 or generation <= 0:
        return 0
    generation * WINDOW_HANDLE_GENERATION_BASE + index + 1

fn window_generation_handle_index(handle: i64) -> i64:
    if handle <= 0:
        return -1
    (handle % WINDOW_HANDLE_GENERATION_BASE) - 1

fn window_generation_handle_generation(handle: i64) -> i64:
    if handle <= 0:
        return 0
    handle / WINDOW_HANDLE_GENERATION_BASE

struct WindowEventRecord:
    kind: i64
    window_handle: i64
    sequence: i64
    timestamp_ns: i64
    key: i64
    scancode: i64
    action: i64
    modifiers: i64
    text_handle: i64
    text_length: i64
    x_milli: i64
    y_milli: i64
    delta_x_milli: i64
    delta_y_milli: i64
    width: i64
    height: i64

fn window_event_none() -> WindowEventRecord:
    WindowEventRecord(
        kind: WINDOW_EVENT_NONE,
        window_handle: 0,
        sequence: 0,
        timestamp_ns: 0,
        key: 0,
        scancode: 0,
        action: 0,
        modifiers: 0,
        text_handle: 0,
        text_length: 0,
        x_milli: 0,
        y_milli: 0,
        delta_x_milli: 0,
        delta_y_milli: 0,
        width: 0,
        height: 0
    )

fn window_event_key(window_handle: i64, sequence: i64, timestamp_ns: i64, key: i64, scancode: i64, action: i64, modifiers: i64) -> WindowEventRecord:
    var event = window_event_none()
    event.kind = WINDOW_EVENT_KEY
    event.window_handle = window_handle
    event.sequence = sequence
    event.timestamp_ns = timestamp_ns
    event.key = key
    event.scancode = scancode
    event.action = action
    event.modifiers = modifiers
    event

fn window_event_pointer(window_handle: i64, sequence: i64, timestamp_ns: i64, kind: i64, x_milli: i64, y_milli: i64, action: i64, modifiers: i64) -> WindowEventRecord:
    var event = window_event_none()
    event.kind = kind
    event.window_handle = window_handle
    event.sequence = sequence
    event.timestamp_ns = timestamp_ns
    event.x_milli = x_milli
    event.y_milli = y_milli
    event.action = action
    event.modifiers = modifiers
    event

class WindowEventLoop:
    capacity: i64
    text_capacity: i64
    event_words: [i64]
    event_head: i64
    event_count: i64
    dropped_event_count: i64
    text_values: [text]
    text_generations: [i64]
    text_live: [bool]
    polled_kind: i64
    polled_window_handle: i64
    polled_sequence: i64
    polled_timestamp_ns: i64
    polled_key: i64
    polled_scancode: i64
    polled_action: i64
    polled_modifiers: i64
    polled_text_handle: i64
    polled_text_length: i64
    polled_x_milli: i64
    polled_y_milli: i64
    polled_delta_x_milli: i64
    polled_delta_y_milli: i64
    polled_width: i64
    polled_height: i64

impl WindowEventLoop:
    static fn create(capacity: i64, text_capacity: i64) -> WindowEventLoop:
        WindowEventLoop(
            capacity: if capacity > 0: capacity else: 1,
            text_capacity: if text_capacity > 0: text_capacity else: 1,
            event_words: [],
            event_head: 0,
            event_count: 0,
            dropped_event_count: 0,
            text_values: [],
            text_generations: [],
            text_live: [],
            polled_kind: WINDOW_EVENT_NONE,
            polled_window_handle: 0,
            polled_sequence: 0,
            polled_timestamp_ns: 0,
            polled_key: 0,
            polled_scancode: 0,
            polled_action: 0,
            polled_modifiers: 0,
            polled_text_handle: 0,
            polled_text_length: 0,
            polled_x_milli: 0,
            polled_y_milli: 0,
            polled_delta_x_milli: 0,
            polled_delta_y_milli: 0,
            polled_width: 0,
            polled_height: 0
        )

    fn queued_count() -> i64:
        self.event_count

    fn text_live_count() -> i64:
        var count = 0
        var i = 0
        while i < self.text_live.len():
            if self.text_live[i]:
                count = count + 1
            i = i + 1
        count

    me allocate_text(value: text) -> i64:
        var i = 0
        while i < self.text_live.len():
            if not self.text_live[i]:
                self.text_values[i] = value
                self.text_live[i] = true
                return window_generation_handle(i, self.text_generations[i])
            i = i + 1
        if self.text_live.len() >= self.text_capacity:
            return 0
        self.text_values.push(value)
        self.text_generations.push(1)
        self.text_live.push(true)
        window_generation_handle(self.text_live.len() - 1, 1)

    fn text_value(handle: i64) -> text:
        val index = window_generation_handle_index(handle)
        val generation = window_generation_handle_generation(handle)
        if index < 0 or index >= self.text_live.len():
            return ""
        if not self.text_live[index] or self.text_generations[index] != generation:
            return ""
        self.text_values[index]

    me release_text(handle: i64) -> i64:
        val index = window_generation_handle_index(handle)
        val generation = window_generation_handle_generation(handle)
        if index < 0 or index >= self.text_live.len():
            return WINDOW_STATUS_INVALID_HANDLE
        if not self.text_live[index] or self.text_generations[index] != generation:
            return WINDOW_STATUS_INVALID_HANDLE
        self.text_live[index] = false
        self.text_values[index] = ""
        self.text_generations[index] = self.text_generations[index] + 1
        WINDOW_STATUS_OK

    me _enqueue_values(
        kind: i64,
        window_handle: i64,
        sequence: i64,
        timestamp_ns: i64,
        key: i64,
        scancode: i64,
        action: i64,
        modifiers: i64,
        text_handle: i64,
        text_length: i64,
        x_milli: i64,
        y_milli: i64,
        delta_x_milli: i64,
        delta_y_milli: i64,
        width: i64,
        height: i64
    ) -> i64:
        if self.event_count >= self.capacity:
            self.dropped_event_count = self.dropped_event_count + 1
            if text_handle != 0:
                self.release_text(text_handle)
            return WINDOW_STATUS_OVERFLOW
        val slot = (self.event_head + self.event_count) % self.capacity
        val base = slot * WINDOW_EVENT_WORDS
        while self.event_words.len() < base + WINDOW_EVENT_WORDS:
            self.event_words.push(0)
        self.event_words[base] = kind
        self.event_words[base + 1] = window_handle
        self.event_words[base + 2] = sequence
        self.event_words[base + 3] = timestamp_ns
        self.event_words[base + 4] = key
        self.event_words[base + 5] = scancode
        self.event_words[base + 6] = action
        self.event_words[base + 7] = modifiers
        self.event_words[base + 8] = text_handle
        self.event_words[base + 9] = text_length
        self.event_words[base + 10] = x_milli
        self.event_words[base + 11] = y_milli
        self.event_words[base + 12] = delta_x_milli
        self.event_words[base + 13] = delta_y_milli
        self.event_words[base + 14] = width
        self.event_words[base + 15] = height
        self.event_count = self.event_count + 1
        WINDOW_STATUS_OK

    me enqueue_scalar(
        kind: i64,
        window_handle: i64,
        sequence: i64,
        timestamp_ns: i64,
        key: i64,
        scancode: i64,
        action: i64,
        modifiers: i64,
        x_milli: i64,
        y_milli: i64,
        delta_x_milli: i64,
        delta_y_milli: i64,
        width: i64,
        height: i64
    ) -> i64:
        self._enqueue_values(
            kind, window_handle, sequence, timestamp_ns,
            key, scancode, action, modifiers, 0, 0,
            x_milli, y_milli, delta_x_milli, delta_y_milli,
            width, height
        )

    me enqueue(event: WindowEventRecord) -> i64:
        self._enqueue_values(
            event.kind,
            event.window_handle,
            event.sequence,
            event.timestamp_ns,
            event.key,
            event.scancode,
            event.action,
            event.modifiers,
            event.text_handle,
            event.text_length,
            event.x_milli,
            event.y_milli,
            event.delta_x_milli,
            event.delta_y_milli,
            event.width,
            event.height
        )

    me enqueue_text(window_handle: i64, sequence: i64, timestamp_ns: i64, value: text) -> i64:
        if value.len() == 0:
            return WINDOW_STATUS_INVALID_ARGUMENT
        val handle = self.allocate_text(value)
        if handle == 0:
            self.dropped_event_count = self.dropped_event_count + 1
            return WINDOW_STATUS_OVERFLOW
        self._enqueue_values(
            WINDOW_EVENT_TEXT,
            window_handle,
            sequence,
            timestamp_ns,
            0,
            0,
            0,
            0,
            handle,
            value.len(),
            0,
            0,
            0,
            0,
            0,
            0
        )

    me poll_scalar() -> i64:
        if self.event_count == 0:
            self.polled_kind = WINDOW_EVENT_NONE
            return WINDOW_STATUS_EMPTY
        val base = self.event_head * WINDOW_EVENT_WORDS
        self.polled_kind = self.event_words[base]
        self.polled_window_handle = self.event_words[base + 1]
        self.polled_sequence = self.event_words[base + 2]
        self.polled_timestamp_ns = self.event_words[base + 3]
        self.polled_key = self.event_words[base + 4]
        self.polled_scancode = self.event_words[base + 5]
        self.polled_action = self.event_words[base + 6]
        self.polled_modifiers = self.event_words[base + 7]
        self.polled_text_handle = self.event_words[base + 8]
        self.polled_text_length = self.event_words[base + 9]
        self.polled_x_milli = self.event_words[base + 10]
        self.polled_y_milli = self.event_words[base + 11]
        self.polled_delta_x_milli = self.event_words[base + 12]
        self.polled_delta_y_milli = self.event_words[base + 13]
        self.polled_width = self.event_words[base + 14]
        self.polled_height = self.event_words[base + 15]
        self.event_head = (self.event_head + 1) % self.capacity
        self.event_count = self.event_count - 1
        WINDOW_STATUS_OK

    me poll() -> WindowEventRecord:
        if self.poll_scalar() != WINDOW_STATUS_OK:
            return window_event_none()
        WindowEventRecord(
            kind: self.polled_kind,
            window_handle: self.polled_window_handle,
            sequence: self.polled_sequence,
            timestamp_ns: self.polled_timestamp_ns,
            key: self.polled_key,
            scancode: self.polled_scancode,
            action: self.polled_action,
            modifiers: self.polled_modifiers,
            text_handle: self.polled_text_handle,
            text_length: self.polled_text_length,
            x_milli: self.polled_x_milli,
            y_milli: self.polled_y_milli,
            delta_x_milli: self.polled_delta_x_milli,
            delta_y_milli: self.polled_delta_y_milli,
            width: self.polled_width,
            height: self.polled_height
        )

    me drop_window_events(window_handle: i64) -> i64:
        var kept_words: [i64] = []
        var dropped = 0
        var scan = 0
        while scan < self.event_count:
            val slot = (self.event_head + scan) % self.capacity
            val base = slot * WINDOW_EVENT_WORDS
            if self.event_words[base + 1] == window_handle:
                val text_handle = self.event_words[base + 8]
                if text_handle != 0:
                    self.release_text(text_handle)
                dropped = dropped + 1
            else:
                var word = 0
                while word < WINDOW_EVENT_WORDS:
                    kept_words.push(self.event_words[base + word])
                    word = word + 1
            scan = scan + 1
        self.event_words = kept_words
        self.event_head = 0
        self.event_count = self.event_count - dropped
        dropped
