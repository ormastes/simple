# Crypto utility types and byte-manipulation helpers.
# Used by sha256, sha512, hmac, and other crypto modules.
#
# Byte-level crypto APIs take and return `[u8]` (owner decision 2026-11-27).
# Word arrays (`[i64]`, `[u32]`, `[u64]`) stay only inside word-oriented
# algorithm cores (compression functions, K/IV tables, limbs).

extern fn rt_text_to_bytes(s: text) -> [u8]

use std.common.string_core.{char_from_code}

# Convert text to its UTF-8 bytes.
pub fn crypto_text_to_bytes(s: text) -> [u8]:
    rt_text_to_bytes(s)

# NOTE: the bare names `text_to_bytes` / `bytes_to_text` are NOT defined here.
# They collide with same-named helpers in std.common.string_core and
# std.common.base_encoding; the tree-walk interpreter resolves free functions by
# BARE NAME. Importers alias the `crypto_`-prefixed names instead. See
# doc/08_tracking/bug/crypto_types_text_to_bytes_collides_with_base_encoding_2026-08-21.md.

# bytes_to_hex([u8]) has one owner, std.common.binary_inspect.
pub use std.common.binary_inspect.{bytes_to_hex}

# Convert bytes back to text, one char per byte (code point = byte value).
# Uses a pure-Simple path (char_from_code) for interpreter compatibility.
fn crypto_bytes_to_text(bytes: [u8]) -> text:
    var result = ""
    var i = 0
    val n = bytes.len() as i64
    while i < n:
        result = result + char_from_code(bytes[i] as i64)
        i = i + 1
    result

pub use std.common.crypto.word_ops.{rotr64, rotl64, add_mod32, shr32, rotr32, rotl32}
