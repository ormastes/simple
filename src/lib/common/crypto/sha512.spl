# SHA-512 hash implementation per FIPS 180-4.
# Provides sha512_bytes (bytes -> bytes) and sha512_text (text -> hex).
# Also provides sha512_256_bytes and sha384_bytes variants, plus the
# word-level SHA-512-family compression API used by HMAC/PBKDF2.
#
# Arithmetic model (all execution modes: interpret, jit, cranelift):
# - Words are i64 holding the two's-complement of the unsigned 64-bit value.
# - `+` on i64 wraps mod 2^64, so FIPS 180-4 addition is plain `+`.
# - `>>` on i64 is arithmetic, so every logical shift / rotate masks the
#   sign-extended bits: ROTR^n(x) = ((x >> n) & (2^(64-n) - 1)) | (x << (64-n)).
# - [u64] arrays are NOT used: in the interpreter an element read from a
#   [u64] array shifts arithmetically, so all state lives in [i64].
# - Byte <-> word conversion is explicit big-endian (FIPS 180-4 §3.1); no
#   host-endian assumption anywhere.
#
# Performance model: one compression = 64 schedule words + 80 rounds with no
# function calls and no allocation; schedule and state live in locals, which
# also keeps the JIT from boxing a full-width i64 on every array store (an
# array store of a value outside the tagged-int range allocates and is never
# freed under the JIT, measured 2026-10-20). The 16-word block buffer is
# allocated once per digest (or once per PBKDF2 derivation) by the caller.
# Messages are absorbed block by block straight from the input (O(1) extra
# memory per block; the input is never copied or padded in full).


# @workaround bug=block_scoped_use_no_op_symbol_resolution_2026-08-18 reason=flat frontend discards function-local imports
use std.common.crypto.types.{crypto_text_to_bytes, bytes_to_hex}

# Logical right-shift of a 64-bit signed i64 by n bits (1..63).
fn _lshr64(x: i64, n: i64) -> i64:
    if n <= 0:
        return x
    if n >= 64:
        return 0
    # Shift the lower 63 bits, then add back the contribution of bit 63.
    val low63 = (x & 9223372036854775807) >> n
    if x < 0:
        low63 | (1 << (63 - n))
    else:
        low63

# Rotate-right 64-bit value by n bits using logical shift for the right half.
fn _rotr64(x: i64, n: i64) -> i64:
    val s = n & 63
    if s == 0:
        return x
    _lshr64(x, s) | (x << (64 - s))

# Wrapping 64-bit addition (kept for sha512_round, which the MIR pattern
# recogniser matches by name).
fn _wadd64(a: i64, b: i64) -> i64:
    a + b

# SHA-512 initial hash values (FIPS 180-4 §5.3.5 — fractional sqrt of primes 2..19).
fn _sha512_init() -> [i64]:
    [
         7640891576956012808,  # h0 — 0x6a09e667f3bcc908
        -4942790177534073029,  # h1 — 0xbb67ae8584caa73b
         4354685564936845355,  # h2 — 0x3c6ef372fe94f82b
        -6534734903238641935,  # h3 — 0xa54ff53a5f1d36f1
         5840696475078001361,  # h4 — 0x510e527fade682d1
        -7276294671716946913,  # h5 — 0x9b05688c2b3e6c1f
         2270897969802886507,  # h6 — 0x1f83d9abfb41bd6b
         6620516959819538809   # h7 — 0x5be0cd19137e2179
    ]

# SHA-512/256 initial hash values (distinct IV per FIPS 180-4 §5.3.6.2).
fn _sha512_256_init() -> [i64]:
    [
         2463787394917988140,  # h0 — 0x22312194fc2bf72c
        -6965556091613846334,  # h1 — 0x9f555fa3c84c64c2
         2563595384472711505,  # h2 — 0x2393b86b6f53b151
        -7622211418569250115,  # h3 — 0x963877195940eabd
        -7626776825740460061,  # h4 — 0x96283ee2a88effe3
        -4729309413028513390,  # h5 — 0xbe5e1e2553863992
         3098927326965381290,  # h6 — 0x2b0199fc2c85b8aa
         1060366662362279074   # h7 — 0x0eb72ddc81c52ca2
    ]

# ============================================================================
# Word-level SHA-512-family core (shared by SHA-512, SHA-384, SHA-512/256,
# HMAC and PBKDF2).
# ============================================================================

# Fresh 16-word message-block buffer; build once per digest/derivation.
fn sha512_family_block() -> [i64]:
    [0; 16]

# Fresh initial state: h_len 48 -> SHA-384 IV, 32 -> SHA-512/256 IV, else SHA-512 IV.
fn sha512_family_iv(h_len: i64) -> [i64]:
    if h_len == 48:
        return _sha384_init()
    if h_len == 32:
        return _sha512_256_init()
    _sha512_init()

