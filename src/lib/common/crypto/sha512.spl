    w15 = w15 + ((((w0 >> 1) & 9223372036854775807) | (w0 << 63)) ^ (((w0 >> 8) & 72057594037927935) | (w0 << 56)) ^ ((w0 >> 7) & 144115188075855871)) + w8 + ((((w13 >> 19) & 35184372088831) | (w13 << 45)) ^ (((w13 >> 61) & 7) | (w13 << 3)) ^ ((w13 >> 6) & 288230376151711743))
    tt = a + ((((f >> 14) & 1125899906842623) | (f << 50)) ^ (((f >> 18) & 70368744177663) | (f << 46)) ^ (((f >> 41) & 8388607) | (f << 23))) + (h ^ (f & (g ^ h))) + (7801388544844847127) + w15
    e = e + tt
    a = tt + ((((b >> 28) & 68719476735) | (b << 36)) ^ (((b >> 34) & 1073741823) | (b << 30)) ^ (((b >> 39) & 33554431) | (b << 25))) + ((b & c) ^ (d & (b ^ c)))
    st[0] = st[0] + a
    st[1] = st[1] + b
    st[2] = st[2] + c
    st[3] = st[3] + d
    st[4] = st[4] + e
    st[5] = st[5] + f
    st[6] = st[6] + g
    st[7] = st[7] + h

# Load the 128-byte block data[off..off+127] into w[0..15] (big-endian).
fn _sha512_load_block(w: [i64], data: [i64], off: i64):
    var j = 0
    var p = off
    while j < 16:
        w[j] = ((data[p] & 255) << 56) | ((data[p + 1] & 255) << 48) | ((data[p + 2] & 255) << 40) | ((data[p + 3] & 255) << 32) | ((data[p + 4] & 255) << 24) | ((data[p + 5] & 255) << 16) | ((data[p + 6] & 255) << 8) | (data[p + 7] & 255)
        j = j + 1
        p = p + 8

# Absorb `data` and finish the hash into st. prefix_len is the number of bytes
# (a multiple of 128) already compressed into st, e.g. 128 for an HMAC state
# primed with the ipad/opad block; it only enters the encoded bit length.
fn sha512_family_absorb(st: [i64], data: [i64], prefix_len: i64, w: [i64]):
    val n = data.len()
    var off = 0
    while off + 128 <= n:
        _sha512_load_block(w, data, off)
        sha512_family_compress(st, w)
        off = off + 128
    val rem = n - off
    var z = 0
    while z < 16:
        w[z] = 0
        z = z + 1
    var i = 0
    while i < rem:
        w[i >> 3] = w[i >> 3] | ((data[off + i] & 255) << (56 - 8 * (i & 7)))
        i = i + 1
    w[rem >> 3] = w[rem >> 3] | (128 << (56 - 8 * (rem & 7)))
    if rem >= 112:
        sha512_family_compress(st, w)
        z = 0
        while z < 16:
            w[z] = 0
            z = z + 1
    # 128-bit big-endian bit length of the whole message.
    val total = prefix_len + n
    w[14] = (total >> 61) & 7
    w[15] = total << 3
    sha512_family_compress(st, w)

# Serialise the first n_words state words as big-endian bytes.
fn sha512_family_words_to_bytes(st: [i64], n_words: i64) -> [i64]:
    var out: [i64] = [0; n_words * 8]
    var i = 0
    var p = 0
    while i < n_words:
        val x = st[i]
        out[p] = (x >> 56) & 255
        out[p + 1] = (x >> 48) & 255
        out[p + 2] = (x >> 40) & 255
        out[p + 3] = (x >> 32) & 255
        out[p + 4] = (x >> 24) & 255
        out[p + 5] = (x >> 16) & 255
        out[p + 6] = (x >> 8) & 255
        out[p + 7] = x & 255
        i = i + 1
        p = p + 8
    out

fn _sha512_digest_words(data: [i64], h_len: i64) -> [i64]:
    var st = sha512_family_iv(h_len)
    sha512_family_absorb(st, data, 0, sha512_family_block())
    st

# SHA-512 of a byte list. Returns 64-byte list.
fn sha512_bytes(data: [i64]) -> [i64]:
    sha512_family_words_to_bytes(_sha512_digest_words(data, 64), 8)

# SHA-512/256 of a byte list. Returns first 32 bytes of SHA-512 with distinct IV.
fn sha512_256_bytes(data: [i64]) -> [i64]:
    sha512_family_words_to_bytes(_sha512_digest_words(data, 32), 4)

# SHA-512 of text input. Returns 128-char lowercase hex string.
fn sha512_text(data: text) -> text:
    bytes_to_hex(sha512_bytes(crypto_text_to_bytes(data)))

# SHA-512/256 of text input. Returns 64-char lowercase hex string.
fn sha512_256_text(data: text) -> text:
    bytes_to_hex(sha512_256_bytes(crypto_text_to_bytes(data)))

# ============================================================================
# SHA-384 (FIPS 180-4 §5.3.4) — SHA-512 with distinct IV, first 48 bytes.
# ============================================================================

fn _sha384_init() -> [i64]:
    [
        -3766243637369397544,  # h0 — 0xCBBB9D5DC1059ED8
         7105036623409894663,  # h1 — 0x629A292A367CD507
        -7973340178411365097,  # h2 — 0x9159015A3070DD17
         1526699215303891257,  # h3 — 0x152FECD8F70E5939
         7436329637833083697,  # h4 — 0x67332667FFC00B31
        -8163818279084223215,  # h5 — 0x8EB44A8768581511
        -2662702644619276377,  # h6 — 0xDB0C2E0D64F98FA7
         5167115440072839076   # h7 — 0x47B5481DBEFA4FA4
    ]


# SHA-384 of a byte list. Returns 48-byte list (first 6 of 8 hash words).
fn sha384_bytes(data: [i64]) -> [i64]:
    sha512_family_words_to_bytes(_sha512_digest_words(data, 48), 6)


# SHA-384 of text input. Returns 96-char lowercase hex string.
fn sha384_text(data: text) -> text:
    bytes_to_hex(sha384_bytes(crypto_text_to_bytes(data)))

# SHA-512 round function — used by the MIR optimizer pattern recogniser.
fn sha512_round(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, hh: i64, k: i64, w: i64) -> (i64, i64):
    val big_s1 = _rotr64(e, 14) ^ _rotr64(e, 18) ^ _rotr64(e, 41)
    val ch     = (e & f) ^ ((e ^ -1) & g)
    val temp1  = _wadd64(_wadd64(_wadd64(_wadd64(hh, big_s1), ch), k), w)
    val big_s0 = _rotr64(a, 28) ^ _rotr64(a, 34) ^ _rotr64(a, 39)
    val maj    = (a & b) ^ (a & c) ^ (b & c)
    val temp2  = _wadd64(big_s0, maj)
    (_wadd64(temp1, temp2), _wadd64(d, temp1))

# Message schedule sigma_0 — used by MIR optimizer.
fn sha512_msg_schedule_1(w: i64) -> i64:
    _rotr64(w, 1) ^ _rotr64(w, 8) ^ _lshr64(w, 7)

# Message schedule sigma_1 — used by MIR optimizer.
fn sha512_msg_schedule_2(w: i64) -> i64:
    _rotr64(w, 19) ^ _rotr64(w, 61) ^ _lshr64(w, 6)
