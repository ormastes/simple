# RSASSA-PSS verify with SHA-256 / MGF1-SHA-256 — pure Simple common crypto.
#
# RFC 8017 section 8.1.2 (RSASSA-PSS-VERIFY) and section 9.1.2 (EMSA-PSS-VERIFY).
# TLS 1.3 rsa_pss_rsae_sha256 uses salt length = hash length (32).
#
# Exports:
#   rsa_pss_verify_sha256(n, e, message, signature)                  -> bool  (sLen = 32)
#   rsa_pss_verify_sha256_with_salt_len(n, e, message, signature, s) -> bool
#   rsa_pss_emsa_verify_sha256(message, em, em_bits, salt_len)       -> bool  (encoding check only)
#
# n, e are raw big-endian integer bytes (no DER wrapper; leading zero allowed).
# The RSA public operation reuses rsa_pkcs1_raw_modexp (see the BUG note in
# rsa_pkcs1.spl: a 2048-bit modexp is slow in the interpreter).
#
# tag: crypto, rsa, pss

use std.common.crypto.sha256.{sha256_bytes}
use std.common.crypto.rsa_pkcs1.{rsa_pkcs1_raw_modexp}

fn _pss_ints(src: [u8]) -> [i64]:
    var out: [i64] = []
    var i: u64 = 0
    while i < src.len():
        out.push(src[i].to_i64())
        i = i + 1
    out

fn _pss_sha256(data: [i64]) -> [i64]:
    sha256_bytes(data)

# MGF1 (RFC 8017 appendix B.2.1) with SHA-256.
fn _pss_mgf1(seed: [i64], mask_len: u64) -> [i64]:
    var out: [i64] = []
    var counter: i64 = 0
    while out.len() < mask_len:
        var block: [i64] = []
        var i: u64 = 0
        while i < seed.len():
            block.push(seed[i])
            i = i + 1
        block.push((counter / 16777216) % 256)
        block.push((counter / 65536) % 256)
        block.push((counter / 256) % 256)
        block.push(counter % 256)
        val h = _pss_sha256(block)
        var j: u64 = 0
        while j < h.len():
            out.push(h[j])
            j = j + 1
        counter = counter + 1
    var trimmed: [i64] = []
    var k: u64 = 0
    while k < mask_len:
        trimmed.push(out[k])
        k = k + 1
    trimmed

# EMSA-PSS-VERIFY — RFC 8017 section 9.1.2, hLen = 32.
# em: encoded message of ceil(em_bits / 8) bytes.
fn rsa_pss_emsa_verify_sha256(message: [u8], em: [u8], em_bits: i64, salt_len: i64) -> bool:
    val h_len: i64 = 32
    val em_len: i64 = (em_bits + 7) / 8
    if salt_len < 0:
        return false
    if em.len().to_i64() != em_len:
        return false
    if em_len < h_len + salt_len + 2:
        return false
    val e = _pss_ints(em)
    if e[(em_len - 1).to_u64()] != 188:
        return false
    val db_len: u64 = (em_len - h_len - 1).to_u64()
    var masked: [i64] = []
    var i: u64 = 0
    while i < db_len:
        masked.push(e[i])
        i = i + 1
    var h: [i64] = []
    while i < db_len + 32:
        h.push(e[i])
        i = i + 1
    val top_bits: i64 = 8 * em_len - em_bits
    val keep_mask: i64 = 255 >> top_bits.to_u64()
    if (masked[0] & (255 ^ keep_mask)) != 0:
        return false
    val db_mask = _pss_mgf1(h, db_len)
    var db: [i64] = []
    var k: u64 = 0
    while k < db_len:
        db.push(masked[k] ^ db_mask[k])
        k = k + 1
    db[0] = db[0] & keep_mask
    val pad_len: u64 = (em_len - h_len - salt_len - 2).to_u64()
    var z: u64 = 0
    var bad: i64 = 0
    while z < pad_len:
        bad = bad | db[z]
        z = z + 1
    if bad != 0:
        return false
    if db[pad_len] != 1:
        return false
    var mprime: [i64] = []
    var p: i64 = 0
    while p < 8:
        mprime.push(0)
        p = p + 1
    val mhash = _pss_sha256(_pss_ints(message))
    var q: u64 = 0
    while q < mhash.len():
        mprime.push(mhash[q])
        q = q + 1
    var s: u64 = db_len - salt_len.to_u64()
    while s < db_len:
        mprime.push(db[s])
        s = s + 1
    val hp = _pss_sha256(mprime)
    if hp.len() != 32:
        return false
    var diff: i64 = 0
    var t: u64 = 0
    while t < 32:
        diff = diff | (hp[t] ^ h[t])
        t = t + 1
    diff == 0

fn _pss_mod_bits(n: [u8]) -> i64:
    var i: u64 = 0
    while i < n.len() and n[i] == 0x00u8:
        i = i + 1
    if i >= n.len():
        return 0
    var top = n[i].to_i64()
    var bits: i64 = 0
    while top > 0:
        bits = bits + 1
        top = top / 2
    bits + ((n.len() - i).to_i64() - 1) * 8

fn _pss_strip_zeros(n: [u8]) -> [u8]:
    var i: u64 = 0
    while i < n.len() and n[i] == 0x00u8:
        i = i + 1
    var out: [u8] = []
    while i < n.len():
        out.push(n[i])
        i = i + 1
    out

# RSASSA-PSS-VERIFY — RFC 8017 section 8.1.2 with explicit salt length.
fn rsa_pss_verify_sha256_with_salt_len(n_bytes: [u8], e_bytes: [u8], message: [u8], signature: [u8], salt_len: i64) -> bool:
    val n = _pss_strip_zeros(n_bytes)
    val k = n.len()
    if k == 0 or signature.len() != k:
        return false
    # s must be < n
    var cmp: i64 = 0
    var i: u64 = 0
    while i < k and cmp == 0:
        val a = signature[i].to_i64()
        val b = n[i].to_i64()
        if a < b:
            cmp = -1
        if a > b:
            cmp = 1
        i = i + 1
    if cmp >= 0:
        return false
    val mod_bits = _pss_mod_bits(n)
    val em_bits = mod_bits - 1
    val em_len = ((em_bits + 7) / 8).to_u64()
    val m = rsa_pkcs1_raw_modexp(signature, e_bytes, n)
    if m.len() != k:
        return false
    # EM = last em_len bytes of m; any extra leading byte must be zero
    val extra = k - em_len
    if extra > 1:
        return false
    if extra == 1 and m[0] != 0x00u8:
        return false
    var em: [u8] = []
    var j: u64 = extra
    while j < k:
        em.push(m[j])
        j = j + 1
    rsa_pss_emsa_verify_sha256(message, em, em_bits, salt_len)

# rsa_pss_rsae_sha256 / RSASSA-PSS with sLen = hLen = 32.
fn rsa_pss_verify_sha256(n_bytes: [u8], e_bytes: [u8], message: [u8], signature: [u8]) -> bool:
    rsa_pss_verify_sha256_with_salt_len(n_bytes, e_bytes, message, signature, 32)

export rsa_pss_verify_sha256, rsa_pss_verify_sha256_with_salt_len, rsa_pss_emsa_verify_sha256
