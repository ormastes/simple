# ECDH on NIST P-256 (secp256r1) with strict input validation — common crypto layer.
#
# Pure Simple.  The scalar multiplication is NOT a native call: it delegates to
# os.crypto.ecdh_p256 (Jacobian double + always-add-and-select over 256 bits,
# field arithmetic from std.common.math.field.fe_p256).  This module adds what
# a TLS ECDHE caller needs on top of that primitive:
#
#   p256_public_key(private_scalar)                 -> Result<[u8], text>
#   p256_ecdh_shared_secret(private_scalar, peer)   -> Result<[u8], text>
#
# Invalid-curve defence (SP 800-56A Rev3 5.6.2.3.3): the peer point must be a
# 65-byte uncompressed encoding 04||X||Y, X and Y must be < p, and (X, Y) must
# satisfy y^2 = x^3 - 3x + b.  The point at infinity has no uncompressed
# encoding, so it is rejected by the 0x04 / on-curve checks.  P-256 has
# cofactor 1, so an on-curve non-infinity point has prime order n and no
# further subgroup check is needed.  The private scalar must be in [1, n-1].
#
# References: RFC 5903 section 8.1, NIST CAVS KAS ECC CDH (P-256),
# SEC1 2.3.4, RFC 8446 section 7.4.2.

use std.common.math.field.fe_p256.{
    fe_add, fe_sub, fe_mul, fe_sq, fe_from_bytes, fe_eq
}
use os.crypto.ecdh_p256.{p256_keypair_pub, p256_ecdh_shared_x}

fn _p256_order_n() -> [u8]:
    [0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
     0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
     0xBCu8, 0xE6u8, 0xFAu8, 0xADu8, 0xA7u8, 0x17u8, 0x9Eu8, 0x84u8,
     0xF3u8, 0xB9u8, 0xCAu8, 0xC2u8, 0xFCu8, 0x63u8, 0x25u8, 0x51u8]

fn _p256_prime_p() -> [u8]:
    [0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0x00u8, 0x00u8, 0x00u8, 0x01u8,
     0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
     0x00u8, 0x00u8, 0x00u8, 0x00u8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
     0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8]

fn _p256_curve_b() -> [u8]:
    [0x5Au8, 0xC6u8, 0x35u8, 0xD8u8, 0xAAu8, 0x3Au8, 0x93u8, 0xE7u8,
     0xB3u8, 0xEBu8, 0xBDu8, 0x55u8, 0x76u8, 0x98u8, 0x86u8, 0xBCu8,
     0x65u8, 0x1Du8, 0x06u8, 0xB0u8, 0xCCu8, 0x53u8, 0xB0u8, 0xF6u8,
     0x3Bu8, 0xCEu8, 0x3Cu8, 0x3Eu8, 0x27u8, 0xD2u8, 0x60u8, 0x4Bu8]

# Big-endian compare of two equal-length byte strings starting at offset:
# -1 / 0 / 1.  Variable-time; only ever used on public values or for the
# range check of the scalar (which reveals only validity, not value).
fn _p256_cmp_be(a: [u8], a_off: u64, b: [u8]) -> i64:
    var i: u64 = 0
    while i < 32:
        val x = a[a_off + i].to_i64()
        val y = b[i].to_i64()
        if x < y:
            return -1
        if x > y:
            return 1
        i = i + 1
    0

fn _p256_scalar_in_range(d: [u8]) -> bool:
    if d.len() != 32:
        return false
    val n = _p256_order_n()
    var nonzero = false
    var i: u64 = 0
    while i < 32:
        if d[i] != 0x00u8:
            nonzero = true
        i = i + 1
    nonzero and _p256_cmp_be(d, 0, n) < 0

fn _p256_slice32(src: [u8], off: u64) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < 32:
        out.push(src[off + i])
        i = i + 1
    out

# Validate a 65-byte uncompressed point.  Returns "" when valid, else a reason.
fn _p256_validate_point(pt: [u8]) -> text:
    if pt.len() != 65:
        return "E-ECDH-P256-001: peer public key must be 65 bytes (04||X||Y)"
    if pt[0] != 0x04u8:
        return "E-ECDH-P256-002: peer public key is not an uncompressed point"
    val p = _p256_prime_p()
    if _p256_cmp_be(pt, 1, p) >= 0:
        return "E-ECDH-P256-003: peer X coordinate is not reduced mod p"
    if _p256_cmp_be(pt, 33, p) >= 0:
        return "E-ECDH-P256-003: peer Y coordinate is not reduced mod p"
    val x = fe_from_bytes(_p256_slice32(pt, 1))
    val y = fe_from_bytes(_p256_slice32(pt, 33))
    val x3 = fe_mul(fe_sq(x), x)
    val three_x = fe_add(fe_add(x, x), x)
    val rhs = fe_add(fe_sub(x3, three_x), fe_from_bytes(_p256_curve_b()))
    if not fe_eq(fe_sq(y), rhs):
        return "E-ECDH-P256-004: peer point is not on the P-256 curve"
    ""

# 65-byte uncompressed public key 04||X||Y for a 32-byte big-endian scalar in [1, n-1].
fn p256_public_key(private_scalar: [u8]) -> Result<[u8], text>:
    if not _p256_scalar_in_range(private_scalar):
        return Err("E-ECDH-P256-005: private scalar must be 32 bytes in [1, n-1]")
    val pub_key = p256_keypair_pub(private_scalar)
    if pub_key.len() != 65:
        return Err("E-ECDH-P256-006: public key derivation failed")
    Ok(pub_key)

# 32-byte big-endian x-coordinate of private_scalar * peer_public.
fn p256_ecdh_shared_secret(private_scalar: [u8], peer_public: [u8]) -> Result<[u8], text>:
    if not _p256_scalar_in_range(private_scalar):
        return Err("E-ECDH-P256-005: private scalar must be 32 bytes in [1, n-1]")
    val why = _p256_validate_point(peer_public)
    if why != "":
        return Err(why)
    val shared = p256_ecdh_shared_x(private_scalar, peer_public)
    if shared.len() != 32:
        return Err("E-ECDH-P256-007: shared secret derivation failed")
    Ok(shared)

export p256_public_key, p256_ecdh_shared_secret
