# Constant-time comparison utilities to prevent timing side-channel attacks.

use std.common.crypto.types.{crypto_text_to_bytes as text_to_bytes}

# The runtime's optimization barrier. Cranelift cannot fold across an external
# call, so a value routed through it stays opaque.
extern fn rt_black_box(value: i64) -> i64

# Optimization barrier — returns its argument unchanged.
#
# Semantically the identity function, but the compiler cannot see that, which
# is the whole point: an XOR-accumulate compare like
#
#     while i < n: diff = diff | (a[i] ^ b[i])
#     black_box(diff) == 0
#
# would otherwise be free to be rewritten into an early-exit branch on
# `diff != 0`, reintroducing exactly the data-dependent timing the accumulate
# loop exists to avoid. Wrap the accumulator at the final compare, not inside
# the loop.
pub fn black_box(value: i64) -> i64:
    rt_black_box(value)

# Compare two text values in constant time (timing-safe equality check).
# Returns true iff the values are equal. Comparing strings of different
# lengths always returns false (the length difference itself is not secret).
fn constant_time_compare(a: text, b: text) -> bool:
    val ab = text_to_bytes(a)
    val bb = text_to_bytes(b)
    val la = ab.len()
    val lb = bb.len()
    if la != lb:
        return false
    var diff = 0
    var i = 0
    while i < la:
        diff = diff | (ab[i] ^ bb[i])
        i = i + 1
    diff == 0

# Compare two byte lists in constant time.
# Returns true iff both lists are equal (same length and same bytes).
fn constant_time_compare_bytes(a: [i64], b: [i64]) -> bool:
    val la = a.len()
    val lb = b.len()
    if la != lb:
        return false
    var diff = 0
    var i = 0
    while i < la:
        diff = diff | (a[i] ^ b[i])
        i = i + 1
    diff == 0
