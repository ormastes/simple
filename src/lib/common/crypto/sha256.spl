# SHA-256 hash implementation per FIPS 180-4.
# Provides sha256_bytes (bytes -> bytes) and sha256_text (text -> hex).
#
# DUPLICATE-OF: src/lib/nogc_sync_mut/enterprise_store/audit_hash.spl
# (`audit_sha256_hex`). That file is a deliberate second SHA-256 implementation,
# not dead code: this module cannot be imported into an enterprise vertical
# because standalone-SMF cross-compilation rejects the slice helpers reached via
# std.common.string_core and the sized literal `[0; n]` in sha256_bytes below.
# Read that file's header before changing hash behaviour here — the two MUST
# stay digest-identical or the audit chain diverges between SimpleOS and host.
#
# Parity is enforced by
# test/01_unit/lib/nogc_sync_mut/enterprise_store/enterprise_store_audit_hash_parity_spec.spl
# (13 vectors pinned to external reference digests). Run it after any change here.

use std.common.crypto.types.{rotr32}
use std.common.crypto.sha256_core.{sha256_initial_hash, sha256_pad_message, sha256_process_block}
use std.common.crypto.secure_memory.{secure_zero_i64_slots}
use std.common.string_core.{text_to_bytes as string_core_text_to_bytes}

# SHA-256 round constants (first 32 bits of fractional parts of cube roots of first 64 primes).
fn _sha256_k() -> [i64]:
    [
        1116352408, 1899447441, 3049323471, 3921009573,
         961987163, 1508970993, 2453635748, 2870763221,
        3624381080,  310598401,  607225278, 1426881987,
        1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774,  264347078,  604807628,
         770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671,
        3336571891, 3584528711,  113926993,  338241895,
         666307205,  773529912, 1294757372, 1396182291,
        1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771,
        3516065817, 3600352804, 4094571909,  275423344,
         430227734,  506948616,  659060556,  883997877,
         958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424,
        2428436474, 2756734187, 3204031479, 3329325298
    ]

# SHA-256 of a byte list. Returns 32-byte list (raw hash bytes).
fn sha256_bytes(data: [i64]) -> [i64]:
    val mask32 = 4294967295  # 0xFFFFFFFF
    val k = _sha256_k()

    # Initial hash values (square roots of first 8 primes).
    var h0 = 1779033703
    var h1 = 3144134277
    var h2 = 1013904242
    var h3 = 2773480762
    var h4 = 1359893119
    var h5 = 2600822924
    var h6 =  528734635
    var h7 = 1541459225

    # Pre-processing: copy data then pad.
    #
    # PERF (2026-07-25): this used to build `padded` (and the per-block `w`
    # schedule below) with `.push()` in a `while` loop instead of pre-sizing
    # and index-assigning. The documented interpreter landmine is
    # `arr = arr.push(v)` (reassignment) cloning the whole backing array per
    # call, O(N^2) for N one-at-a-time appends; see
    # reference_seed_array_push_clones_no_fast_path. This code used the bare
    # `padded.push(v)` form (no reassignment), which measured as true O(N) on
    # the seed interpreter available for verification here — so this change
    # is a hardening fix, not a proven fix of quadratic behavior on that
    # binary. It removes any dependence on `push()`'s growth strategy by
    # using the same allocation-light, pre-sized + direct-index pattern
    # already proven correct in the sibling `sha256_u8_hex` below (added for
    # exactly this class of problem on a 1.7MB font), which is unambiguously
    # O(N) regardless of interpreter. This path runs on every font load (the
    # default selected font, Noto Sans SC, is ~17.8MB) as part of
    # `font_registry._validate_selected_font_asset`, one contributor
    # investigated for the 2D-headless-showcase regression; see
    # doc/08_tracking/bug/sha256_bytes_push_quadratic_font_hash_2026-07-25.md
    # for the full before/after measurement and the separate, larger
    # remaining cause (interpreter_gc_root_scan_blowup_large_array). Output
    # is unchanged — verified against NIST FIPS 180-4 vectors.
    val data_len = data.len()
    val min_len = data_len + 9  # data + 0x80 marker + 8-byte bit-length suffix
    val block_count = (min_len + 63) / 64
    val total_len = block_count * 64
    var padded: [i64] = [0; total_len]
    var pi = 0
    while pi < data_len:
        padded[pi] = data[pi]
        pi = pi + 1

    # Append 0x80 byte. Zero padding is already in place from the array's
    # zero-initialized allocation above.
    padded[data_len] = 128

    # Append original bit-length as 8-byte big-endian, at the fixed tail.
    val bit_len = data_len * 8
    padded[total_len - 8] = (bit_len >> 56) & 255
    padded[total_len - 7] = (bit_len >> 48) & 255
    padded[total_len - 6] = (bit_len >> 40) & 255
    padded[total_len - 5] = (bit_len >> 32) & 255
    padded[total_len - 4] = (bit_len >> 24) & 255
    padded[total_len - 3] = (bit_len >> 16) & 255
    padded[total_len - 2] = (bit_len >>  8) & 255
    padded[total_len - 1] = ( bit_len        & 255)

    # Process each 64-byte block.
    var block_offset = 0
    while block_offset < total_len:
        # Build message schedule w[0..63] in a pre-sized buffer (see PERF
        # note above — no per-element `.push()`).
        var w: [i64] = [0; 64]
        var wi = 0
        while wi < 16:
            val base = block_offset + wi * 4
            val word = (
                ((padded[base    ] & 255) << 24) |
                ((padded[base + 1] & 255) << 16) |
                ((padded[base + 2] & 255) <<  8) |
                 (padded[base + 3] & 255)
            ) & mask32
            w[wi] = word
            wi = wi + 1

        wi = 16
        while wi < 64:
            val w15 = w[wi - 15]
            val w2  = w[wi - 2]
            val s0 = (rotr32(w15, 7) ^ rotr32(w15, 18) ^ (w15 >> 3)) & mask32
            val s1 = (rotr32(w2, 17) ^ rotr32(w2,  19) ^ (w2  >> 10)) & mask32
            w[wi] = (w[wi - 16] + s0 + w[wi - 7] + s1) & mask32
            wi = wi + 1

        # Working variables.
        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        var f = h5
        var g = h6
        var hh = h7

        var ri = 0
        while ri < 64:
            val big_s1 = (rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)) & mask32
            val ch     = ((e & f) ^ ((e ^ mask32) & g)) & mask32
            val temp1  = (hh + big_s1 + ch + k[ri] + w[ri]) & mask32
            val big_s0 = (rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)) & mask32
            val maj    = ((a & b) ^ (a & c) ^ (b & c)) & mask32
            val temp2  = (big_s0 + maj) & mask32

            hh = g
            g  = f
            f  = e
            e  = (d + temp1) & mask32
            d  = c
            c  = b
            b  = a
            a  = (temp1 + temp2) & mask32
            ri = ri + 1

        h0 = (h0 + a) & mask32
        h1 = (h1 + b) & mask32
        h2 = (h2 + c) & mask32
        h3 = (h3 + d) & mask32
        h4 = (h4 + e) & mask32
        h5 = (h5 + f) & mask32
        h6 = (h6 + g) & mask32
        h7 = (h7 + hh) & mask32
        block_offset = block_offset + 64

    # Produce 32-byte result.
    var result: [i64] = []
    val words = [h0, h1, h2, h3, h4, h5, h6, h7]
    var wi2 = 0
    while wi2 < 8:
        val w = words[wi2]
        result.push((w >> 24) & 255)
        result.push((w >> 16) & 255)
        result.push((w >>  8) & 255)
        result.push( w        & 255)
        wi2 = wi2 + 1
    result

# SHA-256 of text input. Returns 64-char lowercase hex string.
#
# RUNTIME-BACKED FORM (2026-08-05): the body used to be a full FIPS 180-4
# compression loop written inline in this function. Interpreted, that cost
# ~4 ms PER INPUT BYTE (721 B -> 2.3 s, 25,553 B -> 74 s measured), which made
# it 99.7% of the x25519mlkem768 paired-timing spec's runtime and stalled the
# spec entirely -- `bin/simple test` forces SIMPLE_EXECUTION_MODE=interpret
# (src/app/test_runner_new/test_runner_single.spl), so the JIT cannot rescue it.
#
# rt_tls13_sha256 is the runtime's one-shot SHA-256 over a byte buffer, already
# the established digest channel for std TLS/SSH here
# (src/lib/nogc_async_mut_noalloc/tls/{client,transcript}.spl,
# src/os/apps/sshd/ssh_session_kex.spl) and stubbed for baremetal.
#
# The FREESTANDING-SAFE constraints of the previous form are preserved: no
# [i64] crosses a Simple-function boundary (see doc/08_tracking/bug/
# cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26.md).
# Both arrays here come from externs -- the same proven-safe channel
# rt_text_to_bytes already used -- and the hex is built inline from scalars,
# so no digest array leaves this function.
#
# Digest bit-identity with the previous implementation was verified over
# n = 0,1,2,3,55,56,64,65,127,128,129,1000,25553 bytes (block-boundary cases
# included) plus the published FIPS 180-4 vectors for "" and "abc".
@unsafe(reason: "raw SHA-256 accelerator; a non-32-byte result is the unsupported or provider-failure sentinel", capabilities: [ffi])
extern fn rt_tls13_sha256(data: [u8]) -> [u8]

fn sha256_text(data: text) -> text:
    val raw = string_core_text_to_bytes(data)
    var digest: [u8] = []
    unsafe(capabilities: [ffi]):
        digest = rt_tls13_sha256(raw)
    # rt_tls13_sha256 returns a 0-length array under the Cranelift JIT while
    # returning the correct 32 bytes interpreted, so the fast path silently
    # produced the EMPTY digest for every input under `bin/simple run` (which
    # defaults to the JIT). Anything that is not a full 32-byte digest falls
    # back to the pure-Simple implementation, which is engine-independent.
    # See doc/08_tracking/bug/jit_rt_tls13_sha256_returns_empty_2026-08-05.md --
    # remove this guard only once that defect is fixed and re-measured.
    if digest.len() != 32u64:
        return sha256_u8_hex(raw)
    val hex_digits = "0123456789abcdef"
    var out: [text] = [""; 64]
    var oi = 0
    while oi < digest.len():
        val v = digest[oi] as i64
        val hi = (v >> 4) & 15
        val lo = v & 15
        out[oi * 2] = hex_digits.substring(hi, hi + 1)
        out[oi * 2 + 1] = hex_digits.substring(lo, lo + 1)
        oi = oi + 1
    out.join("")

# Virtual byte j of the SHA-256 padded message for `data` (padding computed,
# never materialized): data bytes, then 0x80, zeros, and the 8-byte big-endian
# bit length occupying [total_len-8, total_len).
fn _sha256_padded_byte(data: [u8], data_len: i64, total_len: i64, j: i64) -> i64:
    if j < data_len:
        return data[j] as i64
    if j == data_len:
        return 128
    if j >= total_len - 8:
        # Big-endian 64-bit bit length; byte_from_lsb 0 is the last byte.
        val byte_from_lsb = total_len - 1 - j
        # bit length = data_len * 8 = data_len << 3; shift the needed byte
        # down first so the <<3 cannot overflow for any real input size.
        if byte_from_lsb == 0:
            return (data_len << 3) & 255
        return (data_len >> (byte_from_lsb * 8 - 3)) & 255
    0

# SHA-256 of native bytes without copying the payload into an i64 list.
#
# ALLOCATION-LIGHT REWRITE (SimpleOS baremetal bump heap, no GC): the previous
# version allocated a fresh 64-entry block list per 64-byte block, and
# sha256_process_block allocated a fresh dynamic `w` schedule list, a fresh
# 64-entry K constants list, and a fresh h list PER BLOCK -- for a 1.7MB font
# that is 26,694 blocks and burned the remaining ~50MB of the 192MiB
# bump heap in one hash (live: `[PANIC] heap exhausted heap_off=0xbffff80`).
# Now: ONE reused [i64] w[64] schedule (index-assigned in place), ONE K list,
# hash state in 8 scalar locals, words assembled by direct indexing into the
# input, and padding synthesized virtually for the final block(s) only.
# Total allocations per call: 2 small arrays + the 64-char hex build,
# independent of input size.
fn _sha256_u8_hex_owned(data: [u8], require_zeroization: bool) -> text:
    val mask32 = 4294967295  # 0xFFFFFFFF
    val k = _sha256_k()
    var w: [i64] = []
    var zi = 0
    while zi < 64:
        w.push(0)
        zi = zi + 1

    var h0 = 1779033703
    var h1 = 3144134277
    var h2 = 1013904242
    var h3 = 2773480762
    var h4 = 1359893119
    var h5 = 2600822924
    var h6 =  528734635
    var h7 = 1541459225

    val data_len = data.len()
    # Padded length: data + 0x80 + zero pad + 8 length bytes, multiple of 64.
    val total_len = ((data_len + 8) / 64 + 1) * 64
    var block_offset = 0
    while block_offset < total_len:
        var wi = 0
        if block_offset + 64 <= data_len:
            # Fast path: whole block inside data. Named intermediates with
            # `+`/`*` combine (NOT a fused shift/or chain): the freestanding
            # cranelift aggressive build has dropped high-byte terms of fused
            # multi-byte combines before (see vfs_boot_init.spl helpers);
            # `as` casts, not bare .to_i64(), per the C7 erased-receiver
            # conversion defect.
            while wi < 16:
                val base = block_offset + wi * 4
                val b0 = data[base] as i64
                val b1 = data[base + 1] as i64
                val b2 = data[base + 2] as i64
                val b3 = data[base + 3] as i64
                w[wi] = (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3
                wi = wi + 1
        else:
            # Tail block(s): read through the virtual padded message.
            while wi < 16:
                val base = block_offset + wi * 4
                val b0 = _sha256_padded_byte(data, data_len, total_len, base)
                val b1 = _sha256_padded_byte(data, data_len, total_len, base + 1)
                val b2 = _sha256_padded_byte(data, data_len, total_len, base + 2)
                val b3 = _sha256_padded_byte(data, data_len, total_len, base + 3)
                w[wi] = (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3
                wi = wi + 1

        wi = 16
        while wi < 64:
            val w15 = w[wi - 15]
            val w2  = w[wi - 2]
            val s0 = (rotr32(w15, 7) ^ rotr32(w15, 18) ^ (w15 >> 3)) & mask32
            val s1 = (rotr32(w2, 17) ^ rotr32(w2,  19) ^ (w2  >> 10)) & mask32
            w[wi] = (w[wi - 16] + s0 + w[wi - 7] + s1) & mask32
            wi = wi + 1

        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        var f = h5
        var g = h6
        var hh = h7

        var ri = 0
        while ri < 64:
            val big_s1 = (rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)) & mask32
            val ch     = ((e & f) ^ ((e ^ mask32) & g)) & mask32
            val temp1  = (hh + big_s1 + ch + k[ri] + w[ri]) & mask32
            val big_s0 = (rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)) & mask32
            val maj    = ((a & b) ^ (a & c) ^ (b & c)) & mask32
            val temp2  = (big_s0 + maj) & mask32

            hh = g
            g  = f
            f  = e
            e  = (d + temp1) & mask32
            d  = c
            c  = b
            b  = a
            a  = (temp1 + temp2) & mask32
            ri = ri + 1

        h0 = (h0 + a) & mask32
        h1 = (h1 + b) & mask32
        h2 = (h2 + c) & mask32
        h3 = (h3 + d) & mask32
        h4 = (h4 + e) & mask32
        h5 = (h5 + f) & mask32
        h6 = (h6 + g) & mask32
        h7 = (h7 + hh) & mask32
        block_offset = block_offset + 64

    val digits = "0123456789abcdef"
    var result: [text] = [""; 64]
    val words = [h0, h1, h2, h3, h4, h5, h6, h7]
    var out_i = 0
    var result_i = 0
    while out_i < 8:
        val word = words[out_i]
        var shift = 28
        while shift >= 0:
            val nibble = (word >> shift) & 15
            result[result_i] = digits[nibble:nibble + 1]
            result_i = result_i + 1
            shift = shift - 4
        out_i = out_i + 1
    # `w` contains the expanded credential-derived message schedule and
    # `words` contains the final working-state projection. On bump/no-GC
    # targets their backing allocations otherwise survive for process life.
    val schedule_wipe = secure_zero_i64_slots(w)
    val words_wipe = secure_zero_i64_slots(words)
    if require_zeroization and
       (not schedule_wipe.verified() or not words_wipe.verified()):
        return ""
    result.join("")

fn sha256_u8_hex(data: [u8]) -> text:
    _sha256_u8_hex_owned(data, false)

fn sha256_u8_hex_zeroizing(data: [u8]) -> text?:
    """Hash bytes only when schedule/workspace volatile wipe readback passes."""
    val digest = _sha256_u8_hex_owned(data, true)
    if digest.len() == 64:
        Some(digest)
    else:
        nil

# Bounded incremental owner used by retained-handle filesystem snapshots.
# The state, block, schedule, and constants arrays are allocated once; updates
# process bytes in place and never retain the complete message.
class Sha256StreamV1:
    state: [i64]
    block: [i64]
    schedule: [i64]
    constants: [i64]
    block_len: i64
    total_bytes: u64
    finished: bool

fn sha256_stream_v1_new() -> Sha256StreamV1:
    Sha256StreamV1(
        state: [1779033703, 3144134277, 1013904242, 2773480762,
                1359893119, 2600822924, 528734635, 1541459225],
        block: [0; 64], schedule: [0; 64], constants: _sha256_k(),
        block_len: 0, total_bytes: 0u64, finished: false)

fn sha256_stream_v1_reset(stream: Sha256StreamV1):
    stream.state[0] = 1779033703
    stream.state[1] = 3144134277
    stream.state[2] = 1013904242
    stream.state[3] = 2773480762
    stream.state[4] = 1359893119
    stream.state[5] = 2600822924
    stream.state[6] = 528734635
    stream.state[7] = 1541459225
    var i = 0
    while i < 64:
        stream.block[i] = 0
        stream.schedule[i] = 0
        i = i + 1
    stream.block_len = 0
    stream.total_bytes = 0u64
    stream.finished = false

fn _sha256_stream_v1_process(stream: Sha256StreamV1):
    val mask32 = 4294967295
    var i = 0
    while i < 16:
        val base = i * 4
        stream.schedule[i] = (
            ((stream.block[base] & 255) << 24) |
            ((stream.block[base + 1] & 255) << 16) |
            ((stream.block[base + 2] & 255) << 8) |
            (stream.block[base + 3] & 255)) & mask32
        i = i + 1
    while i < 64:
        val w15 = stream.schedule[i - 15]
        val w2 = stream.schedule[i - 2]
        val s0 = (rotr32(w15, 7) ^ rotr32(w15, 18) ^ (w15 >> 3)) & mask32
        val s1 = (rotr32(w2, 17) ^ rotr32(w2, 19) ^ (w2 >> 10)) & mask32
        stream.schedule[i] = (stream.schedule[i - 16] + s0 +
            stream.schedule[i - 7] + s1) & mask32
        i = i + 1

    var a = stream.state[0]
    var b = stream.state[1]
    var c = stream.state[2]
    var d = stream.state[3]
    var e = stream.state[4]
    var f = stream.state[5]
    var g = stream.state[6]
    var hh = stream.state[7]
    i = 0
    while i < 64:
        val big_s1 = (rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)) & mask32
        val ch = ((e & f) ^ ((e ^ mask32) & g)) & mask32
        val temp1 = (hh + big_s1 + ch + stream.constants[i] + stream.schedule[i]) & mask32
        val big_s0 = (rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)) & mask32
        val maj = ((a & b) ^ (a & c) ^ (b & c)) & mask32
        val temp2 = (big_s0 + maj) & mask32
        hh = g
        g = f
        f = e
        e = (d + temp1) & mask32
        d = c
        c = b
        b = a
        a = (temp1 + temp2) & mask32
        i = i + 1
    stream.state[0] = (stream.state[0] + a) & mask32
    stream.state[1] = (stream.state[1] + b) & mask32
    stream.state[2] = (stream.state[2] + c) & mask32
    stream.state[3] = (stream.state[3] + d) & mask32
    stream.state[4] = (stream.state[4] + e) & mask32
    stream.state[5] = (stream.state[5] + f) & mask32
    stream.state[6] = (stream.state[6] + g) & mask32
    stream.state[7] = (stream.state[7] + hh) & mask32

fn _sha256_stream_v1_push(stream: Sha256StreamV1, value: i64):
    stream.block[stream.block_len] = value & 255
    stream.block_len = stream.block_len + 1
    if stream.block_len == 64:
        _sha256_stream_v1_process(stream)
        stream.block_len = 0

fn sha256_stream_v1_update(stream: Sha256StreamV1, data: [u8]) -> bool:
    val data_len = data.len()
    if stream.finished or data_len > 0x1fffffffffffffffu64 - stream.total_bytes:
        return false
    var i: u64 = 0u64
    # Complete an existing partial block once.  The former byte-at-a-time
    # helper performed a call and block-full branch for every input byte.
    while i < data_len and stream.block_len < 64:
        stream.block[stream.block_len] = data[i] as i64
        stream.block_len = stream.block_len + 1
        i = i + 1u64
    if stream.block_len == 64:
        _sha256_stream_v1_process(stream)
        stream.block_len = 0

    # Process complete blocks directly.  This preserves the exact schedule and
    # state transition while reducing dispatch/fullness checks from O(bytes) to
    # O(blocks); the byte copies remain linear and allocation-free.
    while i + 64u64 <= data_len:
        var j: i64 = 0
        while j < 64:
            stream.block[j] = data[i + j as u64] as i64
            j = j + 1
        _sha256_stream_v1_process(stream)
        i = i + 64u64

    while i < data_len:
        stream.block[stream.block_len] = data[i] as i64
        stream.block_len = stream.block_len + 1
        i = i + 1u64
    stream.total_bytes = stream.total_bytes + data_len
    true

fn sha256_stream_v1_finish_hex(stream: Sha256StreamV1) -> text?:
    if stream.finished:
        return nil
    stream.finished = true
    val bit_len = stream.total_bytes * 8u64
    _sha256_stream_v1_push(stream, 128)
    while stream.block_len != 56:
        _sha256_stream_v1_push(stream, 0)
    var shift = 56
    while shift >= 0:
        _sha256_stream_v1_push(stream, ((bit_len >> shift) & 255u64) as i64)
        shift = shift - 8

    val digits = "0123456789abcdef"
    var result: [text] = [""; 64]
    var wi = 0
    var oi = 0
    while wi < 8:
        var nibble_shift = 28
        while nibble_shift >= 0:
            val nibble = (stream.state[wi] >> nibble_shift) & 15
            result[oi] = digits[nibble:nibble + 1]
            oi = oi + 1
            nibble_shift = nibble_shift - 4
        wi = wi + 1
    Some(result.join(""))

# ============================================================================
# MIR optimizer pattern-recognition hooks
# Symbol names must match the strings in rules_crypto.spl exactly.
# ============================================================================

# Sigma_0 message schedule expansion (w[i-15]).
fn msg_schedule1(w: i64) -> i64:
    val mask32 = 4294967295
    (rotr32(w, 7) ^ rotr32(w, 18) ^ (w >> 3)) & mask32

# Sigma_1 message schedule expansion (w[i-2]).
fn msg_schedule2(w: i64) -> i64:
    val mask32 = 4294967295
    (rotr32(w, 17) ^ rotr32(w, 19) ^ (w >> 10)) & mask32

# SHA-256 scalar reference path — routes through sha256_core block processor.
# Parity target for sha256_simd_parity_spec: sha256_bytes uses inline code,
# sha256_bytes_scalar uses sha256_core (different constants + add_mod32 path).
fn sha256_bytes_scalar(data: [i64]) -> [i64]:
    val padded = sha256_pad_message(data)
    var h = sha256_initial_hash()
    var offset = 0
    val total = padded.len()
    while offset < total:
        var block: [i64] = []
        var bi = 0
        while bi < 64:
            block.push(padded.get(offset + bi))
            bi = bi + 1
        h = sha256_process_block(h, block)
        offset = offset + 64
    var result: [i64] = []
    var wi = 0
    while wi < 8:
        val w = h.get(wi)
        result.push((w >> 24) & 255)
        result.push((w >> 16) & 255)
        result.push((w >>  8) & 255)
        result.push( w        & 255)
        wi = wi + 1
    result

export sha256_u8_hex
export sha256_u8_hex_zeroizing
export Sha256StreamV1, sha256_stream_v1_new, sha256_stream_v1_reset, sha256_stream_v1_update, sha256_stream_v1_finish_hex
