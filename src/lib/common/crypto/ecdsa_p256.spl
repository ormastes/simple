# ECDSA P-256 SHA-256 sign and verify — common crypto layer.
# Uses the canonical checked signature facade for the foreign calls.
#
# Key format: PKCS#8 v1 DER-encoded private key / SPKI DER-encoded public key.
# Signature format: 64-byte fixed-width r||s (32 bytes each, big-endian).
#
# The raw boundary uses checked status descriptors.  Safe callers never receive
# an empty signature or `false` manufactured from a malformed bridge value.

use std.nogc_sync_mut.io.signature_sffi.{ecdsa_p256_sign_checked, ecdsa_p256_verify_checked}

# Sign `message` with ECDSA P-256 SHA-256.
#
# Args:
#   pkcs8:   PKCS#8 v1 DER-encoded P-256 private key.
#   message: Bytes to sign (hashed with SHA-256 inside the runtime).
#
# Returns: a 64-byte fixed-width r||s signature or a typed error.
#
# Hosted-only: requires a system CSPRNG in the runtime.
fn ecdsa_p256_sign(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    val signature = ecdsa_p256_sign_checked(pkcs8, message)?
    if signature.len() != 64:
        return Err("E-SFFI-017: ECDSA P-256 success returned a non-64-byte signature")
    Ok(signature)

# Extract raw EC point (04 || Qx || Qy, 65 bytes) from a P-256 SPKI (91 bytes).
# P-256 SPKI layout: 26 bytes of DER headers, then the 65-byte uncompressed point.
# Returns [] for any non-conforming input.
fn _spki_to_ec_point(spki: [u8]) -> Result<[u8], text>:
    if spki.len() != 91:
        Err("E-SFFI-010: invalid ECDSA P-256 SPKI length")
    else if (spki[26] as i64) != 4:
        Err("E-SFFI-010: invalid ECDSA P-256 SPKI point encoding")
    else:
        Ok(spki.slice(26, 91))

# Verify an ECDSA P-256 SHA-256 signature.
#
# Args:
#   pubkey:    DER-encoded ECDSA P-256 public key (SPKI format, 91 bytes).
#   message:   Message bytes that were signed.
#   signature: 64-byte fixed-width r||s (32 + 32, big-endian).
#
# Returns: Ok(true) for valid, Ok(false) for a cryptographic mismatch, and Err
# for malformed input or a bridge contract violation.
fn ecdsa_p256_verify(pubkey: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    if signature.len() != 64:
        return Err("E-SFFI-010: invalid ECDSA P-256 signature length")
    val ec_point = _spki_to_ec_point(pubkey)?
    ecdsa_p256_verify_checked(ec_point, message, signature)
