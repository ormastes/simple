# Fail-closed composer for one executed X25519MLKEM768 matrix row.
#
# This boundary accepts only public pinned-workload receipts and public share
# digests. It never accepts or creates a secret-derived digest. Aggregate
# comparison and seven-backend admission remain owned by matrix_receipt.

mod lib.common.crypto.x25519_mlkem768.executed_row_composer

use lib.common.crypto.x25519_mlkem768.contract.{
    X25519_MLKEM768_IMPLEMENTATION_VERSION,
    X25519_MLKEM768_PROFILE_VERSION}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend, X25519MlKem768EvidenceMode,
    X25519MlKem768EvidenceScope, X25519MlKem768EvidenceStatus,
    X25519MlKem768RunReceipt}
use lib.common.crypto.x25519_mlkem768.matrix_receipt.{
    X25519MlKem768MatrixAdmissionPhase, X25519MlKem768MatrixRow}
use lib.common.crypto.x25519_mlkem768.pinned_public_receipt.{
    X25519MlKem768PinnedSet, X25519MlKem768PinnedSetReceipt,
    X25519_MLKEM768_PINNED_MLKEM_EK_SHA256,
    X25519_MLKEM768_PINNED_MLKEM_CT_SHA256,
    X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256,
    X25519_MLKEM768_PINNED_SERVER_X25519_SHA256,
    X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
    X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256}

val _EXECUTED_ROW_EVIDENCE_SCHEMA = "x25519mlkem768-evidence-v1"
val _EXECUTED_ROW_PINNED_SCHEMA = "x25519mlkem768-pinned-workload-v3"
val _EXECUTED_ROW_PINNED_ORACLE = "mlkem-native-fd58+rfc7748"
val _EXECUTED_ROW_PINNED_FIXTURE = "mlkem-native-fd58+rfc7748-abc-v1"

fn _executed_row_hex64(value: text) -> bool:
    if value.len() != 64: return false
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        val decimal = code >= 48 and code <= 57
        val lower_hex = code >= 97 and code <= 102
        if not decimal and not lower_hex: return false
        index = index + 1
    true

fn _executed_row_field_valid(value: text) -> bool:
    value != "" and value == value.trim() and
        not value.contains("\n") and not value.contains("\r")

fn _executed_row_is_gpu(backend: X25519MlKem768EvidenceBackend) -> bool:
    backend == X25519MlKem768EvidenceBackend.Cuda or
    backend == X25519MlKem768EvidenceBackend.Vulkan or
    backend == X25519MlKem768EvidenceBackend.Metal

fn _executed_row_is_simd(backend: X25519MlKem768EvidenceBackend) -> bool:
    backend == X25519MlKem768EvidenceBackend.Avx2 or
    backend == X25519MlKem768EvidenceBackend.Neon or
    backend == X25519MlKem768EvidenceBackend.Rvv

fn _executed_row_selection_matches(
        receipt: X25519MlKem768RunReceipt) -> bool:
    match receipt.selected_backend:
        case Some(selected): selected == receipt.requested_backend
        case nil: false

fn _executed_row_set_reason(receipt: X25519MlKem768PinnedSetReceipt,
        expected_set: X25519MlKem768PinnedSet,
        expected_first_label: text, expected_second_label: text,
        expected_first_bytes: i64, expected_second_bytes: i64,
        expected_secret_bytes: i64, expected_first_sha256: text,
        expected_second_sha256: text) -> text:
    if receipt.set_id != expected_set: return "set-identity-mismatch"
    if receipt.first_output_label != expected_first_label or
            receipt.second_output_label != expected_second_label:
        return "set-public-output-label-mismatch"
    if receipt.first_output_bytes != expected_first_bytes or
            receipt.second_output_bytes != expected_second_bytes:
        return "set-public-output-length-mismatch"
    if receipt.shared_secret_bytes != expected_secret_bytes or
            receipt.recovered_secret_bytes != expected_secret_bytes:
        return "set-secret-length-mismatch"
    if not _executed_row_hex64(receipt.first_output_sha256) or
            not _executed_row_hex64(receipt.second_output_sha256):
        return "set-public-output-sha256-invalid"
    if receipt.first_output_sha256 != expected_first_sha256 or
            receipt.second_output_sha256 != expected_second_sha256:
        return "set-public-output-oracle-mismatch"
    ""

fn _executed_row_host_reason(backend: X25519MlKem768EvidenceBackend,
        host_os: text, host_arch: text) -> text:
    val arch_known = host_arch == "x86_64" or host_arch == "aarch64" or
        host_arch == "riscv64"
    val os_known = host_os == "linux" or host_os == "macos" or
        host_os == "windows" or host_os == "freebsd"
    if not arch_known or not os_known: return "unsupported-host-identity"
    if backend == X25519MlKem768EvidenceBackend.Avx2 and
            host_arch != "x86_64":
        return "avx2-host-architecture-mismatch"
    if backend == X25519MlKem768EvidenceBackend.Neon and
            host_arch != "aarch64":
        return "neon-host-architecture-mismatch"
    if backend == X25519MlKem768EvidenceBackend.Rvv and
            host_arch != "riscv64":
        return "rvv-host-architecture-mismatch"
    if backend == X25519MlKem768EvidenceBackend.Metal and host_os != "macos":
        return "metal-host-os-mismatch"
    ""

fn _executed_row_run_reason(receipt: X25519MlKem768RunReceipt,
        admitted_artifact_sha256: text) -> text:
    if receipt.schema != _EXECUTED_ROW_EVIDENCE_SCHEMA or
            receipt.implementation_version !=
                X25519_MLKEM768_IMPLEMENTATION_VERSION or
            receipt.profile_version != X25519_MLKEM768_PROFILE_VERSION:
        return "execution-contract-version-mismatch"
    if receipt.fixture_id != _EXECUTED_ROW_PINNED_FIXTURE or
            receipt.batch_size != 1:
        return "pinned-fixture-or-batch-mismatch"
    if receipt.status != X25519MlKem768EvidenceStatus.Pass:
        return "execution-status-not-pass"
    if receipt.scope != X25519MlKem768EvidenceScope.FullOperation:
        return "execution-scope-not-full-operation"
    if receipt.mode != X25519MlKem768EvidenceMode.Native or receipt.emulated:
        return "native-execution-missing"
    if not receipt.promotion_eligible:
        return "execution-not-promotion-eligible"
    if not _executed_row_selection_matches(receipt) or receipt.fallback_used:
        return "fallback-or-selection-mismatch"
    if not receipt.scalar_roundtrip_match or not receipt.absolute_oracle_match:
        return "full-output-oracle-missing"
    if receipt.client_share_bytes != 1216 or
            receipt.server_share_bytes != 1120 or
            receipt.shared_secret_bytes != 64:
        return "hybrid-output-shape-mismatch"
    if receipt.requested_backend != X25519MlKem768EvidenceBackend.ScalarCpu and
            receipt.artifact_sha256 != admitted_artifact_sha256:
        return "executed-artifact-binding-mismatch"
    if receipt.requested_backend == X25519MlKem768EvidenceBackend.Rvv:
        if receipt.observed_rvv_vlen_bits < 1:
            return "rvv-vector-length-proof-incomplete"
    elif receipt.observed_rvv_vlen_bits != 0:
        return "non-rvv-row-carries-rvv-proof"
    if _executed_row_is_gpu(receipt.requested_backend):
        if not receipt.compiled or not receipt.submitted or
                not receipt.fence_completed or not receipt.device_readback or
                receipt.kernel_invocations < 3 or
                not _executed_row_hex64(receipt.artifact_sha256) or
                not _executed_row_field_valid(receipt.device_identity):
            return "gpu-device-proof-incomplete"
    elif _executed_row_is_simd(receipt.requested_backend):
        if receipt.simd_chunk_hits < 1:
            return "simd-execution-proof-incomplete"
    ""

fn x25519_mlkem768_compose_executed_matrix_row(
        execution: X25519MlKem768RunReceipt,
        runner_artifact_sha256: text, admitted_artifact_sha256: text,
        host_os: text, host_arch: text,
        set_a: X25519MlKem768PinnedSetReceipt,
        set_b: X25519MlKem768PinnedSetReceipt,
        set_c: X25519MlKem768PinnedSetReceipt,
        client_share_sha256: text, server_share_sha256: text
        ) -> Result<X25519MlKem768MatrixRow, text>:
    if not _executed_row_field_valid(host_os) or
            not _executed_row_field_valid(host_arch):
        return Err("host-identity-invalid")
    val host_reason = _executed_row_host_reason(
        execution.requested_backend, host_os, host_arch)
    if host_reason != "": return Err(host_reason)
    if not _executed_row_hex64(execution.fixture_manifest_sha256) or
            not _executed_row_hex64(execution.fixture_source_sha256) or
            not _executed_row_hex64(execution.pinned_workload_sha256) or
            not _executed_row_hex64(execution.runner_source_sha256):
        return Err("pinned-workload-or-fixture-provenance-sha256-invalid")
    if not _executed_row_hex64(runner_artifact_sha256) or
            not _executed_row_hex64(admitted_artifact_sha256):
        return Err("artifact-provenance-sha256-invalid")
    val run_reason = _executed_row_run_reason(
        execution, admitted_artifact_sha256)
    if run_reason != "": return Err(run_reason)
    val set_a_reason = _executed_row_set_reason(
        set_a, X25519MlKem768PinnedSet.MlKem,
        "mlkem768-encapsulation-key", "mlkem768-ciphertext",
        1184, 1088, 32,
        X25519_MLKEM768_PINNED_MLKEM_EK_SHA256,
        X25519_MLKEM768_PINNED_MLKEM_CT_SHA256)
    if set_a_reason != "": return Err("set-a-" + set_a_reason)
    val set_b_reason = _executed_row_set_reason(
        set_b, X25519MlKem768PinnedSet.X25519,
        "x25519-client-public", "x25519-server-public", 32, 32, 32,
        X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256,
        X25519_MLKEM768_PINNED_SERVER_X25519_SHA256)
    if set_b_reason != "": return Err("set-b-" + set_b_reason)
    val set_c_reason = _executed_row_set_reason(
        set_c, X25519MlKem768PinnedSet.Hybrid,
        "x25519mlkem768-client-share", "x25519mlkem768-server-share",
        1216, 1120, 64,
        X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
        X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256)
    if set_c_reason != "": return Err("set-c-" + set_c_reason)
    if not _executed_row_hex64(client_share_sha256) or
            not _executed_row_hex64(server_share_sha256):
        return Err("public-wire-sha256-invalid")
    if set_c.first_output_sha256 != client_share_sha256 or
            set_c.second_output_sha256 != server_share_sha256:
        return Err("set-c-public-wire-sha256-mismatch")
    if client_share_sha256 != X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256 or
            server_share_sha256 !=
                X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256:
        return Err("public-wire-oracle-mismatch")
    Ok(X25519MlKem768MatrixRow(
        execution: execution,
        admission_phase: X25519MlKem768MatrixAdmissionPhase.Executed,
        runner_artifact_sha256: runner_artifact_sha256,
        admitted_artifact_sha256: admitted_artifact_sha256,
        host_os: host_os, host_arch: host_arch,
        pinned_workload_schema: _EXECUTED_ROW_PINNED_SCHEMA,
        pinned_oracle_id: _EXECUTED_ROW_PINNED_ORACLE,
        set_a: Some(set_a), set_b: Some(set_b), set_c: Some(set_c),
        public_wire_bytes: 2336,
        client_share_sha256: client_share_sha256,
        server_share_sha256: server_share_sha256))

export x25519_mlkem768_compose_executed_matrix_row
