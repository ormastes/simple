# Public-only typed receipt shapes for the canonical pinned A/B/C workload.
#
# These types contain public output lengths and digests only. Secret fixture
# values, secret-derived digests, and private oracle checks remain in the
# app/test workload owner that constructs a receipt after validation.

mod lib.common.crypto.x25519_mlkem768.pinned_public_receipt

val X25519_MLKEM768_PINNED_MLKEM_EK_SHA256: text =
    "c45a699a9efcb1a799578ce95f24b063b0b9ddc0879afdb3967fd9e1e3e8c247"
val X25519_MLKEM768_PINNED_MLKEM_CT_SHA256: text =
    "0b99b2af81971943e4ef6e6f17f42be4f3caa9fea18da0f63df1d43639a74743"
val X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256: text =
    "300c9c9603b92a4b39ed3958bf9240114804db4fd373012c0ca47432d63425ae"
val X25519_MLKEM768_PINNED_SERVER_X25519_SHA256: text =
    "f35e5616160a30bf3c6e79fa73c576d40205e8fc3ba4e1c6dcf93e6b98e857b"
val X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256: text =
    "5678dcb3115aa095f8b367cc1668328dfa2c96852b58f9527deb086486ecad0d"
val X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256: text =
    "26835d91412c9e7987e5e42308e8f5b9321cd3813f5eb0d54b44eebc4be00ae2"

enum X25519MlKem768PinnedSet:
    MlKem
    X25519
    Hybrid

struct X25519MlKem768PinnedSetReceipt:
    set_id: X25519MlKem768PinnedSet
    first_output_label: text
    second_output_label: text
    first_output_bytes: i64
    second_output_bytes: i64
    shared_secret_bytes: i64
    recovered_secret_bytes: i64
    first_output_sha256: text
    second_output_sha256: text

export X25519MlKem768PinnedSet, X25519MlKem768PinnedSetReceipt
export X25519_MLKEM768_PINNED_MLKEM_EK_SHA256
export X25519_MLKEM768_PINNED_MLKEM_CT_SHA256
export X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256
export X25519_MLKEM768_PINNED_SERVER_X25519_SHA256
export X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256
export X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256
