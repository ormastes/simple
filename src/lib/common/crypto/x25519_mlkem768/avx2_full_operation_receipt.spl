# Fail-closed receipt composition for one native AVX2 full hybrid operation.
#
# The cryptographic operations are performed by the pure-Simple SIMD candidate
# facade.  This module admits their retained evidence only after all three
# operations agree on the exact source-matched compiler artifact and after
# their public-output digests match the pinned absolute oracle.

mod lib.common.crypto.x25519_mlkem768.avx2_full_operation_receipt

use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Backend, X25519MlKem768Evidence,
    X25519MlKem768KeyPair, X25519MlKem768Encapsulation,
    X25519MlKem768Decapsulation,
    X25519_MLKEM768_IMPLEMENTATION_VERSION,
    X25519_MLKEM768_PROFILE_VERSION,
    X25519_MLKEM768_CLIENT_SHARE_BYTES,
    X25519_MLKEM768_SERVER_SHARE_BYTES,
    X25519_MLKEM768_SHARED_SECRET_BYTES}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend, X25519MlKem768EvidenceMode,
    X25519MlKem768EvidenceScope, X25519MlKem768EvidenceStatus,
    X25519MlKem768RunReceipt,
    x25519_mlkem768_constant_time_list_equal}
use lib.common.crypto.x25519_mlkem768.performance_attestation.{
    X25519MlKem768PerformanceAttestation,
    X25519_MLKEM768_PERFORMANCE_ATTESTATION_SCHEMA,
    X25519_MLKEM768_SIMD_MINIMUM_SPEEDUP_MILLI}

struct X25519MlKem768Avx2ReceiptBinding:
    fixture_id: text
    fixture_manifest_sha256: text
    fixture_source_sha256: text
    pinned_workload_sha256: text
    runner_source_sha256: text
    runner_artifact_sha256: text
    crypto_source_sha256: text
    stage4_source_revision: text
    stage4_binary_sha256: text
    stage4_provenance_sha256: text
    measurement_qualification_sha256: text
    qualified_timing_sha256: text
    matrix_row_set_sha256: text
    scalar_source_receipt_sha256: text
    candidate_source_receipt_sha256: text
    scalar_sample_set_sha256: text
    candidate_sample_set_sha256: text
    host_os: text
    host_arch: text
    session_id: text
    monotonic_clock_id: text
    expected_keygen_digest: text
    expected_encapsulate_digest: text
    expected_decapsulate_digest: text
    batch_size: i64

fn _avx2_binding_digest_valid(binding: X25519MlKem768Avx2ReceiptBinding) -> bool:
    sha256_lower_hex_valid(binding.fixture_manifest_sha256) and
    sha256_lower_hex_valid(binding.fixture_source_sha256) and
    sha256_lower_hex_valid(binding.pinned_workload_sha256) and
    sha256_lower_hex_valid(binding.runner_source_sha256) and
    sha256_lower_hex_valid(binding.runner_artifact_sha256) and
    sha256_lower_hex_valid(binding.crypto_source_sha256) and
    sha256_lower_hex_valid(binding.stage4_source_revision) and
    sha256_lower_hex_valid(binding.stage4_binary_sha256) and
    sha256_lower_hex_valid(binding.stage4_provenance_sha256) and
    sha256_lower_hex_valid(binding.measurement_qualification_sha256) and
    sha256_lower_hex_valid(binding.qualified_timing_sha256) and
    sha256_lower_hex_valid(binding.matrix_row_set_sha256) and
    sha256_lower_hex_valid(binding.scalar_source_receipt_sha256) and
    sha256_lower_hex_valid(binding.candidate_source_receipt_sha256) and
    sha256_lower_hex_valid(binding.scalar_sample_set_sha256) and
    sha256_lower_hex_valid(binding.candidate_sample_set_sha256) and
    sha256_lower_hex_valid(binding.expected_keygen_digest) and
    sha256_lower_hex_valid(binding.expected_encapsulate_digest) and
    sha256_lower_hex_valid(binding.expected_decapsulate_digest)

fn _avx2_evidence_reason(evidence: X25519MlKem768Evidence,
        operation: text, binding: X25519MlKem768Avx2ReceiptBinding) -> text:
    if evidence.requested_backend != X25519MlKem768Backend.Avx2 or
            evidence.selected_backend != X25519MlKem768Backend.Avx2:
        return operation + "-backend-mismatch"
    if evidence.operation != operation:
        return operation + "-operation-mismatch"
    if evidence.fallback_used or evidence.fallback_reason != "":
        return operation + "-fallback-observed"
    if not evidence.oracle_match:
        return operation + "-scalar-oracle-mismatch"
    if evidence.simd_chunk_hits < 1 or evidence.observed_rvv_vlen_bits != 0:
        return operation + "-native-avx2-receipt-invalid"
    if evidence.kernel_invocations != 0 or evidence.compiled or
            evidence.submitted or evidence.fence_completed or
            evidence.device_readback:
        return operation + "-gpu-lifecycle-observed"
    if evidence.executor_identity != "native-avx2-candidate":
        return operation + "-executor-identity-mismatch"
    if evidence.source_digest != binding.stage4_source_revision or
            evidence.artifact_digest != binding.stage4_binary_sha256 or
            evidence.execution_proof_digest != binding.stage4_binary_sha256:
        return operation + "-stage4-identity-mismatch"
    if evidence.implementation_version != X25519_MLKEM768_IMPLEMENTATION_VERSION or
            evidence.profile_version != X25519_MLKEM768_PROFILE_VERSION:
        return operation + "-version-mismatch"
    if evidence.batch_size != binding.batch_size:
        return operation + "-batch-mismatch"
    if not sha256_lower_hex_valid(evidence.configuration_digest) or
            not sha256_lower_hex_valid(evidence.input_fixture_digest) or
            not sha256_lower_hex_valid(evidence.output_digest):
        return operation + "-public-digest-invalid"
    ""

fn x25519_mlkem768_compose_avx2_full_operation_receipt(
        binding: X25519MlKem768Avx2ReceiptBinding,
        key_pair: X25519MlKem768KeyPair,
        encapsulation: X25519MlKem768Encapsulation,
        decapsulation: X25519MlKem768Decapsulation,
        performance: X25519MlKem768PerformanceAttestation? = nil
) -> Result<X25519MlKem768RunReceipt, text>:
    if binding.fixture_id == "":
        return Err("fixture-id-empty")
    if binding.host_os == "" or binding.host_arch == "" or
            binding.session_id == "" or binding.monotonic_clock_id == "":
        return Err("avx2-measurement-session-identity-empty")
    if binding.batch_size != 1:
        return Err("avx2-single-roundtrip-receipt-requires-batch-one")
    if not _avx2_binding_digest_valid(binding):
        return Err("avx2-receipt-binding-digest-invalid")
    val keygen_reason = _avx2_evidence_reason(
        key_pair.evidence, "keygen", binding)
    if keygen_reason != "": return Err(keygen_reason)
    val encapsulate_reason = _avx2_evidence_reason(
        encapsulation.evidence, "encapsulate", binding)
    if encapsulate_reason != "": return Err(encapsulate_reason)
    val decapsulate_reason = _avx2_evidence_reason(
        decapsulation.evidence, "decapsulate", binding)
    if decapsulate_reason != "": return Err(decapsulate_reason)
    if (key_pair.client_key_share.len() != X25519_MLKEM768_CLIENT_SHARE_BYTES or
            key_pair.decapsulation_key.len() != 2400 or
            key_pair.x25519_private_key.len() != 32):
        return Err("avx2-keygen-output-size-mismatch")
    if encapsulation.server_key_share.len() != X25519_MLKEM768_SERVER_SHARE_BYTES or
            encapsulation.shared_secret.len() != X25519_MLKEM768_SHARED_SECRET_BYTES or
            decapsulation.shared_secret.len() != X25519_MLKEM768_SHARED_SECRET_BYTES:
        return Err("avx2-roundtrip-output-size-mismatch")
    if not x25519_mlkem768_constant_time_list_equal(
            encapsulation.shared_secret, decapsulation.shared_secret):
        return Err("avx2-roundtrip-secret-mismatch")
    if (key_pair.evidence.configuration_digest !=
            encapsulation.evidence.configuration_digest or
            key_pair.evidence.configuration_digest !=
            decapsulation.evidence.configuration_digest):
        return Err("avx2-configuration-digest-mismatch")
    val keygen_digest = sha256_text(key_pair.evidence.output_digest)
    val encapsulate_digest = sha256_text(encapsulation.evidence.output_digest)
    val decapsulate_digest = sha256_text(decapsulation.evidence.output_digest)
    if (keygen_digest != binding.expected_keygen_digest or
            encapsulate_digest != binding.expected_encapsulate_digest or
            decapsulate_digest != binding.expected_decapsulate_digest):
        return Err("avx2-absolute-oracle-mismatch")
    if performance == nil:
        return Err("avx2-performance-attestation-missing")
    val perf = performance.unwrap()
    if (perf.schema != X25519_MLKEM768_PERFORMANCE_ATTESTATION_SCHEMA or
            perf.status != X25519MlKem768EvidenceStatus.Pass or
            perf.reason != "native-full-operation-performance-admitted" or
            perf.candidate_backend != X25519MlKem768EvidenceBackend.Avx2 or
            perf.speedup_milli < X25519_MLKEM768_SIMD_MINIMUM_SPEEDUP_MILLI or
            perf.minimum_speedup_milli !=
                X25519_MLKEM768_SIMD_MINIMUM_SPEEDUP_MILLI or
            not sha256_lower_hex_valid(perf.receipt_sha256)):
        return Err("avx2-performance-attestation-invalid")
    if (perf.implementation_version != X25519_MLKEM768_IMPLEMENTATION_VERSION or
            perf.profile_version != X25519_MLKEM768_PROFILE_VERSION or
            perf.fixture_id != binding.fixture_id or
            perf.fixture_manifest_sha256 != binding.fixture_manifest_sha256 or
            perf.fixture_source_sha256 != binding.fixture_source_sha256 or
            not sha256_lower_hex_valid(perf.workload_configuration_sha256) or
            perf.backend_configuration_sha256 !=
                key_pair.evidence.configuration_digest or
            perf.compiler_source_revision != binding.stage4_source_revision or
            perf.compiler_artifact_sha256 != binding.stage4_binary_sha256 or
            perf.compiler_provenance_sha256 !=
                binding.stage4_provenance_sha256 or
            perf.runner_source_sha256 != binding.runner_source_sha256 or
            perf.runner_artifact_sha256 != binding.runner_artifact_sha256 or
            perf.qualification_sha256 !=
                binding.measurement_qualification_sha256 or
            perf.qualified_timing_sha256 != binding.qualified_timing_sha256 or
            perf.matrix_row_set_sha256 != binding.matrix_row_set_sha256 or
            perf.scalar_source_receipt_sha256 !=
                binding.scalar_source_receipt_sha256 or
            perf.candidate_source_receipt_sha256 !=
                binding.candidate_source_receipt_sha256 or
            perf.scalar_sample_set_sha256 != binding.scalar_sample_set_sha256 or
            perf.candidate_sample_set_sha256 !=
                binding.candidate_sample_set_sha256 or
            perf.host_os != binding.host_os or
            perf.host_arch != binding.host_arch or
            perf.session_id != binding.session_id or
            perf.monotonic_clock_id != binding.monotonic_clock_id or
            perf.crypto_source_sha256 != binding.crypto_source_sha256 or
            perf.accelerator_source_sha256 != "" or
            perf.accelerator_artifact_sha256 != "" or
            perf.accelerator_build_binding_sha256 != "" or
            perf.batch_size != binding.batch_size):
        return Err("avx2-performance-attestation-binding-mismatch")
    Ok(X25519MlKem768RunReceipt(
        schema: "x25519mlkem768-evidence-v1",
        status: X25519MlKem768EvidenceStatus.Pass,
        reason: "native-avx2-full-operation-performance-admitted",
        scope: X25519MlKem768EvidenceScope.FullOperation,
        requested_backend: X25519MlKem768EvidenceBackend.Avx2,
        selected_backend: Some(X25519MlKem768EvidenceBackend.Avx2),
        mode: X25519MlKem768EvidenceMode.Native,
        emulated: false, promotion_eligible: true,
        implementation_version: X25519_MLKEM768_IMPLEMENTATION_VERSION,
        profile_version: X25519_MLKEM768_PROFILE_VERSION,
        fixture_id: binding.fixture_id,
        fixture_manifest_sha256: binding.fixture_manifest_sha256,
        fixture_source_sha256: binding.fixture_source_sha256,
        pinned_workload_sha256: binding.pinned_workload_sha256,
        runner_source_sha256: binding.runner_source_sha256,
        batch_size: binding.batch_size,
        client_share_bytes: key_pair.client_key_share.len(),
        server_share_bytes: encapsulation.server_key_share.len(),
        shared_secret_bytes: encapsulation.shared_secret.len(),
        keygen_output_digest: keygen_digest,
        encapsulate_output_digest: encapsulate_digest,
        decapsulate_output_digest: decapsulate_digest,
        scalar_roundtrip_match: true, fallback_used: false,
        absolute_oracle_match: true,
        simd_chunk_hits: key_pair.evidence.simd_chunk_hits +
            encapsulation.evidence.simd_chunk_hits +
            decapsulation.evidence.simd_chunk_hits,
        observed_rvv_vlen_bits: 0, kernel_invocations: 0,
        compiled: false, submitted: false, fence_completed: false,
        device_readback: false,
        artifact_sha256: binding.stage4_binary_sha256,
        device_identity: perf.backend_identity))

export X25519MlKem768Avx2ReceiptBinding
export x25519_mlkem768_compose_avx2_full_operation_receipt
