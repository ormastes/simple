# Matrix-qualified raw timing receipts for X25519MLKEM768.
#
# Ordered nanosecond samples are retained and length-framed. Aggregate latency
# and throughput values are derived here instead of accepted from a caller.
# Receipts contain public execution provenance only; no secret or secret-derived
# material may cross this boundary.

mod lib.common.crypto.x25519_mlkem768.qualified_timing

use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend,
    x25519_mlkem768_evidence_backend_name}
use lib.common.crypto.x25519_mlkem768.measurement_qualification.{
    X25519MlKem768MeasurementQualification,
    x25519_mlkem768_measurement_qualification_valid}

val X25519_MLKEM768_WARM_SETUP_SCHEMA: text =
    "x25519mlkem768-warm-setup-v1"
val X25519_MLKEM768_TIMED_OPERATION_SCHEMA: text =
    "x25519mlkem768-timed-operation-v2"
val X25519_MLKEM768_PAIRED_SCHEDULE_SCHEMA: text =
    "x25519mlkem768-paired-schedule-v1"
val X25519_MLKEM768_TIMING_MINIMUM_SAMPLES: i64 = 30
val X25519_MLKEM768_TIMING_MAXIMUM_SAMPLES: i64 = 1024
val X25519_MLKEM768_TIMING_MINIMUM_WARMUPS: i64 = 2
val _X25519_MLKEM768_TIMING_MAX_SAMPLE_NS: i64 = 9000000000000

enum X25519MlKem768TimingRole:
    ScalarReference
    Candidate

struct X25519MlKem768WarmSetupReceipt:
    schema: text
    receipt_sha256: text
    role: X25519MlKem768TimingRole
    backend: X25519MlKem768EvidenceBackend
    qualification_sha256: text
    matrix_row_set_sha256: text
    scalar_source_receipt_sha256: text
    candidate_source_receipt_sha256: text
    host_os: text
    host_arch: text
    session_id: text
    monotonic_clock_id: text
    workload_configuration_sha256: text
    backend_configuration_sha256: text
    runner_artifact_sha256: text
    backend_artifact_sha256: text
    backend_identity: text
    completed_full_exchanges: i64
    scalar_qualification_count: i64
    candidate_warmup_count: i64
    setup_operations_timed: i64
    oracle_match: bool
    fallback_used: bool

struct X25519MlKem768TimedOperationReceipt:
    schema: text
    receipt_sha256: text
    warm_setup_receipt_sha256: text
    role: X25519MlKem768TimingRole
    backend: X25519MlKem768EvidenceBackend
    qualification_sha256: text
    matrix_row_set_sha256: text
    scalar_source_receipt_sha256: text
    candidate_source_receipt_sha256: text
    host_os: text
    host_arch: text
    session_id: text
    monotonic_clock_id: text
    workload_configuration_sha256: text
    backend_configuration_sha256: text
    runner_artifact_sha256: text
    backend_artifact_sha256: text
    backend_identity: text
    samples_ns: [i64]
    sample_set_sha256: text
    full_exchange_count: i64
    hybrid_operation_count: i64
    setup_operations_during_timing: i64
    kernel_only_operations: i64
    fallback_operations: i64
    public_mismatch_operations: i64
    secret_mismatch_operations: i64
    accelerated_operation_count: i64
    simd_chunk_hits: i64
    observed_rvv_vlen_bits: i64
    gpu_transfer_count: i64
    gpu_launch_count: i64
    gpu_synchronization_count: i64
    gpu_readback_count: i64
    gpu_kernel_count: i64
    max_rss_kb: i64

struct X25519MlKem768PairedScheduleReceipt:
    schema: text
    receipt_sha256: text
    qualification_sha256: text
    scalar_timed_receipt_sha256: text
    candidate_timed_receipt_sha256: text
    session_id: text
    monotonic_clock_id: text
    ordinal_base: i64
    pair_count: i64
    scalar_started_ns: [i64]
    scalar_finished_ns: [i64]
    candidate_started_ns: [i64]
    candidate_finished_ns: [i64]

fn _timing_bool(value: bool) -> text:
    if value: "true" else: "false"

fn _timing_role_name(value: X25519MlKem768TimingRole) -> text:
    if value == X25519MlKem768TimingRole.ScalarReference:
        return "scalar-reference"
    "candidate"

fn _timing_field_valid(value: text) -> bool:
    value != "" and value == value.trim() and
        not value.contains("\n") and not value.contains("\r")

fn _timing_frame(key: text, value: text) -> text:
    key.len().to_text() + ":" + key + "=" + value.len().to_text() +
        ":" + value + ";"

fn _timing_identity_material(
        role: X25519MlKem768TimingRole,
        backend: X25519MlKem768EvidenceBackend,
        qualification_sha256: text,
        matrix_row_set_sha256: text,
        scalar_source_receipt_sha256: text,
        candidate_source_receipt_sha256: text,
        host_os: text, host_arch: text,
        session_id: text, monotonic_clock_id: text,
        workload_configuration_sha256: text,
        backend_configuration_sha256: text,
        runner_artifact_sha256: text,
        backend_artifact_sha256: text,
        backend_identity: text) -> text:
    _timing_frame("role", _timing_role_name(role)) +
    _timing_frame("backend", x25519_mlkem768_evidence_backend_name(backend)) +
    _timing_frame("qualification_sha256", qualification_sha256) +
    _timing_frame("matrix_row_set_sha256", matrix_row_set_sha256) +
    _timing_frame("scalar_source_receipt_sha256",
        scalar_source_receipt_sha256) +
    _timing_frame("candidate_source_receipt_sha256",
        candidate_source_receipt_sha256) +
    _timing_frame("host_os", host_os) +
    _timing_frame("host_arch", host_arch) +
    _timing_frame("session_id", session_id) +
    _timing_frame("monotonic_clock_id", monotonic_clock_id) +
    _timing_frame("workload_configuration_sha256",
        workload_configuration_sha256) +
    _timing_frame("backend_configuration_sha256",
        backend_configuration_sha256) +
    _timing_frame("runner_artifact_sha256", runner_artifact_sha256) +
    _timing_frame("backend_artifact_sha256", backend_artifact_sha256) +
    _timing_frame("backend_identity", backend_identity)

fn _warm_material(value: X25519MlKem768WarmSetupReceipt) -> text:
    _timing_frame("schema", value.schema) +
    _timing_identity_material(
        value.role, value.backend, value.qualification_sha256,
        value.matrix_row_set_sha256, value.scalar_source_receipt_sha256,
        value.candidate_source_receipt_sha256, value.host_os,
        value.host_arch, value.session_id, value.monotonic_clock_id,
        value.workload_configuration_sha256,
        value.backend_configuration_sha256, value.runner_artifact_sha256,
        value.backend_artifact_sha256, value.backend_identity) +
    _timing_frame("completed_full_exchanges",
        value.completed_full_exchanges.to_text()) +
    _timing_frame("scalar_qualification_count",
        value.scalar_qualification_count.to_text()) +
    _timing_frame("candidate_warmup_count",
        value.candidate_warmup_count.to_text()) +
    _timing_frame("setup_operations_timed",
        value.setup_operations_timed.to_text()) +
    _timing_frame("oracle_match", _timing_bool(value.oracle_match)) +
    _timing_frame("fallback_used", _timing_bool(value.fallback_used))

fn x25519_mlkem768_warm_setup_receipt_sha256(
        value: X25519MlKem768WarmSetupReceipt) -> text:
    sha256_text(_warm_material(value))

fn _sample_set_material(samples_ns: [i64]) -> text:
    var material = _timing_frame("sample_count", samples_ns.len().to_text())
    var index: i64 = 0
    while index < samples_ns.len():
        material = material + _timing_frame(
            "sample[" + index.to_text() + "]", samples_ns[index].to_text())
        index = index + 1
    material

fn x25519_mlkem768_sample_set_sha256(samples_ns: [i64]) -> text:
    sha256_text(_sample_set_material(samples_ns))

fn _timed_material(value: X25519MlKem768TimedOperationReceipt) -> text:
    _timing_frame("schema", value.schema) +
    _timing_frame("warm_setup_receipt_sha256",
        value.warm_setup_receipt_sha256) +
    _timing_identity_material(
        value.role, value.backend, value.qualification_sha256,
        value.matrix_row_set_sha256, value.scalar_source_receipt_sha256,
        value.candidate_source_receipt_sha256, value.host_os,
        value.host_arch, value.session_id, value.monotonic_clock_id,
        value.workload_configuration_sha256,
        value.backend_configuration_sha256, value.runner_artifact_sha256,
        value.backend_artifact_sha256, value.backend_identity) +
    _timing_frame("sample_set_sha256", value.sample_set_sha256) +
    _sample_set_material(value.samples_ns) +
    _timing_frame("full_exchange_count",
        value.full_exchange_count.to_text()) +
    _timing_frame("hybrid_operation_count",
        value.hybrid_operation_count.to_text()) +
    _timing_frame("setup_operations_during_timing",
        value.setup_operations_during_timing.to_text()) +
    _timing_frame("kernel_only_operations",
        value.kernel_only_operations.to_text()) +
    _timing_frame("fallback_operations",
        value.fallback_operations.to_text()) +
    _timing_frame("public_mismatch_operations",
        value.public_mismatch_operations.to_text()) +
    _timing_frame("secret_mismatch_operations",
        value.secret_mismatch_operations.to_text()) +
    _timing_frame("accelerated_operation_count",
        value.accelerated_operation_count.to_text()) +
    _timing_frame("simd_chunk_hits", value.simd_chunk_hits.to_text()) +
    _timing_frame("observed_rvv_vlen_bits",
        value.observed_rvv_vlen_bits.to_text()) +
    _timing_frame("gpu_transfer_count", value.gpu_transfer_count.to_text()) +
    _timing_frame("gpu_launch_count", value.gpu_launch_count.to_text()) +
    _timing_frame("gpu_synchronization_count",
        value.gpu_synchronization_count.to_text()) +
    _timing_frame("gpu_readback_count", value.gpu_readback_count.to_text()) +
    _timing_frame("gpu_kernel_count", value.gpu_kernel_count.to_text()) +
    _timing_frame("max_rss_kb", value.max_rss_kb.to_text())

fn x25519_mlkem768_timed_operation_receipt_sha256(
        value: X25519MlKem768TimedOperationReceipt) -> text:
    sha256_text(_timed_material(value))

fn _timing_i64_array_material(prefix: text, values: [i64]) -> text:
    var material = _timing_frame(prefix + ".count", values.len().to_text())
    var index: i64 = 0
    while index < values.len():
        material = material + _timing_frame(
            prefix + "[" + index.to_text() + "]", values[index].to_text())
        index = index + 1
    material

fn _paired_schedule_material(
        value: X25519MlKem768PairedScheduleReceipt) -> text:
    _timing_frame("schema", value.schema) +
    _timing_frame("qualification_sha256", value.qualification_sha256) +
    _timing_frame("scalar_timed_receipt_sha256",
        value.scalar_timed_receipt_sha256) +
    _timing_frame("candidate_timed_receipt_sha256",
        value.candidate_timed_receipt_sha256) +
    _timing_frame("session_id", value.session_id) +
    _timing_frame("monotonic_clock_id", value.monotonic_clock_id) +
    _timing_frame("ordinal_base", value.ordinal_base.to_text()) +
    _timing_frame("pair_count", value.pair_count.to_text()) +
    _timing_i64_array_material(
        "scalar_started_ns", value.scalar_started_ns) +
    _timing_i64_array_material(
        "scalar_finished_ns", value.scalar_finished_ns) +
    _timing_i64_array_material(
        "candidate_started_ns", value.candidate_started_ns) +
    _timing_i64_array_material(
        "candidate_finished_ns", value.candidate_finished_ns)

fn x25519_mlkem768_paired_schedule_receipt_sha256(
        value: X25519MlKem768PairedScheduleReceipt) -> text:
    sha256_text(_paired_schedule_material(value))

fn _timing_role_backend_valid(
        qualification: X25519MlKem768MeasurementQualification,
        role: X25519MlKem768TimingRole,
        backend: X25519MlKem768EvidenceBackend) -> bool:
    if role == X25519MlKem768TimingRole.ScalarReference:
        return backend == X25519MlKem768EvidenceBackend.ScalarCpu
    backend == qualification.target.backend

fn _timing_common_binding_valid(
        qualification: X25519MlKem768MeasurementQualification,
        role: X25519MlKem768TimingRole,
        backend: X25519MlKem768EvidenceBackend,
        qualification_sha256: text,
        matrix_row_set_sha256: text,
        scalar_source_receipt_sha256: text,
        candidate_source_receipt_sha256: text,
        host_os: text, host_arch: text,
        session_id: text, monotonic_clock_id: text,
        workload_configuration_sha256: text,
        backend_configuration_sha256: text,
        runner_artifact_sha256: text,
        backend_artifact_sha256: text,
        backend_identity: text) -> bool:
    if not _timing_role_backend_valid(qualification, role, backend):
        return false
    if qualification_sha256 != qualification.qualification_sha256 or
            matrix_row_set_sha256 !=
                qualification.target.matrix_row_set_sha256 or
            scalar_source_receipt_sha256 !=
                qualification.scalar_source_receipt_sha256 or
            candidate_source_receipt_sha256 !=
                qualification.candidate_source_receipt_sha256:
        return false
    if host_os != qualification.target.host_os or
            host_arch != qualification.target.host_arch or
            session_id != qualification.target.session_id or
            monotonic_clock_id != qualification.target.monotonic_clock_id or
            workload_configuration_sha256 !=
                qualification.target.workload_configuration_sha256 or
            runner_artifact_sha256 !=
                qualification.target.runner_artifact_sha256:
        return false
    if not _timing_field_valid(backend_identity) or
            not sha256_lower_hex_valid(backend_configuration_sha256) or
            not sha256_lower_hex_valid(backend_artifact_sha256):
        return false
    if role == X25519MlKem768TimingRole.Candidate:
        return backend_configuration_sha256 ==
                qualification.target.candidate_configuration_sha256 and
            backend_artifact_sha256 ==
                qualification.target.backend_artifact_sha256 and
            backend_identity == qualification.target.executor_identity
    backend_configuration_sha256 ==
            qualification.target.scalar_configuration_sha256 and
        backend_artifact_sha256 ==
            qualification.target.scalar_backend_artifact_sha256 and
        backend_identity == qualification.target.scalar_backend_identity

fn x25519_mlkem768_admit_warm_setup(
        qualification: X25519MlKem768MeasurementQualification,
        receipt: X25519MlKem768WarmSetupReceipt
        ) -> Result<X25519MlKem768WarmSetupReceipt, text>:
    if not x25519_mlkem768_measurement_qualification_valid(qualification):
        return Err("measurement-qualification-invalid")
    if receipt.schema != X25519_MLKEM768_WARM_SETUP_SCHEMA or
            not sha256_lower_hex_valid(receipt.receipt_sha256) or
            receipt.receipt_sha256 !=
                x25519_mlkem768_warm_setup_receipt_sha256(receipt):
        return Err("warm-setup-receipt-invalid")
    if not _timing_common_binding_valid(
            qualification, receipt.role, receipt.backend,
            receipt.qualification_sha256, receipt.matrix_row_set_sha256,
            receipt.scalar_source_receipt_sha256,
            receipt.candidate_source_receipt_sha256, receipt.host_os,
            receipt.host_arch, receipt.session_id,
            receipt.monotonic_clock_id,
            receipt.workload_configuration_sha256,
            receipt.backend_configuration_sha256,
            receipt.runner_artifact_sha256,
            receipt.backend_artifact_sha256, receipt.backend_identity):
        return Err("warm-setup-binding-mismatch")
    if receipt.completed_full_exchanges <
            X25519_MLKEM768_TIMING_MINIMUM_WARMUPS or
            receipt.completed_full_exchanges !=
                receipt.scalar_qualification_count +
                receipt.candidate_warmup_count:
        return Err("warm-setup-count-invalid")
    if receipt.role == X25519MlKem768TimingRole.ScalarReference and
            (receipt.scalar_qualification_count < 2 or
             receipt.candidate_warmup_count != 0):
        return Err("warm-setup-count-invalid")
    if receipt.role == X25519MlKem768TimingRole.Candidate and
            (receipt.scalar_qualification_count != 1 or
             receipt.candidate_warmup_count <
                X25519_MLKEM768_TIMING_MINIMUM_WARMUPS):
        return Err("warm-setup-count-invalid")
    if receipt.setup_operations_timed != 0 or
            not receipt.oracle_match or receipt.fallback_used:
        return Err("warm-setup-contaminated")
    Ok(receipt)

fn _timing_identity_matches_warm(
        warm: X25519MlKem768WarmSetupReceipt,
        receipt: X25519MlKem768TimedOperationReceipt) -> bool:
    warm.role == receipt.role and warm.backend == receipt.backend and
    warm.qualification_sha256 == receipt.qualification_sha256 and
    warm.matrix_row_set_sha256 == receipt.matrix_row_set_sha256 and
    warm.scalar_source_receipt_sha256 ==
        receipt.scalar_source_receipt_sha256 and
    warm.candidate_source_receipt_sha256 ==
        receipt.candidate_source_receipt_sha256 and
    warm.host_os == receipt.host_os and warm.host_arch == receipt.host_arch and
    warm.session_id == receipt.session_id and
    warm.monotonic_clock_id == receipt.monotonic_clock_id and
    warm.workload_configuration_sha256 ==
        receipt.workload_configuration_sha256 and
    warm.backend_configuration_sha256 ==
        receipt.backend_configuration_sha256 and
    warm.runner_artifact_sha256 == receipt.runner_artifact_sha256 and
    warm.backend_artifact_sha256 == receipt.backend_artifact_sha256 and
    warm.backend_identity == receipt.backend_identity

fn _timing_samples_valid(samples_ns: [i64]) -> bool:
    if samples_ns.len() < X25519_MLKEM768_TIMING_MINIMUM_SAMPLES or
            samples_ns.len() > X25519_MLKEM768_TIMING_MAXIMUM_SAMPLES:
        return false
    var index: i64 = 0
    while index < samples_ns.len():
        if samples_ns[index] < 1 or
                samples_ns[index] > _X25519_MLKEM768_TIMING_MAX_SAMPLE_NS:
            return false
        index = index + 1
    true

fn _timing_backend_evidence_valid(
        receipt: X25519MlKem768TimedOperationReceipt) -> bool:
    if receipt.role == X25519MlKem768TimingRole.ScalarReference:
        return receipt.accelerated_operation_count == 0 and
            receipt.simd_chunk_hits == 0 and
            receipt.observed_rvv_vlen_bits == 0 and
            receipt.gpu_transfer_count == 0 and
            receipt.gpu_launch_count == 0 and
            receipt.gpu_synchronization_count == 0 and
            receipt.gpu_readback_count == 0 and
            receipt.gpu_kernel_count == 0
    if receipt.backend == X25519MlKem768EvidenceBackend.Avx2 or
            receipt.backend == X25519MlKem768EvidenceBackend.Neon:
        return receipt.accelerated_operation_count ==
                receipt.hybrid_operation_count and
            receipt.simd_chunk_hits >= receipt.hybrid_operation_count and
            receipt.observed_rvv_vlen_bits == 0 and
            receipt.gpu_transfer_count == 0 and
            receipt.gpu_launch_count == 0 and
            receipt.gpu_synchronization_count == 0 and
            receipt.gpu_readback_count == 0 and
            receipt.gpu_kernel_count == 0
    if receipt.backend == X25519MlKem768EvidenceBackend.Rvv:
        return receipt.accelerated_operation_count ==
                receipt.hybrid_operation_count and
            receipt.simd_chunk_hits >= receipt.hybrid_operation_count and
            receipt.observed_rvv_vlen_bits > 0 and
            receipt.gpu_transfer_count == 0 and
            receipt.gpu_launch_count == 0 and
            receipt.gpu_synchronization_count == 0 and
            receipt.gpu_readback_count == 0 and
            receipt.gpu_kernel_count == 0
    receipt.accelerated_operation_count == receipt.hybrid_operation_count and
        receipt.simd_chunk_hits == 0 and
        receipt.observed_rvv_vlen_bits == 0 and
        receipt.gpu_kernel_count >= receipt.hybrid_operation_count and
        receipt.gpu_transfer_count == receipt.gpu_kernel_count and
        receipt.gpu_launch_count == receipt.gpu_kernel_count and
        receipt.gpu_synchronization_count == receipt.gpu_kernel_count and
        receipt.gpu_readback_count == receipt.gpu_kernel_count

fn x25519_mlkem768_admit_timed_operations(
        qualification: X25519MlKem768MeasurementQualification,
        warm: X25519MlKem768WarmSetupReceipt,
        receipt: X25519MlKem768TimedOperationReceipt
        ) -> Result<X25519MlKem768TimedOperationReceipt, text>:
    match x25519_mlkem768_admit_warm_setup(qualification, warm):
        case Err(reason): return Err(reason)
        case Ok(_): ()
    if receipt.schema != X25519_MLKEM768_TIMED_OPERATION_SCHEMA or
            not sha256_lower_hex_valid(receipt.receipt_sha256):
        return Err("timed-operation-receipt-invalid")
    if receipt.samples_ns.len() < X25519_MLKEM768_TIMING_MINIMUM_SAMPLES or
            receipt.samples_ns.len() >
                X25519_MLKEM768_TIMING_MAXIMUM_SAMPLES:
        return Err("timed-operation-samples-invalid")
    if receipt.receipt_sha256 !=
            x25519_mlkem768_timed_operation_receipt_sha256(receipt):
        return Err("timed-operation-receipt-invalid")
    if receipt.warm_setup_receipt_sha256 != warm.receipt_sha256 or
            not _timing_identity_matches_warm(warm, receipt) or
            not _timing_common_binding_valid(
                qualification, receipt.role, receipt.backend,
                receipt.qualification_sha256, receipt.matrix_row_set_sha256,
                receipt.scalar_source_receipt_sha256,
                receipt.candidate_source_receipt_sha256, receipt.host_os,
                receipt.host_arch, receipt.session_id,
                receipt.monotonic_clock_id,
                receipt.workload_configuration_sha256,
                receipt.backend_configuration_sha256,
                receipt.runner_artifact_sha256,
                receipt.backend_artifact_sha256, receipt.backend_identity):
        return Err("timed-operation-binding-mismatch")
    if not _timing_samples_valid(receipt.samples_ns) or
            not sha256_lower_hex_valid(receipt.sample_set_sha256) or
            receipt.sample_set_sha256 !=
                x25519_mlkem768_sample_set_sha256(receipt.samples_ns):
        return Err("timed-operation-samples-invalid")
    if receipt.full_exchange_count != receipt.samples_ns.len() or
            receipt.hybrid_operation_count !=
                receipt.full_exchange_count * 3:
        return Err("timed-operation-count-invalid")
    if receipt.setup_operations_during_timing != 0 or
            receipt.kernel_only_operations != 0 or
            receipt.fallback_operations != 0 or
            receipt.public_mismatch_operations != 0 or
            receipt.secret_mismatch_operations != 0:
        return Err("timed-operation-contaminated")
    if receipt.max_rss_kb !=
            qualification.platform_observation.peak_memory_kib:
        return Err("timed-operation-platform-observation-mismatch")
    if not _timing_backend_evidence_valid(receipt):
        return Err("timed-operation-backend-evidence-invalid")
    Ok(receipt)

fn x25519_mlkem768_admit_paired_schedule(
        qualification: X25519MlKem768MeasurementQualification,
        scalar_warm: X25519MlKem768WarmSetupReceipt,
        candidate_warm: X25519MlKem768WarmSetupReceipt,
        scalar_timed: X25519MlKem768TimedOperationReceipt,
        candidate_timed: X25519MlKem768TimedOperationReceipt,
        schedule: X25519MlKem768PairedScheduleReceipt
        ) -> Result<X25519MlKem768PairedScheduleReceipt, text>:
    if not x25519_mlkem768_measurement_qualification_valid(qualification):
        return Err("measurement-qualification-invalid")
    match x25519_mlkem768_admit_timed_operations(
            qualification, scalar_warm, scalar_timed):
        case Err(_): return Err("paired-schedule-scalar-timed-invalid")
        case Ok(_): ()
    match x25519_mlkem768_admit_timed_operations(
            qualification, candidate_warm, candidate_timed):
        case Err(_): return Err("paired-schedule-candidate-timed-invalid")
        case Ok(_): ()
    if schedule.schema != X25519_MLKEM768_PAIRED_SCHEDULE_SCHEMA or
            not sha256_lower_hex_valid(schedule.receipt_sha256):
        return Err("paired-schedule-receipt-invalid")
    if schedule.ordinal_base != 0 or schedule.pair_count % 2 != 0 or
            schedule.pair_count < X25519_MLKEM768_TIMING_MINIMUM_SAMPLES or
            schedule.pair_count > X25519_MLKEM768_TIMING_MAXIMUM_SAMPLES or
            schedule.pair_count != scalar_timed.samples_ns.len() or
            schedule.pair_count != candidate_timed.samples_ns.len() or
            schedule.pair_count != schedule.scalar_started_ns.len() or
            schedule.pair_count != schedule.scalar_finished_ns.len() or
            schedule.pair_count != schedule.candidate_started_ns.len() or
            schedule.pair_count != schedule.candidate_finished_ns.len():
        return Err("paired-schedule-count-invalid")
    if schedule.receipt_sha256 !=
            x25519_mlkem768_paired_schedule_receipt_sha256(schedule):
        return Err("paired-schedule-receipt-invalid")
    if schedule.qualification_sha256 !=
                qualification.qualification_sha256 or
            schedule.scalar_timed_receipt_sha256 !=
                scalar_timed.receipt_sha256 or
            schedule.candidate_timed_receipt_sha256 !=
                candidate_timed.receipt_sha256 or
            schedule.session_id != qualification.target.session_id or
            schedule.monotonic_clock_id !=
                qualification.target.monotonic_clock_id:
        return Err("paired-schedule-binding-mismatch")
    var previous_pair_finished_ns: i64 = -1
    var index: i64 = 0
    while index < schedule.pair_count:
        val scalar_started_ns = schedule.scalar_started_ns[index]
        val scalar_finished_ns = schedule.scalar_finished_ns[index]
        val candidate_started_ns = schedule.candidate_started_ns[index]
        val candidate_finished_ns = schedule.candidate_finished_ns[index]
        if scalar_started_ns < 0 or scalar_finished_ns <= scalar_started_ns or
                candidate_started_ns < 0 or
                candidate_finished_ns <= candidate_started_ns or
                scalar_finished_ns - scalar_started_ns !=
                    scalar_timed.samples_ns[index] or
                candidate_finished_ns - candidate_started_ns !=
                    candidate_timed.samples_ns[index]:
            return Err("paired-schedule-duration-invalid")
        if index % 2 == 0:
            if scalar_finished_ns > candidate_started_ns:
                return Err("paired-schedule-abba-order-invalid")
        else:
            if candidate_finished_ns > scalar_started_ns:
                return Err("paired-schedule-abba-order-invalid")
        val pair_started_ns = if scalar_started_ns < candidate_started_ns:
            scalar_started_ns
        else:
            candidate_started_ns
        val pair_finished_ns = if scalar_finished_ns > candidate_finished_ns:
            scalar_finished_ns
        else:
            candidate_finished_ns
        if previous_pair_finished_ns > pair_started_ns:
            return Err("paired-schedule-overlap-invalid")
        previous_pair_finished_ns = pair_finished_ns
        index = index + 1
    Ok(schedule)

fn _timing_sorted(samples_ns: [i64]) -> [i64]:
    var sorted: [i64] = []
    var source_index: i64 = 0
    while source_index < samples_ns.len():
        sorted.push(samples_ns[source_index])
        source_index = source_index + 1
    var index: i64 = 1
    while index < sorted.len():
        val value = sorted[index]
        var position = index
        while position > 0 and sorted[position - 1] > value:
            sorted[position] = sorted[position - 1]
            position = position - 1
        sorted[position] = value
        index = index + 1
    sorted

fn _timing_percentile_us(
        receipt: X25519MlKem768TimedOperationReceipt,
        percentile: i64) -> i64:
    if not _timing_samples_valid(receipt.samples_ns): return 0
    val sorted = _timing_sorted(receipt.samples_ns)
    val rank = (sorted.len() * percentile + 99) / 100
    (sorted[rank - 1] + 999) / 1000

fn x25519_mlkem768_timing_p50_us(
        receipt: X25519MlKem768TimedOperationReceipt) -> i64:
    _timing_percentile_us(receipt, 50)

fn x25519_mlkem768_timing_p95_us(
        receipt: X25519MlKem768TimedOperationReceipt) -> i64:
    _timing_percentile_us(receipt, 95)

fn x25519_mlkem768_timing_p99_us(
        receipt: X25519MlKem768TimedOperationReceipt) -> i64:
    _timing_percentile_us(receipt, 99)

fn x25519_mlkem768_timing_operations_per_second(
        receipt: X25519MlKem768TimedOperationReceipt) -> i64:
    if not _timing_samples_valid(receipt.samples_ns) or
            receipt.hybrid_operation_count != receipt.samples_ns.len() * 3:
        return 0
    var total_ns: i64 = 0
    var index: i64 = 0
    while index < receipt.samples_ns.len():
        total_ns = total_ns + receipt.samples_ns[index]
        index = index + 1
    (receipt.hybrid_operation_count * 1000000000) / total_ns

fn x25519_mlkem768_qualified_timing_sha256(
        qualification: X25519MlKem768MeasurementQualification,
        scalar_warm: X25519MlKem768WarmSetupReceipt,
        candidate_warm: X25519MlKem768WarmSetupReceipt,
        scalar_timed: X25519MlKem768TimedOperationReceipt,
        candidate_timed: X25519MlKem768TimedOperationReceipt,
        schedule: X25519MlKem768PairedScheduleReceipt) -> text:
    sha256_text(
        _timing_frame("qualification_sha256",
            qualification.qualification_sha256) +
        _timing_frame("scalar_warm_receipt_sha256",
            scalar_warm.receipt_sha256) +
        _timing_frame("candidate_warm_receipt_sha256",
            candidate_warm.receipt_sha256) +
        _timing_frame("scalar_timed_receipt_sha256",
            scalar_timed.receipt_sha256) +
        _timing_frame("candidate_timed_receipt_sha256",
            candidate_timed.receipt_sha256) +
        _timing_frame("paired_schedule_receipt_sha256",
            schedule.receipt_sha256))

