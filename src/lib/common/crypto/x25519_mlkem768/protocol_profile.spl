# codex-impl: pinned TLS 1.3 and SSH X25519MLKEM768 protocol contract.
mod lib.common.crypto.x25519_mlkem768.protocol_profile

use lib.common.crypto.x25519_mlkem768.contract.{
    X25519_MLKEM768_PROFILE_VERSION,
    X25519_MLKEM768_TLS_DRAFT,
    X25519_MLKEM768_TLS_NAMED_GROUP,
    X25519_MLKEM768_CLIENT_SHARE_BYTES,
    X25519_MLKEM768_SERVER_SHARE_BYTES,
    X25519_MLKEM768_SHARED_SECRET_BYTES}

val X25519_MLKEM768_TLS_PROTOCOL: text = "TLS1.3"
val X25519_MLKEM768_TLS_GROUP_NAME: text = "X25519MLKEM768"
val X25519_MLKEM768_SSH_PROTOCOL: text = "SSH-2.0"
val X25519_MLKEM768_SSH_KEX_NAME: text = "mlkem768x25519-sha256"
val X25519_MLKEM768_SSH_PROFILE_VERSION: text = "openssh-9.9-mlkem768x25519-v1"
val X25519_MLKEM768_CLIENT_ORDER: text = "mlkem768-encapsulation-key||x25519-public"
val X25519_MLKEM768_SERVER_ORDER: text = "mlkem768-ciphertext||x25519-public"
val X25519_MLKEM768_SECRET_ORDER: text = "mlkem768-shared-secret||x25519-shared-secret"
val X25519_MLKEM768_TLS_COMBINER: text = "tls13-key-schedule-input"
val X25519_MLKEM768_SSH_COMBINER: text = "sha256"
val X25519_MLKEM768_SSH_SHARED_SECRET_BYTES: i64 = 32

enum X25519MlKem768Protocol:
    Tls13
    Ssh2

struct X25519MlKem768ProtocolProfile:
    protocol: X25519MlKem768Protocol
    protocol_version: text
    specification_revision: text
    profile_version: text
    algorithm_name: text
    named_group: i64
    client_share_bytes: i64
    server_share_bytes: i64
    client_component_order: text
    server_component_order: text
    secret_component_order: text
    combiner: text
    combined_secret_bytes: i64

struct X25519MlKem768ProtocolPolicy:
    require_hybrid: bool
    authentication_enabled: bool
    aead_enabled: bool
    allow_classical_retry_after_hybrid_failure: bool

fn x25519_mlkem768_tls13_protocol_profile() -> X25519MlKem768ProtocolProfile:
    X25519MlKem768ProtocolProfile(
        protocol: X25519MlKem768Protocol.Tls13,
        protocol_version: X25519_MLKEM768_TLS_PROTOCOL,
        specification_revision: X25519_MLKEM768_TLS_DRAFT,
        profile_version: X25519_MLKEM768_PROFILE_VERSION,
        algorithm_name: X25519_MLKEM768_TLS_GROUP_NAME,
        named_group: X25519_MLKEM768_TLS_NAMED_GROUP,
        client_share_bytes: X25519_MLKEM768_CLIENT_SHARE_BYTES,
        server_share_bytes: X25519_MLKEM768_SERVER_SHARE_BYTES,
        client_component_order: X25519_MLKEM768_CLIENT_ORDER,
        server_component_order: X25519_MLKEM768_SERVER_ORDER,
        secret_component_order: X25519_MLKEM768_SECRET_ORDER,
        combiner: X25519_MLKEM768_TLS_COMBINER,
        combined_secret_bytes: X25519_MLKEM768_SHARED_SECRET_BYTES)

fn x25519_mlkem768_ssh2_protocol_profile() -> X25519MlKem768ProtocolProfile:
    X25519MlKem768ProtocolProfile(
        protocol: X25519MlKem768Protocol.Ssh2,
        protocol_version: X25519_MLKEM768_SSH_PROTOCOL,
        specification_revision: X25519_MLKEM768_SSH_PROFILE_VERSION,
        profile_version: X25519_MLKEM768_SSH_PROFILE_VERSION,
        algorithm_name: X25519_MLKEM768_SSH_KEX_NAME,
        named_group: -1,
        client_share_bytes: X25519_MLKEM768_CLIENT_SHARE_BYTES,
        server_share_bytes: X25519_MLKEM768_SERVER_SHARE_BYTES,
        client_component_order: X25519_MLKEM768_CLIENT_ORDER,
        server_component_order: X25519_MLKEM768_SERVER_ORDER,
        secret_component_order: X25519_MLKEM768_SECRET_ORDER,
        combiner: X25519_MLKEM768_SSH_COMBINER,
        combined_secret_bytes: X25519_MLKEM768_SSH_SHARED_SECRET_BYTES)

fn _profile_mismatch(actual: text, expected: text, field: text) -> Result<bool, text>:
    if actual != expected:
        return Err("X25519MLKEM768 {field} mismatch: expected {expected}")
    Ok(true)

fn _profile_size_mismatch(actual: i64, expected: i64,
        field: text) -> Result<bool, text>:
    if actual != expected:
        return Err("X25519MLKEM768 {field} mismatch: expected {expected}")
    Ok(true)

fn x25519_mlkem768_validate_protocol_profile(
        profile: X25519MlKem768ProtocolProfile) -> Result<bool, text>:
    val expected = match profile.protocol:
        case X25519MlKem768Protocol.Tls13:
            x25519_mlkem768_tls13_protocol_profile()
        case X25519MlKem768Protocol.Ssh2:
            x25519_mlkem768_ssh2_protocol_profile()
    _profile_mismatch(profile.protocol_version, expected.protocol_version,
        "protocol version")?
    _profile_mismatch(profile.specification_revision,
        expected.specification_revision, "specification revision")?
    _profile_mismatch(profile.profile_version, expected.profile_version,
        "profile version")?
    _profile_mismatch(profile.algorithm_name, expected.algorithm_name,
        "algorithm name")?
    _profile_size_mismatch(profile.named_group, expected.named_group,
        "named group")?
    _profile_size_mismatch(profile.client_share_bytes,
        expected.client_share_bytes, "client share length")?
    _profile_size_mismatch(profile.server_share_bytes,
        expected.server_share_bytes, "server share length")?
    _profile_mismatch(profile.client_component_order,
        expected.client_component_order, "client component order")?
    _profile_mismatch(profile.server_component_order,
        expected.server_component_order, "server component order")?
    _profile_mismatch(profile.secret_component_order,
        expected.secret_component_order, "secret component order")?
    _profile_mismatch(profile.combiner, expected.combiner, "combiner")?
    _profile_size_mismatch(profile.combined_secret_bytes,
        expected.combined_secret_bytes, "combined secret length")?
    Ok(true)

fn x25519_mlkem768_validate_protocol_policy(
        policy: X25519MlKem768ProtocolPolicy) -> Result<bool, text>:
    if not policy.require_hybrid:
        return Err("X25519MLKEM768 policy must require the negotiated hybrid")
    if not policy.authentication_enabled:
        return Err("X25519MLKEM768 does not replace peer authentication")
    if not policy.aead_enabled:
        return Err("X25519MLKEM768 does not replace an authenticated cipher")
    if policy.allow_classical_retry_after_hybrid_failure:
        return Err("X25519MLKEM768 failure must not retry with classical-only KEX")
    Ok(true)

fn x25519_mlkem768_validate_protocol_admission(
        profile: X25519MlKem768ProtocolProfile,
        policy: X25519MlKem768ProtocolPolicy,
        observed_client_share_bytes: i64,
        observed_server_share_bytes: i64) -> Result<bool, text>:
    x25519_mlkem768_validate_protocol_profile(profile)?
    x25519_mlkem768_validate_protocol_policy(policy)?
    if observed_client_share_bytes != profile.client_share_bytes:
        return Err("X25519MLKEM768 received an invalid client share length")
    if observed_server_share_bytes != profile.server_share_bytes:
        return Err("X25519MLKEM768 received an invalid server share length")
    Ok(true)

export X25519MlKem768Protocol, X25519MlKem768ProtocolProfile
export X25519MlKem768ProtocolPolicy
export x25519_mlkem768_tls13_protocol_profile
export x25519_mlkem768_ssh2_protocol_profile
export x25519_mlkem768_validate_protocol_profile
export x25519_mlkem768_validate_protocol_policy
export x25519_mlkem768_validate_protocol_admission
export X25519_MLKEM768_TLS_PROTOCOL, X25519_MLKEM768_TLS_GROUP_NAME
export X25519_MLKEM768_SSH_PROTOCOL, X25519_MLKEM768_SSH_KEX_NAME
export X25519_MLKEM768_SSH_PROFILE_VERSION
export X25519_MLKEM768_CLIENT_ORDER, X25519_MLKEM768_SERVER_ORDER
export X25519_MLKEM768_SECRET_ORDER
export X25519_MLKEM768_TLS_COMBINER, X25519_MLKEM768_SSH_COMBINER
export X25519_MLKEM768_SSH_SHARED_SECRET_BYTES
