# dynsmf_entry.spl — background-lane entry module for the crypto bundle.
#
# Re-exports the primary cipher / AEAD / KDF / signature entry points so a
# background-built SMF bundle can import a single module. Hashes (sha256,
# blake*, crc32, xxhash) stay static: sha256 verifies dynSMF artifacts.
#
# Module id: crypto

export use std.common.crypto.aes_gcm.{
    aes128_gcm_encrypt,
    aes128_gcm_decrypt,
    aes256_gcm_encrypt,
    aes256_gcm_decrypt
}
export use std.common.crypto.chacha20.{chacha20_encrypt}
export use std.common.crypto.chacha20_poly1305.{
    chacha20_poly1305_encrypt,
    chacha20_poly1305_decrypt
}
export use std.common.crypto.hmac.{hmac_sha256_bytes}
export use std.common.crypto.hkdf.{hkdf_sha256}
export use std.common.crypto.pbkdf2.{pbkdf2_sha256_bytes}
export use std.common.crypto.argon2.{argon2id_bytes}
export use std.common.crypto.x25519.{x25519, x25519_pubkey}
export use std.common.crypto.ed25519.{pure_ed25519_sign, pure_ed25519_verify}

fn crypto_lib_ready() -> bool:
    true

export crypto_lib_ready
