# BLAKE3 (https://github.com/BLAKE3-team/BLAKE3-specs, section 2): hash, keyed
# hash, key derivation, and extendable output for inputs of any length.
#
# Structure (spec 2.1-2.6): input is split into 1024-byte chunks of up to 16
# 64-byte blocks. Each chunk is compressed into a chaining value (CV); CVs are
# merged as a binary tree whose shape is driven by the trailing zeros of the
# chunk count; the root node is compressed with the ROOT flag once per 64-byte
# output block, counting output blocks from 0 (that counter is the XOF).
#
# There is ONE compression function (_b3_compress). It works on u32 words,
# which wrap naturally. Array parameters are never mutated (W1006).
#
# Usage: use std.common.crypto.blake3.{blake3_hash, blake3_hash_xof,
#            blake3_keyed_hash, blake3_derive_key, blake3_hex}
# Legacy callers: blake3_bytes([i64]) -> [i64] and blake3_text(text) -> text.

use std.common.crypto.types.{crypto_text_to_bytes, bytes_to_hex}

# ---------------------------------------------------------------------------
# Domain separation flags (spec 2.1) and sizes
# ---------------------------------------------------------------------------

val _B3_CHUNK_START: u32 = 1u32
val _B3_CHUNK_END: u32 = 2u32
val _B3_PARENT: u32 = 4u32
val _B3_ROOT: u32 = 8u32
val _B3_KEYED_HASH: u32 = 16u32
val _B3_DERIVE_KEY_CONTEXT: u32 = 32u32
val _B3_DERIVE_KEY_MATERIAL: u32 = 64u32

val _B3_BLOCK_LEN: i64 = 64
val _B3_CHUNK_LEN: i64 = 1024

# IV = SHA-256 IV (spec 2.2).
fn _b3_iv() -> [u32]:
    [1779033703u32, 3144134277u32, 1013904242u32, 2773480762u32,
     1359893119u32, 2600822924u32, 528734635u32, 1541459225u32]

# Column then diagonal G-function operand indices into the 16-word state.
fn _b3_gidx() -> [i64]:
    [0, 4, 8, 12, 1, 5, 9, 13, 2, 6, 10, 14, 3, 7, 11, 15,
     0, 5, 10, 15, 1, 6, 11, 12, 2, 7, 8, 13, 3, 4, 9, 14]

# Message word permutation applied between rounds (spec 2.2).
fn _b3_perm() -> [i64]:
    [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8]

fn _b3_rotr(x: u32, n: i64) -> u32:
    (x >> n.to_u32()) | (x << (32 - n).to_u32())

# Little-endian u32 at byte offset `off` of `data`; bytes at or past `end` are 0.
fn _b3_word_le(data: [u8], off: i64, end: i64) -> u32:
    var w: u32 = 0u32
    var k = 0
    while k < 4:
        if off + k < end:
            w = w | (data[off + k].to_u32() << (8 * k).to_u32())
        k = k + 1
    w

# 16 message words for the block at data[off .. off+len], zero padded.
fn _b3_block_words(data: [u8], off: i64, len: i64) -> [u32]:
    var m: [u32] = []
    var i = 0
    while i < 16:
        m.push(_b3_word_le(data, off + 4 * i, off + len))
        i = i + 1
    m

# ---------------------------------------------------------------------------
# The compression function (spec 2.2). Returns all 16 output words; the first
# 8 are the new chaining value when not at the root.
# ---------------------------------------------------------------------------

fn _b3_compress(cv: [u32], block: [u32], counter: u64, block_len: u32, flags: u32) -> [u32]:
    val iv = _b3_iv()
    val gi = _b3_gidx()
    val perm = _b3_perm()
    var v: [u32] = [cv[0], cv[1], cv[2], cv[3], cv[4], cv[5], cv[6], cv[7],
                    iv[0], iv[1], iv[2], iv[3],
                    (counter & 0xFFFFFFFFu64).to_u32(), (counter >> 32u64).to_u32(),
                    block_len, flags]
    var m = block
    var r = 0
    while r < 7:
        var g = 0
        while g < 8:
            val a = gi[4 * g]
            val b = gi[4 * g + 1]
            val c = gi[4 * g + 2]
            val d = gi[4 * g + 3]
            val mx = m[2 * g]
            val my = m[2 * g + 1]
            v[a] = v[a] + v[b] + mx
            v[d] = _b3_rotr(v[d] ^ v[a], 16)
            v[c] = v[c] + v[d]
            v[b] = _b3_rotr(v[b] ^ v[c], 12)
            v[a] = v[a] + v[b] + my
            v[d] = _b3_rotr(v[d] ^ v[a], 8)
            v[c] = v[c] + v[d]
            v[b] = _b3_rotr(v[b] ^ v[c], 7)
            g = g + 1
        if r < 6:
            var pm: [u32] = []
            var p = 0
            while p < 16:
                pm.push(m[perm[p]])
                p = p + 1
            m = pm
        r = r + 1
    var out: [u32] = []
    var i = 0
    while i < 8:
        out.push(v[i] ^ v[i + 8])
        i = i + 1
    i = 0
    while i < 8:
        out.push(v[i + 8] ^ cv[i])
        i = i + 1
    out

# ---------------------------------------------------------------------------
# Output nodes (spec 2.4/2.5): the inputs of a not-yet-run compression, packed
# as 8 cv + 16 block words + [counter_lo, counter_hi, block_len, flags] so that
# the same node can be compressed as an interior node (CV) or as the root.
# ---------------------------------------------------------------------------

fn _b3_node(cv: [u32], block: [u32], counter: u64, block_len: u32, flags: u32) -> [u32]:
    var n: [u32] = []
    var i = 0
    while i < 8:
        n.push(cv[i])
        i = i + 1
    i = 0
    while i < 16:
        n.push(block[i])
        i = i + 1
    n.push((counter & 0xFFFFFFFFu64).to_u32())
    n.push((counter >> 32u64).to_u32())
    n.push(block_len)
    n.push(flags)
    n

fn _b3_node_run(n: [u32], counter: u64, extra_flags: u32) -> [u32]:
    _b3_compress(n[0:8], n[8:24], counter, n[26], n[27] | extra_flags)

fn _b3_node_cv(n: [u32]) -> [u32]:
    val out = _b3_node_run(n, (n[24].to_u64()) | (n[25].to_u64() << 32u64), 0u32)
    out[0:8]

# Parent node over two child CVs (spec 2.4).
fn _b3_parent(key: [u32], left: [u32], right: [u32], flags: u32) -> [u32]:
    _b3_node(key, left + right, 0u64, 64u32, flags | _B3_PARENT)

# Node for the last block of one chunk; earlier blocks are compressed into a CV
# along the way (spec 2.3).
fn _b3_chunk_node(key: [u32], data: [u8], off: i64, len: i64, counter: u64, flags: u32) -> [u32]:
    var cv = key
    var blocks = (len + _B3_BLOCK_LEN - 1) / _B3_BLOCK_LEN
    if blocks == 0:
        blocks = 1
    var b = 0
    while b < blocks - 1:
        var f = flags
        if b == 0:
            f = f | _B3_CHUNK_START
        val words = _b3_block_words(data, off + b * _B3_BLOCK_LEN, _B3_BLOCK_LEN)
        cv = _b3_compress(cv, words, counter, 64u32, f)[0:8]
        b = b + 1
    var lf = flags | _B3_CHUNK_END
    if b == 0:
        lf = lf | _B3_CHUNK_START
    val last_off = off + b * _B3_BLOCK_LEN
    val last_len = len - b * _B3_BLOCK_LEN
    _b3_node(cv, _b3_block_words(data, last_off, last_len), counter, last_len.to_u32(), lf)

# ---------------------------------------------------------------------------
# Tree + extendable output (spec 2.5, 2.6)
# ---------------------------------------------------------------------------

fn _b3_core(key: [u32], flags: u32, data: [u8], out_len: i64) -> [u8]:
    var out: [u8] = []
    if out_len <= 0:
        return out
    val n = data.len()
    var nchunks = (n + _B3_CHUNK_LEN - 1) / _B3_CHUNK_LEN
    if nchunks == 0:
        nchunks = 1
    # Left subtrees waiting for a right sibling; merge by trailing zeros of
    # the number of chunks consumed so far.
    var stack: [[u32]] = []
    var i = 0
    while i < nchunks - 1:
        var cv = _b3_node_cv(_b3_chunk_node(key, data, i * _B3_CHUNK_LEN, _B3_CHUNK_LEN, i.to_u64(), flags))
        var total = i + 1
        while total % 2 == 0:
            cv = _b3_node_cv(_b3_parent(key, stack.pop(), cv, flags))
            total = total / 2
        stack.push(cv)
        i = i + 1
    val last_off = (nchunks - 1) * _B3_CHUNK_LEN
    var node = _b3_chunk_node(key, data, last_off, n - last_off, (nchunks - 1).to_u64(), flags)
    while stack.len() > 0:
        node = _b3_parent(key, stack.pop(), _b3_node_cv(node), flags)
    var blk = 0
    while out.len() < out_len:
        val words = _b3_node_run(node, blk.to_u64(), _B3_ROOT)
        var w = 0
        while w < 16 and out.len() < out_len:
            var k = 0
            while k < 4 and out.len() < out_len:
                out.push(((words[w] >> (8 * k).to_u32()) & 255u32).to_u8())
                k = k + 1
            w = w + 1
        blk = blk + 1
    out

fn _b3_key_words(key: [u8]) -> [u32]:
    var w: [u32] = []
    var i = 0
    while i < 8:
        w.push(_b3_word_le(key, 4 * i, 32))
        i = i + 1
    w

fn _to_u8s(data: [i64]) -> [u8]:
    var o: [u8] = []
    for x in data:
        o.push((x & 255).to_u8())
    o

fn _to_i64s(data: [u8]) -> [i64]:
    var o: [i64] = []
    for x in data:
        o.push(x.to_i64())
    o

# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

# 32-byte BLAKE3 digest.
fn blake3_hash(data: [u8]) -> [u8]:
    _b3_core(_b3_iv(), 0u32, data, 32)

# Extendable output of `out_len` bytes (the first 32 equal blake3_hash).
fn blake3_hash_xof(data: [u8], out_len: i64) -> [u8]:
    _b3_core(_b3_iv(), 0u32, data, out_len)

# Keyed hash; the key must be exactly 32 bytes, otherwise returns [] (fail closed).
fn blake3_keyed_hash(key: [u8], data: [u8]) -> [u8]:
    if key.len() != 32:
        return []
    _b3_core(_b3_key_words(key), _B3_KEYED_HASH, data, 32)

# Key derivation: hash the context string, then use it as the key for the material.
fn blake3_derive_key(context: text, material: [u8]) -> [u8]:
    val ctx_key = _b3_core(_b3_iv(), _B3_DERIVE_KEY_CONTEXT, _to_u8s(crypto_text_to_bytes(context)), 32)
    _b3_core(_b3_key_words(ctx_key), _B3_DERIVE_KEY_MATERIAL, material, 32)

# Lowercase hex of a byte list.
fn blake3_hex(data: [u8]) -> text:
    bytes_to_hex(_to_i64s(data))

# Legacy API: 32-byte digest of a byte list.
fn blake3_bytes(data: [i64]) -> [i64]:
    _to_i64s(blake3_hash(_to_u8s(data)))

# Legacy API: 64-char lowercase hex digest of text.
fn blake3_text(data: text) -> text:
    bytes_to_hex(blake3_bytes(crypto_text_to_bytes(data)))
