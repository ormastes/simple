    var counter = 1
    while offset < length:
        # T(i) = HMAC(PRK, T(i-1) || info || byte(i))
        t_prev = hmac_sha3_256_bytes(prk, _hkdf_u8_block_msg(t_prev, info, counter))
        okm = _hkdf_u8_place(okm, offset, t_prev)
