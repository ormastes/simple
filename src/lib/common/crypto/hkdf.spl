# prk: PRK; info: context bytes (may be empty); length: desired output bytes.
# Returns length-byte OKM, or empty array if length > 255*48.
fn hkdf_expand_sha384(prk: [u8], info: [u8], length: i64) -> [u8]:
    val hash_len = 48
    val max_len = 255 * hash_len
    if length < 0 or length > max_len:
        return []
    var okm: [u8] = [0u8; length]
    var t_prev: [u8] = []
    var offset = 0
    var counter = 1
    while offset < length:
        # T(i) = HMAC(PRK, T(i-1) || info || byte(i))
        t_prev = hmac_sha384_bytes(prk, _hkdf_u8_block_msg(t_prev, info, counter))
        okm = _hkdf_u8_place(okm, offset, t_prev)
        offset = offset + hash_len
