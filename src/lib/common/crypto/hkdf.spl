# HKDF — HMAC-based Key Derivation Function per RFC 5869.
#
# Provides SHA-1, SHA-256, SHA-384, and SHA-512/256 variants.
# SHA-512/256 uses the FIPS 180-4 §5.3.6.2 initial values (distinct from SHA-512)
# and a 128-byte HMAC block size.
#
# API (per hash):
#   hkdf_extract_sha1(salt, ikm)         -> 20-byte PRK
#   hkdf_expand_sha1(prk, info, len)     -> len-byte OKM  (len <= 255*20)
#   hkdf_sha1(salt, ikm, info, len)      -> len-byte OKM  (one-shot)
#
#   hkdf_extract_sha256(salt, ikm)       -> 32-byte PRK
#   hkdf_expand_sha256(prk, info, len)   -> len-byte OKM  (len <= 255*32)
#   hkdf_sha256(salt, ikm, info, len)    -> len-byte OKM  (one-shot)
#
#   hkdf_extract_sha384(salt, ikm)       -> 48-byte PRK
#   hkdf_expand_sha384(prk, info, len)   -> len-byte OKM  (len <= 255*48)
#   hkdf_sha384(salt, ikm, info, len)    -> len-byte OKM  (one-shot)
#
#   hkdf_extract_sha512_256(salt, ikm)   -> 32-byte PRK
#   hkdf_expand_sha512_256(prk, info, l) -> l-byte OKM    (l <= 255*32)
#   hkdf_sha512_256(salt, ikm, info, l)  -> l-byte OKM    (one-shot)
#
# All inputs/outputs are [u8] byte arrays.
# Empty salt is treated as HashLen zero bytes per RFC 5869 §2.2.

use std.common.crypto.hmac.{hmac_sha256_bytes, hmac_sha512_256_bytes, hmac_sha1_bytes, hmac_sha384_bytes, hmac_sha3_256_bytes, hmac_sha3_384_bytes, hmac_sha3_512_bytes}

# ============================================================================
# Helpers
# ============================================================================

# Expand message T(i-1) || info || byte(i).
fn _hkdf_u8_block_msg(t_prev: [u8], info: [u8], counter: i64) -> [u8]:
    val tl = t_prev.len() as i64
    val il = info.len() as i64
    var msg: [u8] = [0u8; tl + il + 1]
    var i = 0
    while i < tl:
        msg[i] = t_prev[i]
        i = i + 1
    var j = 0
    while j < il:
        msg[tl + j] = info[j]
        j = j + 1
    msg[tl + il] = counter.to_u8()
    msg

# Copy t into okm at offset, stopping at okm's end.
fn _hkdf_u8_place(okm: [u8], offset: i64, t: [u8]) -> [u8]:
    var out = okm
    val total = out.len() as i64
    val tl = t.len() as i64
    var i = 0
    while i < tl and offset + i < total:
        out[offset + i] = t[i]
        i = i + 1
    out

# ============================================================================
# HKDF-SHA-256  (hash_len = 32, block = 64)
# ============================================================================

# HKDF-Extract (RFC 5869 §2.2) with SHA-256. Returns 32-byte PRK.
fn hkdf_extract_sha256(salt: [u8], ikm: [u8]) -> [u8]:
    if salt.len() == 0:
        return hmac_sha256_bytes([0u8; 32], ikm)
    hmac_sha256_bytes(salt, ikm)

# HKDF-Expand (RFC 5869 §2.3) with SHA-256.
# prk: PRK; info: context bytes (may be empty); length: desired output bytes.
# Returns length-byte OKM, or empty array if length > 255*32.
fn hkdf_expand_sha256(prk: [u8], info: [u8], length: i64) -> [u8]:
    val hash_len = 32
    val max_len = 255 * hash_len
    if length < 0 or length > max_len:
        return []
    var okm: [u8] = [0u8; length]
    var t_prev: [u8] = []
    var offset = 0
    var counter = 1
    while offset < length:
        # T(i) = HMAC(PRK, T(i-1) || info || byte(i))
        t_prev = hmac_sha256_bytes(prk, _hkdf_u8_block_msg(t_prev, info, counter))
        okm = _hkdf_u8_place(okm, offset, t_prev)
        offset = offset + hash_len
        counter = counter + 1
    okm

# HKDF one-shot with SHA-256: Extract then Expand.
fn hkdf_sha256(salt: [u8], ikm: [u8], info: [u8], length: i64) -> [u8]:
    val prk = hkdf_extract_sha256(salt, ikm)
    hkdf_expand_sha256(prk, info, length)

# ============================================================================
# HKDF-SHA-512/256 (FIPS 180-4 §5.3.6.2 IVs, not SHA-512 truncated)  (hash_len = 32, block = 128)
# ============================================================================

# HKDF-Extract (RFC 5869 §2.2) with SHA-512/256 (FIPS 180-4 §5.3.6.2 IVs, not SHA-512 truncated). Returns 32-byte PRK.
fn hkdf_extract_sha512_256(salt: [u8], ikm: [u8]) -> [u8]:
    if salt.len() == 0:
        return hmac_sha512_256_bytes([0u8; 32], ikm)
    hmac_sha512_256_bytes(salt, ikm)

# HKDF-Expand (RFC 5869 §2.3) with SHA-512/256 (FIPS 180-4 §5.3.6.2 IVs, not SHA-512 truncated).
# prk: PRK; info: context bytes (may be empty); length: desired output bytes.
# Returns length-byte OKM, or empty array if length > 255*32.
fn hkdf_expand_sha512_256(prk: [u8], info: [u8], length: i64) -> [u8]:
    val hash_len = 32
    val max_len = 255 * hash_len
    if length < 0 or length > max_len:
        return []
    var okm: [u8] = [0u8; length]
    var t_prev: [u8] = []
    var offset = 0
    var counter = 1
    while offset < length:
        # T(i) = HMAC(PRK, T(i-1) || info || byte(i))
        t_prev = hmac_sha512_256_bytes(prk, _hkdf_u8_block_msg(t_prev, info, counter))
        okm = _hkdf_u8_place(okm, offset, t_prev)
        offset = offset + hash_len
        counter = counter + 1
    okm

# HKDF one-shot with SHA-512/256 (FIPS 180-4 §5.3.6.2 IVs, not SHA-512 truncated): Extract then Expand.
fn hkdf_sha512_256(salt: [u8], ikm: [u8], info: [u8], length: i64) -> [u8]:
    val prk = hkdf_extract_sha512_256(salt, ikm)
    hkdf_expand_sha512_256(prk, info, length)

# ============================================================================
# HKDF-SHA-1  (hash_len = 20, block = 64)
# ============================================================================

# HKDF-Extract (RFC 5869 §2.2) with SHA-1. Returns 20-byte PRK.
fn hkdf_extract_sha1(salt: [u8], ikm: [u8]) -> [u8]:
    if salt.len() == 0:
        return hmac_sha1_bytes([0u8; 20], ikm)
    hmac_sha1_bytes(salt, ikm)

# HKDF-Expand (RFC 5869 §2.3) with SHA-1.
# prk: PRK; info: context bytes (may be empty); length: desired output bytes.
# Returns length-byte OKM, or empty array if length > 255*20.
fn hkdf_expand_sha1(prk: [u8], info: [u8], length: i64) -> [u8]:
    val hash_len = 20
    val max_len = 255 * hash_len
    if length < 0 or length > max_len:
        return []
    var okm: [u8] = [0u8; length]
    var t_prev: [u8] = []
    var offset = 0
    var counter = 1
    while offset < length:
        # T(i) = HMAC(PRK, T(i-1) || info || byte(i))
        t_prev = hmac_sha1_bytes(prk, _hkdf_u8_block_msg(t_prev, info, counter))
        okm = _hkdf_u8_place(okm, offset, t_prev)
        offset = offset + hash_len
        counter = counter + 1
    okm

# HKDF one-shot with SHA-1: Extract then Expand.
fn hkdf_sha1(salt: [u8], ikm: [u8], info: [u8], length: i64) -> [u8]:
    val prk = hkdf_extract_sha1(salt, ikm)
    hkdf_expand_sha1(prk, info, length)

# ============================================================================
# HKDF-SHA-384  (hash_len = 48, block = 128)
