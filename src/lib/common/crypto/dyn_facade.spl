"""Dynamic-first, static-fallback ChaCha20-Poly1305 facade.

`addr` is the resolved address of `simple_dyn_chacha20_poly1305_encrypt_v1`
in a loaded `crypto` component (see
`os.smf.dynsmf_session.dynsmf_session_symbol_address`). `addr == 0`
(component absent) or a failed dynamic call runs the static cipher.
"""

use os.posix.dynlib_sffi.{call_bytes_fn_v1}
use std.common.crypto.chacha20_poly1305.{chacha20_poly1305_encrypt}
use std.common.crypto.chacha20_poly1305_dyn_abi.{chacha20_poly1305_dyn_input}

fn chacha20_poly1305_encrypt_dyn(addr: i64, key: [u8], nonce: [u8], aad: [u8], plaintext: [u8]) -> [u8]:
    """Returns `ciphertext || tag[16]`, same as `chacha20_poly1305_encrypt`."""
    if addr != 0:
        val input = chacha20_poly1305_dyn_input(key, nonce, aad, plaintext)
        val call = call_bytes_fn_v1(addr, input, plaintext.len() + 16)
        if call.ok:
            return call.bytes
    chacha20_poly1305_encrypt(key, nonce, plaintext, aad)

export chacha20_poly1305_encrypt_dyn
