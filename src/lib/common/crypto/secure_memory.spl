# Compiler-resistant mutable-secret memory owner.
#
# Every wipe goes through `Array.fill_span(dst_off, count, value)`, the
# compiler-owned in-place VOLATILE fill: the interpreter resolves the caller's
# place and writes its exclusive storage through its normal mutating-method
# channel, and native code calls `rt_array_fill_span`, which stores volatile
# and fences. No raw data pointer ever reaches Simple code -- the previous
# `rt_array_data_ptr` + `rt_volatile_write_*` loop wrote through a shared
# `Arc<Vec<u8>>` allocation (or a dangling temporary) under the interpreter.
# Bug: doc/08_tracking/bug/secure_memory_interpreter_raw_pointer_aliasing_2026-08-24.md
#
# Each owner takes its buffer as a `mut` parameter so the wipe is published
# back to the caller's place (local, field or nested field) on both engines.
# Applications consume the typed facade and cannot fabricate successful
# readback: `overwritten_slots` is the count the fill reported and
# `residual_nonzero_slots` is an independent read-back through the same place.

@unsafe(reason: "raw array length mutation; wrapper validates length and exact success status", capabilities: [ffi])
extern fn rt_array_set_len_known(collection: [u8], len: i64) -> i8

struct SecureZeroReport:
    slot_count: u64
    overwritten_slots: u64
    residual_nonzero_slots: u64

    fn verified() -> bool:
        self.slot_count > 0u64 and
            self.overwritten_slots == self.slot_count and
            self.residual_nonzero_slots == 0u64

fn _failed_report(slot_count: u64) -> SecureZeroReport:
    SecureZeroReport(
        slot_count: slot_count, overwritten_slots: 0u64,
        residual_nonzero_slots: slot_count)

fn _residual_nonzero_u8(bytes: [u8], start: u64, byte_count: u64) -> u64:
    var residual = 0u64
    var index = 0u64
    while index < byte_count:
        if (bytes[start + index] as i64) != 0:
            residual = residual + 1u64
        index = index + 1u64
    residual

fn secure_zero_u8_slots(mut bytes: [u8]) -> SecureZeroReport:
    secure_zero_u8_range(bytes, 0u64, bytes.len())

fn secure_zero_u8_range(mut bytes: [u8], start: u64, byte_count: u64) -> SecureZeroReport:
    """Volatile-overwrite `byte_count` bytes from `start` and read them back.

    Fails closed (nothing written, `verified()` false) for an empty or
    out-of-range window: a `[u8]` has one byte per element and the window is
    validated against the element count before any store.
    """
    if byte_count == 0u64 or start > bytes.len() or byte_count > bytes.len() - start:
        return _failed_report(byte_count)
    val written = bytes.fill_span(start as i64, byte_count as i64, 0u8)
    if written != byte_count as i64:
        return _failed_report(byte_count)
    SecureZeroReport(
        slot_count: byte_count, overwritten_slots: byte_count,
        residual_nonzero_slots: _residual_nonzero_u8(bytes, start, byte_count))

fn _residual_nonzero_words<T>(words: [T], slot_count: u64) -> u64:
    var residual = 0u64
    var index = 0u64
    while index < slot_count:
        if (words[index] as i64) != 0:
            residual = residual + 1u64
        index = index + 1u64
    residual

fn secure_zero_i64_slots(mut words: [i64]) -> SecureZeroReport:
    """Volatile-overwrite and read back every reachable i64 array slot."""
    val slot_count = words.len()
    if slot_count == 0u64:
        return _failed_report(0u64)
    val written = words.fill_span(0, slot_count as i64, 0)
    if written != slot_count as i64:
        return _failed_report(slot_count)
    SecureZeroReport(
        slot_count: slot_count, overwritten_slots: slot_count,
        residual_nonzero_slots: _residual_nonzero_words(words, slot_count))

fn secure_zero_u32_slots(mut words: [u32]) -> SecureZeroReport:
    """Volatile-overwrite and read back every reachable u32 array slot.

    The report covers only this exact owner-reachable allocation. It makes no
    claim about compiler temporaries, stack/register copies, or prior arrays.
    """
    val slot_count = words.len()
    if slot_count == 0u64:
        return _failed_report(0u64)
    val written = words.fill_span(0, slot_count as i64, 0u32)
    if written != slot_count as i64:
        return _failed_report(slot_count)
    SecureZeroReport(
        slot_count: slot_count, overwritten_slots: slot_count,
        residual_nonzero_slots: _residual_nonzero_words(words, slot_count))

fn secure_zero_u64_slots(mut words: [u64]) -> SecureZeroReport:
    """Volatile-overwrite and read back every reachable u64 array slot."""
    val slot_count = words.len()
    if slot_count == 0u64:
        return _failed_report(0u64)
    val written = words.fill_span(0, slot_count as i64, 0u64)
    if written != slot_count as i64:
        return _failed_report(slot_count)
    SecureZeroReport(
        slot_count: slot_count, overwritten_slots: slot_count,
        residual_nonzero_slots: _residual_nonzero_words(words, slot_count))

fn secure_set_u8_length(bytes: [u8], length: i64) -> bool:
    if length < 0:
        return false
    val status = unsafe(capabilities: [ffi]):
        rt_array_set_len_known(bytes, length)
    status == 1i8

export SecureZeroReport, secure_zero_u8_slots, secure_zero_u8_range
export secure_zero_i64_slots, secure_zero_u32_slots, secure_zero_u64_slots
export secure_set_u8_length
