# Compiler-resistant mutable-secret memory owner.
# Raw runtime array/volatile calls are confined here; applications consume the
# typed facade and cannot fabricate successful readback.

@unsafe(reason: "raw array length mutation; wrapper validates length and exact success status", capabilities: [ffi])
extern fn rt_array_set_len_known(collection: [u8], len: i64) -> i8
@unsafe(reason: "raw i64-array storage pointer; zero is rejected before access", capabilities: [ffi, raw_ptr])
extern fn rt_array_data_ptr(collection: [i64]) -> i64
@unsafe(reason: "raw u8-array storage pointer; zero is rejected before access", capabilities: [ffi, raw_ptr])
extern fn rt_array_data_ptr_text(collection: [u8]) -> i64
@unsafe(reason: "volatile secret-memory byte read after bounds and pointer validation", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_read_u8(addr: i64) -> i64
@unsafe(reason: "volatile secret-memory byte write after bounds and pointer validation", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_write_u8(addr: i64, value: i64)
@unsafe(reason: "volatile secret-memory word read after bounds and pointer validation", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_read_u64(addr: i64) -> i64
@unsafe(reason: "volatile secret-memory word write after bounds and pointer validation", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_write_u64(addr: i64, value: i64)
@unsafe(reason: "compiler-resistant memory ordering boundary for secret zeroization", capabilities: [ffi])
extern fn rt_memory_barrier()

struct SecureZeroReport:
    slot_count: u64
    overwritten_slots: u64
    residual_nonzero_slots: u64

    fn verified() -> bool:
        self.slot_count > 0u64 and
            self.overwritten_slots == self.slot_count and
            self.residual_nonzero_slots == 0u64

fn _secure_zero_slots(data_ptr: i64, slot_count: u64) -> SecureZeroReport:
    if slot_count == 0u64 or data_ptr == 0:
        return SecureZeroReport(
            slot_count: slot_count, overwritten_slots: 0u64,
            residual_nonzero_slots: slot_count)
    var index: u64 = 0u64
    while index < slot_count:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_volatile_write_u64(data_ptr + (index * 8u64) as i64, 0)
        index = index + 1u64
    unsafe(capabilities: [ffi]):
        rt_memory_barrier()
    var residual: u64 = 0u64
    index = 0u64
    while index < slot_count:
        val value = unsafe(capabilities: [ffi, raw_ptr]):
            rt_volatile_read_u64(data_ptr + (index * 8u64) as i64)
        if value != 0:
            residual = residual + 1u64
        index = index + 1u64
    unsafe(capabilities: [ffi]):
        rt_memory_barrier()
    SecureZeroReport(
        slot_count: slot_count, overwritten_slots: slot_count,
        residual_nonzero_slots: residual)

fn secure_zero_u8_slots(bytes: [u8]) -> SecureZeroReport:
    secure_zero_u8_range(bytes, 0u64, bytes.len())

fn secure_zero_u8_range(bytes: [u8], start: u64, byte_count: u64) -> SecureZeroReport:
    # A [u8] has one byte per element. Never route its element count through
    # the u64-slot helper: that would write eight times beyond the allocation.
    if byte_count == 0u64 or start > bytes.len() or byte_count > bytes.len() - start:
        return SecureZeroReport(
            slot_count: byte_count, overwritten_slots: 0u64,
            residual_nonzero_slots: byte_count)
    # Native codegen has no `.data_ptr()` lowering at all (only the
    # interpreter does); the Stage 2 link resolved this call to the
    # nonexistent dynamic symbol `Array.data_ptr`. Use the canonical runtime
    # ABI owner explicitly, same as the i64-slot path below;
    # rt_array_data_ptr_text is the element-agnostic alias of
    # rt_array_data_ptr (src/runtime/runtime_native.c).
    val data_ptr = unsafe(capabilities: [ffi, raw_ptr]):
        rt_array_data_ptr_text(bytes)
    if data_ptr == 0:
        return SecureZeroReport(
            slot_count: byte_count, overwritten_slots: 0u64,
            residual_nonzero_slots: byte_count)
    var index = 0u64
    while index < byte_count:
        unsafe(capabilities: [ffi, raw_ptr]):
            rt_volatile_write_u8(data_ptr + (start + index) as i64, 0)
        index = index + 1u64
    unsafe(capabilities: [ffi]):
        rt_memory_barrier()
    var residual = 0u64
    index = 0u64
    while index < byte_count:
        val value = unsafe(capabilities: [ffi, raw_ptr]):
            rt_volatile_read_u8(data_ptr + (start + index) as i64)
        if value != 0:
            residual = residual + 1u64
        index = index + 1u64
    unsafe(capabilities: [ffi]):
        rt_memory_barrier()
    SecureZeroReport(
        slot_count: byte_count, overwritten_slots: byte_count,
        residual_nonzero_slots: residual)

fn secure_zero_i64_slots(words: [i64]) -> SecureZeroReport:
    # `.data_ptr()` lowers to the nonexistent dynamic symbol `Array.data_ptr`
    # under native codegen for every element type (the byte-array form too —
    # proven by the 2026-08-31 Stage 2 link). Use the canonical runtime ABI
    # owner explicitly.
    val data_ptr = unsafe(capabilities: [ffi, raw_ptr]):
        rt_array_data_ptr(words)
    _secure_zero_slots(data_ptr, words.len())

fn secure_set_u8_length(bytes: [u8], length: i64) -> bool:
    if length < 0:
        return false
    val status = unsafe(capabilities: [ffi]):
        rt_array_set_len_known(bytes, length)
    status == 1i8

export SecureZeroReport, secure_zero_u8_slots, secure_zero_u8_range, secure_zero_i64_slots, secure_set_u8_length
