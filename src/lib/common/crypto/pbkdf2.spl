# PBKDF2 — Pure Simple Implementation (RFC 2898 §5.2 / RFC 8018)
#
# Provides PBKDF2 key derivation with HMAC-SHA-256, HMAC-SHA-384, and
# HMAC-SHA-512 as the pseudo-random function.
#
# Public API:
#   pbkdf2_sha256_bytes(password, salt, iterations, dk_len) -> [i64]
#   pbkdf2_sha384_bytes(password, salt, iterations, dk_len) -> [i64]
#   pbkdf2_sha512_bytes(password, salt, iterations, dk_len) -> [i64]
#   pbkdf2_sha384_bytes_fast / pbkdf2_sha512_bytes_fast — runtime-hash fast path (opt-in)
#
# All inputs and outputs use [i64] byte lists (values 0-255).
#
# RFC 2898 §5.2 algorithm:
#   For each block i = 1 .. ceil(dkLen / hLen):
#     U_1 = PRF(password, salt || INT(i))   INT(i) = 4-byte big-endian
#     U_j = PRF(password, U_{j-1})           j = 2..c
#     T_i = U_1 XOR U_2 XOR ... XOR U_c
#   DK = T_1 || T_2 || ... (truncated to dkLen bytes)
#
# INTERPRETER PERFORMANCE
#   HMAC-SHA-256 takes ~9.5 ms per call in interpreter mode. At c=4096
#   iterations, each block requires 4096 HMAC calls (~39 s per block).
#   A single 32-byte block (dkLen=32) at c=4096 exceeds the 60 s test-runner
#   watchdog. This is a known limitation:
#   Filed: doc/08_tracking/bug/pbkdf2_interpreter_slow_c4096_2026-06-15.md
#   PBKDF2-HMAC-SHA-384/512 run pure Simple over the word-level SHA-512-family
#   core (std.common.crypto.sha512.sha512_family_*): pad states computed once
#   per derivation, two compressions per iteration, no allocation per
#   iteration (~1 ms per compression interpreted, 2026-10-20).
#
# References:
#   RFC 2898 §5.2 — PBKDF2 algorithm
#   RFC 8018 §5.2 — Same algorithm, updated obsoletes RFC 2898
#   draft-josefsson-pbkdf2-test-vectors-00 — reference test vectors

use std.common.crypto.hmac.{hmac_sha1_bytes, hmac_sha256_bytes}
use std.common.crypto.sha512.{sha384_bytes, sha512_bytes, sha512_family_block, sha512_family_iv, sha512_family_compress, sha512_family_absorb, sha512_family_words_to_bytes}
use std.sffi.sha2.{sha384_digest, sha512_digest}

# ============================================================================
# Internal helpers
# ============================================================================

fn _pbkdf2_int4(n: i64) -> [i64]:
    """Encode n as 4-byte big-endian (RFC 2898 §5.2 INT(i))."""
    var out: [i64] = []
    out.push((n >> 24) & 255)
    out.push((n >> 16) & 255)
    out.push((n >> 8) & 255)
    out.push(n & 255)
    out

fn _pbkdf2_xor_bytes(a: [i64], b: [i64]) -> [i64]:
    """XOR two equal-length byte lists."""
    var r: [i64] = []
    var i: i64 = 0
    val n = a.len()
    while i < n:
        r.push(a[i] ^ b[i])
        i = i + 1
    r

fn _pbkdf2_append(a: [i64], b: [i64]) -> [i64]:
    """Concatenate two byte lists."""
    var r: [i64] = []
    var i: i64 = 0
    val n_a = a.len()
    while i < n_a:
        r.push(a[i])
        i = i + 1
    var j: i64 = 0
    val n_b = b.len()
    while j < n_b:
        r.push(b[j])
        j = j + 1
    r

fn _pbkdf2_slice(src: [i64], start: i64, end_excl: i64) -> [i64]:
    """Extract bytes src[start..end_excl]."""
    var out: [i64] = []
    var i: i64 = start
    while i < end_excl:
        out.push(src[i])
        i = i + 1
    out

# ============================================================================
# Core PBKDF2 implementation parameterized by hash function and hash length.
#
# To avoid first-class function issues in interpreter mode, the hash variant
# (256/384/512) is selected via the h_variant parameter:
#   h_variant = 256 → HMAC-SHA-256 (hLen = 32)
#   h_variant = 384 → HMAC-SHA-384 (hLen = 48)
#   h_variant = 512 → HMAC-SHA-512 (hLen = 64)
# ============================================================================

fn _pbkdf2_block_sha256(password: [i64], salt: [i64], iterations: i64,
                        block_i: i64) -> [i64]:
    """Compute T_i = U_1 XOR ... XOR U_c for one block using HMAC-SHA-256."""
    # U_1 = HMAC(password, salt || INT(i))
    val u1_input = _pbkdf2_append(salt, _pbkdf2_int4(block_i))
    var u = hmac_sha256_bytes(password, u1_input)
    var t = u
    var j: i64 = 2
    while j <= iterations:
        u = hmac_sha256_bytes(password, u)
        t = _pbkdf2_xor_bytes(t, u)
        j = j + 1
    t

# ============================================================================
# Runtime SHA-256 fast path (PBKDF2-HMAC-SHA-256)
#
# The runtime SHA-256 primitive is rt_tls13_sha256 (SHA-384/512 use
# rt_sha384_digest / rt_sha512_digest, see the next section). HMAC is built on
# it per RFC 2104: HMAC(K, m) = H((K' ^ opad) || H((K' ^ ipad) || m)), where
# K' is K zero-padded to the 64-byte block (K is hashed first if longer).
# ipad/opad are computed once per block, not once per iteration.
# Any digest that is not exactly 32 bytes (baremetal stub, JIT empty-result
# bug) makes the fast path return [] and the caller uses the pure path.
# ============================================================================

extern fn rt_tls13_sha256(data: [u8]) -> [u8]

fn _pbkdf2_rt_sha256(data: [u8]) -> [u8]:
    var digest: [u8] = []
    unsafe(capabilities: [ffi]):
        digest = rt_tls13_sha256(data)
    digest

fn _pbkdf2_cat_u8(a: [u8], b: [u8]) -> [u8]:
    var r: [u8] = a
    var i: i64 = 0
    val n = b.len() as i64
    while i < n:
        r.push(b[i])
        i = i + 1
    r

fn _pbkdf2_block_sha256_fast(password: [i64], salt: [i64], iterations: i64,
                             block_i: i64) -> [i64]:
    """Same result as _pbkdf2_block_sha256 via runtime SHA-256; [] if unavailable."""
    var key: [u8] = []
    var ki: i64 = 0
    while ki < password.len():
        key.push((password[ki] & 255) as u8)
        ki = ki + 1
    if key.len() > 64:
        key = _pbkdf2_rt_sha256(key)
        if key.len() != 32:
            return []
    var ipad: [u8] = []
    var opad: [u8] = []
    var pi: i64 = 0
    while pi < 64:
        val kb: i64 = if pi < key.len(): key[pi] as i64 else: 0
        ipad.push((kb ^ 0x36) as u8)
        opad.push((kb ^ 0x5c) as u8)
        pi = pi + 1
    var msg: [u8] = []
    var si: i64 = 0
    while si < salt.len():
        msg.push((salt[si] & 255) as u8)
        si = si + 1
    val ctr = _pbkdf2_int4(block_i)
    var ci: i64 = 0
    while ci < 4:
        msg.push(ctr[ci] as u8)
        ci = ci + 1
    var u = _pbkdf2_rt_sha256(_pbkdf2_cat_u8(opad, _pbkdf2_rt_sha256(_pbkdf2_cat_u8(ipad, msg))))
    if u.len() != 32:
        return []
    var t: [i64] = []
    var ti: i64 = 0
    while ti < 32:
        t.push(u[ti] as i64)
        ti = ti + 1
    var j: i64 = 2
    while j <= iterations:
        u = _pbkdf2_rt_sha256(_pbkdf2_cat_u8(opad, _pbkdf2_rt_sha256(_pbkdf2_cat_u8(ipad, u))))
        if u.len() != 32:
            return []
        var x: i64 = 0
        while x < 32:
            t[x] = t[x] ^ (u[x] as i64)
            x = x + 1
        j = j + 1
    t

# ============================================================================
# Runtime SHA-384/512 fast path (PBKDF2-HMAC-SHA-384/512)
#
# Same RFC 2104 construction as the SHA-256 path over the runtime
# rt_sha384_digest / rt_sha512_digest (through their typed sffi.host
# wrappers), with the 128-byte SHA-512-family block (FIPS 180-4) for K', ipad
# and opad. h_len selects the hash: 48 → SHA-384, 64 → SHA-512.
# Any digest that is not exactly h_len bytes makes the fast path return []
# and the caller uses the pure path.
# ============================================================================

fn _pbkdf2_rt_sha2_512_family(data: [u8], h_len: i64) -> [u8]:
    if h_len == 48:
        return sha384_digest(data)
    sha512_digest(data)

fn _pbkdf2_block_sha2_512_family_fast(password: [i64], salt: [i64], iterations: i64,
                                      block_i: i64, h_len: i64) -> [i64]:
    """Same result as _pbkdf2_block_sha384/512 via the runtime hash; [] if unavailable."""
    var key: [u8] = []
    var ki: i64 = 0
    while ki < password.len():
        key.push((password[ki] & 255) as u8)
        ki = ki + 1
    if key.len() > 128:
        key = _pbkdf2_rt_sha2_512_family(key, h_len)
        if key.len() != h_len:
            return []
    var ipad: [u8] = []
    var opad: [u8] = []
    var pi: i64 = 0
    while pi < 128:
        val kb: i64 = if pi < key.len(): key[pi] as i64 else: 0
        ipad.push((kb ^ 0x36) as u8)
        opad.push((kb ^ 0x5c) as u8)
        pi = pi + 1
    var msg: [u8] = []
    var si: i64 = 0
    while si < salt.len():
        msg.push((salt[si] & 255) as u8)
        si = si + 1
    val ctr = _pbkdf2_int4(block_i)
    var ci: i64 = 0
    while ci < 4:
        msg.push(ctr[ci] as u8)
        ci = ci + 1
    var u = _pbkdf2_rt_sha2_512_family(_pbkdf2_cat_u8(opad, _pbkdf2_rt_sha2_512_family(_pbkdf2_cat_u8(ipad, msg), h_len)), h_len)
    if u.len() != h_len:
        return []
    var t: [i64] = []
    var ti: i64 = 0
    while ti < h_len:
        t.push(u[ti] as i64)
        ti = ti + 1
    var j: i64 = 2
    while j <= iterations:
        u = _pbkdf2_rt_sha2_512_family(_pbkdf2_cat_u8(opad, _pbkdf2_rt_sha2_512_family(_pbkdf2_cat_u8(ipad, u), h_len)), h_len)
        if u.len() != h_len:
            return []
        var x: i64 = 0
        while x < h_len:
            t[x] = t[x] ^ (u[x] as i64)
            x = x + 1
        j = j + 1
    t

fn _pbkdf2_sha2_512_family_bytes(password: [i64], salt: [i64], iterations: i64,
                                 dk_len: i64, h_len: i64) -> [i64]:
    """PBKDF2 over the runtime SHA-384/512 fast path, per block falling back to
    the pure-Simple block when the runtime digest is unavailable."""
    val num_blocks: i64 = (dk_len + h_len - 1) / h_len
    var dk: [i64] = []
    var bi: i64 = 1
    while bi <= num_blocks:
        var t = _pbkdf2_block_sha2_512_family_fast(password, salt, iterations, bi, h_len)
        if t.len() != h_len:
            if h_len == 48:
                t = _pbkdf2_block_sha384(password, salt, iterations, bi)
            else:
                t = _pbkdf2_block_sha512(password, salt, iterations, bi)
        var ki: i64 = 0
        while ki < t.len():
            dk.push(t[ki])
            ki = ki + 1
        bi = bi + 1
    _pbkdf2_slice(dk, 0, dk_len)

fn _pbkdf2_block_sha1(password: [i64], salt: [i64], iterations: i64,
                      block_i: i64) -> [i64]:
    """Compute T_i = U_1 XOR ... XOR U_c for one block using HMAC-SHA-1."""
    val u1_input = _pbkdf2_append(salt, _pbkdf2_int4(block_i))
    var u = hmac_sha1_bytes(password, u1_input)
    var t = u
    var j: i64 = 2
    while j <= iterations:
        u = hmac_sha1_bytes(password, u)
        t = _pbkdf2_xor_bytes(t, u)
        j = j + 1
    t

# ============================================================================
# Pure-Simple PBKDF2-HMAC-SHA-384/512 over the word-level SHA-512-family core
#
# HMAC(K, m) = H((K' ^ opad) || H((K' ^ ipad) || m)) (RFC 2104). The
# ipad/opad blocks are compressed ONCE per derivation into two 8-word states;
# every iteration then costs exactly two compressions. Each U_j (j >= 2) is a
# fixed-shape single block after the 128-byte pad block: hw = h_len / 8 digest
# words, the 0x80 marker word, zeros, and the bit length (128 + h_len) * 8.
# ============================================================================

fn _pbkdf2_s5_pad_state(key: [i64], pad: i64, h_len: i64, w: [i64]) -> [i64]:
    """Compress the 128-byte block K' ^ pad from the IV; K' is key zero-padded."""
    var st = sha512_family_iv(h_len)
    val kl = key.len()
    var j: i64 = 0
    while j < 16:
        var word: i64 = 0
        var b: i64 = 0
        while b < 8:
            val idx = j * 8 + b
            val kb: i64 = if idx < kl: key[idx] & 255 else: 0
            word = (word << 8) | (kb ^ pad)
            b = b + 1
        w[j] = word
        j = j + 1
    sha512_family_compress(st, w)
    st

fn _pbkdf2_s5_fixed(st: [i64], from: [i64], u: [i64], hw: i64, w: [i64]):
    """u <- first hw words of H continued from state `from` over the hw-word
    message u (the fixed-shape block after the 128-byte pad block)."""
    var x: i64 = 0
    while x < 8:
        st[x] = from[x]
        x = x + 1
    x = 0
    while x < 16:
        w[x] = 0
        x = x + 1
    x = 0
    while x < hw:
        w[x] = u[x]
        x = x + 1
    w[hw] = 128 << 56
    w[15] = (128 + hw * 8) * 8
    sha512_family_compress(st, w)
    x = 0
    while x < hw:
        u[x] = st[x]
        x = x + 1

# Iterations j = 2..c: U_j = HMAC(P, U_{j-1}), T ^= U_j. Both compressions of
# every iteration are inlined over locals (digest, schedule ring, working
# variables), so the loop performs no allocation, no array store and no
# function call; ist/ost are only read. u/t hold U_1/T on entry; t holds T on
# exit. SHA-384 (hw 6) carries two unused state words through u6/u7, t6/t7.
fn _pbkdf2_s5_iterate(ist: [i64], ost: [i64], u: [i64], t: [i64], iterations: i64, hw: i64):
    val is384 = hw == 6
    val marker: i64 = 128 << 56
    val bits: i64 = (128 + hw * 8) * 8
    var u0 = u[0]
    var u1 = u[1]
    var u2 = u[2]
    var u3 = u[3]
    var u4 = u[4]
    var u5 = u[5]
    var u6 = u[6]
    var u7 = u[7]
    var t0 = t[0]
    var t1 = t[1]
    var t2 = t[2]
    var t3 = t[3]
    var t4 = t[4]
    var t5 = t[5]
    var t6 = t[6]
    var t7 = t[7]
    var w0: i64 = 0
    var w1: i64 = 0
    var w2: i64 = 0
    var w3: i64 = 0
    var w4: i64 = 0
    var w5: i64 = 0
    var w6: i64 = 0
    var w7: i64 = 0
    var w8: i64 = 0
    var w9: i64 = 0
    var w10: i64 = 0
    var w11: i64 = 0
    var w12: i64 = 0
    var w13: i64 = 0
    var w14: i64 = 0
    var w15: i64 = 0
    var a: i64 = 0
    var b: i64 = 0
    var c: i64 = 0
    var d: i64 = 0
    var e: i64 = 0
    var f: i64 = 0
    var g: i64 = 0
    var h: i64 = 0
    var tt: i64 = 0
    var j: i64 = 2
    while j <= iterations:
        # inner hash: continue from the ipad state over U_{j-1}
        w0 = u0
        w1 = u1
        w2 = u2
        w3 = u3
        w4 = u4
        w5 = u5
        w6 = if is384: marker else: u6
        w7 = if is384: 0 else: u7
        w8 = if is384: 0 else: marker
        w9 = 0
        w10 = 0
        w11 = 0
        w12 = 0
        w13 = 0
        w14 = 0
        w15 = bits
        a = ist[0]
        b = ist[1]
        c = ist[2]
        d = ist[3]
        e = ist[4]
        f = ist[5]
        g = ist[6]
        h = ist[7]
        tt = h + ((((e >> 14) & 1125899906842623) | (e << 50)) ^ (((e >> 18) & 70368744177663) | (e << 46)) ^ (((e >> 41) & 8388607) | (e << 23))) + (g ^ (e & (f ^ g))) + (4794697086780616226) + w0
        d = d + tt
        h = tt + ((((a >> 28) & 68719476735) | (a << 36)) ^ (((a >> 34) & 1073741823) | (a << 30)) ^ (((a >> 39) & 33554431) | (a << 25))) + ((a & b) ^ (c & (a ^ b)))
        tt = g + ((((d >> 14) & 1125899906842623) | (d << 50)) ^ (((d >> 18) & 70368744177663) | (d << 46)) ^ (((d >> 41) & 8388607) | (d << 23))) + (f ^ (d & (e ^ f))) + (8158064640168781261) + w1
        c = c + tt
        g = tt + ((((h >> 28) & 68719476735) | (h << 36)) ^ (((h >> 34) & 1073741823) | (h << 30)) ^ (((h >> 39) & 33554431) | (h << 25))) + ((h & a) ^ (b & (h ^ a)))
        tt = f + ((((c >> 14) & 1125899906842623) | (c << 50)) ^ (((c >> 18) & 70368744177663) | (c << 46)) ^ (((c >> 41) & 8388607) | (c << 23))) + (e ^ (c & (d ^ e))) + (-5349999486874862801) + w2
        b = b + tt
        f = tt + ((((g >> 28) & 68719476735) | (g << 36)) ^ (((g >> 34) & 1073741823) | (g << 30)) ^ (((g >> 39) & 33554431) | (g << 25))) + ((g & h) ^ (a & (g ^ h)))
        tt = e + ((((b >> 14) & 1125899906842623) | (b << 50)) ^ (((b >> 18) & 70368744177663) | (b << 46)) ^ (((b >> 41) & 8388607) | (b << 23))) + (d ^ (b & (c ^ d))) + (-1606136188198331460) + w3
        a = a + tt
        e = tt + ((((f >> 28) & 68719476735) | (f << 36)) ^ (((f >> 34) & 1073741823) | (f << 30)) ^ (((f >> 39) & 33554431) | (f << 25))) + ((f & g) ^ (h & (f ^ g)))
        tt = d + ((((a >> 14) & 1125899906842623) | (a << 50)) ^ (((a >> 18) & 70368744177663) | (a << 46)) ^ (((a >> 41) & 8388607) | (a << 23))) + (c ^ (a & (b ^ c))) + (4131703408338449720) + w4
        h = h + tt
        d = tt + ((((e >> 28) & 68719476735) | (e << 36)) ^ (((e >> 34) & 1073741823) | (e << 30)) ^ (((e >> 39) & 33554431) | (e << 25))) + ((e & f) ^ (g & (e ^ f)))
        tt = c + ((((h >> 14) & 1125899906842623) | (h << 50)) ^ (((h >> 18) & 70368744177663) | (h << 46)) ^ (((h >> 41) & 8388607) | (h << 23))) + (b ^ (h & (a ^ b))) + (6480981068601479193) + w5
        g = g + tt
        c = tt + ((((d >> 28) & 68719476735) | (d << 36)) ^ (((d >> 34) & 1073741823) | (d << 30)) ^ (((d >> 39) & 33554431) | (d << 25))) + ((d & e) ^ (f & (d ^ e)))
        tt = b + ((((g >> 14) & 1125899906842623) | (g << 50)) ^ (((g >> 18) & 70368744177663) | (g << 46)) ^ (((g >> 41) & 8388607) | (g << 23))) + (a ^ (g & (h ^ a))) + (-7908458776815382629) + w6
        f = f + tt
        b = tt + ((((c >> 28) & 68719476735) | (c << 36)) ^ (((c >> 34) & 1073741823) | (c << 30)) ^ (((c >> 39) & 33554431) | (c << 25))) + ((c & d) ^ (e & (c ^ d)))
        tt = a + ((((f >> 14) & 1125899906842623) | (f << 50)) ^ (((f >> 18) & 70368744177663) | (f << 46)) ^ (((f >> 41) & 8388607) | (f << 23))) + (h ^ (f & (g ^ h))) + (-6116909921290321640) + w7
        e = e + tt
        a = tt + ((((b >> 28) & 68719476735) | (b << 36)) ^ (((b >> 34) & 1073741823) | (b << 30)) ^ (((b >> 39) & 33554431) | (b << 25))) + ((b & c) ^ (d & (b ^ c)))
        tt = h + ((((e >> 14) & 1125899906842623) | (e << 50)) ^ (((e >> 18) & 70368744177663) | (e << 46)) ^ (((e >> 41) & 8388607) | (e << 23))) + (g ^ (e & (f ^ g))) + (-2880145864133508542) + w8
        d = d + tt
        h = tt + ((((a >> 28) & 68719476735) | (a << 36)) ^ (((a >> 34) & 1073741823) | (a << 30)) ^ (((a >> 39) & 33554431) | (a << 25))) + ((a & b) ^ (c & (a ^ b)))
        tt = g + ((((d >> 14) & 1125899906842623) | (d << 50)) ^ (((d >> 18) & 70368744177663) | (d << 46)) ^ (((d >> 41) & 8388607) | (d << 23))) + (f ^ (d & (e ^ f))) + (1334009975649890238) + w9
        c = c + tt
        g = tt + ((((h >> 28) & 68719476735) | (h << 36)) ^ (((h >> 34) & 1073741823) | (h << 30)) ^ (((h >> 39) & 33554431) | (h << 25))) + ((h & a) ^ (b & (h ^ a)))
        tt = f + ((((c >> 14) & 1125899906842623) | (c << 50)) ^ (((c >> 18) & 70368744177663) | (c << 46)) ^ (((c >> 41) & 8388607) | (c << 23))) + (e ^ (c & (d ^ e))) + (2608012711638119052) + w10
        b = b + tt
        f = tt + ((((g >> 28) & 68719476735) | (g << 36)) ^ (((g >> 34) & 1073741823) | (g << 30)) ^ (((g >> 39) & 33554431) | (g << 25))) + ((g & h) ^ (a & (g ^ h)))
        tt = e + ((((b >> 14) & 1125899906842623) | (b << 50)) ^ (((b >> 18) & 70368744177663) | (b << 46)) ^ (((b >> 41) & 8388607) | (b << 23))) + (d ^ (b & (c ^ d))) + (6128411473006802146) + w11
        a = a + tt
        e = tt + ((((f >> 28) & 68719476735) | (f << 36)) ^ (((f >> 34) & 1073741823) | (f << 30)) ^ (((f >> 39) & 33554431) | (f << 25))) + ((f & g) ^ (h & (f ^ g)))
        tt = d + ((((a >> 14) & 1125899906842623) | (a << 50)) ^ (((a >> 18) & 70368744177663) | (a << 46)) ^ (((a >> 41) & 8388607) | (a << 23))) + (c ^ (a & (b ^ c))) + (8268148722764581231) + w12
