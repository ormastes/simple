fn _pbkdf2_s5_block(ist: [i64], ost: [i64], salt: [i64], iterations: i64, block_i: i64,
                    hw: i64, w: [i64], st: [i64], u: [i64], t: [i64]):
    """t[0..hw-1] <- T_i = U_1 ^ ... ^ U_c (as words)."""
    # U_1 = HMAC(P, S || INT(i)): the only variable-length message.
    var x: i64 = 0
    while x < 8:
        st[x] = ist[x]
        x = x + 1
    sha512_family_absorb(st, _pbkdf2_append(salt, _pbkdf2_int4(block_i)), 128, w)
    x = 0
    while x < 8:
        u[x] = st[x]
        x = x + 1
    _pbkdf2_s5_fixed(st, ost, u, hw, w)
    x = 0
    while x < 8:
        t[x] = u[x]
        x = x + 1
    _pbkdf2_s5_iterate(ist, ost, u, t, iterations, hw)

fn _pbkdf2_sha2_512_family_pure(password: [i64], salt: [i64], iterations: i64,
                                h_len: i64, first_block: i64, last_block: i64) -> [i64]:
    """Blocks first_block..last_block of PBKDF2-HMAC-SHA-384 (h_len 48) or
    -SHA-512 (h_len 64), concatenated, pure Simple."""
    var w = sha512_family_block()
    var key = password
    if key.len() > 128:
        key = if h_len == 48: sha384_bytes(key) else: sha512_bytes(key)
    val ist = _pbkdf2_s5_pad_state(key, 0x36, h_len, w)
    val ost = _pbkdf2_s5_pad_state(key, 0x5c, h_len, w)
    val hw = h_len / 8
    var st: [i64] = [0; 8]
    var u: [i64] = [0; 8]
    var t: [i64] = [0; 8]
    var dk: [i64] = []
    var bi = first_block
    while bi <= last_block:
        _pbkdf2_s5_block(ist, ost, salt, iterations, bi, hw, w, st, u, t)
        val tb = sha512_family_words_to_bytes(t, hw)
        var ki: i64 = 0
        while ki < h_len:
            dk.push(tb[ki])
            ki = ki + 1
        bi = bi + 1
    dk

fn _pbkdf2_block_sha384(password: [i64], salt: [i64], iterations: i64,
                        block_i: i64) -> [i64]:
    """Compute T_i = U_1 XOR ... XOR U_c for one block using HMAC-SHA-384."""
    _pbkdf2_sha2_512_family_pure(password, salt, iterations, 48, block_i, block_i)

fn _pbkdf2_block_sha512(password: [i64], salt: [i64], iterations: i64,
                        block_i: i64) -> [i64]:
    """Compute T_i = U_1 XOR ... XOR U_c for one block using HMAC-SHA-512."""
    _pbkdf2_sha2_512_family_pure(password, salt, iterations, 64, block_i, block_i)

# ============================================================================
# Public API
# ============================================================================

fn pbkdf2_sha1_bytes(password: [i64], salt: [i64], iterations: i64,
                     dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-1 key derivation (RFC 2898 §5.2).

    Required by SCRAM-SHA-1 (RFC 5802 §3, which fixes the PRF to
    HMAC-SHA-1 and dkLen to 20). `src/os/crypto/scram_sha1.spl:4` has
    imported this name since it was written, but only the SHA-256/384/512
    variants existed, so every SCRAM-SHA-1 call site failed with
    "function `pbkdf2_sha1_bytes` not found".

    Args:
      password   — secret octet string
      salt       — random salt (at least 8 bytes recommended by RFC §4)
      iterations — iteration count c (>= 1)
      dk_len     — desired derived-key length in bytes (<= 20 * (2^32 - 1))

    Returns: dk_len-byte derived key as [i64] list (values 0-255).
    """
    val h_len: i64 = 20   # HMAC-SHA-1 output bytes
    val num_blocks: i64 = (dk_len + h_len - 1) / h_len
    var dk: [i64] = []
    var bi: i64 = 1
    while bi <= num_blocks:
        val t = _pbkdf2_block_sha1(password, salt, iterations, bi)
        var ki: i64 = 0
        while ki < t.len():
            dk.push(t[ki])
            ki = ki + 1
        bi = bi + 1
    _pbkdf2_slice(dk, 0, dk_len)

fn pbkdf2_sha256_bytes_pure(password: [i64], salt: [i64], iterations: i64,
                       dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-256, pure Simple only (reference path for the fast path).

    Args:
      password   — secret octet string
      salt       — random salt (at least 8 bytes recommended by RFC §4)
      iterations — iteration count c (>= 1; higher is slower but safer)
      dk_len     — desired derived-key length in bytes (<= 32 * (2^32 - 1))

    Returns: dk_len-byte derived key as [i64] list (values 0-255).
    """
    val h_len: i64 = 32   # HMAC-SHA-256 output bytes
    val num_blocks: i64 = (dk_len + h_len - 1) / h_len
    var dk: [i64] = []
    var bi: i64 = 1
    while bi <= num_blocks:
        val t = _pbkdf2_block_sha256(password, salt, iterations, bi)
        var ki: i64 = 0
        while ki < t.len():
            dk.push(t[ki])
            ki = ki + 1
        bi = bi + 1
    _pbkdf2_slice(dk, 0, dk_len)

fn pbkdf2_sha256_bytes(password: [i64], salt: [i64], iterations: i64,
                       dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-256 (RFC 2898 §5.2 / RFC 8018) using the runtime SHA-256
    when it returns full 32-byte digests, else the pure-Simple path.
    Output is byte-identical either way for byte-valued (0-255) inputs."""
    val h_len: i64 = 32
    val num_blocks: i64 = (dk_len + h_len - 1) / h_len
    var dk: [i64] = []
    var bi: i64 = 1
    while bi <= num_blocks:
        var t = _pbkdf2_block_sha256_fast(password, salt, iterations, bi)
        if t.len() != 32:
            t = _pbkdf2_block_sha256(password, salt, iterations, bi)
        var ki: i64 = 0
        while ki < t.len():
            dk.push(t[ki])
            ki = ki + 1
        bi = bi + 1
    _pbkdf2_slice(dk, 0, dk_len)

fn pbkdf2_sha384_bytes(password: [i64], salt: [i64], iterations: i64,
                       dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-384 key derivation (RFC 2898 §5.2), pure Simple.

    Args:
      password   — secret octet string
      salt       — random salt
      iterations — iteration count c (>= 1)
      dk_len     — desired derived-key length in bytes (<= 48 * (2^32 - 1))

    Returns: dk_len-byte derived key as [i64] list (values 0-255).
    """
    val num_blocks: i64 = (dk_len + 47) / 48
    _pbkdf2_slice(_pbkdf2_sha2_512_family_pure(password, salt, iterations, 48, 1, num_blocks), 0, dk_len)

fn pbkdf2_sha512_bytes(password: [i64], salt: [i64], iterations: i64,
                       dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-512 key derivation (RFC 2898 §5.2), pure Simple.

    Args:
      password   — secret octet string
      salt       — random salt
      iterations — iteration count c (>= 1)
      dk_len     — desired derived-key length in bytes (<= 64 * (2^32 - 1))

    Returns: dk_len-byte derived key as [i64] list (values 0-255).
    """
    val num_blocks: i64 = (dk_len + 63) / 64
    _pbkdf2_slice(_pbkdf2_sha2_512_family_pure(password, salt, iterations, 64, 1, num_blocks), 0, dk_len)

# Opt-in until every deployed binary registers rt_sha384/512_digest: a binary
# without the extern fails hard (unknown extern), it does not fall back. Then
# pbkdf2_sha384/512_bytes switch to these (see the 2026-10-19 bug record).
fn pbkdf2_sha384_bytes_fast(password: [i64], salt: [i64], iterations: i64,
                            dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-384 (RFC 2898 §5.2 / RFC 8018) using the runtime SHA-384
    when it returns full 48-byte digests, else the pure-Simple path.
    Output is byte-identical either way for byte-valued (0-255) inputs."""
    _pbkdf2_sha2_512_family_bytes(password, salt, iterations, dk_len, 48)

fn pbkdf2_sha512_bytes_fast(password: [i64], salt: [i64], iterations: i64,
                            dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-512 (RFC 2898 §5.2 / RFC 8018) using the runtime SHA-512
    when it returns full 64-byte digests, else the pure-Simple path.
    Output is byte-identical either way for byte-valued (0-255) inputs."""
    _pbkdf2_sha2_512_family_bytes(password, salt, iterations, dk_len, 64)
