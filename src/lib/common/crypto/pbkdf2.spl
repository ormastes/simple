# PBKDF2 — Pure Simple Implementation (RFC 2898 §5.2 / RFC 8018)
#
# Provides PBKDF2 key derivation with HMAC-SHA-256, HMAC-SHA-384, and
# HMAC-SHA-512 as the pseudo-random function.
#
# Public API:
#   pbkdf2_sha256_bytes(password, salt, iterations, dk_len) -> [i64]
#   pbkdf2_sha384_bytes(password, salt, iterations, dk_len) -> [i64]
#   pbkdf2_sha512_bytes(password, salt, iterations, dk_len) -> [i64]
#   pbkdf2_sha384_bytes_fast / pbkdf2_sha512_bytes_fast — runtime-hash fast path (opt-in)
#
# All inputs and outputs use [i64] byte lists (values 0-255).
#
# RFC 2898 §5.2 algorithm:
#   For each block i = 1 .. ceil(dkLen / hLen):
#     U_1 = PRF(password, salt || INT(i))   INT(i) = 4-byte big-endian
#     U_j = PRF(password, U_{j-1})           j = 2..c
#     T_i = U_1 XOR U_2 XOR ... XOR U_c
#   DK = T_1 || T_2 || ... (truncated to dkLen bytes)
#
# INTERPRETER PERFORMANCE
#   HMAC-SHA-256 takes ~9.5 ms per call in interpreter mode. At c=4096
#   iterations, each block requires 4096 HMAC calls (~39 s per block).
#   A single 32-byte block (dkLen=32) at c=4096 exceeds the 60 s test-runner
#   watchdog. This is a known limitation:
#   Filed: doc/08_tracking/bug/pbkdf2_interpreter_slow_c4096_2026-06-15.md
#
# References:
#   RFC 2898 §5.2 — PBKDF2 algorithm
#   RFC 8018 §5.2 — Same algorithm, updated obsoletes RFC 2898
#   draft-josefsson-pbkdf2-test-vectors-00 — reference test vectors

use std.common.crypto.hmac.{hmac_sha1_bytes, hmac_sha256_bytes, hmac_sha384_bytes, hmac_sha512_bytes}
use std.nogc_sync_mut.sffi.host.{sha384_digest, sha512_digest}

# ============================================================================
# Internal helpers
# ============================================================================

fn _pbkdf2_int4(n: i64) -> [i64]:
    """Encode n as 4-byte big-endian (RFC 2898 §5.2 INT(i))."""
    var out: [i64] = []
    out.push((n >> 24) & 255)
    out.push((n >> 16) & 255)
    out.push((n >> 8) & 255)
    out.push(n & 255)
    out

fn _pbkdf2_xor_bytes(a: [i64], b: [i64]) -> [i64]:
    """XOR two equal-length byte lists."""
    var r: [i64] = []
    var i: i64 = 0
    val n = a.len()
    while i < n:
        r.push(a[i] ^ b[i])
        i = i + 1
    r

fn _pbkdf2_append(a: [i64], b: [i64]) -> [i64]:
    """Concatenate two byte lists."""
    var r: [i64] = []
    var i: i64 = 0
    val n_a = a.len()
    while i < n_a:
        r.push(a[i])
        i = i + 1
    var j: i64 = 0
    val n_b = b.len()
    while j < n_b:
        r.push(b[j])
        j = j + 1
    r

fn _pbkdf2_slice(src: [i64], start: i64, end_excl: i64) -> [i64]:
    """Extract bytes src[start..end_excl]."""
    var out: [i64] = []
    var i: i64 = start
    while i < end_excl:
        out.push(src[i])
        i = i + 1
    out

# ============================================================================
# Core PBKDF2 implementation parameterized by hash function and hash length.
#
# To avoid first-class function issues in interpreter mode, the hash variant
# (256/384/512) is selected via the h_variant parameter:
#   h_variant = 256 → HMAC-SHA-256 (hLen = 32)
#   h_variant = 384 → HMAC-SHA-384 (hLen = 48)
#   h_variant = 512 → HMAC-SHA-512 (hLen = 64)
# ============================================================================

fn _pbkdf2_block_sha256(password: [i64], salt: [i64], iterations: i64,
                        block_i: i64) -> [i64]:
    """Compute T_i = U_1 XOR ... XOR U_c for one block using HMAC-SHA-256."""
    # U_1 = HMAC(password, salt || INT(i))
    val u1_input = _pbkdf2_append(salt, _pbkdf2_int4(block_i))
    var u = hmac_sha256_bytes(password, u1_input)
    var t = u
    var j: i64 = 2
    while j <= iterations:
        u = hmac_sha256_bytes(password, u)
        t = _pbkdf2_xor_bytes(t, u)
        j = j + 1
    t

# ============================================================================
# Runtime SHA-256 fast path (PBKDF2-HMAC-SHA-256)
#
# The runtime SHA-256 primitive is rt_tls13_sha256 (SHA-384/512 use
# rt_sha384_digest / rt_sha512_digest, see the next section). HMAC is built on
# it per RFC 2104: HMAC(K, m) = H((K' ^ opad) || H((K' ^ ipad) || m)), where
# K' is K zero-padded to the 64-byte block (K is hashed first if longer).
# ipad/opad are computed once per block, not once per iteration.
# Any digest that is not exactly 32 bytes (baremetal stub, JIT empty-result
# bug) makes the fast path return [] and the caller uses the pure path.
# ============================================================================

extern fn rt_tls13_sha256(data: [u8]) -> [u8]

fn _pbkdf2_rt_sha256(data: [u8]) -> [u8]:
    var digest: [u8] = []
    unsafe(capabilities: [ffi]):
        digest = rt_tls13_sha256(data)
    digest

fn _pbkdf2_cat_u8(a: [u8], b: [u8]) -> [u8]:
    var r: [u8] = a
    var i: i64 = 0
    val n = b.len() as i64
    while i < n:
        r.push(b[i])
        i = i + 1
    r

fn _pbkdf2_block_sha256_fast(password: [i64], salt: [i64], iterations: i64,
                             block_i: i64) -> [i64]:
    """Same result as _pbkdf2_block_sha256 via runtime SHA-256; [] if unavailable."""
    var key: [u8] = []
    var ki: i64 = 0
    while ki < password.len():
        key.push((password[ki] & 255) as u8)
        ki = ki + 1
    if key.len() > 64:
        key = _pbkdf2_rt_sha256(key)
        if key.len() != 32:
            return []
    var ipad: [u8] = []
    var opad: [u8] = []
    var pi: i64 = 0
    while pi < 64:
        val kb: i64 = if pi < key.len(): key[pi] as i64 else: 0
        ipad.push((kb ^ 0x36) as u8)
        opad.push((kb ^ 0x5c) as u8)
        pi = pi + 1
    var msg: [u8] = []
    var si: i64 = 0
    while si < salt.len():
        msg.push((salt[si] & 255) as u8)
        si = si + 1
    val ctr = _pbkdf2_int4(block_i)
    var ci: i64 = 0
    while ci < 4:
        msg.push(ctr[ci] as u8)
        ci = ci + 1
    var u = _pbkdf2_rt_sha256(_pbkdf2_cat_u8(opad, _pbkdf2_rt_sha256(_pbkdf2_cat_u8(ipad, msg))))
    if u.len() != 32:
        return []
    var t: [i64] = []
    var ti: i64 = 0
    while ti < 32:
        t.push(u[ti] as i64)
        ti = ti + 1
    var j: i64 = 2
    while j <= iterations:
        u = _pbkdf2_rt_sha256(_pbkdf2_cat_u8(opad, _pbkdf2_rt_sha256(_pbkdf2_cat_u8(ipad, u))))
        if u.len() != 32:
            return []
        var x: i64 = 0
        while x < 32:
            t[x] = t[x] ^ (u[x] as i64)
            x = x + 1
        j = j + 1
    t

# ============================================================================
# Runtime SHA-384/512 fast path (PBKDF2-HMAC-SHA-384/512)
#
# Same RFC 2104 construction as the SHA-256 path over the runtime
# rt_sha384_digest / rt_sha512_digest (through their typed sffi.host
# wrappers), with the 128-byte SHA-512-family block (FIPS 180-4) for K', ipad
# and opad. h_len selects the hash: 48 → SHA-384, 64 → SHA-512.
# Any digest that is not exactly h_len bytes makes the fast path return []
# and the caller uses the pure path.
# ============================================================================

fn _pbkdf2_rt_sha2_512_family(data: [u8], h_len: i64) -> [u8]:
    if h_len == 48:
        return sha384_digest(data)
    sha512_digest(data)

fn _pbkdf2_block_sha2_512_family_fast(password: [i64], salt: [i64], iterations: i64,
                                      block_i: i64, h_len: i64) -> [i64]:
    """Same result as _pbkdf2_block_sha384/512 via the runtime hash; [] if unavailable."""
    var key: [u8] = []
    var ki: i64 = 0
    while ki < password.len():
        key.push((password[ki] & 255) as u8)
        ki = ki + 1
    if key.len() > 128:
        key = _pbkdf2_rt_sha2_512_family(key, h_len)
        if key.len() != h_len:
            return []
    var ipad: [u8] = []
    var opad: [u8] = []
    var pi: i64 = 0
    while pi < 128:
        val kb: i64 = if pi < key.len(): key[pi] as i64 else: 0
        ipad.push((kb ^ 0x36) as u8)
        opad.push((kb ^ 0x5c) as u8)
        pi = pi + 1
    var msg: [u8] = []
    var si: i64 = 0
    while si < salt.len():
        msg.push((salt[si] & 255) as u8)
        si = si + 1
    val ctr = _pbkdf2_int4(block_i)
    var ci: i64 = 0
    while ci < 4:
        msg.push(ctr[ci] as u8)
        ci = ci + 1
    var u = _pbkdf2_rt_sha2_512_family(_pbkdf2_cat_u8(opad, _pbkdf2_rt_sha2_512_family(_pbkdf2_cat_u8(ipad, msg), h_len)), h_len)
    if u.len() != h_len:
        return []
    var t: [i64] = []
    var ti: i64 = 0
    while ti < h_len:
        t.push(u[ti] as i64)
        ti = ti + 1
    var j: i64 = 2
    while j <= iterations:
        u = _pbkdf2_rt_sha2_512_family(_pbkdf2_cat_u8(opad, _pbkdf2_rt_sha2_512_family(_pbkdf2_cat_u8(ipad, u), h_len)), h_len)
        if u.len() != h_len:
            return []
        var x: i64 = 0
        while x < h_len:
            t[x] = t[x] ^ (u[x] as i64)
            x = x + 1
        j = j + 1
    t

fn _pbkdf2_sha2_512_family_bytes(password: [i64], salt: [i64], iterations: i64,
                                 dk_len: i64, h_len: i64) -> [i64]:
    """PBKDF2 over the runtime SHA-384/512 fast path, per block falling back to
    the pure-Simple block when the runtime digest is unavailable."""
    val num_blocks: i64 = (dk_len + h_len - 1) / h_len
    var dk: [i64] = []
    var bi: i64 = 1
    while bi <= num_blocks:
        var t = _pbkdf2_block_sha2_512_family_fast(password, salt, iterations, bi, h_len)
        if t.len() != h_len:
            if h_len == 48:
                t = _pbkdf2_block_sha384(password, salt, iterations, bi)
            else:
                t = _pbkdf2_block_sha512(password, salt, iterations, bi)
        var ki: i64 = 0
        while ki < t.len():
            dk.push(t[ki])
            ki = ki + 1
        bi = bi + 1
    _pbkdf2_slice(dk, 0, dk_len)

fn _pbkdf2_block_sha1(password: [i64], salt: [i64], iterations: i64,
                      block_i: i64) -> [i64]:
    """Compute T_i = U_1 XOR ... XOR U_c for one block using HMAC-SHA-1."""
    val u1_input = _pbkdf2_append(salt, _pbkdf2_int4(block_i))
    var u = hmac_sha1_bytes(password, u1_input)
    var t = u
    var j: i64 = 2
    while j <= iterations:
        u = hmac_sha1_bytes(password, u)
        t = _pbkdf2_xor_bytes(t, u)
        j = j + 1
    t

fn _pbkdf2_block_sha384(password: [i64], salt: [i64], iterations: i64,
                        block_i: i64) -> [i64]:
    """Compute T_i = U_1 XOR ... XOR U_c for one block using HMAC-SHA-384."""
    val u1_input = _pbkdf2_append(salt, _pbkdf2_int4(block_i))
    var u = hmac_sha384_bytes(password, u1_input)
    var t = u
    var j: i64 = 2
    while j <= iterations:
        u = hmac_sha384_bytes(password, u)
        t = _pbkdf2_xor_bytes(t, u)
        j = j + 1
    t

fn _pbkdf2_block_sha512(password: [i64], salt: [i64], iterations: i64,
                        block_i: i64) -> [i64]:
    """Compute T_i = U_1 XOR ... XOR U_c for one block using HMAC-SHA-512."""
    val u1_input = _pbkdf2_append(salt, _pbkdf2_int4(block_i))
    var u = hmac_sha512_bytes(password, u1_input)
    var t = u
    var j: i64 = 2
    while j <= iterations:
        u = hmac_sha512_bytes(password, u)
        t = _pbkdf2_xor_bytes(t, u)
        j = j + 1
    t

# ============================================================================
# Public API
# ============================================================================

fn pbkdf2_sha1_bytes(password: [i64], salt: [i64], iterations: i64,
                     dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-1 key derivation (RFC 2898 §5.2).

    Required by SCRAM-SHA-1 (RFC 5802 §3, which fixes the PRF to
    HMAC-SHA-1 and dkLen to 20). `src/os/crypto/scram_sha1.spl:4` has
    imported this name since it was written, but only the SHA-256/384/512
    variants existed, so every SCRAM-SHA-1 call site failed with
    "function `pbkdf2_sha1_bytes` not found".

    Args:
      password   — secret octet string
      salt       — random salt (at least 8 bytes recommended by RFC §4)
      iterations — iteration count c (>= 1)
      dk_len     — desired derived-key length in bytes (<= 20 * (2^32 - 1))

    Returns: dk_len-byte derived key as [i64] list (values 0-255).
    """
    val h_len: i64 = 20   # HMAC-SHA-1 output bytes
    val num_blocks: i64 = (dk_len + h_len - 1) / h_len
    var dk: [i64] = []
    var bi: i64 = 1
    while bi <= num_blocks:
        val t = _pbkdf2_block_sha1(password, salt, iterations, bi)
        var ki: i64 = 0
        while ki < t.len():
            dk.push(t[ki])
            ki = ki + 1
        bi = bi + 1
    _pbkdf2_slice(dk, 0, dk_len)

fn pbkdf2_sha256_bytes_pure(password: [i64], salt: [i64], iterations: i64,
                       dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-256, pure Simple only (reference path for the fast path).

    Args:
      password   — secret octet string
      salt       — random salt (at least 8 bytes recommended by RFC §4)
      iterations — iteration count c (>= 1; higher is slower but safer)
      dk_len     — desired derived-key length in bytes (<= 32 * (2^32 - 1))

    Returns: dk_len-byte derived key as [i64] list (values 0-255).
    """
    val h_len: i64 = 32   # HMAC-SHA-256 output bytes
    val num_blocks: i64 = (dk_len + h_len - 1) / h_len
    var dk: [i64] = []
    var bi: i64 = 1
    while bi <= num_blocks:
        val t = _pbkdf2_block_sha256(password, salt, iterations, bi)
        var ki: i64 = 0
        while ki < t.len():
            dk.push(t[ki])
            ki = ki + 1
        bi = bi + 1
    _pbkdf2_slice(dk, 0, dk_len)

fn pbkdf2_sha256_bytes(password: [i64], salt: [i64], iterations: i64,
                       dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-256 (RFC 2898 §5.2 / RFC 8018) using the runtime SHA-256
    when it returns full 32-byte digests, else the pure-Simple path.
    Output is byte-identical either way for byte-valued (0-255) inputs."""
    val h_len: i64 = 32
    val num_blocks: i64 = (dk_len + h_len - 1) / h_len
    var dk: [i64] = []
    var bi: i64 = 1
    while bi <= num_blocks:
        var t = _pbkdf2_block_sha256_fast(password, salt, iterations, bi)
        if t.len() != 32:
            t = _pbkdf2_block_sha256(password, salt, iterations, bi)
        var ki: i64 = 0
        while ki < t.len():
            dk.push(t[ki])
            ki = ki + 1
        bi = bi + 1
    _pbkdf2_slice(dk, 0, dk_len)

fn pbkdf2_sha384_bytes(password: [i64], salt: [i64], iterations: i64,
                       dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-384 key derivation (RFC 2898 §5.2), pure Simple.

    Args:
      password   — secret octet string
      salt       — random salt
      iterations — iteration count c (>= 1)
      dk_len     — desired derived-key length in bytes (<= 48 * (2^32 - 1))

    Returns: dk_len-byte derived key as [i64] list (values 0-255).
    """
    val h_len: i64 = 48   # HMAC-SHA-384 output bytes
    val num_blocks: i64 = (dk_len + h_len - 1) / h_len
    var dk: [i64] = []
    var bi: i64 = 1
    while bi <= num_blocks:
        val t = _pbkdf2_block_sha384(password, salt, iterations, bi)
        var ki: i64 = 0
        while ki < t.len():
            dk.push(t[ki])
            ki = ki + 1
        bi = bi + 1
    _pbkdf2_slice(dk, 0, dk_len)

fn pbkdf2_sha512_bytes(password: [i64], salt: [i64], iterations: i64,
                       dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-512 key derivation (RFC 2898 §5.2), pure Simple.

    Args:
      password   — secret octet string
      salt       — random salt
      iterations — iteration count c (>= 1)
      dk_len     — desired derived-key length in bytes (<= 64 * (2^32 - 1))

    Returns: dk_len-byte derived key as [i64] list (values 0-255).
    """
    val h_len: i64 = 64   # HMAC-SHA-512 output bytes
    val num_blocks: i64 = (dk_len + h_len - 1) / h_len
    var dk: [i64] = []
    var bi: i64 = 1
    while bi <= num_blocks:
        val t = _pbkdf2_block_sha512(password, salt, iterations, bi)
        var ki: i64 = 0
        while ki < t.len():
            dk.push(t[ki])
            ki = ki + 1
        bi = bi + 1
    _pbkdf2_slice(dk, 0, dk_len)

# Opt-in until every deployed binary registers rt_sha384/512_digest: a binary
# without the extern fails hard (unknown extern), it does not fall back. Then
# pbkdf2_sha384/512_bytes switch to these (see the 2026-10-19 bug record).
fn pbkdf2_sha384_bytes_fast(password: [i64], salt: [i64], iterations: i64,
                            dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-384 (RFC 2898 §5.2 / RFC 8018) using the runtime SHA-384
    when it returns full 48-byte digests, else the pure-Simple path.
    Output is byte-identical either way for byte-valued (0-255) inputs."""
    _pbkdf2_sha2_512_family_bytes(password, salt, iterations, dk_len, 48)

fn pbkdf2_sha512_bytes_fast(password: [i64], salt: [i64], iterations: i64,
                            dk_len: i64) -> [i64]:
    """PBKDF2-HMAC-SHA-512 (RFC 2898 §5.2 / RFC 8018) using the runtime SHA-512
    when it returns full 64-byte digests, else the pure-Simple path.
    Output is byte-identical either way for byte-valued (0-255) inputs."""
    _pbkdf2_sha2_512_family_bytes(password, salt, iterations, dk_len, 64)
