# HMAC-SHA1, HMAC-SHA256, HMAC-SHA512 implementations per RFC 2104.
# HMAC-SHA-1 and the text wrappers are pure Simple; bytes-level helpers stay
# available for code that already works with raw byte lists.

use std.common.crypto.types.{crypto_text_to_bytes, bytes_to_hex}
use std.common.crypto.sha256.{sha256_bytes}
use std.common.crypto.sha512.{sha512_256_bytes, sha512_bytes, sha384_bytes}
use std.crypto.sha1.{sha1_bytes}
use std.crypto.sha3.{sha3_256_bytes, sha3_384_bytes, sha3_512_bytes}

# HMAC-SHA256 of (key, data). Both are text (UTF-8). Returns lowercase hex.
pub fn hmac_sha256(key: text, data: text) -> text:
    bytes_to_hex(hmac_sha256_bytes(crypto_text_to_bytes(key), crypto_text_to_bytes(data)))

# HMAC-SHA512 of (key, data). Both are text (UTF-8). Returns lowercase hex.
pub fn hmac_sha512(key: text, data: text) -> text:
    bytes_to_hex(hmac_sha512_bytes(crypto_text_to_bytes(key), crypto_text_to_bytes(data)))

# Default HMAC (SHA-256). Returns lowercase hex.
fn hmac(key: text, data: text) -> text:
    hmac_sha256(key, data)

# ============================================================================
# Pure-Simple bytes-level HMAC (RFC 2104).
# These take and return `[u8]` byte arrays.
# Required for HKDF which chains HMAC over binary IKM/PRK.
#
# Each variant is HMAC(K, m) = H((K' ^ opad) || H((K' ^ ipad) || m)) where K'
# is the key (hashed first when longer than the block) zero-padded to the
# block size. The hash cannot be passed as a value, so every variant spells
# the two H calls itself and shares the byte plumbing below.
# ============================================================================

# K' zero-padded to block_len (the key must already be <= block_len).
fn _hmac_u8_key_block(key: [u8], block_len: i64) -> [u8]:
    var kp: [u8] = [0u8; block_len]
    var i = 0
    val n = key.len() as i64
    while i < n:
        kp[i] = key[i]
        i = i + 1
    kp

# (K' ^ pad) || tail.
fn _hmac_u8_pad_concat(kp: [u8], pad: i64, tail: [u8]) -> [u8]:
    val block_len = kp.len() as i64
    val tail_len = tail.len() as i64
    var out: [u8] = [0u8; block_len + tail_len]
    var i = 0
    while i < block_len:
        out[i] = ((kp[i] as i64) ^ pad).to_u8()
        i = i + 1
    var j = 0
    while j < tail_len:
        out[block_len + j] = tail[j]
        j = j + 1
    out

# HMAC-SHA-256 of binary key + data. Returns 32 bytes.
# Block size = 64 bytes, hash size = 32 bytes.
pub fn hmac_sha256_bytes(key: [u8], data: [u8]) -> [u8]:
    val block_len = 64
    var k = key
    if (k.len() as i64) > block_len:
        k = sha256_bytes(key)
    val kp = _hmac_u8_key_block(k, block_len)
    sha256_bytes(_hmac_u8_pad_concat(kp, 92, sha256_bytes(_hmac_u8_pad_concat(kp, 54, data))))

# ============================================================================
# HMAC-SHA-1 (RFC 2104 + RFC 2202). Block size = 64 bytes, hash size = 20 bytes.
# WARNING: SHA-1 is cryptographically broken. Provided for legacy interop only.
# ============================================================================

# HMAC-SHA-1 of binary key + data. Returns 20 bytes.
fn hmac_sha1_bytes(key: [u8], data: [u8]) -> [u8]:
    val block_len = 64
    var k = key
    if (k.len() as i64) > block_len:
        k = sha1_bytes(key)
    val kp = _hmac_u8_key_block(k, block_len)
    sha1_bytes(_hmac_u8_pad_concat(kp, 92, sha1_bytes(_hmac_u8_pad_concat(kp, 54, data))))

# HMAC-SHA-1 of text key + text data. Returns 20 bytes.
fn hmac_sha1(key: text, data: text) -> [u8]:
    hmac_sha1_bytes(crypto_text_to_bytes(key), crypto_text_to_bytes(data))

# ============================================================================
# HMAC-SHA-384 (RFC 2104). Block size = 128 bytes, hash size = 48 bytes.
# ============================================================================

fn hmac_sha384_bytes(key: [u8], data: [u8]) -> [u8]:
    val block_len = 128
    var k = key
    if (k.len() as i64) > block_len:
        k = sha384_bytes(key)
    val kp = _hmac_u8_key_block(k, block_len)
    sha384_bytes(_hmac_u8_pad_concat(kp, 92, sha384_bytes(_hmac_u8_pad_concat(kp, 54, data))))

# ============================================================================
# HMAC-SHA-512 (RFC 2104). Block size = 128 bytes, hash size = 64 bytes.
# ============================================================================

fn hmac_sha512_bytes(key: [u8], data: [u8]) -> [u8]:
    val block_len = 128
    var k = key
    if (k.len() as i64) > block_len:
        k = sha512_bytes(key)
    val kp = _hmac_u8_key_block(k, block_len)
    sha512_bytes(_hmac_u8_pad_concat(kp, 92, sha512_bytes(_hmac_u8_pad_concat(kp, 54, data))))

# ============================================================================
# HMAC-SHA-512/256 (RFC 2104 over FIPS 180-4 SHA-512/256).
# Block size = 128 bytes, hash size = 32 bytes.
# ============================================================================

fn hmac_sha512_256_bytes(key: [u8], data: [u8]) -> [u8]:
    val block_len = 128
    var k = key
    if (k.len() as i64) > block_len:
        k = sha512_256_bytes(key)
    val kp = _hmac_u8_key_block(k, block_len)
    sha512_256_bytes(_hmac_u8_pad_concat(kp, 92, sha512_256_bytes(_hmac_u8_pad_concat(kp, 54, data))))

# ============================================================================
# HMAC-SHA3-256 (RFC 2104 over FIPS 202). Block size = rate = 136 bytes.
# ============================================================================

fn hmac_sha3_256_bytes(key: [u8], data: [u8]) -> [u8]:
    val block_len = 136
    var k = key
    if (k.len() as i64) > block_len:
        k = sha3_256_bytes(key)
    val kp = _hmac_u8_key_block(k, block_len)
    sha3_256_bytes(_hmac_u8_pad_concat(kp, 92, sha3_256_bytes(_hmac_u8_pad_concat(kp, 54, data))))

# HMAC-SHA3-256 of text key + text data. Returns 32 bytes.
fn hmac_sha3_256(key: text, data: text) -> [u8]:
    hmac_sha3_256_bytes(crypto_text_to_bytes(key), crypto_text_to_bytes(data))

# ============================================================================
# HMAC-SHA3-384. Block size = rate = 104 bytes.
# ============================================================================

fn hmac_sha3_384_bytes(key: [u8], data: [u8]) -> [u8]:
    val block_len = 104
    var k = key
    if (k.len() as i64) > block_len:
        k = sha3_384_bytes(key)
    val kp = _hmac_u8_key_block(k, block_len)
    sha3_384_bytes(_hmac_u8_pad_concat(kp, 92, sha3_384_bytes(_hmac_u8_pad_concat(kp, 54, data))))

# HMAC-SHA3-384 of text key + text data. Returns 48 bytes.
fn hmac_sha3_384(key: text, data: text) -> [u8]:
    hmac_sha3_384_bytes(crypto_text_to_bytes(key), crypto_text_to_bytes(data))

# ============================================================================
# HMAC-SHA3-512. Block size = rate = 72 bytes.
# ============================================================================

fn hmac_sha3_512_bytes(key: [u8], data: [u8]) -> [u8]:
    val block_len = 72
    var k = key
    if (k.len() as i64) > block_len:
        k = sha3_512_bytes(key)
    val kp = _hmac_u8_key_block(k, block_len)
    sha3_512_bytes(_hmac_u8_pad_concat(kp, 92, sha3_512_bytes(_hmac_u8_pad_concat(kp, 54, data))))

# HMAC-SHA3-512 of text key + text data. Returns 64 bytes.
fn hmac_sha3_512(key: text, data: text) -> [u8]:
    hmac_sha3_512_bytes(crypto_text_to_bytes(key), crypto_text_to_bytes(data))
