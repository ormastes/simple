# std.common.diagnostics — language-neutral diagnostic contract
#
# Shared by the Simple compiler, the CMM/T32 tooling and the Markdown LSP.
# `compiler.common.diagnostics.{span,severity,diagnostic_v1}` re-export the
# SAME types for existing compiler-path importers.
#
#   severity.spl          Severity
#   span.spl              Span (byte offsets + 1-based line/col)
#   diagnostic_v1.spl     DiagnosticV1, LabelV1, MacroFrame, DiagnosticFix, FixReplacement, FixConfidence
#   diagnostic_batch.spl  DiagnosticBatchV1, BatchStatus, diagnostic_stable_id,
#                         FixCandidate, FixPrecondition, DiagnosticActionIndex
#   source_position.spl   LineStartTable, Utf16Position, Utf16Range,
#                         byte_to_position, position_to_byte, span_to_range
#
# Schemas: diagnostic_v1_schema.sdn, diagnostic_batch_v1_schema.sdn.

export severity.Severity
export span.Span
export diagnostic_v1.{DiagnosticV1, LabelV1, MacroFrame, DiagnosticFix, FixReplacement, FixConfidence}
export diagnostic_batch.{DiagnosticBatchV1, BatchDiagnostic, BatchStatus, batch_status_parse, diagnostic_stable_id}
export diagnostic_batch.{FixCandidate, FixPrecondition, DiagnosticActionIndex}
export source_position.{LineStartTable, Utf16Position, Utf16Range, byte_to_position, position_to_byte, span_to_range}
