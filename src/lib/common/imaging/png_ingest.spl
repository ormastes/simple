# PNG Ingest — load a PNG file (e.g. a CDP screenshot) into an ARGB buffer
#
# Thin bridge from a PNG file on disk to the (width, height, [u32] ARGB)
# shape the compositor diff engine (screenshot_compare / backend_parity)
# consumes. Decoding is the pure-Simple std.common.image.png_decode reader
# (bounded, non-interlaced 8-bit RGB/RGBA) — no direct rt_* calls here.

use std.io_runtime.{file_exists, file_read_bytes}
use std.common.image.png_decode.{decode_png_to_argb, PngImage}

class IngestedImage:
    width: i32
    height: i32
    pixels: [u32]

fn ingest_png_bytes(data: [u8]) -> Result<IngestedImage, text>:
    """Decode in-memory PNG bytes into an ARGB pixel buffer."""
    val decoded = decode_png_to_argb(data)
    if decoded.is_err():
        return Err(decoded.unwrap_err())
    val img = decoded.unwrap()
    Ok(IngestedImage(width: img.width, height: img.height, pixels: img.pixels))

fn ingest_png_file(path: text) -> Result<IngestedImage, text>:
    """Load and decode a PNG file into an ARGB pixel buffer."""
    if not file_exists(path):
        return Err("{path}: file not found")
    val bytes = file_read_bytes(path)
    if bytes.len() == 0:
        return Err("{path}: failed to read file or file is empty")
    ingest_png_bytes(bytes)

export IngestedImage
export ingest_png_bytes
export ingest_png_file
