# Pure-Simple VT/ANSI terminal emulator: bytes in, cell grid out.
#
# Why this exists: the `cs` caret suite must show agent panes on Windows,
# where tmux does not exist. Without tmux nothing turns a child process's
# byte stream into a screen. This module is that layer, and it is entirely
# platform independent: no I/O, no process handling, no module-level state.
#
# CONTRACT
# --------
# `term_feed` is PURE over `TermScreen`: it never mutates the screen it is
# given and never touches anything outside its own locals. It builds a fresh
# `TermScreen` (with a freshly built `cells` array) and mutates only that.
#
# TWO REPO-SPECIFIC HAZARDS THIS FILE IS BUILT AROUND — do not "simplify"
# either of them away:
#
# 1. STRUCT PARAMETERS DETACH. On this compiler a struct passed to a function
#    is a copy: field writes inside the callee are NOT visible to the caller.
#    Every helper here therefore takes the working screen and RETURNS it, and
#    every call site reassigns:  `w = line_feed(w)`. A helper written as a
#    void mutator silently does nothing, and that failure is invisible —
#    it just leaves the cursor parked at column 0.
#
# 2. ARRAY FIELDS DO NOT DETACH. `cells` is a reference, shared by every copy
#    of a screen. `copy_cells` exists precisely because of this: without it,
#    writing a glyph would reach back into the caller's screen and break the
#    purity contract above.
#
# CELL ALIASING RULE (load-bearing): `copy_cells` copies the ARRAY, not the
# cells inside it, so cells must only ever be replaced WHOLE:
#     cells[idx] = TermCell(ch: ..., fg: ..., bg: ..., attrs: ...)   # correct
#     cells[idx].ch = "x"                                            # FORBIDDEN
# There is no field write on a cell anywhere in this file.
#
# COLOUR ENCODING (the multiplexer decodes this — keep it stable):
#   -1                            default / unset
#   0..15                         the 16 ANSI colours (30-37/90-97 fg,
#                                 40-47/100-107 bg)
#   0..255                        a 256-colour palette index, as written by
#                                 `38;5;n` / `48;5;n` (so 0..15 is the same
#                                 number by either route, which is correct —
#                                 the palette's first 16 entries ARE the
#                                 ANSI colours)
#   0x1000000 + (r<<16)+(g<<8)+b  truecolor from `38;2;r;g;b` / `48;2;...`.
#                                 Test with `v >= TRUECOLOR_FLAG`; channels
#                                 are `(v >> 16) & 255`, `(v >> 8) & 255`,
#                                 `v & 255`.
#
# ATTRIBUTE BITFIELD: 1 bold, 2 dim, 4 underline, 8 reverse.
#
# HANDLED
#   printable text (UTF-8 aware via `text.chars()` — never hand-rolled)
#   C0: \n \r \t \b, BEL (ignored). Note that \n is a pure INDEX, exactly as
#       a real VT does it: it moves down one row and leaves the column where
#       it was. A pty delivers \r\n (ONLCR), so panes get the line start they
#       expect; a caller feeding a bare \n and expecting column 0 is the one
#       that is wrong.
#   deferred wrap at the right margin (a glyph in the last column does not
#   move the cursor to the next row until the NEXT glyph arrives — this is
#   what stops an exactly-`cols`-wide line followed by \n from producing a
#   spurious blank line)
#   CSI A B C D (cursor up/down/forward/back), G (column absolute),
#       d (line absolute), H and f (absolute position),
#       J (erase in display 0/1/2/3), K (erase in line 0/1/2),
#       m (SGR: 0 reset, 1 bold, 2 dim, 4 underline, 7 reverse, 22/24/27
#          clears, 30-37/39/90-97 fg, 40-47/49/100-107 bg, 38/48 with
#          `5;n` and `2;r;g;b`),
#       r (set scroll region)
#   ESC D (index), ESC M (reverse index), ESC E (next line)
#   OSC 0 and OSC 2 title set, terminated by BEL or ST (ESC \)
#
# CONSUMED AND IGNORED (counted in `unknown_seqs`, never printed as garbage)
#   DEC private modes (`CSI ? ... h/l` and every other private-prefix CSI),
#   alternate charset selection (ESC ( ) * + # %), ESC 7 / ESC 8,
#   sixel, mouse reporting, and every CSI final byte not listed above
#   (L M P @ S T X s u ...), plus any OSC other than 0/2.
#   A malformed sequence (a byte that is neither a parameter/intermediate
#   nor a final byte) aborts the sequence, counts one unknown, and the
#   offending byte is reprocessed as ordinary input rather than swallowing
#   the rest of the stream.
#
# SPLIT SEQUENCES
#   A pty read can land mid-escape. `TermScreen.pending` carries the
#   incomplete tail; `term_feed` parses `pending + bytes`, so
#   `feed("\x1b[") + feed("31m")` is identical to `feed("\x1b[31m")`.
#   `pending` is capped at `MAX_PENDING` chars: a stray ESC followed by
#   megabytes of text must not buffer without bound, so an over-long
#   partial sequence is discarded and counted as one unknown.

pub struct TermCell:
    ch: text
    fg: i64
    bg: i64
    attrs: i64

pub struct TermScreen:
    cols: i64
    rows: i64
    cells: [TermCell]
    cur_col: i64
    cur_row: i64
    title: text
    unknown_seqs: i64
    pending: text
    cur_fg: i64
    cur_bg: i64
    cur_attrs: i64
    scroll_top: i64
    scroll_bot: i64
    wrap_pending: bool

val ATTR_BOLD: i64 = 1
val ATTR_DIM: i64 = 2
val ATTR_UNDERLINE: i64 = 4
val ATTR_REVERSE: i64 = 8
val TRUECOLOR_FLAG: i64 = 16777216
val MAX_PENDING: i64 = 256


fn blank_cell() -> TermCell:
    return TermCell(ch: "", fg: -1, bg: -1, attrs: 0)


fn copy_cells(src: [TermCell]) -> [TermCell]:
    var out: [TermCell] = []
    var i = 0
    val n = src.len()
    while i < n:
        out.push(src[i])
        i = i + 1
    return out


fn is_digit_code(c: i64) -> bool:
    return c >= 48 and c <= 57


fn clamp(v: i64, lo: i64, hi: i64) -> i64:
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v


fn attr_set(attrs: i64, bit: i64) -> i64:
    if (attrs / bit) % 2 == 0:
        return attrs + bit
    return attrs


fn attr_clear(attrs: i64, bit: i64) -> i64:
    if (attrs / bit) % 2 == 1:
        return attrs - bit
    return attrs


# Split a CSI parameter string on ';'. An absent/empty parameter becomes -1
# so each consumer can apply its own default (1 for cursor motion, 0 for
# SGR and the erase operations).
fn parse_params(p: text) -> [i64]:
    var out: [i64] = []
    if p.len() == 0:
        return out
    val cs = p.chars()
    val n = cs.len()
    var i = 0
    var cur = -1
    while i < n:
        val c = cs[i].char_code_at(0)
        if is_digit_code(c):
            if cur < 0:
                cur = 0
            cur = cur * 10 + (c - 48)
        elif c == 59:
            out.push(cur)
            cur = -1
        else:
            # A colon-separated sub-parameter (ITU T.416 style) or any other
            # stray byte: not supported, treat the parameter as absent.
            cur = -1
        i = i + 1
    out.push(cur)
    return out


fn param_at(ps: [i64], idx: i64, dflt: i64) -> i64:
    if idx < 0 or idx >= ps.len():
        return dflt
    val v = ps[idx]
    if v < 0:
        return dflt
    return v


# ---------------------------------------------------------------------------
# Grid mutation helpers.
#
# Each one takes the PRIVATE working screen built by `term_feed`/`term_resize`
# and RETURNS it — see hazard 1 in the header. Never call one for effect.
# ---------------------------------------------------------------------------

fn scroll_region_up(w: TermScreen) -> TermScreen:
    val top = w.scroll_top
    val bot = w.scroll_bot
    if bot <= top:
        return w
    var r = top
    while r < bot:
        var c = 0
        while c < w.cols:
            w.cells[r * w.cols + c] = w.cells[(r + 1) * w.cols + c]
            c = c + 1
        r = r + 1
    var c2 = 0
    while c2 < w.cols:
        w.cells[bot * w.cols + c2] = blank_cell()
        c2 = c2 + 1
    return w


fn scroll_region_down(w: TermScreen) -> TermScreen:
    val top = w.scroll_top
    val bot = w.scroll_bot
    if bot <= top:
        return w
    var r = bot
    while r > top:
        var c = 0
        while c < w.cols:
            w.cells[r * w.cols + c] = w.cells[(r - 1) * w.cols + c]
            c = c + 1
        r = r - 1
    var c2 = 0
    while c2 < w.cols:
        w.cells[top * w.cols + c2] = blank_cell()
        c2 = c2 + 1
    return w


fn line_feed(w: TermScreen) -> TermScreen:
    var o = w
    o.wrap_pending = false
    if o.cur_row >= o.scroll_bot:
        o.cur_row = o.scroll_bot
        o = scroll_region_up(o)
    else:
        o.cur_row = o.cur_row + 1
        if o.cur_row >= o.rows:
            o.cur_row = o.rows - 1
    return o


fn reverse_index(w: TermScreen) -> TermScreen:
    var o = w
    o.wrap_pending = false
    if o.cur_row <= o.scroll_top:
        o.cur_row = o.scroll_top
        o = scroll_region_down(o)
    else:
        o.cur_row = o.cur_row - 1
    return o


fn put_glyph(w: TermScreen, g: text) -> TermScreen:
    var o = w
    if o.wrap_pending:
        o.cur_col = 0
        o = line_feed(o)
    o.cur_row = clamp(o.cur_row, 0, o.rows - 1)
    o.cur_col = clamp(o.cur_col, 0, o.cols - 1)
    val idx = o.cur_row * o.cols + o.cur_col
    if idx >= 0 and idx < o.cells.len():
        o.cells[idx] = TermCell(
            ch: g, fg: o.cur_fg, bg: o.cur_bg, attrs: o.cur_attrs
        )
    o.cur_col = o.cur_col + 1
    if o.cur_col >= o.cols:
        o.cur_col = o.cols - 1
        o.wrap_pending = true
    return o


fn erase_span(w: TermScreen, first: i64, last: i64) -> TermScreen:
    var i = first
    if i < 0:
        i = 0
    var stop = last
    if stop >= w.cells.len():
        stop = w.cells.len() - 1
    while i <= stop:
        w.cells[i] = blank_cell()
        i = i + 1
    return w


fn erase_in_line(w: TermScreen, mode: i64) -> TermScreen:
    var o = w
    o.wrap_pending = false
    val base = o.cur_row * o.cols
    if mode == 1:
        o = erase_span(o, base, base + o.cur_col)
    elif mode == 2:
        o = erase_span(o, base, base + o.cols - 1)
    else:
        o = erase_span(o, base + o.cur_col, base + o.cols - 1)
    return o


fn erase_in_display(w: TermScreen, mode: i64) -> TermScreen:
    var o = w
    o.wrap_pending = false
    val here = o.cur_row * o.cols + o.cur_col
    if mode == 1:
        o = erase_span(o, 0, here)
    elif mode == 2 or mode == 3:
        o = erase_span(o, 0, o.cells.len() - 1)
    else:
        o = erase_span(o, here, o.cells.len() - 1)
    return o


# Decode an extended-colour argument that starts at `idx` (the 38/48 itself).
# Returns `[consumed_extra_params, colour]`; `consumed_extra_params < 0` means
# the tail was malformed and the colour must be left untouched.
fn extended_color(ps: [i64], idx: i64) -> [i64]:
    val kind = param_at(ps, idx + 1, -1)
    if kind == 5:
        val n = param_at(ps, idx + 2, -1)
        if n < 0 or n > 255:
            return [-1, -1]
        return [2, n]
    if kind == 2:
        val r = param_at(ps, idx + 2, -1)
        val g = param_at(ps, idx + 3, -1)
        val b = param_at(ps, idx + 4, -1)
        if r < 0 or r > 255 or g < 0 or g > 255 or b < 0 or b > 255:
            return [-1, -1]
        return [4, TRUECOLOR_FLAG + r * 65536 + g * 256 + b]
    return [-1, -1]


fn apply_sgr(w: TermScreen, params: text) -> TermScreen:
    var o = w
    var ps = parse_params(params)
    if ps.len() == 0:
        ps = [0]
    var i = 0
    while i < ps.len():
        val p = param_at(ps, i, 0)
        if p == 0:
            o.cur_fg = -1
            o.cur_bg = -1
            o.cur_attrs = 0
        elif p == 1:
            o.cur_attrs = attr_set(o.cur_attrs, ATTR_BOLD)
        elif p == 2:
            o.cur_attrs = attr_set(o.cur_attrs, ATTR_DIM)
        elif p == 4:
            o.cur_attrs = attr_set(o.cur_attrs, ATTR_UNDERLINE)
        elif p == 7:
            o.cur_attrs = attr_set(o.cur_attrs, ATTR_REVERSE)
        elif p == 21 or p == 22:
            o.cur_attrs = attr_clear(o.cur_attrs, ATTR_BOLD)
            o.cur_attrs = attr_clear(o.cur_attrs, ATTR_DIM)
        elif p == 24:
            o.cur_attrs = attr_clear(o.cur_attrs, ATTR_UNDERLINE)
        elif p == 27:
            o.cur_attrs = attr_clear(o.cur_attrs, ATTR_REVERSE)
        elif p >= 30 and p <= 37:
            o.cur_fg = p - 30
        elif p == 39:
            o.cur_fg = -1
        elif p >= 40 and p <= 47:
            o.cur_bg = p - 40
        elif p == 49:
            o.cur_bg = -1
        elif p >= 90 and p <= 97:
            o.cur_fg = p - 90 + 8
        elif p >= 100 and p <= 107:
            o.cur_bg = p - 100 + 8
        elif p == 38 or p == 48:
            val got = extended_color(ps, i)
            if got[0] < 0:
                o.unknown_seqs = o.unknown_seqs + 1
                return o
            if p == 38:
                o.cur_fg = got[1]
            else:
                o.cur_bg = got[1]
            i = i + got[0]
        else:
            o.unknown_seqs = o.unknown_seqs + 1
        i = i + 1
    return o


fn apply_csi(w: TermScreen, params: text, final_ch: text) -> TermScreen:
    var o = w
    # Private-parameter prefixes (? < > =) are DEC private modes and friends:
    # out of scope by design, consumed and counted.
    if params.len() > 0:
        val p0 = params.char_code_at(0)
        if p0 == 63 or p0 == 60 or p0 == 62 or p0 == 61:
            o.unknown_seqs = o.unknown_seqs + 1
            return o
    val ps = parse_params(params)
    if final_ch == "A":
        o.wrap_pending = false
        o.cur_row = clamp(o.cur_row - param_at(ps, 0, 1), 0, o.rows - 1)
    elif final_ch == "B":
        o.wrap_pending = false
        o.cur_row = clamp(o.cur_row + param_at(ps, 0, 1), 0, o.rows - 1)
    elif final_ch == "C":
        o.wrap_pending = false
        o.cur_col = clamp(o.cur_col + param_at(ps, 0, 1), 0, o.cols - 1)
    elif final_ch == "D":
        o.wrap_pending = false
        o.cur_col = clamp(o.cur_col - param_at(ps, 0, 1), 0, o.cols - 1)
    elif final_ch == "G":
        o.wrap_pending = false
        o.cur_col = clamp(param_at(ps, 0, 1) - 1, 0, o.cols - 1)
    elif final_ch == "d":
        o.wrap_pending = false
        o.cur_row = clamp(param_at(ps, 0, 1) - 1, 0, o.rows - 1)
    elif final_ch == "H" or final_ch == "f":
        o.wrap_pending = false
        o.cur_row = clamp(param_at(ps, 0, 1) - 1, 0, o.rows - 1)
        o.cur_col = clamp(param_at(ps, 1, 1) - 1, 0, o.cols - 1)
    elif final_ch == "J":
        o = erase_in_display(o, param_at(ps, 0, 0))
    elif final_ch == "K":
        o = erase_in_line(o, param_at(ps, 0, 0))
    elif final_ch == "m":
        o = apply_sgr(o, params)
    elif final_ch == "r":
        val top = clamp(param_at(ps, 0, 1) - 1, 0, o.rows - 1)
        val bot = clamp(param_at(ps, 1, o.rows) - 1, 0, o.rows - 1)
        if bot > top:
            o.scroll_top = top
            o.scroll_bot = bot
        else:
            o.scroll_top = 0
            o.scroll_bot = o.rows - 1
        o.wrap_pending = false
        o.cur_row = o.scroll_top
        o.cur_col = 0
    else:
        o.unknown_seqs = o.unknown_seqs + 1
    return o


fn apply_osc(w: TermScreen, body: text) -> TermScreen:
    # `body` is everything between `ESC ]` and the terminator. Only OSC 0
    # (icon name + title) and OSC 2 (title) are honoured.
    var o = w
    val ps = body.chars()
    var i = 0
    var num = -1
    var scanning = true
    while i < ps.len() and scanning:
        val c = ps[i].char_code_at(0)
        if is_digit_code(c):
            if num < 0:
                num = 0
            num = num * 10 + (c - 48)
            i = i + 1
        else:
            scanning = false
    if i >= ps.len():
        o.unknown_seqs = o.unknown_seqs + 1
        return o
    if ps[i].char_code_at(0) != 59:
        o.unknown_seqs = o.unknown_seqs + 1
        return o
    if num != 0 and num != 2:
        o.unknown_seqs = o.unknown_seqs + 1
        return o
    var t = ""
    var j = i + 1
    while j < ps.len():
        t = t + ps[j]
        j = j + 1
    o.title = t
    return o


fn new_working_copy(s: TermScreen) -> TermScreen:
    return TermScreen(
        cols: s.cols,
        rows: s.rows,
        cells: copy_cells(s.cells),
        cur_col: s.cur_col,
        cur_row: s.cur_row,
        title: s.title,
        unknown_seqs: s.unknown_seqs,
        pending: "",
        cur_fg: s.cur_fg,
        cur_bg: s.cur_bg,
        cur_attrs: s.cur_attrs,
        scroll_top: s.scroll_top,
        scroll_bot: s.scroll_bot,
        wrap_pending: s.wrap_pending,
    )


# The unterminated tail starting at `i`, or "" when it exceeds MAX_PENDING
# (the caller counts that discard as one unknown sequence).
fn tail_text(cs: [text], i: i64, n: i64) -> text:
    if n - i > MAX_PENDING:
        return ""
    var t = ""
    var k = i
    while k < n:
        t = t + cs[k]
        k = k + 1
    return t


fn stash_pending(w: TermScreen, cs: [text], i: i64, n: i64) -> TermScreen:
    var o = w
    val t = tail_text(cs, i, n)
    if t.len() == 0:
        o.unknown_seqs = o.unknown_seqs + 1
    o.pending = t
    return o


# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

pub fn term_new(cols: i64, rows: i64) -> TermScreen:
    """Build a blank screen. Non-positive dimensions clamp to 1."""
    var c = cols
    var r = rows
    if c < 1:
        c = 1
    if r < 1:
        r = 1
    var cells: [TermCell] = []
    var i = 0
    val total = c * r
    while i < total:
        cells.push(blank_cell())
        i = i + 1
    return TermScreen(
        cols: c,
        rows: r,
        cells: cells,
        cur_col: 0,
        cur_row: 0,
        title: "",
        unknown_seqs: 0,
        pending: "",
        cur_fg: -1,
        cur_bg: -1,
        cur_attrs: 0,
        scroll_top: 0,
        scroll_bot: r - 1,
        wrap_pending: false,
    )


pub fn term_feed(s: TermScreen, bytes: text) -> TermScreen:
    """Feed a chunk of output and return a NEW screen; `s` is not modified."""
    var w = new_working_copy(s)
    val input = s.pending + bytes
    val cs = input.chars()
    val n = cs.len()
    var i = 0
    while i < n:
        val ch = cs[i]
        val code = ch.char_code_at(0)
        if code == 27:
            # ---- escape sequence -------------------------------------
            if i + 1 >= n:
                return stash_pending(w, cs, i, n)
            val nx = cs[i + 1]
            if nx == "[":
                var j = i + 2
                var params = ""
                var final_ch = ""
                var aborted = false
                var scanning = true
                while j < n and scanning:
                    val cc = cs[j].char_code_at(0)
                    if cc >= 32 and cc <= 63:
                        # parameter and intermediate bytes
                        params = params + cs[j]
                        j = j + 1
                    elif cc >= 64 and cc <= 126:
                        final_ch = cs[j]
                        j = j + 1
                        scanning = false
                    else:
                        aborted = true
                        scanning = false
                if aborted:
                    w.unknown_seqs = w.unknown_seqs + 1
                    i = j
                elif final_ch == "":
                    return stash_pending(w, cs, i, n)
                else:
                    w = apply_csi(w, params, final_ch)
                    i = j
            elif nx == "]":
                var j2 = i + 2
                var body = ""
                var done = false
                var osc_scan = true
                while j2 < n and osc_scan:
                    val cc2 = cs[j2].char_code_at(0)
                    if cc2 == 7:
                        j2 = j2 + 1
                        done = true
                        osc_scan = false
                    elif cc2 == 27:
                        if j2 + 1 < n and cs[j2 + 1] == "\\":
                            j2 = j2 + 2
                            done = true
                        osc_scan = false
                    else:
                        body = body + cs[j2]
                        j2 = j2 + 1
                if done:
                    w = apply_osc(w, body)
                    i = j2
                else:
                    return stash_pending(w, cs, i, n)
            elif nx == "D":
                w = line_feed(w)
                i = i + 2
            elif nx == "M":
                w = reverse_index(w)
                i = i + 2
            elif nx == "E":
                w.cur_col = 0
                w = line_feed(w)
                i = i + 2
            elif nx == "(" or nx == ")" or nx == "*" or nx == "+" or nx == "#" or nx == "%":
                # charset designation: out of scope, consume the selector too
                if i + 2 >= n:
                    return stash_pending(w, cs, i, n)
                w.unknown_seqs = w.unknown_seqs + 1
                i = i + 3
            else:
                w.unknown_seqs = w.unknown_seqs + 1
                i = i + 2
        elif code == 10:
            w = line_feed(w)
            i = i + 1
        elif code == 13:
            w.cur_col = 0
            w.wrap_pending = false
            i = i + 1
        elif code == 9:
            w.wrap_pending = false
            var nc = w.cur_col + 8 - (w.cur_col % 8)
            if nc > w.cols - 1:
                nc = w.cols - 1
            w.cur_col = nc
            i = i + 1
        elif code == 8:
            w.wrap_pending = false
            if w.cur_col > 0:
                w.cur_col = w.cur_col - 1
            i = i + 1
        elif code < 32 or code == 127:
            # BEL and every other unhandled C0 control: silently dropped.
            # These are not escape SEQUENCES, so they are not counted.
            i = i + 1
        else:
            w = put_glyph(w, ch)
            i = i + 1
    return w


pub fn term_resize(s: TermScreen, cols: i64, rows: i64) -> TermScreen:
    """Resize, preserving content anchored at the top-left corner.

    Cells inside the overlap of the old and new grids keep their glyph and
    styling; anything outside is dropped. Title, pending-sequence state,
    `unknown_seqs` and the current SGR state carry over. The cursor is
    clamped into the new grid and the scroll region is reset to the full
    screen (a region expressed in old-grid rows is meaningless afterwards).
    """
    var out = term_new(cols, rows)
    var r = 0
    while r < out.rows and r < s.rows:
        var c = 0
        while c < out.cols and c < s.cols:
            out.cells[r * out.cols + c] = s.cells[r * s.cols + c]
            c = c + 1
        r = r + 1
    out.cur_col = clamp(s.cur_col, 0, out.cols - 1)
    out.cur_row = clamp(s.cur_row, 0, out.rows - 1)
    out.title = s.title
    out.unknown_seqs = s.unknown_seqs
    out.pending = s.pending
    out.cur_fg = s.cur_fg
    out.cur_bg = s.cur_bg
    out.cur_attrs = s.cur_attrs
    out.wrap_pending = false
    return out


pub fn term_cell_at(s: TermScreen, col: i64, row: i64) -> TermCell:
    """Read one cell. Out-of-range coordinates read as a blank cell."""
    if col < 0 or row < 0 or col >= s.cols or row >= s.rows:
        return blank_cell()
    val idx = row * s.cols + col
    if idx < 0 or idx >= s.cells.len():
        return blank_cell()
    return s.cells[idx]


pub fn term_render_text(s: TermScreen) -> text:
    """Render the grid as plain text, rows joined by newlines.

    A blank cell renders as a space and trailing spaces are trimmed from each
    row, so a row's text is exactly what was written to it.
    """
    var out = ""
    var r = 0
    while r < s.rows:
        var line = ""
        var c = 0
        while c < s.cols:
            val cell = s.cells[r * s.cols + c]
            if cell.ch == "":
                line = line + " "
            else:
                line = line + cell.ch
            c = c + 1
        var end = line.len()
        while end > 0 and line.char_at(end - 1) == " ":
            end = end - 1
        if r > 0:
            out = out + "\n"
        out = out + line.substring(0, end)
        r = r + 1
    return out


export TermCell, TermScreen
export term_new, term_feed, term_resize, term_render_text, term_cell_at
export ATTR_BOLD, ATTR_DIM, ATTR_UNDERLINE, ATTR_REVERSE, TRUECOLOR_FLAG
