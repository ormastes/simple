# LSP JSON emitter.
#
# `std.report.emitter.lsp` was imported by three CLI query modules
# (`src/app/cli/query_check.spl`, `query_navigation.spl`, `query_commands.spl`)
# and never existed -- `find src/lib -type d -name report` returned nothing, so
# every `--format json` path in those modules died at module resolution with
#
#     error: semantic: Cannot resolve module: std.report.emitter.lsp
#
# See doc/08_tracking/bug/lsp_emitter_never_implemented_cli_query_2026-07-28.md
#
# Only `LspEmitter.default_emitter()` and `.encode_string()` are ever called, so
# only those exist here. `LspDiagnostic`/`LspTextEdit` were named in one import
# list but referenced nowhere; they are deliberately NOT invented.
#
# `encode_string` returns a COMPLETE JSON string literal, quotes included -- the
# call sites use it in value position (`,"code":{emitter.encode_string(code)}`).

use std.common.json.{json_escape_string}


class LspEmitter:
    """Emits LSP-shaped JSON fragments with RFC 8259-correct string escaping."""

    static fn default_emitter() -> LspEmitter:
        """The stateless default emitter used by every CLI query JSON path."""
        LspEmitter()

    me encode_string(value: text) -> text:
        """Encode `value` as a complete JSON string literal, quotes included."""
        "\"" + json_escape_string(value) + "\""
