# Common Markdown inline helpers.

use std.common.encoding.utf8.{utf8_seq_len}

# Marker byte values. Every inline marker is ASCII (< 0x80), and UTF-8 is
# self-synchronizing: continuation bytes are always >= 0x80, so a BYTE scan can
# never mistake part of a multi-byte character for a marker.
val MD_BACKSLASH: i64 = 92    # \
val MD_BACKTICK: i64 = 96     # `
val MD_STAR: i64 = 42         # *

# Single-pass inline scanner: handles **bold**, *italic*, `code`,
# escaped \*, and unbalanced markers (treated as literal text).
# Code spans protect their content from further interpretation.
#
# INDEX SPACE: this scanner is entirely BYTE-indexed. `value.len()`,
# `value.byte_at(i)` and `value.slice(a, b)` all count BYTES, so the loop
# bound, the marker probes and the interior slices agree. It previously mixed
# spaces -- `char_at` is CHARACTER-indexed while `len()`/`slice()` are
# BYTE-indexed -- so any multi-byte character desynced the two: on input
# "\u{e9}*x*" (5 bytes, 4 characters) the italic interior was taken as bytes
# 2..3 ("*") instead of the character "x", and the len()-bounded loop then ran
# one index past the last character and appended a nil. Pure ASCII was correct
# by accident because there byte index == character index.
fn markdown_inline_text(value: text) -> text:
    if value.len() == 0:
        return ""
    var out = ""
    var i = 0
    val n = value.len()
    while i < n:
        val cb = value.byte_at(i)
        # Escaped character: backslash before * or `
        if cb == MD_BACKSLASH and i + 1 < n:
            val nb = value.byte_at(i + 1)
            if nb == MD_STAR or nb == MD_BACKTICK or nb == MD_BACKSLASH:
                out = out + value.slice(i + 1, i + 2)
                i = i + 2
            else:
                out = out + value.slice(i, i + 1)
                i = i + 1
        # Code span: find closing backtick, protect interior
        elif cb == MD_BACKTICK:
            var j = i + 1
            var found_close = false
            while j < n:
                if value.byte_at(j) == MD_BACKTICK:
                    found_close = true
                    break
                j = j + 1
            if found_close:
                val interior = value.slice(i + 1, j)
                out = out + "<code>" + interior + "</code>"
                i = j + 1
            else:
                # Unbalanced backtick — emit as literal
                out = out + value.slice(i, i + 1)
                i = i + 1
        # Bold: **text**
        elif cb == MD_STAR and i + 1 < n and value.byte_at(i + 1) == MD_STAR:
            var j = i + 2
            var found_close = false
            while j + 1 < n:
                if value.byte_at(j) == MD_STAR and value.byte_at(j + 1) == MD_STAR:
                    found_close = true
                    break
                j = j + 1
            if found_close:
                val interior = value.slice(i + 2, j)
                out = out + "<strong>" + interior + "</strong>"
                i = j + 2
            else:
                # Unbalanced ** — emit as literal
                out = out + "**"
                i = i + 2
        # Italic: *text*
        elif cb == MD_STAR:
            var j = i + 1
            var found_close = false
            while j < n:
                if value.byte_at(j) == MD_STAR:
                    found_close = true
                    break
                j = j + 1
            if found_close:
                val interior = value.slice(i + 1, j)
                out = out + "<em>" + interior + "</em>"
                i = j + 1
            else:
                # Unbalanced * — emit as literal
                out = out + value.slice(i, i + 1)
                i = i + 1
        else:
            # Literal text: advance by the WHOLE UTF-8 sequence so a
            # multi-byte character is copied intact and never split.
            val seq = utf8_seq_len(cb)
            var e = i + (if seq > 0: seq else: 1)
            if e > n:
                e = n
            out = out + value.slice(i, e)
            i = e
    out

# Escape HTML special characters including quote chars for attribute-context safety.
fn markdown_escape_html(value: text) -> text:
    if value.len() == 0:
        return ""
    var out = value.replace("&", "&amp;")
    out = out.replace("<", "&lt;")
    out = out.replace(">", "&gt;")
    out = out.replace("\"", "&quot;")
    out.replace("'", "&#39;")

# Strip inline markers to produce plain text (for TOC, alt-text, etc.).
# Uses the single-pass scanner so code spans protect their content.
#
# INDEX SPACE: BYTE-indexed throughout, for the same reason as
# `markdown_inline_text` above.
fn markdown_plain_inline(value: text) -> text:
    if value.len() == 0:
        return ""
    var out = ""
    var i = 0
    val n = value.len()
    while i < n:
        val cb = value.byte_at(i)
        # Escaped marker: skip the backslash, keep the char
        if cb == MD_BACKSLASH and i + 1 < n:
            val nb = value.byte_at(i + 1)
            if nb == MD_STAR or nb == MD_BACKTICK or nb == MD_BACKSLASH:
                out = out + value.slice(i + 1, i + 2)
                i = i + 2
            else:
                out = out + value.slice(i, i + 1)
                i = i + 1
        # Code span: keep interior, skip backticks
        elif cb == MD_BACKTICK:
            var j = i + 1
            var found_close = false
            while j < n:
                if value.byte_at(j) == MD_BACKTICK:
                    found_close = true
                    break
                j = j + 1
            if found_close:
                out = out + value.slice(i + 1, j)
                i = j + 1
            else:
                # Unbalanced — drop the lone backtick
                i = i + 1
        # Bold **
        elif cb == MD_STAR and i + 1 < n and value.byte_at(i + 1) == MD_STAR:
            var j = i + 2
            var found_close = false
            while j + 1 < n:
                if value.byte_at(j) == MD_STAR and value.byte_at(j + 1) == MD_STAR:
                    found_close = true
                    break
                j = j + 1
            if found_close:
                out = out + value.slice(i + 2, j)
                i = j + 2
            else:
                # Unbalanced — drop the **
                i = i + 2
        # Italic *
        elif cb == MD_STAR:
            var j = i + 1
            var found_close = false
            while j < n:
                if value.byte_at(j) == MD_STAR:
                    found_close = true
                    break
                j = j + 1
            if found_close:
                out = out + value.slice(i + 1, j)
                i = j + 1
            else:
                # Unbalanced — drop the lone *
                i = i + 1
        else:
            # Literal text: advance by the WHOLE UTF-8 sequence.
            val seq = utf8_seq_len(cb)
            var e = i + (if seq > 0: seq else: 1)
            if e > n:
                e = n
            out = out + value.slice(i, e)
            i = e
    out
