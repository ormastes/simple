# CSS table grid resolution — common.layout.table_grid
#
# WHY THIS MODULE EXISTS
#
# Tables are blocker 7 of doc/03_plan/ui/rendering/blink_wiring_plan.md. The
# live browser lane's `gc_async_mut/gpu/browser_engine/layout_table.spl` is
# almost entirely DOM plumbing — `_find_table_node`, `_collect_table_rows`,
# `_collect_cells`, `_get_colspan` all walk `BeDomNode` — with one small piece
# of real geometry in `_compute_col_widths` (`total_w / num_cols`, i.e. equal
# columns, ignoring content). blink cannot import that lane (it is a LEAF:
# `blink`, `skia`, `common` only), and the DOM half is not what blink needs
# anyway.
#
# So this module is the GEOMETRY half, DOM-free: given each cell's grid
# position, span, and intrinsic min/max widths, resolve column widths, row
# heights, and every cell's rectangle. The caller — blink's
# `layout/table_flow.spl`, or the live lane if it is ever re-pointed — supplies
# the cell list from whatever tree it has.
#
# It is a strict improvement on the live lane's equal-column division: the
# auto algorithm below distributes by content (CSS 2.1 §17.5.2's
# min/max-content guidance), so a table of "a" and "a very long cell" no longer
# gives both halves the same width. `fixed_layout: true` reproduces the equal
# division for `table-layout: fixed` where it IS the right answer.
#
# WHAT IS NOT MODELLED — stated rather than silently approximated:
#   - ROWSPAN. `TableCellSpec` carries `rowspan` and `cell_rect` honours it
#     when computing a cell's HEIGHT, but a spanning cell's content height is
#     NOT redistributed back into the rows it crosses, so a tall rowspan cell
#     can overflow its last row. Colspan IS fully handled in width resolution.
#   - `border-collapse: collapse`. Only the `separate` model is implemented;
#     `border_spacing` is the separate model's gap. A collapsed table needs
#     per-edge border conflict resolution, which is a different algorithm.
#   - Percentage and explicit column widths, `<col>` elements, captions,
#     column groups, and vertical-align within a cell.
#   - Automatic table width from the container: `available_width` is used as
#     given and the table always fills it when the columns are narrower.

struct TableCellSpec:
    """One cell's grid placement and its intrinsic sizes, all in CSS pixels.

    `min_width` is the cell's minimum content width (the widest unbreakable
    word); `max_width` is its preferred width (the whole content on one line).
    `content_height` is how tall the cell's content is once laid out at the
    width it ends up with — the caller measures it, because measurement needs
    a font this module has no business knowing about."""
    row: i64
    col: i64
    colspan: i64
    rowspan: i64
    min_width: f64
    max_width: f64
    content_height: f64

pub fn table_cell(row: i64, col: i64, min_width: f64, max_width: f64, content_height: f64) -> TableCellSpec:
    """A 1x1 cell at (row, col) with the given intrinsic sizes."""
    TableCellSpec(
        row: row, col: col, colspan: 1, rowspan: 1,
        min_width: min_width, max_width: max_width, content_height: content_height
    )

pub fn table_cell_spanning(
    row: i64, col: i64, colspan: i64, rowspan: i64,
    min_width: f64, max_width: f64, content_height: f64
) -> TableCellSpec:
    """A cell that spans `colspan` columns and `rowspan` rows."""
    TableCellSpec(
        row: row, col: col, colspan: colspan, rowspan: rowspan,
        min_width: min_width, max_width: max_width, content_height: content_height
    )

struct TableGrid:
    """A resolved table: column widths, row heights, and their origins.

    `col_x[c]` is the left edge of column `c` and `row_y[r]` the top edge of
    row `r`, both relative to the table's content box origin and both already
    including `border_spacing`. `width`/`height` are the table's content box."""
    col_widths: [f64]
    row_heights: [f64]
    col_x: [f64]
    row_y: [f64]
    width: f64
    height: f64

# --------------------------------------------------------------------------
# Intrinsic column sizes
# --------------------------------------------------------------------------

fn _blank_widths(n: i64) -> [f64]:
    var out: [f64] = []
    var i: i64 = 0
    while i < n:
        out.push(0.0)
        i = i + 1
    out

pub fn column_min_widths(cells: [TableCellSpec], num_cols: i64) -> [f64]:
    """Per-column minimum content width.

    A cell contributes its whole `min_width` to a single column. A cell that
    SPANS columns contributes nothing directly — CSS 2.1 §17.5.2.2 gives
    spanning cells the lowest priority and this module resolves their demand
    later, in `resolve_table_grid`, only if the columns they cross are together
    too narrow."""
    var mins = _blank_widths(num_cols)
    var i: i64 = 0
    while i < cells.len():
        val c = cells[i as i32]
        if c.colspan <= 1 and c.col >= 0 and c.col < num_cols:
            if c.min_width > mins[c.col as i32]:
                mins[c.col as i32] = c.min_width
        i = i + 1
    mins

pub fn column_max_widths(cells: [TableCellSpec], num_cols: i64) -> [f64]:
    """Per-column preferred (maximum content) width, same spanning rule."""
    var maxs = _blank_widths(num_cols)
    var i: i64 = 0
    while i < cells.len():
        val c = cells[i as i32]
        if c.colspan <= 1 and c.col >= 0 and c.col < num_cols:
            if c.max_width > maxs[c.col as i32]:
                maxs[c.col as i32] = c.max_width
        i = i + 1
    maxs

fn _sum(xs: [f64]) -> f64:
    var t: f64 = 0.0
    var i: i64 = 0
    while i < xs.len():
        t = t + xs[i as i32]
        i = i + 1
    t

# --------------------------------------------------------------------------
# The resolver
# --------------------------------------------------------------------------

pub fn resolve_table_grid(
    cells: [TableCellSpec],
    num_cols: i64,
    num_rows: i64,
    available_width: f64,
    border_spacing: f64,
    fixed_layout: bool
) -> TableGrid:
    """Resolve a table's column widths, row heights and cell origins.

    `border_spacing` is the separate-borders gap, applied between every pair of
    adjacent columns AND rows and also once at each outer edge, so `n` columns
    consume `(n + 1) * border_spacing` of horizontal space in gaps. The width
    left over after the gaps is what the columns divide.

    FIXED layout divides that leftover equally — the live lane's behaviour, and
    the right answer for `table-layout: fixed`.

    AUTO layout follows CSS 2.1 §17.5.2.2 in the two cases that matter:
      - When the preferred widths all fit, every column gets its preferred
        width and any SURPLUS is shared out equally, so the table still fills
        `available_width`.
      - When they do not fit, every column starts at its minimum and the
        remaining space is shared in proportion to how much more each column
        WANTS (`max - min`), which is what keeps a long cell wider than a short
        one instead of the live lane's equal split.
      - When even the minimums do not fit, the minimums are used and the table
        overflows, rather than being shrunk below its content's minimum."""
    val gaps_w = border_spacing * ((num_cols + 1) as f64)
    var usable = available_width - gaps_w
    if usable < 0.0:
        usable = 0.0

    var widths = _blank_widths(num_cols)
    if num_cols > 0:
        if fixed_layout:
            val each = usable / (num_cols as f64)
            var i: i64 = 0
            while i < num_cols:
                widths[i as i32] = each
                i = i + 1
        else:
            val mins = column_min_widths(cells, num_cols)
            val maxs = column_max_widths(cells, num_cols)
            val total_min = _sum(mins)
            val total_max = _sum(maxs)
            if total_max <= usable:
                # Everything fits: preferred widths, surplus shared equally.
                val surplus = (usable - total_max) / (num_cols as f64)
                var i: i64 = 0
                while i < num_cols:
                    widths[i as i32] = maxs[i as i32] + surplus
                    i = i + 1
            else:
                if total_min >= usable:
                    # Not even the minimums fit — use them and overflow.
                    var i2: i64 = 0
                    while i2 < num_cols:
                        widths[i2 as i32] = mins[i2 as i32]
                        i2 = i2 + 1
                else:
                    # Between the two: share by unsatisfied demand.
                    val demand = total_max - total_min
                    val spare = usable - total_min
                    var i3: i64 = 0
                    while i3 < num_cols:
                        val want = maxs[i3 as i32] - mins[i3 as i32]
                        val share = if demand > 0.0: spare * (want / demand) else: 0.0
                        widths[i3 as i32] = mins[i3 as i32] + share
                        i3 = i3 + 1

            # Spanning cells get the last word: if the columns a spanning cell
            # crosses (plus the gaps between them) are together narrower than
            # its own minimum, widen them equally until they are not.
            var s: i64 = 0
            while s < cells.len():
                val c = cells[s as i32]
                if c.colspan > 1 and c.col >= 0 and c.col + c.colspan <= num_cols:
                    var span_w = border_spacing * ((c.colspan - 1) as f64)
                    var k: i64 = 0
                    while k < c.colspan:
                        span_w = span_w + widths[(c.col + k) as i32]
                        k = k + 1
                    if span_w < c.min_width:
                        val add = (c.min_width - span_w) / (c.colspan as f64)
                        var k2: i64 = 0
                        while k2 < c.colspan:
                            widths[(c.col + k2) as i32] = widths[(c.col + k2) as i32] + add
                            k2 = k2 + 1
                s = s + 1

    # Row heights: the tallest 1-row cell in each row. Rowspan cells are not
    # redistributed (documented gap at the top of this file).
    var heights = _blank_widths(num_rows)
    var j: i64 = 0
    while j < cells.len():
        val c = cells[j as i32]
        if c.rowspan <= 1 and c.row >= 0 and c.row < num_rows:
            if c.content_height > heights[c.row as i32]:
                heights[c.row as i32] = c.content_height
        j = j + 1

    # Origins, gap-first: column 0 starts one `border_spacing` in.
    var col_x: [f64] = []
    var x = border_spacing
    var ci: i64 = 0
    while ci < num_cols:
        col_x.push(x)
        x = x + widths[ci as i32] + border_spacing
        ci = ci + 1

    var row_y: [f64] = []
    var y = border_spacing
    var ri: i64 = 0
    while ri < num_rows:
        row_y.push(y)
        y = y + heights[ri as i32] + border_spacing
        ri = ri + 1

    TableGrid(
        col_widths: widths,
        row_heights: heights,
        col_x: col_x,
        row_y: row_y,
        width: x,
        height: y
    )

impl TableGrid:
    fn cell_x(col: i64) -> f64:
        """Left edge of a column, or `0.0` when out of range."""
        if col < 0 or col >= self.col_x.len():
            return 0.0
        self.col_x[col as i32]

    fn cell_y(row: i64) -> f64:
        """Top edge of a row, or `0.0` when out of range."""
        if row < 0 or row >= self.row_y.len():
            return 0.0
        self.row_y[row as i32]

    fn cell_width(col: i64, colspan: i64) -> f64:
        """Width of a cell, including the `border_spacing` it swallows when it
        spans more than one column."""
        var w: f64 = 0.0
        var k: i64 = 0
        while k < colspan:
            val c = col + k
            if c >= 0 and c < self.col_widths.len():
                w = w + self.col_widths[c as i32]
                if k > 0 and c > 0:
                    # The gap between column c-1 and c is inside this cell.
                    w = w + (self.col_x[c as i32] - (self.col_x[(c - 1) as i32] + self.col_widths[(c - 1) as i32]))
            k = k + 1
        w

    fn cell_height(row: i64, rowspan: i64) -> f64:
        """Height of a cell, including the spacing it swallows across rows."""
        var h: f64 = 0.0
        var k: i64 = 0
        while k < rowspan:
            val r = row + k
            if r >= 0 and r < self.row_heights.len():
                h = h + self.row_heights[r as i32]
                if k > 0 and r > 0:
                    h = h + (self.row_y[r as i32] - (self.row_y[(r - 1) as i32] + self.row_heights[(r - 1) as i32]))
            k = k + 1
        h
