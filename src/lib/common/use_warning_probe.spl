# Fixture module for scripts/check/check-use-warning-oracle-deployed.shs.
#
# This module exists ONLY to be imported by that check. It is deliberately tiny
# and has no callers in the product. Do not add real functionality here, and do
# not delete it — the check fails closed without it.
#
# It must sit under a real module root (`src/lib`, reached as `src/std`) because
# the `[use-warning]` oracle only runs on library-path module resolution. A
# fixture in a temp directory resolves through the relative-file path instead,
# which never calls `collect_provided_names`, so the probe would silently
# measure nothing and the check would pass vacuously.
#
# The two declarations below are the check's control surface:
#   - `uw_probe_extern_provided` is `extern fn`. The importer names it, and the
#     oracle must stay SILENT about it. `collect_provided_names` originally did
#     not fold in `Node::Extern`, so every module exposing a symbol this way was
#     wrongly reported as not exposing it.
#   - `uw_probe_plain_provided` is an ordinary `fn` and must also draw silence;
#     it is the control that stops an oracle which warns on everything from
#     passing the check's positive assertion.
#
# The third name the importer requests, `uw_probe_zzz_absent`, is intentionally
# absent from this file. Do not add it.

extern fn uw_probe_extern_provided(x: i64) -> i64

fn uw_probe_plain_provided() -> i64:
    return 1
