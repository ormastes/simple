pub fn pretty_print_indent(value: text, indent: i64) -> text:
    var result = ""
    var i = 0
    while i < indent:
        result = result + "  "
        i = i + 1
    result + value

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=untyped-param-arithmetic-lowers-to-tagged-Any-addition-in-frozen-stage2; see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
fn _pretty_items(items, open: text, close: text, indent: i64) -> text:
    if items.len() == 0:
        return open + close
    var result = open + "\n"
    var i = 0
    while i < items.len():
        result = result + pretty_print_indent(items[i].to_text(), indent + 1)
        if i + 1 < items.len():
            result = result + ","
        result = result + "\n"
        i = i + 1
    result + pretty_print_indent(close, indent)

