pub fn pretty_dict(items, indent: i64) -> text:
    if items.len() == 0:
        return "{}"
    var lines = []
    var i = 0
    while i < items.len():
        lines.push(items[i].0.to_text() + ": " + items[i].1.to_text())
        i = i + 1
    _pretty_items(lines, "{", "}", indent)

pub fn char_code_safe(ch) -> i64:
    if ch == "\t": return 9
    if ch == "\n": return 10
    if ch == "\r": return 13
    val chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    var i = 0
    while i < chars.len():
        if chars[i:i + 1] == ch:
            return i + 32
        i = i + 1
    0

pub fn char_from_code_safe(code) -> text:
    if code == 9: return "\t"
    if code == 10: return "\n"
    if code == 13: return "\r"
    val chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    if code >= 32 and code <= 126:
        return chars[code - 32:code - 31]
    ""

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=frozen-stage2-RTI-lowers-this-declared-return-to-Any-(E-RTI-007); see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn char_to_digit_safe(ch: text) -> i64:
    if ch == "0": return 0
    if ch == "1": return 1
    if ch == "2": return 2
    if ch == "3": return 3
    if ch == "4": return 4
    if ch == "5": return 5
    if ch == "6": return 6
    if ch == "7": return 7
    if ch == "8": return 8
    if ch == "9": return 9
    0

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn is_numeric_text(value: text):
    if value.len() == 0:
        return false
    var i = 0
    if value[0:1] == "-":
        if value.len() == 1:
            return false
        i = 1
    while i < value.len():
        val ch = value[i:i + 1]
        if char_code_safe(ch) < 48 or char_code_safe(ch) > 57:
            return false
        i = i + 1
    true

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn parse_int_safe(value: text) -> i64:
    if value.len() == 0:
        return 0
    var sign = 1
    var i = 0
    if value[0:1] == "-":
        if value.len() == 1:
            return 0
        sign = -1
        i = 1
    var result = 0
    var saw_digit = false
    while i < value.len():
        val ch = value[i:i + 1]
        val code = char_code_safe(ch)
        if code < 48 or code > 57:
            return result * sign
        saw_digit = true
        result = result * 10 + char_to_digit_safe(ch)
        i = i + 1
    if not saw_digit:
        return 0
    result * sign

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn detect_format(value: text):
    if value.len() == 0:
        return "unknown"
    val first = value[0:1]
    if first == "@":
        return "tagged"
    if first == "{" or first == "[" or first == "\"":
        return "sdn"
    if value == "true" or value == "false" or value == "nil":
        return "sdn"
    if is_numeric_text(value):
        return "sdn"
    "unknown"

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=frozen-stage2-RTI-lowers-this-declared-return-to-Any-(E-RTI-007); see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn is_valid_sdn(value: text) -> bool: detect_format(value) != "unknown"

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=frozen-stage2-RTI-lowers-this-declared-return-to-Any-(E-RTI-007); see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn tag_type(content: text, type_name: text) -> text: "@" + type_name + "{" + content + "}"

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn get_type_tag(value: text) -> text?:
    if value.len() < 3:
        return nil
    if value[0:1] != "@":
        return nil
    var i = 1
    while i < value.len():
        if value[i:i + 1] == "{":
            if i == 1:
                return nil
            return value.substring(1, i)
        i = i + 1
    nil

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn strip_type_tag(value: text) -> text:
    val tag = get_type_tag(value)
    if tag == nil:
        return value
    # @workaround bug=methods-mir-20261031 reason=optional-not-narrowed-after-nil-check-in-mir
    val tag_text: text = tag!
    val start = tag_text.len() + 2
    if start >= value.len():
        return value
    if value[value.len() - 1:value.len()] == "}":
        return value.substring(start, value.len() - 1)
    value.substring(start)

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=frozen-stage2-RTI-lowers-this-declared-return-to-Any-(E-RTI-007); see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn add_version(content: text, version: i64) -> text: "\{v: " + version.to_text() + ", data: " + content + "\}"

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn get_version(value: text) -> i64?:
    if not value.starts_with("{v: "):
        return nil
    val rest = value.substring(4)
    var i = 0
    while i < rest.len():
        if rest[i:i + 1] == ",":
            return parse_int_safe(rest.substring(0, i))
        i = i + 1
    nil

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn strip_version(value: text) -> text:
    if not value.starts_with("{v: "):
        return value
    var i = 0
    while i < value.len():
        if value[i:i + 1] == ",":
            val rest = value.substring(i + 1, value.len() - 1).trim()
            if rest.starts_with("data: "):
                return rest.substring(6)
            return value
        i = i + 1
    value

