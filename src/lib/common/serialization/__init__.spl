pub fn quote_string(value: text) -> text: "\"" + escape_string(value) + "\""

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn unquote_string(value: text) -> text:
    if value.len() >= 2 and value[0:1] == "\"" and value[value.len() - 1:value.len()] == "\"":
        return unescape_string(value.substring(1, value.len() - 1))
