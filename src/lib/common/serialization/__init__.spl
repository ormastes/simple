# @workaround bug=rti007_any_return_rows_2026-11-01 reason=untyped-param-arithmetic-lowers-to-tagged-Any-addition-in-frozen-stage2; see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
fn _join(items, open: text, close: text) -> text:
    var result = open
    var i = 0
    while i < items.len():
        if i > 0:
            result = result + ", "
        result = result + items[i].to_text()
        i = i + 1
    result + close

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=untyped-param-arithmetic-lowers-to-tagged-Any-addition-in-frozen-stage2; see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
fn _join_pairs(items, open: text, close: text) -> text:
    var result = open
    var i = 0
    while i < items.len():
        if i > 0:
            result = result + ", "
        result = result + items[i].0.to_text() + ": " + items[i].1.to_text()
        i = i + 1
    result + close

