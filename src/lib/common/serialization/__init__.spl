pub fn digit_to_hex(value: i64) -> text:
    if value == 0: return "0"
    if value == 1: return "1"
    if value == 2: return "2"
    if value == 3: return "3"
    if value == 4: return "4"
    if value == 5: return "5"
    if value == 6: return "6"
    if value == 7: return "7"
    if value == 8: return "8"
    if value == 9: return "9"
    if value == 10: return "a"
    if value == 11: return "b"
    if value == 12: return "c"
    if value == 13: return "d"
    if value == 14: return "e"
    if value == 15: return "f"
    "0"

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=frozen-stage2-RTI-lowers-this-declared-return-to-Any-(E-RTI-007); see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn hex_to_digit(ch: text) -> i64:
    if ch == "a" or ch == "A": return 10
    if ch == "b" or ch == "B": return 11
    if ch == "c" or ch == "C": return 12
    if ch == "d" or ch == "D": return 13
    if ch == "e" or ch == "E": return 14
    if ch == "f" or ch == "F": return 15
    char_to_digit_safe(ch)

