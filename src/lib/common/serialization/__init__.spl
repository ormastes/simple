pub fn define_schema(fields) -> text: serialize_dict(fields)

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn validate_field_type(value: text, kind: text) -> bool:
    if kind == "int": return is_numeric_text(value)
    if kind == "bool": return value == "true" or value == "false"
    if kind == "nil": return value == "nil"
    if kind == "text": return value.len() >= 2 and value[0:1] == "\"" and value[value.len() - 1:value.len()] == "\""
    if kind == "list": return value.len() >= 2 and value[0:1] == "[" and value[value.len() - 1:value.len()] == "]"
    if kind == "tuple": return value.len() >= 2 and value[0:1] == "(" and value[value.len() - 1:value.len()] == ")"
    if kind == "dict": return value.len() >= 2 and value[0:1] == "{" and value[value.len() - 1:value.len()] == "}"
    true

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn write_varint(value) -> [i64]:
    var out = []
    var n = value
    if n < 0:
        out.push(255)
        n = 0 - n
    while n >= 128:
        out.push((n % 128) + 128)
        n = n / 128
    out.push(n)
    out

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=untyped-param-arithmetic-lowers-to-tagged-Any-addition-in-frozen-stage2; see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn read_varint(data: [i64], offset: i64) -> (i64, i64):
    if offset < 0 or offset >= data.len():
        return (0, 0)
    var i = offset
    var sign = 1
    if i < data.len() and data[i] == 255:
        sign = -1
        i = i + 1
    var multiplier = 1
    var value = 0
    while i < data.len():
        val byte = data[i]
        if byte >= 128:
            value = value + ((byte - 128) * multiplier)
            multiplier = multiplier * 128
            i = i + 1
        else:
            value = value + (byte * multiplier)
            i = i + 1
            return (value * sign, i - offset)
    (value * sign, i - offset)

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=untyped-param-arithmetic-lowers-to-tagged-Any-addition-in-frozen-stage2; see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn read_bytes(data: [i64], offset: i64, count: i64) -> ([i64], i64):
    if offset < 0:
        return ([], count)
    var out = []
    var i = 0
    while i < count and offset + i < data.len():
        out.push(data[offset + i])
        i = i + 1
    (out, count)

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=frozen-stage2-RTI-lowers-this-declared-return-to-Any-(E-RTI-007); see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn write_bytes(data: [i64]) -> [i64]:
    var out = [data.len()]
    var i = 0
    while i < data.len():
        out.push(data[i])
        i = i + 1
    out

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=untyped-param-arithmetic-lowers-to-tagged-Any-addition-in-frozen-stage2; see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn read_bytes_with_length(data: [i64], offset: i64) -> ([i64], i64):
    if offset < 0 or offset >= data.len():
        return ([], 1)
    read_bytes(data, offset + 1, data[offset])

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=frozen-stage2-RTI-lowers-this-declared-return-to-Any-(E-RTI-007); see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn serialize_int_bytes(value: i64) -> [i64]:
    var out = [type_int()]
    val encoded = write_varint(value)
    var i = 0
    while i < encoded.len():
        out.push(encoded[i])
        i = i + 1
    out

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=frozen-stage2-RTI-lowers-this-declared-return-to-Any-(E-RTI-007); see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn serialize_bool_bytes(value: bool) -> [i64]: if value: [type_bool(), 1] else: [type_bool(), 0]
pub fn serialize_nil_bytes(): [type_nil()]

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn serialize_text_bytes(value: text) -> [i64]:
    var out = [type_text(), value.len()]
    var i = 0
    while i < value.len():
        out.push(char_code_safe(value[i:i + 1]))
        i = i + 1
    out

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=frozen-stage2-RTI-lowers-this-declared-return-to-Any-(E-RTI-007); see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn serialize_int_list_bytes(items: [i64]) -> [i64]:
    var out = [type_list(), items.len()]
    var i = 0
    while i < items.len():
        val encoded = write_varint(items[i])
        var j = 0
        while j < encoded.len():
            out.push(encoded[j])
            j = j + 1
        i = i + 1
    out

# @workaround bug=rti007_any_return_rows_2026-11-01 reason=frozen-stage2-RTI-lowers-this-declared-return-to-Any-(E-RTI-007); see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn serialize_text_list_bytes(items: [text]) -> [i64]:
    var out = [type_list(), items.len()]
    var i = 0
    while i < items.len():
        val encoded = serialize_text_bytes(items[i])
        var j = 1
        while j < encoded.len():
            out.push(encoded[j])
            j = j + 1
        i = i + 1
    out

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
# @workaround bug=rti007_any_return_rows_2026-11-01 reason=frozen-stage2-RTI-lowers-this-declared-return-to-Any-(E-RTI-007); see doc/08_tracking/bug/rti007_any_return_rows_2026-11-01.md
pub fn escape_string(value: text) -> text:
    # `value[i:i+1]` is byte-indexed: accumulating one raw byte at a time
    # (the old `result = result + ch`) shreds multi-byte UTF-8 characters
    # into separate U+FFFD replacement characters. The escaped bytes are
    # all single ASCII bytes, so byte-stepping to find them is safe; copy
    # whole runs via the slice expression between them instead of
    # rebuilding byte-by-byte.
    var result = ""
    var seg_start = 0
    var i = 0
    while i < value.len():
        val ch = value[i:i + 1]
        if ch == "\n":
            result = result + value[seg_start:i] + "\\n"
            seg_start = i + 1
        elif ch == "\t":
            result = result + value[seg_start:i] + "\\t"
            seg_start = i + 1
        elif ch == "\r":
            result = result + value[seg_start:i] + "\\r"
            seg_start = i + 1
        elif ch == "\\":
            result = result + value[seg_start:i] + "\\\\"
            seg_start = i + 1
        elif ch == "\"":
            result = result + value[seg_start:i] + "\\\""
            seg_start = i + 1
        i = i + 1
    result + value[seg_start:value.len()]

# @workaround bug=methods-mir-20261031 reason=untyped-param-recv-unresolved-in-mir
pub fn unescape_string(value: text):
    # See escape_string above for why byte-by-byte accumulation is unsafe.
    var result = ""
    var seg_start = 0
    var i = 0
    while i < value.len():
        val ch = value[i:i + 1]
        if ch == "\\" and i + 1 < value.len():
            result = result + value[seg_start:i]
            val next = value[i + 1:i + 2]
            if next == "n":
                result = result + "\n"
            elif next == "t":
                result = result + "\t"
            elif next == "r":
                result = result + "\r"
            elif next == "\\":
                result = result + "\\"
            elif next == "\"":
                result = result + "\""
            else:
                result = result + "\\" + next
            i = i + 2
            seg_start = i
        else:
            i = i + 1
    result + value[seg_start:value.len()]

