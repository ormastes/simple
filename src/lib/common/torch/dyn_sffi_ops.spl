    val result = rt_torch_torchtensor_inverse(handle)
    if result <= 0:
        return Err("runtime_returned_null_handle")
    Ok(result)

fn dyn_torch_tensor_linalg_solve_result(a: i64, b: i64) -> DynTorchTensorResult:
    """Solve Ax = b with explicit status for dynamic Torch callers."""
    if not rt_torch_available():
        return _dyn_torch_tensor_result("unavailable", "libtorch_unavailable", 0)
    if a <= 0 or b <= 0:
        return _dyn_torch_tensor_result("invalid", "invalid_handle", 0)
    val handle = rt_torch_torchtensor_linalg_solve(a, b)
    if handle <= 0:
        return _dyn_torch_tensor_result("error", "runtime_returned_null_handle", 0)
    _dyn_torch_tensor_result("ready", "ok", handle)

