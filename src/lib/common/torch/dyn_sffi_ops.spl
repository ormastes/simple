fn dyn_torch_tensor_eye_result(n: i64) -> Result<i64, text>:
    """Create an identity matrix with explicit provider failure."""
    if not rt_torch_available(): return Err("libtorch_unavailable")
    if n < 0: return Err("invalid_dimension")
    val result = rt_torch_torchtensor_eye(n)
    if result <= 0: return Err("runtime_returned_null_handle")
    Ok(result)

fn dyn_torch_tensor_arange_result(start: f64, end: f64, step: f64) -> Result<i64, text>:
    """Create a range tensor with explicit provider failure."""
    if not rt_torch_available(): return Err("libtorch_unavailable")
    if step == 0.0: return Err("invalid_step")
    val result = rt_torch_torchtensor_arange(start, end, step)
    if result <= 0: return Err("runtime_returned_null_handle")
    Ok(result)

