# ============================================================================
# Constructors — legacy fixed-dimension family (fail closed)
# ============================================================================
# The legacy (d0, d1, d2, d3, ndim[, fill]) constructor ABI claims symbol
# names the provider already owns with its array-form ABI and is not
# registered by any engine, so these wrappers keep their availability and
# dimension guards and then fail closed with a typed error instead of
# issuing an unbacked FFI call (see
# doc/08_tracking/bug/sffi_torch_dynamic_facade_lexical_owner_gap_2026-08-27).

fn dyn_torch_tensor_zeros_1d_result(n: i64) -> Result<i64, text>:
    if not dyn_torch_available(): return Err("libtorch_unavailable")
    if n < 0: return Err("invalid_dimension")
    Err("unbacked_provider_abi")

