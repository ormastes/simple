"""
Dynamic PyTorch SFFI — Operations

Runtime-optional libtorch dispatch. Unlike the static SFFI in
std.torch.sffi (which uses direct rt_torch_* externs), these functions
check availability via rt_torch_available() and fail gracefully when
libtorch is absent.

Consumed by:
  - std.nogc_async_mut.linalg.backend_ops
    (dyn_torch_available, dyn_torch_tensor_matmul_result,
     dyn_torch_tensor_dot_result, dyn_torch_tensor_sum_result,
     dyn_torch_tensor_inverse_result,
     dyn_torch_tensor_linalg_solve_result, dyn_torch_tensor_free)
  - All torch variant shims via std.common.torch.dyn_sffi
"""

use std.nogc_sync_mut.torch.sffi.{
    rt_torch_available, rt_torch_torchtensor_abs,
    rt_torch_torchtensor_add_scalar, rt_torch_torchtensor_argmax,
    rt_torch_torchtensor_argmin, rt_torch_torchtensor_clone,
    rt_torch_torchtensor_contiguous,
    rt_torch_torchtensor_dot, rt_torch_torchtensor_exp,
    rt_torch_torchtensor_free, rt_torch_torchtensor_gelu,
    rt_torch_torchtensor_inverse, rt_torch_torchtensor_leaky_relu,
    rt_torch_torchtensor_log, rt_torch_torchtensor_log_softmax,
    rt_torch_torchtensor_matmul,
    rt_torch_torchtensor_max_dim,
    rt_torch_torchtensor_mean_dim,
    rt_torch_torchtensor_min_dim, rt_torch_torchtensor_mul_scalar,
    rt_torch_torchtensor_neg,
    rt_torch_torchtensor_pow, rt_torch_torchtensor_relu,
    rt_torch_torchtensor_sigmoid, rt_torch_torchtensor_slice,
    rt_torch_torchtensor_softmax, rt_torch_torchtensor_sqrt,
    rt_torch_torchtensor_squeeze_dim,
    rt_torch_torchtensor_sum_dim,
    rt_torch_torchtensor_tanh, rt_torch_torchtensor_unsqueeze,
    torch_torchtensor_det_result, torch_torchtensor_max_result,
    torch_torchtensor_mean_result, torch_torchtensor_min_result,
    torch_torchtensor_norm_result, torch_torchtensor_std_result,
    torch_torchtensor_sum_result, torch_torchtensor_var_result
}

# ============================================================================
# Availability
# ============================================================================

struct DynTorchTensorResult:
    status: text
    reason: text
    handle: i64

fn _dyn_torch_tensor_result(status: text, reason: text, handle: i64) -> DynTorchTensorResult:
    DynTorchTensorResult(status: status, reason: reason, handle: handle)

fn dyn_torch_available() -> bool:
    """Return true if libtorch can be loaded at runtime."""
    rt_torch_available()

# ============================================================================
# Tensor lifecycle
# ============================================================================

fn dyn_torch_tensor_free(handle: i64):
    """Free a tensor returned by a dyn_torch_* function."""
    if rt_torch_available():
        rt_torch_torchtensor_free(handle)

fn dyn_torch_tensor_clone_result(handle: i64) -> Result<i64, text>:
    """Clone a tensor without collapsing provider errors into handle zero."""
    if not rt_torch_available():
        return Err("libtorch_unavailable")
    if handle <= 0:
        return Err("invalid_handle")
    val result = rt_torch_torchtensor_clone(handle)
    if result <= 0:
        return Err("runtime_returned_null_handle")
    Ok(result)

# ============================================================================
# Linear algebra
# ============================================================================

fn dyn_torch_tensor_matmul_result(a: i64, b: i64) -> Result<i64, text>:
    """Matrix multiply tensors without collapsing provider errors into zero."""
    if not rt_torch_available():
        return Err("libtorch_unavailable")
    if a <= 0 or b <= 0:
        return Err("invalid_handle")
    val result = rt_torch_torchtensor_matmul(a, b)
    if result <= 0:
        return Err("runtime_returned_null_handle")
    Ok(result)

fn dyn_torch_tensor_dot_result(a: i64, b: i64) -> Result<i64, text>:
    """Dot product without collapsing provider errors into handle zero."""
    if not rt_torch_available():
        return Err("libtorch_unavailable")
    if a <= 0 or b <= 0:
        return Err("invalid_handle")
    val result = rt_torch_torchtensor_dot(a, b)
    if result <= 0:
        return Err("runtime_returned_null_handle")
    Ok(result)

fn dyn_torch_tensor_sum_result(handle: i64) -> Result<f64, text>:
    """Sum all elements without collapsing failure into numeric zero."""
    if not rt_torch_available(): return Err("libtorch_unavailable")
    torch_torchtensor_sum_result(handle)

