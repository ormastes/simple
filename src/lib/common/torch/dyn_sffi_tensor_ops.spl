fn dyn_torch_tensor_permute_4d(handle: i64, d0: i64, d1: i64, d2: i64, d3: i64) -> i64:
    if not dyn_torch_available(): return 0
    rt_torch_torchtensor_permute_4d(handle, d0, d1, d2, d3)

