fn dyn_torch_tensor_reshape_1d_result(handle: i64, d0: i64) -> Result<i64, text>:
    if not dyn_torch_available(): return Err("libtorch_unavailable")
    if handle <= 0 or d0 < 0: return Err("invalid_reshape")
    val result = unsafe(capabilities: [ffi]):
        rt_torch_torchtensor_reshape_1d(handle, d0)
    if result <= 0: return Err("runtime_returned_null_handle")
    Ok(result)

