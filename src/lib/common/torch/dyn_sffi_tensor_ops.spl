# ============================================================================
# Binary ops / type conversion
# ============================================================================

@unsafe(reason: "raw Torch ABI; nonpositive handle sentinel is rejected by typed wrapper", capabilities: [ffi])
extern fn rt_torch_torchtensor_to_float(handle: i64) -> i64

fn dyn_torch_tensor_binary_op_result(a: i64, b: i64, op: i64) -> Result<i64, text>:
    if not dyn_torch_available(): return Err("libtorch_unavailable")
    if a <= 0 or b <= 0: return Err("invalid_handle")
    if op < 0 or op > 3: return Err("invalid_operation")
    var result = 0
    if op == 0:
        result = unsafe(capabilities: [ffi]):
            rt_torch_torchtensor_add(a, b)
    elif op == 1:
        result = unsafe(capabilities: [ffi]):
            rt_torch_torchtensor_sub(a, b)
    elif op == 2:
        result = unsafe(capabilities: [ffi]):
            rt_torch_torchtensor_mul(a, b)
    else:
        result = unsafe(capabilities: [ffi]):
            rt_torch_torchtensor_div(a, b)
    if result <= 0: return Err("runtime_returned_null_handle")
    Ok(result)

fn dyn_torch_tensor_to_float_result(handle: i64) -> Result<i64, text>:
    if not dyn_torch_available(): return Err("libtorch_unavailable")
    if handle <= 0: return Err("invalid_handle")
    val result = unsafe(capabilities: [ffi]):
        rt_torch_torchtensor_to_float(handle)
    if result <= 0: return Err("runtime_returned_null_handle")
    Ok(result)

