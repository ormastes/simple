# Shared OCI runtime-spec bundle codec (pure, no IO).
#
# Decodes a bundle's config.json and runs the shared bundle safety checks
# (std.common.oci.bundle_check_v1). Unknown fields are REJECTED rather than
# ignored: an ignored runtime field could be a dropped enforcement setting.
# Platform-specific fields (Linux namespaces, cgroups, seccomp, devices,
# capabilities, rlimits, hooks, ...) are decoded only as a recorded list, so
# the workload projection can refuse them for backends that cannot honour
# them instead of silently dropping them.
# Design: doc/05_design/simple_container_macos_seatbelt.md §16.5.4.

use std.common.json.value.{JsonValue, json_parse_value_strict, json_value_has, json_value_field,
    json_value_keys, json_value_type}
use std.common.oci.descriptor_v1.{OciLimitsV1, oci_digest_valid_v1, oci_env_valid_v1,
    oci_json_object_v1, oci_json_text_v1, oci_json_i64_v1, oci_json_bool_v1,
    oci_json_array_v1, oci_json_text_list_v1}
use std.common.oci.bundle_check_v1.{OciBundleMountV1, OciBundleCheckInputV1,
    OciBundleCheckPolicyV1, oci_bundle_check_v1}

pub struct OciRuntimeMountV1:
    source: text
    destination: text
    mount_type: text
    options: [text]

pub struct OciRuntimeConfigV1:
    oci_version: text
    args: [text]
    env: [text]
    cwd: text
    uid: i64
    gid: i64
    terminal: bool
    root_path: text
    root_readonly: bool
    mounts: [OciRuntimeMountV1]
    hooks_present: bool
    # Present fields whose semantics need a Linux kernel (namespaces, cgroups,
    # seccomp, capabilities, hostname/UTS, ...), as "linux.namespaces",
    # "process.capabilities", "hostname", ... in document order.
    linux_only_fields: [text]
    # Present non-Linux platform sections ("windows", "solaris", "vm", "zos").
    other_platform_sections: [text]

pub struct OciBundleV1:
    config: OciRuntimeConfigV1
    rootfs_path: text
    digest: text

val OCI_RUNTIME_TOP_KEYS_V1: [text] = ["ociVersion", "process", "root", "hostname", "domainname",
    "mounts", "hooks", "annotations", "linux", "windows", "solaris", "vm", "zos"]
val OCI_RUNTIME_PROCESS_PORTABLE_KEYS_V1: [text] = ["terminal", "consoleSize", "user", "args", "env", "cwd"]
val OCI_RUNTIME_PROCESS_LINUX_KEYS_V1: [text] = ["capabilities", "rlimits", "apparmorProfile",
    "oomScoreAdj", "selinuxLabel", "noNewPrivileges", "ioPriority", "scheduler", "execCPUAffinity"]
val OCI_RUNTIME_OTHER_PLATFORMS_V1: [text] = ["windows", "solaris", "vm", "zos"]

fn _oci_runtime_mount_v1(value: JsonValue) -> Result<OciRuntimeMountV1, text>:
    val checked = oci_json_object_v1(value, "mount")?
    for key in json_value_keys(checked):
        if not ["destination", "source", "type", "options", "uidMappings", "gidMappings"].contains(key):
            return Err("oci-runtime-mount-field-unknown: " + key)
        if key == "uidMappings" or key == "gidMappings":
            return Err("oci-runtime-mount-idmap-unsupported")
    val destination = oci_json_text_v1(checked, "destination", true, "mount")?
    if not destination.starts_with("/"):
        return Err("oci-runtime-mount-destination-not-absolute")
    val source = oci_json_text_v1(checked, "source", false, "mount")?
    val mount_type = oci_json_text_v1(checked, "type", false, "mount")?
    val options = oci_json_text_list_v1(checked, "options", 64, "mount")?
    Ok(OciRuntimeMountV1(source: source, destination: destination, mount_type: mount_type, options: options))

pub fn oci_runtime_config_decode_v1(bytes: text, limits: OciLimitsV1) -> Result<OciRuntimeConfigV1, text>:
    if bytes.len() == 0:
        return Err("oci-runtime-empty")
    if bytes.len() > limits.max_document_bytes:
        return Err("oci-runtime-exceeds-document-limit")
    val parsed = json_parse_value_strict(bytes)
    if parsed.is_err():
        return Err("oci-runtime-json-invalid")
    val document = oci_json_object_v1(parsed.unwrap(), "runtime")?
    var linux_only: [text] = []
    var other_platforms: [text] = []
    for key in json_value_keys(document):
        if not OCI_RUNTIME_TOP_KEYS_V1.contains(key):
            return Err("oci-runtime-field-unknown: " + key)
        if OCI_RUNTIME_OTHER_PLATFORMS_V1.contains(key):
            other_platforms.push(key)
    val version = oci_json_text_v1(document, "ociVersion", true, "runtime")?
    if not version.starts_with("1."):
        return Err("oci-runtime-version-unsupported")

    if not json_value_has(document, "process"):
        return Err("oci-runtime-missing-process")
    val process = oci_json_object_v1(json_value_field(document, "process"), "process")?
    for key in json_value_keys(process):
        if OCI_RUNTIME_PROCESS_LINUX_KEYS_V1.contains(key):
            linux_only.push("process." + key)
        elif not OCI_RUNTIME_PROCESS_PORTABLE_KEYS_V1.contains(key):
            return Err("oci-runtime-process-field-unknown: " + key)
    val args = oci_json_text_list_v1(process, "args", 4096, "process")?
    if args.len() == 0 or args[0] == "":
        return Err("oci-runtime-process-args-empty")
    val env = oci_json_text_list_v1(process, "env", 4096, "process")?
    if not oci_env_valid_v1(env):
        return Err("oci-runtime-process-env-invalid")
    val cwd = oci_json_text_v1(process, "cwd", true, "process")?
    if not cwd.starts_with("/") or cwd.contains(".."):
        return Err("oci-runtime-process-cwd-invalid")
    val terminal = oci_json_bool_v1(process, "terminal", "process")?
    var uid = 0
    var gid = 0
    if json_value_has(process, "user"):
        val user = oci_json_object_v1(json_value_field(process, "user"), "user")?
        for key in json_value_keys(user):
            if key == "additionalGids" or key == "umask":
                linux_only.push("process.user." + key)
            elif key != "uid" and key != "gid":
                return Err("oci-runtime-user-field-unknown: " + key)
        uid = oci_json_i64_v1(user, "uid", "user")?
        gid = oci_json_i64_v1(user, "gid", "user")?
        if uid < 0 or gid < 0:
            return Err("oci-runtime-user-id-negative")

    if not json_value_has(document, "root"):
        return Err("oci-runtime-missing-root")
    val root = oci_json_object_v1(json_value_field(document, "root"), "root")?
    val root_path = oci_json_text_v1(root, "path", true, "root")?
    val root_readonly = oci_json_bool_v1(root, "readonly", "root")?

    # hostname/domainname need a UTS namespace.
    val hostname = oci_json_text_v1(document, "hostname", false, "runtime")?
    if hostname != "":
        linux_only.push("hostname")
    val domainname = oci_json_text_v1(document, "domainname", false, "runtime")?
    if domainname != "":
        linux_only.push("domainname")

    var mounts: [OciRuntimeMountV1] = []
    val mount_entries = oci_json_array_v1(document, "mounts", 256, "runtime")?
    for entry in mount_entries:
        val mount = _oci_runtime_mount_v1(entry)?
        mounts.push(mount)

    var hooks_present = false
    if json_value_has(document, "hooks"):
        val hooks = json_value_field(document, "hooks")
        if json_value_type(hooks) != "null":
            val checked_hooks = oci_json_object_v1(hooks, "hooks")?
            hooks_present = json_value_keys(checked_hooks).len() > 0

    if json_value_has(document, "linux"):
        val linux = oci_json_object_v1(json_value_field(document, "linux"), "linux")?
        for key in json_value_keys(linux):
            linux_only.push("linux." + key)

    Ok(OciRuntimeConfigV1(oci_version: version, args: args, env: env, cwd: cwd, uid: uid, gid: gid,
        terminal: terminal, root_path: root_path, root_readonly: root_readonly, mounts: mounts,
        hooks_present: hooks_present, linux_only_fields: linux_only,
        other_platform_sections: other_platforms))

# Import a bundle whose config.json bytes and rootfs location the caller has
# already read. `digest` is the bundle content digest the caller computed;
# unpack_count/size are the declared rootfs totals. No IO happens here.
pub fn oci_bundle_import_v1(config_bytes: text, rootfs_path: text, digest: text,
        unpack_count: u64, unpack_size: u64, policy: OciBundleCheckPolicyV1,
        limits: OciLimitsV1) -> Result<OciBundleV1, text>:
    val config = oci_runtime_config_decode_v1(config_bytes, limits)?
    if config.root_path != rootfs_path:
        return Err("oci-bundle-root-path-mismatch")
    if digest != "" and not oci_digest_valid_v1(digest):
        return Err("oci-bundle-digest-invalid")
    var mounts: [OciBundleMountV1] = []
    for mount in config.mounts:
        mounts.push(OciBundleMountV1(source: mount.source, destination: mount.destination,
            mount_type: mount.mount_type))
    val check = OciBundleCheckInputV1(root_path: rootfs_path, mounts: mounts,
        hooks_present: config.hooks_present, digest: digest,
        unpack_count: unpack_count, unpack_size: unpack_size)
    val error = oci_bundle_check_v1(check, policy, true)
    if error != "":
        return Err(error)
    Ok(OciBundleV1(config: config, rootfs_path: rootfs_path, digest: digest))
