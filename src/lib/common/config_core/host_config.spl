# std.config core — HOST CONFIG (schema simple-host-config-v1).
#
# Host facts (parallelism, cpu family/ISA features, os, LLVM toolchain, gpu,
# and cache defaults for the existing SIMPLE_*CACHE* consumer variables)
# resolved over the same layer engine every other config uses
# (std.common.config_core.layers). Keys are documented in the versioned
# defaults file config/host/host_config.sdn, whose values are commented out.
#
# Layer mapping onto the config_core precedence ladder (lowest first):
#   vendor   <- config/host/host_config.sdn          (tracked defaults)
#   machine  <- config/host/<hostname>.sdn           (tracked legacy per-host)
#   user     <- ~/.config/simple/host.sdn            (untracked, setup-generated)
#   session  <- SIMPLE_HOST_<KEY> environment        (wins)
# So: env > user > host > default, identical to scripts/setup/host-env.shs.
#
# Tier-neutral: pure functions only. Callers read the documents and the
# environment snapshot and pass them in.

use std.common.config_core.schema.{ConfigFieldDescriptor, config_field, config_int_field, config_enum_field}
use std.common.config_core.schema.{config_schema_index, config_validate_value}
use std.common.config_core.layers.{ConfigEntry, ConfigResolution, config_parse_layer, config_resolve_valid}
use std.common.config_core.layers.{config_strip_inline_comment}

val HOST_CONFIG_SCHEMA = "simple-host-config-v1"

# Integer key with inclusive bounds. tree_rss_host_pct is a share of host RAM
# handed to one process tree; the shell twin (host_config_valid) and the
# consumer (scripts/bootstrap/lib/tree-rss-policy.shs) enforce the same 1..75.
fn host_config_int_range_field(key: text, min_value: i64, max_value: i64) -> ConfigFieldDescriptor:
    ConfigFieldDescriptor(
        key: key,
        label: key,
        description: "",
        category: "",
        value_type: "i64",
        default_value: "",
        enum_options: [],
        platform: "all",
        min_value: min_value,
        max_value: max_value,
        has_min: true,
        has_max: true
    )

fn host_config_schema() -> [ConfigFieldDescriptor]:
    [
        config_int_field("max_build_jobs", "", 1),
        config_int_field("max_threads", "", 1),
        config_int_field("worker_mem_mib", "", 1),
        config_int_field("tree_rss_base_mib", "", 1),
        config_int_field("tree_rss_per_job_mib", "", 1),
        host_config_int_range_field("tree_rss_host_pct", 1, 75),
        config_enum_field("cpu_family", "", ["x86_64", "aarch64", "riscv64"]),
        config_field("cpu_features", "text", ""),
        config_enum_field("os", "", ["windows", "linux", "macos", "freebsd", "simpleos"]),
        config_field("llvm_root", "text", ""),
        config_int_field("llvm_version", "", 1),
        config_enum_field("gpu", "", ["on", "off"]),
        # cache: each is only a DEFAULT for an existing consumer variable
        # (host_config_cache_var); a set consumer variable always wins.
        config_field("cache_root", "text", ""),
        config_field("cache_scope", "text", ""),
        config_enum_field("frontend_cache", "", ["on", "off"]),
        config_enum_field("hir_cache", "", ["on", "off"]),
        # Write-time encode->decode->encode self-check of every HIR cache
        # entry (consumer SIMPLE_HIR_CACHE_SELFCHECK; on = every store, off = never;
        # unset = every 8th store in bootstrap lanes, off elsewhere --
        # driver_hir_cache.hir_cache_selfcheck_mode).
        config_enum_field("hir_cache_selfcheck", "", ["on", "off"]),
        config_field("native_build_cache_dir", "text", ""),
        config_int_field("cache_max_bytes", "", 1),
        config_int_field("cache_max_gb", "", 1),
        # build features: specs tagged `# @tag:requires-<feature>` are skipped
        # (counted, with reason) when off. See std.spec.requires_feature.
        config_enum_field("hwir", "", ["on", "off"]),
        config_enum_field("assurance", "", ["on", "off"]),
        config_enum_field("arm_baremetal", "", ["on", "off"])
    ]

# Cache keys, in the shell twin's HOST_CONFIG_CACHE_KEYS order.
val HOST_CONFIG_CACHE_KEYS = ["cache_root", "cache_scope", "frontend_cache", "hir_cache", "hir_cache_selfcheck", "native_build_cache_dir", "cache_max_bytes", "cache_max_gb"]

# The EXISTING consumer variable a cache key is a default for ("" when `key`
# is not a cache key). Same table as host_config_cache_var in host-env.shs.
fn host_config_cache_var(key: text) -> text:
    if key == "cache_root": return "SIMPLE_HOST_CACHE_ROOT"
    if key == "cache_scope": return "SIMPLE_CACHE_SCOPE"
    if key == "frontend_cache": return "SIMPLE_FRONTEND_CACHE"
    if key == "hir_cache": return "SIMPLE_HIR_CACHE"
    if key == "hir_cache_selfcheck": return "SIMPLE_HIR_CACHE_SELFCHECK"
    if key == "native_build_cache_dir": return "SIMPLE_NATIVE_BUILD_CACHE_DIR"
    if key == "cache_max_bytes": return "SIMPLE_CACHE_MAX_BYTES"
    if key == "cache_max_gb": return "SIMPLE_CACHE_MAX_GB"
    ""

# A lane name is a cache DIRECTORY segment: only [A-Za-z0-9._-], not starting
# with '.', so a config value can never step out of its lane partition.
fn host_config_scope_name_ok(name: text) -> bool:
    if name.len() == 0:
        return false
    if name.char_code_at(0) == 46:
        return false
    var i = 0
    while i < name.len():
        val c = name.char_code_at(i)
        val ok = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 46 or c == 45 or c == 95
        if not ok:
            return false
        i = i + 1
    true

fn _hc_value_ok(desc: ConfigFieldDescriptor, value: text) -> bool:
    if not config_validate_value(desc, value).ok:
        return false
    if desc.key == "cache_scope":
        return host_config_scope_name_ok(value)
    true

# Environment variable that overrides `key`: SIMPLE_HOST_<KEY>.
fn host_config_env_name(key: text) -> text:
    "SIMPLE_HOST_" + key.upper()

fn _hc_parse(content: text, layer: text) -> [ConfigEntry]:
    var result: [ConfigEntry] = []
    for e in config_parse_layer(content, layer):
        val value = config_strip_inline_comment(e.value).trim()
        # An empty value pins nothing (same as the shell twin).
        if value != "":
            result.push(ConfigEntry(key: e.key, value: value, layer: layer))
    result

# True unless the document's entries declare a `schema:` other than
# simple-host-config-v1; a document with no schema line is accepted. Same rule
# as host_config_file_schema_ok in scripts/setup/host-env.shs.
fn host_config_schema_accepts(entries: [ConfigEntry]) -> bool:
    for e in entries:
        if e.key == "schema":
            return e.value == HOST_CONFIG_SCHEMA
    true

# A host_config document's entries, or [] when it carries a foreign schema.
# The machine layer is the legacy host_env: file, whose own schema
# (simple-host-env-v1) is validated by its loader, so it is not checked here.
fn _hc_layer_entries(content: text, layer: text) -> [ConfigEntry]:
    val entries = _hc_parse(content, layer)
    if layer != "machine" and not host_config_schema_accepts(entries):
        return []
    entries

# All contributions, tagged with their layer. Any document may be "".
fn host_config_entries(defaults_text: text, host_text: text, user_text: text, env: [(text, text)]) -> [ConfigEntry]:
    var result: [ConfigEntry] = []
    for e in _hc_layer_entries(defaults_text, "vendor"):
        result.push(e)
    for e in _hc_layer_entries(host_text, "machine"):
        result.push(e)
    for e in _hc_layer_entries(user_text, "user"):
        result.push(e)
    for desc in host_config_schema():
        val name = host_config_env_name(desc.key)
        for pair in env:
            if pair.0 == name and pair.1 != "":
                result.push(ConfigEntry(key: desc.key, value: pair.1, layer: "session"))
    result

# Shell-twin layer names, so both readers word their warnings identically.
fn _hc_shell_layer(layer: text) -> text:
    if layer == "session": return "env"
    if layer == "machine": return "host"
    if layer == "vendor": return "default"
    layer

# Warnings for every rejected contribution: a host_config document with a
# foreign schema (skipped whole) and every schema-invalid value (which falls
# through to the next lower layer). Pure; callers print them. Wording matches
# the shell twin's stderr warnings.
fn host_config_warnings(defaults_text: text, host_text: text, user_text: text, env: [(text, text)]) -> [text]:
    var result: [text] = []
    for doc in [(defaults_text, "vendor"), (user_text, "user")]:
        if not host_config_schema_accepts(_hc_parse(doc.0, doc.1)):
            result.push("host-config: warning: ignoring {_hc_shell_layer(doc.1)} layer: schema is not {HOST_CONFIG_SCHEMA}")
    val schema = host_config_schema()
    for e in host_config_entries(defaults_text, host_text, user_text, env):
        val idx = config_schema_index(schema, e.key)
        if idx >= 0 and not _hc_value_ok(schema[idx], e.value):
            val origin = if e.layer == "session": "env" else: "{_hc_shell_layer(e.layer)} layer"
            result.push("host-config: warning: ignoring invalid {e.key}={e.value} from {origin}")
    result

# Effective resolution for one key; invalid values fall through to the next
# lower layer. layer == "compiled_default" and value == "" means unconfigured.
fn host_config_resolve(entries: [ConfigEntry], key: text) -> ConfigResolution:
    val schema = host_config_schema()
    val idx = config_schema_index(schema, key)
    if idx < 0:
        return ConfigResolution(key: key, value: "", layer: "compiled_default", rank: 0, locked: false)
    var kept: [ConfigEntry] = []
    for e in entries:
        if e.key != key or _hc_value_ok(schema[idx], e.value):
            kept.push(e)
    config_resolve_valid(schema[idx], kept)

fn host_config_value(entries: [ConfigEntry], key: text) -> text:
    host_config_resolve(entries, key).value

# (consumer variable, value) defaults for every cache key whose consumer
# variable is unset/empty in `env` and whose host config value resolves
# non-empty; on/off become "1"/"0". A set consumer variable always wins and is
# omitted. Mirrors host_config_cache_env in scripts/setup/host-env.shs.
fn host_config_cache_env(entries: [ConfigEntry], env: [(text, text)]) -> [(text, text)]:
    var result: [(text, text)] = []
    for key in HOST_CONFIG_CACHE_KEYS:
        val name = host_config_cache_var(key)
        var is_set = false
        for pair in env:
            if pair.0 == name and pair.1 != "":
                is_set = true
        if is_set:
            continue
        var value = host_config_value(entries, key)
        if value == "":
            continue
        if key == "frontend_cache" or key == "hir_cache" or key == "hir_cache_selfcheck":
            value = if value == "on": "1" else: "0"
        result.push((name, value))
    result

# cpu_features as a list ("sse2,avx2" -> ["sse2", "avx2"]).
fn host_config_cpu_features(entries: [ConfigEntry]) -> [text]:
    var result: [text] = []
    for part in host_config_value(entries, "cpu_features").split(","):
        val f = part.trim()
        if f != "":
            result.push(f)
    result
