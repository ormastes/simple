# Coverage SDN parse / merge / render — shared primitive for aggregating
# multiple coverage artifacts (SIMPLE_COVERAGE_OUTPUT `.sdn` files) into one.
#
# Why this exists: `SIMPLE_COVERAGE_OUTPUT` names one file, and each spec run
# OVERWRITES it rather than accumulating (see
# src/app/test_runner_new/test_runner_single.spl's cov_output_path write —
# "Multi-spec invocations ... last spec wins"). A multi-spec test run or a
# multi-run CI job that wants combined coverage has to union N `.sdn`
# artifacts by hand. This module is the ONE place that knows the SDN section
# format (`lines |file, line, hit_count|`, `functions |name, call_count|`,
# `sffi_calls |name, call_count|`, `decisions |id, file, line, column,
# true_count, false_count|`, and a trailing `summary:` block that this module
# always recomputes rather than trusts) so `spl-coverage rollup` and the test
# runner's multi-spec export can both use it instead of re-deriving the
# format twice.
#
# A coverage artifact can also embed a SECOND report block appended after a
# "# Runtime decision/condition coverage" marker comment (see
# `save_global_coverage` / the interpreter's `rt_coverage_dump_sdn` merge in
# src/compiler_rust/compiler/src/interpreter_extern/coverage.rs) — this
# parser treats every `# Coverage Report` header, `version:` line, and
# comment line as a no-op separator and keeps accumulating sections across
# both blocks into one ParsedCoverage, so callers don't need to know how many
# blocks are concatenated in a given file.

struct LineRow:
    file: text
    line: i64
    hit_count: i64

struct FuncRow:
    name: text
    call_count: i64

struct DecisionRow:
    id: text
    file: text
    line: i64
    column: i64
    true_count: i64
    false_count: i64

struct ParsedCoverage:
    lines: [LineRow]
    functions: [FuncRow]
    sffi_calls: [FuncRow]
    decisions: [DecisionRow]

fn empty_coverage() -> ParsedCoverage:
    ParsedCoverage(lines: [], functions: [], sffi_calls: [], decisions: [])

fn _split_csv(row: text) -> [text]:
    var parts: [text] = []
    for piece in row.split(","):
        parts.push(piece.trim())
    parts

fn _parse_i64(s: text) -> i64:
    match s.trim().to_i64():
        case Some(v):
            v
        case None:
            0

# Parse one SDN document (possibly several concatenated `# Coverage Report`
# blocks — see module doc) into a single ParsedCoverage. Unknown/unmodeled
# sections (e.g. `conditions`, `summary`) are skipped, not errored — this
# parser only extracts what the rollup needs to aggregate.
fn parse_coverage_sdn(sdn: text) -> ParsedCoverage:
    var result = empty_coverage()
    var section = ""
    for raw_line in sdn.split("\n"):
        if raw_line.starts_with("    ") or raw_line.starts_with("\t"):
            val cols = _split_csv(raw_line)
            if section == "lines" and cols.len() >= 3:
                result.lines.push(LineRow(file: cols[0], line: _parse_i64(cols[1]), hit_count: _parse_i64(cols[2])))
            elif section == "functions" and cols.len() >= 2:
                result.functions.push(FuncRow(name: cols[0], call_count: _parse_i64(cols[1])))
            elif section == "sffi_calls" and cols.len() >= 2:
                result.sffi_calls.push(FuncRow(name: cols[0], call_count: _parse_i64(cols[1])))
            elif section == "decisions" and cols.len() >= 6:
                result.decisions.push(DecisionRow(
                    id: cols[0],
                    file: cols[1],
                    line: _parse_i64(cols[2]),
                    column: _parse_i64(cols[3]),
                    true_count: _parse_i64(cols[4]),
                    false_count: _parse_i64(cols[5]),
                ))
            # else: indented line under an unmodeled section (conditions,
            # summary body) or a malformed row for a known section — skip.
        else:
            val trimmed = raw_line.trim()
            if trimmed == "":
                pass
            elif trimmed == "summary:":
                section = "summary"
            elif trimmed.starts_with("lines "):
                section = "lines"
            elif trimmed.starts_with("functions "):
                section = "functions"
            elif trimmed.starts_with("sffi_calls "):
                section = "sffi_calls"
            elif trimmed.starts_with("decisions "):
                section = "decisions"
            elif trimmed.starts_with("conditions "):
                section = "conditions"
            else:
                # "# Coverage Report", "# Runtime decision/condition
                # coverage", "version: 1.0", "label: ..." — separators
                # between/around blocks. Reset section so a stray indented
                # line right after one of these (shouldn't happen in
                # practice) doesn't get misfiled into the previous section.
                section = ""
    result

fn merge_lines(a: [LineRow], b: [LineRow]) -> [LineRow]:
    var merged: [LineRow] = []
    for r in a:
        merged.push(r)
    for r in b:
        var found = false
        var i = 0
        while i < merged.len():
            if merged[i].file == r.file and merged[i].line == r.line:
                merged[i] = LineRow(file: r.file, line: r.line, hit_count: merged[i].hit_count + r.hit_count)
                found = true
            i = i + 1
        if not found:
            merged.push(r)
    merged

fn merge_funcs(a: [FuncRow], b: [FuncRow]) -> [FuncRow]:
    var merged: [FuncRow] = []
    for r in a:
        merged.push(r)
    for r in b:
        var found = false
        var i = 0
        while i < merged.len():
            if merged[i].name == r.name:
                merged[i] = FuncRow(name: r.name, call_count: merged[i].call_count + r.call_count)
                found = true
            i = i + 1
        if not found:
            merged.push(r)
    merged

fn merge_decisions(a: [DecisionRow], b: [DecisionRow]) -> [DecisionRow]:
    var merged: [DecisionRow] = []
    for r in a:
        merged.push(r)
    for r in b:
        var found = false
        var i = 0
        while i < merged.len():
            if merged[i].id == r.id and merged[i].file == r.file and merged[i].line == r.line and merged[i].column == r.column:
                merged[i] = DecisionRow(
                    id: r.id,
                    file: r.file,
                    line: r.line,
                    column: r.column,
                    true_count: merged[i].true_count + r.true_count,
                    false_count: merged[i].false_count + r.false_count,
                )
                found = true
            i = i + 1
        if not found:
            merged.push(r)
    merged

fn merge_coverage(a: ParsedCoverage, b: ParsedCoverage) -> ParsedCoverage:
    ParsedCoverage(
        lines: merge_lines(a.lines, b.lines),
        functions: merge_funcs(a.functions, b.functions),
        sffi_calls: merge_funcs(a.sffi_calls, b.sffi_calls),
        decisions: merge_decisions(a.decisions, b.decisions),
    )

# Union an arbitrary number of parsed artifacts into one. Empty input yields
# `empty_coverage()` — callers must decide separately whether "zero artifacts"
# is an error (spl-coverage rollup treats it as one; see main.spl).
fn merge_many(all: [ParsedCoverage]) -> ParsedCoverage:
    var acc = empty_coverage()
    for cov in all:
        acc = merge_coverage(acc, cov)
    acc

fn _distinct_file_count(rows: [LineRow]) -> i64:
    var files: [text] = []
    for r in rows:
        var found = false
        for f in files:
            if f == r.file:
                found = true
        if not found:
            files.push(r.file)
    files.len()

# Render a ParsedCoverage back to SDN text, with a freshly-computed `summary:`
# block (never trusts a stored summary — it is derived from the row lists
# every time, so a merge can never silently carry forward stale totals).
fn render_coverage_sdn(cov: ParsedCoverage) -> text:
    var out = "# Coverage Report\nversion: 1.0\n\n"

    out = out + "lines |file, line, hit_count|\n"
    for r in cov.lines:
        out = out + "    {r.file}, {r.line}, {r.hit_count}\n"
    out = out + "\n"

    out = out + "functions |name, call_count|\n"
    for r in cov.functions:
        out = out + "    {r.name}, {r.call_count}\n"
    out = out + "\n"

    if cov.sffi_calls.len() > 0:
        out = out + "sffi_calls |name, call_count|\n"
        for r in cov.sffi_calls:
            out = out + "    {r.name}, {r.call_count}\n"
        out = out + "\n"

    if cov.decisions.len() > 0:
        out = out + "decisions |id, file, line, column, true_count, false_count|\n"
        for r in cov.decisions:
            out = out + "    {r.id}, {r.file}, {r.line}, {r.column}, {r.true_count}, {r.false_count}\n"
        out = out + "\n"

    var covered_lines = 0
    for r in cov.lines:
        if r.hit_count > 0:
            covered_lines = covered_lines + 1

    var covered_functions = 0
    for r in cov.functions:
        if r.call_count > 0:
            covered_functions = covered_functions + 1

    var covered_decisions = 0
    for r in cov.decisions:
        if r.true_count > 0 and r.false_count > 0:
            covered_decisions = covered_decisions + 1

    val total_lines = cov.lines.len()
    val total_functions = cov.functions.len()
    val total_sffi = cov.sffi_calls.len()
    val total_decisions = cov.decisions.len()

    out = out + "summary:\n"
    out = out + "    total_files: {_distinct_file_count(cov.lines)}\n"
    out = out + "    total_lines: {total_lines}\n"
    out = out + "    covered_lines: {covered_lines}\n"
    out = out + "    total_functions: {total_functions}\n"
    out = out + "    covered_functions: {covered_functions}\n"
    out = out + "    total_sffi_calls: {total_sffi}\n"
    if total_decisions > 0:
        out = out + "    total_decisions: {total_decisions}\n"
        out = out + "    covered_decisions: {covered_decisions}\n"
    out
