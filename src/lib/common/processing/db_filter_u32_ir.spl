"""Data-bearing ProcessingIR operation for DB scan/filter/project batches."""

struct ProcessingDbFilterU32Ir:
    values: [u32]
    minimum: u32
    maximum: u32

struct ProcessingDbFilterU32Validation:
    valid: bool
    reason: text

fn processing_ir_db_filter_u32(values: [u32], minimum: u32,
                                maximum: u32) -> ProcessingDbFilterU32Ir:
    ProcessingDbFilterU32Ir(values: values, minimum: minimum, maximum: maximum)

fn processing_db_filter_u32_validate(ir: ProcessingDbFilterU32Ir) -> ProcessingDbFilterU32Validation:
    if ir.values.len() == 0:
        return ProcessingDbFilterU32Validation(valid: false, reason: "db-filter-input-empty")
    if ir.values.len() > 16777216:
        return ProcessingDbFilterU32Validation(valid: false, reason: "db-filter-input-too-large")
    if ir.minimum > ir.maximum:
        return ProcessingDbFilterU32Validation(valid: false, reason: "db-filter-range-invalid")
    ProcessingDbFilterU32Validation(valid: true, reason: "ok")

fn processing_db_filter_u32_cpu_mask(ir: ProcessingDbFilterU32Ir) -> [u32]:
    if not processing_db_filter_u32_validate(ir).valid:
        return []
    var mask: [u32] = []
    for value in ir.values:
        mask.push(if value >= ir.minimum and value <= ir.maximum: 1u32 else: 0u32)
    mask

fn processing_db_filter_u32_row_ids(ir: ProcessingDbFilterU32Ir,
                                    mask: [u32]) -> [i64]:
    if mask.len() != ir.values.len():
        return []
    var rows: [i64] = []
    var index: i64 = 0
    while index < mask.len().to_i64():
        if mask[index] == 1u32:
            rows.push(index)
        elif mask[index] != 0u32:
            return []
        index = index + 1
    rows

fn processing_db_filter_u32_cpu_row_ids(ir: ProcessingDbFilterU32Ir) -> [i64]:
    processing_db_filter_u32_row_ids(ir, processing_db_filter_u32_cpu_mask(ir))

fn processing_db_filter_u32_mask_checksum(mask: [u32]) -> i64:
    var checksum: i64 = 1
    var index: i64 = 0
    for value in mask:
        checksum = checksum + (index + 1) * (value.to_i64() + 1)
        index = index + 1
    checksum

fn processing_db_filter_u32_mismatch_count(expected: [u32], actual: [u32]) -> i64:
    if expected.len() != actual.len():
        return if expected.len() > actual.len(): expected.len().to_i64() else: actual.len().to_i64()
    var mismatches: i64 = 0
    var index: i64 = 0
    while index < expected.len().to_i64():
        if expected[index] != actual[index]:
            mismatches = mismatches + 1
        index = index + 1
    mismatches

export ProcessingDbFilterU32Ir, ProcessingDbFilterU32Validation
export processing_ir_db_filter_u32, processing_db_filter_u32_validate
export processing_db_filter_u32_cpu_mask, processing_db_filter_u32_row_ids
export processing_db_filter_u32_cpu_row_ids, processing_db_filter_u32_mask_checksum
export processing_db_filter_u32_mismatch_count
