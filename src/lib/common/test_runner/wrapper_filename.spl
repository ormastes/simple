# Generated test files are invocation artifacts, not path-keyed cache entries.
# These names do not encode source paths. AOT source/manifest binding remains
# in its existing staging owner; legacy coverage attribution is separate.

fn wrapper_invocation_token(process_id: i64, nonce: text) -> text:
    if process_id <= 0 or nonce.len() != 32:
        return ""
    for index in 0..32:
        val digit = nonce[index:index + 1]
        if not "0123456789abcdefABCDEF".contains(digit):
            return ""
    process_id.to_text() + "_" + nonce

fn coverage_wrapper_filename(process_id: i64, nonce: text?, spec_source: bool) -> Result<text, text>:
    """Bounded ASCII basename; preserve the runner's _spec.spl classification."""
    if nonce.is_none(): return Err("coverage wrapper entropy unavailable before test execution")
    val token = wrapper_invocation_token(process_id, nonce.unwrap())
    if token == "": return Err("coverage wrapper invocation filename rejected before test execution")
    Ok("simple_cov_" + token + (if spec_source: "_spec.spl" else: ".spl"))

fn spipe_wrapper_filename(process_id: i64, nonce: text?) -> Result<text, text>:
    """Bounded ASCII basename; callers still own exclusive file creation."""
    if nonce.is_none(): return Err("native wrapper entropy unavailable before test execution")
    val token = wrapper_invocation_token(process_id, nonce.unwrap())
    if token == "": return Err("native wrapper invocation filename rejected before test execution")
    Ok("spipe_wrapped_" + token + "_native.spl")

export coverage_wrapper_filename, spipe_wrapper_filename
