# Vector drawing primitives — 2-D point and axis-aligned rectangle.
#
# Mirrors the Skia naming used throughout the drawing/editor subsystem.
# SkPoint and SkRect are pure value types; all methods return new values.

use std.common.math.{MATH_PI}

pub struct SkPoint:
    """A 2-D floating-point coordinate (Skia-style naming)."""
    x: f64
    y: f64

impl SkPoint:
    static fn zero() -> SkPoint:
        """Origin point (0, 0)."""
        SkPoint(x: 0.0, y: 0.0)

    static fn from_xy(x: f64, y: f64) -> SkPoint:
        """Construct from explicit coordinates."""
        SkPoint(x: x, y: y)

    fn translate(self, dx: f64, dy: f64) -> SkPoint:
        """Return point shifted by (dx, dy)."""
        SkPoint(x: self.x + dx, y: self.y + dy)

    fn distance_to(self, other: SkPoint) -> f64:
        """Euclidean distance to another point."""
        val dx = self.x - other.x
        val dy = self.y - other.y
        # Newton–Raphson sqrt approximation good to ~0.1 %
        val d2 = dx * dx + dy * dy
        if d2 == 0.0:
            return 0.0
        var s = d2
        var i = 0
        while i < 20:
            s = (s + d2 / s) * 0.5
            i = i + 1
        s

    fn equals(self, other: SkPoint) -> bool:
        self.x == other.x and self.y == other.y

pub struct SkRect:
    """An axis-aligned rectangle expressed as (left, top, right, bottom)."""
    left: f64
    top: f64
    right: f64
    bottom: f64

impl SkRect:
    static fn zero() -> SkRect:
        """Empty rectangle at origin."""
        SkRect(left: 0.0, top: 0.0, right: 0.0, bottom: 0.0)

    static fn from_ltrb(left: f64, top: f64, right: f64, bottom: f64) -> SkRect:
        """Construct from explicit left/top/right/bottom values."""
        SkRect(left: left, top: top, right: right, bottom: bottom)

    static fn from_xywh(x: f64, y: f64, w: f64, h: f64) -> SkRect:
        """Construct from (x, y, width, height)."""
        SkRect(left: x, top: y, right: x + w, bottom: y + h)

    fn width(self) -> f64:
        self.right - self.left

    fn height(self) -> f64:
        self.bottom - self.top

    fn center_x(self) -> f64:
        (self.left + self.right) * 0.5

    fn center_y(self) -> f64:
        (self.top + self.bottom) * 0.5

    fn center(self) -> SkPoint:
        """Midpoint of the rectangle."""
        SkPoint(x: (self.left + self.right) * 0.5, y: (self.top + self.bottom) * 0.5)

    fn contains_point(self, px: f64, py: f64) -> bool:
        """Half-open hit test: left/top inclusive, right/bottom exclusive."""
        px >= self.left and px < self.right and py >= self.top and py < self.bottom

    fn is_empty(self) -> bool:
        self.right <= self.left or self.bottom <= self.top

    fn translate(self, dx: f64, dy: f64) -> SkRect:
        SkRect(left: self.left + dx, top: self.top + dy,
               right: self.right + dx, bottom: self.bottom + dy)

    fn inset(self, dx: f64, dy: f64) -> SkRect:
        SkRect(left: self.left + dx, top: self.top + dy,
               right: self.right - dx, bottom: self.bottom - dy)

    fn union_rect(self, other: SkRect) -> SkRect:
        """Return the smallest rect enclosing both rects."""
        val l = if self.left < other.left: self.left else: other.left
        val t = if self.top < other.top: self.top else: other.top
        val r = if self.right > other.right: self.right else: other.right
        val b = if self.bottom > other.bottom: self.bottom else: other.bottom
        SkRect(left: l, top: t, right: r, bottom: b)

pub struct PathPoint:
    """A path node: an on-curve position plus optional Bezier control handles.

    `control_in` steers the segment arriving at `pos`, `control_out` the segment
    leaving it. Both are only meaningful when the matching `has_*` flag is set;
    a linear node stores `pos` in them so consumers never read uninitialised
    coordinates.
    """
    pos: SkPoint
    control_in: SkPoint
    control_out: SkPoint
    has_in: bool
    has_out: bool

impl PathPoint:
    static fn linear(pos: SkPoint) -> PathPoint:
        """On-curve node with no handles — both adjacent segments are straight."""
        PathPoint(pos: pos, control_in: pos, control_out: pos, has_in: false, has_out: false)

    static fn cubic(pos: SkPoint, control_in: SkPoint, control_out: SkPoint) -> PathPoint:
        """On-curve node carrying both Bezier handles."""
        PathPoint(pos: pos, control_in: control_in, control_out: control_out,
                  has_in: true, has_out: true)

    fn has_controls(self) -> bool:
        """True when at least one Bezier handle is active."""
        self.has_in or self.has_out

# ============================================================================
# Matrix3x3 — affine/projective 3x3 transform matrix (Skia-style, row-major:
# row m[row][col] -> m{row}{col}). Moved here from src/lib/skia/entity/
# matrix.spl (2026-08-09) so std.common.drawing.vector callers don't have to
# invert the tier order to reach it; the skia module re-exports it from here.
# ============================================================================

fn _matrix3x3_sin_taylor(x: f64) -> f64:
    """Sine via Taylor series. Reduces angle to [-PI, PI] first."""
    var a = x
    val two_pi = MATH_PI * 2.0
    while a > MATH_PI:
        a = a - two_pi
    while a < -MATH_PI:
        a = a + two_pi
    val x2 = a * a
    val x3 = a * x2
    val x5 = x3 * x2
    val x7 = x5 * x2
    val x9 = x7 * x2
    val x11 = x9 * x2
    val x13 = x11 * x2
    val x15 = x13 * x2
    a - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0 + x9 / 362880.0 - x11 / 39916800.0 + x13 / 6227020800.0 - x15 / 1307674368000.0

fn _matrix3x3_cos_taylor(x: f64) -> f64:
    """Cosine via sine identity: cos(x) = sin(x + PI/2)."""
    _matrix3x3_sin_taylor(x + MATH_PI / 2.0)

fn _matrix3x3_near(a: f64, b: f64, eps: f64) -> bool:
    """True when |a - b| <= eps."""
    if a > b:
        (a - b) <= eps
    else:
        (b - a) <= eps

fn _matrix3x3_sqrt_newton(x: f64) -> f64:
    """Square root via 8 Newton iterations. Returns 0 for non-positive x."""
    if x <= 0.0:
        0.0
    else:
        var g = x
        if g > 1.0:
            g = x / 2.0
        var i = 0
        while i < 8:
            g = (g + x / g) / 2.0
            i = i + 1
        g

pub struct Matrix3x3:
    m00: f64
    m01: f64
    m02: f64
    m10: f64
    m11: f64
    m12: f64
    m20: f64
    m21: f64
    m22: f64

impl Matrix3x3:
    static fn identity() -> Matrix3x3:
        Matrix3x3(
            m00: 1.0, m01: 0.0, m02: 0.0,
            m10: 0.0, m11: 1.0, m12: 0.0,
            m20: 0.0, m21: 0.0, m22: 1.0
        )

    static fn translate(tx: f64, ty: f64) -> Matrix3x3:
        Matrix3x3(
            m00: 1.0, m01: 0.0, m02: tx,
            m10: 0.0, m11: 1.0, m12: ty,
            m20: 0.0, m21: 0.0, m22: 1.0
        )

    static fn scale(sx: f64, sy: f64) -> Matrix3x3:
        Matrix3x3(
            m00: sx,  m01: 0.0, m02: 0.0,
            m10: 0.0, m11: sy,  m12: 0.0,
            m20: 0.0, m21: 0.0, m22: 1.0
        )

    static fn rotate_degrees(deg: f64) -> Matrix3x3:
        val rad = deg * 0.017453292519943295
        val c = _matrix3x3_cos_taylor(rad)
        val s = _matrix3x3_sin_taylor(rad)
        Matrix3x3(
            m00: c,   m01: -s,  m02: 0.0,
            m10: s,   m11:  c,  m12: 0.0,
            m20: 0.0, m21: 0.0, m22: 1.0
        )

    fn is_identity(self) -> bool:
        """True when this matrix is the identity transform.

        Compared with a small tolerance because the identity can be reached
        through `rotate_degrees(0.0)` / `scale(1.0, 1.0)`, whose f64 results
        are only exactly 1.0/0.0 up to rounding.
        """
        val eps = 0.000000001
        _matrix3x3_near(self.m00, 1.0, eps) and
            _matrix3x3_near(self.m01, 0.0, eps) and
            _matrix3x3_near(self.m02, 0.0, eps) and
            _matrix3x3_near(self.m10, 0.0, eps) and
            _matrix3x3_near(self.m11, 1.0, eps) and
            _matrix3x3_near(self.m12, 0.0, eps) and
            _matrix3x3_near(self.m20, 0.0, eps) and
            _matrix3x3_near(self.m21, 0.0, eps) and
            _matrix3x3_near(self.m22, 1.0, eps)

    fn mul(self, other: Matrix3x3) -> Matrix3x3:
        Matrix3x3(
            m00: self.m00 * other.m00 + self.m01 * other.m10 + self.m02 * other.m20,
            m01: self.m00 * other.m01 + self.m01 * other.m11 + self.m02 * other.m21,
            m02: self.m00 * other.m02 + self.m01 * other.m12 + self.m02 * other.m22,
            m10: self.m10 * other.m00 + self.m11 * other.m10 + self.m12 * other.m20,
            m11: self.m10 * other.m01 + self.m11 * other.m11 + self.m12 * other.m21,
            m12: self.m10 * other.m02 + self.m11 * other.m12 + self.m12 * other.m22,
            m20: self.m20 * other.m00 + self.m21 * other.m10 + self.m22 * other.m20,
            m21: self.m20 * other.m01 + self.m21 * other.m11 + self.m22 * other.m21,
            m22: self.m20 * other.m02 + self.m21 * other.m12 + self.m22 * other.m22
        )

    # ---- Accessor decomposition ----
    # WHY: SkCanvas record path encodes transforms into SkRect slots (tx, ty,
    # scale_x, scale_y); these helpers extract those affine components.
    # Lossy — rotation/shear are not recoverable from the four scalars.

    fn tx(self) -> f64:
        self.m02

    fn ty(self) -> f64:
        self.m12

    fn scale_x(self) -> f64:
        _matrix3x3_sqrt_newton(self.m00 * self.m00 + self.m10 * self.m10)

    fn scale_y(self) -> f64:
        _matrix3x3_sqrt_newton(self.m01 * self.m01 + self.m11 * self.m11)
