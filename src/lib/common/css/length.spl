# Shared CSS length and `calc()` resolution — the one home for turning CSS
# length syntax into a number of CSS pixels.
#
# Provides: LengthContext, length_context, CssLengthResult, css_length_ok,
# css_length_err, parse_length_px, parse_calc_px.
#
# Every entry point returns a `CssLengthResult` carrying an explicit `ok` flag
# and, when `ok` is false, a human-readable `error`. Nothing here ever answers
# a plausible-looking `0` for input it did not understand. That rule is not
# style: the sibling colour path used to substitute opaque black for every
# notation it could not parse, and the gap stayed invisible for months because
# a wrong pixel looks like a pixel. A wrong length looks like a layout. Both
# have to fail loudly instead.
#
# `f64` is used end to end. Percentage and division maths must not truncate:
# `calc(100% / 3)` of a 100px basis is 33.333…px, not 33px. Callers that need
# integer device pixels round at the very end, once.
#
# This module lives in `common` so that every lane can import it — including
# leaf lanes such as `blink`, which may not reach into `gc_async_mut` where the
# live browser lane's own `calc()` reader lives. Extend this module rather than
# starting a third copy.
#
# ## Supported syntax
#
#   - Plain dimensions: `12px`, `-1.5em`, `+2rem`, `50%`, and the bare `0`
#     (the one unitless length CSS allows).
#   - Absolute units: `px`, `in`, `cm`, `mm`, `Q`, `pt`, `pc`.
#   - Font-relative units: `em`, `rem`, `ex`, `ch` (`ex`/`ch` use the CSS
#     fallback of 0.5em, since no font metrics are available here).
#   - Viewport units: `vw`, `vh`, `vmin`, `vmax`.
#   - `calc()` with `+`, `-`, `*`, `/`, arbitrary parentheses and nesting,
#     including a nested `calc()`.
#
# ## Deliberately rejected (returns ok=false with a reason)
#
#   - `calc(10px * 5px)` — multiplication needs at least one unitless side.
#   - `calc(10 / 5px)` — the divisor must be unitless.
#   - `calc(10px / 0)` — division by zero.
#   - `calc(1px + 2)` — a length and a bare number cannot be added.
#   - `calc(100%-20px)` and `calc(100% -20px)` — CSS requires whitespace on
#     BOTH sides of `+` and `-`; without it the `-20px` is a signed number and
#     the expression is two values with no operator between them.
#   - Unbalanced parentheses, empty `calc()`, trailing junk, unknown units,
#     a unitless non-zero where a length is required, and `%` when the caller
#     declared no percentage basis.
#
# ## Not covered yet (also rejected, not guessed)
#   `min()`, `max()`, `clamp()`, `var()`, `attr()`, `env()`, and the trigonometric
#   and stepped-value functions of CSS Values 4.

# ============================================================================
# Resolution context
# ============================================================================

# Everything a length needs in order to become a pixel count. The percentage
# basis is a field rather than a constant because it is per-PROPERTY: a `width`
# percentage resolves against the containing block's inline size, a `height`
# percentage against its block size, `margin`/`padding` percentages against the
# containing block's INLINE size on all four sides, and `font-size` against the
# parent's font size. The caller knows which; this module cannot.
pub struct LengthContext:
    font_size_px: f64
    root_font_size_px: f64
    viewport_width_px: f64
    viewport_height_px: f64
    percent_basis_px: f64
    percent_resolvable: bool

# Build a context. `percent_basis_px` is the basis for THIS property; pass
# `percent_resolvable: false` (see `length_context_no_percent`) when the basis
# is not yet known, so a `%` fails instead of resolving against a stand-in 0.
pub fn length_context(
    font_size_px: f64,
    root_font_size_px: f64,
    viewport_width_px: f64,
    viewport_height_px: f64,
    percent_basis_px: f64
) -> LengthContext:
    """Return a LengthContext whose percentages resolve against percent_basis_px."""
    LengthContext(
        font_size_px: font_size_px,
        root_font_size_px: root_font_size_px,
        viewport_width_px: viewport_width_px,
        viewport_height_px: viewport_height_px,
        percent_basis_px: percent_basis_px,
        percent_resolvable: true
    )

# The 16px/16px/800x600 defaults, with no percentage basis. Useful for tests
# and for callers resolving a length that CSS forbids percentages in.
pub fn length_context_no_percent(font_size_px: f64, root_font_size_px: f64) -> LengthContext:
    """Return a LengthContext in which any percentage is an error."""
    LengthContext(
        font_size_px: font_size_px,
        root_font_size_px: root_font_size_px,
        viewport_width_px: 0.0,
        viewport_height_px: 0.0,
        percent_basis_px: 0.0,
        percent_resolvable: false
    )

# ============================================================================
# Result
# ============================================================================

# The outcome of resolving one length. `px` is only meaningful when `ok`; on
# failure it is 0.0 purely because the field must hold something, and a caller
# that reads it without checking `ok` has the bug this type exists to prevent.
pub struct CssLengthResult:
    ok: bool
    px: f64
    error: text

pub fn css_length_ok(px: f64) -> CssLengthResult:
    """Return a successful result carrying px."""
    CssLengthResult(ok: true, px: px, error: "")

pub fn css_length_err(message: text) -> CssLengthResult:
    """Return a failed result carrying the reason message."""
    CssLengthResult(ok: false, px: 0.0, error: message)

# ============================================================================
# Tokenizer
# ============================================================================

# Token kinds. Plain i64 tags rather than an enum: `match` on an enum has no
# native lowering in this compiler, and this runs in the layout hot path.
val TOK_NUM: i64 = 0
val TOK_PLUS: i64 = 1
val TOK_MINUS: i64 = 2
val TOK_STAR: i64 = 3
val TOK_SLASH: i64 = 4
val TOK_LPAREN: i64 = 5
val TOK_RPAREN: i64 = 6

# `dim` is the count of length dimensions a value carries: 0 for a bare number,
# 1 for anything with a unit (including `%`). It is what makes `10px * 5px`
# detectable — that product has dim 2, and CSS has no unit for px².
struct Tok:
    kind: i64
    num: f64
    dim: i64
    # True only when a `+`/`-` had whitespace on BOTH sides, which is what CSS
    # requires of an additive operator inside `calc()`.
    spaced: bool

fn _tok_op(kind: i64, spaced: bool) -> Tok:
    Tok(kind: kind, num: 0.0, dim: 0, spaced: spaced)

fn _is_digit(code: i64) -> bool:
    code >= 48 and code <= 57

fn _is_space(code: i64) -> bool:
    code == 32 or code == 9 or code == 10 or code == 13 or code == 12

fn _is_alpha(code: i64) -> bool:
    (code >= 65 and code <= 90) or (code >= 97 and code <= 122)

# Convert one authored unit into CSS pixels, given the context. Returns a
# multiplier, or a negative sentinel when the unit is unknown — units are
# always positive multipliers, so -1.0 cannot collide with a real answer.
fn _unit_scale(unit: text, ctx: LengthContext) -> f64:
    val u = unit.to_lower()
    if u == "px": return 1.0
    if u == "in": return 96.0
    if u == "cm": return 96.0 / 2.54
    if u == "mm": return 96.0 / 25.4
    if u == "q": return 96.0 / 101.6
    if u == "pt": return 96.0 / 72.0
    if u == "pc": return 16.0
    if u == "em": return ctx.font_size_px
    if u == "rem": return ctx.root_font_size_px
    if u == "ex": return ctx.font_size_px * 0.5
    if u == "ch": return ctx.font_size_px * 0.5
    if u == "vw": return ctx.viewport_width_px / 100.0
    if u == "vh": return ctx.viewport_height_px / 100.0
    if u == "vmin":
        if ctx.viewport_width_px < ctx.viewport_height_px:
            return ctx.viewport_width_px / 100.0
        return ctx.viewport_height_px / 100.0
    if u == "vmax":
        if ctx.viewport_width_px > ctx.viewport_height_px:
            return ctx.viewport_width_px / 100.0
        return ctx.viewport_height_px / 100.0
    -1.0

# The tokenizer's own failure channel. `ok` false means `error` explains why;
# the caller must not look at `toks`.
struct TokResult:
    ok: bool
    toks: [Tok]
    error: text

fn _tokenize(src: text, ctx: LengthContext) -> TokResult:
    var toks: [Tok] = []
    val n = src.len()
    var i = 0
    while i < n:
        val c = src.char_code_at(i)
        if _is_space(c):
            i = i + 1
            continue
        if c == 40:  # (
            toks.push(_tok_op(TOK_LPAREN, false))
            i = i + 1
            continue
        if c == 41:  # )
            toks.push(_tok_op(TOK_RPAREN, false))
            i = i + 1
            continue
        if c == 42:  # *
            toks.push(_tok_op(TOK_STAR, false))
            i = i + 1
            continue
        if c == 47:  # /
            toks.push(_tok_op(TOK_SLASH, false))
            i = i + 1
            continue
        if c == 43 or c == 45:  # + -
            # Whitespace on both sides is what separates a binary operator from
            # the sign of the number that follows it.
            var before = false
            if i == 0:
                before = true
            else:
                before = _is_space(src.char_code_at(i - 1))
            var after = false
            if i + 1 < n:
                after = _is_space(src.char_code_at(i + 1))
            var kind = TOK_PLUS
            if c == 45:
                kind = TOK_MINUS
            toks.push(_tok_op(kind, before and after))
            i = i + 1
            continue
        # A `calc(` / nested function opener: letters immediately followed by
        # `(`. Only `calc` is understood; every other function is an error
        # rather than a silently dropped subtree.
        if _is_alpha(c):
            var j = i
            while j < n and _is_alpha(src.char_code_at(j)):
                j = j + 1
            if j < n and src.char_code_at(j) == 40:
                val name = src.slice(i, j).to_lower()
                if name != "calc":
                    return TokResult(ok: false, toks: [], error: "unsupported function '{name}()' in length")
                toks.push(_tok_op(TOK_LPAREN, false))
                i = j + 1
                continue
            return TokResult(ok: false, toks: [], error: "unexpected identifier in length: '{src.slice(i, j)}'")
        if _is_digit(c) or c == 46:  # digit or .
            var j = i
            while j < n and _is_digit(src.char_code_at(j)):
                j = j + 1
            if j < n and src.char_code_at(j) == 46:
                j = j + 1
                while j < n and _is_digit(src.char_code_at(j)):
                    j = j + 1
            val num_text = src.slice(i, j)
            val magnitude = num_text.to_f64()
            # Unit: letters, or a single `%`.
            var k = j
            while k < n and _is_alpha(src.char_code_at(k)):
                k = k + 1
            var dim = 0
            var scaled = magnitude
            if k > j:
                val unit = src.slice(j, k)
                val scale = _unit_scale(unit, ctx)
                if scale < 0.0:
                    return TokResult(ok: false, toks: [], error: "unknown unit '{unit}' in length")
                scaled = magnitude * scale
                dim = 1
                i = k
            else:
                if j < n and src.char_code_at(j) == 37:  # %
                    if not ctx.percent_resolvable:
                        return TokResult(ok: false, toks: [], error: "percentage has no basis in this context")
                    scaled = magnitude * ctx.percent_basis_px / 100.0
                    dim = 1
                    i = j + 1
                else:
                    i = j
            toks.push(Tok(kind: TOK_NUM, num: scaled, dim: dim, spaced: false))
            continue
        return TokResult(ok: false, toks: [], error: "unexpected character in length at offset {i}")
    TokResult(ok: true, toks: toks, error: "")

# ============================================================================
# Recursive-descent evaluator
# ============================================================================

# One sub-parse's outcome: the value and its dimension, plus how far the parser
# got. The index is threaded through the return value rather than held in a
# mutable cursor object so that no float ever lives in a Dict — `Dict.get` on
# f64 values is unreliable under the native lanes.
struct Eval:
    ok: bool
    num: f64
    dim: i64
    next: i64
    error: text

fn _eval_err(message: text) -> Eval:
    Eval(ok: false, num: 0.0, dim: 0, next: 0, error: message)

fn _eval_ok(num: f64, dim: i64, next: i64) -> Eval:
    Eval(ok: true, num: num, dim: dim, next: next, error: "")

fn _parse_primary(toks: [Tok], pos: i64) -> Eval:
    if pos >= toks.len():
        return _eval_err("unexpected end of expression")
    val t = toks[pos]
    if t.kind == TOK_NUM:
        return _eval_ok(t.num, t.dim, pos + 1)
    if t.kind == TOK_LPAREN:
        val inner = _parse_sum(toks, pos + 1)
        if not inner.ok:
            return inner
        if inner.next >= toks.len() or toks[inner.next].kind != TOK_RPAREN:
            return _eval_err("missing ')' in expression")
        return _eval_ok(inner.num, inner.dim, inner.next + 1)
    _eval_err("expected a value in expression")

# A leading `+`/`-` before a value is a SIGN, not an operator. CSS writes signed
# numbers this way (`-1.5em`), and inside `calc()` this is exactly the case the
# whitespace rule distinguishes from subtraction.
fn _parse_unary(toks: [Tok], pos: i64) -> Eval:
    if pos < toks.len():
        val t = toks[pos]
        if t.kind == TOK_PLUS:
            return _parse_unary(toks, pos + 1)
        if t.kind == TOK_MINUS:
            val inner = _parse_unary(toks, pos + 1)
            if not inner.ok:
                return inner
            return _eval_ok(0.0 - inner.num, inner.dim, inner.next)
    _parse_primary(toks, pos)

fn _parse_product(toks: [Tok], pos: i64) -> Eval:
    var left = _parse_unary(toks, pos)
    if not left.ok:
        return left
    var idx = left.next
    var acc = left.num
    var acc_dim = left.dim
    while idx < toks.len():
        val op = toks[idx]
        if op.kind != TOK_STAR and op.kind != TOK_SLASH:
            break
        val right = _parse_unary(toks, idx + 1)
        if not right.ok:
            return right
        if op.kind == TOK_STAR:
            # CSS Values: at least one operand of `*` must be a plain number.
            # dim 1 * dim 1 would be an area, which no CSS property accepts.
            if acc_dim + right.dim > 1:
                return _eval_err("invalid multiplication: at least one operand must be unitless")
            acc = acc * right.num
            acc_dim = acc_dim + right.dim
        else:
            if right.dim != 0:
                return _eval_err("invalid division: the divisor must be unitless")
            if right.num == 0.0:
                return _eval_err("division by zero")
            acc = acc / right.num
        idx = right.next
    _eval_ok(acc, acc_dim, idx)

fn _parse_sum(toks: [Tok], pos: i64) -> Eval:
    var left = _parse_product(toks, pos)
    if not left.ok:
        return left
    var idx = left.next
    var acc = left.num
    var acc_dim = left.dim
    while idx < toks.len():
        val op = toks[idx]
        if op.kind != TOK_PLUS and op.kind != TOK_MINUS:
            break
        if not op.spaced:
            return _eval_err("'+' and '-' inside calc() require whitespace on both sides")
        val right = _parse_product(toks, idx + 1)
        if not right.ok:
            return right
        # Addition is only defined between like kinds. A percentage has already
        # been resolved to px by the tokenizer, so `100% - 20px` is a legal
        # px+px sum here; `1px + 2` is not, and stays an error.
        if acc_dim != right.dim:
            return _eval_err("cannot add or subtract a length and a plain number")
        if op.kind == TOK_PLUS:
            acc = acc + right.num
        else:
            acc = acc - right.num
        idx = right.next
    _eval_ok(acc, acc_dim, idx)

# ============================================================================
# Entry points
# ============================================================================

# Resolve any CSS length-or-percentage-or-calc to CSS pixels.
pub fn parse_length_px(raw: text, ctx: LengthContext) -> CssLengthResult:
    """Return the pixel value of the CSS length raw, or an explained failure."""
    val src = raw.trim()
    if src.len() == 0:
        return css_length_err("empty length")
    val tr = _tokenize(src, ctx)
    if not tr.ok:
        return css_length_err(tr.error)
    val toks = tr.toks
    if toks.len() == 0:
        return css_length_err("empty length")
    val ev = _parse_sum(toks, 0)
    if not ev.ok:
        return css_length_err(ev.error)
    if ev.next != toks.len():
        return css_length_err("trailing content after a complete length")
    # A bare number is only a length when it is zero — CSS's one exemption.
    if ev.dim == 0 and ev.num != 0.0:
        return css_length_err("a non-zero number needs a unit to be a length")
    css_length_ok(ev.num)

# `calc(...)` specifically: the same evaluator, but the wrapper is mandatory.
# Kept separate so a caller that has already split `calc()` out of a shorthand
# cannot accidentally accept a bare dimension where the grammar wanted a
# function.
pub fn parse_calc_px(raw: text, ctx: LengthContext) -> CssLengthResult:
    """Return the pixel value of a calc() expression, or an explained failure."""
    val src = raw.trim()
    val lower = src.to_lower()
    if not lower.starts_with("calc("):
        return css_length_err("not a calc() expression")
    parse_length_px(src, ctx)

# True when `raw` is syntactically a `calc()` call. Callers that keep authored
# values around (blink's `Length` stores the unit verbatim) use this to decide
# whether a value needs the evaluator at all.
pub fn is_calc(raw: text) -> bool:
    """Return true when raw is a calc() expression."""
    raw.trim().to_lower().starts_with("calc(")
