# float_class_pure.spl — pure-Simple twins for the IEEE-754 classification
# runtime symbols, written for the rt_* dual-implementation directive.
#
# Pairs (see test/01_unit/lib/common/spec/dual_run_shadow_spec.spl):
#   is_nan_f64 <-> rt_math_is_nan
#   is_inf_f64 <-> rt_math_is_inf
#
# Both are decided from IEEE-754 algebra alone — no bitcast builtin, and
# deliberately no `1.0 / 0.0`: `bin/simple test` runs the tree-walk
# interpreter, where division by zero raises "semantic: division by zero"
# instead of yielding an infinity (the same constraint documented in
# src/lib/common/spec/dual_run.spl's sign-of-zero note).

pub fn is_nan_f64(x: f64) -> bool:
    # NaN is the only value that compares unequal to itself.
    x != x

pub fn is_inf_f64(x: f64) -> bool:
    # For every FINITE x, x - x == 0. For +inf and -inf, inf - inf is NaN,
    # which compares unequal to itself. NaN itself is excluded first by the
    # x == x guard, so this answers true for exactly +inf and -inf — matching
    # Rust's f64::is_infinite and the C runtime's isinf().
    if x != x:
        return false
    val d = x - x
    d != d
