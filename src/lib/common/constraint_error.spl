"""
# std.constraint_error - Range-constraint violation error

Returned (as `Err`) by facades that SFFI generation emits for an extern whose
return unit carries an integer range: the raw value came back outside the
declared bounds. See `compiler.tools.sffi_gen.constrained_unit_gen`.
"""

class ConstraintError:
    """A value that fell outside its unit's declared inclusive range."""
    unit_name: text
    value: i64
    # Bounds as written in the declaration; "" means unbounded on that side.
    min_text: text
    max_text: text
    message: text

    static fn out_of_range(unit_name: text, value: i64, min_text: text, max_text: text) -> ConstraintError:
        val lo = if min_text == "": "-inf" else: min_text
        val hi = if max_text == "": "+inf" else: max_text
        ConstraintError(unit_name: unit_name, value: value, min_text: min_text, max_text: max_text, message: "{unit_name} value {value} outside [{lo}, {hi}]")

export ConstraintError
