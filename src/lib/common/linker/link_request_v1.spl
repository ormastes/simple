"""LinkRequestV1 — the plain-struct job description for a link (design §6.2, D8).

Carries a `KpfSchemaHeaderV1` like every other KPF wire record, plus the
target triple, the digests that identify inputs/semantics/sysroot, a required
feature bit set, opaque layout/debug handles, and a reproducibility flag.
Not registered with the S1 schema generator (`kernel_plugin_fabric.md`
"V1 schema has one exclusive owner") until a handoff lands.
"""

use std.common.kernel_plugin.ids.{KpfDigest256}
use std.common.kernel_plugin.schema_header.{KpfSchemaHeaderV1, KpfSchemaRequirementV1, kpf_validate_schema_header_v1}

pub struct LinkTargetV1:
    arch: u32
    os: u32
    abi: u32
    object_format: u32
    endian: u32
    address_width: u32

pub struct LinkRequestV1:
    header: KpfSchemaHeaderV1
    target: LinkTargetV1
    inputs_manifest_digest: KpfDigest256
    output_contract: u32
    semantic_profile_digest: KpfDigest256
    runtime_sysroot_digest: KpfDigest256
    required_features: u64
    layout_handle: u64
    debug_handle: u64
    reproducibility: u32

export LinkTargetV1, LinkRequestV1

pub fn link_request_v1_validate(request: LinkRequestV1, requirement: KpfSchemaRequirementV1) -> text:
    """Return "" when `request` is well-formed against `requirement`, else the rejection reason."""
    val header_status = kpf_validate_schema_header_v1(request.header, requirement)
    if not header_status.accepted():
        return "schema header invalid: code={header_status.code()}"
    if request.target.address_width != 32 and request.target.address_width != 64:
        return "target.address_width must be 32 or 64"
    if request.reproducibility > 1:
        return "reproducibility must be 0 or 1"
    ""

export link_request_v1_validate
