"""LinkExecutionPolicyV1 — the resource-budget knob for a link job (design §6.2, §8, D8).

`mode` selects between the fast (resident) and bounded (windowed/spilled)
compositions from design §8; `Auto` records the decision at plan time rather
than picking a `ResolveMode` discriminant (design §6.1, R-doc R04).
"""

use std.common.kernel_plugin.schema_header.{KpfSchemaHeaderV1, KpfSchemaRequirementV1, kpf_validate_schema_header_v1}

pub enum LinkExecutionModeV1:
    Fast
    Bounded
    Auto

impl LinkExecutionModeV1:
    pub fn name() -> text:
        match self:
            case Fast: "Fast"
            case Bounded: "Bounded"
            case Auto: "Auto"

pub fn link_execution_mode_v1_from_code(code: i64) -> Option<LinkExecutionModeV1>:
    """Total decoder: any code outside {0,1,2} is rejected, never coerced."""
    if code == 0:
        return Some(LinkExecutionModeV1.Fast)
    if code == 1:
        return Some(LinkExecutionModeV1.Bounded)
    if code == 2:
        return Some(LinkExecutionModeV1.Auto)
    nil

export LinkExecutionModeV1, link_execution_mode_v1_from_code

pub struct LinkExecutionPolicyV1:
    header: KpfSchemaHeaderV1
    mode: LinkExecutionModeV1
    job_memory_limit_bytes: u64
    scratch_limit_bytes: u64
    max_workers: u32
    allowed_placements: u64
    enforcement_requirement: u32

export LinkExecutionPolicyV1

pub fn link_policy_v1_validate(policy: LinkExecutionPolicyV1, requirement: KpfSchemaRequirementV1) -> text:
    """Return "" when `policy` is well-formed against `requirement`, else the rejection reason."""
    val header_status = kpf_validate_schema_header_v1(policy.header, requirement)
    if not header_status.accepted():
        return "schema header invalid: code={header_status.code()}"
    if policy.max_workers < 1:
        return "max_workers must be >= 1"
    if policy.enforcement_requirement > 1:
        return "enforcement_requirement must be 0 or 1"
    val is_bounded = match policy.mode:
        case Bounded: true
        case _: false
    if is_bounded and policy.job_memory_limit_bytes == 0:
        return "Bounded mode requires job_memory_limit_bytes > 0"
    ""

export link_policy_v1_validate
