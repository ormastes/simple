# Render Scene CSS Types — CSS rule, selector, declaration, and value types.
#
# Provides: CSSRule, RsCssDeclaration, RsCssValue, Selector, SelectorPart.
#
# Renamed from CSSValue/CSSDeclaration (2026-08-19): those names collide with
# the browser_engine enums in style/animation.spl, and whole-program
# co-compilation resolves variant constructors against the WRONG enum
# (CSSValue.Percentage -> "unknown variant"; CSSValue.Color(color:) ->
# "cannot convert function to int"), breaking the CSS-animation reconcile
# path whenever both modules load. See
# doc/08_tracking/bug/cross_module_cssvalue_enum_collision_2026-08-19.md.

use std.common.color.types.{Color}

# A single CSS property + value pair.
struct RsCssDeclaration:
    property: text
    value: RsCssValue

# A parsed CSS value.
enum RsCssValue:
    # Numeric length: value in px/em/etc, unit string
    Length(v: f64, unit: text)
    # Named keyword: "auto", "block", "flex", etc.
    Keyword(v: text)
    # Color value
    Color(c: Color)
    # Percentage
    Percent(v: f64)
    # Unparsed raw string
    Raw(v: text)

# One part of a CSS selector.
enum SelectorPart:
    Type(name: text)
    Class(name: text)
    Id(name: text)
    Universal

# A CSS selector (list of parts — all must match, i.e. compound selector).
struct Selector:
    parts: [SelectorPart]

# A complete CSS rule: selector list + declarations.
struct CSSRule:
    selectors: [Selector]
    declarations: [RsCssDeclaration]
