# Pure-Simple twins for the `rt_string_*` pure-computation family.
#
# Each function below is a REFERENCE REIMPLEMENTATION of the C/Rust runtime
# entry point named in its comment, not a wrapper: none of them declares or
# calls the extern it mirrors. The C side is the reference -- where its
# behaviour is surprising (a width at or below the current length returning the
# receiver unchanged; `zfill` keeping a leading sign in front of the zeros;
# `substr` counting CHARACTERS while `find_all` reports BYTE offsets) the twin
# mirrors the quirk deliberately and says so, rather than "fixing" it.
#
# Machinery note: `.chars()` (codepoint array) and `string_to_byte_array` are
# genuinely different primitives from the functions being twinned, in the same
# spirit as `std.common.text_ascii`'s alphabet-lookup construction.
#
# Domain: every function here is fully general over Unicode input. Deliberately
# ABSENT are the case-mapping and character-class entry points
# (`capitalize`/`swapcase`/`title`/`is_alpha`/`is_alnum`/`is_whitespace`),
# whose reference behaviour is full Unicode `to_uppercase`/`is_alphabetic`; an
# ASCII-table twin of those would agree only on a restricted domain, which is
# exactly the kind of twin that makes a dual-run harness certify a lie.

# `char_count` / `rt_text_count_codepoints` -- number of Unicode scalar values
# (contrast `len`, which is the BYTE count).
#
# Machinery: walks the codepoint sequence and counts it. That is genuinely
# different construction from the reference entry points, which scan UTF-8
# LEAD BYTES (and, for `_cached`, memoise the answer) -- but it does share the
# `chars` primitive, the same level of sharing the pre-existing
# `std.common.text_ascii` twins accept with `char_at`/`index_of`. A lead-byte
# twin was written first and had to be withdrawn: it needs
# `rt_string_to_byte_array`, which is NOT registered in the interpreter's
# extern dispatch, so it cannot run on the engine the dual-run gate uses.
#
# The reference returns -1 for a non-text receiver; a `text` parameter here
# cannot express that case, so the twin's domain is text only.
pub fn twin_char_count(s: text) -> i64:
    val chars = s.chars()
    var n = 0
    var i = 0
    while i < chars.len():
        n = n + 1
        i = i + 1
    return n

# `chomp` -- strip exactly ONE trailing line terminator: CRLF, LF or CR.
pub fn twin_chomp(s: text) -> text:
    val n = s.len()
    if n >= 2 and s.substring(n - 2, n) == "\r\n":
        return s.substring(0, n - 2)
    if n >= 1 and s.substring(n - 1, n) == "\n":
        return s.substring(0, n - 1)
    if n >= 1 and s.substring(n - 1, n) == "\r":
        return s.substring(0, n - 1)
    return s

# `remove_prefix` -- strip `prefix` ONCE if present, else return the receiver.
# An empty prefix is present at every position, so it is a no-op.
pub fn twin_remove_prefix(s: text, prefix: text) -> text:
    val p = prefix.len()
    if p == 0:
        return s
    if s.len() < p:
        return s
    if s.substring(0, p) == prefix:
        return s.substring(p, s.len())
    return s

# `remove_suffix` -- strip `suffix` ONCE if present, else return the receiver.
pub fn twin_remove_suffix(s: text, suffix: text) -> text:
    val p = suffix.len()
    if p == 0:
        return s
    val n = s.len()
    if n < p:
        return s
    if s.substring(n - p, n) == suffix:
        return s.substring(0, n - p)
    return s

# `trim_start_matches` -- REPEATEDLY strip `pattern` from the front.
# An empty pattern must not loop forever; the reference's
# `trim_start_matches("")` is a no-op, and this mirrors that.
pub fn twin_trim_start_matches(s: text, pattern: text) -> text:
    val p = pattern.len()
    if p == 0:
        return s
    var out = s
    while out.len() >= p and out.substring(0, p) == pattern:
        out = out.substring(p, out.len())
    return out

# `trim_end_matches` -- REPEATEDLY strip `pattern` from the end.
pub fn twin_trim_end_matches(s: text, pattern: text) -> text:
    val p = pattern.len()
    if p == 0:
        return s
    var out = s
    while out.len() >= p and out.substring(out.len() - p, out.len()) == pattern:
        out = out.substring(0, out.len() - p)
    return out

# First character of `pad`, or a space when `pad` is empty -- mirrors the
# reference's `pad_char_or_space`.
fn twin_pad_char(pad: text) -> text:
    if pad.len() == 0:
        return " "
    return pad.char_at(0)

# `pad_left` -- left-pad to `width` CHARACTERS (not bytes).
# QUIRK MIRRORED: `width <= current` returns the receiver UNCHANGED, so a width
# smaller than the input never truncates and a NEGATIVE width is a no-op.
pub fn twin_pad_left(s: text, width: i64, pad: text) -> text:
    val current = twin_char_count(s)
    if width <= current:
        return s
    val c = twin_pad_char(pad)
    var fill = ""
    var i = 0
    while i < width - current:
        fill = fill + c
        i = i + 1
    return fill + s

# `pad_right` -- right-pad to `width` CHARACTERS. Same no-truncate quirk.
pub fn twin_pad_right(s: text, width: i64, pad: text) -> text:
    val current = twin_char_count(s)
    if width <= current:
        return s
    val c = twin_pad_char(pad)
    var out = s
    var i = 0
    while i < width - current:
        out = out + c
        i = i + 1
    return out

# `center` -- pad both sides to `width` CHARACTERS.
# QUIRK MIRRORED: an odd remainder puts the EXTRA character on the RIGHT
# (left = total / 2), and `width <= current` returns the receiver unchanged.
pub fn twin_center(s: text, width: i64, pad: text) -> text:
    val current = twin_char_count(s)
    if width <= current:
        return s
    val total = width - current
    val left = total / 2
    val c = twin_pad_char(pad)
    var head = ""
    var i = 0
    while i < left:
        head = head + c
        i = i + 1
    var tail = ""
    var j = 0
    while j < total - left:
        tail = tail + c
        j = j + 1
    return head + s + tail

# `zfill` -- left-pad with '0' to `width` CHARACTERS.
# QUIRK MIRRORED: a leading plus/minus stays in FRONT of the zeros, so
# "-7" zfilled to 4 is "-007", not "00-7". The sign test is on the first BYTE.
pub fn twin_zfill(s: text, width: i64) -> text:
    val current = twin_char_count(s)
    if width <= current:
        return s
    var sign = ""
    var rest = s
    if s.len() >= 1:
        val head = s.substring(0, 1)
        if head == "+" or head == "-":
            sign = head
            rest = s.substring(1, s.len())
    var zeros = ""
    var i = 0
    while i < width - current:
        zeros = zeros + "0"
        i = i + 1
    return sign + zeros + rest

# `repeat` -- concatenate `count` copies.
# QUIRK MIRRORED: `count <= 0` yields the empty text (never an error), and an
# empty receiver yields the empty text for any count.
pub fn twin_repeat(s: text, count: i64) -> text:
    if count <= 0 or s.len() == 0:
        return ""
    var out = ""
    var i = 0
    while i < count:
        out = out + s
        i = i + 1
    return out

# `squeeze` -- collapse runs of the same adjacent character, restricted to the
# characters in `set`. An EMPTY set squeezes nothing (matching an explicit
# empty-string argument on the reference side); the reference's "no argument =
# squeeze everything" case is reached through tagged nil, which a `text`
# parameter cannot express, so this twin covers the explicit-set form only.
pub fn twin_squeeze(s: text, set: text) -> text:
    if s.len() == 0:
        return ""
    val chars = s.chars()
    var out = ""
    var prev = ""
    var have_prev = false
    var i = 0
    while i < chars.len():
        val c = chars[i]
        val squeezable = set.index_of(c) >= 0
        if not squeezable or not have_prev or c != prev:
            out = out + c
        prev = c
        have_prev = true
        i = i + 1
    return out

# `substr` -- CHARACTER-indexed substring; negative start/length clamp to 0.
pub fn twin_substr(s: text, start: i64, length: i64) -> text:
    var st = start
    if st < 0:
        st = 0
    var ln = length
    if ln < 0:
        ln = 0
    val chars = s.chars()
    var out = ""
    var i = st
    var taken = 0
    while i < chars.len() and taken < ln:
        out = out + chars[i]
        i = i + 1
        taken = taken + 1
    return out

# `substr_from` -- CHARACTER-indexed substring to the end; negative start
# clamps to 0.
pub fn twin_substr_from(s: text, start: i64) -> text:
    var st = start
    if st < 0:
        st = 0
    val chars = s.chars()
    var out = ""
    var i = st
    while i < chars.len():
        out = out + chars[i]
        i = i + 1
    return out

# `replace_first` -- replace only the FIRST occurrence of `pattern`.
# QUIRK MIRRORED: the reference is Rust's `replacen(p, r, 1)`, for which an
# EMPTY pattern matches at position 0, so replacing "" with "X" in "ab" yields
# "Xab" rather than leaving the receiver alone.
pub fn twin_replace_first(s: text, pattern: text, replacement: text) -> text:
    if pattern.len() == 0:
        return replacement + s
    val at = s.index_of(pattern)
    if at < 0:
        return s
    return s.substring(0, at) + replacement + s.substring(at + pattern.len(), s.len())

# `find_all` -- BYTE offsets of every NON-OVERLAPPING match.
# QUIRK MIRRORED: byte offsets (matching find/index_of/rfind), and an EMPTY
# needle yields an EMPTY array rather than one offset per position.
pub fn twin_find_all(s: text, needle: text) -> [i64]:
    var out: [i64] = []
    val n = needle.len()
    if n == 0:
        return out
    var base = 0
    while base <= s.len() - n:
        val rest = s.substring(base, s.len())
        val at = rest.index_of(needle)
        if at < 0:
            return out
        out = out.push(base + at)
        base = base + at + n
    return out

# `sorted` -- the receiver's codepoints in ascending order.
# Insertion sort over single-codepoint texts; UTF-8 byte order and codepoint
# order coincide, so the text comparison is the codepoint comparison.
pub fn twin_sorted(s: text) -> text:
    val chars = s.chars()
    var acc: [text] = []
    var i = 0
    while i < chars.len():
        val c = chars[i]
        var j = 0
        while j < acc.len() and acc[j] <= c:
            j = j + 1
        acc = acc.insert(j, c)
        i = i + 1
    var out = ""
    var k = 0
    while k < acc.len():
        out = out + acc[k]
        k = k + 1
    return out

# `partition` -- split at the FIRST occurrence into [before, separator, after].
# QUIRK MIRRORED: a separator that is empty or does not occur yields
# [receiver, "", ""] -- the receiver lands in the FIRST slot.
pub fn twin_partition(s: text, sep: text) -> [text]:
    if sep.len() == 0:
        return [s, "", ""]
    val at = s.index_of(sep)
    if at < 0:
        return [s, "", ""]
    return [s.substring(0, at), sep, s.substring(at + sep.len(), s.len())]

# `rpartition` -- split at the LAST occurrence into [before, separator, after].
# QUIRK MIRRORED: on a miss the receiver lands in the LAST slot (["", "", s]),
# the mirror image of `partition`'s miss.
pub fn twin_rpartition(s: text, sep: text) -> [text]:
    if sep.len() == 0:
        return ["", "", s]
    val at = s.last_index_of(sep)
    if at < 0:
        return ["", "", s]
    return [s.substring(0, at), sep, s.substring(at + sep.len(), s.len())]

export twin_replace_first, twin_find_all, twin_sorted, twin_partition, twin_rpartition
export twin_char_count, twin_chomp, twin_remove_prefix, twin_remove_suffix, twin_trim_start_matches, twin_trim_end_matches, twin_pad_left, twin_pad_right, twin_center, twin_zfill, twin_repeat, twin_squeeze, twin_substr, twin_substr_from
