# Pure-Simple contract for platform-owned measurement observations.
#
# This module validates already-observed public data. Runtime I/O and platform
# collection belong to platform owner modules, outside this neutral boundary.

mod lib.common.platform_measurement_observation

use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}

val PLATFORM_MEASUREMENT_OBSERVATION_SCHEMA: text =
    "platform-measurement-observation-v1"

enum PlatformPeakMemoryMetric:
    PeakResidentSetKiB
    GuestHeapCommittedHighWaterKiB

struct PlatformMeasurementObservation:
    schema: text
    observation_sha256: text
    host_os: text
    host_arch: text
    runtime_lane: text
    clock_source: text
    clock_epoch_semantics: text
    session_nonce_sha256: text
    observer_artifact_sha256: text
    peak_memory_metric: PlatformPeakMemoryMetric
    peak_memory_kib: i64

fn _platform_measurement_frame(key: text, value: text) -> text:
    key.len().to_text() + ":" + key + "=" + value.len().to_text() +
        ":" + value + ";"

fn _platform_peak_memory_metric_name(
        value: PlatformPeakMemoryMetric) -> text:
    if value == PlatformPeakMemoryMetric.PeakResidentSetKiB:
        return "peak-resident-set-kib"
    "guest-heap-committed-high-water-kib"

fn _platform_measurement_identity_valid(value: text) -> bool:
    if value == "" or value != value.trim(): return false
    if value.contains("|") or value.contains("=") or value.contains(";"):
        return false
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if code < 32 or code == 127: return false
        index = index + 1
    true

fn _platform_measurement_material(
        value: PlatformMeasurementObservation) -> text:
    _platform_measurement_frame("schema", value.schema) +
    _platform_measurement_frame("host_os", value.host_os) +
    _platform_measurement_frame("host_arch", value.host_arch) +
    _platform_measurement_frame("runtime_lane", value.runtime_lane) +
    _platform_measurement_frame("clock_source", value.clock_source) +
    _platform_measurement_frame(
        "clock_epoch_semantics", value.clock_epoch_semantics) +
    _platform_measurement_frame(
        "session_nonce_sha256", value.session_nonce_sha256) +
    _platform_measurement_frame(
        "observer_artifact_sha256", value.observer_artifact_sha256) +
    _platform_measurement_frame(
        "peak_memory_metric",
        _platform_peak_memory_metric_name(value.peak_memory_metric)) +
    _platform_measurement_frame(
        "peak_memory_kib", value.peak_memory_kib.to_text())

fn platform_measurement_observation_sha256(
        value: PlatformMeasurementObservation) -> text:
    sha256_text(_platform_measurement_material(value))

fn platform_measurement_observation_reason(
        value: PlatformMeasurementObservation) -> text:
    if value.schema != PLATFORM_MEASUREMENT_OBSERVATION_SCHEMA:
        return "schema-invalid"
    if not _platform_measurement_identity_valid(value.host_os):
        return "host-os-invalid"
    if not _platform_measurement_identity_valid(value.host_arch):
        return "host-arch-invalid"
    if not _platform_measurement_identity_valid(value.runtime_lane):
        return "runtime-lane-invalid"
    if not _platform_measurement_identity_valid(value.clock_source):
        return "clock-source-invalid"
    if not _platform_measurement_identity_valid(value.clock_epoch_semantics):
        return "clock-epoch-semantics-invalid"
    if not sha256_lower_hex_valid(value.session_nonce_sha256):
        return "session-nonce-sha256-invalid"
    if not sha256_lower_hex_valid(value.observer_artifact_sha256):
        return "observer-artifact-sha256-invalid"
    if value.peak_memory_kib <= 0:
        return "peak-memory-kib-invalid"
    if not sha256_lower_hex_valid(value.observation_sha256):
        return "observation-sha256-invalid"
    if value.observation_sha256 !=
            platform_measurement_observation_sha256(value):
        return "observation-sha256-mismatch"
    "ready"

fn platform_measurement_observation_valid(
        value: PlatformMeasurementObservation) -> bool:
    platform_measurement_observation_reason(value) == "ready"

fn platform_measurement_process_rss_eligible(
        value: PlatformMeasurementObservation) -> bool:
    platform_measurement_observation_valid(value) and
        value.peak_memory_metric ==
            PlatformPeakMemoryMetric.PeakResidentSetKiB

export PLATFORM_MEASUREMENT_OBSERVATION_SCHEMA
export PlatformPeakMemoryMetric
export PlatformMeasurementObservation
export platform_measurement_observation_sha256
export platform_measurement_observation_reason
export platform_measurement_observation_valid
export platform_measurement_process_rss_eligible
