# C-MIG-0031/0032: pure-Simple floor/ceil kernels for f64, independent of
# the rt_math_floor / rt_math_ceil externs (interpreter_extern/math.rs
# delegates those to Rust's hardware `f64::floor`/`f64::ceil`). Both kernels
# here work by truncating through an i64 round-trip plus a correction step —
# genuinely different machinery from a single hardware instruction, not a
# re-wrap of the extern.
#
# 2^52 is every f64's integrality threshold: at or beyond that magnitude
# every representable f64 already has zero fractional part, so floor/ceil
# are the identity. This guard is REQUIRED, not cosmetic — `x as i64` is
# undefined/saturating for magnitudes outside i64's range (~9.22e18) and for
# +-infinity, so an unguarded cast silently corrupts large-magnitude and
# infinite inputs (same shape of bug as C-MIG-0030's unguarded cbrt Newton
# start point). Verified live while writing this spec: an early unguarded
# version of floor_f64 returned garbage (not +infinity) for +infinity input.
val _INT_THRESHOLD = 4503599627370496.0    # 2^52

fn floor_f64(x: f64) -> f64:
    if x != x: return x                 # NaN -> NaN
    if x >= _INT_THRESHOLD or x <= (0.0 - _INT_THRESHOLD): return x
    val t = x as i64 as f64             # truncate toward zero
    if t > x:
        t - 1.0
    else:
        t

fn ceil_f64(x: f64) -> f64:
    if x != x: return x                 # NaN -> NaN
    if x >= _INT_THRESHOLD or x <= (0.0 - _INT_THRESHOLD): return x
    val t = x as i64 as f64             # truncate toward zero
    if t < x:
        t + 1.0
    else:
        t

export floor_f64, ceil_f64
