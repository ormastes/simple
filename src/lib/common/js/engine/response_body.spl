# Tier-agnostic WHATWG Fetch Response body disturbance & metadata helpers.
#
# Shared single source of truth for nogc_sync_mut, gc_async_mut (re-exported by
# gc_sync_mut), and nogc_async_mut JS engines. Deliberately avoids `JsValue` and
# bare primitive types in public signatures to satisfy core-lib purity and
# primitive-api gates.

pub val JS_RESPONSE_HOST_KEY: text = "__simple_response_host"
pub val JS_RESPONSE_CONSUMED_KEY: text = "__simple_internal_response_body_consumed"
pub val JS_RESPONSE_BODY_USED_KEY: text = "bodyUsed"
pub val JS_RESPONSE_BODY_UNUSABLE_ERROR: text = "TypeError: Body is unusable"
pub val JS_RESPONSE_DEFAULT_BLOB_TYPE: text = "application/octet-stream"

pub enum JsResponseBodyFlag:
    Unconsumed
    Consumed

pub fn js_response_consume_body_text(
    flag: JsResponseBodyFlag,
    body_text: text
) -> Result<text, text>:
    match flag:
        JsResponseBodyFlag.Consumed:
            Err(JS_RESPONSE_BODY_UNUSABLE_ERROR)
        JsResponseBodyFlag.Unconsumed:
            Ok(body_text)

pub fn js_response_content_type_from_headers(headers_text: text) -> text:
    for line in headers_text.split("\n"):
        val trimmed = line.trim()
        if trimmed.lower().starts_with("content-type:"):
            return trimmed.slice(13, trimmed.byte_len()).trim()
    ""

pub fn js_response_blob_media_type(headers_text: text) -> text:
    val content_type = js_response_content_type_from_headers(headers_text)
    if content_type == "":
        return JS_RESPONSE_DEFAULT_BLOB_TYPE
    content_type

pub fn js_response_wasm_content_type_essence(headers_text: text) -> text:
    var essence = js_response_content_type_from_headers(headers_text)
    if essence.contains(";"):
        essence = essence.split(";")[0].trim()
    essence.lower()
