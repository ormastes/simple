fn js_trim_text(value: text, trim_start: bool, trim_end: bool) -> text:
    var start = 0
    var end = value.len()
    if trim_start:
        while start < end and (value.byte_at(start) == 32 or value.byte_at(start) == 9 or value.byte_at(start) == 10):
            start = start + 1
    if trim_end:
        while end > start and (value.byte_at(end - 1) == 32 or value.byte_at(end - 1) == 9 or value.byte_at(end - 1) == 10):
            end = end - 1
    value.slice(start, end)
