# JavaScript native-dispatch ID contract + pure dispatch for the Simple Browser Platform.
#
# PURE TIER OWNER (core-purity split of
# doc/08_tracking/bug/core_purity_runtime_split_blocked_native_const_resolution_2026-07-08):
# this module owns only the pure NATIVE_* id constants and the pure
# dispatch_native for the basic built-in families (console, parse, Math, JSON,
# timers, Symbol). The impure JsRuntime host class lives in the full runtime at
# src/lib/nogc_sync_mut/js/engine/runtime.spl, reached by hosts through
# `use std.js.engine.runtime.{JsRuntime}` (tier fallback). Do not re-add
# interpreter/parser imports or the JsRuntime class here — check-core-lib-purity.shs
# ratchets this file.

use std.common.js.types.js_types.JsValue
use std.common.js.builtins.json.{json_parse}
use lib.common.js.engine.js_error.{JsLogger}

# Safe NaN/Infinity sentinels — immune to _RT_NAN function registry ordering
val _RT_NAN: f64 = -9999999999.999
val _RT_INF: f64 = 9999999999.0
val _RT_NEG_INF: f64 = -9999999999.0

# ── Prototype chain (moved with JsRuntime to the full runtime; kept name free) ──
# PrototypeChain and class JsRuntime now live in
# src/lib/nogc_sync_mut/js/engine/runtime.spl (std.js.engine.runtime tier fallback).

# ── Symbol ID counter ───────────────────────────────────────────────────
var _symbol_counter = 0

fn _next_symbol_id() -> i64:
    _symbol_counter = _symbol_counter + 1
    _symbol_counter

# ── Native function IDs ─────────────────────────────────────────────────

# We assign fixed IDs to native (built-in) functions.
# The interpreter dispatches by checking these IDs in eval_call.

pub val NATIVE_CONSOLE_LOG = -1
pub val NATIVE_CONSOLE_ERROR = -2
pub val NATIVE_CONSOLE_WARN = -3
pub val NATIVE_PARSE_INT = -10
pub val NATIVE_PARSE_FLOAT = -11
pub val NATIVE_IS_NAN = -12
pub val NATIVE_IS_FINITE = -13
pub val NATIVE_STRING_CONSTRUCTOR = -14
pub val NATIVE_NUMBER_CONSTRUCTOR = -15
pub val NATIVE_BOOLEAN_CONSTRUCTOR = -16
pub val NATIVE_MATH_FLOOR = -20
pub val NATIVE_MATH_CEIL = -21
pub val NATIVE_MATH_ROUND = -22
pub val NATIVE_MATH_RANDOM = -23
pub val NATIVE_MATH_ABS = -24
pub val NATIVE_MATH_MAX = -25
pub val NATIVE_MATH_MIN = -26
pub val NATIVE_MATH_SQRT = -27
pub val NATIVE_MATH_POW = -28
pub val NATIVE_JSON_PARSE = -30
pub val NATIVE_JSON_STRINGIFY = -31
pub val NATIVE_SET_TIMEOUT = -40
pub val NATIVE_SET_INTERVAL = -41
pub val NATIVE_CLEAR_TIMEOUT = -42
pub val NATIVE_CLEAR_INTERVAL = -43
pub val NATIVE_SYMBOL = -44
pub val NATIVE_ARRAY_PUSH = -50
pub val NATIVE_ARRAY_POP = -51
pub val NATIVE_ARRAY_LENGTH = -52
pub val NATIVE_STRING_CHAR_AT = -60
pub val NATIVE_STRING_INDEX_OF = -61
pub val NATIVE_STRING_SLICE = -62
pub val NATIVE_STRING_SPLIT = -63
pub val NATIVE_STRING_TO_UPPER = -64
pub val NATIVE_STRING_TO_LOWER = -65
pub val NATIVE_PROMISE_RESOLVE = -70
pub val NATIVE_PROMISE_REJECT = -71
pub val NATIVE_PROMISE_THEN = -72
pub val NATIVE_PROMISE_CATCH = -73
pub val NATIVE_PROMISE_FINALLY = -74
pub val NATIVE_FETCH = -75
pub val NATIVE_RESPONSE_TEXT = -76
pub val NATIVE_RESPONSE_JSON = -77
pub val NATIVE_STORAGE_GET_ITEM = -78
pub val NATIVE_STORAGE_SET_ITEM = -79
pub val NATIVE_STORAGE_REMOVE_ITEM = -80
pub val NATIVE_STORAGE_CLEAR = -81
pub val NATIVE_STORAGE_KEY = -82
pub val NATIVE_RESPONSE_BLOB = -83
pub val NATIVE_BLOB_TEXT = -84
pub val NATIVE_NAVIGATOR_GPU_REQUEST_ADAPTER = -85

var _math_random_state: i64 = 88172645463393265
var _timer_id_counter: i64 = 0

# ── Console implementation ───────────────────────────────────────────────

fn format_value(value: JsValue) -> text:
    match value:
        JsValue.Undefined: "undefined"
        JsValue.Null: "null"
        JsValue.Boolean(v):
            if v: "true"
            else: "false"
        JsValue.Number(v): "{v}"
        JsValue.String(v): v
        JsValue.Object(id): "[object Object]"
        JsValue.Array(id): "[object Array]"
        JsValue.Function(id): "[Function]"
        JsValue.Symbol(id): "Symbol()"

fn console_log(args: [JsValue], logger: JsLogger):
    var parts: [text] = []
    var i = 0
    val len = args.len()
    while i < len:
        parts.push(format_value(args.get(i)))
        i = i + 1
    val msg = parts.join(" ")
    eprint(msg)

fn console_error(args: [JsValue], logger: JsLogger):
    var parts: [text] = []
    var i = 0
    val len = args.len()
    while i < len:
        parts.push(format_value(args.get(i)))
        i = i + 1
    val msg = parts.join(" ")
    logger.error(msg)

fn console_warn(args: [JsValue], logger: JsLogger):
    var parts: [text] = []
    var i = 0
    val len = args.len()
    while i < len:
        parts.push(format_value(args.get(i)))
        i = i + 1
    val msg = parts.join(" ")
    logger.warn(msg)

fn math_random_next() -> f64:
    _math_random_state = (_math_random_state * 1103515245 + 12345) % 2147483647
    if _math_random_state < 0:
        _math_random_state = 0 - _math_random_state
    _math_random_state.to_f64() / 2147483647.0

fn _next_timer_id() -> i64:
    _timer_id_counter = _timer_id_counter + 1
    _timer_id_counter

# ── Native function dispatch ─────────────────────────────────────────────

fn _js_floor(n: f64) -> f64:
    val trunc = f64_to_i64(n)
    val fv = trunc.to_f64()
    if n < fv:
        return fv - 1.0
    fv

pub fn dispatch_native(fn_id: i64, args: [JsValue], logger: JsLogger) -> JsValue:
    if fn_id == NATIVE_CONSOLE_LOG:
        console_log(args, logger)
        return JsValue.Undefined

    if fn_id == NATIVE_CONSOLE_ERROR:
        console_error(args, logger)
        return JsValue.Undefined

    if fn_id == NATIVE_CONSOLE_WARN:
        console_warn(args, logger)
        return JsValue.Undefined

    if fn_id == NATIVE_PARSE_INT:
        if args.len() > 0:
            val s = js_to_string(args.get(0))
            # Check for radix argument
            var radix = 10
            if args.len() > 1:
                val r = to_number(args.get(1))
                radix = f64_to_i64(r)
            if radix == 16 or s.len() > 2:
                # Check for 0x prefix
                var hex_str = s
                var is_hex = false
                if s.len() > 2 and s[0] == "0" and (s[1] == "x" or s[1] == "X"):
                    is_hex = true
                    radix = 16
                    # Strip 0x prefix
                    var stripped = ""
                    var si = 2
                    while si < s.len():
                        stripped = stripped + s[si]
                        si = si + 1
                    hex_str = stripped
                if radix == 16:
                    var result = 0
                    var i = 0
                    val hex_len = hex_str.len()
                    while i < hex_len:
                        val ch = hex_str[i]
                        var digit = -1
                        if ch >= "0" and ch <= "9":
                            digit = _digit_val(ch)
                        if ch >= "a" and ch <= "f":
                            if ch == "a": digit = 10
                            if ch == "b": digit = 11
                            if ch == "c": digit = 12
                            if ch == "d": digit = 13
                            if ch == "e": digit = 14
                            if ch == "f": digit = 15
                        if ch >= "A" and ch <= "F":
                            if ch == "A": digit = 10
                            if ch == "B": digit = 11
                            if ch == "C": digit = 12
                            if ch == "D": digit = 13
                            if ch == "E": digit = 14
                            if ch == "F": digit = 15
                        if digit >= 0:
                            result = result * 16 + digit
                        i = i + 1
                    return JsValue.Number(v: result.to_f64())
            # Default base-10
            val parsed = s.parse_float()
            if val Some(n) = parsed:
                return JsValue.Number(v: f64_to_i64(n).to_f64())
        return JsValue.Number(v: _RT_NAN)

    if fn_id == NATIVE_PARSE_FLOAT:
        if args.len() > 0:
            val s = js_to_string(args.get(0))
            val parsed = s.parse_float()
            if val Some(n) = parsed:
                return JsValue.Number(v: n)
        return JsValue.Number(v: _RT_NAN)  # NaN

    if fn_id == NATIVE_IS_NAN:
        if args.len() > 0:
            val n = to_number(args.get(0))
            return JsValue.Boolean(v: n == _RT_NAN)
        return JsValue.Boolean(v: true)

    if fn_id == NATIVE_IS_FINITE:
        if args.len() > 0:
            val n = to_number(args.get(0))
            val is_nan = n == _RT_NAN
            val is_inf = n == _RT_INF
            val is_neg_inf = n == _RT_NEG_INF
            val not_finite = is_nan or is_inf or is_neg_inf
            return JsValue.Boolean(v: not not_finite)
        return JsValue.Boolean(v: false)

    if fn_id == NATIVE_STRING_CONSTRUCTOR:
        if args.len() > 0:
            return JsValue.String(v: js_to_string(args.get(0)))
        return JsValue.String(v: "")

    if fn_id == NATIVE_NUMBER_CONSTRUCTOR:
        if args.len() > 0:
            return JsValue.Number(v: to_number(args.get(0)))
        return JsValue.Number(v: 0.0)

    if fn_id == NATIVE_BOOLEAN_CONSTRUCTOR:
        if args.len() > 0:
            match args.get(0):
                JsValue.Undefined: return JsValue.Boolean(v: false)
                JsValue.Null: return JsValue.Boolean(v: false)
                JsValue.Boolean(b): return JsValue.Boolean(v: b)
                JsValue.Number(n): return JsValue.Boolean(v: n != 0.0 and n != _RT_NAN)
                JsValue.String(s): return JsValue.Boolean(v: s.len() > 0)
                _: return JsValue.Boolean(v: true)
        return JsValue.Boolean(v: false)

    if fn_id == NATIVE_MATH_FLOOR:
        if args.len() > 0:
            val n = to_number(args.get(0))
            return JsValue.Number(v: _js_floor(n))
        return JsValue.Number(v: _RT_NAN)

    if fn_id == NATIVE_MATH_CEIL:
        if args.len() > 0:
            val n = to_number(args.get(0))
            # ceil(n) = -floor(-n)
            return JsValue.Number(v: 0.0 - _js_floor(0.0 - n))
        return JsValue.Number(v: _RT_NAN)

    if fn_id == NATIVE_MATH_ROUND:
        if args.len() > 0:
            val n = to_number(args.get(0))
            return JsValue.Number(v: _js_floor(n + 0.5))
        return JsValue.Number(v: _RT_NAN)

    if fn_id == NATIVE_MATH_RANDOM:
        return JsValue.Number(v: math_random_next())

    if fn_id == NATIVE_MATH_ABS:
        if args.len() > 0:
            val n = to_number(args.get(0))
            if n < 0.0:
                return JsValue.Number(v: 0.0 - n)
            return JsValue.Number(v: n)
        return JsValue.Number(v: _RT_NAN)

    if fn_id == NATIVE_MATH_MAX:
        if args.len() == 0:
            return JsValue.Number(v: _RT_NEG_INF)  # -Infinity
        var max_val = to_number(args.get(0))
        var i = 1
        while i < args.len():
            val n = to_number(args.get(i))
            if n > max_val:
                max_val = n
            i = i + 1
        return JsValue.Number(v: max_val)

    if fn_id == NATIVE_MATH_MIN:
        if args.len() == 0:
            return JsValue.Number(v: _RT_INF)  # Infinity
        var min_val = to_number(args.get(0))
        var i = 1
        while i < args.len():
            val n = to_number(args.get(i))
            if n < min_val:
                min_val = n
            i = i + 1
        return JsValue.Number(v: min_val)

    if fn_id == NATIVE_MATH_SQRT:
        if args.len() > 0:
            val n = to_number(args.get(0))
            return JsValue.Number(v: n ** 0.5)
        return JsValue.Number(v: _RT_NAN)

    if fn_id == NATIVE_MATH_POW:
        if args.len() >= 2:
            val base = to_number(args.get(0))
            val exp = to_number(args.get(1))
            return JsValue.Number(v: base ** exp)
        return JsValue.Number(v: _RT_NAN)

    if fn_id == NATIVE_JSON_STRINGIFY:
        if args.len() > 0:
            val s = format_value(args.get(0))
            return JsValue.String(v: s)
        return JsValue.String(v: "undefined")

    if fn_id == NATIVE_JSON_PARSE:
        if args.len() > 0:
            val s = js_to_string(args.get(0))
            val parsed = json_parse(s)
            match parsed:
                Ok(value): return value
                Err(e): return JsValue.Undefined
        return JsValue.Undefined

    # Timer stubs
    if fn_id == NATIVE_SET_TIMEOUT:
        return JsValue.Number(v: _next_timer_id().to_f64())
    if fn_id == NATIVE_SET_INTERVAL:
        return JsValue.Number(v: _next_timer_id().to_f64())
    if fn_id == NATIVE_CLEAR_TIMEOUT:
        return JsValue.Undefined
    if fn_id == NATIVE_CLEAR_INTERVAL:
        return JsValue.Undefined

    if fn_id == NATIVE_SYMBOL:
        return JsValue.Symbol(id: _next_symbol_id())

    JsValue.Undefined

# Cross-module native-dispatch id contract: importers in other tiers resolve
# these constants via `use`, so they must be explicitly exported like
# std.nogc_sync_mut.js.engine.runtime does. dispatch_native is the shared pure
# basic-family dispatcher used by every tier's interpreter fallback.
export dispatch_native
export NATIVE_CONSOLE_LOG, NATIVE_CONSOLE_ERROR, NATIVE_CONSOLE_WARN
export NATIVE_PARSE_INT, NATIVE_PARSE_FLOAT, NATIVE_IS_NAN, NATIVE_IS_FINITE
export NATIVE_STRING_CONSTRUCTOR, NATIVE_NUMBER_CONSTRUCTOR, NATIVE_BOOLEAN_CONSTRUCTOR
export NATIVE_MATH_FLOOR, NATIVE_MATH_CEIL, NATIVE_MATH_ROUND, NATIVE_MATH_RANDOM
export NATIVE_MATH_ABS, NATIVE_MATH_MAX, NATIVE_MATH_MIN, NATIVE_MATH_SQRT, NATIVE_MATH_POW
export NATIVE_JSON_PARSE, NATIVE_JSON_STRINGIFY
export NATIVE_SET_TIMEOUT, NATIVE_SET_INTERVAL, NATIVE_CLEAR_TIMEOUT, NATIVE_CLEAR_INTERVAL
export NATIVE_SYMBOL
export NATIVE_ARRAY_PUSH, NATIVE_ARRAY_POP, NATIVE_ARRAY_LENGTH
export NATIVE_STRING_CHAR_AT, NATIVE_STRING_INDEX_OF, NATIVE_STRING_SLICE, NATIVE_STRING_SPLIT
export NATIVE_STRING_TO_UPPER, NATIVE_STRING_TO_LOWER
export NATIVE_PROMISE_RESOLVE, NATIVE_PROMISE_REJECT, NATIVE_PROMISE_THEN
export NATIVE_PROMISE_CATCH, NATIVE_PROMISE_FINALLY
export NATIVE_FETCH, NATIVE_RESPONSE_TEXT, NATIVE_RESPONSE_JSON
export NATIVE_STORAGE_GET_ITEM, NATIVE_STORAGE_SET_ITEM, NATIVE_STORAGE_REMOVE_ITEM
export NATIVE_STORAGE_CLEAR, NATIVE_STORAGE_KEY
export NATIVE_RESPONSE_BLOB, NATIVE_BLOB_TEXT, NATIVE_NAVIGATOR_GPU_REQUEST_ADAPTER
