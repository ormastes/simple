# SAML emitters — deterministic projections of one parsed module
#
# Every emitter reads the same `SamlModule` (plus, for reports, its
# `SamlAnalysis`). No emitter reparses another emitter's output, and none
# reorders declarations: field, enum, and union order are semantic.
#
# Targets here: BAML compatibility source, a Markdown manual for humans, an
# SDN manifest, and a compact analysis report shared by the LSP, the IDE
# panel, and agent-facing tooling.
#
# Behavior is specified by test/01_unit/lib/saml/saml_spec.spl.

use std.common.saml.ir.{SamlModule, SamlClass, SamlField, SamlFunction}
use std.common.saml.ir.{baml_type_name, type_display, find_struct}
use std.common.saml.analysis.{SamlAnalysis, SamlFunctionAnalysis}

val GENERATED_BANNER = "Generated by Simple SAML. Do not edit — edit the .saml source and regenerate."

fn _baml_field_type(field: SamlField) -> text:
    var base = baml_type_name(field.type_name)
    if field.is_list:
        base = base + "[]"
    if field.optional:
        base = base + "?"
    base

fn _baml_field_attrs(field: SamlField) -> text:
    var out = ""
    if field.alias != "":
        out = out + " @alias(\"" + field.alias + "\")"
    if field.description != "":
        out = out + " @description(\"" + field.description + "\")"
    out

# Rewrite SAML prompt context names onto their BAML equivalents. An
# unrepresentable `saml.*` reference is left alone and reported by the caller
# as a projection loss rather than silently dropped.
fn baml_prompt_body(prompt: text) -> text:
    """Rewrite `saml.output_format` to `ctx.output_format` for BAML."""
    prompt.replace("saml.output_format", "ctx.output_format")

fn emit_baml(module: SamlModule) -> text:
    """Project a module to BAML compatibility source."""
    var lines: [text] = []
    lines.push("// " + GENERATED_BANNER)
    lines.push("// Source: " + module.source_path)
    lines.push("")

    for e in module.enums:
        lines.push("enum " + e.name + " {")
        for v in e.values:
            var line = "  " + v.name
            if v.alias != "":
                line = line + " @alias(\"" + v.alias + "\")"
            lines.push(line)
        lines.push("}")
        lines.push("")

    for c in module.classes:
        lines.push("class " + c.name + " {")
        for field in c.fields:
            lines.push("  " + field.name + " " + _baml_field_type(field) + _baml_field_attrs(field))
        lines.push("}")
        lines.push("")

    for fun in module.functions:
        var params: [text] = []
        for p in fun.params:
            var t = baml_type_name(p.type_name)
            if p.is_list:
                t = t + "[]"
            if p.optional:
                t = t + "?"
            params.push(p.name + ": " + t)
        lines.push("function " + fun.name + "(" + params.join(", ") + ") -> " + fun.return_type + " {")
        if fun.client != "":
            lines.push("  client " + fun.client)
        lines.push("  prompt #\"")
        for pline in baml_prompt_body(fun.prompt).split("\n"):
            lines.push("    " + pline)
        lines.push("  \"#")
        lines.push("}")
        lines.push("")

    lines.join("\n")

# Semantics that exist in SAML but have no BAML spelling. Recording them is
# what makes "compatible" an honest claim instead of a silent truncation.
fn baml_projection_losses(module: SamlModule) -> [text]:
    """List SAML semantics the BAML projection cannot carry."""
    var out: [text] = []
    for s in module.structs:
        out.push("struct " + s.name + ": native-only, not projected (by design)")
    for c in module.classes:
        for field in c.fields:
            if field.sensitive != "":
                out.push(c.name + "." + field.name + ": @sensitive(" + field.sensitive + ") enforced by the SAML runtime, absent from BAML source")
    for fun in module.functions:
        for attr in fun.attributes:
            if attr.starts_with("redact") or attr.starts_with("eval_required") or attr.starts_with("parse"):
                out.push(fun.name + ": @" + attr + " is a runtime policy, absent from BAML source")
    out

fn emit_sdn_manifest(module: SamlModule, analysis: SamlAnalysis) -> text:
    """Emit the SDN generation manifest for a module."""
    var lines: [text] = []
    lines.push("format = \"simple.saml.manifest.v1\"")
    lines.push("module = \"" + module.name + "\"")
    lines.push("source = \"" + module.source_path + "\"")
    lines.push("class_count = " + module.classes.len().to_text())
    lines.push("enum_count = " + module.enums.len().to_text())
    lines.push("function_count = " + module.functions.len().to_text())
    lines.push("test_count = " + module.tests.len().to_text())
    lines.push("error_count = " + analysis.error_count.to_text())
    lines.push("warning_count = " + analysis.warning_count.to_text())
    lines.push("functions = [")
    var idx = 0
    for a in analysis.functions:
        idx = idx + 1
        val sep = if idx < analysis.functions.len(): "," else: ""
        lines.push("  { name = \"" + a.name + "\", evidence_state = \"" + a.evidence_state + "\", warnings = " + a.warnings.len().to_text() + " }" + sep)
    lines.push("]")
    lines.join("\n")

# The compact report. One function per block, warnings inline. This is the
# text an LSP hover, the IDE panel, and an agent all read — one renderer, so
# the human view and the machine view cannot drift apart.
fn emit_analysis_report(analysis: SamlAnalysis) -> text:
    """Render the analysis as compact text for LSP, IDE, and agent callers."""
    var lines: [text] = []
    lines.push("SAML ANALYSIS " + analysis.source_path)
    lines.push("module=" + analysis.module_name + " functions=" + analysis.functions.len().to_text() + " errors=" + analysis.error_count.to_text() + " warnings=" + analysis.warning_count.to_text())
    for a in analysis.functions:
        lines.push("")
        lines.push("fn " + a.signature + "  [line " + a.line.to_text() + "]")
        lines.push("  client:     " + a.client)
        lines.push("  schema:     " + a.reachable_types.join(", "))
        lines.push("  prompt:     vars=" + a.prompt_vars.join(",") + " output_format=" + a.has_output_format.to_text())
        lines.push("  parse:      strictness=" + a.parse_strictness + " traced=" + a.traced.to_text())
        lines.push("  evidence:   " + a.evidence_state + " tests=[" + a.covering_tests.join(",") + "] examples=" + a.example_count.to_text() + " counter=" + a.counter_example_count.to_text())
        if a.sensitive_fields.len() > 0:
            lines.push("  sensitive:  " + a.sensitive_fields.join(", "))
        for w in a.warnings:
            lines.push("  ! " + w)
    for w in analysis.module_warnings:
        lines.push("! " + w)
    lines.join("\n")

fn _evidence_badge(state: text) -> text:
    if state == "red_proven":
        return "**red-proven** — a counter-example shows the oracle can fail"
    if state == "tested":
        return "**tested** — a declared test binds it, but no counter-example"
    if state == "examples_only":
        return "**examples only** — comment examples, no declared test"
    "**unevidenced** — nothing backs this function"

fn emit_markdown_manual(module: SamlModule, analysis: SamlAnalysis) -> text:
    """Render the human-facing generated manual for a module."""
    var lines: [text] = []
    lines.push("<!-- " + GENERATED_BANNER + " -->")
    lines.push("# SAML module `" + module.name + "`")
    lines.push("")
    lines.push("Source: `" + module.source_path + "`")
    lines.push("")
    lines.push("| Functions | Classes | Enums | Tests | Errors | Warnings |")
    lines.push("|---|---|---|---|---|---|")
    lines.push("| " + module.functions.len().to_text() + " | " + module.classes.len().to_text() + " | " + module.enums.len().to_text() + " | " + module.tests.len().to_text() + " | " + analysis.error_count.to_text() + " | " + analysis.warning_count.to_text() + " |")
    lines.push("")

    if module.functions.len() > 0:
        lines.push("## Functions")
        for a in analysis.functions:
            lines.push("")
            lines.push("### `" + a.name + "`")
            lines.push("")
            lines.push("```")
            lines.push(a.signature)
            lines.push("```")
            lines.push("")
            lines.push("- Client policy: `" + a.client + "`")
            lines.push("- Reachable schema: " + a.reachable_types.join(", "))
            lines.push("- Parse strictness: `" + a.parse_strictness + "`; traced: " + a.traced.to_text())
            lines.push("- Evidence: " + _evidence_badge(a.evidence_state))
            if a.covering_tests.len() > 0:
                lines.push("- Covering tests: " + a.covering_tests.join(", "))
            if a.example_count > 0 or a.counter_example_count > 0:
                lines.push("- Comment-embedded cases: " + a.example_count.to_text() + " example, " + a.counter_example_count.to_text() + " counter-example")
            if a.sensitive_fields.len() > 0:
                lines.push("- Sensitive fields reached: " + a.sensitive_fields.join(", "))
            if a.warnings.len() > 0:
                lines.push("")
                lines.push("**Static findings**")
                lines.push("")
                for w in a.warnings:
                    lines.push("- " + w)

    if module.classes.len() > 0:
        lines.push("")
        lines.push("## Schemas")
        for c in module.classes:
            lines.push("")
            lines.push("### `" + c.name + "`")
            lines.push("")
            lines.push("| Field | Type | Alias | Notes |")
            lines.push("|---|---|---|---|")
            for field in c.fields:
                var notes = field.description
                if field.sensitive != "":
                    notes = notes + " (sensitive: " + field.sensitive + ")"
                lines.push("| `" + field.name + "` | `" + type_display(field.type_name, field.optional, field.is_list) + "` | " + field.alias + " | " + notes + " |")

    val losses = baml_projection_losses(module)
    lines.push("")
    lines.push("## BAML projection")
    lines.push("")
    if losses.len() == 0:
        lines.push("Lossless under `simple.saml.baml.v1`.")
    else:
        lines.push("The following SAML semantics are enforced by the SAML runtime and do not appear in generated BAML source:")
        lines.push("")
        for l in losses:
            lines.push("- " + l)

    lines.push("")
    lines.push("## Runtime observations")
    lines.push("")
    lines.push("None recorded. This manual reports static declarations only; executed prompts, provider latency, token usage, parser repairs, and evaluator verdicts exist only after a run and are attached as hash-bound evidence sidecars.")
    lines.join("\n")

export GENERATED_BANNER, baml_prompt_body, emit_baml, baml_projection_losses
export emit_sdn_manifest, emit_analysis_report, emit_markdown_manual
