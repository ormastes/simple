# JSON Parser
#
# Purpose: Tokenization and parsing of JSON text into JSON values
#
# Contains:
# - Tokenization: json_tokenize, json_skip_whitespace
# - Parsing: json_parse, json_parse_with_error, json_parse_tokens
# - Value parsing: json_parse_value_at, json_parse_object_at, json_parse_array_at
#
# NOTE (bug json-parser-nested-object-nil, re-diagnosed): a directly nested
# object value, e.g. json_parse("{\"a\": {\"b\": 1}}"), was reported to return
# nil while the same nesting through an intermediate array,
# json_parse("{\"a\": [{\"b\": 1}]}"), parsed fine -- appearing to be a
# recursive-descent bug in json_parse_object_at/json_parse_value_at below.
# It is NOT: this parser handles arbitrary object nesting correctly (see
# regression cases in test/01_unit/lib/common/parsers_json_core_spec.spl,
# context "nested object parsing"). The nil is produced by a separate,
# already-filed language/interpreter defect: Simple's string-literal lexer
# treats `{{`/`}}` as escapes for a literal `{`/`}` (needed for `{expr}`
# interpolation) and silently collapses ANY `}}`/`{{` pair to one brace, even
# with no interpolation intent -- so a hand-written .spl literal ending a
# directly-nested JSON object in `}}` loses its final brace before json_parse
# ever runs. See doc/08_tracking/bug/string_literal_double_brace_collapse_2026-06-16.md
# (open; not fixable in this module). If you build JSON text as an .spl string
# literal, prefer `+` concatenation over embedding a raw `}}`/`{{` sequence.



fn json_parser_null():
    ("null", nil)

fn json_parser_boolean(value: bool):
    ("boolean", value)

fn json_parser_number(value: f64):
    ("number", value)

fn json_parser_string(value: text):
    ("string", value)

fn json_parser_array(values: [any]):
    ("array", values)

fn json_parser_object(pairs: {text: any}):
    ("object", pairs)

fn json_skip_whitespace(text: text, pos: i64) -> i64:
    """Skip whitespace characters.

    Args:
        text: Input text
        pos: Current position

    Returns:
        Position after whitespace
    """
    var p = pos
    while p < text.len():
        # Byte read (byte_at is BYTE-indexed, matching len()'s byte length on
        # every engine). Replaces `text[p:p + 1]`, whose index space was chars
        # under the interpreter but bytes under compiled code, and which
        # materialised an invalid-UTF-8 1-byte value at every step past a
        # lead byte. Whitespace is ASCII: 32 ' ', 10 '\n', 13 '\r', 9 '\t'.
        # A continuation byte (>= 0x80) matches none of these and returns p,
        # exactly as the old non-whitespace slice did.
        val c = text.byte_at(p)
        if c == 32 or c == 10 or c == 13 or c == 9:
            p = p + 1
        else:
            return p
    p

fn json_string_escapes_are_valid(s: text) -> bool:
    # Byte walk (i is a byte index, len() is byte length). Escapes are
    # ASCII, so 1-byte slices compare exactly; raw non-ASCII UTF-8 bytes
    # (0x80+) pass through byte-transparently — RFC 8259 only forbids
    # unescaped control characters below 0x20, and every byte of a
    # multi-byte UTF-8 sequence is >= 0x80.
    var i = 0
    while i < s.len():
        # byte_at is BYTE-indexed and len() is byte length, so the walk is
        # index-consistent on every engine. The old `s[i:i + 1]` was chars
        # under the interpreter and bytes under compiled code, and produced
        # an invalid-UTF-8 value at every step inside a multi-byte codepoint.
        val b = s.byte_at(i)
        # The old code broke on an empty slice as a logical-EOF sentinel.
        # That sentinel is gone: `i < s.len()` already bounds the walk, and a
        # real NUL byte (0) inside the content is a control character, which
        # RFC 8259 forbids unescaped -- the `b < 32` test below rejects it.
        if b < 32:
            return false
        if b != 92:
            # Not a backslash. Raw bytes >= 0x80 (UTF-8 continuation and lead
            # bytes) pass through byte-transparently, as before.
            i = i + 1
        else:
            if i + 1 >= s.len():
                return false
            val escaped = s.byte_at(i + 1)
            # " 34, \ 92, / 47, b 98, f 102, n 110, r 114, t 116
            if escaped == 34 or escaped == 92 or escaped == 47 or escaped == 98 or escaped == 102 or escaped == 110 or escaped == 114 or escaped == 116:
                i = i + 2
            else:
                # u 117
                if escaped != 117 or i + 5 >= s.len():
                    return false
                var hex_pos = i + 2
                while hex_pos < i + 6:
                    # 0-9 = 48..57, a-f = 97..102, A-F = 65..70
                    val hex = s.byte_at(hex_pos)
                    if not ((hex >= 48 and hex <= 57) or (hex >= 97 and hex <= 102) or (hex >= 65 and hex <= 70)):
                        return false
                    hex_pos = hex_pos + 1
                i = i + 6
    true

fn json_number_is_valid(s: text) -> bool:
    # Byte-indexed walk via byte_at, consistent with len()'s byte length on
    # every engine. JSON numbers are ASCII-only, so each test below is an
    # exact byte compare; any byte >= 0x80 fails every test and the trailing
    # `i == s.len()` then reports the number invalid, as before.
    # - 45, 0 48, 1 49, 9 57, . 46, e 101, E 69, + 43
    var i = 0
    if i < s.len() and s.byte_at(i) == 45:
        i = i + 1
    if i >= s.len():
        return false
    if s.byte_at(i) == 48:
        i = i + 1
    else:
        if s.byte_at(i) < 49 or s.byte_at(i) > 57:
            return false
        i = i + 1
        while i < s.len() and s.byte_at(i) >= 48 and s.byte_at(i) <= 57:
            i = i + 1
    if i < s.len() and s.byte_at(i) == 46:
        i = i + 1
        val fraction_start = i
        while i < s.len() and s.byte_at(i) >= 48 and s.byte_at(i) <= 57:
            i = i + 1
        if i == fraction_start:
            return false
    if i < s.len() and (s.byte_at(i) == 101 or s.byte_at(i) == 69):
        i = i + 1
        if i < s.len() and (s.byte_at(i) == 43 or s.byte_at(i) == 45):
            i = i + 1
        val exponent_start = i
        while i < s.len() and s.byte_at(i) >= 48 and s.byte_at(i) <= 57:
            i = i + 1
        if i == exponent_start:
            return false
    i == s.len()

fn json_tokenize(text: text) -> [(text, text)]:
    """Tokenize JSON text.

    Args:
        text: JSON text

    Returns:
        Array of (token_type, token_value) tuples
        Token types: "LBRACE", "RBRACE", "LBRACKET", "RBRACKET", "COLON", "COMMA",
                     "STRING", "NUMBER", "TRUE", "FALSE", "NULL"

    Example:
        json_tokenize("{\"key\": 42}")
    """
    var tokens: [(text, text)] = []
    var pos = 0
    while pos < text.len():
        pos = json_skip_whitespace(text, pos)
        if pos >= text.len():
            break
        # 1-unit slice, not char_at: pos stays in the engine's slice index
        # space (bytes under compiled code, characters under the
        # interpreter) so reads and advances never desynchronize. The old
        # char_at walk against byte-length bounds rejected raw non-ASCII
        # strings entirely. See
        # doc/08_tracking/bug/json_tokenizer_rejects_raw_non_ascii_strings_2026-07-29.md
        val c = text[pos:pos + 1]
        # Empty slice = logical end of input. This, not `pos < len()`, is
        # the authoritative EOF test: len() is byte length in every
        # engine, but slice/index positions are character-based under the
        # interpreter and byte-based under compiled code (see
        # doc/08_tracking/bug/test_harness_execution_divergence_2026-07-29.md).
        # With multi-byte content the character count is smaller than the
        # byte count, so a len()-bounded loop overruns into a phantom
        # tail; the empty-slice sentinel stops at the real end in both
        # index spaces.
        if c == "":
            break
        if c == "{":
            tokens.push(("LBRACE", "{"))
            pos = pos + 1
        else:
            if c == "}":
                tokens.push(("RBRACE", "}"))
                pos = pos + 1
            else:
                if c == "[":
                    tokens.push(("LBRACKET", "["))
                    pos = pos + 1
                else:
                    if c == "]":
                        tokens.push(("RBRACKET", "]"))
                        pos = pos + 1
                    else:
                        if c == ":":
                            tokens.push(("COLON", ":"))
                            pos = pos + 1
                        else:
                            if c == ",":
                                tokens.push(("COMMA", ","))
                                pos = pos + 1
                            else:
                                if c == "\"":
                                    var str_parts: [text] = []
                                    pos = pos + 1
                                    var escaped = false
                                    var closed = false
                                    while pos < text.len():
                                        # 1-unit slice: raw non-ASCII
                                        # content passes through untouched
                                        # (whole chars under the
                                        # interpreter, single bytes under
                                        # compiled code — a quote or
                                        # backslash byte never occurs
                                        # inside a UTF-8 multi-byte
                                        # sequence, so both walks agree).
                                        # An empty slice (unterminated
                                        # string) falls through and the
                                        # loop ends by the byte bound.
                                        val sc = text[pos:pos + 1]
                                        if escaped:
                                            str_parts.push("\\" + sc)
                                            escaped = false
                                            pos = pos + 1
                                        else:
                                            if sc == "\\":
                                                escaped = true
                                                pos = pos + 1
                                            else:
                                                if sc == "\"":
                                                    closed = true
                                                    pos = pos + 1
                                                    break
                                                else:
                                                    str_parts.push(sc)
                                                    pos = pos + 1
                                    if closed and json_string_escapes_are_valid(str_parts.join("")):
                                        tokens.push(("STRING", str_parts.join("")))
                                    else:
                                        tokens.push(("INVALID", if closed then "Invalid string escape" else: "Unterminated string"))
                                        break
                                else:
                                    if c == "t":
                                        if text[pos:pos + 4] == "true":
                                            tokens.push(("TRUE", "true"))
                                            pos = pos + 4
                                        else:
                                            tokens.push(("INVALID", c))
                                            pos = pos + 1
                                    else:
                                        if c == "f":
                                            if text[pos:pos + 5] == "false":
                                                tokens.push(("FALSE", "false"))
                                                pos = pos + 5
                                            else:
                                                tokens.push(("INVALID", c))
                                                pos = pos + 1
                                        else:
                                            if c == "n":
                                                if text[pos:pos + 4] == "null":
                                                    tokens.push(("NULL", "null"))
                                                    pos = pos + 4
                                                else:
                                                    tokens.push(("INVALID", c))
                                                    pos = pos + 1
                                            else:
                                                if c == "-" or (c >= "0" and c <= "9"):
                                                    var num_parts: [text] = []
                                                    while pos < text.len():
                                                        val nc = text[pos:pos + 1]
                                                        if nc == "-" or nc == "." or nc == "e" or nc == "E" or nc == "+" or (nc >= "0" and nc <= "9"):
                                                            num_parts.push(nc)
                                                            pos = pos + 1
                                                        else:
                                                            break
                                                    val number = num_parts.join("")
                                                    if json_number_is_valid(number):
                                                        tokens.push(("NUMBER", number))
                                                    else:
                                                        tokens.push(("INVALID", "Invalid number"))
                                                else:
                                                    tokens.push(("INVALID", c))
                                                    pos = pos + 1
    tokens

fn _json_hex_digit_value(c: text) -> i64:
    """Value of one hex digit character, or -1 if not a hex digit."""
    if c >= "0" and c <= "9":
        return c.char_code_at(0) - 48
    if c >= "a" and c <= "f":
        return c.char_code_at(0) - 87
    if c >= "A" and c <= "F":
        return c.char_code_at(0) - 55
    -1

fn _json_hex4_at(s: text, pos: i64) -> i64:
    """Parse exactly 4 hex digits at pos; -1 if short or invalid."""
    if pos + 4 > s.len():
        return -1
    var value = 0
    var k = 0
    while k < 4:
        val d = _json_hex_digit_value(s[pos + k:pos + k + 1])
        if d < 0:
            return -1
        value = value * 16 + d
        k = k + 1
    value

fn json_unescape_string(s: text) -> text:
    """Unescape JSON string.

    RFC 8259 semantics: a \\uXXXX escape decodes to the codepoint's UTF-8
    bytes; a high surrogate (\\uD800-\\uDBFF) followed by a low surrogate
    (\\uDC00-\\uDFFF) combines to the supplementary-plane codepoint. A lone
    or out-of-order surrogate decodes to U+FFFD REPLACEMENT CHARACTER (RFC
    8259 leaves this case undefined; we choose replacement over dropping
    data or erroring).

    Args:
        s: Escaped string

    Returns:
        Unescaped string

    Example:
        json_unescape_string("hello\\nworld")  # "hello\nworld"
    """
    var parts: [text] = []
    var i = 0
    while i < s.len():
        val c = s[i:i + 1]
        if c == "\\":
            if i + 1 < s.len():
                val next = s[i + 1:i + 1 + 1]
                if next == "\"":
                    parts.push("\"")
                    i = i + 2
                else:
                    if next == "\\":
                        parts.push("\\")
                        i = i + 2
                    else:
                        if next == "/":
                            parts.push("/")
                            i = i + 2
                        else:
                            if next == "b":
                                parts.push("\b")
                                i = i + 2
                            else:
                                if next == "f":
                                    parts.push("\f")
                                    i = i + 2
                                else:
                                    if next == "n":
                                        parts.push("\n")
                                        i = i + 2
                                    else:
                                        if next == "r":
                                            parts.push("\r")
                                            i = i + 2
                                        else:
                                            if next == "t":
                                                parts.push("\t")
                                                i = i + 2
                                            else:
                                                if next == "u":
                                                    val hi = _json_hex4_at(s, i + 2)
                                                    if hi < 0:
                                                        # Malformed \u escape: keep the backslash
                                                        # literally (pre-existing unknown-escape
                                                        # behavior; json_parse never reaches here
                                                        # because the tokenizer rejects it).
                                                        parts.push(c)
                                                        i = i + 1
                                                    else:
                                                        if hi >= 0xD800 and hi <= 0xDBFF:
                                                            # High surrogate: pair with a following
                                                            # \uDC00-\uDFFF when present.
                                                            var lo = -1
                                                            if i + 7 < s.len() and s[i + 6:i + 6 + 1] == "\\" and s[i + 7:i + 7 + 1] == "u":
                                                                lo = _json_hex4_at(s, i + 8)
                                                            if lo >= 0xDC00 and lo <= 0xDFFF:
                                                                val combined = 0x10000 + ((hi - 0xD800) * 1024) + (lo - 0xDC00)
                                                                parts.push(combined.chr())
                                                                i = i + 12
                                                            else:
                                                                # Lone high surrogate -> U+FFFD
                                                                # (documented policy, see docstring).
                                                                parts.push(0xFFFD.chr())
                                                                i = i + 6
                                                        else:
                                                            if hi >= 0xDC00 and hi <= 0xDFFF:
                                                                # Lone low surrogate -> U+FFFD.
                                                                parts.push(0xFFFD.chr())
                                                                i = i + 6
                                                            else:
                                                                # BMP codepoint: append its UTF-8 bytes.
                                                                parts.push(hi.chr())
                                                                i = i + 6
                                                else:
                                                    parts.push(c)
                                                    i = i + 1
            else:
                parts.push(c)
                i = i + 1
        else:
            # Literal run: append whole SPANS between escapes, never single
            # bytes. The tree-walking interpreter's strings are Rust Strings,
            # so a mid-codepoint 1-byte slice materializes as U+FFFD there
            # (while native keeps raw bytes) — per-byte accumulation tripled
            # every multi-byte character. Runs start and end at ASCII
            # boundaries (start of input or after an escape; ended by "\\"),
            # so the span is always whole codepoints. Byte-slice COMPARES
            # inside the scan are safe (a lossy fragment never equals "\\").
            val run_start = i
            while i < s.len() and s[i:i + 1] != "\\":
                i = i + 1
            parts.push(s[run_start:i])
    parts.join("")

fn json_parse_value_at(tokens: [(text, text)], pos: i64) -> (bool, any, text, i64):
    """Parse value at token position.

    Args:
        tokens: Token array
        pos: Current position

    Returns:
        (success, value, error_message, next_position)
    """
    if pos >= tokens.len():
        return (false, nil, "Unexpected end of input", pos)
    val token = tokens[pos]
    val token_type = token.0
    val token_value = token.1
    if token_type == "STRING":
        val unescaped = json_unescape_string(token_value)
        return (true, json_parser_string(unescaped), "", pos + 1)
    if token_type == "NUMBER":
        val num = token_value.to_float()
        return (true, json_parser_number(num), "", pos + 1)
    if token_type == "TRUE":
        return (true, json_parser_boolean(true), "", pos + 1)
    if token_type == "FALSE":
        return (true, json_parser_boolean(false), "", pos + 1)
    if token_type == "NULL":
        return (true, json_parser_null(), "", pos + 1)
    if token_type == "LBRACKET":
        return json_parse_array_at(tokens, pos)
    if token_type == "LBRACE":
        return json_parse_object_at(tokens, pos)
    if token_type == "INVALID":
        return (false, nil, "Unexpected token: {token_value}", pos)
    (false, nil, "Unexpected token: {token_type}", pos)

fn json_parse_array_at(tokens: [(text, text)], pos: i64) -> (bool, any, text, i64):
    """Parse array at token position.

    Args:
        tokens: Token array
        pos: Current position (should be at LBRACKET)

    Returns:
        (success, array_value, error_message, next_position)
    """
    var p = pos + 1
    var elements: [any] = []
    while p < tokens.len():
        val token = tokens[p]
        val token_type = token.0
        if token_type == "RBRACKET":
            return (true, json_parser_array(elements), "", p + 1)
        if elements.len() > 0:
            if token_type != "COMMA":
                return (false, nil, "Expected comma in array", p)
            p = p + 1
        val result = json_parse_value_at(tokens, p)
        val success = result.0
        val value = result.1
        val error_msg = result.2
        val next_pos = result.3
        if not success:
            return (false, nil, error_msg, next_pos)
        elements.push(value)
        p = next_pos
    (false, nil, "Unclosed array", p)

fn json_parse_object_at(tokens: [(text, text)], pos: i64) -> (bool, any, text, i64):
    """Parse object at token position.

    Args:
        tokens: Token array
        pos: Current position (should be at LBRACE)

    Returns:
        (success, object_value, error_message, next_position)
    """
    var p = pos + 1
    var pairs: {text: any} = {}
    # Dict.len() returns -1 under native codegen — track the member count
    # explicitly. See doc/07_guide/language/dict_native_pitfalls.md
    var pair_count = 0
    while p < tokens.len():
        val token = tokens[p]
        val token_type = token.0
        if token_type == "RBRACE":
            return (true, json_parser_object(pairs), "", p + 1)
        if pair_count > 0:
            if token_type != "COMMA":
                return (false, nil, "Expected comma in object", p)
            p = p + 1
            if p >= tokens.len():
                return (false, nil, "Unexpected end in object", p)
            val next_token = tokens[p]
            val next_type = next_token.0
            if next_type == "RBRACE":
                return (false, nil, "Trailing comma in object", p)
        if p >= tokens.len():
            return (false, nil, "Unexpected end in object", p)
        val key_token = tokens[p]
        val key_type = key_token.0
        val key_value = key_token.1
        if key_type != "STRING":
            return (false, nil, "Expected string key in object", p)
        val key = json_unescape_string(key_value)
        p = p + 1
        if p >= tokens.len():
            return (false, nil, "Unexpected end after key", p)
        val colon_token = tokens[p]
        val colon_type = colon_token.0
        if colon_type != "COLON":
            return (false, nil, "Expected colon after key", p)
        p = p + 1
        val result = json_parse_value_at(tokens, p)
        val success = result.0
        val value = result.1
        val error_msg = result.2
        val next_pos = result.3
        if not success:
            return (false, nil, error_msg, next_pos)
        pairs[key] = value
        pair_count = pair_count + 1
        p = next_pos
    (false, nil, "Unclosed object", p)

fn json_parse_tokens(tokens: [(text, text)]) -> (bool, any, text, i64):
    """Parse tokens into JSON value.

    Args:
        tokens: Array of tokens from json_tokenize

    Returns:
        (success, value, error_message, position)

    Example:
        json_parse_tokens(json_tokenize("{\"key\": 42}"))
    """
    if tokens.len() == 0:
        return (false, nil, "Empty input", 0)
    val result = json_parse_value_at(tokens, 0)
    if not result.0:
        return result
    if result.3 != tokens.len():
        return (false, nil, "Unexpected trailing tokens", result.3)
    result

# ponytail: kept as `any` (not `any?`) despite the documented nil-on-failure
# path below -- widening to `any?` here reproducibly makes the strict seed
# wrap the returned JSON value (itself a (tag, value) tuple) in an Option
# enum, so downstream `.0`/`.1` tuple access and json_is_*() type checks fail
# with "tuple index access on non-tuple type enum" (measured: 94-example
# parsers_json_core_spec.spl regresses from 11 pre-existing failures to 16
# with this widened). Same defect class as the free-function generic T?
# Option-wrap bug documented in ds_utils.spl (stack_get/queue_get), but here
# it also hits a concrete (non-generic) `any?`. See
# doc/08_tracking/bug/free_fn_optional_wrap_2026-06-26.md.
fn json_parse(text: text) -> any:
    """Parse JSON text to value.

    Args:
        text: JSON text

    Returns:
        JSON value if successful, nil otherwise

    Example:
        val data = json_parse("{\"name\": \"Alice\"}")
    """
    val tokens = json_tokenize(text)
    val result = json_parse_tokens(tokens)
    if result.0:
        return result.1
    nil

fn json_parse_with_error(text: text) -> (any, text):
    """Parse JSON text with error message.

    Args:
        text: JSON text

    Returns:
        (value, error_message) - value is nil if error occurred

    Example:
        val (data, error) = json_parse_with_error(json_text)
        if error != "":
            print "Parse error: {error}"
    """
    val tokens = json_tokenize(text)
    val result = json_parse_tokens(tokens)
    if result.0:
        return (result.1, "")
    (nil, result.2)
