# JSON Parser
#
# Purpose: Tokenization and parsing of JSON text into JSON values
#
# Contains:
# - Tokenization: json_tokenize, json_skip_whitespace
# - Parsing: json_parse, json_parse_with_error, json_parse_tokens
# - Value parsing: json_parse_value_at, json_parse_object_at, json_parse_array_at


# Import types for constructors
mod json.types

fn json_parser_null():
    ("null", nil)

fn json_parser_boolean(value: bool):
    ("boolean", value)

fn json_parser_number(value: f64):
    ("number", value)

fn json_parser_string(value: text):
    ("string", value)

fn json_parser_array(values: [any]):
    ("array", values)

fn json_parser_object(pairs: {text: any}):
    ("object", pairs)

fn json_skip_whitespace(text: text, pos: i64) -> i64:
    """Skip whitespace characters.

    Args:
        text: Input text
        pos: Current position

    Returns:
        Position after whitespace
    """
    var p = pos
    while p < text.len():
        val c = text.char_at(p)
        if c == " " or c == "\n" or c == "\r" or c == "\t":
            p = p + 1
        else:
            return p
    p

fn json_string_escapes_are_valid(s: text) -> bool:
    var i = 0
    while i < s.len():
        # byte_at is BYTE-indexed and len() is byte length, so the walk is
        # index-consistent on every engine. The old `s[i:i + 1]` was chars
        # under the interpreter and bytes under compiled code, and produced
        # an invalid-UTF-8 value at every step inside a multi-byte codepoint.
        val b = s.byte_at(i)
        # The old code broke on an empty slice as a logical-EOF sentinel.
        # That sentinel is gone: `i < s.len()` already bounds the walk, and a
        # real NUL byte (0) inside the content is a control character, which
        # RFC 8259 forbids unescaped -- the `b < 32` test below rejects it.
        if b < 32:
            return false
        if b != 92:
            # Not a backslash. Raw bytes >= 0x80 (UTF-8 continuation and lead
            # bytes) pass through byte-transparently, as before.
            i = i + 1
        else:
            if i + 1 >= s.len():
                return false
            val escaped = s.byte_at(i + 1)
            # " 34, \ 92, / 47, b 98, f 102, n 110, r 114, t 116
            if escaped == 34 or escaped == 92 or escaped == 47 or escaped == 98 or escaped == 102 or escaped == 110 or escaped == 114 or escaped == 116:
                i = i + 2
            else:
                # u 117
                if escaped != 117 or i + 5 >= s.len():
                    return false
                var hex_pos = i + 2
                while hex_pos < i + 6:
                    # 0-9 = 48..57, a-f = 97..102, A-F = 65..70
                    val hex = s.byte_at(hex_pos)
                    if not ((hex >= 48 and hex <= 57) or (hex >= 97 and hex <= 102) or (hex >= 65 and hex <= 70)):
                        return false
                    hex_pos = hex_pos + 1
                i = i + 6
    true

fn json_number_is_valid(s: text) -> bool:
    # Byte-indexed walk via byte_at, consistent with len()'s byte length on
    # every engine. JSON numbers are ASCII-only, so each test below is an
    # exact byte compare; any byte >= 0x80 fails every test and the trailing
    # `i == s.len()` then reports the number invalid, as before.
    # - 45, 0 48, 1 49, 9 57, . 46, e 101, E 69, + 43
    var i = 0
    if i < s.len() and s.byte_at(i) == 45:
        i = i + 1
    if i >= s.len():
        return false
    if s.byte_at(i) == 48:
        i = i + 1
    else:
        if s.byte_at(i) < 49 or s.byte_at(i) > 57:
            return false
        i = i + 1
        while i < s.len() and s.byte_at(i) >= 48 and s.byte_at(i) <= 57:
            i = i + 1
    if i < s.len() and s.byte_at(i) == 46:
        i = i + 1
        val fraction_start = i
        while i < s.len() and s.byte_at(i) >= 48 and s.byte_at(i) <= 57:
            i = i + 1
        if i == fraction_start:
            return false
    if i < s.len() and (s.byte_at(i) == 101 or s.byte_at(i) == 69):
        i = i + 1
        if i < s.len() and (s.byte_at(i) == 43 or s.byte_at(i) == 45):
            i = i + 1
        val exponent_start = i
        while i < s.len() and s.byte_at(i) >= 48 and s.byte_at(i) <= 57:
            i = i + 1
        if i == exponent_start:
            return false
    i == s.len()

fn json_tokenize(text: text) -> [(text, text)]:
    """Tokenize JSON text.

    Args:
        text: JSON text

    Returns:
        Array of (token_type, token_value) tuples
        Token types: "LBRACE", "RBRACE", "LBRACKET", "RBRACKET", "COLON", "COMMA",
                     "STRING", "NUMBER", "TRUE", "FALSE", "NULL"

    Example:
        json_tokenize("{\"key\": 42}")
    """
    var tokens: [(text, text)] = []
    var pos = 0
    while pos < text.len():
        pos = json_skip_whitespace(text, pos)
        if pos >= text.len():
            break
        val c = text.char_at(pos)
        if c == "{":
            tokens.push(("LBRACE", "{"))
            pos = pos + 1
        else:
            if c == "}":
                tokens.push(("RBRACE", "}"))
                pos = pos + 1
            else:
                if c == "[":
                    tokens.push(("LBRACKET", "["))
                    pos = pos + 1
                else:
                    if c == "]":
                        tokens.push(("RBRACKET", "]"))
                        pos = pos + 1
                    else:
                        if c == ":":
                            tokens.push(("COLON", ":"))
                            pos = pos + 1
                        else:
                            if c == ",":
                                tokens.push(("COMMA", ","))
                                pos = pos + 1
                            else:
                                if c == "\"":
                                    var str_parts: [text] = []
                                    pos = pos + 1
                                    var escaped = false
                                    var closed = false
                                    while pos < text.len():
                                        val sc = text.char_at(pos)
                                        if escaped:
                                            str_parts.push("\\" + sc)
                                            escaped = false
                                            pos = pos + 1
                                        else:
                                            if sc == "\\":
                                                escaped = true
                                                pos = pos + 1
                                            else:
                                                if sc == "\"":
                                                    closed = true
                                                    pos = pos + 1
                                                    break
                                                else:
                                                    str_parts.push(sc)
                                                    pos = pos + 1
                                    if closed:
                                        tokens.push(("STRING", str_parts.join("")))
                                    else:
                                        tokens.push(("INVALID", "Unterminated string"))
                                        break
                                else:
                                    if c == "t":
                                        if text.slice(pos, pos + 4) == "true":
                                            tokens.push(("TRUE", "true"))
                                            pos = pos + 4
                                        else:
                                            tokens.push(("INVALID", c))
                                            pos = pos + 1
                                    else:
                                        if c == "f":
                                            if text.slice(pos, pos + 5) == "false":
                                                tokens.push(("FALSE", "false"))
                                                pos = pos + 5
                                            else:
                                                tokens.push(("INVALID", c))
                                                pos = pos + 1
                                        else:
                                            if c == "n":
                                                if text.slice(pos, pos + 4) == "null":
                                                    tokens.push(("NULL", "null"))
                                                    pos = pos + 4
                                                else:
                                                    tokens.push(("INVALID", c))
                                                    pos = pos + 1
                                            else:
                                                if c == "-" or (c >= "0" and c <= "9"):
                                                    var num_parts: [text] = []
                                                    while pos < text.len():
                                                        val nc = text.char_at(pos)
                                                        if nc == "-" or nc == "." or nc == "e" or nc == "E" or nc == "+" or (nc >= "0" and nc <= "9"):
                                                            num_parts.push(nc)
                                                            pos = pos + 1
                                                        else:
                                                            break
                                                    tokens.push(("NUMBER", num_parts.join("")))
                                                else:
                                                    tokens.push(("INVALID", c))
                                                    pos = pos + 1
    tokens

fn json_unescape_string(s: text) -> text:
    """Unescape JSON string.

    Args:
        s: Escaped string

    Returns:
        Unescaped string

    Example:
        json_unescape_string("hello\\nworld")  # "hello\nworld"
    """
    var parts: [text] = []
    var i = 0
    while i < s.len():
        val c = s.char_at(i)
        if c == "\\":
            if i + 1 < s.len():
                val next = s.char_at(i + 1)
                if next == "\"":
                    parts.push("\"")
                    i = i + 2
                else:
                    if next == "\\":
                        parts.push("\\")
                        i = i + 2
                    else:
                        if next == "/":
                            parts.push("/")
                            i = i + 2
                        else:
                            if next == "b":
                                parts.push("\b")
                                i = i + 2
                            else:
                                if next == "f":
                                    parts.push("\f")
                                    i = i + 2
                                else:
                                    if next == "n":
                                        parts.push("\n")
                                        i = i + 2
                                    else:
                                        if next == "r":
                                            parts.push("\r")
                                            i = i + 2
                                        else:
                                            if next == "t":
                                                parts.push("\t")
                                                i = i + 2
                                            else:
                                                parts.push(c)
                                                i = i + 1
            else:
                parts.push(c)
                i = i + 1
        else:
            parts.push(c)
            i = i + 1
    parts.join("")

fn json_parse_value_at(tokens: [(text, text)], pos: i64) -> (bool, any, text, i64):
    """Parse value at token position.

    Args:
        tokens: Token array
        pos: Current position

    Returns:
        (success, value, error_message, next_position)
    """
    if pos >= tokens.len():
        return (false, nil, "Unexpected end of input", pos)
    val token = tokens[pos]
    val token_type = token.0
    val token_value = token.1
    if token_type == "STRING":
        val unescaped = json_unescape_string(token_value)
        return (true, json_parser_string(unescaped), "", pos + 1)
    if token_type == "NUMBER":
        val num = token_value.to_float()
        return (true, json_parser_number(num), "", pos + 1)
    if token_type == "TRUE":
        return (true, json_parser_boolean(true), "", pos + 1)
    if token_type == "FALSE":
        return (true, json_parser_boolean(false), "", pos + 1)
    if token_type == "NULL":
        return (true, json_parser_null(), "", pos + 1)
    if token_type == "LBRACKET":
        return json_parse_array_at(tokens, pos)
    if token_type == "LBRACE":
        return json_parse_object_at(tokens, pos)
    (false, nil, "Unexpected token: {token_type}", pos)

fn json_parse_array_at(tokens: [(text, text)], pos: i64) -> (bool, any, text, i64):
    """Parse array at token position.

    Args:
        tokens: Token array
        pos: Current position (should be at LBRACKET)

    Returns:
        (success, array_value, error_message, next_position)
    """
    var p = pos + 1
    var elements: [any] = []
    while p < tokens.len():
        val token = tokens[p]
        val token_type = token.0
        if token_type == "RBRACKET":
            return (true, json_parser_array(elements), "", p + 1)
        if elements.len() > 0:
            if token_type != "COMMA":
                return (false, nil, "Expected comma in array", p)
            p = p + 1
        val result = json_parse_value_at(tokens, p)
        val success = result.0
        val value = result.1
        val error_msg = result.2
        val next_pos = result.3
        if not success:
            return (false, nil, error_msg, next_pos)
        elements.push(value)
        p = next_pos
    (false, nil, "Unclosed array", p)

fn json_parse_object_at(tokens: [(text, text)], pos: i64) -> (bool, any, text, i64):
    """Parse object at token position.

    Args:
        tokens: Token array
        pos: Current position (should be at LBRACE)

    Returns:
        (success, object_value, error_message, next_position)
    """
    var p = pos + 1
    var pairs: {text: any} = {}
    while p < tokens.len():
        val token = tokens[p]
        val token_type = token.0
        if token_type == "RBRACE":
            return (true, json_parser_object(pairs), "", p + 1)
        if pairs.len() > 0:
            if token_type != "COMMA":
                return (false, nil, "Expected comma in object", p)
            p = p + 1
            if p >= tokens.len():
                return (false, nil, "Unexpected end in object", p)
            val next_token = tokens[p]
            val next_type = next_token.0
            if next_type == "RBRACE":
                return (false, nil, "Trailing comma in object", p)
        if p >= tokens.len():
            return (false, nil, "Unexpected end in object", p)
        val key_token = tokens[p]
        val key_type = key_token.0
        val key_value = key_token.1
        if key_type != "STRING":
            return (false, nil, "Expected string key in object", p)
        val key = json_unescape_string(key_value)
        p = p + 1
        if p >= tokens.len():
            return (false, nil, "Unexpected end after key", p)
        val colon_token = tokens[p]
        val colon_type = colon_token.0
        if colon_type != "COLON":
            return (false, nil, "Expected colon after key", p)
        p = p + 1
        val result = json_parse_value_at(tokens, p)
        val success = result.0
        val value = result.1
        val error_msg = result.2
        val next_pos = result.3
        if not success:
            return (false, nil, error_msg, next_pos)
        pairs[key] = value
        p = next_pos
    (false, nil, "Unclosed object", p)

fn json_parse_tokens(tokens: [(text, text)]) -> (bool, any, text, i64):
    """Parse tokens into JSON value.

    Args:
        tokens: Array of tokens from json_tokenize

    Returns:
        (success, value, error_message, position)

    Example:
        json_parse_tokens(json_tokenize("{\"key\": 42}"))
    """
    if tokens.len() == 0:
        return (false, nil, "Empty input", 0)
    val result = json_parse_value_at(tokens, 0)
    if not result.0:
        return result
    if result.3 != tokens.len():
        return (false, nil, "Unexpected trailing tokens", result.3)
    result

fn json_parse(text: text) -> any:
    """Parse JSON text to value.

    Args:
        text: JSON text

    Returns:
        JSON value if successful, nil otherwise

    Example:
        val data = json_parse("{\"name\": \"Alice\"}")
    """
    val tokens = json_tokenize(text)
    val result = json_parse_tokens(tokens)
    if result.0:
        return result.1
    nil

fn json_parse_with_error(text: text) -> (any, text):
    """Parse JSON text with error message.

    Args:
        text: JSON text

    Returns:
        (value, error_message) - value is nil if error occurred

    Example:
        val (data, error) = json_parse_with_error(json_text)
        if error != "":
            print "Parse error: {error}"
    """
    val tokens = json_tokenize(text)
    val result = json_parse_tokens(tokens)
    if result.0:
        return (result.1, "")
    (nil, result.2)
