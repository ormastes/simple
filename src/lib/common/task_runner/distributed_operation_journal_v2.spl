# Domain operation ledger over the existing segmented database WAL.
# CURRENT publication guarantees process-crash recovery, not power-loss fsync.
use std.common.contracts.distributed_operation_state_v2.*
use std.common.contracts.distributed_control_codec_v2.distributed_decode_operation_v2
use std.common.task_runner.index.{task_runner_storage_escape_v1, task_runner_storage_unescape_v1}
use std.common.crypto.sha256.sha256_text
use std.common.build_manager.contracts.builder_digest_valid_v1
use std.database.wal.{WalEntry, WalEntryType}
use std.nogc_sync_mut.database.wal_segmented.{database_wal_current_v1,
    database_wal_revision_open_v1, database_wal_segment_read_strict_v1, database_wal_commit_v1}
use std.nogc_sync_mut.io.file_ops.{file_lock, file_unlock, file_atomic_write, file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.io_runtime.{dir_create, file_delete}
use std.nogc_sync_mut.io.file_lock_owned_v2.{FileLockOwnerV2, FileLockOpenV2,
    FileLockReleaseStateV2, file_lock_open_owned_v2, file_lock_release_owned_v2,
    file_lock_owner_live_v2, file_lock_owner_state_v2}

struct DistributedOperationJournalV2:
    root: text
    authority_digest: text
    revision: text
    sequence: i64
    maximum_events: i64
    parent_lock: i64
    lease_digest: text
    operations: {text: DistributedOperationStateV2}
    owned_lock: Option<FileLockOwnerV2> = nil

fn operation_event_encode_v2(row: DistributedOperationStateV2) -> text:
    task_runner_storage_escape_v1(row.state + "\n" + row.outcome_digest + "\n" + row.envelope)

fn operation_event_decode_v2(data: text) -> Result<DistributedOperationStateV2, text>:
    val decoded = task_runner_storage_unescape_v1(data)
    if task_runner_storage_escape_v1(decoded) != data: return Err("OPERATION_WAL_ENCODING_INVALID")
    val lines = decoded.split("\n")
    if lines.len() < 3: return Err("OPERATION_WAL_TRUNCATED")
    val prefix = lines[0].len() + lines[1].len() + 2
    val initial = distributed_operation_initial_v2(decoded[prefix:decoded.len()])?
    Ok(DistributedOperationStateV2(initial.operation_id, initial.envelope_digest,
        initial.envelope, lines[0], lines[1]))

fn operation_event_validate_v2(rows: {text: DistributedOperationStateV2},
        row: DistributedOperationStateV2) -> Result<bool, text>:
    if not rows.contains_key(row.operation_id):
        if row.state != "admitted" or row.outcome_digest != "": return Err("OPERATION_WAL_ADMISSION_MISSING")
    else:
        val prior = rows[row.operation_id]
        if prior.envelope != row.envelope: return Err("OPERATION_WAL_REQUEST_CHANGED")
        val checked = distributed_operation_transition_v2(prior, row.state, row.outcome_digest)?
    Ok(true)

fn operation_event_apply_v2(rows: {text: DistributedOperationStateV2},
        row: DistributedOperationStateV2) -> Result<{text: DistributedOperationStateV2}, text>:
    val checked = operation_event_validate_v2(rows, row)?
    var updated = rows
    updated[row.operation_id] = row
    Ok(updated)

fn operation_owner_check_v2(owner: DistributedOperationJournalV2) -> Result<bool, text>:
    if val held = owner.owned_lock:
        if not file_lock_owner_live_v2(held): return Err("OPERATION_JOURNAL_OWNER_INVALID")
    else:
        if owner.parent_lock < 0: return Err("OPERATION_JOURNAL_OWNER_INVALID")
    val lease = file_read_regular_no_follow_bounded(owner.root + "/parent.lease", 512)?
    if sha256_text(lease) != owner.lease_digest: return Err("OPERATION_JOURNAL_LEASE_STALE")
    Ok(true)

fn distributed_operation_journal_open_v2(root: text, authority_digest: text, nonce: text,
        maximum_events: i64) -> Result<DistributedOperationJournalV2, text>:
    if root == "" or not builder_digest_valid_v1(authority_digest) or not builder_digest_valid_v1(nonce) or
            maximum_events <= 0 or maximum_events > 100000:
        return Err("OPERATION_JOURNAL_CONFIGURATION_INVALID")
    dir_create(root, true)
    val held = file_lock(root + "/parent.lock", 1)
    if held < 0: return Err("OPERATION_JOURNAL_ALREADY_OWNED")
    val lease = "DISTRIBUTED-OPERATION-LEASE-V2\n{nonce}\n{authority_digest}\n"
    if not file_atomic_write(root + "/parent.lease", lease):
        val released = file_unlock(held)
        return Err("OPERATION_JOURNAL_LEASE_PUBLICATION_FAILED")
    val opened = distributed_operation_journal_replay_v2(root, authority_digest, maximum_events, held, sha256_text(lease))
    if opened.is_err():
        val released = file_unlock(held)
    opened

fn distributed_operation_journal_replay_v2(root: text, authority_digest: text,
        maximum_events: i64, held: i64, lease_digest: text) -> Result<DistributedOperationJournalV2, text>:
    val latest = database_wal_current_v1(root + "/database-wal", authority_digest)?
    var cursor = latest
    var sequence: i64 = 0
    var expected_last: i64 = -1
    var history: [WalEntry] = []
    while cursor != "":
        val revision = database_wal_revision_open_v1(root + "/database-wal", cursor)?
        if revision.database_identity != authority_digest: return Err("OPERATION_WAL_AUTHORITY_CHANGED")
        if expected_last >= 0 and revision.last_sequence != expected_last: return Err("OPERATION_WAL_SEQUENCE_GAP")
        if expected_last < 0:
            sequence = revision.last_sequence
            if sequence > maximum_events: return Err("OPERATION_WAL_REPLAY_BOUND_EXCEEDED")
        val entries = database_wal_segment_read_strict_v1(root + "/database-wal", revision)?
        var index = entries.len()
        while index > 0:
            index = index - 1
            history = history.push(entries[index])
            if history.len() > maximum_events: return Err("OPERATION_WAL_REPLAY_BOUND_EXCEEDED")
        expected_last = revision.first_sequence - 1
        cursor = revision.parent
    if latest != "" and expected_last != 0: return Err("OPERATION_WAL_HISTORY_INCOMPLETE")
    var rows: {text: DistributedOperationStateV2} = {}
    var index = history.len()
    while index > 0:
        index = index - 1
        val entry = history[index]
        if entry.entry_type != WalEntryType.Insert or entry.table_name != "distributed_operations_v2":
            return Err("OPERATION_WAL_EVENT_INVALID")
        val row = operation_event_decode_v2(entry.data)?
        if entry.row_key != row.operation_id: return Err("OPERATION_WAL_IDENTITY_CHANGED")
        rows = operation_event_apply_v2(rows, row)?
    Ok(DistributedOperationJournalV2(root, authority_digest, latest, sequence,
        maximum_events, held, lease_digest, rows))

fn distributed_operation_journal_commit_v2(owner: DistributedOperationJournalV2,
        row: DistributedOperationStateV2) -> Result<DistributedOperationJournalV2, text>:
    val lease_checked = operation_owner_check_v2(owner)?
    if owner.sequence >= owner.maximum_events: return Err("OPERATION_JOURNAL_FULL")
    val current = database_wal_current_v1(owner.root + "/database-wal", owner.authority_digest)?
    if current != owner.revision: return Err("OPERATION_JOURNAL_REVISION_STALE")
    # Validate first; publish before mutating any index or performing effects.
    val data = operation_event_encode_v2(row)
    val decoded = operation_event_decode_v2(data)?
    if decoded.envelope_digest != row.envelope_digest or decoded.operation_id != row.operation_id:
        return Err("OPERATION_EVENT_IDENTITY_INVALID")
    val validated = operation_event_validate_v2(owner.operations, row)?
    val revision = database_wal_commit_v1(owner.root + "/database-wal", owner.authority_digest,
        owner.revision, [WalEntry(0, WalEntryType.Insert, "distributed_operations_v2",
            row.operation_id, data, 0)])?
    # If rebuilding the runtime index fails after publication, reopen; never retry effects.
    val projection = operation_event_apply_v2(owner.operations, row)?
    Ok(DistributedOperationJournalV2(owner.root, owner.authority_digest,
        revision.digest, revision.last_sequence, owner.maximum_events, owner.parent_lock,
        owner.lease_digest, projection, owner.owned_lock))

fn distributed_operation_journal_close_v2(owner: DistributedOperationJournalV2) -> Result<bool, text>:
    # The Result adapter cannot carry cleanup after a partial owned close.
    # Reject before touching the lease; owned callers must retain typed turn.
    if owner.owned_lock.is_some(): return Err("OPERATION_JOURNAL_OWNED_CLOSE_REQUIRED")
    val checked = operation_owner_check_v2(owner)?
    if not file_delete(owner.root + "/parent.lease"): return Err("OPERATION_JOURNAL_LEASE_RELEASE_FAILED")
    if not file_unlock(owner.parent_lock): return Err("OPERATION_JOURNAL_UNLOCK_FAILED")
    Ok(true)

# One indexed read after fixed-size owner/revision checks; never replay in a hot query.
fn distributed_operation_journal_lookup_v2(owner: DistributedOperationJournalV2,
        operation_id: text) -> Result<DistributedOperationStateV2, text>:
    val checked = operation_owner_check_v2(owner)?
    val current = database_wal_current_v1(owner.root + "/database-wal", owner.authority_digest)?
    if current != owner.revision: return Err("OPERATION_JOURNAL_REVISION_STALE")
    if not owner.operations.contains_key(operation_id): return Err("OPERATION_NOT_FOUND")
    Ok(owner.operations[operation_id])

# Called by the replacement command owner before reconciliation. Losing the
# previous executor is uncertainty, never evidence that its effects did not run.
fn distributed_operation_journal_recover_execution_v2(owner: DistributedOperationJournalV2,
        operation_id: text) -> Result<DistributedOperationJournalV2, text>:
    val prior = distributed_operation_journal_lookup_v2(owner, operation_id)?
    if prior.state != "executing": return Ok(owner)
    val uncertain = distributed_operation_transition_v2(prior, "outcome-unknown", "")?
    distributed_operation_journal_commit_v2(owner, uncertain)

# Additive owned entrypoint: callers must exhaustively retain CleanupRequired.
# The legacy Result entrypoint remains a compatibility surface until all old
# owners migrate; it is not admitted for new host/controller service startup.
pub struct DistributedOperationJournalOpenCleanupV2:
    root: text
    authority_digest: text
    lease_digest: text
    lease_published: bool
    lock: FileLockOwnerV2

pub enum DistributedOperationJournalOpenV2:
    Ready(DistributedOperationJournalV2)
    Rejected(text)
    CleanupRequired(DistributedOperationJournalOpenCleanupV2, text)

pub struct DistributedOperationJournalCleanupTurnV2:
    cleanup: Option<DistributedOperationJournalOpenCleanupV2>
    closed: bool
    error: text
    state: FileLockReleaseStateV2

pub fn distributed_operation_journal_open_cleanup_v2(cleanup: DistributedOperationJournalOpenCleanupV2) -> DistributedOperationJournalCleanupTurnV2:
    var pending = cleanup
    val phase = file_lock_owner_state_v2(pending.lock)
    # A stale copied cleanup cannot read/delete a subsequent owner's lease.
    if phase == "stale":
        return DistributedOperationJournalCleanupTurnV2(nil, false,
            "OPERATION_JOURNAL_OWNER_STALE", FileLockReleaseStateV2.Stale)
    if pending.lease_published:
        if phase != "held":
            return DistributedOperationJournalCleanupTurnV2(Some(pending), false,
                "OPERATION_JOURNAL_CLEANUP_PHASE_INVALID", FileLockReleaseStateV2.Unknown)
        val lease = file_read_regular_no_follow_bounded(pending.root + "/parent.lease", 512)
        if lease.is_err():
            return DistributedOperationJournalCleanupTurnV2(Some(pending), false,
                "OPERATION_JOURNAL_LEASE_READ_FAILED", FileLockReleaseStateV2.Retained)
        if sha256_text(lease.unwrap()) != pending.lease_digest:
            return DistributedOperationJournalCleanupTurnV2(Some(pending), false,
                "OPERATION_JOURNAL_LEASE_STALE", FileLockReleaseStateV2.Retained)
        if not file_delete(pending.root + "/parent.lease"):
            return DistributedOperationJournalCleanupTurnV2(Some(pending), false,
                "OPERATION_JOURNAL_LEASE_RELEASE_FAILED", FileLockReleaseStateV2.Retained)
        pending.lease_published = false
    val released = file_lock_release_owned_v2(pending.lock)
    if val held = released.owner:
        pending.lock = held
        return DistributedOperationJournalCleanupTurnV2(Some(pending), false, released.error, released.state)
    DistributedOperationJournalCleanupTurnV2(nil, released.closed, released.error, released.state)

fn operation_open_reject_owned_v2(cleanup: DistributedOperationJournalOpenCleanupV2,
        error: text) -> DistributedOperationJournalOpenV2:
    val released = distributed_operation_journal_open_cleanup_v2(cleanup)
    if val pending = released.cleanup:
        return DistributedOperationJournalOpenV2.CleanupRequired(pending, error + ":" + released.error)
    if released.error != "":
        return DistributedOperationJournalOpenV2.Rejected(error + ":" + released.error)
    DistributedOperationJournalOpenV2.Rejected(error)

pub fn distributed_operation_journal_open_owned_v2(root: text, authority_digest: text,
        nonce: text, maximum_events: i64) -> DistributedOperationJournalOpenV2:
    if (root == "" or not builder_digest_valid_v1(authority_digest) or
            not builder_digest_valid_v1(nonce) or maximum_events <= 0 or maximum_events > 100000):
        return DistributedOperationJournalOpenV2.Rejected("OPERATION_JOURNAL_CONFIGURATION_INVALID")
    dir_create(root, true)
    val acquired = file_lock_open_owned_v2(root + "/parent.lock", 1)
    var held: Option<FileLockOwnerV2> = nil
    match acquired:
        case FileLockOpenV2.Ready(lock): held = Some(lock)
        case FileLockOpenV2.Rejected(error): return DistributedOperationJournalOpenV2.Rejected(error)
        case FileLockOpenV2.CleanupRequired(lock, error):
            return DistributedOperationJournalOpenV2.CleanupRequired(
                DistributedOperationJournalOpenCleanupV2(root, authority_digest, "", false, lock), error)
    val lock = held.unwrap()
    val lease = "DISTRIBUTED-OPERATION-LEASE-V2\n{nonce}\n{authority_digest}\n"
    var cleanup = DistributedOperationJournalOpenCleanupV2(root, authority_digest,
        sha256_text(lease), false, lock)
    if not file_atomic_write(root + "/parent.lease", lease):
        return operation_open_reject_owned_v2(cleanup, "OPERATION_JOURNAL_LEASE_PUBLICATION_FAILED")
    cleanup.lease_published = true
    val replay = distributed_operation_journal_replay_v2(root, authority_digest,
        maximum_events, -1, cleanup.lease_digest)
    if replay.is_err(): return operation_open_reject_owned_v2(cleanup, replay.unwrap_err())
    val row = replay.unwrap()
    DistributedOperationJournalOpenV2.Ready(DistributedOperationJournalV2(row.root,
        row.authority_digest, row.revision, row.sequence, row.maximum_events, -1,
        row.lease_digest, row.operations, Some(lock)))

pub fn distributed_operation_journal_close_owned_v2(owner: DistributedOperationJournalV2) -> DistributedOperationJournalCleanupTurnV2:
    if val lock = owner.owned_lock:
        return distributed_operation_journal_open_cleanup_v2(
            DistributedOperationJournalOpenCleanupV2(owner.root, owner.authority_digest,
                owner.lease_digest, true, lock))
    DistributedOperationJournalCleanupTurnV2(nil, false,
        "OPERATION_JOURNAL_LEGACY_OWNER_REQUIRES_LEGACY_CLOSE", FileLockReleaseStateV2.Stale)

export DistributedOperationJournalV2, DistributedOperationJournalOpenV2
export DistributedOperationJournalOpenCleanupV2, DistributedOperationJournalCleanupTurnV2
export distributed_operation_journal_open_owned_v2, distributed_operation_journal_open_cleanup_v2
export distributed_operation_journal_close_owned_v2
