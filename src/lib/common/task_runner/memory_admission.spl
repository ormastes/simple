# Shared process admission arithmetic. All arguments to one call must use
# the same unit (bytes for build groups, KiB for test workers).
# This is accounting, not an OS limit or the fiber progress-overcommit policy.

fn task_memory_charge_v1(reserved: i64, observed: i64) -> i64:
    """Keep the reservation floor; return -1 for an invalid charge."""
    if reserved <= 0 or observed < 0: return -1
    if observed > reserved: observed else: reserved

fn task_memory_add_v1(charged: i64, additional: i64) -> i64:
    """Accumulate nonnegative charges; -1 is an invalid/overflow sentinel."""
    if charged < 0 or additional < 0: return -1
    if additional > 9223372036854775807 - charged: return -1
    charged + additional

fn task_memory_fits_v1(budget: i64, charged: i64, reserved: i64) -> bool:
    """Strict admission with a positive reservation and no progress overshoot."""
    budget > 0 and charged >= 0 and reserved > 0 and reserved <= budget and charged <= budget - reserved

export task_memory_charge_v1, task_memory_add_v1, task_memory_fits_v1
