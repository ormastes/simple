#![allow(primitive_api)]
# primitive_api: reviewed protected-storage/broker ABI keeps byte bounds, phases, deadlines and flags as i64/bool (milestone_0011 broker-stack review r1).
friend lib.nogc_sync_mut.io
internal_export OperationJournalLinuxStorageBorrowV1
internal_export operation_broker_claim_current_v1
# Private process-local health for actual journal generations, not another WAL.
# One process-lifetime gate; no I/O, native lifetime observation, or callbacks
# under it. Busy tickets remain held while the journal releases this gate for I/O.
use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new_gate, mutex_lock_gate, mutex_unlock_gate}
use std.nogc_sync_mut.io.file_lock_owned_v2.FileLockOwnerV2
use std.nogc_sync_mut.io.windows_journal_store_v1.WindowsJournalStoreV1
use std.common.build_manager.contracts.builder_digest_valid_v1
use std.nogc_sync_mut.io.linux_protected_storage_v1.{LinuxProtectedStorageResourcesV1, linux_protected_storage_resources_v1}
use std.nogc_sync_mut.io.linux_machine_process_origin_v1.linux_machine_process_origin_check_v1
use std.nogc_sync_mut.io.linux_protected_broker_state_v1.LinuxProtectedBrokerStorageTurnV1

struct OperationJournalHealthTurnV2:
    owner_id: i64
    ticket: i64

struct OperationJournalHealthSlotV2:
    lock: Option<FileLockOwnerV2>
    store: Option<WindowsJournalStoreV1>
    binding: text
    busy: i64
    bound: bool = false
    reason: text = ""
    failing_digest: text = ""
    linux_reserved: bool = false
    linux_resources: Option<LinuxProtectedStorageResourcesV1> = nil
    broker_parent: i64 = 0
    broker_entries: Dict<text, OperationJournalBrokerEntryV1> = {}

# The bound includes opening, quarantined and cleanup-pending registrations.
# Logical IDs/tickets never recycle into copied values, including after close.
val OPERATION_JOURNAL_HEALTH_LIMIT_V2: i64 = 1024
var operation_health_gate_v2: Mutex = mutex_new_gate(0)
var operation_health_slots_v2: Dict<i64, OperationJournalHealthSlotV2> = {}
var operation_health_next_owner_v2: i64 = 1
var operation_health_next_ticket_v2: i64 = 1

fn operation_health_gate_finish_v2<T>(result: Result<T, text>) -> Result<T, text>:
    if mutex_unlock_gate(operation_health_gate_v2, 0) != 1:
        # The existing mutex contract returns zero only for an invalid handle.
        # Future lock attempts fail; no healthy fallback or replacement gate.
        return Err("OPERATION_JOURNAL_HEALTH_GATE_RELEASE_FAILED")
    result

fn operation_health_same_v2(slot: OperationJournalHealthSlotV2,
        lock: Option<FileLockOwnerV2>, store: Option<WindowsJournalStoreV1>) -> bool:
    if val windows = store:
        if lock.is_some() or slot.lock.is_some() or slot.store.is_none(): return false
        return windows.same_owner(slot.store.unwrap())
    if val held = lock:
        if store.is_some() or slot.store.is_some() or slot.lock.is_none(): return false
        return held.token == slot.lock.unwrap().token
    false

fn operation_health_turn_valid_v2(turn: OperationJournalHealthTurnV2) -> bool:
    if turn.owner_id <= 0 or turn.ticket <= 0: return false
    if not operation_health_slots_v2.contains_key(turn.owner_id): return false
    operation_health_slots_v2[turn.owner_id].busy == turn.ticket

fn operation_health_reserve_held_v2(store: Option<WindowsJournalStoreV1>,
        binding: text) -> Result<OperationJournalHealthTurnV2, text>:
    # Windows open receives an already-retained capability. Duplicate refusal
    # must happen before lease writes and must never close that borrowed alias.
    if val windows = store:
        for id in operation_health_slots_v2.keys():
            val slot = operation_health_slots_v2[id]
            if val prior = slot.store:
                if windows.same_owner(prior): return Err("OPERATION_JOURNAL_NATIVE_ALREADY_REGISTERED")
    if not builder_digest_valid_v1(binding): return Err("OPERATION_JOURNAL_HEALTH_BINDING_INVALID")
    if operation_health_slots_v2.len() >= OPERATION_JOURNAL_HEALTH_LIMIT_V2:
        return Err("OPERATION_JOURNAL_HEALTH_LIMIT")
    if operation_health_next_owner_v2 >= 9223372036854775807 or operation_health_next_ticket_v2 >= 9223372036854775807:
        return Err("OPERATION_JOURNAL_HEALTH_GENERATION_EXHAUSTED")
    val id = operation_health_next_owner_v2
    val ticket = operation_health_next_ticket_v2
    operation_health_next_owner_v2 = id + 1
    operation_health_next_ticket_v2 = ticket + 1
    operation_health_slots_v2[id] = OperationJournalHealthSlotV2(nil, store, binding, ticket)
    Ok(OperationJournalHealthTurnV2(id, ticket))

fn operation_health_reserve_v2(store: Option<WindowsJournalStoreV1>,
        binding: text) -> Result<OperationJournalHealthTurnV2, text>:
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    operation_health_gate_finish_v2(operation_health_reserve_held_v2(store, binding))

fn operation_health_bind_held_v2(turn: OperationJournalHealthTurnV2,
        lock: Option<FileLockOwnerV2>, store: Option<WindowsJournalStoreV1>) -> Result<bool, text>:
    if not operation_health_turn_valid_v2(turn): return Err("OPERATION_JOURNAL_HEALTH_TICKET_INVALID")
    if lock.is_some() == store.is_some(): return Err("OPERATION_JOURNAL_HEALTH_IDENTITY_INVALID")
    if val held = lock:
        if held.token <= 0: return Err("OPERATION_JOURNAL_HEALTH_IDENTITY_INVALID")
    var slot = operation_health_slots_v2[turn.owner_id]
    if slot.linux_reserved: return Err("OPERATION_JOURNAL_PROTECTED_BINDING_REQUIRED")
    if slot.bound: return Err("OPERATION_JOURNAL_HEALTH_ALREADY_BOUND")
    if val reserved = slot.store:
        if store.is_none() or not reserved.same_owner(store.unwrap()):
            return Err("OPERATION_JOURNAL_HEALTH_IDENTITY_INVALID")
    for id in operation_health_slots_v2.keys():
        if id != turn.owner_id and operation_health_same_v2(operation_health_slots_v2[id], lock, store):
            return Err("OPERATION_JOURNAL_NATIVE_ALREADY_REGISTERED")
    slot.lock = lock
    slot.store = store
    slot.bound = true
    operation_health_slots_v2[turn.owner_id] = slot
    Ok(true)

fn operation_health_bind_v2(turn: OperationJournalHealthTurnV2,
        lock: Option<FileLockOwnerV2>, store: Option<WindowsJournalStoreV1>) -> Result<bool, text>:
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    operation_health_gate_finish_v2(operation_health_bind_held_v2(turn, lock, store))

fn operation_health_begin_held_v2(id: i64, lock: Option<FileLockOwnerV2>,
        store: Option<WindowsJournalStoreV1>, binding: text,
        cleanup: bool) -> Result<OperationJournalHealthTurnV2, text>:
    if not operation_health_slots_v2.contains_key(id): return Err("OPERATION_JOURNAL_HEALTH_UNKNOWN")
    var slot = operation_health_slots_v2[id]
    if slot.linux_reserved: return Err("OPERATION_JOURNAL_PROTECTED_BINDING_REQUIRED")
    if not slot.bound or not operation_health_same_v2(slot, lock, store) or slot.binding != binding:
        return Err("OPERATION_JOURNAL_HEALTH_IDENTITY_INVALID")
    if slot.busy != 0: return Err("OPERATION_JOURNAL_OWNER_BUSY")
    if not cleanup and slot.reason != "":
        return Err("OPERATION_JOURNAL_QUARANTINED:" + slot.reason + ":" + slot.failing_digest)
    if operation_health_next_ticket_v2 >= 9223372036854775807:
        return Err("OPERATION_JOURNAL_HEALTH_GENERATION_EXHAUSTED")
    val ticket = operation_health_next_ticket_v2
    operation_health_next_ticket_v2 = ticket + 1
    slot.busy = ticket
    operation_health_slots_v2[id] = slot
    Ok(OperationJournalHealthTurnV2(id, ticket))

fn operation_health_begin_v2(id: i64, lock: Option<FileLockOwnerV2>,
        store: Option<WindowsJournalStoreV1>, binding: text,
        cleanup: bool = false) -> Result<OperationJournalHealthTurnV2, text>:
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    operation_health_gate_finish_v2(operation_health_begin_held_v2(id, lock, store, binding, cleanup))

fn operation_health_poison_held_v2(turn: OperationJournalHealthTurnV2,
        reason: text, failing_digest: text) -> Result<bool, text>:
    if not operation_health_turn_valid_v2(turn): return Err("OPERATION_JOURNAL_HEALTH_TICKET_INVALID")
    # Invalid CURRENT framing may have no immutable object identity at all.
    # Keep that absence explicit instead of inventing a valid-looking digest.
    if reason == "" or (failing_digest != "" and not builder_digest_valid_v1(failing_digest)):
        return Err("OPERATION_JOURNAL_HEALTH_DIAGNOSTIC_INVALID")
    var slot = operation_health_slots_v2[turn.owner_id]
    if slot.reason == "":
        slot.reason = if reason.byte_len() <= 256: reason else: "OPERATION_JOURNAL_STORED_INTEGRITY_FAILURE"
        slot.failing_digest = failing_digest
        operation_health_slots_v2[turn.owner_id] = slot
    Ok(true)

fn operation_health_poison_v2(turn: OperationJournalHealthTurnV2,
        reason: text, failing_digest: text) -> Result<bool, text>:
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    operation_health_gate_finish_v2(operation_health_poison_held_v2(turn, reason, failing_digest))

fn operation_health_end_held_v2(turn: OperationJournalHealthTurnV2,
        retire: bool) -> Result<bool, text>:
    if not operation_health_turn_valid_v2(turn): return Err("OPERATION_JOURNAL_HEALTH_TICKET_INVALID")
    if retire:
        if operation_health_slots_v2[turn.owner_id].linux_resources.is_some():
            return Err("OPERATION_JOURNAL_HEALTH_NATIVE_OWNER_RETAINED")
        operation_health_slots_v2.remove(turn.owner_id)
    else:
        var slot = operation_health_slots_v2[turn.owner_id]
        slot.busy = 0
        operation_health_slots_v2[turn.owner_id] = slot
    Ok(true)

fn operation_health_end_v2(turn: OperationJournalHealthTurnV2,
        retire: bool = false) -> Result<bool, text>:
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    operation_health_gate_finish_v2(operation_health_end_held_v2(turn, retire))

fn operation_health_cancel_held_v2(turn: OperationJournalHealthTurnV2) -> Result<bool, text>:
    if not operation_health_turn_valid_v2(turn): return Err("OPERATION_JOURNAL_HEALTH_TICKET_INVALID")
    val slot = operation_health_slots_v2[turn.owner_id]
    if slot.bound or slot.lock.is_some() or slot.store.is_some() or slot.linux_resources.is_some():
        return Err("OPERATION_JOURNAL_HEALTH_NATIVE_OWNER_RETAINED")
    operation_health_end_held_v2(turn, true)

fn operation_health_cancel_v2(turn: OperationJournalHealthTurnV2) -> Result<bool, text>:
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    operation_health_gate_finish_v2(operation_health_cancel_held_v2(turn))

# Linux resource identity is this SAME oracle slot, not another store registry.
class OperationJournalLinuxStorageOwnerV1:
    identity: i64
    pub fn same_owner(other: OperationJournalLinuxStorageOwnerV1) -> bool: self.identity == other.identity
    pub fn matches_health_id_v1(id: i64) -> bool: self.identity == id

class OperationJournalLinuxStorageBorrowV1:
    turn: OperationJournalHealthTurnV2
    pub(friend) fn broker_finish_v1() -> Result<bool, text>:
        unsafe(capabilities: [ffi, raw_ptr]): linux_machine_process_origin_check_v1()?
        operation_health_end_v2(self.turn)
    pub(friend) fn broker_acquire_v1(installed: OperationJournalLinuxStorageOwnerV1, installed_binding: text,
            key: text, claim: text, root: text, binding: text, origin_ms: i64, deadline_ms: i64,
            offered: Option<OperationJournalLinuxStorageOwnerV1>) -> OperationJournalBrokerAcquireV1:
        operation_broker_acquire_v1(self.turn, installed, installed_binding, key, claim, root, binding, origin_ms, deadline_ms, offered)
    pub(friend) fn broker_release_v1(installed: OperationJournalLinuxStorageOwnerV1, installed_binding: text,
            key: text, claim: text) -> OperationJournalBrokerAcquireV1:
        operation_broker_release_v1(self.turn, key, claim, installed, installed_binding)
    pub(friend) fn broker_control_v1(claim: OperationJournalBrokerClaimV1, action: text,
            identity: text, deadline: i64, generation: i64, request_digest: text, payload: text) -> LinuxProtectedBrokerStorageTurnV1:
        if action != "step" and deadline != claim.deadline_ms:
            return LinuxProtectedBrokerStorageTurnV1(error: "BROKER_ORIGINAL_DEADLINE_MISMATCH")
        val checked = operation_broker_claim_current_v1(claim, OperationJournalLinuxStorageOwnerV1(self.turn.owner_id))
        if checked.is_err(): return LinuxProtectedBrokerStorageTurnV1(error: checked.unwrap_err())
        val acquired = operation_health_linux_resources_v1(self.turn)
        if acquired.is_err(): return LinuxProtectedBrokerStorageTurnV1(error: acquired.unwrap_err())
        var resources = acquired.unwrap()
        var result = resources.broker_control_v1(action, identity, deadline, generation, request_digest, payload)
        val after = operation_broker_claim_current_v1(claim, OperationJournalLinuxStorageOwnerV1(self.turn.owner_id))
        if after.is_err(): result.error = after.unwrap_err()
        result
    pub fn read(relative: text, maximum: i64, retain: bool = false) -> Result<Option<text>, text>:
        var resources = operation_health_linux_resources_v1(self.turn)?
        resources.read_v1(relative, maximum, retain)
    pub fn publish(relative: text, payload: text) -> Result<bool, text>:
        var resources = operation_health_linux_resources_v1(self.turn)?
        resources.publish_v1(relative, payload)
    pub fn compare_replace(relative: text, payload: text, expected: Option<text>) -> Result<bool, text>:
        var resources = operation_health_linux_resources_v1(self.turn)?
        resources.publish_v1(relative, payload, expected)
    pub fn replace(relative: text, payload: text) -> Result<bool, text>:
        val previous = self.read(relative, 8388608)?
        self.compare_replace(relative, payload, previous)
    pub fn current() -> Result<(), text>:
        val resources = operation_health_linux_resources_v1(self.turn)?
        resources.current_v1()

struct OperationJournalLinuxStorageOpenV1:
    owner: Option<OperationJournalLinuxStorageOwnerV1>
    turn: Option<OperationJournalHealthTurnV2>
    error: text

fn operation_health_linux_resources_v1(turn: OperationJournalHealthTurnV2) -> Result<LinuxProtectedStorageResourcesV1, text>:
    unsafe(capabilities: [ffi, raw_ptr]): linux_machine_process_origin_check_v1()?
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    if not operation_health_turn_valid_v2(turn):
        return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_HEALTH_TICKET_INVALID"))
    val slot = operation_health_slots_v2[turn.owner_id]
    if not slot.linux_reserved or slot.store.is_some() or slot.lock.is_some() or slot.linux_resources.is_none():
        return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_PROTECTED_BINDING_REQUIRED"))
    operation_health_gate_finish_v2(Ok(slot.linux_resources.unwrap()))

fn operation_health_linux_open_v1(root: text, binding: text,
        writer: bool = true, create_final: bool = true) -> OperationJournalLinuxStorageOpenV1:
    val origin = unsafe(capabilities: [ffi, raw_ptr]): linux_machine_process_origin_check_v1()
    if origin.is_err(): return OperationJournalLinuxStorageOpenV1(nil, nil, origin.unwrap_err())
    val reserved = operation_health_reserve_v2(nil, binding)
    if reserved.is_err(): return OperationJournalLinuxStorageOpenV1(nil, nil, reserved.unwrap_err())
    val turn = reserved.unwrap()
    val owner = OperationJournalLinuxStorageOwnerV1(identity: turn.owner_id)
    # Allocation has no descriptors yet. The slot receives the stable cell
    # before open_v1 can perform any filesystem acquisition or validation.
    var resources = linux_protected_storage_resources_v1(root)
    if mutex_lock_gate(operation_health_gate_v2).is_none():
        val drained = resources.close_step_v1()
        if drained.is_ok() and drained.unwrap():
            val disposed = resources.dispose_closed_v1()
        return OperationJournalLinuxStorageOpenV1(Some(owner), Some(turn), "OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    var slot = operation_health_slots_v2[turn.owner_id]
    slot.linux_reserved = true
    slot.linux_resources = Some(resources)
    operation_health_slots_v2[turn.owner_id] = slot
    val unlocked = operation_health_gate_finish_v2(Ok(true))
    if unlocked.is_err(): return OperationJournalLinuxStorageOpenV1(Some(owner), Some(turn), unlocked.unwrap_err())
    val opened = resources.open_v1(writer, create_final)
    OperationJournalLinuxStorageOpenV1(Some(owner), Some(turn), if opened.is_err(): opened.unwrap_err() else: "")

fn operation_health_linux_borrow_v1(owner: OperationJournalLinuxStorageOwnerV1,
        turn: OperationJournalHealthTurnV2) -> Result<OperationJournalLinuxStorageBorrowV1, text>:
    unsafe(capabilities: [ffi, raw_ptr]): linux_machine_process_origin_check_v1()?
    if owner.identity != turn.owner_id: return Err("OPERATION_JOURNAL_PROTECTED_BINDING_MISMATCH")
    val resources = operation_health_linux_resources_v1(turn)?
    resources.current_v1()?
    Ok(OperationJournalLinuxStorageBorrowV1(turn: turn))

fn operation_health_linux_bind_v1(owner: OperationJournalLinuxStorageOwnerV1,
        turn: OperationJournalHealthTurnV2) -> Result<bool, text>:
    val actual = operation_health_linux_borrow_v1(owner, turn)?
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    if not operation_health_turn_valid_v2(turn): return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_HEALTH_TICKET_INVALID"))
    var slot = operation_health_slots_v2[turn.owner_id]
    if slot.bound: return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_HEALTH_ALREADY_BOUND"))
    slot.bound = true
    operation_health_slots_v2[turn.owner_id] = slot
    operation_health_gate_finish_v2(Ok(true))

fn operation_health_linux_begin_v1(owner: OperationJournalLinuxStorageOwnerV1,
        binding: text, cleanup: bool = false) -> Result<OperationJournalHealthTurnV2, text>:
    operation_health_linux_begin_with_parent_v1(owner, binding, cleanup, nil)

pub(package) fn operation_health_linux_begin_with_parent_v1(owner: OperationJournalLinuxStorageOwnerV1,
        binding: text, cleanup: bool, parent_turn: Option<OperationJournalHealthTurnV2>) -> Result<OperationJournalHealthTurnV2, text>:
    unsafe(capabilities: [ffi, raw_ptr]): linux_machine_process_origin_check_v1()?
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    if not operation_health_slots_v2.contains_key(owner.identity): return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_HEALTH_UNKNOWN"))
    var slot = operation_health_slots_v2[owner.identity]
    if cleanup and slot.broker_parent != 0:
        if parent_turn.is_none() or not operation_health_turn_valid_v2(parent_turn.unwrap()) or parent_turn.unwrap().owner_id != slot.broker_parent:
            return operation_health_gate_finish_v2(Err("BROKER_CHILD_RETAINED_BY_JOURNAL"))
    if (not slot.linux_reserved or slot.store.is_some() or slot.lock.is_some() or slot.binding != binding or
            (not cleanup and (not slot.bound or slot.linux_resources.is_none()))):
        return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_PROTECTED_BINDING_REQUIRED"))
    if slot.busy != 0: return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_OWNER_BUSY"))
    if not cleanup and slot.reason != "": return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_QUARANTINED:" + slot.reason))
    if operation_health_next_ticket_v2 >= 9223372036854775807:
        return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_HEALTH_GENERATION_EXHAUSTED"))
    val ticket = operation_health_next_ticket_v2
    operation_health_next_ticket_v2 = ticket + 1
    slot.busy = ticket
    operation_health_slots_v2[owner.identity] = slot
    operation_health_gate_finish_v2(Ok(OperationJournalHealthTurnV2(owner.identity, ticket)))

struct OperationJournalLinuxCloseV1:
    closed: bool
    error: text

# Does not require currentness; consumes only exact held native resources.
# Caller keeps the existing oracle ticket until each cleanup step is persisted.
fn operation_health_linux_close_step_v1(owner: OperationJournalLinuxStorageOwnerV1,
        turn: OperationJournalHealthTurnV2) -> Result<OperationJournalLinuxCloseV1, text>:
    operation_health_linux_close_with_parent_v1(owner, turn, nil)

pub(package) fn operation_health_linux_close_with_parent_v1(owner: OperationJournalLinuxStorageOwnerV1,
        turn: OperationJournalHealthTurnV2, parent_turn: Option<OperationJournalHealthTurnV2>) -> Result<OperationJournalLinuxCloseV1, text>:
    unsafe(capabilities: [ffi, raw_ptr]): linux_machine_process_origin_check_v1()?
    if owner.identity != turn.owner_id: return Err("OPERATION_JOURNAL_PROTECTED_BINDING_MISMATCH")
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    if not operation_health_slots_v2.contains_key(turn.owner_id): return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_HEALTH_UNKNOWN"))
    if not operation_health_turn_valid_v2(turn): return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_HEALTH_TICKET_INVALID"))
    val before = operation_health_slots_v2[turn.owner_id]
    if before.broker_parent != 0:
        if parent_turn.is_none() or not operation_health_turn_valid_v2(parent_turn.unwrap()) or parent_turn.unwrap().owner_id != before.broker_parent:
            return operation_health_gate_finish_v2(Err("BROKER_CHILD_RETAINED_BY_JOURNAL"))
    if before.linux_resources.is_none() and not before.bound and before.lock.is_none() and before.store.is_none():
        val retired = operation_health_end_held_v2(turn, true)
        if retired.is_err(): return operation_health_gate_finish_v2(Err(retired.unwrap_err()))
        val unlocked = operation_health_gate_finish_v2(Ok(true))
        return Ok(OperationJournalLinuxCloseV1(true, if unlocked.is_err(): unlocked.unwrap_err() else: ""))
    val released = operation_health_gate_finish_v2(Ok(true))
    if released.is_err(): return Err(released.unwrap_err())
    val children = operation_broker_children_close_v1(turn)?
    if not children: return Ok(OperationJournalLinuxCloseV1(false, ""))
    var resources = operation_health_linux_resources_v1(turn)?
    val closed = resources.close_step_v1()
    if closed.is_err(): return Ok(OperationJournalLinuxCloseV1(false, closed.unwrap_err()))
    if not closed.unwrap(): return Ok(OperationJournalLinuxCloseV1(false, resources.failure_v1()))
    val diagnostic = resources.failure_v1()
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    if not operation_health_turn_valid_v2(turn): return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_HEALTH_TICKET_INVALID"))
    var slot = operation_health_slots_v2[turn.owner_id]
    slot.linux_resources = nil
    slot.bound = false
    operation_health_slots_v2[turn.owner_id] = slot
    val retired = operation_health_end_held_v2(turn, true)
    if retired.is_err(): return operation_health_gate_finish_v2(Err(retired.unwrap_err()))
    val unlocked = operation_health_gate_finish_v2(Ok(true))
    # Actual retirement is conclusive even if metadata unlock reports error.
    # No canonical slot can now reach the resource cell, so free it exactly once.
    val disposed = resources.dispose_closed_v1()
    var error = diagnostic
    if error == "" and unlocked.is_err(): error = unlocked.unwrap_err()
    if error == "" and disposed.is_err(): error = disposed.unwrap_err()
    Ok(OperationJournalLinuxCloseV1(true, error))

fn operation_stored_result_v2<T>(result: Result<T, text>,
        turn: Option<OperationJournalHealthTurnV2>, digest: text) -> Result<T, text>:
    # Only authoritative stored-read/validation boundaries call this helper.
    # Failure to validate is sticky even when the I/O error is unstructured.
    # Caller validation and unreachable publication failures never call it.
    if result.is_err():
        if val held = turn:
            val poisoned = operation_health_poison_v2(held, result.unwrap_err(), digest)
            if poisoned.is_err(): return Err(poisoned.unwrap_err())
    result

# Original journal health-slot association; no independent authority registry.
pub(package) struct OperationJournalBrokerEntryV1:
    claim: text
    installed: OperationJournalLinuxStorageOwnerV1
    installed_binding: text
    root: text
    binding: text
    origin_ms: i64
    deadline_ms: i64
    child: Option<OperationJournalLinuxStorageOwnerV1> = nil
    opening: Option<OperationJournalHealthTurnV2> = nil
    ready: bool = false
    retired: bool = false
    error: text = ""

pub class OperationJournalBrokerClaimV1:
    parent: OperationJournalLinuxStorageOwnerV1
    parent_binding: text
    key: text
    claim: text
    child: OperationJournalLinuxStorageOwnerV1
    deadline_ms: i64

pub struct OperationJournalBrokerAcquireV1:
    binding: text = ""
    claim: Option<OperationJournalBrokerClaimV1> = nil
    child: Option<OperationJournalLinuxStorageOwnerV1> = nil
    opening: Option<OperationJournalHealthTurnV2> = nil
    ready: bool = false
    adopted_offered: bool = false
    completed: bool = false
    origin_ms: i64 = 0
    deadline_ms: i64 = 0
    error: text = ""

# Gate must be held. Result captures custody even when entry.error is nonempty.
pub(package) fn operation_broker_result_v1(parent: OperationJournalHealthTurnV2, key: text,
        entry: OperationJournalBrokerEntryV1, offered: Option<OperationJournalLinuxStorageOwnerV1>) -> OperationJournalBrokerAcquireV1:
    var result = OperationJournalBrokerAcquireV1(binding: entry.binding, child: entry.child, opening: entry.opening,
        ready: entry.ready and not entry.retired and entry.opening.is_none(), completed: entry.retired,
        origin_ms: entry.origin_ms, deadline_ms: entry.deadline_ms, error: entry.error)
    if val child = entry.child:
        result.claim = Some(OperationJournalBrokerClaimV1(OperationJournalLinuxStorageOwnerV1(parent.owner_id),
            operation_health_slots_v2[parent.owner_id].binding, key, entry.claim, child, entry.deadline_ms))
        if val supplied = offered: result.adopted_offered = child.same_owner(supplied)
    result

pub(package) fn operation_broker_entry_v1(turn: OperationJournalHealthTurnV2, key: text) -> Result<OperationJournalBrokerEntryV1, text>:
    unsafe(capabilities: [ffi, raw_ptr]): linux_machine_process_origin_check_v1()?
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    if not operation_health_turn_valid_v2(turn): return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_HEALTH_TICKET_INVALID"))
    val slot = operation_health_slots_v2[turn.owner_id]
    if not slot.broker_entries.contains_key(key): return operation_health_gate_finish_v2(Err("BROKER_CLAIM_UNKNOWN"))
    operation_health_gate_finish_v2(Ok(slot.broker_entries[key]))

pub(package) fn operation_broker_store_v1(turn: OperationJournalHealthTurnV2, key: text,
        entry: OperationJournalBrokerEntryV1) -> Result<(), text>:
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    if not operation_health_turn_valid_v2(turn): return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_HEALTH_TICKET_INVALID"))
    var slot = operation_health_slots_v2[turn.owner_id]
    # Commit returned custody before any subsequent child validation/error.
    slot.broker_entries[key] = entry
    operation_health_slots_v2[turn.owner_id] = slot
    if val child = entry.child:
        if not operation_health_slots_v2.contains_key(child.identity):
            return operation_health_gate_finish_v2(Err("BROKER_CHILD_UNKNOWN"))
        var child_slot = operation_health_slots_v2[child.identity]
        if child_slot.broker_parent != 0 and child_slot.broker_parent != turn.owner_id:
            return operation_health_gate_finish_v2(Err("BROKER_CHILD_ALREADY_ADOPTED"))
        child_slot.broker_parent = turn.owner_id
        operation_health_slots_v2[child.identity] = child_slot
    operation_health_gate_finish_v2(Ok(()))

pub(package) fn operation_broker_acquire_v1(turn: OperationJournalHealthTurnV2,
        installed: OperationJournalLinuxStorageOwnerV1, installed_binding: text,
        key: text, claim: text, root: text, binding: text, origin_ms: i64, deadline_ms: i64,
        offered: Option<OperationJournalLinuxStorageOwnerV1>) -> OperationJournalBrokerAcquireV1:
    val writer = operation_health_linux_resources_v1(turn)
    if writer.is_err(): return OperationJournalBrokerAcquireV1(error: writer.unwrap_err())
    val current = writer.unwrap().broker_writer_current_v1()
    if current.is_err(): return OperationJournalBrokerAcquireV1(error: current.unwrap_err())
    if not builder_digest_valid_v1(key) or not builder_digest_valid_v1(claim) or not builder_digest_valid_v1(binding):
        return OperationJournalBrokerAcquireV1(error: "BROKER_CLAIM_SHAPE")
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return OperationJournalBrokerAcquireV1(error: "OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    if not operation_health_turn_valid_v2(turn):
        val ended = operation_health_gate_finish_v2(Ok(true))
        return OperationJournalBrokerAcquireV1(error: "OPERATION_JOURNAL_HEALTH_TICKET_INVALID")
    var slot = operation_health_slots_v2[turn.owner_id]
    if slot.broker_entries.contains_key(key):
        val prior = slot.broker_entries[key]
        var result = operation_broker_result_v1(turn, key, prior, offered)
        if prior.claim != claim or not prior.installed.same_owner(installed) or prior.installed_binding != installed_binding or prior.root != root or prior.binding != binding:
            result.ready = false
            result.error = "BROKER_CLAIM_REPLAY_MISMATCH"
        val ended = operation_health_gate_finish_v2(Ok(true))
        if ended.is_err(): result.error = ended.unwrap_err()
        return result
    for prior_key in slot.broker_entries.keys():
        if slot.broker_entries[prior_key].root == root:
            val ended = operation_health_gate_finish_v2(Ok(true))
            return OperationJournalBrokerAcquireV1(error: "BROKER_ROOT_ALREADY_CLAIMED")
    if slot.broker_entries.len() >= 64 or origin_ms < 0 or deadline_ms <= origin_ms or deadline_ms - origin_ms > 86400000:
        val ended = operation_health_gate_finish_v2(Ok(true))
        return OperationJournalBrokerAcquireV1(error: "BROKER_CLAIM_BOUND")
    if val child = offered:
        if not operation_health_slots_v2.contains_key(child.identity) or child.identity == turn.owner_id:
            val ended = operation_health_gate_finish_v2(Ok(true))
            return OperationJournalBrokerAcquireV1(error: "BROKER_OFFERED_OWNER_INVALID")
        val existing = operation_health_slots_v2[child.identity]
        if existing.binding != binding or existing.broker_parent != 0 or existing.busy != 0 or not existing.bound:
            val ended = operation_health_gate_finish_v2(Ok(true))
            return OperationJournalBrokerAcquireV1(error: "BROKER_OFFERED_OWNER_UNAVAILABLE")
    var entry = OperationJournalBrokerEntryV1(claim, installed, installed_binding, root, binding, origin_ms, deadline_ms)
    # Reservation precedes external acquisition. Failed openings are not retried.
    slot.broker_entries[key] = entry
    operation_health_slots_v2[turn.owner_id] = slot
    val reserved = operation_health_gate_finish_v2(Ok(true))
    if reserved.is_err(): return OperationJournalBrokerAcquireV1(error: reserved.unwrap_err())
    var opened = OperationJournalLinuxStorageOpenV1(offered, nil, "")
    if offered.is_none(): opened = operation_health_linux_open_v1(root, binding, false, false)
    else:
        val borrowed = operation_health_linux_begin_v1(offered.unwrap(), binding)
        if borrowed.is_err(): opened.error = borrowed.unwrap_err()
        else:
            val checked = operation_health_linux_borrow_v1(offered.unwrap(), borrowed.unwrap())
            val ended = operation_health_end_v2(borrowed.unwrap())
            if checked.is_err(): opened.error = checked.unwrap_err()
            if ended.is_err():
                opened.turn = Some(borrowed.unwrap())
                if opened.error == "": opened.error = ended.unwrap_err()
    entry.child = opened.owner
    entry.opening = opened.turn
    entry.error = opened.error
    val stored = operation_broker_store_v1(turn, key, entry)
    if stored.is_err():
        return OperationJournalBrokerAcquireV1(binding: entry.binding, child: opened.owner, opening: opened.turn,
            adopted_offered: offered.is_some(), origin_ms: origin_ms, deadline_ms: deadline_ms, error: stored.unwrap_err())
    if opened.error == "" and opened.owner.is_some():
        if val opening = opened.turn:
            val bound = operation_health_linux_bind_v1(opened.owner.unwrap(), opening)
            if bound.is_err(): entry.error = bound.unwrap_err()
            else:
                val ended = operation_health_end_v2(opening)
                if ended.is_err(): entry.error = ended.unwrap_err()
                else: entry.opening = nil
        entry.ready = entry.error == ""
    elif entry.error == "": entry.error = "BROKER_CHILD_OPEN_NO_OWNER"
    val committed = operation_broker_store_v1(turn, key, entry)
    if committed.is_err(): entry.error = committed.unwrap_err()
    if mutex_lock_gate(operation_health_gate_v2).is_none():
        return OperationJournalBrokerAcquireV1(binding: entry.binding, child: entry.child, opening: entry.opening, origin_ms: entry.origin_ms, deadline_ms: entry.deadline_ms, error: "OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    var result = operation_broker_result_v1(turn, key, entry, offered)
    val ended = operation_health_gate_finish_v2(Ok(true))
    if ended.is_err(): result.error = ended.unwrap_err()
    result

pub(package) fn operation_broker_reader_current_v1(owner: OperationJournalLinuxStorageOwnerV1, binding: text) -> Result<(), text>:
    val turn = operation_health_linux_begin_v1(owner, binding)?
    val checked = operation_health_linux_borrow_v1(owner, turn)
    val ended = operation_health_end_v2(turn)
    if ended.is_err(): return Err(ended.unwrap_err())
    if checked.is_err(): return Err(checked.unwrap_err())
    Ok(())

pub(friend) fn operation_broker_claim_current_v1(claim: OperationJournalBrokerClaimV1,
        child: OperationJournalLinuxStorageOwnerV1) -> Result<(), text>:
    unsafe(capabilities: [ffi, raw_ptr]): linux_machine_process_origin_check_v1()?
    if not claim.child.same_owner(child): return Err("BROKER_CLAIM_CHILD_MISMATCH")
    val turn = operation_health_linux_begin_v1(claim.parent, claim.parent_binding)?
    val entry = operation_broker_entry_v1(turn, claim.key)
    var result: Result<(), text> = if entry.is_err(): Err(entry.unwrap_err()) else: Ok(())
    if entry.is_ok():
        val value = entry.unwrap()
        if value.claim != claim.claim or value.child.is_none() or not value.child.unwrap().same_owner(child) or not value.ready or value.retired:
            result = Err("BROKER_CLAIM_NOT_CURRENT")
        else:
            val resources = operation_health_linux_resources_v1(turn)
            result = if resources.is_err(): Err(resources.unwrap_err()) else: resources.unwrap().broker_writer_current_v1()
            if result.is_ok(): result = operation_broker_reader_current_v1(value.installed, value.installed_binding)
    val ended = operation_health_end_v2(turn)
    if ended.is_err(): return Err(ended.unwrap_err())
    result

pub(package) fn operation_broker_release_v1(turn: OperationJournalHealthTurnV2, key: text,
        claim: text, installed: OperationJournalLinuxStorageOwnerV1,
        installed_binding: text, parent_cleanup: bool = false) -> OperationJournalBrokerAcquireV1:
    val loaded = operation_broker_entry_v1(turn, key)
    if loaded.is_err(): return OperationJournalBrokerAcquireV1(error: loaded.unwrap_err())
    var entry = loaded.unwrap()
    if not parent_cleanup and (entry.claim != claim or not entry.installed.same_owner(installed) or entry.installed_binding != installed_binding):
        return OperationJournalBrokerAcquireV1(error: "BROKER_RELEASE_CLAIM_MISMATCH")
    if entry.child.is_some() and not entry.retired:
        val child = entry.child.unwrap()
        val acquired = if entry.opening.is_some(): Ok(entry.opening.unwrap()) else:
            operation_health_linux_begin_with_parent_v1(child, entry.binding, true, Some(turn))
        if acquired.is_err(): return OperationJournalBrokerAcquireV1(binding: entry.binding, child: entry.child, opening: entry.opening, origin_ms: entry.origin_ms, deadline_ms: entry.deadline_ms, error: acquired.unwrap_err())
        entry.opening = Some(acquired.unwrap())
        entry.ready = false
        val saved = operation_broker_store_v1(turn, key, entry)
        if saved.is_err(): return OperationJournalBrokerAcquireV1(binding: entry.binding, child: entry.child, opening: entry.opening, origin_ms: entry.origin_ms, deadline_ms: entry.deadline_ms, error: saved.unwrap_err())
        val closed = operation_health_linux_close_with_parent_v1(child, acquired.unwrap(), Some(turn))
        if closed.is_err(): return OperationJournalBrokerAcquireV1(binding: entry.binding, child: entry.child, opening: entry.opening, origin_ms: entry.origin_ms, deadline_ms: entry.deadline_ms, error: closed.unwrap_err())
        if closed.unwrap().closed:
            entry.retired = true
            entry.ready = false
            entry.child = nil
            entry.opening = nil
        if entry.error == "": entry.error = closed.unwrap().error
    else:
        entry.retired = true
        entry.ready = false
    val stored = operation_broker_store_v1(turn, key, entry)
    if stored.is_err(): return OperationJournalBrokerAcquireV1(binding: entry.binding, child: entry.child, opening: entry.opening, origin_ms: entry.origin_ms, deadline_ms: entry.deadline_ms, error: stored.unwrap_err())
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return OperationJournalBrokerAcquireV1(binding: entry.binding, child: entry.child, opening: entry.opening, origin_ms: entry.origin_ms, deadline_ms: entry.deadline_ms, error: "OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    var result = operation_broker_result_v1(turn, key, entry, nil)
    val ended = operation_health_gate_finish_v2(Ok(true))
    if ended.is_err(): result.error = ended.unwrap_err()
    result

# One child cleanup step per parent cleanup call. Tombstones are not recycled.
pub(package) fn operation_broker_children_close_v1(turn: OperationJournalHealthTurnV2) -> Result<bool, text>:
    if mutex_lock_gate(operation_health_gate_v2).is_none(): return Err("OPERATION_JOURNAL_HEALTH_GATE_UNAVAILABLE")
    if not operation_health_turn_valid_v2(turn): return operation_health_gate_finish_v2(Err("OPERATION_JOURNAL_HEALTH_TICKET_INVALID"))
    val entries = operation_health_slots_v2[turn.owner_id].broker_entries
    val ended = operation_health_gate_finish_v2(Ok(true))
    if ended.is_err(): return Err(ended.unwrap_err())
    for key in entries.keys():
        val entry = entries[key]
        if entry.retired: continue
        val result = operation_broker_release_v1(turn, key, entry.claim, entry.installed, entry.installed_binding, true)
        if not result.completed and result.error != "": return Err(result.error)
        return Ok(false)
    Ok(true)
