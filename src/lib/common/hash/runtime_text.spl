# Stable byte hash for persisted runtime source/interface sidecars (including
# dynSMF source and interface sidecars).
# Keep this leaf independent of trait/collection and host-runtime providers.

pub fn runtime_text_hash_v1(value: text) -> i64:
    """FNV-1a64 over all UTF-8 bytes, returned as signed two's-complement i64.

    Matches rt_hash_text for length-bearing text, including empty input and NUL.
    Multiplication wraps modulo 2^64; no Unicode normalization is applied.
    Non-cryptographic: use for cache freshness, not integrity or trust.
    O(n) time for length-bearing text, O(1) space; no byte-array allocation.
    Legacy raw-pointer text can rescan for NUL in byte_at (O(n^2)) and cannot
    preserve embedded NUL. Cross-runtime/performance admission is still needed.

    Example:
        runtime_text_hash_v1("")     # -3750763034362895579
        runtime_text_hash_v1("abc")  # -1792535898324117685
    """
    var hash: u64 = 14695981039346656037u64
    val length = value.len()
    var index = 0
    while index < length:
        hash = (hash xor (value.byte_at(index) as u64)) * 1099511628211u64
        index = index + 1
    hash as i64

export runtime_text_hash_v1
