pub val BROWSER_RENDERER_MAX_HEADER_BYTES: i64 = 256
pub val BROWSER_RENDERER_MAX_PAYLOAD_BYTES: i64 = 1048576
pub val BROWSER_RENDERER_MAX_SEQUENCE_ID: i64 = 9223372036854775806
pub val BROWSER_RENDERER_COMMAND_CAPABILITY_BYTES: i64 = 32
pub val BROWSER_RENDERER_MAX_COMMANDS: i64 = 1024
# 8K-class retained Web frames need 7680x4320 (= 33,177,600 pixels). Keep a
# separate side and area budget so an 8192x8192 square cannot turn the
# protocol's dimension limit into a 256 MiB allocation request.
pub val BROWSER_RENDERER_MAX_VIEWPORT: i64 = 8192
pub val BROWSER_RENDERER_MAX_VIEWPORT_PIXELS: i64 = 33554432
pub val BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI: i64 = 1048576000
pub val BROWSER_RENDERER_WORKER_ARG: text = "--__simple-web-renderer-worker"
val BROWSER_RENDERER_MAX_READ_CHUNK_BYTES: i64 = 8192
val BROWSER_RENDERER_MAX_COORDINATE: i64 = 1048576
val BROWSER_RENDERER_MAX_TEXT_BYTES: i64 = 4096
val BROWSER_RENDERER_MAX_URL_BYTES: i64 = 8192
val BROWSER_RENDERER_MAX_URL_ENCODED_BYTES: i64 = 10924
pub val BROWSER_RENDERER_MAX_NETWORK_HEADERS_BYTES: i64 = 65536
pub val BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES: i64 = 524288
pub val BROWSER_RENDERER_MAX_DIAGNOSTIC_BYTES: i64 = 4096
pub val BROWSER_RENDERER_MAX_BOOKMARKS: i64 = 256
pub val BROWSER_RENDERER_MAX_IMAGE_RESOURCE_BYTES: i64 = 524288
pub val BROWSER_RENDERER_MAX_IMAGE_RESOURCE_ENCODED_BYTES: i64 = 699051
pub val BROWSER_RENDERER_MAX_IMAGE_RESOURCES: i64 = 64
pub val BROWSER_RENDERER_MAX_IMAGE_PIXELS: i64 = 131072
pub val BROWSER_RENDERER_MAX_DOCUMENT_TITLE_BYTES: i64 = 512
pub val BROWSER_RENDERER_MAX_DOCUMENT_TITLE_ENCODED_BYTES: i64 = 684
# 2026-08-19: the style engine's full computed-style snapshot grew to 166
# props per command, so the previous cap of 160 rejected every frame with
# "invalid-command-metadata". Headroom over the measured 166.
val BROWSER_RENDERER_MAX_STYLE_PROPS: i64 = 192
val BROWSER_RENDERER_MAX_STYLE_KEY_BYTES: i64 = 128
val BROWSER_RENDERER_MAX_STYLE_VALUE_BYTES: i64 = 65536
val BROWSER_RENDERER_MAX_GLYPHS: i64 = 4096
val BROWSER_RENDERER_MAX_FONT_SIZE: i64 = 512
val BROWSER_RENDERER_MAX_FRAME_OVERDRAW: i64 = 16
val BROWSER_RENDERER_MAX_FRAME_TEXT_UNITS: i64 = 262144
val BROWSER_RENDERER_MAX_FRAME_STYLE_PROPS: i64 = 16384
val BROWSER_RENDERER_MAX_FRAME_GLYPHS: i64 = 65536

pub fn browser_renderer_viewport_valid(width: i64, height: i64) -> bool:
    width > 0 and height > 0 and
    width <= BROWSER_RENDERER_MAX_VIEWPORT and
    height <= BROWSER_RENDERER_MAX_VIEWPORT and
    width <= BROWSER_RENDERER_MAX_VIEWPORT_PIXELS / height

pub struct BrowserRendererMessage:
    kind: text
    generation: i64
    request_id: i64
    payload: text

pub struct BrowserRendererCommandCapability:
    value: text

pub struct BrowserRendererCapabilityMessage:
    kind: text
    generation: i64
    request_id: i64
    root_command_request_id: i64
    command_capability: text
    payload: text

pub struct BrowserTextInputOverlay:
    target_key: text
    anchor_byte: i64
    focus_byte: i64
    view_start_byte: i64
    caret_visible: bool

pub fn browser_text_input_overlay_empty() -> BrowserTextInputOverlay:
    BrowserTextInputOverlay(
        target_key: "",
        anchor_byte: 0,
        focus_byte: 0,
        view_start_byte: 0,
        caret_visible: false
    )

pub struct BrowserRendererEncodeResult:
    ok: bool
    reason: text
    wire: text
    kind: text = ""
    payload: text = ""

pub struct BrowserRendererDecoder:
    parts: [text]
    buffer_len: i64
    expected_total: i64
    payload_start: i64
    pending_kind: text
    pending_request_id: i64
    expected_generation: i64
    last_request_id: i64
    error: text

pub struct BrowserRendererCapabilityDecoder:
    parts: [text]
    buffer_len: i64
    expected_total: i64
    payload_start: i64
    pending_kind: text
    pending_request_id: i64
    pending_root_command_request_id: i64
    pending_capability_bytes: i64
    expected_generation: i64
    last_request_id: i64
    error: text

pub struct BrowserRendererDecodeResult:
    decoder: BrowserRendererDecoder
    status: text
    message: BrowserRendererMessage

pub struct BrowserRendererCapabilityDecodeResult:
    decoder: BrowserRendererCapabilityDecoder
    status: text
    message: BrowserRendererCapabilityMessage

pub struct BrowserRendererFrameDecodeResult:
    ok: bool
    reason: text
    reply_to_request_id: i64
    next_animation_ms: i64
    composition_revision: i64
    history_state_present: bool
    history_current_url: text
    history_back_url: text
    history_forward_url: text
    history_proposal_present: bool
    history_proposal: text
    document_title_present: bool
    document_title: text
    composition: DrawIrComposition
    image_resources: [SimpleOsHostGpuImageResource]
    cpu_composited_count: i32
    cpu_composited_sha256: text
    solid_material_count: i32
    solid_material_sha256: text
    diagnostics: text
    damage_receipt: BrowserRendererDamageReceipt

"""Bounded producer receipt for a retained DrawIR frame.

The next wire codec revision carries this; legacy frames use a full replay.
Rectangles are viewport-local, half-open tuples `[x, y, width, height]`.
Overlaps are permitted because old/new DrawIR bounds intentionally overlap on
an in-place paint update. The renderer/compositor clips and coalesces them
through its canonical damage planner after independently checking that the
receipt matches the received composition.
"""
pub struct BrowserRendererDamageReceipt:
    mode: i64
    rects: [i64]

pub fn browser_renderer_damage_receipt(
    mode: i64, rects: [i64]
) -> BrowserRendererDamageReceipt:
    BrowserRendererDamageReceipt(mode: mode, rects: rects)

pub fn browser_renderer_damage_receipt_encode(
    receipt: BrowserRendererDamageReceipt
) -> text:
    """Canonical bounded text payload for the next retained-frame schema."""
    var out = str(receipt.mode)
    for value in receipt.rects:
        out = out + "," + str(value)
    out

pub fn browser_renderer_damage_receipt_decode(
    encoded: text, width: i32, height: i32
) -> BrowserRendererDamageReceipt?:
    if encoded.len() == 0 or encoded.len() > BROWSER_RENDERER_MAX_HEADER_BYTES:
        return nil
    val fields = encoded.split(",")
    if fields.len() == 0 or fields.len() > 1025:
        return nil
    val mode = fields[0].to_i64() ?? -9223372036854775808
    if str(mode) != fields[0]:
        return nil
    var rects: [i64] = []
    var i = 1
    while i < fields.len():
        val value = fields[i].to_i64() ?? -9223372036854775808
        if str(value) != fields[i]:
            return nil
        rects.push(value)
        i = i + 1
    val receipt = browser_renderer_damage_receipt(mode, rects)
    if (not browser_renderer_damage_receipt_valid(receipt, width, height) or
        browser_renderer_damage_receipt_encode(receipt) != encoded):
        return nil
    Some(receipt)

pub fn browser_renderer_damage_receipt_valid(
    receipt: BrowserRendererDamageReceipt, width: i32, height: i32
) -> bool:
    if width <= 0 or height <= 0:
        return false
    if receipt.mode == DAMAGE_PLAN_NONE:
        return receipt.rects.len() == 0
    if receipt.mode == DAMAGE_PLAN_FULL:
        return receipt.rects == [0, 0, width.to_i64(), height.to_i64()]
    if receipt.mode != DAMAGE_PLAN_LOCAL or receipt.rects.len() == 0 or
            receipt.rects.len() % 4 != 0 or receipt.rects.len() > 1024:
        return false
    var i = 0
    while i < receipt.rects.len():
        val x = receipt.rects[i]
        val y = receipt.rects[i + 1]
        val w = receipt.rects[i + 2]
        val h = receipt.rects[i + 3]
        if x < 0 or y < 0 or w <= 0 or h <= 0 or x > width.to_i64() - w or
                y > height.to_i64() - h:
            return false
        i = i + 4
    true

pub struct BrowserRendererActionDecodeResult:
    ok: bool
    reason: text
    kind: text
    now_ms: i64
    event_id: i64
    x: i64
    y: i64
    key_code: i64
    pressed: bool
    shift_key: bool
    value: text

pub struct BrowserRendererNavigationDecodeResult:
    ok: bool
    reason: text
    action: text
    url: text
    method: text
    headers: text
    body: text
    content_type: text
    history_snapshot: text

pub struct BrowserRendererBookmarkSnapshotDecodeResult:
    ok: bool
    reason: text
    urls: [text]
    titles: [text]

pub struct BrowserRendererResizeDecodeResult:
    ok: bool
    reason: text
    width: i32
    height: i32

pub struct BrowserRendererNetworkDecodeResult:
    ok: bool
    reason: text
    reply_to_request_id: i64
    request_id: text
    kind: text
    url: text
    method: text
    headers: text
    body: text
    content_type: text
    credentials: text
    script_cookie_writes: [text]
    status: i32
    error: text
    initiator_origin: text = ""

fn _browser_renderer_empty_message() -> BrowserRendererMessage:
    BrowserRendererMessage(kind: "", generation: 0, request_id: 0, payload: "")

fn _browser_renderer_empty_capability_message(
) -> BrowserRendererCapabilityMessage:
    BrowserRendererCapabilityMessage(
        kind: "", generation: 0, request_id: 0,
        root_command_request_id: 0, command_capability: "", payload: ""
    )

pub fn browser_renderer_command_capability_valid(value: text) -> bool:
    if value.len() != BROWSER_RENDERER_COMMAND_CAPABILITY_BYTES:
        return false
    var nonzero = false
    var index: i64 = 0
    while index < value.len():
        val byte = value.byte_at(index)
        if not ((byte >= 48 and byte <= 57) or
                (byte >= 97 and byte <= 102)):
            return false
        if byte != 48:
            nonzero = true
        index = index + 1
    nonzero

fn _browser_renderer_hex_digit(value: i64) -> text:
    if value < 10:
        return str(value)
    bytes_to_text([(97 + value - 10).to_u8()])

pub fn browser_renderer_command_capability_from_bytes(
    value: [u8]
) -> Result<BrowserRendererCommandCapability, text>:
    if value.len() != 16:
        return Err("invalid-renderer-command-capability-bytes")
    var encoded = ""
    for byte in value:
        val scalar = byte.to_i64()
        encoded = encoded + _browser_renderer_hex_digit(scalar / 16)
        encoded = encoded + _browser_renderer_hex_digit(scalar % 16)
    if not browser_renderer_command_capability_valid(encoded):
        return Err("invalid-renderer-command-capability-bytes")
    Ok(BrowserRendererCommandCapability(value: encoded))

fn _browser_renderer_reject_encode(reason: text) -> BrowserRendererEncodeResult:
    BrowserRendererEncodeResult(ok: false, reason: reason, wire: "")

fn _browser_renderer_kind_valid(kind: text) -> bool:
    (kind == "init" or kind == "advance" or kind == "pointer" or
        kind == "scroll" or kind == "text" or kind == "key" or
        kind == "chrome" or kind == "navigation" or kind == "resize" or
        kind == "bookmark-snapshot" or
        kind == "network_response" or
        kind == "shutdown" or kind == "ready" or
        kind == "theme_init" or kind == "theme_ready" or
        kind == "fetch_request" or
        kind == "frame" or kind == "dispatch_result" or kind == "state" or
        kind == "error" or kind == "test_crash_after_ready" or
        kind == "test_hang_after_ready" or kind == "test_hang_ready")

fn _browser_renderer_positive_i64(raw: text) -> i64:
    val parsed = raw.to_i64() ?? -1
    if parsed <= 0 or str(parsed) != raw:
        return -1
    parsed

fn _browser_renderer_canonical_i64(raw: text) -> bool:
    val parsed = raw.to_i64() ?? 0
    raw != "" and str(parsed) == raw

fn _browser_renderer_flag(raw: text) -> i64:
    if raw == "0":
        return 0
    if raw == "1":
        return 1
    -1

fn _browser_renderer_network_kind_valid(kind: text) -> bool:
    (kind == "document" or kind == "style" or kind == "script" or
        kind == "module" or kind == "wasm" or kind == "image" or
        kind == "fetch")

fn _browser_renderer_network_method_valid(method: text) -> bool:
    (method == "GET" or method == "HEAD" or method == "POST" or
        method == "PUT" or method == "PATCH" or method == "DELETE" or
        method == "OPTIONS")

fn _browser_renderer_header_end(buffer: text) -> i64:
    var index: i64 = 0
    while index < buffer.len():
        if buffer.byte_at(index) == 10:
            return index
        index = index + 1
    -1

fn _browser_renderer_byte_slice(value: text, start: i64, end: i64) -> text:
    var bytes: [u8] = []
    var index = start
    while index < end:
        bytes.push(value.byte_at(index).to_u8())
        index = index + 1
    bytes_to_text(bytes)

fn _browser_renderer_violation(decoder: BrowserRendererDecoder, reason: text) -> BrowserRendererDecodeResult:
    BrowserRendererDecodeResult(
        decoder: BrowserRendererDecoder(
            parts: [],
            buffer_len: 0,
            expected_total: -1,
            payload_start: 0,
            pending_kind: "",
            pending_request_id: 0,
            expected_generation: decoder.expected_generation,
            last_request_id: decoder.last_request_id,
            error: reason
        ),
        status: "violation",
        message: _browser_renderer_empty_message()
    )

pub fn browser_renderer_decoder_new(expected_generation: i64) -> BrowserRendererDecoder:
    BrowserRendererDecoder(
        parts: [],
        buffer_len: 0,
        expected_total: -1,
        payload_start: 0,
        pending_kind: "",
        pending_request_id: 0,
        expected_generation: expected_generation,
        last_request_id: 0,
        error: if expected_generation > 0: "" else: "invalid-generation"
    )

pub fn browser_renderer_message_encode(kind: text, generation: i64, request_id: i64, payload: text) -> BrowserRendererEncodeResult:
    if not _browser_renderer_kind_valid(kind):
        return _browser_renderer_reject_encode("invalid-kind")
    if generation <= 0:
        return _browser_renderer_reject_encode("invalid-generation")
    if request_id <= 0:
        return _browser_renderer_reject_encode("invalid-request-id")
    if payload.contains("\0"):
        return _browser_renderer_reject_encode("nul-payload")
    val payload_bytes = text_to_bytes(payload)
    if payload_bytes.len().to_i64() > BROWSER_RENDERER_MAX_PAYLOAD_BYTES:
        return _browser_renderer_reject_encode("payload-too-large")
    val header = "SBR1\t{kind}\t{generation}\t{request_id}\t{payload_bytes.len()}\n"
    if text_to_bytes(header).len().to_i64() > BROWSER_RENDERER_MAX_HEADER_BYTES:
        return _browser_renderer_reject_encode("header-too-large")
    BrowserRendererEncodeResult(
        ok: true,
        reason: "ok",
        wire: header + payload,
        kind: kind,
        payload: payload
    )

pub fn browser_renderer_message_resequence(
    wire: text, generation: i64, request_id: i64
) -> BrowserRendererEncodeResult:
    val decoded = browser_renderer_decoder_feed(
        browser_renderer_decoder_new(generation), wire
    )
    if (decoded.status != "message" or
        decoded.decoder.buffer_len != 0):
        return _browser_renderer_reject_encode("invalid-message")
    browser_renderer_message_encode(
        decoded.message.kind, generation, request_id,
        decoded.message.payload
    )

pub fn browser_renderer_decoder_feed(decoder: BrowserRendererDecoder, chunk: text) -> BrowserRendererDecodeResult:
    if decoder.error != "":
        return _browser_renderer_violation(decoder, decoder.error)
    val max_buffer = BROWSER_RENDERER_MAX_HEADER_BYTES + BROWSER_RENDERER_MAX_PAYLOAD_BYTES + BROWSER_RENDERER_MAX_READ_CHUNK_BYTES
    if chunk.len() > max_buffer - decoder.buffer_len:
        return _browser_renderer_violation(decoder, "stream-too-large")
    var parts = decoder.parts
    if chunk != "":
        parts.push(chunk)
    val buffer_len = decoder.buffer_len + chunk.len()
    var expected_total = decoder.expected_total
    var payload_start = decoder.payload_start
    var pending_kind = decoder.pending_kind
    var pending_request_id = decoder.pending_request_id
    if expected_total < 0:
        # Header discovery is validated against the 256-byte limit; after it
        # is known, retain fragments and join once at frame completion.
        val header_buffer = parts.join("")
        val header_end = _browser_renderer_header_end(header_buffer)
        if header_end < 0:
            if buffer_len >= BROWSER_RENDERER_MAX_HEADER_BYTES:
                return _browser_renderer_violation(decoder, "header-too-large")
            return BrowserRendererDecodeResult(
                decoder: BrowserRendererDecoder(
                    parts: parts,
                    buffer_len: buffer_len,
                    expected_total: -1,
                    payload_start: 0,
                    pending_kind: "",
                    pending_request_id: 0,
                    expected_generation: decoder.expected_generation,
                    last_request_id: decoder.last_request_id,
                    error: ""
                ),
                status: "need_more",
                message: _browser_renderer_empty_message()
            )
        if header_end >= BROWSER_RENDERER_MAX_HEADER_BYTES:
            return _browser_renderer_violation(decoder, "header-too-large")
        val fields = _browser_renderer_byte_slice(
            header_buffer, 0, header_end
        ).split("\t")
        if fields.len() != 5 or fields[0] != "SBR1" or
           not _browser_renderer_kind_valid(fields[1]):
            return _browser_renderer_violation(decoder, "malformed-header")
        val generation = _browser_renderer_positive_i64(fields[2])
        val request_id = _browser_renderer_positive_i64(fields[3])
        val payload_length = fields[4].to_i64() ?? -1
        if generation < 0 or request_id < 0 or payload_length < 0 or
           str(payload_length) != fields[4]:
            return _browser_renderer_violation(decoder, "malformed-header")
        if payload_length > BROWSER_RENDERER_MAX_PAYLOAD_BYTES:
            return _browser_renderer_violation(decoder, "payload-too-large")
        if generation != decoder.expected_generation:
            return _browser_renderer_violation(decoder, "stale-generation")
        if request_id <= decoder.last_request_id:
            return _browser_renderer_violation(decoder, "duplicate-request")
        if (decoder.last_request_id > 0 and
            request_id != decoder.last_request_id + 1):
            return _browser_renderer_violation(
                decoder, "unexpected-request-id"
            )
        payload_start = header_end + 1
        expected_total = payload_start + payload_length
        pending_kind = fields[1]
        pending_request_id = request_id
    if buffer_len < expected_total:
        return BrowserRendererDecodeResult(
            decoder: BrowserRendererDecoder(
                parts: parts,
                buffer_len: buffer_len,
                expected_total: expected_total,
                payload_start: payload_start,
                pending_kind: pending_kind,
                pending_request_id: pending_request_id,
                expected_generation: decoder.expected_generation,
                last_request_id: decoder.last_request_id,
                error: ""
            ),
            status: "need_more",
            message: _browser_renderer_empty_message()
        )
    val buffer = parts.join("")
    val payload = _browser_renderer_byte_slice(
        buffer, payload_start, expected_total
    )
    if payload.contains("\0"):
        return _browser_renderer_violation(decoder, "nul-payload")
    val next_buffer = _browser_renderer_byte_slice(
        buffer, expected_total, buffer_len
    )
    var next_parts: [text] = []
    if next_buffer != "":
        next_parts.push(next_buffer)
    BrowserRendererDecodeResult(
        decoder: BrowserRendererDecoder(
            parts: next_parts,
            buffer_len: next_buffer.len(),
            expected_total: -1,
            payload_start: 0,
            pending_kind: "",
            pending_request_id: 0,
            expected_generation: decoder.expected_generation,
            last_request_id: pending_request_id,
            error: ""
        ),
        status: "message",
        message: BrowserRendererMessage(
            kind: pending_kind,
            generation: decoder.expected_generation,
            request_id: pending_request_id,
            payload: payload
        )
    )

fn _browser_renderer_capability_violation(
    decoder: BrowserRendererCapabilityDecoder, reason: text
) -> BrowserRendererCapabilityDecodeResult:
    BrowserRendererCapabilityDecodeResult(
        decoder: BrowserRendererCapabilityDecoder(
            parts: [],
            buffer_len: 0,
            expected_total: -1,
            payload_start: 0,
            pending_kind: "",
            pending_request_id: 0,
            pending_root_command_request_id: 0,
            pending_capability_bytes: 0,
            expected_generation: decoder.expected_generation,
            last_request_id: decoder.last_request_id,
            error: reason
        ),
        status: "violation",
        message: _browser_renderer_empty_capability_message()
    )

pub fn browser_renderer_capability_decoder_new(
    expected_generation: i64
) -> BrowserRendererCapabilityDecoder:
    BrowserRendererCapabilityDecoder(
        parts: [],
        buffer_len: 0,
        expected_total: -1,
        payload_start: 0,
        pending_kind: "",
        pending_request_id: 0,
        pending_root_command_request_id: 0,
        pending_capability_bytes: 0,
        expected_generation: expected_generation,
        last_request_id: 0,
        error: if (expected_generation > 0 and
                   expected_generation <= BROWSER_RENDERER_MAX_SEQUENCE_ID):
            ""
        else:
            "invalid-generation"
    )

pub fn browser_renderer_capability_message_encode(
    kind: text,
    generation: i64,
    request_id: i64,
    root_command_request_id: i64,
    payload: text,
    command_capability: text
) -> BrowserRendererEncodeResult:
    if not _browser_renderer_kind_valid(kind):
        return _browser_renderer_reject_encode("invalid-kind")
    if generation <= 0 or generation > BROWSER_RENDERER_MAX_SEQUENCE_ID:
        return _browser_renderer_reject_encode("invalid-generation")
    if request_id <= 0 or request_id > BROWSER_RENDERER_MAX_SEQUENCE_ID:
        return _browser_renderer_reject_encode("invalid-request-id")
    val ready = kind == "ready"
    if (ready and
        (request_id != 1 or root_command_request_id != 0 or
         command_capability != "" or payload != "")):
        return _browser_renderer_reject_encode("invalid-ready-command")
    if (not ready and
        (root_command_request_id <= 0 or
         root_command_request_id > BROWSER_RENDERER_MAX_SEQUENCE_ID or
         not browser_renderer_command_capability_valid(command_capability))):
        return _browser_renderer_reject_encode("invalid-command-capability")
    if not _browser_renderer_capability_payload_schema_valid(kind, payload):
        return _browser_renderer_reject_encode("legacy-nested-schema")
    if payload.contains("\0"):
        return _browser_renderer_reject_encode("nul-payload")
    val payload_bytes = text_to_bytes(payload)
    val capability_bytes = if ready:
        0
    else:
        BROWSER_RENDERER_COMMAND_CAPABILITY_BYTES
    if (payload_bytes.len().to_i64() >
        BROWSER_RENDERER_MAX_PAYLOAD_BYTES - capability_bytes):
        return _browser_renderer_reject_encode("payload-too-large")
    val header = (
        "SBR2\t{kind}\t{generation}\t{request_id}\t" +
        "{root_command_request_id}\t{payload_bytes.len()}\t" +
        "{capability_bytes}\n"
    )
    if (text_to_bytes(header).len().to_i64() >
        BROWSER_RENDERER_MAX_HEADER_BYTES):
        return _browser_renderer_reject_encode("header-too-large")
    BrowserRendererEncodeResult(
        ok: true, reason: "ok",
        wire: header + payload + command_capability,
        kind: kind,
        payload: payload
    )

pub fn browser_renderer_capability_message_resequence(
    wire: text,
    generation: i64,
    request_id: i64,
    root_command_request_id: i64,
    command_capability: text
) -> BrowserRendererEncodeResult:
    val decoded = browser_renderer_capability_decoder_feed(
        browser_renderer_capability_decoder_new(generation), wire
    )
    if (decoded.status != "message" or
        decoded.decoder.buffer_len != 0):
        return _browser_renderer_reject_encode("invalid-message")
    browser_renderer_capability_message_encode(
        decoded.message.kind, generation, request_id,
        root_command_request_id, decoded.message.payload,
        command_capability
    )

fn _browser_renderer_capability_wire_payload(
    kind: text, payload: text
) -> text:
    if kind == "fetch_request" and payload.starts_with("SBRQ4\t"):
        return "SBRQ5\t" + payload.slice(6, payload.len())
    if kind == "network_response" and payload.starts_with("SBRN1\t"):
        return "SBRN2\t" + payload.slice(6, payload.len())
    if kind == "frame" and payload.starts_with("SBRF8\t"):
        return "SBRF9\t" + payload.slice(6, payload.len())
    if kind == "frame" and payload.starts_with("SBRF10\t"):
        return "SBRF11\t" + payload.slice(7, payload.len())
    payload

fn _browser_renderer_capability_decode_payload(
    kind: text, payload: text
) -> text:
    if kind == "fetch_request":
        if not payload.starts_with("SBRQ5\t"):
            return ""
        return "SBRQ4\t" + payload.slice(6, payload.len())
    if kind == "network_response":
        if not payload.starts_with("SBRN2\t"):
            return ""
        return "SBRN1\t" + payload.slice(6, payload.len())
    if kind == "frame":
        if payload.starts_with("SBRF11\t"):
            return "SBRF10\t" + payload.slice(7, payload.len())
        if not payload.starts_with("SBRF9\t"):
            return ""
        return "SBRF8\t" + payload.slice(6, payload.len())
    payload

fn _browser_renderer_capability_payload_schema_valid(
    kind: text, payload: text
) -> bool:
    if kind == "fetch_request":
        return payload.starts_with("SBRQ5\t")
    if kind == "network_response":
        return payload.starts_with("SBRN2\t")
    if kind == "frame":
        return payload.starts_with("SBRF9\t") or payload.starts_with("SBRF11\t")
    true

pub fn browser_renderer_capability_payload_message(
    message: BrowserRendererCapabilityMessage
) -> BrowserRendererMessage:
    BrowserRendererMessage(
        kind: message.kind,
        generation: message.generation,
        request_id: message.request_id,
        payload: _browser_renderer_capability_decode_payload(
            message.kind, message.payload
        )
    )

pub fn browser_renderer_capability_bind_encoded(
    encoded: BrowserRendererEncodeResult,
    generation: i64,
    request_id: i64,
    root_command_request_id: i64,
    command_capability: text
) -> BrowserRendererEncodeResult:
    if not encoded.ok:
        return encoded
    if encoded.kind == "":
        return _browser_renderer_reject_encode("invalid-message")
    browser_renderer_capability_message_encode(
        encoded.kind,
        generation,
        request_id,
        root_command_request_id,
        _browser_renderer_capability_wire_payload(
            encoded.kind, encoded.payload
        ),
        command_capability
    )

pub fn browser_renderer_capability_decoder_feed(
    decoder: BrowserRendererCapabilityDecoder,
    chunk: text
) -> BrowserRendererCapabilityDecodeResult:
    if decoder.error != "":
        return _browser_renderer_capability_violation(
            decoder, decoder.error
        )
    val max_buffer = (
        BROWSER_RENDERER_MAX_HEADER_BYTES +
        BROWSER_RENDERER_MAX_PAYLOAD_BYTES +
        BROWSER_RENDERER_MAX_READ_CHUNK_BYTES
    )
    if chunk.len() > max_buffer - decoder.buffer_len:
        return _browser_renderer_capability_violation(
            decoder, "stream-too-large"
        )
    var parts = decoder.parts
    if chunk != "":
        parts.push(chunk)
    val buffer_len = decoder.buffer_len + chunk.len()
    var expected_total = decoder.expected_total
    var payload_start = decoder.payload_start
    var pending_kind = decoder.pending_kind
    var pending_request_id = decoder.pending_request_id
    var pending_root_command_request_id = (
        decoder.pending_root_command_request_id
    )
    var pending_capability_bytes = decoder.pending_capability_bytes
    if expected_total < 0:
        val header_buffer = parts.join("")
        val header_end = _browser_renderer_header_end(header_buffer)
        if header_end < 0:
            if buffer_len >= BROWSER_RENDERER_MAX_HEADER_BYTES:
                return _browser_renderer_capability_violation(
                    decoder, "header-too-large"
                )
            return BrowserRendererCapabilityDecodeResult(
                decoder: BrowserRendererCapabilityDecoder(
                    parts: parts,
                    buffer_len: buffer_len,
                    expected_total: -1,
                    payload_start: 0,
                    pending_kind: "",
                    pending_request_id: 0,
                    pending_root_command_request_id: 0,
                    pending_capability_bytes: 0,
                    expected_generation: decoder.expected_generation,
                    last_request_id: decoder.last_request_id,
                    error: ""
                ),
                status: "need_more",
                message: _browser_renderer_empty_capability_message()
            )
        if header_end >= BROWSER_RENDERER_MAX_HEADER_BYTES:
            return _browser_renderer_capability_violation(
                decoder, "header-too-large"
            )
        val fields = _browser_renderer_byte_slice(
            header_buffer, 0, header_end
        ).split("\t")
        if fields.len() != 7 or fields[0] != "SBR2" or
           not _browser_renderer_kind_valid(fields[1]):
            return _browser_renderer_capability_violation(
                decoder, "malformed-header"
            )
        val generation = _browser_renderer_positive_i64(fields[2])
        val request_id = _browser_renderer_positive_i64(fields[3])
        val root_command_request_id = fields[4].to_i64() ?? -1
        val payload_length = fields[5].to_i64() ?? -1
        val capability_length = fields[6].to_i64() ?? -1
        if (generation < 0 or
            generation > BROWSER_RENDERER_MAX_SEQUENCE_ID or
            request_id < 0 or
            request_id > BROWSER_RENDERER_MAX_SEQUENCE_ID or
            root_command_request_id < 0 or
            root_command_request_id > BROWSER_RENDERER_MAX_SEQUENCE_ID or
            str(root_command_request_id) != fields[4] or
            payload_length < 0 or str(payload_length) != fields[5] or
            capability_length < 0 or
            str(capability_length) != fields[6]):
            return _browser_renderer_capability_violation(
                decoder, "malformed-header"
            )
        val ready = fields[1] == "ready"
        if ((ready and
             (request_id != 1 or root_command_request_id != 0 or
              payload_length != 0 or capability_length != 0)) or
            (not ready and
             (root_command_request_id <= 0 or
              capability_length !=
                  BROWSER_RENDERER_COMMAND_CAPABILITY_BYTES))):
            return _browser_renderer_capability_violation(
                decoder, "malformed-command-capability"
            )
        if (payload_length >
            BROWSER_RENDERER_MAX_PAYLOAD_BYTES - capability_length):
            return _browser_renderer_capability_violation(
                decoder, "payload-too-large"
            )
        if generation != decoder.expected_generation:
            return _browser_renderer_capability_violation(
                decoder, "stale-generation"
            )
        if request_id <= decoder.last_request_id:
            return _browser_renderer_capability_violation(
                decoder, "duplicate-request"
            )
        if (decoder.last_request_id > 0 and
            request_id != decoder.last_request_id + 1):
            return _browser_renderer_capability_violation(
                decoder, "unexpected-request-id"
            )
        payload_start = header_end + 1
        expected_total = (
            payload_start + payload_length + capability_length
        )
        pending_kind = fields[1]
        pending_request_id = request_id
        pending_root_command_request_id = root_command_request_id
        pending_capability_bytes = capability_length
    if buffer_len < expected_total:
        return BrowserRendererCapabilityDecodeResult(
            decoder: BrowserRendererCapabilityDecoder(
                parts: parts,
                buffer_len: buffer_len,
                expected_total: expected_total,
                payload_start: payload_start,
                pending_kind: pending_kind,
                pending_request_id: pending_request_id,
                pending_root_command_request_id:
                    pending_root_command_request_id,
                pending_capability_bytes: pending_capability_bytes,
                expected_generation: decoder.expected_generation,
                last_request_id: decoder.last_request_id,
                error: ""
            ),
            status: "need_more",
            message: _browser_renderer_empty_capability_message()
        )
    val buffer = parts.join("")
    val capability = _browser_renderer_byte_slice(
        buffer, expected_total - pending_capability_bytes, expected_total
    )
    if (pending_capability_bytes > 0 and
        not browser_renderer_command_capability_valid(capability)):
        return _browser_renderer_capability_violation(
            decoder, "malformed-command-capability"
        )
    val payload = _browser_renderer_byte_slice(
        buffer,
        payload_start,
        expected_total - pending_capability_bytes
    )
    if payload.contains("\0"):
        return _browser_renderer_capability_violation(
            decoder, "nul-payload"
        )
    if not _browser_renderer_capability_payload_schema_valid(
        pending_kind, payload
    ):
        return _browser_renderer_capability_violation(
            decoder, "legacy-nested-schema"
        )
    val next_buffer = _browser_renderer_byte_slice(
        buffer, expected_total, buffer_len
    )
    var next_parts: [text] = []
    if next_buffer != "":
        next_parts.push(next_buffer)
    BrowserRendererCapabilityDecodeResult(
        decoder: BrowserRendererCapabilityDecoder(
            parts: next_parts,
            buffer_len: next_buffer.len(),
            expected_total: -1,
            payload_start: 0,
            pending_kind: "",
            pending_request_id: 0,
            pending_root_command_request_id: 0,
            pending_capability_bytes: 0,
            expected_generation: decoder.expected_generation,
            last_request_id: pending_request_id,
            error: ""
        ),
        status: "message",
        message: BrowserRendererCapabilityMessage(
            kind: pending_kind,
            generation: decoder.expected_generation,
            request_id: pending_request_id,
            root_command_request_id: pending_root_command_request_id,
            command_capability: capability,
            payload: payload
        )
    )

fn _browser_renderer_action_reject(reason: text) -> BrowserRendererActionDecodeResult:
    BrowserRendererActionDecodeResult(
        ok: false,
        reason: reason,
        kind: "",
        now_ms: 0,
        event_id: 0,
        x: 0,
        y: 0,
        key_code: 0,
        pressed: false,
        shift_key: false,
        value: ""
    )

fn _browser_renderer_action(
    kind: text,
    now_ms: i64,
    event_id: i64,
    x: i64,
    y: i64,
    key_code: i64,
    pressed: bool,
    shift_key: bool,
    value: text
) -> BrowserRendererActionDecodeResult:
    BrowserRendererActionDecodeResult(
        ok: true,
        reason: "ok",
        kind: kind,
        now_ms: now_ms,
        event_id: event_id,
        x: x,
        y: y,
        key_code: key_code,
        pressed: pressed,
        shift_key: shift_key,
        value: value
    )

fn _browser_renderer_length_payload(
    message: BrowserRendererMessage,
    tag: text,
    kind: text,
    max_bytes: i64
) -> BrowserRendererActionDecodeResult:
    val header_end = _browser_renderer_header_end(message.payload)
    if header_end < 0 or header_end >= BROWSER_RENDERER_MAX_HEADER_BYTES:
        return _browser_renderer_action_reject("malformed-action")
    val fields = _browser_renderer_byte_slice(message.payload, 0, header_end).split("\t")
    if fields.len() != 3 or fields[0] != tag:
        return _browser_renderer_action_reject("malformed-action")
    val event_id = _browser_renderer_positive_i64(fields[1])
    val byte_length = fields[2].to_i64() ?? -1
    if (event_id < 0 or byte_length < 0 or byte_length > max_bytes or
        str(byte_length) != fields[2] or message.payload.len() != header_end + 1 + byte_length):
        return _browser_renderer_action_reject("malformed-action")
    _browser_renderer_action(
        kind, 0, event_id, 0, 0, 0, false, false,
        _browser_renderer_byte_slice(message.payload, header_end + 1, message.payload.len())
    )

pub fn browser_renderer_advance_encode(
    generation: i64, request_id: i64, now_ms: i64
) -> BrowserRendererEncodeResult:
    if now_ms < 0:
        return _browser_renderer_reject_encode("invalid-action")
    browser_renderer_message_encode("advance", generation, request_id, "A1\t{now_ms}")

pub fn browser_renderer_pointer_encode(
    generation: i64,
    request_id: i64,
    event_id: i64,
    x: i64,
    y: i64,
    pressed: bool
) -> BrowserRendererEncodeResult:
    if (event_id <= 0 or x < -BROWSER_RENDERER_MAX_COORDINATE or
        x > BROWSER_RENDERER_MAX_COORDINATE or
        y < -BROWSER_RENDERER_MAX_COORDINATE or y > BROWSER_RENDERER_MAX_COORDINATE):
        return _browser_renderer_reject_encode("invalid-action")
    val flag = if pressed: 1 else: 0
    browser_renderer_message_encode(
        "pointer", generation, request_id,
        "P1\t{event_id}\t{x}\t{y}\t{flag}"
    )

pub fn browser_renderer_scroll_encode(
    generation: i64,
    request_id: i64,
    event_id: i64,
    delta_milli_y: i64
) -> BrowserRendererEncodeResult:
    if (event_id <= 0 or
        delta_milli_y < 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI or
        delta_milli_y > BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI):
        return _browser_renderer_reject_encode("invalid-action")
    browser_renderer_message_encode(
        "scroll", generation, request_id,
        "W1\t{event_id}\t{delta_milli_y}"
    )

pub fn browser_renderer_key_encode(
    generation: i64,
    request_id: i64,
    event_id: i64,
    key_code: i64,
    pressed: bool
) -> BrowserRendererEncodeResult:
    if event_id <= 0 or key_code < 0 or key_code > 1114111:
        return _browser_renderer_reject_encode("invalid-action")
    val flag = if pressed: 1 else: 0
    browser_renderer_message_encode(
        "key", generation, request_id,
        "K1\t{event_id}\t{key_code}\t{flag}"
    )

pub fn browser_renderer_key_with_shift_encode(
    generation: i64,
    request_id: i64,
    event_id: i64,
    key_code: i64,
    pressed: bool,
    shift_key: bool
) -> BrowserRendererEncodeResult:
    if event_id <= 0 or key_code < 0 or key_code > 1114111:
        return _browser_renderer_reject_encode("invalid-action")
    val pressed_flag = if pressed: 1 else: 0
    val shift_flag = if shift_key: 1 else: 0
    browser_renderer_message_encode(
        "key", generation, request_id,
        "K2\t{event_id}\t{key_code}\t{pressed_flag}\t{shift_flag}"
    )

pub fn browser_renderer_text_encode(
    generation: i64, request_id: i64, event_id: i64, value: text
) -> BrowserRendererEncodeResult:
    val byte_length = text_to_bytes(value).len()
    if event_id <= 0 or byte_length.to_i64() > BROWSER_RENDERER_MAX_TEXT_BYTES:
        return _browser_renderer_reject_encode("invalid-action")
    browser_renderer_message_encode(
        "text", generation, request_id, "T1\t{event_id}\t{byte_length}\n{value}"
    )

pub fn browser_renderer_chrome_encode(
    generation: i64, request_id: i64, event_id: i64, control: text,
    pressed: bool
) -> BrowserRendererEncodeResult:
    if (event_id <= 0 or
        (control != "back" and control != "forward" and control != "stop" and
        control != "home" and control != "favorite" and control != "address" and
        control != "go")):
        return _browser_renderer_reject_encode("invalid-action")
    val byte_length = text_to_bytes(control).len()
    val flag = if pressed: 1 else: 0
    browser_renderer_message_encode(
        "chrome", generation, request_id,
        "C1\t{event_id}\t{flag}\t{byte_length}\n{control}"
    )

fn _browser_renderer_navigation_action_valid(action: text) -> bool:
    action == "open" or action == "back" or action == "forward" or
        action == "home" or action == "reload" or action == "stop"

fn _browser_renderer_navigation_reject(
    reason: text
) -> BrowserRendererNavigationDecodeResult:
    BrowserRendererNavigationDecodeResult(
        ok: false,
        reason: reason,
        action: "",
        url: "",
        method: "",
        headers: "",
        body: "",
        content_type: "",
        history_snapshot: ""
    )

fn _browser_renderer_navigation_result(
    action: text,
    url: text,
    method: text,
    headers: text,
    body: text,
    content_type: text,
    history_snapshot: text = ""
) -> BrowserRendererNavigationDecodeResult:
    BrowserRendererNavigationDecodeResult(
        ok: true,
        reason: "ok",
        action: action,
        url: url,
        method: method,
        headers: headers,
        body: body,
        content_type: content_type,
        history_snapshot: history_snapshot
    )

fn _browser_renderer_navigation_fields_valid(
    action: text,
    url: text,
    method: text,
    headers: text,
    body: text,
    content_type: text
) -> bool:
    if (not _browser_renderer_navigation_action_valid(action) or
        not _browser_renderer_network_field_valid(url, BROWSER_RENDERER_MAX_URL_BYTES) or
        not _browser_renderer_network_field_valid(headers, BROWSER_RENDERER_MAX_NETWORK_HEADERS_BYTES) or
        not _browser_renderer_network_field_valid(body, BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES) or
        not _browser_renderer_network_field_valid(content_type, 256) or
        url.contains("\r") or url.contains("\n")):
        return false
    if action == "stop":
        return url == "" and method == "" and headers == "" and
            body == "" and content_type == ""
    if url == "":
        return false
    if action == "open":
        return (method == "GET" or method == "POST")
    method == "GET" and headers == "" and body == "" and content_type == ""

pub fn browser_renderer_navigation_encode(
    generation: i64,
    request_id: i64,
    action: text,
    url: text,
    method: text,
    headers: text,
    body: text,
    content_type: text
) -> BrowserRendererEncodeResult:
    if not _browser_renderer_navigation_fields_valid(
        action, url, method, headers, body, content_type
    ):
        return _browser_renderer_reject_encode("invalid-navigation")
    val action_len = text_to_bytes(action).len()
    val url_len = text_to_bytes(url).len()
    val method_len = text_to_bytes(method).len()
    val headers_len = text_to_bytes(headers).len()
    val body_len = text_to_bytes(body).len()
    val content_type_len = text_to_bytes(content_type).len()
    browser_renderer_message_encode(
        "navigation", generation, request_id,
        "SBN1\t{action_len}\t{url_len}\t{method_len}\t{headers_len}\t{body_len}\t{content_type_len}\n" +
        action + url + method + headers + body + content_type
    )

pub fn browser_renderer_navigation_encode_with_history(
    generation: i64,
    request_id: i64,
    action: text,
    url: text,
    method: text,
    headers: text,
    body: text,
    content_type: text,
    history_snapshot: text
) -> BrowserRendererEncodeResult:
    if (not _browser_renderer_navigation_fields_valid(
            action, url, method, headers, body, content_type
        ) or history_snapshot == "" or
        history_snapshot.len() > BROWSER_RENDERER_MAX_PAYLOAD_BYTES):
        return _browser_renderer_reject_encode("invalid-navigation")
    val action_len = text_to_bytes(action).len()
    val url_len = text_to_bytes(url).len()
    val method_len = text_to_bytes(method).len()
    val headers_len = text_to_bytes(headers).len()
    val body_len = text_to_bytes(body).len()
    val content_type_len = text_to_bytes(content_type).len()
    val history_len = text_to_bytes(history_snapshot).len()
    browser_renderer_message_encode(
        "navigation", generation, request_id,
        "SBN2\t{action_len}\t{url_len}\t{method_len}\t{headers_len}\t{body_len}\t{content_type_len}\t{history_len}\n" +
        action + url + method + headers + body + content_type +
        history_snapshot
    )

pub fn browser_renderer_navigation_decode(
    message: BrowserRendererMessage
) -> BrowserRendererNavigationDecodeResult:
    if message.kind != "navigation":
        return _browser_renderer_navigation_reject("wrong-kind")
    val header_end = _browser_renderer_header_end(message.payload)
    if header_end < 0 or header_end >= BROWSER_RENDERER_MAX_HEADER_BYTES:
        return _browser_renderer_navigation_reject("malformed-navigation")
    val fields = _browser_renderer_byte_slice(
        message.payload, 0, header_end
    ).split("\t")
    val history_frame = fields.len() == 8 and fields[0] == "SBN2"
    if not ((fields.len() == 7 and fields[0] == "SBN1") or history_frame):
        return _browser_renderer_navigation_reject("malformed-navigation")
    var lengths: [i64] = []
    var field_index: i64 = 1
    while field_index < fields.len():
        val length = fields[field_index].to_i64() ?? -1
        if length < 0 or str(length) != fields[field_index]:
            return _browser_renderer_navigation_reject(
                "malformed-navigation"
            )
        lengths.push(length)
        field_index = field_index + 1
    if (lengths[0] > 16 or lengths[1] > BROWSER_RENDERER_MAX_URL_BYTES or
        lengths[2] > 16 or
        lengths[3] > BROWSER_RENDERER_MAX_NETWORK_HEADERS_BYTES or
         lengths[4] > BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES or
         lengths[5] > 256 or
         (history_frame and
            (lengths[6] <= 0 or
                lengths[6] > BROWSER_RENDERER_MAX_PAYLOAD_BYTES))):
        return _browser_renderer_navigation_reject(
            "navigation-too-large"
        )
    var total_length = header_end + 1
    for length in lengths:
        total_length = total_length + length
    if total_length != message.payload.len():
        return _browser_renderer_navigation_reject("malformed-navigation")
    var offset = header_end + 1
    val action = _browser_renderer_network_piece(
        message.payload, offset, lengths[0]
    )
    offset = offset + lengths[0]
    val url = _browser_renderer_network_piece(
        message.payload, offset, lengths[1]
    )
    offset = offset + lengths[1]
    val method = _browser_renderer_network_piece(
        message.payload, offset, lengths[2]
    )
    offset = offset + lengths[2]
    val headers = _browser_renderer_network_piece(
        message.payload, offset, lengths[3]
    )
    offset = offset + lengths[3]
    val body = _browser_renderer_network_piece(
        message.payload, offset, lengths[4]
    )
    offset = offset + lengths[4]
    val content_type = _browser_renderer_network_piece(
        message.payload, offset, lengths[5]
    )
    offset = offset + lengths[5]
    val history_snapshot = if history_frame:
        _browser_renderer_network_piece(
            message.payload, offset, lengths[6]
        )
    else:
        ""
    if history_frame:
        offset = offset + lengths[6]
    if (offset != message.payload.len() or
        not _browser_renderer_navigation_fields_valid(
            action, url, method, headers, body, content_type
        )):
        return _browser_renderer_navigation_reject("invalid-navigation")
    _browser_renderer_navigation_result(
        action, url, method, headers, body, content_type,
        history_snapshot
    )

fn _browser_renderer_bookmark_snapshot_reject(
    reason: text
) -> BrowserRendererBookmarkSnapshotDecodeResult:
    BrowserRendererBookmarkSnapshotDecodeResult(
        ok: false, reason: reason, urls: [], titles: []
    )

pub fn browser_renderer_bookmark_snapshot_encode(
    generation: i64,
    request_id: i64,
    urls: [text],
    titles: [text]
) -> BrowserRendererEncodeResult:
    if (urls.len() != titles.len() or
        urls.len().to_i64() > BROWSER_RENDERER_MAX_BOOKMARKS):
        return _browser_renderer_reject_encode(
            "invalid-bookmark-snapshot"
        )
    var lines: [text] = ["SBB1\t{urls.len()}"]
    var index = 0
    while index < urls.len():
        val url = urls[index]
        val title = titles[index]
        if (url == "" or url.len() > 2048 or title.len() > 512 or
            url.contains("\0") or title.contains("\0")):
            return _browser_renderer_reject_encode(
                "invalid-bookmark-snapshot"
            )
        lines.push(
            "u:" + base64_encode(url) + "\tt:" + base64_encode(title)
        )
        index = index + 1
    browser_renderer_message_encode(
        "bookmark-snapshot", generation, request_id, lines.join("\n")
    )

pub fn browser_renderer_bookmark_snapshot_decode(
    message: BrowserRendererMessage
) -> BrowserRendererBookmarkSnapshotDecodeResult:
    if message.kind != "bookmark-snapshot":
        return _browser_renderer_bookmark_snapshot_reject("wrong-kind")
    val lines = message.payload.split("\n")
    if lines.len() == 0:
        return _browser_renderer_bookmark_snapshot_reject(
            "malformed-bookmark-snapshot"
        )
    val header = lines[0].split("\t")
    if header.len() != 2 or header[0] != "SBB1":
        return _browser_renderer_bookmark_snapshot_reject(
            "malformed-bookmark-snapshot"
        )
    val count = header[1].to_i64() ?? -1
    if (count < 0 or count > BROWSER_RENDERER_MAX_BOOKMARKS or
        str(count) != header[1] or lines.len().to_i64() != count + 1):
        return _browser_renderer_bookmark_snapshot_reject(
            "malformed-bookmark-snapshot"
        )
    var urls: [text] = []
    var titles: [text] = []
    var index: i64 = 0
    while index < count:
        val fields = lines[index + 1].split("\t")
        if (fields.len() != 2 or not fields[0].starts_with("u:") or
            not fields[1].starts_with("t:")):
            return _browser_renderer_bookmark_snapshot_reject(
                "malformed-bookmark-snapshot"
            )
        val encoded_url = fields[0].slice(2, fields[0].len())
        val encoded_title = fields[1].slice(2, fields[1].len())
        val url = base64_decode(encoded_url)
        val title = base64_decode(encoded_title)
        if (base64_encode(url) != encoded_url or
            base64_encode(title) != encoded_title or
            url == "" or url.len() > 2048 or title.len() > 512 or
            url.contains("\0") or title.contains("\0")):
            return _browser_renderer_bookmark_snapshot_reject(
                "invalid-bookmark-snapshot"
            )
        urls.push(url)
        titles.push(title)
        index = index + 1
    BrowserRendererBookmarkSnapshotDecodeResult(
        ok: true, reason: "ok", urls: urls, titles: titles
    )

pub fn browser_renderer_resize_encode(
    generation: i64, request_id: i64, width: i32, height: i32
) -> BrowserRendererEncodeResult:
    if not browser_renderer_viewport_valid(width.to_i64(), height.to_i64()):
        return _browser_renderer_reject_encode("invalid-resize")
    browser_renderer_message_encode(
        "resize", generation, request_id, "SBRZ1\t{width}\t{height}"
    )

pub fn browser_renderer_resize_decode(
    message: BrowserRendererMessage
) -> BrowserRendererResizeDecodeResult:
    if message.kind != "resize":
        return BrowserRendererResizeDecodeResult(
            ok: false, reason: "wrong-kind", width: 0, height: 0
        )
    val fields = message.payload.split("\t")
    if fields.len() != 3 or fields[0] != "SBRZ1":
        return BrowserRendererResizeDecodeResult(
            ok: false, reason: "malformed-resize", width: 0, height: 0
        )
    val width = fields[1].to_i64() ?? -1
    val height = fields[2].to_i64() ?? -1
    if (not browser_renderer_viewport_valid(width, height) or
        str(width) != fields[1] or str(height) != fields[2]):
        return BrowserRendererResizeDecodeResult(
            ok: false, reason: "invalid-resize", width: 0, height: 0
        )
    BrowserRendererResizeDecodeResult(
        ok: true,
        reason: "ok",
        width: width.to_i32(),
        height: height.to_i32()
    )

pub fn browser_renderer_action_decode(
    message: BrowserRendererMessage
) -> BrowserRendererActionDecodeResult:
    if message.kind == "text":
        return _browser_renderer_length_payload(
            message, "T1", "text", BROWSER_RENDERER_MAX_TEXT_BYTES
        )
    if message.kind == "chrome":
        val header_end = _browser_renderer_header_end(message.payload)
        if header_end < 0 or header_end >= BROWSER_RENDERER_MAX_HEADER_BYTES:
            return _browser_renderer_action_reject("malformed-action")
        val fields = _browser_renderer_byte_slice(
            message.payload, 0, header_end
        ).split("\t")
        if (fields.len() != 4 or fields[0] != "C1" or
            _browser_renderer_positive_i64(fields[1]) < 0 or
            _browser_renderer_flag(fields[2]) < 0):
            return _browser_renderer_action_reject("malformed-action")
        val byte_length = fields[3].to_i64() ?? -1
        if (byte_length < 0 or byte_length > 16 or
            str(byte_length) != fields[3] or
            message.payload.len() != header_end + 1 + byte_length):
            return _browser_renderer_action_reject("malformed-action")
        val control = _browser_renderer_byte_slice(
            message.payload, header_end + 1, message.payload.len()
        )
        if (control != "back" and control != "forward" and
            control != "stop" and control != "home" and
            control != "favorite" and control != "address" and
            control != "go"):
            return _browser_renderer_action_reject("invalid-control")
        return _browser_renderer_action(
            "chrome", 0, fields[1].to_i64() ?? 0, 0, 0, 0,
            _browser_renderer_flag(fields[2]) == 1, false, control
        )
    val fields = message.payload.split("\t")
    if message.kind == "advance":
        if fields.len() != 2 or fields[0] != "A1" or not _browser_renderer_canonical_i64(fields[1]):
            return _browser_renderer_action_reject("malformed-action")
        val now_ms = fields[1].to_i64() ?? -1
        if now_ms < 0:
            return _browser_renderer_action_reject("invalid-time")
        return _browser_renderer_action(
            "advance", now_ms, 0, 0, 0, 0, false, false, ""
        )
    if message.kind == "pointer":
        if (fields.len() != 5 or fields[0] != "P1" or
            _browser_renderer_positive_i64(fields[1]) < 0 or
            not _browser_renderer_canonical_i64(fields[2]) or
            not _browser_renderer_canonical_i64(fields[3]) or
            _browser_renderer_flag(fields[4]) < 0):
            return _browser_renderer_action_reject("malformed-action")
        val x = fields[2].to_i64() ?? 0
        val y = fields[3].to_i64() ?? 0
        if (x < -BROWSER_RENDERER_MAX_COORDINATE or x > BROWSER_RENDERER_MAX_COORDINATE or
            y < -BROWSER_RENDERER_MAX_COORDINATE or y > BROWSER_RENDERER_MAX_COORDINATE):
            return _browser_renderer_action_reject("invalid-coordinate")
        return _browser_renderer_action(
            "pointer", 0, fields[1].to_i64() ?? 0, x, y, 0,
            _browser_renderer_flag(fields[4]) == 1, false, ""
        )
    if message.kind == "scroll":
        if (fields.len() != 3 or fields[0] != "W1" or
            _browser_renderer_positive_i64(fields[1]) < 0 or
            not _browser_renderer_canonical_i64(fields[2])):
            return _browser_renderer_action_reject("malformed-action")
        val delta_milli_y = fields[2].to_i64() ?? 0
        if (delta_milli_y < 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI or
            delta_milli_y > BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI):
            return _browser_renderer_action_reject("invalid-scroll-delta")
        return _browser_renderer_action(
            "scroll", 0, fields[1].to_i64() ?? 0,
            0, delta_milli_y, 0, false, false, ""
        )
    if message.kind == "key":
        val is_v1 = fields.len() == 4 and fields[0] == "K1"
        val is_v2 = fields.len() == 5 and fields[0] == "K2"
        if ((not is_v1 and not is_v2) or
            _browser_renderer_positive_i64(fields[1]) < 0 or
            not _browser_renderer_canonical_i64(fields[2]) or
            _browser_renderer_flag(fields[3]) < 0 or
            (is_v2 and _browser_renderer_flag(fields[4]) < 0)):
            return _browser_renderer_action_reject("malformed-action")
        val key_code = fields[2].to_i64() ?? -1
        if key_code < 0 or key_code > 1114111:
            return _browser_renderer_action_reject("invalid-key-code")
        return _browser_renderer_action(
            "key", 0, fields[1].to_i64() ?? 0, 0, 0, key_code,
            _browser_renderer_flag(fields[3]) == 1,
            is_v2 and _browser_renderer_flag(fields[4]) == 1, ""
        )
    _browser_renderer_action_reject("wrong-kind")

fn _browser_renderer_network_reject(
    reason: text
) -> BrowserRendererNetworkDecodeResult:
    BrowserRendererNetworkDecodeResult(
        ok: false,
        reason: reason,
        reply_to_request_id: 0,
        request_id: "",
        kind: "",
        url: "",
        method: "",
        headers: "",
        body: "",
        content_type: "",
        credentials: "",
        initiator_origin: "",
        script_cookie_writes: [],
        status: 0,
        error: ""
    )

fn _browser_renderer_network_result(
    reply_to_request_id: i64,
    request_id: text,
    kind: text,
    url: text,
    method: text,
    headers: text,
    body: text,
    content_type: text,
    credentials: text,
    initiator_origin: text,
    script_cookie_writes: [text],
    status: i32,
    error: text
) -> BrowserRendererNetworkDecodeResult:
    BrowserRendererNetworkDecodeResult(
        ok: true,
        reason: "ok",
        reply_to_request_id: reply_to_request_id,
        request_id: request_id,
        kind: kind,
        url: url,
        method: method,
        headers: headers,
        body: body,
        content_type: content_type,
        credentials: credentials,
        initiator_origin: initiator_origin,
        script_cookie_writes: script_cookie_writes,
        status: status,
        error: error
    )

fn _browser_renderer_network_field_valid(
    value: text, max_bytes: i64
) -> bool:
    not value.contains("\0") and text_to_bytes(value).len().to_i64() <= max_bytes

fn _browser_renderer_network_common_valid(
    request_id: text, kind: text, url: text
) -> bool:
    (request_id != "" and
        _browser_renderer_network_field_valid(request_id, 128) and
        _browser_renderer_network_kind_valid(kind) and
        _browser_renderer_network_field_valid(url, BROWSER_RENDERER_MAX_URL_BYTES) and
        not url.contains("\n") and not url.contains("\r"))

fn _browser_renderer_credentials_valid(credentials: text) -> bool:
    credentials == "omit" or credentials == "same-origin" or
        credentials == "include"

fn _browser_renderer_script_cookie_write_valid(value: text) -> bool:
    (_browser_renderer_network_field_valid(value, 8192) and
        not value.contains("\r") and not value.contains("\n"))

struct BrowserRendererScriptCookieWritesDecodeResult:
    ok: bool
    writes: [text]

fn _browser_renderer_script_cookie_writes_encode(
    writes: [text]
) -> BrowserRendererEncodeResult:
    if writes.len() > 32:
        return _browser_renderer_reject_encode("invalid-script-cookie-writes")
    var header_fields: [text] = [str(writes.len())]
    var payload_bytes: i64 = 0
    for write in writes:
        if not _browser_renderer_script_cookie_write_valid(write):
            return _browser_renderer_reject_encode("invalid-script-cookie-writes")
        val byte_len = text_to_bytes(write).len().to_i64()
        if byte_len > 131072 - payload_bytes:
            return _browser_renderer_reject_encode("invalid-script-cookie-writes")
        payload_bytes = payload_bytes + byte_len
        header_fields.push(str(byte_len))
    BrowserRendererEncodeResult(
        ok: true,
        reason: "ok",
        wire: header_fields.join("\t") + "\n" + writes.join("")
    )

fn _browser_renderer_script_cookie_writes_decode(
    payload: text
) -> BrowserRendererScriptCookieWritesDecodeResult:
    val header_end = _browser_renderer_header_end(payload)
    if header_end < 0 or header_end >= BROWSER_RENDERER_MAX_HEADER_BYTES:
        return BrowserRendererScriptCookieWritesDecodeResult(
            ok: false, writes: []
        )
    val fields = _browser_renderer_byte_slice(
        payload, 0, header_end
    ).split("\t")
    if fields.len() == 0:
        return BrowserRendererScriptCookieWritesDecodeResult(
            ok: false, writes: []
        )
    val count = fields[0].to_i64() ?? -1
    if (count < 0 or count > 32 or str(count) != fields[0] or
        fields.len().to_i64() != count + 1):
        return BrowserRendererScriptCookieWritesDecodeResult(
            ok: false, writes: []
        )
    var lengths: [i64] = []
    var payload_bytes: i64 = 0
    var field_index: i64 = 1
    while field_index < fields.len():
        val byte_len = fields[field_index].to_i64() ?? -1
        if (byte_len < 0 or byte_len > 8192 or
            str(byte_len) != fields[field_index] or
            byte_len > 131072 - payload_bytes):
            return BrowserRendererScriptCookieWritesDecodeResult(
                ok: false, writes: []
            )
        lengths.push(byte_len)
        payload_bytes = payload_bytes + byte_len
        field_index = field_index + 1
    if payload.len() != header_end + 1 + payload_bytes:
        return BrowserRendererScriptCookieWritesDecodeResult(
            ok: false, writes: []
        )
    var writes: [text] = []
    var offset = header_end + 1
    for byte_len in lengths:
        val write = _browser_renderer_network_piece(
            payload, offset, byte_len
        )
        if not _browser_renderer_script_cookie_write_valid(write):
            return BrowserRendererScriptCookieWritesDecodeResult(
                ok: false, writes: []
            )
        writes.push(write)
        offset = offset + byte_len
    BrowserRendererScriptCookieWritesDecodeResult(ok: true, writes: writes)

fn _browser_renderer_network_piece(
    payload: text, offset: i64, byte_length: i64
) -> text:
    _browser_renderer_byte_slice(payload, offset, offset + byte_length)

pub fn browser_renderer_fetch_request_encode(
    generation: i64,
    wire_request_id: i64,
    reply_to_request_id: i64,
    request_id: text,
    kind: text,
    url: text,
    method: text,
    headers: text,
    body: text,
    content_type: text,
    credentials: text,
    script_cookie_writes: [text],
    initiator_origin: text = ""
) -> BrowserRendererEncodeResult:
    val encoded_cookie_writes = _browser_renderer_script_cookie_writes_encode(
        script_cookie_writes
    )
    if (reply_to_request_id <= 0 or
        not _browser_renderer_network_common_valid(request_id, kind, url) or
        not _browser_renderer_network_method_valid(method) or
        not _browser_renderer_network_field_valid(headers, BROWSER_RENDERER_MAX_NETWORK_HEADERS_BYTES) or
        not _browser_renderer_network_field_valid(body, BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES) or
        not _browser_renderer_network_field_valid(content_type, 256) or
        not _browser_renderer_credentials_valid(credentials) or
        not _browser_renderer_network_field_valid(
            initiator_origin, BROWSER_RENDERER_MAX_URL_BYTES
        ) or
        not encoded_cookie_writes.ok):
        return _browser_renderer_reject_encode("invalid-network-request")
    val id_len = text_to_bytes(request_id).len()
    val kind_len = text_to_bytes(kind).len()
    val url_len = text_to_bytes(url).len()
    val method_len = text_to_bytes(method).len()
    val headers_len = text_to_bytes(headers).len()
    val body_len = text_to_bytes(body).len()
    val content_type_len = text_to_bytes(content_type).len()
    val credentials_len = text_to_bytes(credentials).len()
    val initiator_origin_len = text_to_bytes(initiator_origin).len()
    val script_cookie_writes_len = text_to_bytes(encoded_cookie_writes.wire).len()
    browser_renderer_message_encode(
        "fetch_request", generation, wire_request_id,
        "SBRQ4\t{reply_to_request_id}\t{id_len}\t{kind_len}\t{url_len}\t{method_len}\t{headers_len}\t{body_len}\t{content_type_len}\t{credentials_len}\t{initiator_origin_len}\t{script_cookie_writes_len}\n" +
        request_id + kind + url + method + headers + body + content_type +
        credentials + initiator_origin + encoded_cookie_writes.wire
    )

pub fn browser_renderer_fetch_request_decode(
    message: BrowserRendererMessage
) -> BrowserRendererNetworkDecodeResult:
    if message.kind != "fetch_request":
        return _browser_renderer_network_reject("wrong-kind")
    val header_end = _browser_renderer_header_end(message.payload)
    if header_end < 0 or header_end >= BROWSER_RENDERER_MAX_HEADER_BYTES:
        return _browser_renderer_network_reject("malformed-network-request")
    val fields = _browser_renderer_byte_slice(
        message.payload, 0, header_end
    ).split("\t")
    if fields.len() != 12 or fields[0] != "SBRQ4":
        return _browser_renderer_network_reject("malformed-network-request")
    val reply_to_request_id = _browser_renderer_positive_i64(fields[1])
    if reply_to_request_id < 0:
        return _browser_renderer_network_reject("malformed-network-request")
    var lengths: [i64] = []
    var field_index: i64 = 2
    while field_index < fields.len():
        val length = fields[field_index].to_i64() ?? -1
        if length < 0 or str(length) != fields[field_index]:
            return _browser_renderer_network_reject("malformed-network-request")
        lengths.push(length)
        field_index = field_index + 1
    if (lengths[0] <= 0 or lengths[0] > 128 or lengths[1] > 16 or
        lengths[2] > BROWSER_RENDERER_MAX_URL_BYTES or lengths[3] > 16 or
        lengths[4] > BROWSER_RENDERER_MAX_NETWORK_HEADERS_BYTES or
        lengths[5] > BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES or
        lengths[6] > 256 or lengths[7] > 11 or
        lengths[8] > BROWSER_RENDERER_MAX_URL_BYTES or
        lengths[9] > 131235):
        return _browser_renderer_network_reject("network-request-too-large")
    var total_length = header_end + 1
    for length in lengths:
        total_length = total_length + length
    if total_length != message.payload.len():
        return _browser_renderer_network_reject("malformed-network-request")
    var offset = header_end + 1
    val request_id = _browser_renderer_network_piece(message.payload, offset, lengths[0])
    offset = offset + lengths[0]
    val kind = _browser_renderer_network_piece(message.payload, offset, lengths[1])
    offset = offset + lengths[1]
    val url = _browser_renderer_network_piece(message.payload, offset, lengths[2])
    offset = offset + lengths[2]
    val method = _browser_renderer_network_piece(message.payload, offset, lengths[3])
    offset = offset + lengths[3]
    val headers = _browser_renderer_network_piece(message.payload, offset, lengths[4])
    offset = offset + lengths[4]
    val body = _browser_renderer_network_piece(message.payload, offset, lengths[5])
    offset = offset + lengths[5]
    val content_type = _browser_renderer_network_piece(message.payload, offset, lengths[6])
    offset = offset + lengths[6]
    val credentials = _browser_renderer_network_piece(message.payload, offset, lengths[7])
    offset = offset + lengths[7]
    val initiator_origin = _browser_renderer_network_piece(
        message.payload, offset, lengths[8]
    )
    offset = offset + lengths[8]
    val encoded_cookie_writes = _browser_renderer_network_piece(
        message.payload, offset, lengths[9]
    )
    offset = offset + lengths[9]
    val decoded_cookie_writes = _browser_renderer_script_cookie_writes_decode(
        encoded_cookie_writes
    )
    if (offset != message.payload.len() or
        not _browser_renderer_network_common_valid(request_id, kind, url) or
        not _browser_renderer_network_method_valid(method) or
        not _browser_renderer_network_field_valid(headers, BROWSER_RENDERER_MAX_NETWORK_HEADERS_BYTES) or
        not _browser_renderer_network_field_valid(body, BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES) or
        not _browser_renderer_network_field_valid(content_type, 256) or
        not _browser_renderer_credentials_valid(credentials) or
        not _browser_renderer_network_field_valid(
            initiator_origin, BROWSER_RENDERER_MAX_URL_BYTES
        ) or
        not decoded_cookie_writes.ok):
        return _browser_renderer_network_reject("invalid-network-request")
    _browser_renderer_network_result(
        reply_to_request_id,
        request_id, kind, url, method, headers, body, content_type,
        credentials, initiator_origin, decoded_cookie_writes.writes, 0, ""
    )

pub fn browser_renderer_fetch_request_reply_to_request_id(
    message: BrowserRendererMessage
) -> i64:
    if message.kind != "fetch_request":
        return -1
    val header_end = _browser_renderer_header_end(message.payload)
    if header_end < 0 or header_end >= BROWSER_RENDERER_MAX_HEADER_BYTES:
        return -1
    val fields = _browser_renderer_byte_slice(
        message.payload, 0, header_end
    ).split("\t")
    if fields.len() != 12 or fields[0] != "SBRQ4":
        return -1
    _browser_renderer_positive_i64(fields[1])

pub fn browser_renderer_network_response_encode(
    generation: i64,
    wire_request_id: i64,
    request_id: text,
    kind: text,
    url: text,
    status: i32,
    headers: text,
    body: text,
    error: text
) -> BrowserRendererEncodeResult:
    if (not _browser_renderer_network_common_valid(request_id, kind, url) or
        status < 0 or status > 999 or
        (status == 0 and (error == "" or headers != "" or body != "")) or
        (status > 0 and (status < 100 or error != "")) or
        not _browser_renderer_network_field_valid(headers, BROWSER_RENDERER_MAX_NETWORK_HEADERS_BYTES) or
        not _browser_renderer_network_field_valid(body, BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES) or
        not _browser_renderer_network_field_valid(error, BROWSER_RENDERER_MAX_TEXT_BYTES)):
        return _browser_renderer_reject_encode("invalid-network-response")
    val id_len = text_to_bytes(request_id).len()
    val kind_len = text_to_bytes(kind).len()
    val url_len = text_to_bytes(url).len()
    val headers_len = text_to_bytes(headers).len()
    val body_len = text_to_bytes(body).len()
    val error_len = text_to_bytes(error).len()
    browser_renderer_message_encode(
        "network_response", generation, wire_request_id,
        "SBRN1\t{id_len}\t{kind_len}\t{url_len}\t{status}\t{headers_len}\t{body_len}\t{error_len}\n" +
        request_id + kind + url + headers + body + error
    )

pub fn browser_renderer_network_response_decode(
    message: BrowserRendererMessage
) -> BrowserRendererNetworkDecodeResult:
    if message.kind != "network_response":
        return _browser_renderer_network_reject("wrong-kind")
    val header_end = _browser_renderer_header_end(message.payload)
    if header_end < 0 or header_end >= BROWSER_RENDERER_MAX_HEADER_BYTES:
        return _browser_renderer_network_reject("malformed-network-response")
    val fields = _browser_renderer_byte_slice(
        message.payload, 0, header_end
    ).split("\t")
    if fields.len() != 8 or fields[0] != "SBRN1":
        return _browser_renderer_network_reject("malformed-network-response")
    val status = fields[4].to_i64() ?? -1
    if status < 0 or status > 999 or str(status) != fields[4]:
        return _browser_renderer_network_reject("malformed-network-response")
    var lengths: [i64] = []
    for field_index in [1, 2, 3, 5, 6, 7]:
        val length = fields[field_index].to_i64() ?? -1
        if length < 0 or str(length) != fields[field_index]:
            return _browser_renderer_network_reject("malformed-network-response")
        lengths.push(length)
    if (lengths[0] <= 0 or lengths[0] > 128 or lengths[1] > 16 or
        lengths[2] > BROWSER_RENDERER_MAX_URL_BYTES or
        lengths[3] > BROWSER_RENDERER_MAX_NETWORK_HEADERS_BYTES or
        lengths[4] > BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES or
        lengths[5] > BROWSER_RENDERER_MAX_TEXT_BYTES):
        return _browser_renderer_network_reject("network-response-too-large")
    var total_length = header_end + 1
    for length in lengths:
        total_length = total_length + length
    if total_length != message.payload.len():
        return _browser_renderer_network_reject("malformed-network-response")
    var offset = header_end + 1
    val request_id = _browser_renderer_network_piece(message.payload, offset, lengths[0])
    offset = offset + lengths[0]
    val kind = _browser_renderer_network_piece(message.payload, offset, lengths[1])
    offset = offset + lengths[1]
    val url = _browser_renderer_network_piece(message.payload, offset, lengths[2])
    offset = offset + lengths[2]
    val headers = _browser_renderer_network_piece(message.payload, offset, lengths[3])
    offset = offset + lengths[3]
    val body = _browser_renderer_network_piece(message.payload, offset, lengths[4])
    offset = offset + lengths[4]
    val error = _browser_renderer_network_piece(message.payload, offset, lengths[5])
    offset = offset + lengths[5]
    if (offset != message.payload.len() or
        not _browser_renderer_network_common_valid(request_id, kind, url) or
        not _browser_renderer_network_field_valid(headers, BROWSER_RENDERER_MAX_NETWORK_HEADERS_BYTES) or
        not _browser_renderer_network_field_valid(body, BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES) or
        not _browser_renderer_network_field_valid(error, BROWSER_RENDERER_MAX_TEXT_BYTES) or
        (status == 0 and (error == "" or headers != "" or body != "")) or
        (status > 0 and (status < 100 or error != ""))):
        return _browser_renderer_network_reject("invalid-network-response")
    _browser_renderer_network_result(
        0, request_id, kind, url, "", headers, body, "", "", "", [],
        status.to_i32(), error
    )

fn _browser_renderer_normalize_draw_ir(composition: DrawIrComposition) -> DrawIrComposition:
    var batches: [DrawIrBatch] = []
    for batch in composition.batches:
        batches.push(draw_ir_batch_with_source(
            batch.batch_id,
            DRAW_IR_BACKEND_AUTO,
            batch.embedding,
            batch.commands,
            batch.source
        ))
    draw_ir_composition(
        composition.composition_id,
        composition.scene_key,
        DRAW_IR_BACKEND_AUTO,
        batches
    )

fn _browser_renderer_frame_reject(reason: text) -> BrowserRendererFrameDecodeResult:
    BrowserRendererFrameDecodeResult(
        ok: false,
        reason: reason,
        reply_to_request_id: 0,
        next_animation_ms: -1,
        composition_revision: -1,
        history_state_present: false,
        history_current_url: "",
        history_back_url: "",
        history_forward_url: "",
        history_proposal_present: false,
        history_proposal: "",
        document_title_present: false,
        document_title: "",
        composition: draw_ir_composition("", "", "", []),
        image_resources: [],
        cpu_composited_count: 0,
        cpu_composited_sha256: "",
        solid_material_count: 0,
        solid_material_sha256: "",
        diagnostics: "",
        damage_receipt: browser_renderer_damage_receipt(DAMAGE_PLAN_NONE, [])
    )

fn _browser_renderer_advance_list_valid(value: text) -> bool:
    var items: i64 = 1
    var index: i64 = 0
    while index < value.len():
        if value.byte_at(index) == 44:
            items = items + 1
            if items > BROWSER_RENDERER_MAX_GLYPHS:
                return false
        index = index + 1
    true

fn _browser_renderer_frame_validation_reason(composition: DrawIrComposition, width: i32, height: i32) -> text:
    if width <= 0 or height <= 0:
        return "invalid-viewport"
    if (composition.composition_id != "html-layout" or
        composition.scene_key != "simple-web-html-layout" or
        composition.backend_target != DRAW_IR_BACKEND_AUTO or
        composition.batches.len() != 1):
        return "invalid-composition"
    val batch = composition.batches[0]
    val embedding = batch.embedding
    # The layout renderer suffixes the batch index onto the id ("html-layout-0")
    # since the per-batch split; accept both spellings of the single batch.
    if ((batch.batch_id != "html-layout" and batch.batch_id != "html-layout-0") or
        batch.backend_target != DRAW_IR_BACKEND_AUTO or
        embedding.surface_id != "html" or embedding.component_id != "document" or
        embedding.x != 0 or embedding.y != 0 or
        embedding.width != width or embedding.height != height or
        embedding.layer != 0 or embedding.opacity_milli != 1000 or not embedding.clip):
        return "invalid-embedding"
    if batch.commands.len() == 0:
        return "invalid-canvas"
    val canvas = batch.commands[0]
    if (canvas.kind != "rect" or canvas.component_id != "html-canvas" or
        canvas.x != 0 or canvas.y != 0 or canvas.width != width or
        canvas.height != height or ((canvas.color >> 24) & 255u32) != 255u32):
        return "invalid-canvas"
    val viewport_pixels = width.to_i64() * height.to_i64()
    val max_paint_pixels = (
        viewport_pixels * BROWSER_RENDERER_MAX_FRAME_OVERDRAW
    )
    var paint_pixels: i64 = 0
    var text_units: i64 = 0
    var style_props: i64 = 0
    var glyphs: i64 = 0
    for command in batch.commands:
        if (command.kind != DRAW_IR_COMMAND_IMAGE and
            command.kind != DRAW_IR_COMMAND_RECT and
            command.kind != DRAW_IR_COMMAND_TEXT):
            return "invalid-command-kind"
        val x = command.x.to_i64()
        val y = command.y.to_i64()
        val right = x + command.width.to_i64()
        val bottom = y + command.height.to_i64()
        if (command.width < 0 or command.height < 0 or
            x < -BROWSER_RENDERER_MAX_COORDINATE or x > BROWSER_RENDERER_MAX_COORDINATE or
            y < -BROWSER_RENDERER_MAX_COORDINATE or y > BROWSER_RENDERER_MAX_COORDINATE or
            right < -BROWSER_RENDERER_MAX_COORDINATE or right > BROWSER_RENDERER_MAX_COORDINATE or
            bottom < -BROWSER_RENDERER_MAX_COORDINATE or bottom > BROWSER_RENDERER_MAX_COORDINATE):
            return "invalid-command-bounds"
        val clipped_left = if x > 0: x else: 0
        val clipped_top = if y > 0: y else: 0
        val clipped_right = if right < width.to_i64():
            right
        else:
            width.to_i64()
        val clipped_bottom = if bottom < height.to_i64():
            bottom
        else:
            height.to_i64()
        if clipped_right > clipped_left and clipped_bottom > clipped_top:
            paint_pixels = paint_pixels + (
                (clipped_right - clipped_left) *
                (clipped_bottom - clipped_top)
            )
        text_units = text_units + command.text_value.len()
        style_props = style_props + command.computed_style.len()
        var command_glyphs = command.glyph_run.glyph_ids.len()
        if command.glyph_run.xs.len() > command_glyphs:
            command_glyphs = command.glyph_run.xs.len()
        if command.glyph_run.ys.len() > command_glyphs:
            command_glyphs = command.glyph_run.ys.len()
        if command.glyph_run.clusters.len() > command_glyphs:
            command_glyphs = command.glyph_run.clusters.len()
        if command.advance_widths.len() > command_glyphs:
            command_glyphs = command.advance_widths.len()
        glyphs = glyphs + command_glyphs
        if (paint_pixels > max_paint_pixels or
            text_units > BROWSER_RENDERER_MAX_FRAME_TEXT_UNITS or
            style_props > BROWSER_RENDERER_MAX_FRAME_STYLE_PROPS or
            glyphs > BROWSER_RENDERER_MAX_FRAME_GLYPHS):
            return "frame-work-budget-exceeded"
        if (command.text_value.len() > BROWSER_RENDERER_MAX_TEXT_BYTES or
            command.computed_style.len() > BROWSER_RENDERER_MAX_STYLE_PROPS or
            command.advance_widths.len() > BROWSER_RENDERER_MAX_GLYPHS or
            command.glyph_run.glyph_ids.len() > BROWSER_RENDERER_MAX_GLYPHS or
            command.glyph_run.xs.len() > BROWSER_RENDERER_MAX_GLYPHS or
            command.glyph_run.ys.len() > BROWSER_RENDERER_MAX_GLYPHS or
            command.glyph_run.clusters.len() > BROWSER_RENDERER_MAX_GLYPHS):
            return "invalid-command-metadata"
        if command.advance_widths.len() > 0:
            var character_count: i64 = 0
            for ch in command.text_value:
                character_count = character_count + 1
            var advance_width: i64 = 0
            for advance in command.advance_widths:
                val advance_i64 = advance as i64
                if advance < 0 or advance_width > 2147483647 - advance_i64:
                    return "invalid-command-metadata"
                advance_width = advance_width + advance_i64
            if (command.advance_widths.len() != character_count or
                advance_width != command.width as i64):
                return "invalid-command-metadata"
        for prop in command.computed_style:
            if (prop.key == "" or
                prop.key.len() > BROWSER_RENDERER_MAX_STYLE_KEY_BYTES or
                prop.value.len() > BROWSER_RENDERER_MAX_STYLE_VALUE_BYTES):
                return "invalid-command-metadata"
            if prop.key == "font-size":
                val font_size = _browser_renderer_positive_i64(prop.value)
                if font_size < 1 or font_size > BROWSER_RENDERER_MAX_FONT_SIZE:
                    return "invalid-command-metadata"
            if prop.key == "font-advance-widths" and not _browser_renderer_advance_list_valid(prop.value):
                return "invalid-command-metadata"
    ""

fn _browser_renderer_material_digest_valid(count: i64, digest: text) -> bool:
    if count < 0 or count > BROWSER_RENDERER_MAX_COMMANDS:
        return false
    if count == 0:
        return digest == ""
    if digest.len() != 64:
        return false
    val allowed = "0123456789abcdef"
    var index: i64 = 0
    while index < digest.len():
        if not allowed.contains(digest[index].to_text()):
            return false
        index = index + 1
    true

fn _browser_renderer_checked_end(
    start: i64, length: i64, limit: i64
) -> i64:
    if start < 0 or length < 0 or start > limit or length > limit - start:
        return -1
    start + length

fn _browser_renderer_base64_decoded_length(
    value: text, start: i64, end: i64
) -> i64:
    if start < 0 or end < start or end > value.len():
        return -1
    val encoded_len = end - start
    if encoded_len == 0:
        return 0
    if encoded_len % 4 != 0:
        return -1
    var padding: i64 = 0
    var index: i64 = 0
    while index < encoded_len:
        val byte = value.byte_at(start + index)
        val alphabet = (
            (byte >= 65 and byte <= 90) or
            (byte >= 97 and byte <= 122) or
            (byte >= 48 and byte <= 57) or byte == 43 or byte == 47
        )
        if byte == 61:
            if index < encoded_len - 2:
                return -1
            padding = padding + 1
            if padding > 2:
                return -1
        elif padding > 0 or not alphabet:
            return -1
        index = index + 1
    encoded_len / 4 * 3 - padding

pub fn hosted_browser_title_is_valid(value: text) -> bool:
    val byte_len = text_to_bytes(value).len().to_i64()
    (value != "" and value == value.trim() and not value.contains("\0") and
        byte_len <= BROWSER_RENDERER_MAX_DOCUMENT_TITLE_BYTES)

fn _browser_renderer_document_title_valid(value: text) -> bool:
    value == "" or hosted_browser_title_is_valid(value)

pub fn browser_renderer_frame_encode_with_witness(
    composition: DrawIrComposition,
    generation: i64,
    request_id: i64,
    reply_to_request_id: i64,
    next_animation_ms: i64,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text
) -> BrowserRendererEncodeResult:
    if (reply_to_request_id <= 0 or next_animation_ms < -1 or
        not _browser_renderer_material_digest_valid(
            cpu_composited_count.to_i64(), cpu_composited_sha256) or
        not _browser_renderer_material_digest_valid(
            solid_material_count.to_i64(), solid_material_sha256)):
        return _browser_renderer_reject_encode("invalid-material-witness")
    val encoded = simpleos_host_gpu_draw_ir_encode(
        _browser_renderer_normalize_draw_ir(composition),
        BROWSER_RENDERER_MAX_PAYLOAD_BYTES - BROWSER_RENDERER_MAX_HEADER_BYTES,
        BROWSER_RENDERER_MAX_COMMANDS
    )
    if not encoded.ok:
        return _browser_renderer_reject_encode("draw-ir-" + encoded.reason)
    val cpu_digest = if cpu_composited_sha256 == "": "-" else: cpu_composited_sha256
    val solid_digest = if solid_material_sha256 == "": "-" else: solid_material_sha256
    val payload = (
        "SBRF2\t{reply_to_request_id}\t{cpu_composited_count}\t{cpu_digest}" +
        "\t{solid_material_count}\t{solid_digest}\t{next_animation_ms}\n" +
        bytes_to_text(encoded.bytes)
    )
    browser_renderer_message_encode("frame", generation, request_id, payload)

pub fn browser_renderer_frame_encode(
    composition: DrawIrComposition,
    generation: i64,
    request_id: i64
) -> BrowserRendererEncodeResult:
    browser_renderer_frame_encode_with_witness(
        composition, generation, request_id, request_id, -1, 0, "", 0, ""
    )

pub fn browser_renderer_frame_encode_with_diagnostics(
    composition: DrawIrComposition,
    generation: i64,
    request_id: i64,
    reply_to_request_id: i64,
    next_animation_ms: i64,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text,
    diagnostics: text
) -> BrowserRendererEncodeResult:
    if diagnostics.len() > BROWSER_RENDERER_MAX_DIAGNOSTIC_BYTES:
        return _browser_renderer_reject_encode("invalid-frame-diagnostics")
    if (reply_to_request_id <= 0 or next_animation_ms < -1 or
        not _browser_renderer_material_digest_valid(
            cpu_composited_count.to_i64(), cpu_composited_sha256) or
        not _browser_renderer_material_digest_valid(
            solid_material_count.to_i64(), solid_material_sha256)):
        return _browser_renderer_reject_encode("invalid-material-witness")
    val encoded = simpleos_host_gpu_draw_ir_encode(
        _browser_renderer_normalize_draw_ir(composition),
        BROWSER_RENDERER_MAX_PAYLOAD_BYTES - BROWSER_RENDERER_MAX_HEADER_BYTES -
            BROWSER_RENDERER_MAX_DIAGNOSTIC_BYTES * 2 - 1,
        BROWSER_RENDERER_MAX_COMMANDS
    )
    if not encoded.ok:
        return _browser_renderer_reject_encode("draw-ir-" + encoded.reason)
    val cpu_digest = if cpu_composited_sha256 == "": "-" else: cpu_composited_sha256
    val solid_digest = if solid_material_sha256 == "": "-" else: solid_material_sha256
    val diagnostic_payload = base64_encode(diagnostics)
    val payload = (
        "SBRF3\t{reply_to_request_id}\t{cpu_composited_count}\t{cpu_digest}" +
        "\t{solid_material_count}\t{solid_digest}\t{next_animation_ms}" +
        "\t{diagnostic_payload.len()}\n" + diagnostic_payload + "\n" +
        bytes_to_text(encoded.bytes)
    )
    browser_renderer_message_encode("frame", generation, request_id, payload)

fn _browser_renderer_history_url_valid(
    value: text, byte_len: i64
) -> bool:
    (byte_len <= BROWSER_RENDERER_MAX_URL_BYTES and
        not value.contains("\0") and not value.contains("\r") and
        not value.contains("\n"))

pub fn browser_renderer_frame_encode_with_state(
    composition: DrawIrComposition,
    generation: i64,
    request_id: i64,
    reply_to_request_id: i64,
    next_animation_ms: i64,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text,
    diagnostics: text,
    history_current_url: text,
    history_back_url: text,
    history_forward_url: text
) -> BrowserRendererEncodeResult:
    val current_len = text_to_bytes(history_current_url).len()
    val back_len = text_to_bytes(history_back_url).len()
    val forward_len = text_to_bytes(history_forward_url).len()
    if diagnostics.len() > BROWSER_RENDERER_MAX_DIAGNOSTIC_BYTES:
        return _browser_renderer_reject_encode("invalid-frame-diagnostics")
    if (not _browser_renderer_history_url_valid(
            history_current_url, current_len
        ) or not _browser_renderer_history_url_valid(
            history_back_url, back_len
        ) or not _browser_renderer_history_url_valid(
            history_forward_url, forward_len
        )):
        return _browser_renderer_reject_encode("invalid-frame-state")
    if (reply_to_request_id <= 0 or next_animation_ms < -1 or
        not _browser_renderer_material_digest_valid(
            cpu_composited_count.to_i64(), cpu_composited_sha256) or
        not _browser_renderer_material_digest_valid(
            solid_material_count.to_i64(), solid_material_sha256)):
        return _browser_renderer_reject_encode("invalid-material-witness")
    val diagnostic_payload = base64_encode(diagnostics)
    val current_payload = base64_encode(history_current_url)
    val back_payload = base64_encode(history_back_url)
    val forward_payload = base64_encode(history_forward_url)
    val encoded = simpleos_host_gpu_draw_ir_encode(
        _browser_renderer_normalize_draw_ir(composition),
        BROWSER_RENDERER_MAX_PAYLOAD_BYTES - BROWSER_RENDERER_MAX_HEADER_BYTES -
            diagnostic_payload.len() - current_payload.len() -
            back_payload.len() - forward_payload.len(),
        BROWSER_RENDERER_MAX_COMMANDS
    )
    if not encoded.ok:
        return _browser_renderer_reject_encode("draw-ir-" + encoded.reason)
    val cpu_digest = if cpu_composited_sha256 == "": "-" else: cpu_composited_sha256
    val solid_digest = if solid_material_sha256 == "": "-" else: solid_material_sha256
    val payload = (
        "SBRF4\t{reply_to_request_id}\t{cpu_composited_count}\t{cpu_digest}" +
        "\t{solid_material_count}\t{solid_digest}\t{next_animation_ms}" +
        "\t{diagnostic_payload.len()}\t{current_payload.len()}" +
        "\t{back_payload.len()}\t{forward_payload.len()}\n" +
        diagnostic_payload + current_payload + back_payload +
        forward_payload + bytes_to_text(encoded.bytes)
    )
    browser_renderer_message_encode("frame", generation, request_id, payload)

fn _browser_renderer_image_pixel_limit_reason(
    image_resources: [SimpleOsHostGpuImageResource]
) -> text:
    var total_pixels: i64 = 0
    for resource in image_resources:
        val pixels = resource.width.to_i64() * resource.height.to_i64()
        if (pixels < 0 or
            total_pixels > BROWSER_RENDERER_MAX_IMAGE_PIXELS - pixels):
            return "too-many-image-pixels"
        total_pixels = total_pixels + pixels
    ""

fn _browser_renderer_image_resource_valid(
    resource: SimpleOsHostGpuImageResource
) -> bool:
    val pixel_count = resource.width.to_i64() * resource.height.to_i64()
    (resource.image_uri != "" and
        text_to_bytes(resource.image_uri).len().to_i64() <=
            SIMPLEOS_HOST_GPU_MAX_IMAGE_URI_BYTES and
        browser_renderer_viewport_valid(
            resource.width.to_i64(), resource.height.to_i64()) and
        pixel_count > 0 and resource.pixels.len().to_i64() == pixel_count)

pub fn browser_renderer_referenced_image_resources(
    composition: DrawIrComposition,
    image_resources: [SimpleOsHostGpuImageResource]
) -> [SimpleOsHostGpuImageResource]:
    var selected: [SimpleOsHostGpuImageResource] = []
    var resource_index_by_uri: Dict<text, i32> = {}
    var resource_index = 0
    while resource_index < image_resources.len():
        val resource = image_resources[resource_index]
        if (
            _browser_renderer_image_resource_valid(resource) and
            not resource_index_by_uri.has(resource.image_uri)
        ):
            resource_index_by_uri[resource.image_uri] = resource_index
        resource_index = resource_index + 1
    var selected_uris: Dict<text, bool> = {}
    var selected_pixels: i64 = 0
    var selected_wire_bytes: i64 = 0
    var command_count: i64 = 0
    for batch in composition.batches:
        for command in batch.commands:
            command_count = command_count + 1
            if command_count > BROWSER_RENDERER_MAX_COMMANDS:
                return selected
            if command.kind != DRAW_IR_COMMAND_IMAGE:
                continue
            if (
                selected_uris.has(command.image_uri) or
                selected.len().to_i64() >= BROWSER_RENDERER_MAX_IMAGE_RESOURCES
            ):
                continue
            if not resource_index_by_uri.has(command.image_uri):
                continue
            val resource = image_resources[
                resource_index_by_uri[command.image_uri]
            ]
            val pixel_count = resource.pixels.len().to_i64()
            val uri_bytes = text_to_bytes(
                resource.image_uri
            ).len().to_i64()
            val record_bytes = (
                SIMPLEOS_HOST_GPU_IMAGE_RESOURCE_ENTRY_HEADER_BYTES +
                ((uri_bytes + 7) / 8) * 8 +
                ((pixel_count * 4 + 7) / 8) * 8
            )
            if (selected_pixels <=
                    BROWSER_RENDERER_MAX_IMAGE_PIXELS - pixel_count and
                selected_wire_bytes <=
                    BROWSER_RENDERER_MAX_IMAGE_RESOURCE_BYTES -
                        record_bytes):
                selected.push(resource)
                selected_uris[resource.image_uri] = true
                selected_pixels = selected_pixels + pixel_count
                selected_wire_bytes = (
                    selected_wire_bytes + record_bytes
                )
    selected

fn _browser_renderer_revision_for(
    revisions: [SimpleOsHostGpuImageResourceRevision], image_uri: text
) -> i64:
    for revision in revisions:
        if revision.image_uri == image_uri:
            return revision.pixel_checksum
    0

pub fn browser_renderer_image_resource_revisions(
    image_resources: [SimpleOsHostGpuImageResource]
) -> [SimpleOsHostGpuImageResourceRevision]:
    var revisions: [SimpleOsHostGpuImageResourceRevision] = []
    for resource in image_resources:
        revisions.push(SimpleOsHostGpuImageResourceRevision(
            image_uri: resource.image_uri,
            pixel_checksum: resource.pixel_checksum
        ))
    revisions

fn _browser_renderer_frame_encode_with_state_and_images(
    composition: DrawIrComposition,
    generation: i64,
    request_id: i64,
    reply_to_request_id: i64,
    next_animation_ms: i64,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text,
    diagnostics: text,
    history_current_url: text,
    history_back_url: text,
    history_forward_url: text,
    composition_revision: i64,
    image_resources: [SimpleOsHostGpuImageResource],
    prior_revisions: [SimpleOsHostGpuImageResourceRevision],
    retained_wire: bool,
    document_title: text,
    title_wire: bool,
    history_proposal: text,
    history_proposal_wire: bool,
    damage_receipt: BrowserRendererDamageReceipt?
) -> BrowserRendererEncodeResult:
    val current_len = text_to_bytes(history_current_url).len()
    val back_len = text_to_bytes(history_back_url).len()
    val forward_len = text_to_bytes(history_forward_url).len()
    if diagnostics.len() > BROWSER_RENDERER_MAX_DIAGNOSTIC_BYTES:
        return _browser_renderer_reject_encode("invalid-frame-diagnostics")
    if title_wire and not _browser_renderer_document_title_valid(
        document_title
    ):
        return _browser_renderer_reject_encode("invalid-document-title")
    if (history_proposal_wire and
        (history_proposal == "" or
            history_proposal.len() > BROWSER_RENDERER_MAX_PAYLOAD_BYTES)):
        return _browser_renderer_reject_encode("invalid-history-proposal")
    if (not _browser_renderer_history_url_valid(
            history_current_url, current_len
        ) or not _browser_renderer_history_url_valid(
            history_back_url, back_len
        ) or not _browser_renderer_history_url_valid(
            history_forward_url, forward_len
        )):
        return _browser_renderer_reject_encode("invalid-frame-state")
    if (reply_to_request_id <= 0 or next_animation_ms < -1 or
        not _browser_renderer_material_digest_valid(
            cpu_composited_count.to_i64(), cpu_composited_sha256) or
        not _browser_renderer_material_digest_valid(
            solid_material_count.to_i64(), solid_material_sha256)):
        return _browser_renderer_reject_encode("invalid-material-witness")
    val normalized = _browser_renderer_normalize_draw_ir(composition)
    var retained_entries: [SimpleOsHostGpuImageResourceEntry] = []
    var has_reference = false
    if retained_wire:
        for resource in image_resources:
            val reference_is_smaller = resource.pixels.len().to_i64() * 4 > (
                    SIMPLEOS_HOST_GPU_IMAGE_RESOURCE_ENTRY_HEADER_BYTES -
                    SIMPLEOS_HOST_GPU_IMAGE_RESOURCE_HEADER_BYTES
                )
            if (reference_is_smaller and _browser_renderer_revision_for(
                    prior_revisions, resource.image_uri
                ) == resource.pixel_checksum):
                has_reference = true
                retained_entries.push(simpleos_host_gpu_image_resource_ref(
                    resource.image_uri, resource.width, resource.height,
                    resource.pixel_checksum
                ))
            else:
                retained_entries.push(simpleos_host_gpu_image_resource_full(
                    resource.image_uri, resource.width, resource.height,
                    resource.pixels
                ))
    # Revision frames use the retained codec for both full and reference
    # entries, so first and changed image frames decode through one path.
    val use_retained_wire = retained_wire and (
        has_reference or composition_revision >= 0
    )
    val image_payload = if use_retained_wire:
        simpleos_host_gpu_image_resources_encode_retained(
            retained_entries,
            BROWSER_RENDERER_MAX_IMAGE_RESOURCE_BYTES,
            BROWSER_RENDERER_MAX_IMAGE_RESOURCES
        )
    else:
        simpleos_host_gpu_image_resources_encode(
            image_resources,
            BROWSER_RENDERER_MAX_IMAGE_RESOURCE_BYTES,
            BROWSER_RENDERER_MAX_IMAGE_RESOURCES
        )
    if not image_payload.ok:
        return _browser_renderer_reject_encode(
            "image-resources-" + image_payload.reason
        )
    val pixel_reason = _browser_renderer_image_pixel_limit_reason(
        image_resources
    )
    if pixel_reason != "":
        return _browser_renderer_reject_encode(pixel_reason)
    val coverage_reason = simpleos_host_gpu_image_resource_coverage_reason(
        normalized, image_resources
    )
    if coverage_reason != "":
        return _browser_renderer_reject_encode(
            "image-resources-" + coverage_reason
        )
    val diagnostic_payload = base64_encode(diagnostics)
    val current_payload = base64_encode(history_current_url)
    val back_payload = base64_encode(history_back_url)
    val forward_payload = base64_encode(history_forward_url)
    val title_payload = if title_wire:
        base64_encode(document_title)
    else:
        ""
    val title_bytes = if title_wire:
        text_to_bytes(document_title).len().to_i64()
    else:
        0
    val history_proposal_payload = if history_proposal_wire:
        base64_encode(history_proposal)
    else:
        ""
    val damage_payload = match damage_receipt:
        Some(receipt): browser_renderer_damage_receipt_encode(receipt)
        nil: ""
    val damage_wire = damage_receipt != nil
    if damage_wire and composition_revision < 0:
        return _browser_renderer_reject_encode("damage-receipt-needs-revision")
    val encoded_images = base64url_encode_bytes(image_payload.bytes)
    if encoded_images.len() > (
        BROWSER_RENDERER_MAX_IMAGE_RESOURCE_ENCODED_BYTES
    ):
        return _browser_renderer_reject_encode(
            "image-resources-payload-too-large"
        )
    val encoded = simpleos_host_gpu_draw_ir_encode(
        normalized,
        BROWSER_RENDERER_MAX_PAYLOAD_BYTES - BROWSER_RENDERER_MAX_HEADER_BYTES -
            diagnostic_payload.len() - current_payload.len() -
            back_payload.len() - forward_payload.len() -
            title_payload.len() - title_bytes -
            history_proposal_payload.len() - encoded_images.len() -
            damage_payload.len(),
        BROWSER_RENDERER_MAX_COMMANDS
    )
    if not encoded.ok:
        return _browser_renderer_reject_encode("draw-ir-" + encoded.reason)
    val cpu_digest = if cpu_composited_sha256 == "":
        "-"
    else:
        cpu_composited_sha256
    val solid_digest = if solid_material_sha256 == "":
        "-"
    else:
        solid_material_sha256
    val revision_frame = composition_revision >= 0
    val frame_version = if damage_wire:
        "SBRF10"
    elif history_proposal_wire:
        "SBRF8"
    elif title_wire:
        "SBRF8"
    elif revision_frame:
        "SBRF7"
    elif use_retained_wire:
        "SBRF6"
    else:
        "SBRF5"
    val title_field = if title_wire:
        "\t{title_payload.len()}"
    else:
        ""
    val history_proposal_field = if history_proposal_wire:
        "\t{history_proposal_payload.len()}"
    else:
        ""
    val revision_field = if revision_frame:
        "\t{composition_revision}"
    else:
        ""
    val damage_fields = match damage_receipt:
        Some(receipt): "\t{receipt.mode}\t{damage_payload.len()}"
        nil: ""
    val payload = (
        "{frame_version}\t{reply_to_request_id}\t{cpu_composited_count}\t{cpu_digest}" +
        "\t{solid_material_count}\t{solid_digest}\t{next_animation_ms}" +
        "\t{diagnostic_payload.len()}\t{current_payload.len()}" +
        "\t{back_payload.len()}\t{forward_payload.len()}" +
        title_field + history_proposal_field +
        "\t{image_payload.resource_count}\t{image_payload.checksum}" +
        "\t{encoded_images.len()}{revision_field}{damage_fields}\n" +
        diagnostic_payload + current_payload + back_payload +
        forward_payload + title_payload + history_proposal_payload +
        encoded_images + damage_payload +
        bytes_to_text(encoded.bytes)
    )
    browser_renderer_message_encode("frame", generation, request_id, payload)

pub fn browser_renderer_frame_encode_with_state_and_images(
    composition: DrawIrComposition,
    generation: i64,
    request_id: i64,
    reply_to_request_id: i64,
    next_animation_ms: i64,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text,
    diagnostics: text,
    history_current_url: text,
    history_back_url: text,
    history_forward_url: text,
    image_resources: [SimpleOsHostGpuImageResource]
) -> BrowserRendererEncodeResult:
    _browser_renderer_frame_encode_with_state_and_images(
        composition, generation, request_id, reply_to_request_id,
        next_animation_ms, cpu_composited_count, cpu_composited_sha256,
        solid_material_count, solid_material_sha256, diagnostics,
        history_current_url, history_back_url, history_forward_url,
        -1, image_resources, [], false, "", false, "", false, nil
    )

pub fn browser_renderer_frame_encode_with_state_and_retained_images(
    composition: DrawIrComposition,
    generation: i64,
    request_id: i64,
    reply_to_request_id: i64,
    next_animation_ms: i64,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text,
    diagnostics: text,
    history_current_url: text,
    history_back_url: text,
    history_forward_url: text,
    composition_revision: i64,
    image_resources: [SimpleOsHostGpuImageResource],
    prior_revisions: [SimpleOsHostGpuImageResourceRevision]
) -> BrowserRendererEncodeResult:
    if composition_revision < 0:
        return _browser_renderer_reject_encode(
            "invalid-composition-revision"
        )
    _browser_renderer_frame_encode_with_state_and_images(
        composition, generation, request_id, reply_to_request_id,
        next_animation_ms, cpu_composited_count, cpu_composited_sha256,
        solid_material_count, solid_material_sha256, diagnostics,
        history_current_url, history_back_url, history_forward_url,
        composition_revision, image_resources, prior_revisions, true,
        "", false, "", false, nil
    )

pub fn browser_renderer_frame_encode_with_state_and_retained_images_and_title(
    composition: DrawIrComposition,
    generation: i64,
    request_id: i64,
    reply_to_request_id: i64,
    next_animation_ms: i64,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text,
    diagnostics: text,
    history_current_url: text,
    history_back_url: text,
    history_forward_url: text,
    document_title: text,
    composition_revision: i64,
    image_resources: [SimpleOsHostGpuImageResource],
    prior_revisions: [SimpleOsHostGpuImageResourceRevision]
) -> BrowserRendererEncodeResult:
    if composition_revision < 0:
        return _browser_renderer_reject_encode(
            "invalid-composition-revision"
        )
    _browser_renderer_frame_encode_with_state_and_images(
        composition, generation, request_id, reply_to_request_id,
        next_animation_ms, cpu_composited_count, cpu_composited_sha256,
        solid_material_count, solid_material_sha256, diagnostics,
        history_current_url, history_back_url, history_forward_url,
        composition_revision, image_resources, prior_revisions, true,
        document_title, true, "", false, nil
    )

pub fn browser_renderer_frame_encode_with_retained_damage(
    composition: DrawIrComposition,
    generation: i64,
    request_id: i64,
    reply_to_request_id: i64,
    next_animation_ms: i64,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text,
    diagnostics: text,
    history_current_url: text,
    history_back_url: text,
    history_forward_url: text,
    document_title: text,
    composition_revision: i64,
    image_resources: [SimpleOsHostGpuImageResource],
    prior_revisions: [SimpleOsHostGpuImageResourceRevision],
    viewport_width: i32,
    viewport_height: i32,
    damage_receipt: BrowserRendererDamageReceipt
) -> BrowserRendererEncodeResult:
    if composition_revision < 0:
        return _browser_renderer_reject_encode(
            "invalid-composition-revision"
        )
    if not browser_renderer_damage_receipt_valid(
        damage_receipt, viewport_width, viewport_height
    ):
        return _browser_renderer_reject_encode("invalid-damage-receipt")
    _browser_renderer_frame_encode_with_state_and_images(
        composition, generation, request_id, reply_to_request_id,
        next_animation_ms, cpu_composited_count, cpu_composited_sha256,
        solid_material_count, solid_material_sha256, diagnostics,
        history_current_url, history_back_url, history_forward_url,
        composition_revision, image_resources, prior_revisions, true,
        document_title, true, "", false, Some(damage_receipt)
    )

pub fn browser_renderer_frame_encode_with_history_proposal(
    composition: DrawIrComposition,
    generation: i64,
    request_id: i64,
    reply_to_request_id: i64,
    next_animation_ms: i64,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text,
    diagnostics: text,
    history_current_url: text,
    history_back_url: text,
    history_forward_url: text,
    document_title: text,
    history_proposal: text,
    composition_revision: i64,
    image_resources: [SimpleOsHostGpuImageResource],
    prior_revisions: [SimpleOsHostGpuImageResourceRevision]
) -> BrowserRendererEncodeResult:
    if composition_revision < 0:
        return _browser_renderer_reject_encode(
            "invalid-composition-revision"
        )
    _browser_renderer_frame_encode_with_state_and_images(
        composition, generation, request_id, reply_to_request_id,
        next_animation_ms, cpu_composited_count, cpu_composited_sha256,
        solid_material_count, solid_material_sha256, diagnostics,
        history_current_url, history_back_url, history_forward_url,
        composition_revision, image_resources, prior_revisions, true,
        document_title, true, history_proposal, true, nil
    )

pub fn browser_renderer_frame_reply_to_request_id(
    message: BrowserRendererMessage
) -> i64:
    if message.kind != "frame":
        return -1
    val header_end = _browser_renderer_header_end(message.payload)
    if header_end < 0 or header_end >= BROWSER_RENDERER_MAX_HEADER_BYTES:
        return -1
    val fields = _browser_renderer_byte_slice(
        message.payload, 0, header_end
    ).split("\t")
    if not ((fields.len() == 7 and fields[0] == "SBRF2") or
        (fields.len() == 8 and fields[0] == "SBRF3") or
        (fields.len() == 11 and fields[0] == "SBRF4") or
        (fields.len() == 14 and
            (fields[0] == "SBRF5" or fields[0] == "SBRF6")) or
        (fields.len() == 15 and fields[0] == "SBRF7") or
        (fields.len() == 16 and fields[0] == "SBRF8") or
        (fields.len() == 17 and fields[0] == "SBRF8") or
        (fields.len() == 18 and fields[0] == "SBRF10") or
        (fields.len() == 19 and fields[0] == "SBRF10")):
        return -1
    val reply_to_request_id = fields[1].to_i64() ?? -1
    if (reply_to_request_id <= 0 or
        str(reply_to_request_id) != fields[1]):
        return -1
    reply_to_request_id

fn _browser_renderer_frame_decode(
    message: BrowserRendererMessage,
    width: i32,
    height: i32,
    retained_images: [SimpleOsHostGpuImageResource]
) -> BrowserRendererFrameDecodeResult:
    if message.kind != "frame":
        return _browser_renderer_frame_reject("wrong-kind")
    val witness_end = _browser_renderer_header_end(message.payload)
    if witness_end < 0 or witness_end >= BROWSER_RENDERER_MAX_HEADER_BYTES:
        return _browser_renderer_frame_reject("malformed-material-witness")
    val fields = _browser_renderer_byte_slice(
        message.payload, 0, witness_end
    ).split("\t")
    val legacy_frame = fields.len() == 7 and fields[0] == "SBRF2"
    val diagnostic_frame = fields.len() == 8 and fields[0] == "SBRF3"
    val state_frame = (
        (fields.len() == 11 and fields[0] == "SBRF4") or
        (fields.len() == 14 and
            (fields[0] == "SBRF5" or fields[0] == "SBRF6")) or
        (fields.len() == 15 and fields[0] == "SBRF7") or
        (fields.len() == 16 and fields[0] == "SBRF8") or
        (fields.len() == 17 and fields[0] == "SBRF8") or
        (fields.len() == 18 and fields[0] == "SBRF10") or
        (fields.len() == 19 and fields[0] == "SBRF10")
    )
    val image_frame = (
        (fields.len() == 14 and
            (fields[0] == "SBRF5" or fields[0] == "SBRF6")) or
        (fields.len() == 15 and fields[0] == "SBRF7") or
        (fields.len() == 16 and fields[0] == "SBRF8") or
        (fields.len() == 17 and fields[0] == "SBRF8") or
        (fields.len() == 18 and fields[0] == "SBRF10") or
        (fields.len() == 19 and fields[0] == "SBRF10")
    )
    val retained_frame = (
        (fields.len() == 14 and fields[0] == "SBRF6") or
        (fields.len() == 15 and fields[0] == "SBRF7") or
        (fields.len() == 16 and fields[0] == "SBRF8") or
        (fields.len() == 17 and fields[0] == "SBRF8") or
        (fields.len() == 18 and fields[0] == "SBRF10") or
        (fields.len() == 19 and fields[0] == "SBRF10")
    )
    val damage_frame = (
        (fields.len() == 18 or fields.len() == 19) and
        fields[0] == "SBRF10"
    )
    val title_frame = (
        (fields.len() == 16 and fields[0] == "SBRF8") or
        (fields.len() == 17 and fields[0] == "SBRF8") or damage_frame
    )
    val history_proposal_frame = (
        (fields.len() == 17 and fields[0] == "SBRF8") or
        (fields.len() == 19 and fields[0] == "SBRF10")
    )
    if not legacy_frame and not diagnostic_frame and not state_frame:
        return _browser_renderer_frame_reject("malformed-material-witness")
    val reply_to_request_id = _browser_renderer_positive_i64(fields[1])
    val cpu_count = fields[2].to_i64() ?? -1
    val solid_count = fields[4].to_i64() ?? -1
    val next_animation_ms = fields[6].to_i64() ?? -2
    val revision_field_index = if history_proposal_frame:
        16
    elif title_frame:
        15
    else:
        14
    val composition_revision = if (
        fields[0] == "SBRF7" or title_frame
    ):
        fields[revision_field_index].to_i64() ?? -1
    else:
        -1
    if (reply_to_request_id < 0 or cpu_count < 0 or solid_count < 0 or
        next_animation_ms < -1 or
        ((fields[0] == "SBRF7" or title_frame) and
            (composition_revision < 0 or
             str(composition_revision) != fields[revision_field_index])) or
        str(cpu_count) != fields[2] or str(solid_count) != fields[4] or
        str(next_animation_ms) != fields[6]):
        return _browser_renderer_frame_reject("malformed-material-witness")
    val cpu_digest = if fields[3] == "-": "" else: fields[3]
    val solid_digest = if fields[5] == "-": "" else: fields[5]
    if (not _browser_renderer_material_digest_valid(cpu_count, cpu_digest) or
        not _browser_renderer_material_digest_valid(
            solid_count, solid_digest)):
        return _browser_renderer_frame_reject("invalid-material-witness")
    var diagnostics = ""
    var history_current_url = ""
    var history_back_url = ""
    var history_forward_url = ""
    var history_proposal = ""
    var document_title = ""
    var image_resources: [SimpleOsHostGpuImageResource] = []
    var damage_receipt = browser_renderer_damage_receipt(
        DAMAGE_PLAN_FULL, [0, 0, width.to_i64(), height.to_i64()]
    )
    var draw_ir_start = witness_end + 1
    if diagnostic_frame or state_frame:
        val diagnostic_len = fields[7].to_i64() ?? -1
        if (diagnostic_len < 0 or diagnostic_len > 8192 or
            str(diagnostic_len) != fields[7] or
            draw_ir_start >= message.payload.len()):
            return _browser_renderer_frame_reject("malformed-frame-diagnostics")
        val diagnostic_end = draw_ir_start + diagnostic_len
        if diagnostic_end >= message.payload.len():
            return _browser_renderer_frame_reject("malformed-frame-diagnostics")
        val encoded_diagnostics = _browser_renderer_byte_slice(
            message.payload, draw_ir_start, diagnostic_end
        )
        diagnostics = base64_decode(encoded_diagnostics)
        if (diagnostics.len() > BROWSER_RENDERER_MAX_DIAGNOSTIC_BYTES or
            base64_encode(diagnostics) != encoded_diagnostics):
            return _browser_renderer_frame_reject("invalid-frame-diagnostics")
        if diagnostic_frame:
            if message.payload.byte_at(diagnostic_end) != 10:
                return _browser_renderer_frame_reject(
                    "malformed-frame-diagnostics"
                )
            draw_ir_start = diagnostic_end + 1
        else:
            val current_len = fields[8].to_i64() ?? -1
            val back_len = fields[9].to_i64() ?? -1
            val forward_len = fields[10].to_i64() ?? -1
            if (current_len < 0 or back_len < 0 or forward_len < 0 or
                current_len > BROWSER_RENDERER_MAX_URL_ENCODED_BYTES or
                back_len > BROWSER_RENDERER_MAX_URL_ENCODED_BYTES or
                forward_len > BROWSER_RENDERER_MAX_URL_ENCODED_BYTES or
                str(current_len) != fields[8] or
                str(back_len) != fields[9] or
                str(forward_len) != fields[10]):
                return _browser_renderer_frame_reject(
                    "malformed-frame-state"
                )
            val current_end = _browser_renderer_checked_end(
                diagnostic_end, current_len, message.payload.len()
            )
            val back_end = _browser_renderer_checked_end(
                current_end, back_len, message.payload.len()
            )
            val history_end = _browser_renderer_checked_end(
                back_end, forward_len, message.payload.len()
            )
            if history_end < 0 or history_end >= message.payload.len():
                return _browser_renderer_frame_reject(
                    "malformed-frame-state"
                )
            val encoded_current_url = _browser_renderer_byte_slice(
                message.payload, diagnostic_end,
                current_end
            )
            val history_back_start = current_end
            val encoded_back_url = _browser_renderer_byte_slice(
                message.payload, history_back_start,
                back_end
            )
            val history_forward_start = back_end
            val encoded_forward_url = _browser_renderer_byte_slice(
                message.payload, history_forward_start, history_end
            )
            history_current_url = base64_decode(encoded_current_url)
            history_back_url = base64_decode(encoded_back_url)
            history_forward_url = base64_decode(encoded_forward_url)
            val current_raw_len = text_to_bytes(history_current_url).len()
            val back_raw_len = text_to_bytes(history_back_url).len()
            val forward_raw_len = text_to_bytes(history_forward_url).len()
            if (not _browser_renderer_history_url_valid(
                    history_current_url, current_raw_len
                ) or not _browser_renderer_history_url_valid(
                    history_back_url, back_raw_len
                ) or not _browser_renderer_history_url_valid(
                    history_forward_url, forward_raw_len
                ) or base64_encode(history_current_url) != encoded_current_url or
                base64_encode(history_back_url) != encoded_back_url or
                base64_encode(history_forward_url) != encoded_forward_url):
                return _browser_renderer_frame_reject("invalid-frame-state")
            draw_ir_start = history_end
            if image_frame:
                val resource_field = if history_proposal_frame:
                    13
                elif title_frame:
                    12
                else:
                    11
                val resource_count = fields[resource_field].to_i64() ?? -1
                val resource_checksum = fields[
                    resource_field + 1
                ].to_i64() ?? -1
                val encoded_image_len = fields[
                    resource_field + 2
                ].to_i64() ?? -1
                if (resource_count < 0 or
                    resource_count > BROWSER_RENDERER_MAX_IMAGE_RESOURCES or
                    resource_checksum < 0 or encoded_image_len < 0 or
                    encoded_image_len >
                        BROWSER_RENDERER_MAX_IMAGE_RESOURCE_ENCODED_BYTES or
                    str(resource_count) != fields[resource_field] or
                    str(resource_checksum) != fields[resource_field + 1] or
                    str(encoded_image_len) != fields[resource_field + 2]):
                    return _browser_renderer_frame_reject(
                        "malformed-image-resources"
                    )
                var image_start = history_end
                var title_end = history_end
                if title_frame:
                    val title_len = fields[11].to_i64() ?? -1
                    if (title_len < 0 or
                        title_len >
                            BROWSER_RENDERER_MAX_DOCUMENT_TITLE_ENCODED_BYTES or
                        str(title_len) != fields[11]):
                        return _browser_renderer_frame_reject(
                            "malformed-document-title"
                        )
                    title_end = _browser_renderer_checked_end(
                        history_end, title_len, message.payload.len()
                    )
                    if title_end < 0:
                        return _browser_renderer_frame_reject(
                            "malformed-document-title"
                        )
                    image_start = title_end
                var history_proposal_end = image_start
                if history_proposal_frame:
                    val history_proposal_len = fields[12].to_i64() ?? -1
                    if (history_proposal_len <= 0 or
                        history_proposal_len >
                            BROWSER_RENDERER_MAX_PAYLOAD_BYTES or
                        str(history_proposal_len) != fields[12]):
                        return _browser_renderer_frame_reject(
                            "malformed-history-proposal"
                        )
                    history_proposal_end = _browser_renderer_checked_end(
                        image_start, history_proposal_len,
                        message.payload.len()
                    )
                    if history_proposal_end < 0:
                        return _browser_renderer_frame_reject(
                            "malformed-history-proposal"
                        )
                    val encoded_history_proposal = (
                        _browser_renderer_byte_slice(
                            message.payload, image_start,
                            history_proposal_end
                        )
                    )
                    history_proposal = base64_decode(
                        encoded_history_proposal
                    )
                    if (history_proposal == "" or
                        base64_encode(history_proposal) !=
                            encoded_history_proposal):
                        return _browser_renderer_frame_reject(
                            "invalid-history-proposal"
                        )
                    image_start = history_proposal_end
                val image_end = _browser_renderer_checked_end(
                    image_start, encoded_image_len, message.payload.len()
                )
                if image_end < 0 or image_end >= message.payload.len():
                    return _browser_renderer_frame_reject(
                        "malformed-image-resources"
                    )
                if title_frame:
                    val decoded_title_len = (
                        _browser_renderer_base64_decoded_length(
                            message.payload, history_end, title_end
                        )
                    )
                    if (decoded_title_len < 0 or
                        decoded_title_len >
                            BROWSER_RENDERER_MAX_DOCUMENT_TITLE_BYTES or
                        message.payload.len() >
                            BROWSER_RENDERER_MAX_PAYLOAD_BYTES -
                                decoded_title_len):
                        return _browser_renderer_frame_reject(
                            "invalid-document-title"
                        )
                    val encoded_title = _browser_renderer_byte_slice(
                        message.payload, history_end, title_end
                    )
                    document_title = base64_decode(encoded_title)
                    if (text_to_bytes(document_title).len().to_i64() !=
                            decoded_title_len or
                        not _browser_renderer_document_title_valid(
                            document_title
                        ) or
                        base64_encode(document_title) != encoded_title):
                        return _browser_renderer_frame_reject(
                            "invalid-document-title"
                        )
                val encoded_images = _browser_renderer_byte_slice(
                    message.payload, image_start, image_end
                )
                val image_bytes = base64url_decode_to_bytes(encoded_images)
                if (image_bytes.len().to_i64() >
                        BROWSER_RENDERER_MAX_IMAGE_RESOURCE_BYTES or
                    base64url_encode_bytes(image_bytes) != encoded_images):
                    return _browser_renderer_frame_reject(
                        "invalid-image-resources"
                    )
                if retained_frame:
                    val decoded_entries = (
                        simpleos_host_gpu_image_resources_decode_retained(
                            image_bytes,
                            resource_count,
                            resource_checksum,
                            BROWSER_RENDERER_MAX_IMAGE_RESOURCE_BYTES,
                            BROWSER_RENDERER_MAX_IMAGE_RESOURCES
                        )
                    )
                    if not decoded_entries.ok:
                        return _browser_renderer_frame_reject(
                            "image-resources-" + decoded_entries.reason
                        )
                    val resolved = simpleos_host_gpu_resolve_retained_images(
                        decoded_entries.entries, retained_images
                    )
                    if not resolved.ok:
                        return _browser_renderer_frame_reject(
                            "image-resources-" + resolved.reason
                        )
                    image_resources = resolved.resolved
                else:
                    val decoded_images = (
                        simpleos_host_gpu_image_resources_decode(
                            image_bytes,
                            resource_count,
                            resource_checksum,
                            BROWSER_RENDERER_MAX_IMAGE_RESOURCE_BYTES,
                            BROWSER_RENDERER_MAX_IMAGE_RESOURCES
                        )
                    )
                    if not decoded_images.ok:
                        return _browser_renderer_frame_reject(
                            "image-resources-" + decoded_images.reason
                        )
                    image_resources = decoded_images.resources
                val pixel_reason = _browser_renderer_image_pixel_limit_reason(
                    image_resources
                )
                if pixel_reason != "":
                    return _browser_renderer_frame_reject(pixel_reason)
                draw_ir_start = image_end
                if damage_frame:
                    val damage_mode_index = revision_field_index + 1
                    val damage_len_index = revision_field_index + 2
                    val damage_mode = fields[damage_mode_index].to_i64() ?? -1
                    val damage_len = fields[damage_len_index].to_i64() ?? -1
                    if (damage_len <= 0 or damage_len >
                            BROWSER_RENDERER_MAX_HEADER_BYTES or
                        str(damage_mode) != fields[damage_mode_index] or
                        str(damage_len) != fields[damage_len_index]):
                        return _browser_renderer_frame_reject(
                            "malformed-damage-receipt"
                        )
                    val damage_end = _browser_renderer_checked_end(
                        image_end, damage_len, message.payload.len()
                    )
                    if damage_end < 0 or damage_end >= message.payload.len():
                        return _browser_renderer_frame_reject(
                            "malformed-damage-receipt"
                        )
                    val encoded_damage = _browser_renderer_byte_slice(
                        message.payload, image_end, damage_end
                    )
                    match browser_renderer_damage_receipt_decode(
                        encoded_damage, width, height
                    ):
                        Some(receipt):
                            if receipt.mode != damage_mode:
                                return _browser_renderer_frame_reject(
                                    "invalid-damage-receipt"
                                )
                            damage_receipt = receipt
                        nil: return _browser_renderer_frame_reject(
                            "invalid-damage-receipt"
                        )
                    draw_ir_start = damage_end
    val decoded = simpleos_host_gpu_draw_ir_decode(
        text_to_bytes(_browser_renderer_byte_slice(
            message.payload, draw_ir_start, message.payload.len()
        )),
        BROWSER_RENDERER_MAX_PAYLOAD_BYTES,
        BROWSER_RENDERER_MAX_COMMANDS
    )
    if not decoded.ok:
        return _browser_renderer_frame_reject(decoded.reason)
    val reason = _browser_renderer_frame_validation_reason(decoded.composition, width, height)
    if reason != "":
        return _browser_renderer_frame_reject(reason)
    val coverage_reason = simpleos_host_gpu_image_resource_coverage_reason(
        decoded.composition, image_resources
    )
    if coverage_reason != "":
        return _browser_renderer_frame_reject(
            "image-resources-" + coverage_reason
        )
    BrowserRendererFrameDecodeResult(
        ok: true,
        reason: "ok",
        reply_to_request_id: reply_to_request_id,
        next_animation_ms: next_animation_ms,
        composition_revision: composition_revision,
        history_state_present: state_frame,
        history_current_url: history_current_url,
        history_back_url: history_back_url,
        history_forward_url: history_forward_url,
        history_proposal_present: history_proposal_frame,
        history_proposal: history_proposal,
        document_title_present: title_frame and document_title != "",
        document_title: document_title,
        composition: decoded.composition,
        image_resources: image_resources,
        cpu_composited_count: cpu_count.to_i32(),
        cpu_composited_sha256: cpu_digest,
        solid_material_count: solid_count.to_i32(),
        solid_material_sha256: solid_digest,
        diagnostics: diagnostics,
        damage_receipt: damage_receipt
    )

pub fn browser_renderer_frame_decode(
    message: BrowserRendererMessage, width: i32, height: i32
) -> BrowserRendererFrameDecodeResult:
    _browser_renderer_frame_decode(message, width, height, [])

pub fn browser_renderer_frame_decode_with_retained_images(
    message: BrowserRendererMessage,
    width: i32,
    height: i32,
    retained_images: [SimpleOsHostGpuImageResource]
) -> BrowserRendererFrameDecodeResult:
    _browser_renderer_frame_decode(
        message, width, height, retained_images
    )
