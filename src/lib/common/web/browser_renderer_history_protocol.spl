"""Canonical bounded history proposals for the isolated browser renderer."""

use std.common.base_encoding.base64.{base64_decode, base64_encode}
use std.common.base_encoding.utilities.{base_encoding_text_to_bytes as text_to_bytes}
use common.string_builder.{StringBuilder}

pub val BROWSER_RENDERER_HISTORY_MAX_ENTRIES: i64 = 64
pub val BROWSER_RENDERER_HISTORY_MAX_URL_BYTES: i64 = 8192
pub val BROWSER_RENDERER_HISTORY_MAX_CAPABILITY_BYTES: i64 = 256

pub struct BrowserRendererHistoryProposal:
    ok: bool
    reason: text
    action: text
    url_kind: text
    raw_url: text
    resolved_url: text
    authority_capability: text
    current_index: i64
    urls: [text]

fn _history_proposal_reject(reason: text) -> BrowserRendererHistoryProposal:
    BrowserRendererHistoryProposal(
        ok: false,
        reason: reason,
        action: "",
        url_kind: "",
        raw_url: "",
        resolved_url: "",
        authority_capability: "",
        current_index: -1,
        urls: []
    )

fn _history_text_valid(value: text, max_bytes: i64) -> bool:
    (text_to_bytes(value).len().to_i64() <= max_bytes and
        not value.contains("\0") and not value.contains("\r") and
        not value.contains("\n") and not value.contains("\t"))

fn _history_action_valid(action: text) -> bool:
    action == "N" or action == "P" or action == "R" or action == "T"

fn _history_url_kind_valid(action: text, url_kind: text) -> bool:
    if action == "P" or action == "R":
        return url_kind == "O" or url_kind == "N" or url_kind == "V"
    url_kind == "O"

pub fn browser_renderer_history_proposal_encode(
    action: text,
    url_kind: text,
    raw_url: text,
    resolved_url: text,
    authority_capability: text,
    current_index: i64,
    urls: [text]
) -> Result<text, text>:
    if (not _history_action_valid(action) or
        not _history_url_kind_valid(action, url_kind) or
        urls.len() <= 0 or
        urls.len().to_i64() > BROWSER_RENDERER_HISTORY_MAX_ENTRIES or
        current_index < 0 or current_index >= urls.len().to_i64() or
        not _history_text_valid(
            resolved_url, BROWSER_RENDERER_HISTORY_MAX_URL_BYTES
        ) or resolved_url == "" or
        not _history_text_valid(
            authority_capability, BROWSER_RENDERER_HISTORY_MAX_CAPABILITY_BYTES
        ) or authority_capability == "" or
        urls[current_index] != resolved_url):
        return Err("invalid-history-proposal")
    if url_kind != "V" and raw_url != "":
        return Err("invalid-history-url-representation")
    if (url_kind == "V" and not _history_text_valid(
            raw_url, BROWSER_RENDERER_HISTORY_MAX_URL_BYTES
        )):
        return Err("invalid-history-url-representation")
    for url in urls:
        if (url == "" or not _history_text_valid(
                url, BROWSER_RENDERER_HISTORY_MAX_URL_BYTES
            )):
            return Err("invalid-history-url")
    var fields = StringBuilder.new()
    fields.push(
        "SBRHJ1\t{action}\t{url_kind}\t{current_index}\t{urls.len()}"
    )
    val raw_field = if url_kind == "V": base64_encode(raw_url) else: "-"
    fields.push("\t")
    fields.push(raw_field)
    fields.push("\t")
    fields.push(base64_encode(resolved_url))
    fields.push("\t")
    fields.push(base64_encode(authority_capability))
    for url in urls:
        fields.push("\t")
        fields.push(base64_encode(url))
    Ok(fields.build())

pub fn browser_renderer_history_proposal_decode(
    wire: text
) -> BrowserRendererHistoryProposal:
    val fields = wire.split("\t")
    if fields.len() < 9 or fields[0] != "SBRHJ1":
        return _history_proposal_reject("malformed-history-proposal")
    val action = fields[1]
    val url_kind = fields[2]
    val current_index = fields[3].to_i64() ?? -1
    val count = fields[4].to_i64() ?? -1
    if (not _history_action_valid(action) or
        not _history_url_kind_valid(action, url_kind) or
        count <= 0 or count > BROWSER_RENDERER_HISTORY_MAX_ENTRIES or
        current_index < 0 or current_index >= count or
        str(current_index) != fields[3] or str(count) != fields[4] or
        fields.len().to_i64() != count + 8):
        return _history_proposal_reject("malformed-history-proposal")
    var raw_url = ""
    if url_kind == "V":
        raw_url = base64_decode(fields[5])
        if (not _history_text_valid(
                raw_url, BROWSER_RENDERER_HISTORY_MAX_URL_BYTES
            ) or base64_encode(raw_url) != fields[5]):
            return _history_proposal_reject(
                "invalid-history-url-representation"
            )
    elif fields[5] != "-":
        return _history_proposal_reject(
            "invalid-history-url-representation"
        )
    val resolved_url = base64_decode(fields[6])
    val authority_capability = base64_decode(fields[7])
    if (resolved_url == "" or authority_capability == "" or
        not _history_text_valid(
            resolved_url, BROWSER_RENDERER_HISTORY_MAX_URL_BYTES
        ) or not _history_text_valid(
            authority_capability, BROWSER_RENDERER_HISTORY_MAX_CAPABILITY_BYTES
        ) or base64_encode(resolved_url) != fields[6] or
        base64_encode(authority_capability) != fields[7]):
        return _history_proposal_reject("invalid-history-proposal")
    var urls: [text] = []
    var field_index: i64 = 8
    while field_index < fields.len().to_i64():
        val url = base64_decode(fields[field_index])
        if (url == "" or not _history_text_valid(
                url, BROWSER_RENDERER_HISTORY_MAX_URL_BYTES
            ) or base64_encode(url) != fields[field_index]):
            return _history_proposal_reject("invalid-history-url")
        urls.push(url)
        field_index = field_index + 1
    if urls[current_index] != resolved_url:
        return _history_proposal_reject("history-index-url-mismatch")
    BrowserRendererHistoryProposal(
        ok: true,
        reason: "ok",
        action: action,
        url_kind: url_kind,
        raw_url: raw_url,
        resolved_url: resolved_url,
        authority_capability: authority_capability,
        current_index: current_index,
        urls: urls
    )
