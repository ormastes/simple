pub fn is_ip_host_literal(host: text) -> bool:
    if host.contains(":"):
        return true
    val hlen = host.byte_len()
    var numeric_address = hlen > 0
    var index = 0
    while index < hlen:
        val code = (host.byte_at(index) as i64)
        if (code < 48 or code > 57) and code != 46:
            numeric_address = false
        index = index + 1
    if numeric_address:
        return true
    val lowered = host.lower()
    val llen = lowered.byte_len()
    if lowered.starts_with("0x") and llen > 2:
        index = 2
        while index < llen:
            val code = (lowered.byte_at(index) as i64)
            val decimal = code >= 48 and code <= 57
            val hex_alpha = code >= 97 and code <= 102
            if not decimal and not hex_alpha:
                return false
            index = index + 1
        return true
    false
