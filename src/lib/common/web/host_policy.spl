pub fn is_ip_host_literal(host: text) -> bool:
    if host.contains(":"):
        return true
    var numeric_address = host.len() > 0
    var index = 0
    while index < host.len():
        val code = host.char_code_at(index)
        if (code < 48 or code > 57) and code != 46:
            numeric_address = false
        index = index + 1
    if numeric_address:
        return true
    val lowered = host.lower()
    if lowered.starts_with("0x") and lowered.len() > 2:
        index = 2
        while index < lowered.len():
            val code = lowered.char_code_at(index)
            val decimal = code >= 48 and code <= 57
            val hex_alpha = code >= 97 and code <= 102
            if not decimal and not hex_alpha:
                return false
            index = index + 1
        return true
    false
