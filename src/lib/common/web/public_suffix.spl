use common.web.public_suffix_data.{
    PUBLIC_SUFFIX_EXACT_RULES,
    PUBLIC_SUFFIX_WILDCARD_BASES,
    PUBLIC_SUFFIX_EXCEPTIONS
}

fn _public_suffix_text_less(left: text, right: text) -> bool:
    val limit = if left.len() < right.len(): left.len() else: right.len()
    var index = 0
    while index < limit:
        val left_code = left.char_code_at(index)
        val right_code = right.char_code_at(index)
        if left_code < right_code:
            return true
        if left_code > right_code:
            return false
        index = index + 1
    left.len() < right.len()

fn _public_suffix_rule_contains(rules: [text], candidate: text) -> bool:
    var low = 0
    var high = rules.len()
    while low < high:
        val middle = low + (high - low) / 2
        val rule = rules[middle]
        if rule == candidate:
            return true
        if _public_suffix_text_less(rule, candidate):
            low = middle + 1
        else:
            high = middle
    false

pub fn is_public_suffix(domain: text) -> bool:
    val candidate = domain.trim().lower()
    if candidate == "" or candidate.starts_with(".") or candidate.ends_with("."):
        return false
    if _public_suffix_rule_contains(PUBLIC_SUFFIX_EXCEPTIONS, candidate):
        return false
    if _public_suffix_rule_contains(PUBLIC_SUFFIX_EXACT_RULES, candidate):
        return true
    val dot = candidate.index_of(".")
    if dot < 0:
        return true
    _public_suffix_rule_contains(
        PUBLIC_SUFFIX_WILDCARD_BASES,
        candidate.substring(dot + 1, candidate.len())
    )

fn _valid_domain_name(domain: text) -> bool:
    if domain == "" or domain.len() > 253 or domain.starts_with(".") or domain.ends_with("."):
        return false
    var label_start = true
    var label_length = 0
    var previous = 0
    var index = 0
    while index < domain.len():
        val code = domain.char_code_at(index)
        if code == 46:
            if label_start or previous == 45:
                return false
            label_start = true
            label_length = 0
        else:
            val ascii = (code >= 97 and code <= 122) or (code >= 48 and code <= 57) or code == 45
            if (not ascii and code < 128) or (label_start and code == 45):
                return false
            label_start = false
            label_length = label_length + 1
            if label_length > 63:
                return false
        previous = code
        index = index + 1
    return previous != 45

pub fn registrable_domain(host: text) -> text:
    """Return the PSL registrable domain (eTLD+1), or empty when unusable."""
    var suffix = host.trim().lower()
    if not _valid_domain_name(suffix):
        return ""
    var previous = ""
    while true:
        # An exception rule itself is the registrable boundary, including when
        # reached after stripping subdomains (for example !city.kawasaki.jp).
        if _public_suffix_rule_contains(PUBLIC_SUFFIX_EXCEPTIONS, suffix):
            return suffix
        if is_public_suffix(suffix):
            return previous
        previous = suffix
        val dot = suffix.index_of(".")
        if dot < 0:
            return ""
        suffix = suffix.substring(dot + 1, suffix.len())
