use common.web.public_suffix_data.{
    PUBLIC_SUFFIX_EXACT_RULES,
    PUBLIC_SUFFIX_WILDCARD_BASES,
    PUBLIC_SUFFIX_EXCEPTIONS
}

fn _public_suffix_text_less(left: text, right: text) -> bool:
    val limit = if left.len() < right.len(): left.len() else: right.len()
    var index = 0
    while index < limit:
        val left_code = left.char_code_at(index)
        val right_code = right.char_code_at(index)
        if left_code < right_code:
            return true
        if left_code > right_code:
            return false
        index = index + 1
    left.len() < right.len()

fn _public_suffix_rule_contains(rules: [text], candidate: text) -> bool:
    var low = 0
    var high = rules.len()
    while low < high:
        val middle = low + (high - low) / 2
        val rule = rules[middle]
        if rule == candidate:
            return true
        if _public_suffix_text_less(rule, candidate):
            low = middle + 1
        else:
            high = middle
    false

pub fn is_public_suffix(domain: text) -> bool:
    val candidate = domain.trim().lower()
    if candidate == "" or candidate.starts_with(".") or candidate.ends_with("."):
        return false
    if _public_suffix_rule_contains(PUBLIC_SUFFIX_EXCEPTIONS, candidate):
        return false
    if _public_suffix_rule_contains(PUBLIC_SUFFIX_EXACT_RULES, candidate):
        return true
    val dot = candidate.index_of(".")
    if dot < 0:
        return true
    _public_suffix_rule_contains(
        PUBLIC_SUFFIX_WILDCARD_BASES,
        candidate.substring(dot + 1, candidate.len())
    )
