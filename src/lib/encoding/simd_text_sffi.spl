# SIMD Text SFFI — thin wrappers over runtime SIMD-accelerated text operations.
#
# Provides: rt_text_count_codepoints_cached, rt_text_is_ascii,
#           rt_text_validate_utf8, rt_simd_str_search,
#           rt_text_to_upper_ascii, rt_text_to_lower_ascii.

@unsafe(reason: "raw SIMD text cache ABI", capabilities: [ffi])
extern fn rt_text_count_codepoints_cached(s: text) -> i64
@unsafe(reason: "raw SIMD text predicate ABI", capabilities: [ffi])
extern fn rt_text_is_ascii(s: text) -> bool
@unsafe(reason: "raw SIMD UTF-8 predicate ABI", capabilities: [ffi])
extern fn rt_text_validate_utf8(s: text) -> bool
@unsafe(reason: "raw SIMD text search ABI; negative result is not found", capabilities: [ffi])
extern fn rt_simd_str_search(haystack: text, needle: text) -> i64
@unsafe(reason: "raw SIMD text conversion returns runtime-owned text", capabilities: [ffi])
extern fn rt_text_to_upper_ascii(s: text) -> text
@unsafe(reason: "raw SIMD text conversion returns runtime-owned text", capabilities: [ffi])
extern fn rt_text_to_lower_ascii(s: text) -> text

export rt_text_count_codepoints_cached, rt_text_is_ascii, rt_text_validate_utf8, rt_simd_str_search, rt_text_to_upper_ascii, rt_text_to_lower_ascii
