# HAMT Node Operations
#
# Hash Array Mapped Trie (HAMT) - a persistent, immutable hash map structure
# using 32-way branching with bitmap compression. Based on Bagwell (2001)
# and Clojure's PersistentHashMap.
#
# Node representation (HamtNode<K, V> enum):
#   EMPTY     = None
#   Leaf      = (hash, key, value)
#   Branch    = (bitmap, children)  - children are the occupied slots only,
#                                     ordered by bit position
#   Collision = (hash, entries)     - [(key, value)] pairs sharing one hash
#
# All operations return NEW nodes (structural sharing). The original tree
# is never modified.

# ============================================================================
# Constants - Node type tags
# ============================================================================

pub val HAMT_LEAF = 1
pub val HAMT_BRANCH = 2
pub val HAMT_COLLISION = 3

# Branching factor: 32 (5 bits per level)
pub val HAMT_BITS = 5
pub val HAMT_WIDTH = 32
pub val HAMT_MASK_VAL = 31

# Maximum trie depth for 64-bit hashes: ceil(64 / 5) = 13
pub val HAMT_MAX_DEPTH = 13

# Bit mask for the 32-bit branch child occupancy bitmap (unsigned within signed i64)
val HAMT_BITMAP_MASK = 0xFFFFFFFF

# ============================================================================
# Node Type
# ============================================================================

pub enum HamtNode<K, V>:
    Leaf(hash: i64, key: K, value: V)
    Branch(bitmap: i64, children: [HamtNode<K, V>])
    Collision(hash: i64, entries: [(K, V)])

# ============================================================================
# Bit Manipulation Helpers
# ============================================================================

# Count the number of set bits (ones) in a 64-bit integer.
# Uses Brian Kernighan's lowest-set-bit clearing loop.
pub fn hamt_popcount(x: i64) -> i64:
    var v = x
    var count = 0
    while v != 0:
        v = v & (v - 1)
        count = count + 1
    count

# Extract the 5-bit index from the hash at the given shift level.
# shift = 0 for level 0, 5 for level 1, 10 for level 2, etc.
# @tag(hash=hash, shift=shift)
pub fn hamt_mask(hash: i64, shift: i64) -> i64:
    (hash >> shift) & HAMT_MASK_VAL

# Compute the single-bit position for the given hash at the given shift.
# Returns a 32-bit unsigned value (within non-negative i64) with one bit set.
# @tag(hash=hash, shift=shift)
pub fn hamt_bit_pos(hash: i64, shift: i64) -> i64:
    (1 << hamt_mask(hash, shift)) & HAMT_BITMAP_MASK

# Compute the array index within the compressed children slice.
# Counts how many children exist below the target bit position.
# @tag(bitmap=bitmap, bit=bit)
pub fn hamt_index(bitmap: i64, bit: i64) -> i64:
    val clean_bitmap = bitmap & HAMT_BITMAP_MASK
    val clean_bit = bit & HAMT_BITMAP_MASK
    hamt_popcount(clean_bitmap & (clean_bit - 1))

# ============================================================================
# Node Constructors
# ============================================================================

# Return an empty HAMT node.
pub fn hamt_empty<K, V>() -> HamtNode<K, V>?:
    None

# Create a leaf node.
pub fn hamt_leaf<K, V>(hash: i64, key: K, value: V) -> HamtNode<K, V>:
    HamtNode.Leaf(hash: hash, key: key, value: value)

# Create a branch node from an occupancy bitmap and its occupied children.
pub fn hamt_branch<K, V>(bitmap: i64, children: [HamtNode<K, V>]) -> HamtNode<K, V>:
    HamtNode.Branch(bitmap: bitmap & HAMT_BITMAP_MASK, children: children)

# Create a collision node from (key, value) pairs sharing one hash.
@allow(primitive_api)  # hash is the raw 64-bit key hash
pub fn hamt_collision<K, V>(hash: i64, entries: [(K, V)]) -> HamtNode<K, V>:
    HamtNode.Collision(hash: hash, entries: entries)

# ============================================================================
# Node Type Inspection
# ============================================================================

# Get the tag of a node. Returns 0 for None (empty).
pub fn hamt_node_tag<K, V>(node: HamtNode<K, V>?) -> i64:
    if node == None:
        return 0
    match node:
        case Leaf(h, k, v): HAMT_LEAF
        case Branch(b, c): HAMT_BRANCH
        case Collision(h, e): HAMT_COLLISION

# Extract the 32-bit child bitmap from a branch node (0 for other nodes).
@allow(primitive_api)  # bitmap is the raw 32-bit child occupancy mask
pub fn hamt_branch_bitmap<K, V>(node: HamtNode<K, V>?) -> i64:
    if node == None:
        return 0
    match node:
        case Branch(b, c): b
        case Leaf(h, k, v): 0
        case Collision(h, e): 0

# ============================================================================
# Core Operations
# ============================================================================

# Look up a key in the HAMT.
# Returns the associated value, or None if the key is not present.
pub fn hamt_get<K, V>(node: HamtNode<K, V>?, key: K, hash: i64, shift: i64) -> V?:
    if node == None:
        return None
    match node:
        case Leaf(h, k, v):
            if k == key:
                return v
            return None
        case Branch(bitmap, children):
            val bit = hamt_bit_pos(hash, shift)
            if (bitmap & bit) == 0:
                return None
            val idx = hamt_index(bitmap, bit)
            return hamt_get(children[idx], key, hash, shift + HAMT_BITS)
        case Collision(h, entries):
            for pair in entries:
                if pair.0 == key:
                    return pair.1
            return None

# Insert or update a key-value pair in the HAMT.
# Returns a NEW node (structural sharing with the original).
@allow(primitive_api)  # shift is a raw HAMT bit offset, like hamt_mask
pub fn hamt_set<K, V>(node: HamtNode<K, V>?, key: K, value: V, hash: i64, shift: i64) -> HamtNode<K, V>:
    if node == None:
        return hamt_leaf(hash, key, value)
    match node:
        case Leaf(existing_hash, existing_key, existing_value):
            if existing_key == key:
                if existing_value == value:
                    return node
                return hamt_leaf(hash, key, value)
            if existing_hash == hash:
                return HamtNode.Collision(hash: hash, entries: [(existing_key, existing_value), (key, value)])
            return hamt_create_branch(existing_key, existing_value, existing_hash, key, value, hash, shift)
        case Branch(bitmap, children):
            val bit = hamt_bit_pos(hash, shift)
            val idx = hamt_index(bitmap, bit)
            if (bitmap & bit) == 0:
                val new_leaf = hamt_leaf(hash, key, value)
                val new_bitmap = (bitmap | bit) & HAMT_BITMAP_MASK
                return HamtNode.Branch(bitmap: new_bitmap, children: hamt_array_insert(children, idx, new_leaf))
            val child = children[idx]
            val new_child = hamt_set(child, key, value, hash, shift + HAMT_BITS)
            if new_child == child:
                return node
            return HamtNode.Branch(bitmap: bitmap, children: hamt_array_replace(children, idx, new_child))
        case Collision(col_hash, entries):
            if col_hash == hash:
                return hamt_collision_set(col_hash, entries, key, value, node)
            val new_branch = hamt_promote_collision(node, col_hash, shift)
            return hamt_set(new_branch, key, value, hash, shift)

# Remove a key from the HAMT.
# Returns Some(new_node) with the key removed, or None if the tree becomes empty.
@allow(primitive_api)  # hash and shift are raw HAMT hash bits and bit offset
pub fn hamt_remove<K, V>(node: HamtNode<K, V>?, key: K, hash: i64, shift: i64) -> HamtNode<K, V>?:
    val updated = _hamt_remove_raw(node, key, hash, shift)
    if val remaining = updated:
        return Some(remaining)
    None

fn _hamt_remove_raw<K, V>(node: HamtNode<K, V>?, key: K, hash: i64, shift: i64) -> HamtNode<K, V>?:
    if node == None:
        return None
    match node:
        case Leaf(h, k, v):
            if k == key:
                return None
            return node
        case Branch(bitmap, children):
            val bit = hamt_bit_pos(hash, shift)
            if (bitmap & bit) == 0:
                return node
            val idx = hamt_index(bitmap, bit)
            val child = children[idx]
            val new_child = _hamt_remove_raw(child, key, hash, shift + HAMT_BITS)
            if new_child == child:
                return node
            if new_child == None:
                val new_bitmap = (bitmap ^ bit) & HAMT_BITMAP_MASK
                if new_bitmap == 0:
                    return None
                if children.len() == 2:
                    val sole = if idx == 0: children[1] else: children[0]
                    val sole_tag = hamt_node_tag(sole)
                    if sole_tag == HAMT_LEAF:
                        return sole
                    if sole_tag == HAMT_COLLISION:
                        return sole
                return HamtNode.Branch(bitmap: new_bitmap, children: hamt_array_remove(children, idx))
            if children.len() == 1:
                val child_tag = hamt_node_tag(new_child)
                if child_tag == HAMT_LEAF:
                    return new_child
                if child_tag == HAMT_COLLISION:
                    return new_child
            return HamtNode.Branch(bitmap: bitmap, children: hamt_array_replace(children, idx, new_child))
        case Collision(col_hash, entries):
            return hamt_collision_remove(col_hash, entries, key, node)

# ============================================================================
# Internal Helpers
# ============================================================================

# Insert or replace a key-value pair inside a collision node's entries.
fn hamt_collision_set<K, V>(col_hash: i64, entries: [(K, V)], key: K, value: V, node: HamtNode<K, V>) -> HamtNode<K, V>:
    var updated: [(K, V)] = []
    var found = false
    for pair in entries:
        if pair.0 == key:
            if pair.1 == value:
                return node
            updated.push((key, value))
            found = true
        else:
            updated.push(pair)
    if not found:
        updated.push((key, value))
    HamtNode.Collision(hash: col_hash, entries: updated)

# Remove a key from a collision node, collapsing to a leaf when 1 entry remains.
# Returns None when the node becomes empty.
fn hamt_collision_remove<K, V>(col_hash: i64, entries: [(K, V)], key: K, node: HamtNode<K, V>) -> HamtNode<K, V>?:
    var kept: [(K, V)] = []
    var found = false
    for pair in entries:
        if pair.0 == key:
            found = true
        else:
            kept.push(pair)
    if not found:
        return node
    if kept.len() == 0:
        return None
    if kept.len() == 1:
        return hamt_leaf(col_hash, kept[0].0, kept[0].1)
    HamtNode.Collision(hash: col_hash, entries: kept)

# Create a branch node from two leaf entries that have different hashes.
# Recursively descends if both entries map to the same 5-bit slot.
fn hamt_create_branch<K, V>(key1: K, value1: V, hash1: i64, key2: K, value2: V, hash2: i64, shift: i64) -> HamtNode<K, V>:
    if shift >= (HAMT_MAX_DEPTH * HAMT_BITS):
        return HamtNode.Collision(hash: hash1, entries: [(key1, value1), (key2, value2)])

    val mask1 = hamt_mask(hash1, shift)
    val mask2 = hamt_mask(hash2, shift)

    if mask1 == mask2:
        val child = hamt_create_branch(key1, value1, hash1, key2, value2, hash2, shift + HAMT_BITS)
        val bit = (1 << mask1) & HAMT_BITMAP_MASK
        return HamtNode.Branch(bitmap: bit, children: [child])

    val bit1 = (1 << mask1) & HAMT_BITMAP_MASK
    val bit2 = (1 << mask2) & HAMT_BITMAP_MASK
    val bitmap = (bit1 | bit2) & HAMT_BITMAP_MASK
    val leaf1 = hamt_leaf(hash1, key1, value1)
    val leaf2 = hamt_leaf(hash2, key2, value2)

    if mask1 < mask2:
        return HamtNode.Branch(bitmap: bitmap, children: [leaf1, leaf2])
    HamtNode.Branch(bitmap: bitmap, children: [leaf2, leaf1])

# Promote a collision node into a branch node at the given shift level.
fn hamt_promote_collision<K, V>(collision_node: HamtNode<K, V>, col_hash: i64, shift: i64) -> HamtNode<K, V>:
    val bit = hamt_bit_pos(col_hash, shift)
    HamtNode.Branch(bitmap: bit, children: [collision_node])

# Insert a node into a children array at the given index, returning a new array.
fn hamt_array_insert<K, V>(arr: [HamtNode<K, V>], idx: i64, value: HamtNode<K, V>) -> [HamtNode<K, V>]:
    var result: [HamtNode<K, V>] = []
    var i = 0
    var inserted = false
    for item in arr:
        if i == idx:
            result.push(value)
            inserted = true
        result.push(item)
        i = i + 1
    if not inserted:
        result.push(value)
    result

# Replace a node in a children array at the given index, returning a new array.
fn hamt_array_replace<K, V>(arr: [HamtNode<K, V>], idx: i64, value: HamtNode<K, V>) -> [HamtNode<K, V>]:
    var result: [HamtNode<K, V>] = []
    var i = 0
    for item in arr:
        if i == idx:
            result.push(value)
        else:
            result.push(item)
        i = i + 1
    result

# Remove a node from a children array at the given index, returning a new array.
fn hamt_array_remove<K, V>(arr: [HamtNode<K, V>], idx: i64) -> [HamtNode<K, V>]:
    var result: [HamtNode<K, V>] = []
    var i = 0
    for item in arr:
        if i != idx:
            result.push(item)
        i = i + 1
    result

# ============================================================================
# Traversal
# ============================================================================

# Collect all (key, value) pairs from the HAMT into a flat array.
pub fn hamt_node_entries<K, V>(node: HamtNode<K, V>?) -> [(K, V)]:
    var empty: [(K, V)] = []
    hamt_collect_entries_into(node, empty)

fn hamt_collect_entries_into<K, V>(node: HamtNode<K, V>?, acc_in: [(K, V)]) -> [(K, V)]:
    var acc = acc_in
    if node == None:
        return acc
    match node:
        case Leaf(h, k, v):
            acc.push((k, v))
            return acc
        case Branch(bitmap, children):
            for child in children:
                acc = hamt_collect_entries_into(child, acc)
            return acc
        case Collision(h, entries):
            for pair in entries:
                acc.push(pair)
            return acc

# Count the total number of entries in the HAMT.
pub fn hamt_node_count<K, V>(node: HamtNode<K, V>?) -> i64:
    if node == None:
        return 0
    match node:
        case Leaf(h, k, v):
            return 1
        case Branch(bitmap, children):
            var total = 0
            for child in children:
                total = total + hamt_node_count(child)
            return total
        case Collision(h, entries):
            return entries.len()
