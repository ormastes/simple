# HAMT Node Operations
#
# Hash Array Mapped Trie (HAMT) — a persistent, immutable hash map structure
# using 32-way branching with bitmap compression. Based on Bagwell (2001)
# and Clojure's PersistentHashMap.
#
# Compact node representation (tag-packed flat arrays for minimal heap overhead):
#   EMPTY     = nil
#   LEAF      = [1, hash, key, value]
#   BRANCH    = [(bitmap << 3) | 2, child_0, ..., child_{k-1}]
#   COLLISION = [3, hash, k_0, v_0, k_1, v_1, ...]
#
# Packing the 32-bit bitmap and 3-bit tag into the header word of a single flat
# branch array cuts branch heap allocations by 50% and removes one pointer
# indirection on every lookup, insert, and remove. Flattening collision nodes
# eliminates N + 1 inner pair arrays.
#
# All operations return NEW nodes (structural sharing). The original tree
# is never modified.

# ============================================================================
# Constants — Node type tags
# ============================================================================

pub val HAMT_LEAF = 1
pub val HAMT_BRANCH = 2
pub val HAMT_COLLISION = 3

# Branching factor: 32 (5 bits per level)
pub val HAMT_BITS = 5
pub val HAMT_WIDTH = 32
pub val HAMT_MASK_VAL = 31

# Maximum trie depth for 64-bit hashes: ceil(64 / 5) = 13
pub val HAMT_MAX_DEPTH = 13

# Internal bit masks for packed header word:
#   bits 0..2: node tag (0=empty, 1=leaf, 2=branch, 3=collision)
#   bits 3..34: 32-bit branch child occupancy bitmap (unsigned within signed i64)
val HAMT_TAG_MASK = 7
val HAMT_BITMAP_MASK = 0xFFFFFFFF

# ============================================================================
# Bit Manipulation Helpers
# ============================================================================

# Count the number of set bits (ones) in a 64-bit integer.
# Uses Brian Kernighan's lowest-set-bit clearing loop.
pub fn hamt_popcount(x: i64) -> i64:
    var v = x
    var count = 0
    while v != 0:
        v = v & (v - 1)
        count = count + 1
    count

# Extract the 5-bit index from the hash at the given shift level.
# shift = 0 for level 0, 5 for level 1, 10 for level 2, etc.
# @tag(hash=hash, shift=shift)
pub fn hamt_mask(hash: i64, shift: i64) -> i64:
    (hash >> shift) & HAMT_MASK_VAL

# Compute the single-bit position for the given hash at the given shift.
# Returns a 32-bit unsigned value (within non-negative i64) with one bit set.
# @tag(hash=hash, shift=shift)
pub fn hamt_bit_pos(hash: i64, shift: i64) -> i64:
    (1 << hamt_mask(hash, shift)) & HAMT_BITMAP_MASK

# Compute the array index within the compressed children slice.
# Counts how many children exist below the target bit position.
# @tag(bitmap=bitmap, bit=bit)
pub fn hamt_index(bitmap: i64, bit: i64) -> i64:
    val clean_bitmap = bitmap & HAMT_BITMAP_MASK
    val clean_bit = bit & HAMT_BITMAP_MASK
    hamt_popcount(clean_bitmap & (clean_bit - 1))

fn hamt_pack_branch_header(bitmap: i64) -> i64:
    ((bitmap & HAMT_BITMAP_MASK) << 3) | HAMT_BRANCH

fn hamt_unpack_branch_bitmap(header: i64) -> i64:
    (header >> 3) & HAMT_BITMAP_MASK

# ============================================================================
# Node Constructors
# ============================================================================

# Return an empty HAMT node (represented as nil).
pub fn hamt_empty():
    nil

# Create a leaf node: [HAMT_LEAF, hash, key, value].
pub fn hamt_leaf(hash: i64, key, value) -> []:
    [HAMT_LEAF, hash, key, value]

# Create a flat branch node: [(bitmap << 3) | HAMT_BRANCH, child_0, ...].
pub fn hamt_branch(bitmap: i64, children) -> []:
    var node = [hamt_pack_branch_header(bitmap)]
    for child in children:
        node.push(child)
    node

# Create a flat collision node: [HAMT_COLLISION, hash, k_0, v_0, k_1, v_1, ...].
# Accepts `entries` as [[k, v], ...] pairs for API compatibility and flattens them.
pub fn hamt_collision(hash: i64, entries) -> []:
    var node = [HAMT_COLLISION, hash]
    for pair in entries:
        node.push(pair[0])
        node.push(pair[1])
    node

# ============================================================================
# Node Type Inspection
# ============================================================================

# Get the tag of a node. Returns 0 for nil (empty).
pub fn hamt_node_tag(node) -> i64:
    if node == nil:
        return 0
    node[0] & HAMT_TAG_MASK

# Extract the 32-bit child bitmap from a packed branch node.
fn hamt_branch_bitmap(node) -> i64:
    hamt_unpack_branch_bitmap(node[0])

# ============================================================================
# Core Operations
# ============================================================================

# Look up a key in the HAMT.
# Returns the associated value, or nil if the key is not present.
pub fn hamt_get<K, V>(node: [], key: K, hash: i64, shift: i64) -> V?:
    if node == nil:
        return nil

    val header = node[0]
    val tag = header & HAMT_TAG_MASK

    if tag == HAMT_LEAF:
        if node[2] == key:
            return node[3]
        return nil

    if tag == HAMT_BRANCH:
        val bitmap = (header >> 3) & HAMT_BITMAP_MASK
        val bit = hamt_bit_pos(hash, shift)
        if (bitmap & bit) == 0:
            return nil
        val idx = hamt_index(bitmap, bit)
        return hamt_get(node[1 + idx], key, hash, shift + HAMT_BITS)

    if tag == HAMT_COLLISION:
        val n = hamt_array_len(node)
        var i = 2
        while i < n:
            if node[i] == key:
                return node[i + 1]
            i = i + 2
        return nil

    nil

# Insert or update a key-value pair in the HAMT.
# Returns a NEW node (structural sharing with the original).
pub fn hamt_set(node, key, value, hash, shift) -> []:
    if node == nil:
        return hamt_leaf(hash, key, value)

    val header = node[0]
    val tag = header & HAMT_TAG_MASK

    if tag == HAMT_LEAF:
        val existing_hash = node[1]
        val existing_key = node[2]
        val existing_value = node[3]

        if existing_key == key:
            if existing_value == value:
                return node
            return hamt_leaf(hash, key, value)

        if existing_hash == hash:
            return [HAMT_COLLISION, hash, existing_key, existing_value, key, value]

        return hamt_create_branch(existing_key, existing_value, existing_hash, key, value, hash, shift)

    if tag == HAMT_BRANCH:
        val bitmap = (header >> 3) & HAMT_BITMAP_MASK
        val bit = hamt_bit_pos(hash, shift)
        val idx = hamt_index(bitmap, bit)

        if (bitmap & bit) == 0:
            val new_leaf = hamt_leaf(hash, key, value)
            val new_bitmap = (bitmap | bit) & HAMT_BITMAP_MASK
            return hamt_branch_insert(node, new_bitmap, idx, new_leaf)

        val child = node[1 + idx]
        val new_child = hamt_set(child, key, value, hash, shift + HAMT_BITS)
        if new_child == child:
            return node
        return hamt_branch_replace(node, bitmap, idx, new_child)

    if tag == HAMT_COLLISION:
        val col_hash = node[1]
        if col_hash == hash:
            return hamt_collision_flat_set(node, hash, key, value)

        val new_branch = hamt_promote_collision(node, shift)
        return hamt_set(new_branch, key, value, hash, shift)

    hamt_leaf(hash, key, value)

# Remove a key from the HAMT.
# Returns a NEW node with the key removed. Returns nil if the tree becomes empty.
pub fn hamt_remove(node, key, hash, shift):
    if node == nil:
        return nil

    val header = node[0]
    val tag = header & HAMT_TAG_MASK

    if tag == HAMT_LEAF:
        if node[2] == key:
            return nil
        return node

    if tag == HAMT_BRANCH:
        val bitmap = (header >> 3) & HAMT_BITMAP_MASK
        val bit = hamt_bit_pos(hash, shift)

        if (bitmap & bit) == 0:
            return node

        val idx = hamt_index(bitmap, bit)
        val child = node[1 + idx]
        val new_child = hamt_remove(child, key, hash, shift + HAMT_BITS)

        if new_child == child:
            return node

        if new_child == nil:
            val new_bitmap = (bitmap ^ bit) & HAMT_BITMAP_MASK
            if new_bitmap == 0:
                return nil
            val old_child_count = hamt_array_len(node) - 1
            if old_child_count == 2:
                val sole = if idx == 0: node[2] else: node[1]
                val sole_tag = hamt_node_tag(sole)
                if sole_tag == HAMT_LEAF:
                    return sole
                if sole_tag == HAMT_COLLISION:
                    return sole
            return hamt_branch_remove(node, new_bitmap, idx)

        if (hamt_array_len(node) - 1) == 1:
            val child_tag = hamt_node_tag(new_child)
            if child_tag == HAMT_LEAF:
                return new_child
            if child_tag == HAMT_COLLISION:
                return new_child

        return hamt_branch_replace(node, bitmap, idx, new_child)

    if tag == HAMT_COLLISION:
        return hamt_collision_flat_remove(node, key)

    node

# ============================================================================
# Internal Helpers
# ============================================================================

# Insert or replace a key-value pair directly inside a flat collision node
# [HAMT_COLLISION, hash, k_0, v_0, ...].
fn hamt_collision_flat_set(node, hash: i64, key, value) -> []:
    val n = hamt_array_len(node)
    var i = 2
    while i < n:
        if node[i] == key:
            if node[i + 1] == value:
                return node
            var updated = [HAMT_COLLISION, hash]
            var j = 2
            while j < n:
                if j == i:
                    updated.push(key)
                    updated.push(value)
                else:
                    updated.push(node[j])
                    updated.push(node[j + 1])
                j = j + 2
            return updated
        i = i + 2

    var appended = [HAMT_COLLISION, hash]
    var k = 2
    while k < n:
        appended.push(node[k])
        k = k + 1
    appended.push(key)
    appended.push(value)
    appended

# Remove a key from a flat collision node, collapsing to a leaf when 1 entry remains.
fn hamt_collision_flat_remove(node, key):
    val n = hamt_array_len(node)
    var found_idx = -1
    var i = 2
    while i < n:
        if node[i] == key:
            found_idx = i
            break
        i = i + 2

    if found_idx < 0:
        return node

    val pair_count = (n - 2) / 2
    val new_pair_count = pair_count - 1
    if new_pair_count <= 0:
        return nil

    val col_hash = node[1]
    if new_pair_count == 1:
        val rem_idx = if found_idx == 2: 4 else: 2
        return hamt_leaf(col_hash, node[rem_idx], node[rem_idx + 1])

    var result = [HAMT_COLLISION, col_hash]
    var j = 2
    while j < n:
        if j != found_idx:
            result.push(node[j])
            result.push(node[j + 1])
        j = j + 2
    result

# Create a flat branch node with `value` inserted at child position `idx`.
fn hamt_branch_insert(node, new_bitmap: i64, idx: i64, value) -> []:
    var result = [hamt_pack_branch_header(new_bitmap)]
    val n = hamt_array_len(node)
    var child_i = 0
    var inserted = false
    var pos = 1
    while pos < n:
        if child_i == idx:
            result.push(value)
            inserted = true
        result.push(node[pos])
        child_i = child_i + 1
        pos = pos + 1
    if not inserted:
        result.push(value)
    result

# Create a flat branch node with child position `idx` replaced by `value`.
fn hamt_branch_replace(node, bitmap: i64, idx: i64, value) -> []:
    var result = [hamt_pack_branch_header(bitmap)]
    val n = hamt_array_len(node)
    var child_i = 0
    var pos = 1
    while pos < n:
        if child_i == idx:
            result.push(value)
        else:
            result.push(node[pos])
        child_i = child_i + 1
        pos = pos + 1
    result

# Create a flat branch node with child position `idx` removed.
fn hamt_branch_remove(node, new_bitmap: i64, idx: i64) -> []:
    var result = [hamt_pack_branch_header(new_bitmap)]
    val n = hamt_array_len(node)
    var child_i = 0
    var pos = 1
    while pos < n:
        if child_i != idx:
            result.push(node[pos])
        child_i = child_i + 1
        pos = pos + 1
    result

# Create a branch node from two leaf entries that have different hashes.
# Recursively descends if both entries map to the same 5-bit slot.
fn hamt_create_branch(key1, value1, hash1, key2, value2, hash2, shift) -> []:
    if shift >= (HAMT_MAX_DEPTH * HAMT_BITS):
        return [HAMT_COLLISION, hash1, key1, value1, key2, value2]

    val mask1 = hamt_mask(hash1, shift)
    val mask2 = hamt_mask(hash2, shift)

    if mask1 == mask2:
        val child = hamt_create_branch(key1, value1, hash1, key2, value2, hash2, shift + HAMT_BITS)
        val bit = (1 << mask1) & HAMT_BITMAP_MASK
        return [hamt_pack_branch_header(bit), child]

    val bit1 = (1 << mask1) & HAMT_BITMAP_MASK
    val bit2 = (1 << mask2) & HAMT_BITMAP_MASK
    val bitmap = (bit1 | bit2) & HAMT_BITMAP_MASK
    val leaf1 = hamt_leaf(hash1, key1, value1)
    val leaf2 = hamt_leaf(hash2, key2, value2)

    if mask1 < mask2:
        return [hamt_pack_branch_header(bitmap), leaf1, leaf2]
    return [hamt_pack_branch_header(bitmap), leaf2, leaf1]

# Promote a collision node into a branch node at the given shift level.
fn hamt_promote_collision(collision_node, shift) -> []:
    val col_hash = collision_node[1]
    val bit = hamt_bit_pos(col_hash, shift)
    [hamt_pack_branch_header(bit), collision_node]

# Count array entries without using facade-sensitive `.len()` dispatch.
fn hamt_array_len(arr) -> i64:
    var count = 0
    for item in arr:
        count = count + 1
    count

# Insert a value into an array at the given index, returning a new array.
fn hamt_array_insert(arr, idx: i64, value) -> []:
    var result = []
    var i = 0
    var inserted = false
    for item in arr:
        if i == idx:
            result.push(value)
            inserted = true
        result.push(item)
        i = i + 1
    if not inserted:
        result.push(value)
    result

# Replace a value in an array at the given index, returning a new array.
fn hamt_array_replace(arr, idx: i64, value) -> []:
    var result = []
    var i = 0
    for item in arr:
        if i == idx:
            result.push(value)
        else:
            result.push(item)
        i = i + 1
    result

# Remove an element from an array at the given index, returning a new array.
fn hamt_array_remove(arr, idx: i64) -> []:
    var result = []
    var i = 0
    for item in arr:
        if i != idx:
            result.push(item)
        i = i + 1
    result

# ============================================================================
# Traversal
# ============================================================================

# Collect all [key, value] pairs from the HAMT into a flat array.
# Returns an array of [key, value] arrays.
pub fn hamt_node_entries(node) -> []:
    hamt_collect_entries(node)

# Internal entry collector using a single mutable accumulator across the whole tree.
fn hamt_collect_entries(node) -> []:
    var acc = []
    hamt_collect_entries_into(node, acc)

fn hamt_collect_entries_into(node, acc_in) -> []:
    var acc = acc_in
    if node == nil:
        return acc

    val header = node[0]
    val tag = header & HAMT_TAG_MASK

    if tag == HAMT_LEAF:
        acc.push([node[2], node[3]])
        return acc

    if tag == HAMT_BRANCH:
        val n = hamt_array_len(node)
        var i = 1
        while i < n:
            acc = hamt_collect_entries_into(node[i], acc)
            i = i + 1
        return acc

    if tag == HAMT_COLLISION:
        val n = hamt_array_len(node)
        var i = 2
        while i < n:
            acc.push([node[i], node[i + 1]])
            i = i + 2
        return acc

    acc

# Count the total number of entries in the HAMT.
pub fn hamt_node_count(node) -> i64:
    if node == nil:
        return 0

    val header = node[0]
    val tag = header & HAMT_TAG_MASK

    if tag == HAMT_LEAF:
        return 1

    if tag == HAMT_BRANCH:
        val n = hamt_array_len(node)
        var total = 0
        var i = 1
        while i < n:
            total = total + hamt_node_count(node[i])
            i = i + 1
        return total

    if tag == HAMT_COLLISION:
        return (hamt_array_len(node) - 2) / 2

    0
