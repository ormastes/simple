# Red-Black Tree Node Operations
#
# Persistent (immutable) red-black tree node representation and accessors.
# Every node is an RbNode<K, V> with a color (0 = RED, 1 = BLACK), a key/value
# pair, and optional left/right child subtrees (None = empty).
#
# All operations return NEW nodes via structural sharing - the original
# tree is never modified.
#
# This module provides low-level node primitives. Higher-level insert/delete
# with rebalancing lives in path_copy.spl.

# ============================================================================
export RB_RED
export RB_BLACK
export RbNode
# Constants
# ============================================================================

pub val RB_RED = 0
pub val RB_BLACK = 1

# ============================================================================
# Node Type
# ============================================================================

pub struct RbNode<K, V>:
    color: i64
    key: K
    value: V
    left: RbNode<K, V>?
    right: RbNode<K, V>?

# ============================================================================
# Node Constructor
# ============================================================================

# Create a new red-black tree node.
# color: RB_RED (0) or RB_BLACK (1)
# key, value: the key-value pair stored at this node
# left, right: child subtrees (None = empty)
pub fn rb_node<K, V>(color: i64, key: K, value: V, left: RbNode<K, V>?, right: RbNode<K, V>?) -> RbNode<K, V>:
    RbNode(color: color, key: key, value: value, left: left, right: right)

# ============================================================================
# Field Accessors
# ============================================================================

# Get the color of a node (0 = RED, 1 = BLACK).
pub fn rb_color<K, V>(node: RbNode<K, V>) -> i64:
    node.color

# Get the key stored at this node.
pub fn rb_key<K, V>(node: RbNode<K, V>) -> K:
    node.key

# Get the value stored at this node.
pub fn rb_value<K, V>(node: RbNode<K, V>) -> V:
    node.value

# Get the left child subtree (None if empty).
pub fn rb_left<K, V>(node: RbNode<K, V>) -> RbNode<K, V>?:
    node.left

# Get the right child subtree (None if empty).
pub fn rb_right<K, V>(node: RbNode<K, V>) -> RbNode<K, V>?:
    node.right

# ============================================================================
# Color Predicates
# ============================================================================

# Return true if the node is red. Empty nodes are considered black.
pub fn rb_is_red<K, V>(node: RbNode<K, V>?) -> bool:
    if node == None:
        return false
    node.color == RB_RED

# Return true if the node is black. Empty nodes are considered black.
pub fn rb_is_black<K, V>(node: RbNode<K, V>?) -> bool:
    if node == None:
        return true
    node.color == RB_BLACK

# ============================================================================
# Immutable "Setters" (return new nodes)
# ============================================================================

# Return a new node identical to `node` but with color changed.
pub fn rb_set_color<K, V>(node: RbNode<K, V>, color: i64) -> RbNode<K, V>:
    RbNode(color: color, key: node.key, value: node.value, left: node.left, right: node.right)

# Return a new node identical to `node` but with value changed.
pub fn rb_set_value<K, V>(node: RbNode<K, V>, value: V) -> RbNode<K, V>:
    RbNode(color: node.color, key: node.key, value: value, left: node.left, right: node.right)

# Return a new node identical to `node` but with left child changed.
pub fn rb_set_left<K, V>(node: RbNode<K, V>, left: RbNode<K, V>?) -> RbNode<K, V>:
    RbNode(color: node.color, key: node.key, value: node.value, left: left, right: node.right)

# Return a new node identical to `node` but with right child changed.
pub fn rb_set_right<K, V>(node: RbNode<K, V>, right: RbNode<K, V>?) -> RbNode<K, V>:
    RbNode(color: node.color, key: node.key, value: node.value, left: node.left, right: right)

# ============================================================================
# Lookup Operations
# ============================================================================

# Look up a key in the red-black tree.
# Uses the provided `compare(a, b)` function which returns:
#   negative if a < b, 0 if a == b, positive if a > b
# Returns the value associated with the key, or None if not found.
pub fn rb_get<K, V>(node: RbNode<K, V>?, key: K, compare: fn(K, K) -> i64) -> V?:
    var current = node
    while current != None:
        val cmp = compare(key, current.key)
        if cmp == 0:
            return current.value
        if cmp < 0:
            current = current.left
        else:
            current = current.right
    None

# Check whether a key exists in the tree.
# Returns true if the key is present, false otherwise.
pub fn rb_contains<K, V>(node: RbNode<K, V>?, key: K, compare: fn(K, K) -> i64) -> bool:
    var current = node
    while current != None:
        val cmp = compare(key, current.key)
        if cmp == 0:
            return true
        if cmp < 0:
            current = current.left
        else:
            current = current.right
    false

# ============================================================================
# Min / Max
# ============================================================================

# Find the leftmost (minimum) node in the tree.
# Returns the node itself (not just the key), or None if empty.
pub fn rb_min_node<K, V>(node: RbNode<K, V>?) -> RbNode<K, V>?:
    if node == None:
        return None
    var current = node
    while current.left != None:
        current = current.left
    current

# Find the rightmost (maximum) node in the tree.
# Returns the node itself (not just the key), or None if empty.
pub fn rb_max_node<K, V>(node: RbNode<K, V>?) -> RbNode<K, V>?:
    if node == None:
        return None
    var current = node
    while current.right != None:
        current = current.right
    current

# ============================================================================
# Counting
# ============================================================================

# Count the total number of nodes in the tree.
pub fn rb_count<K, V>(node: RbNode<K, V>?) -> i64:
    if node == None:
        return 0
    1 + rb_count(node.left) + rb_count(node.right)

# ============================================================================
# In-Order Traversal
# ============================================================================

# Collect all (key, value) pairs from the tree in sorted (in-order) order.
pub fn rb_collect_entries<K, V>(node: RbNode<K, V>?) -> [(K, V)]:
    var empty: [(K, V)] = []
    rb_collect_entries_into(node, empty)

fn rb_collect_entries_into<K, V>(node: RbNode<K, V>?, acc_in: [(K, V)]) -> [(K, V)]:
    if node == None:
        return acc_in
    var acc = rb_collect_entries_into(node.left, acc_in)
    acc.push((node.key, node.value))
    rb_collect_entries_into(node.right, acc)

# Collect all (key, value) pairs within a key range [from_key, to_key] inclusive.
# Uses the compare function to determine range boundaries.
# Returns an array of matching pairs in sorted order.
pub fn rb_collect_range<K, V>(node: RbNode<K, V>?, from_key: K, to_key: K, compare: fn(K, K) -> i64) -> [(K, V)]:
    var empty: [(K, V)] = []
    rb_collect_range_into(node, from_key, to_key, compare, empty)

fn rb_collect_range_into<K, V>(node: RbNode<K, V>?, from_key: K, to_key: K, compare: fn(K, K) -> i64, acc_in: [(K, V)]) -> [(K, V)]:
    if node == None:
        return acc_in
    val cmp_from = compare(node.key, from_key)
    val cmp_to = compare(node.key, to_key)
    var acc = acc_in
    # Recurse into left subtree if keys less than from_key might exist
    if cmp_from >= 0:
        acc = rb_collect_range_into(node.left, from_key, to_key, compare, acc)
    # Include this node if it is within the range
    if cmp_from >= 0:
        if cmp_to <= 0:
            acc.push((node.key, node.value))
    # Recurse into right subtree if keys greater than to_key might exist
    if cmp_to <= 0:
        acc = rb_collect_range_into(node.right, from_key, to_key, compare, acc)
    acc

# ============================================================================
# Floor / Ceiling
# ============================================================================

# Find the greatest entry with key <= the given key.
# Returns (key, value) or None if no such entry exists.
pub fn rb_floor<K, V>(node: RbNode<K, V>?, key: K, compare: fn(K, K) -> i64) -> (K, V)?:
    if node == None:
        return None
    val cmp = compare(key, node.key)
    if cmp == 0:
        return (node.key, node.value)
    if cmp < 0:
        # Target is smaller than this node, floor must be in left subtree
        return rb_floor(node.left, key, compare)
    # Target is larger than this node. This node is a candidate,
    # but there might be a closer one in the right subtree.
    val right_result = rb_floor(node.right, key, compare)
    if right_result != None:
        return right_result
    (node.key, node.value)

# Find the smallest entry with key >= the given key.
# Returns (key, value) or None if no such entry exists.
pub fn rb_ceiling<K, V>(node: RbNode<K, V>?, key: K, compare: fn(K, K) -> i64) -> (K, V)?:
    if node == None:
        return None
    val cmp = compare(key, node.key)
    if cmp == 0:
        return (node.key, node.value)
    if cmp > 0:
        # Target is larger than this node, ceiling must be in right subtree
        return rb_ceiling(node.right, key, compare)
    # Target is smaller than this node. This node is a candidate,
    # but there might be a closer one in the left subtree.
    val left_result = rb_ceiling(node.left, key, compare)
    if left_result != None:
        return left_result
    (node.key, node.value)
