# Path-Copying Insert/Delete with LLRB Rebalancing
#
# Left-Leaning Red-Black Tree (LLRB) operations with persistent (immutable)
# path copying. Based on Sedgewick's 2008 simplified red-black tree algorithm.
#
# LLRB invariants:
#   1. No node has two red children (3-nodes lean left)
#   2. Red links lean left (if right child is red and left is black, rotate left)
#   3. No two consecutive red links on any path (if left and left.left are both
#      red, rotate right)
#
# All operations return NEW trees via structural sharing. The original tree
# is never modified.
#
# Insert is O(log n) with at most 2 rotations + 1 color flip per level.
# Delete uses a simplified rebuild approach for correctness.

use std.persistent_sorted_map.rb_node.{RB_RED, RB_BLACK, RbNode, rb_is_red, rb_is_black}

# ============================================================================
# Rotations and Color Flips
# ============================================================================

# Rotate a node left: the right child becomes the new root of this subtree.
# Preserves BST ordering. The new root inherits the old root's color,
# and the old root becomes RED.
#
#     X (color)          R (color)
#    / \         =>     / \
#   a   R (red)        X   c
#      / \            / \
#     b   c          a   b
pub fn rb_rotate_left_llrb<K, V>(node: RbNode<K, V>) -> RbNode<K, V>:
    val right_child = node.right
    # New left node: old root with old root's left and right's left, colored RED
    val new_left = RbNode(color: RB_RED, key: node.key, value: node.value, left: node.left, right: right_child.left)
    # New root: right child with old root's color
    RbNode(color: node.color, key: right_child.key, value: right_child.value, left: new_left, right: right_child.right)

# Rotate a node right: the left child becomes the new root of this subtree.
# Preserves BST ordering. The new root takes the color of the old root,
# and the old root becomes red.
#
#       X (color)       L (color)
#      / \        =>   / \
#     L   c           a   X
#    / \                  / \
#   a   b               b   c
pub fn rb_rotate_right_llrb<K, V>(node: RbNode<K, V>) -> RbNode<K, V>:
    val left_child = node.left
    # New right node: old root with left's right and old root's right, colored RED
    val new_right = RbNode(color: RB_RED, key: node.key, value: node.value, left: left_child.right, right: node.right)
    # New root: left child with old root's color
    RbNode(color: node.color, key: left_child.key, value: left_child.value, left: left_child.left, right: new_right)

# Flip the colors of a node and both its children.
# Used when both children are red (represents a temporary 4-node in 2-3-4 tree
# that needs to be split).
pub fn rb_flip_colors<K, V>(node: RbNode<K, V>) -> RbNode<K, V>:
    val left = node.left
    val right = node.right
    # Flip the node's color
    var new_color = RB_RED
    if node.color == RB_RED:
        new_color = RB_BLACK
    # Flip children's colors
    var new_left_color = RB_RED
    if left.color == RB_RED:
        new_left_color = RB_BLACK
    var new_right_color = RB_RED
    if right.color == RB_RED:
        new_right_color = RB_BLACK
    val new_left = RbNode(color: new_left_color, key: left.key, value: left.value, left: left.left, right: left.right)
    val new_right = RbNode(color: new_right_color, key: right.key, value: right.value, left: right.left, right: right.right)
    RbNode(color: new_color, key: node.key, value: node.value, left: new_left, right: new_right)

# ============================================================================
# LLRB Fix-Up
# ============================================================================

# Apply LLRB invariant fixes after an insertion or deletion:
#   1. Right-leaning red link => rotate left
#   2. Two consecutive left red links => rotate right
#   3. Both children red => flip colors
pub fn rb_fix_up<K, V>(node: RbNode<K, V>?) -> RbNode<K, V>?:
    if node == None:
        return None
    var h = node
    # 1. Right child red, left child black => rotate left
    val right_is_red = rb_is_red(h.right)
    val left_is_black = rb_is_black(h.left)
    if right_is_red:
        if left_is_black:
            h = rb_rotate_left_llrb(h)
    # 2. Left child red AND left.left red => rotate right
    val left = h.left
    if rb_is_red(left):
        if left != None:
            if rb_is_red(left.left):
                h = rb_rotate_right_llrb(h)
    # 3. Both children red => flip colors
    if rb_is_red(h.left):
        if rb_is_red(h.right):
            h = rb_flip_colors(h)
    h

# ============================================================================
# Insert
# ============================================================================

# Insert a key-value pair into the LLRB tree.
# Returns a NEW tree root. The root is always colored black.
#
# Parameters:
#   node    - current tree root (None for empty tree)
#   key     - key to insert
#   value   - value to associate with the key
#   compare - fn(a, b) -> i64 comparison function
pub fn rb_insert<K, V>(node: RbNode<K, V>?, key: K, value: V, compare: fn(K, K) -> i64) -> RbNode<K, V>?:
    val new_root = rb_insert_rec(node, key, value, compare)
    # Root must always be black
    if new_root.color == RB_BLACK:
        return new_root
    RbNode(color: RB_BLACK, key: new_root.key, value: new_root.value, left: new_root.left, right: new_root.right)

# Recursive insert helper. Returns a new subtree with the key inserted.
pub fn rb_insert_rec<K, V>(node: RbNode<K, V>?, key: K, value: V, compare: fn(K, K) -> i64) -> RbNode<K, V>:
    # Base case: empty subtree, create a new red leaf
    if node == None:
        return RbNode(color: RB_RED, key: key, value: value, left: None, right: None)

    val cmp = compare(key, node.key)

    if cmp == 0:
        # Key already exists: update value
        if node.value == value:
            return node
        return RbNode(color: node.color, key: node.key, value: value, left: node.left, right: node.right)

    var new_node = node
    if cmp < 0:
        # Insert into left subtree
        val new_left = rb_insert_rec(node.left, key, value, compare)
        new_node = RbNode(color: node.color, key: node.key, value: node.value, left: new_left, right: node.right)
    else:
        # Insert into right subtree
        val new_right = rb_insert_rec(node.right, key, value, compare)
        new_node = RbNode(color: node.color, key: node.key, value: node.value, left: node.left, right: new_right)

    # Fix up LLRB invariants on the way back up
    rb_fix_up(new_node)

# ============================================================================
# Delete
# ============================================================================

# Remove a key from the tree.
# Returns a NEW tree root with the key removed, or None if the tree becomes empty.
#
# This uses a simplified rebuild approach: collect all entries except the
# target key, then rebuild the tree. This is O(n log n) but is correct and
# simple. A true LLRB delete with move-red-left/move-red-right is complex
# and can be added as an optimization later.
#
# Parameters:
#   node    - current tree root
#   key     - key to remove
#   compare - fn(a, b) -> i64 comparison function
pub fn rb_remove<K, V>(node: RbNode<K, V>?, key: K, compare: fn(K, K) -> i64) -> RbNode<K, V>?:
    if node == None:
        return None
    # Quick check: if the key is not in the tree, return unchanged
    val has_key = rb_has_key(node, key, compare)
    if not has_key:
        return node
    val entries = rb_collect_except(node, key, compare)
    val n = entries.len()
    if n == 0:
        return None
    # Rebuild a balanced tree from the sorted entries
    rb_build_from_sorted(entries, lo: 0, hi: n - 1)

# Check if a key exists in the tree. Iterative for efficiency.
fn rb_has_key<K, V>(node: RbNode<K, V>?, key: K, compare: fn(K, K) -> i64) -> bool:
    var current = node
    while current != None:
        val cmp = compare(key, current.key)
        if cmp == 0:
            return true
        if cmp < 0:
            current = current.left
        else:
            current = current.right
    false

# Collect all (key, value) pairs except the one matching `exclude_key`.
# Returns an array of pairs in sorted (in-order) order.
fn rb_collect_except<K, V>(node: RbNode<K, V>?, exclude_key: K, compare: fn(K, K) -> i64) -> [(K, V)]:
    var empty: [(K, V)] = []
    rb_collect_except_into(node, exclude_key, compare, empty)

fn rb_collect_except_into<K, V>(node: RbNode<K, V>?, exclude_key: K, compare: fn(K, K) -> i64, acc_in: [(K, V)]) -> [(K, V)]:
    if node == None:
        return acc_in
    var acc = rb_collect_except_into(node.left, exclude_key, compare, acc_in)
    val cmp = compare(node.key, exclude_key)
    if cmp != 0:
        acc.push((node.key, node.value))
    rb_collect_except_into(node.right, exclude_key, compare, acc)

# Build a balanced black-height-uniform tree from a sorted array of (key, value) pairs.
# Uses a median-split approach to create a perfectly balanced BST, then colors it
# as a valid red-black tree (all black nodes for simplicity - valid RB tree).
# @tag(lo=range_start, hi=range_end)
pub fn rb_build_from_sorted<K, V>(entries: [(K, V)], lo: i64, hi: i64) -> RbNode<K, V>?:
    if lo > hi:
        return None
    if lo == hi:
        val pair = entries[lo]
        return RbNode(color: RB_BLACK, key: pair.0, value: pair.1, left: None, right: None)
    val mid = lo + ((hi - lo) / 2)
    val pair = entries[mid]
    val left = rb_build_from_sorted(entries, lo: lo, hi: mid - 1)
    val right = rb_build_from_sorted(entries, lo: mid + 1, hi: hi)
    RbNode(color: RB_BLACK, key: pair.0, value: pair.1, left: left, right: right)
