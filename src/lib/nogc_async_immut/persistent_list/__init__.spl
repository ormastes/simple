# Persistent List (Cons List)
#
# Immutable singly-linked list using structural sharing.
# - O(1) prepend (cons)
# - O(n) access by index
# - O(1) head/tail
# - All operations return new list — original unchanged.

# A singly-linked cons cell: `head` followed by the rest of the list (None = end).
pub struct ConsCell<T>:
    head: T
    tail: ConsCell<T>?

class PersistentList<T>:
    _node: ConsCell<T>?   # None = empty, otherwise the first cons cell
    _len: i64

    fn len() -> i64:
        return self._len

    fn is_empty() -> bool:
        return self._len == 0

    fn head() -> T?:
        # First element, or nil if empty
        if self._node == None:
            return None
        return self._node.head

    fn tail() -> PersistentList<T>:
        # Rest of list without head, or empty if empty
        if self._node == None:
            return PersistentList(_node: None, _len: 0)
        return PersistentList(_node: self._node.tail, _len: self._len - 1)

    fn prepend(value: T) -> PersistentList<T>:
        # O(1) — add to front
        return PersistentList(_node: ConsCell(head: value, tail: self._node), _len: self._len + 1)

    fn get(index: i64) -> T?:
        # O(n) — traverse to index
        if index < 0:
            return None
        if index >= self._len:
            return None
        var current = self._node
        var i = 0
        while i < index:
            current = current.tail
            i = i + 1
        return current.head

    fn contains(value: T) -> bool:
        var current = self._node
        while current != None:
            if current.head == value:
                return true
            current = current.tail
        return false

    fn reverse() -> PersistentList<T>:
        var result_node: ConsCell<T>? = None
        var current = self._node
        var count = 0
        while current != None:
            result_node = ConsCell(head: current.head, tail: result_node)
            current = current.tail
            count = count + 1
        return PersistentList(_node: result_node, _len: count)

    fn map(f: fn(T) -> T) -> PersistentList<T>:
        # Apply f to each element, return new list (preserves order)
        var items: [T] = []
        var current = self._node
        while current != None:
            items.push(f(current.head))
            current = current.tail
        return PersistentList.from_array(items)

    fn filter(pred: fn(T) -> bool) -> PersistentList<T>:
        var items: [T] = []
        var current = self._node
        while current != None:
            if pred(current.head):
                items.push(current.head)
            current = current.tail
        return PersistentList.from_array(items)

    fn fold<A>(init: A, f: fn(A, T) -> A) -> A:
        # Left fold: f(f(f(init, a), b), c)
        var acc = init
        var current = self._node
        while current != None:
            acc = f(acc, current.head)
            current = current.tail
        return acc

    fn to_array() -> [T]:
        var result: [T] = []
        var current = self._node
        while current != None:
            result.push(current.head)
            current = current.tail
        return result

    fn concat(other: PersistentList<T>) -> PersistentList<T>:
        # Concatenate: this ++ other
        # Reverse self, then prepend each to other
        val reversed = self.reverse()
        var result = other
        var current = reversed._node
        while current != None:
            result = result.prepend(current.head)
            current = current.tail
        return result

    static fn from_array(arr: [T]) -> PersistentList<T>:
        var node: ConsCell<T>? = None
        val n = len(arr)
        var i = n - 1
        while i >= 0:
            node = ConsCell(head: arr[i], tail: node)
            i = i - 1
        return PersistentList(_node: node, _len: n)

    static fn of(values: [T]) -> PersistentList<T>:
        return PersistentList.from_array(values)

    static fn empty() -> PersistentList<T>:
        return PersistentList(_node: None, _len: 0)

export PersistentList
export ConsCell
export PersistentList__empty, PersistentList__of, PersistentList__from_array
