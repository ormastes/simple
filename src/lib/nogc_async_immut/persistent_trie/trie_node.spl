# Trie Node Operations — Persistent Prefix Tree
#
# Core operations for a persistent (immutable) trie keyed by text strings.
# Every mutation returns a NEW node tree with structural sharing — the
# original is never modified.
#
# Compact node representation (tag-packed flat arrays for minimal heap overhead):
#   EMPTY   = nil
#   NO_VAL  = [((k << 2) | TRIE_TAG_NO_VAL), ch_0, child_0, ..., ch_{k-1}, child_{k-1}]
#   HAS_VAL = [((k << 2) | TRIE_TAG_HAS_VAL), value, ch_0, child_0, ..., ch_{k-1}, child_{k-1}]
#
# Packing the 2-bit node tag and child count `k` into the header word of a single
# flat node array eliminates the outer children array and all `k` inner `[ch, child]`
# pair arrays on every insert, lookup, and remove.

# ============================================================================
# Constants — Node type tags
# ============================================================================

pub val TRIE_TAG_NO_VAL = 1
pub val TRIE_TAG_HAS_VAL = 2
pub val TRIE_TAG_MASK = 3

fn _trie_pack_header(child_count: i64, tag: i64) -> i64:
    (child_count << 2) | tag

# ============================================================================
# Node Constructor
# ============================================================================

# Create a new empty trie node (no value, 0 children).
pub fn trie_empty_node():
    [TRIE_TAG_NO_VAL]

# ============================================================================
# Flat Node & Children Helpers
# ============================================================================

# Copy flat alternating `[ch_0, child_0, ...]` children slice for persistence.
pub fn trie_copy_dict(children: []) -> []:
    var result = []
    var i = 0
    val n = children.len()
    while i < n:
        result.push(children[i])
        i = i + 1
    result

fn trie_child_get<V>(children: [], ch: text) -> V?:
    var i = 0
    val n = children.len()
    while i + 1 < n:
        if children[i] == ch:
            return children[i + 1]
        i = i + 2
    nil

fn trie_child_set(children: [], ch, child) -> []:
    var result = []
    var replaced = false
    var i = 0
    val n = children.len()
    while i + 1 < n:
        if children[i] == ch:
            result.push(ch)
            result.push(child)
            replaced = true
        else:
            result.push(children[i])
            result.push(children[i + 1])
        i = i + 2
    if not replaced:
        result.push(ch)
        result.push(child)
    result

fn _trie_node_child_get<V>(node: [], ch: text) -> V?:
    val header = node[0]
    val k = header >> 2
    val base = if (header & TRIE_TAG_MASK) == TRIE_TAG_HAS_VAL: 2 else: 1
    val limit = base + k * 2
    var pos = base
    while pos < limit:
        if node[pos] == ch:
            return node[pos + 1]
        pos = pos + 2
    nil

fn _trie_node_set_value(node: [], value) -> []:
    val header = node[0]
    val k = header >> 2
    val base = if (header & TRIE_TAG_MASK) == TRIE_TAG_HAS_VAL: 2 else: 1
    val limit = base + k * 2
    var result = if value == nil:
        [_trie_pack_header(k, TRIE_TAG_NO_VAL)]
    else:
        [_trie_pack_header(k, TRIE_TAG_HAS_VAL), value]
    var pos = base
    while pos < limit:
        result.push(node[pos])
        result.push(node[pos + 1])
        pos = pos + 2
    result

fn _trie_node_clear_value(node: []) -> []?:
    val header = node[0]
    val k = header >> 2
    if k == 0:
        return nil
    if (header & TRIE_TAG_MASK) == TRIE_TAG_NO_VAL:
        return node
    val limit = 2 + k * 2
    var result = [_trie_pack_header(k, TRIE_TAG_NO_VAL)]
    var pos = 2
    while pos < limit:
        result.push(node[pos])
        result.push(node[pos + 1])
        pos = pos + 2
    result

fn _trie_node_put_child(node: [], ch, child) -> []:
    val header = node[0]
    val has_val = (header & TRIE_TAG_MASK) == TRIE_TAG_HAS_VAL
    val k = header >> 2
    val base = if has_val: 2 else: 1
    val limit = base + k * 2
    var found = false
    var scan = base
    while scan < limit:
        if node[scan] == ch:
            found = true
            break
        scan = scan + 2
    val new_k = if found: k else: k + 1
    var result = if has_val:
        [_trie_pack_header(new_k, TRIE_TAG_HAS_VAL), node[1]]
    else:
        [_trie_pack_header(new_k, TRIE_TAG_NO_VAL)]
    var pos = base
    while pos < limit:
        if node[pos] == ch:
            result.push(ch)
            result.push(child)
        else:
            result.push(node[pos])
            result.push(node[pos + 1])
        pos = pos + 2
    if not found:
        result.push(ch)
        result.push(child)
    result

fn _trie_node_without_child(node: [], skip_ch) -> []?:
    val header = node[0]
    val has_val = (header & TRIE_TAG_MASK) == TRIE_TAG_HAS_VAL
    val k = header >> 2
    val base = if has_val: 2 else: 1
    val limit = base + k * 2
    var new_k = 0
    var scan = base
    while scan < limit:
        if node[scan] != skip_ch:
            new_k = new_k + 1
        scan = scan + 2
    if not has_val and new_k == 0:
        return nil
    var result = if has_val:
        [_trie_pack_header(new_k, TRIE_TAG_HAS_VAL), node[1]]
    else:
        [_trie_pack_header(new_k, TRIE_TAG_NO_VAL)]
    var pos = base
    while pos < limit:
        if node[pos] != skip_ch:
            result.push(node[pos])
            result.push(node[pos + 1])
        pos = pos + 2
    result

# Convert a text key once before recursive trie walks. Compiled native BDD
# currently miscompiles recursive calls that carry text parameters.
fn trie_key_chars(key: text) -> []:
    var chars: [text] = []
    var i = 0
    val n = key.len()
    while i < n:
        chars.push(key[i])
        i = i + 1
    chars

# ============================================================================
# Core Operations
# ============================================================================

# Look up a key in the trie.
# Returns the associated value, or nil if the key is not present.
#
# Parameters:
#   node  — the current trie node (nil or tag-packed flat array)
#   key   — the text key to search for
#   depth — current character index (0 at root)
pub fn trie_get(node, key: text, depth: i64):
    val chars = trie_key_chars(key)
    trie_get_chars(node, chars, depth)

fn trie_get_chars<V>(node: [], chars: [], depth: i64) -> V?:
    if node == nil:
        return nil
    val key_len = chars.len()
    if depth == key_len:
        if (node[0] & TRIE_TAG_MASK) == TRIE_TAG_HAS_VAL:
            return node[1]
        return nil
    val ch = chars[depth]
    val child = _trie_node_child_get(node, ch)
    if child == nil:
        return nil
    trie_get_chars(child, chars, depth + 1)

# Insert or update a key-value pair in the trie.
# Returns a NEW node tree (structural sharing with the original).
#
# Parameters:
#   node  — the current trie node (nil or tag-packed flat array)
#   key   — the text key to insert/update
#   value — the value to associate
#   depth — current character index (0 at root)
pub fn trie_set(node, key: text, value, depth: i64):
    val chars = trie_key_chars(key)
    trie_set_chars(node, chars, value, depth)

fn trie_set_chars(node, chars: [], value, depth: i64) -> []:
    val key_len = chars.len()
    if node == nil:
        # Build new flat path from here to the end of the key
        if depth == key_len:
            if value == nil:
                return [TRIE_TAG_NO_VAL]
            return [TRIE_TAG_HAS_VAL, value]
        val ch = chars[depth]
        val child = trie_set_chars(nil, chars, value, depth + 1)
        return [_trie_pack_header(1, TRIE_TAG_NO_VAL), ch, child]
    if depth == key_len:
        # Set value at this node, preserve children in flat layout
        return _trie_node_set_value(node, value)
    val ch = chars[depth]
    val existing = _trie_node_child_get(node, ch)
    val new_child = trie_set_chars(existing, chars, value, depth + 1)
    _trie_node_put_child(node, ch, new_child)

# Remove a key from the trie.
# Returns a NEW node tree with the key's value removed.
# Prunes empty subtrees to avoid waste.
# Returns nil if the entire subtree becomes empty.
#
# Parameters:
#   node  — the current trie node
#   key   — the text key to remove
#   depth — current character index (0 at root)
pub fn trie_remove(node, key: text, depth: i64):
    val chars = trie_key_chars(key)
    trie_remove_chars(node, chars, depth)

fn trie_remove_chars(node, chars: [], depth: i64) -> []?:
    if node == nil:
        return nil
    val key_len = chars.len()
    if depth == key_len:
        return _trie_node_clear_value(node)
    val ch = chars[depth]
    val child = _trie_node_child_get(node, ch)
    if child == nil:
        # Key not in trie — return unchanged
        return node
    val new_child = trie_remove_chars(child, chars, depth + 1)
    if new_child == child:
        # Nothing changed
        return node
    if new_child == nil:
        return _trie_node_without_child(node, ch)
    _trie_node_put_child(node, ch, new_child)

# Check whether a key exists in the trie (has a stored value).
#
# Parameters:
#   node  — the current trie node
#   key   — the text key to check
#   depth — current character index (0 at root)
pub fn trie_contains(node, key: text, depth: i64) -> bool:
    val chars = trie_key_chars(key)
    trie_contains_chars(node, chars, depth)

fn trie_contains_chars(node, chars: [], depth: i64) -> bool:
    if node == nil:
        return false
    val key_len = chars.len()
    if depth == key_len:
        return (node[0] & TRIE_TAG_MASK) == TRIE_TAG_HAS_VAL
    val ch = chars[depth]
    val child = _trie_node_child_get(node, ch)
    if child == nil:
        return false
    trie_contains_chars(child, chars, depth + 1)

# Count all stored values in the trie (DFS traversal).
pub fn trie_count(node) -> i64:
    if node == nil:
        return 0
    val header = node[0]
    val has_val = (header & TRIE_TAG_MASK) == TRIE_TAG_HAS_VAL
    var total = if has_val: 1 else: 0
    val k = header >> 2
    val base = if has_val: 2 else: 1
    val limit = base + k * 2
    var pos = base
    while pos < limit:
        total = total + trie_count(node[pos + 1])
        pos = pos + 2
    total

# ============================================================================
# Traversal / Collection
# ============================================================================

# Collect all [key, value] pairs from the trie via DFS.
# Returns an array of [key, value] pairs.
#
# Parameters:
#   node   — the current trie node
#   prefix — the key built so far (characters traversed)
pub fn trie_collect_entries(node, prefix: text) -> []:
    var acc = []
    _trie_collect_entries_into(node, prefix, acc)

fn _trie_collect_entries_into(node, prefix: text, acc_in) -> []:
    var acc = acc_in
    if node == nil:
        return acc
    val header = node[0]
    val has_val = (header & TRIE_TAG_MASK) == TRIE_TAG_HAS_VAL
    if has_val:
        acc.push([prefix, node[1]])
    val k = header >> 2
    val base = if has_val: 2 else: 1
    val limit = base + k * 2
    var pos = base
    while pos < limit:
        acc = _trie_collect_entries_into(node[pos + 1], prefix + node[pos], acc)
        pos = pos + 2
    acc

# Find all keys that start with the given prefix.
# Navigates to the prefix node, then collects all keys below it.
# Returns an array of matching keys.
#
# Parameters:
#   node         — the current trie node
#   prefix       — the prefix text to search for
#   prefix_depth — current character index into the prefix
#   full_prefix  — the original full prefix string (for building result keys)
# @tag(prefix=prefix, full_prefix=full_prefix)
pub fn trie_keys_with_prefix(node, prefix: text, prefix_depth: i64, full_prefix: text):
    val chars = trie_key_chars(prefix)
    trie_keys_with_prefix_chars(node, chars, prefix_depth, full_prefix)

fn trie_keys_with_prefix_chars(node, chars: [], prefix_depth: i64, full_prefix: text) -> []:
    if node == nil:
        return []
    val prefix_len = chars.len()
    if prefix_depth == prefix_len:
        # Reached the prefix node — collect all keys below
        return trie_collect_keys(node, full_prefix)
    val ch = chars[prefix_depth]
    val child = _trie_node_child_get(node, ch)
    if child == nil:
        return []
    trie_keys_with_prefix_chars(child, chars, prefix_depth + 1, full_prefix)

# Collect all keys from a subtree. Used after navigating to a prefix node.
# Returns an array of keys.
pub fn trie_collect_keys(node, prefix: text) -> []:
    var acc = []
    _trie_collect_keys_into(node, prefix, acc)

fn _trie_collect_keys_into(node, prefix: text, acc_in) -> []:
    var acc = acc_in
    if node == nil:
        return acc
    val header = node[0]
    val has_val = (header & TRIE_TAG_MASK) == TRIE_TAG_HAS_VAL
    if has_val:
        acc.push(prefix)
    val k = header >> 2
    val base = if has_val: 2 else: 1
    val limit = base + k * 2
    var pos = base
    while pos < limit:
        acc = _trie_collect_keys_into(node[pos + 1], prefix + node[pos], acc)
        pos = pos + 2
    acc

# Find the longest key in the trie that is a prefix of the given query string.
# Returns the longest matching prefix text, or nil if no prefix matches.
#
# Parameters:
#   node  — the current trie node
#   query — the query text to find prefixes of
#   depth — current character index (0 at root)
#   last_match — the longest prefix found so far (nil or text)
pub fn trie_longest_prefix(node, query: text, depth: i64, last_match):
    val chars = trie_key_chars(query)
    trie_longest_prefix_chars(node, chars, depth, last_match)

fn trie_longest_prefix_chars(node, chars: [], depth: i64, last_match) -> text?:
    if node == nil:
        return last_match
    var current_match = last_match
    if (node[0] & TRIE_TAG_MASK) == TRIE_TAG_HAS_VAL:
        # This node's prefix is a valid key — record it
        val prefix_len = depth
        var prefix_chars: [text] = []
        var j = 0
        while j < prefix_len:
            prefix_chars.push(chars[j])
            j = j + 1
        current_match = prefix_chars.join("")
    val query_len = chars.len()
    if depth == query_len:
        return current_match
    val ch = chars[depth]
    val child = _trie_node_child_get(node, ch)
    if child == nil:
        return current_match
    trie_longest_prefix_chars(child, chars, depth + 1, current_match)

# ============================================================================
# Dict Helpers
# ============================================================================

# Check if a flat children array has any entries.
fn trie_dict_has_keys(children: []) -> bool:
    children.len() > 0

# Return a copy of flat children `[ch_0, child_0, ...]` with key `skip_key` removed.
fn trie_dict_without(children: [], skip_key) -> []:
    var result = []
    var i = 0
    val n = children.len()
    while i + 1 < n:
        if children[i] != skip_key:
            result.push(children[i])
            result.push(children[i + 1])
        i = i + 2
    result

# ============================================================================
# Exports
# ============================================================================

export TRIE_TAG_NO_VAL, TRIE_TAG_HAS_VAL, TRIE_TAG_MASK
export trie_empty_node
export trie_copy_dict
export trie_get, trie_set, trie_remove
export trie_contains, trie_count
export trie_collect_entries, trie_keys_with_prefix, trie_collect_keys
export trie_longest_prefix
export trie_dict_has_keys, trie_dict_without
