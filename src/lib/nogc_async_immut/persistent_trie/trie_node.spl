# Trie Node Operations - Persistent Prefix Tree
#
# Core operations for a persistent (immutable) trie keyed by text strings.
# Every mutation returns a NEW node tree with structural sharing - the
# original is never modified.
#
# Node representation:
#   EMPTY    = None
#   TrieNode = (value_or_none, edges)
#   TrieEdge = (ch, child)
# A node holds a value when `value` is not None; `edges` are its children in
# insertion order.

# ============================================================================
# Node Types
# ============================================================================

pub struct TrieNode<V>:
    value: V?
    edges: [TrieEdge<V>]

pub struct TrieEdge<V>:
    ch: text
    node: TrieNode<V>

# ============================================================================
# Node Constructor
# ============================================================================

# Create a new empty trie node (no value, 0 children).
pub fn trie_empty_node<V>() -> TrieNode<V>:
    var edges: [TrieEdge<V>] = []
    TrieNode(value: None, edges: edges)

# ============================================================================
# Node Inspection
# ============================================================================

# True when the node stores a value.
@allow(primitive_api)  # depth is a raw character index, counts are plain integers
pub fn trie_node_has_value<V>(node: TrieNode<V>) -> bool:
    node.value != None

# Number of direct children of the node.
@allow(primitive_api)  # depth is a raw character index, counts are plain integers
pub fn trie_node_child_count<V>(node: TrieNode<V>) -> i64:
    node.edges.len()

# ============================================================================
# Children Helpers
# ============================================================================

# Copy a children edge list for persistence.
pub fn trie_copy_dict<V>(children: [TrieEdge<V>]) -> [TrieEdge<V>]:
    var result: [TrieEdge<V>] = []
    var i = 0
    val n = children.len()
    while i < n:
        result.push(children[i])
        i = i + 1
    result

fn trie_child_get<V>(children: [TrieEdge<V>], ch: text) -> TrieNode<V>?:
    for edge in children:
        if edge.ch == ch:
            return edge.node
    None

fn trie_child_set<V>(children: [TrieEdge<V>], ch: text, child: TrieNode<V>) -> [TrieEdge<V>]:
    var result: [TrieEdge<V>] = []
    var replaced = false
    for edge in children:
        if edge.ch == ch:
            result.push(TrieEdge(ch: ch, node: child))
            replaced = true
        else:
            result.push(edge)
    if not replaced:
        result.push(TrieEdge(ch: ch, node: child))
    result

# Look up the child of `node` reached by `ch`, or None.
fn _trie_node_child_get<V>(node: TrieNode<V>, ch: text) -> TrieNode<V>?:
    trie_child_get(node.edges, ch)

# Return a copy of `node` with its value replaced (None clears the value).
fn _trie_node_set_value<V>(node: TrieNode<V>, value: V?) -> TrieNode<V>:
    TrieNode(value: value, edges: node.edges)

# Clear the value of `node`. Returns None when the node has no children
# (i.e. it becomes empty), the node itself when it holds no value.
fn _trie_node_clear_value<V>(node: TrieNode<V>) -> TrieNode<V>?:
    if node.edges.len() == 0:
        return None
    if node.value == None:
        return node
    TrieNode(value: None, edges: node.edges)

# Return a copy of `node` with child `ch` set to `child` (appended if new).
fn _trie_node_put_child<V>(node: TrieNode<V>, ch: text, child: TrieNode<V>) -> TrieNode<V>:
    TrieNode(value: node.value, edges: trie_child_set(node.edges, ch, child))

# Return a copy of `node` without child `skip_ch`.
# Returns None if the result has no value and no children.
fn _trie_node_without_child<V>(node: TrieNode<V>, skip_ch: text) -> TrieNode<V>?:
    val kept = trie_dict_without(node.edges, skip_ch)
    if node.value == None and kept.len() == 0:
        return None
    TrieNode(value: node.value, edges: kept)

# Split `key` into single-character texts.
fn trie_key_chars(key: text) -> [text]:
    var chars: [text] = []
    var i = 0
    val n = key.len()
    while i < n:
        chars.push(key[i])
        i = i + 1
    chars

# ============================================================================
# Lookup
# ============================================================================

# Look up the value stored at `key` below `node` (depth = 0 at the root).
@allow(primitive_api)  # depth is a raw character index, counts are plain integers
pub fn trie_get<V>(node: TrieNode<V>?, key: text, depth: i64) -> V?:
    val chars = trie_key_chars(key)
    trie_get_chars(node, chars, depth)

fn trie_get_chars<V>(node: TrieNode<V>?, chars: [text], depth: i64) -> V?:
    if node == None:
        return None
    val key_len = chars.len()
    if depth == key_len:
        return node.value
    val ch = chars[depth]
    val child = _trie_node_child_get(node, ch)
    if child == None:
        return None
    trie_get_chars(child, chars, depth + 1)

# ============================================================================
# Insert
# ============================================================================

# Return a NEW trie with `value` stored at `key` (None stores no value).
@allow(primitive_api)  # depth is a raw character index, counts are plain integers
pub fn trie_set<V>(node: TrieNode<V>?, key: text, value: V?, depth: i64) -> TrieNode<V>:
    val chars = trie_key_chars(key)
    trie_set_chars(node, chars, value, depth)

fn trie_set_chars<V>(node: TrieNode<V>?, chars: [text], value: V?, depth: i64) -> TrieNode<V>:
    val key_len = chars.len()
    if node == None:
        var no_edges: [TrieEdge<V>] = []
        if depth == key_len:
            return TrieNode(value: value, edges: no_edges)
        val ch = chars[depth]
        val child = trie_set_chars(None, chars, value, depth + 1)
        return TrieNode(value: None, edges: [TrieEdge(ch: ch, node: child)])
    if depth == key_len:
        return _trie_node_set_value(node, value)
    val ch = chars[depth]
    val existing = _trie_node_child_get(node, ch)
    val new_child = trie_set_chars(existing, chars, value, depth + 1)
    _trie_node_put_child(node, ch, new_child)

# ============================================================================
# Remove
# ============================================================================

# Return a NEW trie with the value at `key` removed, or None if it becomes empty.
@allow(primitive_api)  # depth is a raw character index, counts are plain integers
pub fn trie_remove<V>(node: TrieNode<V>?, key: text, depth: i64) -> TrieNode<V>?:
    val chars = trie_key_chars(key)
    trie_remove_chars(node, chars, depth)

fn trie_remove_chars<V>(node: TrieNode<V>?, chars: [text], depth: i64) -> TrieNode<V>?:
    if node == None:
        return None
    val key_len = chars.len()
    if depth == key_len:
        return _trie_node_clear_value(node)
    val ch = chars[depth]
    val child = _trie_node_child_get(node, ch)
    if child == None:
        return node
    val new_child = trie_remove_chars(child, chars, depth + 1)
    if new_child == child:
        return node
    if new_child == None:
        return _trie_node_without_child(node, ch)
    _trie_node_put_child(node, ch, new_child)

# ============================================================================
# Contains / Count
# ============================================================================

# True when a value is stored at `key`.
@allow(primitive_api)  # depth is a raw character index, counts are plain integers
pub fn trie_contains<V>(node: TrieNode<V>?, key: text, depth: i64) -> bool:
    val chars = trie_key_chars(key)
    trie_contains_chars(node, chars, depth)

fn trie_contains_chars<V>(node: TrieNode<V>?, chars: [text], depth: i64) -> bool:
    if node == None:
        return false
    val key_len = chars.len()
    if depth == key_len:
        return node.value != None
    val ch = chars[depth]
    val child = _trie_node_child_get(node, ch)
    if child == None:
        return false
    trie_contains_chars(child, chars, depth + 1)

# Count the keys stored below `node`.
pub fn trie_count<V>(node: TrieNode<V>?) -> i64:
    if node == None:
        return 0
    var total = 0
    if node.value != None:
        total = 1
    for edge in node.edges:
        total = total + trie_count(edge.node)
    total

# ============================================================================
# Traversal
# ============================================================================

# Collect all (key, value) pairs below `node`, each key prefixed with `prefix`.
pub fn trie_collect_entries<V>(node: TrieNode<V>?, prefix: text) -> [(text, V)]:
    var acc: [(text, V)] = []
    _trie_collect_entries_into(node, prefix, acc)

fn _trie_collect_entries_into<V>(node: TrieNode<V>?, prefix: text, acc_in: [(text, V)]) -> [(text, V)]:
    var acc = acc_in
    if node == None:
        return acc
    if node.value != None:
        acc.push((prefix, node.value))
    for edge in node.edges:
        acc = _trie_collect_entries_into(edge.node, prefix + edge.ch, acc)
    acc

# Collect the keys below `node` that start with the first `prefix_depth`
# characters of `prefix`, each rendered with `full_prefix`.
@allow(primitive_api)  # depth is a raw character index, counts are plain integers
pub fn trie_keys_with_prefix<V>(node: TrieNode<V>?, prefix: text, prefix_depth: i64, full_prefix: text) -> [text]:
    val chars = trie_key_chars(prefix)
    trie_keys_with_prefix_chars(node, chars, prefix_depth, full_prefix)

fn trie_keys_with_prefix_chars<V>(node: TrieNode<V>?, chars: [text], prefix_depth: i64, full_prefix: text) -> [text]:
    if node == None:
        return []
    val prefix_len = chars.len()
    if prefix_depth == prefix_len:
        return trie_collect_keys(node, full_prefix)
    val ch = chars[prefix_depth]
    val child = _trie_node_child_get(node, ch)
    if child == None:
        return []
    trie_keys_with_prefix_chars(child, chars, prefix_depth + 1, full_prefix)

# Collect all keys below `node`, each prefixed with `prefix`.
pub fn trie_collect_keys<V>(node: TrieNode<V>?, prefix: text) -> [text]:
    var acc: [text] = []
    _trie_collect_keys_into(node, prefix, acc)

fn _trie_collect_keys_into<V>(node: TrieNode<V>?, prefix: text, acc_in: [text]) -> [text]:
    var acc = acc_in
    if node == None:
        return acc
    if node.value != None:
        acc.push(prefix)
    for edge in node.edges:
        acc = _trie_collect_keys_into(edge.node, prefix + edge.ch, acc)
    acc

# ============================================================================
# Longest Prefix
# ============================================================================

# Find the longest key in the trie that is a prefix of the given query string.
# Returns the longest matching prefix text, or None if no prefix matches.
#
# Parameters:
#   node  - the current trie node
#   query - the query text to find prefixes of
#   depth - current character index (0 at root)
#   last_match - the longest prefix found so far (None or text)
@allow(primitive_api)  # depth is a raw character index, counts are plain integers
pub fn trie_longest_prefix<V>(node: TrieNode<V>?, query: text, depth: i64, last_match: text?) -> text?:
    val chars = trie_key_chars(query)
    trie_longest_prefix_chars(node, chars, depth, last_match)

fn trie_longest_prefix_chars<V>(node: TrieNode<V>?, chars: [text], depth: i64, last_match: text?) -> text?:
    if node == None:
        return last_match
    var current_match = last_match
    if node.value != None:
        # This node's prefix is a valid key - record it
        val prefix_len = depth
        var prefix_chars: [text] = []
        var j = 0
        while j < prefix_len:
            prefix_chars.push(chars[j])
            j = j + 1
        current_match = prefix_chars.join("")
    val query_len = chars.len()
    if depth == query_len:
        return current_match
    val ch = chars[depth]
    val child = _trie_node_child_get(node, ch)
    if child == None:
        return current_match
    trie_longest_prefix_chars(child, chars, depth + 1, current_match)

# ============================================================================
# Dict Helpers
# ============================================================================

# Check if a children edge list has any entries.
pub fn trie_dict_has_keys<V>(children: [TrieEdge<V>]) -> bool:
    children.len() > 0

# Return a copy of the children edge list with key `skip_key` removed.
pub fn trie_dict_without<V>(children: [TrieEdge<V>], skip_key: text) -> [TrieEdge<V>]:
    var result: [TrieEdge<V>] = []
    for edge in children:
        if edge.ch != skip_key:
            result.push(edge)
    result

# ============================================================================
# Exports
# ============================================================================

export TrieNode, TrieEdge
export trie_empty_node
export trie_node_has_value, trie_node_child_count
export trie_copy_dict
export trie_get, trie_set, trie_remove
export trie_contains, trie_count
export trie_collect_entries, trie_keys_with_prefix, trie_collect_keys
export trie_longest_prefix
export trie_dict_has_keys, trie_dict_without
