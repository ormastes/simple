# RRB-Tree Node Operations
#
# Relaxed Radix Balanced tree (RRB-tree) — a persistent, immutable vector
# structure using 32-way branching. Based on Bagwell & Rompf (2011) and
# Stucki, Rompf, Ureche, Bagwell (2015).
#
# Node representation (RrbNode<T> enum):
#   Leaf   = (items)
#   Branch = (children, size_table_or_none)
#
# The tree consumes 5 bits of the index per level (2^5 = 32-way branching).
# A size_table is None for "strict" nodes (all children are full except the
# rightmost) and [cumulative_sizes...] for "relaxed" nodes (after concat).
#
# All operations return NEW nodes (structural sharing). The original tree
# is never modified.

# ============================================================================
# Constants
# ============================================================================

val RRB_BRANCH_FACTOR = 32
val RRB_BITS = 5
val RRB_MASK = 31
val RRB_NODE_LEAF = 1
val RRB_NODE_BRANCH = 2

# ============================================================================
# Node Type
# ============================================================================

pub enum RrbNode<T>:
    Leaf(items: [T])
    Branch(children: [RrbNode<T>], size_table: [i64]?)

# ============================================================================
# Node Constructors
# ============================================================================

# Create a leaf node holding up to 32 elements.
fn rrb_leaf<T>(items: [T]) -> RrbNode<T>:
    return RrbNode.Leaf(items: items)

# Create a branch node with children and an optional size table.
# size_table is None for strict nodes, [cumulative_sizes...] for relaxed.
fn rrb_branch<T>(children: [RrbNode<T>], size_table: [i64]?) -> RrbNode<T>:
    return RrbNode.Branch(children: children, size_table: size_table)

# ============================================================================
# Node Type Inspection
# ============================================================================

# Check if a node is a leaf.
fn rrb_is_leaf<T>(node: RrbNode<T>?) -> bool:
    return rrb_node_tag(node) == RRB_NODE_LEAF

# Check if a node is a branch.
fn rrb_is_branch<T>(node: RrbNode<T>?) -> bool:
    return rrb_node_tag(node) == RRB_NODE_BRANCH

# Get the tag of a node. Returns 0 for None.
fn rrb_node_tag<T>(node: RrbNode<T>?) -> i64:
    if node == None:
        return 0
    match node:
        case Leaf(items): RRB_NODE_LEAF
        case Branch(children, size_table): RRB_NODE_BRANCH

# ============================================================================
# Leaf Accessors
# ============================================================================

# Get the items array from a leaf node (empty for a branch).
fn rrb_leaf_items<T>(node: RrbNode<T>) -> [T]:
    match node:
        case Leaf(items): return items
        case Branch(children, size_table):
            var none: [T] = []
            return none

# Get a single element from a leaf at the given index.
fn rrb_leaf_get<T>(node: RrbNode<T>, index: i64) -> T:
    val items = rrb_leaf_items(node)
    return items[index]

# Return a new leaf with the element at index replaced by value.
fn rrb_leaf_set<T>(node: RrbNode<T>, index: i64, value: T) -> RrbNode<T>:
    val items = rrb_leaf_items(node)
    var new_items: [T] = []
    val n = items.len()
    var i = 0
    while i < n:
        if i == index:
            new_items.push(value)
        else:
            new_items.push(items[i])
        i = i + 1
    return rrb_leaf(new_items)

# Return a new leaf with value appended (caller must ensure room).
fn rrb_leaf_push<T>(node: RrbNode<T>, value: T) -> RrbNode<T>:
    val items = rrb_leaf_items(node)
    var new_items: [T] = []
    val n = items.len()
    var i = 0
    while i < n:
        new_items.push(items[i])
        i = i + 1
    new_items.push(value)
    return rrb_leaf(new_items)

# Count the number of elements in a leaf.
fn rrb_leaf_count<T>(node: RrbNode<T>) -> i64:
    val items = rrb_leaf_items(node)
    return items.len()

# ============================================================================
# Branch Accessors
# ============================================================================

# Get the children array from a branch node (empty for a leaf).
fn rrb_branch_children<T>(node: RrbNode<T>) -> [RrbNode<T>]:
    match node:
        case Branch(children, size_table): return children
        case Leaf(items):
            var none: [RrbNode<T>] = []
            return none

# Get the size table from a branch node (None if strict).
fn rrb_branch_size_table<T>(node: RrbNode<T>) -> [i64]?:
    match node:
        case Branch(children, size_table): return size_table
        case Leaf(items): return None

# ============================================================================
# Array Helpers (immutable copy-on-write)
# ============================================================================

# Return a new array with the element at index replaced.
fn rrb_array_replace<T>(arr: [T], idx: i64, value: T) -> [T]:
    var result: [T] = []
    val n = arr.len()
    var i = 0
    while i < n:
        if i == idx:
            result.push(value)
        else:
            result.push(arr[i])
        i = i + 1
    return result

# Return a new array with the last element removed.
fn rrb_array_pop<T>(arr: [T]) -> [T]:
    var result: [T] = []
    val n = arr.len() - 1
    var i = 0
    while i < n:
        result.push(arr[i])
        i = i + 1
    return result

# Return a copy of the array.
fn rrb_array_copy<T>(arr: [T]) -> [T]:
    var result: [T] = []
    val n = arr.len()
    var i = 0
    while i < n:
        result.push(arr[i])
        i = i + 1
    return result

# Return a new array with a value appended.
fn rrb_array_push<T>(arr: [T], value: T) -> [T]:
    var result: [T] = []
    val n = arr.len()
    var i = 0
    while i < n:
        result.push(arr[i])
        i = i + 1
    result.push(value)
    return result

# ============================================================================
# Tree Navigation - Get
# ============================================================================

# Retrieve the value at index from the tree.
# shift = current bit offset (0 at deepest single-level, 5 at two levels, etc.)
# The caller is responsible for bounds checking and tail-vs-tree routing.
fn rrb_get<T>(node: RrbNode<T>?, index: i64, shift: i64) -> T?:
    if node == None:
        return None
    match node:
        case Leaf(items):
            # At a leaf: index directly into items
            return items[index]
        case Branch(children, size_table):
            if size_table == None:
                # Strict node: radix indexing
                val child_idx = (index >> shift) & RRB_MASK
                val child = children[child_idx]
                val sub_index = index & ((1 << shift) - 1)
                return rrb_get(child, index: sub_index, shift: shift - RRB_BITS)

            # Relaxed node: scan size table for the correct child
            val n_children = children.len()
            var child_idx = 0
            while child_idx < n_children:
                val child_size = size_table[child_idx]
                if index < child_size:
                    if child_idx > 0:
                        val ps = size_table[child_idx - 1]
                        val child = children[child_idx]
                        val sub_index = index - ps
                        return rrb_get(child, index: sub_index, shift: shift - RRB_BITS)
                    val child = children[child_idx]
                    return rrb_get(child, index: index, shift: shift - RRB_BITS)
                child_idx = child_idx + 1
            return None

# ============================================================================
# Tree Navigation - Set (path-copy)
# ============================================================================

# Return a new tree with the value at index replaced.
# Only copies the path from root to the modified leaf - everything else is shared.
fn rrb_set<T>(node: RrbNode<T>?, index: i64, value: T, shift: i64) -> RrbNode<T>?:
    if node == None:
        return None
    match node:
        case Leaf(items):
            return rrb_leaf_set(node, index, value)
        case Branch(children, size_table):
            if size_table == None:
                # Strict node: radix indexing
                val child_idx = (index >> shift) & RRB_MASK
                val child = children[child_idx]
                val sub_index = index & ((1 << shift) - 1)
                val new_child = rrb_set(child, index: sub_index, value: value, shift: shift - RRB_BITS)
                val new_children = rrb_array_replace(children, child_idx, new_child)
                return rrb_branch(new_children, None)

            # Relaxed node: scan size table
            val n_children = children.len()
            var child_idx = 0
            while child_idx < n_children:
                val child_size = size_table[child_idx]
                if index < child_size:
                    var sub_index = index
                    if child_idx > 0:
                        sub_index = index - size_table[child_idx - 1]
                    val child = children[child_idx]
                    val new_child = rrb_set(child, index: sub_index, value: value, shift: shift - RRB_BITS)
                    val new_children = rrb_array_replace(children, child_idx, new_child)
                    return rrb_branch(new_children, size_table)
                child_idx = child_idx + 1
            return node

# ============================================================================
# Tree Mutation - Push Tail
# ============================================================================

# Create a chain of single-child branch nodes from the given shift level
# down to a leaf. Used when pushing a tail requires growing the tree
# into a new subtree.
fn rrb_new_path<T>(shift: i64, leaf: RrbNode<T>) -> RrbNode<T>:
    if shift <= 0:
        return leaf
    val child = rrb_new_path(shift - RRB_BITS, leaf)
    return rrb_branch([child], None)

# Push a leaf node (the old tail wrapped as a leaf) into the tree.
# Returns a new tree root. If the tree overflows, returns None to signal
# that a new root level is needed (handled by PersistentVec.push).
#
# shift: the current depth's bit offset (root shift)
fn rrb_push_tail<T>(node: RrbNode<T>?, tail_node: RrbNode<T>, shift: i64) -> RrbNode<T>?:
    if node == None:
        # Empty tree: the tail leaf becomes the entire tree
        return rrb_new_path(shift, tail_node)
    match node:
        case Leaf(items):
            # Should not happen - leaves do not contain other leaves.
            # The caller should handle this via new_path.
            return None
        case Branch(children, size_table):
            val n_children = children.len()

            if shift == RRB_BITS:
                # One level above leaves: insert tail_node directly as new child
                if n_children >= RRB_BRANCH_FACTOR:
                    # No room - signal overflow
                    return None
                val new_children = rrb_array_push(children, tail_node)
                return rrb_branch(new_children, None)

            # Deeper levels: try to push into the rightmost child
            val rightmost = children[n_children - 1]
            val new_rightmost = rrb_push_tail(rightmost, tail_node, shift - RRB_BITS)

            if new_rightmost != None:
                # Successfully pushed into existing subtree
                val new_children = rrb_array_replace(children, n_children - 1, new_rightmost)
                return rrb_branch(new_children, None)

            # Rightmost subtree is full - create a new path and add as sibling
            if n_children >= RRB_BRANCH_FACTOR:
                # This level is also full - signal overflow
                return None
            val new_path = rrb_new_path(shift - RRB_BITS, tail_node)
            val new_children = rrb_array_push(children, new_path)
            return rrb_branch(new_children, None)

# ============================================================================
# Tree Mutation - Pop Tail
# ============================================================================

# Remove the rightmost leaf from the tree.
# Returns a new tree root, or None if the tree becomes empty.
#
# shift: the current depth's bit offset (root shift)
fn rrb_pop_tail<T>(node: RrbNode<T>?, shift: i64) -> RrbNode<T>?:
    if node == None:
        return None
    match node:
        case Leaf(items):
            # Should not be called directly on a leaf by PersistentVec;
            # the tail is managed separately. But handle gracefully.
            return None
        case Branch(children, size_table):
            val n_children = children.len()

            if shift == RRB_BITS:
                # One level above leaves: remove the last child
                if n_children <= 1:
                    return None
                val new_children = rrb_array_pop(children)
                return rrb_branch(new_children, None)

            # Deeper levels: recurse into rightmost child
            val rightmost = children[n_children - 1]
            val new_rightmost = rrb_pop_tail(rightmost, shift - RRB_BITS)

            if new_rightmost == None:
                # Rightmost subtree is now empty - remove it
                if n_children <= 1:
                    return None
                val new_children = rrb_array_pop(children)
                return rrb_branch(new_children, None)

            # Rightmost subtree shrank but still has children
            val new_children = rrb_array_replace(children, n_children - 1, new_rightmost)
            return rrb_branch(new_children, None)

# ============================================================================
# Tree Traversal - Get Rightmost Leaf
# ============================================================================

# Retrieve the rightmost leaf node from the tree.
# Used by PersistentVec.pop to extract the new tail.
fn rrb_rightmost_leaf<T>(node: RrbNode<T>?) -> RrbNode<T>?:
    if node == None:
        return None
    match node:
        case Leaf(items):
            return node
        case Branch(children, size_table):
            # Branch: follow rightmost child
            val n_children = children.len()
            val rightmost = children[n_children - 1]
            return rrb_rightmost_leaf(rightmost)

# ============================================================================
# Tree Traversal - Collect All Elements
# ============================================================================

# Collect all elements from the tree into a flat output array.
# Appends to the provided `elements_out` array (mutable).
fn rrb_collect_elements<T>(node: RrbNode<T>?, elements_out: [T]):
    if node == None:
        return
    match node:
        case Leaf(items):
            var i = 0
            val n = items.len()
            while i < n:
                elements_out.push(items[i])
                i = i + 1
            return
        case Branch(children, size_table):
            var i = 0
            val n = children.len()
            while i < n:
                rrb_collect_elements(children[i], elements_out)
                i = i + 1
            return

# Count total elements in a tree node (recursive).
fn rrb_count<T>(node: RrbNode<T>?) -> i64:
    if node == None:
        return 0
    match node:
        case Leaf(items):
            return items.len()
        case Branch(children, size_table):
            var total = 0
            var i = 0
            val n = children.len()
            while i < n:
                total = total + rrb_count(children[i])
                i = i + 1
            return total

# ============================================================================
# Exports
# ============================================================================
export RRB_BRANCH_FACTOR
export RRB_BITS
export RRB_MASK
export RRB_NODE_LEAF
export RRB_NODE_BRANCH
export RrbNode
