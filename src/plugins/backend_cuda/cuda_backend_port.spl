# PTX emission is independent of CUDA device/driver availability on the host.
# Keep this implementation import at the selected static composition boundary.
use common.plugin.iface_id.{ParamHeader}
use compiler.backend.backend_port.{BackendDescV1, BackendPortV1, CodegenParamsV1,
    backend_port_header, backend_port_host_iface}
use compiler.backend.backend.backend_types.{BackendKind, CodegenTarget,
    CompileError, compileerror_backend_error}
use compiler.backend.codegen_types.{CodegenOutput}
use compiler.mir.mir_instructions.{MirModule}
use plugins.backend_cuda.cuda_backend.{CudaBackend}

fn cuda_backend_desc_v1() -> BackendDescV1:
    BackendDescV1(ParamHeader("simple.codegen.BackendDescV1", 1, 0, 0),
        "cuda", ["cuda-ptx"], ["emit-gpu"], "cuda-static-ptx-sm86-v1", [])

fn cuda_backend_run_v1(params: CodegenParamsV1, module: MirModule) -> Result<CodegenOutput, CompileError>:
    if params.target != "cuda-ptx" or params.options.target != CodegenTarget.CudaPtx:
        return Err(compileerror_backend_error(BackendKind.Cuda,
            "CUDA PTX emission requires target cuda-ptx"))
    CudaBackend.create_with_options((8, 6), params.options).compile_module(module)

fn cuda_backend_supports_v1(capability: text) -> bool:
    capability == "emit-gpu"

pub fn cuda_backend_port_v1() -> BackendPortV1:
    BackendPortV1(backend_port_header(), backend_port_host_iface(),
        cuda_backend_desc_v1, cuda_backend_run_v1, cuda_backend_supports_v1, [])
