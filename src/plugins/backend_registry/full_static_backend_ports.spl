use compiler.backend.backend_port.{BackendDescV1, BackendPortV1, CodegenParamsV1, backend_port_header, backend_port_host_iface}
use common.plugin.iface_id.{ParamHeader}
use compiler.mir.mir_instructions.{MirModule}
use compiler.backend.codegen_types.{CodegenOutput}
use compiler.backend.backend.backend_types.{CompileError}
use plugins.backend_llvm_lib.llvm_lib_backend.{LlvmLibCodegenAdapter}
use plugins.backend_c.c_codegen_adapter.{CCodegenAdapter}
use plugins.backend_wasm.wasm_codegen_adapter.{WasmCodegenAdapter}
use plugins.backend_native.native_codegen_adapter.{NativeCodegenAdapter}
use plugins.backend_cuda.cuda_backend.{CudaBackend}
use plugins.backend_hip.hip_backend.{HipBackend}
use plugins.backend_opencl.opencl_backend.{OpenClBackend}
use plugins.backend_vulkan.vulkan_backend.{VulkanCodegenBackend}
use plugins.backend_lean.lean_backend.{LeanBackend, VerificationLevel}
use plugins.backend_byl.byl_backend.{BylBackend}
use plugins.backend_vhdl.vhdl_backend.{VhdlBackend}
use plugins.backend_irtc.irtc_codegen_adapter.{IrTcCodegenAdapter}
use plugins.backend_lua.lua_codegen_adapter.{LuaCodegenAdapter}

fn _desc(name: text, targets: [text], capabilities: [text]) -> BackendDescV1:
    BackendDescV1(ParamHeader("simple.codegen.BackendDescV1", 1, 0, 0), name, targets, capabilities, name, [])

fn _object(cap: text) -> bool: cap == "emit-object"
fn _source(cap: text) -> bool: cap == "emit-source"
fn _gpu(cap: text) -> bool: cap == "emit-gpu"
fn _proof(cap: text) -> bool: cap == "emit-proof"
fn _hdl(cap: text) -> bool: cap == "emit-hdl"
fn _execute(cap: text) -> bool: cap == "execute"

fn _llvm_lib_desc() -> BackendDescV1: _desc("llvm-lib", ["*"], ["emit-object"])
fn _llvm_lib_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>: LlvmLibCodegenAdapter(options: p.options).compile_module(m)
pub fn llvm_lib_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _llvm_lib_desc, _llvm_lib_run, _object, [])

fn _c_desc() -> BackendDescV1: _desc("c", ["*"], ["emit-source"])
fn _c_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>: CCodegenAdapter(options: p.options).compile_module(m)
pub fn c_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _c_desc, _c_run, _source, [])

fn _wasm_desc() -> BackendDescV1: _desc("wasm", ["wasm32", "wasm64"], ["emit-object"])
fn _wasm_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>: WasmCodegenAdapter(options: p.options).compile_module(m)
pub fn wasm_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _wasm_desc, _wasm_run, _object, [])

fn _native_desc() -> BackendDescV1: _desc("native", ["host", "native", "x86_64", "aarch64", "riscv64", "aarch64-macos", "x86_64-macos"], ["emit-object"])
fn _native_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>: NativeCodegenAdapter(options: p.options).compile_module(m)
pub fn native_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _native_desc, _native_run, _object, [])

fn _cuda_desc() -> BackendDescV1: _desc("cuda", ["*"], ["emit-gpu"])
fn _cuda_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>:
    val _ = p
    CudaBackend.create((8, 6)).compile_module(m)
pub fn cuda_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _cuda_desc, _cuda_run, _gpu, [])

fn _hip_desc() -> BackendDescV1: _desc("hip", ["*"], ["emit-gpu"])
fn _hip_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>: HipBackend.create(p.options).compile_module(m)
pub fn hip_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _hip_desc, _hip_run, _gpu, [])

fn _opencl_desc() -> BackendDescV1: _desc("opencl", ["*"], ["emit-gpu"])
fn _opencl_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>: OpenClBackend.create(p.options).compile_module(m)
pub fn opencl_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _opencl_desc, _opencl_run, _gpu, [])

fn _vulkan_desc() -> BackendDescV1: _desc("vulkan", ["*"], ["emit-gpu"])
fn _vulkan_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>:
    val _ = p
    VulkanCodegenBackend.create([1, 3]).compile_module(m)
pub fn vulkan_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _vulkan_desc, _vulkan_run, _gpu, [])

fn _lean_desc() -> BackendDescV1: _desc("lean", ["*"], ["emit-proof"])
fn _lean_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>:
    val _ = p
    LeanBackend.create(VerificationLevel.Full).compile_module(m)
pub fn lean_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _lean_desc, _lean_run, _proof, [])

fn _byl_desc() -> BackendDescV1: _desc("byl", ["*"], ["emit-proof"])
fn _byl_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>:
    val _ = p
    BylBackend.create().compile_module(m)
pub fn byl_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _byl_desc, _byl_run, _proof, [])

fn _vhdl_desc() -> BackendDescV1: _desc("vhdl", ["*"], ["emit-hdl"])
fn _vhdl_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>: VhdlBackend.create(p.options.target, p.options).compile_module(m)
pub fn vhdl_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _vhdl_desc, _vhdl_run, _hdl, [])

fn _irtc_desc() -> BackendDescV1: _desc("irtc", ["avr", "i8086"], ["emit-object"])
fn _irtc_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>: IrTcCodegenAdapter(options: p.options).compile_module(m)
pub fn irtc_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _irtc_desc, _irtc_run, _object, [])

fn _lua_desc() -> BackendDescV1: _desc("lua", ["*"], ["emit-source"])
fn _lua_run(p: CodegenParamsV1, m: MirModule) -> Result<CodegenOutput, CompileError>: LuaCodegenAdapter(options: p.options).compile_module(m)
pub fn lua_backend_port_v1() -> BackendPortV1: BackendPortV1(backend_port_header(), backend_port_host_iface(), _lua_desc, _lua_run, _source, [])
