# Default full compiler composition preserves static PTX emission. Compiler
# builds select a committed overlay from simple.sdn for disabled/dynamic modes.
use compiler.backend.backend.backend_types.{BackendKind}
use compiler.backend.codegen_types.{CodegenOutputKind}
use compiler.backend.backend.static_backend_registry.{BackendLinkClass,
    StaticBackendEntryV1, static_backend_entry_v1}
use plugins.backend_cuda.cuda_backend_port.{cuda_backend_port_v1}

pub fn selected_cuda_backend_mode_v1() -> text: "static"

pub fn selected_cuda_backend_table_v1() -> [StaticBackendEntryV1]:
    [static_backend_entry_v1(BackendKind.Cuda, BackendLinkClass.PluginStatic,
        cuda_backend_port_v1(), CodegenOutputKind.GpuCode)]
