#![allow(REQC004)]
# Native Codegen Adapter
#
# Wraps the native ISel/RegAlloc/Encode pipeline to implement the Codegen trait.
# Delegates to compile_native() in native/mod.spl.

use compiler.mir.mir_data.{MirModule}
use compiler.mir.mir_instructions.{MirModule, MirFunction}
use compiler.mir.mir_types.{MirTypeKind}
use compiler.backend.backend.backend_types.{BackendKind, CodegenTarget, BackendCompileOptions, CompileError}
use compiler.backend.codegen_types.{Codegen, CodegenOutput, CodegenOutputKind}
use compiler.backend.native.mod.{native_compile_result, native_compile_result_with_x86_simd_capability}
use compiler.backend.native.native_avx2_capability.{
    NativeAvx2CapabilityV1, native_avx2_capability_v1
}
use compiler.backend.native.native_avx512_capability.{NativeAvx512CapabilityV1, native_avx512_capability_v1}
use compiler.backend.portable_numeric_capabilities.{PortableNumericLoweringPlan, portable_numeric_default_plan_for_target}
use std.io_runtime.{env_get_opt, host_os, host_arch}

# ============================================================================
# Native Codegen Adapter
# ============================================================================

class NativeCodegenAdapter:
    """Adapts native machine code pipeline to the Codegen trait interface."""
    options: BackendCompileOptions

impl NativeCodegenAdapter:
    fn plan() -> PortableNumericLoweringPlan:
        portable_numeric_default_plan_for_target(self.options.target)

    fn scalable_lowering_diagnostics(module: MirModule) -> [text]:
        if not native_module_has_scalable_vec(module):
            return []

        val plan = self.plan()
        if plan.lowering_modules_csv().contains("riscv_v"):
            return ["riscv_v_native_lowering_deferred"]

        ["scalable_vector_target_lacks_native_capability"]

    fn avx2_capability() -> NativeAvx2CapabilityV1:
        val caps = self.options.target_opt_ctx.x86_caps
        val admitted = caps.has_avx and caps.has_avx2
        val fingerprint = "x86-caps-v1:avx={caps.has_avx};avx2={caps.has_avx2};avx512={caps.has_avx512}"
        native_avx2_capability_v1(
            self.options.target.to_text(),
            "resolved-target-opt-context",
            fingerprint,
            admitted)

    fn avx512_capability() -> NativeAvx512CapabilityV1:
        val caps = self.options.target_opt_ctx.x86_caps
        val admitted = caps.has_avx and caps.has_avx512
        val fingerprint = "x86-caps-v1:avx={caps.has_avx};avx2={caps.has_avx2};avx512={caps.has_avx512};avx512bw={caps.has_avx512bw}"
        # The resolved target context is the AOT emission authority. Runtime
        # execution still passes through the process capability dispatcher.
        # avx512bw is read from the same resolved context rather than pinned
        # false; pinning it made byte/word ZMM lanes permanently unreachable.
        native_avx512_capability_v1(
            self.options.target.to_text(),
            "resolved-target-opt-context",
            fingerprint,
            admitted,
            admitted and caps.has_avx512bw,
            admitted)

fn native_module_has_scalable_vec(module: MirModule) -> bool:
    for func in module.functions.values():
        for local in func.locals:
            match local.type_.kind:
                case MirTypeKind.ScalableVec(_, _):
                    return true
                case _:
                    ()
    false

fn native_module_has_fixed_simd(module: MirModule) -> bool:
    for func in module.functions.values():
        for local in func.locals:
            match local.type_.kind:
                case MirTypeKind.Vec4f | MirTypeKind.Vec8f | MirTypeKind.Vec4d | MirTypeKind.Vec4i | MirTypeKind.Vec8i | MirTypeKind.Vec16f | MirTypeKind.Vec8d | MirTypeKind.Vec16i:
                    return true
                case _:
                    ()
    false

fn _native_effective_codegen_target(target: CodegenTarget) -> CodegenTarget:
    val raw_triple = env_get_opt("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    val darwin_triple = raw_triple.contains("-apple-darwin") or raw_triple.contains("-apple-macosx")
    val darwin_host = raw_triple == "" and (host_os() == "macos" or host_os() == "darwin")
    if darwin_triple:
        match target:
            case AArch64:
                return CodegenTarget.AArch64_MacOS
            case X86_64:
                return CodegenTarget.X86_64_MacOS
            case Host:
                val arch = host_arch()
                if arch == "aarch64" or arch == "arm64":
                    return CodegenTarget.AArch64_MacOS
                return CodegenTarget.X86_64_MacOS
            case _:
                return target
    if darwin_host and target == CodegenTarget.Host:
        val arch = host_arch()
        if arch == "aarch64" or arch == "arm64":
            return CodegenTarget.AArch64_MacOS
        return CodegenTarget.X86_64_MacOS
    if target == CodegenTarget.Host:
        val arch = host_arch()
        if arch == "aarch64" or arch == "arm64":
            return CodegenTarget.AArch64
        if arch == "riscv64":
            return CodegenTarget.Riscv64
        return CodegenTarget.X86_64
    target

impl Codegen for NativeCodegenAdapter:
    fn backend_kind() -> BackendKind: BackendKind.Native
    fn backend_name() -> text: "native"

    fn supports_target(target: CodegenTarget) -> bool:
        match target:
            case X86_64 | AArch64 | Riscv64: true
            case CodegenTarget.AArch64_MacOS | CodegenTarget.X86_64_MacOS: true
            case Host: true
            case _: false

    fn output_kind() -> CodegenOutputKind: CodegenOutputKind.ObjectCode

    fn compile_module(module: MirModule) -> Result<CodegenOutput, CompileError>:
        val scalable_diags = self.scalable_lowering_diagnostics(module)
        if scalable_diags.len() > 0:
            return Ok(CodegenOutput.object(module.name, []))

        val effective_target = _native_effective_codegen_target(self.options.target)
        val compiled = if (effective_target == CodegenTarget.X86_64 or effective_target == CodegenTarget.X86_64_MacOS) and native_module_has_fixed_simd(module):
            native_compile_result_with_x86_simd_capability(
                module, effective_target, self.avx2_capability(), self.avx512_capability())
        else:
            native_compile_result(module, effective_target)
        val bytes = if compiled.object_code.?: compiled.object_code.unwrap() else: []
        Ok(CodegenOutput.object(module.name, bytes))

# ============================================================================
# Exports
# ============================================================================
