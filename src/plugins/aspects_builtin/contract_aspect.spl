# Built-in "contract" advice body — moved out of the K0 weaver (WP-11, kernel/
# plugin split plan Phase 7 first step). See log_aspect.spl for the rationale
# (kernel_pluggable_partition.md §3: "Advice bodies are P").
#
# Moved verbatim from src/compiler/90.tools/aop.spl (class ContractAspect).
# No installer function existed for this one in aop.spl (check_pre/check_post
# are called directly by would-be callers, not wired through
# AopWeaver.add_before/add_after), so none is added here either.

class ContractAspect:
    enabled: bool

    fn check_pre(name: text, args: [Any]) -> bool:
        if not self.enabled:
            return true
        if name == nil or name.trim() == "":
            return false
        args != nil

    fn check_post(name: text, result: Any) -> bool:
        if not self.enabled:
            return true
        if name == nil or name.trim() == "":
            return false
        true
