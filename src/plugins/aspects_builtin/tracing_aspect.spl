# Built-in "tracing" advice body — moved out of the K0 weaver (WP-11, kernel/
# plugin split plan Phase 7 first step). See log_aspect.spl for the rationale
# (kernel_pluggable_partition.md §3: "Advice bodies are P").
#
# Moved verbatim from src/compiler/90.tools/aop.spl (class TracingAspect,
# AopWeaver.add_tracing_aspect). Byte-identical closures/orders (50).

use compiler.tools.aop.{AopWeaver, Pointcut}
use plugins.aspects_builtin.aspect_helpers.{aop_first_arg}

class TracingAspect:
    level: i64

    fn before(name: text, args: [Any]):
        print "[TRACE] enter {name}"

    fn after(name: text, result: Any):
        print "[TRACE] exit {name}"

# Free-function replacement for the former `AopWeaver.add_tracing_aspect`
# method — see log_aspect.spl's `install_log_aspect` for why it moved.
pub fn install_tracing_aspect(weaver: AopWeaver, aspect: TracingAspect, pointcut: Pointcut):
    val before_handler: fn(text, [Any]) -> Any = \name, args:
        if args == nil:
            aspect.before(name, [])
        else:
            aspect.before(name, args)
    weaver.add_before(pointcut, before_handler, 50)

    val after_handler: fn(text, [Any]) -> Any = \name, args:
        if args == nil:
            aspect.after(name, nil)
        else if args.len() > 0:
            aspect.after(name, aop_first_arg(args))
        else:
            aspect.after(name, nil)
    weaver.add_after(pointcut, after_handler, 50)
