# Shared helper for the built-in advice-body installers (WP-11). Moved
# verbatim from src/compiler/90.tools/aop.spl's private `_aop_first_arg`; it
# has no dependency on any specific aspect and is used by both
# log_aspect.spl and tracing_aspect.spl, so it lives once here rather than
# being duplicated into each.

pub fn aop_first_arg(args: [Any]) -> Any?:
    if args == nil:
        return nil
    if args.len() == 0:
        return nil
    args[0]
