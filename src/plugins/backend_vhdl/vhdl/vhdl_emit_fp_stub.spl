# vhdl.emit.data datapath (see rtl_riscv_mdsoc_capsules.md Feature A rows).

pub fn vhdl_emit_fp_op_stub() -> text:
    "-- VHDL-EMIT-FP-STUB-NOT-IMPLEMENTED: FP op lowering is Feature A work"
