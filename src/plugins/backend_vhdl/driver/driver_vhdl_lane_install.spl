# Installs the VHDL plugin into the kernel driver's VHDL lane slot
# (compiler.driver.driver_vhdl_lane). Imported only by full composition roots:
# the full static backend registry and the standalone simple-vhdl entry.
use compiler.common.driver_core_types.{CompileResult}
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_vhdl_lane.{DriverVhdlLaneV1, install_driver_vhdl_lane_v1}
use compiler.driver.driver_public_compile_vhdl.{vhdl_public_compile_file_v1}
use plugins.backend_vhdl.driver.driver_aot_vhdl_output.*

fn _vhdl_lane_compile_driver_v1(driver: CompilerDriver, output: text) -> CompileResult:
    var target = driver
    target.compile_to_vhdl(output)

fn _vhdl_lane_compile_file_v1(path: text, output: text) -> CompileResult:
    vhdl_public_compile_file_v1(path, output)

pub fn install_vhdl_driver_lane_v1() -> bool:
    install_driver_vhdl_lane_v1(DriverVhdlLaneV1(name: "vhdl",
        compile_driver_fn: _vhdl_lane_compile_driver_v1,
        compile_file_fn: _vhdl_lane_compile_file_v1))
