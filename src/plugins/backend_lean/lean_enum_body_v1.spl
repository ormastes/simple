# EE-01 public consumer: validate the actual module/function, then emit each
# retained segment and checked decision node once. No caller plan is authority.
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirTerminator, MirInstKind, MirOperandKind}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirConstValue}
use compiler.mir.mir_json.{serialize_mir_type}
use compiler.mir.enum_semantic_validation_v1.{validate_enum_semantics_v1}
use compiler.mir.enum_semantic_identity_v1.{enum_semantic_type_definition_identity_v1}
use compiler.mir.enum_pattern_totality_v1.{EnumPatternDecisionKindV1}
use compiler.backend.backend.backend_types.{CompileError}
use plugins.backend_lean.lean_type_declarations.{LeanTypeContext,
    lean_context_type_to_lean}
use plugins.backend_lean.lean_nominal_body.{LeanNominalBodyEmitter,
    lean_nominal_emitter_for_function_v1}
use plugins.backend_lean.lean_enum_cfg_v1.{lean_enum_error_v1, lean_enum_cfg_v1,
    lean_enum_join_states_v1, LeanEnumJoinedStateV1, LeanEnumPatternValuesV1,
    lean_enum_values_fork_v1, lean_enum_path_variable_v1,
    lean_enum_constructor_pattern_v1}
use plugins.backend_lean.lean_enum_continuations_v1.{LeanEnumFlowGraphV1,
    LeanEnumFlowNodeV1, LeanEnumFlowEdgeV1, lean_enum_flow_graph_v1}

struct LeanEnumIncomingV1:
    emitter: LeanNominalBodyEmitter
    values: LeanEnumPatternValuesV1

struct LeanEnumCheckedNodeV1:
    joined: LeanEnumJoinedStateV1
    input_values: LeanEnumPatternValuesV1
    output: LeanNominalBodyEmitter
    output_values: LeanEnumPatternValuesV1
    lines: [text]
    terminator_value: text

fn lean_enum_empty_values_v1() -> LeanEnumPatternValuesV1:
    LeanEnumPatternValuesV1(terms: {}, types: {})

class LeanEnumConsumerV1:
    module: MirModule
    function: MirFunction
    context: LeanTypeContext
    graph: LeanEnumFlowGraphV1
    incoming: Dict<i64, [LeanEnumIncomingV1]>
    checked: Dict<i64, LeanEnumCheckedNodeV1>
    guard_nodes: Dict<text, i64>
    return_type: text
    remaining: i64

impl LeanEnumConsumerV1:
    me charge(amount: i64) -> Result<(), CompileError>:
        if amount < 0 or amount > self.remaining:
            return Err(lean_enum_error_v1("EE-E-LIMIT", "enum consumer work exhausted"))
        self.remaining = self.remaining - amount
        Ok(())

    me push_input(target: i64, state: LeanEnumIncomingV1) -> Result<(), CompileError>:
        self.charge(1)?
        var states: [LeanEnumIncomingV1] = []
        if self.incoming.has(target): states = self.incoming[target]
        states.push(state)
        self.incoming[target] = states
        Ok(())

    me join_values(states: [LeanEnumIncomingV1]) -> Result<LeanEnumPatternValuesV1, CompileError>:
        var result = lean_enum_empty_values_v1()
        if states.len() == 0:
            return Err(lean_enum_error_v1("EE-E-AVAILABILITY", "missing incoming value environment"))
        var keys: [text] = []
        for key in states[0].values.terms.keys(): keys.push(key)
        keys.sort()
        for key in keys:
            var common = true
            for state in states:
                self.charge(1)?
                if not state.values.terms.has(key) or not state.values.types.has(key):
                    common = false
                elif serialize_mir_type(state.values.types[key]) !=
                        serialize_mir_type(states[0].values.types[key]):
                    return Err(lean_enum_error_v1("EE-E-PATTERN", "semantic path type differs at join"))
            if common:
                result.terms[key] = states[0].values.terms[key]
                result.types[key] = states[0].values.types[key]
        Ok(result)

    me post_guard_values(leaf_index: i64, post_guard: LeanNominalBodyEmitter
    ) -> Result<LeanEnumPatternValuesV1, CompileError>:
        val leaf = self.graph.nodes[leaf_index]
        val semantic = self.graph.plan.matches[leaf.match_index]
        val decisions = self.graph.plan.decision_plans[semantic.match_id]
        val captured = self.checked[leaf_index].output_values
        var result = lean_enum_empty_values_v1()
        var root_live = false
        match semantic.scrutinee_operand.kind:
            case Copy(local) | Move(local):
                root_live = post_guard.live.has(local.id) and post_guard.live[local.id]
            case Const(_, _):
                root_live = true
        for key in captured.terms.keys():
            self.charge(1)?
            if root_live:
                result.terms[key] = captured.terms[key]
                result.types[key] = captured.types[key]
            else:
                # A distinct materialized binder is an actual MIR owner. A
                # preguard semantic projection by itself is not such an owner.
                match decisions.nodes[leaf.decision_index].kind:
                    case SelectArm(_, bindings, _):
                        for binding in bindings:
                            self.charge(1)?
                            val identity = binding.destination_local.id
                            if (binding.value_path.key == key and post_guard.live.has(identity)
                                    and post_guard.live[identity]):
                                post_guard.same_type(post_guard.types[identity], captured.types[key])?
                                result.terms[key] = "_l{identity}"
                                result.types[key] = captured.types[key]
                    case _:
                        return Err(lean_enum_error_v1("EE-E-EDGE", "guard origin is not a selected arm"))
        # Missing facts are not an error until a later Test or Bind reads one.
        # A wildcard continuation with a constant body needs no root value.
        Ok(result)

    me check_node(index: i64) -> Result<(), CompileError>:
        self.charge(1)?
        val node = self.graph.nodes[index]
        if not self.incoming.has(index):
            return Err(lean_enum_error_v1("EE-E-EDGE", "continuation has no predecessor state"))
        val states = self.incoming[index]
        var emitters: [LeanNominalBodyEmitter] = []
        for state in states: emitters.push(state.emitter)
        val joined = lean_enum_join_states_v1(self.function, self.context, emitters, self.remaining)?
        self.remaining = joined.remaining
        var input_values = self.join_values(states)?
        if node.kind == 2:
            val semantic = self.graph.plan.matches[node.match_index]
            for key in input_values.terms.keys():
                self.charge(1)?
                input_values.terms[key] = lean_enum_path_variable_v1(semantic.match_id, key)
        self.charge(input_values.terms.keys().len() + self.function.locals.len())?
        var values = lean_enum_values_fork_v1(input_values)
        var emitter = joined.emitter.fork_for_branch(self.function.locals)?
        emitter.constant_nodes_left = self.remaining
        var lines: [text] = []
        var terminator_value = ""
        if node.kind == 0:
            val block = self.function.blocks[node.block_index]
            for position in node.start..node.end:
                self.charge(1)?
                emitter.constant_nodes_left = self.remaining
                val line = match emitter.instruction(block.instructions[position]):
                    case Ok(value): value
                    case Err(error):
                        return Err(lean_enum_error_v1("EE-E-AVAILABILITY", error.message))
                self.remaining = emitter.constant_nodes_left
                if line != "": lines.push(line)
            if node.terminal:
                match block.terminator:
                    case If(condition, _, _):
                        terminator_value = match emitter.operand(condition, MirType(kind: MirTypeKind.Bool)):
                            case Ok(value): value
                            case Err(error): return Err(lean_enum_error_v1("EE-E-AVAILABILITY", error.message))
                    case Ret(value):
                        if val operand = value:
                            terminator_value = emitter.operand(operand, self.function.signature.return_type)?
                        else:
                            emitter.same_type(self.function.signature.return_type, MirType(kind: MirTypeKind.Unit))?
                            terminator_value = "()"
                    case Goto(_): ()
                    case _: return Err(lean_enum_error_v1("EE-E-EDGE", "unsupported terminal"))
            values = lean_enum_empty_values_v1()
        elif node.kind == 1:
            val semantic = self.graph.plan.matches[node.match_index]
            val subject = emitter.operand(semantic.scrutinee_operand, semantic.scrutinee_semantic_type)?
            val name = lean_enum_path_variable_v1(semantic.match_id, "$")
            val type_ = lean_context_type_to_lean(semantic.scrutinee_semantic_type, self.context)?
            lines.push("let {name} : {type_} := {subject}")
            values = lean_enum_empty_values_v1()
            values.terms["$"] = name
            values.types["$"] = semantic.scrutinee_semantic_type
        else:
            val semantic = self.graph.plan.matches[node.match_index]
            val decisions = self.graph.plan.decision_plans[semantic.match_id]
            match decisions.nodes[node.decision_index].kind:
                case SelectArm(_, bindings, _):
                    for binding in bindings:
                        self.charge(1)?
                        val key = binding.value_path.key
                        if not values.terms.has(key) or not values.types.has(key):
                            return Err(lean_enum_error_v1("EE-E-AVAILABILITY", "missing bound semantic path"))
                        emitter.same_type(values.types[key], binding.value_path.type_)?
                        val line = match emitter.bind(binding.destination_local,
                                binding.value_path.type_, values.terms[key]):
                            case Ok(value): value
                            case Err(error): return Err(lean_enum_error_v1("EE-E-AVAILABILITY", error.message))
                        lines.push(line)
                case Test(path, _):
                    if not values.terms.has(path.key) or not values.types.has(path.key):
                        return Err(lean_enum_error_v1("EE-E-AVAILABILITY", "missing tested semantic path"))
                    emitter.same_type(values.types[path.key], path.type_)?
                case Residual:
                    return Err(lean_enum_error_v1("EE-E-RESIDUAL", "uncovered decision state"))
        if emitter.constant_nodes_left < self.remaining:
            self.remaining = emitter.constant_nodes_left
        self.checked[index] = LeanEnumCheckedNodeV1(joined: joined,
            input_values: input_values, output: emitter, output_values: values,
            lines: lines, terminator_value: terminator_value)
        if node.guard_match >= 0:
            val callback = self.graph.callback_name(node.guard_match, node.guard_arm)
            self.guard_nodes[callback] = index
        for edge in node.successors:
            self.charge(values.terms.keys().len() + self.function.locals.len())?
            var next_values = lean_enum_values_fork_v1(values)
            if edge.kind == 1:
                val semantic = self.graph.plan.matches[node.match_index]
                match edge.test.unwrap():
                    case Constructor(_, _) | Product:
                        val pattern = lean_enum_constructor_pattern_v1(self.module,
                            semantic.match_id, edge.path.unwrap(), edge.test.unwrap(),
                            self.context, values, self.remaining)?
                        self.remaining = pattern.remaining
                        next_values = pattern.values
                    case _: ()
            elif edge.kind == 2:
                if not self.checked.has(edge.source_leaf):
                    return Err(lean_enum_error_v1("EE-E-EDGE", "guard origin is not earlier in graph"))
                # Recheck semantic path ownership against the actual postguard
                # maps. Captured terms cannot resurrect a consumed root.
                next_values = self.post_guard_values(edge.source_leaf, emitter)?
            elif self.graph.nodes[edge.target].kind == 0:
                next_values = lean_enum_empty_values_v1()
            val fork = emitter.fork_for_branch(self.function.locals)?
            self.push_input(edge.target, LeanEnumIncomingV1(emitter: fork, values: next_values))?
        Ok(())

    fn value_keys(values: LeanEnumPatternValuesV1) -> [text]:
        var keys: [text] = []
        for key in values.terms.keys(): keys.push(key)
        keys.sort()
        keys

    me callback_parameters(callback: text) -> Result<text, CompileError>:
        self.charge(self.function.locals.len())?
        if not self.guard_nodes.has(callback):
            return Err(lean_enum_error_v1("EE-E-EDGE", "missing guard callback owner"))
        val state = self.checked[self.guard_nodes[callback]].output
        var parameters: [text] = []
        var ids: [i64] = []
        for local in self.function.locals:
            if state.live.has(local.id.id) and state.live[local.id.id]: ids.push(local.id.id)
        ids.sort()
        for identity in ids:
            val type_ = lean_context_type_to_lean(state.types[identity], self.context)?
            parameters.push("(_l{identity} : {type_})")
        if parameters.len() == 0: return Ok("(_ee_unit : _root_.Unit)")
        Ok(parameters.join(" "))

    me callback_type(callback: text) -> Result<text, CompileError>:
        self.charge(self.function.locals.len())?
        if not self.guard_nodes.has(callback):
            return Err(lean_enum_error_v1("EE-E-EDGE", "missing guard callback owner"))
        val state = self.checked[self.guard_nodes[callback]].output
        var types: [text] = []
        var ids: [i64] = []
        for local in self.function.locals:
            if state.live.has(local.id.id) and state.live[local.id.id]: ids.push(local.id.id)
        ids.sort()
        for identity in ids:
            types.push("(" + lean_context_type_to_lean(state.types[identity], self.context)? + ")")
        if types.len() == 0: types.push("_root_.Unit")
        types.push("(" + self.return_type + ")")
        Ok(types.join(" → "))

    me callback_arguments(callback: text) -> Result<text, CompileError>:
        self.charge(self.function.locals.len())?
        if not self.guard_nodes.has(callback):
            return Err(lean_enum_error_v1("EE-E-EDGE", "missing guard callback owner"))
        val state = self.checked[self.guard_nodes[callback]].output
        var ids: [i64] = []
        for local in self.function.locals:
            if state.live.has(local.id.id) and state.live[local.id.id]: ids.push(local.id.id)
        ids.sort()
        var terms: [text] = []
        for identity in ids: terms.push("_l{identity}")
        if terms.len() == 0: return Ok("()")
        Ok(terms.join(" "))

    me call(target: i64, emitter: LeanNominalBodyEmitter,
        values: LeanEnumPatternValuesV1, available_callbacks: [text],
        overrides: Dict<text, text> = {}
    ) -> Result<text, CompileError>:
        val node = self.graph.nodes[target]
        val state = self.checked[target]
        var arguments: [text] = []
        for identity in state.joined.parameter_ids:
            self.charge(1)?
            if not emitter.live.has(identity) or not emitter.live[identity]:
                return Err(lean_enum_error_v1("EE-E-AVAILABILITY", "continuation requires consumed local"))
            arguments.push("_l{identity}")
        for key in self.value_keys(state.input_values):
            self.charge(1)?
            if not values.terms.has(key) or not values.types.has(key):
                return Err(lean_enum_error_v1("EE-E-AVAILABILITY", "continuation requires unavailable path"))
            emitter.same_type(values.types[key], state.input_values.types[key])?
            arguments.push(values.terms[key])
        for callback in node.callbacks:
            self.charge(1)?
            if overrides.has(callback): arguments.push(overrides[callback])
            elif available_callbacks.contains(callback): arguments.push(callback)
            else: return Err(lean_enum_error_v1("EE-E-EDGE", "unbound failure continuation"))
        if arguments.len() == 0: arguments.push("()")
        Ok(node.name + " " + arguments.join(" "))

    me render_test(index: i64) -> Result<text, CompileError>:
        val node = self.graph.nodes[index]
        val state = self.checked[index]
        val semantic = self.graph.plan.matches[node.match_index]
        val decisions = self.graph.plan.decision_plans[semantic.match_id]
        match decisions.nodes[node.decision_index].kind:
            case Test(path, edges):
                val value = state.output_values.terms[path.key]
                var lines: [text] = []
                var integer_edges = false
                var fallback = -1
                for edge in node.successors:
                    match edge.test.unwrap():
                        case Integer(_): integer_edges = true
                        case OtherInteger:
                            integer_edges = true
                            if fallback >= 0:
                                return Err(lean_enum_error_v1("EE-E-PATTERN", "duplicate integer residual"))
                            fallback = edge.target
                        case _: ()
                if integer_edges:
                    if fallback < 0:
                        return Err(lean_enum_error_v1("EE-E-RESIDUAL", "integer decision lacks other-value case"))
                    var depth = ""
                    for edge in node.successors:
                        match edge.test.unwrap():
                            case Integer(literal):
                                self.charge(self.function.locals.len())?
                                var literal_emitter = state.output.fork_for_branch(self.function.locals)?
                                literal_emitter.constant_nodes_left = self.remaining
                                val constant = literal_emitter.composite_constant(MirConstValue.Int(literal), path.type_, 1)?
                                self.remaining = literal_emitter.constant_nodes_left
                                lines.push(depth + "if " + value + " == " + constant + " then")
                                val call = self.call(edge.target, state.output, state.output_values, node.callbacks)?
                                lines.push(depth + "  " + call)
                                lines.push(depth + "else")
                                depth = depth + "  "
                            case OtherInteger: ()
                            case _: return Err(lean_enum_error_v1("EE-E-PATTERN", "mixed scalar decision domains"))
                    lines.push(depth + self.call(fallback, state.output, state.output_values, node.callbacks)?)
                else:
                    if edges.len() == 0: return Ok("nomatch " + value)
                    lines.push("match " + value + " with")
                    for edge in node.successors:
                        self.charge(1 + state.output_values.terms.keys().len())?
                        var pattern = ""
                        var values = lean_enum_values_fork_v1(state.output_values)
                        match edge.test.unwrap():
                            case Bool(flag): pattern = if flag: "true" else: "false"
                            case Constructor(_, _) | Product:
                                val projected = lean_enum_constructor_pattern_v1(self.module,
                                    semantic.match_id, path, edge.test.unwrap(), self.context, values, self.remaining)?
                                self.remaining = projected.remaining
                                pattern = projected.pattern
                                values = projected.values
                            case _: return Err(lean_enum_error_v1("EE-E-PATTERN", "unsupported decision edge"))
                        val call = self.call(edge.target, state.output, values, node.callbacks)?
                        lines.push("| " + pattern + " =>")
                        lines.push("  " + call)
                Ok(lines.join("\n"))
            case _: Err(lean_enum_error_v1("EE-E-PATTERN", "expected a test node"))

    me render_tail(index: i64) -> Result<text, CompileError>:
        val node = self.graph.nodes[index]
        val state = self.checked[index]
        if node.kind == 2:
            val semantic = self.graph.plan.matches[node.match_index]
            val decisions = self.graph.plan.decision_plans[semantic.match_id]
            match decisions.nodes[node.decision_index].kind:
                case Test(_, _): return self.render_test(index)
                case SelectArm(arm_index, _, guard_false):
                    var overrides: Dict<text, text> = {}
                    if guard_false != nil:
                        val callback = self.graph.callback_name(node.match_index, arm_index)
                        val target = self.graph.keys["d{semantic.match_id}:{guard_false.unwrap()}"]
                        val guard_output = self.checked[self.guard_nodes[callback]].output
                        val surviving_values = self.post_guard_values(index, guard_output)?
                        val continuation = self.call(target, guard_output, surviving_values, node.callbacks)?
                        val parameters = self.callback_parameters(callback)?
                        overrides[callback] = "(fun " + parameters + " => " + continuation + ")"
                    return self.call(node.successors[0].target, state.output,
                        lean_enum_empty_values_v1(), node.callbacks, overrides)
                case Residual: return Err(lean_enum_error_v1("EE-E-RESIDUAL", "uncovered leaf"))
        if node.kind == 0 and node.terminal:
            val block = self.function.blocks[node.block_index]
            match block.terminator:
                case Ret(_): return Ok(state.terminator_value)
                case If(_, _, _):
                    val yes = self.call(node.successors[0].target, state.output,
                        lean_enum_empty_values_v1(), node.callbacks)?
                    var no = ""
                    var guard_alias = ""
                    if node.guard_match >= 0:
                        val callback = self.graph.callback_name(node.guard_match, node.guard_arm)
                        val semantic = self.graph.plan.matches[node.guard_match]
                        val failure = semantic.arms[node.guard_arm].guard_failure_entry.id
                        # Keep the actual physical false-successor spelling in
                        # emitted control flow while the typed callback remains
                        # uniquely named across shared continuation scopes.
                        guard_alias = "let ee_b{failure} := " + callback + "\n"
                        no = "ee_b{failure} " + self.callback_arguments(callback)?
                    else:
                        no = self.call(node.successors[1].target, state.output,
                            lean_enum_empty_values_v1(), node.callbacks)?
                    return Ok(guard_alias + "if " + state.terminator_value + " then\n  " + yes + "\nelse\n  " + no)
                case _: ()
        if node.successors.len() != 1:
            return Err(lean_enum_error_v1("EE-E-EDGE", "ordinary continuation has ambiguous successor"))
        self.call(node.successors[0].target, state.output, state.output_values, node.callbacks)

    me emit() -> Result<text, CompileError>:
        var definitions: [text] = []
        var position = self.graph.order.len() - 1
        while position >= 0:
            self.charge(1)?
            val index = self.graph.order[position]
            val node = self.graph.nodes[index]
            val state = self.checked[index]
            var parameters: [text] = []
            if state.joined.parameters != "": parameters.push(state.joined.parameters)
            for key in self.value_keys(state.input_values):
                self.charge(1)?
                val type_ = lean_context_type_to_lean(state.input_values.types[key], self.context)?
                parameters.push("(" + state.input_values.terms[key] + " : " + type_ + ")")
            for callback in node.callbacks:
                self.charge(1)?
                parameters.push("(" + callback + " : " + self.callback_type(callback)? + ")")
            if parameters.len() == 0: parameters.push("(_ee_unit : _root_.Unit)")
            definitions.push("let " + node.name + " " + parameters.join(" ") +
                " : " + self.return_type + " :=")
            for line in state.lines:
                for physical_line in line.split("\n"): definitions.push("  " + physical_line)
            val tail = self.render_tail(index)?
            for line in tail.split("\n"): definitions.push("  " + line)
            position = position - 1
        val entry_state = self.checked[self.graph.entry]
        if self.graph.nodes[self.graph.entry].callbacks.len() > 0:
            return Err(lean_enum_error_v1("EE-E-EDGE", "function entry has free failure continuations"))
        definitions.push(self.call(self.graph.entry, entry_state.joined.emitter,
            lean_enum_empty_values_v1(), [])?)
        Ok(definitions.join("\n"))

struct LeanEnumBodyResultV1:
    semantic_function: MirFunction
    body: text

pub fn prepare_mir_enum_body_v1(module: MirModule, function: MirFunction,
    context: LeanTypeContext
) -> Result<LeanEnumBodyResultV1, CompileError>:
    val plan = match validate_enum_semantics_v1(module, function):
        case Ok(value): value
        case Err(error): return Err(lean_enum_error_v1("EE-E-VALIDATION", error.message()))
    # Context is checked against exact retained declarations before its names
    # can be used to render validated pattern paths.
    for identity in plan.declarations.keys():
        if not context.definitions.has(identity):
            return Err(lean_enum_error_v1("EE-E-DECLARATION", "type context omits validated owner"))
        if (enum_semantic_type_definition_identity_v1(context.definitions[identity]) !=
                enum_semantic_type_definition_identity_v1(plan.declarations[identity])):
            return Err(lean_enum_error_v1("EE-E-DECLARATION", "type context differs from validated declaration"))
    val semantic = plan.semantic_function
    val cfg = lean_enum_cfg_v1(function, plan.work_remaining)?
    val graph = lean_enum_flow_graph_v1(semantic, plan, cfg.remaining)?
    var consumer = LeanEnumConsumerV1(module: module, function: semantic,
        context: context, graph: graph, incoming: {}, checked: {}, guard_nodes: {},
        return_type: lean_context_type_to_lean(semantic.signature.return_type, context)?,
        remaining: graph.remaining)
    val initial = lean_nominal_emitter_for_function_v1(semantic, context)?
    consumer.push_input(graph.entry, LeanEnumIncomingV1(emitter: initial, values: lean_enum_empty_values_v1()))?
    for index in graph.order: consumer.check_node(index)?
    val body = consumer.emit()?
    Ok(LeanEnumBodyResultV1(semantic_function: semantic, body: body))

pub fn translate_mir_enum_body_v1(module: MirModule, function: MirFunction,
    context: LeanTypeContext
) -> Result<text, CompileError>:
    val result = prepare_mir_enum_body_v1(module, function, context)?
    Ok(result.body)

pub fn lean_enum_missing_metadata_v1(function: MirFunction) -> text:
    # Negative admission only: runtime names never establish enum semantics.
    # Preserve the established independently checked Result witness route.
    var helper = false
    var result_witness = false
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case ResultMatchSemantic(_, _, _, _, _, _, _): result_witness = true
                case Call(_, callee, _):
                    match callee.kind:
                        case Const(MirConstValue.Str(name), _):
                            if name.starts_with("rt_enum_"): helper = true
                        case _: ()
                case _: ()
    if helper and not result_witness:
        return "EE-E-METADATA: enum carrier operations require validated producer metadata"
    ""

export LeanEnumBodyResultV1, prepare_mir_enum_body_v1, translate_mir_enum_body_v1
export lean_enum_missing_metadata_v1
