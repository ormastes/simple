# C2: pure nominal linear flow, terminal branch or one diamond join.
# No native-layout certificate.
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_instructions.{MirFunction, MirBody, MirInst, MirInstKind, MirOperand, MirOperandKind, MirTerminator, AggregateKind}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirTypeDef, MirTypeDefKind, MirLocal, LocalId, LocalKind}
use compiler.mir.mir_json.{serialize_mir_type}
use compiler.backend.backend.backend_types.{BackendKind, CompileError, compileerror_backend_error}
use plugins.backend_lean.lean_type_declarations.{LeanTypeContext, lean_context_type_to_lean, lean_type_quote_name}
use plugins.backend_lean.lean_mir_translate.{translate_mir_body, translate_const_value_exact, translate_binop, translate_unaryop}

fn nominal_body_error(reason: text) -> CompileError:
    compileerror_backend_error(BackendKind.Lean, "lean-nominal-body: " + reason)

fn nominal_fixed_integer(type_: MirType) -> bool:
    match type_.kind:
        case I8 | I16 | I32 | I64 | U8 | U16 | U32 | U64: true
        case _: false

fn nominal_equality_scalar(type_: MirType) -> bool:
    if nominal_fixed_integer(type_): return true
    match type_.kind:
        case Bool | Char | Unit: true
        case _: false

fn nominal_type_requested(type_: MirType) -> bool:
    # Follow only retained families admitted by the existing nominal type mapper.
    # A scalar-only Result does not select this route merely by being a Result.
    match type_.kind:
        case Struct(_) | Enum(_): true
        case Array(element, _) | Slice(element): nominal_type_requested(element)
        case Tuple(elements):
            for element in elements:
                if nominal_type_requested(element): return true
            false
        case Result(ok_type, error_type):
            nominal_type_requested(ok_type) or nominal_type_requested(error_type)
        case _: false

fn nominal_body_requested(function: MirFunction, body: MirBody) -> bool:
    # Retained nominal evidence, not an incidental constructor, selects exact
    # owner/type/argument validation for instruction-free nominal selections too.
    if nominal_type_requested(function.signature.return_type): return true
    for parameter in function.signature.params:
        if nominal_type_requested(parameter): return true
    for local in body.locals:
        if nominal_type_requested(local.type_): return true
    for block in body.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case Aggregate(_, kind, _):
                    match kind:
                        case Struct(_) | Enum(_, _): return true
                        case _: pass
                case GetField(_, _, _): return true
                case _: pass
    false

struct LeanNominalFlowPlan:
    prefix: [i64]
    branch_index: i64
    then_path: [i64]
    else_path: [i64]
    join_path: [i64] = []

class LeanNominalFlowPlanner:
    body: MirBody
    indices: Dict<i64, i64>
    visited: Dict<i64, bool>
    visited_count: i64

    me path(start: i64, allow_branch: bool,
        forbidden: Dict<i64, bool> = {}) -> Result<[i64], CompileError>:
        var order: [i64] = []
        var current = start
        while order.len() < self.body.blocks.len():
            if not self.indices.has(current):
                return Err(nominal_body_error("missing successor block"))
            if forbidden.has(current):
                return Err(nominal_body_error("cyclic linear flow into prefix"))
            if self.visited.has(current):
                return Err(nominal_body_error("cyclic linear flow or shared branch block"))
            self.visited[current] = true
            self.visited_count = self.visited_count + 1
            val index = self.indices[current]
            order.push(index)
            match self.body.blocks[index].terminator:
                case Goto(target):
                    if not self.indices.has(target.id):
                        return Err(nominal_body_error("missing successor block"))
                    if self.visited.has(target.id):
                        return Err(nominal_body_error("cyclic linear flow or shared branch block"))
                    current = target.id
                case Ret(_): return Ok(order)
                case If(_, _, _):
                    if allow_branch: return Ok(order)
                    return Err(nominal_body_error("nested conditional requires general structured flow"))
                case _:
                    return Err(nominal_body_error("requires only Goto edges, one terminal If and exact returns"))
        Err(nominal_body_error("cyclic linear flow or shared branch block"))

fn nominal_flow_plan(body: MirBody, entry_id: i64) -> Result<LeanNominalFlowPlan, CompileError>:
    # Validate complete flow before emission. Each arm has a private traversal
    # map; the two retained paths may share only one identical returning suffix.
    var indices: Dict<i64, i64> = {}
    for index in 0..body.blocks.len():
        val identity = body.blocks[index].id.id
        if identity < 0 or indices.has(identity):
            return Err(nominal_body_error("negative or duplicate block identity"))
        indices[identity] = index
    if not indices.has(entry_id):
        return Err(nominal_body_error("missing entry block"))
    var planner = LeanNominalFlowPlanner(body: body, indices: indices, visited: {}, visited_count: 0)
    val prefix = planner.path(entry_id, true)?
    val terminal = prefix[prefix.len() - 1]
    var branch_index = -1
    var then_path: [i64] = []
    var else_path: [i64] = []
    var join_path: [i64] = []
    match body.blocks[terminal].terminator:
        case If(_, then_target, else_target):
            branch_index = terminal
            var then_planner = LeanNominalFlowPlanner(body: body, indices: indices, visited: {}, visited_count: 0)
            var else_planner = LeanNominalFlowPlanner(body: body, indices: indices, visited: {}, visited_count: 0)
            val then_full = then_planner.path(then_target.id, false, planner.visited)?
            val else_full = else_planner.path(else_target.id, false, planner.visited)?
            var prefix_members: Dict<i64, bool> = {}
            for index in prefix: prefix_members[index] = true
            var then_positions: Dict<i64, i64> = {}
            for position in 0..then_full.len():
                val index = then_full[position]
                if prefix_members.has(index):
                    return Err(nominal_body_error("branch enters the prefix"))
                then_positions[index] = position
                planner.visited[body.blocks[index].id.id] = true
                planner.visited_count = planner.visited_count + 1
            var shared_then = -1
            var shared_else = -1
            for position in 0..else_full.len():
                val index = else_full[position]
                if prefix_members.has(index):
                    return Err(nominal_body_error("branch enters the prefix"))
                if then_positions.has(index):
                    if shared_else < 0:
                        shared_then = then_positions[index]
                        shared_else = position
                else:
                    planner.visited[body.blocks[index].id.id] = true
                    planner.visited_count = planner.visited_count + 1
            if shared_else < 0:
                then_path = then_full
                else_path = else_full
            else:
                val remaining = then_full.len() - shared_then
                if remaining != else_full.len() - shared_else:
                    return Err(nominal_body_error("branch join has inconsistent suffix"))
                for offset in 0..remaining:
                    if then_full[shared_then + offset] != else_full[shared_else + offset]:
                        return Err(nominal_body_error("branch join has crossing successors"))
                    join_path.push(then_full[shared_then + offset])
                for position in 0..shared_then: then_path.push(then_full[position])
                for position in 0..shared_else: else_path.push(else_full[position])
        case Ret(_): pass
        case _: return Err(nominal_body_error("invalid planned prefix terminator"))
    # Count only admitted unique visits. Native Dict.len is not count authority.
    if planner.visited_count != body.blocks.len():
        return Err(nominal_body_error("unvisited block outside nominal flow"))
    Ok(LeanNominalFlowPlan(prefix: prefix, branch_index: branch_index,
        then_path: then_path, else_path: else_path, join_path: join_path))

class LeanNominalBodyEmitter:
    context: LeanTypeContext
    types: Dict<i64, MirType>
    assigned: Dict<i64, bool>
    live: Dict<i64, bool>

    fn fork_for_branch(locals: [MirLocal]) -> Result<LeanNominalBodyEmitter, CompileError>:
        # Dict handles are mutable. Allocate both maps afresh, never copy handles.
        var branch_assigned: Dict<i64, bool> = {}
        var branch_live: Dict<i64, bool> = {}
        for local in locals:
            val identity = local.id.id
            if self.assigned.has(identity):
                val assigned_value = self.assigned[identity]
                branch_assigned[identity] = assigned_value
                if not branch_assigned.has(identity) or branch_assigned[identity] != assigned_value:
                    return Err(nominal_body_error("cannot retain branch definition state"))
            if self.live.has(identity):
                val live_value = self.live[identity]
                branch_live[identity] = live_value
                if not branch_live.has(identity) or branch_live[identity] != live_value:
                    return Err(nominal_body_error("cannot retain branch liveness state"))
        # No emitter method mutates the shared types/context maps.
        Ok(LeanNominalBodyEmitter(context: self.context, types: self.types,
            assigned: branch_assigned, live: branch_live))

    me instruction_lines(body: MirBody, order: [i64]) -> Result<[text], CompileError>:
        var lines: [text] = []
        for block_index in order:
            for instruction in body.blocks[block_index].instructions:
                lines.push(self.instruction(instruction)?)
        Ok(lines)

    me returning_path(body: MirBody, order: [i64]) -> Result<text, CompileError>:
        var lines = self.instruction_lines(body, order)?
        val return_index = order[order.len() - 1]
        match body.blocks[return_index].terminator:
            case Ret(value):
                if val operand = value:
                    lines.push(self.operand(operand, body.return_ty)?)
                else:
                    self.same_type(body.return_ty, MirType(kind: MirTypeKind.Unit))?
                    lines.push("()")
            case _: return Err(nominal_body_error("requires an exact return terminator"))
        Ok(lines.join("\n"))

    me diamond_lines(body: MirBody, flow: LeanNominalFlowPlan,
        condition_term: text) -> Result<[text], CompileError>:
        # The caller has already consumed the Bool condition. Emit each arm in
        # its own state; a returning_path would incorrectly return the function
        # result here instead of transporting the values needed by the suffix.
        var then_emitter = self.fork_for_branch(body.locals)?
        var else_emitter = self.fork_for_branch(body.locals)?
        var then_lines = then_emitter.instruction_lines(body, flow.then_path)?
        var else_lines = else_emitter.instruction_lines(body, flow.else_path)?
        var merged_assigned: Dict<i64, bool> = {}
        var merged_live: Dict<i64, bool> = {}
        var transport_names: [text] = []
        var transport_types: [text] = []
        for local in body.locals:
            val identity = local.id.id
            # Definition history is a union; a one-arm definition cannot be
            # redefined later merely because it is not definitely live.
            if then_emitter.assigned.has(identity) or else_emitter.assigned.has(identity):
                merged_assigned[identity] = true
            val both_live = (
                then_emitter.live.has(identity) and then_emitter.live[identity] and
                else_emitter.live.has(identity) and else_emitter.live[identity])
            if both_live:
                merged_live[identity] = true
                # Dominating values are unchanged: bind() rejects redefining
                # them in either arm, so their existing outer binding suffices.
                if not self.assigned.has(identity):
                    transport_names.push("_l{identity}")
                    transport_types.push(lean_context_type_to_lean(local.type_, self.context)?)
        var pattern = "_"
        var transport_type = "_root_.Unit"
        var transport_value = "()"
        if transport_names.len() == 1:
            pattern = transport_names[0]
            transport_type = transport_types[0]
            transport_value = transport_names[0]
        elif transport_names.len() > 1:
            pattern = "(" + transport_names.join(", ") + ")"
            var product_types: [text] = []
            for type_name in transport_types: product_types.push("(" + type_name + ")")
            transport_type = "(" + product_types.join(" × ") + ")"
            transport_value = "(" + transport_names.join(", ") + ")"
        then_lines.push(transport_value)
        else_lines.push(transport_value)
        var lines: [text] = []
        lines.push("let " + pattern + " : " + transport_type + " :=")
        lines.push("  if " + condition_term + " then")
        for line in then_lines: lines.push("    " + line)
        lines.push("  else")
        for line in else_lines: lines.push("    " + line)
        # Publish merged state only after both arms and the transport types
        # succeed. The suffix is checked once against these fresh maps.
        self.assigned = merged_assigned
        self.live = merged_live
        val suffix = self.returning_path(body, flow.join_path)?
        for line in suffix.split("\n"): lines.push(line)
        Ok(lines)

    fn local_type(local: LocalId) -> Result<MirType, CompileError>:
        if not self.types.has(local.id):
            return Err(nominal_body_error("missing local {local.id}"))
        Ok(self.types[local.id])

    fn same_type(actual: MirType, expected: MirType) -> Result<(), CompileError>:
        val _actual_name = lean_context_type_to_lean(actual, self.context)?
        val _expected_name = lean_context_type_to_lean(expected, self.context)?
        if serialize_mir_type(actual) != serialize_mir_type(expected):
            return Err(nominal_body_error("exact MIR type mismatch"))
        Ok(())

    fn operand_type(operand: MirOperand) -> Result<MirType, CompileError>:
        match operand.kind:
            case Copy(local) | Move(local): self.local_type(local)
            case Const(_, type_): Ok(type_)

    me operand(operand: MirOperand, expected: MirType) -> Result<text, CompileError>:
        val actual = self.operand_type(operand)?
        self.same_type(actual, expected)?
        match operand.kind:
            case Copy(local) | Move(local):
                if not self.live.has(local.id) or not self.live[local.id]:
                    return Err(nominal_body_error("use before definition or after move: {local.id}"))
                match operand.kind:
                    case Move(_): self.live[local.id] = false
                    case _: pass
                Ok("_l{local.id}")
            case Const(value, type_): translate_const_value_exact(value, type_)

    me bind(dest: LocalId, expected: MirType, term: text) -> Result<text, CompileError>:
        self.same_type(self.local_type(dest)?, expected)?
        if self.assigned.has(dest.id):
            return Err(nominal_body_error("local redefinition requires mutable state semantics: {dest.id}"))
        val target = lean_context_type_to_lean(expected, self.context)?
        self.assigned[dest.id] = true
        self.live[dest.id] = true
        Ok("let _l{dest.id} : {target} := {term}")

    fn definition(symbol: SymbolId, is_enum: bool) -> Result<MirTypeDef, CompileError>:
        if not self.context.definitions.has(symbol.id):
            return Err(nominal_body_error("missing admitted declaration {symbol.id}"))
        val expected = MirType(kind: if is_enum: MirTypeKind.Enum(symbol) else: MirTypeKind.Struct(symbol))
        val _name = lean_context_type_to_lean(expected, self.context)?
        val definition = self.context.definitions[symbol.id]
        if definition.symbol.id != symbol.id:
            return Err(nominal_body_error("declaration symbol identity differs"))
        Ok(definition)

    me instruction(instruction: MirInst) -> Result<text, CompileError>:
        match instruction.kind:
            case Const(dest, value, type_):
                val term = translate_const_value_exact(value, type_)?
                self.bind(dest, type_, term)
            case Copy(dest, source):
                val type_ = self.local_type(source)?
                val term = self.operand(MirOperand(kind: MirOperandKind.Copy(source)), type_)?
                self.bind(dest, type_, term)
            case Move(dest, source):
                val type_ = self.local_type(source)?
                val term = self.operand(MirOperand(kind: MirOperandKind.Move(source)), type_)?
                self.bind(dest, type_, term)
            case BinOp(dest, op, left, right):
                # Reuse the exact existing operator policy, including its refusals.
                val operator = translate_binop(op)?
                val input_type = self.operand_type(left)?
                var output_type = input_type
                match op:
                    case Eq | Ne:
                        if not nominal_equality_scalar(input_type):
                            return Err(nominal_body_error("equality requires an admitted scalar representation"))
                        output_type = MirType(kind: MirTypeKind.Bool)
                    case Add | Sub | Mul | BitAnd | BitOr | BitXor:
                        if not nominal_fixed_integer(input_type):
                            return Err(nominal_body_error("arithmetic and bitwise operations require a fixed-width integer"))
                    case _: return Err(nominal_body_error("unsupported scalar operator in nominal body"))
                val left_term = self.operand(left, input_type)?
                val right_term = self.operand(right, input_type)?
                self.bind(dest, output_type, "(" + left_term + ") " + operator + " (" + right_term + ")")
            case UnaryOp(dest, op, operand):
                val operator = translate_unaryop(op)?
                val type_ = self.operand_type(operand)?
                match op:
                    case Not:
                        self.same_type(type_, MirType(kind: MirTypeKind.Bool))?
                    case Neg | BitNot:
                        if not nominal_fixed_integer(type_):
                            return Err(nominal_body_error("negation and bitwise complement require a fixed-width integer"))
                    case _: return Err(nominal_body_error("unsupported scalar unary operator in nominal body"))
                val term = self.operand(operand, type_)?
                self.bind(dest, type_, operator + "(" + term + ")")
            case Aggregate(dest, kind, operands):
                match kind:
                    case Struct(symbol):
                        val definition = self.definition(symbol, false)?
                        match definition.kind:
                            case Struct(fields):
                                if operands.len() != fields.len():
                                    return Err(nominal_body_error("struct field arity mismatch"))
                                var terms: [text] = []
                                for index in 0..fields.len():
                                    terms.push("(" + self.operand(operands[index], fields[index].type_)? + ")")
                                val constructor = self.context.names[symbol.id] + ".mk"
                                val term = if terms.len() == 0: constructor else: constructor + " " + terms.join(" ")
                                self.bind(dest, MirType(kind: MirTypeKind.Struct(symbol)), term)
                            case _: Err(nominal_body_error("struct declaration kind differs"))
                    case Enum(symbol, discriminant):
                        val definition = self.definition(symbol, true)?
                        match definition.kind:
                            case Enum(variants):
                                var selected = -1
                                for index in 0..variants.len():
                                    if variants[index].discriminant == discriminant: selected = index
                                if selected < 0:
                                    return Err(nominal_body_error("unknown enum discriminant {discriminant}"))
                                val variant = variants[selected]
                                var term = self.context.names[symbol.id] + "." + lean_type_quote_name(variant.name)
                                if val payload = variant.payload:
                                    if operands.len() != 1:
                                        return Err(nominal_body_error("enum payload arity mismatch"))
                                    term = term + " (" + self.operand(operands[0], payload)? + ")"
                                else:
                                    if operands.len() != 0:
                                        return Err(nominal_body_error("nullary enum has operands"))
                                self.bind(dest, MirType(kind: MirTypeKind.Enum(symbol)), term)
                            case _: Err(nominal_body_error("enum declaration kind differs"))
                    case _: Err(nominal_body_error("non-nominal aggregate in nominal body is unsupported"))
            case GetField(dest, base, index):
                val base_type = self.operand_type(base)?
                match base_type.kind:
                    case Struct(symbol):
                        val definition = self.definition(symbol, false)?
                        match definition.kind:
                            case Struct(fields):
                                if index < 0 or index >= fields.len():
                                    return Err(nominal_body_error("struct field index out of range: {index}"))
                                val term = self.operand(base, base_type)?
                                val projection = self.context.names[symbol.id] + "." + lean_type_quote_name(fields[index].name)
                                self.bind(dest, fields[index].type_, projection + " (" + term + ")")
                            case _: Err(nominal_body_error("projection declaration kind differs"))
                    case _: Err(nominal_body_error("field projection requires an admitted struct value"))
            case _: Err(nominal_body_error("unsupported instruction in pure nominal body: {instruction.kind}"))

fn translate_mir_nominal_body(function: MirFunction, context: LeanTypeContext) -> Result<text, CompileError>:
    """Emit typed nominal construction/projection using this module's declarations.

    Bodies with no retained nominal type or nominal operation retain their
    existing translator. A nominal body must be an acyclic Goto chain or one
    If with two returning chains, optionally sharing one linear return suffix.
    Each path is single-assignment with an exact typed return.
    Disconnected blocks, crossing successors and nested branches are refused.
    Unsupported operations return an error; no partial source is returned.
    """
    val body = MirBody.from_function(function)
    if not nominal_body_requested(function, body): return translate_mir_body(body)
    val flow = nominal_flow_plan(body, function.entry_block.id)?
    if not function.signature.params_known or function.signature.is_variadic:
        return Err(nominal_body_error("requires a known nonvariadic signature"))
    var types: Dict<i64, MirType> = {}
    var assigned: Dict<i64, bool> = {}
    var live: Dict<i64, bool> = {}
    var arguments: Dict<i64, bool> = {}
    var accepted_arg_count: i64 = 0
    for local in body.locals:
        if local.id.id < 0 or types.has(local.id.id):
            return Err(nominal_body_error("negative or duplicate local identity"))
        val _type_name = lean_context_type_to_lean(local.type_, context)?
        types[local.id.id] = local.type_
        match local.kind:
            case Arg(index):
                if index < 0 or index >= function.signature.params.len() or arguments.has(index):
                    return Err(nominal_body_error("invalid or duplicate argument index"))
                if serialize_mir_type(local.type_) != serialize_mir_type(function.signature.params[index]):
                    return Err(nominal_body_error("argument local disagrees with signature"))
                arguments[index] = true
                accepted_arg_count = accepted_arg_count + 1
                assigned[local.id.id] = true
                live[local.id.id] = true
            case _: pass
    # Count accepted unique argument rows without the native Dict.len fallback.
    if accepted_arg_count != function.signature.params.len():
        return Err(nominal_body_error("missing argument local"))
    var emitter = LeanNominalBodyEmitter(context: context, types: types, assigned: assigned, live: live)
    if flow.branch_index < 0:
        return emitter.returning_path(body, flow.prefix)
    var lines = emitter.instruction_lines(body, flow.prefix)?
    match body.blocks[flow.branch_index].terminator:
        case If(condition, _, _):
            # Consume the condition before either independent arm state exists.
            val condition_term = emitter.operand(condition, MirType(kind: MirTypeKind.Bool))?
            if flow.join_path.len() > 0:
                val diamond = emitter.diamond_lines(body, flow, condition_term)?
                for line in diamond: lines.push(line)
            else:
                var then_emitter = emitter.fork_for_branch(body.locals)?
                var else_emitter = emitter.fork_for_branch(body.locals)?
                val then_code = then_emitter.returning_path(body, flow.then_path)?
                val else_code = else_emitter.returning_path(body, flow.else_path)?
                lines.push("if " + condition_term + " then")
                for line in then_code.split("\n"): lines.push("  " + line)
                lines.push("else")
                for line in else_code.split("\n"): lines.push("  " + line)
        case _: return Err(nominal_body_error("invalid planned branch terminator"))
    Ok(lines.join("\n"))

export translate_mir_nominal_body
