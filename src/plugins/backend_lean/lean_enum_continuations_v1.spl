# EE-01 bounded graph of retained physical instruction segments and checked
# pattern-specialization nodes. This owner never recognizes runtime spellings.
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirTerminator}
use compiler.mir.mir_enum_semantic_types.{MirEnumSiteKindV1}
use compiler.mir.enum_semantic_validation_v1.{ValidatedEnumSemanticsV1}
use compiler.mir.enum_pattern_totality_v1.{EnumPatternDecisionKindV1,
    EnumPatternDecisionTestV1, EnumPatternValuePathV1}
use compiler.backend.backend.backend_types.{CompileError}
use plugins.backend_lean.lean_enum_cfg_v1.{lean_enum_error_v1}

struct LeanEnumFlowEdgeV1:
    target: i64
    # 0 ordinary, 1 constructor/scalar decision, 2 post-guard false transfer.
    kind: i64 = 0
    test: EnumPatternDecisionTestV1? = nil
    path: EnumPatternValuePathV1? = nil
    source_leaf: i64 = -1

struct LeanEnumFlowNodeV1:
    # 0 physical segment, 1 match entry, 2 checked decision.
    kind: i64
    name: text
    block_index: i64 = -1
    start: i64 = 0
    end: i64 = 0
    match_index: i64 = -1
    decision_index: i64 = -1
    guard_match: i64 = -1
    guard_arm: i64 = -1
    terminal: bool = false
    successors: [LeanEnumFlowEdgeV1] = []
    callbacks: [text] = []

class LeanEnumFlowGraphV1:
    function: MirFunction
    plan: ValidatedEnumSemanticsV1
    nodes: [LeanEnumFlowNodeV1]
    keys: Dict<text, i64>
    order: [i64]
    entry: i64
    remaining: i64

impl LeanEnumFlowGraphV1:
    me charge(amount: i64) -> Result<(), CompileError>:
        if amount < 0 or amount > self.remaining:
            return Err(lean_enum_error_v1("EE-E-LIMIT", "continuation graph work exhausted"))
        self.remaining = self.remaining - amount
        Ok(())

    me with_successor(node: LeanEnumFlowNodeV1, edge: LeanEnumFlowEdgeV1
    ) -> Result<LeanEnumFlowNodeV1, CompileError>:
        # Memoized targets still allocate a new edge. Debit before array
        # growth; later graph traversals retain their separate work charges.
        self.charge(1)?
        var updated = node
        updated.successors.push(edge)
        Ok(updated)

    fn callback_name(match_index: i64, arm_index: i64) -> text:
        val row = self.plan.matches[match_index].arms[arm_index]
        "ee_b{row.guard_failure_entry.id}_g{match_index}_{arm_index}"

    me cursor_name(block_id: i64, cursor: i64) -> Result<text, CompileError>:
        # An actual body/guard cursor owns its stable public label. Expanded
        # alternatives sharing a cursor use one physical continuation.
        for semantic in self.plan.matches:
            self.charge(1)?
            for arm in semantic.arms:
                self.charge(1)?
                if val entry = arm.guard_entry:
                    if entry.id == block_id and arm.guard_entry_instruction_index == cursor:
                        return Ok("ee_m{semantic.match_id}_a{arm.expanded_alternative_index}_guard")
                if arm.body_entry.id == block_id and arm.body_entry_instruction_index == cursor:
                    return Ok("ee_m{semantic.match_id}_a{arm.expanded_alternative_index}_body")
        Ok(if cursor == 0: "ee_b{block_id}" else: "ee_b{block_id}_i{cursor}")

    me cursor(block_id: i64, cursor: i64) -> Result<i64, CompileError>:
        val key = "b{block_id}:{cursor}"
        if self.keys.has(key): return Ok(self.keys[key])
        self.charge(1)?
        if not self.plan.block_indices.has(block_id):
            return Err(lean_enum_error_v1("EE-E-EDGE", "missing continuation block"))
        val block_index = self.plan.block_indices[block_id]
        val block = self.function.blocks[block_index]
        if cursor < 0 or cursor > block.instructions.len():
            return Err(lean_enum_error_v1("EE-E-EDGE", "continuation cursor out of range"))
        var node = LeanEnumFlowNodeV1(kind: 0, name: self.cursor_name(block_id, cursor)?,
            block_index: block_index, start: cursor, end: block.instructions.len())
        for match_index in 0..self.plan.matches.len():
            self.charge(1)?
            val semantic = self.plan.matches[match_index]
            if semantic.entry_block.id == block_id:
                val boundary = self.plan.match_entry_instruction_indices[semantic.match_id]
                if boundary == cursor:
                    if node.kind == 1:
                        return Err(lean_enum_error_v1("EE-E-EDGE", "overlapping semantic match entries"))
                    node.kind = 1
                    node.match_index = match_index
                    node.end = cursor
                elif boundary > cursor and boundary < node.end:
                    node.end = boundary
            for arm in semantic.arms:
                self.charge(1)?
                if arm.body_entry.id == block_id:
                    val boundary = arm.body_entry_instruction_index
                    if boundary > cursor and boundary < node.end: node.end = boundary
                if val entry = arm.guard_entry:
                    val boundary = arm.guard_entry_instruction_index
                    if entry.id == block_id and boundary > cursor and boundary < node.end:
                        node.end = boundary
        val index = self.nodes.len()
        if index >= 4096:
            return Err(lean_enum_error_v1("EE-E-LIMIT", "continuation node bound exceeded"))
        self.keys[key] = index
        self.nodes.push(node)
        Ok(index)

    me decision(match_index: i64, decision_index: i64) -> Result<i64, CompileError>:
        val semantic = self.plan.matches[match_index]
        val key = "d{semantic.match_id}:{decision_index}"
        if self.keys.has(key): return Ok(self.keys[key])
        self.charge(1)?
        val decisions = self.plan.decision_plans[semantic.match_id]
        if decision_index < 0 or decision_index >= decisions.nodes.len():
            return Err(lean_enum_error_v1("EE-E-PATTERN", "decision index out of range"))
        val index = self.nodes.len()
        if index >= 4096:
            return Err(lean_enum_error_v1("EE-E-LIMIT", "continuation node bound exceeded"))
        self.keys[key] = index
        self.nodes.push(LeanEnumFlowNodeV1(kind: 2,
            name: "ee_m{semantic.match_id}_d{decision_index}",
            match_index: match_index, decision_index: decision_index))
        Ok(index)

    me expand(index: i64) -> Result<(), CompileError>:
        var node = self.nodes[index]
        if node.kind == 1:
            val semantic = self.plan.matches[node.match_index]
            val decisions = self.plan.decision_plans[semantic.match_id]
            val target = self.decision(node.match_index, decisions.root_node)?
            node = self.with_successor(node, LeanEnumFlowEdgeV1(target: target))?
        elif node.kind == 2:
            val semantic = self.plan.matches[node.match_index]
            val decisions = self.plan.decision_plans[semantic.match_id]
            match decisions.nodes[node.decision_index].kind:
                case Test(path, edges):
                    for edge in edges:
                        val target = self.decision(node.match_index, edge.target_node)?
                        node = self.with_successor(node, LeanEnumFlowEdgeV1(target: target,
                            kind: 1, test: Some(edge.test), path: Some(path)))?
                case SelectArm(arm_index, _, guard_false):
                    if arm_index < 0 or arm_index >= semantic.arms.len():
                        return Err(lean_enum_error_v1("EE-E-PATTERN", "selected arm out of range"))
                    val arm = semantic.arms[arm_index]
                    var target = -1
                    if val guard = arm.guard_entry:
                        if guard_false == nil:
                            return Err(lean_enum_error_v1("EE-E-EDGE", "guard has no residual successor"))
                        target = self.cursor(guard.id, arm.guard_entry_instruction_index)?
                        # Materialize the failure specialization now. Its actual
                        # dataflow edge is added at the recorded guard terminator.
                        val _failure = self.decision(node.match_index, guard_false.unwrap())?
                    else:
                        if guard_false != nil:
                            return Err(lean_enum_error_v1("EE-E-EDGE", "unguarded arm has false continuation"))
                        target = self.cursor(arm.body_entry.id, arm.body_entry_instruction_index)?
                    node = self.with_successor(node, LeanEnumFlowEdgeV1(target: target))?
                case Residual:
                    return Err(lean_enum_error_v1("EE-E-RESIDUAL", "uncovered pattern state"))
        else:
            val block = self.function.blocks[node.block_index]
            for cursor in node.start..node.end:
                self.charge(1)?
                if self.plan.replaced_instruction_sites.has("{block.id.id}:{cursor}"):
                    return Err(lean_enum_error_v1("EE-E-SITE",
                        "retained continuation overlaps a replaced pattern instruction"))
            var cursor_boundary = node.end < block.instructions.len()
            if node.end > node.start:
                for semantic in self.plan.matches:
                    self.charge(1)?
                    if (semantic.entry_block.id == block.id.id and
                            self.plan.match_entry_instruction_indices[semantic.match_id] == node.end):
                        cursor_boundary = true
                    for arm in semantic.arms:
                        self.charge(1)?
                        if arm.body_entry.id == block.id.id and arm.body_entry_instruction_index == node.end:
                            cursor_boundary = true
                        if val entry = arm.guard_entry:
                            if entry.id == block.id.id and arm.guard_entry_instruction_index == node.end:
                                cursor_boundary = true
            if cursor_boundary:
                val target = self.cursor(block.id.id, node.end)?
                node = self.with_successor(node, LeanEnumFlowEdgeV1(target: target))?
            else:
                node.terminal = true
                if self.plan.replaced_terminator_blocks.has(block.id.id):
                    return Err(lean_enum_error_v1("EE-E-SITE", "retained continuation overlaps pattern edge"))
                for match_index in 0..self.plan.matches.len():
                    self.charge(1)?
                    val semantic = self.plan.matches[match_index]
                    for site in semantic.sites:
                        self.charge(1)?
                        match site.kind:
                            case Guard:
                                if site.block_id.id == block.id.id:
                                    for arm_index in 0..semantic.arms.len():
                                        self.charge(1)?
                                        if semantic.arms[arm_index].pattern_root == site.related_pattern_node:
                                            if node.guard_match >= 0:
                                                return Err(lean_enum_error_v1("EE-E-EDGE", "ambiguous guard site"))
                                            node.guard_match = match_index
                                            node.guard_arm = arm_index
                            case _: ()
                match block.terminator:
                    case Goto(target):
                        val next_node = self.cursor(target.id, 0)?
                        node = self.with_successor(node, LeanEnumFlowEdgeV1(target: next_node))?
                    case If(_, yes, no):
                        val yes_node = self.cursor(yes.id, 0)?
                        node = self.with_successor(node, LeanEnumFlowEdgeV1(target: yes_node))?
                        if node.guard_match < 0:
                            val no_node = self.cursor(no.id, 0)?
                            node = self.with_successor(node, LeanEnumFlowEdgeV1(target: no_node))?
                        # Guard false edges are linked after all SelectArm
                        # nodes have been materialized.
                    case Ret(_): ()
                    case _:
                        return Err(lean_enum_error_v1("EE-E-EDGE", "unsupported retained terminator"))
        self.nodes[index] = node
        Ok(())

    me finish() -> Result<(), CompileError>:
        var cursor = 0
        while cursor < self.nodes.len():
            self.expand(cursor)?
            cursor = cursor + 1
        # Each guard is compiled once. False transfers pair its post-guard
        # local state with the matching leaf's immutable semantic path values.
        for index in 0..self.nodes.len():
            var node = self.nodes[index]
            if node.guard_match < 0: continue
            val semantic = self.plan.matches[node.guard_match]
            val decisions = self.plan.decision_plans[semantic.match_id]
            var found = false
            for leaf_index in 0..self.nodes.len():
                self.charge(1)?
                val leaf = self.nodes[leaf_index]
                if leaf.kind != 2 or leaf.match_index != node.guard_match: continue
                match decisions.nodes[leaf.decision_index].kind:
                    case SelectArm(arm_index, _, guard_false):
                        if arm_index == node.guard_arm and guard_false != nil:
                            val target_key = "d{semantic.match_id}:{guard_false.unwrap()}"
                            if not self.keys.has(target_key):
                                return Err(lean_enum_error_v1("EE-E-EDGE", "missing guard residual node"))
                            node = self.with_successor(node, LeanEnumFlowEdgeV1(target: self.keys[target_key],
                                kind: 2, source_leaf: leaf_index))?
                            found = true
                    case _: ()
            if not found:
                return Err(lean_enum_error_v1("EE-E-EDGE", "guard has no decision origin"))
            self.nodes[index] = node
        var indegrees: [i64] = []
        for _node in self.nodes: indegrees.push(0)
        for node in self.nodes:
            for edge in node.successors:
                self.charge(1)?
                indegrees[edge.target] = indegrees[edge.target] + 1
        var ready: [i64] = []
        for index in 0..self.nodes.len():
            if indegrees[index] == 0: ready.push(index)
        if ready.len() != 1 or ready[0] != self.entry:
            return Err(lean_enum_error_v1("EE-E-EDGE", "disconnected semantic continuation"))
        var head = 0
        while head < ready.len():
            self.charge(1 + self.nodes[ready[head]].successors.len())?
            val index = ready[head]
            head = head + 1
            self.order.push(index)
            for edge in self.nodes[index].successors:
                indegrees[edge.target] = indegrees[edge.target] - 1
                if indegrees[edge.target] == 0: ready.push(edge.target)
        if self.order.len() != self.nodes.len():
            return Err(lean_enum_error_v1("EE-E-EDGE", "cyclic semantic continuation graph"))
        if ready.len() == 0 or self.order[0] != self.entry:
            return Err(lean_enum_error_v1("EE-E-EDGE", "disconnected semantic continuation"))
        # Callback requirements propagate backward, except that a SelectArm
        # binds its own guard's failure continuation at the call site.
        var position = self.order.len() - 1
        while position >= 0:
            val index = self.order[position]
            var node = self.nodes[index]
            var callbacks: [text] = []
            if node.guard_match >= 0:
                callbacks.push(self.callback_name(node.guard_match, node.guard_arm))
            var bound = ""
            if node.kind == 2:
                val semantic = self.plan.matches[node.match_index]
                val decisions = self.plan.decision_plans[semantic.match_id]
                match decisions.nodes[node.decision_index].kind:
                    case SelectArm(arm_index, _, guard_false):
                        if guard_false != nil: bound = self.callback_name(node.match_index, arm_index)
                    case _: ()
            for edge in node.successors:
                for callback in self.nodes[edge.target].callbacks:
                    self.charge(1 + callbacks.len())?
                    if callback != bound and not callbacks.contains(callback):
                        callbacks.push(callback)
            callbacks.sort()
            node.callbacks = callbacks
            self.nodes[index] = node
            position = position - 1
        Ok(())

fn lean_enum_flow_graph_v1(function: MirFunction,
    plan: ValidatedEnumSemanticsV1, remaining: i64
) -> Result<LeanEnumFlowGraphV1, CompileError>:
    var graph = LeanEnumFlowGraphV1(function: function, plan: plan,
        nodes: [], keys: {}, order: [], entry: -1, remaining: remaining)
    graph.entry = graph.cursor(function.entry_block.id, 0)?
    graph.finish()?
    Ok(graph)

export LeanEnumFlowEdgeV1, LeanEnumFlowNodeV1, LeanEnumFlowGraphV1, lean_enum_flow_graph_v1
