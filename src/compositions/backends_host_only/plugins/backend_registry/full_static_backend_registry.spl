# Host-only static backend registry overlay (src/compositions/backends_host_only).
# When `--source src/compositions/backends_host_only` precedes `src/plugins`,
# closure discovery resolves `plugins.backend_registry.full_static_backend_registry`
# to this module and never traverses optional GPU, VHDL, Wasm, C, Lean, Lua,
# Native, or LLVM-lib static backend closures.
use compiler.backend.static_backend_registry.{
    StaticBackendEntryV1, installed_k1_static_backend_policy_v1,
    installed_k1_static_backend_table_v1,
    install_host_only_static_backend_composition_v1}
use compiler.common.cuda_backend_policy.{install_cuda_backend_mode_v1}
use std.io_runtime.{env_get_opt}

fn _host_only_overlay_admits_mode_v1(mode: text) -> bool:
    val normalized = mode.trim().lower()
    normalized == "" or normalized == "host-only"

pub fn plugin_static_backend_table_v1() -> [StaticBackendEntryV1]:
    []

pub fn full_static_backend_table_for_k1_policy_v1(policy: text) -> [StaticBackendEntryV1]:
    if policy == "" or policy != installed_k1_static_backend_policy_v1():
        return []
    val configured = env_get_opt("SIMPLE_BACKEND_COMPOSITION") ?? ""
    if not _host_only_overlay_admits_mode_v1(configured):
        return []
    installed_k1_static_backend_table_v1()

# reason: boolean installation verdict matches the v1 static backend registry installer ABI across CLI and worker entrypoints
@allow(primitive_api)
pub fn install_static_backends_for_composition_mode_v1(
    mode: text, policy: text
) -> bool:
    if policy == "" or policy != installed_k1_static_backend_policy_v1():
        return false
    if not _host_only_overlay_admits_mode_v1(mode):
        return false
    if not install_cuda_backend_mode_v1("disabled"): return false
    install_host_only_static_backend_composition_v1(policy)

# reason: boolean installation verdict matches the v1 static backend registry installer ABI across CLI and worker entrypoints
@allow(primitive_api)
pub fn install_full_static_backends_for_k1_policy_v1(policy: text) -> bool:
    val configured = env_get_opt("SIMPLE_BACKEND_COMPOSITION") ?? ""
    install_static_backends_for_composition_mode_v1(configured, policy)
