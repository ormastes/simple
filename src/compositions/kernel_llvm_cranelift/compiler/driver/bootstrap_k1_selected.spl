use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{CompileResult}
use compiler.backend.backend.backend_types.{BackendKind}
use compiler.backend.codegen_types.{CodegenOutputKind}
use compiler.backend.backend.static_backend_registry.{
    BackendLinkClass, StaticBackendEntryV1, install_k1_static_backend_table_v1,
    static_backend_entry_v1}
use compiler.backend.backend.static_backend_cranelift_port.{cranelift_backend_port_v1}
use compiler.backend.backend.static_backend_interpreter_port.{interpreter_backend_port_v1}
use compiler.backend.backend.static_backend_llvm_port.{llvm_backend_port_v1}
use compiler.driver.driver_bootstrap.{
    bootstrap_compile_to_native_local as combined_compile_local,
    bootstrap_compile_context_to_native_local as combined_compile_context
}

pub fn selected_k1_backend_policy_v1() -> text:
    "llvm-cranelift"

pub fn selected_k1_backend_table_v1() -> [StaticBackendEntryV1]:
    [
        static_backend_entry_v1(BackendKind.Cranelift,
            BackendLinkClass.KernelLinked, cranelift_backend_port_v1(),
            CodegenOutputKind.ObjectCode),
        static_backend_entry_v1(BackendKind.Interpreter,
            BackendLinkClass.KernelLinked, interpreter_backend_port_v1(),
            CodegenOutputKind.InterpretedResult),
        static_backend_entry_v1(BackendKind.Llvm,
            BackendLinkClass.KernelLinked, llvm_backend_port_v1(),
            CodegenOutputKind.ObjectCode)
    ]

pub fn install_selected_k1_backend_table_v1() -> bool:
    install_k1_static_backend_table_v1(selected_k1_backend_policy_v1(),
        selected_k1_backend_table_v1())

pub fn bootstrap_compile_to_native_local(ctx: CompileContext, backend_name: text,
        output: text) -> CompileResult:
    if not install_selected_k1_backend_table_v1():
        error("PLUG-E-K1-POLICY: LLVM+Cranelift composition admission failed")
    combined_compile_local(ctx, backend_name, output)

pub fn bootstrap_compile_context_to_native_local(ctx: CompileContext,
        backend_name: text, output: text) -> CompileResult:
    if not install_selected_k1_backend_table_v1():
        error("PLUG-E-K1-POLICY: LLVM+Cranelift composition admission failed")
    combined_compile_context(ctx, backend_name, output)
