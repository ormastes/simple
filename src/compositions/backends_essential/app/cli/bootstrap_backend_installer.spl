# Essential-backend projection of app.cli.bootstrap_backend_installer.
# Selected by listing --source src/compositions/backends_essential ahead of
# src/app (first root wins). Installs only the K1 table of the paired kernel
# root and never names plugins.backend_registry, so the P-static backends and
# their closures (native isel_aarch64/isel_riscv*/macho, C, Wasm, CUDA, HIP,
# OpenCL, Vulkan, Lean, Byl, IrTc, Lua, LlvmLib) are not compiled into the
# binary. CUDA placement is installed as "disabled" so a PTX request answers
# PLUG-E-DISABLED rather than an unselected policy.
use compiler.driver.bootstrap_k1_selected.{
    install_selected_k1_backend_table_v1, selected_k1_backend_policy_v1}
use compiler.backend.static_backend_registry.{
    active_static_backend_table_v1, validate_k1_static_backend_table_v1}
use compiler.common.cuda_backend_policy.{install_cuda_backend_mode_v1}
use app.cli.bootstrap_essential_backend_request.{
    bootstrap_essential_backend_choices_v1,
    bootstrap_essential_backend_request_error_v1}

pub fn bootstrap_install_worker_backends_v1() -> bool:
    if not install_selected_k1_backend_table_v1(): return false
    if not install_cuda_backend_mode_v1("disabled"): return false
    # A previously installed full table cannot silently widen this composition.
    validate_k1_static_backend_table_v1(selected_k1_backend_policy_v1(),
        active_static_backend_table_v1())

pub fn bootstrap_backend_request_error_v1(backend: text, plugin_path: text) -> text:
    bootstrap_essential_backend_request_error_v1(selected_k1_backend_policy_v1(),
        backend, plugin_path)

pub fn bootstrap_backend_choices_v1() -> text:
    bootstrap_essential_backend_choices_v1(selected_k1_backend_policy_v1())

pub fn bootstrap_backend_capability_label_v1() -> text: ""
