"""MDSOC++ composition for the throughput-oriented internal linker."""

use common.kernel_plugin.ids.{KpfId128, KpfDigest256}
use common.kernel_plugin.contracts.*
use std.mdsocpp.*

pub const LINKER_FAST_MEMORY_BUDGET_BYTES: u64 = 6000000000

fn memory_contract() -> KpfMemoryContractV1:
    KpfMemoryContractV1(
        memory_class: KPF_MEMORY_NOGC_GENERAL,
        initialization_bytes: 67108864,
        persistent_bytes_per_instance: 536870912,
        bytes_per_session: 0,
        bytes_per_inflight_request: 0,
        input_alignment: 64,
        output_alignment: 64,
        maximum_sessions: 1,
        maximum_inflight_per_session: 1,
        maximum_batch_items: 1,
        may_allocate_after_activation: KPF_FLAG_TRUE,
        reserved0: 0,
    )

fn concurrency_contract() -> KpfConcurrencyContractV1:
    KpfConcurrencyContractV1(
        mode: KPF_CONCURRENCY_SNAPSHOT_READ_PARALLEL,
        reentrancy: KPF_REENTRANCY_FORBIDDEN,
        maximum_concurrent_calls: 8,
        deterministic_completion: KPF_FLAG_TRUE,
        reserved0: 0,
    )

pub fn linker_fast_capsule_v1() -> CapsuleDescriptorV1:
    CapsuleDescriptorV1(
        capsule_id: KpfId128(hi: 0x4c494e4b45524641, lo: 0x5354000000000001),
        closure: MdsocppClosure.Complete,
        provided_facets: [MdsocppFacetOfferV1(facet_id: KpfId128(hi: 0x4c494e4b45520000, lo: 1))],
        required_facets: [],
        required_capability_bits: 0,
        memory: memory_contract(),
        concurrency: concurrency_contract(),
        uses_ecs: false,
        state_migrations: [],
    )

pub fn linker_fast_policy_v1(generation: u64) -> MdsocppSealPolicyV1:
    MdsocppSealPolicyV1(
        profile: MdsocppProfile.Userland,
        critical: true,
        granted_capability_bits: 0,
        memory_budget_bytes: LINKER_FAST_MEMORY_BUDGET_BYTES,
        maximum_concurrent_calls: 8,
        generation: generation,
        composition_digest: KpfDigest256(w0: 0x4c494e4b45524641, w1: 0x5354000000000001, w2: 0, w3: 1),
    )

pub fn seal_linker_fast_v1(generation: u64) -> MdsocppSealResultV1:
    mdsocpp_seal_v1([linker_fast_capsule_v1()], linker_fast_policy_v1(generation))
