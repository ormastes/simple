# Explicit producer-only projection of app.cli.bootstrap_backend_installer.
# Pair with the pinned kernel_llvm bootstrap_k1_selected projection. The build
# owner materializes a single physical module owner before closure discovery.
use compiler.driver.bootstrap_k1_selected.{
    install_selected_k1_backend_table_v1, selected_k1_backend_policy_v1}
use compiler.backend.static_backend_registry.{
    active_static_backend_table_v1, validate_k1_static_backend_table_v1}
use app.cli.bootstrap_llvm_backend_request.{bootstrap_llvm_backend_request_error_v1}

pub fn bootstrap_install_worker_backends_v1() -> bool:
    if selected_k1_backend_policy_v1() != "llvm": return false
    if not install_selected_k1_backend_table_v1(): return false
    # A previously installed full table cannot silently widen this producer.
    validate_k1_static_backend_table_v1("llvm", active_static_backend_table_v1())

pub fn bootstrap_backend_request_error_v1(backend: text, plugin_path: text) -> text:
    bootstrap_llvm_backend_request_error_v1(backend, plugin_path)

pub fn bootstrap_backend_choices_v1() -> text: "llvm"

pub fn bootstrap_backend_capability_label_v1() -> text: " (LLVM-only producer)"
