# Kernel-root projection of app.cli.bootstrap_backend_installer: the bootstrap
# CLI links only the K1 backends of this kernel. A full-CLI build that also
# passes this root still links the full registry through main_and_help.spl,
# and the request policy defers to the installed full table.
pub use app.cli.bootstrap_essential_backend_installer.{
    bootstrap_install_worker_backends_v1, bootstrap_backend_request_error_v1,
    bootstrap_backend_choices_v1, bootstrap_backend_capability_label_v1}
