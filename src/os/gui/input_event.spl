# Shared Input Event Types for GUI/WM
#
# Standalone module — no dependencies on platform-specific drivers.
# Defines WmAction enum for shortcut mapping.

enum Key:
    Escape | F1 | F2 | F3 | F4 | F5 | F6 | F7 | F8 | F9 | F10 | F11 | F12
    Backtick | Num1 | Num2 | Num3 | Num4 | Num5 | Num6 | Num7 | Num8 | Num9 | Num0
    Minus | Equals | Backspace | Tab
    Q | W | E | R | T | Y | U | I | O | P | LeftBracket | RightBracket | Backslash
    CapsLock | A | S | D | F | G | H | J | K | L | Semicolon | Quote | Enter
    LeftShift | Z | X | C | V | B | N | M | Comma | Period | Slash | RightShift
    LeftCtrl | LeftAlt | Space | RightAlt | RightCtrl
    Up | Down | Left | Right
    Insert | Delete | Home | End | PageUp | PageDown
    Unknown

enum KeyEvent:
    Press(key: Key)
    Release(key: Key)

struct MouseEvent:
    x: i64
    y: i64
    dx: i64
    dy: i64
    left_pressed: bool
    right_pressed: bool
    middle_pressed: bool
    left_just_pressed: bool
    right_just_pressed: bool
    left_just_released: bool

# Window manager actions — high-level commands triggered by shortcuts
enum WmAction:
    CycleFocus         # Tab or Alt+Tab
    FocusWindow(idx: u64)   # 1/2/3 or direct focus
    ToggleTheme        # T key
    Minimize           # M or Alt+F5
    Close              # W or Alt+F4
    Restore            # R key
    Quit               # Q key
    None               # No action matched
