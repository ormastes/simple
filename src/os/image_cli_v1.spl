# Bounded image CLI projection. All artifact reads, validation, and durable
# publication remain owned by verified_image_composition_owner_v1.

use std.common.contracts.execution.simpleos_target_v1.{
    SIMPLEOS_TARGET_V1_X86_64_TRIPLE
}
use std.common.contracts.execution.simpleos_image_manifest_v1.{
    SimpleOsImageManifestV1, simpleos_image_manifest_canonical_v1
}
use os.installer.verified_image_composition_owner_v1.{
    SimpleOsVerifiedImageRequestV1,
    simpleos_verified_image_request_validate_v1,
    simpleos_verified_image_compose_v1
}

pub struct SimpleOsImageCliPlanV1:
    request: SimpleOsVerifiedImageRequestV1
    inspect_only: bool

pub fn simpleos_image_cli_usage_lines_v1() -> [text]:
    """Describe the explicit inputs for one new verified x86_64 NVFS carrier."""
    [
        "Usage: simple os image [--show-plan] <required options>",
        "  --target=x86_64-unknown-simpleos",
        "  --root=<absolute trusted directory> --output=<new relative image path>",
        "  --sectors=<8..32768> --profile=<dev|runtime|minimal>",
        "  --build-id=<identity> --source-id=<identity> --sosix-version=<identity>",
        "  --kernel=<relative ELF> --init=<relative SMF>",
        "  --loader=<relative SMF> --selector=<relative SMF>",
        "  --compiler=<relative SMF>  Optional; permitted only with --profile=dev",
        "All value options also accept --name value. Repeated options are errors.",
        "--show-plan validates inputs only; it does not admit artifacts or the host provider.",
        "Execution requires the native retained-root provider; unsupported hosts fail closed.",
        "Success writes the canonical SimpleOsImageManifestV1 plus one newline to stdout.",
        "The image is an NVFS carrier; composition does not qualify firmware boot or release."
    ]

fn _image_cli_option_names_v1() -> [text]:
    ["target", "root", "output", "sectors", "profile", "build-id", "source-id",
        "sosix-version", "kernel", "init", "loader", "selector", "compiler"]

fn _image_cli_value_valid_v1(value: text) -> bool:
    if value == "" or value.len() > 4095: return false
    var i = 0
    while i < value.len():
        val code = value.char_code_at(i)
        if code < 32 or code == 127: return false
        i = i + 1
    true

fn _image_cli_sectors_v1(value: text) -> Result<u64, text>:
    if value.len() == 0 or value.len() > 5:
        return Err("--sectors requires decimal digits in 8..32768")
    var sectors = 0u64
    var i = 0
    while i < value.len():
        val code = value.char_code_at(i)
        if code < 48 or code > 57:
            return Err("--sectors requires decimal digits in 8..32768")
        sectors = sectors * 10u64 + (code - 48) as u64
        i = i + 1
    Ok(sectors)

pub fn simpleos_image_cli_plan_v1(args: [text]) -> Result<SimpleOsImageCliPlanV1, text>:
    """Parse an explicit image request without reading environment or artifacts."""
    if args.len() > 27:
        return Err("image accepts at most 27 arguments")
    val names = _image_cli_option_names_v1()
    var values: [text] = []
    for name in names: values.push("")
    var inspect_only = false
    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "--show-plan":
            if inspect_only: return Err("duplicate image option: --show-plan")
            inspect_only = true
            i = i + 1
            continue
        if not arg.starts_with("--") or arg.len() > 4120:
            return Err("image requires bounded named options; see simple os image --help")
        val equals = arg.find("=")
        val name = if equals >= 0: arg[2:equals] else: arg[2:]
        var slot = -1
        var n = 0
        while n < names.len():
            if name == names[n]: slot = n
            n = n + 1
        if slot < 0:
            return Err("unknown image option: --" + name)
        if values[slot] != "":
            return Err("duplicate image option: --" + name)
        var value = ""
        if equals >= 0:
            value = arg[equals + 1:]
        else:
            if i + 1 >= args.len() or args[i + 1].starts_with("--"):
                return Err("missing image option value: --" + name)
            i = i + 1
            value = args[i]
        if not _image_cli_value_valid_v1(value):
            return Err("invalid or oversized image option value: --" + name)
        values[slot] = value
        i = i + 1
    var required = 0
    while required < names.len() - 1:
        if values[required] == "":
            return Err("required image option: --" + names[required])
        required = required + 1
    if values[0] != SIMPLEOS_TARGET_V1_X86_64_TRIPLE:
        return Err("image V1 supports only --target=" + SIMPLEOS_TARGET_V1_X86_64_TRIPLE)
    val sectors = _image_cli_sectors_v1(values[3])?
    val request = SimpleOsVerifiedImageRequestV1(
        trusted_absolute_root: values[1], output_relative_path: values[2],
        size_sectors: sectors, profile_id: values[4], build_id: values[5],
        source_id: values[6], sosix_version: values[7],
        kernel_relative_path: values[8], init_relative_path: values[9],
        loader_relative_path: values[10], selector_relative_path: values[11],
        compiler_relative_path: values[12])
    simpleos_verified_image_request_validate_v1(request)?
    Ok(SimpleOsImageCliPlanV1(request: request, inspect_only: inspect_only))

pub fn simpleos_image_cli_plan_lines_v1(plan: SimpleOsImageCliPlanV1) -> [text]:
    """Render caller inputs; these lines carry no artifact or provider admission."""
    val request = plan.request
    [
        "Image mode: inspection only; no artifacts read and no output written",
        "Target: " + SIMPLEOS_TARGET_V1_X86_64_TRIPLE,
        "Trusted root: " + request.trusted_absolute_root,
        "New image: " + request.output_relative_path,
        "Sectors: " + request.size_sectors.to_text(),
        "Profile: " + request.profile_id,
        "Build identity: " + request.build_id,
        "Source identity: " + request.source_id,
        "SOSIX version: " + request.sosix_version,
        "Kernel: " + request.kernel_relative_path,
        "Init: " + request.init_relative_path,
        "Loader: " + request.loader_relative_path,
        "Selector: " + request.selector_relative_path,
        "Compiler: " + (if request.compiler_relative_path == "": "absent" else: request.compiler_relative_path),
        "Provider admission: not attempted",
        "Artifact admission: not attempted",
        "Qualified: false"
    ]

pub fn handle_os_image_v1(args: [text]) -> i64:
    """Compose through the shared native owner, or inspect without filesystem I/O."""
    if args.len() == 1 and (args[0] == "--help" or args[0] == "-h"):
        for line in simpleos_image_cli_usage_lines_v1(): print line
        return 0
    val parsed = simpleos_image_cli_plan_v1(args)
    if parsed.is_err():
        print "Error: " + parsed.unwrap_err()
        return 1
    val plan = parsed.unwrap()
    if plan.inspect_only:
        for line in simpleos_image_cli_plan_lines_v1(plan): print line
        return 0
    var manifests: [SimpleOsImageManifestV1] = []
    val composed = simpleos_verified_image_compose_v1(plan.request, manifests)
    if composed.is_err():
        print "Error: " + composed.unwrap_err()
        print "No image admission receipt was issued; inspect the requested output before retrying."
        return 1
    if manifests.len() != 1:
        print "Error: image owner did not return one admitted manifest"
        return 1
    val canonical = simpleos_image_manifest_canonical_v1(manifests[0])
    if canonical.is_err():
        print "Error: image manifest canonical encoding rejected"
        return 1
    print canonical.unwrap()
    0

export SimpleOsImageCliPlanV1, simpleos_image_cli_usage_lines_v1
export simpleos_image_cli_plan_v1, simpleos_image_cli_plan_lines_v1
export handle_os_image_v1
