#![allow(unnamed_duplicate_typed_args)]
# AES-128-GCM — Pure Simple Implementation
#
# AES-128 in Galois/Counter Mode per NIST SP 800-38D.
# No SFFI/Rust FFI — pure Simple language, suitable for baremetal.
#
# Reference: FIPS 197 (AES)
# Reference: NIST SP 800-38D (GCM)

@unsafe(reason: "foreign byte indexing requires caller-proven array bounds", capabilities: [ffi])
extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64
@unsafe(reason: "foreign array allocation result is not artifact-verified", capabilities: [ffi])
extern fn rt_array_new_with_cap(cap: i64) -> [u8]
@unsafe(reason: "foreign AES block result is not artifact-verified", capabilities: [ffi])
extern fn rt_aes128_encrypt_block_pure(key: [u8], block: [u8]) -> [u8]

@unsafe(reason: "caller must prove the foreign byte index is in bounds", capabilities: [ffi])
fn _u8_at(buf: [u8], idx: u64) -> u8:
    rt_bytes_u8_at(buf, idx.to_i64()).to_u8()

@always_inline
fn _nvfs_a128gcm_new_u8(cap: i64) -> [u8]:
    unsafe(capabilities: [ffi]):
        rt_array_new_with_cap(cap)

# ============================================================================
# Result Type for Decryption
# ============================================================================

enum Aes128GcmResult:
    Ok(data: [u8])
    Err(msg: text)

# ============================================================================
# AES-128 Encryption (single block)
# ============================================================================

@unsafe(reason: "foreign AES block result is unverified and must be extent-checked", capabilities: [ffi])
fn aes128_encrypt_block(plaintext: [u8], key: [u8]) -> [u8]:
    """Encrypt one block through the cross-lane pure-result runtime helper."""
    if key.len() != 16 or plaintext.len() != 16:
        panic("AES-128 block provider requires exact 16-byte inputs")
    val output = rt_aes128_encrypt_block_pure(key, plaintext)
    if output.len() != 16:
        panic("foreign AES-128 block provider returned an invalid extent")
    output

# ============================================================================
# GF(2^128) Multiplication for GHASH
# ============================================================================

@unsafe(reason: "requires exact 16-byte field elements for unchecked byte access", capabilities: [ffi])
fn _nvfs_a128gcm_gf128_mul(x: [u8], y: [u8]) -> [u8]:
    """Multiply two 128-bit elements in GF(2^128)."""
    var z: [u8] = _nvfs_a128gcm_new_u8(16)
    var i: u64 = 0
    while i < 16:
        z.push(0x00)
        i = i + 1

    var v: [u8] = _nvfs_a128gcm_new_u8(16)
    i = 0
    while i < 16:
        v.push(_u8_at(y, i))
        i = i + 1

    i = 0
    while i < 128:
        val byte_idx = i / 8
        val bit_idx = 7 - (i % 8)

        if ((_u8_at(x, byte_idx) >> bit_idx) & 0x01) != 0:
            var z_next: [u8] = _nvfs_a128gcm_new_u8(16)
            var j: u64 = 0
            while j < 16:
                z_next.push(_u8_at(z, j) ^ _u8_at(v, j))
                j = j + 1
            z = z_next

        val lsb = _u8_at(v, 15) & 0x01
        var v_next: [u8] = _nvfs_a128gcm_new_u8(16)
        var first = (_u8_at(v, 0).to_u32() >> 1).to_u8()
        if lsb != 0:
            first = first ^ 0xE1
        v_next.push(first)
        var j: u64 = 1
        while j < 16:
            val cur = _u8_at(v, j).to_u32()
            val prev = _u8_at(v, j - 1).to_u32()
            v_next.push((((cur >> 1) | ((prev & 0x01) << 7)) & 0xFF).to_u8())
            j = j + 1
        v = v_next
        i = i + 1

    z

# ============================================================================
# GHASH
# ============================================================================

@unsafe(reason: "requires exact 16-byte GHASH operands", capabilities: [ffi])
fn _nvfs_a128gcm_ghash_block(h: [u8], y: [u8], x_block: [u8]) -> [u8]:
    """Process one 16-byte block for GHASH: Y_i = (Y_{i-1} XOR X_i) * H."""
    var xored: [u8] = _nvfs_a128gcm_new_u8(16)
    var i: u64 = 0
    while i < 16:
        xored.push(_u8_at(y, i) ^ _u8_at(x_block, i))
        i = i + 1
    _nvfs_a128gcm_gf128_mul(xored, h)

@unsafe(reason: "copies through unchecked foreign byte access", capabilities: [ffi])
fn _nvfs_a128gcm_pad_to_16(data: [u8]) -> [u8]:
    """Pad data to a multiple of 16 bytes with zeros."""
    val padded_len = if (data.len() % 16) == 0:
        data.len()
    else:
        ((data.len() / 16) + 1) * 16
    var result: [u8] = _nvfs_a128gcm_new_u8(padded_len.to_i64())
    var i: u64 = 0
    while i < data.len():
        result.push(_u8_at(data, i))
        i = i + 1
    while (result.len() % 16) != 0:
        result.push(0x00)
    result

@unsafe(reason: "copies through unchecked foreign byte access", capabilities: [ffi])
fn _nvfs_a128gcm_append_bytes(a: [u8], b: [u8]) -> [u8]:
    """Append two byte arrays without relying on array concatenation."""
    var out: [u8] = _nvfs_a128gcm_new_u8((a.len() + b.len()).to_i64())
    var i: u64 = 0
    while i < a.len():
        out.push(_u8_at(a, i))
        i = i + 1
    i = 0
    while i < b.len():
        out.push(_u8_at(b, i))
        i = i + 1
    out

@unsafe(reason: "depends on unchecked foreign byte access through GHASH helpers", capabilities: [ffi])
fn _nvfs_a128gcm_ghash(h: [u8], aad: [u8], ciphertext: [u8]) -> [u8]:
    """Compute GHASH for GCM."""
    var y: [u8] = _nvfs_a128gcm_new_u8(16)
    var i: u64 = 0
    while i < 16:
        y.push(0x00)
        i = i + 1

    val padded_aad = _nvfs_a128gcm_pad_to_16(aad)
    i = 0
    while i < padded_aad.len():
        var block: [u8] = _nvfs_a128gcm_new_u8(16)
        var j: u64 = 0
        while j < 16:
            block.push(_u8_at(padded_aad, i + j))
            j = j + 1
        y = _nvfs_a128gcm_ghash_block(h, y, block)
        i = i + 16

    val padded_ct = _nvfs_a128gcm_pad_to_16(ciphertext)
    i = 0
    while i < padded_ct.len():
        var block: [u8] = _nvfs_a128gcm_new_u8(16)
        var j: u64 = 0
        while j < 16:
            block.push(_u8_at(padded_ct, i + j))
            j = j + 1
        y = _nvfs_a128gcm_ghash_block(h, y, block)
        i = i + 16

    val aad_bits: u64 = aad.len() * 8
    val ct_bits: u64 = ciphertext.len() * 8

    var len_block: [u8] = _nvfs_a128gcm_new_u8(16)
    len_block.push(((aad_bits >> 56) & 0xFF).to_u8())
    len_block.push(((aad_bits >> 48) & 0xFF).to_u8())
    len_block.push(((aad_bits >> 40) & 0xFF).to_u8())
    len_block.push(((aad_bits >> 32) & 0xFF).to_u8())
    len_block.push(((aad_bits >> 24) & 0xFF).to_u8())
    len_block.push(((aad_bits >> 16) & 0xFF).to_u8())
    len_block.push(((aad_bits >> 8) & 0xFF).to_u8())
    len_block.push((aad_bits & 0xFF).to_u8())
    len_block.push(((ct_bits >> 56) & 0xFF).to_u8())
    len_block.push(((ct_bits >> 48) & 0xFF).to_u8())
    len_block.push(((ct_bits >> 40) & 0xFF).to_u8())
    len_block.push(((ct_bits >> 32) & 0xFF).to_u8())
    len_block.push(((ct_bits >> 24) & 0xFF).to_u8())
    len_block.push(((ct_bits >> 16) & 0xFF).to_u8())
    len_block.push(((ct_bits >> 8) & 0xFF).to_u8())
    len_block.push((ct_bits & 0xFF).to_u8())

    y = _nvfs_a128gcm_ghash_block(h, y, len_block)
    y

# ============================================================================
# GCTR — AES-CTR with Incrementing Counter
# ============================================================================

@unsafe(reason: "requires an exact 16-byte counter extent", capabilities: [ffi])
fn _nvfs_a128gcm_inc32(counter: [u8]) -> [u8]:
    """Increment the rightmost 32 bits of a 16-byte counter block."""
    val c = (_u8_at(counter, 12).to_u32() << 24) |
            (_u8_at(counter, 13).to_u32() << 16) |
            (_u8_at(counter, 14).to_u32() << 8) |
            _u8_at(counter, 15).to_u32()
    val c_inc = (c + 1) & 0xFFFFFFFF

    var result: [u8] = _nvfs_a128gcm_new_u8(16)
    var i: u64 = 0
    while i < 12:
        result.push(_u8_at(counter, i))
        i = i + 1
    result.push(((c_inc >> 24) & 0xFF).to_u8())
    result.push(((c_inc >> 16) & 0xFF).to_u8())
    result.push(((c_inc >> 8) & 0xFF).to_u8())
    result.push((c_inc & 0xFF).to_u8())
    result

@unsafe(reason: "requires validated key and counter extents", capabilities: [ffi])
fn gctr(key: [u8], icb: [u8], input: [u8]) -> [u8]:
    """AES-CTR mode encryption/decryption."""
    if input.len() == 0:
        return []

    var output: [u8] = _nvfs_a128gcm_new_u8(input.len().to_i64())
    var cb = icb
    val num_full_blocks = input.len() / 16

    var i: u64 = 0
    while i < num_full_blocks:
        val enc_cb = aes128_encrypt_block(cb, key)
        val offset = i * 16
        var j: u64 = 0
        while j < 16:
            output.push(_u8_at(input, offset + j) ^ _u8_at(enc_cb, j))
            j = j + 1
        cb = _nvfs_a128gcm_inc32(cb)
        i = i + 1

    val remaining = input.len() % 16
    if remaining > 0:
        val enc_cb = aes128_encrypt_block(cb, key)
        val offset = num_full_blocks * 16
        var j: u64 = 0
        while j < remaining:
            output.push(_u8_at(input, offset + j) ^ _u8_at(enc_cb, j))
            j = j + 1

    output

# ============================================================================
# AES-128-GCM Encryption
# ============================================================================

@unsafe(reason: "requires an exact 12-byte nonce extent", capabilities: [ffi])
fn _nvfs_a128gcm_make_j0(nonce: [u8]) -> [u8]:
    """Construct J0 (initial counter block) from 12-byte nonce."""
    var j0: [u8] = _nvfs_a128gcm_new_u8(16)
    var i: u64 = 0
    while i < 12:
        j0.push(_u8_at(nonce, i))
        i = i + 1
    j0.push(0x00)
    j0.push(0x00)
    j0.push(0x00)
    j0.push(0x01)
    j0

@unsafe(reason: "validated core depends on unverified foreign AES and byte-access primitives", capabilities: [ffi])
fn _nvfs_aes128_gcm_encrypt_validated(key: [u8], nonce: [u8], plaintext: [u8], aad: [u8]) -> [u8]:
    """AES-128-GCM authenticated encryption.

    Returns: ciphertext || 16-byte authentication tag (concatenated).
    The last 16 bytes of the result are the tag.
    """
    var zero_block: [u8] = _nvfs_a128gcm_new_u8(16)
    var i: u64 = 0
    while i < 16:
        zero_block.push(0x00)
        i = i + 1
    val h = aes128_encrypt_block(zero_block, key)

    val j0 = _nvfs_a128gcm_make_j0(nonce)
    val icb = _nvfs_a128gcm_inc32(j0)
    val ciphertext = gctr(key, icb, plaintext)
    val s = _nvfs_a128gcm_ghash(h, aad, ciphertext)
    val tag = gctr(key, j0, s)

    _nvfs_a128gcm_append_bytes(ciphertext, tag)

fn aes128_gcm_encrypt(key: [u8], nonce: [u8], plaintext: [u8], aad: [u8]) -> [u8]:
    """Encrypt after enforcing the fixed AES-128 key and GCM nonce extents."""
    if key.len() != 16:
        panic("AES-128 key must be 16 bytes")
    if nonce.len() != 12:
        panic("GCM nonce must be 12 bytes")
    unsafe(capabilities: [ffi]):
        _nvfs_aes128_gcm_encrypt_validated(key, nonce, plaintext, aad)

# ============================================================================
# AES-128-GCM Decryption
# ============================================================================

@unsafe(reason: "validated core depends on unverified foreign AES and byte-access primitives", capabilities: [ffi])
fn _nvfs_aes128_gcm_decrypt_validated(key: [u8], nonce: [u8], ciphertext: [u8], aad: [u8], tag: [u8]) -> Aes128GcmResult:
    """AES-128-GCM authenticated decryption.

    Returns: Aes128GcmResult.Ok with plaintext on success,
             Aes128GcmResult.Err on tag mismatch.
    """
    var zero_block: [u8] = _nvfs_a128gcm_new_u8(16)
    var i: u64 = 0
    while i < 16:
        zero_block.push(0x00)
        i = i + 1
    val h = aes128_encrypt_block(zero_block, key)

    val j0 = _nvfs_a128gcm_make_j0(nonce)
    val s = _nvfs_a128gcm_ghash(h, aad, ciphertext)
    val expected_tag = gctr(key, j0, s)

    # Constant-time tag comparison
    var diff: u8 = 0x00
    i = 0
    while i < 16:
        diff = diff | (_u8_at(expected_tag, i) ^ _u8_at(tag, i))
        i = i + 1

    if diff != 0:
        return Aes128GcmResult.Err("authentication tag mismatch")

    val icb = _nvfs_a128gcm_inc32(j0)
    val plaintext = gctr(key, icb, ciphertext)

    Aes128GcmResult.Ok(data: plaintext)

fn aes128_gcm_decrypt(key: [u8], nonce: [u8], ciphertext: [u8], aad: [u8], tag: [u8]) -> Aes128GcmResult:
    """Decrypt after rejecting invalid fixed-width inputs as typed errors."""
    if key.len() != 16:
        return Aes128GcmResult.Err("AES-128 key must be 16 bytes")
    if nonce.len() != 12:
        return Aes128GcmResult.Err("GCM nonce must be 12 bytes")
    if tag.len() != 16:
        return Aes128GcmResult.Err("GCM tag must be 16 bytes")
    unsafe(capabilities: [ffi]):
        _nvfs_aes128_gcm_decrypt_validated(key, nonce, ciphertext, aad, tag)
