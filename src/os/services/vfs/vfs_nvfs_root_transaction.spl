# Exact staged publication for one DBFS-backed NVFS root.
#
# Staging moves the canonical MountTable into an opaque lease, so the new root
# is not globally reachable before its positioned route is accepted. Commit
# restores the table and readiness under one lock. Abort removes the exact
# backing instance even when its mutation epoch made the stage seal stale.

use os.services.vfs.vfs_boot_state.{
    vfs_is_ready,
    VfsMountTableLeaseV1,
    vfs_state_mount_table_owner_handle_v1,
    vfs_state_mount_table_lease_begin_v1,
    vfs_state_mount_table_lease_restore_v1,
    vfs_state_mount_table_lease_restore_ready_v1
}
use std.fs_driver.nvfs_driver.{NvfsDriver}
use std.fs_driver.instance.{DriverInstance}
use std.fs_driver.mount_table.{NvfsRootMountSealV1}
use std.fs_driver.types.{MountOptions}
use os.services.vfs.vfs_immutable_include_tree_state_v1.{
    vfs_include_mutation_begin_v1,
    vfs_include_mutation_finish_v1
}

pub struct VfsNvfsRootMountStageV1:
    driver: NvfsDriver
    seal: NvfsRootMountSealV1
    instance_id: i64
    table_lease: VfsMountTableLeaseV1

fn _vfs_nvfs_root_close_driver_v1(driver: NvfsDriver) -> bool:
    val instance_id = driver.device_instance_id()
    val closed = driver.close_device_backing(instance_id)
    closed.is_ok() and closed.unwrap()

fn _vfs_nvfs_root_restore_unstaged_v1(
    lease: VfsMountTableLeaseV1,
    driver: NvfsDriver,
    reason: text
) -> Result<VfsNvfsRootMountStageV1, text>:
    val restored = vfs_state_mount_table_lease_restore_v1(lease)
    val closed = _vfs_nvfs_root_close_driver_v1(driver)
    if not restored:
        if not closed: return Err(reason + "-table-restore-and-device-close-failed")
        return Err(reason + "-table-restore-failed")
    if not closed:
        return Err(reason + "-device-close-failed")
    Err(reason)

fn _vfs_nvfs_root_abort_private_v1(
    stage: VfsNvfsRootMountStageV1
) -> Result<(), text>:
    var lease = stage.table_lease
    var table = lease.table
    # The seal binds the exact root mount ID and backing instance. Abort does
    # not require the mutable epoch to remain current, so staleness cannot
    # strand the privately staged mount or redirect teardown.
    val removed = table.abort_nvfs_root_mount_seal(
        stage.seal, stage.instance_id)
    lease.table = table
    if removed.is_err():
        # Keep the canonical owner leased out and globally unavailable rather
        # than restoring an indeterminate staged root.
        return Err("vfs-nvfs-root: staged-root-remove-failed")
    val restored = vfs_state_mount_table_lease_restore_v1(lease)
    val closed = _vfs_nvfs_root_close_driver_v1(stage.driver)
    if not restored:
        if not closed:
            return Err("vfs-nvfs-root: staged-root-table-restore-and-device-close-failed")
        return Err("vfs-nvfs-root: staged-root-table-restore-failed")
    if not closed:
        return Err("vfs-nvfs-root: staged-root-device-close-failed")
    Ok(())

pub fn vfs_nvfs_root_mount_stage_v1(
    driver: NvfsDriver
) -> Result<VfsNvfsRootMountStageV1, text>:
    """Build one exact NVFS root in a private MountTable lease."""
    if not driver.durability_serialization_ready():
        if not _vfs_nvfs_root_close_driver_v1(driver):
            return Err("vfs-nvfs-root: durability-owner-not-ready-device-close-failed")
        return Err("vfs-nvfs-root: durability-owner-not-ready")
    if vfs_is_ready():
        if not _vfs_nvfs_root_close_driver_v1(driver):
            return Err("vfs-nvfs-root: root-already-ready-device-close-failed")
        return Err("vfs-nvfs-root: root-already-ready")
    val owner = vfs_state_mount_table_owner_handle_v1()
    if not owner.?:
        if not _vfs_nvfs_root_close_driver_v1(driver):
            return Err("vfs-nvfs-root: table-owner-unavailable-device-close-failed")
        return Err("vfs-nvfs-root: table-owner-unavailable")
    val borrowed = vfs_state_mount_table_lease_begin_v1(owner.unwrap())
    if not borrowed.?:
        if not _vfs_nvfs_root_close_driver_v1(driver):
            return Err("vfs-nvfs-root: table-lease-unavailable-device-close-failed")
        return Err("vfs-nvfs-root: table-lease-unavailable")
    var lease = borrowed.unwrap()
    if vfs_is_ready():
        return _vfs_nvfs_root_restore_unstaged_v1(
            lease, driver, "vfs-nvfs-root: root-became-ready")

    val instance_id = driver.device_instance_id()
    var table = lease.table
    val mounted = table.mount(
        "/", DriverInstance.Nvfs(driver), MountOptions.default())
    if mounted.is_err():
        lease.table = table
        return _vfs_nvfs_root_restore_unstaged_v1(
            lease, driver, "vfs-nvfs-root: mount-failed")
    val acquired = table.acquire_nvfs_root_mount_seal()
    if acquired.is_err():
        val removed = table.remove_exact_nvfs_root_mount(instance_id)
        lease.table = table
        if removed.is_err():
            if not _vfs_nvfs_root_close_driver_v1(driver):
                return Err("vfs-nvfs-root: seal-failed-private-remove-and-device-close-failed")
            return Err("vfs-nvfs-root: seal-failed-private-remove-failed")
        return _vfs_nvfs_root_restore_unstaged_v1(
            lease, driver, "vfs-nvfs-root: seal-acquisition-failed")
    val seal = acquired.unwrap()
    val facts = table.revalidate_nvfs_root_mount_seal(seal)
    lease.table = table
    val stage = VfsNvfsRootMountStageV1(
        driver: driver, seal: seal, instance_id: instance_id,
        table_lease: lease)
    if (facts.is_err() or
        facts.unwrap().backing_instance_identity != instance_id):
        val aborted = _vfs_nvfs_root_abort_private_v1(stage)
        if aborted.is_err():
            return Err("vfs-nvfs-root: seal-identity-mismatch:" + aborted.unwrap_err())
        return Err("vfs-nvfs-root: seal-identity-mismatch")
    Ok(stage)

pub fn vfs_nvfs_root_mount_abort_v1(
    stage: VfsNvfsRootMountStageV1
) -> Result<(), text>:
    """Consume one private stage and release its exact backing owner."""
    _vfs_nvfs_root_abort_private_v1(stage)

pub fn vfs_nvfs_root_mount_commit_v1(
    stage: VfsNvfsRootMountStageV1
) -> Result<NvfsDriver, text>:
    """Atomically publish a still-exact private root and readiness."""
    var lease = stage.table_lease
    var table = lease.table
    val facts = table.revalidate_nvfs_root_mount_seal(stage.seal)
    if (facts.is_err() or
        facts.unwrap().backing_instance_identity != stage.instance_id):
        val aborted = _vfs_nvfs_root_abort_private_v1(stage)
        if aborted.is_err():
            return Err("vfs-nvfs-root: commit-identity-stale:" + aborted.unwrap_err())
        return Err("vfs-nvfs-root: commit-identity-stale")
    val include_ticket = vfs_include_mutation_begin_v1("/usr/include")
    if include_ticket.is_err():
        val aborted = _vfs_nvfs_root_abort_private_v1(stage)
        if aborted.is_err():
            return Err("vfs-nvfs-root: include-invalidation-begin-failed:" + aborted.unwrap_err())
        return Err("vfs-nvfs-root: include-invalidation-begin-failed")
    if not vfs_include_mutation_finish_v1(include_ticket.unwrap()):
        val aborted = _vfs_nvfs_root_abort_private_v1(stage)
        if aborted.is_err():
            return Err("vfs-nvfs-root: include-invalidation-failed:" + aborted.unwrap_err())
        return Err("vfs-nvfs-root: include-invalidation-failed")
    val closed = table.close_nvfs_root_mount_seal(stage.seal)
    if closed.is_err():
        lease.table = table
        val failed_stage = VfsNvfsRootMountStageV1(
            driver: stage.driver, seal: stage.seal,
            instance_id: stage.instance_id, table_lease: lease)
        val aborted = _vfs_nvfs_root_abort_private_v1(failed_stage)
        if aborted.is_err():
            return Err("vfs-nvfs-root: seal-close-failed:" + aborted.unwrap_err())
        return Err("vfs-nvfs-root: seal-close-failed")
    lease.table = table
    if not vfs_state_mount_table_lease_restore_ready_v1(lease):
        # Restore failure quarantines the global owner with no reachable table.
        # The exact device owner can still be closed without exposing a root.
        if not _vfs_nvfs_root_close_driver_v1(stage.driver):
            return Err("vfs-nvfs-root: publication-failed-device-close-failed")
        return Err("vfs-nvfs-root: publication-failed")
    Ok(stage.driver)
