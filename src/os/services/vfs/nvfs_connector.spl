"""NVFS connector for service-level VFS path semantics.

This module deliberately stays separate from `vfs_init.spl` so x86_64 boot
does not link the examples NVFS implementation into the freestanding kernel.
"""

use std.fs_driver.ops.{FsDriver}
use std.fs_driver.types.{Path, MountOptions, OpenFlags}
use std.fs_driver.error.{FsError}
use common.string_core.{str_starts_with, str_slice}
use std.security.sanitize.{is_path_traversal}
use std.fs_driver.nvfs_hosted_driver.{NvfsHostedDriver}
use std.fs_driver.block_device.{BlockDevice}
use os.drivers.nvme.nvme_storage_model.{NvmeSharedFilesystemInterface}
use os.services.vfs.nvfs_mount_session_owner_v1.{
    NvfsMountSessionV1, nvfs_mount_session_open_v1,
    nvfs_mount_session_validate_v1, nvfs_mount_session_close_v1
}

extern fn rt_env_get(key: text) -> text
extern fn rt_eprintln(s: text)
extern fn rt_bytes_alloc(len: i64) -> [u8]
extern fn rt_text_to_bytes(s: text) -> [u8]
extern fn rt_bytes_to_text(data: [u8]) -> text

val NVFS_CONNECTOR_MAX_BYTES: i64 = 16777216   # 16 MiB
val NVFS_CONNECTOR_MAX_CONNECTIONS: i64 = 256
val NVFS_CONNECTOR_MAX_CONNECTION_ID: i64 = 0x7fffffffffffffff

# Caps the in-memory POSIX driver can actually satisfy.
# Any bit set in require_caps that is absent here triggers Permission.
val NVFS_CONNECTOR_SUPPORTED_CAPS: u32 = 0x0F

fn _log_warn(msg: text):
    val level = rt_env_get("SIMPLE_LOG")
    if (level == "warn" or level == "info" or
        level == "debug" or level == "trace"):
        rt_eprintln("[WARN] nvfs_connector: {msg}")

fn _log_error(msg: text):
    val level = rt_env_get("SIMPLE_LOG")
    if (level == "error" or level == "warn" or level == "info" or
        level == "debug" or level == "trace"):
        rt_eprintln("[ERROR] nvfs_connector: {msg}")

fn _nvfs_absolute_path_is_canonical(path: text) -> bool:
    path != "" and str_starts_with(path, "/") and
        not path.contains("//") and not path.contains("/./") and
        not path.ends_with("/.")

struct NvfsVfsConnection:
    """Mounted NVFS POSIX shim plus VFS-style mount prefix."""
    conn_id:     i64
    mount_path:  text
    read_only:   bool
    want_caps:   u32
    require_caps: u32
    max_bytes:   i64

struct NvfsVfsConnectionSlot:
    conn_id: i64
    driver:  NvfsHostedDriver
    session: NvfsMountSessionV1?
    interface: NvmeSharedFilesystemInterface?

var _nvfs_vfs_connections: [NvfsVfsConnectionSlot] = []
var _nvfs_vfs_next_conn_id: i64 = 1

fn _nvfs_vfs_alloc_conn_id() -> i64:
    if (_nvfs_vfs_next_conn_id <= 0 or
        _nvfs_vfs_next_conn_id == NVFS_CONNECTOR_MAX_CONNECTION_ID):
        return 0
    val conn_id = _nvfs_vfs_next_conn_id
    _nvfs_vfs_next_conn_id = _nvfs_vfs_next_conn_id + 1
    conn_id

fn _nvfs_vfs_find_connection_idx(conn_id: i64) -> i64:
    var i: i64 = 0
    while i < _nvfs_vfs_connections.len() as i64:
        if _nvfs_vfs_connections[i].conn_id == conn_id:
            return i
        i = i + 1
    -1

fn _nvfs_vfs_load_driver(conn_id: i64) -> Result<NvfsHostedDriver, FsError>:
    val idx = _nvfs_vfs_find_connection_idx(conn_id)
    if idx < 0:
        return Err(FsError.NotFound)
    val slot = _nvfs_vfs_connections[idx]
    if slot.session.is_some():
        if slot.interface.is_none(): return Err(FsError.StaleHandle)
        if nvfs_mount_session_validate_v1(
                slot.session.unwrap(), slot.interface.unwrap()).is_err():
            return Err(FsError.StaleHandle)
    Ok(slot.driver)

fn _nvfs_vfs_store_driver(conn_id: i64, driver: NvfsHostedDriver) -> Result<(), FsError>:
    val idx = _nvfs_vfs_find_connection_idx(conn_id)
    if idx < 0:
        return Err(FsError.NotFound)
    val prior = _nvfs_vfs_connections[idx]
    _nvfs_vfs_connections[idx] = NvfsVfsConnectionSlot(
        conn_id: conn_id, driver: driver, session: prior.session,
        interface: prior.interface)
    Ok(())

fn nvfs_vfs_connect(
    mount_path:  text,
    name:        text,
    read_only:   bool,
    want_caps:   u32,
    require_caps: u32
) -> Result<NvfsVfsConnection, FsError>:
    """Create and mount an NVFS POSIX driver behind a VFS-style prefix."""
    val trimmed = mount_path.trim()
    if trimmed == "":
        _log_error("mount rejected: empty mount path")
        return Err(FsError.InvalidArg)
    if not _nvfs_absolute_path_is_canonical(trimmed):
        _log_error("mount rejected: non-canonical absolute path '{trimmed}'")
        return Err(FsError.InvalidArg)
    if is_path_traversal(trimmed):
        _log_error("mount rejected: traversal in mount path '{trimmed}'")
        return Err(FsError.InvalidArg)
    if trimmed.len() > 1 and str_slice(trimmed, trimmed.len() - 1, trimmed.len()) == "/":
        _log_error("mount rejected: non-canonical trailing slash in '{trimmed}'")
        return Err(FsError.InvalidArg)
    # Reject require_caps bits the in-memory driver cannot satisfy.
    if (require_caps & ~NVFS_CONNECTOR_SUPPORTED_CAPS) != 0:
        _log_error("mount rejected: unsatisfiable require_caps 0x{require_caps}")
        return Err(FsError.Permission)
    if _nvfs_vfs_connections.len() >= NVFS_CONNECTOR_MAX_CONNECTIONS:
        return Err(FsError.TooLarge)
    var driver = NvfsHostedDriver.new(name)
    val opts = MountOptions(read_only: read_only, want_caps: want_caps, require_caps: require_caps)
    val mount_r = driver.mount(opts)
    if mount_r.is_err():
        _log_error("driver.mount failed for '{trimmed}'")
        return Err(mount_r.unwrap_err())
    val conn_id = _nvfs_vfs_alloc_conn_id()
    if conn_id <= 0:
        val _ = driver.unmount()
        return Err(FsError.TooLarge)
    _nvfs_vfs_connections.push(NvfsVfsConnectionSlot(
        conn_id: conn_id, driver: driver, session: nil, interface: nil))
    Ok(NvfsVfsConnection(
        conn_id:     conn_id,
        mount_path:  trimmed,
        read_only:   read_only,
        want_caps:   want_caps,
        require_caps: require_caps,
        max_bytes:   NVFS_CONNECTOR_MAX_BYTES
    ))

fn nvfs_vfs_connect_owned_device(
    interface: NvmeSharedFilesystemInterface, dev: BlockDevice,
    device_owner_id: u64, base_block: i64, block_count: i64,
    mount_path: text, name: text, read_only: bool,
    want_caps: u32, require_caps: u32
) -> Result<NvfsVfsConnection, FsError>:
    """Mount an identity-bound device driver and open its canonical session."""
    val trimmed = mount_path.trim()
    if (trimmed == "" or not _nvfs_absolute_path_is_canonical(trimmed) or
        is_path_traversal(trimmed) or
        (trimmed.len() > 1 and trimmed.ends_with("/")) or
        device_owner_id == 0u64 or base_block < 0 or block_count < 4):
        return Err(FsError.InvalidArg)
    if (require_caps & ~NVFS_CONNECTOR_SUPPORTED_CAPS) != 0:
        return Err(FsError.Permission)
    if _nvfs_vfs_connections.len() >= NVFS_CONNECTOR_MAX_CONNECTIONS:
        return Err(FsError.TooLarge)
    val driver_r = NvfsHostedDriver.new_on_owned_device(
        name, dev, device_owner_id, base_block, block_count)
    if driver_r.is_err(): return Err(driver_r.unwrap_err())
    var driver = driver_r.unwrap()
    val mounted = driver.mount(MountOptions(
        read_only: read_only, want_caps: want_caps, require_caps: require_caps))
    if mounted.is_err():
        val _ = driver.close_owned_device()
        return Err(mounted.unwrap_err())
    val session_r = nvfs_mount_session_open_v1(interface)
    if session_r.is_err():
        val _ = driver.close_owned_device()
        return Err(FsError.Permission)
    val conn_id = _nvfs_vfs_alloc_conn_id()
    if conn_id <= 0:
        val _ = nvfs_mount_session_close_v1(session_r.unwrap())
        val _ = driver.close_owned_device()
        return Err(FsError.TooLarge)
    _nvfs_vfs_connections.push(NvfsVfsConnectionSlot(
        conn_id: conn_id, driver: driver, session: Some(session_r.unwrap()),
        interface: Some(interface)))
    Ok(NvfsVfsConnection(
        conn_id: conn_id, mount_path: trimmed, read_only: read_only,
        want_caps: want_caps, require_caps: require_caps,
        max_bytes: NVFS_CONNECTOR_MAX_BYTES))

fn nvfs_vfs_close(conn: NvfsVfsConnection) -> Result<bool, FsError>:
    """Close one exact connector without letting copied records resurrect it."""
    val idx = _nvfs_vfs_find_connection_idx(conn.conn_id)
    if idx < 0: return Err(FsError.StaleHandle)
    var slot = _nvfs_vfs_connections[idx]
    if slot.session.is_none():
        val unmounted = slot.driver.unmount()
        if unmounted.is_err(): return Err(unmounted.unwrap_err())
        _nvfs_vfs_connections.remove(idx)
        return Ok(true)
    val plan_r = slot.driver.begin_owned_device_close()
    if plan_r.is_err(): return Err(plan_r.unwrap_err())
    val plan = plan_r.unwrap()
    val session_closed = nvfs_mount_session_close_v1(slot.session.unwrap())
    if session_closed.is_err():
        val cancelled = slot.driver.cancel_owned_device_close(plan)
        if cancelled.is_err(): return Err(cancelled.unwrap_err())
        return Err(FsError.StaleHandle)
    # Persist the closed-session state before teardown. A determinate teardown
    # failure remains retryable without replaying the session close.
    slot.session = nil
    slot.interface = nil
    _nvfs_vfs_connections[idx] = slot
    val finished = slot.driver.finish_owned_device_close(plan)
    if finished.is_err(): return Err(finished.unwrap_err())
    _nvfs_vfs_connections.remove(idx)
    Ok(true)

fn _nvfs_relpath(conn: NvfsVfsConnection, path: text) -> Result<Path, FsError>:
    if not _nvfs_absolute_path_is_canonical(path):
        _log_warn("non-canonical absolute path rejected: '{path}'")
        return Err(FsError.InvalidArg)
    if is_path_traversal(path):
        _log_warn("traversal rejected: '{path}'")
        return Err(FsError.InvalidArg)
    if conn.mount_path == "/":
        return Ok(Path(raw: path))
    if not str_starts_with(path, conn.mount_path):
        _log_warn("path outside mount prefix: '{path}' not under '{conn.mount_path}'")
        return Err(FsError.InvalidArg)
    if path.len() > conn.mount_path.len():
        val boundary = str_slice(path, conn.mount_path.len(), conn.mount_path.len() + 1)
        if boundary != "/":
            _log_warn("path crosses mount prefix boundary: '{path}' not under '{conn.mount_path}'")
            return Err(FsError.InvalidArg)
    val rel = str_slice(path, conn.mount_path.len(), path.len())
    if rel == "":
        return Ok(Path(raw: "/"))
    Ok(Path(raw: rel))

fn nvfs_vfs_write_text(conn: NvfsVfsConnection, path: text, content: text) -> Result<(), FsError>:
    """Write a complete text file through the NVFS connection."""
    if conn.read_only:
        _log_warn("write rejected on read-only connection: '{path}'")
        return Err(FsError.Permission)
    if content.len() > conn.max_bytes:
        _log_warn("write rejected: content size {content.len()} > max {conn.max_bytes}")
        return Err(FsError.TooLarge)
    val rel_r = _nvfs_relpath(conn, path)
    if rel_r.is_err():
        return Err(rel_r.unwrap_err())
    val rel = rel_r.unwrap()
    val driver_r = _nvfs_vfs_load_driver(conn.conn_id)
    if driver_r.is_err():
        return Err(driver_r.unwrap_err())
    var driver = driver_r.unwrap()
    val open_r = driver.open(rel, OpenFlags.write_only().with_append().with_create())
    if open_r.is_err():
        _log_error("open failed for '{path}'")
        return Err(open_r.unwrap_err())
    val handle = open_r.unwrap()
    val trunc_r = driver.ftruncate(handle, 0)
    if trunc_r.is_err():
        driver.close(handle)
        _log_error("ftruncate failed for '{path}'")
        return Err(trunc_r.unwrap_err())
    val buf = rt_text_to_bytes(content)
    val write_r = driver.write(handle, 0, buf)
    driver.close(handle)
    val persist_r = _nvfs_vfs_store_driver(conn.conn_id, driver)
    if persist_r.is_err():
        return Err(persist_r.unwrap_err())
    if write_r.is_err():
        _log_error("write failed for '{path}'")
        return Err(write_r.unwrap_err())
    Ok(())

fn nvfs_vfs_read_bytes(conn: NvfsVfsConnection, path: text) -> Result<[u8], FsError>:
    """Read a complete file as bytes through the NVFS connection."""
    val rel_r = _nvfs_relpath(conn, path)
    if rel_r.is_err():
        return Err(rel_r.unwrap_err())
    val rel = rel_r.unwrap()
    val driver_r = _nvfs_vfs_load_driver(conn.conn_id)
    if driver_r.is_err():
        return Err(driver_r.unwrap_err())
    var driver = driver_r.unwrap()
    val stat_r = driver.stat(rel)
    if stat_r.is_err():
        val _ = _nvfs_vfs_store_driver(conn.conn_id, driver)
        return Err(stat_r.unwrap_err())
    val size = stat_r.unwrap().size.to_i64()
    if size > conn.max_bytes:
        val _ = _nvfs_vfs_store_driver(conn.conn_id, driver)
        _log_warn("read rejected: file size {size} > max {conn.max_bytes}")
        return Err(FsError.TooLarge)
    if size <= 0:
        val _ = _nvfs_vfs_store_driver(conn.conn_id, driver)
        return Ok([])
    val open_r = driver.open(rel, OpenFlags.read_only())
    if open_r.is_err():
        val _ = _nvfs_vfs_store_driver(conn.conn_id, driver)
        _log_error("open failed for '{path}'")
        return Err(open_r.unwrap_err())
    val handle = open_r.unwrap()
    var buf = rt_bytes_alloc(size)
    val read_r = driver.read(handle, 0, buf)
    driver.close(handle)
    val persist_r = _nvfs_vfs_store_driver(conn.conn_id, driver)
    if persist_r.is_err():
        return Err(persist_r.unwrap_err())
    if read_r.is_err():
        _log_error("read failed for '{path}'")
        return Err(read_r.unwrap_err())
    val n = read_r.unwrap()
    if n == size:
        return Ok(buf)
    # Truncate to bytes actually read.
    var out: [u8] = []
    var j: i64 = 0
    while j < n:
        out.push(buf[j])
        j = j + 1
    Ok(out)

fn nvfs_vfs_read_text(conn: NvfsVfsConnection, path: text) -> Result<text, FsError>:
    """Read a complete file as text through the NVFS connection."""
    val bytes_r = nvfs_vfs_read_bytes(conn, path)
    if bytes_r.is_err():
        return Err(bytes_r.unwrap_err())
    Ok(rt_bytes_to_text(bytes_r.unwrap()))

fn nvfs_vfs_file_size(conn: NvfsVfsConnection, path: text) -> Result<i64, FsError>:
    """Return file size for a path through the NVFS connection."""
    val rel_r = _nvfs_relpath(conn, path)
    if rel_r.is_err():
        return Err(rel_r.unwrap_err())
    val driver_r = _nvfs_vfs_load_driver(conn.conn_id)
    if driver_r.is_err():
        return Err(driver_r.unwrap_err())
    val driver = driver_r.unwrap()
    val stat_r = driver.stat(rel_r.unwrap())
    if stat_r.is_err():
        return Err(stat_r.unwrap_err())
    Ok(stat_r.unwrap().size.to_i64())

fn nvfs_vfs_file_exists(conn: NvfsVfsConnection, path: text) -> Result<bool, FsError>:
    """Return whether a path exists through the NVFS connection.

    Ok(true)  — stat succeeded.
    Ok(false) — stat returned NotFound only.
    Err(e)    — any other error (Permission, Transient, etc.).
    """
    val size_r = nvfs_vfs_file_size(conn, path)
    match size_r:
        case Ok(_):
            Ok(true)
        case Err(FsError.NotFound):
            Ok(false)
        case Err(e):
            Err(e)
