val PURE_FAT32_FILE_READ_MAX: u64 = 33554432
@unsafe(reason: "raw boot diagnostic line output ABI", capabilities: [ffi])
extern fn serial_println(msg: text)
@unsafe(reason: "foreign byte indexing requires caller-proven array bounds", capabilities: [ffi])
extern fn rt_bytes_u8_at(array: [u8], index: i64) -> i64

@always_inline
fn _vfs_state_serial_println(msg: text):
    unsafe(capabilities: [ffi]):
        serial_println(msg)

@always_inline
fn _vfs_state_elf_byte(bytes: [u8], index: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_bytes_u8_at(bytes, index) & 0xFF

var g_vfs: VfsManager = VfsManager.new()
class VfsFileSize:
    bytes: i64

    me fn to_i64() -> i64:
        self.bytes
var g_c_adapter: CNvmeBlockAdapter = CNvmeBlockAdapter.new()
var g_root_fat32: Fat32Core? = nil
var g_root_nvfs_hosted: NvfsPosixDriver? = nil
var g_vfs_initialized: bool = false
var g_vfs_boot_storage_provider: text = "not-mounted"
var g_vfs_boot_storage_pure_simple: bool = false
var g_mount_table: MountTable? = Some(MountTable.new())
val g_mount_table_mutex_v1: i64 = mutex_raw_create()
var g_mount_table_quarantined_v1: bool = false
var g_mount_table_lease_active_v1: bool = false
var g_mount_table_owner_epoch_v1: u64 = 1u64
var g_mount_table_next_lease_nonce_v1: u64 = 1u64
var g_mount_table_active_lease_nonce_v1: u64 = 0u64
var g_include_positioned_handle_ids_v1: [u64] = []
var g_include_positioned_tickets_v1: [VfsIncludeMutationTicketV1] = []

fn _positioned_open_may_write_v1(flags: OpenFlags) -> bool:
    (flags.bits & (1 | 2 | 64 | 512 | 1024)) != 0

fn _mount_affects_include_v1(path: text) -> bool:
    path == "/" or path == "/usr" or path == "/usr/include" or
        path.starts_with("/usr/include/")

fn _include_positioned_ticket_take_v1(handle_id: u64) -> VfsIncludeMutationTicketV1?:
    var index: i64 = 0
    while index < g_include_positioned_handle_ids_v1.len():
        if g_include_positioned_handle_ids_v1[index] == handle_id:
            val ticket = g_include_positioned_tickets_v1[index]
            g_include_positioned_handle_ids_v1.remove(index)
            g_include_positioned_tickets_v1.remove(index)
            return Some(ticket)
        index = index + 1
    nil

fn _vfs_state_mount_table_raw_lock_v1() -> bool:
    if g_mount_table_mutex_v1 <= 0 or g_mount_table_quarantined_v1:
        return false
    if not mutex_raw_lock(g_mount_table_mutex_v1): return false
    if g_mount_table_quarantined_v1:
        _ = mutex_raw_unlock(g_mount_table_mutex_v1)
        return false
    true

fn vfs_state_mount_table_lock_v1() -> bool:
    if not _vfs_state_mount_table_raw_lock_v1(): return false
    if g_mount_table_lease_active_v1 or not g_mount_table.?:
        _ = mutex_raw_unlock(g_mount_table_mutex_v1)
        return false
    true

fn vfs_state_mount_table_unlock_v1() -> bool:
    if mutex_raw_unlock(g_mount_table_mutex_v1): return true
    g_mount_table_quarantined_v1 = true
    false

pub(package) struct VfsMountTableOwnerHandleV1:
    """Copyable coordinate for the canonical VFS owner, never table state."""
    epoch: u64

pub(package) struct VfsMountTableLeaseV1:
    """Unique blocking loan moved out of the canonical owner under its lock."""
    epoch: u64
    nonce: u64
    table: MountTable

fn _vfs_state_advance_mount_table_owner_epoch_v1() -> bool:
    if g_mount_table_owner_epoch_v1 == 0u64 or
        g_mount_table_owner_epoch_v1 == 0xffffffffffffffffu64:
        g_mount_table_quarantined_v1 = true
        return false
    g_mount_table_owner_epoch_v1 = g_mount_table_owner_epoch_v1 + 1u64
    true

pub(package) fn vfs_state_mount_table_owner_handle_v1(
) -> VfsMountTableOwnerHandleV1?:
    if not vfs_state_mount_table_lock_v1(): return nil
    val handle = VfsMountTableOwnerHandleV1(
        epoch: g_mount_table_owner_epoch_v1)
    if not vfs_state_mount_table_unlock_v1(): return nil
    Some(handle)

pub(package) fn vfs_state_mount_table_owner_handle_is_live_v1(
    handle: VfsMountTableOwnerHandleV1
) -> bool:
    if not vfs_state_mount_table_lock_v1(): return false
    val live = handle.epoch != 0u64 and
        handle.epoch == g_mount_table_owner_epoch_v1
    if not vfs_state_mount_table_unlock_v1(): return false
    live

pub(package) fn vfs_state_mount_table_owner_handles_same_live_v1(
    left: VfsMountTableOwnerHandleV1,
    right: VfsMountTableOwnerHandleV1
) -> bool:
    """Compare opaque coordinates only while the canonical owner is locked."""
    if not vfs_state_mount_table_lock_v1(): return false
    val same = left.epoch != 0u64 and
        left.epoch == right.epoch and
        left.epoch == g_mount_table_owner_epoch_v1
    if not vfs_state_mount_table_unlock_v1(): return false
    same

pub(package) fn vfs_state_mount_table_lease_begin_v1(
    handle: VfsMountTableOwnerHandleV1
) -> VfsMountTableLeaseV1?:
    """Move the sole table value out; ordinary VFS operations fail closed."""
    if not _vfs_state_mount_table_raw_lock_v1(): return nil
    val bad_lease_start = g_mount_table_lease_active_v1 or not g_mount_table.? or
        handle.epoch == 0u64 or handle.epoch != g_mount_table_owner_epoch_v1
    if bad_lease_start:
        _ = mutex_raw_unlock(g_mount_table_mutex_v1)
        return nil
    if g_mount_table_next_lease_nonce_v1 == 0u64 or
        g_mount_table_next_lease_nonce_v1 == 0xffffffffffffffffu64:
        g_mount_table_quarantined_v1 = true
        _ = mutex_raw_unlock(g_mount_table_mutex_v1)
        return nil
    val nonce = g_mount_table_next_lease_nonce_v1
    g_mount_table_next_lease_nonce_v1 = nonce + 1u64
    val table = g_mount_table.unwrap()
    g_mount_table = nil
    g_mount_table_lease_active_v1 = true
    g_mount_table_active_lease_nonce_v1 = nonce
    if not vfs_state_mount_table_unlock_v1(): return nil
    Some(VfsMountTableLeaseV1(
        epoch: handle.epoch, nonce: nonce, table: table))

pub(package) fn vfs_state_mount_table_lease_restore_v1(
    lease: VfsMountTableLeaseV1
) -> bool:
    """Restore exactly one live lease; stale/double restores quarantine owner."""
    if not _vfs_state_mount_table_raw_lock_v1(): return false
    if not g_mount_table_lease_active_v1 or g_mount_table.? or
        lease.epoch == 0u64 or lease.epoch != g_mount_table_owner_epoch_v1 or
        lease.nonce == 0u64 or
        lease.nonce != g_mount_table_active_lease_nonce_v1:
        g_mount_table_quarantined_v1 = true
        _ = mutex_raw_unlock(g_mount_table_mutex_v1)
        return false
    g_mount_table = Some(lease.table)
    g_mount_table_lease_active_v1 = false
    g_mount_table_active_lease_nonce_v1 = 0u64
    vfs_state_mount_table_unlock_v1()

pub(package) fn vfs_state_mount_table_lease_restore_ready_v1(
    lease: VfsMountTableLeaseV1
) -> bool:
    """Restore one live lease AND publish readiness under a single lock.

    The readiness counterpart of `vfs_state_mount_table_lease_restore_v1`, and
    the sole publication point for a root staged through a table lease.

    ATOMICITY IS THE WHOLE POINT, and is why this lives here rather than in the
    transaction. `vfs_nvfs_root_mount_stage_v1` treats `vfs_is_ready()` as "the
    canonical root is already claimed" and refuses to stage when it is true, so
    readiness and the restored table must become visible together. Restoring
    first and setting readiness afterwards would expose a window in which the
    table carries a published root while the VFS still reports itself unready —
    exactly the state a second staging attempt is allowed to seize. Setting the
    flag from the transaction instead would publish readiness with the canonical
    owner still leased out, i.e. readiness over no reachable table at all.

    Validation, ordering and quarantine behaviour are identical to the plain
    restore: a stale, double or foreign-epoch restore quarantines the owner and
    publishes nothing. Readiness is written only after the table value is back
    under the same uninterrupted lock hold, so a rejected restore can never
    leave the VFS marked ready.
    """
    if not _vfs_state_mount_table_raw_lock_v1(): return false
    if not g_mount_table_lease_active_v1 or g_mount_table.? or
        lease.epoch == 0u64 or lease.epoch != g_mount_table_owner_epoch_v1 or
        lease.nonce == 0u64 or
        lease.nonce != g_mount_table_active_lease_nonce_v1:
        g_mount_table_quarantined_v1 = true
        _ = mutex_raw_unlock(g_mount_table_mutex_v1)
        return false
    g_mount_table = Some(lease.table)
    g_mount_table_lease_active_v1 = false
    g_mount_table_active_lease_nonce_v1 = 0u64
    # Same handoff identity the FAT32 production path publishes: the storage
    # acceptance reason hard-rejects any provider other than "simple-driver",
    # and this root reached us over the pure-Simple NVMe lease device.
    g_vfs_initialized = true
    g_vfs_boot_storage_provider = "simple-driver"
    g_vfs_boot_storage_pure_simple = true
    vfs_state_mount_table_unlock_v1()

# Narrow owner port for the server-data namespace.  Only opaque seals and
# immutable revalidation facts cross this seam; the MountTable and DBFS driver
# remain owned here.
pub fn vfs_state_acquire_dbfs_root_mount_seal_v1(
) -> Result<DbfsRootMountSealV1, FsError>:
    if not vfs_state_mount_table_lock_v1(): return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.acquire_dbfs_root_mount_seal()
    g_mount_table = Some(table)
    if not vfs_state_mount_table_unlock_v1(): return Err(FsError.IoError(code: 0u32))
    result

pub fn vfs_state_revalidate_dbfs_root_mount_seal_v1(
    seal: DbfsRootMountSealV1
) -> Result<DbfsRootMountSealInfoV1, FsError>:
    if not vfs_state_mount_table_lock_v1(): return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.revalidate_dbfs_root_mount_seal(seal)
    if not vfs_state_mount_table_unlock_v1(): return Err(FsError.IoError(code: 0u32))
    result

pub fn vfs_state_close_dbfs_root_mount_seal_v1(
    seal: DbfsRootMountSealV1
) -> Result<(), FsError>:
    if not vfs_state_mount_table_lock_v1(): return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.close_dbfs_root_mount_seal(seal)
    g_mount_table = Some(table)
    if not vfs_state_mount_table_unlock_v1(): return Err(FsError.IoError(code: 0u32))
    result

# Owner APIs for mutable root and MountTable state. Ordinary operations receive
# a mutex-scoped loan and commit only through this declaring module; the sole
# blocking exception is the exact nonce-bound lease above.
fn vfs_state_reset_rootfs() -> bool:
    val ticket = vfs_include_mutation_begin_v1("/usr/include")
    if ticket.is_err(): return false
    if not vfs_state_mount_table_lock_v1():
        _ = vfs_include_mutation_finish_v1(ticket.unwrap())
        return false
    g_root_fat32 = nil
    g_root_nvfs_hosted = nil
    g_mount_table_lease_active_v1 = false
    g_mount_table_active_lease_nonce_v1 = 0u64
    g_mount_table = Some(MountTable.new())
    if not _vfs_state_advance_mount_table_owner_epoch_v1():
        _ = vfs_state_mount_table_unlock_v1()
        _ = vfs_include_mutation_finish_v1(ticket.unwrap())
        return false
    g_vfs_initialized = false
    g_vfs_boot_storage_provider = "not-mounted"
    g_vfs_boot_storage_pure_simple = false
    if not vfs_state_mount_table_unlock_v1():
        _ = vfs_include_mutation_finish_v1(ticket.unwrap())
        return false
    vfs_include_mutation_finish_v1(ticket.unwrap())

fn vfs_state_mark_rootfs_ready():
    g_vfs_initialized = true

fn vfs_state_commit_root_nvfs(driver: NvfsPosixDriver):
    g_root_nvfs_hosted = Some(driver)

fn vfs_state_mount(path: text, driver: DriverInstance, options: MountOptions) -> Result<MountId, FsError>:
    val ticket = if _mount_affects_include_v1(path):
        val begun = vfs_include_mutation_begin_v1("/usr/include")
        if begun.is_err(): return Err(FsError.Permission)
        begun.unwrap()
    else:
        nil
    if not vfs_state_mount_table_lock_v1():
        _ = vfs_include_mutation_finish_v1(ticket)
        return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.mount(path, driver, options)
    g_mount_table = Some(table)
    if not vfs_state_mount_table_unlock_v1():
        _ = vfs_include_mutation_finish_v1(ticket)
        return Err(FsError.IoError(code: 0u32))
    if not vfs_include_mutation_finish_v1(ticket):
        return Err(FsError.IoError(code: 0u32))
    result

fn vfs_state_unmount(path: text) -> Result<(), FsError>:
    val ticket = if _mount_affects_include_v1(path):
        val begun = vfs_include_mutation_begin_v1("/usr/include")
        if begun.is_err(): return Err(FsError.Permission)
        begun.unwrap()
    else:
        nil
    if not vfs_state_mount_table_lock_v1():
        _ = vfs_include_mutation_finish_v1(ticket)
        return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.unmount(path)
    g_mount_table = Some(table)
    if not vfs_state_mount_table_unlock_v1():
        _ = vfs_include_mutation_finish_v1(ticket)
        return Err(FsError.IoError(code: 0u32))
    if not vfs_include_mutation_finish_v1(ticket):
        return Err(FsError.IoError(code: 0u32))
    result

fn vfs_state_positioned_open(path: text, flags: OpenFlags) -> Result<FileHandle, FsError>:
    var include_ticket: VfsIncludeMutationTicketV1? = nil
    if _positioned_open_may_write_v1(flags):
        val begun = vfs_include_mutation_begin_v1(path)
        if begun.is_err(): return Err(FsError.Permission)
        include_ticket = begun.unwrap()
    if not vfs_state_mount_table_lock_v1():
        _ = vfs_include_mutation_finish_v1(include_ticket)
        return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.open(path, flags)
    g_mount_table = Some(table)
    # Bind the include mutation lease to its handle while the same owner lock
    # still excludes close. Publishing the handle before these parallel arrays
    # were updated let concurrent close lose or consume the wrong lease.
    var include_ticket_registered = false
    if result.is_ok() and include_ticket.?:
        g_include_positioned_handle_ids_v1.push(result.unwrap().id)
        g_include_positioned_tickets_v1.push(include_ticket.unwrap())
        include_ticket_registered = true
    if not vfs_state_mount_table_unlock_v1():
        # A registered lease remains pinned when unlock quarantines the table;
        # finishing it here would falsely declare immutable-include stability
        # while the corresponding writable handle is still live.
        if not include_ticket_registered:
            _ = vfs_include_mutation_finish_v1(include_ticket)
        return Err(FsError.IoError(code: 0u32))
    if result.is_err():
        _ = vfs_include_mutation_finish_v1(include_ticket)
        return result
    result

fn vfs_state_positioned_close(handle: FileHandle) -> Result<(), FsError>:
    if not vfs_state_mount_table_lock_v1():
        return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.close(handle)
    # A driver-close failure leaves the handle live in MountTable. Retain its
    # include mutation lease in that case; only a successful close may declare
    # the guarded tree stable again.
    val include_ticket = if result.is_ok():
        _include_positioned_ticket_take_v1(handle.id)
    else:
        nil
    g_mount_table = Some(table)
    if not vfs_state_mount_table_unlock_v1():
        _ = vfs_include_mutation_finish_v1(include_ticket)
        return Err(FsError.IoError(code: 0u32))
    if not vfs_include_mutation_finish_v1(include_ticket):
        return Err(FsError.IoError(code: 0u32))
    result

fn vfs_state_positioned_fstat(handle: FileHandle) -> Result<FileStat, FsError>:
    if not vfs_state_mount_table_lock_v1(): return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.positioned_fstat(handle.id)
    g_mount_table = Some(table)
    if not vfs_state_mount_table_unlock_v1(): return Err(FsError.IoError(code: 0u32))
    result

fn vfs_state_positioned_ftruncate(handle: FileHandle, new_size: i64) -> Result<(), FsError>:
    """Resize one MountTable-owned positioned file object without path lookup."""
    if not vfs_state_mount_table_lock_v1(): return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.ftruncate(handle, new_size)
    g_mount_table = Some(table)
    if not vfs_state_mount_table_unlock_v1(): return Err(FsError.IoError(code: 0u32))
    result

fn vfs_state_fsync(handle: FileHandle) -> Result<(), FsError>:
    if not vfs_state_mount_table_lock_v1(): return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.fsync(handle)
    g_mount_table = Some(table)
    if not vfs_state_mount_table_unlock_v1(): return Err(FsError.IoError(code: 0u32))
    result

fn vfs_state_fdatasync(handle: FileHandle) -> Result<(), FsError>:
    if not vfs_state_mount_table_lock_v1(): return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.fdatasync(handle)
    g_mount_table = Some(table)
    if not vfs_state_mount_table_unlock_v1(): return Err(FsError.IoError(code: 0u32))
    result

fn vfs_state_positioned_read(file_id: u64, kind: PositionedDriverKind, offset: u64, length: u64) -> Result<[u8], FsError>:
    if not vfs_state_mount_table_lock_v1(): return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.positioned_read_bytes(file_id, kind, offset, length)
    g_mount_table = Some(table)
    if not vfs_state_mount_table_unlock_v1(): return Err(FsError.IoError(code: 0u32))
    result

fn vfs_state_positioned_write(file_id: u64, kind: PositionedDriverKind, offset: u64, data: [u8]) -> Result<u64, FsError>:
    if not vfs_state_mount_table_lock_v1(): return Err(FsError.IoError(code: 0u32))
    var table = g_mount_table.unwrap()
    val result = table.positioned_write_bytes(file_id, kind, offset, data)
    g_mount_table = Some(table)
    if not vfs_state_mount_table_unlock_v1(): return Err(FsError.IoError(code: 0u32))
    result


fn vfs_boot_nvme_shared_driver_ready_for_user_assignment() -> text:
    val storage_reason = vfs_boot_storage_acceptance_reason(
        g_vfs_initialized,
        g_vfs_boot_storage_provider,
        g_vfs_boot_storage_pure_simple
    )
    if storage_reason != "ready":
        return "nvme-user-assign-boot-storage-not-ready:" + storage_reason
    nvme_boot_runtime_driver_ready_for_user_assignment()

fn vfs_boot_nvme_assign_user_namespace_hardware_driver_instance(
    name: text,
    evidence: NvmeTransferEvidence,
    grant: DeviceGrant,
    controller_id: u32,
    nsid: u32,
    namespace_lba_size: u32,
    namespace_lba_count: u64,
    base_lba: u64,
    lease_lba_count: u64,
    queue_id: u16,
    owner_task: u64,
    max_depth: u16,
    consumer: NvmeFilesystemConsumer
) -> Result<DriverInstance, text>:
    val ready = vfs_boot_nvme_shared_driver_ready_for_user_assignment()
    if ready != "ready":
        return Err(ready)
    nvme_boot_runtime_assign_user_namespace_hardware_driver_instance(
        name, evidence, grant, controller_id, nsid, namespace_lba_size,
        namespace_lba_count, base_lba, lease_lba_count, queue_id,
        owner_task, max_depth, consumer)

fn vfs_boot_nvme_assign_discovered_user_namespace_hardware_driver_instance(
    name: text,
    evidence: NvmeTransferEvidence,
    grant: DeviceGrant,
    queue_id: u16,
    owner_task: u64,
    max_depth: u16,
    consumer: NvmeFilesystemConsumer
) -> Result<DriverInstance, text>:
    val ready = vfs_boot_nvme_shared_driver_ready_for_user_assignment()
    if ready != "ready":
        return Err(ready)
    nvme_boot_runtime_assign_discovered_user_namespace_hardware_driver_instance(
        name, evidence, grant, queue_id, owner_task, max_depth, consumer)

# Boot orchestration mutates canonical state in its declaring module.
fn _vfs_boot_reset_storage_state():
    if not vfs_state_mount_table_lock_v1(): return
    g_root_fat32 = nil
    g_root_nvfs_hosted = nil
    g_vfs_initialized = false
    g_mount_table_lease_active_v1 = false
    g_mount_table_active_lease_nonce_v1 = 0u64
    g_mount_table = Some(MountTable.new())
    if not _vfs_state_advance_mount_table_owner_epoch_v1():
        _ = vfs_state_mount_table_unlock_v1()
        return
    g_vfs = VfsManager.new()
    g_vfs_boot_storage_provider = "not-mounted"
    g_vfs_boot_storage_pure_simple = false
    nvme_boot_runtime_reset_leases()
    direct_fat32_boot_reader_reset()
    _ = vfs_state_mount_table_unlock_v1()

pub fn vfs_boot_init() -> bool:
    """Initialize the full storage stack: PCI -> NVMe -> FAT32 -> VFS.

    Uses only the pure-Simple NVMe -> lease-backed BlockDevice -> FAT32 path.

    Returns true if VFS is ready to serve file requests.
    """
    log_raw_println("[vfs-init] Starting storage stack initialization...")
    _vfs_boot_reset_storage_state()

    pcimgr_init()
    log_raw_println("[vfs-init] PCI cache ready")
    # Use the i64 variant with explicit i64 literals — the u8 path
    # (pcimgr_find_by_class) silently mismatches NVMe class/subclass on
    # baremetal Cranelift due to an integer-width comparison bug
    # (SYS-GUI-007 root cause).
    val nvme_class: i64 = 1  # PCI_CLASS_STORAGE (0x01)
    val nvme_sub: i64 = 8    # PCI_SUBCLASS_NVME (0x08)
    var nvme_idx = pcimgr_find_nvme_storage()
    if nvme_idx < 0:
        nvme_idx = pcimgr_find_by_class_i64(nvme_class, nvme_sub)
    if nvme_idx < 0:
        nvme_idx = pcimgr_find_qemu_nvme()
    if nvme_idx < 0:
        log_raw_println("[vfs-init] No NVMe device found -- VFS unavailable")
        return false
    log_raw_println("[vfs-init] Found NVMe device at index {nvme_idx}")

    if _vfs_boot_init_pure_nvme_fat32(nvme_idx.to_u64()):
        return true
    log_raw_println("[vfs-init] pure-Simple NVMe + FAT32 unavailable; VFS unavailable")
    false

pub fn vfs_boot_init_pure_nvme_device() -> bool:
    """Bring the pure-Simple NVMe lease device up and publish the production handoff.

    This is the FILESYSTEM-AGNOSTIC half of `vfs_boot_init_production()`: PCI
    enumeration -> NVMe device grant -> controller init -> transfer evidence ->
    system lease -> block adapter -> bounce buffer -> backend identity binding,
    then `boot_nvme_production_handoff_provision_bound`. It performs no FAT32
    work and deliberately does NOT set `g_vfs_initialized` — publishing
    readiness here would make `vfs_nvfs_root_mount_stage_v1` refuse with
    `root-already-ready`, since that transaction requires an unclaimed root.

    Callers pair this with `boot_fs_mount_freestanding_production()`, which
    probes NVFS -> DBFS -> FAT32 on the provisioned lease device and publishes
    whichever root it takes through the canonical mount transaction. That is how
    a non-FAT32 root (an NVFS volume) reaches the same production boot entry
    `os_main` uses; `vfs_boot_init_production()` cannot serve it because its
    bring-up is fused to `_vfs_boot_init_pure_nvme_fat32`.
    """
    log_raw_println("[vfs-init] Starting pure-Simple NVMe device bring-up (filesystem-agnostic)...")
    _vfs_boot_reset_storage_state()
    pcimgr_init()
    var nvme_idx = pcimgr_find_nvme_storage()
    if nvme_idx < 0:
        nvme_idx = pcimgr_find_by_class_i64(1, 8)
    if nvme_idx < 0:
        nvme_idx = pcimgr_find_qemu_nvme()
    if nvme_idx < 0:
        log_raw_println("[vfs-init] pure-nvme device rejected: no NVMe device")
        return false
    val grant_result = pcimgr_grant_device(nvme_idx.to_u64(), 0)
    if grant_result.is_err():
        log_raw_println("[vfs-init] pure-nvme device grant failed: {grant_result.unwrap_err()}")
        return false
    val grant = grant_result.unwrap()
    nvme_boot_runtime_reset()
    val nvme_init = nvme_boot_runtime_init(grant)
    if nvme_init.is_err():
        log_raw_println("[vfs-init] pure-nvme device init failed: {nvme_init.unwrap_err()}")
        return false
    val transfer_evidence_result = nvme_boot_runtime_transfer_evidence(
        device_grant_is_isolated(grant))
    if transfer_evidence_result.is_err():
        log_raw_println("[vfs-init] pure-nvme transfer probe failed: {transfer_evidence_result.unwrap_err()}")
        return false
    val transfer_evidence = transfer_evidence_result.unwrap()
    val lease_result = vfs_boot_nvme_system_fat32_lease_from_transfer_evidence(
        nvme_boot_runtime_sector_size(),
        nvme_boot_runtime_sector_count(),
        transfer_evidence
    )
    if lease_result.is_err():
        log_raw_println("[vfs-init] pure-nvme lease unavailable: {lease_result.unwrap_err()}")
        return false
    val lease = lease_result.unwrap()
    var adapter = nvme_boot_runtime_system_adapter()
    val bounce_init = adapter.init_bounce_buffer()
    if bounce_init.is_err():
        log_raw_println("[vfs-init] pure-nvme bounce buffer failed: {bounce_init.unwrap_err()}")
        return false
    val backend_binding = nvme_boot_runtime_backend_binding(lease.base_lba, lease.lba_count)
    if backend_binding.is_err():
        log_raw_println("[vfs-init] pure-nvme backend identity unavailable: {backend_binding.unwrap_err()}")
        return false
    boot_nvme_production_handoff_provision_bound(
        adapter, transfer_evidence, lease, backend_binding.unwrap())
    log_raw_println("[vfs-init] pure-Simple NVMe lease device provisioned for production mount")
    true

pub fn vfs_boot_init_production() -> bool:
    """Initialize production VFS without entering C bridge or virtio fallback storage."""
    log_raw_println("[vfs-init] Starting production NVMe storage initialization...")
    _vfs_boot_reset_storage_state()
    pcimgr_init()
    log_raw_println("[vfs-init] PCI cache ready")
    val nvme_class: i64 = 1
    val nvme_sub: i64 = 8
    var nvme_idx = pcimgr_find_nvme_storage()
    if nvme_idx < 0:
        nvme_idx = pcimgr_find_by_class_i64(nvme_class, nvme_sub)
    if nvme_idx < 0:
        nvme_idx = pcimgr_find_qemu_nvme()
    if nvme_idx < 0:
        log_raw_println("[vfs-init] production boot storage rejected: no NVMe device")
        return false
    if not _vfs_boot_init_pure_nvme_fat32(nvme_idx.to_u64()):
        log_raw_println("[vfs-init] production boot storage rejected: pure-Simple NVMe unavailable")
        return false
    
    val reason = vfs_boot_storage_acceptance_reason(
        g_vfs_initialized,
        g_vfs_boot_storage_provider,
        g_vfs_boot_storage_pure_simple
    )
    if reason != "ready":
        log_raw_println("[vfs-init] production boot storage rejected: {reason}")
        return false
    val swap_reason = _vfs_boot_install_memory_swap()
    log_raw_println("[vfs-init] memory swap: {swap_reason}")
    true

struct VfsBootMemorySwapRange:
    base_lba: u64
    capacity_slots: u64

fn vfs_boot_memory_swap_range(volume_sectors: u64, volume_sector_size: u32, namespace_sectors: u64, namespace_sector_size: u32) -> VfsBootMemorySwapRange?:
    if volume_sectors == 0 or volume_sector_size == 0 or namespace_sectors == 0 or namespace_sector_size == 0:
        return nil
    if volume_sectors > 0xFFFFFFFFu64:
        return nil
    val volume_bytes = volume_sectors * volume_sector_size.to_u64()
    val base_lba = (volume_bytes + namespace_sector_size.to_u64() - 1) / namespace_sector_size.to_u64()
    if base_lba >= namespace_sectors:
        return nil
    val sectors_per_slot = (4096 + namespace_sector_size.to_u64() - 1) / namespace_sector_size.to_u64()
    val capacity_slots = (namespace_sectors - base_lba) / sectors_per_slot
    if capacity_slots == 0:
        return nil
    Some(VfsBootMemorySwapRange(base_lba: base_lba, capacity_slots: capacity_slots))

fn _vfs_boot_install_memory_swap() -> text:
    match vfs_boot_memory_swap_range(g_direct_fat32_boot_reader.total_sectors, g_direct_fat32_boot_reader.bytes_per_sector, nvme_boot_runtime_sector_count(), nvme_boot_runtime_sector_size()):
        nil: "unavailable:no-dedicated-range"
        swap_range:
            val device_impl = BootNvmeBlockDevice(sector_size_bytes: nvme_boot_runtime_sector_size())
            val device: BlockDevice = device_impl
            memory_swap_runtime_install_block_device(device, swap_range.base_lba, swap_range.capacity_slots)

fn _vfs_boot_init_pure_nvme_fat32(nvme_idx: u64) -> bool:
    """Try the pure-Simple NVMe -> BlockDevice -> FAT32 stack first."""
    g_pure_nvme_root_fat32_ready = false
    log_raw_println("[vfs-init] Trying pure-Simple NVMe + FAT32 stack...")
    _vfs_state_serial_println("[vfs-init] pure-nvme begin")
    val grant_result = pcimgr_grant_device(nvme_idx, 0)
    if grant_result.is_err():
        log_raw_println("[vfs-init] pure-Simple NVMe grant failed: {grant_result.unwrap_err()}")
        _vfs_state_serial_println("[vfs-init] pure-nvme grant failed")
        return false
    nvme_boot_runtime_reset()
    val grant = grant_result.unwrap()
    _vfs_state_serial_println("[vfs-init] pure-nvme grant ok")
    val nvme_init = nvme_boot_runtime_init(grant)
    if nvme_init.is_err():
        log_raw_println("[vfs-init] pure-Simple NVMe init failed: {nvme_init.unwrap_err()}")
        _vfs_state_serial_println("[vfs-init] pure-nvme init failed")
        return false
    val transfer_evidence_result = nvme_boot_runtime_transfer_evidence(
        device_grant_is_isolated(grant))
    if transfer_evidence_result.is_err():
        log_raw_println("[vfs-init] pure-Simple NVMe transfer probe failed: {transfer_evidence_result.unwrap_err()}")
        _vfs_state_serial_println("[vfs-init] pure-nvme transfer failed")
        return false
    val transfer_evidence = transfer_evidence_result.unwrap()
    val lease_result = vfs_boot_nvme_system_fat32_lease_from_transfer_evidence(
        nvme_boot_runtime_sector_size(),
        nvme_boot_runtime_sector_count(),
        transfer_evidence
    )
    val lease = if lease_result.is_err():
        val lease_err = lease_result.unwrap_err()
        log_raw_println("[vfs-init] pure-Simple NVMe evidence lease policy degraded: {lease_err}")
        _vfs_state_serial_println("[vfs-init] pure-nvme lease policy degraded " + lease_err)
        vfs_boot_nvme_system_fat32_lease(nvme_boot_runtime_sector_size(), nvme_boot_runtime_sector_count(), grant)
    else:
        lease_result.unwrap()
    var adapter = nvme_boot_runtime_system_adapter()
    val bounce_init = adapter.init_bounce_buffer()
    if bounce_init.is_err():
        log_raw_println("[vfs-init] pure-Simple NVMe bounce buffer failed: {bounce_init.unwrap_err()}")
        _vfs_state_serial_println("[vfs-init] pure-nvme bounce failed")
        return false
    val backend_binding = nvme_boot_runtime_backend_binding(lease.base_lba, lease.lba_count)
    if backend_binding.is_err():
        log_raw_println("[vfs-init] pure-Simple NVMe backend identity unavailable: {backend_binding.unwrap_err()}")
        _vfs_state_serial_println("[vfs-init] pure-nvme backend identity unavailable")
        return false
    val boot_dma = _vfs_boot_nvme_shared_dma(4096u32)
    if boot_dma.is_err():
        _vfs_state_serial_println("[vfs-init] boot sector dma alloc failed")
        return false
    val boot_shared = boot_dma.unwrap()
    var zero_i: u64 = 0
    while zero_i < 512u64:
        mmio_write8(boot_shared.cpu_virt_addr + zero_i, 0u8)
        zero_i = zero_i + 1u64
    val boot_sector_probe = nvme_boot_runtime_read_system_shared(0u64, 1u32, boot_shared)
    if boot_sector_probe.is_err():
        val boot_read_err = boot_sector_probe.unwrap_err()
        log_raw_println("[vfs-init] pure-Simple FAT32 boot sector read failed: {boot_read_err}")
        _vfs_state_serial_println("[vfs-init] boot sector direct read failed " + boot_read_err)
        return false
    _vfs_state_serial_println("[vfs-init] boot sector direct read ok")
    if not _vfs_boot_init_direct_fat32_reader_from_addr(boot_shared.cpu_virt_addr):
        log_raw_println("[vfs-init] pure-Simple direct FAT32 mount failed")
        _vfs_state_serial_println("[vfs-init] fat32 direct mount failed")
        return false
    var version_probe = _vfs_boot_read_version_probe_raw()
    if version_probe.len() <= 0:
        log_raw_println("[vfs-init] version file read probe failed path=/VERSION.TXT")
        _vfs_state_serial_println("[vfs-init] version read failed")
        return false
    _vfs_state_serial_println("[vfs-init] numeric version probe ok bytes={version_probe.len()}")
    app_registry_load_hardcoded_fallback()
    val exec_probe = _vfs_boot_read_app_name11_raw(0x42u32, 0x52u32, 0x4Fu32, 0x57u32, 0x53u32, 0x4Du32, 0x46u32, 0x20u32, 0x53u32, 0x4Du32, 0x46u32)
    if exec_probe.len() <= 4 or not _bytes_have_elf_magic(exec_probe):
        _vfs_state_serial_println("[vfs-init] exec probe failed")
        return false
    # The direct reader above is only bootstrap evidence.  Completion requires
    # publishing the same lease-backed adapter through the canonical shared
    # FAT32 owner; returning success without this commit gave callers a
    # path-only filesystem that could not issue MountTable execution authority.
    val pure_root_mount = nvme_boot_runtime_commit_system_fat32(adapter, lease)
    if pure_root_mount.is_ok():
        log_raw_println("[vfs-init] shared FAT32 root mounted after direct bootstrap")
    else:
        log_raw_println("[vfs-init] shared FAT32 root mount required after direct bootstrap")
        _vfs_state_serial_println("[vfs-init] shared FAT32 root mount failed")
        return false
    g_root_fat32 = nil
    g_vfs_initialized = true
    g_vfs_boot_storage_provider = "simple-driver"
    g_vfs_boot_storage_pure_simple = true
    app_registry_cache_bytes("/sys/apps/browser_demo", exec_probe)
    app_registry_cache_boot_app_id(1u64, exec_probe)
    val hello_bytes = _vfs_boot_read_app_name11_raw(0x48u32, 0x45u32, 0x4Cu32, 0x4Cu32, 0x4Fu32, 0x53u32, 0x4Du32, 0x46u32, 0x53u32, 0x4Du32, 0x46u32)
    val clang_bytes = _vfs_boot_read_app_name11_raw(0x43u32, 0x4Cu32, 0x41u32, 0x4Eu32, 0x47u32, 0x53u32, 0x4Du32, 0x46u32, 0x53u32, 0x4Du32, 0x46u32)
    if hello_bytes.len() <= 4 or clang_bytes.len() <= 4:
        _vfs_state_serial_println("[vfs-init] required desktop app payload missing")
        return false
    app_registry_cache_bytes("/sys/apps/hello_world", hello_bytes)
    app_registry_cache_bytes("/sys/apps/clang", clang_bytes)
    app_registry_cache_boot_app_id(3u64, hello_bytes)
    app_registry_cache_boot_app_id(12u64, clang_bytes)
    # Publish only after every boot prerequisite has committed. A failed
    # bootstrap path must not leave an apparently ready storage handoff.
    boot_nvme_production_handoff_provision_bound(
        adapter, transfer_evidence, lease, backend_binding.unwrap())
    _vfs_state_serial_println("[vfs-init] required desktop app payloads cached")
    log_raw_println("[vfs-init] version file read ok path=/sys/version.txt bytes={version_probe.len()}")
    log_raw_println("[vfs-init] executable load probe ok path=/sys/apps/browser_demo.smf bytes={exec_probe.len()}")
    log_raw_println("[vfs] mounted fat32 provider=pure-simple-direct")
    log_raw_println("[vfs-init] VFS ready (pure-Simple NVMe + FAT32)")
    true


pub fn vfs_boot_init_virtio_fat32() -> bool:
    """Initialize VFS from QEMU VirtIO-BLK FAT32 media on ARM virt machines."""
    log_raw_println("[vfs-init] Starting VirtIO-BLK FAT32 initialization...")
    _vfs_boot_reset_storage_state()
    val dev_opt = VirtioBlkDriver.probe()
    if dev_opt == nil:
        log_raw_println("[vfs-init] No VirtIO-BLK device found -- VFS unavailable")
        return false
    var dev: VirtioBlkDriver = dev_opt.unwrap()
    val dev_init = dev.init()
    if dev_init.is_err():
        log_raw_println("[vfs-init] VirtIO-BLK init failed")
        return false

    var root = Fat32Core.new(dev)
    val mount_result = root.mount("", "")
    if mount_result.is_err():
        log_raw_println("[vfs-init] VirtIO FAT32 mount failed: {mount_result.unwrap_err()}")
        return false

    g_root_fat32 = Some(root)
    g_vfs_initialized = true
    g_vfs_boot_storage_provider = "virtio-blk"
    g_vfs_boot_storage_pure_simple = true
    nvme_boot_runtime_reset_leases()
    log_raw_println("[vfs-init] VirtIO FAT32 mounted at /")

    val probe = g_vfs_read_file_bytes("/SYS/APPS/HELLOSMF.SMF")
    if probe.len() <= 4:
        log_raw_println("[vfs-init] executable load probe failed path=/SYS/APPS/HELLOSMF.SMF")
        _vfs_boot_reset_storage_state()
        return false
    log_raw_println("[vfs-init] executable load probe ok path=/sys/apps/hello_world.smf bytes={probe.len()}")
    log_raw_println("[vfs-init] VFS ready (VirtIO-BLK FAT32)")
    true

pub fn vfs_boot_init_riscv64_virtio_fat32() -> bool:
    """Mount the RV64 desktop's legacy-PCI VirtIO-BLK FAT32 font media."""
    log_raw_println("[vfs-init] Starting RV64 VirtIO-BLK FAT32 initialization...")
    _vfs_boot_reset_storage_state()
    val adapter_result = Riscv64VirtioBlkAdapter.initialize()
    if adapter_result.is_err():
        log_raw_println("[vfs-init] RV64 VirtIO-BLK unavailable: {adapter_result.unwrap_err()}")
        return false
    val adapter = adapter_result.unwrap()
    var root = Fat32Core.new(adapter)
    val mount_result = root.mount("", "")
    if mount_result.is_err():
        log_raw_println("[vfs-init] RV64 VirtIO FAT32 mount failed: {mount_result.unwrap_err()}")
        return false

    # The legacy VFS view above is still used by desktop/font consumers.  The
    # executable loader, however, accepts authority only from an owned
    # MountTable ExecuteOpenBinding.  Mount the exact same block device bytes
    # through the canonical FsDriver interface; never copy file bytes into a
    # RAM filesystem or synthesize a binding from a pathname.
    var execute_driver = FsFat32Driver.new("riscv64-virtio-fat32", adapter)
    val execute_driver_mount = execute_driver.mount(MountOptions.default())
    if execute_driver_mount.is_err():
        log_raw_println("[vfs-init] RV64 canonical FAT32 driver mount failed")
        _vfs_boot_reset_storage_state()
        return false
    val canonical_mount = vfs_state_mount(
        "/", DriverInstance.Fat32(execute_driver), MountOptions.default())
    if canonical_mount.is_err():
        log_raw_println("[vfs-init] RV64 canonical MountTable mount failed")
        _vfs_boot_reset_storage_state()
        return false

    g_root_fat32 = Some(root)
    g_vfs_initialized = true
    g_vfs_boot_storage_provider = "virtio-blk-riscv64"
    g_vfs_boot_storage_pure_simple = true
    nvme_boot_runtime_reset_leases()
    val font_probe = g_vfs_read_file_bytes("/SYS/FONTS/NOTOSANS")
    if font_probe.len() != 1708408:
        log_raw_println("[vfs-init] RV64 font load probe failed path=/SYS/FONTS/NOTOSANS bytes={font_probe.len()}")
        _vfs_boot_reset_storage_state()
        return false
    log_raw_println("[vfs-init] RV64 VirtIO FAT32 mounted font bytes={font_probe.len()}")
    true

# ============================================================================
# VFS IPC Service
# ============================================================================

pub fn vfs_service_start():
    """Start the VFS IPC service loop (blocking).

    For cooperative scheduling, use vfs_service_init_port() + vfs_service_poll().
    """
    if not g_vfs_initialized:
        log_raw_println("[vfs] Cannot start service -- not initialized")
        return
    var service = VfsService.new(g_vfs)
    service.start()

# Module-level VFS service instance for cooperative scheduling
var g_vfs_service: VfsService? = nil

pub fn vfs_service_init_port():
    """Initialize the VFS IPC port without entering the blocking loop.

    Use with vfs_service_poll() for cooperative scheduling.
    """
    if not g_vfs_initialized:
        log_raw_println("[vfs] Cannot init port -- not initialized")
        return
    g_vfs_service = VfsService.new(g_vfs)
    g_vfs_service.init_port()

pub fn vfs_service_poll():
    """Process one VFS IPC request if available (non-blocking).

    Call from a cooperative main loop alongside netstack and shell.
    """
    if g_vfs_service != nil:
        g_vfs_service.poll_once()

# ============================================================================
# Query Helpers
# ============================================================================

pub fn vfs_is_ready() -> bool:
    """Check if VFS has been initialized and is ready for file operations."""
    g_vfs_initialized

pub fn vfs_boot_storage_provider() -> text:
    g_vfs_boot_storage_provider

pub fn vfs_boot_storage_is_pure_simple() -> bool:
    g_vfs_boot_storage_pure_simple

fn vfs_boot_storage_acceptance_reason(initialized: bool, provider: text, pure_simple: bool) -> text:
    if not initialized:
        return "not-mounted"
    if not pure_simple:
        return "vfs-boot-storage-not-pure-simple:" + provider
    if provider != "simple-driver":
        return "vfs-boot-storage-not-nvme-simple-driver:" + provider
    "ready"

fn vfs_boot_storage_production_ready(initialized: bool, provider: text, pure_simple: bool) -> bool:
    vfs_boot_storage_acceptance_reason(initialized, provider, pure_simple) == "ready"

pub fn vfs_boot_storage_acceptance_ready() -> bool:
    vfs_boot_storage_production_ready(
        g_vfs_initialized,
        g_vfs_boot_storage_provider,
        g_vfs_boot_storage_pure_simple
    )

pub fn vfs_get_manager() -> VfsManager:
    """Return the global VFS manager instance."""
    g_vfs

# ============================================================================
# Internal helpers used by boot init
# ============================================================================

fn _vfs_bytes_to_text(buf: [u8], count: i64) -> text:
    var result: text = ""
    var i: i64 = 0
    while i < count and i < buf.len():
        # `.chr()` has no native-lane lowering (empty on baremetal);
        # char_from_code is pure Simple and kernel-proven.
        val b: i64 = buf[i as i32] as i64
        result = result + char_from_code(b)
        i = i + 1
    result

fn _known_app_has_elf_magic(buf_addr: u64) -> bool:
    if mmio_read8(buf_addr) != 0x7F.to_u8():
        return false
    if mmio_read8(buf_addr + 1) != 0x45.to_u8():
        return false
    if mmio_read8(buf_addr + 2) != 0x4C.to_u8():
        return false
    if mmio_read8(buf_addr + 3) != 0x46.to_u8():
        return false
    true

fn _bytes_have_elf_magic(bytes: [u8]) -> bool:
    if bytes.len() < 4:
        return false
    _vfs_state_elf_byte(bytes, 0) == 0x7F and
        _vfs_state_elf_byte(bytes, 1) == 0x45 and
        _vfs_state_elf_byte(bytes, 2) == 0x4C and
        _vfs_state_elf_byte(bytes, 3) == 0x46

fn _copy_bytes_from_addr(addr: u64, size: u64) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < size:
        out.push(mmio_read8(addr + i))
        i = i + 1
    out

fn _cache_c_fat32_exec_bytes(path: text) -> [u8]:
    val signed_size = simpleos_fat32_read_path_size(path)
    if signed_size <= 4:
        return []
    val file_size = signed_size.to_u64()
    if file_size > FAT32_PATH_READ_BUFFER_MAX:
        return []
    val read_result = simpleos_fat32_read_path(path)
    if read_result != 0:
        return []
    if not _known_app_has_elf_magic(simpleos_fat32_path_read_buffer_addr()):
        return []
    _copy_bytes_from_addr(simpleos_fat32_path_read_buffer_addr(), file_size)

fn _seed_c_fat32_exec_bytes(label: text, path: text) -> [u8]:
    val bytes = _cache_c_fat32_exec_bytes(path)
    if bytes.len() > 0:
        _vfs_state_serial_println("[vfs-fix] {label} seeded len={bytes.len()} path={path}")
    else:
        _vfs_state_serial_println("[vfs-fix] {label} probe skipped path={path}")
    bytes

fn _seed_root_fat32_app_registry(root: Fat32Core):
    val manifest_bytes = vfs_boot_root_read_file_bytes_once(root, "/SYS/APPS/APPIDX.TXT")
    if manifest_bytes.len() > 0:
        val manifest_text = _vfs_bytes_to_text(manifest_bytes, manifest_bytes.len().to_u64())
        app_registry_load(manifest_text)
        log_raw_println("[vfs-init] app-registry loaded from pure-Simple FAT32 manifest")
    else:
        app_registry_load_hardcoded_fallback()
        log_raw_println("[vfs-init] app-registry loaded from hardcoded fallback")

fn _seed_root_fat32_exec_bytes(root: Fat32Core, label: text, path: text) -> [u8]:
    val bytes = vfs_boot_root_read_file_bytes_once(root, path)
    if bytes.len() > 4 and _bytes_have_elf_magic(bytes):
        _vfs_state_serial_println("[vfs-fix] {label} seeded len={bytes.len()} path={path}")
        return bytes
    _vfs_state_serial_println("[vfs-fix] {label} probe skipped path={path}")
    []

fn _seed_root_fat32_exec_cache(root: Fat32Core):
    for seed_entry in app_registry_boot_seed_entries():
        if seed_entry.canonical_path == "/sys/apps/browser_demo":
            continue
        val seed_fat32 = app_registry_fat32_alias(seed_entry.canonical_path)
        if seed_fat32 == nil:
            continue
        val seed_path = seed_fat32.unwrap()
        val seed_root = app_registry_root_alias(seed_entry.canonical_path)
        if seed_root != nil:
            val root_bytes = _seed_root_fat32_exec_bytes(root, seed_entry.canonical_path, seed_root.unwrap())
            if root_bytes.len() > 0:
                app_registry_cache_bytes(seed_entry.canonical_path, root_bytes)
                continue
        val seed_bytes = _seed_root_fat32_exec_bytes(root, seed_entry.canonical_path, seed_path)
        if seed_bytes.len() > 0:
            app_registry_cache_bytes(seed_entry.canonical_path, seed_bytes)

# Ambient container context — the ONE identity the free-function VFS API has
# ============================================================================
#
# The `g_vfs_*` free functions in vfs_write_ops.spl / vfs_init.spl take no
# caller identity and cannot be given one today (no process->VfsManager binding
# exists in SimpleOS). They are *ambient*: they act on whatever the global VFS
# is currently resolving on behalf of. That ambient identity already exists and
# is already gated — it is `g_vfs.container_view`, wired by lane CONTWIRE.
#
# These accessors are NOT a second gate. They forward, verbatim, to the single
# converged choke point `VfsManager.enforce_lookup_grants`, which delegates the
# actual decision to `container_view_allows_path`. One owner per decision.
#
# They live HERE, in the module that declares `g_vfs`, on purpose: a class-typed
# module global mutated through a `me` method from another module loses the
# write on the interpreter. Mutation is done extract-mutate-write-back, in-module.

pub fn vfs_ambient_enforce(operation: text, path: text) -> Result<bool, text>:
    """Ask the ambient VFS manager whether `operation` on `path` is permitted.

    Host context (no container view) always answers Ok(true) — this is the
    non-container no-regression contract, inherited unchanged from CONTWIRE.
    """
    g_vfs.enforce_lookup_grants(operation, path)

pub fn vfs_ambient_allows(operation: text, path: text) -> bool:
    """Boolean form of `vfs_ambient_enforce`, for the bool-returning free API."""
    val decision = vfs_ambient_enforce(operation, path)
    decision.is_ok()

pub fn vfs_ambient_in_container() -> bool:
    """True when the ambient VFS is confined to a container namespace.

    Used by operations that construct or destroy namespace structure (mount /
    unmount): those are refused wholesale inside a container, since there is no
    path that makes them safe.

    Normalised to a real `true`/`false`: `VfsManager.in_container()` is written
    as `self.container_view.?`, and on the interpreter `.?` yields the option
    itself rather than a bool. Truthiness happens to be correct, but a bool-typed
    return must not depend on that.
    """
    if g_vfs.in_container():
        return true
    false

pub fn vfs_ambient_enter_container_view(view: ContainerNamespaceView):
    """Confine the ambient VFS to `view` (pass ContainerWorld.kernel_view_of).

    A stopped or reaped container's view is already rootless, so entering it
    resolves nothing — lifecycle failure stays fail-closed by construction.
    """
    var manager = g_vfs
    manager.enter_container_view(view)
    g_vfs = manager

pub fn vfs_ambient_enter_container(root: text, pids: [u64]):
    """Convenience: confine the ambient VFS to `root` with `pids`."""
    var manager = g_vfs
    manager.enter_container(root, pids)
    g_vfs = manager

pub fn vfs_ambient_enter_rootless_container():
    """Enter the deny-everything view a stopped/unpopulated container holds."""
    var manager = g_vfs
    manager.enter_rootless_container()
    g_vfs = manager

pub fn vfs_ambient_leave_container():
    """Return the ambient VFS to HOST context (unrestricted)."""
    var manager = g_vfs
    manager.leave_container()
    g_vfs = manager

pub fn _vfs_ambient_mount_for_test(path: text, fs_type: text, fs: Filesystem) -> bool:
    """Mount `fs` into the ambient manager so free-function specs have a sink.

    Same in-module extract-mutate-write-back rule as the enter/leave pair.
    Sibling of the existing `_mount_hosted_rootfs_for_test`.
    """
    var manager = g_vfs
    val r = manager.mount(path, fs_type, "dev0", false, fs)
    g_vfs = manager
    r.is_ok()

pub fn _vfs_ambient_reset_for_test():
    """Drop the ambient manager back to a bare host-context VfsManager."""
    g_vfs = VfsManager.new()
