"""Canonical SimpleOS owner for NVFS/DBFS positioned file objects.

The object identity is the MountTable virtual handle returned by
``g_vfs_positioned_open``. MountTable allocates those identities monotonically,
binds them to one mount and one opaque inner handle, and retires the binding on
close. Raw driver handle IDs are never accepted as SOSIX file objects.
"""

use os.services.vfs.vfs_boot_init.{g_mount_table}
use std.fs_driver.error.{FsError}
use std.fs_driver.mount_table.{PositionedDriverKind}
use std.fs_driver.types.{FileHandle, OpenFlags}

pub fn g_vfs_positioned_open(path: text, flags: OpenFlags) -> Result<u64, FsError>:
    val opened = g_mount_table.open(path, flags)?
    if opened.id == 0:
        return Err(FsError.StaleHandle)
    Ok(opened.id)

pub fn g_vfs_positioned_close(file_object_id: u64) -> Result<(), FsError>:
    if file_object_id == 0:
        return Err(FsError.StaleHandle)
    g_mount_table.close(FileHandle(id: file_object_id))

pub fn g_vfs_nvfs_read_at(
    file_object_id: u64, offset: u64, length: u64
) -> Result<[u8], FsError>:
    g_mount_table.positioned_read_bytes(
        file_object_id, PositionedDriverKind.Nvfs, offset, length)

pub fn g_vfs_nvfs_write_at(
    file_object_id: u64, offset: u64, data: [u8]
) -> Result<u64, FsError>:
    g_mount_table.positioned_write_bytes(
        file_object_id, PositionedDriverKind.Nvfs, offset, data)

pub fn g_vfs_dbfs_read_at(
    file_object_id: u64, offset: u64, length: u64
) -> Result<[u8], FsError>:
    g_mount_table.positioned_read_bytes(
        file_object_id, PositionedDriverKind.Dbfs, offset, length)

pub fn g_vfs_dbfs_write_at(
    file_object_id: u64, offset: u64, data: [u8]
) -> Result<u64, FsError>:
    g_mount_table.positioned_write_bytes(
        file_object_id, PositionedDriverKind.Dbfs, offset, data)

export g_vfs_positioned_open, g_vfs_positioned_close
export g_vfs_nvfs_read_at, g_vfs_nvfs_write_at
export g_vfs_dbfs_read_at, g_vfs_dbfs_write_at
