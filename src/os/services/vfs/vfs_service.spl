# VFS IPC Service -- User-space filesystem service
#
# MDSOC: feature dimension, vfs layer
# Listens on the named VFS IPC service port for filesystem requests from applications.
# Dispatches to mounted Filesystem implementations via VfsManager.
#
# Wire protocol:
#   Request:  copied IPC header with method (u32) plus payload (bytes).
#             Legacy clients send method-prefixed bytes from a caller-owned
#             anonymous reply port; the kernel moves that method to the header.
#   Response: status (i32) | payload (bytes)
#
# Payload encoding per method:
#   OPEN:   path (text) \0 flags_u32
#   READ:   fd (u64) | size (u64)
#   WRITE:  fd (u64) | data (bytes)
#   CLOSE:  fd (u64)
#   STAT:   path (text)
#   READDIR: path (text)
#   MKDIR:  path (text)
#   UNLINK: path (text)
#   RENAME: old_path (text) \0 new_path (text)
#   SEEK:   fd (u64) | offset (i64) | whence (u8)
#   MOUNT_LIST: (empty)
#   CHMOD:  path (text) \0 mode (u16)
#   SYMLINK: target (text) \0 link_path (text)

use os.services.vfs.vfs.{VfsManager, SeekWhence}
use os.kernel.types.fs_types.{FileDescriptor, FileFlags, FsNode, FsNodeKind, DirEntry}
use os.kernel.types.ipc_types.{IpcFlags}
use os.async.os_executor.{OsExecutor}
use os.userlib.ipc_endpoint.{
    ipc_create_named_port, ipc_recv_owned_v1_into, ipc_reply_owned_v1,
    IPC_OWNED_V1_HEADER_BYTES, IPC_OWNED_V1_MAX_PAYLOAD_BYTES
}

use os.kernel.log.klog_api.{log_raw_println}
extern fn syscall(id: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64) -> i64
extern fn unsafe_addr_of(ref: any) -> u64

# VFS IPC method constants
val VFS_OPEN: u32 = 1
val VFS_READ: u32 = 2
val VFS_WRITE: u32 = 3
val VFS_CLOSE: u32 = 4
val VFS_STAT: u32 = 5
val VFS_READDIR: u32 = 6
val VFS_MKDIR: u32 = 7
val VFS_UNLINK: u32 = 8
val VFS_RENAME: u32 = 9
val VFS_MOUNT_LIST: u32 = 10
val VFS_SEEK: u32 = 11
val VFS_CHMOD: u32 = 12
val VFS_SYMLINK: u32 = 13
val VFS_RMDIR: u32 = 14

# VFS_OPEN carries the kernel's POSIX O_* bit layout, never a service-private
# flag encoding.  Keep this decoding boundary aligned with os.kernel.fd_table.
val VFS_OPEN_O_ACCMODE: u32 = 3u32
val VFS_OPEN_O_WRONLY: u32 = 1u32
val VFS_OPEN_O_CREAT: u32 = 64u32
val VFS_OPEN_O_TRUNC: u32 = 512u32
val VFS_OPEN_O_APPEND: u32 = 1024u32

# Legacy copied reply route for clients still using syscall 20/21.
val SYS_IPC_SEND: u64 = 20
val SYS_YIELD: u64 = 1u64

# The kernel's copied service ABI accepts a 4096-byte raw reply and a request
# frame of method(u32) + at most 4096 payload bytes.  Keep the VFS boundary
# explicit so a driver result cannot make the service attempt an oversized
# userspace copy.
val VFS_IPC_REQUEST_PAYLOAD_MAX: u32 = 4096u32
val VFS_IPC_REPLY_PAYLOAD_MAX: u64 = 4092u64
val VFS_IPC_BYTE_ARRAY_HEADER_BYTES: u64 = 16u64
val VFS_READDIR_ENTRY_MAX: u64 = 128u64
val VFS_READDIR_NAME_BYTES_MAX: u64 = 255u64
val VFS_READDIR_TOTAL_NAME_BYTES_MAX: u64 = 3072u64
val IPC_COPIED_SERVICE_TAG: u64 = 0xFFFFFFFFFFFFFFFFu64

fn _vfs_recv_buffer() -> [u8]:
    var bytes: [u8] = []
    var index: u64 = 0u64
    while index < IPC_OWNED_V1_HEADER_BYTES + IPC_OWNED_V1_MAX_PAYLOAD_BYTES:
        bytes.push(0u8)
        index = index + 1u64
    bytes

# Response status codes
val STATUS_OK: i32 = 0
val STATUS_ERR: i32 = -1
val STATUS_NOT_FOUND: i32 = -2
val STATUS_INVALID: i32 = -3
val STATUS_READ_ONLY: i32 = -4

# ============================================================================
# VFS Service
# ============================================================================

class VfsService:
    """VFS IPC service -- listens on its named service port, dispatches to VfsManager.

    The service runs as a cooperative async task within the OS executor.
    Each incoming IPC message is decoded, dispatched to the appropriate
    VfsManager method, and a reply is sent back via IPC.
    """
    vfs: VfsManager
    port_id: u64        # Named "vfs" IPC service port
    running: bool
    executor: OsExecutor
    request_count: u64
    receive_buffer: [u8]
    reply_owned: bool
    accept_legacy_requests: bool

impl VfsService:
    static fn new(vfs: VfsManager) -> VfsService:
        VfsService(
            vfs: vfs,
            port_id: 0,
            running: false,
            executor: OsExecutor.new(),
            request_count: 0,
            receive_buffer: _vfs_recv_buffer(),
            reply_owned: false,
            accept_legacy_requests: true
        )

    static fn with_executor(vfs: VfsManager, executor: OsExecutor) -> VfsService:
        """Create with an externally-provided executor for integration."""
        VfsService(
            vfs: vfs,
            port_id: 0,
            running: false,
            executor: executor,
            request_count: 0,
            receive_buffer: _vfs_recv_buffer(),
            reply_owned: false,
            accept_legacy_requests: true
        )

    me start():
        """Create IPC port and start the yielding service loop."""
        self.init_port()
        self.run_loop()

    me start_catalogue_owned() -> bool:
        """Run the PID1 catalog service with copied IPC requests only."""
        self.accept_legacy_requests = false
        self.init_port()
        if not self.running:
            return false
        self.run_loop()
        true

    me init_port():
        """Create IPC port without entering the blocking loop.

        Call this instead of start() when using cooperative scheduling
        (os_main calls poll_once() in a shared main loop).
        """
        val port = ipc_create_named_port("vfs")
        if port.is_err():
            log_raw_println("[vfs-service] Failed to create IPC port")
            return
        self.port_id = port.unwrap()
        self.running = true
        log_raw_println("[vfs-service] Listening on named IPC port {self.port_id}")

    me run_loop():
        """Poll the copied queue and yield between scheduler turns."""
        while self.running:
            self.poll_once()
            syscall(SYS_YIELD, 0u64, 0u64, 0u64, 0u64, 0u64)

    me poll_once():
        """Process one bounded copied request if available."""
        if not self.running:
            return
        val received = ipc_recv_owned_v1_into(self.port_id, self.receive_buffer)
        if received.is_err():
            return
        self.request_count = self.request_count + 1
        self.dispatch_catalogue_owned_record(self.receive_buffer.ptr() as u64, received.unwrap())

    me dispatch_catalogue_owned_record(msg_addr: u64, record_len: u64):
        """Parse a bounded copied record and dispatch its VFS request.

        The first 32 bytes are the stable v1 header; the payload follows.
        """
        if record_len < IPC_OWNED_V1_HEADER_BYTES or record_len > self.receive_buffer.len().to_u64():
            return
        # Read IpcMessage fields from memory.  The kernel has already removed
        # the method prefix from copied request bytes and placed it in header.
        # IpcMessage layout: src_port(8) | dst_port(8) | method(4) | flags(4) | payload_len(4) | cap_count(4)
        val src_port = _read_u64(msg_addr)
        val method = _read_u32(msg_addr + 16)
        val flags = _read_u32(msg_addr + 20)
        val payload_len = _read_u32(msg_addr + 24)
        val payload_addr = msg_addr + IPC_OWNED_V1_HEADER_BYTES

        if flags != 0u32 and flags != (IpcFlags.Async as u32):
            return
        if flags == 0u32 and not self.accept_legacy_requests:
            return
        self.reply_owned = flags == (IpcFlags.Async as u32)
        if payload_len.to_u64() > record_len - IPC_OWNED_V1_HEADER_BYTES:
            return
        if payload_len > VFS_IPC_REQUEST_PAYLOAD_MAX:
            self.send_error_reply(src_port, STATUS_INVALID, "VFS request exceeds IPC bound")
            return
        if not _vfs_request_payload_is_valid(method, payload_addr, payload_len):
            self.send_error_reply(src_port, STATUS_INVALID, "malformed VFS request")
            return

        match method:
            VFS_OPEN: self.dispatch_open(src_port, payload_addr, payload_len)
            VFS_READ: self.dispatch_read(src_port, payload_addr, payload_len)
            VFS_WRITE: self.dispatch_write(src_port, payload_addr, payload_len)
            VFS_CLOSE: self.dispatch_close(src_port, payload_addr, payload_len)
            VFS_STAT: self.dispatch_stat(src_port, payload_addr, payload_len)
            VFS_READDIR: self.dispatch_readdir(src_port, payload_addr, payload_len)
            VFS_MKDIR: self.dispatch_mkdir(src_port, payload_addr, payload_len)
            VFS_UNLINK: self.dispatch_unlink(src_port, payload_addr, payload_len)
            VFS_RENAME: self.dispatch_rename(src_port, payload_addr, payload_len)
            VFS_MOUNT_LIST: self.dispatch_mount_list(src_port)
            VFS_SEEK: self.dispatch_seek(src_port, payload_addr, payload_len)
            VFS_CHMOD: self.dispatch_chmod(src_port, payload_addr, payload_len)
            VFS_SYMLINK: self.dispatch_symlink(src_port, payload_addr, payload_len)
            VFS_RMDIR: self.dispatch_rmdir(src_port, payload_addr, payload_len)
            _: self.send_error_reply(src_port, STATUS_INVALID, "unknown VFS method")

    # ========================================================================
    # Dispatch Handlers
    # ========================================================================

    me dispatch_open(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse OPEN request: path\0flags_u32."""
        val path = _read_text_until_null(payload_addr, payload_len)
        val flags_offset = path.len().to_u32() + 1
        var flags_raw: u32 = 0
        if flags_offset + 4 <= payload_len:
            flags_raw = _read_u32(payload_addr + flags_offset.to_u64())
        val flags = FileFlags(
            read: (flags_raw & VFS_OPEN_O_ACCMODE) != VFS_OPEN_O_WRONLY,
            write: (flags_raw & VFS_OPEN_O_ACCMODE) != 0u32,
            create: (flags_raw & VFS_OPEN_O_CREAT) != 0u32,
            append: (flags_raw & VFS_OPEN_O_APPEND) != 0u32,
            truncate: (flags_raw & VFS_OPEN_O_TRUNC) != 0u32,
            directory: false
        )
        match self.vfs.open(path, flags):
            Result.Ok(fd):
                self.send_u64_reply(src_port, STATUS_OK, fd.fd.to_u64())
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_NOT_FOUND, e)

    me dispatch_read(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse READ request: fd(u64) | size(u64)."""
        val fd = _read_u64(payload_addr)
        val size = _read_u64(payload_addr + 8)
        # Find the mount for this fd and read
        # For now use the fd's underlying handle directly
        val mount = self.vfs.mounts[0]  # Simplified: use first mount
        match mount.fs.read(fd, size):
            Result.Ok(data):
                self.send_bytes_reply(src_port, STATUS_OK, data)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_ERR, e)

    me dispatch_write(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse WRITE request: fd(u64) | data(bytes)."""
        val fd = _read_u64(payload_addr)
        val data_len = payload_len - 8
        var data: [u8] = []
        var i: u32 = 0
        while i < data_len:
            data.push(_read_u8(payload_addr + 8 + i.to_u64()))
            i = i + 1
        val mount = self.vfs.mounts[0]
        match mount.fs.write(fd, data):
            Result.Ok(written):
                self.send_u64_reply(src_port, STATUS_OK, written)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_ERR, e)

    me dispatch_close(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse CLOSE request: fd(u64)."""
        val fd = _read_u64(payload_addr)
        val mount = self.vfs.mounts[0]
        match mount.fs.close(fd):
            Result.Ok(v):
                self.send_u64_reply(src_port, STATUS_OK, 1)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_ERR, e)

    me dispatch_stat(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse STAT request: path(text)."""
        val path = _read_text(payload_addr, payload_len)
        match self.vfs.stat(path):
            Result.Ok(node):
                # Encode FsNode as: kind(u8) | size(u64) | permissions(u16)
                var reply: [u8] = []
                val kind_val: u8 = match node.kind:
                    FsNodeKind.File: 0
                    FsNodeKind.Directory: 1
                    FsNodeKind.Symlink: 2
                    FsNodeKind.Device: 3
                    FsNodeKind.Pipe: 4
                reply.push(kind_val)
                _push_u64(reply, node.size)
                _push_u16(reply, node.permissions)
                self.send_bytes_reply(src_port, STATUS_OK, reply)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_NOT_FOUND, e)

    me dispatch_readdir(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse READDIR request: path(text)."""
        val path = _read_text(payload_addr, payload_len)
        match self.vfs.readdir(path):
            Result.Ok(entries):
                # Encode as newline-separated "kind:name" entries
                var reply_text = ""
                var i = 0
                while i < entries.len():
                    val entry = entries[i]
                    val kind_val: u8 = match entry.node.kind:
                        FsNodeKind.File: 0
                        FsNodeKind.Directory: 1
                        FsNodeKind.Symlink: 2
                        FsNodeKind.Device: 3
                        FsNodeKind.Pipe: 4
                    if i > 0:
                        reply_text = reply_text + "\n"
                    reply_text = reply_text + "{kind_val}:{entry.name}"
                    i = i + 1
                self.send_text_reply(src_port, STATUS_OK, reply_text)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_NOT_FOUND, e)

    me dispatch_mkdir(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse MKDIR request: path(text)."""
        val path = _read_text(payload_addr, payload_len)
        match self.vfs.mkdir(path):
            Result.Ok(v):
                self.send_u64_reply(src_port, STATUS_OK, 1)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_ERR, e)

    me dispatch_unlink(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse UNLINK request: path(text)."""
        val path = _read_text(payload_addr, payload_len)
        match self.vfs.unlink(path):
            Result.Ok(v):
                self.send_u64_reply(src_port, STATUS_OK, 1)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_ERR, e)

    me dispatch_rmdir(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse RMDIR request: path(text)."""
        val path = _read_text(payload_addr, payload_len)
        match self.vfs.rmdir(path):
            Result.Ok(v):
                self.send_u64_reply(src_port, STATUS_OK, 1)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_ERR, e)

    me dispatch_rename(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse RENAME request: old_path\0new_path."""
        val old_path = _read_text_until_null(payload_addr, payload_len)
        val new_offset = old_path.len().to_u32() + 1
        val remaining = payload_len - new_offset
        val new_path = _read_text(payload_addr + new_offset.to_u64(), remaining)
        match self.vfs.rename(old_path, new_path):
            Result.Ok(v):
                self.send_u64_reply(src_port, STATUS_OK, 1)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_ERR, e)

    me dispatch_chmod(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse CHMOD request: path\0mode(u16)."""
        val path = _read_text_until_null(payload_addr, payload_len)
        val mode_offset = path.len().to_u32() + 1
        var mode: u16 = 0
        if mode_offset + 2 <= payload_len:
            mode = _read_u16(payload_addr + mode_offset.to_u64())
        match self.vfs.chmod(path, mode):
            Result.Ok(v):
                self.send_u64_reply(src_port, STATUS_OK, 1)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_ERR, e)

    me dispatch_symlink(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse SYMLINK request: target\0link_path."""
        val target = _read_text_until_null(payload_addr, payload_len)
        val link_offset = target.len().to_u32() + 1
        val remaining = payload_len - link_offset
        val link_path = _read_text(payload_addr + link_offset.to_u64(), remaining)
        match self.vfs.symlink(target, link_path):
            Result.Ok(v):
                self.send_u64_reply(src_port, STATUS_OK, 1)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_ERR, e)

    me dispatch_readlink(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse READLINK request: path(text)."""
        val path = _read_text(payload_addr, payload_len)
        match self.vfs.readlink(path):
            Result.Ok(target):
                self.send_text_reply(src_port, STATUS_OK, target)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_NOT_FOUND, e)

    me dispatch_mount_list(src_port: u64):
        """Return list of mount points."""
        var reply_text = ""
        var i = 0
        while i < self.vfs.mounts.len():
            val entry = self.vfs.mounts[i]
            if i > 0:
                reply_text = reply_text + "\n"
            reply_text = reply_text + "{entry.point.path} ({entry.point.fs_type} on {entry.point.device})"
            i = i + 1
        self.send_text_reply(src_port, STATUS_OK, reply_text)

    me dispatch_seek(src_port: u64, payload_addr: u64, payload_len: u32):
        """Parse SEEK request: fd(u64) | offset(i64) | whence(u8)."""
        val fd = _read_u64(payload_addr)
        val offset = _read_i64(payload_addr + 8)
        val whence_raw = _read_u8(payload_addr + 16)
        val whence = match whence_raw:
            0: SeekWhence.Set
            1: SeekWhence.Cur
            2: SeekWhence.End
            _: SeekWhence.Set
        val mount = self.vfs.mounts[0]
        match mount.fs.seek(fd, offset, whence):
            Result.Ok(pos):
                self.send_u64_reply(src_port, STATUS_OK, pos)
            Result.Err(e):
                self.send_error_reply(src_port, STATUS_ERR, e)

    # ========================================================================
    # Reply Helpers
    # ========================================================================

    me send_transport_reply(dst_port: u64, data: [u8]):
        """Choose the reply right from the checked request header flags."""
        if self.reply_owned:
            val sent = ipc_reply_owned_v1(dst_port, 0u32, data, self.port_id)
            if sent.is_err():
                log_raw_println("[vfs-service] Owned IPC reply failed")
        else:
            _ipc_send(dst_port, self.port_id, data)

    me send_u64_reply(dst_port: u64, status: i32, value: u64):
        """Send a reply with status + u64 value."""
        var buf: [u8] = []
        _push_i32(buf, status)
        _push_u64(buf, value)
        self.send_transport_reply(dst_port, buf)

    me send_bytes_reply(dst_port: u64, status: i32, data: [u8]):
        """Send a reply with status + raw bytes."""
        if data.len().to_u64() > VFS_IPC_REPLY_PAYLOAD_MAX:
            self.send_error_reply(dst_port, STATUS_INVALID, "VFS reply exceeds IPC bound")
            return
        var buf: [u8] = []
        _push_i32(buf, status)
        var i = 0
        while i < data.len():
            buf.push(data[i])
            i = i + 1
        self.send_transport_reply(dst_port, buf)

    me send_text_reply(dst_port: u64, status: i32, text_val: text):
        """Send a reply with status + text payload."""
        if text_val.len().to_u64() > VFS_IPC_REPLY_PAYLOAD_MAX:
            self.send_error_reply(dst_port, STATUS_INVALID, "VFS reply exceeds IPC bound")
            return
        var buf: [u8] = []
        _push_i32(buf, status)
        for ch in text_val:
            buf.push(ch.to_u8())
        self.send_transport_reply(dst_port, buf)

    me send_error_reply(dst_port: u64, status: i32, msg: text):
        """Send an error reply with status + error message."""
        var buf: [u8] = []
        _push_i32(buf, status)
        var index: u64 = 0u64
        while index < msg.len() and index < VFS_IPC_REPLY_PAYLOAD_MAX:
            buf.push(msg.byte_at(index))
            index = index + 1u64
        self.send_transport_reply(dst_port, buf)

    me stop():
        """Stop the service loop."""
        self.running = false
        log_raw_println("[vfs-service] Stopped after {self.request_count} requests")

    fn stats() -> text:
        """Return service statistics as text."""
        "VfsService: port={self.port_id}, requests={self.request_count}, running={self.running}"

# ============================================================================
# Memory Access Helpers
# ============================================================================
#
# These read raw values from IPC message buffers in memory.
# Uses mmio_read functions since IPC buffers are in kernel-mapped memory.

extern fn mmio_read8(addr: u64) -> u8
extern fn mmio_read16(addr: u64) -> u16
extern fn mmio_read32(addr: u64) -> u32
extern fn mmio_read64(addr: u64) -> u64

fn _read_u8(addr: u64) -> u8:
    mmio_read8(addr)

fn _read_u16(addr: u64) -> u16:
    mmio_read16(addr)

fn _read_u32(addr: u64) -> u32:
    mmio_read32(addr)

fn _read_u64(addr: u64) -> u64:
    mmio_read64(addr)

fn _read_i64(addr: u64) -> i64:
    mmio_read64(addr).to_i64()

fn _vfs_has_nonempty_plain_path(addr: u64, payload_len: u32) -> bool:
    """Accept one nonempty, un-delimited path occupying the whole payload."""
    if payload_len == 0u32:
        return false
    var index: u32 = 0u32
    while index < payload_len:
        if _read_u8(addr + index.to_u64()) == 0u8:
            return false
        index = index + 1u32
    true

fn _vfs_has_exact_path_before_trailer(addr: u64, payload_len: u32, trailer_len: u32) -> bool:
    """Require one nonempty path and its NUL delimiter immediately before a fixed trailer."""
    if payload_len <= trailer_len + 1u32:
        return false
    val nul_offset = payload_len - trailer_len - 1u32
    var index: u32 = 0u32
    while index < nul_offset:
        if _read_u8(addr + index.to_u64()) == 0u8:
            return false
        index = index + 1u32
    _read_u8(addr + nul_offset.to_u64()) == 0u8

fn _vfs_has_exact_two_nonempty_nul_paths(addr: u64, payload_len: u32) -> bool:
    """Require exactly path\\0path, with neither empty segment nor trailing bytes."""
    if payload_len < 3u32:
        return false
    var delimiter_seen = false
    var index: u32 = 0u32
    while index < payload_len:
        val byte = _read_u8(addr + index.to_u64())
        if byte == 0u8:
            if delimiter_seen or index == 0u32 or index + 1u32 == payload_len:
                return false
            delimiter_seen = true
        index = index + 1u32
    delimiter_seen

fn _vfs_request_payload_is_valid(method: u32, addr: u64, payload_len: u32) -> bool:
    """Reject malformed fixed and delimited VFS payloads before dispatch."""
    match method:
        VFS_OPEN: _vfs_has_exact_path_before_trailer(addr, payload_len, 4u32)
        VFS_READ: payload_len == 16u32
        VFS_WRITE: payload_len >= 8u32
        VFS_CLOSE: payload_len == 8u32
        VFS_STAT: _vfs_has_nonempty_plain_path(addr, payload_len)
        VFS_READDIR: _vfs_has_nonempty_plain_path(addr, payload_len)
        VFS_MKDIR: _vfs_has_nonempty_plain_path(addr, payload_len)
        VFS_UNLINK: _vfs_has_nonempty_plain_path(addr, payload_len)
        VFS_RENAME: _vfs_has_exact_two_nonempty_nul_paths(addr, payload_len)
        VFS_MOUNT_LIST: payload_len == 0u32
        VFS_SEEK: payload_len == 17u32
        VFS_CHMOD: _vfs_has_exact_path_before_trailer(addr, payload_len, 2u32)
        VFS_SYMLINK: _vfs_has_exact_two_nonempty_nul_paths(addr, payload_len)
        VFS_RMDIR: _vfs_has_nonempty_plain_path(addr, payload_len)
        VFS_READLINK: _vfs_has_nonempty_plain_path(addr, payload_len)
        VFS_STAT_NO_FOLLOW: _vfs_has_nonempty_plain_path(addr, payload_len)
        _: true

fn _read_text(addr: u64, len: u32) -> text:
    """Read a text string from memory."""
    var result = ""
    var i: u32 = 0
    while i < len:
        val ch = mmio_read8(addr + i.to_u64())
        if ch == 0:
            return result
        result = result + ch.to_char()
        i = i + 1
    result

fn _read_text_until_null(addr: u64, max_len: u32) -> text:
    """Read text from memory until null byte or max_len."""
    var result = ""
    var i: u32 = 0
    while i < max_len:
        val ch = mmio_read8(addr + i.to_u64())
        if ch == 0:
            return result
        result = result + ch.to_char()
        i = i + 1
    result

# ============================================================================
# Serialization Helpers
# ============================================================================

fn _push_u16(buf: [u8], value: u16):
    buf.push((value & 0xFF).to_u8())
    buf.push(((value >> 8) & 0xFF).to_u8())

fn _push_i32(buf: [u8], value: i32):
    val u = value.to_u32()
    buf.push((u & 0xFF).to_u8())
    buf.push(((u >> 8) & 0xFF).to_u8())
    buf.push(((u >> 16) & 0xFF).to_u8())
    buf.push(((u >> 24) & 0xFF).to_u8())

fn _push_u64(buf: [u8], value: u64):
    buf.push((value & 0xFF).to_u8())
    buf.push(((value >> 8) & 0xFF).to_u8())
    buf.push(((value >> 16) & 0xFF).to_u8())
    buf.push(((value >> 24) & 0xFF).to_u8())
    buf.push(((value >> 32) & 0xFF).to_u8())
    buf.push(((value >> 40) & 0xFF).to_u8())
    buf.push(((value >> 48) & 0xFF).to_u8())
    buf.push(((value >> 56) & 0xFF).to_u8())

# ============================================================================
# IPC Send Helper
# ============================================================================

fn _ipc_send(dst_port: u64, src_port: u64, data: [u8]):
    """Send reply data via IPC syscall.

    Encodes the data into a buffer and issues SYS_IPC_SEND = 20
    (kernel dispatcher case 20, _handle_ipc_send).
    """
    # SYS_IPC_SEND = 20: (dst_port, src_port, data_ptr, data_len, TAG).
    # The kernel copies data from the caller's buffer to the receiver's buffer.
    extern fn unsafe_addr_of(ref: any) -> u64
    # `unsafe_addr_of([u8])` addresses the Simple array header.  The copied
    # syscall ABI consumes byte zero, so skip that 16-byte header.
    val data_ptr = unsafe_addr_of(data) + VFS_IPC_BYTE_ARRAY_HEADER_BYTES
    val data_len = data.len().to_u64()
    syscall(SYS_IPC_SEND, dst_port, src_port, data_ptr, data_len, IPC_COPIED_SERVICE_TAG)
