# Virtual Filesystem — Userspace VFS Service
#
# MDSOC: feature dimension, vfs layer
# Provides unified file access across multiple filesystems.
# Runs as a userspace service, receives requests via kernel IPC.
#
# Port contract: VFS receives open/read/write/close/stat/mkdir/readdir
# from applications and routes to the appropriate filesystem driver.

use os.kernel.types.fs_types.{FileDescriptor, FileFlags, MountPoint, FsNode, FsNodeKind, DirEntry}
use os.kernel.fs.vfs_handle_table.{VfsHandleTable, VFS_HANDLE_NO_MOUNT}
use os.ai_cli_js_node_contract.{AiCliManifest, ai_cli_vfs_file_decision}
use os.kernel.loader.container_namespace.{ContainerNamespaceView, container_view_rootless, container_view_create, container_view_allows_path}
use std.nogc_sync_mut.binary_io.{string_to_bytes, bytes_to_string}

# ============================================================================
# VFS Trait — Filesystem Interface
# ============================================================================

trait Filesystem:
    """Interface that all filesystem drivers must implement."""
    fn fs_name() -> text
    fn mount(device: text, options: text) -> Result<bool, text>
    fn unmount() -> Result<bool, text>

    # File operations
    fn open(path: text, flags: FileFlags) -> Result<u64, text>
    fn read(handle: u64, size: u64) -> Result<[u8], text>
    fn write(handle: u64, data: [u8]) -> Result<u64, text>
    fn close(handle: u64) -> Result<bool, text>
    fn seek(handle: u64, offset: i64, whence: SeekWhence) -> Result<u64, text>

    # Metadata
    fn stat(path: text) -> Result<FsNode, text>
    fn chmod(path: text, mode: u16) -> Result<bool, text>

    # Directory operations
    fn mkdir(path: text) -> Result<bool, text>
    fn rmdir(path: text) -> Result<bool, text>
    fn readdir(path: text) -> Result<[DirEntry], text>

    # File management
    fn unlink(path: text) -> Result<bool, text>
    fn rename(old_path: text, new_path: text) -> Result<bool, text>
    fn symlink(target: text, link_path: text) -> Result<bool, text>

enum SeekWhence:
    Set     # From beginning
    Cur     # From current position
    End     # From end

# ============================================================================
# Mount Table
# ============================================================================

val MAX_MOUNTS: i32 = 32

struct VfsMountEntry:
    """Active mount point."""
    point: MountPoint
    fs: Filesystem      # Filesystem driver instance

# ============================================================================
# VFS Manager
# ============================================================================

class VfsManager:
    """Virtual filesystem multiplexer.

    Routes file operations to the correct filesystem based on path prefix.
    Manages mount table and file descriptor table.
    """
    mounts: [VfsMountEntry]
    next_fd: i32
    ai_cli_manifest: AiCliManifest?
    handles: VfsHandleTable
    # Close replays use VfsHandleTable's monotonic issue range.  A handle is
    # never reused, so an issued-but-no-longer-open handle is terminal without
    # retaining one entry per prior close.
    # The container namespace this manager resolves lookups on behalf of.
    # `nil` == HOST context: every lookup behaves exactly as it did before
    # container enforcement existed. Never omit this field at construction —
    # an omitted defaulted field nil-fills to 3 on the JIT, which would read as
    # a live-but-garbage view.
    container_view: ContainerNamespaceView?

impl VfsManager:
    static fn new() -> VfsManager:
        VfsManager(mounts: [], next_fd: 3, ai_cli_manifest: nil, handles: VfsHandleTable.new(), container_view: nil)  # 0=stdin, 1=stdout, 2=stderr

    static fn with_ai_cli_manifest(manifest: AiCliManifest) -> VfsManager:
        VfsManager(mounts: [], next_fd: 3, ai_cli_manifest: manifest, handles: VfsHandleTable.new(), container_view: nil)

    me set_ai_cli_manifest(manifest: AiCliManifest):
        self.ai_cli_manifest = manifest

    me clear_ai_cli_manifest():
        self.ai_cli_manifest = nil

    fn enforce_ai_cli_file_grant(operation: text, path: text) -> Result<bool, text>:
        if not self.ai_cli_manifest.?:
            return Ok(true)
        val manifest = self.ai_cli_manifest
        val decision = ai_cli_vfs_file_decision(manifest, operation, path)
        if decision.allowed:
            return Ok(true)
        Err(decision.reason)

    # === Container namespace enforcement (LIVE lookup path) ===
    #
    # This is the point where the ContainerNamespaceView model stops being
    # documentation: every path-taking VfsManager operation resolves through
    # `enforce_lookup_grants` below, and a manager carrying a container view
    # resolves ONLY what that view allows.
    #
    # NO SECOND ENVELOPE: the decision is delegated wholesale to
    # `container_view_allows_path` in os.kernel.loader.container_namespace —
    # the same primitive the escape suite and the Lean model cover. Nothing
    # about roots, prefixes or ".." is re-implemented here.

    me enter_container_view(view: ContainerNamespaceView):
        """Resolve subsequent lookups inside `view` (the kernel-owned view).

        Pass `ContainerWorld.kernel_view_of(idx)`. A STOPPED or reaped
        container's view is already `container_view_rootless()`, so entering it
        resolves nothing — lifecycle failure is fail-closed by construction.
        """
        self.container_view = view

    me enter_container(root: text, pids: [u64]):
        """Convenience: confine to `root` with the declared `pids`."""
        self.container_view = container_view_create(root, pids)

    me enter_rootless_container():
        """Enter the deny-everything view (what an unpopulated or stopped
        container holds). Every lookup then fails closed."""
        self.container_view = container_view_rootless()

    me leave_container():
        """Return to HOST context — lookups are unrestricted again."""
        self.container_view = nil

    fn in_container() -> bool:
        """True when this manager is resolving on behalf of a container."""
        self.container_view.?

    fn enforce_container_namespace(operation: text, path: text) -> Result<bool, text>:
        """Namespace gate. Host context (no view) is always allowed."""
        if not self.container_view.?:
            return Ok(true)
        val view = self.container_view
        if container_view_allows_path(view, path):
            return Ok(true)
        Err("container namespace denies {operation}: {path}")

    fn enforce_lookup_grants(operation: text, path: text) -> Result<bool, text>:
        """Converged gate every path lookup passes through. DENY WINS:
        the operation proceeds only if EVERY gate allows it."""
        val grant_result = self.enforce_ai_cli_file_grant(operation, path)
        if grant_result.is_err():
            return grant_result
        self.enforce_container_namespace(operation, path)

    me mount(path: text, fs_type: text, device: text, read_only: bool, fs: Filesystem) -> Result<bool, text>:
        """Mount a filesystem at the given path."""
        if self.mounts.len() >= MAX_MOUNTS:
            return Err("too many mount points")

        val result = fs.mount(device, "")
        if result.is_err():
            return result

        val point = MountPoint(
            path: path,
            fs_type: fs_type,
            device: device,
            read_only: read_only
        )
        self.mounts.push(VfsMountEntry(point: point, fs: fs))
        Ok(true)

    me unmount(path: text) -> Result<bool, text>:
        """Unmount filesystem at path."""
        var i = 0
        while i < self.mounts.len():
            if self.mounts[i].point.path == path:
                val result = self.mounts[i].fs.unmount()
                if result.is_ok():
                    # No open handle may outlive its filesystem, and removing a
                    # mount renumbers every mount above it — both are the
                    # handle table's job (converged owner).
                    var table = self.handles
                    table.release_mount(i)
                    table.reindex_after_unmount(i)
                    self.handles = table
                    self.mounts.remove(i)
                return result
            i = i + 1
        Err("mount point not found: {path}")

    fn resolve_mount_index(path: text) -> i32:
        """Index into `self.mounts` of the filesystem responsible for a path.

        Same longest-prefix rule as `resolve_mount`, but returns the index the
        handle table stores so a handle can be routed back to its own mount.
        Returns VFS_HANDLE_NO_MOUNT (-1) when nothing is mounted for the path.
        """
        var best: i32 = VFS_HANDLE_NO_MOUNT
        var best_len: i32 = 0
        var i: i32 = 0
        while i < self.mounts.len():
            val prefix = self.mounts[i].point.path
            if self.path_is_on_mount(path, prefix) and prefix.len() > best_len:
                best = i
                best_len = prefix.len()
            i = i + 1
        best

    fn resolve_mount(path: text) -> VfsMountEntry?:
        """Find the filesystem responsible for a path.

        Longest prefix match: /mnt/usb matches before /mnt.
        """
        var best: VfsMountEntry? = nil
        var best_len: i32 = 0

        for entry in self.mounts:
            val prefix = entry.point.path
            if self.path_is_on_mount(path, prefix) and prefix.len() > best_len:
                best = entry
                best_len = prefix.len()
        best

    fn path_is_on_mount(path: text, mount_path: text) -> bool:
        """True when `path` is the mount root or one of its descendants.

        Prefix matching alone would make `/alpha` own `/alphabet`, then slice
        the latter into a malformed driver-relative path.  A mount boundary is
        a slash (except for the root mount and explicitly slash-terminated
        legacy mount paths).
        """
        if mount_path == "/":
            return path.starts_with("/")
        if path == mount_path:
            return true
        if not path.starts_with(mount_path):
            return false
        if mount_path.ends_with("/"):
            return true
        if path.len() <= mount_path.len():
            return false
        path.slice(mount_path.len(), mount_path.len() + 1) == "/"

    fn strip_mount_prefix(path: text, mount_path: text) -> text:
        """Remove mount prefix from path to get fs-relative path."""
        if mount_path == "/":
            return path
        val relative = path.slice(mount_path.len())
        if relative.len() == 0:
            "/"
        else:
            relative

    # === File Operations ===

    me open(path: text, flags: FileFlags) -> Result<FileDescriptor, text>:
        """Open a file, returning a file descriptor.

        `fd.node` carries the *VFS* handle issued by the handle table, not the
        driver-local handle: driver handle namespaces are per-filesystem and
        both mounts hand out `1` for their first open. Every subsequent
        handle-based operation resolves `fd.node` back to its owning mount.
        """
        val operation = if flags.write or flags.create or flags.append or flags.truncate: "write" else: "read"
        val grant_result = self.enforce_lookup_grants(operation, path)
        if grant_result.is_err():
            return Err(grant_result.unwrap_err())
        val mount_index = self.resolve_mount_index(path)
        if mount_index == VFS_HANDLE_NO_MOUNT:
            return Err("no filesystem mounted for path: {path}")
        val entry = self.mounts[mount_index]
        val relative = self.strip_mount_prefix(path, entry.point.path)
        val result = entry.fs.open(relative, flags)
        if result.is_err():
            return Err(result.unwrap_err())
        val driver_handle = result.unwrap()
        var table = self.handles
        val vfs_handle = table.register(mount_index, entry.point.path, driver_handle)
        self.handles = table
        val fd = FileDescriptor(
            fd: self.next_fd,
            node: vfs_handle,
            offset: 0,
            flags: flags
        )
        self.next_fd = self.next_fd + 1
        Ok(fd)

    fn stat(path: text) -> Result<FsNode, text>:
        """Get file/directory metadata."""
        val grant_result = self.enforce_lookup_grants("stat", path)
        if grant_result.is_err():
            return Err(grant_result.unwrap_err())
        val mount = self.resolve_mount(path)
        if mount.?:
            val entry = mount
            val relative = self.strip_mount_prefix(path, entry.point.path)
            return entry.fs.stat(relative)
        Err("no filesystem mounted for path: {path}")

    fn readdir(path: text) -> Result<[DirEntry], text>:
        """List directory contents."""
        val grant_result = self.enforce_lookup_grants("readdir", path)
        if grant_result.is_err():
            return Err(grant_result.unwrap_err())
        val mount = self.resolve_mount(path)
        if mount.?:
            val entry = mount
            val relative = self.strip_mount_prefix(path, entry.point.path)
            return entry.fs.readdir(relative)
        Err("no filesystem mounted for path: {path}")

    fn mkdir(path: text) -> Result<bool, text>:
        """Create directory."""
        val grant_result = self.enforce_lookup_grants("mkdir", path)
        if grant_result.is_err():
            return Err(grant_result.unwrap_err())
        val mount = self.resolve_mount(path)
        if mount.?:
            val entry = mount
            if entry.point.read_only:
                return Err("filesystem is read-only")
            val relative = self.strip_mount_prefix(path, entry.point.path)
            return entry.fs.mkdir(relative)
        Err("no filesystem mounted for path: {path}")

    fn rmdir(path: text) -> Result<bool, text>:
        """Remove an empty directory."""
        val grant_result = self.enforce_lookup_grants("rmdir", path)
        if grant_result.is_err():
            return Err(grant_result.unwrap_err())
        val mount = self.resolve_mount(path)
        if mount.?:
            val entry = mount
            if entry.point.read_only:
                return Err("filesystem is read-only")
            val relative = self.strip_mount_prefix(path, entry.point.path)
            return entry.fs.rmdir(relative)
        Err("no filesystem mounted for path: {path}")

    fn chmod(path: text, mode: u16) -> Result<bool, text>:
        """Change file permissions on a writable mounted filesystem."""
        val grant_result = self.enforce_lookup_grants("chmod", path)
        if grant_result.is_err():
            return Err(grant_result.unwrap_err())
        val mount = self.resolve_mount(path)
        if mount.?:
            val entry = mount
            if entry.point.read_only:
                return Err("filesystem is read-only")
            val relative = self.strip_mount_prefix(path, entry.point.path)
            return entry.fs.chmod(relative, mode)
        Err("no filesystem mounted for path: {path}")

    # === Write Operations ===

    fn _route(vfs_handle: u64) -> Result<i32, text>:
        """Resolve a VFS handle to the index of the mount that opened it.

        Converged owner of the handle-to-mount association is
        `os.kernel.fs.vfs_handle_table.VfsHandleTable`; the old
        `self.mounts[0]` bypass in read/write/close/seek is deleted.
        """
        val found = self.handles.lookup(vfs_handle)
        if not found.found:
            return Err("unknown VFS handle: {vfs_handle}")
        val idx = found.mount_index
        if idx < 0 or idx >= self.mounts.len():
            return Err("stale VFS handle: mount {found.mount_path} is gone")
        Ok(idx)

    me write(handle: u64, data: [u8]) -> Result<u64, text>:
        """Write data to an open file handle.

        Routes to the mount that issued the handle (handle table), never to
        `mounts[0]`.
        """
        val routed = self._route(handle)
        if routed.is_err():
            return Err(routed.unwrap_err())
        val mount = self.mounts[routed.unwrap()]
        if mount.point.read_only:
            return Err("filesystem is read-only")
        mount.fs.write(self.handles.driver_handle_of(handle), data)

    me unlink(path: text) -> Result<bool, text>:
        """Delete a file."""
        val grant_result = self.enforce_lookup_grants("unlink", path)
        if grant_result.is_err():
            return Err(grant_result.unwrap_err())
        val mount = self.resolve_mount(path)
        if mount.?:
            val entry = mount
            if entry.point.read_only:
                return Err("filesystem is read-only")
            val relative = self.strip_mount_prefix(path, entry.point.path)
            return entry.fs.unlink(relative)
        Err("no filesystem mounted for path: {path}")

    me rename(old_path: text, new_path: text) -> Result<bool, text>:
        """Rename a file or directory."""
        val old_grant = self.enforce_lookup_grants("rename", old_path)
        if old_grant.is_err():
            return Err(old_grant.unwrap_err())
        val new_grant = self.enforce_lookup_grants("rename", new_path)
        if new_grant.is_err():
            return Err(new_grant.unwrap_err())
        val old_mount_index = self.resolve_mount_index(old_path)
        if old_mount_index == VFS_HANDLE_NO_MOUNT:
            return Err("no filesystem mounted for path: {old_path}")
        val new_mount_index = self.resolve_mount_index(new_path)
        if new_mount_index == VFS_HANDLE_NO_MOUNT:
            return Err("no filesystem mounted for path: {new_path}")
        if old_mount_index != new_mount_index:
            return Err("cross-mount rename is not supported")
        val entry = self.mounts[old_mount_index]
        if entry.point.read_only:
            return Err("filesystem is read-only")
        val rel_old = self.strip_mount_prefix(old_path, entry.point.path)
        val rel_new = self.strip_mount_prefix(new_path, entry.point.path)
        entry.fs.rename(rel_old, rel_new)

    me symlink(target: text, link_path: text) -> Result<bool, text>:
        """Create a symbolic link at link_path pointing to target."""
        val target_grant = self.enforce_lookup_grants("symlink", target)
        if target_grant.is_err():
            return Err(target_grant.unwrap_err())
        val link_grant = self.enforce_lookup_grants("symlink", link_path)
        if link_grant.is_err():
            return Err(link_grant.unwrap_err())
        val mount = self.resolve_mount(link_path)
        if mount.?:
            val entry = mount
            if entry.point.read_only:
                return Err("filesystem is read-only")
            val rel_link = self.strip_mount_prefix(link_path, entry.point.path)
            return entry.fs.symlink(target, rel_link)
        Err("no filesystem mounted for path: {link_path}")

    fn _was_issued_handle(handle: u64) -> bool:
        """True for a nonzero VFS handle issued by this never-reusing table.

        This is a bounded close-receipt representation: `next_handle` is the
        sole watermark instead of an unbounded retired-handle list.  Handles
        released by a close or by a successful unmount are terminal; zero and
        future values were never valid and must still fail closed.
        """
        handle != 0u64 and handle < self.handles.next_handle

    me _retire_handle(handle: u64):
        """Make one completed driver-close attempt permanently idempotent."""
        var table = self.handles
        table.release(handle)
        self.handles = table

    me close(handle: u64) -> Result<bool, text>:
        """Close one VFS handle with a stable terminal receipt.

        A driver result, including an error, is a confirmed close attempt and
        retires the VFS handle.  A retry after a lost reply therefore succeeds
        without calling the driver again.  The monotonic issue watermark keeps
        that receipt bounded while zero and future handles still fail.
        """
        val found = self.handles.lookup(handle)
        if not found.found:
            if self._was_issued_handle(handle):
                return Ok(true)
            return Err("unknown VFS handle: {handle}")
        val mount = self.mounts[found.mount_index]
        val result = mount.fs.close(found.driver_handle)
        # Driver execution is the terminal boundary.  Retire before returning
        # either outcome so an observed error cannot be replayed to a driver.
        self._retire_handle(handle)
        result

    me read(handle: u64, size: u64) -> Result<[u8], text>:
        """Read from an open file handle, on the mount that opened it."""
        val routed = self._route(handle)
        if routed.is_err():
            return Err(routed.unwrap_err())
        val mount = self.mounts[routed.unwrap()]
        mount.fs.read(self.handles.driver_handle_of(handle), size)

    me seek(handle: u64, offset: i64, whence: SeekWhence) -> Result<u64, text>:
        """Seek within an open file, on the mount that opened it."""
        val routed = self._route(handle)
        if routed.is_err():
            return Err(routed.unwrap_err())
        val mount = self.mounts[routed.unwrap()]
        mount.fs.seek(self.handles.driver_handle_of(handle), offset, whence)

    # === Handle Table Introspection ===

    fn open_handle_count() -> i32:
        """Number of currently open VFS file descriptions."""
        self.handles.open_count()

    fn handle_mount_path(vfs_handle: u64) -> text:
        """Mount path that issued a VFS handle, or "" when unknown."""
        self.handles.mount_path_of(vfs_handle)

    fn handle_mount_index(vfs_handle: u64) -> i32:
        """Mount index that issued a VFS handle, or -1 when unknown."""
        self.handles.mount_index_of(vfs_handle)

    fn handle_driver_handle(vfs_handle: u64) -> u64:
        """Driver-local handle behind a VFS handle, or 0 when unknown."""
        self.handles.driver_handle_of(vfs_handle)

    # === Path-Based Convenience Methods ===

    me read_text(path: text) -> Result<text, text>:
        """Read entire file contents as text (open → read → close)."""
        val grant_result = self.enforce_lookup_grants("read", path)
        if grant_result.is_err():
            return Err(grant_result.unwrap_err())
        val maybe_entry = self.resolve_mount(path)
        if not maybe_entry.?:
            return Err("no filesystem mounted for path: {path}")
        val entry = maybe_entry
        val relative = self.strip_mount_prefix(path, entry.point.path)
        val stat_result = entry.fs.stat(relative)
        if stat_result.is_err():
            return Err(stat_result.unwrap_err())
        val node = stat_result.unwrap()
        val flags = FileFlags(read: true, write: false, append: false, create: false, truncate: false, directory: false)
        val open_result = entry.fs.open(relative, flags)
        if open_result.is_err():
            return Err(open_result.unwrap_err())
        val handle = open_result.unwrap()
        val read_result = entry.fs.read(handle, node.size)
        entry.fs.close(handle)
        if read_result.is_err():
            return Err(read_result.unwrap_err())
        val bytes = read_result.unwrap()
        Ok(bytes_to_string(bytes))

    me preload_file_pages(path: text, page_size: u64) -> Result<u64, text>:
        """Warm the filesystem/block cache for a file by reading page-sized chunks.

        This is the SimpleOS counterpart to host mmap preload: it preserves the
        same path-level contract without requiring the VFS layer to know a
        filesystem's sector layout. Filesystems backed by BlockCache naturally
        warm their cache through normal reads.
        """
        if page_size == 0:
            return Err("page_size must be greater than zero")
        val grant_result = self.enforce_lookup_grants("preload", path)
        if grant_result.is_err():
            return Err(grant_result.unwrap_err())
        val maybe_entry = self.resolve_mount(path)
        if not maybe_entry.?:
            return Err("no filesystem mounted for path: {path}")
        val entry = maybe_entry
        val relative = self.strip_mount_prefix(path, entry.point.path)
        val stat_result = entry.fs.stat(relative)
        if stat_result.is_err():
            return Err(stat_result.unwrap_err())
        val node = stat_result.unwrap()
        if node.kind != FsNodeKind.File:
            return Err("preload target is not a file: {path}")
        if node.size == 0:
            return Ok(0)

        val flags = FileFlags(read: true, write: false, append: false, create: false, truncate: false, directory: false)
        val open_result = entry.fs.open(relative, flags)
        if open_result.is_err():
            return Err(open_result.unwrap_err())
        val handle = open_result.unwrap()

        var remaining = node.size
        var pages: u64 = 0
        while remaining > 0:
            var chunk = page_size
            if remaining < chunk:
                chunk = remaining
            val read_result = entry.fs.read(handle, chunk)
            if read_result.is_err():
                entry.fs.close(handle)
                return Err(read_result.unwrap_err())
            val data = read_result.unwrap()
            if data.len() == 0:
                entry.fs.close(handle)
                return Err("short preload read")
            pages = pages + 1
            val got = data.len().to_u64()
            if got >= remaining:
                remaining = 0
            else:
                remaining = remaining - got
        entry.fs.close(handle)
        Ok(pages)

    me write_text(path: text, content: text) -> Result<bool, text>:
        """Write text to a file (open → write → close)."""
        val grant_result = self.enforce_lookup_grants("write", path)
        if grant_result.is_err():
            return Err(grant_result.unwrap_err())
        val maybe_entry = self.resolve_mount(path)
        if not maybe_entry.?:
            return Err("no filesystem mounted for path: {path}")
        val entry = maybe_entry
        if entry.point.read_only:
            return Err("filesystem is read-only")
        val relative = self.strip_mount_prefix(path, entry.point.path)
        val flags = FileFlags(read: false, write: true, append: false, create: true, truncate: true, directory: false)
        val open_result = entry.fs.open(relative, flags)
        if open_result.is_err():
            return Err(open_result.unwrap_err())
        val handle = open_result.unwrap()
        val data = string_to_bytes(content)
        val write_result = entry.fs.write(handle, data)
        entry.fs.close(handle)
        if write_result.is_err():
            return Err(write_result.unwrap_err())
        Ok(true)

    me remove(path: text) -> Result<bool, text>:
        """Remove a file (alias for unlink)."""
        self.unlink(path)

# ============================================================================
# Module-Level Convenience Functions
# ============================================================================

fn vfs_mount(manager: VfsManager, path: text, fs: Filesystem) -> Result<bool, text>:
    """Mount a filesystem at the given path with default options.

    Convenience wrapper around VfsManager.mount() that uses sensible
    defaults: fs_type from the filesystem, empty device string, read-write.
    """
    val fs_type = fs.fs_name()
    manager.mount(path, fs_type, "", false, fs)
