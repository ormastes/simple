"""SOSIX POSIX-compatibility interface constants, v1.

Single owner for the SOSIX syscall-id allocation, the utsname layout, and the
OS identity strings. The full number-to-POSIX-name map lives in
doc/05_design/os/sosix_posix_interface_v1.md; every constant here must stay
in parity with that table and with src/os/kernel/ipc/syscall.spl dispatch.

Id allocation rule: new ids come only from the reserved holes documented in
the interface table (17, 52-56, 88-89, 93-94, 105, 108-109, 117-119, 132-133,
136+). Guest-libc usage (0, 4, 10-12, 30-36, 39, 43-48, 50, 60, 69) is frozen
by the lane-C1 aarch64 guest toolchain.
"""

# === SOSIX syscall ids (this slice) ===

pub val SOSIX_SYS_UNAME: u64 = 92
export SOSIX_SYS_UNAME

# === utsname layout (parity: src/os/libc/include/sys/utsname.h) ===

pub val SOSIX_UTSNAME_FIELD_LEN: u64 = 65
pub val SOSIX_UTSNAME_FIELD_COUNT: u64 = 5
# 65 * 5, spelled out: val initializers in this codebase are literals.
pub val SOSIX_UTSNAME_BUF_LEN: u64 = 325
export SOSIX_UTSNAME_FIELD_LEN, SOSIX_UTSNAME_FIELD_COUNT, SOSIX_UTSNAME_BUF_LEN

# === OS identity (roadmap point 3: sysname MUST be 'SimpleOS') ===

pub val SOSIX_UTSNAME_SYSNAME: text = "SimpleOS"
pub val SOSIX_UTSNAME_NODENAME: text = "simpleos"
pub val SOSIX_INTERFACE_VERSION: text = "sosix-1"
export SOSIX_UTSNAME_SYSNAME, SOSIX_UTSNAME_NODENAME, SOSIX_INTERFACE_VERSION

# release/version fields are sourced from os.packages.os_packages.os_version()
# at fill time (see uname_v1.spl); they are not duplicated here.

# === utsname field offsets within the 325-byte buffer ===

pub val SOSIX_UTSNAME_SYSNAME_OFF: u64 = 0
pub val SOSIX_UTSNAME_NODENAME_OFF: u64 = 65
pub val SOSIX_UTSNAME_RELEASE_OFF: u64 = 130
pub val SOSIX_UTSNAME_VERSION_OFF: u64 = 195
pub val SOSIX_UTSNAME_MACHINE_OFF: u64 = 260
export SOSIX_UTSNAME_SYSNAME_OFF, SOSIX_UTSNAME_NODENAME_OFF
export SOSIX_UTSNAME_RELEASE_OFF, SOSIX_UTSNAME_VERSION_OFF
export SOSIX_UTSNAME_MACHINE_OFF

# machine follows the lane arch. The SOSIX program is aarch64-only, so this
# is unconditional; when a second arch lane consumes the interface, split it
# with the syscall.spl @cfg idiom. NOTE: @cfg(not(...)) is rejected by the
# deployed parser (probe: /tmp/cfgprobe/probe_b.spl), so an else-arm in that
# style is not available today.
val SOSIX_UTSNAME_MACHINE: text = "aarch64"

export SOSIX_UTSNAME_MACHINE
