"""Architecture-neutral input injection for the SimpleOS 2D WM host."""

use nogc_async_mut.wm.host.{WmHostEventPoll, wm_host_no_event}

class SimpleOsWmInputAdapter:
    name: text
    poll_fn: fn() -> WmHostEventPoll

fn _no_input_poll() -> WmHostEventPoll:
    # The ABI carries an inert payload, but `ok: false` prevents its delivery.
    wm_host_no_event("input-unavailable")

pub fn simpleos_wm_no_input_adapter() -> SimpleOsWmInputAdapter:
    SimpleOsWmInputAdapter(name: "none", poll_fn: _no_input_poll)

pub fn simpleos_wm_input_adapter(name: text, poll_fn: fn() -> WmHostEventPoll) -> SimpleOsWmInputAdapter:
    SimpleOsWmInputAdapter(name: name, poll_fn: poll_fn)

impl SimpleOsWmInputAdapter:
    fn backing_kind() -> text: self.name
    fn poll() -> WmHostEventPoll: self.poll_fn()
