# WmAction, WindowOwner, ECS component types, and WmWorld
#
# MDSOC: feature dimension, wm layer
# Extracted from wm_service.spl to keep file sizes under 800 lines.

use os.kernel.log.klog_api.{log_raw_println}
use std.ecs.entity.{Entity}
use std.ecs.world.{WorldBase}

# Maximum windows the WM will track
val WM_MAX_WINDOWS: i32 = 256

# Window state constants
val WIN_STATE_NORMAL: i32 = 0
val WIN_STATE_MINIMIZED: i32 = 1
val WIN_STATE_MAXIMIZED: i32 = 2

use os.services.wm.wm_action.{WmAction, wm_action_none}

# ============================================================================
# Window Owner Entry — maps window_id to the owning app's reply port
# and records launch/process metadata for shell queries.
# ============================================================================

struct WindowOwner:
    """Tracks which IPC port owns a given window."""
    window_id: u64
    owner_port: u64
    process_id: u64
    app_id: text

# ============================================================================
# ECS component types
# ============================================================================

struct WinId:
    """ECS component: the u64 window identifier."""
    value: u64

struct OwnerPort:
    """ECS component: the IPC reply port of the owning app."""
    value: u64

struct OwnerProcess:
    """ECS component: the process (PID) that owns this window."""
    value: u64

struct WinAppId:
    """ECS component: the stable app-group identifier string."""
    value: text

struct Title:
    """ECS component: the window title string."""
    value: text

struct Geometry:
    """ECS component: the window rectangle."""
    x: i32
    y: i32
    w: i32
    h: i32

struct WindowState:
    """ECS component: current window state (normal/minimized/maximized)."""
    value: i32

# ============================================================================
# WmWorld — seed-safe container for window manager state
# ============================================================================

class WmWorld:
    """Window world backed by index-aligned primitive arrays.

    The arrays retain spare slots after despawn. `row_count` is the live prefix,
    so a later spawn reuses that storage without struct-in-array round-trips.
    """
    base: WorldBase
    entity_ids: [i32]
    entity_generations: [i32]
    window_ids: [u64]
    owner_ports: [u64]
    process_ids: [u64]
    app_ids: [text]
    titles: [text]
    geometry_xs: [i32]
    geometry_ys: [i32]
    geometry_ws: [i32]
    geometry_hs: [i32]
    states: [i32]
    ticks: [i64]
    row_count: i32

impl WmWorld:
    static fn new() -> WmWorld:
        WmWorld(
            # The desktop E2E lane materializes several launcher-backed windows
            # in quick succession. Preallocate entity ids up front so the WM
            # does not have to grow its allocator during that hot path.
            base: WorldBase.with_capacity(WM_MAX_WINDOWS),
            entity_ids: [],
            entity_generations: [],
            window_ids: [],
            owner_ports: [],
            process_ids: [],
            app_ids: [],
            titles: [],
            geometry_xs: [],
            geometry_ys: [],
            geometry_ws: [],
            geometry_hs: [],
            states: [],
            ticks: [],
            row_count: 0
        )

    fn _row_index_for_window(self, window_id: u64) -> i32:
        var i: i32 = 0
        while i < self.row_count:
            if self.window_ids[i] == window_id:
                return i
            i = i + 1
        -1

    fn len() -> i32:
        self.row_count

    fn find_owner_port(self, window_id: u64) -> u64:
        """Find owner port for a window_id. Returns 0 if not found."""
        val index = self._row_index_for_window(window_id)
        if index < 0:
            return 0
        self.owner_ports[index]

    fn find_entity_for_window(self, window_id: u64) -> Entity:
        """Find the Entity for a window_id. Returns Entity.null() if not found."""
        val index = self._row_index_for_window(window_id)
        if index < 0:
            return Entity.null()
        Entity(
            id: self.entity_ids[index],
            generation: self.entity_generations[index]
        )

    me spawn_window(window_id: u64, owner_port: u64, process_id: u64, app_id: text):
        """Spawn a new entity and insert one complete window row."""
        log_raw_println("[wm-service] spawn-window:start wid={window_id} pid={process_id} app_id={app_id}")
        val e = self.base.spawn()
        val index = self.row_count
        if index < (self.window_ids.len() as i32):
            self.entity_ids[index] = e.id
            self.entity_generations[index] = e.generation
            self.window_ids[index] = window_id
            self.owner_ports[index] = owner_port
            self.process_ids[index] = process_id
            self.app_ids[index] = app_id
            self.titles[index] = ""
            self.geometry_xs[index] = 0
            self.geometry_ys[index] = 0
            self.geometry_ws[index] = 0
            self.geometry_hs[index] = 0
            self.states[index] = WIN_STATE_NORMAL
            self.ticks[index] = 0
        else:
            self.entity_ids.push(e.id)
            self.entity_generations.push(e.generation)
            self.window_ids.push(window_id)
            self.owner_ports.push(owner_port)
            self.process_ids.push(process_id)
            self.app_ids.push(app_id)
            self.titles.push("")
            self.geometry_xs.push(0)
            self.geometry_ys.push(0)
            self.geometry_ws.push(0)
            self.geometry_hs.push(0)
            self.states.push(WIN_STATE_NORMAL)
            self.ticks.push(0)
        self.row_count = index + 1
        log_raw_println("[wm-service] spawn-window:win-id wid={window_id}")
        log_raw_println("[wm-service] spawn-window:owner-port wid={window_id}")
        log_raw_println("[wm-service] spawn-window:owner-process wid={window_id}")
        log_raw_println("[wm-service] spawn-window:app-id wid={window_id}")
        log_raw_println("[wm-service] spawn-window:title wid={window_id}")
        log_raw_println("[wm-service] spawn-window:geometry wid={window_id}")
        log_raw_println("[wm-service] spawn-window:end wid={window_id}")

    me despawn_window(window_id: u64) -> bool:
        """Despawn the entity for window_id. Returns false if not found."""
        val index = self._row_index_for_window(window_id)
        if index < 0:
            return false
        val e = Entity(
            id: self.entity_ids[index],
            generation: self.entity_generations[index]
        )
        val last = self.row_count - 1
        if index != last:
            self.entity_ids[index] = self.entity_ids[last]
            self.entity_generations[index] = self.entity_generations[last]
            self.window_ids[index] = self.window_ids[last]
            self.owner_ports[index] = self.owner_ports[last]
            self.process_ids[index] = self.process_ids[last]
            self.app_ids[index] = self.app_ids[last]
            self.titles[index] = self.titles[last]
            self.geometry_xs[index] = self.geometry_xs[last]
            self.geometry_ys[index] = self.geometry_ys[last]
            self.geometry_ws[index] = self.geometry_ws[last]
            self.geometry_hs[index] = self.geometry_hs[last]
            self.states[index] = self.states[last]
            self.ticks[index] = self.ticks[last]
        self.row_count = last
        self.base.despawn(e)
        true

    me despawn_windows_for_port(port: u64) -> [u64]:
        """Despawn all windows owned by port, returning their window_ids."""
        var to_destroy: [u64] = []
        var i: i32 = 0
        while i < self.row_count:
            if self.owner_ports[i] == port:
                to_destroy = to_destroy.push(self.window_ids[i])
            i = i + 1
        var j: i32 = 0
        while j < to_destroy.len():
            self.despawn_window(to_destroy[j])
            j = j + 1
        to_destroy

    fn window_ids_for_port(self, port: u64) -> [u64]:
        var ids: [u64] = []
        var i: i32 = 0
        while i < self.row_count:
            if self.owner_ports[i] == port:
                ids = ids.push(self.window_ids[i])
            i = i + 1
        ids

    fn window_ids_for_process(self, process_id: u64) -> [u64]:
        var ids: [u64] = []
        var i: i32 = 0
        while i < self.row_count:
            if self.process_ids[i] == process_id:
                ids = ids.push(self.window_ids[i])
            i = i + 1
        ids

    fn window_ids_for_app(self, app_id: text) -> [u64]:
        var ids: [u64] = []
        var i: i32 = 0
        while i < self.row_count:
            if self.app_ids[i] == app_id:
                ids = ids.push(self.window_ids[i])
            i = i + 1
        ids

    fn process_id_for_window(self, window_id: u64) -> u64:
        val index = self._row_index_for_window(window_id)
        if index < 0:
            return 0
        self.process_ids[index]

    fn app_id_for_window(self, window_id: u64) -> text:
        val index = self._row_index_for_window(window_id)
        if index < 0:
            return ""
        self.app_ids[index]

    fn count_for_port(self, port: u64) -> i32:
        var count: i32 = 0
        var i: i32 = 0
        while i < self.row_count:
            if self.owner_ports[i] == port:
                count = count + 1
            i = i + 1
        count

    fn count_for_process(self, process_id: u64) -> i32:
        var count: i32 = 0
        var i: i32 = 0
        while i < self.row_count:
            if self.process_ids[i] == process_id:
                count = count + 1
            i = i + 1
        count

    fn count_for_app(self, app_id: text) -> i32:
        var count: i32 = 0
        var i: i32 = 0
        while i < self.row_count:
            if self.app_ids[i] == app_id:
                count = count + 1
            i = i + 1
        count

    me set_identity(window_id: u64, process_id: u64, app_id: text):
        """Update process/app identity for an existing window."""
        val index = self._row_index_for_window(window_id)
        if index < 0:
            return
        self.process_ids[index] = process_id
        self.app_ids[index] = app_id
        self.ticks[index] = 0

    fn geometry_for_window(self, window_id: u64) -> Geometry:
        val index = self._row_index_for_window(window_id)
        if index < 0:
            return Geometry(x: 0, y: 0, w: 0, h: 0)
        Geometry(
            x: self.geometry_xs[index],
            y: self.geometry_ys[index],
            w: self.geometry_ws[index],
            h: self.geometry_hs[index]
        )

    me resize_window(window_id: u64, width: i32, height: i32, tick: i64) -> bool:
        val index = self._row_index_for_window(window_id)
        if index < 0:
            return false
        self.geometry_ws[index] = width
        self.geometry_hs[index] = height
        self.ticks[index] = tick
        true

    me touch_title(window_id: u64, tick: i64) -> bool:
        val index = self._row_index_for_window(window_id)
        if index < 0:
            return false
        self.ticks[index] = tick
        true

    me set_state(window_id: u64, state: i32, tick: i64) -> bool:
        val index = self._row_index_for_window(window_id)
        if index < 0:
            return false
        self.states[index] = state
        self.ticks[index] = tick
        true
