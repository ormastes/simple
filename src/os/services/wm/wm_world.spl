# WmAction, WindowOwner, ECS component types, and WmWorld
#
# MDSOC: feature dimension, wm layer
# Extracted from wm_service.spl to keep file sizes under 800 lines.

use os.kernel.log.klog_api.{log_raw_println}

# Maximum windows the WM will track
val WM_MAX_WINDOWS: i32 = 256

# Window state constants
val WIN_STATE_NORMAL: i32 = 0
val WIN_STATE_MINIMIZED: i32 = 1
val WIN_STATE_MAXIMIZED: i32 = 2

use os.services.wm.wm_action.{WmAction, wm_action_none}

# ============================================================================
# Window Owner Entry — maps window_id to the owning app's reply port
# and records launch/process metadata for shell queries.
# ============================================================================

struct WindowOwner:
    """Tracks which IPC port owns a given window."""
    window_id: u64
    owner_port: u64
    process_id: u64
    app_id: text

# ============================================================================
# ECS component types
# ============================================================================

struct WinId:
    """ECS component: the u64 window identifier."""
    value: u64

struct OwnerPort:
    """ECS component: the IPC reply port of the owning app."""
    value: u64

struct OwnerProcess:
    """ECS component: the process (PID) that owns this window."""
    value: u64

struct WinAppId:
    """ECS component: the stable app-group identifier string."""
    value: text

struct Title:
    """ECS component: the window title string."""
    value: text

struct Geometry:
    """ECS component: the window rectangle."""
    x: i32
    y: i32
    w: i32
    h: i32

struct WindowState:
    """ECS component: current window state (normal/minimized/maximized)."""
    value: i32

# ============================================================================
# WmWorld — ECS container for window manager state
# ============================================================================

class WmWorld:
    """Bounded structure-of-arrays world for window manager state."""
    win_ids: [u64]
    owner_ports: [u64]
    owner_processes: [u64]
    app_ids: [text]
    titles: [text]
    geometries: [Geometry]
    states: [i32]

impl WmWorld:
    static fn new() -> WmWorld:
        WmWorld(
            win_ids: [],
            owner_ports: [],
            owner_processes: [],
            app_ids: [],
            titles: [],
            geometries: [],
            states: []
        )

    fn find_window_index(self, window_id: u64) -> i32:
        var i: i32 = 0
        while i < self.win_ids.len():
            if self.win_ids[i] == window_id:
                return i
            i = i + 1
        -1

    fn find_owner_port(self, window_id: u64) -> u64:
        """Find owner port for a window_id. Returns 0 if not found."""
        val index = self.find_window_index(window_id)
        if index < 0:
            return 0
        self.owner_ports[index]

    me spawn_window(window_id: u64, owner_port: u64, process_id: u64, app_id: text):
        """Spawn a new entity and insert all window components."""
        log_raw_println("[wm-service] spawn-window:start wid={window_id} pid={process_id} app_id={app_id}")
        if self.win_ids.len() >= WM_MAX_WINDOWS:
            log_raw_println("[wm-service] spawn-window:capacity wid={window_id}")
            return
        self.win_ids.push(window_id)
        self.owner_ports.push(owner_port)
        self.owner_processes.push(process_id)
        self.app_ids.push(app_id)
        self.titles.push("")
        self.geometries.push(Geometry(x: 0, y: 0, w: 0, h: 0))
        self.states.push(WIN_STATE_NORMAL)
        log_raw_println("[wm-service] spawn-window:end wid={window_id}")

    me despawn_window(window_id: u64) -> bool:
        """Despawn the entity for window_id. Returns false if not found."""
        val index = self.find_window_index(window_id)
        if index < 0:
            return false
        self.win_ids.remove_at(index)
        self.owner_ports.remove_at(index)
        self.owner_processes.remove_at(index)
        self.app_ids.remove_at(index)
        self.titles.remove_at(index)
        self.geometries.remove_at(index)
        self.states.remove_at(index)
        true

    me despawn_windows_for_port(port: u64) -> [u64]:
        """Despawn all windows owned by port, returning their window_ids."""
        var to_destroy: [u64] = []
        var i: i32 = 0
        while i < self.owner_ports.len():
            if self.owner_ports[i] == port:
                to_destroy.push(self.win_ids[i])
            i = i + 1
        var j: i32 = 0
        while j < to_destroy.len():
            self.despawn_window(to_destroy[j])
            j = j + 1
        to_destroy

    fn window_ids_for_port(self, port: u64) -> [u64]:
        var ids: [u64] = []
        var i: i32 = 0
        while i < self.owner_ports.len():
            if self.owner_ports[i] == port:
                ids.push(self.win_ids[i])
            i = i + 1
        ids

    fn window_ids_for_process(self, process_id: u64) -> [u64]:
        var ids: [u64] = []
        var i: i32 = 0
        while i < self.owner_processes.len():
            if self.owner_processes[i] == process_id:
                ids.push(self.win_ids[i])
            i = i + 1
        ids

    fn window_ids_for_app(self, app_id: text) -> [u64]:
        var ids: [u64] = []
        var i: i32 = 0
        while i < self.app_ids.len():
            if self.app_ids[i] == app_id:
                ids.push(self.win_ids[i])
            i = i + 1
        ids

    fn process_id_for_window(self, window_id: u64) -> u64:
        val index = self.find_window_index(window_id)
        if index < 0:
            return 0
        self.owner_processes[index]

    fn app_id_for_window(self, window_id: u64) -> text:
        val index = self.find_window_index(window_id)
        if index < 0:
            return ""
        self.app_ids[index]

    fn count_for_port(self, port: u64) -> i32:
        var count: i32 = 0
        var i: i32 = 0
        while i < self.owner_ports.len():
            if self.owner_ports[i] == port:
                count = count + 1
            i = i + 1
        count

    fn count_for_process(self, process_id: u64) -> i32:
        var count: i32 = 0
        var i: i32 = 0
        while i < self.owner_processes.len():
            if self.owner_processes[i] == process_id:
                count = count + 1
            i = i + 1
        count

    fn count_for_app(self, app_id: text) -> i32:
        var count: i32 = 0
        var i: i32 = 0
        while i < self.app_ids.len():
            if self.app_ids[i] == app_id:
                count = count + 1
            i = i + 1
        count

    me set_identity(window_id: u64, process_id: u64, app_id: text):
        """Update process/app identity for an existing window."""
        val index = self.find_window_index(window_id)
        if index < 0:
            return
        self.owner_processes[index] = process_id
        self.app_ids[index] = app_id
