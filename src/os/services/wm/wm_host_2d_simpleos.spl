"""SimpleOS backing for the WM host seam.

WHAT THIS IS
  The `WmHost2d` implementation for SimpleOS, defined in the tier that owns the
  real SimpleOS WM path (`src/os/services/wm/`). The seam itself lives in
  `src/lib/nogc_async_mut/wm/host.spl` and stays free of any OS dependency;
  this file is the direction the dependency is allowed to run (os -> lib).

  It exists to discharge the seam's portability contract on the one platform
  this repo can actually boot and observe:

      if Simple 2D (surface + event delivery) runs on SimpleOS,
      then the WM runs on SimpleOS.

  `wm_host_2d_frame` — the portable WM frame step, with no platform branch in
  it — runs unmodified over this implementation.

WHAT BACKS IT (both halves are real hardware, neither is bookkeeping)
  surface  — `os.drivers.framebuffer.fb_driver.FramebufferDriver`, the same
             driver `src/os/compositor/fb_backend.spl` renders through. In MMIO
             mode (`from_scanout_raw`, `front_addr != 0`) `put_pixel`/
             `fill_rect` write the hardware linear framebuffer, and
             `read_pixel` reads it back through `mmio_read32`. The readback is
             what makes a present verifiable rather than merely un-errored.
  events   — the PS/2 controller, read directly off ports 0x64/0x60. A key
             release, a mouse packet, and an empty controller are three
             distinguishable outcomes, so an empty queue cannot be confused
             with a working one.

HONESTY RULE (host.spl's, applied here without softening)
  A capability is backed by a real implementation or it reports FALSE. Naming a
  struct after a platform backs nothing. So:

  * `wm_host_2d_simpleos` refuses to claim a surface it does not have. With
    `front_addr == 0` there is no hardware scanout, and every seam call returns
    `ok: false` with `simpleos:no-scanout`. There is no in-memory fallback that
    would let this class report a green frame off a real machine — that is the
    exact artifact shape host.spl was rewritten to remove.
  * `surface_present` returns `ok: true` only after reading the pixels back out
    of the framebuffer and finding the value it just wrote. A write that does
    not land reports `present-readback-mismatch`, not success.
  * `backing_kind()` names what is actually under the object, and is `"none"`
    whenever the object cannot draw.

  There is deliberately no clock here. An earlier SimpleOS host carried a
  `now_micros` frozen at 0, so its own health check passed on `0 >= 0`. The
  seam has four methods and this file implements exactly those four.

WHY PS/2 AND NOT CLIENT IPC
  `wm_service.spl` speaks to client apps over kernel IPC
  (`SYS_IPC_CREATE_PORT`/`SYS_IPC_RECV`). That is a real SimpleOS facility, but
  host.spl already records why it is not in the seam: an inbound client request
  is expressible as an event, its *reply* is not, so folding IPC in would make
  a kernel port a second precondition and break the contract. The seam needs an
  event source; on SimpleOS the hardware event source is the PS/2 controller,
  which is available before any IPC port exists. Client IPC continues to be
  driven by `wm_service.spl`, unchanged and beside this file.
"""

use nogc_async_mut.wm.host.{WmHost2d, WmHostSurface, WmHostStatus, WmHostEventPoll}
use std.common.window_protocol.window_protocol.{WmInputEvent}
use std.common.window_protocol.geometry.{WindowId, Point, KeyCode, Modifiers}
use os.drivers.framebuffer.fb_driver.{FramebufferDriver, Color as FbColor}

extern fn rt_port_inb(port: u64) -> u64
extern fn rt_port_outb(port: u16, value: u8)

# ---------------------------------------------------------------------------
# PS/2 controller — the real event source
# ---------------------------------------------------------------------------

fn _ps2_status_port() -> u64:
    0x64

fn _ps2_data_port() -> u64:
    0x60

fn _ps2_output_full() -> u64:
    0x01

fn _ps2_has_byte() -> bool:
    (rt_port_inb(_ps2_status_port()) & _ps2_output_full()) != 0

fn _ps2_wait_write():
    var i: u64 = 0
    while i < 100000:
        if (rt_port_inb(_ps2_status_port()) & 2) == 0:
            return
        i = i + 1

fn _ps2_wait_read():
    var i: u64 = 0
    while i < 100000:
        if _ps2_has_byte():
            return
        i = i + 1

fn _ps2_flush():
    var i: u64 = 0
    while i < 32:
        if _ps2_has_byte():
            rt_port_inb(_ps2_data_port())
        i = i + 1

fn ps2_event_source_init() -> bool:
    """Re-enable the i8042 keyboard port after firmware handoff.

    UEFI leaves the first PS/2 port disabled (controller command 0xAD) when it
    exits boot services, so a poll straight out of firmware reads an empty
    controller forever. This re-enables the port (0xAE), clears the
    disable-first-port bit in the controller config, and tells the keyboard to
    resume scanning (0xF4). It is SimpleOS-specific setup for the event
    source, deliberately NOT a fifth seam method — the seam still has four.

    Returns whether the keyboard acknowledged (0xFA) the enable-scanning
    command, so a controller that is not actually there reports false instead
    of leaving the caller to assume it worked.
    """
    _ps2_flush()
    _ps2_wait_write()
    rt_port_outb(0x64, 0xAE)
    _ps2_wait_write()
    rt_port_outb(0x64, 0x20)
    _ps2_wait_read()
    val config = rt_port_inb(_ps2_data_port())
    _ps2_wait_write()
    rt_port_outb(0x64, 0x60)
    _ps2_wait_write()
    rt_port_outb(0x60, (config & 0xEF).to_u8())
    _ps2_flush()
    _ps2_wait_write()
    rt_port_outb(0x60, 0xF4)
    _ps2_wait_read()
    val ack = rt_port_inb(_ps2_data_port())
    _ps2_flush()
    ack == 0xFA

# ---------------------------------------------------------------------------
# The SimpleOS host
# ---------------------------------------------------------------------------

class WmHost2dSimpleOs:
    """`WmHost2d` over a real SimpleOS hardware scanout and the PS/2 controller.

    `fb` is the shared framebuffer driver. When its `front_addr` is 0 there is
    no hardware surface and every method refuses; see the honesty rule above.
    """
    fb: FramebufferDriver
    surface_ctr: u64
    live_surface: u64
    present_count: i64
    verified_pixel: u32
    probe_argb: u32

pub fn wm_host_2d_simpleos(fb: FramebufferDriver) -> WmHost2dSimpleOs:
    """Bind the seam to a framebuffer driver. Refuses later if it has no scanout."""
    WmHost2dSimpleOs(
        fb: fb,
        surface_ctr: 0,
        live_surface: 0,
        present_count: 0,
        verified_pixel: 0,
        probe_argb: 0xFF2D7DD2
    )

impl WmHost2dSimpleOs:
    fn backing_kind() -> text:
        """What is actually under this object. `"none"` when it cannot draw."""
        if self.fb.front_addr == 0:
            return "none"
        if self.fb.width == 0:
            return "none"
        if self.fb.height == 0:
            return "none"
        "mmio-scanout"

    fn is_backed() -> bool:
        self.backing_kind() != "none"

    fn scanout_address() -> u64:
        self.fb.front_addr

    fn last_verified_pixel() -> u32:
        """ARGB actually read back out of the framebuffer by the last present."""
        self.verified_pixel

    fn presents() -> i64:
        self.present_count

fn _no_scanout() -> text:
    "simpleos:no-scanout"

impl WmHost2d for WmHost2dSimpleOs:

    me surface_acquire(width: u32, height: u32) -> WmHostSurface:
        if not self.is_backed():
            return WmHostSurface(ok: false, state: _no_scanout(), id: 0, width: 0, height: 0)
        if width == 0:
            return WmHostSurface(ok: false, state: "invalid-size", id: 0, width: 0, height: 0)
        if height == 0:
            return WmHostSurface(ok: false, state: "invalid-size", id: 0, width: 0, height: 0)
        self.surface_ctr = self.surface_ctr + (1 as u64)
        self.live_surface = self.surface_ctr
        var w = width
        if w > self.fb.width:
            w = self.fb.width
        var h = height
        if h > self.fb.height:
            h = self.fb.height
        WmHostSurface(ok: true, state: "acquired", id: self.live_surface, width: w, height: h)

    me surface_present(surface_id: u64, byte_len: i64) -> WmHostStatus:
        """Write the frame into the hardware framebuffer and read it back.

        `ok: true` means pixels were observed in the framebuffer after the
        write, not merely that no call returned an error.
        """
        if not self.is_backed():
            return WmHostStatus(ok: false, state: _no_scanout())
        if surface_id == 0:
            return WmHostStatus(ok: false, state: "unknown-surface")
        if surface_id != self.live_surface:
            return WmHostStatus(ok: false, state: "unknown-surface")
        if byte_len <= 0:
            return WmHostStatus(ok: false, state: "empty-frame")

        # A frame is 4 bytes per pixel; never write past the acquired surface.
        var pixels = byte_len / 4
        val capacity = (self.fb.width.to_i64()) * (self.fb.height.to_i64())
        if pixels > capacity:
            pixels = capacity
        if pixels <= 0:
            return WmHostStatus(ok: false, state: "empty-frame")

        val fill = framebuffer_argb_to_color_local(self.probe_argb)
        var rows = pixels / self.fb.width.to_i64()
        if rows <= 0:
            rows = 1
        if rows > self.fb.height.to_i64():
            rows = self.fb.height.to_i64()
        self.fb.fill_rect(0, 0, self.fb.width, rows.to_u32(), fill)

        # Readback is the proof. Sample the first pixel and one interior pixel
        # so a single stuck word cannot fake a full-surface write.
        val first = self.fb.read_pixel(0, 0)
        var mid_y = (rows / 2).to_u32()
        if mid_y >= self.fb.height:
            mid_y = 0
        var mid_x = self.fb.width / 2
        if mid_x >= self.fb.width:
            mid_x = 0
        val mid = self.fb.read_pixel(mid_x, mid_y)
        self.verified_pixel = first

        if first != self.probe_argb:
            return WmHostStatus(ok: false, state: "present-readback-mismatch")
        if mid != self.probe_argb:
            return WmHostStatus(ok: false, state: "present-readback-partial")
        self.present_count = self.present_count + 1
        WmHostStatus(ok: true, state: "presented")

    me surface_release(surface_id: u64) -> WmHostStatus:
        if not self.is_backed():
            return WmHostStatus(ok: false, state: _no_scanout())
        if surface_id == 0:
            return WmHostStatus(ok: false, state: "unknown-surface")
        if surface_id != self.live_surface:
            return WmHostStatus(ok: false, state: "unknown-surface")
        self.live_surface = 0
        WmHostStatus(ok: true, state: "released")

    me event_poll() -> WmHostEventPoll:
        """One PS/2 byte, translated into the canonical `WmInputEvent`.

        Returns `ok: false` with `queue-empty` when the controller has no byte
        pending — a real, observable hardware condition, not a placeholder.
        """
        if not self.is_backed():
            return WmHostEventPoll(
                ok: false,
                state: _no_scanout(),
                event: WmInputEvent.mouse_move(WindowId(value: 0u64), Point.xy(0, 0))
            )
        if not _ps2_has_byte():
            return WmHostEventPoll(
                ok: false,
                state: "queue-empty",
                event: WmInputEvent.mouse_move(WindowId(value: 0u64), Point.xy(0, 0))
            )
        val scancode = rt_port_inb(_ps2_data_port())
        val released = (scancode & 0x80) != 0
        val code = (scancode & 0x7F).to_u32()
        if released:
            return WmHostEventPoll(
                ok: true,
                state: "key-up",
                event: WmInputEvent.mouse_up(
                    WindowId(value: 0u64),
                    Point.xy(code.to_i32(), 0),
                    Modifiers.none()
                )
            )
        WmHostEventPoll(
            ok: true,
            state: "key-down",
            event: WmInputEvent.key_down(
                WindowId(value: 0u64),
                KeyCode(code: code, name: "ps2"),
                Modifiers.none()
            )
        )

fn framebuffer_argb_to_color_local(argb: u32) -> FbColor:
    FbColor(
        r: ((argb >> 16) & 0xFF).to_u8(),
        g: ((argb >> 8) & 0xFF).to_u8(),
        b: (argb & 0xFF).to_u8(),
        a: ((argb >> 24) & 0xFF).to_u8()
    )
