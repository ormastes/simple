# Managed Device Grant Policy — Driver Supervisor
#
# This is the broker-side authority boundary for supervised userspace drivers.
# It deliberately carries no physical BAR address, virtual address, or IOVA:
# the broker authorizes an exact PCI function, BAR index, bounded DMA window,
# and IOMMU domain.  The trusted capability minting path consumes the returned
# CapabilityKind values to install concrete CSpace tokens for the driver.

use os.kernel.types.capability_types.{CapabilityKind}

val MAX_PCI_BAR_INDEX: u8 = 5
val MAX_PCI_DEVICE_NUMBER: u8 = 31
val MAX_PCI_FUNCTION_NUMBER: u8 = 7

struct ManagedDeviceGrantRequest:
    owner_task: u64
    bdf_bus: u8
    bdf_device: u8
    bdf_func: u8
    bar_index: u8
    dma_max_bytes: u64
    iommu_domain_id: u32

struct ManagedDeviceGrant:
    owner_task: u64
    bdf_bus: u8
    bdf_device: u8
    bdf_func: u8
    bar_index: u8
    dma_max_bytes: u64
    iommu_domain_id: u32
    generation: u64
    active: bool

fn managed_device_grant_request(owner_task: u64,
                                bdf_bus: u8,
                                bdf_device: u8,
                                bdf_func: u8,
                                bar_index: u8,
                                dma_max_bytes: u64,
                                iommu_domain_id: u32) -> ManagedDeviceGrantRequest:
    """Build an exact managed-driver request; validation occurs at issue time."""
    ManagedDeviceGrantRequest(
        owner_task: owner_task,
        bdf_bus: bdf_bus,
        bdf_device: bdf_device,
        bdf_func: bdf_func,
        bar_index: bar_index,
        dma_max_bytes: dma_max_bytes,
        iommu_domain_id: iommu_domain_id
    )

fn managed_device_request_is_valid(request: ManagedDeviceGrantRequest) -> bool:
    """Validate all identifiers required for a fail-closed managed grant."""
    request.owner_task != 0u64 and
        request.bdf_device <= MAX_PCI_DEVICE_NUMBER and
        request.bdf_func <= MAX_PCI_FUNCTION_NUMBER and
        request.bar_index <= MAX_PCI_BAR_INDEX and
        request.dma_max_bytes != 0u64 and
        request.iommu_domain_id != 0u32

fn _managed_device_grant_authority_kinds(grant: ManagedDeviceGrant) -> [CapabilityKind]:
    """Build exact object authorities for a broker-confirmed active grant.

    This is intentionally the sole public conversion to kernel capability
    kinds.  It cannot produce Mmio or ambient hardware authority.
    """
    if not grant.active:
        return []
    [
        CapabilityKind.DeviceGrant(
            bdf_bus: grant.bdf_bus,
            bdf_device: grant.bdf_device,
            bdf_func: grant.bdf_func
        ),
        CapabilityKind.DeviceBarMap(
            bdf_bus: grant.bdf_bus,
            bdf_device: grant.bdf_device,
            bdf_func: grant.bdf_func,
            bar_index: grant.bar_index
        ),
        CapabilityKind.DeviceDma(
            bdf_bus: grant.bdf_bus,
            bdf_device: grant.bdf_device,
            bdf_func: grant.bdf_func,
            max_bytes: grant.dma_max_bytes
        ),
        CapabilityKind.IommuDomain(domain_id: grant.iommu_domain_id)
    ]

fn managed_device_grant_matches(grant: ManagedDeviceGrant,
                                owner_task: u64,
                                bdf_bus: u8,
                                bdf_device: u8,
                                bdf_func: u8) -> bool:
    """Check exact owner and PCI function identity before broker reuse."""
    grant.active and
        grant.owner_task == owner_task and
        grant.bdf_bus == bdf_bus and
        grant.bdf_device == bdf_device and
        grant.bdf_func == bdf_func

class ManagedDeviceGrantBroker:
    """Bounded, exact authority ledger for supervised driver instances."""
    next_generation: u64
    g0: ManagedDeviceGrant
    g1: ManagedDeviceGrant
    g2: ManagedDeviceGrant
    g3: ManagedDeviceGrant

    me issue(request: ManagedDeviceGrantRequest) -> Result<ManagedDeviceGrant, text>:
        """Issue a fresh exact grant or fail without exposing device addresses."""
        if not managed_device_request_is_valid(request):
            return Err("invalid managed device authority request")
        if self._bdf_is_active(request.bdf_bus, request.bdf_device, request.bdf_func):
            return Err("PCI function already assigned")
        if self.next_generation == 0u64:
            return Err("managed device generation exhausted")

        val grant = ManagedDeviceGrant(
            owner_task: request.owner_task,
            bdf_bus: request.bdf_bus,
            bdf_device: request.bdf_device,
            bdf_func: request.bdf_func,
            bar_index: request.bar_index,
            dma_max_bytes: request.dma_max_bytes,
            iommu_domain_id: request.iommu_domain_id,
            generation: self.next_generation,
            active: true
        )
        self.next_generation = self.next_generation + 1u64
        if not self.g0.active:
            self.g0 = grant
            return Ok(grant)
        if not self.g1.active:
            self.g1 = grant
            return Ok(grant)
        if not self.g2.active:
            self.g2 = grant
            return Ok(grant)
        if not self.g3.active:
            self.g3 = grant
            return Ok(grant)
        Err("managed device broker full")

    me revoke_owner(owner_task: u64) -> u64:
        """Revoke every grant for a dead driver before a replacement is spawned."""
        var revoked = 0u64
        if self.g0.active and self.g0.owner_task == owner_task:
            self.g0.active = false
            revoked = revoked + 1u64
        if self.g1.active and self.g1.owner_task == owner_task:
            self.g1.active = false
            revoked = revoked + 1u64
        if self.g2.active and self.g2.owner_task == owner_task:
            self.g2.active = false
            revoked = revoked + 1u64
        if self.g3.active and self.g3.owner_task == owner_task:
            self.g3.active = false
            revoked = revoked + 1u64
        revoked

    me active_for_owner(owner_task: u64) -> [ManagedDeviceGrant]:
        """Return the active, non-address-bearing grants for one driver."""
        var grants: [ManagedDeviceGrant] = []
        if self.g0.active and self.g0.owner_task == owner_task:
            grants.push(self.g0)
        if self.g1.active and self.g1.owner_task == owner_task:
            grants.push(self.g1)
        if self.g2.active and self.g2.owner_task == owner_task:
            grants.push(self.g2)
        if self.g3.active and self.g3.owner_task == owner_task:
            grants.push(self.g3)
        grants

    me authority_kinds_for(grant: ManagedDeviceGrant) -> [CapabilityKind]:
        """Resolve current authority; stale or revoked grant values deny all.

        A caller may retain a value copy of a prior grant.  This method checks
        the broker ledger and generation before capability minting so an old
        value cannot reacquire authority after driver restart or revocation.
        """
        # Mint from the canonical ledger record, never from the caller's value
        # copy.  That makes a copied/forged record unable to alter the exact
        # BAR, DMA ceiling, IOMMU domain, or active bit selected by policy.
        if self._grant_matches(self.g0, grant):
            return _managed_device_grant_authority_kinds(self.g0)
        if self._grant_matches(self.g1, grant):
            return _managed_device_grant_authority_kinds(self.g1)
        if self._grant_matches(self.g2, grant):
            return _managed_device_grant_authority_kinds(self.g2)
        if self._grant_matches(self.g3, grant):
            return _managed_device_grant_authority_kinds(self.g3)
        []

    me _bdf_is_active(bus: u8, device: u8, func: u8) -> bool:
        (self.g0.active and self.g0.bdf_bus == bus and self.g0.bdf_device == device and self.g0.bdf_func == func) or
        (self.g1.active and self.g1.bdf_bus == bus and self.g1.bdf_device == device and self.g1.bdf_func == func) or
        (self.g2.active and self.g2.bdf_bus == bus and self.g2.bdf_device == device and self.g2.bdf_func == func) or
        (self.g3.active and self.g3.bdf_bus == bus and self.g3.bdf_device == device and self.g3.bdf_func == func)

    me _grant_matches(current: ManagedDeviceGrant, candidate: ManagedDeviceGrant) -> bool:
        current.active and
        current.generation == candidate.generation and
        current.owner_task == candidate.owner_task and
        current.bdf_bus == candidate.bdf_bus and
        current.bdf_device == candidate.bdf_device and
        current.bdf_func == candidate.bdf_func and
        current.bar_index == candidate.bar_index and
        current.dma_max_bytes == candidate.dma_max_bytes and
        current.iommu_domain_id == candidate.iommu_domain_id

impl ManagedDeviceGrantBroker:
    static fn create() -> ManagedDeviceGrantBroker:
        """Create a deny-all broker with no active device authority."""
        val empty = ManagedDeviceGrant(
            owner_task: 0,
            bdf_bus: 0,
            bdf_device: 0,
            bdf_func: 0,
            bar_index: 0,
            dma_max_bytes: 0,
            iommu_domain_id: 0,
            generation: 0,
            active: false
        )
        ManagedDeviceGrantBroker(
            next_generation: 1,
            g0: empty,
            g1: empty,
            g2: empty,
            g3: empty
        )
