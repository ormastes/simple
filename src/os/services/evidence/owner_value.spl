# Pure value helpers for evidence-owner boundary checks.

fn simpleos_evidence_bounded_identity(value: text, maximum: i64) -> bool:
    if value.len() == 0 or value.len() > maximum or value.contains("|"):
        return false
    var i: i64 = 0
    while i < value.len():
        val code = value.char_code_at(i)
        if code < 33 or code > 126:
            return false
        i = i + 1
    true

fn simpleos_evidence_bytes_copy(value: [u8]) -> [u8]:
    var copied: [u8] = []
    for byte in value:
        copied = copied.push(byte)
    copied

fn simpleos_evidence_bytes_equal(a: [u8], b: [u8]) -> bool:
    if a.len() != b.len():
        return false
    var difference: u8 = 0u8
    var i: i64 = 0
    while i < a.len():
        difference = difference | (a[i] ^ b[i])
        i = i + 1
    difference == 0u8

export simpleos_evidence_bounded_identity
export simpleos_evidence_bytes_copy
export simpleos_evidence_bytes_equal
