# Pure model for mutex-owner completion. A failed unlock never authorizes the
# result and never claims rollback of a mutation that may already be visible.

struct SimpleOsEvidenceOwnerUnlockOutcomeV1:
    authoritative: bool
    quarantined: bool
    mutation_retained: bool
    reason: text

fn simpleos_evidence_owner_unlock_outcome(
    mutation_applied: bool,
    unlock_ok: bool,
    quarantined_before: bool
) -> SimpleOsEvidenceOwnerUnlockOutcomeV1:
    if quarantined_before or not unlock_ok:
        return SimpleOsEvidenceOwnerUnlockOutcomeV1(
            authoritative: false,
            quarantined: true,
            mutation_retained: mutation_applied,
            reason: "serialization-indeterminate")
    SimpleOsEvidenceOwnerUnlockOutcomeV1(
        authoritative: true,
        quarantined: false,
        mutation_retained: mutation_applied,
        reason: "")

export SimpleOsEvidenceOwnerUnlockOutcomeV1
export simpleos_evidence_owner_unlock_outcome
