# Strict Ed25519 signature hex decoding for the evidence-service boundary.

fn _simpleos_evidence_hex_nibble(value: text) -> i64:
    if value == "0": return 0
    if value == "1": return 1
    if value == "2": return 2
    if value == "3": return 3
    if value == "4": return 4
    if value == "5": return 5
    if value == "6": return 6
    if value == "7": return 7
    if value == "8": return 8
    if value == "9": return 9
    if value == "a" or value == "A": return 10
    if value == "b" or value == "B": return 11
    if value == "c" or value == "C": return 12
    if value == "d" or value == "D": return 13
    if value == "e" or value == "E": return 14
    if value == "f" or value == "F": return 15
    -1

fn simpleos_evidence_signature_hex_decode(value: text) -> [u8]:
    if value.len() != 128:
        return []
    var result: [u8] = []
    var i: i64 = 0
    while i < value.len():
        val high = _simpleos_evidence_hex_nibble(value.substring(i, i + 1))
        val low = _simpleos_evidence_hex_nibble(value.substring(i + 1, i + 2))
        if high < 0 or low < 0:
            return []
        result = result.push((high * 16 + low).to_u8())
        i = i + 2
    result

fn simpleos_evidence_public_key_hex_decode(value: text) -> [u8]:
    if value.len() != 64:
        return []
    var result: [u8] = []
    var i: i64 = 0
    while i < value.len():
        val high = _simpleos_evidence_hex_nibble(value.substring(i, i + 1))
        val low = _simpleos_evidence_hex_nibble(value.substring(i + 1, i + 2))
        if high < 0 or low < 0:
            return []
        result = result.push((high * 16 + low).to_u8())
        i = i + 2
    result

export simpleos_evidence_signature_hex_decode
export simpleos_evidence_public_key_hex_decode
