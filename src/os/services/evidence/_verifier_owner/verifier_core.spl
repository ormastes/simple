use std.common.structural.receipt.simpleos_evidence_receipt_v1_codec.{
    encode_simpleos_evidence_receipt_v1_signing_bytes
}
use std.common.structural.parallel_commit.simpleos_ledger_commit_v1.{
    SimpleOsCapabilityStatus,
    SimpleOsCapabilityLedgerV1,
    SimpleOsCapabilityLedgerCandidateV1,
    SimpleOsCapabilityLedgerCheckV1,
    SimpleOsCapabilityLedgerCommitResultV1,
    SimpleOsCapabilityLedgerFailure,
    simpleos_capability_ledger_v1,
    simpleos_capability_ledger_check_v1,
    simpleos_capability_row_key
}
use os.services.evidence.capability_ledger.{
    simpleos_capability_candidate_validate
}
use os.services.evidence.artifact_snapshot.{
    SimpleOsEvidenceArtifactSnapshotV1,
    simpleos_evidence_artifact_snapshot_check
}
use os.services.evidence.ledger_transition.{
    SimpleOsEvidenceLedgerSnapshotV1,
    simpleos_evidence_prepare_ledger_transition
}
use os.services.evidence.admission_gates.*
use os.services.evidence.signature_codec.{simpleos_evidence_signature_hex_decode}
use os.services.evidence.owner_value.{
    simpleos_evidence_bounded_identity,
    simpleos_evidence_bytes_copy,
    simpleos_evidence_bytes_equal
}
use os.services.evidence.owner_serialization_transition.{
    simpleos_evidence_owner_unlock_outcome
}
use std.common.crypto.ed25519.{pure_ed25519_verify}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}

val SIMPLEOS_EVIDENCE_MAX_TRUSTED_SIGNERS: i64 = 16
val SIMPLEOS_EVIDENCE_MAX_LIVE_CHALLENGES: i64 = 128
val SIMPLEOS_EVIDENCE_MAX_LIVE_HANDLES: i64 = 128
val SIMPLEOS_EVIDENCE_MAX_SEEN_NONCES: i64 = 4096
val SIMPLEOS_EVIDENCE_MAX_ADMITTED_ROWS: i64 = 4096
val SIMPLEOS_EVIDENCE_MAX_CHALLENGE_TTL_US: i64 = 300000000
val SIMPLEOS_EVIDENCE_MAX_ID_BYTES: i64 = 128
val SIMPLEOS_EVIDENCE_MAX_CONSUMER_BYTES: i64 = 128
val _SIMPLEOS_EVIDENCE_MAX_TIME: i64 = 9223372036854775807
val _SIMPLEOS_EVIDENCE_MAX_GENERATION: u64 = 18446744073709551615u64
val _SIMPLEOS_EVIDENCE_OWNER_MUTEX: i64 = mutex_raw_create()

struct SimpleOsTrustedEvidenceSignerV1:
    key_id: text
    public_key: [u8]

struct SimpleOsEvidenceChallengeV1:
    session_id: u64
    nonce: text
    generation: u64
    expires_unix_us: i64

struct SimpleOsVerifiedEvidenceHandleV1:
    handle_id: text
    receipt_id: text
    receipt_nonce: text
    row_key: text
    consumer: text
    generation: u64
    expires_unix_us: i64

struct SimpleOsEvidenceChallengeResultV1:
    ok: bool
    reason: text
    challenge: SimpleOsEvidenceChallengeV1

struct SimpleOsEvidenceVerificationResultV1:
    ok: bool
    reason: text
    handle: SimpleOsVerifiedEvidenceHandleV1

struct _SimpleOsEvidenceChallengeEntryV1:
    active: bool
    nonce: text
    generation: u64
    issued_unix_us: i64
    expires_unix_us: i64

struct _SimpleOsEvidenceHandleEntryV1:
    active: bool
    handle_id: text
    receipt_id: text
    receipt_nonce: text
    row_key: text
    consumer: text
    signature: text
    signing_bytes_hash: text
    generation: u64
    expires_unix_us: i64

struct _SimpleOsEvidenceAdmittedRowV1:
    row_key: text
    expires_unix_us: i64

var _simpleos_evidence_initialized: bool = false
var _simpleos_evidence_quarantined: bool = false
var _simpleos_evidence_trusted_key_ids: [text] = []
var _simpleos_evidence_trusted_public_keys: [[u8]] = []
var _simpleos_evidence_seen_nonces: [text] = []
var _simpleos_evidence_challenges: [_SimpleOsEvidenceChallengeEntryV1] = []
var _simpleos_evidence_handles: [_SimpleOsEvidenceHandleEntryV1] = []
var _simpleos_evidence_admitted_rows: [_SimpleOsEvidenceAdmittedRowV1] = []
var _simpleos_evidence_next_generation: u64 = 1u64
var _simpleos_evidence_ledger: SimpleOsCapabilityLedgerV1 =
    simpleos_capability_ledger_v1()

fn _simpleos_evidence_zero_challenge() -> SimpleOsEvidenceChallengeV1:
    SimpleOsEvidenceChallengeV1(
        session_id: 0u64, nonce: "", generation: 0u64,
        expires_unix_us: 0)

fn _simpleos_evidence_zero_handle() -> SimpleOsVerifiedEvidenceHandleV1:
    SimpleOsVerifiedEvidenceHandleV1(
        handle_id: "", receipt_id: "", receipt_nonce: "", row_key: "",
        consumer: "", generation: 0u64, expires_unix_us: 0)

fn _simpleos_evidence_challenge_failure(
    reason: text) -> SimpleOsEvidenceChallengeResultV1:
    SimpleOsEvidenceChallengeResultV1(
        ok: false, reason: reason,
        challenge: _simpleos_evidence_zero_challenge())

fn _simpleos_evidence_verification_failure(
    reason: text) -> SimpleOsEvidenceVerificationResultV1:
    SimpleOsEvidenceVerificationResultV1(
        ok: false, reason: reason, handle: _simpleos_evidence_zero_handle())

fn _simpleos_evidence_check_failure(reason: text)
        -> SimpleOsCapabilityLedgerCheckV1:
    SimpleOsCapabilityLedgerCheckV1(ok: false, reason: reason)

fn _simpleos_evidence_unlock_owner() -> bool:
    val outcome = simpleos_evidence_owner_unlock_outcome(
        false,
        mutex_raw_unlock(_SIMPLEOS_EVIDENCE_OWNER_MUTEX),
        _simpleos_evidence_quarantined)
    _simpleos_evidence_quarantined = outcome.quarantined
    outcome.authoritative

fn _simpleos_evidence_finish_check(value: SimpleOsCapabilityLedgerCheckV1)
        -> SimpleOsCapabilityLedgerCheckV1:
    if _simpleos_evidence_unlock_owner(): return value
    _simpleos_evidence_check_failure("serialization-indeterminate")

fn _simpleos_evidence_finish_bool(value: bool) -> bool:
    if _simpleos_evidence_unlock_owner(): return value
    false

fn _simpleos_evidence_finish_challenge(value: SimpleOsEvidenceChallengeResultV1)
        -> SimpleOsEvidenceChallengeResultV1:
    if _simpleos_evidence_unlock_owner(): return value
    _simpleos_evidence_challenge_failure("serialization-indeterminate")

fn _simpleos_evidence_finish_verification(
    value: SimpleOsEvidenceVerificationResultV1
) -> SimpleOsEvidenceVerificationResultV1:
    if _simpleos_evidence_unlock_owner(): return value
    _simpleos_evidence_verification_failure("serialization-indeterminate")

fn _simpleos_evidence_finish_snapshot(value: SimpleOsEvidenceLedgerSnapshotV1)
        -> SimpleOsEvidenceLedgerSnapshotV1:
    if _simpleos_evidence_unlock_owner(): return value
    SimpleOsEvidenceLedgerSnapshotV1(
        ok: false, reason: "serialization-indeterminate",
        ledger: simpleos_capability_ledger_v1())

fn _simpleos_evidence_finish_commit(value: SimpleOsCapabilityLedgerCommitResultV1)
        -> SimpleOsCapabilityLedgerCommitResultV1:
    if _simpleos_evidence_unlock_owner(): return value
    SimpleOsCapabilityLedgerCommitResultV1(
        ok: false, ledger: simpleos_capability_ledger_v1(), ordered_keys: [],
        failure: SimpleOsCapabilityLedgerFailure.AdmissionRequired,
        reason: "serialization-indeterminate")

fn _simpleos_evidence_roots_valid(
    roots: [SimpleOsTrustedEvidenceSignerV1]) -> bool:
    if roots.len() == 0 or roots.len() > SIMPLEOS_EVIDENCE_MAX_TRUSTED_SIGNERS:
        return false
    var i: i64 = 0
    while i < roots.len():
        if not simpleos_evidence_bounded_identity(
            roots[i].key_id, SIMPLEOS_EVIDENCE_MAX_ID_BYTES):
            return false
        if roots[i].public_key.len() != 32:
            return false
        var prior: i64 = 0
        while prior < i:
            if roots[prior].key_id == roots[i].key_id:
                return false
            prior = prior + 1
        i = i + 1
    true

fn _simpleos_evidence_roots_match_locked(
    roots: [SimpleOsTrustedEvidenceSignerV1]) -> bool:
    if roots.len() != _simpleos_evidence_trusted_key_ids.len():
        return false
    var i: i64 = 0
    while i < roots.len():
        if roots[i].key_id != _simpleos_evidence_trusted_key_ids[i]:
            return false
        if not simpleos_evidence_bytes_equal(
            roots[i].public_key, _simpleos_evidence_trusted_public_keys[i]):
            return false
        i = i + 1
    true

fn _simpleos_evidence_nonce_seen_locked(nonce: text) -> bool:
    for seen in _simpleos_evidence_seen_nonces:
        if seen == nonce:
            return true
    false

fn _simpleos_evidence_expire_locked(now_unix_us: i64):
    var i: i64 = 0
    while i < _simpleos_evidence_challenges.len():
        if _simpleos_evidence_challenges[i].active
            and _simpleos_evidence_challenges[i].expires_unix_us < now_unix_us:
            var expired = _simpleos_evidence_challenges[i]
            expired.active = false
            _simpleos_evidence_challenges[i] = expired
        i = i + 1
    i = 0
    while i < _simpleos_evidence_handles.len():
        if _simpleos_evidence_handles[i].active
            and _simpleos_evidence_handles[i].expires_unix_us < now_unix_us:
            var expired = _simpleos_evidence_handles[i]
            expired.active = false
            _simpleos_evidence_handles[i] = expired
        i = i + 1

fn _simpleos_evidence_free_challenge_slot_locked() -> i64:
    var i: i64 = 0
    while i < _simpleos_evidence_challenges.len():
        if not _simpleos_evidence_challenges[i].active:
            return i
        i = i + 1
    if _simpleos_evidence_challenges.len() <
        SIMPLEOS_EVIDENCE_MAX_LIVE_CHALLENGES:
        return _simpleos_evidence_challenges.len()
    -1

fn _simpleos_evidence_free_handle_slot_locked() -> i64:
    var i: i64 = 0
    while i < _simpleos_evidence_handles.len():
        if not _simpleos_evidence_handles[i].active:
            return i
        i = i + 1
    if _simpleos_evidence_handles.len() < SIMPLEOS_EVIDENCE_MAX_LIVE_HANDLES:
        return _simpleos_evidence_handles.len()
    -1

fn _simpleos_evidence_challenge_index_locked(
    challenge: SimpleOsEvidenceChallengeV1) -> i64:
    if challenge.session_id == 0u64:
        return -1
    val slot = challenge.session_id.to_i64() - 1
    if slot < 0 or slot >= _simpleos_evidence_challenges.len():
        return -1
    val entry = _simpleos_evidence_challenges[slot]
    if entry.generation != challenge.generation or entry.nonce != challenge.nonce
        or entry.expires_unix_us != challenge.expires_unix_us:
        return -1
    slot

fn _simpleos_evidence_signer_index_locked(key_id: text) -> i64:
    var i: i64 = 0
    while i < _simpleos_evidence_trusted_key_ids.len():
        if _simpleos_evidence_trusted_key_ids[i] == key_id:
            return i
        i = i + 1
    -1

fn _simpleos_evidence_handle_index_locked(
    handle: SimpleOsVerifiedEvidenceHandleV1) -> i64:
    var i: i64 = 0
    while i < _simpleos_evidence_handles.len():
        val entry = _simpleos_evidence_handles[i]
        if entry.handle_id == handle.handle_id
            and entry.generation == handle.generation:
            return i
        i = i + 1
    -1

fn _simpleos_evidence_admitted_row_index_locked(row_key: text) -> i64:
    var i: i64 = 0
    while i < _simpleos_evidence_admitted_rows.len():
        if _simpleos_evidence_admitted_rows[i].row_key == row_key:
            return i
        i = i + 1
    -1

fn _simpleos_evidence_owner_state_valid_locked() -> bool:
    if _simpleos_evidence_trusted_key_ids.len() >
        SIMPLEOS_EVIDENCE_MAX_TRUSTED_SIGNERS:
        return false
    if _simpleos_evidence_trusted_key_ids.len() !=
        _simpleos_evidence_trusted_public_keys.len():
        return false
    if _simpleos_evidence_seen_nonces.len() > SIMPLEOS_EVIDENCE_MAX_SEEN_NONCES:
        return false
    if _simpleos_evidence_challenges.len() >
        SIMPLEOS_EVIDENCE_MAX_LIVE_CHALLENGES:
        return false
    if _simpleos_evidence_handles.len() > SIMPLEOS_EVIDENCE_MAX_LIVE_HANDLES:
        return false
    if _simpleos_evidence_admitted_rows.len() >
        SIMPLEOS_EVIDENCE_MAX_ADMITTED_ROWS:
        return false
    if not simpleos_capability_ledger_check_v1(_simpleos_evidence_ledger).ok:
        return false
    _simpleos_evidence_next_generation > 0u64

fn simpleos_evidence_trust_roots_check(
    roots: [SimpleOsTrustedEvidenceSignerV1]) -> SimpleOsCapabilityLedgerCheckV1:
    if not _simpleos_evidence_roots_valid(roots):
        return _simpleos_evidence_check_failure("trust-root-configuration")
    SimpleOsCapabilityLedgerCheckV1(ok: true, reason: "")

fn simpleos_evidence_verifier_start(
    roots: [SimpleOsTrustedEvidenceSignerV1]) -> SimpleOsCapabilityLedgerCheckV1:
    val roots_check = simpleos_evidence_trust_roots_check(roots)
    if not roots_check.ok:
        return roots_check
    if _simpleos_evidence_quarantined:
        return _simpleos_evidence_check_failure("serialization-indeterminate")
    if not mutex_raw_lock(_SIMPLEOS_EVIDENCE_OWNER_MUTEX):
        return _simpleos_evidence_check_failure("evidence-owner-lock-unavailable")
    if _simpleos_evidence_initialized:
        if not _simpleos_evidence_owner_state_valid_locked():
            return _simpleos_evidence_finish_check(
                _simpleos_evidence_check_failure("evidence-owner-state"))
        val same = _simpleos_evidence_roots_match_locked(roots)
        if same:
            return _simpleos_evidence_finish_check(
                SimpleOsCapabilityLedgerCheckV1(ok: true, reason: ""))
        return _simpleos_evidence_finish_check(
            _simpleos_evidence_check_failure("trust-root-already-initialized"))
    var key_ids: [text] = []
    var public_keys: [[u8]] = []
    for root in roots:
        key_ids = key_ids.push(root.key_id)
        public_keys = public_keys.push(
            simpleos_evidence_bytes_copy(root.public_key))
    _simpleos_evidence_trusted_key_ids = key_ids
    _simpleos_evidence_trusted_public_keys = public_keys
    _simpleos_evidence_initialized = true
    _simpleos_evidence_finish_check(
        SimpleOsCapabilityLedgerCheckV1(ok: true, reason: ""))

fn simpleos_evidence_verifier_ready() -> bool:
    if _simpleos_evidence_quarantined: return false
    if not mutex_raw_lock(_SIMPLEOS_EVIDENCE_OWNER_MUTEX):
        return false
    val ready = _simpleos_evidence_initialized
        and _simpleos_evidence_owner_state_valid_locked()
    _simpleos_evidence_finish_bool(ready)

fn simpleos_evidence_pass_admission_available() -> bool:
    if _simpleos_evidence_quarantined: return false
    if not mutex_raw_lock(_SIMPLEOS_EVIDENCE_OWNER_MUTEX):
        return false
    val available = _simpleos_evidence_initialized
        and _simpleos_evidence_owner_state_valid_locked()
        and simpleos_evidence_all_admission_gates_admitted()
    _simpleos_evidence_finish_bool(available)

fn simpleos_evidence_issue_challenge(
    nonce: text,
    now_unix_us: i64,
    ttl_us: i64) -> SimpleOsEvidenceChallengeResultV1:
    if not simpleos_evidence_bounded_identity(
        nonce, SIMPLEOS_EVIDENCE_MAX_ID_BYTES):
        return _simpleos_evidence_challenge_failure("nonce-format")
    if now_unix_us <= 0 or ttl_us <= 0
        or ttl_us > SIMPLEOS_EVIDENCE_MAX_CHALLENGE_TTL_US
        or now_unix_us > _SIMPLEOS_EVIDENCE_MAX_TIME - ttl_us:
        return _simpleos_evidence_challenge_failure("challenge-time")
    if _simpleos_evidence_quarantined:
        return _simpleos_evidence_challenge_failure("serialization-indeterminate")
    if not mutex_raw_lock(_SIMPLEOS_EVIDENCE_OWNER_MUTEX):
        return _simpleos_evidence_challenge_failure(
            "evidence-owner-lock-unavailable")
    if not _simpleos_evidence_initialized:
        return _simpleos_evidence_finish_challenge(
            _simpleos_evidence_challenge_failure("trust-root-configuration"))
    if not _simpleos_evidence_owner_state_valid_locked():
        return _simpleos_evidence_finish_challenge(
            _simpleos_evidence_challenge_failure("evidence-owner-state"))
    if _simpleos_evidence_nonce_seen_locked(nonce):
        return _simpleos_evidence_finish_challenge(
            _simpleos_evidence_challenge_failure("nonce-replay"))
    if _simpleos_evidence_seen_nonces.len() >= SIMPLEOS_EVIDENCE_MAX_SEEN_NONCES:
        return _simpleos_evidence_finish_challenge(
            _simpleos_evidence_challenge_failure("nonce-history-bound"))
    if _simpleos_evidence_next_generation == 0u64
        or _simpleos_evidence_next_generation == _SIMPLEOS_EVIDENCE_MAX_GENERATION:
        return _simpleos_evidence_finish_challenge(
            _simpleos_evidence_challenge_failure("generation-exhausted"))
    _simpleos_evidence_expire_locked(now_unix_us)
    val slot = _simpleos_evidence_free_challenge_slot_locked()
    if slot < 0:
        return _simpleos_evidence_finish_challenge(
            _simpleos_evidence_challenge_failure("challenge-bound"))
    val generation = _simpleos_evidence_next_generation
    val expires = now_unix_us + ttl_us
    val entry = _SimpleOsEvidenceChallengeEntryV1(
        active: true,
        nonce: nonce,
        generation: generation,
        issued_unix_us: now_unix_us,
        expires_unix_us: expires)
    var next_challenges: [_SimpleOsEvidenceChallengeEntryV1] = []
    for live_challenge in _simpleos_evidence_challenges:
        next_challenges = next_challenges.push(live_challenge)
    if slot == next_challenges.len():
        next_challenges = next_challenges.push(entry)
    else:
        next_challenges[slot] = entry
    var next_seen_nonces: [text] = []
    for seen_nonce in _simpleos_evidence_seen_nonces:
        next_seen_nonces = next_seen_nonces.push(seen_nonce)
    next_seen_nonces = next_seen_nonces.push(nonce)
    val issued = SimpleOsEvidenceChallengeResultV1(
        ok: true,
        reason: "",
        challenge: SimpleOsEvidenceChallengeV1(
            session_id: (slot + 1).to_u64(),
            nonce: nonce,
            generation: generation,
            expires_unix_us: expires))
    _simpleos_evidence_challenges = next_challenges
    _simpleos_evidence_seen_nonces = next_seen_nonces
    _simpleos_evidence_next_generation = generation + 1u64
    _simpleos_evidence_finish_challenge(issued)

fn _simpleos_evidence_verify_candidate_checked(
    candidate: SimpleOsCapabilityLedgerCandidateV1,
    challenge: SimpleOsEvidenceChallengeV1,
    consumer: text,
    now_unix_us: i64,
    snapshot_check: SimpleOsCapabilityLedgerCheckV1
) -> SimpleOsEvidenceVerificationResultV1:
    if not simpleos_evidence_bounded_identity(
        consumer, SIMPLEOS_EVIDENCE_MAX_CONSUMER_BYTES):
        return _simpleos_evidence_verification_failure("consumer-format")
    if now_unix_us <= 0:
        return _simpleos_evidence_verification_failure("verification-time")
    if candidate.row.status != SimpleOsCapabilityStatus.Pass:
        return _simpleos_evidence_verification_failure("pass-required")
    val candidate_check = simpleos_capability_candidate_validate(candidate)
    if not candidate_check.ok:
        return _simpleos_evidence_verification_failure(
            "candidate:" + candidate_check.reason)
    val receipt = candidate.receipt
    if receipt.nonce != challenge.nonce:
        return _simpleos_evidence_verification_failure(
            "challenge-nonce-binding")
    val signing_bytes = encode_simpleos_evidence_receipt_v1_signing_bytes(receipt)
    if not signing_bytes.ok:
        return _simpleos_evidence_verification_failure(
            "canonical-signing-bytes")
    val signature = simpleos_evidence_signature_hex_decode(receipt.signature)
    if signature.len() != 64:
        return _simpleos_evidence_verification_failure("signature-encoding")
    if _simpleos_evidence_quarantined:
        return _simpleos_evidence_verification_failure(
            "serialization-indeterminate")
    if not mutex_raw_lock(_SIMPLEOS_EVIDENCE_OWNER_MUTEX):
        return _simpleos_evidence_verification_failure(
            "evidence-owner-lock-unavailable")
    if not _simpleos_evidence_initialized:
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure("trust-root-configuration"))
    if not _simpleos_evidence_owner_state_valid_locked():
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure("evidence-owner-state"))
    _simpleos_evidence_expire_locked(now_unix_us)
    val challenge_index = _simpleos_evidence_challenge_index_locked(challenge)
    if challenge_index < 0:
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure("challenge-unknown"))
    val challenge_entry = _simpleos_evidence_challenges[challenge_index]
    if not challenge_entry.active:
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure(
                "challenge-spent-or-expired"))
    if receipt.started_unix_us < challenge_entry.issued_unix_us
        or receipt.finished_unix_us > now_unix_us:
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure("receipt-freshness"))
    val signer_index = _simpleos_evidence_signer_index_locked(
        receipt.signer_key_id)
    if signer_index < 0:
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure("signer-untrusted"))
    if _simpleos_evidence_trusted_public_keys[signer_index].len() != 32:
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure("trust-root-corrupt"))

    if not snapshot_check.ok:
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure(snapshot_check.reason))
    val admission_gate_reason = simpleos_evidence_admission_gate_reason()
    if admission_gate_reason != "":
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure(admission_gate_reason))
    val trusted_public_key = simpleos_evidence_bytes_copy(
        _simpleos_evidence_trusted_public_keys[signer_index])
    if not _simpleos_evidence_unlock_owner():
        return _simpleos_evidence_verification_failure(
            "serialization-indeterminate")
    if not pure_ed25519_verify(trusted_public_key, signing_bytes.bytes, signature):
        return _simpleos_evidence_verification_failure("signature-invalid")

    if _simpleos_evidence_quarantined:
        return _simpleos_evidence_verification_failure(
            "serialization-indeterminate")
    if not mutex_raw_lock(_SIMPLEOS_EVIDENCE_OWNER_MUTEX):
        return _simpleos_evidence_verification_failure(
            "evidence-owner-lock-unavailable")
    if not _simpleos_evidence_initialized
        or not _simpleos_evidence_owner_state_valid_locked():
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure("evidence-owner-state"))
    _simpleos_evidence_expire_locked(now_unix_us)
    val live_index = _simpleos_evidence_challenge_index_locked(challenge)
    if live_index < 0 or not _simpleos_evidence_challenges[live_index].active:
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure(
                "challenge-spent-or-expired"))
    val live_signer_index = _simpleos_evidence_signer_index_locked(
        receipt.signer_key_id)
    if live_signer_index < 0 or not simpleos_evidence_bytes_equal(
        trusted_public_key,
        _simpleos_evidence_trusted_public_keys[live_signer_index]):
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure("trust-root-changed"))
    val handle_slot = _simpleos_evidence_free_handle_slot_locked()
    if handle_slot < 0:
        return _simpleos_evidence_finish_verification(
            _simpleos_evidence_verification_failure("verified-handle-bound"))

    val row_key = simpleos_capability_row_key(candidate.row)
    val handle_id = "evh-" + challenge.session_id.to_text() + "-" +
        challenge.generation.to_text()
    val entry = _SimpleOsEvidenceHandleEntryV1(
        active: true,
        handle_id: handle_id,
        receipt_id: receipt.receipt_id,
        receipt_nonce: receipt.nonce,
        row_key: row_key,
        consumer: consumer,
        signature: receipt.signature,
        signing_bytes_hash: sha256_u8_hex(signing_bytes.bytes),
        generation: challenge.generation,
        expires_unix_us: challenge.expires_unix_us)
    var next_challenges: [_SimpleOsEvidenceChallengeEntryV1] = []
    for live_challenge in _simpleos_evidence_challenges:
        next_challenges = next_challenges.push(live_challenge)
    var spent_challenge = next_challenges[live_index]
    spent_challenge.active = false
    next_challenges[live_index] = spent_challenge
    var next_handles: [_SimpleOsEvidenceHandleEntryV1] = []
    for live_handle in _simpleos_evidence_handles:
        next_handles = next_handles.push(live_handle)
    if handle_slot == next_handles.len():
        next_handles = next_handles.push(entry)
    else:
        next_handles[handle_slot] = entry
    val verified = SimpleOsEvidenceVerificationResultV1(
        ok: true,
        reason: "",
        handle: SimpleOsVerifiedEvidenceHandleV1(
            handle_id: handle_id,
            receipt_id: receipt.receipt_id,
            receipt_nonce: receipt.nonce,
            row_key: row_key,
            consumer: consumer,
            generation: challenge.generation,
            expires_unix_us: challenge.expires_unix_us))
    _simpleos_evidence_challenges = next_challenges
    _simpleos_evidence_handles = next_handles
    _simpleos_evidence_finish_verification(verified)
