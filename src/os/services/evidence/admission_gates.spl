# Release gates for the evidence owner. Each remains false until its own
# authoritative executable evidence and owner wiring exist.

val SIMPLEOS_EVIDENCE_SERIALIZED_OWNER_ADMITTED: bool = false
val SIMPLEOS_EVIDENCE_CRYPTOGRAPHIC_VERIFIER_ADMITTED: bool = false
val SIMPLEOS_EVIDENCE_TRUST_ROOT_OWNER_ADMITTED: bool = false
val SIMPLEOS_EVIDENCE_POLICY_OWNER_ADMITTED: bool = false
val SIMPLEOS_EVIDENCE_TIME_OWNER_ADMITTED: bool = false

fn simpleos_evidence_admission_gate_reason() -> text:
    if not SIMPLEOS_EVIDENCE_TRUST_ROOT_OWNER_ADMITTED:
        return "trust-root-owner-unavailable"
    if not SIMPLEOS_EVIDENCE_POLICY_OWNER_ADMITTED:
        return "admission-policy-owner-unavailable"
    if not SIMPLEOS_EVIDENCE_TIME_OWNER_ADMITTED:
        return "time-owner-unavailable"
    if not SIMPLEOS_EVIDENCE_CRYPTOGRAPHIC_VERIFIER_ADMITTED:
        return "cryptographic-verifier-unavailable"
    if not SIMPLEOS_EVIDENCE_SERIALIZED_OWNER_ADMITTED:
        return "serialized-owner-unavailable"
    ""

fn simpleos_evidence_all_admission_gates_admitted() -> bool:
    simpleos_evidence_admission_gate_reason() == ""

export SIMPLEOS_EVIDENCE_SERIALIZED_OWNER_ADMITTED
export SIMPLEOS_EVIDENCE_CRYPTOGRAPHIC_VERIFIER_ADMITTED
export SIMPLEOS_EVIDENCE_TRUST_ROOT_OWNER_ADMITTED
export SIMPLEOS_EVIDENCE_POLICY_OWNER_ADMITTED
export SIMPLEOS_EVIDENCE_TIME_OWNER_ADMITTED
export simpleos_evidence_admission_gate_reason
export simpleos_evidence_all_admission_gates_admitted
