"""Pure fail-closed transition model for the evidence authority clock."""

pub struct SimpleOsEvidenceClockTransitionV1:
    ok: bool
    reason: text
    next_last_unix_us: i64
    quarantined: bool

pub fn simpleos_evidence_clock_transition_v1(
    started: bool, quarantined: bool, last_unix_us: i64, sampled_unix_us: i64
) -> SimpleOsEvidenceClockTransitionV1:
    if quarantined:
        return SimpleOsEvidenceClockTransitionV1(
            ok: false, reason: "evidence-authority-quarantined",
            next_last_unix_us: last_unix_us, quarantined: true)
    if sampled_unix_us <= 0:
        return SimpleOsEvidenceClockTransitionV1(
            ok: false, reason: "time-owner-unavailable",
            next_last_unix_us: last_unix_us, quarantined: false)
    if started and sampled_unix_us < last_unix_us:
        return SimpleOsEvidenceClockTransitionV1(
            ok: false, reason: "time-owner-rollback",
            next_last_unix_us: last_unix_us, quarantined: true)
    SimpleOsEvidenceClockTransitionV1(
        ok: true, reason: "", next_last_unix_us: sampled_unix_us,
        quarantined: false)

pub struct SimpleOsEvidenceAuthorityLockOutcomeV1:
    authoritative: bool
    quarantined: bool
    reason: text

pub fn simpleos_evidence_authority_lock_outcome_v1(
    lock_ok: bool, unlock_ok: bool, prior_quarantined: bool
) -> SimpleOsEvidenceAuthorityLockOutcomeV1:
    if prior_quarantined:
        return SimpleOsEvidenceAuthorityLockOutcomeV1(
            authoritative: false, quarantined: true,
            reason: "evidence-authority-quarantined")
    if not lock_ok:
        return SimpleOsEvidenceAuthorityLockOutcomeV1(
            authoritative: false, quarantined: false,
            reason: "evidence-authority-lock-unavailable")
    if not unlock_ok:
        return SimpleOsEvidenceAuthorityLockOutcomeV1(
            authoritative: false, quarantined: true,
            reason: "evidence-authority-unlock-unavailable")
    SimpleOsEvidenceAuthorityLockOutcomeV1(
        authoritative: true, quarantined: false, reason: "")
