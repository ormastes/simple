# SimpleOS Update — TUF-style signed metadata trust model (Phase 5 groundwork)
#
# Master plan §20 (updates/recovery) requires signed packages, transactional
# install, rollback, and cites TUF (The Update Framework) for retaining update
# security under repository or signing-key compromise — including rollback and
# freeze defenses — plus SLSA-style build provenance.
#
# THIS FILE IS A PURE MODEL. It does NOT perform real cryptography, network
# pull, or package install. Signatures are modeled as a *verified-key-id list*:
# `signatures_present` holds the key-ids whose signatures have (by assumption)
# already been cryptographically verified upstream. The verifier here reasons
# about the TUF *trust structure* — role delegation, signing thresholds,
# metadata freshness (freeze/expiry), version rollback, and snapshot
# consistency — which is what defends the update system when a repository or a
# single signing key is compromised. Real signature verification, transactional
# A/B install, and SLSA provenance emission are the next increment (see the
# lane state file).
#
# The four TUF roles modeled:
#   root      — the trust anchor; delegates signing keys to the other roles.
#   targets   — vouches for the actual update artifacts (name/length/digest).
#   snapshot  — pins a consistent set of role versions (anti mix-and-match).
#   timestamp — the freshest short-lived pointer (freeze-attack detection).

# ============================================================================
# Reason codes — verify_update fails closed with a distinct code per attack.
# ============================================================================

val TUF_ACCEPTED:          u32 = 0
val TUF_UNTRUSTED_KEY:     u32 = 1   # a signer key is not in root's trusted set
val TUF_BAD_THRESHOLD:     u32 = 2   # fewer than `threshold` valid signers
val TUF_EXPIRED:           u32 = 3   # metadata past expires_at (freeze/expiry)
val TUF_ROLLBACK:          u32 = 4   # incoming version below current (rollback)
val TUF_SNAPSHOT_MISMATCH: u32 = 5   # snapshot targets-version != presented

# ============================================================================
# Model structs (POD)
# ============================================================================

struct RoleKey:
    """A signing key identity. Real key material is out of scope for the model."""
    key_id: text

struct RoleMetadata:
    """Signed metadata for one TUF role.

    `signer_key_ids` are the keys authorized to sign THIS role (root's
    delegation for the role). `signatures_present` are the key-ids whose
    signatures are (modeled as) already verified. `delegated_key_ids` is used
    only by the root role: the full set of keys root trusts across all roles —
    the trust anchor. `recorded_targets_version` is used only by the snapshot
    role: the targets version snapshot vouches for.
    """
    role:                     text
    version:                  u64
    expires_at:               u64
    threshold:                u64
    signer_key_ids:           List<text>
    signatures_present:       List<text>
    delegated_key_ids:        List<text>
    recorded_targets_version: u64

struct TargetEntry:
    """One update artifact vouched for by the targets role."""
    name:    text
    length:  u64
    digest:  text
    version: u64

struct CurrentVersions:
    """Locally trusted current version of each role, for rollback defense."""
    root:      u64
    timestamp: u64
    snapshot:  u64
    targets:   u64

struct VerifyOutcome:
    """Result of a full update verification.

    Stands in for `Result<accepted, reason>`: `accepted` is the Ok side,
    `reason_code`/`reason` describe the fail-closed rejection.
    """
    accepted:    bool
    reason_code: u32
    reason:      text

# ============================================================================
# List helpers (pure)
# ============================================================================

fn tuf_contains(items: List<text>, needle: text) -> bool:
    """True if `needle` is present in `items` (text equality)."""
    for it in items:
        if it == needle:
            return true
    return false

fn tuf_all_in(subset: List<text>, universe: List<text>) -> bool:
    """True if every element of `subset` appears in `universe`."""
    for s in subset:
        if not tuf_contains(universe, s):
            return false
    return true

# ============================================================================
# Per-role verifier primitives (pure; `now` is a parameter — no clock call)
# ============================================================================

fn count_valid_signers(meta: RoleMetadata) -> u64:
    """Distinct key-ids that both signed AND are authorized to sign this role."""
    var n: u64 = 0
    var seen: List<text> = []
    for k in meta.signatures_present:
        val authorized: bool = tuf_contains(meta.signer_key_ids, k)
        val fresh: bool = not tuf_contains(seen, k)
        if authorized and fresh:
            seen = seen.push(k)
            n = n + 1
    return n

fn verify_threshold(meta: RoleMetadata) -> bool:
    """Deny unless at least `threshold` distinct valid signers signed."""
    return count_valid_signers(meta) >= meta.threshold

fn check_freshness(meta: RoleMetadata, now: u64) -> bool:
    """Deny if `now` is past `expires_at` (freeze / expiry defense)."""
    return now <= meta.expires_at

fn rollback_guard(current_version: u64, incoming_version: u64) -> bool:
    """KEY TUF PROPERTY: deny any incoming version below the current one.

    Blocks a rollback attack that replays an older, validly-signed metadata to
    reintroduce known-vulnerable artifacts.
    """
    return incoming_version >= current_version

fn verify_snapshot_consistency(snapshot_targets_version: u64, targets_version: u64) -> bool:
    """Deny unless snapshot's recorded targets version matches the presented one.

    Prevents mix-and-match: an attacker cannot pair a fresh snapshot with a
    rolled-back or swapped targets metadata.
    """
    return snapshot_targets_version == targets_version

fn keys_trusted_by_root(meta: RoleMetadata, root_trusted: List<text>) -> bool:
    """Deny if any signer key on `meta` is not in root's trusted key set."""
    return tuf_all_in(meta.signatures_present, root_trusted)

# ============================================================================
# Full verification pipeline
# ============================================================================

fn reject(code: u32, why: text) -> VerifyOutcome:
    """Build a fail-closed rejection outcome."""
    return VerifyOutcome(accepted: false, reason_code: code, reason: why)

fn root_trusted_set(root: RoleMetadata) -> List<text>:
    """Trust anchor: root's own signing keys plus every key it delegates."""
    var trusted: List<text> = []
    for k in root.signer_key_ids:
        trusted = trusted.push(k)
    for k in root.delegated_key_ids:
        trusted = trusted.push(k)
    return trusted

fn verify_update(
    root:      RoleMetadata,
    timestamp: RoleMetadata,
    snapshot:  RoleMetadata,
    targets:   RoleMetadata,
    current:   CurrentVersions,
    now:       u64
) -> VerifyOutcome:
    """Run all four role checks in TUF order, fail closed with a distinct reason.

    Order: trusted-keys -> threshold -> freshness -> rollback -> snapshot
    consistency. The first failing check decides the rejection reason.
    """
    val trusted: List<text> = root_trusted_set(root)
    val roles: List<RoleMetadata> = [root, timestamp, snapshot, targets]

    # 1. Every presented signature must trace to a root-trusted key.
    for r in roles:
        if not keys_trusted_by_root(r, trusted):
            return reject(TUF_UNTRUSTED_KEY, "signer key not in root trusted set")

    # 2. Each role must meet its signing threshold.
    for r in roles:
        if not verify_threshold(r):
            return reject(TUF_BAD_THRESHOLD, "below signing threshold")

    # 3. No role metadata may be expired (freeze / freshness defense).
    for r in roles:
        if not check_freshness(r, now):
            return reject(TUF_EXPIRED, "metadata expired")

    # 4. No role may roll back below its locally trusted current version.
    if not rollback_guard(current.root, root.version):
        return reject(TUF_ROLLBACK, "root version rollback")
    if not rollback_guard(current.timestamp, timestamp.version):
        return reject(TUF_ROLLBACK, "timestamp version rollback")
    if not rollback_guard(current.snapshot, snapshot.version):
        return reject(TUF_ROLLBACK, "snapshot version rollback")
    if not rollback_guard(current.targets, targets.version):
        return reject(TUF_ROLLBACK, "targets version rollback")

    # 5. Snapshot must pin exactly the presented targets version.
    if not verify_snapshot_consistency(snapshot.recorded_targets_version, targets.version):
        return reject(TUF_SNAPSHOT_MISMATCH, "snapshot targets-version mismatch")

    return VerifyOutcome(accepted: true, reason_code: TUF_ACCEPTED, reason: "accepted")
