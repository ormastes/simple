# PID1 catalog dependency policy.
#
# The current root service catalog is a fixed topological chain:
# VFS -> net -> HTTP.  This module owns only the pure containment decision;
# PID1 owns process stopping and capability teardown through its opaque kernel
# ABI.  Keeping selection pure makes terminal-dependency behaviour testable
# without simulating kernel syscalls.

pub val ROOT_SERVICE_CATALOG_COUNT: i64 = 3

pub fn catalog_reverse_dependents_of(failed_index: i64, service_count: i64) -> [i64]:
    """Return dependent catalog indices in reverse shutdown order.

    Invalid indices or any count other than the fixed root catalog yield no
    dependents. For a valid topological index, every later entry depends (directly or
    transitively) on it in the current VFS -> net -> HTTP catalog.  Returning
    highest index first gives PID1 reverse dependency shutdown order.
    """
    var dependents: [i64] = []
    # This is a root-catalog policy, not a generic array helper.  Failing
    # closed on a mismatched count prevents a future caller from converting a
    # malformed supervisor table into arbitrary stop indices before the real
    # dependency graph implementation exists.
    if service_count != ROOT_SERVICE_CATALOG_COUNT or failed_index < 0 or
        failed_index >= ROOT_SERVICE_CATALOG_COUNT:
        return dependents
    var i = ROOT_SERVICE_CATALOG_COUNT - 1
    while i > failed_index:
        dependents.push(i)
        i = i - 1
    dependents
