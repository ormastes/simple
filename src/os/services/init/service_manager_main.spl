# SimpleOS PID1 service-manager ring-3 entry.
#
# This is intentionally a narrow bootstrap manager rather than a raw binary
# launcher: service creation goes exclusively through the root-service catalog
# ABI, which validates PID1's non-transferable root mint authority and mints
# each child CSpace from trusted policy. The target image bake must provide the
# three catalogued service binaries before this PID1 can complete boot.

use os.userlib.root_service_catalog.{
    ROOT_SERVICE_VFS, ROOT_SERVICE_NET, ROOT_SERVICE_HTTP,
    root_service_spawn, root_service_wait_nohang, root_service_stop
}
use os.userlib.syscall_raw.{syscall}
use os.userlib.ipc_endpoint.{ipc_connect_named_port}
use os.services.init.service_dependency_policy.{catalog_reverse_dependents_of}

val SYS_YIELD: u64 = 1u64
val SYS_DEBUG_WRITE: u64 = 60u64
val PRIORITY_HIGH: u64 = 1u64
val PRIORITY_NORMAL: u64 = 2u64
val MAX_RESTARTS: i64 = 3
val MAX_READY_YIELDS: u64 = 1024u64
val MAX_RESTART_BACKOFF_YIELDS: u64 = 64u64

struct DependencyContainment:
    pids: [i64]
    quarantined: [bool]

fn _serial_lifecycle_evidence(message: text):
    """Write evidence through PID1's filtered kernel serial syscall only."""
    var offset: u64 = 0u64
    while offset < message.len():
        syscall(SYS_DEBUG_WRITE, message.char_code_at(offset) as u64, 0u64, 0u64, 0u64, 0u64)
        offset = offset + 1u64
    syscall(SYS_DEBUG_WRITE, 10u64, 0u64, 0u64, 0u64, 0u64)

fn _record_catalog_launch(catalog_id: u64, pid: i64):
    if catalog_id == ROOT_SERVICE_VFS:
        _serial_lifecycle_evidence("[pid1] catalog-launch id=1 service=vfs pid={pid}")
    else if catalog_id == ROOT_SERVICE_NET:
        _serial_lifecycle_evidence("[pid1] catalog-launch id=2 service=net pid={pid}")
    else if catalog_id == ROOT_SERVICE_HTTP:
        _serial_lifecycle_evidence("[pid1] catalog-launch id=3 service=http pid={pid}")

fn _record_endpoint_ready(name: text):
    if name == "vfs":
        _serial_lifecycle_evidence("[pid1] endpoint-ready service=vfs")
    else if name == "net":
        _serial_lifecycle_evidence("[pid1] endpoint-ready service=net")
    else if name == "http":
        _serial_lifecycle_evidence("[pid1] endpoint-ready service=http")

fn _stop_started_reverse(pids: [i64]):
    """Unwind a failed bootstrap in reverse dependency order.

    This only requests termination through the opaque PID1 catalogue syscall;
    cleanup and authority revocation are kernel-owned.  A failed stop is not
    retried here because PID1 has no deadline/clock service at this phase.
    """
    var i = pids.len() as i64 - 1
    while i >= 0:
        if pids[i as u64] > 0:
            root_service_stop(pids[i as u64], -125)
        i = i - 1

fn _catalog_endpoint(catalog_id: u64) -> text:
    if catalog_id == ROOT_SERVICE_VFS:
        return "vfs"
    if catalog_id == ROOT_SERVICE_NET:
        return "net"
    if catalog_id == ROOT_SERVICE_HTTP:
        return "http"
    ""

fn _wait_endpoint_ready(name: text) -> bool:
    """Wait cooperatively for the exact endpoint declared by a dependency.

    Endpoint reservation is the first live readiness signal. It does not grant
    PID1 send/listen authority and it does not substitute for later health or
    watchdog evidence; it prevents a dependent service from starting before
    the provider has entered its userspace service loop.
    """
    var attempts: u64 = 0u64
    while attempts < MAX_READY_YIELDS:
        val endpoint = ipc_connect_named_port(name)
        if endpoint.is_ok():
            _record_endpoint_ready(name)
            return true
        syscall(SYS_YIELD, 0u64, 0u64, 0u64, 0u64, 0u64)
        attempts = attempts + 1u64
    false

fn _restart_backoff_yields(restart_count: i64, service_index: u64) -> u64:
    """Return bounded exponential restart delay with deterministic staggering.

    PID1 has no trusted entropy source at this early boot stage.  A stable
    service-index stagger avoids synchronized retry bursts without pretending
    to provide randomness; a later timer/entropy service may replace this with
    true jitter without changing the restart state machine.
    """
    var delay: u64 = 1u64
    var step: i64 = 0
    while step < restart_count and delay < MAX_RESTART_BACKOFF_YIELDS:
        delay = delay * 2u64
        step = step + 1
    if delay > MAX_RESTART_BACKOFF_YIELDS:
        delay = MAX_RESTART_BACKOFF_YIELDS
    val stagger = service_index % 4u64
    if delay + stagger > MAX_RESTART_BACKOFF_YIELDS:
        return MAX_RESTART_BACKOFF_YIELDS
    delay + stagger

fn _quarantine_dependents(
    failed_index: i64,
    pids_in: [i64],
    quarantined_in: [bool]
) -> DependencyContainment:
    """Contain a terminal prerequisite failure in reverse dependency order.

    The catalog's initial graph is topologically ordered VFS -> net -> HTTP.
    A restartable failure does *not* enter this function: dependents retain
    their own reconnect policy while the provider receives fresh authority.
    Once PID1 has exhausted a provider's restart budget, however, leaving a
    dependent service alive would leave it operating against an unavailable
    capability endpoint. Stop every later service through the opaque catalog
    ABI, then mark it quarantined so it cannot independently restart around its
    failed prerequisite.
    """
    var pids = pids_in
    var quarantined = quarantined_in
    for i in catalog_reverse_dependents_of(failed_index, pids.len() as i64):
        if not quarantined[i]:
            if pids[i] > 0:
                root_service_stop(pids[i], -125)
            pids[i] = 0
            quarantined[i] = true
    DependencyContainment(pids: pids, quarantined: quarantined)

fn _bootstrap_service_graph() -> [i64]?:
    # The order is a concrete readiness precondition for the initial target
    # catalog. Runtime readiness/watchdog/restart supervision is added once
    # service exit notifications arrive through the live kernel event path.
    val vfs = root_service_spawn(ROOT_SERVICE_VFS, PRIORITY_HIGH)
    if vfs <= 0:
        return nil
    _record_catalog_launch(ROOT_SERVICE_VFS, vfs)
    if not _wait_endpoint_ready("vfs"):
        _stop_started_reverse([vfs])
        return nil
    val net = root_service_spawn(ROOT_SERVICE_NET, PRIORITY_HIGH)
    if net <= 0:
        _stop_started_reverse([vfs])
        return nil
    _record_catalog_launch(ROOT_SERVICE_NET, net)
    if not _wait_endpoint_ready("net"):
        _stop_started_reverse([vfs, net])
        return nil
    val http = root_service_spawn(ROOT_SERVICE_HTTP, PRIORITY_NORMAL)
    if http <= 0:
        _stop_started_reverse([vfs, net])
        return nil
    _record_catalog_launch(ROOT_SERVICE_HTTP, http)
    if not _wait_endpoint_ready("http"):
        _stop_started_reverse([vfs, net, http])
        return nil
    # The initial launches are retained as the watched PIDs; no service is
    # spawned a second time merely to construct supervisor state.
    Some([vfs, net, http])

fn main(argv: [text]) -> i32:
    val _argv = argv
    val initial = _bootstrap_service_graph()
    var pids = match initial:
        Some(started): started
        nil: return 1
    val catalog_ids: [u64] = [ROOT_SERVICE_VFS, ROOT_SERVICE_NET, ROOT_SERVICE_HTTP]
    val priorities: [u64] = [PRIORITY_HIGH, PRIORITY_HIGH, PRIORITY_NORMAL]
    var restart_counts: [i64] = [0, 0, 0]
    var quarantined: [bool] = [false, false, false]
    var restart_backoff: [u64] = [0u64, 0u64, 0u64]
    # PID1 remains alive as the reaper/root-mint holder. Yield rather than
    # busy-spin while the kernel scheduler runs the newly created services.
    while true:
        var i = 0
        while i < pids.len():
            if not quarantined[i] and pids[i] > 0:
                val reaped = root_service_wait_nohang(pids[i])
                if reaped != 0:
                    if catalog_ids[i] == ROOT_SERVICE_NET:
                        _serial_lifecycle_evidence("[pid1] service-crash service=net pid={pids[i]} reap={reaped}")
                    if reaped < 0 or restart_counts[i] >= MAX_RESTARTS:
                        quarantined[i] = true
                        val contained = _quarantine_dependents(i as i64, pids, quarantined)
                        pids = contained.pids
                        quarantined = contained.quarantined
                    else:
                        restart_counts[i] = restart_counts[i] + 1
                        pids[i] = 0
                        restart_backoff[i] = _restart_backoff_yields(restart_counts[i], i as u64)
            else if not quarantined[i] and pids[i] == 0:
                if restart_backoff[i] > 0u64:
                    restart_backoff[i] = restart_backoff[i] - 1u64
                else:
                    pids[i] = root_service_spawn(catalog_ids[i], priorities[i])
                    if pids[i] <= 0:
                        quarantined[i] = true
                        val contained = _quarantine_dependents(i as i64, pids, quarantined)
                        pids = contained.pids
                        quarantined = contained.quarantined
                    else:
                        _record_catalog_launch(catalog_ids[i], pids[i])
                        val restarted_name = _catalog_endpoint(catalog_ids[i])
                        if not _wait_endpoint_ready(restarted_name):
                            quarantined[i] = true
                            val contained = _quarantine_dependents(i as i64, pids, quarantined)
                            pids = contained.pids
                            quarantined = contained.quarantined
                        else if catalog_ids[i] == ROOT_SERVICE_NET:
                            _serial_lifecycle_evidence("[pid1] service-restart service=net pid={pids[i]} fresh-grants=true")
            i = i + 1
        syscall(SYS_YIELD, 0u64, 0u64, 0u64, 0u64, 0u64)
    0
