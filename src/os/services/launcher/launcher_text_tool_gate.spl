# Launcher-owned gate for filesystem-launched pure-Simple text tools.
#
# Only a real target artifact digest plus loader-owned authority token may
# cross this boundary. Neither exists yet, so known identities fail closed.

use os.packages.text_tool_package_identity.{
    text_tool_package_identity_v1,
    text_tool_package_identity_blocked_v1
}
use os.services.launcher.primary_tool_artifact_gate.{
    LauncherPrimaryToolResultV1,
    primary_tool_blocked_result_v1,
    primary_tool_unknown_result_v1,
    LAUNCHER_PRIMARY_TOOL_BLOCKED,
    LAUNCHER_PRIMARY_TOOL_UNKNOWN
}

pub const LAUNCHER_TEXT_TOOL_BLOCKED: i32 = LAUNCHER_PRIMARY_TOOL_BLOCKED
pub const LAUNCHER_TEXT_TOOL_UNKNOWN: i32 = LAUNCHER_PRIMARY_TOOL_UNKNOWN

pub fn launcher_dispatch_text_tool_v1(
    command: text,
    _args: [text]
) -> LauncherPrimaryToolResultV1:
    val identity = text_tool_package_identity_v1(command)
    match identity:
        case Err(_):
            primary_tool_unknown_result_v1("TEXT_TOOL_COMMAND_UNKNOWN")
        case Ok(package):
            if not text_tool_package_identity_blocked_v1(package):
                return primary_tool_blocked_result_v1(
                    "TEXT_TOOL_PACKAGE_IDENTITY_INVALID",
                    package.artifact.canonical_path,
                    "",
                    "",
                )
            primary_tool_blocked_result_v1(
                "TEXT_TOOL_TARGET_ARTIFACT_TOKEN_UNAVAILABLE",
                package.artifact.canonical_path,
                package.artifact_digest,
                package.admission_receipt_id,
            )
