# Shared fail-closed result contract for primary filesystem-launched tools.
#
# This record is diagnostic only. In particular, `loader_authority_state` is
# never a substitute for the loader-owned ExecutableAuthorityTokenV1 value.

use os.tools.shell.checksum.checksum_artifact_contract.{
    checksum_tool_canonical_path_v1
}
use os.tools.shell.grep.grep_artifact_contract.{text_tool_canonical_path_v1}
use os.tools.shell.process.process_artifact_contract.{
    process_tool_canonical_path_v1
}

pub const LAUNCHER_PRIMARY_TOOL_BLOCKED: i32 = 126
pub const LAUNCHER_PRIMARY_TOOL_UNKNOWN: i32 = 127
pub const PRIMARY_TOOL_LOADER_AUTHORITY_ABSENT: text = "absent"

pub struct LauncherPrimaryToolResultV1:
    ok: bool
    exit_code: i32
    code: text
    canonical_path: text
    artifact_digest: text
    admission_receipt_id: text
    loader_authority_state: text
    pid: i64

pub fn primary_tool_blocked_result_v1(
    code: text,
    canonical_path: text,
    artifact_digest: text,
    admission_receipt_id: text
) -> LauncherPrimaryToolResultV1:
    LauncherPrimaryToolResultV1(
        ok: false,
        exit_code: LAUNCHER_PRIMARY_TOOL_BLOCKED,
        code: code,
        canonical_path: canonical_path,
        artifact_digest: artifact_digest,
        admission_receipt_id: admission_receipt_id,
        loader_authority_state: PRIMARY_TOOL_LOADER_AUTHORITY_ABSENT,
        pid: -1,
    )

pub fn primary_tool_unknown_result_v1(code: text) -> LauncherPrimaryToolResultV1:
    LauncherPrimaryToolResultV1(
        ok: false,
        exit_code: LAUNCHER_PRIMARY_TOOL_UNKNOWN,
        code: code,
        canonical_path: "",
        artifact_digest: "",
        admission_receipt_id: "",
        loader_authority_state: PRIMARY_TOOL_LOADER_AUTHORITY_ABSENT,
        pid: -1,
    )

pub fn primary_tool_path_requires_loader_authority_v1(path: text) -> bool:
    path != "" and (
        path == checksum_tool_canonical_path_v1("sha256sum") or
        path == checksum_tool_canonical_path_v1("md5sum") or
        path == text_tool_canonical_path_v1("grep") or
        path == process_tool_canonical_path_v1("ps")
    )
