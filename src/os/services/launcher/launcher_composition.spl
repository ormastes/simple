# SCI v1 application projection adapter for the launcher service.
#
# This is a one-way projection into the existing launcher registry. SCI is the
# configuration authority; launcher process/lifecycle state remains local.

use std.nogc_sync_mut.composition.types.{SimpleCompositionImageV1}
use std.nogc_sync_mut.composition.codec.{decode_composition_image_v1}
use os.services.launcher.launcher_registry.{
    MAX_APPS, MOD_META, MOD_CTRL, MOD_ALT, MOD_SHIFT,
    app_count, _app_index_by_name,
    launcher_app_has_scoped_ceiling_v1,
    launcher_app_scoped_ceiling_v1,
    launcher_commit_scoped_capabilities_v1
}
use os.services.launcher.launcher_association_registry.{
    launcher_validate_association_projection_v1
}
use os.services.launcher.launcher_catalog_projection.{
    launcher_replace_composition_catalog_v1,
    launcher_is_composition_owned_name_v1,
    launcher_is_composition_projection_active_v1
}
use os.kernel.loader.artifact_manifest.{
    manifest_kind_smf, manifest_kind_elf, manifest_kind_native_simple,
    manifest_for_kind, manifest_parse_scoped_capability_v1,
    manifest_project_scoped_capabilities_v1
}

class LauncherCompositionLoadV1:
    ok: bool
    code: text
    registered_count: i64
    failed_app_id: text

var composition_app_ids_v1: [text] = []
var composition_app_names_v1: [text] = []

class LauncherShortcutProjectionV1:
    ok: bool
    key: u32
    modifiers: u32

fn _project_shortcut_v1(shortcut: text) -> LauncherShortcutProjectionV1:
    if shortcut == "":
        return LauncherShortcutProjectionV1(ok: true, key: 0u32, modifiers: 0u32)
    val parts = shortcut.split("+")
    if parts.len() < 2:
        return LauncherShortcutProjectionV1(ok: false, key: 0u32, modifiers: 0u32)
    var modifiers = 0u32
    var i = 0
    while i < parts.len() - 1:
        val part = parts[i]
        if part == "Meta":
            modifiers = modifiers | MOD_META
        elif part == "Ctrl":
            modifiers = modifiers | MOD_CTRL
        elif part == "Alt":
            modifiers = modifiers | MOD_ALT
        elif part == "Shift":
            modifiers = modifiers | MOD_SHIFT
        else:
            return LauncherShortcutProjectionV1(ok: false, key: 0u32, modifiers: 0u32)
        i = i + 1
    val key_part = parts[parts.len() - 1]
    if key_part.len() != 1:
        return LauncherShortcutProjectionV1(ok: false, key: 0u32, modifiers: 0u32)
    val key = key_part.char_code_at(0)
    if key < 33 or key > 126:
        return LauncherShortcutProjectionV1(ok: false, key: 0u32, modifiers: 0u32)
    LauncherShortcutProjectionV1(ok: true, key: key.to_u32(), modifiers: modifiers)

fn _composition_name_seen_v1(image: SimpleCompositionImageV1, end: i64, name: text) -> bool:
    var i = 0
    while i < end:
        if image.apps[i].display_name == name:
            return true
        i = i + 1
    false

fn _composition_owned_name_v1(name: text) -> bool:
    launcher_is_composition_owned_name_v1(name)

fn _composition_manifest_kind_for_path_v1(path: text) -> text:
    if path.ends_with(".smf"):
        return manifest_kind_smf()
    if path.ends_with(".elf") or path.ends_with(".bin"):
        return manifest_kind_elf()
    if path.ends_with(".app") or path.ends_with(".native"):
        return manifest_kind_native_simple()
    ""

fn _launcher_commit_composition_v1(image: SimpleCompositionImageV1) -> LauncherCompositionLoadV1:
    if not launcher_is_composition_projection_active_v1():
        composition_app_ids_v1 = []
        composition_app_names_v1 = []
    # Validate all records, typed scoped capabilities, shortcuts, and associations
    # completely before delegating atomic replacement to launcher_catalog_projection.
    var next_ids: [text] = []
    var next_names: [text] = []
    var next_paths: [text] = []
    var next_icons: [text] = []
    var next_keys: [u32] = []
    var next_mods: [u32] = []
    var cap_specs_joined: [text] = []
    var cap_masks: [u32] = []
    var association_keys: [text] = []
    var association_paths: [text] = []

    var checked = 0
    while checked < image.apps.len():
        val candidate = image.apps[checked]
        if candidate.app_id == "" or candidate.display_name == "" or candidate.artifact_path == "":
            return LauncherCompositionLoadV1(ok: false, code: "SCI_LAUNCHER_RECORD", registered_count: 0, failed_app_id: candidate.app_id)
        var projected_joined = ""
        var projected_mask = 0u32
        if candidate.capabilities.len() > 0:
            if not launcher_app_has_scoped_ceiling_v1(candidate.app_id):
                return LauncherCompositionLoadV1(ok: false, code: "SCI_LAUNCHER_MANIFEST_CAPABILITY_PROJECTION_REQUIRED", registered_count: 0, failed_app_id: candidate.app_id)
            for raw_cap in candidate.capabilities:
                val parsed = manifest_parse_scoped_capability_v1(raw_cap)
                if not parsed.ok:
                    return LauncherCompositionLoadV1(ok: false, code: "SCI_LAUNCHER_CAPABILITY_INVALID", registered_count: 0, failed_app_id: candidate.app_id)
            val kind = _composition_manifest_kind_for_path_v1(candidate.artifact_path)
            if kind == "":
                return LauncherCompositionLoadV1(ok: false, code: "SCI_LAUNCHER_CAPABILITY_INVALID", registered_count: 0, failed_app_id: candidate.app_id)
            val ceiling = launcher_app_scoped_ceiling_v1(candidate.app_id)
            val proj = manifest_project_scoped_capabilities_v1(manifest_for_kind(kind), candidate.capabilities, ceiling)
            if not proj.ok:
                return LauncherCompositionLoadV1(ok: false, code: "SCI_LAUNCHER_CAPABILITY_EXCEEDS_CEILING", registered_count: 0, failed_app_id: candidate.app_id)
            var canonical_caps: [text] = []
            for pcap in proj.projected:
                canonical_caps.push(pcap.raw)
            projected_joined = canonical_caps.join("\n")
            projected_mask = proj.projected_mask
        val projected_shortcut = _project_shortcut_v1(candidate.shortcut)
        if not projected_shortcut.ok:
            return LauncherCompositionLoadV1(ok: false, code: "SCI_LAUNCHER_SHORTCUT_INVALID", registered_count: 0, failed_app_id: candidate.app_id)
        if (_app_index_by_name(candidate.display_name) >= 0 and not _composition_owned_name_v1(candidate.display_name)) or _composition_name_seen_v1(image, checked, candidate.display_name):
            return LauncherCompositionLoadV1(ok: false, code: "SCI_LAUNCHER_DUPLICATE_NAME", registered_count: 0, failed_app_id: candidate.app_id)
        next_ids.push(candidate.app_id)
        next_names.push(candidate.display_name)
        next_paths.push(candidate.artifact_path)
        next_icons.push(candidate.icon)
        next_keys.push(projected_shortcut.key)
        next_mods.push(projected_shortcut.modifiers)
        cap_specs_joined.push(projected_joined)
        cap_masks.push(projected_mask)
        var assoc_index = 0
        while assoc_index < candidate.associations.len():
            association_keys.push(candidate.associations[assoc_index])
            association_paths.push(candidate.artifact_path)
            assoc_index = assoc_index + 1
        checked = checked + 1

    val replace_code = launcher_replace_composition_catalog_v1(
        next_ids,
        next_names,
        next_paths,
        next_icons,
        next_keys,
        next_mods,
        association_keys,
        association_paths
    )
    if replace_code != "SCI_LAUNCHER_OK":
        return LauncherCompositionLoadV1(ok: false, code: replace_code, registered_count: 0, failed_app_id: "")

    launcher_commit_scoped_capabilities_v1(next_ids, cap_specs_joined, cap_masks)
    composition_app_ids_v1 = next_ids
    composition_app_names_v1 = next_names
    LauncherCompositionLoadV1(ok: true, code: "SCI_LAUNCHER_OK", registered_count: next_ids.len() as i64, failed_app_id: "")

fn launcher_load_composition_bytes_v1(data: [u8]) -> LauncherCompositionLoadV1:
    val admitted = decode_composition_image_v1(data)
    if not admitted.ok:
        return LauncherCompositionLoadV1(ok: false, code: admitted.diagnostic.code, registered_count: 0, failed_app_id: "")
    _launcher_commit_composition_v1(admitted.image)

export LauncherCompositionLoadV1, launcher_load_composition_bytes_v1, composition_app_ids_v1, composition_app_names_v1
