# Launcher-owned process artifact gate; never falls back to shell/PATH.
use os.packages.process_tool_package_identity.{
    process_tool_package_identity_v1,
    process_tool_package_identity_blocked_v1
}
use os.services.launcher.primary_tool_artifact_gate.{
    LauncherPrimaryToolResultV1,
    primary_tool_blocked_result_v1,
    primary_tool_unknown_result_v1,
    LAUNCHER_PRIMARY_TOOL_BLOCKED,
    LAUNCHER_PRIMARY_TOOL_UNKNOWN
}

pub const LAUNCHER_PROCESS_TOOL_BLOCKED: i32 = LAUNCHER_PRIMARY_TOOL_BLOCKED
pub const LAUNCHER_PROCESS_TOOL_UNKNOWN: i32 = LAUNCHER_PRIMARY_TOOL_UNKNOWN

pub fn launcher_dispatch_process_tool_v1(
    command: text,
    _args: [text]
) -> LauncherPrimaryToolResultV1:
    val identity = process_tool_package_identity_v1(command)
    match identity:
        case Err(_):
            primary_tool_unknown_result_v1("PROCESS_TOOL_COMMAND_UNKNOWN")
        case Ok(package):
            if not process_tool_package_identity_blocked_v1(package):
                return primary_tool_blocked_result_v1(
                    "PROCESS_TOOL_PACKAGE_IDENTITY_INVALID",
                    package.artifact.canonical_path,
                    "",
                    "",
                )
            primary_tool_blocked_result_v1(
                "PROCESS_TOOL_TARGET_ARTIFACT_TOKEN_UNAVAILABLE",
                package.artifact.canonical_path,
                package.artifact_digest,
                package.admission_receipt_id,
            )
