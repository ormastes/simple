# Process Manager Service — ECS-based process lifecycle management
#
# Owns the process table via ECS components. Handles fork/exec/exit/wait
# for SimpleOS userland processes. IPC handlers are intentionally absent
# from this module (G3 scope); they will be wired by the init service.
#
# PORT MODEL (PMSVC increment, mirrors the TERM change in tty_service.spl):
# this module declares NO `extern fn`. The three kernel-side effects PM used
# to invoke directly — signal delivery, ELF/SMF image loading and VMM COW
# clone — are only resolvable in-guest, so calling them from here made every
# PM path unverifiable (and failing) on host. PM now RECORDS each effect as an
# intent in an in-module outbox and exposes a drain accessor. The kernel-side
# consumer (which declares its own `signal_deliver` / `loader_exec` /
# `vmm_cow_clone` externs) drains the outbox, performs the real effect, and
# reports the result back:
#
#   signal   record in pm_exit / pm_kill  -> pm_take_pending_signal()
#   exec     record in pm_exec            -> pm_take_pending_exec()   -> pm_exec_complete()
#   vmclone  record in pm_fork            -> pm_take_pending_vm_clone() -> pm_bind_vmspace()

use std.ecs.entity.{Entity, EntityAllocator}
use std.ecs.component_store.{ComponentStore}
use std.ecs.change_detection.{ChangeTracker}
use std.ecs.world.{WorldBase}

# ============================================================================
# Errno constants (negative POSIX-ish values)
# ============================================================================

val ESRCH:  i32 = 3    # No such process
val ECHILD: i32 = 10   # No child process
val EAGAIN: i32 = 11   # Try again

# ============================================================================
# Signal constants
# ============================================================================

val SIGCHLD: i32 = 17

# ============================================================================
# Process state constants
# ============================================================================

val PS_RUNNING: u32 = 0
val PS_ZOMBIE:  u32 = 1
val PS_STOPPED: u32 = 2

# ============================================================================
# Outbound effect records (drained by the kernel-side consumer)
# ============================================================================

struct SignalIntent:
    """A signal PM decided to send. target_pid 0 / signo 0 == "outbox empty"."""
    target_pid: u64
    signo: i32

struct ExecRequest:
    """An image load PM decided to perform, with the target address space."""
    pid: u32
    path: str
    argv: [str]
    envp: [str]
    pml4: u64
    vmspace_id: u64

struct VmCloneRequest:
    """A COW address-space clone owed to a freshly forked child."""
    child_pid: u32
    parent_pml4: u64
    parent_vmspace_id: u64

# ============================================================================
# ECS Component types (POD)
# ============================================================================

struct Pid:
    """ECS component: the process identifier."""
    value: u32

struct ParentPid:
    """ECS component: the parent process identifier (0 for init)."""
    value: u32

struct ExecImage:
    """ECS component: the loaded executable path and entry-point vaddr."""
    path: str
    entry: u64

struct Creds:
    """ECS component: process credentials."""
    uid: u32
    gid: u32

struct ExitStatus:
    """ECS component: exit code and whether the zombie was reaped."""
    code: i32
    reaped: bool

struct ProcessState:
    """ECS component: current lifecycle state."""
    state: u32

struct SigState:
    """ECS component: fast-path signal mask shadow (authoritative in signal subsystem)."""
    pending_mask: u64
    blocked_mask: u64

struct Endpoint:
    """ECS component: IPC port for the process."""
    port_id: u64

struct VmSpaceRef:
    """ECS component: handle to the kernel-owned address space (PM does not own it)."""
    pml4: u64
    id: u64

# ============================================================================
# PmWorld — ECS container for all process components
# ============================================================================

class PmWorld:
    """ECS world owning all process component stores."""
    base: WorldBase
    pids: ComponentStore<Pid>
    parents: ComponentStore<ParentPid>
    exec_images: ComponentStore<ExecImage>
    creds: ComponentStore<Creds>
    exit_statuses: ComponentStore<ExitStatus>
    states: ComponentStore<ProcessState>
    sig_states: ComponentStore<SigState>
    endpoints: ComponentStore<Endpoint>
    vmspaces: ComponentStore<VmSpaceRef>

impl PmWorld:
    static fn new() -> PmWorld:
        PmWorld(
            base: WorldBase.new(),
            pids: ComponentStore.new(),
            parents: ComponentStore.new(),
            exec_images: ComponentStore.new(),
            creds: ComponentStore.new(),
            exit_statuses: ComponentStore.new(),
            states: ComponentStore.new(),
            sig_states: ComponentStore.new(),
            endpoints: ComponentStore.new(),
            vmspaces: ComponentStore.new()
        )

    me spawn_process(pid: u32, parent_pid: u32, uid: u32, gid: u32, pml4: u64, vmspace_id: u64) -> Entity:
        """Spawn a new entity and insert all initial process components."""
        val e = self.base.spawn()
        val tick = self.base.now()
        self.pids.insert(e, Pid(value: pid), tick)
        self.parents.insert(e, ParentPid(value: parent_pid), tick)
        self.creds.insert(e, Creds(uid: uid, gid: gid), tick)
        self.exit_statuses.insert(e, ExitStatus(code: 0, reaped: false), tick)
        self.states.insert(e, ProcessState(state: PS_RUNNING), tick)
        self.sig_states.insert(e, SigState(pending_mask: 0, blocked_mask: 0), tick)
        self.endpoints.insert(e, Endpoint(port_id: 0), tick)
        self.vmspaces.insert(e, VmSpaceRef(pml4: pml4, id: vmspace_id), tick)
        e

    fn find_entity_for_pid(self, pid: u32) -> Entity:
        """Linear scan of pids store. Returns Entity.null() if not found."""
        var i: i32 = 0
        while i < self.pids.len():
            if self.pids.dense[i].value == pid:
                val ent_id = self.pids.entity_at(i)
                return Entity(id: ent_id, generation: 0)
            i = i + 1
        Entity.null()

    fn pid_for_entity(self, e: Entity) -> u32:
        """Return the Pid component value for entity e. Returns 0 if not found."""
        val slot = self.pids.get_slot(e)
        if slot < 0:
            return 0
        self.pids.dense[slot].value

    fn parent_pid_for_entity(self, e: Entity) -> u32:
        """Return the ParentPid component value for entity e. Returns 0 if not found."""
        val slot = self.parents.get_slot(e)
        if slot < 0:
            return 0
        self.parents.dense[slot].value

    fn state_for_entity(self, e: Entity) -> u32:
        val slot = self.states.get_slot(e)
        if slot < 0:
            return PS_RUNNING
        self.states.dense[slot].state

    fn exit_status_for_entity(self, e: Entity) -> ExitStatus:
        val slot = self.exit_statuses.get_slot(e)
        if slot < 0:
            return ExitStatus(code: 0, reaped: false)
        self.exit_statuses.dense[slot]

    fn exec_image_for_entity(self, e: Entity) -> ExecImage:
        """Return the loaded ExecImage for e. Returns an empty image if none."""
        val slot = self.exec_images.get_slot(e)
        if slot < 0:
            return ExecImage(path: "", entry: 0)
        self.exec_images.dense[slot]

    fn pending_mask_for_entity(self, e: Entity) -> u64:
        """Return the fast-path pending signal mask shadow (0 if not found)."""
        val slot = self.sig_states.get_slot(e)
        if slot < 0:
            return 0
        self.sig_states.dense[slot].pending_mask

    fn creds_for_entity(self, e: Entity) -> Creds:
        val slot = self.creds.get_slot(e)
        if slot < 0:
            return Creds(uid: 0, gid: 0)
        self.creds.dense[slot]

    fn vmspace_for_entity(self, e: Entity) -> VmSpaceRef:
        val slot = self.vmspaces.get_slot(e)
        if slot < 0:
            return VmSpaceRef(pml4: 0, id: 0)
        self.vmspaces.dense[slot]

    fn endpoint_for_entity(self, e: Entity) -> u64:
        val slot = self.endpoints.get_slot(e)
        if slot < 0:
            return 0
        self.endpoints.dense[slot].port_id

# ============================================================================
# PmService — outer process manager
# ============================================================================

pub class PmService:
    """Process manager: lifecycle + table for SimpleOS userland processes."""
    world: PmWorld
    next_pid: u32     # monotonic counter; pid 1 is init, starts at 2
    initialized: bool
    # Outboxes: append-only logs of effects owed to the kernel-side consumer.
    # The `*_head` cursors mark how much has been drained; entries are kept so
    # the full history stays observable for auditing/tests.
    signal_outbox: [SignalIntent]
    signal_head: i32
    exec_outbox: [ExecRequest]
    exec_head: i32
    vm_clone_outbox: [VmCloneRequest]
    vm_clone_head: i32

impl PmService:
    pub static fn new() -> PmService:
        PmService(
            world: PmWorld.new(),
            next_pid: 2,
            initialized: false,
            signal_outbox: [],
            signal_head: 0,
            exec_outbox: [],
            exec_head: 0,
            vm_clone_outbox: [],
            vm_clone_head: 0
        )

    pub me pm_init() -> bool:
        """Initialize the PM: create the pid-1 init entity with ParentPid=0."""
        if self.initialized:
            return true
        # Spawn init: pid=1, parent=0, uid=0, gid=0, pml4=0, vmspace_id=0
        self.world.spawn_process(1, 0, 0, 0, 0, 0)
        self.initialized = true
        true

    pub fn pm_pid_is_live(pid: u32) -> bool:
        """Return true only for a process entity whose state is RUNNING."""
        if not self.initialized:
            return false
        val entity = self.world.find_entity_for_pid(pid)
        if entity.is_null():
            return false
        self.world.state_for_entity(entity) == PS_RUNNING

    me pm_fork(self, parent_pid: u32) -> i32:
        """Fork a child from parent_pid. Returns new pid or negative errno.

        Allocates a child entity cloning parent's creds/endpoint and assigns
        next_pid. The child's VmSpaceRef starts UNBOUND (pml4 = 0) and a
        VmCloneRequest is recorded; the kernel-side consumer drains it, runs
        the real vmm_cow_clone, and calls pm_bind_vmspace with the result.
        Returns -ECHILD if parent not found.
        """
        val parent_e = self.world.find_entity_for_pid(parent_pid)
        if parent_e.is_null():
            return -ECHILD

        val parent_creds = self.world.creds_for_entity(parent_e)
        val parent_vmref = self.world.vmspace_for_entity(parent_e)
        val parent_endpoint = self.world.endpoint_for_entity(parent_e)

        val child_pid = self.next_pid
        self.next_pid = self.next_pid + 1

        # Record the COW clone owed to this child (kernel-side consumer drains).
        self.vm_clone_outbox = self.vm_clone_outbox.push(VmCloneRequest(
            child_pid: child_pid,
            parent_pml4: parent_vmref.pml4,
            parent_vmspace_id: parent_vmref.id
        ))

        val tick = self.world.base.now()
        # two-hop mutation workaround: bug selfhost_two_hop_field_method_mutation_lost_2026-07-27
        var base_s = self.world.base
        val child_e = base_s.spawn()
        self.world.base = base_s
        var pids_s = self.world.pids
        pids_s.insert(child_e, Pid(value: child_pid), tick)
        self.world.pids = pids_s
        var parents_s = self.world.parents
        parents_s.insert(child_e, ParentPid(value: parent_pid), tick)
        self.world.parents = parents_s
        var creds_s = self.world.creds
        creds_s.insert(child_e, Creds(uid: parent_creds.uid, gid: parent_creds.gid), tick)
        self.world.creds = creds_s
        var exit_statuses_s = self.world.exit_statuses
        exit_statuses_s.insert(child_e, ExitStatus(code: 0, reaped: false), tick)
        self.world.exit_statuses = exit_statuses_s
        var states_s = self.world.states
        states_s.insert(child_e, ProcessState(state: PS_RUNNING), tick)
        self.world.states = states_s
        var sig_states_s = self.world.sig_states
        sig_states_s.insert(child_e, SigState(pending_mask: 0, blocked_mask: 0), tick)
        self.world.sig_states = sig_states_s
        var endpoints_s = self.world.endpoints
        endpoints_s.insert(child_e, Endpoint(port_id: parent_endpoint), tick)
        self.world.endpoints = endpoints_s
        var vmspaces_s = self.world.vmspaces
        vmspaces_s.insert(child_e, VmSpaceRef(pml4: 0, id: parent_vmref.id), tick)
        self.world.vmspaces = vmspaces_s

        child_pid.to_i32()

    me pm_exec(self, pid: u32, path: str, argv: [str], envp: [str]) -> i32:
        """Accept a request to load a new image into pid's address space.

        Records an ExecRequest carrying the target address space; the
        kernel-side consumer drains it with pm_take_pending_exec, runs the
        real loader_exec, and reports the resolved entry vaddr (or a negative
        errno) back through pm_exec_complete.

        Returns 0 when the request is accepted, or -ESRCH for an unknown pid.
        """
        val e = self.world.find_entity_for_pid(pid)
        if e.is_null():
            return -ESRCH

        val vmref = self.world.vmspace_for_entity(e)
        self.exec_outbox = self.exec_outbox.push(ExecRequest(
            pid: pid,
            path: path,
            argv: argv,
            envp: envp,
            pml4: vmref.pml4,
            vmspace_id: vmref.id
        ))
        0

    me pm_exec_complete(self, pid: u32, path: str, entry: i64) -> i32:
        """Apply the loader's verdict for a previously accepted pm_exec.

        `entry` is the resolved entry vaddr, or a negative errno if the load
        failed. On success records the ExecImage and resets state to
        PS_RUNNING; on failure the process table is left untouched and the
        errno is propagated. Returns 0 on success, negative errno otherwise.
        """
        val e = self.world.find_entity_for_pid(pid)
        if e.is_null():
            return -ESRCH
        if entry < 0:
            return entry.to_i32()

        val tick = self.world.base.now()
        # two-hop mutation workaround: bug selfhost_two_hop_field_method_mutation_lost_2026-07-27
        var exec_images_s = self.world.exec_images
        exec_images_s.insert(e, ExecImage(path: path, entry: entry.to_u64()), tick)
        self.world.exec_images = exec_images_s
        var states_s = self.world.states
        states_s.insert(e, ProcessState(state: PS_RUNNING), tick)
        self.world.states = states_s
        0

    me pm_waitpid(self, parent_pid: u32, child_pid: u32) -> i32:
        """Wait for child_pid (must be a child of parent_pid) to exit.

        Returns exit code if zombie, -EAGAIN if still running,
        -ECHILD if not a child of parent_pid or already reaped.

        Marks reaped=true on first successful wait (one-shot).
        """
        val child_e = self.world.find_entity_for_pid(child_pid)
        if child_e.is_null():
            return -ECHILD

        # Verify child's parent is parent_pid
        val actual_parent = self.world.parent_pid_for_entity(child_e)
        if actual_parent != parent_pid:
            return -ECHILD

        val status = self.world.exit_status_for_entity(child_e)

        # Already reaped?
        if status.reaped:
            return -ECHILD

        val state = self.world.state_for_entity(child_e)
        if state != PS_ZOMBIE:
            return -EAGAIN

        # Reap it
        val tick = self.world.base.now()
        # two-hop mutation workaround: bug selfhost_two_hop_field_method_mutation_lost_2026-07-27
        var exit_statuses_s = self.world.exit_statuses
        exit_statuses_s.insert(child_e, ExitStatus(code: status.code, reaped: true), tick)
        self.world.exit_statuses = exit_statuses_s
        status.code

    me pm_exit(self, pid: u32, code: i32):
        """Mark process as zombie with exit code; notify parent via SIGCHLD.

        If parent exists (parent_pid > 0), records a SIGCHLD SignalIntent
        aimed at the parent for the kernel-side consumer to deliver.
        """
        val e = self.world.find_entity_for_pid(pid)
        if e.is_null():
            return

        val tick = self.world.base.now()
        # two-hop mutation workaround: bug selfhost_two_hop_field_method_mutation_lost_2026-07-27
        var exit_statuses_s = self.world.exit_statuses
        exit_statuses_s.insert(e, ExitStatus(code: code, reaped: false), tick)
        self.world.exit_statuses = exit_statuses_s
        var states_s = self.world.states
        states_s.insert(e, ProcessState(state: PS_ZOMBIE), tick)
        self.world.states = states_s

        # Notify parent: record SIGCHLD for the kernel-side consumer to deliver.
        val parent_pid = self.world.parent_pid_for_entity(e)
        if parent_pid > 0:
            self.signal_outbox = self.signal_outbox.push(
                SignalIntent(target_pid: parent_pid.to_u64(), signo: SIGCHLD))

    me pm_kill(self, target_pid: u32, signo: i32) -> i32:
        """Queue signo for target_pid. Returns 0 on success or -ESRCH if not found.

        Sets the fast-path pending_mask shadow and records a SignalIntent for
        the kernel-side consumer to deliver.
        """
        val e = self.world.find_entity_for_pid(target_pid)
        if e.is_null():
            return -ESRCH

        # Bump local pending_mask shadow for fast-path checks
        val tick = self.world.base.now()
        val ss_slot = self.world.sig_states.get_slot(e)
        if ss_slot >= 0:
            val cur = self.world.sig_states.dense[ss_slot]
            val bit = 1.to_u64() << signo.to_u64()
            # two-hop mutation workaround: bug selfhost_two_hop_field_method_mutation_lost_2026-07-27
            var sig_states_s = self.world.sig_states
            sig_states_s.insert(e, SigState(pending_mask: cur.pending_mask | bit, blocked_mask: cur.blocked_mask), tick)
            self.world.sig_states = sig_states_s

        self.signal_outbox = self.signal_outbox.push(
            SignalIntent(target_pid: target_pid.to_u64(), signo: signo))
        0

    # ------------------------------------------------------------------
    # Outbox accessors / drains (kernel-side consumer + host verification)
    # ------------------------------------------------------------------

    fn pm_signal_count(self) -> i32:
        """Total signals PM has decided to send since construction."""
        self.signal_outbox.len()

    fn pm_last_signal_pid(self) -> u64:
        """Target pid of the most recently recorded signal (0 if none)."""
        val n = self.signal_outbox.len()
        if n <= 0:
            return 0
        self.signal_outbox[n - 1].target_pid

    fn pm_last_signal_signo(self) -> i32:
        """Signal number of the most recently recorded signal (0 if none)."""
        val n = self.signal_outbox.len()
        if n <= 0:
            return 0
        self.signal_outbox[n - 1].signo

    me pm_take_pending_signal(self) -> SignalIntent:
        """Drain the next undelivered signal. signo == 0 means the outbox is empty."""
        if self.signal_head >= self.signal_outbox.len():
            return SignalIntent(target_pid: 0, signo: 0)
        val out = self.signal_outbox[self.signal_head]
        self.signal_head = self.signal_head + 1
        out

    fn pm_exec_request_count(self) -> i32:
        """Total exec requests PM has accepted since construction."""
        self.exec_outbox.len()

    me pm_take_pending_exec(self) -> ExecRequest:
        """Drain the next unserviced exec request. pid == 0 means empty."""
        if self.exec_head >= self.exec_outbox.len():
            return ExecRequest(pid: 0, path: "", argv: [], envp: [], pml4: 0, vmspace_id: 0)
        val out = self.exec_outbox[self.exec_head]
        self.exec_head = self.exec_head + 1
        out

    fn pm_vm_clone_request_count(self) -> i32:
        """Total COW-clone requests owed to forked children since construction."""
        self.vm_clone_outbox.len()

    me pm_take_pending_vm_clone(self) -> VmCloneRequest:
        """Drain the next unserviced COW clone request. child_pid == 0 means empty."""
        if self.vm_clone_head >= self.vm_clone_outbox.len():
            return VmCloneRequest(child_pid: 0, parent_pml4: 0, parent_vmspace_id: 0)
        val out = self.vm_clone_outbox[self.vm_clone_head]
        self.vm_clone_head = self.vm_clone_head + 1
        out

    me pm_bind_vmspace(self, pid: u32, pml4: u64, vmspace_id: u64) -> bool:
        """Bind the address space the kernel produced for pid. False if unknown pid."""
        val e = self.world.find_entity_for_pid(pid)
        if e.is_null():
            return false
        val tick = self.world.base.now()
        # two-hop mutation workaround: bug selfhost_two_hop_field_method_mutation_lost_2026-07-27
        var vmspaces_s = self.world.vmspaces
        vmspaces_s.insert(e, VmSpaceRef(pml4: pml4, id: vmspace_id), tick)
        self.world.vmspaces = vmspaces_s
        true

    fn pm_get_pid(self, entity_id: i32) -> u32:
        """Return the pid for an entity by raw id. Returns 0 if not found."""
        val e = Entity(id: entity_id, generation: 0)
        self.world.pid_for_entity(e)

    fn pm_find_entity(self, pid: u32) -> Entity:
        """Find entity by pid. Returns Entity.null() if not found."""
        self.world.find_entity_for_pid(pid)

    fn pm_process_count(self) -> i32:
        """Return the total number of tracked processes."""
        self.world.pids.len()
