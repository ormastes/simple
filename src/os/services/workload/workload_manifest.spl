# Workload manifest — the shared typed policy contract for services, agents,
# and containers.
#
# Policy strings are a control-plane input only.  This module compiles them
# into typed `CapGrant` records and a `SpawnSpec`; the live scheduler is the
# only component permitted to mint the resulting CSpace.  No role string,
# profile name, or manifest path is itself kernel authority.

use os.kernel.ipc.cspace_spawn.{SpawnSpec, CapGrant}
use os.kernel.loader.workload_image_hash.{workload_image_hash_is_canonical}

pub struct WorkloadIdentitySpec:
    principal_id: text
    tenant_id: text
    image_hash: text
    signer: text
    parent_principal: text
    expires_at_ms: u64

pub struct ImageSpec:
    executable_path: text
    content_hash: text
    signer: text

pub struct AuthorityRequest:
    grants: [CapGrant]

pub struct IsolationSpec:
    filesystem_view: text
    process_view: text
    ipc_view: text
    network_view: text
    syscall_allowlist: [u64]

pub struct ResourceBudget:
    cpu_weight: u64
    memory_pages: u64
    process_limit: u64
    io_weight: u64
    network_bytes: u64
    wall_time_ms: u64

pub val WORKLOAD_CPU_WEIGHT_MAX: u64 = 4096u64

pub struct LifecyclePolicy:
    restart_policy: text
    max_restarts: u64
    watchdog_timeout_ms: u64

pub struct ObservabilityPolicy:
    audit_required: bool
    log_retention_ms: u64

pub struct WorkloadManifest:
    identity: WorkloadIdentitySpec
    image: ImageSpec
    authority: AuthorityRequest
    isolation: IsolationSpec
    resources: ResourceBudget
    lifecycle: LifecyclePolicy
    observability: ObservabilityPolicy

pub struct CompiledExecutionPolicy:
    spawn_spec: SpawnSpec
    image: ImageSpec
    syscall_filter: [u64]
    isolation_spec: IsolationSpec
    resource_spec: ResourceBudget
    identity: WorkloadIdentitySpec
    lifecycle: LifecyclePolicy
    observability: ObservabilityPolicy

fn _absolute_path(path: text) -> bool:
    path.len() > 1 and path.starts_with("/")

fn _filesystem_view_is_concrete(view: text) -> bool:
    """A live kernel filesystem view is an absolute root or deny-all.

    This deliberately rejects descriptive labels such as `workspace` and
    `container`; the policy compiler must receive the actual resolved root.
    """
    if view == "none":
        return true
    view.starts_with("/") and view.contains("//") == false and
        view.contains("/../") == false and view.ends_with("/..") == false

fn _has_duplicate_grant_label(grants: [CapGrant]) -> bool:
    var i: u64 = 0u64
    while i < grants.len():
        if grants[i].label == "":
            return true
        var j = i + 1u64
        while j < grants.len():
            if grants[i].label == grants[j].label:
                return true
            j = j + 1u64
        i = i + 1u64
    false

fn _has_duplicate_syscall(syscalls: [u64]) -> bool:
    var i: u64 = 0u64
    while i < syscalls.len():
        var j = i + 1u64
        while j < syscalls.len():
            if syscalls[i] == syscalls[j]:
                return true
            j = j + 1u64
        i = i + 1u64
    false

pub fn compile_workload_manifest(manifest: WorkloadManifest) -> Result<CompiledExecutionPolicy, text>:
    """Validate a declarative workload request into an immutable execution policy.

    This is deliberately an all-or-nothing compile step.  It does not mint
    rights: runtime launch intersects `spawn_spec` with the parent CSpace and
    rejects every incomplete mint.  Keeping those operations separate makes a
    policy document incapable of granting authority by itself.
    """
    if manifest.identity.principal_id == "" or manifest.identity.tenant_id == "":
        return Err("workload identity requires principal and tenant")
    if manifest.identity.image_hash == "" or manifest.image.content_hash == "":
        return Err("workload image hash is required")
    if manifest.identity.image_hash != manifest.image.content_hash:
        return Err("workload identity/image hash mismatch")
    if not workload_image_hash_is_canonical(manifest.image.content_hash):
        return Err("workload image hash must be canonical blake3")
    if not _absolute_path(manifest.image.executable_path):
        return Err("workload executable path must be absolute")
    if not _filesystem_view_is_concrete(manifest.isolation.filesystem_view):
        return Err("workload filesystem view must be an absolute root or none")
    if manifest.resources.process_limit == 0u64 or manifest.resources.memory_pages == 0u64 or
        manifest.resources.cpu_weight == 0u64 or
        manifest.resources.cpu_weight > WORKLOAD_CPU_WEIGHT_MAX:
        return Err("workload requires bounded process, memory, and CPU limits")
    if _has_duplicate_grant_label(manifest.authority.grants):
        return Err("workload authority has empty or duplicate grant labels")
    if manifest.isolation.syscall_allowlist.len() == 0:
        return Err("workload requires an explicit syscall allowlist")
    if _has_duplicate_syscall(manifest.isolation.syscall_allowlist):
        return Err("workload syscall filter has duplicate entries")
    if manifest.observability.audit_required and manifest.observability.log_retention_ms == 0u64:
        return Err("audited workload requires log retention")

    Ok(CompiledExecutionPolicy(
        spawn_spec: SpawnSpec(
            image_hash: manifest.image.content_hash,
            grants: manifest.authority.grants,
            isolation: manifest.isolation.process_view,
            budget: manifest.resources.process_limit
        ),
        image: manifest.image,
        syscall_filter: manifest.isolation.syscall_allowlist,
        isolation_spec: manifest.isolation,
        resource_spec: manifest.resources,
        identity: manifest.identity,
        lifecycle: manifest.lifecycle,
        observability: manifest.observability
    ))
