# Network Stack Service -- User-Space TCP/IP on IPC Port 2
#
# MDSOC: feature dimension, network layer
# Owns the VirtIO-net driver in-process (exokernel/libOS pattern).
# Receives raw Ethernet frames, processes through protocol layers
# (ARP, IPv4, ICMP, TCP, UDP), and delivers to application sockets.
# Receives IPC requests from applications for socket operations.
#
# Wire protocol (IPC):
#   Request:  method(u32) | payload(bytes)
#   Response: status(i32) | payload(bytes)

# Split into the _NetstackService/ folder to keep module cohesion under the 800-line source limit.
export use os.services.netstack._NetstackService.service_struct.{unsafe_addr_of, NET_SOCKET, NET_BIND, NET_LISTEN, NET_CONNECT, NET_ACCEPT, NET_SEND, NET_RECV, NET_CLOSE, NET_IFCONFIG, SYS_IPC_SEND, SYS_IPC_RECV, SYS_IPC_CREATE_PORT, STATUS_OK, STATUS_ERR, ERR_EINPROGRESS, ERR_ETIMEDOUT, ERR_ECONNREFUSED, ERR_ENETUNREACH, NET_CONNECT_FLAG_NONBLOCK, NET_CONNECT_WAIT_TICKS, DEFAULT_IP_A, DEFAULT_IP_B, DEFAULT_IP_C, DEFAULT_IP_D, DEFAULT_MASK_A, DEFAULT_MASK_B, DEFAULT_MASK_C, DEFAULT_MASK_D, DEFAULT_GW_A, DEFAULT_GW_B, DEFAULT_GW_C, DEFAULT_GW_D, ARP_TABLE_CAPACITY, RECV_BUF_SIZE, NEXT_CONN_ID_START, EPHEMERAL_PORT_START, EPHEMERAL_PORT_END, NetstackService}
export use os.services.netstack._NetstackService.frame_processing.{unsafe_addr_of}
export use os.services.netstack._NetstackService.ipc_handlers.{mmio_read8, mmio_read16, mmio_read32, mmio_read64}
export use os.services.netstack._NetstackService.proto_helpers.{unsafe_addr_of, IPC_COPIED_SERVICE_TAG}
