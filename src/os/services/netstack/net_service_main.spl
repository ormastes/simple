# Root-catalogue network service payload.
#
# The trusted root-service catalogue gives this task exactly one DeviceGrant.
# This entry consumes that opaque assignment rather than enumerating PCI or
# accepting a BDF/BAR address from process input.  The driver still performs
# its normal capability-checked MapBar/DMA operations after initialization.

use os.drivers.virtio.virtio_net.{VirtioNetDriver}
use os.services.netstack.netstack_service.{NetstackService}
use os.userlib.device.{request_assigned_device_grant}

fn net_service_main() -> i32:
    val grant_result = request_assigned_device_grant()
    if grant_result.is_err():
        return 1

    var driver = VirtioNetDriver.new()
    val initialized = driver.init_from_grant(grant_result.unwrap())
    if initialized.is_err():
        return 2

    # `start` binds the exact `net` endpoint authorized by the catalogue and
    # runs the owned-record IPC + packet polling loop until the job is stopped.
    var service = NetstackService.new(driver)
    service.start()
    0

fn main(argv: [text]) -> i32:
    net_service_main()
