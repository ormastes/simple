# Network Stack Boot Initialization
#
# MDSOC: feature dimension, network layer
# Mirrors vfs_init.spl pattern:
# PCI scan -> find VirtIO-net -> grant device -> init driver -> create netstack
#
# Called during kernel init. Sets up the complete network stack:
# 1. PCI manager finds VirtIO-net device
# 2. VirtIO-net driver initializes with DeviceGrant
# 3. NetstackService wraps the driver with TCP/IP protocol layers
# 4. Default IP configured for QEMU user-mode networking
# 5. NetstackService starts listening on IPC port 2

use os.drivers.virtio.virtio_net.{VirtioNetDriver}
use os.services.netstack.netstack_service.{NetstackService}
use os.services.netstack.ipv4.{Ipv4Address}
use os.kernel.log.klog_api.{log_raw_println}
use os.kernel.memory.vmm.{vmm_copy_bytes_result_ok}
use os.kernel.memory.user_copy.{user_copyin_bytes, user_copyout_bytes}
extern fn rt_pci_device_count() -> i64
extern fn rt_pci_get_field(index: i64, field: i64) -> i64
extern fn rt_net_init() -> i64
extern fn rt_net_tx_test() -> i64
extern fn rt_net_rx_ready() -> i64
extern fn rt_net_stats() -> i64
extern fn spl_shim_current_task_id() -> u64

val VIRTIO_VENDOR: u16 = 0x1AF4
val VIRTIO_DEV_NET: u16 = 0x1000

fn _decode_riscv_status(raw: i64) -> i64:
    # Some freestanding RV64 runtime status externs can surface small negative
    # errno-style values as 61-bit wrapped positives (2^61 - n). Normalize
    # them before comparing or logging so boot lanes fail on the real status.
    val wrapped_negative_floor = 1i64 << 60
    val wrapped_negative_span = 1i64 << 61
    if raw >= wrapped_negative_floor:
        return raw - wrapped_negative_span
    raw

# ============================================================================
# QEMU User-Mode Networking Defaults
# ============================================================================
# QEMU's -netdev user,id=net0 provides:
#   Guest IP:  10.0.2.15
#   Gateway:   10.0.2.2
#   DNS:       10.0.2.3
#   Subnet:    255.255.255.0

val QEMU_IP_A: u8 = 10
val QEMU_IP_B: u8 = 0
val QEMU_IP_C: u8 = 2
val QEMU_IP_D: u8 = 15

val QEMU_GW_A: u8 = 10
val QEMU_GW_B: u8 = 0
val QEMU_GW_C: u8 = 2
val QEMU_GW_D: u8 = 2

val QEMU_MASK_A: u8 = 255
val QEMU_MASK_B: u8 = 255
val QEMU_MASK_C: u8 = 255
val QEMU_MASK_D: u8 = 0

val PCI_CLASS_NETWORK: u8 = 0x02
val PCI_SUBCLASS_ETHERNET: u8 = 0x00

# ============================================================================
# Module-Level State
# ============================================================================

var g_netstack: NetstackService? = nil
var g_net_driver: VirtioNetDriver = VirtioNetDriver.new()
var g_net_initialized: bool = false

# ============================================================================
# Boot Init
# ============================================================================

fn net_boot_init() -> bool:
    """Initialize the network stack from PCI discovery.

    Steps:
    1. Find VirtIO-net device via PCI manager
       - Class 0x02 (network controller), subclass 0x00 (Ethernet)
       - Fallback: vendor 0x1AF4 (Red Hat), device 0x1000 (legacy virtio-net)
    2. Grant device resources (BAR0, IRQ, DMA)
    3. Initialize VirtIO-net driver
    4. Create NetstackService with the driver
    5. Configure IP for QEMU user-mode networking:
       - IP: 10.0.2.15, gateway: 10.0.2.2, subnet: 255.255.255.0

    Returns true if network stack is ready.
    """
    log_raw_println("[net-init] Starting network stack initialization...")

    # Step 1: Find a NIC from the freestanding PCI cache directly.
    # The live RV64 lane uses the C-backed network driver after discovery, so
    # avoid importing the hosted/user-space PCI manager path into this closure.
    log_raw_println("[net-init] Looking for VirtIO-net device via raw PCI cache...")
    var dev_idx: i64 = -1
    val count = rt_pci_device_count()
    var scan_idx: i64 = 0
    while scan_idx < count:
        val cls = rt_pci_get_field(scan_idx, 3)
        val sub = rt_pci_get_field(scan_idx, 4)
        if cls == 2 and sub == 0:
            dev_idx = scan_idx
            break
        scan_idx = scan_idx + 1

    if dev_idx < 0:
        log_raw_println("[net-init] No VirtIO-net device found -- network unavailable")
        return false
    log_raw_println("[net-init] Found VirtIO-net device at index {dev_idx}")

    # On baremetal, the C VirtIO-net driver (syscall 90) handles the NIC.
    # Do not assume C boot already did this for every entrypoint.
    log_raw_println("[net-init] Initializing C VirtIO-net driver via rt_net_init")
    val init_rc = _decode_riscv_status(rt_net_init())
    if init_rc < 0:
        log_raw_println("[net-init] C network init failed rc={init_rc}")
        return false

    val tx_ready = _decode_riscv_status(rt_net_tx_test())
    if tx_ready < 0:
        log_raw_println("[net-init] C network TX unavailable rc={tx_ready}")
        return false

    val rx_ready = _decode_riscv_status(rt_net_rx_ready())
    if rx_ready < 0:
        log_raw_println("[net-init] C network RX unavailable rc={rx_ready}")
        return false

    val stats = _decode_riscv_status(rt_net_stats())
    if stats < 0:
        log_raw_println("[net-init] C network stats probe failed rc={stats}")
        return false
    log_raw_println("[net-init] C network driver active")

    g_netstack = Some(NetstackService.new(g_net_driver))
    g_net_initialized = true
    log_raw_println("[net-init] Network stack ready (C-backed)")
    true

fn net_boot_init_arm64_mmio() -> bool:
    """Initialize QEMU ARM virt networking without changing PCI users."""
    log_raw_println("[net-init] ARM64 VirtIO-MMIO network initialization")
    g_arm64_net_fd_map = []
    g_arm64_net_fd_ready = true
    var driver = VirtioNetDriver.new()
    val initialized = driver.init_arm64_mmio()
    if initialized.is_err():
        log_raw_println("[net-init] ARM64 VirtIO-MMIO init failed: {initialized.unwrap_err()}")
        return false
    g_net_driver = driver
    var service = NetstackService.new(g_net_driver)
    service.init_kernel_transport()
    g_netstack = Some(service)
    g_net_initialized = true
    log_raw_println("[net-init] ARM64 VirtIO-MMIO network stack ready")
    true

# ===========================================================================
# ARM64 kernel-local syscall bridge
# ===========================================================================
# C dispatch reaches this bridge only after `spl_shim_net_capability_check`
# authorizes the current scheduler task through the canonical CapabilityManager.

struct Arm64NetFdMap:
    owner_task: u64
    external_fd: i32
    internal_fd: i32

val ARM64_NET_FD_CAPACITY: u64 = 64
val ARM64_NET_IO_MAX: u64 = 1048576
var g_arm64_net_fd_map: [Arm64NetFdMap] = []
var g_arm64_net_fd_ready: bool = false

fn _arm64_net_fd_ensure():
    if not g_arm64_net_fd_ready:
        g_arm64_net_fd_map = []
        g_arm64_net_fd_ready = true

fn _arm64_net_fd_reserve() -> i64:
    _arm64_net_fd_ensure()
    if g_arm64_net_fd_map.len() >= ARM64_NET_FD_CAPACITY:
        return -24
    # Choose the lowest free descriptor so close deterministically permits
    # reuse instead of exhausting a monotonic 64-entry namespace.
    var candidate: i32 = 100
    while candidate < 100 + ARM64_NET_FD_CAPACITY as i32:
        var used = false
        var i: u64 = 0
        while i < g_arm64_net_fd_map.len():
            if g_arm64_net_fd_map[i].owner_task == spl_shim_current_task_id() and g_arm64_net_fd_map[i].external_fd == candidate:
                used = true
            i = i + 1
        if not used:
            g_arm64_net_fd_map.push(Arm64NetFdMap(owner_task: spl_shim_current_task_id(), external_fd: candidate, internal_fd: -1))
            return candidate as i64
        candidate = candidate + 1
    -24

fn _arm64_net_fd_commit(external_fd: i32, internal_fd: i32) -> bool:
    var i: u64 = 0
    while i < g_arm64_net_fd_map.len():
        if g_arm64_net_fd_map[i].owner_task == spl_shim_current_task_id() and g_arm64_net_fd_map[i].external_fd == external_fd:
            g_arm64_net_fd_map[i] = Arm64NetFdMap(owner_task: spl_shim_current_task_id(), external_fd: external_fd, internal_fd: internal_fd)
            return true
        i = i + 1
    false

fn _arm64_net_fd_resolve(external_fd: i32) -> i32:
    var i: u64 = 0
    while i < g_arm64_net_fd_map.len():
        if g_arm64_net_fd_map[i].owner_task == spl_shim_current_task_id() and g_arm64_net_fd_map[i].external_fd == external_fd:
            return g_arm64_net_fd_map[i].internal_fd
        i = i + 1
    -1

fn _arm64_net_fd_remove(external_fd: i32) -> i32:
    var i: u64 = 0
    while i < g_arm64_net_fd_map.len():
        if g_arm64_net_fd_map[i].owner_task == spl_shim_current_task_id() and g_arm64_net_fd_map[i].external_fd == external_fd:
            val internal = g_arm64_net_fd_map[i].internal_fd
            g_arm64_net_fd_map.remove(i)
            return internal
        i = i + 1
    -4096

pub fn net_arm64_task_teardown(owner_task: u64):
    """Close and remove every direct socket owned by one exiting EL0 task."""
    var i: u64 = 0
    while i < g_arm64_net_fd_map.len():
        if g_arm64_net_fd_map[i].owner_task == owner_task:
            val internal = g_arm64_net_fd_map[i].internal_fd
            g_arm64_net_fd_map.remove(i)
            if internal >= 0:
                net_tcp_close(internal as i64)
        else:
            i = i + 1

struct Arm64SockaddrCopy:
    ip: u32
    port: u16

fn _arm64_copy_sockaddr(ptr: u64, len: u64) -> Result<Arm64SockaddrCopy, i64>:
    if len < 16:
        return Err(-14)
    val copied = user_copyin_bytes(ptr, 16)
    if not vmm_copy_bytes_result_ok(copied):
        return Err(-14)
    val bytes = copied.bytes
    val family = (bytes[0] as u16) | ((bytes[1] as u16) << 8)
    if family != 2:
        return Err(-22)
    val port = ((bytes[2] as u16) << 8) | (bytes[3] as u16)
    val ip = (bytes[4] as u32) | ((bytes[5] as u32) << 8) |
        ((bytes[6] as u32) << 16) | ((bytes[7] as u32) << 24)
    Ok(Arm64SockaddrCopy(ip: ip, port: port))

@export("C", name: "spl_arm64_net_socket_direct")
fn spl_arm64_net_socket_direct(domain: u64, type_: u64, protocol: u64, a3: u64, a4: u64, a5: u64) -> i64:
    if not g_net_initialized or domain != 2 or type_ != 1:
        return -22
    _arm64_net_fd_reserve()

@export("C", name: "spl_arm64_net_bind_direct")
fn spl_arm64_net_bind_direct(external: u64, ptr: u64, len: u64, a3: u64, a4: u64, a5: u64) -> i64:
    match _arm64_copy_sockaddr(ptr, len):
        Err(errno): errno
        Ok(pair):
            val internal = net_tcp_bind(pair.ip, pair.port, 16)
            if internal < 0:
                return internal
            if not _arm64_net_fd_commit(external as i32, internal as i32):
                net_tcp_close(internal)
                return -9
            0

@export("C", name: "spl_arm64_net_listen_direct")
fn spl_arm64_net_listen_direct(external: u64, backlog: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64:
    if _arm64_net_fd_resolve(external as i32) < 0: -9 else: 0

@export("C", name: "spl_arm64_net_accept_direct")
fn spl_arm64_net_accept_direct(external: u64, out_addr: u64, out_len: u64, a3: u64, a4: u64, a5: u64) -> i64:
    if out_addr != 0 or out_len != 0:
        return -95
    val listener = _arm64_net_fd_resolve(external as i32)
    if listener < 0:
        return -9
    val internal = net_tcp_accept(listener as i64)
    if internal < 0:
        return -11
    val accepted = _arm64_net_fd_reserve()
    if accepted < 0:
        net_tcp_close(internal)
        return accepted
    if not _arm64_net_fd_commit(accepted as i32, internal as i32):
        net_tcp_close(internal)
        _arm64_net_fd_remove(accepted as i32)
        return -24
    accepted

@export("C", name: "spl_arm64_net_connect_direct")
fn spl_arm64_net_connect_direct(external: u64, ptr: u64, len: u64, a3: u64, a4: u64, a5: u64) -> i64:
    match _arm64_copy_sockaddr(ptr, len):
        Err(errno): errno
        Ok(pair):
            val internal = net_tcp_connect(pair.ip, pair.port, 200000)
            if internal < 0:
                return internal
            if not _arm64_net_fd_commit(external as i32, internal as i32):
                net_tcp_close(internal)
                return -9
            0

@export("C", name: "spl_arm64_net_send_direct")
fn spl_arm64_net_send_direct(external: u64, ptr: u64, len: u64, dest: u64, dest_len: u64, flags: u64) -> i64:
    if dest != 0 or dest_len != 0 or len > ARM64_NET_IO_MAX:
        return -95
    val internal = _arm64_net_fd_resolve(external as i32)
    if internal < 0:
        return -9
    val copied = user_copyin_bytes(ptr, len)
    if not vmm_copy_bytes_result_ok(copied):
        return -14
    net_tcp_write(internal as i64, copied.bytes)

@export("C", name: "spl_arm64_net_recv_direct")
fn spl_arm64_net_recv_direct(external: u64, ptr: u64, max: u64, src: u64, src_len: u64, flags: u64) -> i64:
    if src != 0 or src_len != 0 or max > ARM64_NET_IO_MAX:
        return -95
    val internal = _arm64_net_fd_resolve(external as i32)
    if internal < 0:
        return -9
    val bytes = net_tcp_read(internal as i64, max)
    user_copyout_bytes(ptr, bytes)

@export("C", name: "spl_arm64_net_close_direct")
fn spl_arm64_net_close_direct(external: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64:
    # -4096 is an ownership sentinel, not an errno: the C dispatcher then
    # routes ordinary file descriptors to the VFS close owner.
    val internal = _arm64_net_fd_remove(external as i32)
    if internal == -4096:
        return -4096
    if internal >= 0:
        net_tcp_close(internal as i64)
    0

# ============================================================================
# Network Service Start
# ============================================================================

fn net_service_start():
    """Start the network stack IPC + frame polling loop (blocking).

    Call after net_boot_init() returns true. This enters the
    NetstackService.start() loop which blocks on IPC/frame processing.
    In a real system this would run in its own scheduler task.
    For cooperative scheduling, use net_service_init_port() + net_service_poll().
    """
    if not g_net_initialized:
        log_raw_println("[net-init] Cannot start service -- not initialized")
        return
    if g_netstack == nil:
        log_raw_println("[net-init] Cannot start service -- no netstack instance")
        return
    g_netstack.start()

fn net_service_init_port():
    """Initialize the netstack IPC port without entering the blocking loop.

    Use with net_service_poll() for cooperative scheduling.
    """
    if not g_net_initialized or g_netstack == nil:
        log_raw_println("[net-init] Cannot init port -- not initialized")
        return
    g_netstack.init_port()

fn net_service_poll():
    """Run one tick of the network stack (non-blocking).

    Call from a cooperative main loop alongside VFS and shell.
    """
    if g_net_initialized and g_netstack != nil:
        g_netstack.poll_once()

# ============================================================================
# Query Helpers
# ============================================================================

fn net_is_ready() -> bool:
    """Check if network stack has been initialized and is ready."""
    g_net_initialized

fn net_get_service() -> NetstackService?:
    """Return the global NetstackService instance (nil if not initialized)."""
    g_netstack

fn net_get_driver() -> VirtioNetDriver:
    """Return the global VirtIO-net driver instance."""
    g_net_driver

fn net_tcp_available() -> bool:
    """Return true when the cooperative netstack singleton is available."""
    g_net_initialized and g_netstack != nil

fn net_tcp_bind(ip_value: u32, port: u16, backlog: u32) -> i64:
    """Create, bind, and listen on a TCP socket in the netstack singleton."""
    if g_netstack == nil:
        return -1

    var svc = g_netstack.unwrap()
    val fd = svc.sockets.create(SocketProtocol.Tcp)
    val addr = SockAddr(ip: Ipv4Address.from_u32(ip_value), port: port)
    match svc.sockets.bind(fd, addr):
        Err(_): 
            g_netstack = Some(svc)
            return -1
        Ok(_): pass

    match svc.sockets.listen(fd, backlog):
        Err(_):
            svc.sockets.close(fd)
            g_netstack = Some(svc)
            return -1
        Ok(_): pass

    g_netstack = Some(svc)
    fd.to_i64()

fn net_tcp_accept(fd: i64) -> i64:
    """Poll once and accept a queued TCP connection from the singleton."""
    if g_netstack == nil:
        return -1

    var svc = g_netstack.unwrap()
    svc.poll_once()
    match svc.sockets.accept(fd.to_i32()):
        Ok(client_fd):
            g_netstack = Some(svc)
            client_fd.to_i64()
        Err(_):
            g_netstack = Some(svc)
            -1

fn net_tcp_connect(ip_value: u32, port: u16, wait_ticks: u64) -> i64:
    """Create a TCP socket and drive a bounded blocking connect handshake."""
    if g_netstack == nil:
        return -1

    var svc = g_netstack.unwrap()
    val fd = svc.sockets.create(SocketProtocol.Tcp)
    val remote = SockAddr(ip: Ipv4Address.from_u32(ip_value), port: port)
    match svc.sockets.connect(fd, remote):
        Err(_):
            g_netstack = Some(svc)
            return -1
        Ok(_): pass

    val local_port = svc._alloc_ephemeral_port()
    var conn = TcpConnection.new_client(svc.local_ip, local_port, remote.ip, port)
    conn.conn_id = svc.next_conn_id
    svc.next_conn_id = svc.next_conn_id + 1
    val conn_id = conn.conn_id
    val syn_segments = conn.connect()
    svc.tcp_connections.push(conn)
    val conn_idx = svc.tcp_connections.len() - 1
    svc.sockets.attach_connecting(fd, SockAddr(ip: svc.local_ip, port: local_port), conn_id)
    svc._send_tcp_segments(conn_idx, syn_segments)

    var waited: u64 = 0
    while waited < wait_ticks:
        svc.poll_once()
        val status = svc.sockets.connect_status_by_conn(conn_id)
        if status == "established":
            g_netstack = Some(svc)
            return fd.to_i64()
        if status == "refused" or status == "unreachable":
            g_netstack = Some(svc)
            return -1
        waited = waited + 1

    svc.sockets.mark_connect_failed_by_conn(conn_id, "timeout")
    g_netstack = Some(svc)
    -1

fn net_tcp_read(fd: i64, max: u64) -> [u8]:
    """Poll once and read TCP receive data for a connected socket."""
    if g_netstack == nil:
        return []

    var svc = g_netstack.unwrap()
    svc.poll_once()
    val conn_id = svc.sockets.get_conn_id(fd.to_i32())
    var i: u64 = 0
    while i < svc.tcp_connections.len():
        if svc.tcp_connections[i].conn_id == conn_id:
            val data = svc.tcp_connections[i].recv_data(max)
            g_netstack = Some(svc)
            return data
        i = i + 1

    g_netstack = Some(svc)
    []

fn net_tcp_write(fd: i64, data: [u8]) -> i64:
    """Queue TCP send data and poll once to flush it."""
    if g_netstack == nil:
        return -1

    var svc = g_netstack.unwrap()
    val conn_id = svc.sockets.get_conn_id(fd.to_i32())
    var i: u64 = 0
    while i < svc.tcp_connections.len():
        if svc.tcp_connections[i].conn_id == conn_id:
            match svc.tcp_connections[i].send_data(data):
                Ok(n):
                    svc.flush_tcp_connections()
                    g_netstack = Some(svc)
                    return n.to_i64()
                Err(_):
                    g_netstack = Some(svc)
                    return -1
        i = i + 1

    g_netstack = Some(svc)
    -1

fn net_tcp_close(fd: i64) -> bool:
    """Close a TCP socket and send FIN when a live connection exists."""
    if g_netstack == nil:
        return false

    var svc = g_netstack.unwrap()
    val conn_id = svc.sockets.get_conn_id(fd.to_i32())
    var i: u64 = 0
    while i < svc.tcp_connections.len():
        if svc.tcp_connections[i].conn_id == conn_id:
            val segments = svc.tcp_connections[i].close()
            svc._send_tcp_segments(i, segments)
            break
        i = i + 1
    val closed = svc.sockets.close(fd.to_i32()).is_ok()
    g_netstack = Some(svc)
    closed
