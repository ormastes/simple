# Superseded VM prototype. Native Simple Container runs macOS programs on
# macOS and SimpleOS programs on SimpleOS; this dispatcher is not on either
# selected production route and must not be used as Mac qualification evidence.
# Historical macOS SimpleOS VM guest handoff for one managed attempt.
# A boot service owns the private transport, image measurement, policy bytes,
# and KernelCallContext. This dispatcher owns only the attempt lifecycle and
# never accepts a caller-supplied task ID or exit result.

use std.common.contracts.container.guest_v1.{
    GuestContainerAttemptV1, GuestContainerObservationV1,
    guest_container_attempt_rejection_v1,
    guest_container_observation_rejection_v1,
    guest_container_exit_pair_rejection_v1
}
use std.common.crypto.sha256.{sha256_u8_hex}
use os.services.container.container_runtime.{ContainerRuntime}
use os.services.container.runtime_provider_v1.{SimpleOsContainerProviderV1}
use os.services.workload.workload_manifest.{CompiledExecutionPolicy}
use os.kernel.security.execution_context.{KernelCallContext}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.types.task_types.{TaskPriority}
use os.kernel.arch.arch_context.{Architecture}

pub const MACOS_SIMPLEOS_GUEST_MAX_WORKLOAD_BYTES_V1: u64 = 67108864u64

pub struct MacSimpleOsGuestStartV1:
    status: text
    reason: text
    observation: GuestContainerObservationV1?
    scheduler: Scheduler

pub struct MacSimpleOsGuestExitV1:
    status: text
    reason: text
    observation: GuestContainerObservationV1?
    scheduler: Scheduler
    ipc: IpcManager

fn _guest_observation_v1(attempt: GuestContainerAttemptV1,
        task_id: text, phase: text, exit_code: i64,
        kernel_exit_observed: bool) -> GuestContainerObservationV1:
    GuestContainerObservationV1(
        operation_id: attempt.identity.operation_id,
        guest_boot_id: attempt.guest_boot_id, nonce: attempt.nonce,
        native_task_id: task_id, phase: phase, exit_code: exit_code,
        kernel_exit_observed: kernel_exit_observed)

fn _start_rejected_v1(scheduler: Scheduler, reason: text) -> MacSimpleOsGuestStartV1:
    MacSimpleOsGuestStartV1(status: "rejected", reason: reason,
        observation: nil, scheduler: scheduler)

fn _exit_blocked_v1(scheduler: Scheduler, ipc: IpcManager,
        reason: text) -> MacSimpleOsGuestExitV1:
    MacSimpleOsGuestExitV1(status: "blocked", reason: reason,
        observation: nil, scheduler: scheduler, ipc: ipc)

class MacSimpleOsGuestDispatcherV1:
    attempt: GuestContainerAttemptV1
    boot_id: text
    image_sha256: text
    policy_sha256: text
    policy: CompiledExecutionPolicy
    architecture: Architecture
    provider: SimpleOsContainerProviderV1
    phase: text
    running: GuestContainerObservationV1?

impl MacSimpleOsGuestDispatcherV1:
    static fn new(attempt: GuestContainerAttemptV1,
            boot_id: text, image_sha256: text, policy_sha256: text,
            policy: CompiledExecutionPolicy, architecture: Architecture,
            runtime: ContainerRuntime,
            container_index: i64) -> MacSimpleOsGuestDispatcherV1:
        # The boot service must derive these local measurements from its own
        # loaded image and policy, rather than echoing host request fields.
        MacSimpleOsGuestDispatcherV1(
            attempt: attempt, boot_id: boot_id,
            image_sha256: image_sha256, policy_sha256: policy_sha256,
            policy: policy, architecture: architecture,
            provider: SimpleOsContainerProviderV1.new(
                runtime, container_index, attempt.identity),
            phase: "prepared", running: nil)

    me start(context: KernelCallContext, bytes: [u8],
            architecture: Architecture, argv: [text],
            envp: [text], priority: TaskPriority,
            scheduler: Scheduler) -> MacSimpleOsGuestStartV1:
        if self.phase != "prepared":
            return _start_rejected_v1(scheduler, "attempt-already-consumed")
        # A rejected request is terminal for this dispatcher. A new attempt
        # requires a new boot-owned dispatcher and a fresh nonce.
        self.phase = "rejected"
        val reason = guest_container_attempt_rejection_v1(self.attempt)
        if reason != "":
            return _start_rejected_v1(scheduler, reason)
        if (self.boot_id != self.attempt.guest_boot_id or
                self.image_sha256 != self.attempt.guest_image_sha256 or
                self.policy_sha256 != self.attempt.policy_sha256):
            return _start_rejected_v1(scheduler, "guest-measurement-mismatch")
        if architecture != self.architecture:
            return _start_rejected_v1(scheduler, "guest-architecture-mismatch")
        if bytes.len() == 0u64 or bytes.len() > MACOS_SIMPLEOS_GUEST_MAX_WORKLOAD_BYTES_V1:
            return _start_rejected_v1(scheduler, "workload-size-invalid")
        if sha256_u8_hex(bytes) != self.attempt.workload_sha256:
            return _start_rejected_v1(scheduler, "workload-digest-mismatch")

        var provider = self.provider
        val started = provider.start_into_scheduler(context, self.policy, bytes,
            architecture, argv, envp, priority, scheduler)
        self.provider = provider
        if started.operation.status != "ok" or
                started.operation.state.phase != "running":
            return _start_rejected_v1(started.scheduler, started.operation.reason)
        val observed = _guest_observation_v1(self.attempt,
            started.operation.state.identity.native_id, "running", -1, false)
        val binding = guest_container_observation_rejection_v1(self.attempt, observed)
        if binding != "":
            return _start_rejected_v1(started.scheduler, binding)
        self.running = Some(observed)
        self.phase = "running"
        MacSimpleOsGuestStartV1(status: "ok", reason: "managed-task-launched",
            observation: Some(observed), scheduler: started.scheduler)

    me observe_exit(scheduler: Scheduler, ipc: IpcManager) -> MacSimpleOsGuestExitV1:
        if self.phase != "running" or self.running == nil:
            return _exit_blocked_v1(scheduler, ipc, "attempt-not-running")
        var provider = self.provider
        val result = provider.reconcile_exit(scheduler, ipc)
        self.provider = provider
        if result.operation.status != "ok" or
                result.operation.state.phase != "exited" or
                result.operation.reason != "kernel-exit-reconciled":
            return _exit_blocked_v1(result.scheduler, result.ipc,
                result.operation.reason)
        val observed = _guest_observation_v1(self.attempt,
            result.operation.state.identity.native_id, "exited",
            result.operation.state.exit_code, true)
        val binding = guest_container_exit_pair_rejection_v1(
            self.attempt, self.running.unwrap(), observed)
        if binding != "":
            return _exit_blocked_v1(result.scheduler, result.ipc, binding)
        self.phase = "exited"
        MacSimpleOsGuestExitV1(status: "ok", reason: "kernel-exit-reconciled",
            observation: Some(observed), scheduler: result.scheduler, ipc: result.ipc)

export MacSimpleOsGuestDispatcherV1
