# oci_import — "OCI at the edge" import adapter for the Podman/MDSOC+
# container-manager (lane T4-OCI).
#
# This is the EDGE ADAPTER: it takes an already-parsed, normalized OCI config
# (a plain input struct — this module does NO IO: no bundle unpack, no registry
# pull, no file reads) and converts it to the manager's ContainerSpec, applying
# the §6.3 safety checks as fail-CLOSED validation.
#
# Design: doc/04_architecture/os/container/podman_mdsoc_container_arch.md
#         (§ sys_oci_import) and doc/01_research/domain/
#         simpleos_production_host_master_plan.md §6.3 (OCI safety checks).
#
# The internal model stays the STRONGER capability model: OCI never grants raw
# host mounts, raw host net, uncontrolled devices, or lifecycle hooks by
# default. Produced caps are the INTERSECTION with the policy ceiling (never
# amplified) and the default network is isolated (no raw host net cap emitted).
#
# Self-hosted-defect discipline (see lane notes / CLAUDE.md):
#  - cross-module Result.Ok/Err is a filed compiler bug → oci_import() uses bare
#    Ok/Err, and the checked core returns a plain OciImportResult struct so the
#    spec never has to match a cross-module Result;
#  - no `{`/`}` literals in strings;
#  - pure functions only — no IO.

#
# Generic bundle validation (digest, hooks, unpack bounds, root/mount
# traversal, device and raw host mounts) is OWNED by the shared pure codec
# std.common.oci.bundle_check_v1 — the same validator std.container.oci uses.
# This adapter keeps only SimpleOS-specific lowering: capability ceiling
# intersection, isolated-net stripping and kernel ContainerSpec construction.

use os.services.container.container_manager.{ContainerSpec, caps_is_subset}
use std.common.oci.bundle_check_v1.{OciBundleMountV1, OciBundleCheckInputV1,
    OciBundleCheckPolicyV1, oci_bundle_check_v1}

# ============================================================================
# Edge inputs — a parsed / normalized OCI config + the import policy.
# ============================================================================

struct OciMount:
    """One mount from the OCI config. mtype is the OCI mount type token:
    "bind" (host path bind), "device" (device node), "tmpfs", "volume", ..."""
    src: text
    dest: text
    mtype: text

struct OciConfigInput:
    """A parsed, normalized OCI runtime config. No file handles — the caller
    already parsed the bundle. unpack_count / unpack_size are the DECLARED
    layer manifest totals (we bound them without unpacking). mem_budget is the
    requested memory budget carried into ContainerSpec.budget."""
    image_ref: text
    root_path: text
    entrypoint: text
    env: [text]
    mounts: [OciMount]
    caps: [text]
    uid: u64
    gid: u64
    hooks_present: bool
    digest: text
    unpack_count: u64
    unpack_size: u64
    mem_budget: u64

struct OciPolicy:
    """Import ceilings. All permissive flags default FALSE (fail-closed).
    cap_ceiling is the maximum authority any imported container may hold; the
    produced caps are the intersection of the config caps with this ceiling."""
    allow_host_mounts: bool
    allow_devices: bool
    allow_hooks: bool
    max_unpack_count: u64
    max_unpack_size: u64
    require_digest: bool
    cap_ceiling: [text]

# Default fail-closed policy: no host mounts, no devices, no hooks, digest
# required, 1 GiB / 100k-entry unpack bound. Caller supplies the cap ceiling.
fn oci_policy_default(cap_ceiling: [text]) -> OciPolicy:
    OciPolicy(
        allow_host_mounts: false,
        allow_devices: false,
        allow_hooks: false,
        max_unpack_count: 100000u64,
        max_unpack_size: 1073741824u64,
        require_digest: true,
        cap_ceiling: cap_ceiling
    )

# ============================================================================
# Result of the checked import (plain struct — avoids cross-module Result in
# the spec). ok == false means REJECTED and `error` names the exact reason.
# ============================================================================

struct OciImportResult:
    ok: bool
    error: text
    spec: ContainerSpec

fn empty_spec() -> ContainerSpec:
    ContainerSpec(image_digest: "", root: "", caps: [], budget: 0u64)

# ============================================================================
# Delegation to the shared validator. Rejection strings are the shared
# codec's (unchanged from the pre-extraction adapter).
# ============================================================================

fn oci_bundle_check_input(input: OciConfigInput) -> OciBundleCheckInputV1:
    var mounts: [OciBundleMountV1] = []
    for mnt in input.mounts:
        mounts.push(OciBundleMountV1(source: mnt.src, destination: mnt.dest, mount_type: mnt.mtype))
    OciBundleCheckInputV1(root_path: input.root_path, mounts: mounts,
        hooks_present: input.hooks_present, digest: input.digest,
        unpack_count: input.unpack_count, unpack_size: input.unpack_size)

fn oci_bundle_check_policy(policy: OciPolicy) -> OciBundleCheckPolicyV1:
    OciBundleCheckPolicyV1(allow_host_mounts: policy.allow_host_mounts,
        allow_devices: policy.allow_devices, allow_hooks: policy.allow_hooks,
        max_unpack_count: policy.max_unpack_count, max_unpack_size: policy.max_unpack_size,
        require_digest: policy.require_digest)

# ============================================================================
# SimpleOS capability lowering.
# ============================================================================
# Host-net capability tokens that would grant RAW host networking. The edge
# adapter never emits these — default net is isolated.
fn is_host_net_cap(c: text) -> bool:
    (c == "cap.host_net") or (c == "cap.net_host") or (c == "cap.net_host_raw")

# Intersection: keep only caps present in BOTH the config request and the
# policy ceiling. Result is a subset of BOTH — authority is never amplified.
# Additionally strip any raw host-net token so the default network is isolated.
fn caps_intersect_isolated(requested: [text], ceiling: [text]) -> [text]:
    var out: [text] = []
    var i = 0
    while i < requested.len():
        val c = requested[i]
        if is_host_net_cap(c):
            # never emitted — isolated net by default.
            i = i + 1
        else:
            var in_ceiling = false
            var j = 0
            while j < ceiling.len():
                if ceiling[j] == c:
                    in_ceiling = true
                j = j + 1
            if in_ceiling:
                out = out.push(c)
            i = i + 1
    out

# A ContainerSpec is isolated-net iff none of its caps is a raw host-net token.
fn spec_is_isolated_net(spec: ContainerSpec) -> bool:
    var i = 0
    while i < spec.caps.len():
        if is_host_net_cap(spec.caps[i]):
            return false
        i = i + 1
    true

# ============================================================================
# Core checked import — shared fail-CLOSED validation, then build the
# ContainerSpec. `check_traversal` exists ONLY so the spec can prove it can
# FAIL: disable it and the traversal-reject test fails. Production passes true.
# ============================================================================
fn oci_import_checked_ex(input: OciConfigInput, policy: OciPolicy, check_traversal: bool) -> OciImportResult:
    val error = oci_bundle_check_v1(oci_bundle_check_input(input), oci_bundle_check_policy(policy), check_traversal)
    if error != "":
        return OciImportResult(ok: false, error: error, spec: empty_spec())

    # All checks passed — build the ContainerSpec. Caps = intersection with the
    # policy ceiling (never amplified), host-net stripped (isolated by default).
    val caps = caps_intersect_isolated(input.caps, policy.cap_ceiling)
    val spec = ContainerSpec(
        image_digest: input.digest,
        root: input.root_path,
        caps: caps,
        budget: input.mem_budget
    )
    OciImportResult(ok: true, error: "", spec: spec)

# Production entry: traversal check always ON.
fn oci_import_checked(input: OciConfigInput, policy: OciPolicy) -> OciImportResult:
    oci_import_checked_ex(input, policy, true)

# ============================================================================
# Public API — the required Result-returning adapter. Bare Ok/Err (cross-module
# Result.Ok/Err is a filed compiler bug).
# ============================================================================
fn oci_import(input: OciConfigInput, policy: OciPolicy) -> Result<ContainerSpec, text>:
    val r = oci_import_checked(input, policy)
    if r.ok:
        Ok(r.spec)
    else:
        Err(r.error)
