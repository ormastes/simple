# oci_import — "OCI at the edge" import adapter for the Podman/MDSOC+
# container-manager (lane T4-OCI).
#
# This is the EDGE ADAPTER: it takes an already-parsed, normalized OCI config
# (a plain input struct — this module does NO IO: no bundle unpack, no registry
# pull, no file reads) and converts it to the manager's ContainerSpec, applying
# the §6.3 safety checks as fail-CLOSED validation.
#
# Design: doc/04_architecture/os/container/podman_mdsoc_container_arch.md
#         (§ sys_oci_import) and doc/01_research/domain/
#         simpleos_production_host_master_plan.md §6.3 (OCI safety checks).
#
# The internal model stays the STRONGER capability model: OCI never grants raw
# host mounts, raw host net, uncontrolled devices, or lifecycle hooks by
# default. Produced caps are the INTERSECTION with the policy ceiling (never
# amplified) and the default network is isolated (no raw host net cap emitted).
#
# Self-hosted-defect discipline (see lane notes / CLAUDE.md):
#  - cross-module Result.Ok/Err is a filed compiler bug → oci_import() uses bare
#    Ok/Err, and the checked core returns a plain OciImportResult struct so the
#    spec never has to match a cross-module Result;
#  - no `{`/`}` literals in strings;
#  - pure functions only — no IO.

use os.services.container.container_manager.{ContainerSpec, caps_is_subset}

# ============================================================================
# Edge inputs — a parsed / normalized OCI config + the import policy.
# ============================================================================

struct OciMount:
    """One mount from the OCI config. mtype is the OCI mount type token:
    "bind" (host path bind), "device" (device node), "tmpfs", "volume", ..."""
    src: text
    dest: text
    mtype: text

struct OciConfigInput:
    """A parsed, normalized OCI runtime config. No file handles — the caller
    already parsed the bundle. unpack_count / unpack_size are the DECLARED
    layer manifest totals (we bound them without unpacking). mem_budget is the
    requested memory budget carried into ContainerSpec.budget."""
    image_ref: text
    root_path: text
    entrypoint: text
    env: [text]
    mounts: [OciMount]
    caps: [text]
    uid: u64
    gid: u64
    hooks_present: bool
    digest: text
    unpack_count: u64
    unpack_size: u64
    mem_budget: u64

struct OciPolicy:
    """Import ceilings. All permissive flags default FALSE (fail-closed).
    cap_ceiling is the maximum authority any imported container may hold; the
    produced caps are the intersection of the config caps with this ceiling."""
    allow_host_mounts: bool
    allow_devices: bool
    allow_hooks: bool
    max_unpack_count: u64
    max_unpack_size: u64
    require_digest: bool
    cap_ceiling: [text]

# Default fail-closed policy: no host mounts, no devices, no hooks, digest
# required, 1 GiB / 100k-entry unpack bound. Caller supplies the cap ceiling.
fn oci_policy_default(cap_ceiling: [text]) -> OciPolicy:
    OciPolicy(
        allow_host_mounts: false,
        allow_devices: false,
        allow_hooks: false,
        max_unpack_count: 100000u64,
        max_unpack_size: 1073741824u64,
        require_digest: true,
        cap_ceiling: cap_ceiling
    )

# ============================================================================
# Result of the checked import (plain struct — avoids cross-module Result in
# the spec). ok == false means REJECTED and `error` names the exact reason.
# ============================================================================

struct OciImportResult:
    ok: bool
    error: text
    spec: ContainerSpec

fn empty_spec() -> ContainerSpec:
    ContainerSpec(image_digest: "", root: "", caps: [], budget: 0u64)

# ============================================================================
# Distinct rejection strings (one per §6.3 check).
# ============================================================================

val ERR_TRAVERSAL: text = "oci reject: mount destination escapes container root (.. traversal / above-root)"
val ERR_HOST_MOUNT: text = "oci reject: raw host bind mount denied by policy (allow_host_mounts=false)"
val ERR_DEVICE: text = "oci reject: uncontrolled device node mount denied by policy (allow_devices=false)"
val ERR_HOOKS: text = "oci reject: lifecycle hooks present but not authorized (allow_hooks=false)"
val ERR_UNPACK: text = "oci reject: unpack size/count exceeds policy bound"
val ERR_DIGEST: text = "oci reject: missing or empty content digest but require_digest=true"
val ERR_SRC_TRAVERSAL: text = "oci reject: mount source escapes the bundle (.. traversal)"
val ERR_ROOT: text = "oci reject: container root_path is empty, the host root, or contains .. traversal"

# ============================================================================
# Helpers.
# ============================================================================

# A raw host path is an absolute path on the host ("/..."). In-container mount
# destinations are also absolute, but a BIND source pointing at an absolute
# host path is the "raw host mount" vector §6.3 forbids by default.
fn is_host_path(p: text) -> bool:
    p.starts_with("/")

# Does the destination escape the container root? Two vectors: a ".." component
# (traversal), or an absolute host path escaping via ".." after normalization.
# Pure textual model: reject any dest containing "..".
fn dest_escapes(dest: text) -> bool:
    dest.contains("..")

# A mount SOURCE may also escape. `is_host_path` only catches ABSOLUTE host
# sources; a RELATIVE source such as "../../../etc" resolves above the bundle
# and was accepted by every check before lane CESC (bug
# oci_import_unchecked_mount_src_and_root_2026-07-27). No legitimate OCI source
# — bind path, volume name, or pseudo-fs token — contains "..".
fn src_escapes(src: text) -> bool:
    src.contains("..")

# The container root_path lands verbatim in ContainerSpec.root, which
# container_view_create() turns into the confinement root. "" is the ROOTLESS
# sentinel and "/" is the HOST root — neither may ever come from an untrusted
# OCI bundle — and ".." resolves above the bundle.
fn root_path_invalid(root: text) -> bool:
    if root.len() == 0:
        return true
    if root == "/":
        return true
    root.contains("..")

# Device-node mount types. OCI carries pseudo-device variants; exact-matching
# only "device" let "devtmpfs" walk straight past the §6.3 check. (The raw
# host-mount rule needs no such family list — it keys off an absolute host
# SOURCE, so "rbind" and any unknown future type are covered automatically.)
fn is_device_family(t: text) -> bool:
    (t == "device") or (t == "devtmpfs") or (t == "mknod")

# Host-net capability tokens that would grant RAW host networking. The edge
# adapter never emits these — default net is isolated.
fn is_host_net_cap(c: text) -> bool:
    (c == "cap.host_net") or (c == "cap.net_host") or (c == "cap.net_host_raw")

# Intersection: keep only caps present in BOTH the config request and the
# policy ceiling. Result is a subset of BOTH — authority is never amplified.
# Additionally strip any raw host-net token so the default network is isolated.
fn caps_intersect_isolated(requested: [text], ceiling: [text]) -> [text]:
    var out: [text] = []
    var i = 0
    while i < requested.len():
        val c = requested[i]
        if is_host_net_cap(c):
            # never emitted — isolated net by default.
            i = i + 1
        else:
            var in_ceiling = false
            var j = 0
            while j < ceiling.len():
                if ceiling[j] == c:
                    in_ceiling = true
                j = j + 1
            if in_ceiling:
                out = out.push(c)
            i = i + 1
    out

# A ContainerSpec is isolated-net iff none of its caps is a raw host-net token.
fn spec_is_isolated_net(spec: ContainerSpec) -> bool:
    var i = 0
    while i < spec.caps.len():
        if is_host_net_cap(spec.caps[i]):
            return false
        i = i + 1
    true

# ============================================================================
# Core checked import — fail-CLOSED validation, then build the ContainerSpec.
# `check_traversal` exists ONLY so the spec can prove it can FAIL: disable it
# and the traversal-reject test fails. Production callers pass true.
# ============================================================================
fn oci_import_checked_ex(input: OciConfigInput, policy: OciPolicy, check_traversal: bool) -> OciImportResult:
    # (f) digest present when required.
    if policy.require_digest:
        if input.digest.len() == 0:
            return OciImportResult(ok: false, error: ERR_DIGEST, spec: empty_spec())

    # (d) no lifecycle hooks unless authorized.
    if input.hooks_present:
        if not policy.allow_hooks:
            return OciImportResult(ok: false, error: ERR_HOOKS, spec: empty_spec())

    # (e) bound unpack size/count.
    if input.unpack_count > policy.max_unpack_count:
        return OciImportResult(ok: false, error: ERR_UNPACK, spec: empty_spec())
    if input.unpack_size > policy.max_unpack_size:
        return OciImportResult(ok: false, error: ERR_UNPACK, spec: empty_spec())

    # (g) the container root itself must be a real, confined bundle path.
    if check_traversal:
        if root_path_invalid(input.root_path):
            return OciImportResult(ok: false, error: ERR_ROOT, spec: empty_spec())

    # Per-mount checks: (a) dest traversal / above-root, (a2) SOURCE traversal,
    # (b) raw host mount, (c) uncontrolled device node.
    var m = 0
    while m < input.mounts.len():
        val mnt = input.mounts[m]
        # (a) destination must not escape the container root.
        if check_traversal:
            if dest_escapes(mnt.dest):
                return OciImportResult(ok: false, error: ERR_TRAVERSAL, spec: empty_spec())
            # (a2) the SOURCE must not escape the bundle either.
            if src_escapes(mnt.src):
                return OciImportResult(ok: false, error: ERR_SRC_TRAVERSAL, spec: empty_spec())
        # (c) device node denied by default — checked BEFORE the generic host
        # rule so a device node still reports the precise device reason.
        if is_device_family(mnt.mtype):
            if not policy.allow_devices:
                return OciImportResult(ok: false, error: ERR_DEVICE, spec: empty_spec())
        # (b) raw host mount denied by default. Type-INDEPENDENT: ANY mount that
        # names an absolute host path as its source is a raw host mount, whether
        # it calls itself "bind", "rbind", or something this adapter has never
        # heard of. Pseudo filesystems name their source "tmpfs"/"proc"/"none",
        # so they are unaffected.
        if is_host_path(mnt.src):
            if not policy.allow_host_mounts:
                return OciImportResult(ok: false, error: ERR_HOST_MOUNT, spec: empty_spec())
        m = m + 1

    # All checks passed — build the ContainerSpec. Caps = intersection with the
    # policy ceiling (never amplified), host-net stripped (isolated by default).
    val caps = caps_intersect_isolated(input.caps, policy.cap_ceiling)
    val spec = ContainerSpec(
        image_digest: input.digest,
        root: input.root_path,
        caps: caps,
        budget: input.mem_budget
    )
    OciImportResult(ok: true, error: "", spec: spec)

# Production entry: traversal check always ON.
fn oci_import_checked(input: OciConfigInput, policy: OciPolicy) -> OciImportResult:
    oci_import_checked_ex(input, policy, true)

# ============================================================================
# Public API — the required Result-returning adapter. Bare Ok/Err (cross-module
# Result.Ok/Err is a filed compiler bug).
# ============================================================================
fn oci_import(input: OciConfigInput, policy: OciPolicy) -> Result<ContainerSpec, text>:
    val r = oci_import_checked(input, policy)
    if r.ok:
        Ok(r.spec)
    else:
        Err(r.error)
