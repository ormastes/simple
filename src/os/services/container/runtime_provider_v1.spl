# One-attempt SimpleOS adapter over the real managed-container launch seam.
# The kernel owner supplies the scheduler/context; this is not a hosted worker
# probe, a durable recovery provider, or distributed-build readiness evidence.
use os.services.container.container_runtime.{ContainerRuntime}
use os.services.workload.workload_manifest.{CompiledExecutionPolicy}
use os.kernel.security.execution_context.{KernelCallContext}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.types.task_types.{TaskId, TaskState, TaskPriority}
use os.kernel.arch.arch_context.{Architecture}
use std.common.contracts.container.runtime_v1.{RuntimeProviderContractV1,
    RuntimeIdentityV1, RuntimeStateV1, RuntimeOperationV1,
    runtime_state_empty, runtime_command_empty}

pub struct SimpleOsContainerStartV1:
    operation: RuntimeOperationV1
    scheduler: Scheduler

pub struct SimpleOsContainerExitV1:
    operation: RuntimeOperationV1
    scheduler: Scheduler
    ipc: IpcManager

pub fn simpleos_container_provider_contract_v1() -> RuntimeProviderContractV1:
    RuntimeProviderContractV1(provider_id: "simpleos-managed-container-v1",
        version: 1, supports_recovery: false, supports_logs: false)

fn _identity_token_v1(value: text) -> bool:
    if value == "" or value.len() > 128:
        return false
    for ch in value.chars():
        if not ((ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
                (ch >= "0" and ch <= "9") or ch == "-" or ch == "_" or ch == "."):
            return false
    true

fn _provider_operation_v1(status: text, operation: text,
        state: RuntimeStateV1, reason: text) -> RuntimeOperationV1:
    RuntimeOperationV1(status: status, operation: operation,
        command: runtime_command_empty(), state: state, exit_code: state.exit_code,
        stdout: "", stderr: "", reason: reason)

class SimpleOsContainerProviderV1:
    runtime: ContainerRuntime
    container_index: i64
    launch_identity: RuntimeIdentityV1
    state: RuntimeStateV1

impl SimpleOsContainerProviderV1:
    static fn new(runtime: ContainerRuntime, container_index: i64,
            identity: RuntimeIdentityV1) -> SimpleOsContainerProviderV1:
        SimpleOsContainerProviderV1(runtime: runtime,
            container_index: container_index, launch_identity: identity,
            state: runtime_state_empty())

    fn state_for(self) -> RuntimeStateV1:
        self.state

    # No model-only create/start, caller-supplied exit, or PID adoption API.
    # Retain this mutable adapter as the single owner of its ContainerRuntime.
    me start_into_scheduler(context: KernelCallContext,
            policy: CompiledExecutionPolicy, bytes: [u8], arch: Architecture,
            argv: [text], envp: [text], priority: TaskPriority,
            scheduler: Scheduler) -> SimpleOsContainerStartV1:
        val identity = self.launch_identity
        if (not _identity_token_v1(identity.pod_uid) or identity.attempt <= 0 or
                identity.provider_generation <= 0 or
                not _identity_token_v1(identity.operation_id) or
                not _identity_token_v1(identity.node_boot_id) or
                identity.engine != "simpleos-managed-container-v1" or
                identity.native_id != ""):
            return SimpleOsContainerStartV1(operation: _provider_operation_v1(
                "rejected", "start", self.state, "launch-identity-invalid"),
                scheduler: scheduler)
        if self.state.phase != "unknown":
            return SimpleOsContainerStartV1(operation: _provider_operation_v1(
                "rejected", "start", self.state, "attempt-already-started"),
                scheduler: scheduler)
        var runtime = self.runtime
        val started = runtime.start_into_scheduler(self.container_index,
            context, policy, bytes, arch, argv, envp, priority, scheduler)
        self.runtime = runtime
        if started.pid <= 0:
            return SimpleOsContainerStartV1(operation: _provider_operation_v1(
                "rejected", "start", self.state, started.reason),
                scheduler: started.scheduler)
        var bound = identity
        bound.native_id = started.pid.to_text()
        self.state = RuntimeStateV1(phase: "running", identity: bound,
            exit_code: -1, reason: "managed-task-launched")
        SimpleOsContainerStartV1(operation: _provider_operation_v1(
            "ok", "start", self.state, "managed-task-launched"),
            scheduler: started.scheduler)

    me reconcile_exit(scheduler: Scheduler,
            ipc: IpcManager) -> SimpleOsContainerExitV1:
        val pid = self.runtime.runtime_pid_of(self.container_index)
        if (self.state.phase != "running" or pid <= 0 or
                self.state.identity.native_id != pid.to_text()):
            return SimpleOsContainerExitV1(operation: _provider_operation_v1(
                "rejected", "wait", self.state, "live-task-binding-mismatch"),
                scheduler: scheduler, ipc: ipc)
        val task = scheduler.get_task(TaskId(id: pid as u64))
        if task == nil:
            return SimpleOsContainerExitV1(operation: _provider_operation_v1(
                "blocked", "wait", self.state, "bound-task-unavailable"),
                scheduler: scheduler, ipc: ipc)
        val observed = task.unwrap()
        if observed.state != TaskState.Zombie:
            return SimpleOsContainerExitV1(operation: _provider_operation_v1(
                "blocked", "wait", self.state, "bound-task-not-exited"),
                scheduler: scheduler, ipc: ipc)
        var runtime = self.runtime
        val reconciled = runtime.reconcile_exit_from_scheduler(
            self.container_index, scheduler, ipc)
        self.runtime = runtime
        if not reconciled.accepted:
            return SimpleOsContainerExitV1(operation: _provider_operation_v1(
                "blocked", "wait", self.state, "kernel-exit-not-reconciled"),
                scheduler: reconciled.scheduler, ipc: reconciled.ipc)
        # Complete the manager's queued exit/view teardown before publication.
        runtime.reap_exits()
        self.runtime = runtime
        self.state = RuntimeStateV1(phase: "exited", identity: self.state.identity,
            exit_code: observed.exit_code, reason: "kernel-exit-reconciled")
        SimpleOsContainerExitV1(operation: _provider_operation_v1(
            "ok", "wait", self.state, "kernel-exit-reconciled"),
            scheduler: reconciled.scheduler, ipc: reconciled.ipc)

    fn logs(self) -> RuntimeOperationV1:
        _provider_operation_v1("rejected", "logs", self.state,
            "optional-capability-unavailable: logs")

    fn recover(self) -> RuntimeOperationV1:
        _provider_operation_v1("rejected", "recover", self.state,
            "optional-capability-unavailable: durable-recovery")

export SimpleOsContainerProviderV1
