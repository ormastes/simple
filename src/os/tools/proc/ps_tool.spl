# PS Tool — Process Listing
# MDSOC: feature dimension, apps layer

use os.userlib.process.{list_tasks}
use os.tools.shell.process.process_artifact_contract.{
    PROCESS_TOOL_MAX_ARGS_V1,
    PROCESS_TOOL_MAX_TASKS_V1
}

pub fn run_ps(args: [text]) -> i32:
    """Entry point for ps command.

    Flags: -a (all), -l (long format), -p PID (specific)
    """
    if args.len() > PROCESS_TOOL_MAX_ARGS_V1:
        print "ps: too many arguments"
        return 2
    if args.len() > 0 and (args[0] == "-h" or args[0] == "--help"):
        print "usage: ps [-a] [-l] [-p PID]"
        print ""
        print "Flags:"
        print "  -a       Show all tasks"
        print "  -l       Long format"
        print "  -p PID   Filter by PID"
        return 0

    var long_format = false
    var filter_pid: u64? = nil
    var i = 0

    while i < args.len():
        val arg = args[i]
        if arg == "-a":
            i = i + 1
            continue
        else if arg == "-l":
            long_format = true
        else if arg == "-p":
            i = i + 1
            if i >= args.len():
                print "error: -p requires a PID argument"
                return 2
            val pid_result = _parse_pid(args[i])
            if val Ok(pid) = pid_result:
                filter_pid = Some(pid)
            else:
                print "error: invalid PID '{args[i]}'"
                return 2
        else if arg == "--version":
            print "ps (SimpleOS core tools) 1.0"
            return 0
        else if arg == "--help":
            print "usage: ps [-a] [-l] [-p PID]"
            return 0
        else:
            print "ps: unknown option {arg}"
            return 2
        i = i + 1

    val tasks_result = list_tasks()
    match tasks_result:
        Ok(tasks):
            if tasks.len() > PROCESS_TOOL_MAX_TASKS_V1:
                print "error: process snapshot exceeds configured task bound"
                return 1
            if long_format:
                print "{_pad_right("PID", 6)}{_pad_right("PPID", 6)}{_pad_right("STATE", 10)}{_pad_right("PRIORITY", 10)}{_pad_right("MEM(pg)", 10)}{_pad_right("CPU(tick)", 10)}NAME"
            else:
                print "{_pad_right("PID", 6)}{_pad_right("STATE", 10)}{_pad_right("PRIORITY", 10)}NAME"

            var count = 0
            for entry in tasks:
                if val Some(pid) = filter_pid:
                    if entry.pid != pid:
                        continue

                val state_str = _format_state(entry.state)
                val prio_str = _format_priority(entry.priority)

                if long_format:
                    print "{_pad_left("{entry.pid}", 6)}{_pad_left("{entry.parent_pid}", 6)}{_pad_right(state_str, 10)}{_pad_right(prio_str, 10)}{_pad_left("{entry.memory_pages}", 10)}{_pad_left("{entry.cpu_ticks}", 10)}{entry.name}"
                else:
                    print "{_pad_left("{entry.pid}", 6)}{_pad_right(state_str, 10)}{_pad_right(prio_str, 10)}{entry.name}"
                count = count + 1

            print "\nTotal: {count} processes"
            0
        Err(e):
            print "error: failed to list tasks: {e}"
            return 1

fn _format_state(state: u8) -> text:
    match state:
        0: "Ready"
        1: "Running"
        2: "Blocked"
        3: "Zombie"
        _: "Unknown"

fn _format_priority(priority: u8) -> text:
    match priority:
        0: "Realtime"
        1: "High"
        2: "Normal"
        3: "Low"
        4: "Idle"
        _: "?"

fn _pad_right(s: text, width: i32) -> text:
    var result = s
    while result.len() < width:
        result = result + " "
    result

fn _pad_left(s: text, width: i32) -> text:
    var result = s
    while result.len() < width:
        result = " " + result
    result

fn _parse_pid(s: text) -> Result<u64, text>:
    val n = s.parse_u64()
    if val Some(pid) = n:
        Ok(pid)
    else:
        Err("invalid PID: {s}")
