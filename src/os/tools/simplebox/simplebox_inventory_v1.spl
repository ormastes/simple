# Closed command-name inventory shared by the compact dispatcher and the
# authenticated filesystem artifact contract.  This list is deliberately the
# routed Simplebox surface, not a wishlist of separately implemented shell
# helpers.  Keep it free of VFS, loader, and applet dependencies so discovery
# does not expand the dispatcher's compilation closure.

val _SIMPLEBOX_INVENTORY_APPLET_NAMES_V1: [text] = [
    "echo", "true", "false", "pwd", "seq", "cat", "head", "wc"]

pub fn simplebox_inventory_applet_names_v1() -> [text]:
    # Preserve the public function's fresh-array ownership contract; only the
    # internal membership hot path reads the immutable backing inventory.
    _SIMPLEBOX_INVENTORY_APPLET_NAMES_V1.copy()

pub fn simplebox_inventory_contains_applet_v1(requested: text) -> bool:
    """Check the closed inventory without constructing a per-call array."""
    for applet in _SIMPLEBOX_INVENTORY_APPLET_NAMES_V1:
        if requested == applet:
            return true
    false
