# Closed command-name inventory shared by the compact dispatcher and the
# authenticated filesystem artifact contract.  Keep this module free of VFS,
# loader, and applet implementation dependencies so discovery does not expand
# the dispatcher's compilation closure.

pub fn simplebox_inventory_applet_names_v1() -> [text]:
    ["echo", "printf", "true", "false", "pwd", "seq", "sleep", "cat", "head", "tail", "wc", "tee", "cp", "mv", "ls",
     "mkdir", "rm", "rmdir", "chmod", "touch", "ln", "basename", "dirname", "readlink", "which", "stat", "find", "grep", "sort", "sed", "uniq", "cut", "tr", "cmp", "od", "strings", "file", "comm", "paste", "nl", "join"]
