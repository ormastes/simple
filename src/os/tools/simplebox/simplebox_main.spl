# SimpleOS simplebox — busybox-style multi-call entry point (userland binary).
#
# This is the binary packed at /bin/simplebox in the SimpleOS image. It
# GENUINELY consumes the pure-Simple libc: numeric applet arguments are parsed
# with libc_strtoul (not open-coded), so building and running simplebox
# exercises the pure-Simple libc inside the OS image. MDSOC+ preserved — the
# dispatcher stays a stateless router; this entry only adds libc-backed applets.
#
# Build (simpleos target):
#   bin/simple native-build --target simpleos \
#     --entry src/os/tools/simplebox/simplebox_main.spl -o build/os/rootfs/bin/simplebox

use os.tools.simplebox.simplebox_dispatch.{simplebox_dispatch, simplebox_requested_applet}
use os.tools.simplebox.simplebox_fs_applets.{simplebox_cat, simplebox_head, simplebox_wc}
use os.libc.simpleos_stdlib_num.{libc_strtoul}
use std.io_runtime.{get_args}

val SIMPLEBOX_SEQ_MAX_OUTPUT_BYTES: i64 = 65536
val SIMPLEBOX_SEQ_MAX_COUNT: i64 = 12773
val SIMPLEBOX_SEQ_MAX_PARSE_BYTES: i64 = 64

struct SimpleboxSeqPlan:
    count: i64
    output_bytes: i64
    inspected_values: i64
    inspected_input_bytes: i64
    accepted: bool

struct SimpleboxSeqCountAdmission:
    count: i64
    inspected_input_bytes: i64
    accepted: bool

fn _simplebox_seq_checked_count(args: [text]) -> SimpleboxSeqCountAdmission:
    if args.len() == 0:
        return SimpleboxSeqCountAdmission(count: 0, inspected_input_bytes: 0, accepted: true)
    val n = args[0].len().to_i64()
    if n > SIMPLEBOX_SEQ_MAX_PARSE_BYTES:
        return SimpleboxSeqCountAdmission(count: 0, inspected_input_bytes: 0, accepted: false)
    val bytes = args[0].bytes()
    var index: i64 = 0
    while index < n and (bytes[index] == 32 or bytes[index] == 9 or bytes[index] == 10 or bytes[index] == 13 or bytes[index] == 11 or bytes[index] == 12):
        index = index + 1
    var negative = false
    if index < n and (bytes[index] == 43 or bytes[index] == 45):
        negative = bytes[index] == 45
        index = index + 1
    var count: i64 = 0
    while index < n:
        val ch = bytes[index]
        if ch < 48 or ch > 57:
            break
        count = count * 10 + (ch - 48)
        index = index + 1
        if count > SIMPLEBOX_SEQ_MAX_COUNT:
            return SimpleboxSeqCountAdmission(count: count, inspected_input_bytes: index, accepted: false)
    if negative:
        count = -count
    SimpleboxSeqCountAdmission(count: count, inspected_input_bytes: index, accepted: true)

fn _simplebox_decimal_bytes(value: i64) -> i64:
    var digits: i64 = 1
    var remaining = value
    while remaining >= 10:
        remaining = remaining / 10
        digits = digits + 1
    digits

fn simplebox_seq_plan(args: [text]) -> SimpleboxSeqPlan:
    """Preflight seq so the applet never emits unbounded or partial output."""
    # Keep simplebox_seq_count as the public libc-consumption surface, but do
    # not trust its unchecked accumulator for an admission decision.
    val admission = _simplebox_seq_checked_count(args)
    if not admission.accepted:
        return SimpleboxSeqPlan(count: admission.count, output_bytes: 0, inspected_values: 0, inspected_input_bytes: admission.inspected_input_bytes, accepted: false)
    val libc_count = simplebox_seq_count(args)
    if libc_count != admission.count:
        return SimpleboxSeqPlan(count: libc_count, output_bytes: 0, inspected_values: 0, inspected_input_bytes: admission.inspected_input_bytes, accepted: false)
    val count = libc_count
    var output_bytes: i64 = 0
    var inspected: i64 = 0
    var value: i64 = 1
    while value <= count:
        val line_bytes = _simplebox_decimal_bytes(value) + 1
        inspected = inspected + 1
        if line_bytes > SIMPLEBOX_SEQ_MAX_OUTPUT_BYTES - output_bytes:
            return SimpleboxSeqPlan(count: count, output_bytes: output_bytes + line_bytes, inspected_values: inspected, inspected_input_bytes: admission.inspected_input_bytes, accepted: false)
        output_bytes = output_bytes + line_bytes
        value = value + 1
    SimpleboxSeqPlan(count: count, output_bytes: output_bytes, inspected_values: inspected, inspected_input_bytes: admission.inspected_input_bytes, accepted: true)

# seq N — count parsed via the pure-Simple libc (libc_strtoul, base 10: skips
# leading whitespace, stops at the first non-digit). Splitting this out makes the
# libc consumption directly testable (and proves it is the libc, not open code).
fn simplebox_seq_count(args: [text]) -> i64:
    if args.len() == 0:
        return 0
    libc_strtoul(args[0].bytes(), 10)

fn _applet_seq(args: [text]) -> i32:
    val plan = simplebox_seq_plan(args)
    if not plan.accepted:
        print "seq: output exceeds 65536-byte limit"
        return 1
    var i: i64 = 1
    while i <= plan.count:
        print(i)
        i = i + 1
    0

# simplebox_run routes libc-backed applets here; everything else falls through
# to the self-contained dispatcher (echo/true/false/pwd/--list).
fn simplebox_run(argv: [text]) -> i32:
    val applet = simplebox_requested_applet(argv)
    val subcommand = argv.len() >= 2 and (argv[0].ends_with("simplebox") or argv[0].ends_with("busybox"))
    val start: u64 = if subcommand: 2u64 else: 1u64
    val args = argv.slice(start, argv.len())
    if applet == "seq":
        return _applet_seq(args)
    if applet == "cat":
        return simplebox_cat(args)
    if applet == "head":
        return simplebox_head(args)
    if applet == "wc":
        return simplebox_wc(args)
    simplebox_dispatch(argv)

# `fn main(argv: [text])` is not honoured by the current toolchain: with argv
# present it SEGVs (rc=139), and without argv `argv.len()` reads a non-array
# heap value as the array header (observed 8246223157400007265, ASCII
# "armsExpr"). Read the argv vector explicitly instead.
# See doc/08_tracking/bug/main_args_parameter_unsupported_breaks_mkfs_tools_2026-08-24.md
fn main() -> i32:
    simplebox_run(get_args())
