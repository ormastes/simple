# Bounded filesystem traversal for the filesystem-launched SimpleOS simplebox.

use os.userlib.fs.{file_lstat_bounded, list_directory_bounded}
use os.kernel.types.fs_types.{FsNodeKind}
use nogc_async_mut_noalloc.path.{bm_path_normalize}

extern fn stdout_write(data: text)

pub const SIMPLEBOX_FIND_NODE_LIMIT: u64 = 4096u64
pub const SIMPLEBOX_FIND_DEPTH_LIMIT: u64 = 64u64
pub const SIMPLEBOX_FIND_PATH_BYTES_LIMIT: u64 = 4096u64
pub const SIMPLEBOX_FIND_OUTPUT_BYTES_LIMIT: u64 = 67108864u64

struct SimpleboxFindPending:
    path: text
    depth: u64

fn _find_child_path(parent: text, name: text) -> text:
    if parent == "/":
        return "/" + name
    parent + "/" + name

fn _find_emit_path(path: text, emitted: u64) -> Result<u64, text>:
    val line_bytes = path.len() + 1u64
    if line_bytes > SIMPLEBOX_FIND_OUTPUT_BYTES_LIMIT - emitted:
        return Err("output exceeds simplebox byte limit")
    stdout_write(path + "\n")
    Ok(emitted + line_bytes)

pub fn simplebox_find(args: [text]) -> i32:
    """Walk one bounded canonical-VFS tree without following symbolic links.

    The applet intentionally implements the safe primary form, `find [PATH]`.
    It rejects predicates and multiple roots until their semantics have a
    dedicated bounded planner. Directory, total-node, depth, path, and output
    limits prevent a filesystem from turning traversal into unbounded work.
    """
    if args.len() > 1u64:
        stdout_write("find: expected at most one path operand\n")
        return 1
    val requested = if args.len() == 0u64 then "/" else: args[0]
    if (requested.len() == 0u64 or
        requested.len() > SIMPLEBOX_FIND_PATH_BYTES_LIMIT or
        not requested.starts_with("/")):
        stdout_write("find: path must be a bounded absolute path\n")
        return 1
    val root = bm_path_normalize(requested)
    if root.len() == 0u64 or root.len() > SIMPLEBOX_FIND_PATH_BYTES_LIMIT:
        stdout_write("find: invalid canonical path\n")
        return 1

    var pending: [SimpleboxFindPending] = [
        SimpleboxFindPending(path: root, depth: 0u64)]
    var scheduled: u64 = 1u64
    var visited: u64 = 0u64
    var emitted: u64 = 0u64
    while pending.len() > 0u64:
        val current = pending.pop()
        if visited == SIMPLEBOX_FIND_NODE_LIMIT:
            stdout_write("find: tree exceeds node limit\n")
            return 1
        visited = visited + 1u64
        val current_stat = file_lstat_bounded(current.path)
        var current_directory = false
        match current_stat:
            case Err(reason):
                stdout_write("find: " + current.path + ": " + reason + "\n")
                return 1
            case Ok(value): current_directory = value.kind == FsNodeKind.Directory
        match _find_emit_path(current.path, emitted):
            case Err(reason):
                stdout_write("find: " + reason + "\n")
                return 1
            case Ok(next_emitted): emitted = next_emitted

        if not current_directory:
            continue
        match list_directory_bounded(current.path):
            case Err(reason):
                stdout_write("find: " + current.path + ": " + reason + "\n")
                return 1
            case Ok(listing):
                if current.depth == SIMPLEBOX_FIND_DEPTH_LIMIT and listing.entries.len() > 0u64:
                    stdout_write("find: tree exceeds depth limit\n")
                    return 1
                var index = listing.entries.len()
                while index > 0u64:
                    index = index - 1u64
                    val entry = listing.entries[index]
                    if entry.name != "." and entry.name != "..":
                        if entry.name.contains("/") or entry.name.contains("\0"):
                            stdout_write("find: invalid directory entry name\n")
                            return 1
                        if scheduled == SIMPLEBOX_FIND_NODE_LIMIT:
                            stdout_write("find: tree exceeds node limit\n")
                            return 1
                        val child = _find_child_path(current.path, entry.name)
                        if child.len() > SIMPLEBOX_FIND_PATH_BYTES_LIMIT:
                            stdout_write("find: descendant path exceeds path limit\n")
                            return 1
                        pending.push(SimpleboxFindPending(
                            path: child,
                            depth: current.depth + 1u64))
                        scheduled = scheduled + 1u64
    0
