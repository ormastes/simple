# Bounded bytewise line sorting for filesystem-launched SimpleOS Simplebox.

use os.userlib.fs.{file_open_direct, file_read_direct, file_close_direct}
use os.tools.simplebox.simplebox_fs_applets.{
    SIMPLEBOX_FILE_LIMIT, SIMPLEBOX_FILE_BYTES_LIMIT,
    SIMPLEBOX_READ_CHUNK_BYTES, SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT
}
use std.nogc_sync_mut.binary_io.{bytes_to_string}

extern fn stdout_write(data: text)

pub const SIMPLEBOX_SORT_TOTAL_BYTES_LIMIT: u64 = 67108864u64
pub const SIMPLEBOX_SORT_LINE_LIMIT: u64 = 1000000u64

struct SimpleboxSortReadState:
    lines: [text]
    pending: [u8]
    consumed: u64
    output_bytes: u64
    failure: text

fn _sort_finish_line(prior: SimpleboxSortReadState) -> SimpleboxSortReadState:
    var state = prior
    if state.lines.len() >= SIMPLEBOX_SORT_LINE_LIMIT:
        state.failure = "input exceeds simplebox line limit"
        return state
    if state.pending.len() + 1u64 > SIMPLEBOX_SORT_TOTAL_BYTES_LIMIT - state.output_bytes:
        state.failure = "output exceeds simplebox byte limit"
        return state
    state.lines.push(bytes_to_string(state.pending))
    state.output_bytes = state.output_bytes + state.pending.len() + 1u64
    state.pending = []
    state

fn _sort_read_file(path: text, prior: SimpleboxSortReadState) -> SimpleboxSortReadState:
    var state = prior
    val opened = file_open_direct(path, 0u32)
    match opened:
        case Err(reason):
            state.failure = path + ": " + reason
            state
        case Ok(fd):
            var file_bytes: u64 = 0u64
            var complete = false
            while not complete and state.failure == "":
                match file_read_direct(fd, SIMPLEBOX_READ_CHUNK_BYTES):
                    case Err(reason): state.failure = path + ": " + reason
                    case Ok(chunk):
                        if chunk.len() == 0u64:
                            complete = true
                        elif (chunk.len() > SIMPLEBOX_FILE_BYTES_LIMIT - file_bytes or
                            chunk.len() > SIMPLEBOX_SORT_TOTAL_BYTES_LIMIT - state.consumed):
                            state.failure = "input exceeds simplebox byte limit"
                        else:
                            file_bytes = file_bytes + chunk.len()
                            state.consumed = state.consumed + chunk.len()
                            var index: u64 = 0u64
                            while index < chunk.len() and state.failure == "":
                                val byte = chunk[index]
                                if byte == 10u8:
                                    state = _sort_finish_line(state)
                                else:
                                    state.pending.push(byte)
                                index = index + 1u64
            # Each operand has its own logical EOF line boundary. Do not join
            # an unterminated final line to the next file's first line.
            if state.failure == "" and state.pending.len() > 0u64:
                state = _sort_finish_line(state)
            if not file_close_direct(fd) and state.failure == "":
                state.failure = path + ": close failed"
            state

pub fn simplebox_sort(args: [text]) -> i32:
    """Sort bounded file operands in bytewise ascending order.

    The safe primary form is `sort [--] FILE...`. Stdin, locale collation,
    options, and unbounded input are rejected. All input is admitted before
    output, so a read, close, or size failure cannot expose partial results.
    """
    var first: u64 = 0u64
    if args.len() > 0u64 and args[0] == "--":
        first = 1u64
    elif args.len() > 0u64 and args[0].starts_with("-"):
        stdout_write("sort: unsupported option: " + args[0] + "\n")
        return 2
    if first >= args.len():
        stdout_write("sort: missing FILE operand\n")
        return 2
    if args.len() - first > SIMPLEBOX_FILE_LIMIT.to_u64():
        stdout_write("sort: too many file operands\n")
        return 2

    var state = SimpleboxSortReadState(
        lines: [], pending: [], consumed: 0u64, output_bytes: 0u64, failure: "")
    var index = first
    while index < args.len() and state.failure == "":
        val path = args[index]
        if path.len() == 0u64 or path.len() > SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT:
            state.failure = "invalid path length"
        else:
            state = _sort_read_file(path, state)
        index = index + 1u64
    if state.failure != "":
        stdout_write("sort: " + state.failure + "\n")
        return 2

    state.lines.sort()
    for line in state.lines:
        stdout_write(line + "\n")
    0
