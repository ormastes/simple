# Filesystem identity and admission contract for the pure-Simple simplebox.

use os.tools.simplebox.simplebox_fs_applets.{
    SIMPLEBOX_FILE_LIMIT, SIMPLEBOX_FILE_BYTES_LIMIT, SIMPLEBOX_READ_CHUNK_BYTES
}
use nogc_async_mut_noalloc.path.{bm_path_normalize}
use os.tools.simplebox.simplebox_inventory_v1.{simplebox_inventory_applet_names_v1}

pub const SIMPLEBOX_ARTIFACT_SCHEMA_V1: i64 = 1
pub const SIMPLEBOX_CANONICAL_PATH_V1: text = "/bin/simplebox"
pub const SIMPLEBOX_APPLET_COUNT_V1: i64 = 41
pub const SIMPLEBOX_CANONICAL_ALIAS_COUNT_V1: i64 = 42

pub fn simplebox_applet_names_v1() -> [text]:
    simplebox_inventory_applet_names_v1()

pub fn simplebox_applet_canonical_aliases_v1() -> [text]:
    var aliases: [text] = []
    for applet in simplebox_inventory_applet_names_v1():
        aliases.push("/bin/" + applet)
    aliases

pub fn simplebox_canonical_aliases_v1() -> [text]:
    var aliases: [text] = ["/bin/busybox"]
    for alias in simplebox_applet_canonical_aliases_v1():
        aliases.push(alias)
    aliases

fn _simplebox_is_applet_alias_v1(canonical: text) -> bool:
    # Loader admission is a hot boundary. Avoid constructing and scanning the
    # full canonical-path array for every exec request; slice once and compare
    # against the single authoritative command inventory.
    if not canonical.starts_with("/bin/") or canonical.len() <= 5:
        return false
    val requested = canonical.slice(5, canonical.len())
    for applet in simplebox_inventory_applet_names_v1():
        if requested == applet:
            return true
    false

pub struct SimpleboxArtifactContractV1:
    schema_version: i64
    canonical_path: text
    entry_source_owner: text
    entry_symbol: text
    applets: [text]
    max_files: i64
    max_file_bytes: u64
    read_chunk_bytes: u64
    requires_target_artifact: bool
    requires_loader_authority_token: bool

pub fn simplebox_artifact_contract_v1() -> SimpleboxArtifactContractV1:
    SimpleboxArtifactContractV1(
        schema_version: SIMPLEBOX_ARTIFACT_SCHEMA_V1,
        canonical_path: SIMPLEBOX_CANONICAL_PATH_V1,
        entry_source_owner: "os.tools.simplebox.simplebox_main",
        entry_symbol: "main",
        applets: simplebox_applet_names_v1(),
        max_files: SIMPLEBOX_FILE_LIMIT,
        max_file_bytes: SIMPLEBOX_FILE_BYTES_LIMIT,
        read_chunk_bytes: SIMPLEBOX_READ_CHUNK_BYTES,
        requires_target_artifact: true,
        requires_loader_authority_token: true)

pub fn simplebox_path_requires_loader_authority_v1(path: text) -> bool:
    if path == "" or not path.starts_with("/"):
        return false
    val canonical = bm_path_normalize(path)
    if canonical == SIMPLEBOX_CANONICAL_PATH_V1 or canonical == "/bin/busybox":
        return true
    _simplebox_is_applet_alias_v1(canonical)

pub fn simplebox_resolve_canonical_path_v1(path: text) -> text:
    val canonical = bm_path_normalize(path)
    if canonical == "/bin/busybox" or _simplebox_is_applet_alias_v1(canonical):
        return SIMPLEBOX_CANONICAL_PATH_V1
    canonical
