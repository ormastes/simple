# Filesystem identity and admission contract for the pure-Simple simplebox.

use os.tools.simplebox.simplebox_fs_applets.{
    SIMPLEBOX_FILE_LIMIT, SIMPLEBOX_FILE_BYTES_LIMIT, SIMPLEBOX_READ_CHUNK_BYTES
}
use nogc_async_mut_noalloc.path.{bm_path_normalize}

pub const SIMPLEBOX_ARTIFACT_SCHEMA_V1: i64 = 1
pub const SIMPLEBOX_CANONICAL_PATH_V1: text = "/bin/simplebox"

pub struct SimpleboxArtifactContractV1:
    schema_version: i64
    canonical_path: text
    entry_source_owner: text
    entry_symbol: text
    applets: [text]
    max_files: i64
    max_file_bytes: u64
    read_chunk_bytes: u64
    requires_target_artifact: bool
    requires_loader_authority_token: bool

pub fn simplebox_artifact_contract_v1() -> SimpleboxArtifactContractV1:
    SimpleboxArtifactContractV1(
        schema_version: SIMPLEBOX_ARTIFACT_SCHEMA_V1,
        canonical_path: SIMPLEBOX_CANONICAL_PATH_V1,
        entry_source_owner: "os.tools.simplebox.simplebox_main",
        entry_symbol: "main",
        applets: ["echo", "true", "false", "pwd", "seq", "cat", "head", "wc"],
        max_files: SIMPLEBOX_FILE_LIMIT,
        max_file_bytes: SIMPLEBOX_FILE_BYTES_LIMIT,
        read_chunk_bytes: SIMPLEBOX_READ_CHUNK_BYTES,
        requires_target_artifact: true,
        requires_loader_authority_token: true)

pub fn simplebox_path_requires_loader_authority_v1(path: text) -> bool:
    if path == "" or not path.starts_with("/"):
        return false
    val canonical = bm_path_normalize(path)
    canonical == SIMPLEBOX_CANONICAL_PATH_V1 or
        canonical == "/bin/cat" or canonical == "/bin/head" or
        canonical == "/bin/wc" or canonical == "/bin/echo" or
        canonical == "/bin/pwd" or canonical == "/bin/seq"

