# Bounded sorted-line comparison for filesystem-launched SimpleOS Simplebox.

use os.userlib.fs.{file_open_direct, file_read_direct, file_close_direct}
use os.tools.simplebox.simplebox_fs_applets.{
    SIMPLEBOX_FILE_BYTES_LIMIT, SIMPLEBOX_READ_CHUNK_BYTES,
    SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT
}
use std.nogc_sync_mut.binary_io.{bytes_to_string}

extern fn stdout_write(data: text)

pub const SIMPLEBOX_COMM_LINE_LIMIT: u64 = 1000000u64
pub const SIMPLEBOX_COMM_LINE_BYTES_LIMIT: u64 = 1048576u64
pub const SIMPLEBOX_COMM_OUTPUT_BYTES_LIMIT: u64 = 67108864u64
pub const SIMPLEBOX_COMM_ROWS_PER_BLOCK: u64 = 1024u64

struct SimpleboxCommPlan:
    show_first: bool
    show_second: bool
    show_common: bool
    first_path: text
    second_path: text
    accepted: bool
    error: text

struct SimpleboxCommReadState:
    lines: [[u8]]
    pending: [u8]
    consumed: u64
    failure: text

struct SimpleboxCommOutputState:
    blocks: [text]
    buffered_rows: [text]
    output_bytes: u64
    failure: text

fn _comm_plan(args: [text]) -> SimpleboxCommPlan:
    var show_first = true
    var show_second = true
    var show_common = true
    var paths: [text] = []
    var options = true
    var index: u64 = 0u64
    while index < args.len():
        val arg = args[index]
        if options and arg == "--":
            options = false
        elif options and arg == "-1":
            show_first = false
        elif options and arg == "-2":
            show_second = false
        elif options and arg == "-3":
            show_common = false
        elif options and arg.starts_with("-"):
            return SimpleboxCommPlan(show_first: true, show_second: true,
                show_common: true, first_path: "", second_path: "",
                accepted: false, error: "unsupported option: " + arg)
        else:
            options = false
            paths.push(arg)
        index = index + 1u64
    if paths.len() != 2u64:
        return SimpleboxCommPlan(show_first: true, show_second: true,
            show_common: true, first_path: "", second_path: "",
            accepted: false, error: "expected exactly two FILE operands")
    for path in paths:
        if path.len() == 0u64 or path.len() > SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT:
            return SimpleboxCommPlan(show_first: true, show_second: true,
                show_common: true, first_path: "", second_path: "",
                accepted: false, error: "invalid path length")
    SimpleboxCommPlan(show_first: show_first, show_second: show_second,
        show_common: show_common, first_path: paths[0], second_path: paths[1],
        accepted: true, error: "")

fn _comm_bytes_compare(left: [u8], right: [u8]) -> i64:
    val shared = if left.len() < right.len(): left.len() else: right.len()
    var index: u64 = 0u64
    while index < shared:
        if left[index] < right[index]: return -1
        if left[index] > right[index]: return 1
        index = index + 1u64
    if left.len() < right.len(): return -1
    if left.len() > right.len(): return 1
    0

fn _comm_read_file(path: text) -> SimpleboxCommReadState:
    var state = SimpleboxCommReadState(lines: [], pending: [], consumed: 0u64,
        failure: "")
    val opened = file_open_direct(path, 0u32)
    match opened:
        case Err(reason):
            state.failure = path + ": " + reason
            state
        case Ok(fd):
            var complete = false
            while not complete and state.failure == "":
                match file_read_direct(fd, SIMPLEBOX_READ_CHUNK_BYTES):
                    case Err(reason): state.failure = path + ": " + reason
                    case Ok(chunk):
                        if chunk.len() == 0u64:
                            complete = true
                        elif (state.consumed > SIMPLEBOX_FILE_BYTES_LIMIT or
                            chunk.len() >
                                SIMPLEBOX_FILE_BYTES_LIMIT - state.consumed):
                            state.failure = path + ": file exceeds simplebox byte limit"
                        else:
                            state.consumed = state.consumed + chunk.len()
                            var index: u64 = 0u64
                            while index < chunk.len() and state.failure == "":
                                if chunk[index] == 10u8:
                                    if state.lines.len() >= SIMPLEBOX_COMM_LINE_LIMIT:
                                        state.failure = path + ": input exceeds simplebox line limit"
                                    elif (state.lines.len() > 0u64 and
                                        _comm_bytes_compare(state.pending,
                                            state.lines[state.lines.len() - 1u64]) < 0):
                                        state.failure = path + ": input is not sorted"
                                    else:
                                        state.lines.push(state.pending)
                                        state.pending = []
                                elif state.pending.len() >= SIMPLEBOX_COMM_LINE_BYTES_LIMIT:
                                    state.failure = path + ": line exceeds simplebox byte limit"
                                else:
                                    state.pending.push(chunk[index])
                                index = index + 1u64
            if state.failure == "" and state.pending.len() > 0u64:
                if state.lines.len() >= SIMPLEBOX_COMM_LINE_LIMIT:
                    state.failure = path + ": input exceeds simplebox line limit"
                elif (state.lines.len() > 0u64 and
                    _comm_bytes_compare(state.pending,
                        state.lines[state.lines.len() - 1u64]) < 0):
                    state.failure = path + ": input is not sorted"
                else:
                    state.lines.push(state.pending)
                    state.pending = []
            if not file_close_direct(fd) and state.failure == "":
                state.failure = path + ": close failed"
            state

fn _comm_first_row(line: [u8], plan: SimpleboxCommPlan) -> text:
    if not plan.show_first:
        return ""
    bytes_to_string(line) + "\n"

fn _comm_second_row(line: [u8], plan: SimpleboxCommPlan) -> text:
    if not plan.show_second:
        return ""
    val prefix = if plan.show_first: "\t" else: ""
    prefix + bytes_to_string(line) + "\n"

fn _comm_common_row(line: [u8], plan: SimpleboxCommPlan) -> text:
    if not plan.show_common:
        return ""
    var prefix = ""
    if plan.show_first:
        prefix = prefix + "\t"
    if plan.show_second:
        prefix = prefix + "\t"
    prefix + bytes_to_string(line) + "\n"

fn _comm_merge(
    first: [[u8]], second: [[u8]], plan: SimpleboxCommPlan
) -> SimpleboxCommOutputState:
    var state = SimpleboxCommOutputState(blocks: [], buffered_rows: [],
        output_bytes: 0u64, failure: "")
    var first_index: u64 = 0u64
    var second_index: u64 = 0u64
    while (first_index < first.len() or second_index < second.len()) and state.failure == "":
        var row = ""
        if first_index >= first.len():
            row = _comm_second_row(second[second_index], plan)
            second_index = second_index + 1u64
        elif second_index >= second.len():
            row = _comm_first_row(first[first_index], plan)
            first_index = first_index + 1u64
        else:
            # Byte comparison is linear in the shared line prefix. Compute it
            # once per merge step rather than rescanning equal lines (and the
            # second ordering branch) with reversed operands.
            val ordering = _comm_bytes_compare(
                first[first_index], second[second_index])
            if ordering < 0:
                row = _comm_first_row(first[first_index], plan)
                first_index = first_index + 1u64
            elif ordering > 0:
                row = _comm_second_row(second[second_index], plan)
                second_index = second_index + 1u64
            else:
                row = _comm_common_row(first[first_index], plan)
                first_index = first_index + 1u64
                second_index = second_index + 1u64
        if row != "":
            if (state.output_bytes > SIMPLEBOX_COMM_OUTPUT_BYTES_LIMIT or
                row.len() > SIMPLEBOX_COMM_OUTPUT_BYTES_LIMIT - state.output_bytes):
                state.failure = "output exceeds simplebox byte limit"
            else:
                state.buffered_rows.push(row)
                if state.buffered_rows.len() == SIMPLEBOX_COMM_ROWS_PER_BLOCK:
                    state.blocks.push(state.buffered_rows.join(""))
                    state.buffered_rows = []
                state.output_bytes = state.output_bytes + row.len()
    if state.failure == "" and state.buffered_rows.len() > 0u64:
        state.blocks.push(state.buffered_rows.join(""))
        state.buffered_rows = []
    state

pub fn simplebox_comm(args: [text]) -> i32:
    """Compare two bounded bytewise-sorted files in three columns.

    The supported form is `comm [-1] [-2] [-3] [--] FILE1 FILE2`.
    The options suppress lines unique to FILE1, unique to FILE2, and common to
    both, respectively; remaining columns retain POSIX tab positioning. Inputs
    must already be bytewise sorted. Each file, line, line count, and output is
    bounded. Both reads and closes complete before the linear merge or stdout.
    """
    val plan = _comm_plan(args)
    if not plan.accepted:
        stdout_write("comm: " + plan.error + "\n")
        return 2
    val first = _comm_read_file(plan.first_path)
    if first.failure != "":
        stdout_write("comm: " + first.failure + "\n")
        return 2
    val second = _comm_read_file(plan.second_path)
    if second.failure != "":
        stdout_write("comm: " + second.failure + "\n")
        return 2
    val output = _comm_merge(first.lines, second.lines, plan)
    if output.failure != "":
        stdout_write("comm: " + output.failure + "\n")
        return 2
    for block in output.blocks:
        stdout_write(block)
    0
