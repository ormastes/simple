# Bounded adjacent-line deduplication for filesystem-launched SimpleOS Simplebox.

use os.userlib.fs.{file_open_direct, file_read_direct, file_close_direct}
use os.tools.simplebox.simplebox_fs_applets.{
    SIMPLEBOX_FILE_BYTES_LIMIT, SIMPLEBOX_READ_CHUNK_BYTES,
    SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT
}
use std.nogc_sync_mut.binary_io.{bytes_to_string}

extern fn stdout_write(data: text)

pub const SIMPLEBOX_UNIQ_OUTPUT_BYTES_LIMIT: u64 = 67108864u64
pub const SIMPLEBOX_UNIQ_LINE_LIMIT: u64 = 1000000u64

struct SimpleboxUniqState:
    parts: [text]
    pending: [u8]
    previous: text
    has_previous: bool
    line_count: u64
    output_bytes: u64
    failure: text

fn _uniq_finish_line(
    prior: SimpleboxUniqState, newline: bool
) -> SimpleboxUniqState:
    var state = prior
    if state.line_count >= SIMPLEBOX_UNIQ_LINE_LIMIT:
        state.failure = "input exceeds simplebox line limit"
        return state
    state.line_count = state.line_count + 1u64
    val line = bytes_to_string(state.pending)
    state.pending = []
    if state.has_previous and line == state.previous:
        return state
    val newline_bytes: u64 = if newline: 1u64 else: 0u64
    val remaining = SIMPLEBOX_UNIQ_OUTPUT_BYTES_LIMIT - state.output_bytes
    if line.len() > remaining:
        state.failure = "output exceeds simplebox byte limit"
        return state
    if newline_bytes > remaining - line.len():
        state.failure = "output exceeds simplebox byte limit"
        return state
    var part = line
    if newline:
        part = part + "\n"
    state.parts.push(part)
    state.output_bytes = state.output_bytes + line.len() + newline_bytes
    state.previous = line
    state.has_previous = true
    state

fn _uniq_read_file(path: text) -> SimpleboxUniqState:
    var state = SimpleboxUniqState(
        parts: [], pending: [], previous: "", has_previous: false,
        line_count: 0u64, output_bytes: 0u64, failure: "")
    val opened = file_open_direct(path, 0u32)
    match opened:
        case Err(reason):
            state.failure = path + ": " + reason
            state
        case Ok(fd):
            var consumed: u64 = 0u64
            var complete = false
            while not complete and state.failure == "":
                match file_read_direct(fd, SIMPLEBOX_READ_CHUNK_BYTES):
                    case Err(reason): state.failure = path + ": " + reason
                    case Ok(chunk):
                        if chunk.len() == 0u64:
                            complete = true
                        elif chunk.len() > SIMPLEBOX_FILE_BYTES_LIMIT - consumed:
                            state.failure = path + ": file exceeds simplebox byte limit"
                        else:
                            consumed = consumed + chunk.len()
                            var index: u64 = 0u64
                            while index < chunk.len() and state.failure == "":
                                val byte = chunk[index]
                                if byte == 10u8:
                                    state = _uniq_finish_line(state, true)
                                else:
                                    state.pending.push(byte)
                                index = index + 1u64
            if state.failure == "" and state.pending.len() > 0u64:
                state = _uniq_finish_line(state, false)
            if not file_close_direct(fd) and state.failure == "":
                state.failure = path + ": close failed"
            state

pub fn simplebox_uniq(args: [text]) -> i32:
    """Remove adjacent duplicate lines from one bounded file operand.

    The safe primary form is `uniq [--] FILE`. Stdin, output-file operands,
    options, and unbounded input are rejected. The input and close result are
    fully admitted before output, so a failure cannot expose partial results.
    """
    var path_index: u64 = 0u64
    if args.len() > 0u64 and args[0] == "--":
        path_index = 1u64
    elif args.len() > 0u64 and args[0].starts_with("-"):
        stdout_write("uniq: unsupported option: " + args[0] + "\n")
        return 2
    if path_index >= args.len():
        stdout_write("uniq: missing FILE operand\n")
        return 2
    if args.len() - path_index != 1u64:
        stdout_write("uniq: expected exactly one FILE operand\n")
        return 2
    val path = args[path_index]
    if path.len() == 0u64 or path.len() > SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT:
        stdout_write("uniq: invalid path length\n")
        return 2
    val state = _uniq_read_file(path)
    if state.failure != "":
        stdout_write("uniq: " + state.failure + "\n")
        return 2
    for part in state.parts:
        stdout_write(part)
    0
