# @feature simplebox.dispatch
# simplebox_dispatch — MDSOC+ busybox-style multi-call applet router.
# The stateless router owns applet identity. Filesystem behavior is invoked by
# simplebox_main; bounded output applets remain here to keep a compact
# compilation closure.

extern fn stdout_write(data: text)

val SIMPLEBOX_MAX_OUTPUT_BYTES: i64 = 65536

struct SimpleboxEchoPlan:
    parts: [text]
    output_bytes: i64
    accepted: bool

struct SimpleboxPrintfPlan:
    parts: [text]
    output_bytes: i64
    accepted: bool
    error: text

fn _printf_push_bounded(
    parts: [text], output_bytes: i64, part: text
) -> SimpleboxPrintfPlan:
    val part_bytes = part.len().to_i64()
    if part_bytes > SIMPLEBOX_MAX_OUTPUT_BYTES - output_bytes:
        return SimpleboxPrintfPlan(
            parts: [], output_bytes: output_bytes + part_bytes,
            accepted: false, error: "output exceeds 65536-byte limit")
    parts.push(part)
    SimpleboxPrintfPlan(
        parts: parts, output_bytes: output_bytes + part_bytes,
        accepted: true, error: "")

fn simplebox_printf_plan(args: [text]) -> SimpleboxPrintfPlan:
    """Expand a bounded printf format using %s, %%, and common escapes."""
    if args.len() == 0u64:
        return SimpleboxPrintfPlan(
            parts: [], output_bytes: 0, accepted: false,
            error: "missing format operand")
    val format = args[0]
    var parts: [text] = []
    var output_bytes: i64 = 0
    var arg_index: u64 = 1u64
    var repeat = true
    while repeat:
        repeat = false
        var consumed_argument = false
        var index: i64 = 0
        while index < format.len():
            val current = format.slice(index, index + 1)
            var part = current
            if current == "%":
                if index + 1 >= format.len():
                    return SimpleboxPrintfPlan(
                        parts: [], output_bytes: output_bytes, accepted: false,
                        error: "incomplete format directive")
                val directive = format.slice(index + 1, index + 2)
                if directive == "%":
                    part = "%"
                elif directive == "s":
                    part = if arg_index < args.len(): args[arg_index] else: ""
                    if arg_index < args.len():
                        arg_index = arg_index + 1u64
                        consumed_argument = true
                else:
                    return SimpleboxPrintfPlan(
                        parts: [], output_bytes: output_bytes, accepted: false,
                        error: "unsupported format directive %" + directive)
                index = index + 2
            elif current == "\\":
                if index + 1 >= format.len():
                    part = "\\"
                    index = index + 1
                else:
                    val escape = format.slice(index + 1, index + 2)
                    if escape == "n":
                        part = "\n"
                    elif escape == "t":
                        part = "\t"
                    elif escape == "r":
                        part = "\r"
                    elif escape == "\\":
                        part = "\\"
                    elif escape == "c":
                        return SimpleboxPrintfPlan(
                            parts: parts, output_bytes: output_bytes,
                            accepted: true, error: "")
                    else:
                        part = "\\" + escape
                    index = index + 2
            else:
                index = index + 1
            val appended = _printf_push_bounded(parts, output_bytes, part)
            if not appended.accepted:
                return appended
            parts = appended.parts
            output_bytes = appended.output_bytes
        if consumed_argument and arg_index < args.len():
            repeat = true
    SimpleboxPrintfPlan(
        parts: parts, output_bytes: output_bytes, accepted: true, error: "")

fn simplebox_echo_plan(args: [text]) -> SimpleboxEchoPlan:
    """Plan one bounded echo write without repeatedly copying its prefix."""
    var newline = true
    var start: u64 = 0u64
    if args.len() > 0u64 and args[0] == "-n":
        newline = false
        start = 1u64

    var parts: [text] = []
    var output_bytes: i64 = 0
    var index = start
    while index < args.len():
        if index > start:
            output_bytes = output_bytes + 1
            if output_bytes > SIMPLEBOX_MAX_OUTPUT_BYTES:
                return SimpleboxEchoPlan(parts: [], output_bytes: output_bytes, accepted: false)
            parts.push(" ")
        val arg_bytes = args[index].len().to_i64()
        if arg_bytes > SIMPLEBOX_MAX_OUTPUT_BYTES - output_bytes:
            return SimpleboxEchoPlan(parts: [], output_bytes: output_bytes + arg_bytes, accepted: false)
        output_bytes = output_bytes + arg_bytes
        parts.push(args[index])
        index = index + 1u64
    if newline:
        if output_bytes == SIMPLEBOX_MAX_OUTPUT_BYTES:
            return SimpleboxEchoPlan(parts: [], output_bytes: output_bytes + 1, accepted: false)
        output_bytes = output_bytes + 1
        parts.push("\n")
    SimpleboxEchoPlan(parts: parts, output_bytes: output_bytes, accepted: true)

fn _applet_echo(args: [text]) -> i32:
    val plan = simplebox_echo_plan(args)
    if not plan.accepted:
        stdout_write("echo: output exceeds 65536-byte limit\n")
        return 1
    stdout_write(plan.parts.join(""))
    0

fn _applet_printf(args: [text]) -> i32:
    val plan = simplebox_printf_plan(args)
    if not plan.accepted:
        stdout_write("printf: " + plan.error + "\n")
        return 1
    stdout_write(plan.parts.join(""))
    0

fn _applet_true(args: [text]) -> i32:
    return 0

fn _applet_false(args: [text]) -> i32:
    return 1

fn _applet_pwd(args: [text]) -> i32:
    if args.len() != 0u64:
        stdout_write("pwd: too many operands\n")
        return 1
    stdout_write("/\n")
    0

fn _basename(path: text) -> text:
    var last_slash = -1
    var i = 0
    for ch in path:
        if ch == "/":
            last_slash = i
        i = i + 1
    if last_slash >= 0:
        path.slice(last_slash + 1, path.len())
    else:
        path

fn _run_applet(name: text, args: [text]) -> i32:
    if name == "echo":
        return _applet_echo(args)
    elif name == "printf":
        return _applet_printf(args)
    elif name == "true":
        return _applet_true(args)
    elif name == "false":
        return _applet_false(args)
    elif name == "pwd":
        return _applet_pwd(args)
    127

fn simplebox_applet_names() -> [text]:
    var names: [text] = []
    names.push("echo")
    names.push("printf")
    names.push("true")
    names.push("false")
    names.push("pwd")
    names.push("seq")
    names.push("cat")
    names.push("head")
    names.push("tail")
    names.push("wc")
    names.push("tee")
    names.push("cp")
    names.push("mv")
    names.push("ls")
    names.push("mkdir")
    names.push("rm")
    names.push("rmdir")
    names.push("chmod")
    names.push("touch")
    names.push("ln")
    names.push("basename")
    names.push("dirname")
    names.push("readlink")
    names

fn simplebox_has_applet(name: text) -> bool:
    if name == "echo":
        return true
    elif name == "printf":
        return true
    elif name == "true":
        return true
    elif name == "false":
        return true
    elif name == "pwd":
        return true
    elif name == "seq":
        return true
    elif name == "cat":
        return true
    elif name == "head":
        return true
    elif name == "tail":
        return true
    elif name == "wc":
        return true
    elif name == "tee":
        return true
    elif name == "cp":
        return true
    elif name == "mv":
        return true
    elif name == "ls":
        return true
    elif name == "mkdir":
        return true
    elif name == "rm":
        return true
    elif name == "rmdir":
        return true
    elif name == "chmod":
        return true
    elif name == "touch":
        return true
    elif name == "ln":
        return true
    elif name == "basename":
        return true
    elif name == "dirname":
        return true
    elif name == "readlink":
        return true
    false

fn simplebox_dispatch(argv: [text]) -> i32:
    if argv.len() == 0:
        return 127
    val applet = simplebox_requested_applet(argv)
    if applet == "":
        return 127
    val base = _basename(argv[0])
    val arg_start = if base == "simplebox" or base == "busybox": 2 else: 1
    if applet == "--list":
        for name in simplebox_applet_names():
            stdout_write(name + "\n")
        return 0
    val applet_args = argv.slice(arg_start, argv.len())
    _run_applet(applet, applet_args)

fn simplebox_requested_applet(argv: [text]) -> text:
    if argv.len() == 0:
        return ""
    val base = _basename(argv[0])
    if base == "simplebox" or base == "busybox":
        if argv.len() < 2:
            return ""
        return argv[1]
    base

export simplebox_requested_applet
