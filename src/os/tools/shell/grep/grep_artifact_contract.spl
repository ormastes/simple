# Filesystem artifact contract for the pure-Simple grep utility.
#
# This binds source behavior to its canonical guest identity without minting
# artifact bytes, a digest, loader authority, or an execution receipt.

pub const TEXT_TOOL_ARTIFACT_SCHEMA_V1: i64 = 1
pub const TEXT_TOOL_MAX_FILES_V1: i64 = 128
pub const TEXT_TOOL_MAX_FILE_BYTES_V1: u64 = 67108864u64
pub const TEXT_TOOL_READ_CHUNK_BYTES_V1: u64 = 65536u64

pub struct TextToolArtifactContractV1:
    schema_version: i64
    command: text
    canonical_path: text
    source_owner: text
    entry_source_owner: text
    entry_symbol: text
    version_line: text
    help_line: text
    max_files: i64
    max_file_bytes: u64
    read_chunk_bytes: u64
    requires_target_artifact: bool
    requires_loader_authority_token: bool

fn _grep_artifact_contract_v1() -> TextToolArtifactContractV1:
    TextToolArtifactContractV1(
        schema_version: TEXT_TOOL_ARTIFACT_SCHEMA_V1,
        command: "grep",
        canonical_path: "/usr/bin/grep",
        source_owner: "os.tools.shell.grep.grep_tool",
        entry_source_owner: "os.apps.coreutils.grep",
        entry_symbol: "main_grep",
        version_line: "grep (SimpleOS text tools) 1.0",
        help_line: "usage: grep [--] PATTERN FILE...",
        max_files: TEXT_TOOL_MAX_FILES_V1,
        max_file_bytes: TEXT_TOOL_MAX_FILE_BYTES_V1,
        read_chunk_bytes: TEXT_TOOL_READ_CHUNK_BYTES_V1,
        requires_target_artifact: true,
        requires_loader_authority_token: true,
    )

pub fn text_tool_artifact_contract_v1(
    command: text
) -> Result<TextToolArtifactContractV1, text>:
    if command == "grep":
        return Ok(_grep_artifact_contract_v1())
    Err("text-tool-command-unknown")

pub fn text_tool_canonical_path_v1(command: text) -> text:
    val contract = text_tool_artifact_contract_v1(command)
    match contract:
        case Ok(value): value.canonical_path
        case Err(_): ""

pub fn text_tool_artifact_contract_valid_v1(
    contract: TextToolArtifactContractV1
) -> bool:
    if contract.schema_version != TEXT_TOOL_ARTIFACT_SCHEMA_V1:
        return false
    val expected = text_tool_artifact_contract_v1(contract.command)
    match expected:
        case Err(_): false
        case Ok(value):
            contract.canonical_path == value.canonical_path and
                contract.source_owner == value.source_owner and
                contract.entry_source_owner == value.entry_source_owner and
                contract.entry_symbol == value.entry_symbol and
                contract.version_line == value.version_line and
                contract.help_line == value.help_line and
                contract.max_files == value.max_files and
                contract.max_file_bytes == value.max_file_bytes and
                contract.read_chunk_bytes == value.read_chunk_bytes and
                contract.requires_target_artifact and
                contract.requires_loader_authority_token
