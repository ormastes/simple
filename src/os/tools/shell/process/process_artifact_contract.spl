# Canonical artifact identity for the process-monitoring utility.
pub const PROCESS_TOOL_ARTIFACT_SCHEMA_V1: i64 = 1
pub const PROCESS_TOOL_MAX_TASKS_V1: i64 = 256
pub const PROCESS_TOOL_MAX_ARGS_V1: i64 = 32

pub struct ProcessToolArtifactContractV1:
    schema_version: i64
    command: text
    canonical_path: text
    source_owner: text
    entry_source_owner: text
    entry_symbol: text
    version_line: text
    help_line: text
    max_tasks: i64
    max_args: i64
    requires_target_artifact: bool
    requires_loader_authority_token: bool

pub fn process_tool_artifact_contract_v1(command: text) -> Result<ProcessToolArtifactContractV1, text>:
    if command != "ps": return Err("process-tool-command-unknown")
    Ok(ProcessToolArtifactContractV1(
        schema_version: PROCESS_TOOL_ARTIFACT_SCHEMA_V1,
        command: command,
        canonical_path: "/usr/bin/ps",
        source_owner: "os.tools.proc.ps_tool",
        entry_source_owner: "os.apps.coreutils.ps",
        entry_symbol: "main_ps",
        version_line: "ps (SimpleOS core tools) 1.0",
        help_line: "usage: ps [-a] [-l] [-p PID]",
        max_tasks: PROCESS_TOOL_MAX_TASKS_V1,
        max_args: PROCESS_TOOL_MAX_ARGS_V1,
        requires_target_artifact: true,
        requires_loader_authority_token: true))

pub fn process_tool_artifact_contract_valid_v1(
    contract: ProcessToolArtifactContractV1
) -> bool:
    val expected = process_tool_artifact_contract_v1(contract.command)
    match expected:
        case Err(_): false
        case Ok(value):
            contract.schema_version == PROCESS_TOOL_ARTIFACT_SCHEMA_V1 and
                contract.canonical_path == value.canonical_path and
                contract.source_owner == value.source_owner and
                contract.entry_source_owner == value.entry_source_owner and
                contract.entry_symbol == value.entry_symbol and
                contract.version_line == value.version_line and
                contract.help_line == value.help_line and
                contract.max_tasks == value.max_tasks and
                contract.max_args == value.max_args and
                contract.requires_target_artifact and
                contract.requires_loader_authority_token

pub fn process_tool_canonical_path_v1(command: text) -> text:
    val contract = process_tool_artifact_contract_v1(command)
    match contract:
        case Ok(value): value.canonical_path
        case Err(_): ""
