# Filesystem artifact contract for the pure-Simple checksum utilities.
#
# This declares identity and observable CLI behavior only. It does not mint an
# artifact digest, loader authority, or execution receipt.

pub const CHECKSUM_TOOL_ARTIFACT_SCHEMA_V1: i64 = 1
pub const CHECKSUM_TOOL_MAX_FILES_V1: i64 = 128
pub const CHECKSUM_TOOL_MAX_FILE_BYTES_V1: u64 = 67108864u64
pub const CHECKSUM_TOOL_READ_CHUNK_BYTES_V1: u64 = 65536u64

pub struct ChecksumToolArtifactContractV1:
    schema_version: i64
    command: text
    canonical_path: text
    source_owner: text
    entry_source_owner: text
    entry_symbol: text
    version_line: text
    help_line: text
    max_files: i64
    max_file_bytes: u64
    read_chunk_bytes: u64
    requires_target_artifact: bool
    requires_loader_authority_token: bool

fn _checksum_tool_contract_v1(command: text, entry_symbol: text) -> ChecksumToolArtifactContractV1:
    ChecksumToolArtifactContractV1(
        schema_version: CHECKSUM_TOOL_ARTIFACT_SCHEMA_V1,
        command: command,
        canonical_path: "/usr/bin/{command}",
        source_owner: "os.tools.shell.checksum.checksum_tool",
        entry_source_owner: "os.apps.coreutils.checksum",
        entry_symbol: entry_symbol,
        version_line: "{command} (SimpleOS core tools) 1.0",
        help_line: "usage: {command} [--] FILE...",
        max_files: CHECKSUM_TOOL_MAX_FILES_V1,
        max_file_bytes: CHECKSUM_TOOL_MAX_FILE_BYTES_V1,
        read_chunk_bytes: CHECKSUM_TOOL_READ_CHUNK_BYTES_V1,
        requires_target_artifact: true,
        requires_loader_authority_token: true,
    )

pub fn checksum_tool_artifact_contract_v1(
    command: text
) -> Result<ChecksumToolArtifactContractV1, text>:
    match command:
        "sha256sum": Ok(_checksum_tool_contract_v1(command, "main_sha256sum"))
        "md5sum": Ok(_checksum_tool_contract_v1(command, "main_md5sum"))
        _: Err("checksum-tool-command-unknown")

pub fn checksum_tool_canonical_path_v1(command: text) -> text:
    val contract = checksum_tool_artifact_contract_v1(command)
    match contract:
        case Ok(value): value.canonical_path
        case Err(_): ""

pub fn checksum_tool_artifact_contract_valid_v1(
    contract: ChecksumToolArtifactContractV1
) -> bool:
    if contract.schema_version != CHECKSUM_TOOL_ARTIFACT_SCHEMA_V1:
        return false
    val expected = checksum_tool_artifact_contract_v1(contract.command)
    match expected:
        case Err(_): false
        case Ok(value):
            contract.canonical_path == value.canonical_path and
                contract.source_owner == value.source_owner and
                contract.entry_source_owner == value.entry_source_owner and
                contract.entry_symbol == value.entry_symbol and
                contract.version_line == value.version_line and
                contract.help_line == value.help_line and
                contract.max_files == value.max_files and
                contract.max_file_bytes == value.max_file_bytes and
                contract.read_chunk_bytes == value.read_chunk_bytes and
                contract.requires_target_artifact and
                contract.requires_loader_authority_token
