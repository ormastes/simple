# md5sum / sha256sum — Compute checksums
# MDSOC: feature dimension, shell layer

use os.apps.terminal.terminal.{Terminal}
use os.services.vfs.vfs.{VfsManager}
use os.tools.shell.shell_helpers.{resolve_path, write_line, write_error}
use os.tools.shell.checksum.checksum_artifact_contract.{
    CHECKSUM_TOOL_MAX_FILES_V1,
    CHECKSUM_TOOL_MAX_FILE_BYTES_V1,
    CHECKSUM_TOOL_READ_CHUNK_BYTES_V1
}
use os.crypto.sha256.{sha256}
use std.crypto.legacy_hash.{md5_bytes}

fn tool_md5sum(vfs: VfsManager?, cwd: text, args: [text], terminal: Terminal) -> i32:
    """Compute MD5 checksum of files."""
    _checksum_files(vfs, cwd, args, "md5", terminal)

fn tool_sha256sum(vfs: VfsManager?, cwd: text, args: [text], terminal: Terminal) -> i32:
    """Compute SHA-256 checksum of files."""
    _checksum_files(vfs, cwd, args, "sha256", terminal)

pub fn simpleos_checksum_digest_bytes(data: [u8], algo: text) -> Result<text, text>:
    """Return an exact lower-case digest for one admitted algorithm."""
    if algo == "sha256":
        return Ok(_u8_hex(sha256(data)))
    if algo == "md5":
        var legacy: [i64] = []
        for byte in data:
            legacy.push(byte.to_i64())
        return Ok(_i64_hex(md5_bytes(legacy)))
    Err("unsupported checksum algorithm: {algo}")

fn _u8_hex(bytes: [u8]) -> text:
    val digits = "0123456789abcdef"
    var result = ""
    for byte in bytes:
        val value = byte.to_i64()
        result = result + digits.slice(value >> 4, (value >> 4) + 1)
        result = result + digits.slice(value & 15, (value & 15) + 1)
    result

fn _i64_hex(bytes: [i64]) -> text:
    val digits = "0123456789abcdef"
    var result = ""
    for raw in bytes:
        val value = raw & 255
        result = result + digits.slice(value >> 4, (value >> 4) + 1)
        result = result + digits.slice(value & 15, (value & 15) + 1)
    result

fn _read_bounded_bytes(vfs: VfsManager, path: text) -> Result<[u8], text>:
    vfs.read_bytes_bounded(
        path, CHECKSUM_TOOL_MAX_FILE_BYTES_V1, CHECKSUM_TOOL_READ_CHUNK_BYTES_V1
    )

fn _checksum_files(vfs: VfsManager?, cwd: text, args: [text], algo: text, terminal: Terminal) -> i32:
    """Compute checksum for each file in args."""
    val program = "{algo}sum"
    if args.len() == 0:
        write_error(terminal, "{program}: missing file operand")
        return 1
    if args.len() == 1 and args[0] == "--version":
        write_line(terminal, "{program} (SimpleOS core tools) 1.0")
        return 0
    if args.len() == 1 and args[0] == "--help":
        write_line(terminal, "usage: {program} [--] FILE...")
        return 0
    if args.len() > CHECKSUM_TOOL_MAX_FILES_V1 + 1:
        write_error(terminal, "{program}: too many file operands")
        return 2
    if vfs == nil:
        write_error(terminal, "{program}: no filesystem mounted")
        return 1
    var exit_code: i32 = 0
    var end_options = false
    var file_count: i64 = 0
    for filename in args:
        if not end_options and filename == "--":
            end_options = true
            continue
        if not end_options and filename.starts_with("-"):
            write_error(terminal, "{program}: unsupported option: {filename}")
            return 2
        file_count = file_count + 1
        if file_count > CHECKSUM_TOOL_MAX_FILES_V1:
            write_error(terminal, "{program}: too many file operands")
            return 2
        val path = resolve_path(cwd, filename)
        val result = _read_bounded_bytes(vfs, path)
        match result:
            case Ok(content):
                val digest = simpleos_checksum_digest_bytes(content, algo)
                match digest:
                    case Ok(hash): write_line(terminal, "{hash}  {filename}")
                    case Err(reason):
                        write_error(terminal, "{program}: {reason}")
                        return 2
            case Err(err):
                write_error(terminal, "{program}: {path}: {err}")
                exit_code = 1
    if file_count == 0:
        write_error(terminal, "{program}: missing file operand")
        return 1
    exit_code

export tool_md5sum, tool_sha256sum, simpleos_checksum_digest_bytes
