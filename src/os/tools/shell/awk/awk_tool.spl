# awk — Basic POSIX awk: field splitting, pattern/action, BEGIN/END
# MDSOC: feature dimension, shell layer
use os.apps.terminal.terminal.{Terminal}
use os.services.vfs.vfs.{VfsManager}
use os.tools.shell.shell_helpers.{resolve_path, write_line, write_error, split_lines}

fn tool_awk(vfs: VfsManager?, cwd: text, args: [text], terminal: Terminal, input: text) -> i32:
    """Basic POSIX awk interpreter.

    Supports: -F sep, BEGIN/END blocks, /pattern/ { action }, { action }.
    Actions: print, print $N, printf fmt, next.
    Variables: $0, $1..$NF, NR, NF.
    The optional `input` parameter supplies piped stdin content.
    """
    if args.len() == 0:
        write_error(terminal, "awk: usage: awk [-F sep] 'program' [file...]")
        return 1

    # --- Parse arguments ---
    var field_sep = " "
    var program = ""
    var file_args: [text] = []
    var i = 0
    while i < args.len():
        if args[i] == "-F" and i + 1 < args.len():
            i = i + 1
            field_sep = args[i]
        elif args[i].starts_with("-F") and args[i].len() > 2:
            field_sep = args[i].slice(2, args[i].len())
        elif program == "":
            program = args[i]
        else:
            file_args = file_args.push(args[i])
        i = i + 1

    if program == "":
        write_error(terminal, "awk: no program given")
        return 1

    # --- Parse program into blocks ---
    val begin_src = _extract_block(program, "BEGIN")
    val end_src   = _extract_block(program, "END")
    val rules     = _extract_rules(program)

    var nr = 0
    # awk user-variable environment, threaded through every action so that
    # accumulations survive across records and are visible in END.
    var vars: [(text, text)] = []
    # Set when any action reports an unsupported statement (ctrl == 2).
    var had_error = false

    # --- BEGIN block ---
    if begin_src.len() > 0:
        val begin_res = _exec_action(begin_src, "", [], nr, 0, field_sep, terminal, vars)
        vars = begin_res.1
        if begin_res.0 == 2:
            had_error = true

    # --- Process files ---
    if file_args.len() == 0:
        # No files: process piped input if provided
        if input.len() > 0:
            val lines = split_lines(input)
            for line in lines:
                if line.len() == 0:
                    pass_dn
                else:
                    nr = nr + 1
                    val fields = _split_fields(line, field_sep)
                    val nf = fields.len()
                    var matched_next = false
                    var ri = 0
                    while ri < rules.len() and not matched_next:
                        val rule = rules[ri]
                        val pattern = rule.0
                        val action  = rule.1
                        val matches = _pattern_matches(pattern, line, nr)
                        if matches:
                            val act_pipe = _exec_action(action, line, fields, nr, nf, field_sep, terminal, vars)
                            vars = act_pipe.1
                            if act_pipe.0 == 2:
                                had_error = true
                            if act_pipe.0 == 1:
                                matched_next = true
                        ri = ri + 1
        else:
            pass_dn
    else:
        var fi = 0
        while fi < file_args.len():
            val farg = file_args[fi]
            if farg == "-":
                # Read from piped input
                val lines = split_lines(input)
                for line in lines:
                    if line.len() == 0:
                        pass_dn
                    else:
                        nr = nr + 1
                        val fields = _split_fields(line, field_sep)
                        val nf = fields.len()
                        var matched_next = false
                        var ri = 0
                        while ri < rules.len() and not matched_next:
                            val rule = rules[ri]
                            val pattern = rule.0
                            val action  = rule.1
                            val matches = _pattern_matches(pattern, line, nr)
                            if matches:
                                val act_dash = _exec_action(action, line, fields, nr, nf, field_sep, terminal, vars)
                                vars = act_dash.1
                                if act_dash.0 == 2:
                                    had_error = true
                                if act_dash.0 == 1:
                                    matched_next = true
                            ri = ri + 1
            else:
                val path = resolve_path(cwd, farg)
                if vfs == nil:
                    write_error(terminal, "awk: no filesystem mounted")
                    return 1
                val read_result = vfs.read_text(path)
                match read_result:
                    Ok(content):
                        val lines = split_lines(content)
                        for line in lines:
                            if line.len() == 0:
                                pass_dn
                            else:
                                nr = nr + 1
                                val fields = _split_fields(line, field_sep)
                                val nf = fields.len()
                                var matched_next = false
                                var ri = 0
                                while ri < rules.len() and not matched_next:
                                    val rule = rules[ri]
                                    val pattern = rule.0
                                    val action  = rule.1
                                    val matches = _pattern_matches(pattern, line, nr)
                                    if matches:
                                        val act_file = _exec_action(action, line, fields, nr, nf, field_sep, terminal, vars)
                                        vars = act_file.1
                                        if act_file.0 == 2:
                                            had_error = true
                                        if act_file.0 == 1:
                                            matched_next = true
                                    ri = ri + 1
                    Err(err):
                        write_error(terminal, "awk: {path}: {err}")
                        fi = fi + 1
                        pass_do_nothing
            fi = fi + 1

    # --- END block ---
    # END is the last action to run, so its returned environment is discarded.
    if end_src.len() > 0:
        val end_res = _exec_action(end_src, "", [], nr, 0, field_sep, terminal, vars)
        if end_res.0 == 2:
            had_error = true

    if had_error:
        write_error(terminal, "awk: unsupported statement in program")
        return 1
    return 0

# ---------------------------------------------------------------------------
# Program parsing helpers
# ---------------------------------------------------------------------------

fn _extract_block(program: text, keyword: text) -> text:
    """Extract body of a BEGIN or END block, or empty string if absent."""
    val needle = "{keyword} {"
    val needle2 = "{keyword}{"
    var start = -1
    # Find keyword occurrence
    if program.contains(needle):
        start = _find_after(program, needle)
    elif program.contains(needle2):
        start = _find_after(program, needle2)
    if start < 0:
        return ""
    # Find matching closing brace
    var depth = 1
    var pos = start
    var body = ""
    while pos < program.len() and depth > 0:
        val ch = program.char_at(pos)
        if ch == "{":
            depth = depth + 1
            if depth > 1:
                body = "{body}{ch}"
        elif ch == "}":
            depth = depth - 1
            if depth > 0:
                body = "{body}{ch}"
        else:
            body = "{body}{ch}"
        pos = pos + 1
    return body.trim()

fn _find_after(program: text, needle: text) -> i32:
    """Return index immediately after the first occurrence of needle in program, or -1."""
    var i = 0
    val plen = program.len()
    val nlen = needle.len()
    while i <= plen - nlen:
        if program.slice(i, i + nlen) == needle:
            return i + nlen
        i = i + 1
    return -1

fn _extract_rules(program: text) -> [(text, text)]:
    """Extract (pattern, action) pairs, excluding BEGIN/END blocks.

    Patterns: /regex/, !/regex/, NR==N, or empty (bare action).
    """
    var rules: [(text, text)] = []
    # Remove BEGIN and END blocks first
    val cleaned = _remove_block(program, "BEGIN")
    val cleaned2 = _remove_block(cleaned, "END")
    # Now parse remaining pattern { action } blocks
    var pos = 0
    val plen = cleaned2.len()
    while pos < plen:
        val ch = cleaned2.char_at(pos)
        # Skip whitespace
        if ch == " " or ch == "\n" or ch == "\t" or ch == "\r":
            pos = pos + 1
        elif ch == "{":
            # Bare action (no pattern)
            pos = pos + 1
            val body_pair = _read_brace_body(cleaned2, pos)
            rules = rules.push(("", body_pair.0.trim()))
            pos = body_pair.1
        elif ch == "!" and pos + 1 < plen and cleaned2.char_at(pos + 1) == "/":
            # !/pattern/ { action } — negation
            pos = pos + 2  # skip !/
            var pattern = "!"
            while pos < plen and cleaned2.char_at(pos) != "/":
                pattern = "{pattern}{cleaned2.char_at(pos)}"
                pos = pos + 1
            pos = pos + 1  # consume closing /
            # Skip whitespace until '{'
            while pos < plen and (cleaned2.char_at(pos) == " " or cleaned2.char_at(pos) == "\t"):
                pos = pos + 1
            if pos < plen and cleaned2.char_at(pos) == "{":
                pos = pos + 1
                val body_neg = _read_brace_body(cleaned2, pos)
                rules = rules.push((pattern, body_neg.0.trim()))
                pos = body_neg.1
        elif ch == "/":
            # /pattern/ { action }
            pos = pos + 1
            var pattern = ""
            while pos < plen and cleaned2.char_at(pos) != "/":
                pattern = "{pattern}{cleaned2.char_at(pos)}"
                pos = pos + 1
            pos = pos + 1  # consume closing /
            # Skip whitespace until '{'
            while pos < plen and (cleaned2.char_at(pos) == " " or cleaned2.char_at(pos) == "\t"):
                pos = pos + 1
            if pos < plen and cleaned2.char_at(pos) == "{":
                pos = pos + 1
                val body_pair2 = _read_brace_body(cleaned2, pos)
                rules = rules.push((pattern, body_pair2.0.trim()))
                pos = body_pair2.1
        else:
            # Read a word pattern (e.g. NR==2) until '{'
            var word_pat = ""
            while pos < plen and cleaned2.char_at(pos) != "{" and cleaned2.char_at(pos) != "\n":
                word_pat = "{word_pat}{cleaned2.char_at(pos)}"
                pos = pos + 1
            val word_pat_t = word_pat.trim()
            if word_pat_t.len() > 0 and pos < plen and cleaned2.char_at(pos) == "{":
                pos = pos + 1
                val body_word = _read_brace_body(cleaned2, pos)
                rules = rules.push(("NR_EXPR:{word_pat_t}", body_word.0.trim()))
                pos = body_word.1
            else:
                pos = pos + 1
    return rules

fn _eval_nr_expr(expr: text, nr: i32) -> bool:
    """Evaluate an NR comparison pattern such as NR==2 against the current record number."""
    val e = expr.trim()
    if e.starts_with("NR=="):
        val rhs_eq = e.slice(4, e.len()).trim()
        val v_eq = rhs_eq.to_i32()
        return nr == v_eq
    elif e.starts_with("NR!="):
        val rhs_ne = e.slice(4, e.len()).trim()
        val v_ne = rhs_ne.to_i32()
        return nr != v_ne
    elif e.starts_with("NR>"):
        val rhs_gt = e.slice(3, e.len()).trim()
        val v_gt = rhs_gt.to_i32()
        return nr > v_gt
    elif e.starts_with("NR<"):
        val rhs_lt = e.slice(3, e.len()).trim()
        val v_lt = rhs_lt.to_i32()
        return nr < v_lt
    return false

fn _pattern_matches(pattern: text, line: text, nr: i32) -> bool:
    """Evaluate a rule pattern from _extract_rules against the current record.

    Empty pattern matches every record; "NR_EXPR:..." is an NR comparison;
    a leading "!" negates; anything else is a substring match.
    """
    if pattern == "":
        return true
    elif pattern.starts_with("NR_EXPR:"):
        val nr_src = pattern.slice(8, pattern.len())
        return _eval_nr_expr(nr_src, nr)
    elif pattern.starts_with("!"):
        val neg_src = pattern.slice(1, pattern.len())
        return not line.contains(neg_src)
    return line.contains(pattern)

fn _remove_block(program: text, keyword: text) -> text:
    """Remove a BEGIN or END block from program text."""
    val needle  = "{keyword} {"
    val needle2 = "{keyword}{"
    var start_kw = -1
    var after_open = -1
    if program.contains(needle):
        start_kw   = _find_str(program, needle)
        after_open = start_kw + needle.len()
    elif program.contains(needle2):
        start_kw   = _find_str(program, needle2)
        after_open = start_kw + needle2.len()
    if start_kw < 0:
        return program
    # Find closing brace
    var depth = 1
    var pos = after_open
    while pos < program.len() and depth > 0:
        val ch = program.char_at(pos)
        if ch == "{":
            depth = depth + 1
        elif ch == "}":
            depth = depth - 1
        pos = pos + 1
    val before = program.slice(0, start_kw)
    val after  = program.slice(pos, program.len())
    return "{before}{after}"

fn _find_str(s: text, needle: text) -> i32:
    """Return index of first occurrence of needle in s, or -1."""
    var i = 0
    val slen = s.len()
    val nlen = needle.len()
    while i <= slen - nlen:
        if s.slice(i, i + nlen) == needle:
            return i
        i = i + 1
    return -1

fn _read_brace_body(program: text, start: i32) -> (text, i32):
    """Read text until matching closing brace (depth 1 already consumed).

    Returns (body, position_after_closing_brace).
    """
    var body = ""
    var depth = 1
    var pos = start
    val plen = program.len()
    while pos < plen and depth > 0:
        val ch = program.char_at(pos)
        if ch == "{":
            depth = depth + 1
            body = "{body}{ch}"
        elif ch == "}":
            depth = depth - 1
            if depth > 0:
                body = "{body}{ch}"
        else:
            body = "{body}{ch}"
        pos = pos + 1
    return (body, pos)

# ---------------------------------------------------------------------------
# Field splitting
# ---------------------------------------------------------------------------

fn _split_fields(line: text, sep: text) -> [text]:
    """Split line into fields using sep. Default ' ' means any whitespace run."""
    if sep == " ":
        return _split_whitespace(line)
    var fields: [text] = []
    var cur = ""
    for ch in line:
        if ch == sep:
            fields = fields.push(cur)
            cur = ""
        else:
            cur = "{cur}{ch}"
    fields = fields.push(cur)
    return fields

fn _split_whitespace(line: text) -> [text]:
    """Split on runs of spaces/tabs."""
    var fields: [text] = []
    var cur = ""
    for ch in line:
        if ch == " " or ch == "\t":
            if cur.len() > 0:
                fields = fields.push(cur)
                cur = ""
        else:
            cur = "{cur}{ch}"
    if cur.len() > 0:
        fields = fields.push(cur)
    return fields

# ---------------------------------------------------------------------------
# Action execution
# ---------------------------------------------------------------------------

fn _exec_action(action: text, line: text, fields: [text], nr: i32, nf: i32, sep: text, terminal: Terminal, vars: [(text, text)]) -> (i32, [(text, text)]):
    """Execute an action string. Returns (ctrl, vars) where ctrl=1 means 'next'."""
    # Split on semicolons and newlines
    var stmts: [text] = []
    var cur_stmt = ""
    var ai = 0
    while ai < action.len():
        val ac = action.char_at(ai)
        if ac == ";" or ac == "\n":
            val trimmed_s = cur_stmt.trim()
            if trimmed_s.len() > 0:
                stmts = stmts.push(trimmed_s)
            cur_stmt = ""
        else:
            cur_stmt = "{cur_stmt}{ac}"
        ai = ai + 1
    val last_s = cur_stmt.trim()
    if last_s.len() > 0:
        stmts = stmts.push(last_s)

    var cur_vars = vars
    for stmt in stmts:
        val s = stmt.trim()
        if s.len() == 0:
            pass_dn
        elif s == "next":
            return (1, cur_vars)
        elif s == "print" or s == "print $0":
            write_line(terminal, line)
        elif s.starts_with("print "):
            val rest = s.slice(6, s.len()).trim()
            val resolved = _resolve_multi_expr(rest, line, fields, nr, nf, cur_vars)
            write_line(terminal, resolved)
        elif s.starts_with("printf "):
            val rest2 = s.slice(7, s.len()).trim()
            val formatted = _exec_printf(rest2, line, fields, nr, nf, cur_vars)
            terminal.write_string(formatted)
        elif _is_assignment(s):
            # Variable assignment / accumulation: sum += $1, n++, var = expr
            cur_vars = _exec_assign(s, line, fields, nr, nf, cur_vars)
        else:
            # Statement is none of the supported forms — report a program error.
            return (2, cur_vars)
    return (0, cur_vars)

fn _is_assignment(stmt: text) -> bool:
    """True when stmt has the shape of an awk assignment: name=, name+=, name++, name--."""
    val s = stmt.trim()
    if s.ends_with("++") or s.ends_with("--"):
        return s.len() > 2
    val eq = _find_str(s, "=")
    return eq > 0

fn _resolve_expr(expr: text, line: text, fields: [text], nr: i32, nf: i32, vars: [(text, text)]) -> text:
    """Resolve a simple expression: $N, NR, NF, a user variable, or literal text."""
    val trimmed = expr.trim()
    if trimmed == "$0":
        return line
    elif trimmed == "NR":
        return "{nr}"
    elif trimmed == "NF":
        return "{nf}"
    elif trimmed == "$NF":
        if nf > 0:
            return fields[nf - 1]
        return ""
    elif trimmed.starts_with("$"):
        val idx_str = trimmed.slice(1, trimmed.len())
        val idx = idx_str.to_i32()
        if idx > 0 and idx <= fields.len():
            return fields[idx - 1]
        return ""
    else:
        # Strip surrounding quotes if present
        if (trimmed.starts_with("\"") and trimmed.ends_with("\"")) and trimmed.len() >= 2:
            return trimmed.slice(1, trimmed.len() - 1)
        # A bare word may name a user variable set by a previous action
        var vi = 0
        while vi < vars.len():
            val pair = vars[vi]
            if pair.0 == trimmed:
                return pair.1
            vi = vi + 1
        return trimmed

# ---------------------------------------------------------------------------
# Variable environment
# ---------------------------------------------------------------------------

fn _var_get(vars: [(text, text)], name: text) -> text:
    """Return the value bound to name, or "" when unset."""
    var vi = 0
    while vi < vars.len():
        val pair = vars[vi]
        if pair.0 == name:
            return pair.1
        vi = vi + 1
    return ""

fn _var_set(vars: [(text, text)], name: text, value: text) -> [(text, text)]:
    """Return vars with name bound to value, replacing any existing binding."""
    var out: [(text, text)] = []
    var found = false
    var vi = 0
    while vi < vars.len():
        val pair = vars[vi]
        if pair.0 == name:
            out = out.push((name, value))
            found = true
        else:
            out = out.push(pair)
        vi = vi + 1
    if not found:
        out = out.push((name, value))
    return out

fn _split_top_commas(s: text) -> [text]:
    """Split on commas that are not inside a double-quoted string."""
    var parts: [text] = []
    var cur = ""
    var in_quote = false
    var si = 0
    while si < s.len():
        val ch = s.char_at(si)
        if ch == "\"":
            in_quote = not in_quote
            cur = "{cur}{ch}"
        elif ch == "," and not in_quote:
            parts = parts.push(cur.trim())
            cur = ""
        else:
            cur = "{cur}{ch}"
        si = si + 1
    val last_p = cur.trim()
    if last_p.len() > 0:
        parts = parts.push(last_p)
    return parts

# ---------------------------------------------------------------------------
# Action statement evaluation
# ---------------------------------------------------------------------------

fn _resolve_multi_expr(expr: text, line: text, fields: [text], nr: i32, nf: i32, vars: [(text, text)]) -> text:
    """Resolve a comma-separated print list, joining the parts with OFS (space)."""
    val parts = _split_top_commas(expr)
    var out = ""
    var pi = 0
    while pi < parts.len():
        val piece = _resolve_expr(parts[pi], line, fields, nr, nf, vars)
        if pi == 0:
            out = piece
        else:
            out = "{out} {piece}"
        pi = pi + 1
    return out

fn _exec_printf(args_src: text, line: text, fields: [text], nr: i32, nf: i32, vars: [(text, text)]) -> text:
    """Format a printf statement. First element is the format, the rest are its arguments."""
    val parts = _split_top_commas(args_src)
    if parts.len() == 0:
        return ""
    var fmt = parts[0].trim()
    if (fmt.starts_with("\"") and fmt.ends_with("\"")) and fmt.len() >= 2:
        fmt = fmt.slice(1, fmt.len() - 1)
    var out = ""
    var next_arg = 1
    var fi = 0
    while fi < fmt.len():
        val ch = fmt.char_at(fi)
        if ch == "\\" and fi + 1 < fmt.len():
            val esc = fmt.char_at(fi + 1)
            if esc == "n":
                out = "{out}\n"
            elif esc == "t":
                out = "{out}\t"
            else:
                out = "{out}{esc}"
            fi = fi + 2
        elif ch == "%" and fi + 1 < fmt.len():
            val spec = fmt.char_at(fi + 1)
            if spec == "%":
                out = "{out}%"
            elif next_arg < parts.len():
                val raw = _resolve_expr(parts[next_arg], line, fields, nr, nf, vars)
                if spec == "d" or spec == "i":
                    val raw_t = raw.trim()
                    val n = raw_t.to_i32()
                    out = "{out}{n}"
                else:
                    out = "{out}{raw}"
                next_arg = next_arg + 1
            fi = fi + 2
        else:
            out = "{out}{ch}"
            fi = fi + 1
    return out

fn _exec_assign(stmt: text, line: text, fields: [text], nr: i32, nf: i32, vars: [(text, text)]) -> [(text, text)]:
    """Apply a variable assignment: name++, name--, name += expr, name -= expr, name = expr."""
    val s = stmt.trim()
    if s.ends_with("++") and s.len() > 2:
        val name_i = s.slice(0, s.len() - 2).trim()
        val cur_i = _var_get(vars, name_i).trim().to_i32() + 1
        return _var_set(vars, name_i, "{cur_i}")
    elif s.ends_with("--") and s.len() > 2:
        val name_d = s.slice(0, s.len() - 2).trim()
        val cur_d = _var_get(vars, name_d).trim().to_i32() - 1
        return _var_set(vars, name_d, "{cur_d}")
    val eq = _find_str(s, "=")
    if eq <= 0:
        return vars
    var op = ""
    var name_end = eq
    val prev = s.char_at(eq - 1)
    if prev == "+" or prev == "-":
        op = prev
        name_end = eq - 1
    val name = s.slice(0, name_end).trim()
    if name.len() == 0:
        return vars
    val rhs = s.slice(eq + 1, s.len()).trim()
    val value = _resolve_expr(rhs, line, fields, nr, nf, vars)
    if op == "+":
        val sum = _var_get(vars, name).trim().to_i32() + value.trim().to_i32()
        return _var_set(vars, name, "{sum}")
    elif op == "-":
        val diff = _var_get(vars, name).trim().to_i32() - value.trim().to_i32()
        return _var_set(vars, name, "{diff}")
    return _var_set(vars, name, value)
