# ssh — SSH client
# MDSOC: feature dimension, apps layer
#
# Complete client state machine: version exchange → KEXINIT → KEX ECDH →
# key derivation → NEWKEYS → service request → userauth (password) →
# channel open → pty-req + shell → bidirectional I/O loop.

# Split from src/os/tools/net/ssh_tool.spl to keep module cohesion under the 800-line source limit.
export use os.tools.net._SshTool.transport.{rt_stdin_read_line, rt_string_to_byte_array, rt_io_tcp_connect, rt_io_tcp_read, rt_io_tcp_write, rt_io_tcp_close, ClientSocket, send_encrypted, recv_encrypted}
export use os.tools.net._SshTool.run.{rt_stdin_read_line, rt_string_to_byte_array, rt_io_tcp_connect, rt_io_tcp_read, rt_io_tcp_write, rt_io_tcp_close, run_ssh, rt_string_from_byte_array}
