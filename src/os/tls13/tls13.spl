# TLS 1.3 Client State Machine — RFC 8446
#
# Orchestrates the full TLS 1.3 client handshake:
#   ClientHello → ServerHello → EncryptedExtensions → Certificate →
#   CertificateVerify → server Finished → client Finished → App data
#
# Uses AES-128-GCM cipher suite (TLS_AES_128_GCM_SHA256, 0x1301).
# Ed25519-only certificates (Phase 1).

# Split from src/os/tls13/tls13.spl to keep module cohesion under the 800-line source limit.
export use os.tls13._Tls13.context_io.{rt_time_now_unix_micros, rt_net_close, rt_net_send_bytes, rt_net_recv_bytes, rt_thread_sleep, rt_tls13_recv_record, rt_bytes_u8_at, rt_array_new_with_cap, rt_ipc_send_bytes, rt_ipc_recv_bytes, rt_tls13_serverhello_x25519_pub, rt_tls13_record_serverhello_x25519_pub, rt_tls13_transcript_hash_record_payloads, rt_tls13_build_client_hello, rt_tls13_build_client_hello_record, rt_tls13_x25519_shared_secret, rt_tls13_handshake_secret_from_record, rt_tls13_hkdf_extract, rt_tls13_hkdf_expand_label, rt_tls13_hkdf_expand_label_derived, rt_tls13_hkdf_expand_label_key, rt_tls13_hkdf_expand_label_iv, rt_tls13_hkdf_expand_label_finished, rt_tls13_hkdf_expand_label_client_hs, rt_tls13_hkdf_expand_label_server_hs, rt_tls13_prepare_app_secrets_7, rt_tls13_take_cached_client_app_secret, rt_tls13_take_cached_server_app_secret, rt_tls13_sha256, rt_tls13_transcript_hash_2, rt_tls13_transcript_hash_6, rt_tls13_transcript_hash_finished_fd, rt_tls13_find_handshake_message, rt_tls13_record_find_handshake_message, rt_tls13_record_find_handshake_message_fd, rt_tls13_record_payload_len, rt_tls13_record_content_type, rt_tls13_verify_data_hmac, rt_tls13_bytes_equal, rt_tls13_finished_msg_verify_data, rt_tls13_server_finished_verify_data_fd, rt_tls13_certificate_body_ed25519_pubkey, rt_tls13_certificate_verify_algorithm, rt_tls13_certificate_verify_signature, rt_tls13_certificate_verify_msg_algorithm, rt_tls13_certificate_verify_msg_signature, rt_tls13_inner_plaintext_type, rt_tls13_inner_plaintext_content, rt_ed25519_verify, rt_tls13_ed25519_verify, Tls13Context, Tls13RecvData, Tls13SendResult, Tls13CloseResult, Tls13ConnectResult, Tls13ClientConfig, Tls13Io, tls13_verification_time, tls13_ct_bytes_equal, PskCh}
export use os.tls13._Tls13.psk_connect.{tls13_default_client_config, tls13_connect, tls13_connect_with_config, tls13_connect_host_stream, tls13_connect_host_stream_with_config}
export use os.tls13._Tls13.handshake.{tls13_connect_io_with_config}
export use os.tls13._Tls13.data_transfer.{tls13_send, tls13_recv, tls13_close}
