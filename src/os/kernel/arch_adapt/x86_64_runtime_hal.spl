# Compile-time x86_64 privileged runtime HAL bridge for virtual memory callers.

export use os.kernel.arch.x86_64.runtime_hal.{
    hal_x86_64_read_cr3,
    hal_x86_64_write_cr3,
    hal_x86_64_read_cr3_raw,
    hal_x86_64_write_cr3_raw,
    hal_x86_64_invalidate_page,
    hal_x86_64_cr3_width_bits,
    hal_x86_64_cr3_available
}
