# Compile-time x86-32 User-Mapping Adapter
#
# Loader owners bind to this architecture boundary instead of importing the
# concrete x86-32 tree. Public re-exports preserve the existing declarations;
# no runtime dispatch, allocation, copied state, or additional call is added.

pub use os.kernel.arch.x86_32.user_page_root_owner_v1.{
    X8632UserRootLeaseV1,
    X8632LeafDispositionV1,
    x86_32_user_root_create_v1,
    x86_32_user_allocate_and_map_v1,
    x86_32_user_unmap_exact_v1,
    x86_32_user_root_destroy_unpublished_v1,
}
