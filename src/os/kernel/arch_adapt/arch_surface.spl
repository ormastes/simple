# Architecture-neutral HAL adapter root over generic kernel arch types/dispatch.
# Concrete callers import `os.kernel.hal.*` rather than reaching into `os.kernel.arch.*`.

export use os.kernel.arch.arch_context.{
    Architecture,
    ArchContext,
    X86_64Context,
    X86Context,
    Riscv64Context,
    Riscv32Context,
    Arm64Context,
    Arm32Context,
    BootArgs,
    JmpBufX86_64,
    JmpBufX86,
    JmpBufArm64,
    JmpBufArm32,
    JmpBufRv64,
    JmpBufRv32,
    JmpBuf,
    ExtendedCtxX86_64,
    ExtendedCtxArm64,
    ExtendedCtxArm32,
    ExtendedCtxRv,
    ExtendedCtx
}
export use os.kernel.arch.mod.{get_arch, get_arch_name}

pub fn current_architecture() -> Architecture:
    """Return the compile-time target architecture selected by `@cfg`."""
    get_arch()
export use os.kernel.arch.reset.{
    hal_reset_set_test_mode,
    hal_reset_requested_for_test,
    hal_system_reset
}
export use os.kernel.arch.user_entry_bridge.{
    dispatch_fs_exec_user_handoff,
    dispatch_fs_exec_user_handoff_v2
}
export use os.kernel.arch.user_handoff_result_v2.{
    UserHandoffErrorV2,
    UserHandoffResultV2,
    user_handoff_error_errno_v2,
    user_handoff_legacy_status_v2
}
