# Arch HAL: blocking console byte I/O for generic kernel/sosix code.
# Generic code calls hal_console_read_byte / hal_console_write_byte; the
# per-target body is selected by @cfg so no x86 port I/O is reachable from
# non-x86 kernels.

use os.kernel.arch.x86.com1_common.{x86_com1_read_byte, x86_com1_write_byte}
use os.kernel.arch.riscv64.console.{serial_read_byte as rv64_serial_read_byte, serial_write_byte as rv64_serial_write_byte}
use os.kernel.arch.riscv32.console.{serial_read_byte as rv32_serial_read_byte, uart_write_byte as rv32_uart_write_byte}
use os.kernel.arch.arm.pl011_common.{ARM_VIRT_PL011_BASE, pl011_write_byte}

extern fn mmio_read8(addr: u64) -> u8

@cfg(x86_64)
fn hal_console_read_byte() -> u8:
    x86_com1_read_byte()

@cfg(x86)
fn hal_console_read_byte() -> u8:
    x86_com1_read_byte()

@cfg(riscv64)
fn hal_console_read_byte() -> u8:
    var v = rv64_serial_read_byte()
    while v < 0:
        v = rv64_serial_read_byte()
    v.to_u8()

@cfg(riscv32)
fn hal_console_read_byte() -> u8:
    var v = rv32_serial_read_byte()
    while v < 0:
        v = rv32_serial_read_byte()
    v.to_u8()

@cfg(arm64)
fn hal_console_read_byte() -> u8:
    _pl011_read_byte()

@cfg(arm32)
fn hal_console_read_byte() -> u8:
    _pl011_read_byte()

fn _pl011_read_byte() -> u8:
    # PL011 FR (+0x18) bit 4 = RXFE; DR (+0x00) holds the received byte.
    while (mmio_read8(ARM_VIRT_PL011_BASE + 0x18) & 0x10u8) != 0u8:
        pass_do_nothing("spin until PL011 RX non-empty")
    mmio_read8(ARM_VIRT_PL011_BASE)

@cfg(x86_64)
fn hal_console_write_byte(byte: u8):
    x86_com1_write_byte(byte)

@cfg(x86)
fn hal_console_write_byte(byte: u8):
    x86_com1_write_byte(byte)

@cfg(riscv64)
fn hal_console_write_byte(byte: u8):
    rv64_serial_write_byte(byte)

@cfg(riscv32)
fn hal_console_write_byte(byte: u8):
    rv32_uart_write_byte(byte)

@cfg(arm64)
fn hal_console_write_byte(byte: u8):
    pl011_write_byte(ARM_VIRT_PL011_BASE, byte)

@cfg(arm32)
fn hal_console_write_byte(byte: u8):
    pl011_write_byte(ARM_VIRT_PL011_BASE, byte)
