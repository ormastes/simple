# Compile-time RV32 secure entropy bridge for architecture-neutral drivers.

export use os.kernel.arch.riscv32.secure_entropy.{
    Rv32SecureEntropyProvenance,
    Rv32SecureEntropyCandidate,
    Rv32SecureEntropyReceipt,
    rv32_admit_secure_entropy_candidate,
    rv32_current_secure_entropy,
    RV32_SECURE_ENTROPY_BYTES
}
