# Compile-time x86 Port-I/O Adapter
#
# Portable kernel owners import this boundary instead of reaching into the
# concrete x86 architecture tree.  These public re-exports are resolved at
# compile time: there is no runtime dispatch, allocation, or copied state.

pub use os.kernel.arch.x86.port_io_owner.{
    x86_port_inb,
    x86_port_outb,
    x86_port_inw,
    x86_port_outw,
    x86_port_inl,
    x86_port_outl,
    x86_port_io_wait,
}
