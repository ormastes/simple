# Compile-time RISC-V 32 User-Mapping Adapter
#
# Loader owners bind to this architecture boundary instead of importing the
# concrete RISC-V 32 tree. Public re-exports preserve existing declarations;
# no runtime dispatch, allocation, copied state, or additional call is added.

pub use os.kernel.arch.riscv32.sv32_user_root_owner_v1.{
    Riscv32Sv32RootLeaseV1,
    Riscv32Sv32RootUnreachableReceiptV1,
    riscv32_sv32_user_root_create_v1,
    riscv32_sv32_user_map_exact_v1,
    riscv32_sv32_user_unmap_exact_v1,
    riscv32_sv32_user_root_detach_v1,
    riscv32_sv32_user_root_release_detached_v1,
    riscv32_sv32_user_root_abort_fresh_v1,
    riscv32_sv32_root_unreachable_claim_v1,
}
