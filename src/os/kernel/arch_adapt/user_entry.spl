# Compile-time User-Entry Adapter
#
# Loader and syscall owners import this boundary instead of reaching into the
# concrete architecture tree. These public re-exports are resolved at compile
# time: there is no runtime dispatch, allocation, or copied state in the adapter.

pub use os.kernel.arch.user_entry_bridge.{
    dispatch_enter_user_blocking,
    dispatch_fs_exec_user_handoff,
}
