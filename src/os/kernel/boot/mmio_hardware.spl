# Raw volatile MMIO owner for production and freestanding entry closures.

@unsafe(reason: "raw volatile u64 MMIO read through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_read_u64(addr: u64) -> u64
@unsafe(reason: "raw volatile u64 MMIO write through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_write_u64(addr: u64, value: u64)
@unsafe(reason: "raw volatile u32 MMIO read through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_read_u32(addr: u64) -> u32
@unsafe(reason: "raw volatile u32 MMIO write through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_write_u32(addr: u64, value: u32)
@unsafe(reason: "raw volatile u16 MMIO read through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_read_u16(addr: u64) -> u16
@unsafe(reason: "raw volatile u16 MMIO write through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_write_u16(addr: u64, value: u16)
@unsafe(reason: "raw volatile u8 MMIO read through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_read_u8(addr: u64) -> u8
@unsafe(reason: "raw volatile u8 MMIO write through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_volatile_write_u8(addr: u64, value: u8)
@unsafe(reason: "raw native full-memory fence through an unsigned target provider", capabilities: [ffi])
extern fn rt_memory_barrier()
@cfg(arm64)
@unsafe(reason: "raw ARM64 cache clean through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_arm64_dcache_clean_range(addr: u64, size: u64)
@cfg(arm64)
@unsafe(reason: "raw ARM64 cache invalidate through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_arm64_dcache_invalidate_range(addr: u64, size: u64)
@cfg(arm32)
@unsafe(reason: "raw ARM32 cache clean through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_arm32_dcache_clean_range(addr: u64, size: u64)
@cfg(arm32)
@unsafe(reason: "raw ARM32 cache invalidate through an unsigned target provider", capabilities: [ffi, raw_ptr])
extern fn rt_arm32_dcache_invalidate_range(addr: u64, size: u64)
@inline
fn mmio_read64(addr: u64) -> u64:
    unsafe(capabilities: [ffi, raw_ptr]): rt_volatile_read_u64(addr)
@inline
fn mmio_write64(addr: u64, value: u64):
    unsafe(capabilities: [ffi, raw_ptr]): rt_volatile_write_u64(addr, value)
@inline
fn mmio_read32(addr: u64) -> u32:
    unsafe(capabilities: [ffi, raw_ptr]): rt_volatile_read_u32(addr)
@inline
fn mmio_write32(addr: u64, value: u32):
    unsafe(capabilities: [ffi, raw_ptr]): rt_volatile_write_u32(addr, value)
@inline
fn mmio_read16(addr: u64) -> u16:
    unsafe(capabilities: [ffi, raw_ptr]): rt_volatile_read_u16(addr)
@inline
fn mmio_write16(addr: u64, value: u16):
    unsafe(capabilities: [ffi, raw_ptr]): rt_volatile_write_u16(addr, value)
@inline
fn mmio_read8(addr: u64) -> u8:
    unsafe(capabilities: [ffi, raw_ptr]): rt_volatile_read_u8(addr)
@inline
fn mmio_write8(addr: u64, value: u8):
    unsafe(capabilities: [ffi, raw_ptr]): rt_volatile_write_u8(addr, value)
@inline
fn mmio_memory_barrier():
    unsafe(capabilities: [ffi]): rt_memory_barrier()
@cfg(arm64)
fn mmio_shared_clean_range(addr: u64, size: u64):
    unsafe(capabilities: [ffi, raw_ptr]): rt_arm64_dcache_clean_range(addr, size)
@cfg(arm64)
fn mmio_shared_invalidate_range(addr: u64, size: u64):
    unsafe(capabilities: [ffi, raw_ptr]): rt_arm64_dcache_invalidate_range(addr, size)
@cfg(arm32)
fn mmio_shared_clean_range(addr: u64, size: u64):
    unsafe(capabilities: [ffi, raw_ptr]): rt_arm32_dcache_clean_range(addr, size)
@cfg(arm32)
fn mmio_shared_invalidate_range(addr: u64, size: u64):
    unsafe(capabilities: [ffi, raw_ptr]): rt_arm32_dcache_invalidate_range(addr, size)
@cfg(x86_64)
fn mmio_shared_clean_range(addr: u64, size: u64): pass
@cfg(x86_64)
fn mmio_shared_invalidate_range(addr: u64, size: u64): pass
@cfg(x86)
fn mmio_shared_clean_range(addr: u64, size: u64): pass
@cfg(x86)
fn mmio_shared_invalidate_range(addr: u64, size: u64): pass
@cfg(riscv64)
fn mmio_shared_clean_range(addr: u64, size: u64): pass
@cfg(riscv64)
fn mmio_shared_invalidate_range(addr: u64, size: u64): pass
@cfg(riscv32)
fn mmio_shared_clean_range(addr: u64, size: u64): pass
@cfg(riscv32)
fn mmio_shared_invalidate_range(addr: u64, size: u64): pass

# Unaliased owner names for entry-closure builds. Project AST merging does not
# preserve module-local `use ... as ...` bindings through native type checking.
@inline
fn hardware_mmio_read64(addr: u64) -> u64: mmio_read64(addr)
@inline
fn hardware_mmio_write64(addr: u64, value: u64): mmio_write64(addr, value)
@inline
fn hardware_mmio_read32(addr: u64) -> u32: mmio_read32(addr)
@inline
fn hardware_mmio_write32(addr: u64, value: u32): mmio_write32(addr, value)
@inline
fn hardware_mmio_read16(addr: u64) -> u16: mmio_read16(addr)
@inline
fn hardware_mmio_write16(addr: u64, value: u16): mmio_write16(addr, value)
@inline
fn hardware_mmio_read8(addr: u64) -> u8: mmio_read8(addr)
@inline
fn hardware_mmio_write8(addr: u64, value: u8): mmio_write8(addr, value)
