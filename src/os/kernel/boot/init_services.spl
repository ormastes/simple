# Kernel Init Services — spawns essential services at boot
#
# MDSOC: feature dimension, kernel layer
# Called from kernel_main after memory/scheduler/IPC are initialized.
# Starts services in dependency order:
# 1. VFS + storage stack (PCI -> NVMe -> FAT32 -> mount)
# 2. Network stack (if VirtIO-net present)
# 3. Display service (if VirtIO-GPU present)

use os.services.vfs.vfs_init.{vfs_boot_init_production, vfs_service_start, vfs_is_ready}
use os.services.netstack.netstack_init.{net_boot_init, net_service_start, net_is_ready}
use os.services.pcimgr.pcimgr.{pcimgr_init, pcimgr_dump_devices, pcimgr_find_by_class_i64}
use os.drivers.framebuffer.bga_init.{bga_init_framebuffer}
use os.kernel.boot.rc_conf.{rc_conf_screen_type, rc_conf_screen_res, rc_conf_screen_type_marker}
use os.compositor.backend_factory.{resolve_screen_type, create_screen_backend, screen_selection_reason_or_none}
use os.simpleos_config_matrix.{SimpleOsRuntimeProfile}
use os.kernel.ipc.spm_port.{spm_port_register, spm_port_is_registered}
use os.kernel.privilege.privilege_bridge.{bridge_deposit_boot_mirrors}
use os.kernel.memory.memory_leveling_manager.{simpleos_memory_leveling_config_default, simpleos_memory_leveling_config_for_physical_capacity}
use os.kernel.memory.memory_leveling_runtime.{memory_leveling_runtime_init}
use os.kernel.memory.pmm.{pmm_total_memory}
use os.kernel.loader.spawn_authority.{spawn_authority_set_root_task, spawn_authority_seal_bootstrap, spawn_authority_bootstrap_sealed}

use os.kernel.log.klog_api.{log_raw_println}

# ============================================================================
# Well-Known Task IDs
# ============================================================================

# Reserved kernel-boot placeholder for the SPM port receiver. The real
# userland SPM task will later claim ownership via a rebind syscall (follow-up
# work in the spm-winfs-llm-suite track). Using a fixed placeholder keeps boot
# from deadlocking on a not-yet-spawned SPM task. 0 is reserved as the
# "unregistered" sentinel, so we pick a high non-zero constant that cannot
# collide with a real TaskId.
val SPM_WELL_KNOWN_TASK_ID: u64 = 0xfffffff0 as u64

# Task id that keeps ambient (`spawn_full`) authority after the bootstrap window
# closes. There is no distinct "init task id" constant in the kernel: both
# `spawn_authority.spl` and `cap_exec_gate.spl` use `caller == 0` as the
# kernel-origin/root sentinel, and `Scheduler.get_current()` reports 0 while no
# user task is current, so 0 is the root identity for this gate.
val BOOT_ROOT_TASK_ID: i64 = 0

# Whether init_all_services() arms the ambient-spawn seal at boot. Default off:
# the guard mechanism and syscall-site enforcement ship and are spec-proven, but
# arming waits on the userland SpawnSpec migration + a QEMU boot+launch
# transcript (see Step 6). A function, not a `val` — freestanding module-global
# scalar init is reliable but a fn keeps the flip explicit and greppable.
fn _seal_ambient_spawn_on_boot() -> bool:
    return false

# ============================================================================
# Service Status Tracking
# ============================================================================

var svc_storage_ok: bool = false
var svc_network_ok: bool = false
var svc_display_ok: bool = false
var svc_spm_port_ok: bool = false

# ============================================================================
# Boot-Time Service Initialization
# ============================================================================

fn init_all_services():
    """Initialize and start all kernel services.

    Called once during boot, after scheduler and IPC are ready.
    Services are started in dependency order -- storage first
    (other services may need filesystem access), then network,
    then display.
    """
    log_raw_println("========================================")

    val physical_capacity = pmm_total_memory()
    val memory_config = if physical_capacity > 0:
        simpleos_memory_leveling_config_for_physical_capacity(physical_capacity)
    else:
        simpleos_memory_leveling_config_default()
    memory_leveling_runtime_init(memory_config)
    log_raw_println("[init] Starting SimpleOS services...")
    log_raw_println("========================================")

    # Step 0: PCI device enumeration (populates pcimgr device table)
    pcimgr_init()

    # Step 0.5: SPM kernel port — register a well-known placeholder receiver
    # so syscalls 110-114 have a claimed kernel slot from the first tick.
    # The real userland SPM task claims ownership later via rebind.
    svc_spm_port_ok = init_spm_port()
    if svc_spm_port_ok:
        log_raw_println("[init] SPM port: registered placeholder receiver")
        bridge_deposit_boot_mirrors(1 as u64, SPM_WELL_KNOWN_TASK_ID)
        log_raw_println("[init] SPM bridge: root mirrors deposited for pid 1 + SPM placeholder")
    else:
        log_raw_println("[init] SPM port: registration FAILED")

    # Step 1: Storage stack (PCI -> NVMe -> FAT32 -> VFS)
    svc_storage_ok = vfs_boot_init_production()
    if svc_storage_ok:
        log_raw_println("[init] Storage stack: OK (production pure-Simple NVMe)")
    else:
        log_raw_println("[init] Storage stack: UNAVAILABLE (production pure-Simple NVMe required)")

    # Step 2: Dump discovered PCI devices for diagnostics
    pcimgr_dump_devices()

    # Step 3: Network stack (VirtIO-net -> TCP/IP)
    svc_network_ok = net_boot_init()
    if svc_network_ok:
        log_raw_println("[init] Network stack: OK")
    else:
        log_raw_println("[init] Network stack: UNAVAILABLE (no VirtIO-net device)")

    # Step 4: Display init (BGA framebuffer, x86_64 only)
    svc_display_ok = _init_display_service()
    if svc_display_ok:
        log_raw_println("[init] Display: framebuffer initialized")
    else:
        log_raw_println("[init] Display: UNAVAILABLE")

    # Step 5: Start VFS service loop if storage is available
    # NOTE: In a full system this would be spawn_task(vfs_service_start)
    # so the IPC loop runs in its own task. For now we mark it inline-ready
    # and the caller can invoke vfs_service_start() when ready to block.
    if svc_storage_ok:
        log_raw_println("[init] VFS service ready (call vfs_service_start to enter IPC loop)")

    # Step 6: Seal the ambient-spawn window (master plan 5.4).
    # Every essential service above was spawned with bootstrap authority. From
    # here on, only the root task may take the ambient `spawn_full()` path in
    # syscall_process; every other caller must present a SpawnSpec recipe or is
    # refused EACCES. Must be the LAST step of boot service init — anything
    # sealed too early loses its ambient grant mid-bringup.
    #
    # GATED OFF by default: arming the seal makes every userland syscall-spawn
    # (pid != 0) return EACCES, which regresses in-guest shell/WM/fs-exec launch
    # until those callers are migrated to SpawnSpec recipes. There is no QEMU
    # boot evidence yet that the sealed path preserves in-guest launch. The root
    # task is always registered (harmless); actual sealing waits on the userland
    # SpawnSpec migration follow-up. Flip _seal_ambient_spawn_on_boot()->true and
    # capture a QEMU boot+launch transcript to promote.
    spawn_authority_set_root_task(BOOT_ROOT_TASK_ID)
    if _seal_ambient_spawn_on_boot():
        spawn_authority_seal_bootstrap()
        log_raw_println("[init] Spawn authority: bootstrap window SEALED (root={BOOT_ROOT_TASK_ID})")
    else:
        log_raw_println("[init] Spawn authority: root registered, seal DEFERRED (SpawnSpec migration pending)")

    log_raw_println("========================================")
    log_raw_println("[init] Service initialization complete")
    log_raw_println("[init]   storage: {if svc_storage_ok: "OK" else: "UNAVAILABLE"}")
    log_raw_println("[init]   network: {if svc_network_ok: "OK" else: "UNAVAILABLE"}")
    log_raw_println("[init]   display: {if svc_display_ok: "OK" else: "UNAVAILABLE"}")
    log_raw_println("[init]   spm_port: {if svc_spm_port_ok: "OK" else: "UNAVAILABLE"}")
    log_raw_println("========================================")

# ============================================================================
# SPM Port Init Helper
# ============================================================================

fn init_spm_port() -> bool:
    """Claim the SPM kernel-port slot with a well-known placeholder task id.

    Approach: placeholder-slot. Registering a non-zero TaskId at boot means
    `spm_port_is_registered()` returns true from the first scheduler tick,
    so the kernel's privilege bridge and SPM syscalls (110-114) have a
    stable landing site even before the userland SPM service spawns.

    The real SPM task rebinds this slot later (follow-up syscall work).
    Since `spm_port_register` rejects a second distinct task id while one
    is registered, the rebind path must call `spm_port_reset` first -- that
    is out of scope for this commit but is the expected sequence.
    """
    spm_port_register(SPM_WELL_KNOWN_TASK_ID)

# ============================================================================
# Display Init Helper
# ============================================================================

fn boot_runtime_profile() -> SimpleOsRuntimeProfile:
    """Runtime profile describing what THIS boot actually detected.

    Built kernel-side on purpose: the `qemu_*`/`fpga_*` profiles in
    `simpleos_config_matrix` are the TEST-GATING contract and must never
    become runtime policy. They and this value are two different inputs to the
    same pure `resolve_screen_type`.
    """
    # PCI class 0x03 = display controller.
    val has_gpu = pcimgr_find_by_class_i64(3, 0) >= 0
    SimpleOsRuntimeProfile(
        name: "boot",
        arch: "host",
        target_kind: "baremetal",
        terminal_kind: "serial+graphical",
        ssh_host_port: 0,
        http_host_port: 0,
        supports_gpu: has_gpu,
        # BGA framebuffer programming is unconditional on this path today.
        supports_framebuffer: true,
        supports_wm: true,
        supports_simple2d_engine2d: true,
        requires_vulkan: false,
        requires_renderdoc: false,
        requires_host_wm_compare: false,
        blocked_reason: ""
    )

fn _init_display_service() -> bool:
    """Initialize the boot display for the rc.conf-selected screen type.

    Absent or `screen_type="wm"` reproduces the historical path exactly:
    BGA 1024x768x32bpp via `bga_init_framebuffer`. On QEMU Q35 with -vga std
    the BGA adapter is at PCI bus 0, programmed via I/O ports 0x01CE/0x01CF.
    PCI BAR0 scan may fail (Cranelift large-constant codegen issue) but falls
    back to 0xFD000000 which is correct for Q35.

    Selection is resolved BEFORE branching, and the branch is on the
    *effective* type: anything that falls back lands on the verbatim BGA path
    rather than reporting a display failure. There is never a blank screen.
    """
    val requested = rc_conf_screen_type()
    val res = rc_conf_screen_res(1024, 768)
    val w = res.0
    val h = res.1
    val profile = boot_runtime_profile()
    val decided = resolve_screen_type(requested, profile)
    val effective = decided.0
    val reason = screen_selection_reason_or_none(decided.1)
    log_raw_println(rc_conf_screen_type_marker())
    log_raw_println("[screen] requested={requested} effective={effective} profile=boot reason={reason} res={w}x{h}")
    if effective == "wm":
        log_raw_println("[display] Attempting BGA framebuffer init...")
        val fb_info = bga_init_framebuffer(w, h, 32)
        log_raw_println("[display] BGA framebuffer: {w}x{h}x32bpp initialized")
        return true
    val sel = create_screen_backend(effective, w, h, profile)
    sel.backend != nil

# ============================================================================
# Query Helpers
# ============================================================================

fn services_storage_ready() -> bool:
    """Check if storage stack initialized successfully."""
    svc_storage_ok

fn services_network_ready() -> bool:
    """Check if network stack initialized successfully."""
    svc_network_ok

fn services_display_ready() -> bool:
    """Check if display service initialized successfully."""
    svc_display_ok

fn services_spm_port_ready() -> bool:
    """Check if the SPM kernel port has a registered receiver."""
    svc_spm_port_ok

fn spm_well_known_task_id() -> u64:
    """Return the placeholder TaskId used by the kernel boot path to claim
    the SPM port slot before the real SPM service has spawned."""
    SPM_WELL_KNOWN_TASK_ID

fn services_spawn_authority_sealed() -> bool:
    """True once boot service init has closed the ambient-spawn window."""
    spawn_authority_bootstrap_sealed()

fn services_all_ready() -> bool:
    """Check if all essential services are available."""
    svc_storage_ok and svc_network_ok and svc_display_ok
