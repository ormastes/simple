# Boot-owned RV64 DTB capability.
#
# The firmware DTB pointer is a scoped physical-memory loan.  This owner walks
# it once before PMM/heap readiness and commits only bounded scalar state.  No
# pointer into firmware memory escapes this module.

use os.kernel.boot.mmio.{mmio_read8}

val _FDT_MAGIC: u32 = 0xD00DFEEDu32
val _FDT_BEGIN_NODE: u32 = 1u32
val _FDT_END_NODE: u32 = 2u32
val _FDT_PROP: u32 = 3u32
val _FDT_NOP: u32 = 4u32
val _FDT_END: u32 = 9u32
val _FDT_HEADER_SIZE: u64 = 40u64
val _FDT_MAX_SIZE: u64 = 0x00200000u64
val _FDT_MAX_DEPTH: u32 = 32u32
val _FDT_MAX_NAME: u64 = 64u64
val _RV64_DTB_HART_CAPACITY: u32 = 32u32

var _g_rv64_dtb_harts: [u64; 32] = [0u64; 32]
var _g_rv64_dtb_hart_count: u32 = 1u32
var _g_rv64_dtb_zicbom: bool = false
var _g_rv64_dtb_cache_stride: u32 = 64u32
var _g_rv64_dtb_valid: bool = false

fn _dtb_u32(base: u64, offset: u64) -> u32:
    ((mmio_read8(base + offset) as u32) << 24u32) |
        ((mmio_read8(base + offset + 1u64) as u32) << 16u32) |
        ((mmio_read8(base + offset + 2u64) as u32) << 8u32) |
        (mmio_read8(base + offset + 3u64) as u32)

fn _dtb_u64(base: u64, offset: u64) -> u64:
    ((_dtb_u32(base, offset) as u64) << 32u64) |
        (_dtb_u32(base, offset + 4u64) as u64)

fn _dtb_align4(value: u64) -> u64:
    (value + 3u64) & 0xfffffffffffffffc

fn _dtb_range_ok(offset: u64, length: u64, total: u64) -> bool:
    offset <= total and length <= total - offset

fn _dtb_cstr_end(base: u64, start: u64, end: u64) -> u64:
    var cursor = start
    while cursor < end and cursor - start < _FDT_MAX_NAME:
        if mmio_read8(base + cursor) == 0u8:
            return cursor
        cursor = cursor + 1u64
    end

fn _dtb_name_is_cpu(base: u64, start: u64, end: u64) -> bool:
    if end - start < 3u64: return false
    if mmio_read8(base + start) != 99u8: return false
    if mmio_read8(base + start + 1u64) != 112u8: return false
    if mmio_read8(base + start + 2u64) != 117u8: return false
    end - start == 3u64 or mmio_read8(base + start + 3u64) == 64u8

fn _dtb_name_is_cpus(base: u64, start: u64, end: u64) -> bool:
    end - start == 4u64 and
        mmio_read8(base + start) == 99u8 and
        mmio_read8(base + start + 1u64) == 112u8 and
        mmio_read8(base + start + 2u64) == 117u8 and
        mmio_read8(base + start + 3u64) == 115u8

# Property names are compared in the strings block without constructing text.
fn _dtb_prop_eq(base: u64, start: u64, length: u64, kind: u32) -> bool:
    if kind == 1u32: # reg
        return length == 3u64 and mmio_read8(base + start) == 114u8 and mmio_read8(base + start + 1u64) == 101u8 and mmio_read8(base + start + 2u64) == 103u8
    if kind == 2u32: # status
        return length == 6u64 and mmio_read8(base + start) == 115u8 and mmio_read8(base + start + 1u64) == 116u8 and mmio_read8(base + start + 2u64) == 97u8 and mmio_read8(base + start + 3u64) == 116u8 and mmio_read8(base + start + 4u64) == 117u8 and mmio_read8(base + start + 5u64) == 115u8
    if kind == 3u32: # riscv,isa
        return length == 9u64 and mmio_read8(base + start) == 114u8 and mmio_read8(base + start + 1u64) == 105u8 and mmio_read8(base + start + 2u64) == 115u8 and mmio_read8(base + start + 3u64) == 99u8 and mmio_read8(base + start + 4u64) == 118u8 and mmio_read8(base + start + 5u64) == 44u8 and mmio_read8(base + start + 6u64) == 105u8 and mmio_read8(base + start + 7u64) == 115u8 and mmio_read8(base + start + 8u64) == 97u8
    if kind == 4u32: # #address-cells
        return length == 14u64 and mmio_read8(base + start) == 35u8 and mmio_read8(base + start + 1u64) == 97u8 and mmio_read8(base + start + 2u64) == 100u8 and mmio_read8(base + start + 3u64) == 100u8 and mmio_read8(base + start + 4u64) == 114u8 and mmio_read8(base + start + 5u64) == 101u8 and mmio_read8(base + start + 6u64) == 115u8 and mmio_read8(base + start + 7u64) == 115u8 and mmio_read8(base + start + 8u64) == 45u8 and mmio_read8(base + start + 9u64) == 99u8 and mmio_read8(base + start + 10u64) == 101u8 and mmio_read8(base + start + 11u64) == 108u8 and mmio_read8(base + start + 12u64) == 108u8 and mmio_read8(base + start + 13u64) == 115u8
    if kind == 5u32: # riscv,cbom-block-size
        return length == 21u64 and mmio_read8(base + start) == 114u8 and mmio_read8(base + start + 1u64) == 105u8 and mmio_read8(base + start + 2u64) == 115u8 and mmio_read8(base + start + 3u64) == 99u8 and mmio_read8(base + start + 4u64) == 118u8 and mmio_read8(base + start + 5u64) == 44u8 and mmio_read8(base + start + 6u64) == 99u8 and mmio_read8(base + start + 7u64) == 98u8 and mmio_read8(base + start + 8u64) == 111u8 and mmio_read8(base + start + 9u64) == 109u8 and mmio_read8(base + start + 10u64) == 45u8 and mmio_read8(base + start + 11u64) == 98u8 and mmio_read8(base + start + 12u64) == 108u8 and mmio_read8(base + start + 13u64) == 111u8 and mmio_read8(base + start + 14u64) == 99u8 and mmio_read8(base + start + 15u64) == 107u8 and mmio_read8(base + start + 16u64) == 45u8 and mmio_read8(base + start + 17u64) == 115u8 and mmio_read8(base + start + 18u64) == 105u8 and mmio_read8(base + start + 19u64) == 122u8 and mmio_read8(base + start + 20u64) == 101u8
    if kind == 6u32: # #size-cells
        return length == 11u64 and mmio_read8(base + start) == 35u8 and mmio_read8(base + start + 1u64) == 115u8 and mmio_read8(base + start + 2u64) == 105u8 and mmio_read8(base + start + 3u64) == 122u8 and mmio_read8(base + start + 4u64) == 101u8 and mmio_read8(base + start + 5u64) == 45u8 and mmio_read8(base + start + 6u64) == 99u8 and mmio_read8(base + start + 7u64) == 101u8 and mmio_read8(base + start + 8u64) == 108u8 and mmio_read8(base + start + 9u64) == 108u8 and mmio_read8(base + start + 10u64) == 115u8
    false

fn _dtb_status_enabled(base: u64, data: u64, length: u64) -> bool:
    if length == 3u64 and mmio_read8(base + data) == 111u8 and mmio_read8(base + data + 1u64) == 107u8 and mmio_read8(base + data + 2u64) == 0u8: return true
    length == 5u64 and mmio_read8(base + data) == 111u8 and mmio_read8(base + data + 1u64) == 107u8 and mmio_read8(base + data + 2u64) == 97u8 and mmio_read8(base + data + 3u64) == 121u8 and mmio_read8(base + data + 4u64) == 0u8

fn _dtb_property_string_valid(base: u64, data: u64, length: u64) -> bool:
    if length == 0u64 or mmio_read8(base + data + length - 1u64) != 0u8: return false
    var i: u64 = 0u64
    while i + 1u64 < length:
        if mmio_read8(base + data + i) == 0u8: return false
        i = i + 1u64
    true

fn _dtb_isa_has_zicbom(base: u64, data: u64, length: u64) -> bool:
    # Exact extension token: boundaries are '_' or the terminating NUL.
    if not _dtb_property_string_valid(base, data, length): return false
    val payload_length = length - 1u64
    var i: u64 = 0u64
    while i + 6u64 <= payload_length:
        val left_ok = i == 0u64 or mmio_read8(base + data + i - 1u64) == 95u8
        val matches_zicbom = mmio_read8(base + data + i) == 122u8 and mmio_read8(base + data + i + 1u64) == 105u8 and mmio_read8(base + data + i + 2u64) == 99u8 and mmio_read8(base + data + i + 3u64) == 98u8 and mmio_read8(base + data + i + 4u64) == 111u8 and mmio_read8(base + data + i + 5u64) == 109u8
        val right = i + 6u64
        val right_ok = right == payload_length or mmio_read8(base + data + right) == 95u8
        if left_ok and matches_zicbom and right_ok: return true
        i = i + 1u64
    false

fn _dtb_power_of_two(value: u32) -> bool:
    value != 0u32 and (value & (value - 1u32)) == 0u32

fn _dtb_reservations_valid(base: u64, reserve_off: u64, total: u64, struct_off: u64, struct_end: u64, strings_off: u64, strings_end: u64) -> bool:
    var cursor = reserve_off
    while _dtb_range_ok(cursor, 16u64, total):
        val entry_end = cursor + 16u64
        if cursor < struct_end and struct_off < entry_end: return false
        if cursor < strings_end and strings_off < entry_end: return false
        val address = _dtb_u64(base, cursor)
        val size = _dtb_u64(base, cursor + 8u64)
        if address == 0u64 and size == 0u64: return true
        if size > 0xffffffffffffffff - address: return false
        cursor = entry_end
    false

fn _dtb_fallback(observed_hart: u64):
    _g_rv64_dtb_harts[0u32] = observed_hart
    _g_rv64_dtb_hart_count = 1u32
    _g_rv64_dtb_zicbom = false
    _g_rv64_dtb_cache_stride = 64u32
    _g_rv64_dtb_valid = false

fn riscv_noalloc_dtb_capability_init(observed_hart: u64, dtb_addr: u64):
    _dtb_fallback(observed_hart)
    if dtb_addr == 0u64: return
    if dtb_addr > 0xffffffffffffffff - _FDT_HEADER_SIZE: return
    if _dtb_u32(dtb_addr, 0u64) != _FDT_MAGIC: return
    val version = _dtb_u32(dtb_addr, 20u64)
    val compatible_version = _dtb_u32(dtb_addr, 24u64)
    if version < 17u32 or compatible_version > 17u32 or compatible_version > version: return
    val total = _dtb_u32(dtb_addr, 4u64) as u64
    if total < _FDT_HEADER_SIZE or total > _FDT_MAX_SIZE: return
    if dtb_addr > 0xffffffffffffffff - total: return
    val struct_off = _dtb_u32(dtb_addr, 8u64) as u64
    val strings_off = _dtb_u32(dtb_addr, 12u64) as u64
    val reserve_off = _dtb_u32(dtb_addr, 16u64) as u64
    val strings_size = _dtb_u32(dtb_addr, 32u64) as u64
    val struct_size = _dtb_u32(dtb_addr, 36u64) as u64
    if struct_off < _FDT_HEADER_SIZE or strings_off < _FDT_HEADER_SIZE: return
    if reserve_off < _FDT_HEADER_SIZE or not _dtb_range_ok(reserve_off, 16u64, total) or (reserve_off & 7u64) != 0u64: return
    if (struct_off & 3u64) != 0u64 or struct_size == 0u64: return
    if not _dtb_range_ok(struct_off, struct_size, total): return
    if not _dtb_range_ok(strings_off, strings_size, total): return
    val struct_end = struct_off + struct_size
    val strings_end = strings_off + strings_size
    if struct_off < strings_end and strings_off < struct_end: return
    if not _dtb_reservations_valid(dtb_addr, reserve_off, total, struct_off, struct_end, strings_off, strings_end): return
    var cursor = struct_off
    var depth: u32 = 0u32
    var cpus_depth: u32 = 0xffffffffu32
    var cpu_depth: u32 = 0xffffffffu32
    var address_cells: u32 = 1u32
    var address_cells_seen = false
    var size_cells_seen = false
    var cpu_started = false
    var cpu_reg: u64 = 0u64
    var cpu_has_reg = false
    var cpu_enabled = true
    var cpu_zicbom = false
    var cpu_stride: u32 = 0u32
    var cpu_reg_seen = false
    var cpu_status_seen = false
    var cpu_isa_seen = false
    var cpu_stride_seen = false
    var count: u32 = 0u32
    var all_zicbom = true
    var common_stride: u32 = 0u32
    var saw_end = false
    var root_seen = false
    var root_closed = false
    var saw_cpus = false
    var valid = true
    while valid and cursor + 4u64 <= struct_end:
        val token = _dtb_u32(dtb_addr, cursor)
        cursor = cursor + 4u64
        if token == _FDT_BEGIN_NODE:
            if depth >= _FDT_MAX_DEPTH or root_closed:
                valid = false
            else:
                val name_end = _dtb_cstr_end(dtb_addr, cursor, struct_end)
                if name_end == struct_end:
                    valid = false
                else:
                    depth = depth + 1u32
                    if depth == 1u32:
                        if root_seen or name_end != cursor: valid = false
                        else: root_seen = true
                    if depth == 2u32 and cpus_depth == 0xffffffffu32 and _dtb_name_is_cpus(dtb_addr, cursor, name_end):
                        if saw_cpus: valid = false
                        else:
                            saw_cpus = true
                            cpus_depth = depth
                    if cpus_depth != 0xffffffffu32 and depth == cpus_depth + 1u32 and _dtb_name_is_cpu(dtb_addr, cursor, name_end):
                        if not address_cells_seen or not size_cells_seen: valid = false
                        cpu_started = true
                        cpu_depth = depth
                        cpu_has_reg = false
                        cpu_enabled = true
                        cpu_zicbom = false
                        cpu_stride = 0u32
                        cpu_reg_seen = false
                        cpu_status_seen = false
                        cpu_isa_seen = false
                        cpu_stride_seen = false
                    cursor = _dtb_align4(name_end + 1u64)
        elif token == _FDT_END_NODE:
            if depth == 0u32:
                valid = false
            else:
                if depth == cpu_depth:
                    if cpu_enabled:
                        if not cpu_has_reg or count >= _RV64_DTB_HART_CAPACITY:
                            valid = false
                        else:
                            var duplicate = false
                            var index: u32 = 0u32
                            while index < count:
                                if _g_rv64_dtb_harts[index] == cpu_reg: duplicate = true
                                index = index + 1u32
                            if duplicate:
                                valid = false
                            else:
                                _g_rv64_dtb_harts[count] = cpu_reg
                                count = count + 1u32
                                all_zicbom = all_zicbom and cpu_zicbom
                                if cpu_zicbom:
                                    if not _dtb_power_of_two(cpu_stride): valid = false
                                    elif common_stride == 0u32: common_stride = cpu_stride
                                    elif common_stride != cpu_stride: valid = false
                    cpu_depth = 0xffffffffu32
                if depth == cpus_depth: cpus_depth = 0xffffffffu32
                if depth == 1u32: root_closed = true
                depth = depth - 1u32
        elif token == _FDT_PROP:
            if depth == 0u32 or root_closed or cursor + 8u64 > struct_end:
                valid = false
            else:
                val length = _dtb_u32(dtb_addr, cursor) as u64
                val name_off = _dtb_u32(dtb_addr, cursor + 4u64) as u64
                val data = cursor + 8u64
                if name_off >= strings_size or not _dtb_range_ok(data, length, struct_end):
                    valid = false
                else:
                    val prop_name = strings_off + name_off
                    val prop_end = _dtb_cstr_end(dtb_addr, prop_name, strings_end)
                    if prop_end == strings_end:
                        valid = false
                    elif depth == cpus_depth and _dtb_prop_eq(dtb_addr, prop_name, prop_end - prop_name, 4u32):
                        if address_cells_seen or cpu_started or length != 4u64:
                            valid = false
                        else:
                            address_cells = _dtb_u32(dtb_addr, data)
                            address_cells_seen = true
                            if address_cells != 1u32 and address_cells != 2u32: valid = false
                    elif depth == cpus_depth and _dtb_prop_eq(dtb_addr, prop_name, prop_end - prop_name, 6u32):
                        if size_cells_seen or cpu_started or length != 4u64 or _dtb_u32(dtb_addr, data) != 0u32: valid = false
                        else: size_cells_seen = true
                    elif depth == cpu_depth:
                        if _dtb_prop_eq(dtb_addr, prop_name, prop_end - prop_name, 1u32):
                            if cpu_reg_seen or length != address_cells as u64 * 4u64:
                                valid = false
                            else:
                                cpu_reg_seen = true
                                cpu_reg = if address_cells == 2u32: _dtb_u64(dtb_addr, data) else: _dtb_u32(dtb_addr, data) as u64
                                cpu_has_reg = true
                        elif _dtb_prop_eq(dtb_addr, prop_name, prop_end - prop_name, 2u32):
                            if cpu_status_seen or not _dtb_property_string_valid(dtb_addr, data, length): valid = false
                            else:
                                cpu_status_seen = true
                                cpu_enabled = _dtb_status_enabled(dtb_addr, data, length)
                        elif _dtb_prop_eq(dtb_addr, prop_name, prop_end - prop_name, 3u32):
                            if cpu_isa_seen or not _dtb_property_string_valid(dtb_addr, data, length): valid = false
                            else:
                                cpu_isa_seen = true
                                cpu_zicbom = _dtb_isa_has_zicbom(dtb_addr, data, length)
                        elif _dtb_prop_eq(dtb_addr, prop_name, prop_end - prop_name, 5u32):
                            if cpu_stride_seen or length != 4u64: valid = false
                            else:
                                cpu_stride_seen = true
                                cpu_stride = _dtb_u32(dtb_addr, data)
                    cursor = _dtb_align4(data + length)
        elif token == _FDT_NOP:
            pass
        elif token == _FDT_END:
            saw_end = root_seen and root_closed and depth == 0u32 and cursor == struct_end
            break
        else:
            valid = false
    if not valid or not saw_end or not root_seen or not root_closed or not saw_cpus or count == 0u32:
        _dtb_fallback(observed_hart)
        return
    # Logical CPU zero is always the boot hart actually observed in a0.
    var boot_index: u32 = 0xffffffffu32
    var i: u32 = 0u32
    while i < count:
        if _g_rv64_dtb_harts[i] == observed_hart: boot_index = i
        i = i + 1u32
    if boot_index == 0xffffffffu32:
        _dtb_fallback(observed_hart)
        return
    val first = _g_rv64_dtb_harts[0u32]
    _g_rv64_dtb_harts[0u32] = observed_hart
    _g_rv64_dtb_harts[boot_index] = first
    _g_rv64_dtb_hart_count = count
    _g_rv64_dtb_zicbom = all_zicbom and common_stride != 0u32
    _g_rv64_dtb_cache_stride = if _g_rv64_dtb_zicbom: common_stride else: 64u32
    _g_rv64_dtb_valid = true

fn riscv_noalloc_dtb_capability_valid() -> bool: _g_rv64_dtb_valid
fn riscv_noalloc_dtb_hart_count() -> u32: _g_rv64_dtb_hart_count
fn riscv_noalloc_dtb_hart_id(logical: u32) -> u64:
    if logical < _g_rv64_dtb_hart_count: _g_rv64_dtb_harts[logical] else: _g_rv64_dtb_harts[0u32]
fn riscv_noalloc_dtb_logical_valid(logical: u32) -> bool: logical < _g_rv64_dtb_hart_count
fn riscv_noalloc_dtb_has_zicbom() -> bool: _g_rv64_dtb_zicbom
fn riscv_noalloc_dtb_cache_stride() -> u32: _g_rv64_dtb_cache_stride
