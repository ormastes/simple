# RV64 boot adapter for the authoritative ECS process manager.
#
# This module owns the boot-lifetime PM instance.  It exposes creation and
# liveness facts but emits no lifecycle receipt; the boot orchestrator maps a
# confirmed fact into the typed RV64 gate observation.

use os.services.pm_service.{PmService}

pub struct Rv64Pid1BootResult:
    created: bool
    live: bool
    pid: u32

var g_rv64_boot_process_owner: PmService? = nil

pub fn rv64_pid1_create_and_confirm_live() -> Rv64Pid1BootResult:
    var owner = if val existing = g_rv64_boot_process_owner: existing else: PmService.new()
    val created = owner.pm_init()
    val live = created and owner.pm_pid_is_live(1)
    g_rv64_boot_process_owner = Some(owner)
    Rv64Pid1BootResult(created: created, live: live, pid: if live: 1 else: 0)

pub fn rv64_pid1_is_live() -> bool:
    if val owner = g_rv64_boot_process_owner:
        return owner.pm_pid_is_live(1)
    false
