# Limine Boot Protocol Integration — Boot Layer (Layer 0), aarch64.
#
# Arch port of limine_boot.spl (x86_64) for the new Limine-protocol aarch64
# boot lane under examples/09_embedded/simple_os/arch/aarch64/. The Limine
# request/response protocol itself is architecture-agnostic (same magic IDs,
# same struct layouts) — this file is a near-verbatim copy of limine_boot.spl
# with the arch-specific deltas called out below.
#
# Deltas vs limine_boot.spl (x86_64):
#   - Early serial is PL011 MMIO (QEMU `virt` machine UART0 base
#     0x09000000), not x86 port I/O at 0x3F8 — serial_is_mmio: true.
#   - Architecture.Arm64 instead of Architecture.X86_64 in BootOutputPort.
#   - Drops the x86_64-only x86_64_hardening_boot_canary_marker() call —
#     that probe is x86_64-specific and has no aarch64 analog.
#   - AAPCS64 entry convention needs no shadow-space handling; Limine calls
#     kernel_main() with no arguments here, same as x86_64.
#
# Real-firmware boot verified 2026-08-06: a minimal hand-written C probe
# kernel using this exact protocol (empty `.limine_reqs` array, higher-half
# link address, page-aligned PT_LOAD segments, PL011 byte-write at
# 0x09000000) booted end-to-end under `qemu-system-aarch64 -M virt -pflash
# AAVMF_CODE.no-secboot.fd` through Limine's official BOOTAA64.EFI
# (limine-bootloader/limine, v10.x-binary branch, v10.8.5) and printed on
# serial. See doc/08_tracking/bug/aarch64_real_firmware_boot_gap_and_seed_defects_2026-07-14.md
# for the full transcript and the two protocol requirements that binary
# release enforces (both undocumented in-tree until this pass):
#   1. Kernel ELF must link higher-half (rejects "Lower half PHDRs").
#   2. Config must set `serial: yes` or Limine's own console never reaches
#      the serial port at all (silent hang, not an error).
#
# This file has not yet been compiled through the Simple toolchain and
# linked against a booting SimpleOS kernel — that is the next step, using
# examples/09_embedded/simple_os/arch/aarch64/boot/linker_limine.ld.
#
# Limine protocol reference: https://github.com/limine-bootloader/limine/blob/trunk/PROTOCOL.md

use os.kernel.types.memory_types.{PhysAddr, VirtAddr}
use os.kernel.boot.ports.{BootOutputPort, BootMemoryRegion, FramebufferInfo, MemoryRegionKind}
use os.kernel.boot.mmio.{mmio_read64, mmio_read32, mmio_write8, mmio_read8}
use os.kernel.arch.arch_context.{Architecture}
use os.kernel.log.klog_api.{log_init_serial, log_raw, log_raw_println, LOG_INFO}

# `os.kernel.boot.cpu.halt_loop` is x86_64-only (rt_cli/rt_hlt are x86 `cli`/
# `hlt` instructions with no aarch64 meaning) — importing that module here
# was pulling ~20 unrelated x86 port-I/O/MSR/GDT/IDT extern symbols into
# this arch's link closure (all fabricated as return-0 stubs by
# native-build's freestanding-stub fallback, discovered while bringing up
# this boot lane 2026-08-07). Use a local, genuinely aarch64 halt instead:
# WFE (Wait For Event) in a loop, backed by `rt_aarch64_wfe_spin()` in
# examples/09_embedded/simple_os/arch/aarch64/boot/freestanding_runtime.c.
extern fn rt_aarch64_wfe_spin()

fn halt_loop():
    """Halt forever (aarch64: WFE spin loop, no interrupt controller set up yet)."""
    rt_aarch64_wfe_spin()

# ============================================================================
# Limine Request/Response Structures (arch-agnostic, verbatim from limine_boot.spl)
# ============================================================================

val LIMINE_COMMON_MAGIC_0: u64 = 0xc7b1dd30df4c8b88
val LIMINE_COMMON_MAGIC_1: u64 = 0x0a82e883a194f07b

val LIMINE_MEMMAP_ID_0: u64 = 0x67cf3d9d378a806f
val LIMINE_MEMMAP_ID_1: u64 = 0xe304acdfc50c3c62

val LIMINE_FRAMEBUFFER_ID_0: u64 = 0x9d5827dcd881dd75
val LIMINE_FRAMEBUFFER_ID_1: u64 = 0xa3148604f6fab11b

val LIMINE_RSDP_ID_0: u64 = 0xc5e77b6b397e7b43
val LIMINE_RSDP_ID_1: u64 = 0x27637845accdcf3c

val LIMINE_HHDM_ID_0: u64 = 0x48dcf1cb8ad2b852
val LIMINE_HHDM_ID_1: u64 = 0x63984e959a98244b

val LIMINE_KERNEL_ADDR_ID_0: u64 = 0x71ba76863cc55f63
val LIMINE_KERNEL_ADDR_ID_1: u64 = 0xb2644a48c516a487

val LIMINE_MMAP_USABLE: u64 = 0
val LIMINE_MMAP_RESERVED: u64 = 1
val LIMINE_MMAP_ACPI_RECLAIMABLE: u64 = 2
val LIMINE_MMAP_ACPI_NVS: u64 = 3
val LIMINE_MMAP_BAD_MEMORY: u64 = 4
val LIMINE_MMAP_BOOTLOADER_RECLAIMABLE: u64 = 5
val LIMINE_MMAP_KERNEL_AND_MODULES: u64 = 6
val LIMINE_MMAP_FRAMEBUFFER: u64 = 7

@repr("C")
struct LimineMemMapEntry:
    """Single memory map entry from Limine bootloader."""
    base: u64
    length: u64
    type_: u64

@repr("C")
struct LimineMemMapResponse:
    """Limine memory map response."""
    revision: u64
    entry_count: u64
    entries: u64

@repr("C")
struct LimineFramebuffer:
    """Limine framebuffer descriptor."""
    address: u64
    width: u64
    height: u64
    pitch: u64
    bpp: u16

@repr("C")
struct LimineFramebufferResponse:
    """Limine framebuffer response."""
    revision: u64
    framebuffer_count: u64
    framebuffers: u64

@repr("C")
struct LimineRsdpResponse:
    """Limine RSDP response."""
    revision: u64
    address: u64

@repr("C")
struct LimineHhdmResponse:
    """Limine Higher-Half Direct Map response."""
    revision: u64
    offset: u64

@repr("C")
struct LimineKernelAddressResponse:
    """Limine kernel address response."""
    revision: u64
    physical_base: u64
    virtual_base: u64

@repr("C")
struct LimineRequest:
    """Generic Limine request header."""
    id: [u64; 4]
    revision: u64
    response: u64

# ============================================================================
# Global Limine Requests (linker places in .limine_reqs section)
# ============================================================================

# @section(".limine_reqs") — applied by linker script
var memmap_request: LimineRequest = LimineRequest(
    id: [LIMINE_COMMON_MAGIC_0, LIMINE_COMMON_MAGIC_1,
         LIMINE_MEMMAP_ID_0, LIMINE_MEMMAP_ID_1],
    revision: 0,
    response: 0
)

# @section(".limine_reqs") — applied by linker script
var framebuffer_request: LimineRequest = LimineRequest(
    id: [LIMINE_COMMON_MAGIC_0, LIMINE_COMMON_MAGIC_1,
         LIMINE_FRAMEBUFFER_ID_0, LIMINE_FRAMEBUFFER_ID_1],
    revision: 0,
    response: 0
)

# @section(".limine_reqs") — applied by linker script
var rsdp_request: LimineRequest = LimineRequest(
    id: [LIMINE_COMMON_MAGIC_0, LIMINE_COMMON_MAGIC_1,
         LIMINE_RSDP_ID_0, LIMINE_RSDP_ID_1],
    revision: 0,
    response: 0
)

# @section(".limine_reqs") — applied by linker script
var hhdm_request: LimineRequest = LimineRequest(
    id: [LIMINE_COMMON_MAGIC_0, LIMINE_COMMON_MAGIC_1,
         LIMINE_HHDM_ID_0, LIMINE_HHDM_ID_1],
    revision: 0,
    response: 0
)

# @section(".limine_reqs") — applied by linker script
var kernel_addr_request: LimineRequest = LimineRequest(
    id: [LIMINE_COMMON_MAGIC_0, LIMINE_COMMON_MAGIC_1,
         LIMINE_KERNEL_ADDR_ID_0, LIMINE_KERNEL_ADDR_ID_1],
    revision: 0,
    response: 0
)

# ============================================================================
# HHDM Offset (Higher-Half Direct Map)
# ============================================================================

var g_hhdm_offset: u64 = 0

fn _parse_hhdm():
    """Parse HHDM response to get virtual-to-physical mapping offset."""
    val resp_ptr = hhdm_request.response
    if resp_ptr == 0:
        log_raw_println("[BOOT] WARNING: No HHDM response from Limine")
        return

    val resp_revision = mmio_read64(resp_ptr)
    val offset = mmio_read64(resp_ptr + 8)
    g_hhdm_offset = offset
    log_raw_println("[BOOT] HHDM offset: 0x{offset}")

fn phys_to_virt(phys: u64) -> u64:
    """Convert physical address to virtual via HHDM."""
    phys + g_hhdm_offset

# ============================================================================
# Memory Map Parsing
# ============================================================================

fn _limine_type_to_kind(type_: u64) -> MemoryRegionKind:
    """Convert Limine memory type to our MemoryRegionKind enum."""
    if type_ == LIMINE_MMAP_USABLE:
        return MemoryRegionKind.Usable
    if type_ == LIMINE_MMAP_RESERVED:
        return MemoryRegionKind.Reserved
    if type_ == LIMINE_MMAP_ACPI_RECLAIMABLE:
        return MemoryRegionKind.AcpiReclaimable
    if type_ == LIMINE_MMAP_ACPI_NVS:
        return MemoryRegionKind.AcpiNvs
    if type_ == LIMINE_MMAP_BAD_MEMORY:
        return MemoryRegionKind.BadMemory
    if type_ == LIMINE_MMAP_BOOTLOADER_RECLAIMABLE:
        return MemoryRegionKind.BootloaderReclaimable
    if type_ == LIMINE_MMAP_KERNEL_AND_MODULES:
        return MemoryRegionKind.Kernel
    if type_ == LIMINE_MMAP_FRAMEBUFFER:
        return MemoryRegionKind.Framebuffer
    MemoryRegionKind.Reserved

fn _parse_memory_map() -> [BootMemoryRegion]:
    """Parse Limine memory map response into BootMemoryRegion list."""
    var regions: [BootMemoryRegion] = []

    val resp_ptr = memmap_request.response
    if resp_ptr == 0:
        log_raw_println("[BOOT] WARNING: No memory map response from Limine")
        return regions

    val _revision = mmio_read64(resp_ptr)
    val entry_count = mmio_read64(resp_ptr + 8)
    val entries_ptr = mmio_read64(resp_ptr + 16)

    log_raw_println("[BOOT] Memory map: {entry_count} entries")

    var i: u64 = 0
    while i < entry_count:
        val entry_ptr_addr = entries_ptr + (i * 8)
        val entry_ptr = mmio_read64(entry_ptr_addr)

        val base = mmio_read64(entry_ptr)
        val length = mmio_read64(entry_ptr + 8)
        val type_ = mmio_read64(entry_ptr + 16)

        val kind = _limine_type_to_kind(type_)

        val region = BootMemoryRegion(
            base: PhysAddr(addr: base),
            size: length,
            kind: kind
        )
        regions.push(region)

        log_raw_println("[BOOT]   region {i}: base=0x{base} size=0x{length} type={type_}")

        i = i + 1

    regions

# ============================================================================
# Framebuffer Parsing
# ============================================================================

val LIMINE_FB_MIN_DIM: u64 = 1
val LIMINE_FB_MAX_DIM: u64 = 16384
val LIMINE_FB_BPP_24: u64 = 24
val LIMINE_FB_BPP_32: u64 = 32

fn limine_framebuffer_fields_valid(width: u64, height: u64, pitch: u64, bpp: u64, address: u64) -> bool:
    """Sanity-check raw Limine framebuffer fields before trusting them."""
    if address == 0:
        return false
    if width < LIMINE_FB_MIN_DIM or width > LIMINE_FB_MAX_DIM:
        return false
    if height < LIMINE_FB_MIN_DIM or height > LIMINE_FB_MAX_DIM:
        return false
    if bpp != LIMINE_FB_BPP_24 and bpp != LIMINE_FB_BPP_32:
        return false
    val bytes_per_pixel = bpp / 8
    if pitch < width * bytes_per_pixel:
        return false
    true

fn _no_framebuffer() -> FramebufferInfo:
    FramebufferInfo(
        addr: PhysAddr(addr: 0),
        width: 0,
        height: 0,
        pitch: 0,
        bpp: 0
    )

fn _parse_framebuffer() -> FramebufferInfo:
    """Parse Limine framebuffer response."""
    val resp_ptr = framebuffer_request.response
    if resp_ptr == 0:
        log_raw_println("[BOOT] WARNING: No framebuffer response from Limine")
        return _no_framebuffer()

    val _revision = mmio_read64(resp_ptr)
    val fb_count = mmio_read64(resp_ptr + 8)
    val fbs_ptr = mmio_read64(resp_ptr + 16)

    if fb_count == 0:
        log_raw_println("[BOOT] WARNING: No framebuffers available")
        return _no_framebuffer()

    val fb_ptr_addr = fbs_ptr
    val fb_ptr = mmio_read64(fb_ptr_addr)

    val address = mmio_read64(fb_ptr)
    val width = mmio_read64(fb_ptr + 8)
    val height = mmio_read64(fb_ptr + 16)
    val pitch = mmio_read64(fb_ptr + 24)
    val bpp_raw = mmio_read64(fb_ptr + 32)
    val bpp = bpp_raw & 0xFFFF

    log_raw_println("[BOOT] Framebuffer: {width}x{height} bpp={bpp} pitch={pitch}")

    if not limine_framebuffer_fields_valid(width, height, pitch, bpp, address):
        log_raw_println("[BOOT] WARNING: rejecting bogus framebuffer descriptor addr=0x{address} {width}x{height} bpp={bpp} pitch={pitch}, falling back to no-framebuffer")
        return _no_framebuffer()

    FramebufferInfo(
        addr: PhysAddr(addr: address),
        width: width as u32,
        height: height as u32,
        pitch: pitch as u32,
        bpp: bpp as u32
    )

# ============================================================================
# RSDP Parsing
# ============================================================================

fn _parse_rsdp() -> PhysAddr?:
    """Parse Limine RSDP response."""
    val resp_ptr = rsdp_request.response
    if resp_ptr == 0:
        log_raw_println("[BOOT] No RSDP from Limine (ACPI unavailable)")
        return nil

    val _revision = mmio_read64(resp_ptr)
    val address = mmio_read64(resp_ptr + 8)

    log_raw_println("[BOOT] RSDP at physical address 0x{address}")

    PhysAddr(addr: address)

# ============================================================================
# Kernel Address Parsing
# ============================================================================

fn _parse_kernel_address() -> (PhysAddr, VirtAddr):
    """Parse Limine kernel address response."""
    val resp_ptr = kernel_addr_request.response
    if resp_ptr == 0:
        log_raw_println("[BOOT] WARNING: No kernel address response")
        return (PhysAddr(addr: 0), VirtAddr(addr: 0))

    val _revision = mmio_read64(resp_ptr)
    val phys_base = mmio_read64(resp_ptr + 8)
    val virt_base = mmio_read64(resp_ptr + 16)

    log_raw_println("[BOOT] Kernel: phys=0x{phys_base} virt=0x{virt_base}")

    (PhysAddr(addr: phys_base), VirtAddr(addr: virt_base))

# ============================================================================
# Boot Output Assembly
# ============================================================================

extern fn _get_kernel_end() -> u64
extern fn _get_bss_start() -> u64

fn _build_boot_output() -> BootOutputPort:
    """Assemble BootOutputPort from all parsed Limine responses."""
    val memory_map = _parse_memory_map()
    val framebuffer = _parse_framebuffer()
    val rsdp_addr = _parse_rsdp()
    val (kernel_phys, kernel_virt) = _parse_kernel_address()

    val kernel_size = _get_kernel_end() - kernel_phys.addr

    BootOutputPort(
        memory_map: memory_map,
        framebuffer: framebuffer,
        rsdp_addr: rsdp_addr,
        kernel_phys_base: kernel_phys,
        kernel_virt_base: kernel_virt,
        kernel_size: kernel_size,
        # aarch64 delta: PL011 MMIO UART on QEMU `virt`, not x86 port I/O.
        serial_base: 0x09000000,
        serial_is_mmio: true,
        arch: Architecture.Arm64,
        hhdm_offset: g_hhdm_offset
    )

# ============================================================================
# Kernel Entry Point
# ============================================================================

# MILESTONE STUB (2026-08-07): the real cross-arch memory layer (Layer 1)
# `memory_init` is unimplemented for the Limine boot-entry lane on BOTH
# x86_64 (limine_boot.spl) and aarch64 as of this pass — the `extern fn`
# declaration this replaces had no definition anywhere in the tree on
# either arch, so kernel_main() could never have linked before now. This
# stub exists only to let a REAL (non-probe) SimpleOS kernel reach a real
# halt after real serial output, which is this pass's actual milestone
# scope (a genuine klog_api line from the real kernel booted via Limine +
# AAVMF pflash on QEMU aarch64 `virt` — see
# doc/08_tracking/bug/aarch64_real_firmware_boot_gap_and_seed_defects_2026-07-14.md).
# Porting the real memory layer to this boot lane is future work, tracked
# in that same bug doc — do not mistake this stub for a completed memory
# subsystem.
fn memory_init(boot_info: BootOutputPort):
    log_raw_println("[BOOT] memory_init: MILESTONE STUB — Layer 1 not yet ported to the Limine boot lane (aarch64)")
    log_raw_println("[BOOT] SIMPLEOS-AARCH64-LIMINE-KERNEL-OK")
    halt_loop()

# Named `limine_aarch64_boot_main` (not `kernel_main`) because native-build
# mangles non-entry-file module symbols with their full module path
# (`src__os__kernel__boot__limine_boot_aarch64__kernel_main`), which does not
# match the bare `ENTRY(kernel_main)` linker-script directive
# (examples/09_embedded/simple_os/arch/aarch64/boot/linker_limine.ld) — ld.lld
# silently accepts an unresolved ENTRY() name (entry point defaults to 0)
# rather than erroring, and --gc-sections then has no root to keep this
# function from being discarded, producing a link that "succeeds" as an
# empty ~1KB stub with no code at all (found 2026-08-07 bringing up this
# lane: readelf showed Entry point address 0x0 and no .text section).
# examples/09_embedded/simple_os/arch/aarch64/limine_entry.spl defines the
# actual bare `fn kernel_main()` symbol the linker script needs and calls
# this one.
@noreturn
fn limine_aarch64_boot_main():
    """Limine boot entry point (aarch64).

    Called by Limine bootloader (BOOTAA64.EFI) after loading the kernel into
    higher-half. Initializes serial, parses boot info, hands off to the
    memory layer. Structurally identical to limine_boot.spl's kernel_main —
    only the BootOutputPort serial/arch fields differ (see _build_boot_output).
    """
    # Step 1: Initialize early serial for debug output
    log_init_serial(LOG_INFO)
    log_raw_println("")
    log_raw_println("========================================")
    log_raw_println("  SimpleOS — Limine Boot Protocol (aarch64)")
    log_raw_println("========================================")

    # Step 2: Parse HHDM (needed for physical-to-virtual conversions)
    _parse_hhdm()

    # Step 3: Build boot output from all Limine responses
    val boot_info = _build_boot_output()

    log_raw_println("[BOOT] Boot info assembled successfully")
    log_raw_println("[BOOT] Total memory regions: {boot_info.memory_map.len()}")

    # Step 4: Hand off to memory layer (Layer 1)
    log_raw_println("[BOOT] Handing off to memory layer...")
    memory_init(boot_info)

    # Step 5: If control returns, halt
    log_raw_println("[BOOT] FATAL: memory_init returned, halting")
    halt_loop()
