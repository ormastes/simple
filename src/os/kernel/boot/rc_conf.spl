# FreeBSD-style /etc/rc.conf reader for boot-time service gating.
#
# Parses `name_enable="YES|NO"` lines (plus a bare `hostname="..."` line),
# tolerant of comments (#...) and blank lines. Unknown keys are logged, not
# fatal. When /etc/rc.conf is absent, or a specific `<service>_enable` key is
# absent from a present file, the service is treated as ENABLED — this keeps
# every existing autostart call site behaving exactly as before on images
# that don't stage rc.conf at all (the common case today).
#
# MDSOC: feature dimension, boot layer

use os.services.vfs.vfs_init.{g_vfs_file_exists, g_vfs_read_file_text}

extern fn serial_println(msg: text)

val RC_CONF_PATH: text = "/etc/rc.conf"

# String-valued keys this reader recognizes, in addition to any `*_enable`.
# A 4-entry array scan, deliberately NOT a Dict: dict reads of struct-ish
# values are corrupt under native codegen.
val RC_CONF_STRING_KEYS: [text] = ["hostname", "screen_type", "screen_res", "screen_simd"]

# Selectable boot screen types. "wm" is the never-blank floor.
val RC_CONF_SCREEN_TYPES: [text] = ["wm", "2d", "web", "gui"]

pub fn rc_conf_service_enabled(service: text) -> bool:
    """Return whether `<service>_enable` is "YES" per /etc/rc.conf.

    Default is enabled (true) when /etc/rc.conf is absent, or when the
    file exists but does not mention this service's key — matches FreeBSD
    rc.conf semantics closely enough for boot-time gating while never
    surprising a caller that doesn't stage the file.
    """
    val key = "{service}_enable"
    val found = _rc_conf_lookup(key)
    if found == nil:
        return true
    found.unwrap() != "NO"

pub fn rc_conf_hostname() -> text:
    """Return the configured hostname, or "simpleos" when unset."""
    val found = _rc_conf_lookup("hostname")
    if found == nil:
        return "simpleos"
    found.unwrap()

pub fn rc_conf_value(key: text) -> text?:
    """Raw quote-stripped value for any rc.conf key, or nil when the file is
    absent or the key is not present.

    String-valued counterpart to `rc_conf_service_enabled`; performs NO
    validation and applies NO default. Callers that need a fail-closed default
    use the normalizing accessors below.
    """
    _rc_conf_lookup(key)

pub fn rc_conf_normalize_screen_type(raw: text?) -> text:
    """Pure normalization for the `screen_type` key. Fails closed to "wm"
    (today's behavior) on absent, empty, or unrecognized values — never a
    blank screen. Kept separate from `rc_conf_screen_type` so it is testable
    without a mounted VFS.
    """
    if raw == nil:
        return "wm"
    val value = raw.unwrap().trim().to_lower()
    if value == "":
        serial_println("[rc] screen_type empty -> wm")
        return "wm"
    for t in RC_CONF_SCREEN_TYPES:
        if value == t:
            return value
    serial_println("[rc] screen_type={value} unrecognized -> wm")
    "wm"

pub fn rc_conf_screen_type() -> text:
    """Configured boot screen type, normalized to one of wm|2d|web|gui."""
    rc_conf_normalize_screen_type(rc_conf_value("screen_type"))

pub fn rc_conf_parse_screen_res(raw: text?, default_w: i32, default_h: i32) -> (i32, i32):
    """Pure parse of `screen_res="WxH"`. Fails closed to the passed defaults,
    which the kernel supplies as 1024x768 (today's hardcoded BGA mode)."""
    if raw == nil:
        return (default_w, default_h)
    val value = raw.unwrap().trim().to_lower()
    if value == "":
        return (default_w, default_h)
    val sep = value.find_str("x")
    if sep <= 0:
        serial_println("[rc] screen_res={value} malformed -> default")
        return (default_w, default_h)
    # Bind each part to its own typed val: chained `.slice(..).to_i64()` on an
    # erased receiver miscompiles under the JIT.
    val left: text = value.slice(0, sep).trim()
    val right: text = value.slice(sep + 1, value.len()).trim()
    val w: i64 = left.to_i64()
    val h: i64 = right.to_i64()
    if w <= 0 or h <= 0 or w > 8192 or h > 8192:
        serial_println("[rc] screen_res={value} out of range -> default")
        return (default_w, default_h)
    (w as i32, h as i32)

pub fn rc_conf_screen_res(default_w: i32, default_h: i32) -> (i32, i32):
    """Configured boot resolution, or the passed defaults."""
    rc_conf_parse_screen_res(rc_conf_value("screen_res"), default_w, default_h)

pub fn rc_conf_normalize_screen_simd(raw: text?) -> text:
    """Pure normalization for `screen_simd="auto|on|off"`; default "auto"."""
    if raw == nil:
        return "auto"
    val value = raw.unwrap().trim().to_lower()
    if value == "auto" or value == "on" or value == "off":
        return value
    if value != "":
        serial_println("[rc] screen_simd={value} unrecognized -> auto")
    "auto"

pub fn rc_conf_screen_simd() -> text:
    """Configured SIMD preference for the 2d screen lane."""
    rc_conf_normalize_screen_simd(rc_conf_value("screen_simd"))

pub fn rc_conf_screen_type_marker() -> text:
    """Boot-log marker mirroring `rc_conf_service_marker`'s shape."""
    val found = rc_conf_value("screen_type")
    val source = if found == nil: "default" else: "rc.conf"
    val selected = rc_conf_normalize_screen_type(found)
    "[rc] screen_type={selected} ({source})"

pub fn rc_conf_service_marker(service: text) -> text:
    """Boot-log marker text for a service's rc.conf gate decision.

    Distinguishes the "no rc.conf / key absent -> default enabled" case
    from an explicit "(rc.conf)" YES so gate transcripts can tell them
    apart, per the Lane E QEMU gate contract.
    """
    val key = "{service}_enable"
    val found = _rc_conf_lookup(key)
    val enabled = rc_conf_service_enabled(service)
    val state = if enabled: "YES" else: "NO"
    val source = if found == nil: "default" else: "rc.conf"
    "[rc] {key}={state} ({source})"

# ---------------------------------------------------------------------------
# Internal
# ---------------------------------------------------------------------------

fn _rc_conf_lookup(key: text) -> text?:
    """Return the raw (quote-stripped) value for `key`, or nil when the
    file is absent or the key is not present in it."""
    if not g_vfs_file_exists(RC_CONF_PATH):
        return nil
    val content = g_vfs_read_file_text(RC_CONF_PATH)
    for raw_line in content.split("\n"):
        val line = raw_line.trim()
        if line == "" or line.starts_with("#"):
            pass_dn
        else:
            val eq = line.find_str("=")
            if eq < 0:
                serial_println("[rc] malformed rc.conf line ignored: {line}")
            else:
                val k = line.slice(0, eq).trim()
                val raw_value = line.slice(eq + 1, line.len()).trim()
                val v = _strip_quotes(raw_value)
                if k == key:
                    return v
                elif not _is_known_key(k):
                    serial_println("[rc] unknown rc.conf key (ignored): {k}")
    nil

fn _is_known_key(key: text) -> bool:
    """Keys this reader recognizes today; anything else is logged as unknown
    but never treated as fatal."""
    if key.ends_with("_enable"):
        return true
    for k in RC_CONF_STRING_KEYS:
        if key == k:
            return true
    false

fn _strip_quotes(v: text) -> text:
    if v.len() >= 2 and v.starts_with("\"") and v.ends_with("\""):
        return v.slice(1, v.len() - 1)
    v
