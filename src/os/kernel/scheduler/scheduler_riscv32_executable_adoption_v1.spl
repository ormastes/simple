"""Atomic scheduler publication for one retained authenticated Sv32 mapping."""

use os.kernel.scheduler.scheduler_types.{
    Scheduler, TaskControlBlock, SchedulerExecutableAdoptionOwnerStateV1,
    TIME_SLICE_TICKS, scheduler_next_task_lifecycle_identity_take_v1,
    _initial_user_task_context
}
use os.kernel.scheduler.scheduler_task_mgmt.{_find_empty_slot_in}
use os.kernel.scheduler.scheduler_executable_adoption_transition.{
    SchedulerExecutableAdoptionOwnerEventV1,
    scheduler_executable_adoption_transition_v1
}
use os.kernel.loader.executable_authority_registry.{
    ExecutableAuthorityRegistryV1, ExecutableAuthorityTokenV1
}
use os.kernel.loader.riscv32_sv32_mapping_owner_v1.{
    Riscv32Sv32MappingReceiptV1, Riscv32Sv32MappingErrorV1,
    Riscv32Sv32TcbTransferDispositionV1,
    riscv32_sv32_mapping_destroy_v1,
    riscv32_sv32_mapping_transfer_to_tcb_v1
}
use os.kernel.loader.executable_launch_arguments_v1.{
    ExecutableLaunchArgumentsV1, executable_launch_arguments_v1_validate
}
use os.kernel.arch.arch_context.{Architecture}
use os.kernel.arch.mod.{get_arch}
use std.common.contracts.execution.simpleos_executable_admission_v1.{ExecutableImageHandleV1}
use os.kernel.types.task_types.{
    TaskId, TaskState, TaskPriority, default_task_schedule,
    default_task_isolation
}
use os.kernel.types.capability_types.{CapabilitySet, capability_set_bind_owner}
use os.kernel.types.arm32_mapping_handle_v1.{scheduler_arm32_mapping_handle_absent_v1}
use os.kernel.types.x86_32_mapping_handle_v1.{scheduler_x86_32_mapping_handle_absent_v1}
use os.kernel.scheduler.process_execution_observation.{
    SchedulerExecutionObservationHandleV1,
    scheduler_execution_observe_adoption_handle_with_launch_v1,
    scheduler_execution_cancel_adoption_handle_v1
}
use os.kernel.scheduler.server_data_launch_grant_registry.{
    ServerDataLaunchGrantInstallStatusV1,
    server_data_launch_grant_install_before_publication_v1,
    server_data_launch_grant_rollback_before_publication_v1,
    server_data_launch_grant_quarantine_before_publication_v1
}
use os.kernel.scheduler.capability_bridge.{cap_init_task_record}
use os.kernel.ipc.capability.{register_task_vmspace}
use os.kernel.types.vmspace_types.{ProcessVmSpace}

pub struct SchedulerRiscv32AdoptionResultV1:
    pid: u64
    cleanup_indeterminate: bool

fn _riscv32_destroy_failed_adoption_v1(
    owner: ExecutableAuthorityRegistryV1,
    receipt: Riscv32Sv32MappingReceiptV1
) -> SchedulerRiscv32AdoptionResultV1:
    val destroyed = riscv32_sv32_mapping_destroy_v1(owner, receipt)
    SchedulerRiscv32AdoptionResultV1(
        pid: 0u64,
        cleanup_indeterminate:
            destroyed.error != Riscv32Sv32MappingErrorV1.None)

impl Scheduler:
    me _record_riscv32_adoption_v1(
        state: SchedulerExecutableAdoptionOwnerStateV1,
        pid: u64,
        token: ExecutableAuthorityTokenV1
    ):
        self.executable_adoption_state = state
        self.executable_adoption_pid = pid
        self.executable_adoption_token_slot = token.slot_index
        self.executable_adoption_token_generation = token.generation
        self.executable_adoption_token_nonce = token.nonce

    pub me adopt_authenticated_riscv32_mapping_v1(
        owner: ExecutableAuthorityRegistryV1,
        token: ExecutableAuthorityTokenV1,
        receipt: Riscv32Sv32MappingReceiptV1,
        image_handle: ExecutableImageHandleV1,
        launch: ExecutableLaunchArgumentsV1,
        entry_point: u64,
        initial_stack_pointer: u64,
        stack_top: u64,
        priority: TaskPriority,
        caps: CapabilitySet
    ) -> SchedulerRiscv32AdoptionResultV1:
        # Launch arguments are transport, not authority. Revalidate them at
        # the scheduler owner and fail closed if an in-package caller tries to
        # publish an Sv32 mapping outside the active RV32 kernel.
        val checked_launch = executable_launch_arguments_v1_validate(
            launch.path, launch.argv, launch.envp)
        if checked_launch.is_err() or get_arch() != Architecture.Riscv32:
            return _riscv32_destroy_failed_adoption_v1(owner, receipt)
        val owned_launch = checked_launch.unwrap()
        val prepared_owner = scheduler_executable_adoption_transition_v1(
            self.executable_adoption_state,
            SchedulerExecutableAdoptionOwnerEventV1.Prepare)
        if prepared_owner.state != SchedulerExecutableAdoptionOwnerStateV1.Prepared:
            return _riscv32_destroy_failed_adoption_v1(owner, receipt)
        var slot = _find_empty_slot_in(self.tasks)
        if slot < 0 and self.current.id == 0u64: slot = 0
        val maybe_identity = if slot >= 0:
            scheduler_next_task_lifecycle_identity_take_v1()
        else:
            nil
        if slot < 0 or not maybe_identity.?:
            return _riscv32_destroy_failed_adoption_v1(owner, receipt)
        val identity = maybe_identity.unwrap()
        if (identity.task_id == 0u64 or identity.task_id > 0xFFFFFFFFu64 or
            identity.lifecycle_generation == 0u64):
            return _riscv32_destroy_failed_adoption_v1(owner, receipt)
        val id = TaskId(id: identity.task_id)
        val grant = server_data_launch_grant_install_before_publication_v1(
            id.id, identity.lifecycle_generation, 1u64, image_handle)
        if (grant.status != ServerDataLaunchGrantInstallStatusV1.NotApplicable and
            grant.status != ServerDataLaunchGrantInstallStatusV1.Installed):
            return _riscv32_destroy_failed_adoption_v1(owner, receipt)
        val observation = scheduler_execution_observe_adoption_handle_with_launch_v1(
            id.id, self.current.id, image_handle, owned_launch)
        if observation == nil:
            if grant.handle.?:
                val grant_handle = grant.handle.unwrap()
                if not server_data_launch_grant_rollback_before_publication_v1(grant_handle):
                    _ = server_data_launch_grant_quarantine_before_publication_v1(grant_handle)
            return _riscv32_destroy_failed_adoption_v1(owner, receipt)
        val observation_handle: SchedulerExecutionObservationHandleV1 =
            observation.unwrap()
        val transferred = riscv32_sv32_mapping_transfer_to_tcb_v1(
            owner, receipt, id.id, identity.lifecycle_generation,
            entry_point, initial_stack_pointer)
        if transferred.disposition != Riscv32Sv32TcbTransferDispositionV1.Committed:
            _ = scheduler_execution_cancel_adoption_handle_v1(observation_handle)
            if grant.handle.?:
                val grant_handle = grant.handle.unwrap()
                if not server_data_launch_grant_rollback_before_publication_v1(grant_handle):
                    _ = server_data_launch_grant_quarantine_before_publication_v1(grant_handle)
            # Rejected leaves the authenticated receipt in MappedBlocked, so
            # ownership is still local and must be destroyed before returning.
            # Indeterminate may already have moved ownership into the mapping
            # owner's quarantine coordinate and must never be raw-destroyed.
            if transferred.disposition == Riscv32Sv32TcbTransferDispositionV1.Rejected:
                return _riscv32_destroy_failed_adoption_v1(owner, receipt)
            return SchedulerRiscv32AdoptionResultV1(
                pid: 0u64,
                cleanup_indeterminate: true)
        val user_ctx = _initial_user_task_context(entry_point, initial_stack_pointer)
        val task_caps = capability_set_bind_owner(caps, id.id)
        val task = TaskControlBlock(
            id: id, lifecycle_generation: identity.lifecycle_generation,
            name: "authenticated-rv32-user-{id.id}",
            state: TaskState.Ready, priority: priority, is_user: true,
            entry_point: entry_point, context: user_ctx,
            user_context: Some(user_ctx), address_space: transferred.root_phys,
            kernel_stack: 0u64, user_stack: stack_top,
            capabilities: task_caps, parent: Some(self.current),
            schedule: default_task_schedule(priority),
            isolation: default_task_isolation(transferred.root_phys),
            assigned_cpu: 0u32, exit_code: 0,
            ticks_remaining: TIME_SLICE_TICKS,
            arm32_mapping_handle: scheduler_arm32_mapping_handle_absent_v1(),
            riscv32_mapping_handle: transferred.handle,
            x86_32_mapping_handle: scheduler_x86_32_mapping_handle_absent_v1(),
            exec_generation: 1u64)
        self.tasks[slot] = task
        register_task_vmspace(id.id.to_u32(), ProcessVmSpace(
            pml4: transferred.root_phys, id: transferred.root_phys,
            vma_count: 0, areas: []))
        cap_init_task_record(id, true)
        self._enqueue_ready_at_slot(id, slot)
        val published = scheduler_executable_adoption_transition_v1(
            prepared_owner.state, SchedulerExecutableAdoptionOwnerEventV1.Publish)
        self._record_riscv32_adoption_v1(
            published.state, id.id, token)
        val authorized = scheduler_executable_adoption_transition_v1(
            published.state, SchedulerExecutableAdoptionOwnerEventV1.Confirm)
        self._record_riscv32_adoption_v1(
            authorized.state, id.id, token)
        val completed = scheduler_executable_adoption_transition_v1(
            authorized.state, SchedulerExecutableAdoptionOwnerEventV1.Complete)
        self._record_riscv32_adoption_v1(
            completed.state, id.id, token)
        SchedulerRiscv32AdoptionResultV1(pid: id.id, cleanup_indeterminate: false)

export SchedulerRiscv32AdoptionResultV1
