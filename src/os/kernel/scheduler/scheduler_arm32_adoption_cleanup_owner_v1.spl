# ARM32 scheduler-owned post-adoption cleanup ledger.
#
# Mapping publication is irreversible here.  Source-close and observation-
# cancellation are independent retryable owner operations, keyed by the exact
# scheduler lifecycle so PID reuse cannot consume another task's cleanup.

use std.fs_driver.mount_table.{MountTable}
use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}
use os.kernel.loader.executable_authority_registry.{
    ExecutableAuthorityRegistryV1, ExecutableAuthorityTokenV1,
    ExecutableAuthorityStateV1, ExecutableAuthorityErrorV1,
    executable_authority_snapshot
}
use os.kernel.loader.executable_admission_pipeline.{
    executable_loader_release_retrieved
}
use os.kernel.scheduler.process_execution_observation.{
    SchedulerExecutionObservationHandleV1,
    SchedulerExecutionCancellationStatusV1,
    scheduler_execution_cancel_adoption_handle_status_v1
}

enum Arm32AdoptionCleanupStateV1:
    Pending
    InFlight
    Complete

struct Arm32SourceCleanupV1:
    table: MountTable
    authorities: ExecutableAuthorityRegistryV1
    token: ExecutableAuthorityTokenV1

struct Arm32AdoptionCleanupSlotV1:
    task_id: u64
    lifecycle_generation: u64
    state: Arm32AdoptionCleanupStateV1
    source: Arm32SourceCleanupV1?
    observation: SchedulerExecutionObservationHandleV1?
    attempt_count: u64
    indeterminate: bool

pub(package) struct SchedulerArm32AdoptionCleanupReceiptV1:
    task_id: u64
    lifecycle_generation: u64
    complete: bool
    retryable: bool
    indeterminate: bool
    attempt_count: u64

# One source-close coordinate per scheduler task plus one cancellation
# coordinate per bounded observation slot. This is a fixed memory ceiling, not
# an admission-path growth policy.
val ARM32_ADOPTION_CLEANUP_LIMIT_V1: i64 = 512
val _arm32_adoption_cleanup_mutex_v1: i64 = mutex_raw_create()
var _arm32_adoption_cleanup_slots_v1: [Arm32AdoptionCleanupSlotV1] = []
var _arm32_adoption_cleanup_cursor_v1: i64 = 0

fn _arm32_cleanup_lock_v1() -> bool:
    _arm32_adoption_cleanup_mutex_v1 > 0 and
        mutex_raw_lock(_arm32_adoption_cleanup_mutex_v1)

fn _arm32_cleanup_unlock_v1() -> bool:
    mutex_raw_unlock(_arm32_adoption_cleanup_mutex_v1)

fn _arm32_cleanup_index_v1(task_id: u64, lifecycle_generation: u64) -> i64:
    var index = 0
    while index < _arm32_adoption_cleanup_slots_v1.len():
        val slot = _arm32_adoption_cleanup_slots_v1[index]
        if slot.task_id == task_id and
            slot.lifecycle_generation == lifecycle_generation and
            slot.state != Arm32AdoptionCleanupStateV1.Complete:
            return index
        index = index + 1
    -1

fn _arm32_cleanup_receipt_v1(
    slot: Arm32AdoptionCleanupSlotV1
) -> SchedulerArm32AdoptionCleanupReceiptV1:
    val complete = slot.state == Arm32AdoptionCleanupStateV1.Complete
    SchedulerArm32AdoptionCleanupReceiptV1(
        task_id: slot.task_id,
        lifecycle_generation: slot.lifecycle_generation,
        complete: complete,
        retryable: not complete,
        indeterminate: slot.indeterminate,
        attempt_count: slot.attempt_count)

fn _arm32_cleanup_unavailable_receipt_v1(
    task_id: u64, lifecycle_generation: u64
) -> SchedulerArm32AdoptionCleanupReceiptV1:
    SchedulerArm32AdoptionCleanupReceiptV1(
        task_id: task_id, lifecycle_generation: lifecycle_generation,
        complete: false, retryable: true, indeterminate: true,
        attempt_count: 0u64)

fn _arm32_source_cleanup_attempt_v1(source: Arm32SourceCleanupV1) -> bool:
    var table = source.table
    if executable_loader_release_retrieved(
        table, source.authorities, source.token).is_ok():
        return true
    # If the close committed but the cleanup ledger could not record it, the
    # authority owner is the canonical arbiter. A generation-stale exact token
    # also proves that this old lifecycle no longer owns a close operation.
    val snapshot = executable_authority_snapshot(
        source.authorities, source.token)
    match snapshot:
        Ok(value): value.state == ExecutableAuthorityStateV1.Released
        Err(ExecutableAuthorityErrorV1.InvalidToken): true
        Err(ExecutableAuthorityErrorV1.Released): true
        Err(_): false

fn _arm32_cleanup_reserve_slot_v1(
    task_id: u64,
    lifecycle_generation: u64,
    source: Arm32SourceCleanupV1?,
    observation: SchedulerExecutionObservationHandleV1?
) -> SchedulerArm32AdoptionCleanupReceiptV1:
    if task_id == 0u64 or lifecycle_generation == 0u64 or
        (source == nil and observation == nil) or
        not _arm32_cleanup_lock_v1():
        return _arm32_cleanup_unavailable_receipt_v1(
            task_id, lifecycle_generation)
    val existing = _arm32_cleanup_index_v1(task_id, lifecycle_generation)
    if existing >= 0:
        var updated = _arm32_adoption_cleanup_slots_v1[existing]
        # Source and cancellation coordinates may arrive on opposite sides of
        # mapping publication. Merge only a previously absent coordinate;
        # never replace an owner-issued handle for the same lifecycle.
        if updated.source == nil and source != nil:
            updated.source = source
        if updated.observation == nil and observation != nil:
            updated.observation = observation
        _arm32_adoption_cleanup_slots_v1[existing] = updated
        val receipt = _arm32_cleanup_receipt_v1(updated)
        if not _arm32_cleanup_unlock_v1():
            return _arm32_cleanup_unavailable_receipt_v1(
                task_id, lifecycle_generation)
        return receipt

    var reusable = -1
    var index = 0
    while index < _arm32_adoption_cleanup_slots_v1.len():
        if _arm32_adoption_cleanup_slots_v1[index].state ==
            Arm32AdoptionCleanupStateV1.Complete:
            reusable = index
            break
        index = index + 1
    if reusable < 0 and
        _arm32_adoption_cleanup_slots_v1.len() >=
            ARM32_ADOPTION_CLEANUP_LIMIT_V1:
        _ = _arm32_cleanup_unlock_v1()
        return _arm32_cleanup_unavailable_receipt_v1(
            task_id, lifecycle_generation)
    val fresh = Arm32AdoptionCleanupSlotV1(
        task_id: task_id, lifecycle_generation: lifecycle_generation,
        state: Arm32AdoptionCleanupStateV1.Pending,
        source: source, observation: observation,
        attempt_count: 0u64, indeterminate: false)
    if reusable >= 0:
        _arm32_adoption_cleanup_slots_v1[reusable] = fresh
    else:
        _arm32_adoption_cleanup_slots_v1.push(fresh)
    if not _arm32_cleanup_unlock_v1():
        return _arm32_cleanup_unavailable_receipt_v1(
            task_id, lifecycle_generation)
    _arm32_cleanup_receipt_v1(fresh)

pub(package) fn scheduler_arm32_adoption_cleanup_retry_v1(
    task_id: u64,
    lifecycle_generation: u64
) -> SchedulerArm32AdoptionCleanupReceiptV1:
    """Retry one lifecycle without revoking its published mapping."""
    if task_id == 0u64 or lifecycle_generation == 0u64 or
        not _arm32_cleanup_lock_v1():
        return _arm32_cleanup_unavailable_receipt_v1(
            task_id, lifecycle_generation)
    val index = _arm32_cleanup_index_v1(task_id, lifecycle_generation)
    if index < 0:
        if not _arm32_cleanup_unlock_v1():
            return _arm32_cleanup_unavailable_receipt_v1(
                task_id, lifecycle_generation)
        return SchedulerArm32AdoptionCleanupReceiptV1(
            task_id: task_id, lifecycle_generation: lifecycle_generation,
            complete: true, retryable: false, indeterminate: false,
            attempt_count: 0u64)
    var claimed = _arm32_adoption_cleanup_slots_v1[index]
    if claimed.attempt_count == 0xFFFFFFFFFFFFFFFFu64:
        claimed.indeterminate = true
        _arm32_adoption_cleanup_slots_v1[index] = claimed
        _ = _arm32_cleanup_unlock_v1()
        return _arm32_cleanup_receipt_v1(claimed)
    claimed.state = Arm32AdoptionCleanupStateV1.InFlight
    claimed.attempt_count = claimed.attempt_count + 1u64
    _arm32_adoption_cleanup_slots_v1[index] = claimed
    if not _arm32_cleanup_unlock_v1():
        return _arm32_cleanup_unavailable_receipt_v1(
            task_id, lifecycle_generation)

    var source_complete = claimed.source == nil
    if claimed.source != nil:
        source_complete = _arm32_source_cleanup_attempt_v1(
            claimed.source.unwrap())

    var observation_complete = claimed.observation == nil
    var observation_indeterminate = false
    if claimed.observation != nil:
        val cancellation = scheduler_execution_cancel_adoption_handle_status_v1(
            claimed.observation.unwrap())
        match cancellation:
            SchedulerExecutionCancellationStatusV1.Cancelled:
                observation_complete = true
            SchedulerExecutionCancellationStatusV1.AlreadyAbsent:
                observation_complete = true
            SchedulerExecutionCancellationStatusV1.NotCancelable:
                observation_indeterminate = true
            SchedulerExecutionCancellationStatusV1.SerializationUnavailable:
                observation_indeterminate = true

    if not _arm32_cleanup_lock_v1():
        return _arm32_cleanup_unavailable_receipt_v1(
            task_id, lifecycle_generation)
    val current_index = _arm32_cleanup_index_v1(
        task_id, lifecycle_generation)
    if current_index < 0:
        _ = _arm32_cleanup_unlock_v1()
        return _arm32_cleanup_unavailable_receipt_v1(
            task_id, lifecycle_generation)
    var updated = _arm32_adoption_cleanup_slots_v1[current_index]
    if source_complete: updated.source = nil
    if observation_complete: updated.observation = nil
    # A source close that is not confirmed by the authority snapshot remains
    # conservatively indeterminate as well as retryable.
    updated.indeterminate = observation_indeterminate or not source_complete
    if updated.source == nil and updated.observation == nil:
        updated.state = Arm32AdoptionCleanupStateV1.Complete
        updated.indeterminate = false
    else:
        updated.state = Arm32AdoptionCleanupStateV1.Pending
    _arm32_adoption_cleanup_slots_v1[current_index] = updated
    val receipt = _arm32_cleanup_receipt_v1(updated)
    if not _arm32_cleanup_unlock_v1():
        return _arm32_cleanup_unavailable_receipt_v1(
            task_id, lifecycle_generation)
    receipt

pub(package) fn scheduler_arm32_adoption_cleanup_reserve_source_v1(
    task_id: u64,
    lifecycle_generation: u64,
    table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    token: ExecutableAuthorityTokenV1
) -> SchedulerArm32AdoptionCleanupReceiptV1:
    """Retain the close coordinate before irreversible mapping publication."""
    _arm32_cleanup_reserve_slot_v1(
        task_id, lifecycle_generation,
        Some(Arm32SourceCleanupV1(
            table: table, authorities: authorities, token: token)), nil)

pub(package) fn scheduler_arm32_adoption_cleanup_bind_observation_v1(
    task_id: u64,
    lifecycle_generation: u64,
    observation: SchedulerExecutionObservationHandleV1
) -> SchedulerArm32AdoptionCleanupReceiptV1:
    val reserved = _arm32_cleanup_reserve_slot_v1(
        task_id, lifecycle_generation, nil, Some(observation))
    if not reserved.retryable:
        return reserved
    scheduler_arm32_adoption_cleanup_retry_v1(task_id, lifecycle_generation)

pub(package) fn scheduler_arm32_adoption_cleanup_retry_one_v1() -> bool:
    """Advance at most one cursor-selected cleanup in constant work."""
    if not _arm32_cleanup_lock_v1(): return false
    if _arm32_adoption_cleanup_slots_v1.len() == 0:
        return _arm32_cleanup_unlock_v1()
    if _arm32_adoption_cleanup_cursor_v1 < 0 or
        _arm32_adoption_cleanup_cursor_v1 >=
            _arm32_adoption_cleanup_slots_v1.len():
        _arm32_adoption_cleanup_cursor_v1 = 0
    val selected = _arm32_adoption_cleanup_slots_v1[
        _arm32_adoption_cleanup_cursor_v1]
    _arm32_adoption_cleanup_cursor_v1 =
        _arm32_adoption_cleanup_cursor_v1 + 1
    if _arm32_adoption_cleanup_cursor_v1 >=
        _arm32_adoption_cleanup_slots_v1.len():
        _arm32_adoption_cleanup_cursor_v1 = 0
    var task_id = 0u64
    var lifecycle_generation = 0u64
    if selected.state != Arm32AdoptionCleanupStateV1.Complete:
        task_id = selected.task_id
        lifecycle_generation = selected.lifecycle_generation
    if not _arm32_cleanup_unlock_v1(): return false
    if task_id == 0u64 or lifecycle_generation == 0u64: return true
    scheduler_arm32_adoption_cleanup_retry_v1(
        task_id, lifecycle_generation).complete

export SchedulerArm32AdoptionCleanupReceiptV1
export scheduler_arm32_adoption_cleanup_retry_v1
export scheduler_arm32_adoption_cleanup_reserve_source_v1
export scheduler_arm32_adoption_cleanup_bind_observation_v1
export scheduler_arm32_adoption_cleanup_retry_one_v1
