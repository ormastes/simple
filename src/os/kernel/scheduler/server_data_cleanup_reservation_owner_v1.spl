"""Bounded two-owner cleanup reservation for filesystem-launched servers.

The adapter pre-admits a row before touching either provider.  Namespace and
launch-grant authority then enter non-operational CleanupBound states.  A
partial commit retains both opaque provider reservations under the exact
provider-attempt identity so a retry cannot act on a reused task identity.
This prerequisite is intentionally not wired to Scheduler or Zombie.
"""

use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}
use os.kernel.scheduler.server_data_namespace_owner.{
    ServerDataNamespaceCleanupReservationV1,
    ServerDataNamespaceCleanupMutationStatusV1,
    server_data_namespace_reserve_cleanup_v1,
    server_data_namespace_rollback_cleanup_v1,
    server_data_namespace_commit_cleanup_v1
}
use os.kernel.scheduler.server_data_launch_grant_registry.{
    ServerDataLaunchGrantCleanupReservationV1,
    ServerDataLaunchGrantCleanupMutationStatusV1,
    server_data_launch_grant_reserve_cleanup_v1,
    server_data_launch_grant_rollback_cleanup_v1,
    server_data_launch_grant_commit_cleanup_v1
}

pub val SERVER_DATA_CLEANUP_RESERVATION_LIMIT_V1: i64 = 64

pub enum ServerDataCleanupReservationStateV1:
    Free
    Preparing
    Bound
    Dispatching
    NamespaceCommitted
    Completed
    RetainedPartial
    Indeterminate
    Retired

pub enum ServerDataCleanupReservationEventV1:
    PublishBound
    BeginDispatch
    RetainPartial
    MarkIndeterminate
    RecordNamespaceCommit
    RecordComplete
    ConsumeTerminal

pub fn server_data_cleanup_state_transition_v1(
    state: ServerDataCleanupReservationStateV1,
    event: ServerDataCleanupReservationEventV1
) -> ServerDataCleanupReservationStateV1?:
    match event:
        ServerDataCleanupReservationEventV1.PublishBound:
            if state == ServerDataCleanupReservationStateV1.Preparing:
                return Some(ServerDataCleanupReservationStateV1.Bound)
        ServerDataCleanupReservationEventV1.BeginDispatch:
            if (state == ServerDataCleanupReservationStateV1.Bound or
                state == ServerDataCleanupReservationStateV1.NamespaceCommitted or
                state == ServerDataCleanupReservationStateV1.RetainedPartial):
                return Some(ServerDataCleanupReservationStateV1.Dispatching)
        ServerDataCleanupReservationEventV1.RetainPartial:
            if (state == ServerDataCleanupReservationStateV1.Preparing or
                state == ServerDataCleanupReservationStateV1.Dispatching):
                return Some(ServerDataCleanupReservationStateV1.RetainedPartial)
        ServerDataCleanupReservationEventV1.MarkIndeterminate:
            if (state == ServerDataCleanupReservationStateV1.Preparing or
                state == ServerDataCleanupReservationStateV1.Dispatching or
                state == ServerDataCleanupReservationStateV1.RetainedPartial):
                return Some(ServerDataCleanupReservationStateV1.Indeterminate)
        ServerDataCleanupReservationEventV1.RecordNamespaceCommit:
            if state == ServerDataCleanupReservationStateV1.Dispatching:
                return Some(ServerDataCleanupReservationStateV1.NamespaceCommitted)
        ServerDataCleanupReservationEventV1.RecordComplete:
            if (state == ServerDataCleanupReservationStateV1.Dispatching or
                state == ServerDataCleanupReservationStateV1.NamespaceCommitted):
                return Some(ServerDataCleanupReservationStateV1.Completed)
        ServerDataCleanupReservationEventV1.ConsumeTerminal:
            if state == ServerDataCleanupReservationStateV1.Completed:
                return Some(ServerDataCleanupReservationStateV1.Free)
    nil

pub fn server_data_cleanup_handle_matches_v1(
    state: ServerDataCleanupReservationStateV1,
    stored_generation: u64,
    stored_nonce: u64,
    handle_generation: u64,
    handle_nonce: u64
) -> bool:
    state != ServerDataCleanupReservationStateV1.Free and
        state != ServerDataCleanupReservationStateV1.Retired and
        stored_generation != 0u64 and stored_generation == handle_generation and
        stored_nonce != 0u64 and stored_nonce == handle_nonce

pub fn server_data_cleanup_slot_reusable_v1(
    state: ServerDataCleanupReservationStateV1, generation: u64
) -> bool:
    state == ServerDataCleanupReservationStateV1.Free and
        generation != 0xffffffffffffffffu64

pub(package) struct ServerDataCleanupBoundV1:
    _slot: i64
    _generation: u64
    _nonce: u64

pub struct ServerDataCleanupReceiptV1:
    task_id: u64
    lifecycle_generation: u64
    transaction_id: u64
    transaction_generation: u64
    attempt_ordinal: u64
    namespace_committed: bool
    grant_committed: bool
    terminal: bool
    retryable: bool
    indeterminate: bool

pub fn server_data_cleanup_terminal_v1(
    namespace_committed: bool, grant_committed: bool
) -> bool:
    namespace_committed and grant_committed

pub fn server_data_cleanup_retryable_v1(
    namespace_committed: bool, grant_committed: bool
) -> bool:
    not server_data_cleanup_terminal_v1(
        namespace_committed, grant_committed)

pub(package) struct ServerDataCleanupBindResultV1:
    reservation: ServerDataCleanupBoundV1?
    receipt: ServerDataCleanupReceiptV1
    reason: text

struct ServerDataCleanupSlotV1:
    state: ServerDataCleanupReservationStateV1
    generation: u64
    nonce: u64
    task_id: u64
    lifecycle_generation: u64
    transaction_id: u64
    transaction_generation: u64
    attempt_ordinal: u64
    namespace_reservation: ServerDataNamespaceCleanupReservationV1?
    grant_reservation: ServerDataLaunchGrantCleanupReservationV1?
    namespace_committed: bool
    grant_committed: bool

struct ServerDataCleanupOwnerV1:
    quarantined: bool
    next_nonce: u64
    slots: [ServerDataCleanupSlotV1]

val _server_data_cleanup_mutex_v1: i64 = mutex_raw_create()
var _server_data_cleanup_owner_v1 = ServerDataCleanupOwnerV1(
    quarantined: false,
    next_nonce: 0x5344434c45414e31u64,
    slots: [])

fn _server_data_cleanup_empty_v1(generation: u64) -> ServerDataCleanupSlotV1:
    ServerDataCleanupSlotV1(
        state: ServerDataCleanupReservationStateV1.Free,
        generation: generation, nonce: 0u64,
        task_id: 0u64, lifecycle_generation: 0u64,
        transaction_id: 0u64, transaction_generation: 0u64,
        attempt_ordinal: 0u64,
        namespace_reservation: nil, grant_reservation: nil,
        namespace_committed: false, grant_committed: false)

fn _server_data_cleanup_lock_v1() -> bool:
    _server_data_cleanup_mutex_v1 > 0 and
        not _server_data_cleanup_owner_v1.quarantined and
        mutex_raw_lock(_server_data_cleanup_mutex_v1)

fn _server_data_cleanup_unlock_v1() -> bool:
    if mutex_raw_unlock(_server_data_cleanup_mutex_v1): return true
    _server_data_cleanup_owner_v1.quarantined = true
    false

fn _server_data_cleanup_receipt_v1(
    slot: ServerDataCleanupSlotV1,
    terminal: bool,
    retryable: bool
) -> ServerDataCleanupReceiptV1:
    ServerDataCleanupReceiptV1(
        task_id: slot.task_id,
        lifecycle_generation: slot.lifecycle_generation,
        transaction_id: slot.transaction_id,
        transaction_generation: slot.transaction_generation,
        attempt_ordinal: slot.attempt_ordinal,
        namespace_committed: slot.namespace_committed,
        grant_committed: slot.grant_committed,
        terminal: terminal, retryable: retryable, indeterminate: false)

fn _server_data_cleanup_blank_receipt_v1(
    task_id: u64, lifecycle_generation: u64,
    transaction_id: u64, transaction_generation: u64,
    attempt_ordinal: u64
) -> ServerDataCleanupReceiptV1:
    ServerDataCleanupReceiptV1(
        task_id: task_id, lifecycle_generation: lifecycle_generation,
        transaction_id: transaction_id,
        transaction_generation: transaction_generation,
        attempt_ordinal: attempt_ordinal,
        namespace_committed: false, grant_committed: false,
        terminal: false, retryable: false, indeterminate: false)

fn _server_data_cleanup_indeterminate_receipt_v1(
    slot: ServerDataCleanupSlotV1
) -> ServerDataCleanupReceiptV1:
    ServerDataCleanupReceiptV1(
        task_id: slot.task_id,
        lifecycle_generation: slot.lifecycle_generation,
        transaction_id: slot.transaction_id,
        transaction_generation: slot.transaction_generation,
        attempt_ordinal: slot.attempt_ordinal,
        namespace_committed: slot.namespace_committed,
        grant_committed: slot.grant_committed,
        terminal: false, retryable: false, indeterminate: true)

fn _server_data_cleanup_index_v1(
    handle: ServerDataCleanupBoundV1
) -> i64:
    if handle._slot < 0 or
        handle._slot >= _server_data_cleanup_owner_v1.slots.len() or
        handle._generation == 0u64 or handle._nonce == 0u64:
        return -1
    val slot = _server_data_cleanup_owner_v1.slots[handle._slot]
    if (slot.state != ServerDataCleanupReservationStateV1.Bound and
        slot.state != ServerDataCleanupReservationStateV1.Dispatching and
        slot.state != ServerDataCleanupReservationStateV1.NamespaceCommitted and
        slot.state != ServerDataCleanupReservationStateV1.RetainedPartial and
        slot.state != ServerDataCleanupReservationStateV1.Indeterminate and
        slot.state != ServerDataCleanupReservationStateV1.Completed) or
        not server_data_cleanup_handle_matches_v1(
            slot.state, slot.generation, slot.nonce,
            handle._generation, handle._nonce):
        return -1
    handle._slot

fn _server_data_cleanup_live_identity_locked_v1(
    transaction_id: u64, transaction_generation: u64, attempt_ordinal: u64
) -> bool:
    for slot in _server_data_cleanup_owner_v1.slots:
        if slot.state != ServerDataCleanupReservationStateV1.Free and
            slot.state != ServerDataCleanupReservationStateV1.Retired and
            slot.transaction_id == transaction_id and
            slot.transaction_generation == transaction_generation and
            slot.attempt_ordinal == attempt_ordinal:
            return true
    false

pub(package) fn server_data_cleanup_bind_v1(
    task_id: u64,
    lifecycle_generation: u64,
    transaction_id: u64,
    transaction_generation: u64,
    attempt_ordinal: u64
) -> ServerDataCleanupBindResultV1:
    val blank = _server_data_cleanup_blank_receipt_v1(
        task_id, lifecycle_generation, transaction_id,
        transaction_generation, attempt_ordinal)
    if task_id == 0u64 or lifecycle_generation == 0u64 or
        transaction_id == 0u64 or transaction_generation == 0u64 or
        attempt_ordinal == 0u64 or not _server_data_cleanup_lock_v1():
        return ServerDataCleanupBindResultV1(
            reservation: nil, receipt: blank, reason: "invalid-or-unavailable")
    if _server_data_cleanup_live_identity_locked_v1(
        transaction_id, transaction_generation, attempt_ordinal):
        _ = _server_data_cleanup_unlock_v1()
        return ServerDataCleanupBindResultV1(
            reservation: nil, receipt: blank, reason: "attempt-already-bound")
    var index = -1
    var i = 0
    while i < _server_data_cleanup_owner_v1.slots.len():
        if server_data_cleanup_slot_reusable_v1(
            _server_data_cleanup_owner_v1.slots[i].state,
            _server_data_cleanup_owner_v1.slots[i].generation):
            index = i
            break
        i = i + 1
    if index < 0 and _server_data_cleanup_owner_v1.slots.len() >=
        SERVER_DATA_CLEANUP_RESERVATION_LIMIT_V1:
        _ = _server_data_cleanup_unlock_v1()
        return ServerDataCleanupBindResultV1(
            reservation: nil, receipt: blank, reason: "reservation-owner-full")
    val prior_generation = if index >= 0:
        _server_data_cleanup_owner_v1.slots[index].generation
    else: 0u64
    if prior_generation == 0xffffffffffffffffu64 or
        _server_data_cleanup_owner_v1.next_nonce == 0xffffffffffffffffu64:
        if index >= 0:
            _server_data_cleanup_owner_v1.slots[index].state =
                ServerDataCleanupReservationStateV1.Retired
        _ = _server_data_cleanup_unlock_v1()
        return ServerDataCleanupBindResultV1(
            reservation: nil, receipt: blank, reason: "identity-exhausted")
    if index < 0: index = _server_data_cleanup_owner_v1.slots.len()
    _server_data_cleanup_owner_v1.next_nonce =
        _server_data_cleanup_owner_v1.next_nonce + 1u64
    val prepared = ServerDataCleanupSlotV1(
        state: ServerDataCleanupReservationStateV1.Preparing,
        generation: prior_generation + 1u64,
        nonce: _server_data_cleanup_owner_v1.next_nonce,
        task_id: task_id, lifecycle_generation: lifecycle_generation,
        transaction_id: transaction_id,
        transaction_generation: transaction_generation,
        attempt_ordinal: attempt_ordinal,
        namespace_reservation: nil, grant_reservation: nil,
        namespace_committed: false, grant_committed: false)
    if index == _server_data_cleanup_owner_v1.slots.len():
        _server_data_cleanup_owner_v1.slots.push(prepared)
    else:
        _server_data_cleanup_owner_v1.slots[index] = prepared
    val handle = ServerDataCleanupBoundV1(
        _slot: index, _generation: prepared.generation, _nonce: prepared.nonce)
    val namespace = server_data_namespace_reserve_cleanup_v1(
        task_id, lifecycle_generation, transaction_id,
        transaction_generation, attempt_ordinal)
    if namespace.reservation == nil:
        _server_data_cleanup_owner_v1.slots[index] =
            _server_data_cleanup_empty_v1(prepared.generation)
        _ = _server_data_cleanup_unlock_v1()
        return ServerDataCleanupBindResultV1(
            reservation: nil, receipt: blank, reason: "namespace-reserve-failed")
    _server_data_cleanup_owner_v1.slots[index].namespace_reservation =
        namespace.reservation
    if namespace.status ==
        ServerDataNamespaceCleanupMutationStatusV1.Indeterminate:
        _server_data_cleanup_owner_v1.slots[index].state =
            ServerDataCleanupReservationStateV1.Indeterminate
        val retained = _server_data_cleanup_owner_v1.slots[index]
        _ = _server_data_cleanup_unlock_v1()
        return ServerDataCleanupBindResultV1(
            reservation: Some(handle),
            receipt: _server_data_cleanup_indeterminate_receipt_v1(retained),
            reason: "namespace-reserve-indeterminate")

    val grant = server_data_launch_grant_reserve_cleanup_v1(
        task_id, lifecycle_generation, transaction_id,
        transaction_generation, attempt_ordinal)
    if grant.reservation == nil:
        val rollback = server_data_namespace_rollback_cleanup_v1(
            namespace.reservation.unwrap())
        val rolled_back = rollback ==
            ServerDataNamespaceCleanupMutationStatusV1.Applied
        if rolled_back:
            _server_data_cleanup_owner_v1.slots[index] =
                _server_data_cleanup_empty_v1(prepared.generation)
        else:
            _server_data_cleanup_owner_v1.slots[index].state =
                ServerDataCleanupReservationStateV1.RetainedPartial
        val retained = _server_data_cleanup_owner_v1.slots[index]
        var rollback_receipt = blank
        if not rolled_back:
            rollback_receipt = _server_data_cleanup_receipt_v1(
                retained, false, true)
        if rollback ==
            ServerDataNamespaceCleanupMutationStatusV1.Indeterminate:
            _server_data_cleanup_owner_v1.slots[index].state =
                ServerDataCleanupReservationStateV1.Indeterminate
            rollback_receipt =
                _server_data_cleanup_indeterminate_receipt_v1(retained)
        _ = _server_data_cleanup_unlock_v1()
        return ServerDataCleanupBindResultV1(
            reservation: if rolled_back: nil else: Some(handle),
            receipt: rollback_receipt,
            reason: if rolled_back: "grant-reserve-failed-rolled-back"
                else: "grant-reserve-failed-namespace-retained")

    _server_data_cleanup_owner_v1.slots[index].grant_reservation =
        grant.reservation
    if grant.status ==
        ServerDataLaunchGrantCleanupMutationStatusV1.Indeterminate:
        _server_data_cleanup_owner_v1.slots[index].state =
            ServerDataCleanupReservationStateV1.Indeterminate
        val retained = _server_data_cleanup_owner_v1.slots[index]
        _ = _server_data_cleanup_unlock_v1()
        return ServerDataCleanupBindResultV1(
            reservation: Some(handle),
            receipt: _server_data_cleanup_indeterminate_receipt_v1(retained),
            reason: "grant-reserve-indeterminate")

    _server_data_cleanup_owner_v1.slots[index].state =
        server_data_cleanup_state_transition_v1(
            _server_data_cleanup_owner_v1.slots[index].state,
            ServerDataCleanupReservationEventV1.PublishBound).unwrap()
    if not _server_data_cleanup_unlock_v1():
        return ServerDataCleanupBindResultV1(
            reservation: Some(handle),
            receipt: _server_data_cleanup_indeterminate_receipt_v1(
                _server_data_cleanup_owner_v1.slots[index]),
            reason: "joint-publication-indeterminate")
    ServerDataCleanupBindResultV1(
        reservation: Some(handle), receipt: blank, reason: "cleanup-bound")

pub(package) fn server_data_cleanup_commit_v1(
    handle: ServerDataCleanupBoundV1
) -> Result<ServerDataCleanupReceiptV1, text>:
    if not _server_data_cleanup_lock_v1(): return Err("cleanup owner unavailable")
    val index = _server_data_cleanup_index_v1(handle)
    if index < 0:
        _ = _server_data_cleanup_unlock_v1()
        return Err("stale cleanup reservation")
    var slot = _server_data_cleanup_owner_v1.slots[index]
    if slot.state == ServerDataCleanupReservationStateV1.Completed:
        val receipt = _server_data_cleanup_receipt_v1(slot, true, false)
        if not _server_data_cleanup_unlock_v1(): return Err("receipt indeterminate")
        return Ok(receipt)
    if slot.state == ServerDataCleanupReservationStateV1.Indeterminate:
        val receipt = _server_data_cleanup_indeterminate_receipt_v1(slot)
        if not _server_data_cleanup_unlock_v1():
            return Err("indeterminate receipt unavailable")
        return Ok(receipt)
    if slot.state == ServerDataCleanupReservationStateV1.Dispatching:
        _ = _server_data_cleanup_unlock_v1()
        return Err("cleanup attempt already dispatching")
    val prior_state = slot.state
    slot.state = server_data_cleanup_state_transition_v1(
        slot.state,
        ServerDataCleanupReservationEventV1.BeginDispatch).unwrap()
    _server_data_cleanup_owner_v1.slots[index] = slot
    val namespace = slot.namespace_reservation
    var grant = slot.grant_reservation
    if namespace == nil:
        slot.state = prior_state
        _server_data_cleanup_owner_v1.slots[index] = slot
        val receipt = _server_data_cleanup_receipt_v1(slot, false, true)
        _ = _server_data_cleanup_unlock_v1()
        return Ok(receipt)
    if not _server_data_cleanup_unlock_v1():
        return Err("dispatch publication indeterminate")

    if grant == nil:
        val grant_result = server_data_launch_grant_reserve_cleanup_v1(
            slot.task_id, slot.lifecycle_generation, slot.transaction_id,
            slot.transaction_generation, slot.attempt_ordinal)
        grant = grant_result.reservation
        if grant == nil:
            slot.state = prior_state
            if _server_data_cleanup_lock_v1():
                val current = _server_data_cleanup_index_v1(handle)
                if current >= 0:
                    _server_data_cleanup_owner_v1.slots[current] = slot
                _ = _server_data_cleanup_unlock_v1()
            return Ok(_server_data_cleanup_receipt_v1(slot, false, true))
        slot.grant_reservation = grant
        if grant_result.status ==
            ServerDataLaunchGrantCleanupMutationStatusV1.Indeterminate:
            slot.state = ServerDataCleanupReservationStateV1.Indeterminate
            if _server_data_cleanup_lock_v1():
                val current = _server_data_cleanup_index_v1(handle)
                if current >= 0:
                    _server_data_cleanup_owner_v1.slots[current] = slot
                _ = _server_data_cleanup_unlock_v1()
            return Ok(_server_data_cleanup_indeterminate_receipt_v1(slot))

    if not slot.namespace_committed:
        val namespace_status =
            server_data_namespace_commit_cleanup_v1(namespace.unwrap())
        if namespace_status != ServerDataNamespaceCleanupMutationStatusV1.Applied:
            slot.state = if namespace_status ==
                ServerDataNamespaceCleanupMutationStatusV1.Indeterminate:
                ServerDataCleanupReservationStateV1.Indeterminate
            else: prior_state
            if _server_data_cleanup_lock_v1():
                val current = _server_data_cleanup_index_v1(handle)
                if current >= 0:
                    _server_data_cleanup_owner_v1.slots[current] = slot
                _ = _server_data_cleanup_unlock_v1()
            if namespace_status ==
                ServerDataNamespaceCleanupMutationStatusV1.Indeterminate:
                return Ok(_server_data_cleanup_indeterminate_receipt_v1(slot))
            return Ok(_server_data_cleanup_receipt_v1(slot, false, true))
        slot.namespace_committed = true
        slot.state = server_data_cleanup_state_transition_v1(
            ServerDataCleanupReservationStateV1.Dispatching,
            ServerDataCleanupReservationEventV1.RecordNamespaceCommit).unwrap()
        if not _server_data_cleanup_lock_v1():
            return Err("namespace completion retention unavailable")
        val current = _server_data_cleanup_index_v1(handle)
        if current < 0:
            _ = _server_data_cleanup_unlock_v1()
            return Err("namespace completion retention stale")
        _server_data_cleanup_owner_v1.slots[current] = slot
        if not _server_data_cleanup_unlock_v1():
            return Err("namespace completion retention indeterminate")

    if grant == nil:
        return Ok(_server_data_cleanup_receipt_v1(slot, false, true))
    val grant_status =
        server_data_launch_grant_commit_cleanup_v1(grant.unwrap())
    if grant_status != ServerDataLaunchGrantCleanupMutationStatusV1.Applied:
        if grant_status ==
            ServerDataLaunchGrantCleanupMutationStatusV1.Indeterminate:
            slot.state = ServerDataCleanupReservationStateV1.Indeterminate
            if _server_data_cleanup_lock_v1():
                val current = _server_data_cleanup_index_v1(handle)
                if current >= 0:
                    _server_data_cleanup_owner_v1.slots[current] = slot
                _ = _server_data_cleanup_unlock_v1()
            return Ok(_server_data_cleanup_indeterminate_receipt_v1(slot))
        return Ok(_server_data_cleanup_receipt_v1(slot, false, true))
    slot.grant_committed = true
    slot.state = server_data_cleanup_state_transition_v1(
        slot.state,
        ServerDataCleanupReservationEventV1.RecordComplete).unwrap()
    if not _server_data_cleanup_lock_v1(): return Err("completion retention unavailable")
    val current = _server_data_cleanup_index_v1(handle)
    if current < 0:
        _ = _server_data_cleanup_unlock_v1()
        return Err("completion retention stale")
    _server_data_cleanup_owner_v1.slots[current] = slot
    val receipt = _server_data_cleanup_receipt_v1(slot, true, false)
    if not _server_data_cleanup_unlock_v1(): return Err("completion indeterminate")
    Ok(receipt)

pub(package) fn server_data_cleanup_consume_terminal_v1(
    handle: ServerDataCleanupBoundV1
) -> bool:
    """Owner-side ACK: consume one retained terminal receipt and free capacity."""
    if not _server_data_cleanup_lock_v1(): return false
    val index = _server_data_cleanup_index_v1(handle)
    if index < 0 or _server_data_cleanup_owner_v1.slots[index].state !=
        ServerDataCleanupReservationStateV1.Completed:
        _ = _server_data_cleanup_unlock_v1()
        return false
    val generation = _server_data_cleanup_owner_v1.slots[index].generation
    _server_data_cleanup_owner_v1.slots[index] =
        _server_data_cleanup_empty_v1(generation)
    _server_data_cleanup_unlock_v1()
