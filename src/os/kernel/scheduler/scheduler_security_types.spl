"""Task-owned security values. Creation grants no policy or root authority."""

use os.kernel.types.task_types.{TaskId}

pub struct TaskSecurity:
    principal_id: u64
    job_id: u64
    parent_job_id: u64
    cspace_id: u64
    resource_domain_id: u64
    parent_resource_domain_id: u64
    audit_context_id: u64
    policy_bound: bool
    resource_limits_bound: bool
    process_limit: u64
    memory_limit_pages: u64
    cpu_weight_bound: bool
    syscall_filter_bound: bool
    syscall_filter: [u64]
    root_mint_authority: bool
    reaper_authority: bool

pub struct TaskSecurityBinding:
    """Trusted managed-launch input; only the scheduler publishes this binding."""
    parent_task_id: u64
    parent_resource_domain_id: u64
    child_task_id: TaskId

pub fn task_security_binding_managed_child(
    parent_task_id: u64, parent_resource_domain_id: u64, child_task_id: TaskId
) -> TaskSecurityBinding:
    TaskSecurityBinding(
        parent_task_id: parent_task_id,
        parent_resource_domain_id: parent_resource_domain_id,
        child_task_id: child_task_id)

pub fn default_task_security(id: TaskId) -> TaskSecurity:
    """Assign fresh PID-backed identities without authorizing any syscall."""
    TaskSecurity(
        principal_id: id.id, job_id: id.id, parent_job_id: 0u64,
        cspace_id: id.id, resource_domain_id: id.id,
        parent_resource_domain_id: 0u64, audit_context_id: id.id,
        policy_bound: false, resource_limits_bound: false,
        process_limit: 0u64, memory_limit_pages: 0u64,
        cpu_weight_bound: false, syscall_filter_bound: false,
        syscall_filter: [], root_mint_authority: false, reaper_authority: false)

pub fn task_security_fork(parent: TaskSecurity, child: TaskId) -> TaskSecurity:
    """Retain the job and its restrictions; root and reaper objects never fork."""
    TaskSecurity(
        principal_id: child.id, job_id: parent.job_id,
        parent_job_id: parent.parent_job_id, cspace_id: child.id,
        resource_domain_id: parent.resource_domain_id,
        parent_resource_domain_id: parent.parent_resource_domain_id,
        audit_context_id: child.id, policy_bound: parent.policy_bound,
        resource_limits_bound: parent.resource_limits_bound,
        process_limit: parent.process_limit, memory_limit_pages: parent.memory_limit_pages,
        cpu_weight_bound: parent.cpu_weight_bound,
        syscall_filter_bound: parent.syscall_filter_bound,
        syscall_filter: parent.syscall_filter,
        root_mint_authority: false, reaper_authority: false)
