# Preemptive Scheduler — Computation Dimension
#
# Priority-based preemptive scheduler with round-robin within same priority.
# Fixed-size task table (MAX_TASKS slots). Timer interrupt drives preemption.
#
# Hub file: imports types from scheduler_types.spl; algorithm bodies live in
# scheduler_task_mgmt.spl, scheduler_algorithm.spl, and scheduler_exec.spl.
#
# Consumes: SchedulerInputPort (interrupts, memory)
# Produces: SchedulerOutputPort (task lifecycle, blocking)

# Split into the _Scheduler/ transparent package to keep module cohesion under the 800-line source limit.
export use os.kernel.scheduler._Scheduler.scheduler_imports.{serial_println}
export use os.kernel.scheduler._Scheduler.scheduler_lifecycle.{serial_println, SCHEDULER_TIMER_VECTOR}
export use os.kernel.scheduler._Scheduler.scheduler_green_lifecycle.{serial_println}
export use os.kernel.scheduler._Scheduler.scheduler_priority_exec.{serial_println}
export use os.kernel.scheduler._Scheduler.scheduler_helpers.{serial_println}
export use os.kernel.scheduler._Scheduler.scheduler_authority.*
export use os.kernel.scheduler.scheduler_executable_adoption.{SchedulerExecutableAdoptionOwnerEventV1, SchedulerExecutableAdoptionTransitionV1, scheduler_executable_adoption_transition_v1, SchedulerExecutableAdoptionResultV1, SchedulerExecutableAdoptionSnapshotV1}
export use os.kernel.scheduler.server_data_launch_grant_registry.{ServerDataLaunchGrantProtocolStateV1, ServerDataLaunchGrantProtocolEventV1, server_data_launch_grant_protocol_transition_v1, ServerDataLaunchGrantSlotV1, ServerDataLaunchGrantRegistryStateV1, SERVER_DATA_LAUNCH_GRANT_LIMIT_V1}
