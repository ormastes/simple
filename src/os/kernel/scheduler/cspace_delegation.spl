# Live CSpace delegation — isolated scheduler authority transition.
#
# This is deliberately independent of the older IPC CapabilityManager.  The
# scheduler task table is the source of truth for a running workload's CSpace.

use os.kernel.types.task_types.{TaskId}
use os.kernel.types.capability_types.{CapabilityToken}
use os.kernel.scheduler.scheduler_types.{TaskControlBlock}

fn _delegate_find_slot(tasks: [TaskControlBlock?], id: TaskId) -> i64:
    var index = 0
    while index < tasks.len():
        val entry = tasks[index]
        if entry != nil:
            val task = entry
            if task.id.id == id.id:
                return index
        index = index + 1
    -1

fn _delegate_highest_token_id(tasks: [TaskControlBlock?]) -> u64:
    var highest = 0u64
    var task_index = 0
    while task_index < tasks.len():
        val task_entry = tasks[task_index]
        if task_entry != nil:
            val task = task_entry
            val cspace = task.capabilities
            var cap_index = 0
            while cap_index < cspace.caps.len():
                val token = cspace.caps[cap_index]
                if token.token_id > highest:
                    highest = token.token_id
                cap_index = cap_index + 1
        task_index = task_index + 1
    highest

pub fn sched_delegate_cspace_token(
    tasks: [TaskControlBlock?],
    from: TaskId,
    to: TaskId,
    token_id: u64
) -> ([TaskControlBlock?], i64):
    """Delegate one exact live token to another task's CSpace.

    A child is a fresh lineage token, not a reinterpretation of a capability
    kind supplied by the caller.  It retains the parent kind, advances the
    generation, consumes one delegation-depth level, and invalidates cached
    target CSpace identities by advancing the target generation.
    """
    if token_id == 0u64:
        return (tasks, -1)
    if from.id == to.id:
        return (tasks, -1)
    val source_slot = _delegate_find_slot(tasks, from)
    val target_slot = _delegate_find_slot(tasks, to)
    if source_slot < 0 or target_slot < 0:
        return (tasks, -1)
    val source_entry = tasks[source_slot]
    val target_entry = tasks[target_slot]
    if source_entry == nil or target_entry == nil:
        return (tasks, -1)
    val source = source_entry
    val source_cspace = source.capabilities
    var source_token: CapabilityToken? = nil
    var source_index = 0
    while source_index < source_cspace.caps.len():
        val candidate = source_cspace.caps[source_index]
        if candidate.token_id == token_id and candidate.owner == from.id:
            source_token = Some(candidate)
        source_index = source_index + 1
    if source_token == nil:
        return (tasks, -1)
    val parent_token = source_token.unwrap()
    if parent_token.depth <= 0:
        return (tasks, -1)
    val highest = _delegate_highest_token_id(tasks)
    if highest == 18446744073709551615u64:
        return (tasks, -1)
    val minted = CapabilityToken(
        kind: parent_token.kind,
        generation: parent_token.generation + 1u64,
        owner: to.id,
        token_id: highest + 1u64,
        parent_token_id: parent_token.token_id,
        depth: parent_token.depth - 1i64
    )
    var updated = tasks
    var target = target_entry
    var target_cspace = target.capabilities
    target_cspace.caps.push(minted)
    target_cspace.is_pledged = true
    target.capabilities = target_cspace
    var target_security = target.security
    target_security.cspace_id = target_security.cspace_id + 1u64
    target.security = target_security
    updated[target_slot] = target
    val minted_id = minted.token_id
    (updated, minted_id.to_i64())
