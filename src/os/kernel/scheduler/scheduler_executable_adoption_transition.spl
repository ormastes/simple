use os.kernel.scheduler.scheduler_executable_adoption_state.{
    SchedulerExecutableAdoptionOwnerStateV1
}

pub enum SchedulerExecutableAdoptionOwnerEventV1:
    Prepare
    Publish
    Confirm
    Complete
    CommitIndeterminate
    Reject

pub struct SchedulerExecutableAdoptionTransitionV1:
    state: SchedulerExecutableAdoptionOwnerStateV1
    execution_authorized: bool

pub fn scheduler_executable_adoption_transition_v1(
    state: SchedulerExecutableAdoptionOwnerStateV1,
    event: SchedulerExecutableAdoptionOwnerEventV1
) -> SchedulerExecutableAdoptionTransitionV1:
    if event == SchedulerExecutableAdoptionOwnerEventV1.Reject or
        event == SchedulerExecutableAdoptionOwnerEventV1.CommitIndeterminate:
        return SchedulerExecutableAdoptionTransitionV1(
            state: SchedulerExecutableAdoptionOwnerStateV1.Quarantined,
            execution_authorized: false)
    if state == SchedulerExecutableAdoptionOwnerStateV1.Idle and
        event == SchedulerExecutableAdoptionOwnerEventV1.Prepare:
        return SchedulerExecutableAdoptionTransitionV1(
            state: SchedulerExecutableAdoptionOwnerStateV1.Prepared,
            execution_authorized: false)
    if state == SchedulerExecutableAdoptionOwnerStateV1.Prepared and
        event == SchedulerExecutableAdoptionOwnerEventV1.Publish:
        return SchedulerExecutableAdoptionTransitionV1(
            state: SchedulerExecutableAdoptionOwnerStateV1.Published,
            execution_authorized: false)
    if state == SchedulerExecutableAdoptionOwnerStateV1.Published and
        event == SchedulerExecutableAdoptionOwnerEventV1.Confirm:
        return SchedulerExecutableAdoptionTransitionV1(
            state: SchedulerExecutableAdoptionOwnerStateV1.Authorized,
            execution_authorized: true)
    # A confirmed execution hands its proof to the caller and releases only
    # the scheduler transaction owner. The registry retains consumed-token
    # replay state. No failure or quarantine can take this edge.
    if state == SchedulerExecutableAdoptionOwnerStateV1.Authorized and
        event == SchedulerExecutableAdoptionOwnerEventV1.Complete:
        return SchedulerExecutableAdoptionTransitionV1(
            state: SchedulerExecutableAdoptionOwnerStateV1.Idle,
            execution_authorized: false)
    SchedulerExecutableAdoptionTransitionV1(
        state: SchedulerExecutableAdoptionOwnerStateV1.Quarantined,
        execution_authorized: false)
