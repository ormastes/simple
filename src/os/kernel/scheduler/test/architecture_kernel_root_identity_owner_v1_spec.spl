use std.spec
use os.kernel.scheduler.architecture_switch_completion_owner_v1.{
    ArchitectureSwitchKindV1
}
use os.kernel.scheduler.architecture_kernel_root_identity_owner_v1.*

describe "architecture kernel root identity owner v1":
    it "canonicalizes repeated x86 CR3 readback":
        val first = architecture_kernel_root_capture_v1(
            ArchitectureSwitchKindV1.X86Cr3, 64u64, 0x12345005u64)
        val second = architecture_kernel_root_capture_v1(
            ArchitectureSwitchKindV1.X86Cr3, 64u64, 0x12345005u64)
        expect(first.is_ok()).to_be(true)
        expect(second.is_ok()).to_be(true)
        expect(second.unwrap().mapping_id).to_equal(first.unwrap().mapping_id)
        expect(second.unwrap().root_phys).to_equal(0x12345000u64)

    it "decodes exact Sv32 and Sv48 root identities":
        val rv32 = architecture_kernel_root_capture_v1(
            ArchitectureSwitchKindV1.RiscvSatp, 32u64, 0x80000004u64)
        val rv64 = architecture_kernel_root_capture_v1(
            ArchitectureSwitchKindV1.RiscvSatp, 64u64,
            0x9000000000000008u64)
        expect(rv32.is_ok()).to_be(true)
        expect(rv32.unwrap().root_phys).to_equal(0x4000u64)
        expect(rv64.is_ok()).to_be(true)
        expect(rv64.unwrap().root_phys).to_equal(0x8000u64)

    it "rejects disabled translation and zero roots":
        val disabled = architecture_kernel_root_capture_v1(
            ArchitectureSwitchKindV1.RiscvSatp, 64u64, 0u64)
        val zero_cr3 = architecture_kernel_root_capture_v1(
            ArchitectureSwitchKindV1.X86Cr3, 32u64, 0u64)
        expect(disabled.is_err()).to_be(true)
        expect(disabled.unwrap_err()).to_equal(
            ArchitectureKernelRootIdentityErrorV1.TranslationDisabled)
        expect(zero_cr3.is_err()).to_be(true)
        expect(zero_cr3.unwrap_err()).to_equal(
            ArchitectureKernelRootIdentityErrorV1.InvalidRoot)

    it "keeps architecture and register width in canonical identity key":
        val x86 = architecture_kernel_root_capture_v1(
            ArchitectureSwitchKindV1.X86Cr3, 64u64, 0x7000u64)
        val arm = architecture_kernel_root_capture_v1(
            ArchitectureSwitchKindV1.ArmTtbr0, 64u64, 0x7000u64)
        expect(x86.is_ok()).to_be(true)
        expect(arm.is_ok()).to_be(true)
        expect(x86.unwrap().mapping_id == arm.unwrap().mapping_id).to_be(false)
