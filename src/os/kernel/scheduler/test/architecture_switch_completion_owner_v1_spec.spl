use std.spec
use os.kernel.scheduler.architecture_switch_completion_owner_v1.*

fn residency(id: u64, generation: u64, root: u64) -> ArchitectureResidencyIdentityV1:
    ArchitectureResidencyIdentityV1(
        mapping_id: id, mapping_generation: generation, root_phys: root)

describe "architecture switch completion owner v1":
    it "retains outgoing until exact x86 readback completes":
        val cpu = 51u64
        val old = residency(1u64, 1u64, 0x1000u64)
        val new = residency(2u64, 1u64, 0x2000u64)
        expect(architecture_switch_register_current_v1(cpu, old)).to_be(true)
        val prepared = architecture_switch_prepare_v1(
            cpu, ArchitectureSwitchKindV1.X86Cr3, old, new)
        expect(prepared.is_ok()).to_be(true)
        val ticket = prepared.unwrap()
        expect(architecture_switch_mark_write_started_v1(ticket)).to_be(true)
        val arch = architecture_switch_x86_cr3_receipt_v1(
            ticket, new.root_phys, 0x2000u64, 64u64, true)
        val completed = architecture_switch_complete_v1(ticket, arch)
        expect(completed.ok).to_be(true)
        expect(completed.incoming.mapping_id).to_equal(2u64)
        expect(completed.release_pending).to_be(true)
        expect(completed.readiness_permitted).to_be(false)
        expect(completed.destruction_permitted).to_be(false)
        val released = architecture_switch_redeem_outgoing_release_v1(ticket)
        expect(released.ok).to_be(true)
        expect(released.outgoing.mapping_id).to_equal(1u64)
        expect(architecture_switch_redeem_outgoing_release_v1(ticket).ok).to_be(false)

    it "quarantines mismatch without releasing outgoing":
        val cpu = 52u64
        val old = residency(3u64, 1u64, 0x4000u64)
        val new = residency(4u64, 1u64, 0x8000u64)
        expect(architecture_switch_register_current_v1(cpu, old)).to_be(true)
        val ticket = architecture_switch_prepare_v1(
            cpu, ArchitectureSwitchKindV1.ArmTtbr0, old, new).unwrap()
        expect(architecture_switch_mark_write_started_v1(ticket)).to_be(true)
        val arch = architecture_switch_arm_ttbr0_receipt_v1(
            ticket, new.root_phys, 0xC000u64, 64u64, true)
        val completed = architecture_switch_complete_v1(ticket, arch)
        expect(completed.ok).to_be(false)
        expect(completed.error).to_equal(
            ArchitectureSwitchErrorV1.HardwareReadbackMismatch)
        expect(completed.release_pending).to_be(false)
        expect(architecture_switch_cancel_before_write_v1(ticket)).to_be(false)

    it "cancels only the prepared pre-write transaction":
        val cpu = 53u64
        val old = residency(5u64, 2u64, 0x10000u64)
        val new = residency(6u64, 2u64, 0x20000u64)
        expect(architecture_switch_register_current_v1(cpu, old)).to_be(true)
        val ticket = architecture_switch_prepare_v1(
            cpu, ArchitectureSwitchKindV1.RiscvSatp, old, new).unwrap()
        expect(architecture_switch_cancel_before_write_v1(ticket)).to_be(true)
        expect(architecture_switch_cancel_before_write_v1(ticket)).to_be(false)

    it "accepts exact Sv32 and Sv48 SATP encodings":
        val ticket32 = ArchitectureSwitchTicketV1(
            cpu_id: 1u64, switch_generation: 1u64, nonce: 1u64,
            kind: ArchitectureSwitchKindV1.RiscvSatp)
        val rv32 = architecture_switch_riscv_satp_receipt_v1(
            ticket32, 0x4000u64, 0x80000004u64, 32u64, true)
        expect(rv32.readback_matches).to_be(true)
        val ticket64 = ArchitectureSwitchTicketV1(
            cpu_id: 2u64, switch_generation: 2u64, nonce: 2u64,
            kind: ArchitectureSwitchKindV1.RiscvSatp)
        val rv64 = architecture_switch_riscv_satp_receipt_v1(
            ticket64, 0x8000u64, 0x9000000000000008u64, 64u64, true)
        expect(rv64.readback_matches).to_be(true)

    it "rejects a second in-flight switch on one CPU":
        val cpu = 54u64
        val old = residency(7u64, 3u64, 0x1000u64)
        val new = residency(8u64, 3u64, 0x2000u64)
        expect(architecture_switch_register_current_v1(cpu, old)).to_be(true)
        val first = architecture_switch_prepare_v1(
            cpu, ArchitectureSwitchKindV1.X86Cr3, old, new)
        expect(first.is_ok()).to_be(true)
        val second = architecture_switch_prepare_v1(
            cpu, ArchitectureSwitchKindV1.X86Cr3, old, new)
        expect(second.is_err()).to_be(true)
        expect(second.unwrap_err()).to_equal(
            ArchitectureSwitchErrorV1.AlreadyPrepared)
        expect(architecture_switch_cancel_before_write_v1(first.unwrap())).to_be(true)

    it "rejects roots that overflow architecture register fields":
        val riscv = ArchitectureSwitchTicketV1(
            cpu_id: 3u64, switch_generation: 3u64, nonce: 3u64,
            kind: ArchitectureSwitchKindV1.RiscvSatp)
        val rv32 = architecture_switch_riscv_satp_receipt_v1(
            riscv, 0x400000000u64, 0x80000000u64, 32u64, true)
        expect(rv32.readback_matches).to_be(false)
        val x86 = ArchitectureSwitchTicketV1(
            cpu_id: 4u64, switch_generation: 4u64, nonce: 4u64,
            kind: ArchitectureSwitchKindV1.X86Cr3)
        val high = architecture_switch_x86_cr3_receipt_v1(
            x86, 0x8000000000001000u64, 0x1000u64, 64u64, true)
        expect(high.readback_matches).to_be(false)

    it "rejects relabelling one physical root as another mapping":
        val cpu = 56u64
        val current = residency(10u64, 1u64, 0x5000u64)
        val alias = residency(11u64, 1u64, 0x5000u64)
        expect(architecture_switch_register_current_v1(cpu, current)).to_be(true)
        val prepared = architecture_switch_prepare_v1(
            cpu, ArchitectureSwitchKindV1.X86Cr3, current, alias)
        expect(prepared.is_err()).to_be(true)
        expect(prepared.unwrap_err()).to_equal(
            ArchitectureSwitchErrorV1.InvalidIdentity)

    it "rejects changed x86 and ARM register attributes on readback":
        val x86 = ArchitectureSwitchTicketV1(
            cpu_id: 5u64, switch_generation: 5u64, nonce: 5u64,
            kind: ArchitectureSwitchKindV1.X86Cr3)
        val changed_pcid = architecture_switch_x86_cr3_receipt_v1(
            x86, 0x9000u64, 0x9001u64, 64u64, true)
        expect(changed_pcid.readback_matches).to_be(false)
        val arm = ArchitectureSwitchTicketV1(
            cpu_id: 6u64, switch_generation: 6u64, nonce: 6u64,
            kind: ArchitectureSwitchKindV1.ArmTtbr0)
        val changed_asid = architecture_switch_arm_ttbr0_receipt_v1(
            arm, 0xC000u64, 0x000100000000C000u64, 64u64, true)
        expect(changed_asid.readback_matches).to_be(false)
