"""Guest completion is distinct from failure to obtain an execution result."""

pub enum UserHandoffErrorV2:
    ValidationRejected
    OutputSlotBusy
    OutputSlotReleaseFailed
    TokenRejected
    CompletionMissing
    UnsupportedArchitecture

pub enum UserHandoffResultV2:
    Exited(code: i64)
    Failed(error: UserHandoffErrorV2)

pub fn user_handoff_error_errno_v2(error: UserHandoffErrorV2) -> i64:
    match error:
        case UserHandoffErrorV2.OutputSlotBusy: -16
        case UserHandoffErrorV2.OutputSlotReleaseFailed: -5
        case UserHandoffErrorV2.TokenRejected: -16
        case UserHandoffErrorV2.UnsupportedArchitecture: -38
        case _: -22

pub fn user_handoff_legacy_status_v2(result: UserHandoffResultV2) -> i64:
    """Lossy scalar compatibility only; never use to authorize exit evidence."""
    match result:
        case UserHandoffResultV2.Exited(code): code
        case UserHandoffResultV2.Failed(error): user_handoff_error_errno_v2(error)

export UserHandoffErrorV2, UserHandoffResultV2
export user_handoff_error_errno_v2, user_handoff_legacy_status_v2
