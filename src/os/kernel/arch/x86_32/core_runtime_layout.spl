# x86_32 (i686) core-runtime layout policy (pure, target-neutral, host-testable).
#
# Shared by os.kernel.arch.x86_32.core_runtime. Value tagging, alignment,
# index normalization, byte merge and decimal formatting are identical to the
# riscv32 lane and reused from os.kernel.arch.riscv32.core_runtime_layout;
# only what differs on x86_32 lives here.
#
# Layout matches examples/09_embedded/simple_os/arch/x86_32/boot/baremetal_stubs.c:
#   RuntimeArray: {u32 type=2, u32 size, u32 len, u32 cap, RuntimeValue items[]} (8-byte items)
#   (items are INLINE at +16 — rv32 instead stores a data pointer at +16).
# Predicates return i64 1/0, not bool (bool-returning calls in conditions
# lower to rt_value_truthy, which the i686 freestanding image does not define).

pub val X86_32_RT_ARRAY_ITEMS_OFFSET: i64 = 16

pub fn x86_32_rt_array_item_addr(obj: i64, idx: i64) -> i64:
    """Address of inline item `idx` of an untagged RuntimeArray pointer."""
    # Literal, not the module val: freestanding builds skip module initializers.
    obj + 16 + idx * 8

pub fn x86_32_rt_ram_ref(ptr: i64) -> i64:
    """1 when `ptr` lies in the identity-mapped kernel window [1 MiB, 1 GiB).

    The kernel links at 0x100000 (arch/x86_32/linker.ld) and its bump heap is a
    static array in .bss, so every heap object is inside this window. Both
    bounds are positive as i32, so the signed compares are safe."""
    if ptr < 0x00100000:
        return 0
    if ptr >= 0x40000000:
        return 0
    1

export X86_32_RT_ARRAY_ITEMS_OFFSET, x86_32_rt_array_item_addr, x86_32_rt_ram_ref
