@runtime_intrinsics
# x86_32 privileged runtime boundary.
#
# This is the sole x86_32 owner of raw port-I/O and CR3 declarations. Keep the
# public facade is 32-bit, while the authoritative C runtime ABI stays u64.
# Hosted i386 runtime_minimal cannot execute privileged CR3 access: its read
# returns zero and write is a no-op. Callers can query that fact without
# attempting the privileged operation.

extern fn rt_port_inb(port: u16) -> u8
extern fn rt_port_outb(port: u16, value: u8)
extern fn rt_port_inw(port: u16) -> u16
extern fn rt_port_outw(port: u16, value: u16)
extern fn rt_port_inl(port: u16) -> u32
extern fn rt_port_outl(port: u16, value: u32)
extern fn rt_port_io_wait()
extern fn rt_read_cr3() -> u64
extern fn rt_write_cr3(value: u64)

fn hal_x86_32_port_inb(port: u16) -> u8: rt_port_inb(port)
fn hal_x86_32_port_outb(port: u16, value: u8): rt_port_outb(port, value)
fn hal_x86_32_port_inw(port: u16) -> u16: rt_port_inw(port)
fn hal_x86_32_port_outw(port: u16, value: u16): rt_port_outw(port, value)
fn hal_x86_32_port_inl(port: u16) -> u32: rt_port_inl(port)
fn hal_x86_32_port_outl(port: u16, value: u32): rt_port_outl(port, value)
fn hal_x86_32_port_io_wait(): rt_port_io_wait()
fn hal_x86_32_read_cr3() -> u32: rt_read_cr3().to_u32()
fn hal_x86_32_write_cr3(value: u32): rt_write_cr3(value.to_u64())
fn hal_x86_32_cr3_width_bits() -> u32: 32
fn hal_x86_32_cr3_available() -> bool: false

export hal_x86_32_port_inb, hal_x86_32_port_outb, hal_x86_32_port_inw, hal_x86_32_port_outw
export hal_x86_32_port_inl, hal_x86_32_port_outl, hal_x86_32_port_io_wait
export hal_x86_32_read_cr3, hal_x86_32_write_cr3
export hal_x86_32_cr3_width_bits, hal_x86_32_cr3_available
