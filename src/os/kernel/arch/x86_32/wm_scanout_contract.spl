# x86_32 Multiboot framebuffer admission for the portable WM host seam.

struct X86_32WmScanoutFacts:
    address: u64
    width: u32
    height: u32
    pitch: u32
    bpp: u32
    framebuffer_type: u32
    red_position: u32
    red_mask_size: u32
    green_position: u32
    green_mask_size: u32
    blue_position: u32
    blue_mask_size: u32

fn x86_32_wm_scanout_rejection(facts: X86_32WmScanoutFacts) -> text:
    if facts.address == 0u64:
        return "missing-address"
    if facts.address > 0xFFFFFFFFu64:
        return "address-outside-i686"
    if facts.address % 4u64 != 0u64:
        return "unaligned-address"
    if facts.width == 0u32:
        return "empty-geometry"
    if facts.height == 0u32:
        return "empty-geometry"
    if facts.bpp != 32u32:
        return "unsupported-bpp"
    if facts.framebuffer_type != 1u32:
        return "unsupported-framebuffer-type"
    if facts.red_position != 16u32:
        return "unsupported-red-layout"
    if facts.red_mask_size != 8u32:
        return "unsupported-red-layout"
    if facts.green_position != 8u32:
        return "unsupported-green-layout"
    if facts.green_mask_size != 8u32:
        return "unsupported-green-layout"
    if facts.blue_position != 0u32:
        return "unsupported-blue-layout"
    if facts.blue_mask_size != 8u32:
        return "unsupported-blue-layout"
    val row_bytes = facts.width.to_u64() * 4u64
    if facts.pitch.to_u64() != row_bytes:
        return "unsupported-pitch"
    val span = facts.pitch.to_u64() * facts.height.to_u64()
    if span == 0u64:
        return "empty-span"
    val i686_limit = 0x100000000u64
    if span > i686_limit:
        return "span-outside-i686"
    if facts.address > i686_limit - span:
        return "span-outside-i686"
    ""

fn x86_32_wm_scanout_span(facts: X86_32WmScanoutFacts) -> u64:
    facts.pitch.to_u64() * facts.height.to_u64()

fn x86_32_wm_scanout_ready(facts: X86_32WmScanoutFacts) -> bool:
    x86_32_wm_scanout_rejection(facts) == ""

export X86_32WmScanoutFacts
export x86_32_wm_scanout_rejection
export x86_32_wm_scanout_ready
export x86_32_wm_scanout_span
