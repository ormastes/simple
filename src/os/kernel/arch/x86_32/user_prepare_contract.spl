# x86_32 scheduler preparation contract (non-live).
#
# This module validates the data that the future scheduler allocator hands to
# the architecture owner. It performs no allocation, publication, or entry.

use os.kernel.types.task_types.{TaskId}
use os.kernel.arch.x86_32.privilege_abi.{
    X86_32_ENTRY_KERNEL_STACK_BYTES, X86_32_ENTRY_STACK_ALIGNMENT,
    X86_32_NONCE_USER_VA, X86_32_NONCE_PAGE_BYTES
}

struct X86_32UserPrepareV1:
    task_id: TaskId
    task_generation: u64
    address_space_id: u64
    user_cr3: u32
    entry_eip: u32
    user_esp: u32
    kernel_stack_base: u32
    kernel_stack_top: u32
    kernel_stack_pages: u32
    nonce_user_va: u32
    nonce_length: u32
    token_registry_slot: u32
    token_registry_generation: u32

fn x86_32_user_prepare_valid(prepared: X86_32UserPrepareV1) -> bool:
    prepared.task_id.id != 0 and
    prepared.task_generation != 0 and
    prepared.address_space_id != 0 and
    prepared.user_cr3 != 0 and (prepared.user_cr3 & 0xFFF) == 0 and
    prepared.entry_eip != 0 and prepared.user_esp != 0 and
    prepared.kernel_stack_base != 0 and
    prepared.kernel_stack_top > prepared.kernel_stack_base and
    (prepared.kernel_stack_top & (X86_32_ENTRY_STACK_ALIGNMENT - 1)) == 0 and
    prepared.kernel_stack_pages * 4096 == X86_32_ENTRY_KERNEL_STACK_BYTES and
    prepared.kernel_stack_top - prepared.kernel_stack_base == X86_32_ENTRY_KERNEL_STACK_BYTES and
    prepared.nonce_user_va == X86_32_NONCE_USER_VA and
    prepared.nonce_length != 0 and prepared.nonce_length <= X86_32_NONCE_PAGE_BYTES and
    prepared.token_registry_generation != 0

fn x86_32_nonce_overlaps_load_segment(segment_va: u64, segment_size: u64) -> bool:
    if segment_size == 0 or segment_va >= 0x100000000:
        return false
    val reserved_start = X86_32_NONCE_USER_VA as u64
    val reserved_end = reserved_start + X86_32_NONCE_PAGE_BYTES as u64
    if segment_size > 0x100000000 - segment_va:
        return true
    val segment_end = segment_va + segment_size
    segment_va < reserved_end and segment_end > reserved_start

# Required lifecycle for the future scheduler implementation:
# allocate contiguous pages -> persist base/top/page count in exact TCB -> arm
# token -> architecture entry. On exit/fault: compare-clear exact active token
# -> mark exact task exited -> wait_for_collect -> free stack pages and CR3.
