# Shared scalar RuntimeValue box/unbox exports for the 32-bit SimpleOS kernels
# (arm32, riscv32, i686). Codegen calls rt_value_int / rt_value_unbox_int to box
# and unbox a raw i64 as a tagged int (int = v << 3, see common/rt_value.spl).
# Pure functions over the shared rv_* helpers: no memory access, no rt_* calls.
# Each arch entry imports this module with an empty `.{}` list as the keepalive.
# Wide (>61-bit) ints are not boxed on the freestanding lane; they wrap like
# rt_value_u64 does in the per-arch shims.

use os.kernel.arch.common.rt_value.{rv_box_int, rv_unbox_int}

@export("C")
fn rt_value_int(raw: i64) -> i64:
    rv_box_int(raw)

@export("C")
fn rt_value_unbox_int(v: i64) -> i64:
    rv_unbox_int(v)
