# Entropy Mix — the shared splitmix64 finalizer used by every arch's
# early-boot entropy seed.
#
# Each `arch/<arch>/entropy.spl` collects a different raw source (RDRAND,
# RNDR, RISC-V seed CSR, timer counters). The avalanche step applied to
# that raw material is identical everywhere, and used to exist as seven
# byte-identical private `_mix64` copies — which also produced
# cross-module private-symbol collisions. The arch-specific part stays in
# the per-arch module; only this constant-folded math lives here.

fn mix64(x: u64) -> u64:
    """splitmix64 finalizer — avalanche a raw entropy word."""
    var v = x ^ (x >> 30)
    v = v * 0xBF58476D1CE4E5B9
    v = v ^ (v >> 27)
    v = v * 0x94D049BB133111EB
    v ^ (v >> 31)
