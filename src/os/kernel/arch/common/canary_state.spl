# Stack-Canary State — the arch-independent half of HalCanary.
#
# The three `arch/<arch>/canary.spl` modules held identical state, the
# same seed/fallback selection and the same non-zero guard; only the
# entropy source they fall back to is arch-specific. That source stays in
# the per-arch module and is passed in here.

val CANARY_FALLBACK: u64 = 0xA5A55A5AA55A5AA5

var g_canary_value: u64 = 0

fn canary_set(seed: u64, entropy: u64):
    """Install `seed`, or `entropy` when no seed was supplied; never zero."""
    g_canary_value = if seed == 0: entropy else: seed
    if g_canary_value == 0:
        g_canary_value = CANARY_FALLBACK

fn canary_raw() -> u64:
    """Current canary word; 0 means not yet initialized."""
    g_canary_value

fn canary_fail_common() -> i32:
    """Canary check failure — reported as -1 to the arch trap path."""
    -1
