# ARM64 QEMU virt VirtIO-MMIO input facade.
#
# Hardware queue discovery and ownership stays in the ARM64 freestanding
# runtime.  This facade deliberately exposes only decoded raw evdev records;
# callers must use os.drivers.virtio.virtio_input_ops for the shared input
# models rather than introducing an ARM-only keyboard or pointer type.

use os.drivers.virtio.virtio_input_ops.{VirtioInputEvent}

extern fn rt_arm64_virtio_input_init() -> u32
extern fn rt_arm64_virtio_input_poll() -> u32
extern fn rt_arm64_virtio_input_event_type() -> u16
extern fn rt_arm64_virtio_input_event_code() -> u16
extern fn rt_arm64_virtio_input_event_value() -> u32
extern fn rt_arm64_virtio_input_event_device_kind() -> u32
extern fn rt_arm64_virtio_input_event_irq_status() -> u32
extern fn rt_arm64_virtio_input_poll_packed() -> u64

val ARM64_VIRTIO_INPUT_KEYBOARD_READY: u32 = 1
val ARM64_VIRTIO_INPUT_POINTER_READY: u32 = 2
val ARM64_VIRTIO_INPUT_DEVICE_KEYBOARD: u32 = 1
val ARM64_VIRTIO_INPUT_DEVICE_POINTER: u32 = 2
val ARM64_VIRTIO_INPUT_REQUIRED_READY: u32 =
    ARM64_VIRTIO_INPUT_KEYBOARD_READY | ARM64_VIRTIO_INPUT_POINTER_READY

fn arm64_virtio_input_init() -> u32:
    """Discover keyboard/pointer by capability and post eventq 0 buffers."""
    rt_arm64_virtio_input_init()

fn arm64_virtio_input_ready(mask: u32) -> bool:
    (mask & ARM64_VIRTIO_INPUT_REQUIRED_READY) == ARM64_VIRTIO_INPUT_REQUIRED_READY

# Scalar production lane. Keep each raw field outside Option/class transport;
# the injectable aggregate poller below remains the hardware-free test seam.
fn arm64_virtio_input_poll_scalar() -> u32: rt_arm64_virtio_input_poll()
fn arm64_virtio_input_device_kind_scalar() -> u32: rt_arm64_virtio_input_event_device_kind()
fn arm64_virtio_input_type_scalar() -> u16: rt_arm64_virtio_input_event_type()
fn arm64_virtio_input_code_scalar() -> u16: rt_arm64_virtio_input_event_code()
fn arm64_virtio_input_value_scalar() -> u32: rt_arm64_virtio_input_event_value()
fn arm64_virtio_input_irq_status_scalar() -> u32: rt_arm64_virtio_input_event_irq_status()
fn arm64_virtio_input_poll_packed() -> u64: rt_arm64_virtio_input_poll_packed()

fn arm64_virtio_input_poll() -> VirtioInputEvent?:
    """Return one used-ring event after its descriptor has been recycled."""
    if rt_arm64_virtio_input_poll() == 0:
        return nil
    val device_kind: u32 = rt_arm64_virtio_input_event_device_kind()
    val event_type: u16 = rt_arm64_virtio_input_event_type()
    val event_code: u16 = rt_arm64_virtio_input_event_code()
    val event_value: u32 = rt_arm64_virtio_input_event_value()
    val irq_status: u32 = rt_arm64_virtio_input_event_irq_status()
    VirtioInputEvent(
        device_kind: device_kind,
        type_: event_type,
        code: event_code,
        value: event_value,
        irq_status: irq_status
    )
