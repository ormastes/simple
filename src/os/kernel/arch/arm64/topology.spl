"""AArch64 boot-protocol topology census and identity publication."""

use os.kernel.boot.mmio.{mmio_read32, mmio_read64}
use os.kernel.arch.arm64.cpu.{mrs_mpidr_el1}
use os.kernel.arch.arm_shared.topology_identity.{
    arm_publish_firmware_mpidr_census_v1,
}
use os.kernel.smp.cpu_topology_identity_owner_v1.{
    CPU_TOPOLOGY_IDENTITY_CAPACITY_V1,
    CpuHardwareIdentityKindV1,
    cpu_hardware_identity_canonical_v1,
}

# Limine aarch64 SMP response layout:
# revision, flags, bsp_mpidr, cpu_count, cpu_info_pointer_array.
val LIMINE_SMP_RESPONSE_BSP_MPIDR_OFFSET_V1: u64 = 16u64
val LIMINE_SMP_RESPONSE_CPU_COUNT_OFFSET_V1: u64 = 24u64
val LIMINE_SMP_RESPONSE_CPUS_OFFSET_V1: u64 = 32u64
val LIMINE_SMP_INFO_PROCESSOR_ID_OFFSET_V1: u64 = 0u64
val LIMINE_SMP_INFO_MPIDR_OFFSET_V1: u64 = 8u64

pub fn arm64_publish_limine_cpu_census_v1(response_ptr: u64) -> bool:
    """Validate and publish Limine's exact AArch64 processing-element list."""
    if response_ptr == 0u64:
        return false
    val bsp_mpidr = mmio_read64(
        response_ptr + LIMINE_SMP_RESPONSE_BSP_MPIDR_OFFSET_V1)
    val cpu_count = mmio_read64(
        response_ptr + LIMINE_SMP_RESPONSE_CPU_COUNT_OFFSET_V1)
    val cpu_ptrs = mmio_read64(
        response_ptr + LIMINE_SMP_RESPONSE_CPUS_OFFSET_V1)
    if cpu_count == 0u64 or
       cpu_count > CPU_TOPOLOGY_IDENTITY_CAPACITY_V1.to_u64() or
       cpu_ptrs == 0u64:
        return false

    # Cross-check the boot protocol's BSP identity against hardware before
    # making the response reachable to interrupt/scheduler readers.
    val observed_bsp = cpu_hardware_identity_canonical_v1(
        CpuHardwareIdentityKindV1.ArmMpidr, mrs_mpidr_el1())
    val reported_bsp = cpu_hardware_identity_canonical_v1(
        CpuHardwareIdentityKindV1.ArmMpidr, bsp_mpidr)
    if observed_bsp != reported_bsp:
        return false

    var mpidrs: [u64] = []
    var i = 0u64
    while i < cpu_count:
        val info_ptr = mmio_read64(cpu_ptrs + i * 8u64)
        if info_ptr == 0u64:
            return false
        # Processor IDs must be a dense boot census; accepting holes would
        # detach the published logical IDs from Limine's CPU records.
        if mmio_read32(info_ptr + LIMINE_SMP_INFO_PROCESSOR_ID_OFFSET_V1) != i.to_u32():
            return false
        mpidrs.push(mmio_read64(info_ptr + LIMINE_SMP_INFO_MPIDR_OFFSET_V1))
        i = i + 1u64
    arm_publish_firmware_mpidr_census_v1(mpidrs, reported_bsp)
