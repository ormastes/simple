"""RISC-V boot-hart identity publication.

Current RISC-V boot entries admit exactly one runnable kernel hart; secondary
harts in the direct M-mode entries remain parked.  Publish only that observed
boot hart as logical CPU zero.  A checked-in or firmware-described hart count
is not an identity census and must never be expanded into guessed hart IDs.
"""

use os.kernel.smp.cpu_topology_identity_owner_v1.{
    CpuHardwareIdentityKindV1, CpuTopologyIdentityOwnerV1,
}
use os.kernel.smp.cpu_identity_runtime_surface_v1.{
    cpu_identity_runtime_publish_v1,
}

pub fn riscv_publish_boot_hart_identity_v1(observed_hart_id: u64) -> bool:
    """Seal and publish the sole currently runnable, exactly observed hart."""
    var owner = CpuTopologyIdentityOwnerV1.create(
        CpuHardwareIdentityKindV1.RiscvHart)
    if not owner.register_riscv_hart(0u32, observed_hart_id):
        return false
    val sealed = owner.seal()
    if not sealed.accepted:
        return false
    cpu_identity_runtime_publish_v1(sealed.snapshot)
