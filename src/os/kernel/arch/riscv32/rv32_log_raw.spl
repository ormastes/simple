# riscv32 raw kernel log sink — pure Simple.
#
# riscv64 kernels get `log_raw_println` from C (arch/riscv64/boot
# freestanding_runtime.c). riscv32 has no C runtime, so this module exports
# the same unmangled symbol from Simple over the shared 16550 MMIO UART, and
# every `extern fn log_raw_println(msg: text)` in the rv32 kernel binds to it.
# @cfg(riscv32) keeps the definition out of other arches' closures, where it
# would collide with the C provider.

use os.kernel.arch.riscv.console_common.{RISCV_VIRT_UART_BASE, riscv_uart_writeln}

@cfg(riscv32)
@export
fn log_raw_println(msg: text):
    riscv_uart_writeln(RISCV_VIRT_UART_BASE, msg)

fn rv32_log_raw_link_anchor() -> bool:
    """Imported by the riscv32 kernel entry so the provider is in the closure."""
    true
