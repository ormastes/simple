# Canonical provider for the optional RV32 NVMe firmware boot hook.
#
# The raw symbol remains a weak C ABI shim because a separately linked firmware
# image supplies a strong replacement.  Ordinary boot code sees only hal_*.

extern fn rt_rv32_boot_optional_nvme_fw_selftest() -> i64

fn hal_rv32_boot_optional_nvme_fw_selftest() -> i64:
    rt_rv32_boot_optional_nvme_fw_selftest()
