# Scalar RV32 direct-M-mode memory layout policy.

val RV32_BOOT_PAGE_SIZE: u64 = 4096

fn rv32_direct_ram_base() -> u64: 0x80000000
fn rv32_direct_ram_size() -> u64: 128 * 1024 * 1024
fn rv32_direct_reserved_end() -> u64: 0x80400000
fn rv32_direct_heap_start() -> u64: 0x87000000
fn rv32_direct_heap_size() -> u64: 16 * 1024 * 1024

fn rv32_boot_layout_valid(ram_base: u64, ram_size: u64, reserved_end: u64, heap_start: u64, heap_size: u64) -> bool:
    if ram_size <= RV32_BOOT_PAGE_SIZE:
        return false
    if reserved_end <= ram_base:
        return false
    if heap_start <= reserved_end:
        return false
    if heap_size < 8:
        return false
    if ram_size > 0xFFFFFFFFFFFFFFFF - ram_base:
        return false
    if heap_size > 0xFFFFFFFFFFFFFFFF - heap_start:
        return false

    val ram_end = ram_base + ram_size
    val heap_end = heap_start + heap_size
    if heap_end > ram_end:
        return false

    val alloc_base = ((reserved_end + RV32_BOOT_PAGE_SIZE - 1) / RV32_BOOT_PAGE_SIZE) * RV32_BOOT_PAGE_SIZE
    alloc_base < heap_start

fn rv32_boot_layout_total_pages(ram_base: u64, ram_size: u64, reserved_end: u64, heap_start: u64, heap_size: u64) -> u64:
    if not rv32_boot_layout_valid(ram_base, ram_size, reserved_end, heap_start, heap_size):
        return 0
    val alloc_base = ((reserved_end + RV32_BOOT_PAGE_SIZE - 1) / RV32_BOOT_PAGE_SIZE) * RV32_BOOT_PAGE_SIZE
    (heap_start - alloc_base) / RV32_BOOT_PAGE_SIZE
