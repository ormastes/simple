# riscv32 freestanding core runtime — pure Simple.
#
# riscv32 has no C freestanding runtime (riscv64 gets these from
# src/os/kernel/arch/riscv64/boot/freestanding_runtime.c). This module provides
# the core symbols the riscv32 kernel link needs:
#   rt_alloc rt_pool_safepoint rt_string_new_literal rt_string_concat
#   rt_value_to_string rt_raw_i64_to_string rt_array_get rt_array_set_text
#   rt_index_set rt_value_u64 rt_typed_words_{u32,u64}_{at,set}
#
# ABI: RuntimeValue is a 64-bit word on every arch (PR #10816; codegen/llvm/
# backend_core.rs runtime_int_type is i64), so `i64` below is a true 64-bit value.
# 64-bit slots are two aligned 32-bit probe accesses (low word first).
#
# Layout matches the rv32 boot C that is linked into this image
# (examples/09_embedded/simple_os/arch/riscv32/boot/baremetal_stubs.c and
# arch/common/riscv_common.h serial_println / rt_native_eq):
#   string: {u32 type=1, u32 size, u32 len, data[len], NUL}   (data at +12)
#   array:  {u32 type=2, u32 size, u32 len, u32 cap, u32 data_ptr}, 8-byte items at data_ptr
#   values: int = v << 3, heap = ptr | 1, nil = 3, true = 11, false = 19.
# Typed-words arrays hold 8-byte words like every array. Assumption: no array
# producer (rt_array_new) is linked on riscv32 yet; the array layout above is
# the contract a future producer must follow (until then every array ref
# fails the kind check and reads return nil/0, writes return false).
#
# Heap: bump allocator over the rv32 direct-heap policy window
# (boot_layout.spl rv32_direct_heap_start/size = 0x87000000 + 16 MiB, the same
# region the riscv64 freestanding rt_alloc uses). It lies inside the linker
# `.heap` section, so riscv_plausible_heap_ref accepts strings allocated here.
# The bump state is an offset (BSS-zeroed; module initializers do not run
# freestanding) so no 0x8xxxxxxx address is ever ordered with a signed compare.
#
# Memory access goes through the rv32 boot probes already linked into the
# image (rt_rv32_probe_load8 / rt_rv32_probe_store32): no inline asm.
# Bodies must not use text literals, f-strings, arrays or untyped compares —
# those lower to the very rt_* symbols defined here (or to rt_native_cmp).

use os.kernel.arch.riscv32.core_runtime_layout.{
    rv32_rt_align8, rv32_rt_normalize_index, rv32_rt_heap_fits, rv32_rt_byte_merge,
    rv32_rt_ram_ref, rv32_rt_decimal_len, rv32_rt_decimal_digit,
    rv32_rt_clamp, rv32_rt_byte_index_ok, rv32_rt_digit_value
}

@cfg(riscv32)
extern fn rt_rv32_probe_load8(addr: i64) -> i64
@cfg(riscv32)
extern fn rt_rv32_probe_store32(addr: i64, value: i64) -> i64

@cfg(riscv32)
var _rv32_rt_heap_used: i64 = 0

# ---------------------------------------------------------------------------
# Raw memory over the boot probes.
# ---------------------------------------------------------------------------

@cfg(riscv32)
fn _rv32_ld8(addr: i64) -> i64:
    rt_rv32_probe_load8(addr) & 255

@cfg(riscv32)
fn _rv32_ld32(addr: i64) -> i64:
    _rv32_ld8(addr) | (_rv32_ld8(addr + 1) << 8) | (_rv32_ld8(addr + 2) << 16) | (_rv32_ld8(addr + 3) << 24)

@cfg(riscv32)
fn _rv32_st32(addr: i64, value: i64):
    """`addr` must be 4-byte aligned."""
    rt_rv32_probe_store32(addr, value)

@cfg(riscv32)
fn _rv32_ld64(addr: i64) -> i64:
    """Little-endian 64-bit load; `addr` must be 4-byte aligned."""
    _rv32_ld32(addr) | (_rv32_ld32(addr + 4) << 32)

@cfg(riscv32)
fn _rv32_st64(addr: i64, value: i64):
    """64-bit store as two aligned 32-bit probe stores, low word first."""
    _rv32_st32(addr, value & 0xFFFFFFFF)
    _rv32_st32(addr + 4, (value >> 32) & 0xFFFFFFFF)

@cfg(riscv32)
fn _rv32_st8(addr: i64, byte: i64):
    val word_addr: i64 = addr & -4
    _rv32_st32(word_addr, rv32_rt_byte_merge(_rv32_ld32(word_addr), addr & 3, byte))

# ---------------------------------------------------------------------------
# Object helpers.
# ---------------------------------------------------------------------------

@cfg(riscv32)
fn _rv32_heap_obj(value: i64, kind: i64) -> i64:
    """Untagged object pointer when `value` is a heap ref of `kind`, else 0."""
    if (value & 7) != 1:
        return 0
    val ptr: i64 = value & -8
    if rv32_rt_ram_ref(ptr) == 0:
        return 0
    if _rv32_ld32(ptr) != kind:
        return 0
    ptr

@cfg(riscv32)
fn _rv32_str_alloc(len: i64) -> i64:
    """Allocate a string object with header and NUL set; data left to the caller."""
    val total: i64 = 12 + len + 1
    val ptr: i64 = _rv32_alloc(total)
    if ptr == 0:
        return 0
    _rv32_st32(ptr, 1)
    _rv32_st32(ptr + 4, total)
    _rv32_st32(ptr + 8, len)
    ptr

@cfg(riscv32)
fn _rv32_str_small(len: i64, word0: i64, word1: i64) -> i64:
    """String of up to 8 bytes given as little-endian words (no text literals)."""
    val ptr: i64 = _rv32_str_alloc(len)
    if ptr == 0:
        return 3
    _rv32_st32(ptr + 12, word0)
    if len > 4:
        _rv32_st32(ptr + 16, word1)
    _rv32_st8(ptr + 12 + len, 0)
    ptr | 1

@cfg(riscv32)
fn _rv32_decimal(value: i64) -> i64:
    val n: i64 = rv32_rt_decimal_len(value)
    val ptr: i64 = _rv32_str_alloc(n)
    if ptr == 0:
        return 3
    var digits: i64 = n
    if value < 0:
        _rv32_st8(ptr + 12, 45)
        digits = n - 1
    var pos: i64 = 0
    while pos < digits:
        _rv32_st8(ptr + 12 + n - 1 - pos, 48 + rv32_rt_decimal_digit(value, pos))
        pos = pos + 1
    _rv32_st8(ptr + 12 + n, 0)
    ptr | 1

@cfg(riscv32)
fn _rv32_array_slot(array: i64, index: i64) -> i64:
    """Element address for `array[index]`, or 0 when not an array / out of bounds."""
    val obj: i64 = _rv32_heap_obj(array, 2)
    if obj == 0:
        return 0
    val idx: i64 = rv32_rt_normalize_index(index, _rv32_ld32(obj + 8))
    if idx < 0:
        return 0
    _rv32_ld32(obj + 16) + idx * 8

@cfg(riscv32)
fn _rv32_array_set(array: i64, index: i64, value: i64) -> i64:
    """1 when stored, 0 when not an array / out of bounds."""
    val slot: i64 = _rv32_array_slot(array, index)
    if slot == 0:
        return 0
    _rv32_st64(slot, value)
    1

@cfg(riscv32)
fn _rv32_words_at(array: i64, index: i64) -> i64:
    val slot: i64 = _rv32_array_slot(array, index)
    if slot == 0:
        return 0
    _rv32_ld64(slot)

@cfg(riscv32)
fn _rv32_to_string(value: i64) -> i64:
    if _rv32_heap_obj(value, 1) != 0:
        return value
    if (value & 7) == 0:
        return _rv32_decimal(value >> 3)
    if value == 11:
        return _rv32_str_small(4, 0x65757274, 0)          # "true"
    if value == 19:
        return _rv32_str_small(5, 0x736C6166, 0x65)       # "false"
    if value == 3:
        return _rv32_str_small(3, 0x6C696E, 0)            # "nil"
    _rv32_str_small(7, 0x6C61763C, 0x3E6575)              # "<value>"

@cfg(riscv32)
fn _rv32_alloc(size: i64) -> i64:
    if size <= 0:
        return 0
    val bytes: i64 = rv32_rt_align8(size)
    if rv32_rt_heap_fits(_rv32_rt_heap_used, bytes, 0x01000000) == 0:
        return 0
    val ptr: i64 = 0x87000000 + _rv32_rt_heap_used
    _rv32_rt_heap_used = _rv32_rt_heap_used + bytes
    ptr

# ---------------------------------------------------------------------------
# Exported core runtime. Exports never call each other: a call to an rt_*
# name is typed ANY by MIR lowering, and an ANY result flowing into `-> bool`
# lowers through rt_value_truthy (mir/lower/lowering_core.rs), which riscv32
# does not define. They all delegate to the private _rv32_* helpers above.
# ---------------------------------------------------------------------------

@cfg(riscv32)
@no_mangle
fn rt_alloc(size: i64) -> i64:
    _rv32_alloc(size)

@cfg(riscv32)
@no_mangle
fn rt_pool_safepoint() -> i64:
    0

@cfg(riscv32)
@no_mangle
fn rt_string_new_literal(bytes: i64, len: i64) -> i64:
    var n: i64 = len
    if n < 0:
        n = 0
    val ptr: i64 = _rv32_str_alloc(n)
    if ptr == 0:
        return 3
    var i: i64 = 0
    while i < n:
        _rv32_st8(ptr + 12 + i, _rv32_ld8(bytes + i))
        i = i + 1
    _rv32_st8(ptr + 12 + n, 0)
    ptr | 1

@cfg(riscv32)
@no_mangle
fn rt_value_to_string(value: i64) -> i64:
    _rv32_to_string(value)

@cfg(riscv32)
@no_mangle
fn rt_raw_i64_to_string(raw: i64) -> i64:
    _rv32_decimal(raw)

@cfg(riscv32)
@no_mangle
fn rt_string_concat(left: i64, right: i64) -> i64:
    val a: i64 = _rv32_heap_obj(_rv32_to_string(left), 1)
    val b: i64 = _rv32_heap_obj(_rv32_to_string(right), 1)
    if a == 0:
        return 3
    if b == 0:
        return 3
    var la: i64 = _rv32_ld32(a + 8)
    var lb: i64 = _rv32_ld32(b + 8)
    if la < 0:
        la = 0
    if lb < 0:
        lb = 0
    val ptr: i64 = _rv32_str_alloc(la + lb)
    if ptr == 0:
        return 3
    var i: i64 = 0
    while i < la:
        _rv32_st8(ptr + 12 + i, _rv32_ld8(a + 12 + i))
        i = i + 1
    i = 0
    while i < lb:
        _rv32_st8(ptr + 12 + la + i, _rv32_ld8(b + 12 + i))
        i = i + 1
    _rv32_st8(ptr + 12 + la + lb, 0)
    ptr | 1

@cfg(riscv32)
@no_mangle
fn rt_array_get(array: i64, index: i64) -> i64:
    val slot: i64 = _rv32_array_slot(array, index)
    if slot == 0:
        return 3
    _rv32_ld64(slot)

@cfg(riscv32)
@no_mangle
fn rt_array_set_text(array: i64, index: i64, value: i64) -> bool:
    if _rv32_array_set(array, index, value) == 0:
        return false
    true

@cfg(riscv32)
@no_mangle
fn rt_index_set(collection: i64, index: i64, value: i64) -> bool:
    """Index arrives as a RuntimeValue: only an int-tagged index is accepted."""
    if (index & 7) != 0:
        return false
    if _rv32_array_set(collection, index >> 3, value) == 0:
        return false
    true

@cfg(riscv32)
@no_mangle
fn rt_value_u64(bits: i64) -> i64:
    # Known limit: rv32 has no boxed-u64 heap kind, so this is a tag-int and
    # keeps only the low 61 bits (values >= 2^61 are truncated).
    bits << 3

@cfg(riscv32)
@no_mangle
fn rt_typed_words_u32_at(array: i64, index: i64) -> i64:
    _rv32_words_at(array, index)

@cfg(riscv32)
@no_mangle
fn rt_typed_words_u64_at(array: i64, index: i64) -> i64:
    _rv32_words_at(array, index)

@cfg(riscv32)
@no_mangle
fn rt_typed_words_u32_set(array: i64, index: i64, value: i64) -> bool:
    if _rv32_array_set(array, index, value) == 0:
        return false
    true

@cfg(riscv32)
@no_mangle
fn rt_typed_words_u64_set(array: i64, index: i64, value: i64) -> bool:
    if _rv32_array_set(array, index, value) == 0:
        return false
    true

# ---------------------------------------------------------------------------
# Text / any core symbols reached by the riscv32 UART log path
# (console_common riscv_uart_write: msg.len(), msg.char_at(i), `ch as u8`).
# Semantics follow the hosted runtime (src/runtime/runtime_native.c):
# raw lengths/bytes/ints out, tagged string handles in.
# ---------------------------------------------------------------------------

@cfg(riscv32)
fn _rv32_str_copy(src: i64, begin: i64, count: i64) -> i64:
    """New string of `count` bytes copied from string object `src` at `begin`."""
    val ptr: i64 = _rv32_str_alloc(count)
    if ptr == 0:
        return 3
    var i: i64 = 0
    while i < count:
        _rv32_st8(ptr + 12 + i, _rv32_ld8(src + 12 + begin + i))
        i = i + 1
    _rv32_st8(ptr + 12 + count, 0)
    ptr | 1

@cfg(riscv32)
@no_mangle
fn rt_string_len(value: i64) -> i64:
    val s: i64 = _rv32_heap_obj(value, 1)
    if s == 0:
        return 0
    _rv32_ld32(s + 8)

@cfg(riscv32)
@no_mangle
fn rt_string_byte_at(value: i64, index: i64) -> i64:
    val s: i64 = _rv32_heap_obj(value, 1)
    if s == 0:
        return 0
    if rv32_rt_byte_index_ok(index, _rv32_ld32(s + 8)) == 0:
        return 0
    _rv32_ld8(s + 12 + index)

@cfg(riscv32)
@no_mangle
fn rt_slice_text_bytes(value: i64, start: i64, end: i64, step: i64) -> i64:
    """Byte slice [start, end) clamped to the string; step != 1 -> empty.
    Non-string receivers answer nil (hosted falls back to the generic
    rt_slice, which riscv32 does not provide)."""
    val s: i64 = _rv32_heap_obj(value, 1)
    if s == 0:
        return 3
    if step < 1:
        return 3
    val finish: i64 = rv32_rt_clamp(end, 0, _rv32_ld32(s + 8))
    val begin: i64 = rv32_rt_clamp(start, 0, finish)
    if step != 1:
        return _rv32_str_copy(s, 0, 0)
    _rv32_str_copy(s, begin, finish - begin)

@cfg(riscv32)
@no_mangle
fn rt_any_to_int(value: i64) -> i64:
    """Tag-int -> its value; true/false -> 1/0; string -> leading decimal (optional '-', stops at
    the first non-digit, like strtoll); anything else -> 0."""
    if (value & 7) == 0:
        return value >> 3
    if value == 11:
        return 1
    if value == 19:
        return 0
    val s: i64 = _rv32_heap_obj(value, 1)
    if s == 0:
        return 0
    val len: i64 = _rv32_ld32(s + 8)
    var i: i64 = 0
    var neg: i64 = 0
    if len > 0:
        if _rv32_ld8(s + 12) == 45:
            neg = 1
            i = 1
    var acc: i64 = 0
    while i < len:
        val d: i64 = rv32_rt_digit_value(_rv32_ld8(s + 12 + i))
        if d < 0:
            i = len
        else:
            acc = acc * 10 - d
            i = i + 1
    # Accumulated in the negative domain so i32 min needs no negation.
    if neg == 1:
        return acc
    0 - acc
