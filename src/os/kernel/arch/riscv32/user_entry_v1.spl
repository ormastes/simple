# RV32 U-mode sret state contract.
#
# Immutable return-state preparation and the task-bound live U-mode handoff.

use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.types.syscall_types.{SyscallArgs}
use os.kernel.arch.riscv32.trap_runtime_v1.{
    riscv32_trap_runtime_bind_task_v1,
    riscv32_trap_runtime_dispatch_v1,
    riscv32_trap_runtime_release_task_v1
}
use os.kernel.types.task_types.{TaskContext}
use os.kernel.types.riscv32_mapping_handle_v1.{
    scheduler_riscv32_mapping_handle_present_v1
}
use os.kernel.arch.riscv32.cpu.{
    csrr_satp, csrw_satp, sfence_vma_all, csrr_sstatus
}
use os.kernel.arch.riscv32.paging.{vmm_switch_address_space}
use os.kernel.scheduler.process_execution_observation.{
    SchedulerExecutionObservationHandleV1,
    scheduler_execution_observation_handle_for_child_v1,
    scheduler_execution_observe_stdout_byte_for_handle_v1
}
use os.kernel.arch.riscv.console_common.{
    RISCV_VIRT_UART_BASE, riscv_uart_write_byte
}
use os.kernel.log.klog_api.{log_raw_println}

val RISCV32_SSTATUS_SIE_V1: u32 = 1u32 << 1
val RISCV32_SSTATUS_SPIE_V1: u32 = 1u32 << 5
val RISCV32_SSTATUS_SPP_V1: u32 = 1u32 << 8
val RISCV32_USER_LIMIT_V1: u64 = 0x0000000080000000u64
var _rv32_live_observation_child_v1: u64 = 0u64
var _rv32_live_observation_handle_v1: SchedulerExecutionObservationHandleV1? = nil

pub struct Riscv32UserSretStateV1:
    sepc: u32
    sp: u32
    sstatus: u32

pub fn riscv32_user_sret_state_v1(
    entry_point: u64,
    user_sp: u64,
    inherited_sstatus: u32
) -> Riscv32UserSretStateV1?:
    """Prepare an RV32 U-mode return frame without granting execution."""
    if (entry_point == 0u64 or entry_point >= RISCV32_USER_LIMIT_V1 or
        entry_point % 2u64 != 0u64 or
        user_sp == 0u64 or user_sp >= RISCV32_USER_LIMIT_V1 or
        user_sp % 16u64 != 0u64):
        return nil
    # sret selects U-mode only when SPP is clear.  SIE must stay clear while
    # still in S-mode; SPIE enables interrupts after the privilege transition.
    val status = (inherited_sstatus &
        (~(RISCV32_SSTATUS_SPP_V1 | RISCV32_SSTATUS_SIE_V1))) |
        RISCV32_SSTATUS_SPIE_V1
    Some(Riscv32UserSretStateV1(
        sepc: entry_point as u32,
        sp: user_sp as u32,
        sstatus: status))

fn rv32_user_debug_write_v1(byte: u32) -> i32:
    val value = (byte & 0xFFu32) as u8
    if _rv32_live_observation_handle_v1.?:
        _ = scheduler_execution_observe_stdout_byte_for_handle_v1(
            _rv32_live_observation_handle_v1.unwrap(), value)
    riscv_uart_write_byte(RISCV_VIRT_UART_BASE, value)
    0

fn rv32_user_syscall_v1(
    id: u32,
    arg0: u32,
    arg1: u32,
    arg2: u32,
    arg3: u32,
    arg4: u32,
    arg5: u32
) -> i32:
    """Dispatch the bounded RV32 filesystem execution ABI through its owner.

    The live bundle is installed only after the scheduler has selected the
    authenticated task and its Sv32 root is active.  The whitelist keeps this
    bootstrap entry from accidentally exposing the wider kernel ABI before a
    full RV32 interrupt frame owns blocking and rescheduling dispositions.
    """
    val supported = (
        id == 4u32 or id == 10u32 or id == 15u32 or
        id == 30u32 or id == 31u32 or id == 32u32 or id == 33u32 or
        id == 116u32)
    if not supported:
        return -38
    val args = SyscallArgs(
        id: id as u64,
        arg0: arg0 as u64,
        arg1: arg1 as u64,
        arg2: arg2 as u64,
        arg3: arg3 as u64,
        arg4: arg4 as u64,
        arg5: arg5 as u64)
    riscv32_trap_runtime_dispatch_v1(args) as i32

@section(".text.trap")
@naked
fn _rv32_enter_user_v1(entry: u32, user_sp: u32, user_sstatus: u32) -> i64:
    """Enter RV32 U-mode and return only through its bounded syscall trap."""
    asm volatile:
        ".option push"
        ".option norvc"
        "addi sp, sp, -80"
        "sw ra, 0(sp)"
        "sw s0, 4(sp)"
        "sw s1, 8(sp)"
        "sw s2, 12(sp)"
        "sw s3, 16(sp)"
        "sw s4, 20(sp)"
        "sw s5, 24(sp)"
        "sw s6, 28(sp)"
        "sw s7, 32(sp)"
        "sw s8, 36(sp)"
        "sw s9, 40(sp)"
        "sw s10, 44(sp)"
        "sw s11, 48(sp)"
        "csrr t0, stvec"
        "sw t0, 52(sp)"
        "csrr t0, sscratch"
        "sw t0, 56(sp)"
        "csrr t0, sie"
        "sw t0, 60(sp)"
        "csrr t0, sstatus"
        "sw t0, 64(sp)"
        "sw gp, 68(sp)"
        "sw tp, 72(sp)"
        # Keep the bounded entry trap non-preemptible until a full RV32
        # scheduler interrupt frame owns nested interrupt delivery.
        "csrw sie, zero"
        "la t0, .Lrv32_user_trap_v1"
        "csrw stvec, t0"
        "csrw sscratch, sp"
        "csrw sepc, a0"
        "csrw sstatus, a2"
        "mv sp, a1"
        "li a0, 0"
        "sret"

        ".Lrv32_user_trap_v1:"
        "csrr t0, scause"
        "li t1, 8"
        "bne t0, t1, .Lrv32_user_fault_v1"
        "beqz a7, .Lrv32_user_exit_v1"
        "li t1, 60"
        "beq a7, t1, .Lrv32_user_debug_v1"
        "j .Lrv32_user_syscall_v1"

        ".Lrv32_user_syscall_v1:"
        "csrrw sp, sscratch, sp"
        "addi sp, sp, -64"
        "sw ra, 0(sp)"
        "sw a0, 4(sp)"
        "sw a1, 8(sp)"
        "sw a2, 12(sp)"
        "sw a3, 16(sp)"
        "sw a4, 20(sp)"
        "sw a5, 24(sp)"
        "sw a6, 28(sp)"
        "sw a7, 32(sp)"
        "sw gp, 36(sp)"
        "sw tp, 40(sp)"
        "lw gp, 132(sp)"
        "lw tp, 136(sp)"
        "mv a0, a7"
        "lw a1, 4(sp)"
        "lw a2, 8(sp)"
        "lw a3, 12(sp)"
        "lw a4, 16(sp)"
        "lw a5, 20(sp)"
        "lw a6, 24(sp)"
        "call rv32_user_syscall_v1"
        "lw ra, 0(sp)"
        "lw a1, 8(sp)"
        "lw a2, 12(sp)"
        "lw a3, 16(sp)"
        "lw a4, 20(sp)"
        "lw a5, 24(sp)"
        "lw a6, 28(sp)"
        "lw a7, 32(sp)"
        "lw gp, 36(sp)"
        "lw tp, 40(sp)"
        "addi sp, sp, 64"
        "csrrw sp, sscratch, sp"
        "j .Lrv32_user_resume_v1"

        ".Lrv32_user_debug_v1:"
        "csrrw sp, sscratch, sp"
        "addi sp, sp, -48"
        "sw ra, 0(sp)"
        "sw a1, 4(sp)"
        "sw a2, 8(sp)"
        "sw a3, 12(sp)"
        "sw a4, 16(sp)"
        "sw a5, 20(sp)"
        "sw a6, 24(sp)"
        "sw a7, 28(sp)"
        "sw gp, 32(sp)"
        "sw tp, 36(sp)"
        "lw gp, 116(sp)"
        "lw tp, 120(sp)"
        "call rv32_user_debug_write_v1"
        "lw ra, 0(sp)"
        "lw a1, 4(sp)"
        "lw a2, 8(sp)"
        "lw a3, 12(sp)"
        "lw a4, 16(sp)"
        "lw a5, 20(sp)"
        "lw a6, 24(sp)"
        "lw a7, 28(sp)"
        "lw gp, 32(sp)"
        "lw tp, 36(sp)"
        "addi sp, sp, 48"
        "csrrw sp, sscratch, sp"

        ".Lrv32_user_resume_v1:"
        "csrr t0, sepc"
        "addi t0, t0, 4"
        "csrw sepc, t0"
        "sret"

        ".Lrv32_user_fault_v1:"
        "li a0, -14"
        ".Lrv32_user_exit_v1:"
        "mv t6, a0"
        "csrrw sp, sscratch, sp"
        "lw t0, 52(sp)"
        "csrw stvec, t0"
        "lw t0, 56(sp)"
        "csrw sscratch, t0"
        "lw t0, 60(sp)"
        "csrw sie, t0"
        "lw t5, 64(sp)"
        "lw gp, 68(sp)"
        "lw tp, 72(sp)"
        "lw ra, 0(sp)"
        "lw s0, 4(sp)"
        "lw s1, 8(sp)"
        "lw s2, 12(sp)"
        "lw s3, 16(sp)"
        "lw s4, 20(sp)"
        "lw s5, 24(sp)"
        "lw s6, 28(sp)"
        "lw s7, 32(sp)"
        "lw s8, 36(sp)"
        "lw s9, 40(sp)"
        "lw s10, 44(sp)"
        "lw s11, 48(sp)"
        "addi sp, sp, 80"
        "mv a0, t6"
        "csrw sstatus, t5"
        "ret"
        ".option pop"

pub fn dispatch_enter_user_blocking_v1(
    pid_hint: u64,
    scheduler: Scheduler
) -> i64:
    """Validate one exact retained Sv32 task and execute its U-mode frame."""
    var owner = scheduler
    val tcb = owner.get_user_handoff_task(pid_hint)
    if not tcb.?: return -22
    val task = tcb.unwrap()
    if (not task.is_user or not task.user_context.? or
        task.id.id != pid_hint or task.address_space == 0u64 or
        task.address_space % 4096u64 != 0u64 or
        not scheduler_riscv32_mapping_handle_present_v1(
            task.riscv32_mapping_handle)):
        return -22
    val context: TaskContext = task.user_context.unwrap()
    val state = riscv32_user_sret_state_v1(
        context.rip, context.rsp, csrr_sstatus())
    if not state.?: return -14
    if (_rv32_live_observation_child_v1 != 0u64 or
        _rv32_live_observation_handle_v1.?):
        return -16
    owner.schedule()
    if owner.get_current() != task.id:
        log_raw_println(
            "[rv32-user] scheduler selected wrong task expected={task.id.id}")
        return -16
    val kernel_satp = csrr_satp()
    val observation = scheduler_execution_observation_handle_for_child_v1(
        task.id.id)
    if observation == nil: return -13
    _rv32_live_observation_child_v1 = task.id.id
    _rv32_live_observation_handle_v1 = observation
    if not riscv32_trap_runtime_bind_task_v1(
        owner, task.id, task.capabilities):
        _rv32_live_observation_child_v1 = 0u64
        _rv32_live_observation_handle_v1 = nil
        return -16
    vmm_switch_address_space(task.address_space)
    var exit_code: i64 = -14
    unsafe:
        val prepared = state.unwrap()
        exit_code = _rv32_enter_user_v1(
            prepared.sepc, prepared.sp, prepared.sstatus)
    csrw_satp(kernel_satp)
    sfence_vma_all()
    if not riscv32_trap_runtime_release_task_v1(task.id):
        exit_code = -5
    _rv32_live_observation_child_v1 = 0u64
    _rv32_live_observation_handle_v1 = nil
    exit_code

export Riscv32UserSretStateV1
export riscv32_user_sret_state_v1
export dispatch_enter_user_blocking_v1
