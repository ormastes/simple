# RV32IMAC privilege-transition ABI v1.
#
# This is a layout/constant contract only.  It does not install stvec, enter
# U-mode, or implement a trap dispatcher.  Assembly must consume these offsets
# rather than reconstructing them.

# Semantic version 1.2 encoded as major << 16 | minor.
val RV32_PRIVILEGE_ABI_VERSION: u32 = 0x00010002
val RV32_TRAP_FRAME_ALIGNMENT: u32 = 16
val RV32_TRAP_FRAME_SIZE: u32 = 160
val RV32_TRAP_GPR_BYTES: u32 = 124
val RV32_PRIVILEGE_ISA_PROFILE: text = "rv32imac_zicsr"
val RV32_PRIVILEGE_CALL_ABI: text = "ilp32"

val RV32_TRAP_RA_OFFSET: u32 = 0
val RV32_TRAP_SP_OFFSET: u32 = 4
val RV32_TRAP_GP_OFFSET: u32 = 8
val RV32_TRAP_TP_OFFSET: u32 = 12
val RV32_TRAP_A0_OFFSET: u32 = 36
val RV32_TRAP_A1_OFFSET: u32 = 40
val RV32_TRAP_A7_OFFSET: u32 = 64
val RV32_TRAP_SEPC_OFFSET: u32 = 124
val RV32_TRAP_SSTATUS_OFFSET: u32 = 128
val RV32_TRAP_SCAUSE_OFFSET: u32 = 132
val RV32_TRAP_STVAL_OFFSET: u32 = 136
val RV32_TRAP_SUPERVISOR_SP_OFFSET: u32 = 140
val RV32_TRAP_INTERRUPTED_SATP_OFFSET: u32 = 144
val RV32_TRAP_RESERVED_OFFSET: u32 = 148

# Future capability profile only. It is not selectable until F/D admission and
# an ILP32D privileged object exist. Its version and layout cannot alias v1.
val RV32_IMAFD_PRIVILEGE_ABI_VERSION: u32 = 2
val RV32_IMAFD_TRAP_FRAME_SIZE: u32 = 416
val RV32_IMAFD_TRAP_FP_OFFSET: u32 = 144
val RV32_IMAFD_TRAP_FCSR_OFFSET: u32 = 400
val RV32_IMAFD_ISA_PROFILE: text = "rv32imafd_zicsr"
val RV32_IMAFD_CALL_ABI: text = "ilp32d"

val RV32_SSTATUS_SPP: u32 = 1 << 8
val RV32_SSTATUS_SPIE: u32 = 1 << 5
val RV32_SSTATUS_FS_MASK: u32 = 3 << 13
val RV32_SCAUSE_USER_ECALL: u32 = 8
val RV32_STVEC_MODE_DIRECT: u32 = 0
val RV32_SATP_MODE_SV32: u32 = 1 << 31
val RV32_SATP_ASID_SHIFT: u32 = 22
val RV32_SATP_ASID_MASK: u32 = 0x1ff
val RV32_SATP_PPN_MASK: u32 = 0x003fffff
val RV32_SYSCALL_DEBUG_WRITE: u32 = 60
val RV32_SYSCALL_EXIT: u32 = 0
val RV32_REQUIRED_EXIT_CODE: u32 = 37

@repr("C")
struct Rv32PrivilegeTrapFrameV1:
    # x1..x31 in architectural order. x0 is never stored.
    gpr_x1_to_x31: [u32; 31]
    sepc: u32
    sstatus: u32
    scause: u32
    stval: u32
    supervisor_stack_top: u32
    interrupted_satp: u32
    reserved_zero: [u32; 3]

enum Rv32ExecutionTokenStateV1:
    Prepared
    Entered
    Exited
    Reaped

val RV32_TRAP_ANCHOR_ALIGNMENT: u32 = 16
val RV32_TRAP_ANCHOR_SIZE: u32 = 16
val RV32_TRAP_ANCHOR_STACK_TOP_OFFSET: u32 = 0
val RV32_TRAP_ANCHOR_TOKEN_OFFSET: u32 = 4
val RV32_TRAP_ANCHOR_HART_ID_OFFSET: u32 = 8
val RV32_TRAP_ANCHOR_NESTING_OFFSET: u32 = 12
val RV32_TRAP_ANCHOR_NESTING_IDLE: u32 = 0
val RV32_TRAP_ANCHOR_NESTING_USER_TRAP: u32 = 1

val RV32_TOKEN_MAC_DOMAIN: text = "SOSIX-RV32-TOK1"
val RV32_TOKEN_MAC_DOMAIN_BYTES: u32 = 16
val RV32_TOKEN_MAC_KEY_BYTES: u32 = 16
val RV32_TOKEN_MAC_INPUT_BYTES: u32 = 80
val RV32_TOKEN_MAC_ALGORITHM: text = "SipHash-2-4"
val RV32_TOKEN_MAC_KAT_EMPTY: u64 = 0x726fdb47dd0e0e31

# Fixed RV32 C ABI. ILP32 returns the u64 result in a0/a1.
extern fn rt_rv32_token_siphash24(
    key_address: u32, message_address: u32, message_len: u32
) -> u64

@repr("C")
struct Rv32TrapAnchorV1:
    supervisor_stack_top: u32
    token_address: u32
    hart_id: u32
    nesting: u32

@repr("C")
struct Rv32ExecutionTokenV1:
    # IDs/generations are kernel-issued and nonzero. User memory never owns this.
    task_id: u64
    task_generation: u64
    address_space_generation: u64
    root_phys: u64
    nonce_token: u64
    expected_satp: u32
    asid: u16
    reserved_zero: u16
    supervisor_stack_bottom: u32
    supervisor_stack_top: u32
    hart_id: u32
    # Kernel-keyed authentication tag over all immutable binding fields,
    # including hart_id. Zero is never a valid published tag.
    auth_tag: u64
    state: Rv32ExecutionTokenStateV1

@repr("C")
struct Rv32SupervisorContinuationV1:
    task_id: u64
    task_generation: u64
    address_space_generation: u64
    nonce_token: u64
    expected_user_satp: u32
    kernel_satp: u32
    kernel_sp: u32
    trap_frame_address: u32

enum Rv32TrapDispatchActionV1:
    ReturnToUser
    ResumeSupervisor
    RejectAndTerminate

# Assembly boundary: the dispatcher commits all owner state before returning
# exactly one scalar disposition in a0. Aggregate/enum layout never crosses it.
val RV32_TRAP_DISPOSITION_RETURN_USER: i32 = 0
val RV32_TRAP_DISPOSITION_RESUME_SUPERVISOR: i32 = 1
val RV32_TRAP_DISPOSITION_REJECT: i32 = -1

@repr("C")
struct Rv32TrapDispatchRequestV1:
    frame_address: u32
    token_address: u32
    observed_satp: u32
    observed_privilege: u32

@repr("C")
struct Rv32TrapDispatchResultV1:
    action: Rv32TrapDispatchActionV1
    status: i32

val RV32_TRAP_VECTOR_SYMBOL: text = "_rv32_trap_vector"
val RV32_TRAP_DISPATCH_SYMBOL: text = "rv32_dispatch_user_trap_scalar_v12"

export Rv32PrivilegeTrapFrameV1, Rv32ExecutionTokenV1, Rv32TrapAnchorV1
export Rv32ExecutionTokenStateV1, Rv32SupervisorContinuationV1
export Rv32TrapDispatchRequestV1, Rv32TrapDispatchResultV1
export Rv32TrapDispatchActionV1
