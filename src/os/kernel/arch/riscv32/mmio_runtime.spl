# riscv32 byte MMIO runtime — pure Simple with inline asm.
#
# rt_volatile_read_u8 / rt_volatile_write_u8 back the 16550 UART helpers
# (os.kernel.boot.mmio_hardware externs) on riscv32, which has no C runtime.
# A single lbu/sb is architecturally irreplaceable here: emulating a byte store
# with an aligned word read-modify-write would also read and rewrite the
# neighbouring UART registers (THR/IER/FCR side effects).
#
# Parenthesized operand form only: the indented-block asm form drops
# operands silently (see commit 0dc7ea0ae48). Volatile blocks get a memory
# clobber from lowering. Args/returns are raw (i64 is an i32 carrier on rv32).

@cfg(riscv32)
@export
fn rt_volatile_read_u8(addr: i64) -> i64:
    var value: i64 = 0
    unsafe(capabilities: [inline_asm]):
        asm volatile("lbu {v}, 0({a})", v = out(reg) value, a = in(reg) addr)
    value

@cfg(riscv32)
@export
fn rt_volatile_write_u8(addr: i64, value: i64):
    unsafe(capabilities: [inline_asm]):
        asm volatile("sb {v}, 0({a})", v = in(reg) value, a = in(reg) addr)
