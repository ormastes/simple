# riscv32 64-bit integer division builtins (pure Simple, no libgcc).
# The LLVM backend lowers i64 `/` and `%` on rv32 to __divdi3 / __moddi3. These
# use shift-subtract only, so lowering them cannot recurse into themselves
# (i64 shifts, compares and add/sub expand inline on rv32).
# Semantics match compiler-rt: truncating division, remainder takes the
# dividend's sign, division by zero yields 0 (no trap on a freestanding kernel).
# Exports never call each other; both delegate to rv32_sdivmod64.

# want_rem == 0 -> quotient, otherwise remainder, of n / d (signed, truncating).
fn rv32_sdivmod64(n: i64, d: i64, want_rem: i64) -> i64:
    if d == 0:
        return 0
    var un: u64 = n as u64
    if n < 0:
        un = (0 - n) as u64
    var ud: u64 = d as u64
    if d < 0:
        ud = (0 - d) as u64
    var q: u64 = 0
    var r: u64 = 0
    var i: i64 = 63
    while i >= 0:
        r = (r << 1) | ((un >> i) & 1)
        if r >= ud:
            r = r - ud
            q = q | ((1 as u64) << i)
        i = i - 1
    var out: i64 = q as i64
    var neg: i64 = 0
    if want_rem != 0:
        out = r as i64
        if n < 0:
            neg = 1
    else:
        if (n < 0) != (d < 0):
            neg = 1
    if neg != 0:
        return 0 - out
    out

@cfg(riscv32)
@export("C")
fn __divdi3(n: i64, d: i64) -> i64:
    rv32_sdivmod64(n, d, 0)

@cfg(riscv32)
@export("C")
fn __moddi3(n: i64, d: i64) -> i64:
    rv32_sdivmod64(n, d, 1)
