# Persistent RV32 trap runtime for authenticated filesystem-launched tasks.

use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.log.klog.{KernelLog}
use os.kernel.types.task_types.{TaskId}
use os.kernel.types.capability_types.{CapabilitySet}
use os.kernel.types.syscall_types.{SyscallArgs}
use os.kernel.ipc.syscall.{syscall_handler_ipc_state}

# These owners are allocated once for the RV32 kernel image.  A filesystem
# launch binds an authenticated scheduler task and its exact capability pouch;
# syscall state is then adopted after every dispatch rather than reconstructed
# for each entry or discarded at the value-semantics boundary.
var _rv32_runtime_scheduler_v1: Scheduler = Scheduler.new_bootstrap()
var _rv32_runtime_ipc_v1: IpcManager = IpcManager.new()
var _rv32_runtime_klog_v1: KernelLog = KernelLog.new(256u64)
var _rv32_runtime_task_v1: u64 = 0u64

pub fn riscv32_trap_runtime_bind_task_v1(
    scheduler: Scheduler, task: TaskId, caps: CapabilitySet
) -> bool:
    if task.id == 0u64 or _rv32_runtime_task_v1 != 0u64:
        return false
    var ipc = _rv32_runtime_ipc_v1
    ipc.cap_manager.init_task(task, caps)
    _rv32_runtime_scheduler_v1 = scheduler
    _rv32_runtime_ipc_v1 = ipc
    _rv32_runtime_task_v1 = task.id
    true

pub fn riscv32_trap_runtime_dispatch_v1(args: SyscallArgs) -> i64:
    if _rv32_runtime_task_v1 == 0u64:
        return -38
    var scheduler = _rv32_runtime_scheduler_v1
    if scheduler.get_current().id != _rv32_runtime_task_v1:
        return -1
    val state = syscall_handler_ipc_state(
        args, scheduler, _rv32_runtime_ipc_v1, _rv32_runtime_klog_v1)
    _rv32_runtime_scheduler_v1 = state.scheduler
    _rv32_runtime_ipc_v1 = state.ipc
    state.result.value

pub fn riscv32_trap_runtime_release_task_v1(task: TaskId) -> bool:
    if task.id == 0u64 or task.id != _rv32_runtime_task_v1:
        return false
    var ipc = _rv32_runtime_ipc_v1
    ipc.cap_manager.destroy_task(task)
    _rv32_runtime_ipc_v1 = ipc
    _rv32_runtime_task_v1 = 0u64
    true

export riscv32_trap_runtime_bind_task_v1
export riscv32_trap_runtime_dispatch_v1
export riscv32_trap_runtime_release_task_v1
