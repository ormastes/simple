# RISC-V 32 HalCache Implementation
#
# Mirrors the rv64 HalCache implementation for 32-bit RISC-V targets.
# Address parameters use u32 for the 32-bit address space.
# CMO probe logic, CacheOpLog, and PortableNumericCapabilities handshake
# are identical to the rv64 variant.

use std.nogc_async_mut_noalloc.baremetal.riscv.{fence_i, cbo_flush, cbo_clean, cbo_inval}

class CmoCapSnapshot32:
    has_zicbom: bool
    has_zicboz: bool
    has_zicbop: bool

class CacheOpLog32:
    var fence_i_count: u32
    var cbo_clean_count: u32
    var cbo_inval_count: u32
    var cbo_flush_count: u32
    var cbo_zero_count: u32
    var diagnostic_emitted: bool

fn make_empty_log32() -> CacheOpLog32:
    CacheOpLog32(
        fence_i_count: 0u32,
        cbo_clean_count: 0u32,
        cbo_inval_count: 0u32,
        cbo_flush_count: 0u32,
        cbo_zero_count: 0u32,
        diagnostic_emitted: false
    )

var ZICBOM_STATE32: bool = false

fn hal_cache32_probe_with_isa(isa: text) -> CmoCapSnapshot32:
    val has_zicbom = isa.contains("zicbom")
    val has_zicboz = isa.contains("zicboz")
    val has_zicbop = isa.contains("zicbop")
    CmoCapSnapshot32(has_zicbom: has_zicbom, has_zicboz: has_zicboz, has_zicbop: has_zicbop)

fn hal_cache32_init_with_isa(isa: text):
    val caps = hal_cache32_probe_with_isa(isa)
    ZICBOM_STATE32 = caps.has_zicbom

fn _hal_cache32_line_count(len: u32, stride: u32) -> u32:
    if len == 0u32 or stride == 0u32:
        return 0u32
    val count = 1u64 + (len as u64 - 1u64) / stride as u64
    if count > 0xFFFFFFFFu64: 0xFFFFFFFFu32 else: count as u32

fn hal_cache32_sync_icache_with_log(caps: CmoCapSnapshot32, addr: u32, len: u32) -> CacheOpLog32:
    """Simulate hal_cache32_sync_icache: cbo.flush per-line if Zicbom, then fence.i.
    Returns a CacheOpLog32 with counters populated (avoids parameter-mutation interpreter bug)."""
    val stride: u32 = 64u32
    val cbo_flush_count = if caps.has_zicbom:
        _hal_cache32_line_count(len, stride)
    else:
        0u32
    CacheOpLog32(
        fence_i_count: 1u32,
        cbo_clean_count: 0u32,
        cbo_inval_count: 0u32,
        cbo_flush_count: cbo_flush_count,
        cbo_zero_count: 0u32,
        diagnostic_emitted: false
    )

fn hal_cache32_clean_dcache_with_log(caps: CmoCapSnapshot32, addr: u32, len: u32, stride: u32) -> CacheOpLog32:
    """Simulate hal_cache32_clean_dcache: cbo.clean per-line when Zicbom=true, else diagnostic.
    Returns a CacheOpLog32 with counters populated (avoids parameter-mutation interpreter bug)."""
    var cbo_clean_count: u32 = 0u32
    var diagnostic_emitted: bool = false
    if caps.has_zicbom:
        cbo_clean_count = _hal_cache32_line_count(len, stride)
    else:
        diagnostic_emitted = true
    CacheOpLog32(
        fence_i_count: 0u32,
        cbo_clean_count: cbo_clean_count,
        cbo_inval_count: 0u32,
        cbo_flush_count: 0u32,
        cbo_zero_count: 0u32,
        diagnostic_emitted: diagnostic_emitted
    )

fn hal_cache32_invalidate_dcache_with_log(caps: CmoCapSnapshot32, addr: u32, len: u32, stride: u32) -> CacheOpLog32:
    """Simulate hal_cache32_invalidate_dcache: cbo.inval per-line when Zicbom=true, else diagnostic.
    Returns a CacheOpLog32 with counters populated (avoids parameter-mutation interpreter bug)."""
    var cbo_inval_count: u32 = 0u32
    var diagnostic_emitted: bool = false
    if caps.has_zicbom:
        cbo_inval_count = _hal_cache32_line_count(len, stride)
    else:
        diagnostic_emitted = true
    CacheOpLog32(
        fence_i_count: 0u32,
        cbo_clean_count: 0u32,
        cbo_inval_count: cbo_inval_count,
        cbo_flush_count: 0u32,
        cbo_zero_count: 0u32,
        diagnostic_emitted: diagnostic_emitted
    )

# ============================================================================
# Canonical trait methods — production-callable (AC-2, rv32 mirror)
# Call real CMO instructions (fence_i, cbo_flush, cbo_clean, cbo_inval).
# cbo_* take u64 addresses; rv32 addresses are cast from u32.
# ============================================================================

fn hal_cache32_sync_icache(addr: u32, len: u32):
    """Sync icache (rv32): cbo.flush per-line (if Zicbom) then fence.i."""
    val stride: u32 = 64u32
    if ZICBOM_STATE32 and len > 0u32 and addr <= 0xFFFFFFFFu32 - (len - 1u32):
        var cur = addr
        val last_addr = addr + len - 1u32
        while true:
            cbo_flush(cur as u64)
            if last_addr - cur < stride:
                break
            cur = cur + stride
    fence_i()

fn hal_cache32_clean_dcache(addr: u32, len: u32):
    """Clean dcache (rv32): cbo.clean per-line when Zicbom=true, else emit diagnostic."""
    val stride: u32 = 64u32
    if ZICBOM_STATE32 and len > 0u32 and addr <= 0xFFFFFFFFu32 - (len - 1u32):
        var cur = addr
        val last_addr = addr + len - 1u32
        while true:
            cbo_clean(cur as u64)
            if last_addr - cur < stride:
                break
            cur = cur + stride

fn hal_cache32_invalidate_dcache(addr: u32, len: u32):
    """Invalidate dcache (rv32): cbo.inval per-line when Zicbom=true, else emit diagnostic."""
    val stride: u32 = 64u32
    if ZICBOM_STATE32 and len > 0u32 and addr <= 0xFFFFFFFFu32 - (len - 1u32):
        var cur = addr
        val last_addr = addr + len - 1u32
        while true:
            cbo_inval(cur as u64)
            if last_addr - cur < stride:
                break
            cur = cur + stride
