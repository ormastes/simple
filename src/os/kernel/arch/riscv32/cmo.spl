# RV32 instruction leaves. Register operands are exactly XLEN (u32); no
# rt_riscv64_* provider, foreign ABI, dynamic dispatch or allocation is used.
# Cache policy/range iteration belongs to hal_cache.spl. Callers must admit
# Zifencei/Zicbom/Zicboz/Zicbop as appropriate before executing these leaves.
# Assembler .option directives enable encoding, never runtime capability.
# Interpreter execution skips inline assembly and is NOT hardware evidence.

fn fence_i():
    """Synchronise instruction fetch using the admitted Zifencei extension."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("fence.i")

fn cbo_clean(addr: u32):
    """Clean one cache block; requires admitted Zicbom."""
    unsafe(capabilities: [inline_asm]):
        asm volatile(".option push\n.option arch,+zicbom\ncbo.clean 0({a})\n.option pop", a = in(reg) addr)

fn cbo_inval(addr: u32):
    """Invalidate one cache block; requires admitted Zicbom."""
    unsafe(capabilities: [inline_asm]):
        asm volatile(".option push\n.option arch,+zicbom\ncbo.inval 0({a})\n.option pop", a = in(reg) addr)

fn cbo_flush(addr: u32):
    """Clean and invalidate one cache block; requires admitted Zicbom."""
    unsafe(capabilities: [inline_asm]):
        asm volatile(".option push\n.option arch,+zicbom\ncbo.flush 0({a})\n.option pop", a = in(reg) addr)

fn cbo_zero(addr: u32):
    """Zero one cache block; requires admitted Zicboz."""
    unsafe(capabilities: [inline_asm]):
        asm volatile(".option push\n.option arch,+zicboz\ncbo.zero 0({a})\n.option pop", a = in(reg) addr)

fn prefetch_r(addr: u32):
    """Read prefetch hint; requires admitted Zicbop."""
    unsafe(capabilities: [inline_asm]):
        asm volatile(".option push\n.option arch,+zicbop\nprefetch.r 0({a})\n.option pop", a = in(reg) addr)

fn prefetch_w(addr: u32):
    """Write prefetch hint; requires admitted Zicbop."""
    unsafe(capabilities: [inline_asm]):
        asm volatile(".option push\n.option arch,+zicbop\nprefetch.w 0({a})\n.option pop", a = in(reg) addr)

fn prefetch_i(addr: u32):
    """Instruction prefetch hint; requires admitted Zicbop."""
    unsafe(capabilities: [inline_asm]):
        asm volatile(".option push\n.option arch,+zicbop\nprefetch.i 0({a})\n.option pop", a = in(reg) addr)

export fence_i, cbo_clean, cbo_inval, cbo_flush, cbo_zero
export prefetch_r, prefetch_w, prefetch_i
