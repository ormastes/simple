# Pure-Simple policy for the RV32 boot-time hart census.
#
# This scalar decision is shared by QEMU and FPGA boot.  The linker-owned
# counter load remains isolated in smp_provider.spl.

@inline
pub fn hal_rv32_smp_should_wait(
    online_harts: u32,
    spins: u32,
    expected_harts: u32,
    spin_limit: u32
) -> bool:
    if online_harts < expected_harts and spins < spin_limit:
        return true
    false
