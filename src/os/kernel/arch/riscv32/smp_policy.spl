# Pure-Simple policy for the RV32 boot-time hart census.
#
# This module contains only scalar, host-executable policy.  The hardware
# boundary that reads the linker-owned counter lives in smp_provider.spl.

@inline
fn hal_rv32_smp_should_wait(
    online_harts: u32,
    spins: u32,
    expected_harts: u32,
    spin_limit: u32,
) -> bool:
    if online_harts < expected_harts and spins < spin_limit:
        return true
    false
