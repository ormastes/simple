# RISC-V 64 HalSmp Implementation
#
# Implements the HalSmp trait for RISC-V 64-bit targets:
#   hal_smp_cpu_count()  -> u32              — hart count from DTB (via dtb_scan)
#   hal_smp_cpu_start()  -> bool             — start AP hart via SBI HSM
#   hal_smp_ipi_send()                       — send software IPI via sbi_probe_then_send_ipi
#   hal_smp_ipi_broadcast()                  — broadcast IPI to all non-self harts
#
# State:
#   MAX_HARTS          — compile-time upper bound on hart count
#   ApBootArgs         — per-AP boot argument record (stack + opaque arg)
#   HAL_SMP_PENDING_IPI[MAX_HARTS]  — per-hart pending IPI vector (global array)
#   HAL_SMP_BOOT_ARGS[MAX_HARTS]    — per-AP boot args populated before SBI call
#
# Test seams:
#   hal_smp_init_from_dtb_info(info)        — production parsed-DTB handoff
#   hal_smp_init_with_null_dtb()            — force cpu_count = 1
#   hal_smp_init_from_bytes(fdt: [u8])      — init from sentinel FDT blob
#   hal_smp_cpu_start_with_mock(mock, ...)  — cpu_start via mock SBI
#   hal_smp_ipi_send_with_mock(mock, ...)   — ipi_send via mock SBI
#   hal_smp_ipi_broadcast_with_mock(mock, ...)
#   hal_smp_get_boot_args(ap_id)            — read ApBootArgs slot
#   hal_smp_get_pending_ipi(target)         — read PENDING_IPI slot

use os.kernel.arch.riscv64.sbi.{sbi_hart_start, SBI_SUCCESS}
use os.kernel.boot.dtb_parser.{DtbDeviceInfo}
use std.nogc_async_mut_noalloc.baremetal.riscv.sbi.{sbi_probe_then_send_ipi}
use os.kernel.boot.riscv_noalloc_dtb_capability.{riscv_noalloc_dtb_logical_valid, riscv_noalloc_dtb_hart_id}

# ============================================================================
# Constants
# ============================================================================

val MAX_HARTS: u32 = 8u32

# ============================================================================
# ApBootArgs — stores stack + opaque arg for each AP before SBI hart_start
# ============================================================================

class ApBootArgs:
    stack: u64
    arg: u64

# ============================================================================
# Module-level state
# ============================================================================

var HAL_SMP_CPU_COUNT_STATE: u32 = 1u32
var HAL_SMP_PENDING_IPI: [u32] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32]
var HAL_SMP_BOOT_ARGS: [ApBootArgs] = [
    ApBootArgs(stack: 0u64, arg: 0u64),
    ApBootArgs(stack: 0u64, arg: 0u64),
    ApBootArgs(stack: 0u64, arg: 0u64),
    ApBootArgs(stack: 0u64, arg: 0u64),
    ApBootArgs(stack: 0u64, arg: 0u64),
    ApBootArgs(stack: 0u64, arg: 0u64),
    ApBootArgs(stack: 0u64, arg: 0u64),
    ApBootArgs(stack: 0u64, arg: 0u64)
]

# Pending hart count — set by make_fdt_with_cpus_smp before the blob is handed
# to hal_smp_init_from_bytes.
var HAL_SMP_PENDING_COUNT: u32 = 1u32

# ============================================================================
# Init helpers
# ============================================================================

fn hal_smp_init_with_null_dtb():
    """Initialise HalSmp with no DTB (fallback: 1 hart)."""
    HAL_SMP_CPU_COUNT_STATE = 1u32

fn hal_smp_init_from_dtb_info(info: DtbDeviceInfo):
    """Initialize the bounded SMP topology from parsed production DTB data."""
    if not info.valid or info.hart_count == 0u32:
        HAL_SMP_CPU_COUNT_STATE = 1u32
    else if info.hart_count > MAX_HARTS:
        HAL_SMP_CPU_COUNT_STATE = MAX_HARTS
    else:
        HAL_SMP_CPU_COUNT_STATE = info.hart_count

fn hal_smp_init_from_bytes(fdt: [u8]):
    """Initialise HalSmp from a sentinel FDT blob; commits HAL_SMP_PENDING_COUNT."""
    if fdt.len() < 4u32:
        HAL_SMP_CPU_COUNT_STATE = 1u32
        return
    val b0 = fdt[0u32]
    val b1 = fdt[1u32]
    val b2 = fdt[2u32]
    val b3 = fdt[3u32]
    if b0 != 0xD0u8 or b1 != 0x0Du8 or b2 != 0xFEu8 or b3 != 0xEDu8:
        HAL_SMP_CPU_COUNT_STATE = 1u32
        return
    HAL_SMP_CPU_COUNT_STATE = HAL_SMP_PENDING_COUNT

fn hal_smp_set_pending_count(count: u32):
    """Set pending hart count; called by FDT blob builders before make blob."""
    HAL_SMP_PENDING_COUNT = count

# ============================================================================
# Core HalSmp methods
# ============================================================================

fn hal_smp_cpu_count() -> u32:
    """Return cached CPU count from last hal_smp_init_from_bytes call."""
    HAL_SMP_CPU_COUNT_STATE

fn hal_smp_get_boot_args(ap_id: u32) -> ApBootArgs:
    """Return the ApBootArgs stored for ap_id."""
    HAL_SMP_BOOT_ARGS[ap_id]

fn hal_smp_get_pending_ipi(target: u32) -> u32:
    """Return the pending IPI vector for target hart."""
    HAL_SMP_PENDING_IPI[target]

fn hal_smp_ipi_window(hart_id: u64) -> (u64, u64):
    """SBI IPI addressing for a physical hart: (hart_mask, hart_mask_base).

    One SBI mask word covers 64 harts, so sparse hart IDs above 63 land in the
    window whose base is the hart ID rounded down to a multiple of 64.
    """
    val base = (hart_id / 64u64) * 64u64
    (1u64 << (hart_id - base), base)

fn hal_smp_hsm_target(logical: u32) -> (bool, u64):
    """Physical hart ID the SBI HSM start call must target for a logical hart.

    Returns (false, 0) when the DTB capability has no such logical hart, so the
    caller can keep the logical-equals-physical fallback.
    """
    if not riscv_noalloc_dtb_logical_valid(logical):
        return (false, 0u64)
    (true, riscv_noalloc_dtb_hart_id(logical))

# ============================================================================
# Mock SBI carrier for test seams
# ============================================================================

class SbiMockSmp:
    var probe_ext_results: [(u64, bool)]
    var ipi_calls: [(u64, u64)]
    var hart_start_calls: [(u64, u64, u64)]

fn sbi_mock_ipi_probe_path(mock: SbiMockSmp) -> text:
    """Determine IPI path from mock probe results."""
    var v3 = false
    for entry in mock.probe_ext_results:
        if entry.0 == 0x735049u64:
            v3 = entry.1
    if v3:
        "V3"
    else:
        "Clint"

fn hal_smp_cpu_start_with_mock(mock: SbiMockSmp, ap_id: u32, entry: u64, stack: u64, arg: u64) -> bool:
    """Simulate hal_smp_cpu_start using mock SBI."""
    if ap_id < MAX_HARTS:
        HAL_SMP_BOOT_ARGS[ap_id] = ApBootArgs(stack: stack, arg: arg)
    mock.hart_start_calls.push((ap_id as u64, entry, stack))
    val path = sbi_mock_ipi_probe_path(mock)
    if path == "V3":
        true
    else:
        false

fn hal_smp_ipi_send_with_mock(mock: SbiMockSmp, target: u32, vector: u32):
    """Simulate hal_smp_ipi_send: write vector to PENDING_IPI[target] and record call."""
    if target < MAX_HARTS:
        HAL_SMP_PENDING_IPI[target] = vector
    val hart_mask = 1u64 << target as u64
    mock.ipi_calls.push((target as u64, hart_mask))

fn hal_smp_ipi_broadcast_with_mock(mock: SbiMockSmp, vector: u32):
    """Simulate hal_smp_ipi_broadcast: send IPI to all harts except self (hart 0)."""
    val self_id = 0u32
    var i: u32 = 0u32
    val count = HAL_SMP_CPU_COUNT_STATE
    while i < count:
        if i != self_id:
            hal_smp_ipi_send_with_mock(mock, i, vector)
        i = i + 1u32

# ============================================================================
# Canonical trait methods — production-callable (AC-1)
# ============================================================================

fn hal_smp_cpu_start(ap_id: u32, entry: u64, stack: u64, arg: u64) -> bool:
    """Start AP hart via SBI HSM. Populates boot args slot before calling SBI."""
    if ap_id < MAX_HARTS:
        HAL_SMP_BOOT_ARGS[ap_id] = ApBootArgs(stack: stack, arg: arg)
    val target = hal_smp_hsm_target(ap_id)
    val hart = if target.0: target.1 else: ap_id as u64
    val ret = sbi_hart_start(hart, entry, ap_id as u64)
    ret.error == SBI_SUCCESS

fn hal_smp_ipi_send(target: u32, vector: u32):
    """Send IPI to target hart: write vector to PENDING_IPI slot then call sbi_probe_then_send_ipi."""
    if target < MAX_HARTS:
        HAL_SMP_PENDING_IPI[target] = vector
    val phys = hal_smp_hsm_target(target)
    val hart = if phys.0: phys.1 else: target as u64
    val window = hal_smp_ipi_window(hart)
    sbi_probe_then_send_ipi(window.0, window.1)

fn hal_smp_ipi_window_mask(harts: [u64; 8], count: u32, base: u64) -> u64:
    """SBI hart_mask for the 64-hart window starting at base, over harts[0..count)."""
    var mask: u64 = 0u64
    var i: u32 = 0u32
    while i < count:
        val window = hal_smp_ipi_window(harts[i])
        if window.1 == base: mask = mask | window.0
        i = i + 1u32
    mask

fn hal_smp_ipi_broadcast(vector: u32):
    """Broadcast IPI to all non-self harts (self = logical 0), one SBI call per 64-hart window.

    Uses the same physical-hart window addressing as hal_smp_ipi_send, so sparse
    DTB hart IDs (including IDs above 63) are targeted correctly.
    """
    val self_id = 0u32
    val count = HAL_SMP_CPU_COUNT_STATE
    var phys: [u64; 8] = [0u64; 8]
    var n: u32 = 0u32
    var i: u32 = 0u32
    while i < count and n < MAX_HARTS:
        if i != self_id:
            HAL_SMP_PENDING_IPI[i] = vector
            val target = hal_smp_hsm_target(i)
            phys[n] = if target.0: target.1 else: i as u64
            n = n + 1u32
        i = i + 1u32
    var k: u32 = 0u32
    while k < n:
        val base = hal_smp_ipi_window(phys[k]).1
        var seen = false
        var j: u32 = 0u32
        while j < k:
            if hal_smp_ipi_window(phys[j]).1 == base: seen = true
            j = j + 1u32
        if not seen:
            sbi_probe_then_send_ipi(hal_smp_ipi_window_mask(phys, n, base), base)
        k = k + 1u32
