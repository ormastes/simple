# RV64 freestanding byte-order, checksum, and VirtIO identity policy.
#
# The historical C callers keep raw buffers, MMIO, virtqueue state, and device
# lifecycle ownership. This module owns deterministic byte transforms,
# checksum folding, and PCI identity decisions. Raw byte access crosses the
# canonical typed HAL volatile owner; no pointer, device, or allocation state
# is retained here.
#
# Keep every `# @decision` marker immediately above its instrumented branch.
# The migration gate binds these 17 named production decisions to compiler
# coverage rows and requires both outcomes for every row.

use std.hal.types.{MmioAddress, RegisterWidth}
use std.hal.volatile.{mmio_read_u8, mmio_write_u8}

val RV64_VIRTIO_VENDOR_ID: i64 = 0x1af4
val RV64_VIRTIO_NET_LEGACY_DEVICE_ID: i64 = 0x1000
val RV64_VIRTIO_NET_MODERN_DEVICE_ID: i64 = 0x1041
val RV64_VIRTIO_BLK_LEGACY_DEVICE_ID: i64 = 0x1001
val RV64_VIRTIO_BLK_MODERN_DEVICE_ID: i64 = 0x1042
val RV64_VIRTIO_GPU_LEGACY_DEVICE_ID: i64 = 0x1010
val RV64_VIRTIO_GPU_MODERN_DEVICE_ID: i64 = 0x1050
val RV64_VIRTIO_INPUT_LEGACY_DEVICE_ID: i64 = 0x1012
val RV64_VIRTIO_INPUT_MODERN_DEVICE_ID: i64 = 0x1052

fn _rv64_read_byte(addr: u64) -> u8:
    val byte_addr = MmioAddress(base: addr as i64, offset: 0, width: RegisterWidth.Width8)
    (mmio_read_u8(byte_addr) & 0xff) as u8

fn _rv64_write_byte(addr: u64, value: u8):
    val byte_addr = MmioAddress(base: addr as i64, offset: 0, width: RegisterWidth.Width8)
    mmio_write_u8(byte_addr, value as i64)

fn rv64_be16_from_bytes(b0: u8, b1: u8) -> u16:
    ((b0 as u16) << 8) | (b1 as u16)

fn rv64_be32_from_bytes(b0: u8, b1: u8, b2: u8, b3: u8) -> u32:
    ((b0 as u32) << 24) |
        ((b1 as u32) << 16) |
        ((b2 as u32) << 8) |
        (b3 as u32)

@export("C", name: "rt_be16")
fn rv64_read_be16(addr: u64) -> u16:
    rv64_be16_from_bytes(_rv64_read_byte(addr), _rv64_read_byte(addr + 1))

@export("C", name: "rt_be32")
fn rv64_read_be32(addr: u64) -> u32:
    rv64_be32_from_bytes(
        _rv64_read_byte(addr),
        _rv64_read_byte(addr + 1),
        _rv64_read_byte(addr + 2),
        _rv64_read_byte(addr + 3)
    )

@export("C", name: "rt_put_be16")
fn rv64_write_be16(addr: u64, value: u16):
    _rv64_write_byte(addr, (value >> 8) as u8)
    _rv64_write_byte(addr + 1, value as u8)

@export("C", name: "rt_put_be32")
fn rv64_write_be32(addr: u64, value: u32):
    _rv64_write_byte(addr, (value >> 24) as u8)
    _rv64_write_byte(addr + 1, (value >> 16) as u8)
    _rv64_write_byte(addr + 2, (value >> 8) as u8)
    _rv64_write_byte(addr + 3, value as u8)

@export("C", name: "rt_checksum_add")
fn rv64_checksum_add(initial: u32, addr: u64, len: u64) -> u32:
    var sum = initial
    var i: u64 = 0
    # @decision checksum_pair_loop
    while i + 1 < len:
        val word = (((_rv64_read_byte(addr + i)) as u32) << 8) |
            ((_rv64_read_byte(addr + i + 1)) as u32)
        sum = sum + word
        i = i + 2
    # @decision checksum_trailing_byte
    if i < len:
        sum = sum + (((_rv64_read_byte(addr + i)) as u32) << 8)
    sum

@export("C", name: "rt_checksum_finish")
fn rv64_checksum_finish(initial: u32) -> u16:
    var sum = initial
    # @decision checksum_fold_loop
    while (sum >> 16) > 0:
        sum = (sum & 0xffff) + (sum >> 16)
    (~sum) as u16

@export("C", name: "rt_pci_is_virtio_net")
fn rv64_pci_is_virtio_net(cls: i64, sub: i64, vendor: i64, device_id: i64) -> i64:
    # @decision virtio_net_class
    if cls != 2:
        return 0
    # @decision virtio_net_subclass
    if sub != 0:
        return 0
    # @decision virtio_net_vendor
    if vendor != RV64_VIRTIO_VENDOR_ID:
        return 0
    # @decision virtio_net_legacy_device
    if device_id == RV64_VIRTIO_NET_LEGACY_DEVICE_ID:
        return 1
    # @decision virtio_net_modern_device
    if device_id == RV64_VIRTIO_NET_MODERN_DEVICE_ID:
        return 1
    0

@export("C", name: "rt_pci_is_virtio_gpu")
fn rv64_pci_is_virtio_gpu(cls: i64, sub: i64, vendor: i64, device_id: i64) -> i64:
    # @decision virtio_gpu_vendor
    if vendor != RV64_VIRTIO_VENDOR_ID:
        return 0
    # @decision virtio_gpu_legacy_device
    if device_id == RV64_VIRTIO_GPU_LEGACY_DEVICE_ID:
        return 1
    # @decision virtio_gpu_modern_device
    if device_id == RV64_VIRTIO_GPU_MODERN_DEVICE_ID:
        # The modern historical path deliberately accepts any class/subclass.
        return 1
    0

@export("C", name: "rt_pci_is_virtio_blk")
fn rv64_pci_is_virtio_blk(vendor: i64, device_id: i64) -> i64:
    # @decision virtio_blk_vendor
    if vendor != RV64_VIRTIO_VENDOR_ID:
        return 0
    # @decision virtio_blk_legacy_device
    if device_id == RV64_VIRTIO_BLK_LEGACY_DEVICE_ID:
        return 1
    # @decision virtio_blk_modern_device
    if device_id == RV64_VIRTIO_BLK_MODERN_DEVICE_ID:
        return 1
    0

@export("C", name: "rt_pci_is_virtio_input")
fn rv64_pci_is_virtio_input(vendor: i64, device_id: i64) -> i64:
    # @decision virtio_input_vendor
    if vendor != RV64_VIRTIO_VENDOR_ID:
        return 0
    # @decision virtio_input_legacy_device
    if device_id == RV64_VIRTIO_INPUT_LEGACY_DEVICE_ID:
        return 1
    # @decision virtio_input_modern_device
    if device_id == RV64_VIRTIO_INPUT_MODERN_DEVICE_ID:
        return 1
    0

@export("C", name: "rt_put_le32")
fn rv64_write_le32(addr: u64, value: u32):
    _rv64_write_byte(addr, value as u8)
    _rv64_write_byte(addr + 1, (value >> 8) as u8)
    _rv64_write_byte(addr + 2, (value >> 16) as u8)
    _rv64_write_byte(addr + 3, (value >> 24) as u8)

@export("C", name: "rt_put_le64")
fn rv64_write_le64(addr: u64, value: u64):
    _rv64_write_byte(addr, value as u8)
    _rv64_write_byte(addr + 1, (value >> 8) as u8)
    _rv64_write_byte(addr + 2, (value >> 16) as u8)
    _rv64_write_byte(addr + 3, (value >> 24) as u8)
    _rv64_write_byte(addr + 4, (value >> 32) as u8)
    _rv64_write_byte(addr + 5, (value >> 40) as u8)
    _rv64_write_byte(addr + 6, (value >> 48) as u8)
    _rv64_write_byte(addr + 7, (value >> 56) as u8)

@export("C", name: "rt_get_le32")
fn rv64_read_le32(addr: u64) -> u32:
    ((_rv64_read_byte(addr)) as u32) |
        (((_rv64_read_byte(addr + 1)) as u32) << 8) |
        (((_rv64_read_byte(addr + 2)) as u32) << 16) |
        (((_rv64_read_byte(addr + 3)) as u32) << 24)

fn rv64_freestanding_policy_link_anchor() -> bool:
    true
