# StarFive VisionFive 2 deterministic immutable packaged root.

use std.fs_driver.types.{DirEntry, Inode}
use os.kernel.arch.riscv64.starfive.vfs.{starfive_vfs_mount_root, g_vfs_readdir}

fn _starfive_packaged_entries() -> [DirEntry]:
    [
        DirEntry(name: "bin", inode: Inode(id: 2), is_dir: true, size: 0),
        DirEntry(name: "etc", inode: Inode(id: 3), is_dir: true, size: 0),
        DirEntry(name: "README.txt", inode: Inode(id: 4), is_dir: false, size: 38)
    ]

fn starfive_mount_packaged_root() -> Result<text, text>:
    val mount_r = starfive_vfs_mount_root(_starfive_packaged_entries())
    if mount_r.is_err():
        return Err(mount_r.unwrap_err())
    val entries = g_vfs_readdir("/")
    var has_bin = false
    var has_etc = false
    var has_readme = false
    for entry in entries:
        if entry.name == "bin":
            has_bin = true
        if entry.name == "etc":
            has_etc = true
        if entry.name == "README.txt":
            has_readme = true
    if not has_bin or not has_etc or not has_readme:
        return Err("starfive-root: public VFS listing incomplete")
    Ok("bin,etc,README.txt")

export starfive_mount_packaged_root
