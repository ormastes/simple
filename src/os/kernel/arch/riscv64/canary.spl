# RISC-V 64 stack canary HAL surface.
#
# Only the entropy source below is arch-specific; the state machine lives
# in os.kernel.arch.common.canary_state.

use os.kernel.arch.riscv64.entropy.{entropy_seed_u64}
use os.kernel.arch.common.canary_state.{canary_set, canary_raw, canary_fail_common}

fn canary_init(seed: u64):
    canary_set(seed, entropy_seed_u64())

fn canary_value() -> u64:
    if canary_raw() == 0:
        canary_init(0)
    canary_raw()

fn canary_fail() -> i32:
    canary_fail_common()
