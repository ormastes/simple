# RV64 noalloc PMM ABI facade.
#
# Stateful validation/allocation policy is pure Simple in
# os.kernel.boot.riscv_noalloc_pmm. This module preserves the historical
# freestanding-runtime symbols and boot UART markers. C-facing predicates use
# an exact signed 64-bit 0/1 ABI; native Simple bool layout is not part of this
# interface. The only foreign call is the unavoidable byte-wide UART bridge
# owned by freestanding_runtime.c.

use os.kernel.boot.riscv_noalloc_pmm.{
    riscv_noalloc_pmm_init,
    riscv_noalloc_alloc_page,
    riscv_noalloc_pmm_is_ready,
    riscv_noalloc_pmm_free_pages,
    riscv_noalloc_pmm_total_pages
}

val RV64_QEMU_RAM_BASE: u64 = 0x80000000
val RV64_QEMU_RAM_SIZE: u64 = 128 * 1024 * 1024
val RV64_QEMU_RESERVED_END: u64 = 0x80400000
val RV64_QEMU_HEAP_START: u64 = 0x87000000
val RV64_QEMU_HEAP_SIZE: u64 = 16 * 1024 * 1024

# Plain `extern fn` rather than @extern("runtime", "rt_riscv_uart_put"): the
# seed's native backend does not honour that attribute -- it emitted the SIMPLE
# name `_riscv_uart_put_raw` as an undefined reference instead of the C name,
# so the rv64 WM kernel failed to link. The plain form is the one proven to
# work in this same link (every extern in display.spl resolves).
extern fn rt_riscv_uart_put(byte: u64)

fn _uart_put(byte: u64):
    rt_riscv_uart_put(byte)

fn _crlf():
    _uart_put(13)
    _uart_put(10)

fn _line_pmm_ok():
    _uart_put(80)
    _uart_put(77)
    _uart_put(77)
    _uart_put(32)
    _uart_put(79)
    _uart_put(75)
    _crlf()

fn _line_pmm_fail():
    _uart_put(80)
    _uart_put(77)
    _uart_put(77)
    _uart_put(32)
    _uart_put(70)
    _uart_put(65)
    _uart_put(73)
    _uart_put(76)
    _crlf()

fn _c_bool(value: bool) -> i64:
    if value: 1
    else: 0

@export("C", name: "rt_riscv_noalloc_pmm_init")
fn rv64_noalloc_pmm_initialize(ram_base: u64, ram_size: u64, reserved_end: u64, heap_start: u64) -> i64:
    val ready = riscv_noalloc_pmm_init(ram_base, ram_size, reserved_end, heap_start)
    if ready:
        _line_pmm_ok()
    else:
        _line_pmm_fail()
    _c_bool(ready)

@export("C", name: "rt_riscv_noalloc_pmm_init_default")
fn rv64_noalloc_pmm_initialize_default() -> i64:
    rv64_noalloc_pmm_initialize(
        RV64_QEMU_RAM_BASE,
        RV64_QEMU_RAM_SIZE,
        RV64_QEMU_RESERVED_END,
        RV64_QEMU_HEAP_START
    )

# Named `spl_`-prefixed rather than carrying @export("C", name: ...): the seed's
# native backend silently emits NO C alias for that attribute (measured: zero
# rt_riscv_* symbols in this module's object despite ten such annotations), so
# the C boot code could never reach this page allocator. A `spl_` prefix is a
# documented keep-the-ABI-name convention in the seed's mangler
# (native_project/mangle.rs), so this symbol is emitted unmangled and the
# freestanding VirtIO-GPU backend can call it -- while PMM policy stays owned
# by Simple, which is the whole point of routing the allocation through here.
fn spl_riscv_noalloc_alloc_page() -> u64:
    riscv_noalloc_alloc_page()

@export("C", name: "rt_riscv_noalloc_pmm_is_ready")
fn rv64_noalloc_pmm_ready_abi() -> i64:
    _c_bool(riscv_noalloc_pmm_is_ready())

@export("C", name: "rt_riscv_noalloc_pmm_free_pages")
fn rv64_noalloc_pmm_free_page_count() -> u64:
    riscv_noalloc_pmm_free_pages()

@export("C", name: "rt_riscv_noalloc_pmm_total_pages")
fn rv64_noalloc_pmm_total_page_count() -> u64:
    riscv_noalloc_pmm_total_pages()

@export("C", name: "rt_riscv_qemu_ram_base")
fn rv64_qemu_ram_base() -> u64:
    RV64_QEMU_RAM_BASE

@export("C", name: "rt_riscv_qemu_ram_size")
fn rv64_qemu_ram_size() -> u64:
    RV64_QEMU_RAM_SIZE

@export("C", name: "rt_riscv_qemu_reserved_end")
fn rv64_qemu_reserved_end() -> u64:
    RV64_QEMU_RESERVED_END

@export("C", name: "rt_riscv_qemu_heap_start")
fn rv64_qemu_heap_start() -> u64:
    RV64_QEMU_HEAP_START

@export("C", name: "rt_riscv_qemu_heap_size")
fn rv64_qemu_heap_size() -> u64:
    RV64_QEMU_HEAP_SIZE
