# RV64 architecture-local source for compiler-filesystem fw_cfg metadata.
#
# This module owns only the four bounded hardware reads.  Interpretation and
# cross-field validation belong to os.port.init.compiler_filesystem_metadata_v2.

use os.kernel.arch.riscv64.fw_cfg_named_file_v1.{
    riscv64_qemu_fw_cfg_read_named_file_v1,
}
use os.kernel.fw_cfg.read_result_v1.{SimpleOsFwCfgReadV1}
use os.port.init.compiler_filesystem_metadata_v2.{
    SimpleOsCfsRawReadV2,
    SimpleOsCfsMetadataReadsV2,
    SimpleOsCfsMetadataResultV2,
    simpleos_cfs_nonce_max_bytes_v2,
    simpleos_cfs_image_path_max_bytes_v2,
    simpleos_cfs_image_sha256_max_bytes_v2,
    simpleos_cfs_drive_arg_max_bytes_v2,
    simpleos_cfs_collect_metadata_v2,
}

fn _riscv64_cfs_raw_read_v2(read: SimpleOsFwCfgReadV1) -> SimpleOsCfsRawReadV2:
    SimpleOsCfsRawReadV2(ok: read.ok, bytes: read.bytes, reason: read.reason)

pub fn riscv64_compiler_filesystem_fw_cfg_metadata_with_reader_v2(
    reader: fn(text, i64) -> SimpleOsFwCfgReadV1
) -> SimpleOsCfsMetadataReadsV2:
    """Collect the four raw metadata fields through an injected named reader."""
    SimpleOsCfsMetadataReadsV2(
        nonce: _riscv64_cfs_raw_read_v2(reader(
            "opt/simpleos.cfs.nonce", simpleos_cfs_nonce_max_bytes_v2().to_i64())),
        image_path: _riscv64_cfs_raw_read_v2(reader(
            "opt/simpleos.cfs.image_path", simpleos_cfs_image_path_max_bytes_v2().to_i64())),
        image_sha256: _riscv64_cfs_raw_read_v2(reader(
            "opt/simpleos.cfs.image_sha256", simpleos_cfs_image_sha256_max_bytes_v2().to_i64())),
        drive_arg: _riscv64_cfs_raw_read_v2(reader(
            "opt/simpleos.cfs.drive_arg", simpleos_cfs_drive_arg_max_bytes_v2().to_i64()))
    )

pub fn riscv64_compiler_filesystem_fw_cfg_metadata_v2(
) -> SimpleOsCfsMetadataReadsV2:
    """Read bounded compiler-filesystem metadata from RV64 QEMU virt fw_cfg."""
    riscv64_compiler_filesystem_fw_cfg_metadata_with_reader_v2(
        riscv64_qemu_fw_cfg_read_named_file_v1
    )

pub fn riscv64_compiler_filesystem_metadata_collect_reads_v2(
    reads: SimpleOsCfsMetadataReadsV2,
) -> SimpleOsCfsMetadataResultV2:
    """Delegate all metadata interpretation to the shared collector."""
    simpleos_cfs_collect_metadata_v2(reads)

pub fn riscv64_compiler_filesystem_metadata_source_v2(
) -> SimpleOsCfsMetadataResultV2:
    """Read and validate RV64 compiler-filesystem metadata."""
    riscv64_compiler_filesystem_metadata_collect_reads_v2(
        riscv64_compiler_filesystem_fw_cfg_metadata_v2())

export riscv64_compiler_filesystem_fw_cfg_metadata_with_reader_v2
export riscv64_compiler_filesystem_fw_cfg_metadata_v2
export riscv64_compiler_filesystem_metadata_collect_reads_v2
export riscv64_compiler_filesystem_metadata_source_v2
