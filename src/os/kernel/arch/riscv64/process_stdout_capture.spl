# Bounded stdout capture for one synchronously entered RV64 user process.

val RV64_PROCESS_STDOUT_LIMIT: u64 = 4096

struct Rv64ProcessStdoutResult:
    bytes: [u8]
    exit_code: i64
    truncated: bool

extern fn rt_push_byte(arr: [u8], byte_val: i64) -> [u8]

var g_rv64_process_stdout_active: bool = false
var g_rv64_process_stdout_bytes: [u8] = []
var g_rv64_process_stdout_truncated: bool = false
var g_rv64_process_stdout_exit_code: i64 = -1

fn rv64_process_stdout_begin():
    g_rv64_process_stdout_bytes = []
    g_rv64_process_stdout_truncated = false
    g_rv64_process_stdout_exit_code = -1
    g_rv64_process_stdout_active = true

fn rv64_process_stdout_write_byte(byte: u8):
    if not g_rv64_process_stdout_active:
        return
    if g_rv64_process_stdout_bytes.len() < RV64_PROCESS_STDOUT_LIMIT:
        g_rv64_process_stdout_bytes = rt_push_byte(g_rv64_process_stdout_bytes, byte.to_i64())
    else:
        g_rv64_process_stdout_truncated = true

fn rv64_process_stdout_finish(exit_code: i64) -> Rv64ProcessStdoutResult:
    g_rv64_process_stdout_active = false
    g_rv64_process_stdout_exit_code = exit_code
    rv64_process_stdout_last_result()

fn rv64_process_stdout_last_result() -> Rv64ProcessStdoutResult:
    Rv64ProcessStdoutResult(
        bytes: g_rv64_process_stdout_bytes,
        exit_code: g_rv64_process_stdout_exit_code,
        truncated: g_rv64_process_stdout_truncated
    )
