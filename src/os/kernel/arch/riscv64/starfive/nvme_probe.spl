# codex-impl: read-only JH7110 PCIe1/NVMe discovery.
#
# Linux ownership model mirrored here:
# - this board module owns JH7110 link/config discovery;
# - common NVMe owns Identify and block commands after resources are admitted.

use os.drivers.pci.pci_provider.{PciConfigTarget, PciHostDescriptor, pci_host_config_addr}
use os.drivers.pci.pci_bar64.{pci_bar64_decode, pci_bar64_assignment}
use os.kernel.arch.riscv64.starfive.pcie_host.{starfive_jh7110_pcie1_firmware_defaults}

extern fn rt_starfive_mmio_read32(addr: u64) -> u64
extern fn rt_starfive_mmio_write32(addr: u64, value: u64)

val JH7110_PCIE1_LINK_STATUS: u64 = 0x10240368u64
val JH7110_PCIE_LINK_UP: u64 = 1u64 << 5
val JH7110_PCIE1_MEM_BASE: u64 = 0x38000000u64
val JH7110_PCIE1_MEM_LIMIT: u64 = 0x40000000u64

struct StarFiveNvmePciIdentity:
    domain: u32
    bus: u8
    device: u8
    func: u8
    vendor_id: u16
    device_id: u16
    class_code: u8
    subclass: u8
    prog_if: u8
    bar0_raw: u32
    bar1_raw: u32

struct StarFiveNvmeControllerResource:
    identity: StarFiveNvmePciIdentity
    bar0_cpu: u64
    bar0_size: u64
    polling: bool

fn starfive_pcie1_link_up() -> bool:
    (rt_starfive_mmio_read32(JH7110_PCIE1_LINK_STATUS) & JH7110_PCIE_LINK_UP) != 0u64

fn _starfive_pci_read32(host: PciHostDescriptor, target: PciConfigTarget) -> Result<u32, text>:
    val address = pci_host_config_addr(host, target)
    if address.is_err():
        return Err(address.unwrap_err())
    Ok(rt_starfive_mmio_read32(address.unwrap()).to_u32())

fn _starfive_pci_write32(host: PciHostDescriptor, target: PciConfigTarget, value: u32) -> Result<bool, text>:
    val address = pci_host_config_addr(host, target)
    if address.is_err():
        return Err(address.unwrap_err())
    rt_starfive_mmio_write32(address.unwrap(), value.to_u64())
    if rt_starfive_mmio_read32(address.unwrap()).to_u32() != value:
        return Err("pci-config-write-readback-mismatch")
    Ok(true)

fn _starfive_pci_write32_raw(host: PciHostDescriptor, target: PciConfigTarget, value: u32) -> Result<bool, text>:
    val address = pci_host_config_addr(host, target)
    if address.is_err():
        return Err(address.unwrap_err())
    rt_starfive_mmio_write32(address.unwrap(), value.to_u64())
    Ok(true)

fn starfive_find_nvme_read_only() -> Result<StarFiveNvmePciIdentity, text>:
    """Scan PCIe1 downstream bus 1 without config or media writes.

    The PLDA root port's own bus-0 configuration is not ordinary ECAM and must
    be handled by the StarFive host provider. Linux exposes the M.2 endpoint on
    domain 1, bus 1, so this read-only first-light probe never touches bus 0.
    """
    if not starfive_pcie1_link_up():
        return Err("starfive-pcie1-link-down")
    val host_result = starfive_jh7110_pcie1_firmware_defaults()
    if host_result.is_err():
        return Err(host_result.unwrap_err())
    val host = host_result.unwrap()
    var bus: u16 = 1u16
    while bus <= 1u16:
        var device: u8 = 0u8
        while device < 32u8:
            val target = PciConfigTarget(bus: bus.to_u8(), device: device, func: 0u8, offset: 0u16)
            val id = _starfive_pci_read32(host, target)
            if id.is_ok():
                val id_raw = id.unwrap()
                val vendor = (id_raw & 0xFFFFu32).to_u16()
                if vendor != 0xFFFFu16 and vendor != 0u16:
                    val class_target = PciConfigTarget(bus: bus.to_u8(), device: device, func: 0u8, offset: 0x08u16)
                    val class_result = _starfive_pci_read32(host, class_target)
                    if class_result.is_ok():
                        val class_raw = class_result.unwrap()
                        val class_code = ((class_raw >> 24) & 0xFFu32).to_u8()
                        val subclass = ((class_raw >> 16) & 0xFFu32).to_u8()
                        val prog_if = ((class_raw >> 8) & 0xFFu32).to_u8()
                        if class_code == 0x01u8 and subclass == 0x08u8 and prog_if == 0x02u8:
                            val bar0 = _starfive_pci_read32(host, PciConfigTarget(bus: bus.to_u8(), device: device, func: 0u8, offset: 0x10u16))
                            val bar1 = _starfive_pci_read32(host, PciConfigTarget(bus: bus.to_u8(), device: device, func: 0u8, offset: 0x14u16))
                            if bar0.is_err() or bar1.is_err():
                                return Err("starfive-nvme-bar-read-failed")
                            return Ok(StarFiveNvmePciIdentity(
                                domain: host.domain, bus: bus.to_u8(), device: device, func: 0u8,
                                vendor_id: vendor, device_id: ((id_raw >> 16) & 0xFFFFu32).to_u16(),
                                class_code: class_code, subclass: subclass, prog_if: prog_if,
                                bar0_raw: bar0.unwrap(), bar1_raw: bar1.unwrap()
                            ))
            device = device + 1u8
        bus = bus + 1u16
    Err("starfive-nvme-pci-function-not-found")

fn starfive_prepare_nvme_controller(identity: StarFiveNvmePciIdentity) -> Result<StarFiveNvmeControllerResource, text>:
    """Size and assign the NVMe BAR, then enable memory decoding and DMA.

    This mutates PCI configuration only. It does not submit an NVMe command or
    write namespace media. The original command/BAR values are restored on
    every failed admission path.
    """
    val host_result = starfive_jh7110_pcie1_firmware_defaults()
    if host_result.is_err():
        return Err(host_result.unwrap_err())
    val host = host_result.unwrap()
    val base_target = PciConfigTarget(bus: identity.bus, device: identity.device, func: identity.func, offset: 0x04u16)
    val bar0_target = PciConfigTarget(bus: identity.bus, device: identity.device, func: identity.func, offset: 0x10u16)
    val bar1_target = PciConfigTarget(bus: identity.bus, device: identity.device, func: identity.func, offset: 0x14u16)
    val command_result = _starfive_pci_read32(host, base_target)
    if command_result.is_err():
        return Err("starfive-nvme-command-read-failed")
    val original_command = command_result.unwrap()
    val decode_disabled = original_command & 0xFFFFFFF9u32
    if _starfive_pci_write32(host, base_target, decode_disabled).is_err():
        return Err("starfive-nvme-command-disable-failed")

    val probe0_write = _starfive_pci_write32_raw(host, bar0_target, 0xFFFFFFFFu32)
    val probe1_write = _starfive_pci_write32_raw(host, bar1_target, 0xFFFFFFFFu32)
    if probe0_write.is_err() or probe1_write.is_err():
        _starfive_pci_write32(host, bar0_target, identity.bar0_raw)
        _starfive_pci_write32(host, bar1_target, identity.bar1_raw)
        _starfive_pci_write32(host, base_target, original_command)
        return Err("starfive-nvme-bar-probe-write-failed")
    val probe0 = _starfive_pci_read32(host, bar0_target)
    val probe1 = _starfive_pci_read32(host, bar1_target)
    _starfive_pci_write32(host, bar0_target, identity.bar0_raw)
    _starfive_pci_write32(host, bar1_target, identity.bar1_raw)
    if probe0.is_err() or probe1.is_err():
        _starfive_pci_write32(host, base_target, original_command)
        return Err("starfive-nvme-bar-probe-read-failed")
    val info = pci_bar64_decode(identity.bar0_raw, identity.bar1_raw, probe0.unwrap(), probe1.unwrap())
    val assignment = pci_bar64_assignment(info, JH7110_PCIE1_MEM_BASE, JH7110_PCIE1_MEM_LIMIT)
    if not assignment.ok:
        _starfive_pci_write32(host, base_target, original_command)
        return Err("starfive-nvme-bar-assignment-" + assignment.reason)
    val high_write = _starfive_pci_write32(host, bar1_target, assignment.programmed_high)
    val low_write = _starfive_pci_write32(host, bar0_target, assignment.programmed_low)
    if high_write.is_err() or low_write.is_err():
        _starfive_pci_write32(host, bar0_target, identity.bar0_raw)
        _starfive_pci_write32(host, bar1_target, identity.bar1_raw)
        _starfive_pci_write32(host, base_target, original_command)
        return Err("starfive-nvme-bar-program-failed")
    val enabled_command = original_command | 0x00000006u32
    val enable_result = _starfive_pci_write32(host, base_target, enabled_command)
    if enable_result.is_err():
        _starfive_pci_write32(host, base_target, original_command)
        return Err("starfive-nvme-command-enable-failed")
    Ok(StarFiveNvmeControllerResource(
        identity: identity,
        bar0_cpu: assignment.base,
        bar0_size: assignment.size,
        polling: true
    ))

export StarFiveNvmePciIdentity, StarFiveNvmeControllerResource
export starfive_find_nvme_read_only, starfive_prepare_nvme_controller, starfive_pcie1_link_up
