# Minimal board-owned read-only VFS root for StarFive bring-up.

use std.fs_driver.types.{DirEntry}

var g_starfive_root_mounted: bool = false
var g_starfive_root_entries: [DirEntry] = []

fn starfive_vfs_mount_root(entries: [DirEntry]) -> Result<(), text>:
    if g_starfive_root_mounted:
        return Err("starfive-vfs: root already mounted")
    if entries.len() == 0:
        return Err("starfive-vfs: packaged root empty")
    g_starfive_root_entries = entries
    g_starfive_root_mounted = true
    Ok(())

fn g_vfs_readdir(path: text) -> [DirEntry]:
    if not g_starfive_root_mounted:
        return []
    if path != "/":
        return []
    g_starfive_root_entries

export starfive_vfs_mount_root, g_vfs_readdir
