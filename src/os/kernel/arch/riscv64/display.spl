"""Scalar RISC-V VirtIO scanout facade for freestanding production frames."""

use os.kernel.arch.riscv64.noalloc_pmm_runtime.{rv64_noalloc_pmm_initialize_default}
use std.nogc_async_mut_noalloc.baremetal.mmio.{mmio_write_u32}
extern fn rt_display_init() -> i64
extern fn rt_display_framebuffer_address() -> u64
extern fn rt_display_width() -> i64
extern fn rt_display_height() -> i64
extern fn rt_display_pitch() -> i64
extern fn rt_display_bpp() -> i64
extern fn rt_display_present() -> i64

fn riscv64_display_boot_memory_initialize() -> bool:
    rv64_noalloc_pmm_initialize_default() == 1

fn riscv64_display_initialize() -> bool:
    rt_display_init() == 0

fn riscv64_display_framebuffer_address() -> u64:
    rt_display_framebuffer_address()

fn riscv64_display_width() -> u32:
    rt_display_width().to_u32()

fn riscv64_display_height() -> u32:
    rt_display_height().to_u32()

fn riscv64_display_pitch() -> u32:
    rt_display_pitch().to_u32()

fn riscv64_display_bpp() -> u32:
    rt_display_bpp().to_u32()

fn riscv64_display_present() -> bool:
    rt_display_present() == 0

fn riscv64_display_fill_rect_argb(x: u32, y: u32, w: u32, h: u32, argb: u32) -> u32:
    """Fill an axis-aligned rectangle of the BGRA8888 scanout, returning the
    number of pixels actually written.

    This is the scanout WRITE half of the facade. It lives here, next to the
    scanout metadata accessors, because this module is the backend-owner for
    the RISC-V VirtIO scanout: callers (kernel entries, examples) must reach
    pixels through the facade rather than declaring their own framebuffer
    externs, per doc/04_architecture/ui/rendering/backend_isolation_architecture.md.

    Returns 0 when the scanout is not addressable or the rectangle does not fit,
    so a caller can fail closed by comparing the count against w * h.
    """
    val base = rt_display_framebuffer_address()
    val pitch = rt_display_pitch().to_u32()
    val width = rt_display_width().to_u32()
    val height = rt_display_height().to_u32()
    if base == 0u64 or pitch == 0u32:
        return 0u32
    if x + w > width or y + h > height:
        return 0u32
    var painted: u32 = 0u32
    var row: u32 = 0u32
    while row < h:
        var col: u32 = 0u32
        while col < w:
            val off = ((y + row) * pitch) + ((x + col) * 4u32)
            mmio_write_u32(base + off.to_u64(), argb)
            painted = painted + 1u32
            col = col + 1u32
        row = row + 1u32
    painted

export riscv64_display_boot_memory_initialize, riscv64_display_initialize,
    riscv64_display_framebuffer_address, riscv64_display_width,
    riscv64_display_height, riscv64_display_pitch, riscv64_display_bpp,
    riscv64_display_present, riscv64_display_fill_rect_argb
