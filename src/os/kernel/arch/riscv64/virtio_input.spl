# RV64 QEMU virt legacy VirtIO-PCI input facade.

use os.drivers.virtio.virtio_input_ops.{VirtioInputEvent}

extern fn rt_riscv64_virtio_input_init() -> i64
extern fn rt_riscv64_virtio_input_poll() -> i64
extern fn rt_riscv64_virtio_input_event_type() -> i64
extern fn rt_riscv64_virtio_input_event_code() -> i64
extern fn rt_riscv64_virtio_input_event_value() -> i64
extern fn rt_riscv64_virtio_input_event_device_kind() -> i64
extern fn rt_riscv64_virtio_input_event_irq_status() -> i64

val RISCV64_VIRTIO_INPUT_REQUIRED_READY: u32 = 3

fn riscv64_virtio_input_init() -> u32:
    rt_riscv64_virtio_input_init().to_u32()

fn riscv64_virtio_input_ready(mask: u32) -> bool:
    (mask & RISCV64_VIRTIO_INPUT_REQUIRED_READY) == RISCV64_VIRTIO_INPUT_REQUIRED_READY

fn riscv64_virtio_input_poll() -> VirtioInputEvent?:
    if rt_riscv64_virtio_input_poll() == 0:
        return nil
    VirtioInputEvent(
        device_kind: rt_riscv64_virtio_input_event_device_kind().to_u32(),
        type_: rt_riscv64_virtio_input_event_type().to_u16(),
        code: rt_riscv64_virtio_input_event_code().to_u16(),
        value: rt_riscv64_virtio_input_event_value().to_u32(),
        irq_status: rt_riscv64_virtio_input_event_irq_status().to_u32()
    )

export riscv64_virtio_input_init, riscv64_virtio_input_ready,
    riscv64_virtio_input_poll
