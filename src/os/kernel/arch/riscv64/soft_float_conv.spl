# riscv64 kernel i64<->f64 libcalls (pure Simple, no libgcc).
# The LLVM backend lowers i64<->double on soft-float riscv64 to compiler-rt
# __floatdidf / __fixdfdi; no prebuilt riscv64 compiler-rt exists on the dev
# hosts. Logic is shared: arch/common/soft_float_conv64.spl. Exports never
# call each other.

use os.kernel.arch.common.soft_float_conv64.{sf64_i64_to_f64_bits, sf64_f64_bits_to_i64}

@export("C")
fn __floatdidf(a: i64) -> i64:
    sf64_i64_to_f64_bits(a)

@export("C")
fn __fixdfdi(bits: i64) -> i64:
    sf64_f64_bits_to_i64(bits)
