# codex-impl
# Pure scalar policy for the Cortex-M33/M4 C bring-up shim.
#
# The C bridge owns raw pointer traversal, table/asset acquisition, memory
# writeback, UART, MMIO, startup, vectors, and assembly.  Every conditional
# decision formerly embedded in streq, starts_with, parse_hex, strlen_simple,
# memcpy_simple, fs_add_file, fs_init, and fs_find is classified here.

const CM33_TEXT_STEP_MISMATCH: u32 = 0
const CM33_TEXT_STEP_ADVANCE: u32 = 1
const CM33_TEXT_STEP_MATCHED: u32 = 2

const CM33_HEX_DIGIT_INVALID: u32 = 0xffffffffu32

const CM33_FS_ADD_ADMITTED: u32 = 0
const CM33_FS_ADD_TABLE_FULL: u32 = 1
const CM33_FS_ADD_STORAGE_FULL: u32 = 2
const CM33_FS_ADD_OUTCOME_MASK: u32 = 0xff
const CM33_FS_ADD_USED_SHIFT: u32 = 8

const CM33_FS_INIT_DONE: u32 = 0xffffffffu32
const CM33_FS_INIT_FILE_COUNT: u32 = 6

const CM33_FS_FIND_NEXT: u32 = 0
const CM33_FS_FIND_FOUND: u32 = 1
const CM33_FS_FIND_NOT_FOUND: u32 = 2

@export("C")
fn cm33_policy_streq(a_byte: u32, b_byte: u32) -> u32:
    if a_byte != b_byte:  # CM33-SPF-D01
        return CM33_TEXT_STEP_MISMATCH
    if a_byte == 0:  # CM33-SPF-D02
        return CM33_TEXT_STEP_MATCHED
    CM33_TEXT_STEP_ADVANCE

@export("C")
fn cm33_policy_starts_with(value_byte: u32, prefix_byte: u32) -> u32:
    if prefix_byte == 0:  # CM33-SPF-D03
        return CM33_TEXT_STEP_MATCHED
    if value_byte != prefix_byte:  # CM33-SPF-D04
        return CM33_TEXT_STEP_MISMATCH
    CM33_TEXT_STEP_ADVANCE

@export("C")
fn cm33_policy_parse_hex_prefix(first_byte: u32, second_byte: u32) -> u32:
    if first_byte != 48:  # CM33-SPF-D05
        return 0
    if (second_byte | 32) == 120:  # CM33-SPF-D06
        return 2
    0

@export("C")
fn cm33_policy_parse_hex_digit(byte: u32) -> u32:
    if byte >= 48:  # CM33-SPF-D07
        if byte <= 57:  # CM33-SPF-D08
            return byte - 48
    if byte >= 97:  # CM33-SPF-D09
        if byte <= 102:  # CM33-SPF-D10
            return byte - 97 + 10
    if byte >= 65:  # CM33-SPF-D11
        if byte <= 70:  # CM33-SPF-D12
            return byte - 65 + 10
    CM33_HEX_DIGIT_INVALID

@export("C")
fn cm33_policy_strlen_simple(byte: u32) -> u32:
    if byte == 0:  # CM33-SPF-D13
        return 0
    1

@export("C")
fn cm33_policy_memcpy_simple(remaining: u32) -> u32:
    if remaining == 0:  # CM33-SPF-D14
        return 0
    1

@export("C")
fn cm33_policy_fs_add_file(
    file_count: u32,
    used: u32,
    size: u32,
    max_files: u32,
    storage_size: u32
) -> u32:
    if file_count >= max_files:  # CM33-SPF-D15
        return CM33_FS_ADD_TABLE_FULL
    if used > storage_size:  # CM33-SPF-D16
        return CM33_FS_ADD_STORAGE_FULL
    if size > storage_size - used:  # CM33-SPF-D17
        return CM33_FS_ADD_STORAGE_FULL
    val next_used = used + ((size + 3) & 0xfffffffcu32)
    (next_used << CM33_FS_ADD_USED_SHIFT) | CM33_FS_ADD_ADMITTED

@export("C")
fn cm33_policy_fs_add_name(byte: u32, index: u32, name_max: u32) -> u32:
    if byte == 0:  # CM33-SPF-D18
        return 0
    if index >= name_max - 1:  # CM33-SPF-D19
        return 0
    1

@export("C")
fn cm33_policy_fs_init(index: u32) -> u32:
    if index >= CM33_FS_INIT_FILE_COUNT:  # CM33-SPF-D20
        return CM33_FS_INIT_DONE
    index

@export("C")
fn cm33_policy_fs_find(index: u32, file_count: u32, names_equal: u32) -> u32:
    if index >= file_count:  # CM33-SPF-D21
        return CM33_FS_FIND_NOT_FOUND
    if names_equal != 0:  # CM33-SPF-D22
        return CM33_FS_FIND_FOUND
    CM33_FS_FIND_NEXT
