# Board-owned immutable root used during UP Squared first-light.

use std.fs_driver.types.{DirEntry}

var g_up2_root_mounted: bool = false
var g_up2_root_entries: [DirEntry] = []

fn up2_vfs_mount_root(entries: [DirEntry]) -> Result<(), text>:
    if g_up2_root_mounted:
        return Err("up2-vfs: root already mounted")
    if entries.len() == 0:
        return Err("up2-vfs: packaged root empty")
    g_up2_root_entries = entries
    g_up2_root_mounted = true
    Ok(())

fn up2_vfs_readdir(path: text) -> [DirEntry]:
    if not g_up2_root_mounted or path != "/":
        return []
    g_up2_root_entries

export up2_vfs_mount_root, up2_vfs_readdir
