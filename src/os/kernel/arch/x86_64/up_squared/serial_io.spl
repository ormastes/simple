# UP Squared first-light serial I/O.
#
# The board console is intentionally Pure Simple.  Only the shared x86 port
# owner crosses the runtime boundary; every operation here remains a typed,
# allocation-free port access.

use os.kernel.arch.x86.port_io_owner.{x86_port_inb, x86_port_outb}
use std.common.string_core.{bytes_to_text}

val UP2_COM1_DATA: u16 = 0x3F8
val UP2_COM1_IER: u16 = 0x3F9
val UP2_COM1_FCR: u16 = 0x3FA
val UP2_COM1_LCR: u16 = 0x3FB
val UP2_COM1_MCR: u16 = 0x3FC
val UP2_COM1_LSR: u16 = 0x3FD
val UP2_SERIAL_LINE_MAX: i64 = 255

val UP2_SERIAL_LINE_IGNORE: i64 = 0
val UP2_SERIAL_LINE_FINISH: i64 = 1
val UP2_SERIAL_LINE_ERASE: i64 = 2
val UP2_SERIAL_LINE_APPEND: i64 = 3

var g_up2_serial_ready: bool = false

pub fn up2_serial_init():
    """Initialize legacy COM1 at 115200 baud, 8N1, and drain loopback."""
    if g_up2_serial_ready:
        return
    x86_port_outb(UP2_COM1_IER, 0x00)
    x86_port_outb(UP2_COM1_LCR, 0x80)
    x86_port_outb(UP2_COM1_DATA, 0x01)
    x86_port_outb(UP2_COM1_IER, 0x00)
    x86_port_outb(UP2_COM1_LCR, 0x03)
    x86_port_outb(UP2_COM1_FCR, 0xC7)
    x86_port_outb(UP2_COM1_MCR, 0x0B)
    x86_port_outb(UP2_COM1_MCR, 0x1E)
    x86_port_outb(UP2_COM1_DATA, 0xAE)
    val _loopback_byte = x86_port_inb(UP2_COM1_DATA)
    x86_port_outb(UP2_COM1_MCR, 0x0F)
    g_up2_serial_ready = true

@inline
fn _up2_serial_read_byte() -> u8:
    while (x86_port_inb(UP2_COM1_LSR) & 0x01) == 0:
        pass_do_nothing
    x86_port_inb(UP2_COM1_DATA)

@inline
fn _up2_serial_write_byte(byte: u8):
    while (x86_port_inb(UP2_COM1_LSR) & 0x20) == 0:
        pass_do_nothing
    x86_port_outb(UP2_COM1_DATA, byte)

pub fn serial_println(msg: text):
    """Write raw UTF-8 bytes followed by CRLF without intermediate allocation."""
    var index: i64 = 0
    val length = msg.len()
    while index < length:
        _up2_serial_write_byte(msg.byte_at(index))
        index = index + 1
    _up2_serial_write_byte(0x0D)
    _up2_serial_write_byte(0x0A)

pub fn up2_serial_line_action(length: i64, byte: u8) -> i64:
    """Pure decision seam used by readline and its branch/condition spec."""
    if byte == 0x0D or byte == 0x0A:
        return UP2_SERIAL_LINE_FINISH
    if byte == 0x7F or byte == 0x08:
        if length > 0:
            return UP2_SERIAL_LINE_ERASE
        return UP2_SERIAL_LINE_IGNORE
    if byte >= 0x20 and length < UP2_SERIAL_LINE_MAX:
        return UP2_SERIAL_LINE_APPEND
    UP2_SERIAL_LINE_IGNORE

pub fn up2_serial_line_at_capacity(length: i64) -> bool:
    """Return whether readline must return immediately without consuming input."""
    length >= UP2_SERIAL_LINE_MAX

pub fn up2_serial_readline() -> text:
    """Read one line using one bounded working array and one result text."""
    var line: [u8] = []
    loop:
        # Match the former C loop condition: reaching 255 returns immediately,
        # without polling another byte and without adding CRLF.
        if up2_serial_line_at_capacity(line.len()):
            return bytes_to_text(line)
        val byte = _up2_serial_read_byte()
        val action = up2_serial_line_action(line.len(), byte)
        if action == UP2_SERIAL_LINE_FINISH:
            _up2_serial_write_byte(0x0D)
            _up2_serial_write_byte(0x0A)
            return bytes_to_text(line)
        if action == UP2_SERIAL_LINE_ERASE:
            line.pop()
            _up2_serial_write_byte(0x08)
            _up2_serial_write_byte(0x20)
            _up2_serial_write_byte(0x08)
        elif action == UP2_SERIAL_LINE_APPEND:
            line.push(byte)
            _up2_serial_write_byte(byte)
    ""
