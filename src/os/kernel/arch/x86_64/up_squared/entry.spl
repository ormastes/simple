# UP Squared Apollo Lake x86_64 entry through UEFI -> GRUB -> Multiboot1.

use os.kernel.arch.x86_64.up_squared.root.{up2_mount_packaged_root}
use os.kernel.arch.x86_64.up_squared.console.{up2_serial_shell_main}
use os.kernel.arch.x86_64.console.{serial_init}

extern fn serial_println(msg: text)

fn _start():
    serial_init()
    serial_println("UP2 entry")
    serial_println("UP2 board=x86_64-up-squared-apollo-lake")
    serial_println("UP2 console-provider=legacy-com1-candidate")
    serial_println("UP2 console-ready")
    val root = up2_mount_packaged_root()
    if root.is_err():
        serial_println("UP2 filesystem-failed: " + root.unwrap_err())
        while true:
            pass
    serial_println("UP2 filesystem-ready entries=" + root.unwrap())
    serial_println("UP2 shell-ready")
    up2_serial_shell_main()

export _start
