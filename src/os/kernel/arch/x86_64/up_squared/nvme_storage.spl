# UP Squared adapter for the host-neutral Pure-Simple NVMe stack.
#
# PCI discovery/grant is the board boundary. NvmeDriver remains the sole owner
# of controller queues and DMA state. Media writes require an identity-bound
# challenge and are confined first to the namespace lease, then to the GPT
# partition lease.

use os.drivers.nvme.nvme_driver.{NvmeDriver}
use os.services.pcimgr.pcimgr.{pcimgr_init, pcimgr_find_nvme_storage, pcimgr_find_by_class_i64, pcimgr_find_qemu_nvme, pcimgr_grant_device}
use os.services.vfs.vfs_block_adapters.{NvmeBlockAdapter}
use os.kernel.types.capability_types.{SIMPLEOS_NVME_SYSTEM_QUEUE_ID}
use std.fs_driver.block_device.{BlockDevice}
use std.fs_driver.gpt_partition.{GptSinglePartitionRequest, gpt_format_plan, gpt_create_single_partition}
use std.fs_driver.fat32_format.{Fat32FormatAuthorization, Fat32FormatPlan, fat32_format_plan, fat32_format}
use os.kernel.arch.x86_64.up_squared.dci_mailbox.{
    DciStorageIdentity, DciStorageWrite, dci_storage_confirmation,
    dci_admit_storage_write
}
use os.kernel.arch.x86_64.up_squared.gdb_rsp_monitor.{
    UP2_RSP_STAGING_SIZE, up2_rsp_copy_staging
}
use os.services.storage_image_provision.{
    storage_image_plan, storage_image_write_chunk, storage_image_flush,
    storage_image_verify_readback
}

val UP2_NVME_IMAGE_MAX_CHUNK: u64 = 1048576u64

var g_up2_nvme_device: Up2NvmeLiveDevice? = nil
var g_up2_nvme_partition_first_lba: u64 = 0u64
var g_up2_nvme_partition_lba_count: u64 = 0u64
var g_up2_nvme_pci_vendor: u16 = 0u16
var g_up2_nvme_pci_device: u16 = 0u16
var g_up2_nvme_pci_bus: u8 = 0u8
var g_up2_nvme_pci_dev: u8 = 0u8
var g_up2_nvme_pci_func: u8 = 0u8
var g_up2_nvme_image_planned: bool = false
var g_up2_nvme_image_active: bool = false
var g_up2_nvme_image_byte_start: u64 = 0u64
var g_up2_nvme_image_size: u64 = 0u64
var g_up2_nvme_image_sha256: text = ""
var g_up2_nvme_image_next_offset: u64 = 0u64
var g_up2_nvme_image_expected_model: text = ""
var g_up2_nvme_image_expected_serial: text = ""
var g_up2_nvme_image_expected_transport: text = ""
var g_up2_nvme_image_expected_capacity: u64 = 0u64
var g_up2_nvme_image_confirmation: text = ""

struct Up2NvmeLiveDevice:
    driver: NvmeDriver
    pci_vendor: u16
    pci_device: u16
    bus: u8
    device: u8
    func: u8
    nsid: u32
    model: text
    serial: text
    firmware: text
    lba_size: u32
    lba_count: u64

fn up2_nvme_init_read_only() -> Result<text, text>:
    """Discover, grant, and Identify the first NVMe controller; never write media."""
    pcimgr_init()
    var index = pcimgr_find_nvme_storage()
    if index < 0:
        index = pcimgr_find_by_class_i64(1, 8)
    if index < 0:
        index = pcimgr_find_qemu_nvme()
    if index < 0:
        return Err("up2-nvme-not-found")
    val grant_result = pcimgr_grant_device(index.to_u64(), 0u64)
    if grant_result.is_err():
        return Err("up2-nvme-grant:" + grant_result.unwrap_err())
    val grant = grant_result.unwrap()
    var driver = NvmeDriver.new()
    val initialized = driver.init_from_grant(grant)
    if initialized.is_err():
        return Err("up2-nvme-init:" + initialized.unwrap_err())
    if not driver.is_initialized() or driver.sector_count == 0u64 or driver.sector_size == 0u32:
        return Err("up2-nvme-identify-incomplete")
    val device = Up2NvmeLiveDevice(
        driver: driver,
        pci_vendor: grant.pci_vendor,
        pci_device: grant.pci_device,
        bus: grant.pci_bus,
        device: grant.pci_dev,
        func: grant.pci_func,
        nsid: driver.identified_nsid,
        model: driver.controller_model,
        serial: driver.controller_serial,
        firmware: driver.controller_firmware,
        lba_size: driver.sector_size,
        lba_count: driver.sector_count
    )
    g_up2_nvme_device = device
    g_up2_nvme_pci_vendor = grant.pci_vendor
    g_up2_nvme_pci_device = grant.pci_device
    g_up2_nvme_pci_bus = grant.pci_bus
    g_up2_nvme_pci_dev = grant.pci_dev
    g_up2_nvme_pci_func = grant.pci_func
    Ok("model=" + device.model + " serial=" + device.serial + " nsid=" + device.nsid.to_text() + " lba_size=" + device.lba_size.to_text() + " lba_count=" + device.lba_count.to_text() + " media_writes=0")

fn up2_nvme_format_challenge() -> Result<text, text>:
    if g_up2_nvme_device == nil:
        return Err("up2-nvme-not-identified")
    val device = g_up2_nvme_device.unwrap()
    Ok("FORMAT:" + device.serial + ":" + device.nsid.to_text() + ":" + device.lba_count.to_text())

fn up2_nvme_identity_summary() -> Result<text, text>:
    if g_up2_nvme_device == nil:
        return Err("up2-nvme-not-identified")
    val device = g_up2_nvme_device.unwrap()
    val lba_bytes = device.lba_size.to_u64()
    if lba_bytes == 0u64:
        return Err("up2-nvme-capacity-overflow")
    val capacity = device.lba_count * lba_bytes
    if device.lba_count != 0u64 and capacity / device.lba_count != lba_bytes:
        return Err("up2-nvme-capacity-overflow")
    Ok(
        "nvme_identity_status=pass" +
        " pci=" + g_up2_nvme_pci_vendor.to_text() + ":" + g_up2_nvme_pci_device.to_text() +
        " bdf=" + g_up2_nvme_pci_bus.to_text() + ":" + g_up2_nvme_pci_dev.to_text() + "." + g_up2_nvme_pci_func.to_text() +
        " model=" + device.model +
        " serial=" + device.serial +
        " firmware=" + device.firmware +
        " nsid=" + device.nsid.to_text() +
        " lba_size=" + device.lba_size.to_text() +
        " lba_count=" + device.lba_count.to_text() +
        " capacity_bytes=" + capacity.to_text() +
        " completion=polling media_writes=0"
    )

fn _up2_nvme_adapter(device: Up2NvmeLiveDevice, base_lba: u64, lba_count: u64) -> Result<NvmeBlockAdapter, text>:
    var adapter = NvmeBlockAdapter.for_identified_namespace_unchecked(
        device.driver,
        device.nsid,
        SIMPLEOS_NVME_SYSTEM_QUEUE_ID,
        base_lba,
        lba_count,
        device.lba_size,
        "fat32"
    )
    val initialized = adapter.init_bounce_buffer()
    if initialized.is_err():
        return Err(initialized.unwrap_err())
    Ok(adapter)

fn _up2_nvme_storage_identity(device: Up2NvmeLiveDevice) -> Result<DciStorageIdentity, text>:
    val sector_bytes = device.lba_size.to_u64()
    if sector_bytes == 0u64:
        return Err("up2-nvme-capacity-overflow")
    val capacity = device.lba_count * sector_bytes
    if device.lba_count != 0u64 and capacity / device.lba_count != sector_bytes:
        return Err("up2-nvme-capacity-overflow")
    Ok(DciStorageIdentity(
        model: device.model,
        serial: device.serial,
        transport: "pci-nvme:" + g_up2_nvme_pci_vendor.to_text() + ":" +
            g_up2_nvme_pci_device.to_text() + ":" + g_up2_nvme_pci_bus.to_text() + ":" +
            g_up2_nvme_pci_dev.to_text() + "." + g_up2_nvme_pci_func.to_text(),
        capacity: capacity,
        root_device: false,
        swap_device: false,
        mounted: g_up2_nvme_partition_lba_count != 0u64,
        held: false
    ))

fn _up2_nvme_clear_image_session():
    g_up2_nvme_image_planned = false
    g_up2_nvme_image_active = false
    g_up2_nvme_image_byte_start = 0u64
    g_up2_nvme_image_size = 0u64
    g_up2_nvme_image_sha256 = ""
    g_up2_nvme_image_next_offset = 0u64
    g_up2_nvme_image_expected_model = ""
    g_up2_nvme_image_expected_serial = ""
    g_up2_nvme_image_expected_transport = ""
    g_up2_nvme_image_expected_capacity = 0u64
    g_up2_nvme_image_confirmation = ""

fn up2_nvme_image_plan(
    byte_start: u64,
    image_size: u64,
    image_sha256: text
) -> Result<text, text>:
    """Prepare but do not authorize a bounded raw-image write."""
    if g_up2_nvme_device == nil:
        return Err("up2-nvme-not-identified")
    if g_up2_nvme_partition_lba_count != 0u64:
        return Err("up2-nvme-device-mounted")
    if g_up2_nvme_image_planned or g_up2_nvme_image_active:
        return Err("up2-nvme-image-session-active")
    val device = g_up2_nvme_device.unwrap()
    val plan = storage_image_plan(
        device.lba_size, device.lba_count, byte_start, image_size, image_sha256)
    if plan.is_err():
        return Err(plan.unwrap_err())
    val identity = _up2_nvme_storage_identity(device)
    if identity.is_err():
        return Err(identity.unwrap_err())
    val confirmation = dci_storage_confirmation(
        identity.unwrap(), byte_start, image_size, image_sha256)
    g_up2_nvme_image_planned = true
    g_up2_nvme_image_byte_start = byte_start
    g_up2_nvme_image_size = image_size
    g_up2_nvme_image_sha256 = image_sha256
    g_up2_nvme_image_expected_model = identity.unwrap().model
    g_up2_nvme_image_expected_serial = identity.unwrap().serial
    g_up2_nvme_image_expected_transport = identity.unwrap().transport
    g_up2_nvme_image_expected_capacity = identity.unwrap().capacity
    g_up2_nvme_image_confirmation = confirmation
    Ok("nvme_image_challenge=" + confirmation +
        " staging_bytes=" + UP2_RSP_STAGING_SIZE.to_text() +
        " max_chunk=" + UP2_NVME_IMAGE_MAX_CHUNK.to_text() +
        " media_writes=0")

fn _up2_nvme_admit_image_confirmation(confirmation: text) -> Result<bool, text>:
    if g_up2_nvme_device == nil or not g_up2_nvme_image_planned:
        return Err("up2-nvme-image-plan-missing")
    val observed = _up2_nvme_storage_identity(g_up2_nvme_device.unwrap())
    if observed.is_err():
        return Err(observed.unwrap_err())
    val expected = DciStorageIdentity(
        model: g_up2_nvme_image_expected_model,
        serial: g_up2_nvme_image_expected_serial,
        transport: g_up2_nvme_image_expected_transport,
        capacity: g_up2_nvme_image_expected_capacity,
        root_device: false,
        swap_device: false,
        mounted: false,
        held: false
    )
    val write = DciStorageWrite(
        observed: observed.unwrap(),
        expected: expected,
        byte_start: g_up2_nvme_image_byte_start,
        byte_length: g_up2_nvme_image_size,
        image_size: g_up2_nvme_image_size,
        image_sha256: g_up2_nvme_image_sha256,
        confirmation: confirmation,
        persistent_allowed: true
    )
    val admitted = dci_admit_storage_write(write)
    if not admitted.accepted:
        return Err(admitted.reason +
            ":source_capacity=" + observed.unwrap().capacity.to_text() +
            ":request_capacity=" + write.observed.capacity.to_text() +
            ":source_start=" + g_up2_nvme_image_byte_start.to_text() +
            ":request_start=" + write.byte_start.to_text() +
            ":source_length=" + g_up2_nvme_image_size.to_text() +
            ":request_length=" + write.byte_length.to_text())
    Ok(true)

fn up2_nvme_image_confirm(confirmation: text) -> Result<text, text>:
    """Activate the exact identity/range/digest plan after explicit confirmation."""
    if g_up2_nvme_image_active:
        return Err("up2-nvme-image-session-active")
    val admitted = _up2_nvme_admit_image_confirmation(confirmation)
    if admitted.is_err() or confirmation != g_up2_nvme_image_confirmation:
        if admitted.is_err():
            return Err(admitted.unwrap_err())
        return Err("storage-confirmation")
    g_up2_nvme_image_active = true
    g_up2_nvme_image_next_offset = 0u64
    Ok("nvme_image_session=ready next_offset=0 media_writes=0")

fn up2_nvme_image_chunk(
    staging_offset: u64,
    image_offset: u64,
    byte_length: u64,
    chunk_sha256: text
) -> Result<text, text>:
    """Hash one staged chunk before committing its ordered sectors."""
    if not g_up2_nvme_image_active or g_up2_nvme_device == nil:
        return Err("up2-nvme-image-session-missing")
    if image_offset != g_up2_nvme_image_next_offset:
        return Err("up2-nvme-image-offset-order")
    if byte_length == 0u64 or byte_length > UP2_NVME_IMAGE_MAX_CHUNK:
        return Err("up2-nvme-image-chunk-size")
    if (staging_offset > UP2_RSP_STAGING_SIZE or
        byte_length > UP2_RSP_STAGING_SIZE - staging_offset):
        return Err("up2-nvme-image-staging-range")
    val admitted = _up2_nvme_admit_image_confirmation(g_up2_nvme_image_confirmation)
    if admitted.is_err():
        _up2_nvme_clear_image_session()
        return Err(admitted.unwrap_err())
    val staged = up2_rsp_copy_staging(staging_offset, byte_length)
    if staged.is_err():
        return Err(staged.unwrap_err())
    val device = g_up2_nvme_device.unwrap()
    val plan = storage_image_plan(
        device.lba_size, device.lba_count, g_up2_nvme_image_byte_start,
        g_up2_nvme_image_size, g_up2_nvme_image_sha256)
    if plan.is_err():
        _up2_nvme_clear_image_session()
        return Err(plan.unwrap_err())
    val adapter = _up2_nvme_adapter(device, 0u64, device.lba_count)
    if adapter.is_err():
        _up2_nvme_clear_image_session()
        return Err(adapter.unwrap_err())
    val dev: BlockDevice = adapter.unwrap()
    val written = storage_image_write_chunk(
        dev, plan.unwrap(), image_offset, staged.unwrap(), chunk_sha256)
    if written.is_err():
        _up2_nvme_clear_image_session()
        return Err(written.unwrap_err() + ":session-aborted")
    g_up2_nvme_image_next_offset = written.unwrap()
    Ok("nvme_image_chunk=pass image_offset=" + image_offset.to_text() +
        " bytes=" + byte_length.to_text() +
        " next_offset=" + written.unwrap().to_text())

fn up2_nvme_image_finish() -> Result<text, text>:
    """Flush, reopen through a fresh adapter, and hash every written sector."""
    if not g_up2_nvme_image_active or g_up2_nvme_device == nil:
        return Err("up2-nvme-image-session-missing")
    val admitted = _up2_nvme_admit_image_confirmation(g_up2_nvme_image_confirmation)
    if admitted.is_err():
        _up2_nvme_clear_image_session()
        return Err(admitted.unwrap_err())
    val device = g_up2_nvme_device.unwrap()
    val plan = storage_image_plan(
        device.lba_size, device.lba_count, g_up2_nvme_image_byte_start,
        g_up2_nvme_image_size, g_up2_nvme_image_sha256)
    if plan.is_err():
        _up2_nvme_clear_image_session()
        return Err(plan.unwrap_err())
    val write_adapter = _up2_nvme_adapter(device, 0u64, device.lba_count)
    if write_adapter.is_err():
        _up2_nvme_clear_image_session()
        return Err(write_adapter.unwrap_err())
    val write_dev: BlockDevice = write_adapter.unwrap()
    val flushed = storage_image_flush(
        write_dev, plan.unwrap(), g_up2_nvme_image_next_offset)
    if flushed.is_err():
        _up2_nvme_clear_image_session()
        return Err(flushed.unwrap_err())
    val fresh_adapter = _up2_nvme_adapter(device, 0u64, device.lba_count)
    if fresh_adapter.is_err():
        _up2_nvme_clear_image_session()
        return Err(fresh_adapter.unwrap_err())
    val fresh_dev: BlockDevice = fresh_adapter.unwrap()
    val verified = storage_image_verify_readback(fresh_dev, plan.unwrap())
    _up2_nvme_clear_image_session()
    if verified.is_err():
        return Err(verified.unwrap_err())
    Ok("nvme_image_status=pass " + verified.unwrap())

fn up2_nvme_image_abort() -> text:
    _up2_nvme_clear_image_session()
    "nvme_image_session=aborted"

fn _up2_bytes_equal(a: [u8], b: [u8]) -> bool:
    if a.len() != b.len():
        return false
    var i: i64 = 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    true

fn _up2_put_u16(data: [u8], offset: i64, value: u32) -> [u8]:
    var out = data
    out[offset] = (value & 0xffu32).to_u8()
    out[offset + 1] = ((value >> 8) & 0xffu32).to_u8()
    out

fn _up2_put_u32(data: [u8], offset: i64, value: u32) -> [u8]:
    var out = _up2_put_u16(data, offset, value)
    _up2_put_u16(out, offset + 2, value >> 16)

fn _up2_zero_sector(size: u32) -> [u8]:
    var out: [u8] = []
    var index: i64 = 0
    while index < size.to_i64():
        out.push(0u8)
        index = index + 1
    out

fn _up2_write_verify(dev: BlockDevice, lba: u64, sector: [u8]) -> Result<bool, text>:
    val wrote = dev.write_sector(lba, sector)
    if wrote.is_err() or not wrote.unwrap():
        return Err("up2-nvme-sector-write")
    val readback = dev.read_sector(lba)
    if readback.is_err() or not _up2_bytes_equal(sector, readback.unwrap()):
        return Err("up2-nvme-sector-readback")
    Ok(true)

fn _up2_write_fat32_proof(dev: BlockDevice, fat_plan: Fat32FormatPlan, proof: [u8]) -> Result<bool, text>:
    # Allocate cluster 3 in both FAT copies.
    var fat_index: u32 = 0u32
    while fat_index < fat_plan.fat_count:
        val fat_lba = fat_plan.reserved_sectors.to_u64() + fat_index.to_u64() * fat_plan.fat_sectors.to_u64()
        val fat_result = dev.read_sector(fat_lba)
        if fat_result.is_err():
            return Err("up2-nvme-proof-fat-read")
        var fat = fat_result.unwrap()
        fat = _up2_put_u32(fat, 12, 0x0fffffffu32)
        val fat_write = _up2_write_verify(dev, fat_lba, fat)
        if fat_write.is_err():
            return Err(fat_write.unwrap_err())
        fat_index = fat_index + 1u32

    val proof_lba = fat_plan.data_start_lba + fat_plan.sectors_per_cluster.to_u64()
    var data = _up2_zero_sector(fat_plan.sector_size)
    var index: i64 = 0
    while index < proof.len():
        data[index] = proof[index]
        index = index + 1
    val data_write = _up2_write_verify(dev, proof_lba, data)
    if data_write.is_err():
        return Err(data_write.unwrap_err())

    var root = _up2_zero_sector(fat_plan.sector_size)
    val name: [u8] = [80u8, 82u8, 79u8, 79u8, 70u8, 32u8, 32u8, 32u8, 84u8, 88u8, 84u8]
    index = 0
    while index < name.len():
        root[index] = name[index]
        index = index + 1
    root[11] = 0x20u8
    root = _up2_put_u16(root, 20, 0u32)
    root = _up2_put_u16(root, 26, 3u32)
    root = _up2_put_u32(root, 28, proof.len().to_u32())
    val root_write = _up2_write_verify(dev, fat_plan.data_start_lba, root)
    if root_write.is_err():
        return Err(root_write.unwrap_err())
    val flushed = dev.flush()
    if flushed.is_err() or not flushed.unwrap():
        return Err("up2-nvme-proof-flush")
    Ok(true)

fn up2_nvme_provision_fat32(challenge: text) -> Result<text, text>:
    """Create GPT/FAT32, write a file, flush, remount, and verify readback."""
    val expected = up2_nvme_format_challenge()
    if expected.is_err() or challenge != expected.unwrap():
        return Err("up2-nvme-format-challenge-mismatch")
    if g_up2_nvme_partition_lba_count != 0u64:
        return Err("up2-nvme-already-mounted")
    if g_up2_nvme_image_planned or g_up2_nvme_image_active:
        return Err("up2-nvme-image-session-active")
    val device = g_up2_nvme_device.unwrap()
    if device.lba_size != 512u32 and device.lba_size != 4096u32:
        return Err("up2-nvme-format-unsupported-lba-size")
    val namespace_adapter_result = _up2_nvme_adapter(device, 0u64, device.lba_count)
    if namespace_adapter_result.is_err():
        return Err(namespace_adapter_result.unwrap_err())
    val namespace_adapter = namespace_adapter_result.unwrap()
    val namespace_dev: BlockDevice = namespace_adapter
    val gpt_plan_result = gpt_format_plan(device.lba_size, device.lba_count, 128u32)
    if gpt_plan_result.is_err():
        return Err(gpt_plan_result.unwrap_err())
    val gpt_plan = gpt_plan_result.unwrap()
    val alignment_lbas = 1048576u64 / device.lba_size.to_u64()
    if alignment_lbas < gpt_plan.first_usable_lba or alignment_lbas >= gpt_plan.last_usable_lba:
        return Err("up2-nvme-partition-geometry-invalid")
    val request = GptSinglePartitionRequest(
        first_lba: alignment_lbas,
        last_lba: gpt_plan.last_usable_lba,
        type_guid_lo: 0x4433b9e5ebd0a0a2u64,
        type_guid_hi: 0xc79926b7b668c087u64,
        unique_guid_lo: 0x55503253494d504cu64,
        unique_guid_hi: device.lba_count ^ device.nsid.to_u64(),
        disk_guid_lo: 0x41504c5550324e56u64,
        disk_guid_hi: device.lba_count ^ 0x53494d504c454f53u64
    )
    val created = gpt_create_single_partition(namespace_dev, gpt_plan, request)
    if created.is_err():
        return Err(created.unwrap_err())
    val partition = created.unwrap()
    val partition_count = partition.last_lba - partition.first_lba + 1u64
    val partition_adapter_result = _up2_nvme_adapter(device, partition.first_lba, partition_count)
    if partition_adapter_result.is_err():
        return Err(partition_adapter_result.unwrap_err())
    val partition_adapter = partition_adapter_result.unwrap()
    val partition_dev: BlockDevice = partition_adapter
    val fat_plan = fat32_format_plan(device.lba_size, partition_count, 1u32)
    if fat_plan.is_err():
        return Err(fat_plan.unwrap_err())
    val authority = Fat32FormatAuthorization(
        approved: true,
        identity_hash: device.serial + ":" + device.nsid.to_text() + ":" + device.lba_count.to_text(),
        challenge: challenge
    )
    val formatted = fat32_format(partition_dev, fat_plan.unwrap(), authority, device.nsid ^ device.lba_count.to_u32(), "SIMPLEOS")
    if formatted.is_err():
        return Err(formatted.unwrap_err())

    val proof: [u8] = [115u8, 105u8, 109u8, 112u8, 108u8, 101u8, 111u8, 115u8, 45u8, 117u8, 112u8, 50u8, 45u8, 110u8, 118u8, 109u8, 101u8]
    val proof_write = _up2_write_fat32_proof(partition_dev, fat_plan.unwrap(), proof)
    if proof_write.is_err():
        return Err(proof_write.unwrap_err())
    g_up2_nvme_partition_first_lba = partition.first_lba
    g_up2_nvme_partition_lba_count = partition_count
    val verified = up2_nvme_verify_proof()
    if verified.is_err():
        g_up2_nvme_partition_first_lba = 0u64
        g_up2_nvme_partition_lba_count = 0u64
        return Err(verified.unwrap_err())
    Ok("partition=1 filesystem=fat32 label=SIMPLEOS mount=/nvme write=/nvme/proof.txt format_flush=pass data_flush=pass durable_remount=1 read_after_remount_match=1")

fn up2_nvme_verify_proof() -> Result<text, text>:
    if g_up2_nvme_device == nil or g_up2_nvme_partition_lba_count == 0u64:
        return Err("up2-nvme-not-mounted")
    val device = g_up2_nvme_device.unwrap()
    val adapter_result = _up2_nvme_adapter(device, g_up2_nvme_partition_first_lba, g_up2_nvme_partition_lba_count)
    if adapter_result.is_err():
        return Err(adapter_result.unwrap_err())
    val adapter = adapter_result.unwrap()
    val dev: BlockDevice = adapter
    val plan = fat32_format_plan(device.lba_size, g_up2_nvme_partition_lba_count, 1u32)
    if plan.is_err():
        return Err(plan.unwrap_err())
    val fat = plan.unwrap()
    val boot = dev.read_sector(0u64)
    if boot.is_err() or boot.unwrap()[510] != 0x55u8 or boot.unwrap()[511] != 0xaau8:
        return Err("up2-nvme-mount-boot-signature")
    val root = dev.read_sector(fat.data_start_lba)
    if root.is_err() or root.unwrap()[0] != 80u8 or root.unwrap()[8] != 84u8:
        return Err("up2-nvme-proof-directory-entry")
    val data = dev.read_sector(fat.data_start_lba + fat.sectors_per_cluster.to_u64())
    val proof: [u8] = [115u8, 105u8, 109u8, 112u8, 108u8, 101u8, 111u8, 115u8, 45u8, 117u8, 112u8, 50u8, 45u8, 110u8, 118u8, 109u8, 101u8]
    if data.is_err():
        return Err("up2-nvme-proof-read")
    var index: i64 = 0
    while index < proof.len():
        if data.unwrap()[index] != proof[index]:
            return Err("up2-nvme-proof-readback-mismatch")
        index = index + 1
    Ok("/nvme/proof.txt")

