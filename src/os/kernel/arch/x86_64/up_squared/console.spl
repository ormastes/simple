# Interactive first-light console. The low-level provider is selected by the
# x86 board runtime; legacy COM1 remains a candidate until live CN16 evidence.

use os.kernel.arch.x86_64.up_squared.vfs.{up2_vfs_readdir}
use os.kernel.arch.x86_64.up_squared.gdb_rsp_uart.{up2_gdb_rsp_uart_main}

extern fn serial_println(msg: text)
extern fn rt_serial_readline() -> text

fn _up2_print_root():
    val entries = up2_vfs_readdir("/")
    for entry in entries:
        serial_println("/" + entry.name)

fn up2_serial_shell_main():
    while true:
        serial_println("simpleos:/$ ")
        val command = rt_serial_readline()
        if command == "ls" or command == "ls /":
            serial_println("UP2 ls-begin source=vfs command=ls /")
            _up2_print_root()
            serial_println("UP2 ls-end status=pass")
        elif command == "help":
            serial_println("commands: ls /, gdb, help")
        elif command == "gdb":
            serial_println("UP2 gdb-rsp-ready range=0x0a000000+0x01000000 max=1024")
            up2_gdb_rsp_uart_main()
            serial_println("UP2 gdb-rsp-detached")
        elif command != "":
            serial_println("command-not-found")

export up2_serial_shell_main
