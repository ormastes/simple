# x86_64 Scheduler Dispatch Owner
#
# This is the scheduler-facing half of the timer handoff.  It consumes the
# saved context supplied by a future x86 ISR, advances the real Scheduler,
# and returns the selected context plus a validated CR3 decision.  The module
# deliberately does not install an IDT entry, execute `mov cr3`, or return via
# `iretq`: those operations remain an architecture/assembly owner until a
# real ISR frame and per-task kernel-stack path exist.

use os.kernel.arch.x86_64.scheduler_dispatch_contract.{
    X86SchedulerTaskMetadata,
    X86SchedulerDispatchDecision,
    x86_scheduler_task_metadata,
    x86_scheduler_dispatch_request,
    x86_scheduler_dispatch_decide
}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.types.task_types.{TaskContext, TaskId}

pub struct X86SchedulerTimerDispatch:
    """Result owned by the kernel dispatcher until an ISR consumes it.

    Scheduler and IPC are returned together so a caller cannot accidentally
    keep a pre-tick scheduler beside the post-tick IPC owner.  `context` is
    present only for an accepted decision and is still data, not a hardware
    transfer of control.
    """
    scheduler: Scheduler
    ipc: IpcManager
    accepted: bool
    reason: text
    decision: X86SchedulerDispatchDecision
    context: TaskContext?

fn _reject(
    scheduler: Scheduler,
    ipc: IpcManager,
    reason: text
) -> X86SchedulerTimerDispatch:
    X86SchedulerTimerDispatch(
        scheduler: scheduler,
        ipc: ipc,
        accepted: false,
        reason: reason,
        decision: X86SchedulerDispatchDecision(
            accepted: false,
            reason: reason,
            task_id: 0u64,
            cr3: 0u64,
            cr3_switch: false
        ),
        context: nil
    )

fn _task_metadata(
    scheduler: Scheduler,
    task_id: TaskId
) -> X86SchedulerTaskMetadata?:
    val tcb = scheduler.get_task(task_id)
    if tcb == nil:
        return nil
    val task = tcb
    Some(x86_scheduler_task_metadata(task.id.id, task.address_space, task.state))

pub fn x86_scheduler_timer_tick_dispatch(
    scheduler: Scheduler,
    ipc: IpcManager,
    saved_context: TaskContext
) -> X86SchedulerTimerDispatch:
    """Advance scheduler state and prepare one x86 timer handoff.

    The current task is captured before `Scheduler.timer_tick` mutates the
    scheduler.  The returned scheduler is therefore the authoritative owner
    after the tick, while the returned IPC manager remains the same owner.
    Any missing/invalid task metadata rejects before hardware-facing data is
    exposed.  A later ISR bridge may consume `decision` and `context` only
    after it supplies the real saved frame and CR3/return assembly.
    """
    var live_scheduler = scheduler
    val saved_id = live_scheduler.get_current()
    val saved_metadata = _task_metadata(live_scheduler, saved_id)
    if saved_metadata == nil:
        return _reject(live_scheduler, ipc, "saved_task_missing")

    val saved = saved_metadata.unwrap()
    val next_context = live_scheduler.timer_tick(saved_context)
    val next_id = live_scheduler.get_current()
    val next_metadata = _task_metadata(live_scheduler, next_id)
    if next_metadata == nil:
        return _reject(live_scheduler, ipc, "next_task_missing")

    val request = x86_scheduler_dispatch_request(
        true,
        saved,
        next_metadata.unwrap()
    )
    val decision = x86_scheduler_dispatch_decide(request)
    if not decision.accepted:
        return X86SchedulerTimerDispatch(
            scheduler: live_scheduler,
            ipc: ipc,
            accepted: false,
            reason: decision.reason,
            decision: decision,
            context: nil
        )

    X86SchedulerTimerDispatch(
        scheduler: live_scheduler,
        ipc: ipc,
        accepted: true,
        reason: "accepted",
        decision: decision,
        context: Some(next_context)
    )

export X86SchedulerTimerDispatch
export x86_scheduler_timer_tick_dispatch
