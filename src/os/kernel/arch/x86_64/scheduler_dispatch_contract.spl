# x86_64 Scheduler Dispatch Contract
#
# Pure scheduler-facing validation for the future timer ISR bridge.  This
# module deliberately does not import the interrupt path, context-switch
# assembly, or address-space switch implementation.  It only decides whether
# a saved/next task pair is safe for that bridge to consume.

use os.kernel.types.task_types.{TaskState}

pub struct X86SchedulerTaskMetadata:
    """Minimal task identity/state needed by the x86 dispatch boundary."""
    task_id: u64
    cr3: u64
    state: TaskState

pub struct X86SchedulerDispatchRequest:
    """Snapshot supplied by a timer handoff before the ISR bridge runs."""
    timer_handoff: bool
    saved: X86SchedulerTaskMetadata
    next: X86SchedulerTaskMetadata

pub struct X86SchedulerDispatchDecision:
    """Fail-closed result consumed by the future x86 ISR bridge.

    Rejected results intentionally carry no target task or CR3.  The bridge
    must treat `accepted=false` as "do not restore or switch".
    """
    accepted: bool
    reason: text
    task_id: u64
    cr3: u64
    cr3_switch: bool

pub fn x86_scheduler_task_metadata(task_id: u64, cr3: u64, state: TaskState) -> X86SchedulerTaskMetadata:
    """Build the immutable metadata snapshot used by dispatch validation."""
    X86SchedulerTaskMetadata(task_id: task_id, cr3: cr3, state: state)

pub fn x86_scheduler_dispatch_request(timer_handoff: bool, saved: X86SchedulerTaskMetadata, next: X86SchedulerTaskMetadata) -> X86SchedulerDispatchRequest:
    """Build one timer handoff request without touching scheduler state."""
    X86SchedulerDispatchRequest(timer_handoff: timer_handoff, saved: saved, next: next)

fn x86_scheduler_dispatch_reject(reason: text) -> X86SchedulerDispatchDecision:
    X86SchedulerDispatchDecision(
        accepted: false,
        reason: reason,
        task_id: 0u64,
        cr3: 0u64,
        cr3_switch: false
    )

pub fn x86_scheduler_dispatch_decide(request: X86SchedulerDispatchRequest) -> X86SchedulerDispatchDecision:
    """Validate a timer handoff before the architecture bridge consumes it.

    The contract is intentionally narrow and fail closed:
      * the request must be explicitly identified as a timer handoff;
      * both task identities and both CR3 roots must be nonzero;
      * the saved pre-tick snapshot must be running and the task selected by
        `Scheduler.timer_tick` must be running in the post-tick scheduler;
      * both address-space roots must be valid. A same-address-space task
        handoff remains valid and deliberately skips the CR3 write.

    No scheduler or hardware state is mutated.  Rejection always returns a
    neutral target (`task_id=0`, `cr3=0`, and `cr3_switch=false`).
    """
    if not request.timer_handoff:
        return x86_scheduler_dispatch_reject("timer_handoff_missing")
    if request.saved.task_id == 0u64:
        return x86_scheduler_dispatch_reject("saved_task_invalid")
    if request.next.task_id == 0u64:
        return x86_scheduler_dispatch_reject("next_task_invalid")

    val saved_is_running = match request.saved.state:
        case TaskState.Running: true
        case _: false
    if not saved_is_running:
        return x86_scheduler_dispatch_reject("saved_task_not_running")

    val next_is_running = match request.next.state:
        case TaskState.Running: true
        case _: false
    if not next_is_running:
        return x86_scheduler_dispatch_reject("next_task_not_running")

    if request.saved.cr3 == 0u64:
        return x86_scheduler_dispatch_reject("saved_cr3_invalid")
    if request.next.cr3 == 0u64:
        return x86_scheduler_dispatch_reject("next_cr3_invalid")
    X86SchedulerDispatchDecision(
        accepted: true,
        reason: "accepted",
        task_id: request.next.task_id,
        cr3: request.next.cr3,
        cr3_switch: request.saved.cr3 != request.next.cr3
    )
