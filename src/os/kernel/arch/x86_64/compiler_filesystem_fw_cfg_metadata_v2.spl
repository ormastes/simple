# x86_64 QEMU fw_cfg source for compiler-filesystem launch metadata.
#
# This module only acquires the four architecture transport values. Semantic
# validation and admission belong to the common metadata collector.

use os.kernel.fw_cfg.read_result_v1.{SimpleOsFwCfgReadV1}
use os.kernel.fw_cfg.x86_64_named_reader_v1.{x86_64_fw_cfg_read_named_v1}
use os.port.init.compiler_filesystem_metadata_v2.{
    SimpleOsCfsRawReadV2,
    SimpleOsCfsMetadataReadsV2,
    SimpleOsCfsMetadataResultV2,
    simpleos_cfs_nonce_max_bytes_v2,
    simpleos_cfs_image_path_max_bytes_v2,
    simpleos_cfs_image_sha256_max_bytes_v2,
    simpleos_cfs_drive_arg_max_bytes_v2,
    simpleos_cfs_collect_metadata_v2,
}

fn _x86_64_cfs_raw_read_v2(
    read: SimpleOsFwCfgReadV1,
) -> SimpleOsCfsRawReadV2:
    SimpleOsCfsRawReadV2(ok: read.ok, bytes: read.bytes, reason: read.reason)

pub fn x86_64_compiler_filesystem_fw_cfg_metadata_with_reader_v2(
    reader: fn(text, u64) -> SimpleOsFwCfgReadV1,
) -> SimpleOsCfsMetadataReadsV2:
    """Acquire the closed metadata set through an injected bounded reader."""
    SimpleOsCfsMetadataReadsV2(
        nonce: _x86_64_cfs_raw_read_v2(reader(
            "opt/simpleos.cfs.nonce", simpleos_cfs_nonce_max_bytes_v2())),
        image_path: _x86_64_cfs_raw_read_v2(reader(
            "opt/simpleos.cfs.image_path", simpleos_cfs_image_path_max_bytes_v2())),
        image_sha256: _x86_64_cfs_raw_read_v2(reader(
            "opt/simpleos.cfs.image_sha256", simpleos_cfs_image_sha256_max_bytes_v2())),
        drive_arg: _x86_64_cfs_raw_read_v2(reader(
            "opt/simpleos.cfs.drive_arg", simpleos_cfs_drive_arg_max_bytes_v2())),
    )

pub fn x86_64_compiler_filesystem_fw_cfg_metadata_v2(
) -> SimpleOsCfsMetadataReadsV2:
    """Read the four compiler-filesystem values from x86_64 QEMU fw_cfg."""
    x86_64_compiler_filesystem_fw_cfg_metadata_with_reader_v2(
        x86_64_fw_cfg_read_named_v1
    )

pub fn x86_64_compiler_filesystem_metadata_source_v2(
) -> SimpleOsCfsMetadataResultV2:
    """Read and validate x86_64 compiler-filesystem launch metadata."""
    simpleos_cfs_collect_metadata_v2(
        x86_64_compiler_filesystem_fw_cfg_metadata_v2())

export x86_64_compiler_filesystem_fw_cfg_metadata_with_reader_v2
export x86_64_compiler_filesystem_fw_cfg_metadata_v2
export x86_64_compiler_filesystem_metadata_source_v2
