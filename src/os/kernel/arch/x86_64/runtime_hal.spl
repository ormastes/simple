@runtime_intrinsics
# x86_64 privileged runtime boundary.
#
# This is the sole x86_64 owner of raw CR3 declarations; raw port-I/O is owned
# by os.kernel.arch.x86.port_io_owner and consumed from there. Product
# modules consume the typed hal_* facade so ABI widths cannot drift locally.


extern fn rt_read_cr3() -> u64
extern fn rt_write_cr3(value: u64)
extern fn rt_read_cr3_raw() -> u64
extern fn rt_write_cr3_raw(value: u64)
use os.kernel.arch.x86.port_io_owner.{
    x86_port_inb,
    x86_port_outb,
    x86_port_inw,
    x86_port_outw,
    x86_port_inl,
    x86_port_outl,
    x86_port_io_wait,
}

fn hal_x86_64_port_inb(port: u16) -> u8: x86_port_inb(port)
fn hal_x86_64_port_outb(port: u16, value: u8): x86_port_outb(port, value)
fn hal_x86_64_port_inw(port: u16) -> u16: x86_port_inw(port)
fn hal_x86_64_port_outw(port: u16, value: u16): x86_port_outw(port, value)
fn hal_x86_64_port_inl(port: u16) -> u32: x86_port_inl(port)
fn hal_x86_64_port_outl(port: u16, value: u32): x86_port_outl(port, value)
fn hal_x86_64_port_io_wait(): x86_port_io_wait()
fn hal_x86_64_read_cr3() -> u64: rt_read_cr3()
fn hal_x86_64_write_cr3(value: u64): rt_write_cr3(value)
fn hal_x86_64_read_cr3_raw() -> u64: rt_read_cr3_raw()
fn hal_x86_64_write_cr3_raw(value: u64): rt_write_cr3_raw(value)
fn hal_x86_64_cr3_width_bits() -> u32: 64
fn hal_x86_64_cr3_available() -> bool: true

export hal_x86_64_port_inb, hal_x86_64_port_outb, hal_x86_64_port_inw, hal_x86_64_port_outw
export hal_x86_64_port_inl, hal_x86_64_port_outl, hal_x86_64_port_io_wait
export hal_x86_64_read_cr3, hal_x86_64_write_cr3
export hal_x86_64_read_cr3_raw, hal_x86_64_write_cr3_raw
export hal_x86_64_cr3_width_bits, hal_x86_64_cr3_available
