# Shared x86 port-I/O runtime owner.
#
# Keep the raw runtime boundary in this architecture-light leaf. Consumers use
# the typed inline wrappers below so port operations remain direct, O(1), and
# allocation-free after lowering.

extern fn rt_port_inb(port: u16) -> u8
extern fn rt_port_outb(port: u16, value: u8)
extern fn rt_port_inw(port: u16) -> u16
extern fn rt_port_outw(port: u16, value: u16)
extern fn rt_port_inl(port: u16) -> u32
extern fn rt_port_outl(port: u16, value: u32)
extern fn rt_port_io_wait()

@inline
pub fn x86_port_inb(port: u16) -> u8:
    rt_port_inb(port)

@inline
pub fn x86_port_outb(port: u16, value: u8):
    rt_port_outb(port, value)

@inline
pub fn x86_port_inw(port: u16) -> u16:
    rt_port_inw(port)

@inline
pub fn x86_port_outw(port: u16, value: u16):
    rt_port_outw(port, value)

@inline
pub fn x86_port_inl(port: u16) -> u32:
    rt_port_inl(port)

@inline
pub fn x86_port_outl(port: u16, value: u32):
    rt_port_outl(port, value)

@inline
pub fn x86_port_io_wait():
    rt_port_io_wait()
