# ARM32 kernel runtime shims (pure Simple).
#
# The last arm32 kernel-link entry points no other arm32 shim module defines
# (examples/09_embedded/simple_os/arch/arm32/os_entry.spl closure).
# Signatures match the callers' externs: multicore_green.spl declares
# rt_pool_safepoint() -> i64; sandbox_boot_apply.spl declares the sandbox
# bounds -> u64.

# No worker pool on this image: nothing to park at.
@cfg(arm32)
@export("C")
fn rt_pool_safepoint() -> i64:
    0

# The arm32 linker script has no .simple.sandbox section, so both bounds are
# 0 and the validation gate in sandbox_boot_apply.spl short-circuits (same
# contract as the riscv64 weak __simple_sandbox_start/end symbols when the
# section is absent).
@cfg(arm32)
@export("C")
fn rt_simple_sandbox_section_start() -> u64:
    0

@cfg(arm32)
@export("C")
fn rt_simple_sandbox_section_end() -> u64:
    0
