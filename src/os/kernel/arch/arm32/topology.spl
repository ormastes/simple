"""ARM32 firmware DTB topology publication.

The assembly entry preserves r2 after BSS initialization.  Split 16-bit
accessors keep the tagged freestanding ABI from truncating a physical address.
Publication is one-shot and fails closed; boot itself may continue without an
identity table, but CPU readers then return the shared unresolved sentinel.
"""

use os.kernel.arch.arm32.cpu.{arm32_current_mpidr_v1}
use os.kernel.arch.arm_shared.topology_identity.{
    arm_publish_firmware_mpidr_census_v1,
}
use os.kernel.boot.dtb_parser.{parse_dtb_cpu_mpidr_census}
use os.kernel.smp.cpu_identity_runtime_surface_v1.{
    cpu_identity_runtime_is_published_v1,
    cpu_identity_runtime_resolve_v1,
}
use os.kernel.smp.cpu_topology_identity_owner_v1.{
    CpuHardwareIdentityKindV1,
    cpu_hardware_identity_canonical_v1,
}

@unsafe(reason: "reads a split boot-global DTB address from an unsigned target provider", capabilities: [ffi])
extern fn rt_arm32_boot_dtb_low16() -> u32
@unsafe(reason: "reads a split boot-global DTB address from an unsigned target provider", capabilities: [ffi])
extern fn rt_arm32_boot_dtb_high16() -> u32

@unsafe(reason: "reconstructs an unadmitted physical DTB address from two foreign reads", capabilities: [ffi])
pub fn arm32_boot_dtb_address_v1() -> u64:
    val raw = unsafe(capabilities: [ffi]):
        (rt_arm32_boot_dtb_high16() << 16) |
            rt_arm32_boot_dtb_low16()
    raw as u64

@unsafe(reason: "parses and publishes topology from an unsigned foreign physical DTB address", capabilities: [ffi])
pub fn arm32_publish_boot_mpidr_topology_v1() -> bool:
    """Publish the exact enabled DTB CPU census before runtime readers."""
    val current = arm32_current_mpidr_v1()
    if cpu_identity_runtime_is_published_v1():
        return cpu_identity_runtime_resolve_v1(
            CpuHardwareIdentityKindV1.ArmMpidr, current) != nil
    val census = unsafe(capabilities: [ffi]):
        parse_dtb_cpu_mpidr_census(arm32_boot_dtb_address_v1())
    if not census.valid:
        return false
    val header_boot = cpu_hardware_identity_canonical_v1(
        CpuHardwareIdentityKindV1.ArmMpidr, census.boot_cpuid as u64)
    if header_boot != cpu_hardware_identity_canonical_v1(
        CpuHardwareIdentityKindV1.ArmMpidr, current):
        return false
    arm_publish_firmware_mpidr_census_v1(
        census.mpidrs, current)
