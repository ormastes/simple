# ARM32 kernel runtime value shims (pure Simple).
#
# Codegen-called runtime entry points the arm32 kernel closure references but
# no arm32 runtime defines. Layouts are those of
# examples/09_embedded/simple_os/arch/arm32/boot/baremetal_stubs.c:
#   tags: INT=0 HEAP=1 FLOAT=2 SPECIAL=3; NIL=3 TRUE=11 FALSE=19; int = v << 3
#   HeapHeader {u32 type; u32 size}; HEAP_ARRAY=2, HEAP_ENUM=7
#   RuntimeArray {HeapHeader 8; u32 len @8; u32 cap @12; items[] @16 (4 bytes)}
#   RuntimeEnum  {HeapHeader 8; u32 enum_id @8; u32 discriminant @12; payload @16}
# ABI: on a 32-bit target the LLVM backend makes every RuntimeValue an i32
# (codegen/llvm/backend_core.rs runtime_int_type), so `i64` below is a 32-bit
# carrier, exactly as in src/os/kernel/arch/riscv32/core_runtime.spl.
# Bodies are integer-only (no text literals / arrays / untyped compares) so they
# emit no further rt_* references. Exports never call each other: they delegate
# to the private _a32_* helpers.
#
# Known limits (arm32 has no wide-int heap kind, nor a C string-to-int):
#   - rt_value_u64 keeps the low 29 bits (tag-int), like riscv32.
#   - rt_any_to_int passes strings / floats / heap handles through unchanged.
#   - rt_unwrap_or_trap cannot print (no serial dependency); it spins on a
#     volatile read forever, which the optimiser cannot remove.
# arm64 twin: src/os/kernel/arch/arm64/runtime_value_shims.spl.

@cfg(arm32)
extern fn rt_mmio_read_u32(addr: i64) -> i64

val A32_OPTION_ENUM_ID: i64 = 1
# FNV-style variant hashes (u32 values as signed i32 carriers).
val A32_HASH_SOME: i64 = -241667751
val A32_HASH_NONE: i64 = -1923218599
val A32_HASH_OK: i64 = -1889615284
val A32_HASH_ERR: i64 = -94788272

@cfg(arm32)
fn _a32_enum_ptr(v: i64) -> i64:
    if (v & 7) != 1:
        return 0
    val p = v - 1
    if p < 4096:
        return 0
    if rt_mmio_read_u32(p) != 7:
        return 0
    p

@cfg(arm32)
fn _a32_array_ptr(v: i64) -> i64:
    if (v & 7) != 1:
        return 0
    val p = v - 1
    if p < 4096:
        return 0
    if rt_mmio_read_u32(p) != 2:
        return 0
    p

@cfg(arm32)
fn _a32_truthy(v: i64) -> i64:
    val tag = v & 7
    if tag == 3:
        if v == 11:
            return 1
        return 0
    if tag == 0:
        if (v >> 3) != 0:
            return 1
        return 0
    if tag == 2:
        # +0.0 and -0.0 are falsy: all bits except sign (and the tag) clear.
        if ((v & (0 - 8)) << 1) != 0:
            return 1
        return 0
    if (v & (0 - 8)) != 0:
        return 1
    0

@cfg(arm32)
fn _a32_is_none(v: i64) -> i64:
    if v == 3:
        return 1
    val p = _a32_enum_ptr(v)
    if p == 0:
        return 0
    if rt_mmio_read_u32(p + 16) == 3:
        return 1
    0

@cfg(arm32)
fn _a32_trap() -> i64:
    var sink: i64 = 0
    while true:
        sink = sink + rt_mmio_read_u32(4096)
    sink

@cfg(arm32)
@export("C")
fn rt_for_iterable(v: i64) -> i64:
    v

@cfg(arm32)
@export("C")
fn rt_value_truthy(v: i64) -> i8:
    if _a32_truthy(v) != 0:
        return 1
    0

@cfg(arm32)
@export("C")
fn rt_any_to_int(v: i64) -> i64:
    if (v & 7) == 0:
        return v >> 3
    if v == 11:
        return 1
    if v == 19:
        return 0
    v

@cfg(arm32)
@export("C")
fn rt_value_u64(bits: i64) -> i64:
    bits << 3

@cfg(arm32)
@export("C")
fn rt_value_as_u64(v: i64) -> i64:
    if (v & 7) == 0:
        return (v >> 3) & 0x1fffffff
    v

@cfg(arm32)
@export("C")
fn rt_enum_id(v: i64) -> i64:
    val p = _a32_enum_ptr(v)
    if p == 0:
        return 0 - 1
    rt_mmio_read_u32(p + 8)

@cfg(arm32)
@export("C")
fn rt_enum_check_variant(v: i64, enum_id: i64, disc: i64) -> i8:
    val p = _a32_enum_ptr(v)
    if p == 0:
        return 0
    if rt_mmio_read_u32(p + 12) != disc:
        return 0
    # ID zero is the legacy untyped enum lane (including Result).
    val id = rt_mmio_read_u32(p + 8)
    if enum_id == 0 or id == 0 or id == enum_id:
        return 1
    0

@cfg(arm32)
@export("C")
fn rt_is_present(v: i64) -> i8:
    if _a32_is_none(v) != 0:
        return 0
    1

@cfg(arm32)
@export("C")
fn rt_unwrap_or_trap(v: i64) -> i64:
    val p = _a32_enum_ptr(v)
    if p == 0:
        return v
    val id = rt_mmio_read_u32(p + 8)
    val disc = rt_mmio_read_u32(p + 12)
    if id == A32_OPTION_ENUM_ID:
        if disc == 0 or disc == A32_HASH_SOME:
            return rt_mmio_read_u32(p + 16)
        if disc == 1 or disc == A32_HASH_NONE:
            return _a32_trap()
        return v
    if disc == A32_HASH_OK:
        return rt_mmio_read_u32(p + 16)
    if disc == A32_HASH_ERR:
        return _a32_trap()
    v

@cfg(arm32)
@export("C")
fn rt_numeric_contains_u64(array: i64, value: i64) -> i8:
    # Needle is raw (codegen contract); items are mixed raw / ENCODE_INT.
    val p = _a32_array_ptr(array)
    if p == 0:
        return 0
    val n = rt_mmio_read_u32(p + 8)
    var i: i64 = 0
    while i < n:
        val item = rt_mmio_read_u32(p + 16 + i * 4)
        if item == value or ((item & 7) == 0 and (item >> 3) == value):
            return 1
        i = i + 1
    0
