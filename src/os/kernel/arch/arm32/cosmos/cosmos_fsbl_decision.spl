# Scalar-only, allocation-free Cosmos+ FSBL handoff decision owner.

val COSMOS_FSBL_SLCR_LOCKED: u32 = 1u32
val COSMOS_FSBL_ARM_CLK_ACTIVE: u32 = 0x1f000000u32
val COSMOS_FSBL_DDR_CLK_ACTIVE: u32 = 3u32
val COSMOS_FSBL_PSS_PRIMARY_RESET: u32 = 1u32
val COSMOS_FSBL_A9_CPU0_STOPPED: u32 = 0x111u32
val COSMOS_FSBL_PCFG_DONE: u32 = 4u32

pub fn cosmos_fsbl_handoff_valid_registers(
    locksta: u32,
    arm_clk: u32,
    ddr_clk: u32,
    pss_rst: u32,
    a9_rst: u32,
    devcfg_int_sts: u32
) -> bool:
    if (locksta & COSMOS_FSBL_SLCR_LOCKED) == 0u32:
        return false
    if (arm_clk & COSMOS_FSBL_ARM_CLK_ACTIVE) != COSMOS_FSBL_ARM_CLK_ACTIVE:
        return false
    if (ddr_clk & COSMOS_FSBL_DDR_CLK_ACTIVE) != COSMOS_FSBL_DDR_CLK_ACTIVE:
        return false
    if (pss_rst & COSMOS_FSBL_PSS_PRIMARY_RESET) != 0u32:
        return false
    if (a9_rst & COSMOS_FSBL_A9_CPU0_STOPPED) != 0u32:
        return false
    if (devcfg_int_sts & COSMOS_FSBL_PCFG_DONE) == 0u32:
        return false
    true
