# Pure-Simple NVMe I/O and FTL-media policy for Cosmos+.
#
# Pointer-shaped ABI storage, DMA/MMIO, callback invocation, byte codecs, and
# the single-flight atomic remain in C.  These exports own deterministic scalar
# validation, status mapping, retry, routing, and page-transition decisions.
# Every C export is allocation-free.

val COSMOS_OK: i32 = 0
val COSMOS_UNAVAILABLE: i32 = 1
val COSMOS_INVALID: i32 = 2
val COSMOS_HW_ERROR: i32 = 4
val COSMOS_RETRY: i32 = 5
val COSMOS_COMPLETION_UNCERTAIN: i32 = 6

val SCT_GENERIC: u32 = 0u32
val SCT_MEDIA: u32 = 2u32
val SC_SUCCESS: u32 = 0x00u32
val SC_INVALID_OPCODE: u32 = 0x01u32
val SC_INVALID_FIELD: u32 = 0x02u32
val SC_DATA_TRANSFER_ERROR: u32 = 0x04u32
val SC_INTERNAL_DEVICE_ERROR: u32 = 0x06u32
val SC_INVALID_NAMESPACE: u32 = 0x0Bu32
val SC_LBA_RANGE: u32 = 0x80u32
val SC_NAMESPACE_NOT_READY: u32 = 0x82u32

val NAMESPACE_ID: u32 = 1u32
val MAX_CID: u32 = 0xFFFFu32
val MAX_NLB: u32 = 0xFFFFu32
val MAX_DSM_RANGES: u32 = 256u32
val DSM_RANGE_BYTES: u32 = 16u32
val DMA_ALIGNMENT: u32 = 4u32
val RW_CONTROL_MASK: u32 = 0xC0000000u32
val ZEROES_CONTROL_MASK: u32 = 0xC2000000u32
val DSM_DEALLOCATE: u32 = 4u32
val DSM_ATTRIBUTE_MASK: u32 = 7u32

val POST_COMMITTED: u32 = 0u32
val POST_RETRY: u32 = 1u32
val POST_AMBIGUOUS: u32 = 2u32
val COMPLETION_NONE: u32 = 0u32
val COMPLETION_RETRY: u32 = 1u32
val COMPLETION_BLOCKED: u32 = 2u32

val MAX_IO_QUEUES: u32 = 4u32
val PAGE_LBAS: u32 = 4u32
val MAX_MEDIA_LBAS: u32 = 256u32
val BLOCK_BYTES: u32 = 4096u32
val PAGE_DATA_BYTES: u32 = 16384u32
val PAGE_SPARE_BYTES: u32 = 256u32
val DMA_SLOT_MASK: u32 = 0x7Fu32
val DEFAULT_RETRIES: u32 = 3u32

val PAGE_FULL_WRITE: u32 = 0u32
val PAGE_READ_MAPPED: u32 = 1u32
val PAGE_ZERO_UNMAPPED: u32 = 2u32
val PAGE_PROPAGATE: u32 = 3u32

fn _status(sct: u32, sc: u32, dnr: u32) -> u32:
    (dnr << 16u32) | (sct << 8u32) | sc

@export("C", name: "cosmos_nvme_media_policy_status_success")
pub fn cosmos_nvme_media_policy_status_success() -> u32:
    _status(SCT_GENERIC, SC_SUCCESS, 0u32)

@export("C", name: "cosmos_nvme_media_policy_status_invalid_opcode")
pub fn cosmos_nvme_media_policy_status_invalid_opcode() -> u32:
    _status(SCT_GENERIC, SC_INVALID_OPCODE, 1u32)

@export("C", name: "cosmos_nvme_media_policy_status_invalid_field")
pub fn cosmos_nvme_media_policy_status_invalid_field() -> u32:
    _status(SCT_GENERIC, SC_INVALID_FIELD, 1u32)

@export("C", name: "cosmos_nvme_media_policy_status_invalid_namespace")
pub fn cosmos_nvme_media_policy_status_invalid_namespace() -> u32:
    _status(SCT_GENERIC, SC_INVALID_NAMESPACE, 1u32)

@export("C", name: "cosmos_nvme_media_policy_status_lba_range")
pub fn cosmos_nvme_media_policy_status_lba_range() -> u32:
    _status(SCT_GENERIC, SC_LBA_RANGE, 1u32)

@export("C", name: "cosmos_nvme_media_policy_status_data_transfer")
pub fn cosmos_nvme_media_policy_status_data_transfer() -> u32:
    _status(SCT_GENERIC, SC_DATA_TRANSFER_ERROR, 1u32)

@export("C", name: "cosmos_nvme_media_policy_status_is_success")
pub fn cosmos_nvme_media_policy_status_is_success(encoded: u32) -> i32:
    # @decision status_success_match
    if encoded == cosmos_nvme_media_policy_status_success(): 1 else: 0

@export("C", name: "cosmos_nvme_media_policy_media_status")
pub fn cosmos_nvme_media_policy_media_status(result: i32, media_sc: u32) -> u32:
    # @decision media_result_ok
    if result == COSMOS_OK:
        return cosmos_nvme_media_policy_status_success()
    # @decision media_result_unavailable
    if result == COSMOS_UNAVAILABLE:
        return _status(SCT_GENERIC, SC_NAMESPACE_NOT_READY, 0u32)
    # @decision media_result_media_error
    if result == 3 or result == COSMOS_HW_ERROR:
        return _status(SCT_MEDIA, media_sc, 0u32)
    _status(SCT_GENERIC, SC_INTERNAL_DEVICE_ERROR, 0u32)

@export("C", name: "cosmos_nvme_media_policy_end_within_namespace")
pub fn cosmos_nvme_media_policy_end_within_namespace(
    namespace_low: u32, namespace_high: u32,
    lba_low: u32, lba_high: u32, block_count: u32
) -> i32:
    val end_low = lba_low + block_count
    # @decision namespace_low_add_carry
    val carry = if end_low < lba_low: 1u32 else: 0u32
    val end_high = lba_high + carry
    # @decision namespace_high_overflow
    if end_high < lba_high:
        return 0
    # @decision namespace_high_differs
    if end_high != namespace_high:
        # @decision namespace_high_before_limit
        return if end_high < namespace_high: 1 else: 0
    # @decision namespace_end_low_within
    if end_low <= namespace_low: 1 else: 0

@export("C", name: "cosmos_nvme_media_policy_data_span_valid")
pub fn cosmos_nvme_media_policy_data_span_valid(
    address_low: u32, address_high: u32,
    address2_low: u32, address2_high: u32,
    data_bytes: u32, required_bytes: u32
) -> i32:
    # @decision data_primary_missing
    if address_low == 0u32 and address_high == 0u32:
        return 0
    # @decision data_primary_misaligned
    if (address_low & (DMA_ALIGNMENT - 1u32)) != 0u32:
        return 0
    val second_present = address2_low != 0u32 or address2_high != 0u32
    # @decision data_second_misaligned
    if second_present and (address2_low & (DMA_ALIGNMENT - 1u32)) != 0u32:
        return 0
    # @decision data_length_exact
    if data_bytes == required_bytes: 1 else: 0

@export("C", name: "cosmos_nvme_media_policy_rw_status")
pub fn cosmos_nvme_media_policy_rw_status(
    cid: u32, namespace_id: u32, lba_low: u32, lba_high: u32,
    nlb: u32, control: u32, address_low: u32, address_high: u32,
    address2_low: u32, address2_high: u32, data_bytes: u32,
    namespace_low: u32, namespace_high: u32, block_bytes: u32
) -> u32:
    # @decision rw_fields_invalid
    if cid > MAX_CID or nlb > MAX_NLB or (control & ~RW_CONTROL_MASK) != 0u32:
        return cosmos_nvme_media_policy_status_invalid_field()
    # @decision rw_namespace_invalid
    if namespace_id != NAMESPACE_ID:
        return cosmos_nvme_media_policy_status_invalid_namespace()
    val count = nlb + 1u32
    # @decision rw_span_invalid
    if cosmos_nvme_media_policy_end_within_namespace(
        namespace_low, namespace_high, lba_low, lba_high, count
    ) == 0:
        return cosmos_nvme_media_policy_status_lba_range()
    # @decision rw_transfer_overflow
    if block_bytes == 0u32 or count > (0xFFFFFFFFu32 / block_bytes):
        return cosmos_nvme_media_policy_status_data_transfer()
    # @decision rw_data_span_invalid
    if cosmos_nvme_media_policy_data_span_valid(
        address_low, address_high, address2_low, address2_high,
        data_bytes, count * block_bytes
    ) == 0:
        return cosmos_nvme_media_policy_status_data_transfer()
    cosmos_nvme_media_policy_status_success()

@export("C", name: "cosmos_nvme_media_policy_flush_status")
pub fn cosmos_nvme_media_policy_flush_status(
    cid: u32, namespace_id: u32, lba_low: u32, lba_high: u32,
    nlb: u32, address_low: u32, address_high: u32,
    address2_low: u32, address2_high: u32, data_bytes: u32
) -> u32:
    # @decision flush_namespace_invalid
    if namespace_id != NAMESPACE_ID:
        return cosmos_nvme_media_policy_status_invalid_namespace()
    # @decision flush_fields_invalid
    if cid > MAX_CID or lba_low != 0u32 or lba_high != 0u32 or nlb != 0u32 or
        address_low != 0u32 or address_high != 0u32 or address2_low != 0u32 or
        address2_high != 0u32 or data_bytes != 0u32:
        return cosmos_nvme_media_policy_status_invalid_field()
    cosmos_nvme_media_policy_status_success()

@export("C", name: "cosmos_nvme_media_policy_zeroes_status")
pub fn cosmos_nvme_media_policy_zeroes_status(
    cid: u32, namespace_id: u32, lba_low: u32, lba_high: u32,
    nlb: u32, control: u32, dataset_attributes: u32,
    dataset_range_count: u32, address_low: u32, address_high: u32,
    address2_low: u32, address2_high: u32, data_bytes: u32,
    namespace_low: u32, namespace_high: u32, callback_present: u32
) -> u32:
    # @decision zeroes_namespace_invalid
    if namespace_id != NAMESPACE_ID:
        return cosmos_nvme_media_policy_status_invalid_namespace()
    # @decision zeroes_fields_invalid
    if cid > MAX_CID or nlb > MAX_NLB or
        (control & ~ZEROES_CONTROL_MASK) != 0u32 or
        dataset_attributes != 0u32 or dataset_range_count != 0u32 or
        address_low != 0u32 or address_high != 0u32 or
        address2_low != 0u32 or address2_high != 0u32 or data_bytes != 0u32:
        return cosmos_nvme_media_policy_status_invalid_field()
    # @decision zeroes_span_invalid
    if cosmos_nvme_media_policy_end_within_namespace(
        namespace_low, namespace_high, lba_low, lba_high, nlb + 1u32
    ) == 0:
        return cosmos_nvme_media_policy_status_lba_range()
    # @decision zeroes_callback_missing
    if callback_present == 0u32:
        return cosmos_nvme_media_policy_status_invalid_opcode()
    cosmos_nvme_media_policy_status_success()

@export("C", name: "cosmos_nvme_media_policy_dsm_status")
pub fn cosmos_nvme_media_policy_dsm_status(
    cid: u32, namespace_id: u32, lba_low: u32, lba_high: u32,
    nlb: u32, control: u32, dataset_attributes: u32,
    dataset_range_count: u32, address_low: u32, address_high: u32,
    address2_low: u32, address2_high: u32, data_bytes: u32,
    callback_present: u32
) -> u32:
    # @decision dsm_namespace_invalid
    if namespace_id != NAMESPACE_ID:
        return cosmos_nvme_media_policy_status_invalid_namespace()
    # @decision dsm_fields_invalid
    if cid > MAX_CID or dataset_range_count == 0u32 or
        dataset_range_count > MAX_DSM_RANGES or
        (dataset_attributes & ~DSM_ATTRIBUTE_MASK) != 0u32 or
        lba_low != 0u32 or lba_high != 0u32 or nlb != 0u32 or control != 0u32:
        return cosmos_nvme_media_policy_status_invalid_field()
    val required = dataset_range_count * DSM_RANGE_BYTES
    # @decision dsm_data_span_invalid
    if cosmos_nvme_media_policy_data_span_valid(
        address_low, address_high, address2_low, address2_high,
        data_bytes, required
    ) == 0:
        return cosmos_nvme_media_policy_status_data_transfer()
    # @decision dsm_deallocate_absent
    if (dataset_attributes & DSM_DEALLOCATE) == 0u32:
        return cosmos_nvme_media_policy_status_success()
    # @decision dsm_callback_missing
    if callback_present == 0u32:
        return cosmos_nvme_media_policy_status_invalid_opcode()
    cosmos_nvme_media_policy_status_success()

@export("C", name: "cosmos_nvme_media_policy_post_state")
pub fn cosmos_nvme_media_policy_post_state(post_result: u32) -> u32:
    # @decision post_state_committed
    if post_result == POST_COMMITTED:
        return COMPLETION_NONE
    # @decision post_state_retry
    if post_result == POST_RETRY:
        return COMPLETION_RETRY
    COMPLETION_BLOCKED

@export("C", name: "cosmos_nvme_media_policy_post_status")
pub fn cosmos_nvme_media_policy_post_status(post_result: u32) -> i32:
    # @decision post_status_committed
    if post_result == POST_COMMITTED:
        return COSMOS_OK
    # @decision post_status_retry
    if post_result == POST_RETRY:
        return COSMOS_RETRY
    # @decision post_status_ambiguous
    if post_result == POST_AMBIGUOUS:
        return COSMOS_COMPLETION_UNCERTAIN
    COSMOS_HW_ERROR

@export("C", name: "cosmos_nvme_media_policy_service_init_valid")
pub fn cosmos_nvme_media_policy_service_init_valid(
    post_present: u32, read_present: u32, program_present: u32,
    flush_present: u32, namespace_low: u32, namespace_high: u32,
    block_bytes: u32
) -> i32:
    # @decision service_callback_missing
    if post_present == 0u32 or read_present == 0u32 or
        program_present == 0u32 or flush_present == 0u32:
        return 0
    # @decision service_namespace_empty
    if namespace_low == 0u32 and namespace_high == 0u32:
        return 0
    # @decision service_block_invalid
    if block_bytes == 0u32 or (block_bytes & (DMA_ALIGNMENT - 1u32)) != 0u32:
        return 0
    1

@export("C", name: "cosmos_nvme_media_policy_dispatch_init_valid")
pub fn cosmos_nvme_media_policy_dispatch_init_valid(
    dispatch_present: u32, bridge_present: u32, io_present: u32,
    admin_present: u32, io_fetch_present: u32, admin_fetch_present: u32
) -> i32:
    # @decision dispatch_init_contract
    if dispatch_present != 0u32 and bridge_present != 0u32 and
        io_present != 0u32 and admin_present != 0u32 and
        io_fetch_present == 0u32 and admin_fetch_present == 0u32: 1 else: 0

@export("C", name: "cosmos_nvme_media_policy_dispatch_queue_status")
pub fn cosmos_nvme_media_policy_dispatch_queue_status(
    queue_id: u32, negotiated_queue_count: u32,
    submission_valid: u32, completion_queue_id: u32,
    completion_valid: u32
) -> i32:
    # @decision dispatch_queue_id_invalid
    if queue_id == 0u32 or queue_id > negotiated_queue_count or
        queue_id > MAX_IO_QUEUES:
        return COSMOS_HW_ERROR
    # @decision dispatch_completion_invalid
    if submission_valid == 0u32 or completion_queue_id == 0u32 or
        completion_queue_id > MAX_IO_QUEUES or completion_valid == 0u32:
        return COSMOS_HW_ERROR
    COSMOS_OK

@export("C", name: "cosmos_nvme_media_policy_u64")
pub fn cosmos_nvme_media_policy_u64(low: u32, high: u32) -> u64:
    ((high as u64) << 32u32) | (low as u64)

@export("C", name: "cosmos_nvme_media_policy_address_set_valid")
pub fn cosmos_nvme_media_policy_address_set_valid(
    data_address: u32, spare_address: u32, completion_address: u32,
    status_report_address: u32, error_info_address: u32
) -> i32:
    # @decision address_set_contract
    if data_address != 0u32 and (data_address & (PAGE_DATA_BYTES - 1u32)) == 0u32 and
        spare_address != 0u32 and (spare_address & (PAGE_SPARE_BYTES - 1u32)) == 0u32 and
        completion_address != 0u32 and (completion_address & 3u32) == 0u32 and
        status_report_address != 0u32 and (status_report_address & 3u32) == 0u32 and
        error_info_address != 0u32 and (error_info_address & 3u32) == 0u32: 1 else: 0

@export("C", name: "cosmos_nvme_media_policy_command_span_status")
pub fn cosmos_nvme_media_policy_command_span_status(
    media_present: u32, command_present: u32, namespace_id: u32,
    data_bytes: u32, slot_tag: u32, lba_low: u32, lba_high: u32,
    namespace_low: u32, namespace_high: u32
) -> i32:
    # @decision command_envelope_invalid
    if media_present == 0u32 or command_present == 0u32 or
        namespace_id != NAMESPACE_ID or data_bytes == 0u32 or
        (data_bytes % BLOCK_BYTES) != 0u32:
        return COSMOS_INVALID
    val count = data_bytes / BLOCK_BYTES
    # @decision command_count_invalid
    if count > MAX_MEDIA_LBAS or slot_tag > DMA_SLOT_MASK:
        return COSMOS_INVALID
    val lba = cosmos_nvme_media_policy_u64(lba_low, lba_high)
    val end_lba = lba + count as u64
    val capacity = cosmos_nvme_media_policy_u64(namespace_low, namespace_high)
    # @decision command_range_invalid
    if end_lba < lba or end_lba > capacity: COSMOS_INVALID else: COSMOS_OK

@export("C", name: "cosmos_nvme_media_policy_zeroes_span_status")
pub fn cosmos_nvme_media_policy_zeroes_span_status(
    media_present: u32, command_present: u32, namespace_id: u32,
    data_bytes: u32, slot_tag: u32, lba_low: u32, lba_high: u32,
    nlb: u32, namespace_low: u32, namespace_high: u32
) -> i32:
    # @decision zeroes_envelope_invalid
    if media_present == 0u32 or command_present == 0u32 or
        namespace_id != NAMESPACE_ID or data_bytes != 0u32:
        return COSMOS_INVALID
    val count = nlb + 1u32
    # @decision zeroes_count_invalid
    if count == 0u32 or count > MAX_MEDIA_LBAS or slot_tag > DMA_SLOT_MASK:
        return COSMOS_INVALID
    val lba = cosmos_nvme_media_policy_u64(lba_low, lba_high)
    val end_lba = lba + count as u64
    val capacity = cosmos_nvme_media_policy_u64(namespace_low, namespace_high)
    # @decision zeroes_range_invalid
    if end_lba < lba or end_lba > capacity: COSMOS_INVALID else: COSMOS_OK

@export("C", name: "cosmos_nvme_media_policy_retry_limit")
pub fn cosmos_nvme_media_policy_retry_limit(configured: u32) -> u32:
    # @decision retry_default
    if configured == 0u32: DEFAULT_RETRIES else: configured

@export("C", name: "cosmos_nvme_media_policy_command_retry_limit")
pub fn cosmos_nvme_media_policy_command_retry_limit(
    control: u32, limited_retry_mask: u32
) -> u32:
    # @decision command_retry_limited
    if (control & limited_retry_mask) != 0u32: 1u32 else: DEFAULT_RETRIES

@export("C", name: "cosmos_nvme_media_policy_begin_status")
pub fn cosmos_nvme_media_policy_begin_status(
    media_present: u32, ftl_present: u32, prior_busy: u32
) -> i32:
    # @decision begin_unavailable
    if media_present == 0u32 or ftl_present == 0u32 or prior_busy != 0u32:
        COSMOS_RETRY
    else:
        COSMOS_OK

@export("C", name: "cosmos_nvme_media_policy_retry_terminal")
pub fn cosmos_nvme_media_policy_retry_terminal(
    status: i32, attempt: u32, limit: u32
) -> i32:
    # @decision retry_terminal
    if status != COSMOS_RETRY or attempt + 1u32 == limit: 1 else: 0

@export("C", name: "cosmos_nvme_media_policy_mapped_read_status")
pub fn cosmos_nvme_media_policy_mapped_read_status(
    status: i32, actual_lpn: u32, expected_lpn: u32
) -> i32:
    # @decision mapped_read_tag_mismatch
    if status == COSMOS_OK and actual_lpn != expected_lpn: COSMOS_HW_ERROR
    else: status

@export("C", name: "cosmos_nvme_media_policy_dma_offsets_valid")
pub fn cosmos_nvme_media_policy_dma_offsets_valid(
    command_offset: u32, device_offset: u32
) -> i32:
    # @decision dma_offsets_valid
    if command_offset <= 255u32 and device_offset < PAGE_LBAS: 1 else: 0

@export("C", name: "cosmos_nvme_media_policy_page_action")
pub fn cosmos_nvme_media_policy_page_action(
    lookup_status: i32, write: u32, page_offset: u32, page_count: u32
) -> u32:
    # @decision page_lookup_propagate
    if lookup_status != COSMOS_OK and lookup_status != COSMOS_UNAVAILABLE:
        return PAGE_PROPAGATE
    # @decision page_full_write
    if write != 0u32 and page_offset == 0u32 and page_count == PAGE_LBAS:
        return PAGE_FULL_WRITE
    # @decision page_read_mapped
    if lookup_status == COSMOS_OK:
        return PAGE_READ_MAPPED
    PAGE_ZERO_UNMAPPED

@export("C", name: "cosmos_nvme_media_policy_page_count")
pub fn cosmos_nvme_media_policy_page_count(
    page_offset: u32, remaining: u32
) -> u32:
    val available = PAGE_LBAS - page_offset
    # @decision page_count_clamps
    if available > remaining: remaining else: available

@export("C", name: "cosmos_nvme_media_policy_dsm_range_valid")
pub fn cosmos_nvme_media_policy_dsm_range_valid(
    attributes: u32, length: u32, starting_lba: u64,
    namespace_low: u32, namespace_high: u32
) -> i32:
    # @decision dsm_range_shape_invalid
    if attributes != 0u32 or length == 0u32:
        return 0
    val end_lba = starting_lba + length as u64
    val capacity = cosmos_nvme_media_policy_u64(namespace_low, namespace_high)
    # @decision dsm_range_bounds_valid
    if end_lba >= starting_lba and end_lba <= capacity: 1 else: 0

@export("C", name: "cosmos_nvme_media_policy_init_valid")
pub fn cosmos_nvme_media_policy_init_valid(
    media_present: u32, ftl_present: u32, data_address: u32,
    spare_address: u32, completion_address: u32,
    status_report_address: u32, error_info_address: u32
) -> i32:
    # @decision init_owner_missing
    if media_present == 0u32 or ftl_present == 0u32:
        return 0
    cosmos_nvme_media_policy_address_set_valid(
        data_address, spare_address, completion_address,
        status_report_address, error_info_address
    )

@export("C", name: "cosmos_nvme_media_policy_deallocate_valid")
pub fn cosmos_nvme_media_policy_deallocate_valid(
    media_present: u32, command_present: u32, namespace_id: u32,
    dataset_attributes: u32, dataset_range_count: u32,
    data_bytes: u32, slot_tag: u32
) -> i32:
    # @decision deallocate_contract
    if media_present == 0u32 or command_present == 0u32 or
        namespace_id != NAMESPACE_ID or
        (dataset_attributes & DSM_DEALLOCATE) == 0u32 or
        (dataset_attributes & ~DSM_ATTRIBUTE_MASK) != 0u32 or
        dataset_range_count == 0u32 or dataset_range_count > MAX_DSM_RANGES or
        data_bytes != dataset_range_count * DSM_RANGE_BYTES or
        slot_tag > DMA_SLOT_MASK: 0 else: 1

@export("C", name: "cosmos_nvme_media_policy_chunk_bytes")
pub fn cosmos_nvme_media_policy_chunk_bytes(remaining: u32) -> u32:
    # @decision chunk_bytes_clamps
    if remaining > PAGE_DATA_BYTES: PAGE_DATA_BYTES else: remaining

@export("C", name: "cosmos_nvme_media_policy_full_page")
pub fn cosmos_nvme_media_policy_full_page(
    page_offset: u32, page_count: u32
) -> i32:
    # @decision full_page_match
    if page_offset == 0u32 and page_count == PAGE_LBAS: 1 else: 0
