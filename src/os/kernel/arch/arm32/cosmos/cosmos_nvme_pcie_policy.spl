# Pure-Simple Cosmos+ NVMe PCIe queue/status policy.
#
# C retains only pointer-shaped ABI publication and volatile MMIO ordering.
# Validation and descriptor derivation are owned here.

pub val COSMOS_OK: i32 = 0
pub val COSMOS_INVALID: i32 = 2
pub val COSMOS_PCIE_IO_QUEUE_COUNT: u32 = 8u32
pub val COSMOS_PCIE_NVME_CPL_STATUS_DNR: u32 = 0x8000u32

struct CosmosNvmePcieDecisionCount:
    decision_id: text
    true_count: i64
    false_count: i64

struct CosmosNvmePcieDecisionManifest:
    manifest_id: text
    decisions: [CosmosNvmePcieDecisionCount]
    decisions_hit: i64
    decisions_total: i64

fn _status_sct_invalid(sct: u32) -> bool: sct > 7u32
fn _status_sc_invalid(sc: u32) -> bool: sc > 0xFFu32
fn _status_dnr_invalid(dnr: u32) -> bool: dnr > 1u32
fn _queue_valid_flag_invalid(valid: u32) -> bool: valid > 1u32
fn _queue_disabled_payload_present(entries: u32, low: u32, high: u32) -> bool:
    entries != 0u32 or low != 0u32 or high != 0u32
fn _queue_entries_missing(entries: u32) -> bool: entries == 0u32
fn _queue_entries_excessive(entries: u32) -> bool: entries > 256u32
fn _queue_address_unaligned(low: u32) -> bool: (low & 0xFFFu32) != 0u32
fn _queue_address_high_invalid(high: u32) -> bool: high > 0xFu32
fn _queue_address_zero(low: u32, high: u32) -> bool: low == 0u32 and high == 0u32
fn _queue_id_invalid(queue_id: u32) -> bool:
    queue_id == 0u32 or queue_id > COSMOS_PCIE_IO_QUEUE_COUNT
fn _sq_completion_queue_invalid(valid: u32, completion_queue_id: u32) -> bool:
    (valid != 0u32 and (completion_queue_id == 0u32 or completion_queue_id > COSMOS_PCIE_IO_QUEUE_COUNT)) or
        (valid == 0u32 and completion_queue_id != 0u32)
fn _cq_irq_enable_invalid(irq_enable: u32) -> bool: irq_enable > 1u32
fn _cq_irq_vector_invalid(irq_vector: u32) -> bool: irq_vector > 7u32
fn _cq_disabled_irq_present(valid: u32, irq_enable: u32, irq_vector: u32) -> bool:
    valid == 0u32 and (irq_enable != 0u32 or irq_vector != 0u32)

pub fn cosmos_nvme_pcie_queue_base_valid(
    valid: u32, entries: u32, address_low: u32, address_high: u32
) -> bool:
    if _queue_valid_flag_invalid(valid):
        return false
    if valid == 0u32:
        return not _queue_disabled_payload_present(entries, address_low, address_high)
    if _queue_entries_missing(entries) or _queue_entries_excessive(entries):
        return false
    if _queue_address_unaligned(address_low) or _queue_address_high_invalid(address_high):
        return false
    not _queue_address_zero(address_low, address_high)

pub fn cosmos_nvme_pcie_status_fields_valid(sct: u32, sc: u32, dnr: u32) -> bool:
    not _status_sct_invalid(sct) and not _status_sc_invalid(sc) and not _status_dnr_invalid(dnr)

pub fn cosmos_nvme_pcie_status_word_value(sct: u32, sc: u32, dnr: u32) -> u32:
    (sc << 1u32) | (sct << 9u32) |
        (if dnr != 0u32: COSMOS_PCIE_NVME_CPL_STATUS_DNR else: 0u32)

pub fn cosmos_nvme_pcie_io_sq_valid(
    queue_id: u32, valid: u32, completion_queue_id: u32, entries: u32,
    address_low: u32, address_high: u32
) -> bool:
    if _queue_id_invalid(queue_id):
        return false
    if not cosmos_nvme_pcie_queue_base_valid(valid, entries, address_low, address_high):
        return false
    not _sq_completion_queue_invalid(valid, completion_queue_id)

pub fn cosmos_nvme_pcie_io_sq_word1(
    valid: u32, completion_queue_id: u32, entries: u32, address_high: u32
) -> u32:
    address_high | (valid << 15u32) | (completion_queue_id << 16u32) |
        ((if entries == 0u32: 0u32 else: entries - 1u32) << 24u32)

pub fn cosmos_nvme_pcie_io_cq_valid(
    queue_id: u32, valid: u32, irq_enable: u32, irq_vector: u32,
    entries: u32, address_low: u32, address_high: u32
) -> bool:
    if _queue_id_invalid(queue_id):
        return false
    if not cosmos_nvme_pcie_queue_base_valid(valid, entries, address_low, address_high):
        return false
    if _cq_irq_enable_invalid(irq_enable) or _cq_irq_vector_invalid(irq_vector):
        return false
    not _cq_disabled_irq_present(valid, irq_enable, irq_vector)

pub fn cosmos_nvme_pcie_io_cq_word1(
    valid: u32, irq_enable: u32, irq_vector: u32, entries: u32,
    address_high: u32
) -> u32:
    address_high | (valid << 15u32) | (irq_vector << 16u32) |
        (irq_enable << 19u32) |
        ((if entries == 0u32: 0u32 else: entries - 1u32) << 24u32)

@export("C", name: "cosmos_nvme_pcie_policy_status_fields_valid")
pub fn cosmos_nvme_pcie_policy_status_fields_valid(sct: u32, sc: u32, dnr: u32) -> i32:
    if cosmos_nvme_pcie_status_fields_valid(sct, sc, dnr): 1 else: 0

@export("C", name: "cosmos_nvme_pcie_policy_status_word")
pub fn cosmos_nvme_pcie_policy_status_word(sct: u32, sc: u32, dnr: u32) -> u32:
    cosmos_nvme_pcie_status_word_value(sct, sc, dnr)

@export("C", name: "cosmos_nvme_pcie_policy_io_sq_valid")
pub fn cosmos_nvme_pcie_policy_io_sq_valid(
    queue_id: u32, valid: u32, completion_queue_id: u32, entries: u32,
    address_low: u32, address_high: u32
) -> i32:
    if cosmos_nvme_pcie_io_sq_valid(queue_id, valid, completion_queue_id, entries, address_low, address_high): 1 else: 0

@export("C", name: "cosmos_nvme_pcie_policy_io_sq_word1")
pub fn cosmos_nvme_pcie_policy_io_sq_word1(
    valid: u32, completion_queue_id: u32, entries: u32, address_high: u32
) -> u32:
    cosmos_nvme_pcie_io_sq_word1(valid, completion_queue_id, entries, address_high)

@export("C", name: "cosmos_nvme_pcie_policy_io_cq_valid")
pub fn cosmos_nvme_pcie_policy_io_cq_valid(
    queue_id: u32, valid: u32, irq_enable: u32, irq_vector: u32,
    entries: u32, address_low: u32, address_high: u32
) -> i32:
    if cosmos_nvme_pcie_io_cq_valid(queue_id, valid, irq_enable, irq_vector, entries, address_low, address_high): 1 else: 0

@export("C", name: "cosmos_nvme_pcie_policy_io_cq_word1")
pub fn cosmos_nvme_pcie_policy_io_cq_word1(
    valid: u32, irq_enable: u32, irq_vector: u32, entries: u32,
    address_high: u32
) -> u32:
    cosmos_nvme_pcie_io_cq_word1(valid, irq_enable, irq_vector, entries, address_high)

fn _decision_count(decision_id: text, outcomes: [bool]) -> CosmosNvmePcieDecisionCount:
    var true_count: i64 = 0
    var false_count: i64 = 0
    for outcome in outcomes:
        if outcome:
            true_count = true_count + 1
        else:
            false_count = false_count + 1
    CosmosNvmePcieDecisionCount(decision_id: decision_id, true_count: true_count, false_count: false_count)

pub fn cosmos_nvme_pcie_policy_decision_manifest() -> CosmosNvmePcieDecisionManifest:
    val decisions = [
        _decision_count("status.sct-invalid", [_status_sct_invalid(0u32), _status_sct_invalid(8u32)]),
        _decision_count("status.sc-invalid", [_status_sc_invalid(0u32), _status_sc_invalid(256u32)]),
        _decision_count("status.dnr-invalid", [_status_dnr_invalid(0u32), _status_dnr_invalid(2u32)]),
        _decision_count("queue.valid-flag-invalid", [_queue_valid_flag_invalid(0u32), _queue_valid_flag_invalid(2u32)]),
        _decision_count("queue.disabled-payload-present", [_queue_disabled_payload_present(0u32, 0u32, 0u32), _queue_disabled_payload_present(1u32, 0u32, 0u32)]),
        _decision_count("queue.entries-missing", [_queue_entries_missing(1u32), _queue_entries_missing(0u32)]),
        _decision_count("queue.entries-excessive", [_queue_entries_excessive(256u32), _queue_entries_excessive(257u32)]),
        _decision_count("queue.address-unaligned", [_queue_address_unaligned(0x1000u32), _queue_address_unaligned(0x1004u32)]),
        _decision_count("queue.address-high-invalid", [_queue_address_high_invalid(15u32), _queue_address_high_invalid(16u32)]),
        _decision_count("queue.address-zero", [_queue_address_zero(0x1000u32, 0u32), _queue_address_zero(0u32, 0u32)]),
        _decision_count("queue.id-invalid", [_queue_id_invalid(1u32), _queue_id_invalid(0u32)]),
        _decision_count("sq.completion-queue-invalid", [_sq_completion_queue_invalid(1u32, 1u32), _sq_completion_queue_invalid(1u32, 0u32)]),
        _decision_count("cq.irq-enable-invalid", [_cq_irq_enable_invalid(1u32), _cq_irq_enable_invalid(2u32)]),
        _decision_count("cq.irq-vector-invalid", [_cq_irq_vector_invalid(7u32), _cq_irq_vector_invalid(8u32)]),
        _decision_count("cq.disabled-irq-present", [_cq_disabled_irq_present(0u32, 0u32, 0u32), _cq_disabled_irq_present(0u32, 1u32, 0u32)])
    ]
    var hit: i64 = 0
    for decision in decisions:
        if decision.true_count > 0 and decision.false_count > 0:
            hit = hit + 1
    CosmosNvmePcieDecisionManifest(
        manifest_id: "cosmos-nvme-pcie-queue-policy-v1",
        decisions: decisions,
        decisions_hit: hit,
        decisions_total: decisions.len()
    )
