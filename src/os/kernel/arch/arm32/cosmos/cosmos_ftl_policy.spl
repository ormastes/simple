# codex-impl
# Pure policy/state decisions for the Cosmos+ OpenSSD flash translation layer.
#
# cosmos_ftl.c owns the historical C ABI, callback invocation, raw pointer and
# table acquisition, and writeback.  This module owns the closed set of 41
# scalar decisions that drive those operations.  The COSMOS-FTL-Dnnn comments
# are stable names bound by the external compiler/runtime coverage gate; this
# owner deliberately contains no coverage counters or claimed hit masks.

const FTL_OK: u32 = 0
const FTL_UNAVAILABLE: u32 = 1
const FTL_INVALID: u32 = 2
const FTL_HW_ERROR: u32 = 4
const FTL_RETRY: u32 = 5
const FTL_COMPLETION_UNCERTAIN: u32 = 6

const FTL_DIE_COUNT: u32 = 64
const FTL_LUN_COUNT: u32 = 2
const FTL_BLOCKS_PER_LUN: u32 = 4184
const FTL_MAIN_BLOCKS_PER_LUN: u32 = 4096
const FTL_METADATA_BLOCKS_PER_LUN: u32 = 32
const FTL_PAGES_PER_BLOCK: u32 = 128
const FTL_LANE_COUNT: u32 = 128
const FTL_GC_RESERVE_BLOCKS_PER_LANE: u32 = 409
const FTL_BLOCK_NONE: u32 = 0xffffu32
const FTL_PPA_NONE: u32 = 0xffffffffu32
const FTL_MAGIC: u32 = 0x46544c31u32
const FTL_VERSION: u32 = 2

const FTL_BLOCK_FREE: u32 = 0
const FTL_BLOCK_RESERVED: u32 = 1
const FTL_BLOCK_OPEN: u32 = 2
const FTL_BLOCK_CLOSED: u32 = 3
const FTL_BLOCK_ERASING: u32 = 4
const FTL_BLOCK_EVACUATE: u32 = 5
const FTL_BLOCK_RETIRED: u32 = 6

const FTL_RECORD_ALLOCATE: u32 = 1
const FTL_RECORD_MAP: u32 = 2
const FTL_RECORD_RETIRE: u32 = 3
const FTL_RECORD_ABANDON: u32 = 4
const FTL_RECORD_ERASE_BEGIN: u32 = 5
const FTL_RECORD_ERASE_DONE: u32 = 6
const FTL_RECORD_QUARANTINE: u32 = 7
const FTL_RECORD_DISCARD: u32 = 8

const FTL_APPEND_COMMITTED: u32 = 0
const FTL_APPEND_NOT_COMMITTED: u32 = 1
const FTL_APPEND_AMBIGUOUS: u32 = 2

# Action encodings returned to the C acquisition/writeback bridge.
const FTL_ACTION_REJECT: u32 = 16
const FTL_ACTION_ACCEPT: u32 = 17
const FTL_ACTION_USE_OPEN: u32 = 18
const FTL_ACTION_TRACK_FREE: u32 = 19
const FTL_ACTION_USE_FREE: u32 = 20
const FTL_ACTION_QUARANTINE: u32 = 21
const FTL_ACTION_RETIRE: u32 = 22
const FTL_ACTION_ERASE: u32 = 23

fn _crc32_step(crc: u32, byte: u32) -> u32:
    var value = crc ^ (byte & 0xffu32)
    var bit = 0u32
    while bit < 8u32:  # COSMOS-FTL-D183
        value = (value >> 1u32) ^ (0xedb88320u32 & (0u32 - (value & 1u32)))
        bit = bit + 1u32
    value

@export("C")
fn cosmos_ftl_policy_crc32_step(crc: u32, byte: u32) -> u32:
    _crc32_step(crc, byte)

@export("C")
fn cosmos_ftl_policy_crc32_begin(bytes: u32) -> u32:
    if bytes == 0u32:  # COSMOS-FTL-D001
        return 0u32
    0xffffffffu32

@export("C")
fn cosmos_ftl_policy_crc32_u32(crc: u32, value: u32) -> u32:
    var result = crc
    var byte = 0u32
    while byte < 4u32:  # COSMOS-FTL-D184
        result = _crc32_step(result, value >> (byte * 8u32))
        byte = byte + 1u32
    result

@export("C")
fn cosmos_ftl_policy_crc32_u64(crc: u32, value: u64) -> u32:
    var result = crc
    var byte = 0u32
    while byte < 8u32:  # COSMOS-FTL-D185
        result = _crc32_step(result, (value >> (byte * 8u32)) as u32)
        byte = byte + 1u32
    result

@export("C")
fn cosmos_ftl_policy_checkpoint_crc(
    magic: u32, version: u32, generation: u64, journal_index: u64,
    l2p_count: u32, block_count: u32, allocation_lane: u32,
    journal_crc: u32, l2p_crc: u32, block_crc: u32
) -> u32:
    var crc = cosmos_ftl_policy_crc32_u32(0xffffffffu32, magic)
    crc = cosmos_ftl_policy_crc32_u32(crc, version)
    crc = cosmos_ftl_policy_crc32_u64(crc, generation)
    crc = cosmos_ftl_policy_crc32_u64(crc, journal_index)
    crc = cosmos_ftl_policy_crc32_u32(crc, l2p_count)
    crc = cosmos_ftl_policy_crc32_u32(crc, block_count)
    crc = cosmos_ftl_policy_crc32_u32(crc, allocation_lane)
    crc = cosmos_ftl_policy_crc32_u32(crc, journal_crc)
    crc = cosmos_ftl_policy_crc32_u32(crc, l2p_crc)
    crc = cosmos_ftl_policy_crc32_u32(crc, block_crc)
    ~crc

@export("C")
fn cosmos_ftl_policy_journal_record_crc(
    magic: u32, record_type: u32, sequence: u64, generation: u64,
    lpn: u32, new_ppa: u32, old_ppa: u32, block_index: u32,
    previous_crc: u32
) -> u32:
    var crc = cosmos_ftl_policy_crc32_u32(0xffffffffu32, magic)
    crc = cosmos_ftl_policy_crc32_u32(crc, record_type)
    crc = cosmos_ftl_policy_crc32_u64(crc, sequence)
    crc = cosmos_ftl_policy_crc32_u64(crc, generation)
    crc = cosmos_ftl_policy_crc32_u32(crc, lpn)
    crc = cosmos_ftl_policy_crc32_u32(crc, new_ppa)
    crc = cosmos_ftl_policy_crc32_u32(crc, old_ppa)
    crc = cosmos_ftl_policy_crc32_u32(crc, block_index)
    crc = cosmos_ftl_policy_crc32_u32(crc, previous_crc)
    ~crc

@export("C")
fn cosmos_ftl_policy_l2p_crc_step(crc: u32, value: u32) -> u32:
    cosmos_ftl_policy_crc32_u32(crc, value)

@export("C")
fn cosmos_ftl_policy_blocks_crc_step(
    crc: u32, valid_pages: u32, erase_count: u32, bad: u32,
    state: u32, next_page: u32, reserved: u32
) -> u32:
    var result = _crc32_step(crc, valid_pages)
    result = _crc32_step(result, valid_pages >> 8u32)
    result = _crc32_step(result, erase_count)
    result = _crc32_step(result, erase_count >> 8u32)
    result = _crc32_step(result, bad)
    result = _crc32_step(result, state)
    result = _crc32_step(result, next_page)
    _crc32_step(result, reserved)

# Valid PPA is returned in the low word; UINT64_MAX is the invalid receipt.
@export("C")
fn cosmos_ftl_policy_ppa_encode(
    die: u32, lun: u32, block: u32, page: u32
) -> u64:
    if die >= FTL_DIE_COUNT:  # COSMOS-FTL-D002
        return 0xffffffffffffffffu64
    if lun >= FTL_LUN_COUNT:  # COSMOS-FTL-D003
        return 0xffffffffffffffffu64
    if block >= FTL_BLOCKS_PER_LUN:  # COSMOS-FTL-D004
        return 0xffffffffffffffffu64
    if page >= FTL_PAGES_PER_BLOCK:  # COSMOS-FTL-D005
        return 0xffffffffffffffffu64
    ((die << 21u32) | (lun << 20u32) | (block << 7u32) | page) as u64

@export("C")
fn cosmos_ftl_policy_ppa_decode_valid(ppa: u32) -> u32:
    if ppa == FTL_PPA_NONE:  # COSMOS-FTL-D006
        return 0u32
    if (ppa >> 27u32) != 0u32:  # COSMOS-FTL-D007
        return 0u32
    if ((ppa >> 7u32) & 0x1fffu32) >= FTL_BLOCKS_PER_LUN:  # COSMOS-FTL-D008
        return 0u32
    1u32

# channel[7:0], way[15:8], row[47:16]; UINT64_MAX means invalid.
@export("C")
fn cosmos_ftl_policy_ppa_row(ppa: u32) -> u64:
    if cosmos_ftl_policy_ppa_decode_valid(ppa) == 0u32:  # COSMOS-FTL-D009
        return 0xffffffffffffffffu64
    val die = (ppa >> 21u32) & 0x3fu32
    val lun = (ppa >> 20u32) & 1u32
    val block = (ppa >> 7u32) & 0x1fffu32
    val page = ppa & 0x7fu32
    var row = block * 256u32
    if lun != 0u32:  # COSMOS-FTL-D010
        row = row + 0x00200000u32
    if page != 0u32:  # COSMOS-FTL-D011
        row = row + page * 2u32 - 1u32
    (die & 7u32) as u64 | ((die >> 3u32) as u64 << 8u32) |
        (row as u64 << 16u32)

@export("C")
fn cosmos_ftl_policy_block_index_from_parts(
    die: u32, lun: u32, block: u32
) -> u32:
    (die * FTL_LUN_COUNT + lun) * FTL_BLOCKS_PER_LUN + block

@export("C")
fn cosmos_ftl_policy_lane_index_from_parts(die: u32, lun: u32) -> u32:
    die * FTL_LUN_COUNT + lun

# block[15:0], lun[16], die[31:17].
@export("C")
fn cosmos_ftl_policy_block_parts_from_index(index: u32) -> u64:
    val block = index % FTL_BLOCKS_PER_LUN
    val lane = index / FTL_BLOCKS_PER_LUN
    val lun = lane % FTL_LUN_COUNT
    val die = lane / FTL_LUN_COUNT
    block as u64 | (lun as u64 << 16u32) | (die as u64 << 17u32)

# UINT64_MAX means invalid; otherwise the low word is the block-table index.
@export("C")
fn cosmos_ftl_policy_block_index_from_ppa(ppa: u32) -> u64:
    if cosmos_ftl_policy_ppa_decode_valid(ppa) == 0u32:  # COSMOS-FTL-D012
        return 0xffffffffffffffffu64
    val die = (ppa >> 21u32) & 0x3fu32
    val lun = (ppa >> 20u32) & 1u32
    val block = (ppa >> 7u32) & 0x1fffu32
    cosmos_ftl_policy_block_index_from_parts(die, lun, block) as u64

# kind=0 is L2P, kind=1 is a block row.  The return packs the canonical
# initial state and is deliberately independent of storage addresses.
@export("C")
fn cosmos_ftl_policy_clear_tables_value(kind: u32) -> u64:
    if kind == 0u32:  # COSMOS-FTL-D013
        return FTL_PPA_NONE as u64
    FTL_BLOCK_FREE as u64

@export("C")
fn cosmos_ftl_policy_init_valid(
    ftl_present: u32, backend_present: u32, l2p_present: u32,
    l2p_count: u32, blocks_present: u32, namespace_pages: u32,
    block_count: u32, expected_blocks: u32, callback_mask: u32,
    journal_capacity: u64
) -> u32:
    if ftl_present == 0u32:  # COSMOS-FTL-D014
        return FTL_INVALID
    if backend_present == 0u32:  # COSMOS-FTL-D015
        return FTL_INVALID
    if l2p_present == 0u32:  # COSMOS-FTL-D016
        return FTL_INVALID
    if l2p_count == 0u32:  # COSMOS-FTL-D017
        return FTL_INVALID
    if blocks_present == 0u32:  # COSMOS-FTL-D018
        return FTL_INVALID
    if l2p_count > namespace_pages:  # COSMOS-FTL-D019
        return FTL_INVALID
    if block_count != expected_blocks:  # COSMOS-FTL-D020
        return FTL_INVALID
    if callback_mask != 0x3ffu32:  # COSMOS-FTL-D021
        return FTL_INVALID
    if journal_capacity == 0u64:  # COSMOS-FTL-D022
        return FTL_INVALID
    FTL_OK

@export("C")
fn cosmos_ftl_policy_factory_initialize_erased_valid(ftl_present: u32) -> u32:
    if ftl_present == 0u32:  # COSMOS-FTL-D023
        return FTL_INVALID
    FTL_OK

# low byte is state, bit 8 is the canonical bad flag.
@export("C")
fn cosmos_ftl_policy_factory_block_state(block: u32, bad: u32) -> u32:
    if bad != 0u32:  # COSMOS-FTL-D024
        return FTL_BLOCK_RETIRED | 0x100u32
    if block < FTL_METADATA_BLOCKS_PER_LUN:  # COSMOS-FTL-D025
        return FTL_BLOCK_RESERVED
    if block >= FTL_MAIN_BLOCKS_PER_LUN:  # COSMOS-FTL-D026
        return FTL_BLOCK_RESERVED
    FTL_BLOCK_FREE

@export("C")
fn cosmos_ftl_policy_checkpoint_valid(
    magic: u32, version: u32, l2p_count: u32, expected_l2p_count: u32,
    block_count: u32, expected_block_count: u32,
    header_crc: u32, expected_header_crc: u32
) -> u32:
    if magic != FTL_MAGIC:  # COSMOS-FTL-D027
        return 0u32
    if version != FTL_VERSION:  # COSMOS-FTL-D028
        return 0u32
    if l2p_count != expected_l2p_count:  # COSMOS-FTL-D029
        return 0u32
    if block_count != expected_block_count:  # COSMOS-FTL-D030
        return 0u32
    if header_crc != expected_header_crc:  # COSMOS-FTL-D031
        return 0u32
    1u32

@export("C")
fn cosmos_ftl_policy_load_checkpoint_status(
    backend_status: u32, l2p_crc: u32, expected_l2p_crc: u32,
    block_crc: u32, expected_block_crc: u32, allocation_lane: u32
) -> u32:
    if backend_status != FTL_OK:  # COSMOS-FTL-D032
        return FTL_HW_ERROR
    if l2p_crc != expected_l2p_crc:  # COSMOS-FTL-D033
        return FTL_HW_ERROR
    if block_crc != expected_block_crc:  # COSMOS-FTL-D034
        return FTL_HW_ERROR
    if allocation_lane >= FTL_LANE_COUNT:  # COSMOS-FTL-D035
        return FTL_HW_ERROR
    FTL_OK

# bit0 decrements the old block, bit1 increments the new block.
@export("C")
fn cosmos_ftl_policy_map_apply_actions(
    old_ppa: u32, old_index_valid: u32, old_valid_pages: u32,
    new_index_valid: u32
) -> u32:
    var actions = 0u32
    if old_ppa != FTL_PPA_NONE:  # COSMOS-FTL-D036
        if old_index_valid != 0u32:  # COSMOS-FTL-D037
            if old_valid_pages != 0u32:  # COSMOS-FTL-D038
                actions = actions | 1u32
    if new_index_valid != 0u32:  # COSMOS-FTL-D039
        actions = actions | 2u32
    actions

# FTL_OK means valid.  FTL_ACTION_ACCEPT in bits 15:8 tells C to install this
# block as the lane's open block.
@export("C")
fn cosmos_ftl_policy_rebuild_runtime_state_entry(
    block: u32, valid_pages: u32, bad: u32, state: u32,
    next_page: u32, reserved: u32, lane_has_open: u32
) -> u32:
    if reserved != 0u32:  # COSMOS-FTL-D040
        return FTL_HW_ERROR
    if valid_pages > FTL_PAGES_PER_BLOCK:  # COSMOS-FTL-D041
        return FTL_HW_ERROR
    if next_page > FTL_PAGES_PER_BLOCK:  # COSMOS-FTL-D042
        return FTL_HW_ERROR
    if block < FTL_METADATA_BLOCKS_PER_LUN:  # COSMOS-FTL-D043
        if state == FTL_BLOCK_RESERVED:  # COSMOS-FTL-D044
            return FTL_OK
        if state == FTL_BLOCK_RETIRED:  # COSMOS-FTL-D045
            return FTL_OK
        return FTL_HW_ERROR
    if block >= FTL_MAIN_BLOCKS_PER_LUN:  # COSMOS-FTL-D046
        if state == FTL_BLOCK_RESERVED:  # COSMOS-FTL-D047
            return FTL_OK
        if state == FTL_BLOCK_RETIRED:  # COSMOS-FTL-D048
            return FTL_OK
        return FTL_HW_ERROR
    if state == FTL_BLOCK_FREE:  # COSMOS-FTL-D049
        if valid_pages != 0u32:  # COSMOS-FTL-D050
            return FTL_HW_ERROR
        if next_page != 0u32:  # COSMOS-FTL-D051
            return FTL_HW_ERROR
        if bad != 0u32:  # COSMOS-FTL-D052
            return FTL_HW_ERROR
        return FTL_OK
    if state == FTL_BLOCK_OPEN:  # COSMOS-FTL-D053
        if next_page == 0u32:  # COSMOS-FTL-D054
            return FTL_HW_ERROR
        if next_page >= FTL_PAGES_PER_BLOCK:  # COSMOS-FTL-D055
            return FTL_HW_ERROR
        if valid_pages > next_page:  # COSMOS-FTL-D056
            return FTL_HW_ERROR
        if bad != 0u32:  # COSMOS-FTL-D057
            return FTL_HW_ERROR
        if lane_has_open != 0u32:  # COSMOS-FTL-D058
            return FTL_HW_ERROR
        return FTL_OK | (FTL_ACTION_ACCEPT << 8u32)
    if state == FTL_BLOCK_CLOSED:  # COSMOS-FTL-D059
        if next_page == 0u32:  # COSMOS-FTL-D060
            return FTL_HW_ERROR
        if valid_pages > next_page:  # COSMOS-FTL-D061
            return FTL_HW_ERROR
        if bad != 0u32:  # COSMOS-FTL-D062
            return FTL_HW_ERROR
        return FTL_OK
    if state == FTL_BLOCK_EVACUATE:  # COSMOS-FTL-D063
        if next_page == 0u32:  # COSMOS-FTL-D064
            return FTL_HW_ERROR
        if valid_pages > next_page:  # COSMOS-FTL-D065
            return FTL_HW_ERROR
        if bad != 0u32:  # COSMOS-FTL-D066
            return FTL_HW_ERROR
        return FTL_OK
    if state == FTL_BLOCK_ERASING:  # COSMOS-FTL-D067
        if valid_pages != 0u32:  # COSMOS-FTL-D068
            return FTL_HW_ERROR
        if bad != 0u32:  # COSMOS-FTL-D069
            return FTL_HW_ERROR
        return FTL_OK
    if state == FTL_BLOCK_RETIRED:  # COSMOS-FTL-D070
        if bad == 0u32:  # COSMOS-FTL-D071
            return FTL_HW_ERROR
        if valid_pages != 0u32:  # COSMOS-FTL-D072
            return FTL_HW_ERROR
        return FTL_OK
    FTL_HW_ERROR

@export("C")
fn cosmos_ftl_policy_allocation_ppa_valid(
    ppa_valid: u32, block: u32, page: u32, bad: u32, state: u32,
    open_block: u32
) -> u32:
    if ppa_valid == 0u32:  # COSMOS-FTL-D073
        return 0u32
    if block < FTL_METADATA_BLOCKS_PER_LUN:  # COSMOS-FTL-D074
        return 0u32
    if block >= FTL_MAIN_BLOCKS_PER_LUN:  # COSMOS-FTL-D075
        return 0u32
    if bad != 0u32:  # COSMOS-FTL-D076
        return 0u32
    if state == FTL_BLOCK_FREE:  # COSMOS-FTL-D077
        if page != 0u32:  # COSMOS-FTL-D078
            return 0u32
        if open_block != FTL_BLOCK_NONE:  # COSMOS-FTL-D079
            return 0u32
        return 1u32
    if state == FTL_BLOCK_OPEN:  # COSMOS-FTL-D080
        if open_block != block:  # COSMOS-FTL-D081
            return 0u32
        return 1u32
    0u32

# state[7:0], next_page[15:8], open_block[31:16], next lane[39:32].
@export("C")
fn cosmos_ftl_policy_allocation_apply_receipt(
    state: u32, page: u32, block: u32, lane: u32
) -> u64:
    var next_state = state
    var next_open = block
    if state == FTL_BLOCK_FREE:  # COSMOS-FTL-D082
        next_state = FTL_BLOCK_OPEN
    val next_page = page + 1u32
    if next_page == FTL_PAGES_PER_BLOCK:  # COSMOS-FTL-D083
        next_state = FTL_BLOCK_CLOSED
        next_open = FTL_BLOCK_NONE
    next_state as u64 | (next_page as u64 << 8u32) |
        (next_open as u64 << 16u32) |
        (((lane + 1u32) % FTL_LANE_COUNT) as u64 << 32u32)

# Returns the state/writeback action for one replay record.
@export("C")
fn cosmos_ftl_policy_apply_record_action(
    record_type: u32, lpn: u32, l2p_count: u32,
    block_index: u32, block_count: u32
) -> u32:
    if record_type == FTL_RECORD_ALLOCATE:  # COSMOS-FTL-D084
        return FTL_RECORD_ALLOCATE
    if record_type == FTL_RECORD_MAP:  # COSMOS-FTL-D085
        if lpn < l2p_count:  # COSMOS-FTL-D086
            return FTL_RECORD_MAP
        return FTL_ACTION_REJECT
    if record_type == FTL_RECORD_RETIRE:  # COSMOS-FTL-D087
        if block_index < block_count:  # COSMOS-FTL-D088
            return FTL_RECORD_RETIRE
        return FTL_ACTION_REJECT
    if record_type == FTL_RECORD_ERASE_BEGIN:  # COSMOS-FTL-D089
        if block_index < block_count:  # COSMOS-FTL-D090
            return FTL_RECORD_ERASE_BEGIN
        return FTL_ACTION_REJECT
    if record_type == FTL_RECORD_ERASE_DONE:  # COSMOS-FTL-D091
        if block_index < block_count:  # COSMOS-FTL-D092
            return FTL_RECORD_ERASE_DONE
        return FTL_ACTION_REJECT
    if record_type == FTL_RECORD_QUARANTINE:  # COSMOS-FTL-D093
        if block_index < block_count:  # COSMOS-FTL-D094
            return FTL_RECORD_QUARANTINE
        return FTL_ACTION_REJECT
    if record_type == FTL_RECORD_DISCARD:  # COSMOS-FTL-D095
        if lpn < l2p_count:  # COSMOS-FTL-D096
            return FTL_RECORD_DISCARD
    FTL_ACTION_REJECT

@export("C")
fn cosmos_ftl_policy_data_ppa_valid(
    ppa_valid: u32, block: u32, block_index_valid: u32, bad: u32
) -> u32:
    if ppa_valid == 0u32:  # COSMOS-FTL-D097
        return 0u32
    if block < FTL_METADATA_BLOCKS_PER_LUN:  # COSMOS-FTL-D098
        return 0u32
    if block >= FTL_MAIN_BLOCKS_PER_LUN:  # COSMOS-FTL-D099
        return 0u32
    if block_index_valid == 0u32:  # COSMOS-FTL-D100
        return 0u32
    if bad != 0u32:  # COSMOS-FTL-D101
        return 0u32
    1u32

@export("C")
fn cosmos_ftl_policy_journal_has_space(
    journal_index: u64, journal_first_index: u64,
    capacity: u64, records: u64
) -> u32:
    if records == 0u64:  # COSMOS-FTL-D102
        return 0u32
    if records > capacity:  # COSMOS-FTL-D103
        return 0u32
    if journal_index < journal_first_index:  # COSMOS-FTL-D104
        return 0u32
    if journal_index > 0xffffffffffffffffu64 - records:  # COSMOS-FTL-D105
        return 0u32
    if journal_index - journal_first_index > capacity - records:  # COSMOS-FTL-D106
        return 0u32
    1u32

@export("C")
fn cosmos_ftl_policy_recover_checkpoint_first(
    valid0: u32, valid1: u32, generation0: u64, generation1: u64,
    journal0: u64, journal1: u64
) -> u32:
    if valid1 == 0u32:  # COSMOS-FTL-D107
        return 0u32
    if valid0 == 0u32:  # COSMOS-FTL-D108
        return 1u32
    if generation1 > generation0:  # COSMOS-FTL-D109
        return 1u32
    if generation1 == generation0:  # COSMOS-FTL-D110
        if journal1 > journal0:  # COSMOS-FTL-D111
            return 1u32
    0u32

@export("C")
fn cosmos_ftl_policy_lookup_status(
    ftl_present: u32, ppa_present: u32, mounted: u32,
    lpn: u32, l2p_count: u32, mapped_ppa: u32,
    index_valid: u32, bad: u32
) -> u32:
    if ftl_present == 0u32:  # COSMOS-FTL-D112
        return FTL_INVALID
    if ppa_present == 0u32:  # COSMOS-FTL-D113
        return FTL_INVALID
    if mounted == 0u32:  # COSMOS-FTL-D114
        return FTL_INVALID
    if lpn >= l2p_count:  # COSMOS-FTL-D115
        return FTL_INVALID
    if mapped_ppa == FTL_PPA_NONE:  # COSMOS-FTL-D116
        return FTL_UNAVAILABLE
    if index_valid == 0u32:  # COSMOS-FTL-D117
        return FTL_HW_ERROR
    if bad != 0u32:  # COSMOS-FTL-D118
        return FTL_HW_ERROR
    FTL_OK

# low byte is status, bit 8 requests fail_sticky, bit 9 commits journal state.
@export("C")
fn cosmos_ftl_policy_append_record_result(
    journal_index: u64, journal_first_index: u64,
    capacity: u64, append_result: u32
) -> u32:
    if journal_index == 0xffffffffffffffffu64:  # COSMOS-FTL-D119
        return FTL_UNAVAILABLE
    if journal_index < journal_first_index:  # COSMOS-FTL-D120
        return FTL_HW_ERROR | 0x100u32
    if journal_index - journal_first_index >= capacity:  # COSMOS-FTL-D121
        return FTL_UNAVAILABLE
    if append_result == FTL_APPEND_COMMITTED:  # COSMOS-FTL-D122
        return FTL_OK | 0x200u32
    if append_result == FTL_APPEND_NOT_COMMITTED:  # COSMOS-FTL-D123
        return FTL_RETRY
    if append_result == FTL_APPEND_AMBIGUOUS:  # COSMOS-FTL-D124
        return FTL_COMPLETION_UNCERTAIN | 0x100u32
    FTL_HW_ERROR | 0x100u32

@export("C")
fn cosmos_ftl_policy_allocate_page_action(
    index: u32, excluded_index: u32, state: u32, next_page: u32,
    bad: u32, is_open_candidate: u32, free_count: u32, gc: u32,
    free_count_is_final: u32
) -> u32:
    if index == excluded_index:  # COSMOS-FTL-D125
        return FTL_ACTION_REJECT
    if is_open_candidate != 0u32:  # COSMOS-FTL-D126
        if state == FTL_BLOCK_OPEN:  # COSMOS-FTL-D127
            if next_page < FTL_PAGES_PER_BLOCK:  # COSMOS-FTL-D128
                return FTL_ACTION_USE_OPEN
    if state != FTL_BLOCK_FREE:  # COSMOS-FTL-D129
        return FTL_ACTION_REJECT
    if bad != 0u32:  # COSMOS-FTL-D130
        return FTL_ACTION_REJECT
    if free_count_is_final == 0u32:  # COSMOS-FTL-D131
        return FTL_ACTION_TRACK_FREE
    var reserve = FTL_GC_RESERVE_BLOCKS_PER_LANE
    if gc != 0u32:  # COSMOS-FTL-D132
        reserve = 0u32
    if free_count > reserve:  # COSMOS-FTL-D133
        return FTL_ACTION_USE_FREE
    FTL_ACTION_TRACK_FREE

@export("C")
fn cosmos_ftl_policy_commit_page_admit(
    ftl_present: u32, ppa_present: u32, mounted: u32, fail_sticky: u32,
    lpn: u32, l2p_count: u32, generation: u64,
    journal_space: u32, source_ppa: u32, source_index_valid: u32
) -> u32:
    if ftl_present == 0u32:  # COSMOS-FTL-D134
        return FTL_INVALID
    if ppa_present == 0u32:  # COSMOS-FTL-D135
        return FTL_INVALID
    if mounted == 0u32:  # COSMOS-FTL-D136
        return FTL_INVALID
    if fail_sticky != 0u32:  # COSMOS-FTL-D137
        return FTL_INVALID
    if lpn >= l2p_count:  # COSMOS-FTL-D138
        return FTL_INVALID
    if generation == 0xffffffffffffffffu64:  # COSMOS-FTL-D139
        return FTL_INVALID
    if journal_space == 0u32:  # COSMOS-FTL-D140
        return FTL_UNAVAILABLE
    if source_ppa != FTL_PPA_NONE:  # COSMOS-FTL-D141
        if source_index_valid == 0u32:  # COSMOS-FTL-D142
            return FTL_INVALID
    FTL_OK

@export("C")
fn cosmos_ftl_policy_commit_page_mode(source_ppa: u32) -> u32:
    if source_ppa == FTL_PPA_NONE:  # COSMOS-FTL-D143
        return 0u32
    1u32

@export("C")
fn cosmos_ftl_policy_refresh_page_status(
    lookup_status: u32, mapped_ppa: u32, source_ppa: u32
) -> u32:
    if lookup_status != FTL_OK:  # COSMOS-FTL-D144
        return lookup_status
    if mapped_ppa != source_ppa:  # COSMOS-FTL-D145
        return FTL_INVALID
    FTL_OK

# low byte status; bit8 means append/apply the discard record.
@export("C")
fn cosmos_ftl_policy_discard_page_action(
    ftl_present: u32, mounted: u32, fail_sticky: u32, lpn: u32,
    l2p_count: u32, generation: u64, old_ppa: u32, journal_space: u32
) -> u32:
    if ftl_present == 0u32:  # COSMOS-FTL-D146
        return FTL_INVALID
    if mounted == 0u32:  # COSMOS-FTL-D147
        return FTL_INVALID
    if fail_sticky != 0u32:  # COSMOS-FTL-D148
        return FTL_INVALID
    if lpn >= l2p_count:  # COSMOS-FTL-D149
        return FTL_INVALID
    if generation == 0xffffffffffffffffu64:  # COSMOS-FTL-D150
        return FTL_INVALID
    if old_ppa == FTL_PPA_NONE:  # COSMOS-FTL-D151
        return FTL_OK
    if journal_space == 0u32:  # COSMOS-FTL-D152
        return FTL_UNAVAILABLE
    FTL_OK | 0x100u32

@export("C")
fn cosmos_ftl_policy_retire_block_action(
    ftl_present: u32, mounted: u32, index_valid: u32,
    state: u32, valid_pages: u32, journal_space: u32
) -> u32:
    if ftl_present == 0u32:  # COSMOS-FTL-D153
        return FTL_INVALID
    if mounted == 0u32:  # COSMOS-FTL-D154
        return FTL_INVALID
    if index_valid == 0u32:  # COSMOS-FTL-D155
        return FTL_INVALID
    if state == FTL_BLOCK_RESERVED:  # COSMOS-FTL-D156
        return FTL_INVALID
    if state == FTL_BLOCK_RETIRED:  # COSMOS-FTL-D157
        return FTL_INVALID
    if state == FTL_BLOCK_ERASING:  # COSMOS-FTL-D158
        return FTL_INVALID
    if journal_space == 0u32:  # COSMOS-FTL-D159
        return FTL_UNAVAILABLE
    if valid_pages != 0u32:  # COSMOS-FTL-D160
        if state == FTL_BLOCK_EVACUATE:  # COSMOS-FTL-D161
            return FTL_RETRY
        return FTL_ACTION_QUARANTINE
    if state == FTL_BLOCK_OPEN:  # COSMOS-FTL-D162
        return FTL_ACTION_QUARANTINE
    if state == FTL_BLOCK_CLOSED:  # COSMOS-FTL-D163
        return FTL_ACTION_QUARANTINE
    FTL_ACTION_RETIRE

@export("C")
fn cosmos_ftl_policy_gc_victim_better(
    state: u32, valid_pages: u32, erase_count: u32,
    best_present: u32, best_valid: u32, best_erase_count: u32
) -> u32:
    if state == FTL_BLOCK_EVACUATE:  # COSMOS-FTL-D164
        return 2u32
    if state != FTL_BLOCK_CLOSED:  # COSMOS-FTL-D165
        return 0u32
    if valid_pages >= FTL_PAGES_PER_BLOCK:  # COSMOS-FTL-D166
        return 0u32
    if best_present == 0u32:  # COSMOS-FTL-D167
        return 1u32
    if valid_pages < best_valid:  # COSMOS-FTL-D168
        return 1u32
    if valid_pages == best_valid:  # COSMOS-FTL-D169
        if erase_count < best_erase_count:  # COSMOS-FTL-D170
            return 1u32
    0u32

@export("C")
fn cosmos_ftl_policy_gc_finish_action(state: u32, journal_space: u32) -> u32:
    if journal_space == 0u32:  # COSMOS-FTL-D171
        return FTL_UNAVAILABLE
    if state == FTL_BLOCK_EVACUATE:  # COSMOS-FTL-D172
        return FTL_ACTION_RETIRE
    FTL_ACTION_ERASE

@export("C")
fn cosmos_ftl_policy_gc_step_status(
    ftl_present: u32, mounted: u32, fail_sticky: u32,
    max_moves: u32, moves: u32, victim_status: u32
) -> u32:
    if ftl_present == 0u32:  # COSMOS-FTL-D173
        return FTL_INVALID
    if mounted == 0u32:  # COSMOS-FTL-D174
        return FTL_INVALID
    if fail_sticky != 0u32:  # COSMOS-FTL-D175
        return FTL_INVALID
    if max_moves == 0u32:  # COSMOS-FTL-D176
        return FTL_INVALID
    if victim_status != FTL_OK:  # COSMOS-FTL-D177
        if moves != 0u32:  # COSMOS-FTL-D178
            return FTL_OK
        return victim_status
    FTL_OK

# low byte is status, bit8 requests a checkpoint write, bit9 requests trim.
@export("C")
fn cosmos_ftl_policy_flush_action(
    ftl_present: u32, mounted: u32, fail_sticky: u32,
    checkpoint_valid_mask_after_write: u32
) -> u32:
    if ftl_present == 0u32:  # COSMOS-FTL-D179
        return FTL_INVALID
    if mounted == 0u32:  # COSMOS-FTL-D180
        return FTL_INVALID
    if fail_sticky != 0u32:  # COSMOS-FTL-D181
        return FTL_INVALID
    if checkpoint_valid_mask_after_write == 3u32:  # COSMOS-FTL-D182
        return FTL_OK | 0x300u32
    FTL_OK | 0x100u32
