#!/bin/sh
# Clean, reproducible Cosmos+ OpenSSD ARM image build.
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../../../../../.." && pwd)"
RECEIPT_HELPER="$SCRIPT_DIR/cosmos_build_receipt.shs"
PROFILE_HEADER="$SCRIPT_DIR/cosmos_profile_openssd2_8ch8way_v300.h"
[ -f "$RECEIPT_HELPER" ] || {
    echo "missing receipt helper: $RECEIPT_HELPER" >&2
    exit 2
}
. "$RECEIPT_HELPER"

PROFILE_SELECTOR="$(cosmos_profile_string "$PROFILE_HEADER" COSMOS_PROFILE_SELECTOR)"
PROFILE_NAME="$(cosmos_profile_string "$PROFILE_HEADER" COSMOS_PROFILE_NAME)"
PROFILE_SYMBOL="$(cosmos_profile_define "$PROFILE_HEADER" COSMOS_PROFILE_ELF_SYMBOL)"
PROFILE_RECEIPT_FORMAT="$(
    cosmos_profile_string "$PROFILE_HEADER" COSMOS_PROFILE_BUILD_RECEIPT_FORMAT
)"
PROFILE_SOURCE_COMMIT="$(
    cosmos_profile_string "$PROFILE_HEADER" COSMOS_PROFILE_SOURCE_COMMIT
)"
PROFILE_BITSTREAM_SHA256="$(
    cosmos_profile_string "$PROFILE_HEADER" COSMOS_PROFILE_BITSTREAM_SHA256
)"
COSMOS_FIRMWARE_BASE="$(
    cosmos_profile_u32 "$PROFILE_HEADER" COSMOS_FIRMWARE_IDENTITY_BASE
)"
COSMOS_FIRMWARE_END="$(
    cosmos_profile_u32 "$PROFILE_HEADER" COSMOS_FIRMWARE_IDENTITY_END
)"
COSMOS_DMA_BASE="$(
    cosmos_profile_u32 "$PROFILE_HEADER" COSMOS_NFC_DMA_IDENTITY_BASE
)"
COSMOS_DMA_END="$(
    cosmos_profile_u32 "$PROFILE_HEADER" COSMOS_NFC_DMA_IDENTITY_END
)"
COSMOS_MMIO_BASE="$(
    cosmos_profile_u32 "$PROFILE_HEADER" COSMOS_MMIO_IDENTITY_BASE
)"
COSMOS_MMIO_END="$(
    cosmos_profile_u32 "$PROFILE_HEADER" COSMOS_MMIO_IDENTITY_END
)"
[ "$PROFILE_RECEIPT_FORMAT" = "$COSMOS_RECEIPT_FORMAT" ] || {
    echo "profile/receipt schema mismatch" >&2
    exit 2
}

MODE="${COSMOS_BUILD_MODE:-qemu}"
PROFILE="${COSMOS_SILICON_PROFILE:-}"
case "${COSMOS_OUT:-}" in
    "") OUT="$ROOT/build/os" ;;
    /*) OUT="$COSMOS_OUT" ;;
    *) OUT="$ROOT/$COSMOS_OUT" ;;
esac
[ "$OUT" != / ] || {
    echo "invalid COSMOS_OUT" >&2
    exit 2
}

case "$MODE" in
    qemu)
        [ -z "$PROFILE" ] || {
            echo "QEMU builds cannot select a silicon profile" >&2
            exit 2
        }
        ELF="$OUT/simpleos_cosmos_openssd.elf"
        RECEIPT_PROFILE=unbound
        RECEIPT_SELECTOR=unbound
        ;;
    silicon)
        [ "$PROFILE" = "$PROFILE_SELECTOR" ] || {
            echo "silicon builds require COSMOS_SILICON_PROFILE=$PROFILE_SELECTOR" >&2
            exit 2
        }
        ELF="$OUT/simpleos_cosmos_openssd_silicon.elf"
        RECEIPT_PROFILE="$PROFILE_NAME"
        RECEIPT_SELECTOR="$PROFILE_SELECTOR"
        ;;
    *)
        echo "invalid COSMOS_BUILD_MODE: $MODE (expected qemu or silicon)" >&2
        exit 2
        ;;
esac

case "${1:-}" in
    "") ;;
    --run) ;;
    *) echo "usage: $0 [--run]" >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || {
    echo "usage: $0 [--run]" >&2
    exit 2
}

CLANG="${CLANG:-clang}"
LLD="${LLD:-ld.lld}"
READELF="${READELF:-readelf}"
NM="${NM:-nm}"
SIMPLE_BINARY="${SIMPLE_BINARY:-}"
for tool in "$CLANG" "$LLD" "$READELF" "$NM" awk sed grep cmp; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "missing-tool: $tool" >&2
        exit 2
    }
done
[ -x "$SIMPLE" ] || {
    echo "missing executable pure-Simple compiler: $SIMPLE" >&2
    exit 2
}
BOOTSTRAP_STAGE3_FACADE_PATH="$ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$ROOT/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
SIMPLE_CANONICAL="$(bootstrap_stage3_canonical_file "$SIMPLE")" || {
    echo "cannot resolve pure-Simple compiler canonically: $SIMPLE" >&2
    exit 2
}
SIMPLE_PROVENANCE="${SIMPLE_PROVENANCE:-${SIMPLE_CANONICAL}.provenance.env}"
stage4_verify_candidate_provenance \
    "$SIMPLE_PROVENANCE" "$SIMPLE_CANONICAL" "$ROOT" || {
    echo "pure-Simple Cosmos policy objects require admitted Stage-4 provenance" >&2
    exit 2
}
SIMPLE="$SIMPLE_CANONICAL"
SIMPLE_SHA256_ADMITTED="$(cosmos_sha256_file "$SIMPLE")"
SIMPLE_PROVENANCE_SHA256_ADMITTED="$(
    cosmos_sha256_file "$SIMPLE_PROVENANCE"
)"
SIMPLE_IDENTITY="$($SIMPLE --version 2>&1 || true)"
case "$SIMPLE_IDENTITY" in
    *"Rust-built Simple binary is a bootstrap seed"*)
        echo "pure-Simple Cosmos policy objects require an admitted self-host compiler" >&2
        exit 2
        ;;
esac

[ -n "$SIMPLE_BINARY" ] || {
    echo "missing-tool: set SIMPLE_BINARY to an admitted Stage-4 Pure Simple compiler" >&2
    exit 2
}
case "$SIMPLE_BINARY" in
    /*) ;;
    *) echo "invalid-tool: SIMPLE_BINARY must be an absolute path" >&2; exit 2 ;;
esac
[ -x "$SIMPLE_BINARY" ] || {
    echo "missing-tool: Pure Simple compiler is not executable: $SIMPLE_BINARY" >&2
    exit 2
}
case "$SIMPLE_BINARY" in
    *compiler_rust*)
        echo "invalid-tool: Rust seed is forbidden for Cosmos FSBL" >&2
        exit 2
        ;;
esac
BOOTSTRAP_STAGE3_FACADE_PATH="$ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$ROOT/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
SIMPLE_BINARY="$(bootstrap_stage3_canonical_file "$SIMPLE_BINARY")" || {
    echo "invalid-tool: Pure Simple compiler path is not canonical" >&2
    exit 2
}
COSMOS_SIMPLE_COMPILER_PROVENANCE="${SIMPLE_BINARY}.provenance.env"
stage4_verify_candidate_provenance \
    "$COSMOS_SIMPLE_COMPILER_PROVENANCE" "$SIMPLE_BINARY" "$ROOT" || {
    echo "invalid-tool: Pure Simple compiler provenance is not admitted" >&2
    exit 2
}
COSMOS_SIMPLE_COMPILER="$SIMPLE_BINARY"
COSMOS_SIMPLE_COMPILER_VERSION="$($SIMPLE_BINARY --version 2>&1 | awk 'NF { print; exit }')"
COSMOS_SIMPLE_COMPILER_SHA256="$(cosmos_sha256_file "$SIMPLE_BINARY")"
COSMOS_SIMPLE_COMPILER_PROVENANCE_SHA256="$(
    cosmos_sha256_file "$COSMOS_SIMPLE_COMPILER_PROVENANCE"
)"
export COSMOS_SIMPLE_COMPILER COSMOS_SIMPLE_COMPILER_VERSION \
    COSMOS_SIMPLE_COMPILER_SHA256 COSMOS_SIMPLE_COMPILER_PROVENANCE \
    COSMOS_SIMPLE_COMPILER_PROVENANCE_SHA256

[ -n "$SIMPLE_BINARY" ] || {
    echo "missing-tool: set SIMPLE_BINARY to an admitted Stage-4 Pure Simple compiler" >&2
    exit 2
}
case "$SIMPLE_BINARY" in
    /*) ;;
    *) echo "invalid-tool: SIMPLE_BINARY must be an absolute path" >&2; exit 2 ;;
esac
[ -x "$SIMPLE_BINARY" ] || {
    echo "missing-tool: Pure Simple compiler is not executable: $SIMPLE_BINARY" >&2
    exit 2
}
case "$SIMPLE_BINARY" in
    *compiler_rust*)
        echo "invalid-tool: Rust seed is forbidden for Cosmos FSBL" >&2
        exit 2
        ;;
esac
BOOTSTRAP_STAGE3_FACADE_PATH="$ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$ROOT/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"
SIMPLE_BINARY="$(bootstrap_stage3_canonical_file "$SIMPLE_BINARY")" || {
    echo "invalid-tool: Pure Simple compiler path is not canonical" >&2
    exit 2
}
COSMOS_SIMPLE_COMPILER_PROVENANCE="${SIMPLE_BINARY}.provenance.env"
stage4_verify_candidate_provenance \
    "$COSMOS_SIMPLE_COMPILER_PROVENANCE" "$SIMPLE_BINARY" "$ROOT" || {
    echo "invalid-tool: Pure Simple compiler provenance is not admitted" >&2
    exit 2
}
COSMOS_SIMPLE_COMPILER="$SIMPLE_BINARY"
COSMOS_SIMPLE_COMPILER_VERSION="$($SIMPLE_BINARY --version 2>&1 | awk 'NF { print; exit }')"
COSMOS_SIMPLE_COMPILER_SHA256="$(cosmos_sha256_file "$SIMPLE_BINARY")"
COSMOS_SIMPLE_COMPILER_PROVENANCE_SHA256="$(
    cosmos_sha256_file "$COSMOS_SIMPLE_COMPILER_PROVENANCE"
)"
export COSMOS_SIMPLE_COMPILER COSMOS_SIMPLE_COMPILER_VERSION \
    COSMOS_SIMPLE_COMPILER_SHA256 COSMOS_SIMPLE_COMPILER_PROVENANCE \
    COSMOS_SIMPLE_COMPILER_PROVENANCE_SHA256

OBJ="$OUT/cosmos-$MODE"
RECEIPT="$ELF.receipt"
OBJECT_RECEIPT="$ELF.objects"
ELF_TMP="$ELF.tmp.$$"
RECEIPT_TMP="$RECEIPT.tmp.$$"
OBJECT_RECEIPT_TMP="$OBJECT_RECEIPT.tmp.$$"
OBJECT_RECEIPT_AFTER="$OBJECT_RECEIPT.after.$$"
LOADS_TMP="$RECEIPT.loads.$$"
SOURCES_BEFORE="$RECEIPT.sources-before.$$"
SOURCES_AFTER="$RECEIPT.sources-after.$$"
cleanup() {
    rm -f "$ELF_TMP" "$RECEIPT_TMP" "$LOADS_TMP" \
        "$OBJECT_RECEIPT_TMP" "$OBJECT_RECEIPT_AFTER" \
        "$SOURCES_BEFORE" "$SOURCES_AFTER"
}
trap cleanup EXIT HUP INT TERM

mkdir -p "$OUT"
rm -rf "$OBJ"
mkdir -p "$OBJ"
rm -f "$ELF" "$RECEIPT" "$OBJECT_RECEIPT"
cosmos_write_source_manifest "$SCRIPT_DIR" "$SOURCES_BEFORE" || {
    echo "cannot capture build inputs" >&2
    exit 1
}

CFLAGS="--target=armv7-unknown-none-eabihf -mcpu=cortex-a9 -marm -mfloat-abi=hard -ffreestanding -nostdlib -fno-builtin -Wall -Wextra -Werror"
if [ "$MODE" = silicon ]; then
    CFLAGS="$CFLAGS -DCOSMOS_SILICON -include $PROFILE_HEADER"
fi

"$CLANG" $CFLAGS -c "$SCRIPT_DIR/cosmos_start.S" -o "$OBJ/cosmos_start.o"
"$CLANG" $CFLAGS -O0 -c "$SCRIPT_DIR/cosmos_uart.c" -o "$OBJ/cosmos_uart.o"
COSMOS_SIMPLE_FSBL_OBJECT="$OBJ/cosmos_fsbl.o"
export COSMOS_SIMPLE_FSBL_OBJECT
SIMPLE_NO_STUB_FALLBACK=1 "$SIMPLE_BINARY" native-build --backend llvm \
    --source "$ROOT/src" --entry "$SCRIPT_DIR/cosmos_fsbl.spl" \
    --entry-closure --target armv7-unknown-none-eabihf --emit-object \
    --cache-dir "$OBJ/simple-cache" -o "$COSMOS_SIMPLE_FSBL_OBJECT"
[ "$(cosmos_sha256_file "$SIMPLE_BINARY")" = \
    "$COSMOS_SIMPLE_COMPILER_SHA256" ] || {
    echo "invalid-artifact: Pure Simple compiler changed during FSBL build" >&2
    exit 1
}
FSBL_HEADER="$(LC_ALL=C "$READELF" -hW "$COSMOS_SIMPLE_FSBL_OBJECT")"
printf '%s\n' "$FSBL_HEADER" | grep -Eq 'Class:[[:space:]]+ELF32' &&
    printf '%s\n' "$FSBL_HEADER" | grep -Eq 'Type:[[:space:]]+REL([[:space:]]|$)' &&
    printf '%s\n' "$FSBL_HEADER" | grep -Eq 'Machine:[[:space:]]+ARM([[:space:]]|$)' &&
    printf '%s\n' "$FSBL_HEADER" | grep -Eq 'Flags:.*hard-float ABI' || {
    echo "invalid-artifact: Pure Simple FSBL object is not ARM32 hard-float ET_REL" >&2
    exit 1
}
"$NM" "$COSMOS_SIMPLE_FSBL_OBJECT" |
    grep -Eq '[[:space:]]T[[:space:]]+cosmos_fsbl_validate_handoff$' &&
    "$NM" "$COSMOS_SIMPLE_FSBL_OBJECT" |
        grep -Eq '[[:space:]]T[[:space:]]+cosmos_fsbl_selftest$' || {
    echo "invalid-artifact: Pure Simple FSBL object lacks the historical C ABI" >&2
    exit 1
}
COSMOS_SIMPLE_FSBL_OBJECT_SHA256="$(
    cosmos_sha256_file "$COSMOS_SIMPLE_FSBL_OBJECT"
)"
export COSMOS_SIMPLE_FSBL_OBJECT_SHA256
OBJECTS="$OBJ/cosmos_start.o $OBJ/cosmos_uart.o $COSMOS_SIMPLE_FSBL_OBJECT"
for unit in cosmos_runtime cosmos_mmu_cache cosmos_smp_gic \
    cosmos_nfc cosmos_pcie cosmos_nvme_firmware cosmos_nvme_pcie_adapter \
    cosmos_nvme_admin cosmos_nvme_dispatch cosmos_ftl \
    cosmos_ftl_nfc_backend cosmos_nvme_ftl_media cosmos_storage
do
    "$CLANG" $CFLAGS -O2 -c "$SCRIPT_DIR/$unit.c" -o "$OBJ/$unit.o"
    OBJECTS="$OBJECTS $OBJ/$unit.o"
done

cosmos_policy_exports() {
    awk '
        /@export\("C"/ {
            if ($0 ~ /name: "/) {
                line = $0
                sub(/^.*name: "/, "", line)
                sub(/".*$/, "", line)
                print line
                pending = 0
            } else {
                pending = 1
            }
            next
        }
        pending && /^[[:space:]]*(pub[[:space:]]+)?fn[[:space:]]+/ {
            line = $0
            sub(/^[[:space:]]*/, "", line)
            sub(/^pub[[:space:]]+/, "", line)
            sub(/^fn[[:space:]]+/, "", line)
            sub(/\(.*/, "", line)
            print line
            pending = 0
        }
    ' "$1" | LC_ALL=C sort -u
}

cosmos_verify_simple_unchanged() {
    _cp_label="$1"
    stage4_verify_candidate_provenance \
        "$SIMPLE_PROVENANCE" "$SIMPLE" "$ROOT" || {
        echo "pure-Simple compiler provenance changed during $_cp_label emission" >&2
        exit 1
    }
    [ "$(cosmos_sha256_file "$SIMPLE")" = "$SIMPLE_SHA256_ADMITTED" ] &&
        [ "$(cosmos_sha256_file "$SIMPLE_PROVENANCE")" = \
            "$SIMPLE_PROVENANCE_SHA256_ADMITTED" ] || {
        echo "pure-Simple compiler or provenance changed during $_cp_label emission" >&2
        exit 1
    }
}

cosmos_validate_policy_object() {
    _cp_label="$1"
    _cp_object="$2"
    _cp_expected="$3"
    _cp_undefined="$4"
    _cp_target="$5"
    _cp_header="$("$READELF" -hW "$_cp_object")"
    case "$_cp_target" in
        arm)
            printf '%s\n' "$_cp_header" | grep -Eq 'Class:[[:space:]]+ELF32' &&
                printf '%s\n' "$_cp_header" | grep -Eq 'Type:[[:space:]]+REL' &&
                printf '%s\n' "$_cp_header" | grep -Eq 'Machine:[[:space:]]+ARM' || {
                echo "invalid $_cp_label ARM policy object" >&2
                exit 1
            }
            _cp_attributes="$("$READELF" -AW "$_cp_object")"
            printf '%s\n' "$_cp_attributes" | grep -Fq 'Tag_CPU_arch: v7' &&
                printf '%s\n' "$_cp_attributes" |
                    grep -Fq 'Tag_CPU_name: "cortex-a9"' &&
                printf '%s\n' "$_cp_attributes" |
                    grep -Fq 'Tag_CPU_arch_profile: Application' || {
                echo "invalid $_cp_label ARM Cortex-A9 attributes" >&2
                exit 1
            }
            if printf '%s\n' "$_cp_attributes" |
                    grep -Eq 'Tag_FP_arch:|Tag_ABI_HardFP_use:|Tag_ABI_VFP_args:.*VFP registers'; then
                echo "invalid $_cp_label ARM hard-float attributes" >&2
                exit 1
            fi
            ;;
        host)
            printf '%s\n' "$_cp_header" | grep -Eq 'Class:[[:space:]]+ELF64' &&
                printf '%s\n' "$_cp_header" | grep -Eq 'Type:[[:space:]]+REL' &&
                printf '%s\n' "$_cp_header" |
                    grep -Eq 'Machine:[[:space:]]+(Advanced Micro Devices X86-64|x86-64)' || {
                echo "invalid $_cp_label host policy object" >&2
                exit 1
            }
            ;;
        *) echo "invalid policy target: $_cp_target" >&2; exit 2 ;;
    esac
    _cp_symbols="$("$READELF" -sW "$_cp_object")"
    _cp_actual="$(printf '%s\n' "$_cp_symbols" |
        awk '$5 == "GLOBAL" && $6 == "DEFAULT" && $7 != "UND" && $8 != "" { print $8 }' |
        LC_ALL=C sort -u)"
    _cp_wanted="$(LC_ALL=C sort -u "$_cp_expected")"
    [ "$_cp_actual" = "$_cp_wanted" ] || {
        echo "invalid $_cp_label $_cp_target defined-global closure" >&2
        printf '%s\n' "$_cp_actual" >&2
        exit 1
    }
    _cp_actual_undefined="$(printf '%s\n' "$_cp_symbols" |
        awk '$7 == "UND" && $8 != "" { print $8 }' | LC_ALL=C sort -u)"
    [ "$_cp_actual_undefined" = "$_cp_undefined" ] || {
        echo "invalid $_cp_label $_cp_target undefined-symbol closure" >&2
        printf '%s\n' "$_cp_actual_undefined" >&2
        exit 1
    }
    printf '%s\n' "$_cp_symbols" |
        awk 'tolower($8) ~ /(malloc|calloc|realloc|alloc_object|gc_alloc)/ ||
             ($7 != "UND" && ($8 == "main" || $8 == "_start" ||
              $8 == "__simple_main" || $8 ~ /^rt_/)) { bad = 1 }
             END { exit bad }' || {
        echo "invalid $_cp_label $_cp_target runtime/allocation symbol" >&2
        exit 1
    }
}

HOST_POLICY_OBJECTS=""
ARM_POLICY_OBJECTS=""
LINKED_POLICY_OBJECTS=""
cosmos_build_policy_pair() {
    _cp_base="$1"
    _cp_label="$2"
    _cp_undefined="$3"
    _cp_arm_mode="$4"
    _cp_source="$SCRIPT_DIR/$_cp_base.spl"
    _cp_expected="$OBJ/$_cp_base.exports"
    cosmos_policy_exports "$_cp_source" >"$_cp_expected"
    [ -s "$_cp_expected" ] || {
        echo "missing C exports in $_cp_source" >&2
        exit 1
    }
    SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB="$ROOT/src" \
        "$SIMPLE" native-build --backend llvm --source "$SCRIPT_DIR" \
        --entry-closure --entry "$_cp_source" \
        --target x86_64-unknown-linux-gnu --emit-object --no-mangle \
        --cache-dir "$OBJ/$_cp_base-host-cache" \
        -o "$OBJ/${_cp_base}_host.o"
    cosmos_verify_simple_unchanged "$_cp_label host policy"
    cosmos_validate_policy_object "$_cp_label" \
        "$OBJ/${_cp_base}_host.o" "$_cp_expected" "$_cp_undefined" host
    HOST_POLICY_OBJECTS="$HOST_POLICY_OBJECTS $OBJ/${_cp_base}_host.o"
    if [ "$_cp_arm_mode" = build ]; then
        SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB="$ROOT/src" \
            "$SIMPLE" native-build --backend llvm --source "$SCRIPT_DIR" \
            --entry-closure --entry "$_cp_source" \
            --target armv7-unknown-none-eabi --emit-object --no-mangle \
            --cache-dir "$OBJ/$_cp_base-arm-cache" \
            -o "$OBJ/${_cp_base}_simple.o"
        cosmos_verify_simple_unchanged "$_cp_label ARM policy"
        OBJECTS="$OBJECTS $OBJ/${_cp_base}_simple.o"
    fi
    cosmos_validate_policy_object "$_cp_label" \
        "$OBJ/${_cp_base}_simple.o" "$_cp_expected" "$_cp_undefined" arm
    ARM_POLICY_OBJECTS="$ARM_POLICY_OBJECTS $OBJ/${_cp_base}_simple.o"
}
SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB="$ROOT/src" "$SIMPLE" native-build \
    --backend llvm \
    --source "$SCRIPT_DIR" \
    --entry-closure \
    --entry "$SCRIPT_DIR/cosmos_boot_policy.spl" \
    --target armv7-unknown-none-eabi \
    --emit-object \
    --no-mangle \
    --cache-dir "$OBJ/simple-boot-policy-cache" \
    -o "$OBJ/cosmos_boot_policy_simple.o"
stage4_verify_candidate_provenance \
    "$SIMPLE_PROVENANCE" "$SIMPLE" "$ROOT" || {
    echo "pure-Simple compiler provenance changed during boot-policy emission" >&2
    exit 1
}
[ "$(cosmos_sha256_file "$SIMPLE")" = "$SIMPLE_SHA256_ADMITTED" ] &&
    [ "$(cosmos_sha256_file "$SIMPLE_PROVENANCE")" = \
        "$SIMPLE_PROVENANCE_SHA256_ADMITTED" ] || {
    echo "pure-Simple compiler or provenance changed during boot-policy emission" >&2
    exit 1
}
BOOT_POLICY_OBJECT_HEADER="$(
    "$READELF" -hW "$OBJ/cosmos_boot_policy_simple.o"
)"
printf '%s\n' "$BOOT_POLICY_OBJECT_HEADER" | grep -Eq \
    'Class:[[:space:]]+ELF32' &&
    printf '%s\n' "$BOOT_POLICY_OBJECT_HEADER" | grep -Eq \
        'Type:[[:space:]]+REL' &&
    printf '%s\n' "$BOOT_POLICY_OBJECT_HEADER" | grep -Eq \
        'Machine:[[:space:]]+ARM' || {
    echo "invalid pure-Simple boot-policy object: expected ELF32 ARM REL" >&2
    exit 1
}
BOOT_POLICY_OBJECT_ATTRIBUTES="$(
    "$READELF" -AW "$OBJ/cosmos_boot_policy_simple.o"
)"
printf '%s\n' "$BOOT_POLICY_OBJECT_ATTRIBUTES" |
    grep -Fq 'Tag_CPU_arch: v7' &&
    printf '%s\n' "$BOOT_POLICY_OBJECT_ATTRIBUTES" |
        grep -Fq 'Tag_CPU_name: "cortex-a9"' &&
printf '%s\n' "$BOOT_POLICY_OBJECT_ATTRIBUTES" |
        grep -Fq 'Tag_CPU_arch_profile: Application' || {
    echo "invalid pure-Simple boot-policy object: Cortex-A9 profile missing" >&2
    exit 1
}
if printf '%s\n' "$BOOT_POLICY_OBJECT_ATTRIBUTES" |
        grep -Eq 'Tag_FP_arch:|Tag_ABI_HardFP_use:|Tag_ABI_VFP_args:.*VFP registers'; then
    echo "invalid pure-Simple boot-policy object: hard-float/VFP attributes forbidden" >&2
    exit 1
fi
BOOT_POLICY_OBJECT_SYMBOLS="$(
    "$READELF" -sW "$OBJ/cosmos_boot_policy_simple.o"
)"
BOOT_POLICY_EXPECTED_GLOBALS='cosmos_boot_policy_coverage_reset
cosmos_boot_policy_coverage_low
cosmos_boot_policy_coverage_high
cosmos_boot_policy_coverage_required_low
cosmos_boot_policy_coverage_required_high
cosmos_boot_policy_coverage_decisions
cosmos_boot_policy_uart_should_attempt
cosmos_boot_policy_uart_next_enabled
cosmos_boot_policy_exception_should_capture
cosmos_boot_policy_exception_message_kind
cosmos_boot_policy_status_kind
cosmos_boot_policy_stage_allowed
cosmos_boot_policy_software_ready
cosmos_boot_policy_selftest
cosmos_boot_policy_handoff_allows_devices
cosmos_boot_policy_storage_init_allowed
cosmos_boot_policy_secondary_release_allowed
cosmos_boot_policy_terminal_verdict
cosmos_boot_policy_irq_enable_allowed
cosmos_boot_policy_storage_poll_allowed
cosmos_boot_policy_storage_poll_action'
for symbol in $BOOT_POLICY_EXPECTED_GLOBALS
do
    printf '%s\n' "$BOOT_POLICY_OBJECT_SYMBOLS" |
        awk -v symbol="$symbol" \
            '$4 == "FUNC" && $5 == "GLOBAL" && $6 == "DEFAULT" &&
