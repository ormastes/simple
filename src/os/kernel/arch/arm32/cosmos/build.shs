    echo "invalid pure-Simple PCIe adapter policy object: Cortex-A9 profile missing" >&2
    exit 1
}
ADAPTER_POLICY_SYMBOLS="$(
    "$READELF" -sW "$OBJ/cosmos_nvme_pcie_adapter_policy_simple.o"
)"
ADAPTER_POLICY_EXPORT_COUNT="$(
    printf '%s\n' "$ADAPTER_POLICY_SYMBOLS" |
        awk '$4 == "FUNC" && $5 == "GLOBAL" && $7 != "UND" &&
             $8 ~ /^cosmos_nvme_pcie_adapter_policy_/ { count++ }
             END { print count + 0 }'
)"
[ "$ADAPTER_POLICY_EXPORT_COUNT" = 39 ] || {
    echo "invalid pure-Simple PCIe adapter policy object: expected 39 exports" >&2
    exit 1
}
printf '%s\n' "$ADAPTER_POLICY_SYMBOLS" |
    awk '$7 == "UND" && $8 != "" { bad = 1 }
         tolower($8) ~ /(malloc|calloc|realloc|alloc_object|gc_alloc)/ {
             bad = 1
         }
         $7 != "UND" && ($8 == "main" || $8 == "_start" ||
                         $8 == "__simple_main" || $8 ~ /^rt_/) { bad = 1 }
         END { exit bad }' || {
    echo "invalid pure-Simple PCIe adapter policy object: runtime/allocation dependency" >&2
    exit 1
}
OBJECTS="$OBJECTS $OBJ/cosmos_nvme_pcie_adapter_policy_simple.o"
SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB="$ROOT/src" "$SIMPLE" native-build \
    --backend llvm \
    --source "$SCRIPT_DIR" \
    --entry-closure \
    --entry "$SCRIPT_DIR/cosmos_smp_gic_policy.spl" \
    --target armv7-unknown-none-eabi \
    --emit-object \
    --no-mangle \
    --cache-dir "$OBJ/simple-smp-gic-policy-cache" \
    -o "$OBJ/cosmos_smp_gic_policy_simple.o"
stage4_verify_candidate_provenance \
    "$SIMPLE_PROVENANCE" "$SIMPLE" "$ROOT" || {
    echo "pure-Simple compiler provenance changed during SMP/GIC policy emission" >&2
    exit 1
}
[ "$(cosmos_sha256_file "$SIMPLE")" = "$SIMPLE_SHA256_ADMITTED" ] &&
    [ "$(cosmos_sha256_file "$SIMPLE_PROVENANCE")" = \
        "$SIMPLE_PROVENANCE_SHA256_ADMITTED" ] || {
    echo "pure-Simple compiler or provenance changed during SMP/GIC policy emission" >&2
    exit 1
}
SMP_GIC_POLICY_OBJECT_HEADER="$(
    "$READELF" -hW "$OBJ/cosmos_smp_gic_policy_simple.o"
)"
printf '%s\n' "$SMP_GIC_POLICY_OBJECT_HEADER" | grep -Eq \
    'Class:[[:space:]]+ELF32' &&
    printf '%s\n' "$SMP_GIC_POLICY_OBJECT_HEADER" | grep -Eq \
        'Type:[[:space:]]+REL' &&
    printf '%s\n' "$SMP_GIC_POLICY_OBJECT_HEADER" | grep -Eq \
        'Machine:[[:space:]]+ARM' || {
    echo "invalid pure-Simple SMP/GIC policy object: expected ELF32 ARM REL" >&2
    exit 1
}
SMP_GIC_POLICY_OBJECT_ATTRIBUTES="$(
    "$READELF" -AW "$OBJ/cosmos_smp_gic_policy_simple.o"
)"
printf '%s\n' "$SMP_GIC_POLICY_OBJECT_ATTRIBUTES" |
    grep -Fq 'Tag_CPU_arch: v7' &&
    printf '%s\n' "$SMP_GIC_POLICY_OBJECT_ATTRIBUTES" |
        grep -Fq 'Tag_CPU_name: "cortex-a9"' &&
    printf '%s\n' "$SMP_GIC_POLICY_OBJECT_ATTRIBUTES" |
        grep -Fq 'Tag_CPU_arch_profile: Application' || {
    echo "invalid pure-Simple SMP/GIC policy object: Cortex-A9 profile missing" >&2
    exit 1
}
if printf '%s\n' "$SMP_GIC_POLICY_OBJECT_ATTRIBUTES" |
        grep -Eq 'Tag_CPU_name:.*cortex-a7|Tag_FP_arch:.*VFPv4|Tag_ABI_VFP_args:.*VFP registers'; then
    echo "invalid pure-Simple SMP/GIC policy object: not Cortex-A9 soft-float compatible" >&2
    exit 1
fi
SMP_GIC_POLICY_OBJECT_SYMBOLS="$(
    "$READELF" -sW "$OBJ/cosmos_smp_gic_policy_simple.o"
)"
for symbol in \
    cosmos_smp_gic_policy_coverage_reset \
    cosmos_smp_gic_policy_coverage_mask \
    cosmos_smp_gic_policy_coverage_required \
    cosmos_smp_gic_policy_coverage_decisions \
    cosmos_gic_limit_words \
    cosmos_gic_words_from_typer \
    cosmos_gic_target_for_word \
    cosmos_smp_next_generation \
    cosmos_smp_release_request_valid \
    cosmos_smp_ready_observed \
    cosmos_smp_secondary_state \
    cosmos_smp_ack_observed \
    cosmos_smp_poll_allowed \
    cosmos_gic_irq_id \
    cosmos_gic_irq_is_spurious \
    cosmos_gic_disable_offset \
    cosmos_gic_disable_mask \
    cosmos_gic_byte_shift \
    cosmos_gic_config_shift \
    cosmos_gic_priority_offset \
    cosmos_gic_target_offset \
    cosmos_gic_config_offset \
    cosmos_gic_priority_value \
    cosmos_gic_target_cpu0_value \
    cosmos_gic_level_config_value \
    cosmos_gic_pcie_irq_in_range \
    cosmos_gic_eoir_required \
    cosmos_gic_quiesce_kind
do
    printf '%s\n' "$SMP_GIC_POLICY_OBJECT_SYMBOLS" |
        awk -v symbol="$symbol" \
            '$4 == "FUNC" && $5 == "GLOBAL" && $6 == "DEFAULT" &&
             $7 != "UND" && $8 == symbol { count++ }
             END { exit count != 1 }' || {
        echo "invalid pure-Simple SMP/GIC policy export: $symbol" >&2
        exit 1
    }
done
SMP_GIC_POLICY_OBJECT_UNDEFINED="$(
    printf '%s\n' "$SMP_GIC_POLICY_OBJECT_SYMBOLS" |
        awk '$7 == "UND" && $8 != "" { print $8 }' |
        LC_ALL=C sort -u
)"
[ -z "$SMP_GIC_POLICY_OBJECT_UNDEFINED" ] || {
    echo "invalid pure-Simple SMP/GIC policy undefined-symbol closure" >&2
    printf '%s\n' "$SMP_GIC_POLICY_OBJECT_UNDEFINED" >&2
    exit 1
}
printf '%s\n' "$SMP_GIC_POLICY_OBJECT_SYMBOLS" |
    awk '$7 != "UND" && ($8 == "main" || $8 == "_start" ||
                         $8 == "__simple_main" || $8 ~ /^rt_/) { bad = 1 }
         END { exit bad }' || {
    echo "invalid pure-Simple SMP/GIC policy object: forbidden entry/runtime symbol" >&2
    exit 1
}
OBJECTS="$OBJECTS $OBJ/cosmos_smp_gic_policy_simple.o"
SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB="$ROOT/src" "$SIMPLE" native-build \
    --backend llvm \
    --source "$SCRIPT_DIR" \
    --entry-closure \
    --entry "$SCRIPT_DIR/cosmos_mmu_cache_policy.spl" \
    --target armv7-unknown-none-eabi \
    --emit-object \
    --no-mangle \
    --cache-dir "$OBJ/simple-mmu-policy-cache" \
    -o "$OBJ/cosmos_mmu_cache_policy_simple.o"
stage4_verify_candidate_provenance \
    "$SIMPLE_PROVENANCE" "$SIMPLE" "$ROOT" || {
    echo "pure-Simple compiler provenance changed during MMU policy emission" >&2
    exit 1
}
MMU_POLICY_HEADER="$($READELF -hW "$OBJ/cosmos_mmu_cache_policy_simple.o")"
printf '%s\n' "$MMU_POLICY_HEADER" | grep -Eq 'Class:[[:space:]]+ELF32' &&
    printf '%s\n' "$MMU_POLICY_HEADER" | grep -Eq 'Type:[[:space:]]+REL' &&
    printf '%s\n' "$MMU_POLICY_HEADER" | grep -Eq 'Machine:[[:space:]]+ARM' || {
    echo "invalid pure-Simple MMU policy object: expected ELF32 ARM REL" >&2
    exit 1
}
MMU_POLICY_ATTRIBUTES="$($READELF -AW "$OBJ/cosmos_mmu_cache_policy_simple.o")"
printf '%s\n' "$MMU_POLICY_ATTRIBUTES" | grep -Fq 'Tag_CPU_arch: v7' &&
    printf '%s\n' "$MMU_POLICY_ATTRIBUTES" | grep -Fq 'Tag_CPU_name: "cortex-a9"' &&
    printf '%s\n' "$MMU_POLICY_ATTRIBUTES" |
        grep -Fq 'Tag_CPU_arch_profile: Application' || {
    echo "invalid pure-Simple MMU policy object: Cortex-A9 profile missing" >&2
    exit 1
}
MMU_POLICY_SYMBOLS="$($READELF -sW "$OBJ/cosmos_mmu_cache_policy_simple.o")"
for symbol in \
    cosmos_mmu_cache_policy_cache_way_shift \
    cosmos_mmu_cache_policy_cache_setway_operand \
    cosmos_mmu_cache_policy_ttbr0_value \
    cosmos_mmu_cache_policy_sctlr_apply_policy \
    cosmos_mmu_cache_policy_sctlr_policy_valid \
    cosmos_mmu_cache_policy_control_registers_valid \
    cosmos_mmu_cache_policy_control_policy_contract \
    cosmos_mmu_cache_policy_scu_invalidate_mask \
    cosmos_mmu_cache_policy_cache_enable_allowed \
    cosmos_mmu_cache_policy_section_descriptor \
    cosmos_mmu_cache_policy_coarse_descriptor \
    cosmos_mmu_cache_policy_small_page_descriptor \
    cosmos_mmu_cache_policy_small_page_cached_rx_descriptor \
    cosmos_mmu_cache_policy_small_page_cached_rw_xn_descriptor \
    cosmos_mmu_cache_policy_l2_descriptor_executable \
    cosmos_mmu_cache_policy_l2_descriptor_priv_writable \
    cosmos_mmu_cache_policy_l2_descriptor_write_execute \
    cosmos_mmu_cache_policy_firmware_l2_descriptor_for_address \
    cosmos_mmu_cache_policy_device_section \
    cosmos_mmu_cache_policy_l1_descriptor_for_address \
    cosmos_mmu_cache_policy_ocm_l2_descriptor_for_address \
    cosmos_mmu_cache_policy_mmu_poll_allowed
do
    printf '%s\n' "$MMU_POLICY_SYMBOLS" |
        awk -v symbol="$symbol" \
            '$4 == "FUNC" && $5 == "GLOBAL" && $6 == "DEFAULT" &&
             $7 != "UND" && $8 == symbol { count++ }
             END { exit count != 1 }' || {
        echo "invalid pure-Simple MMU policy export: $symbol" >&2
        exit 1
    }
done
MMU_POLICY_UNDEFINED="$(
    printf '%s\n' "$MMU_POLICY_SYMBOLS" |
        awk '$7 == "UND" && $8 != "" { print $8 }' |
        LC_ALL=C sort -u
)"
[ -z "$MMU_POLICY_UNDEFINED" ] || {
    echo "invalid pure-Simple MMU policy undefined-symbol closure" >&2
    printf '%s\n' "$MMU_POLICY_UNDEFINED" >&2
    exit 1
}
printf '%s\n' "$MMU_POLICY_SYMBOLS" |
    awk '$7 != "UND" && ($8 == "main" || $8 == "_start" ||
                         $8 == "__simple_main" || $8 ~ /^rt_/) { bad = 1 }
         END { exit bad }' || {
    echo "invalid pure-Simple MMU policy object: forbidden entry/runtime symbol" >&2
    exit 1
}
OBJECTS="$OBJECTS $OBJ/cosmos_mmu_cache_policy_simple.o"

STORAGE_POLICY_UNDEFINED='cosmos_storage_bridge_admin_init
cosmos_storage_bridge_backend_format
cosmos_storage_bridge_backend_init
cosmos_storage_bridge_backend_mount
cosmos_storage_bridge_dispatch_init
cosmos_storage_bridge_dispatch_poll
cosmos_storage_bridge_factory_initialize_erased
cosmos_storage_bridge_ftl_init
cosmos_storage_bridge_ftl_recover
cosmos_storage_bridge_gc_step
cosmos_storage_bridge_io_init
cosmos_storage_bridge_is_qemu
cosmos_storage_bridge_media_init'

# Preserve the production dependency order from acquisition through lifecycle.
cosmos_build_policy_pair cosmos_nfc_policy "NFC" "" build
cosmos_build_policy_pair cosmos_ftl_nfc_backend_policy \
    "FTL NFC backend" "" build
cosmos_build_policy_pair cosmos_ftl_policy "FTL" "" build
cosmos_build_policy_pair cosmos_nvme_media_policy "NVMe media" "" build
cosmos_build_policy_pair cosmos_nvme_admin_policy "NVMe admin" "" build
cosmos_build_policy_pair cosmos_nvme_pcie_adapter_policy \
    "NVMe PCIe adapter" "" existing
cosmos_build_policy_pair cosmos_pcie_residual_policy "PCIe residual" "" build
cosmos_build_policy_pair cosmos_storage_policy "storage" \
    "$STORAGE_POLICY_UNDEFINED" build

cosmos_link_policy_evidence() {
    _cp_label="$1"
    _cp_c_object="$2"
    _cp_policy_object="$3"
    _cp_unresolved_prefix="$4"
    _cp_output="$5"
    "$LLD" -r "$_cp_c_object" "$_cp_policy_object" -o "$_cp_output"
    _cp_remaining="$("$READELF" -sW "$_cp_output" |
        awk -v prefix="$_cp_unresolved_prefix" \
            '$7 == "UND" && index($8, prefix) == 1 { print $8 }' |
        LC_ALL=C sort -u)"
    [ -z "$_cp_remaining" ] || {
        echo "$_cp_label C-to-Simple policy link remains unresolved" >&2
        printf '%s\n' "$_cp_remaining" >&2
        exit 1
    }
    LINKED_POLICY_OBJECTS="$LINKED_POLICY_OBJECTS $_cp_output"
}

cosmos_link_policy_evidence NFC "$OBJ/cosmos_nfc.o" \
    "$OBJ/cosmos_nfc_policy_simple.o" cosmos_nfc_policy_ \
    "$OBJ/cosmos_nfc_policy_linked.o"
cosmos_link_policy_evidence "FTL NFC backend" \
    "$OBJ/cosmos_ftl_nfc_backend.o" \
    "$OBJ/cosmos_ftl_nfc_backend_policy_simple.o" \
    cosmos_ftl_nfc_backend_policy_ \
    "$OBJ/cosmos_ftl_nfc_backend_policy_linked.o"
cosmos_link_policy_evidence FTL "$OBJ/cosmos_ftl.o" \
    "$OBJ/cosmos_ftl_policy_simple.o" cosmos_ftl_policy_ \
    "$OBJ/cosmos_ftl_policy_linked.o"
cosmos_link_policy_evidence "NVMe media" "$OBJ/cosmos_nvme_ftl_media.o" \
    "$OBJ/cosmos_nvme_media_policy_simple.o" cosmos_nvme_media_policy_ \
    "$OBJ/cosmos_nvme_media_policy_linked.o"
cosmos_link_policy_evidence "NVMe admin" "$OBJ/cosmos_nvme_admin.o" \
    "$OBJ/cosmos_nvme_admin_policy_simple.o" cosmos_nvme_admin_policy_ \
    "$OBJ/cosmos_nvme_admin_policy_linked.o"
cosmos_link_policy_evidence "NVMe PCIe adapter" \
    "$OBJ/cosmos_nvme_pcie_adapter.o" \
    "$OBJ/cosmos_nvme_pcie_adapter_policy_simple.o" \
    cosmos_nvme_pcie_adapter_policy_ \
    "$OBJ/cosmos_nvme_pcie_adapter_policy_linked.o"
cosmos_link_policy_evidence "PCIe residual" "$OBJ/cosmos_pcie.o" \
    "$OBJ/cosmos_pcie_residual_policy_simple.o" cosmos_pcie_residual_policy_ \
    "$OBJ/cosmos_pcie_residual_policy_linked.o"
cosmos_link_policy_evidence storage "$OBJ/cosmos_storage.o" \
    "$OBJ/cosmos_storage_policy_simple.o" cosmos_storage_bridge_ \
    "$OBJ/cosmos_storage_policy_linked.o"

cosmos_write_object_manifest() {
    _cp_target="$1"
    shift
    : >"$_cp_target"
    for _cp_object in "$@"; do
        [ -f "$_cp_object" ] && [ -s "$_cp_object" ] || {
            echo "missing retained object: $_cp_object" >&2
            exit 1
        }
        chmod 0444 "$_cp_object"
        printf '%s  %s\n' "$(cosmos_sha256_file "$_cp_object")" \
            "$(basename "$_cp_object")" >>"$_cp_target"
    done
    LC_ALL=C sort -k2,2 -o "$_cp_target" "$_cp_target"
    awk '{ if (seen[$2]++) bad = 1 } END { exit bad || NR == 0 }' \
        "$_cp_target" || {
        echo "duplicate or empty retained object manifest" >&2
        exit 1
    }
}

# shellcheck disable=SC2086 # object paths are controlled and contain no spaces.
cosmos_write_object_manifest "$OBJECT_RECEIPT_TMP" \
    $OBJECTS $HOST_POLICY_OBJECTS $LINKED_POLICY_OBJECTS
[ "$(wc -l < "$OBJECT_RECEIPT_TMP" | tr -d ' ')" = 50 ] || {
    echo "invalid-artifact: retained object closure must contain exactly 50 objects" >&2
    exit 1
}
"$LLD" -T "$SCRIPT_DIR/cosmos_linker.ld" $OBJECTS -o "$ELF_TMP"
# Re-hash every input after linking; no mutable object may underpin the ELF.
cosmos_write_object_manifest "$OBJECT_RECEIPT_AFTER" \
    $OBJECTS $HOST_POLICY_OBJECTS $LINKED_POLICY_OBJECTS
cmp -s "$OBJECT_RECEIPT_TMP" "$OBJECT_RECEIPT_AFTER" || {
    echo "invalid-artifact: object inputs changed during final link" >&2
    exit 1
}
cosmos_write_source_manifest "$SCRIPT_DIR" "$SOURCES_AFTER" || {
    echo "cannot recapture build inputs" >&2
    exit 1
}
cmp -s "$SOURCES_BEFORE" "$SOURCES_AFTER" || {
    echo "invalid-artifact: build inputs changed during clean build" >&2
    exit 1
}

cosmos_validate_firmware_elf "$ELF_TMP" "$LOADS_TMP" || {
    echo "invalid-artifact: firmware ELF policy failed" >&2
    exit 1
}

SECTIONS="$("$READELF" -SW "$ELF_TMP")"
SYMBOLS="$("$READELF" -sW "$ELF_TMP")"
FINAL_UNDEFINED="$(printf '%s\n' "$SYMBOLS" |
    awk '$7 == "UND" && $8 != "" { print $8 }' | LC_ALL=C sort -u)"
[ -z "$FINAL_UNDEFINED" ] || {
    echo "invalid-artifact: final firmware has undefined symbols" >&2
    printf '%s\n' "$FINAL_UNDEFINED" >&2
    exit 1
}
for expected in "$OBJ"/*.exports; do
    while IFS= read -r symbol; do
        printf '%s\n' "$SYMBOLS" |
            awk -v symbol="$symbol" \
                '$5 == "GLOBAL" && $7 != "UND" && $8 == symbol { count++ }
                 END { exit count != 1 }' || {
            echo "invalid-artifact: final firmware policy export $symbol" >&2
            exit 1
        }
    done <"$expected"
done
case "$MODE" in
    qemu)
        if printf '%s\n' "$SECTIONS" |
                grep -Eq '\.note\.cosmos\.profile[[:space:]]+NOTE' ||
           printf '%s\n' "$SYMBOLS" | grep -Fq "$PROFILE_SYMBOL"; then
            echo "invalid-artifact: QEMU image is bound to a silicon profile" >&2
            exit 1
        fi
        ;;
    silicon)
        printf '%s\n' "$SECTIONS" |
            grep -Eq '\.note\.cosmos\.profile[[:space:]]+NOTE' || {
            echo "invalid-artifact: silicon image lacks Cosmos profile note" >&2
            exit 1
        }
        printf '%s\n' "$SYMBOLS" |
            awk -v symbol="$PROFILE_SYMBOL" \
                '$4 == "OBJECT" && $5 == "GLOBAL" && $8 == symbol { found = 1 }
                 END { exit !found }' || {
            echo "invalid-artifact: silicon image lacks exact Cosmos profile symbol" >&2
            exit 1
        }
        ;;
esac

cosmos_write_receipt "$SCRIPT_DIR" "$MODE" "$RECEIPT_PROFILE" \
    "$RECEIPT_SELECTOR" "$ELF_TMP" "$LOADS_TMP" "$RECEIPT_TMP" \
    "$SOURCES_BEFORE" "$OBJECT_RECEIPT_TMP" || {
    echo "invalid-artifact: failed to write build receipt" >&2
    exit 1
}
mv "$ELF_TMP" "$ELF"
mv "$RECEIPT_TMP" "$RECEIPT"
mv "$OBJECT_RECEIPT_TMP" "$OBJECT_RECEIPT"
ENTRY="$(sed -n 's/^entry=//p' "$LOADS_TMP")"
if [ "$MODE" = silicon ]; then
    echo "built $ELF (clean, profile=$PROFILE, entry=$ENTRY, receipt=$RECEIPT)"
else
    echo "built $ELF (clean, unbound, entry=$ENTRY, receipt=$RECEIPT)"
fi

if [ "${1:-}" = "--run" ]; then
    [ "$MODE" = qemu ] || {
        echo "--run requires COSMOS_BUILD_MODE=qemu" >&2
        exit 2
    }
    for tool in timeout qemu-system-arm; do
        command -v "$tool" >/dev/null 2>&1 || {
            echo "missing-tool: $tool" >&2
            exit 2
        }
    done
    echo "=== boot on qemu xilinx-zynq-a9 (UART1 -> stdio) ==="
    timeout 6 qemu-system-arm -M xilinx-zynq-a9 -display none -serial null -serial stdio \
        -kernel "$OUT/simpleos_cosmos_openssd.elf" || true
fi
