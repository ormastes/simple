# Pure-Simple Cortex-A9 MMU/cache policy for the Cosmos+ Zynq-7000 lane.
#
# CP15, MMIO, translation-table storage, barriers, and the public HAL ABI stay
# in C. Every exported function below is deterministic and side-effect free.

pub val COSMOS_MMU_POLICY_DECISION_COUNT: u32 = 37u32

val COSMOS_POLL_LIMIT: u32 = 1000000u32
val COSMOS_SMALL_PAGE_SIZE: u32 = 0x00001000u32
val COSMOS_SECTION_MASK: u32 = 0xFFF00000u32
val COSMOS_SMALL_PAGE_MASK: u32 = 0xFFFFF000u32

val COSMOS_DDR_IDENTITY_BASE: u32 = 0x00100000u32
val COSMOS_DDR_IDENTITY_END: u32 = 0x3FFFFFFFu32
val COSMOS_FIRMWARE_IDENTITY_BASE: u32 = 0x00100000u32
val COSMOS_FIRMWARE_IDENTITY_END: u32 = 0x001FFFFFu32
val COSMOS_NFC_DMA_IDENTITY_BASE: u32 = 0x00200000u32
val COSMOS_NFC_DMA_IDENTITY_END: u32 = 0x17FFFFFFu32
val COSMOS_OCM_HIGH: u32 = 0xFFFC0000u32
val COSMOS_SLCR_BASE: u32 = 0xF8000000u32
val COSMOS_GIC_CPU_BASE: u32 = 0xF8F00100u32
val COSMOS_NFC_BASE: u32 = 0x43C00000u32
val COSMOS_PCIE_BASE: u32 = 0x83C00000u32

val ARM_L1_COARSE: u32 = 0x00000001u32
val ARM_L1_SECTION: u32 = 0x00000002u32
val ARM_L1_B: u32 = 0x00000004u32
val ARM_L1_C: u32 = 0x00000008u32
val ARM_L1_XN: u32 = 0x00000010u32
val ARM_L1_TEX1: u32 = 0x00001000u32
val ARM_L1_AP_PRIV_RW: u32 = 0x00000400u32
val ARM_L1_SHAREABLE: u32 = 0x00010000u32

val ARM_L2_SMALL_PAGE: u32 = 0x00000002u32
val ARM_L2_XN: u32 = 0x00000001u32
val ARM_L2_B: u32 = 0x00000004u32
val ARM_L2_C: u32 = 0x00000008u32
val ARM_L2_AP_PRIV_RW: u32 = 0x00000010u32
val ARM_L2_APX: u32 = 0x00000200u32
val ARM_L2_AP_PRIV_RO: u32 = ARM_L2_AP_PRIV_RW | ARM_L2_APX
val ARM_L2_TEX1: u32 = 0x00000040u32
val ARM_L2_SHAREABLE: u32 = 0x00000400u32

val ARM_NORMAL_CACHED: u32 = ARM_L1_TEX1 | ARM_L1_C | ARM_L1_B |
    ARM_L1_SHAREABLE
val ARM_NORMAL_CACHED_XN: u32 = ARM_NORMAL_CACHED | ARM_L1_XN
val ARM_NORMAL_UNCACHED_XN: u32 = ARM_L1_TEX1 | ARM_L1_SHAREABLE |
    ARM_L1_XN
val ARM_DEVICE_XN: u32 = ARM_L1_B | ARM_L1_SHAREABLE | ARM_L1_XN

val ARM_SCTLR_M: u32 = 0x00000001u32
val ARM_SCTLR_C: u32 = 0x00000004u32
val ARM_SCTLR_I: u32 = 0x00001000u32
val ARM_SCTLR_V: u32 = 0x00002000u32
val ARM_SCTLR_TRE: u32 = 0x10000000u32
val ARM_SCTLR_AFE: u32 = 0x20000000u32
val ARM_SCTLR_POLICY_SET: u32 = ARM_SCTLR_M | ARM_SCTLR_C | ARM_SCTLR_I
val ARM_SCTLR_POLICY_CLEAR: u32 = ARM_SCTLR_V | ARM_SCTLR_TRE | ARM_SCTLR_AFE
val ARM_SCTLR_POLICY_MASK: u32 = ARM_SCTLR_POLICY_SET | ARM_SCTLR_POLICY_CLEAR

val ARM_TTBR0_INNER_WB_WA: u32 = 0x00000040u32
val ARM_TTBR0_SHAREABLE: u32 = 0x00000002u32
val ARM_TTBR0_OUTER_WB_WA: u32 = 0x00000008u32
val ARM_DACR_DOMAIN0_CLIENT: u32 = 0x00000001u32
val ARM_ACTLR_SMP: u32 = 0x00000040u32
val SCU_ENABLE: u32 = 0x00000001u32

# Stable semantic-decision identifiers. The low word owns decisions 0..31;
# the high word owns decisions 32..36. Each execution records observed true
# and false outcomes without mutable global state.
val D_CACHE_MULTIPLE_WAYS: u32 = 0u32
val D_SCTLR_REQUIRED_SET: u32 = 1u32
val D_SCTLR_FORBIDDEN_CLEAR: u32 = 2u32
val D_SCTLR_POLICY_VALID: u32 = 3u32
val D_CONTROL_VBAR_MATCH: u32 = 4u32
val D_CONTROL_TTBR0_MATCH: u32 = 5u32
val D_CONTROL_DACR_CLIENT: u32 = 6u32
val D_CONTROL_SCTLR_VALID: u32 = 7u32
val D_CONTROL_ALL_VALID: u32 = 8u32
val D_SCU_PRIMARY_CPU: u32 = 9u32
val D_CACHE_SCU_ENABLED: u32 = 10u32
val D_CACHE_ACTLR_SMP: u32 = 11u32
val D_L2_EXEC_SMALL_PAGE: u32 = 12u32
val D_L2_EXEC_XN_CLEAR: u32 = 13u32
val D_L2_WRITE_SMALL_PAGE: u32 = 14u32
val D_L2_WRITE_AP_RW: u32 = 15u32
val D_L2_WRITE_APX_CLEAR: u32 = 16u32
val D_L2_WX_EXECUTABLE: u32 = 17u32
val D_L2_WX_WRITABLE: u32 = 18u32
val D_FIRMWARE_AT_OR_ABOVE_BASE: u32 = 19u32
val D_FIRMWARE_AT_OR_BELOW_END: u32 = 20u32
val D_FIRMWARE_RX_PAGE: u32 = 21u32
val D_DEVICE_NFC: u32 = 22u32
val D_DEVICE_PCIE: u32 = 23u32
val D_DEVICE_CPU_PRIVATE: u32 = 24u32
val D_DEVICE_SLCR: u32 = 25u32
val D_DEVICE_GIC_SCU: u32 = 26u32
val D_L1_FIRMWARE: u32 = 27u32
val D_L1_DDR_AT_OR_ABOVE_BASE: u32 = 28u32
val D_L1_DDR_AT_OR_BELOW_END: u32 = 29u32
val D_L1_DMA_WINDOW: u32 = 30u32
val D_L1_DEVICE: u32 = 31u32
val D_L1_OCM: u32 = 32u32
val D_L1_MAPPED: u32 = 33u32
val D_OCM_SECTION_MATCH: u32 = 34u32
val D_OCM_AT_OR_ABOVE_HIGH: u32 = 35u32
val D_MMU_POLL_ALLOWED: u32 = 36u32

struct CosmosMmuPolicyExecution:
    value: u32
    true_low: u32
    true_high: u32
    false_low: u32
    false_high: u32

fn _execution(value: u32) -> CosmosMmuPolicyExecution:
    CosmosMmuPolicyExecution(
        value: value,
        true_low: 0u32,
        true_high: 0u32,
        false_low: 0u32,
        false_high: 0u32
    )

fn _record(
    execution: CosmosMmuPolicyExecution,
    decision: u32,
    outcome: bool
) -> CosmosMmuPolicyExecution:
    var true_low = execution.true_low
    var true_high = execution.true_high
    var false_low = execution.false_low
    var false_high = execution.false_high
    if decision < 32u32:
        val bit = 1u32 << decision
        if outcome:
            true_low = true_low | bit
        else:
            false_low = false_low | bit
    else:
        val bit = 1u32 << (decision - 32u32)
        if outcome:
            true_high = true_high | bit
        else:
            false_high = false_high | bit
    CosmosMmuPolicyExecution(
        value: execution.value,
        true_low: true_low,
        true_high: true_high,
        false_low: false_low,
        false_high: false_high
    )

pub fn cosmos_mmu_cache_policy_decision_names() -> [text]:
    [
        "cache.multiple-ways",
        "sctlr.required-set-present",
        "sctlr.forbidden-bits-clear",
        "sctlr.policy-valid",
        "control.vbar-match",
        "control.ttbr0-match",
        "control.dacr-domain0-client",
        "control.sctlr-valid",
        "control.all-registers-valid",
        "scu.primary-cpu",
        "cache.scu-enabled",
        "cache.actlr-smp-enabled",
        "l2-executable.small-page",
        "l2-executable.xn-clear",
        "l2-writable.small-page",
        "l2-writable.ap-rw",
        "l2-writable.apx-clear",
        "l2-write-execute.executable",
        "l2-write-execute.writable",
        "firmware-l2.at-or-above-base",
        "firmware-l2.at-or-below-end",
        "firmware-l2.rx-page",
        "device-section.nfc",
        "device-section.pcie",
        "device-section.cpu-private",
        "device-section.slcr",
        "device-section.gic-scu",
        "l1.firmware-section",
        "l1.ddr-at-or-above-base",
        "l1.ddr-at-or-below-end",
        "l1.dma-window",
        "l1.device-section",
        "l1.ocm-section",
        "l1.mapped",
        "ocm-l2.section-match",
        "ocm-l2.at-or-above-high",
        "mmu.poll-allowed"
    ]

pub fn cosmos_mmu_cache_policy_cache_way_shift_execution(
    ways: u32
) -> CosmosMmuPolicyExecution:
    val multiple = ways > 1u32
    var shift = 0u32
    if multiple:
        var remaining = ways - 1u32
        while (remaining & 0x80000000u32) == 0u32:
            remaining = remaining << 1u32
            shift = shift + 1u32
    _record(_execution(shift), D_CACHE_MULTIPLE_WAYS, multiple)

@export("C", name: "cosmos_mmu_cache_policy_cache_way_shift")
pub fn cosmos_mmu_cache_policy_cache_way_shift(ways: u32) -> u32:
    cosmos_mmu_cache_policy_cache_way_shift_execution(ways).value

@export("C", name: "cosmos_mmu_cache_policy_cache_setway_operand")
pub fn cosmos_mmu_cache_policy_cache_setway_operand(
    level: u32, way: u32, set: u32, line_shift: u32, way_shift: u32
) -> u32:
    (way << way_shift) | (set << line_shift) | (level << 1u32)

@export("C", name: "cosmos_mmu_cache_policy_ttbr0_value")
pub fn cosmos_mmu_cache_policy_ttbr0_value(table_address: u32) -> u32:
    (table_address & 0xFFFFC000u32) | ARM_TTBR0_INNER_WB_WA |
        ARM_TTBR0_SHAREABLE | ARM_TTBR0_OUTER_WB_WA

@export("C", name: "cosmos_mmu_cache_policy_sctlr_apply_policy")
pub fn cosmos_mmu_cache_policy_sctlr_apply_policy(current: u32) -> u32:
    (current & ~ARM_SCTLR_POLICY_MASK) | ARM_SCTLR_POLICY_SET

pub fn cosmos_mmu_cache_policy_sctlr_policy_valid_execution(
    value: u32
) -> CosmosMmuPolicyExecution:
    val required = (value & ARM_SCTLR_POLICY_SET) == ARM_SCTLR_POLICY_SET
    val forbidden_clear = (value & ARM_SCTLR_POLICY_CLEAR) == 0u32
    val valid = required and forbidden_clear
    var result = _record(_execution(if valid: 1u32 else: 0u32),
        D_SCTLR_REQUIRED_SET, required)
    result = _record(result, D_SCTLR_FORBIDDEN_CLEAR, forbidden_clear)
    _record(result, D_SCTLR_POLICY_VALID, valid)

@export("C", name: "cosmos_mmu_cache_policy_sctlr_policy_valid")
pub fn cosmos_mmu_cache_policy_sctlr_policy_valid(value: u32) -> i32:
    if cosmos_mmu_cache_policy_sctlr_policy_valid_execution(value).value != 0u32: 1 else: 0

pub fn cosmos_mmu_cache_policy_control_registers_valid_execution(
    vbar: u32, expected_vbar: u32, ttbr0: u32, expected_ttbr0: u32,
    dacr: u32, sctlr: u32
) -> CosmosMmuPolicyExecution:
    val vbar_match = vbar == expected_vbar
    val ttbr0_match = ttbr0 == expected_ttbr0
    val dacr_client = dacr == ARM_DACR_DOMAIN0_CLIENT
    val sctlr_valid = cosmos_mmu_cache_policy_sctlr_policy_valid(sctlr) != 0
    val valid = vbar_match and ttbr0_match and dacr_client and sctlr_valid
    var result = _record(_execution(if valid: 1u32 else: 0u32),
        D_CONTROL_VBAR_MATCH, vbar_match)
    result = _record(result, D_CONTROL_TTBR0_MATCH, ttbr0_match)
    result = _record(result, D_CONTROL_DACR_CLIENT, dacr_client)
    result = _record(result, D_CONTROL_SCTLR_VALID, sctlr_valid)
    _record(result, D_CONTROL_ALL_VALID, valid)

@export("C", name: "cosmos_mmu_cache_policy_control_registers_valid")
pub fn cosmos_mmu_cache_policy_control_registers_valid(
    vbar: u32, expected_vbar: u32, ttbr0: u32, expected_ttbr0: u32,
    dacr: u32, sctlr: u32
) -> i32:
    if cosmos_mmu_cache_policy_control_registers_valid_execution(
        vbar, expected_vbar, ttbr0, expected_ttbr0, dacr, sctlr
    ).value != 0u32: 1 else: 0

@export("C", name: "cosmos_mmu_cache_policy_control_policy_contract")
pub fn cosmos_mmu_cache_policy_control_policy_contract() -> i32:
    val configured = cosmos_mmu_cache_policy_sctlr_apply_policy(0xFFFFFFFFu32)
    val expected = (0xFFFFFFFFu32 & ~ARM_SCTLR_POLICY_MASK) |
        ARM_SCTLR_POLICY_SET
    val valid = (
        cosmos_mmu_cache_policy_sctlr_apply_policy(0u32) == ARM_SCTLR_POLICY_SET and
        configured == expected and
        cosmos_mmu_cache_policy_control_registers_valid(
            0x00100000u32, 0x00100000u32,
            0x0010404Au32, 0x0010404Au32,
            ARM_DACR_DOMAIN0_CLIENT, configured
        ) != 0 and
        cosmos_mmu_cache_policy_control_registers_valid(
            0x00100020u32, 0x00100000u32,
            0x0010404Au32, 0x0010404Au32,
            ARM_DACR_DOMAIN0_CLIENT, configured
        ) == 0 and
        cosmos_mmu_cache_policy_control_registers_valid(
            0x00100000u32, 0x00100000u32,
            0x0010804Au32, 0x0010404Au32,
            ARM_DACR_DOMAIN0_CLIENT, configured
        ) == 0 and
        cosmos_mmu_cache_policy_control_registers_valid(
            0x00100000u32, 0x00100000u32,
            0x0010404Au32, 0x0010404Au32,
            0u32, configured
        ) == 0 and
        cosmos_mmu_cache_policy_sctlr_policy_valid(configured & ~ARM_SCTLR_M) == 0 and
        cosmos_mmu_cache_policy_sctlr_policy_valid(configured & ~ARM_SCTLR_C) == 0 and
        cosmos_mmu_cache_policy_sctlr_policy_valid(configured & ~ARM_SCTLR_I) == 0 and
        cosmos_mmu_cache_policy_sctlr_policy_valid(configured | ARM_SCTLR_V) == 0 and
        cosmos_mmu_cache_policy_sctlr_policy_valid(configured | ARM_SCTLR_TRE) == 0 and
        cosmos_mmu_cache_policy_sctlr_policy_valid(configured | ARM_SCTLR_AFE) == 0
    )
    if valid: 1 else: 0

pub fn cosmos_mmu_cache_policy_scu_invalidate_mask_execution(
    cpu_id: u32
) -> CosmosMmuPolicyExecution:
    val primary = cpu_id == 0u32
    _record(_execution(if primary: 0xFFFFu32 else: 0u32),
        D_SCU_PRIMARY_CPU, primary)

@export("C", name: "cosmos_mmu_cache_policy_scu_invalidate_mask")
pub fn cosmos_mmu_cache_policy_scu_invalidate_mask(cpu_id: u32) -> u32:
    cosmos_mmu_cache_policy_scu_invalidate_mask_execution(cpu_id).value

pub fn cosmos_mmu_cache_policy_cache_enable_allowed_execution(
    scu_control: u32, actlr: u32
) -> CosmosMmuPolicyExecution:
    val scu_enabled = (scu_control & SCU_ENABLE) != 0u32
    val smp_enabled = (actlr & ARM_ACTLR_SMP) != 0u32
    val allowed = scu_enabled and smp_enabled
    var result = _record(_execution(if allowed: 1u32 else: 0u32),
        D_CACHE_SCU_ENABLED, scu_enabled)
    _record(result, D_CACHE_ACTLR_SMP, smp_enabled)

@export("C", name: "cosmos_mmu_cache_policy_cache_enable_allowed")
pub fn cosmos_mmu_cache_policy_cache_enable_allowed(
    scu_control: u32, actlr: u32
) -> i32:
    if cosmos_mmu_cache_policy_cache_enable_allowed_execution(
        scu_control, actlr
    ).value != 0u32: 1 else: 0

@export("C", name: "cosmos_mmu_cache_policy_section_descriptor")
pub fn cosmos_mmu_cache_policy_section_descriptor(
    base: u32, attributes: u32
) -> u32:
    (base & COSMOS_SECTION_MASK) | ARM_L1_SECTION | ARM_L1_AP_PRIV_RW |
        attributes

@export("C", name: "cosmos_mmu_cache_policy_coarse_descriptor")
pub fn cosmos_mmu_cache_policy_coarse_descriptor(table_address: u32) -> u32:
    (table_address & 0xFFFFFC00u32) | ARM_L1_COARSE

@export("C", name: "cosmos_mmu_cache_policy_small_page_descriptor")
pub fn cosmos_mmu_cache_policy_small_page_descriptor(base: u32) -> u32:
    (base & COSMOS_SMALL_PAGE_MASK) | ARM_L2_SMALL_PAGE | ARM_L2_XN |
        ARM_L2_AP_PRIV_RW | ARM_L2_TEX1 | ARM_L2_SHAREABLE

@export("C", name: "cosmos_mmu_cache_policy_small_page_cached_rx_descriptor")
pub fn cosmos_mmu_cache_policy_small_page_cached_rx_descriptor(base: u32) -> u32:
    (base & COSMOS_SMALL_PAGE_MASK) | ARM_L2_SMALL_PAGE | ARM_L2_AP_PRIV_RO |
        ARM_L2_TEX1 | ARM_L2_C | ARM_L2_B | ARM_L2_SHAREABLE

@export("C", name: "cosmos_mmu_cache_policy_small_page_cached_rw_xn_descriptor")
pub fn cosmos_mmu_cache_policy_small_page_cached_rw_xn_descriptor(
    base: u32
) -> u32:
    (base & COSMOS_SMALL_PAGE_MASK) | ARM_L2_SMALL_PAGE | ARM_L2_XN |
        ARM_L2_AP_PRIV_RW | ARM_L2_TEX1 | ARM_L2_C | ARM_L2_B |
        ARM_L2_SHAREABLE

pub fn cosmos_mmu_cache_policy_l2_descriptor_executable_execution(
    descriptor: u32
) -> CosmosMmuPolicyExecution:
    val small_page = (descriptor & ARM_L2_SMALL_PAGE) == ARM_L2_SMALL_PAGE
    val xn_clear = (descriptor & ARM_L2_XN) == 0u32
    val executable = small_page and xn_clear
    var result = _record(_execution(if executable: 1u32 else: 0u32),
        D_L2_EXEC_SMALL_PAGE, small_page)
    _record(result, D_L2_EXEC_XN_CLEAR, xn_clear)

@export("C", name: "cosmos_mmu_cache_policy_l2_descriptor_executable")
pub fn cosmos_mmu_cache_policy_l2_descriptor_executable(
    descriptor: u32
) -> i32:
    if cosmos_mmu_cache_policy_l2_descriptor_executable_execution(
        descriptor
    ).value != 0u32: 1 else: 0

pub fn cosmos_mmu_cache_policy_l2_descriptor_priv_writable_execution(
    descriptor: u32
) -> CosmosMmuPolicyExecution:
    val small_page = (descriptor & ARM_L2_SMALL_PAGE) == ARM_L2_SMALL_PAGE
    val ap_rw = (descriptor & ARM_L2_AP_PRIV_RW) != 0u32
    val apx_clear = (descriptor & ARM_L2_APX) == 0u32
    val writable = small_page and ap_rw and apx_clear
    var result = _record(_execution(if writable: 1u32 else: 0u32),
        D_L2_WRITE_SMALL_PAGE, small_page)
    result = _record(result, D_L2_WRITE_AP_RW, ap_rw)
    _record(result, D_L2_WRITE_APX_CLEAR, apx_clear)

@export("C", name: "cosmos_mmu_cache_policy_l2_descriptor_priv_writable")
pub fn cosmos_mmu_cache_policy_l2_descriptor_priv_writable(
    descriptor: u32
) -> i32:
    if cosmos_mmu_cache_policy_l2_descriptor_priv_writable_execution(
        descriptor
    ).value != 0u32: 1 else: 0

pub fn cosmos_mmu_cache_policy_l2_descriptor_write_execute_execution(
    descriptor: u32
) -> CosmosMmuPolicyExecution:
    val executable = cosmos_mmu_cache_policy_l2_descriptor_executable(
        descriptor) != 0
    val writable = cosmos_mmu_cache_policy_l2_descriptor_priv_writable(
        descriptor) != 0
    val write_execute = executable and writable
    var result = _record(_execution(if write_execute: 1u32 else: 0u32),
        D_L2_WX_EXECUTABLE, executable)
    _record(result, D_L2_WX_WRITABLE, writable)

@export("C", name: "cosmos_mmu_cache_policy_l2_descriptor_write_execute")
pub fn cosmos_mmu_cache_policy_l2_descriptor_write_execute(
    descriptor: u32
) -> i32:
    if cosmos_mmu_cache_policy_l2_descriptor_write_execute_execution(
        descriptor
    ).value != 0u32: 1 else: 0

pub fn cosmos_mmu_cache_policy_firmware_l2_descriptor_execution(
    address: u32, rx_end: u32
) -> CosmosMmuPolicyExecution:
    val page = address & COSMOS_SMALL_PAGE_MASK
    val rx_limit = (rx_end + COSMOS_SMALL_PAGE_SIZE - 1u32) &
        COSMOS_SMALL_PAGE_MASK
    val at_or_above_base = page >= COSMOS_FIRMWARE_IDENTITY_BASE
    val at_or_below_end = page <= COSMOS_FIRMWARE_IDENTITY_END
    val in_range = at_or_above_base and at_or_below_end
    val rx_page = page < rx_limit
    var value = 0u32
    if in_range:
        if rx_page:
            value = cosmos_mmu_cache_policy_small_page_cached_rx_descriptor(page)
        else:
            value = cosmos_mmu_cache_policy_small_page_cached_rw_xn_descriptor(page)
    var result = _record(_execution(value), D_FIRMWARE_AT_OR_ABOVE_BASE,
        at_or_above_base)
    result = _record(result, D_FIRMWARE_AT_OR_BELOW_END, at_or_below_end)
    _record(result, D_FIRMWARE_RX_PAGE, rx_page)

@export("C", name: "cosmos_mmu_cache_policy_firmware_l2_descriptor_for_address")
pub fn cosmos_mmu_cache_policy_firmware_l2_descriptor_for_address(
    address: u32, rx_end: u32
) -> u32:
    cosmos_mmu_cache_policy_firmware_l2_descriptor_execution(
        address, rx_end).value

pub fn cosmos_mmu_cache_policy_device_section_execution(
    section: u32
) -> CosmosMmuPolicyExecution:
    val nfc = section == (COSMOS_NFC_BASE & COSMOS_SECTION_MASK)
    val pcie = section == (COSMOS_PCIE_BASE & COSMOS_SECTION_MASK)
    val cpu_private = section == 0xE0000000u32
    val slcr = section == (COSMOS_SLCR_BASE & COSMOS_SECTION_MASK)
    val gic_scu = section == (COSMOS_GIC_CPU_BASE & COSMOS_SECTION_MASK)
    val device = nfc or pcie or cpu_private or slcr or gic_scu
    var result = _record(_execution(if device: 1u32 else: 0u32),
        D_DEVICE_NFC, nfc)
    result = _record(result, D_DEVICE_PCIE, pcie)
    result = _record(result, D_DEVICE_CPU_PRIVATE, cpu_private)
    result = _record(result, D_DEVICE_SLCR, slcr)
    _record(result, D_DEVICE_GIC_SCU, gic_scu)

@export("C", name: "cosmos_mmu_cache_policy_device_section")
pub fn cosmos_mmu_cache_policy_device_section(section: u32) -> i32:
    if cosmos_mmu_cache_policy_device_section_execution(section).value != 0u32: 1 else: 0

pub fn cosmos_mmu_cache_policy_l1_descriptor_execution(
    address: u32, firmware_l2_table_address: u32,
    ocm_l2_table_address: u32
) -> CosmosMmuPolicyExecution:
    val section = address & COSMOS_SECTION_MASK
    val firmware = section == COSMOS_FIRMWARE_IDENTITY_BASE
    val ddr_lower = section >= COSMOS_DDR_IDENTITY_BASE
    val ddr_upper = section <= COSMOS_DDR_IDENTITY_END
    val ddr = ddr_lower and ddr_upper
    val dma = section >= COSMOS_NFC_DMA_IDENTITY_BASE and
        section <= COSMOS_NFC_DMA_IDENTITY_END
    val device = cosmos_mmu_cache_policy_device_section(section) != 0
    val ocm = section == (COSMOS_OCM_HIGH & COSMOS_SECTION_MASK)
    var value = 0u32
    if firmware:
        value = cosmos_mmu_cache_policy_coarse_descriptor(
            firmware_l2_table_address)
    elif ddr:
        val attributes = if dma: ARM_NORMAL_UNCACHED_XN else: ARM_NORMAL_CACHED_XN
        value = cosmos_mmu_cache_policy_section_descriptor(section, attributes)
    elif device:
        value = cosmos_mmu_cache_policy_section_descriptor(section, ARM_DEVICE_XN)
    elif ocm:
        value = cosmos_mmu_cache_policy_coarse_descriptor(ocm_l2_table_address)
    val mapped = value != 0u32
    var result = _record(_execution(value), D_L1_FIRMWARE, firmware)
    result = _record(result, D_L1_DDR_AT_OR_ABOVE_BASE, ddr_lower)
    result = _record(result, D_L1_DDR_AT_OR_BELOW_END, ddr_upper)
    result = _record(result, D_L1_DMA_WINDOW, dma)
    result = _record(result, D_L1_DEVICE, device)
    result = _record(result, D_L1_OCM, ocm)
    _record(result, D_L1_MAPPED, mapped)

@export("C", name: "cosmos_mmu_cache_policy_l1_descriptor_for_address")
pub fn cosmos_mmu_cache_policy_l1_descriptor_for_address(
    address: u32, firmware_l2_table_address: u32,
    ocm_l2_table_address: u32
) -> u32:
    cosmos_mmu_cache_policy_l1_descriptor_execution(
        address, firmware_l2_table_address, ocm_l2_table_address).value

pub fn cosmos_mmu_cache_policy_ocm_l2_descriptor_execution(
    address: u32
) -> CosmosMmuPolicyExecution:
    val page = address & COSMOS_SMALL_PAGE_MASK
    val section_match = (page & COSMOS_SECTION_MASK) ==
        (COSMOS_OCM_HIGH & COSMOS_SECTION_MASK)
    val at_or_above_high = page >= COSMOS_OCM_HIGH
    val mapped = section_match and at_or_above_high
    val value = if mapped:
        cosmos_mmu_cache_policy_small_page_descriptor(page)
    else:
        0u32
    var result = _record(_execution(value), D_OCM_SECTION_MATCH, section_match)
    _record(result, D_OCM_AT_OR_ABOVE_HIGH, at_or_above_high)

@export("C", name: "cosmos_mmu_cache_policy_ocm_l2_descriptor_for_address")
pub fn cosmos_mmu_cache_policy_ocm_l2_descriptor_for_address(
    address: u32
) -> u32:
    cosmos_mmu_cache_policy_ocm_l2_descriptor_execution(address).value

pub fn cosmos_mmu_cache_policy_mmu_poll_allowed_execution(
    poll: u32
) -> CosmosMmuPolicyExecution:
    val allowed = poll < COSMOS_POLL_LIMIT
    _record(_execution(if allowed: 1u32 else: 0u32),
        D_MMU_POLL_ALLOWED, allowed)

@export("C", name: "cosmos_mmu_cache_policy_mmu_poll_allowed")
pub fn cosmos_mmu_cache_policy_mmu_poll_allowed(poll: u32) -> i32:
    if cosmos_mmu_cache_policy_mmu_poll_allowed_execution(poll).value != 0u32: 1 else: 0
