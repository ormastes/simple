#!/bin/sh
# Shared deterministic provenance and ELF policy for Cosmos build/package tools.

COSMOS_RECEIPT_FORMAT=cosmos-clean-build-receipt-v2

cosmos_sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        echo "missing SHA-256 tool" >&2
        return 1
    fi
}

cosmos_tool_version() {
    "$1" --version 2>&1 | awk '
        NF {
            gsub(/[[:space:]]+/, " ")
            sub(/^ /, "")
            sub(/ $/, "")
            print
            exit
        }
    '
}

cosmos_tool_sha256() {
    _cr_tool_path="$(command -v "$1")" || return 1
    [ -f "$_cr_tool_path" ] || return 1
    cosmos_sha256_file "$_cr_tool_path"
}

cosmos_profile_define() {
    _cr_header="$1"
    _cr_key="$2"
    awk -v key="$_cr_key" \
        '$1 == "#define" && $2 == key { print $3; found = 1; exit }
         END { if (!found) exit 1 }' "$_cr_header"
}

cosmos_profile_string() {
    _cr_value="$(cosmos_profile_define "$1" "$2")" || return 1
    case "$_cr_value" in
        \"*\") _cr_value="${_cr_value#\"}"; _cr_value="${_cr_value%\"}" ;;
        *) echo "$2 is not a profile string" >&2; return 1 ;;
    esac
    printf '%s\n' "$_cr_value"
}

cosmos_profile_u32() {
    _cr_value="$(cosmos_profile_define "$1" "$2")" || return 1
    _cr_value="$(printf '%s\n' "$_cr_value" | sed 's/[uUlL]*$//')"
    case "$_cr_value" in
        0x[0-9A-Fa-f]*|0X[0-9A-Fa-f]*) ;;
        *) echo "$2 is not a profile integer" >&2; return 1 ;;
    esac
    printf '%s\n' "$_cr_value" |
        awk '
            function hex(s, i, n, d) {
                sub(/^0[xX]/, "", s)
                n = 0
                for (i = 1; i <= length(s); i++) {
                    d = index("0123456789abcdef", tolower(substr(s, i, 1))) - 1
                    if (d < 0) exit 1
                    n = n * 16 + d
                }
                return n
            }
            { printf "0x%08x\n", hex($0) }
        '
}

cosmos_write_source_manifest() (
    _cr_dir="$1"
    _cr_target="$2"
    : > "$_cr_target"
    for _cr_rel in \
        build.shs \
        cosmos_build_receipt.shs \
        cosmos_linker.ld \
        cosmos_start.S \
        cosmos_uart.c \
        cosmos_runtime.c \
        cosmos_mmu_cache.c \
        cosmos_smp_gic.c \
        cosmos_fsbl.c \
        cosmos_nfc.c \
        cosmos_pcie.c \
        cosmos_nvme_firmware.c \
        cosmos_nvme_firmware.h \
        cosmos_nvme_pcie_adapter.c \
        cosmos_nvme_pcie_adapter.h \
        cosmos_nvme_admin.c \
        cosmos_nvme_admin.h \
        cosmos_nvme_dispatch.c \
        cosmos_nvme_dispatch.h \
        cosmos_ftl.c \
        cosmos_ftl.h \
        cosmos_ftl_nfc_backend.c \
        cosmos_ftl_nfc_backend.h \
        cosmos_nvme_ftl_media.c \
        cosmos_nvme_ftl_media.h \
        cosmos_storage.c \
        cosmos_storage.h \
        cosmos_hal.h \
        cosmos_zynq_regs.h \
        cosmos_nfc_regs.h \
        cosmos_pcie_regs.h \
        cosmos_profile_openssd2_8ch8way_v300.h
    do
        [ -f "$_cr_dir/$_cr_rel" ] || {
            echo "missing build input: $_cr_dir/$_cr_rel" >&2
            return 1
        }
        printf '%s  %s\n' \
            "$(cosmos_sha256_file "$_cr_dir/$_cr_rel")" "$_cr_rel" \
            >> "$_cr_target" || return 1
    done
)

cosmos_validate_firmware_elf() (
    _cr_elf="$1"
    _cr_manifest="$2"
    _cr_readelf="${READELF:-readelf}"
    command -v "$_cr_readelf" >/dev/null 2>&1 || {
        echo "missing readelf: $_cr_readelf" >&2
        return 1
    }
    _cr_header="$("$_cr_readelf" -hW "$_cr_elf" 2>/dev/null)" || {
        echo "invalid firmware ELF: $_cr_elf" >&2
        return 1
    }
    printf '%s\n' "$_cr_header" | grep -Eq 'Class:[[:space:]]+ELF32' &&
        printf '%s\n' "$_cr_header" |
            grep -Eq "Data:[[:space:]]+2.s complement, little endian" &&
        printf '%s\n' "$_cr_header" | grep -Eq 'Type:[[:space:]]+EXEC' &&
        printf '%s\n' "$_cr_header" | grep -Eq 'Machine:[[:space:]]+ARM' || {
        echo "firmware must be little-endian ELF32 ARM ET_EXEC" >&2
        return 1
    }
    _cr_entry="$(printf '%s\n' "$_cr_header" |
        awk '/Entry point address:/ { print $4; exit }')"
    _cr_programs="$_cr_manifest.programs.$$"
    if ! "$_cr_readelf" -lW "$_cr_elf" > "$_cr_programs" 2>/dev/null; then
        rm -f "$_cr_programs"
        echo "cannot read firmware program headers" >&2
        return 1
    fi
    _cr_size="$(wc -c < "$_cr_elf" | tr -d ' ')"
    if ! awk \
        -v entry="$_cr_entry" \
        -v file_size="$_cr_size" \
        -v fw_base="$COSMOS_FIRMWARE_BASE" \
        -v fw_end="$COSMOS_FIRMWARE_END" \
        -v dma_base="$COSMOS_DMA_BASE" \
        -v dma_end="$COSMOS_DMA_END" \
        -v mmio_base="$COSMOS_MMIO_BASE" \
        -v mmio_end="$COSMOS_MMIO_END" '
        function hex(s, i, n, d) {
            sub(/^0[xX]/, "", s)
            if (s == "") return -1
            n = 0
            for (i = 1; i <= length(s); i++) {
                d = index("0123456789abcdef", tolower(substr(s, i, 1))) - 1
                if (d < 0) return -1
                n = n * 16 + d
            }
            return n
        }
        function power_of_two(n) {
            if (n < 1) return 0
            while (n > 1) {
                if (n % 2) return 0
                n /= 2
            }
            return 1
        }
        function overlaps(start, finish, base, end) {
            return start <= end && finish > base
        }
        function reject(message) {
            print "invalid firmware PT_LOAD: " message > "/dev/stderr"
            failed = 1
            exit 1
        }
        BEGIN {
            entry_n = hex(entry)
            fw_base_n = hex(fw_base)
            fw_end_n = hex(fw_end)
            dma_base_n = hex(dma_base)
            dma_end_n = hex(dma_end)
            mmio_base_n = hex(mmio_base)
            mmio_end_n = hex(mmio_end)
            if (entry_n <= 0) reject("entry must be nonzero")
        }
        $1 == "LOAD" {
            count++
            offset[count] = hex($2)
            vaddr[count] = hex($3)
            paddr[count] = hex($4)
            filesz[count] = hex($5)
            memsz[count] = hex($6)
            align[count] = hex($NF)
            flags[count] = ""
            for (i = 7; i < NF; i++) flags[count] = flags[count] $i

            if (offset[count] < 0 || vaddr[count] < 0 || paddr[count] < 0 ||
                filesz[count] < 0 || memsz[count] <= 0 || align[count] < 0)
                reject("malformed numeric field")
            if (filesz[count] > memsz[count])
                reject("file size exceeds memory size")
            if (offset[count] + filesz[count] > file_size)
                reject("file range exceeds ELF")
            if (vaddr[count] != paddr[count])
                reject("virtual and physical addresses differ")
            finish = vaddr[count] + memsz[count]
            if (finish > 4294967296 || finish <= vaddr[count])
                reject("address range overflows")
            if (vaddr[count] < fw_base_n || finish - 1 > fw_end_n)
                reject("segment leaves firmware DDR")
            if (overlaps(vaddr[count], finish, dma_base_n, dma_end_n))
                reject("segment overlaps DMA")
            if (overlaps(vaddr[count], finish, mmio_base_n, mmio_end_n))
                reject("segment overlaps MMIO")
            if (!power_of_two(align[count]) || align[count] < 4)
                reject("alignment is not a power of two >= 4")
            if (offset[count] % align[count] != vaddr[count] % align[count] ||
                paddr[count] % align[count] != vaddr[count] % align[count])
                reject("file/address alignment is incongruent")
            if (flags[count] != "R" && flags[count] != "RE" &&
                flags[count] != "RW")
                reject("permissions must be R, R-E, or RW")
            if (flags[count] == "RE") {
                if (filesz[count] == 0) reject("executable segment is empty")
                if (entry_n >= vaddr[count] && entry_n < finish) entry_ok = 1
            }
        }
        END {
            if (failed) exit 1
            if (count == 0) reject("no loadable segment")
            if (!entry_ok) reject("entry is outside executable PT_LOAD")
            for (i = 1; i <= count; i++) {
                for (j = i + 1; j <= count; j++) {
                    if (overlaps(vaddr[i], vaddr[i] + memsz[i],
                                 vaddr[j], vaddr[j] + memsz[j] - 1))
                        reject("memory ranges overlap")
                    if (filesz[i] && filesz[j] &&
                        overlaps(offset[i], offset[i] + filesz[i],
                                 offset[j], offset[j] + filesz[j] - 1))
                        reject("file ranges overlap")
                }
            }
            printf "entry=0x%08x\n", entry_n
            printf "load.count=%d\n", count
            for (i = 1; i <= count; i++) {
                printf "load.%d=offset=0x%08x;vaddr=0x%08x;paddr=0x%08x;", \
                    i, offset[i], vaddr[i], paddr[i]
                printf "filesz=0x%08x;memsz=0x%08x;flags=%s;align=0x%08x\n", \
                    filesz[i], memsz[i], flags[i], align[i]
            }
        }
    ' "$_cr_programs" > "$_cr_manifest"; then
        rm -f "$_cr_programs" "$_cr_manifest"
        return 1
    fi
    rm -f "$_cr_programs"
)

cosmos_write_receipt() (
    _cr_dir="$1"
    _cr_mode="$2"
    _cr_profile="$3"
    _cr_selector="$4"
    _cr_elf="$5"
    _cr_loads="$6"
    _cr_target="$7"
    _cr_supplied_sources="${8:-}"
    _cr_sources="$_cr_target.sources.$$"
    _cr_payload="$_cr_target.payload.$$"
    _cr_clang="${CLANG:-clang}"
    _cr_lld="${LLD:-ld.lld}"
    command -v "$_cr_clang" >/dev/null 2>&1 || return 1
    command -v "$_cr_lld" >/dev/null 2>&1 || return 1
    _cr_clang_version="$(cosmos_tool_version "$_cr_clang")" || return 1
    _cr_lld_version="$(cosmos_tool_version "$_cr_lld")" || return 1
    [ -n "$_cr_clang_version" ] && [ -n "$_cr_lld_version" ] || return 1
    if [ -n "$_cr_supplied_sources" ]; then
        cp "$_cr_supplied_sources" "$_cr_sources" || {
            rm -f "$_cr_sources" "$_cr_payload"
            return 1
        }
    else
        if ! cosmos_write_source_manifest "$_cr_dir" "$_cr_sources"; then
            rm -f "$_cr_sources" "$_cr_payload"
            return 1
        fi
    fi
    _cr_source_count="$(wc -l < "$_cr_sources" | tr -d ' ')"
    _cr_source_sha="$(cosmos_sha256_file "$_cr_sources")"
    _cr_load_sha="$(cosmos_sha256_file "$_cr_loads")"
    {
        printf 'format=%s\n' "$COSMOS_RECEIPT_FORMAT"
        printf 'build.clean=1\n'
        printf 'build.mode=%s\n' "$_cr_mode"
        printf 'profile.name=%s\n' "$_cr_profile"
        printf 'profile.selector=%s\n' "$_cr_selector"
        if [ "$_cr_mode" = silicon ]; then
            printf 'profile.source.commit=%s\n' "$PROFILE_SOURCE_COMMIT"
            printf 'profile.header.sha256=%s\n' \
                "$(cosmos_sha256_file "$PROFILE_HEADER")"
            printf 'profile.bitstream.sha256=%s\n' \
                "$PROFILE_BITSTREAM_SHA256"
        else
            printf 'profile.source.commit=none\n'
            printf 'profile.header.sha256=none\n'
            printf 'profile.bitstream.sha256=none\n'
        fi
        printf 'source.file.count=%s\n' "$_cr_source_count"
        printf 'source.sha256=%s\n' "$_cr_source_sha"
        printf 'linker.sha256=%s\n' \
            "$(cosmos_sha256_file "$_cr_dir/cosmos_linker.ld")"
        printf 'elf.sha256=%s\n' "$(cosmos_sha256_file "$_cr_elf")"
        printf 'elf.load.sha256=%s\n' "$_cr_load_sha"
        sed 's/^/elf./' "$_cr_loads"
        printf 'firmware.base=%s\n' "$COSMOS_FIRMWARE_BASE"
        printf 'firmware.end=%s\n' "$COSMOS_FIRMWARE_END"
        printf 'dma.base=%s\n' "$COSMOS_DMA_BASE"
        printf 'dma.end=%s\n' "$COSMOS_DMA_END"
        printf 'mmio.base=%s\n' "$COSMOS_MMIO_BASE"
        printf 'mmio.end=%s\n' "$COSMOS_MMIO_END"
        printf 'tool.clang.version=%s\n' "$_cr_clang_version"
        printf 'tool.clang.sha256=%s\n' \
            "$(cosmos_tool_sha256 "$_cr_clang")"
        printf 'tool.lld.version=%s\n' "$_cr_lld_version"
        printf 'tool.lld.sha256=%s\n' \
            "$(cosmos_tool_sha256 "$_cr_lld")"
    } > "$_cr_payload" || {
        rm -f "$_cr_sources" "$_cr_payload"
        return 1
    }
    {
        cat "$_cr_payload"
        printf 'receipt.sha256=%s\n' "$(cosmos_sha256_file "$_cr_payload")"
    } > "$_cr_target"
    rm -f "$_cr_sources" "$_cr_payload"
)
