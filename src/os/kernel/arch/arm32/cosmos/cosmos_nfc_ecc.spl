# Pure-Simple Cosmos+ Tiger4NSC ECC decode policy.
#
# C retains volatile DMA acquisition and the established struct ABI. This
# module owns every interpretation of the two acquired error-info words.

pub val COSMOS_NFC_ECC_OK: i32 = 0
pub val COSMOS_NFC_ECC_HW_ERROR: i32 = 4

pub val COSMOS_NFC_ECC_CRC_VALID: u32 = 0x10000000u32
pub val COSMOS_NFC_ECC_SPARE_VALID: u32 = 0x01000000u32
pub val COSMOS_NFC_ECC_WORST_MASK: u32 = 0x00FF0000u32
pub val COSMOS_NFC_ECC_WORST_SHIFT: u32 = 16u32
pub val COSMOS_NFC_ECC_WARNING_THRESHOLD: u32 = 20u32
pub val COSMOS_NFC_ECC_PAGE_VALID: u32 = 0xFFFFFFFFu32

struct CosmosNfcEccDecisionCount:
    decision_id: text
    true_count: i64
    false_count: i64

struct CosmosNfcEccDecisionManifest:
    manifest_id: text
    decisions: [CosmosNfcEccDecisionCount]
    decisions_hit: i64
    decisions_total: i64

fn _ecc_crc_valid(first: u32) -> bool:
    (first & COSMOS_NFC_ECC_CRC_VALID) != 0u32

fn _ecc_spare_valid(first: u32) -> bool:
    (first & COSMOS_NFC_ECC_SPARE_VALID) != 0u32

fn _ecc_page_valid(page_word: u32) -> bool:
    page_word == COSMOS_NFC_ECC_PAGE_VALID

fn _ecc_needs_refresh(first: u32) -> bool:
    cosmos_nfc_ecc_worst_chunk_errors(first) >
        COSMOS_NFC_ECC_WARNING_THRESHOLD

fn _ecc_payload_valid(first: u32, page_word: u32) -> bool:
    _ecc_crc_valid(first) and _ecc_spare_valid(first) and
        _ecc_page_valid(page_word)

@export("C", name: "cosmos_nfc_ecc_policy_crc_valid")
pub fn cosmos_nfc_ecc_policy_crc_valid(first: u32) -> u32:
    if _ecc_crc_valid(first): 1u32 else: 0u32

@export("C", name: "cosmos_nfc_ecc_policy_spare_valid")
pub fn cosmos_nfc_ecc_policy_spare_valid(first: u32) -> u32:
    if _ecc_spare_valid(first): 1u32 else: 0u32

@export("C", name: "cosmos_nfc_ecc_policy_page_valid")
pub fn cosmos_nfc_ecc_policy_page_valid(page_word: u32) -> u32:
    if _ecc_page_valid(page_word): 1u32 else: 0u32

@export("C", name: "cosmos_nfc_ecc_policy_worst_chunk_errors")
pub fn cosmos_nfc_ecc_worst_chunk_errors(first: u32) -> u32:
    (first & COSMOS_NFC_ECC_WORST_MASK) >> COSMOS_NFC_ECC_WORST_SHIFT

@export("C", name: "cosmos_nfc_ecc_policy_needs_refresh")
pub fn cosmos_nfc_ecc_policy_needs_refresh(first: u32) -> u32:
    if _ecc_needs_refresh(first): 1u32 else: 0u32

@export("C", name: "cosmos_nfc_ecc_policy_status")
pub fn cosmos_nfc_ecc_policy_status(first: u32, page_word: u32) -> i32:
    if _ecc_payload_valid(first, page_word):
        return COSMOS_NFC_ECC_OK
    COSMOS_NFC_ECC_HW_ERROR

fn _ecc_decision_count(
    decision_id: text,
    outcomes: [bool]
) -> CosmosNfcEccDecisionCount:
    var true_count: i64 = 0
    var false_count: i64 = 0
    for outcome in outcomes:
        if outcome:
            true_count = true_count + 1
        else:
            false_count = false_count + 1
    CosmosNfcEccDecisionCount(
        decision_id: decision_id,
        true_count: true_count,
        false_count: false_count
    )

pub fn cosmos_nfc_ecc_policy_decision_manifest() -> CosmosNfcEccDecisionManifest:
    """Owner-derived condition outcomes for the bounded ECC policy."""
    val valid_first = COSMOS_NFC_ECC_CRC_VALID |
        COSMOS_NFC_ECC_SPARE_VALID
    val decisions = [
        _ecc_decision_count("decode.crc-valid", [
            _ecc_crc_valid(valid_first),
            _ecc_crc_valid(valid_first & ~COSMOS_NFC_ECC_CRC_VALID)
        ]),
        _ecc_decision_count("decode.spare-valid", [
            _ecc_spare_valid(valid_first),
            _ecc_spare_valid(valid_first & ~COSMOS_NFC_ECC_SPARE_VALID)
        ]),
        _ecc_decision_count("decode.page-valid", [
            _ecc_page_valid(COSMOS_NFC_ECC_PAGE_VALID),
            _ecc_page_valid(0u32)
        ]),
        _ecc_decision_count("decode.needs-refresh", [
            _ecc_needs_refresh(21u32 << COSMOS_NFC_ECC_WORST_SHIFT),
            _ecc_needs_refresh(20u32 << COSMOS_NFC_ECC_WORST_SHIFT)
        ]),
        _ecc_decision_count("decode.payload-valid", [
            _ecc_payload_valid(valid_first, COSMOS_NFC_ECC_PAGE_VALID),
            _ecc_payload_valid(valid_first, 0u32)
        ])
    ]
    var hit: i64 = 0
    for decision in decisions:
        if decision.true_count > 0 and decision.false_count > 0:
            hit = hit + 1
    CosmosNfcEccDecisionManifest(
        manifest_id: "cosmos-nfc-ecc-pure-policy-v1",
        decisions: decisions,
        decisions_hit: hit,
        decisions_total: decisions.len()
    )
