# Shared ABI-132 runtime-owner availability latch.
#
# The latch is opened only by an authenticated WEB child handoff after its
# scheduler/TCB has been installed in the architecture runtime.  It is reset
# immediately after return, so an unrelated task cannot consume WEB evidence.

var _web_startup_runtime_owner_available_v1: bool = false

pub(package) fn web_startup_runtime_owner_enable_v1():
    _web_startup_runtime_owner_available_v1 = true

pub(package) fn web_startup_runtime_owner_disable_v1():
    _web_startup_runtime_owner_available_v1 = false

pub(package) fn web_startup_runtime_owner_available_v1() -> bool:
    _web_startup_runtime_owner_available_v1
