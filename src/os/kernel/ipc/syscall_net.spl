# Network syscall handler — split from syscall.spl.
#
# Socket syscalls 70-76 are owned by the shared checked socket owner
# (os.kernel.ipc.syscall_net_portable_v1 -> os.kernel.socket_compat) on every
# dispatcher: the generic syscall_handler, the ARM64 spl_handle_net_* shims and
# RV64. Only interface configuration (77) remains here.

use os.kernel.types.syscall_types.{SyscallArgs, SyscallResult}

fn _handle_net_if_config(args: SyscallArgs) -> SyscallResult:
    """Get/set network interface configuration (syscall 77).

    No kernel or service owner implements interface configuration yet, so
    this honestly reports ENOSYS rather than pretending to forward.

    Args:
      arg0: interface index
      arg1: info buffer pointer (userspace)
    """
    SyscallResult(value: -38)
