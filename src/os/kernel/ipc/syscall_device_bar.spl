"""Explicit-address-space transactions for PCI BAR syscalls 88 and 89."""

use os.kernel.types.syscall_types.{SyscallArgs, SyscallResult}
use os.kernel.types.task_types.{TaskId}
use os.kernel.device.device_bar_syscall_policy.{decode_device_bar_map_syscall,
    decode_device_bar_unmap_syscall}
use os.kernel.device.pci_bar_live_resolver.{probe_pci_bar_window}
use os.kernel.ipc.capability.{task_vmspace_of, register_task_vmspace}
use os.kernel.memory.vmm.{vmm_map_device_result, vmm_unmap_device_result}
use os.kernel.lifecycle.device_mapping_resources.{
    device_mapping_resource_reserve, device_mapping_resource_commit,
    device_mapping_resource_cancel, device_mapping_resource_find,
    device_mapping_resource_begin_release,
    device_mapping_resource_abort_release,
    device_mapping_resource_finish_release}

fn _handle_map_device_bar(args: SyscallArgs, caller: TaskId) -> SyscallResult:
    val request = decode_device_bar_map_syscall(args.arg0, args.arg1,
        args.arg2, args.arg3, args.arg4, args.arg5)
    if not request.ok:
        return SyscallResult(value: -22)
    val space_opt = task_vmspace_of(caller.id.to_u32())
    if space_opt == nil:
        return SyscallResult(value: -14)
    val space = space_opt.unwrap()
    if space.pml4 == 0u64 or space.pml4 == 1u64:
        return SyscallResult(value: -14)
    val resolution = probe_pci_bar_window(request.bdf, request.bar_index,
        request.byte_offset, request.byte_len)
    if not resolution.ok:
        return SyscallResult(value: -22)
    val reserved = device_mapping_resource_reserve(caller.id, request.bdf,
        request.bar_index, request.byte_len)
    if reserved < 0:
        return SyscallResult(value: -28)
    val slot = reserved.to_u64()
    val mapped = vmm_map_device_result(space, resolution.physical_base,
        resolution.byte_len, request.hint_page)
    if mapped.code != 0:
        if mapped.reason == "blocked:map-rollback-retained-prefix":
            val delta = resolution.physical_base - mapped.physical_page
            val retained_addr = mapped.map_start + delta
            if not device_mapping_resource_commit(slot, caller.id, retained_addr,
                    mapped.map_start, mapped.map_len, mapped.physical_page):
                register_task_vmspace(caller.id.to_u32(), mapped.space)
                return SyscallResult(value: -5)
            register_task_vmspace(caller.id.to_u32(), mapped.space)
            return SyscallResult(value: -5)
        if mapped.reason == "blocked:map-rollback-restore-failed" or
                mapped.reason == "blocked:map-rollback-metadata-failed":
            register_task_vmspace(caller.id.to_u32(), mapped.space)
            return SyscallResult(value: -5)
        _ = device_mapping_resource_cancel(slot, caller.id)
        return SyscallResult(value: mapped.code.to_i64())
    if not device_mapping_resource_commit(slot, caller.id, mapped.user_addr,
            mapped.map_start, mapped.map_len, mapped.physical_page):
        val rollback = vmm_unmap_device_result(mapped.space, mapped.map_start,
            mapped.map_len, mapped.physical_page)
        if rollback.code == 0:
            _ = device_mapping_resource_cancel(slot, caller.id)
            register_task_vmspace(caller.id.to_u32(), rollback.space)
            return SyscallResult(value: -5)
        register_task_vmspace(caller.id.to_u32(), mapped.space)
        return SyscallResult(value: -5)
    register_task_vmspace(caller.id.to_u32(), mapped.space)
    SyscallResult(value: mapped.user_addr.to_i64())

fn _handle_unmap_device_bar(args: SyscallArgs, caller: TaskId) -> SyscallResult:
    val request = decode_device_bar_unmap_syscall(args.arg0, args.arg1,
        args.arg2, args.arg3, args.arg4, args.arg5)
    if not request.ok:
        return SyscallResult(value: -22)
    val record_opt = device_mapping_resource_find(caller.id,
        request.user_addr, request.requested_len)
    val space_opt = task_vmspace_of(caller.id.to_u32())
    if record_opt == nil or space_opt == nil:
        return SyscallResult(value: -22)
    val record = record_opt.unwrap()
    if not device_mapping_resource_begin_release(record.slot, caller.id):
        return SyscallResult(value: -16)
    val unmapped = vmm_unmap_device_result(space_opt.unwrap(),
        record.map_start, record.map_len, record.physical_page)
    if unmapped.code != 0:
        _ = device_mapping_resource_abort_release(record.slot, caller.id)
        return SyscallResult(value: unmapped.code.to_i64())
    register_task_vmspace(caller.id.to_u32(), unmapped.space)
    if not device_mapping_resource_finish_release(record.slot, caller.id):
        return SyscallResult(value: -5)
    SyscallResult(value: 0)

export _handle_map_device_bar, _handle_unmap_device_bar
