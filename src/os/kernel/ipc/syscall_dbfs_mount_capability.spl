# DBFS VFS mount-capability syscall handler (ABI 79).
# Authorization remains in syscall.spl; this bounded owner only publishes the
# read-only mount-owner capability fact after the dispatcher admits the caller.

use os.kernel.types.syscall_types.{SyscallResult}
use os.services.vfs.dbfs_mount_capability.{dbfs_vfs_mount_capability_code_v1}

fn _handle_dbfs_vfs_mount_capability() -> SyscallResult:
    SyscallResult(value: dbfs_vfs_mount_capability_code_v1())
