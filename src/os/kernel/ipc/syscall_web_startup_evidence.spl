# Current-task WEB startup evidence syscall owner (ABI 132).
#
# This is deliberately distinct from ABI 116: it consumes a receipt from the
# WEB-only registry and exposes no DBFS/server-data state or caller identity.

use os.kernel.types.syscall_types.{SyscallResult}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.scheduler.web_launch_evidence_registry_v1
use os.kernel.ipc.web_startup_runtime_owner_v1.{
    web_startup_runtime_owner_available_v1
}

fn _handle_web_startup_evidence_consume(
    scheduler: Scheduler
) -> SyscallResult:
    var sched = scheduler
    if not web_startup_runtime_owner_available_v1():
        return SyscallResult(value: -38)
    if sched.consume_current_web_startup_evidence_v1().is_some():
        return SyscallResult(value: 1)
    SyscallResult(value: 0)
