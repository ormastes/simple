# File Syscall Handlers — split from syscall.spl.
# Contains _handle_file_open, _handle_file_read, _handle_file_write,
# _handle_file_close, _handle_file_stat, _handle_file_mkdir,
# _handle_file_readdir, _handle_file_unlink, _handle_file_rename,
# _handle_file_rmdir, _handle_lseek, _handle_ftruncate,
# _handle_getcwd, _handle_chdir.

use os.kernel.types.syscall_types.{SyscallArgs, SyscallResult}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.memory.user_copy.{user_copyin_bytes, user_copyout_bytes}
use os.kernel.memory.vmm.{vmm_copy_bytes_result_ok}
use os.kernel.fd_io.{posix_close, posix_read, posix_write, posix_lseek}
use os.kernel.ipc.syscall.{MAX_BINARY_PATH_LEN, _is_userspace_range}
use os.kernel.fd_table.{
    fd_alloc, fd_set, fd_get_type, fd_activate_task,
    O_WRONLY, O_RDWR, O_CREAT, O_EXCL, FD_TYPE_FAT32
}
use os.kernel.fs.fat32.{
    fat32_mount_ready, fat32_mount_fs, fat32_mount_dev
}
use os.kernel.fs.fat32_atomic_replace.{fat32_atomic_replace_path_allowed}
use os.kernel.fs.fat32_fd_table.{
    fat32_fd_register, fat32_fd_clear, fat32_fd_read_into, fat32_fd_write_from, fat32_fd_sync
}
use os.kernel.scheduler.server_data_namespace_owner.{
    ServerDataNamespaceOperationV1,
    server_data_namespace_path_is_managed_v1
}

# ============================================================================
# Errno constants used by this module (negative return convention)
# ============================================================================

val _FS_EPERM: i64 = -1
val _FS_ENOENT: i64 = -2
val _FS_EBADF: i64 = -9
val _FS_EFAULT: i64 = -14
val _FS_EINVAL: i64 = -22
val _FS_ERANGE: i64 = -34
val _FS_ENOMEM: i64 = -12
val _FS_ENOSYS: i64 = -38
val _FS_ENAMETOOLONG: i64 = -36

pub enum ServerDataManagedGateDispositionV1:
    Unmanaged
    Denied
    AuthorizedBackendDeferred

pub fn server_data_managed_gate_decide_v1(
    managed: bool, current_active_authorized: bool
) -> ServerDataManagedGateDispositionV1:
    if not managed: return ServerDataManagedGateDispositionV1.Unmanaged
    if not current_active_authorized: return ServerDataManagedGateDispositionV1.Denied
    ServerDataManagedGateDispositionV1.AuthorizedBackendDeferred

# ============================================================================
# Per-process current working directory
#
# Real kernel state, owned by this lane. Paths are kept as `[u8]` end to end:
# `text` byte indexing (`s[i] as u8`, `char_at`, `starts_with`) is unreliable
# on dynamically-built strings in freestanding kernel code, and the raw bytes
# already arrive from userspace as `[u8]`.
#
# Module-level ARRAY initializers do not run in the freestanding kernel, so the
# table is lazily built behind a scalar `.bss` bool (which does zero-init).
# See doc/07_guide/os/baremetal_simple_codegen_landmines.md.
# ============================================================================

struct CwdEntry:
    """One process's current working directory, stored as raw path bytes."""
    task_id: u64
    path: [u8]

val MAX_CWD_ENTRIES: u64 = 256

var g_cwd_table: [CwdEntry] = []
var g_cwd_table_ready: bool = false

fn _cwd_empty_table() -> [CwdEntry]:
    """fn-returning constant: module-level array literals never execute here."""
    val empty: [CwdEntry] = []
    empty

fn _cwd_root_bytes() -> [u8]:
    """The default cwd, "/", as bytes."""
    var b: [u8] = []
    b.push(47u8)
    b

fn _cwd_ensure_table():
    """Lazily initialise the cwd table exactly once."""
    if not g_cwd_table_ready:
        g_cwd_table = _cwd_empty_table()
        g_cwd_table_ready = true

fn cwd_get(task_id: u64) -> [u8]:
    """Current working directory bytes for a task; "/" when never set."""
    _cwd_ensure_table()
    var i: u64 = 0
    while i < g_cwd_table.len():
        if g_cwd_table[i].task_id == task_id:
            return g_cwd_table[i].path
        i = i + 1
    _cwd_root_bytes()

fn cwd_set(task_id: u64, path: [u8]) -> bool:
    """Install a task's cwd (replacing any previous). False when the table is full.

    Bounded by MAX_CWD_ENTRIES so a spawn-heavy workload cannot grow this
    kernel-global without limit; entries are released by cwd_clear on teardown.
    """
    _cwd_ensure_table()
    var i: u64 = 0
    while i < g_cwd_table.len():
        if g_cwd_table[i].task_id == task_id:
            g_cwd_table[i] = CwdEntry(task_id: task_id, path: path)
            return true
        i = i + 1
    if g_cwd_table.len() >= MAX_CWD_ENTRIES:
        return false
    g_cwd_table.push(CwdEntry(task_id: task_id, path: path))
    true

fn cwd_clear(task_id: u64):
    """Drop a task's cwd entry (call on process teardown)."""
    _cwd_ensure_table()
    var kept = _cwd_empty_table()
    var i: u64 = 0
    while i < g_cwd_table.len():
        if g_cwd_table[i].task_id != task_id:
            kept.push(g_cwd_table[i])
        i = i + 1
    g_cwd_table = kept

fn _fs_copy_user_bytes(ptr_addr: u64, len: u64) -> [u8]?:
    """Copy exactly `len` bytes through the architecture-selected owner."""
    val copied = user_copyin_bytes(ptr_addr, len)
    if not vmm_copy_bytes_result_ok(copied):
        return nil
    if copied.status.bytes_read != len or copied.bytes.len() != len:
        return nil
    Some(copied.bytes)

fn _fs_copyout_exact(ptr_addr: u64, bytes: [u8]) -> bool:
    """Publish all bytes through the architecture-selected owner or fail."""
    user_copyout_bytes(ptr_addr, bytes) == bytes.len() as i64

fn _bytes_to_text(b: [u8]) -> text:
    """Build `text` from raw path bytes one byte at a time via `.chr()` —
    the same forward-concatenation pattern fat32.spl uses to decode 8.3/LFN
    names, chosen because `text` byte-indexing is unreliable on dynamically
    built strings in this freestanding kernel (see module doc above)."""
    var out = ""
    var i: u64 = 0
    while i < b.len():
        out = out + b[i].chr()
        i = i + 1
    out

fn _path_is_absolute(p: [u8]) -> bool:
    """True when the path's first byte is '/'."""
    if p.len() == 0:
        return false
    p[0] == 47u8

fn _path_normalize(raw: [u8]) -> [u8]:
    """Collapse "//", drop ".", and pop one component per "..".

    Operates on an already-absolute byte path and always returns a path that
    starts with '/' and (except for the root itself) has no trailing '/'.
    Index loops only: array slicing + `.join()` is unreliable in guest code.
    """
    # Component start offsets and lengths, parsed in one pass.
    var starts: [u64] = []
    var lens: [u64] = []
    var i: u64 = 0
    var cur_start: u64 = 0
    var cur_len: u64 = 0
    while i < raw.len():
        if raw[i] == 47u8:
            if cur_len > 0:
                starts.push(cur_start)
                lens.push(cur_len)
                cur_len = 0
            cur_start = i + 1
        else:
            if cur_len == 0:
                cur_start = i
            cur_len = cur_len + 1
        i = i + 1
    if cur_len > 0:
        starts.push(cur_start)
        lens.push(cur_len)

    # Resolve "." and ".." against a component stack.
    var keep_start: [u64] = []
    var keep_len: [u64] = []
    var c: u64 = 0
    while c < starts.len():
        val s = starts[c]
        val n = lens[c]
        var is_dot = false
        var is_dotdot = false
        if n == 1:
            if raw[s] == 46u8:
                is_dot = true
        if n == 2:
            if raw[s] == 46u8 and raw[s + 1] == 46u8:
                is_dotdot = true
        if is_dotdot:
            if keep_start.len() > 0:
                keep_start.pop()
                keep_len.pop()
        else:
            if not is_dot:
                keep_start.push(s)
                keep_len.push(n)
        c = c + 1

    var out: [u8] = []
    if keep_start.len() == 0:
        out.push(47u8)
        return out
    var k: u64 = 0
    while k < keep_start.len():
        out.push(47u8)
        var j: u64 = 0
        while j < keep_len[k]:
            out.push(raw[keep_start[k] + j])
            j = j + 1
        k = k + 1
    out

pub fn path_resolve(task_id: u64, raw: [u8]) -> [u8]:
    """Resolve a user-supplied path against the task's cwd, then normalise."""
    if _path_is_absolute(raw):
        return _path_normalize(raw)
    var joined = cwd_get(task_id)
    joined.push(47u8)
    var i: u64 = 0
    while i < raw.len():
        joined.push(raw[i])
        i = i + 1
    _path_normalize(joined)

# ============================================================================
# File Syscall Handlers
#
# HONESTY CONTRACT (see .claude/rules/code-style.md "No Cover-Up Fixes"):
# every path-based operation that this kernel cannot actually perform returns a
# NEGATIVE ERRNO. None of them may return 0, and `open` in particular must never
# return 0 — 0 is a valid fd meaning stdin, so a fake success there silently
# redirects a caller's writes to the console.
#
# The path-based operations below previously built an `IpcMessage` and fired it
# at port 0. `IpcMessage` carries NO payload pointer, `send()` queues an empty
# payload and returns 0, and no reply was ever awaited — so the path bytes never
# left the kernel and the caller's stat/dirent buffers were left uninitialised
# while the call reported success. Those sends are removed here rather than
# re-plumbed: the transport was never the binding constraint.
#
# UPDATE 2026-08-06 (integration landed): `os.kernel.fs.fat32` now publishes a
# kernel-global mounted `Fat32Filesystem` (`fat32_mount_publish`/`_ready`/`_fs`/
# `_dev`, see fat32.spl's "Kernel-global mounted filesystem" section), set from
# `os.kernel.boot.boot_fs_mount.boot_fs_mount_fat32_from_device` after a real
# `mount()` call. `open`/`stat`/`mkdir`/`readdir`/`unlink`/`rmdir` below now
# call it directly and return real data/errno instead of ENOSYS. `rename` now
# calls `Fat32Filesystem.rename_at` too (link-new-entry + delete-old-entry;
# see its docstring for the honest non-atomicity note). `readdir`/`unlink`/
# `rmdir`/`rename` are backed by new `Fat32Filesystem.readdir_at`/
# `unlink_at`/`rmdir_at`/`rename_at` methods.
#
# STILL-OPEN GAP (see doc/08_tracking/bug/path_based_fs_syscalls_fake_success_2026-08-06.md):
# `boot_fs_mount_fat32_from_device` itself has no caller anywhere in the live
# boot sequence (verified: `grep -rn boot_fs_mount_fat32_from_device src/os/`
# outside boot_fs_mount.spl is empty) — a pre-existing gap this change does
# not close. Until something in the real boot path calls it (or calls
# `fat32_mount_publish` directly with a real disk BlockDevice), these handlers
# still return -ENOSYS on real hardware/QEMU, honestly, via the
# `fat32_mount_ready()` guard on every handler below — never a fake success.
#
# UPDATE 2026-08-06 (this lane): the fd-io gap noted above ("a fd returned by
# `open` does not make `read`/`write` reach FAT32") is CLOSED. `open` now
# allocates the fd with type `FD_TYPE_FAT32` (not the generic FD_TYPE_FILE
# that `os.kernel.fd_io`'s `sosix_sync_read`/`sosix_sync_write` route owns)
# and registers the real `Fat32Filesystem.FileHandle` returned by `open_at`/
# `create_at`, keyed by (task_id, fd), in `os.kernel.fs.fat32_fd_table` (split
# into its own module — see that file's header — specifically so it can be
# unit-tested without the heavy `os.kernel.ipc.syscall` import graph this
# file itself carries). `_handle_file_read`/`_handle_file_write` below
# recognise `FD_TYPE_FAT32` and call `fat32_fd_read_into`/`fat32_fd_write_from`
# instead of falling through to `posix_read`/`posix_write` — those two
# unrelated file-fd subsystems no longer collide under the same type tag.
# `_handle_file_close` purges the table entry so a reused fd number cannot
# see a stale handle. `_handle_lseek` below explicitly refuses FD_TYPE_FAT32
# rather than silently changing an offset scalar nothing reads (see its own
# docstring).
# ============================================================================

fn _open_flags_want_create(flags: u32) -> bool:
    (flags & O_CREAT) != 0

fn _open_permissions(flags: u32) -> text:
    val access = flags & 3u32
    var perms = if access == O_WRONLY: "w" else if access == O_RDWR: "rw" else: "r"
    if (flags & O_CREAT) != 0u32:
        perms = perms + "c"
    perms

fn _server_data_open_operation_v1(flags: u32) -> ServerDataNamespaceOperationV1:
    if (flags & O_CREAT) != 0u32:
        return ServerDataNamespaceOperationV1.Create
    val access = flags & 3u32
    if access == O_WRONLY or access == O_RDWR:
        return ServerDataNamespaceOperationV1.Write
    ServerDataNamespaceOperationV1.Read

fn _handle_file_open(args: SyscallArgs, scheduler: Scheduler, ipc: IpcManager) -> SyscallResult:
    """Open a file against the kernel-global mounted Fat32Filesystem.

    Args:
      arg0: path pointer (userspace)
      arg1: path length
      arg2: flags

    UPDATE 2026-08-06: real, no longer ENOSYS-only. Resolves the path against
    the caller's cwd, calls `Fat32Filesystem.open_at` (or `create_at` when
    O_CREAT is set and the file does not exist), and allocates a REAL fd via
    `os.kernel.fd_table`. `posix_open` (fd_io.spl) stays dead/unused here —
    it IPC-sends to a "VFS service" that is never spawned in production.

    UPDATE 2026-08-06 (this lane): the fd is now typed `FD_TYPE_FAT32`, a
    dedicated type distinct from the generic `FD_TYPE_FILE` that
    `os.kernel.fd_io`'s `sosix_sync_read`/`sosix_sync_write` route owns. The
    real `FileHandle` `open_at`/`create_at` returned is registered, keyed by
    (task_id, fd), with `os.kernel.fs.fat32_fd_table.fat32_fd_register` (a
    fd-only key would collide across two different tasks that both happen to
    hold the same fd NUMBER — fd numbers are per-task-context), so
    `_handle_file_read`/`_handle_file_write` can find it again and call
    `fat32_fd_read_into`/`fat32_fd_write_from` — closing the gap this
    docstring used to describe.
    """
    val path_ptr = args.arg0 as u64
    val path_len = args.arg1 as u64
    val flags = args.arg2 as u32
    if path_ptr == 0 or path_len == 0:
        return SyscallResult(value: _FS_EINVAL)
    if path_len > MAX_BINARY_PATH_LEN:
        return SyscallResult(value: _FS_ENAMETOOLONG)
    if not _is_userspace_range(path_ptr, path_len):
        return SyscallResult(value: _FS_EFAULT)
    var sched = scheduler
    val current = sched.get_current()
    val raw_copy = _fs_copy_user_bytes(path_ptr, path_len)
    if raw_copy == nil:
        return SyscallResult(value: _FS_EFAULT)
    val raw = raw_copy.unwrap()
    val resolved_path = _bytes_to_text(path_resolve(current.id, raw))
    # Authorization and filesystem lookup consume this one kernel-owned
    # canonical value. Never re-read the mutable userspace path between them.
    var ipc_mgr = ipc
    if not ipc_mgr.cap_manager.check_file_access(
        current, resolved_path, _open_permissions(flags)):
        return SyscallResult(value: _FS_EPERM)
    val managed = server_data_namespace_path_is_managed_v1(resolved_path)
    val namespace_authorized = managed and
        sched.server_data_namespace_authorize_current_managed_path_v1(
            _server_data_open_operation_v1(flags), resolved_path, "")
    val namespace_gate = server_data_managed_gate_decide_v1(
        managed, namespace_authorized)
    if namespace_gate != ServerDataManagedGateDispositionV1.Unmanaged:
        if namespace_gate == ServerDataManagedGateDispositionV1.Denied:
            return SyscallResult(value: _FS_EPERM)
        # MountTable can open the exact DBFS object, but the production fd
        # table cannot yet bind that virtual object to the new OFD/descriptor
        # owners. Never route protected DBFS paths through the FAT32 fallback.
        return SyscallResult(value: _FS_ENOSYS)
    if not fat32_mount_ready():
        # Honest: no boot path has published a mounted filesystem yet. Never
        # fabricate fd 0 (stdin) as a fake success.
        return SyscallResult(value: _FS_ENOSYS)
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    var open_r = fs.open_at(dev, resolved_path)
    if open_r.is_ok() and (flags & O_CREAT) != 0 and (flags & O_EXCL) != 0:
        return SyscallResult(value: -17)
    if open_r.is_err():
        val err = open_r.unwrap_err()
        if err == -2 and _open_flags_want_create(flags):
            open_r = fs.create_at(dev, resolved_path)
        if open_r.is_err():
            return SyscallResult(value: open_r.unwrap_err() as i64)
    val handle = open_r.unwrap()
    val fd = fd_alloc()
    if fd < 0:
        return SyscallResult(value: fd as i64)
    # backend_handle carries the fat32 dirent's start_cluster for diagnostics;
    # the real per-fd state (offset, file_size, dirent location, ...) lives in
    # os.kernel.fs.fat32_fd_table, since FileHandle is a whole struct and
    # fd_table only stores a single u64 scalar per fd.
    val set_r = fd_set(fd, FD_TYPE_FAT32, flags, handle.start_cluster as u64)
    if set_r < 0:
        return SyscallResult(value: set_r as i64)
    fat32_fd_register(current.id, fd, handle)
    SyscallResult(value: fd as i64)

fn _handle_file_read(args: SyscallArgs, scheduler: Scheduler, ipc: IpcManager) -> SyscallResult:
    """Read from a file descriptor through the active POSIX fd backend.

    Args:
      arg0: file descriptor
      arg1: buffer pointer (userspace)
      arg2: byte count to read

    UPDATE 2026-08-06 (this lane): a FD_TYPE_FAT32 fd (allocated by
    _handle_file_open above) is routed to
    `os.kernel.fs.fat32_fd_table.fat32_fd_read_into` — real disk I/O, real
    cluster-chain walk — instead of falling through to posix_read's
    sosix_sync_read route, which has no FAT32 backend and would silently
    short-read/no-op on such a fd.
    """
    val fd = args.arg0 as i32
    val buf_ptr = args.arg1 as u64
    val count = args.arg2 as u64
    if count == 0:
        return SyscallResult(value: 0)
    if not _is_userspace_range(buf_ptr, count):
        return SyscallResult(value: -14)
    if fd_get_type(fd) == FD_TYPE_FAT32:
        var sched = scheduler
        val current = sched.get_current()
        var buf: [u8] = []
        var i: u64 = 0
        while i < count:
            buf.push(0u8)
            i = i + 1
        val read_r = fat32_fd_read_into(current.id, fd, buf)
        if read_r.is_err():
            return SyscallResult(value: read_r.unwrap_err() as i64)
        val n = read_r.unwrap()
        var output: [u8] = []
        var w: u64 = 0
        while w < n:
            output.push(buf[w])
            w = w + 1
        if not _fs_copyout_exact(buf_ptr, output):
            return SyscallResult(value: _FS_EFAULT)
        return SyscallResult(value: n as i64)
    SyscallResult(value: posix_read(fd, buf_ptr, count))

fn _handle_file_write(args: SyscallArgs, scheduler: Scheduler, ipc: IpcManager) -> SyscallResult:
    """Write to a file descriptor through the active POSIX fd backend.

    Args:
      arg0: file descriptor
      arg1: buffer pointer (userspace)
      arg2: byte count to write

    UPDATE 2026-08-06 (this lane): a FD_TYPE_FAT32 fd is routed to
    `os.kernel.fs.fat32_fd_table.fat32_fd_write_from` — see
    `_handle_file_read`'s docstring for why the generic posix_write route
    cannot reach FAT32, and that module's docstring for the append-only
    honesty guard (a plain overwrite-from-offset-0 on a reopened non-empty
    file is refused with ENOSYS, not silently mis-written as an append).
    """
    val fd = args.arg0 as i32
    val buf_ptr = args.arg1 as u64
    val count = args.arg2 as u64
    if count == 0:
        return SyscallResult(value: 0)
    if fd_get_type(fd) == FD_TYPE_FAT32:
        if not _is_userspace_range(buf_ptr, count):
            return SyscallResult(value: -14)
        var sched = scheduler
        val current = sched.get_current()
        val copied = _fs_copy_user_bytes(buf_ptr, count)
        if copied == nil:
            return SyscallResult(value: _FS_EFAULT)
        val bytes = copied.unwrap()
        val write_r = fat32_fd_write_from(current.id, fd, bytes)
        if write_r.is_err():
            return SyscallResult(value: write_r.unwrap_err() as i64)
        return SyscallResult(value: write_r.unwrap() as i64)
    if not _is_userspace_range(buf_ptr, count):
        return SyscallResult(value: -14)
    SyscallResult(value: posix_write(args.arg0 as i32, buf_ptr, count))

fn _handle_file_close(args: SyscallArgs, scheduler: Scheduler, ipc: IpcManager) -> SyscallResult:
    """Close a file descriptor through the POSIX fd owner.

    Args:
      arg0: file descriptor

    UPDATE 2026-08-06 (this lane): also purges any fat32_fd_table entry for
    (current task, this fd) BEFORE the fd number is released back to
    fd_alloc, so a later open() that is handed the same fd number cannot
    observe a stale FileHandle left over from a previous, unrelated file.
    """
    val fd = args.arg0 as i32
    var sched = scheduler
    val current = sched.get_current()
    fd_activate_task(current.id)
    fat32_fd_clear(current.id, fd)
    SyscallResult(value: posix_close(fd) as i64)

fn _handle_file_sync(args: SyscallArgs, scheduler: Scheduler) -> SyscallResult:
    """Flush a caller-owned FAT32 descriptor through the block-device cache."""
    val fd = args.arg0 as i32
    if fd_get_type(fd) != FD_TYPE_FAT32:
        return SyscallResult(value: _FS_EBADF)
    var sched = scheduler
    val current = sched.get_current()
    val synced = fat32_fd_sync(current.id, fd)
    if synced.is_err():
        return SyscallResult(value: synced.unwrap_err() as i64)
    SyscallResult(value: 0)

# -- struct stat layout (src/os/libc/include/sys/stat.h, natural x86_64
#    alignment): dev_t/ino_t u64 @0/@8, mode_t u32 @16, nlink_t u64 @24
#    (padded), uid_t/gid_t u32 @32/@36, dev_t u64 @40, off_t i64 @48,
#    blksize_t/blkcnt_t i64 @56/@64, atime/mtime/ctime i64 @72/@80/@88.
#    96 bytes total, well inside the 128-byte caller buffer.
val _STAT_OFF_MODE: u64 = 16
val _STAT_OFF_NLINK: u64 = 24
val _STAT_OFF_SIZE: u64 = 48
val _STAT_OFF_MTIME: u64 = 80
val _STAT_SIZE: u64 = 96
val _S_IFDIR: u32 = 0x4000  # 0040000 octal
val _S_IFREG: u32 = 0x8000  # 0100000 octal
val _MODE_DIR: u32 = _S_IFDIR | 0x1EDu32   # S_IFDIR | 0755
val _MODE_REG: u32 = _S_IFREG | 0x1A4u32   # S_IFREG | 0644

fn _stat_patch_u32(buf: [u8], off: u64, v: u32):
    buf[off]     = (v & 0xFFu32).to_u8()
    buf[off + 1] = ((v >> 8u32)  & 0xFFu32).to_u8()
    buf[off + 2] = ((v >> 16u32) & 0xFFu32).to_u8()
    buf[off + 3] = ((v >> 24u32) & 0xFFu32).to_u8()

fn _stat_patch_u64(buf: [u8], off: u64, v: u64):
    buf[off]     = (v & 0xFFu64).to_u8()
    buf[off + 1] = ((v >> 8u64)  & 0xFFu64).to_u8()
    buf[off + 2] = ((v >> 16u64) & 0xFFu64).to_u8()
    buf[off + 3] = ((v >> 24u64) & 0xFFu64).to_u8()
    buf[off + 4] = ((v >> 32u64) & 0xFFu64).to_u8()
    buf[off + 5] = ((v >> 40u64) & 0xFFu64).to_u8()
    buf[off + 6] = ((v >> 48u64) & 0xFFu64).to_u8()
    buf[off + 7] = ((v >> 56u64) & 0xFFu64).to_u8()

fn _stat_bytes(is_dir: bool, size: u64, mtime: u64) -> [u8]:
    """Build the raw `struct stat` byte image for a single stat() result.
    Zeroed fields (dev/ino/uid/gid/rdev/blksize/blocks/atime/ctime) are real
    zero content, not leaked kernel memory — every byte is written."""
    var buf: [u8] = []
    var i: u64 = 0
    while i < _STAT_SIZE:
        buf.push(0u8)
        i = i + 1
    var mode = _MODE_REG
    if is_dir:
        mode = _MODE_DIR
    _stat_patch_u32(buf, _STAT_OFF_MODE, mode)
    _stat_patch_u64(buf, _STAT_OFF_NLINK, 1u64)
    _stat_patch_u64(buf, _STAT_OFF_SIZE, size)
    _stat_patch_u64(buf, _STAT_OFF_MTIME, mtime)
    buf

fn _handle_file_stat(args: SyscallArgs, scheduler: Scheduler, ipc: IpcManager) -> SyscallResult:
    """Stat a file against the kernel-global mounted Fat32Filesystem.

    Args:
      arg0: path pointer (userspace)
      arg1: path length
      arg2: stat buffer pointer (userspace, ~128 bytes)

    UPDATE 2026-08-06: real. Calls `Fat32Filesystem.stat_at`, builds a real
    `struct stat` byte image (mode/nlink/size/mtime; see layout note above),
    and publishes it through the architecture-selected user-copy owner.
    """
    val path_ptr = args.arg0 as u64
    val path_len = args.arg1 as u64
    val stat_buf = args.arg2 as u64
    if path_ptr == 0 or path_len == 0:
        return SyscallResult(value: _FS_EINVAL)
    if path_len > MAX_BINARY_PATH_LEN:
        return SyscallResult(value: _FS_ENAMETOOLONG)
    if not fat32_mount_ready():
        return SyscallResult(value: _FS_ENOSYS)
    var sched = scheduler
    val current = sched.get_current()
    val raw_copy = _fs_copy_user_bytes(path_ptr, path_len)
    if raw_copy == nil:
        return SyscallResult(value: _FS_EFAULT)
    val raw = raw_copy.unwrap()
    val resolved_path = _bytes_to_text(path_resolve(current.id, raw))
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    val stat_r = fs.stat_at(dev, resolved_path)
    if stat_r.is_err():
        return SyscallResult(value: stat_r.unwrap_err() as i64)
    val st = stat_r.unwrap()
    val bytes = _stat_bytes(st.is_dir, st.size, st.mtime)
    if not _fs_copyout_exact(stat_buf, bytes):
        return SyscallResult(value: _FS_EFAULT)
    SyscallResult(value: 0)

fn _handle_file_mkdir(args: SyscallArgs, scheduler: Scheduler, ipc: IpcManager) -> SyscallResult:
    """Create a directory against the kernel-global mounted Fat32Filesystem.

    Args:
      arg0: path pointer (userspace)
      arg1: path length
      arg2: mode (permissions) — accepted but not persisted; FAT32 has no
        POSIX permission bits.

    UPDATE 2026-08-06: real, no longer ENOSYS-only. Calls
    `Fat32Filesystem.mkdir_at` (real cluster allocation + "." / ".." entries).
    """
    val path_ptr = args.arg0 as u64
    val path_len = args.arg1 as u64
    if path_ptr == 0 or path_len == 0:
        return SyscallResult(value: _FS_EINVAL)
    if path_len > MAX_BINARY_PATH_LEN:
        return SyscallResult(value: _FS_ENAMETOOLONG)
    if not fat32_mount_ready():
        return SyscallResult(value: _FS_ENOSYS)
    var sched = scheduler
    val current = sched.get_current()
    val raw_copy = _fs_copy_user_bytes(path_ptr, path_len)
    if raw_copy == nil:
        return SyscallResult(value: _FS_EFAULT)
    val raw = raw_copy.unwrap()
    val resolved_path = _bytes_to_text(path_resolve(current.id, raw))
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    val mkdir_r = fs.mkdir_at(dev, resolved_path)
    if mkdir_r.is_err():
        return SyscallResult(value: mkdir_r.unwrap_err() as i64)
    SyscallResult(value: 0)

fn _readdir_names_to_nul_bytes(names: [text]) -> [u8]:
    """Encode entry names as consecutive NUL-terminated byte runs, in order."""
    var out: [u8] = []
    var ni = 0
    while ni < names.len():
        val name = names[ni]
        var ci: u64 = 0
        while ci < name.len():
            out.push(name.byte_at(ci))
            ci = ci + 1
        out.push(0u8)
        ni = ni + 1
    out

fn _handle_file_readdir(args: SyscallArgs, scheduler: Scheduler, ipc: IpcManager) -> SyscallResult:
    """Read directory entries against the kernel-global mounted Fat32Filesystem.

    Args:
      arg0: directory path pointer (userspace)
      arg1: directory path length
      arg2: buffer pointer (userspace) for NUL-separated entry names
      arg3: buffer size

    UPDATE 2026-08-06: real, no longer ENOSYS-only (and the arg layout grew a
    path-length slot the original IPC-stub version never needed, since a real
    implementation must copy the path bytes in). Calls
    `Fat32Filesystem.readdir_at`, which real-enumerates the directory's raw
    bytes (LFN + 8.3, deleted-entry aware — see `fat32_dir_list_entries`),
    encodes the names as consecutive NUL-terminated runs, writes them into
    the caller buffer, and returns the entry COUNT (not the byte count).
    Returns -ERANGE, not a silent truncation, when the encoded names do not
    fit in the caller's buffer.
    """
    val path_ptr = args.arg0 as u64
    val path_len = args.arg1 as u64
    val buf_ptr = args.arg2 as u64
    val buf_size = args.arg3 as u64
    if path_ptr == 0 or path_len == 0 or buf_ptr == 0 or buf_size == 0:
        return SyscallResult(value: _FS_EINVAL)
    if path_len > MAX_BINARY_PATH_LEN:
        return SyscallResult(value: _FS_ENAMETOOLONG)
    if not fat32_mount_ready():
        return SyscallResult(value: _FS_ENOSYS)
    var sched = scheduler
    val current = sched.get_current()
    val raw_copy = _fs_copy_user_bytes(path_ptr, path_len)
    if raw_copy == nil:
        return SyscallResult(value: _FS_EFAULT)
    val raw = raw_copy.unwrap()
    val resolved_path = _bytes_to_text(path_resolve(current.id, raw))
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    val list_r = fs.readdir_at(dev, resolved_path)
    if list_r.is_err():
        return SyscallResult(value: list_r.unwrap_err() as i64)
    val names = list_r.unwrap()
    val encoded = _readdir_names_to_nul_bytes(names)
    if encoded.len() as u64 > buf_size:
        return SyscallResult(value: _FS_ERANGE)
    if not _fs_copyout_exact(buf_ptr, encoded):
        return SyscallResult(value: _FS_EFAULT)
    SyscallResult(value: names.len() as i64)

fn _handle_file_unlink(args: SyscallArgs, scheduler: Scheduler, ipc: IpcManager) -> SyscallResult:
    """Remove a file against the kernel-global mounted Fat32Filesystem.

    UPDATE 2026-08-06: real, no longer ENOSYS-only. Calls
    `Fat32Filesystem.unlink_at`, which frees the file's whole FAT cluster
    chain before marking its directory entry 0xE5-deleted. Rejects a
    directory with -EISDIR (use rmdir for those)."""
    val path_ptr = args.arg0 as u64
    val path_len = args.arg1 as u64
    if path_ptr == 0 or path_len == 0:
        return SyscallResult(value: _FS_EINVAL)
    if path_len > MAX_BINARY_PATH_LEN:
        return SyscallResult(value: _FS_ENAMETOOLONG)
    if not fat32_mount_ready():
        return SyscallResult(value: _FS_ENOSYS)
    var sched = scheduler
    val current = sched.get_current()
    val raw_copy = _fs_copy_user_bytes(path_ptr, path_len)
    if raw_copy == nil:
        return SyscallResult(value: _FS_EFAULT)
    val raw = raw_copy.unwrap()
    val resolved_path = _bytes_to_text(path_resolve(current.id, raw))
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    val unlink_r = fs.unlink_at(dev, resolved_path)
    if unlink_r.is_err():
        return SyscallResult(value: unlink_r.unwrap_err() as i64)
    SyscallResult(value: 0)

fn _handle_file_rename(args: SyscallArgs, scheduler: Scheduler, ipc: IpcManager) -> SyscallResult:
    """Rename/move a file or directory against the kernel-global mounted
    Fat32Filesystem.

    Args:
      arg0: old-path pointer (userspace)
      arg1: old-path length
      arg2: new-path pointer (userspace)
      arg3: new-path length

    UPDATE 2026-08-06: real, no longer ENOSYS-only. Calls
    `Fat32Filesystem.rename_at`, which links a new directory entry (copying
    only start_cluster/size — never the file's data) then marks the old
    entry deleted; see that method's docstring for the honest, documented
    non-atomicity of the two-step and the destination-exists (EEXIST, no
    atomic replace) policy.
    """
    val old_ptr = args.arg0 as u64
    val old_len = args.arg1 as u64
    val new_ptr = args.arg2 as u64
    val new_len = args.arg3 as u64
    if old_ptr == 0 or old_len == 0 or new_ptr == 0 or new_len == 0:
        return SyscallResult(value: _FS_EINVAL)
    if old_len > MAX_BINARY_PATH_LEN or new_len > MAX_BINARY_PATH_LEN:
        return SyscallResult(value: _FS_ENAMETOOLONG)
    if not _is_userspace_range(old_ptr, old_len) or not _is_userspace_range(new_ptr, new_len):
        return SyscallResult(value: _FS_EFAULT)
    var sched = scheduler
    val current = sched.get_current()
    val old_copy = _fs_copy_user_bytes(old_ptr, old_len)
    val new_copy = _fs_copy_user_bytes(new_ptr, new_len)
    if old_copy == nil or new_copy == nil:
        return SyscallResult(value: _FS_EFAULT)
    val old_raw = old_copy.unwrap()
    val new_raw = new_copy.unwrap()
    val old_resolved = _bytes_to_text(path_resolve(current.id, old_raw))
    val new_resolved = _bytes_to_text(path_resolve(current.id, new_raw))
    val managed = server_data_namespace_path_is_managed_v1(old_resolved) or
        server_data_namespace_path_is_managed_v1(new_resolved)
    val namespace_authorized = managed and
        sched.server_data_namespace_authorize_current_managed_path_v1(
            ServerDataNamespaceOperationV1.Rename,
            old_resolved, new_resolved)
    val namespace_gate = server_data_managed_gate_decide_v1(
        managed, namespace_authorized)
    if namespace_gate != ServerDataManagedGateDispositionV1.Unmanaged:
        if namespace_gate == ServerDataManagedGateDispositionV1.Denied:
            return SyscallResult(value: _FS_EPERM)
        # No DBFS namespace rename dispatcher is bound to the canonical file
        # syscall owner yet. In particular, never fall through to FAT32's
        # non-atomic rename or recoverable-replace policy for /srv/data.
        return SyscallResult(value: _FS_ENOSYS)
    if not fat32_mount_ready():
        return SyscallResult(value: _FS_ENOSYS)
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    if fat32_atomic_replace_path_allowed(new_resolved):
        # The canonical database runtime performs temp write -> file sync ->
        # rename. Exact allowlisted destinations consume RecoverableReplaceV1;
        # there is no delete+rename or ordinary-rename fallback on failure.
        val replace_r = fs.atomic_replace_at(dev, old_resolved, new_resolved)
        if replace_r.is_err():
            return SyscallResult(value: replace_r.unwrap_err() as i64)
    else:
        val rename_r = fs.rename_at(dev, old_resolved, new_resolved)
        if rename_r.is_err():
            return SyscallResult(value: rename_r.unwrap_err() as i64)
    SyscallResult(value: 0)

fn _handle_file_rmdir(args: SyscallArgs, scheduler: Scheduler, ipc: IpcManager) -> SyscallResult:
    """Remove a directory against the kernel-global mounted Fat32Filesystem.

    UPDATE 2026-08-06: real, no longer ENOSYS-only. Calls
    `Fat32Filesystem.rmdir_at`, which returns -ENOTEMPTY unless the directory
    holds only "." and ".." and -ENOTDIR on a file."""
    val path_ptr = args.arg0 as u64
    val path_len = args.arg1 as u64
    if path_ptr == 0 or path_len == 0:
        return SyscallResult(value: _FS_EINVAL)
    if path_len > MAX_BINARY_PATH_LEN:
        return SyscallResult(value: _FS_ENAMETOOLONG)
    if not fat32_mount_ready():
        return SyscallResult(value: _FS_ENOSYS)
    var sched = scheduler
    val current = sched.get_current()
    val raw_copy = _fs_copy_user_bytes(path_ptr, path_len)
    if raw_copy == nil:
        return SyscallResult(value: _FS_EFAULT)
    val raw = raw_copy.unwrap()
    val resolved_path = _bytes_to_text(path_resolve(current.id, raw))
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    val rmdir_r = fs.rmdir_at(dev, resolved_path)
    if rmdir_r.is_err():
        return SyscallResult(value: rmdir_r.unwrap_err() as i64)
    SyscallResult(value: 0)

fn _handle_lseek(args: SyscallArgs) -> SyscallResult:
    """Reposition read/write file offset via POSIX fd layer.

    Args:
      arg0: file descriptor
      arg1: offset
      arg2: whence (0=SEEK_SET, 1=SEEK_CUR, 2=SEEK_END)

    UPDATE 2026-08-06 (this lane): FD_TYPE_FAT32 is explicitly refused with
    -ENOSYS here rather than falling through to `posix_lseek`. `posix_lseek`
    writes `os.kernel.fd_table`'s own offset scalar (`fd_set_offset`) — a
    field `fat32_fd_read_into`/`fat32_fd_write_from` never read (they track
    offset inside the fat32_fd_table-owned `FileHandle` instead). Falling
    through would make lseek report success while silently changing nothing
    a FAT32 read/write ever consults — exactly the fake-success shape this
    bug doc's HONESTY CONTRACT forbids. Worse, SEEK_END additionally sends a
    VFS_STAT IPC to a "VFS service" that
    doc/08_tracking/bug/path_based_fs_syscalls_fake_success_2026-08-06.md
    already documents as never spawned in production, i.e. it would block
    the calling task forever. Since `open`/`read`/`write` on a FAT32 fd are
    now real (this lane), that hang is newly reachable through them and must
    be refused, not left as a latent trap.
    """
    val fd = args.arg0 as i32
    if fd_get_type(fd) == FD_TYPE_FAT32:
        return SyscallResult(value: _FS_ENOSYS)
    val offset = args.arg1 as i64
    val whence = args.arg2 as u32
    SyscallResult(value: posix_lseek(fd, offset, whence))

fn _handle_ftruncate(args: SyscallArgs) -> SyscallResult:
    """Truncate an open file descriptor to the given length."""
    val fd = args.arg0 as u64
    val length = args.arg1 as i64
    if length < 0:
        return SyscallResult(value: -22)
    SyscallResult(value: -38)  # ENOSYS — needs FS driver ftruncate()

fn _handle_getcwd(args: SyscallArgs, scheduler: Scheduler) -> SyscallResult:
    """Get current working directory.

    Args:
      arg0: buffer pointer (userspace)
      arg1: buffer size
    Returns: buffer pointer on success, or negative errno.
    """
    val buf_ptr = args.arg0 as u64
    val buf_size = args.arg1 as u64
    if buf_ptr == 0:
        return SyscallResult(value: _FS_EFAULT)
    if buf_size < 2:
        return SyscallResult(value: _FS_ERANGE)
    var sched = scheduler
    val current = sched.get_current()
    val path = cwd_get(current.id)
    # Need room for the path plus its NUL terminator.
    if path.len() + 1 > buf_size:
        return SyscallResult(value: _FS_ERANGE)
    var output: [u8] = []
    var i: u64 = 0
    while i < path.len():
        output.push(path[i])
        i = i + 1
    output.push(0u8)
    if not _fs_copyout_exact(buf_ptr, output):
        return SyscallResult(value: _FS_EFAULT)
    SyscallResult(value: buf_ptr as i64)

fn _handle_chdir(args: SyscallArgs, scheduler: Scheduler) -> SyscallResult:
    """Change current working directory.

    Args:
      arg0: path pointer (userspace)
      arg1: path length
    """
    val path_ptr = args.arg0 as u64
    val path_len = args.arg1 as u64
    if path_ptr == 0 or path_len == 0:
        return SyscallResult(value: _FS_EINVAL)
    if path_len > MAX_BINARY_PATH_LEN:
        return SyscallResult(value: _FS_ENAMETOOLONG)
    if not _is_userspace_range(path_ptr, path_len):
        return SyscallResult(value: _FS_EFAULT)
    var sched = scheduler
    val current = sched.get_current()
    val raw_copy = _fs_copy_user_bytes(path_ptr, path_len)
    if raw_copy == nil:
        return SyscallResult(value: _FS_EFAULT)
    val raw = raw_copy.unwrap()
    val resolved = path_resolve(current.id, raw)
    # NOTE: the target directory's existence is NOT verified — no FAT32
    # directory-kind probe is reachable from Simple today (stream_open opens
    # files only). The cwd state change itself is real and getcwd observes it;
    # the missing check is recorded as a required primitive
    # (simpleos_fat32_path_kind(path) -> i64: 0 absent, 1 file, 2 directory)
    # rather than papered over. Until it lands, chdir to a nonexistent
    # directory succeeds where POSIX requires ENOENT.
    if not cwd_set(current.id, resolved):
        return SyscallResult(value: _FS_ENOMEM)
    SyscallResult(value: 0)
