# Current-task server startup evidence syscall owner (ABI 116).
#
# The syscall accepts no identity material. Scheduler ownership supplies the
# live TCB coordinates, and the launch registry consumes the matching
# loader-issued evidence exactly once.

use os.kernel.types.syscall_types.{SyscallResult}
use os.kernel.scheduler.scheduler_types.{Scheduler}
use os.kernel.scheduler.server_data_launch_grant_registry

fn _handle_server_startup_evidence_consume(
    scheduler: Scheduler
) -> SyscallResult:
    var sched = scheduler
    if sched.consume_current_server_startup_evidence_v1():
        return SyscallResult(value: 1)
    SyscallResult(value: 0)

