# Authoritative non-TCB teardown for a task that is about to exit or has
# already been observed as a scheduler zombie. Scheduler exit owns the CSpace
# and task state; this module owns every separate task-keyed authority ledger.

use os.kernel.types.task_types.{TaskId}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.ipc.syscall_device.{_dma_release_task_allocs, device_grant_revoke_task}
use os.kernel.lifecycle.task_cleanup.{task_cleanup}
use os.kernel.fs.fat32_fd_table.{fat32_fd_clear_task}
use os.kernel.memory.task_memory_budget.{task_memory_budget_clear}

pub fn teardown_exited_task_authority(
    task_id: TaskId,
    ipc: IpcManager
) -> IpcManager:
    """Revoke every non-TCB authority ledger for one exited task.

    This operation is deliberately idempotent. State dispatchers may observe
    an already-zombied task after scheduler exit has cleared its CSpace, but
    device, DMA, IPC, lifecycle, and FAT32 tables must still be reclaimed by
    stable TaskId before a restart or PID reuse transition is published.
    """
    _dma_release_task_allocs(task_id)
    task_cleanup(task_id.id)
    device_grant_revoke_task(task_id)
    var cleaned_ipc = ipc
    cleaned_ipc.cap_manager.revoke_all_for_task(task_id)
    cleaned_ipc.destroy_task_ports(task_id)
    fat32_fd_clear_task(task_id.id)
    task_memory_budget_clear(task_id)
    cleaned_ipc
