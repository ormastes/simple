"""Pure fork-inheritance policy for task-owned kernel resources."""

val FORK_RES_NONE: u8 = 0
val FORK_RES_NOTIFICATION: u8 = 1
val FORK_RES_IRQ_ROUTE: u8 = 2
val FORK_RES_DMA_BUFFER: u8 = 3
val FORK_RES_BAR_MAPPING: u8 = 4

fn resource_fork_inheritable(resource_type: u8) -> bool:
    """Only resources with no memory/ownership alias may cross fork."""
    # @decision RFP_KIND
    resource_type == FORK_RES_NONE or
        resource_type == FORK_RES_NOTIFICATION or
        resource_type == FORK_RES_IRQ_ROUTE

fn resource_set_fork_allowed(resource_types: [u8]) -> bool:
    # @decision RFP_SET
    for resource_type in resource_types:
        if not resource_fork_inheritable(resource_type):
            return false
    true

export FORK_RES_NONE, FORK_RES_NOTIFICATION, FORK_RES_IRQ_ROUTE,
    FORK_RES_DMA_BUFFER, FORK_RES_BAR_MAPPING, resource_fork_inheritable,
    resource_set_fork_allowed
