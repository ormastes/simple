#![allow(REQC004)]
# SimpleOS Kernel Replay — Hook Functions
#
# Called from kernel subsystems (scheduler, syscall, IPC, interrupts, timer).
# Each hook checks replay_is_off() first — single load + branch, zero cost
# when replay is disabled.
#
# Hooks whose replay returns or validates a value — timer and random reads,
# syscall results, IRQ delivery, IPC send/receive — run on the portable
# semantic replay core std.replay.portable_replay (DHR P6), in replay scope
# KERNEL_PR_SCOPE; they are not written to the kernel log ring. The ring keeps
# the schedule hook (Replay follows its logged tid) and the diagnostic hooks
# whose Replay makes no decision: syscall enter, thread create/exit and
# checkpoint markers.

use os.kernel.replay.mode.{replay_is_off, replay_is_recording, replay_is_verifying, replay_mode, KernelReplayMode}
use os.kernel.replay.event_kinds.{ReplayEntry, EventKind}
use os.kernel.replay.log_buffer.{replay_log_event, replay_read_next}
use os.kernel.replay.divergence.{DivergenceKind, report_divergence}
use std.replay.portable_replay.{
    PR_MODE_RECORD, PR_MODE_REPLAY, PR_KIND_TIMER_READ, PR_KIND_RANDOM_READ,
    PR_DIV_NONE, PR_DIV_LOG_EXHAUSTED,
    portable_replay_set_mode, portable_replay_mode, portable_replay_open_scope,
    portable_replay_scope_is_open, portable_replay_event, portable_replay_last_divergence
}

val KERNEL_PR_SCOPE: i64 = 2
# Keyed events fold their key into a layer-defined kind
# (base + key * stride): the timer source, the syscall id, the IPC port. A
# different key than the recorded one is then a kind mismatch. Every derived
# kind stays congruent to its base modulo the stride, so the kernel bases
# below (5..8) never collide with the core kinds (1..4) or with each other.
val KERNEL_PR_KIND_STRIDE: i64 = 16
val KERNEL_PR_KIND_SYSCALL_EXIT: i64 = 5
val KERNEL_PR_KIND_IRQ: i64 = 6
val KERNEL_PR_KIND_IPC_SEND: i64 = 7
val KERNEL_PR_KIND_IPC_RECV: i64 = 8

fn replay_portable_sync():
    """Mirror the (non-Off) kernel mode onto the portable replay session.
    Record/ChaosRecord record; Replay and Verify both read the core's log
    (Verify then compares against the live value and returns it)."""
    var want = PR_MODE_REPLAY
    if replay_is_recording():
        want = PR_MODE_RECORD
    if portable_replay_mode() != want:
        portable_replay_set_mode(want)
    if not portable_replay_scope_is_open():
        portable_replay_open_scope(KERNEL_PR_SCOPE)

# Shared Replay/Verify tail of the value-returning hooks (timer, random,
# syscall result). `logged` is what the
# core returned for this event. Replay returns it — the logged value, or the
# core's fail-closed value on divergence, never `live`. Verify returns `live`
# and reports a changed or mismatched event; an exhausted log is not reported
# in Verify (as before P6). The core keeps no kernel event id, so reports
# carry event_id -1 and, on a core divergence, the PR_DIV_* reason as expected.
@allow(primitive_api)  # kernel replay ABI: values and divergence codes are raw i64 log payloads
fn replay_portable_resolve(kind: DivergenceKind, logged: i64, live: i64, actual: i64) -> i64:
    val reason = portable_replay_last_divergence()
    if replay_is_verifying():
        if reason == PR_DIV_NONE:
            if logged != live:
                report_divergence(kind, -1, logged, live)
        elif reason != PR_DIV_LOG_EXHAUSTED:
            report_divergence(kind, -1, reason, live)
        return live
    if reason != PR_DIV_NONE:
        report_divergence(kind, -1, reason, actual)
    logged

# Replay/Verify tail of the validating hooks (IRQ, IPC): the live event may
# proceed only if it matches the logged one. Verify always lets it proceed and
# reports as replay_portable_resolve does. Replay rejects (false) a core
# divergence — already reported by resolve — or a logged value that differs
# from `live`, which it reports; it never accepts the live event on divergence.
@allow(primitive_api)  # kernel replay ABI: values are raw i64 log payloads
fn replay_portable_accept(kind: DivergenceKind, logged: i64, live: i64) -> bool:
    val diverged = portable_replay_last_divergence() != PR_DIV_NONE
    val resolved = replay_portable_resolve(kind, logged, live, live)
    if replay_is_verifying():
        return true
    if diverged:
        return false
    if resolved != live:
        report_divergence(kind, -1, resolved, live)
        return false
    true

# ============================================================================
# Schedule Hook
# ============================================================================

# Returns the tid the scheduler must run. Off/Record/Verify return the live
# pick `new_tid`. Replay returns the logged tid so the scheduler follows the
# recording; a wrong event or an exhausted log is a divergence and returns -1
# (fail closed: the caller must not fall back to the live pick).
@allow(primitive_api)  # kernel replay ABI: tids and ticks are raw i64 log payloads
fn replay_hook_schedule(old_tid: i64, new_tid: i64, tick: i64) -> i64:
    if replay_is_off():
        return new_tid

    if replay_is_recording():
        var entry = ReplayEntry.create(EventKind.Schedule, old_tid, 0, 0)
        entry.payload_a = old_tid
        entry.payload_b = new_tid
        entry.payload_c = tick
        replay_log_event(entry)
        return new_tid

    match replay_mode():
        case KernelReplayMode.Replay:
            match replay_read_next():
                case Some(entry):
                    if entry.kind == EventKind.Schedule.to_i32():
                        return entry.payload_b
                    report_divergence(DivergenceKind.ScheduleMismatch, entry.event_id, entry.kind.to_i64(), new_tid)
                    return -1
                case None:
                    report_divergence(DivergenceKind.ScheduleMismatch, -1, -1, new_tid)
                    return -1
        case KernelReplayMode.Verify:
            match replay_read_next():
                case Some(entry):
                    # Verify recorded schedule matches live decision
                    if entry.payload_b != new_tid:
                        report_divergence(DivergenceKind.ScheduleMismatch, entry.event_id, entry.payload_b, new_tid)
                    return new_tid
                case None:
                    return new_tid
        case _:
            return new_tid
    new_tid

# ============================================================================
# Syscall Hooks
# ============================================================================

# Diagnostic only: Replay makes no decision here (the forced result is applied
# at exit), so syscall entry stays on the kernel ring.
fn replay_hook_syscall_enter(task_id: i64, syscall_id: i64, arg0: i64, arg1: i64, arg2: i64):
    if replay_is_off():
        return

    if replay_is_recording():
        var entry = ReplayEntry.create(EventKind.SyscallEnter, task_id, 0, 0)
        entry.payload_a = syscall_id
        entry.payload_b = arg0
        entry.payload_c = arg1
        entry.payload_d = arg2
        replay_log_event(entry)
        return

    match replay_mode():
        case KernelReplayMode.Replay:
            match replay_read_next():
                case Some(entry):
                    pass_dn  # consumed — replayer drives syscall from log
                case None:
                    pass_dn
        case KernelReplayMode.Verify:
            match replay_read_next():
                case Some(entry):
                    if entry.payload_a != syscall_id:
                        report_divergence(DivergenceKind.SyscallMismatch, entry.event_id, entry.payload_a, syscall_id)
                case None:
                    pass_dn
        case _:
            pass_dn

# Returns the result the syscall must report. Replay returns the logged retval
# for this syscall; a different syscall, a wrong event or an exhausted log is a
# SyscallMismatch divergence and returns the fail-closed value, never `retval`.
@allow(primitive_api)  # kernel replay ABI: syscall ids and results are raw i64 log payloads
fn replay_hook_syscall_exit(task_id: i64, syscall_id: i64, retval: i64) -> i64:
    if replay_is_off():
        return retval
    replay_portable_sync()
    val kind = KERNEL_PR_KIND_SYSCALL_EXIT + syscall_id * KERNEL_PR_KIND_STRIDE
    val logged = portable_replay_event(kind, KERNEL_PR_SCOPE, retval)
    if replay_is_recording():
        return retval
    replay_portable_resolve(DivergenceKind.SyscallMismatch, logged, retval, syscall_id)

# ============================================================================
# Interrupt Hook
# ============================================================================

# Returns whether the IRQ may be delivered. Replay accepts it only when the
# log's next event is this vector; anything else is an IrqMismatch divergence
# and returns false (fail closed: the caller must not deliver it).
@allow(primitive_api)  # kernel replay ABI: vectors are raw i64 log payloads
fn replay_hook_irq(vector: i64, task_id: i64, timestamp: i64) -> bool:
    if replay_is_off():
        return true
    replay_portable_sync()
    val logged = portable_replay_event(KERNEL_PR_KIND_IRQ, KERNEL_PR_SCOPE, vector)
    if replay_is_recording():
        return true
    replay_portable_accept(DivergenceKind.IrqMismatch, logged, vector)

# ============================================================================
# IPC Hooks
# ============================================================================

# Return whether the send/receive may complete. Replay accepts it only when
# the log's next event is a send (receive) on the same port with the same
# message length; anything else is an IpcMismatch divergence and returns
# false (fail closed: the caller must not complete the transfer).
@allow(primitive_api)  # kernel replay ABI: ports and lengths are raw i64 log payloads
fn replay_hook_ipc_send(src_task: i64, dst_port: i64, msg_len: i64) -> bool:
    if replay_is_off():
        return true
    replay_portable_sync()
    val kind = KERNEL_PR_KIND_IPC_SEND + dst_port * KERNEL_PR_KIND_STRIDE
    val logged = portable_replay_event(kind, KERNEL_PR_SCOPE, msg_len)
    if replay_is_recording():
        return true
    replay_portable_accept(DivergenceKind.IpcMismatch, logged, msg_len)

@allow(primitive_api)  # kernel replay ABI: ports and lengths are raw i64 log payloads
fn replay_hook_ipc_recv(dst_task: i64, src_port: i64, msg_len: i64) -> bool:
    if replay_is_off():
        return true
    replay_portable_sync()
    val kind = KERNEL_PR_KIND_IPC_RECV + src_port * KERNEL_PR_KIND_STRIDE
    val logged = portable_replay_event(kind, KERNEL_PR_SCOPE, msg_len)
    if replay_is_recording():
        return true
    replay_portable_accept(DivergenceKind.IpcMismatch, logged, msg_len)

# ============================================================================
# Timer Hook
# ============================================================================

# Replay returns the logged counter for this source instead of the hardware
# read; a different source, a wrong event or an exhausted log is a
# TimerMismatch divergence and returns the fail-closed value, never `value`.
fn replay_hook_timer_read(source_id: i64, value: i64) -> i64:
    if replay_is_off():
        return value
    replay_portable_sync()
    val kind = PR_KIND_TIMER_READ + source_id * KERNEL_PR_KIND_STRIDE
    val logged = portable_replay_event(kind, KERNEL_PR_SCOPE, value)
    if replay_is_recording():
        return value
    replay_portable_resolve(DivergenceKind.TimerMismatch, logged, value, source_id)

# ============================================================================
# Thread Lifecycle Hooks
# ============================================================================

# Diagnostic only (no caller consumes a forced tid; Replay makes no decision),
# so thread create/exit stay on the kernel ring.
fn replay_hook_thread_create(parent_tid: i64, child_tid: i64, entry_addr: i64):
    if replay_is_off():
        return

    if replay_is_recording():
        var entry = ReplayEntry.create(EventKind.ThreadCreate, parent_tid, 0, 0)
        entry.payload_a = parent_tid
        entry.payload_b = child_tid
        entry.payload_c = entry_addr
        replay_log_event(entry)
        return

    match replay_mode():
        case KernelReplayMode.Replay:
            match replay_read_next():
                case Some(entry):
                    pass_dn  # replayer forces child_tid from log
                case None:
                    pass_dn
        case KernelReplayMode.Verify:
            match replay_read_next():
                case Some(entry):
                    if entry.payload_b != child_tid:
                        report_divergence(DivergenceKind.ThreadMismatch, entry.event_id, entry.payload_b, child_tid)
                case None:
                    pass_dn
        case _:
            pass_dn

fn replay_hook_thread_exit(task_id: i64, exit_code: i64):
    if replay_is_off():
        return

    if replay_is_recording():
        var entry = ReplayEntry.create(EventKind.ThreadExit, task_id, 0, 0)
        entry.payload_a = exit_code
        replay_log_event(entry)
        return

    match replay_mode():
        case KernelReplayMode.Replay:
            match replay_read_next():
                case Some(entry):
                    pass_dn  # consumed
                case None:
                    pass_dn
        case KernelReplayMode.Verify:
            match replay_read_next():
                case Some(entry):
                    if entry.payload_a != exit_code:
                        report_divergence(DivergenceKind.ThreadMismatch, entry.event_id, entry.payload_a, exit_code)
                case None:
                    pass_dn
        case _:
            pass_dn

# ============================================================================
# Random/Entropy Hook
# ============================================================================

# Replay returns the logged entropy instead of the hardware RNG; a wrong event
# or an exhausted log is a RandomMismatch divergence and returns the
# fail-closed value, never `value`.
fn replay_hook_random_read(task_id: i64, value: i64) -> i64:
    if replay_is_off():
        return value
    replay_portable_sync()
    val logged = portable_replay_event(PR_KIND_RANDOM_READ, KERNEL_PR_SCOPE, value)
    if replay_is_recording():
        return value
    replay_portable_resolve(DivergenceKind.RandomMismatch, logged, value, value)

# ============================================================================
# Checkpoint Marker
# ============================================================================

# Diagnostic marker: Replay only consumes it, so it stays on the kernel ring.
fn replay_hook_checkpoint(checkpoint_id: i64):
    if replay_is_off():
        return

    if replay_is_recording():
        var entry = ReplayEntry.create(EventKind.Checkpoint, 0, 0, 0)
        entry.payload_a = checkpoint_id
        replay_log_event(entry)
        return

    match replay_mode():
        case KernelReplayMode.Replay:
            match replay_read_next():
                case Some(entry):
                    pass_dn  # checkpoint marker consumed
                case None:
                    pass_dn
        case KernelReplayMode.Verify:
            match replay_read_next():
                case Some(entry):
                    if entry.payload_a != checkpoint_id:
                        report_divergence(DivergenceKind.CheckpointMismatch, entry.event_id, entry.payload_a, checkpoint_id)
                case None:
                    pass_dn
        case _:
            pass_dn
