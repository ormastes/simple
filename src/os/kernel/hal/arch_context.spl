# Public Kernel HAL Facade — Generic Architecture Types & Identity.

export use os.kernel.arch.arch_context.{
    Architecture,
    ArchContext,
    X86_64Context,
    X86Context,
    Riscv64Context,
    Riscv32Context,
    Arm64Context,
    Arm32Context,
    BootArgs,
    JmpBufX86_64,
    JmpBufX86,
    JmpBufArm64,
    JmpBufArm32,
    JmpBufRv64,
    JmpBufRv32,
    JmpBuf,
    ExtendedCtxX86_64,
    ExtendedCtxArm64,
    ExtendedCtxArm32,
    ExtendedCtxRv,
    ExtendedCtx
}

# Bind the generic arch types straight from their owner instead of through
# `os.kernel.arch_adapt.arch_surface`: that surface also re-exports the
# user-entry/reset bridges, which drag the whole kernel loader/VFS/netstack
# into every hosted importer of `Architecture` (e.g. the `simple os` CLI).
use os.kernel.arch.mod.{get_arch}

pub fn current_architecture() -> Architecture:
    """Return the compile-time target architecture selected by `@cfg`."""
    get_arch()
