# Architecture-selected kernel/user copy facade.
# ARM64 EL0 address spaces are owned by the recorded TTBR0 walker in the
# bare-metal runtime; other current kernels retain the generic VMM walker.

use os.kernel.memory.vmm.{
    VmmCopyBytesResult, VmmUserCopyStatus,
    vmm_copyin_bytes, vmm_copyout_bytes, vmm_copy_bytes_result_ok
}

@cfg(arm64)
extern fn rt_arm64_user_copyin(dst: u64, user: u64, len: u64) -> i64
@cfg(arm64)
extern fn rt_arm64_user_copyout(user: u64, src: u64, len: u64) -> i64
@cfg(arm64)
extern fn rt_array_data_ptr_text(bytes: [u8]) -> u64

@cfg(arm64)
fn user_copyin_bytes(ptr: u64, len: u64) -> VmmCopyBytesResult:
    if len == 0:
        return VmmCopyBytesResult(
            status: VmmUserCopyStatus(ok: true, errno: 0, bytes_read: 0),
            bytes: []
        )
    var bytes = [0u8; len]
    # `.data_ptr()` has no native-codegen lowering (resolves to the
    # nonexistent dynamic symbol Array.data_ptr at Stage 2 link — see
    # secure_memory.spl). rt_array_data_ptr_text returns the ENCODE_INT'd
    # items address (TAG_INT==0, value<<3); >>3 decodes the raw pointer.
    val copied = rt_arm64_user_copyin(rt_array_data_ptr_text(bytes) >> 3, ptr, len)
    if copied < 0:
        return VmmCopyBytesResult(
            status: VmmUserCopyStatus(ok: false, errno: copied as i32, bytes_read: 0),
            bytes: []
        )
    VmmCopyBytesResult(
        status: VmmUserCopyStatus(ok: true, errno: 0, bytes_read: copied as u64),
        bytes: bytes
    )

@cfg(arm64)
fn user_copyout_bytes(ptr: u64, bytes: [u8]) -> i64:
    if bytes.len() == 0:
        return 0
    rt_arm64_user_copyout(ptr, rt_array_data_ptr_text(bytes) >> 3, bytes.len())

# Validated copy-in: returns Some(bytes) on an exact-length copy, nil on any
# failure (the EFAULT mapping callers expect). The aarch64 variant drives
# rt_arm64_user_copyin DIRECTLY — the VmmCopyBytesResult wrapper's `bytes`
# field read degrades on this lane (run-20260926_035958: a successful
# 35-byte copy nil'd on `copied.bytes.len() != len`), so the wrapper result
# cannot be trusted here; the array's own .len() is the validation. A failed
# copy yields an empty array, which fails the len check for any nonzero len.

@cfg(arm64)
fn user_copyin_bytes_validated(ptr: u64, len: u64) -> [u8]?:
    var bytes = [0u8; len]
    val copied = rt_arm64_user_copyin(rt_array_data_ptr_text(bytes) >> 3, ptr, len)
    if copied < 0:
        return nil
    if bytes.len() != len:
        return nil
    Some(bytes)

@cfg(x86_64)
fn user_copyin_bytes_validated(ptr: u64, len: u64) -> [u8]?:
    val copied = user_copyin_bytes(ptr, len)
    if not vmm_copy_bytes_result_ok(copied):
        return nil
    if copied.status.bytes_read != len or copied.bytes.len() != len:
        return nil
    Some(copied.bytes)

@cfg(riscv64)
fn user_copyin_bytes_validated(ptr: u64, len: u64) -> [u8]?:
    val copied = user_copyin_bytes(ptr, len)
    if not vmm_copy_bytes_result_ok(copied):
        return nil
    if copied.status.bytes_read != len or copied.bytes.len() != len:
        return nil
    Some(copied.bytes)

@cfg(riscv32)
fn user_copyin_bytes_validated(ptr: u64, len: u64) -> [u8]?:
    val copied = user_copyin_bytes(ptr, len)
    if not vmm_copy_bytes_result_ok(copied):
        return nil
    if copied.status.bytes_read != len or copied.bytes.len() != len:
        return nil
    Some(copied.bytes)

@cfg(x86_64)
fn user_copyin_bytes(ptr: u64, len: u64) -> VmmCopyBytesResult:
    vmm_copyin_bytes(ptr, len)

@cfg(x86_64)
fn user_copyout_bytes(ptr: u64, bytes: [u8]) -> i64:
    vmm_copyout_bytes(ptr, bytes) as i64

@cfg(riscv64)
fn user_copyin_bytes(ptr: u64, len: u64) -> VmmCopyBytesResult:
    vmm_copyin_bytes(ptr, len)

@cfg(riscv64)
fn user_copyout_bytes(ptr: u64, bytes: [u8]) -> i64:
    vmm_copyout_bytes(ptr, bytes) as i64

@cfg(riscv32)
fn user_copyin_bytes(ptr: u64, len: u64) -> VmmCopyBytesResult:
    vmm_copyin_bytes(ptr, len)

@cfg(riscv32)
fn user_copyout_bytes(ptr: u64, bytes: [u8]) -> i64:
    vmm_copyout_bytes(ptr, bytes) as i64
