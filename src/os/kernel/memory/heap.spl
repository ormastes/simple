# Kernel Heap — Memory Layer (Layer 1)
#
# mimalloc-backed kernel heap. heap_alloc/heap_free delegate to
# mi_malloc_raw/mi_free_raw. The OS page provider (_kernel_pmm_page_alloc)
# is a bump allocator inside the pre-mapped heap region. mi_malloc_raw uses
# MiPage sub-page bucketing so small allocs share 4 KiB pages.

use os.kernel.types.memory_types.{PhysAddr, VirtAddr, VmFlags}
use nogc_sync_mut.mimalloc.{MiHeap, mimalloc_init, mimalloc_set_os_page_alloc, mi_malloc_raw, mi_free_raw}
use os.kernel.memory.pmm.{pmm_alloc_page}

# ============================================================================
# Kernel Heap
# ============================================================================

struct KernelHeap:
    """Kernel heap state tracking. Allocation is handled by mimalloc via
    mi_malloc_raw; this struct records bookkeeping totals only.
    """
    base: u64           # Virtual start of heap region
    size: u64           # Total heap size
    total_allocated: u64    # Bytes currently allocated (approximate)
    total_free: u64         # Bytes currently free (approximate)
    alloc_count: u64        # Number of active allocations

# ============================================================================
# Global Heap Instance
# ============================================================================

var g_heap: KernelHeap = KernelHeap(
    base: 0,
    size: 0,
    total_allocated: 0,
    total_free: 0,
    alloc_count: 0
)

# Bump pointer within the pre-mapped heap region (used by _kernel_pmm_page_alloc)
var _g_bump_ptr: u64 = 0
var _g_bump_end: u64 = 0
var _g_alloc_addrs: [u64] = []
var _g_alloc_sizes: [u64] = []
var _g_alloc_meta_ready: bool = false
var _g_reclaimed_bases: [u64] = []
var _g_reclaimed_sizes: [u64] = []
var _g_reclaimed_ready: bool = false

val _HEAP_LARGE_DIRECT_THRESHOLD: u64 = 65536

fn _ensure_heap_meta():
    if not _g_alloc_meta_ready:
        _g_alloc_addrs = []
        _g_alloc_sizes = []
        _g_alloc_meta_ready = true
    if not _g_reclaimed_ready:
        _g_reclaimed_bases = []
        _g_reclaimed_sizes = []
        _g_reclaimed_ready = true

fn _reset_heap_meta():
    _g_alloc_addrs = []
    _g_alloc_sizes = []
    _g_alloc_meta_ready = true
    _g_reclaimed_bases = []
    _g_reclaimed_sizes = []
    _g_reclaimed_ready = true

fn _track_heap_alloc(addr: u64, size: u64):
    _ensure_heap_meta()
    var i: u64 = 0
    while i < _g_alloc_addrs.len():
        if _g_alloc_addrs[i] == 0:
            _g_alloc_addrs[i] = addr
            _g_alloc_sizes[i] = size
            return
        i = i + 1
    _g_alloc_addrs.push(addr)
    _g_alloc_sizes.push(size)

fn _take_tracked_heap_size(addr: u64) -> u64:
    _ensure_heap_meta()
    var i: u64 = 0
    while i < _g_alloc_addrs.len():
        if _g_alloc_addrs[i] == addr:
            val size = _g_alloc_sizes[i]
            _g_alloc_addrs[i] = 0
            _g_alloc_sizes[i] = 0
            return size
        i = i + 1
    0

fn heap_tracked_alloc_size(addr: VirtAddr) -> u64:
    """Return tracked allocation byte size for a live kernel heap pointer, or 0."""
    _ensure_heap_meta()
    var i: u64 = 0
    while i < _g_alloc_addrs.len():
        if _g_alloc_addrs[i] == addr.addr:
            return _g_alloc_sizes[i]
        i = i + 1
    0

fn _reclaim_heap_pages(base: u64, alloc_bytes: u64):
    _ensure_heap_meta()
    if alloc_bytes == 0:
        return
    val end = base + alloc_bytes
    var free_slot: i64 = -1
    var i: u64 = 0
    while i < _g_reclaimed_bases.len():
        val avail = _g_reclaimed_sizes[i]
        if avail == 0:
            if free_slot < 0:
                free_slot = i as i64
        else:
            val existing_base = _g_reclaimed_bases[i]
            val existing_end = existing_base + avail
            if base < existing_end and end > existing_base:
                log_raw_println("[HEAP] WARNING: ignoring duplicate reclaimed page span")
                return
        i = i + 1
    if free_slot >= 0:
        val slot = free_slot as u64
        _g_reclaimed_bases[slot] = base
        _g_reclaimed_sizes[slot] = alloc_bytes
        return
    _g_reclaimed_bases.push(base)
    _g_reclaimed_sizes.push(alloc_bytes)

fn _alloc_reclaimed_pages(alloc_bytes: u64) -> u64:
    _ensure_heap_meta()
    var i: u64 = 0
    while i < _g_reclaimed_bases.len():
        val avail = _g_reclaimed_sizes[i]
        if avail >= alloc_bytes:
            val base = _g_reclaimed_bases[i]
            val rem = avail - alloc_bytes
            if rem == 0:
                _g_reclaimed_bases[i] = 0
                _g_reclaimed_sizes[i] = 0
            else:
                _g_reclaimed_bases[i] = base + alloc_bytes
                _g_reclaimed_sizes[i] = rem
            return base
        i = i + 1
    0

# Forward declarations
use os.kernel.log.klog_api.{log_raw_println}
extern fn vmm_map_page(virt: VirtAddr, phys: PhysAddr, flags: VmFlags) -> bool

use os.kernel.types.memory_types.{PageFrame}

# ============================================================================
# OS page provider for mimalloc — bump allocator inside pre-mapped heap region
# ============================================================================

val _HEAP_PAGE_SIZE: u64 = 4096

fn _kernel_pmm_page_alloc(size: usize) -> usize:
    """Page-aligned allocator within the pre-mapped heap virtual region.

    Reuses reclaimed large-page spans before bumping _g_bump_ptr. Returns 0 on
    exhaustion or in uninitialized interpreter mode (_g_bump_end == 0).
    """
    if _g_bump_ptr == 0 or _g_bump_end == 0:
        return 0
    val pages_needed = (size as u64 + _HEAP_PAGE_SIZE - 1) / _HEAP_PAGE_SIZE
    val alloc_bytes = pages_needed * _HEAP_PAGE_SIZE
    val reused = _alloc_reclaimed_pages(alloc_bytes)
    if reused != 0:
        return reused as usize
    if _g_bump_ptr + alloc_bytes > _g_bump_end:
        return 0
    val addr = _g_bump_ptr
    _g_bump_ptr = _g_bump_ptr + alloc_bytes
    addr as usize

# ============================================================================
# Heap Initialization
# ============================================================================

fn heap_init(start: VirtAddr, size: u64):
    """Initialize the kernel heap.

    Maps the heap virtual region to physical pages, sets up the bump
    allocator, initialises mimalloc, and injects the OS page provider.
    The caller must ensure the virtual address range is available.

    Args:
        start: Virtual address of heap start (must be page-aligned)
        size:  Heap size in bytes (must be >= 4096)
    """
    log_raw_println("[HEAP] Initializing kernel heap...")
    log_raw_println("[HEAP] Base: 0x{start.addr} Size: {size} bytes ({size / 1024}KB)")

    val heap_min: u64 = 4096
    if size < heap_min:
        log_raw_println("[HEAP] FATAL: Heap too small")
        return

    val base = start.addr

    # Map heap pages to physical memory
    _map_heap_region(base, size)

    # Initialize global heap tracking
    g_heap = KernelHeap(
        base: base,
        size: size,
        total_allocated: 0,
        total_free: size,
        alloc_count: 0
    )

    # Set up bump region for the mimalloc OS page provider
    _g_bump_ptr = base
    _g_bump_end = base + size
    _reset_heap_meta()

    # Wire mimalloc as the backing allocator
    mimalloc_init(MiHeap(size_classes: [], pages_by_class: []))
    mimalloc_set_os_page_alloc(_kernel_pmm_page_alloc)

    log_raw_println("[HEAP] Initialization complete (mimalloc), {size} bytes available")

fn heap_init_identity(start: VirtAddr, size: u64):
    """Initialize the kernel heap for identity-mapped direct boot lanes."""
    log_raw_println("[HEAP] Initializing identity-mapped kernel heap...")
    log_raw_println("[HEAP] Base: 0x{start.addr} Size: {size} bytes ({size / 1024}KB)")

    val heap_min: u64 = 4096
    if size < heap_min:
        log_raw_println("[HEAP] FATAL: Heap too small")
        return

    val base = start.addr
    g_heap = KernelHeap(
        base: base,
        size: size,
        total_allocated: 0,
        total_free: size,
        alloc_count: 0
    )

    _g_bump_ptr = base
    _g_bump_end = base + size
    _reset_heap_meta()

    mimalloc_init(MiHeap(size_classes: [], pages_by_class: []))
    mimalloc_set_os_page_alloc(_kernel_pmm_page_alloc)

    log_raw_println("[HEAP] Identity initialization complete (mimalloc), {size} bytes available")

fn _map_heap_region(base: u64, size: u64):
    """Map heap virtual pages to physical frames."""
    val page_size: u64 = 4096
    val page_count = (size + page_size - 1) / page_size
    val flags = VmFlags.kernel_rw()

    var i: u64 = 0
    while i < page_count:
        val virt = VirtAddr(addr: base + (i * page_size))
        val frame = pmm_alloc_page()
        if val Some(f) = frame:
            val phys = f.to_phys_addr()
            vmm_map_page(virt, phys, flags)
        else:
            log_raw_println("[HEAP] WARNING: Could not allocate page for heap")
        i = i + 1

# ============================================================================
# Heap Allocation
# ============================================================================

fn heap_alloc(size: usize) -> VirtAddr?:
    """Allocate memory from the kernel heap via mimalloc.

    Delegates to mi_malloc_raw which uses the pre-mapped bump region.
    Returns nil if allocation fails (exhausted or not yet initialized).

    Args:
        size: Requested allocation size in bytes
    """
    if size == 0:
        return nil

    val addr = mi_malloc_raw(size)
    if addr == 0:
        return nil

    val tracked_size = size as u64
    _track_heap_alloc(addr as u64, tracked_size)
    g_heap.total_allocated = g_heap.total_allocated + tracked_size
    if g_heap.total_free >= tracked_size:
        g_heap.total_free = g_heap.total_free - tracked_size
    g_heap.alloc_count = g_heap.alloc_count + 1

    Some(VirtAddr(addr: addr as u64))

# ============================================================================
# Heap Deallocation
# ============================================================================

fn heap_free(addr: VirtAddr):
    """Free a heap allocation.

    Recovers the allocation size recorded by heap_alloc so mimalloc returns the
    block to its owning size-class freelist (or reclaimed page pool for large
    allocations) and keeps byte counters accurate.

    Args:
        addr: Virtual address previously returned by heap_alloc
    """
    heap_free_size(addr, 0)

fn heap_free_size(addr: VirtAddr, size: usize):
    """Free a heap allocation with explicit or recorded allocation size."""
    if addr.addr == 0:
        return

    # Validate: address must be within heap range
    if addr.addr < g_heap.base:
        log_raw_println("[HEAP] WARNING: free() on address below heap")
        return
    if addr.addr >= g_heap.base + g_heap.size:
        log_raw_println("[HEAP] WARNING: free() on address above heap")
        return

    val recorded_size = _take_tracked_heap_size(addr.addr)
    if recorded_size == 0:
        log_raw_println("[HEAP] WARNING: free() on untracked or already-freed address")
        return
    if size > 0 and (size as u64) != recorded_size:
        log_raw_println("[HEAP] WARNING: free_size() mismatch; using tracked size")
    val effective_size_u64 = recorded_size

    mi_free_raw(addr.addr as usize, effective_size_u64 as usize)
    if effective_size_u64 > _HEAP_LARGE_DIRECT_THRESHOLD:
        val pages_freed = (effective_size_u64 + _HEAP_PAGE_SIZE - 1) / _HEAP_PAGE_SIZE
        _reclaim_heap_pages(addr.addr, pages_freed * _HEAP_PAGE_SIZE)

    if g_heap.alloc_count > 0:
        g_heap.alloc_count = g_heap.alloc_count - 1
    if g_heap.total_allocated >= effective_size_u64:
        g_heap.total_allocated = g_heap.total_allocated - effective_size_u64
    else:
        g_heap.total_allocated = 0
    val new_free = g_heap.total_free + effective_size_u64
    if new_free <= g_heap.size:
        g_heap.total_free = new_free
    else:
        g_heap.total_free = g_heap.size

# ============================================================================
# Heap Query Interface
# ============================================================================

fn heap_total_allocated() -> u64:
    """Total bytes currently allocated."""
    g_heap.total_allocated

fn heap_total_free() -> u64:
    """Total bytes currently free."""
    g_heap.total_free

fn heap_alloc_count() -> u64:
    """Number of active allocations."""
    g_heap.alloc_count

fn heap_integrity_check() -> bool:
    """Basic sanity check: allocated <= total heap size."""
    g_heap.total_allocated <= g_heap.size
