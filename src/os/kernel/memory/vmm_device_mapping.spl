"""Transactional explicit-address-space mapping for device MMIO windows."""

use os.kernel.types.memory_types.{PhysAddr, VirtAddr, VmFlags, VM_PRESENT,
    VM_WRITABLE, VM_USER, VM_CACHE_DISABLE, VM_NO_EXECUTE}
use os.kernel.types.task_types.{AddressSpace}
use os.kernel.types.vmspace_types.{VmArea, ProcessVmSpace, VMA_DEVICE,
    VMA_READ, VMA_WRITE, MAX_VMAS}
use os.kernel.memory.vmm_core.{PTE_ADDR_MASK, PTE_PRESENT, PTE_WRITABLE,
    PTE_USER, PTE_WRITE_THROUGH, PTE_CACHE_DISABLE, PTE_NO_EXECUTE}
use os.kernel.memory.vmm_address_space.{vmm_map_page_in, vmm_read_pte_in,
    vmm_unmap_page_in, vmm_replace_pte_in}
use os.kernel.memory.vmm_vma.{vma_add, vma_remove}
use os.kernel.memory.vmm_device.{VmmDeviceWindowPlan, vmm_device_plan_window,
    VMM_DEVICE_PAGE_SIZE, VMM_DEVICE_USER_BASE, VMM_DEVICE_USER_LIMIT}

struct VmmDeviceMapResult:
    code: i32
    reason: text
    space: ProcessVmSpace
    user_addr: u64
    map_start: u64
    map_len: u64
    physical_page: u64

struct VmmDeviceUnmapResult:
    code: i32
    reason: text
    space: ProcessVmSpace

fn _vmm_device_map_result(code: i32, reason: text, space: ProcessVmSpace,
        plan: VmmDeviceWindowPlan) -> VmmDeviceMapResult:
    VmmDeviceMapResult(code: code, reason: reason, space: space,
        user_addr: if code == 0: plan.user_addr else: 0u64,
        map_start: plan.map_start, map_len: plan.map_len,
        physical_page: plan.physical_page)

fn _vmm_device_area_end(area: VmArea) -> u64:
    if area.start + area.len < area.start: 0u64 else: area.start + area.len

fn _vmm_device_range_available(space: ProcessVmSpace, start: u64, len: u64) -> bool:
    if len == 0u64 or start + len < start or space.vma_count > MAX_VMAS or
            space.vma_count > space.areas.len().to_u64():
        return false
    val finish = start + len
    var index: i64 = 0
    while index.to_u64() < space.vma_count:
        val area = space.areas[index]
        val area_end = _vmm_device_area_end(area)
        if area_end == 0u64 or (area.start < finish and area_end > start):
            return false
        index = index + 1
    true

fn _vmm_device_pick_range(space: ProcessVmSpace, len: u64) -> u64:
    var candidate = VMM_DEVICE_USER_BASE
    var passes: u64 = 0u64
    while passes <= space.vma_count:
        if candidate + len < candidate or candidate + len > VMM_DEVICE_USER_LIMIT:
            return 0u64
        var moved = false
        var index: i64 = 0
        while index.to_u64() < space.vma_count and index < space.areas.len():
            val area = space.areas[index]
            val area_end = _vmm_device_area_end(area)
            if area_end == 0u64:
                return 0u64
            if area.start < candidate + len and area_end > candidate:
                if area_end > VMM_DEVICE_USER_LIMIT -
                        (VMM_DEVICE_PAGE_SIZE - 1u64):
                    return 0u64
                candidate = ((area_end + VMM_DEVICE_PAGE_SIZE - 1u64) /
                    VMM_DEVICE_PAGE_SIZE) * VMM_DEVICE_PAGE_SIZE
                moved = true
                break
            index = index + 1
        if not moved:
            return candidate
        passes = passes + 1u64
    0u64

fn vmm_map_device_result(space: ProcessVmSpace, physical_addr: u64,
        byte_len: u64, hint_page: u64) -> VmmDeviceMapResult:
    var seed = vmm_device_plan_window(physical_addr, byte_len, hint_page,
        VMM_DEVICE_USER_BASE)
    if not seed.ok:
        return _vmm_device_map_result(seed.code, seed.reason, space, seed)
    # @decision DVM_MAP_ROOT
    if space.pml4 == 0u64 or space.pml4 == 1u64:
        return _vmm_device_map_result(-14, "blocked:address-space-invalid", space, seed)
    if hint_page == 0u64:
        val picked = _vmm_device_pick_range(space, seed.map_len)
        if picked == 0u64:
            return _vmm_device_map_result(-12, "blocked:no-virtual-range", space, seed)
        seed = vmm_device_plan_window(physical_addr, byte_len, 0u64, picked)
    # @decision DVM_MAP_VMA
    if not _vmm_device_range_available(space, seed.map_start, seed.map_len):
        return _vmm_device_map_result(-17, "blocked:vma-overlap", space, seed)
    val as_handle = AddressSpace(phys_root: space.pml4, id: space.id)
    var offset: u64 = 0u64
    while offset < seed.map_len:
        if vmm_read_pte_in(as_handle, VirtAddr(addr: seed.map_start + offset)) != 0u64:
            return _vmm_device_map_result(-17, "blocked:pte-collision", space, seed)
        offset = offset + VMM_DEVICE_PAGE_SIZE
    val area = VmArea(start: seed.map_start, len: seed.map_len,
        kind: VMA_DEVICE, flags: VMA_READ | VMA_WRITE,
        backing: seed.physical_page, backing_offset: 0u64)
    var updated = space
    val add_code = vma_add(updated, area)
    if add_code != 0:
        return _vmm_device_map_result(add_code, "blocked:vma-reserve-failed", space, seed)
    val flags = VmFlags(bits: VM_PRESENT | VM_WRITABLE | VM_USER |
        VM_CACHE_DISABLE | VM_NO_EXECUTE)
    offset = 0u64
    while offset < seed.map_len:
        val mapped = vmm_map_page_in(as_handle,
            VirtAddr(addr: seed.map_start + offset),
            PhysAddr(addr: seed.physical_page + offset), flags)
        if not mapped:
            var rollback: u64 = 0u64
            var rollback_ok = true
            var removed_offsets: [u64] = []
            var removed_ptes: [u64] = []
            while rollback < offset and rollback_ok:
                val rollback_virt = VirtAddr(addr: seed.map_start + rollback)
                val rollback_pte = vmm_read_pte_in(as_handle, rollback_virt)
                if not vmm_unmap_page_in(as_handle, rollback_virt):
                    rollback_ok = false
                else:
                    removed_offsets.push(rollback)
                    removed_ptes.push(rollback_pte)
                rollback = rollback + VMM_DEVICE_PAGE_SIZE
            if not rollback_ok:
                # Restore every leaf detached before the first failure. The
                # retained VMA is then narrowed to the fully mapped prefix, so
                # strict cleanup has exact, non-fragmented provenance.
                var restore_index: i64 = 0
                var restore_ok = true
                while restore_index < removed_offsets.len():
                    if not vmm_replace_pte_in(as_handle,
                            VirtAddr(addr: seed.map_start +
                                removed_offsets[restore_index]),
                            0u64, removed_ptes[restore_index]):
                        restore_ok = false
                    restore_index = restore_index + 1
                if not restore_ok:
                    return _vmm_device_map_result(-5,
                        "blocked:map-rollback-restore-failed", updated, seed)
                updated = vma_remove(updated, seed.map_start, seed.map_len)
                val retained_area = VmArea(start: seed.map_start, len: offset,
                    kind: VMA_DEVICE, flags: VMA_READ | VMA_WRITE,
                    backing: seed.physical_page, backing_offset: 0u64)
                if vma_add(updated, retained_area) != 0:
                    return _vmm_device_map_result(-5,
                        "blocked:map-rollback-metadata-failed", updated, seed)
                var retained = seed
                retained.map_len = offset
                return _vmm_device_map_result(-5,
                    "blocked:map-rollback-retained-prefix", updated, retained)
            updated = vma_remove(updated, seed.map_start, seed.map_len)
            return _vmm_device_map_result(-12, "blocked:page-map-failed", updated, seed)
        offset = offset + VMM_DEVICE_PAGE_SIZE
    _vmm_device_map_result(0, "ok:device-window-mapped", updated, seed)

fn vmm_unmap_device_result(space: ProcessVmSpace, map_start: u64,
        map_len: u64, physical_page: u64) -> VmmDeviceUnmapResult:
    # @decision DVM_UNMAP_EXACT
    var match_count: i64 = 0
    var index: i64 = 0
    while index.to_u64() < space.vma_count and index < space.areas.len():
        val area = space.areas[index]
        if area.start == map_start and area.len == map_len and
                area.kind == VMA_DEVICE and area.backing == physical_page and
                area.backing_offset == 0u64:
            match_count = match_count + 1
        index = index + 1
    if match_count != 1 or map_len == 0u64 or
            (map_start % VMM_DEVICE_PAGE_SIZE) != 0u64 or
            (map_len % VMM_DEVICE_PAGE_SIZE) != 0u64:
        return VmmDeviceUnmapResult(code: -22,
            reason: "blocked:device-extent-mismatch", space: space)
    val extent = vmm_device_plan_window(physical_page, map_len,
        map_start, map_start)
    if not extent.ok or extent.page_delta != 0u64 or
            extent.physical_page != physical_page or
            extent.map_start != map_start or extent.map_len != map_len:
        return VmmDeviceUnmapResult(code: -22,
            reason: "blocked:device-extent-invalid", space: space)
    val as_handle = AddressSpace(phys_root: space.pml4, id: space.id)
    var old_ptes: [u64] = []
    var offset: u64 = 0u64
    while offset < map_len:
        val old_pte = vmm_read_pte_in(as_handle, VirtAddr(addr: map_start + offset))
        if (old_pte & PTE_PRESENT) == 0u64:
            return VmmDeviceUnmapResult(code: -14,
                reason: "blocked:device-pte-missing", space: space)
        val required = PTE_PRESENT | PTE_WRITABLE | PTE_USER |
            PTE_CACHE_DISABLE | PTE_NO_EXECUTE
        if (old_pte & PTE_ADDR_MASK) != physical_page + offset or
                (old_pte & required) != required or
                (old_pte & PTE_WRITE_THROUGH) != 0u64:
            return VmmDeviceUnmapResult(code: -14,
                reason: "blocked:device-pte-provenance-mismatch", space: space)
        old_ptes.push(old_pte)
        offset = offset + VMM_DEVICE_PAGE_SIZE
    offset = 0u64
    while offset < map_len:
        if not vmm_unmap_page_in(as_handle, VirtAddr(addr: map_start + offset)):
            var rollback: u64 = 0u64
            var rollback_index: i64 = 0
            var rollback_ok = true
            while rollback < offset:
                if not vmm_replace_pte_in(as_handle,
                        VirtAddr(addr: map_start + rollback), 0u64,
                        old_ptes[rollback_index]):
                    rollback_ok = false
                rollback = rollback + VMM_DEVICE_PAGE_SIZE
                rollback_index = rollback_index + 1
            return VmmDeviceUnmapResult(code: if rollback_ok: -14 else: -5,
                reason: if rollback_ok: "blocked:device-unmap-failed" else:
                    "blocked:device-unmap-rollback-failed", space: space)
        offset = offset + VMM_DEVICE_PAGE_SIZE
    val updated = vma_remove(space, map_start, map_len)
    VmmDeviceUnmapResult(code: 0, reason: "ok:device-window-unmapped", space: updated)

export VmmDeviceMapResult, VmmDeviceUnmapResult, vmm_map_device_result,
    vmm_unmap_device_result
