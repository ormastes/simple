# Writable shared file mappings — shared page-cache object model.
#
# This module owns the identity that `vmm_handle_file_fault` never had: a
# mapping from (backing handle, file page index) to ONE page of content that
# every address space mapping that file page observes. Without it, each file
# fault allocated a private frame and writes could not propagate, which is why
# `mmap(MAP_SHARED | PROT_WRITE)` failed closed with EOPNOTSUPP.
#
# Layering (deliberate):
#   * This file is PURE data — no HHDM, no MMIO, no page tables, no new
#     `extern fn`. It is the authoritative model and is fully unit-testable in
#     userspace.
#   * `vmm_vma.spl` realises the model in hardware: it materialises a physical
#     frame per shared page and maps that same frame into every address space,
#     taking one `pmm_ref_page` per mapping.
#
# Capability rule: a shared mapping NEVER widens rights beyond the backing
# handle's. Deny wins, and an unregistered handle is unmappable.
#
# Write-back policy: stores land in the shared page cache immediately (visible
# to every shared mapping at once). The backing FILE IMAGE is updated only on
# `vmm_shared_msync` or when a page's map refcount falls to zero. Reading the
# file before msync legitimately observes the pre-write bytes. This is an
# explicit msync-required policy, not an accident.
#
# Implementation note: state is held in flat module-level parallel arrays rather
# than nested structs. Mutating through two or more field hops silently loses
# the write on the interpreter, so every mutation here is a single indexed
# store, and every array-of-array element update is extract / mutate /
# write-back (arrays are value types in Simple).

use os.kernel.memory.vmm_core.{PAGE_SIZE}

# ============================================================================
# Rights / error constants
# ============================================================================

val SHM_RIGHT_READ:  u32 = 1    # matches VMA_READ
val SHM_RIGHT_WRITE: u32 = 2    # matches VMA_WRITE

val SHM_OK:          i32 = 0
val SHM_EACCES:      i32 = -13  # rights attenuation refused the request
val SHM_EFAULT:      i32 = -14  # address is not inside any live region
val SHM_EINVAL:      i32 = -22  # malformed request (zero length, bad align)
val SHM_EEXIST:      i32 = -17  # region overlaps a live region in same space
val SHM_EOPNOTSUPP:  i32 = -95  # backing handle not registered — fail closed

# ============================================================================
# Shared file objects — one row per backing handle
# ============================================================================

var _sh_handle:    [u64] = []
var _sh_rights:    [u32] = []
var _sh_image:     [[u8]] = []   # backing file image ("what read() sees")

# ============================================================================
# Shared pages — one row per (object index, file page index)
# ============================================================================

var _shp_obj:      [i64] = []    # index into _sh_*
var _shp_index:    [u64] = []    # page index within the file
var _shp_bytes:    [[u8]] = []   # page-cache contents, PAGE_SIZE long
var _shp_frame:    [u64] = []    # materialised physical frame, 0 = none
var _shp_frefs:    [i64] = []    # address spaces holding a PTE on _shp_frame
var _shp_maps:     [i64] = []    # number of live regions mapping this page
var _shp_dirty:    [bool] = []

# ============================================================================
# Regions — one row per live mapping
# ============================================================================

var _shr_space:    [u64] = []
var _shr_start:    [u64] = []
var _shr_len:      [u64] = []
var _shr_obj:      [i64] = []
var _shr_offset:   [u64] = []    # file byte offset of region start
var _shr_flags:    [u32] = []
var _shr_private:  [bool] = []
var _shr_snapshot: [[u8]] = []   # private (COW/snapshot) copy, empty if shared
var _shr_live:     [bool] = []

# ============================================================================
# Helpers
# ============================================================================

fn _shm_align_up(v: u64) -> u64:
    ((v + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE

fn _shm_find_object(handle: u64) -> i64:
    """Return the object row index for `handle`, or -1."""
    var i: i64 = 0
    val n = _sh_handle.len()
    while i < n:
        if _sh_handle[i as i32] == handle:
            return i
        i = i + 1
    -1

fn _shm_find_page(obj: i64, page_index: u64) -> i64:
    """Return the shared-page row index for (obj, page_index), or -1."""
    var i: i64 = 0
    val n = _shp_obj.len()
    while i < n:
        if _shp_obj[i as i32] == obj and _shp_index[i as i32] == page_index:
            return i
        i = i + 1
    -1

fn _shm_page_from_image(obj: i64, page_index: u64) -> [u8]:
    """Build a PAGE_SIZE page filled from the backing image, zero past EOF."""
    val image = _sh_image[obj as i32]
    val image_len = image.len()
    val base = page_index * PAGE_SIZE
    var page: [u8] = []
    var i: u64 = 0
    while i < PAGE_SIZE:
        val src = (base + i) as i64
        if src < image_len:
            page.push(image[src as i32])
        else:
            page.push(0 as u8)
        i = i + 1
    page

fn _shm_intern_page(obj: i64, page_index: u64) -> i64:
    """Find or create the shared page row for (obj, page_index)."""
    val existing = _shm_find_page(obj, page_index)
    if existing >= 0:
        return existing
    _shp_obj.push(obj)
    _shp_index.push(page_index)
    _shp_bytes.push(_shm_page_from_image(obj, page_index))
    _shp_frame.push(0)
    _shp_frefs.push(0)
    _shp_maps.push(0)
    _shp_dirty.push(false)
    _shp_obj.len() - 1

fn _shm_add_page_map(row: i64):
    """Take one map reference on a shared page row."""
    _shp_maps[row as i32] = _shp_maps[row as i32] + 1

fn _shm_drop_page_map(row: i64) -> i64:
    """Release one map reference on a shared page row; returns what remains."""
    val remaining = _shp_maps[row as i32] - 1
    _shp_maps[row as i32] = remaining
    remaining

fn _shm_append_page(dest: [u8], row: i64) -> [u8]:
    """Append a shared page's bytes to `dest` and return the extended array."""
    var out = dest
    val page = _shp_bytes[row as i32]
    var i: u64 = 0
    while i < PAGE_SIZE:
        out.push(page[i as i32])
        i = i + 1
    out

fn _shm_writeback_page(row: i64):
    """Copy one shared page back into its object's backing file image.

    Only bytes inside the current image length are written: a shared mapping
    never extends the file (POSIX requires ftruncate for that).
    """
    if not _shp_dirty[row as i32]:
        return
    val obj = _shp_obj[row as i32]
    var image = _sh_image[obj as i32]
    val image_len = image.len()
    val page = _shp_bytes[row as i32]
    val base = _shp_index[row as i32] * PAGE_SIZE
    var i: u64 = 0
    while i < PAGE_SIZE:
        val dst = (base + i) as i64
        if dst < image_len:
            image[dst as i32] = page[i as i32]
        i = i + 1
    _sh_image[obj as i32] = image
    _shp_dirty[row as i32] = false

fn _shm_drop_page_row(row: i64):
    """Remove a shared-page row by swapping the last row into its slot."""
    val last = _shp_obj.len() - 1
    if row != last:
        _shp_obj[row as i32]   = _shp_obj[last as i32]
        _shp_index[row as i32] = _shp_index[last as i32]
        _shp_bytes[row as i32] = _shp_bytes[last as i32]
        _shp_frame[row as i32] = _shp_frame[last as i32]
        _shp_frefs[row as i32] = _shp_frefs[last as i32]
        _shp_maps[row as i32]  = _shp_maps[last as i32]
        _shp_dirty[row as i32] = _shp_dirty[last as i32]
    _shp_obj.pop()
    _shp_index.pop()
    _shp_bytes.pop()
    _shp_frame.pop()
    _shp_frefs.pop()
    _shp_maps.pop()
    _shp_dirty.pop()

fn _shm_find_region(space_id: u64, vaddr: u64) -> i64:
    """Return the live region row containing `vaddr` in `space_id`, or -1."""
    var i: i64 = 0
    val n = _shr_space.len()
    while i < n:
        if _shr_live[i as i32] and _shr_space[i as i32] == space_id:
            val start = _shr_start[i as i32]
            if vaddr >= start and vaddr < start + _shr_len[i as i32]:
                return i
        i = i + 1
    -1

fn _shm_region_overlaps(space_id: u64, start: u64, end: u64) -> bool:
    var i: i64 = 0
    val n = _shr_space.len()
    while i < n:
        if _shr_live[i as i32] and _shr_space[i as i32] == space_id:
            val r_start = _shr_start[i as i32]
            val r_end = r_start + _shr_len[i as i32]
            if r_start < end and r_end > start:
                return true
        i = i + 1
    false

# ============================================================================
# Backing registration (the capability edge)
# ============================================================================

fn vmm_shared_reset():
    """Drop all shared objects, pages and regions. Test/bring-up helper."""
    _sh_handle = []
    _sh_rights = []
    _sh_image = []
    _shp_obj = []
    _shp_index = []
    _shp_bytes = []
    _shp_frame = []
    _shp_frefs = []
    _shp_maps = []
    _shp_dirty = []
    _shr_space = []
    _shr_start = []
    _shr_len = []
    _shr_obj = []
    _shr_offset = []
    _shr_flags = []
    _shr_private = []
    _shr_snapshot = []
    _shr_live = []

fn vmm_shared_register_backing(handle: u64, bytes: [u8], rights: u32) -> i32:
    """Register a backing handle with its file image and its granted rights.

    `rights` MUST be the rights of the file handle the caller already holds —
    this is the only place a shared mapping can obtain write authority, so a
    read-only descriptor must be registered with SHM_RIGHT_READ alone.
    Re-registering an existing handle replaces the image only when no page of
    it is currently mapped; otherwise it narrows rights and keeps the live
    page cache (rights can be attenuated, never widened).
    """
    if handle == 0:
        return SHM_EINVAL
    val existing = _shm_find_object(handle)
    if existing >= 0:
        # Deny-wins: never widen an already-registered handle's rights.
        _sh_rights[existing as i32] = _sh_rights[existing as i32] & rights
        if vmm_shared_object_mapped_pages(handle) == 0:
            _sh_image[existing as i32] = bytes
        return SHM_OK
    _sh_handle.push(handle)
    _sh_rights.push(rights)
    _sh_image.push(bytes)
    SHM_OK

fn vmm_shared_backing_registered(handle: u64) -> bool:
    _shm_find_object(handle) >= 0

fn vmm_shared_backing_rights(handle: u64) -> u32:
    """Rights granted to `handle`, or 0 (no rights at all) if unregistered."""
    val obj = _shm_find_object(handle)
    if obj < 0:
        return 0
    _sh_rights[obj as i32]

fn vmm_shared_file_bytes(handle: u64) -> [u8]:
    """The backing file image — what a normal `read()` of the file observes.

    Reflects shared stores only after `vmm_shared_msync` or after the last
    mapping of the affected page is torn down.
    """
    var empty: [u8] = []
    val obj = _shm_find_object(handle)
    if obj < 0:
        return empty
    _sh_image[obj as i32]

# ============================================================================
# Rights check
# ============================================================================

fn vmm_shared_rights_ok(handle: u64, requested_flags: u32) -> i32:
    """Fail-closed attenuation check for a would-be shared mapping.

    Returns SHM_OK, SHM_EOPNOTSUPP (handle not registered) or SHM_EACCES
    (request asks for authority the handle does not hold).
    """
    val obj = _shm_find_object(handle)
    if obj < 0:
        return SHM_EOPNOTSUPP
    val granted = _sh_rights[obj as i32]
    if (requested_flags & ~granted) != 0:
        return SHM_EACCES
    SHM_OK

# ============================================================================
# Map / unmap
# ============================================================================

fn _vmm_shared_map_common(
    space_id: u64,
    start: u64,
    len: u64,
    handle: u64,
    offset: u64,
    flags: u32,
    is_private: bool
) -> i32:
    if len == 0:
        return SHM_EINVAL
    if (start % PAGE_SIZE) != 0 or (offset % PAGE_SIZE) != 0:
        return SHM_EINVAL
    val obj = _shm_find_object(handle)
    if obj < 0:
        return SHM_EOPNOTSUPP
    val granted = _sh_rights[obj as i32]
    if (flags & ~granted) != 0:
        return SHM_EACCES
    val aligned_len = _shm_align_up(len)
    if _shm_region_overlaps(space_id, start, start + aligned_len):
        return SHM_EEXIST

    var snapshot: [u8] = []
    val first_page = offset / PAGE_SIZE
    val page_count = aligned_len / PAGE_SIZE
    var p: u64 = 0
    while p < page_count:
        val row = _shm_intern_page(obj, first_page + p)
        if is_private:
            # Snapshot-at-map: a private mapping gets its own copy and will
            # never observe later shared stores. POSIX leaves that visibility
            # unspecified; snapshotting is a conforming, predictable choice.
            snapshot = _shm_append_page(snapshot, row)
            # A private mapping holds no share of the shared page.
            if _shp_maps[row as i32] == 0:
                _shm_drop_page_row(row)
        else:
            # Must go through a call boundary: an in-loop
            # `arr[idx] = arr[idx] + 1` on a module-level array only lands on
            # the final iteration under the JIT (scalar-spill-in-loop), which
            # silently lost the map reference for every page but the last.
            _shm_add_page_map(row)
        p = p + 1

    _shr_space.push(space_id)
    _shr_start.push(start)
    _shr_len.push(aligned_len)
    _shr_obj.push(obj)
    _shr_offset.push(offset)
    _shr_flags.push(flags)
    _shr_private.push(is_private)
    _shr_snapshot.push(snapshot)
    _shr_live.push(true)
    SHM_OK

fn vmm_shared_map(space_id: u64, start: u64, len: u64, handle: u64, offset: u64, flags: u32) -> i32:
    """Create a MAP_SHARED file region. Fails closed on rights or registration."""
    _vmm_shared_map_common(space_id, start, len, handle, offset, flags, false)

fn vmm_shared_map_private(space_id: u64, start: u64, len: u64, handle: u64, offset: u64, flags: u32) -> i32:
    """Create a MAP_PRIVATE file region (snapshot; never observes shared stores).

    Write authority on a private region does NOT require write authority on the
    handle — private stores never reach the file. Read authority still does.
    """
    val obj = _shm_find_object(handle)
    if obj < 0:
        return SHM_EOPNOTSUPP
    val read_only_request = flags & ~SHM_RIGHT_WRITE
    if (read_only_request & ~_sh_rights[obj as i32]) != 0:
        return SHM_EACCES
    _vmm_shared_map_common(space_id, start, len, handle, offset, flags, true)

fn vmm_shared_unmap(space_id: u64, start: u64, len: u64) -> i32:
    """Tear down the region at `start` in `space_id`.

    Drops one map reference per covered shared page; when a page's reference
    count reaches zero it is written back into the backing file image and its
    row (including any materialised frame identity) is released. Unmapping a
    range with no live region is a no-op (POSIX permits it).
    """
    if len == 0:
        return SHM_EINVAL
    val row = _shm_find_region(space_id, start)
    if row < 0:
        return SHM_OK
    if not _shr_private[row as i32]:
        val obj = _shr_obj[row as i32]
        val first_page = _shr_offset[row as i32] / PAGE_SIZE
        val page_count = _shr_len[row as i32] / PAGE_SIZE
        var p: u64 = 0
        while p < page_count:
            val prow = _shm_find_page(obj, first_page + p)
            if prow >= 0:
                # Call boundary, same reason as `_shm_add_page_map`.
                val remaining = _shm_drop_page_map(prow)
                if remaining <= 0:
                    _shm_writeback_page(prow)
                    _shm_drop_page_row(prow)
            p = p + 1
    var empty: [u8] = []
    _shr_live[row as i32] = false
    _shr_snapshot[row as i32] = empty
    SHM_OK

fn vmm_shared_unmap_space(space_id: u64) -> i32:
    """Tear down every region owned by `space_id` — the process-exit edge."""
    var guard: i64 = 0
    var again = true
    while again and guard < 4096:
        again = false
        var i: i64 = 0
        val n = _shr_space.len()
        while i < n:
            if _shr_live[i as i32] and _shr_space[i as i32] == space_id:
                _ = vmm_shared_unmap(space_id, _shr_start[i as i32], _shr_len[i as i32])
                again = true
                i = n
            else:
                i = i + 1
        guard = guard + 1
    SHM_OK

# ============================================================================
# Access through a mapping
# ============================================================================

fn vmm_shared_read_byte(space_id: u64, vaddr: u64) -> i64:
    """Read one byte through a live region. Returns 0..255, or a negative errno."""
    val row = _shm_find_region(space_id, vaddr)
    if row < 0:
        return SHM_EFAULT as i64
    if (_shr_flags[row as i32] & SHM_RIGHT_READ) == 0:
        return SHM_EACCES as i64
    val region_off = vaddr - _shr_start[row as i32]
    if _shr_private[row as i32]:
        val snap = _shr_snapshot[row as i32]
        if (region_off as i64) >= snap.len():
            return SHM_EFAULT as i64
        return snap[region_off as i32] as i64
    val file_off = _shr_offset[row as i32] + region_off
    val prow = _shm_find_page(_shr_obj[row as i32], file_off / PAGE_SIZE)
    if prow < 0:
        return SHM_EFAULT as i64
    val page = _shp_bytes[prow as i32]
    page[(file_off % PAGE_SIZE) as i32] as i64

fn vmm_shared_write_byte(space_id: u64, vaddr: u64, value: u8) -> i32:
    """Store one byte through a live region.

    A shared store is immediately visible to every other shared mapping of the
    same file page. It does NOT reach the backing file image until msync or
    last-unmap.
    """
    val row = _shm_find_region(space_id, vaddr)
    if row < 0:
        return SHM_EFAULT
    if (_shr_flags[row as i32] & SHM_RIGHT_WRITE) == 0:
        return SHM_EACCES
    val region_off = vaddr - _shr_start[row as i32]
    if _shr_private[row as i32]:
        var snap = _shr_snapshot[row as i32]
        if (region_off as i64) >= snap.len():
            return SHM_EFAULT
        snap[region_off as i32] = value
        _shr_snapshot[row as i32] = snap
        return SHM_OK
    val file_off = _shr_offset[row as i32] + region_off
    val prow = _shm_find_page(_shr_obj[row as i32], file_off / PAGE_SIZE)
    if prow < 0:
        return SHM_EFAULT
    var page = _shp_bytes[prow as i32]
    page[(file_off % PAGE_SIZE) as i32] = value
    _shp_bytes[prow as i32] = page
    _shp_dirty[prow as i32] = true
    SHM_OK

# ============================================================================
# msync / write-back
# ============================================================================

fn vmm_shared_msync(handle: u64) -> i32:
    """Flush every dirty shared page of `handle` into the backing file image."""
    val obj = _shm_find_object(handle)
    if obj < 0:
        return SHM_EOPNOTSUPP
    var i: i64 = 0
    val n = _shp_obj.len()
    while i < n:
        if _shp_obj[i as i32] == obj:
            _shm_writeback_page(i)
        i = i + 1
    SHM_OK

# ============================================================================
# Introspection — used by vmm_vma.spl and by specs
# ============================================================================

fn vmm_shared_page_map_count(handle: u64, page_index: u64) -> i64:
    """Live shared mappings of one file page, or 0 when the page is not resident."""
    val obj = _shm_find_object(handle)
    if obj < 0:
        return 0
    val row = _shm_find_page(obj, page_index)
    if row < 0:
        return 0
    _shp_maps[row as i32]

fn vmm_shared_page_resident(handle: u64, page_index: u64) -> bool:
    val obj = _shm_find_object(handle)
    if obj < 0:
        return false
    _shm_find_page(obj, page_index) >= 0

fn vmm_shared_page_dirty(handle: u64, page_index: u64) -> bool:
    val obj = _shm_find_object(handle)
    if obj < 0:
        return false
    val row = _shm_find_page(obj, page_index)
    if row < 0:
        return false
    _shp_dirty[row as i32]

fn vmm_shared_object_mapped_pages(handle: u64) -> i64:
    """Number of shared pages of `handle` that still have at least one mapping."""
    val obj = _shm_find_object(handle)
    if obj < 0:
        return 0
    var count: i64 = 0
    var i: i64 = 0
    val n = _shp_obj.len()
    while i < n:
        if _shp_obj[i as i32] == obj and _shp_maps[i as i32] > 0:
            count = count + 1
        i = i + 1
    count

fn vmm_shared_live_region_count() -> i64:
    var count: i64 = 0
    var i: i64 = 0
    val n = _shr_live.len()
    while i < n:
        if _shr_live[i as i32]:
            count = count + 1
        i = i + 1
    count

fn vmm_shared_region_is_shared(space_id: u64, vaddr: u64) -> bool:
    """True when `vaddr` lies in a live MAP_SHARED region of `space_id`."""
    val row = _shm_find_region(space_id, vaddr)
    if row < 0:
        return false
    not _shr_private[row as i32]

# ============================================================================
# Frame identity — the hardware realisation hook used by vmm_vma.spl
# ============================================================================

fn vmm_shared_page_frame(handle: u64, page_index: u64) -> u64:
    """Physical frame currently backing a shared page, or 0 if not materialised."""
    val obj = _shm_find_object(handle)
    if obj < 0:
        return 0
    val row = _shm_find_page(obj, page_index)
    if row < 0:
        return 0
    _shp_frame[row as i32]

fn vmm_shared_frame_ref(handle: u64, page_index: u64, frame: u64) -> i32:
    """Record the frame realising a shared page and take one residency ref.

    Called by the fault handler for EVERY address space that faults on the
    page — the first one supplies a freshly allocated frame, later ones supply
    the same frame they read back from `vmm_shared_page_frame`. A shared page
    has exactly one frame identity; supplying a different frame is EINVAL.

    The residency count tracks how many address spaces hold a PTE on the
    frame. It is deliberately NOT the same thing as the map count
    (`_shp_maps`): a region can be mapped without ever having faulted.
    """
    if frame == 0:
        return SHM_EINVAL
    val obj = _shm_find_object(handle)
    if obj < 0:
        return SHM_EOPNOTSUPP
    val row = _shm_find_page(obj, page_index)
    if row < 0:
        return SHM_EFAULT
    val current = _shp_frame[row as i32]
    if current != 0 and current != frame:
        return SHM_EINVAL
    _shp_frame[row as i32] = frame
    _shp_frefs[row as i32] = _shp_frefs[row as i32] + 1
    SHM_OK

fn vmm_shared_frame_unref(handle: u64, page_index: u64) -> i64:
    """Drop one address space's residency ref; returns the refs that remain.

    On the LAST drop the recorded frame identity is cleared, because the
    caller (`vmm_munmap_result`) is about to release the final `pmm_put_page`
    and the frame goes back to the allocator. Leaving a stale identity behind
    would let a later fault on a still-live mapping of the same page ref-and-map
    a freed frame — a use-after-free visible across address spaces. Clearing it
    forces the next fault to re-materialise from the page cache, which is the
    authority for the page's contents anyway.
    """
    val obj = _shm_find_object(handle)
    if obj < 0:
        return 0
    val row = _shm_find_page(obj, page_index)
    if row < 0:
        return 0
    var remaining = _shp_frefs[row as i32] - 1
    if remaining < 0:
        remaining = 0
    _shp_frefs[row as i32] = remaining
    if remaining == 0:
        _shp_frame[row as i32] = 0
    remaining

fn vmm_shared_page_frame_refs(handle: u64, page_index: u64) -> i64:
    """Address spaces currently holding a PTE on this shared page's frame."""
    val obj = _shm_find_object(handle)
    if obj < 0:
        return 0
    val row = _shm_find_page(obj, page_index)
    if row < 0:
        return 0
    _shp_frefs[row as i32]

fn vmm_shared_page_bytes(handle: u64, page_index: u64) -> [u8]:
    """Page-cache contents used to fill a freshly materialised frame."""
    var empty: [u8] = []
    val obj = _shm_find_object(handle)
    if obj < 0:
        return empty
    val row = _shm_find_page(obj, page_index)
    if row < 0:
        return empty
    _shp_bytes[row as i32]

fn vmm_shared_store_page_bytes(handle: u64, page_index: u64, bytes: [u8]) -> i32:
    """Write a frame's contents back into the page cache (frame -> cache flush)."""
    val obj = _shm_find_object(handle)
    if obj < 0:
        return SHM_EOPNOTSUPP
    val row = _shm_find_page(obj, page_index)
    if row < 0:
        return SHM_EFAULT
    if (bytes.len() as u64) != PAGE_SIZE:
        return SHM_EINVAL
    _shp_bytes[row as i32] = bytes
    _shp_dirty[row as i32] = true
    SHM_OK

fn vmm_shared_intern_page(handle: u64, page_index: u64) -> i32:
    """Ensure a shared page row exists (filling it from the file image)."""
    val obj = _shm_find_object(handle)
    if obj < 0:
        return SHM_EOPNOTSUPP
    _ = _shm_intern_page(obj, page_index)
    SHM_OK
