# The legacy backend may rewrite registry/.smf/FAT32 aliases after lookup.
# A pathname grant cannot authorize the different object it may return.
use os.kernel.security.execution_context.{KernelCallContext}

pub fn executable_boot_read_allows(caller: KernelCallContext) -> bool:
    """Only the explicit kernel-origin context may enter PID1 boot discovery."""
    caller.task_id.id == 0u64

pub fn executable_nonboot_read_unavailable(
    caller: KernelCallContext?, path: text
) -> Result<[u8], text>:
    """Fail closed until authorization and reads share a mounted-object binding.

    This is an explicitly unsupported interface, not a capability decision.
    Neither path grants nor an ambient full pouch establish the object behind
    the legacy backend's alias/cache resolution. Do not invoke it here.
    """
    val _caller = caller
    val _path = path
    Err("nonboot executable reads unavailable: resolved mounted-object binding required")
