use std.spec.{describe, it, expect}
use os.kernel.fs.fd_table_descriptor_owner_support_v1.FdTaskLifecycleKeyV1
use os.kernel.fs.active_fd_context_owner_v1.{
    ActiveFdOperationV1, active_fd_operation_requires_lease_v1,
    active_fd_context_begin_v1, active_fd_context_accepts_v1,
    active_fd_context_note_mutation_v1, active_fd_context_prepare_fork_v1,
    active_fd_context_reserve_cleanup_v1, active_fd_context_finish_cleanup_v1,
    active_fd_context_resume_cleanup_v1, active_fd_context_end_v1,
    active_fd_context_snapshot_v1
}

describe("active fd dispatch context owner"):
    it("requires one explicit lease for every descriptor operation class"):
        expect(active_fd_operation_requires_lease_v1(ActiveFdOperationV1.Descriptor)).to_equal(true)
        expect(active_fd_operation_requires_lease_v1(ActiveFdOperationV1.Open)).to_equal(true)
        expect(active_fd_operation_requires_lease_v1(ActiveFdOperationV1.Dup)).to_equal(true)
        expect(active_fd_operation_requires_lease_v1(ActiveFdOperationV1.Close)).to_equal(true)
        expect(active_fd_operation_requires_lease_v1(ActiveFdOperationV1.BackendClose)).to_equal(true)

    it("rejects stale copies after the context generation changes"):
        val key = FdTaskLifecycleKeyV1(task_id: 7101u64, lifecycle_generation: 31u64)
        val lease = active_fd_context_begin_v1(key).unwrap()
        expect(active_fd_context_accepts_v1(lease, ActiveFdOperationV1.Open)).to_equal(true)
        val advanced = active_fd_context_note_mutation_v1(lease).unwrap()
        expect(active_fd_context_accepts_v1(lease, ActiveFdOperationV1.Descriptor)).to_equal(false)
        expect(active_fd_context_accepts_v1(advanced, ActiveFdOperationV1.Descriptor)).to_equal(true)
        expect(active_fd_context_end_v1(advanced).is_ok()).to_equal(true)

    it("binds fork inheritance to a fresh child lifecycle"):
        val parent_key = FdTaskLifecycleKeyV1(task_id: 7102u64, lifecycle_generation: 32u64)
        val child_key = FdTaskLifecycleKeyV1(task_id: 7103u64, lifecycle_generation: 33u64)
        val parent = active_fd_context_begin_v1(parent_key).unwrap()
        expect(active_fd_context_prepare_fork_v1(parent, child_key).is_ok()).to_equal(true)
        expect(active_fd_context_prepare_fork_v1(parent, child_key).is_err()).to_equal(true)
        expect(active_fd_context_end_v1(parent).is_ok()).to_equal(true)
        val child = active_fd_context_begin_v1(child_key).unwrap()
        val snapshot = active_fd_context_snapshot_v1(child).unwrap()
        expect(snapshot.key.lifecycle_generation).to_equal(33u64)
        expect(active_fd_context_end_v1(child).is_ok()).to_equal(true)

    it("retains cleanup reservation across retryable backend failure"):
        val key = FdTaskLifecycleKeyV1(task_id: 7104u64, lifecycle_generation: 34u64)
        val lease = active_fd_context_begin_v1(key).unwrap()
        expect(active_fd_context_reserve_cleanup_v1(lease).is_ok()).to_equal(true)
        expect(active_fd_context_accepts_v1(lease, ActiveFdOperationV1.BackendClose)).to_equal(true)
        expect(active_fd_context_accepts_v1(lease, ActiveFdOperationV1.Open)).to_equal(false)
        expect(active_fd_context_finish_cleanup_v1(lease, false).unwrap()).to_equal(false)
        expect(active_fd_context_accepts_v1(lease, ActiveFdOperationV1.BackendClose)).to_equal(false)
        expect(active_fd_context_begin_v1(key).is_err()).to_equal(true)
        val retry = active_fd_context_resume_cleanup_v1(key).unwrap()
        expect(active_fd_context_accepts_v1(retry, ActiveFdOperationV1.BackendClose)).to_equal(true)
        expect(active_fd_context_accepts_v1(retry, ActiveFdOperationV1.Descriptor)).to_equal(false)
        expect(active_fd_context_accepts_v1(retry, ActiveFdOperationV1.Open)).to_equal(false)
        expect(active_fd_context_accepts_v1(retry, ActiveFdOperationV1.Dup)).to_equal(false)
        expect(active_fd_context_accepts_v1(retry, ActiveFdOperationV1.Close)).to_equal(false)
        expect(active_fd_context_finish_cleanup_v1(retry, true).unwrap()).to_equal(true)
        expect(active_fd_context_accepts_v1(retry, ActiveFdOperationV1.BackendClose)).to_equal(false)
