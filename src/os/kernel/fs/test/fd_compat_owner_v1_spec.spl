"""Package-scoped contract coverage for the canonical FD compatibility owner."""

use std.spec.*
use os.kernel.fs.fd_table_descriptor_owner_support_v1.FdTaskLifecycleKeyV1
use os.kernel.fs.fd_compat_owner_v1.{
    FD_COMPAT_STDIO_COUNT_V1, FD_COMPAT_DESCRIPTOR_CLOEXEC_V1,
    FD_COMPAT_TRANSACTION_LIMIT_V1,
    fd_compat_descriptor_flags_valid_v1, fd_compat_stdio_capacity_valid_v1,
    fd_compat_receipt_shape_valid_v1,
    fd_compat_boot_init_v1, fd_compat_bind_task_v1,
    fd_compat_descriptor_snapshot_v1, fd_compat_context_snapshot_v1,
    fd_compat_set_descriptor_flags_v1, fd_compat_set_status_v1,
    fd_compat_dup_v1, fd_compat_dup2_v1, fd_compat_prepare_fork_v1,
    fd_compat_prepare_exec_v1, fd_compat_prepare_exit_v1,
    fd_compat_commit_lifecycle_v1, fd_compat_rollback_lifecycle_v1
}

fn _compat_key(task_id: u64, lifecycle_generation: u64) -> FdTaskLifecycleKeyV1:
    FdTaskLifecycleKeyV1(
        task_id: task_id, lifecycle_generation: lifecycle_generation)

describe "canonical fd compatibility owner":
    it "shares exactly three boot stdio OFDs without per-task OFD growth":
        expect(fd_compat_boot_init_v1().is_ok()).to_be(true)
        expect(fd_compat_boot_init_v1().is_ok()).to_be(true)
        val first = _compat_key(9401u64, 201u64)
        val second = _compat_key(9402u64, 202u64)
        expect(fd_compat_bind_task_v1(first).unwrap()).to_equal(3u32)
        val first_refs_before =
            fd_compat_descriptor_snapshot_v1(first, 0).unwrap().ofd.ref_count
        expect(fd_compat_bind_task_v1(second).unwrap()).to_equal(3u32)
        expect(fd_compat_context_snapshot_v1(first).unwrap().descriptors.len()).to_equal(3)
        val first_refs = fd_compat_descriptor_snapshot_v1(first, 0).unwrap().ofd.ref_count
        val second_refs = fd_compat_descriptor_snapshot_v1(second, 0).unwrap().ofd.ref_count
        expect(first_refs).to_equal(first_refs_before + 1u32)
        expect(first_refs).to_equal(second_refs)
        expect(first_refs).to_be_greater_than(2u32)
        expect(fd_compat_commit_lifecycle_v1(
            fd_compat_prepare_exit_v1(first).unwrap()).unwrap().complete).to_be(true)
        expect(fd_compat_commit_lifecycle_v1(
            fd_compat_prepare_exit_v1(second).unwrap()).unwrap().complete).to_be(true)

    it "freezes the bounded flag and capacity contracts":
        expect(FD_COMPAT_TRANSACTION_LIMIT_V1).to_equal(64)
        expect(FD_COMPAT_STDIO_COUNT_V1).to_equal(3u32)
        expect(fd_compat_stdio_capacity_valid_v1(256u32, 3u32)).to_be(true)
        expect(fd_compat_descriptor_flags_valid_v1(0u32)).to_be(true)
        expect(fd_compat_descriptor_flags_valid_v1(
            FD_COMPAT_DESCRIPTOR_CLOEXEC_V1)).to_be(true)
        expect(fd_compat_descriptor_flags_valid_v1(2u32)).to_be(false)
        expect(fd_compat_receipt_shape_valid_v1(
            3u32, 2u32, false, "facade-unlock-failed")).to_be(true)
        expect(fd_compat_receipt_shape_valid_v1(
            3u32, 2u32, false, "")).to_be(false)
        val boot = _compat_key(0u64, 1u64)
        expect(fd_compat_context_snapshot_v1(boot).unwrap().descriptors.len()).to_equal(3)
        expect(fd_compat_set_descriptor_flags_v1(boot, 1, 1u32).is_err()).to_be(true)
        expect(fd_compat_prepare_exit_v1(boot).is_err()).to_be(true)

    it "reserves exec, blocks mutation, and closes only CLOEXEC aliases":
        val key = _compat_key(9403u64, 203u64)
        expect(fd_compat_bind_task_v1(key).unwrap()).to_equal(3u32)
        val duplicated = fd_compat_dup_v1(
            key, 1, 3, FD_COMPAT_DESCRIPTOR_CLOEXEC_V1).unwrap()
        expect(duplicated.descriptor).to_equal(3)
        expect(fd_compat_set_status_v1(key, 1, 2048u32).is_ok()).to_be(true)
        val exec = fd_compat_prepare_exec_v1(key).unwrap()
        expect(fd_compat_set_descriptor_flags_v1(key, 2, 1u32).is_err()).to_be(true)
        val receipt = fd_compat_commit_lifecycle_v1(exec).unwrap()
        expect(receipt.complete).to_be(true)
        expect(receipt.affected_count).to_equal(1u32)
        expect(receipt.close_begins.len()).to_equal(1)
        expect(fd_compat_descriptor_snapshot_v1(key, 3).is_err()).to_be(true)
        expect(fd_compat_descriptor_snapshot_v1(key, 2).is_ok()).to_be(true)
        expect(fd_compat_commit_lifecycle_v1(
            fd_compat_prepare_exit_v1(key).unwrap()).unwrap().complete).to_be(true)

    it "supports fork rollback, fork commit, and exact exit receipts":
        val parent = _compat_key(9404u64, 204u64)
        val rolled_child = _compat_key(9405u64, 205u64)
        val child = _compat_key(9406u64, 206u64)
        expect(fd_compat_bind_task_v1(parent).unwrap()).to_equal(3u32)
        val abandoned = fd_compat_prepare_fork_v1(parent, rolled_child).unwrap()
        expect(fd_compat_dup_v1(parent, 1, 3, 0u32).is_err()).to_be(true)
        expect(fd_compat_rollback_lifecycle_v1(abandoned).is_ok()).to_be(true)
        expect(fd_compat_context_snapshot_v1(rolled_child).is_err()).to_be(true)
        val forked = fd_compat_prepare_fork_v1(parent, child).unwrap()
        val fork_receipt = fd_compat_commit_lifecycle_v1(forked).unwrap()
        expect(fork_receipt.affected_count).to_equal(3u32)
        expect(fd_compat_context_snapshot_v1(child).unwrap().descriptors.len()).to_equal(3)
        val child_exit = fd_compat_commit_lifecycle_v1(
            fd_compat_prepare_exit_v1(child).unwrap()).unwrap()
        expect(child_exit.complete).to_be(true)
        expect(child_exit.affected_count).to_equal(3u32)
        expect(child_exit.close_begins.len()).to_equal(3)
        expect(fd_compat_context_snapshot_v1(child).is_err()).to_be(true)
        expect(fd_compat_commit_lifecycle_v1(
            fd_compat_prepare_exit_v1(parent).unwrap()).unwrap().complete).to_be(true)

    it "returns displaced close ownership from dup2":
        val key = _compat_key(9407u64, 207u64)
        expect(fd_compat_bind_task_v1(key).unwrap()).to_equal(3u32)
        expect(fd_compat_dup_v1(key, 1, 3, 0u32).unwrap().descriptor).to_equal(3)
        val replaced = fd_compat_dup2_v1(key, 2, 3, 0u32).unwrap()
        expect(replaced.descriptor).to_equal(3)
        expect(replaced.complete).to_be(true)
        expect(replaced.close_begins.len()).to_equal(1)
        expect(fd_compat_commit_lifecycle_v1(
            fd_compat_prepare_exit_v1(key).unwrap()).unwrap().complete).to_be(true)
