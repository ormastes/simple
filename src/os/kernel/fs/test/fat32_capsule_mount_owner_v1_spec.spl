use std.spec.{describe, it, expect, fail, pass_do_nothing}
use std.fs_driver.block_device.{BlockDevice}
use os.kernel.fs.block_device_identity_owner_v1.{
    BlockDeviceRegionBindingV1, block_device_identity_create_v1,
    block_device_identity_unmount_v1
}
use os.kernel.fs.block_backend_capsule_owner_v1.{
    block_backend_capsule_register_v1, block_backend_capsule_teardown_v1
}
use os.kernel.fs.fat32_capsule_mount_owner_v1.{
    Fat32CapsuleMountErrorV1, fat32_capsule_mount_publish_v1,
    fat32_capsule_mount_acquire_v1, fat32_capsule_mount_read_v1,
    fat32_capsule_mount_release_v1, fat32_capsule_mount_snapshot_v1,
    fat32_capsule_mount_close_v1
}

fn zero_sector_v1() -> [u8]:
    var bytes: [u8] = []
    var i: i32 = 0
    while i < 512:
        bytes.push(0u8)
        i = i + 1
    bytes

fn minimal_fat32_sector_v1() -> [u8]:
    var bytes = zero_sector_v1()
    bytes[11] = 0u8
    bytes[12] = 2u8
    bytes[13] = 1u8
    bytes[14] = 32u8
    bytes[16] = 1u8
    # 70,000 sectors with a 600-sector FAT gives 69,368 data clusters
    # and 76,800 FAT32 entries: a production-shaped FAT32 geometry.
    bytes[32] = 0x70u8
    bytes[33] = 0x11u8
    bytes[34] = 0x01u8
    bytes[36] = 0x58u8
    bytes[37] = 0x02u8
    bytes[44] = 2u8
    bytes[66] = 0x29u8
    bytes[82] = 0x46u8
    bytes[83] = 0x41u8
    bytes[84] = 0x54u8
    bytes[85] = 0x33u8
    bytes[86] = 0x32u8
    bytes[87] = 0x20u8
    bytes[88] = 0x20u8
    bytes[89] = 0x20u8
    bytes[510] = 0x55u8
    bytes[511] = 0xAAu8
    bytes

class Fat32CapsuleTestDeviceV1:
    boot: [u8]

impl BlockDevice for Fat32CapsuleTestDeviceV1:
    fn read_sector(lba: u64) -> Result<[u8], text>:
        if lba == 0u64: Ok(self.boot)
        else: Ok(zero_sector_v1())
    fn write_sector(_lba: u64, data: [u8]) -> Result<bool, text>:
        Ok(data.len() == 512)
    fn sector_size() -> u32: 512u32
    fn flush() -> Result<bool, text>: Ok(true)

fn fat32_capsule_binding_v1(owner: u64) -> BlockDeviceRegionBindingV1:
    BlockDeviceRegionBindingV1(
        backend_kind: 0x46415432u32, backend_owner_id: owner,
        backend_generation: 1u64, base_lba: 0u64, sector_count: 70000u64)

describe "transactional FAT32 capsule mount owner":
    it "publishes one complete candidate and fences close behind operations":
        val binding = fat32_capsule_binding_v1(81001u64)
        val identity = block_device_identity_create_v1(binding).unwrap()
        val capsule = block_backend_capsule_register_v1(
            Fat32CapsuleTestDeviceV1(boot: minimal_fat32_sector_v1()),
            identity, binding).unwrap()
        val mount = fat32_capsule_mount_publish_v1(
            capsule.seal(), identity, binding, 81001u64).unwrap()
        val snapshot = fat32_capsule_mount_snapshot_v1()
        expect(snapshot.mounted).to_be(true)
        expect(snapshot.generation).to_equal(mount.generation())
        expect(snapshot.root_bytes).to_equal(512)
        expect(snapshot.recoverable_replace).to_be(false)
        val operation = fat32_capsule_mount_acquire_v1(mount).unwrap()
        match fat32_capsule_mount_close_v1(mount):
            Err(Fat32CapsuleMountErrorV1.Busy):
                pass_do_nothing("a live operation prevents publication withdrawal")
            _: fail("close crossed a live FAT32 operation")
        expect(fat32_capsule_mount_read_v1(operation, 0u64).unwrap()[510]).to_equal(0x55u8)
        fat32_capsule_mount_release_v1(operation).unwrap()
        val receipt = fat32_capsule_mount_close_v1(mount).unwrap()
        expect(receipt.retired_generation).to_equal(mount.generation())
        expect(receipt.operation_count).to_equal(1u64)
        expect(receipt.capsule_lease_released).to_be(true)
        expect(fat32_capsule_mount_snapshot_v1().mounted).to_be(false)
        block_backend_capsule_teardown_v1(capsule).unwrap()
        block_device_identity_unmount_v1(identity).unwrap()

    it "invalidates every copied operation receipt on owner-side release":
        val binding = fat32_capsule_binding_v1(81002u64)
        val identity = block_device_identity_create_v1(binding).unwrap()
        val capsule = block_backend_capsule_register_v1(
            Fat32CapsuleTestDeviceV1(boot: minimal_fat32_sector_v1()),
            identity, binding).unwrap()
        val mount = fat32_capsule_mount_publish_v1(
            capsule.seal(), identity, binding, 81002u64).unwrap()
        val operation = fat32_capsule_mount_acquire_v1(mount).unwrap()
        val copied = operation
        fat32_capsule_mount_release_v1(operation).unwrap()
        match fat32_capsule_mount_read_v1(copied, 0u64):
            Err(Fat32CapsuleMountErrorV1.StaleOperation):
                pass_do_nothing("the canonical slot invalidates receipt copies")
            _: fail("a copied operation dispatched after release")
        fat32_capsule_mount_close_v1(mount).unwrap()
        block_backend_capsule_teardown_v1(capsule).unwrap()
        block_device_identity_unmount_v1(identity).unwrap()

    it "leaves canonical publication empty after candidate rejection":
        val binding = fat32_capsule_binding_v1(81003u64)
        val identity = block_device_identity_create_v1(binding).unwrap()
        val capsule = block_backend_capsule_register_v1(
            Fat32CapsuleTestDeviceV1(boot: zero_sector_v1()),
            identity, binding).unwrap()
        match fat32_capsule_mount_publish_v1(
            capsule.seal(), identity, binding, 81003u64):
            Err(Fat32CapsuleMountErrorV1.InvalidGeometry):
                pass_do_nothing("invalid BPB candidate never reaches publication")
            _: fail("invalid geometry mounted")
        expect(fat32_capsule_mount_snapshot_v1().mounted).to_be(false)
        block_backend_capsule_teardown_v1(capsule).unwrap()
        block_device_identity_unmount_v1(identity).unwrap()

    it "bounds operation admission and rejects a second publisher":
        val binding = fat32_capsule_binding_v1(81004u64)
        val identity = block_device_identity_create_v1(binding).unwrap()
        val capsule = block_backend_capsule_register_v1(
            Fat32CapsuleTestDeviceV1(boot: minimal_fat32_sector_v1()),
            identity, binding).unwrap()
        val mount = fat32_capsule_mount_publish_v1(
            capsule.seal(), identity, binding, 81004u64).unwrap()
        match fat32_capsule_mount_publish_v1(
            capsule.seal(), identity, binding, 81004u64):
            Err(Fat32CapsuleMountErrorV1.Busy):
                pass_do_nothing("the owner admits only one mount transaction")
            _: fail("a second publisher replaced the active tuple")
        var operations = []
        var i: i32 = 0
        while i < 64:
            operations.push(fat32_capsule_mount_acquire_v1(mount).unwrap())
            i = i + 1
        match fat32_capsule_mount_acquire_v1(mount):
            Err(Fat32CapsuleMountErrorV1.CapacityExhausted):
                pass_do_nothing("the operation table is bounded")
            _: fail("operation admission exceeded its fixed capacity")
        i = 0
        while i < operations.len():
            fat32_capsule_mount_release_v1(operations[i]).unwrap()
            i = i + 1
        fat32_capsule_mount_close_v1(mount).unwrap()
        block_backend_capsule_teardown_v1(capsule).unwrap()
        block_device_identity_unmount_v1(identity).unwrap()
