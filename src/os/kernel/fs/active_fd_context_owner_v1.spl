"""Dispatch-scoped authority for the legacy active descriptor context.

The owner deliberately serializes the complete dispatch scope.  A lease is an
opaque handle, not a copied descriptor table: fd/open/dup/close and backend
close adapters must present it before touching the compatibility fd table.
This module does not call that table, a syscall, or backend I/O.
"""

use std.thread_sffi.{
    mutex_raw_create, mutex_raw_lock, mutex_raw_unlock, thread_current_id
}
use os.kernel.fs.fd_table_descriptor_owner_support_v1.{
    FdTaskLifecycleKeyV1, fd_task_lifecycle_key_valid_v1
}

pub val ACTIVE_FD_CONTEXT_LIMIT_V1: i32 = 256
val _ACTIVE_FD_CONTEXT_GENERATION_MAX_V1: u64 = 0xffffffffffffffffu64

pub enum ActiveFdOperationV1:
    Descriptor
    Open
    Dup
    Close
    BackendClose

enum ActiveFdLeasePurposeV1:
    Dispatch
    CleanupRetry

pub struct ActiveFdContextLeaseV1:
    _slot: i32
    _slot_generation: u64
    _nonce: u64
    _key: FdTaskLifecycleKeyV1
    _context_generation: u64
    _owner_thread_id: i64
    _purpose: ActiveFdLeasePurposeV1

pub(package) struct ActiveFdForkReceiptV1:
    _slot: i32
    _slot_generation: u64
    _transaction_nonce: u64
    _parent_key: FdTaskLifecycleKeyV1
    _child_key: FdTaskLifecycleKeyV1

pub struct ActiveFdCleanupReceiptV1:
    _slot: i32
    _slot_generation: u64
    _transaction_nonce: u64
    _key: FdTaskLifecycleKeyV1
    _context_generation: u64

pub struct ActiveFdCleanupOutcomeV1:
    terminal: bool
    retry: ActiveFdCleanupReceiptV1?

pub struct ActiveFdCleanupResumeV1:
    lease: ActiveFdContextLeaseV1
    receipt: ActiveFdCleanupReceiptV1

pub struct ActiveFdContextSnapshotV1:
    key: FdTaskLifecycleKeyV1
    context_generation: u64
    cleanup_reserved: bool
    dispatch_active: bool

struct ActiveFdContextSlotV1:
    occupied: bool
    slot_generation: u64
    key: FdTaskLifecycleKeyV1
    context_generation: u64
    cleanup_reserved: bool
    active_nonce: u64
    fork_prepared: bool
    transaction_nonce: u64

struct ActiveFdContextOwnerV1:
    initialized: bool
    quarantined: bool
    next_nonce: u64
    active_slot: i32
    # Most syscall bursts repeatedly enter the same task context.  Retain only
    # a validated slot coordinate so that the common lookup does not rescan the
    # fixed 256-slot owner table on every descriptor operation.
    last_lookup_slot: i32
    slots: [ActiveFdContextSlotV1]

fn _active_fd_empty_key_v1() -> FdTaskLifecycleKeyV1:
    FdTaskLifecycleKeyV1(task_id: 0u64, lifecycle_generation: 0u64)

fn _active_fd_empty_slot_v1(generation: u64) -> ActiveFdContextSlotV1:
    ActiveFdContextSlotV1(
        occupied: false, slot_generation: generation,
        key: _active_fd_empty_key_v1(), context_generation: 1u64,
        cleanup_reserved: false, active_nonce: 0u64,
        fork_prepared: false, transaction_nonce: 0u64)

fn _active_fd_empty_slots_v1() -> [ActiveFdContextSlotV1]:
    val slots: [ActiveFdContextSlotV1] = []
    var i = 0
    while i < ACTIVE_FD_CONTEXT_LIMIT_V1:
        slots.push(_active_fd_empty_slot_v1(1u64))
        i = i + 1
    slots

val _active_fd_mutex_v1: i64 = mutex_raw_create()
var _active_fd_owner_v1 = ActiveFdContextOwnerV1(
    initialized: false, quarantined: false, next_nonce: 1u64,
    active_slot: -1, last_lookup_slot: -1, slots: [])

fn _active_fd_initialize_v1():
    if _active_fd_owner_v1.initialized: return
    _active_fd_owner_v1.slots = _active_fd_empty_slots_v1()
    _active_fd_owner_v1.initialized = true

fn _active_fd_find_key_v1(key: FdTaskLifecycleKeyV1) -> i32:
    val hinted = _active_fd_owner_v1.last_lookup_slot
    if hinted >= 0 and hinted < _active_fd_owner_v1.slots.len():
        val slot = _active_fd_owner_v1.slots[hinted]
        if (slot.occupied and slot.key.task_id == key.task_id and
            slot.key.lifecycle_generation == key.lifecycle_generation):
            return hinted
    var i = 0
    while i < _active_fd_owner_v1.slots.len():
        val slot = _active_fd_owner_v1.slots[i]
        if (slot.occupied and slot.key.task_id == key.task_id and
            slot.key.lifecycle_generation == key.lifecycle_generation):
            _active_fd_owner_v1.last_lookup_slot = i
            return i
        i = i + 1
    -1

fn _active_fd_issue_nonce_locked_v1() -> Result<u64, text>:
    if (_active_fd_owner_v1.next_nonce == 0u64 or
        _active_fd_owner_v1.next_nonce == _ACTIVE_FD_CONTEXT_GENERATION_MAX_V1):
        _active_fd_owner_v1.quarantined = true
        return Err("nonce-exhausted")
    val nonce = _active_fd_owner_v1.next_nonce
    _active_fd_owner_v1.next_nonce = nonce + 1u64
    Ok(nonce)

fn _active_fd_find_free_v1() -> i32:
    var i = 0
    while i < _active_fd_owner_v1.slots.len():
        if not _active_fd_owner_v1.slots[i].occupied: return i
        i = i + 1
    -1

fn _active_fd_lease_matches_v1(lease: ActiveFdContextLeaseV1) -> bool:
    if lease._owner_thread_id <= 0 or thread_current_id() != lease._owner_thread_id:
        return false
    if lease._slot < 0 or lease._slot >= _active_fd_owner_v1.slots.len():
        return false
    if _active_fd_owner_v1.active_slot != lease._slot: return false
    val slot = _active_fd_owner_v1.slots[lease._slot]
    (slot.occupied and slot.slot_generation == lease._slot_generation and
     slot.active_nonce != 0u64 and slot.active_nonce == lease._nonce and
     slot.context_generation == lease._context_generation and
     slot.key.task_id == lease._key.task_id and
     slot.key.lifecycle_generation == lease._key.lifecycle_generation)

pub fn active_fd_operation_requires_lease_v1(
    operation: ActiveFdOperationV1
) -> bool:
    match operation:
        case ActiveFdOperationV1.Descriptor: true
        case ActiveFdOperationV1.Open: true
        case ActiveFdOperationV1.Dup: true
        case ActiveFdOperationV1.Close: true
        case ActiveFdOperationV1.BackendClose: true

pub fn active_fd_context_begin_v1(
    key: FdTaskLifecycleKeyV1
) -> Result<ActiveFdContextLeaseV1, text>:
    if not fd_task_lifecycle_key_valid_v1(key): return Err("invalid-lifecycle")
    if _active_fd_mutex_v1 <= 0 or not mutex_raw_lock(_active_fd_mutex_v1):
        return Err("dispatch-lock-failed")
    if _active_fd_owner_v1.quarantined:
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err("owner-quarantined")
    _active_fd_initialize_v1()
    var index = _active_fd_find_key_v1(key)
    if index < 0:
        index = _active_fd_find_free_v1()
        if index < 0:
            _ = mutex_raw_unlock(_active_fd_mutex_v1)
            return Err("context-capacity")
        var fresh = _active_fd_owner_v1.slots[index]
        fresh.occupied = true
        fresh.key = key
        fresh.context_generation = 1u64
        fresh.cleanup_reserved = false
        fresh.active_nonce = 0u64
        fresh.fork_prepared = false
        fresh.transaction_nonce = 0u64
        _active_fd_owner_v1.slots[index] = fresh
        _active_fd_owner_v1.last_lookup_slot = index
    val current = _active_fd_owner_v1.slots[index]
    if current.cleanup_reserved:
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err("cleanup-reserved")
    if current.fork_prepared:
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err("fork-not-published")
    val nonce_result = _active_fd_issue_nonce_locked_v1()
    if nonce_result.is_err():
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err(nonce_result.unwrap_err())
    val nonce = nonce_result.unwrap()
    val owner_thread_id = thread_current_id()
    if owner_thread_id <= 0:
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err("thread-identity-unavailable")
    var slot = current
    slot.active_nonce = nonce
    _active_fd_owner_v1.slots[index] = slot
    _active_fd_owner_v1.active_slot = index
    Ok(ActiveFdContextLeaseV1(
        _slot: index, _slot_generation: slot.slot_generation, _nonce: nonce,
        _key: key, _context_generation: slot.context_generation,
        _owner_thread_id: owner_thread_id,
        _purpose: ActiveFdLeasePurposeV1.Dispatch))

pub(package) fn active_fd_context_accepts_v1(
    lease: ActiveFdContextLeaseV1, operation: ActiveFdOperationV1
) -> bool:
    if not active_fd_operation_requires_lease_v1(operation): return false
    if not _active_fd_lease_matches_v1(lease): return false
    if lease._purpose == ActiveFdLeasePurposeV1.CleanupRetry:
        return operation == ActiveFdOperationV1.BackendClose
    val slot = _active_fd_owner_v1.slots[lease._slot]
    if slot.cleanup_reserved:
        return operation == ActiveFdOperationV1.BackendClose
    true

pub fn active_fd_context_authorize_operation_v1(
    lease: ActiveFdContextLeaseV1, operation: ActiveFdOperationV1
) -> Result<ActiveFdContextLeaseV1, text>:
    """Consume one dispatch nonce and return the sole successor lease.

    Authorization and nonce rotation occur in one owner call while the dispatch
    mutex remains held.  Every copied predecessor becomes stale before the
    caller can perform the authorized operation.
    """
    if not active_fd_context_accepts_v1(lease, operation):
        return Err("operation-not-authorized")
    val nonce_result = _active_fd_issue_nonce_locked_v1()
    if nonce_result.is_err(): return Err(nonce_result.unwrap_err())
    val nonce = nonce_result.unwrap()
    var slot = _active_fd_owner_v1.slots[lease._slot]
    slot.active_nonce = nonce
    _active_fd_owner_v1.slots[lease._slot] = slot
    Ok(ActiveFdContextLeaseV1(
        _slot: lease._slot, _slot_generation: lease._slot_generation,
        _nonce: nonce, _key: lease._key,
        _context_generation: lease._context_generation,
        _owner_thread_id: lease._owner_thread_id,
        _purpose: lease._purpose))

pub(package) fn active_fd_context_note_mutation_v1(
    lease: ActiveFdContextLeaseV1
) -> Result<ActiveFdContextLeaseV1, text>:
    if not _active_fd_lease_matches_v1(lease): return Err("stale-lease")
    if lease._purpose != ActiveFdLeasePurposeV1.Dispatch:
        return Err("cleanup-retry-cannot-mutate")
    var slot = _active_fd_owner_v1.slots[lease._slot]
    if slot.context_generation == _ACTIVE_FD_CONTEXT_GENERATION_MAX_V1:
        _active_fd_owner_v1.quarantined = true
        return Err("context-generation-exhausted")
    slot.context_generation = slot.context_generation + 1u64
    _active_fd_owner_v1.slots[lease._slot] = slot
    Ok(ActiveFdContextLeaseV1(
        _slot: lease._slot, _slot_generation: lease._slot_generation,
        _nonce: lease._nonce, _key: lease._key,
        _context_generation: slot.context_generation,
        _owner_thread_id: lease._owner_thread_id,
        _purpose: lease._purpose))

pub(package) fn active_fd_context_prepare_fork_transaction_v1(
    parent: ActiveFdContextLeaseV1, child: FdTaskLifecycleKeyV1
) -> Result<ActiveFdForkReceiptV1, text>:
    if not _active_fd_lease_matches_v1(parent): return Err("stale-parent-lease")
    if parent._purpose != ActiveFdLeasePurposeV1.Dispatch:
        return Err("cleanup-retry-cannot-fork")
    if not fd_task_lifecycle_key_valid_v1(child): return Err("invalid-child-lifecycle")
    if child.task_id == parent._key.task_id: return Err("child-task-alias")
    if _active_fd_find_key_v1(child) >= 0: return Err("child-context-exists")
    val index = _active_fd_find_free_v1()
    if index < 0: return Err("context-capacity")
    val nonce_result = _active_fd_issue_nonce_locked_v1()
    if nonce_result.is_err(): return Err(nonce_result.unwrap_err())
    val nonce = nonce_result.unwrap()
    var slot = _active_fd_owner_v1.slots[index]
    slot.occupied = true
    slot.key = child
    slot.context_generation = parent._context_generation
    slot.cleanup_reserved = false
    slot.active_nonce = 0u64
    slot.fork_prepared = true
    slot.transaction_nonce = nonce
    _active_fd_owner_v1.slots[index] = slot
    Ok(ActiveFdForkReceiptV1(
        _slot: index, _slot_generation: slot.slot_generation,
        _transaction_nonce: nonce, _parent_key: parent._key,
        _child_key: child))

fn _active_fd_fork_receipt_matches_v1(receipt: ActiveFdForkReceiptV1) -> bool:
    if receipt._slot < 0 or receipt._slot >= _active_fd_owner_v1.slots.len():
        return false
    val slot = _active_fd_owner_v1.slots[receipt._slot]
    (slot.occupied and slot.fork_prepared and
     slot.slot_generation == receipt._slot_generation and
     slot.transaction_nonce != 0u64 and
     slot.transaction_nonce == receipt._transaction_nonce and
     slot.key.task_id == receipt._child_key.task_id and
     slot.key.lifecycle_generation == receipt._child_key.lifecycle_generation)

pub(package) fn active_fd_context_publish_fork_v1(
    parent: ActiveFdContextLeaseV1, receipt: ActiveFdForkReceiptV1
) -> Result<(), text>:
    if not _active_fd_lease_matches_v1(parent): return Err("stale-parent-lease")
    if (parent._key.task_id != receipt._parent_key.task_id or
        parent._key.lifecycle_generation != receipt._parent_key.lifecycle_generation):
        return Err("foreign-parent")
    if not _active_fd_fork_receipt_matches_v1(receipt): return Err("stale-fork-receipt")
    var slot = _active_fd_owner_v1.slots[receipt._slot]
    slot.fork_prepared = false
    slot.transaction_nonce = 0u64
    _active_fd_owner_v1.slots[receipt._slot] = slot
    Ok(())

pub(package) fn active_fd_context_abort_fork_v1(
    parent: ActiveFdContextLeaseV1, receipt: ActiveFdForkReceiptV1
) -> Result<(), text>:
    if not _active_fd_lease_matches_v1(parent): return Err("stale-parent-lease")
    if (parent._key.task_id != receipt._parent_key.task_id or
        parent._key.lifecycle_generation != receipt._parent_key.lifecycle_generation):
        return Err("foreign-parent")
    if not _active_fd_fork_receipt_matches_v1(receipt): return Err("stale-fork-receipt")
    val slot = _active_fd_owner_v1.slots[receipt._slot]
    if slot.slot_generation == _ACTIVE_FD_CONTEXT_GENERATION_MAX_V1:
        _active_fd_owner_v1.quarantined = true
        return Err("slot-generation-exhausted")
    _active_fd_owner_v1.slots[receipt._slot] =
        _active_fd_empty_slot_v1(slot.slot_generation + 1u64)
    Ok(())

pub fn active_fd_context_reserve_cleanup_receipt_v1(
    lease: ActiveFdContextLeaseV1
) -> Result<ActiveFdCleanupReceiptV1, text>:
    if not _active_fd_lease_matches_v1(lease): return Err("stale-lease")
    if lease._purpose != ActiveFdLeasePurposeV1.Dispatch:
        return Err("cleanup-retry-already-reserved")
    var slot = _active_fd_owner_v1.slots[lease._slot]
    if slot.cleanup_reserved: return Err("cleanup-already-reserved")
    val nonce_result = _active_fd_issue_nonce_locked_v1()
    if nonce_result.is_err(): return Err(nonce_result.unwrap_err())
    val nonce = nonce_result.unwrap()
    slot.cleanup_reserved = true
    slot.transaction_nonce = nonce
    _active_fd_owner_v1.slots[lease._slot] = slot
    Ok(ActiveFdCleanupReceiptV1(
        _slot: lease._slot, _slot_generation: lease._slot_generation,
        _transaction_nonce: nonce, _key: lease._key,
        _context_generation: lease._context_generation))

fn _active_fd_cleanup_receipt_matches_v1(
    lease: ActiveFdContextLeaseV1, receipt: ActiveFdCleanupReceiptV1
) -> bool:
    if not _active_fd_lease_matches_v1(lease): return false
    if lease._slot != receipt._slot: return false
    val slot = _active_fd_owner_v1.slots[receipt._slot]
    (slot.cleanup_reserved and
     slot.slot_generation == receipt._slot_generation and
     slot.transaction_nonce != 0u64 and
     slot.transaction_nonce == receipt._transaction_nonce and
     slot.context_generation == receipt._context_generation and
     slot.key.task_id == receipt._key.task_id and
     slot.key.lifecycle_generation == receipt._key.lifecycle_generation)

pub fn active_fd_context_finish_cleanup_receipt_v1(
    lease: ActiveFdContextLeaseV1,
    receipt: ActiveFdCleanupReceiptV1,
    backend_close_complete: bool
) -> Result<ActiveFdCleanupOutcomeV1, text>:
    """Consume a cleanup receipt, retaining only an opaque retry receipt.

    A failure rotates the transaction nonce before unlocking, so neither the
    dispatch lease nor any copy of the submitted receipt can be replayed.
    """
    if not _active_fd_cleanup_receipt_matches_v1(lease, receipt):
        return Err("stale-cleanup-receipt")
    var slot = _active_fd_owner_v1.slots[lease._slot]
    if not backend_close_complete:
        val nonce_result = _active_fd_issue_nonce_locked_v1()
        if nonce_result.is_err():
            slot.active_nonce = 0u64
            _active_fd_owner_v1.slots[lease._slot] = slot
            _active_fd_owner_v1.active_slot = -1
            _ = mutex_raw_unlock(_active_fd_mutex_v1)
            return Err(nonce_result.unwrap_err())
        val retry_nonce = nonce_result.unwrap()
        slot.transaction_nonce = retry_nonce
        slot.active_nonce = 0u64
        _active_fd_owner_v1.slots[lease._slot] = slot
        _active_fd_owner_v1.active_slot = -1
        val retry = ActiveFdCleanupReceiptV1(
            _slot: lease._slot, _slot_generation: lease._slot_generation,
            _transaction_nonce: retry_nonce, _key: lease._key,
            _context_generation: lease._context_generation)
        if not mutex_raw_unlock(_active_fd_mutex_v1):
            _active_fd_owner_v1.quarantined = true
            return Err("dispatch-unlock-failed")
        return Ok(ActiveFdCleanupOutcomeV1(terminal: false, retry: Some(retry)))
    if slot.slot_generation == _ACTIVE_FD_CONTEXT_GENERATION_MAX_V1:
        _active_fd_owner_v1.quarantined = true
        slot.active_nonce = 0u64
        _active_fd_owner_v1.slots[lease._slot] = slot
        _active_fd_owner_v1.active_slot = -1
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err("slot-generation-exhausted")
    _active_fd_owner_v1.slots[lease._slot] =
        _active_fd_empty_slot_v1(slot.slot_generation + 1u64)
    _active_fd_owner_v1.active_slot = -1
    if not mutex_raw_unlock(_active_fd_mutex_v1):
        _active_fd_owner_v1.quarantined = true
        return Err("dispatch-unlock-failed")
    Ok(ActiveFdCleanupOutcomeV1(terminal: true, retry: nil))

pub fn active_fd_context_resume_cleanup_receipt_v1(
    receipt: ActiveFdCleanupReceiptV1
) -> Result<ActiveFdCleanupResumeV1, text>:
    """Resume cleanup only by consuming the owner-issued retry coordinate."""
    if _active_fd_mutex_v1 <= 0 or not mutex_raw_lock(_active_fd_mutex_v1):
        return Err("dispatch-lock-failed")
    if _active_fd_owner_v1.quarantined:
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err("owner-quarantined")
    _active_fd_initialize_v1()
    if receipt._slot < 0 or receipt._slot >= _active_fd_owner_v1.slots.len():
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err("stale-cleanup-receipt")
    val slot = _active_fd_owner_v1.slots[receipt._slot]
    if (not slot.occupied or not slot.cleanup_reserved or
        slot.slot_generation != receipt._slot_generation or
        slot.transaction_nonce == 0u64 or
        slot.transaction_nonce != receipt._transaction_nonce or
        slot.context_generation != receipt._context_generation or
        slot.key.task_id != receipt._key.task_id or
        slot.key.lifecycle_generation != receipt._key.lifecycle_generation):
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err("stale-cleanup-receipt")
    val owner_thread_id = thread_current_id()
    if owner_thread_id <= 0:
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err("thread-identity-unavailable")
    val nonce_result = _active_fd_issue_nonce_locked_v1()
    if nonce_result.is_err():
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err(nonce_result.unwrap_err())
    val nonce = nonce_result.unwrap()
    var active = slot
    # Rotate the retained transaction coordinate immediately.  The submitted
    # retry receipt cannot be used to acquire a second cleanup lease.
    val transaction_result = _active_fd_issue_nonce_locked_v1()
    if transaction_result.is_err():
        _ = mutex_raw_unlock(_active_fd_mutex_v1)
        return Err(transaction_result.unwrap_err())
    active.transaction_nonce = transaction_result.unwrap()
    active.active_nonce = nonce
    _active_fd_owner_v1.slots[receipt._slot] = active
    _active_fd_owner_v1.active_slot = receipt._slot
    val lease = ActiveFdContextLeaseV1(
        _slot: receipt._slot, _slot_generation: receipt._slot_generation,
        _nonce: nonce, _key: receipt._key,
        _context_generation: receipt._context_generation,
        _owner_thread_id: owner_thread_id,
        _purpose: ActiveFdLeasePurposeV1.CleanupRetry)
    val successor = ActiveFdCleanupReceiptV1(
        _slot: receipt._slot, _slot_generation: receipt._slot_generation,
        _transaction_nonce: active.transaction_nonce, _key: receipt._key,
        _context_generation: receipt._context_generation)
    Ok(ActiveFdCleanupResumeV1(lease: lease, receipt: successor))

pub fn active_fd_context_end_v1(
    lease: ActiveFdContextLeaseV1
) -> Result<(), text>:
    if not _active_fd_lease_matches_v1(lease): return Err("stale-lease")
    var slot = _active_fd_owner_v1.slots[lease._slot]
    if slot.cleanup_reserved:
        # Fail closed without stranding the mutex.  Reservation remains, so a
        # later cleanup-only lease can retry the backend close.
        slot.active_nonce = 0u64
        _active_fd_owner_v1.slots[lease._slot] = slot
        _active_fd_owner_v1.active_slot = -1
        if not mutex_raw_unlock(_active_fd_mutex_v1):
            _active_fd_owner_v1.quarantined = true
            return Err("dispatch-unlock-failed")
        return Err("cleanup-finish-required")
    slot.active_nonce = 0u64
    _active_fd_owner_v1.slots[lease._slot] = slot
    _active_fd_owner_v1.active_slot = -1
    if not mutex_raw_unlock(_active_fd_mutex_v1):
        _active_fd_owner_v1.quarantined = true
        return Err("dispatch-unlock-failed")
    Ok(())

pub(package) fn active_fd_context_snapshot_v1(
    lease: ActiveFdContextLeaseV1
) -> Result<ActiveFdContextSnapshotV1, text>:
    if not _active_fd_lease_matches_v1(lease): return Err("stale-lease")
    val slot = _active_fd_owner_v1.slots[lease._slot]
    Ok(ActiveFdContextSnapshotV1(
        key: slot.key, context_generation: slot.context_generation,
        cleanup_reserved: slot.cleanup_reserved,
        dispatch_active: slot.active_nonce != 0u64))

export ACTIVE_FD_CONTEXT_LIMIT_V1, ActiveFdOperationV1
export ActiveFdContextLeaseV1, ActiveFdCleanupReceiptV1
export ActiveFdCleanupOutcomeV1, ActiveFdCleanupResumeV1
export ActiveFdContextSnapshotV1
