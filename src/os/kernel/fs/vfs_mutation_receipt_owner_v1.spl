"""Bounded two-phase owner for VFS mutation grants and receipts.

This capsule is deliberately not connected to syscall or filesystem drivers.
Package code may reserve one exact intent, resolve an fd alias to its OFD, and
claim one dispatch ticket.  Only a matching backend acknowledgement can turn
that ticket into a receipt.  A dispatched operation with unknown outcome is
retired, never retried.  Nothing here attributes output to Clang or LLD.
"""

use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}
use std.common.contracts.execution.simpleos_vfs_mutation_v1.{
    VfsMutationKindV1, TaskExecutionInstanceV1, VfsObjectIdentityV1,
    VfsOpenFileDescriptionIdentityV1, VfsMutationIntentV1,
    VfsMutationBackendAckV1, vfs_object_identity_equal_v1,
    vfs_mutation_intent_valid_v1,
    vfs_mutation_ack_matches_v1, vfs_mutation_intent_equal_v1,
    vfs_mutation_alias_actor_may_use_v1
}

pub val SIMPLEOS_VFS_MUTATION_SLOT_LIMIT_V1: i32 = 128

pub enum VfsMutationSlotStateV1:
    Free
    Reserved
    Dispatched
    ReceiptReady
    Retired

pub(package) struct VfsMutationGrantV1:
    _slot: i32
    _generation: u32
    _nonce: u64

pub(package) struct VfsMutationDispatchV1:
    _grant: VfsMutationGrantV1
    _intent: VfsMutationIntentV1

pub struct VfsMutationReceiptV1:
    receipt_id: u64
    grant_generation: u32
    grant_nonce: u64
    intent: VfsMutationIntentV1
    ack: VfsMutationBackendAckV1

pub struct VfsMutationOwnerStatusV1:
    free_count: i32
    reserved_count: i32
    dispatched_count: i32
    receipt_count: i32
    retired_count: i32
    quarantined: bool

struct VfsMutationSlotV1:
    state: VfsMutationSlotStateV1
    generation: u32
    nonce: u64
    receipt_id: u64
    intent: VfsMutationIntentV1
    ack: VfsMutationBackendAckV1

struct VfsMutationOwnerStateV1:
    initialized: bool
    quarantined: bool
    next_nonce: u64
    next_receipt_id: u64
    slots: [VfsMutationSlotV1]
    free_slots: [i32]

fn _vfs_mutation_empty_task_v1() -> TaskExecutionInstanceV1:
    TaskExecutionInstanceV1(
        task_id: 0u64, lifecycle_generation: 0u64, exec_generation: 0u64)

fn _vfs_mutation_empty_object_v1() -> VfsObjectIdentityV1:
    VfsObjectIdentityV1(
        filesystem_instance_id: 0u64, mount_id: 0u64,
        mount_generation: 0u64, object_id: 0u64, object_generation: 0u64)

fn _vfs_mutation_empty_ofd_v1() -> VfsOpenFileDescriptionIdentityV1:
    VfsOpenFileDescriptionIdentityV1(slot: 0u32, generation: 0u32)

fn _vfs_mutation_empty_intent_v1() -> VfsMutationIntentV1:
    VfsMutationIntentV1(
        kind: VfsMutationKindV1.Close,
        actor: _vfs_mutation_empty_task_v1(),
        ofd: _vfs_mutation_empty_ofd_v1(),
        subject: _vfs_mutation_empty_object_v1(),
        container: _vfs_mutation_empty_object_v1(),
        peer_container: _vfs_mutation_empty_object_v1(),
        replaced_subject: _vfs_mutation_empty_object_v1(),
        byte_offset: 0u64, byte_length: 0u64,
        subject_sequence_before: 0u64, container_sequence_before: 0u64,
        peer_container_sequence_before: 0u64,
        replaced_subject_sequence_before: 0u64,
        old_name_sha256: "", new_name_sha256: "")

fn _vfs_mutation_empty_ack_v1() -> VfsMutationBackendAckV1:
    VfsMutationBackendAckV1(
        resolved_intent: _vfs_mutation_empty_intent_v1(),
        subject_sequence_after: 0u64, container_sequence_after: 0u64,
        peer_container_sequence_after: 0u64,
        replaced_subject_sequence_after: 0u64, committed_byte_count: 0u64,
        durable: false, backend_closed: false)

fn _vfs_mutation_empty_slot_v1(generation: u32) -> VfsMutationSlotV1:
    VfsMutationSlotV1(
        state: VfsMutationSlotStateV1.Free, generation: generation,
        nonce: 0u64, receipt_id: 0u64,
        intent: _vfs_mutation_empty_intent_v1(),
        ack: _vfs_mutation_empty_ack_v1())

fn _vfs_mutation_slots_v1() -> [VfsMutationSlotV1]:
    var slots: [VfsMutationSlotV1] = []
    var i = 0
    while i < SIMPLEOS_VFS_MUTATION_SLOT_LIMIT_V1:
        slots.push(_vfs_mutation_empty_slot_v1(1u32))
        i = i + 1
    slots

fn _vfs_mutation_free_slots_v1() -> [i32]:
    var free_slots: [i32] = []
    var i = SIMPLEOS_VFS_MUTATION_SLOT_LIMIT_V1 - 1
    while i >= 0:
        free_slots.push(i)
        i = i - 1
    free_slots

val _vfs_mutation_mutex_v1 = mutex_raw_create()
var _vfs_mutation_owner_v1 = VfsMutationOwnerStateV1(
    initialized: false, quarantined: false,
    next_nonce: 0x5646534d55544131u64, next_receipt_id: 0u64,
    slots: [], free_slots: [])

fn _vfs_mutation_initialize_locked_v1():
    if not _vfs_mutation_owner_v1.initialized:
        _vfs_mutation_owner_v1.slots = _vfs_mutation_slots_v1()
        _vfs_mutation_owner_v1.free_slots = _vfs_mutation_free_slots_v1()
        _vfs_mutation_owner_v1.initialized = true

fn _vfs_mutation_lock_v1() -> bool:
    if _vfs_mutation_mutex_v1 <= 0 or
        not mutex_raw_lock(_vfs_mutation_mutex_v1):
        return false
    _vfs_mutation_initialize_locked_v1()
    if _vfs_mutation_owner_v1.quarantined:
        _ = mutex_raw_unlock(_vfs_mutation_mutex_v1)
        return false
    true

fn _vfs_mutation_unlock_v1() -> bool:
    if mutex_raw_unlock(_vfs_mutation_mutex_v1): return true
    # Supported providers return false only while ownership remains held.  The
    # preceding transition is committed-unknown, so fail-stop the whole owner.
    _vfs_mutation_owner_v1.quarantined = true
    false

fn _vfs_mutation_next_nonce_locked_v1() -> u64:
    if _vfs_mutation_owner_v1.next_nonce == 0xffffffffffffffffu64:
        return 0u64
    _vfs_mutation_owner_v1.next_nonce =
        _vfs_mutation_owner_v1.next_nonce + 1u64
    _vfs_mutation_owner_v1.next_nonce

fn _vfs_mutation_next_receipt_locked_v1() -> u64:
    if _vfs_mutation_owner_v1.next_receipt_id == 0xffffffffffffffffu64:
        return 0u64
    _vfs_mutation_owner_v1.next_receipt_id =
        _vfs_mutation_owner_v1.next_receipt_id + 1u64
    _vfs_mutation_owner_v1.next_receipt_id

fn _vfs_mutation_grant_index_locked_v1(
    grant: VfsMutationGrantV1, required: VfsMutationSlotStateV1
) -> i32:
    if grant._slot < 0 or grant._slot >= SIMPLEOS_VFS_MUTATION_SLOT_LIMIT_V1 or
        grant._generation == 0u32 or grant._nonce == 0u64:
        return -1
    val slot = _vfs_mutation_owner_v1.slots[grant._slot]
    if slot.state != required or slot.generation != grant._generation or
        slot.nonce != grant._nonce:
        return -1
    grant._slot

fn _vfs_mutation_nonzero_object_v1(value: VfsObjectIdentityV1) -> bool:
    value.object_id != 0u64

fn _vfs_mutation_object_overlaps_intent_v1(
    object: VfsObjectIdentityV1, intent: VfsMutationIntentV1
) -> bool:
    _vfs_mutation_nonzero_object_v1(object) and
        (vfs_object_identity_equal_v1(object, intent.subject) or
         (_vfs_mutation_nonzero_object_v1(intent.container) and
            vfs_object_identity_equal_v1(object, intent.container)) or
         (_vfs_mutation_nonzero_object_v1(intent.peer_container) and
            vfs_object_identity_equal_v1(object, intent.peer_container)) or
         (_vfs_mutation_nonzero_object_v1(intent.replaced_subject) and
            vfs_object_identity_equal_v1(object, intent.replaced_subject)))

fn _vfs_mutation_intents_overlap_v1(
    left: VfsMutationIntentV1, right: VfsMutationIntentV1
) -> bool:
    _vfs_mutation_object_overlaps_intent_v1(left.subject, right) or
        _vfs_mutation_object_overlaps_intent_v1(left.container, right) or
        _vfs_mutation_object_overlaps_intent_v1(left.peer_container, right) or
        _vfs_mutation_object_overlaps_intent_v1(left.replaced_subject, right)

fn _vfs_mutation_intent_available_locked_v1(intent: VfsMutationIntentV1) -> bool:
    # The fixed 128-slot scan is a strict constant upper bound. It serializes
    # all affected namespace/object identities, including indeterminate slots.
    for slot in _vfs_mutation_owner_v1.slots:
        if slot.state != VfsMutationSlotStateV1.Free and
            _vfs_mutation_intents_overlap_v1(intent, slot.intent):
            return false
    true

fn _vfs_mutation_release_locked_v1(index: i32) -> bool:
    val slot = _vfs_mutation_owner_v1.slots[index]
    if slot.generation == 0xffffffffu32:
        _vfs_mutation_owner_v1.slots[index] = _vfs_mutation_empty_slot_v1(
            slot.generation)
        _vfs_mutation_owner_v1.slots[index].state = VfsMutationSlotStateV1.Retired
        return true
    _vfs_mutation_owner_v1.slots[index] =
        _vfs_mutation_empty_slot_v1(slot.generation + 1u32)
    _vfs_mutation_owner_v1.free_slots.push(index)
    true

pub(package) fn vfs_mutation_reserve_v1(
    intent: VfsMutationIntentV1
) -> Result<VfsMutationGrantV1, text>:
    if not vfs_mutation_intent_valid_v1(intent): return Err("invalid-intent")
    if not _vfs_mutation_lock_v1(): return Err("serialization-unavailable")
    if not _vfs_mutation_intent_available_locked_v1(intent):
        _ = _vfs_mutation_unlock_v1()
        return Err("mutation-object-busy")
    if _vfs_mutation_owner_v1.free_slots.len() == 0:
        _ = _vfs_mutation_unlock_v1()
        return Err("mutation-capacity-exhausted")
    val nonce = _vfs_mutation_next_nonce_locked_v1()
    if nonce == 0u64:
        _vfs_mutation_owner_v1.quarantined = true
        _ = _vfs_mutation_unlock_v1()
        return Err("nonce-exhausted")
    val last = _vfs_mutation_owner_v1.free_slots.len() - 1
    val index = _vfs_mutation_owner_v1.free_slots[last]
    _vfs_mutation_owner_v1.free_slots.pop()
    val generation = _vfs_mutation_owner_v1.slots[index].generation
    _vfs_mutation_owner_v1.slots[index] = VfsMutationSlotV1(
        state: VfsMutationSlotStateV1.Reserved, generation: generation,
        nonce: nonce, receipt_id: 0u64, intent: intent,
        ack: _vfs_mutation_empty_ack_v1())
    val result = VfsMutationGrantV1(
        _slot: index, _generation: generation, _nonce: nonce)
    if not _vfs_mutation_unlock_v1(): return Err("committed-unknown")
    Ok(result)

pub(package) fn vfs_mutation_cancel_reserved_v1(
    grant: VfsMutationGrantV1
) -> Result<bool, text>:
    if not _vfs_mutation_lock_v1(): return Err("serialization-unavailable")
    val index = _vfs_mutation_grant_index_locked_v1(
        grant, VfsMutationSlotStateV1.Reserved)
    if index < 0:
        _ = _vfs_mutation_unlock_v1()
        return Err("stale-or-nonreserved-grant")
    _ = _vfs_mutation_release_locked_v1(index)
    if not _vfs_mutation_unlock_v1(): return Err("committed-unknown")
    Ok(true)

pub(package) fn vfs_mutation_claim_dispatch_v1(
    grant: VfsMutationGrantV1,
    caller: TaskExecutionInstanceV1,
    resolved_intent: VfsMutationIntentV1
) -> Result<VfsMutationDispatchV1, text>:
    if not _vfs_mutation_lock_v1(): return Err("serialization-unavailable")
    val index = _vfs_mutation_grant_index_locked_v1(
        grant, VfsMutationSlotStateV1.Reserved)
    if index < 0:
        _ = _vfs_mutation_unlock_v1()
        return Err("stale-or-nonreserved-grant")
    val intent = _vfs_mutation_owner_v1.slots[index].intent
    if not vfs_mutation_alias_actor_may_use_v1(
        intent.actor, intent.ofd, caller, resolved_intent.ofd) or
        not vfs_mutation_intent_equal_v1(intent, resolved_intent):
        _ = _vfs_mutation_unlock_v1()
        return Err("dispatch-identity-mismatch")
    _vfs_mutation_owner_v1.slots[index].state =
        VfsMutationSlotStateV1.Dispatched
    val result = VfsMutationDispatchV1(_grant: grant, _intent: intent)
    if not _vfs_mutation_unlock_v1(): return Err("committed-unknown")
    Ok(result)

pub(package) fn vfs_mutation_commit_backend_ack_v1(
    dispatch: VfsMutationDispatchV1,
    ack: VfsMutationBackendAckV1
) -> Result<VfsMutationGrantV1, text>:
    if not _vfs_mutation_lock_v1(): return Err("serialization-unavailable")
    val index = _vfs_mutation_grant_index_locked_v1(
        dispatch._grant, VfsMutationSlotStateV1.Dispatched)
    if index < 0:
        _ = _vfs_mutation_unlock_v1()
        return Err("stale-or-nondispatched-grant")
    val retained = _vfs_mutation_owner_v1.slots[index].intent
    if not vfs_mutation_intent_equal_v1(retained, dispatch._intent) or
        not vfs_mutation_ack_matches_v1(retained, ack):
        _ = _vfs_mutation_unlock_v1()
        return Err("ack-or-dispatch-mismatch")
    val receipt_id = _vfs_mutation_next_receipt_locked_v1()
    if receipt_id == 0u64:
        _vfs_mutation_owner_v1.slots[index].state =
            VfsMutationSlotStateV1.Retired
        _ = _vfs_mutation_unlock_v1()
        return Err("receipt-id-exhausted")
    _vfs_mutation_owner_v1.slots[index].ack = ack
    _vfs_mutation_owner_v1.slots[index].receipt_id = receipt_id
    _vfs_mutation_owner_v1.slots[index].state =
        VfsMutationSlotStateV1.ReceiptReady
    if not _vfs_mutation_unlock_v1(): return Err("committed-unknown")
    Ok(dispatch._grant)

pub(package) fn vfs_mutation_mark_indeterminate_v1(
    dispatch: VfsMutationDispatchV1
) -> Result<bool, text>:
    # Once handed to a backend, an absent acknowledgement is not a rollback.
    # Permanently retire the slot so neither authority nor receipt can replay.
    if not _vfs_mutation_lock_v1(): return Err("serialization-unavailable")
    val index = _vfs_mutation_grant_index_locked_v1(
        dispatch._grant, VfsMutationSlotStateV1.Dispatched)
    if index < 0:
        _ = _vfs_mutation_unlock_v1()
        return Err("stale-or-nondispatched-grant")
    _vfs_mutation_owner_v1.slots[index].state = VfsMutationSlotStateV1.Retired
    _vfs_mutation_owner_v1.slots[index].nonce = 0u64
    if not _vfs_mutation_unlock_v1(): return Err("committed-unknown")
    Ok(true)

pub(package) fn vfs_mutation_take_receipt_v1(
    handle: VfsMutationGrantV1
) -> Result<VfsMutationReceiptV1, text>:
    if not _vfs_mutation_lock_v1(): return Err("serialization-unavailable")
    val index = _vfs_mutation_grant_index_locked_v1(
        handle, VfsMutationSlotStateV1.ReceiptReady)
    if index < 0:
        _ = _vfs_mutation_unlock_v1()
        return Err("stale-or-unready-receipt")
    val slot = _vfs_mutation_owner_v1.slots[index]
    val result = VfsMutationReceiptV1(
        receipt_id: slot.receipt_id, grant_generation: slot.generation,
        grant_nonce: slot.nonce, intent: slot.intent, ack: slot.ack)
    _ = _vfs_mutation_release_locked_v1(index)
    if not _vfs_mutation_unlock_v1(): return Err("committed-unknown")
    Ok(result)

pub(package) fn vfs_mutation_owner_status_v1() -> Result<VfsMutationOwnerStatusV1, text>:
    if not _vfs_mutation_lock_v1(): return Err("serialization-unavailable")
    var free_count = 0
    var reserved_count = 0
    var dispatched_count = 0
    var receipt_count = 0
    var retired_count = 0
    for slot in _vfs_mutation_owner_v1.slots:
        match slot.state:
            case VfsMutationSlotStateV1.Free: free_count = free_count + 1
            case VfsMutationSlotStateV1.Reserved: reserved_count = reserved_count + 1
            case VfsMutationSlotStateV1.Dispatched: dispatched_count = dispatched_count + 1
            case VfsMutationSlotStateV1.ReceiptReady: receipt_count = receipt_count + 1
            case VfsMutationSlotStateV1.Retired: retired_count = retired_count + 1
    val result = VfsMutationOwnerStatusV1(
        free_count: free_count, reserved_count: reserved_count,
        dispatched_count: dispatched_count, receipt_count: receipt_count,
        retired_count: retired_count, quarantined: false)
    if not _vfs_mutation_unlock_v1(): return Err("committed-unknown")
    Ok(result)
