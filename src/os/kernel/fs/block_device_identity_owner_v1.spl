"""Bounded authenticated identity owner for filesystem block-device regions.

The owner is the sole issuer of device seals.  A seal is an observational
handle: it can validate one exact backend identity and sector region, but it
cannot manufacture or update canonical identity.  The registration carries a
single-use lifecycle nonce.  Although Simple values may be copied, the first
successful replace or unmount consumes that nonce in owner state, so every
copy is stale afterward and cannot close a replacement generation.

This module deliberately does not publish mounts and does not retain a
BlockDevice trait object.  A concrete device owner remains responsible for I/O
and supplies its stable nonzero owner/generation identity at registration.
"""

use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new, mutex_with_lock}

pub val BLOCK_DEVICE_IDENTITY_CAPACITY_V1: i32 = 64
pub val BLOCK_DEVICE_PIN_CAPACITY_V1: i32 = 128
val _BLOCK_DEVICE_IDENTITY_GENERATION_MAX_V1: u64 = 0xffffffffffffffffu64
val _BLOCK_DEVICE_IDENTITY_NONCE_MAX_V1: u64 = 0xffffffffffffffffu64

pub struct BlockDeviceRegionBindingV1:
    backend_kind: u32
    backend_owner_id: u64
    backend_generation: u64
    base_lba: u64
    sector_count: u64

pub struct BlockDeviceSealV1:
    _slot: i32
    _generation: u64
    _identity_nonce: u64

impl BlockDeviceSealV1:
    pub static fn invalid_probe() -> BlockDeviceSealV1:
        BlockDeviceSealV1(_slot: -1, _generation: 0u64, _identity_nonce: 0u64)

    pub fn generation() -> u64: self._generation
    pub fn owner_slot_index() -> i32: self._slot

pub struct BlockDeviceRegistrationV1:
    _seal: BlockDeviceSealV1
    _lifecycle_nonce: u64

impl BlockDeviceRegistrationV1:
    pub static fn invalid_probe() -> BlockDeviceRegistrationV1:
        BlockDeviceRegistrationV1(
            _seal: BlockDeviceSealV1.invalid_probe(), _lifecycle_nonce: 0u64)

    pub fn seal() -> BlockDeviceSealV1: self._seal

pub struct BlockDeviceUnmountReceiptV1:
    slot: i32
    retired_generation: u64

pub struct BlockDevicePinLeaseV1:
    _pin_slot: i32
    _pin_nonce: u64
    _device_slot: i32
    _device_generation: u64
    _identity_nonce: u64

impl BlockDevicePinLeaseV1:
    pub static fn invalid_probe() -> BlockDevicePinLeaseV1:
        BlockDevicePinLeaseV1(
            _pin_slot: -1, _pin_nonce: 0u64, _device_slot: -1,
            _device_generation: 0u64, _identity_nonce: 0u64)

    # Observational identity only.  The lease carries no replace/unmount
    # authority and its private nonce cannot be manufactured by a caller.
    pub fn device_generation() -> u64: self._device_generation
    pub fn device_slot_index() -> i32: self._device_slot

pub struct BlockDeviceUnpinReceiptV1:
    device_slot: i32
    device_generation: u64

pub enum BlockDeviceIdentityErrorV1:
    InvalidBinding
    InvalidIdentity
    CapacityExhausted
    CounterExhausted
    OwnerQuarantined
    RegionConflict
    StaleIdentity
    LifecycleAuthorityConsumed
    Busy
    PinCapacityExhausted
    UnpinIndeterminate

enum BlockDeviceIdentitySlotStateV1:
    Free
    Active
    Quarantined

struct BlockDeviceIdentitySlotV1:
    state: BlockDeviceIdentitySlotStateV1
    generation: u64
    identity_nonce: u64
    lifecycle_nonce: u64
    backend_pin_nonce: u64
    pin_count: i32
    binding: BlockDeviceRegionBindingV1

enum BlockDevicePinStateV1:
    Free
    Active
    Quarantined

struct BlockDevicePinSlotV1:
    state: BlockDevicePinStateV1
    generation: u64
    pin_nonce: u64
    device_slot: i32
    device_generation: u64
    identity_nonce: u64
    backend_owner_pin: bool

struct BlockDeviceIdentityOwnerStateV1:
    slots: [BlockDeviceIdentitySlotV1]
    pins: [BlockDevicePinSlotV1]
    next_nonce: u64
    live_count: i32
    quarantined_count: i32
    pin_quarantined_count: i32
    owner_quarantined: bool
    last_error: BlockDeviceIdentityErrorV1?
    last_registration: BlockDeviceRegistrationV1
    last_unmount_receipt: BlockDeviceUnmountReceiptV1
    last_pin_lease: BlockDevicePinLeaseV1
    last_unpin_receipt: BlockDeviceUnpinReceiptV1

fn _block_device_empty_binding_v1() -> BlockDeviceRegionBindingV1:
    BlockDeviceRegionBindingV1(
        backend_kind: 0u32, backend_owner_id: 0u64,
        backend_generation: 0u64, base_lba: 0u64, sector_count: 0u64)

fn _block_device_empty_slot_v1(generation: u64) -> BlockDeviceIdentitySlotV1:
    BlockDeviceIdentitySlotV1(
        state: BlockDeviceIdentitySlotStateV1.Free,
        generation: generation, identity_nonce: 0u64, lifecycle_nonce: 0u64,
        backend_pin_nonce: 0u64,
        pin_count: 0,
        binding: _block_device_empty_binding_v1())

fn _block_device_empty_pin_slot_v1(generation: u64) -> BlockDevicePinSlotV1:
    BlockDevicePinSlotV1(
        state: BlockDevicePinStateV1.Free, generation: generation,
        pin_nonce: 0u64, device_slot: -1, device_generation: 0u64,
        identity_nonce: 0u64, backend_owner_pin: false)

fn _block_device_identity_initial_state_v1() -> BlockDeviceIdentityOwnerStateV1:
    BlockDeviceIdentityOwnerStateV1(
        slots: [], pins: [], next_nonce: 1u64, live_count: 0, quarantined_count: 0,
        pin_quarantined_count: 0,
        owner_quarantined: false, last_error: nil,
        last_registration: BlockDeviceRegistrationV1.invalid_probe(),
        last_unmount_receipt: BlockDeviceUnmountReceiptV1(
            slot: -1, retired_generation: 0u64),
        last_pin_lease: BlockDevicePinLeaseV1.invalid_probe(),
        last_unpin_receipt: BlockDeviceUnpinReceiptV1(
            device_slot: -1, device_generation: 0u64))

var _block_device_identity_owner_v1: Mutex =
    mutex_new(_block_device_identity_initial_state_v1())

fn _block_device_binding_valid_v1(binding: BlockDeviceRegionBindingV1) -> bool:
    (binding.backend_kind != 0u32 and binding.backend_owner_id != 0u64 and
     binding.backend_generation != 0u64 and binding.sector_count != 0u64 and
     binding.base_lba <= _BLOCK_DEVICE_IDENTITY_GENERATION_MAX_V1 - binding.sector_count)

fn _block_device_binding_equal_v1(
    a: BlockDeviceRegionBindingV1, b: BlockDeviceRegionBindingV1
) -> bool:
    (a.backend_kind == b.backend_kind and
     a.backend_owner_id == b.backend_owner_id and
     a.backend_generation == b.backend_generation and
     a.base_lba == b.base_lba and a.sector_count == b.sector_count)

fn _block_device_regions_overlap_v1(
    a: BlockDeviceRegionBindingV1, b: BlockDeviceRegionBindingV1
) -> bool:
    if (a.backend_kind != b.backend_kind or
        a.backend_owner_id != b.backend_owner_id):
        return false
    # One backend owner has one live generation.  A caller may not evade the
    # replacement transition by creating a disjoint region under a newer
    # generation while old seals remain live.
    if a.backend_generation != b.backend_generation:
        return true
    val a_end = a.base_lba + a.sector_count
    val b_end = b.base_lba + b.sector_count
    a.base_lba < b_end and b.base_lba < a_end

fn _block_device_seal_shape_valid_v1(seal: BlockDeviceSealV1) -> bool:
    seal._slot >= 0 and seal._generation != 0u64 and seal._identity_nonce != 0u64

fn _block_device_registration_shape_valid_v1(
    registration: BlockDeviceRegistrationV1
) -> bool:
    (_block_device_seal_shape_valid_v1(registration._seal) and
     registration._lifecycle_nonce != 0u64)

fn _block_device_seal_matches_slot_v1(
    seal: BlockDeviceSealV1, slot: BlockDeviceIdentitySlotV1
) -> bool:
    (seal._generation == slot.generation and
     seal._identity_nonce == slot.identity_nonce)

fn _block_device_conflict_locked_v1(
    state: BlockDeviceIdentityOwnerStateV1,
    binding: BlockDeviceRegionBindingV1,
    ignored_slot: i32
) -> bool:
    var i: i32 = 0
    while i < state.slots.len():
        val slot = state.slots[i]
        if (i != ignored_slot and slot.state == BlockDeviceIdentitySlotStateV1.Active and
            _block_device_regions_overlap_v1(slot.binding, binding)):
            return true
        i = i + 1
    false

pub fn block_device_identity_create_v1(
    binding: BlockDeviceRegionBindingV1
) -> Result<BlockDeviceRegistrationV1, BlockDeviceIdentityErrorV1>:
    if not _block_device_binding_valid_v1(binding):
        return Err(BlockDeviceIdentityErrorV1.InvalidBinding)
    val updated = mutex_with_lock(_block_device_identity_owner_v1, \state:
        var next = state
        next.last_error = nil
        next.last_registration = BlockDeviceRegistrationV1.invalid_probe()
        if state.owner_quarantined:
            next.last_error = Some(BlockDeviceIdentityErrorV1.OwnerQuarantined)
        elif (state.next_nonce == 0u64 or
              state.next_nonce > _BLOCK_DEVICE_IDENTITY_NONCE_MAX_V1 - 2u64):
            next.owner_quarantined = true
            next.last_error = Some(BlockDeviceIdentityErrorV1.CounterExhausted)
        elif _block_device_conflict_locked_v1(state, binding, -1):
            next.last_error = Some(BlockDeviceIdentityErrorV1.RegionConflict)
        else:
            var slot_index: i32 = -1
            var i: i32 = 0
            while i < state.slots.len():
                if (slot_index < 0 and
                    state.slots[i].state == BlockDeviceIdentitySlotStateV1.Free):
                    slot_index = i
                i = i + 1
            if slot_index < 0 and state.slots.len() >= BLOCK_DEVICE_IDENTITY_CAPACITY_V1:
                next.last_error = Some(BlockDeviceIdentityErrorV1.CapacityExhausted)
            else:
                if slot_index < 0:
                    slot_index = state.slots.len()
                    next.slots.push(_block_device_empty_slot_v1(1u64))
                val generation = next.slots[slot_index].generation
                val identity_nonce = state.next_nonce
                val lifecycle_nonce = state.next_nonce + 1u64
                next.slots[slot_index] = BlockDeviceIdentitySlotV1(
                    state: BlockDeviceIdentitySlotStateV1.Active,
                    generation: generation, identity_nonce: identity_nonce,
                    lifecycle_nonce: lifecycle_nonce, pin_count: 0,
                    backend_pin_nonce: 0u64,
                    binding: binding)
                next.next_nonce = state.next_nonce + 2u64
                next.live_count = state.live_count + 1
                next.last_registration = BlockDeviceRegistrationV1(
                    _seal: BlockDeviceSealV1(
                        _slot: slot_index, _generation: generation,
                        _identity_nonce: identity_nonce),
                    _lifecycle_nonce: lifecycle_nonce)
        next)
    if val err = updated.last_error: return Err(err)
    Ok(updated.last_registration)

pub fn block_device_identity_validate_v1(
    seal: BlockDeviceSealV1,
    binding: BlockDeviceRegionBindingV1
) -> Result<bool, BlockDeviceIdentityErrorV1>:
    if (not _block_device_seal_shape_valid_v1(seal) or
        not _block_device_binding_valid_v1(binding)):
        return Err(BlockDeviceIdentityErrorV1.InvalidIdentity)
    val updated = mutex_with_lock(_block_device_identity_owner_v1, \state:
        var next = state
        next.last_error = nil
        if seal._slot >= state.slots.len():
            next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
        else:
            val slot = state.slots[seal._slot]
            if (slot.state != BlockDeviceIdentitySlotStateV1.Active or
                not _block_device_seal_matches_slot_v1(seal, slot)):
                next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
            elif not _block_device_binding_equal_v1(binding, slot.binding):
                next.last_error = Some(BlockDeviceIdentityErrorV1.InvalidBinding)
        next)
    if val err = updated.last_error: return Err(err)
    Ok(true)

pub fn block_device_identity_replace_v1(
    registration: BlockDeviceRegistrationV1,
    replacement: BlockDeviceRegionBindingV1
) -> Result<BlockDeviceRegistrationV1, BlockDeviceIdentityErrorV1>:
    if (not _block_device_registration_shape_valid_v1(registration) or
        not _block_device_binding_valid_v1(replacement)):
        return Err(BlockDeviceIdentityErrorV1.InvalidIdentity)
    val updated = mutex_with_lock(_block_device_identity_owner_v1, \state:
        var next = state
        next.last_error = nil
        next.last_registration = BlockDeviceRegistrationV1.invalid_probe()
        val slot_index = registration._seal._slot
        if state.owner_quarantined:
            next.last_error = Some(BlockDeviceIdentityErrorV1.OwnerQuarantined)
        elif slot_index >= state.slots.len():
            next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
        else:
            val slot = state.slots[slot_index]
            if slot.state != BlockDeviceIdentitySlotStateV1.Active:
                next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
            elif not _block_device_seal_matches_slot_v1(registration._seal, slot):
                next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
            elif registration._lifecycle_nonce != slot.lifecycle_nonce:
                next.last_error = Some(BlockDeviceIdentityErrorV1.LifecycleAuthorityConsumed)
            elif slot.pin_count != 0:
                next.last_error = Some(BlockDeviceIdentityErrorV1.Busy)
            elif slot.generation == _BLOCK_DEVICE_IDENTITY_GENERATION_MAX_V1:
                # Replacement is atomic: exhaustion refuses the transition
                # without invalidating the still-live current binding.
                next.last_error = Some(BlockDeviceIdentityErrorV1.CounterExhausted)
            elif state.next_nonce > _BLOCK_DEVICE_IDENTITY_NONCE_MAX_V1 - 2u64:
                next.owner_quarantined = true
                next.last_error = Some(BlockDeviceIdentityErrorV1.CounterExhausted)
            elif _block_device_conflict_locked_v1(state, replacement, slot_index):
                next.last_error = Some(BlockDeviceIdentityErrorV1.RegionConflict)
            else:
                val generation = slot.generation + 1u64
                val identity_nonce = state.next_nonce
                val lifecycle_nonce = state.next_nonce + 1u64
                next.slots[slot_index] = BlockDeviceIdentitySlotV1(
                    state: BlockDeviceIdentitySlotStateV1.Active,
                    generation: generation, identity_nonce: identity_nonce,
                    lifecycle_nonce: lifecycle_nonce, pin_count: 0,
                    backend_pin_nonce: 0u64,
                    binding: replacement)
                next.next_nonce = state.next_nonce + 2u64
                next.last_registration = BlockDeviceRegistrationV1(
                    _seal: BlockDeviceSealV1(
                        _slot: slot_index, _generation: generation,
                        _identity_nonce: identity_nonce),
                    _lifecycle_nonce: lifecycle_nonce)
        next)
    if val err = updated.last_error: return Err(err)
    Ok(updated.last_registration)

pub fn block_device_identity_unmount_v1(
    registration: BlockDeviceRegistrationV1
) -> Result<BlockDeviceUnmountReceiptV1, BlockDeviceIdentityErrorV1>:
    if not _block_device_registration_shape_valid_v1(registration):
        return Err(BlockDeviceIdentityErrorV1.InvalidIdentity)
    val updated = mutex_with_lock(_block_device_identity_owner_v1, \state:
        var next = state
        next.last_error = nil
        next.last_unmount_receipt = BlockDeviceUnmountReceiptV1(
            slot: -1, retired_generation: 0u64)
        val slot_index = registration._seal._slot
        if slot_index >= state.slots.len():
            next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
        else:
            val slot = state.slots[slot_index]
            if slot.state != BlockDeviceIdentitySlotStateV1.Active:
                next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
            elif not _block_device_seal_matches_slot_v1(registration._seal, slot):
                next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
            elif registration._lifecycle_nonce != slot.lifecycle_nonce:
                next.last_error = Some(BlockDeviceIdentityErrorV1.LifecycleAuthorityConsumed)
            elif slot.pin_count != 0:
                next.last_error = Some(BlockDeviceIdentityErrorV1.Busy)
            else:
                next.live_count = state.live_count - 1
                next.last_unmount_receipt = BlockDeviceUnmountReceiptV1(
                    slot: slot_index, retired_generation: slot.generation)
                if slot.generation == _BLOCK_DEVICE_IDENTITY_GENERATION_MAX_V1:
                    var quarantined = slot
                    quarantined.state = BlockDeviceIdentitySlotStateV1.Quarantined
                    quarantined.lifecycle_nonce = 0u64
                    next.slots[slot_index] = quarantined
                    next.quarantined_count = state.quarantined_count + 1
                else:
                    next.slots[slot_index] =
                        _block_device_empty_slot_v1(slot.generation + 1u64)
        next)
    if val err = updated.last_error: return Err(err)
    Ok(updated.last_unmount_receipt)

fn _block_device_pin_lease_shape_valid_v1(lease: BlockDevicePinLeaseV1) -> bool:
    (lease._pin_slot >= 0 and lease._pin_nonce != 0u64 and
     lease._device_slot >= 0 and lease._device_generation != 0u64 and
     lease._identity_nonce != 0u64)

fn _block_device_pin_matches_v1(
    lease: BlockDevicePinLeaseV1, pin: BlockDevicePinSlotV1
) -> bool:
    (lease._pin_nonce == pin.pin_nonce and
     lease._device_slot == pin.device_slot and
     lease._device_generation == pin.device_generation and
     lease._identity_nonce == pin.identity_nonce)

fn _block_device_identity_pin_kind_v1(
    registration: BlockDeviceRegistrationV1,
    binding: BlockDeviceRegionBindingV1,
    backend_owner_pin: bool
) -> Result<BlockDevicePinLeaseV1, BlockDeviceIdentityErrorV1>:
    if (not _block_device_registration_shape_valid_v1(registration) or
        not _block_device_binding_valid_v1(binding)):
        return Err(BlockDeviceIdentityErrorV1.InvalidIdentity)
    val updated = mutex_with_lock(_block_device_identity_owner_v1, \state:
        var next = state
        next.last_error = nil
        next.last_pin_lease = BlockDevicePinLeaseV1.invalid_probe()
        if state.owner_quarantined:
            next.last_error = Some(BlockDeviceIdentityErrorV1.OwnerQuarantined)
        elif registration._seal._slot >= state.slots.len():
            next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
        else:
            val seal = registration._seal
            val device = state.slots[seal._slot]
            if (device.state != BlockDeviceIdentitySlotStateV1.Active or
                not _block_device_seal_matches_slot_v1(seal, device)):
                next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
            elif registration._lifecycle_nonce != device.lifecycle_nonce:
                next.last_error = Some(BlockDeviceIdentityErrorV1.LifecycleAuthorityConsumed)
            elif not _block_device_binding_equal_v1(binding, device.binding):
                next.last_error = Some(BlockDeviceIdentityErrorV1.InvalidBinding)
            elif backend_owner_pin and device.backend_pin_nonce != 0u64:
                next.last_error = Some(BlockDeviceIdentityErrorV1.Busy)
            elif state.next_nonce == 0u64 or state.next_nonce == _BLOCK_DEVICE_IDENTITY_NONCE_MAX_V1:
                next.owner_quarantined = true
                next.last_error = Some(BlockDeviceIdentityErrorV1.CounterExhausted)
            else:
                var pin_slot: i32 = -1
                var i: i32 = 0
                while i < state.pins.len():
                    if pin_slot < 0 and state.pins[i].state == BlockDevicePinStateV1.Free:
                        pin_slot = i
                    i = i + 1
                if pin_slot < 0 and state.pins.len() >= BLOCK_DEVICE_PIN_CAPACITY_V1:
                    next.last_error = Some(BlockDeviceIdentityErrorV1.PinCapacityExhausted)
                else:
                    if pin_slot < 0:
                        pin_slot = state.pins.len()
                        next.pins.push(_block_device_empty_pin_slot_v1(1u64))
                    val pin_generation = next.pins[pin_slot].generation
                    val pin_nonce = state.next_nonce
                    next.pins[pin_slot] = BlockDevicePinSlotV1(
                        state: BlockDevicePinStateV1.Active,
                        generation: pin_generation, pin_nonce: pin_nonce,
                        device_slot: seal._slot, device_generation: seal._generation,
                        identity_nonce: seal._identity_nonce,
                        backend_owner_pin: backend_owner_pin)
                    var pinned_device = device
                    pinned_device.pin_count = device.pin_count + 1
                    if backend_owner_pin:
                        pinned_device.backend_pin_nonce = pin_nonce
                    next.slots[seal._slot] = pinned_device
                    next.next_nonce = state.next_nonce + 1u64
                    next.last_pin_lease = BlockDevicePinLeaseV1(
                        _pin_slot: pin_slot, _pin_nonce: pin_nonce,
                        _device_slot: seal._slot,
                        _device_generation: seal._generation,
                        _identity_nonce: seal._identity_nonce)
        next)
    if val err = updated.last_error: return Err(err)
    Ok(updated.last_pin_lease)

pub fn block_device_identity_pin_v1(
    registration: BlockDeviceRegistrationV1,
    binding: BlockDeviceRegionBindingV1
) -> Result<BlockDevicePinLeaseV1, BlockDeviceIdentityErrorV1>:
    _block_device_identity_pin_kind_v1(registration, binding, false)

# Exclusive long-lived pin for one controller-owned backend capsule.  While it
# exists, copied registration authority cannot bind a second backend object to
# the same device identity.
pub(package) fn block_device_identity_backend_pin_v1(
    registration: BlockDeviceRegistrationV1,
    binding: BlockDeviceRegionBindingV1
) -> Result<BlockDevicePinLeaseV1, BlockDeviceIdentityErrorV1>:
    _block_device_identity_pin_kind_v1(registration, binding, true)

fn _block_device_release_pin_locked_v1(
    state: BlockDeviceIdentityOwnerStateV1,
    lease: BlockDevicePinLeaseV1,
    require_quarantined: bool
) -> BlockDeviceIdentityOwnerStateV1:
    var next = state
    next.last_error = nil
    next.last_unpin_receipt = BlockDeviceUnpinReceiptV1(
        device_slot: -1, device_generation: 0u64)
    if lease._pin_slot >= state.pins.len():
        next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
        return next
    val pin = state.pins[lease._pin_slot]
    val expected_state = if require_quarantined:
        pin.state == BlockDevicePinStateV1.Quarantined
    else:
        pin.state == BlockDevicePinStateV1.Active
    if (not require_quarantined and
        pin.state == BlockDevicePinStateV1.Quarantined and
        _block_device_pin_matches_v1(lease, pin)):
        next.last_error = Some(BlockDeviceIdentityErrorV1.UnpinIndeterminate)
        return next
    if not expected_state or not _block_device_pin_matches_v1(lease, pin):
        next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
        return next
    if pin.device_slot < 0 or pin.device_slot >= state.slots.len():
        next.owner_quarantined = true
        next.last_error = Some(BlockDeviceIdentityErrorV1.OwnerQuarantined)
        return next
    val device = state.slots[pin.device_slot]
    if (device.state != BlockDeviceIdentitySlotStateV1.Active or
        device.generation != pin.device_generation or
        device.identity_nonce != pin.identity_nonce or device.pin_count <= 0):
        next.owner_quarantined = true
        next.last_error = Some(BlockDeviceIdentityErrorV1.OwnerQuarantined)
        return next
    var released_device = device
    released_device.pin_count = device.pin_count - 1
    if pin.backend_owner_pin:
        if device.backend_pin_nonce != pin.pin_nonce:
            next.owner_quarantined = true
            next.last_error = Some(BlockDeviceIdentityErrorV1.OwnerQuarantined)
            return next
        released_device.backend_pin_nonce = 0u64
    next.slots[pin.device_slot] = released_device
    if pin.generation == _BLOCK_DEVICE_IDENTITY_GENERATION_MAX_V1:
        var retired = pin
        retired.state = BlockDevicePinStateV1.Quarantined
        retired.pin_nonce = 0u64
        next.pins[lease._pin_slot] = retired
        next.pin_quarantined_count = state.pin_quarantined_count + 1
    else:
        next.pins[lease._pin_slot] = _block_device_empty_pin_slot_v1(pin.generation + 1u64)
    next.last_unpin_receipt = BlockDeviceUnpinReceiptV1(
        device_slot: pin.device_slot, device_generation: pin.device_generation)
    next

pub fn block_device_identity_unpin_v1(
    lease: BlockDevicePinLeaseV1
) -> Result<BlockDeviceUnpinReceiptV1, BlockDeviceIdentityErrorV1>:
    if not _block_device_pin_lease_shape_valid_v1(lease):
        return Err(BlockDeviceIdentityErrorV1.InvalidIdentity)
    val updated = mutex_with_lock(_block_device_identity_owner_v1, \state:
        _block_device_release_pin_locked_v1(state, lease, false))
    if val err = updated.last_error: return Err(err)
    Ok(updated.last_unpin_receipt)

# Record that the provider-side release outcome is unknown.  The pin remains
# counted and blocks replacement/unmount until the exact lease is retried.
pub fn block_device_identity_quarantine_unpin_v1(
    lease: BlockDevicePinLeaseV1
) -> Result<bool, BlockDeviceIdentityErrorV1>:
    if not _block_device_pin_lease_shape_valid_v1(lease):
        return Err(BlockDeviceIdentityErrorV1.InvalidIdentity)
    val updated = mutex_with_lock(_block_device_identity_owner_v1, \state:
        var next = state
        next.last_error = nil
        if lease._pin_slot >= state.pins.len():
            next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
        else:
            val pin = state.pins[lease._pin_slot]
            if (pin.state != BlockDevicePinStateV1.Active or
                not _block_device_pin_matches_v1(lease, pin)):
                next.last_error = Some(BlockDeviceIdentityErrorV1.StaleIdentity)
            else:
                var quarantined = pin
                quarantined.state = BlockDevicePinStateV1.Quarantined
                next.pins[lease._pin_slot] = quarantined
        next)
    if val err = updated.last_error: return Err(err)
    Ok(true)

pub fn block_device_identity_retry_unpin_v1(
    lease: BlockDevicePinLeaseV1
) -> Result<BlockDeviceUnpinReceiptV1, BlockDeviceIdentityErrorV1>:
    if not _block_device_pin_lease_shape_valid_v1(lease):
        return Err(BlockDeviceIdentityErrorV1.InvalidIdentity)
    val updated = mutex_with_lock(_block_device_identity_owner_v1, \state:
        _block_device_release_pin_locked_v1(state, lease, true))
    if val err = updated.last_error: return Err(err)
    Ok(updated.last_unpin_receipt)

pub fn block_device_identity_live_count_v1() -> i32:
    mutex_with_lock(_block_device_identity_owner_v1, \state: state).live_count

pub fn block_device_identity_quarantined_count_v1() -> i32:
    mutex_with_lock(_block_device_identity_owner_v1, \state: state).quarantined_count

pub fn block_device_pin_quarantined_count_v1() -> i32:
    mutex_with_lock(_block_device_identity_owner_v1, \state: state).pin_quarantined_count
