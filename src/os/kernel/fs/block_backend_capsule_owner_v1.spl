"""Bounded controller-owned block backend capsules.

The identity owner authenticates device/region identity; this owner binds the
corresponding concrete BlockDevice to one fixed heap-resident slot.  Global
metadata is held only while resolving a slot.  Sector I/O and flush execute
under that slot's mutex and never under the block identity mutex or registry
mutex, so unrelated controllers do not serialize their device calls.

An I/O lease owns both a capsule operation reservation and an exact
BlockDevicePinLeaseV1.  Release first fences the reservation under the slot
lock, then consumes the identity pin.  An indeterminate provider release leaves
the reservation quarantined and teardown remains fail-closed until exact retry.
"""

use std.fs_driver.block_device.{BlockDevice}
use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new, mutex_with_lock}
use os.kernel.fs.block_device_identity_owner_v1.{
    BlockDeviceRegionBindingV1, BlockDeviceRegistrationV1, BlockDevicePinLeaseV1,
    block_device_identity_pin_v1, block_device_identity_backend_pin_v1,
    block_device_identity_unpin_v1, block_device_identity_quarantine_unpin_v1,
    block_device_identity_retry_unpin_v1
}

pub val BLOCK_BACKEND_CAPSULE_CAPACITY_V1: i32 = 32
pub val BLOCK_BACKEND_LEASE_CAPACITY_V1: i32 = 64
val _BLOCK_BACKEND_COUNTER_MAX_V1: u64 = 0xffffffffffffffffu64

pub enum BlockBackendCapsuleErrorV1:
    InvalidIdentity
    IdentityRejected
    CapacityExhausted
    CounterExhausted
    StaleCapsule
    StaleLease
    RegionViolation
    Busy
    Closing
    BackendFailure
    ReleaseIndeterminate
    Quarantined

pub struct BlockBackendCapsuleSealV1:
    _slot: i32
    _generation: u64
    _nonce: u64

impl BlockBackendCapsuleSealV1:
    pub static fn invalid_probe() -> BlockBackendCapsuleSealV1:
        BlockBackendCapsuleSealV1(_slot: -1, _generation: 0u64, _nonce: 0u64)
    pub fn generation() -> u64: self._generation
    pub fn slot_index() -> i32: self._slot

pub struct BlockBackendCapsuleRegistrationV1:
    _seal: BlockBackendCapsuleSealV1
    _close_nonce: u64

impl BlockBackendCapsuleRegistrationV1:
    pub static fn invalid_probe() -> BlockBackendCapsuleRegistrationV1:
        BlockBackendCapsuleRegistrationV1(
            _seal: BlockBackendCapsuleSealV1.invalid_probe(), _close_nonce: 0u64)
    pub fn seal() -> BlockBackendCapsuleSealV1: self._seal

pub struct BlockBackendIoLeaseV1:
    _capsule: BlockBackendCapsuleSealV1
    _lease_slot: i32
    _lease_generation: u64
    _lease_nonce: u64
    _device_pin: BlockDevicePinLeaseV1

impl BlockBackendIoLeaseV1:
    pub static fn invalid_probe() -> BlockBackendIoLeaseV1:
        BlockBackendIoLeaseV1(
            _capsule: BlockBackendCapsuleSealV1.invalid_probe(),
            _lease_slot: -1, _lease_generation: 0u64, _lease_nonce: 0u64,
            _device_pin: BlockDevicePinLeaseV1.invalid_probe())
    pub fn capsule_generation() -> u64: self._capsule._generation

pub struct BlockBackendTeardownReceiptV1:
    slot: i32
    retired_generation: u64
    flushed: bool

enum _BlockBackendCapsuleStateV1:
    Free
    Active
    Closing
    Quarantined

enum _BlockBackendLeaseStateV1:
    Free
    Active
    Releasing
    Quarantined

struct _BlockBackendLeaseSlotV1:
    state: _BlockBackendLeaseStateV1
    generation: u64
    nonce: u64

struct _BlockBackendTeardownTicketV1:
    pin: BlockDevicePinLeaseV1
    retry_pin: bool

fn _empty_backend_lease_slot_v1(generation: u64) -> _BlockBackendLeaseSlotV1:
    _BlockBackendLeaseSlotV1(
        state: _BlockBackendLeaseStateV1.Free,
        generation: generation, nonce: 0u64)

struct _BlockBackendSlotStateV1:
    state: _BlockBackendCapsuleStateV1
    generation: u64
    nonce: u64
    close_nonce: u64
    identity_slot: i32
    identity_generation: u64
    base_pin: BlockDevicePinLeaseV1
    teardown_flushed: bool
    base_pin_quarantined: bool
    binding: BlockDeviceRegionBindingV1
    backend: BlockDevice?
    leases: [_BlockBackendLeaseSlotV1]
    active_leases: i32
    next_nonce: u64
    last_error: BlockBackendCapsuleErrorV1?
    last_registration: BlockBackendCapsuleRegistrationV1
    last_lease: BlockBackendIoLeaseV1
    last_bytes: [u8]
    last_bool: bool
    last_teardown: BlockBackendTeardownReceiptV1

fn _empty_backend_binding_v1() -> BlockDeviceRegionBindingV1:
    BlockDeviceRegionBindingV1(
        backend_kind: 0u32, backend_owner_id: 0u64, backend_generation: 0u64,
        base_lba: 0u64, sector_count: 0u64)

fn _initial_backend_slot_state_v1() -> _BlockBackendSlotStateV1:
    _BlockBackendSlotStateV1(
        state: _BlockBackendCapsuleStateV1.Free,
        generation: 1u64, nonce: 0u64, close_nonce: 0u64,
        identity_slot: -1, identity_generation: 0u64,
        base_pin: BlockDevicePinLeaseV1.invalid_probe(),
        teardown_flushed: false, base_pin_quarantined: false,
        binding: _empty_backend_binding_v1(), backend: nil,
        leases: [], active_leases: 0, next_nonce: 1u64, last_error: nil,
        last_registration: BlockBackendCapsuleRegistrationV1.invalid_probe(),
        last_lease: BlockBackendIoLeaseV1.invalid_probe(), last_bytes: [],
        last_bool: false,
        last_teardown: BlockBackendTeardownReceiptV1(
            slot: -1, retired_generation: 0u64, flushed: false))

class _BlockBackendSlotV1:
    _state: Mutex

    static fn create() -> _BlockBackendSlotV1:
        _BlockBackendSlotV1(_state: mutex_new(_initial_backend_slot_state_v1()))

    fn is_free() -> bool:
        mutex_with_lock(self._state, \state: state).state == _BlockBackendCapsuleStateV1.Free

    fn install(
        slot_index: i32, backend: BlockDevice,
        identity: BlockDeviceRegistrationV1, binding: BlockDeviceRegionBindingV1,
        base_pin: BlockDevicePinLeaseV1,
        nonce: u64, close_nonce: u64
    ) -> Result<BlockBackendCapsuleRegistrationV1, BlockBackendCapsuleErrorV1>:
        val updated = mutex_with_lock(self._state, \state:
            var next = state
            next.last_error = nil
            next.last_registration = BlockBackendCapsuleRegistrationV1.invalid_probe()
            if state.state != _BlockBackendCapsuleStateV1.Free:
                next.last_error = Some(BlockBackendCapsuleErrorV1.Busy)
            else:
                val seal = BlockBackendCapsuleSealV1(
                    _slot: slot_index, _generation: state.generation, _nonce: nonce)
                next.state = _BlockBackendCapsuleStateV1.Active
                next.nonce = nonce
                next.close_nonce = close_nonce
                next.identity_slot = identity.seal().owner_slot_index()
                next.identity_generation = identity.seal().generation()
                next.base_pin = base_pin
                next.teardown_flushed = false
                next.base_pin_quarantined = false
                next.binding = binding
                next.backend = Some(backend)
                next.next_nonce = 1u64
                next.active_leases = 0
                next.leases = []
                next.last_registration = BlockBackendCapsuleRegistrationV1(
                    _seal: seal, _close_nonce: close_nonce)
            next)
        if val err = updated.last_error: return Err(err)
        Ok(updated.last_registration)

    fn reserve(
        seal: BlockBackendCapsuleSealV1, identity: BlockDeviceRegistrationV1,
        binding: BlockDeviceRegionBindingV1, pin: BlockDevicePinLeaseV1
    ) -> Result<BlockBackendIoLeaseV1, BlockBackendCapsuleErrorV1>:
        val updated = mutex_with_lock(self._state, \state:
            var next = state
            next.last_error = nil
            next.last_lease = BlockBackendIoLeaseV1.invalid_probe()
            if state.state == _BlockBackendCapsuleStateV1.Quarantined:
                next.last_error = Some(BlockBackendCapsuleErrorV1.Quarantined)
            elif state.state != _BlockBackendCapsuleStateV1.Active:
                next.last_error = Some(BlockBackendCapsuleErrorV1.Closing)
            elif (seal._generation != state.generation or seal._nonce != state.nonce):
                next.last_error = Some(BlockBackendCapsuleErrorV1.StaleCapsule)
            elif (identity.seal().owner_slot_index() != state.identity_slot or
                  identity.seal().generation() != state.identity_generation or
                  pin.device_slot_index() != state.identity_slot or
                  pin.device_generation() != state.identity_generation or
                  not _backend_binding_equal_v1(binding, state.binding)):
                next.last_error = Some(BlockBackendCapsuleErrorV1.IdentityRejected)
            elif state.next_nonce == 0u64 or state.next_nonce == _BLOCK_BACKEND_COUNTER_MAX_V1:
                next.state = _BlockBackendCapsuleStateV1.Quarantined
                next.last_error = Some(BlockBackendCapsuleErrorV1.CounterExhausted)
            else:
                var lease_slot: i32 = -1
                var i: i32 = 0
                while i < state.leases.len():
                    if lease_slot < 0 and state.leases[i].state == _BlockBackendLeaseStateV1.Free:
                        lease_slot = i
                    i = i + 1
                if lease_slot < 0 and state.leases.len() >= BLOCK_BACKEND_LEASE_CAPACITY_V1:
                    next.last_error = Some(BlockBackendCapsuleErrorV1.CapacityExhausted)
                else:
                    if lease_slot < 0:
                        lease_slot = state.leases.len()
                        next.leases.push(_empty_backend_lease_slot_v1(1u64))
                    val generation = next.leases[lease_slot].generation
                    val nonce = state.next_nonce
                    next.leases[lease_slot] = _BlockBackendLeaseSlotV1(
                        state: _BlockBackendLeaseStateV1.Active,
                        generation: generation, nonce: nonce)
                    next.active_leases = state.active_leases + 1
                    next.next_nonce = nonce + 1u64
                    next.last_lease = BlockBackendIoLeaseV1(
                        _capsule: seal, _lease_slot: lease_slot,
                        _lease_generation: generation, _lease_nonce: nonce,
                        _device_pin: pin)
            next)
        if val err = updated.last_error: return Err(err)
        Ok(updated.last_lease)

    fn read(lease: BlockBackendIoLeaseV1, relative_lba: u64) -> Result<[u8], BlockBackendCapsuleErrorV1>:
        val updated = mutex_with_lock(self._state, \state:
            var next = state
            next.last_error = nil
            next.last_bytes = []
            if (state.state != _BlockBackendCapsuleStateV1.Active or
                lease._capsule._generation != state.generation or
                lease._capsule._nonce != state.nonce or lease._lease_slot < 0 or
                lease._lease_slot >= state.leases.len()):
                next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
            else:
                val held = state.leases[lease._lease_slot]
                if (held.state != _BlockBackendLeaseStateV1.Active or
                    held.generation != lease._lease_generation or held.nonce != lease._lease_nonce):
                    next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
                elif relative_lba >= state.binding.sector_count:
                    next.last_error = Some(BlockBackendCapsuleErrorV1.RegionViolation)
                elif val backend_value = state.backend:
                    var backend = backend_value
                    val result = backend.read_sector(state.binding.base_lba + relative_lba)
                    next.backend = Some(backend)
                    match result:
                        Ok(bytes): next.last_bytes = bytes
                        Err(_): next.last_error = Some(BlockBackendCapsuleErrorV1.BackendFailure)
                else:
                    next.last_error = Some(BlockBackendCapsuleErrorV1.Quarantined)
            next)
        if val err = updated.last_error: return Err(err)
        Ok(updated.last_bytes)

    fn write(
        lease: BlockBackendIoLeaseV1, relative_lba: u64, data: [u8]
    ) -> Result<bool, BlockBackendCapsuleErrorV1>:
        val updated = mutex_with_lock(self._state, \state:
            var next = state
            next.last_error = nil
            next.last_bool = false
            if (state.state != _BlockBackendCapsuleStateV1.Active or
                lease._capsule._generation != state.generation or
                lease._capsule._nonce != state.nonce or lease._lease_slot < 0 or
                lease._lease_slot >= state.leases.len()):
                next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
            else:
                val held = state.leases[lease._lease_slot]
                if (held.state != _BlockBackendLeaseStateV1.Active or
                    held.generation != lease._lease_generation or held.nonce != lease._lease_nonce):
                    next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
                elif relative_lba >= state.binding.sector_count:
                    next.last_error = Some(BlockBackendCapsuleErrorV1.RegionViolation)
                elif val backend_value = state.backend:
                    var backend = backend_value
                    val result = backend.write_sector(state.binding.base_lba + relative_lba, data)
                    next.backend = Some(backend)
                    match result:
                        Ok(ok):
                            if ok: next.last_bool = true
                            else: next.last_error = Some(BlockBackendCapsuleErrorV1.BackendFailure)
                        Err(_): next.last_error = Some(BlockBackendCapsuleErrorV1.BackendFailure)
                else:
                    next.last_error = Some(BlockBackendCapsuleErrorV1.Quarantined)
            next)
        if val err = updated.last_error: return Err(err)
        Ok(updated.last_bool)

    fn flush(lease: BlockBackendIoLeaseV1) -> Result<bool, BlockBackendCapsuleErrorV1>:
        val updated = mutex_with_lock(self._state, \state:
            var next = state
            next.last_error = nil
            next.last_bool = false
            if (state.state != _BlockBackendCapsuleStateV1.Active or
                lease._capsule._generation != state.generation or
                lease._capsule._nonce != state.nonce or lease._lease_slot < 0 or
                lease._lease_slot >= state.leases.len()):
                next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
            else:
                val held = state.leases[lease._lease_slot]
                if (held.state != _BlockBackendLeaseStateV1.Active or
                    held.generation != lease._lease_generation or held.nonce != lease._lease_nonce):
                    next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
                elif val backend_value = state.backend:
                    var backend = backend_value
                    val result = backend.flush()
                    next.backend = Some(backend)
                    match result:
                        Ok(ok):
                            if ok: next.last_bool = true
                            else: next.last_error = Some(BlockBackendCapsuleErrorV1.BackendFailure)
                        Err(_): next.last_error = Some(BlockBackendCapsuleErrorV1.BackendFailure)
                else:
                    next.last_error = Some(BlockBackendCapsuleErrorV1.Quarantined)
            next)
        if val err = updated.last_error: return Err(err)
        Ok(updated.last_bool)

    fn begin_release(lease: BlockBackendIoLeaseV1) -> Result<bool, BlockBackendCapsuleErrorV1>:
        val updated = mutex_with_lock(self._state, \state:
            var next = state
            next.last_error = nil
            if (lease._capsule._generation != state.generation or
                lease._capsule._nonce != state.nonce or lease._lease_slot < 0 or
                lease._lease_slot >= state.leases.len()):
                next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
            else:
                val held = state.leases[lease._lease_slot]
                if (held.state != _BlockBackendLeaseStateV1.Active or
                    held.generation != lease._lease_generation or held.nonce != lease._lease_nonce):
                    next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
                else:
                    var releasing = held
                    releasing.state = _BlockBackendLeaseStateV1.Releasing
                    next.leases[lease._lease_slot] = releasing
            next)
        if val err = updated.last_error: return Err(err)
        Ok(true)

    fn quarantine_release(lease: BlockBackendIoLeaseV1) -> Result<bool, BlockBackendCapsuleErrorV1>:
        val updated = mutex_with_lock(self._state, \state:
            var next = state
            next.last_error = nil
            if lease._lease_slot < 0 or lease._lease_slot >= state.leases.len():
                next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
            else:
                val held = state.leases[lease._lease_slot]
                if (held.state != _BlockBackendLeaseStateV1.Releasing or
                    held.generation != lease._lease_generation or held.nonce != lease._lease_nonce):
                    next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
                else:
                    var quarantined = held
                    quarantined.state = _BlockBackendLeaseStateV1.Quarantined
                    next.leases[lease._lease_slot] = quarantined
            next)
        if val err = updated.last_error: return Err(err)
        Ok(true)

    fn finish_release(
        lease: BlockBackendIoLeaseV1, require_quarantined: bool
    ) -> Result<bool, BlockBackendCapsuleErrorV1>:
        val updated = mutex_with_lock(self._state, \state:
            var next = state
            next.last_error = nil
            if lease._lease_slot < 0 or lease._lease_slot >= state.leases.len():
                next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
            else:
                val held = state.leases[lease._lease_slot]
                val expected = if require_quarantined:
                    held.state == _BlockBackendLeaseStateV1.Quarantined
                else:
                    held.state == _BlockBackendLeaseStateV1.Releasing
                if (not expected or held.generation != lease._lease_generation or
                    held.nonce != lease._lease_nonce or state.active_leases <= 0):
                    next.last_error = Some(BlockBackendCapsuleErrorV1.StaleLease)
                elif held.generation == _BLOCK_BACKEND_COUNTER_MAX_V1:
                    var retired = held
                    retired.state = _BlockBackendLeaseStateV1.Quarantined
                    retired.nonce = 0u64
                    next.leases[lease._lease_slot] = retired
                    next.active_leases = state.active_leases - 1
                else:
                    next.leases[lease._lease_slot] =
                        _empty_backend_lease_slot_v1(held.generation + 1u64)
                    next.active_leases = state.active_leases - 1
            next)
        if val err = updated.last_error: return Err(err)
        Ok(true)

    fn prepare_teardown(
        registration: BlockBackendCapsuleRegistrationV1, slot_index: i32,
        retry_quarantined: bool
    ) -> Result<_BlockBackendTeardownTicketV1, BlockBackendCapsuleErrorV1>:
        val updated = mutex_with_lock(self._state, \state:
            var next = state
            next.last_error = nil
            next.last_teardown = BlockBackendTeardownReceiptV1(
                slot: -1, retired_generation: 0u64, flushed: false)
            val seal = registration._seal
            if (seal._slot != slot_index or seal._generation != state.generation or
                seal._nonce != state.nonce or registration._close_nonce != state.close_nonce):
                next.last_error = Some(BlockBackendCapsuleErrorV1.StaleCapsule)
            elif (state.state == _BlockBackendCapsuleStateV1.Quarantined and
                  not retry_quarantined):
                next.last_error = Some(BlockBackendCapsuleErrorV1.Quarantined)
            elif (state.state != _BlockBackendCapsuleStateV1.Active and
                  state.state != _BlockBackendCapsuleStateV1.Quarantined):
                next.last_error = Some(BlockBackendCapsuleErrorV1.Closing)
            elif state.active_leases != 0:
                next.last_error = Some(BlockBackendCapsuleErrorV1.Busy)
            elif state.teardown_flushed:
                next.state = _BlockBackendCapsuleStateV1.Closing
            elif val backend_value = state.backend:
                var backend = backend_value
                val result = backend.flush()
                next.backend = Some(backend)
                match result:
                    Ok(ok):
                        if ok:
                            next.state = _BlockBackendCapsuleStateV1.Closing
                            next.teardown_flushed = true
                        else:
                            next.state = _BlockBackendCapsuleStateV1.Quarantined
                            next.last_error = Some(BlockBackendCapsuleErrorV1.BackendFailure)
                    Err(_):
                        next.state = _BlockBackendCapsuleStateV1.Quarantined
                        next.last_error = Some(BlockBackendCapsuleErrorV1.BackendFailure)
            else:
                next.state = _BlockBackendCapsuleStateV1.Quarantined
                next.last_error = Some(BlockBackendCapsuleErrorV1.Quarantined)
            next)
        if val err = updated.last_error: return Err(err)
        Ok(_BlockBackendTeardownTicketV1(
            pin: updated.base_pin, retry_pin: updated.base_pin_quarantined))

    fn quarantine_teardown(
        registration: BlockBackendCapsuleRegistrationV1
    ) -> Result<bool, BlockBackendCapsuleErrorV1>:
        val updated = mutex_with_lock(self._state, \state:
            var next = state
            next.last_error = nil
            if (registration._seal._generation != state.generation or
                registration._seal._nonce != state.nonce or
                registration._close_nonce != state.close_nonce or
                state.state != _BlockBackendCapsuleStateV1.Closing or
                not state.teardown_flushed):
                next.last_error = Some(BlockBackendCapsuleErrorV1.StaleCapsule)
            else:
                next.state = _BlockBackendCapsuleStateV1.Quarantined
                next.base_pin_quarantined = true
            next)
        if val err = updated.last_error: return Err(err)
        Ok(true)

    fn finish_teardown(
        registration: BlockBackendCapsuleRegistrationV1, slot_index: i32
    ) -> Result<BlockBackendTeardownReceiptV1, BlockBackendCapsuleErrorV1>:
        val updated = mutex_with_lock(self._state, \state:
            var next = state
            next.last_error = nil
            val retired_generation = state.generation
            if (registration._seal._generation != state.generation or
                registration._seal._nonce != state.nonce or
                registration._close_nonce != state.close_nonce or
                (state.state != _BlockBackendCapsuleStateV1.Closing and
                 state.state != _BlockBackendCapsuleStateV1.Quarantined) or
                not state.teardown_flushed or state.active_leases != 0):
                next.last_error = Some(BlockBackendCapsuleErrorV1.StaleCapsule)
            elif state.generation == _BLOCK_BACKEND_COUNTER_MAX_V1:
                next.state = _BlockBackendCapsuleStateV1.Quarantined
                next.backend = nil
                next.base_pin = BlockDevicePinLeaseV1.invalid_probe()
                next.last_teardown = BlockBackendTeardownReceiptV1(
                    slot: slot_index, retired_generation: retired_generation,
                    flushed: true)
            else:
                next = _initial_backend_slot_state_v1()
                next.generation = retired_generation + 1u64
                next.last_teardown = BlockBackendTeardownReceiptV1(
                    slot: slot_index, retired_generation: retired_generation,
                    flushed: true)
            next)
        if val err = updated.last_error: return Err(err)
        Ok(updated.last_teardown)

struct _BlockBackendRegistryStateV1:
    slots: [_BlockBackendSlotV1]
    next_nonce: u64
    last_error: BlockBackendCapsuleErrorV1?
    last_registration: BlockBackendCapsuleRegistrationV1

fn _backend_registry_initial_state_v1() -> _BlockBackendRegistryStateV1:
    var slots: [_BlockBackendSlotV1] = []
    var i: i32 = 0
    while i < BLOCK_BACKEND_CAPSULE_CAPACITY_V1:
        slots.push(_BlockBackendSlotV1.create())
        i = i + 1
    _BlockBackendRegistryStateV1(
        slots: slots, next_nonce: 1u64, last_error: nil,
        last_registration: BlockBackendCapsuleRegistrationV1.invalid_probe())

var _block_backend_registry_v1: Mutex = mutex_new(_backend_registry_initial_state_v1())

fn _capsule_seal_shape_valid_v1(seal: BlockBackendCapsuleSealV1) -> bool:
    seal._slot >= 0 and seal._generation != 0u64 and seal._nonce != 0u64

# Mount/controller owners use this exact comparison without gaining access to
# the private nonce fields or acquiring any I/O authority.
pub(package) fn block_backend_capsule_seal_matches_v1(
    left: BlockBackendCapsuleSealV1, right: BlockBackendCapsuleSealV1
) -> bool:
    (_capsule_seal_shape_valid_v1(left) and
     left._slot == right._slot and left._generation == right._generation and
     left._nonce == right._nonce)

fn _backend_binding_equal_v1(
    left: BlockDeviceRegionBindingV1, right: BlockDeviceRegionBindingV1
) -> bool:
    (left.backend_kind == right.backend_kind and
     left.backend_owner_id == right.backend_owner_id and
     left.backend_generation == right.backend_generation and
     left.base_lba == right.base_lba and left.sector_count == right.sector_count)

fn _lookup_backend_slot_v1(seal: BlockBackendCapsuleSealV1) -> _BlockBackendSlotV1?:
    if not _capsule_seal_shape_valid_v1(seal): return nil
    mutex_with_lock(_block_backend_registry_v1, \state:
        if seal._slot < state.slots.len(): Some(state.slots[seal._slot])
        else: nil)

# Provider boundary: production controller/namespace owners call this after
# creating the canonical identity registration.  Ordinary BlockDevice values
# receive no public constructor for the returned opaque seal.
pub(package) fn block_backend_capsule_register_v1(
    backend: BlockDevice,
    identity: BlockDeviceRegistrationV1,
    binding: BlockDeviceRegionBindingV1
) -> Result<BlockBackendCapsuleRegistrationV1, BlockBackendCapsuleErrorV1>:
    val base_pin_result = block_device_identity_backend_pin_v1(identity, binding)
    if not base_pin_result.?: return Err(BlockBackendCapsuleErrorV1.IdentityRejected)
    val base_pin = base_pin_result.unwrap()
    val updated = mutex_with_lock(_block_backend_registry_v1, \state:
        var next = state
        next.last_error = nil
        next.last_registration = BlockBackendCapsuleRegistrationV1.invalid_probe()
        if state.next_nonce == 0u64 or state.next_nonce > _BLOCK_BACKEND_COUNTER_MAX_V1 - 2u64:
            next.last_error = Some(BlockBackendCapsuleErrorV1.CounterExhausted)
        else:
            var slot_index: i32 = -1
            var i: i32 = 0
            while i < state.slots.len():
                if slot_index < 0 and state.slots[i].is_free(): slot_index = i
                i = i + 1
            if slot_index < 0:
                next.last_error = Some(BlockBackendCapsuleErrorV1.CapacityExhausted)
            else:
                match state.slots[slot_index].install(
                    slot_index, backend, identity, binding,
                    base_pin, state.next_nonce, state.next_nonce + 1u64):
                    Ok(registration):
                        next.last_registration = registration
                        next.next_nonce = state.next_nonce + 2u64
                    Err(err): next.last_error = Some(err)
        next)
    if val err = updated.last_error:
        match block_device_identity_unpin_v1(base_pin):
            Ok(_): pass_do_nothing("failed capsule install released its identity pin")
            Err(_):
                match block_device_identity_quarantine_unpin_v1(base_pin):
                    Ok(_): pass_do_nothing("uncertain install rollback remains quarantined")
                    Err(_): pass_do_nothing("identity owner retained rollback authority")
                return Err(BlockBackendCapsuleErrorV1.ReleaseIndeterminate)
        return Err(err)
    Ok(updated.last_registration)

pub fn block_backend_capsule_acquire_v1(
    capsule: BlockBackendCapsuleSealV1,
    identity: BlockDeviceRegistrationV1,
    binding: BlockDeviceRegionBindingV1
) -> Result<BlockBackendIoLeaseV1, BlockBackendCapsuleErrorV1>:
    val slot = _lookup_backend_slot_v1(capsule)
    if not slot.?: return Err(BlockBackendCapsuleErrorV1.InvalidIdentity)
    val pin = block_device_identity_pin_v1(identity, binding)
    if not pin.?: return Err(BlockBackendCapsuleErrorV1.IdentityRejected)
    val lease = slot.unwrap().reserve(capsule, identity, binding, pin.unwrap())
    if not lease.?:
        match block_device_identity_unpin_v1(pin.unwrap()):
            Ok(_): pass_do_nothing("rollback consumed the temporary identity pin")
            Err(_): return Err(BlockBackendCapsuleErrorV1.ReleaseIndeterminate)
        return Err(lease.unwrap_err())
    Ok(lease.unwrap())

pub fn block_backend_capsule_read_v1(
    lease: BlockBackendIoLeaseV1, relative_lba: u64
) -> Result<[u8], BlockBackendCapsuleErrorV1>:
    val slot = _lookup_backend_slot_v1(lease._capsule)
    if not slot.?: return Err(BlockBackendCapsuleErrorV1.StaleLease)
    slot.unwrap().read(lease, relative_lba)

pub fn block_backend_capsule_write_v1(
    lease: BlockBackendIoLeaseV1, relative_lba: u64, data: [u8]
) -> Result<bool, BlockBackendCapsuleErrorV1>:
    val slot = _lookup_backend_slot_v1(lease._capsule)
    if not slot.?: return Err(BlockBackendCapsuleErrorV1.StaleLease)
    slot.unwrap().write(lease, relative_lba, data)

pub fn block_backend_capsule_flush_v1(
    lease: BlockBackendIoLeaseV1
) -> Result<bool, BlockBackendCapsuleErrorV1>:
    val slot = _lookup_backend_slot_v1(lease._capsule)
    if not slot.?: return Err(BlockBackendCapsuleErrorV1.StaleLease)
    slot.unwrap().flush(lease)

pub fn block_backend_capsule_release_v1(
    lease: BlockBackendIoLeaseV1
) -> Result<bool, BlockBackendCapsuleErrorV1>:
    val slot = _lookup_backend_slot_v1(lease._capsule)
    if not slot.?: return Err(BlockBackendCapsuleErrorV1.StaleLease)
    slot.unwrap().begin_release(lease)?
    match block_device_identity_unpin_v1(lease._device_pin):
        Ok(_): slot.unwrap().finish_release(lease, false)
        Err(_):
            match block_device_identity_quarantine_unpin_v1(lease._device_pin):
                Ok(_): slot.unwrap().quarantine_release(lease)?
                Err(_): slot.unwrap().quarantine_release(lease)?
            Err(BlockBackendCapsuleErrorV1.ReleaseIndeterminate)

pub fn block_backend_capsule_retry_release_v1(
    lease: BlockBackendIoLeaseV1
) -> Result<bool, BlockBackendCapsuleErrorV1>:
    val slot = _lookup_backend_slot_v1(lease._capsule)
    if not slot.?: return Err(BlockBackendCapsuleErrorV1.StaleLease)
    match block_device_identity_retry_unpin_v1(lease._device_pin):
        Ok(_): slot.unwrap().finish_release(lease, true)
        Err(_):
            match block_device_identity_unpin_v1(lease._device_pin):
                Ok(_): slot.unwrap().finish_release(lease, true)
                Err(_): Err(BlockBackendCapsuleErrorV1.ReleaseIndeterminate)

pub(package) fn block_backend_capsule_teardown_v1(
    registration: BlockBackendCapsuleRegistrationV1
) -> Result<BlockBackendTeardownReceiptV1, BlockBackendCapsuleErrorV1>:
    val slot = _lookup_backend_slot_v1(registration._seal)
    if not slot.?: return Err(BlockBackendCapsuleErrorV1.InvalidIdentity)
    val ticket = slot.unwrap().prepare_teardown(
        registration, registration._seal._slot, false)?
    match block_device_identity_unpin_v1(ticket.pin):
        Ok(_): slot.unwrap().finish_teardown(registration, registration._seal._slot)
        Err(_):
            match block_device_identity_quarantine_unpin_v1(ticket.pin):
                Ok(_): slot.unwrap().quarantine_teardown(registration)?
                Err(_): slot.unwrap().quarantine_teardown(registration)?
            Err(BlockBackendCapsuleErrorV1.ReleaseIndeterminate)

pub(package) fn block_backend_capsule_retry_teardown_v1(
    registration: BlockBackendCapsuleRegistrationV1
) -> Result<BlockBackendTeardownReceiptV1, BlockBackendCapsuleErrorV1>:
    val slot = _lookup_backend_slot_v1(registration._seal)
    if not slot.?: return Err(BlockBackendCapsuleErrorV1.InvalidIdentity)
    val ticket = slot.unwrap().prepare_teardown(
        registration, registration._seal._slot, true)?
    val released = if ticket.retry_pin:
        block_device_identity_retry_unpin_v1(ticket.pin)
    else:
        block_device_identity_unpin_v1(ticket.pin)
    match released:
        Ok(_): slot.unwrap().finish_teardown(registration, registration._seal._slot)
        Err(_): Err(BlockBackendCapsuleErrorV1.ReleaseIndeterminate)
