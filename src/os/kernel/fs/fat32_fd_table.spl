# Per-task, per-fd Fat32Filesystem.FileHandle table + read/write entry points.
#
# Split out of `os.kernel.ipc.syscall_file` deliberately: that module
# transitively imports `os.kernel.ipc.syscall`, a huge dependency graph
# (scheduler/vmm/pmm/ipc/ELF-loader/...) that this codebase's test harness
# cannot run a spec through (`error: test-runner: no examples executed`, a
# pre-existing, reproducible harness limitation — see
# doc/08_tracking/bug/path_based_fs_syscalls_fake_success_2026-08-06.md for
# the control-run evidence: an EXISTING unmodified spec with the same import
# shape fails identically). This module imports only `os.kernel.fs.fat32`, the
# same import weight as `test/01_unit/os/kernel/fs/fat32_mount_and_dir_ops_spec.spl`
# (which passes 8/8), so the logic with actual risk here — the fd table
# itself, cursor/metadata commitment, task scoping, and alias retirement —
# can be unit-tested for real instead of only reachable through a spec that
# can never run.
#
# `os.kernel.ipc.syscall_file`'s `_handle_file_open`/`_handle_file_read`/
# `_handle_file_write`/`_handle_file_close` call into this module; they own
# only the userspace mmio byte-copy and `SyscallResult` wrapping.

use os.kernel.fs.fat32.{FileHandle, fat32_mount_ready, fat32_mount_fs, fat32_mount_dev}

val FAT32_FD_EBADF: i32 = -9
val FAT32_FD_ENOSYS: i32 = -38
val FAT32_FD_OBJECT_ID_MAX: u64 = 0xFFFFFFFFFFFFFFFF

struct Fat32FdEntry:
    """One task's FAT32 descriptor alias. Keyed by (task_id, fd) — NOT fd alone: fd
    numbers are per-task-context (see fd_context_* arrays in fd_table.spl /
    fd_activate_task), so two different tasks can both legitimately hold fd
    3 for two entirely different files. The entry names a separately owned
    file object so dup/fork aliases share one cursor and metadata record."""
    task_id: u64
    fd: i32
    object_id: u64

struct Fat32FileObject:
    """Canonical open-file description shared by every descriptor alias."""
    object_id: u64
    handle: FileHandle

var g_fat32_fd_table: [Fat32FdEntry] = []
var g_fat32_file_objects: [Fat32FileObject] = []
var g_fat32_fd_table_ready: bool = false
var g_fat32_next_object_id: u64 = 1u64
var g_fat32_object_ids_exhausted: bool = false

fn _fat32_fd_empty_table() -> [Fat32FdEntry]:
    """fn-returning constant: module-level array literals never execute in
    the freestanding kernel."""
    val empty: [Fat32FdEntry] = []
    empty

fn _fat32_object_empty_table() -> [Fat32FileObject]:
    val empty: [Fat32FileObject] = []
    empty

fn _fat32_fd_ensure_table():
    if not g_fat32_fd_table_ready:
        g_fat32_fd_table = _fat32_fd_empty_table()
        g_fat32_file_objects = _fat32_object_empty_table()
        g_fat32_fd_table_ready = true

fn _fat32_fd_index(task_id: u64, fd: i32) -> i64:
    """Table index for (task_id, fd), or -1 when not registered.

    Deliberately index-based rather than `FileHandle?` (Option<struct>): see
    doc/08_tracking/bug/any_slot_holds_untagged_scalar_2026-08-05.md and the
    sibling Option<struct>-nil-collapse landmines already documented for this
    codebase's native codegen — FileHandle is a value-type struct with mixed
    scalar/bool fields, exactly the shape those bugs hit.
    """
    _fat32_fd_ensure_table()
    var i: u64 = 0
    while i < g_fat32_fd_table.len():
        if g_fat32_fd_table[i].task_id == task_id and g_fat32_fd_table[i].fd == fd:
            return i as i64
        i = i + 1
    -1

fn _fat32_object_index(object_id: u64) -> i64:
    _fat32_fd_ensure_table()
    if object_id == 0u64:
        return -1
    var i: u64 = 0
    while i < g_fat32_file_objects.len():
        if g_fat32_file_objects[i].object_id == object_id:
            return i as i64
        i = i + 1
    -1

fn _fat32_object_has_alias(entries: [Fat32FdEntry], object_id: u64) -> bool:
    var i: u64 = 0
    while i < entries.len():
        if entries[i].object_id == object_id:
            return true
        i = i + 1
    false

fn _fat32_live_objects(entries: [Fat32FdEntry]) -> [Fat32FileObject]:
    var kept = _fat32_object_empty_table()
    var i: u64 = 0
    while i < g_fat32_file_objects.len():
        val object = g_fat32_file_objects[i]
        if _fat32_object_has_alias(entries, object.object_id):
            kept.push(object)
        i = i + 1
    kept

fn _fat32_entries_without(task_id: u64, fd: i32) -> [Fat32FdEntry]:
    var kept = _fat32_fd_empty_table()
    var i: u64 = 0
    while i < g_fat32_fd_table.len():
        val entry = g_fat32_fd_table[i]
        if not (entry.task_id == task_id and entry.fd == fd):
            kept.push(entry)
        i = i + 1
    kept

fn _fat32_allocate_object_id() -> u64:
    """Return a fresh nonzero identity, or 0 after the u64 space is exhausted.

    Exhaustion fails closed instead of wrapping and reviving a stale identity.
    Test cleanup intentionally does not reset this allocator.
    """
    if g_fat32_object_ids_exhausted:
        return 0u64
    val object_id = g_fat32_next_object_id
    if object_id == FAT32_FD_OBJECT_ID_MAX:
        g_fat32_object_ids_exhausted = true
    else:
        g_fat32_next_object_id = object_id + 1u64
    object_id

fn fat32_fd_register(task_id: u64, fd: i32, handle: FileHandle):
    """Create one canonical file object and attach (task_id, fd) to it.

    Replacing an existing descriptor retires its old object only when no other
    alias still names it. Object-id exhaustion leaves the descriptor
    unregistered rather than reusing a stale identity.
    """
    _fat32_fd_ensure_table()
    var entries = _fat32_entries_without(task_id, fd)
    var objects = _fat32_live_objects(entries)
    val object_id = _fat32_allocate_object_id()
    if object_id == 0u64:
        g_fat32_fd_table = entries
        g_fat32_file_objects = objects
        return
    entries.push(Fat32FdEntry(task_id: task_id, fd: fd, object_id: object_id))
    objects.push(Fat32FileObject(object_id: object_id, handle: handle))
    g_fat32_fd_table = entries
    g_fat32_file_objects = objects

fn fat32_fd_alias(source_task_id: u64, source_fd: i32, alias_task_id: u64, alias_fd: i32) -> Result<u64, i32>:
    """Attach alias_task_id/alias_fd to the source's canonical file object.

    This is the dup/fork integration hook. Replacing alias_fd retires its prior
    object only when no other descriptor alias remains.
    """
    val source_idx = _fat32_fd_index(source_task_id, source_fd)
    if source_idx < 0:
        return Err(FAT32_FD_EBADF)
    val object_id = g_fat32_fd_table[source_idx as u64].object_id
    if source_task_id == alias_task_id and source_fd == alias_fd:
        return Ok(object_id)
    var entries = _fat32_entries_without(alias_task_id, alias_fd)
    entries.push(Fat32FdEntry(task_id: alias_task_id, fd: alias_fd, object_id: object_id))
    val objects = _fat32_live_objects(entries)
    g_fat32_fd_table = entries
    g_fat32_file_objects = objects
    Ok(object_id)

fn fat32_fd_is_registered(task_id: u64, fd: i32) -> bool:
    _fat32_fd_index(task_id, fd) >= 0

fn fat32_fd_object_id(task_id: u64, fd: i32) -> u64:
    """Return the live canonical object identity for an fd, or 0 for EBADF."""
    val idx = _fat32_fd_index(task_id, fd)
    if idx < 0:
        return 0u64
    g_fat32_fd_table[idx as u64].object_id

fn fat32_fd_clear(task_id: u64, fd: i32):
    """Drop (task_id, fd)'s stored handle. Called by _handle_file_close
    BEFORE the fd number is released back to fd_alloc, so a later open() that
    is handed the same fd number cannot observe a stale FileHandle left over
    from a previous, unrelated file."""
    _fat32_fd_ensure_table()
    val entries = _fat32_entries_without(task_id, fd)
    val objects = _fat32_live_objects(entries)
    g_fat32_fd_table = entries
    g_fat32_file_objects = objects

fn fat32_fd_clear_task(task_id: u64):
    """Drop every fd entry belonging to task_id (call on process teardown,
    mirroring g_cwd_table's cwd_clear)."""
    _fat32_fd_ensure_table()
    var kept = _fat32_fd_empty_table()
    var i: u64 = 0
    while i < g_fat32_fd_table.len():
        if g_fat32_fd_table[i].task_id != task_id:
            kept.push(g_fat32_fd_table[i])
        i = i + 1
    val objects = _fat32_live_objects(kept)
    g_fat32_fd_table = kept
    g_fat32_file_objects = objects

fn fat32_fd_clear_for_test():
    """Test-only: wipe the whole table so specs don't leak state across
    examples (mirrors fat32_mount_clear's test-only role)."""
    g_fat32_fd_table = _fat32_fd_empty_table()
    g_fat32_file_objects = _fat32_object_empty_table()
    g_fat32_fd_table_ready = true

fn fat32_fd_read_into(task_id: u64, fd: i32, buf: [u8]) -> Result<u64, i32>:
    """Read up to buf.len() bytes from (task_id, fd) into buf via
    Fat32Filesystem.read, then advance and re-store the handle's offset.

    `Fat32Filesystem.read` mutates only a LOCAL copy of its `h` argument's
    offset (FileHandle is a Simple value-type struct) and returns just the
    byte count — the offset delta must be re-applied by the caller, which is
    exactly what this function exists to do so `_handle_file_read` doesn't
    have to know that detail.

    Returns Err(EBADF=-9) when (task_id, fd) has no registered handle,
    Err(ENOSYS=-38) when no filesystem is mounted, or whatever error code
    Fat32Filesystem.read itself returns (currently only EIO=-5).
    """
    val idx = _fat32_fd_index(task_id, fd)
    if idx < 0:
        return Err(FAT32_FD_EBADF)
    val object_idx = _fat32_object_index(g_fat32_fd_table[idx as u64].object_id)
    if object_idx < 0:
        return Err(FAT32_FD_EBADF)
    if not fat32_mount_ready():
        return Err(FAT32_FD_ENOSYS)
    var object = g_fat32_file_objects[object_idx as u64]
    var handle = object.handle
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    val read_r = fs.read(dev, handle, buf)
    if read_r.is_err():
        return Err(read_r.unwrap_err())
    val n = read_r.unwrap()
    handle.offset = handle.offset + n
    object.handle = handle
    g_fat32_file_objects[object_idx as u64] = object
    Ok(n)

fn fat32_fd_write_from(task_id: u64, fd: i32, bytes: [u8]) -> Result<u64, i32>:
    """Write at the canonical object's sequential cursor and advance it.

    `Fat32Filesystem.write_at` returns an updated value-semantic handle whose
    allocation and file-size metadata must be committed here. This owner alone
    advances the shared cursor, so every dup/fork alias observes POSIX
    sequential overwrite semantics while positioned writes remain independent.

    Returns Err(EBADF=-9) when unregistered, Err(ENOSYS=-38) when unmounted,
    or the positioned FAT32 error (ENOSPC/EFBIG/EIO).
    """
    val idx = _fat32_fd_index(task_id, fd)
    if idx < 0:
        return Err(FAT32_FD_EBADF)
    val object_idx = _fat32_object_index(g_fat32_fd_table[idx as u64].object_id)
    if object_idx < 0:
        return Err(FAT32_FD_EBADF)
    if not fat32_mount_ready():
        return Err(FAT32_FD_ENOSYS)
    val handle = g_fat32_file_objects[object_idx as u64].handle
    val cursor = handle.offset
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    val write_r = fs.write_at(dev, handle, cursor, bytes)
    if write_r.is_err():
        return Err(write_r.unwrap_err())
    var updated = write_r.unwrap()
    updated.offset = cursor + bytes.len().to_u64()
    g_fat32_file_objects[object_idx as u64] = Fat32FileObject(
        object_id: g_fat32_fd_table[idx as u64].object_id, handle: updated)
    Ok(bytes.len() as u64)

fn fat32_fd_read_object_at_into(object_id: u64, offset: u64, buf: [u8]) -> Result<u64, i32>:
    """Read at an explicit offset without changing the shared fd cursor."""
    val object_idx = _fat32_object_index(object_id)
    if object_idx < 0:
        return Err(FAT32_FD_EBADF)
    if not fat32_mount_ready():
        return Err(FAT32_FD_ENOSYS)
    val handle = g_fat32_file_objects[object_idx as u64].handle
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    fs.read_at(dev, handle, offset, buf)

fn fat32_fd_write_object_at_from(object_id: u64, offset: u64, bytes: [u8]) -> Result<u64, i32>:
    """Write at an explicit offset while preserving the shared fd cursor.

    The returned handle commits allocation and file-size metadata to the
    canonical object, so every alias observes the extension.
    """
    val object_idx = _fat32_object_index(object_id)
    if object_idx < 0:
        return Err(FAT32_FD_EBADF)
    if not fat32_mount_ready():
        return Err(FAT32_FD_ENOSYS)
    val object = g_fat32_file_objects[object_idx as u64]
    val cursor = object.handle.offset
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    val write_r = fs.write_at(dev, object.handle, offset, bytes)
    if write_r.is_err():
        return Err(write_r.unwrap_err())
    var updated = write_r.unwrap()
    updated.offset = cursor
    g_fat32_file_objects[object_idx as u64] = Fat32FileObject(
        object_id: object_id, handle: updated)
    Ok(bytes.len() as u64)

fn fat32_fd_sync(task_id: u64, fd: i32) -> Result<bool, i32>:
    """Commit file metadata, then the backing device cache, in that order."""
    val idx = _fat32_fd_index(task_id, fd)
    if idx < 0:
        return Err(FAT32_FD_EBADF)
    val object_idx = _fat32_object_index(g_fat32_fd_table[idx as u64].object_id)
    if object_idx < 0:
        return Err(FAT32_FD_EBADF)
    if not fat32_mount_ready():
        return Err(FAT32_FD_ENOSYS)
    var fs = fat32_mount_fs()
    val dev = fat32_mount_dev()
    val metadata = fs.flush(dev, g_fat32_file_objects[object_idx as u64].handle)
    if metadata.is_err():
        return Err(metadata.unwrap_err())
    val durable = dev.flush()
    if durable.is_err():
        return Err(-5)
    Ok(durable.unwrap())
