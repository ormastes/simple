"""Production boot composition for an authenticated FAT32 backend capsule.

The NVMe controller owner supplies the exact backend identity and region. This
module never derives an owner ID or generation from geometry. It retains the
lifecycle registrations while the published FAT mount is live.
"""

use std.fs_driver.block_device.{BlockDevice}
use os.kernel.fs.block_device_identity_owner_v1.{
    BlockDeviceRegionBindingV1, BlockDeviceRegistrationV1,
    block_device_identity_create_v1, block_device_identity_unmount_v1
}
use os.kernel.fs.block_backend_capsule_owner_v1.{
    BlockBackendCapsuleRegistrationV1, block_backend_capsule_register_v1,
    block_backend_capsule_teardown_v1
}
use os.kernel.fs.fat32_capsule_mount_owner_v1.{
    Fat32CapsuleMountSealV1, fat32_capsule_mount_publish_v1
}
use os.kernel.fs.fat32_fd_table.{fat32_fd_bind_capsule_mount_v1}

var _fat32_boot_identity_authority_v1: [BlockDeviceRegistrationV1] = []
var _fat32_boot_capsule_authority_v1: [BlockBackendCapsuleRegistrationV1] = []

pub fn fat32_boot_bind_capsule_device_v1(
    device: BlockDevice, binding: BlockDeviceRegionBindingV1
) -> Result<Fat32CapsuleMountSealV1, text>:
    """Atomically publish the boot FAT mount from caller-owned identity facts.

    The opaque lifecycle registrations remain owned here; the FD layer receives
    only the mount seal and each I/O obtains its own scoped operation lease.
    """
    if _fat32_boot_identity_authority_v1.len() != 0 or _fat32_boot_capsule_authority_v1.len() != 0:
        return Err("fat32-boot-capsule-already-owned")
    val identity_result = block_device_identity_create_v1(binding)
    if not identity_result.?:
        return Err("fat32-boot-identity-rejected")
    val identity = identity_result.unwrap()
    val capsule_result = block_backend_capsule_register_v1(device, identity, binding)
    if not capsule_result.?:
        val retired = block_device_identity_unmount_v1(identity)
        if not retired.?:
            _fat32_boot_identity_authority_v1 = [identity]
            return Err("fat32-boot-backend-capsule-rejected-identity-retained")
        return Err("fat32-boot-backend-capsule-rejected")
    val capsule = capsule_result.unwrap()
    val mount_result = fat32_capsule_mount_publish_v1(
        capsule.seal(), identity, binding, binding.backend_owner_id)
    if not mount_result.?:
        val capsule_retired = block_backend_capsule_teardown_v1(capsule)
        if not capsule_retired.?:
            _fat32_boot_identity_authority_v1 = [identity]
            _fat32_boot_capsule_authority_v1 = [capsule]
            return Err("fat32-boot-capsule-mount-rejected-backend-retained")
        val identity_retired = block_device_identity_unmount_v1(identity)
        if not identity_retired.?:
            _fat32_boot_identity_authority_v1 = [identity]
            return Err("fat32-boot-capsule-mount-rejected-identity-retained")
        return Err("fat32-boot-capsule-mount-rejected")
    val mount = mount_result.unwrap()
    _fat32_boot_identity_authority_v1 = [identity]
    _fat32_boot_capsule_authority_v1 = [capsule]
    fat32_fd_bind_capsule_mount_v1(mount)
    Ok(mount)
