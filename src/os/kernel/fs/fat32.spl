# FAT32 kernel filesystem driver — IF-07 wave-4a/4b/4c/4d.
#
# Wave-4a: BPB parse + cluster-to-lba arithmetic + real mount().
# Wave-4b: readdir("/") via stashed root-dir data; read_cluster_chain (guarded, cycle-safe).
# Wave-4c: open() + stat() for root-dir 8.3 names; read() wired through cluster-chain walk.
# Wave-4d: cluster allocator (_write_fat_entry / allocate_cluster / append_cluster);
#          write() wired through allocate+extend path.

# -- Error codes ---------------------------------------------------------------

use os.kernel.fs.fat32_atomic_replace.{Fat32ReplaceError, Fat32ReplaceState, Fat32ReplaceImage, Fat32ReplaceRecord, ReplaceReceipt, fat32_replace_image, fat32_atomic_replace_path_allowed, fat32_atomic_replace_route_allowed, fat32_atomic_replace_commit_device, fat32_atomic_replace_recover_device, fat32_atomic_replace_publish_caps}

val EINVAL: i32 = -22   # bad signature
val EIO: i32    = -5    # wrong FS type
val ENOSYS: i32 = -38   # not implemented
val ENOENT: i32 = -2    # file not found
val ENOSPC: i32 = -28   # no space left on device
val EEXIST: i32 = -17   # path already exists
val ENOTDIR: i32 = -20  # a path component is not a directory
val EISDIR: i32 = -21   # target is a directory where a file was expected
val ENOTEMPTY: i32 = -39  # directory holds entries other than "." / ".."
val EBUSY: i32 = -16

# -- BPB boot sector signature -------------------------------------------------

val FAT32_BOOT_SIG_0: u8 = 0x55
val FAT32_BOOT_SIG_1: u8 = 0xAA

# -- Public types --------------------------------------------------------------

struct FileHandle:
    """Open-file token returned by Fat32Filesystem.open()."""
    fd: u64                 # Opaque descriptor
    start_cluster: u32      # First cluster of the file
    current_cluster: u32    # Cluster cursor for sequential reads
    offset: u64             # Byte offset within file
    file_size: u64          # Total file size in bytes
    is_open: bool           # True when handle is valid
    dirent_sector: u64      # LBA of the sector holding this file's 32-byte directory entry (0 = no dirent)
    dirent_offset: i32      # Byte offset within dirent_sector where the 32-byte entry begins

struct FileStat:
    """Minimal file metadata returned by Fat32Filesystem.stat()."""
    size: u64
    is_dir: bool
    mtime: u64              # POSIX seconds since epoch

struct Fat32Bpb:
    """BIOS Parameter Block — parsed from the first 512-byte sector."""
    bytes_per_sector: u16
    sectors_per_cluster: u8
    reserved_sectors: u16
    num_fats: u8
    total_sectors_32: u32
    fat_size_32: u32
    root_cluster: u32
    fs_info_sector: u16
    bs_fat_type_label: [u8]     # 8 bytes: "FAT32   "
    bs_boot_signature: u8
    bs_volume_id: u32
    bs_volume_label: [u8]       # 11 bytes
    bs_fat32_signature: [u8]    # 2 bytes: 0x55 0xAA

# -- Pure BPB parser -----------------------------------------------------------

fn parse_bpb(sector0: [u8]) -> Result<Fat32Bpb, i32>:
    """Parse the 512-byte boot sector into a Fat32Bpb.

    Returns Err(EINVAL=-22) for a missing 0x55AA signature.
    Returns Err(EIO=-5) if the FS-type label is not 'FAT32   '.
    """
    # Validate boot sector signature at bytes 510-511
    val sig0 = sector0[510]
    val sig1 = sector0[511]
    if sig0 != FAT32_BOOT_SIG_0 or sig1 != FAT32_BOOT_SIG_1:
        return Err(EINVAL)

    # Validate FAT32 type label at offset 82 (8 bytes: "FAT32   ")
    val l0 = sector0[82]
    val l1 = sector0[83]
    val l2 = sector0[84]
    val l3 = sector0[85]
    val l4 = sector0[86]
    if (l0 != 0x46 or l1 != 0x41 or l2 != 0x54 or
        l3 != 0x33 or l4 != 0x32):
        return Err(EIO)

    val bpb = Fat32Bpb(
        bytes_per_sector:   (sector0[12].to_u16() << 8) | sector0[11].to_u16(),
        sectors_per_cluster: sector0[13],
        reserved_sectors:   (sector0[15].to_u16() << 8) | sector0[14].to_u16(),
        num_fats:           sector0[16],
        total_sectors_32:   ((sector0[35].to_u32() << 24) | (sector0[34].to_u32() << 16) | (sector0[33].to_u32() << 8) | sector0[32].to_u32()),
        fat_size_32:        ((sector0[39].to_u32() << 24) | (sector0[38].to_u32() << 16) | (sector0[37].to_u32() << 8) | sector0[36].to_u32()),
        root_cluster:       ((sector0[47].to_u32() << 24) | (sector0[46].to_u32() << 16) | (sector0[45].to_u32() << 8) | sector0[44].to_u32()),
        fs_info_sector:     (sector0[49].to_u16() << 8) | sector0[48].to_u16(),
        bs_fat_type_label:  [sector0[82], sector0[83], sector0[84], sector0[85],
                             sector0[86], sector0[87], sector0[88], sector0[89]],
        bs_boot_signature:  sector0[66],
        bs_volume_id:       ((sector0[70].to_u32() << 24) | (sector0[69].to_u32() << 16) | (sector0[68].to_u32() << 8) | sector0[67].to_u32()),
        bs_volume_label:    [sector0[71], sector0[72], sector0[73], sector0[74],
                             sector0[75], sector0[76], sector0[77], sector0[78],
                             sector0[79], sector0[80], sector0[81]],
        bs_fat32_signature: [sector0[510], sector0[511]]
    )
    Ok(bpb)

# -- Cluster arithmetic --------------------------------------------------------

fn cluster_to_lba(bpb: Fat32Bpb, cluster: u32) -> u64:
    """Convert a cluster number to an absolute LBA sector.

    Formula: reserved_sectors + num_fats*fat_size_32 + (cluster-2)*sectors_per_cluster
    """
    val fat_region  = bpb.reserved_sectors.to_u64() + bpb.num_fats.to_u64() * bpb.fat_size_32.to_u64()
    val data_offset = (cluster - 2u32).to_u64() * bpb.sectors_per_cluster.to_u64()
    fat_region + data_offset

# -- LFN (long-filename) helpers ----------------------------------------------
# LFN slots use attr=0x0F and store UCS-2 code units across three regions of the
# 32-byte entry: bytes 1-10 (5 chars), 14-25 (6 chars), 28-31 (2 chars).
# Slots are stored in reverse sequence: the slot with the LAST 13 chars of the
# name is stored first physically (highest sequence + 0x40 last-bit). Walking
# forward through the directory we encounter highest-seq → lowest-seq → 8.3.

fn fat32_decode_lfn_code_unit(entry_data: [u8], offset: i32) -> text:
    val lo = entry_data[offset]
    val hi = entry_data[offset + 1]
    if hi == 0x00u8 and lo == 0x00u8:
        return ""               # NUL terminator
    if hi == 0xFFu8 and lo == 0xFFu8:
        return ""               # padding past terminator
    if hi != 0x00u8:
        return "?"              # non-ASCII (BMP code unit > 0xFF)
    lo.chr()

fn fat32_parse_lfn_slot(entry_data: [u8], offset: i32) -> text:
    var name = ""
    val c1 = fat32_decode_lfn_code_unit(entry_data, offset + 1)
    if c1 != "":
        name = name + c1
    val c2 = fat32_decode_lfn_code_unit(entry_data, offset + 3)
    if c2 != "":
        name = name + c2
    val c3 = fat32_decode_lfn_code_unit(entry_data, offset + 5)
    if c3 != "":
        name = name + c3
    val c4 = fat32_decode_lfn_code_unit(entry_data, offset + 7)
    if c4 != "":
        name = name + c4
    val c5 = fat32_decode_lfn_code_unit(entry_data, offset + 9)
    if c5 != "":
        name = name + c5
    val c6 = fat32_decode_lfn_code_unit(entry_data, offset + 14)
    if c6 != "":
        name = name + c6
    val c7 = fat32_decode_lfn_code_unit(entry_data, offset + 16)
    if c7 != "":
        name = name + c7
    val c8 = fat32_decode_lfn_code_unit(entry_data, offset + 18)
    if c8 != "":
        name = name + c8
    val c9 = fat32_decode_lfn_code_unit(entry_data, offset + 20)
    if c9 != "":
        name = name + c9
    val c10 = fat32_decode_lfn_code_unit(entry_data, offset + 22)
    if c10 != "":
        name = name + c10
    val c11 = fat32_decode_lfn_code_unit(entry_data, offset + 24)
    if c11 != "":
        name = name + c11
    val c12 = fat32_decode_lfn_code_unit(entry_data, offset + 28)
    if c12 != "":
        name = name + c12
    val c13 = fat32_decode_lfn_code_unit(entry_data, offset + 30)
    if c13 != "":
        name = name + c13
    name

# -- Directory-entry attribute bits --------------------------------------------

val FAT32_ATTR_DIRECTORY: u32 = 0x10

# -- Path + directory-scan helpers (wave-4f: subdirectory traversal) -----------
#
# Free functions, not methods: the component walk in resolve_path() already
# nests three loops deep, and keeping these out of the class keeps each call
# frame shallow (kernel-stack budget).
#
# Text handling here uses `.slice()` / `.upper()`, exactly like the pre-existing
# `_find_root_entry`.  That is safe for this class because it is NOT on the
# freestanding kernel path today: the in-guest FS path goes through the
# `simpleos_fat32_stream_open` C stub, and this driver has no `src/` caller.
# The `[u8]`-via-`rt_bytes_u8_at` discipline required for freestanding code
# cannot be used here — those externs are unregistered in the host interpreter
# the specs run on, which would make every assertion vacuous.

struct Fat32DirEntryLoc:
    """Located 32-byte directory entry, plus its on-disk address.

    `found` is carried explicitly rather than wrapping the offset in `i32?`:
    an entry at byte offset 0 collides with the interpreter's nil/0 ambiguity
    (see the note in test/01_unit/os/kernel/fs/fat32_dirent_spec.spl).
    """
    found: bool
    dir_cluster: u32        # First cluster of the directory that holds the entry
    entry_offset: i32       # Byte offset of the entry within that directory's data
    dirent_sector: u64      # Absolute LBA of the sector holding the entry
    dirent_offset: i32      # Byte offset of the entry within that sector
    start_cluster: u32      # First cluster of the named file/dir
    file_size: u32          # Size in bytes (0 for directories)
    is_dir: bool            # ATTR_DIRECTORY bit

fn fat32_split_path(path: text) -> [text]:
    """Split "/A/B/C.O" into ["A", "B", "C.O"]. Empty components are dropped,
    so "//A//B/" and "/A/B" split identically. "/" splits to []."""
    var parts: [text] = []
    var cur = ""
    var i = 0
    while i < path.len():
        val ch = path.slice(i, i + 1)
        if ch == "/":
            if cur.len() > 0:
                parts.push(cur)
                cur = ""
        else:
            cur = cur + ch
        i = i + 1
    if cur.len() > 0:
        parts.push(cur)
    parts

fn fat32_dir_find_entry(dir_data: [u8], name: text) -> i32:
    """Scan one directory's raw bytes for `name`; return its byte offset, or -1.

    Matches the accumulated long filename (LFN) first, then the 8.3 short name;
    both case-insensitively. Honours the 0x00 end-of-directory marker and skips
    0xE5 deleted entries (orphaning any partially accumulated LFN).
    """
    val upper = name.upper()
    val total_entries = dir_data.len() / 32
    var idx = 0
    var lfn_name = ""
    while idx < total_entries:
        val off = idx * 32
        val first_byte = dir_data[off]
        if first_byte == 0x00u8:
            return -1                   # end of directory — not found
        if first_byte == 0xE5u8:
            lfn_name = ""               # orphan any pending LFN
            idx = idx + 1
            continue                    # deleted entry
        val attr = dir_data[off + 11]
        if attr == 0x0Fu8:
            # Walk highest-seq → lowest-seq: prepend each fragment.
            val fragment = fat32_parse_lfn_slot(dir_data, off)
            lfn_name = fragment + lfn_name
            idx = idx + 1
            continue
        # 8.3 entry. Match accumulated LFN first (the long name),
        # then fall back to the 8.3 short name.
        if lfn_name.len() > 0 and lfn_name.upper() == upper:
            return off
        var entry_name = ""
        var ni = 0
        while ni < 8:
            val ch = dir_data[off + ni]
            if ch != 0x20u8 and ch != 0x00u8:
                entry_name = entry_name + ch.chr()
            ni = ni + 1
        var ext = ""
        var ei = 0
        while ei < 3:
            val ch = dir_data[off + 8 + ei]
            if ch != 0x20u8 and ch != 0x00u8:
                ext = ext + ch.chr()
            ei = ei + 1
        if ext.len() > 0:
            entry_name = entry_name + "." + ext
        if entry_name.upper() == upper:
            return off
        lfn_name = ""
        idx = idx + 1
    -1

fn fat32_dir_list_entries(dir_data: [u8]) -> [text]:
    """Enumerate every live (non-deleted) entry name in one directory's raw
    bytes, in on-disk order — the readdir() primitive `fat32_dir_find_entry`
    never needed. Reuses the same LFN-accumulation / 8.3-decode logic so a
    name written by `_link_entry`'s LFN path reads back identically here.
    Includes "." and ".." when present (real subdirectories carry them)."""
    var names: [text] = []
    val total_entries = dir_data.len() / 32
    var idx = 0
    var lfn_name = ""
    while idx < total_entries:
        val off = idx * 32
        val first_byte = dir_data[off]
        if first_byte == 0x00u8:
            return names          # end of directory
        if first_byte == 0xE5u8:
            lfn_name = ""         # orphan any pending LFN
            idx = idx + 1
            continue
        val attr = dir_data[off + 11]
        if attr == 0x0Fu8:
            val fragment = fat32_parse_lfn_slot(dir_data, off)
            lfn_name = fragment + lfn_name
            idx = idx + 1
            continue
        var name = ""
        if lfn_name.len() > 0:
            name = lfn_name
        else:
            var entry_name = ""
            var ni = 0
            while ni < 8:
                val ch = dir_data[off + ni]
                if ch != 0x20u8 and ch != 0x00u8:
                    entry_name = entry_name + ch.chr()
                ni = ni + 1
            var ext = ""
            var ei = 0
            while ei < 3:
                val ch = dir_data[off + 8 + ei]
                if ch != 0x20u8 and ch != 0x00u8:
                    ext = ext + ch.chr()
                ei = ei + 1
            if ext.len() > 0:
                entry_name = entry_name + "." + ext
            name = entry_name
        names.push(name)
        lfn_name = ""
        idx = idx + 1
    names

fn fat32_entry_start_cluster(dir_data: [u8], off: i32) -> u32:
    """Decode first-cluster (hi at +20..21, lo at +26..27) from a dirent."""
    val cluster_high = (dir_data[off + 21].to_u32() << 8) | dir_data[off + 20].to_u32()
    val cluster_low  = (dir_data[off + 27].to_u32() << 8) | dir_data[off + 26].to_u32()
    (cluster_high << 16) | cluster_low

fn fat32_entry_file_size(dir_data: [u8], off: i32) -> u32:
    """Decode the u32 little-endian file size at dirent offset +28..31."""
    ((dir_data[off + 31].to_u32() << 24) | (dir_data[off + 30].to_u32() << 16) |
     (dir_data[off + 29].to_u32() << 8)  |  dir_data[off + 28].to_u32())

# -- Name encoding for the WRITE path (wave-4g) --------------------------------
#
# The read side above only ever DECODES names. Everything below ENCODES them,
# which is what a host-like filesystem needs: `/usr/bin/clang` and
# `/home/user/proj/src/main.c` must be creatable with their real mixed-case,
# long, dotted names rather than being flattened to uppercase 8.3 in the root
# directory.
#
# All of these are free functions on plain `[u8]` / `text` so the call frames
# stay shallow and no class construction happens on the encode path.

val FAT32_ATTR_LFN: u8      = 0x0F
val FAT32_ATTR_ARCHIVE: u8  = 0x20
val FAT32_ATTR_DIR_BYTE: u8 = 0x10

struct Fat32SlotAddr:
    """Absolute address of one 32-byte directory slot."""
    sector: u64
    offset: i32

fn fat32_upper_ascii(c: i32) -> i32:
    """ASCII-only uppercase; leaves everything outside a-z untouched."""
    if c >= 97 and c <= 122:
        return c - 32
    c

fn fat32_digit_char(d: i32) -> text:
    # NOT `(48 + d).to_u8().chr()`: `.chr()` on an integer expression in a
    # nested call context is rejected ("method 'chr' not found on value of
    # type i64"). A slice off a literal digit table has no such hazard.
    val digits = "0123456789"
    digits.slice(d, d + 1)

fn fat32_seq_digits(n: i32) -> text:
    """Decimal rendering of a 1..999 short-name collision counter."""
    if n < 10:
        return fat32_digit_char(n)
    if n < 100:
        return fat32_digit_char(n / 10) + fat32_digit_char(n % 10)
    fat32_digit_char(n / 100) + fat32_digit_char((n / 10) % 10) + fat32_digit_char(n % 10)

fn fat32_is_valid_8_3_char(c: i32) -> bool:
    """True when `c` may appear literally in an 8.3 short-name field.

    Rejects control codes, space, and the FAT-reserved punctuation
    `" * + , . / : ; < = > ? [ \\ ] |`.
    """
    if c < 0x21:
        return false                    # control codes and space (0x20)
    if c == 0x22 or c == 0x2A or c == 0x2B or c == 0x2C:
        return false                    # " * + ,
    if c == 0x2E or c == 0x2F or c == 0x3A or c == 0x3B:
        return false                    # . / : ;
    if c == 0x3C or c == 0x3D or c == 0x3E or c == 0x3F:
        return false                    # < = > ?
    if c == 0x5B or c == 0x5C or c == 0x5D or c == 0x7C:
        return false                    # [ \ ] |
    if c > 0x7E:
        return false                    # non-ASCII needs an LFN
    true

fn fat32_last_dot(name: text) -> i32:
    """Index of the extension-separating dot, or -1. A leading dot is part of
    the basename (".config"), never a separator."""
    var dot = -1
    var j = 1
    while j < name.len():
        if name.char_code_at(j) == 0x2E:
            dot = j
        j = j + 1
    dot

fn fat32_name_needs_lfn(name: text) -> bool:
    """True when `name` cannot round-trip through an 8.3 short name alone.

    Any lowercase letter forces an LFN: the 8.3 field has no case bits, so
    "Main.c" stored as "MAIN.C" would come back uppercased and the caller's
    path would no longer match byte-for-byte.
    """
    if name.len() == 0:
        return true
    if name.len() > 12:
        return true
    val dot = fat32_last_dot(name)
    var i = 0
    while i < name.len():
        val c = name.char_code_at(i)
        if c == 0x2E:
            if i != dot:
                return true             # more than one dot, or a leading dot
        else:
            if c >= 97 and c <= 122:
                return true             # lowercase — needs an LFN to survive
            if not fat32_is_valid_8_3_char(c):
                return true
        i = i + 1
    var base_len = name.len()
    var ext_len = 0
    if dot >= 0:
        base_len = dot
        ext_len = name.len() - dot - 1
    if base_len == 0 or base_len > 8:
        return true
    if ext_len > 3:
        return true
    false

fn fat32_blank_field() -> [u8]:
    var f: [u8] = []
    var i = 0
    while i < 11:
        f.push(0x20u8)
        i = i + 1
    f

fn fat32_short_field(name: text) -> [u8]:
    """Encode an already-8.3-legal `name` into its 11-byte, space-padded field.

    "." and ".." are the two names that are dots rather than have dots; they
    are emitted literally because mkdir writes them into every new directory.
    """
    var f = fat32_blank_field()
    if name == ".":
        f[0] = 0x2Eu8
        return f
    if name == "..":
        f[0] = 0x2Eu8
        f[1] = 0x2Eu8
        return f
    val dot = fat32_last_dot(name)
    var base_end = name.len()
    if dot >= 0:
        base_end = dot
    var k = 0
    while k < base_end and k < 8:
        f[k] = fat32_upper_ascii(name.char_code_at(k)).to_u8()
        k = k + 1
    if dot >= 0:
        var e = 0
        while (dot + 1 + e) < name.len() and e < 3:
            f[8 + e] = fat32_upper_ascii(name.char_code_at(dot + 1 + e)).to_u8()
            e = e + 1
    f

fn fat32_gen_short_field(long: text, seq: i32) -> [u8]:
    """Derive the `BASE~N.EXT` 8.3 alias for a long name.

    Spaces and embedded dots are dropped, illegal bytes become '_', letters are
    uppercased, and the basename is truncated so that the `~N` tail always
    fits inside the 8-byte field. `seq` is the collision counter: callers try
    1, then 2, ... until the resulting short name is unused in the directory.
    """
    var f = fat32_blank_field()
    val dot = fat32_last_dot(long)
    var base_end = long.len()
    if dot >= 0:
        base_end = dot
    val suffix = "~" + fat32_seq_digits(seq)
    val keep = 8 - suffix.len()
    var w = 0
    var k = 0
    while k < base_end and w < keep:
        val c = long.char_code_at(k)
        if c != 0x20 and c != 0x2E:
            var oc = fat32_upper_ascii(c)
            if not fat32_is_valid_8_3_char(oc):
                oc = 0x5F                   # '_'
            f[w] = oc.to_u8()
            w = w + 1
        k = k + 1
    if w == 0:
        f[0] = 0x5Fu8
        w = 1
    var s = 0
    while s < suffix.len():
        f[w + s] = suffix.char_code_at(s).to_u8()
        s = s + 1
    if dot >= 0:
        var e = 0
        var p = dot + 1
        while p < long.len() and e < 3:
            val c2 = long.char_code_at(p)
            if c2 != 0x20 and c2 != 0x2E:
                var oc2 = fat32_upper_ascii(c2)
                if not fat32_is_valid_8_3_char(oc2):
                    oc2 = 0x5F
                f[8 + e] = oc2.to_u8()
                e = e + 1
            p = p + 1
    f

fn fat32_short_field_to_text(f: [u8]) -> text:
    """Render an 11-byte 8.3 field back as "BASE.EXT" (no padding spaces)."""
    var n = ""
    var i = 0
    while i < 8:
        if f[i] != 0x20u8:
            n = n + f[i].chr()
        i = i + 1
    var e = ""
    var j = 0
    while j < 3:
        if f[8 + j] != 0x20u8:
            e = e + f[8 + j].chr()
        j = j + 1
    if e.len() > 0:
        n = n + "." + e
    n

fn fat32_lfn_checksum(field: [u8]) -> u8:
    """The one byte every LFN slot must carry to bind it to its 8.3 alias.

    sum = rotate-right-8(sum) + field[i], over the 11 PADDED short-name bytes.
    Getting this wrong is invisible to a permissive reader but makes the entry
    vanish under Linux/Windows, so it is asserted against a fixed vector in the
    spec rather than only re-derived.
    """
    var sum: u32 = 0u32
    var i = 0
    while i < 11:
        val rot = ((sum & 1u32) << 7u32) | (sum >> 1u32)
        sum = (rot + field[i].to_u32()) & 0xFFu32
        i = i + 1
    sum.to_u8()

fn fat32_lfn_char_offset(k: i32) -> i32:
    """Byte offset of the k-th (0..12) UCS-2 code unit inside an LFN slot."""
    if k < 5:
        return 1 + k * 2
    if k < 11:
        return 14 + (k - 5) * 2
    28 + (k - 11) * 2

fn fat32_lfn_slot_count(name: text) -> i32:
    """Number of 32-byte LFN slots needed to carry `name` (13 chars each)."""
    (name.len() + 12) / 13

fn fat32_make_lfn_slot(long: text, seq: i32, total: i32, csum: u8) -> [u8]:
    """Build one 32-byte LFN slot. `seq` is 1-based; the slot holding the LAST
    fragment (seq == total) carries the 0x40 LAST_LONG_ENTRY flag."""
    var e: [u8] = []
    var i = 0
    while i < 32:
        e.push(0u8)
        i = i + 1
    var s = seq
    if seq == total:
        s = seq | 0x40
    e[0]  = s.to_u8()
    e[11] = FAT32_ATTR_LFN
    e[12] = 0u8                          # type: always 0
    e[13] = csum
    e[26] = 0u8                          # first-cluster field is always 0
    e[27] = 0u8
    val base = (seq - 1) * 13
    var k = 0
    while k < 13:
        val co = fat32_lfn_char_offset(k)
        val ci = base + k
        if ci < long.len():
            e[co]     = long.char_code_at(ci).to_u8()
            e[co + 1] = 0u8
        else:
            if ci == long.len():
                e[co]     = 0u8          # NUL terminator
                e[co + 1] = 0u8
            else:
                e[co]     = 0xFFu8       # padding past the terminator
                e[co + 1] = 0xFFu8
        k = k + 1
    e

fn fat32_make_dirent(field: [u8], attr: u8, cluster: u32, size: u32) -> [u8]:
    """Build one 32-byte 8.3 directory entry, little-endian, byte-by-byte."""
    var e: [u8] = []
    var i = 0
    while i < 32:
        e.push(0u8)
        i = i + 1
    var k = 0
    while k < 11:
        e[k] = field[k]
        k = k + 1
    e[11] = attr
    val hi = (cluster >> 16u32) & 0xFFFFu32
    val lo = cluster & 0xFFFFu32
    e[20] = (hi & 0xFFu32).to_u8()
    e[21] = ((hi >> 8u32) & 0xFFu32).to_u8()
    e[26] = (lo & 0xFFu32).to_u8()
    e[27] = ((lo >> 8u32) & 0xFFu32).to_u8()
    e[28] = (size & 0xFFu32).to_u8()
    e[29] = ((size >> 8u32)  & 0xFFu32).to_u8()
    e[30] = ((size >> 16u32) & 0xFFu32).to_u8()
    e[31] = ((size >> 24u32) & 0xFFu32).to_u8()
    e

# -- Driver state --------------------------------------------------------------

class Fat32Filesystem:
    """FAT32 filesystem over a block device (IF-07).

    Wave-4a: mount() parses BPB and stores geometry.
    Wave-4b: readdir("/") via stashed root-dir data; next_cluster + read_cluster_chain public for wave-4c.
    Wave-4c: open/read/stat for root-dir 8.3 names.
    Wave-4d: cluster allocator + write() path.
    """
    device_id: u64          # BlockDevice handle assigned by bus registration
    bpb_parsed: bool        # True once mount() has validated the BPB
    cluster_size: u32       # Bytes per cluster (512 * sectors-per-cluster)
    fat_start_sector: u32   # First sector of the FAT region
    data_start_sector: u32  # First sector of the cluster-heap region
    root_cluster: u32       # First cluster of root directory
    sectors_per_cluster: u32
    bytes_per_sector: u32
    data_clusters: u32      # Total data clusters (fuel bound for chain walk)
    total_sectors: u32
    reserved_sectors: u32
    fat_size_sectors: u32
    fat_count: u32
    mutation_active: bool
    root_dir_data: [u8]     # First cluster of root dir, stashed at mount

impl Fat32Filesystem:
    static fn new(device_id: u64) -> Fat32Filesystem:
        """Create a driver bound to the given block device."""
        Fat32Filesystem(
            device_id: device_id,
            bpb_parsed: false,
            cluster_size: 0u32,
            fat_start_sector: 0u32,
            data_start_sector: 0u32,
            root_cluster: 0u32,
            sectors_per_cluster: 0u32,
            bytes_per_sector: 512u32,
            data_clusters: 0u32,
            total_sectors: 0u32,
            reserved_sectors: 0u32,
            fat_size_sectors: 0u32,
            fat_count: 0u32,
            mutation_active: false,
            root_dir_data: []
        )

    fn _mutation_enter(self) -> bool:
        if self.mutation_active:
            return false
        self.mutation_active = true
        true

    fn _mutation_leave(self):
        self.mutation_active = false

    fn mount(self, dev: BlockDevice) -> Result<(), i32>:
        """Read sector 0, validate BPB, populate geometry fields."""
        val read_result = dev.read_sector(0u64)
        if read_result.is_err():
            return Err(EIO)
        val buf = read_result.unwrap()

        val bpb_result = parse_bpb(buf)
        if bpb_result.is_err():
            return Err(bpb_result.unwrap_err())

        val bpb = bpb_result.unwrap()
        self.bpb_parsed          = true
        self.fat_start_sector    = bpb.reserved_sectors.to_u32()
        self.data_start_sector   = (bpb.reserved_sectors.to_u32() + bpb.num_fats.to_u32() * bpb.fat_size_32)
        self.cluster_size        = bpb.sectors_per_cluster.to_u32() * bpb.bytes_per_sector.to_u32()
        self.root_cluster        = bpb.root_cluster
        self.sectors_per_cluster = bpb.sectors_per_cluster.to_u32()
        self.bytes_per_sector    = bpb.bytes_per_sector.to_u32()
        self.total_sectors       = bpb.total_sectors_32
        self.reserved_sectors    = bpb.reserved_sectors.to_u32()
        self.fat_size_sectors    = bpb.fat_size_32
        self.fat_count           = bpb.num_fats.to_u32()
        # Fuel for cluster-chain walk: total data sectors / sectors-per-cluster.
        # A valid chain can never contain more clusters than this.
        if bpb.total_sectors_32 > self.data_start_sector and self.sectors_per_cluster > 0u32:
            self.data_clusters = (bpb.total_sectors_32 - self.data_start_sector) / self.sectors_per_cluster
        else:
            self.data_clusters = 0u32

        # Recover the fixed SimpleOS atomic-replace journal before reading or
        # publishing root_dir_data. Missing provisioning leaves ordinary FAT32
        # available with the capability Unsupported; corrupt/ambiguous or I/O
        # state fails mount closed so stale namespace bytes are never exposed.
        val recovery = fat32_atomic_replace_recover_device(
            dev, bpb.total_sectors_32, bpb.reserved_sectors.to_u32(),
            self.fat_start_sector, bpb.fat_size_32, bpb.num_fats.to_u32(),
            self.data_clusters, self.data_start_sector,
            self.sectors_per_cluster, self.root_cluster)
        if recovery.is_err():
            if recovery.unwrap_err() == Fat32ReplaceError.Unsupported:
                fat32_atomic_replace_publish_caps(false, false, false)
            else:
                fat32_atomic_replace_publish_caps(false, false, false)
                return Err(EIO)
        else:
            fat32_atomic_replace_publish_caps(true, true, true)

        # Stash root dir cluster sectors for readdir (wave-4b shortcut)
        val root_lba = cluster_to_lba(bpb, bpb.root_cluster)
        var sec_idx: u32 = 0
        while sec_idx < bpb.sectors_per_cluster.to_u32():
            val r = dev.read_sector(root_lba + sec_idx.to_u64())
            if r.is_err():
                return Err(EIO)
            val sec_buf = r.unwrap()
            var ci = 0
            while ci < 512:
                self.root_dir_data.push(sec_buf[ci])
                ci = ci + 1
            sec_idx = sec_idx + 1

        Ok(())

    fn unmount(self) -> i32:
        """Flush dirty FAT sectors and release the block device."""
        ENOSYS

    fn open(self, path: text) -> Result<FileHandle, i32>:
        """Open a root-dir 8.3 file by path (wave-4c, root-dir only).

        Accepts paths of the form "/NAME.EXT". Walks stashed root-dir
        entries to find the matching 8.3 name. Returns ENOENT(-2) if
        not found.
        """
        val entry_result = self._find_root_entry(path)
        if entry_result.is_err():
            return Err(entry_result.unwrap_err())
        val off_opt = entry_result.unwrap()
        if off_opt.is_none():
            return Err(ENOENT)
        val off = off_opt.unwrap()
        val cluster_high = (self.root_dir_data[off + 21].to_u32() << 8) | self.root_dir_data[off + 20].to_u32()
        val cluster_low  = (self.root_dir_data[off + 27].to_u32() << 8) | self.root_dir_data[off + 26].to_u32()
        val start = (cluster_high << 16) | cluster_low
        val fsize = ((self.root_dir_data[off + 31].to_u32() << 24) | (self.root_dir_data[off + 30].to_u32() << 16) |
                     (self.root_dir_data[off + 29].to_u32() << 8)  |  self.root_dir_data[off + 28].to_u32())
        # Record the on-disk location of this directory entry so write() can
        # persist first_cluster and file_size back to disk after each write.
        # root_dir_data is a flat byte array covering sectors_per_cluster sectors
        # starting at LBA = data_start_sector + (root_cluster - 2) * sectors_per_cluster.
        val rc2 = self.root_cluster - 2u32
        val rc2_u64 = rc2.to_u64()
        val spc_u64 = self.sectors_per_cluster.to_u64()
        val root_dir_lba = self.data_start_sector.to_u64() + rc2_u64 * spc_u64
        val bps_i = self.bytes_per_sector.to_i32()
        val d_sector_idx = off / bps_i
        val d_sector_idx_u64 = d_sector_idx.to_u64()
        val d_sector = root_dir_lba + d_sector_idx_u64
        val d_offset = off % bps_i
        Ok(FileHandle(
            fd: 0u64,
            start_cluster: start,
            current_cluster: start,
            offset: 0u64,
            file_size: fsize.to_u64(),
            is_open: true,
            dirent_sector: d_sector,
            dirent_offset: d_offset
        ))

    fn read(self, dev: BlockDevice, h: FileHandle, buf: [u8]) -> Result<u64, i32>:
        """Read up to buf.len() bytes from the file described by h (wave-4c).

        Walks the FAT32 cluster chain via read_cluster_chain(dev,
        h.start_cluster), then reads each cluster's sectors from dev,
        assembling file bytes in chain order.  Truncates at h.file_size
        so the caller never sees cluster padding past the real EOF.

        Updates h.offset. Returns the number of bytes actually copied into buf.
        Returns Ok(0) when already at EOF or buf is empty.
        Returns Err(EIO=-5) on any block-device or chain-walk failure.
        """
        val remaining = h.file_size - h.offset
        var to_read = buf.len().to_u64()
        if remaining < to_read:
            to_read = remaining
        if to_read == 0u64:
            return Ok(0u64)

        # Walk the full chain from the file's start cluster.
        val chain_result = self.read_cluster_chain(dev, h.start_cluster)
        if chain_result.is_err():
            return Err(EIO)
        val chain = chain_result.unwrap()
        if chain.len() == 0:
            return Ok(0u64)

        val cluster_bytes = self.cluster_size.to_u64()
        val spc = self.sectors_per_cluster.to_u64()
        val bps = self.bytes_per_sector.to_u64()

        # Determine which cluster in the chain h.offset falls into,
        # and the byte offset within that cluster.
        var cluster_idx: u64 = h.offset / cluster_bytes
        var byte_in_cluster: u64 = h.offset % cluster_bytes

        var copied: u64 = 0u64
        while copied < to_read and cluster_idx.to_i32() < chain.len():
            val cluster = chain[cluster_idx.to_i32()]
            # Compute the LBA of the first sector of this cluster.
            val first_sector = self.data_start_sector.to_u64() + (cluster - 2u32).to_u64() * spc
            # Within this cluster, start reading from byte_in_cluster.
            var sec_off: u64 = byte_in_cluster / bps
            var byte_in_sec: u64 = byte_in_cluster % bps
            while copied < to_read and sec_off < spc:
                val lba = first_sector + sec_off
                val sec_result = dev.read_sector(lba)
                if sec_result.is_err():
                    return Err(EIO)
                val sec = sec_result.unwrap()
                while copied < to_read and byte_in_sec < bps:
                    buf[copied.to_i32()] = sec[byte_in_sec.to_i32()]
                    copied = copied + 1u64
                    byte_in_sec = byte_in_sec + 1u64
                sec_off = sec_off + 1u64
                byte_in_sec = 0u64
            cluster_idx = cluster_idx + 1u64
            byte_in_cluster = 0u64

        h.offset = h.offset + copied
        Ok(copied)

    fn stat(self, path: text) -> Result<FileStat, i32>:
        """Return metadata for a root-dir 8.3 path (wave-4c).

        Returns ENOENT(-2) if not found.
        """
        val entry_result = self._find_root_entry(path)
        if entry_result.is_err():
            return Err(entry_result.unwrap_err())
        val off_opt = entry_result.unwrap()
        if off_opt.is_none():
            return Err(ENOENT)
        val off = off_opt.unwrap()
        val fsize = ((self.root_dir_data[off + 31].to_u32() << 24) | (self.root_dir_data[off + 30].to_u32() << 16) |
                     (self.root_dir_data[off + 29].to_u32() << 8)  |  self.root_dir_data[off + 28].to_u32())
        Ok(FileStat(
            size: fsize.to_u64(),
            is_dir: false,
            mtime: 0u64
        ))

    fn _find_root_entry(self, path: text) -> Result<i32?, i32>:
        """Walk stashed root_dir_data to find 8.3 entry matching path.

        Returns Ok(Some(byte_offset)) on match, Ok(None) if not found.
        Path must start with '/' followed by an 8.3 name.
        """
        # Strip leading '/'
        var name = path
        if name.len() > 0 and name.slice(0, 1) == "/":
            name = name.slice(1, name.len())
        val off = fat32_dir_find_entry(self.root_dir_data, name)
        if off < 0:
            return Ok(None)
        Ok(Some(off))

    fn _read_dir_data(self, dev: BlockDevice, cluster: u32) -> Result<[u8], i32>:
        """Read a whole directory's bytes by walking its cluster chain.

        Returns Err(EIO=-5) on an invalid start cluster or any device/chain
        failure. The returned array is the concatenation of every cluster in
        chain order, so a byte offset maps back to a cluster via
        offset / cluster_size (see _dir_chain_for below).
        """
        if cluster < 2u32:
            return Err(EIO)
        val chain_result = self.read_cluster_chain(dev, cluster)
        if chain_result.is_err():
            return Err(EIO)
        val chain = chain_result.unwrap()
        val spc = self.sectors_per_cluster.to_u64()
        val bps = self.bytes_per_sector.to_i32()
        var out: [u8] = []
        var ci = 0
        while ci < chain.len():
            val first_sector = self.data_start_sector.to_u64() + (chain[ci] - 2u32).to_u64() * spc
            var s: u64 = 0u64
            while s < spc:
                val r = dev.read_sector(first_sector + s)
                if r.is_err():
                    return Err(EIO)
                val sec = r.unwrap()
                var bi = 0
                while bi < bps:
                    out.push(sec[bi])
                    bi = bi + 1
                s = s + 1u64
            ci = ci + 1
        Ok(out)

    fn resolve_path(self, dev: BlockDevice, path: text) -> Result<Fat32DirEntryLoc, i32>:
        """Resolve a nested absolute path such as "/A/B/C/FILE.O" (wave-4f).

        Walks one component at a time: each non-final component must be a
        directory (ATTR_DIRECTORY), and its first cluster becomes the next
        directory to scan (via _read_dir_data, which follows the cluster
        chain). "." is a no-op; ".." resolves through the on-disk ".." entry,
        whose recorded cluster is 0 when the parent is the root directory —
        that 0 is remapped to self.root_cluster, as FAT32 requires.

        The root directory itself is read from the root_dir_data cache stashed
        at mount() when present, otherwise from the device.

        Returns Err(ENOENT=-2) when any component is missing or a non-final
        component is not a directory; Err(EINVAL=-22) for a path with no
        components (e.g. "/"); Err(EIO=-5) on device failure.
        """
        val parts = fat32_split_path(path)
        if parts.len() == 0:
            return Err(EINVAL)

        var dir_cluster = self.root_cluster
        var dir_chain: [u32] = [self.root_cluster]
        var dir_data = self.root_dir_data
        if dir_data.len() == 0:
            val d = self._read_dir_data(dev, dir_cluster)
            if d.is_err():
                return Err(d.unwrap_err())
            dir_data = d.unwrap()
            val c = self.read_cluster_chain(dev, dir_cluster)
            if c.is_err():
                return Err(EIO)
            dir_chain = c.unwrap()

        val last = parts.len() - 1
        var pi = 0
        while pi <= last:
            val comp = parts[pi]
            if comp == ".":
                pi = pi + 1
                continue
            val off = fat32_dir_find_entry(dir_data, comp)
            if off < 0:
                return Err(ENOENT)
            val attr_bits = dir_data[off + 11].to_u32()
            val is_dir = (attr_bits & FAT32_ATTR_DIRECTORY) != 0u32
            var start = fat32_entry_start_cluster(dir_data, off)
            if pi == last:
                # Map the entry's flat offset back to an absolute LBA using the
                # containing directory's own cluster chain.
                val cluster_bytes = self.cluster_size.to_i32()
                val chain_idx = off / cluster_bytes
                val in_cluster = off % cluster_bytes
                val bps_i = self.bytes_per_sector.to_i32()
                val host_cluster = dir_chain[chain_idx]
                val cluster_lba = self.data_start_sector.to_u64() +
                                  (host_cluster - 2u32).to_u64() * self.sectors_per_cluster.to_u64()
                val d_sector = cluster_lba + (in_cluster / bps_i).to_u64()
                return Ok(Fat32DirEntryLoc(
                    found: true,
                    dir_cluster: dir_cluster,
                    entry_offset: off,
                    dirent_sector: d_sector,
                    dirent_offset: in_cluster % bps_i,
                    start_cluster: start,
                    file_size: fat32_entry_file_size(dir_data, off),
                    is_dir: is_dir
                ))
            # Non-final component: must be a directory we can descend into.
            if not is_dir:
                return Err(ENOENT)
            if start == 0u32:
                start = self.root_cluster      # ".." pointing at the root dir
            val nd = self._read_dir_data(dev, start)
            if nd.is_err():
                return Err(nd.unwrap_err())
            val nc = self.read_cluster_chain(dev, start)
            if nc.is_err():
                return Err(EIO)
            dir_data = nd.unwrap()
            dir_chain = nc.unwrap()
            dir_cluster = start
            pi = pi + 1
        Err(ENOENT)

    fn open_at(self, dev: BlockDevice, path: text) -> Result<FileHandle, i32>:
        """Open a file at a nested path (wave-4f). Directories are rejected
        with ENOENT — use resolve_path/stat_at to inspect them."""
        val loc_result = self.resolve_path(dev, path)
        if loc_result.is_err():
            return Err(loc_result.unwrap_err())
        val loc = loc_result.unwrap()
        if loc.is_dir:
            return Err(ENOENT)
        Ok(FileHandle(
            fd: 0u64,
            start_cluster: loc.start_cluster,
            current_cluster: loc.start_cluster,
            offset: 0u64,
            file_size: loc.file_size.to_u64(),
            is_open: true,
            dirent_sector: loc.dirent_sector,
            dirent_offset: loc.dirent_offset
        ))

    fn stat_at(self, dev: BlockDevice, path: text) -> Result<FileStat, i32>:
        """Metadata for a nested path (wave-4f). Unlike stat(), is_dir is real."""
        val loc_result = self.resolve_path(dev, path)
        if loc_result.is_err():
            return Err(loc_result.unwrap_err())
        val loc = loc_result.unwrap()
        Ok(FileStat(
            size: loc.file_size.to_u64(),
            is_dir: loc.is_dir,
            mtime: 0u64
        ))

    fn _read_fat_entry(self, dev: BlockDevice, cluster: u32) -> Result<u32, text>:
        """Read the 28-bit FAT32 entry for cluster from the FAT region on dev."""
        val fat_offset = cluster * 4u32
        val fat_sector = self.fat_start_sector.to_u64() + (fat_offset / self.bytes_per_sector).to_u64()
        val entry_off  = (fat_offset % self.bytes_per_sector).to_i32()
        val sec_result = dev.read_sector(fat_sector)
        if sec_result.is_err():
            return Err("fat32: failed to read FAT sector for cluster {cluster}")
        val sec = sec_result.unwrap()
        val raw = ((sec[entry_off + 3].to_u32() << 24) |
                   (sec[entry_off + 2].to_u32() << 16) |
                   (sec[entry_off + 1].to_u32() << 8)  |
                    sec[entry_off].to_u32()) & 0x0FFFFFFFu32
        Ok(raw)

    fn read_cluster_chain(self, dev: BlockDevice, start: u32) -> Result<[u32], text>:
        """Walk FAT chain from start cluster; return ordered cluster list.

        Collects data cluster numbers until EOC (FAT entry >= 0x0FFFFFF8).
        Returns Err on:
          - start cluster < 2 (invalid)
          - FREE (0x00000000) or BAD (0x0FFFFFF7) FAT entry mid-chain
          - fuel exhaustion (> data_clusters steps) — cycle/corruption guard

        Mirrors chainWalkGuarded in src/verification/fat32/Fat32/Basic.lean.
        Fuel = self.data_clusters; a valid chain cannot exceed this count.
        """
        if start < 2u32:
            return Err("fat32: invalid start cluster {start}")
        var chain: [u32] = []
        var current = start
        var fuel = self.data_clusters
        while current >= 2u32:
            # Cycle / length guard — checked before consuming the current cluster
            if fuel == 0u32:
                return Err("fat32: cluster chain exceeds volume cluster count (cycle?)")
            fuel = fuel - 1u32
            # Append current data cluster
            chain.push(current)
            # Read FAT entry for current cluster to find next
            val next_result = self._read_fat_entry(dev, current)
            if next_result.is_err():
                return next_result
            val next = next_result.unwrap()
            # EOC: >= 0x0FFFFFF8 — current was the last data cluster
            if next >= 0x0FFFFFF8u32:
                return Ok(chain)
            # BAD cluster marker mid-chain — corruption
            if next == 0x0FFFFFF7u32:
                return Err("fat32: bad-cluster marker in chain from {start}")
            # FREE cluster mid-chain — corruption
            if next == 0x00000000u32:
                return Err("fat32: free-cluster entry mid-chain from {start}")
            # Valid next cluster; continue walk
            current = next
        Ok(chain)

    fn _write_fat_entry(self, dev: BlockDevice, cluster: u32, value: u32) -> Result<(), text>:
        """Write a 28-bit FAT32 entry for cluster to the FAT region on dev.

        Preserves the top 4 reserved bits of the existing on-disk word.
        value must already be a 28-bit quantity (top 4 bits ignored).
        """
        val fat_offset = cluster * 4u32
        val fat_sector = self.fat_start_sector.to_u64() + (fat_offset / self.bytes_per_sector).to_u64()
        val entry_off  = (fat_offset % self.bytes_per_sector).to_i32()
        # Read the current sector so we can preserve the top 4 reserved bits.
        val sec_result = dev.read_sector(fat_sector)
        if sec_result.is_err():
            return Err("fat32: failed to read FAT sector for write to cluster {cluster}")
        var sec = sec_result.unwrap()
        # Preserve bits 28-31 of the existing entry; replace bits 0-27 with value.
        val existing_top = sec[entry_off + 3].to_u32() & 0xF0u32
        val masked = value & 0x0FFFFFFFu32
        sec[entry_off]     = (masked & 0xFFu32).to_u8()
        sec[entry_off + 1] = ((masked >> 8u32)  & 0xFFu32).to_u8()
        sec[entry_off + 2] = ((masked >> 16u32) & 0xFFu32).to_u8()
        sec[entry_off + 3] = (existing_top | ((masked >> 24u32) & 0x0Fu32)).to_u8()
        val wr = dev.write_sector(fat_sector, sec)
        if wr.is_err():
            return Err("fat32: failed to write FAT sector for cluster {cluster}")
        Ok(())

    fn allocate_cluster(self, dev: BlockDevice) -> Result<u32, i32>:
        """Scan FAT for a FREE entry starting at cluster 2; mark it EOC and return it.

        crossLinkFree ordering: marks the new cluster EOC before the caller
        links any predecessor to it, so no FREE cluster is ever linked.
        Returns Err(ENOSPC=-28) when no free cluster exists.
        Scan is bounded by data_clusters (no unbounded loops).
        """
        var candidate: u32 = 2u32
        var limit = self.data_clusters
        while limit > 0u32:
            val entry_result = self._read_fat_entry(dev, candidate)
            if entry_result.is_err():
                return Err(EIO)
            val entry = entry_result.unwrap()
            if entry == 0x00000000u32:
                # Found a FREE cluster — mark it EOC before returning.
                val wr = self._write_fat_entry(dev, candidate, 0x0FFFFFFFu32)
                if wr.is_err():
                    return Err(EIO)
                return Ok(candidate)
            candidate = candidate + 1u32
            limit = limit - 1u32
        Err(ENOSPC)

    fn append_cluster(self, dev: BlockDevice, chain_end: u32, new_cluster: u32) -> Result<(), i32>:
        """Link chain_end -> new_cluster in the FAT.

        crossLinkFree ORDERING CONTRACT:
          new_cluster must already be marked EOC (done by allocate_cluster) before
          this function is called.  We then overwrite chain_end's FAT entry to
          point at new_cluster.  At no point does a FREE cluster appear mid-chain.
        """
        val wr = self._write_fat_entry(dev, chain_end, new_cluster)
        if wr.is_err():
            return Err(EIO)
        Ok(())

    fn _update_dirent(self, dev: BlockDevice, h: FileHandle) -> Result<(), i32>:
        """Persist first_cluster and file_size into the on-disk directory entry.

        Reads the 512-byte sector at h.dirent_sector, patches the 32-byte entry
        at byte h.dirent_offset:
          bytes +20..+21  cluster_high (bits 16-31 of start_cluster)
          bytes +26..+27  cluster_low  (bits  0-15 of start_cluster)
          bytes +28..+31  file_size    (u32 little-endian)
        then writes the sector back.

        Also updates self.root_dir_data cache at the corresponding flat offset
        so that stat() and subsequent open() calls see the new values without
        requiring a remount.

        Does nothing (returns Ok) when h.dirent_sector == 0 (handles created
        without a backing directory entry, e.g. test helpers).
        """
        if h.dirent_sector == 0u64:
            return Ok(())
        val sec_result = dev.read_sector(h.dirent_sector)
        if sec_result.is_err():
            return Err(EIO)
        var sec = sec_result.unwrap()
        val do_ = h.dirent_offset
        val cl_high = (h.start_cluster >> 16u32) & 0xFFFFu32
        val cl_low  = h.start_cluster & 0xFFFFu32
        val fsz     = h.file_size.to_u32()
        # cluster_high bytes (offsets +20, +21 within the 32-byte entry)
        sec[do_ + 20] = (cl_high & 0xFFu32).to_u8()
        sec[do_ + 21] = ((cl_high >> 8u32) & 0xFFu32).to_u8()
        # cluster_low bytes (offsets +26, +27)
        sec[do_ + 26] = (cl_low & 0xFFu32).to_u8()
        sec[do_ + 27] = ((cl_low >> 8u32) & 0xFFu32).to_u8()
        # file_size u32 little-endian (offsets +28..+31)
        sec[do_ + 28] = (fsz & 0xFFu32).to_u8()
        sec[do_ + 29] = ((fsz >> 8u32)  & 0xFFu32).to_u8()
        sec[do_ + 30] = ((fsz >> 16u32) & 0xFFu32).to_u8()
        sec[do_ + 31] = ((fsz >> 24u32) & 0xFFu32).to_u8()
        val wr = dev.write_sector(h.dirent_sector, sec)
        if wr.is_err():
            return Err(EIO)
        # Keep root_dir_data cache coherent.
        # root_dir_data is laid out as contiguous sectors starting at
        # LBA = data_start_sector + (root_cluster - 2) * sectors_per_cluster.
        # h.dirent_sector is one of those LBAs; the flat cache offset is:
        #   (h.dirent_sector - root_dir_lba) * bytes_per_sector + h.dirent_offset
        #
        # GUARD (wave-4g): only sectors that really belong to the cached root
        # cluster may be patched.  Before this guard the subtraction below was
        # unconditional, so a dirent in ANY subdirectory produced a nonsense
        # (often wrapped) cache_base that could land inside root_dir_data and
        # silently corrupt an unrelated ROOT entry.  Nested writes hit this on
        # the first call.  root_dir_data holds exactly the FIRST cluster of the
        # root directory (see mount()), i.e. sectors_per_cluster sectors
        # starting at root_dir_lba.
        val root_dir_lba = self.data_start_sector.to_u64() + (self.root_cluster - 2u32).to_u64() * self.sectors_per_cluster.to_u64()
        if h.dirent_sector < root_dir_lba:
            return Ok(())
        if h.dirent_sector >= root_dir_lba + self.sectors_per_cluster.to_u64():
            return Ok(())
        val cache_base = ((h.dirent_sector - root_dir_lba) * self.bytes_per_sector.to_u64()).to_i32() + h.dirent_offset
        if cache_base >= 0 and (cache_base + 31) < self.root_dir_data.len():
            self.root_dir_data[cache_base + 20] = sec[do_ + 20]
            self.root_dir_data[cache_base + 21] = sec[do_ + 21]
            self.root_dir_data[cache_base + 26] = sec[do_ + 26]
            self.root_dir_data[cache_base + 27] = sec[do_ + 27]
            self.root_dir_data[cache_base + 28] = sec[do_ + 28]
            self.root_dir_data[cache_base + 29] = sec[do_ + 29]
            self.root_dir_data[cache_base + 30] = sec[do_ + 30]
            self.root_dir_data[cache_base + 31] = sec[do_ + 31]
        Ok(())

    fn _write_locked(self, dev: BlockDevice, h: FileHandle, buf: [u8]) -> Result<FileHandle, i32>:
        """Write buf to the file described by h (wave-4d).

        Allocates clusters as needed (extending the chain on each cluster
        boundary).  Writes data via dev.write_sector.

        Returns Ok(updated_handle) where updated_handle.file_size reflects bytes
        written, and updated_handle.start_cluster is set for fresh files.
        Returns Err(ENOSPC=-28) when no free clusters remain.
        Returns Err(EIO=-5) on any block-device failure.

        FileHandle is a value type in Simple: callers must use the returned
        handle to observe updated start_cluster and file_size.

        Persists first_cluster and file_size to the on-disk directory entry via
        _update_dirent when h.dirent_sector > 0.  The root_dir_data cache is
        updated in the same call so stat() and open() remain coherent without
        a remount.
        """
        val n = buf.len().to_u64()
        if n == 0u64:
            return Ok(h)

        val bps = self.bytes_per_sector.to_u64()
        val spc = self.sectors_per_cluster.to_u64()
        val cluster_bytes = self.cluster_size.to_u64()

        # Walk or build the cluster chain.
        # If h.start_cluster < 2 the file has no cluster yet — allocate first.
        var chain_tail: u32 = 0u32
        var file_clusters: u64 = 0u64

        if h.start_cluster < 2u32:
            # Fresh file: allocate the first cluster and set start_cluster.
            val nc_result = self.allocate_cluster(dev)
            if nc_result.is_err():
                return Err(nc_result.unwrap_err())
            h.start_cluster = nc_result.unwrap()
            h.current_cluster = h.start_cluster
            chain_tail = h.start_cluster
            file_clusters = 1u64
        else:
            # Existing file: walk the chain to find its tail and length.
            val chain_result = self.read_cluster_chain(dev, h.start_cluster)
            if chain_result.is_err():
                return Err(EIO)
            val chain = chain_result.unwrap()
            if chain.len() == 0:
                return Err(EIO)
            chain_tail = chain[chain.len() - 1]
            file_clusters = chain.len().to_u64()

        # Extend chain until allocated space covers current file + new bytes.
        val bytes_needed = h.file_size + n
        var allocated_bytes = file_clusters * cluster_bytes
        while allocated_bytes < bytes_needed:
            val nc_result = self.allocate_cluster(dev)
            if nc_result.is_err():
                return Err(nc_result.unwrap_err())
            val nc = nc_result.unwrap()
            # append_cluster: new cluster already marked EOC by allocate_cluster
            val ap_result = self.append_cluster(dev, chain_tail, nc)
            if ap_result.is_err():
                return Err(ap_result.unwrap_err())
            chain_tail = nc
            file_clusters = file_clusters + 1u64
            allocated_bytes = file_clusters * cluster_bytes

        # Re-walk chain to get the full ordered list for sector computation.
        val full_chain_result = self.read_cluster_chain(dev, h.start_cluster)
        if full_chain_result.is_err():
            return Err(EIO)
        val full_chain = full_chain_result.unwrap()

        # Write buf into the chain starting at h.file_size (append-only).
        var written: u64 = 0u64
        var write_offset: u64 = h.file_size
        while written < n:
            val cluster_idx = (write_offset / cluster_bytes).to_i32()
            val byte_in_cluster = write_offset % cluster_bytes
            if cluster_idx >= full_chain.len():
                return Err(EIO)
            val cluster = full_chain[cluster_idx]
            val first_sector = self.data_start_sector.to_u64() + (cluster - 2u32).to_u64() * spc
            var sec_off: u64 = byte_in_cluster / bps
            var byte_in_sec: u64 = byte_in_cluster % bps
            while written < n and sec_off < spc:
                val lba = first_sector + sec_off
                # Read-modify-write: read existing sector, overlay our bytes.
                val sec_result = dev.read_sector(lba)
                if sec_result.is_err():
                    return Err(EIO)
                var sec = sec_result.unwrap()
                while written < n and byte_in_sec < bps:
                    sec[byte_in_sec.to_i32()] = buf[written.to_i32()]
                    written = written + 1u64
                    write_offset = write_offset + 1u64
                    byte_in_sec = byte_in_sec + 1u64
                val wr = dev.write_sector(lba, sec)
                if wr.is_err():
                    return Err(EIO)
                sec_off = sec_off + 1u64
                byte_in_sec = 0u64

        h.file_size = h.file_size + written
        # Persist first_cluster + file_size to the on-disk directory entry.
        val upd = self._update_dirent(dev, h)
        if upd.is_err():
            return Err(upd.unwrap_err())
        Ok(h)

    # -- Directory WRITE path (wave-4g) ----------------------------------------
    #
    # Everything below exists so that ordinary host-shaped paths can be
    # CREATED, not merely read: `mkdir_at("/usr/bin")` then
    # `create_at("/usr/bin/clang")`. The parent directory is always located by
    # the existing read-path resolver (resolve_path) — there is deliberately no
    # second path walker in this file.

    fn _dir_chain(self, dev: BlockDevice, cluster: u32) -> Result<[u32], i32>:
        """Cluster chain of a directory, with the chain-walker's text error
        collapsed to EIO so callers stay in the i32 error domain."""
        val c = self.read_cluster_chain(dev, cluster)
        if c.is_err():
            return Err(EIO)
        Ok(c.unwrap())

    fn _dirent_addr(self, chain: [u32], flat_off: i32) -> Fat32SlotAddr:
        """Map a directory-relative flat byte offset to an absolute (LBA, offset).

        Same arithmetic resolve_path uses to fill Fat32DirEntryLoc, kept in one
        place so the read and write sides cannot drift apart.
        """
        val cluster_bytes = self.cluster_size.to_i32()
        val bps = self.bytes_per_sector.to_i32()
        val ci = flat_off / cluster_bytes
        val in_c = flat_off % cluster_bytes
        val cl = chain[ci]
        val lba = self.data_start_sector.to_u64() +
                  (cl - 2u32).to_u64() * self.sectors_per_cluster.to_u64() +
                  (in_c / bps).to_u64()
        Fat32SlotAddr(sector: lba, offset: in_c % bps)

    fn _write_dir_bytes(self, dev: BlockDevice, chain: [u32], flat_off: i32, bytes: [u8]) -> Result<(), i32>:
        """Read-modify-write `bytes` into a directory at flat offset `flat_off`.

        Walks sector by sector so a run of entries may straddle both sector and
        cluster boundaries.
        """
        val bps = self.bytes_per_sector.to_i32()
        val cluster_bytes = self.cluster_size.to_i32()
        var i = 0
        while i < bytes.len():
            val fo = flat_off + i
            if (fo / cluster_bytes) >= chain.len():
                return Err(EIO)
            val addr = self._dirent_addr(chain, fo)
            val r = dev.read_sector(addr.sector)
            if r.is_err():
                return Err(EIO)
            var sec = r.unwrap()
            var so = addr.offset
            while i < bytes.len() and so < bps:
                sec[so] = bytes[i]
                i = i + 1
                so = so + 1
            val w = dev.write_sector(addr.sector, sec)
            if w.is_err():
                return Err(EIO)
        Ok(())

    fn _zero_cluster(self, dev: BlockDevice, cluster: u32) -> Result<(), i32>:
        """Fill every sector of `cluster` with 0x00.

        For a directory cluster the all-zero content IS the end-of-directory
        marker, so this must happen BEFORE the cluster is linked into any
        chain — otherwise a concurrent reader walks stale bytes and sees
        garbage entries past the real end.
        """
        val spc = self.sectors_per_cluster.to_u64()
        val bps = self.bytes_per_sector.to_i32()
        var zero: [u8] = []
        var i = 0
        while i < bps:
            zero.push(0u8)
            i = i + 1
        val first = self.data_start_sector.to_u64() + (cluster - 2u32).to_u64() * spc
        var s: u64 = 0u64
        while s < spc:
            val w = dev.write_sector(first + s, zero)
            if w.is_err():
                return Err(EIO)
            s = s + 1u64
        Ok(())

    fn _refresh_root_cache(self, dev: BlockDevice) -> Result<(), i32>:
        """Re-read the cached first cluster of the root directory from disk.

        resolve_path() prefers root_dir_data when it is non-empty, so any write
        that touches the root directory must refresh it or the very next lookup
        answers from a stale in-memory copy.
        """
        val spc = self.sectors_per_cluster.to_i32()
        val bps = self.bytes_per_sector.to_i32()
        val root_lba = self.data_start_sector.to_u64() +
                       (self.root_cluster - 2u32).to_u64() * self.sectors_per_cluster.to_u64()
        var out: [u8] = []
        var s = 0
        while s < spc:
            val r = dev.read_sector(root_lba + s.to_u64())
            if r.is_err():
                return Err(EIO)
            val sec = r.unwrap()
            var bi = 0
            while bi < bps:
                out.push(sec[bi])
                bi = bi + 1
            s = s + 1
        self.root_dir_data = out
        Ok(())

    fn _alloc_dirent_slots(self, dev: BlockDevice, dir_cluster: u32, count: i32) -> Result<i32, i32>:
        """Reserve `count` CONSECUTIVE free 32-byte slots in a directory.

        A slot is free when its first byte is 0x00 (never used — and therefore
        the end-of-directory marker) or 0xE5 (deleted). An LFN chain plus its
        8.3 alias must be contiguous, which is why the run has to be
        consecutive rather than merely available.

        END-OF-DIRECTORY handling: once the scan reaches the 0x00 terminator
        every remaining slot in the ALLOCATED data is also 0x00, so the run
        naturally extends to the end of the directory's clusters — but no
        further. When the run is too short the directory is grown by a fresh
        cluster which is zeroed BEFORE being linked, so the terminator is still
        present immediately after whatever we go on to write.
        """
        if count <= 0:
            return Err(EINVAL)
        var attempts = 0
        while attempts < 8:
            val d = self._read_dir_data(dev, dir_cluster)
            if d.is_err():
                return Err(d.unwrap_err())
            val dd = d.unwrap()
            val total = dd.len() / 32
            var run = 0
            var run_start = -1
            var idx = 0
            while idx < total:
                val off = idx * 32
                val fb = dd[off]
                if fb == 0x00u8 or fb == 0xE5u8:
                    if run == 0:
                        run_start = off
                    run = run + 1
                    if run >= count:
                        return Ok(run_start)
                else:
                    run = 0
                    run_start = -1
                idx = idx + 1
            # Not enough contiguous room — grow the directory by one cluster.
            val ch = self._dir_chain(dev, dir_cluster)
            if ch.is_err():
                return Err(ch.unwrap_err())
            val chain = ch.unwrap()
            if chain.len() == 0:
                return Err(EIO)
            val nc_r = self.allocate_cluster(dev)
            if nc_r.is_err():
                return Err(nc_r.unwrap_err())
            val nc = nc_r.unwrap()
            val z = self._zero_cluster(dev, nc)
            if z.is_err():
                return Err(z.unwrap_err())
            val ap = self.append_cluster(dev, chain[chain.len() - 1], nc)
            if ap.is_err():
                return Err(ap.unwrap_err())
            attempts = attempts + 1
        Err(ENOSPC)

    fn _link_entry(self, dev: BlockDevice, dir_cluster: u32, name: text, attr: u8, cluster: u32, size: u32) -> Result<Fat32SlotAddr, i32>:
        """Create one named entry in `dir_cluster`, emitting an LFN chain when
        the name cannot survive as a bare 8.3 short name.

        Returns the on-disk address of the 8.3 entry (NOT the first LFN slot),
        which is what FileHandle.dirent_sector/_offset must point at so that
        _update_dirent persists size and first-cluster to the right place.

        Err(EEXIST=-17) when the name already exists in the directory.
        """
        val d0 = self._read_dir_data(dev, dir_cluster)
        if d0.is_err():
            return Err(d0.unwrap_err())
        val dir_data = d0.unwrap()
        if fat32_dir_find_entry(dir_data, name) >= 0:
            return Err(EEXIST)

        var field = fat32_blank_field()
        var nslots = 0
        if fat32_name_needs_lfn(name):
            # ~1 / ~2 collision numbering: probe the directory with the READ
            # path's own matcher, so "already taken" means exactly what a
            # subsequent lookup would find.
            var seq = 1
            var picked = false
            while seq <= 999 and not picked:
                val cand = fat32_gen_short_field(name, seq)
                if fat32_dir_find_entry(dir_data, fat32_short_field_to_text(cand)) < 0:
                    field = cand
                    picked = true
                seq = seq + 1
            if not picked:
                return Err(ENOSPC)
            nslots = fat32_lfn_slot_count(name)
        else:
            field = fat32_short_field(name)
            nslots = 0

        val total_slots = nslots + 1
        val fo_r = self._alloc_dirent_slots(dev, dir_cluster, total_slots)
        if fo_r.is_err():
            return Err(fo_r.unwrap_err())
        val flat_off = fo_r.unwrap()
        val ch_r = self._dir_chain(dev, dir_cluster)
        if ch_r.is_err():
            return Err(ch_r.unwrap_err())
        val chain = ch_r.unwrap()

        # LFN slots are stored highest-sequence FIRST, which is the order the
        # read side (fat32_dir_find_entry) prepends fragments in.
        val csum = fat32_lfn_checksum(field)
        var bytes: [u8] = []
        var si = nslots
        while si >= 1:
            val slot = fat32_make_lfn_slot(name, si, nslots, csum)
            var bi = 0
            while bi < 32:
                bytes.push(slot[bi])
                bi = bi + 1
            si = si - 1
        val ent = fat32_make_dirent(field, attr, cluster, size)
        var ei = 0
        while ei < 32:
            bytes.push(ent[ei])
            ei = ei + 1

        val wr = self._write_dir_bytes(dev, chain, flat_off, bytes)
        if wr.is_err():
            return Err(wr.unwrap_err())
        val addr = self._dirent_addr(chain, flat_off + nslots * 32)
        if dir_cluster == self.root_cluster:
            val rc = self._refresh_root_cache(dev)
            if rc.is_err():
                return Err(rc.unwrap_err())
        Ok(addr)

    fn _parent_dir_cluster(self, dev: BlockDevice, path: text) -> Result<u32, i32>:
        """First cluster of the directory that should CONTAIN `path`.

        Single-component paths live in the root directory; anything deeper is
        located with resolve_path() on the parent prefix.
        """
        val parts = fat32_split_path(path)
        if parts.len() == 0:
            return Err(EINVAL)
        if parts.len() == 1:
            return Ok(self.root_cluster)
        var parent = ""
        var i = 0
        while i < parts.len() - 1:
            parent = parent + "/" + parts[i]
            i = i + 1
        val loc_r = self.resolve_path(dev, parent)
        if loc_r.is_err():
            return Err(loc_r.unwrap_err())
        val loc = loc_r.unwrap()
        if not loc.is_dir:
            return Err(ENOTDIR)
        var c = loc.start_cluster
        if c == 0u32:
            c = self.root_cluster        # ".."-style 0 means the root dir
        Ok(c)

    fn _create_at_locked(self, dev: BlockDevice, path: text) -> Result<FileHandle, i32>:
        """Create an empty file at a nested path and return a writable handle.

        The handle carries the address of the freshly written directory entry,
        so the existing write() persists first-cluster and size into it with no
        extra plumbing. The file starts with NO cluster allocated (start_cluster
        0), exactly as a real empty FAT32 file does.
        """
        val parts = fat32_split_path(path)
        if parts.len() == 0:
            return Err(EINVAL)
        val name = parts[parts.len() - 1]
        if name == "." or name == "..":
            return Err(EINVAL)
        val pd = self._parent_dir_cluster(dev, path)
        if pd.is_err():
            return Err(pd.unwrap_err())
        val addr_r = self._link_entry(dev, pd.unwrap(), name, FAT32_ATTR_ARCHIVE, 0u32, 0u32)
        if addr_r.is_err():
            return Err(addr_r.unwrap_err())
        val addr = addr_r.unwrap()
        Ok(FileHandle(
            fd: 0u64,
            start_cluster: 0u32,
            current_cluster: 0u32,
            offset: 0u64,
            file_size: 0u64,
            is_open: true,
            dirent_sector: addr.sector,
            dirent_offset: addr.offset
        ))

    fn _mkdir_at_locked(self, dev: BlockDevice, path: text) -> Result<(), i32>:
        """Create a directory at a nested path.

        Order of operations matters: the new cluster is allocated, zeroed, and
        populated with its "." / ".." entries BEFORE it is linked into the
        parent, so the directory is never briefly visible while empty of its
        dot entries. Per FAT32, ".." records 0 — not the real cluster number —
        when the parent is the root directory.
        """
        val parts = fat32_split_path(path)
        if parts.len() == 0:
            return Err(EINVAL)
        val name = parts[parts.len() - 1]
        if name == "." or name == "..":
            return Err(EINVAL)
        val pd = self._parent_dir_cluster(dev, path)
        if pd.is_err():
            return Err(pd.unwrap_err())
        val dir_cluster = pd.unwrap()

        # Check for a duplicate BEFORE allocating, so a rejected mkdir does not
        # leak a cluster.
        val d0 = self._read_dir_data(dev, dir_cluster)
        if d0.is_err():
            return Err(d0.unwrap_err())
        if fat32_dir_find_entry(d0.unwrap(), name) >= 0:
            return Err(EEXIST)

        val nc_r = self.allocate_cluster(dev)
        if nc_r.is_err():
            return Err(nc_r.unwrap_err())
        val nc = nc_r.unwrap()
        val z = self._zero_cluster(dev, nc)
        if z.is_err():
            return Err(z.unwrap_err())

        var parent_link = dir_cluster
        if dir_cluster == self.root_cluster:
            parent_link = 0u32
        var dots: [u8] = []
        val e_dot = fat32_make_dirent(fat32_short_field("."), FAT32_ATTR_DIR_BYTE, nc, 0u32)
        var i = 0
        while i < 32:
            dots.push(e_dot[i])
            i = i + 1
        val e_dotdot = fat32_make_dirent(fat32_short_field(".."), FAT32_ATTR_DIR_BYTE, parent_link, 0u32)
        var j = 0
        while j < 32:
            dots.push(e_dotdot[j])
            j = j + 1
        var self_chain: [u32] = [nc]
        val wd = self._write_dir_bytes(dev, self_chain, 0, dots)
        if wd.is_err():
            return Err(wd.unwrap_err())

        val addr_r = self._link_entry(dev, dir_cluster, name, FAT32_ATTR_DIR_BYTE, nc, 0u32)
        if addr_r.is_err():
            return Err(addr_r.unwrap_err())
        Ok(())

    fn _flush_locked(self, dev: BlockDevice, h: FileHandle) -> Result<(), i32>:
        """Persist a handle's first-cluster and size into its directory entry.

        write() already does this on every call; flush() exists so a caller
        that mutated a handle out of band (or wants an explicit durability
        point before close) can force the write-back rather than being told
        ENOSYS and having to guess.
        """
        self._update_dirent(dev, h)

    fn close(self, fd: u64) -> i32:
        """Close — wave-4d."""
        val _fd = fd
        ENOSYS

    fn readdir_at(self, dev: BlockDevice, path: text) -> Result<[text], i32>:
        """List every live entry name in the directory at `path` ("/" for
        root). Reuses resolve_path for nested directories and the stashed
        root cluster for "/" itself (resolve_path only walks named
        components, so it cannot resolve the root)."""
        var cluster = self.root_cluster
        if path != "/" and path.len() > 0:
            val loc_r = self.resolve_path(dev, path)
            if loc_r.is_err():
                return Err(loc_r.unwrap_err())
            val loc = loc_r.unwrap()
            if not loc.is_dir:
                return Err(ENOTDIR)
            cluster = loc.start_cluster
        val data_r = self._read_dir_data(dev, cluster)
        if data_r.is_err():
            return Err(data_r.unwrap_err())
        Ok(fat32_dir_list_entries(data_r.unwrap()))

    fn _mark_dirent_deleted(self, dev: BlockDevice, sector: u64, offset: i32) -> Result<(), i32>:
        """Write the 0xE5 deleted-entry marker into byte 0 of a 32-byte dirent
        and keep the stashed root_dir_data cache coherent — same cache-sync
        guard as _update_dirent, so a delete on a cached root entry is visible
        to a subsequent stat()/readdir_at() without a remount."""
        val sec_result = dev.read_sector(sector)
        if sec_result.is_err():
            return Err(EIO)
        var sec = sec_result.unwrap()
        sec[offset] = 0xE5u8
        val wr = dev.write_sector(sector, sec)
        if wr.is_err():
            return Err(EIO)
        val root_dir_lba = self.data_start_sector.to_u64() + (self.root_cluster - 2u32).to_u64() * self.sectors_per_cluster.to_u64()
        if sector < root_dir_lba:
            return Ok(())
        if sector >= root_dir_lba + self.sectors_per_cluster.to_u64():
            return Ok(())
        val cache_base = ((sector - root_dir_lba) * self.bytes_per_sector.to_u64()).to_i32() + offset
        if cache_base >= 0 and cache_base < self.root_dir_data.len():
            self.root_dir_data[cache_base] = 0xE5u8
        Ok(())

    fn _unlink_dirent_chain(self, dev: BlockDevice, loc: Fat32DirEntryLoc) -> Result<(), i32>:
        """Mark a located entry deleted INCLUDING every LFN slot that precedes
        its 8.3 alias.

        `_mark_dirent_deleted` alone only clears the alias, which leaves the
        LFN slots live on disk. That is not a cosmetic leak: `_alloc_dirent_slots`
        treats the single freed alias slot as a reusable run of 1, so the very
        next entry written there is preceded by the DELETED name's LFN chain —
        and both readers (`fat32_dir_find_entry` / `fat32_dir_list_entries`)
        accumulate LFN fragments straight into the following 8.3 entry. The new
        file is then listed under the deleted file's long name (or under the two
        names concatenated, when the new name carries LFN slots of its own), and
        the deleted path stays resolvable. Neither reader validates the LFN
        checksum byte against the alias, which is why this driver is corrupted
        by orphan slots where a checksum-checking implementation would merely
        ignore them.

        Walks backward from the alias while the preceding slot is a live LFN
        slot. The stop condition tests byte 0 for 0x00/0xE5 BEFORE the 0x0F
        attribute, because a deleted LFN slot keeps attr 0x0F — only its first
        byte changes — so an attr-only test would run on into an older,
        already-deleted entry's slots.

        Order is LFN-slots-first, alias last: a crash midway then leaves the
        entry reachable under its bare 8.3 short name with no orphan slots,
        which is strictly safer than the reverse.
        """
        val ch_r = self._dir_chain(dev, loc.dir_cluster)
        if ch_r.is_err():
            return Err(ch_r.unwrap_err())
        val chain = ch_r.unwrap()
        val d_r = self._read_dir_data(dev, loc.dir_cluster)
        if d_r.is_err():
            return Err(d_r.unwrap_err())
        val dd = d_r.unwrap()
        var flat = loc.entry_offset - 32
        var walking = true
        while walking and flat >= 0:
            if flat + 11 >= dd.len():
                walking = false
            else:
                val fb = dd[flat]
                if fb == 0x00u8 or fb == 0xE5u8 or dd[flat + 11] != 0x0Fu8:
                    walking = false
                else:
                    val a = self._dirent_addr(chain, flat)
                    val mr = self._mark_dirent_deleted(dev, a.sector, a.offset)
                    if mr.is_err():
                        return Err(mr.unwrap_err())
                    flat = flat - 32
        self._mark_dirent_deleted(dev, loc.dirent_sector, loc.dirent_offset)

    fn _unlink_at_locked(self, dev: BlockDevice, path: text) -> Result<(), i32>:
        """Remove a file: free its whole cluster chain in the FAT, then mark
        its directory entry deleted. Refuses a directory (EISDIR) — use
        rmdir_at for those."""
        val loc_r = self.resolve_path(dev, path)
        if loc_r.is_err():
            return Err(loc_r.unwrap_err())
        val loc = loc_r.unwrap()
        if loc.is_dir:
            return Err(EISDIR)
        if loc.start_cluster >= 2u32:
            val chain_r = self.read_cluster_chain(dev, loc.start_cluster)
            if chain_r.is_err():
                return Err(EIO)
            var chain = chain_r.unwrap()
            var ci = 0
            while ci < chain.len():
                val fr = self._write_fat_entry(dev, chain[ci], 0u32)
                if fr.is_err():
                    return Err(EIO)
                ci = ci + 1
        self._unlink_dirent_chain(dev, loc)

    fn _rmdir_at_locked(self, dev: BlockDevice, path: text) -> Result<(), i32>:
        """Remove a directory. Refuses ENOTDIR on a file and ENOTEMPTY unless
        the directory holds only "." and "..". Frees the directory's own
        cluster chain (its content clusters, not its parent's) before marking
        the dirent deleted."""
        val loc_r = self.resolve_path(dev, path)
        if loc_r.is_err():
            return Err(loc_r.unwrap_err())
        val loc = loc_r.unwrap()
        if not loc.is_dir:
            return Err(ENOTDIR)
        val data_r = self._read_dir_data(dev, loc.start_cluster)
        if data_r.is_err():
            return Err(data_r.unwrap_err())
        val names = fat32_dir_list_entries(data_r.unwrap())
        var ni = 0
        while ni < names.len():
            if names[ni] != "." and names[ni] != "..":
                return Err(ENOTEMPTY)
            ni = ni + 1
        if loc.start_cluster >= 2u32:
            val chain_r = self.read_cluster_chain(dev, loc.start_cluster)
            if chain_r.is_err():
                return Err(EIO)
            var chain = chain_r.unwrap()
            var ci = 0
            while ci < chain.len():
                val fr = self._write_fat_entry(dev, chain[ci], 0u32)
                if fr.is_err():
                    return Err(EIO)
                ci = ci + 1
        self._unlink_dirent_chain(dev, loc)

    fn _rename_at_locked(self, dev: BlockDevice, old_path: text, new_path: text) -> Result<(), i32>:
        """Rename/move a file or directory (real FAT32 primitive, not
        create+delete of the DATA — see honesty note below).

        Implemented as link-new-entry, then delete-old-entry, reusing the
        same tested `_link_entry` (LFN chain + 8.3 alias + checksum
        generation, collision-numbered short names) and `_mark_dirent_deleted`
        primitives `create_at`/`mkdir_at`/`unlink_at` already rely on.
        Hand-rolling an in-place rewrite of a directory entry's name field(s)
        was considered and rejected: an LFN name occupies a variable number of
        32-byte slots (`fat32_lfn_slot_count`) plus a checksum byte derived
        from the 8.3 short name, so renaming to a name needing a different
        slot count cannot be a same-size in-place patch — it would still have
        to free/relink slots, at which point it is not meaningfully more
        atomic than the two-step approach below, just less tested.

        ATOMICITY, HONESTLY (this is not a single-sector atomic operation):
          - The file's DATA is never touched or copied. `_link_entry` copies
            only the existing `start_cluster`/`file_size` into the new
            directory entry; no cluster chain is walked, freed, or duplicated.
          - The two directory-entry writes are NOT atomic as a pair. If the
            kernel dies between "new entry linked" and "old entry marked
            deleted", the directory graph holds BOTH names pointing at the
            same start_cluster (recoverable — an fsck-equivalent would drop
            one) — it never ends up with NEITHER name, and it never corrupts
            the underlying file data. This applies to same-directory renames
            too: this method does not special-case same-parent renames as a
            single-sector patch, for the LFN slot-count reason above.
          - Cross-directory moves of a DIRECTORY additionally patch the moved
            directory's own ".." entry (a single dirent write, in its own
            first cluster) to point at the new parent, so a later `cd ..`
            resolves correctly. That patch happens after the new entry is
            linked and before the old one is deleted, widening the crash
            window by one more single-dirent write — documented, not hidden.

        Destination-exists policy: returns EEXIST (via `_link_entry`'s own
        duplicate check) rather than atomically replacing an existing
        destination. POSIX `rename()` atomic-replace semantics are explicitly
        OUT of scope here — supporting it would mean freeing the destination's
        cluster chain as part of this already non-atomic two-step, which is a
        strictly larger data-loss window than what this method already
        documents above. Callers that need replace-semantics must unlink the
        destination first (accepting the same non-atomicity that implies).

        Moving a directory into itself or one of its own descendants is
        rejected with EINVAL for the direct case (new parent == the directory
        being moved); deeper cycles (moving into a grandchild) are not
        detected — out of scope for this primitive, callers must not do that.
        """
        if old_path == new_path:
            return Ok(())
        val loc_r = self.resolve_path(dev, old_path)
        if loc_r.is_err():
            return Err(loc_r.unwrap_err())
        val loc = loc_r.unwrap()

        val new_parts = fat32_split_path(new_path)
        if new_parts.len() == 0:
            return Err(EINVAL)
        val new_name = new_parts[new_parts.len() - 1]
        if new_name == "." or new_name == "..":
            return Err(EINVAL)

        val pd = self._parent_dir_cluster(dev, new_path)
        if pd.is_err():
            return Err(pd.unwrap_err())
        val dest_dir_cluster = pd.unwrap()

        if loc.is_dir and dest_dir_cluster == loc.start_cluster:
            return Err(EINVAL)  # moving a directory into itself

        var attr = FAT32_ATTR_ARCHIVE
        if loc.is_dir:
            attr = FAT32_ATTR_DIR_BYTE

        val link_r = self._link_entry(dev, dest_dir_cluster, new_name, attr, loc.start_cluster, loc.file_size)
        if link_r.is_err():
            return Err(link_r.unwrap_err())

        if loc.is_dir and dest_dir_cluster != loc.dir_cluster:
            # Cross-directory directory move: fix up the moved directory's own
            # ".." entry (stored in ITS first cluster, offset 32) so it points
            # at the new parent — otherwise a subsequent `cd ..` from inside it
            # would resolve to the old parent. Root's own cluster number is
            # never stored on disk (FAT32 records 0 for "parent is root").
            var dotdot_link = dest_dir_cluster
            if dest_dir_cluster == self.root_cluster:
                dotdot_link = 0u32
            val dotdot_entry = fat32_make_dirent(fat32_short_field(".."), FAT32_ATTR_DIR_BYTE, dotdot_link, 0u32)
            var self_chain: [u32] = [loc.start_cluster]
            val fix_r = self._write_dir_bytes(dev, self_chain, 32, dotdot_entry)
            if fix_r.is_err():
                return Err(fix_r.unwrap_err())

        # Entry now exists at its new name/location; only now remove the old
        # one — alias AND its LFN slots, otherwise the orphaned slots get
        # re-adopted by whatever is written into the freed alias slot next.
        # If this step fails or the kernel crashes here, both names remain
        # live (see the ATOMICITY note above) — never neither.
        self._unlink_dirent_chain(dev, loc)

    fn _atomic_replace_at_locked(self, dev: BlockDevice, source_tmp: text, destination: text, expected_source_lba: u64, expected_source_offset: i32, expected_source_cluster: u32, expected_destination_exists: bool, expected_destination_lba: u64, expected_destination_offset: i32, expected_destination_cluster: u32) -> Result<ReplaceReceipt, i32>:
        """Recoverably replace an allowlisted root database file.

        This is intentionally not routed through rename_at. The temp chain is
        flushed first, one bounded COMMITTED after-image set is published, and
        the journal owner applies/reclaims/DONEs it before success returns.
        """
        if not fat32_atomic_replace_route_allowed(source_tmp, destination):
            return Err(EINVAL)
        val sr = self.resolve_path(dev, source_tmp)
        val dr = self.resolve_path(dev, destination)
        if sr.is_err():
            return Err(ENOENT)
        val source = sr.unwrap()
        if source.dirent_sector != expected_source_lba or source.dirent_offset != expected_source_offset or source.start_cluster != expected_source_cluster:
            return Err(EBUSY)
        val root_scan_r = self._read_dir_data(dev, self.root_cluster)
        if root_scan_r.is_err():
            return Err(EIO)
        val root_scan_data = root_scan_r.unwrap()
        var destination_exists = dr.is_ok()
        var dest = Fat32DirEntryLoc(found: false, dir_cluster: self.root_cluster,
            entry_offset: 0, dirent_sector: 0u64, dirent_offset: 0,
            start_cluster: 0u32, file_size: 0u32, is_dir: false)
        if destination_exists:
            dest = dr.unwrap()
            if not expected_destination_exists or dest.dirent_sector != expected_destination_lba or dest.dirent_offset != expected_destination_offset or dest.start_cluster != expected_destination_cluster:
                return Err(EBUSY)
        else:
            if expected_destination_exists:
                return Err(EBUSY)
            # First generation: reserve one existing free root 8.3 slot in the
            # after-image only. Never grow/mutate the directory before COMMITTED.
            var free_off = -1
            var oi = 0
            while oi + 31 < root_scan_data.len() and free_off < 0:
                if root_scan_data[oi] == 0u8 or root_scan_data[oi] == 0xE5u8:
                    free_off = oi
                oi = oi + 32
            if free_off < 0:
                return Err(ENOSPC)
            val root_lba = self.data_start_sector.to_u64() + (self.root_cluster - 2u32).to_u64() * self.sectors_per_cluster.to_u64()
            dest = Fat32DirEntryLoc(found: false, dir_cluster: self.root_cluster,
                entry_offset: free_off, dirent_sector: root_lba + (free_off / 512).to_u64(),
                dirent_offset: free_off % 512, start_cluster: 0u32,
                file_size: 0u32, is_dir: false)
        if source.is_dir or dest.is_dir or source.dir_cluster != self.root_cluster or dest.dir_cluster != self.root_cluster:
            return Err(EINVAL)
        if source.start_cluster < 2u32 or source.start_cluster == dest.start_cluster:
            return Err(EINVAL)
        val source_chain_r = self.read_cluster_chain(dev, source.start_cluster)
        if source_chain_r.is_err():
            return Err(EIO)
        val source_chain = source_chain_r.unwrap()
        var dest_chain: [u32] = []
        if dest.start_cluster >= 2u32:
            val dest_chain_r = self.read_cluster_chain(dev, dest.start_cluster)
            if dest_chain_r.is_err():
                return Err(EIO)
            dest_chain = dest_chain_r.unwrap()
        var dci = 0
        while dci < dest_chain.len():
            var sci = 0
            while sci < source_chain.len():
                if dest_chain[dci] == source_chain[sci]:
                    return Err(EINVAL)
                sci = sci + 1
            dci = dci + 1
        # Reject aliases to any cluster in either full candidate chain. Raw
        # aliases would make reclamation or source deletion cross-free data.
        var scan = 0
        while scan + 31 < root_scan_data.len():
            val first = root_scan_data[scan]
            val attr = root_scan_data[scan + 11]
            if first != 0u8 and first != 0xE5u8 and attr != FAT32_ATTR_LFN:
                val cluster = fat32_entry_start_cluster(root_scan_data, scan)
                if cluster >= 2u32 and scan != source.entry_offset and (not destination_exists or scan != dest.entry_offset):
                    val alias_chain_r = self.read_cluster_chain(dev, cluster)
                    if alias_chain_r.is_err():
                        return Err(EIO)
                    val alias_chain = alias_chain_r.unwrap()
                    var ai = 0
                    while ai < alias_chain.len():
                        var ci = 0
                        while ci < source_chain.len():
                            if alias_chain[ai] == source_chain[ci]:
                                return Err(EINVAL)
                            ci = ci + 1
                        ci = 0
                        while ci < dest_chain.len():
                            if alias_chain[ai] == dest_chain[ci]:
                                return Err(EINVAL)
                            ci = ci + 1
                        ai = ai + 1
            scan = scan + 32
        val root_chain_r = self.read_cluster_chain(dev, self.root_cluster)
        if root_chain_r.is_err():
            return Err(EIO)
        val root_chain = root_chain_r.unwrap()
        var rci = 0
        while rci < root_chain.len():
            var cci = 0
            while cci < source_chain.len():
                if root_chain[rci] == source_chain[cci]:
                    return Err(EINVAL)
                cci = cci + 1
            cci = 0
            while cci < dest_chain.len():
                if root_chain[rci] == dest_chain[cci]:
                    return Err(EINVAL)
                cci = cci + 1
            rci = rci + 1
        # Continue the ownership scan through every reachable subdirectory.
        # Directory aliases/cycles fail closed under the same volume fuel.
        var dirs: [u32] = []
        scan = 0
        while scan + 31 < root_scan_data.len():
            val first = root_scan_data[scan]
            val attr = root_scan_data[scan + 11]
            if first != 0u8 and first != 0xE5u8 and first != 0x2Eu8 and attr != FAT32_ATTR_LFN and (attr & FAT32_ATTR_DIR_BYTE) != 0u8:
                val dc = fat32_entry_start_cluster(root_scan_data, scan)
                if dc >= 2u32:
                    dirs.push(dc)
            scan = scan + 32
        var visited_dirs: [u32] = []
        var qi = 0
        while qi < dirs.len():
            if visited_dirs.len() >= self.data_clusters.to_i64():
                return Err(EIO)
            val dir_cluster = dirs[qi]
            var seen_dir = false
            var vi = 0
            while vi < visited_dirs.len():
                if visited_dirs[vi] == dir_cluster:
                    seen_dir = true
                vi = vi + 1
            if seen_dir:
                return Err(EINVAL)
            visited_dirs.push(dir_cluster)
            val directory_chain_r = self.read_cluster_chain(dev, dir_cluster)
            if directory_chain_r.is_err():
                return Err(EIO)
            val directory_chain = directory_chain_r.unwrap()
            var dki = 0
            while dki < directory_chain.len():
                var cki = 0
                while cki < source_chain.len():
                    if directory_chain[dki] == source_chain[cki]:
                        return Err(EINVAL)
                    cki = cki + 1
                cki = 0
                while cki < dest_chain.len():
                    if directory_chain[dki] == dest_chain[cki]:
                        return Err(EINVAL)
                    cki = cki + 1
                dki = dki + 1
            val dir_data_r = self._read_dir_data(dev, dir_cluster)
            if dir_data_r.is_err():
                return Err(EIO)
            val dir_data = dir_data_r.unwrap()
            var di = 0
            while di + 31 < dir_data.len():
                val first = dir_data[di]
                val attr = dir_data[di + 11]
                if first != 0u8 and first != 0xE5u8 and first != 0x2Eu8 and attr != FAT32_ATTR_LFN:
                    val cluster = fat32_entry_start_cluster(dir_data, di)
                    if cluster >= 2u32:
                        if (attr & FAT32_ATTR_DIR_BYTE) != 0u8:
                            dirs.push(cluster)
                        else:
                            val alias_chain_r = self.read_cluster_chain(dev, cluster)
                            if alias_chain_r.is_err():
                                return Err(EIO)
                            val alias_chain = alias_chain_r.unwrap()
                            var ai = 0
                            while ai < alias_chain.len():
                                var ci = 0
                                while ci < source_chain.len():
                                    if alias_chain[ai] == source_chain[ci]:
                                        return Err(EINVAL)
                                    ci = ci + 1
                                ci = 0
                                while ci < dest_chain.len():
                                    if alias_chain[ai] == dest_chain[ci]:
                                        return Err(EINVAL)
                                    ci = ci + 1
                                ai = ai + 1
                di = di + 32
            qi = qi + 1
        # The source was written through the filesystem before this call. A
        # successful real device flush is the admission proof for COMMITTED.
        val synced = dev.flush()
        if synced.is_err() or not synced.unwrap():
            return Err(EIO)
        var old_next = 0x0FFFFFF8u32
        if dest.start_cluster >= 2u32:
            val old_next_r = self._read_fat_entry(dev, dest.start_cluster)
            if old_next_r.is_err():
                return Err(EIO)
            old_next = old_next_r.unwrap()
        var images: [Fat32ReplaceImage] = []
        if source.dirent_sector == dest.dirent_sector:
            val rr = dev.read_sector(dest.dirent_sector)
            if rr.is_err():
                return Err(EIO)
            var sector = rr.unwrap()
            if not destination_exists:
                val name = fat32_split_path(destination)[0]
                val entry = fat32_make_dirent(fat32_short_field(name), FAT32_ATTR_ARCHIVE, source.start_cluster, source.file_size)
                var ei = 0
                while ei < 32:
                    sector[dest.dirent_offset + ei] = entry[ei]
                    ei = ei + 1
            val hi = (source.start_cluster >> 16u32) & 0xFFFFu32
            val lo = source.start_cluster & 0xFFFFu32
            val doff = dest.dirent_offset
            sector[doff + 20] = (hi & 0xFFu32).to_u8()
            sector[doff + 21] = ((hi >> 8u32) & 0xFFu32).to_u8()
            sector[doff + 26] = (lo & 0xFFu32).to_u8()
            sector[doff + 27] = ((lo >> 8u32) & 0xFFu32).to_u8()
            sector[doff + 28] = (source.file_size & 0xFFu32).to_u8()
            sector[doff + 29] = ((source.file_size >> 8u32) & 0xFFu32).to_u8()
            sector[doff + 30] = ((source.file_size >> 16u32) & 0xFFu32).to_u8()
            sector[doff + 31] = ((source.file_size >> 24u32) & 0xFFu32).to_u8()
            sector[source.dirent_offset] = 0xE5u8
            images.push(fat32_replace_image(dest.dirent_sector, sector).unwrap())
        else:
            val drr = dev.read_sector(dest.dirent_sector)
            val srr = dev.read_sector(source.dirent_sector)
            if drr.is_err() or srr.is_err():
                return Err(EIO)
            var dsector = drr.unwrap()
            var ssector = srr.unwrap()
            if not destination_exists:
                val name = fat32_split_path(destination)[0]
                val entry = fat32_make_dirent(fat32_short_field(name), FAT32_ATTR_ARCHIVE, source.start_cluster, source.file_size)
                var ei = 0
                while ei < 32:
                    dsector[dest.dirent_offset + ei] = entry[ei]
                    ei = ei + 1
            val hi = (source.start_cluster >> 16u32) & 0xFFFFu32
            val lo = source.start_cluster & 0xFFFFu32
            val doff = dest.dirent_offset
            dsector[doff + 20] = (hi & 0xFFu32).to_u8()
            dsector[doff + 21] = ((hi >> 8u32) & 0xFFu32).to_u8()
            dsector[doff + 26] = (lo & 0xFFu32).to_u8()
            dsector[doff + 27] = ((lo >> 8u32) & 0xFFu32).to_u8()
            dsector[doff + 28] = (source.file_size & 0xFFu32).to_u8()
            dsector[doff + 29] = ((source.file_size >> 8u32) & 0xFFu32).to_u8()
            dsector[doff + 30] = ((source.file_size >> 16u32) & 0xFFu32).to_u8()
            dsector[doff + 31] = ((source.file_size >> 24u32) & 0xFFu32).to_u8()
            ssector[source.dirent_offset] = 0xE5u8
            images.push(fat32_replace_image(dest.dirent_sector, dsector).unwrap())
            images.push(fat32_replace_image(source.dirent_sector, ssector).unwrap())
        val record = Fat32ReplaceRecord(
            bank: 0, state: Fat32ReplaceState.Committed, generation: 0u64,
            destination_parent_cluster: dest.dir_cluster, destination_lba: dest.dirent_sector,
            destination_offset: dest.dirent_offset, source_parent_cluster: source.dir_cluster,
            source_lba: source.dirent_sector, source_offset: source.dirent_offset,
            source_lfn_slots: 0, old_first_cluster: dest.start_cluster,
            old_size: dest.file_size.to_u64(), new_first_cluster: source.start_cluster,
            new_size: source.file_size.to_u64(), reclaim_current: dest.start_cluster,
            reclaim_next: old_next, images: images)
        val committed = fat32_atomic_replace_commit_device(
            dev, record, self.total_sectors, self.reserved_sectors,
            self.fat_start_sector, self.fat_size_sectors, self.fat_count,
            self.data_clusters, self.data_start_sector,
            self.sectors_per_cluster, self.root_cluster)
        if committed.is_err():
            return Err(EIO)
        # Replay writes whole sectors behind the cache; reload before returning
        # or publishing subsequent lookups.
        val refreshed = self._read_dir_data(dev, self.root_cluster)
        if refreshed.is_err():
            return Err(EIO)
        self.root_dir_data = refreshed.unwrap()
        Ok(committed.unwrap())

    fn create_at(self, dev: BlockDevice, path: text) -> Result<FileHandle, i32>:
        if not self._mutation_enter():
            return Err(EBUSY)
        val result = self._create_at_locked(dev, path)
        self._mutation_leave()
        result

    fn write(self, dev: BlockDevice, h: FileHandle, buf: [u8]) -> Result<FileHandle, i32>:
        if not self._mutation_enter():
            return Err(EBUSY)
        val result = self._write_locked(dev, h, buf)
        self._mutation_leave()
        result

    fn flush(self, dev: BlockDevice, h: FileHandle) -> Result<(), i32>:
        if not self._mutation_enter():
            return Err(EBUSY)
        val result = self._flush_locked(dev, h)
        self._mutation_leave()
        result

    fn mkdir_at(self, dev: BlockDevice, path: text) -> Result<(), i32>:
        if not self._mutation_enter():
            return Err(EBUSY)
        val result = self._mkdir_at_locked(dev, path)
        self._mutation_leave()
        result

    fn unlink_at(self, dev: BlockDevice, path: text) -> Result<(), i32>:
        if not self._mutation_enter():
            return Err(EBUSY)
        val result = self._unlink_at_locked(dev, path)
        self._mutation_leave()
        result

    fn rmdir_at(self, dev: BlockDevice, path: text) -> Result<(), i32>:
        if not self._mutation_enter():
            return Err(EBUSY)
        val result = self._rmdir_at_locked(dev, path)
        self._mutation_leave()
        result

    fn rename_at(self, dev: BlockDevice, old_path: text, new_path: text) -> Result<(), i32>:
        if not self._mutation_enter():
            return Err(EBUSY)
        val result = self._rename_at_locked(dev, old_path, new_path)
        self._mutation_leave()
        result

    fn atomic_replace_at(self, dev: BlockDevice, source_tmp: text, destination: text) -> Result<ReplaceReceipt, i32>:
        """Resolve before locking, then revalidate immutable identities under the shared mutation owner."""
        val pre_source_r = self.resolve_path(dev, source_tmp)
        if pre_source_r.is_err():
            return Err(pre_source_r.unwrap_err())
        val pre_source = pre_source_r.unwrap()
        val pre_dest_r = self.resolve_path(dev, destination)
        var pre_dest_exists = false
        var pre_dest_lba = 0u64
        var pre_dest_offset = 0
        var pre_dest_cluster = 0u32
        if pre_dest_r.is_ok():
            val pre_dest = pre_dest_r.unwrap()
            pre_dest_exists = true
            pre_dest_lba = pre_dest.dirent_sector
            pre_dest_offset = pre_dest.dirent_offset
            pre_dest_cluster = pre_dest.start_cluster
        if not self._mutation_enter():
            return Err(EBUSY)
        val result = self._atomic_replace_at_locked(
            dev, source_tmp, destination,
            pre_source.dirent_sector, pre_source.dirent_offset, pre_source.start_cluster,
            pre_dest_exists, pre_dest_lba, pre_dest_offset, pre_dest_cluster)
        self._mutation_leave()
        result

    static fn make_for_chain_test(fat_start_sector: u32, bytes_per_sector: u32, data_clusters: u32) -> Fat32Filesystem:
        """Create a pre-configured Fat32Filesystem for read_cluster_chain unit tests.

        Sets geometry fields directly; caller supplies a mock BlockDevice to
        read_cluster_chain.  Not for production use.
        """
        Fat32Filesystem(
            device_id:           0u64,
            bpb_parsed:          true,
            cluster_size:        bytes_per_sector,
            fat_start_sector:    fat_start_sector,
            data_start_sector:   fat_start_sector + 8u32,
            root_cluster:        2u32,
            sectors_per_cluster: 1u32,
            bytes_per_sector:    bytes_per_sector,
            data_clusters:       data_clusters,
            total_sectors:       0u32,
            reserved_sectors:    0u32,
            fat_size_sectors:    0u32,
            fat_count:           1u32,
            mutation_active:     false,
            root_dir_data:       []
        )

    static fn make_for_read_test(fat_start_sector: u32, data_start_sector: u32, bytes_per_sector: u32, sectors_per_cluster: u32, data_clusters: u32) -> Fat32Filesystem:
        """Create a pre-configured Fat32Filesystem for read() unit tests.

        Allows explicit data_start_sector and sectors_per_cluster so callers
        can place data sectors at known LBAs.  Caller supplies a mock
        BlockDevice to read().  Not for production use.
        """
        Fat32Filesystem(
            device_id:           0u64,
            bpb_parsed:          true,
            cluster_size:        bytes_per_sector * sectors_per_cluster,
            fat_start_sector:    fat_start_sector,
            data_start_sector:   data_start_sector,
            root_cluster:        2u32,
            sectors_per_cluster: sectors_per_cluster,
            bytes_per_sector:    bytes_per_sector,
            data_clusters:       data_clusters,
            total_sectors:       0u32,
            reserved_sectors:    0u32,
            fat_size_sectors:    8u32,
            fat_count:           1u32,
            mutation_active:     false,
            root_dir_data:       []
        )

    static fn make_for_alloc_test(fat_start_sector: u32, data_start_sector: u32, bytes_per_sector: u32, sectors_per_cluster: u32, data_clusters: u32) -> Fat32Filesystem:
        """Create a pre-configured Fat32Filesystem for allocator/write unit tests.

        Same geometry as make_for_read_test; separated so alloc specs can evolve
        independently.  Caller supplies a mock BlockDevice that supports both
        read_sector and write_sector.  Not for production use.
        """
        Fat32Filesystem(
            device_id:           0u64,
            bpb_parsed:          true,
            cluster_size:        bytes_per_sector * sectors_per_cluster,
            fat_start_sector:    fat_start_sector,
            data_start_sector:   data_start_sector,
            root_cluster:        2u32,
            sectors_per_cluster: sectors_per_cluster,
            bytes_per_sector:    bytes_per_sector,
            data_clusters:       data_clusters,
            total_sectors:       0u32,
            reserved_sectors:    0u32,
            fat_size_sectors:    8u32,
            fat_count:           1u32,
            mutation_active:     false,
            root_dir_data:       []
        )

    static fn make_for_dirent_test(fat_start_sector: u32, data_start_sector: u32, bytes_per_sector: u32, sectors_per_cluster: u32, data_clusters: u32, initial_root_dir: [u8]) -> Fat32Filesystem:
        """Create a pre-configured Fat32Filesystem for dirent-persistence unit tests.

        Same geometry as make_for_alloc_test but accepts a pre-populated
        root_dir_data cache so _find_root_entry / open() can resolve 8.3 names.
        Caller supplies a mock BlockDevice that provides the root-dir sector at
        LBA data_start_sector (root_cluster=2, so no offset).
        Not for production use.
        """
        Fat32Filesystem(
            device_id:           0u64,
            bpb_parsed:          true,
            cluster_size:        bytes_per_sector * sectors_per_cluster,
            fat_start_sector:    fat_start_sector,
            data_start_sector:   data_start_sector,
            root_cluster:        2u32,
            sectors_per_cluster: sectors_per_cluster,
            bytes_per_sector:    bytes_per_sector,
            data_clusters:       data_clusters,
            total_sectors:       0u32,
            reserved_sectors:    0u32,
            fat_size_sectors:    8u32,
            fat_count:           1u32,
            mutation_active:     false,
            root_dir_data:       initial_root_dir
        )

# ============================================================================
# Kernel-global mounted filesystem — published once at boot
#
# Mirrors the g_cwd_table lazy-scalar pattern in syscall_file.spl and the
# vmm_publish_kernel_pml4 pattern in vmm_core.spl: freestanding kernel code
# cannot rely on struct-literal module-level initializers (they never run —
# see doc/07_guide/os/baremetal/baremetal_simple_codegen_landmines.md), so
# state is published imperatively into module scalars/nullable fields behind
# a `bool` ready-flag instead of being constructed at declaration time.
#
# `Fat32Filesystem` and `BlockDevice` are both reference (class) types here,
# so the Option-typed globals below hold a plain nullable pointer (0 = None)
# rather than a boxed struct — the specific landmine #1 case the guide warns
# about (an Option<struct> reading nil on the hit path) does not apply to a
# pointer-sized reference type. No `if val` binding-if is used on them, only
# explicit `!= nil` checks, per the guide's own workaround.
# ============================================================================

var g_fat32_mount_ready: bool = false
var g_fat32_mount_fs: Fat32Filesystem? = nil
var g_fat32_mount_dev: BlockDevice? = nil

fn fat32_mount_publish(fs: Fat32Filesystem, dev: BlockDevice):
    """Publish a freshly-mounted Fat32Filesystem + its backing BlockDevice as
    kernel-global state. Called once from the boot filesystem-mount path
    (see os.kernel.boot.boot_fs_mount.boot_fs_mount_fat32_from_device) after
    `Fat32Filesystem.mount()` succeeds. Idempotent: a later call replaces the
    previous mount (e.g. a remount), it does not stack."""
    g_fat32_mount_fs = fs
    g_fat32_mount_dev = dev
    g_fat32_mount_ready = true

fn fat32_mount_ready() -> bool:
    """True once fat32_mount_publish has run. syscall_file.spl handlers must
    check this before touching fat32_mount_fs()/fat32_mount_dev() — reading
    either while false is a caller bug, not a recoverable error."""
    g_fat32_mount_ready

fn fat32_mount_fs() -> Fat32Filesystem:
    """The published Fat32Filesystem. Caller MUST have checked
    fat32_mount_ready() first."""
    g_fat32_mount_fs.unwrap()

fn fat32_mount_dev() -> BlockDevice:
    """The published BlockDevice backing the mounted filesystem. Caller MUST
    have checked fat32_mount_ready() first."""
    g_fat32_mount_dev.unwrap()

fn fat32_atomic_replace(source_tmp: text, destination: text) -> Result<ReplaceReceipt, i32>:
    """Mounted-filesystem adapter used by the SimpleOS database runtime."""
    if not g_fat32_mount_ready or g_fat32_mount_fs == nil or g_fat32_mount_dev == nil:
        return Err(EIO)
    g_fat32_mount_fs.unwrap().atomic_replace_at(g_fat32_mount_dev.unwrap(), source_tmp, destination)

fn fat32_atomic_replace_recover() -> Result<ReplaceReceipt, i32>:
    """Explicit recovery adapter; normal boot invokes this before publish."""
    if not g_fat32_mount_ready or g_fat32_mount_fs == nil or g_fat32_mount_dev == nil:
        return Err(EIO)
    val fs = g_fat32_mount_fs.unwrap()
    val rr = fat32_atomic_replace_recover_device(
        g_fat32_mount_dev.unwrap(), fs.total_sectors, fs.reserved_sectors,
        fs.fat_start_sector, fs.fat_size_sectors, fs.fat_count,
        fs.data_clusters, fs.data_start_sector,
        fs.sectors_per_cluster, fs.root_cluster)
    if rr.is_err():
        return Err(EIO)
    Ok(rr.unwrap())

fn fat32_mount_clear():
    """Test-only: reset published mount state between specs so one test's
    mount cannot leak into another's assertions."""
    g_fat32_mount_ready = false
    g_fat32_mount_fs = nil
    g_fat32_mount_dev = nil
