use std.common.compress.{CompressionCodec, decompress_bytes}

fn zstd_decompress(compressed: [u8]) -> Result<[u8], text>:
    # Pin the codec to zstd instead of auto-detecting. Auto-detect made this
    # zstd-specific entry point accept any recognised frame (gzip, lz4, ...),
    # and it reported a generic "codec auto-detect failed" for a corrupt zstd
    # magic instead of the precise zstd frame error.
    val result = decompress_bytes(compressed, Some(CompressionCodec.zstd))
    if result.is_err():
        return Err(result.unwrap_err().message())
    Ok(result.unwrap())
