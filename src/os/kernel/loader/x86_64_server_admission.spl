"""Pure admission predicate for the two x86_64 SimpleOS server images.

This module deliberately owns no I/O, hashing, scheduler state, or loader
mutation.  It validates the immutable inputs supplied by the filesystem
launcher before that launcher is allowed to hand the images to another owner.
"""

use os.kernel.loader.byte_utils.{lb_read_u8, lb_read_u16_le, lb_read_u32_le, lb_read_u64_le, in_range}
use os.kernel.loader.artifact_manifest.{manifest_sha256_hex}

pub val X86_64_SERVER_WEB_PATH: text = "/SYS/APPS/WEBSRV.SMF"
pub val X86_64_SERVER_DB_PATH: text = "/SYS/APPS/DBSRV.SMF"
pub val X86_64_SERVER_PROFILE: text = "simpleos-single-worker-v1"

val _ELF64_HEADER_SIZE: i64 = 64
val _ELF64_PROGRAM_HEADER_SIZE: i64 = 56
val _ELF_ET_EXEC: i64 = 2
val _ELF_EM_X86_64: i64 = 62
val _PT_LOAD: i64 = 1
val _PF_X: i64 = 1

pub struct X86_64ServerAdmissionInput:
    web_path: text
    db_path: text
    web_bytes: [u8]
    db_bytes: [u8]
    web_version: text
    db_version: text
    web_sha256: text
    db_sha256: text
    image_id: text
    image_sha256: text
    launch_id: text
    runtime_profile: text
    web_profile: text
    db_profile: text

pub struct X86_64ServerAdmission:
    accepted: bool
    reason: text

pub fn x86_64_server_web_profile(launch_id: text) -> text:
    "--simpleos --launch-id {launch_id} --listen 0.0.0.0:8080 --workers 1 --backend cpu"

pub fn x86_64_server_db_profile(launch_id: text) -> text:
    "--serve --simpleos --launch-id {launch_id} --listen 0.0.0.0:5432 --workers 1 --allow-user simpleos --allow-database simpleos"

fn _x86_64_server_ascii_alnum(value: i64) -> bool:
    (value >= 0x30 and value <= 0x39) or
        (value >= 0x41 and value <= 0x5a) or
        (value >= 0x61 and value <= 0x7a)

fn _x86_64_server_launch_id_valid(value: text) -> bool:
    if value.len() == 0 or value.len() > 128:
        return false
    var index = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if not _x86_64_server_ascii_alnum(code) and
                code != 0x2d and code != 0x2e and code != 0x3a and code != 0x5f:
            return false
        index = index + 1
    true

fn _x86_64_server_sha256_text_valid(value: text) -> bool:
    if value.len() != 64:
        return false
    var index = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if not (code >= 0x30 and code <= 0x39) and
                not (code >= 0x61 and code <= 0x66):
            return false
        index = index + 1
    true

fn _x86_64_server_elf64_x86_64_exec(bytes: [u8]) -> bool:
    if bytes.len() < _ELF64_HEADER_SIZE:
        return false
    # Use the loader byte helper instead of direct [u8] indexing: the x86_64
    # freestanding representation stores boxed RuntimeValues and needs the
    # canonical decoded-byte accessor owned by byte_utils.
    if lb_read_u32_le(bytes, 0) != 0x464c457f:
        return false
    if lb_read_u8(bytes, 4) != 2 or lb_read_u8(bytes, 5) != 1 or
            lb_read_u8(bytes, 6) != 1:
        return false
    if lb_read_u16_le(bytes, 16) != _ELF_ET_EXEC or
            lb_read_u16_le(bytes, 18) != _ELF_EM_X86_64 or
            lb_read_u32_le(bytes, 20) != 1:
        return false
    if lb_read_u16_le(bytes, 52) != _ELF64_HEADER_SIZE or
            lb_read_u16_le(bytes, 54) != _ELF64_PROGRAM_HEADER_SIZE:
        return false

    val phoff = lb_read_u64_le(bytes, 32)
    val phnum = lb_read_u16_le(bytes, 56)
    if phoff < _ELF64_HEADER_SIZE or phnum <= 0:
        return false
    val table_size = _ELF64_PROGRAM_HEADER_SIZE * phnum
    if not in_range(bytes, phoff, table_size):
        return false

    val entry = lb_read_u64_le(bytes, 24)
    var load_count = 0
    var executable_entry = false
    var index = 0
    while index < phnum:
        val offset = phoff + index * _ELF64_PROGRAM_HEADER_SIZE
        if not in_range(bytes, offset, _ELF64_PROGRAM_HEADER_SIZE):
            return false
        if lb_read_u32_le(bytes, offset) == _PT_LOAD:
            val flags = lb_read_u32_le(bytes, offset + 4)
            val file_offset = lb_read_u64_le(bytes, offset + 8)
            val virtual_address = lb_read_u64_le(bytes, offset + 16)
            val file_size = lb_read_u64_le(bytes, offset + 32)
            val memory_size = lb_read_u64_le(bytes, offset + 40)
            if file_offset < 0 or file_size < 0 or memory_size <= 0 or
                    memory_size < file_size or
                    not in_range(bytes, file_offset, file_size):
                return false
            # Avoid overflow in the half-open executable segment range.
            if virtual_address > 0x7fffffffffffffff - memory_size:
                return false
            if (flags & _PF_X) != 0 and entry >= virtual_address and
                    entry < virtual_address + memory_size:
                executable_entry = true
            load_count = load_count + 1
        index = index + 1
    load_count > 0 and executable_entry

pub fn x86_64_server_admit(input: X86_64ServerAdmissionInput) -> X86_64ServerAdmission:
    if input.web_path != X86_64_SERVER_WEB_PATH or input.db_path != X86_64_SERVER_DB_PATH:
        return X86_64ServerAdmission(accepted: false, reason: "noncanonical-server-path")
    if input.web_bytes.len() == 0 or input.db_bytes.len() == 0:
        return X86_64ServerAdmission(accepted: false, reason: "empty-server-artifact")
    if input.web_bytes == input.db_bytes:
        return X86_64ServerAdmission(accepted: false, reason: "identical-server-artifacts")
    if input.web_version.trim() == "" or input.web_version == "latest" or
            input.db_version.trim() == "" or input.db_version == "latest":
        return X86_64ServerAdmission(accepted: false, reason: "unpinned-server-version")
    if input.runtime_profile != X86_64_SERVER_PROFILE:
        return X86_64ServerAdmission(accepted: false, reason: "runtime-profile-mismatch")
    if input.image_id.trim() == "" or
            not _x86_64_server_sha256_text_valid(input.image_sha256):
        return X86_64ServerAdmission(accepted: false, reason: "unpinned-filesystem-image")
    if not _x86_64_server_sha256_text_valid(input.web_sha256) or
            not _x86_64_server_sha256_text_valid(input.db_sha256):
        return X86_64ServerAdmission(accepted: false, reason: "invalid-server-sha256")
    if manifest_sha256_hex(input.web_bytes) != input.web_sha256:
        return X86_64ServerAdmission(accepted: false, reason: "web-content-hash-mismatch")
    if manifest_sha256_hex(input.db_bytes) != input.db_sha256:
        return X86_64ServerAdmission(accepted: false, reason: "db-content-hash-mismatch")
    if not _x86_64_server_launch_id_valid(input.launch_id):
        return X86_64ServerAdmission(accepted: false, reason: "invalid-launch-id")
    if input.web_profile != x86_64_server_web_profile(input.launch_id):
        return X86_64ServerAdmission(accepted: false, reason: "web-profile-mismatch")
    if input.db_profile != x86_64_server_db_profile(input.launch_id):
        return X86_64ServerAdmission(accepted: false, reason: "db-profile-mismatch")
    if not _x86_64_server_elf64_x86_64_exec(input.web_bytes):
        return X86_64ServerAdmission(accepted: false, reason: "invalid-web-elf")
    if not _x86_64_server_elf64_x86_64_exec(input.db_bytes):
        return X86_64ServerAdmission(accepted: false, reason: "invalid-db-elf")
    X86_64ServerAdmission(accepted: true, reason: "ok")

pub fn x86_64_server_admission_valid(input: X86_64ServerAdmissionInput) -> bool:
    x86_64_server_admit(input).accepted

export X86_64ServerAdmissionInput, X86_64ServerAdmission
export x86_64_server_web_profile, x86_64_server_db_profile
export x86_64_server_admit, x86_64_server_admission_valid
