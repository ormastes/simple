"""Boot bridge from a sealed catalog to the Simple toolchain launch pipeline.

Ordinary boot may probe this optional lane and continue when the three signed
tool records are absent. Once requested, execution is fail-closed: every stage
uses a fresh catalog-bound execute open and no resident/cache fallback exists.
"""

use os.kernel.scheduler.scheduler_types.{Scheduler}
use std.fs_driver.mount_table.{MountTable}
use os.kernel.loader.installed_artifact_manifest_execution_policy_v1.{
    installed_artifact_active_target_v1}
use os.kernel.loader.installed_artifact_catalog_v1.{
    installed_artifact_catalog_lookup_target_v1}
use os.kernel.loader.executable_admission_pipeline.{
    executable_loader_revoke
}
use os.kernel.loader.executable_authority_registry.{
    ExecutableAuthorityRegistryV1, executable_authority_owner_valid}
use os.kernel.loader.authenticated_fs_exec_submission_service_v1.{
    AuthenticatedFsExecSubmissionV1,
    authenticated_fs_exec_prepare_installed_artifact_online_v1
}
use os.kernel.loader.simple_toolchain_filesystem_launch_v1.{
    simple_toolchain_filesystem_launch_plan_v1}
use os.kernel.loader.simple_toolchain_filesystem_receipt_caller_v1.{
    simple_toolchain_filesystem_launch_and_receipt_v1}
use os.kernel.loader.simple_toolchain_terminal_receipt_owner_v1.{
    SimpleToolchainTerminalReceiptV1}
use os.kernel.loader.spawn_recipes.{
    SPAWN_RECIPE_APP_LAUNCHER, spawn_recipe_seed_parent_caps
}
use os.services.vfs.vfs_boot_state.{
    vfs_state_mount_table_owner_handle_v1,
    vfs_state_mount_table_lease_begin_v1,
    vfs_state_mount_table_lease_restore_v1
}

pub struct SimpleToolchainSignedCatalogBootResultV1:
    catalog_present: bool
    launched: bool
    reason: text
    receipt: SimpleToolchainTerminalReceiptV1?
    scheduler: Scheduler

fn _result_v1(
    scheduler: Scheduler,
    present: bool,
    launched: bool,
    reason: text,
    receipt: SimpleToolchainTerminalReceiptV1? = nil,
) -> SimpleToolchainSignedCatalogBootResultV1:
    SimpleToolchainSignedCatalogBootResultV1(
        catalog_present: present, launched: launched,
        reason: reason, receipt: receipt, scheduler: scheduler)

fn _tool_paths_v1() -> [text]:
    ["/sys/apps/simple_interpreter.smf",
     "/sys/apps/simple_compiler.smf",
     "/sys/apps/simple_loader.smf"]

pub fn simple_toolchain_signed_catalog_available_v1() -> bool:
    """Pure optional-feature probe; absence does not fail ordinary boot."""
    val target = installed_artifact_active_target_v1()
    if not target.?: return false
    for path in _tool_paths_v1():
        if not installed_artifact_catalog_lookup_target_v1(
            path, target.unwrap()).?:
            return false
    true

fn _toolchain_catalog_triplet_bound_v1() -> bool:
    """Require one target and one trust identity across all three stages."""
    val target = installed_artifact_active_target_v1()
    if not target.?: return false
    val paths = _tool_paths_v1()
    val first = installed_artifact_catalog_lookup_target_v1(
        paths[0], target.unwrap())
    val second = installed_artifact_catalog_lookup_target_v1(
        paths[1], target.unwrap())
    val third = installed_artifact_catalog_lookup_target_v1(
        paths[2], target.unwrap())
    if not first.? or not second.? or not third.?: return false
    val interpreter = first.unwrap()
    val compiler = second.unwrap()
    val loader = third.unwrap()
    interpreter.signer_identity == compiler.signer_identity and
        interpreter.signer_identity == loader.signer_identity and
        interpreter.expected_trust_root_sha256 ==
            compiler.expected_trust_root_sha256 and
        interpreter.expected_trust_root_sha256 ==
            loader.expected_trust_root_sha256 and
        interpreter.target.os == compiler.target.os and
        interpreter.target.os == loader.target.os and
        interpreter.target.arch == compiler.target.arch and
        interpreter.target.arch == loader.target.arch and
        interpreter.target.abi == compiler.target.abi and
        interpreter.target.abi == loader.target.abi

fn _revoke_v1(
    table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
) -> bool:
    executable_loader_revoke(
        table, submission.authorities, submission.token).is_ok()

fn _prepare_v1(
    table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    caller: i64,
    path: text,
) -> Result<AuthenticatedFsExecSubmissionV1, i64>:
    authenticated_fs_exec_prepare_installed_artifact_online_v1(
        table, authorities, caller, path, SPAWN_RECIPE_APP_LAUNCHER)

pub(package) fn simple_toolchain_signed_catalog_boot_launch_v1(
    scheduler: Scheduler,
    authorities: ExecutableAuthorityRegistryV1,
    caller: i64,
    source_path: text,
    artifact_path: text,
) -> SimpleToolchainSignedCatalogBootResultV1:
    """Run interpreter, compiler, and loader from three signed FS records."""
    if not simple_toolchain_signed_catalog_available_v1():
        return _result_v1(scheduler, false, false, "signed-toolchain-catalog-absent")
    if not _toolchain_catalog_triplet_bound_v1():
        return _result_v1(scheduler,
            true, false, "signed-toolchain-catalog-triplet-mismatch")
    if caller <= 0:
        return _result_v1(scheduler, true, false, "invalid-parent-task")
    if not executable_authority_owner_valid(authorities):
        return _result_v1(scheduler, true, false, "authority-owner-unavailable")
    val plan = simple_toolchain_filesystem_launch_plan_v1(
        source_path, artifact_path)
    if plan.is_err():
        return _result_v1(scheduler, true, false, plan.unwrap_err())
    val owner = vfs_state_mount_table_owner_handle_v1()
    if not owner.?: return _result_v1(scheduler, true, false, "vfs-owner-unavailable")
    val leased = vfs_state_mount_table_lease_begin_v1(owner.unwrap())
    if not leased.?: return _result_v1(scheduler, true, false, "vfs-owner-busy")
    var lease = leased.unwrap()
    val paths = _tool_paths_v1()
    val interpreter = _prepare_v1(
        lease.table, authorities, caller, paths[0])
    if interpreter.is_err():
        val restored = vfs_state_mount_table_lease_restore_v1(lease)
        return _result_v1(scheduler, true, false,
            if restored: "interpreter-admission-failed" else: "vfs-restore-failed")
    val compiler = _prepare_v1(
        lease.table, authorities, caller, paths[1])
    if compiler.is_err():
        val retired = _revoke_v1(lease.table, interpreter.unwrap())
        val restored = vfs_state_mount_table_lease_restore_v1(lease)
        return _result_v1(scheduler, true, false,
            if retired and restored: "compiler-admission-failed"
            else: "toolchain-cleanup-indeterminate")
    val loader = _prepare_v1(
        lease.table, authorities, caller, paths[2])
    if loader.is_err():
        val interpreter_retired = _revoke_v1(lease.table, interpreter.unwrap())
        val compiler_retired = _revoke_v1(lease.table, compiler.unwrap())
        val restored = vfs_state_mount_table_lease_restore_v1(lease)
        return _result_v1(scheduler, true, false,
            if interpreter_retired and compiler_retired and restored:
                "loader-admission-failed"
            else:
                "toolchain-cleanup-indeterminate")
    val receipt = simple_toolchain_filesystem_launch_and_receipt_v1(
        scheduler,
        spawn_recipe_seed_parent_caps(
            SPAWN_RECIPE_APP_LAUNCHER, caller.to_u64()),
        lease.table, plan.unwrap(), interpreter.unwrap(),
        compiler.unwrap(), loader.unwrap())
    val restored = vfs_state_mount_table_lease_restore_v1(lease)
    if not restored:
        val restore_scheduler = if receipt.is_ok():
            receipt.unwrap().scheduler
        else:
            receipt.unwrap_err().scheduler
        return _result_v1(
            restore_scheduler, true, false, "vfs-restore-failed")
    if receipt.is_err():
        val failed = receipt.unwrap_err()
        return _result_v1(failed.scheduler, true, false, failed.reason)
    val accepted = receipt.unwrap()
    _result_v1(accepted.scheduler, true, true, "", Some(accepted.receipt))
