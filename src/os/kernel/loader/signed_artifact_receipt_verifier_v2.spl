"""Loader-side SCR2 verifier and explicitly non-authorizing guest check.

Controlled SCR1 decoding exists only for inventory/migration.  Guest launch
requires a decoded and authenticated SCR2; legacy records can never produce a
successful guest check.
"""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.crypto.ed25519.{pure_ed25519_verify}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.structural.execution.simple_artifact_receipt_v2_codec.{
    SimpleArtifactReceiptDecodedV2, SimpleArtifactReceiptSubjectV2,
    simple_artifact_receipt_scr2_decode_v2
}
use std.common.structural.wire.{wire_magic, wire_check_envelope}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1
}
use os.kernel.loader.signed_catalog_scr1_decoder_v1.{
    SignedCatalogScr1DecodedV1, signed_catalog_scr1_decode_v1
}

pub enum SignedArtifactReceiptWireKindV2:
    Scr2
    LegacyScr1

pub struct SignedArtifactReceiptControlledDecodeV2:
    kind: SignedArtifactReceiptWireKindV2
    scr2: SimpleArtifactReceiptDecodedV2?
    legacy_scr1: SignedCatalogScr1DecodedV1?

pub struct SignedArtifactReceiptGuestExpectationV2:
    artifact_sha256: text
    artifact_byte_count: i64
    role: text
    authority_identity: text
    target: ManifestTarget
    canonical_path: text
    aliases: [text]
    entrypoint: text

pub struct SignedArtifactReceiptTrustPolicyV2:
    signer: ExecutableManifestTrustedSignerV1
    allowed_authority_identities: [text]
    allowed_roles: [text]
    allowed_targets: [ManifestTarget]

pub struct SignedArtifactReceiptGuestCheckV2:
    ok: bool
    reason: text

fn _receipt_hex_nibble_v2(value: text) -> i64:
    if value >= "0" and value <= "9": return value.char_code_at(0) - 48
    if value >= "a" and value <= "f": return value.char_code_at(0) - 87
    -1

fn _receipt_signature_decode_v2(value: text) -> [u8]:
    if value.len() != 128: return []
    var decoded: [u8] = []
    var index: i64 = 0
    while index < value.len():
        val high = _receipt_hex_nibble_v2(value.substring(index, index + 1))
        val low = _receipt_hex_nibble_v2(value.substring(index + 1, index + 2))
        if high < 0 or low < 0: return []
        decoded.push((high * 16 + low).to_u8())
        index = index + 2
    decoded

fn _receipt_target_equal_v2(left: ManifestTarget, right: ManifestTarget) -> bool:
    left.os == right.os and left.arch == right.arch and left.abi == right.abi

fn _receipt_subject_matches_v2(
    subject: SimpleArtifactReceiptSubjectV2,
    expected: SignedArtifactReceiptGuestExpectationV2,
) -> bool:
    subject.artifact_sha256 == expected.artifact_sha256 and
        subject.artifact_byte_count == expected.artifact_byte_count and
        subject.role == expected.role and
        subject.authority_identity == expected.authority_identity and
        _receipt_target_equal_v2(subject.target, expected.target) and
        subject.canonical_path == expected.canonical_path and
        subject.aliases == expected.aliases and
        subject.entrypoint == expected.entrypoint

fn _receipt_key_id_valid_v2(value: text) -> bool:
    if value.len() == 0 or value.len() > 128: return false
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if code < 33 or code > 126 or code == 58: return false
        index = index + 1
    true

fn _receipt_policies_valid_v2(policies: [SignedArtifactReceiptTrustPolicyV2]) -> bool:
    if policies.len() == 0 or policies.len() > 16: return false
    var index: i64 = 0
    while index < policies.len():
        val policy = policies[index]
        if not _receipt_key_id_valid_v2(policy.signer.key_id) or
            policy.signer.public_key.len() != 32 or
            policy.allowed_authority_identities.len() == 0 or
            policy.allowed_authority_identities.len() > 16 or
            policy.allowed_roles.len() == 0 or policy.allowed_roles.len() > 64 or
            policy.allowed_targets.len() == 0 or policy.allowed_targets.len() > 64:
            return false
        var authority_index: i64 = 0
        while authority_index < policy.allowed_authority_identities.len():
            val authority = policy.allowed_authority_identities[authority_index]
            if authority.len() == 0 or authority.len() > 128 or
                authority.contains("*"):
                return false
            var authority_prior: i64 = 0
            while authority_prior < authority_index:
                if policy.allowed_authority_identities[authority_prior] == authority:
                    return false
                authority_prior = authority_prior + 1
            authority_index = authority_index + 1
        var prior: i64 = 0
        while prior < index:
            if policies[prior].signer.key_id == policy.signer.key_id or
                policies[prior].signer.public_key == policy.signer.public_key:
                return false
            prior = prior + 1
        index = index + 1
    true

fn _receipt_policy_authorizes_v2(
    policy: SignedArtifactReceiptTrustPolicyV2,
    subject: SimpleArtifactReceiptSubjectV2,
) -> bool:
    if not policy.allowed_authority_identities.contains(subject.authority_identity) or
        not policy.allowed_roles.contains(subject.role):
        return false
    for target in policy.allowed_targets:
        if _receipt_target_equal_v2(target, subject.target): return true
    false

pub fn signed_artifact_receipt_decode_controlled_v2(
    bytes: [u8],
    allow_legacy_scr1: bool,
) -> SignedArtifactReceiptControlledDecodeV2?:
    val scr2 = simple_artifact_receipt_scr2_decode_v2(bytes)
    if scr2.?:
        return Some(SignedArtifactReceiptControlledDecodeV2(
            kind: SignedArtifactReceiptWireKindV2.Scr2,
            scr2: scr2, legacy_scr1: nil))
    if not allow_legacy_scr1 or
        not wire_check_envelope(bytes, 0, wire_magic("SCR1"), 1):
        return nil
    val legacy = signed_catalog_scr1_decode_v1(bytes)
    if not legacy.?: return nil
    Some(SignedArtifactReceiptControlledDecodeV2(
        kind: SignedArtifactReceiptWireKindV2.LegacyScr1,
        scr2: nil, legacy_scr1: legacy))

pub fn signed_artifact_receipt_guest_check_v2(
    bytes: [u8],
    trust_policies: [SignedArtifactReceiptTrustPolicyV2],
    expected: SignedArtifactReceiptGuestExpectationV2,
) -> SignedArtifactReceiptGuestCheckV2:
    """Authenticate SCR2 without returning an executable-authority token."""
    val decoded = signed_artifact_receipt_decode_controlled_v2(bytes, false)
    if not decoded.? or
        decoded.unwrap().kind != SignedArtifactReceiptWireKindV2.Scr2 or
        not decoded.unwrap().scr2.?:
        return SignedArtifactReceiptGuestCheckV2(
            ok: false, reason: "scr2-required")
    val receipt = decoded.unwrap().scr2.unwrap()
    if not _receipt_subject_matches_v2(receipt.subject, expected):
        return SignedArtifactReceiptGuestCheckV2(
            ok: false, reason: "signed-subject-mismatch")
    val envelope = receipt.detached_signature.split(":")
    if envelope.len() != 3 or envelope[0] != "ed25519" or
        receipt.subject.signature_algorithm != envelope[0] or
        receipt.subject.signer_key_id != envelope[1]:
        return SignedArtifactReceiptGuestCheckV2(
            ok: false, reason: "signature-envelope-invalid")
    val signature = _receipt_signature_decode_v2(envelope[2])
    if signature.len() != 64:
        return SignedArtifactReceiptGuestCheckV2(
            ok: false, reason: "signature-envelope-invalid")
    if not _receipt_policies_valid_v2(trust_policies):
        return SignedArtifactReceiptGuestCheckV2(
            ok: false, reason: "trust-roots-invalid")
    var matching_policy: SignedArtifactReceiptTrustPolicyV2? = nil
    for policy in trust_policies:
        if policy.signer.key_id == envelope[1]: matching_policy = Some(policy)
    if not matching_policy.?:
        return SignedArtifactReceiptGuestCheckV2(
            ok: false, reason: "signer-unknown")
    val policy = matching_policy.unwrap()
    val key_hash = sha256_u8_hex(policy.signer.public_key)
    if key_hash != receipt.expected_trust_root_sha256 or
        key_hash != receipt.subject.signer_public_key_sha256:
        return SignedArtifactReceiptGuestCheckV2(
            ok: false, reason: "trust-root-mismatch")
    if not _receipt_policy_authorizes_v2(policy, receipt.subject):
        return SignedArtifactReceiptGuestCheckV2(
            ok: false, reason: "signer-policy-rejected")
    if not pure_ed25519_verify(
        policy.signer.public_key, receipt.sam2_bytes, signature):
        return SignedArtifactReceiptGuestCheckV2(
            ok: false, reason: "signature-invalid")
    SignedArtifactReceiptGuestCheckV2(ok: true, reason: "")
