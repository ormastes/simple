"""Least-authority launch declaration for the dedicated filesystem DBD image.

This is a policy-only owner.  It deliberately shares no HTTP static-file,
HTTP listener, or WEB TLS authority with `/WEB.ELF`; it also leaves transport
implementation unchanged.
"""

use os.kernel.types.capability_types.{
    CapabilityKind, CapabilitySet, CAP_RIGHT_READ, CAP_RIGHT_WRITE, CAP_RIGHT_EXEC
}
use os.kernel.ipc.cspace_spawn.{CapGrant, AttenuationSpec}
use os.kernel.loader.server_launch_grants.{
    SIMPLEOS_SERVER_DB_KEY_V1, SIMPLEOS_SERVER_DB_CERTIFICATE_V1,
    SIMPLEOS_SERVER_DB_PRIVATE_KEY_V1, SIMPLEOS_SERVER_DATABASE_PORT_V1,
    SIMPLEOS_SERVER_DATABASE_BIND_IPV4_V1,
    ServerProtectedDataRoleV1, server_protected_data_role_v1
}
use std.common.contracts.os.server_data_namespace_v1.{
    SERVER_DATA_DATABASE_ROOT_PATH_V1
}

pub val SIMPLEOS_DBD_EXECUTABLE_V1: text = "/sys/services/dbd"
pub val SIMPLEOS_DBD_CONFIGURED_BIND_IPV4_V1: u32 =
    SIMPLEOS_SERVER_DATABASE_BIND_IPV4_V1
pub const SIMPLEOS_DBD_LAUNCH_POUCH_BUDGET_V1: i64 = 10

pub struct DbdLaunchGrantPlanV1:
    executable_identity: text
    grants: [CapGrant]

fn _dbd_attenuation_v1(mask: u32) -> AttenuationSpec:
    AttenuationSpec(rights_mask: mask, path_prefix: "", depth_limit: 0,
        single_use: false)

fn _dbd_grant_v1(label: text, requested: CapabilityKind, mask: u32) -> CapGrant:
    CapGrant(label: label, requested: requested, atten: _dbd_attenuation_v1(mask))

fn _dbd_expected_grants_v1() -> [CapGrant]:
    [
        _dbd_grant_v1("dbd.exec", CapabilityKind.FileExec(
            path_prefix: SIMPLEOS_DBD_EXECUTABLE_V1), CAP_RIGHT_EXEC),
        _dbd_grant_v1("dbd.credential.read", CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_SERVER_DB_KEY_V1), CAP_RIGHT_READ),
        _dbd_grant_v1("dbd.certificate.read", CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_SERVER_DB_CERTIFICATE_V1), CAP_RIGHT_READ),
        _dbd_grant_v1("dbd.private-key.read", CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_SERVER_DB_PRIVATE_KEY_V1), CAP_RIGHT_READ),
        # Persistence authority is confined to the canonical database subtree.
        # Separate read/write tokens keep recovery and publication explicit and
        # never grant ambient `/srv/data`, root, WEB, or executable writes.
        _dbd_grant_v1("dbd.database.read", CapabilityKind.FileRead(
            path_prefix: SERVER_DATA_DATABASE_ROOT_PATH_V1), CAP_RIGHT_READ),
        _dbd_grant_v1("dbd.database.write", CapabilityKind.FileWrite(
            path_prefix: SERVER_DATA_DATABASE_ROOT_PATH_V1), CAP_RIGHT_WRITE),
        _dbd_grant_v1("dbd.database.create", CapabilityKind.FileCreate(
            path_prefix: SERVER_DATA_DATABASE_ROOT_PATH_V1), CAP_RIGHT_WRITE),
        _dbd_grant_v1("dbd.socket.create", CapabilityKind.NetSocketCreate,
            CAP_RIGHT_READ),
        # The dedicated DBD has no public-listener migration obligation. Keep
        # its bind authority exact and non-wildcard on every target; an image
        # configuration may replace this reviewed scalar but must never use 0.
        _dbd_grant_v1("dbd.bind.ipv4", CapabilityKind.NetBindIpv4(
            address: SIMPLEOS_DBD_CONFIGURED_BIND_IPV4_V1,
            port: SIMPLEOS_SERVER_DATABASE_PORT_V1), CAP_RIGHT_READ),
        _dbd_grant_v1("dbd.listen", CapabilityKind.NetListen(
            port: SIMPLEOS_SERVER_DATABASE_PORT_V1), CAP_RIGHT_READ),
    ]

fn _dbd_grant_count_v1(grants: [CapGrant], expected: CapGrant) -> i64:
    var count: i64 = 0
    for grant in grants:
        if grant.label == expected.label and grant.requested == expected.requested and
           grant.atten.rights_mask == expected.atten.rights_mask and
           grant.atten.path_prefix == expected.atten.path_prefix and
           grant.atten.depth_limit == expected.atten.depth_limit and
           grant.atten.single_use == expected.atten.single_use:
            count = count + 1
    count

pub fn dbd_launch_grant_plan_valid_v1(plan: DbdLaunchGrantPlanV1) -> bool:
    if plan.executable_identity != SIMPLEOS_DBD_EXECUTABLE_V1 or
       SIMPLEOS_DBD_CONFIGURED_BIND_IPV4_V1 == 0u32 or
       plan.grants.len() != SIMPLEOS_DBD_LAUNCH_POUCH_BUDGET_V1 or
       server_protected_data_role_v1(plan.executable_identity) !=
           ServerProtectedDataRoleV1.DedicatedDbd:
        return false
    for expected in _dbd_expected_grants_v1():
        if _dbd_grant_count_v1(plan.grants, expected) != 1:
            return false
    true

pub fn dbd_launch_grant_plan_v1(executable_path: text) -> DbdLaunchGrantPlanV1:
    var grants: [CapGrant] = []
    if executable_path == SIMPLEOS_DBD_EXECUTABLE_V1 and
       SIMPLEOS_DBD_CONFIGURED_BIND_IPV4_V1 != 0u32:
        grants = _dbd_expected_grants_v1()
    DbdLaunchGrantPlanV1(
        executable_identity: if grants.len() == 0: "" else: executable_path,
        grants: grants)

pub fn dbd_launch_grants_v1(executable_path: text) -> [CapGrant]:
    val plan = dbd_launch_grant_plan_v1(executable_path)
    if not dbd_launch_grant_plan_valid_v1(plan): return []
    plan.grants

pub fn dbd_launch_caps_exact_v1(caps: CapabilitySet) -> bool:
    if not caps.is_pledged or caps.caps.len() != SIMPLEOS_DBD_LAUNCH_POUCH_BUDGET_V1:
        return false
    for expected in _dbd_expected_grants_v1():
        var count: i64 = 0
        for token in caps.caps:
            if token.kind == expected.requested: count = count + 1
        if count != 1: return false
    true
