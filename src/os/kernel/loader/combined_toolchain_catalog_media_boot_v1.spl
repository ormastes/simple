"""One-shot boot ingestion for Clang and the five primary tool payloads.

Both release readers authenticate stable filesystem media before this owner
opens the irreversible installed-artifact catalog transaction.  Simplebox is
owned solely by the primary-tool plan, so the combined set contains exactly
fourteen records and is sealed once.
"""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.fs_driver.mount_table.{MountTable}
use std.fs_driver.error.{FsError}
use os.installer.simplebox_signed_catalog_provisioner_v1.{
    SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1}
use os.kernel.loader.clang_catalog_media_boot_v1.{
    ClangCatalogMediaBootPolicyV1, clang_catalog_media_boot_prepare_v1}
use os.kernel.loader.clang_sysroot_catalog_bundle_v1.{
    CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1, ClangSysrootCatalogBundleV1}
use os.kernel.loader.simplebox_catalog_media_boot_v1.{
    SimpleboxCatalogMediaBootPolicyV1,
    simplebox_catalog_media_canonical_layout_v1,
    simplebox_catalog_media_boot_prepare_from_table_v1}
use os.kernel.loader.simplebox_pinned_catalog_image_v1.{
    SimpleboxPinnedCatalogImageV1,
    simplebox_pinned_catalog_image_ingest_v1}
use os.kernel.loader.primary_tool_catalog_media_boot_v1.{
    PRIMARY_TOOL_RELEASE_DESCRIPTOR_PATH_V1,
    PrimaryToolCatalogMediaBootPolicyV1,
    primary_tool_catalog_media_payload_paths_v1,
    primary_tool_catalog_media_scr1_paths_v1,
    primary_tool_catalog_media_boot_prepare_v1}
use os.kernel.loader.primary_linux_tool_catalog_bundle_v1.{
    PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1, PrimaryLinuxToolCatalogPlanV1}
use os.kernel.loader.primary_tool_release_descriptor_v1.{
    PRIMARY_TOOL_RELEASE_PAYLOAD_MAX_BYTES_V1,
    PRIMARY_TOOL_RELEASE_MEDIA_MAX_BYTES_V1}
use os.kernel.loader.primary_tool_release_descriptor_codec_v1.{
    PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1}
use os.kernel.loader.installed_artifact_boot_composition_v1.{
    installed_artifact_boot_compose_and_populate_v1}

pub enum CombinedToolchainCatalogMediaBootErrorV1:
    DescriptorPresenceRejected
    ClangRejected
    PrimaryRejected
    LegacySimpleboxRejected
    ReleaseIdentityMismatch

pub enum CombinedToolchainCatalogMediaModeV1:
    Legacy
    Combined
    Reject

pub(package) struct CombinedToolchainCatalogMediaBootPreparedV1:
    mode: CombinedToolchainCatalogMediaModeV1
    release_id: text
    clang_release_id: text
    primary_release_id: text
    clang: ClangSysrootCatalogBundleV1?
    primary: PrimaryLinuxToolCatalogPlanV1?
    legacy_simplebox: SimpleboxPinnedCatalogImageV1?

pub fn combined_toolchain_catalog_media_mode_v1(
    primary_descriptor_present: bool,
    primary_release_authenticated: bool,
) -> CombinedToolchainCatalogMediaModeV1:
    """Keep producer publication and consumer selection fail-closed."""
    if not primary_descriptor_present:
        return CombinedToolchainCatalogMediaModeV1.Legacy
    if primary_release_authenticated:
        return CombinedToolchainCatalogMediaModeV1.Combined
    CombinedToolchainCatalogMediaModeV1.Reject

pub(package) fn combined_toolchain_catalog_media_boot_prepare_v1(
    table: MountTable,
    target: ManifestTarget,
    pinned_key_id: text,
    pinned_public_key_hex: text,
    pinned_public_key_sha256: text,
) -> Result<CombinedToolchainCatalogMediaBootPreparedV1,
            CombinedToolchainCatalogMediaBootErrorV1>:
    """Authenticate both complete releases without catalog mutation."""
    var primary_present = false
    match table.stat(PRIMARY_TOOL_RELEASE_DESCRIPTOR_PATH_V1):
        case Ok(_): primary_present = true
        case Err(FsError.NotFound): primary_present = false
        case Err(_):
            return Err(
                CombinedToolchainCatalogMediaBootErrorV1.DescriptorPresenceRejected)

    val clang = clang_catalog_media_boot_prepare_v1(
        table, ClangCatalogMediaBootPolicyV1(
            target: target,
            pinned_key_id: pinned_key_id,
            pinned_public_key_hex: pinned_public_key_hex,
            pinned_public_key_sha256: pinned_public_key_sha256))
    if not clang.ok:
        return Err(CombinedToolchainCatalogMediaBootErrorV1.ClangRejected)

    if not primary_present:
        val legacy = simplebox_catalog_media_boot_prepare_from_table_v1(
            table, SimpleboxCatalogMediaBootPolicyV1(
                target: target,
                layouts: [simplebox_catalog_media_canonical_layout_v1()],
                pinned_key_id: pinned_key_id,
                pinned_public_key_hex: pinned_public_key_hex,
                pinned_public_key_sha256: pinned_public_key_sha256),
            Some(clang.bundle))
        if legacy.is_err():
            return Err(
                CombinedToolchainCatalogMediaBootErrorV1.LegacySimpleboxRejected)
        return Ok(CombinedToolchainCatalogMediaBootPreparedV1(
            mode: combined_toolchain_catalog_media_mode_v1(false, false),
            release_id: "", clang_release_id: clang.release_id,
            primary_release_id: "", clang: nil, primary: nil,
            legacy_simplebox: Some(legacy.unwrap())))

    val primary = primary_tool_catalog_media_boot_prepare_v1(
        table, PrimaryToolCatalogMediaBootPolicyV1(
            expected_target: target,
            ptrd_path: PRIMARY_TOOL_RELEASE_DESCRIPTOR_PATH_V1,
            payload_paths: primary_tool_catalog_media_payload_paths_v1(),
            scr1_paths: primary_tool_catalog_media_scr1_paths_v1(),
            ptrd_max_bytes: PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1,
            payload_max_bytes: PRIMARY_TOOL_RELEASE_PAYLOAD_MAX_BYTES_V1,
            scr1_max_bytes: SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1,
            aggregate_max_bytes: PRIMARY_TOOL_RELEASE_MEDIA_MAX_BYTES_V1,
            pinned_key_id: pinned_key_id,
            pinned_public_key_hex: pinned_public_key_hex,
            pinned_public_key_sha256: pinned_public_key_sha256))
    if not primary.ok:
        return Err(CombinedToolchainCatalogMediaBootErrorV1.PrimaryRejected)
    if clang.release_id == "" or clang.release_id != primary.release_id:
        return Err(
            CombinedToolchainCatalogMediaBootErrorV1.ReleaseIdentityMismatch)

    Ok(CombinedToolchainCatalogMediaBootPreparedV1(
        mode: combined_toolchain_catalog_media_mode_v1(true, true),
        release_id: clang.release_id,
        clang_release_id: clang.release_id,
        primary_release_id: primary.release_id,
        clang: Some(clang.bundle),
        primary: Some(primary.plan), legacy_simplebox: nil))

pub(package) fn combined_toolchain_catalog_media_boot_populate_v1(
    prepared: CombinedToolchainCatalogMediaBootPreparedV1,
) -> bool:
    """Consume an authenticated combined plan after VFS authority is restored."""
    if prepared.mode == CombinedToolchainCatalogMediaModeV1.Legacy:
        if (prepared.legacy_simplebox.? and not prepared.clang.? and
            not prepared.primary.? and prepared.release_id == "" and
            prepared.primary_release_id == ""):
            return simplebox_pinned_catalog_image_ingest_v1(
                prepared.legacy_simplebox.unwrap()).ok
        return false
    if (prepared.mode != CombinedToolchainCatalogMediaModeV1.Combined or
        not prepared.clang.? or not prepared.primary.? or
        prepared.legacy_simplebox.?):
        return false
    if (prepared.release_id == "" or
        prepared.release_id != prepared.clang_release_id or
        prepared.release_id != prepared.primary_release_id):
        return false
    # Primary owns the only Simplebox row.  Supplying the legacy Simplebox
    # bundle here would duplicate its canonical path and payload identity.
    val populated = installed_artifact_boot_compose_and_populate_v1(
        nil, Some(prepared.clang.unwrap()), Some(prepared.primary.unwrap()))
    populated.ok and populated.accepted_records ==
        CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1 +
            PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1
