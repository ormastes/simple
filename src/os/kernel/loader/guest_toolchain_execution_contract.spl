use os.services.process_execution_evidence.{ProcessExecutionStageV1, ProcessExecutionResultV1}

pub struct GuestToolchainHelloExpectedV1:
    target_triple: text
    filesystem_name: text
    llvm_path: text
    llvm_sha256: text
    clang_path: text
    clang_sha256: text
    lld_path: text
    lld_sha256: text
    source_path: text
    source_sha256: text
    object_path: text
    object_sha256: text
    executable_path: text
    executable_sha256: text
    expected_stdout: text

fn _canonical_expected(expected: GuestToolchainHelloExpectedV1) -> bool:
    expected.target_triple == "x86_64-unknown-simpleos" and
        (expected.filesystem_name == "fat32" or expected.filesystem_name == "dbfs" or
         expected.filesystem_name == "nvfs") and expected.llvm_path == "/usr/bin/llvm-ar" and
        expected.clang_path == "/usr/bin/clang" and expected.lld_path == "/usr/bin/ld.lld" and
        expected.source_path == "/work/hello.c" and expected.object_path == "/work/hello.o" and
        expected.executable_path == "/work/hello.elf" and
        expected.expected_stdout == "hello from SimpleOS LLVM\n"

pub fn guest_toolchain_hello_execution_chain_v1_validate(expected: GuestToolchainHelloExpectedV1, clang_result: ProcessExecutionResultV1, lld_result: ProcessExecutionResultV1, hello_result: ProcessExecutionResultV1) -> bool:
    _canonical_expected(expected) and clang_result.stage == ProcessExecutionStageV1.ClangCompile and
        lld_result.stage == ProcessExecutionStageV1.LldLink and hello_result.stage == ProcessExecutionStageV1.HelloRun and
        clang_result.executable_path == expected.clang_path and lld_result.executable_path == expected.lld_path and
        hello_result.executable_path == expected.executable_path and clang_result.executable_sha256 == expected.clang_sha256 and
        lld_result.executable_sha256 == expected.lld_sha256 and hello_result.executable_sha256 == expected.executable_sha256 and
        clang_result.input_sha256 == expected.source_sha256 and clang_result.result_sha256 == expected.object_sha256 and
        lld_result.input_sha256 == expected.object_sha256 and lld_result.result_sha256 == expected.executable_sha256 and
        hello_result.input_sha256 == expected.executable_sha256 and hello_result.result_sha256 == expected.executable_sha256 and
        clang_result.exit_code == 0 and lld_result.exit_code == 0 and hello_result.exit_code == 0 and
        clang_result.captured_stdout == "" and clang_result.captured_stderr == "" and
        lld_result.captured_stdout == "" and lld_result.captured_stderr == "" and
        hello_result.captured_stdout == expected.expected_stdout and hello_result.captured_stderr == "" and
        clang_result.filesystem_name == expected.filesystem_name and lld_result.filesystem_name == expected.filesystem_name and
        hello_result.filesystem_name == expected.filesystem_name and clang_result.filesystem_generation != 0u64 and
        clang_result.filesystem_generation == lld_result.filesystem_generation and
        clang_result.filesystem_generation == hello_result.filesystem_generation and
        clang_result.child_id != lld_result.child_id and clang_result.child_id != hello_result.child_id and
        lld_result.child_id != hello_result.child_id and clang_result.parent_id == lld_result.parent_id and
        clang_result.parent_id == hello_result.parent_id

export GuestToolchainHelloExpectedV1, guest_toolchain_hello_execution_chain_v1_validate
