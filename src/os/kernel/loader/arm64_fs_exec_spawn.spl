# ARM64 filesystem-exec scheduler bridge.

use os.kernel.arch.arch_context.{Architecture}
use os.kernel.arch.user_entry_bridge.{dispatch_fs_exec_user_handoff}
use os.kernel.loader.fs_exec_spawn.{fs_exec_prepare_spawn}
use os.kernel.abi.syscall_shim.{shim_init}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.log.klog.{KernelLog}
use os.services.netstack.netstack_init.{net_arm64_task_teardown}
use os.kernel.types.task_types.{TaskId}
use os.kernel.types.capability_types.{CapabilityKind, CapabilitySet, CapabilityToken}

extern fn serial_println(msg: text)

fn _arm64_launch_token(kind: CapabilityKind, owner: u64, token_id: u64) -> CapabilityToken:
    CapabilityToken(kind: kind, generation: token_id, owner: owner,
        token_id: token_id, parent_token_id: 0u64, depth: 0)

fn _arm64_add_file_token(tokens: [CapabilityToken], kind: CapabilityKind,
        owner: u64, next_id: u64) -> ([CapabilityToken], u64):
    tokens.push(_arm64_launch_token(kind, owner, next_id))
    (tokens, next_id + 1u64)

fn _arm64_add_server_persistence_path(tokens: [CapabilityToken], path: text,
        owner: u64, next_id: u64) -> ([CapabilityToken], u64):
    var result = _arm64_add_file_token(tokens,
        CapabilityKind.FileRead(path_prefix: path), owner, next_id)
    result = _arm64_add_file_token(result.0,
        CapabilityKind.FileWrite(path_prefix: path), owner, result.1)
    _arm64_add_file_token(result.0,
        CapabilityKind.FileCreate(path_prefix: path), owner, result.1)

pub fn arm64_fs_exec_launch_caps(path: text, argv: [text], owner: u64) -> CapabilitySet:
    """Build the pledged, non-delegable authority for one payload launch."""
    var tokens: [CapabilityToken] = []
    var next_id: u64 = 1u64
    tokens.push(_arm64_launch_token(CapabilityKind.NetConnect(port: 0), owner, next_id))
    next_id = next_id + 1u64
    tokens.push(_arm64_launch_token(CapabilityKind.NetListen(port: 0), owner, next_id))
    next_id = next_id + 1u64
    tokens.push(_arm64_launch_token(CapabilityKind.FileExec(path_prefix: path), owner, next_id))
    next_id = next_id + 1u64
    tokens.push(_arm64_launch_token(CapabilityKind.FileRead(path_prefix: path), owner, next_id))
    next_id = next_id + 1u64
    # Absolute argv entries are the only additional filesystem inputs known at
    # launch. Flags and other scalar arguments must not turn into path grants.
    for arg in argv:
        if arg.starts_with("/") and arg != path:
            tokens.push(_arm64_launch_token(CapabilityKind.FileRead(path_prefix: arg), owner, next_id))
            next_id = next_id + 1u64
    # The server payload consumes two immutable mounted inputs and the exact
    # canonical database/WAL names. File capabilities use component-aware
    # prefix matching, so granting each complete filename does not authorize a
    # sibling or the filesystem root.
    if path == "/SERVERS.ELF":
        var added = _arm64_add_file_token(tokens,
            CapabilityKind.FileRead(path_prefix: "/SYS/SERVER.HTM"), owner, next_id)
        added = _arm64_add_file_token(added.0,
            CapabilityKind.FileRead(path_prefix: "/SYS/SRVDB.KEY"), owner, added.1)
        for db_path in [
            "/SERVER.SDN", "/SERVER.SDN.lock", "/SERVER.SDN.tmp",
            "/SERVER.SDN.wal", "/SERVER.SDN.wal.lock", "/SERVER.SDN.wal.tmp"
        ]:
            added = _arm64_add_server_persistence_path(added.0, db_path, owner, added.1)
        tokens = added.0
    CapabilitySet(caps: tokens, is_pledged: true)

pub fn arm64_fs_exec_spawn(path: text, argv: [text], envp: [text]) -> i64:
    val prepared = fs_exec_prepare_spawn(path, argv, envp)
    if prepared.pid <= 0:
        return prepared.pid
    serial_println("[fs-exec] spawn:pid={prepared.pid} path={path}")
    prepared.pid

pub fn arm64_fs_exec_spawn_ring3(path: text, argv: [text], envp: [text]) -> i64:
    """Prepare one filesystem image, bind its kernel owners, and enter EL0.

    The syscall shim must observe the exact scheduler that owns the prepared
    address space.  A bootstrap shim would make file/network syscalls operate
    on a different process table and is therefore never a valid EL0 handoff.
    The per-launch IPC/log owners are released from the global shim after the
    user process returns.
    """
    val prepared = fs_exec_prepare_spawn(path, argv, envp)
    if prepared.pid <= 0:
        return prepared.pid
    serial_println("[fs-exec] spawn:pid={prepared.pid} path={path}")
    var launch_ipc = IpcManager.new()
    val launch_id = TaskId(id: prepared.pid as u64)
    # The shim has a fresh canonical capability owner, so explicitly install a
    # least-privilege record for the scheduler-owned task before making it live.
    launch_ipc.cap_manager.init_task(
        launch_id, arm64_fs_exec_launch_caps(path, argv, launch_id.id))
    val launch_log = KernelLog.new(256)
    shim_init(prepared.scheduler, launch_ipc, launch_log)
    val rc = dispatch_fs_exec_user_handoff(Architecture.Arm64, prepared.pid as u64, prepared.scheduler)
    net_arm64_task_teardown(launch_id.id)
    shim_init(Scheduler.new_bootstrap(), IpcManager.new(), KernelLog.new(64))
    rc

pub fn arm64_fs_exec_load_and_launch_hello_world() -> i64:
    """Load `/sys/apps/hello_world.smf` and emit genuine load + launch proofs.

    `ELF_LOAD_OK`/`SMF_CLI_LAUNCH_OK` are backed by the real arm64 ELF parse
    (validated header, parsed `entry`, counted PT_LOAD segments) plus the
    segment-stage-to-phys + user-AS page-map the scheduler performs at register
    time — the same load+launch-proof bar riscv64/x86_64 assert. This is NOT
    EL0 usercode execution (no arch `eret`s into the marker payload yet).
    """
    val prepared = fs_exec_prepare_spawn("/sys/apps/hello_world.smf", [], [])
    if prepared.pid <= 0:
        return prepared.pid
    serial_println("ELF_LOAD_OK arch=aarch64 app=/sys/apps/hello_world.smf entry={prepared.entry}")
    serial_println("SMF_CLI_LAUNCH_OK app=/sys/apps/hello_world.smf pid={prepared.pid}")
    prepared.pid
