"""Minimal nonce-bound RV64 ELF used by real filesystem execution.

Every output byte is produced by a U-mode ecall 60 and termination is produced
by ecall 0 with status 37.  The same decoder is a pure simulator oracle for
the staged ELF; the live loader must still read these exact bytes from FAT.
"""

pub val RV64_REAL_EXEC_EXIT_CODE: i64 = 37
pub val RV64_REAL_EXEC_PATH: text = "/SYS/APPS/FSEXEC.ELF"

pub struct Rv64RealExecSimulation:
    valid: bool
    stdout: text
    exit_code: i64

extern fn rt_string_from_byte_array(arr: [u8]) -> text

fn _push16(buffer: [u8], value: u64) -> [u8]:
    buffer.push((value & 0xff).to_u8())
    buffer.push(((value >> 8) & 0xff).to_u8())
    buffer

fn _push32(buffer: [u8], value: u64) -> [u8]:
    var bytes = buffer
    bytes = _push16(bytes, value)
    bytes = _push16(bytes, value >> 16)
    bytes

fn _push64(buffer: [u8], value: u64) -> [u8]:
    var bytes = buffer
    bytes = _push32(bytes, value)
    bytes = _push32(bytes, value >> 32)
    bytes

fn _read32(bytes: [u8], offset: i64) -> u64:
    bytes[offset].to_u64() |
        (bytes[offset + 1].to_u64() << 8) |
        (bytes[offset + 2].to_u64() << 16) |
        (bytes[offset + 3].to_u64() << 24)

fn _addi(rd: u64, imm: u64) -> u64:
    ((imm & 0xfff) << 20) | (rd << 7) | 0x13

fn _push_instruction(buffer: [u8], instruction: u64) -> [u8]:
    _push32(buffer, instruction)

fn _nonce_valid(nonce: text) -> bool:
    if nonce.len() < 16 or nonce.len() > 128:
        return false
    var i = 0
    while i < nonce.len():
        val code = nonce.char_code_at(i)
        if code < 0x21 or code > 0x7e:
            return false
        i = i + 1
    true

pub fn rv64_real_exec_stdout(nonce: text) -> text:
    if not _nonce_valid(nonce):
        return ""
    "SIMPLEOS_FS_EXEC_OK arch=riscv64 nonce={nonce}\n"

pub fn rv64_real_exec_elf(nonce: text) -> [u8]:
    val message = rv64_real_exec_stdout(nonce)
    if message == "":
        return []
    val code_size = (message.len() * 12 + 12).to_u64()
    var buffer: [u8] = [0x7f, 0x45, 0x4c, 0x46, 2, 1, 1, 0]
    while buffer.len() < 16:
        buffer.push(0)
    buffer = _push16(buffer, 2)
    buffer = _push16(buffer, 243)
    buffer = _push32(buffer, 1)
    buffer = _push64(buffer, 0x400000)
    buffer = _push64(buffer, 64)
    buffer = _push64(buffer, 0)
    buffer = _push32(buffer, 0)
    buffer = _push16(buffer, 64)
    buffer = _push16(buffer, 56)
    buffer = _push16(buffer, 1)
    buffer = _push16(buffer, 0)
    buffer = _push16(buffer, 0)
    buffer = _push16(buffer, 0)
    buffer = _push32(buffer, 1)
    buffer = _push32(buffer, 5)
    buffer = _push64(buffer, 0x1000)
    buffer = _push64(buffer, 0x400000)
    buffer = _push64(buffer, 0x400000)
    buffer = _push64(buffer, code_size)
    buffer = _push64(buffer, code_size)
    buffer = _push64(buffer, 0x1000)
    while buffer.len() < 0x1000:
        buffer.push(0)
    var i = 0
    while i < message.len():
        buffer = _push_instruction(buffer, _addi(17, 60))
        buffer = _push_instruction(buffer, _addi(10, message.char_code_at(i).to_u64()))
        buffer = _push_instruction(buffer, 0x00000073)
        i = i + 1
    buffer = _push_instruction(buffer, _addi(17, 0))
    buffer = _push_instruction(buffer, _addi(10, RV64_REAL_EXEC_EXIT_CODE.to_u64()))
    _push_instruction(buffer, 0x00000073)

pub fn rv64_simulate_real_exec_elf(bytes: [u8]) -> Rv64RealExecSimulation:
    if bytes.len() < 0x100c or bytes[0] != 0x7f or bytes[4] != 2 or
            _read32(bytes, 20) != 1 or _read32(bytes, 64) != 1 or
            _read32(bytes, 68) != 5:
        return Rv64RealExecSimulation(valid: false, stdout: "", exit_code: -1)
    var stdout_bytes: [u8] = []
    var offset = 0x1000
    while offset + 12 <= bytes.len():
        val set_id = _read32(bytes, offset)
        val set_arg = _read32(bytes, offset + 4)
        val ecall = _read32(bytes, offset + 8)
        if ecall != 0x00000073:
            return Rv64RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)
        val syscall_id = (set_id >> 20) & 0xfff
        val arg = (set_arg >> 20) & 0xfff
        if set_id != _addi(17, syscall_id) or set_arg != _addi(10, arg):
            return Rv64RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)
        if syscall_id == 60:
            stdout_bytes.push(arg.to_u8())
        elif syscall_id == 0 and offset + 12 == bytes.len():
            return Rv64RealExecSimulation(
                valid: arg.to_i64() == RV64_REAL_EXEC_EXIT_CODE,
                stdout: rt_string_from_byte_array(stdout_bytes), exit_code: arg.to_i64())
        else:
            return Rv64RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)
        offset = offset + 12
    Rv64RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)

export Rv64RealExecSimulation
export rv64_real_exec_stdout, rv64_real_exec_elf, rv64_simulate_real_exec_elf
