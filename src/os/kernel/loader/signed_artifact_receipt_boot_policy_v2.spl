"""Authenticate boot-media SCR2 policy and project non-self-issued trust.

The decoded policy cannot select its authenticating root.  No SCR2 trust
projection is returned until an independently pinned boot root authenticates
the canonical SBE2 envelope.
"""

use std.common.crypto.ed25519.{pure_ed25519_verify}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.structural.execution.simple_artifact_receipt_boot_policy_v2_codec.{
    SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_BYTES,
    simple_artifact_receipt_boot_policy_envelope_decode_v2
}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1
}
use os.kernel.loader.signed_artifact_receipt_verifier_v2.{
    SignedArtifactReceiptTrustPolicyV2
}
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.loader.signed_catalog_snapshot_reader_v1.{
    signed_catalog_snapshot_read_v1
}
use std.fs_driver.mount_table.{MountTable, StableFileSnapshotSealV1}
use os.services.vfs.vfs_boot_state.{
    vfs_state_mount_table_owner_handle_v1,
    vfs_state_mount_table_lease_begin_v1,
    vfs_state_mount_table_lease_restore_v1
}

pub const SIGNED_ARTIFACT_RECEIPT_BOOT_POLICY_PATH_V2: text =
    "/boot/catalog/scr2-policy.sbe2"

pub enum SignedArtifactReceiptBootPolicyErrorV2:
    None
    RootRejected
    MediaRejected
    PolicyRejected
    SignatureRejected

struct _AuthenticatedBootPolicyV2:
    ok: bool
    error: SignedArtifactReceiptBootPolicyErrorV2
    policy_identity: text
    policy: SignedArtifactReceiptTrustPolicyV2?
    observation: StableFileSnapshotSealV1?

pub struct SignedArtifactReceiptLocalBootPolicyV2:
    exact_local_target: ManifestTarget
    trust_policy: SignedArtifactReceiptTrustPolicyV2

pub struct SignedArtifactReceiptLocalBootPolicyAdmissionV2:
    ok: bool
    error: SignedArtifactReceiptBootPolicyErrorV2
    policy_identity: text
    bound_policy: SignedArtifactReceiptLocalBootPolicyV2?
    observation: StableFileSnapshotSealV1?

fn _fail_v2(
    error: SignedArtifactReceiptBootPolicyErrorV2,
) -> _AuthenticatedBootPolicyV2:
    _AuthenticatedBootPolicyV2(
        ok: false, error: error, policy_identity: "", policy: nil,
        observation: nil)

fn _local_fail_v2(
    error: SignedArtifactReceiptBootPolicyErrorV2,
) -> SignedArtifactReceiptLocalBootPolicyAdmissionV2:
    SignedArtifactReceiptLocalBootPolicyAdmissionV2(
        ok: false, error: error, policy_identity: "", bound_policy: nil,
        observation: nil)

fn _root_valid_v2(root: ExecutableManifestTrustedSignerV1) -> bool:
    if root.key_id.len() == 0 or root.key_id.len() > 128 or
        root.key_id.contains(":") or root.public_key.len() != 32:
        return false
    var index: i64 = 0
    while index < root.key_id.len():
        val code = root.key_id.char_code_at(index)
        if code < 33 or code > 126: return false
        index = index + 1
    true

fn _target_equal_v2(left: ManifestTarget, right: ManifestTarget) -> bool:
    left.os == right.os and left.arch == right.arch and left.abi == right.abi

fn _bind_target_v2(
    admission: _AuthenticatedBootPolicyV2,
    exact_local_target: ManifestTarget,
) -> SignedArtifactReceiptLocalBootPolicyAdmissionV2:
    """Narrow authenticated media policy to one proven local boot target."""
    if not admission.ok: return _local_fail_v2(admission.error)
    if not admission.policy.? or
        exact_local_target.os != "simpleos" or
        exact_local_target.abi != "simpleos":
        return _local_fail_v2(SignedArtifactReceiptBootPolicyErrorV2.PolicyRejected)
    val policy = admission.policy.unwrap()
    var match_count: i64 = 0
    for allowed in policy.allowed_targets:
        if _target_equal_v2(allowed, exact_local_target):
            match_count = match_count + 1
    if match_count != 1:
        return _local_fail_v2(SignedArtifactReceiptBootPolicyErrorV2.PolicyRejected)
    val narrowed = SignedArtifactReceiptTrustPolicyV2(
        signer: policy.signer,
        allowed_authority_identities: policy.allowed_authority_identities,
        allowed_roles: policy.allowed_roles,
        allowed_targets: [exact_local_target])
    SignedArtifactReceiptLocalBootPolicyAdmissionV2(
        ok: true, error: SignedArtifactReceiptBootPolicyErrorV2.None,
        policy_identity: admission.policy_identity,
        bound_policy: Some(SignedArtifactReceiptLocalBootPolicyV2(
            exact_local_target: exact_local_target, trust_policy: narrowed)),
        observation: admission.observation)

fn _authenticate_v2(
    bytes: [u8],
    independently_pinned_boot_root: ExecutableManifestTrustedSignerV1,
) -> _AuthenticatedBootPolicyV2:
    """Authenticate bytes; never accept a root named only by those bytes."""
    if not _root_valid_v2(independently_pinned_boot_root):
        return _fail_v2(SignedArtifactReceiptBootPolicyErrorV2.RootRejected)
    val decoded = simple_artifact_receipt_boot_policy_envelope_decode_v2(bytes)
    if not decoded.?:
        return _fail_v2(SignedArtifactReceiptBootPolicyErrorV2.PolicyRejected)
    val envelope = decoded.unwrap()
    val root_sha256 = sha256_u8_hex(independently_pinned_boot_root.public_key)
    if envelope.boot_signer_key_id != independently_pinned_boot_root.key_id or
        envelope.expected_boot_root_sha256 != root_sha256:
        return _fail_v2(SignedArtifactReceiptBootPolicyErrorV2.RootRejected)
    if not pure_ed25519_verify(
        independently_pinned_boot_root.public_key, envelope.signing_bytes,
        envelope.detached_signature):
        return _fail_v2(SignedArtifactReceiptBootPolicyErrorV2.SignatureRejected)
    val subject = envelope.subject
    val projected = SignedArtifactReceiptTrustPolicyV2(
        signer: ExecutableManifestTrustedSignerV1(
            key_id: subject.delegated_signer_key_id,
            public_key: subject.delegated_public_key),
        allowed_authority_identities: subject.allowed_authority_identities,
        allowed_roles: subject.allowed_roles,
        allowed_targets: subject.allowed_targets)
    _AuthenticatedBootPolicyV2(
        ok: true, error: SignedArtifactReceiptBootPolicyErrorV2.None,
        policy_identity: subject.policy_identity, policy: Some(projected),
        observation: nil)

fn _read_v2(
    table: MountTable,
    independently_pinned_boot_root: ExecutableManifestTrustedSignerV1,
) -> _AuthenticatedBootPolicyV2:
    """Read one bounded stable snapshot from the canonical boot-media path."""
    val snapshot = signed_catalog_snapshot_read_v1(
        table, SIGNED_ARTIFACT_RECEIPT_BOOT_POLICY_PATH_V2,
        SIMPLE_ARTIFACT_RECEIPT_BOOT_POLICY_V2_MAX_BYTES.to_u64())
    if snapshot.is_err():
        return _fail_v2(SignedArtifactReceiptBootPolicyErrorV2.MediaRejected)
    val observed = snapshot.unwrap()
    var admission = _authenticate_v2(
        observed.bytes, independently_pinned_boot_root)
    if not admission.ok: return admission
    admission.observation = Some(observed.seal)
    admission

fn _read_canonical_v2(
    independently_pinned_boot_root: ExecutableManifestTrustedSignerV1,
) -> _AuthenticatedBootPolicyV2:
    """Acquire and always restore the boot VFS owner lease."""
    val owner = vfs_state_mount_table_owner_handle_v1()
    if not owner.?:
        return _fail_v2(SignedArtifactReceiptBootPolicyErrorV2.MediaRejected)
    val leased = vfs_state_mount_table_lease_begin_v1(owner.unwrap())
    if not leased.?:
        return _fail_v2(SignedArtifactReceiptBootPolicyErrorV2.MediaRejected)
    val lease = leased.unwrap()
    val result = _read_v2(
        lease.table, independently_pinned_boot_root)
    if not vfs_state_mount_table_lease_restore_v1(lease):
        return _fail_v2(SignedArtifactReceiptBootPolicyErrorV2.MediaRejected)
    result

pub(package) fn signed_artifact_receipt_boot_policy_authenticate_x86_64_v2(
    bytes: [u8], root: ExecutableManifestTrustedSignerV1,
) -> SignedArtifactReceiptLocalBootPolicyAdmissionV2:
    _bind_target_v2(_authenticate_v2(bytes, root), ManifestTarget(
        os: "simpleos", arch: "x86_64", abi: "simpleos"))

pub(package) fn signed_artifact_receipt_boot_policy_authenticate_arm64_v2(
    bytes: [u8], root: ExecutableManifestTrustedSignerV1,
) -> SignedArtifactReceiptLocalBootPolicyAdmissionV2:
    _bind_target_v2(_authenticate_v2(bytes, root), ManifestTarget(
        os: "simpleos", arch: "aarch64", abi: "simpleos"))

pub(package) fn signed_artifact_receipt_boot_policy_authenticate_riscv64_v2(
    bytes: [u8], root: ExecutableManifestTrustedSignerV1,
) -> SignedArtifactReceiptLocalBootPolicyAdmissionV2:
    _bind_target_v2(_authenticate_v2(bytes, root), ManifestTarget(
        os: "simpleos", arch: "riscv64", abi: "simpleos"))

pub(package) fn signed_artifact_receipt_boot_policy_read_x86_64_v2(
    root: ExecutableManifestTrustedSignerV1,
) -> SignedArtifactReceiptLocalBootPolicyAdmissionV2:
    _bind_target_v2(_read_canonical_v2(root), ManifestTarget(
        os: "simpleos", arch: "x86_64", abi: "simpleos"))

pub(package) fn signed_artifact_receipt_boot_policy_read_arm64_v2(
    root: ExecutableManifestTrustedSignerV1,
) -> SignedArtifactReceiptLocalBootPolicyAdmissionV2:
    _bind_target_v2(_read_canonical_v2(root), ManifestTarget(
        os: "simpleos", arch: "aarch64", abi: "simpleos"))

pub(package) fn signed_artifact_receipt_boot_policy_read_riscv64_v2(
    root: ExecutableManifestTrustedSignerV1,
) -> SignedArtifactReceiptLocalBootPolicyAdmissionV2:
    _bind_target_v2(_read_canonical_v2(root), ManifestTarget(
        os: "simpleos", arch: "riscv64", abi: "simpleos"))
