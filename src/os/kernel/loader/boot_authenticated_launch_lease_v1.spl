"""One-shot, scheduler-owned boot launch authority.

The authenticated-media parsers prove an image and its sidecars; they do not
themselves identify a runnable service owner.  This owner binds those signed
coordinates to the *currently scheduled*, finite capability pouch.  It never
creates a root token, accepts the ambient `CapabilitySet.full()` representation,
or substitutes an architecture-local capability set.
"""

use os.kernel.scheduler.scheduler_types.{Scheduler}
use os.kernel.scheduler.scheduler_capability_snapshot_lease_v1.{
    scheduler_current_execution_snapshot_task_id_v1,
    scheduler_current_execution_snapshot_lifecycle_generation_v1,
    scheduler_current_execution_snapshot_exec_generation_v1,
    scheduler_current_execution_snapshot_lease_v1,
    scheduler_capability_snapshot_consume_once_v1,
    scheduler_pinned_capability_snapshot_caps_v1
}
use os.kernel.types.capability_types.{
    CapabilitySet, CapabilityToken, CapabilityKind, capability_kind_allows
}
use os.kernel.loader.spawn_recipes.{
    spawn_recipe_is_migrated, spawn_recipe_grants
}
use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}

pub struct BootAuthenticatedLaunchCoordinatesV1:
    canonical_path: text
    image_hash: text
    manifest_hash: text
    kernel_hash: text
    trust_root_hash: text
    mount_id: u64
    mount_generation: u64
    file_id: u64
    file_generation: u64
    recipe: i64

pub struct BootAuthenticatedLaunchLeaseV1:
    _slot: i64
    _generation: u64
    _nonce: u64

pub struct BootAuthenticatedLaunchGrantV1:
    caller: i64
    caller_caps: CapabilitySet

enum _BootAuthenticatedLaunchLeaseStateV1:
    Free
    Armed

struct _BootAuthenticatedLaunchLeaseSlotV1:
    generation: u64
    nonce: u64
    state: _BootAuthenticatedLaunchLeaseStateV1
    caller: u64
    caller_lifecycle_generation: u64
    caller_exec_generation: u64
    coordinates: BootAuthenticatedLaunchCoordinatesV1
    caller_caps: [CapabilityToken]

val _boot_authenticated_launch_mutex_v1: i64 = mutex_raw_create()
var _boot_authenticated_launch_slots_v1: [_BootAuthenticatedLaunchLeaseSlotV1] = []
var _boot_authenticated_launch_next_generation_v1: u64 = 1u64
var _boot_authenticated_launch_poisoned_v1: bool = false

pub fn boot_authenticated_launch_max_leases_v1() -> i64: 32

fn _boot_authenticated_launch_coordinates_valid_v1(
    coordinates: BootAuthenticatedLaunchCoordinatesV1
) -> bool:
    coordinates.canonical_path != "" and coordinates.image_hash != "" and
        coordinates.manifest_hash != "" and coordinates.kernel_hash != "" and
        coordinates.trust_root_hash != "" and coordinates.mount_id != 0u64 and
        coordinates.mount_generation != 0u64 and coordinates.file_id != 0u64 and
        coordinates.file_generation != 0u64 and
        spawn_recipe_is_migrated(coordinates.recipe)

pub fn boot_authenticated_launch_coordinates_new_v1(
    canonical_path: text, image_hash: text, manifest_hash: text,
    kernel_hash: text, trust_root_hash: text, mount_id: u64,
    mount_generation: u64, file_id: u64, file_generation: u64, recipe: i64
) -> BootAuthenticatedLaunchCoordinatesV1?:
    """Create the one canonical validated signed-launch coordinate.

    Architecture fixtures supply facts only from the retained authenticated
    open/admission path.  Centralizing construction prevents a target from
    accidentally omitting a binding field before the lease snapshots it.
    """
    val coordinates = BootAuthenticatedLaunchCoordinatesV1(
        canonical_path: canonical_path, image_hash: image_hash,
        manifest_hash: manifest_hash, kernel_hash: kernel_hash,
        trust_root_hash: trust_root_hash, mount_id: mount_id,
        mount_generation: mount_generation, file_id: file_id,
        file_generation: file_generation, recipe: recipe)
    if not _boot_authenticated_launch_coordinates_valid_v1(coordinates):
        return nil
    Some(coordinates)

fn _boot_authenticated_launch_same_coordinates_v1(
    left: BootAuthenticatedLaunchCoordinatesV1,
    right: BootAuthenticatedLaunchCoordinatesV1
) -> bool:
    left.canonical_path == right.canonical_path and
        left.image_hash == right.image_hash and
        left.manifest_hash == right.manifest_hash and
        left.kernel_hash == right.kernel_hash and
        left.trust_root_hash == right.trust_root_hash and
        left.mount_id == right.mount_id and
        left.mount_generation == right.mount_generation and
        left.file_id == right.file_id and
        left.file_generation == right.file_generation and
        left.recipe == right.recipe

fn _boot_authenticated_launch_copy_tokens_v1(
    caps: CapabilitySet
) -> [CapabilityToken]:
    var copied: [CapabilityToken] = []
    for cap in caps.caps:
        copied.push(CapabilityToken(
            kind: cap.kind, generation: cap.generation, owner: cap.owner,
            token_id: cap.token_id, parent_token_id: cap.parent_token_id,
            depth: cap.depth))
    copied

fn _boot_authenticated_launch_pouch_valid_v1(
    caller: u64, caps: CapabilitySet, recipe: i64
) -> bool:
    if caller == 0u64 or not caps.is_pledged or caps.caps.len() == 0:
        return false
    var index: i64 = 0
    while index < caps.caps.len():
        val cap = caps.caps[index]
        if cap.owner != caller or cap.generation == 0u64 or
           cap.token_id == 0u64 or cap.depth < 0:
            return false
        var prior: i64 = 0
        while prior < index:
            if caps.caps[prior].token_id == cap.token_id: return false
            prior = prior + 1
        index = index + 1
    # The boot task must already hold every concrete source grant that its
    # launch recipe will attenuate.  Issuing a lease is a validation/snapshot,
    # not a hidden root-minting operation.
    for grant in spawn_recipe_grants(recipe):
        var found = false
        for cap in caps.caps:
            if cap.depth > 0 and capability_kind_allows(cap.kind, grant.requested):
                found = true
        if not found: return false
    true

fn _boot_authenticated_launch_unlock_v1() -> bool:
    if mutex_raw_unlock(_boot_authenticated_launch_mutex_v1): return true
    _boot_authenticated_launch_poisoned_v1 = true
    false

pub fn boot_authenticated_launch_lease_issue_current_v1(
    scheduler: Scheduler,
    coordinates: BootAuthenticatedLaunchCoordinatesV1
) -> BootAuthenticatedLaunchLeaseV1?:
    """Snapshot a real current scheduler task for exactly one signed launch."""
    if not _boot_authenticated_launch_coordinates_valid_v1(coordinates): return nil
    # Use the scheduler's canonical current-execution snapshot rather than
    # independently scanning mutable TCB state.  The snapshot atomically
    # binds task id, lifecycle/exec generation, and concrete pledged tokens;
    # consuming it here makes a failed or replayed boot issue burn only this
    # derived observation, never minting authority.
    val execution = scheduler.current_execution_snapshot_v1()
    if not execution.?: return nil
    val current = execution.unwrap()
    val caller = scheduler_current_execution_snapshot_task_id_v1(current)
    val caller_lifecycle_generation =
        scheduler_current_execution_snapshot_lifecycle_generation_v1(current)
    val caller_exec_generation =
        scheduler_current_execution_snapshot_exec_generation_v1(current)
    val pinned = scheduler_capability_snapshot_consume_once_v1(
        scheduler_current_execution_snapshot_lease_v1(current), caller,
        caller_lifecycle_generation, caller_exec_generation)
    if not pinned.?: return nil
    val caps = scheduler_pinned_capability_snapshot_caps_v1(pinned.unwrap())
    if not _boot_authenticated_launch_pouch_valid_v1(caller, caps, coordinates.recipe):
        return nil
    if (_boot_authenticated_launch_mutex_v1 <= 0 or
        _boot_authenticated_launch_poisoned_v1 or
        not mutex_raw_lock(_boot_authenticated_launch_mutex_v1)):
        return nil
    var reusable: i64 = -1
    var index: i64 = 0
    while index < _boot_authenticated_launch_slots_v1.len():
        if reusable < 0 and
           _boot_authenticated_launch_slots_v1[index].state == _BootAuthenticatedLaunchLeaseStateV1.Free:
            reusable = index
        index = index + 1
    if ((reusable < 0 and _boot_authenticated_launch_slots_v1.len() >=
            boot_authenticated_launch_max_leases_v1()) or
        _boot_authenticated_launch_next_generation_v1 == 0u64 or
        _boot_authenticated_launch_next_generation_v1 == 0xffffffffffffffffu64):
        _ = _boot_authenticated_launch_unlock_v1()
        return nil
    val generation = _boot_authenticated_launch_next_generation_v1
    _boot_authenticated_launch_next_generation_v1 = generation + 1u64
    var nonce = generation ^ caller ^ coordinates.mount_id ^ coordinates.file_id ^
        0x424F4F544C454153u64
    if nonce == 0u64: nonce = generation ^ 0x4C41554E4348u64
    val slot = _BootAuthenticatedLaunchLeaseSlotV1(
        generation: generation, nonce: nonce,
        state: _BootAuthenticatedLaunchLeaseStateV1.Armed, caller: caller,
        caller_lifecycle_generation: caller_lifecycle_generation,
        caller_exec_generation: caller_exec_generation,
        coordinates: coordinates,
        caller_caps: _boot_authenticated_launch_copy_tokens_v1(caps))
    val target = if reusable >= 0: reusable else: _boot_authenticated_launch_slots_v1.len()
    if reusable >= 0:
        _boot_authenticated_launch_slots_v1[reusable] = slot
    else:
        _boot_authenticated_launch_slots_v1.push(slot)
    if not _boot_authenticated_launch_unlock_v1(): return nil
    Some(BootAuthenticatedLaunchLeaseV1(
        _slot: target, _generation: generation, _nonce: nonce))

pub fn boot_authenticated_launch_lease_consume_once_v1(
    scheduler: Scheduler,
    lease: BootAuthenticatedLaunchLeaseV1,
    coordinates: BootAuthenticatedLaunchCoordinatesV1
) -> BootAuthenticatedLaunchGrantV1?:
    """Consume only the exact task-and-signed-coordinate boot lease once."""
    if (not _boot_authenticated_launch_coordinates_valid_v1(coordinates) or
        _boot_authenticated_launch_mutex_v1 <= 0 or
        _boot_authenticated_launch_poisoned_v1 or
        not mutex_raw_lock(_boot_authenticated_launch_mutex_v1)):
        return nil
    if lease._slot < 0 or lease._slot >= _boot_authenticated_launch_slots_v1.len():
        _ = _boot_authenticated_launch_unlock_v1()
        return nil
    var slot = _boot_authenticated_launch_slots_v1[lease._slot]
    if (slot.state != _BootAuthenticatedLaunchLeaseStateV1.Armed or
        slot.generation != lease._generation or slot.nonce != lease._nonce or
        not _boot_authenticated_launch_same_coordinates_v1(slot.coordinates, coordinates)):
        _ = _boot_authenticated_launch_unlock_v1()
        return nil
    # The lease is a scoped authority loan from exactly one execution. Burn it
    # if that execution exited, re-execed, ceased to be current, or if a PID was
    # recycled with another lifecycle generation. A later state change cannot
    # revive the retained capability snapshot.
    val current_execution = scheduler.current_execution_snapshot_v1()
    var execution_identity_matches = false
    if current_execution.?:
        val current = current_execution.unwrap()
        val current_task_id =
            scheduler_current_execution_snapshot_task_id_v1(current)
        val current_lifecycle_generation =
            scheduler_current_execution_snapshot_lifecycle_generation_v1(current)
        val current_exec_generation =
            scheduler_current_execution_snapshot_exec_generation_v1(current)
        val current_pinned = scheduler_capability_snapshot_consume_once_v1(
            scheduler_current_execution_snapshot_lease_v1(current),
            current_task_id, current_lifecycle_generation,
            current_exec_generation)
        execution_identity_matches = current_pinned.? and
            current_task_id == slot.caller and
            current_lifecycle_generation == slot.caller_lifecycle_generation and
            current_exec_generation == slot.caller_exec_generation
    if not execution_identity_matches:
        slot.state = _BootAuthenticatedLaunchLeaseStateV1.Free
        slot.caller = 0u64
        slot.caller_lifecycle_generation = 0u64
        slot.caller_exec_generation = 0u64
        slot.caller_caps = []
        _boot_authenticated_launch_slots_v1[lease._slot] = slot
        _ = _boot_authenticated_launch_unlock_v1()
        return nil
    val caller = slot.caller
    val caps = CapabilitySet(caps: _boot_authenticated_launch_copy_tokens_v1(
        CapabilitySet(caps: slot.caller_caps, is_pledged: true)), is_pledged: true)
    slot.state = _BootAuthenticatedLaunchLeaseStateV1.Free
    slot.caller = 0u64
    slot.caller_lifecycle_generation = 0u64
    slot.caller_exec_generation = 0u64
    slot.caller_caps = []
    _boot_authenticated_launch_slots_v1[lease._slot] = slot
    if not _boot_authenticated_launch_unlock_v1(): return nil
    Some(BootAuthenticatedLaunchGrantV1(caller: caller as i64, caller_caps: caps))

export BootAuthenticatedLaunchCoordinatesV1
export BootAuthenticatedLaunchLeaseV1
export BootAuthenticatedLaunchGrantV1
export boot_authenticated_launch_coordinates_new_v1
export boot_authenticated_launch_max_leases_v1
export boot_authenticated_launch_lease_issue_current_v1
export boot_authenticated_launch_lease_consume_once_v1
