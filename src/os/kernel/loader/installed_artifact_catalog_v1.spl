"""Bounded bootstrap-owned installed-artifact catalog.

The catalog retains authenticated package metadata, not execution authority.
Only sibling loader/bootstrap code can begin, populate, and seal it. Public
consumers receive bounded deep copies after integrity revalidation; no public
operation allocates a permanent slot or mints loader authority.
"""

use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}
use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestTarget, SimpleArtifactManifest,
    simple_artifact_manifest_bounds_validate_v1,
    simple_artifact_manifest_deep_copy_bounded_v1,
    simple_artifact_manifest_canonical_hash_input_v1
}
use std.common.structural.digest.hash256.{hash256_hex_valid, hash256_is_zero}
use os.kernel.loader.artifact_manifest.{manifest_sha256_hex}

pub const SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_PER_TARGET_V1: i64 = 17
pub const SIMPLEOS_INSTALLED_ARTIFACT_TARGET_LIMIT_V1: i64 = 6
pub const SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_V1: i64 =
    SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_PER_TARGET_V1 *
    SIMPLEOS_INSTALLED_ARTIFACT_TARGET_LIMIT_V1
pub const SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_LIMIT_V1: i64 = 64
pub const SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_TEXT_LIMIT_PER_RECORD_V1: i64 = 65536
pub const SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_TEXT_LIMIT_GLOBAL_V1: i64 = 524288
pub const SIMPLEOS_INSTALLED_ARTIFACT_MAX_KEY_COUNT_V1: i64 =
    SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_V1 *
    (1 + SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_LIMIT_V1)
pub const SIMPLEOS_INSTALLED_ARTIFACT_KEY_TABLE_CAPACITY_V1: i64 = 8192
pub const SIMPLEOS_INSTALLED_ARTIFACT_PATH_MAX_BYTES_V1: i64 = 4096
pub const SIMPLEOS_INSTALLED_ARTIFACT_IDENTITY_MAX_BYTES_V1: i64 = 256

pub enum InstalledArtifactCatalogLifecycleV1:
    Uninitialized
    Populating
    Sealed
    Quarantined

pub enum InstalledArtifactCatalogProtocolEventV1:
    BeginBootstrap
    AddRecord
    Seal
    CommittedUnknownUnlock

pub fn installed_artifact_catalog_protocol_transition_v1(
    state: InstalledArtifactCatalogLifecycleV1,
    event: InstalledArtifactCatalogProtocolEventV1
) -> InstalledArtifactCatalogLifecycleV1?:
    """Pure lifecycle oracle; it creates no session and retains no record."""
    if event == InstalledArtifactCatalogProtocolEventV1.CommittedUnknownUnlock:
        if state != InstalledArtifactCatalogLifecycleV1.Quarantined:
            return Some(InstalledArtifactCatalogLifecycleV1.Quarantined)
        return nil
    if event == InstalledArtifactCatalogProtocolEventV1.BeginBootstrap and
        state == InstalledArtifactCatalogLifecycleV1.Uninitialized:
        return Some(InstalledArtifactCatalogLifecycleV1.Populating)
    if event == InstalledArtifactCatalogProtocolEventV1.AddRecord and
        state == InstalledArtifactCatalogLifecycleV1.Populating:
        return Some(InstalledArtifactCatalogLifecycleV1.Populating)
    if event == InstalledArtifactCatalogProtocolEventV1.Seal and
        state == InstalledArtifactCatalogLifecycleV1.Populating:
        return Some(InstalledArtifactCatalogLifecycleV1.Sealed)
    nil

pub struct InstalledArtifactRecordV1:
    canonical_path: text
    aliases: [text]
    target: ManifestTarget
    content_sha256: text
    signature_scheme: text
    signer_identity: text
    detached_signature: text
    expected_trust_root_sha256: text
    manifest_identity_sha256: text
    manifest: SimpleArtifactManifest

pub struct InstalledArtifactCatalogStatusV1:
    lifecycle: InstalledArtifactCatalogLifecycleV1
    artifact_count: i64

pub(package) struct InstalledArtifactBootstrapSessionV1:
    generation: u64
    nonce: u64

pub(package) struct InstalledArtifactCatalogSealLeaseV1:
    """Opaque one-shot proof that offline-root verification reached seal."""
    generation: u64
    nonce: u64

struct InstalledArtifactSlotV1:
    generation: u64
    canonical_path: text
    aliases: [text]
    target: ManifestTarget
    content_sha256: text
    signature_scheme: text
    signer_identity: text
    detached_signature: text
    expected_trust_root_sha256: text
    manifest_identity_sha256: text
    record_integrity_sha256: text
    manifest: SimpleArtifactManifest

struct InstalledArtifactKeySlotV1:
    occupied: bool
    key_hash: u64
    path: text
    target_id: i64
    record_slot: i64

struct InstalledArtifactLookupCandidateV1:
    slot: i64
    generation: u64
    expected_integrity_sha256: text
    record: InstalledArtifactRecordV1

pub(package) enum AuthenticatedVfsExecutableAliasPlanErrorV1:
    None
    SourceRecordInvalid
    RequestedAliasCountInvalid
    RequestedAliasPathInvalid
    RequestedAliasNotCatalogued
    RequestedAliasDuplicate

pub(package) struct AuthenticatedVfsExecutableSourceIdentityV1:
    canonical_path: text
    target: ManifestTarget
    content_sha256: text
    expected_trust_root_sha256: text
    manifest_identity_sha256: text

pub(package) struct AuthenticatedVfsExecutableAliasNodePlanV1:
    requested_path: text
    source: AuthenticatedVfsExecutableSourceIdentityV1

pub(package) struct AuthenticatedVfsExecutableAliasPlanV1:
    ok: bool
    error: AuthenticatedVfsExecutableAliasPlanErrorV1
    nodes: [AuthenticatedVfsExecutableAliasNodePlanV1]

struct InstalledArtifactCatalogOwnerV1:
    initialized: bool
    lifecycle: InstalledArtifactCatalogLifecycleV1
    bootstrap_generation: u64
    bootstrap_nonce: u64
    nonce_counter: u64
    seal_lease_generation: u64
    seal_lease_nonce: u64
    seal_lease_state: i64
    key_count: i64
    alias_text_bytes: i64
    records: [InstalledArtifactSlotV1]
    keys: [InstalledArtifactKeySlotV1]

fn _installed_artifact_empty_slots_v1() -> [InstalledArtifactSlotV1]:
    val empty: [InstalledArtifactSlotV1] = []
    empty

fn _installed_artifact_empty_key_v1() -> InstalledArtifactKeySlotV1:
    InstalledArtifactKeySlotV1(
        occupied: false, key_hash: 0u64, path: "",
        target_id: -1, record_slot: -1)

fn _installed_artifact_empty_keys_v1() -> [InstalledArtifactKeySlotV1]:
    var keys: [InstalledArtifactKeySlotV1] = []
    var i: i64 = 0
    while i < SIMPLEOS_INSTALLED_ARTIFACT_KEY_TABLE_CAPACITY_V1:
        keys.push(_installed_artifact_empty_key_v1())
        i = i + 1
    keys

val _installed_artifact_catalog_mutex_v1: i64 = mutex_raw_create()
var _installed_artifact_catalog_v1 = InstalledArtifactCatalogOwnerV1(
    initialized: false,
    lifecycle: InstalledArtifactCatalogLifecycleV1.Uninitialized,
    bootstrap_generation: 0u64,
    bootstrap_nonce: 0u64,
    nonce_counter: 0x494e5354414c4c31u64,
    seal_lease_generation: 0u64,
    seal_lease_nonce: 0u64,
    seal_lease_state: 0,
    key_count: 0,
    alias_text_bytes: 0,
    records: [],
    keys: [])

fn _installed_artifact_initialize_locked_v1():
    if not _installed_artifact_catalog_v1.initialized:
        _installed_artifact_catalog_v1.records = _installed_artifact_empty_slots_v1()
        _installed_artifact_catalog_v1.keys = _installed_artifact_empty_keys_v1()
        _installed_artifact_catalog_v1.initialized = true

fn _installed_artifact_lock_v1() -> bool:
    if _installed_artifact_catalog_mutex_v1 <= 0 or
        not mutex_raw_lock(_installed_artifact_catalog_mutex_v1):
        return false
    _installed_artifact_initialize_locked_v1()
    val cond_166 = _installed_artifact_catalog_v1.lifecycle ==
        InstalledArtifactCatalogLifecycleV1.Quarantined
    if cond_166:
        _ = mutex_raw_unlock(_installed_artifact_catalog_mutex_v1)
        return false
    true

fn _installed_artifact_unlock_v1() -> bool:
    if mutex_raw_unlock(_installed_artifact_catalog_mutex_v1):
        return true
    # All supported raw mutex providers report false only while ownership is
    # retained. The preceding mutation is now committed-unknown. Publish the
    # fail-stop state while still serialized; no caller may retry or consume a
    # result from this transition.
    _installed_artifact_catalog_v1.lifecycle = InstalledArtifactCatalogLifecycleV1.Quarantined
    false

fn _installed_artifact_next_nonce_locked_v1() -> u64:
    if _installed_artifact_catalog_v1.nonce_counter == 0xffffffffffffffffu64:
        return 0u64
    _installed_artifact_catalog_v1.nonce_counter =
        _installed_artifact_catalog_v1.nonce_counter + 1u64
    _installed_artifact_catalog_v1.nonce_counter

fn _installed_artifact_session_valid_locked_v1(
    session: InstalledArtifactBootstrapSessionV1
) -> bool:
    _installed_artifact_catalog_v1.lifecycle ==
        InstalledArtifactCatalogLifecycleV1.Populating and
        session.generation != 0u64 and session.nonce != 0u64 and
        session.generation == _installed_artifact_catalog_v1.bootstrap_generation and
        session.nonce == _installed_artifact_catalog_v1.bootstrap_nonce

fn _installed_artifact_text_bounded_v1(value: text, maximum: i64) -> bool:
    if value == "" or value.len() > maximum:
        return false
    val raw = value.bytes()
    raw.len() as i64 <= maximum

pub fn installed_artifact_path_shape_valid_v1(path: text) -> bool:
    """Pure path-shape gate; passing it grants no catalog or launch authority."""
    _installed_artifact_text_bounded_v1(
        path, SIMPLEOS_INSTALLED_ARTIFACT_PATH_MAX_BYTES_V1) and
        path.starts_with("/") and path != "/" and not path.ends_with("/") and
        not path.contains("\\") and not path.contains("\0") and
        not path.contains("\n") and not path.contains("\r") and
        not path.contains("//") and not path.contains("/./") and
        not path.ends_with("/.") and not path.contains("/../") and
        not path.ends_with("/..")

fn _installed_artifact_target_id_v1(target: ManifestTarget) -> i64:
    if target.os != "simpleos" or target.abi != "simpleos": return -1
    if target.arch == "x86_64": return 0
    if target.arch == "x86": return 1
    if target.arch == "aarch64": return 2
    if target.arch == "arm": return 3
    if target.arch == "riscv64": return 4
    if target.arch == "riscv32": return 5
    -1

fn _installed_artifact_target_valid_v1(target: ManifestTarget) -> bool:
    _installed_artifact_target_id_v1(target) >= 0

fn _installed_artifact_target_equal_v1(a: ManifestTarget, b: ManifestTarget) -> bool:
    a.os == b.os and a.arch == b.arch and a.abi == b.abi

fn _installed_artifact_copy_aliases_v1(source: [text]) -> [text]:
    var copied: [text] = []
    for alias in source:
        copied.push(alias)
    copied

fn _installed_artifact_aliases_valid_v1(canonical_path: text, aliases: [text]) -> bool:
    if aliases.len() > SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_LIMIT_V1:
        return false
    var i: i64 = 0
    while i < aliases.len():
        if not installed_artifact_path_shape_valid_v1(aliases[i]) or
            aliases[i] == canonical_path:
            return false
        var prior: i64 = 0
        while prior < i:
            if aliases[prior] == aliases[i]: return false
            prior = prior + 1
        i = i + 1
    true

pub fn installed_artifact_alias_text_bytes_bounded_v1(aliases: [text]) -> i64?:
    """Return aggregate UTF-8 bytes only when the per-record budget holds."""
    if aliases.len() > SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_LIMIT_V1: return nil
    var total: i64 = 0
    for alias in aliases:
        val size = alias.bytes().len() as i64
        if size > SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_TEXT_LIMIT_PER_RECORD_V1 - total:
            return nil
        total = total + size
    Some(total)

fn _installed_artifact_digest_declared_v1(manifest: SimpleArtifactManifest, digest: text) -> bool:
    for declared in manifest.content_hashes:
        if declared == digest: return true
    false

fn _installed_artifact_record_input_bounds_valid_v1(
    canonical_path: text,
    aliases: [text],
    content_sha256: text,
    signature_scheme: text,
    signer_identity: text,
    detached_signature: text,
    manifest: SimpleArtifactManifest
) -> bool:
    if not installed_artifact_path_shape_valid_v1(canonical_path) or
        not _installed_artifact_aliases_valid_v1(canonical_path, aliases) or
        not hash256_hex_valid(content_sha256) or hash256_is_zero(content_sha256) or
        not _installed_artifact_text_bounded_v1(
            signature_scheme, SIMPLEOS_INSTALLED_ARTIFACT_IDENTITY_MAX_BYTES_V1) or
        not _installed_artifact_text_bounded_v1(
            signer_identity, SIMPLEOS_INSTALLED_ARTIFACT_IDENTITY_MAX_BYTES_V1) or
        not _installed_artifact_text_bounded_v1(
            detached_signature, SIMPLEOS_INSTALLED_ARTIFACT_PATH_MAX_BYTES_V1) or
        not _installed_artifact_target_valid_v1(manifest.target) or
        manifest.entrypoint != canonical_path or manifest.signature != detached_signature or
        not _installed_artifact_digest_declared_v1(manifest, content_sha256):
        return false
    simple_artifact_manifest_bounds_validate_v1(manifest).ok

pub fn installed_artifact_record_input_valid_v1(
    canonical_path: text,
    aliases: [text],
    content_sha256: text,
    signature_scheme: text,
    signer_identity: text,
    detached_signature: text,
    manifest: SimpleArtifactManifest
) -> bool:
    """Pure shape gate. Passing it does not prove installation or trust."""
    _installed_artifact_record_input_bounds_valid_v1(
        canonical_path, aliases, content_sha256, signature_scheme,
        signer_identity, detached_signature, manifest) and
        installed_artifact_alias_text_bytes_bounded_v1(aliases).?

class _InstalledArtifactIdentityWriterV1:
    bytes: [u8]

    me append_raw(value: text):
        for byte in value.bytes(): self.bytes.push(byte)

    me append_field(value: text):
        val raw = value.bytes()
        self.append_raw(raw.len().to_text())
        self.bytes.push(58u8)
        for byte in raw: self.bytes.push(byte)

fn _installed_artifact_manifest_identity_v1(manifest: SimpleArtifactManifest) -> text:
    if val body = simple_artifact_manifest_canonical_hash_input_v1(manifest):
        return manifest_sha256_hex(body)
    ""

fn _installed_artifact_record_integrity_v1(record: InstalledArtifactRecordV1) -> text:
    # Re-run the complete shape relation, not only the canonical manifest hash:
    # the manifest signature is deliberately excluded from its signing body,
    # so equality with the separately retained detached signature must be
    # checked explicitly on every integrity read.
    if not installed_artifact_record_input_valid_v1(
        record.canonical_path, record.aliases, record.content_sha256,
        record.signature_scheme, record.signer_identity,
        record.detached_signature, record.manifest) or
        not _installed_artifact_target_equal_v1(record.target, record.manifest.target):
        return ""
    val manifest_identity = _installed_artifact_manifest_identity_v1(record.manifest)
    if manifest_identity == "" or manifest_identity != record.manifest_identity_sha256:
        return ""
    var writer = _InstalledArtifactIdentityWriterV1(bytes: [])
    writer.append_raw("simpleos-installed-artifact-record-v1")
    writer.append_field(record.canonical_path)
    writer.append_field(record.aliases.len().to_text())
    for alias in record.aliases: writer.append_field(alias)
    writer.append_field(record.target.os)
    writer.append_field(record.target.arch)
    writer.append_field(record.target.abi)
    writer.append_field(record.content_sha256)
    writer.append_field(record.signature_scheme)
    writer.append_field(record.signer_identity)
    writer.append_field(record.detached_signature)
    writer.append_field(record.expected_trust_root_sha256)
    writer.append_field(manifest_identity)
    manifest_sha256_hex(writer.bytes)

fn _installed_artifact_record_copy_v1(slot: InstalledArtifactSlotV1) -> InstalledArtifactRecordV1?:
    if val manifest = simple_artifact_manifest_deep_copy_bounded_v1(slot.manifest):
        return Some(InstalledArtifactRecordV1(
            canonical_path: slot.canonical_path,
            aliases: _installed_artifact_copy_aliases_v1(slot.aliases),
            target: ManifestTarget(
                os: slot.target.os, arch: slot.target.arch, abi: slot.target.abi),
            content_sha256: slot.content_sha256,
            signature_scheme: slot.signature_scheme,
            signer_identity: slot.signer_identity,
            detached_signature: slot.detached_signature,
            expected_trust_root_sha256: slot.expected_trust_root_sha256,
            manifest_identity_sha256: slot.manifest_identity_sha256,
            manifest: manifest))
    nil

fn _installed_artifact_hash_field_v1(hash_seed: u64, value: text) -> u64:
    var hash = hash_seed
    for byte in value.bytes():
        hash = hash ^ (byte as u64)
        hash = hash * 1099511628211u64
    hash

fn _installed_artifact_key_hash_v1(path: text, target: ManifestTarget) -> u64:
    # The compact target ID is a one-to-one encoding of the six admitted
    # (os, arch, ABI) tuples. It avoids retaining three texts in every key slot.
    var hash = 1469598103934665603u64
    hash = _installed_artifact_hash_field_v1(hash, path)
    hash = _installed_artifact_hash_field_v1(hash, "\0")
    hash = hash ^ (_installed_artifact_target_id_v1(target) as u64)
    hash = hash * 1099511628211u64
    hash

fn _installed_artifact_find_locked_v1(path: text, target: ManifestTarget) -> i64:
    val capacity = SIMPLEOS_INSTALLED_ARTIFACT_KEY_TABLE_CAPACITY_V1
    val target_id = _installed_artifact_target_id_v1(target)
    if target_id < 0: return -1
    val key_hash = _installed_artifact_key_hash_v1(path, target)
    val start = (key_hash % (capacity as u64)) as i64
    var probe: i64 = 0
    while probe < capacity:
        val index = (start + probe) % capacity
        val key = _installed_artifact_catalog_v1.keys[index]
        if not key.occupied: return -1
        if key.key_hash == key_hash and key.path == path and
            key.target_id == target_id:
            return key.record_slot
        probe = probe + 1
    -1

fn _installed_artifact_key_insert_locked_v1(
    path: text, target: ManifestTarget, record_slot: i64
) -> bool:
    val capacity = SIMPLEOS_INSTALLED_ARTIFACT_KEY_TABLE_CAPACITY_V1
    val target_id = _installed_artifact_target_id_v1(target)
    if target_id < 0: return false
    val key_hash = _installed_artifact_key_hash_v1(path, target)
    val start = (key_hash % (capacity as u64)) as i64
    var probe: i64 = 0
    while probe < capacity:
        val index = (start + probe) % capacity
        if not _installed_artifact_catalog_v1.keys[index].occupied:
            _installed_artifact_catalog_v1.keys[index] = InstalledArtifactKeySlotV1(
                occupied: true, key_hash: key_hash, path: path,
                target_id: target_id, record_slot: record_slot)
            _installed_artifact_catalog_v1.key_count =
                _installed_artifact_catalog_v1.key_count + 1
            return true
        val key = _installed_artifact_catalog_v1.keys[index]
        if key.key_hash == key_hash and key.path == path and
            key.target_id == target_id:
            return false
        probe = probe + 1
    false

fn _installed_artifact_target_count_locked_v1(target: ManifestTarget) -> i64:
    var count: i64 = 0
    for slot in _installed_artifact_catalog_v1.records:
        if _installed_artifact_target_equal_v1(slot.target, target):
            count = count + 1
    count

fn _installed_artifact_record_has_path_v1(slot: InstalledArtifactSlotV1, path: text) -> bool:
    if slot.canonical_path == path: return true
    for alias in slot.aliases:
        if alias == path: return true
    false

fn _installed_artifact_find_unique_path_locked_v1(path: text) -> i64:
    # Compatibility diagnostics may omit a target only when the path resolves
    # to exactly one retained target. Ambiguity fails closed.
    var found: i64 = -1
    var index: i64 = 0
    while index < _installed_artifact_catalog_v1.records.len():
        if _installed_artifact_record_has_path_v1(
            _installed_artifact_catalog_v1.records[index], path):
            if found >= 0: return -1
            found = index
        index = index + 1
    found

pub(package) fn installed_artifact_catalog_bootstrap_begin_v1(
) -> InstalledArtifactBootstrapSessionV1?:
    if not _installed_artifact_lock_v1(): return nil
    val cond_431 = _installed_artifact_catalog_v1.lifecycle !=
        InstalledArtifactCatalogLifecycleV1.Uninitialized
    if cond_431:
        _ = _installed_artifact_unlock_v1()
        return nil
    if _installed_artifact_catalog_v1.bootstrap_generation == 0xffffffffffffffffu64:
        _installed_artifact_catalog_v1.lifecycle = InstalledArtifactCatalogLifecycleV1.Quarantined
        _ = _installed_artifact_unlock_v1()
        return nil
    val nonce = _installed_artifact_next_nonce_locked_v1()
    if nonce == 0u64:
        _installed_artifact_catalog_v1.lifecycle = InstalledArtifactCatalogLifecycleV1.Quarantined
        _ = _installed_artifact_unlock_v1()
        return nil
    _installed_artifact_catalog_v1.bootstrap_generation = _installed_artifact_catalog_v1.bootstrap_generation + 1u64
    _installed_artifact_catalog_v1.seal_lease_generation = 0u64
    _installed_artifact_catalog_v1.seal_lease_nonce = 0u64
    _installed_artifact_catalog_v1.seal_lease_state = 0
    _installed_artifact_catalog_v1.bootstrap_nonce = nonce
    _installed_artifact_catalog_v1.lifecycle = InstalledArtifactCatalogLifecycleV1.Populating
    val session = InstalledArtifactBootstrapSessionV1(
        generation: _installed_artifact_catalog_v1.bootstrap_generation,
        nonce: nonce)
    if not _installed_artifact_unlock_v1(): return nil
    Some(session)

pub(package) fn installed_artifact_catalog_bootstrap_add_v1(
    session: InstalledArtifactBootstrapSessionV1,
    canonical_path: text,
    aliases: [text],
    content_sha256: text,
    signature_scheme: text,
    signer_identity: text,
    detached_signature: text,
    expected_trust_root_sha256: text,
    manifest: SimpleArtifactManifest
) -> bool:
    if not _installed_artifact_record_input_bounds_valid_v1(
        canonical_path, aliases, content_sha256, signature_scheme,
        signer_identity, detached_signature, manifest) or
        not hash256_hex_valid(expected_trust_root_sha256) or
        hash256_is_zero(expected_trust_root_sha256):
        return false
    # Cross the caller/owner boundary once, immediately after bounded shape
    # validation. Every later decision and retained value uses this snapshot.
    val owned_aliases = _installed_artifact_copy_aliases_v1(aliases)
    val alias_text_bytes =
        installed_artifact_alias_text_bytes_bounded_v1(owned_aliases)
    if not alias_text_bytes.?: return false
    val manifest_copy = simple_artifact_manifest_deep_copy_bounded_v1(manifest)
    if not manifest_copy.?: return false
    val owned_manifest = manifest_copy.unwrap()
    val manifest_identity = _installed_artifact_manifest_identity_v1(owned_manifest)
    if manifest_identity == "": return false
    val candidate = InstalledArtifactRecordV1(
        canonical_path: canonical_path,
        aliases: owned_aliases,
        target: ManifestTarget(
            os: owned_manifest.target.os,
            arch: owned_manifest.target.arch,
            abi: owned_manifest.target.abi),
        content_sha256: content_sha256,
        signature_scheme: signature_scheme,
        signer_identity: signer_identity,
        detached_signature: detached_signature,
        expected_trust_root_sha256: expected_trust_root_sha256,
        manifest_identity_sha256: manifest_identity,
        manifest: owned_manifest)
    val integrity = _installed_artifact_record_integrity_v1(candidate)
    if integrity == "": return false

    if not _installed_artifact_lock_v1(): return false
    val cond_501 = not _installed_artifact_session_valid_locked_v1(session) or
        _installed_artifact_catalog_v1.records.len() >=
            SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_V1
    if cond_501:
        _ = _installed_artifact_unlock_v1()
        return false
    val cond_506 = _installed_artifact_target_count_locked_v1(candidate.target) >=
        SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_PER_TARGET_V1 or
        _installed_artifact_find_locked_v1(canonical_path, candidate.target) >= 0
    if cond_506:
        _ = _installed_artifact_unlock_v1()
        return false
    for alias in owned_aliases:
        if _installed_artifact_find_locked_v1(alias, candidate.target) >= 0:
            _ = _installed_artifact_unlock_v1()
            return false
    val required_keys = 1 + owned_aliases.len()
    if (_installed_artifact_catalog_v1.key_count >
            SIMPLEOS_INSTALLED_ARTIFACT_KEY_TABLE_CAPACITY_V1 - required_keys or
        _installed_artifact_catalog_v1.alias_text_bytes >
            SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_TEXT_LIMIT_GLOBAL_V1 -
                alias_text_bytes.unwrap()):
        _ = _installed_artifact_unlock_v1()
        return false
    # Capacity and all collision checks are complete before owner mutation.
    # The fixed table now has room for every key in the owned snapshot.
    val generation = (_installed_artifact_catalog_v1.records.len() as u64) + 1u64
    val record_slot = _installed_artifact_catalog_v1.records.len() as i64
    _installed_artifact_catalog_v1.records.push(InstalledArtifactSlotV1(
        generation: generation,
        canonical_path: canonical_path,
        aliases: owned_aliases,
        target: candidate.target,
        content_sha256: content_sha256,
        signature_scheme: signature_scheme,
        signer_identity: signer_identity,
        detached_signature: detached_signature,
        expected_trust_root_sha256: expected_trust_root_sha256,
        manifest_identity_sha256: manifest_identity,
        record_integrity_sha256: integrity,
        manifest: owned_manifest))
    _installed_artifact_catalog_v1.alias_text_bytes =
        _installed_artifact_catalog_v1.alias_text_bytes + alias_text_bytes.unwrap()
    if not _installed_artifact_key_insert_locked_v1(
        canonical_path, candidate.target, record_slot):
        _installed_artifact_catalog_v1.lifecycle =
            InstalledArtifactCatalogLifecycleV1.Quarantined
        _ = _installed_artifact_unlock_v1()
        return false
    for alias in owned_aliases:
        if not _installed_artifact_key_insert_locked_v1(
            alias, candidate.target, record_slot):
            _installed_artifact_catalog_v1.lifecycle =
                InstalledArtifactCatalogLifecycleV1.Quarantined
            _ = _installed_artifact_unlock_v1()
            return false
    _installed_artifact_unlock_v1()

pub(package) fn installed_artifact_catalog_bootstrap_seal_v1(
    session: InstalledArtifactBootstrapSessionV1
) -> bool:
    if not _installed_artifact_lock_v1(): return false
    val cond_549 = not _installed_artifact_session_valid_locked_v1(session) or
        _installed_artifact_catalog_v1.records.len() == 0
    if cond_549:
        _ = _installed_artifact_unlock_v1()
        return false
    _installed_artifact_catalog_v1.bootstrap_nonce = 0u64
    _installed_artifact_catalog_v1.lifecycle = InstalledArtifactCatalogLifecycleV1.Sealed
    _installed_artifact_unlock_v1()

pub(package) fn installed_artifact_catalog_bootstrap_seal_for_lease_v1(
    session: InstalledArtifactBootstrapSessionV1
) -> bool:
    """Seal and retain one lease for later sole-owner issuance.

    The generic seal surface remains for catalog-only fixtures, but it emits no
    trust-transition lease. Production boot calls this surface only after its
    complete record set has passed the pinned offline-root verification loop.
    """
    if not _installed_artifact_lock_v1(): return false
    val cond_567 = not _installed_artifact_session_valid_locked_v1(session) or
        _installed_artifact_catalog_v1.records.len() == 0 or
        _installed_artifact_catalog_v1.seal_lease_state != 0
    if cond_567:
        _ = _installed_artifact_unlock_v1()
        return false
    val lease_nonce = _installed_artifact_next_nonce_locked_v1()
    if lease_nonce == 0u64:
        _installed_artifact_catalog_v1.lifecycle = InstalledArtifactCatalogLifecycleV1.Quarantined
        _ = _installed_artifact_unlock_v1()
        return false
    _installed_artifact_catalog_v1.bootstrap_nonce = 0u64
    _installed_artifact_catalog_v1.lifecycle = InstalledArtifactCatalogLifecycleV1.Sealed
    _installed_artifact_catalog_v1.seal_lease_generation = session.generation
    _installed_artifact_catalog_v1.seal_lease_nonce = lease_nonce
    # 1 = emitted/available, 2 = issued, 3 = consumed.
    _installed_artifact_catalog_v1.seal_lease_state = 1
    _installed_artifact_unlock_v1()

pub(package) fn installed_artifact_catalog_seal_lease_take_v1(
) -> InstalledArtifactCatalogSealLeaseV1?:
    """Move the sole emitted lease from catalog owner to boot composition."""
    if not _installed_artifact_lock_v1(): return nil
    val cond_590 = _installed_artifact_catalog_v1.lifecycle !=
            InstalledArtifactCatalogLifecycleV1.Sealed or
        _installed_artifact_catalog_v1.seal_lease_state != 1 or
        _installed_artifact_catalog_v1.seal_lease_generation == 0u64 or
        _installed_artifact_catalog_v1.seal_lease_nonce == 0u64
    if cond_590:
        _ = _installed_artifact_unlock_v1()
        return nil
    val lease = InstalledArtifactCatalogSealLeaseV1(
        generation: _installed_artifact_catalog_v1.seal_lease_generation,
        nonce: _installed_artifact_catalog_v1.seal_lease_nonce)
    _installed_artifact_catalog_v1.seal_lease_state = 2
    if not _installed_artifact_unlock_v1(): return nil
    Some(lease)

pub(package) fn installed_artifact_catalog_seal_lease_consume_for_root_v1(
    lease: InstalledArtifactCatalogSealLeaseV1,
    signer_identity: text,
    trust_root_sha256: text
) -> bool:
    """Consume only when every sealed row names the candidate root."""
    if signer_identity == "" or signer_identity.len() > 128 or
        not hash256_hex_valid(trust_root_sha256) or
        hash256_is_zero(trust_root_sha256):
        return false
    if not _installed_artifact_lock_v1(): return false
    val cond_615 = _installed_artifact_catalog_v1.lifecycle !=
            InstalledArtifactCatalogLifecycleV1.Sealed or
        _installed_artifact_catalog_v1.seal_lease_state != 2 or
        lease.generation == 0u64 or lease.nonce == 0u64 or
        lease.generation != _installed_artifact_catalog_v1.seal_lease_generation or
        lease.nonce != _installed_artifact_catalog_v1.seal_lease_nonce
    if cond_615:
        _ = _installed_artifact_unlock_v1()
        return false
    for record in _installed_artifact_catalog_v1.records:
        val cond_624 = record.signer_identity != signer_identity or
            record.expected_trust_root_sha256 != trust_root_sha256
        if cond_624:
            _ = _installed_artifact_unlock_v1()
            return false
    _installed_artifact_catalog_v1.seal_lease_state = 3
    _installed_artifact_catalog_v1.seal_lease_nonce = 0u64
    _installed_artifact_unlock_v1()

pub(package) fn installed_artifact_catalog_bootstrap_quarantine_v1(
    session: InstalledArtifactBootstrapSessionV1
) -> bool:
    """Fail-stop an indeterminate bootstrap; no retry or lookup may follow."""
    if not _installed_artifact_lock_v1(): return false
    if not _installed_artifact_session_valid_locked_v1(session):
        _ = _installed_artifact_unlock_v1()
        return false
    _installed_artifact_catalog_v1.bootstrap_nonce = 0u64
    _installed_artifact_catalog_v1.lifecycle = InstalledArtifactCatalogLifecycleV1.Quarantined
    _installed_artifact_unlock_v1()

fn _installed_artifact_catalog_lookup_bound_v1(
    path: text,
    expected_target: ManifestTarget?
) -> InstalledArtifactLookupCandidateV1?:
    """Return a deep-owned metadata snapshot. It never grants execution."""
    if not installed_artifact_path_shape_valid_v1(path): return nil
    if not _installed_artifact_lock_v1(): return nil
    if _installed_artifact_catalog_v1.lifecycle != InstalledArtifactCatalogLifecycleV1.Sealed:
        _ = _installed_artifact_unlock_v1()
        return nil
    val index = match expected_target:
        case Some(target): _installed_artifact_find_locked_v1(path, target)
        case nil: _installed_artifact_find_unique_path_locked_v1(path)
    if index < 0:
        _ = _installed_artifact_unlock_v1()
        return nil
    if index >= _installed_artifact_catalog_v1.records.len():
        _installed_artifact_catalog_v1.lifecycle =
            InstalledArtifactCatalogLifecycleV1.Quarantined
        _ = _installed_artifact_unlock_v1()
        return nil
    val slot = _installed_artifact_catalog_v1.records[index]
    match expected_target:
        case Some(target):
            # The two retained target copies are an integrity invariant. A
            # disagreement is catalog corruption, not a caller mismatch.
            if not _installed_artifact_target_equal_v1(
                slot.target, slot.manifest.target):
                _installed_artifact_catalog_v1.lifecycle =
                    InstalledArtifactCatalogLifecycleV1.Quarantined
                _ = _installed_artifact_unlock_v1()
                return nil
            # Reject mismatched admission context before nested copies and
            # canonical hashing. This is not catalog corruption.
            if not _installed_artifact_target_equal_v1(slot.target, target):
                _ = _installed_artifact_unlock_v1()
                return nil
        case nil: ()
    val copied = _installed_artifact_record_copy_v1(slot)
    if not copied.?:
        _installed_artifact_catalog_v1.lifecycle =
            InstalledArtifactCatalogLifecycleV1.Quarantined
        _ = _installed_artifact_unlock_v1()
        return nil
    val candidate = InstalledArtifactLookupCandidateV1(
        slot: index, generation: slot.generation,
        expected_integrity_sha256: slot.record_integrity_sha256,
        record: copied.unwrap())
    if not _installed_artifact_unlock_v1(): return nil

    # Hashing and nested-copy validation are bounded but potentially expensive;
    # perform them outside the catalog mutex. Sealed rows cannot change.
    val actual_integrity = _installed_artifact_record_integrity_v1(candidate.record)
    var requested_path_bound = candidate.record.canonical_path == path
    if not requested_path_bound:
        for alias in candidate.record.aliases:
            if alias == path: requested_path_bound = true
    if not requested_path_bound or actual_integrity == "" or
        actual_integrity != candidate.expected_integrity_sha256:
        if _installed_artifact_lock_v1():
            _installed_artifact_catalog_v1.lifecycle =
                InstalledArtifactCatalogLifecycleV1.Quarantined
            _ = _installed_artifact_unlock_v1()
        return nil

    if not _installed_artifact_lock_v1(): return nil
    val confirmed_slot = match expected_target:
        case Some(target): _installed_artifact_find_locked_v1(path, target)
        case nil: _installed_artifact_find_unique_path_locked_v1(path)
    if _installed_artifact_catalog_v1.lifecycle != InstalledArtifactCatalogLifecycleV1.Sealed or
        confirmed_slot != candidate.slot or
        candidate.slot < 0 or
        candidate.slot >= _installed_artifact_catalog_v1.records.len() or
        _installed_artifact_catalog_v1.records[candidate.slot].generation !=
            candidate.generation or
        _installed_artifact_catalog_v1.records[candidate.slot].record_integrity_sha256 !=
            candidate.expected_integrity_sha256:
        _installed_artifact_catalog_v1.lifecycle =
            InstalledArtifactCatalogLifecycleV1.Quarantined
        _ = _installed_artifact_unlock_v1()
        return nil
    if not _installed_artifact_unlock_v1(): return nil
    Some(candidate)

fn _authenticated_alias_plan_fail_v1(
    error: AuthenticatedVfsExecutableAliasPlanErrorV1
) -> AuthenticatedVfsExecutableAliasPlanV1:
    AuthenticatedVfsExecutableAliasPlanV1(ok: false, error: error, nodes: [])

fn _installed_artifact_record_contains_alias_v1(
    record: InstalledArtifactRecordV1, path: text
) -> bool:
    for alias in record.aliases:
        if alias == path: return true
    false

pub(package) fn installed_artifact_catalog_authenticated_alias_plan_v1(
    lookup_path: text,
    target: ManifestTarget,
    requested_aliases: [text]
) -> AuthenticatedVfsExecutableAliasPlanV1:
    """Plan only from an identity-bound sealed-catalog lookup.

    The plan neither creates VFS nodes nor copies payload bytes, mutates a
    filesystem, or grants launch authority.
    """
    if not _installed_artifact_target_valid_v1(target):
        return _authenticated_alias_plan_fail_v1(
            AuthenticatedVfsExecutableAliasPlanErrorV1.SourceRecordInvalid)
    val looked_up = _installed_artifact_catalog_lookup_bound_v1(
        lookup_path, Some(target))
    if not looked_up.?:
        return _authenticated_alias_plan_fail_v1(
            AuthenticatedVfsExecutableAliasPlanErrorV1.SourceRecordInvalid)
    val candidate = looked_up.unwrap()
    # Recompute at the plan-consume boundary and require the exact integrity
    # retained by the catalog slot. No caller-visible provenance participates.
    val actual_integrity = _installed_artifact_record_integrity_v1(candidate.record)
    if (actual_integrity == "" or
        actual_integrity != candidate.expected_integrity_sha256 or
        candidate.generation == 0u64):
        return _authenticated_alias_plan_fail_v1(
            AuthenticatedVfsExecutableAliasPlanErrorV1.SourceRecordInvalid)
    if requested_aliases.len() == 0 or
        requested_aliases.len() > SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_LIMIT_V1:
        return _authenticated_alias_plan_fail_v1(
            AuthenticatedVfsExecutableAliasPlanErrorV1.RequestedAliasCountInvalid)

    val record = candidate.record
    val source = AuthenticatedVfsExecutableSourceIdentityV1(
        canonical_path: record.canonical_path, target: record.target,
        content_sha256: record.content_sha256,
        expected_trust_root_sha256: record.expected_trust_root_sha256,
        manifest_identity_sha256: record.manifest_identity_sha256)
    var nodes: [AuthenticatedVfsExecutableAliasNodePlanV1] = []
    var index: i64 = 0
    while index < requested_aliases.len():
        val requested = requested_aliases[index]
        if not installed_artifact_path_shape_valid_v1(requested) or
            requested == record.canonical_path:
            return _authenticated_alias_plan_fail_v1(
                AuthenticatedVfsExecutableAliasPlanErrorV1.RequestedAliasPathInvalid)
        if not _installed_artifact_record_contains_alias_v1(record, requested):
            return _authenticated_alias_plan_fail_v1(
                AuthenticatedVfsExecutableAliasPlanErrorV1.RequestedAliasNotCatalogued)
        var prior: i64 = 0
        while prior < index:
            if requested_aliases[prior] == requested:
                return _authenticated_alias_plan_fail_v1(
                    AuthenticatedVfsExecutableAliasPlanErrorV1.RequestedAliasDuplicate)
            prior = prior + 1
        nodes.push(AuthenticatedVfsExecutableAliasNodePlanV1(
            requested_path: requested, source: source))
        index = index + 1
    AuthenticatedVfsExecutableAliasPlanV1(
        ok: true, error: AuthenticatedVfsExecutableAliasPlanErrorV1.None,
        nodes: nodes)

pub fn installed_artifact_catalog_lookup_v1(path: text) -> InstalledArtifactRecordV1?:
    if val candidate = _installed_artifact_catalog_lookup_bound_v1(path, nil):
        return Some(candidate.record)
    nil

pub(package) fn installed_artifact_catalog_lookup_target_v1(
    path: text,
    target: ManifestTarget
) -> InstalledArtifactRecordV1?:
    """Return metadata only when the installed artifact exactly matches target.

    Target mismatch is a caller/admission failure, not catalog corruption, so
    it does not quarantine the sealed catalog. The returned value remains a
    deep-owned diagnostic snapshot and never grants execution authority.
    """
    if not _installed_artifact_target_valid_v1(target): return nil
    if val candidate = _installed_artifact_catalog_lookup_bound_v1(
        path, Some(target)):
        return Some(candidate.record)
    nil

pub fn installed_artifact_catalog_status_v1() -> InstalledArtifactCatalogStatusV1?:
    if not _installed_artifact_lock_v1(): return nil
    val result = InstalledArtifactCatalogStatusV1(
        lifecycle: _installed_artifact_catalog_v1.lifecycle,
        artifact_count: _installed_artifact_catalog_v1.records.len() as i64)
    if not _installed_artifact_unlock_v1(): return nil
    Some(result)
