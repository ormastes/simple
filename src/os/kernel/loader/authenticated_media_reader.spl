# Shared bounded sidecar reader for authenticated executable media.
# MountTable remains caller-owned; this function receives a scoped mutable loan
# and closes every handle before returning.

use std.fs_driver.mount_table.{MountTable}
use std.fs_driver.types.{OpenFlags}

pub fn authenticated_media_read_text_v1(
    table: mut MountTable, path: text, maximum: i64
) -> text?:
    if maximum < 1: return nil
    val opened = table.open(path, OpenFlags.read_only())
    if opened.is_err(): return nil
    val handle = opened.unwrap()
    val stat = table.fstat(handle)
    if stat.is_err() or stat.unwrap().size < 1u64 or stat.unwrap().size > maximum.to_u64():
        _ = table.close(handle)
        return nil
    val read = table.read(handle, stat.unwrap().size.to_i64())
    val closed = table.close(handle)
    if read.is_err() or closed.is_err(): return nil
    Some(read.unwrap())

export authenticated_media_read_text_v1
