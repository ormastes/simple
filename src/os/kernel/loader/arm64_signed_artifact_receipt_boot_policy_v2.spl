"""ARM64 adapter for independently rooted SCR2 boot policy."""

use os.kernel.loader.authenticated_media_parser.{authenticated_media_hex_bytes_v1}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1}
use os.kernel.loader.signed_artifact_receipt_boot_policy_v2.{
    SignedArtifactReceiptLocalBootPolicyAdmissionV2,
    signed_artifact_receipt_boot_policy_read_arm64_v2}
use arm64_auth_trust_config.{
    arm64_authenticated_pinned_key_id_v1,
    arm64_authenticated_pinned_public_key_hex_v1}

pub fn arm64_signed_artifact_receipt_boot_policy_read_v2(
) -> SignedArtifactReceiptLocalBootPolicyAdmissionV2:
    signed_artifact_receipt_boot_policy_read_arm64_v2(
        ExecutableManifestTrustedSignerV1(
            key_id: arm64_authenticated_pinned_key_id_v1(),
            public_key: authenticated_media_hex_bytes_v1(
                arm64_authenticated_pinned_public_key_hex_v1())))
