# x86-32 authenticated filesystem-exec handoff.
#
# Path-only callers remain rejected by fs_exec_spawn_as.  The live route below
# accepts only the loader registry's one-shot token and leaves address-space
# construction/publication with the scheduler adoption owner.

use os.kernel.loader.fs_exec_spawn.{
    fs_exec_spawn_as, fs_exec_adopt_authenticated_with_launch_v1,
    FsExecAuthenticatedRunResultV1
}
use std.fs_driver.mount_table.{MountTable}
use os.kernel.loader.executable_authority_registry.{
    ExecutableAuthorityRegistryV1, ExecutableAuthorityTokenV1
}
use os.kernel.loader.executable_load_plan_v1.{ExecutableLoadConsumerV1}
use os.kernel.scheduler.scheduler_types.{Scheduler}
use os.kernel.arch.arch_context.{Architecture}
use os.kernel.arch.user_entry_bridge.{dispatch_fs_exec_user_handoff}
use os.kernel.types.task_types.{TaskId}
use os.kernel.scheduler.scheduler.{
    wait_collect_result_error, wait_collect_result_status
}
use os.kernel.scheduler.process_execution_observation.{
    SchedulerExecutionDeliveryStatusV2,
    scheduler_execution_compare_and_deliver_reaped_v2,
    scheduler_execution_discard_terminal_v2
}

pub fn x86_32_fs_exec_spawn(path: text, argv: [text], envp: [text]) -> i64:
    """Reject an unauthenticated pathname-only i386 execution request."""
    fs_exec_spawn_as(0, path, argv, envp)

pub fn x86_32_fs_exec_spawn_authenticated_with_launch_v1(
    scheduler: Scheduler,
    table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    token: ExecutableAuthorityTokenV1,
    consumer: ExecutableLoadConsumerV1,
    entry_point: u64,
    caller: i64,
    path: text,
    argv: [text],
    envp: [text],
    recipe: i64
) -> FsExecAuthenticatedRunResultV1:
    """Consume authority, enter i386 CPL3, and deliver scheduler evidence."""
    val prepared = fs_exec_adopt_authenticated_with_launch_v1(
        scheduler, table, authorities, token, consumer, entry_point,
        caller, path, argv, envp, recipe)
    if prepared.pid <= 0:
        return FsExecAuthenticatedRunResultV1(
            exit_code: prepared.pid, evidence: nil)

    val child = TaskId(id: prepared.pid.to_u64())
    val exit_code = dispatch_fs_exec_user_handoff(
        Architecture.X86, child.id, prepared.scheduler)
    var owner = prepared.scheduler
    owner.exit_task_by_id(child, exit_code.to_i32())
    val collected = owner.wait_for_collect(TaskId(id: 0u64), child, false)
    if wait_collect_result_error(collected) != 0 or
       wait_collect_result_status(collected) != exit_code.to_i32():
        _ = scheduler_execution_discard_terminal_v2(child.id)
        return FsExecAuthenticatedRunResultV1(exit_code: -10, evidence: nil)

    val delivered = scheduler_execution_compare_and_deliver_reaped_v2(
        child.id, path, argv)
    if delivered.status != SchedulerExecutionDeliveryStatusV2.Delivered:
        _ = scheduler_execution_discard_terminal_v2(child.id)
        return FsExecAuthenticatedRunResultV1(exit_code: -10, evidence: nil)
    FsExecAuthenticatedRunResultV1(
        exit_code: exit_code, evidence: delivered.token)

