# SMF Loader — minimal Simple Module Format loader for kernel use
#
# SMF v1.3 places a 96-byte #[repr(C)] header trailer at EOF-96 (matching
# compiler.backend.linker.smf_header). Legacy SMF v1.1 packed trailers sit at
# EOF-128 with kernel role/arch/ABI bytes at offsets 60..62.
# Magic bytes: [83, 77, 70, 0] ("SMF\0").
#
# SMF executable support is envelope-first: if the package carries a native
# executable stub, the kernel delegates that embedded image to the ELF loader.
# Native SMF code-section mapping remains a later stage.

use os.kernel.arch.arch_context.{Architecture}
use os.kernel.types.vmspace_types.{ProcessVmSpace}
use os.kernel.loader.elf64.{elf64_load}
use os.kernel.loader.elf_loader.{elf_admit_executable}
use os.kernel.loader.byte_utils.{byte_at, lb_read_u32_le, lb_read_u64_le, has_magic, in_range}
extern fn rt_array_new_with_cap(cap: i64) -> [u8]

# SMF magic "SMF\0"
val SMF64_MAGIC_0: u8 = 83    # 'S'
val SMF64_MAGIC_1: u8 = 77    # 'M'
val SMF64_MAGIC_2: u8 = 70    # 'F'
val SMF64_MAGIC_3: u8 = 0     # '\0'

val SMF_HEADER_TRAILER_SIZE: i64 = 128
val SMF_ENTRY_POINT_OFFSET: i64  = 44  # offset within 128B legacy trailer
val SMF_STUB_SIZE_OFFSET: i64    = 52  # offset within 128B legacy trailer
val SMF_DATA_OFFSET_OFFSET: i64  = 56  # offset within 128B legacy trailer
val SMF_ROLE_OFFSET: i64         = 60  # 0=unspecified, 1=executable, 2=library (128B legacy)
val SMF_ARCH_OFFSET: i64         = 61  # 0=unspecified, 1=x86_64, 2=x86, 3=arm64, 4=arm32, 5=rv64, 6=rv32
val SMF_ABI_OFFSET: i64          = 62  # 0=unspecified, 1=simpleos

# Canonical v1.3 96-byte #[repr(C)] layout offsets (see smf_header.spl)
val SMF_V13_HEADER_SIZE: i64          = 96
val SMF_V13_VERSION_MAJOR: i64        = 1
val SMF_V13_VERSION_MINOR: i64        = 3
val SMF_V13_PLATFORM_OFFSET: i64      = 6
val SMF_V13_ARCH_OFFSET: i64          = 7   # smf_enums.Arch: 0=x86_64, 1=aarch64, 2=x86, 3=arm, 4=rv64, 5=rv32
val SMF_V13_FLAGS_OFFSET: i64         = 8
val SMF_V13_SECTION_COUNT_OFFSET: i64 = 16
val SMF_V13_PADDING_OFFSET: i64       = 20
val SMF_V13_SECTION_TABLE_OFFSET: i64 = 24
val SMF_V13_ENTRY_POINT_OFFSET: i64   = 48
val SMF_V13_STUB_SIZE_OFFSET: i64     = 56
val SMF_V13_DATA_OFFSET_OFFSET: i64   = 60  # u32 LE smf_data_offset in 96B layout

val SMF_V13_FLAG_EXECUTABLE: i64 = 0x0001
val SMF_V13_FLAG_RELOADABLE: i64 = 0x0002

val SMF_V13_PLATFORM_ANY: i64      = 0
val SMF_V13_PLATFORM_SIMPLEOS: i64 = 5   # smf_enums.Platform.None_ (bare-metal SimpleOS)

val SMF_ERR_MALFORMED: text = "SMF_ERR_MALFORMED"
val SMF_ERR_WRONG_ROLE: text = "SMF_ERR_WRONG_ROLE"
val SMF_ERR_WRONG_ARCH: text = "SMF_ERR_WRONG_ARCH"
val SMF_ERR_ABI_MISMATCH: text = "SMF_ERR_ABI_MISMATCH"
val SMF_ERR_MISSING_ELF: text = "SMF_ERR_MISSING_ELF"
val SMF_ERR_MISSING_NATIVE_LIBRARY: text = "SMF_ERR_MISSING_NATIVE_LIBRARY"

# ============================================================================
# Structs
# ============================================================================

struct SmfHeader:
    """Parsed fields from the 128-byte SMF trailer."""
    magic_ok:        bool   # True if magic validated
    entry_point:     i64    # Entry-point vaddr (from trailer offset 44)
    header_offset:   i64    # Absolute offset of parsed header
    stub_size:       i64    # v1.1 executable stub size
    smf_data_offset: i64    # v1.1 offset where SMF payload begins
    role:            i64    # package role discriminator
    arch:            i64    # package architecture discriminator
    abi:             i64    # package ABI discriminator

# ============================================================================
# Internal helpers
# ============================================================================

fn _smf_byte_at(data: [u8], off: i64) -> u8:
    byte_at(data, off)

fn _smf_read_u64_le(data: [u8], off: i64) -> i64:
    lb_read_u64_le(data, off)

fn _smf_read_u32_le(data: [u8], off: i64) -> i64:
    lb_read_u32_le(data, off)

fn _smf_magic_at(bytes: [u8], off: i64) -> bool:
    has_magic(bytes, off, SMF64_MAGIC_0, SMF64_MAGIC_1, SMF64_MAGIC_2, SMF64_MAGIC_3)

fn _smf_is_v13_or_seed_at(bytes: [u8], off: i64) -> bool:
    if off < 0 or off + SMF_V13_HEADER_SIZE > bytes.len():
        return false
    if not _smf_magic_at(bytes, off):
        return false
    val maj = _smf_byte_at(bytes, off + 4) as i64
    val min = _smf_byte_at(bytes, off + 5) as i64
    if maj == SMF_V13_VERSION_MAJOR and min >= SMF_V13_VERSION_MINOR:
        return true
    if off + SMF_HEADER_TRAILER_SIZE == bytes.len():
        return false
    val section_count = _smf_read_u32_le(bytes, off + SMF_V13_SECTION_COUNT_OFFSET)
    val padding = _smf_read_u32_le(bytes, off + SMF_V13_PADDING_OFFSET)
    val section_table = _smf_read_u64_le(bytes, off + SMF_V13_SECTION_TABLE_OFFSET)
    section_count > 0 and padding == 0 and section_table != 0

fn _smf_v13_arch_to_kernel(wire_arch: i64) -> i64:
    """Map smf_enums.Arch (0=x86_64..5=rv32) to kernel Architecture discriminant (1..6)."""
    if wire_arch == 0: return 1
    if wire_arch == 1: return 3
    if wire_arch == 2: return 2
    if wire_arch == 3: return 4
    if wire_arch == 4: return 5
    if wire_arch == 5: return 6
    -1

fn _smf_v13_flags_to_role(flags: i64) -> i64:
    """Derive kernel SMF role (1=executable, 2=library, 0=unspecified) from v1.3 flags."""
    if (flags & SMF_V13_FLAG_EXECUTABLE) != 0:
        return 1
    if (flags & SMF_V13_FLAG_RELOADABLE) != 0:
        return 2
    0

fn _smf_v13_platform_to_abi(platform: i64) -> i64:
    """Map smf_enums.Platform byte to kernel ABI discriminator (0=any, 1=simpleos, >1=other OS)."""
    if platform == SMF_V13_PLATFORM_ANY:
        return 0
    if platform == SMF_V13_PLATFORM_SIMPLEOS:
        return 1
    platform + 1

fn smf_header_offset(bytes: [u8]) -> i64:
    """Return header offset, matching smf_header_trailer_offset precedence.

    Precedence: v1.3+ at EOF-96, legacy 128B at EOF-128, seed-shaped 96B at
    EOF-96, then leading header at offset 0. Returns -1 if absent.
    """
    if bytes.len() < 4:
        return -1
    if bytes.len() >= SMF_V13_HEADER_SIZE:
        val v13_off = bytes.len() - SMF_V13_HEADER_SIZE
        if (_smf_magic_at(bytes, v13_off) and
            (_smf_byte_at(bytes, v13_off + 4) as i64) == SMF_V13_VERSION_MAJOR and
            (_smf_byte_at(bytes, v13_off + 5) as i64) >= SMF_V13_VERSION_MINOR):
            return v13_off
    if bytes.len() >= SMF_HEADER_TRAILER_SIZE:
        val trailer = bytes.len() - SMF_HEADER_TRAILER_SIZE
        if _smf_magic_at(bytes, trailer):
            return trailer
    if bytes.len() >= SMF_V13_HEADER_SIZE:
        val seed_off = bytes.len() - SMF_V13_HEADER_SIZE
        if _smf_is_v13_or_seed_at(bytes, seed_off):
            return seed_off
    if _smf_magic_at(bytes, 0):
        return 0
    -1

# ============================================================================
# Public API
# ============================================================================

fn smf_check_magic(bytes: [u8]) -> bool:
    """Return true if `bytes` starts with the SMF magic 'SMF\\0'."""
    _smf_magic_at(bytes, 0)

fn smf_has_header(bytes: [u8]) -> bool:
    """Return true if bytes contain a supported SMF header location."""
    smf_header_offset(bytes) >= 0

fn smf_parse_header(bytes: [u8]) -> SmfHeader?:
    """Validate SMF magic and return a parsed header.

    Supports canonical v1.3 / seed 96-byte #[repr(C)] headers as well as legacy
    128-byte packed trailers and offset-0 headers.
    """
    val off = smf_header_offset(bytes)
    if off < 0:
        return None
    if _smf_is_v13_or_seed_at(bytes, off):
        val flags = _smf_read_u32_le(bytes, off + SMF_V13_FLAGS_OFFSET)
        val wire_arch = _smf_byte_at(bytes, off + SMF_V13_ARCH_OFFSET) as i64
        val platform = _smf_byte_at(bytes, off + SMF_V13_PLATFORM_OFFSET) as i64
        val entry = _smf_read_u64_le(bytes, off + SMF_V13_ENTRY_POINT_OFFSET)
        val stub_size = _smf_read_u32_le(bytes, off + SMF_V13_STUB_SIZE_OFFSET)
        val smf_data_offset = _smf_read_u32_le(bytes, off + SMF_V13_DATA_OFFSET_OFFSET)
        return Some(SmfHeader(
            magic_ok: true,
            entry_point: entry,
            header_offset: off,
            stub_size: stub_size,
            smf_data_offset: smf_data_offset,
            role: _smf_v13_flags_to_role(flags),
            arch: _smf_v13_arch_to_kernel(wire_arch),
            abi: _smf_v13_platform_to_abi(platform)
        ))
    if off + SMF_HEADER_TRAILER_SIZE > bytes.len():
        return None
    val entry = _smf_read_u64_le(bytes, off + SMF_ENTRY_POINT_OFFSET)
    val stub_size = _smf_read_u32_le(bytes, off + SMF_STUB_SIZE_OFFSET)
    val smf_data_offset = _smf_read_u32_le(bytes, off + SMF_DATA_OFFSET_OFFSET)
    val role = _smf_byte_at(bytes, off + SMF_ROLE_OFFSET) as i64
    val arch = _smf_byte_at(bytes, off + SMF_ARCH_OFFSET) as i64
    val abi = _smf_byte_at(bytes, off + SMF_ABI_OFFSET) as i64
    Some(SmfHeader(
        magic_ok: true,
        entry_point: entry,
        header_offset: off,
        stub_size: stub_size,
        smf_data_offset: smf_data_offset,
        role: role,
        arch: arch,
        abi: abi
    ))

fn _smf_explicit_arch_matches_elf(bytes: [u8], arch: i64, stub_size: i64) -> bool:
    if stub_size < 64 or stub_size > bytes.len():
        return false
    if not _smf_has_elf_magic(bytes) or (_smf_byte_at(bytes, 5) as i64) != 1 or
       (_smf_byte_at(bytes, 6) as i64) != 1:
        return false
    val class = _smf_byte_at(bytes, 4) as i64
    val machine = (_smf_byte_at(bytes, 18) as i64) |
        ((_smf_byte_at(bytes, 19) as i64) << 8)
    (arch == 1 and machine == 62 and class == 2) or
        (arch == 2 and machine == 3 and class == 1) or
        (arch == 3 and machine == 183 and class == 2) or
        (arch == 4 and machine == 40 and class == 1) or
        (arch == 5 and machine == 243 and class == 2) or
        (arch == 6 and machine == 243 and class == 1)

fn smf_admit_explicit_simpleos_executable(bytes: [u8]) -> Result<(), text>:
    """Admit one canonical v1.1 or v1.3 SimpleOS executable envelope."""
    val parsed = smf_parse_header(bytes)
    if parsed.is_none():
        return Err(SMF_ERR_MALFORMED)
    val header = parsed.unwrap()
    val is_v13 = _smf_is_v13_or_seed_at(bytes, header.header_offset)
    val expected_size = if is_v13: SMF_V13_HEADER_SIZE else: SMF_HEADER_TRAILER_SIZE
    val maj = _smf_byte_at(bytes, header.header_offset + 4) as i64
    val min = _smf_byte_at(bytes, header.header_offset + 5) as i64
    val ver_ok = maj == 1 and (min == 1 or (is_v13 and min >= SMF_V13_VERSION_MINOR))
    if header.header_offset != bytes.len() - expected_size or not ver_ok:
        return Err(SMF_ERR_MALFORMED)
    if header.role != 1:
        return Err(SMF_ERR_WRONG_ROLE)
    if header.arch < 1 or header.arch > 6:
        return Err(SMF_ERR_WRONG_ARCH)
    if header.abi != 1:
        return Err(SMF_ERR_ABI_MISMATCH)
    if header.stub_size < 64 or header.stub_size > header.header_offset or
       header.smf_data_offset != header.stub_size:
        return Err(SMF_ERR_MALFORMED)
    if not _smf_explicit_arch_matches_elf(bytes, header.arch, header.stub_size):
        return Err(SMF_ERR_MISSING_ELF)
    Ok(())

fn _smf_has_elf_magic(bytes: [u8]) -> bool:
    if bytes.len() < 4:
        return false
    _smf_byte_at(bytes, 0) == 0x7F.to_u8() and _smf_byte_at(bytes, 1) == 0x45.to_u8() and _smf_byte_at(bytes, 2) == 0x4C.to_u8() and _smf_byte_at(bytes, 3) == 0x46.to_u8()

fn _smf_has_macho_magic(bytes: [u8]) -> bool:
    if bytes.len() < 4:
        return false
    val b0 = _smf_byte_at(bytes, 0)
    val b1 = _smf_byte_at(bytes, 1)
    val b2 = _smf_byte_at(bytes, 2)
    val b3 = _smf_byte_at(bytes, 3)
    # Mach-O 32/64-bit, reverse-byte-order variants, and universal/fat headers.
    (b0 == 0xFE.to_u8() and b1 == 0xED.to_u8() and b2 == 0xFA.to_u8() and (b3 == 0xCE.to_u8() or b3 == 0xCF.to_u8())) or
    ((b0 == 0xCE.to_u8() or b0 == 0xCF.to_u8()) and b1 == 0xFA.to_u8() and b2 == 0xED.to_u8() and b3 == 0xFE.to_u8()) or
    (b0 == 0xCA.to_u8() and b1 == 0xFE.to_u8() and b2 == 0xBA.to_u8() and b3 == 0xBE.to_u8()) or
    (b0 == 0xBE.to_u8() and b1 == 0xBA.to_u8() and b2 == 0xFE.to_u8() and b3 == 0xCA.to_u8())

fn _smf_has_native_library_magic(bytes: [u8]) -> bool:
    _smf_has_elf_magic(bytes) or _smf_has_macho_magic(bytes)

fn _smf_copy_range(bytes: [u8], off: i64, size: i64) -> [u8]:
    """Copy size bytes from bytes[off..off+size). Returns empty on out-of-range."""
    if not in_range(bytes, off, size):
        return []
    var out: [u8] = rt_array_new_with_cap(size)
    var i: i64 = 0
    while i < size:
        out.push(_smf_byte_at(bytes, off + i))
        i = i + 1
    out

fn _smf_arch_code(arch: Architecture) -> i64:
    match arch:
        case Architecture.X86_64:
            1
        case Architecture.X86:
            2
        case Architecture.Arm64:
            3
        case Architecture.Arm32:
            4
        case Architecture.Riscv64:
            5
        case Architecture.Riscv32:
            6
        case _:
            -1

fn _smf_header_accepts_arch(hdr: SmfHeader, arch: Architecture) -> bool:
    hdr.arch == 0 or hdr.arch == _smf_arch_code(arch)

fn smf_extract_executable_stub(bytes: [u8]) -> Result<[u8], text>:
    """Return the embedded native executable stub from an SMF envelope.

    Current SimpleOS support intentionally treats SMF as a package envelope
    around a normal executable. Only ELF stubs are accepted; native SMF
    code-section mapping remains owned by a later mapper implementation.
    """
    val hdr_opt = smf_parse_header(bytes)
    if hdr_opt.is_none():
        return Err(SMF_ERR_MALFORMED)
    val hdr = hdr_opt.unwrap()
    if hdr.role != 0 and hdr.role != 1:
        return Err(SMF_ERR_WRONG_ROLE)
    if hdr.abi != 0 and hdr.abi != 1:
        return Err(SMF_ERR_ABI_MISMATCH)
    if hdr.stub_size <= 0:
        return Err(SMF_ERR_MISSING_ELF)
    if hdr.stub_size > hdr.header_offset:
        return Err(SMF_ERR_MALFORMED)
    val stub = _smf_copy_range(bytes, 0, hdr.stub_size)
    if not _smf_has_elf_magic(stub):
        return Err(SMF_ERR_MISSING_ELF)
    Ok(stub)

fn smf_extract_executable_stub_for_arch(bytes: [u8], arch: Architecture) -> Result<[u8], text>:
    """Return the embedded ELF stub after validating executable SMF metadata."""
    val hdr_opt = smf_parse_header(bytes)
    if hdr_opt.is_none():
        return Err(SMF_ERR_MALFORMED)
    val hdr = hdr_opt.unwrap()
    if hdr.role != 0 and hdr.role != 1:
        return Err(SMF_ERR_WRONG_ROLE)
    if not _smf_header_accepts_arch(hdr, arch):
        return Err(SMF_ERR_WRONG_ARCH)
    if hdr.abi != 0 and hdr.abi != 1:
        return Err(SMF_ERR_ABI_MISMATCH)
    if hdr.stub_size <= 0:
        return Err(SMF_ERR_MISSING_ELF)
    if hdr.stub_size > hdr.header_offset:
        return Err(SMF_ERR_MALFORMED)
    val stub = _smf_copy_range(bytes, 0, hdr.stub_size)
    if not _smf_has_elf_magic(stub):
        return Err(SMF_ERR_MISSING_ELF)
    Ok(stub)

fn smf_extract_library_stub(bytes: [u8]) -> Result<[u8], text>:
    """Return the embedded native shared-library stub from a role-2 SMF envelope."""
    val hdr_opt = smf_parse_header(bytes)
    if hdr_opt.is_none():
        return Err(SMF_ERR_MALFORMED)
    val hdr = hdr_opt.unwrap()
    if hdr.role != 2:
        return Err(SMF_ERR_WRONG_ROLE)
    if hdr.abi != 0 and hdr.abi != 1:
        return Err(SMF_ERR_ABI_MISMATCH)
    if hdr.stub_size <= 0:
        return Err(SMF_ERR_MISSING_NATIVE_LIBRARY)
    if hdr.stub_size > hdr.header_offset:
        return Err(SMF_ERR_MALFORMED)
    val stub = _smf_copy_range(bytes, 0, hdr.stub_size)
    if not _smf_has_native_library_magic(stub):
        return Err(SMF_ERR_MISSING_NATIVE_LIBRARY)
    Ok(stub)

fn smf_extract_library_stub_for_arch(bytes: [u8], arch: Architecture) -> Result<[u8], text>:
    """Return the embedded native shared-library stub after validating SMF metadata."""
    val hdr_opt = smf_parse_header(bytes)
    if hdr_opt.is_none():
        return Err(SMF_ERR_MALFORMED)
    val hdr = hdr_opt.unwrap()
    if hdr.role != 2:
        return Err(SMF_ERR_WRONG_ROLE)
    if not _smf_header_accepts_arch(hdr, arch):
        return Err(SMF_ERR_WRONG_ARCH)
    if hdr.abi != 0 and hdr.abi != 1:
        return Err(SMF_ERR_ABI_MISMATCH)
    if hdr.stub_size <= 0:
        return Err(SMF_ERR_MISSING_NATIVE_LIBRARY)
    if hdr.stub_size > hdr.header_offset:
        return Err(SMF_ERR_MALFORMED)
    val stub = _smf_copy_range(bytes, 0, hdr.stub_size)
    if not _smf_has_native_library_magic(stub):
        return Err(SMF_ERR_MISSING_NATIVE_LIBRARY)
    Ok(stub)

fn smf_executable_entry_point_for_arch(bytes: [u8], arch: Architecture) -> Result<i64, text>:
    """Return the SMF executable entry point after validating envelope metadata."""
    val hdr_opt = smf_parse_header(bytes)
    if hdr_opt.is_none():
        return Err(SMF_ERR_MALFORMED)
    val hdr: SmfHeader = hdr_opt.unwrap()
    if hdr.role != 0 and hdr.role != 1:
        return Err(SMF_ERR_WRONG_ROLE)
    if not _smf_header_accepts_arch(hdr, arch):
        return Err(SMF_ERR_WRONG_ARCH)
    if hdr.abi != 0 and hdr.abi != 1:
        return Err(SMF_ERR_ABI_MISMATCH)
    Ok(hdr.entry_point)

fn smf_extract_executable_stub_unchecked(bytes: [u8]) -> [u8]:
    """ARM-safe scalar SMF stub extraction without Result/unwrap."""
    val hdr_opt = smf_parse_header(bytes)
    if hdr_opt.is_none():
        return []
    val hdr = hdr_opt.unwrap()
    if hdr.role != 0 and hdr.role != 1:
        return []
    if hdr.abi != 0 and hdr.abi != 1:
        return []
    if hdr.stub_size <= 0:
        if hdr.header_offset > 0 and _smf_has_elf_magic(bytes):
            return _smf_copy_range(bytes, 0, hdr.header_offset)
        return []
    if hdr.stub_size > hdr.header_offset:
        if hdr.header_offset > 0 and _smf_has_elf_magic(bytes):
            return _smf_copy_range(bytes, 0, hdr.header_offset)
        return []
    val stub = _smf_copy_range(bytes, 0, hdr.stub_size)
    if not _smf_has_elf_magic(stub):
        if hdr.header_offset > 0 and _smf_has_elf_magic(bytes):
            return _smf_copy_range(bytes, 0, hdr.header_offset)
        return []
    stub

fn smf_load(bytes: [u8], space: ProcessVmSpace) -> i64:
    """Map an SMF image into `space` and return its entry-point.

    This stage supports SMF packages that carry an ELF executable stub. Native
    SMF code-section mapping still returns -ENOSYS until the shared-object
    mapper lands.
    """
    if not smf_has_header(bytes):
        return -8   # -ENOEXEC
    val stub = smf_extract_executable_stub(bytes)
    if stub.is_err():
        return -38  # -ENOSYS — native SMF mapping deferred
    elf64_load(stub.unwrap(), space)
