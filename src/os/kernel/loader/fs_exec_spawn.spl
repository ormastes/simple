# Shared filesystem-exec scheduler bridge.
#
# Keeps executable-byte resolution, process-image construction, scheduler task
# creation, and common status mapping in one place. Per-arch differences are
# reduced to the active architecture selection, byte-source bridge, and the
# optional live handoff hook.

use os.kernel.arch.arch_context.{Architecture}
use os.kernel.loader.cap_exec_gate.{exec_cap_check}
use os.kernel.loader.byte_utils.{byte_len}
use std.fs_driver.mount_table.{MountTable}
use os.kernel.loader.executable_authority_registry.{
    ExecutableAuthorityRegistryV1, ExecutableAuthorityTokenV1
}
use os.kernel.loader.executable_load_plan_v1.{ExecutableLoadConsumerV1}
use os.kernel.loader.executable_launch_arguments_v1.{
    executable_launch_arguments_v1_errno,
    executable_launch_arguments_v1_validate
}
use os.kernel.scheduler.scheduler_executable_adoption.{
    SchedulerExecutableAdoptionResultV1
}
use os.kernel.scheduler.scheduler_types.{
    Scheduler,
    TaskControlBlock, ReadyQueue, CpuRunQueue,
    SchedulerExecutableAdoptionOwnerStateV1
}
use os.kernel.scheduler.green_carrier.{
    green_carrier_execution_state_new, green_carrier_parallelism_new
}
use os.kernel.loader.spawn_authority.{
    spawn_authority_check_spawn,
    spawn_authority_spawn_caps
}
use os.kernel.loader.spawn_recipes.{
    spawn_recipe_is_migrated, spawn_recipe_seed_parent_caps
}
use os.kernel.types.task_types.{TaskId, TaskPriority, scheduler_flat_topology}
use os.kernel.types.capability_types.{CapabilitySet}

extern fn serial_println(msg: text)

# `fs_exec_prepare_spawn_from_bytes` is a shared cross-arch bridge (x86_64,
# arm64, riscv, ...). Only the arm64 freestanding ABI hands out raw
# (untagged) array pointers that need the raw-safe length probe. That
# per-arch split already lives in byte_utils.spl's `byte_len` (see also
# process_image.spl's `_pi_byte_len`) — reuse it here instead of
# re-duplicating the six @cfg arms.

@cfg(arm64)
use os.services.vfs.arm_fs_exec_vfs.{arm_fs_exec_read_file_bytes}

@cfg(arm32)
use os.services.vfs.arm_fs_exec_vfs.{arm_fs_exec_read_file_bytes}

@cfg(x86_64)
use os.services.vfs.vfs_init.{g_vfs_read_executable_bytes}

@cfg(x86)
use os.services.vfs.vfs_init.{g_vfs_read_executable_bytes}

@cfg(riscv64)
use os.services.vfs.vfs_init.{g_vfs_read_executable_bytes}

@cfg(riscv32)
use os.services.vfs.vfs_init.{g_vfs_read_executable_bytes}

@cfg(x86_64)
fn _fs_exec_active_arch() -> Architecture:
    Architecture.X86_64

@cfg(x86)
fn _fs_exec_active_arch() -> Architecture:
    Architecture.X86

@cfg(arm64)
fn _fs_exec_active_arch() -> Architecture:
    Architecture.Arm64

@cfg(arm32)
fn _fs_exec_active_arch() -> Architecture:
    Architecture.Arm32

@cfg(riscv64)
fn _fs_exec_active_arch() -> Architecture:
    Architecture.Riscv64

@cfg(riscv32)
fn _fs_exec_active_arch() -> Architecture:
    Architecture.Riscv32

@cfg(arm64)
fn _fs_exec_read_bytes(path: text) -> [u8]:
    arm_fs_exec_read_file_bytes(path)

@cfg(arm32)
fn _fs_exec_read_bytes(path: text) -> [u8]:
    arm_fs_exec_read_file_bytes(path)

@cfg(x86_64)
fn _fs_exec_read_bytes(path: text) -> [u8]:
    g_vfs_read_executable_bytes(path)

@cfg(x86)
fn _fs_exec_read_bytes(path: text) -> [u8]:
    g_vfs_read_executable_bytes(path)

@cfg(riscv64)
fn _fs_exec_read_bytes(path: text) -> [u8]:
    g_vfs_read_executable_bytes(path)

@cfg(riscv32)
fn _fs_exec_read_bytes(path: text) -> [u8]:
    g_vfs_read_executable_bytes(path)

pub struct FsExecPrepareResult:
    scheduler: Scheduler
    pid: i64
    entry: i64

fn _fs_exec_new_bootstrap_scheduler() -> Scheduler:
    """Create the one-CPU scheduler state fs-exec needs without importing the full scheduler hub."""
    # NOTE: module-level `pub val MAX_TASKS`/`PRIORITY_LEVELS` (scheduler_types.spl)
    # read as 0 on baremetal LLVM/cranelift targets — BSS clearing wipes
    # runtime-initialized globals. A 0 bound makes the loops below run zero times,
    # leaving `tasks`/`queues` empty so `tasks[0]` is an OOB garbage read that
    # mis-reports the bootstrap slot as busy. Use function-local literal bounds
    # (mirroring the canonical scheduler_types.spl values) to stay correct on bare metal.
    val local_max_tasks: i32 = 256
    val local_priority_levels: i32 = 5
    var tasks: [TaskControlBlock?] = []
    var i = 0
    while i < local_max_tasks:
        tasks.push(nil)
        i = i + 1
    var queues: [ReadyQueue] = []
    var p = 0
    while p < local_priority_levels:
        queues.push(ReadyQueue.new())
        p = p + 1
    Scheduler(
        tasks: tasks,
        current: TaskId(id: 0),
        current_by_cpu: [TaskId(id: 0)],
        preempt_pending_by_cpu: [nil],
        ready_queues: queues,
        cpu_runqueues: [CpuRunQueue.new(0 as u32)],
        topology: scheduler_flat_topology(1 as u32),
        rt_runtime_ns_by_cpu: [0],
        rt_period_ns_by_cpu: [0],
        rt_consumed_ns_by_cpu: [0],
        rt_replenish_ns_by_cpu: [0],
        rt_throttled_by_cpu: [false],
        deadline_remaining_ns_by_slot: [],
        deadline_period_start_ns_by_slot: [],
        deadline_miss_count_by_slot: [],
        deadline_overrun_count_by_slot: [],
        rt_base_priority_by_slot: [],
        trace_events: [],
        trace_head: 0,
        trace_count: 0,
        tick_count: 0,
        next_task_id: 1,
        executable_adoption_state: SchedulerExecutableAdoptionOwnerStateV1.Idle,
        executable_adoption_pid: 0u64,
        executable_adoption_token_slot: -1,
        executable_adoption_token_generation: 0u64,
        executable_adoption_token_nonce: 0u64,
        green_execution_state: green_carrier_execution_state_new(1),
        green_parallelism_state: green_carrier_parallelism_new(1)
    )

pub fn fs_exec_read_executable_bytes(path: text) -> [u8]:
    """Read executable bytes through the active target's filesystem bridge."""
    _fs_exec_read_bytes(path)

pub(package) fn fs_exec_prepare_spawn_from_bytes(path: text, bytes: [u8], arch: Architecture, argv: [text], envp: [text]) -> FsExecPrepareResult:
    """Legacy byte-only bridge retained as a fail-closed compatibility seam."""
    val data_len = byte_len(bytes)
    serial_println("[fs-exec] spawn:bytes path={path} len={data_len}")
    if data_len <= 4:
        serial_println("[fs-exec] spawn:resolve-fail path={path}")
        return FsExecPrepareResult(scheduler: _fs_exec_new_bootstrap_scheduler(), pid: -2, entry: 0)

    val _arch = arch
    val _argv = argv
    val _envp = envp
    serial_println("[fs-exec] spawn:auth-required path={path}")
    FsExecPrepareResult(
        scheduler: _fs_exec_new_bootstrap_scheduler(), pid: -13, entry: 0)

pub(package) fn fs_exec_prepare_spawn(path: text, argv: [text], envp: [text]) -> FsExecPrepareResult:
    """Resolve bytes for diagnostics, then reject without loader authority."""
    serial_println("[fs-exec] spawn:resolve path={path}")
    val bytes = _fs_exec_read_bytes(path)
    fs_exec_prepare_spawn_from_bytes(path, bytes, _fs_exec_active_arch(), argv, envp)

pub fn fs_exec_spawn(path: text, argv: [text], envp: [text]) -> i64:
    """Reject unauthenticated path-only execution.

    Production filesystem execution must enter through
    `fs_exec_adopt_authenticated_v1`, carrying the loader-owned registry token.
    A pathname and bytes are never sufficient execution authority.
    """
    fs_exec_spawn_as(0, path, argv, envp)

pub fn fs_exec_adopt_authenticated_with_launch_v1(
    scheduler: Scheduler,
    mut table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    token: ExecutableAuthorityTokenV1,
    consumer: ExecutableLoadConsumerV1,
    entry_point: u64,
    caller: i64,
    path: text,
    argv: [text],
    envp: [text],
    recipe: i64
) -> FsExecPrepareResult:
    """Consume one loader-issued authority and publish through Scheduler.

    This bridge cannot issue or reconstruct a token. The loader registry owns
    replay defense, while the returned Scheduler owns the newly published task.
    """
    # Validate and take independent copies before the scheduler can consume the
    # one-shot loader authority or reach path/capability policy. A malformed
    # vector therefore cannot burn a valid token or leave a partially prepared
    # process image behind.
    val launch_result = executable_launch_arguments_v1_validate(path, argv, envp)
    if launch_result.is_err():
        return FsExecPrepareResult(
            scheduler: scheduler,
            pid: executable_launch_arguments_v1_errno(launch_result.unwrap_err()),
            entry: 0)
    val launch = launch_result.unwrap()
    val gate = exec_cap_check(caller, launch.path)
    if gate != 0:
        return FsExecPrepareResult(scheduler: scheduler, pid: gate as i64, entry: 0)
    val allowed = spawn_authority_check_spawn(caller, recipe)
    if allowed != 0:
        return FsExecPrepareResult(scheduler: scheduler, pid: allowed as i64, entry: 0)
    val caps = spawn_authority_spawn_caps(
        caller, recipe, _fs_exec_parent_caps(caller, recipe))
    var owner = scheduler
    val adopted: SchedulerExecutableAdoptionResultV1 =
        owner.adopt_authenticated_executable_pid_with_launch_v1(
            table, authorities, token, consumer, launch, entry_point,
            TaskPriority.Normal, caps)
    if not adopted.receipt.execution_authorized or adopted.pid == 0u64:
        return FsExecPrepareResult(scheduler: owner, pid: -13, entry: 0)
    FsExecPrepareResult(
        scheduler: owner, pid: adopted.pid as i64, entry: entry_point as i64)

pub fn fs_exec_adopt_authenticated_v1(
    scheduler: Scheduler,
    mut table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    token: ExecutableAuthorityTokenV1,
    consumer: ExecutableLoadConsumerV1,
    entry_point: u64,
    caller: i64,
    path: text,
    recipe: i64
) -> FsExecPrepareResult:
    """Compatibility entrypoint with path as argv[0] and an empty environment."""
    fs_exec_adopt_authenticated_with_launch_v1(
        scheduler, table, authorities, token, consumer, entry_point,
        caller, path, [path], [], recipe)

pub fn fs_exec_spawn_ring3(path: text, argv: [text], envp: [text]) -> i64:
    """Reject unauthenticated live handoff through the same canonical gate."""
    fs_exec_spawn(path, argv, envp)

pub fn fs_exec_spawn_as(caller: i64, path: text, argv: [text], envp: [text]) -> i64:
    """Capability-gated spawn: checks FileExec + ProcessSpawn before loading.

    caller == 0 is the kernel-origin sentinel (bypasses capability check).
    Returns the new PID on success, or a negative errno on failure.
    """
    val gate = exec_cap_check(caller, path)
    if gate != 0:
        serial_println("[fs-exec] spawn:denied caller={caller} path={path} err={gate}")
        return gate as i64
    # No token can be derived from a pathname or ambient/root authority. The
    # authenticated loader service must call fs_exec_adopt_authenticated_v1.
    val _argv = argv
    val _envp = envp
    serial_println("[fs-exec] spawn:auth-required caller={caller} path={path}")
    -13

# ============================================================================
# Recipe-gated entry points (master plan §5.4 — migrated userland callers)
# ============================================================================

fn _fs_exec_parent_caps(caller: i64, recipe: i64) -> CapabilitySet:
    """The parent capability set a recipe mint is bounded by.

    The fs-exec bridge builds its own bootstrap scheduler and therefore has no
    handle on the calling task's `TaskControlBlock.capabilities`. Until boot
    installs per-task root grants (see `spawn_recipe_seed_parent_caps`), the
    bound used here is that same seeded grant — i.e. exactly the recipe's own
    declared authority, which is strictly narrower than the `spawn_full()`
    god-mode set this path used before, but does NOT yet enforce a real
    per-caller parent bound.

    TODO(boot-seal): thread the calling task's real `TaskControlBlock.capabilities`
    into `fs_exec_prepare_spawn_from_bytes` so the `parent ∩` term is a genuine
    bound rather than the recipe's own declaration. Must land with the boot-side
    seeder in the arming session; the seal is safe to arm either way (the child is
    attenuated in both cases), but the parent bound is only real afterwards."""
    if not spawn_recipe_is_migrated(recipe):
        return CapabilitySet.full()
    val owner = if caller < 0: 0u64 else: caller.to_u64()
    spawn_recipe_seed_parent_caps(recipe, owner)

pub fn fs_exec_spawn_with_recipe(caller: i64, recipe: i64, path: text, argv: [text], envp: [text]) -> i64:
    """Capability-gated spawn under a named SpawnSpec recipe.

    Same single spawn path as `fs_exec_spawn_as` — the recipe only changes WHICH
    CapabilitySet the child receives. Admitted regardless of the boot seal,
    because a recipe spawn never takes ambient authority."""
    val allowed = spawn_authority_check_spawn(caller, recipe)
    if allowed != 0:
        serial_println("[fs-exec] spawn:seal-denied caller={caller} recipe={recipe} path={path}")
        return allowed as i64
    val gate = exec_cap_check(caller, path)
    if gate != 0:
        serial_println("[fs-exec] spawn:denied caller={caller} path={path} err={gate}")
        return gate as i64
    val _argv = argv
    val _envp = envp
    serial_println(
        "[fs-exec] spawn:auth-required caller={caller} recipe={recipe} path={path}")
    -13

pub fn fs_exec_spawn_ring3_with_recipe(caller: i64, recipe: i64, path: text, argv: [text], envp: [text]) -> i64:
    """Reject unauthenticated recipe handoff through the canonical gate."""
    fs_exec_spawn_with_recipe(caller, recipe, path, argv, envp)
