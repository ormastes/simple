"""x86_64 production policy adapter for filesystem-backed SCR1 ingestion."""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.loader.simplebox_catalog_media_boot_v1.{
    SimpleboxCatalogMediaLayoutV1, SimpleboxCatalogMediaBootPolicyV1,
    SimpleboxCatalogMediaBootResultV1,
    simplebox_catalog_media_boot_ingest_v1,
    simplebox_catalog_media_canonical_layout_v1
}
use x86_64_auth_trust_config.{
    x86_64_authenticated_pinned_key_id_v1,
    x86_64_authenticated_pinned_public_key_hex_v1,
    x86_64_authenticated_pinned_public_key_hash_v1
}

fn x86_64_simplebox_catalog_media_boot_ingest_v1(
    layouts: [SimpleboxCatalogMediaLayoutV1],
) -> SimpleboxCatalogMediaBootResultV1:
    simplebox_catalog_media_boot_ingest_v1(SimpleboxCatalogMediaBootPolicyV1(
        target: ManifestTarget(os: "simpleos", arch: "x86_64", abi: "simpleos"),
        layouts: layouts,
        pinned_key_id: x86_64_authenticated_pinned_key_id_v1(),
        pinned_public_key_hex: x86_64_authenticated_pinned_public_key_hex_v1(),
        pinned_public_key_sha256:
            x86_64_authenticated_pinned_public_key_hash_v1()))

pub fn x86_64_simplebox_catalog_media_boot_ingest_canonical_v1(
) -> SimpleboxCatalogMediaBootResultV1:
    x86_64_simplebox_catalog_media_boot_ingest_v1([
        simplebox_catalog_media_canonical_layout_v1()])
