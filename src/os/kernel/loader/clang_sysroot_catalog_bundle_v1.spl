"""Exact signed boot-catalog bundle for the guest Clang sysroot."""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1
}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootPolicyV1, InstalledArtifactBootRecordV1,
    installed_artifact_boot_policy_shape_valid_v1
}
use os.kernel.loader.clang_sysroot_launch_grants_v1.{
    CLANG_SYSROOT_INCLUDE_MANIFEST_PATH_V1,
    CLANG_SYSROOT_LINKER_SCRIPT_PATH_V1, CLANG_SYSROOT_CRT0_PATH_V1,
    CLANG_SYSROOT_LIBC_PATH_V1, CLANG_SYSROOT_RUNTIME_PATH_V1,
    CLANG_SYSROOT_LIBM_PATH_V1
}

pub const CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1: i64 = 8

pub struct ClangSysrootCatalogBundleV1:
    ok: bool
    reason: text
    policy: InstalledArtifactBootPolicyV1
    records: [InstalledArtifactBootRecordV1]

pub fn clang_sysroot_catalog_required_paths_v1() -> [text]:
    ["/usr/bin/clang", "/usr/bin/ld.lld",
     CLANG_SYSROOT_INCLUDE_MANIFEST_PATH_V1,
     CLANG_SYSROOT_LINKER_SCRIPT_PATH_V1, CLANG_SYSROOT_CRT0_PATH_V1,
     CLANG_SYSROOT_LIBC_PATH_V1, CLANG_SYSROOT_RUNTIME_PATH_V1,
     CLANG_SYSROOT_LIBM_PATH_V1]

fn _fail_v1(target: ManifestTarget, reason: text) -> ClangSysrootCatalogBundleV1:
    ClangSysrootCatalogBundleV1(
        ok: false, reason: reason,
        policy: InstalledArtifactBootPolicyV1(
            platform_target: target, required_canonical_paths: [], trust_roots: []),
        records: [])

pub fn clang_sysroot_catalog_bundle_v1(
    target: ManifestTarget,
    trust_roots: [ExecutableManifestTrustedSignerV1],
    signed_records: [InstalledArtifactBootRecordV1]
) -> ClangSysrootCatalogBundleV1:
    val required = clang_sysroot_catalog_required_paths_v1()
    if signed_records.len() != CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1:
        return _fail_v1(target, "record-count")
    for path in required:
        var matches: i64 = 0
        for record in signed_records:
            if record.canonical_path == path and record.aliases.len() == 0 and
               record.manifest.entrypoint == path and
               record.manifest.target == target:
                matches = matches + 1
        if matches != 1: return _fail_v1(target, "record-identity")
    val policy = InstalledArtifactBootPolicyV1(
        platform_target: target, required_canonical_paths: required,
        trust_roots: trust_roots)
    if not installed_artifact_boot_policy_shape_valid_v1(policy, signed_records):
        return _fail_v1(target, "signed-record-shape")
    ClangSysrootCatalogBundleV1(
        ok: true, reason: "", policy: policy, records: signed_records)
