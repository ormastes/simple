"""Authenticated Simple interpreter/compiler/loader filesystem launch bridge.

The caller must obtain one independent loader-issued authority token for each
executable image.  This module fixes the command shape and retires every token
or scheduler evidence row on a partial launch.  It never resolves PATH names,
opens executable bytes, or manufactures authority from a pathname.
"""

use std.fs_driver.mount_table.{MountTable}
use os.kernel.scheduler.scheduler_types.{Scheduler}
use os.kernel.scheduler.process_execution_observation.{
    SchedulerExecutionEvidenceTokenV1,
    scheduler_execution_evidence_consume_once_v2
}
use os.kernel.loader.authenticated_fs_exec_submission_service_v1.{
    AuthenticatedFsExecSubmissionV1,
    authenticated_fs_exec_submit_v1
}
use os.kernel.loader.executable_admission_pipeline.{executable_loader_revoke}

pub const SIMPLE_TOOLCHAIN_FILESYSTEM_PATH_MAX_V1: i64 = 512

pub(package) struct SimpleToolchainFilesystemLaunchPlanV1:
    source_path: text
    artifact_path: text

pub(package) struct SimpleToolchainFilesystemLaunchEvidenceV1:
    interpreter: SchedulerExecutionEvidenceTokenV1
    compiler: SchedulerExecutionEvidenceTokenV1
    loader: SchedulerExecutionEvidenceTokenV1

fn _canonical_path_v1(path: text) -> bool:
    path.len() > 1 and path.len() <= SIMPLE_TOOLCHAIN_FILESYSTEM_PATH_MAX_V1 and
        path.starts_with("/") and not path.ends_with("/") and
        not path.contains("//") and not path.contains("/./") and
        not path.contains("/../") and not path.ends_with("/.") and
        not path.ends_with("/..") and not path.contains("\\") and
        not path.contains("\0") and not path.contains("\n") and
        not path.contains("\r")

fn _supported_data_path_v1(path: text) -> bool:
    path.starts_with("/fat32/") or path.starts_with("/dbfs/") or
        path.starts_with("/nvfs/")

pub(package) fn simple_toolchain_filesystem_launch_plan_v1(
    source_path: text,
    artifact_path: text
) -> Result<SimpleToolchainFilesystemLaunchPlanV1, text>:
    if not _canonical_path_v1(source_path) or
       not _canonical_path_v1(artifact_path):
        return Err("simple-toolchain-invalid-path")
    if not _supported_data_path_v1(source_path) or
       not _supported_data_path_v1(artifact_path):
        return Err("simple-toolchain-unsupported-filesystem")
    if source_path == artifact_path:
        return Err("simple-toolchain-path-alias")
    Ok(SimpleToolchainFilesystemLaunchPlanV1(
        source_path: source_path, artifact_path: artifact_path))

fn _revoke_unused_v1(
    table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1
) -> bool:
    executable_loader_revoke(
        table, submission.authorities, submission.token).is_ok()

fn _consume_evidence_if_any_v1(
    token: SchedulerExecutionEvidenceTokenV1?
) -> bool:
    if not token.?: return true
    scheduler_execution_evidence_consume_once_v2(token.unwrap()).is_some()

pub(package) fn simple_toolchain_filesystem_launch_authenticated_v1(
    scheduler: Scheduler,
    table: MountTable,
    plan: SimpleToolchainFilesystemLaunchPlanV1,
    interpreter_submission: AuthenticatedFsExecSubmissionV1,
    compiler_submission: AuthenticatedFsExecSubmissionV1,
    loader_submission: AuthenticatedFsExecSubmissionV1
) -> Result<SimpleToolchainFilesystemLaunchEvidenceV1, text>:
    """Launch an exact interpret, compile, then load sequence.

    The returned scheduler tokens remain consume-once authority.  A loader
    evidence owner must consume and bind them to filesystem digests before it
    can publish a successful toolchain receipt.
    """
    val interpreter_path = "/sys/apps/simple_interpreter.smf"
    val compiler_path = "/sys/apps/simple_compiler.smf"
    val loader_path = "/sys/apps/simple_loader.smf"

    val interpreted = authenticated_fs_exec_submit_v1(
        scheduler, table, interpreter_submission,
        interpreter_path, [plan.source_path])
    if interpreted.exit_code != 0 or not interpreted.evidence.?:
        val interpreted_retired = _consume_evidence_if_any_v1(interpreted.evidence)
        val compiler_retired = _revoke_unused_v1(table, compiler_submission)
        val loader_retired = _revoke_unused_v1(table, loader_submission)
        if interpreted.cleanup_indeterminate or not interpreted_retired or
           not compiler_retired or not loader_retired:
            return Err("simple-interpreter-cleanup-indeterminate")
        return Err("simple-interpreter-authenticated-launch-failed")

    val compiled = authenticated_fs_exec_submit_v1(
        scheduler, table, compiler_submission,
        compiler_path, [plan.source_path, "--output", plan.artifact_path])
    if compiled.exit_code != 0 or not compiled.evidence.?:
        val interpreted_retired = _consume_evidence_if_any_v1(interpreted.evidence)
        val compiled_retired = _consume_evidence_if_any_v1(compiled.evidence)
        val loader_retired = _revoke_unused_v1(table, loader_submission)
        if compiled.cleanup_indeterminate or not interpreted_retired or
           not compiled_retired or not loader_retired:
            return Err("simple-compiler-cleanup-indeterminate")
        return Err("simple-compiler-authenticated-launch-failed")

    val loaded = authenticated_fs_exec_submit_v1(
        scheduler, table, loader_submission,
        loader_path, [plan.artifact_path])
    if loaded.exit_code != 0 or not loaded.evidence.?:
        val interpreted_retired = _consume_evidence_if_any_v1(interpreted.evidence)
        val compiled_retired = _consume_evidence_if_any_v1(compiled.evidence)
        val loaded_retired = _consume_evidence_if_any_v1(loaded.evidence)
        if loaded.cleanup_indeterminate or not interpreted_retired or
           not compiled_retired or not loaded_retired:
            return Err("simple-loader-cleanup-indeterminate")
        return Err("simple-loader-authenticated-launch-failed")

    Ok(SimpleToolchainFilesystemLaunchEvidenceV1(
        interpreter: interpreted.evidence.unwrap(),
        compiler: compiled.evidence.unwrap(),
        loader: loaded.evidence.unwrap()))

export SIMPLE_TOOLCHAIN_FILESYSTEM_PATH_MAX_V1
