# Spawn recipes — the least-authority SpawnSpec per legitimate spawn caller.
#
# Master plan §5.4 ("Remove ambient spawn authority") has two halves:
#   1. the guard  — `spawn_authority.spl`, already wired at every ambient site;
#   2. the recipes — THIS module, the thing the guard tells callers to use.
#
# Every userland caller that spawns a process names a recipe here. A recipe is a
# `SpawnSpec` whose grants are exactly the authority that caller needs and no
# more, so arming the boot seal changes NOTHING for a legitimate caller: it was
# already spawning through an attenuated pouch, not through `spawn_full()`.
#
# This is NOT a second spawn path. A recipe only decides WHICH CapabilitySet the
# child receives; the image build, scheduler task creation, and arch handoff stay
# on the one existing path (`fs_exec_prepare_spawn_from_bytes` /
# `create_user_task_pid`).
#
# THE PRECONDITION EVERY CALLER MUST MEET (cspace_spawn.`_find_source`):
#   An ambient `CapabilitySet.full()` parent is `caps: [], is_pledged: false` —
#   ZERO concrete tokens — so it authorizes NOTHING under a SpawnSpec mint and a
#   recipe minted from it comes back deny-all with every grant `rejected`. A
#   migrated caller must therefore hold real, delegable tokens. That is what
#   `spawn_recipe_seed_parent_caps()` builds: the root grant a service task is
#   given at boot, from which its recipe pouches are then derived.
#
# FREESTANDING DISCIPLINE (same rules as spawn_authority.spl / fs_exec_resolve.spl):
#   - No module-level array/[text]/struct initializers — they do NOT run under
#     the freestanding native-build. Every table is built INSIDE a function.
#   - No class construction, no trait-object dispatch on this path.
#   - Recipe ids are plain `i64` scalars so they can be threaded through the
#     shared cross-arch bridge signature without an ABI change.

use os.kernel.types.capability_types.{
    CapabilitySet, CapabilityToken, CapabilityKind,
    CAP_RIGHT_READ, CAP_RIGHT_WRITE, CAP_RIGHT_EXEC
}
use os.kernel.ipc.cspace_spawn.{SpawnSpec, CapGrant, AttenuationSpec}
use os.kernel.loader.server_launch_grants.{
    SIMPLEOS_SERVER_EXECUTABLE_V1, server_launch_grants_v1
}
use std.common.contracts.execution.simpleos_target_v1.{
    SIMPLEOS_TARGET_V1_X86_64_TRIPLE, SIMPLEOS_TARGET_V1_I686_TRIPLE,
    SIMPLEOS_TARGET_V1_AARCH64_TRIPLE, SIMPLEOS_TARGET_V1_ARMV7_TRIPLE,
    SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE,
    SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE
}

# ============================================================================
# Recipe ids
# ============================================================================
#
# 0 is reserved for "no recipe" so an un-set scalar (zeroed .bss under the
# freestanding build) means "ambient path, unchanged" — the fail-safe default.

pub val SPAWN_RECIPE_NONE: i64 = 0
pub val SPAWN_RECIPE_SHELL: i64 = 1
pub val SPAWN_RECIPE_CONSOLE_SHELL: i64 = 2
pub val SPAWN_RECIPE_APP_LAUNCHER: i64 = 3
pub val SPAWN_RECIPE_AUTHENTICATED_SERVER: i64 = 4
pub val SPAWN_RECIPE_CLANG_COMPILE_DBFS: i64 = 5
pub val SPAWN_RECIPE_LLD_LINK_DBFS: i64 = 6
pub val SPAWN_RECIPE_CLANG_HELLO_DBFS: i64 = 7
pub val SPAWN_RECIPE_CLANG_COMPILE_NVFS: i64 = 8
pub val SPAWN_RECIPE_LLD_LINK_NVFS: i64 = 9
pub val SPAWN_RECIPE_CLANG_HELLO_NVFS: i64 = 10
pub val SPAWN_RECIPE_SSH_REMOTE_COMMAND: i64 = 11

pub val SPAWN_RECIPE_FIRST: i64 = 1
pub val SPAWN_RECIPE_LAST: i64 = 11

fn _clang_compile_recipe(recipe: i64) -> bool:
    recipe == SPAWN_RECIPE_CLANG_COMPILE_DBFS or
        recipe == SPAWN_RECIPE_CLANG_COMPILE_NVFS

fn _clang_link_recipe(recipe: i64) -> bool:
    recipe == SPAWN_RECIPE_LLD_LINK_DBFS or
        recipe == SPAWN_RECIPE_LLD_LINK_NVFS

fn _clang_execute_recipe(recipe: i64) -> bool:
    recipe == SPAWN_RECIPE_CLANG_HELLO_DBFS or
        recipe == SPAWN_RECIPE_CLANG_HELLO_NVFS

fn _clang_recipe_root(recipe: i64) -> text:
    if recipe == SPAWN_RECIPE_CLANG_COMPILE_DBFS or
       recipe == SPAWN_RECIPE_LLD_LINK_DBFS or
       recipe == SPAWN_RECIPE_CLANG_HELLO_DBFS:
        return "/dbfs/work"
    if recipe == SPAWN_RECIPE_CLANG_COMPILE_NVFS or
       recipe == SPAWN_RECIPE_LLD_LINK_NVFS or
       recipe == SPAWN_RECIPE_CLANG_HELLO_NVFS:
        return "/nvfs/work"
    ""

pub fn spawn_recipe_is_migrated(recipe: i64) -> bool:
    """True when `recipe` names a migrated caller with a real recipe.

    `SPAWN_RECIPE_NONE` (and anything out of range) is NOT migrated — those
    callers stay on the ambient path and stay subject to the root-only seal."""
    if recipe < SPAWN_RECIPE_FIRST:
        return false
    recipe <= SPAWN_RECIPE_LAST

pub fn spawn_recipe_name(recipe: i64) -> text:
    """Greppable label for audit lines."""
    if recipe == SPAWN_RECIPE_SHELL:
        return "shell"
    if recipe == SPAWN_RECIPE_CONSOLE_SHELL:
        return "console-shell"
    if recipe == SPAWN_RECIPE_APP_LAUNCHER:
        return "app-launcher"
    if recipe == SPAWN_RECIPE_AUTHENTICATED_SERVER:
        return "authenticated-server"
    if recipe == SPAWN_RECIPE_CLANG_COMPILE_DBFS: return "clang-compile-dbfs"
    if recipe == SPAWN_RECIPE_LLD_LINK_DBFS: return "lld-link-dbfs"
    if recipe == SPAWN_RECIPE_CLANG_HELLO_DBFS: return "clang-hello-dbfs"
    if recipe == SPAWN_RECIPE_CLANG_COMPILE_NVFS: return "clang-compile-nvfs"
    if recipe == SPAWN_RECIPE_LLD_LINK_NVFS: return "lld-link-nvfs"
    if recipe == SPAWN_RECIPE_CLANG_HELLO_NVFS: return "clang-hello-nvfs"
    if recipe == SPAWN_RECIPE_SSH_REMOTE_COMMAND: return "ssh-remote-command"
    "none"

# ============================================================================
# Per-recipe authority declaration
# ============================================================================
#
# The path prefix a recipe's child may execute and read under. Deliberately the
# NARROWEST prefix that still covers the caller's real workload — widening one
# of these is the reviewable act that widens the caller's authority.

pub fn spawn_recipe_exec_prefix(recipe: i64) -> text:
    """Executable path prefix this recipe's child is allowed to run from."""
    if recipe == SPAWN_RECIPE_SHELL:
        return "/bin/"
    if recipe == SPAWN_RECIPE_CONSOLE_SHELL:
        return "/bin/"
    if recipe == SPAWN_RECIPE_APP_LAUNCHER:
        return "/sys/apps/"
    if recipe == SPAWN_RECIPE_AUTHENTICATED_SERVER:
        return SIMPLEOS_SERVER_EXECUTABLE_V1
    if _clang_compile_recipe(recipe): return "/usr/bin/clang"
    if _clang_link_recipe(recipe): return "/usr/bin/ld.lld"
    if _clang_execute_recipe(recipe): return _clang_recipe_root(recipe) + "/hello.elf"
    if recipe == SPAWN_RECIPE_SSH_REMOTE_COMMAND: return "/bin/"
    ""

pub fn spawn_recipe_read_prefix(recipe: i64) -> text:
    """Read prefix this recipe's child is allowed. Narrower than exec where the
    caller does not need to read outside its own tree."""
    if recipe == SPAWN_RECIPE_SHELL:
        return "/bin/"
    if recipe == SPAWN_RECIPE_CONSOLE_SHELL:
        return "/bin/"
    if recipe == SPAWN_RECIPE_APP_LAUNCHER:
        return "/sys/apps/"
    if recipe == SPAWN_RECIPE_AUTHENTICATED_SERVER:
        return ""
    if _clang_compile_recipe(recipe): return _clang_recipe_root(recipe) + "/hello.c"
    if _clang_link_recipe(recipe): return _clang_recipe_root(recipe) + "/hello.o"
    if _clang_execute_recipe(recipe): return _clang_recipe_root(recipe) + "/hello.elf"
    if recipe == SPAWN_RECIPE_SSH_REMOTE_COMMAND: return "/bin/"
    ""

pub fn spawn_recipe_rights_mask(recipe: i64) -> u32:
    """The rights-bitmask half of the declaration, for the meet point in
    `spawn_authority.spawn_effective_rights_with_profile`.

    Masking is done with `|` over the CAP_RIGHT_* constants exactly the way
    `capability_types` defines them (plain u32 bit flags). Written as an explicit
    `a | b` expression — never `x |= b` — because the compound-assign form drops
    the operator on the current backends."""
    if not spawn_recipe_is_migrated(recipe):
        return 0u32
    # The Clang compile/link stages additionally need WRITE for their one exact
    # output. No recipe receives ADMIN, MOUNT, MAP, or queue rights.
    if _clang_compile_recipe(recipe) or _clang_link_recipe(recipe):
        return CAP_RIGHT_READ | CAP_RIGHT_WRITE | CAP_RIGHT_EXEC
    CAP_RIGHT_READ | CAP_RIGHT_EXEC

fn _clang_target_valid(triple: text) -> bool:
    triple == SIMPLEOS_TARGET_V1_X86_64_TRIPLE or
        triple == SIMPLEOS_TARGET_V1_I686_TRIPLE or
        triple == SIMPLEOS_TARGET_V1_AARCH64_TRIPLE or
        triple == SIMPLEOS_TARGET_V1_ARMV7_TRIPLE or
        triple == SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE or
        triple == SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE

fn _clang_compile_contract(recipe: i64, path: text, argv: [text]) -> bool:
    val root = _clang_recipe_root(recipe)
    path == "/usr/bin/clang" and argv.len() == 10 and argv[0] == path and
        argv[1] == "-cc1" and argv[2] == "-triple" and
        _clang_target_valid(argv[3]) and argv[4] == "-emit-obj" and
        argv[5] == "-o" and argv[6] == root + "/hello.o" and
        argv[7] == "-x" and argv[8] == "c" and
        argv[9] == root + "/hello.c"

fn _clang_link_contract(recipe: i64, path: text, argv: [text]) -> bool:
    val root = _clang_recipe_root(recipe)
    if path != "/usr/bin/ld.lld" or argv.len() != 23 or argv[0] != path:
        return false
    val emulation = argv[2]
    val emulation_valid = (
        emulation == "elf_x86_64" or emulation == "elf_i386" or
        emulation == "aarch64elf" or emulation == "armelf_linux_eabi" or
        emulation == "elf64lriscv" or emulation == "elf32lriscv")
    emulation_valid and argv[1] == "-m" and argv[3] == "-static" and
        argv[4] == "-no-pie" and argv[5] == "--gc-sections" and
        argv[6] == "--export-dynamic" and argv[7] == "--defsym=__bss_end=_end" and
        argv[8] == "-T" and argv[9] == "/usr/share/simpleos/simpleos.ld" and
        argv[10] == "-e" and argv[11] == "_start" and
        argv[12] == "/usr/lib/crt0.o" and argv[13] == root + "/hello.o" and
        argv[14] == "-L" and argv[15] == "/usr/lib" and
        argv[16] == "--start-group" and argv[17] == "-lsimpleos_c" and
        argv[18] == "-lsimple_runtime" and argv[19] == "-lm" and
        argv[20] == "--end-group" and argv[21] == "-o" and
        argv[22] == root + "/hello.elf"

pub fn spawn_recipe_launch_contract_valid(
    recipe: i64,
    path: text,
    argv: [text],
    envp: [text]
) -> bool:
    """Bind privilege-bearing recipes to their exact launch identity.

    The authenticated-server recipe carries credential-file and listener
    grants that no sibling image may inherit.  Its authority is therefore
    valid only for the canonical server artifact with the canonical argv[0]
    and no ambient environment.  Other recipes retain their existing launch
    shapes; their path authority remains bounded by their FileExec grants.
    """
    if recipe == SPAWN_RECIPE_AUTHENTICATED_SERVER:
        return path == SIMPLEOS_SERVER_EXECUTABLE_V1 and
        argv.len() == 1 and
        argv[0] == SIMPLEOS_SERVER_EXECUTABLE_V1 and
        envp.len() == 0
    if _clang_compile_recipe(recipe):
        # Preparation binds only the immutable executable identity; submission
        # later validates the complete command before consuming authority.
        if argv.len() == 1 and argv[0] == path:
            return envp.len() == 0 and path == "/usr/bin/clang"
        return envp.len() == 0 and _clang_compile_contract(recipe, path, argv)
    if _clang_link_recipe(recipe):
        if argv.len() == 1 and argv[0] == path:
            return envp.len() == 0 and path == "/usr/bin/ld.lld"
        return envp.len() == 0 and _clang_link_contract(recipe, path, argv)
    if _clang_execute_recipe(recipe):
        val executable = _clang_recipe_root(recipe) + "/hello.elf"
        return envp.len() == 0 and path == executable and
            argv.len() == 1 and argv[0] == executable
    if recipe == SPAWN_RECIPE_SSH_REMOTE_COMMAND:
        return envp.len() == 0 and path.starts_with("/bin/") and
            argv.len() > 0 and argv[0] == path
    true

# ============================================================================
# The recipes
# ============================================================================

fn _atten_rights(mask: u32) -> AttenuationSpec:
    """Rights-narrowing attenuation; all four fields written explicitly
    (omitted defaulted struct fields nil-fill to 3 on the JIT).

    EVERY grant in a recipe carries a NON-ZERO mask, including the kinds that
    carry no rights of their own (ProcessSpawn). That is deliberate: per
    `AttenuationSpec`, `rights_mask == 0` means "keep the PARENT's rights", so a
    zero mask makes `spawn_authority.spawn_spec_requested_rights` fold the whole
    parent set back into the request. A non-zero mask keeps the request pinned at
    the recipe's declared rights, which is the property the seal-readiness proof
    asserts."""
    AttenuationSpec(rights_mask: mask, path_prefix: "", depth_limit: -1, single_use: false)

fn _atten_leaf_rights(mask: u32) -> AttenuationSpec:
    """Non-delegable attenuation for one pipeline stage's exact child pouch."""
    AttenuationSpec(
        rights_mask: mask, path_prefix: "", depth_limit: 0, single_use: false)

pub fn spawn_recipe_grants(recipe: i64) -> [CapGrant]:
    """The grant list for `recipe` — exactly the authority the caller needs.

    Built inside the function (no module-level array initializer) so the table
    exists under the freestanding native-build."""
    var grants: [CapGrant] = []
    if not spawn_recipe_is_migrated(recipe):
        return grants
    if recipe == SPAWN_RECIPE_AUTHENTICATED_SERVER:
        return server_launch_grants_v1(SIMPLEOS_SERVER_EXECUTABLE_V1)
    if _clang_compile_recipe(recipe):
        val root = _clang_recipe_root(recipe)
        grants.push(CapGrant(
            label: "clang.exec",
            requested: CapabilityKind.FileExec(path_prefix: "/usr/bin/clang"),
            atten: _atten_leaf_rights(CAP_RIGHT_EXEC)))
        grants.push(CapGrant(
            label: "source.read",
            requested: CapabilityKind.FileRead(path_prefix: root + "/hello.c"),
            atten: _atten_leaf_rights(CAP_RIGHT_READ)))
        grants.push(CapGrant(
            label: "object.write",
            requested: CapabilityKind.FileWrite(path_prefix: root + "/hello.o"),
            atten: _atten_leaf_rights(CAP_RIGHT_WRITE)))
        grants.push(CapGrant(
            label: "object.create",
            requested: CapabilityKind.FileCreate(path_prefix: root + "/hello.o"),
            atten: _atten_leaf_rights(CAP_RIGHT_WRITE)))
        return grants
    if _clang_link_recipe(recipe):
        val root = _clang_recipe_root(recipe)
        grants.push(CapGrant(
            label: "lld.exec",
            requested: CapabilityKind.FileExec(path_prefix: "/usr/bin/ld.lld"),
            atten: _atten_leaf_rights(CAP_RIGHT_EXEC)))
        val read_paths = [
            root + "/hello.o", "/usr/share/simpleos/simpleos.ld",
            "/usr/lib/crt0.o", "/usr/lib/libsimpleos_c.a",
            "/usr/lib/libsimple_runtime.a", "/usr/lib/libm.a"]
        for read_path in read_paths:
            grants.push(CapGrant(
                label: "link.input.read",
                requested: CapabilityKind.FileRead(path_prefix: read_path),
                atten: _atten_leaf_rights(CAP_RIGHT_READ)))
        grants.push(CapGrant(
            label: "hello.write",
            requested: CapabilityKind.FileWrite(path_prefix: root + "/hello.elf"),
            atten: _atten_leaf_rights(CAP_RIGHT_WRITE)))
        grants.push(CapGrant(
            label: "hello.create",
            requested: CapabilityKind.FileCreate(path_prefix: root + "/hello.elf"),
            atten: _atten_leaf_rights(CAP_RIGHT_WRITE)))
        return grants
    if _clang_execute_recipe(recipe):
        val executable = _clang_recipe_root(recipe) + "/hello.elf"
        grants.push(CapGrant(
            label: "hello.exec",
            requested: CapabilityKind.FileExec(path_prefix: executable),
            atten: _atten_leaf_rights(CAP_RIGHT_EXEC)))
        grants.push(CapGrant(
            label: "hello.read",
            requested: CapabilityKind.FileRead(path_prefix: executable),
            atten: _atten_leaf_rights(CAP_RIGHT_READ)))
        return grants
    if recipe == SPAWN_RECIPE_SSH_REMOTE_COMMAND:
        grants.push(CapGrant(
            label: "ssh-remote.exec",
            requested: CapabilityKind.FileExec(path_prefix: "/bin/"),
            atten: _atten_leaf_rights(CAP_RIGHT_EXEC)))
        grants.push(CapGrant(
            label: "ssh-remote.image.read",
            requested: CapabilityKind.FileRead(path_prefix: "/bin/"),
            atten: _atten_leaf_rights(CAP_RIGHT_READ)))
        # Submission already binds the retained canonical image and argv[0].
        # Direct architecture adoption needs no ambient process-creation grant.
        return grants
    val exec_prefix = spawn_recipe_exec_prefix(recipe)
    val read_prefix = spawn_recipe_read_prefix(recipe)
    val mask = spawn_recipe_rights_mask(recipe)
    grants.push(CapGrant(
        label: "fs.exec",
        requested: CapabilityKind.FileExec(path_prefix: exec_prefix),
        atten: _atten_rights(mask)
    ))
    grants.push(CapGrant(
        label: "fs.read",
        requested: CapabilityKind.FileRead(path_prefix: read_prefix),
        atten: _atten_rights(mask)
    ))
    grants.push(CapGrant(
        label: "proc.spawn",
        requested: CapabilityKind.ProcessSpawn,
        atten: _atten_rights(mask)
    ))
    grants

pub fn spawn_recipe_grant_count(recipe: i64) -> i64:
    """How many grants `recipe` declares (0 for an unmigrated recipe)."""
    spawn_recipe_grants(recipe).len()

pub fn spawn_recipe_spec(recipe: i64, image_hash: text) -> SpawnSpec:
    """The SpawnSpec a migrated caller presents instead of ambient authority.

    `image_hash` is the content address of the binary being spawned; two callers
    presenting the same hash with different recipes is the intended
    "same immutable binary, different privilege" property."""
    SpawnSpec(
        image_hash: image_hash,
        grants: spawn_recipe_grants(recipe),
        isolation: spawn_recipe_name(recipe),
        budget: 0u64
    )

# ============================================================================
# Root-grant seeding (the precondition — see the header note on `_find_source`)
# ============================================================================

fn _root_token(kind: CapabilityKind, owner: u64, token_id: u64) -> CapabilityToken:
    """One concrete, delegable root token. Every field explicit.

    `depth: 2` is the documented default delegation budget for a fresh root
    grant (capability_types.CapabilityToken), and `> 0` is what makes the token
    usable as a `_find_source` parent."""
    CapabilityToken(
        kind: kind,
        generation: 1u64,
        owner: owner,
        token_id: token_id,
        parent_token_id: 0u64,
        depth: 2
    )

pub fn spawn_recipe_seed_parent_caps(recipe: i64, owner: u64) -> CapabilitySet:
    """The root grant a service task must hold so its recipe can be minted.

    An ambient `full()` parent authorizes nothing under a SpawnSpec mint (zero
    concrete tokens), so a migrated caller has to be SEEDED with real tokens at
    boot. This builds exactly the tokens `spawn_recipe_grants(recipe)` needs —
    the parent is therefore the tightest set that still admits its own recipe,
    never a god-mode stand-in.

    Returns a PLEDGED set: it can only ever shrink from here."""
    var tokens: [CapabilityToken] = []
    if not spawn_recipe_is_migrated(recipe):
        return CapabilitySet(caps: tokens, is_pledged: true)
    val grants = spawn_recipe_grants(recipe)
    var token_id: u64 = 1u64
    for grant in grants:
        tokens.push(_root_token(grant.requested, owner, token_id))
        token_id = token_id + 1u64
    CapabilitySet(caps: tokens, is_pledged: true)
