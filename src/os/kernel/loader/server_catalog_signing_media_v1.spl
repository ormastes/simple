"""Closed signed-catalog projection for the canonical server executable.

The image-signing owner supplies the canonical SCR1-derived record and its
already pinned trust roots.  This module adds no server-specific wire format or
media path: it only binds that generic record to `/SERVERS.ELF`, one SimpleOS
target, and the signer identity that must authenticate it during population.
"""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.crypto.sha256.{sha256_u8_hex}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1
}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootPolicyV1, InstalledArtifactBootRecordV1,
    installed_artifact_boot_policy_shape_valid_v1
}
use os.kernel.loader.server_launch_grants.{SIMPLEOS_SERVER_EXECUTABLE_V1}

pub enum ServerCatalogSigningMediaErrorV1:
    None
    RecordCountMismatch
    RecordIdentityMismatch
    SignerIdentityMismatch
    SignedRecordShapeInvalid

pub struct ServerCatalogSigningMediaV1:
    ok: bool
    error: ServerCatalogSigningMediaErrorV1
    policy: InstalledArtifactBootPolicyV1
    records: [InstalledArtifactBootRecordV1]

fn _fail_v1(
    target: ManifestTarget,
    error: ServerCatalogSigningMediaErrorV1,
) -> ServerCatalogSigningMediaV1:
    ServerCatalogSigningMediaV1(
        ok: false, error: error,
        policy: InstalledArtifactBootPolicyV1(
            platform_target: target, required_canonical_paths: [], trust_roots: []),
        records: [])

fn _signer_identity_bound_v1(
    record: InstalledArtifactBootRecordV1,
    trust_roots: [ExecutableManifestTrustedSignerV1],
) -> bool:
    val envelope = record.detached_signature.split(":")
    if envelope.len() != 3 or envelope[0] != "ed25519": return false
    var matches: i64 = 0
    for root in trust_roots:
        if root.key_id == envelope[1] and root.public_key.len() == 32 and
            sha256_u8_hex(root.public_key) == record.expected_trust_root_sha256:
            matches = matches + 1
    matches == 1

pub fn server_catalog_signing_media_v1(
    target: ManifestTarget,
    trust_roots: [ExecutableManifestTrustedSignerV1],
    signed_records: [InstalledArtifactBootRecordV1],
) -> ServerCatalogSigningMediaV1:
    """Bind one canonical generic SCR1 record to the server catalog identity."""
    if signed_records.len() != 1:
        return _fail_v1(
            target, ServerCatalogSigningMediaErrorV1.RecordCountMismatch)
    val record = signed_records[0]
    if record.canonical_path != SIMPLEOS_SERVER_EXECUTABLE_V1 or
        record.aliases.len() != 0 or
        record.manifest.entrypoint != SIMPLEOS_SERVER_EXECUTABLE_V1 or
        record.manifest.target != target:
        return _fail_v1(
            target, ServerCatalogSigningMediaErrorV1.RecordIdentityMismatch)
    if not _signer_identity_bound_v1(record, trust_roots):
        return _fail_v1(
            target, ServerCatalogSigningMediaErrorV1.SignerIdentityMismatch)
    val policy = InstalledArtifactBootPolicyV1(
        platform_target: target,
        required_canonical_paths: [SIMPLEOS_SERVER_EXECUTABLE_V1],
        trust_roots: trust_roots)
    if not installed_artifact_boot_policy_shape_valid_v1(policy, signed_records):
        return _fail_v1(
            target, ServerCatalogSigningMediaErrorV1.SignedRecordShapeInvalid)
    ServerCatalogSigningMediaV1(
        ok: true, error: ServerCatalogSigningMediaErrorV1.None,
        policy: policy, records: signed_records)

pub fn server_catalog_signing_media_valid_v1(
    media: ServerCatalogSigningMediaV1,
) -> bool:
    """Rebuild all target, path, signer, and record bindings before composition."""
    if not media.ok or media.error != ServerCatalogSigningMediaErrorV1.None:
        return false
    val rebuilt = server_catalog_signing_media_v1(
        media.policy.platform_target, media.policy.trust_roots, media.records)
    rebuilt.ok and rebuilt.policy == media.policy and rebuilt.records == media.records
