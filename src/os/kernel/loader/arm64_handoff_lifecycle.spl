fn arm64_handoff_nonce(pid: u64, generation: u64, address_space: u64) -> u64:
    (pid * 0x9E3779B185EBCA87) ^ (generation * 0xC2B2AE3D27D4EB4F) ^ address_space ^ 0xA64E10B10C0FFEE

fn arm64_handoff_binding_matches(
    expected_pid: u64, expected_generation: u64, expected_address_space: u64,
    expected_nonce: u64, actual_pid: u64, actual_generation: u64,
    actual_address_space: u64
) -> bool:
    expected_pid == actual_pid and
        expected_generation == actual_generation and
        expected_address_space == actual_address_space and
        expected_nonce == arm64_handoff_nonce(actual_pid, actual_generation, actual_address_space)
