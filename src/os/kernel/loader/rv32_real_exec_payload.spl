"""Pure nonce-bound RV32 ELF builder, simulator, and live admission gate.

The ELF contains actual RV32 instructions: each stdout byte uses ecall 60 and
termination uses ecall 0 with status 37.  Exact mounted bytes may pass payload
admission, but live execution stays blocked until an Sv32 saved-frame user
entry/trap-return owner is installed.
"""

pub val RV32_REAL_EXEC_EXIT_CODE: i64 = 37
pub val RV32_REAL_EXEC_PATH: text = "/SYS/APPS/FSEX32.ELF"

pub struct Rv32RealExecSimulation:
    valid: bool
    stdout: text
    exit_code: i64

pub struct Rv32RealExecAdmission:
    payload_accepted: bool
    live_executable: bool
    status: i64
    reason: text

extern fn rt_string_from_byte_array(arr: [u8]) -> text

fn _rv32_push16(out: [u8], value: u64) -> [u8]:
    out.push((value & 0xff).to_u8())
    out.push(((value >> 8) & 0xff).to_u8())
    out

fn _rv32_push32(out: [u8], value: u64) -> [u8]:
    var bytes = out
    bytes = _rv32_push16(bytes, value)
    bytes = _rv32_push16(bytes, value >> 16)
    bytes

fn _rv32_read16(bytes: [u8], offset: i64) -> u64:
    bytes[offset].to_u64() | (bytes[offset + 1].to_u64() << 8)

fn _rv32_read32(bytes: [u8], offset: i64) -> u64:
    _rv32_read16(bytes, offset) | (_rv32_read16(bytes, offset + 2) << 16)

fn _rv32_addi(rd: u64, imm: u64) -> u64:
    ((imm & 0xfff) << 20) | (rd << 7) | 0x13

fn _rv32_nonce_valid(nonce: text) -> bool:
    if nonce.len() < 16 or nonce.len() > 128:
        return false
    var i = 0
    while i < nonce.len():
        val code = nonce.char_code_at(i)
        if code < 0x21 or code > 0x7e:
            return false
        i = i + 1
    true

pub fn rv32_real_exec_stdout(nonce: text) -> text:
    if not _rv32_nonce_valid(nonce):
        return ""
    "SIMPLEOS_FS_EXEC_OK arch=riscv32 nonce={nonce}\n"

pub fn rv32_real_exec_elf(nonce: text) -> [u8]:
    val message = rv32_real_exec_stdout(nonce)
    if message == "":
        return []
    val code_size = (message.len() * 12 + 12).to_u64()
    var out: [u8] = [0x7f, 0x45, 0x4c, 0x46, 1, 1, 1, 0]
    while out.len() < 16:
        out.push(0)
    out = _rv32_push16(out, 2)
    out = _rv32_push16(out, 243)
    out = _rv32_push32(out, 1)
    out = _rv32_push32(out, 0x400000)
    out = _rv32_push32(out, 52)
    out = _rv32_push32(out, 0)
    out = _rv32_push32(out, 0)
    out = _rv32_push16(out, 52)
    out = _rv32_push16(out, 32)
    out = _rv32_push16(out, 1)
    out = _rv32_push16(out, 0)
    out = _rv32_push16(out, 0)
    out = _rv32_push16(out, 0)
    out = _rv32_push32(out, 1)
    out = _rv32_push32(out, 0x100)
    out = _rv32_push32(out, 0x400000)
    out = _rv32_push32(out, 0x400000)
    out = _rv32_push32(out, code_size)
    out = _rv32_push32(out, code_size)
    out = _rv32_push32(out, 5)
    out = _rv32_push32(out, 0x1000)
    while out.len() < 0x100:
        out.push(0)
    var i = 0
    while i < message.len():
        out = _rv32_push32(out, _rv32_addi(17, 60))
        out = _rv32_push32(out, _rv32_addi(10, message.char_code_at(i).to_u64()))
        out = _rv32_push32(out, 0x00000073)
        i = i + 1
    out = _rv32_push32(out, _rv32_addi(17, 0))
    out = _rv32_push32(out, _rv32_addi(10, RV32_REAL_EXEC_EXIT_CODE.to_u64()))
    _rv32_push32(out, 0x00000073)

pub fn rv32_simulate_real_exec_elf(bytes: [u8]) -> Rv32RealExecSimulation:
    if bytes.len() < 0x10c or bytes[0] != 0x7f or bytes[4] != 1 or
            _rv32_read16(bytes, 16) != 2 or _rv32_read16(bytes, 18) != 243 or
            _rv32_read32(bytes, 20) != 1 or _rv32_read32(bytes, 52) != 1 or
            _rv32_read32(bytes, 56) != 0x100 or _rv32_read32(bytes, 76) != 5 or
            _rv32_read32(bytes, 68) != (bytes.len() - 0x100).to_u64():
        return Rv32RealExecSimulation(valid: false, stdout: "", exit_code: -1)
    var stdout_bytes: [u8] = []
    var offset = 0x100
    while offset + 12 <= bytes.len():
        val set_id = _rv32_read32(bytes, offset)
        val set_arg = _rv32_read32(bytes, offset + 4)
        if _rv32_read32(bytes, offset + 8) != 0x00000073:
            return Rv32RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)
        val syscall_id = (set_id >> 20) & 0xfff
        val arg = (set_arg >> 20) & 0xfff
        if set_id != _rv32_addi(17, syscall_id) or set_arg != _rv32_addi(10, arg):
            return Rv32RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)
        if syscall_id == 60:
            stdout_bytes.push(arg.to_u8())
        elif syscall_id == 0 and offset + 12 == bytes.len():
            return Rv32RealExecSimulation(
                valid: arg.to_i64() == RV32_REAL_EXEC_EXIT_CODE,
                stdout: rt_string_from_byte_array(stdout_bytes), exit_code: arg.to_i64())
        else:
            return Rv32RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)
        offset = offset + 12
    Rv32RealExecSimulation(valid: false, stdout: rt_string_from_byte_array(stdout_bytes), exit_code: -1)

pub fn rv32_admit_mounted_real_exec(bytes: [u8], nonce: text) -> Rv32RealExecAdmission:
    val expected = rv32_real_exec_elf(nonce)
    if expected.len() == 0:
        return Rv32RealExecAdmission(
            payload_accepted: false, live_executable: false,
            status: -22, reason: "rv32-real-exec-invalid-nonce")
    if bytes != expected:
        return Rv32RealExecAdmission(
            payload_accepted: false, live_executable: false,
            status: -13, reason: "rv32-real-exec-mounted-bytes-mismatch")
    val simulated = rv32_simulate_real_exec_elf(bytes)
    if not simulated.valid or simulated.stdout != rv32_real_exec_stdout(nonce) or
            simulated.exit_code != RV32_REAL_EXEC_EXIT_CODE:
        return Rv32RealExecAdmission(
            payload_accepted: false, live_executable: false,
            status: -8, reason: "rv32-real-exec-payload-invalid")
    Rv32RealExecAdmission(
        payload_accepted: true, live_executable: false,
        status: -95, reason: "rv32-sv32-live-entry-not-installed")

export Rv32RealExecSimulation, Rv32RealExecAdmission
export rv32_real_exec_stdout, rv32_real_exec_elf
export rv32_simulate_real_exec_elf, rv32_admit_mounted_real_exec
