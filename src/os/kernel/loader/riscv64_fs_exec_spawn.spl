# RISC-V 64 filesystem-exec scheduler bridge.

use os.kernel.arch.arch_context.{Architecture}
use os.kernel.arch.user_entry_bridge.{dispatch_fs_exec_user_handoff}
use os.kernel.loader.fs_exec_spawn.{fs_exec_prepare_spawn}
use os.kernel.loader.fs_exec_spawn.{fs_exec_adopt_authenticated_with_launch_v1}
use std.fs_driver.mount_table.{MountTable}
use os.kernel.loader.executable_authority_registry.{ExecutableAuthorityRegistryV1, ExecutableAuthorityTokenV1}
use os.kernel.loader.executable_load_plan_v1.{ExecutableLoadConsumerV1}
use os.kernel.scheduler.scheduler_types.{Scheduler}
use os.kernel.scheduler.process_execution_observation.{
    SchedulerExecutionEvidenceTokenV1, scheduler_execution_take_reaped_token_v1,
    scheduler_execution_evidence_consume_once_v1,
    scheduler_execution_observe_reap_v1
}
use std.fs_driver.bytes_util.{text_to_bytes_pure}
use os.kernel.arch.riscv64.process_stdout_capture.{
    Rv64ProcessStdoutResult, rv64_process_stdout_begin,
    rv64_process_stdout_bind_child, rv64_process_stdout_finish
}
use os.kernel.types.task_types.{TaskId}
use os.kernel.scheduler.scheduler.{wait_collect_result_error, wait_collect_result_status}

extern fn serial_println(msg: text)

pub struct Rv64AuthenticatedExecutionResultV1:
    exit_code: i64
    evidence: SchedulerExecutionEvidenceTokenV1?

fn _discard_execution_observation(child_id: u64):
    # Terminal cleanup is idempotent: reap may already have happened, delivery
    # may already have happened, and consume rejects every replay.
    _ = scheduler_execution_observe_reap_v1(child_id)
    val token = scheduler_execution_take_reaped_token_v1(child_id)
    if token.?: _ = scheduler_execution_evidence_consume_once_v1(token.unwrap())

pub fn riscv64_fs_exec_spawn_authenticated_capture_with_launch_v1(
    scheduler: Scheduler,
    table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    token: ExecutableAuthorityTokenV1,
    consumer: ExecutableLoadConsumerV1,
    entry_point: u64,
    caller: i64,
    path: text,
    argv: [text],
    envp: [text],
    recipe: i64
) -> Rv64AuthenticatedExecutionResultV1:
    """Authenticated RV64 adoption, stdout capture, exit, reap, and token handoff."""
    val capture_session = rv64_process_stdout_begin()
    if not capture_session.?:
        return Rv64AuthenticatedExecutionResultV1(exit_code: -10, evidence: nil)
    val prepared = fs_exec_adopt_authenticated_with_launch_v1(
        scheduler, table, authorities, token, consumer, entry_point,
        caller, path, argv, envp, recipe)
    if prepared.pid <= 0:
        val failed_capture = rv64_process_stdout_finish(capture_session.unwrap(), prepared.pid)
        if not failed_capture.?:
            return Rv64AuthenticatedExecutionResultV1(exit_code: -10, evidence: nil)
        return Rv64AuthenticatedExecutionResultV1(
            exit_code: failed_capture.unwrap().exit_code, evidence: nil)
    if not rv64_process_stdout_bind_child(capture_session.unwrap(), prepared.pid.to_u64(), true):
        val failed_child = TaskId(id: prepared.pid.to_u64())
        var failed_owner = prepared.scheduler
        failed_owner.exit_task_by_id(failed_child, -10)
        _ = failed_owner.wait_for_collect(TaskId(id: 0), failed_child, false)
        _discard_execution_observation(failed_child.id)
        val failed_capture = rv64_process_stdout_finish(capture_session.unwrap(), -10)
        if not failed_capture.?:
            return Rv64AuthenticatedExecutionResultV1(exit_code: -10, evidence: nil)
        return Rv64AuthenticatedExecutionResultV1(
            exit_code: failed_capture.unwrap().exit_code, evidence: nil)
    serial_println("RV64_AUTH_EXEC_ADOPTION status=authorized")
    val child = TaskId(id: prepared.pid.to_u64())
    val exit_code = dispatch_fs_exec_user_handoff(Architecture.Riscv64, child.id, prepared.scheduler)
    var owner = prepared.scheduler
    owner.exit_task_by_id(child, exit_code.to_i32())
    val collected = owner.wait_for_collect(TaskId(id: 0), child, false)
    val captured_result = rv64_process_stdout_finish(capture_session.unwrap(), exit_code)
    if not captured_result.?:
        _discard_execution_observation(child.id)
        return Rv64AuthenticatedExecutionResultV1(exit_code: -10, evidence: nil)
    val captured = captured_result.unwrap()
    if wait_collect_result_error(collected) != 0 or
       wait_collect_result_status(collected) != exit_code.to_i32():
        _discard_execution_observation(child.id)
        return Rv64AuthenticatedExecutionResultV1(exit_code: -10, evidence: nil)
    serial_println("RV64_AUTH_EXEC_EXIT code={captured.exit_code}")
    val evidence = scheduler_execution_take_reaped_token_v1(child.id)
    if evidence.?:
        serial_println("RV64_AUTH_EXEC_REAP count=1 token=issued")
    if not evidence.?:
        _discard_execution_observation(child.id)
    Rv64AuthenticatedExecutionResultV1(
        exit_code: captured.exit_code,
        evidence: evidence)

pub fn riscv64_fs_exec_spawn_authenticated_capture_v1(
    scheduler: Scheduler,
    table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    token: ExecutableAuthorityTokenV1,
    consumer: ExecutableLoadConsumerV1,
    entry_point: u64,
    caller: i64,
    path: text,
    recipe: i64
) -> Rv64AuthenticatedExecutionResultV1:
    """Compatibility capture with path as argv[0] and an empty environment."""
    riscv64_fs_exec_spawn_authenticated_capture_with_launch_v1(
        scheduler, table, authorities, token, consumer, entry_point,
        caller, path, [path], [], recipe)

pub fn riscv64_authenticated_execution_acceptance_fixture_with_launch_v1(
    scheduler: Scheduler, table: MountTable,
    authorities: ExecutableAuthorityRegistryV1, token: ExecutableAuthorityTokenV1,
    consumer: ExecutableLoadConsumerV1, entry_point: u64, caller: i64,
    path: text, argv: [text], envp: [text], recipe: i64,
    bundle_nonce: text, expected_image_hash: text
) -> bool:
    """In-guest live fixture; uses only the production adoption and evidence APIs."""
    if bundle_nonce == "" or expected_image_hash == "":
        return false
    val run = riscv64_fs_exec_spawn_authenticated_capture_with_launch_v1(
        scheduler, table, authorities, token, consumer, entry_point,
        caller, path, argv, envp, recipe)
    if run.exit_code != 0 or not run.evidence.?:
        return false
    val evidence_token = run.evidence.unwrap()
    val consumed = scheduler_execution_evidence_consume_once_v1(evidence_token)
    if not consumed.?:
        return false
    val evidence = consumed.unwrap()
    if evidence.image_hash != expected_image_hash or
       evidence.stdout_bytes != text_to_bytes_pure("hello from SimpleOS LLVM\n"):
        return false
    serial_println("RV64_AUTH_EXEC_STDOUT nonce={bundle_nonce} image={evidence.image_hash} value=hello from SimpleOS LLVM")
    serial_println("RV64_AUTH_EXEC_TOKEN_CONSUME nonce={bundle_nonce} image={evidence.image_hash} count=1 status=pass")
    if scheduler_execution_evidence_consume_once_v1(evidence_token).?:
        return false
    serial_println("RV64_AUTH_EXEC_TOKEN_REPLAY nonce={bundle_nonce} image={evidence.image_hash} status=rejected")
    serial_println("RV64_AUTH_EXEC_ACCEPTANCE nonce={bundle_nonce} image={evidence.image_hash} status=pass")
    true

pub fn riscv64_authenticated_execution_acceptance_fixture_v1(
    scheduler: Scheduler, table: MountTable,
    authorities: ExecutableAuthorityRegistryV1, token: ExecutableAuthorityTokenV1,
    consumer: ExecutableLoadConsumerV1, entry_point: u64, caller: i64,
    path: text, recipe: i64, bundle_nonce: text, expected_image_hash: text
) -> bool:
    """Compatibility acceptance fixture with path argv[0] and empty envp."""
    riscv64_authenticated_execution_acceptance_fixture_with_launch_v1(
        scheduler, table, authorities, token, consumer, entry_point, caller,
        path, [path], [], recipe, bundle_nonce, expected_image_hash)

pub fn riscv64_fs_exec_spawn_ring3(path: text, argv: [text], envp: [text]) -> i64:
    """Prepare one filesystem image and block until its RV64 user task exits."""
    riscv64_fs_exec_spawn_capture(path, argv, envp).exit_code

pub fn riscv64_fs_exec_failed_capture(exit_code: i64) -> Rv64ProcessStdoutResult:
    """Reset capture and return an empty result for a pre-launch failure."""
    val session = rv64_process_stdout_begin()
    if not session.?: return Rv64ProcessStdoutResult(bytes: [], exit_code: -10, truncated: false)
    val finished = rv64_process_stdout_finish(session.unwrap(), exit_code)
    if not finished.?: return Rv64ProcessStdoutResult(bytes: [], exit_code: -10, truncated: false)
    finished.unwrap()

pub fn riscv64_fs_exec_spawn_capture(path: text, argv: [text], envp: [text]) -> Rv64ProcessStdoutResult:
    """Run one RV64 filesystem payload and return its bounded stdout and status."""
    val capture_session = rv64_process_stdout_begin()
    if not capture_session.?: return Rv64ProcessStdoutResult(bytes: [], exit_code: -10, truncated: false)
    val prepared = fs_exec_prepare_spawn(path, argv, envp)
    if prepared.pid <= 0:
        val failed = rv64_process_stdout_finish(capture_session.unwrap(), prepared.pid)
        if not failed.?: return Rv64ProcessStdoutResult(bytes: [], exit_code: -10, truncated: false)
        return failed.unwrap()
    # Legacy unauthenticated execution has no scheduler evidence slot. Its
    # local capture remains synchronous; observation binding therefore fails
    # closed without rejecting the execution itself.
    if not rv64_process_stdout_bind_child(capture_session.unwrap(), prepared.pid.to_u64(), false):
        val failed_child = TaskId(id: prepared.pid.to_u64())
        var failed_owner = prepared.scheduler
        failed_owner.exit_task_by_id(failed_child, -10)
        _ = failed_owner.wait_for_collect(TaskId(id: 0), failed_child, false)
        val failed = rv64_process_stdout_finish(capture_session.unwrap(), -10)
        if not failed.?: return Rv64ProcessStdoutResult(bytes: [], exit_code: -10, truncated: false)
        return failed.unwrap()
    serial_println("[fs-exec] spawn:pid={prepared.pid} path={path}")
    val child = TaskId(id: prepared.pid as u64)
    val exit_code = dispatch_fs_exec_user_handoff(Architecture.Riscv64, child.id, prepared.scheduler)
    var scheduler = prepared.scheduler
    scheduler.exit_task_by_id(child, exit_code as i32)
    val collected = scheduler.wait_for_collect(TaskId(id: 0), child, false)
    if wait_collect_result_error(collected) != 0:
        val failed = rv64_process_stdout_finish(capture_session.unwrap(), -10)
        if not failed.?: return Rv64ProcessStdoutResult(bytes: [], exit_code: -10, truncated: false)
        return failed.unwrap()
    if wait_collect_result_status(collected) != exit_code as i32:
        val failed = rv64_process_stdout_finish(capture_session.unwrap(), -10)
        if not failed.?: return Rv64ProcessStdoutResult(bytes: [], exit_code: -10, truncated: false)
        return failed.unwrap()
    val finished = rv64_process_stdout_finish(capture_session.unwrap(), exit_code)
    if not finished.?: return Rv64ProcessStdoutResult(bytes: [], exit_code: -10, truncated: false)
    finished.unwrap()
