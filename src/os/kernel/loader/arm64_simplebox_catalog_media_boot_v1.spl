"""ARM64 production policy adapter for filesystem-backed SCR1 ingestion."""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.loader.simplebox_catalog_media_boot_v1.{
    SimpleboxCatalogMediaLayoutV1, SimpleboxCatalogMediaBootPolicyV1,
    SimpleboxCatalogMediaBootResultV1,
    simplebox_catalog_media_boot_ingest_v1,
    simplebox_catalog_media_canonical_layout_v1
}
use os.kernel.loader.clang_catalog_media_boot_v1.{
    ClangCatalogMediaBootPolicyV1, clang_catalog_media_boot_prepare_v1}
use os.services.vfs.vfs_boot_state.{
    vfs_state_mount_table_owner_handle_v1,
    vfs_state_mount_table_lease_begin_v1,
    vfs_state_mount_table_lease_restore_v1}
use arm64_auth_trust_config.{
    arm64_authenticated_pinned_key_id_v1,
    arm64_authenticated_pinned_public_key_hex_v1,
    arm64_authenticated_pinned_public_key_hash_v1
}

fn arm64_simplebox_catalog_media_boot_ingest_v1(
    layouts: [SimpleboxCatalogMediaLayoutV1],
) -> SimpleboxCatalogMediaBootResultV1:
    simplebox_catalog_media_boot_ingest_v1(SimpleboxCatalogMediaBootPolicyV1(
        target: ManifestTarget(os: "simpleos", arch: "aarch64", abi: "simpleos"),
        layouts: layouts,
        pinned_key_id: arm64_authenticated_pinned_key_id_v1(),
        pinned_public_key_hex: arm64_authenticated_pinned_public_key_hex_v1(),
        pinned_public_key_sha256:
            arm64_authenticated_pinned_public_key_hash_v1()))

pub fn arm64_catalog_media_boot_ingest_canonical_v1() -> bool:
    val owner = vfs_state_mount_table_owner_handle_v1()
    if not owner.?: return false
    val leased = vfs_state_mount_table_lease_begin_v1(owner.unwrap())
    if not leased.?: return false
    val lease = leased.unwrap()
    val clang = clang_catalog_media_boot_prepare_v1(
        lease.table, ClangCatalogMediaBootPolicyV1(
            target: ManifestTarget(os: "simpleos", arch: "aarch64", abi: "simpleos"),
            pinned_key_id: arm64_authenticated_pinned_key_id_v1(),
            pinned_public_key_hex: arm64_authenticated_pinned_public_key_hex_v1(),
            pinned_public_key_sha256: arm64_authenticated_pinned_public_key_hash_v1()))
    val restored = vfs_state_mount_table_lease_restore_v1(lease)
    if not restored or not clang.ok: return false
    simplebox_catalog_media_boot_ingest_v1(SimpleboxCatalogMediaBootPolicyV1(
        target: ManifestTarget(os: "simpleos", arch: "aarch64", abi: "simpleos"),
        layouts: [simplebox_catalog_media_canonical_layout_v1()],
        pinned_key_id: arm64_authenticated_pinned_key_id_v1(),
        pinned_public_key_hex: arm64_authenticated_pinned_public_key_hex_v1(),
        pinned_public_key_sha256: arm64_authenticated_pinned_public_key_hash_v1()),
        Some(clang.bundle)).ok
