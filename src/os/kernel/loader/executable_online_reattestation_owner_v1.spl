"""Loader-private online re-attestation for runtime VFS open identities.

Build media cannot safely pre-sign a sequence of admissions: MountTable mount
coordinates and FileHandle identifiers are allocated by the live booted VFS.
This owner therefore signs only an already-open ExecuteOpenBinding.  The seed
is installed through a package-private boot seam, remains inside this serialized
capsule, and is never returned to userland or to a filesystem driver.

Every successful call consumes one monotonically numbered grant.  At most 128
grants exist for one boot epoch.  The resulting signature binds the exact mount,
mount generation, file handle, content generation, manifest, image digest, and
platform identities.  The admission pipeline must still check that the binding
is current and consume/close it; this module mints no executable authority.
"""

use std.common.contracts.execution.simpleos_executable_v1.{SimpleArtifactManifest}
use std.common.contracts.execution.simpleos_executable_admission_v1.{
    ExecutableAdmissionDecisionV1, ExecutableAdmissionV1,
    executable_admission_validate}
use std.common.crypto.ed25519.{
    pure_ed25519_keypair_from_seed, pure_ed25519_sign, pure_ed25519_verify}
use std.common.crypto.secure_memory.{secure_zero_u8_slots}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.fs_driver.mount_table.{ExecuteOpenBinding}
use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}
use os.kernel.loader.executable_admission_pipeline.{
    ExecutableLoaderCryptographicProofV1}
use os.kernel.loader.executable_crypto_authority.{executable_manifest_hash_v1}
use os.kernel.loader.executable_signing_body.{executable_manifest_signing_body_v1}

pub(package) const EXECUTABLE_ONLINE_REATTESTATION_LIMIT_V1: i64 = 128

pub(package) struct ExecutableOnlineReattestationBootConfigV1:
    key_id: text
    signer_seed: [u8]
    expected_public_key: [u8]
    trust_epoch: u64
    kernel_hash: text
    firmware_profile: text
    compiler_identity: text
    source_identity: text
    config_identity: text

pub(package) struct ExecutableOnlineReattestationV1:
    admission: ExecutableAdmissionV1
    proof: ExecutableLoaderCryptographicProofV1

val _online_reattest_mutex_v1: i64 = mutex_raw_create()
var _online_reattest_initialized_v1 = false
var _online_reattest_quarantined_v1 = false
var _online_reattest_key_id_v1 = ""
var _online_reattest_seed_v1: [u8] = []
var _online_reattest_public_v1: [u8] = []
var _online_reattest_trust_epoch_v1: u64 = 0u64
var _online_reattest_kernel_hash_v1 = ""
var _online_reattest_firmware_v1 = ""
var _online_reattest_compiler_v1 = ""
var _online_reattest_source_v1 = ""
var _online_reattest_config_v1 = ""
var _online_reattest_next_sequence_v1: u64 = 1u64

fn _copy_bytes_v1(source: [u8]) -> [u8]:
    var copied: [u8] = []
    for byte in source: copied.push(byte)
    copied

fn _same_bytes_v1(left: [u8], right: [u8]) -> bool:
    if left.len() != right.len(): return false
    var different: u8 = 0u8
    var index: i64 = 0
    while index < left.len():
        different = different | (left[index] ^ right[index])
        index = index + 1
    different == 0u8

fn _identity_v1(value: text) -> bool:
    val stripped = value.trim()
    stripped != "" and stripped.len() <= 256 and not stripped.contains("\0") and
        not stripped.contains("\n") and not stripped.contains("\r")

fn _digest_v1(value: text) -> bool:
    if value.len() != 64: return false
    for ch in value:
        if not ((ch >= '0' and ch <= '9') or (ch >= 'a' and ch <= 'f')):
            return false
    true

fn _unlock_v1(ok: bool) -> bool:
    if mutex_raw_unlock(_online_reattest_mutex_v1): return ok
    _online_reattest_quarantined_v1 = true
    false

fn _retire_seed_locked_v1() -> bool:
    """Destroy the persistent signing seed while the owner mutex is held."""
    if _online_reattest_seed_v1.len() == 0:
        return true
    val wiped = secure_zero_u8_slots(_online_reattest_seed_v1)
    _online_reattest_seed_v1 = []
    if not wiped.verified():
        _online_reattest_quarantined_v1 = true
        return false
    true

fn _config_valid_v1(config: ExecutableOnlineReattestationBootConfigV1) -> bool:
    config.signer_seed.len() == 32 and config.expected_public_key.len() == 32 and
        config.trust_epoch != 0u64 and _identity_v1(config.key_id) and
        not config.key_id.contains(":") and _digest_v1(config.kernel_hash) and
        _identity_v1(config.firmware_profile) and
        _identity_v1(config.compiler_identity) and
        _identity_v1(config.source_identity) and
        _identity_v1(config.config_identity)

pub(package) fn executable_online_reattestation_owner_initialize_v1(
    config: ExecutableOnlineReattestationBootConfigV1
) -> bool:
    """Install one boot-privileged signer; caller must wipe its input copy."""
    if not _config_valid_v1(config) or _online_reattest_quarantined_v1 or
        _online_reattest_mutex_v1 <= 0:
        return false
    val derived_public = pure_ed25519_keypair_from_seed(config.signer_seed).1
    if not _same_bytes_v1(derived_public, config.expected_public_key):
        return false
    if not mutex_raw_lock(_online_reattest_mutex_v1): return false
    if _online_reattest_initialized_v1:
        # Never compare or reinstall a private key. Boot may call this owner
        # exactly once; repetition is a configuration error, not idempotence.
        return _unlock_v1(false)
    _online_reattest_key_id_v1 = config.key_id
    _online_reattest_seed_v1 = _copy_bytes_v1(config.signer_seed)
    _online_reattest_public_v1 = _copy_bytes_v1(derived_public)
    _online_reattest_trust_epoch_v1 = config.trust_epoch
    _online_reattest_kernel_hash_v1 = config.kernel_hash
    _online_reattest_firmware_v1 = config.firmware_profile
    _online_reattest_compiler_v1 = config.compiler_identity
    _online_reattest_source_v1 = config.source_identity
    _online_reattest_config_v1 = config.config_identity
    _online_reattest_next_sequence_v1 = 1u64
    _online_reattest_initialized_v1 = true
    _unlock_v1(true)

pub(package) fn executable_online_reattest_open_binding_v1(
    binding: ExecuteOpenBinding,
    manifest: SimpleArtifactManifest,
    image_hash: text
) -> Result<ExecutableOnlineReattestationV1, text>:
    """Sign one exact retained binding; never opens or reconstructs a handle."""
    if binding.mount_id.id == 0u32 or binding.file_handle.id == 0u64 or
        binding.mount_generation == 0u64 or binding.content_generation == 0u64 or
        binding.size <= 0 or not _digest_v1(image_hash):
        return Err("open-binding-invalid")
    if _online_reattest_quarantined_v1 or _online_reattest_mutex_v1 <= 0 or
        not mutex_raw_lock(_online_reattest_mutex_v1):
        return Err("serialization-unavailable")
    if not _online_reattest_initialized_v1 or _online_reattest_seed_v1.len() != 32 or
        _online_reattest_public_v1.len() != 32:
        val _ = _unlock_v1(false)
        return Err("signer-unavailable")
    val sequence = _online_reattest_next_sequence_v1
    if sequence == 0u64 or sequence >
        EXECUTABLE_ONLINE_REATTESTATION_LIMIT_V1 as u64:
        # Budget exhaustion is terminal for this boot signer. Do not retain a
        # private root merely so later calls can rediscover the same limit.
        val retired = _retire_seed_locked_v1()
        val _ = _unlock_v1(false)
        if retired:
            return Err("grant-limit")
        return Err("seed-zeroization")
    val admission_id = "online-open-v1-" +
        _online_reattest_trust_epoch_v1.to_text() + "-" + sequence.to_text()
    var admission = ExecutableAdmissionV1(
        schema_version: 1, admission_id: admission_id,
        decision: ExecutableAdmissionDecisionV1.Admitted,
        rejection_reason: "", image_hash: image_hash,
        manifest_hash: "0" * 64,
        kernel_hash: _online_reattest_kernel_hash_v1,
        trust_root_hash: sha256_u8_hex(_online_reattest_public_v1),
        trust_epoch: _online_reattest_trust_epoch_v1,
        target: manifest.target,
        firmware_profile: _online_reattest_firmware_v1,
        compiler_identity: _online_reattest_compiler_v1,
        source_identity: _online_reattest_source_v1,
        config_identity: _online_reattest_config_v1,
        mount_id: binding.mount_id.id as u64,
        mount_generation: binding.mount_generation,
        file_id: binding.file_handle.id,
        file_generation: binding.content_generation,
        effective_capabilities: manifest.required_capabilities)
    admission.manifest_hash = executable_manifest_hash_v1(
        manifest, admission, image_hash)
    if not executable_admission_validate(admission).ok:
        val _ = _unlock_v1(false)
        return Err("admission-invalid")
    val signing_body = executable_manifest_signing_body_v1(
        manifest, admission, image_hash)
    val signature = pure_ed25519_sign(
        _online_reattest_seed_v1, _online_reattest_public_v1,
        signing_body)
    if signature.len() != 64 or not pure_ed25519_verify(
        _online_reattest_public_v1, signing_body, signature):
        _online_reattest_quarantined_v1 = true
        val retired = _retire_seed_locked_v1()
        val _ = _unlock_v1(false)
        if retired:
            return Err("signature-self-check")
        return Err("seed-zeroization")
    # Consume the sequence only after a verified signature exists. The caller
    # may reject later, but this signature is never reissued or reused.
    _online_reattest_next_sequence_v1 = sequence + 1u64
    if sequence == EXECUTABLE_ONLINE_REATTESTATION_LIMIT_V1 as u64 and
        not _retire_seed_locked_v1():
        val _ = _unlock_v1(false)
        return Err("seed-zeroization")
    val proof = ExecutableLoaderCryptographicProofV1(
        signer_key_id: _online_reattest_key_id_v1,
        signature: _copy_bytes_v1(signature))
    if not _unlock_v1(true): return Err("serialization-unavailable")
    Ok(ExecutableOnlineReattestationV1(admission: admission, proof: proof))
