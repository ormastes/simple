# Unified SimpleArtifactManifest — ONE policy surface for ELF / SMF / script /
# native-Simple artifacts (master plan §5.3, with the §12 startup fields
# carried along).
#
# WHY: today the loader decides per-format, ad hoc — `fs_exec_resolve` /
# `fs_exec_spawn` sniff bytes and each format path invents its own answers for
# "which libraries", "which interpreter", "which rights". §5.3 requires a single
# descriptor the whole pipeline can read once:
#
#   path/cap-relative name -> VFS open with EXECUTE right -> immutable
#   executable handle -> VERIFY MANIFEST (this module) -> identify kind ->
#   create process + CSpace -> map segments -> resolve allowed libraries ->
#   W^X transition -> argv/envp/auxv -> enter userspace.
#
# NO SECOND MANIFEST (master plan §4). This is the kernel-side *typed
# projection* of the ALREADY-LANDED launch metadata owned by
# `src/app/startup/launch_metadata.spl` (`LaunchMetadata` + its `.simple_launch.sdn`
# sidecar / SMF section-15 payload / `SIMPLE_LAUNCH_V1` native trailer).
# `manifest_from_launch_metadata` is the one-way adapter: the host-side
# producer and on-disk encoding stay exactly where they are, and this module
# adds only the fields §5.3 requires that `LaunchMetadata` does not yet carry
# (rights ceiling, resource limits, namespace template, argument schema,
# preloads, hashes, signature, debug identity). When those fields need to be
# persisted, they get added to the EXISTING sidecar renderer/parser in
# `launch_metadata.spl` — not to a rival format here.
#
# FREESTANDING DISCIPLINE (identical rules to `fs_exec_resolve.spl`'s header —
# this is ring-0-adjacent loader code):
#   - module-level array / `[text]` initializers do NOT run under the
#     freestanding native build, so every constant list is a FUNCTION and every
#     reason string is a FUNCTION (`manifest_reason_*`), never a module `val`.
#   - no class construction and no trait-object dynamic dispatch on this path
#     (proven to fault-loop ring 0) — plain value structs + free functions only.
#   - `char_at` / `starts_with` are unreliable on DYNAMICALLY built strings on
#     the x64 freestanding path, so kind/target matching uses whole-string `==`
#     against explicitly built components only. No ordering (`<`/`>`) on text.
#   - call depth stays shallow: validation is one flat function over scalars.
#
# Everything here is PURE: the manifest is data. Reading it off a disk /
# descriptor is a later increment (§24.8, descriptor-based exec).

use os.kernel.types.capability_types.{
    CAP_RIGHT_READ, CAP_RIGHT_WRITE, CAP_RIGHT_EXEC, CAP_RIGHT_ADMIN,
    CAP_RIGHT_MOUNT, CAP_RIGHT_QUEUE_SUBMIT, CAP_RIGHT_MAP,
    CAP_RIGHT_DATASET_BUILD, CAP_RIGHT_QUEUE_RECV
}
use os.kernel.loader.spawn_authority.{spawn_effective_rights, spawn_rights_is_subset}
# WP-19: content-hash verification reuses the SAME pure-Simple, baremetal-safe
# SHA-256 the SSH/TLS stack already uses on this kernel path (`os.crypto.sha256`,
# imported the identical bare-name way `ssh_kex_crypto.spl` does — see that
# file's `use os.crypto.sha256.{sha256}`). Deliberately NOT `std.crypto.sha256`:
# that one's `sha256_text` calls `extern fn rt_tls13_sha256`, which is proven to
# return an empty digest under the Cranelift JIT (see
# doc/08_tracking/bug/jit_rt_tls13_sha256_returns_empty_2026-08-05.md) and is not
# the primitive this freestanding-adjacent module's own header discipline (no
# unproven runtime dependencies) allows.
use os.crypto.sha256.{sha256}
use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestTarget as CommonManifestTarget,
    ManifestResourceLimits as CommonManifestResourceLimits,
    ManifestArgument as CommonManifestArgument,
    ManifestPreload as CommonManifestPreload,
    SimpleArtifactManifest as CommonSimpleArtifactManifest
}
use std.common.structural.execution.simple_artifact_manifest_v1_codec.{
    encode_simple_artifact_manifest_v1_signing_bytes
}
use std.common.crypto.ed25519.{pure_ed25519_sign, pure_ed25519_verify}

# Dependency-free value contracts are owned by common. Keep this loader module
# as the compatibility import path while policy and cryptographic operations
# remain here.
export use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestTarget,
    ManifestResourceLimits,
    ManifestArgument,
    ManifestPreload,
    ManifestCheck,
    SimpleArtifactManifest
}

# Same raw-byte-array accessor every other freestanding loader file in this
# directory uses (elf_loader.spl, byte_utils.spl, fs_exec_resolve.spl,
# process_image.spl) instead of `arr[i]` bracket indexing — bracket indexing
# on a dynamically-produced `[u8]` is not proven safe on the x64 freestanding
# path (see this file's own header + those modules' identical `extern fn
# rt_bytes_u8_at` declarations).
@unsafe(reason: "freestanding raw byte-array accessor; caller validates digest extent and returned byte domain", capabilities: [ffi])
extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64

# ============================================================================
# Format version + artifact kinds (function-returning constants)
# ============================================================================

pub fn manifest_format_version() -> i64:
    """The only `format_version` this loader accepts. A manifest from the
    future is REJECTED, never best-effort interpreted (fail closed)."""
    1

pub fn manifest_kind_elf() -> text:
    """ELF64 executable (native host / SimpleOS ring-3 binary)."""
    "elf"

pub fn manifest_kind_smf() -> text:
    """Simple Module Format artifact (bytecode/module graph)."""
    "smf"

pub fn manifest_kind_script() -> text:
    """Interpreted source (.spl/.shs/...). Requires a declared interpreter."""
    "script"

pub fn manifest_kind_native_simple() -> text:
    """Native-Simple artifact carrying a `SIMPLE_LAUNCH_V1` trailer."""
    "native_simple"

pub fn manifest_kind_is_known(kind: text) -> bool:
    """Whole-string equality against the four explicitly built kind names.
    Deliberately NOT a list lookup: module-level `[text]` does not survive the
    freestanding build, and this stays a shallow flat compare."""
    if kind == manifest_kind_elf():
        return true
    if kind == manifest_kind_smf():
        return true
    if kind == manifest_kind_script():
        return true
    if kind == manifest_kind_native_simple():
        return true
    false

# ============================================================================
# Rejection reasons — one distinct reason per failure mode
# ============================================================================

pub fn manifest_reason_ok() -> text:
    """The manifest passed every check."""
    "ok"

pub fn manifest_reason_bad_format_version() -> text:
    """`format_version` is not the version this loader speaks."""
    "unsupported_format_version"

pub fn manifest_reason_unknown_kind() -> text:
    """`artifact_kind` is not one of elf/smf/script/native_simple."""
    "unknown_artifact_kind"

pub fn manifest_reason_empty_entrypoint() -> text:
    """`entrypoint` is empty — nothing to execute."""
    "empty_entrypoint"

pub fn manifest_reason_script_without_interpreter() -> text:
    """A script artifact declared no interpreter. Fail closed: the loader must
    NOT pick a default interpreter for untrusted source."""
    "script_without_interpreter"

pub fn manifest_reason_target_mismatch() -> text:
    """The manifest's target triple is not the running target."""
    "target_triple_mismatch"

pub fn manifest_reason_signature_without_hash() -> text:
    """A signature is present but no content hash covers the bytes it signs —
    an unbound signature proves nothing, so it is rejected."""
    "signature_without_content_hash"

pub fn manifest_reason_no_content_hash_declared() -> text:
    """The manifest declares zero `content_hashes` entries. Fail closed: an
    artifact with no declared hash can never be verified against real bytes,
    so `manifest_verify_content_hash` refuses rather than vacuously passing."""
    "no_content_hash_declared"

pub fn manifest_reason_content_hash_mismatch() -> text:
    """The SHA-256 computed over the artifact's real bytes matches none of the
    manifest's declared `content_hashes`. This is the check that catches a
    tampered or corrupted artifact, so it fails closed."""
    "content_hash_mismatch"

pub fn manifest_reason_missing_signature() -> text:
    """The manifest carries an empty `signature`."""
    "missing_signature"

pub fn manifest_reason_invalid_signature_format() -> text:
    """The `signature` envelope is not a valid `ed25519:<key_id>:<128-hex>` payload."""
    "invalid_signature_format"

pub fn manifest_reason_untrusted_signer() -> text:
    """The signature's `key_id` is absent from registered trust anchors."""
    "untrusted_signer"

pub fn manifest_reason_signature_verification_failed() -> text:
    """Cryptographic Ed25519 verification against the trusted anchor failed."""
    "signature_verification_failed"

pub fn manifest_reason_trust_anchor_missing() -> text:
    """Zero trust anchors are registered — cannot establish signer authority."""
    "no_trust_anchor_registered"

pub fn manifest_reason_invalid_trust_anchor() -> text:
    """Trust-anchor key_id or 32-byte Ed25519 public key is malformed or conflicting."""
    "invalid_trust_anchor"

pub struct ManifestTarget:
    """A target triple. `"any"` in a field is an explicit wildcard; an EMPTY
    field is NOT a wildcard (fail closed — an unset target never matches)."""
    os: text
    arch: text
    abi: text

pub struct ManifestResourceLimits:
    """Hard ceilings the process is created with. `0` means "no manifest
    opinion"; the system policy ceiling still applies on top."""
    max_memory_bytes: i64
    max_open_handles: i64
    max_threads: i64
    cpu_budget_us: i64

pub struct ManifestArgument:
    """One entry of the §12 `argument_schema`. The generated minimal arg parser
    accepts exactly these names — nothing else is parsed."""
    name: text
    value_kind: text
    required: bool
    default_value: text

pub struct ManifestPreload:
    """One entry of the §12 `startup_preloads`. Either `source_arg` (bind to a
    declared argument) or `fixed_path` (a constant path). Only DECLARED
    preloads are ever opened — no directory scanning."""
    source_arg: text
    fixed_path: text
    mode: text
    required: bool
    maximum_bytes: i64
    access: text
    prefault: bool
    hash_policy: text

pub struct ManifestCheck:
    """Plain outcome struct — deliberately NOT a cross-module `Result`, whose
    `Ok`/`Err` constructors do not resolve inside imported method bodies."""
    ok: bool
    reason: text

pub struct SimpleArtifactManifest:
    """The single §5.3 descriptor for every artifact kind."""
    format_version: i64
    artifact_kind: text
    target: ManifestTarget
    entrypoint: text
    required_abi_features: [text]
    required_services: [text]
    required_capabilities: u32
    resource_limits: ManifestResourceLimits
    namespace_template: text
    native_libraries: [text]
    smf_libraries: [text]
    interpreter: text
    argument_schema: [ManifestArgument]
    startup_preloads: [ManifestPreload]
    content_hashes: [text]
    signature: text
    debug_identity: text

# ============================================================================
# Running target
# ============================================================================

pub fn manifest_running_target() -> ManifestTarget:
    """The target this loader is running as. A function-returning constant so
    it survives the freestanding build (a module-level struct `val` would
    not)."""
    ManifestTarget(os: "simpleos", arch: "x86_64", abi: "simpleos")

pub fn manifest_target_matches(want: ManifestTarget, running: ManifestTarget) -> bool:
    """Field-wise whole-string match with an explicit `"any"` wildcard. Empty
    is never a wildcard."""
    if not _manifest_field_matches(want.os, running.os):
        return false
    if not _manifest_field_matches(want.arch, running.arch):
        return false
    _manifest_field_matches(want.abi, running.abi)

fn _manifest_field_matches(want: text, running: text) -> bool:
    if want == "any":
        return true
    want == running

fn _manifest_elf_class_for_target(target: ManifestTarget) -> text:
    """ELF class proven by the target's process-image owner; "" when unknown."""
    if target.arch == "x86" or target.arch == "arm" or target.arch == "riscv32":
        return "elf32"
    if target.arch == "x86_64" or target.arch == "aarch64" or target.arch == "riscv64":
        return "elf64"
    ""

pub fn manifest_elf_abi_features_for_target(target: ManifestTarget) -> [text]:
    """Required ABI features of an ELF manifest for `target`: its ELF class
    plus W^X. Empty for a target with no known ELF class."""
    val elf_class = _manifest_elf_class_for_target(target)
    if elf_class == "":
        return []
    [elf_class, "w_xor_x"]

pub fn manifest_elf_abi_features_match_target(features: [text], target: ManifestTarget) -> bool:
    """True only when `features` is exactly the target's ELF class plus W^X,
    in any order. Unknown targets and missing, duplicate, mixed, or foreign
    entries fail closed."""
    val elf_class = _manifest_elf_class_for_target(target)
    if elf_class == "" or features.len() != 2:
        return false
    var class_count = 0
    var wx_count = 0
    for feature in features:
        if feature == elf_class:
            class_count = class_count + 1
        elif feature == "w_xor_x":
            wx_count = wx_count + 1
        else:
            return false
    class_count == 1 and wx_count == 1

# ============================================================================
# Per-kind skeletons
# ============================================================================

fn _manifest_default_limits() -> ManifestResourceLimits:
    ManifestResourceLimits(
        max_memory_bytes: 0,
        max_open_handles: 0,
        max_threads: 0,
        cpu_budget_us: 0
    )

pub fn manifest_kind_base_rights(kind: text) -> u32:
    """Rights every artifact of this kind needs just to start.

    A SCRIPT gets no EXEC: the interpreter image is what executes, the script
    bytes are only read and mapped."""
    if kind == manifest_kind_script():
        return CAP_RIGHT_READ | CAP_RIGHT_MAP
    if manifest_kind_is_known(kind):
        return CAP_RIGHT_READ | CAP_RIGHT_EXEC | CAP_RIGHT_MAP
    0u32

pub fn manifest_kind_allowed_rights(kind: text) -> u32:
    """The absolute maximum a manifest of this kind may ever request.

    CAP_RIGHT_ADMIN is absent from EVERY kind: a manifest can never request
    admin authority — that has to come from the parent/system side, not from a
    file on disk. A script additionally can never request EXEC or MOUNT. An
    unknown kind is allowed nothing."""
    if kind == manifest_kind_script():
        return CAP_RIGHT_READ | CAP_RIGHT_WRITE | CAP_RIGHT_MAP |
            CAP_RIGHT_QUEUE_SUBMIT | CAP_RIGHT_QUEUE_RECV
    if manifest_kind_is_known(kind):
        return CAP_RIGHT_READ | CAP_RIGHT_WRITE | CAP_RIGHT_EXEC | CAP_RIGHT_MAP |
            CAP_RIGHT_MOUNT | CAP_RIGHT_QUEUE_SUBMIT | CAP_RIGHT_QUEUE_RECV |
            CAP_RIGHT_DATASET_BUILD
    0u32

pub fn manifest_for_kind(kind: text) -> SimpleArtifactManifest:
    """A typed skeleton for `kind`, carrying that kind's defaults.

    The skeleton is DELIBERATELY not yet valid: `entrypoint` is empty and a
    script's `interpreter` is empty, so `manifest_validate` rejects a skeleton
    that was never bound to a real artifact (fail closed — an unfinished
    descriptor must never execute)."""
    SimpleArtifactManifest(
        format_version: manifest_format_version(),
        artifact_kind: kind,
        target: manifest_running_target(),
        entrypoint: "",
        required_abi_features: _manifest_kind_abi_features(kind),
        required_services: [],
        required_capabilities: manifest_kind_base_rights(kind),
        resource_limits: _manifest_default_limits(),
        namespace_template: _manifest_kind_namespace(kind),
        native_libraries: [],
        smf_libraries: [],
        interpreter: "",
        argument_schema: [],
        startup_preloads: [],
        content_hashes: [],
        signature: "",
        debug_identity: ""
    )

fn _manifest_kind_abi_features(kind: text) -> [text]:
    if kind == manifest_kind_elf():
        return ["elf64", "w_xor_x"]
    if kind == manifest_kind_smf():
        return ["smf1", "module_graph"]
    if kind == manifest_kind_script():
        return ["script_host"]
    if kind == manifest_kind_native_simple():
        return ["simple_rt", "launch_meta_v1"]
    []

fn _manifest_kind_namespace(kind: text) -> text:
    if manifest_kind_is_known(kind):
        return "app_default"
    ""

# ============================================================================
# Pure builders (the manifest is immutable data — never mutate through
# two struct-field hops; always rebuild and return)
# ============================================================================

pub fn manifest_with_entrypoint(m: SimpleArtifactManifest, entrypoint: text) -> SimpleArtifactManifest:
    """Bind the skeleton to a concrete entrypoint."""
    var out = m
    out.entrypoint = entrypoint
    out

pub fn manifest_with_interpreter(m: SimpleArtifactManifest, interpreter: text) -> SimpleArtifactManifest:
    """Declare the interpreter a script artifact must be run under."""
    var out = m
    out.interpreter = interpreter
    out

pub fn manifest_with_target(m: SimpleArtifactManifest, target: ManifestTarget) -> SimpleArtifactManifest:
    """Override the target triple (cross-target descriptors, test fixtures)."""
    var out = m
    out.target = target
    out

pub fn manifest_with_signature(
    m: SimpleArtifactManifest,
    signature: text,
    content_hashes: [text]
) -> SimpleArtifactManifest:
    """Attach a signature together with the hashes it binds. Passing an empty
    hash list is what `manifest_reason_signature_without_hash` catches."""
    var out = m
    out.signature = signature
    out.content_hashes = content_hashes
    out

pub fn manifest_with_libraries(
    m: SimpleArtifactManifest,
    native_libraries: [text],
    smf_libraries: [text]
) -> SimpleArtifactManifest:
    """Declare the allowed library set (the loader resolves NOTHING else)."""
    var out = m
    out.native_libraries = native_libraries
    out.smf_libraries = smf_libraries
    out

pub fn manifest_with_startup(
    m: SimpleArtifactManifest,
    argument_schema: [ManifestArgument],
    startup_preloads: [ManifestPreload]
) -> SimpleArtifactManifest:
    """Attach the §12 startup contract: the arg names the generated parser
    accepts and the preloads `_start` may open before `main()`."""
    var out = m
    out.argument_schema = argument_schema
    out.startup_preloads = startup_preloads
    out

pub fn manifest_with_requested_rights(m: SimpleArtifactManifest, rights: u32) -> SimpleArtifactManifest:
    """Set the raw requested rights. The request is still clamped by
    `manifest_kind_allowed_rights` in `manifest_required_rights`."""
    var out = m
    out.required_capabilities = rights
    out

# ============================================================================
# Validation — fail closed, one distinct reason per failure
# ============================================================================

pub fn manifest_validate_for_target(
    m: SimpleArtifactManifest,
    running: ManifestTarget
) -> ManifestCheck:
    """Fail-closed validation against an explicit running target.

    Checks are ordered so each rejection reports its OWN reason rather than
    being masked by a later one."""
    if m.format_version != manifest_format_version():
        return ManifestCheck(ok: false, reason: manifest_reason_bad_format_version())
    if not manifest_kind_is_known(m.artifact_kind):
        return ManifestCheck(ok: false, reason: manifest_reason_unknown_kind())
    if m.entrypoint == "":
        return ManifestCheck(ok: false, reason: manifest_reason_empty_entrypoint())
    if m.artifact_kind == manifest_kind_script() and m.interpreter == "":
        return ManifestCheck(ok: false, reason: manifest_reason_script_without_interpreter())
    if not manifest_target_matches(m.target, running):
        return ManifestCheck(ok: false, reason: manifest_reason_target_mismatch())
    if m.signature != "" and m.content_hashes.len() == 0:
        return ManifestCheck(ok: false, reason: manifest_reason_signature_without_hash())
    ManifestCheck(ok: true, reason: manifest_reason_ok())

pub fn manifest_validate(m: SimpleArtifactManifest) -> ManifestCheck:
    """Fail-closed validation against the running target."""
    manifest_validate_for_target(m, manifest_running_target())

# ============================================================================
# Real content-hash verification (WP-19) — the manifest's `content_hashes`
# checked against the ACTUAL bytes of the artifact it describes, not just
# presence-checked. Fail closed on every axis: no bytes, no declared hash, and
# a mismatch are all rejections; only an exact hex-digest match passes.
# ============================================================================

fn _manifest_hex_digit(nibble: i64) -> text:
    val hex_digits = "0123456789abcdef"
    hex_digits.substring(nibble, nibble + 1)

pub fn manifest_sha256_hex(bytes: [u8]) -> text:
    """Hex-encoded SHA-256 digest of `bytes`, using the pure-Simple,
    baremetal-safe `os.crypto.sha256.sha256` this kernel path already trusts
    for SSH/TLS. One byte -> two hex chars, most-significant nibble first
    (matches `std.common.crypto.sha256.sha256_text`'s encoding so a hash
    computed host-side and one computed here are directly comparable)."""
    val digest = sha256(bytes)
    if digest.len() != 32:
        panic("manifest SHA-256 provider returned an invalid digest length")
    var pairs: [text] = []
    var i: i64 = 0
    val n = digest.len() as i64
    while i < n:
        val v = unsafe(capabilities: [ffi]):
            rt_bytes_u8_at(digest, i)
        if v < 0 or v > 255:
            panic("manifest SHA-256 byte accessor returned an invalid value")
        pairs.push(_manifest_hex_digit((v >> 4) & 15) + _manifest_hex_digit(v & 15))
        i = i + 1
    pairs.join("")

fn _manifest_hash_list_contains(hashes: [text], want: text) -> bool:
    var i: u64 = 0u64
    while i < hashes.len():
        if hashes[i] == want:
            return true
        i = i + 1u64
    false

pub fn manifest_verify_content_hash(m: SimpleArtifactManifest, actual_bytes: [u8]) -> ManifestCheck:
    """The real production check: compute SHA-256 over `actual_bytes` (the
    bytes read for THIS artifact off disk) and require it to match one of the
    manifest's declared `content_hashes`.

    Fail closed:
      - zero declared hashes -> reject (`manifest_reason_no_content_hash_declared`),
        never treated as "no opinion, pass".
      - computed digest present but absent from `content_hashes` -> reject
        (`manifest_reason_content_hash_mismatch`) — this is what catches a
        tampered or corrupted artifact.
      - computed digest matches an entry -> `manifest_reason_ok()`.
    """
    if m.content_hashes.len() == 0:
        return ManifestCheck(ok: false, reason: manifest_reason_no_content_hash_declared())
    val actual_hex = manifest_sha256_hex(actual_bytes)
    if not _manifest_hash_list_contains(m.content_hashes, actual_hex):
        return ManifestCheck(ok: false, reason: manifest_reason_content_hash_mismatch())
    ManifestCheck(ok: true, reason: manifest_reason_ok())

# ============================================================================
# Rights — the executable policy ceiling and the §5.4 intersection
# ============================================================================

pub fn manifest_required_rights(m: SimpleArtifactManifest) -> u32:
    """The `executable_policy_ceiling` this artifact may request.

    = (declared request | kind base rights | rights implied by declared
      libraries/preloads) CLAMPED BY `manifest_kind_allowed_rights`.

    The final clamp is what makes this a ceiling and not an amplifier: no
    combination of declared fields can produce a bit the kind does not allow
    (notably CAP_RIGHT_ADMIN, which no kind allows)."""
    var rights: u32 = m.required_capabilities | manifest_kind_base_rights(m.artifact_kind)
    if m.native_libraries.len() > 0 or m.smf_libraries.len() > 0:
        rights = rights | CAP_RIGHT_MAP
    if m.startup_preloads.len() > 0:
        rights = rights | CAP_RIGHT_READ | CAP_RIGHT_MAP
    rights & manifest_kind_allowed_rights(m.artifact_kind)

pub fn manifest_effective_rights(
    m: SimpleArtifactManifest,
    parent_delegable: u32,
    system_ceiling: u32
) -> u32:
    """`effective = parent_delegable & executable_ceiling & system_ceiling &
    manifest_request` (master plan §5.4).

    Composed from the LANDED `spawn_authority.spawn_effective_rights` rather
    than re-derived, so both call sites share one intersection implementation.
    The executable ceiling and the manifest request are both
    `manifest_required_rights(m)` — the clamped request IS the ceiling here.
    Explicit denials are 0 at this layer: denials are a spawn-site input
    (`SpawnSpec`), not a property of the artifact."""
    val ceiling = manifest_required_rights(m)
    spawn_effective_rights(parent_delegable, ceiling, system_ceiling, ceiling, 0u32)

pub fn manifest_rights_within_ceilings(
    m: SimpleArtifactManifest,
    parent_delegable: u32,
    system_ceiling: u32
) -> bool:
    """Self-check: the computed effective rights are a subset of the artifact
    ceiling, the parent's delegable rights, AND the system ceiling. Reuses
    `spawn_authority.spawn_rights_is_subset` so "subset" means one thing
    everywhere."""
    val eff = manifest_effective_rights(m, parent_delegable, system_ceiling)
    if not spawn_rights_is_subset(eff, manifest_required_rights(m)):
        return false
    if not spawn_rights_is_subset(eff, parent_delegable):
        return false
    spawn_rights_is_subset(eff, system_ceiling)

# ============================================================================
# Adapter from the EXISTING launch metadata (no second manifest — §4)
# ============================================================================

pub fn manifest_kind_from_launch_entry_kind(entry_kind: text) -> text:
    """Map `launch_metadata.startup_detect_launch_kind`'s vocabulary
    (`native` / `smf` / `script`) onto §5.3 artifact kinds. `native` becomes
    `native_simple` because that is what the host producer emits (a
    `SIMPLE_LAUNCH_V1` trailer); a plain foreign ELF is classified `elf` by the
    byte sniffer instead."""
    if entry_kind == "smf":
        return manifest_kind_smf()
    if entry_kind == "script":
        return manifest_kind_script()
    if entry_kind == "native":
        return manifest_kind_native_simple()
    if manifest_kind_is_known(entry_kind):
        return entry_kind
    ""

pub fn manifest_from_launch_metadata(
    entry_kind: text,
    target_os: text,
    target_arch: text,
    target_abi: text,
    entrypoint: text,
    native_libraries: [text],
    smf_libraries: [text]
) -> SimpleArtifactManifest:
    """Project an already-parsed `LaunchMetadata` (from
    `src/app/startup/launch_metadata.spl` — its sidecar, its SMF section-15
    payload, or its `SIMPLE_LAUNCH_V1` native trailer) into the unified
    manifest.

    Taken as loose fields rather than the `LaunchMetadata` struct so the
    kernel loader does not import the host-side startup module (and so this
    stays freestanding-safe). The FIELD NAMES are deliberately identical: this
    is a projection of the existing descriptor, not a rival one."""
    val kind = manifest_kind_from_launch_entry_kind(entry_kind)
    val skeleton = manifest_for_kind(kind)
    val targeted = manifest_with_target(
        skeleton,
        ManifestTarget(os: target_os, arch: target_arch, abi: target_abi)
    )
    manifest_with_libraries(
        manifest_with_entrypoint(targeted, entrypoint),
        native_libraries,
        smf_libraries
    )

pub fn manifest_summary(m: SimpleArtifactManifest) -> text:
    """Single-line, greppable identity for serial logs and spawn traces.
    Mirrors `launch_metadata.startup_feature_summary`'s shape."""
    "kind=" + m.artifact_kind +
        "|os=" + m.target.os +
        "|arch=" + m.target.arch +
        "|abi=" + m.target.abi +
        "|entry=" + m.entrypoint +
        "|interp=" + m.interpreter +
        "|ns=" + m.namespace_template

# ============================================================================
# Ed25519 trust-anchor registry and cryptographic manifest verification (#18)
# ============================================================================

pub struct ManifestTrustAnchor:
    """Pinned Ed25519 signing authority registered for manifest verification."""
    key_id: text
    public_key: [u8]

struct _ParsedSignatureEnvelope:
    ok: bool
    key_id: text
    signature: [u8]

var _manifest_trust_anchor_keys: [text] = []
var _manifest_trust_anchor_pks: [[u8]] = []
var _manifest_trust_anchor_count_scalar: i64 = 0

fn _manifest_valid_key_id(key_id: text) -> bool:
    if key_id.len() == 0 or key_id.len() > 128:
        return false
    var i: i64 = 0
    while i < key_id.len():
        val ch = key_id.char_code_at(i)
        if ch < 33 or ch > 126 or ch == 58:
            return false
        i = i + 1
    true

fn _manifest_copy_u8_array(src: [u8]) -> [u8]:
    var dst: [u8] = []
    for b in src:
        dst.push(b)
    dst

fn _manifest_bytes_equal(a: [u8], b: [u8]) -> bool:
    if a.len() != b.len():
        return false
    var i: u64 = 0u64
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1u64
    true

fn _manifest_bytes_to_hex(bytes: [u8]) -> text:
    var parts: [text] = []
    var i: u64 = 0u64
    while i < bytes.len():
        val v = bytes[i].to_i64() & 0xFF
        parts.push(_manifest_hex_digit((v >> 4) & 15) + _manifest_hex_digit(v & 15))
        i = i + 1u64
    parts.join("")

fn _manifest_hex_nibble(ch: text) -> i64:
    val code = ch.char_code_at(0)
    if code >= 48 and code <= 57:
        return code - 48
    if code >= 97 and code <= 102:
        return code - 87
    if code >= 65 and code <= 70:
        return code - 55
    -1

fn _manifest_hex_to_bytes(hex_str: text, expected_bytes: i64) -> [u8]:
    if hex_str.len() != expected_bytes * 2:
        return []
    var out: [u8] = []
    var i: i64 = 0
    while i < hex_str.len():
        val hi = _manifest_hex_nibble(hex_str.substring(i, i + 1))
        val lo = _manifest_hex_nibble(hex_str.substring(i + 1, i + 2))
        if hi < 0 or lo < 0:
            return []
        out.push(((hi << 4) | lo).to_u8())
        i = i + 2
    out

fn _manifest_parse_signature_envelope(signature: text) -> _ParsedSignatureEnvelope:
    val parts = signature.split(":")
    if parts.len() != 3 or parts[0] != "ed25519":
        return _ParsedSignatureEnvelope(ok: false, key_id: "", signature: [])
    val key_id = parts[1]
    if not _manifest_valid_key_id(key_id):
        return _ParsedSignatureEnvelope(ok: false, key_id: "", signature: [])
    val sig_bytes = _manifest_hex_to_bytes(parts[2], 64)
    if sig_bytes.len() != 64:
        return _ParsedSignatureEnvelope(ok: false, key_id: "", signature: [])
    _ParsedSignatureEnvelope(ok: true, key_id: key_id, signature: sig_bytes)

fn _manifest_to_common_v1(m: SimpleArtifactManifest) -> CommonSimpleArtifactManifest:
    var args_out: [CommonManifestArgument] = []
    for arg in m.argument_schema:
        args_out.push(CommonManifestArgument(
            name: arg.name,
            value_kind: arg.value_kind,
            required: arg.required,
            default_value: arg.default_value
        ))
    var preloads_out: [CommonManifestPreload] = []
    for pre in m.startup_preloads:
        preloads_out.push(CommonManifestPreload(
            source_arg: pre.source_arg,
            fixed_path: pre.fixed_path,
            mode: pre.mode,
            required: pre.required,
            maximum_bytes: pre.maximum_bytes,
            access: pre.access,
            prefault: pre.prefault,
            hash_policy: pre.hash_policy
        ))
    CommonSimpleArtifactManifest(
        format_version: m.format_version,
        artifact_kind: m.artifact_kind,
        target: CommonManifestTarget(os: m.target.os, arch: m.target.arch, abi: m.target.abi),
        entrypoint: m.entrypoint,
        required_abi_features: m.required_abi_features,
        required_services: m.required_services,
        required_capabilities: m.required_capabilities,
        resource_limits: CommonManifestResourceLimits(
            max_memory_bytes: m.resource_limits.max_memory_bytes,
            max_open_handles: m.resource_limits.max_open_handles,
            max_threads: m.resource_limits.max_threads,
            cpu_budget_us: m.resource_limits.cpu_budget_us
        ),
        namespace_template: m.namespace_template,
        native_libraries: m.native_libraries,
        smf_libraries: m.smf_libraries,
        interpreter: m.interpreter,
        argument_schema: args_out,
        startup_preloads: preloads_out,
        content_hashes: m.content_hashes,
        signature: m.signature,
        debug_identity: m.debug_identity
    )

pub fn manifest_trust_anchors_clear():
    """Remove all registered trust anchors (for key reset or test isolation)."""
    _manifest_trust_anchor_keys = []
    _manifest_trust_anchor_pks = []
    _manifest_trust_anchor_count_scalar = 0

@allow(primitive_api)  # reason: count scalar matches existing SimpleArtifactManifest API conventions
pub fn manifest_trust_anchor_count() -> i64:
    """Return number of registered Ed25519 trust anchors."""
    _manifest_trust_anchor_count_scalar

pub fn manifest_trust_anchor_register(key_id: text, public_key: [u8]) -> ManifestCheck:
    """Pin an Ed25519 trust-anchor public key under `key_id`."""
    if not _manifest_valid_key_id(key_id) or public_key.len() != 32:
        return ManifestCheck(ok: false, reason: manifest_reason_invalid_trust_anchor())
    if _manifest_trust_anchor_count_scalar == 0:
        _manifest_trust_anchor_keys = []
        _manifest_trust_anchor_pks = []
    var i: i64 = 0
    while i < _manifest_trust_anchor_count_scalar:
        if _manifest_trust_anchor_keys[i] == key_id:
            if _manifest_bytes_equal(_manifest_trust_anchor_pks[i], public_key):
                return ManifestCheck(ok: true, reason: manifest_reason_ok())
            return ManifestCheck(ok: false, reason: manifest_reason_invalid_trust_anchor())
        i = i + 1
    _manifest_trust_anchor_keys.push(key_id)
    _manifest_trust_anchor_pks.push(_manifest_copy_u8_array(public_key))
    _manifest_trust_anchor_count_scalar = _manifest_trust_anchor_count_scalar + 1
    ManifestCheck(ok: true, reason: manifest_reason_ok())

@allow(primitive_api)  # reason: boolean revocation outcome matches existing manifest_* predicate API
pub fn manifest_trust_anchor_revoke(key_id: text) -> bool:
    """Remove a registered trust anchor by `key_id`; returns true when found."""
    if _manifest_trust_anchor_count_scalar == 0:
        return false
    var next_keys: [text] = []
    var next_pks: [[u8]] = []
    var removed = false
    var i: i64 = 0
    while i < _manifest_trust_anchor_count_scalar:
        if _manifest_trust_anchor_keys[i] == key_id:
            removed = true
        else:
            next_keys.push(_manifest_trust_anchor_keys[i])
            next_pks.push(_manifest_trust_anchor_pks[i])
        i = i + 1
    _manifest_trust_anchor_keys = next_keys
    _manifest_trust_anchor_pks = next_pks
    _manifest_trust_anchor_count_scalar = next_keys.len() as i64
    removed

fn _manifest_registered_anchors() -> [ManifestTrustAnchor]:
    var out: [ManifestTrustAnchor] = []
    var i: i64 = 0
    while i < _manifest_trust_anchor_count_scalar:
        out.push(ManifestTrustAnchor(
            key_id: _manifest_trust_anchor_keys[i],
            public_key: _manifest_copy_u8_array(_manifest_trust_anchor_pks[i])
        ))
        i = i + 1
    out

fn _manifest_find_anchor(anchors: [ManifestTrustAnchor], key_id: text) -> i64:
    var i: i64 = 0
    val n = anchors.len() as i64
    while i < n:
        if anchors[i].key_id == key_id:
            return i
        i = i + 1
    -1

pub fn manifest_sign_ed25519(
    m: SimpleArtifactManifest,
    key_id: text,
    private_seed: [u8],
    public_key: [u8],
    image_hash: text
) -> SimpleArtifactManifest:
    """Sign canonical SAM1 manifest bytes over `image_hash` with Ed25519."""
    if not _manifest_valid_key_id(key_id) or private_seed.len() != 32 or public_key.len() != 32:
        return m
    val resolved_hash = if image_hash != "": image_hash else:
        if m.content_hashes.len() > 0: m.content_hashes[0] else: ""
    if resolved_hash == "":
        return m
    var hashes = m.content_hashes
    if not _manifest_hash_list_contains(hashes, resolved_hash):
        hashes = [resolved_hash]
    val normalized_manifest = manifest_with_signature(m, "", hashes)
    val signing = encode_simple_artifact_manifest_v1_signing_bytes(_manifest_to_common_v1(normalized_manifest), resolved_hash)
    if not signing.ok:
        return m
    val sig_bytes = pure_ed25519_sign(private_seed, public_key, signing.bytes)
    if sig_bytes.len() != 64:
        return m
    manifest_with_signature(normalized_manifest, "ed25519:" + key_id + ":" + _manifest_bytes_to_hex(sig_bytes), hashes)

pub fn manifest_verify_signature_with_anchors(
    m: SimpleArtifactManifest,
    image_hash: text,
    anchors: [ManifestTrustAnchor]
) -> ManifestCheck:
    """Verify `m.signature` against explicit Ed25519 trust anchors."""
    if m.signature == "":
        return ManifestCheck(ok: false, reason: manifest_reason_missing_signature())
    if m.content_hashes.len() == 0:
        return ManifestCheck(ok: false, reason: manifest_reason_signature_without_hash())
    if anchors.len() == 0:
        return ManifestCheck(ok: false, reason: manifest_reason_trust_anchor_missing())
    val parsed = _manifest_parse_signature_envelope(m.signature)
    if not parsed.ok:
        return ManifestCheck(ok: false, reason: manifest_reason_invalid_signature_format())
    val resolved_hash = if image_hash != "": image_hash else: m.content_hashes[0]
    if not _manifest_hash_list_contains(m.content_hashes, resolved_hash):
        return ManifestCheck(ok: false, reason: manifest_reason_content_hash_mismatch())
    val idx = _manifest_find_anchor(anchors, parsed.key_id)
    if idx < 0:
        return ManifestCheck(ok: false, reason: manifest_reason_untrusted_signer())
    val anchor = anchors[idx]
    if anchor.public_key.len() != 32:
        return ManifestCheck(ok: false, reason: manifest_reason_invalid_trust_anchor())
    val signing = encode_simple_artifact_manifest_v1_signing_bytes(_manifest_to_common_v1(m), resolved_hash)
    if not signing.ok:
        return ManifestCheck(ok: false, reason: manifest_reason_signature_verification_failed())
    if not pure_ed25519_verify(anchor.public_key, signing.bytes, parsed.signature):
        return ManifestCheck(ok: false, reason: manifest_reason_signature_verification_failed())
    ManifestCheck(ok: true, reason: manifest_reason_ok())

pub fn manifest_verify_signature(m: SimpleArtifactManifest, image_hash: text) -> ManifestCheck:
    """Verify `m.signature` against registered Ed25519 trust anchors."""
    manifest_verify_signature_with_anchors(m, image_hash, _manifest_registered_anchors())

pub fn manifest_verify_signed_artifact(m: SimpleArtifactManifest, actual_bytes: [u8]) -> ManifestCheck:
    """Fail-closed admission gate: structural check + SHA-256 hash + Ed25519 signature."""
    val base_chk = manifest_validate(m)
    if not base_chk.ok:
        return base_chk
    val hash_chk = manifest_verify_content_hash(m, actual_bytes)
    if not hash_chk.ok:
        return hash_chk
    val digest_hex = manifest_sha256_hex(actual_bytes)
    manifest_verify_signature(m, digest_hex)

# ============================================================================
# Typed path-scoped capability projection for SimpleArtifactManifest (#119)
# ============================================================================

pub struct ManifestScopedCapabilityV1:
    """Versioned typed representation of one path- or port-scoped capability."""
    kind: text
    path_prefix: text
    port: i64
    right_mask: u32
    raw: text

pub struct ManifestScopedCapabilityParseV1:
    """Result of parsing a typed scoped-capability expression."""
    ok: bool
    capability: ManifestScopedCapabilityV1
    reason: text

pub struct ManifestScopedProjectionV1:
    """Result of projecting SCI capabilities into SimpleArtifactManifest."""
    ok: bool
    reason: text
    manifest: SimpleArtifactManifest
    projected: [ManifestScopedCapabilityV1]
    projected_mask: u32

fn _empty_scoped_capability_v1() -> ManifestScopedCapabilityV1:
    ManifestScopedCapabilityV1(kind: "", path_prefix: "", port: -1, right_mask: 0u32, raw: "")

fn _scoped_path_valid(path: text) -> bool:
    if path.len() == 0 or not path.starts_with("/"):
        return false
    if path.contains("..") or path.contains("//") or path.contains("\\") or path.contains(" ") or path.contains("\t") or path.contains("\n") or path.contains("\r") or path.contains("(") or path.contains(")"):
        return false
    var i: i64 = 0
    while i < path.len():
        val ch = path.char_code_at(i)
        if ch < 32 or ch > 126:
            return false
        i = i + 1
    for seg in path.split("/"):
        if seg == "." or seg == "..":
            return false
    true

fn _scoped_parse_port(raw_port: text) -> i64:
    if raw_port.len() == 0 or raw_port.len() > 5:
        return -1
    var acc: i64 = 0
    var i: i64 = 0
    while i < raw_port.len():
        val ch = raw_port.char_code_at(i)
        if ch < 48 or ch > 57:
            return -1
        acc = acc * 10 + (ch - 48)
        i = i + 1
    if acc < 1 or acc > 65535:
        return -1
    acc

fn _scoped_norm_prefix(path: text) -> text:
    if path.len() > 1 and path.ends_with("/"):
        return path.substring(0, path.len() - 1)
    path

fn _scoped_path_within(requested: text, allowed: text) -> bool:
    if not _scoped_path_valid(requested) or not _scoped_path_valid(allowed):
        return false
    if allowed == "/":
        return true
    val req_norm = _scoped_norm_prefix(requested)
    val allow_norm = _scoped_norm_prefix(allowed)
    req_norm == allow_norm or req_norm.starts_with(allow_norm + "/")

fn _scoped_right_for_file_kind(kind: text) -> u32:
    if kind == "FileRead":
        return CAP_RIGHT_READ
    if kind == "FileWrite" or kind == "FileCreate":
        return CAP_RIGHT_WRITE
    if kind == "FileExec":
        return CAP_RIGHT_EXEC
    0u32

pub fn manifest_parse_scoped_capability_v1(spec: text) -> ManifestScopedCapabilityParseV1:
    """Parse canonical SCI scoped capability token such as `FileRead(/home)`."""
    val trimmed = spec.trim()
    if trimmed == "":
        return ManifestScopedCapabilityParseV1(ok: false, capability: _empty_scoped_capability_v1(), reason: "empty_scoped_capability")
    if trimmed == "ProcessSpawn":
        val cap = ManifestScopedCapabilityV1(kind: "ProcessSpawn", path_prefix: "", port: -1, right_mask: 0u32, raw: "ProcessSpawn")
        return ManifestScopedCapabilityParseV1(ok: true, capability: cap, reason: "ok")
    val open_idx = trimmed.index_of("(") ?? -1
    if open_idx <= 0 or not trimmed.ends_with(")"):
        return ManifestScopedCapabilityParseV1(ok: false, capability: _empty_scoped_capability_v1(), reason: "malformed_scoped_capability")
    val kind = trimmed.substring(0, open_idx)
    val arg = trimmed.substring(open_idx + 1, trimmed.len() - 1)
    val file_mask = _scoped_right_for_file_kind(kind)
    if file_mask != 0u32:
        if not _scoped_path_valid(arg):
            return ManifestScopedCapabilityParseV1(ok: false, capability: _empty_scoped_capability_v1(), reason: "invalid_capability_path_scope")
        val cap = ManifestScopedCapabilityV1(
            kind: kind,
            path_prefix: _scoped_norm_prefix(arg),
            port: -1,
            right_mask: file_mask,
            raw: kind + "(" + _scoped_norm_prefix(arg) + ")"
        )
        return ManifestScopedCapabilityParseV1(ok: true, capability: cap, reason: "ok")
    if kind == "NetConnect" or kind == "NetListen":
        val port = _scoped_parse_port(arg)
        if port < 0:
            return ManifestScopedCapabilityParseV1(ok: false, capability: _empty_scoped_capability_v1(), reason: "invalid_capability_port")
        val cap = ManifestScopedCapabilityV1(
            kind: kind,
            path_prefix: "",
            port: port,
            right_mask: 0u32,
            raw: kind + "(" + port.to_string() + ")"
        )
        return ManifestScopedCapabilityParseV1(ok: true, capability: cap, reason: "ok")
    ManifestScopedCapabilityParseV1(ok: false, capability: _empty_scoped_capability_v1(), reason: "unknown_scoped_capability")

pub fn manifest_scoped_capability_admitted_v1(
    req: ManifestScopedCapabilityV1,
    allowed: [ManifestScopedCapabilityV1]
) -> bool:
    """True when `req` matches an allowed capability and stays inside its scope."""
    if req.kind == "":
        return false
    for a in allowed:
        if a.kind != req.kind:
            continue
        if req.kind == "ProcessSpawn":
            return true
        if req.kind == "NetConnect" or req.kind == "NetListen":
            if req.port > 0 and req.port == a.port:
                return true
        if _scoped_right_for_file_kind(req.kind) != 0u32:
            if _scoped_path_within(req.path_prefix, a.path_prefix):
                return true
    false

pub fn manifest_project_scoped_capabilities_v1(
    m: SimpleArtifactManifest,
    specs: [text],
    ceiling: [ManifestScopedCapabilityV1]
) -> ManifestScopedProjectionV1:
    """Validate and project SCI capability strings into `m` bounded by kind & scope ceiling."""
    val kind_max = manifest_kind_allowed_rights(m.artifact_kind)
    var projected: [ManifestScopedCapabilityV1] = []
    var req_mask: u32 = 0u32
    for spec in specs:
        val parsed = manifest_parse_scoped_capability_v1(spec)
        if not parsed.ok:
            return ManifestScopedProjectionV1(ok: false, reason: parsed.reason, manifest: m, projected: [], projected_mask: 0u32)
        val cap = parsed.capability
        if not spawn_rights_is_subset(cap.right_mask, kind_max):
            return ManifestScopedProjectionV1(ok: false, reason: "capability_exceeds_kind_ceiling", manifest: m, projected: [], projected_mask: 0u32)
        if not manifest_scoped_capability_admitted_v1(cap, ceiling):
            return ManifestScopedProjectionV1(ok: false, reason: "capability_exceeds_scope_ceiling", manifest: m, projected: [], projected_mask: 0u32)
        projected.push(cap)
        req_mask = req_mask | cap.right_mask
    val clamped = manifest_with_requested_rights(m, req_mask)
    ManifestScopedProjectionV1(
        ok: true,
        reason: manifest_reason_ok(),
        manifest: clamped,
        projected: projected,
        projected_mask: req_mask & kind_max
    )
