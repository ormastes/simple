"""RV64 policy adapter for combined signed toolchain ingestion."""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.loader.combined_toolchain_catalog_media_boot_v1.{
    combined_toolchain_catalog_media_boot_prepare_v1,
    combined_toolchain_catalog_media_boot_populate_v1}
use os.services.vfs.vfs_boot_state.{
    vfs_state_mount_table_owner_handle_v1,
    vfs_state_mount_table_lease_begin_v1,
    vfs_state_mount_table_lease_restore_v1}
use rv64_auth_trust_config.{
    rv64_authenticated_pinned_key_id_v1,
    rv64_authenticated_pinned_public_key_hex_v1,
    rv64_authenticated_pinned_public_key_hash_v1
}

pub fn riscv64_catalog_media_boot_ingest_canonical_v1() -> bool:
    val owner = vfs_state_mount_table_owner_handle_v1()
    if not owner.?: return false
    val leased = vfs_state_mount_table_lease_begin_v1(owner.unwrap())
    if not leased.?: return false
    val lease = leased.unwrap()
    val prepared = combined_toolchain_catalog_media_boot_prepare_v1(
        lease.table,
        ManifestTarget(os: "simpleos", arch: "riscv64", abi: "simpleos"),
        rv64_authenticated_pinned_key_id_v1(),
        rv64_authenticated_pinned_public_key_hex_v1(),
        rv64_authenticated_pinned_public_key_hash_v1())
    val restored = vfs_state_mount_table_lease_restore_v1(lease)
    if not restored or prepared.is_err(): return false
    combined_toolchain_catalog_media_boot_populate_v1(prepared.unwrap())
