"""RV64 production policy adapter for filesystem-backed SCR1 ingestion."""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.loader.simplebox_catalog_media_boot_v1.{
    SimpleboxCatalogMediaLayoutV1, SimpleboxCatalogMediaBootPolicyV1,
    SimpleboxCatalogMediaBootResultV1,
    simplebox_catalog_media_boot_ingest_v1,
    simplebox_catalog_media_canonical_layout_v1
}
use rv64_auth_trust_config.{
    rv64_authenticated_pinned_key_id_v1,
    rv64_authenticated_pinned_public_key_hex_v1,
    rv64_authenticated_pinned_public_key_hash_v1
}

fn riscv64_simplebox_catalog_media_boot_ingest_v1(
    layouts: [SimpleboxCatalogMediaLayoutV1],
) -> SimpleboxCatalogMediaBootResultV1:
    simplebox_catalog_media_boot_ingest_v1(SimpleboxCatalogMediaBootPolicyV1(
        target: ManifestTarget(os: "simpleos", arch: "riscv64", abi: "simpleos"),
        layouts: layouts,
        pinned_key_id: rv64_authenticated_pinned_key_id_v1(),
        pinned_public_key_hex: rv64_authenticated_pinned_public_key_hex_v1(),
        pinned_public_key_sha256:
            rv64_authenticated_pinned_public_key_hash_v1()))

pub fn riscv64_simplebox_catalog_media_boot_ingest_canonical_v1(
) -> SimpleboxCatalogMediaBootResultV1:
    riscv64_simplebox_catalog_media_boot_ingest_v1([
        simplebox_catalog_media_canonical_layout_v1()])
