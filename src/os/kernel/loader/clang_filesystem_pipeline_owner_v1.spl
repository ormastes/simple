"""Bounded pre-launch owner for a guest-native Clang hello pipeline.

This capsule binds authenticated installed Clang/LLD catalog rows to one
declared task identity and an exact non-delegable capability pouch.  A dispatch
must subsequently bind to the scheduler's canonical current TCB before the
owner emits a fixed backend command.  The backend can publish exactly one
terminal observation, which remains owner-retained until consumed as a receipt.
"""

use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.contracts.execution.simpleos_target_v1.{
    SIMPLEOS_TARGET_V1_X86_64_TRIPLE, SIMPLEOS_TARGET_V1_I686_TRIPLE,
    SIMPLEOS_TARGET_V1_AARCH64_TRIPLE, SIMPLEOS_TARGET_V1_ARMV7_TRIPLE,
    SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE,
    SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE,
    simpleos_target_v1_arch_for_triple
}
use std.common.contracts.execution.simpleos_vfs_mutation_v1.{TaskExecutionInstanceV1}
use std.common.structural.digest.hash256.{hash256_hex_valid, hash256_is_zero}
use std.common.crypto.sha256.{sha256_u8_hex}
use os.kernel.types.capability_types.{CapabilityKind, CapabilitySet}
use os.kernel.scheduler.scheduler_types.{
    SchedulerCurrentTaskAdmissionV1,
    scheduler_current_task_admission_matches_v1
}
use os.kernel.loader.installed_artifact_catalog_v1.{
    installed_artifact_catalog_lookup_target_v1
}
use os.kernel.loader.clang_sysroot_launch_grants_v1.{
    CLANG_SYSROOT_READ_GRANT_COUNT_V1,
    clang_sysroot_caps_exact_v1,
    clang_sysroot_catalog_projection_v1
}
use os.services.vfs.vfs_include_tree_proof_v1.{
    vfs_include_tree_prove_and_seal_v1
}

pub const CLANG_FILESYSTEM_PIPELINE_SLOT_LIMIT_V1: i32 = 32
pub const CLANG_FILESYSTEM_PIPELINE_PATH_MAX_V1: i64 = 512

pub enum ClangFilesystemPipelineFilesystemV1:
    Fat32
    Dbfs
    Nvfs

pub enum ClangFilesystemPipelineStateV1:
    Free
    Reserved
    Dispatched
    Running
    Terminal
    Retired

pub enum ClangFilesystemPipelineEventV1:
    Reserve
    Dispatch
    Begin
    Complete
    Cancel
    OutcomeUnknown

pub fn clang_filesystem_pipeline_transition_v1(
    state: ClangFilesystemPipelineStateV1,
    event: ClangFilesystemPipelineEventV1
) -> ClangFilesystemPipelineStateV1?:
    if state == ClangFilesystemPipelineStateV1.Free and
       event == ClangFilesystemPipelineEventV1.Reserve:
        return Some(ClangFilesystemPipelineStateV1.Reserved)
    if state == ClangFilesystemPipelineStateV1.Reserved and
       event == ClangFilesystemPipelineEventV1.Dispatch:
        return Some(ClangFilesystemPipelineStateV1.Dispatched)
    if state == ClangFilesystemPipelineStateV1.Dispatched and
       event == ClangFilesystemPipelineEventV1.Begin:
        return Some(ClangFilesystemPipelineStateV1.Running)
    if state == ClangFilesystemPipelineStateV1.Running and
       event == ClangFilesystemPipelineEventV1.Complete:
        return Some(ClangFilesystemPipelineStateV1.Terminal)
    if state == ClangFilesystemPipelineStateV1.Reserved and
       event == ClangFilesystemPipelineEventV1.Cancel:
        return Some(ClangFilesystemPipelineStateV1.Free)
    if (state == ClangFilesystemPipelineStateV1.Dispatched or
        state == ClangFilesystemPipelineStateV1.Running) and
       event == ClangFilesystemPipelineEventV1.OutcomeUnknown:
        return Some(ClangFilesystemPipelineStateV1.Retired)
    nil

pub struct ClangFilesystemPipelineRequestV1:
    actor: TaskExecutionInstanceV1
    target_triple: text
    filesystem: ClangFilesystemPipelineFilesystemV1
    source_path: text
    object_path: text
    executable_path: text
    working_directory: text
    include_tree_sha256: text

pub(package) struct ClangFilesystemPipelineReservationV1:
    _slot: i32
    _generation: u32
    _nonce: u64

pub(package) struct ClangFilesystemPipelineDispatchV1:
    reservation: ClangFilesystemPipelineReservationV1
    actor: TaskExecutionInstanceV1
    target: ManifestTarget
    target_triple: text
    filesystem: ClangFilesystemPipelineFilesystemV1
    clang_path: text
    clang_sha256: text
    lld_path: text
    lld_sha256: text
    sysroot_sha256: [text]
    source_path: text
    object_path: text
    executable_path: text
    working_directory: text

pub(package) struct ClangFilesystemBackendCommandV1:
    dispatch: ClangFilesystemPipelineDispatchV1
    compile_argv: [text]
    link_argv: [text]
    execute_argv: [text]

pub struct ClangFilesystemBackendOutcomeV1:
    actor: TaskExecutionInstanceV1
    compile_exit_code: i32
    link_exit_code: i32
    execute_exit_code: i32
    source_sha256: text
    object_sha256: text
    executable_sha256: text
    stdout_sha256: text

pub(package) struct ClangFilesystemTerminalHandleV1:
    _reservation: ClangFilesystemPipelineReservationV1

pub struct ClangFilesystemTerminalReceiptV1:
    actor: TaskExecutionInstanceV1
    target: ManifestTarget
    filesystem: ClangFilesystemPipelineFilesystemV1
    source_path: text
    object_path: text
    executable_path: text
    source_sha256: text
    object_sha256: text
    executable_sha256: text
    stdout_sha256: text
    compile_exit_code: i32
    link_exit_code: i32
    execute_exit_code: i32
    succeeded: bool

struct ClangFilesystemPipelineSlotV1:
    state: ClangFilesystemPipelineStateV1
    generation: u32
    nonce: u64
    request: ClangFilesystemPipelineRequestV1
    target: ManifestTarget
    clang_sha256: text
    lld_sha256: text
    sysroot_sha256: [text]
    receipt: ClangFilesystemTerminalReceiptV1?

struct ClangFilesystemPipelineOwnerV1:
    initialized: bool
    quarantined: bool
    next_nonce: u64
    slots: [ClangFilesystemPipelineSlotV1]
    free_slots: [i32]

fn _empty_actor_v1() -> TaskExecutionInstanceV1:
    TaskExecutionInstanceV1(
        task_id: 0u64, lifecycle_generation: 0u64, exec_generation: 0u64)

fn _empty_target_v1() -> ManifestTarget:
    ManifestTarget(os: "", arch: "", abi: "")

fn _empty_request_v1() -> ClangFilesystemPipelineRequestV1:
    ClangFilesystemPipelineRequestV1(
        actor: _empty_actor_v1(), target_triple: "",
        filesystem: ClangFilesystemPipelineFilesystemV1.Fat32,
        source_path: "", object_path: "", executable_path: "",
        working_directory: "", include_tree_sha256: "")

fn _empty_slot_v1(generation: u32) -> ClangFilesystemPipelineSlotV1:
    ClangFilesystemPipelineSlotV1(
        state: ClangFilesystemPipelineStateV1.Free,
        generation: generation, nonce: 0u64,
        request: _empty_request_v1(), target: _empty_target_v1(),
        clang_sha256: "", lld_sha256: "", sysroot_sha256: [], receipt: nil)

fn _new_slots_v1() -> [ClangFilesystemPipelineSlotV1]:
    var result: [ClangFilesystemPipelineSlotV1] = []
    var i: i32 = 0
    while i < CLANG_FILESYSTEM_PIPELINE_SLOT_LIMIT_V1:
        result.push(_empty_slot_v1(1u32))
        i = i + 1
    result

fn _new_free_slots_v1() -> [i32]:
    var result: [i32] = []
    var i = CLANG_FILESYSTEM_PIPELINE_SLOT_LIMIT_V1 - 1
    while i >= 0:
        result.push(i)
        i = i - 1
    result

val _clang_pipeline_mutex_v1 = mutex_raw_create()
var _clang_pipeline_owner_v1 = ClangFilesystemPipelineOwnerV1(
    initialized: false, quarantined: false,
    next_nonce: 0x434c414e47504631u64, slots: [], free_slots: [])

fn _initialize_locked_v1():
    if not _clang_pipeline_owner_v1.initialized:
        _clang_pipeline_owner_v1.slots = _new_slots_v1()
        _clang_pipeline_owner_v1.free_slots = _new_free_slots_v1()
        _clang_pipeline_owner_v1.initialized = true

fn _lock_v1() -> bool:
    if _clang_pipeline_mutex_v1 <= 0 or
       not mutex_raw_lock(_clang_pipeline_mutex_v1):
        return false
    _initialize_locked_v1()
    if _clang_pipeline_owner_v1.quarantined:
        _ = mutex_raw_unlock(_clang_pipeline_mutex_v1)
        return false
    true

fn _unlock_v1() -> bool:
    if mutex_raw_unlock(_clang_pipeline_mutex_v1): return true
    _clang_pipeline_owner_v1.quarantined = true
    false

fn _next_nonce_locked_v1() -> u64:
    if _clang_pipeline_owner_v1.next_nonce == 0xffffffffffffffffu64:
        return 0u64
    _clang_pipeline_owner_v1.next_nonce =
        _clang_pipeline_owner_v1.next_nonce + 1u64
    _clang_pipeline_owner_v1.next_nonce

fn _target_v1(triple: text) -> ManifestTarget?:
    val arch = simpleos_target_v1_arch_for_triple(triple)
    if arch == "": return nil
    Some(ManifestTarget(os: "simpleos", arch: arch, abi: "simpleos"))

fn _lld_emulation_v1(triple: text) -> text:
    if triple == SIMPLEOS_TARGET_V1_X86_64_TRIPLE: return "elf_x86_64"
    if triple == SIMPLEOS_TARGET_V1_I686_TRIPLE: return "elf_i386"
    if triple == SIMPLEOS_TARGET_V1_AARCH64_TRIPLE: return "aarch64elf"
    if triple == SIMPLEOS_TARGET_V1_ARMV7_TRIPLE: return "armelf_linux_eabi"
    if triple == SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE: return "elf64lriscv"
    if triple == SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE: return "elf32lriscv"
    ""

fn _path_byte_domain_valid_v1(path: text) -> bool:
    # These paths become authenticated argv fields.  Reject the complete ASCII
    # control range (including HTAB and DEL), rather than only NUL/CR/LF, so a
    # path has one unambiguous byte representation at the VFS, audit, and exec
    # boundaries.  The request path limit keeps this scan strictly bounded.
    # Bound before materializing the byte view so an oversized request cannot
    # force an unbounded temporary allocation merely to be rejected.  Retain
    # the byte-length check because UTF-8 paths can contain multiple bytes per
    # text element.
    if path.len() > CLANG_FILESYSTEM_PIPELINE_PATH_MAX_V1: return false
    val bytes = path.bytes()
    val byte_count = bytes.len()
    if byte_count > CLANG_FILESYSTEM_PIPELINE_PATH_MAX_V1: return false
    var index: i64 = 0
    while index < byte_count:
        val byte = bytes[index]
        if byte < 32u8 or byte == 127u8: return false
        index = index + 1
    true

fn _path_valid_v1(path: text) -> bool:
    path.len() > 1 and _path_byte_domain_valid_v1(path) and
        path.starts_with("/") and not path.ends_with("/") and
        not path.contains("//") and not path.contains("/./") and
        not path.contains("/../") and not path.ends_with("/.") and
        not path.ends_with("/..") and not path.contains("\\")

fn _filesystem_root_v1(filesystem: ClangFilesystemPipelineFilesystemV1) -> text:
    match filesystem:
        ClangFilesystemPipelineFilesystemV1.Fat32: "/fat32"
        ClangFilesystemPipelineFilesystemV1.Dbfs: "/dbfs"
        ClangFilesystemPipelineFilesystemV1.Nvfs: "/nvfs"

fn _filesystem_supported_v1(
    filesystem: ClangFilesystemPipelineFilesystemV1
) -> bool:
    # FAT32 textual paths are not stable object identities because of case,
    # short-name, and Unicode aliases. Its integration must supply a backend-
    # canonical object key before this owner can serialize output paths.
    filesystem == ClangFilesystemPipelineFilesystemV1.Dbfs or
        filesystem == ClangFilesystemPipelineFilesystemV1.Nvfs

fn _actor_valid_v1(actor: TaskExecutionInstanceV1) -> bool:
    actor.task_id != 0u64 and actor.lifecycle_generation != 0u64 and
        actor.exec_generation != 0u64

pub fn clang_filesystem_pipeline_request_valid_v1(
    request: ClangFilesystemPipelineRequestV1,
    caps: CapabilitySet
) -> bool:
    if not _actor_valid_v1(request.actor) or not _target_v1(request.target_triple).?:
        return false
    if not _filesystem_supported_v1(request.filesystem): return false
    val root = _filesystem_root_v1(request.filesystem)
    val work = root + "/work"
    # These exact names are part of the signed pipeline protocol.  Allowing
    # arbitrary descendants would make a fixed spawn recipe authorize a
    # different source or generated executable than the owner reviewed.
    if request.working_directory != work or
       request.source_path != work + "/hello.c" or
       request.object_path != work + "/hello.o" or
       request.executable_path != work + "/hello.elf" or
       not _path_valid_v1(request.working_directory) or
       not _path_valid_v1(request.source_path) or
       not _path_valid_v1(request.object_path) or
       not _path_valid_v1(request.executable_path):
        return false
    if not hash256_hex_valid(request.include_tree_sha256) or
       hash256_is_zero(request.include_tree_sha256):
        return false
    if not caps.is_pledged or
       caps.caps.len() != 8 + CLANG_SYSROOT_READ_GRANT_COUNT_V1 or
       not clang_sysroot_caps_exact_v1(caps):
        return false
    # Count every request-local kind while performing the mandatory token
    # ownership/uniqueness walk.  Keeping these counts in the same pass avoids
    # eight additional full pouch scans on every pipeline admission.
    var clang_exec_count: i64 = 0
    var lld_exec_count: i64 = 0
    var source_read_count: i64 = 0
    var working_directory_read_count: i64 = 0
    var object_write_count: i64 = 0
    var object_create_count: i64 = 0
    var executable_write_count: i64 = 0
    var executable_create_count: i64 = 0
    var token_index: i64 = 0
    while token_index < caps.caps.len():
        val token = caps.caps[token_index]
        if token.owner != request.actor.task_id or token.generation == 0u64 or
           token.token_id == 0u64 or token.depth != 0:
            return false
        var prior: i64 = 0
        while prior < token_index:
            if caps.caps[prior].token_id == token.token_id: return false
            prior = prior + 1
        match token.kind:
            case CapabilityKind.FileExec(prefix):
                if prefix == "/usr/bin/clang":
                    clang_exec_count = clang_exec_count + 1
                if prefix == "/usr/bin/ld.lld":
                    lld_exec_count = lld_exec_count + 1
            case CapabilityKind.FileRead(prefix):
                if prefix == request.source_path:
                    source_read_count = source_read_count + 1
                if prefix == request.working_directory:
                    working_directory_read_count = working_directory_read_count + 1
            case CapabilityKind.FileWrite(prefix):
                if prefix == request.object_path:
                    object_write_count = object_write_count + 1
                if prefix == request.executable_path:
                    executable_write_count = executable_write_count + 1
            case CapabilityKind.FileCreate(prefix):
                if prefix == request.object_path:
                    object_create_count = object_create_count + 1
                if prefix == request.executable_path:
                    executable_create_count = executable_create_count + 1
            case _:
                pass_dn("unrelated sysroot capability kind")
        token_index = token_index + 1
    clang_exec_count == 1 and lld_exec_count == 1 and
        source_read_count == 1 and working_directory_read_count == 1 and
        object_write_count == 1 and object_create_count == 1 and
        executable_write_count == 1 and executable_create_count == 1

fn _reservation_index_locked_v1(
    reservation: ClangFilesystemPipelineReservationV1,
    state: ClangFilesystemPipelineStateV1
) -> i32:
    if reservation._slot < 0 or
       reservation._slot >= CLANG_FILESYSTEM_PIPELINE_SLOT_LIMIT_V1 or
       reservation._generation == 0u32 or reservation._nonce == 0u64:
        return -1
    val slot = _clang_pipeline_owner_v1.slots[reservation._slot]
    if slot.state != state or slot.generation != reservation._generation or
       slot.nonce != reservation._nonce:
        return -1
    reservation._slot

fn _request_paths_overlap_v1(
    left: ClangFilesystemPipelineRequestV1,
    right: ClangFilesystemPipelineRequestV1
) -> bool:
    val left_paths = [left.source_path, left.object_path, left.executable_path]
    val right_paths = [right.source_path, right.object_path, right.executable_path]
    for left_path in left_paths:
        for right_path in right_paths:
            if left_path == right_path: return true
    false

fn _request_available_locked_v1(request: ClangFilesystemPipelineRequestV1) -> bool:
    # Fixed 32-slot upper bound prevents concurrent read/write or write/write
    # aliasing without allocating a second path index.
    for slot in _clang_pipeline_owner_v1.slots:
        if slot.state != ClangFilesystemPipelineStateV1.Free and
           _request_paths_overlap_v1(request, slot.request):
            return false
    true

fn _release_locked_v1(index: i32):
    val generation = _clang_pipeline_owner_v1.slots[index].generation
    if generation == 0xffffffffu32:
        _clang_pipeline_owner_v1.slots[index].state =
            ClangFilesystemPipelineStateV1.Retired
        _clang_pipeline_owner_v1.slots[index].nonce = 0u64
        return
    _clang_pipeline_owner_v1.slots[index] = _empty_slot_v1(generation + 1u32)
    _clang_pipeline_owner_v1.free_slots.push(index)

pub(package) fn clang_filesystem_pipeline_reserve_v1(
    request: ClangFilesystemPipelineRequestV1,
    caps: CapabilitySet
) -> Result<ClangFilesystemPipelineReservationV1, text>:
    if not clang_filesystem_pipeline_request_valid_v1(request, caps):
        return Err("invalid-request-or-authority")
    val target = _target_v1(request.target_triple) ?? return Err("invalid-target")
    val clang_record = installed_artifact_catalog_lookup_target_v1(
        "/usr/bin/clang", target) ?? return Err("clang-not-authenticated")
    val lld_record = installed_artifact_catalog_lookup_target_v1(
        "/usr/bin/ld.lld", target) ?? return Err("lld-not-authenticated")
    val sysroot = clang_sysroot_catalog_projection_v1(target) ??
        return Err("sysroot-not-authenticated")
    val include_proof = vfs_include_tree_prove_and_seal_v1(
        request.target_triple, sysroot.include_manifest.content_sha256,
        request.include_tree_sha256,
        ["/usr/share/simpleos/simpleos.ld", "/usr/lib/crt0.o",
         "/usr/lib/libsimpleos_c.a", "/usr/lib/libsimple_runtime.a",
         "/usr/lib/libm.a"],
        [sysroot.linker_script.content_sha256, sysroot.crt0.content_sha256,
         sysroot.libc.content_sha256, sysroot.runtime.content_sha256,
         sysroot.libm.content_sha256])
    if include_proof.is_err(): return Err(include_proof.unwrap_err())
    val sysroot_sha256 = [
        sysroot.include_manifest.content_sha256,
        sysroot.linker_script.content_sha256, sysroot.crt0.content_sha256,
        sysroot.libc.content_sha256, sysroot.runtime.content_sha256,
        sysroot.libm.content_sha256,
    ]
    if not _lock_v1(): return Err("serialization-unavailable")
    if not _request_available_locked_v1(request):
        _ = _unlock_v1()
        return Err("pipeline-path-busy")
    if _clang_pipeline_owner_v1.free_slots.len() == 0:
        _ = _unlock_v1()
        return Err("pipeline-capacity-exhausted")
    val nonce = _next_nonce_locked_v1()
    if nonce == 0u64:
        _clang_pipeline_owner_v1.quarantined = true
        _ = _unlock_v1()
        return Err("nonce-exhausted")
    val last = _clang_pipeline_owner_v1.free_slots.len() - 1
    val index = _clang_pipeline_owner_v1.free_slots[last]
    _clang_pipeline_owner_v1.free_slots.pop()
    val generation = _clang_pipeline_owner_v1.slots[index].generation
    val reserved_state = clang_filesystem_pipeline_transition_v1(
        ClangFilesystemPipelineStateV1.Free,
        ClangFilesystemPipelineEventV1.Reserve)
    if not reserved_state.?:
        _clang_pipeline_owner_v1.quarantined = true
        _ = _unlock_v1()
        return Err("invalid-lifecycle-transition")
    _clang_pipeline_owner_v1.slots[index] = ClangFilesystemPipelineSlotV1(
        state: reserved_state.unwrap(),
        generation: generation, nonce: nonce, request: request,
        target: target, clang_sha256: clang_record.content_sha256,
        lld_sha256: lld_record.content_sha256,
        sysroot_sha256: sysroot_sha256, receipt: nil)
    val result = ClangFilesystemPipelineReservationV1(
        _slot: index, _generation: generation, _nonce: nonce)
    if not _unlock_v1(): return Err("committed-unknown")
    Ok(result)

pub(package) fn clang_filesystem_pipeline_dispatch_v1(
    reservation: ClangFilesystemPipelineReservationV1,
    caller: TaskExecutionInstanceV1
) -> Result<ClangFilesystemPipelineDispatchV1, text>:
    if not _lock_v1(): return Err("serialization-unavailable")
    val index = _reservation_index_locked_v1(
        reservation, ClangFilesystemPipelineStateV1.Reserved)
    if index < 0:
        _ = _unlock_v1()
        return Err("stale-or-consumed-reservation")
    val slot = _clang_pipeline_owner_v1.slots[index]
    if slot.request.actor != caller:
        _ = _unlock_v1()
        return Err("task-lifecycle-mismatch")
    val dispatched_state = clang_filesystem_pipeline_transition_v1(
        _clang_pipeline_owner_v1.slots[index].state,
        ClangFilesystemPipelineEventV1.Dispatch)
    if not dispatched_state.?:
        _clang_pipeline_owner_v1.quarantined = true
        _ = _unlock_v1()
        return Err("invalid-lifecycle-transition")
    _clang_pipeline_owner_v1.slots[index].state = dispatched_state.unwrap()
    val result = ClangFilesystemPipelineDispatchV1(
        reservation: reservation, actor: caller, target: slot.target,
        target_triple: slot.request.target_triple,
        filesystem: slot.request.filesystem,
        clang_path: "/usr/bin/clang", clang_sha256: slot.clang_sha256,
        lld_path: "/usr/bin/ld.lld", lld_sha256: slot.lld_sha256,
        sysroot_sha256: slot.sysroot_sha256,
        source_path: slot.request.source_path,
        object_path: slot.request.object_path,
        executable_path: slot.request.executable_path,
        working_directory: slot.request.working_directory)
    if not _unlock_v1(): return Err("committed-unknown")
    Ok(result)

pub(package) fn clang_filesystem_pipeline_cancel_v1(
    reservation: ClangFilesystemPipelineReservationV1
) -> Result<bool, text>:
    if not _lock_v1(): return Err("serialization-unavailable")
    val index = _reservation_index_locked_v1(
        reservation, ClangFilesystemPipelineStateV1.Reserved)
    if index < 0:
        _ = _unlock_v1()
        return Err("stale-or-consumed-reservation")
    val cancelled = clang_filesystem_pipeline_transition_v1(
        _clang_pipeline_owner_v1.slots[index].state,
        ClangFilesystemPipelineEventV1.Cancel)
    if not cancelled.? or
       cancelled.unwrap() != ClangFilesystemPipelineStateV1.Free:
        _clang_pipeline_owner_v1.quarantined = true
        _ = _unlock_v1()
        return Err("invalid-lifecycle-transition")
    _release_locked_v1(index)
    if not _unlock_v1(): return Err("committed-unknown")
    Ok(true)

fn _scheduler_admission_matches_actor_v1(
    admission: SchedulerCurrentTaskAdmissionV1,
    actor: TaskExecutionInstanceV1
) -> bool:
    scheduler_current_task_admission_matches_v1(
        admission, actor.task_id, actor.lifecycle_generation)

fn _dispatch_matches_slot_v1(
    dispatch: ClangFilesystemPipelineDispatchV1,
    slot: ClangFilesystemPipelineSlotV1
) -> bool:
    slot.request.actor == dispatch.actor and slot.target == dispatch.target and
        slot.request.filesystem == dispatch.filesystem and
        slot.request.target_triple == dispatch.target_triple and
        slot.request.source_path == dispatch.source_path and
        slot.request.object_path == dispatch.object_path and
        slot.request.executable_path == dispatch.executable_path and
        slot.request.working_directory == dispatch.working_directory and
        slot.clang_sha256 == dispatch.clang_sha256 and
        slot.lld_sha256 == dispatch.lld_sha256 and
        slot.sysroot_sha256 == dispatch.sysroot_sha256

pub(package) fn clang_filesystem_pipeline_begin_current_v1(
    admission: SchedulerCurrentTaskAdmissionV1,
    dispatch: ClangFilesystemPipelineDispatchV1
) -> Result<ClangFilesystemBackendCommandV1, text>:
    # The scheduler proves the task/lifecycle half of the actor identity.  The
    # exec generation remains the one already authenticated and retained by
    # this owner; it is never reconstructed from a PID.
    if not _scheduler_admission_matches_actor_v1(admission, dispatch.actor):
        return Err("scheduler-current-task-mismatch")
    if not _lock_v1(): return Err("serialization-unavailable")
    val index = _reservation_index_locked_v1(
        dispatch.reservation, ClangFilesystemPipelineStateV1.Dispatched)
    if index < 0:
        _ = _unlock_v1()
        return Err("stale-or-nondispatched-reservation")
    val slot = _clang_pipeline_owner_v1.slots[index]
    if not _dispatch_matches_slot_v1(dispatch, slot):
        _ = _unlock_v1()
        return Err("dispatch-content-mismatch")
    val running = clang_filesystem_pipeline_transition_v1(
        slot.state, ClangFilesystemPipelineEventV1.Begin)
    if not running.?:
        _clang_pipeline_owner_v1.quarantined = true
        _ = _unlock_v1()
        return Err("invalid-lifecycle-transition")
    _clang_pipeline_owner_v1.slots[index].state = running.unwrap()
    val lld_emulation = _lld_emulation_v1(dispatch.target_triple)
    if lld_emulation == "":
        _clang_pipeline_owner_v1.quarantined = true
        _ = _unlock_v1()
        return Err("unsupported-linker-emulation")
    val command = ClangFilesystemBackendCommandV1(
        dispatch: dispatch,
        # Ring-3 FS exec has no fork. Invoke the proven in-process frontend
        # form directly; driver mode would need to spawn a second clang.
        compile_argv: [dispatch.clang_path, "-cc1", "-triple",
            dispatch.target_triple, "-emit-obj", "-o", dispatch.object_path,
            "-x", "c", dispatch.source_path],
        # Invoke LLD directly, so spell every target/startup/runtime input that
        # the Clang driver would otherwise contribute.  In particular, an
        # object file alone can link while still producing a non-runnable ELF
        # with the wrong emulation or no `_start` startup path.
        link_argv: [dispatch.lld_path,
            "-m", lld_emulation, "-static", "-no-pie", "--gc-sections",
            "--export-dynamic", "--defsym=__bss_end=_end",
            "-T", "/usr/share/simpleos/simpleos.ld", "-e", "_start",
            "/usr/lib/crt0.o", dispatch.object_path,
            "-L", "/usr/lib", "--start-group", "-lsimpleos_c",
            "-lsimple_runtime", "-lm", "--end-group",
            "-o", dispatch.executable_path],
        execute_argv: [dispatch.executable_path])
    if not _unlock_v1(): return Err("committed-unknown")
    Ok(command)

fn _terminal_digest_valid_v1(value: text) -> bool:
    hash256_hex_valid(value) and not hash256_is_zero(value)

fn _terminal_receipt_v1(
    command: ClangFilesystemBackendCommandV1,
    outcome: ClangFilesystemBackendOutcomeV1
) -> Result<ClangFilesystemTerminalReceiptV1, text>:
    if outcome.actor != command.dispatch.actor or
       not _terminal_digest_valid_v1(outcome.source_sha256):
        return Err("invalid-backend-outcome")
    val succeeded = outcome.compile_exit_code == 0 and
        outcome.link_exit_code == 0 and outcome.execute_exit_code == 0
    if succeeded and
       (not _terminal_digest_valid_v1(outcome.object_sha256) or
        not _terminal_digest_valid_v1(outcome.executable_sha256) or
        not _terminal_digest_valid_v1(outcome.stdout_sha256) or
        outcome.stdout_sha256 != sha256_u8_hex("Hello from SimpleOS\n".bytes())):
        return Err("successful-outcome-evidence-mismatch")
    Ok(ClangFilesystemTerminalReceiptV1(
        actor: outcome.actor, target: command.dispatch.target,
        filesystem: command.dispatch.filesystem,
        source_path: command.dispatch.source_path,
        object_path: command.dispatch.object_path,
        executable_path: command.dispatch.executable_path,
        source_sha256: outcome.source_sha256,
        object_sha256: outcome.object_sha256,
        executable_sha256: outcome.executable_sha256,
        stdout_sha256: outcome.stdout_sha256,
        compile_exit_code: outcome.compile_exit_code,
        link_exit_code: outcome.link_exit_code,
        execute_exit_code: outcome.execute_exit_code,
        succeeded: succeeded))

pub(package) fn clang_filesystem_pipeline_finish_v1(
    command: ClangFilesystemBackendCommandV1,
    outcome: ClangFilesystemBackendOutcomeV1
) -> Result<ClangFilesystemTerminalHandleV1, text>:
    val receipt_result = _terminal_receipt_v1(command, outcome)
    if receipt_result.is_err(): return Err(receipt_result.unwrap_err())
    val receipt = receipt_result.unwrap()
    if not _lock_v1(): return Err("serialization-unavailable")
    val index = _reservation_index_locked_v1(
        command.dispatch.reservation, ClangFilesystemPipelineStateV1.Running)
    if index < 0:
        _ = _unlock_v1()
        return Err("stale-or-nonrunning-reservation")
    val slot = _clang_pipeline_owner_v1.slots[index]
    if not _dispatch_matches_slot_v1(command.dispatch, slot) or
       slot.request.actor != outcome.actor:
        _ = _unlock_v1()
        return Err("backend-actor-mismatch")
    val terminal = clang_filesystem_pipeline_transition_v1(
        slot.state, ClangFilesystemPipelineEventV1.Complete)
    if not terminal.?:
        _clang_pipeline_owner_v1.quarantined = true
        _ = _unlock_v1()
        return Err("invalid-lifecycle-transition")
    _clang_pipeline_owner_v1.slots[index].receipt = Some(receipt)
    _clang_pipeline_owner_v1.slots[index].state = terminal.unwrap()
    val handle = ClangFilesystemTerminalHandleV1(
        _reservation: command.dispatch.reservation)
    if not _unlock_v1(): return Err("committed-unknown")
    Ok(handle)

pub(package) fn clang_filesystem_pipeline_finish_and_take_v1(
    command: ClangFilesystemBackendCommandV1,
    outcome: ClangFilesystemBackendOutcomeV1,
    caller: TaskExecutionInstanceV1
) -> Result<ClangFilesystemTerminalReceiptV1, text>:
    """Atomically complete and consume one receipt under the owner lock.

    This removes the terminal-handle handoff window.  A pre-commit lock error
    leaves the Running row addressable by `command`; after release commits,
    an unlock failure is reported explicitly and cannot strand a Terminal row.
    """
    val receipt_result = _terminal_receipt_v1(command, outcome)
    if receipt_result.is_err(): return Err(receipt_result.unwrap_err())
    val receipt = receipt_result.unwrap()
    if caller != command.dispatch.actor:
        return Err("terminal-receipt-actor-mismatch")
    if not _lock_v1(): return Err("serialization-unavailable")
    val index = _reservation_index_locked_v1(
        command.dispatch.reservation, ClangFilesystemPipelineStateV1.Running)
    if index < 0:
        _ = _unlock_v1()
        return Err("stale-or-nonrunning-reservation")
    val slot = _clang_pipeline_owner_v1.slots[index]
    if not _dispatch_matches_slot_v1(command.dispatch, slot) or
       slot.request.actor != outcome.actor:
        _ = _unlock_v1()
        return Err("backend-actor-mismatch")
    val terminal = clang_filesystem_pipeline_transition_v1(
        slot.state, ClangFilesystemPipelineEventV1.Complete)
    if not terminal.?:
        _clang_pipeline_owner_v1.quarantined = true
        _ = _unlock_v1()
        return Err("invalid-lifecycle-transition")
    # Complete and consume are one owner transaction. No terminal handle can
    # be dropped between publication and release.
    _clang_pipeline_owner_v1.slots[index].state = terminal.unwrap()
    _clang_pipeline_owner_v1.slots[index].receipt = Some(receipt)
    _release_locked_v1(index)
    if not _unlock_v1():
        return Err("terminal-receipt-consumed-owner-quarantined")
    Ok(receipt)

pub(package) fn clang_filesystem_pipeline_take_terminal_v1(
    handle: ClangFilesystemTerminalHandleV1,
    caller: TaskExecutionInstanceV1
) -> Result<ClangFilesystemTerminalReceiptV1, text>:
    if not _lock_v1(): return Err("serialization-unavailable")
    val index = _reservation_index_locked_v1(
        handle._reservation, ClangFilesystemPipelineStateV1.Terminal)
    if index < 0:
        _ = _unlock_v1()
        return Err("stale-or-nonterminal-receipt")
    val slot = _clang_pipeline_owner_v1.slots[index]
    if slot.request.actor != caller or not slot.receipt.?:
        _ = _unlock_v1()
        return Err("terminal-receipt-actor-mismatch")
    val receipt = slot.receipt.unwrap()
    _release_locked_v1(index)
    if not _unlock_v1(): return Err("committed-unknown")
    Ok(receipt)

pub(package) fn clang_filesystem_pipeline_mark_outcome_unknown_v1(
    dispatch: ClangFilesystemPipelineDispatchV1
) -> Result<bool, text>:
    if not _lock_v1(): return Err("serialization-unavailable")
    var index = _reservation_index_locked_v1(
        dispatch.reservation, ClangFilesystemPipelineStateV1.Dispatched)
    if index < 0:
        index = _reservation_index_locked_v1(
            dispatch.reservation, ClangFilesystemPipelineStateV1.Running)
    if index < 0:
        _ = _unlock_v1()
        return Err("stale-or-nondispatched-reservation")
    if not _dispatch_matches_slot_v1(
        dispatch, _clang_pipeline_owner_v1.slots[index]):
        _ = _unlock_v1()
        return Err("dispatch-content-mismatch")
    # A backend may have mutated either output. Keep their paths unavailable
    # forever in v1 rather than retrying a committed-unknown operation.
    val retired = clang_filesystem_pipeline_transition_v1(
        _clang_pipeline_owner_v1.slots[index].state,
        ClangFilesystemPipelineEventV1.OutcomeUnknown)
    if not retired.?:
        _clang_pipeline_owner_v1.quarantined = true
        _ = _unlock_v1()
        return Err("invalid-lifecycle-transition")
    _clang_pipeline_owner_v1.slots[index].state = retired.unwrap()
    _clang_pipeline_owner_v1.slots[index].nonce = 0u64
    if not _unlock_v1(): return Err("committed-unknown")
    Ok(true)

export ClangFilesystemPipelineEventV1, ClangFilesystemPipelineFilesystemV1
export ClangFilesystemPipelineRequestV1, ClangFilesystemPipelineStateV1
export ClangFilesystemBackendOutcomeV1, ClangFilesystemTerminalReceiptV1
export clang_filesystem_pipeline_request_valid_v1
export clang_filesystem_pipeline_transition_v1
