"""Terminal evidence owner for the authenticated Simple toolchain pipeline.

Scheduler tokens and stable filesystem snapshots are the only inputs accepted
as evidence.  The three scheduler tokens are consumed before validation, so a
caller cannot replay a partially valid pipeline.  Source and artifact content
is read through generation-bound MountTable snapshot leases rather than a
second pathname-only VFS lookup.
"""

use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.structural.digest.hash256.{hash256_hex_valid, hash256_is_zero}
use os.kernel.scheduler.process_execution_observation.{
    SchedulerExecutionEvidenceV1,
    SchedulerArgvFileRoleV1, SchedulerArgvFileBindingV1,
    scheduler_execution_evidence_consume_once_v2
}
use os.kernel.loader.simple_toolchain_filesystem_launch_v1.{
    SimpleToolchainFilesystemLaunchPlanV1,
    SimpleToolchainFilesystemLaunchEvidenceV1
}

pub struct SimpleToolchainExecutableEvidenceV1:
    path: text
    sha256: text
    scheduler_observation_generation: u64
    mount_id: u64
    mount_generation: u64
    file_generation: u64
    stdout_sha256: text
    stderr_sha256: text

pub struct SimpleToolchainFileEvidenceV1:
    path: text
    sha256: text
    mount_id: u64
    mount_generation: u64
    namespace_generation: u64
    file_generation: u64
    size: u64

pub struct SimpleToolchainTerminalReceiptV1:
    """Success-only terminal receipt; failures never manufacture a receipt."""
    parent_task_id: u64
    target_os: text
    target_arch: text
    target_abi: text
    interpreter: SimpleToolchainExecutableEvidenceV1
    compiler: SimpleToolchainExecutableEvidenceV1
    loader: SimpleToolchainExecutableEvidenceV1
    source: SimpleToolchainFileEvidenceV1
    artifact: SimpleToolchainFileEvidenceV1
    interpreter_child_id: u64
    compiler_child_id: u64
    loader_child_id: u64
    succeeded: bool

fn _digest_valid_v1(value: text) -> bool:
    hash256_hex_valid(value) and not hash256_is_zero(value)

fn _text_vector_equal_v1(left: [text], right: [text]) -> bool:
    if left.len() != right.len(): return false
    var i: i64 = 0
    while i < left.len():
        if left[i] != right[i]: return false
        i = i + 1
    true

fn _same_target_v1(
    left: SchedulerExecutionEvidenceV1,
    right: SchedulerExecutionEvidenceV1
) -> bool:
    left.target_os == right.target_os and
        left.target_arch == right.target_arch and
        left.target_abi == right.target_abi

fn _supported_simpleos_target_v1(
    target_os: text,
    target_arch: text,
    target_abi: text
) -> bool:
    if target_os != "simpleos" or target_abi != "simpleos": return false
    target_arch == "x86_64" or target_arch == "x86" or
        target_arch == "aarch64" or target_arch == "arm" or
        target_arch == "riscv64" or target_arch == "riscv32"

fn _stage_valid_v1(
    evidence: SchedulerExecutionEvidenceV1,
    executable_path: text,
    argv: [text],
    parent_id: u64
) -> bool:
    evidence.command_observed and evidence.child_id != 0u64 and
        evidence.parent_id == parent_id and
        evidence.executable_path == executable_path and
        evidence.canonical_source_path == executable_path and
        _text_vector_equal_v1(evidence.argv, argv) and
        evidence.exit_code == 0 and
        not evidence.stdout_truncated and not evidence.stderr_truncated and
        _supported_simpleos_target_v1(
            evidence.target_os, evidence.target_arch, evidence.target_abi) and
        _digest_valid_v1(evidence.image_hash) and
        evidence.mount_id != 0u64 and evidence.mount_generation != 0u64 and
        evidence.file_generation != 0u64

fn _sole_binding_v1(
    evidence: SchedulerExecutionEvidenceV1,
    role: SchedulerArgvFileRoleV1,
    argv_index: i64
) -> SchedulerArgvFileBindingV1?:
    if evidence.argv_file_bindings.len() != 1: return nil
    val binding = evidence.argv_file_bindings[0]
    if binding.role != role or binding.argv_index != argv_index: return nil
    Some(binding)

fn _same_file_binding_v1(
    left: SchedulerArgvFileBindingV1,
    right: SchedulerArgvFileBindingV1
) -> bool:
    left.role == right.role and left.argv_index == right.argv_index and
        left.canonical_path == right.canonical_path and
        left.content_sha256 == right.content_sha256 and
        left.mount_id == right.mount_id and
        left.mount_generation == right.mount_generation and
        left.namespace_generation == right.namespace_generation and
        left.file_generation == right.file_generation and left.size == right.size

fn _file_evidence_v1(
    binding: SchedulerArgvFileBindingV1
) -> SimpleToolchainFileEvidenceV1:
    SimpleToolchainFileEvidenceV1(
        path: binding.canonical_path, sha256: binding.content_sha256,
        mount_id: binding.mount_id,
        mount_generation: binding.mount_generation,
        namespace_generation: binding.namespace_generation,
        file_generation: binding.file_generation, size: binding.size)

fn _executable_evidence_v1(
    evidence: SchedulerExecutionEvidenceV1
) -> SimpleToolchainExecutableEvidenceV1:
    SimpleToolchainExecutableEvidenceV1(
        path: evidence.executable_path, sha256: evidence.image_hash,
        scheduler_observation_generation: evidence.generation,
        mount_id: evidence.mount_id,
        mount_generation: evidence.mount_generation,
        file_generation: evidence.file_generation,
        stdout_sha256: sha256_u8_hex(evidence.stdout_bytes),
        stderr_sha256: sha256_u8_hex(evidence.stderr_bytes))

pub(package) fn simple_toolchain_terminal_receipt_consume_once_v1(
    plan: SimpleToolchainFilesystemLaunchPlanV1,
    tokens: SimpleToolchainFilesystemLaunchEvidenceV1
) -> Result<SimpleToolchainTerminalReceiptV1, text>:
    """Consume all scheduler authority and issue exactly one terminal receipt."""
    val interpreted = scheduler_execution_evidence_consume_once_v2(tokens.interpreter)
    val compiled = scheduler_execution_evidence_consume_once_v2(tokens.compiler)
    val loaded = scheduler_execution_evidence_consume_once_v2(tokens.loader)
    if not interpreted.? or not compiled.? or not loaded.?:
        return Err("simple-toolchain-scheduler-evidence-missing")

    val interpreter = interpreted.unwrap()
    val compiler = compiled.unwrap()
    val loader = loaded.unwrap()
    val parent_id = interpreter.parent_id
    if parent_id == 0u64 or
       not _stage_valid_v1(interpreter, "/sys/apps/simple_interpreter.smf",
           [plan.source_path], parent_id) or
       not _stage_valid_v1(compiler, "/sys/apps/simple_compiler.smf",
           [plan.source_path, "--output", plan.artifact_path], parent_id) or
       not _stage_valid_v1(loader, "/sys/apps/simple_loader.smf",
           [plan.artifact_path], parent_id) or
       not _same_target_v1(interpreter, compiler) or
       not _same_target_v1(interpreter, loader) or
       interpreter.child_id == compiler.child_id or
       interpreter.child_id == loader.child_id or
       compiler.child_id == loader.child_id:
        return Err("simple-toolchain-scheduler-evidence-mismatch")

    val interpreter_source = _sole_binding_v1(
        interpreter, SchedulerArgvFileRoleV1.SourceInput, 0)
    val compiler_source = _sole_binding_v1(
        compiler, SchedulerArgvFileRoleV1.SourceInput, 0)
    val loader_artifact = _sole_binding_v1(
        loader, SchedulerArgvFileRoleV1.ArtifactInput, 0)
    if not interpreter_source.? or not compiler_source.? or not loader_artifact.?:
        return Err("simple-toolchain-argv-file-evidence-missing")
    if not _same_file_binding_v1(
        interpreter_source.unwrap(), compiler_source.unwrap()) or
       interpreter_source.unwrap().canonical_path != plan.source_path or
       loader_artifact.unwrap().canonical_path != plan.artifact_path:
        return Err("simple-toolchain-argv-file-evidence-mismatch")

    Ok(SimpleToolchainTerminalReceiptV1(
        parent_task_id: parent_id,
        target_os: interpreter.target_os, target_arch: interpreter.target_arch,
        target_abi: interpreter.target_abi,
        interpreter: _executable_evidence_v1(interpreter),
        compiler: _executable_evidence_v1(compiler),
        loader: _executable_evidence_v1(loader),
        source: _file_evidence_v1(compiler_source.unwrap()),
        artifact: _file_evidence_v1(loader_artifact.unwrap()),
        interpreter_child_id: interpreter.child_id,
        compiler_child_id: compiler.child_id,
        loader_child_id: loader.child_id, succeeded: true))

export SimpleToolchainExecutableEvidenceV1, SimpleToolchainFileEvidenceV1
export SimpleToolchainTerminalReceiptV1
