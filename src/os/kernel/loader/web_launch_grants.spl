"""Least-authority launch declaration for the dedicated web artifact.

This owner is policy-only.  It does not launch a task, open a socket, mount a
filesystem, or borrow any authority from the legacy `/SERVERS.ELF` image.
"""

use os.kernel.types.capability_types.{
    CapabilityKind, CapabilitySet, CAP_RIGHT_READ, CAP_RIGHT_EXEC
}
use os.kernel.ipc.cspace_spawn.{CapGrant, AttenuationSpec}

pub val SIMPLEOS_WEB_EXECUTABLE_V1: text = "/WEB.ELF"
pub val SIMPLEOS_WEB_STATIC_FILE_V1: text = "/SYS/SERVER.HTM"
pub val SIMPLEOS_WEB_TLS_CERTIFICATE_V1: text = "/SYS/HTTPS.CRT"
pub val SIMPLEOS_WEB_TLS_PRIVATE_KEY_V1: text = "/SYS/HTTPS.PK8"
pub val SIMPLEOS_WEB_HTTP_PORT_V1: u16 = 8080u16
pub val SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1: u32 = 127u32 | (1u32 << 24)
pub const SIMPLEOS_WEB_LAUNCH_POUCH_BUDGET_V1: i64 = 7

pub struct WebLaunchGrantPlanV1:
    executable_identity: text
    bind_ipv4_address: u32
    grants: [CapGrant]

fn _web_attenuation_v1(mask: u32) -> AttenuationSpec:
    AttenuationSpec(
        rights_mask: mask, path_prefix: "", depth_limit: 0,
        single_use: false)

fn _web_grant_v1(label: text, requested: CapabilityKind, mask: u32) -> CapGrant:
    CapGrant(
        label: label, requested: requested,
        atten: _web_attenuation_v1(mask))

fn _web_file_read_grant_v1(label: text, path: text) -> CapGrant:
    _web_grant_v1(
        label, CapabilityKind.FileRead(path_prefix: path), CAP_RIGHT_READ)

pub fn simpleos_web_loopback_address_v1() -> u32:
    """Explicit loopback fixture address; production callers supply an address."""
    127u32 | (1u32 << 24)

pub fn simpleos_web_configured_bind_ipv4_v1() -> u32:
    """Return the non-wildcard address selected for scalar WEB fs-exec.

    A scalar spawn recipe cannot accept a caller-controlled address.  The
    configured value is consequently the one reviewable kernel launch input;
    deployments replace this constant through their image configuration, never
    with address zero at the syscall boundary.
    """
    SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1

fn _web_grant_count_v1(grants: [CapGrant], expected: CapGrant) -> i64:
    var count: i64 = 0
    for grant in grants:
        if grant.label == expected.label and
           grant.requested == expected.requested and
           grant.atten.rights_mask == expected.atten.rights_mask and
           grant.atten.path_prefix == expected.atten.path_prefix and
           grant.atten.depth_limit == expected.atten.depth_limit and
           grant.atten.single_use == expected.atten.single_use:
            count = count + 1
    count

fn _web_expected_grants_v1(bind_ipv4_address: u32) -> [CapGrant]:
    [
        _web_grant_v1(
            "web.exec", CapabilityKind.FileExec(
                path_prefix: SIMPLEOS_WEB_EXECUTABLE_V1), CAP_RIGHT_EXEC),
        _web_file_read_grant_v1(
            "web.static.read", SIMPLEOS_WEB_STATIC_FILE_V1),
        _web_file_read_grant_v1(
            "web.tls.certificate.read", SIMPLEOS_WEB_TLS_CERTIFICATE_V1),
        _web_file_read_grant_v1(
            "web.tls.private-key.read", SIMPLEOS_WEB_TLS_PRIVATE_KEY_V1),
        _web_grant_v1(
            "web.socket.create", CapabilityKind.NetSocketCreate,
            CAP_RIGHT_READ),
        _web_grant_v1(
            "web.bind.ipv4", CapabilityKind.NetBindIpv4(
                address: bind_ipv4_address, port: SIMPLEOS_WEB_HTTP_PORT_V1),
            CAP_RIGHT_READ),
        # Migration marker only.  New bind enforcement uses the exact address
        # grant above; this does not authorize another port or NetConnect.
        _web_grant_v1(
            "web.listen.migration", CapabilityKind.NetListen(
                port: SIMPLEOS_WEB_HTTP_PORT_V1), CAP_RIGHT_READ),
    ]

pub fn web_launch_grant_plan_valid_v1(plan: WebLaunchGrantPlanV1) -> bool:
    """Validate the fixed pouch budget and reject missing/duplicate entries."""
    if plan.executable_identity != SIMPLEOS_WEB_EXECUTABLE_V1 or
       plan.bind_ipv4_address == 0u32 or
       plan.grants.len() != SIMPLEOS_WEB_LAUNCH_POUCH_BUDGET_V1:
        return false
    val expected = _web_expected_grants_v1(plan.bind_ipv4_address)
    for grant in expected:
        if _web_grant_count_v1(plan.grants, grant) != 1:
            return false
    true

pub fn web_launch_grant_plan_v1(
    executable_path: text, bind_ipv4_address: u32
) -> WebLaunchGrantPlanV1:
    """Declare WEB authority for one caller-supplied exact IPv4 address.

    Address zero is the wildcard address and fails closed.  There is no
    production default; tests may explicitly pass simpleos_web_loopback_address_v1().
    """
    var grants: [CapGrant] = []
    if executable_path == SIMPLEOS_WEB_EXECUTABLE_V1 and
       bind_ipv4_address != 0u32:
        grants = _web_expected_grants_v1(bind_ipv4_address)
    WebLaunchGrantPlanV1(
        executable_identity: if grants.len() == 0: "" else: executable_path,
        bind_ipv4_address: if grants.len() == 0: 0u32 else: bind_ipv4_address,
        grants: grants)

pub fn web_launch_grants_v1(
    executable_path: text, bind_ipv4_address: u32
) -> [CapGrant]:
    val plan = web_launch_grant_plan_v1(executable_path, bind_ipv4_address)
    if not web_launch_grant_plan_valid_v1(plan):
        return []
    plan.grants

fn _web_cap_count_v1(caps: CapabilitySet, expected: CapabilityKind) -> i64:
    var count: i64 = 0
    for token in caps.caps:
        if token.kind == expected:
            count = count + 1
    count

pub fn web_launch_caps_exact_v1(
    caps: CapabilitySet, bind_ipv4_address: u32
) -> bool:
    """Validate a minted or owner-rebound WEB pouch without ambient authority."""
    if not caps.is_pledged or bind_ipv4_address == 0u32 or
       caps.caps.len() != SIMPLEOS_WEB_LAUNCH_POUCH_BUDGET_V1:
        return false
    val expected = _web_expected_grants_v1(bind_ipv4_address)
    for grant in expected:
        if _web_cap_count_v1(caps, grant.requested) != 1:
            return false
    true

pub fn web_launch_caps_exact_for_owner_v1(
    caps: CapabilitySet, bind_ipv4_address: u32, owner: u64
) -> bool:
    """Exact WEB pouch check after scheduler binds the child identity."""
    if owner == 0u64 or not web_launch_caps_exact_v1(caps, bind_ipv4_address):
        return false
    for token in caps.caps:
        if token.owner != owner:
            return false
    true
