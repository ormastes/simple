pub fn rv64_authenticated_media_root_matches_pin_v1(
    pinned_key_id: text, pinned_public_key_hex: text, pinned_hash: text,
    media_key_id: text, media_public_key_hex: text, admission_hash: text
) -> bool:
    pinned_key_id != "" and pinned_public_key_hex.len() == 64 and pinned_hash.len() == 64 and
    media_key_id == pinned_key_id and media_public_key_hex == pinned_public_key_hex and
    admission_hash == pinned_hash

pub fn rv64_authenticated_first_mount_id_v1() -> u64: 1u64
pub fn rv64_authenticated_first_mount_generation_v1() -> u64: 1u64
pub fn rv64_authenticated_first_file_id_v1() -> u64: (1u64 << 32) | 1u64
pub fn rv64_authenticated_first_file_generation_v1() -> u64: 1u64

# Writable legacy media has no loader-issued authority token. Keep this
# production admission policy in Pure Simple rather than a foreign scalar
# query so the fail-closed decision is explicit at the caller.
@inline
pub fn rv64_legacy_fs_exec_disabled_v1() -> bool: true

export rv64_authenticated_media_root_matches_pin_v1
export rv64_authenticated_first_mount_id_v1, rv64_authenticated_first_mount_generation_v1
export rv64_authenticated_first_file_id_v1, rv64_authenticated_first_file_generation_v1
export rv64_legacy_fs_exec_disabled_v1
