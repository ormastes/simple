# Root service catalog — trusted policy source for PID1's non-transferable
# RootMintAuthority.
#
# This is deliberately *not* a generic role/path spawn interface.  A caller
# supplies only an opaque catalog ID; the kernel owns the executable path,
# exact child CSpace grants, resource limits, and syscall filter.  The catalog
# is consumed only by the live PID1 reaper holding root_mint_authority, and it
# still routes creation through fs_exec_register_image_with_spawn_spec so there
# is no second CSpace/process creation path.

use os.kernel.types.capability_types.{CapabilitySet, CapabilityToken, CapabilityKind}
use os.kernel.ipc.cspace_spawn.{CapGrant, AttenuationSpec, SpawnSpec}
use os.kernel.loader.workload_image_hash.{workload_image_blake3_hash}
use os.kernel.loader.process_image.{build_user_process_image}
use os.kernel.loader.fs_exec_spawn.{FsExecPrepareResult, fs_exec_register_image_with_spawn_spec}
use os.kernel.loader.executable_source.{resolve_executable_bytes}
use os.kernel.security.execution_context.{KernelCallContext, kernel_call_context_from_task}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.types.task_types.{TaskId, TaskPriority, TaskState, sched_exec_arch}
use os.kernel.arch.arch_context.{Architecture}
use os.kernel.loader.root_device_broker.{RootDeviceLease, root_device_broker_storage_lease, root_device_broker_network_lease}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.lifecycle.task_exit_teardown.{teardown_exited_task_authority}

pub val ROOT_SERVICE_VFS: u64 = 1u64
pub val ROOT_SERVICE_NET: u64 = 2u64
pub val ROOT_SERVICE_HTTP: u64 = 3u64

struct RootServiceCatalogEntry:
    id: u64
    name: text
    executable_path: text
    grants: [CapGrant]
    syscall_filter: [u64]
    process_limit: u64
    memory_pages: u64

pub struct RootServiceCatalogStopResult:
    """Result of an opaque PID1-owned service stop request.

    Scheduler values cross normal Simple call boundaries by value, so the
    caller must adopt this returned scheduler exactly as it does for a catalog
    launch. The returned IPC state carries the authoritative removal of every
    stopped job member's named endpoints and IPC grants. `result` is zero only
    when a live direct child was transitioned to a zombie; it never exposes a
    general-purpose signal capability.
    """
    scheduler: Scheduler
    ipc: IpcManager
    result: i64

fn _atten() -> AttenuationSpec:
    AttenuationSpec(rights_mask: 0u32, path_prefix: "", depth_limit: -1, single_use: false)

fn _grant(label: text, kind: CapabilityKind) -> CapGrant:
    CapGrant(label: label, requested: kind, atten: _atten())

fn _vfs_entry() -> RootServiceCatalogEntry:
    RootServiceCatalogEntry(
        id: ROOT_SERVICE_VFS, name: "vfs", executable_path: "/system/services/vfs.smf",
        grants: [
            _grant("fs.read.root", CapabilityKind.FileRead(path_prefix: "/")),
            _grant("fs.write.root", CapabilityKind.FileWrite(path_prefix: "/")),
            _grant("fs.create.root", CapabilityKind.FileCreate(path_prefix: "/")),
            _grant("ipc.listen.vfs", CapabilityKind.IpcListen(port_name: "vfs"))
        ],
        # Yield is required for every cooperative userspace service.  Do not
        # rely on an implicit scheduler escape hatch: the per-job filter is
        # authoritative after PID1 has sealed ambient spawning.
        # Legacy metadata IPC (20/21) is deliberately absent: VFS receives
        # and replies only through authenticated copied records (132/133).
        syscall_filter: [1u64, 22u64, 132u64, 133u64, 30u64, 31u64, 32u64, 33u64, 34u64, 35u64, 36u64, 39u64, 40u64, 41u64, 42u64],
        process_limit: 8u64, memory_pages: 256u64
    )

fn _net_entry() -> RootServiceCatalogEntry:
    RootServiceCatalogEntry(
        id: ROOT_SERVICE_NET, name: "net", executable_path: "/system/services/net.smf",
        grants: [
            _grant("net.raw", CapabilityKind.NetRaw),
            _grant("ipc.listen.net", CapabilityKind.IpcListen(port_name: "net")),
            _grant("ipc.connect.vfs", CapabilityKind.IpcConnect(port_name: "vfs"))
        ],
        # Netstack uses named discovery plus owned copied IPC, never the
        # metadata-only 20/21 ABI.
        syscall_filter: [1u64, 22u64, 23u64, 132u64, 133u64, 60u64, 61u64, 62u64, 63u64, 64u64, 65u64, 66u64],
        process_limit: 8u64, memory_pages: 256u64
    )

fn _http_entry() -> RootServiceCatalogEntry:
    RootServiceCatalogEntry(
        id: ROOT_SERVICE_HTTP, name: "http", executable_path: "/system/services/http.smf",
        grants: [
            _grant("net.listen.http", CapabilityKind.NetListen(port: 80u16)),
            _grant("ipc.listen.http", CapabilityKind.IpcListen(port_name: "http")),
            _grant("ipc.connect.net", CapabilityKind.IpcConnect(port_name: "net"))
        ],
        syscall_filter: [1u64, 22u64, 23u64, 132u64, 133u64, 60u64, 61u64, 62u64, 63u64, 64u64, 65u64, 66u64],
        process_limit: 4u64, memory_pages: 128u64
    )

fn _with_device_lease(entry_in: RootServiceCatalogEntry, lease: RootDeviceLease) -> RootServiceCatalogEntry:
    """Attach only the exact device authority selected by kernel policy."""
    var entry = entry_in
    var grants = entry.grants
    grants.push(_grant("device.grant", CapabilityKind.DeviceGrant(
        bdf_bus: lease.bdf_bus, bdf_device: lease.bdf_device, bdf_func: lease.bdf_func
    )))
    grants.push(_grant("device.bar0", CapabilityKind.DeviceBarMap(
        bdf_bus: lease.bdf_bus, bdf_device: lease.bdf_device,
        bdf_func: lease.bdf_func, bar_index: lease.bar_index
    )))
    # Modern virtio-pci exposes its capability windows in a memory BAR (QEMU
    # virtio-net uses BAR4). This remains an exact BDF/BAR capability; it is
    # not a grant to map caller-supplied physical memory.
    if entry.name == "net":
        grants.push(_grant("device.virtio-modern-bar4", CapabilityKind.DeviceBarMap(
            bdf_bus: lease.bdf_bus, bdf_device: lease.bdf_device,
            bdf_func: lease.bdf_func, bar_index: 4u8
        )))
    grants.push(_grant("device.dma", CapabilityKind.DeviceDma(
        bdf_bus: lease.bdf_bus, bdf_device: lease.bdf_device,
        bdf_func: lease.bdf_func, max_bytes: lease.dma_max_bytes
    )))
    grants.push(_grant("device.iommu", CapabilityKind.IommuDomain(
        domain_id: lease.iommu_domain_id
    )))
    entry.grants = grants
    var filter = entry.syscall_filter
    # DeviceGrant, MapBar, DMA allocate/free/sync plus IRQ notification wait.
    filter.push(26u64)
    filter.push(82u64)
    filter.push(83u64)
    filter.push(84u64)
    filter.push(85u64)
    filter.push(86u64)
    filter.push(87u64)
    if entry.name == "net":
        filter.push(88u64)
    entry.syscall_filter = filter
    entry

fn _entry_for_live_catalog_launch(id: u64) -> RootServiceCatalogEntry?:
    """Build the runtime entry after trusted PID1 authorization succeeds."""
    if id == ROOT_SERVICE_VFS:
        val lease = root_device_broker_storage_lease()
        if lease == nil:
            return nil
        return Some(_with_device_lease(_vfs_entry(), lease.unwrap()))
    if id == ROOT_SERVICE_NET:
        val lease = root_device_broker_network_lease()
        if lease == nil:
            return nil
        return Some(_with_device_lease(_net_entry(), lease.unwrap()))
    if id == ROOT_SERVICE_HTTP:
        return Some(_http_entry())
    nil

pub fn root_service_catalog_lookup(id: u64) -> RootServiceCatalogEntry?:
    if id == ROOT_SERVICE_VFS:
        return Some(_vfs_entry())
    if id == ROOT_SERVICE_NET:
        return Some(_net_entry())
    if id == ROOT_SERVICE_HTTP:
        return Some(_http_entry())
    nil

fn _root_token(kind: CapabilityKind, owner: u64, token_id: u64) -> CapabilityToken:
    CapabilityToken(
        kind: kind, generation: 1u64, owner: owner, token_id: token_id,
        parent_token_id: 0u64, depth: 2
    )

fn _mint_parent_cspace(entry: RootServiceCatalogEntry, owner: u64) -> CapabilitySet:
    """Materialize the root object's exact delegation sources for one launch.

    These tokens are transient inputs to the existing CSpace mint operation;
    they never become PID1's ordinary CSpace and therefore cannot be read,
    transferred, or re-used by a compromised PID1 payload.
    """
    var caps: [CapabilityToken] = []
    caps.push(_root_token(CapabilityKind.ProcessSpawn, owner, 1u64))
    var token_id = 2u64
    for grant in entry.grants:
        caps.push(_root_token(grant.requested, owner, token_id))
        token_id = token_id + 1u64
    CapabilitySet(caps: caps, is_pledged: true)

fn _root_mint_context(task_id: TaskId, entry: RootServiceCatalogEntry, scheduler: Scheduler) -> KernelCallContext?:
    if not scheduler.has_root_mint_authority(task_id):
        return nil
    if scheduler.get_current().id != task_id.id:
        return nil
    val task = scheduler.get_task(task_id)
    if task == nil:
        return nil
    var context = kernel_call_context_from_task(task)
    context.capabilities = _mint_parent_cspace(entry, task_id.id)
    Some(context)

fn _bind_catalog_limits(
    entry: RootServiceCatalogEntry,
    prepared: FsExecPrepareResult
) -> FsExecPrepareResult:
    if prepared.pid <= 0:
        return prepared
    var scheduler = prepared.scheduler
    val child = TaskId(id: prepared.pid as u64)
    if not scheduler.bind_managed_child_resource_limits(
        child, entry.process_limit, entry.memory_pages
    ):
        scheduler.exit_task_by_id(child, -125)
        return FsExecPrepareResult(scheduler: scheduler, pid: -12, entry: 0)
    if not scheduler.bind_managed_child_syscall_filter(child, entry.syscall_filter):
        scheduler.exit_task_by_id(child, -125)
        return FsExecPrepareResult(scheduler: scheduler, pid: -12, entry: 0)
    if not scheduler.bind_filesystem_view(child, "/"):
        scheduler.exit_task_by_id(child, -125)
        return FsExecPrepareResult(scheduler: scheduler, pid: -12, entry: 0)
    # This is a kernel-owned catalog identity, set before the child can run.
    # Its exit teardown therefore never attributes a service using user input.
    if not scheduler.set_task_name(child, entry.name):
        scheduler.exit_task_by_id(child, -125)
        return FsExecPrepareResult(scheduler: scheduler, pid: -12, entry: 0)
    FsExecPrepareResult(scheduler: scheduler, pid: prepared.pid, entry: prepared.entry)

pub fn root_service_catalog_launch_from_bytes(
    catalog_id: u64,
    bytes: [u8],
    arch: Architecture,
    priority: TaskPriority,
    scheduler: Scheduler
) -> FsExecPrepareResult:
    """Launch one catalog entry from verified bytes under live PID1 authority."""
    val entry = root_service_catalog_lookup(catalog_id)
    if entry == nil:
        return FsExecPrepareResult(scheduler: scheduler, pid: -2, entry: 0)
    val task_id = scheduler.get_current()
    val definition = entry.unwrap()
    _root_service_catalog_launch_entry_from_bytes(definition, bytes, arch, priority, scheduler)

fn _root_service_catalog_launch_entry_from_bytes(
    definition: RootServiceCatalogEntry,
    bytes: [u8],
    arch: Architecture,
    priority: TaskPriority,
    scheduler: Scheduler
) -> FsExecPrepareResult:
    """Shared launch path after a static or broker-enriched entry is chosen."""
    val task_id = scheduler.get_current()
    val context = _root_mint_context(task_id, definition, scheduler)
    if context == nil:
        return FsExecPrepareResult(scheduler: scheduler, pid: -13, entry: 0)
    val image = build_user_process_image(definition.executable_path, bytes, arch, [definition.executable_path], [])
    if image.is_err():
        return FsExecPrepareResult(scheduler: scheduler, pid: -8, entry: 0)
    val spec = SpawnSpec(
        image_hash: workload_image_blake3_hash(bytes), grants: definition.grants,
        isolation: "service:" + definition.name, budget: definition.process_limit
    )
    _bind_catalog_limits(
        definition,
        fs_exec_register_image_with_spawn_spec(
            context.unwrap(), spec, definition.executable_path, image.unwrap(), priority, scheduler
        )
    )

pub fn root_service_catalog_launch(
    catalog_id: u64,
    priority: TaskPriority,
    scheduler: Scheduler
) -> FsExecPrepareResult:
    """Resolve the catalog-owned executable path and launch it under PID1."""
    val static_entry = root_service_catalog_lookup(catalog_id)
    if static_entry == nil:
        return FsExecPrepareResult(scheduler: scheduler, pid: -2, entry: 0)
    # Fail before touching the executable source. A non-PID1 process must not
    # turn this operation into a filesystem existence/timing oracle.
    if _root_mint_context(scheduler.get_current(), static_entry.unwrap(), scheduler) == nil:
        return FsExecPrepareResult(scheduler: scheduler, pid: -13, entry: 0)
    # Resolve the fixed image before consulting a device broker. An absent or
    # unreadable service image must fail without a PCI policy scan, lease
    # lookup, or construction of a hardware-grant request.
    val arch = sched_exec_arch()
    val bytes = resolve_executable_bytes(static_entry.unwrap().executable_path, arch)
    if bytes.is_err():
        return FsExecPrepareResult(scheduler: scheduler, pid: -2, entry: 0)
    # Only the authorized PID1 caller with a present fixed image may cause the
    # trusted device-policy scan. A missing matching device remains a normal
    # boot/service failure, never a permissive launch with generic hardware
    # authority.
    val entry = _entry_for_live_catalog_launch(catalog_id)
    if entry == nil:
        return FsExecPrepareResult(scheduler: scheduler, pid: -19, entry: 0)
    val definition = entry.unwrap()
    _root_service_catalog_launch_entry_from_bytes(
        definition, bytes.unwrap(), arch, priority, scheduler)

pub fn root_service_catalog_stop(
    target_pid: u64,
    exit_code: i32,
    scheduler: Scheduler,
    ipc: IpcManager
) -> RootServiceCatalogStopResult:
    """Stop only a live direct child of the active root-mint PID1.

    This ABI deliberately accepts a PID only after the kernel proves all of
    the following: the caller owns the non-transferable RootMintAuthority, is
    the current task, and the target is its live direct child.  It is not a
    general signal interface and cannot cross a parent boundary or target
    PID1 itself. The scheduler revokes the job's CSpace lineage before it
    publishes zombie state. This wrapper then uses the authoritative exiting-
    task teardown for every job member, clearing device/DMA/IPC/FAT32/memory
    authority before the stopped service can be restarted; ordinary waitpid
    is still the sole reaping operation.
    """
    if target_pid == 0u64:
        return RootServiceCatalogStopResult(scheduler: scheduler, ipc: ipc, result: -22)
    val caller = scheduler.get_current()
    if target_pid == caller.id:
        return RootServiceCatalogStopResult(scheduler: scheduler, ipc: ipc, result: -1)
    if not scheduler.has_root_mint_authority(caller):
        return RootServiceCatalogStopResult(scheduler: scheduler, ipc: ipc, result: -1)
    val target = TaskId(id: target_pid)
    val child = scheduler.get_task(target)
    if child == nil:
        return RootServiceCatalogStopResult(scheduler: scheduler, ipc: ipc, result: -3)
    val task = child.unwrap()
    if task.state == TaskState.Zombie:
        return RootServiceCatalogStopResult(scheduler: scheduler, ipc: ipc, result: -10)
    if task.parent == nil or task.parent.unwrap().id != caller.id:
        return RootServiceCatalogStopResult(scheduler: scheduler, ipc: ipc, result: -1)
    var live_scheduler = scheduler
    val members = live_scheduler.terminate_direct_child_job(caller, target, exit_code)
    if members.len() == 0:
        # The scheduler repeats the authorization and direct-child checks so
        # no stale snapshot can turn this ABI into a best-effort kill.
        return RootServiceCatalogStopResult(scheduler: scheduler, ipc: ipc, result: -1)
    var cleaned_ipc = ipc
    for member in members:
        cleaned_ipc = teardown_exited_task_authority(member, cleaned_ipc)
    RootServiceCatalogStopResult(scheduler: live_scheduler, ipc: cleaned_ipc, result: 0)
