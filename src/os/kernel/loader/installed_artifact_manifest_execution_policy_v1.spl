"""Fail-closed installed-artifact manifest policy before source I/O.

This module is metadata-only.  It neither opens a VFS object nor issues loader
authority.  The active architecture, the sealed catalog snapshot, and the
canonical load-consumer shape are joined here so path lookup cannot bypass the
signed manifest's executable intent.
"""

use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestTarget, ManifestResourceLimits, SimpleArtifactManifest,
    simple_artifact_manifest_bounds_validate_v1
}
use os.kernel.arch.arch_context.{Architecture}
use os.kernel.arch.mod.{get_arch}
use os.kernel.loader.artifact_manifest.{
    manifest_format_version, manifest_kind_elf,
    manifest_elf_abi_features_match_target, manifest_validate_for_target
}
use os.kernel.loader.executable_target_dispatch_v1.{
    executable_target_process_image_ready_v1
}
use os.kernel.loader.installed_artifact_catalog_v1.{
    InstalledArtifactRecordV1, installed_artifact_catalog_lookup_target_v1
}
use os.kernel.loader.executable_load_plan_v1.{
    ExecutableLoadConsumerV1, executable_load_consumer_new_v1
}

pub enum InstalledArtifactManifestPolicyErrorV1:
    None
    UnsupportedPlatform
    CatalogMiss
    CatalogTrustBindingDenied
    BoundsInvalid
    FormatVersionDenied
    ArtifactKindDenied
    TargetDenied
    CapabilityDenied
    AbiFeatureDenied
    ServicePolicyUnavailable
    ResourcePolicyUnavailable
    LaunchMetadataPolicyUnavailable

pub struct InstalledArtifactManifestPolicyCheckV1:
    ok: bool
    error: InstalledArtifactManifestPolicyErrorV1

pub struct InstalledArtifactElfLoadPlanV1:
    record: InstalledArtifactRecordV1
    consumer: ExecutableLoadConsumerV1
    resource_limits: ManifestResourceLimits

fn _policy_result_v1(
    ok: bool,
    error: InstalledArtifactManifestPolicyErrorV1
) -> InstalledArtifactManifestPolicyCheckV1:
    InstalledArtifactManifestPolicyCheckV1(ok: ok, error: error)

pub fn installed_artifact_active_target_v1() -> ManifestTarget?:
    val arch = match get_arch():
        case Architecture.X86_64: "x86_64"
        case Architecture.X86: "x86"
        case Architecture.Arm64: "aarch64"
        case Architecture.Arm32: "arm"
        case Architecture.Riscv64: "riscv64"
        case Architecture.Riscv32: "riscv32"
        case _: ""
    if arch == "": return nil
    Some(ManifestTarget(os: "simpleos", arch: arch, abi: "simpleos"))

fn _policy_target_equal_v1(a: ManifestTarget, b: ManifestTarget) -> bool:
    a.os == b.os and a.arch == b.arch and a.abi == b.abi

fn _policy_lower_hex_v1(value: text, size: i64) -> bool:
    if value.len() != size: return false
    for ch in value:
        if not ((ch >= '0' and ch <= '9') or (ch >= 'a' and ch <= 'f')):
            return false
    true

fn _policy_catalog_trust_shape_v1(record: InstalledArtifactRecordV1) -> bool:
    val envelope = record.detached_signature.split(":")
    record.signature_scheme == "ed25519" and
        record.manifest.signature == record.detached_signature and
        envelope.len() == 3 and envelope[0] == "ed25519" and
        envelope[1] == record.signer_identity and
        _policy_lower_hex_v1(envelope[2], 128)

pub fn installed_artifact_trust_binding_check_v1(
    record: InstalledArtifactRecordV1,
    input_manifest_signature: text,
    proof_signer_identity: text,
    admission_trust_root_sha256: text
) -> bool:
    """Bind the boot-authenticated row to the per-open trust context.

    Catalog and per-open signatures have different canonical bodies, but both
    must resolve to the same retained key identity and public-key digest.
    """
    _policy_catalog_trust_shape_v1(record) and
        input_manifest_signature == record.detached_signature and
        proof_signer_identity == record.signer_identity and
        admission_trust_root_sha256 == record.expected_trust_root_sha256

fn _policy_abi_features_admitted_v1(
    manifest: SimpleArtifactManifest,
    target: ManifestTarget
) -> bool:
    # The target's process-image owner proves exactly one ELF class plus W^X.
    # Unknown, duplicate, or absent requirements fail closed rather than being
    # silently treated as compatible.
    # The shared scalar matcher avoids allocating/copying the builder's
    # two-element feature array on every launch.
    manifest_elf_abi_features_match_target(
        manifest.required_abi_features, target)

fn _policy_resources_admitted_v1(limits: ManifestResourceLimits) -> bool:
    if limits.max_memory_bytes < 0 or limits.max_open_handles < 0 or
        limits.max_threads < 0 or limits.cpu_budget_us < 0:
        return false
    # No canonical transaction currently carries non-zero signed limits into
    # both the scheduler and descriptor owner.  Accepting one here would lose
    # signed intent after authority issue, so compatibility remains fail-closed.
    limits.max_memory_bytes == 0 and limits.max_open_handles == 0 and
        limits.max_threads == 0 and limits.cpu_budget_us == 0

pub fn installed_artifact_manifest_policy_check_for_target_v1(
    manifest: SimpleArtifactManifest,
    target: ManifestTarget,
    child_capabilities: u32
) -> InstalledArtifactManifestPolicyCheckV1:
    if not simple_artifact_manifest_bounds_validate_v1(manifest).ok:
        return _policy_result_v1(false, InstalledArtifactManifestPolicyErrorV1.BoundsInvalid)
    if manifest.format_version != manifest_format_version():
        return _policy_result_v1(false, InstalledArtifactManifestPolicyErrorV1.FormatVersionDenied)
    if manifest.artifact_kind != manifest_kind_elf():
        return _policy_result_v1(false, InstalledArtifactManifestPolicyErrorV1.ArtifactKindDenied)
    if (not _policy_target_equal_v1(manifest.target, target) or
        not executable_target_process_image_ready_v1(target)):
        return _policy_result_v1(false, InstalledArtifactManifestPolicyErrorV1.TargetDenied)
    if not _policy_abi_features_admitted_v1(manifest, target):
        return _policy_result_v1(false, InstalledArtifactManifestPolicyErrorV1.AbiFeatureDenied)
    if not manifest_validate_for_target(manifest, target).ok:
        return _policy_result_v1(false, InstalledArtifactManifestPolicyErrorV1.TargetDenied)
    if (manifest.required_capabilities & child_capabilities) !=
        manifest.required_capabilities:
        return _policy_result_v1(false, InstalledArtifactManifestPolicyErrorV1.CapabilityDenied)
    if manifest.required_services.len() != 0:
        return _policy_result_v1(false, InstalledArtifactManifestPolicyErrorV1.ServicePolicyUnavailable)
    if not _policy_resources_admitted_v1(manifest.resource_limits):
        return _policy_result_v1(false, InstalledArtifactManifestPolicyErrorV1.ResourcePolicyUnavailable)
    # These signed fields require downstream namespace/library/argument/preload
    # owners.  The ELF-only catalog bridge does not yet carry those owners, so
    # accepting nonempty intent would silently discard it.
    if manifest.namespace_template != "" or
        manifest.native_libraries.len() != 0 or
        manifest.smf_libraries.len() != 0 or
        manifest.interpreter != "" or
        manifest.argument_schema.len() != 0 or
        manifest.startup_preloads.len() != 0:
        return _policy_result_v1(
            false, InstalledArtifactManifestPolicyErrorV1.LaunchMetadataPolicyUnavailable)
    _policy_result_v1(true, InstalledArtifactManifestPolicyErrorV1.None)

pub fn installed_artifact_manifest_policy_check_active_v1(
    manifest: SimpleArtifactManifest,
    child_capabilities: u32
) -> InstalledArtifactManifestPolicyCheckV1:
    val target = installed_artifact_active_target_v1()
    if not target.?:
        return _policy_result_v1(false, InstalledArtifactManifestPolicyErrorV1.UnsupportedPlatform)
    installed_artifact_manifest_policy_check_for_target_v1(
        manifest, target.unwrap(), child_capabilities)

pub(package) fn installed_artifact_catalog_elf_load_plan_v1(
    path: text,
    child_capabilities: u32
) -> Result<InstalledArtifactElfLoadPlanV1, InstalledArtifactManifestPolicyErrorV1>:
    """Join a sealed catalog row to a load plan without opening its path."""
    val target = installed_artifact_active_target_v1()
    if not target.?:
        return Err(InstalledArtifactManifestPolicyErrorV1.UnsupportedPlatform)
    val active_target = target.unwrap()
    val record = installed_artifact_catalog_lookup_target_v1(path, active_target)
    if not record.?: return Err(InstalledArtifactManifestPolicyErrorV1.CatalogMiss)
    val owned = record.unwrap()
    if not _policy_catalog_trust_shape_v1(owned):
        return Err(InstalledArtifactManifestPolicyErrorV1.CatalogTrustBindingDenied)
    val checked = installed_artifact_manifest_policy_check_for_target_v1(
        owned.manifest, active_target, child_capabilities)
    if not checked.ok: return Err(checked.error)
    Ok(InstalledArtifactElfLoadPlanV1(
        record: owned,
        consumer: executable_load_consumer_new_v1(
            active_target.os, active_target.arch, active_target.abi),
        resource_limits: owned.manifest.resource_limits))

export InstalledArtifactManifestPolicyErrorV1
export InstalledArtifactManifestPolicyCheckV1
export InstalledArtifactElfLoadPlanV1
export installed_artifact_active_target_v1
export installed_artifact_manifest_policy_check_for_target_v1
export installed_artifact_manifest_policy_check_active_v1
export installed_artifact_trust_binding_check_v1
