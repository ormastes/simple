@cfg(riscv64)
pub(package) fn authenticated_fs_exec_submit_v1(
    scheduler: Scheduler,
    mut table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
    caller_caps: CapabilitySet,
    path: text,
    argv: [text]
) -> AuthenticatedFsExecSubmissionResultV1:
    val result = riscv64_fs_exec_spawn_authenticated_capture_with_launch_v1(
        scheduler, table, submission.authorities, submission.token,
        submission.consumer, submission.entry_point, submission.caller, caller_caps,
        path, argv, [], submission.recipe)
    _retire_failed_submission_v1(
        table, submission,
        FsExecAuthenticatedRunResultV1(
            exit_code: result.exit_code, evidence: result.evidence,
            scheduler: result.scheduler))

