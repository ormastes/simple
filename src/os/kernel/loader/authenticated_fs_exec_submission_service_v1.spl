"""Authenticated filesystem-exec submission adapter.

This service transports loader-issued authority into the existing architecture
handoff, exit, reap, and scheduler-evidence path.  It cannot open an executable,
mint authority, reconstruct a token from a pathname, or use the legacy -13
path-only facade.
"""

use std.fs_driver.mount_table.{MountTable, ExecutePathOpenV1}
use std.fs_driver.types.{ExecuteTrust}
use std.common.contracts.execution.simpleos_executable_admission_v1.{
    ExecutableAdmissionV1
}
use os.kernel.loader.executable_authority_registry.{
    ExecutableAuthorityRegistryV1, ExecutableAuthorityTokenV1,
    executable_authority_loader_owner, executable_authority_owner_valid
}
use os.kernel.loader.executable_load_plan_v1.{ExecutableLoadConsumerV1}
use os.kernel.loader.fs_exec_spawn.{FsExecAuthenticatedRunResultV1}
use os.kernel.loader.executable_admission_pipeline.{
    ExecutableLoaderAdmissionErrorV1, ExecutableLoaderVerificationInputsV1,
    ExecutableLoaderCryptographicProofV1,
    executable_loader_admit_authenticated_open_binding_v1,
    executable_loader_admit_installed_artifact_open_binding_v1,
    executable_loader_revoke
}
use os.kernel.loader.installed_artifact_manifest_execution_policy_v1.{
    installed_artifact_active_target_v1,
    installed_artifact_catalog_elf_load_plan_v1,
    installed_artifact_trust_binding_check_v1
}
use os.kernel.loader.installed_artifact_catalog_v1.{
    installed_artifact_catalog_lookup_target_v1
}
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.loader.executable_online_reattestation_owner_v1.{
    EXECUTABLE_ONLINE_REATTESTATION_LIMIT_V1,
    executable_online_reattest_open_binding_v1
}
use os.kernel.scheduler.scheduler_types.{Scheduler}
use os.kernel.scheduler.scheduler_capability_snapshot_lease_v1.{
    SchedulerCurrentExecutionSnapshotV1,
    SchedulerCapabilitySnapshotLeaseV1,
    scheduler_current_execution_snapshot_task_id_v1,
    scheduler_current_execution_snapshot_lifecycle_generation_v1,
    scheduler_current_execution_snapshot_exec_generation_v1,
    scheduler_current_execution_snapshot_admitted_v1,
    scheduler_current_execution_snapshot_lease_v1,
    scheduler_capability_snapshot_validate_v1,
    scheduler_capability_snapshot_consume_once_v1,
    scheduler_capability_snapshot_retire_v1,
    scheduler_pinned_capability_snapshot_caps_v1
}
use os.kernel.loader.cap_exec_gate.{exec_cap_check_caps}
use os.kernel.types.capability_types.{CapabilitySet}
use os.kernel.scheduler.process_execution_observation.{
    SchedulerExecutionEvidenceTokenV1,
    scheduler_execution_attach_argv_file_bindings_v1,
    scheduler_execution_evidence_consume_once_v2
}
use os.kernel.loader.authenticated_argv_file_binding_owner_v1.{
    AuthenticatedArgvFileLeaseV1,
    authenticated_argv_file_binding_finish_v1
}
use os.kernel.loader.executable_launch_arguments_v1.{
    EXECUTABLE_LAUNCH_ARGUMENTS_V1_MAX_ARGV,
    executable_launch_arguments_v1_errno,
    executable_launch_arguments_v1_validate
}
use os.kernel.loader.spawn_recipes.{
    SPAWN_RECIPE_SSH_REMOTE_COMMAND,
    spawn_recipe_exec_prefix, spawn_recipe_is_migrated,
    spawn_recipe_launch_contract_valid
}
use std.fs_driver.error.{errno_of}
use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}
use os.services.vfs.vfs_boot_state.{
    VfsMountTableOwnerHandleV1,
    vfs_state_mount_table_owner_handle_v1,
    vfs_state_mount_table_owner_handle_is_live_v1,
    vfs_state_mount_table_owner_handles_same_live_v1,
    vfs_state_mount_table_lease_begin_v1,
    vfs_state_mount_table_lease_restore_v1
}

pub(package) const AUTHENTICATED_FS_EXEC_USER_SLOT_LIMIT_V1: i64 = 128

pub(package) enum AuthenticatedFsExecUserSlotStateV1:
    Armed
    Consuming
    Retired

pub(package) struct AuthenticatedFsExecUserSlotV1:
    generation: u64
    caller: i64
    canonical_path: text
    recipe: i64
    state: AuthenticatedFsExecUserSlotStateV1
    submission: AuthenticatedFsExecSubmissionV1

pub(package) struct AuthenticatedFsExecUserReservationV1:
    slot_index: i64
    generation: u64
    submission: AuthenticatedFsExecSubmissionV1

pub(package) struct AuthenticatedFsExecOnlineBatchResultV1:
    ok: bool
    armed_count: i64
    reason: text

pub(package) class AuthenticatedFsExecUserServiceV1:
    """Bounded loader-owned one-shot ingress for unprivileged path+argv requests.

    Userland never receives an authority registry, token, load consumer, or
    entry point.  A privileged loader owner arms an exact caller/path/recipe
    tuple after catalog admission; the public-facing request can only consume
    that tuple once. Slots are not recycled in v1, which makes stale request
    coordinates harmless and bounds retained authority. The checked-mutex
    capsule below is the sole mutable owner. A blocking handoff receives the
    canonical VFS owner's epoch-and-nonce-bound unique table lease plus a
    generational `Consuming` reservation; it never shares this service value
    between syscall execution domains.

    `AuthenticatedFsExecSubmissionV1` is a value-semantic bundle of opaque
    registry coordinates, not the mutable authority itself.  The loader
    registry remains the single state owner and atomically rejects duplicate
    token consumption.  This service additionally avoids copying a complete
    slot during submit and moves its owner-visible lifecycle to `Consuming`
    before passing those coordinates to the registry-backed handoff.

    `arm_installed_artifact_from_boot_proof_v1` is the boot/loader initializer:
    it joins a sealed catalog record to an already signed per-open admission,
    verifies the bytes and ELF layout through the canonical admission pipeline,
    and retains only the resulting one-shot authority. The tagged syscall
    caller below can consume it only after this privileged initialization.
    """
    slots: [AuthenticatedFsExecUserSlotV1]
    next_generation: u64

    static fn new() -> AuthenticatedFsExecUserServiceV1:
        AuthenticatedFsExecUserServiceV1(slots: [], next_generation: 1u64)

    me arm(
        caller: i64,
        canonical_path: text,
        recipe: i64,
        submission: AuthenticatedFsExecSubmissionV1
    ) -> i64:
        if self.slots.len() >= AUTHENTICATED_FS_EXEC_USER_SLOT_LIMIT_V1 or
            self.next_generation == 0u64 or
            self.next_generation == 0xffffffffffffffffu64:
            return -28
        # Arming is loader-only, but still reject malformed or policy-mismatched
        # coordinates before retaining a live one-shot token.
        val launch = executable_launch_arguments_v1_validate(
            canonical_path, [canonical_path], [])
        if launch.is_err():
            return executable_launch_arguments_v1_errno(launch.unwrap_err())
        val exec_prefix = spawn_recipe_exec_prefix(recipe)
        if not spawn_recipe_is_migrated(recipe) or
            not executable_authority_owner_valid(submission.authorities) or
            submission.entry_point == 0u64 or
            submission.caller != caller or submission.recipe != recipe or
            exec_prefix == "" or not canonical_path.starts_with(exec_prefix) or
            not spawn_recipe_launch_contract_valid(
                recipe, canonical_path, [canonical_path], []):
            return -13
        # Multiple slots for one tuple are intentional: xargs-style batches
        # need one distinct open-bound authority per execution. reserve()
        # consumes the first Armed generation, and the registry independently
        # enforces that every retained token is one-shot.
        val generation = self.next_generation
        self.next_generation = self.next_generation + 1u64
        self.slots.push(AuthenticatedFsExecUserSlotV1(
            generation: generation,
            caller: caller,
            canonical_path: canonical_path,
            recipe: recipe,
            state: AuthenticatedFsExecUserSlotStateV1.Armed,
            submission: submission))
        generation as i64

    me arm_installed_artifact_from_boot_proof_v1(
        mut table: MountTable,
        authorities: ExecutableAuthorityRegistryV1,
        caller: i64,
        canonical_path: text,
        recipe: i64,
        admission: ExecutableAdmissionV1,
        proof: ExecutableLoaderCryptographicProofV1
    ) -> i64:
        """Pre-admit and arm one catalog artifact from complete signed material.

        The sealed catalog supplies the boot-verified manifest, content digest,
        target, signer identity, and trust-root identity.  `admission` and
        `proof` are the distinct signed per-open domain; the canonical loader
        verifier binds them to the exact VFS open generations and recomputes
        the image digest, manifest identity, and ELF layout before minting.
        Neither a pathname nor a catalog lookup alone can arm a slot.
        """
        if caller < 0 or not executable_authority_owner_valid(authorities):
            return -13
        val target = installed_artifact_active_target_v1()
        if not target.?: return -8
        val record = installed_artifact_catalog_lookup_target_v1(
            canonical_path, target.unwrap())
        if not record.?: return -13
        val installed = record.unwrap()
        if (installed.content_sha256 != admission.image_hash or
            installed.expected_trust_root_sha256 != admission.trust_root_hash or
            installed.signer_identity != proof.signer_key_id or
            installed.target.os != admission.target.os or
            installed.target.arch != admission.target.arch or
            installed.target.abi != admission.target.abi):
            return -13
        val opened = table.open_for_execute(canonical_path, ExecuteTrust.Trusted)
        if opened.is_err(): return -13
        val binding = opened.unwrap()
        val inputs = ExecutableLoaderVerificationInputsV1(
            manifest: installed.manifest,
            manifest_hash: admission.manifest_hash,
            image_hash: installed.content_sha256,
            trust_root_hash: installed.expected_trust_root_sha256,
            target: installed.target,
            format: installed.manifest.artifact_kind,
            role: "installed-main-image",
            verified_load_ranges: [],
            manifest_verified: true,
            signature_verified: true,
            trust_root_verified: true,
            target_verified: true,
            format_verified: true,
            ranges_verified: true,
            image_digest_verified: true)
        val admitted = executable_loader_admit_installed_artifact_open_binding_v1(
            table, authorities, binding, inputs, admission, proof)
        if admitted.is_err(): return -13
        val prepared = admitted.unwrap()
        val submission = AuthenticatedFsExecSubmissionV1(
            authorities: authorities,
            token: prepared.admission.authority_token,
            consumer: prepared.consumer,
            entry_point: prepared.admission.entry_point,
            caller: caller,
            recipe: recipe)
        val armed = self.arm(caller, canonical_path, recipe, submission)
        if armed < 0:
            # Admission owns the still-open execute binding through the token.
            # A failed bounded-slot commit must retire that authority rather
            # than leak it or leave a second caller able to consume it.
            if executable_loader_revoke(
                table, authorities, prepared.admission.authority_token).is_err():
                return -5
        armed

    me arm_installed_artifact_online_v1(
        mut table: MountTable,
        authorities: ExecutableAuthorityRegistryV1,
        caller: i64,
        canonical_path: text,
        recipe: i64
    ) -> i64:
        """Open, re-attest, admit, and retain one fresh one-shot authority.

        File-handle coordinates are learned only from this live open. The
        loader-private signer binds those exact coordinates, after which the
        ordinary admission pipeline independently checks them and owns close.
        """
        val prepared = authenticated_fs_exec_prepare_installed_artifact_online_v1(
            table, authorities, caller, canonical_path, recipe)
        if prepared.is_err(): return prepared.unwrap_err()
        val submission = prepared.unwrap()
        val armed = self.arm(caller, canonical_path, recipe, submission)
        if armed < 0:
            if executable_loader_revoke(
                table, authorities, submission.token).is_err():
                return -5
        armed

    me reserve(
        caller: i64,
        canonical_path: text,
        argv: [text],
        recipe: i64
    ) -> Result<AuthenticatedFsExecUserReservationV1, i64>:
        # Validate and copy all user-controlled launch strings before changing
        # slot state, so malformed argv cannot burn loader authority.
        val checked = executable_launch_arguments_v1_validate(
            canonical_path, argv, [])
        if checked.is_err():
            return Err(executable_launch_arguments_v1_errno(
                checked.unwrap_err()))
        val launch = checked.unwrap()
        if not spawn_recipe_is_migrated(recipe) or
            not spawn_recipe_launch_contract_valid(
            recipe, launch.path, launch.argv, launch.envp):
            return Err(-13)
        var index: i64 = 0
        while index < self.slots.len():
            if self.slots[index].state ==
                    AuthenticatedFsExecUserSlotStateV1.Armed and
                self.slots[index].caller == caller and
                self.slots[index].canonical_path == launch.path and
                self.slots[index].recipe == recipe:
                # Reserve before crossing into architecture handoff. A panic,
                # partial handoff, or indeterminate cleanup leaves this slot
                # Consuming, so the retained token cannot be replayed.
                self.slots[index].state =
                    AuthenticatedFsExecUserSlotStateV1.Consuming
                return Ok(AuthenticatedFsExecUserReservationV1(
                    slot_index: index,
                    generation: self.slots[index].generation,
                    submission: self.slots[index].submission))
            index = index + 1
        Err(-13)

    me finish(reservation: AuthenticatedFsExecUserReservationV1) -> bool:
        """Retire exactly the reservation moved across the blocking handoff."""
        if reservation.slot_index < 0 or
            reservation.slot_index >= self.slots.len():
            return false
        val index = reservation.slot_index
        if self.slots[index].generation != reservation.generation or
            self.slots[index].state !=
                AuthenticatedFsExecUserSlotStateV1.Consuming:
            return false
        self.slots[index].state = AuthenticatedFsExecUserSlotStateV1.Retired
        true

    me submit(
        scheduler: Scheduler,
        mut table: MountTable,
        caller: i64,
        caller_caps: CapabilitySet,
        canonical_path: text,
        argv: [text],
        recipe: i64
    ) -> AuthenticatedFsExecSubmissionResultV1:
        val reserved = self.reserve(caller, canonical_path, argv, recipe)
        if reserved.is_err():
            return AuthenticatedFsExecSubmissionResultV1(
                exit_code: reserved.unwrap_err(), evidence: nil,
                cleanup_indeterminate: false, scheduler: scheduler)
        val reservation = reserved.unwrap()
        val result = authenticated_fs_exec_submit_v1(
            scheduler, table, reservation.submission, caller_caps,
            canonical_path, argv)
        val retired = self.finish(reservation)
        AuthenticatedFsExecSubmissionResultV1(
            exit_code: result.exit_code,
            evidence: if retired: result.evidence else: nil,
            cleanup_indeterminate: result.cleanup_indeterminate or not retired,
            scheduler: result.scheduler)

# The checked-mutex capsule is the sole owner of these globals. No authority or
# namespace object is constructed by module initialization: syscall submission
# remains fail-closed until privileged boot installs the canonical VFS owner's
# epoch handle and arms an admitted slot. The broker never retains MountTable or
# DriverInstance state.
# Userland can neither call these owner surfaces nor obtain the retained token.
var g_authenticated_fs_exec_user_service_v1:
    AuthenticatedFsExecUserServiceV1? = nil
var g_authenticated_fs_exec_user_vfs_owner_v1:
    VfsMountTableOwnerHandleV1? = nil
val g_authenticated_fs_exec_user_mutex_v1: i64 = mutex_raw_create()
var g_authenticated_fs_exec_user_quarantined_v1 = false

fn _authenticated_fs_exec_user_lock_v1() -> bool:
    if g_authenticated_fs_exec_user_mutex_v1 <= 0 or
        g_authenticated_fs_exec_user_quarantined_v1:
        return false
    if not mutex_raw_lock(g_authenticated_fs_exec_user_mutex_v1):
        return false
    # Quarantine may have been published while this caller waited.
    if g_authenticated_fs_exec_user_quarantined_v1:
        _ = mutex_raw_unlock(g_authenticated_fs_exec_user_mutex_v1)
        return false
    true

fn _authenticated_fs_exec_user_unlock_v1() -> bool:
    if mutex_raw_unlock(g_authenticated_fs_exec_user_mutex_v1):
        return true
    # The prior mutation may already have linearized. Permanently suppress the
    # ingress instead of guessing which owner copy is authoritative.
    g_authenticated_fs_exec_user_quarantined_v1 = true
    false

fn _authenticated_fs_exec_user_quarantine_synchronized_v1():
    """Publish terminal failure only while owning the broker mutex."""
    if g_authenticated_fs_exec_user_mutex_v1 <= 0: return
    if not mutex_raw_lock(g_authenticated_fs_exec_user_mutex_v1): return
    g_authenticated_fs_exec_user_quarantined_v1 = true
    _ = mutex_raw_unlock(g_authenticated_fs_exec_user_mutex_v1)

pub(package) fn authenticated_fs_exec_user_install_mount_table_v1(
    owner: VfsMountTableOwnerHandleV1
) -> bool:
    """Install only the canonical VFS owner's epoch handle during boot.

    Repeating the exact currently-live epoch is idempotent for converging boot
    adapters. A different or stale epoch fails, preventing a later subsystem
    from replacing the namespace beneath already-armed authority coordinates.
    No filesystem driver or MountTable value crosses this seam.
    """
    if not _authenticated_fs_exec_user_lock_v1():
        return false
    if g_authenticated_fs_exec_user_vfs_owner_v1.?:
        # Multiple high-level boot adapters may converge on this seam. Treat
        # only the exact still-live epoch as an idempotent installation. A VFS
        # reset advances the epoch, so it cannot be hidden as duplicate success.
        if not g_authenticated_fs_exec_user_service_v1.?:
            g_authenticated_fs_exec_user_quarantined_v1 = true
            val _released = _authenticated_fs_exec_user_unlock_v1()
            return false
        val same_live = vfs_state_mount_table_owner_handles_same_live_v1(
            g_authenticated_fs_exec_user_vfs_owner_v1.unwrap(), owner)
        val released = _authenticated_fs_exec_user_unlock_v1()
        return same_live and released
    if not vfs_state_mount_table_owner_handle_is_live_v1(owner):
        val _released = _authenticated_fs_exec_user_unlock_v1()
        return false
    g_authenticated_fs_exec_user_service_v1 =
        Some(AuthenticatedFsExecUserServiceV1.new())
    g_authenticated_fs_exec_user_vfs_owner_v1 = Some(owner)
    _authenticated_fs_exec_user_unlock_v1()

pub fn authenticated_fs_exec_user_install_canonical_vfs_owner_v1() -> bool:
    """Boot-only adapter from canonical VFS state to the syscall broker.

    Call only after the final successful VFS reset/mount sequence. The adapter
    copies an epoch coordinate, never MountTable state, and deliberately does
    not admit or arm an executable. Only the same live epoch is idempotent; an
    intervening VFS reset remains visible as a failed installation.
    """
    val owner = vfs_state_mount_table_owner_handle_v1()
    if not owner.?: return false
    authenticated_fs_exec_user_install_mount_table_v1(owner.unwrap())

pub(package) fn authenticated_fs_exec_user_arm_v1(
    caller: i64,
    canonical_path: text,
    recipe: i64,
    submission: AuthenticatedFsExecSubmissionV1
) -> i64:
    """Privileged loader-owner surface for one exact admitted launch tuple."""
    if not _authenticated_fs_exec_user_lock_v1():
        return -5
    if not g_authenticated_fs_exec_user_service_v1.? or
        not g_authenticated_fs_exec_user_vfs_owner_v1.?:
        val _released = _authenticated_fs_exec_user_unlock_v1()
        return -13
    if not vfs_state_mount_table_owner_handle_is_live_v1(
        g_authenticated_fs_exec_user_vfs_owner_v1.unwrap()):
        val _released = _authenticated_fs_exec_user_unlock_v1()
        return -13
    var service = g_authenticated_fs_exec_user_service_v1.unwrap()
    val generation = service.arm(caller, canonical_path, recipe, submission)
    g_authenticated_fs_exec_user_service_v1 = Some(service)
    if not _authenticated_fs_exec_user_unlock_v1():
        return -5
    generation

pub(package) fn authenticated_fs_exec_user_pre_admit_and_arm_v1(
    authorities: ExecutableAuthorityRegistryV1,
    caller: i64,
    canonical_path: text,
    recipe: i64,
    admission: ExecutableAdmissionV1,
    proof: ExecutableLoaderCryptographicProofV1
) -> i64:
    """Privileged boot seam from signed catalog material to one-shot ingress."""
    if not _authenticated_fs_exec_user_lock_v1():
        return -5
    if not g_authenticated_fs_exec_user_service_v1.? or
        not g_authenticated_fs_exec_user_vfs_owner_v1.?:
        val _released = _authenticated_fs_exec_user_unlock_v1()
        return -13
    val lease_opt = vfs_state_mount_table_lease_begin_v1(
        g_authenticated_fs_exec_user_vfs_owner_v1.unwrap())
    if not lease_opt.?:
        val _released = _authenticated_fs_exec_user_unlock_v1()
        return -13
    var service = g_authenticated_fs_exec_user_service_v1.unwrap()
    var lease = lease_opt.unwrap()
    val armed = service.arm_installed_artifact_from_boot_proof_v1(
        lease.table, authorities,
        caller, canonical_path, recipe, admission, proof)
    g_authenticated_fs_exec_user_service_v1 = Some(service)
    if not vfs_state_mount_table_lease_restore_v1(lease):
        g_authenticated_fs_exec_user_quarantined_v1 = true
        val _released = _authenticated_fs_exec_user_unlock_v1()
        return -5
    if not _authenticated_fs_exec_user_unlock_v1():
        return -5
    armed

pub(package) fn authenticated_fs_exec_user_pre_admit_online_batch_v1(
    authorities: ExecutableAuthorityRegistryV1,
    caller: i64,
    canonical_path: text,
    recipe: i64,
    count: i64
) -> AuthenticatedFsExecOnlineBatchResultV1:
    """Privileged runtime producer for N distinct per-open admissions.

    This is intentionally not a user syscall. A boot/loader owner chooses the
    exact caller/path/recipe tuple and count. Each successful iteration retains
    a different live FileHandle and a different one-shot loader token. If a
    later iteration fails, earlier grants remain valid and the exact partial
    count is returned; no grant is fabricated or silently reported as armed.
    """
    if count <= 0 or count > EXECUTABLE_ONLINE_REATTESTATION_LIMIT_V1:
        return AuthenticatedFsExecOnlineBatchResultV1(
            ok: false, armed_count: 0, reason: "count")
    if not _authenticated_fs_exec_user_lock_v1():
        return AuthenticatedFsExecOnlineBatchResultV1(
            ok: false, armed_count: 0, reason: "serialization")
    if not g_authenticated_fs_exec_user_service_v1.? or
        not g_authenticated_fs_exec_user_vfs_owner_v1.?:
        val _released = _authenticated_fs_exec_user_unlock_v1()
        return AuthenticatedFsExecOnlineBatchResultV1(
            ok: false, armed_count: 0, reason: "service-unavailable")
    val lease_opt = vfs_state_mount_table_lease_begin_v1(
        g_authenticated_fs_exec_user_vfs_owner_v1.unwrap())
    if not lease_opt.?:
        val _released = _authenticated_fs_exec_user_unlock_v1()
        return AuthenticatedFsExecOnlineBatchResultV1(
            ok: false, armed_count: 0, reason: "vfs-busy")
    var lease = lease_opt.unwrap()
    var service = g_authenticated_fs_exec_user_service_v1.unwrap()
    var armed_count: i64 = 0
    var reason = ""
    while armed_count < count and reason == "":
        val armed = service.arm_installed_artifact_online_v1(
            lease.table, authorities, caller, canonical_path, recipe)
        if armed < 0:
            reason = "admission-" + armed.to_text()
        else:
            armed_count = armed_count + 1
    g_authenticated_fs_exec_user_service_v1 = Some(service)
    if not vfs_state_mount_table_lease_restore_v1(lease):
        g_authenticated_fs_exec_user_quarantined_v1 = true
        val _released = _authenticated_fs_exec_user_unlock_v1()
        return AuthenticatedFsExecOnlineBatchResultV1(
            ok: false, armed_count: armed_count, reason: "vfs-restore")
    if not _authenticated_fs_exec_user_unlock_v1():
        return AuthenticatedFsExecOnlineBatchResultV1(
            ok: false, armed_count: armed_count, reason: "serialization")
    AuthenticatedFsExecOnlineBatchResultV1(
        ok: armed_count == count, armed_count: armed_count, reason: reason)

pub struct AuthenticatedFsExecUserSyscallResultV1:
    exit_code: i64
    scheduler: Scheduler

pub struct AuthenticatedFsExecRemoteSubmissionResultV1:
    exit_code: i64
    evidence: SchedulerExecutionEvidenceTokenV1?
    scheduler: Scheduler
    cleanup_indeterminate: bool
    canonical_path: text

fn _authenticated_fs_exec_remote_result_v1(
    exit_code: i64,
    evidence: SchedulerExecutionEvidenceTokenV1?,
    scheduler: Scheduler,
    cleanup_indeterminate: bool,
    canonical_path: text
) -> AuthenticatedFsExecRemoteSubmissionResultV1:
    AuthenticatedFsExecRemoteSubmissionResultV1(
        exit_code: exit_code, evidence: evidence, scheduler: scheduler,
        cleanup_indeterminate: cleanup_indeterminate,
        canonical_path: canonical_path)

fn _authenticated_fs_exec_snapshot_retire_v1(
    lease: SchedulerCapabilitySnapshotLeaseV1,
    task_id: u64,
    lifecycle_generation: u64,
    exec_generation: u64
) -> bool:
    if scheduler_capability_snapshot_retire_v1(
        lease, task_id, lifecycle_generation, exec_generation):
        return true
    _authenticated_fs_exec_user_quarantine_synchronized_v1()
    false

fn _authenticated_fs_exec_user_result_v1(
    exit_code: i64, scheduler: Scheduler
) -> AuthenticatedFsExecUserSyscallResultV1:
    AuthenticatedFsExecUserSyscallResultV1(
        exit_code: exit_code, scheduler: scheduler)

pub fn authenticated_fs_exec_user_submit_syscall_v1(
    scheduler: Scheduler,
    execution: SchedulerCurrentExecutionSnapshotV1,
    caller: i64,
    canonical_path: text,
    argv: [text],
    recipe: i64
) -> AuthenticatedFsExecUserSyscallResultV1:
    """Serialized syscall ingress; returns an actual exit/error code, not pid.

    Authority remains in the loader globals above.  Absence of boot-owned table
    installation or of an exact caller/path/recipe admission is EACCES.
    """
    val task_id = scheduler_current_execution_snapshot_task_id_v1(execution)
    val lifecycle_generation =
        scheduler_current_execution_snapshot_lifecycle_generation_v1(execution)
    val exec_generation =
        scheduler_current_execution_snapshot_exec_generation_v1(execution)
    val snapshot_lease = scheduler_current_execution_snapshot_lease_v1(execution)
    if (not scheduler_current_execution_snapshot_admitted_v1(execution) or
        caller < 0 or caller.to_u64() != task_id):
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_user_result_v1(
            if retired: -13 else: -5, scheduler)
    if not scheduler_capability_snapshot_validate_v1(
        snapshot_lease, task_id, lifecycle_generation, exec_generation):
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_user_result_v1(
            if retired: -13 else: -5, scheduler)
    # Phase 1: acquire a unique generational loan from the canonical VFS owner,
    # then reserve the exact slot. A busy VFS cannot burn one-shot authority;
    # other VFS calls fail closed only after the loan is active.
    if not _authenticated_fs_exec_user_lock_v1():
        _ = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_user_result_v1(-5, scheduler)
    if not g_authenticated_fs_exec_user_service_v1.? or
        not g_authenticated_fs_exec_user_vfs_owner_v1.?:
        val _released = _authenticated_fs_exec_user_unlock_v1()
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_user_result_v1(
            if retired: -13 else: -5, scheduler)
    val lease_opt = vfs_state_mount_table_lease_begin_v1(
        g_authenticated_fs_exec_user_vfs_owner_v1.unwrap())
    if not lease_opt.?:
        val released = _authenticated_fs_exec_user_unlock_v1()
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_user_result_v1(
            if released and retired: -16 else: -5, scheduler)
    var lease = lease_opt.unwrap()
    var service = g_authenticated_fs_exec_user_service_v1.unwrap()
    val reserved = service.reserve(caller, canonical_path, argv, recipe)
    g_authenticated_fs_exec_user_service_v1 = Some(service)
    if reserved.is_err():
        if not vfs_state_mount_table_lease_restore_v1(lease):
            g_authenticated_fs_exec_user_quarantined_v1 = true
            val _released = _authenticated_fs_exec_user_unlock_v1()
            _ = _authenticated_fs_exec_snapshot_retire_v1(
                snapshot_lease, task_id, lifecycle_generation, exec_generation)
            return _authenticated_fs_exec_user_result_v1(-5, scheduler)
        val released = _authenticated_fs_exec_user_unlock_v1()
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_user_result_v1(
            if released and retired: reserved.unwrap_err() else: -5, scheduler)

    # Burn caller authority only after the exact loader slot is reserved.
    val reservation = reserved.unwrap()
    val pinned = scheduler_capability_snapshot_consume_once_v1(
        snapshot_lease, task_id, lifecycle_generation, exec_generation)
    if not pinned.?:
        val finished = service.finish(reservation)
        g_authenticated_fs_exec_user_service_v1 = Some(service)
        val restored = vfs_state_mount_table_lease_restore_v1(lease)
        val released = _authenticated_fs_exec_user_unlock_v1()
        return _authenticated_fs_exec_user_result_v1(
            if finished and restored and released: -13 else: -5, scheduler)
    val caller_caps =
        scheduler_pinned_capability_snapshot_caps_v1(pinned.unwrap())
    if exec_cap_check_caps(caller_caps, canonical_path) != 0:
        val finished = service.finish(reservation)
        g_authenticated_fs_exec_user_service_v1 = Some(service)
        val restored = vfs_state_mount_table_lease_restore_v1(lease)
        val released = _authenticated_fs_exec_user_unlock_v1()
        return _authenticated_fs_exec_user_result_v1(
            if finished and restored and released: -13 else: -5, scheduler)
    if not _authenticated_fs_exec_user_unlock_v1():
        _ = service.finish(reservation)
        g_authenticated_fs_exec_user_service_v1 = Some(service)
        _ = vfs_state_mount_table_lease_restore_v1(lease)
        return _authenticated_fs_exec_user_result_v1(-5, scheduler)

    # Phase 2: architecture execution can block without holding a raw mutex.
    val result = authenticated_fs_exec_submit_v1(
        scheduler, lease.table, reservation.submission, caller_caps,
        canonical_path, argv)

    # Phase 3: restore canonical VFS ownership before touching broker state.
    if not vfs_state_mount_table_lease_restore_v1(lease):
        _authenticated_fs_exec_user_quarantine_synchronized_v1()
        return _authenticated_fs_exec_user_result_v1(-5, result.scheduler)
    if not _authenticated_fs_exec_user_lock_v1():
        return _authenticated_fs_exec_user_result_v1(-5, result.scheduler)
    if not g_authenticated_fs_exec_user_service_v1.?:
        g_authenticated_fs_exec_user_quarantined_v1 = true
        val _released = _authenticated_fs_exec_user_unlock_v1()
        return _authenticated_fs_exec_user_result_v1(-5, result.scheduler)
    var completed_service = g_authenticated_fs_exec_user_service_v1.unwrap()
    val retired = completed_service.finish(reservation)
    g_authenticated_fs_exec_user_service_v1 = Some(completed_service)
    if not retired or not _authenticated_fs_exec_user_unlock_v1():
        return _authenticated_fs_exec_user_result_v1(-5, result.scheduler)
    _authenticated_fs_exec_user_result_v1(result.exit_code, result.scheduler)

pub(package) fn authenticated_fs_exec_remote_submit_v1(
    scheduler: Scheduler,
    execution: SchedulerCurrentExecutionSnapshotV1,
    caller: i64,
    command: text,
    argv_tail: [text]
) -> AuthenticatedFsExecRemoteSubmissionResultV1:
    """Resolve, admit, and synchronously run one remote command.

    Remote callers supply neither PATH nor argv[0]. The loader searches only
    its fixed `/bin` policy, opens with `ExecuteTrust.Untrusted`, synthesizes
    argv[0] from the retained canonical result, and uses one canonical VFS
    lease through admission and architecture submission. The scheduler
    snapshot is consumed once and its pinned capabilities authorize that same
    canonical path. This v1 API deliberately exposes execution evidence but no
    stdout claim; capture remains unavailable until a bounded process-owned
    transport is connected.
    """
    val task_id = scheduler_current_execution_snapshot_task_id_v1(execution)
    val lifecycle_generation =
        scheduler_current_execution_snapshot_lifecycle_generation_v1(execution)
    val exec_generation =
        scheduler_current_execution_snapshot_exec_generation_v1(execution)
    val snapshot_lease = scheduler_current_execution_snapshot_lease_v1(execution)
    val recipe = SPAWN_RECIPE_SSH_REMOTE_COMMAND
    val remote_arguments = executable_launch_arguments_v1_validate(
        command, argv_tail, [])
    if (not scheduler_current_execution_snapshot_admitted_v1(execution) or
        caller < 0 or caller.to_u64() != task_id or
        spawn_recipe_exec_prefix(recipe) != "/bin/" or
        (command.contains("/") and not command.starts_with("/bin/")) or
        remote_arguments.is_err() or
        argv_tail.len() >= EXECUTABLE_LAUNCH_ARGUMENTS_V1_MAX_ARGV):
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_remote_result_v1(
            if retired: -13 else: -5, nil, scheduler, not retired, "")
    val authority_result = executable_authority_loader_owner()
    if authority_result.is_err():
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_remote_result_v1(
            -5, nil, scheduler, not retired, "")
    val authorities = authority_result.unwrap()
    if not scheduler_capability_snapshot_validate_v1(
        snapshot_lease, task_id, lifecycle_generation, exec_generation):
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_remote_result_v1(
            if retired: -13 else: -5, nil, scheduler, not retired, "")
    if not _authenticated_fs_exec_user_lock_v1():
        _ = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_remote_result_v1(
            -5, nil, scheduler, true, "")
    if not g_authenticated_fs_exec_user_vfs_owner_v1.?:
        val released = _authenticated_fs_exec_user_unlock_v1()
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_remote_result_v1(
            if released and retired: -13 else: -5, nil, scheduler,
            not released or not retired, "")
    val lease_opt = vfs_state_mount_table_lease_begin_v1(
        g_authenticated_fs_exec_user_vfs_owner_v1.unwrap())
    if not lease_opt.?:
        val released = _authenticated_fs_exec_user_unlock_v1()
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_remote_result_v1(
            if released and retired: -16 else: -5, nil, scheduler,
            not released or not retired, "")
    var lease = lease_opt.unwrap()
    val resolved_result = lease.table.resolve_and_open_for_execute(
        command, ["/bin"], ExecuteTrust.Untrusted)
    if resolved_result.is_err():
        val resolve_errno = -(errno_of(resolved_result.unwrap_err()) as i64)
        val restored = vfs_state_mount_table_lease_restore_v1(lease)
        if not restored: g_authenticated_fs_exec_user_quarantined_v1 = true
        val released = _authenticated_fs_exec_user_unlock_v1()
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        return _authenticated_fs_exec_remote_result_v1(
            if restored and released and retired: resolve_errno else: -5,
            nil, scheduler, not restored or not released or not retired, "")
    val resolved = resolved_result.unwrap()
    var launch_argv: [text] = [resolved.canonical_path]
    for argument in argv_tail: launch_argv.push(argument)
    val checked = executable_launch_arguments_v1_validate(
        resolved.canonical_path, launch_argv, [])
    if checked.is_err() or not spawn_recipe_launch_contract_valid(
        recipe, resolved.canonical_path, launch_argv, []):
        val closed = lease.table.close(resolved.binding.file_handle).is_ok()
        val restored = vfs_state_mount_table_lease_restore_v1(lease)
        if not restored: g_authenticated_fs_exec_user_quarantined_v1 = true
        val released = _authenticated_fs_exec_user_unlock_v1()
        val retired = _authenticated_fs_exec_snapshot_retire_v1(
            snapshot_lease, task_id, lifecycle_generation, exec_generation)
        val rejected = if checked.is_err():
            executable_launch_arguments_v1_errno(checked.unwrap_err())
        else:
            -13
        return _authenticated_fs_exec_remote_result_v1(
            if closed and restored and released and retired: rejected else: -5,
            nil, scheduler,
            not closed or not restored or not released or not retired,
            resolved.canonical_path)
    val pinned = scheduler_capability_snapshot_consume_once_v1(
        snapshot_lease, task_id, lifecycle_generation, exec_generation)
    if not pinned.?:
        val closed = lease.table.close(resolved.binding.file_handle).is_ok()
        val restored = vfs_state_mount_table_lease_restore_v1(lease)
        if not restored: g_authenticated_fs_exec_user_quarantined_v1 = true
        val released = _authenticated_fs_exec_user_unlock_v1()
        return _authenticated_fs_exec_remote_result_v1(
            if closed and restored and released: -13 else: -5,
            nil, scheduler, not closed or not restored or not released,
            resolved.canonical_path)
    val caller_caps =
        scheduler_pinned_capability_snapshot_caps_v1(pinned.unwrap())
    if exec_cap_check_caps(caller_caps, resolved.canonical_path) != 0:
        val closed = lease.table.close(resolved.binding.file_handle).is_ok()
        val restored = vfs_state_mount_table_lease_restore_v1(lease)
        if not restored: g_authenticated_fs_exec_user_quarantined_v1 = true
        val released = _authenticated_fs_exec_user_unlock_v1()
        return _authenticated_fs_exec_remote_result_v1(
            if closed and restored and released: -13 else: -5,
            nil, scheduler, not closed or not restored or not released,
            resolved.canonical_path)
    val prepared = authenticated_fs_exec_prepare_installed_open_binding_v1(
        lease.table, authorities, caller, resolved, recipe)
    if prepared.is_err():
        val restored = vfs_state_mount_table_lease_restore_v1(lease)
        if not restored: g_authenticated_fs_exec_user_quarantined_v1 = true
        val released = _authenticated_fs_exec_user_unlock_v1()
        return _authenticated_fs_exec_remote_result_v1(
            if restored and released: prepared.unwrap_err() else: -5,
            nil, scheduler, not restored or not released,
            resolved.canonical_path)
    val submission = prepared.unwrap()
    if not _authenticated_fs_exec_user_unlock_v1():
        val revoked = executable_loader_revoke(
            lease.table, authorities, submission.token).is_ok()
        val restored = vfs_state_mount_table_lease_restore_v1(lease)
        return _authenticated_fs_exec_remote_result_v1(
            -5, nil, scheduler, not revoked or not restored,
            resolved.canonical_path)
    val run = authenticated_fs_exec_submit_v1(
        scheduler, lease.table, submission, caller_caps,
        resolved.canonical_path, launch_argv)
    val restored = vfs_state_mount_table_lease_restore_v1(lease)
    if not restored: _authenticated_fs_exec_user_quarantine_synchronized_v1()
    _authenticated_fs_exec_remote_result_v1(
        if restored: run.exit_code else: -5,
        if restored: run.evidence else: nil,
        run.scheduler,
        run.cleanup_indeterminate or not restored,
        resolved.canonical_path)

@cfg(x86_64)
use os.kernel.loader.x86_64_fs_exec_spawn.{
    x86_64_fs_exec_spawn_authenticated_with_launch_v1
}
@cfg(arm64)
use os.kernel.loader.arm64_fs_exec_spawn.{
    arm64_fs_exec_spawn_authenticated_with_launch_v1
}
@cfg(arm32)
use os.kernel.loader.arm32_fs_exec_spawn.{
    arm32_fs_exec_spawn_authenticated_with_launch_v1
}
@cfg(riscv64)
use os.kernel.loader.riscv64_fs_exec_spawn.{
    riscv64_fs_exec_spawn_authenticated_capture_with_launch_v1
}
@cfg(riscv32)
use os.kernel.loader.riscv32_fs_exec_spawn.{
    riscv32_fs_exec_spawn_authenticated_with_launch_v1
}
@cfg(x86)
use os.kernel.loader.x86_32_fs_exec_spawn.{
    x86_32_fs_exec_spawn_authenticated_with_launch_v1
}

pub(package) struct AuthenticatedFsExecSubmissionV1:
    authorities: ExecutableAuthorityRegistryV1
    token: ExecutableAuthorityTokenV1
    consumer: ExecutableLoadConsumerV1
    entry_point: u64
    caller: i64
    recipe: i64

pub(package) struct AuthenticatedFsExecSubmissionResultV1:
    exit_code: i64
    evidence: SchedulerExecutionEvidenceTokenV1?
    cleanup_indeterminate: bool
    scheduler: Scheduler

pub(package) fn authenticated_fs_exec_prepare_installed_artifact_online_v1(
    mut table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    caller: i64,
    canonical_path: text,
    recipe: i64
) -> Result<AuthenticatedFsExecSubmissionV1, i64>:
    """Create one fresh catalog- and execute-open-bound submission.

    This is loader-package authority, not a user entrypoint. It never reads a
    resident image or accepts caller-authored verification booleans. Every
    successful call owns a distinct live execute handle and one-shot token.
    """
    val opened = table.open_for_execute(canonical_path, ExecuteTrust.Trusted)
    if opened.is_err(): return Err(-13)
    val binding = opened.unwrap()
    _authenticated_fs_exec_prepare_installed_open_binding_v1(
        table, authorities, caller,
        ExecutePathOpenV1(
            canonical_path: binding.canonical_source_path,
            binding: binding),
        recipe, ExecuteTrust.Trusted)

fn _authenticated_fs_exec_prepare_installed_open_binding_v1(
    mut table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    caller: i64,
    resolved: ExecutePathOpenV1,
    recipe: i64,
    required_trust: ExecuteTrust
) -> Result<AuthenticatedFsExecSubmissionV1, i64>:
    val canonical_path = resolved.canonical_path
    val binding = resolved.binding
    val exec_prefix = spawn_recipe_exec_prefix(recipe)
    if caller < 0 or not spawn_recipe_is_migrated(recipe) or
        exec_prefix == "" or not canonical_path.starts_with(exec_prefix) or
        binding.canonical_source_path != canonical_path or
        not table.validate_execute_open_binding_trust(binding, required_trust) or
        not spawn_recipe_launch_contract_valid(
            recipe, canonical_path, [canonical_path], []) or
        not executable_authority_owner_valid(authorities):
        if table.close(binding.file_handle).is_err(): return Err(-5)
        return Err(-13)
    _authenticated_fs_exec_prepare_installed_verified_binding_v1(
        table, authorities, caller, resolved, recipe)

pub(package) fn authenticated_fs_exec_prepare_installed_open_binding_v1(
    mut table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    caller: i64,
    resolved: ExecutePathOpenV1,
    recipe: i64
) -> Result<AuthenticatedFsExecSubmissionV1, i64>:
    """Admit one internally validated untrusted retained remote binding."""
    _authenticated_fs_exec_prepare_installed_open_binding_v1(
        table, authorities, caller, resolved, recipe, ExecuteTrust.Untrusted)

fn _authenticated_fs_exec_prepare_installed_verified_binding_v1(
    mut table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    caller: i64,
    resolved: ExecutePathOpenV1,
    recipe: i64
) -> Result<AuthenticatedFsExecSubmissionV1, i64>:
    """Admit one retained path-resolution binding without reopening its path.

    The resolver-selected canonical path and execute handle remain one value
    through catalog lookup, online re-attestation, digest/layout verification,
    and authority issuance. A trust mismatch closes that exact handle and
    fails; callers cannot upgrade an untrusted remote search result by naming
    a trusted path afterward.
    """
    val canonical_path = resolved.canonical_path
    val binding = resolved.binding
    val target = installed_artifact_active_target_v1()
    if not target.?:
        if table.close(binding.file_handle).is_err(): return Err(-5)
        return Err(-8)
    val record = installed_artifact_catalog_lookup_target_v1(
        canonical_path, target.unwrap())
    if not record.?:
        if table.close(binding.file_handle).is_err(): return Err(-5)
        return Err(-13)
    val installed = record.unwrap()
    val attested = executable_online_reattest_open_binding_v1(
        binding, installed.manifest, installed.content_sha256)
    if attested.is_err():
        if table.close(binding.file_handle).is_err(): return Err(-5)
        return Err(-13)
    val signed = attested.unwrap()
    if installed.content_sha256 != signed.admission.image_hash or
        installed.expected_trust_root_sha256 != signed.admission.trust_root_hash or
        installed.signer_identity != signed.proof.signer_key_id or
        installed.target.os != signed.admission.target.os or
        installed.target.arch != signed.admission.target.arch or
        installed.target.abi != signed.admission.target.abi:
        if table.close(binding.file_handle).is_err(): return Err(-5)
        return Err(-13)
    val inputs = ExecutableLoaderVerificationInputsV1(
        manifest: installed.manifest,
        manifest_hash: signed.admission.manifest_hash,
        image_hash: installed.content_sha256,
        trust_root_hash: installed.expected_trust_root_sha256,
        target: installed.target,
        format: installed.manifest.artifact_kind,
        role: "installed-main-image",
        verified_load_ranges: [],
        manifest_verified: true, signature_verified: true,
        trust_root_verified: true, target_verified: true,
        format_verified: true, ranges_verified: true,
        image_digest_verified: true)
    val admitted = executable_loader_admit_installed_artifact_open_binding_v1(
        table, authorities, binding, inputs, signed.admission, signed.proof)
    if admitted.is_err(): return Err(-13)
    val prepared = admitted.unwrap()
    Ok(AuthenticatedFsExecSubmissionV1(
        authorities: authorities,
        token: prepared.admission.authority_token,
        consumer: prepared.consumer,
        entry_point: prepared.admission.entry_point,
        caller: caller,
        recipe: recipe))

pub(package) fn authenticated_fs_exec_prepare_generated_artifact_online_v1(
    mut table: MountTable,
    authorities: ExecutableAuthorityRegistryV1,
    caller: i64,
    canonical_path: text,
    immutable_reference_path: text,
    expected_target: ManifestTarget,
    recipe: i64
) -> Result<AuthenticatedFsExecSubmissionV1, i64>:
    """Admit generated bytes against a distinct immutable catalog reference.

    This loader-private seam is intentionally JIT: callers invoke it only after
    the producer has closed the generated executable and acquired its stable
    argv-file binding. The sealed reference row supplies the expected content,
    manifest, target, signer and load-consumer policy, while the authority is
    bound to a fresh execute-open of `canonical_path`. Thus a pathname cannot
    bless arbitrary compiler output, and the immutable reference is never
    substituted as the image that the scheduler executes.
    """
    val exec_prefix = spawn_recipe_exec_prefix(recipe)
    if caller < 0 or canonical_path == immutable_reference_path or
        not spawn_recipe_is_migrated(recipe) or exec_prefix == "" or
        not canonical_path.starts_with(exec_prefix) or
        not spawn_recipe_launch_contract_valid(
            recipe, canonical_path, [canonical_path], []) or
        not executable_authority_owner_valid(authorities):
        return Err(-13)
    val target = installed_artifact_active_target_v1()
    if not target.?: return Err(-8)
    val active_target = target.unwrap()
    val policy = installed_artifact_catalog_elf_load_plan_v1(
        # Generated hello is an authority-free payload. Do not let a reference
        # manifest use this seam to request ambient child capabilities.
        immutable_reference_path, 0u32)
    if policy.is_err(): return Err(-13)
    val reference = policy.unwrap()
    if (expected_target.os != active_target.os or
        expected_target.arch != active_target.arch or
        expected_target.abi != active_target.abi or
        reference.record.target.os != expected_target.os or
        reference.record.target.arch != active_target.arch or
        reference.record.target.abi != active_target.abi):
        return Err(-13)
    val opened = table.open_for_execute(canonical_path, ExecuteTrust.Trusted)
    if opened.is_err(): return Err(-13)
    val binding = opened.unwrap()
    val attested = executable_online_reattest_open_binding_v1(
        binding, reference.record.manifest, reference.record.content_sha256)
    if attested.is_err():
        if table.close(binding.file_handle).is_err(): return Err(-5)
        return Err(-13)
    val signed = attested.unwrap()
    if (reference.record.content_sha256 != signed.admission.image_hash or
        reference.record.expected_trust_root_sha256 !=
            signed.admission.trust_root_hash or
        not installed_artifact_trust_binding_check_v1(
            reference.record, reference.record.manifest.signature,
            signed.proof.signer_key_id, signed.admission.trust_root_hash)):
        if table.close(binding.file_handle).is_err(): return Err(-5)
        return Err(-13)
    val inputs = ExecutableLoaderVerificationInputsV1(
        manifest: reference.record.manifest,
        manifest_hash: signed.admission.manifest_hash,
        image_hash: reference.record.content_sha256,
        trust_root_hash: reference.record.expected_trust_root_sha256,
        target: reference.record.target,
        format: reference.record.manifest.artifact_kind,
        role: "generated-main-image",
        verified_load_ranges: [],
        manifest_verified: true, signature_verified: true,
        trust_root_verified: true, target_verified: true,
        format_verified: true, ranges_verified: true,
        image_digest_verified: true)
    val admitted = executable_loader_admit_authenticated_open_binding_v1(
        table, authorities, binding, inputs, signed.admission, signed.proof)
    if admitted.is_err(): return Err(-13)
    val prepared = admitted.unwrap()
    Ok(AuthenticatedFsExecSubmissionV1(
        authorities: authorities,
        token: prepared.authority_token,
        consumer: reference.consumer,
        entry_point: prepared.entry_point,
        caller: caller,
        recipe: recipe))

pub(package) fn authenticated_fs_exec_submit_with_argv_file_v1(
    scheduler: Scheduler,
    mut table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
    caller_caps: CapabilitySet,
    path: text,
    argv: [text],
    argv_file: AuthenticatedArgvFileLeaseV1
) -> AuthenticatedFsExecSubmissionResultV1:
    """Run while one owner-issued argv snapshot remains generation-live."""
    val result = authenticated_fs_exec_submit_v1(
        scheduler, table, submission, caller_caps, path, argv)
    val binding = authenticated_argv_file_binding_finish_v1(table, argv_file)
    if result.exit_code != 0 or not result.evidence.?:
        return AuthenticatedFsExecSubmissionResultV1(
            exit_code: result.exit_code, evidence: result.evidence,
            cleanup_indeterminate: result.cleanup_indeterminate or binding.is_err(),
            scheduler: result.scheduler)
    if binding.is_err() or not scheduler_execution_attach_argv_file_bindings_v1(
        result.evidence.unwrap(), [binding.unwrap()]):
        val retired = scheduler_execution_evidence_consume_once_v2(
            result.evidence.unwrap()).is_some()
        return AuthenticatedFsExecSubmissionResultV1(
            exit_code: -10, evidence: nil,
            cleanup_indeterminate: binding.is_err() or not retired,
            scheduler: result.scheduler)
    result

fn _retire_failed_submission_v1(
    mut table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
    result: FsExecAuthenticatedRunResultV1
) -> AuthenticatedFsExecSubmissionResultV1:
    # Adoption may reject before consuming the loader token.  Revoke in that
    # case; if adoption already consumed it, the failed revoke is harmless and
    # cannot recreate authority.
    val failed = result.exit_code != 0 or not result.evidence.?
    val retired = if failed:
        match executable_loader_revoke(
            table, submission.authorities, submission.token):
            case Ok(_): true
            # Invalid here means adoption already consumed/retired the
            # one-shot token, or no live authority existed to leak.
            case Err(ExecutableLoaderAdmissionErrorV1.AuthorityTokenInvalid): true
            case Err(_): false
    else:
        true
    AuthenticatedFsExecSubmissionResultV1(
        exit_code: result.exit_code, evidence: result.evidence,
        cleanup_indeterminate: failed and not retired,
        scheduler: result.scheduler)

@cfg(x86_64)
pub(package) fn authenticated_fs_exec_submit_v1(
    scheduler: Scheduler,
    mut table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
    caller_caps: CapabilitySet,
    path: text,
    argv: [text]
) -> AuthenticatedFsExecSubmissionResultV1:
    val result = x86_64_fs_exec_spawn_authenticated_with_launch_v1(
        scheduler, table, submission.authorities, submission.token,
        submission.consumer, submission.entry_point, submission.caller, caller_caps,
        path, argv, [], submission.recipe)
    _retire_failed_submission_v1(table, submission, result)

