"""Authenticated filesystem-exec submission adapter.

This service transports loader-issued authority into the existing architecture
handoff, exit, reap, and scheduler-evidence path.  It cannot open an executable,
mint authority, reconstruct a token from a pathname, or use the legacy -13
path-only facade.
"""

use std.fs_driver.mount_table.{MountTable}
use os.kernel.loader.executable_authority_registry.{
    ExecutableAuthorityRegistryV1, ExecutableAuthorityTokenV1
}
use os.kernel.loader.executable_load_plan_v1.{ExecutableLoadConsumerV1}
use os.kernel.loader.fs_exec_spawn.{FsExecAuthenticatedRunResultV1}
use os.kernel.loader.executable_admission_pipeline.{executable_loader_revoke}
use os.kernel.scheduler.scheduler_types.{Scheduler}

@cfg(x86_64)
use os.kernel.loader.x86_64_fs_exec_spawn.{
    x86_64_fs_exec_spawn_authenticated_with_launch_v1
}
@cfg(arm64)
use os.kernel.loader.arm64_fs_exec_spawn.{
    arm64_fs_exec_spawn_authenticated_with_launch_v1
}
@cfg(riscv64)
use os.kernel.loader.riscv64_fs_exec_spawn.{
    riscv64_fs_exec_spawn_authenticated_capture_with_launch_v1
}

pub(package) struct AuthenticatedFsExecSubmissionV1:
    authorities: ExecutableAuthorityRegistryV1
    token: ExecutableAuthorityTokenV1
    consumer: ExecutableLoadConsumerV1
    entry_point: u64
    caller: i64
    recipe: i64

fn _retire_failed_submission_v1(
    table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
    result: FsExecAuthenticatedRunResultV1
) -> FsExecAuthenticatedRunResultV1:
    # Adoption may reject before consuming the loader token.  Revoke in that
    # case; if adoption already consumed it, the failed revoke is harmless and
    # cannot recreate authority.
    if result.exit_code != 0 or not result.evidence.?:
        _ = executable_loader_revoke(
            table, submission.authorities, submission.token)
    result

@cfg(x86_64)
pub(package) fn authenticated_fs_exec_submit_v1(
    scheduler: Scheduler,
    table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
    path: text,
    argv: [text]
) -> FsExecAuthenticatedRunResultV1:
    val result = x86_64_fs_exec_spawn_authenticated_with_launch_v1(
        scheduler, table, submission.authorities, submission.token,
        submission.consumer, submission.entry_point, submission.caller,
        path, argv, [], submission.recipe)
    _retire_failed_submission_v1(table, submission, result)

@cfg(arm64)
pub(package) fn authenticated_fs_exec_submit_v1(
    scheduler: Scheduler,
    table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
    path: text,
    argv: [text]
) -> FsExecAuthenticatedRunResultV1:
    val result = arm64_fs_exec_spawn_authenticated_with_launch_v1(
        scheduler, table, submission.authorities, submission.token,
        submission.consumer, submission.entry_point, submission.caller,
        path, argv, [], submission.recipe)
    _retire_failed_submission_v1(table, submission, result)

@cfg(riscv64)
pub(package) fn authenticated_fs_exec_submit_v1(
    scheduler: Scheduler,
    table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
    path: text,
    argv: [text]
) -> FsExecAuthenticatedRunResultV1:
    val result = riscv64_fs_exec_spawn_authenticated_capture_with_launch_v1(
        scheduler, table, submission.authorities, submission.token,
        submission.consumer, submission.entry_point, submission.caller,
        path, argv, [], submission.recipe)
    _retire_failed_submission_v1(
        table, submission,
        FsExecAuthenticatedRunResultV1(
            exit_code: result.exit_code, evidence: result.evidence))

@cfg(x86)
pub(package) fn authenticated_fs_exec_submit_v1(
    scheduler: Scheduler,
    table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
    path: text,
    argv: [text]
) -> FsExecAuthenticatedRunResultV1:
    # The x86-32 authenticated process-image handoff is not yet published.
    val _scheduler = scheduler
    val _path = path
    val _argv = argv
    _retire_failed_submission_v1(
        table, submission,
        FsExecAuthenticatedRunResultV1(exit_code: -95, evidence: nil))

@cfg(arm32)
pub(package) fn authenticated_fs_exec_submit_v1(
    scheduler: Scheduler,
    table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
    path: text,
    argv: [text]
) -> FsExecAuthenticatedRunResultV1:
    val _scheduler = scheduler
    val _path = path
    val _argv = argv
    _retire_failed_submission_v1(
        table, submission,
        FsExecAuthenticatedRunResultV1(exit_code: -95, evidence: nil))

@cfg(riscv32)
pub(package) fn authenticated_fs_exec_submit_v1(
    scheduler: Scheduler,
    table: MountTable,
    submission: AuthenticatedFsExecSubmissionV1,
    path: text,
    argv: [text]
) -> FsExecAuthenticatedRunResultV1:
    val _scheduler = scheduler
    val _path = path
    val _argv = argv
    _retire_failed_submission_v1(
        table, submission,
        FsExecAuthenticatedRunResultV1(exit_code: -95, evidence: nil))
