# Capability gate for filesystem-exec spawn.
#
# Checks that a calling task holds both FileExec and ProcessSpawn before the
# loader reads or maps any executable bytes.
#
# Constraint: must NOT import os.apps.* or os.services.vfs.vfs_init — this
# module is linked into the freestanding kernel ELF via fs_exec_spawn.
#
# WP-21 (2026-08-07): `exec_cap_check(caller, path)` — the scalar-caller ABI
# every fs-exec call site actually uses — previously built a fresh, empty
# `os.kernel.ipc.capability.CapabilityManager` per call. That manager's
# `records: [TaskCapRecord]` starts empty and NOTHING ever populates it for a
# fs-exec caller, so `check()` -> `_find_record` -> nil -> false unconditionally.
# The old header comment here claimed "this gate never denies" — that was only
# half right: an empty-records manager can also never ALLOW. A nonzero caller
# was permanently stuck at "always denied", not "checked against real
# capabilities" — so no positive (granted -> allowed) case could ever be
# exercised, which made a deny-only spec against it vacuous (it would pass
# whether or not the capability logic works at all).
#
# `exec_cap_check_caps(caps, path)` below is the REAL check, holding actual
# capability-matching logic (`CapabilitySet.has`, the same model
# `TaskControlBlock.capabilities` and `spawn_authority.spl` already use in
# production) instead of a throwaway record store. It is unit-testable and
# sabotage-provable in both directions (see
# `test/01_unit/os/kernel/loader/cap_exec_gate_spec.spl`).
#
# `exec_cap_check(caller, path)` still cannot call it with the CALLER's real
# capability set: none of `fs_exec_spawn_as` / `fs_exec_spawn_with_recipe` /
# `fs_exec_spawn_ring3_with_recipe` (the only production callers) carry a
# `TaskControlBlock` or `Scheduler` handle — they take a bare `caller: i64`
# scalar (see `fs_exec_spawn.spl`'s shared-ABI comments) and build their own
# throwaway bootstrap `Scheduler` internally. This is the SAME gap
# `_fs_exec_parent_caps`'s `TODO(boot-seal)` in `fs_exec_spawn.spl` already
# names for the spawn-authority side: "thread the calling task's real
# TaskControlBlock.capabilities into fs_exec_prepare_spawn_from_bytes". Until
# that lands, `exec_cap_check(caller, path)` keeps its narrower, honestly-
# documented behavior: caller == 0 (kernel-origin sentinel, the only value any
# production call site passes today — audited 2026-08-07, see the bug doc)
# passes; every other caller is unconditionally denied (fail-closed, not
# fail-open) because there is nowhere at this call site to read that caller's
# actual grants from.
#
# See doc/08_tracking/bug/execve_spec_blocked_by_dead_ipc_cap_gate_and_missing_rt_copy_user_byte_2026-08-06.md
# and doc/08_tracking/bug/exec_cap_check_caller_identity_not_threaded_2026-08-07.md.

use os.kernel.types.capability_types.{CapabilityKind, CapabilitySet}

extern fn serial_println(msg: text)

@allow(primitive_api)  # bare i32 errno return matches the whole fs-exec/loader
                        # scalar ABI family (fs_exec_spawn.spl, x86_64_fs_exec_spawn.spl);
                        # this fn's return is consumed directly as the errno the
                        # syscall shim layer returns to userspace.
pub fn exec_cap_check_caps(caps: CapabilitySet, path: text) -> i32:
    """Check that `caps` holds FileExec(path) + ProcessSpawn.

    Returns 0 on success, -13 (EACCES) on denial. This is the real capability
    logic: a pledged (deny-all-by-default) `CapabilitySet` lacking either
    right is denied; a set that explicitly holds both (or the unpledged
    ambient-full set) is allowed. Pure function — no throwaway store, no
    hidden state — so it is directly unit-testable.
    """
    if not caps.has(CapabilityKind.FileExec(path_prefix: path)):
        serial_println("[cap-gate] deny FileExec path={path}")
        return -13
    if not caps.has(CapabilityKind.ProcessSpawn):
        serial_println("[cap-gate] deny ProcessSpawn path={path}")
        return -13
    0

@allow(primitive_api)  # scalar caller-id + errno ABI shared with every fs-exec
                        # call site (see module header); changing this shape
                        # would ripple through fs_exec_spawn.spl's whole family.
pub fn exec_cap_check(caller: i64, path: text) -> i32:
    """Check that caller holds FileExec(path) + ProcessSpawn.

    Returns 0 on success, -13 (EACCES) on denial.
    caller == 0 is the kernel-origin sentinel and always passes.

    Every other caller is unconditionally denied: this scalar-caller ABI has
    no access to that caller's real `CapabilitySet` (see module header). Once
    a real caller capability set is threadable here, this should delegate to
    `exec_cap_check_caps` instead of denying outright.
    """
    if caller == 0:
        return 0
    serial_println("[cap-gate] deny caller={caller} path={path} err=no-capability-set-available")
    return -13
