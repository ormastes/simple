"""Pure, allocation-bounded Clang cc1 argv contract for SimpleOS userland."""

use std.common.contracts.execution.simpleos_target_v1.{
    SIMPLEOS_TARGET_V1_X86_64_TRIPLE, SIMPLEOS_TARGET_V1_I686_TRIPLE,
    SIMPLEOS_TARGET_V1_AARCH64_TRIPLE, SIMPLEOS_TARGET_V1_ARMV7_TRIPLE,
    SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE,
    SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE
}

pub struct ClangFilesystemCc1ArgvPlanV1:
    argv: [text]
    source_argv_index: i64

pub fn clang_filesystem_cc1_source_binding_valid_v1(
    argv: [text], source_argv_index: i64, source_path: text
) -> bool:
    source_argv_index >= 0 and source_argv_index < argv.len() and
        argv[source_argv_index] == source_path

pub fn clang_filesystem_cc1_argv_plan_v1(
    clang_path: text,
    target_triple: text,
    object_path: text,
    source_path: text
) -> ClangFilesystemCc1ArgvPlanV1?:
    # Catalog names retain ISA profiles; cc1 receives the base machine triple
    # and the profile is made explicit as an ordered ABI/feature contract.
    if target_triple == SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE:
        return Some(ClangFilesystemCc1ArgvPlanV1(
            argv: [clang_path, "-cc1", "-triple", "riscv64-unknown-simpleos",
                "-target-abi", "lp64d",
                "-target-feature", "+m", "-target-feature", "+a",
                "-target-feature", "+f", "-target-feature", "+d",
                "-target-feature", "+c", "-target-feature", "+zicsr",
                "-target-feature", "+zifencei",
                "-emit-obj", "-o", object_path, "-x", "c", source_path],
            source_argv_index: 25))
    if target_triple == SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE:
        return Some(ClangFilesystemCc1ArgvPlanV1(
            argv: [clang_path, "-cc1", "-triple", "riscv32-unknown-simpleos",
                "-target-abi", "ilp32",
                "-target-feature", "+m", "-target-feature", "+a",
                "-target-feature", "+c", "-emit-obj", "-o", object_path,
                "-x", "c", source_path],
            source_argv_index: 17))
    if target_triple == SIMPLEOS_TARGET_V1_X86_64_TRIPLE or
       target_triple == SIMPLEOS_TARGET_V1_I686_TRIPLE or
       target_triple == SIMPLEOS_TARGET_V1_AARCH64_TRIPLE or
       target_triple == SIMPLEOS_TARGET_V1_ARMV7_TRIPLE:
        return Some(ClangFilesystemCc1ArgvPlanV1(
            argv: [clang_path, "-cc1", "-triple", target_triple,
                "-emit-obj", "-o", object_path, "-x", "c", source_path],
            source_argv_index: 9))
    nil

pub fn clang_filesystem_cc1_argv_contract_valid_v1(
    clang_path: text, object_path: text, source_path: text, argv: [text]
) -> bool:
    # Admission is a hot policy path: select by exact shape and compare fields
    # directly, without constructing an expected argv array.
    if argv.len() < 4 or argv[0] != clang_path or argv[1] != "-cc1" or
       argv[2] != "-triple":
        return false
    if argv.len() == 10:
        val target = argv[3]
        val target_valid = (
            target == SIMPLEOS_TARGET_V1_X86_64_TRIPLE or
            target == SIMPLEOS_TARGET_V1_I686_TRIPLE or
            target == SIMPLEOS_TARGET_V1_AARCH64_TRIPLE or
            target == SIMPLEOS_TARGET_V1_ARMV7_TRIPLE)
        return target_valid and argv[4] == "-emit-obj" and
            argv[5] == "-o" and argv[6] == object_path and
            argv[7] == "-x" and argv[8] == "c" and argv[9] == source_path
    if argv.len() == 26:
        return argv[3] == "riscv64-unknown-simpleos" and
            argv[4] == "-target-abi" and argv[5] == "lp64d" and
            argv[6] == "-target-feature" and argv[7] == "+m" and
            argv[8] == "-target-feature" and argv[9] == "+a" and
            argv[10] == "-target-feature" and argv[11] == "+f" and
            argv[12] == "-target-feature" and argv[13] == "+d" and
            argv[14] == "-target-feature" and argv[15] == "+c" and
            argv[16] == "-target-feature" and argv[17] == "+zicsr" and
            argv[18] == "-target-feature" and argv[19] == "+zifencei" and
            argv[20] == "-emit-obj" and argv[21] == "-o" and
            argv[22] == object_path and argv[23] == "-x" and
            argv[24] == "c" and argv[25] == source_path
    if argv.len() == 18:
        return argv[3] == "riscv32-unknown-simpleos" and
            argv[4] == "-target-abi" and argv[5] == "ilp32" and
            argv[6] == "-target-feature" and argv[7] == "+m" and
            argv[8] == "-target-feature" and argv[9] == "+a" and
            argv[10] == "-target-feature" and argv[11] == "+c" and
            argv[12] == "-emit-obj" and argv[13] == "-o" and
            argv[14] == object_path and argv[15] == "-x" and
            argv[16] == "c" and argv[17] == source_path
    false

export ClangFilesystemCc1ArgvPlanV1
export clang_filesystem_cc1_argv_plan_v1
export clang_filesystem_cc1_source_binding_valid_v1
export clang_filesystem_cc1_argv_contract_valid_v1
