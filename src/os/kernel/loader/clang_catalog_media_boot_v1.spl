"""Loader-owned stable-media admission for the signed Clang catalog.

CCRD is always read, canonically decoded, and authenticated before any of the
nine payload/SCR1 pairs are opened.  Successful admission returns only a
compact bundle; the global installed-artifact catalog remains untouched for
the later loader-owned one-shot composition.
"""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.crypto.ed25519.{pure_ed25519_verify}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.fs_driver.mount_table.{MountTable}
use os.kernel.loader.authenticated_media_parser.{authenticated_media_hex_bytes_v1}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootPolicyV1, InstalledArtifactBootRecordV1}
use os.kernel.loader.clang_sysroot_catalog_bundle_v1.{
    ClangSysrootCatalogBundleV1, CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1,
    clang_sysroot_catalog_required_paths_v1,
    clang_sysroot_catalog_bundle_from_signed_triplet_v1}
use os.kernel.loader.clang_catalog_release_descriptor_v1.{
    CLANG_CATALOG_RELEASE_PAYLOAD_MAX_BYTES_V1,
    CLANG_CATALOG_RELEASE_SCR1_MAX_BYTES_V1,
    CLANG_CATALOG_RELEASE_MEDIA_MAX_BYTES_V1,
    clang_catalog_release_descriptor_verify_v1}
use os.kernel.loader.clang_catalog_release_descriptor_codec_v1.{
    CLANG_CATALOG_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1,
    decode_clang_catalog_release_descriptor_v1}
use os.kernel.loader.signed_catalog_snapshot_reader_v1.{
    signed_catalog_snapshot_read_v1, signed_catalog_snapshot_digest_v1}
use os.kernel.loader.signed_catalog_scr1_decoder_v1.{
    SignedCatalogScr1DecodedV1, signed_catalog_scr1_decode_v1,
    signed_catalog_scr1_bind_digest_v1}

pub const CLANG_CATALOG_RELEASE_DESCRIPTOR_PATH_V1: text =
    "/boot/catalog/clang_catalog_release.ccrd"

pub struct ClangCatalogMediaBootPolicyV1:
    target: ManifestTarget
    pinned_key_id: text
    pinned_public_key_hex: text
    pinned_public_key_sha256: text

pub enum ClangCatalogMediaBootErrorV1:
    None
    PolicyRejected
    DescriptorReadRejected
    DescriptorRejected
    DescriptorTrustRejected
    PayloadReadRejected
    PayloadDigestMismatch
    Scr1ReadRejected
    Scr1DigestMismatch
    Scr1Rejected
    RecordSignatureRejected
    AggregateBoundsRejected
    BundleRejected

pub struct ClangCatalogMediaBootResultV1:
    ok: bool
    error: ClangCatalogMediaBootErrorV1
    release_id: text
    accepted_records: i64
    bundle: ClangSysrootCatalogBundleV1

fn _empty_bundle_v1(target: ManifestTarget) -> ClangSysrootCatalogBundleV1:
    ClangSysrootCatalogBundleV1(
        ok: false, reason: "clang-catalog-media-boot-rejected",
        policy: InstalledArtifactBootPolicyV1(
            platform_target: target, required_canonical_paths: [], trust_roots: []),
        records: [])

fn _fail_v1(
    target: ManifestTarget, error: ClangCatalogMediaBootErrorV1,
) -> ClangCatalogMediaBootResultV1:
    ClangCatalogMediaBootResultV1(
        ok: false, error: error, release_id: "", accepted_records: 0,
        bundle: _empty_bundle_v1(target))

fn _target_equal_v1(left: ManifestTarget, right: ManifestTarget) -> bool:
    left.os == right.os and left.arch == right.arch and left.abi == right.abi

fn _policy_root_v1(
    policy: ClangCatalogMediaBootPolicyV1,
) -> ExecutableManifestTrustedSignerV1?:
    if policy.target.os != "simpleos" or policy.target.abi != "simpleos" or
        (policy.target.arch != "x86_64" and policy.target.arch != "aarch64" and
         policy.target.arch != "riscv64") or policy.pinned_key_id.len() == 0 or
        policy.pinned_key_id.len() > 128 or policy.pinned_key_id.contains(":") or
        policy.pinned_public_key_hex.len() != 64 or
        policy.pinned_public_key_sha256.len() != 64:
        return nil
    val key = authenticated_media_hex_bytes_v1(policy.pinned_public_key_hex)
    if key.len() != 32 or sha256_u8_hex(key) != policy.pinned_public_key_sha256:
        return nil
    Some(ExecutableManifestTrustedSignerV1(
        key_id: policy.pinned_key_id, public_key: key))

pub fn clang_catalog_media_payload_paths_v1() -> [text]:
    clang_sysroot_catalog_required_paths_v1()

pub fn clang_catalog_media_scr1_paths_v1() -> [text]:
    ["/boot/catalog/clang.scr1", "/boot/catalog/ld.lld.scr1",
     "/boot/catalog/hello.elf.scr1", "/boot/catalog/sysroot.merkle.scr1",
     "/boot/catalog/simpleos.ld.scr1", "/boot/catalog/crt0.o.scr1",
     "/boot/catalog/libsimpleos_c.a.scr1",
     "/boot/catalog/libsimple_runtime.a.scr1", "/boot/catalog/libm.a.scr1"]

pub(package) fn clang_catalog_media_aggregate_next_v1(
    current_bytes: i64,
    payload_bytes: i64,
    scr1_bytes: i64,
) -> i64?:
    """Admit one pair without permitting overflow or a release over 512 MiB."""
    if current_bytes < 0 or payload_bytes <= 0 or scr1_bytes <= 0 or
        current_bytes > CLANG_CATALOG_RELEASE_MEDIA_MAX_BYTES_V1 or
        payload_bytes > CLANG_CATALOG_RELEASE_MEDIA_MAX_BYTES_V1 - current_bytes:
        return nil
    val after_payload = current_bytes + payload_bytes
    if scr1_bytes > CLANG_CATALOG_RELEASE_MEDIA_MAX_BYTES_V1 - after_payload:
        return nil
    Some(after_payload + scr1_bytes)

fn _record_signature_valid_v1(
    decoded: SignedCatalogScr1DecodedV1,
    root: ExecutableManifestTrustedSignerV1,
    root_sha256: text,
) -> bool:
    val record = decoded.record
    val envelope = record.detached_signature.split(":")
    if envelope.len() != 3 or envelope[0] != "ed25519" or
        envelope[1] != root.key_id or
        record.expected_trust_root_sha256 != root_sha256:
        return false
    val signature = authenticated_media_hex_bytes_v1(envelope[2])
    signature.len() == 64 and
        pure_ed25519_verify(root.public_key, decoded.sam1_bytes, signature)

pub(package) fn clang_catalog_media_boot_prepare_v1(
    table: MountTable,
    policy: ClangCatalogMediaBootPolicyV1,
) -> ClangCatalogMediaBootResultV1:
    """Authenticate exact on-image media and retain only nine compact rows."""
    val root = _policy_root_v1(policy)
    if not root.?: return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.PolicyRejected)
    val pinned_root = root.unwrap()
    val roots = [pinned_root]

    # Mandatory ordering: authenticate canonical CCRD before opening row media.
    val descriptor_read = signed_catalog_snapshot_read_v1(
        table, CLANG_CATALOG_RELEASE_DESCRIPTOR_PATH_V1,
        CLANG_CATALOG_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1.to_u64())
    if descriptor_read.is_err():
        return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.DescriptorReadRejected)
    val decoded_descriptor = decode_clang_catalog_release_descriptor_v1(
        descriptor_read.unwrap().bytes)
    if not decoded_descriptor.ok or
        not _target_equal_v1(decoded_descriptor.value.target, policy.target):
        return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.DescriptorRejected)
    val descriptor_check = clang_catalog_release_descriptor_verify_v1(
        decoded_descriptor.value, roots)
    if not descriptor_check.ok:
        return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.DescriptorTrustRejected)

    val payload_paths = clang_catalog_media_payload_paths_v1()
    val scr1_paths = clang_catalog_media_scr1_paths_v1()
    if payload_paths.len() != CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1 or
        scr1_paths.len() != CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1:
        return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.PolicyRejected)
    var records: [InstalledArtifactBootRecordV1] = []
    var aggregate_bytes: i64 = 0
    var index: i64 = 0
    while index < CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1:
        val row = decoded_descriptor.value.rows[index]
        if row.canonical_path != payload_paths[index]:
            return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.DescriptorRejected)
        val payload = signed_catalog_snapshot_digest_v1(
            table, payload_paths[index],
            CLANG_CATALOG_RELEASE_PAYLOAD_MAX_BYTES_V1.to_u64())
        if payload.is_err():
            return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.PayloadReadRejected)
        if payload.unwrap().content_sha256 != row.payload_sha256:
            return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.PayloadDigestMismatch)
        val scr1 = signed_catalog_snapshot_read_v1(
            table, scr1_paths[index],
            CLANG_CATALOG_RELEASE_SCR1_MAX_BYTES_V1.to_u64())
        if scr1.is_err():
            return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.Scr1ReadRejected)
        val scr1_bytes = scr1.unwrap().bytes
        if sha256_u8_hex(scr1_bytes) != row.scr1_sha256:
            return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.Scr1DigestMismatch)
        val next_aggregate = clang_catalog_media_aggregate_next_v1(
            aggregate_bytes, payload.unwrap().size.to_i64(), scr1_bytes.len())
        if not next_aggregate.?:
            return _fail_v1(
                policy.target, ClangCatalogMediaBootErrorV1.AggregateBoundsRejected)
        aggregate_bytes = next_aggregate.unwrap()
        val decoded_scr1 = signed_catalog_scr1_decode_v1(scr1_bytes)
        if not decoded_scr1.?:
            return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.Scr1Rejected)
        val binding = signed_catalog_scr1_bind_digest_v1(
            decoded_scr1.unwrap(), payload.unwrap().content_sha256,
            payload.unwrap().size.to_i64(), policy.target, payload_paths[index])
        if not binding.?:
            return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.Scr1Rejected)
        if not _record_signature_valid_v1(
            binding.unwrap().decoded, pinned_root,
            policy.pinned_public_key_sha256):
            return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.RecordSignatureRejected)
        records.push(binding.unwrap().decoded.record)
        index = index + 1

    var toolchain: [InstalledArtifactBootRecordV1] = []
    var sysroot: [InstalledArtifactBootRecordV1] = []
    index = 0
    while index < records.len():
        if index < 3: toolchain.push(records[index])
        else: sysroot.push(records[index])
        index = index + 1
    val bundle = clang_sysroot_catalog_bundle_from_signed_triplet_v1(
        policy.target, roots, toolchain, sysroot)
    if not bundle.ok:
        return _fail_v1(policy.target, ClangCatalogMediaBootErrorV1.BundleRejected)
    ClangCatalogMediaBootResultV1(
        ok: true, error: ClangCatalogMediaBootErrorV1.None,
        release_id: decoded_descriptor.value.release_id,
        accepted_records: records.len(), bundle: bundle)
