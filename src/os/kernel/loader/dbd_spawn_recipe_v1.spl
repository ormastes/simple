"""Dedicated filesystem spawn recipe for the isolated DBD artifact."""

use os.kernel.ipc.cspace_spawn.{SpawnSpec, CapGrant}
use os.kernel.loader.dbd_launch_grants_v1.{
    SIMPLEOS_DBD_EXECUTABLE_V1, DbdLaunchGrantPlanV1,
    dbd_launch_grant_plan_v1, dbd_launch_grant_plan_valid_v1
}

pub val SIMPLEOS_DBD_SPAWN_ISOLATION_V1: text = "dbd-service-v1"

pub struct DbdSpawnRecipeV1:
    image_hash: text
    executable_path: text
    argv: [text]
    envp: [text]
    spawn_spec: SpawnSpec

pub fn dbd_spawn_launch_shape_valid_v1(
    executable_path: text, argv: [text], envp: [text]
) -> bool:
    executable_path == SIMPLEOS_DBD_EXECUTABLE_V1 and argv.len() == 1 and
        argv[0] == SIMPLEOS_DBD_EXECUTABLE_V1 and envp.len() == 0

pub fn dbd_spawn_recipe_v1(
    image_hash: text, executable_path: text, argv: [text], envp: [text]
) -> DbdSpawnRecipeV1:
    var grants: [CapGrant] = []
    if image_hash.len() > 0 and dbd_spawn_launch_shape_valid_v1(
        executable_path, argv, envp):
        grants = dbd_launch_grant_plan_v1(executable_path).grants
    DbdSpawnRecipeV1(image_hash: image_hash, executable_path: executable_path,
        argv: argv, envp: envp, spawn_spec: SpawnSpec(image_hash: image_hash,
            grants: grants, isolation: SIMPLEOS_DBD_SPAWN_ISOLATION_V1, budget: 0u64))

pub fn dbd_spawn_recipe_valid_v1(recipe: DbdSpawnRecipeV1) -> bool:
    if recipe.image_hash.len() == 0 or
       recipe.spawn_spec.image_hash != recipe.image_hash or
       recipe.spawn_spec.isolation != SIMPLEOS_DBD_SPAWN_ISOLATION_V1 or
       recipe.spawn_spec.budget != 0u64 or
       not dbd_spawn_launch_shape_valid_v1(recipe.executable_path, recipe.argv, recipe.envp):
        return false
    dbd_launch_grant_plan_valid_v1(DbdLaunchGrantPlanV1(
        executable_identity: recipe.executable_path, grants: recipe.spawn_spec.grants))
