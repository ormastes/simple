"""Architecture-neutral publication of one sealed boot-service receipt."""

use os.kernel.loader.executable_admission_pipeline.{
    BootServicePolicyReceiptV1,
    executable_loader_boot_service_receipt_reserve_v1
}
use os.kernel.loader.boot_service_context_v1.{
    boot_service_context_publish_v1
}
use os.kernel.loader.executable_authority_registry.{
    ExecutableAuthorityRegistryV1,
    executable_authority_finish_boot_service_reservation_v1
}
use os.kernel.loader.server_launch_grants.{
    SIMPLEOS_SERVER_EXECUTABLE_V1, server_launch_grant_plan_v1
}
use os.kernel.scheduler.scheduler_types.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.types.task_types.{TaskId}
use os.kernel.types.capability_types.{
    CapabilityKind, CapabilitySet, CapabilityToken
}
use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}

val _boot_service_root_mutex_v1: i64 = mutex_raw_create()
var _boot_service_root_next_generation_v1: u64 = 1u64
var _boot_service_root_next_token_id_v1: u64 = 0x4253520000000001u64
var _boot_service_root_poisoned_v1: bool = false

fn _boot_service_root_unlock_v1() -> bool:
    if mutex_raw_unlock(_boot_service_root_mutex_v1): return true
    _boot_service_root_poisoned_v1 = true
    false

fn _boot_service_root_pouch_v1() -> CapabilitySet:
    """Privately mint the fixed parent policy from monotonic provenance."""
    val plan = server_launch_grant_plan_v1(SIMPLEOS_SERVER_EXECUTABLE_V1)
    var tokens: [CapabilityToken] = []
    if plan.executable_identity != SIMPLEOS_SERVER_EXECUTABLE_V1 or
        plan.grants.len() == 0:
        return CapabilitySet(caps: tokens, is_pledged: true)
    var index: i64 = 0
    while index < plan.grants.len():
        val kind = plan.grants[index].requested
        if kind == CapabilityKind.ProcessSpawn:
            return CapabilitySet(caps: [], is_pledged: true)
        var prior: i64 = 0
        while prior < index:
            if plan.grants[prior].requested == kind:
                return CapabilitySet(caps: [], is_pledged: true)
            prior = prior + 1
        index = index + 1
    if (_boot_service_root_mutex_v1 <= 0 or
        _boot_service_root_poisoned_v1 or
        not mutex_raw_lock(_boot_service_root_mutex_v1)):
        return CapabilitySet(caps: [], is_pledged: true)
    val count = plan.grants.len() as u64 + 1u64
    if (_boot_service_root_next_generation_v1 == 0u64 or
        _boot_service_root_next_token_id_v1 == 0u64 or
        _boot_service_root_next_generation_v1 >
            0xffffffffffffffffu64 - count or
        _boot_service_root_next_token_id_v1 >
            0xffffffffffffffffu64 - count):
        _ = _boot_service_root_unlock_v1()
        return CapabilitySet(caps: [], is_pledged: true)
    var generation = _boot_service_root_next_generation_v1
    var token_id = _boot_service_root_next_token_id_v1
    for grant in plan.grants:
        tokens.push(CapabilityToken(
            kind: grant.requested, generation: generation, owner: 0u64,
            token_id: token_id, parent_token_id: 0u64, depth: 1))
        generation = generation + 1u64
        token_id = token_id + 1u64
    tokens.push(CapabilityToken(
        kind: CapabilityKind.ProcessSpawn,
        generation: generation, owner: 0u64,
        token_id: token_id, parent_token_id: 0u64, depth: 1))
    _boot_service_root_next_generation_v1 = generation + 1u64
    _boot_service_root_next_token_id_v1 = token_id + 1u64
    if not _boot_service_root_unlock_v1():
        return CapabilitySet(caps: [], is_pledged: true)
    CapabilitySet(caps: tokens, is_pledged: true)

pub fn boot_service_policy_receipt_publish_v1(
    scheduler: Scheduler,
    ipc: IpcManager,
    authorities: ExecutableAuthorityRegistryV1,
    receipt: BootServicePolicyReceiptV1
) -> TaskId?:
    """Burn, revalidate, mint, and publish one canonical server boot parent."""
    val reserved = executable_loader_boot_service_receipt_reserve_v1(
        authorities, receipt)
    if not reserved.?: return nil
    val reservation = reserved.unwrap()
    val pouch = _boot_service_root_pouch_v1()
    var published: TaskId? = nil
    if pouch.is_pledged and pouch.caps.len() != 0:
        published = boot_service_context_publish_v1(scheduler, ipc, pouch)
    val finished = executable_authority_finish_boot_service_reservation_v1(
        authorities, reservation)
    if finished.is_err() and not published.?: return nil
    published

export boot_service_policy_receipt_publish_v1
