# Canonical, non-authorizing SimpleOS executable target dispatch policy.
#
# This module is the single spelling bridge between signed manifest targets,
# ELF/process-image architecture selection, and scheduler admission.  It owns
# no file handle, address space, task, or loader token.  A returned policy is
# therefore immutable routing evidence only; callers still need the exact
# loader-owned authority and source-path binding before mapping or publication.

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.arch.arch_context.{Architecture}

pub struct ExecutableTargetDispatchPolicyV1:
    architecture: Architecture
    canonical_arch: text
    pointer_bits: i64
    user_address_max: u64
    stack_alignment: u64
    process_image_builder_ready: bool

fn _target_policy_v1(
    architecture: Architecture,
    canonical_arch: text,
    pointer_bits: i64,
    user_address_max: u64,
    stack_alignment: u64,
    process_image_builder_ready: bool
) -> ExecutableTargetDispatchPolicyV1:
    ExecutableTargetDispatchPolicyV1(
        architecture: architecture,
        canonical_arch: canonical_arch,
        pointer_bits: pointer_bits,
        user_address_max: user_address_max,
        stack_alignment: stack_alignment,
        process_image_builder_ready: process_image_builder_ready)

pub fn executable_target_dispatch_policy_for_arch_v1(
    canonical_arch: text
) -> ExecutableTargetDispatchPolicyV1?:
    """Resolve one exact SimpleOS architecture spelling without authority."""
    match canonical_arch:
        case "x86_64": Some(_target_policy_v1(
            Architecture.X86_64, "x86_64", 64, 0x00007FFFFFFFFFFFu64,
            16u64, true))
        case "x86": Some(_target_policy_v1(
            Architecture.X86, "x86", 32, 0x00000000BFFFFFFFu64,
            16u64, false))
        case "aarch64": Some(_target_policy_v1(
            Architecture.Arm64, "aarch64", 64, 0x00007FFFFFFFFFFFu64,
            16u64, true))
        case "arm": Some(_target_policy_v1(
            Architecture.Arm32, "arm", 32, 0x00000000BFFFFFFFu64,
            8u64, false))
        case "riscv64": Some(_target_policy_v1(
            Architecture.Riscv64, "riscv64", 64, 0x0000003FFFFFFFFFu64,
            16u64, true))
        case "riscv32": Some(_target_policy_v1(
            Architecture.Riscv32, "riscv32", 32, 0x000000007FFFFFFFu64,
            16u64, true))
        case _: nil

pub fn executable_target_dispatch_policy_v1(
    target: ManifestTarget
) -> ExecutableTargetDispatchPolicyV1?:
    if (target.os != "simpleos" or target.abi != "simpleos" or
        target.arch == "" or target.arch == "any"):
        return nil
    executable_target_dispatch_policy_for_arch_v1(target.arch)

pub fn executable_target_process_image_ready_v1(target: ManifestTarget) -> bool:
    val policy = executable_target_dispatch_policy_v1(target)
    policy.? and policy.unwrap().process_image_builder_ready

pub fn executable_target_arch_process_image_ready_v1(
    canonical_arch: text
) -> bool:
    val policy = executable_target_dispatch_policy_for_arch_v1(canonical_arch)
    policy.? and policy.unwrap().process_image_builder_ready

pub fn executable_target_dispatch_matches_architecture_v1(
    target: ManifestTarget,
    architecture: Architecture
) -> bool:
    val policy = executable_target_dispatch_policy_v1(target)
    policy.? and policy.unwrap().architecture == architecture

pub fn executable_target_dispatch_consumer_matches_v1(
    expected_os: text,
    expected_arch: text,
    expected_abi: text,
    architecture: Architecture
) -> bool:
    val target = ManifestTarget(
        os: expected_os, arch: expected_arch, abi: expected_abi)
    executable_target_process_image_ready_v1(target) and
        executable_target_dispatch_matches_architecture_v1(target, architecture)

export ExecutableTargetDispatchPolicyV1
export executable_target_dispatch_policy_for_arch_v1
export executable_target_dispatch_policy_v1
export executable_target_process_image_ready_v1
export executable_target_arch_process_image_ready_v1
export executable_target_dispatch_matches_architecture_v1
export executable_target_dispatch_consumer_matches_v1
