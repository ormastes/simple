# Dependency-light canonical executable admission signing-body owner.

use std.fs_driver.bytes_util.{text_to_bytes_pure}
use std.common.contracts.execution.simpleos_executable_v1.{SimpleArtifactManifest}
use std.common.contracts.execution.simpleos_executable_admission_v1.{ExecutableAdmissionV1}

class _ExecutableSigningBodyWriterV1:
    bytes: [u8]

    me append_raw(value: text):
        val encoded = text_to_bytes_pure(value)
        for byte in encoded: self.bytes.push(byte)

    me append_field(value: text):
        # Keep the canonical prefix defined by the text length rather than the
        # encoded byte length.  This exactly preserves the prior signing body
        # for non-ASCII manifest fields while avoiding reconstruction of the
        # complete prefix for every appended field.
        self.append_raw(value.len().to_text())
        self.bytes.push(58u8)
        self.append_raw(value)

pub fn executable_manifest_signing_body_v1(manifest: SimpleArtifactManifest, admission: ExecutableAdmissionV1, image_hash: text) -> [u8]:
    var writer = _ExecutableSigningBodyWriterV1(bytes: [])
    writer.append_raw("simpleos-executable-admission-v1")
    writer.append_field(manifest.format_version.to_text())
    writer.append_field(manifest.artifact_kind)
    writer.append_field(manifest.target.os)
    writer.append_field(manifest.target.arch)
    writer.append_field(manifest.target.abi)
    writer.append_field(manifest.entrypoint)
    writer.append_field(manifest.required_abi_features.len().to_text())
    for item in manifest.required_abi_features: writer.append_field(item)
    writer.append_field(manifest.required_services.len().to_text())
    for item in manifest.required_services: writer.append_field(item)
    writer.append_field(manifest.required_capabilities.to_text())
    writer.append_field(manifest.resource_limits.max_memory_bytes.to_text())
    writer.append_field(manifest.resource_limits.max_open_handles.to_text())
    writer.append_field(manifest.resource_limits.max_threads.to_text())
    writer.append_field(manifest.resource_limits.cpu_budget_us.to_text())
    writer.append_field(manifest.namespace_template)
    writer.append_field(manifest.native_libraries.len().to_text())
    for item in manifest.native_libraries: writer.append_field(item)
    writer.append_field(manifest.smf_libraries.len().to_text())
    for item in manifest.smf_libraries: writer.append_field(item)
    writer.append_field(manifest.interpreter)
    writer.append_field(manifest.argument_schema.len().to_text())
    for item in manifest.argument_schema:
        writer.append_field(item.name)
        writer.append_field(item.value_kind)
        writer.append_field(item.required.to_text())
        writer.append_field(item.default_value)
    writer.append_field(manifest.startup_preloads.len().to_text())
    for item in manifest.startup_preloads:
        writer.append_field(item.source_arg)
        writer.append_field(item.fixed_path)
        writer.append_field(item.mode)
        writer.append_field(item.required.to_text())
        writer.append_field(item.maximum_bytes.to_text())
        writer.append_field(item.access)
        writer.append_field(item.prefault.to_text())
        writer.append_field(item.hash_policy)
    writer.append_field(manifest.debug_identity)
    writer.append_field(manifest.content_hashes.len().to_text())
    for digest in manifest.content_hashes: writer.append_field(digest)
    writer.append_field(admission.admission_id)
    writer.append_field(image_hash)
    writer.append_field(admission.trust_epoch.to_text())
    writer.append_field(admission.mount_id.to_text())
    writer.append_field(admission.mount_generation.to_text())
    writer.append_field(admission.file_id.to_text())
    writer.append_field(admission.file_generation.to_text())
    writer.append_field(admission.effective_capabilities.to_text())
    writer.append_field(admission.kernel_hash)
    writer.append_field(admission.firmware_profile)
    writer.append_field(admission.compiler_identity)
    writer.append_field(admission.source_identity)
    writer.append_field(admission.config_identity)
    writer.bytes

export executable_manifest_signing_body_v1
