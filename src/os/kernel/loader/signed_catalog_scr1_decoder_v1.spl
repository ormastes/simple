"""Generic loader-owned decoder and payload binder for canonical SCR1 rows.

The decoder derives the manifest solely from the embedded SAM1 signing bytes.
The binder additionally fixes the row to one payload, target, and canonical
path.  Neither operation verifies signer trust or grants catalog authority.
"""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.string_core.{bytes_to_text}
use std.common.structural.execution.simple_artifact_manifest_v1_codec.{
    SIMPLE_ARTIFACT_MANIFEST_V1_MAX_SIGNING_BYTES,
    decode_simple_artifact_manifest_v1_signing_bytes
}
use std.common.structural.wire.{
    wire_magic, wire_envelope_len, wire_check_envelope, wire_has, wire_get_u32
}
use os.installer.hosted_safe_artifact_io_v1.{
    HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1
}
use os.installer.simplebox_signed_catalog_provisioner_v1.{
    SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1,
    SimpleboxSignedCatalogExternalCandidateV1,
    simplebox_signed_catalog_record_encode_v1
}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootRecordV1
}

pub struct SignedCatalogScr1DecodedV1:
    record: InstalledArtifactBootRecordV1
    sam1_identity_sha256: text
    sam1_bytes: [u8]
    scr1_sha256: text

pub struct SignedCatalogScr1PayloadBindingV1:
    decoded: SignedCatalogScr1DecodedV1
    payload_sha256: text
    payload_byte_count: i64

class _SignedCatalogScr1ReaderV1:
    data: [u8]
    offset: i64
    ok: bool

    me read_u32() -> i64:
        if not self.ok or not wire_has(self.data, self.offset, 4):
            self.ok = false
            return 0
        val value = wire_get_u32(self.data, self.offset)
        self.offset = self.offset + 4
        value

    me read_text(maximum: i64) -> text:
        val size = self.read_u32()
        if not self.ok or size <= 0 or size > maximum or
            not wire_has(self.data, self.offset, size):
            self.ok = false
            return ""
        var raw: [u8] = []
        var index: i64 = 0
        while index < size:
            val byte = self.data[self.offset + index] as i64
            if byte < 32 or byte > 126:
                self.ok = false
                return ""
            raw.push(byte.to_u8())
            index = index + 1
        self.offset = self.offset + size
        bytes_to_text(raw)

    me read_bytes(maximum: i64) -> [u8]:
        val size = self.read_u32()
        if not self.ok or size <= 0 or size > maximum or
            not wire_has(self.data, self.offset, size):
            self.ok = false
            return []
        var value: [u8] = []
        var index: i64 = 0
        while index < size:
            value.push(self.data[self.offset + index])
            index = index + 1
        self.offset = self.offset + size
        value

fn _scr1_target_equal_v1(left: ManifestTarget, right: ManifestTarget) -> bool:
    left.os == right.os and left.arch == right.arch and left.abi == right.abi

fn _scr1_lower_sha256_v1(value: text) -> bool:
    if value.len() != 64: return false
    for ch in value:
        if not ((ch >= '0' and ch <= '9') or (ch >= 'a' and ch <= 'f')):
            return false
    true

pub fn signed_catalog_scr1_decode_v1(
    bytes: [u8],
) -> SignedCatalogScr1DecodedV1?:
    """Decode embedded SAM1 material and require the one canonical SCR1 form."""
    if bytes.len() == 0 or bytes.len() > SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1 or
        not wire_check_envelope(bytes, 0, wire_magic("SCR1"), 1):
        return nil
    var reader = _SignedCatalogScr1ReaderV1(
        data: bytes, offset: wire_envelope_len(), ok: true)
    val canonical_path = reader.read_text(4096)
    val alias_count = reader.read_u32()
    if not reader.ok or alias_count < 0 or alias_count > 64: return nil
    var aliases: [text] = []
    var alias_index: i64 = 0
    while reader.ok and alias_index < alias_count:
        aliases.push(reader.read_text(4096))
        alias_index = alias_index + 1
    val content_sha256 = reader.read_text(64)
    val sam1_identity_sha256 = reader.read_text(64)
    val detached_signature = reader.read_text(512)
    val expected_trust_root_sha256 = reader.read_text(64)
    val sam1 = reader.read_bytes(SIMPLE_ARTIFACT_MANIFEST_V1_MAX_SIGNING_BYTES)
    if not reader.ok or reader.offset != bytes.len(): return nil
    val projection = decode_simple_artifact_manifest_v1_signing_bytes(
        sam1, detached_signature)
    if not projection.? or projection.unwrap().image_hash != content_sha256 or
        projection.unwrap().manifest.signature != detached_signature or
        sha256_u8_hex(sam1) != sam1_identity_sha256:
        return nil
    val candidate = SimpleboxSignedCatalogExternalCandidateV1(
        sam1_identity_sha256: sam1_identity_sha256,
        record: InstalledArtifactBootRecordV1(
            canonical_path: canonical_path, aliases: aliases,
            content_sha256: content_sha256,
            detached_signature: detached_signature,
            expected_trust_root_sha256: expected_trust_root_sha256,
            manifest: projection.unwrap().manifest))
    val canonical = simplebox_signed_catalog_record_encode_v1(candidate)
    if not canonical.? or canonical.unwrap() != bytes: return nil
    Some(SignedCatalogScr1DecodedV1(
        record: candidate.record,
        sam1_identity_sha256: sam1_identity_sha256, sam1_bytes: sam1,
        scr1_sha256: sha256_u8_hex(bytes)))

pub fn signed_catalog_scr1_bind_digest_v1(
    decoded: SignedCatalogScr1DecodedV1,
    payload_sha256: text,
    payload_byte_count: i64,
    expected_target: ManifestTarget,
    expected_canonical_path: text,
) -> SignedCatalogScr1PayloadBindingV1?:
    """Bind a decoded row to a precomputed payload digest without its bytes."""
    if payload_byte_count <= 0 or
        payload_byte_count > HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1 or
        not _scr1_lower_sha256_v1(payload_sha256) or
        expected_canonical_path.len() == 0:
        return nil
    val record = decoded.record
    val projection = decode_simple_artifact_manifest_v1_signing_bytes(
        decoded.sam1_bytes, record.detached_signature)
    if not projection.?: return nil
    if record.canonical_path != expected_canonical_path or
        not _scr1_target_equal_v1(record.manifest.target, expected_target) or
        record.content_sha256 != payload_sha256 or
        record.manifest.content_hashes.len() == 0 or
        not record.manifest.content_hashes.contains(payload_sha256) or
        projection.unwrap().image_hash != payload_sha256 or
        projection.unwrap().manifest != record.manifest or
        projection.unwrap().manifest.signature != record.detached_signature or
        sha256_u8_hex(decoded.sam1_bytes) != decoded.sam1_identity_sha256:
        return nil
    Some(SignedCatalogScr1PayloadBindingV1(
        decoded: decoded, payload_sha256: payload_sha256,
        payload_byte_count: payload_byte_count))

pub fn signed_catalog_scr1_bind_payload_v1(
    decoded: SignedCatalogScr1DecodedV1,
    payload_bytes: [u8],
    expected_target: ManifestTarget,
    expected_canonical_path: text,
) -> SignedCatalogScr1PayloadBindingV1?:
    """Hash an in-memory payload and delegate to the digest-only binder."""
    if payload_bytes.len() == 0 or
        payload_bytes.len() > HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1:
        return nil
    signed_catalog_scr1_bind_digest_v1(
        decoded, sha256_u8_hex(payload_bytes), payload_bytes.len() as i64,
        expected_target, expected_canonical_path)
