"""Bounded stable-snapshot reads for signed catalog boot ingestion.

The loader owns this path from open through close.  Bytes are read only from
the already-open MountTable snapshot, in sequential chunks, while MountTable
tracks the same stream for promotion-grade SHA-256 sealing.
"""

use std.common.crypto.sha256.{
    Sha256StreamV1, sha256_stream_v1_new, sha256_stream_v1_update,
    sha256_stream_v1_finish_hex
}
use std.fs_driver.mount_table.{
    MountTable, StableFileSnapshotLeaseV1, StableFileSnapshotSealV1
}

pub const SIGNED_CATALOG_SNAPSHOT_CHUNK_BYTES_V1: u64 = 65536u64
pub const SIGNED_CATALOG_SNAPSHOT_MAX_BYTES_V1: u64 = 16777216u64
pub const SIGNED_CATALOG_SNAPSHOT_DIGEST_MAX_BYTES_V1: u64 = 268435456u64

pub struct SignedCatalogSnapshotReadV1:
    bytes: [u8]
    seal: StableFileSnapshotSealV1

pub struct SignedCatalogSnapshotDigestV1:
    content_sha256: text
    size: u64
    seal: StableFileSnapshotSealV1

fn _snapshot_read_failure_v1(
    table: MountTable,
    lease: StableFileSnapshotLeaseV1,
    reason: text,
) -> Result<SignedCatalogSnapshotReadV1, text>:
    val closed = table.close_stable_snapshot(lease)
    if closed.is_err(): return Err("signed-catalog-snapshot-cleanup-indeterminate")
    Err(reason)

fn _snapshot_digest_failure_v1(
    table: MountTable,
    lease: StableFileSnapshotLeaseV1,
    reason: text,
) -> Result<SignedCatalogSnapshotDigestV1, text>:
    val closed = table.close_stable_snapshot(lease)
    if closed.is_err(): return Err("signed-catalog-snapshot-cleanup-indeterminate")
    Err(reason)

pub(package) fn signed_catalog_snapshot_digest_v1(
    table: MountTable,
    path: text,
    max_bytes: u64,
) -> Result<SignedCatalogSnapshotDigestV1, text>:
    """Hash and seal a large catalog payload without retaining its bytes."""
    if max_bytes == 0u64 or
        max_bytes > SIGNED_CATALOG_SNAPSHOT_DIGEST_MAX_BYTES_V1:
        return Err("signed-catalog-snapshot-bound-invalid")
    val opened = table.open_stable_snapshot(path, max_bytes)
    if opened.is_err(): return Err("signed-catalog-snapshot-open-failed")
    val snapshot = opened.unwrap()
    val lease = snapshot.lease
    if table.begin_stable_snapshot_promotion_hash_v1(lease).is_err():
        return _snapshot_digest_failure_v1(
            table, lease, "signed-catalog-snapshot-hash-admission-failed")

    val digest_stream: Sha256StreamV1 = sha256_stream_v1_new()
    var offset = 0u64
    while offset < snapshot.size:
        val remaining = snapshot.size - offset
        val requested = if remaining < SIGNED_CATALOG_SNAPSHOT_CHUNK_BYTES_V1:
            remaining
        else:
            SIGNED_CATALOG_SNAPSHOT_CHUNK_BYTES_V1
        val read = table.read_stable_snapshot(lease, offset, requested)
        if read.is_err():
            return _snapshot_digest_failure_v1(
                table, lease, "signed-catalog-snapshot-read-failed")
        val chunk = read.unwrap()
        if chunk.len() != requested or
            not sha256_stream_v1_update(digest_stream, chunk):
            return _snapshot_digest_failure_v1(
                table, lease, "signed-catalog-snapshot-short-read")
        offset = offset + requested

    val eof = table.read_stable_snapshot(
        lease, offset, SIGNED_CATALOG_SNAPSHOT_CHUNK_BYTES_V1)
    if eof.is_err():
        return _snapshot_digest_failure_v1(
            table, lease, "signed-catalog-snapshot-eof-invalid")
    if eof.unwrap().len() != 0:
        return _snapshot_digest_failure_v1(
            table, lease, "signed-catalog-snapshot-eof-invalid")
    val digest = sha256_stream_v1_finish_hex(digest_stream)
    if not digest.?:
        return _snapshot_digest_failure_v1(
            table, lease, "signed-catalog-snapshot-hash-failed")
    val content_sha256 = digest.unwrap()
    val sealed = table.finish_stable_snapshot_v1(lease, content_sha256)
    if sealed.is_err():
        return _snapshot_digest_failure_v1(
            table, lease, "signed-catalog-snapshot-seal-failed")
    val seal = sealed.unwrap()
    val closed = table.close_stable_snapshot(lease)
    if closed.is_err():
        return Err("signed-catalog-snapshot-cleanup-indeterminate")
    Ok(SignedCatalogSnapshotDigestV1(
        content_sha256: content_sha256, size: snapshot.size, seal: seal))

pub(package) fn signed_catalog_snapshot_read_v1(
    table: MountTable,
    path: text,
    max_bytes: u64,
) -> Result<SignedCatalogSnapshotReadV1, text>:
    """Retain one small SCR1, trust, or descriptor file after sealing it."""
    if max_bytes == 0u64 or max_bytes > SIGNED_CATALOG_SNAPSHOT_MAX_BYTES_V1:
        return Err("signed-catalog-snapshot-bound-invalid")
    val opened = table.open_stable_snapshot(path, max_bytes)
    if opened.is_err(): return Err("signed-catalog-snapshot-open-failed")
    val snapshot = opened.unwrap()
    val lease = snapshot.lease
    if table.begin_stable_snapshot_promotion_hash_v1(lease).is_err():
        return _snapshot_read_failure_v1(
            table, lease, "signed-catalog-snapshot-hash-admission-failed")

    val digest_stream: Sha256StreamV1 = sha256_stream_v1_new()
    var bytes: [u8] = []
    var offset = 0u64
    while offset < snapshot.size:
        val remaining = snapshot.size - offset
        val requested = if remaining < SIGNED_CATALOG_SNAPSHOT_CHUNK_BYTES_V1:
            remaining
        else:
            SIGNED_CATALOG_SNAPSHOT_CHUNK_BYTES_V1
        val read = table.read_stable_snapshot(lease, offset, requested)
        if read.is_err():
            return _snapshot_read_failure_v1(
                table, lease, "signed-catalog-snapshot-read-failed")
        val chunk = read.unwrap()
        if chunk.len() != requested or
            not sha256_stream_v1_update(digest_stream, chunk):
            return _snapshot_read_failure_v1(
                table, lease, "signed-catalog-snapshot-short-read")
        for byte in chunk:
            bytes.push(byte)
        offset = offset + requested

    val eof = table.read_stable_snapshot(
        lease, offset, SIGNED_CATALOG_SNAPSHOT_CHUNK_BYTES_V1)
    if eof.is_err():
        return _snapshot_read_failure_v1(
            table, lease, "signed-catalog-snapshot-eof-invalid")
    if eof.unwrap().len() != 0:
        return _snapshot_read_failure_v1(
            table, lease, "signed-catalog-snapshot-eof-invalid")
    val digest = sha256_stream_v1_finish_hex(digest_stream)
    if not digest.?:
        return _snapshot_read_failure_v1(
            table, lease, "signed-catalog-snapshot-hash-failed")
    val sealed = table.finish_stable_snapshot_v1(lease, digest.unwrap())
    if sealed.is_err():
        return _snapshot_read_failure_v1(
            table, lease, "signed-catalog-snapshot-seal-failed")
    val seal = sealed.unwrap()
    val closed = table.close_stable_snapshot(lease)
    if closed.is_err():
        return Err("signed-catalog-snapshot-cleanup-indeterminate")
    Ok(SignedCatalogSnapshotReadV1(bytes: bytes, seal: seal))
