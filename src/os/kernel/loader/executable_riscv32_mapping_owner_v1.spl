# Pure, non-authorizing RV32 process-image readiness and evidence owner.
#
# The authenticated loader registry remains the sole authority owner. This
# module only validates immutable ELF-derived handle evidence and publishes the
# ABI constants consumed by process-image construction.

use std.common.contracts.execution.simpleos_executable_admission_v1.{
    ExecutableImageHandleV1, executable_image_handle_validate,
    executable_image_max_load_ranges
}

val RISCV32_USER_LIMIT_V1: u64 = 0x0000000080000000u64
val RISCV32_STACK_WORD_BYTES_V1: u64 = 4u64
val RISCV32_PAGE_SIZE_V1: u64 = 4096u64

fn _riscv32_page_start_v1(value: u64) -> u64:
    value & 0xFFFFFFFFFFFFF000u64

fn _riscv32_page_end_v1(value: u64) -> u64:
    if value % RISCV32_PAGE_SIZE_V1 == 0u64:
        return value
    value + (RISCV32_PAGE_SIZE_V1 - value % RISCV32_PAGE_SIZE_V1)

pub(package) fn executable_riscv32_process_image_ready_v1() -> bool:
    # ELF32 parsing, four-byte initial-stack serialization, retained Sv32
    # mapping, task-bound transfer, U-mode handoff, and terminal release are
    # all owned by the authenticated RV32 execution path.
    true

pub(package) fn executable_riscv32_initial_stack_word_size_v1() -> u64:
    RISCV32_STACK_WORD_BYTES_V1

pub(package) fn executable_riscv32_authenticated_mapping_evidence_v1(
    handle: ExecutableImageHandleV1,
    entry_point: u64
) -> bool:
    """Validate exact authenticated RV32 ELF layout evidence without consuming it."""
    if not executable_image_handle_validate(handle).ok:
        return false
    if (handle.target.os != "simpleos" or
        handle.target.arch != "riscv32" or
        handle.target.abi != "simpleos" or
        handle.consumed):
        return false
    val ranges = handle.verified_load_ranges
    if ranges.len() == 0 or ranges.len() > executable_image_max_load_ranges():
        return false
    var entry_covered = false
    var index = 0
    while index < ranges.len():
        val load_range = ranges[index]
        if (load_range.memory_size == 0u64 or
            load_range.file_size > load_range.memory_size or
            load_range.writable and load_range.executable):
            return false
        if (load_range.file_offset % RISCV32_PAGE_SIZE_V1 !=
            load_range.virtual_address % RISCV32_PAGE_SIZE_V1):
            return false
        if (load_range.memory_size > RISCV32_USER_LIMIT_V1 or
            load_range.virtual_address >
                RISCV32_USER_LIMIT_V1 - load_range.memory_size):
            return false
        val range_end = load_range.virtual_address + load_range.memory_size
        if range_end == 0u64 or range_end > RISCV32_USER_LIMIT_V1:
            return false
        val page_start = _riscv32_page_start_v1(load_range.virtual_address)
        val page_end = _riscv32_page_end_v1(range_end)
        if page_start < RISCV32_PAGE_SIZE_V1 or page_end > RISCV32_USER_LIMIT_V1:
            return false
        var earlier = 0
        while earlier < index:
            val earlier_range = ranges[earlier]
            val earlier_start = _riscv32_page_start_v1(
                earlier_range.virtual_address)
            val earlier_end = _riscv32_page_end_v1(
                earlier_range.virtual_address + earlier_range.memory_size)
            if page_start < earlier_end and earlier_start < page_end:
                return false
            earlier = earlier + 1
        if (load_range.executable and
            entry_point >= load_range.virtual_address and
            entry_point < range_end):
            entry_covered = true
        index = index + 1
    entry_point != 0u64 and entry_covered

export executable_riscv32_process_image_ready_v1
export executable_riscv32_initial_stack_word_size_v1
export executable_riscv32_authenticated_mapping_evidence_v1
