"""Architecture-neutral filesystem-exec capability pouch construction."""

use os.kernel.types.capability_types.{CapabilityKind, CapabilitySet, CapabilityToken}
use os.kernel.loader.server_launch_grants.{
    SIMPLEOS_SERVER_EXECUTABLE_V1, server_launch_grants_v1
}
use os.kernel.loader.dbd_launch_grants_v1.{
    SIMPLEOS_DBD_EXECUTABLE_V1, dbd_launch_grants_v1
}
use os.kernel.loader.web_launch_grants.{
    SIMPLEOS_WEB_EXECUTABLE_V1, SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1,
    web_launch_grants_v1
}

fn _fs_exec_token_v1(kind: CapabilityKind, owner: u64, token_id: u64) -> CapabilityToken:
    CapabilityToken(kind: kind, generation: token_id, owner: owner,
        token_id: token_id, parent_token_id: 0u64, depth: 0)

pub fn fs_exec_launch_caps_with_launch_v1(
    path: text, argv: [text], envp: [text], owner: u64
) -> CapabilitySet:
    """Mint only a canonical service pouch or the non-listening generic pouch."""
    var tokens: [CapabilityToken] = []
    var next_id: u64 = 1u64
    val server = path == SIMPLEOS_SERVER_EXECUTABLE_V1 and argv.len() == 1 and
        argv[0] == SIMPLEOS_SERVER_EXECUTABLE_V1 and envp.len() == 0
    val dbd = path == SIMPLEOS_DBD_EXECUTABLE_V1 and argv.len() == 1 and
        argv[0] == SIMPLEOS_DBD_EXECUTABLE_V1 and envp.len() == 0
    val web = path == SIMPLEOS_WEB_EXECUTABLE_V1 and argv.len() == 1 and
        argv[0] == SIMPLEOS_WEB_EXECUTABLE_V1 and envp.len() == 0 and
        SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1 != 0u32
    if server or dbd or web:
        # Keep this as ordinary branch assignment rather than a conditional
        # expression: freestanding launch code must retain one concrete pouch
        # owner per service image.
        var grants = server_launch_grants_v1(path)
        if dbd:
            grants = dbd_launch_grants_v1(path)
        elif web:
            grants = web_launch_grants_v1(
                path, SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1)
        for grant in grants:
            tokens.push(_fs_exec_token_v1(grant.requested, owner, next_id))
            next_id = next_id + 1u64
        return CapabilitySet(caps: tokens, is_pledged: true)
    tokens.push(_fs_exec_token_v1(CapabilityKind.NetSocketCreate, owner, next_id))
    next_id = next_id + 1u64
    tokens.push(_fs_exec_token_v1(CapabilityKind.NetConnect(port: 0), owner, next_id))
    next_id = next_id + 1u64
    tokens.push(_fs_exec_token_v1(CapabilityKind.FileExec(path_prefix: path), owner, next_id))
    next_id = next_id + 1u64
    tokens.push(_fs_exec_token_v1(CapabilityKind.FileRead(path_prefix: path), owner, next_id))
    next_id = next_id + 1u64
    for arg in argv:
        if arg.starts_with("/") and arg != path:
            tokens.push(_fs_exec_token_v1(CapabilityKind.FileRead(path_prefix: arg), owner, next_id))
            next_id = next_id + 1u64
    CapabilitySet(caps: tokens, is_pledged: true)

pub fn fs_exec_launch_caps_attenuated_by_v1(
    required: CapabilitySet, minted: CapabilitySet
) -> bool:
    """Require every exact runtime request to remain within minted authority."""
    if not required.is_pledged or not minted.is_pledged:
        return false
    for token in required.caps:
        if not minted.has(token.kind):
            return false
    true
