# Managed workload image identity verification.
#
# A compiled SpawnSpec is descriptive until it is bound to the exact bytes that
# become a UserProcessImage. This module makes `blake3:<lowercase-hex>` the
# accepted content-address form for managed launches.

use os.crypto.blake3.{blake3}

fn _image_hash_hex_digit(nibble: u8) -> text:
    "0123456789abcdef".substring(nibble as i64, nibble as i64 + 1)

pub fn workload_image_blake3_hash(bytes: [u8]) -> text:
    """Return the canonical content address for executable bytes."""
    val digest = blake3(bytes)
    var out = "blake3:"
    var i = 0
    while i < digest.len():
        val byte = digest[i]
        out = out + _image_hash_hex_digit((byte >> 4) & 15u8)
        out = out + _image_hash_hex_digit(byte & 15u8)
        i = i + 1
    out

pub fn workload_image_hash_is_canonical(declared: text) -> bool:
    """Accept only lowercase `blake3:` plus a 32-byte hexadecimal digest."""
    if not declared.starts_with("blake3:") or declared.len() != 71:
        return false
    var i = 7
    while i < declared.len():
        val ch = declared.substring(i, i + 1)
        if not "0123456789abcdef".contains(ch):
            return false
        i = i + 1
    true

pub fn workload_image_hash_matches(declared: text, bytes: [u8]) -> bool:
    """Fail closed on absent, wrong-algorithm, malformed, or mismatched hash."""
    if not workload_image_hash_is_canonical(declared):
        return false
    declared == workload_image_blake3_hash(bytes)
