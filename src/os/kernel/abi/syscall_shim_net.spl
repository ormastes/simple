# Network syscall shims — split from syscall_shim.spl (Wave 10F).
# Contains spl_handle_* for network syscalls 70–77.

use os.kernel.ipc.syscall.{_handle_net_if_config}
use os.kernel.ipc.syscall_net_portable_v1.{
    portable_net_bind_args_checked_v1,
    portable_net_capability_allowed_v1,
    portable_net_dispatch_v1
}
use os.kernel.abi.syscall_shim.{_make_args}
use os.kernel.abi.syscall_shim.{g_shim_scheduler, g_shim_ipc}
use os.kernel.types.capability_types.{CapabilityKind}
val _EPERM: i64 = -1

@export("C", name: "spl_shim_current_task_id")
fn spl_shim_current_task_id() -> u64:
    g_shim_scheduler.get_current().id

@export("C", name: "spl_shim_net_capability_check")
fn spl_shim_net_capability_check(syscall_id: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> i64:
    """Legacy ARM64 direct-path precheck; exact shim policy lives in the
    portable socket owner below. ARM64 direct binding still needs migration.
    """
    val caller = g_shim_scheduler.get_current()
    var ipc = g_shim_ipc
    val allowed = match syscall_id:
        case 70: ipc.cap_check(caller, CapabilityKind.NetConnect(port: 0))
        case 71: ipc.cap_check(caller, CapabilityKind.NetListen(port: 0))
        case 72: ipc.cap_check(caller, CapabilityKind.NetListen(port: 0))
        case 73: ipc.cap_check(caller, CapabilityKind.NetConnect(port: 0))
        case 74: ipc.cap_check(caller, CapabilityKind.NetListen(port: 0))
        case 75: ipc.cap_check(caller, CapabilityKind.NetConnect(port: 0))
        case 76: ipc.cap_check(caller, CapabilityKind.NetConnect(port: 0))
        case 77: ipc.cap_check(caller, CapabilityKind.NetRaw)
        case _: false
    if allowed: 0 else: _EPERM

# ===========================================================================
# syscall 70 — net_socket   [IMPLEMENTED]
#
# a0 = domain (AF_INET=2, AF_INET6=10, etc.)
# a1 = type (SOCK_STREAM=1, SOCK_DGRAM=2, etc.)
# a2 = protocol (0 = auto)
# a3..a5 unused
# returns socket fd on success, negative errno on failure
# ===========================================================================
@export("C", name: "spl_handle_net_socket")
fn spl_handle_net_socket(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64:
    """Strong override for the weak spl_handle_net_socket stub.

    Routes through the portable checked owner to posix_socket(), which allocates
    a local POSIX fd without depending on netstack IPC or a NIC driver
    (loopback traffic on 127.0.0.1 is served entirely by
    os.kernel.net.loopback_socket; see posix_bind/posix_connect).

    Previously forwarded to _handle_net_socket() -> _forward_net_ipc() in
    os.kernel.ipc.syscall_net.spl, which unconditionally returned -ENOSYS
    ("kernel forwarding path is not fully wired" -- see that file's comment).
    That was the exact bug: the app-facing socket() syscall always failed
    with ENOSYS regardless of destination. Syscall number 70: create a
    network socket.
    """
    val args = _make_args(70u64, a0, a1, a2, a3, a4, a5)
    if not portable_net_capability_allowed_v1(args, g_shim_scheduler, g_shim_ipc):
        return _EPERM
    portable_net_dispatch_v1(args).value

# ===========================================================================
# syscall 71 — net_bind   [IMPLEMENTED]
#
# a0 = socket fd
# a1 = pointer to sockaddr struct (user VA)
# a2 = sockaddr length
# a3..a5 unused
# returns 0 on success, negative errno on failure
# ===========================================================================
@export("C", name: "spl_handle_net_bind")
fn spl_handle_net_bind(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64:
    """Strong override for the weak spl_handle_net_bind stub.

    The portable owner validates and copies the bounded POSIX sockaddr_in
    once, checks exact bind authority, then routes to the socket owner. It retains all mutable
    socket state; the caller pointer is never retained.
    Syscall number 71: bind a socket to a local address and port.
    """
    val args = _make_args(71u64, a0, a1, a2, a3, a4, a5)
    portable_net_bind_args_checked_v1(args, g_shim_scheduler, g_shim_ipc).value

# ===========================================================================
# syscall 72 — net_listen   [IMPLEMENTED]
#
# a0 = socket fd
# a1 = backlog (max pending connections)
# a2..a5 unused
# returns 0 on success, negative errno on failure
# ===========================================================================
@export("C", name: "spl_handle_net_listen")
fn spl_handle_net_listen(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64:
    """Strong override for the weak spl_handle_net_listen stub.

    Checks the descriptor's bound port before using the shared socket owner.
    Syscall number 72: mark a socket as passive (listening for connections).
    """
    val args = _make_args(72u64, a0, a1, a2, a3, a4, a5)
    if not portable_net_capability_allowed_v1(args, g_shim_scheduler, g_shim_ipc):
        return _EPERM
    portable_net_dispatch_v1(args).value

# ===========================================================================
# syscall 73 — net_connect   [IMPLEMENTED]
#
# a0 = socket fd
# a1 = pointer to sockaddr struct (user VA)
# a2 = sockaddr length
# a3..a5 unused
# returns 0 on success, negative errno on failure
# ===========================================================================
@export("C", name: "spl_handle_net_connect")
fn spl_handle_net_connect(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64:
    """Strong override for the weak spl_handle_net_connect stub.

    Checks caller authority, then copies the bounded sockaddr through the
    shared socket owner.
    Syscall number 73: initiate a connection to a remote address.
    """
    val args = _make_args(73u64, a0, a1, a2, a3, a4, a5)
    if not portable_net_capability_allowed_v1(args, g_shim_scheduler, g_shim_ipc):
        return _EPERM
    portable_net_dispatch_v1(args).value

# ===========================================================================
# syscall 74 — net_accept   [IMPLEMENTED]
#
# a0 = listening socket fd
# a1 = pointer to sockaddr output buffer (user VA, may be 0)
# a2 = pointer to sockaddr length output (user VA, may be 0)
# a3..a5 unused
# returns new connected socket fd on success, negative errno on failure
# ===========================================================================
@export("C", name: "spl_handle_net_accept")
fn spl_handle_net_accept(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64:
    """Strong override for the weak spl_handle_net_accept stub.

    Address output is not yet exposed by the shared socket owner. Null output
    pointers, the common HTTP-server form, are supported; a requested peer
    address fails explicitly rather than returning fabricated bytes.
    Syscall number 74: accept an incoming connection on a listening socket.
    """
    val args = _make_args(74u64, a0, a1, a2, a3, a4, a5)
    if not portable_net_capability_allowed_v1(args, g_shim_scheduler, g_shim_ipc):
        return _EPERM
    portable_net_dispatch_v1(args).value

# ===========================================================================
# syscall 75 — net_send_to   [IMPLEMENTED]
#
# a0 = socket fd
# a1 = pointer to data buffer (user VA)
# a2 = data length in bytes
# a3 = pointer to destination sockaddr (user VA, 0 for connected sockets)
# a4 = sockaddr length (0 for connected sockets)
# a5 = flags
# returns bytes sent on success, negative errno on failure
# ===========================================================================
@export("C", name: "spl_handle_net_send_to")
fn spl_handle_net_send_to(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64:
    """Strong override for the weak spl_handle_net_send_to stub.

    Checks the accepted-listener or outbound descriptor authority before
    sending through the shared socket owner.
    Destination-address sendto remains explicit unsupported behavior.
    Syscall number 75: send data through a socket to a specified address.
    """
    val args = _make_args(75u64, a0, a1, a2, a3, a4, a5)
    if not portable_net_capability_allowed_v1(args, g_shim_scheduler, g_shim_ipc):
        return _EPERM
    portable_net_dispatch_v1(args).value

# ===========================================================================
# syscall 76 — net_recv_from   [IMPLEMENTED]
#
# a0 = socket fd
# a1 = pointer to receive buffer (user VA)
# a2 = buffer capacity in bytes
# a3 = pointer to source sockaddr output (user VA, may be 0)
# a4 = pointer to sockaddr length output (user VA, may be 0)
# a5 = flags
# returns bytes received on success, negative errno on failure
# ===========================================================================
@export("C", name: "spl_handle_net_recv_from")
fn spl_handle_net_recv_from(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64:
    """Strong override for the weak spl_handle_net_recv_from stub.

    Checks the accepted-listener or outbound descriptor authority before
    receiving through the shared socket owner.
    Source-address output remains explicit unsupported behavior.
    Syscall number 76: receive data from a socket along with source address.
    """
    val args = _make_args(76u64, a0, a1, a2, a3, a4, a5)
    if not portable_net_capability_allowed_v1(args, g_shim_scheduler, g_shim_ipc):
        return _EPERM
    portable_net_dispatch_v1(args).value

# ===========================================================================
# syscall 77 — net_if_config   [IMPLEMENTED]
#
# a0 = pointer to interface name string (user VA)
# a1 = interface name length
# a2 = pointer to config struct (user VA)
# a3..a5 unused
# returns 0 on success, negative errno on failure
# ===========================================================================
@export("C", name: "spl_handle_net_if_config")
fn spl_handle_net_if_config(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64:
    """Strong override for the weak spl_handle_net_if_config stub.

    Forwards to _handle_net_if_config() in syscall.spl.
    Syscall number 77: configure a network interface (IP, MTU, flags).
    """
    val args = _make_args(77, a0, a1, a2, a3, a4, a5)
    if not g_shim_ipc.cap_check(g_shim_scheduler.get_current(), CapabilityKind.NetRaw):
        return _EPERM
    val result = _handle_net_if_config(args)
    result.value
