# ---------------------------------------------------------------------------
# Module-level singletons — populated once at boot by shim_init().
# No get_global_* accessors exist yet in the kernel; these vars serve that
# role for the shim layer.  Reentrancy: safe for single-core baremetal;
# multi-core will need spinlocks (Wave 10E).
# ---------------------------------------------------------------------------
fn _shim_empty_ready_queue() -> ReadyQueue:
    var entries: [u64] = []
    var i: i32 = 0
    while i < 256:
        entries.push(0u64)
        i = i + 1
    ReadyQueue(entries: entries, head: 0, tail: 0, count: 0, capacity: 256)

fn _shim_empty_cpu_runqueue() -> CpuRunQueue:
    CpuRunQueue(
        cpu_id: 0u32,
        deadline_queue: _shim_empty_ready_queue(),
        rt_queue: _shim_empty_ready_queue(),
        fair_queue: _shim_empty_ready_queue(),
        background_queue: _shim_empty_ready_queue(),
        idle_queue: _shim_empty_ready_queue(),
        runnable_count: 0,
        weighted_load: 0,
        latency_debt: 0,
        migration_pressure: 0,
        cache_hot_wakeups: 0
    )

fn _shim_bootstrap_scheduler() -> Scheduler:
    """Cycle-safe bootstrap Scheduler constructed without reading external module `val`s."""
    var tasks: [TaskControlBlock?] = []
    var deadline_remaining_ns_by_slot: [u64] = []
    var deadline_period_start_ns_by_slot: [u64] = []
    var deadline_miss_count_by_slot: [u64] = []
    var deadline_overrun_count_by_slot: [u64] = []
    var rt_base_priority_by_slot: [i64] = []
    var i: i32 = 0
    while i < 256:
        tasks.push(None)
        deadline_remaining_ns_by_slot.push(0u64)
        deadline_period_start_ns_by_slot.push(0u64)
        deadline_miss_count_by_slot.push(0u64)
        deadline_overrun_count_by_slot.push(0u64)
        rt_base_priority_by_slot.push(SCHED_RT_BASE_PRIORITY_UNSET)
        i = i + 1
    var queues: [ReadyQueue] = []
    var p: i32 = 0
    while p < 5:
        queues.push(_shim_empty_ready_queue())
        p = p + 1
    Scheduler(
        tasks: tasks,
        current: TaskId(id: 0u64),
        current_slot: -1i32,
        current_by_cpu: [TaskId(id: 0u64)],
        preempt_pending_by_cpu: [None],
        ready_queues: queues,
        cpu_runqueues: [_shim_empty_cpu_runqueue()],
        topology: scheduler_flat_topology(1u32),
        rt_runtime_ns_by_cpu: [0u64],
        rt_period_ns_by_cpu: [0u64],
        rt_consumed_ns_by_cpu: [0u64],
        rt_replenish_ns_by_cpu: [0u64],
        rt_throttled_by_cpu: [false],
        deadline_remaining_ns_by_slot: deadline_remaining_ns_by_slot,
        deadline_period_start_ns_by_slot: deadline_period_start_ns_by_slot,
        deadline_miss_count_by_slot: deadline_miss_count_by_slot,
        deadline_overrun_count_by_slot: deadline_overrun_count_by_slot,
        rt_base_priority_by_slot: rt_base_priority_by_slot,
        trace_events: [],
        trace_head: 0,
        trace_count: 0,
        tick_count: 0u64,
        next_task_id: 1u64,
        executable_adoption_state: SchedulerExecutableAdoptionOwnerStateV1.Idle,
        executable_adoption_pid: 0u64,
        executable_adoption_token_slot: -1i64,
        executable_adoption_token_generation: 0u64,
        executable_adoption_token_nonce: 0u64,
        green_execution_state: GreenCarrierExecutionState(
            current_task_by_cpu: [0u64],
            context_switches_by_cpu: [0i64],
            ticks_remaining_by_cpu: [2i64],
            total_context_switches: 0i64,
            rejected_intents: 0i64
        ),
        green_parallelism_state: GreenCarrierParallelismState(
            requested_limit: 1i64,
            active_limit: 1i64,
            topology_cpu_count: 1i64,
            reason: "default_topology_limit"
        )
    )

var g_shim_scheduler: Scheduler = _shim_bootstrap_scheduler()
var g_shim_ipc: IpcManager = IpcManager.new()
var g_shim_klog: KernelLog = KernelLog.new(256)
var g_shim_server_startup_runtime_owner_available_v1: bool = false

# ---------------------------------------------------------------------------
# DCE keepalive: force the compiler to retain all spl_handle_* functions
# even though they're only reached from C code via the weak-override link.
# Without this, --entry-closure DCE drops the whole file.
# ---------------------------------------------------------------------------
fn _shim_keepalive() -> u64:
    """Returns the sum of function addresses for every spl_handle_* exported
    by this module. Keep baremetal/SimpleOS symbol retention intact while
    returning 0 on interpreter/host builds where fn->u64 casts are invalid."""
    @when(baremetal or simpleos):
    var total: u64 = 0
    total = total + (spl_handle_debug_write as u64)
    total = total + (spl_handle_exit as u64)
    total = total + (spl_handle_yield as u64)
    total = total + (spl_handle_spawn as u64)
    total = total + (spl_handle_wait as u64)
    total = total + (spl_handle_getpid as u64)
    total = total + (spl_handle_list_tasks as u64)
    total = total + (spl_handle_get_task_info as u64)
    total = total + (spl_handle_signal as u64)
    total = total + (spl_handle_set_priority as u64)
    total = total + (spl_handle_get_parent_pid as u64)
    total = total + (spl_handle_mmap as u64)
    total = total + (spl_handle_munmap as u64)
    total = total + (spl_handle_mprotect as u64)
    total = total + (spl_handle_spawn_binary as u64)
    total = total + (spl_handle_enter_user_blocking as u64)
    total = total + (spl_handle_ipc_destroy_port as u64)
    total = total + (spl_handle_ipc_send as u64)
    total = total + (spl_handle_ipc_recv as u64)
    total = total + (spl_handle_ipc_send_owned_v1 as u64)
    total = total + (spl_handle_ipc_recv_owned_v1 as u64)
    total = total + (spl_handle_ipc_create_port as u64)
    total = total + (spl_handle_ipc_connect as u64)
    total = total + (spl_handle_notification_create as u64)
    total = total + (spl_handle_notification_signal as u64)
    total = total + (spl_handle_notification_wait as u64)
    total = total + (spl_handle_notification_poll as u64)
    total = total + (spl_handle_notification_destroy as u64)
    total = total + (spl_handle_notification_wait_any as u64)
    total = total + (spl_handle_file_open as u64)
    total = total + (spl_handle_file_read as u64)
    total = total + (spl_handle_file_write as u64)
    total = total + (spl_handle_file_close as u64)
    total = total + (spl_handle_file_stat as u64)
    total = total + (spl_handle_file_mkdir as u64)
    total = total + (spl_handle_file_readdir as u64)
    total = total + (spl_handle_mount as u64)
    total = total + (spl_handle_unmount as u64)
    total = total + (spl_handle_unlink as u64)
    total = total + (spl_handle_pledge as u64)
    total = total + (spl_handle_unveil as u64)
    total = total + (spl_handle_cap_grant as u64)
    total = total + (spl_handle_ftruncate as u64)
    total = total + (spl_handle_rename as u64)
    total = total + (spl_handle_rmdir as u64)
    total = total + (spl_handle_lseek as u64)
    total = total + (spl_handle_getcwd as u64)
    total = total + (spl_handle_chdir as u64)
    total = total + (spl_handle_file_sync as u64)
    total = total + (spl_shim_file_capability_check as u64)
    total = total + (spl_handle_clock_gettime as u64)
    total = total + (spl_handle_sleep as u64)
    total = total + (spl_handle_fork as u64)
    total = total + (spl_handle_exec as u64)
    total = total + (spl_handle_waitpid as u64)
    total = total + (spl_handle_pipe as u64)
    total = total + (spl_handle_dup2 as u64)
    total = total + (spl_handle_dup as u64)
    total = total + (spl_handle_poll as u64)
    total = total + (spl_handle_fcntl as u64)
    total = total + (spl_handle_net_socket as u64)
    total = total + (spl_handle_net_bind as u64)
    total = total + (spl_handle_net_listen as u64)
    total = total + (spl_handle_net_connect as u64)
    total = total + (spl_handle_net_accept as u64)
    total = total + (spl_handle_net_send_to as u64)
    total = total + (spl_handle_net_recv_from as u64)
    total = total + (spl_handle_net_if_config as u64)
    total = total + (spl_shim_net_capability_check as u64)
    total = total + (_ka_net_direct_socket_check as u64)
    total = total + (_ka_net_direct_bind_check as u64)
    total = total + (_ka_net_direct_listener_check as u64)
    total = total + (_ka_net_direct_outbound_check as u64)
    total = total + (_ka_current_task_id as u64)
    total = total + (spl_handle_dev_enumerate as u64)
    total = total + (spl_handle_dev_get_info as u64)
    total = total + (spl_handle_map_bar as u64)
    total = total + (spl_handle_alloc_dma as u64)
    total = total + (spl_handle_free_dma as u64)
    total = total + (spl_handle_log_write as u64)
    total = total + (spl_handle_log_read as u64)
    total = total + (spl_handle_sysinfo as u64)
    total = total + (spl_handle_get_hostname as u64)
    total = total + (spl_handle_set_hostname as u64)
    total = total + (spl_handle_device_grant as u64)
    total = total + (spl_handle_privctl as u64)
    total = total + (spl_handle_mem_grant as u64)
    total = total + (spl_handle_mem_revoke as u64)
    total = total + (spl_handle_safecopy_from as u64)
    total = total + (spl_handle_safecopy_to as u64)
    total = total + (spl_handle_brk as u64)
    total = total + (spl_handle_system_reboot as u64)
    total = total + (spl_handle_sys_mmap as u64)
    total = total + (spl_handle_sys_munmap as u64)
    total = total + (spl_handle_schedule as u64)
    total = total + (spl_handle_schedctl as u64)
    total = total + (spl_handle_fs_pread_registered_v1 as u64)
    total = total + (spl_handle_fs_pwrite_registered_v1 as u64)
    total = total + (spl_handle_root_service_spawn as u64)
    total = total + (spl_handle_root_service_stop as u64)
    total = total + (spl_handle_server_startup_evidence_consume_v1 as u64)
    total = total + (spl_handle_uname as u64)
    total
    @else:
    0u64
    @end

# A module slot keeps a real native relocation to the address graph. Boot
# stores the function value without executing native-only pointer arithmetic.
# An unused local reference can be discarded by optimization instead.
var _g_shim_keepalive: fn() -> u64 = _shim_keepalive

@export("C", name: "shim_init")
fn shim_init(sched: Scheduler, ipc: IpcManager, klog: KernelLog):
    """Boot-time initializer.  Call once before any SYSCALL can arrive."""
    g_shim_scheduler = sched
    g_shim_ipc = ipc
    g_shim_klog = klog
    shim_positioned_reset_v1()
    # Retain the exported providers without invoking non-baremetal fn->u64 casts
    # in interpreter/host builds; _shim_keepalive() returns 0 outside baremetal.
    _g_shim_keepalive = _shim_keepalive
    val _keepalive_probe = _shim_keepalive()

pub(package) fn shim_server_startup_runtime_owner_enable_v1():
    g_shim_server_startup_runtime_owner_available_v1 = true

pub(package) fn shim_server_startup_runtime_owner_disable_v1():
    g_shim_server_startup_runtime_owner_available_v1 = false

# ---------------------------------------------------------------------------
# Helper: pack six u64 values into a SyscallArgs with a known syscall id.
# ---------------------------------------------------------------------------
fn _make_args(id: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> SyscallArgs:
    SyscallArgs(id: id, arg0: a0, arg1: a1, arg2: a2, arg3: a3, arg4: a4, arg5: a5)

@export("C", name: "spl_handle_server_startup_evidence_consume_v1")
fn spl_handle_server_startup_evidence_consume_v1(
    a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64
) -> i64:
    """Consume ABI 116 only while the authenticated scheduler owner is live."""
    if not g_shim_server_startup_runtime_owner_available_v1: return -38
    _handle_server_startup_evidence_consume(g_shim_scheduler).value

