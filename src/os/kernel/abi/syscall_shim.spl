# Pull in sub-modules so their @export("C") symbols are linked.
# WORKAROUND(compiled_hir_module_form_use_bare_names_2026-11-19): the per-name
# `.{...}` imports below exist only because compiled HIR does not bind bare
# names from a module-form `use`. Remove them when that bug is fixed.
use os.kernel.abi.syscall_shim_process
use os.kernel.abi.syscall_shim_process.{spl_handle_debug_write, spl_handle_enter_user_blocking, spl_handle_exit, spl_handle_get_parent_pid, spl_handle_get_task_info, spl_handle_getpid, spl_handle_list_tasks, spl_handle_mmap, spl_handle_mprotect, spl_handle_munmap, spl_handle_set_priority, spl_handle_signal, spl_handle_spawn, spl_handle_spawn_binary, spl_handle_wait, spl_handle_yield}
