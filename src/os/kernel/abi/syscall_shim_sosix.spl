# SOSIX syscall shims — optional strong overrides for the SOSIX interface
# ids. Contains spl_handle_uname (92). The C boot layer declares each symbol
# weak and dispatches with arm64_dispatch_optional_shim; when this module is
# linked, these strong definitions override the weak defaults and forward to
# the sosix service owners under src/os/services/sosix/.

use os.kernel.types.syscall_types.{SyscallArgs, SyscallResult}
use os.services.sosix.uname_v1.{sosix_uname_handle_v1}
use os.kernel.abi.syscall_shim.{_make_args}

# ===========================================================================
# syscall 92 — uname   [IMPLEMENTED]
#
# a0 = pointer to output struct utsname (user VA, 5 fields x 65 bytes)
# a1..a5 unused
# returns 0 on success, -EINVAL on null, -EFAULT-family on bad pointer
# ===========================================================================
@export("C", name: "spl_handle_uname")
fn spl_handle_uname(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64:
    """Strong override for the weak spl_handle_uname stub.

    Forwards to sosix_uname_handle_v1() in services/sosix. Syscall number 92:
    fill the caller's struct utsname (sysname "SimpleOS", release from
    os.packages.os_packages.os_version). Identity contract:
    doc/05_design/os/sosix_posix_interface_v1.md section 5.
    """
    val args = _make_args(92, a0, a1, a2, a3, a4, a5)
    val result = sosix_uname_handle_v1(args)
    result.value
