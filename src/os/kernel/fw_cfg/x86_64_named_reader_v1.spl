# QEMU fw_cfg named-file reader for the x86_64 I/O-port transport.
#
# The device is untrusted input: directory cardinality, framing, names and
# payload sizes are validated before allocation or payload reads.  The pure
# directory helper is exported so hosted tests do not execute privileged I/O.

use os.kernel.fw_cfg.read_result_v1.{SimpleOsFwCfgReadV1}
use os.kernel.fw_cfg.directory_parser_v1.{
    fw_cfg_max_directory_entries_v1,
    fw_cfg_max_payload_bytes_v1,
    fw_cfg_parse_directory_v1,
    fw_cfg_valid_exact_name_v1,
}
use os.kernel.fw_cfg.directory_batch_parser_v1.{
    FwCfgNamedLimitV1,
    fw_cfg_parse_directory_batch_v1,
    fw_cfg_validate_batch_requests_v1,
}

extern fn rt_port_inb(port: u64) -> u64
extern fn rt_port_outw(port: u64, value: u64)

pub class SimpleOsFwCfgDirectoryMatchV1:
    ok: bool
    selector: u16
    size: u64
    reason: text

fn _fw_cfg_directory_selector() -> u16: 0x19u16
fn _fw_cfg_signature_selector() -> u16: 0u16
fn _fw_cfg_selector_port() -> u64: 0x510u64
fn _fw_cfg_data_port() -> u64: 0x511u64
fn _fw_cfg_entry_size() -> i64: 64

fn _read_reject(reason: text) -> SimpleOsFwCfgReadV1:
    SimpleOsFwCfgReadV1(ok: false, bytes: [], reason: reason)

fn _reject_each(
    requests: [FwCfgNamedLimitV1], reason: text
) -> [SimpleOsFwCfgReadV1]:
    var reads: [SimpleOsFwCfgReadV1] = [SimpleOsFwCfgReadV1(
        ok: false, bytes: [], reason: "unresolved"
    ); requests.len()]
    var index: i64 = 0
    while index < requests.len():
        reads[index] = _read_reject(reason)
        index = index + 1
    reads

fn _be32(data: [u8], offset: i64) -> u64:
    (data[offset].to_u64() << 24) |
        (data[offset + 1].to_u64() << 16) |
        (data[offset + 2].to_u64() << 8) |
        data[offset + 3].to_u64()

pub fn x86_64_fw_cfg_find_named_v1(
    directory: [u8], name: text, max_len: u64
) -> SimpleOsFwCfgDirectoryMatchV1:
    val match = fw_cfg_parse_directory_v1(directory, name, max_len)
    SimpleOsFwCfgDirectoryMatchV1(
        ok: match.ok, selector: match.selector, size: match.size.to_u64(),
        reason: match.reason
    )

fn _select(selector: u16):
    # Unlike the directory fields, the x86 I/O selector register is LE.
    rt_port_outw(_fw_cfg_selector_port(), selector.to_u64())

fn _read_data_byte() -> u8:
    rt_port_inb(_fw_cfg_data_port()).to_u8()

fn _read_selected_bytes(length: u64) -> [u8]:
    var bytes: [u8] = [0u8; length.to_i64()]
    var index: u64 = 0u64
    while index < length:
        bytes[index.to_i64()] = _read_data_byte()
        index = index + 1u64
    bytes

fn _read_signature() -> [u8]:
    _select(_fw_cfg_signature_selector())
    _read_selected_bytes(4u64)

fn _read_directory() -> [u8]:
    _select(_fw_cfg_directory_selector())
    val count_bytes = _read_selected_bytes(4u64)
    if count_bytes.len() != 4:
        return count_bytes
    val count = _be32(count_bytes, 0)
    if count > fw_cfg_max_directory_entries_v1().to_u64():
        return count_bytes
    val directory_length = 4u64 + count * _fw_cfg_entry_size().to_u64()
    var directory: [u8] = [0u8; directory_length.to_i64()]
    directory[0] = count_bytes[0]
    directory[1] = count_bytes[1]
    directory[2] = count_bytes[2]
    directory[3] = count_bytes[3]
    var index: u64 = 4u64
    while index < directory_length:
        directory[index.to_i64()] = _read_data_byte()
        index = index + 1u64
    directory

fn _read_payload(selector: u16, length: u64) -> [u8]:
    _select(selector)
    _read_selected_bytes(length)

pub fn x86_64_fw_cfg_read_named_v1(
    name: text, max_len: u64
) -> SimpleOsFwCfgReadV1:
    if not fw_cfg_valid_exact_name_v1(name):
        return _read_reject("invalid-name")
    if max_len > fw_cfg_max_payload_bytes_v1():
        return _read_reject("invalid-max-bytes")

    val signature = _read_signature()
    if signature[0] != 0x51u8 or signature[1] != 0x45u8 or
       signature[2] != 0x4Du8 or signature[3] != 0x55u8:
        return _read_reject("device-signature-invalid")

    val directory = _read_directory()
    val found = x86_64_fw_cfg_find_named_v1(directory, name, max_len)
    if not found.ok:
        return _read_reject(found.reason)
    _select(found.selector)
    SimpleOsFwCfgReadV1(ok: true, bytes: _read_selected_bytes(found.size),
                        reason: "ok")

pub fn x86_64_fw_cfg_read_named_batch_with_readers_v1(
    requests: [FwCfgNamedLimitV1],
    signature_reader: fn() -> [u8],
    directory_reader: fn() -> [u8],
    payload_reader: fn(u16, u64) -> [u8],
) -> [SimpleOsFwCfgReadV1]:
    """Read a bounded named-file batch with one directory read and scan."""
    val request_check = fw_cfg_validate_batch_requests_v1(requests)
    if not request_check.ok:
        return _reject_each(requests, request_check.reason)
    val signature = signature_reader()
    if signature.len() != 4 or signature[0] != 0x51u8 or
       signature[1] != 0x45u8 or signature[2] != 0x4Du8 or
       signature[3] != 0x55u8:
        return _reject_each(requests, "device-signature-invalid")

    val directory = directory_reader()
    val batch = fw_cfg_parse_directory_batch_v1(directory, requests)
    if batch.matches.len() != requests.len():
        return _reject_each(requests, batch.reason)
    var reads: [SimpleOsFwCfgReadV1] = [SimpleOsFwCfgReadV1(
        ok: false, bytes: [], reason: "unresolved"
    ); requests.len()]
    var request_index: i64 = 0
    while request_index < batch.matches.len():
        val found = batch.matches[request_index]
        if found.ok:
            val payload = payload_reader(found.selector, found.size.to_u64())
            if payload.len().to_u64() == found.size.to_u64():
                reads[request_index] = SimpleOsFwCfgReadV1(
                    ok: true, bytes: payload, reason: "ok")
            else:
                reads[request_index] = _read_reject("truncated-payload")
        else:
            reads[request_index] = _read_reject(found.reason)
        request_index = request_index + 1
    reads

pub fn x86_64_fw_cfg_read_named_batch_v1(
    requests: [FwCfgNamedLimitV1]
) -> [SimpleOsFwCfgReadV1]:
    x86_64_fw_cfg_read_named_batch_with_readers_v1(
        requests, _read_signature, _read_directory, _read_payload)

export SimpleOsFwCfgDirectoryMatchV1
export x86_64_fw_cfg_find_named_v1
export x86_64_fw_cfg_read_named_v1
export x86_64_fw_cfg_read_named_batch_with_readers_v1
export x86_64_fw_cfg_read_named_batch_v1
