# Socket IPC transport ownership boundary.
#
# The byte-array runtime bridge is supplied by the x86_64 SimpleOS runtime.
# Other bare-metal targets must not acquire that unresolved symbol merely
# because architecture-neutral fd close dispatch imports socket_compat.

use os.kernel.errno.{ENOSYS}

@cfg(x86_64)
extern fn rt_ipc_send_bytes(port: u64, method: u64, data: [u8]) -> i64

@cfg(x86_64)
extern fn rt_ipc_recv_bytes(port: u64, max_len: i64) -> [u8]

@cfg(x86_64)
fn socket_ipc_send_bytes(port: u64, method: u64, data: [u8]) -> i64:
    rt_ipc_send_bytes(port, method, data)

@cfg(not(x86_64))
fn socket_ipc_send_bytes(port: u64, method: u64, data: [u8]) -> i64:
    # No target runtime owner exists. Report unsupported; never fabricate a
    # successful delivery or require a raw stub provider.
    val _port = port
    val _method = method
    val _data = data
    -(ENOSYS as i64)

@cfg(x86_64)
fn socket_ipc_recv_bytes(port: u64, max_len: i64) -> [u8]:
    rt_ipc_recv_bytes(port, max_len)

@cfg(not(x86_64))
fn socket_ipc_recv_bytes(port: u64, max_len: i64) -> [u8]:
    # An empty record is the existing socket_compat receive-error sentinel.
    val _port = port
    val _max_len = max_len
    []
