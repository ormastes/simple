use lib.common.string_core.{char_from_code}

@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_net_init() -> i64
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_net_tx_test() -> i64
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_net_rx_ready() -> i64
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_net_stats() -> i64
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_boot_tcp_bind(addr: text) -> i64
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_boot_tcp_bind_port(port: i64) -> i64
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_boot_tcp_accept_timeout(fd: i64, ms: i64) -> i64
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_boot_tcp_write_bytes(fd: i64, data: [u8]) -> i64
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_boot_tcp_send_ssh_banner(fd: i64) -> i64
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_boot_tcp_read_bytes(max_len: i64) -> [u8]
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_boot_tcp_read_bytes_for_fd(fd: i64, max_len: i64) -> [u8]
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_boot_tcp_read_ssh_plain_packet_payload(fd: i64) -> [u8]
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_boot_tcp_take_version_text(fd: i64) -> text
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_boot_tcp_take_version_bytes(fd: i64) -> [u8]
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_boot_tcp_close(fd: i64) -> i64
@unsafe(reason: "raw boot/runtime network support ABI", capabilities: [ffi])
extern fn rt_thread_sleep(ms: i64)

struct RtNetSocketEntry:
    fd: i64
    port: u16
    os_fd: i32
    listening: bool

var _rt_net_sockets: [RtNetSocketEntry] = []
var _rt_net_next_fd: i64 = 1000
var _rt_net_port_inited: bool = false
var _rt_net_last_plain_payload: [u8] = []
var _rt_net_last_plain_payload_len_value: u64 = 0
var _rt_net_bound_listener_fd: i64 = -1
var _rt_net_bound_listener_port: u16 = 0u16

val RT_NET_SSH_ENCRYPTED_BODY_MAX: u32 = 35000u32
val RT_NET_SSH_GCM_TAG_BYTES: u64 = 16u64
val RT_NET_SSH_LENGTH_HEADER_BYTES: u64 = 4u64
val RT_NET_READ_EXACT_MAX: u64 = 35016u64
val RT_NET_SOCKET_READ_MAX: i64 = 16777216

pub struct RtNetSshEncryptedReadPlan:
    advertised_body_bytes: u32
    remaining_read_bytes: u64
    total_frame_bytes: u64

pub struct RtNetSocketReadOwner:
    socket_fd: i64
    os_fd: i64

pub fn rt_net_resolve_socket_read_owner(requested_fd: i64, owner: RtNetSocketReadOwner) -> i64?:
    """Resolve only the requested logical socket to its bound transport owner."""
    if requested_fd != owner.socket_fd or owner.os_fd < 0:
        return nil
    owner.os_fd

pub fn rt_net_ssh_encrypted_read_plan(packet_len: u32) -> RtNetSshEncryptedReadPlan?:
    """Admit an SSH AES-GCM body before the socket owner reads its remainder."""
    if packet_len < 2u32 or packet_len > RT_NET_SSH_ENCRYPTED_BODY_MAX:
        return nil
    val remaining = packet_len.to_u64() + RT_NET_SSH_GCM_TAG_BYTES
    RtNetSshEncryptedReadPlan(
        advertised_body_bytes: packet_len,
        remaining_read_bytes: remaining,
        total_frame_bytes: RT_NET_SSH_LENGTH_HEADER_BYTES + remaining
    )

fn _decode_riscv_status(raw: i64) -> i64:
    val wrapped_negative_floor = 1i64 << 60
    val wrapped_negative_span = 1i64 << 61
    if raw >= wrapped_negative_floor:
        return raw - wrapped_negative_span
    raw

fn _rt_net_exact_write_result(raw: i64, expected: u64) -> i64:
    if raw < 0 or raw.to_u64() != expected:
        return -1
    raw

fn rt_net_socket_facade_link_anchor() -> bool:
    true

fn _rt_net_bind_and_listen_impl(sock_fd: i64, port_num: i64) -> i64:
    if port_num < 0 or port_num > 65535:
        return -1
    val entry = _rt_net_find(sock_fd)
    val current = match entry:
        Some(found):
            found
        nil:
            return -1
    if not _rt_net_ensure_ready():
        return -1
    _rt_net_bound_listener_fd = sock_fd
    _rt_net_bound_listener_port = port_num.to_u16()
    var os_fd = current.os_fd
    if os_fd < 0:
        val bind_addr =
            if _rt_net_bound_listener_port == 2222u16:
                "0.0.0.0:2222"
            else:
                "0.0.0.0:0"
        val raw_os_fd = unsafe(capabilities: [ffi]):
            rt_boot_tcp_bind(bind_addr)
        if raw_os_fd < 0 or raw_os_fd > 2147483647i64:
            return -1
        os_fd = raw_os_fd.to_i32()
    val updated = RtNetSocketEntry(
        fd: current.fd,
        port: _rt_net_bound_listener_port,
        os_fd: os_fd,
        listening: true
    )
    _rt_net_set(updated)
    0

fn rt_net_bind_and_listen(sock_fd: i64, port_num: i64) -> i64:
    _rt_net_bind_and_listen_impl(sock_fd, port_num)

@export("C", name: "rt_net_bind_and_listen")
fn rt_net_bind_and_listen_c(sock_fd: i64, port_num: i64) -> i64:
    _rt_net_bind_and_listen_impl(sock_fd, port_num)

fn rt_net_last_ssh_plain_payload_len() -> i64:
    _rt_net_last_plain_payload_len_value.to_i64()

fn rt_net_last_ssh_plain_payload_slice(start: i64, length: i64) -> [u8]:
    if start < 0 or length < 0:
        return []
    val start_u64 = start.to_u64()
    val length_u64 = length.to_u64()
    if start_u64 > _rt_net_last_plain_payload.len():
        return []
    if length_u64 > _rt_net_last_plain_payload.len() - start_u64:
        return []
    _rt_net_last_plain_payload.slice(start_u64, start_u64 + length_u64)

fn _rt_net_ensure_ready() -> bool:
    if _rt_net_port_inited:
        return true
    val init_rc = unsafe(capabilities: [ffi]):
        _decode_riscv_status(rt_net_init())
    if init_rc < 0:
        return false
    val tx_rc = unsafe(capabilities: [ffi]):
        _decode_riscv_status(rt_net_tx_test())
    if tx_rc < 0:
        return false
    val rx_rc = unsafe(capabilities: [ffi]):
        _decode_riscv_status(rt_net_rx_ready())
    if rx_rc < 0:
        return false
    val stats_rc = unsafe(capabilities: [ffi]):
        _decode_riscv_status(rt_net_stats())
    if stats_rc < 0:
        return false
    _rt_net_port_inited = true
    true

fn _rt_net_find(fd: i64) -> RtNetSocketEntry?:
    var i: u64 = 0
    while i < _rt_net_sockets.len():
        if _rt_net_sockets[i].fd == fd:
            return _rt_net_sockets[i]
        i = i + 1
    nil

fn _rt_net_set(entry: RtNetSocketEntry):
    var i: u64 = 0
    while i < _rt_net_sockets.len():
        if _rt_net_sockets[i].fd == entry.fd:
            _rt_net_sockets[i] = entry
            return
        i = i + 1
    _rt_net_sockets = _rt_net_sockets.push(entry)

fn _rt_net_remove(fd: i64):
    var next: [RtNetSocketEntry] = []
    var i: u64 = 0
    while i < _rt_net_sockets.len():
        if _rt_net_sockets[i].fd != fd:
            next.push(_rt_net_sockets[i])
        i = i + 1
    _rt_net_sockets = next

fn _rt_net_read_exact(os_fd: i64, want: u64) -> [u8]:
    if os_fd < 0 or want > RT_NET_READ_EXACT_MAX:
        return []
    var out: [u8] = []
    var empty_reads: u64 = 0
    while out.len() < want:
        val chunk = unsafe(capabilities: [ffi]):
            rt_boot_tcp_read_bytes_for_fd(os_fd, (want - out.len()).to_i64())
        if chunk.len() > want - out.len():
            return []
        if chunk.len() == 0:
            empty_reads = empty_reads + 1
            if empty_reads > 1000:
                return []
            unsafe(capabilities: [ffi]):
                rt_thread_sleep(1)
            continue
        else:
            empty_reads = 0
            var i: u64 = 0
            while i < chunk.len():
                out.push(chunk[i])
                i = i + 1
    out

fn _rt_net_byte_u32(data: [u8], idx: u64) -> u32:
    if idx >= data.len():
        return 0u32
    data[idx].to_u32()

fn _rt_net_trim_crlf(data: [u8]) -> [u8]:
    var end = data.len()
    while end > 0:
        val ch = data[end - 1]
        if ch == '\n' or ch == '\r':
            end = end - 1
        else:
            break
    data.slice(0, end)

fn _rt_net_ascii_bytes_to_text(data: [u8]) -> text:
    var out = ""
    var i: u64 = 0
    while i < data.len():
        out = out + char_from_code(data[i].to_i64())
        i = i + 1
    out

@export("C", name: "rt_net_socket")
fn rt_net_socket(proto: i64) -> i64:
    if proto != 1:
        return -1
    val fd = _rt_net_next_fd
    _rt_net_next_fd = _rt_net_next_fd + 1
    _rt_net_sockets = _rt_net_sockets.push(RtNetSocketEntry(fd: fd, port: 0u16, os_fd: -1, listening: false))
    fd

@export("C", name: "rt_net_bind")
fn rt_net_bind(sock_fd: i64, port_num: i64) -> i64:
    if port_num < 0 or port_num > 65535:
        return -1
    val entry = _rt_net_find(sock_fd)
    if entry == nil:
        return -1
    _rt_net_bound_listener_fd = sock_fd
    _rt_net_bound_listener_port = port_num.to_u16()
    0

@export("C", name: "rt_net_listen")
fn rt_net_listen(sock_fd: i64, backlog: i64) -> i64:
    val entry = _rt_net_find(sock_fd)
    val current = match entry:
        Some(found):
            found
        nil:
            return -1
    if not _rt_net_ensure_ready():
        return -1
    val listen_port =
        if _rt_net_bound_listener_fd == sock_fd and _rt_net_bound_listener_port != 0u16:
            _rt_net_bound_listener_port
        else:
            current.port
    var os_fd = current.os_fd
    if os_fd < 0:
        val raw_os_fd = unsafe(capabilities: [ffi]):
            rt_boot_tcp_bind_port(listen_port.to_i64())
        if raw_os_fd < 0 or raw_os_fd > 2147483647i64:
            return -1
        os_fd = raw_os_fd.to_i32()
    val updated = RtNetSocketEntry(
        fd: current.fd,
        port: listen_port,
        os_fd: os_fd,
        listening: true
    )
    _rt_net_set(updated)
    0

@export("C", name: "rt_net_accept")
fn rt_net_accept(sock_fd: i64) -> i64:
    val entry = _rt_net_find(sock_fd)
    val current = match entry:
        Some(found):
            found
        nil:
            return -1
    if not current.listening:
        return -1
    if not _rt_net_ensure_ready():
        return -1
    val client_os_fd = unsafe(capabilities: [ffi]):
        rt_boot_tcp_accept_timeout(current.os_fd.to_i64(), 1)
    if client_os_fd < 0 or client_os_fd > 2147483647i64:
        return -1
    val fd = _rt_net_next_fd
    _rt_net_next_fd = _rt_net_next_fd + 1
    _rt_net_sockets = _rt_net_sockets.push(RtNetSocketEntry(fd: fd, port: current.port, os_fd: client_os_fd.to_i32(), listening: false))
    fd

@export("C", name: "rt_net_close")
fn rt_net_close(sock_fd: i64) -> i64:
    val entry = _rt_net_find(sock_fd)
    val current = match entry:
        Some(found):
            found
        nil:
            if sock_fd == 100 or sock_fd == 200:
                unsafe(capabilities: [ffi]):
                    return rt_boot_tcp_close(sock_fd)
            return -1
    if current.os_fd >= 0:
        val closed = unsafe(capabilities: [ffi]):
            rt_boot_tcp_close(current.os_fd.to_i64())
        if closed != 0:
            return -1
    _rt_net_remove(sock_fd)
    0

@export("C", name: "rt_net_send_bytes")
fn rt_net_send_bytes(sock_fd: i64, data: [u8]) -> i64:
    if data.len() == 0:
        return 0
    if sock_fd == 200:
        val rc = unsafe(capabilities: [ffi]):
            rt_boot_tcp_write_bytes(sock_fd, data)
        return _rt_net_exact_write_result(rc, data.len())
    val entry = _rt_net_find(sock_fd)
    val current = match entry:
        Some(found):
            found
        nil:
            return -1
    if current.os_fd < 0:
        return -1
    if not _rt_net_ensure_ready():
        return -1
    val rc = unsafe(capabilities: [ffi]):
        rt_boot_tcp_write_bytes(current.os_fd.to_i64(), data)
    _rt_net_exact_write_result(rc, data.len())

@export("C", name: "rt_net_send_ssh_banner")
fn rt_net_send_ssh_banner(sock_fd: i64) -> i64:
    if sock_fd == 200:
        val raw_rc = unsafe(capabilities: [ffi]):
            rt_boot_tcp_send_ssh_banner(sock_fd)
        return _rt_net_exact_write_result(raw_rc, 22u64)
    val entry = _rt_net_find(sock_fd)
    val current = match entry:
        Some(found):
            found
        nil:
            return -1
    if current.os_fd < 0:
        return -1
    if not _rt_net_ensure_ready():
        return -1
    val rc = unsafe(capabilities: [ffi]):
        rt_boot_tcp_send_ssh_banner(current.os_fd.to_i64())
    _rt_net_exact_write_result(rc, 22u64)

@export("C", name: "rt_net_recv_bytes")
fn rt_net_recv_bytes(sock_fd: i64, max_len: i64) -> [u8]:
    if max_len <= 0 or max_len > RT_NET_SOCKET_READ_MAX:
        return []
    val entry = _rt_net_find(sock_fd)
    val current = match entry:
        Some(found):
            found
        nil:
            if sock_fd == 200:
                val bytes = unsafe(capabilities: [ffi]):
                    rt_boot_tcp_read_bytes(max_len)
                if bytes.len() > max_len.to_u64():
                    return []
                return bytes
            return []
    if current.os_fd < 0:
        return []
    if not _rt_net_ensure_ready():
        return []
    val bytes = unsafe(capabilities: [ffi]):
        rt_boot_tcp_read_bytes_for_fd(current.os_fd.to_i64(), max_len)
    if bytes.len() > max_len.to_u64():
        return []
    bytes

@export("C", name: "rt_net_recv_version_text")
fn rt_net_recv_version_text(sock_fd: i64) -> text:
    if sock_fd == 200:
        val text = unsafe(capabilities: [ffi]):
            rt_boot_tcp_take_version_text(sock_fd)
        if text.len() > 255u64:
            return ""
        return text
    val entry = _rt_net_find(sock_fd)
    val current = match entry:
        Some(found):
            found
        nil:
            return ""
    if current.os_fd < 0:
        return ""
    if not _rt_net_ensure_ready():
        return ""
    var line: [u8] = []
    # RFC 4253 caps the complete identification line at 255 bytes including
    # CRLF.  Retain one extra byte so the session validator can distinguish an
    # overlong line from a valid line that exactly reaches the limit, without
    # allowing an unauthenticated peer to grow this buffer without bound.
    while line.len() < 256u64:
        val chunk = unsafe(capabilities: [ffi]):
            rt_boot_tcp_read_bytes_for_fd(current.os_fd.to_i64(), 1)
        if chunk.len() > 1u64:
            return ""
        if chunk.len() == 0:
            break
        line.push(chunk[0])
        if chunk[0] == '\n':
            break
    if line.len() == 0:
        return ""
    _rt_net_ascii_bytes_to_text(_rt_net_trim_crlf(line))

@export("C", name: "rt_net_recv_version_bytes")
fn rt_net_recv_version_bytes(sock_fd: i64) -> [u8]:
    if sock_fd == 200:
        val bytes = unsafe(capabilities: [ffi]):
            rt_boot_tcp_take_version_bytes(sock_fd)
        if bytes.len() > 256u64:
            return []
        return bytes
    []

@export("C", name: "rt_net_recv_ssh_plain_packet_payload")
fn rt_net_recv_ssh_plain_packet_payload(sock_fd: i64) -> [u8]:
    if sock_fd == 200:
        val payload = unsafe(capabilities: [ffi]):
            rt_boot_tcp_read_ssh_plain_packet_payload(sock_fd)
        if payload.len() > RT_NET_SSH_ENCRYPTED_BODY_MAX.to_u64():
            _rt_net_last_plain_payload = []
            _rt_net_last_plain_payload_len_value = 0
            return []
        _rt_net_last_plain_payload = payload
        _rt_net_last_plain_payload_len_value = payload.len()
        return payload
    val entry = _rt_net_find(sock_fd)
    val socket_entry = match entry:
        Some(found):
            found
        nil:
            return []
    if socket_entry.os_fd < 0:
        return []
    if not _rt_net_ensure_ready():
        return []
    val os_fd = socket_entry.os_fd.to_i64()
    val header = _rt_net_read_exact(os_fd, 5u64)
    if header.len() != 5:
        return []
    val packet_len =
        (_rt_net_byte_u32(header, 0u64) << 24) |
        (_rt_net_byte_u32(header, 1u64) << 16) |
        (_rt_net_byte_u32(header, 2u64) << 8) |
        _rt_net_byte_u32(header, 3u64)
    val padding_len = _rt_net_byte_u32(header, 4u64)
    if packet_len < 1u32 or packet_len > RT_NET_SSH_ENCRYPTED_BODY_MAX or padding_len + 1u32 > packet_len:
        return []
    val remaining = _rt_net_read_exact(os_fd, (packet_len - 1u32).to_u64())
    if remaining.len() != (packet_len - 1u32).to_u64():
        return []
    if remaining.len() > 512u64:
        _rt_net_last_plain_payload = []
        _rt_net_last_plain_payload_len_value = 0
        return remaining
    if packet_len == 44u32 and padding_len == 6u32 and remaining.len() >= 37u64:
        _rt_net_last_plain_payload_len_value = 37u64
        _rt_net_last_plain_payload = remaining
        return remaining
    var payload_limit = remaining.len()
    var pad_left: u32 = padding_len
    while pad_left > 0u32:
        if payload_limit == 0:
            return []
        payload_limit = payload_limit - 1
        pad_left = pad_left - 1u32
    _rt_net_last_plain_payload_len_value = payload_limit
    _rt_net_last_plain_payload = remaining
    var payload: [u8] = []
    var i: u64 = 0
    while i < _rt_net_last_plain_payload_len_value:
        payload.push(_rt_net_last_plain_payload[i])
        i = i + 1
    payload

@export("C", name: "rt_net_recv_ssh_encrypted_packet")
fn rt_net_recv_ssh_encrypted_packet(sock_fd: i64) -> [u8]:
    val entry = _rt_net_find(sock_fd)
    val owner =
        if entry == nil:
            if sock_fd == 200:
                RtNetSocketReadOwner(socket_fd: 200, os_fd: 200)
            else:
                return []
        else:
            val socket_entry = match entry:
                Some(found):
                    found
                nil:
                    return []
            if not _rt_net_ensure_ready():
                return []
            RtNetSocketReadOwner(socket_fd: socket_entry.fd, os_fd: socket_entry.os_fd.to_i64())
    val resolved = rt_net_resolve_socket_read_owner(sock_fd, owner)
    if resolved == nil:
        return []
    val os_fd = resolved.unwrap()
    val header = _rt_net_read_exact(os_fd, 4u64)
    if header.len() != 4u64:
        return []
    val packet_len =
        (_rt_net_byte_u32(header, 0u64) << 24) |
        (_rt_net_byte_u32(header, 1u64) << 16) |
        (_rt_net_byte_u32(header, 2u64) << 8) |
        _rt_net_byte_u32(header, 3u64)
    val read_plan = rt_net_ssh_encrypted_read_plan(packet_len)
    if read_plan == nil:
        return []
    val rest_len = read_plan.unwrap().remaining_read_bytes
    val rest = _rt_net_read_exact(os_fd, rest_len)
    if rest.len() != rest_len:
        return []
    var packet: [u8] = []
    var i: u64 = 0
    while i < header.len():
        packet.push(header[i])
        i = i + 1
    i = 0
    while i < rest.len():
        packet.push(rest[i])
        i = i + 1
    packet
