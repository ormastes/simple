# Filesystem operations via IPC to VFS service and raw syscalls.

use std.nogc_sync_mut.binary_io.{bytes_to_string}
use std.fs_driver.bytes_util.{text_to_bytes_pure}
use os.userlib.syscall_raw
use os.userlib.ipc_protocol(VFS_OPEN, VFS_READ, VFS_WRITE, VFS_CLOSE, VFS_STAT, VFS_STAT_NO_FOLLOW, VFS_MKDIR, VFS_READDIR, VFS_REMOVE, VFS_RENAME, VFS_MOUNT_LIST, VFS_READLINK, VFS_OPEN_O_RDONLY, VFS_OPEN_O_WRONLY, VFS_OPEN_O_CREAT, VFS_OPEN_O_TRUNC)
use os.kernel.types.fs_types(DirEntry, FsNode, FsNodeKind)
use os.services.vfs.vfs_positioned_ops.{g_vfs_positioned_fstat}
use std.fs_driver.error.{FsError}
use std.fs_driver.types.{FileStat}
use os.kernel.types.ipc_types(IpcPort, IpcMessage)
use std.common.crypto.secure_memory.{secure_zero_u8_slots, secure_set_u8_length}
pub use std.common.contracts.os.dbfs_vfs_mount_capability_v1.{DbfsVfsMountCapabilityV1}

extern fn unsafe_addr_of(ref: any) -> u64

val _DIRECT_FILE_MAX_BYTES: u64 = 1048576
pub const VFS_DIRECTORY_ENTRY_LIMIT: u64 = 128u64
pub const VFS_DIRECTORY_NAME_BYTES_LIMIT: u64 = 255u64
pub const VFS_DIRECTORY_TOTAL_NAME_BYTES_LIMIT: u64 = 3072u64

pub struct VfsDirectoryListing:
    entries: [DirEntry]
    total_name_bytes: u64

pub struct VfsFileStat:
    """Bounded SFTP-ready metadata with explicit availability flags."""
    kind: FsNodeKind
    size: u64
    mode: u32
    uid: u32
    gid: u32
    atime_ns: u64
    mtime_ns: u64
    kind_available: bool
    mode_available: bool
    uid_gid_available: bool
    times_available: bool

pub fn dbfs_vfs_mount_capability_v1() -> DbfsVfsMountCapabilityV1:
    match syscall(79, 0, 0, 0, 0, 0):
        1: DbfsVfsMountCapabilityV1.DbfsMountedRecoveryCompleteDurableTransactionalReplace
        _: DbfsVfsMountCapabilityV1.Unavailable

# Direct file-descriptor facade for filesystem-launched SimpleOS programs.
# The kernel remains the sole filesystem/state owner; byte arrays are bounded
# user payloads copied and validated at the syscall boundary.
pub fn file_open_direct(path: text, flags: u32) -> Result<i32, text>:
    val path_bytes = text_to_bytes_pure(path)
    if path_bytes.len() == 0 or path_bytes.len() > 4096:
        return Err("invalid file path length")
    val rc = rt_simpleos_file_open_bytes(path_bytes, flags as u64)
    if rc < 0:
        return Err("open failed with code {rc}")
    Ok(rc as i32)

pub fn file_read_direct(fd: i32, max_len: u64) -> Result<[u8], text>:
    if max_len == 0 or max_len > _DIRECT_FILE_MAX_BYTES:
        return Err("invalid read bound")
    var buf: [u8] = [0u8; max_len]
    val rc = rt_simpleos_file_read_bytes(fd as u64, buf, max_len)
    if rc < 0:
        return Err("read failed with code {rc}")
    if rc as u64 > max_len:
        return Err("read returned invalid length {rc}")
    Ok(buf.slice(0, rc as u64))

pub fn file_write_direct(fd: i32, bytes: [u8]) -> Result<u64, text>:
    if bytes.len() == 0 or bytes.len() > _DIRECT_FILE_MAX_BYTES:
        return Err("invalid write bound")
    val rc = rt_simpleos_file_write_bytes(fd as u64, bytes)
    if rc < 0:
        return Err("write failed with code {rc}")
    if rc as u64 != bytes.len() as u64:
        return Err("short write {rc}/{bytes.len()}")
    Ok(rc as u64)

pub fn file_write_progress_direct(fd: i32, bytes: [u8]) -> Result<u64, text>:
    """Perform one bounded descriptor write and preserve partial progress.

    Callers that require complete delivery must retry the unwritten suffix.
    A zero-byte successful write is returned as progress so the caller can
    reject the stalled descriptor without spinning.
    """
    if bytes.len() == 0 or bytes.len() > _DIRECT_FILE_MAX_BYTES:
        return Err("invalid write bound")
    val rc = rt_simpleos_file_write_bytes(fd as u64, bytes)
    if rc < 0:
        return Err("write failed with code {rc}")
    if rc as u64 > bytes.len():
        return Err("write returned invalid length {rc}/{bytes.len()}")
    Ok(rc as u64)

pub fn file_close_direct(fd: i32) -> bool:
    syscall(33, fd as u64, 0, 0, 0, 0) >= 0

pub fn file_sync_direct(fd: i32) -> Result<bool, text>:
    val rc = syscall(78, fd as u64, 0, 0, 0, 0)
    if rc < 0:
        return Err("fsync failed with code {rc}")
    Ok(true)

pub fn file_rename_direct(from: text, to: text) -> Result<bool, text>:
    val old_bytes = text_to_bytes_pure(from)
    val new_bytes = text_to_bytes_pure(to)
    if old_bytes.len() == 0 or new_bytes.len() == 0 or old_bytes.len() > 4096 or new_bytes.len() > 4096:
        return Err("invalid rename path")
    val rc = rt_simpleos_file_rename_bytes(old_bytes, new_bytes)
    if rc < 0:
        return Err("rename failed with code {rc}")
    Ok(true)

pub fn read_file_bytes_direct(path: text, max_len: u64) -> Result<[u8], text>:
    val opened = file_open_direct(path, 0)
    match opened:
        Err(message): Err(message)
        Ok(fd):
            val result = file_read_direct(fd, max_len)
            val _closed = file_close_direct(fd)
            result

pub fn read_file_bytes_direct_owned(path: text, max_len: u64) -> Result<[u8], text>:
    """Read into one fixed backing allocation and shrink it in place.

    Intended for mutable secrets: no slice allocation retains a second copy.
    Failure paths compiler-resistently wipe the complete fixed allocation.
    """
    if max_len == 0u64 or max_len > _DIRECT_FILE_MAX_BYTES:
        return Err("invalid owned read bound")
    match file_open_direct(path, 0u32):
        Err(message): Err(message)
        Ok(fd):
            var bytes: [u8] = [0u8; max_len]
            val count = rt_simpleos_file_read_bytes(fd as u64, bytes, max_len)
            val _closed = file_close_direct(fd)
            if count < 0 or count as u64 > max_len:
                val _wipe = secure_zero_u8_slots(bytes)
                return Err("owned read failed")
            if not secure_set_u8_length(bytes, count):
                val _wipe = secure_zero_u8_slots(bytes)
                return Err("owned read length failed")
            Ok(bytes)

# VFS's named service endpoint and the copied IPC syscall ABI.
val _VFS_SERVICE_NAME: text = "vfs"
val _SYS_IPC_SEND: u64 = 20
val _SYS_IPC_RECV: u64 = 21
val _SYS_IPC_CREATE_PORT: u64 = 22
val _SYS_IPC_CONNECT: u64 = 23
val _SYS_IPC_DESTROY_PORT: u64 = 18
val _VFS_IPC_REQUEST_FRAME_MAX: u64 = 4100u64
val _VFS_IPC_REPLY_MAX: u64 = 4096u64
val _VFS_IPC_BYTE_ARRAY_HEADER_BYTES: u64 = 16u64
val _IPC_COPIED_SERVICE_TAG: u64 = 0xFFFFFFFFFFFFFFFFu64
val _VFS_OPEN_READ: u32 = VFS_OPEN_O_RDONLY
val _VFS_OPEN_WRITE_CREATE_TRUNCATE: u32 = VFS_OPEN_O_WRONLY | VFS_OPEN_O_CREAT | VFS_OPEN_O_TRUNC

extern fn mmio_read8(addr: u64) -> u8
extern fn mmio_read32(addr: u64) -> u32

fn _vfs_read_u32_at(addr: u64) -> u32:
    mmio_read32(addr)

fn _vfs_read_i32_at(addr: u64) -> i32:
    _vfs_read_u32_at(addr).to_i32()

fn _vfs_destroy_reply_port(reply_port: i64):
    # Frozen IpcDestroyPort consumer interface: syscall 18 takes the caller's
    # port id and rejects missing or foreign ports in the kernel owner.
    syscall(_SYS_IPC_DESTROY_PORT, reply_port.to_u64(), 0, 0, 0, 0)

fn _vfs_push_u32(bytes: [u8], value: u32):
    bytes.push((value & 0xFFu32).to_u8())
    bytes.push(((value >> 8u32) & 0xFFu32).to_u8())
    bytes.push(((value >> 16u32) & 0xFFu32).to_u8())
    bytes.push(((value >> 24u32) & 0xFFu32).to_u8())

fn _vfs_push_u64(bytes: [u8], value: u64):
    _vfs_push_u32(bytes, (value & 0xFFFFFFFFu64).to_u32())
    _vfs_push_u32(bytes, ((value >> 32u64) & 0xFFFFFFFFu64).to_u32())

fn _vfs_read_u16(bytes: [u8], offset: u64) -> u16:
    bytes[offset].to_u16() | (bytes[offset + 1u64].to_u16() << 8u16)

fn _vfs_read_u64(bytes: [u8], offset: u64) -> u64:
    var value: u64 = 0u64
    var index: u64 = 0u64
    while index < 8u64:
        value = value | (bytes[offset + index].to_u64() << (index * 8u64))
        index = index + 1u64
    value

fn _vfs_text_bytes(value: text) -> [u8]:
    var bytes: [u8] = []
    var index: u64 = 0u64
    while index < value.len():
        bytes.push(value.byte_at(index))
        index = index + 1u64
    bytes

pub fn vfs_ipc_request_bytes(method: u32, payload: [u8]) -> Result<[u8], text>:
    """Send one bounded method-prefixed VFS request and return raw reply bytes.

    An anonymous reply port belongs to the calling task.  The named ``vfs``
    source port then makes the server response a raw copied status frame.
    """
    if payload.len().to_u64() > _VFS_IPC_REQUEST_FRAME_MAX - 4u64:
        return Err("VFS request exceeds IPC bound")
    val reply_port = syscall(_SYS_IPC_CREATE_PORT, 0, 0, 0, 0, 0)
    if reply_port < 0:
        return Err("failed to create VFS reply port")
    val service_port = syscall(_SYS_IPC_CONNECT, unsafe_addr_of(_VFS_SERVICE_NAME), _VFS_SERVICE_NAME.len(), 0, 0, 0)
    if service_port < 0:
        _vfs_destroy_reply_port(reply_port)
        return Err("failed to connect to VFS service")

    var request: [u8] = []
    _vfs_push_u32(request, method)
    var request_index: u64 = 0u64
    while request_index < payload.len():
        request.push(payload[request_index])
        request_index = request_index + 1u64
    val request_bytes = unsafe_addr_of(request) + _VFS_IPC_BYTE_ARRAY_HEADER_BYTES
    val sent = syscall(_SYS_IPC_SEND, service_port.to_u64(), reply_port.to_u64(), request_bytes, request.len(), _IPC_COPIED_SERVICE_TAG)
    if sent < 0:
        _vfs_destroy_reply_port(reply_port)
        return Err("VFS send failed with code {sent}")

    val message_raw = syscall(_SYS_IPC_RECV, reply_port.to_u64(), 0xFFFFFFFFFFFFFFFFu64, 0, 0, 0)
    if message_raw <= 0:
        _vfs_destroy_reply_port(reply_port)
        return Err("VFS recv failed with code {message_raw}")
    val message_addr = message_raw.to_u64()
    val frame_len = _vfs_read_u32_at(message_addr + 24u64).to_u64()
    if frame_len < 4u64 or frame_len > _VFS_IPC_REPLY_MAX:
        _vfs_destroy_reply_port(reply_port)
        return Err("malformed VFS reply")
    val reply_addr = message_addr + 32u64
    val status = _vfs_read_i32_at(reply_addr)
    var bytes: [u8] = []
    var reply_index: u64 = 4u64
    while reply_index < frame_len:
        bytes.push(mmio_read8(reply_addr + reply_index))
        reply_index = reply_index + 1u64
    if status < 0:
        _vfs_destroy_reply_port(reply_port)
        return Err(bytes_to_string(bytes))
    _vfs_destroy_reply_port(reply_port)
    Ok(bytes)

fn _vfs_request(method: u32, payload: text) -> Result<text, text>:
    val response = vfs_ipc_request_bytes(method, _vfs_text_bytes(payload))?
    Ok(bytes_to_string(response))

fn _vfs_open(path: text, flags: u32) -> Result<u64, text>:
    var payload = _vfs_text_bytes(path)
    payload.push(0u8)
    _vfs_push_u32(payload, flags)
    val response = vfs_ipc_request_bytes(VFS_OPEN, payload)?
    if response.len() != 8u64:
        return Err("malformed VFS open reply")
    Ok(_vfs_read_u64(response, 0u64))

fn _vfs_close(handle: u64) -> Result<bool, text>:
    var payload: [u8] = []
    _vfs_push_u64(payload, handle)
    val response = vfs_ipc_request_bytes(VFS_CLOSE, payload)?
    if response.len() != 8u64:
        return Err("malformed VFS close reply")
    Ok(_vfs_read_u64(response, 0u64) == 1u64)

fn read_text(path: text) -> Result<text, text>:
    # READ requires an opened handle and an explicit u64 byte count.  Stat
    # first so the client neither guesses a size nor asks the bounded service
    # for more than one reply frame can carry.
    val node = stat(path)?
    if node.size > _VFS_IPC_REPLY_MAX - 4u64:
        return Err("VFS read exceeds IPC reply bound")
    val handle = _vfs_open(path, _VFS_OPEN_READ)?
    var read_payload: [u8] = []
    _vfs_push_u64(read_payload, handle)
    _vfs_push_u64(read_payload, node.size)
    val read_result = vfs_ipc_request_bytes(VFS_READ, read_payload)
    val close_result = _vfs_close(handle)
    match read_result:
        Result.Err(error): return Err(error)
        Result.Ok(bytes):
            match close_result:
                Result.Err(error): return Err(error)
                Result.Ok(closed):
                    if not closed:
                        return Err("VFS close rejected read handle")
                    Ok(bytes_to_string(bytes))

fn write_text(path: text, content: text) -> Result<bool, text>:
    val content_bytes = _vfs_text_bytes(content)
    if content_bytes.len() > _VFS_IPC_REQUEST_FRAME_MAX - 12u64:
        return Err("VFS write exceeds IPC request bound")
    val handle = _vfs_open(path, _VFS_OPEN_WRITE_CREATE_TRUNCATE)?
    var write_payload: [u8] = []
    _vfs_push_u64(write_payload, handle)
    for byte in content_bytes:
        write_payload.push(byte)
    val write_result = vfs_ipc_request_bytes(VFS_WRITE, write_payload)
    val close_result = _vfs_close(handle)
    match write_result:
        Result.Err(error): return Err(error)
        Result.Ok(reply):
            if reply.len() != 8u64:
                return Err("malformed VFS write reply")
            val written = _vfs_read_u64(reply, 0u64)
            match close_result:
                Result.Err(error): return Err(error)
                Result.Ok(closed):
                    if not closed:
                        return Err("VFS close rejected write handle")
                    if written != content_bytes.len():
                        return Err("short VFS write")
                    Ok(true)

fn _fs_node_kind_from_u8(v: u8) -> FsNodeKind:
    """Map a VFS wire kind byte to FsNodeKind, in declaration order.

    Deliberately a free function, not an enum `static fn`: enum associated
    functions are miscompiled on the JIT (they yield a value matching no
    `case` arm), so a static here would reintroduce the same defect this
    replaces. Unknown bytes fall back to File rather than fabricating a
    discriminant.
    """
    if v == 1: return FsNodeKind.Directory
    if v == 2: return FsNodeKind.Symlink
    if v == 3: return FsNodeKind.Device
    if v == 4: return FsNodeKind.Pipe
    FsNodeKind.File

fn stat(path: text) -> Result<FsNode, text>:
    val response = vfs_ipc_request_bytes(VFS_STAT, _vfs_text_bytes(path))?
    # STAT reply: kind(u8) | size(u64 LE) | permissions(u16 LE).
    if response.len() != 11u64:
        return Err("malformed stat response")
    Ok(FsNode(
        id: 0u64,
        kind: _fs_node_kind_from_u8(response[0u64]),
        size: _vfs_read_u64(response, 1u64),
        permissions: _vfs_read_u16(response, 9u64),
        owner: 0u32,
        group: 0u32,
        created_ns: 0u64,
        modified_ns: 0u64
    ))

fn stat_no_follow(path: text) -> Result<FsNode, text>:
    val response = vfs_ipc_request_bytes(VFS_STAT_NO_FOLLOW, _vfs_text_bytes(path))?
    if response.len() != 11u64:
        return Err("malformed no-follow stat response")
    Ok(FsNode(
        id: 0u64,
        kind: _fs_node_kind_from_u8(response[0u64]),
        size: _vfs_read_u64(response, 1u64),
        permissions: _vfs_read_u16(response, 9u64),
        owner: 0u32, group: 0u32, created_ns: 0u64, modified_ns: 0u64
    ))

pub fn file_lstat_bounded(path: text) -> Result<VfsFileStat, text>:
    """Stat one bounded path without following its final symlink."""
    if path.len() == 0u64 or path.len() > 4096u64 or path.contains("\0"):
        return Err("invalid no-follow stat path length")
    val node = stat_no_follow(path)?
    val type_bits = match node.kind:
        case FsNodeKind.Directory: 0o040000u32
        case FsNodeKind.Symlink: 0o120000u32
        case FsNodeKind.Device: 0o060000u32
        case FsNodeKind.Pipe: 0o010000u32
        case _: 0o100000u32
    Ok(VfsFileStat(
        kind: node.kind, size: node.size,
        mode: type_bits | node.permissions.to_u32(),
        uid: 0u32, gid: 0u32, atime_ns: 0u64, mtime_ns: 0u64,
        kind_available: true, mode_available: true,
        uid_gid_available: false, times_available: false))

pub fn file_stat_bounded(path: text) -> Result<VfsFileStat, text>:
    """Stat one bounded path through canonical VFS_STAT.

    The current wire reply owns kind, size, and permission bits only. UID/GID
    and times are marked unavailable rather than presented as real zeroes.
    """
    if path.len() == 0u64 or path.len() > 4096u64 or path.contains("\0"):
        return Err("invalid stat path length")
    val node = stat(path)?
    val type_bits = match node.kind:
        case FsNodeKind.Directory: 0o040000u32
        case FsNodeKind.Symlink: 0o120000u32
        case FsNodeKind.Device: 0o060000u32
        case FsNodeKind.Pipe: 0o010000u32
        case _: 0o100000u32
    Ok(VfsFileStat(
        kind: node.kind, size: node.size,
        mode: type_bits | node.permissions.to_u32(),
        uid: 0u32, gid: 0u32, atime_ns: 0u64, mtime_ns: 0u64,
        kind_available: true, mode_available: true,
        uid_gid_available: false, times_available: false))

fn _vfs_kind_from_mode(mode: u32) -> FsNodeKind:
    val type_bits = mode & 0o170000u32
    if type_bits == 0o040000u32: return FsNodeKind.Directory
    if type_bits == 0o120000u32: return FsNodeKind.Symlink
    if type_bits == 0o060000u32 or type_bits == 0o020000u32:
        return FsNodeKind.Device
    if type_bits == 0o010000u32: return FsNodeKind.Pipe
    FsNodeKind.File

pub fn file_fstat_bounded(file_object_id: u64) -> Result<VfsFileStat, FsError>:
    """Stat a live positioned file object without weakening handle ownership."""
    val value: FileStat = g_vfs_positioned_fstat(file_object_id)?
    Ok(VfsFileStat(
        kind: _vfs_kind_from_mode(value.mode), size: value.size,
        mode: value.mode, uid: value.uid, gid: value.gid,
        atime_ns: value.atime_ns, mtime_ns: value.mtime_ns,
        kind_available: (value.mode & 0o170000u32) != 0u32,
        mode_available: value.mode != 0u32,
        uid_gid_available: false,
        times_available: value.atime_ns != 0u64 or value.mtime_ns != 0u64))

pub fn readlink(path: text) -> Result<text, text>:
    """Read one symbolic-link target through the canonical VFS service."""
    if path.len() == 0u64 or path.len() > 4096u64:
        return Err("invalid readlink path length")
    val response = vfs_ipc_request_bytes(VFS_READLINK, _vfs_text_bytes(path))?
    Ok(bytes_to_string(response))

fn mkdir(path: text) -> Result<bool, text>:
    val resp = _vfs_request(VFS_MKDIR, path)?
    Ok(true)

pub fn list_directory_bounded(path: text) -> Result<VfsDirectoryListing, text>:
    """List one directory through the capability-enforcing canonical VFS.

    The VFS manager applies the caller's file grant and container namespace
    before dispatch.  This client additionally rejects oversized or malformed
    replies, so a filesystem driver cannot turn ``ls`` into unbounded work.
    Entry order is preserved here; presentation owners may sort the bounded
    result without changing filesystem identity.
    """
    if path.len() == 0u64 or path.len() > 4096u64:
        return Err("invalid directory path length")
    val response = vfs_ipc_request_bytes(VFS_READDIR, _vfs_text_bytes(path))?
    # The current VFS service serializes each directory entry as
    # `kind:u8-as-decimal:name`, separated by newlines.  The enclosing IPC
    # frame remains binary status(i32)|payload; only this service payload is
    # textual until the service owner publishes a different READDIR format.
    val resp = bytes_to_string(response)
    var entries: [DirEntry] = []
    var total_name_bytes: u64 = 0u64
    if resp.len() == 0:
        return Ok(VfsDirectoryListing(entries: entries, total_name_bytes: 0u64))
    val lines = resp.split("\n")
    var i: u64 = 0
    while i < lines.len() as u64:
        val line = lines[i as i64]
        if line.len() == 0u64:
            return Err("malformed empty VFS directory entry")
        if entries.len() >= VFS_DIRECTORY_ENTRY_LIMIT:
            return Err("directory exceeds entry limit")
        # The service emits `kind:name`. A Unix filename may itself contain
        # `:`, so only the first delimiter belongs to the wire envelope.
        val separator = line.index_of(":")
        if separator <= 0:
            return Err("malformed VFS directory entry")
        val kind_text = line.slice(0, separator)
        if kind_text.len() != 1u64 or kind_text.byte_at(0u64) < 48u8 or
            kind_text.byte_at(0u64) > 52u8:
            return Err("malformed VFS directory kind")
        val kind_val = kind_text.parse_u8()
        val name_val = line.slice(separator + 1, line.len())
        val name_bytes = name_val.len().to_u64()
        if name_bytes == 0u64 or name_bytes > VFS_DIRECTORY_NAME_BYTES_LIMIT or
            name_val.contains("\0"):
            return Err("invalid VFS directory entry name")
        if total_name_bytes > VFS_DIRECTORY_TOTAL_NAME_BYTES_LIMIT or
            name_bytes > VFS_DIRECTORY_TOTAL_NAME_BYTES_LIMIT - total_name_bytes:
            return Err("directory exceeds name byte limit")
        total_name_bytes = total_name_bytes + name_bytes
        entries.push(DirEntry(
            name: name_val,
            node: FsNode(
                id: 0u64,
                kind: _fs_node_kind_from_u8(kind_val),
                size: 0u64,
                permissions: 0u16,
                owner: 0u32,
                group: 0u32,
                created_ns: 0u64,
                modified_ns: 0u64
            )
        ))
        i = i + 1
    Ok(VfsDirectoryListing(entries: entries, total_name_bytes: total_name_bytes))

fn remove(path: text) -> Result<bool, text>:
    val resp = _vfs_request(VFS_REMOVE, path)?
    Ok(true)

fn rename(old_path: text, new_path: text) -> Result<bool, text>:
    val payload = "{old_path}\0{new_path}"
    val resp = _vfs_request(VFS_RENAME, payload)?
    Ok(true)

fn mount(device: text, mount_path: text, fs_type: text) -> Result<bool, text>:
    val payload = "{device}\0{mount_path}\0{fs_type}"
    val result = syscall(37, unsafe_addr_of(payload), payload.len() as u64, 0, 0, 0)
    if result < 0:
        return Err("mount failed with code {result}")
    Ok(true)

fn unmount(path: text) -> Result<bool, text>:
    val result = syscall(38, unsafe_addr_of(path), path.len() as u64, 0, 0, 0)
    if result < 0:
        return Err("unmount failed with code {result}")
    Ok(true)

fn mount_list() -> Result<[text], text>:
    val resp = _vfs_request(VFS_MOUNT_LIST, "")?
    if resp.len() == 0:
        return Ok([])
    val entries = resp.split("\n")
    var result: [text] = []
    var i: u64 = 0
    while i < entries.len() as u64:
        val entry = entries[i as i64]
        if entry.len() > 0:
            result.push(entry)
        i = i + 1
    Ok(result)

# Minimal process-side byte I/O surface used by filesystem-launched tools.
export file_open_direct, file_read_direct, file_close_direct, stat, list_directory_bounded,
    VfsDirectoryListing, VfsFileStat, file_stat_bounded, file_lstat_bounded, file_fstat_bounded,
    VFS_DIRECTORY_ENTRY_LIMIT,
    VFS_DIRECTORY_NAME_BYTES_LIMIT, VFS_DIRECTORY_TOTAL_NAME_BYTES_LIMIT
