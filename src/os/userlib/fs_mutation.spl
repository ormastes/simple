# Capability-enforced filesystem namespace mutations through the canonical VFS
# service. The kernel IPC connect gate and VFS lookup-grant policy remain the
# mutation authorities; this client additionally owns bounded wire validation.

use os.userlib.fs.{vfs_ipc_request_bytes}
use os.userlib.ipc_protocol.{VFS_MKDIR, VFS_REMOVE, VFS_RENAME, VFS_RMDIR, VFS_CHMOD, VFS_SYMLINK, VFS_READLINK}
use std.nogc_sync_mut.binary_io.{bytes_to_string}

pub const VFS_MUTATION_PATH_MAX_BYTES: u64 = 4096u64

fn _mutation_path_bytes(path: text) -> Result<[u8], text>:
    if path.len() == 0u64:
        return Err("empty mutation path")
    if path.len() > VFS_MUTATION_PATH_MAX_BYTES:
        return Err("mutation path exceeds 4096-byte limit")
    if path == "/":
        return Err("refusing to mutate filesystem root")
    var bytes: [u8] = []
    var index: u64 = 0u64
    while index < path.len():
        val byte = path.byte_at(index)
        if byte == 0u8:
            return Err("mutation path contains NUL")
        bytes.push(byte)
        index = index + 1u64
    Ok(bytes)

fn _read_u64_le(bytes: [u8]) -> u64:
    var value: u64 = 0u64
    var index: u64 = 0u64
    while index < 8u64:
        value = value | (bytes[index].to_u64() << (index * 8u64))
        index = index + 1u64
    value

fn _vfs_mutate_checked(method: u32, path: text) -> Result<bool, text>:
    val payload = _mutation_path_bytes(path)?
    val response = vfs_ipc_request_bytes(method, payload)?
    if response.len() != 8u64:
        return Err("malformed VFS mutation reply")
    if _read_u64_le(response) != 1u64:
        return Err("VFS mutation was not acknowledged")
    Ok(true)

pub fn vfs_mkdir_checked(path: text) -> Result<bool, text>:
    """Create one directory after canonical VFS capability/grant checks."""
    _vfs_mutate_checked(VFS_MKDIR, path)

pub fn vfs_unlink_checked(path: text) -> Result<bool, text>:
    """Remove one non-directory after canonical VFS capability/grant checks."""
    _vfs_mutate_checked(VFS_REMOVE, path)

pub fn vfs_rmdir_checked(path: text) -> Result<bool, text>:
    """Remove one empty directory after canonical VFS capability/grant checks."""
    _vfs_mutate_checked(VFS_RMDIR, path)

pub fn vfs_rename_checked(old_path: text, new_path: text) -> Result<bool, text>:
    """Rename one entry after canonical VFS capability/grant checks."""
    var payload = _mutation_path_bytes(old_path)?
    payload.push(0u8)
    val new_path_bytes = _mutation_path_bytes(new_path)?
    if payload.len() > VFS_MUTATION_PATH_MAX_BYTES or
        new_path_bytes.len() > VFS_MUTATION_PATH_MAX_BYTES - payload.len():
        return Err("rename request exceeds 4096-byte limit")
    for byte in new_path_bytes:
        payload.push(byte)
    val response = vfs_ipc_request_bytes(VFS_RENAME, payload)?
    if response.len() != 8u64:
        return Err("malformed VFS rename reply")
    if _read_u64_le(response) != 1u64:
        return Err("VFS rename was not acknowledged")
    Ok(true)

pub fn vfs_chmod_checked(path: text, mode: u16) -> Result<bool, text>:
    """Change mode after canonical VFS capability/grant checks."""
    var payload = _mutation_path_bytes(path)?
    payload.push(0u8)
    payload.push((mode & 0xFFu16).to_u8())
    payload.push(((mode >> 8u16) & 0xFFu16).to_u8())
    val response = vfs_ipc_request_bytes(VFS_CHMOD, payload)?
    if response.len() != 8u64:
        return Err("malformed VFS mutation reply")
    if _read_u64_le(response) != 1u64:
        return Err("VFS mutation was not acknowledged")
    Ok(true)

pub fn vfs_symlink_checked(target: text, link_path: text) -> Result<bool, text>:
    """Create one symbolic link through the canonical VFS capability owner.

    The target is stored verbatim and may be relative. The link path is the
    mutated namespace entry and therefore receives the normal root guard.
    """
    if target.len() == 0u64:
        return Err("empty symbolic-link target")
    if target.len() > VFS_MUTATION_PATH_MAX_BYTES:
        return Err("symbolic-link target exceeds 4096-byte limit")
    var payload: [u8] = []
    var target_index: u64 = 0u64
    while target_index < target.len():
        val byte = target.byte_at(target_index)
        if byte == 0u8:
            return Err("symbolic-link target contains NUL")
        payload.push(byte)
        target_index = target_index + 1u64
    payload.push(0u8)
    val link_bytes = _mutation_path_bytes(link_path)?
    if payload.len() + link_bytes.len() > VFS_MUTATION_PATH_MAX_BYTES:
        return Err("symbolic-link request exceeds 4096-byte limit")
    for byte in link_bytes:
        payload.push(byte)
    val response = vfs_ipc_request_bytes(VFS_SYMLINK, payload)?
    if response.len() != 8u64:
        return Err("malformed VFS symbolic-link reply")
    if _read_u64_le(response) != 1u64:
        return Err("VFS symbolic-link mutation was not acknowledged")
    Ok(true)

pub fn vfs_readlink_checked(path: text) -> Result<text, text>:
    """Read one bounded symbolic-link target through the canonical VFS owner."""
    val payload = _mutation_path_bytes(path)?
    val response = vfs_ipc_request_bytes(VFS_READLINK, payload)?
    if response.len() == 0u64:
        return Err("VFS symbolic-link target is empty")
    if response.len() > VFS_MUTATION_PATH_MAX_BYTES:
        return Err("VFS symbolic-link target exceeds 4096-byte limit")
    for byte in response:
        if byte == 0u8:
            return Err("VFS symbolic-link target contains NUL")
    Ok(bytes_to_string(response))
