# Window Client Library — user-space API for window management
#
# Provides a high-level interface for applications to create and manage
# windows through the compositor's IPC service. Handles connection
# setup, request serialization, and event polling.
#
# Usage:
#   var client = WindowClient.new()
#   client.connect()
#   val wid = client.create_window("My App", 100, 100, 640, 480)
#   while true:
#       val event = client.poll_event()
#       if event != nil:
#           handle_event(event)
#   client.destroy_window()
#   client.disconnect()
#
# Multi-window usage:
#   val inspector = client.create_window("Inspector", 700, 120, 320, 220)
#   client.set_title_for(inspector, "Inspector — Live")
#   client.resize_window(inspector, 360, 240)
#   client.focus_window(inspector)
#
# Wire protocol:
#   Outgoing requests to compositor use the same encoding as wm_service.spl.
#   Incoming events (input, close, focus) are pushed by the WM service.

# Split from src/os/userlib/window.spl to keep module cohesion under the 800-line source limit.
export use os.userlib._Window.client.{rt_get_args, rt_host_wm_client_connect, rt_host_wm_client_request, rt_host_wm_client_poll_event, SYS_IPC_SEND, SYS_IPC_RECV, SYS_IPC_CREATE_PORT, SYS_IPC_CONNECT, IPC_COPIED_SERVICE_TAG, WM_PORT_NAME, window_default_app_identity_from_args, WindowClient}
export use os.userlib._Window.client_methods.{rt_get_args, rt_host_wm_client_connect, rt_host_wm_client_request, rt_host_wm_client_poll_event, unsafe_addr_of}
export use os.userlib._Window.ipc_helpers.{rt_get_args, rt_host_wm_client_connect, rt_host_wm_client_request, rt_host_wm_client_poll_event, mmio_read8, mmio_read32, mmio_read64, unsafe_addr_of}
