pub fn syscall(id: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64) -> i64:
    var result: i64 = 0
    asm volatile {
        "mov x8, {id}"
        "mov x0, {arg0}"
        "mov x1, {arg1}"
        "mov x2, {arg2}"
        "mov x3, {arg3}"
        "mov x4, {arg4}"
        "svc #0"
        "mov {out}, x0"
        in(reg) id
        in(reg) arg0
        in(reg) arg1
        in(reg) arg2
        in(reg) arg3
        in(reg) arg4
        out(reg) result
        clobber("x0", "x1", "x2", "x3", "x4", "x8")
    }
    result
