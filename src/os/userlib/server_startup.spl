# User boundary for loader/scheduler-issued server startup evidence.

use os.userlib.syscall_raw.{syscall}

pub(package) class ServerStartupAdmissionV1:
    # The field and type remain inside the `os` package.  Network-facing app
    # code can carry the receipt to sibling service owners, but code outside
    # the package cannot construct or inspect it as a boolean readiness flag.
    consumed: bool

pub fn server_startup_result_admitted_v1(result: i64) -> bool:
    """Interpret ABI 116 strictly: only the canonical success value admits."""
    result == 1

pub fn server_startup_evidence_consume_v1() -> bool:
    """Consume the current execution's one-shot server startup evidence."""
    server_startup_result_admitted_v1(
        syscall(116u64, 0u64, 0u64, 0u64, 0u64, 0u64))

pub(package) fn server_startup_admission_consume_v1(
) -> ServerStartupAdmissionV1:
    """Consume ABI 116 once and wrap its result for sibling service owners."""
    ServerStartupAdmissionV1(
        consumed: server_startup_evidence_consume_v1())

pub(package) fn server_startup_admission_ready_v1(
    admission: ServerStartupAdmissionV1
) -> bool:
    admission.consumed
