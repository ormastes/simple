# Network abstractions over raw syscalls.

use os.userlib.syscall_raw
use os.kernel.types.syscall_types.{new_net_if_info}

extern fn unsafe_addr_of(ref: any) -> u64

class IpAddr:
    octets: [u8]

fn _parse_decimal_u8(s: text) -> Result<u8, text>:
    if s == "":
        return Err("empty decimal value")
    var out: u64 = 0
    for ch in s:
        if ch < "0" or ch > "9":
            return Err("invalid decimal value: {s}")
        out = out * 10 + (ch.to_i32() - "0".to_i32()).to_u64()
    if out > 255:
        return Err("decimal value out of range: {s}")
    Ok(out.to_u8())

impl IpAddr:
    fn to_text() -> text:
        "{self.octets[0]}.{self.octets[1]}.{self.octets[2]}.{self.octets[3]}"

    static fn from_text(s: text) -> Result<IpAddr, text>:
        val parts = s.split(".")
        if parts.len() != 4:
            return Err("invalid IP address: {s}")
        var octets: [u8] = []
        var i = 0
        while i < 4:
            val parsed = _parse_decimal_u8(parts[i])
            match parsed:
                case Ok(octet): octets.push(octet)
                case Err(_): return Err("IP octet invalid: {parts[i]}")
            i = i + 1
        Ok(IpAddr(octets: octets))

class SockAddr:
    ip: IpAddr
    port: u16

class Socket:
    fd: i32

val _NET_MAX_USER_RECV: u64 = 1048576

fn socket(domain: u32, sock_type: u32) -> Result<Socket, text>:
    val result = syscall(70, domain as u64, sock_type as u64, 0, 0, 0)
    if result < 0:
        return Err("socket failed with code {result}")
    Ok(Socket(fd: result as i32))

fn connect(sock: Socket, addr: SockAddr) -> Result<bool, text>:
    val encoded = _sockaddr_bytes(addr)
    val result = rt_simpleos_socket_connect_bytes(sock.fd as u64, encoded)
    if result < 0:
        return Err("connect failed with code {result}")
    Ok(true)

fn bind(sock: Socket, addr: SockAddr) -> Result<bool, text>:
    val encoded = _sockaddr_bytes(addr)
    val result = rt_simpleos_socket_bind_bytes(sock.fd as u64, encoded)
    if result < 0:
        return Err("bind failed with code {result}")
    Ok(true)

fn listen(sock: Socket, backlog: i32) -> Result<bool, text>:
    val result = syscall(72, sock.fd as u64, backlog as u64, 0, 0, 0)
    if result < 0:
        return Err("listen failed with code {result}")
    Ok(true)

fn accept(sock: Socket) -> Result<Socket, text>:
    val result = syscall(74, sock.fd as u64, 0, 0, 0, 0)
    if result < 0:
        return Err("accept failed with code {result}")
    Ok(Socket(fd: result as i32))

fn send(sock: Socket, data: [u8]) -> Result<u64, text>:
    val result = rt_simpleos_socket_send_bytes(sock.fd as u64, data)
    if result < 0:
        return Err("send failed with code {result}")
    if result as u64 > data.len() as u64:
        return Err("send returned invalid length {result}")
    Ok(result as u64)

fn socket_send(sock: Socket, data: [u8]) -> Result<u64, text>:
    """Keyword-safe wrapper for socket send."""
    val result = rt_simpleos_socket_send_bytes(sock.fd as u64, data)
    if result < 0:
        return Err("send failed with code {result}")
    if result as u64 > data.len() as u64:
        return Err("send returned invalid length {result}")
    Ok(result as u64)

fn recv(sock: Socket, max_len: u64) -> Result<[u8], text>:
    if max_len > _NET_MAX_USER_RECV:
        return Err("recv requested invalid length {max_len}")
    var buf: [u8] = [0; max_len]
    val result = rt_simpleos_socket_recv_bytes(sock.fd as u64, buf, max_len)
    if result < 0:
        return Err("recv failed with code {result}")
    if result as u64 > max_len:
        return Err("recv returned invalid length {result}")
    Ok(buf.slice(0, result as u64))

fn socket_recv(sock: Socket, max_len: u64) -> Result<[u8], text>:
    """Keyword-safe wrapper for socket recv."""
    if max_len > _NET_MAX_USER_RECV:
        return Err("recv requested invalid length {max_len}")
    var buf: [u8] = [0; max_len]
    val result = rt_simpleos_socket_recv_bytes(sock.fd as u64, buf, max_len)
    if result < 0:
        return Err("recv failed with code {result}")
    if result as u64 > max_len:
        return Err("recv returned invalid length {result}")
    Ok(buf.slice(0, result as u64))

fn ifconfig(if_index: u32) -> Result<NetIfInfo, text>:
    var info = new_net_if_info()
    val result = syscall(77, if_index as u64, unsafe_addr_of(info), 0, 0, 0)
    if result < 0:
        return Err("ifconfig failed with code {result}")
    Ok(info)

fn _pack_sockaddr(addr: SockAddr) -> u64:
    val o = addr.ip.octets
    val packed = (o[0] as u64) | ((o[1] as u64) << 8) | ((o[2] as u64) << 16) | ((o[3] as u64) << 24)
    packed

fn _sockaddr_bytes(addr: SockAddr) -> [u8]:
    """Encode a bounded POSIX sockaddr_in for syscalls 71 and 73."""
    val o = addr.ip.octets
    var encoded: [u8] = [0u8; 16]
    encoded[0] = 2u8
    encoded[1] = 0u8
    encoded[2] = ((addr.port >> 8) & 0xFF).to_u8()
    encoded[3] = (addr.port & 0xFF).to_u8()
    encoded[4] = o[0]
    encoded[5] = o[1]
    encoded[6] = o[2]
    encoded[7] = o[3]
    encoded
