# Architecture-selected raw syscall facade.

@cfg(x86_64)
use os.userlib.syscall_target_x86_64.{syscall}
@cfg(arm64)
use os.userlib.syscall_target_arm64.{syscall}
@cfg(riscv64)
use os.userlib.syscall_target_riscv64.{syscall}
@cfg(riscv32)
use os.userlib.syscall_target_riscv32.{syscall}

export syscall
