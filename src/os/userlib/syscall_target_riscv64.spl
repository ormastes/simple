fn syscall(id: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64) -> i64:
    var result: i64 = 0
    asm volatile {
        "mv a7, {id}"
        "mv a0, {arg0}"
        "mv a1, {arg1}"
        "mv a2, {arg2}"
        "mv a3, {arg3}"
        "mv a4, {arg4}"
        "ecall"
        "mv {out}, a0"
        in(reg) id
        in(reg) arg0
        in(reg) arg1
        in(reg) arg2
        in(reg) arg3
        in(reg) arg4
        out(reg) result
    }
    result

export syscall
