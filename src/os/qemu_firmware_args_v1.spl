# Pure command planning. Firmware selection is metadata, not boot evidence.
pub struct QemuFirmwareArgsV1:
    bios: text
    extra: [text]

# A target field and legacy extra arguments may agree; contradictory sources
# must not silently depend on QEMU's last-option-wins behavior.
pub fn qemu_firmware_args_v1(declared: text, extra: [text]) -> Result<QemuFirmwareArgsV1, text>:
    var bios = declared
    var kept: [text] = []
    var i = 0
    while i < extra.len():
        val option = extra[i]
        if option == "-bios" or option == "--bios":
            if i + 1 >= extra.len():
                return Err("QEMU firmware option is missing its operand")
            val operand = extra[i + 1]
            if operand == "" or operand.starts_with("-"):
                return Err("QEMU firmware option has an invalid operand")
            if bios != "" and bios != operand:
                return Err("QEMU firmware field conflicts with extra arguments")
            bios = operand
            i = i + 2
        elif option.starts_with("-bios=") or option.starts_with("--bios="):
            # QEMU firmware is a separate argv operand; reject alternate
            # spelling rather than allowing an unchecked later override.
            return Err("QEMU firmware requires a separate option operand")
        else:
            kept.push(option)
            i = i + 1
    Ok(QemuFirmwareArgsV1(bios: bios, extra: kept))
