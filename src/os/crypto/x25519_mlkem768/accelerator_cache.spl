# Feature-level bounded owner for warmed X25519MLKEM768 accelerator executors.

mod os.crypto.x25519_mlkem768.accelerator_cache

use os.crypto.x25519_mlkem768.cache_identity.{
    X25519MlKem768CacheIdentity}
use os.crypto.x25519_mlkem768.cuda_ntt_provider.{
    X25519MlKem768CudaNttExecutor}
use os.crypto.x25519_mlkem768.metal_ntt_provider.{
    X25519MlKem768MetalNttExecutor}
use os.crypto.x25519_mlkem768.vulkan_ntt_provider.{
    X25519MlKem768VulkanNttExecutor}
use lib.common.crypto.x25519_mlkem768.contract.{X25519MlKem768Config}
use os.crypto.x25519_mlkem768.execution_policy.{
    x25519_mlkem768_resolve_cuda_candidate,
    x25519_mlkem768_resolve_metal_candidate,
    x25519_mlkem768_resolve_vulkan_candidate}

val X25519_MLKEM768_ACCELERATOR_CACHE_MAX_CAPACITY: i64 = 64
val _X25519_MLKEM768_GPU_CLEANUP_PENDING =
    "x25519mlkem768-cache-gpu-cleanup-pending"

struct X25519MlKem768CacheIndexEntry:
    backend: text
    admission_digest: text
    execution_digest: text

struct X25519MlKem768CacheEviction:
    backend: text
    admission_digest: text

struct X25519MlKem768CacheInsertResult:
    reason: text
    eviction: X25519MlKem768CacheEviction

struct X25519MlKem768QuarantineRetryOutcome:
    attempted: i64
    reaped: i64
    pending: i64
    cuda_reason: text
    metal_reason: text
    vulkan_reason: text

fn _empty_eviction() -> X25519MlKem768CacheEviction:
    X25519MlKem768CacheEviction(backend: "", admission_digest: "")

fn _cache_backend_valid(backend: text) -> bool:
    backend == "cuda" or backend == "metal" or backend == "vulkan"

fn _cache_digest_valid(digest: text) -> bool:
    if digest.len() != 64:
        return false
    var i: i64 = 0
    while i < digest.len():
        val digit = digest.slice(i, i + 1)
        if not "0123456789abcdefABCDEF".contains(digit):
            return false
        i = i + 1
    true

class X25519MlKem768AcceleratorCacheIndex:
    capacity: i64
    entries: [X25519MlKem768CacheIndexEntry]
    hits: i64
    misses: i64
    evictions: i64

    static fn create(capacity: i64) -> X25519MlKem768AcceleratorCacheIndex:
        X25519MlKem768AcceleratorCacheIndex(
            capacity: capacity, entries: [], hits: 0, misses: 0,
            evictions: 0)

    fn size() -> i64:
        self.entries.len().to_i64()

    me probe(backend: text, admission_digest: text) -> i64:
        var i: i64 = 0
        while i < self.entries.len().to_i64():
            val entry = self.entries.get(i)
            if (entry.backend == backend and
                    entry.admission_digest == admission_digest):
                return i
            i = i + 1
        self.misses = self.misses + 1
        -1

    me validate_hit(index: i64, execution_digest: text) -> text:
        if index < 0 or index >= self.entries.len().to_i64():
            return "x25519mlkem768-cache-index-corrupt"
        if self.entries.get(index).execution_digest != execution_digest:
            return "x25519mlkem768-cache-execution-key-mismatch"
        self.hits = self.hits + 1
        ""

    me remove(backend: text,
            admission_digest: text) -> X25519MlKem768CacheEviction:
        var i: i64 = 0
        while i < self.entries.len().to_i64():
            val entry = self.entries.get(i)
            if (entry.backend == backend and
                    entry.admission_digest == admission_digest):
                self.entries.remove(i)
                return X25519MlKem768CacheEviction(
                    backend: backend, admission_digest: admission_digest)
            i = i + 1
        _empty_eviction()

    me pop_oldest() -> X25519MlKem768CacheEviction:
        if self.entries.len() == 0:
            return _empty_eviction()
        val oldest = self.entries.get(0)
        self.entries.remove(0)
        X25519MlKem768CacheEviction(
            backend: oldest.backend,
            admission_digest: oldest.admission_digest)

    me insert(backend: text, admission_digest: text,
            execution_digest: text) -> X25519MlKem768CacheInsertResult:
        if (self.capacity <= 0 or self.capacity >
                X25519_MLKEM768_ACCELERATOR_CACHE_MAX_CAPACITY):
            return X25519MlKem768CacheInsertResult(
                reason: "x25519mlkem768-cache-capacity-invalid",
                eviction: _empty_eviction())
        if not _cache_backend_valid(backend):
            return X25519MlKem768CacheInsertResult(
                reason: "x25519mlkem768-cache-backend-invalid",
                eviction: _empty_eviction())
        if (not _cache_digest_valid(admission_digest) or
                not _cache_digest_valid(execution_digest)):
            return X25519MlKem768CacheInsertResult(
                reason: "x25519mlkem768-cache-key-invalid",
                eviction: _empty_eviction())
        if self.entries.len().to_i64() > self.capacity:
            return X25519MlKem768CacheInsertResult(
                reason: "x25519mlkem768-cache-index-corrupt",
                eviction: _empty_eviction())
        var i: i64 = 0
        while i < self.entries.len().to_i64():
            val entry = self.entries.get(i)
            if (entry.backend == backend and
                    entry.admission_digest == admission_digest):
                return X25519MlKem768CacheInsertResult(
                    reason: "x25519mlkem768-cache-index-duplicate",
                    eviction: _empty_eviction())
            i = i + 1
        var eviction = _empty_eviction()
        if self.entries.len().to_i64() >= self.capacity:
            eviction = self.pop_oldest()
            self.evictions = self.evictions + 1
        self.entries.push(X25519MlKem768CacheIndexEntry(
            backend: backend, admission_digest: admission_digest,
            execution_digest: execution_digest))
        X25519MlKem768CacheInsertResult(reason: "", eviction: eviction)

class _CudaCacheEntry:
    admission_digest: text
    execution_digest: text
    executor: X25519MlKem768CudaNttExecutor

class _MetalCacheEntry:
    admission_digest: text
    execution_digest: text
    executor: X25519MlKem768MetalNttExecutor

class _VulkanCacheEntry:
    admission_digest: text
    execution_digest: text
    executor: X25519MlKem768VulkanNttExecutor

fn _execution_identity_reason(identity: X25519MlKem768CacheIdentity,
        backend: text, admission_digest: text,
        expected_execution_digest: text) -> text:
    if not identity.bound or identity.backend != backend:
        return "x25519mlkem768-cache-bound-identity-invalid"
    if identity.admission_digest != admission_digest:
        return "x25519mlkem768-cache-admission-key-mismatch"
    if identity.device_identity <= 0 or identity.key_digest.len() != 64:
        return "x25519mlkem768-cache-device-invalid"
    if (expected_execution_digest != "" and
            identity.key_digest != expected_execution_digest):
        return "x25519mlkem768-cache-execution-key-mismatch"
    ""

fn _cuda_proposal_ownership_reason(
        executor: X25519MlKem768CudaNttExecutor) -> text:
    if (executor.device_identity > 0 or executor.session.module > 0 or
            executor.cache_identity.device_identity > 0):
        return "x25519mlkem768-cache-input-already-warmed"
    ""

fn _metal_proposal_ownership_reason(
        executor: X25519MlKem768MetalNttExecutor) -> text:
    if (executor.session.initialized or
            executor.cache_identity.device_identity > 0):
        return "x25519mlkem768-cache-input-already-warmed"
    ""

fn _vulkan_proposal_ownership_reason(
        executor: X25519MlKem768VulkanNttExecutor) -> text:
    if (executor.session.initialized or
            executor.cache_identity.device_identity > 0):
        return "x25519mlkem768-cache-input-already-warmed"
    ""

class X25519MlKem768AcceleratorCache:
    index: X25519MlKem768AcceleratorCacheIndex
    cuda_entries: [_CudaCacheEntry]
    metal_entries: [_MetalCacheEntry]
    vulkan_entries: [_VulkanCacheEntry]
    admission_failures: i64
    closed: bool

    static fn create(capacity: i64) -> Result<X25519MlKem768AcceleratorCache, text>:
        if (capacity <= 0 or capacity >
                X25519_MLKEM768_ACCELERATOR_CACHE_MAX_CAPACITY):
            return Err("x25519mlkem768-cache-capacity-invalid")
        Ok(X25519MlKem768AcceleratorCache(
            index: X25519MlKem768AcceleratorCacheIndex.create(capacity),
            cuda_entries: [], metal_entries: [], vulkan_entries: [],
            admission_failures: 0, closed: false))

    fn size() -> i64:
        self.index.size()

    me _record_failure():
        self.admission_failures = self.admission_failures + 1

    fn _cuda_index(admission_digest: text) -> i64:
        var i: i64 = 0
        while i < self.cuda_entries.len().to_i64():
            if self.cuda_entries.get(i).admission_digest == admission_digest:
                return i
            i = i + 1
        -1

    fn _metal_index(admission_digest: text) -> i64:
        var i: i64 = 0
        while i < self.metal_entries.len().to_i64():
            if self.metal_entries.get(i).admission_digest == admission_digest:
                return i
            i = i + 1
        -1

    fn _vulkan_index(admission_digest: text) -> i64:
        var i: i64 = 0
        while i < self.vulkan_entries.len().to_i64():
            if self.vulkan_entries.get(i).admission_digest == admission_digest:
                return i
            i = i + 1
        -1

    me _shutdown_cuda(admission_digest: text) -> text:
        val index = self._cuda_index(admission_digest)
        if index < 0:
            return "x25519mlkem768-cache-index-corrupt"
        val executor = self.cuda_entries.get(index).executor
        executor.shutdown()
        if executor.session.completion_unknown:
            self.closed = true
            return _X25519_MLKEM768_GPU_CLEANUP_PENDING
        self.cuda_entries.remove(index)
        ""

    me _shutdown_metal(admission_digest: text) -> text:
        val index = self._metal_index(admission_digest)
        if index < 0:
            return "x25519mlkem768-cache-index-corrupt"
        val executor = self.metal_entries.get(index).executor
        executor.shutdown()
        if executor.session.completion_unknown:
            self.closed = true
            return _X25519_MLKEM768_GPU_CLEANUP_PENDING
        self.metal_entries.remove(index)
        ""

    me _shutdown_vulkan(admission_digest: text) -> text:
        val index = self._vulkan_index(admission_digest)
        if index < 0:
            return "x25519mlkem768-cache-index-corrupt"
        val executor = self.vulkan_entries.get(index).executor
        val shutdown_reason = executor.shutdown()
        if executor.session.completion_unknown:
            self.closed = true
            return _X25519_MLKEM768_GPU_CLEANUP_PENDING
        if shutdown_reason != "":
            self.closed = true
            return shutdown_reason
        self.vulkan_entries.remove(index)
        ""

    me _shutdown_eviction(eviction: X25519MlKem768CacheEviction) -> text:
        if eviction.backend == "":
            return ""
        if eviction.backend == "cuda":
            return self._shutdown_cuda(eviction.admission_digest)
        if eviction.backend == "metal":
            return self._shutdown_metal(eviction.admission_digest)
        if eviction.backend == "vulkan":
            return self._shutdown_vulkan(eviction.admission_digest)
        "x25519mlkem768-cache-backend-invalid"

    fn _eviction_ready_reason() -> text:
        if self.index.size() < self.index.capacity:
            return ""
        if self.index.size() != self.index.capacity:
            return "x25519mlkem768-cache-index-corrupt"
        if self.index.entries.len() == 0:
            return "x25519mlkem768-cache-index-corrupt"
        val oldest = self.index.entries.get(0)
        if oldest.backend == "cuda" and self._cuda_index(
                oldest.admission_digest) >= 0:
            return ""
        if oldest.backend == "metal" and self._metal_index(
                oldest.admission_digest) >= 0:
            return ""
        if oldest.backend == "vulkan" and self._vulkan_index(
                oldest.admission_digest) >= 0:
            return ""
        "x25519mlkem768-cache-index-corrupt"

    me _evict_for_admission() -> text:
        val ready_reason = self._eviction_ready_reason()
        if ready_reason != "":
            return ready_reason
        if self.index.size() < self.index.capacity:
            return ""
        val oldest = self.index.entries.get(0)
        val eviction = X25519MlKem768CacheEviction(
            backend: oldest.backend,
            admission_digest: oldest.admission_digest)
        val shutdown_reason = self._shutdown_eviction(eviction)
        if shutdown_reason != "":
            self.closed = true
            return shutdown_reason
        val removed = self.index.remove(
            eviction.backend, eviction.admission_digest)
        if removed.backend == "":
            self.closed = true
            return "x25519mlkem768-cache-index-corrupt"
        ""

    me _invalidate_cuda(admission_digest: text) -> text:
        val shutdown_reason = self._shutdown_cuda(admission_digest)
        if shutdown_reason != "":
            self.closed = true
            return shutdown_reason
        val removed = self.index.remove("cuda", admission_digest)
        if removed.backend == "":
            self.closed = true
            return "x25519mlkem768-cache-index-corrupt"
        ""

    me _invalidate_metal(admission_digest: text) -> text:
        val shutdown_reason = self._shutdown_metal(admission_digest)
        if shutdown_reason != "":
            self.closed = true
            return shutdown_reason
        val removed = self.index.remove("metal", admission_digest)
        if removed.backend == "":
            self.closed = true
            return "x25519mlkem768-cache-index-corrupt"
        ""

    me _invalidate_vulkan(admission_digest: text) -> text:
        val shutdown_reason = self._shutdown_vulkan(admission_digest)
        if shutdown_reason != "":
            self.closed = true
            return shutdown_reason
        val removed = self.index.remove("vulkan", admission_digest)
        if removed.backend == "":
            self.closed = true
            return "x25519mlkem768-cache-index-corrupt"
        ""

    me admit_cuda(executor: X25519MlKem768CudaNttExecutor,
            implementation_version: text, profile_version: text,
            configuration_digest: text) -> Result<X25519MlKem768CudaNttExecutor, text>:
        val ownership_reason = _cuda_proposal_ownership_reason(executor)
        if ownership_reason != "":
            self._record_failure()
            return Err(ownership_reason)
        if self.closed:
            executor.shutdown()
            self._record_failure()
            return Err("x25519mlkem768-cache-closed")
        val bind_reason = executor.bind_cache_contract(
            implementation_version, profile_version, configuration_digest)
        if bind_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(bind_reason)
        val admission_digest = executor.cache_identity.admission_digest
        val index = self.index.probe("cuda", admission_digest)
        if index >= 0:
            val typed_index = self._cuda_index(admission_digest)
            if typed_index < 0:
                val _removed_corrupt = self.index.remove(
                    "cuda", admission_digest)
                executor.shutdown()
                self._record_failure()
                return Err("x25519mlkem768-cache-index-corrupt")
            val retained = self.cuda_entries.get(typed_index).executor
            val warmup_reason = retained.warmup()
            val identity_reason = if warmup_reason == "":
                _execution_identity_reason(retained.cache_identity, "cuda",
                    admission_digest,
                    self.cuda_entries.get(typed_index).execution_digest)
            else:
                warmup_reason
            val hit_reason = if identity_reason == "":
                self.index.validate_hit(index,
                    retained.cache_identity.key_digest)
            else:
                identity_reason
            executor.shutdown()
            if hit_reason != "":
                val cleanup_reason = self._invalidate_cuda(admission_digest)
                self._record_failure()
                if cleanup_reason != "":
                    return Err(cleanup_reason)
                return Err(hit_reason)
            return Ok(retained)
        val warmup_reason = executor.warmup()
        if warmup_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(warmup_reason)
        val identity_reason = _execution_identity_reason(
            executor.cache_identity, "cuda", admission_digest, "")
        if identity_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(identity_reason)
        val eviction_reason = self._evict_for_admission()
        if eviction_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(eviction_reason)
        val inserted = self.index.insert("cuda", admission_digest,
            executor.cache_identity.key_digest)
        if inserted.reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(inserted.reason)
        if inserted.eviction.backend != "":
            val _removed = self.index.remove("cuda", admission_digest)
            executor.shutdown()
            self.closed = true
            self._record_failure()
            return Err("x25519mlkem768-cache-index-corrupt")
        self.cuda_entries.push(_CudaCacheEntry(
            admission_digest: admission_digest,
            execution_digest: executor.cache_identity.key_digest,
            executor: executor))
        Ok(executor)

    me admit_cuda_config(executor: X25519MlKem768CudaNttExecutor,
            config: X25519MlKem768Config) -> Result<X25519MlKem768CudaNttExecutor, text>:
        val ownership_reason = _cuda_proposal_ownership_reason(executor)
        if ownership_reason != "":
            self._record_failure()
            return Err(ownership_reason)
        val evidence = match x25519_mlkem768_resolve_cuda_candidate(
                config, "cache-admission"):
            case Ok(value): value
            case Err(reason):
                executor.shutdown()
                self._record_failure()
                return Err(reason)
        self.admit_cuda(executor, config.implementation_version,
            config.profile_version, evidence.configuration_digest)

    me admit_metal(executor: X25519MlKem768MetalNttExecutor,
            implementation_version: text, profile_version: text,
            configuration_digest: text) -> Result<X25519MlKem768MetalNttExecutor, text>:
        val ownership_reason = _metal_proposal_ownership_reason(executor)
        if ownership_reason != "":
            self._record_failure()
            return Err(ownership_reason)
        if self.closed:
            executor.shutdown()
            self._record_failure()
            return Err("x25519mlkem768-cache-closed")
        val bind_reason = executor.bind_cache_contract(
            implementation_version, profile_version, configuration_digest)
        if bind_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(bind_reason)
        val admission_digest = executor.cache_identity.admission_digest
        val index = self.index.probe("metal", admission_digest)
        if index >= 0:
            val typed_index = self._metal_index(admission_digest)
            if typed_index < 0:
                val _removed_corrupt = self.index.remove(
                    "metal", admission_digest)
                executor.shutdown()
                self._record_failure()
                return Err("x25519mlkem768-cache-index-corrupt")
            val retained = self.metal_entries.get(typed_index).executor
            val warmup_reason = retained.warmup()
            val identity_reason = if warmup_reason == "":
                _execution_identity_reason(retained.cache_identity, "metal",
                    admission_digest,
                    self.metal_entries.get(typed_index).execution_digest)
            else:
                warmup_reason
            val hit_reason = if identity_reason == "":
                self.index.validate_hit(index,
                    retained.cache_identity.key_digest)
            else:
                identity_reason
            executor.shutdown()
            if hit_reason != "":
                val cleanup_reason = self._invalidate_metal(admission_digest)
                self._record_failure()
                if cleanup_reason != "":
                    return Err(cleanup_reason)
                return Err(hit_reason)
            return Ok(retained)
        val warmup_reason = executor.warmup()
        if warmup_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(warmup_reason)
        val identity_reason = _execution_identity_reason(
            executor.cache_identity, "metal", admission_digest, "")
        if identity_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(identity_reason)
        val eviction_reason = self._evict_for_admission()
        if eviction_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(eviction_reason)
        val inserted = self.index.insert("metal", admission_digest,
            executor.cache_identity.key_digest)
        if inserted.reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(inserted.reason)
        if inserted.eviction.backend != "":
            val _removed = self.index.remove("metal", admission_digest)
            executor.shutdown()
            self.closed = true
            self._record_failure()
            return Err("x25519mlkem768-cache-index-corrupt")
        self.metal_entries.push(_MetalCacheEntry(
            admission_digest: admission_digest,
            execution_digest: executor.cache_identity.key_digest,
            executor: executor))
        Ok(executor)

    me admit_metal_config(executor: X25519MlKem768MetalNttExecutor,
            config: X25519MlKem768Config) -> Result<X25519MlKem768MetalNttExecutor, text>:
        val ownership_reason = _metal_proposal_ownership_reason(executor)
        if ownership_reason != "":
            self._record_failure()
            return Err(ownership_reason)
        val evidence = match x25519_mlkem768_resolve_metal_candidate(
                config, "cache-admission"):
            case Ok(value): value
            case Err(reason):
                executor.shutdown()
                self._record_failure()
                return Err(reason)
        self.admit_metal(executor, config.implementation_version,
            config.profile_version, evidence.configuration_digest)

    me admit_vulkan(executor: X25519MlKem768VulkanNttExecutor,
            implementation_version: text, profile_version: text,
            configuration_digest: text) -> Result<X25519MlKem768VulkanNttExecutor, text>:
        val ownership_reason = _vulkan_proposal_ownership_reason(executor)
        if ownership_reason != "":
            self._record_failure()
            return Err(ownership_reason)
        if self.closed:
            executor.shutdown()
            self._record_failure()
            return Err("x25519mlkem768-cache-closed")
        val bind_reason = executor.bind_cache_contract(
            implementation_version, profile_version, configuration_digest)
        if bind_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(bind_reason)
        val admission_digest = executor.cache_identity.admission_digest
        val index = self.index.probe("vulkan", admission_digest)
        if index >= 0:
            val typed_index = self._vulkan_index(admission_digest)
            if typed_index < 0:
                val _removed_corrupt = self.index.remove(
                    "vulkan", admission_digest)
                executor.shutdown()
                self._record_failure()
                return Err("x25519mlkem768-cache-index-corrupt")
            val retained = self.vulkan_entries.get(typed_index).executor
            val warmup_reason = retained.warmup()
            val identity_reason = if warmup_reason == "":
                _execution_identity_reason(retained.cache_identity, "vulkan",
                    admission_digest,
                    self.vulkan_entries.get(typed_index).execution_digest)
            else:
                warmup_reason
            val hit_reason = if identity_reason == "":
                self.index.validate_hit(index,
                    retained.cache_identity.key_digest)
            else:
                identity_reason
            executor.shutdown()
            if hit_reason != "":
                val cleanup_reason = self._invalidate_vulkan(admission_digest)
                self._record_failure()
                if cleanup_reason != "":
                    return Err(cleanup_reason)
                return Err(hit_reason)
            return Ok(retained)
        val warmup_reason = executor.warmup()
        if warmup_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(warmup_reason)
        val identity_reason = _execution_identity_reason(
            executor.cache_identity, "vulkan", admission_digest, "")
        if identity_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(identity_reason)
        val eviction_reason = self._evict_for_admission()
        if eviction_reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(eviction_reason)
        val inserted = self.index.insert("vulkan", admission_digest,
            executor.cache_identity.key_digest)
        if inserted.reason != "":
            executor.shutdown()
            self._record_failure()
            return Err(inserted.reason)
        if inserted.eviction.backend != "":
            val _removed = self.index.remove("vulkan", admission_digest)
            executor.shutdown()
            self.closed = true
            self._record_failure()
            return Err("x25519mlkem768-cache-index-corrupt")
        self.vulkan_entries.push(_VulkanCacheEntry(
            admission_digest: admission_digest,
            execution_digest: executor.cache_identity.key_digest,
            executor: executor))
        Ok(executor)

    me admit_vulkan_config(executor: X25519MlKem768VulkanNttExecutor,
            config: X25519MlKem768Config) -> Result<X25519MlKem768VulkanNttExecutor, text>:
        val ownership_reason = _vulkan_proposal_ownership_reason(executor)
        if ownership_reason != "":
            self._record_failure()
            return Err(ownership_reason)
        val evidence = match x25519_mlkem768_resolve_vulkan_candidate(
                config, "cache-admission"):
            case Ok(value): value
            case Err(reason):
                executor.shutdown()
                self._record_failure()
                return Err(reason)
        self.admit_vulkan(executor, config.implementation_version,
            config.profile_version, evidence.configuration_digest)

    fn quarantined_owner_count() -> i64:
        if self.closed:
            return (self.cuda_entries.len().to_i64() +
                self.metal_entries.len().to_i64() +
                self.vulkan_entries.len().to_i64())
        var count: i64 = 0
        var i: i64 = 0
        while i < self.cuda_entries.len().to_i64():
            if self.cuda_entries.get(i).executor.session.completion_unknown:
                count = count + 1
            i = i + 1
        i = 0
        while i < self.metal_entries.len().to_i64():
            if self.metal_entries.get(i).executor.session.completion_unknown:
                count = count + 1
            i = i + 1
        i = 0
        while i < self.vulkan_entries.len().to_i64():
            val session = self.vulkan_entries.get(i).executor.session
            if session.completion_unknown or session.release_pending:
                count = count + 1
            i = i + 1
        count

    fn cleanup_pending() -> bool:
        self.quarantined_owner_count() > 0

    me retry_quarantined_cleanup() -> X25519MlKem768QuarantineRetryOutcome:
        if not self.closed:
            return X25519MlKem768QuarantineRetryOutcome(
                attempted: 0, reaped: 0, pending: 0,
                cuda_reason: "x25519mlkem768-cache-open",
                metal_reason: "x25519mlkem768-cache-open",
                vulkan_reason: "x25519mlkem768-cache-open")
        val before = self.quarantined_owner_count()
        var cuda_reason = "cuda-quarantine-not-pending"
        var metal_reason = "metal-quarantine-not-pending"
        var vulkan_reason = "vulkan-quarantine-not-pending"
        var i: i64 = 0
        while i < self.cuda_entries.len().to_i64():
            if self.cuda_entries.get(i).executor.session.completion_unknown:
                cuda_reason =
                    "cuda-quarantine-api-gap-context-query-restore-unavailable"
            i = i + 1
        i = 0
        while i < self.metal_entries.len().to_i64():
            if self.metal_entries.get(i).executor.session.completion_unknown:
                metal_reason =
                    "metal-quarantine-api-gap-command-buffer-handle-unavailable"
            i = i + 1
        i = 0
        while i < self.vulkan_entries.len().to_i64():
            val session = self.vulkan_entries.get(i).executor.session
            if session.completion_unknown or session.release_pending:
                vulkan_reason = session.retry_terminal_completion()
            elif vulkan_reason == "vulkan-quarantine-not-pending":
                vulkan_reason = "vulkan-quarantine-release-retry"
            i = i + 1
        self.shutdown()
        val after = self.quarantined_owner_count()
        X25519MlKem768QuarantineRetryOutcome(
            attempted: before, reaped: before - after, pending: after,
            cuda_reason: cuda_reason, metal_reason: metal_reason,
            vulkan_reason: vulkan_reason)

    me shutdown():
        self.closed = true
        # Cleanup is transactional: remove index metadata only after the typed
        # executor proves terminal completion and releases its dependencies.
        # Unknown-completion entries remain indexed and strongly owned by this
        # closed cache so neither reuse nor drop-last-owner is possible.
        var position: i64 = 0
        while position < self.index.entries.len().to_i64():
            val entry = self.index.entries.get(position)
            val eviction = X25519MlKem768CacheEviction(
                backend: entry.backend,
                admission_digest: entry.admission_digest)
            val shutdown_reason = self._shutdown_eviction(eviction)
            if shutdown_reason == "":
                val removed = self.index.remove(
                    eviction.backend, eviction.admission_digest)
                if removed.backend == "":
                    position = position + 1
            else:
                position = position + 1

        # Also close any typed owner whose index metadata was already absent
        # because of earlier corruption. Retain it if completion is unknown.
        var i: i64 = 0
        while i < self.cuda_entries.len().to_i64():
            val admission_digest = self.cuda_entries.get(i).admission_digest
            val shutdown_reason = self._shutdown_cuda(admission_digest)
            if shutdown_reason != "":
                i = i + 1
        i = 0
        while i < self.metal_entries.len().to_i64():
            val admission_digest = self.metal_entries.get(i).admission_digest
            val shutdown_reason = self._shutdown_metal(admission_digest)
            if shutdown_reason != "":
                i = i + 1
        i = 0
        while i < self.vulkan_entries.len().to_i64():
            val admission_digest = self.vulkan_entries.get(i).admission_digest
            val shutdown_reason = self._shutdown_vulkan(admission_digest)
            if shutdown_reason != "":
                i = i + 1

export X25519MlKem768AcceleratorCache
export X25519MlKem768AcceleratorCacheIndex
export X25519MlKem768CacheIndexEntry
export X25519MlKem768CacheEviction
export X25519MlKem768CacheInsertResult
export X25519MlKem768QuarantineRetryOutcome
export X25519_MLKEM768_ACCELERATOR_CACHE_MAX_CAPACITY
