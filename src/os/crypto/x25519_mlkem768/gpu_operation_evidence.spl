# Scalar verification and evidence mapping shared by GPU hybrid operations.

mod os.crypto.x25519_mlkem768.gpu_operation_evidence

use lib.common.crypto.x25519_mlkem768.contract.{X25519MlKem768Evidence}
use os.crypto.ml_kem.{ml_kem_keygen_checked, ml_kem_encaps_checked,
    ml_kem_decaps_checked}
use os.crypto.x25519_mlkem768.cuda_ntt_provider.{X25519MlKem768CudaNttExecutor}
use os.crypto.x25519_mlkem768.metal_ntt_provider.{X25519MlKem768MetalNttExecutor}
use os.crypto.x25519_mlkem768.vulkan_ntt_provider.{X25519MlKem768VulkanNttExecutor}
use std.common.crypto.sha256.{sha256_text}

fn _gpu_lists_equal(left: list, right: list) -> bool:
    var difference: i64 = left.len() ^ right.len()
    val compare_length = if left.len() < right.len(): left.len() else: right.len()
    var i: i64 = 0
    while i < compare_length:
        difference = difference | (left.get(i) ^ right.get(i))
        i = i + 1
    difference == 0

fn x25519_mlkem768_verify_gpu_keygen(d: list, z: list,
        encapsulation_key: list, decapsulation_key: list) -> text:
    val scalar_pair = match ml_kem_keygen_checked(d, z):
        case Ok(value): value
        case Err(reason): return "scalar key generation verification failed: " + reason
    val (scalar_encapsulation_key, scalar_decapsulation_key) = scalar_pair
    # Evaluate both comparisons before branching so a mismatch in the first
    # secret-bearing result cannot skip work on the second result.
    val encapsulation_key_matches = _gpu_lists_equal(
        encapsulation_key, scalar_encapsulation_key)
    val decapsulation_key_matches = _gpu_lists_equal(
        decapsulation_key, scalar_decapsulation_key)
    if not encapsulation_key_matches or not decapsulation_key_matches:
        return "GPU key generation failed scalar verification"
    ""

fn x25519_mlkem768_verify_gpu_encapsulate(encapsulation_key: list,
        m: list, mlkem_shared: list, ciphertext: list) -> text:
    val scalar_result = match ml_kem_encaps_checked(encapsulation_key, m):
        case Ok(value): value
        case Err(reason): return "scalar encapsulation verification failed: " + reason
    val (scalar_shared, scalar_ciphertext) = scalar_result
    val shared_matches = _gpu_lists_equal(mlkem_shared, scalar_shared)
    val ciphertext_matches = _gpu_lists_equal(ciphertext, scalar_ciphertext)
    if not shared_matches or not ciphertext_matches:
        return "GPU encapsulation failed scalar verification"
    ""

fn x25519_mlkem768_verify_gpu_decapsulate(decapsulation_key: list,
        ciphertext: list, mlkem_shared: list) -> text:
    val scalar_shared = match ml_kem_decaps_checked(decapsulation_key, ciphertext):
        case Ok(value): value
        case Err(reason): return "scalar decapsulation verification failed: " + reason
    if not _gpu_lists_equal(mlkem_shared, scalar_shared):
        return "GPU decapsulation failed scalar verification"
    ""

fn x25519_mlkem768_cuda_operation_evidence(evidence: X25519MlKem768Evidence,
        executor: X25519MlKem768CudaNttExecutor,
        invocations_before: i64, input_fixture_digest: text,
        output_digest: text) -> Result<X25519MlKem768Evidence, text>:
    if invocations_before < 0 or executor.kernel_invocations < invocations_before:
        return Err("CUDA full operation GPU invocation baseline invalid")
    val operation_invocations = executor.kernel_invocations - invocations_before
    if operation_invocations < 1:
        return Err("CUDA full operation produced no GPU kernel execution receipt")
    if not executor.fence_completed:
        return Err("CUDA full operation produced no completed device readback receipt")
    var updated = evidence
    updated.input_fixture_digest = input_fixture_digest
    updated.output_digest = output_digest
    updated.source_digest = executor.source_digest
    updated.artifact_digest = executor.artifact_digest
    updated.execution_proof_digest = if executor.use_binary:
        executor.artifact_digest
    else:
        executor.source_digest
    updated.kernel_invocations = operation_invocations
    updated.executor_identity = "cuda-device:" + executor.device_identity.to_text() +
        (if executor.use_binary: ":cubin:" else: ":ptx-jit:") +
        updated.execution_proof_digest + ":cache:" +
        executor.cache_identity.key_digest
    # Providers increment kernel_invocations only after successful device
    # readback, so this delta is the current operation's lifecycle receipt.
    updated.compiled = true
    updated.submitted = true
    updated.fence_completed = true
    updated.device_readback = true
    Ok(updated)

fn x25519_mlkem768_metal_operation_evidence(evidence: X25519MlKem768Evidence,
        executor: X25519MlKem768MetalNttExecutor,
        invocations_before: i64, input_fixture_digest: text,
        output_digest: text) -> Result<X25519MlKem768Evidence, text>:
    if invocations_before < 0 or executor.kernel_invocations < invocations_before:
        return Err("Metal full operation GPU invocation baseline invalid")
    val operation_invocations = executor.kernel_invocations - invocations_before
    if operation_invocations < 1:
        return Err("Metal full operation produced no GPU kernel execution receipt")
    if not executor.fence_completed:
        return Err("Metal full operation produced no completed device readback receipt")
    var updated = evidence
    updated.input_fixture_digest = input_fixture_digest
    updated.output_digest = output_digest
    updated.source_digest = executor.source_digest
    updated.artifact_digest = executor.artifact_digest
    updated.execution_proof_digest = if executor.use_binary:
        executor.artifact_digest
    else:
        executor.source_digest
    updated.kernel_invocations = operation_invocations
    updated.executor_identity = "metal-device:" + executor.session.device_name +
        (if executor.use_binary: ":metallib:" else: ":source-jit:") +
        updated.execution_proof_digest + ":cache:" +
        executor.cache_identity.key_digest
    updated.compiled = true
    updated.submitted = true
    updated.fence_completed = true
    updated.device_readback = true
    Ok(updated)

fn x25519_mlkem768_vulkan_operation_evidence(evidence: X25519MlKem768Evidence,
        executor: X25519MlKem768VulkanNttExecutor,
        invocations_before: i64, input_fixture_digest: text,
        output_digest: text) -> Result<X25519MlKem768Evidence, text>:
    if invocations_before < 0 or executor.kernel_invocations < invocations_before:
        return Err("Vulkan full operation GPU invocation baseline invalid")
    val operation_invocations = executor.kernel_invocations - invocations_before
    if operation_invocations < 1:
        return Err("Vulkan full operation produced no GPU kernel execution receipt")
    if not executor.fence_completed:
        return Err("Vulkan full operation produced no completed device readback receipt")
    var updated = evidence
    val artifact_set_digest = sha256_text(
        "forward=" + executor.forward_artifact_digest +
        ";inverse=" + executor.inverse_artifact_digest)
    updated.input_fixture_digest = input_fixture_digest
    updated.output_digest = output_digest
    updated.source_digest = ""
    updated.artifact_digest = artifact_set_digest
    updated.execution_proof_digest = artifact_set_digest
    updated.kernel_invocations = operation_invocations
    updated.executor_identity = "vulkan-device:" +
        executor.session.device_identity.to_text() +
        ":spirv-set:" + artifact_set_digest + ":cache:" +
        executor.cache_identity.key_digest
    updated.compiled = true
    updated.submitted = true
    updated.fence_completed = true
    updated.device_readback = true
    Ok(updated)

export x25519_mlkem768_verify_gpu_keygen
export x25519_mlkem768_verify_gpu_encapsulate
export x25519_mlkem768_verify_gpu_decapsulate
export x25519_mlkem768_cuda_operation_evidence
export x25519_mlkem768_metal_operation_evidence
export x25519_mlkem768_vulkan_operation_evidence
