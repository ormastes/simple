# Pure admission predicates shared by X25519MLKEM768 accelerator artifacts.

mod os.crypto.x25519_mlkem768.artifact_snapshot_admission

fn x25519_mlkem768_artifact_size_admitted(
        artifact_size: i64, maximum_size: i64) -> bool:
    artifact_size > 0 and artifact_size <= maximum_size

fn x25519_mlkem768_artifact_read_exact(
        size_admitted: bool, artifact_size: i64, read_size: i64) -> bool:
    size_admitted and artifact_size == read_size

export x25519_mlkem768_artifact_size_admitted
export x25519_mlkem768_artifact_read_exact
