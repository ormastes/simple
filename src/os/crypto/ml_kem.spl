# ML-KEM-768 — IND-CCA Wrapper (FIPS 203 Algorithms 16/17/18)
#
# Module-Lattice-Based Key-Encapsulation Mechanism Standard (NIST FIPS 203,
# August 2024). This file wires the K-PKE (`ml_kem_kpke.spl`) primitive into
# the Fujisaki-Okamoto transform that gives ML-KEM its IND-CCA2 security.
#
# Public API:
#   ml_kem_keygen(d: list, z: list) -> (ek, dk)
#       d, z are 32-byte random seeds. Caller is responsible for entropy.
#   ml_kem_encaps(ek: list, m: list) -> (K, c)
#       m is a 32-byte random plaintext. Returns shared secret K and
#       ciphertext c.
#   ml_kem_decaps(dk: list, c: list) -> K
#       Constant-time FO transform; on ciphertext mismatch returns the
#       implicit-rejection key J(z || c) instead of leaking the failure.
#
# ML-KEM-768 sizes:
#   ek = 1184 bytes, dk = 2400 bytes, c = 1088 bytes, K = 32 bytes.
#
# Reference: NIST FIPS 203 — Module-Lattice-Based Key-Encapsulation Mechanism
#            Standard, https://csrc.nist.gov/pubs/fips/203/final §7.

mod os.crypto.ml_kem

use os.crypto.ml_kem_kpke.{
    kpke_keygen, kpke_encrypt, kpke_decrypt,
    kpke_keygen_512, kpke_encrypt_512, kpke_decrypt_512,
    kpke_keygen_1024, kpke_encrypt_1024, kpke_decrypt_1024,
    kpke_keygen_params, kpke_encrypt_params, kpke_decrypt_params,
    kpke_keygen_params_simd, kpke_encrypt_params_simd,
    kpke_decrypt_params_simd,
    MlKemNttBatchProvider, kpke_keygen_params_provider,
    kpke_encrypt_params_provider, kpke_decrypt_params_provider,
    ml_kem_g, ml_kem_h, ml_kem_j}
use os.crypto.ml_kem_ntt.{
    ml_kem_k_512, ml_kem_eta1_512, ml_kem_eta2_512,
    ml_kem_du_512, ml_kem_dv_512,
    ml_kem_k_768, ml_kem_eta1_768, ml_kem_eta2_768,
    ml_kem_du_768, ml_kem_dv_768,
    ml_kem_k_1024, ml_kem_eta1_1024, ml_kem_eta2_1024,
    ml_kem_du_1024, ml_kem_dv_1024}

# ============================================================================
# Per-parameter sizes (FIPS 203 §8 Table 3)
# ============================================================================
#
# ML-KEM-512  : ek =  800, dk = 1632, ct =  768, ss = 32
# ML-KEM-768  : ek = 1184, dk = 2400, ct = 1088, ss = 32
# ML-KEM-1024 : ek = 1568, dk = 3168, ct = 1568, ss = 32
#
# In general:
#   ek = 384·k + 32
#   dk_pke = 384·k
#   dk = dk_pke + ek + 32 + 32  =  768·k + 96
#   ct = 32·du·k + 32·dv

fn ml_kem_512_ek_bytes() -> i64:
    800

fn ml_kem_512_dk_bytes() -> i64:
    1632

fn ml_kem_512_ct_bytes() -> i64:
    768

fn ml_kem_512_ss_bytes() -> i64:
    32

fn ml_kem_768_ek_bytes() -> i64:
    1184

fn ml_kem_768_dk_bytes() -> i64:
    2400

fn ml_kem_768_ct_bytes() -> i64:
    1088

fn ml_kem_768_ss_bytes() -> i64:
    32

fn ml_kem_1024_ek_bytes() -> i64:
    1568

fn ml_kem_1024_dk_bytes() -> i64:
    3168

fn ml_kem_1024_ct_bytes() -> i64:
    1568

fn ml_kem_1024_ss_bytes() -> i64:
    32

# ============================================================================
# Constant-time byte helpers
# ============================================================================
#
# `_ct_byte_eq(a, b)` returns 0xFF when a == b and 0x00 otherwise, computed
# without data-dependent branches. The full-byte mask form is used directly
# by `_ct_select_bytes`.
#
# This is the FO-transform constant-time selection per the precedent in
# ed25519/p256 (`feedback_no_coverups.md`). A naïve `if equal: K' else: J`
# would leak via timing.

fn _ct_byte_eq(a: i64, b: i64) -> i64:
    # x == 0 iff a == b. Convert to a full-byte mask using arithmetic only.
    val x = (a ^ b) & 0xFF
    # If x == 0 then x | -x == 0 → high bit 0 → ((x | -x) >> 7) == 0 → invert
    # to get 0xFF. If x != 0 then x | -x has high bit 1 → 0x01 after >>7
    # and 0xFF after subtract → invert to get 0x00.
    val nz = ((x | (0 - x)) >> 7) & 1   # 0 if equal, 1 if differ
    (1 - nz) * 0xFF                       # 0xFF if equal, 0x00 if differ

# Constant-time bytes equality across whole arrays. Returns 0xFF if equal,
# 0x00 otherwise. Always processes every byte regardless of mismatch position.
fn _ct_bytes_eq(a: list, b: list) -> i64:
    if a.len() != b.len():
        return 0  # Length mismatch is not part of the secret.
    var acc = 0xFF
    var i = 0
    while i < a.len():
        acc = acc & _ct_byte_eq(a.get(i), b.get(i))
        i = i + 1
    acc

# Select a or b byte-wise, controlled by `mask` (0xFF → a, 0x00 → b). The
# mask is applied identically at every byte position so the side-channel
# profile is independent of the chosen branch.
fn _ct_select_bytes(mask: i64, a: list, b: list) -> list:
    var out = []
    var i = 0
    val m = mask & 0xFF
    val nm = (~m) & 0xFF
    while i < a.len():
        out.push(((a.get(i) & m) | (b.get(i) & nm)) & 0xFF)
        i = i + 1
    out

# Best-effort cleanup for mutable, function-owned byte lists. The current GC
# may retain moved/copied backing storage, so this narrows exposure but is not a
# guaranteed secure-zero primitive. Callers retain ownership of input lists.
fn _ml_kem_wipe_owned(values: list):
    var i: i64 = 0
    while i < values.len():
        # Use the language's canonical mutable-list index operation.  The
        # method-style `set` spelling can bind to an unrelated co-compiled
        # array surface and fail before cleanup executes.
        values[i] = 0
        i = i + 1

# ============================================================================
# ML-KEM.KeyGen — FIPS 203 Algorithm 16
# ============================================================================
#
# (ekPKE, dkPKE) = K-PKE.KeyGen(d)
# ek = ekPKE
# dk = dkPKE || ek || H(ek) || z
#
# Inputs are 32-byte d and 32-byte z (independent random material). Per
# FIPS 203 the caller may also call ml_kem_keygen_internal(seed) which
# splits a 64-byte seed into (d, z); we keep them separate here so callers
# can plug their own RNG / KAT seed without re-allocating bytes.

# Parameterized keygen — shared by 512 / 768 / 1024 variants.
fn _ml_kem_keygen_params_mode(d: list, z: list, k_param: i64,
        eta1: i64, use_simd: bool) -> tuple:
    var ek_pke = []
    var dk_pke = []
    if use_simd:
        val (simd_ek_pke, simd_dk_pke) = kpke_keygen_params_simd(
            d, k_param, eta1)
        ek_pke = simd_ek_pke
        dk_pke = simd_dk_pke
    else:
        val (scalar_ek_pke, scalar_dk_pke) = kpke_keygen_params(
            d, k_param, eta1)
        ek_pke = scalar_ek_pke
        dk_pke = scalar_dk_pke

    # H(ek) — 32 bytes.
    val h_ek = ml_kem_h(ek_pke)

    # dk = dk_pke || ek || H(ek) || z
    var dk = []
    var i = 0
    while i < dk_pke.len():
        dk.push(dk_pke.get(i))
        i = i + 1
    var j = 0
    while j < ek_pke.len():
        dk.push(ek_pke.get(j))
        j = j + 1
    var ki = 0
    while ki < h_ek.len():
        dk.push(h_ek.get(ki))
        ki = ki + 1
    var l = 0
    while l < z.len():
        dk.push(z.get(l))
        l = l + 1

    _ml_kem_wipe_owned(dk_pke)
    (ek_pke, dk)

fn ml_kem_keygen_params(d: list, z: list, k_param: i64, eta1: i64) -> tuple:
    _ml_kem_keygen_params_mode(d, z, k_param, eta1, false)

fn ml_kem_keygen_params_simd(d: list, z: list, k_param: i64,
        eta1: i64) -> tuple:
    _ml_kem_keygen_params_mode(d, z, k_param, eta1, true)

# 768 entry point (preserved API).
fn ml_kem_keygen(d: list, z: list) -> tuple:
    ml_kem_keygen_params(d, z, ml_kem_k_768(), ml_kem_eta1_768())

fn ml_kem_keygen_simd(d: list, z: list) -> tuple:
    ml_kem_keygen_params_simd(d, z, ml_kem_k_768(), ml_kem_eta1_768())

# 512 / 1024 entry points.
fn ml_kem_keygen_512(d: list, z: list) -> tuple:
    ml_kem_keygen_params(d, z, ml_kem_k_512(), ml_kem_eta1_512())

fn ml_kem_keygen_1024(d: list, z: list) -> tuple:
    ml_kem_keygen_params(d, z, ml_kem_k_1024(), ml_kem_eta1_1024())

# ============================================================================
# ML-KEM.Encaps — FIPS 203 Algorithm 17
# ============================================================================
#
# Caller supplies a fresh 32-byte uniform m. Internally:
#   (K, r) = G(m || H(ek))
#   c = K-PKE.Encrypt(ek, m, r)
# Returns (K, c).
#
# Per FIPS 203 §7.2 the message m must be sampled from a uniform 32-byte
# distribution. KAT-driven test code can pin m for reproducibility; live
# callers pass random_bytes(32).

# Parameterized encaps — shared by 512 / 768 / 1024 variants.
fn _ml_kem_encaps_params_mode(ek: list, m: list,
        k_param: i64, eta1: i64, eta2: i64, du: i64, dv: i64,
        use_simd: bool) -> tuple:
    val h_ek = ml_kem_h(ek)
    var input = []
    var i = 0
    while i < m.len():
        input.push(m.get(i))
        i = i + 1
    var j = 0
    while j < h_ek.len():
        input.push(h_ek.get(j))
        j = j + 1
    val (k_shared, r) = ml_kem_g(input)
    var c = []
    if use_simd:
        c = kpke_encrypt_params_simd(ek, m, r, k_param, eta1, eta2, du, dv)
    else:
        c = kpke_encrypt_params(ek, m, r, k_param, eta1, eta2, du, dv)
    _ml_kem_wipe_owned(input)
    _ml_kem_wipe_owned(r)
    (k_shared, c)

fn ml_kem_encaps_params(ek: list, m: list,
        k_param: i64, eta1: i64, eta2: i64, du: i64, dv: i64) -> tuple:
    _ml_kem_encaps_params_mode(ek, m, k_param, eta1, eta2, du, dv, false)

fn ml_kem_encaps_params_simd(ek: list, m: list,
        k_param: i64, eta1: i64, eta2: i64, du: i64, dv: i64) -> tuple:
    _ml_kem_encaps_params_mode(ek, m, k_param, eta1, eta2, du, dv, true)

# 768 entry point (preserved API).
fn ml_kem_encaps(ek: list, m: list) -> tuple:
    ml_kem_encaps_params(ek, m,
        ml_kem_k_768(), ml_kem_eta1_768(), ml_kem_eta2_768(),
        ml_kem_du_768(), ml_kem_dv_768())

fn ml_kem_encaps_simd(ek: list, m: list) -> tuple:
    ml_kem_encaps_params_simd(ek, m,
        ml_kem_k_768(), ml_kem_eta1_768(), ml_kem_eta2_768(),
        ml_kem_du_768(), ml_kem_dv_768())

# 512 / 1024 entry points.
fn ml_kem_encaps_512(ek: list, m: list) -> tuple:
    ml_kem_encaps_params(ek, m,
        ml_kem_k_512(), ml_kem_eta1_512(), ml_kem_eta2_512(),
        ml_kem_du_512(), ml_kem_dv_512())

fn ml_kem_encaps_1024(ek: list, m: list) -> tuple:
    ml_kem_encaps_params(ek, m,
        ml_kem_k_1024(), ml_kem_eta1_1024(), ml_kem_eta2_1024(),
        ml_kem_du_1024(), ml_kem_dv_1024())

# ============================================================================
# ML-KEM.Decaps — FIPS 203 Algorithm 18
# ============================================================================
#
# Constant-time FO transform. Input dk = dk_pke || ek || H(ek) || z.
#
#   m'         = K-PKE.Decrypt(dk_pke, c)
#   (K', r')   = G(m' || H(ek))
#   K_implicit = J(z || c)
#   c'         = K-PKE.Encrypt(ek, m', r')
#   if c == c' return K' else return K_implicit
#
# The final `if c == c'` MUST be a constant-time selection: a branch leaks
# whether the ciphertext was forged. Per `feedback_no_coverups.md` and the
# ed25519/p256 CT precedent, we use _ct_bytes_eq + _ct_select_bytes.

# Parameterized decaps — shared by 512 / 768 / 1024 variants.
# Slices the encoded dk by k-derived offsets and dispatches to the matching
# K-PKE primitives.
fn _ml_kem_decaps_params_mode(dk: list, c: list,
        k_param: i64, eta1: i64, eta2: i64, du: i64, dv: i64,
        use_simd: bool) -> list:
    val dk_pke_bytes = 384 * k_param            # ByteEncode_12(ŝ) length
    val ek_bytes = 384 * k_param + 32           # ByteEncode_12(t̂) || rho
    # dk = [dk_pke || ek || H(ek) (32) || z (32)] = 768·k + 96.
    var dk_pke = []
    var i = 0
    while i < dk_pke_bytes:
        dk_pke.push(dk.get(i))
        i = i + 1
    var ek = []
    var j = 0
    while j < ek_bytes:
        ek.push(dk.get(dk_pke_bytes + j))
        j = j + 1
    var h_ek = []
    var ki = 0
    while ki < 32:
        h_ek.push(dk.get(dk_pke_bytes + ek_bytes + ki))
        ki = ki + 1
    var z = []
    var l = 0
    while l < 32:
        z.push(dk.get(dk_pke_bytes + ek_bytes + 32 + l))
        l = l + 1

    # m' = K-PKE.Decrypt(dk_pke, c)
    var m_prime = []
    if use_simd:
        m_prime = kpke_decrypt_params_simd(dk_pke, c, k_param, du, dv)
    else:
        m_prime = kpke_decrypt_params(dk_pke, c, k_param, du, dv)

    # (K', r') = G(m' || H(ek))
    var input = []
    var ii = 0
    while ii < m_prime.len():
        input.push(m_prime.get(ii))
        ii = ii + 1
    var jj = 0
    while jj < h_ek.len():
        input.push(h_ek.get(jj))
        jj = jj + 1
    val (k_prime, r_prime) = ml_kem_g(input)

    # K_implicit = J(z || c)
    var zc = []
    var aa = 0
    while aa < z.len():
        zc.push(z.get(aa))
        aa = aa + 1
    var bb = 0
    while bb < c.len():
        zc.push(c.get(bb))
        bb = bb + 1
    val k_implicit = ml_kem_j(zc)

    # c' = K-PKE.Encrypt(ek, m', r')
    var c_prime = []
    if use_simd:
        c_prime = kpke_encrypt_params_simd(ek, m_prime, r_prime,
            k_param, eta1, eta2, du, dv)
    else:
        c_prime = kpke_encrypt_params(ek, m_prime, r_prime,
            k_param, eta1, eta2, du, dv)

    # Constant-time select between K' and K_implicit by c ?= c'.
    val mask = _ct_bytes_eq(c, c_prime)
    val selected = _ct_select_bytes(mask, k_prime, k_implicit)
    _ml_kem_wipe_owned(dk_pke)
    _ml_kem_wipe_owned(z)
    _ml_kem_wipe_owned(m_prime)
    _ml_kem_wipe_owned(input)
    _ml_kem_wipe_owned(r_prime)
    _ml_kem_wipe_owned(zc)
    _ml_kem_wipe_owned(k_prime)
    _ml_kem_wipe_owned(k_implicit)
    selected

fn ml_kem_decaps_params(dk: list, c: list,
        k_param: i64, eta1: i64, eta2: i64, du: i64, dv: i64) -> list:
    _ml_kem_decaps_params_mode(dk, c, k_param, eta1, eta2, du, dv, false)

fn ml_kem_decaps_params_simd(dk: list, c: list,
        k_param: i64, eta1: i64, eta2: i64, du: i64, dv: i64) -> list:
    _ml_kem_decaps_params_mode(dk, c, k_param, eta1, eta2, du, dv, true)

# 768 entry point (preserved API).
fn ml_kem_decaps(dk: list, c: list) -> list:
    ml_kem_decaps_params(dk, c,
        ml_kem_k_768(), ml_kem_eta1_768(), ml_kem_eta2_768(),
        ml_kem_du_768(), ml_kem_dv_768())

fn ml_kem_decaps_simd(dk: list, c: list) -> list:
    ml_kem_decaps_params_simd(dk, c,
        ml_kem_k_768(), ml_kem_eta1_768(), ml_kem_eta2_768(),
        ml_kem_du_768(), ml_kem_dv_768())

# ML-KEM-768 candidate composition through a narrow batched NTT provider.
# All FO-transform, encoding, and constant-time selection remain CPU-owned.
fn ml_kem_keygen_provider(d: list, z: list,
        provider: MlKemNttBatchProvider) -> Result<tuple, text>:
    val kp = match kpke_keygen_params_provider(
            d, ml_kem_k_768(), ml_kem_eta1_768(), provider):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val (ek, dk_pke, _, _, _) = kp
    val h_ek = ml_kem_h(ek)
    var dk = []
    var i: i64 = 0
    while i < dk_pke.len():
        dk.push(dk_pke.get(i))
        i = i + 1
    i = 0
    while i < ek.len():
        dk.push(ek.get(i))
        i = i + 1
    i = 0
    while i < h_ek.len():
        dk.push(h_ek.get(i))
        i = i + 1
    i = 0
    while i < z.len():
        dk.push(z.get(i))
        i = i + 1
    _ml_kem_wipe_owned(dk_pke)
    Ok((ek, dk))

fn ml_kem_encaps_provider(ek: list, m: list,
        provider: MlKemNttBatchProvider) -> Result<tuple, text>:
    val h_ek = ml_kem_h(ek)
    var input = []
    var i: i64 = 0
    while i < m.len():
        input.push(m.get(i))
        i = i + 1
    i = 0
    while i < h_ek.len():
        input.push(h_ek.get(i))
        i = i + 1
    val (shared_secret, coins) = ml_kem_g(input)
    val ciphertext = match kpke_encrypt_params_provider(
            ek, m, coins, ml_kem_k_768(), ml_kem_eta1_768(),
            ml_kem_eta2_768(), ml_kem_du_768(), ml_kem_dv_768(), provider):
        case Ok(value): value
        case Err(reason):
            _ml_kem_wipe_owned(input)
            _ml_kem_wipe_owned(shared_secret)
            _ml_kem_wipe_owned(coins)
            return Err(reason)
    _ml_kem_wipe_owned(input)
    _ml_kem_wipe_owned(coins)
    Ok((shared_secret, ciphertext))

fn ml_kem_decaps_provider(dk: list, c: list,
        provider: MlKemNttBatchProvider) -> Result<list, text>:
    val dk_pke_bytes = 384 * ml_kem_k_768()
    val ek_bytes = 384 * ml_kem_k_768() + 32
    val dk_pke = _ml_kem_slice(dk, 0, dk_pke_bytes)
    val ek = _ml_kem_slice(dk, dk_pke_bytes, ek_bytes)
    val h_ek = _ml_kem_slice(dk, dk_pke_bytes + ek_bytes, 32)
    val z = _ml_kem_slice(dk, dk_pke_bytes + ek_bytes + 32, 32)
    val m_prime = match kpke_decrypt_params_provider(
            dk_pke, c, ml_kem_k_768(), ml_kem_du_768(),
            ml_kem_dv_768(), provider):
        case Ok(value): value
        case Err(reason):
            _ml_kem_wipe_owned(dk_pke)
            _ml_kem_wipe_owned(z)
            return Err(reason)
    var input = []
    var i: i64 = 0
    while i < m_prime.len():
        input.push(m_prime.get(i))
        i = i + 1
    i = 0
    while i < h_ek.len():
        input.push(h_ek.get(i))
        i = i + 1
    val (candidate_secret, coins) = ml_kem_g(input)
    var zc = []
    i = 0
    while i < z.len():
        zc.push(z.get(i))
        i = i + 1
    i = 0
    while i < c.len():
        zc.push(c.get(i))
        i = i + 1
    val implicit = ml_kem_j(zc)
    val c_prime = match kpke_encrypt_params_provider(
            ek, m_prime, coins, ml_kem_k_768(), ml_kem_eta1_768(),
            ml_kem_eta2_768(), ml_kem_du_768(), ml_kem_dv_768(), provider):
        case Ok(value): value
        case Err(reason):
            _ml_kem_wipe_owned(dk_pke)
            _ml_kem_wipe_owned(z)
            _ml_kem_wipe_owned(m_prime)
            _ml_kem_wipe_owned(input)
            _ml_kem_wipe_owned(coins)
            _ml_kem_wipe_owned(zc)
            _ml_kem_wipe_owned(candidate_secret)
            _ml_kem_wipe_owned(implicit)
            return Err(reason)
    val selected = _ct_select_bytes(
        _ct_bytes_eq(c, c_prime), candidate_secret, implicit)
    _ml_kem_wipe_owned(dk_pke)
    _ml_kem_wipe_owned(z)
    _ml_kem_wipe_owned(m_prime)
    _ml_kem_wipe_owned(input)
    _ml_kem_wipe_owned(coins)
    _ml_kem_wipe_owned(zc)
    _ml_kem_wipe_owned(candidate_secret)
    _ml_kem_wipe_owned(implicit)
    Ok(selected)

# 512 / 1024 entry points.
fn ml_kem_decaps_512(dk: list, c: list) -> list:
    ml_kem_decaps_params(dk, c,
        ml_kem_k_512(), ml_kem_eta1_512(), ml_kem_eta2_512(),
        ml_kem_du_512(), ml_kem_dv_512())

fn ml_kem_decaps_1024(dk: list, c: list) -> list:
    ml_kem_decaps_params(dk, c,
        ml_kem_k_1024(), ml_kem_eta1_1024(), ml_kem_eta2_1024(),
        ml_kem_du_1024(), ml_kem_dv_1024())

# ============================================================================
# Validated ML-KEM-768 boundary
# ============================================================================

fn _ml_kem_slice(values: list, start: i64, count: i64) -> list:
    var out = []
    var i: i64 = 0
    while i < count:
        out.push(values.get(start + i))
        i = i + 1
    out

fn _ml_kem_octets_valid(values: list) -> bool:
    # Scan the complete buffer. Generic `list` elements are signed integers,
    # so length alone does not prove that the value is a byte. Do not mask
    # hostile values into range: 256 must not alias 0 and -1 must not alias
    # 255 at a checked cryptographic boundary.
    var valid: bool = true
    var index: i64 = 0
    while index < values.len():
        val value: i64 = values[index]
        if value < 0 or value > 0xFF:
            valid = false
        index = index + 1
    valid

fn _ml_kem_768_encoded_poly_valid(values: list, offset: i64) -> i64:
    # FIPS 203 ByteDecode_12 reduces each 12-bit coefficient modulo q. Its
    # required re-encode equality is therefore equivalent to requiring every
    # packed coefficient to be below q. Decode the two coefficients in each
    # three-byte group directly through typed index reads. This avoids the
    # native dynamic `list.get` result, whose tagged word must not enter
    # arithmetic or an apparently explicit `.to_i64()` conversion.
    var valid: i64 = 0xFF
    var pair: i64 = 0
    while pair < 128:
        val byte_offset = offset + pair * 3
        # The caller has recorded any non-octet input as invalid. Normalize
        # before shifts so a hostile, oversized list element cannot overflow
        # the coefficient arithmetic while the full scan finishes.
        val b0 = values[byte_offset] & 0xFF
        val b1 = values[byte_offset + 1] & 0xFF
        val b2 = values[byte_offset + 2] & 0xFF
        val coefficient0 = b0 | ((b1 & 0x0F) << 8)
        val coefficient1 = (b1 >> 4) | (b2 << 4)
        val reduced0 = coefficient0 % 3329
        val reduced1 = coefficient1 % 3329
        valid = valid & _ct_byte_eq(b0, reduced0 & 0xFF)
        valid = valid & _ct_byte_eq(
            b1, ((reduced0 >> 8) | ((reduced1 & 0x0F) << 4)) & 0xFF)
        valid = valid & _ct_byte_eq(b2, (reduced1 >> 4) & 0xFF)
        pair = pair + 1
    valid

fn ml_kem_768_encapsulation_key_valid(ek: list) -> bool:
    if ek.len() != ml_kem_768_ek_bytes():
        return false
    # `list` is not element-typed. Reject non-octet integer values before the
    # low-byte equality helper can make (for example) 256 look equal to 0.
    # Scan the complete key because rho is unrestricted as an octet string,
    # not unrestricted as an arbitrary list of integers.
    var valid: i64 = if _ml_kem_octets_valid(ek): 0xFF else: 0
    # The first 1152 bytes are k=3 canonically packed 12-bit polynomials. The
    # remaining 32-byte rho seed accepts every octet value.
    var poly: i64 = 0
    while poly < 3:
        valid = valid & _ml_kem_768_encoded_poly_valid(ek, poly * 384)
        poly = poly + 1
    valid == 0xFF

fn ml_kem_768_decapsulation_key_valid(dk: list) -> bool:
    if dk.len() != ml_kem_768_dk_bytes():
        return false
    if not _ml_kem_octets_valid(dk):
        return false
    val embedded_ek = _ml_kem_slice(dk, 1152, 1184)
    if not ml_kem_768_encapsulation_key_valid(embedded_ek):
        return false
    val stored_hash = _ml_kem_slice(dk, 2336, 32)
    _ct_bytes_eq(stored_hash, ml_kem_h(embedded_ek)) == 0xFF

fn ml_kem_keygen_checked(d: list, z: list) -> Result<tuple, text>:
    if d.len() != 32 or z.len() != 32 or
            not _ml_kem_octets_valid(d) or not _ml_kem_octets_valid(z):
        return Err("ML-KEM-768 key generation seeds must be 32 bytes")
    val pair = ml_kem_keygen(d, z)
    val (ek, dk) = pair
    if ek.len() != ml_kem_768_ek_bytes() or
            dk.len() != ml_kem_768_dk_bytes():
        return Err("ML-KEM-768 key generation returned invalid sizes")
    if not ml_kem_768_encapsulation_key_valid(ek):
        return Err("ML-KEM-768 key generation returned an invalid encapsulation key")
    if not ml_kem_768_decapsulation_key_valid(dk):
        return Err("ML-KEM-768 key generation returned an invalid decapsulation key")
    Ok(pair)

fn ml_kem_encaps_checked(ek: list, m: list) -> Result<tuple, text>:
    if m.len() != 32 or not _ml_kem_octets_valid(m):
        return Err("ML-KEM-768 encapsulation message must be 32 bytes")
    if not ml_kem_768_encapsulation_key_valid(ek):
        return Err("ML-KEM-768 encapsulation key is invalid")
    val result = ml_kem_encaps(ek, m)
    val (shared, ciphertext) = result
    if shared.len() != 32 or ciphertext.len() != 1088 or
            not _ml_kem_octets_valid(shared) or
            not _ml_kem_octets_valid(ciphertext):
        return Err("ML-KEM-768 encapsulation returned invalid sizes")
    Ok(result)

fn ml_kem_decaps_checked(dk: list, c: list) -> Result<list, text>:
    if c.len() != ml_kem_768_ct_bytes() or not _ml_kem_octets_valid(c):
        return Err("ML-KEM-768 ciphertext must be 1088 bytes")
    if not ml_kem_768_decapsulation_key_valid(dk):
        return Err("ML-KEM-768 decapsulation key is invalid")
    val shared = ml_kem_decaps(dk, c)
    if shared.len() != ml_kem_768_ss_bytes() or
            not _ml_kem_octets_valid(shared):
        return Err("ML-KEM-768 decapsulation returned an invalid shared secret")
    Ok(shared)

fn ml_kem_keygen_checked_simd(d: list, z: list) -> Result<tuple, text>:
    if d.len() != 32 or z.len() != 32 or
            not _ml_kem_octets_valid(d) or not _ml_kem_octets_valid(z):
        return Err("ML-KEM-768 SIMD key generation seeds must be 32 bytes")
    val pair = ml_kem_keygen_simd(d, z)
    val (ek, dk) = pair
    if ek.len() != ml_kem_768_ek_bytes() or
            dk.len() != ml_kem_768_dk_bytes():
        return Err("ML-KEM-768 SIMD key generation returned invalid sizes")
    if not ml_kem_768_encapsulation_key_valid(ek):
        return Err("ML-KEM-768 SIMD key generation returned an invalid encapsulation key")
    if not ml_kem_768_decapsulation_key_valid(dk):
        return Err("ML-KEM-768 SIMD key generation returned an invalid decapsulation key")
    Ok(pair)

fn ml_kem_encaps_checked_simd(ek: list, m: list) -> Result<tuple, text>:
    if m.len() != 32 or not _ml_kem_octets_valid(m):
        return Err("ML-KEM-768 SIMD encapsulation message must be 32 bytes")
    if not ml_kem_768_encapsulation_key_valid(ek):
        return Err("ML-KEM-768 SIMD encapsulation key is invalid")
    val result = ml_kem_encaps_simd(ek, m)
    val (shared, ciphertext) = result
    if shared.len() != 32 or ciphertext.len() != 1088 or
            not _ml_kem_octets_valid(shared) or
            not _ml_kem_octets_valid(ciphertext):
        return Err("ML-KEM-768 SIMD encapsulation returned invalid sizes")
    Ok(result)

fn ml_kem_decaps_checked_simd(dk: list, c: list) -> Result<list, text>:
    if c.len() != ml_kem_768_ct_bytes() or not _ml_kem_octets_valid(c):
        return Err("ML-KEM-768 SIMD ciphertext must be 1088 bytes")
    if not ml_kem_768_decapsulation_key_valid(dk):
        return Err("ML-KEM-768 SIMD decapsulation key is invalid")
    val shared = ml_kem_decaps_simd(dk, c)
    if shared.len() != ml_kem_768_ss_bytes() or
            not _ml_kem_octets_valid(shared):
        return Err("ML-KEM-768 SIMD decapsulation returned an invalid shared secret")
    Ok(shared)

fn ml_kem_keygen_checked_provider(d: list, z: list,
        provider: MlKemNttBatchProvider) -> Result<tuple, text>:
    if d.len() != 32 or z.len() != 32 or
            not _ml_kem_octets_valid(d) or not _ml_kem_octets_valid(z):
        return Err("ML-KEM-768 provider key generation seeds must be 32 bytes")
    val pair = match ml_kem_keygen_provider(d, z, provider):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val (ek, dk) = pair
    if ek.len() != ml_kem_768_ek_bytes() or
            dk.len() != ml_kem_768_dk_bytes():
        return Err("ML-KEM-768 provider key generation returned invalid sizes")
    if not ml_kem_768_encapsulation_key_valid(ek):
        return Err("ML-KEM-768 provider key generation returned an invalid encapsulation key")
    if not ml_kem_768_decapsulation_key_valid(dk):
        return Err("ML-KEM-768 provider key generation returned an invalid decapsulation key")
    Ok(pair)

fn ml_kem_encaps_checked_provider(ek: list, m: list,
        provider: MlKemNttBatchProvider) -> Result<tuple, text>:
    if m.len() != 32 or not _ml_kem_octets_valid(m):
        return Err("ML-KEM-768 provider encapsulation message must be 32 bytes")
    if not ml_kem_768_encapsulation_key_valid(ek):
        return Err("ML-KEM-768 provider encapsulation key is invalid")
    val result = match ml_kem_encaps_provider(ek, m, provider):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val (shared, ciphertext) = result
    if shared.len() != 32 or ciphertext.len() != 1088 or
            not _ml_kem_octets_valid(shared) or
            not _ml_kem_octets_valid(ciphertext):
        return Err("ML-KEM-768 provider encapsulation returned invalid sizes")
    Ok(result)

fn ml_kem_decaps_checked_provider(dk: list, c: list,
        provider: MlKemNttBatchProvider) -> Result<list, text>:
    if c.len() != ml_kem_768_ct_bytes() or not _ml_kem_octets_valid(c):
        return Err("ML-KEM-768 provider ciphertext must be 1088 bytes")
    if not ml_kem_768_decapsulation_key_valid(dk):
        return Err("ML-KEM-768 provider decapsulation key is invalid")
    val shared = match ml_kem_decaps_provider(dk, c, provider):
        case Ok(value): value
        case Err(reason): return Err(reason)
    if shared.len() != ml_kem_768_ss_bytes() or
            not _ml_kem_octets_valid(shared):
        return Err("ML-KEM-768 provider decapsulation returned invalid shared secret")
    Ok(shared)

