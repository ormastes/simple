# RSA Signing and Verification — Hosted Simple Wrappers
#
# Thin wrappers over the rt_rsa_* SFFI externs declared in
# src/lib/nogc_sync_mut/io/signature_sffi.spl.
#
# Key format:
#   - Signing:      PKCS#8 v1 DER-encoded RSA private key
#   - Verification: SubjectPublicKeyInfo (SPKI) DER-encoded RSA public key
#
# Padding: PKCS#1 v1.5.
# Deterministic: same key + message always produces the same signature.
# Hosted-only: requires SystemRandom available in the runtime.
#
# Reference: RFC 8332 (RSA Key with SHA-256/SHA-512 for SSH)
# Reference: RFC 3447 (PKCS#1 v2.2, RSASSA-PKCS1-v1_5)

use os.crypto.rsa_fallback.{rsa_sha256_sign_fallback, rsa_sha512_sign_fallback}
use os.crypto.dual_backend.{DualBackendConfig, dual_backend_default_config, dual_backend_run_bytes}
use std.nogc_sync_mut.io.signature_sffi.{rsa_sha256_sign_checked, rsa_sha512_sign_checked, rsa_sha256_verify_checked, rsa_sha512_verify_checked}

enum RsaSignBackend:
    Auto
    HostedReference
    PureSimple

# ============================================================================
# Helper
# ============================================================================

fn rsa_sig_valid(sig: [u8]) -> bool:
    """Return true iff `sig` is non-empty (i.e. no error during signing).

    Use this to check the result of rsa_sha256_sign / rsa_sha512_sign before
    transmitting the signature.
    """
    sig.len() > 0

fn _rsa_sha256_sign_hosted(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    rsa_sha256_sign_checked(pkcs8, message)

fn _rsa_sha512_sign_hosted(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    rsa_sha512_sign_checked(pkcs8, message)

fn _rsa_sha512_sign_pure_simple_auto(pkcs8: [u8], message: [u8]) -> [u8]:
    rsa_sha512_sign_fallback(pkcs8, message)

fn _rsa_checked_fallback(sig: [u8], algorithm: text) -> Result<[u8], text>:
    if sig.len() == 0:
        return Err(algorithm + " Pure Simple signing failed")
    Ok(sig)

fn _rsa_result_or_empty(result: Result<[u8], text>) -> [u8]:
    match result:
        case Ok(sig): sig
        case Err(_): []

# ============================================================================
# SHA-256 variant
# ============================================================================

fn rsa_sha256_sign(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    """Sign `message` with RSA-PKCS1-SHA256 (RFC 8332 rsa-sha2-256).

    Args:
        pkcs8:   PKCS#8 v1 DER-encoded RSA private key.
        message: Arbitrary byte sequence to sign.

    Returns:
        Signature bytes (modulus-sized), or a typed provider/key error.

    Hosted-only: requires SystemRandom in the runtime.
    Deterministic: identical key + message always yields the same signature.
    PKCS#1 v1.5 padding is applied internally.
    """
    rsa_sha256_sign_with_config(pkcs8, message, dual_backend_default_config())

fn rsa_sha256_sign_with_config(pkcs8: [u8], message: [u8], config: DualBackendConfig) -> Result<[u8], text>:
    val sig = dual_backend_run_bytes(
        "rsa",
        "sha256_sign",
        config,
        [
            "pkcs8_len=" + pkcs8.len().to_text(),
            "msg_len=" + message.len().to_text()
        ],
        fn(): _rsa_result_or_empty(_rsa_sha256_sign_hosted(pkcs8, message)),
        fn(): rsa_sha256_sign_fallback(pkcs8, message)
    )
    _rsa_checked_fallback(sig, "RSA SHA-256")

fn rsa_sha256_sign_with_backend(pkcs8: [u8], message: [u8], backend: RsaSignBackend) -> Result<[u8], text>:
    """Sign with an explicitly selected RSA backend.

    Backends:
      Auto              — hosted runtime first, then pure-Simple fallback
      HostedReference   — hosted runtime only
      PureSimple        — pure-Simple fallback only
    """
    if backend == RsaSignBackend.HostedReference:
        return _rsa_sha256_sign_hosted(pkcs8, message)
    if backend == RsaSignBackend.PureSimple:
        return _rsa_checked_fallback(rsa_sha256_sign_fallback(pkcs8, message), "RSA SHA-256")

    match _rsa_sha256_sign_hosted(pkcs8, message):
        case Ok(sig): Ok(sig)
        case Err(_): _rsa_checked_fallback(rsa_sha256_sign_fallback(pkcs8, message), "RSA SHA-256")

fn rsa_sha256_verify(spki_der: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    """Verify an RSA-PKCS1-SHA256 signature (RFC 8332 rsa-sha2-256).

    Args:
        spki_der:  DER-encoded RSA public key (SubjectPublicKeyInfo / SPKI).
        message:   Message bytes that were signed.
        signature: Raw PKCS#1 v1.5 signature bytes.

    Returns: Ok(true) if valid, Ok(false) for mismatch, or Err for malformed input/provider failure.
    """
    rsa_sha256_verify_checked(spki_der, message, signature)

# ============================================================================
# SHA-512 variant
# ============================================================================

fn rsa_sha512_sign(pkcs8: [u8], message: [u8]) -> Result<[u8], text>:
    """Sign `message` with RSA-PKCS1-SHA512 (RFC 8332 rsa-sha2-512).

    Args:
        pkcs8:   PKCS#8 v1 DER-encoded RSA private key.
        message: Arbitrary byte sequence to sign.

    Returns:
        Signature bytes (modulus-sized), or a typed provider/key error.

    Hosted-only: requires SystemRandom in the runtime.
    Deterministic: identical key + message always yields the same signature.
    PKCS#1 v1.5 padding with SHA-512 digest is applied internally.
    """
    rsa_sha512_sign_with_config(pkcs8, message, dual_backend_default_config())

fn rsa_sha512_sign_with_config(pkcs8: [u8], message: [u8], config: DualBackendConfig) -> Result<[u8], text>:
    val sig = dual_backend_run_bytes(
        "rsa",
        "sha512_sign",
        config,
        [
            "pkcs8_len=" + pkcs8.len().to_text(),
            "msg_len=" + message.len().to_text()
        ],
        fn(): _rsa_result_or_empty(_rsa_sha512_sign_hosted(pkcs8, message)),
        fn(): _rsa_sha512_sign_pure_simple_auto(pkcs8, message)
    )
    _rsa_checked_fallback(sig, "RSA SHA-512")

fn rsa_sha512_sign_with_backend(pkcs8: [u8], message: [u8], backend: RsaSignBackend) -> Result<[u8], text>:
    """Sign with an explicitly selected RSA backend.

    Backends:
      Auto              — hosted runtime first, then embedded-host/pure-Simple fallback
      HostedReference   — hosted runtime only
      PureSimple        — pure-Simple fallback only
    """
    if backend == RsaSignBackend.HostedReference:
        return _rsa_sha512_sign_hosted(pkcs8, message)
    if backend == RsaSignBackend.PureSimple:
        return _rsa_checked_fallback(_rsa_sha512_sign_pure_simple_auto(pkcs8, message), "RSA SHA-512")

    match _rsa_sha512_sign_hosted(pkcs8, message):
        case Ok(sig): Ok(sig)
        case Err(_): _rsa_checked_fallback(_rsa_sha512_sign_pure_simple_auto(pkcs8, message), "RSA SHA-512")

fn rsa_sha512_verify(spki_der: [u8], message: [u8], signature: [u8]) -> Result<bool, text>:
    """Verify an RSA-PKCS1-SHA512 signature (RFC 8332 rsa-sha2-512).

    Args:
        spki_der:  DER-encoded RSA public key (SubjectPublicKeyInfo / SPKI).
        message:   Message bytes that were signed.
        signature: Raw PKCS#1 v1.5 signature bytes.

    Returns: Ok(true) if valid, Ok(false) for mismatch, or Err for malformed input/provider failure.
    """
    rsa_sha512_verify_checked(spki_der, message, signature)
