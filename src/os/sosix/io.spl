# SOSIX async I/O owner.
#
# SOSIX is the native async-by-default OS surface. POSIX async_io keeps its
# historical exported names as compatibility wrappers over this module.

use os.kernel.errno.{EBADF, EIO}
use os.kernel.fd_table.{fd_is_valid, fd_get_offset, fd_set_offset, fd_get_backend_handle, fd_types, FD_TYPE_FILE, FD_TYPE_SERIAL}
use os.userlib.syscall_raw.{syscall}
use os.userlib.fs.{vfs_ipc_request_bytes}
use os.userlib.ipc_protocol.{VFS_READ, VFS_WRITE, VFS_SEEK}

extern fn rt_port_inb(port: u16) -> u8
extern fn mmio_write8(addr: u64, value: u8)
extern fn mmio_read8(addr: u64) -> u8

val SOSIX_ASYNC_FREE: u8 = 0
val SOSIX_ASYNC_PENDING: u8 = 1
val SOSIX_ASYNC_COMPLETE: u8 = 2
val SOSIX_ASYNC_ERROR: u8 = 3

val SOSIX_IO_BACKEND_INVALID: u8 = 0
val SOSIX_IO_BACKEND_SERIAL: u8 = 1
val SOSIX_IO_BACKEND_VFS: u8 = 2

val SOSIX_MAX_ASYNC_REQUESTS: u64 = 128

val _SOSIX_VFS_READ_MAX: u64 = 4092
val _SOSIX_VFS_WRITE_MAX: u64 = 4088

var sosix_req_states: [u8; 128] = [0; 128]
var sosix_req_fds: [i32; 128] = [0; 128]
var sosix_req_methods: [u32; 128] = [0; 128]
var sosix_req_results: [i64; 128] = [0; 128]
var sosix_req_notifications: [u64; 128] = [0; 128]

fn sosix_io_backend_for_fd_type(fd_type: u8) -> u8:
    """Return the native SOSIX async backend for an FD type."""
    if fd_type == FD_TYPE_SERIAL:
        return SOSIX_IO_BACKEND_SERIAL
    if fd_type == FD_TYPE_FILE:
        return SOSIX_IO_BACKEND_VFS
    SOSIX_IO_BACKEND_INVALID

fn sosix_io_init():
    """Initialize SOSIX async I/O request state."""
    var i: u64 = 0
    while i < SOSIX_MAX_ASYNC_REQUESTS:
        sosix_req_states[i] = SOSIX_ASYNC_FREE
        sosix_req_fds[i] = -1
        sosix_req_methods[i] = 0
        sosix_req_results[i] = 0
        sosix_req_notifications[i] = 0
        i = i + 1

fn sosix_async_alloc_request() -> u64:
    """Allocate a SOSIX async request slot."""
    var i: u64 = 0
    while i < SOSIX_MAX_ASYNC_REQUESTS:
        if sosix_req_states[i] == SOSIX_ASYNC_FREE:
            sosix_req_states[i] = SOSIX_ASYNC_PENDING
            return i
        i = i + 1
    SOSIX_MAX_ASYNC_REQUESTS

fn sosix_async_free_request(req_id: u64):
    """Free a SOSIX async request slot."""
    if req_id < SOSIX_MAX_ASYNC_REQUESTS:
        sosix_req_states[req_id] = SOSIX_ASYNC_FREE

fn sosix_async_is_complete(req_id: u64) -> bool:
    """Check whether a SOSIX async request is complete."""
    if req_id >= SOSIX_MAX_ASYNC_REQUESTS:
        return true
    sosix_req_states[req_id] == SOSIX_ASYNC_COMPLETE or sosix_req_states[req_id] == SOSIX_ASYNC_ERROR

fn sosix_async_get_result(req_id: u64) -> i64:
    """Return a completed SOSIX async request result."""
    if req_id >= SOSIX_MAX_ASYNC_REQUESTS:
        return 0 - EIO as i64
    sosix_req_results[req_id]

fn sosix_async_read(fd: i32, buf_addr: u64, count: u64) -> u64:
    """Start a SOSIX async read and return its request ID."""
    if not fd_is_valid(fd):
        return SOSIX_MAX_ASYNC_REQUESTS
    val idx: u64 = fd as u64

    # A valid zero-length operation succeeds without probing a serial device
    # or requiring a live remote VFS handle.
    if count == 0:
        val req = sosix_async_alloc_request()
        if req < SOSIX_MAX_ASYNC_REQUESTS:
            sosix_req_fds[req] = fd
            sosix_req_methods[req] = VFS_READ
            sosix_req_states[req] = SOSIX_ASYNC_COMPLETE
            sosix_req_results[req] = 0
        return req

    if fd_types[idx] == FD_TYPE_SERIAL:
        val req = sosix_async_alloc_request()
        if req < SOSIX_MAX_ASYNC_REQUESTS:
            sosix_req_fds[req] = fd
            sosix_req_methods[req] = VFS_READ
            val byte = rt_port_inb(0x3F8)
            mmio_write8(buf_addr, byte)
            sosix_req_states[req] = SOSIX_ASYNC_COMPLETE
            sosix_req_results[req] = 1
        return req

    if sosix_io_backend_for_fd_type(fd_types[idx]) != SOSIX_IO_BACKEND_VFS:
        return SOSIX_MAX_ASYNC_REQUESTS

    val req = sosix_async_alloc_request()
    if req < SOSIX_MAX_ASYNC_REQUESTS:
        sosix_req_fds[req] = fd
        sosix_req_methods[req] = VFS_READ

        val vfs_handle = fd_get_backend_handle(fd)
        var seek_payload: [u8] = []
        _sosix_async_push_u64(seek_payload, vfs_handle)
        _sosix_async_push_u64(seek_payload, fd_get_offset(fd))
        seek_payload.push(0u8)
        match vfs_ipc_request_bytes(VFS_SEEK, seek_payload):
            Result.Err(_error):
                sosix_req_states[req] = SOSIX_ASYNC_ERROR
                sosix_req_results[req] = 0 - EIO as i64
            Result.Ok(seek_reply):
                if seek_reply.len() != 8u64:
                    sosix_req_states[req] = SOSIX_ASYNC_ERROR
                    sosix_req_results[req] = 0 - EIO as i64
                else:
                    fd_set_offset(fd, _sosix_async_read_u64(seek_reply, 0))
                    var total: u64 = 0
                    var failed = false
                    var eof = false
                    while total < count and not failed and not eof:
                        var chunk = count - total
                        if chunk > _SOSIX_VFS_READ_MAX:
                            chunk = _SOSIX_VFS_READ_MAX
                        var payload: [u8] = []
                        _sosix_async_push_u64(payload, vfs_handle)
                        _sosix_async_push_u64(payload, chunk)
                        match vfs_ipc_request_bytes(VFS_READ, payload):
                            Result.Err(_error): failed = true
                            Result.Ok(reply):
                                val actual = reply.len().to_u64()
                                if actual > chunk:
                                    failed = true
                                else:
                                    var ci: u64 = 0
                                    while ci < actual:
                                        mmio_write8(buf_addr + total + ci, reply[ci])
                                        ci = ci + 1
                                    fd_set_offset(fd, fd_get_offset(fd) + actual)
                                    total = total + actual
                                    if actual < chunk:
                                        eof = true
                    if failed and total == 0:
                        sosix_req_states[req] = SOSIX_ASYNC_ERROR
                        sosix_req_results[req] = 0 - EIO as i64
                    else:
                        sosix_req_states[req] = SOSIX_ASYNC_COMPLETE
                        sosix_req_results[req] = total as i64
    req

fn sosix_async_write(fd: i32, buf_addr: u64, count: u64) -> u64:
    """Start a SOSIX async write and return its request ID."""
    if not fd_is_valid(fd):
        return SOSIX_MAX_ASYNC_REQUESTS
    val idx: u64 = fd as u64

    # A valid zero-length operation succeeds without touching the selected
    # backend or changing the shared open-file-description offset.
    if count == 0:
        val req = sosix_async_alloc_request()
        if req < SOSIX_MAX_ASYNC_REQUESTS:
            sosix_req_fds[req] = fd
            sosix_req_methods[req] = VFS_WRITE
            sosix_req_states[req] = SOSIX_ASYNC_COMPLETE
            sosix_req_results[req] = 0
        return req

    if fd_types[idx] == FD_TYPE_SERIAL:
        val req = sosix_async_alloc_request()
        if req < SOSIX_MAX_ASYNC_REQUESTS:
            sosix_req_fds[req] = fd
            sosix_req_methods[req] = VFS_WRITE
            sosix_req_states[req] = SOSIX_ASYNC_COMPLETE
            sosix_req_results[req] = count as i64
        return req

    if sosix_io_backend_for_fd_type(fd_types[idx]) != SOSIX_IO_BACKEND_VFS:
        return SOSIX_MAX_ASYNC_REQUESTS

    val req = sosix_async_alloc_request()
    if req < SOSIX_MAX_ASYNC_REQUESTS:
        sosix_req_fds[req] = fd
        sosix_req_methods[req] = VFS_WRITE

        val vfs_handle = fd_get_backend_handle(fd)
        var seek_payload: [u8] = []
        _sosix_async_push_u64(seek_payload, vfs_handle)
        _sosix_async_push_u64(seek_payload, fd_get_offset(fd))
        seek_payload.push(0u8)
        match vfs_ipc_request_bytes(VFS_SEEK, seek_payload):
            Result.Err(_error):
                sosix_req_states[req] = SOSIX_ASYNC_ERROR
                sosix_req_results[req] = 0 - EIO as i64
            Result.Ok(seek_reply):
                if seek_reply.len() != 8u64:
                    sosix_req_states[req] = SOSIX_ASYNC_ERROR
                    sosix_req_results[req] = 0 - EIO as i64
                else:
                    fd_set_offset(fd, _sosix_async_read_u64(seek_reply, 0))
                    var total: u64 = 0
                    var failed = false
                    var short_write = false
                    while total < count and not failed and not short_write:
                        var chunk = count - total
                        if chunk > _SOSIX_VFS_WRITE_MAX:
                            chunk = _SOSIX_VFS_WRITE_MAX
                        var payload: [u8] = []
                        _sosix_async_push_u64(payload, vfs_handle)
                        var ci: u64 = 0
                        while ci < chunk:
                            payload.push(mmio_read8(buf_addr + total + ci))
                            ci = ci + 1
                        match vfs_ipc_request_bytes(VFS_WRITE, payload):
                            Result.Err(_error): failed = true
                            Result.Ok(reply):
                                if reply.len() != 8u64:
                                    failed = true
                                else:
                                    val actual = _sosix_async_read_u64(reply, 0)
                                    if actual > chunk:
                                        failed = true
                                    else:
                                        fd_set_offset(fd, fd_get_offset(fd) + actual)
                                        total = total + actual
                                        if actual < chunk:
                                            short_write = true
                    if failed and total == 0:
                        sosix_req_states[req] = SOSIX_ASYNC_ERROR
                        sosix_req_results[req] = 0 - EIO as i64
                    else:
                        sosix_req_states[req] = SOSIX_ASYNC_COMPLETE
                        sosix_req_results[req] = total as i64
    req

fn sosix_sync_read(fd: i32, buf_addr: u64, count: u64) -> i64:
    """Blocking compatibility read over the native SOSIX async request."""
    val req = sosix_async_read(fd, buf_addr: buf_addr, count: count)
    if req >= SOSIX_MAX_ASYNC_REQUESTS:
        return 0 - EBADF as i64
    while not sosix_async_is_complete(req):
        if sosix_req_notifications[req] != 0:
            syscall(26, sosix_req_notifications[req], 0, 0, 0, 0)
        # Intentional spin fallback when no completion notification exists.
        pass_dn
    val result = sosix_async_get_result(req)
    sosix_async_free_request(req)
    result

fn sosix_sync_write(fd: i32, buf_addr: u64, count: u64) -> i64:
    """Blocking compatibility write over the native SOSIX async request."""
    val req = sosix_async_write(fd, buf_addr: buf_addr, count: count)
    if req >= SOSIX_MAX_ASYNC_REQUESTS:
        return 0 - EBADF as i64
    while not sosix_async_is_complete(req):
        if sosix_req_notifications[req] != 0:
            syscall(26, sosix_req_notifications[req], 0, 0, 0, 0)
        # Intentional spin fallback when no completion notification exists.
        pass_dn
    val result = sosix_async_get_result(req)
    sosix_async_free_request(req)
    result

fn _sosix_async_push_u64(buf: [u8], val_: u64):
    """Push a u64 in little-endian byte order."""
    var i: u64 = 0
    while i < 8:
        buf.push(((val_ >> (i * 8)) & 0xFF) as u8)
        i = i + 1

fn _sosix_async_read_u64(buf: [u8], offset: u64) -> u64:
    """Read a little-endian u64 from a byte buffer."""
    var value: u64 = 0
    var i: u64 = 0
    while i < 8:
        value = value | ((buf[offset + i] as u64) << (i * 8))
        i = i + 1
    value
