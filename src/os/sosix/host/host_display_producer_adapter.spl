"""Pure X11/Wayland display snapshot ingress for SOSIX renderer hosts.

The platform event loop acquires these facts.  This adapter only validates and
freezes them; Draw IR construction and Engine2D execution remain with their
canonical owners.
"""

pub const SOSIX_HOST_DISPLAY_X11: u8 = 1
pub const SOSIX_HOST_DISPLAY_WAYLAND: u8 = 2

pub struct SosixHostDisplaySnapshot:
    backend: u8
    surface_token: u64
    width: u32
    height: u32
    scale_milli: u32

pub struct SosixHostDisplaySnapshotResult:
    accepted: bool
    reason: text
    snapshot: SosixHostDisplaySnapshot

export SOSIX_HOST_DISPLAY_X11, SOSIX_HOST_DISPLAY_WAYLAND
export SosixHostDisplaySnapshot, SosixHostDisplaySnapshotResult

pub fn sosix_host_display_snapshot_produce(
    backend: u8, surface_token: u64, width: i64, height: i64, scale_milli: i64
) -> SosixHostDisplaySnapshotResult:
    val empty = SosixHostDisplaySnapshot(
        backend: backend, surface_token: surface_token,
        width: 0, height: 0, scale_milli: 0)
    if backend != SOSIX_HOST_DISPLAY_X11 and backend != SOSIX_HOST_DISPLAY_WAYLAND:
        return SosixHostDisplaySnapshotResult(
            accepted: false, reason: "unsupported-display-backend", snapshot: empty)
    if surface_token == 0:
        return SosixHostDisplaySnapshotResult(
            accepted: false, reason: "invalid-display-surface", snapshot: empty)
    if width <= 0 or height <= 0:
        return SosixHostDisplaySnapshotResult(
            accepted: false, reason: "invalid-display-extent", snapshot: empty)
    if scale_milli <= 0:
        return SosixHostDisplaySnapshotResult(
            accepted: false, reason: "invalid-display-scale", snapshot: empty)
    SosixHostDisplaySnapshotResult(
        accepted: true,
        reason: "accepted",
        snapshot: SosixHostDisplaySnapshot(
            backend: backend,
            surface_token: surface_token,
            width: width as u32,
            height: height as u32,
            scale_milli: scale_milli as u32
        )
    )

export sosix_host_display_snapshot_produce
