"""Hosted configuration ingress for SOSIX WM and renderer services.

Only this host adapter reads process environment. Portable compositor code
consumes the immutable ``SosixHostConfigurationSnapshot`` capability value.
"""

use os.sosix.host.service_contract.{
    SosixHostConfigurationSnapshot,
    sosix_host_configuration_snapshot_create_with_engine2d_transfer
}

extern fn rt_env_get(key: text) -> text?

pub fn sosix_host_configuration_from_environment() -> SosixHostConfigurationSnapshot:
    val gpu_backend = (rt_env_get("SIMPLE_GUI_BACKEND") ?? "").trim()
    sosix_host_configuration_snapshot_create_with_engine2d_transfer(
        "hosted",
        "host-event-queue",
        gpu_backend,
        false,
        "",
        rt_env_get("SIMPLE_ONE_CALL_UPLOAD") ?? "",
        rt_env_get("SIMPLE_BULK_UPLOAD") ?? "",
        rt_env_get("SIMPLE_SPL_GPU_TRANSFER_PATH") ?? "",
        rt_env_get("SIMPLE_ONE_CALL_READBACK") ?? ""
    )

export sosix_host_configuration_from_environment
