"""SOSIX host-interface seam for host system singles.

Canonical .spl entry point for host CPU count: callers under os.sosix go
through this adapter instead of calling std.sffi.system directly. The raw
probe itself lives in the C runtime (rt_cpu_count; sysctl on FreeBSD,
sysconf elsewhere) — .spl code never re-implements platform dispatch.
"""

use std.sffi.system.{cpu_count}

pub struct SosixHostSystemSnapshot:
    # -1 is the raw probe's failure sentinel (see std.sffi.system.cpu_count).
    cpu_count: i64
    ready: bool

export SosixHostSystemSnapshot

pub fn sosix_host_system_snapshot() -> SosixHostSystemSnapshot:
    val count = cpu_count()
    SosixHostSystemSnapshot(
        cpu_count: count,
        ready: count > 0
    )

export sosix_host_system_snapshot
