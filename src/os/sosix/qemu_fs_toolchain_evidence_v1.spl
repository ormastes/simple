"""Architecture-neutral serial protocol for live filesystem toolchain proof.

Architecture boot entries call these formatters only after the named bytes were
read from their mounted VFS and the corresponding operation completed.  The
host validator binds every operation into one nonce-scoped transaction.
"""

pub fn sosix_fs_toolchain_begin_v1(host: text, arch: text, nonce: text) -> text:
    "SOSIX_FS_TOOLCHAIN_BEGIN schema=1 host={host} arch={arch} nonce={nonce}"

pub fn sosix_fs_compiler_version_v1(path: text, version: text, nonce: text) -> text:
    "SOSIX_FS_COMPILER_VERSION path={path} version={version} nonce={nonce}"

pub fn sosix_fs_source_read_v1(role: text, path: text, sha256: text) -> text:
    "SOSIX_FS_SOURCE_READ role={role} path={path} sha256={sha256}"

pub fn sosix_fs_interpreter_hello_v1(nonce: text, source_sha256: text, stdout: text, stdout_sha256: text) -> text:
    "SOSIX_FS_INTERPRETER_HELLO nonce={nonce} source_sha256={source_sha256} stdout={stdout} stdout_sha256={stdout_sha256}"

pub fn sosix_fs_compiler_output_v1(path: text, source_sha256: text, sha256: text) -> text:
    "SOSIX_FS_COMPILER_OUTPUT path={path} source_sha256={source_sha256} sha256={sha256}"

pub fn sosix_fs_exec_read_v1(path: text, sha256: text) -> text:
    "SOSIX_FS_EXEC_READ role=loader path={path} sha256={sha256}"

pub fn sosix_fs_loader_hello_v1(nonce: text, executable_sha256: text, stdout: text, stdout_sha256: text) -> text:
    "SOSIX_FS_LOADER_HELLO nonce={nonce} executable_sha256={executable_sha256} stdout={stdout} stdout_sha256={stdout_sha256}"

pub fn sosix_fs_compiled_hello_v1(nonce: text, executable_sha256: text, stdout: text, stdout_sha256: text) -> text:
    "SOSIX_FS_COMPILED_HELLO nonce={nonce} executable_sha256={executable_sha256} stdout={stdout} stdout_sha256={stdout_sha256}"

pub fn sosix_fs_toolchain_end_v1(
    host: text, arch: text, nonce: text, source_sha256: text, executable_sha256: text
) -> text:
    "SOSIX_FS_TOOLCHAIN_END host={host} arch={arch} nonce={nonce} source_sha256={source_sha256} executable_sha256={executable_sha256} status=pass"

export sosix_fs_toolchain_begin_v1, sosix_fs_compiler_version_v1
export sosix_fs_source_read_v1, sosix_fs_interpreter_hello_v1
export sosix_fs_compiler_output_v1, sosix_fs_exec_read_v1
export sosix_fs_loader_hello_v1, sosix_fs_compiled_hello_v1
export sosix_fs_toolchain_end_v1
