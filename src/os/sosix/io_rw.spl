"""SOSIX legacy fd-level read/write route (kernel `fd_io` -> `async_io_rw` -> here).

Unified 2026-09-05 (design §2, plan G2 unit level): the serial branch emits
bytes through the COM1 owner instead of reporting a fabricated count; an
invalid descriptor is `-EBADF` (-9) while request-slot exhaustion is
`-EAGAIN` (-11, `error_v1.SOSIX_STATUS_QUEUE_FULL`) so callers can tell them
apart; and the synchronous wrappers no longer spin. Every request completes
inline (the VFS chunk loop runs before the request id is returned), so a
not-yet-complete request is a contract violation reported as -11, never a busy
wait. Routing this onto the v1 positioned stack (`positioned_syscall_v1`) is
plan task G3.
"""

# TODO: (sosix G3) retire this route onto the v1 positioned stack once the QEMU
# serial row (AC-3b) is green; that row needs a pure-Simple compiler accepted by
# simple_binary_is_valid, and the tracked stage binaries are the wrong architecture
# for this host. Owner and resume: doc/08_tracking/todo/sosix_unification_blocked_rows_2026-09-05.md

use os.kernel.fd_table.{fd_is_valid, fd_get_offset, fd_set_offset, fd_get_type, fd_get_backend_handle}
use os.userlib.fs.{vfs_ipc_request_bytes}
use os.userlib.ipc_protocol.{VFS_READ, VFS_WRITE, VFS_SEEK}
use os.sosix.io_state.{
    sosix_io_backend_for_fd_type
}
use os.kernel.arch.x86.com1_common.{x86_com1_write_byte, x86_com1_read_byte}

extern fn mmio_write8(addr: u64, value: u8)
extern fn mmio_read8(addr: u64) -> u8
val _SOSIX_STATUS_BAD_DESCRIPTOR: i64 = -9
val _SOSIX_STATUS_QUEUE_FULL: i64 = -11
val _SOSIX_ASYNC_FREE: u8 = 0
val _SOSIX_ASYNC_PENDING: u8 = 1
val _SOSIX_ASYNC_COMPLETE: u8 = 2
val _SOSIX_ASYNC_ERROR: u8 = 3
val _SOSIX_MAX_ASYNC_REQUESTS: u64 = 128

val _SOSIX_VFS_READ_MAX: u64 = 4092
val _SOSIX_VFS_WRITE_MAX: u64 = 4088

var _sosix_rw_req_states: [u8; 128] = [0; 128]
var _sosix_rw_req_results: [i64; 128] = [0; 128]

fn sosix_async_read(fd: i32, buf_addr: u64, count: u64) -> u64:
    """Start a SOSIX async read and return its request ID."""
    if not fd_is_valid(fd):
        return _SOSIX_MAX_ASYNC_REQUESTS
    val fd_type = fd_get_type(fd)

    # POSIX-compatible zero-length I/O is complete without touching a serial
    # device or requiring a remote VFS handle.
    if count == 0:
        val req = _sosix_rw_alloc_request()
        if req < _SOSIX_MAX_ASYNC_REQUESTS:
            _sosix_rw_finish_request(req, _SOSIX_ASYNC_COMPLETE, 0)
        return req

    if fd_type == 6:
        val req = _sosix_rw_alloc_request()
        if req < _SOSIX_MAX_ASYNC_REQUESTS:
            val byte = x86_com1_read_byte()
            mmio_write8(buf_addr, byte)
            _sosix_rw_finish_request(req, _SOSIX_ASYNC_COMPLETE, 1)
        return req

    if sosix_io_backend_for_fd_type(fd_type) != 2:
        return _SOSIX_MAX_ASYNC_REQUESTS

    val req = _sosix_rw_alloc_request()
    if req < _SOSIX_MAX_ASYNC_REQUESTS:
        val vfs_handle = fd_get_backend_handle(fd)
        var seek_payload: [u8] = []
        _sosix_async_push_u64(seek_payload, vfs_handle)
        _sosix_async_push_u64(seek_payload, fd_get_offset(fd))
        seek_payload.push(0u8)
        match vfs_ipc_request_bytes(VFS_SEEK, seek_payload):
            Result.Err(_error): _sosix_rw_finish_request(req, _SOSIX_ASYNC_ERROR, -5)
            Result.Ok(seek_reply):
                if seek_reply.len() != 8u64:
                    _sosix_rw_finish_request(req, _SOSIX_ASYNC_ERROR, -5)
                else:
                    fd_set_offset(fd, _sosix_async_read_u64(seek_reply, 0))
                    var total: u64 = 0
                    var failed = false
                    var eof = false
                    while total < count and not failed and not eof:
                        var chunk = count - total
                        if chunk > _SOSIX_VFS_READ_MAX:
                            chunk = _SOSIX_VFS_READ_MAX
                        var payload: [u8] = []
                        _sosix_async_push_u64(payload, vfs_handle)
                        _sosix_async_push_u64(payload, chunk)
                        match vfs_ipc_request_bytes(VFS_READ, payload):
                            Result.Err(_error): failed = true
                            Result.Ok(reply):
                                val actual = reply.len().to_u64()
                                if actual > chunk:
                                    failed = true
                                else:
                                    var ci: u64 = 0
                                    while ci < actual:
                                        mmio_write8(buf_addr + total + ci, reply[ci])
                                        ci = ci + 1
                                    fd_set_offset(fd, fd_get_offset(fd) + actual)
                                    total = total + actual
                                    if actual < chunk:
                                        eof = true
                    if failed and total == 0:
                        _sosix_rw_finish_request(req, _SOSIX_ASYNC_ERROR, -5)
                    else:
                        _sosix_rw_finish_request(req, _SOSIX_ASYNC_COMPLETE, total as i64)
    req

fn sosix_async_write(fd: i32, buf_addr: u64, count: u64) -> u64:
    """Start a SOSIX async write and return its request ID."""
    if not fd_is_valid(fd):
        return _SOSIX_MAX_ASYNC_REQUESTS
    val fd_type = fd_get_type(fd)

    # POSIX-compatible zero-length I/O is complete without touching the
    # selected backend or changing the shared offset.
    if count == 0:
        val req = _sosix_rw_alloc_request()
        if req < _SOSIX_MAX_ASYNC_REQUESTS:
            _sosix_rw_finish_request(req, _SOSIX_ASYNC_COMPLETE, 0)
        return req

    if fd_type == 6:
        val req = _sosix_rw_alloc_request()
        if req < _SOSIX_MAX_ASYNC_REQUESTS:
            var emitted: u64 = 0
            while emitted < count:
                x86_com1_write_byte(mmio_read8(buf_addr + emitted))
                emitted = emitted + 1
            _sosix_rw_finish_request(req, _SOSIX_ASYNC_COMPLETE, emitted as i64)
        return req

    if sosix_io_backend_for_fd_type(fd_type) != 2:
        return _SOSIX_MAX_ASYNC_REQUESTS

    val req = _sosix_rw_alloc_request()
    if req < _SOSIX_MAX_ASYNC_REQUESTS:
        val vfs_handle = fd_get_backend_handle(fd)
        var seek_payload: [u8] = []
        _sosix_async_push_u64(seek_payload, vfs_handle)
        _sosix_async_push_u64(seek_payload, fd_get_offset(fd))
        seek_payload.push(0u8)
        match vfs_ipc_request_bytes(VFS_SEEK, seek_payload):
            Result.Err(_error): _sosix_rw_finish_request(req, _SOSIX_ASYNC_ERROR, -5)
            Result.Ok(seek_reply):
                if seek_reply.len() != 8u64:
                    _sosix_rw_finish_request(req, _SOSIX_ASYNC_ERROR, -5)
                else:
                    fd_set_offset(fd, _sosix_async_read_u64(seek_reply, 0))
                    var total: u64 = 0
                    var failed = false
                    var short_write = false
                    while total < count and not failed and not short_write:
                        var chunk = count - total
                        if chunk > _SOSIX_VFS_WRITE_MAX:
                            chunk = _SOSIX_VFS_WRITE_MAX
                        var payload: [u8] = []
                        _sosix_async_push_u64(payload, vfs_handle)
                        var ci: u64 = 0
                        while ci < chunk:
                            payload.push(mmio_read8(buf_addr + total + ci))
                            ci = ci + 1
                        match vfs_ipc_request_bytes(VFS_WRITE, payload):
                            Result.Err(_error): failed = true
                            Result.Ok(reply):
                                if reply.len() != 8u64:
                                    failed = true
                                else:
                                    val actual = _sosix_async_read_u64(reply, 0)
                                    if actual > chunk:
                                        failed = true
                                    else:
                                        fd_set_offset(fd, fd_get_offset(fd) + actual)
                                        total = total + actual
                                        if actual < chunk:
                                            short_write = true
                    if failed and total == 0:
                        _sosix_rw_finish_request(req, _SOSIX_ASYNC_ERROR, -5)
                    else:
                        _sosix_rw_finish_request(req, _SOSIX_ASYNC_COMPLETE, total as i64)
    req

fn sosix_sync_read(fd: i32, buf_addr: u64, count: u64) -> i64:
    """Synchronous compatibility read: same inline request, no busy wait."""
    if not fd_is_valid(fd):
        return _SOSIX_STATUS_BAD_DESCRIPTOR
    val req = sosix_async_read(fd, buf_addr: buf_addr, count: count)
    if req >= _SOSIX_MAX_ASYNC_REQUESTS:
        return _SOSIX_STATUS_QUEUE_FULL
    if not _sosix_rw_is_complete(req):
        _sosix_rw_free_request(req)
        return _SOSIX_STATUS_QUEUE_FULL
    val result = _sosix_rw_get_result(req)
    _sosix_rw_free_request(req)
    result

fn sosix_sync_write(fd: i32, buf_addr: u64, count: u64) -> i64:
    """Synchronous compatibility write: same inline request, no busy wait."""
    if not fd_is_valid(fd):
        return _SOSIX_STATUS_BAD_DESCRIPTOR
    val req = sosix_async_write(fd, buf_addr: buf_addr, count: count)
    if req >= _SOSIX_MAX_ASYNC_REQUESTS:
        return _SOSIX_STATUS_QUEUE_FULL
    if not _sosix_rw_is_complete(req):
        _sosix_rw_free_request(req)
        return _SOSIX_STATUS_QUEUE_FULL
    val result = _sosix_rw_get_result(req)
    _sosix_rw_free_request(req)
    result

fn _sosix_rw_alloc_request() -> u64:
    """Allocate a local SOSIX compatibility request slot."""
    var i: u64 = 0
    while i < _SOSIX_MAX_ASYNC_REQUESTS:
        if _sosix_rw_req_states[i] == _SOSIX_ASYNC_FREE:
            _sosix_rw_req_states[i] = _SOSIX_ASYNC_PENDING
            _sosix_rw_req_results[i] = 0
            return i
        i = i + 1
    _SOSIX_MAX_ASYNC_REQUESTS

fn _sosix_rw_finish_request(req: u64, state: u8, result: i64):
    """Record completion for a local SOSIX compatibility request."""
    if req < _SOSIX_MAX_ASYNC_REQUESTS:
        _sosix_rw_req_states[req] = state
        _sosix_rw_req_results[req] = result

fn _sosix_rw_free_request(req: u64):
    """Release a local SOSIX compatibility request slot."""
    if req < _SOSIX_MAX_ASYNC_REQUESTS:
        _sosix_rw_req_states[req] = _SOSIX_ASYNC_FREE
        _sosix_rw_req_results[req] = 0

fn _sosix_rw_is_complete(req: u64) -> bool:
    """Check whether a local SOSIX compatibility request is complete."""
    if req >= _SOSIX_MAX_ASYNC_REQUESTS:
        return true
    _sosix_rw_req_states[req] == _SOSIX_ASYNC_COMPLETE or _sosix_rw_req_states[req] == _SOSIX_ASYNC_ERROR

fn _sosix_rw_get_result(req: u64) -> i64:
    """Return the result stored for a local SOSIX compatibility request."""
    if req >= _SOSIX_MAX_ASYNC_REQUESTS:
        return -5
    _sosix_rw_req_results[req]

fn _sosix_async_push_u64(buf: [u8], val_: u64):
    """Push a u64 in little-endian byte order."""
    var i: u64 = 0
    while i < 8:
        buf.push(((val_ >> (i * 8)) & 0xFF) as u8)
        i = i + 1

fn _sosix_async_read_u64(buf: [u8], offset: u64) -> u64:
    """Read a little-endian u64 from a byte buffer."""
    var value: u64 = 0
    var i: u64 = 0
    while i < 8:
        value = value | ((buf[offset + i] as u64) << (i * 8))
        i = i + 1
    value

export sosix_async_read, sosix_async_write, sosix_sync_read, sosix_sync_write
