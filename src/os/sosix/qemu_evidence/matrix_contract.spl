"""Pure fail-closed aggregation for the SOSIX 4-host by 6-guest QEMU matrix."""

pub val SOSIX_QEMU_ROW_PASS: text = "pass"
pub val SOSIX_QEMU_ROW_FAILED: text = "failed"
pub val SOSIX_QEMU_ROW_BLOCKED: text = "blocked"
pub val SOSIX_QEMU_ROW_UNSUPPORTED: text = "unsupported"

# The native bundle producer has one closed artifact set.  These values are
# deliberately part of the typed contract: a digest-shaped string is not
# evidence until it selects the retained artifact with the canonical path.
pub val SOSIX_QEMU_NATIVE_ARTIFACT_COUNT: u32 = 9
pub val SOSIX_QEMU_COMPILER_NATIVE_ARTIFACT_COUNT: u32 = 13
pub val SOSIX_QEMU_ADMISSION_SCALAR_FIELD_COUNT: u32 = 41
pub val SOSIX_QEMU_ADMISSION_MAX_BYTES: i64 = 32768
pub val SOSIX_QEMU_ADMISSION_MAX_LINE_BYTES: i64 = 8192
pub val SOSIX_QEMU_COMPILER_POLICY_SHA256: text = "3c6e3731e238304e28ad182690ee5b3cca67715c8ee40484f6ed15d9e7f624e9"

pub struct SosixQemuCollectorArtifact:
    path: text
    sha256: text

pub struct SosixQemuCollectorRowReceipt:
    manifest_version: u32
    host: text
    guest: text
    status: text
    reason: text
    resume_command: text
    owner: text
    reviewer: text
    evidence_path: text
    evidence_sha256: text
    artifact_count: u32
    artifacts: [SosixQemuCollectorArtifact]
    source_identity: text
    compiler_identity: text
    compiler_identity_scope: text
    compiler_policy_sha256: text
    compiler_policy_value: text
    compiler_payload_identity: text
    compiler_image_identity: text
    compiler_alias_identity: text
    compiler_manifest_identity: text
    kernel_identity: text
    image_identity: text
    qemu_identity: text
    qemu_argv: text
    accelerator_identity: text
    transcript_identity: text
    program_identity: text
    firmware_identity: text
    firmware_mode: text
    firmware_path: text
    firmware_version: text
    firmware_sha256: text
    firmware_stage_markers: text
    boot_correlation_marker: text
    run_nonce: text
    compiler_in_filesystem: bool
    compiler_designation_scope: text
    compiler_version_evidence_path: text
    compiler_hello_evidence_path: text
    compiler_alias_evidence_path: text
    compiler_manifest_evidence_path: text

pub struct SosixQemuParsedBundleAdmission:
    receipt: SosixQemuCollectorRowReceipt
    structurally_valid: bool
    reason: text

pub struct SosixQemuMatrixRow:
    host: text
    guest: text
    compiler_in_filesystem: bool
    status: text
    reason: text
    evidence_path: text
    admission_record: text
    collector_manifest_evidence_sha256: text
    resume_command: text
    owner: text
    reviewer: text
    compiler_version_evidence_path: text
    compiler_hello_evidence_path: text

pub struct SosixQemuMatrixRowValidation:
    accepted: bool
    reason: text

pub struct SosixQemuMatrixResult:
    status: text
    reason: text
    row_count: u32
    pass_count: u32
    blocked_count: u32
    failed_count: u32

export SOSIX_QEMU_ROW_PASS, SOSIX_QEMU_ROW_FAILED
export SOSIX_QEMU_ROW_BLOCKED, SOSIX_QEMU_ROW_UNSUPPORTED
export SosixQemuMatrixRow, SosixQemuMatrixRowValidation, SosixQemuMatrixResult
export SosixQemuCollectorArtifact, SosixQemuCollectorRowReceipt
export SosixQemuParsedBundleAdmission
export SOSIX_QEMU_NATIVE_ARTIFACT_COUNT, SOSIX_QEMU_COMPILER_NATIVE_ARTIFACT_COUNT
export SOSIX_QEMU_ADMISSION_SCALAR_FIELD_COUNT, SOSIX_QEMU_COMPILER_POLICY_SHA256
export SOSIX_QEMU_ADMISSION_MAX_BYTES, SOSIX_QEMU_ADMISSION_MAX_LINE_BYTES

fn _sosix_qemu_lower_hex(value: text) -> bool:
    if value.len() == 0:
        return false
    for character in value:
        if not ((character >= '0' and character <= '9') or (character >= 'a' and character <= 'f')):
            return false
    true

fn _sosix_qemu_sha256_identity(value: text) -> bool:
    value.starts_with("sha256:") and value.len() == 71 and _sosix_qemu_lower_hex(value.slice(7, value.len()))

fn _sosix_qemu_artifact_hash(value: text) -> bool:
    value.len() == 64 and _sosix_qemu_lower_hex(value)

fn _sosix_qemu_safe_identity_component(value: text, minimum: i64) -> bool:
    if value.len() < minimum or value.len() > 128:
        return false
    for character in value:
        if not ((character >= '0' and character <= '9') or
            (character >= 'A' and character <= 'Z') or
            (character >= 'a' and character <= 'z') or
            character == '.' or character == '_' or character == '-' or character == ':'):
            return false
    true

fn _sosix_qemu_source_identity_valid(value: text) -> bool:
    val parts = value.split(":")
    if parts.len() != 5 or parts[0] != "git" or parts[2] != "tree" or parts[4] != "clean":
        return false
    val commit_valid = (parts[1].len() == 40 or parts[1].len() == 64) and _sosix_qemu_lower_hex(parts[1])
    val tree_valid = (parts[3].len() == 40 or parts[3].len() == 64) and _sosix_qemu_lower_hex(parts[3])
    commit_valid and tree_valid

fn _sosix_qemu_qemu_identity_valid(value: text) -> bool:
    val parts = value.split(":version:")
    parts.len() == 2 and _sosix_qemu_sha256_identity(parts[0]) and parts[1].len() > 0

fn _sosix_qemu_accelerator_identity_valid(value: text) -> bool:
    value == "tcg" or value == "kvm" or value == "hvf" or value == "whpx"

fn _sosix_qemu_source_compiler_identity_valid(value: text) -> bool:
    value.len() > 0 and value.len() <= 256 and not value.starts_with("target-native-simple:")

fn _sosix_qemu_expected_artifact_path(index: u32, compiler_in_filesystem: bool) -> text:
    if index == 1: return "host-admission.env"
    if index == 2: return "qemu.argv"
    if index == 3: return "qemu.version"
    if index == 4: return "transcript.log"
    if index == 5: return "kernel.elf"
    if index == 6: return "guest.img"
    if index == 7: return "program.elf"
    if index == 8: return "firmware.bin"
    if index == 9: return "required-markers.txt"
    if compiler_in_filesystem:
        if index == 10: return "compiler-version.txt"
        if index == 11: return "compiler-hello.txt"
        if index == 12: return "compiler-aliases.txt"
        if index == 13: return "compiler-manifest.env"
    ""

fn _sosix_qemu_artifact_set_canonical(receipt: SosixQemuCollectorRowReceipt) -> bool:
    var index: u32 = 1
    for artifact in receipt.artifacts:
        if artifact.path != _sosix_qemu_expected_artifact_path(index, receipt.compiler_in_filesystem):
            return false
        index = index + 1
    true

fn _sosix_qemu_artifact_identity(receipt: SosixQemuCollectorRowReceipt, path: text, identity: text) -> bool:
    if not _sosix_qemu_sha256_identity(identity):
        return false
    var matches: u32 = 0
    for artifact in receipt.artifacts:
        if artifact.path == path and ("sha256:" + artifact.sha256) == identity:
            matches = matches + 1
    matches == 1

fn _sosix_qemu_artifact_path_unique(receipt: SosixQemuCollectorRowReceipt) -> bool:
    for artifact in receipt.artifacts:
        if artifact.path.len() == 0 or not _sosix_qemu_artifact_hash(artifact.sha256):
            return false
        var matches: u32 = 0
        for candidate in receipt.artifacts:
            if candidate.path == artifact.path:
                matches = matches + 1
        if matches != 1:
            return false
    true

fn _sosix_qemu_firmware_mode_valid(value: text) -> bool:
    value == "uefi-pflash" or value == "opensbi-bios" or value == "board-rom"

fn _sosix_qemu_firmware_stage_markers_valid(mode: text, value: text) -> bool:
    if mode == "uefi-pflash":
        return value == "firmware-entry>firmware-handoff>guest-entry"
    if mode == "opensbi-bios":
        return value == "opensbi-entry>opensbi-handoff>guest-entry"
    if mode == "board-rom":
        return value == "rom-entry>rom-handoff>guest-entry"
    false

fn _sosix_qemu_absolute_firmware_path(value: text) -> bool:
    if value.starts_with("/") and value.len() > 1:
        return true
    value.len() > 3 and value.slice(1, 3) == ":\\"

fn _sosix_qemu_firmware_receipt_valid(receipt: SosixQemuCollectorRowReceipt) -> bool:
    receipt.firmware_identity.starts_with("firmware:") and receipt.firmware_identity.len() > 9 and
        _sosix_qemu_firmware_mode_valid(receipt.firmware_mode) and
        _sosix_qemu_absolute_firmware_path(receipt.firmware_path) and
        receipt.firmware_version.starts_with("version:") and receipt.firmware_version.len() > 8 and
        _sosix_qemu_sha256_identity(receipt.firmware_sha256) and
        _sosix_qemu_firmware_stage_markers_valid(receipt.firmware_mode, receipt.firmware_stage_markers)

fn _sosix_qemu_collector_receipt_valid(receipt: SosixQemuCollectorRowReceipt) -> bool:
    if receipt.manifest_version != 1 or receipt.status != SOSIX_QEMU_ROW_PASS:
        return false
    if not _sosix_qemu_known_host(receipt.host) or not _sosix_qemu_known_guest(receipt.guest):
        return false
    if receipt.reason != "" or receipt.resume_command != "":
        return false
    if receipt.owner.len() == 0 or receipt.reviewer.len() == 0:
        return false
    if receipt.evidence_path != "rows/" + receipt.host + "/" + receipt.guest + "/evidence.env":
        return false
    val expected_artifact_count = if receipt.compiler_in_filesystem:
        SOSIX_QEMU_COMPILER_NATIVE_ARTIFACT_COUNT
    else:
        SOSIX_QEMU_NATIVE_ARTIFACT_COUNT
    if receipt.artifact_count != expected_artifact_count:
        return false
    if receipt.artifacts.len() as u32 != receipt.artifact_count:
        return false
    if not _sosix_qemu_artifact_path_unique(receipt):
        return false
    if not _sosix_qemu_artifact_set_canonical(receipt):
        return false
    if receipt.evidence_sha256.len() != 64 or not _sosix_qemu_lower_hex(receipt.evidence_sha256):
        return false
    if not _sosix_qemu_source_identity_valid(receipt.source_identity):
        return false
    if not _sosix_qemu_safe_identity_component(receipt.boot_correlation_marker, 8) or
        not _sosix_qemu_safe_identity_component(receipt.run_nonce, 16) or
        receipt.boot_correlation_marker == receipt.run_nonce:
        return false
    if not _sosix_qemu_qemu_identity_valid(receipt.qemu_identity) or receipt.qemu_argv.len() == 0 or
        not _sosix_qemu_accelerator_identity_valid(receipt.accelerator_identity):
        return false
    if receipt.compiler_policy_sha256 != SOSIX_QEMU_COMPILER_POLICY_SHA256:
        return false
    # Policy v1 deliberately contains twenty-four false cells. A future
    # promotion changes both the policy digest and this closed typed owner.
    if receipt.compiler_policy_value != "false" or receipt.compiler_in_filesystem:
        return false
    if not _sosix_qemu_firmware_receipt_valid(receipt):
        return false
    if not _sosix_qemu_artifact_identity(receipt, "kernel.elf", receipt.kernel_identity):
        return false
    if not _sosix_qemu_artifact_identity(receipt, "guest.img", receipt.image_identity):
        return false
    if not _sosix_qemu_artifact_identity(receipt, "transcript.log", receipt.transcript_identity):
        return false
    if not _sosix_qemu_artifact_identity(receipt, "program.elf", receipt.program_identity):
        return false
    if not _sosix_qemu_artifact_identity(receipt, "firmware.bin", receipt.firmware_sha256):
        return false
    if not receipt.compiler_in_filesystem:
        return receipt.compiler_designation_scope == "live-policy" and
            receipt.compiler_identity_scope == "source-toolchain" and
            _sosix_qemu_source_compiler_identity_valid(receipt.compiler_identity) and
            receipt.compiler_payload_identity == "" and
            receipt.compiler_image_identity == "" and
            receipt.compiler_alias_identity == "" and
            receipt.compiler_manifest_identity == "" and
            receipt.compiler_version_evidence_path == "" and
            receipt.compiler_hello_evidence_path == "" and
            receipt.compiler_alias_evidence_path == "" and
            receipt.compiler_manifest_evidence_path == ""
    if receipt.compiler_designation_scope != "live-policy" or
        receipt.compiler_identity_scope != "target-filesystem":
        return false
    if receipt.compiler_version_evidence_path != "compiler-version.txt" or
        receipt.compiler_hello_evidence_path != "compiler-hello.txt" or
        receipt.compiler_alias_evidence_path != "compiler-aliases.txt" or
        receipt.compiler_manifest_evidence_path != "compiler-manifest.env":
        return false
    if not _sosix_qemu_artifact_identity(receipt, "compiler-version.txt", "sha256:" + _sosix_qemu_artifact_hash_for(receipt, "compiler-version.txt")):
        return false
    if not _sosix_qemu_artifact_identity(receipt, "compiler-hello.txt", "sha256:" + _sosix_qemu_artifact_hash_for(receipt, "compiler-hello.txt")):
        return false
    if not _sosix_qemu_artifact_identity(receipt, "compiler-aliases.txt", receipt.compiler_alias_identity):
        return false
    if not _sosix_qemu_artifact_identity(receipt, "compiler-manifest.env", receipt.compiler_manifest_identity):
        return false
    receipt.compiler_image_identity == receipt.image_identity and
        _sosix_qemu_sha256_identity(receipt.compiler_payload_identity) and
        receipt.compiler_identity == "target-native-simple:payload=" + receipt.compiler_payload_identity +
            ":image=" + receipt.compiler_image_identity + ":alias=" + receipt.compiler_alias_identity +
            ":manifest=" + receipt.compiler_manifest_identity

fn _sosix_qemu_artifact_hash_for(receipt: SosixQemuCollectorRowReceipt, path: text) -> text:
    for artifact in receipt.artifacts:
        if artifact.path == path:
            return artifact.sha256
    ""

fn _sosix_qemu_bundle_admission_from_collector_receipt(
    receipt: SosixQemuCollectorRowReceipt
) -> SosixQemuParsedBundleAdmission:
    val accepted = _sosix_qemu_collector_receipt_valid(receipt)
    SosixQemuParsedBundleAdmission(
        receipt: receipt,
        structurally_valid: accepted,
        reason: if accepted: "collector-record-structurally-valid" else: "collector-record-rejected"
    )

fn _sosix_qemu_blank_collector_receipt() -> SosixQemuCollectorRowReceipt:
    var blank_artifacts: [SosixQemuCollectorArtifact] = []
    SosixQemuCollectorRowReceipt(
        manifest_version: 0, host: "", guest: "", status: "", reason: "",
        resume_command: "", owner: "", reviewer: "", evidence_path: "",
        evidence_sha256: "", artifact_count: 0, artifacts: blank_artifacts,
        source_identity: "", compiler_identity: "", compiler_identity_scope: "",
        compiler_policy_sha256: "", compiler_policy_value: "",
        compiler_payload_identity: "", compiler_image_identity: "",
        compiler_alias_identity: "", compiler_manifest_identity: "",
        kernel_identity: "", image_identity: "", qemu_identity: "", qemu_argv: "",
        accelerator_identity: "", transcript_identity: "", program_identity: "",
        firmware_identity: "", firmware_mode: "", firmware_path: "", firmware_version: "",
        firmware_sha256: "", firmware_stage_markers: "", boot_correlation_marker: "",
        run_nonce: "", compiler_in_filesystem: false, compiler_designation_scope: "",
        compiler_version_evidence_path: "", compiler_hello_evidence_path: "",
        compiler_alias_evidence_path: "", compiler_manifest_evidence_path: "")

fn _sosix_qemu_expected_scalar_key(index: i32) -> text:
    if index == 0: return "manifest_version"
    if index == 1: return "host"
    if index == 2: return "guest"
    if index == 3: return "status"
    if index == 4: return "reason"
    if index == 5: return "resume_command"
    if index == 6: return "owner"
    if index == 7: return "reviewer"
    if index == 8: return "evidence_path"
    if index == 9: return "evidence_sha256"
    if index == 10: return "artifact_count"
    if index == 11: return "source_identity"
    if index == 12: return "compiler_identity"
    if index == 13: return "compiler_identity_scope"
    if index == 14: return "compiler_policy_sha256"
    if index == 15: return "compiler_policy_value"
    if index == 16: return "compiler_payload_identity"
    if index == 17: return "compiler_image_identity"
    if index == 18: return "compiler_alias_identity"
    if index == 19: return "compiler_manifest_identity"
    if index == 20: return "kernel_identity"
    if index == 21: return "image_identity"
    if index == 22: return "qemu_identity"
    if index == 23: return "qemu_argv"
    if index == 24: return "accelerator_identity"
    if index == 25: return "transcript_identity"
    if index == 26: return "program_identity"
    if index == 27: return "firmware_identity"
    if index == 28: return "firmware_mode"
    if index == 29: return "firmware_path"
    if index == 30: return "firmware_version"
    if index == 31: return "firmware_sha256"
    if index == 32: return "firmware_stage_markers"
    if index == 33: return "boot_correlation_marker"
    if index == 34: return "run_nonce"
    if index == 35: return "compiler_in_filesystem"
    if index == 36: return "compiler_designation_scope"
    if index == 37: return "compiler_version_evidence_path"
    if index == 38: return "compiler_hello_evidence_path"
    if index == 39: return "compiler_alias_evidence_path"
    if index == 40: return "compiler_manifest_evidence_path"
    ""

pub fn sosix_qemu_bundle_admission_from_collector_record(
    record: text
) -> SosixQemuParsedBundleAdmission:
    var receipt = _sosix_qemu_blank_collector_receipt()
    var artifact_paths = ["", "", "", "", "", "", "", "", "", "", "", "", ""]
    var artifact_hashes = ["", "", "", "", "", "", "", "", "", "", "", "", ""]
    if record.len() == 0 or record.len() > SOSIX_QEMU_ADMISSION_MAX_BYTES:
        return _sosix_qemu_bundle_admission_from_collector_receipt(receipt)
    var line_index: i32 = 0
    for line in record.split_lines():
        if line.len() == 0 or line.len() > SOSIX_QEMU_ADMISSION_MAX_LINE_BYTES:
            return _sosix_qemu_bundle_admission_from_collector_receipt(receipt)
        var expected_key = ""
        if line_index < SOSIX_QEMU_ADMISSION_SCALAR_FIELD_COUNT as i32:
            expected_key = _sosix_qemu_expected_scalar_key(line_index)
        else:
            val artifact_offset = line_index - SOSIX_QEMU_ADMISSION_SCALAR_FIELD_COUNT as i32
            val artifact_index = artifact_offset / 2 + 1
            val artifact_suffix = if artifact_offset % 2 == 0: "path" else: "sha256"
            expected_key = "artifact_{artifact_index}_{artifact_suffix}"
        if expected_key.len() == 0 or not line.starts_with(expected_key + "="):
            return _sosix_qemu_bundle_admission_from_collector_receipt(receipt)
        val value = line.substring(expected_key.len() + 1, line.len())
        if line_index == 0:
            if value != "1": return _sosix_qemu_bundle_admission_from_collector_receipt(receipt)
            receipt.manifest_version = 1
        elif line_index == 1: receipt.host = value
        elif line_index == 2: receipt.guest = value
        elif line_index == 3: receipt.status = value
        elif line_index == 4: receipt.reason = value
        elif line_index == 5: receipt.resume_command = value
        elif line_index == 6: receipt.owner = value
        elif line_index == 7: receipt.reviewer = value
        elif line_index == 8: receipt.evidence_path = value
        elif line_index == 9: receipt.evidence_sha256 = value
        elif line_index == 10:
            val canonical_artifact_count = value == "1" or value == "2" or value == "3" or
                value == "4" or value == "5" or value == "6" or value == "7" or
                value == "8" or value == "9" or value == "10" or value == "11" or
                value == "12" or value == "13"
            if not canonical_artifact_count:
                return _sosix_qemu_bundle_admission_from_collector_receipt(receipt)
            receipt.artifact_count = value.to_i64() as u32
        elif line_index == 11: receipt.source_identity = value
        elif line_index == 12: receipt.compiler_identity = value
        elif line_index == 13: receipt.compiler_identity_scope = value
        elif line_index == 14: receipt.compiler_policy_sha256 = value
        elif line_index == 15: receipt.compiler_policy_value = value
        elif line_index == 16: receipt.compiler_payload_identity = value
        elif line_index == 17: receipt.compiler_image_identity = value
        elif line_index == 18: receipt.compiler_alias_identity = value
        elif line_index == 19: receipt.compiler_manifest_identity = value
        elif line_index == 20: receipt.kernel_identity = value
        elif line_index == 21: receipt.image_identity = value
        elif line_index == 22: receipt.qemu_identity = value
        elif line_index == 23: receipt.qemu_argv = value
        elif line_index == 24: receipt.accelerator_identity = value
        elif line_index == 25: receipt.transcript_identity = value
        elif line_index == 26: receipt.program_identity = value
        elif line_index == 27: receipt.firmware_identity = value
        elif line_index == 28: receipt.firmware_mode = value
        elif line_index == 29: receipt.firmware_path = value
        elif line_index == 30: receipt.firmware_version = value
        elif line_index == 31: receipt.firmware_sha256 = value
        elif line_index == 32: receipt.firmware_stage_markers = value
        elif line_index == 33: receipt.boot_correlation_marker = value
        elif line_index == 34: receipt.run_nonce = value
        elif line_index == 35:
            val compiler_value = value
            if compiler_value != "true" and compiler_value != "false":
                return _sosix_qemu_bundle_admission_from_collector_receipt(receipt)
            receipt.compiler_in_filesystem = compiler_value == "true"
        elif line_index == 36: receipt.compiler_designation_scope = value
        elif line_index == 37: receipt.compiler_version_evidence_path = value
        elif line_index == 38: receipt.compiler_hello_evidence_path = value
        elif line_index == 39: receipt.compiler_alias_evidence_path = value
        elif line_index == 40: receipt.compiler_manifest_evidence_path = value
        else:
            val artifact_offset = line_index - SOSIX_QEMU_ADMISSION_SCALAR_FIELD_COUNT as i32
            val slot = artifact_offset / 2
            if slot < 0 or slot >= SOSIX_QEMU_COMPILER_NATIVE_ARTIFACT_COUNT as i32:
                return _sosix_qemu_bundle_admission_from_collector_receipt(receipt)
            if artifact_offset % 2 == 0: artifact_paths[slot] = value
            else: artifact_hashes[slot] = value
        line_index = line_index + 1
    val expected_line_count = SOSIX_QEMU_ADMISSION_SCALAR_FIELD_COUNT as i32 + receipt.artifact_count as i32 * 2
    if line_index != expected_line_count:
        return _sosix_qemu_bundle_admission_from_collector_receipt(receipt)
    var artifacts: [SosixQemuCollectorArtifact] = []
    var index: i32 = 0
    while index < receipt.artifact_count as i32:
        if artifact_paths[index].len() == 0 or artifact_hashes[index].len() == 0:
            return _sosix_qemu_bundle_admission_from_collector_receipt(receipt)
        artifacts.push(SosixQemuCollectorArtifact(path: artifact_paths[index], sha256: artifact_hashes[index]))
        index = index + 1
    receipt.artifacts = artifacts
    _sosix_qemu_bundle_admission_from_collector_receipt(receipt)

export sosix_qemu_bundle_admission_from_collector_record

pub fn sosix_qemu_structural_row_from_collector_record(
    record: text,
    collector_manifest_evidence_sha256: text
) -> SosixQemuMatrixRow:
    val admission = sosix_qemu_bundle_admission_from_collector_record(record)
    val receipt = admission.receipt
    SosixQemuMatrixRow(
        host: receipt.host, guest: receipt.guest,
        compiler_in_filesystem: receipt.compiler_in_filesystem,
        status: receipt.status, reason: receipt.reason,
        evidence_path: receipt.evidence_path, admission_record: record,
        collector_manifest_evidence_sha256: collector_manifest_evidence_sha256,
        resume_command: receipt.resume_command, owner: receipt.owner, reviewer: receipt.reviewer,
        compiler_version_evidence_path: receipt.compiler_version_evidence_path,
        compiler_hello_evidence_path: receipt.compiler_hello_evidence_path)

export sosix_qemu_structural_row_from_collector_record

pub fn sosix_qemu_matrix_hosts() -> [text]:
    ["linux", "windows", "macos", "freebsd"]

pub fn sosix_qemu_matrix_guests() -> [text]:
    ["x86_32", "x86_64", "arm32", "arm64", "riscv32", "riscv64"]

fn _sosix_qemu_known_host(host: text) -> bool:
    host == "linux" or host == "windows" or host == "macos" or host == "freebsd"

fn _sosix_qemu_known_guest(guest: text) -> bool:
    guest == "x86_32" or guest == "x86_64" or guest == "arm32" or
        guest == "arm64" or guest == "riscv32" or guest == "riscv64"

pub fn sosix_qemu_matrix_row_validate(row: SosixQemuMatrixRow) -> SosixQemuMatrixRowValidation:
    if not _sosix_qemu_known_host(row.host):
        return SosixQemuMatrixRowValidation(accepted: false, reason: "unknown-host")
    if not _sosix_qemu_known_guest(row.guest):
        return SosixQemuMatrixRowValidation(accepted: false, reason: "unknown-guest")
    if row.owner.len() == 0 or row.reviewer.len() == 0:
        return SosixQemuMatrixRowValidation(accepted: false, reason: "missing-ownership")
    if row.compiler_in_filesystem:
        if row.compiler_version_evidence_path.len() == 0:
            return SosixQemuMatrixRowValidation(accepted: false, reason: "compiler-row-without-version-evidence")
        if row.compiler_hello_evidence_path.len() == 0:
            return SosixQemuMatrixRowValidation(accepted: false, reason: "compiler-row-without-hello-evidence")
    if row.status == SOSIX_QEMU_ROW_PASS:
        val admission = sosix_qemu_bundle_admission_from_collector_record(row.admission_record)
        if not _sosix_qemu_collector_receipt_valid(admission.receipt):
            return SosixQemuMatrixRowValidation(accepted: false, reason: "pass-without-valid-collector-receipt")
        val receipt = admission.receipt
        if receipt.host != row.host or receipt.guest != row.guest:
            return SosixQemuMatrixRowValidation(accepted: false, reason: "pass-row-receipt-cell-mismatch")
        if receipt.owner != row.owner or receipt.reviewer != row.reviewer:
            return SosixQemuMatrixRowValidation(accepted: false, reason: "pass-row-receipt-owner-mismatch")
        if receipt.evidence_path != row.evidence_path:
            return SosixQemuMatrixRowValidation(accepted: false, reason: "pass-row-receipt-path-mismatch")
        if receipt.compiler_in_filesystem != row.compiler_in_filesystem:
            return SosixQemuMatrixRowValidation(accepted: false, reason: "pass-row-receipt-compiler-mismatch")
        if receipt.compiler_version_evidence_path != row.compiler_version_evidence_path or
            receipt.compiler_hello_evidence_path != row.compiler_hello_evidence_path:
            return SosixQemuMatrixRowValidation(accepted: false, reason: "pass-row-receipt-compiler-evidence-mismatch")
        if not admission.structurally_valid:
            return SosixQemuMatrixRowValidation(accepted: false, reason: "pass-without-structurally-valid-collector-record")
        if row.collector_manifest_evidence_sha256 != receipt.evidence_sha256:
            return SosixQemuMatrixRowValidation(accepted: false, reason: "pass-without-collector-manifest-evidence-hash-binding")
        if admission.reason.len() == 0:
            return SosixQemuMatrixRowValidation(accepted: false, reason: "pass-without-bundle-admission-reason")
        if row.evidence_path.len() == 0:
            return SosixQemuMatrixRowValidation(accepted: false, reason: "pass-without-evidence")
        return SosixQemuMatrixRowValidation(accepted: true, reason: "accepted")
    if row.status != SOSIX_QEMU_ROW_FAILED and row.status != SOSIX_QEMU_ROW_BLOCKED and row.status != SOSIX_QEMU_ROW_UNSUPPORTED:
        return SosixQemuMatrixRowValidation(accepted: false, reason: "unknown-status")
    if row.reason.len() == 0:
        return SosixQemuMatrixRowValidation(accepted: false, reason: "nonpass-without-reason")
    if row.evidence_path.len() == 0:
        return SosixQemuMatrixRowValidation(accepted: false, reason: "nonpass-without-artifact-path")
    if row.resume_command.len() == 0:
        return SosixQemuMatrixRowValidation(accepted: false, reason: "nonpass-without-resume-command")
    SosixQemuMatrixRowValidation(accepted: true, reason: "accepted")

fn _sosix_qemu_matrix_has_row(rows: [SosixQemuMatrixRow], host: text, guest: text) -> bool:
    var count: u32 = 0
    for row in rows:
        if row.host == host and row.guest == guest:
            count = count + 1
    count == 1

pub fn sosix_qemu_matrix_evaluate(rows: [SosixQemuMatrixRow]) -> SosixQemuMatrixResult:
    if rows.len() != 24:
        return SosixQemuMatrixResult(status: "failed", reason: "matrix-row-count", row_count: rows.len() as u32, pass_count: 0, blocked_count: 0, failed_count: 1)

    for row in rows:
        val validation = sosix_qemu_matrix_row_validate(row)
        if not validation.accepted:
            return SosixQemuMatrixResult(status: "failed", reason: validation.reason, row_count: rows.len() as u32, pass_count: 0, blocked_count: 0, failed_count: 1)

    val hosts = sosix_qemu_matrix_hosts()
    val guests = sosix_qemu_matrix_guests()
    for host in hosts:
        for guest in guests:
            if not _sosix_qemu_matrix_has_row(rows, host, guest):
                return SosixQemuMatrixResult(status: "failed", reason: "missing-or-duplicate-cell:{host}:{guest}", row_count: rows.len() as u32, pass_count: 0, blocked_count: 0, failed_count: 1)

    var pass_count: u32 = 0
    var blocked_count: u32 = 0
    var failed_count: u32 = 0
    for row in rows:
        if row.status == SOSIX_QEMU_ROW_PASS:
            pass_count = pass_count + 1
        elif row.status == SOSIX_QEMU_ROW_FAILED:
            failed_count = failed_count + 1
        else:
            blocked_count = blocked_count + 1

    if failed_count > 0:
        return SosixQemuMatrixResult(status: "failed", reason: "one-or-more-rows-failed", row_count: 24, pass_count: pass_count, blocked_count: blocked_count, failed_count: failed_count)
    if blocked_count > 0:
        return SosixQemuMatrixResult(status: "blocked", reason: "one-or-more-rows-blocked", row_count: 24, pass_count: pass_count, blocked_count: blocked_count, failed_count: 0)
    SosixQemuMatrixResult(status: "pass", reason: "all-required-rows-pass", row_count: 24, pass_count: 24, blocked_count: 0, failed_count: 0)

export sosix_qemu_matrix_hosts, sosix_qemu_matrix_guests
export sosix_qemu_matrix_row_validate, sosix_qemu_matrix_evaluate
