"""Fail-closed evidence contract for a real SimpleOS filesystem guest flow.

This module classifies already-captured guest facts. It performs no host I/O,
does not launch QEMU, and cannot fabricate a boot, listing, or program result.
The QEMU runner supplies these fields only after parsing a correlated serial or
SSH transcript from the production guest path.
"""

pub val SOSIX_QEMU_GUEST_PASS: text = "pass"
pub val SOSIX_QEMU_GUEST_BLOCKED_PREFIX: text = "blocked:"
pub val SOSIX_QEMU_GUEST_MAX_SERIAL_BYTES: i64 = 65536

export SOSIX_QEMU_GUEST_PASS, SOSIX_QEMU_GUEST_BLOCKED_PREFIX, SOSIX_QEMU_GUEST_MAX_SERIAL_BYTES

pub struct SosixQemuGuestFilesystemReceipt:
    host: text
    guest: text
    boot_status: text
    mount_status: text
    listing_status: text
    listing_output: text
    expected_listing_entry: text
    program_status: text
    program_path: text
    program_nonce: text
    program_stdout: text
    expected_program_stdout: text
    program_exit_code: i32
    fixed_response_detected: bool
    target_native_program: bool

export SosixQemuGuestFilesystemReceipt

pub fn sosix_qemu_guest_filesystem_status(receipt: SosixQemuGuestFilesystemReceipt) -> text:
    if receipt.host == "":
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "missing-host"
    if receipt.guest == "":
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "missing-guest"
    if receipt.boot_status != "pass":
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "boot-not-proven"
    if receipt.mount_status != "pass":
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "filesystem-not-mounted"
    if receipt.listing_status != "pass":
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "listing-not-executed"
    if receipt.expected_listing_entry == "":
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "listing-oracle-empty"
    if not receipt.listing_output.contains(receipt.expected_listing_entry):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "listing-entry-missing"
    if receipt.program_status != "pass":
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-not-executed"
    if receipt.program_path == "":
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-path-empty"
    if receipt.program_nonce == "":
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-nonce-empty"
    if receipt.expected_program_stdout == "":
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-oracle-empty"
    if receipt.program_stdout != receipt.expected_program_stdout:
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-output-mismatch"
    if receipt.program_exit_code != 0:
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-exit-nonzero"
    if receipt.fixed_response_detected:
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "fixed-response-detected"
    if not receipt.target_native_program:
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-not-target-native"
    SOSIX_QEMU_GUEST_PASS

export sosix_qemu_guest_filesystem_status

pub fn sosix_qemu_guest_serial_status(
    serial: text,
    host: text,
    guest: text,
    nonce: text,
    expected_listing_entry: text,
    program_path: text,
    expected_program_stdout: text
) -> text:
    """Validate exact correlated markers from a production guest transcript."""
    if host == "" or guest == "" or nonce == "":
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "serial-identity-empty"
    if serial.contains("SOSIX_QEMU_FIXED_RESPONSE"):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "fixed-response-detected"
    val identity = "host=" + host + " guest=" + guest + " nonce=" + nonce
    if not serial.contains("SOSIX_QEMU_BOOT PASS " + identity):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "boot-not-proven"
    if not serial.contains("SOSIX_QEMU_FS_MOUNT PASS " + identity):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "filesystem-not-mounted"
    if not serial.contains("SOSIX_QEMU_FS_LS BEGIN " + identity):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "listing-not-executed"
    if not serial.contains("SOSIX_QEMU_FS_LS_ENTRY " + identity + " path=" + expected_listing_entry):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "listing-entry-missing"
    if not serial.contains("SOSIX_QEMU_FS_LS END " + identity + " status=pass"):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "listing-not-completed"
    if not serial.contains("SOSIX_QEMU_PROGRAM BEGIN " + identity + " path=" + program_path):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-not-executed"
    if not serial.contains("SOSIX_QEMU_PROGRAM_STDOUT " + identity + " text=" + expected_program_stdout):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-output-mismatch"
    if not serial.contains("SOSIX_QEMU_PROGRAM END " + identity + " exit=0 target_native=true"):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-exit-or-provenance-invalid"
    SOSIX_QEMU_GUEST_PASS

export sosix_qemu_guest_serial_status

fn sosix_qemu_guest_marker_value_valid(value: text) -> bool:
    value != "" and not value.contains(" ") and not value.contains("\n") and not value.contains("\r")

pub fn sosix_qemu_compiler_serial_status(
    serial: text,
    host: text,
    guest: text,
    nonce: text,
    compiler_path: text,
    expected_compiler_version: text,
    source_path: text,
    executable_path: text,
    expected_program_stdout: text
) -> text:
    """Validate bounded guest-native compiler, compile, and execution markers.

    The caller must supply a retained production guest transcript. This pure
    validator performs no filesystem or process I/O and therefore cannot turn
    descriptor intent into execution evidence.
    """
    if serial.len() > SOSIX_QEMU_GUEST_MAX_SERIAL_BYTES:
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "serial-too-large"
    if not sosix_qemu_guest_marker_value_valid(host) or not sosix_qemu_guest_marker_value_valid(guest):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "serial-identity-invalid"
    if not sosix_qemu_guest_marker_value_valid(nonce):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-nonce-invalid"
    if not sosix_qemu_guest_marker_value_valid(compiler_path):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "compiler-path-invalid"
    if not sosix_qemu_guest_marker_value_valid(expected_compiler_version):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "compiler-version-invalid"
    if not sosix_qemu_guest_marker_value_valid(source_path) or not sosix_qemu_guest_marker_value_valid(executable_path):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "compile-path-invalid"
    if expected_program_stdout == "" or expected_program_stdout.contains("\n") or expected_program_stdout.contains("\r"):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "program-oracle-invalid"

    val filesystem_status = sosix_qemu_guest_serial_status(
        serial, host, guest, nonce, compiler_path, executable_path,
        expected_program_stdout)
    if filesystem_status != SOSIX_QEMU_GUEST_PASS:
        return filesystem_status

    val identity = "host=" + host + " guest=" + guest + " nonce=" + nonce
    if not serial.contains(
        "SOSIX_QEMU_COMPILER_VERSION " + identity + " path=" + compiler_path +
        " version=" + expected_compiler_version + " exit=0 target_native=true"):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "compiler-version-not-proven"
    if not serial.contains(
        "SOSIX_QEMU_HELLO_SOURCE " + identity + " path=" + source_path +
        " source_nonce=" + nonce):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "hello-source-not-correlated"
    if not serial.contains(
        "SOSIX_QEMU_HELLO_COMPILE BEGIN " + identity + " compiler=" +
        compiler_path + " source=" + source_path + " output=" + executable_path):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "hello-compile-not-started"
    if not serial.contains(
        "SOSIX_QEMU_HELLO_COMPILE END " + identity + " output=" +
        executable_path + " exit=0 target_native=true"):
        return SOSIX_QEMU_GUEST_BLOCKED_PREFIX + "hello-compile-not-proven"
    SOSIX_QEMU_GUEST_PASS

export sosix_qemu_compiler_serial_status
