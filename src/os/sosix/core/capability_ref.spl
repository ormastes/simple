"""Opaque slot/generation references shared by SOSIX operation adapters."""

pub struct SosixCapabilityRef:
    slot: u32
    generation: u32

pub struct SosixBufferRef:
    slot: u32
    generation: u32

export SosixCapabilityRef, SosixBufferRef

pub fn sosix_capability_ref_is_valid(ref_: SosixCapabilityRef) -> bool:
    ref_.generation != 0

pub fn sosix_buffer_ref_is_valid(ref_: SosixBufferRef) -> bool:
    ref_.generation != 0

export sosix_capability_ref_is_valid, sosix_buffer_ref_is_valid
