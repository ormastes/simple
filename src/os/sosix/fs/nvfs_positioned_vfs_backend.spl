"""SOSIX positioned-I/O bridge to MountTable-owned NVFS file objects."""

use os.services.vfs.vfs_positioned_ops.{g_vfs_nvfs_read_at, g_vfs_nvfs_write_at}
use os.sosix.fs.driver_positioned_error_v1.{sosix_driver_positioned_error_reason_v1}
use os.sosix.fs.service_vfs_backend_v1.{SosixPositionedVfsBackendV1}

pub class SosixNvfsPositionedVfsBackendV1:
    """Resolve only live NVFS MountTable objects; raw driver handles fail closed."""

impl SosixPositionedVfsBackendV1 for SosixNvfsPositionedVfsBackendV1:
    fn positioned_io_available() -> bool: true

    fn read_at(
        file_object_id: u64, offset: u64, length: u64
    ) -> Result<[u8], text>:
        val read_result = g_vfs_nvfs_read_at(file_object_id, offset, length)
        match read_result:
            case Ok(bytes): Ok(bytes)
            case Err(err): Err(sosix_driver_positioned_error_reason_v1("nvfs", err))

    me fn write_at(
        file_object_id: u64, offset: u64, data: [u8]
    ) -> Result<u64, text>:
        val write_result = g_vfs_nvfs_write_at(file_object_id, offset, data)
        match write_result:
            case Ok(written): Ok(written)
            case Err(err): Err(sosix_driver_positioned_error_reason_v1("nvfs", err))

export SosixNvfsPositionedVfsBackendV1
