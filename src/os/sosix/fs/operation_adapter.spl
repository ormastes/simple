"""Typed filesystem operation description for legacy and future transports."""

use os.sosix.core.operation.{SosixOperationId}
use os.sosix.core.capability_ref.{
    SosixCapabilityRef,
    SosixBufferRef,
    sosix_capability_ref_is_valid,
    sosix_buffer_ref_is_valid
}

pub val SOSIX_FS_READ_AT: u32 = 0x0101
pub val SOSIX_FS_WRITE_AT: u32 = 0x0102

pub struct SosixFileOperation:
    operation: SosixOperationId
    api_id: u32
    file: SosixCapabilityRef
    buffer: SosixBufferRef
    file_offset: u64
    buffer_offset: u64
    length: u64
    deadline_ns: u64

pub struct SosixFileOperationResult:
    accepted: bool
    reason: text
    request: SosixFileOperation

export SOSIX_FS_READ_AT, SOSIX_FS_WRITE_AT, SosixFileOperation, SosixFileOperationResult

pub fn sosix_file_operation_create(
    operation: SosixOperationId,
    api_id: u32,
    file: SosixCapabilityRef,
    buffer: SosixBufferRef,
    file_offset: u64,
    buffer_offset: u64,
    length: u64,
    deadline_ns: u64
) -> SosixFileOperationResult:
    val request = SosixFileOperation(
        operation: operation,
        api_id: api_id,
        file: file,
        buffer: buffer,
        file_offset: file_offset,
        buffer_offset: buffer_offset,
        length: length,
        deadline_ns: deadline_ns
    )
    if api_id != SOSIX_FS_READ_AT and api_id != SOSIX_FS_WRITE_AT:
        return SosixFileOperationResult(accepted: false, reason: "unsupported-api", request: request)
    if not sosix_capability_ref_is_valid(file):
        return SosixFileOperationResult(accepted: false, reason: "invalid-file-capability", request: request)
    if not sosix_buffer_ref_is_valid(buffer):
        return SosixFileOperationResult(accepted: false, reason: "invalid-buffer-reference", request: request)
    if length == 0:
        return SosixFileOperationResult(accepted: false, reason: "empty-transfer", request: request)
    if buffer_offset + length < buffer_offset:
        return SosixFileOperationResult(accepted: false, reason: "buffer-range-overflow", request: request)
    if file_offset + length < file_offset:
        return SosixFileOperationResult(accepted: false, reason: "file-range-overflow", request: request)
    SosixFileOperationResult(accepted: true, reason: "accepted", request: request)

export sosix_file_operation_create
