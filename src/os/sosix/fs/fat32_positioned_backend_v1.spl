"""Cursor-independent SOSIX positioned backend for the canonical FAT32 driver.

The owning VFS service must serialize calls on one instance. FAT metadata,
cluster allocation, and driver caches are mutable even though these operations
never observe or change an open-file cursor. This adapter deliberately does not
claim concurrent mutation safety beyond that single-owner service contract.
"""

use os.services.fat32.shared_fat32_driver.{SharedFat32Driver}
use os.sosix.fs.service_vfs_backend_v1.{SosixPositionedVfsBackendV1}

pub class SosixFat32PositionedBackendV1:
    """Single-owner adapter; do not dispatch concurrently on one driver."""
    driver: SharedFat32Driver

impl SosixFat32PositionedBackendV1:
    static fn new(driver: SharedFat32Driver) -> SosixFat32PositionedBackendV1:
        SosixFat32PositionedBackendV1(driver: driver)

impl SosixPositionedVfsBackendV1 for SosixFat32PositionedBackendV1:
    fn positioned_io_available() -> bool: true

    fn read_at(file_object_id: u64, offset: u64, length: u64) -> Result<[u8], text>:
        self.driver.read_at(file_object_id, offset, length)

    fn write_at(file_object_id: u64, offset: u64, data: [u8]) -> Result<u64, text>:
        self.driver.write_at(file_object_id, offset, data)

export SosixFat32PositionedBackendV1
