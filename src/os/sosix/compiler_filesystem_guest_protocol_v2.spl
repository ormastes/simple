"""Pure formatters for the SimpleOS compiler-filesystem guest serial protocol.

Callers supply evidence only after observing the corresponding guest operation.
These functions do not inspect the filesystem or synthesize workflow state.
"""

pub fn simpleos_cfs_begin_v2(arch: text, nonce: text) -> text:
    "SIMPLEOS_COMPILER_FS_BEGIN arch={arch} nonce={nonce} protocol=2"

pub fn simpleos_cfs_fwcfg_v2(nonce: text) -> text:
    "SIMPLEOS_COMPILER_FS_FWCFG name=opt/simpleos.cfs.nonce nonce={nonce} status=pass"

pub fn simpleos_cfs_qemu_image_v2(path: text, sha256: text, drive_arg: text) -> text:
    "SIMPLEOS_COMPILER_FS_QEMU_IMAGE path={path} sha256={sha256} drive_arg={drive_arg}"

pub fn simpleos_cfs_role_v2(path: text, sha256: text, kind: text, canonical: text) -> text:
    "SIMPLEOS_COMPILER_FS_ROLE path={path} sha256={sha256} kind={kind} canonical={canonical}"

pub fn simpleos_cfs_version_v2(
    simple_sha256: text,
    version_output_sha256: text,
    stdout_hex: text,
    manifest_sha256: text,
    nonce: text,
    exit_code: i64,
) -> text:
    "SIMPLEOS_COMPILER_FS_VERSION path=/usr/bin/simple status=pass simple_sha256={simple_sha256} version_output_sha256={version_output_sha256} stdout_hex={stdout_hex} manifest_sha256={manifest_sha256} nonce={nonce} exit={exit_code}"

pub fn simpleos_cfs_compile_v2(
    source_sha256: text, artifact_sha256: text, nonce: text, status: text
) -> text:
    "SIMPLEOS_COMPILER_FS_COMPILE compiler=/usr/bin/simple source=/HELLO.SPL artifact=/TMP/HELLO source_sha256={source_sha256} artifact_sha256={artifact_sha256} nonce={nonce} status={status}"

pub fn simpleos_cfs_exec_v2(
    artifact_sha256: text,
    nonce: text,
    exit_code: i64,
    stdout_hex: text,
    stdout_sha256: text,
) -> text:
    "SIMPLEOS_COMPILER_FS_EXEC path=/TMP/HELLO artifact_sha256={artifact_sha256} nonce={nonce} exit={exit_code} stdout_hex={stdout_hex} stdout_sha256={stdout_sha256} status=pass"

pub fn simpleos_cfs_pass_v2(
    arch: text, nonce: text, simple_sha256: text, artifact_sha256: text
) -> text:
    "SIMPLEOS_COMPILER_FS_PASS arch={arch} nonce={nonce} simple_sha256={simple_sha256} artifact_sha256={artifact_sha256} status=pass"

export simpleos_cfs_begin_v2, simpleos_cfs_fwcfg_v2
export simpleos_cfs_qemu_image_v2, simpleos_cfs_role_v2
export simpleos_cfs_version_v2, simpleos_cfs_compile_v2
export simpleos_cfs_exec_v2, simpleos_cfs_pass_v2
