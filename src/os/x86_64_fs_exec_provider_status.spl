# x86_64 filesystem-exec provider status reporting.
#
# The architecture boot lane may describe the result of the shared loader
# boundary, but it must not mint executable authority or reinterpret an auth
# rejection as successful execution.

pub val X86_64_FS_EXEC_PROVIDER_READY: text = "ready"
pub val X86_64_FS_EXEC_PROVIDER_AUTH_REQUIRED: text = "authenticated-provider-unavailable"
pub val X86_64_FS_EXEC_PROVIDER_FAILED: text = "execution-failed"

pub fn x86_64_fs_exec_provider_status(rc: i64) -> text:
    if rc == 37:
        return X86_64_FS_EXEC_PROVIDER_READY
    if rc == -13:
        return X86_64_FS_EXEC_PROVIDER_AUTH_REQUIRED
    X86_64_FS_EXEC_PROVIDER_FAILED

pub fn x86_64_fs_exec_provider_blocked_marker(rc: i64) -> text:
    "X86_64_FS_EXEC_BLOCKED reason={x86_64_fs_exec_provider_status(rc)} rc={rc}"
