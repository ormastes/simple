# Simple Web Window Renderer Adapter
#
# SimpleOS compositor adapter for rendering app client areas through the
# canonical Simple Web renderer and then blitting pixels to CompositorBackend.

use os.compositor.display_backend_core.{CompositorBackend}
use common.ui.web_render_api.{WEB_RENDER_TARGET_SIMPLE_WEB, WebRenderArtifact, WebRenderRequest, web_render_full_html}
use common.ui.theme_package_wire.{
    ThemePackageInstallProjection,
    theme_package_install_wire_v1_decode,
    theme_package_install_wire_v1_within_bound
}
use common.ui.theme_render_snapshot.{ThemeRenderSnapshot}
use common.ui.window_scene.{WM_CONTENT_ORIGIN_SIMPLE_WEB, WmContentFrame, wm_content_frame_checksum}
use nogc_sync_mut.ui.theme_package.{default_theme_id, resolved_theme_css, resolve_theme_alias, theme_package_fingerprint, theme_package_material_solid_fallback_rgba, theme_package_material_text_rgba}
use common.ui.wm_chrome_theme.{
    active_wm_theme_render_snapshot,
    active_theme_composed_css,
    active_theme_solid_fallback_rgba,
    active_theme_source_fingerprint,
    active_theme_text_rgba
}
use os.compositor.web_render_surface.{compositor_render_html_artifact, compositor_render_request_artifact}
use std.gc_async_mut.ui.web_render_pixel_backend.{WebRenderPixelArtifactCache}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    SimpleWebLayoutMaterialWitness,
    simple_web_layout_material_provenance_after_backend_execution
}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{Engine2dDrawIrAdvResult}

fn _active_or_default_wm_theme_id() -> text:
    # Compatibility render entrypoints are still used by the freestanding
    # shared-MDI and Compositor paths. They must follow the snapshot installed
    # before desktop construction, rather than silently reverting only web
    # client areas to the package default.
    if val snapshot = active_wm_theme_render_snapshot():
        return snapshot.id
    # This fallback preserves standalone renderer callers that do not own a
    # WM bootstrap yet.
    default_theme_id()

fn _theme_hex_digit(value: u32) -> text:
    "0123456789ABCDEF".char_at(value.to_i64())

fn _theme_rgb_css(value: u32) -> text:
    val r = (value >> 16) & 0xFF
    val g = (value >> 8) & 0xFF
    val b = value & 0xFF
    "#{_theme_hex_digit(r >> 4)}{_theme_hex_digit(r & 0xF)}{_theme_hex_digit(g >> 4)}{_theme_hex_digit(g & 0xF)}{_theme_hex_digit(b >> 4)}{_theme_hex_digit(b & 0xF)}"

fn _theme_solid_fallback_rgba(theme: text) -> u32:
    val installed = active_theme_solid_fallback_rgba(theme)
    if installed != 0u32:
        return installed
    theme_package_material_solid_fallback_rgba(theme)

fn _theme_text_rgba(theme: text) -> u32:
    val installed = active_theme_text_rgba(theme)
    if installed != 0u32:
        return installed
    theme_package_material_text_rgba(theme)

fn _wm_root_behavior_attrs() -> text:
    "data-wm-motion=\"standard\" data-wm-animation-style=\"spring\" data-wm-transparency=\"standard\" data-wm-energy=\"standard\" data-wm-feedback=\"standard\" data-wm-contrast=\"comfortable\" data-wm-density=\"comfortable\" data-wm-wallpaper=\"aurora\" data-wm-backdrop-motion=\"ambient\" data-wm-backdrop-intensity=\"balanced\" data-wm-dock-magnification=\"standard\" data-wm-dock-visibility=\"shown\" data-wm-surface-depth=\"layered\" data-wm-traffic-side=\"left\" data-wm-chrome-verbosity=\"full\" data-wm-window-transition=\"mac\" data-wm-accent=\"blue\" data-wm-focus-mode=\"off\" data-wm-quiet-mode=\"off\" data-wm-icon-mask=\"circle\" data-wm-corner-radius=\"round\""

fn _wm_root_data_attrs(theme_id: text) -> text:
    val canonical_theme = resolve_theme_alias(theme_id)
    "data-wm-theme=\"{canonical_theme}\" " + _wm_root_behavior_attrs()

fn _simple_web_theme_attr_text_valid(value: text) -> bool:
    (value != "" and not value.contains("\"") and
        not value.contains("<") and not value.contains(">") and
        not value.contains("\r") and not value.contains("\n") and
        not value.contains("\0"))

fn _wm_root_data_attrs_with_snapshot(
    snapshot: ThemeRenderSnapshot, theme_revision: i64
) -> text:
    if (theme_revision <= 0 or
        not _simple_web_theme_attr_text_valid(snapshot.id) or
        not _simple_web_theme_attr_text_valid(
            snapshot.source_manifest_sha256
        ) or not _simple_web_theme_attr_text_valid(
            snapshot.material_sha256
        )):
        return ""
    (
        "data-wm-theme=\"" + snapshot.id + "\" " +
        _wm_root_behavior_attrs() +
        " data-wm-theme-revision=\"{theme_revision}\"" +
        " data-wm-theme-source-manifest-sha256=\"" +
        snapshot.source_manifest_sha256 + "\"" +
        " data-wm-theme-material-sha256=\"" +
        snapshot.material_sha256 + "\""
    )

fn _simple_web_structural_css() -> text:
    ".wm-app-container { min-height: 100vh; } .wm-app-titlebar { height: 24px; } .wm-app-content { min-height: calc(100vh - 24px); }"

fn _simple_web_window_css(theme: text) -> text:
    # Theme aliases, package inheritance, widget CSS, and visual tokens belong
    # to theme_package. This adapter contributes layout only; keeping colors,
    # shadows, and glass effects here created a second, divergent theme owner.
    val installed_css = active_theme_composed_css(theme)
    val package_css = if installed_css != "": installed_css else: resolved_theme_css(theme)
    package_css + "\n" + _simple_web_structural_css()

fn _simple_web_window_css_with_snapshot(
    snapshot: ThemeRenderSnapshot
) -> text:
    snapshot.composed_css + "\n" + _simple_web_structural_css()

fn _simple_web_content_render_request_from_snapshot(
    snapshot: ThemeRenderSnapshot,
    theme_revision: i64,
    title: text,
    body_html: text,
    viewport_w: i32,
    viewport_h: i32
) -> WebRenderRequest:
    val attrs = _wm_root_data_attrs_with_snapshot(
        snapshot, theme_revision
    )
    if attrs == "":
        return WebRenderRequest.html(
            WEB_RENDER_TARGET_SIMPLE_WEB, "", "", "", "", 0, 0
        )
    val css = _simple_web_window_css_with_snapshot(snapshot)
    val app_css = css + "body { margin: 0; overflow: hidden; background: var(--app-surface); color: var(--ui-fg); } #app { min-height: 100vh; padding: 0; } .wm-app-content { min-height: 100vh; color: var(--ui-fg); }"
    val solid_css = _theme_rgb_css(
        snapshot.material.solid_fallback_rgba
    )
    val text_css = _theme_rgb_css(snapshot.material.text_rgba)
    val app_body = "<div id='wm-app-content' class='wm-app-content widget-panel' data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' data-wm-theme-fallback='solid-material' data-wm-theme-bg='{solid_css}' data-wm-theme-fg='{text_css}'>" + body_html + "</div>"
    WebRenderRequest.html(
        WEB_RENDER_TARGET_SIMPLE_WEB,
        title,
        app_body,
        app_css,
        "",
        viewport_w,
        viewport_h
    ).with_root_attrs(attrs)

fn _simple_web_content_full_html_with_install_projection(
    projection: ThemePackageInstallProjection,
    theme_revision: i64,
    title: text,
    body_html: text,
    viewport_w: i32,
    viewport_h: i32
) -> text:
    """Serialize canonical themed HTML from the exact accepted projection."""
    val request = _simple_web_content_render_request_from_snapshot(
        projection.snapshot,
        theme_revision,
        title,
        body_html,
        viewport_w,
        viewport_h
    )
    if request.viewport_w <= 0 or request.viewport_h <= 0:
        return ""
    web_render_full_html(request)

fn _simple_web_content_full_html_matches_install_projection(
    projection: ThemePackageInstallProjection,
    theme_revision: i64,
    html: text
) -> bool:
    """Reject raw or differently themed HTML without rebuilding its body."""
    val attrs = _wm_root_data_attrs_with_snapshot(
        projection.snapshot, theme_revision
    )
    if attrs == "":
        return false
    val css_prefix = (
        "<style>" + projection.snapshot.composed_css + "\n" +
        _simple_web_structural_css()
    )
    html.starts_with("<!DOCTYPE html><html " + attrs + "><head>") and
        html.contains(css_prefix) and
        html.contains(
            "data-wm-theme-material-mode='engine2d-cpu-composited-material-v1'"
        )

fn simple_web_content_full_html_with_install_wire(
    install_wire: text,
    theme_revision: i64,
    title: text,
    body_html: text,
    viewport_w: i32,
    viewport_h: i32
) -> text:
    """Decode the copied wire privately and serialize canonical themed HTML."""
    if (theme_revision <= 0 or
        not theme_package_install_wire_v1_within_bound(install_wire)):
        return ""
    match theme_package_install_wire_v1_decode(install_wire):
        Err(_):
            ""
        Ok(projection):
            _simple_web_content_full_html_with_install_projection(
                projection,
                theme_revision,
                title,
                body_html,
                viewport_w,
                viewport_h
            )

fn simple_web_content_full_html_matches_install_wire(
    install_wire: text, theme_revision: i64, html: text
) -> bool:
    """Validate canonical themed HTML without exposing decoded aggregates."""
    if (theme_revision <= 0 or
        not theme_package_install_wire_v1_within_bound(install_wire)):
        return false
    match theme_package_install_wire_v1_decode(install_wire):
        Err(_):
            false
        Ok(projection):
            _simple_web_content_full_html_matches_install_projection(
                projection, theme_revision, html
            )

# Content-only request for WM-owned windows. The shared WM executor owns the
# outer titlebar and frame, so this request deliberately emits no nested
# `.wm-app-titlebar` element.
fn simple_web_content_render_request_with_theme(theme: text, title: text, body_html: text, viewport_w: i32, viewport_h: i32) -> WebRenderRequest:
    val css = _simple_web_window_css(theme)
    val app_css = css + "body { margin: 0; overflow: hidden; background: var(--app-surface); color: var(--ui-fg); } #app { min-height: 100vh; padding: 0; } .wm-app-content { min-height: 100vh; color: var(--ui-fg); }"
    # Keep the canonical package CSS intact through parse/layout. The layout
    # engine owns capability-aware realization: when backdrop sampling is not
    # available it preserves the resolved surface as an opaque solid material
    # without discarding selector layout, typography, or content state.
    val solid_css = _theme_rgb_css(_theme_solid_fallback_rgba(theme))
    val text_css = _theme_rgb_css(_theme_text_rgba(theme))
    # The package intentionally authors a translucent base plus one linear
    # highlight layer and a tokenized backdrop filter. Simple Web resolves the
    # package variables before declarations are parsed, normalizes that exact
    # two-layer form to typed base/gradient fields, and keeps arbitrary image
    # stacks or unresolved variables as rejection witnesses. Preserve the
    # exact mode here so the supported Aetheric material reaches Draw IR; the
    # named opaque color remains the command-level fail-closed fallback.
    val app_body = "<div id='wm-app-content' class='wm-app-content widget-panel' data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' data-wm-theme-fallback='solid-material' data-wm-theme-bg='{solid_css}' data-wm-theme-fg='{text_css}'>" + body_html + "</div>"
    WebRenderRequest.html(WEB_RENDER_TARGET_SIMPLE_WEB, title, app_body, app_css, "", viewport_w, viewport_h).with_root_attrs(_wm_root_data_attrs(theme))

fn simple_web_content_render_request_with_active_theme(title: text, body_html: text, viewport_w: i32, viewport_h: i32) -> WebRenderRequest:
    """Construct a themed Simple Web request using the active or default WM theme."""
    simple_web_content_render_request_with_theme(
        _active_or_default_wm_theme_id(),
        title,
        body_html,
        viewport_w,
        viewport_h
    )

# Canonical serialized document for host Web surfaces and capture adapters.
# Keeping serialization beside request construction prevents evidence tools
# and host wrappers from substituting the static UI preview fixture.
fn simple_web_content_full_html_with_theme(theme: text, title: text, body_html: text, viewport_w: i32, viewport_h: i32) -> text:
    web_render_full_html(simple_web_content_render_request_with_theme(theme, title, body_html, viewport_w, viewport_h))

fn _simple_web_revision_mix(hash: i64, value: i64) -> i64:
    ((hash * 131 + value) % 2147483647) + 1

fn _simple_web_content_revision_with_fingerprint(
    theme_fingerprint: text,
    title: text,
    body_html: text,
    width: i32,
    height: i32,
    scroll_y: i32
) -> i64:
    var hash: i64 = 17
    var i = 0
    while i < theme_fingerprint.len():
        hash = _simple_web_revision_mix(hash, theme_fingerprint.char_code_at(i) as i64)
        i = i + 1
    hash = _simple_web_revision_mix(hash, 509)
    i = 0
    while i < title.len():
        hash = _simple_web_revision_mix(hash, title.char_code_at(i) as i64)
        i = i + 1
    hash = _simple_web_revision_mix(hash, 257)
    i = 0
    while i < body_html.len():
        hash = _simple_web_revision_mix(hash, body_html.char_code_at(i) as i64)
        i = i + 1
    hash = _simple_web_revision_mix(hash, width.to_i64())
    hash = _simple_web_revision_mix(hash, height.to_i64())
    _simple_web_revision_mix(hash, _clamp_scroll_px(scroll_y).to_i64())

fn simple_web_content_revision_with_theme(theme: text, title: text, body_html: text, width: i32, height: i32, scroll_y: i32) -> i64:
    # The content-addressed package fingerprint covers every package-owned
    # source without rescanning the much larger composed CSS on each request.
    val installed_fingerprint = active_theme_source_fingerprint(theme)
    val theme_fingerprint = if installed_fingerprint != "": installed_fingerprint else: theme_package_fingerprint(theme)
    _simple_web_content_revision_with_fingerprint(
        theme_fingerprint, title, body_html, width, height, scroll_y
    )

fn simple_web_content_revision_with_theme_receipt(
    theme_source_manifest_sha256: text,
    title: text,
    body_html: text,
    width: i32,
    height: i32,
    scroll_y: i32
) -> i64:
    if theme_source_manifest_sha256.len() != 64:
        return 0
    _simple_web_content_revision_with_fingerprint(
        theme_source_manifest_sha256,
        title,
        body_html,
        width,
        height,
        scroll_y
    )

# Source-compatible default-theme entrypoint used by existing compositor
# callers. Theme-aware callers can select the explicit variant above.
fn simple_web_content_revision(title: text, body_html: text, width: i32, height: i32, scroll_y: i32) -> i64:
    simple_web_content_revision_with_theme(_active_or_default_wm_theme_id(), title, body_html, width, height, scroll_y)

fn simple_web_html_pixel_artifact(html: text, cw: i32, ch: i32) -> WebRenderArtifact:
    val req = WebRenderRequest.html(WEB_RENDER_TARGET_SIMPLE_WEB, "", html, "", "", cw, ch).with_pixel_output()
    compositor_render_html_artifact(req, html)

fn render_simple_web_html_content(backend: CompositorBackend, cx: i32, cy: i32, cw: i32, ch: i32, html: text):
    render_simple_web_html_content_scrolled(backend, cx, cy, cw, ch, html, 0)

# Uncached authoritative-body counterpart of simple_web_content_frame_cached.
# Baremetal Compositor owns no long-lived WebRender cache yet, but it must use
# the exact same request construction as the host and must never replace live
# window HTML with the title-based compatibility/demo markup.
fn render_simple_web_content(backend: CompositorBackend, title: text, cx: i32, cy: i32, cw: i32, ch: i32, body_html: text):
    if cw <= 0 or ch <= 0:
        return
    val req = simple_web_content_render_request_with_theme(_active_or_default_wm_theme_id(), title, body_html, cw, ch).with_pixel_output()
    val artifact = compositor_render_request_artifact(req)
    blit_simple_web_pixels(backend, cx, cy, cw, ch, artifact.pixels)

# Content-scroll headroom cap: HostCompositor.scroll_offsets accumulates raw
# wheel delta unboundedly (no clamp at the input side — see
# handle_mouse_wheel), so the render-height growth used to reveal scrolled
# content must be capped independently, or an unbounded scroll accumulation
# would request an unbounded (and, per the already-tracked quadratic CSS
# render bug, potentially very slow) raster height. 4000px is generously
# larger than any hosted-window content used today.
val _MAX_SCROLL_RENDER_PX: i32 = 4000

fn _clamp_scroll_px(scroll_y: i32) -> i32:
    if scroll_y < 0:
        return 0
    if scroll_y > _MAX_SCROLL_RENDER_PX:
        return _MAX_SCROLL_RENDER_PX
    scroll_y

# Public so callers that need to key a cache on the exact render size (e.g.
# HostCompositor._content_cache_for) can compute the same `full_h`
# simple_web_content_frame_cached renders at, without duplicating the clamp
# constant/logic.
fn content_paint_full_height(ch: i32, scroll_y: i32) -> i32:
    ch + _clamp_scroll_px(scroll_y)

fn simple_web_external_content_frame(
    window_id: text,
    content_revision: i64,
    theme: text,
    width: i32,
    height: i32,
    render: Engine2dDrawIrAdvResult,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text
) -> WmContentFrame:
    if (window_id == "" or content_revision <= 0 or width <= 0 or height <= 0 or
        render.fallback_required or render.skipped_command_count != 0 or
        render.rendered_command_count <= 0 or
        render.pixels.len() != width * height):
        return WmContentFrame(
            window_id: window_id,
            scene_revision: 0,
            content_revision: content_revision,
            origin_kind: WM_CONTENT_ORIGIN_SIMPLE_WEB,
            width: width,
            height: height,
            pixels: [],
            checksum: 0u64,
            parent_window_id: "",
            offset_x: 0,
            offset_y: 0
        )
    val witness = SimpleWebLayoutMaterialWitness(
        cpu_composited_count: cpu_composited_count,
        cpu_composited_sha256: cpu_composited_sha256,
        solid_material_count: solid_material_count,
        solid_material_sha256: solid_material_sha256
    )
    val material = simple_web_layout_material_provenance_after_backend_execution(
        witness,
        render.skipped_command_count,
        render.pixels.len(),
        width * height,
        render.cpu_composited_material_count,
        render.metal_device_glass_material_count,
        render.glass_execution_target,
        render.readback_source,
        render.glass_backend_handle,
        render.glass_device_identity
    )
    val installed_fingerprint = active_theme_source_fingerprint(theme)
    val theme_fingerprint = if installed_fingerprint != "":
        installed_fingerprint
    else:
        theme_package_fingerprint(theme)
    WmContentFrame(
        window_id: window_id,
        scene_revision: 0,
        content_revision: content_revision,
        origin_kind: WM_CONTENT_ORIGIN_SIMPLE_WEB,
        width: width,
        height: height,
        pixels: render.pixels,
        checksum: wm_content_frame_checksum(render.pixels),
        parent_window_id: "",
        offset_x: 0,
        offset_y: 0,
        engine2d_status: "engine2d_rendered",
        engine2d_backend: render.selected_backend,
        engine2d_reason: if render.fallback_reason == "":
            "draw-ir-executed"
        else:
            render.fallback_reason,
        material_fallback_kind: material.kind,
        material_fallback_reason: material.reason,
        material_fallback_sha256: material.material_sha256,
        theme_id: theme,
        theme_source_manifest_sha256: theme_fingerprint
    )

fn _simple_web_theme_receipt_matches_install_wire(
    theme_revision: i64,
    acknowledged_theme_revision: i64,
    theme_install_wire: text,
    theme: text,
    theme_source_manifest_sha256: text,
    theme_material_sha256: text
) -> bool:
    if (theme_revision <= 0 or
        acknowledged_theme_revision != theme_revision or
        not theme_package_install_wire_v1_within_bound(theme_install_wire)):
        return false
    match theme_package_install_wire_v1_decode(theme_install_wire):
        Err(_):
            false
        Ok(projection):
            (
                projection.snapshot.id == theme and
                projection.snapshot.source_manifest_sha256 ==
                    theme_source_manifest_sha256 and
                projection.snapshot.material_sha256 ==
                    theme_material_sha256
            )

fn simple_web_external_content_frame_with_theme_receipt(
    window_id: text,
    content_revision: i64,
    theme_revision: i64,
    acknowledged_theme_revision: i64,
    theme_install_wire: text,
    theme: text,
    theme_source_manifest_sha256: text,
    theme_material_sha256: text,
    width: i32,
    height: i32,
    render: Engine2dDrawIrAdvResult,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text
) -> WmContentFrame:
    val exact_theme_receipt = (
        _simple_web_theme_receipt_matches_install_wire(
            theme_revision,
            acknowledged_theme_revision,
            theme_install_wire,
            theme,
            theme_source_manifest_sha256,
            theme_material_sha256
        )
    )
    if (window_id == "" or content_revision <= 0 or
        not exact_theme_receipt or width <= 0 or height <= 0 or
        render.fallback_required or render.skipped_command_count != 0 or
        render.rendered_command_count <= 0 or
        render.pixels.len() != width * height):
        return WmContentFrame(
            window_id: window_id,
            scene_revision: 0,
            content_revision: content_revision,
            origin_kind: WM_CONTENT_ORIGIN_SIMPLE_WEB,
            width: width,
            height: height,
            pixels: [],
            checksum: 0u64,
            parent_window_id: "",
            offset_x: 0,
            offset_y: 0
        )
    val witness = SimpleWebLayoutMaterialWitness(
        cpu_composited_count: cpu_composited_count,
        cpu_composited_sha256: cpu_composited_sha256,
        solid_material_count: solid_material_count,
        solid_material_sha256: solid_material_sha256
    )
    val material = simple_web_layout_material_provenance_after_backend_execution(
        witness,
        render.skipped_command_count,
        render.pixels.len(),
        width * height,
        render.cpu_composited_material_count,
        render.metal_device_glass_material_count,
        render.glass_execution_target,
        render.readback_source,
        render.glass_backend_handle,
        render.glass_device_identity
    )
    if material.material_sha256 != theme_material_sha256:
        return WmContentFrame(
            window_id: window_id,
            scene_revision: 0,
            content_revision: content_revision,
            origin_kind: WM_CONTENT_ORIGIN_SIMPLE_WEB,
            width: width,
            height: height,
            pixels: [],
            checksum: 0u64,
            parent_window_id: "",
            offset_x: 0,
            offset_y: 0
        )
    WmContentFrame(
        window_id: window_id,
        scene_revision: 0,
        content_revision: content_revision,
        origin_kind: WM_CONTENT_ORIGIN_SIMPLE_WEB,
        width: width,
        height: height,
        pixels: render.pixels,
        checksum: wm_content_frame_checksum(render.pixels),
        parent_window_id: "",
        offset_x: 0,
        offset_y: 0,
        engine2d_status: "engine2d_rendered",
        engine2d_backend: render.selected_backend,
        engine2d_reason: if render.fallback_reason == "":
            "draw-ir-executed"
        else:
            render.fallback_reason,
        material_fallback_kind: material.kind,
        material_fallback_reason: material.reason,
        material_fallback_sha256: material.material_sha256,
        theme_id: theme,
        theme_source_manifest_sha256:
            theme_source_manifest_sha256
    )

# Slices the `ch`-tall visible window starting at row `scroll_y` out of a
# `cw` x `full_h` row-major pixel buffer (full_h >= ch + scroll_y). Rows
# beyond the source buffer are left as-is (caller pre-sizes full_h so this
# never triggers in practice); this is pure translation, not resampling —
# each output row is a verbatim copy of source row `scroll_y + row`.
fn _window_scrolled_pixels(pixels: [u32], cw: i32, full_h: i32, ch: i32, scroll_y: i32) -> [u32]:
    if scroll_y <= 0:
        return pixels
    val out_len = cw * ch
    var out: [u32] = [0u32; out_len]
    var row = 0
    while row < ch:
        val src_row = scroll_y + row
        if src_row < full_h:
            val src_start = src_row * cw
            val dst_start = row * cw
            var col = 0
            while col < cw:
                out[dst_start + col] = pixels[src_start + col]
                col = col + 1
        row = row + 1
    out

# Shared implementation behind simple_web_content_frame_cached (top-level,
# parent_window_id="") and simple_web_child_content_frame_cached (nested,
# caller-supplied parent_window_id/offset). Keeping one render path means a
# nested Simple Web panel gets exactly the same render/scroll/checksum
# behavior as a top-level one.
#
# Routes through cache.request_to_pixel_artifact (the full HTML layout/CSS
# engine), NOT request_to_native_safe_pixel_artifact (the tag-stripping
# legacy tag-stripping bitmap-glyph fallback).
# The native-safe path is a crash-recovery fallback only and must be invoked
# explicitly by a caller that has actually hit that failure mode, not wired
# in as the default for every desktop window content frame. See
# WebRenderPixelArtifactCache.request_to_native_safe_pixel_artifact's
# provenance marking (engine2d_status=compatibility_renderer,
# engine2d_backend="native-safe-fallback") for how evidence capture can
# reject a fallback frame that leaked through.
fn _simple_web_content_frame_cached_impl(cache: WebRenderPixelArtifactCache, window_id: text, scene_revision: i64, content_revision: i64, theme: text, title: text, body_html: text, width: i32, height: i32, scroll_y: i32, parent_window_id: text, offset_x: i32, offset_y: i32, animation_clock_ms: i64) -> WmContentFrame:
    if window_id.len() == 0 or scene_revision <= 0 or content_revision <= 0 or width <= 0 or height <= 0:
        return WmContentFrame(window_id: window_id, scene_revision: scene_revision, content_revision: content_revision, origin_kind: WM_CONTENT_ORIGIN_SIMPLE_WEB, width: width, height: height, pixels: [], checksum: 0u64, parent_window_id: parent_window_id, offset_x: offset_x, offset_y: offset_y)
    val clamped_scroll = _clamp_scroll_px(scroll_y)
    val full_h = height + clamped_scroll
    val req = simple_web_content_render_request_with_theme(theme, title, body_html, width, full_h).with_pixel_output()
    val artifact = if animation_clock_ms >= 0:
        cache.request_to_pixel_artifact_at_time(
            req, content_revision, animation_clock_ms
        )
    else:
        cache.request_to_pixel_artifact(req)
    val visible = _window_scrolled_pixels(artifact.pixels, width, full_h, height, clamped_scroll)
    val installed_fingerprint = active_theme_source_fingerprint(theme)
    val theme_fingerprint = if installed_fingerprint != "": installed_fingerprint else: theme_package_fingerprint(theme)
    val material_kind = artifact.material_fallback.kind
    val material_sha = artifact.material_fallback.material_sha256
    # De-mixed into sequential gates for two reasons. First, the previous form
    # did not parse and broke the whole kernel build ("expected expression,
    # found Dedent" at this file, 2026-07-26): a multi-line boolean must sit
    # inside ONE paren group, and there the `and` continued outside the closing
    # paren. Second, even once it parses, `(A or B) and C` is a mixed boolean
    # chain, and the freestanding entry-closure codegen drops the left operand
    # of those — confirmed at three separate sites during the 2026-07-26 WM
    # campaign, each one silently skipping its check. Explicit gates are immune
    # to both. Behaviour is unchanged: both realized material kinds are checked.
    var material_digest_checked = false
    if material_kind == "solid-material":
        material_digest_checked = true
    if material_kind == "cpu-composited-material":
        material_digest_checked = true
    if material_kind == "metal-device-composited-material":
        material_digest_checked = true
    if material_digest_checked:
        if material_sha.len() != 64:
            # A realized material whose digest is not 64 hex chars will fail the
            # provenance gate downstream. Attributes the loss to the artifact
            # TRANSIT when the producer-side digest receipt stayed silent.
            print "[wm-content] material-sha-degenerate kind={material_kind} sha_len={material_sha.len()}"
    WmContentFrame(
        window_id: window_id,
        scene_revision: scene_revision,
        content_revision: content_revision,
        origin_kind: WM_CONTENT_ORIGIN_SIMPLE_WEB,
        width: width,
        height: height,
        pixels: visible,
        checksum: wm_content_frame_checksum(visible),
        parent_window_id: parent_window_id,
        offset_x: offset_x,
        offset_y: offset_y,
        engine2d_status: artifact.engine2d_status,
        engine2d_backend: artifact.engine2d_backend,
        engine2d_reason: artifact.engine2d_reason,
        material_fallback_kind: artifact.material_fallback.kind,
        material_fallback_reason: artifact.material_fallback.reason,
        material_fallback_sha256: artifact.material_fallback.material_sha256,
        theme_id: theme,
        theme_source_manifest_sha256: theme_fingerprint
    )

# Production Simple Web -> shared-WM content adapter. `body_html` is the
# authoritative runtime window content; unlike simple_web_app_* compatibility
# helpers this function never selects canned markup from a title allowlist.
# Top-level frame: parent_window_id="" (not embedded in another content frame).
fn simple_web_content_frame_cached(cache: WebRenderPixelArtifactCache, window_id: text, scene_revision: i64, content_revision: i64, theme: text, title: text, body_html: text, width: i32, height: i32, scroll_y: i32) -> WmContentFrame:
    _simple_web_content_frame_cached_impl(cache, window_id, scene_revision, content_revision, theme, title, body_html, width, height, scroll_y, "", 0, 0, -1)

fn simple_web_content_frame_cached_at_time(cache: WebRenderPixelArtifactCache, window_id: text, scene_revision: i64, content_revision: i64, theme: text, title: text, body_html: text, width: i32, height: i32, scroll_y: i32, animation_clock_ms: i64) -> WmContentFrame:
    _simple_web_content_frame_cached_impl(cache, window_id, scene_revision, content_revision, theme, title, body_html, width, height, scroll_y, "", 0, 0, animation_clock_ms)

# Nested-content variant of simple_web_content_frame_cached: same Simple Web
# render/scroll pipeline, but the resulting WmContentFrame is stamped as a
# child of `parent_window_id`, positioned at (offset_x, offset_y) within the
# parent's content rect (see WmContentFrame doc in common.ui.window_scene).
# Used to embed a web-render panel inside a GUI window's content frame.
fn simple_web_child_content_frame_cached(cache: WebRenderPixelArtifactCache, window_id: text, parent_window_id: text, offset_x: i32, offset_y: i32, scene_revision: i64, content_revision: i64, theme: text, title: text, body_html: text, width: i32, height: i32, scroll_y: i32) -> WmContentFrame:
    _simple_web_content_frame_cached_impl(cache, window_id, scene_revision, content_revision, theme, title, body_html, width, height, scroll_y, parent_window_id, offset_x, offset_y, -1)

fn render_simple_web_html_content_scrolled(backend: CompositorBackend, cx: i32, cy: i32, cw: i32, ch: i32, html: text, scroll_y: i32):
    if cw <= 0 or ch <= 0:
        return
    val clamped_scroll = _clamp_scroll_px(scroll_y)
    val full_h = ch + clamped_scroll
    val artifact = simple_web_html_pixel_artifact(html, cw, full_h)
    val visible = _window_scrolled_pixels(artifact.pixels, cw, full_h, ch, clamped_scroll)
    blit_simple_web_pixels(backend, cx, cy, cw, ch, visible)

fn blit_simple_web_pixels(backend: CompositorBackend, cx: i32, cy: i32, cw: i32, ch: i32, pixels: [u32]):
    backend.blit_pixels(cx, cy, cw, ch, pixels)
