# `screen_type=web` shell — browser compositor surface.
#
# Guest limit, recorded rather than faked: the backend is pure-pixel and
# composes on the guest framebuffer, but the HTML engine and net stack are
# host-side today. A guest `web` shell renders a static local page; remote
# fetch stays host-only until the netstack lands.
#
# MDSOC: feature dimension, compositor layer

use os.compositor.display_backend_core.{CompositorBackend}
use os.compositor.screen_app.{ScreenApp, screen_app_new}

pub fn screen_app_web_open(
    width: i32,
    height: i32,
    backend: CompositorBackend?,
    reason: text
) -> ScreenApp:
    """Bring up the web shell over an already-constructed browser backend."""
    screen_app_new("web", width, height, backend, reason)

export screen_app_web_open
