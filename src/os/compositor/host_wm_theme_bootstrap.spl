# Hosted WM theme bootstrap owner.
#
# Resolve the registered package and install its immutable render snapshot
# before any backend, compositor, or visible frame is created.

use common.ui.generated.aetheric_dark_theme_snapshot.{aetheric_dark_theme_render_snapshot}
use common.ui.theme_package.{default_theme_id, load_theme_package}
use common.ui.theme_render_snapshot.{ThemeRenderSnapshot}
use common.ui.wm_chrome_theme.{apply_theme_render_snapshot_to_wm_chrome}
use common.ui.wm_chrome_theme.{active_wm_theme_render_snapshot}

fn install_default_host_wm_theme() -> ThemeRenderSnapshot:
    # Prefer an already-installed active snapshot, then the registry default
    # package (covers stitched/glass themes like aetheric + custom families),
    # then the generated compatibility snapshot as last-resort.
    if val snapshot = active_wm_theme_render_snapshot():
        apply_theme_render_snapshot_to_wm_chrome(snapshot)
        return snapshot
    val pkg_snapshot = load_theme_package(default_theme_id()).snapshot
    if pkg_snapshot.id != "":
        apply_theme_render_snapshot_to_wm_chrome(pkg_snapshot)
        return pkg_snapshot
    val snapshot = aetheric_dark_theme_render_snapshot()
    apply_theme_render_snapshot_to_wm_chrome(snapshot)
    snapshot
