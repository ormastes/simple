# Scalar PS/2 Set-1 decoding used by the freestanding WM event route.

fn ps2_wm_character(scancode: i32, shift: bool) -> text:
    match scancode:
        0x02: if shift: "!" else: "1"
        0x03: if shift: "@" else: "2"
        0x04: if shift: "#" else: "3"
        0x05: if shift: "$" else: "4"
        0x06: if shift: "%" else: "5"
        0x07: if shift: "^" else: "6"
        0x08: if shift: "&" else: "7"
        0x09: if shift: "*" else: "8"
        0x0A: if shift: "(" else: "9"
        0x0B: if shift: ")" else: "0"
        0x10: if shift: "Q" else: "q"
        0x11: if shift: "W" else: "w"
        0x12: if shift: "E" else: "e"
        0x13: if shift: "R" else: "r"
        0x14: if shift: "T" else: "t"
        0x15: if shift: "Y" else: "y"
        0x16: if shift: "U" else: "u"
        0x17: if shift: "I" else: "i"
        0x18: if shift: "O" else: "o"
        0x19: if shift: "P" else: "p"
        0x1E: if shift: "A" else: "a"
        0x1F: if shift: "S" else: "s"
        0x20: if shift: "D" else: "d"
        0x21: if shift: "F" else: "f"
        0x22: if shift: "G" else: "g"
        0x23: if shift: "H" else: "h"
        0x24: if shift: "J" else: "j"
        0x25: if shift: "K" else: "k"
        0x26: if shift: "L" else: "l"
        0x2C: if shift: "Z" else: "z"
        0x2D: if shift: "X" else: "x"
        0x2E: if shift: "C" else: "c"
        0x2F: if shift: "V" else: "v"
        0x30: if shift: "B" else: "b"
        0x31: if shift: "N" else: "n"
        0x32: if shift: "M" else: "m"
        0x39: " "
        _: ""

fn ps2_wm_key_name(scancode: i32) -> text:
    val printable = ps2_wm_character(scancode, false)
    if printable != "":
        return printable
    match scancode:
        0x01: "escape"
        0x0E: "backspace"
        0x0F: "tab"
        0x1C: "enter"
        _: ""

fn ps2_wm_scancode_from_canon(code: i64, ch: text) -> i32:
    """Map a canonical key code or character back to a PS/2 Set-1 scancode."""
    match code:
        27: return 0x01
        8: return 0x0E
        9: return 0x0F
        13: return 0x1C
        32: return 0x39
        49: return 0x02
        50: return 0x03
        51: return 0x04
        52: return 0x05
        53: return 0x06
        54: return 0x07
        55: return 0x08
        56: return 0x09
        57: return 0x0A
        48: return 0x0B
        65: return 0x1E
        66: return 0x30
        67: return 0x2E
        68: return 0x20
        69: return 0x12
        70: return 0x21
        71: return 0x22
        72: return 0x23
        73: return 0x17
        74: return 0x24
        75: return 0x25
        76: return 0x26
        77: return 0x32
        78: return 0x31
        79: return 0x18
        80: return 0x19
        81: return 0x10
        82: return 0x13
        83: return 0x1F
        84: return 0x14
        85: return 0x16
        86: return 0x2F
        87: return 0x11
        88: return 0x2D
        89: return 0x15
        90: return 0x2C
        _: pass_dn
    match ch:
        "1": 0x02
        "!": 0x02
        "2": 0x03
        "@": 0x03
        "3": 0x04
        "#": 0x04
        "4": 0x05
        "$": 0x05
        "5": 0x06
        "%": 0x06
        "6": 0x07
        "^": 0x07
        "7": 0x08
        "&": 0x08
        "8": 0x09
        "*": 0x09
        "9": 0x0A
        "(": 0x0A
        "0": 0x0B
        ")": 0x0B
        "q": 0x10
        "Q": 0x10
        "w": 0x11
        "W": 0x11
        "e": 0x12
        "E": 0x12
        "r": 0x13
        "R": 0x13
        "t": 0x14
        "T": 0x14
        "y": 0x15
        "Y": 0x15
        "u": 0x16
        "U": 0x16
        "i": 0x17
        "I": 0x17
        "o": 0x18
        "O": 0x18
        "p": 0x19
        "P": 0x19
        "a": 0x1E
        "A": 0x1E
        "s": 0x1F
        "S": 0x1F
        "d": 0x20
        "D": 0x20
        "f": 0x21
        "F": 0x21
        "g": 0x22
        "G": 0x22
        "h": 0x23
        "H": 0x23
        "j": 0x24
        "J": 0x24
        "k": 0x25
        "K": 0x25
        "l": 0x26
        "L": 0x26
        "z": 0x2C
        "Z": 0x2C
        "x": 0x2D
        "X": 0x2D
        "c": 0x2E
        "C": 0x2E
        "v": 0x2F
        "V": 0x2F
        "b": 0x30
        "B": 0x30
        "n": 0x31
        "N": 0x31
        "m": 0x32
        "M": 0x32
        " ": 0x39
        "\t": 0x0F
        "\n": 0x1C
        "\r": 0x1C
        _: 0
