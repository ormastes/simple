# Shared Simple Web MDI surface definitions for hosted and QEMU WM lanes.

class SharedMdiSurface:
    title: text
    app_id: text
    content: text
    x: i32
    y: i32
    w: i32
    h: i32
    process_id: i64

fn shared_mdi_surfaces() -> [SharedMdiSurface]:
    [
        SharedMdiSurface(title: "Terminal", app_id: "terminal", content: "simple$ build check --live", x: 58, y: 76, w: 236, h: 142, process_id: 101),
        SharedMdiSurface(title: "Editor", app_id: "editor", content: "src/main.spl   real Simple Web text", x: 276, y: 120, w: 256, h: 154, process_id: 102),
        SharedMdiSurface(title: "Browser", app_id: "browser", content: "about:network", x: 150, y: 256, w: 278, h: 150, process_id: 103),
        SharedMdiSurface(title: "File Manager", app_id: "file-manager", content: "home", x: 486, y: 250, w: 238, h: 142, process_id: 104),
        SharedMdiSurface(title: "Calculator", app_id: "calculator", content: "0", x: 642, y: 82, w: 202, h: 138, process_id: 105)
    ]

class Arm64WmSharedMdiEvidence:
    surface_count: i32
    simple_web_surface_count: i32
    backend_kind: text
    fallback_reason: text
    readback_status: text
    renderer_path: text
    first_title: text
    focused_title: text

fn arm64_wm_shared_mdi_evidence(width: i32, height: i32) -> Arm64WmSharedMdiEvidence:
    """Canonical ARM64 QEMU WM shared-MDI evidence contract."""
    val surfaces = shared_mdi_surfaces()
    Arm64WmSharedMdiEvidence(
        surface_count: surfaces.len(),
        simple_web_surface_count: surfaces.len(),
        backend_kind: "qemu-aarch64-hvf-framebuffer-cpu-simd",
        fallback_reason: "",
        readback_status: "qmp-screendump-required",
        renderer_path: "shared_mdi_framebuffer_scene",
        first_title: if surfaces.len() > 0: surfaces[0].title else: "",
        focused_title: if surfaces.len() > 0: surfaces[surfaces.len() - 1].title else: ""
    )

fn shared_mdi_surface_app_id(index: i64) -> text:
    if index == 0: return "terminal"
    if index == 1: return "editor"
    if index == 2: return "browser"
    if index == 3: return "file-manager"
    "calculator"

fn shared_mdi_surface_content(index: i64) -> text:
    if index == 0: return "simple$ build check --live"
    if index == 1: return "src/main.spl   real Simple Web text"
    if index == 2: return "about:network"
    if index == 3: return "home"
    "0"

fn shared_mdi_surface_count() -> i64: 5

fn shared_mdi_surface_height(index: i64) -> i32:
    if index == 0: return 142
    if index == 1: return 154
    if index == 2: return 280
    if index == 3: return 142
    138

fn shared_mdi_surface_process_id(index: i64) -> i64:
    101 + index

fn shared_mdi_surface_title(index: i64) -> text:
    if index == 0: return "Terminal"
    if index == 1: return "Editor"
    if index == 2: return "Browser"
    if index == 3: return "File Manager"
    "Calculator"

fn shared_mdi_surface_width(index: i64) -> i32:
    if index == 0: return 236
    if index == 1: return 256
    if index == 2: return 460
    if index == 3: return 238
    202

fn shared_mdi_surface_x(index: i64) -> i32:
    if index == 0: return 58
    if index == 1: return 276
    if index == 2: return 150
    if index == 3: return 486
    642

fn shared_mdi_surface_y(index: i64) -> i32:
    if index == 0: return 76
    if index == 1: return 120
    if index == 2: return 180
    if index == 3: return 250
    82
