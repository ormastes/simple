# Typed host-frame acknowledgement boundary.
#
# A boolean render result cannot distinguish an accepted asynchronous frame
# from a synchronously presented frame.  The hosted input loop must advance
# event receipts only from Presented evidence.  Pending and Unknown retain
# input ownership until a later poll/retire/presenter-release operation can
# supply the missing provider fact.

enum HostFrameAckState:
    Rejected
    Pending
    Presented
    Skipped
    Unknown

enum HostFrameReceiptKind:
    None
    SynchronousPresent
    AsyncSubmission
    AsyncRetired
    PresenterRelease
    HostBufferPresent

struct HostFrameAckEvidence:
    state: HostFrameAckState
    receipt_kind: HostFrameReceiptKind
    frame_generation: i64
    scene_revision: i64
    compute_complete: bool
    present_complete: bool
    presenter_released: bool
    external_frame_released: bool
    surface_id: i64
    surface_epoch: i64
    device_generation: i64
    provider_generation: i64
    target_width: i32
    target_height: i32
    framebuffer_identity: i64
    device_identity: i64
    swapchain_identity: i64
    host_present_generation: i64
    external_window_ids: [i64]
    external_content_revisions: [i64]
    reason: text

fn host_frame_ack_rejected(reason: text) -> HostFrameAckEvidence:
    HostFrameAckEvidence(
        state: HostFrameAckState.Rejected,
        receipt_kind: HostFrameReceiptKind.None,
        frame_generation: 0,
        scene_revision: 0,
        compute_complete: false,
        present_complete: false,
        presenter_released: false,
        external_frame_released: false,
        surface_id: 0,
        surface_epoch: 0,
        device_generation: 0,
        provider_generation: 0,
        target_width: 0,
        target_height: 0,
        framebuffer_identity: 0,
        device_identity: 0,
        swapchain_identity: 0,
        host_present_generation: 0,
        external_window_ids: [],
        external_content_revisions: [],
        reason: reason
    )

fn host_frame_ack_pending(
    receipt_kind: HostFrameReceiptKind,
    frame_generation: i64,
    scene_revision: i64,
    reason: text
) -> HostFrameAckEvidence:
    HostFrameAckEvidence(
        state: HostFrameAckState.Pending,
        receipt_kind: receipt_kind,
        frame_generation: frame_generation,
        scene_revision: scene_revision,
        compute_complete: false,
        present_complete: false,
        presenter_released: false,
        external_frame_released: false,
        surface_id: 0,
        surface_epoch: 0,
        device_generation: 0,
        provider_generation: 0,
        target_width: 0,
        target_height: 0,
        framebuffer_identity: 0,
        device_identity: 0,
        swapchain_identity: 0,
        host_present_generation: 0,
        external_window_ids: [],
        external_content_revisions: [],
        reason: reason
    )

fn host_frame_ack_unknown(reason: text) -> HostFrameAckEvidence:
    HostFrameAckEvidence(
        state: HostFrameAckState.Unknown,
        receipt_kind: HostFrameReceiptKind.None,
        frame_generation: 0,
        scene_revision: 0,
        compute_complete: false,
        present_complete: false,
        presenter_released: false,
        external_frame_released: false,
        surface_id: 0,
        surface_epoch: 0,
        device_generation: 0,
        provider_generation: 0,
        target_width: 0,
        target_height: 0,
        framebuffer_identity: 0,
        device_identity: 0,
        swapchain_identity: 0,
        host_present_generation: 0,
        external_window_ids: [],
        external_content_revisions: [],
        reason: reason
    )

fn host_frame_ack_skipped(scene_revision: i64) -> HostFrameAckEvidence:
    HostFrameAckEvidence(
        state: HostFrameAckState.Skipped,
        receipt_kind: HostFrameReceiptKind.None,
        frame_generation: 0,
        scene_revision: scene_revision,
        compute_complete: false,
        present_complete: false,
        presenter_released: false,
        external_frame_released: false,
        surface_id: 0,
        surface_epoch: 0,
        device_generation: 0,
        provider_generation: 0,
        target_width: 0,
        target_height: 0,
        framebuffer_identity: 0,
        device_identity: 0,
        swapchain_identity: 0,
        host_present_generation: 0,
        external_window_ids: [],
        external_content_revisions: [],
        reason: "no-damage-no-present"
    )

fn host_frame_ack_presented(
    receipt_kind: HostFrameReceiptKind,
    frame_generation: i64,
    scene_revision: i64,
    external_frame_released: bool,
    reason: text
) -> HostFrameAckEvidence:
    HostFrameAckEvidence(
        state: HostFrameAckState.Presented,
        receipt_kind: receipt_kind,
        frame_generation: frame_generation,
        scene_revision: scene_revision,
        compute_complete: true,
        present_complete: true,
        # A present receipt is not a distinct presenter-release receipt.
        # Exact synchronous receipts may still acknowledge below without
        # manufacturing this stronger future-async fact.
        presenter_released: false,
        external_frame_released: external_frame_released,
        surface_id: 0,
        surface_epoch: 0,
        device_generation: 0,
        provider_generation: 0,
        target_width: 0,
        target_height: 0,
        framebuffer_identity: 0,
        device_identity: 0,
        swapchain_identity: 0,
        host_present_generation: 0,
        external_window_ids: [],
        external_content_revisions: [],
        reason: reason
    )

fn host_frame_ack_exact(
    state: HostFrameAckState,
    receipt_kind: HostFrameReceiptKind,
    frame_generation: i64,
    scene_revision: i64,
    compute_complete: bool,
    present_complete: bool,
    presenter_released: bool,
    external_frame_released: bool,
    surface_id: i64,
    surface_epoch: i64,
    device_generation: i64,
    provider_generation: i64,
    target_width: i32,
    target_height: i32,
    framebuffer_identity: i64,
    device_identity: i64,
    swapchain_identity: i64,
    host_present_generation: i64,
    external_window_ids: [i64],
    external_content_revisions: [i64],
    reason: text
) -> HostFrameAckEvidence:
    HostFrameAckEvidence(
        state: state,
        receipt_kind: receipt_kind,
        frame_generation: frame_generation,
        scene_revision: scene_revision,
        compute_complete: compute_complete,
        present_complete: present_complete,
        presenter_released: presenter_released,
        external_frame_released: external_frame_released,
        surface_id: surface_id,
        surface_epoch: surface_epoch,
        device_generation: device_generation,
        provider_generation: provider_generation,
        target_width: target_width,
        target_height: target_height,
        framebuffer_identity: framebuffer_identity,
        device_identity: device_identity,
        swapchain_identity: swapchain_identity,
        host_present_generation: host_present_generation,
        external_window_ids: external_window_ids,
        external_content_revisions: external_content_revisions,
        reason: reason
    )

fn host_frame_ack_with_external_release(
    evidence: HostFrameAckEvidence
) -> HostFrameAckEvidence:
    host_frame_ack_exact(
        evidence.state, evidence.receipt_kind, evidence.frame_generation,
        evidence.scene_revision, evidence.compute_complete,
        evidence.present_complete, evidence.presenter_released, true,
        evidence.surface_id, evidence.surface_epoch,
        evidence.device_generation, evidence.provider_generation,
        evidence.target_width, evidence.target_height,
        evidence.framebuffer_identity, evidence.device_identity,
        evidence.swapchain_identity, evidence.host_present_generation,
        evidence.external_window_ids, evidence.external_content_revisions,
        evidence.reason
    )

fn host_frame_ack_complete_host_present(
    evidence: HostFrameAckEvidence,
    presenter_identity: i64,
    presenter_width: i32,
    presenter_height: i32,
    prior_present_generation: i64,
    present_generation: i64
) -> HostFrameAckEvidence:
    if (evidence.state != HostFrameAckState.Pending or
        evidence.receipt_kind != HostFrameReceiptKind.HostBufferPresent or
        not evidence.compute_complete or evidence.present_complete or
        evidence.frame_generation != 0 or
        evidence.host_present_generation <= 0 or
        evidence.framebuffer_identity != 0 or evidence.device_identity != 0 or
        evidence.swapchain_identity != 0 or
        presenter_identity <= 0 or
        presenter_width != evidence.target_width or
        presenter_height != evidence.target_height or
        prior_present_generation < 0 or
        present_generation != prior_present_generation + 1):
        return host_frame_ack_unknown("host-present-generation-mismatch")
    host_frame_ack_exact(
        HostFrameAckState.Presented, HostFrameReceiptKind.HostBufferPresent,
        evidence.frame_generation, evidence.scene_revision,
        true, true, true, false,
        evidence.surface_id, evidence.surface_epoch,
        evidence.device_generation, evidence.provider_generation,
        evidence.target_width, evidence.target_height,
        presenter_identity, evidence.device_identity,
        evidence.swapchain_identity, present_generation,
        evidence.external_window_ids, evidence.external_content_revisions,
        "exact-host-buffer-present-receipt"
    )

fn _host_frame_ack_owner_identity_valid(evidence: HostFrameAckEvidence) -> bool:
    if (evidence.surface_id <= 0 or evidence.surface_epoch <= 0 or
        evidence.device_generation <= 0 or evidence.provider_generation <= 0 or
        evidence.target_width <= 0 or evidence.target_height <= 0 or
        evidence.scene_revision <= 0 or
        evidence.external_window_ids.len() !=
            evidence.external_content_revisions.len()):
        return false
    var i = 0
    while i < evidence.external_window_ids.len():
        if (evidence.external_window_ids[i] <= 0 or
            evidence.external_content_revisions[i] <= 0):
            return false
        var j = 0
        while j < i:
            if evidence.external_window_ids[j] == evidence.external_window_ids[i]:
                return false
            j += 1
        i += 1
    true

fn host_frame_ack_can_advance_input(evidence: HostFrameAckEvidence) -> bool:
    if (evidence.state != HostFrameAckState.Presented or
        not evidence.compute_complete or not evidence.present_complete or
        not evidence.external_frame_released or
        not _host_frame_ack_owner_identity_valid(evidence)):
        return false
    if evidence.receipt_kind == HostFrameReceiptKind.SynchronousPresent:
        return (evidence.frame_generation > 0 and
                evidence.framebuffer_identity > 0 and
                evidence.device_identity > 0 and
                evidence.swapchain_identity > 0)
    if evidence.receipt_kind == HostFrameReceiptKind.HostBufferPresent:
        return (evidence.presenter_released and
                evidence.host_present_generation > 0 and
                evidence.framebuffer_identity > 0 and
                evidence.device_identity == 0 and
                evidence.swapchain_identity == 0)
    (evidence.receipt_kind == HostFrameReceiptKind.AsyncRetired or
     evidence.receipt_kind == HostFrameReceiptKind.PresenterRelease) and
    evidence.presenter_released and evidence.frame_generation > 0 and
    evidence.framebuffer_identity > 0 and evidence.device_identity > 0 and
    evidence.swapchain_identity > 0

fn host_frame_ack_present_generation(evidence: HostFrameAckEvidence) -> i64:
    if not host_frame_ack_can_advance_input(evidence):
        return 0
    if evidence.receipt_kind == HostFrameReceiptKind.HostBufferPresent:
        return evidence.host_present_generation
    evidence.frame_generation

export HostFrameAckState, HostFrameReceiptKind, HostFrameAckEvidence
export host_frame_ack_rejected, host_frame_ack_pending
export host_frame_ack_unknown, host_frame_ack_skipped
export host_frame_ack_presented, host_frame_ack_can_advance_input
export host_frame_ack_present_generation
export host_frame_ack_exact, host_frame_ack_with_external_release
export host_frame_ack_complete_host_present
