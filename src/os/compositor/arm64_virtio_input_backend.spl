# Canonical VirtIO input adapter for the compositor.
#
# ARM64 MMIO and RV64 PCI owners inject the same raw-event poll contract. This
# adapter keeps pointer records together until SYN_REPORT, retains keyboard
# press/release edges, and exposes both through the shared InputBackend trait.

use os.compositor.input_backend.{InputBackend}
use os.drivers.input.ps2_keyboard.{Key, KeyEvent}
use os.drivers.input.ps2_mouse.{MouseEvent}
use os.drivers.virtio.virtio_input_ops.{
    BTN_LEFT,
    BTN_MIDDLE,
    BTN_RIGHT,
    EV_KEY,
    EV_REL,
    EV_SYN,
    KEY_LEFTALT,
    KEY_LEFTCTRL,
    KEY_LEFTSHIFT,
    KEY_RIGHTALT,
    KEY_RIGHTCTRL,
    KEY_RIGHTSHIFT,
    KEY_VALUE_RELEASE,
    REL_X,
    REL_Y,
    SYN_REPORT,
    VIRTIO_INPUT_DEVICE_KEYBOARD,
    VIRTIO_INPUT_DEVICE_POINTER,
    VirtioInputEvent,
    VirtioMouseAccum,
    virtio_input_key_event
}
use os.kernel.arch.arm64.virtio_input.{
    arm64_virtio_input_poll
}

# Keep the production packed receipt on the runtime ABI boundary.  Routing the
# packed value through a second Pure-Simple function can retag it on native
# ARM64 before the bit fields are decoded.
extern fn rt_arm64_virtio_input_poll_packed() -> u64

class Arm64VirtioInputBackend:
    poll_event: fn() -> VirtioInputEvent?
    direct_scalar_poll: bool
    mouse: VirtioMouseAccum
    pending_key: KeyEvent?
    pending_mouse: MouseEvent?
    pending_key_sequence: i64
    pending_mouse_sequence: i64
    pending_key_code: i64
    pending_key_value: i64
    pending_key_irq_status: i64
    pending_pointer_type: i64
    pending_pointer_code: i64
    pending_pointer_value: i64
    pending_pointer_rel_x_seen: bool
    pending_pointer_rel_x: i64
    pending_pointer_rel_y_seen: bool
    pending_pointer_rel_y: i64
    pending_pointer_left_edge: bool
    pending_pointer_left_value: i64
    pending_pointer_right_edge: bool
    pending_pointer_right_value: i64
    pending_pointer_middle_edge: bool
    pending_pointer_middle_value: i64
    pending_pointer_irq_status: i64
    pointer_frame_open: bool
    pointer_frame_sequence: i64
    input_sequence: i64
    delivered_key: KeyEvent?
    delivered_key_sequence: i64
    delivered_key_code: i64
    delivered_key_value: i64
    delivered_key_irq_status: i64
    delivered_mouse_sequence: i64
    delivered_pointer_type: i64
    delivered_pointer_code: i64
    delivered_pointer_value: i64
    delivered_pointer_rel_x_seen: bool
    delivered_pointer_rel_x: i64
    delivered_pointer_rel_y_seen: bool
    delivered_pointer_rel_y: i64
    delivered_pointer_left_edge: bool
    delivered_pointer_left_value: i64
    delivered_pointer_right_edge: bool
    delivered_pointer_right_value: i64
    delivered_pointer_middle_edge: bool
    delivered_pointer_middle_value: i64
    delivered_pointer_irq_status: i64
    left_alt: bool
    right_alt: bool
    left_shift: bool
    right_shift: bool
    left_ctrl: bool
    right_ctrl: bool

impl Arm64VirtioInputBackend:
    static fn create(screen_width: i64, screen_height: i64) -> Arm64VirtioInputBackend:
        Arm64VirtioInputBackend.create_with_poller(
            screen_width,
            screen_height,
            arm64_virtio_input_poll,
            true
        )

    static fn create_with_poller(
        screen_width: i64,
        screen_height: i64,
        poll_event: fn() -> VirtioInputEvent?,
        direct_scalar_poll: bool = false
    ) -> Arm64VirtioInputBackend:
        Arm64VirtioInputBackend(
            poll_event: poll_event,
            direct_scalar_poll: direct_scalar_poll,
            mouse: VirtioMouseAccum.create(screen_width, screen_height),
            pending_key: nil,
            pending_mouse: nil,
            pending_key_sequence: 0,
            pending_mouse_sequence: 0,
            pending_key_code: 0,
            pending_key_value: 0,
            pending_key_irq_status: 0,
            pending_pointer_type: 0,
            pending_pointer_code: 0,
            pending_pointer_value: 0,
            pending_pointer_rel_x_seen: false,
            pending_pointer_rel_x: 0,
            pending_pointer_rel_y_seen: false,
            pending_pointer_rel_y: 0,
            pending_pointer_left_edge: false,
            pending_pointer_left_value: 0,
            pending_pointer_right_edge: false,
            pending_pointer_right_value: 0,
            pending_pointer_middle_edge: false,
            pending_pointer_middle_value: 0,
            pending_pointer_irq_status: 0,
            pointer_frame_open: false,
            pointer_frame_sequence: 0,
            input_sequence: 0,
            delivered_key: nil,
            delivered_key_sequence: 0,
            delivered_key_code: 0,
            delivered_key_value: 0,
            delivered_key_irq_status: 0,
            delivered_mouse_sequence: 0,
            delivered_pointer_type: 0,
            delivered_pointer_code: 0,
            delivered_pointer_value: 0,
            delivered_pointer_rel_x_seen: false,
            delivered_pointer_rel_x: 0,
            delivered_pointer_rel_y_seen: false,
            delivered_pointer_rel_y: 0,
            delivered_pointer_left_edge: false,
            delivered_pointer_left_value: 0,
            delivered_pointer_right_edge: false,
            delivered_pointer_right_value: 0,
            delivered_pointer_middle_edge: false,
            delivered_pointer_middle_value: 0,
            delivered_pointer_irq_status: 0,
            left_alt: false,
            right_alt: false,
            left_shift: false,
            right_shift: false,
            left_ctrl: false,
            right_ctrl: false
        )

    me feed_raw_event(
        device_kind: i64,
        type_: i64,
        code: i64,
        value: i64,
        irq_status: i64 = 0
    ) -> bool:
        """Ingest one already-owned raw record without dropping pending edges.

        This method is also the hardware-free test seam. The MMIO poller calls
        it only while neither translated event slot is occupied.
        """
        if self.pending_key != nil or self.pending_mouse != nil:
            return false

        if device_kind == 1:
            if type_ != 1:
                return false
            self.input_sequence = self.input_sequence + 1
            self.pending_key_sequence = self.input_sequence
            self.pending_key_code = code
            self.pending_key_value = value
            self.pending_key_irq_status = irq_status
            val pressed = value != 0
            if code == 56:
                self.left_alt = pressed
            elif code == 100:
                self.right_alt = pressed
            elif code == 42:
                self.left_shift = pressed
            elif code == 54:
                self.right_shift = pressed
            elif code == 29:
                self.left_ctrl = pressed
            elif code == 97:
                self.right_ctrl = pressed
            self.pending_key = virtio_input_key_event(code.to_u16(), value.to_u32())
            return true

        if device_kind != 2:
            return false
        if not self.pointer_frame_open:
            self.input_sequence = self.input_sequence + 1
            self.pointer_frame_sequence = self.input_sequence
            self.pointer_frame_open = true
            self.pending_pointer_rel_x_seen = false
            self.pending_pointer_rel_x = 0
            self.pending_pointer_rel_y_seen = false
            self.pending_pointer_rel_y = 0
            self.pending_pointer_left_edge = false
            self.pending_pointer_left_value = 0
            self.pending_pointer_right_edge = false
            self.pending_pointer_right_value = 0
            self.pending_pointer_middle_edge = false
            self.pending_pointer_middle_value = 0
            self.pending_pointer_irq_status = 0

        self.pending_pointer_type = type_
        self.pending_pointer_code = code
        self.pending_pointer_value = value
        self.pending_pointer_irq_status = self.pending_pointer_irq_status | irq_status
        if type_ == 1 and code >= 272:
            if code == 272:
                self.pending_pointer_left_edge = true
                self.pending_pointer_left_value = value
            elif code == 273:
                self.pending_pointer_right_edge = true
                self.pending_pointer_right_value = value
            elif code == 274:
                self.pending_pointer_middle_edge = true
                self.pending_pointer_middle_value = value
            self.mouse.feed_key_i64(code, value != 0)
        elif type_ == 2:
            if code == 0:
                self.pending_pointer_rel_x_seen = true
                self.pending_pointer_rel_x = self.pending_pointer_rel_x + value.to_i32().to_i64()
            elif code == 1:
                self.pending_pointer_rel_y_seen = true
                self.pending_pointer_rel_y = self.pending_pointer_rel_y + value.to_i32().to_i64()
            self.mouse.feed_rel_i64(code, value.to_i32().to_i64())
        elif type_ == 0 and code == 0:
            self.pending_mouse = self.mouse.feed_syn()
            self.pending_mouse_sequence = self.pointer_frame_sequence
            self.pointer_frame_open = false
        true

    me _pump_one() -> bool:
        if self.direct_scalar_poll:
            val packed: u64 = rt_arm64_virtio_input_poll_packed()
            if packed == 0u64:
                return false
            val device_kind: i64 = ((packed >> 56u64) & 0x3u64).to_i64()
            val event_type: i64 = ((packed >> 48u64) & 0xffu64).to_i64()
            val event_code: i64 = ((packed >> 32u64) & 0xffffu64).to_i64()
            val event_value: i64 = (packed & 0xffffffffu64).to_i64()
            return self.feed_raw_event(
                device_kind, event_type, event_code, event_value, 0)
        val raw_event = self.poll_event()
        if val event = raw_event:
            return self.feed_raw_event(
                event.device_kind.to_i64(),
                event.type_.to_i64(),
                event.code.to_i64(),
                event.value.to_i64(),
                event.irq_status.to_i64()
            )
        false

    me _pump_until_pending():
        var budget = 64
        while budget > 0 and self.pending_key == nil and self.pending_mouse == nil:
            budget = budget - 1
            if not self._pump_one():
                return

impl InputBackend for Arm64VirtioInputBackend:
    me poll_key() -> KeyEvent?:
        if self.pending_key == nil and self.pending_mouse == nil:
            self._pump_until_pending()
        if val event = self.pending_key:
            self.pending_key = nil
            self.delivered_key = event
            self.delivered_key_sequence = self.pending_key_sequence
            self.delivered_key_code = self.pending_key_code
            self.delivered_key_value = self.pending_key_value
            self.delivered_key_irq_status = self.pending_key_irq_status
            return event
        nil

    me poll_mouse() -> MouseEvent?:
        if self.pending_key == nil and self.pending_mouse == nil:
            self._pump_until_pending()
        if val event = self.pending_mouse:
            self.pending_mouse = nil
            self.delivered_mouse_sequence = self.pending_mouse_sequence
            self.delivered_pointer_type = self.pending_pointer_type
            self.delivered_pointer_code = self.pending_pointer_code
            self.delivered_pointer_value = self.pending_pointer_value
            self.delivered_pointer_rel_x_seen = self.pending_pointer_rel_x_seen
            self.delivered_pointer_rel_x = self.pending_pointer_rel_x
            self.delivered_pointer_rel_y_seen = self.pending_pointer_rel_y_seen
            self.delivered_pointer_rel_y = self.pending_pointer_rel_y
            self.delivered_pointer_left_edge = self.pending_pointer_left_edge
            self.delivered_pointer_left_value = self.pending_pointer_left_value
            self.delivered_pointer_right_edge = self.pending_pointer_right_edge
            self.delivered_pointer_right_value = self.pending_pointer_right_value
            self.delivered_pointer_middle_edge = self.pending_pointer_middle_edge
            self.delivered_pointer_middle_value = self.pending_pointer_middle_value
            self.delivered_pointer_irq_status = self.pending_pointer_irq_status
            return event
        nil

    fn alt_held() -> bool:
        self.left_alt or self.right_alt

    fn shift_held() -> bool:
        self.left_shift or self.right_shift

    fn ctrl_held() -> bool:
        self.left_ctrl or self.right_ctrl

    fn key_to_char(key: Key) -> text?:
        match key:
            Key.Tab: "\t"
            Key.Num1: "1"
            Key.Num2: "2"
            Key.Num3: "3"
            Key.Num4: "4"
            Key.Num5: "5"
            Key.Num6: "6"
            Key.Num7: "7"
            Key.Num8: "8"
            Key.Num9: "9"
            Key.Q: "q"
            Key.M: "m"
            Key.W: "w"
            Key.R: "r"
            Key.T: "t"
            _: nil

type VirtioInputBackend = Arm64VirtioInputBackend
