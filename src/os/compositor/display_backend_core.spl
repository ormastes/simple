trait CompositorGlassCapable:
    me blend_rect(x: i32, y: i32, w: i32, h: i32, color: u32, alpha: u8)
    me blur_region(x: i32, y: i32, w: i32, h: i32, radius: u32)
    me gradient_v(x: i32, y: i32, w: i32, h: i32, color_top: u32, color_bottom: u32)
    fn read_pixel(x: i32, y: i32) -> u32

trait CompositorBackend:
    fn width() -> i32
    fn height() -> i32
    me clear(color: u32)
    me fill_rect(x: i32, y: i32, w: i32, h: i32, color: u32)
    me draw_text(x: i32, y: i32, text_str: text, fg: u32, bg: u32)
    me draw_char_8x16(x: i32, y: i32, ch: u8, fg: u32, bg: u32)
    me put_pixel(x: i32, y: i32, color: u32)
    me blit_pixels(x: i32, y: i32, w: i32, h: i32, pixels: [u32])
    me present()
    me present_rect(x: i32, y: i32, w: i32, h: i32)
    fn as_glass_capable() -> CompositorGlassCapable?
    # Explicit damage-reporting contract (see
    # `doc/03_plan/os/simpleos/screens/ws_d3_damage_present_investigation.md`
    # §9): `get_pixel_buffer()` returns a live alias to the backend's own
    # mirror, mutated in place by callers (glass_dispatch.spl,
    # text_render.spl). Damage tracking cannot safely infer what changed by
    # diffing the aliased buffer, so each mutator reports the region it just
    # touched instead. Backends with no damage consumer implement this as a
    # no-op; only `Engine2dCompositorBackend` records it today.
    me report_damage(x: i32, y: i32, w: i32, h: i32)

