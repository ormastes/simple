val HOST_WM_IDLE_SLEEP_MS: i32 = 16
# Ceiling on how many windows may simultaneously own a top-level external
# content-frame slot. The slot arrays are plain dynamic arrays (pushed, not
# preallocated), so this is NOT a fixed-buffer or ABI limit — it exists purely
# as a guard against unbounded slot growth driven by content clients. Actual
# memory is bounded independently and per-set by
# HOST_EXTERNAL_WEB_FRAME_MAX_PIXELS against the aggregate of every slot, so
# raising this count does not widen the memory envelope.
#
# Sized to match the sibling child-frame ceiling below. It was 4, which was
# silently one short of the 5 windows `wm_showcase_window_specs()` declares
# once 81f11d167d1 grew that list 3->5; the 5th window was refused a slot and
# never composited. Keep real headroom above any declared window set so the
# next added window does not reintroduce that.
# See doc/08_tracking/bug/wm_showcase_2d_window_refused_external_frame_slot_2026-08-06.md
val HOST_EXTERNAL_WEB_FRAME_MAX_COUNT: i64 = 32
val HOST_EXTERNAL_CHILD_FRAME_MAX_COUNT: i64 = 32
# One 8K UHD frame is 33,177,600 pixels. The aggregate guard remains the
# authoritative bound across slots, preventing unbounded retained frames.
val HOST_EXTERNAL_WEB_FRAME_MAX_PIXELS: i64 = 33554432
val HOST_WM_MAX_FRAMEBUFFER_PIXELS: i64 = 67108864

# When true, render_frame_engine2d() rejects the canonical Draw IR lane so the
# caller can select the historical byte-identical direct compatibility renderer.
var _host_chrome_force_direct: bool = false

fn host_wm_force_direct_chrome(enabled: bool):
    """Pin (or release) the direct-draw chrome path for render_frame()."""
    _host_chrome_force_direct = enabled

fn host_wm_chrome_force_direct() -> bool:
    """True when render_frame() is pinned to the direct-draw chrome path."""
    _host_chrome_force_direct

# A requested host target can carry different semantic material than the
# canonical local CPU target. Recompose only after the requested composition
# has failed; CPU is already the local contract and must not be attempted twice.
fn host_wm_draw_ir_local_recompose_required(selected_backend: text) -> bool:
    selected_backend != DRAW_IR_BACKEND_CPU

# Validate Metal material evidence against the submitted Draw IR itself.
# Executor counters are cross-checks only: this owner independently derives the
# exact ordered material IDs and rejects duplicate producer IDs or any receipt
# insertion, omission, duplication, or reorder.
fn host_metal_glass_receipts_valid(
    composition: DrawIrComposition, result: Engine2dDrawIrAdvResult
) -> bool:
    if composition.backend_target != "metal":
        return true
    var expected_ids: [text] = []
    for batch in composition.batches:
        for command in batch.commands:
            if command.? == false:
                continue
            var requested = false
            for prop in command.computed_style:
                if (prop.key == "wm-material-request" and
                    prop.value == "window-surface-glass"):
                    requested = true
            if requested:
                if command.component_id == "":
                    return false
                for expected_id in expected_ids:
                    if expected_id == command.component_id:
                        return false
                expected_ids.push(command.component_id)

    val expected_count = expected_ids.len().to_i32()
    if (result.metal_device_glass_requested_count != expected_count or
        result.metal_device_glass_material_count != expected_count or
        result.metal_device_glass_unfulfilled_count != 0 or
        result.metal_device_glass_receipts.len() != expected_ids.len()):
        return false
    if expected_ids.len() == 0:
        return true
    if (result.readback_source != "device_readback" or
        result.backend_handle <= 0 or result.device_identity <= 0):
        return false

    var index = 0
    while index < expected_ids.len():
        val receipt = result.metal_device_glass_receipts[index]
        if (receipt.material_id != expected_ids[index] or
            not receipt.fulfilled or
            receipt.execution_target != "metal-device-glass-v1" or
            receipt.backend_handle <= 0 or
            receipt.device_identity <= 0 or
            receipt.backend_handle != result.backend_handle or
            receipt.device_identity != result.device_identity or
            receipt.readback_source != result.readback_source or
            receipt.readback_checksum != result.readback_checksum):
            return false
        index = index + 1
    true

fn host_wm_draw_ir_result_valid(
    composition: DrawIrComposition, result: Engine2dDrawIrAdvResult,
    expected_pixel_count: i32
) -> bool:
    host_metal_glass_receipts_valid(composition, result) and
    not result.fallback_required and
    result.skipped_command_count == 0 and
    result.rendered_command_count > 0 and
    result.pixels.len() == expected_pixel_count

enum HostBackendKind:
    Browser
    WebCanvas
    Electron
    Tauri
    Tui
    Sdl2
    Cocoa
    Win32
    Headless

enum HostDisplayMode:
    Windowed
    BorderlessFullscreen

enum HostDisplayTransitionPhase:
    Idle
    Requested
    AwaitingResize
    Applied
    Failed

struct HostSurfaceGeometry:
    x: i32
    y: i32
    width: i32
    height: i32
    scale_milli: i32

struct HostSurfaceState:
    mode: HostDisplayMode
    phase: HostDisplayTransitionPhase
    requested_mode: HostDisplayMode
    geometry: HostSurfaceGeometry
    saved_windowed_geometry: HostSurfaceGeometry
    rollback_geometry: HostSurfaceGeometry
    request_nonce: i64
    transition_revision: i64
    deadline_micros: i64
    resize_acknowledged: bool
    scale_acknowledged: bool
    failure_reason: text

struct HostDisplayTransition:
    state: HostSurfaceState
    accepted: bool
    mode_request_required: bool
    rolled_back: bool

val HOST_DISPLAY_TRANSITION_TIMEOUT_MICROS: i64 = 2000000

fn host_surface_geometry(x: i32, y: i32, width: i32, height: i32, scale_milli: i32) -> HostSurfaceGeometry:
    HostSurfaceGeometry(x: x, y: y, width: width, height: height, scale_milli: scale_milli)

fn host_surface_state(initial_geometry: HostSurfaceGeometry) -> HostSurfaceState:
    HostSurfaceState(
        mode: HostDisplayMode.Windowed,
        phase: HostDisplayTransitionPhase.Idle,
        requested_mode: HostDisplayMode.Windowed,
        geometry: initial_geometry,
        saved_windowed_geometry: initial_geometry,
        rollback_geometry: initial_geometry,
        request_nonce: 0,
        transition_revision: 0,
        deadline_micros: 0,
        resize_acknowledged: false,
        scale_acknowledged: false,
        failure_reason: ""
    )

fn _host_display_transition(state: HostSurfaceState, accepted: bool, mode_request_required: bool, rolled_back: bool) -> HostDisplayTransition:
    HostDisplayTransition(state: state, accepted: accepted, mode_request_required: mode_request_required, rolled_back: rolled_back)

fn request_display_mode(state: HostSurfaceState, mode: HostDisplayMode, nonce: i64, now_micros: i64) -> HostDisplayTransition:
    if nonce <= 0:
        return _host_display_transition(state, false, false, false)
    if state.phase == HostDisplayTransitionPhase.Requested or state.phase == HostDisplayTransitionPhase.AwaitingResize:
        val coalesced = state.request_nonce == nonce and state.requested_mode == mode
        return _host_display_transition(state, coalesced, false, false)
    if nonce <= state.request_nonce or mode == state.mode:
        return _host_display_transition(state, false, false, false)
    var out = state
    out.requested_mode = mode
    out.rollback_geometry = state.geometry
    if state.mode == HostDisplayMode.Windowed:
        out.saved_windowed_geometry = state.geometry
    out.phase = HostDisplayTransitionPhase.Requested
    out.request_nonce = nonce
    out.transition_revision = state.transition_revision + 1
    out.deadline_micros = now_micros + HOST_DISPLAY_TRANSITION_TIMEOUT_MICROS
    out.resize_acknowledged = false
    out.scale_acknowledged = false
    out.failure_reason = ""
    _host_display_transition(out, true, true, false)

fn _ack_surface_parts(state: HostSurfaceState, nonce: i64, geometry: HostSurfaceGeometry, resize_acknowledged: bool, scale_acknowledged: bool, now_micros: i64) -> HostDisplayTransition:
    if nonce != state.request_nonce or (state.phase != HostDisplayTransitionPhase.Requested and state.phase != HostDisplayTransitionPhase.AwaitingResize):
        return _host_display_transition(state, false, false, false)
    if now_micros > state.deadline_micros:
        return fail_or_timeout_display_transition(state, nonce, "display transition timed out", now_micros)
    var out = state
    if resize_acknowledged:
        if geometry.width <= 0 or geometry.height <= 0:
            return _host_display_transition(state, false, false, false)
        out.geometry.x = geometry.x
        out.geometry.y = geometry.y
        out.geometry.width = geometry.width
        out.geometry.height = geometry.height
        out.resize_acknowledged = true
    if scale_acknowledged:
        if geometry.scale_milli <= 0:
            return _host_display_transition(state, false, false, false)
        out.geometry.scale_milli = geometry.scale_milli
        out.scale_acknowledged = true
    if out.resize_acknowledged and out.scale_acknowledged:
        out.mode = out.requested_mode
        out.phase = HostDisplayTransitionPhase.Applied
        out.deadline_micros = 0
    else:
        out.phase = HostDisplayTransitionPhase.AwaitingResize
    out.transition_revision = state.transition_revision + 1
    _host_display_transition(out, true, false, false)

fn ack_surface_resize(state: HostSurfaceState, nonce: i64, geometry: HostSurfaceGeometry, now_micros: i64) -> HostDisplayTransition:
    _ack_surface_parts(state, nonce, geometry, true, false, now_micros)

fn ack_surface_scale(state: HostSurfaceState, nonce: i64, scale_milli: i32, now_micros: i64) -> HostDisplayTransition:
    val geometry = host_surface_geometry(state.geometry.x, state.geometry.y, state.geometry.width, state.geometry.height, scale_milli)
    _ack_surface_parts(state, nonce, geometry, false, true, now_micros)

fn ack_surface_event(state: HostSurfaceState, nonce: i64, geometry: HostSurfaceGeometry, now_micros: i64) -> HostDisplayTransition:
    _ack_surface_parts(state, nonce, geometry, true, true, now_micros)

fn fail_or_timeout_display_transition(state: HostSurfaceState, nonce: i64, reason: text, now_micros: i64) -> HostDisplayTransition:
    if nonce != state.request_nonce or (state.phase != HostDisplayTransitionPhase.Requested and state.phase != HostDisplayTransitionPhase.AwaitingResize):
        return _host_display_transition(state, false, false, false)
    if reason.len() == 0 and now_micros <= state.deadline_micros:
        return _host_display_transition(state, false, false, false)
    var out = state
    out.geometry = state.rollback_geometry
    out.requested_mode = state.mode
    out.phase = HostDisplayTransitionPhase.Failed
    out.deadline_micros = 0
    out.resize_acknowledged = false
    out.scale_acknowledged = false
    out.failure_reason = if reason.len() > 0: reason else: "display transition timed out"
    out.transition_revision = state.transition_revision + 1
    _host_display_transition(out, true, false, true)

class HostWmConfig:
    backend: HostBackendKind
    initial_size: Size
    title: text

class HostWmAppProcess:
    title: text
    app_id: text
    source_path: text
    pid: i64
    failed: bool

class HostedWindow:
    id: i64
    owner_port: i64
    title: text
    x: i32
    y: i32
    w: i32
    h: i32
    content: text
    process_id: i64
    app_id: text
    content_owner: i32 = HOST_CONTENT_OWNER_LOCAL_WEB
    minimized: bool
    focused: bool
    maximized: bool = false
    restore_x: i32 = 0
    restore_y: i32 = 0
    restore_w: i32 = 0
    restore_h: i32 = 0
    # Click-through ("pointer-events: none") sub-region, in window-local
    # content coordinates (relative to the content origin the router already
    # computes in update_client_target/update_captured_target). w == 0 or
    # h == 0 means "no dead region" (the default). See
    # doc/08_tracking/bug/wm_hit_test_pointer_events_missing_2026-08.md.
    passthrough_x: i32 = 0
    passthrough_y: i32 = 0
    passthrough_w: i32 = 0
    passthrough_h: i32 = 0

struct HostedWebContentTarget:
    window_id: i64
    body_html: text
    local_x: i32
    local_y: i32
    width: i32
    height: i32

struct HostedBrowserChromeTarget:
    window_id: i64
    control: text

fn _host_empty_external_web_frame() -> WmContentFrame:
    WmContentFrame(
        window_id: "",
        scene_revision: 0,
        content_revision: 0,
        origin_kind: "",
        width: 0,
        height: 0,
        pixels: [],
        checksum: 0u64,
        parent_window_id: "",
        offset_x: 0,
        offset_y: 0
    )

fn _host_wm_content_checksum_raw(pixels: [u32]) -> u64:
    var checksum = 0x9E3779B97F4A7C15u64
    var i = 0
    while i < pixels.len():
        checksum = checksum ^ (
            pixels[i].to_u64() + (i + 1).to_u64() * 0x100000001B3u64)
        i += 1
    checksum

fn _host_copy_wm_content_pixels(pixels: [u32]) -> [u32]:
    var copied: [u32] = []
    for pixel in pixels:
        copied.push(pixel)
    copied

fn host_taskbar_clock_label(now_micros: i64) -> text:
    """Return a stable UTC HH:MM label from the host wall clock."""
    val seconds = (now_micros / 1000000) % 86400
    val hour = seconds / 3600
    val minute = (seconds % 3600) / 60
    val hour_text = if hour < 10: "0{hour}" else: "{hour}"
    val minute_text = if minute < 10: "0{minute}" else: "{minute}"
    "{hour_text}:{minute_text}"

fn _host_evidence_json_text(value: text) -> text:
    # Hoisted local is REQUIRED: stage3 native builds emit an interpolation
    # containing escaped string literals as literal source text (see
    # hosted_wm_evidence._json_text for the live-proven failure).
    val escaped_slashes = value.replace("\\", "\\\\")
    val escaped_quotes = escaped_slashes.replace("\"", "\\\"")
    val escaped_newlines = escaped_quotes.replace("\n", "\\n")
    "\"{escaped_newlines}\""

fn host_compositor_taskbar_model(comp: HostCompositor) -> TaskbarModel:
    """Project authoritative host process and window state into shell objects.

    Thin delegating wrapper kept for existing import sites; the body lives in
    HostCompositor.taskbar_model() because stage3 native codegen corrupts the
    windows array elements when the full HostCompositor aggregate crosses this
    free-function boundary by value (nil-receiver trap on window.focused)."""
    comp.taskbar_model()

fn host_window_to_shared_mdi_render_window(win: HostedWindow, scroll_y: i32) -> SharedMdiRenderWindow:
    shared_mdi_render_window(
        win.id,
        win.title,
        win.app_id,
        win.content,
        win.x,
        win.y,
        win.w,
        win.h,
        win.process_id,
        win.minimized,
        win.focused,
        scroll_y
    )

class HeadlessHostCompositorBackend:
    w: i32
    h: i32
    pixels: [u32]
    present_count: i64

    static fn new(width: i32, height: i32) -> HeadlessHostCompositorBackend:
        val total = if width > 0 and height > 0: width * height else: 0
        var pixels: [u32] = []
        var i = 0
        while i < total:
            pixels.push(0u32)
            i = i + 1
        HeadlessHostCompositorBackend(
            w: width,
            h: height,
            pixels: pixels,
            present_count: 0
        )

fn headless_host_compositor_pixels(backend: HeadlessHostCompositorBackend) -> [u32]:
    backend.pixels

fn headless_host_compositor_resize(backend: HeadlessHostCompositorBackend, width: i32, height: i32):
    if width <= 0 or height <= 0 or (backend.w == width and backend.h == height):
        return
    backend.w = width
    backend.h = height
    backend.pixels = [0u32; width * height]

impl CompositorBackend for HeadlessHostCompositorBackend:

    fn width() -> i32:
        self.w

    fn height() -> i32:
        self.h

    me clear(color: u32):
        var i = 0
        while i < self.pixels.len():
            self.pixels[i] = color
            i = i + 1

    me fill_rect(x: i32, y: i32, w: i32, h: i32, color: u32):
        # Writes stay inline in this leaf method: delegating per pixel to
        # self.put_pixel (a me->me call) deep-clones the whole framebuffer on
        # EVERY write under the interpreter (~28ms/px at 1024x768) — see
        # doc/08_tracking/bug/interp_compositor_backend_put_pixel_clones_framebuffer_2026-07-03.md.
        # Bounds are clamped once up front instead of per pixel.
        var x0 = if x < 0: 0 else: x
        var y0 = if y < 0: 0 else: y
        var x1 = x + w
        var y1 = y + h
        if x1 > self.w:
            x1 = self.w
        if y1 > self.h:
            y1 = self.h
        var yy = y0
        while yy < y1:
            var idx = yy * self.w + x0
            var xx = x0
            while xx < x1:
                self.pixels[idx] = color
                idx = idx + 1
                xx = xx + 1
            yy = yy + 1

    me draw_text(x: i32, y: i32, text_str: text, fg: u32, bg: u32):
        var cx = x
        for ch in text_str:
            val glyph = get_glyph_8x16(ch.char_code_at(0).to_u8())
            var row = 0
            while row < 16:
                val bits = glyph[row]
                var col = 0
                while col < 8:
                    val px = cx + col
                    val py = y + row
                    if px >= 0 and py >= 0 and px < self.w and py < self.h:
                        val mask = (0x80 >> col).to_u8()
                        self.pixels[py * self.w + px] = if (bits & mask) != 0u8: fg else: bg
                    col = col + 1
                row = row + 1
            cx = cx + 8

    me draw_char_8x16(x: i32, y: i32, ch: u8, fg: u32, bg: u32):
        val glyph = get_glyph_8x16(ch)
        var row = 0
        while row < 16:
            val bits = glyph[row]
            var col = 0
            while col < 8:
                val px = x + col
                val py = y + row
                if px >= 0 and py >= 0 and px < self.w and py < self.h:
                    val mask = (0x80 >> col).to_u8()
                    self.pixels[py * self.w + px] = if (bits & mask) != 0u8: fg else: bg
                col = col + 1
            row = row + 1

    me put_pixel(x: i32, y: i32, color: u32):
        if x < 0 or y < 0 or x >= self.w or y >= self.h:
            return
        val idx = y * self.w + x
        if idx >= 0 and idx < self.pixels.len():
            self.pixels[idx] = color

    me blit_pixels(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        # Inline writes with once-up-front clamping — same me->me put_pixel
        # framebuffer-clone hazard as fill_rect (see comment there).
        val src_len = pixels.len() as i32
        var row: i32 = 0
        while row < h:
            val dy = y + row
            if dy >= 0 and dy < self.h:
                var col0 = if x < 0: 0 - x else: 0
                var col1 = w
                if x + col1 > self.w:
                    col1 = self.w - x
                var col = col0
                var src_idx = row * w + col0
                var dst_idx = dy * self.w + x + col0
                while col < col1:
                    if src_idx >= 0 and src_idx < src_len:
                        self.pixels[dst_idx] = pixels[src_idx]
                    src_idx = src_idx + 1
                    dst_idx = dst_idx + 1
                    col = col + 1
            row = row + 1

    me present():
        self.present_count = self.present_count + 1

    me present_rect(x: i32, y: i32, w: i32, h: i32):
        self.present_count = self.present_count + 1


    me report_damage(x: i32, y: i32, w: i32, h: i32):
        pass_dn
    fn as_glass_capable() -> CompositorGlassCapable?:
        nil

class HostCompositor:
    backend: CompositorBackend
    headless_backend: HeadlessHostCompositorBackend?
    # NON-Optional on purpose: stage3 native codegen returns a NIL payload
    # from Optional-class-field unwrap (LLDB-proven: self==0 entering
    # _px_clear via self.pixel_backend.unwrap()), which also fabricated the
    # null trait vtable seen one slice earlier. The field is always
    # constructed (0x0 when unused) and gated by native_pixel_lane.
    pixel_backend: SharedWmPixelBufferBackend
    native_pixel_lane: bool
    native_cache_window_ids: [i64]
    native_content_caches: [WebRenderPixelArtifactCache]
    width: i32
    height: i32
    windows: [HostedWindow]
    next_window_id: i64
    app_processes: [HostWmAppProcess]
    pinned_apps: [AppRef]
    dragging: bool
    drag_window_id: i64
    drag_offset_x: i32
    drag_offset_y: i32
    resizing: bool
    resize_window_id: i64
    resize_start_x: i32
    resize_start_y: i32
    resize_start_w: i32
    resize_start_h: i32
    pointer_x: i32
    pointer_y: i32
    # Last raw button code/state routed through handle_mouse_button (0=left,
    # 1=middle, 2=right). Left keeps its full chrome semantics via
    # handle_left_button; middle/right have no chrome action yet, so this is
    # the observable evidence that the event reached the compositor instead of
    # being silently dropped at the winit-dispatch layer.
    last_button: i64
    last_button_down: bool
    # Wheel-delta accumulator per hosted window id, keyed by whichever window
    # is under the pointer when a wheel event arrives. render_frame() reads
    # this back via scroll_offset_for(window.id) and threads it into
    # simple_web_content_frame_cached(), which translates the content
    # layer by that many pixels at paint time (renders `scroll_y` extra rows
    # of the same document, then windows the visible slice — see
    # os.compositor.simple_web_window_renderer._window_scrolled_pixels).
    scroll_offsets: Dict<i64, f64>
    # Chrome-action arming for release-inside click semantics (FIX 2): a
    # mouse-down over a chrome affordance (close button / taskbar item) arms
    # a target instead of firing immediately; the action only fires on
    # mouse-up if the release hit-test still resolves to the same target.
    armed_chrome_target: text
    armed_chrome_window_id: i64
    armed_chrome_app_id: text
    pending_taskbar_launch_app_id: text
    # Cache for the CSS/GUI-web chrome render lane (see render_frame). The key
    # is host_chrome_scene_fingerprint(); the pixels are the last full-scene
    # chrome rasterization. Empty key means "no cached chrome yet".
    _chrome_cache_key: text
    _chrome_cache_pixels: [u32]
    # Task #15 remainder item 4 (S1 perf): per-window content pixel cache.
    # Keyed by hosted window id so each window's cache tracks its own
    # (width, height, backend) identity independently — see
    # _content_cache_for, which replaces a window's cache whenever that
    # identity changes (resize/rescroll/backend change) and otherwise reuses
    # it so WebRenderPixelArtifactCache's own content-hash (HTML-equality)
    # check can skip re-rendering unchanged window content every frame.
    content_caches: Dict<i64, WebRenderPixelArtifactCache>
    # A browser window marked external never re-enters the in-process HTML
    # renderer. The broker supplies one validated sandbox-worker frame; an
    # absent, stale, or malformed frame is left invalid so presentation fails
    # closed at the existing content-frame gate.
    external_web_window_ids: [i64]
    external_web_frames: [WmContentFrame]
    external_child_frames: [WmContentFrame]
    # GUI-session content registry: hosted parity with the baremetal
    # compositor's dispatch_gui_* lane (os.compositor.compositor). A window
    # whose content is a widget session attaches its UITree here; input
    # dispatch reconstructs a UISession per event and stores the mutated
    # tree + focused widget back, mirroring compositor.spl semantics
    # (focus gating, client-area translation, pointer capture).
    gui_content_window_ids: [i64]
    gui_content_trees: [UITree]
    gui_content_focused_ids: [text]
    gui_pointer_capture_window_id: i64
    # Scene background this compositor resolves at render time (color/image/
    # motion, see common.ui.window_scene.BackgroundSpec). Defaults to a plain
    # color matching the historical hardcoded compositor_bg fill so a
    # compositor that never calls set_background renders byte-identically to
    # before this field existed; see _resolve_background, which re-reads the
    # LIVE theme.compositor_bg for the color kind on every call instead of
    # trusting this stored default (the theme can change after construction).
    background: BackgroundSpec
    render_revision: i64
    # I-item-4 damage tracking: accumulates dirty rects across window
    # create/destroy/move/resize/content-update/focus-change so render_frame
    # can skip a full recomposite when nothing changed since the last
    # present. ponytail: full recomposite on any damage; partial/rect-level
    # recomposition is deferred until profiling demands it (see render_frame).
    dirty: DirtyRegion
    skipped_frame_count: i64

    static fn new(backend: CompositorBackend, size: Size) -> HostCompositor:
        var comp = HostCompositor(
            backend: backend,
            headless_backend: nil,
            pixel_backend: SharedWmPixelBufferBackend.new(0, 0),
            native_pixel_lane: false,
            native_cache_window_ids: [],
            native_content_caches: [],
            width: size.width as i32,
            height: size.height as i32,
            windows: [],
            next_window_id: 1,
            app_processes: [],
            pinned_apps: [],
            dragging: false,
            drag_window_id: 0,
            drag_offset_x: 0,
            drag_offset_y: 0,
            resizing: false,
            resize_window_id: 0,
            resize_start_x: 0,
            resize_start_y: 0,
            resize_start_w: 0,
            resize_start_h: 0,
            pointer_x: 0,
            pointer_y: 0,
            last_button: -1,
            last_button_down: false,
            scroll_offsets: {},
            armed_chrome_target: "",
            armed_chrome_window_id: 0,
            armed_chrome_app_id: "",
            pending_taskbar_launch_app_id: "",
            _chrome_cache_key: "",
            _chrome_cache_pixels: [],
            content_caches: {},
            external_web_window_ids: [],
            external_web_frames: [],
            external_child_frames: [],
            gui_content_window_ids: [],
            gui_content_trees: [],
            gui_content_focused_ids: [],
            gui_pointer_capture_window_id: 0,
            background: shared_wm_background_color(wm_chrome_theme().compositor_bg),
            render_revision: 0,
            dirty: DirtyRegion.new(),
            skipped_frame_count: 0
        )
        # Seed full-screen damage so the very first render_frame() call always
        # renders even though nothing has "changed" from an empty prior state.
        comp.dirty.add_full_screen(comp.width, comp.height)
        comp

    fn _external_web_frame_index(window_id: i64) -> i32:
        var i = 0
        while i < self.external_web_window_ids.len():
            if self.external_web_window_ids[i] == window_id:
                return i
            i = i + 1
        -1

    fn is_browser_window(window_id: i64) -> bool:
        val index = self._find_window_index(window_id)
        index >= 0 and self.windows[index].app_id == "browser"

    fn requires_external_web_frame(window_id: i64) -> bool:
        val index = self._find_window_index(window_id)
        index >= 0 and host_content_owner_requires_browser_renderer(
            self.windows[index].content_owner
        )

    me _drop_external_web_frame(window_id: i64) -> bool:
        val drop_index = self._external_web_frame_index(window_id)
        if drop_index < 0:
            return false
        var kept_ids: [i64] = []
        var kept_frames: [WmContentFrame] = []
        var i = 0
        while i < self.external_web_window_ids.len():
            if i != drop_index:
                kept_ids.push(self.external_web_window_ids[i])
                kept_frames.push(self.external_web_frames[i])
            i = i + 1
        self.external_web_window_ids = kept_ids
        self.external_web_frames = kept_frames
        true

    me _drop_window_render_state(window_id: i64):
        self._drop_external_web_frame(window_id)
        self._drop_external_child_frames_for_parent(
            ui_native_i64_text(window_id)
        )
        self.scroll_offsets.remove(window_id)
        self.content_caches.remove(window_id)
        self._cancel_window_interaction(window_id)
        self._release_gui_content(window_id)
        var native_index = 0
        while native_index < self.native_cache_window_ids.len():
            if self.native_cache_window_ids[native_index] == window_id:
                self.native_cache_window_ids.remove(native_index)
                self.native_content_caches.remove(native_index)
                return
            native_index = native_index + 1

    me _cancel_window_interaction(window_id: i64):
        if self.drag_window_id == window_id:
            self.dragging = false
            self.drag_window_id = 0
        if self.resize_window_id == window_id:
            self.resizing = false
            self.resize_window_id = 0
        if self.armed_chrome_window_id == window_id:
            self.armed_chrome_target = ""
            self.armed_chrome_window_id = 0
            self.armed_chrome_app_id = ""

    me _drop_external_child_frames_for_parent(parent_id: text):
        var removed_parent_ids: [text] = [parent_id]
        var scan_parent = 0
        while scan_parent < removed_parent_ids.len():
            val removed_parent = removed_parent_ids[scan_parent]
            var kept: [WmContentFrame] = []
            var i = 0
            while i < self.external_child_frames.len():
                val child = self.external_child_frames[i]
                if child.parent_window_id == removed_parent:
                    removed_parent_ids.push(child.window_id)
                else:
                    kept.push(child)
                i = i + 1
            self.external_child_frames = kept
            scan_parent = scan_parent + 1

    me require_external_web_frame(window_id: i64) -> bool:
        if window_id <= 0 or self._find_window_index(window_id) < 0:
            return false
        val frame_index = self._external_web_frame_index(window_id)
        if frame_index >= 0:
            return true
        elif self.external_web_window_ids.len() < HOST_EXTERNAL_WEB_FRAME_MAX_COUNT:
            self.external_web_window_ids.push(window_id)
            self.external_web_frames.push(
                _host_empty_external_web_frame()
            )
        else:
            # A silent capacity refusal here is a bug generator: the caller only
            # sees `false`, so a window set that outgrows the ceiling ships as a
            # window that merely never draws. Name the ceiling and the demand.
            print "[hosted-wm] external-frame-slot-refused reason=capacity window_id={window_id} in_use={self.external_web_window_ids.len()} cap={HOST_EXTERNAL_WEB_FRAME_MAX_COUNT}"
            return false
        self.dirty.add_full_screen(self.width, self.height)
        true

    # Canonical names for the shared GUI/Web/pixel top-frame boundary.
    # Keep the historical Web names as compatibility aliases.
    me require_external_content_frame(window_id: i64) -> bool:
        self.require_external_web_frame(window_id)

    me invalidate_external_web_frame(window_id: i64):
        val frame_index = self._external_web_frame_index(window_id)
        if frame_index >= 0:
            self.external_web_frames[frame_index] = _host_empty_external_web_frame()
            self.dirty.add_full_screen(self.width, self.height)

    me release_external_web_frame(window_id: i64):
        if self._drop_external_web_frame(window_id):
            val window_index = self._find_window_index(window_id)
            if window_index >= 0:
                var window = self.windows[window_index]
                window.content_owner = host_content_owner_default(
                    window.owner_port, window.app_id, ""
                )
                self.windows[window_index] = window
            self.dirty.add_full_screen(self.width, self.height)

    me set_external_web_frame(
        window_id: i64,
        frame: WmContentFrame
    ) -> bool:
        val frame_index = self._external_web_frame_index(window_id)
        val window_index = self._find_window_index(window_id)
        if frame_index < 0 or window_index < 0:
            return false
        if frame.damage_rects.len() > 0:
            return self._apply_external_web_frame_damage(
                frame_index, window_index, window_id, frame)
        val window = self.windows[window_index]
        val expected_width = window.w - 8
        val expected_height = window.h - 36 -
            shared_wm_browser_content_extra_height(window.app_id)
        if (frame.width != expected_width or
            frame.height != expected_height or
            frame.window_id != ui_native_i64_text(window_id) or
            not wm_content_frame_origin_valid(frame.origin_kind) or
            frame.content_revision <= 0 or
            frame.width <= 0 or frame.height <= 0 or
            frame.width > 8192 or frame.height > 8192 or
            frame.width.to_i64() > HOST_EXTERNAL_WEB_FRAME_MAX_PIXELS /
                frame.height.to_i64() or
            frame.pixels.len() !=
                frame.width.to_i64() * frame.height.to_i64() or
            frame.checksum == 0u64 or
            frame.checksum != wm_content_frame_checksum(frame.pixels) or
            frame.parent_window_id != "" or
            frame.offset_x != 0 or frame.offset_y != 0 or
            frame.base_content_revision != 0 or
            frame.damage_rects.len() != 0 or frame.damage_pixels.len() != 0 or
            not wm_content_frame_web_provenance_valid(frame)):
            return false
        var aggregate_pixels = frame.pixels.len()
        var i = 0
        while i < self.external_web_frames.len():
            if i != frame_index:
                aggregate_pixels = aggregate_pixels +
                    self.external_web_frames[i].pixels.len()
            i = i + 1
        if aggregate_pixels > HOST_EXTERNAL_WEB_FRAME_MAX_PIXELS:
            return false
        self.external_web_frames[frame_index] = frame
        var updated_window = self.windows[window_index]
        updated_window.content_owner = host_content_owner_for_frame(
            updated_window.app_id, frame.origin_kind
        )
        self.windows[window_index] = updated_window
        self.dirty.add_full_screen(self.width, self.height)
        true

    me _apply_external_web_frame_damage(
        frame_index: i32,
        window_index: i32,
        window_id: i64,
        frame: WmContentFrame
    ) -> bool:
        """Apply an owned, packed retained delta without rescanning pixels."""
        val window = self.windows[window_index]
        val expected_width = window.w - 8
        val expected_height = window.h - 36 -
            shared_wm_browser_content_extra_height(window.app_id)
        val base = self.external_web_frames[frame_index]
        if (frame.pixels.len() != 0 or frame.checksum != 0u64 or
            frame.base_content_revision <= 0 or
            frame.base_content_revision != base.content_revision or
            frame.content_revision <= base.content_revision or
            frame.width != expected_width or frame.height != expected_height or
            frame.window_id != ui_native_i64_text(window_id) or
            frame.parent_window_id != "" or frame.offset_x != 0 or
            frame.offset_y != 0 or frame.damage_rects.len() % 4 != 0 or
            not wm_content_frame_origin_valid(frame.origin_kind) or
            not wm_content_frame_web_provenance_valid(frame) or
            base.content_revision <= 0 or base.window_id != frame.window_id or
            base.width != frame.width or base.height != frame.height or
            base.origin_kind != frame.origin_kind or
            base.theme_id != frame.theme_id or
            base.theme_source_manifest_sha256 !=
                frame.theme_source_manifest_sha256 or
            base.pixels.len() != frame.width.to_i64() * frame.height.to_i64() or
            base.checksum == 0u64 or
            base.checksum != wm_content_frame_checksum(base.pixels)):
            return false
        if frame.damage_rects.len() > 1024:
            return false
        var required: i64 = 0
        var ri = 0
        while ri < frame.damage_rects.len():
            val x = frame.damage_rects[ri]
            val y = frame.damage_rects[ri + 1]
            val w = frame.damage_rects[ri + 2]
            val h = frame.damage_rects[ri + 3]
            if (x < 0 or y < 0 or w <= 0 or h <= 0 or
                w > frame.width.to_i64() or h > frame.height.to_i64() or
                x > frame.width.to_i64() - w or
                y > frame.height.to_i64() - h or
                required > frame.width.to_i64() * frame.height.to_i64() - w * h):
                return false
            required = required + w * h
            ri += 4
        if required <= 0 or frame.damage_pixels.len().to_i64() != required:
            return false
        # A WmContentFrame is a value, but its array can be shared by a prior
        # reader. Clone before writing and swap the completed value once.
        var committed = base
        committed.pixels = _host_copy_wm_content_pixels(base.pixels)
        var checksum = if base.checksum == 1u64:
            _host_wm_content_checksum_raw(base.pixels)
        else:
            base.checksum
        var packed = 0
        ri = 0
        while ri < frame.damage_rects.len():
            val x = frame.damage_rects[ri].to_i32()
            val y = frame.damage_rects[ri + 1].to_i32()
            val w = frame.damage_rects[ri + 2].to_i32()
            val h = frame.damage_rects[ri + 3].to_i32()
            var row = 0
            while row < h:
                var col = 0
                while col < w:
                    val index = (y + row) * frame.width + x + col
                    val old = committed.pixels[index]
                    val current = frame.damage_pixels[packed]
                    val mix = (index + 1).to_u64() * 0x100000001B3u64
                    checksum = checksum ^ (old.to_u64() + mix)
                    checksum = checksum ^ (current.to_u64() + mix)
                    committed.pixels[index] = current
                    packed += 1
                    col += 1
                row += 1
            ri += 4
        committed.content_revision = frame.content_revision
        committed.engine2d_status = frame.engine2d_status
        committed.engine2d_backend = frame.engine2d_backend
        committed.engine2d_reason = frame.engine2d_reason
        committed.material_fallback_kind = frame.material_fallback_kind
        committed.material_fallback_reason = frame.material_fallback_reason
        committed.material_fallback_sha256 = frame.material_fallback_sha256
        committed.theme_id = frame.theme_id
        committed.theme_source_manifest_sha256 = frame.theme_source_manifest_sha256
        checksum = checksum & 0x7FFFFFFFFFFFFFFFu64
        committed.checksum = if checksum == 0u64: 1u64 else: checksum
        self.external_web_frames[frame_index] = committed
        # Keep the producer's exact packed damage through the WM boundary.
        # A LOCAL web delta changes only this content surface; promoting it to
        # full-screen here forces the retained CPU/Vulkan compositor to lose
        # its raster and transfer locality. Clip to the desktop because a
        # partially off-screen window is still a valid content owner.
        val content_x = window.x.to_i64() + 4
        val content_y = window.y.to_i64() + 32 +
            shared_wm_browser_content_extra_height(window.app_id).to_i64()
        val screen_w = self.width.to_i64()
        val screen_h = self.height.to_i64()
        ri = 0
        while ri < frame.damage_rects.len():
            val rx = frame.damage_rects[ri]
            val ry = frame.damage_rects[ri + 1]
            val rw = frame.damage_rects[ri + 2]
            val rh = frame.damage_rects[ri + 3]
            var left = content_x + rx
            var top = content_y + ry
            var right = left + rw
            var bottom = top + rh
            if left < 0: left = 0
            if top < 0: top = 0
            if right > screen_w: right = screen_w
            if bottom > screen_h: bottom = screen_h
            if right > left and bottom > top:
                self.dirty.add_rect(left.to_i32(), top.to_i32(),
                    (right - left).to_i32(), (bottom - top).to_i32())
            ri += 4
        true

    me set_external_content_frame(
        window_id: i64,
        frame: WmContentFrame
    ) -> bool:
        self.set_external_web_frame(window_id, frame)

    me set_external_child_frame(frame: WmContentFrame) -> bool:
        if (frame.window_id == "" or frame.parent_window_id == "" or
            not wm_content_frame_origin_valid(frame.origin_kind) or
            frame.content_revision <= 0 or frame.width <= 0 or frame.height <= 0 or
            frame.width > 8192 or frame.height > 8192 or
            frame.width.to_i64() > HOST_EXTERNAL_WEB_FRAME_MAX_PIXELS /
                frame.height.to_i64() or
            frame.pixels.len() != frame.width.to_i64() * frame.height.to_i64() or
            frame.checksum == 0u64 or
            frame.checksum != wm_content_frame_checksum(frame.pixels) or
            not wm_content_frame_web_provenance_valid(frame)):
            return false
        var parent_found = false
        var i = 0
        while i < self.windows.len():
            if (ui_native_i64_text(self.windows[i].id) ==
                frame.parent_window_id):
                parent_found = true
            i = i + 1
        i = 0
        while i < self.external_child_frames.len():
            if self.external_child_frames[i].window_id == frame.parent_window_id:
                parent_found = true
            i = i + 1
        if not parent_found:
            return false
        var replace_index = -1
        var aggregate_pixels = frame.pixels.len()
        i = 0
        while i < self.external_child_frames.len():
            val child = self.external_child_frames[i]
            if child.window_id == frame.window_id:
                replace_index = i
            else:
                aggregate_pixels = aggregate_pixels + child.pixels.len()
            i = i + 1
        i = 0
        while i < self.external_web_frames.len():
            aggregate_pixels = aggregate_pixels + self.external_web_frames[i].pixels.len()
            i = i + 1
        if aggregate_pixels > HOST_EXTERNAL_WEB_FRAME_MAX_PIXELS:
            return false
        if replace_index >= 0:
            self.external_child_frames[replace_index] = frame
        elif self.external_child_frames.len() < HOST_EXTERNAL_CHILD_FRAME_MAX_COUNT:
            self.external_child_frames.push(frame)
        else:
            return false
        self.dirty.add_full_screen(self.width, self.height)
        true

    me release_external_child_frame(frame_id: text):
        self._drop_external_child_frames_for_parent(frame_id)
        var kept: [WmContentFrame] = []
        for frame in self.external_child_frames:
            if frame.window_id != frame_id:
                kept.push(frame)
        self.external_child_frames = kept
        self.dirty.add_full_screen(self.width, self.height)

    static fn new_headless(size: Size) -> HostCompositor:
        val concrete = HeadlessHostCompositorBackend.new(size.width as i32, size.height as i32)
        val compositor = HostCompositor.new(concrete, size)
        compositor.headless_backend = concrete
        compositor.pixel_backend = SharedWmPixelBufferBackend.new(size.width as i32, size.height as i32)
        compositor.native_pixel_lane = true
        compositor

    # Returns the WebRenderPixelArtifactCache for `window_id`, creating (or
    # replacing) it when there is none yet or its (width, height,
    # backend_name) identity no longer matches what this frame needs. A
    # replacement starts with an empty last-rendered-HTML slot, so the very
    # next content render after a resize/rescroll/backend change is
    # correctly a miss+store, not a stale hit.
    me _content_cache_for(window_id: i64, cw: i32, full_h: i32, backend_name: text) -> WebRenderPixelArtifactCache:
        if self.native_pixel_lane:
            var native_idx = 0
            while native_idx < self.native_cache_window_ids.len():
                if self.native_cache_window_ids[native_idx] == window_id:
                    val native_cache = self.native_content_caches[native_idx]
                    if native_cache.width == cw and native_cache.height == full_h and native_cache.backend_name == backend_name:
                        return native_cache
                    val replacement = web_render_pixel_artifact_cache(cw, full_h, backend_name)
                    self.native_content_caches[native_idx] = replacement
                    return replacement
                native_idx = native_idx + 1
            val native_fresh = web_render_pixel_artifact_cache(cw, full_h, backend_name)
            self.native_cache_window_ids.push(window_id)
            self.native_content_caches.push(native_fresh)
            return native_fresh
        if self.content_caches.contains_key(window_id):
            val existing = self.content_caches[window_id]
            if existing.width == cw and existing.height == full_h and existing.backend_name == backend_name:
                return existing
        val fresh = web_render_pixel_artifact_cache(cw, full_h, backend_name)
        self.content_caches[window_id] = fresh
        fresh

    # Receiver-based taskbar projection. Stage3 native codegen yields nil
    # window elements when HostCompositor is passed by value into a free
    # function and its windows are iterated with for-in; indexed access on
    # the method receiver (the exact pattern render_frame uses) is proven
    # sound, so the authoritative body lives here.
    fn taskbar_model() -> TaskbarModel:
        var active_process_count = 0
        var pi = 0
        while pi < self.app_processes.len():
            if not self.app_processes[pi].failed:
                active_process_count = active_process_count + 1
            pi = pi + 1

        # Focus is part of the source state even though WindowRef intentionally
        # has no focus field: place the focused object last, matching host z-order.
        var running: [WindowRef] = []
        var wi = 0
        while wi < self.windows.len():
            val window = self.windows[wi]
            if not window.focused:
                running.push(WindowRef(window_id: ui_native_i64_text(window.id), app_id: window.app_id, title: window.title, minimized: window.minimized))
            wi = wi + 1
        wi = 0
        while wi < self.windows.len():
            val window = self.windows[wi]
            if window.focused:
                running.push(WindowRef(window_id: ui_native_i64_text(window.id), app_id: window.app_id, title: window.title, minimized: window.minimized))
            wi = wi + 1

        var pinned: [AppRef] = []
        var pinned_index = 0
        while pinned_index < self.pinned_apps.len():
            pinned.push(AppRef(
                app_id: self.pinned_apps[pinned_index].app_id,
                display_name: self.pinned_apps[pinned_index].display_name,
                icon: self.pinned_apps[pinned_index].icon
            ))
            pinned_index = pinned_index + 1

        val process_label = "{active_process_count}/{self.app_processes.len()} active"
        TaskbarModel(
            pinned: pinned,
            running: running,
            tray: [TrayItem(item_id: "host-processes", label: process_label, icon: "process")]
        )

    me pin_taskbar_app(app_id: text, display_name: text, icon: text) -> bool:
        if app_id == "":
            return false
        var i = 0
        while i < self.pinned_apps.len():
            if self.pinned_apps[i].app_id == app_id:
                return true
            i = i + 1
        self.pinned_apps.push(AppRef(
            app_id: app_id,
            display_name: display_name,
            icon: icon
        ))
        self.dirty.add_full_screen(self.width, self.height)
        true

    me unpin_taskbar_app(app_id: text) -> bool:
        if app_id == "":
            return false
        var kept: [AppRef] = []
        var removed = false
        var i = 0
        while i < self.pinned_apps.len():
            if self.pinned_apps[i].app_id == app_id:
                removed = true
            else:
                kept.push(AppRef(
                    app_id: self.pinned_apps[i].app_id,
                    display_name: self.pinned_apps[i].display_name,
                    icon: self.pinned_apps[i].icon
                ))
            i = i + 1
        if removed:
            self.pinned_apps = kept
            self.dirty.add_full_screen(self.width, self.height)
        removed

    fn taskbar_app_is_pinned(app_id: text) -> bool:
        var i = 0
        while i < self.pinned_apps.len():
            if self.pinned_apps[i].app_id == app_id:
                return true
            i = i + 1
        false

    # Receiver-built production evidence JSON for the compositor sub-object.
    # The evidence writer previously received the whole HostCompositor by
    # value; stage3 corrupts window elements at that free-function boundary
    # (LLDB: nil receiver inside host_wm_evidence_snapshot's element loop),
    # so the compositor fragment is built here on the receiver and crosses
    # the evidence boundary as a plain text scalar.
    fn evidence_compositor_json() -> text:
        var windows = ""
        var i = 0
        while i < self.windows.len():
            val w = self.windows[i]
            if i > 0: windows = windows + ","
            windows = windows + "{\"id\":{w.id},\"owner_port\":{w.owner_port},\"title\":{_host_evidence_json_text(w.title)},\"app_id\":{_host_evidence_json_text(w.app_id)},\"process_id\":{w.process_id},\"x\":{w.x},\"y\":{w.y},\"width\":{w.w},\"height\":{w.h},\"minimized\":{w.minimized},\"focused\":{w.focused},\"maximized\":{w.maximized},\"content\":{_host_evidence_json_text(w.content)}}"
            i = i + 1
        val model = self.taskbar_model()
        var running = ""
        i = 0
        while i < model.running.len():
            val item = model.running[i]
            if i > 0: running = running + ","
            running = running + "{\"window_id\":{_host_evidence_json_text(item.window_id)},\"app_id\":{_host_evidence_json_text(item.app_id)},\"title\":{_host_evidence_json_text(item.title)},\"minimized\":{item.minimized}}"
            i = i + 1
        "{\"width\":{self.width},\"height\":{self.height},\"render_revision\":{self.render_revision},\"pointer_x\":{self.pointer_x},\"pointer_y\":{self.pointer_y},\"dragging\":{self.dragging},\"resizing\":{self.resizing},\"windows\":[{windows}],\"taskbar\":{\"running\":[{running}],\"tray_count\":{model.tray.len()}}}"

    fn content_target(x: i32, y: i32) -> HostedWebContentTarget?:
        var hit: HostedWebContentTarget? = nil
        var i = 0
        while i < self.windows.len():
            val window = self.windows[i]
            val content_x = window.x + 4
            val content_y = window.y + 32 + shared_wm_browser_content_extra_height(
                window.app_id
            )
            val content_width = window.w - 8
            val content_height = window.h - 36 - shared_wm_browser_content_extra_height(window.app_id)
            if (
                not window.minimized and
                x >= content_x and x < content_x + content_width and
                y >= content_y and y < content_y + content_height
            ):
                hit = Some(HostedWebContentTarget(
                    window_id: window.id,
                    body_html: window.content,
                    local_x: x - content_x,
                    local_y: y - content_y,
                    width: content_width,
                    height: content_height
                ))
            i = i + 1
        hit

    fn browser_chrome_target(x: i32, y: i32) -> HostedBrowserChromeTarget?:
        var hit: HostedBrowserChromeTarget? = nil
        var i = 0
        while i < self.windows.len():
            val window = self.windows[i]
            if not window.minimized and window.app_id == "browser":
                val control = shared_wm_browser_toolbar_control_at(
                    x - window.x, y - window.y - 28, window.w
                )
                if control != "":
                    hit = Some(HostedBrowserChromeTarget(
                        window_id: window.id,
                        control: control
                    ))
            i = i + 1
        hit

    fn _gui_content_index(window_id: i64) -> i32:
        var i = 0
        while i < self.gui_content_window_ids.len():
            if self.gui_content_window_ids[i] == window_id:
                return i
            i = i + 1
        -1

    fn is_gui_content_window(window_id: i64) -> bool:
        val index = self._find_window_index(window_id)
        index >= 0 and (
            self.windows[index].content_owner == HOST_CONTENT_OWNER_GUI
        )

    me attach_window_gui_tree(window_id: i64, tree: UITree) -> bool:
        val window_index = self._find_window_index(window_id)
        if window_index < 0:
            return false
        val registry_index = self._gui_content_index(window_id)
        if registry_index >= 0:
            self.gui_content_trees[registry_index] = tree
            self.gui_content_focused_ids[registry_index] = ""
        else:
            self.gui_content_window_ids.push(window_id)
            self.gui_content_trees.push(tree)
            self.gui_content_focused_ids.push("")
        var window = self.windows[window_index]
        window.content_owner = HOST_CONTENT_OWNER_GUI
        self.windows[window_index] = window
        self.dirty.add_rect(window.x, window.y, window.w, window.h)
        true

    fn gui_content_tree(window_id: i64) -> UITree?:
        val registry_index = self._gui_content_index(window_id)
        if registry_index < 0:
            return nil
        Some(self.gui_content_trees[registry_index])

    me _release_gui_content(window_id: i64):
        val drop_index = self._gui_content_index(window_id)
        if drop_index >= 0:
            self.gui_content_window_ids.remove(drop_index)
            self.gui_content_trees.remove(drop_index)
            self.gui_content_focused_ids.remove(drop_index)
        if self.gui_pointer_capture_window_id == window_id:
            self.gui_pointer_capture_window_id = 0

    me dispatch_gui_pointer_event(
        window_id: i64,
        desktop_x: i32,
        desktop_y: i32,
        button: text,
        kind: text
    ) -> bool:
        var route_window_id = window_id
        val captured = (
            self.gui_pointer_capture_window_id > 0 and kind != "down"
        )
        if captured:
            route_window_id = self.gui_pointer_capture_window_id
        val window_index = self._find_window_index(route_window_id)
        if window_index < 0:
            if kind == "up":
                self.gui_pointer_capture_window_id = 0
            return false
        val window = self.windows[window_index]
        if not self.is_gui_content_window(route_window_id) or window.minimized:
            if kind == "up":
                self.gui_pointer_capture_window_id = 0
            return false
        val extra = shared_wm_browser_content_extra_height(window.app_id)
        val client_x = desktop_x - window.x - 4
        val client_y = desktop_y - window.y - 32 - extra
        val client_w = window.w - 8
        val client_h = window.h - 36 - extra
        val inside = (
            client_x >= 0 and client_y >= 0 and
            client_x < client_w and client_y < client_h
        )
        if not inside and not captured:
            if kind == "up":
                self.gui_pointer_capture_window_id = 0
            return false
        val registry_index = self._gui_content_index(route_window_id)
        if registry_index < 0:
            if kind == "up":
                self.gui_pointer_capture_window_id = 0
            return false
        var session = UISession.new(self.gui_content_trees[registry_index])
        val focused_id = self.gui_content_focused_ids[registry_index]
        if focused_id != "":
            session.dispatch(UIEvent.FocusEvent(focused_id, "focus"))
        session.dispatch(UIEvent.Resize(client_w, client_h))
        session.dispatch(UIEvent.MouseEvent(
            client_x.to_f64(), client_y.to_f64(), button, kind
        ))
        self.gui_content_trees[registry_index] = session.current_tree()
        self.gui_content_focused_ids[registry_index] = session.focused_widget()
        if kind == "down":
            self.gui_pointer_capture_window_id = route_window_id
        elif kind == "up":
            self.gui_pointer_capture_window_id = 0
        self.dirty.add_rect(window.x, window.y, window.w, window.h)
        true

    me dispatch_gui_scroll_event(
        window_id: i64,
        desktop_x: i32,
        desktop_y: i32,
        delta_x_milli: i64,
        delta_y_milli: i64
    ) -> bool:
        val window_index = self._find_window_index(window_id)
        if window_index < 0:
            return false
        val window = self.windows[window_index]
        if not self.is_gui_content_window(window_id) or window.minimized:
            return false
        val extra = shared_wm_browser_content_extra_height(window.app_id)
        val client_x = desktop_x - window.x - 4
        val client_y = desktop_y - window.y - 32 - extra
        val client_w = window.w - 8
        val client_h = window.h - 36 - extra
        if (client_x < 0 or client_y < 0 or
            client_x >= client_w or client_y >= client_h):
            return false
        val registry_index = self._gui_content_index(window_id)
        if registry_index < 0:
            return false
        var session = UISession.new(self.gui_content_trees[registry_index])
        val focused_id = self.gui_content_focused_ids[registry_index]
        if focused_id != "":
            session.dispatch(UIEvent.FocusEvent(focused_id, "focus"))
        session.dispatch(UIEvent.Resize(client_w, client_h))
        # Same milli-delta normalization as HostGuiEventRouter's wheel lane.
        session.dispatch(UIEvent.ScrollEvent(
            client_x.to_f64(), client_y.to_f64(),
            (0 - delta_x_milli).to_f64() / 100.0,
            (0 - delta_y_milli).to_f64() / 100.0
        ))
        self.gui_content_trees[registry_index] = session.current_tree()
        self.gui_content_focused_ids[registry_index] = session.focused_widget()
        self.dirty.add_rect(window.x, window.y, window.w, window.h)
        true

    me dispatch_gui_key_event(
        window_id: i64,
        key: text,
        ctrl: bool,
        shift: bool,
        alt: bool,
        super_key: bool
    ) -> bool:
        if key == "":
            return false
        val window_index = self._find_window_index(window_id)
        if window_index < 0:
            return false
        val window = self.windows[window_index]
        if (not self.is_gui_content_window(window_id) or
            window.minimized or not window.focused):
            return false
        val registry_index = self._gui_content_index(window_id)
        if registry_index < 0:
            return false
        var session = UISession.new(self.gui_content_trees[registry_index])
        val focused_id = self.gui_content_focused_ids[registry_index]
        if focused_id != "":
            session.dispatch(UIEvent.FocusEvent(focused_id, "focus"))
        if key == "tab":
            session.dispatch(
                if shift: UIEvent.FocusPrev else: UIEvent.FocusNext
            )
        else:
            session.dispatch_key_with_modifiers(
                key, ctrl, shift, alt, super_key
            )
        self.gui_content_trees[registry_index] = session.current_tree()
        self.gui_content_focused_ids[registry_index] = session.focused_widget()
        self.dirty.add_rect(window.x, window.y, window.w, window.h)
        true

    me dispatch_gui_text_event(window_id: i64, committed_text: text) -> bool:
        if committed_text == "":
            return false
        val window_index = self._find_window_index(window_id)
        if window_index < 0:
            return false
        val window = self.windows[window_index]
        if (not self.is_gui_content_window(window_id) or
            window.minimized or not window.focused):
            return false
        val registry_index = self._gui_content_index(window_id)
        if registry_index < 0:
            return false
        var session = UISession.new(self.gui_content_trees[registry_index])
        val focused_id = self.gui_content_focused_ids[registry_index]
        if focused_id != "":
            session.dispatch(UIEvent.FocusEvent(focused_id, "focus"))
        session.dispatch(UIEvent.CompositionCommit(committed_text))
        self.gui_content_trees[registry_index] = session.current_tree()
        self.gui_content_focused_ids[registry_index] = session.focused_widget()
        self.dirty.add_rect(window.x, window.y, window.w, window.h)
        true

    me take_gui_content_action(window_id: i64) -> text:
        val registry_index = self._gui_content_index(window_id)
        if registry_index < 0:
            return ""
        var session = UISession.new(self.gui_content_trees[registry_index])
        val focused_id = self.gui_content_focused_ids[registry_index]
        if focused_id != "":
            session.dispatch(UIEvent.FocusEvent(focused_id, "focus"))
        val action = session.take_pending_action()
        self.gui_content_trees[registry_index] = session.current_tree()
        self.gui_content_focused_ids[registry_index] = session.focused_widget()
        action

    me update_window_content(window_id: i64, body_html: text) -> bool:
        var i = 0
        while i < self.windows.len():
            if self.windows[i].id == window_id:
                var window = self.windows[i]
                if window.content == body_html:
                    return false
                window.content = body_html
                self.windows[i] = window
                self.dirty.add_rect(window.x, window.y, window.w, window.h)
                return true
            i = i + 1
        false

    me update_window_title(window_id: i64, title: text) -> bool:
        var i = 0
        while i < self.windows.len():
            if self.windows[i].id == window_id:
                var window = self.windows[i]
                if window.title == title:
                    return false
                window.title = title
                self.windows[i] = window
                self.dirty.add_rect(window.x, window.y, window.w, window.h)
                return true
            i = i + 1
        false

    me resize(width: i32, height: i32):
        if width <= 0 or height <= 0:
            return
        if (width.to_i64() * height.to_i64() >
            HOST_WM_MAX_FRAMEBUFFER_PIXELS):
            return
        var i = 0
        while i < self.windows.len():
            if self.windows[i].maximized:
                var window = self.windows[i]
                window.x = 0
                window.y = WM_WORK_AREA_TOP
                window.w = width
                window.h = height - WM_WORK_AREA_TOP - WM_WORK_AREA_BOTTOM
                if window.h < 1:
                    window.h = 1
                self.windows[i] = window
            i = i + 1
        self.width = width
        self.height = height
        self.dirty.add_full_screen(width, height)
        if self.native_pixel_lane:
            # Native lane: the pixel mirror is authoritative; the headless
            # trait mirror is unused and its Optional unwrap is a stage3
            # nil-payload trap, so it is not touched here.
            shared_wm_pixel_buffer_resize(self.pixel_backend, width, height)
            return
        if self.headless_backend != nil:
            headless_host_compositor_resize(self.headless_backend.unwrap(), width, height)

    fn pure_simple_pixel_buffer() -> [u32]:
        if self.native_pixel_lane:
            return shared_wm_pixel_buffer_pixels(self.pixel_backend)
        if self.headless_backend == nil:
            return []
        headless_host_compositor_pixels(self.headless_backend.unwrap())

    me web_animation_dirty_due(now_micros: i64) -> bool:
        val now_ms = now_micros / 1000
        var any_due = false
        var window_index = 0
        while window_index < self.windows.len():
            val window = self.windows[window_index]
            var window_due = false
            if not window.minimized:
                if self.native_pixel_lane:
                    var cache_index = 0
                    while cache_index < self.native_cache_window_ids.len():
                        if self.native_cache_window_ids[cache_index] == window.id:
                            window_due = self.native_content_caches[
                                cache_index
                            ].animation_frame_due(now_ms)
                        cache_index = cache_index + 1
                else:
                    if self.content_caches.contains_key(window.id):
                        val cache = self.content_caches[window.id]
                        window_due = cache.animation_frame_due(now_ms)
            if window_due:
                self.dirty.add_rect(window.x, window.y, window.w, window.h)
                any_due = true
            window_index = window_index + 1
        any_due

    me set_background(spec: BackgroundSpec):
        """Configure the scene background (color/image/motion) this
        compositor resolves at render time. init_host_wm calls this once at
        startup when ensure_host_motion_background_source_registered
        succeeded (SIMPLE_WM_MOTION_MANIFEST configured); specs may also call
        it directly to exercise a background without going through env-var
        wiring."""
        self.background = spec

    # Resolves self.background against the LIVE theme: a kind:"color"
    # background always tracks the current theme.compositor_bg (byte-identical
    # to the historical hardcoded fill when no image/motion background has
    # been configured — see the `background` field doc above), so a runtime
    # theme change is still honored exactly like before this field existed.
    # kind:"image"/"motion" pass straight to the one shared resolution point
    # (shared_wm_scene_resolve_background) the shared-MDI production lane
    # already uses. `wall_clock_micros` is only read by a kind:"motion"
    # background (see shared_wm_scene_resolve_background's t_micros doc).
    me _resolve_background(theme: WmChromeColors, wall_clock_micros: i64) -> SharedWmBackgroundResolution:
        val effective = if self.background.kind == WM_BACKGROUND_KIND_COLOR:
            shared_wm_background_color(theme.compositor_bg)
        else:
            self.background
        val t_micros = if effective.kind == WM_BACKGROUND_KIND_MOTION: wall_clock_micros else: 0
        shared_wm_scene_resolve_background(effective, self.width, self.height, t_micros)

    # I8 region-dirty: presents a due background advance WITHOUT re-rastering
    # windows or chrome. Only the desktop sub-rects NOT covered by a
    # currently-visible (non-minimized) window are touched, so window/chrome
    # pixels drawn by the last full render_frame() are left byte-exact — this
    # is the literal invariant I8 asks for ("background-only advance does NOT
    # re-raster windows/chrome"), not just a perf shortcut: blindly
    # re-blitting the full desktop rect here would stomp window pixels drawn
    # on top of it by the previous full render. Correctness fallback: if the
    # exact non-overlapping region can't be computed cheaply
    # (host_background_visible_rects hits its rect-count safety cap), this
    # returns false and the caller (hosted_entry.spl's present loop) falls
    # back to a full render_frame() instead of risking an incorrect partial
    # paint.
    me render_background_only(t_micros: i64) -> bool:
        val theme = wm_chrome_theme()
        val region = host_background_visible_rects(self.windows, self.width, self.height)
        if not region.computed:
            return false
        val resolved = self._resolve_background(theme, t_micros)
        for rect in region.rects:
            if val surface = resolved.surface:
                self.backend.blit_pixels(rect.x, rect.y, rect.width, rect.height, host_background_crop_surface(surface, rect, self.width))
            else:
                self.backend.fill_rect(rect.x, rect.y, rect.width, rect.height, resolved.color)
        if region.rects.len() > 0:
            val bounds = host_background_bounding_rect(region.rects)
            self.backend.present_rect(bounds.x, bounds.y, bounds.width, bounds.height)
        true

    # `web_backend_name` is selected by the owning Engine2D compositor before
    # any Web cache is constructed. It is deliberately an explicit argument:
    # leaf HTML/WebIR rendering must neither read SIMPLE_GUI_BACKEND nor turn a
    # hosted GPU selection back into an independent `auto` choice.
    me _taskbar_render_input(theme: WmChromeColors, frame_time: i64, web_backend_name: text) -> SharedWmTaskbarRenderInput:
        var shared_windows: [SharedMdiRenderWindow] = []
        val window_count = self.windows.len()
        # Identity accessor, not the Option pattern binding: under the
        # cranelift native lane the Some payload from
        # active_wm_theme_render_snapshot() decodes as nil and `snapshot.id`
        # faulted with "field access on nil receiver" on the FIRST frame
        # (2026-07-26; only reached when a theme is installed, which is why
        # the None path at bootstrap survived the same shape). The accessor
        # keeps the field projection in the owning module by design.
        val active_theme_id = active_wm_theme_id()
        val content_theme_id = if active_theme_id != "": active_theme_id else: default_theme_id()
        var i = 0
        while i < window_count:
            val win = self.windows[i]
            val scroll = self.scroll_offset_for(win.id) as i32
            # Keep HostedWindow field access inside its owning receiver path.
            # Passing the class by value through a free helper corrupts the
            # stage3 layout and can surface as a nil receiver.
            shared_windows.push(shared_mdi_render_window(
                win.id, win.title, win.app_id, win.content,
                win.x, win.y, win.w, win.h, win.process_id,
                win.minimized, win.focused, scroll
            ))
            i = i + 1
        var scene = shared_mdi_scene_from_render_windows(self.width, self.height, "host-compositor", shared_windows)
        scene.background = if self.background.kind == WM_BACKGROUND_KIND_COLOR: shared_wm_background_color(theme.compositor_bg) else: self.background
        var content_frames: [WmContentFrame] = []
        i = 0
        while i < window_count:
            val win = self.windows[i]
            if not win.minimized:
                val cw = win.w - 8
                val ch = win.h - 36 - shared_wm_browser_content_extra_height(win.app_id)
                val scroll = self.scroll_offset_for(win.id) as i32
                val external_index = self._external_web_frame_index(win.id)
                if external_index >= 0:
                    var external = self.external_web_frames[external_index]
                    external.scene_revision = self.render_revision
                    # External pixels are owned by the sandbox renderer, while
                    # `content_revision` above includes parent-owned chrome
                    # text. Editing the address must not invalidate the last
                    # trusted page frame.
                    if (external.width != cw or external.height != ch or
                        external.pixels.len() != cw * ch):
                        external.pixels = []
                        external.checksum = 0u64
                        self.external_web_frames[external_index] = external
                    content_frames.push(external)
                elif self.requires_external_web_frame(win.id):
                    # Positive-owner and browser content is renderer-owned.
                    # Missing admission or a crashed child stays blank.
                    content_frames.push(_host_empty_external_web_frame())
                else:
                    val content_revision = simple_web_content_revision_with_theme(content_theme_id, win.title, win.content, cw, ch, scroll)
                    val full_h = content_paint_full_height(ch, scroll)
                    val cache = self._content_cache_for(
                        win.id, cw, full_h, web_backend_name
                    )
                    content_frames.push(simple_web_content_frame_cached_at_time(
                        cache, ui_native_i64_text(win.id), self.render_revision,
                        content_revision, content_theme_id, win.title, win.content,
                        cw, ch, scroll, frame_time / 1000
                    ))
                    if not self.native_pixel_lane:
                        self.content_caches[win.id] = cache
            i = i + 1
        i = 0
        while i < self.external_child_frames.len():
            var child = self.external_child_frames[i]
            child.scene_revision = self.render_revision
            content_frames.push(child)
            i = i + 1
        val revision = WmSceneRevision(scene_revision: self.render_revision, input_revision: self.render_revision, taskbar_revision: self.render_revision)
        val metrics = WmRenderMetrics(scale_milli: 1000, top_lane_height: 44, titlebar_height: 28, taskbar_height: 56, min_hit_target: 56)
        val render_input = SharedWmRenderInput(scene: scene, revision: revision, content_frames: content_frames, metrics: metrics, t_micros: frame_time)
        SharedWmTaskbarRenderInput(render: render_input, taskbar: self.taskbar_model(), clock_label: host_taskbar_clock_label(frame_time))

    me _reject_engine2d_frame() -> bool:
        print "[hosted-wm] draw-ir-rejected retry=compatibility"
        self.render_revision = self.render_revision - 1
        false

    me render_frame_engine2d(executor: Engine2dCompositorBackend) -> bool:
        # Resolve dimensions through the layout-owning module. Direct
        # cross-module field reads can shift by the object-header slot.
        val executor_width = executor.width()
        val executor_height = executor.height()
        if not self.native_pixel_lane or host_wm_chrome_force_direct() or self.background.kind != WM_BACKGROUND_KIND_COLOR or executor_width != self.width or executor_height != self.height:
            print "[hosted-wm] draw-ir-reject-detail reason=entry-gate native_pixel_lane={self.native_pixel_lane} force_direct={host_wm_chrome_force_direct()} background_kind={self.background.kind} executor={executor_width}x{executor_height} compositor={self.width}x{self.height}"
            return false
        if self.dirty.is_empty():
            self.skipped_frame_count = self.skipped_frame_count + 1
            return true
        self.render_revision = self.render_revision + 1
        val selected_backend = executor.selected_backend()
        # The same persistent Engine2D session that will execute the parent
        # Draw IR selects the backend for every child Web cache. This preserves
        # actual Metal/Vulkan selection, or its honest software fallback.
        val taskbar_input = self._taskbar_render_input(
            wm_chrome_theme(), rt_time_now_unix_micros(),
            selected_backend
        )

        val scene = taskbar_input.render.scene
        val frames = taskbar_input.render.content_frames
        var images: [Engine2dResolvedDrawIrImage] = []
        var top_frames: [WmContentFrame] = []
        var expected_images = 0
        var wi = 0
        while wi < scene.windows.len():
            val window = scene.windows[wi]
            val content = shared_wm_scene_window_content_rect_with_titlebar(window, 28)
            if not window.minimized and content.width > 0 and content.height > 0:
                expected_images = expected_images + 1
                val frame_index = shared_wm_top_content_frame_index(frames, self.render_revision, window.window_id, content.width, content.height)
                if frame_index >= 0:
                    val frame = frames[frame_index]
                    if not wm_content_frame_web_provenance_valid(frame):
                        print "[hosted-wm] content-provenance-rejected window_id={window.window_id} status={frame.engine2d_status} backend={frame.engine2d_backend} fallback={frame.material_fallback_kind} material={frame.material_fallback_sha256} theme={frame.theme_id} source={frame.theme_source_manifest_sha256}"
                        return self._reject_engine2d_frame()
                    val image_uri = shared_wm_content_frame_image_uri(frame)
                    var duplicate_uri = image_uri == ""
                    var ii = 0
                    while ii < images.len():
                        if images[ii].image_uri == image_uri:
                            duplicate_uri = true
                        ii = ii + 1
                    if duplicate_uri:
                        print "[hosted-wm] draw-ir-reject-detail reason=duplicate-or-empty-content-uri window_id={window.window_id} uri={image_uri}"
                        return self._reject_engine2d_frame()
                    images.push(engine2d_resolved_draw_ir_image(image_uri, frame.width, frame.height, frame.pixels))
                    top_frames.push(frame)
                else:
                    print "[hosted-wm] draw-ir-reject-detail reason=content-frame-missing window_id={window.window_id} scene_revision={self.render_revision}"
                    return self._reject_engine2d_frame()
            wi = wi + 1
        if images.len() != expected_images or top_frames.len() != expected_images:
            print "[hosted-wm] draw-ir-reject-detail reason=content-image-count images={images.len()} frames={frames.len()} expected={expected_images}"
            return self._reject_engine2d_frame()

        val nested_frames = shared_wm_nested_content_frames(scene, frames, top_frames, self.render_revision, 28)
        for frame in nested_frames:
            images.push(engine2d_resolved_draw_ir_image(shared_wm_content_frame_image_uri(frame), frame.width, frame.height, frame.pixels))
            top_frames.push(frame)
        val composition = shared_wm_scene_draw_ir_composition_with_content(scene, taskbar_input.taskbar, frames, selected_backend, 1000, taskbar_input.clock_label, 0)
        # One canonical damage input feeds both the native-window GPU path and
        # the retained CPU mirror path below. It contains the compositor's
        # conservative old/new invalidation rectangles, not inferred command
        # bounds, so removals and moves erase their prior pixels correctly.
        var dirty_rects: [i64] = []
        for rect in self.dirty.rects:
            dirty_rects.push(rect.x.to_i64())
            dirty_rects.push(rect.y.to_i64())
            dirty_rects.push(rect.w.to_i64())
            dirty_rects.push(rect.h.to_i64())
        if executor.window_present_enabled():
            var resources: [SimpleOsHostGpuImageResource] = []
            for frame in top_frames:
                resources.push(simpleos_host_gpu_image_resource(
                    shared_wm_content_frame_image_uri(frame), frame.width,
                    frame.height, frame.pixels))
            if not executor.render_draw_ir_composition_resources_window_revision_damaged(
                composition, resources, self.render_revision,
                self.render_revision, dirty_rects):
                return self._reject_engine2d_frame()
            for frame in frames:
                print "[hosted-wm] content-presented scene_revision={self.render_revision} path=vulkan-window-swapchain window_id={frame.window_id} status={frame.engine2d_status} backend={frame.engine2d_backend} fallback={frame.material_fallback_kind} material={frame.material_fallback_sha256} theme={frame.theme_id} source={frame.theme_source_manifest_sha256}"
            self.dirty.clear()
            return true
        # CPU/SIMD retained frame switch. The first frame stays on the normal
        # snapshot route and seeds the mirror below. Later frames raster only
        # the conservative damage plan, copy only those regions into the host
        # pixel backend, then present once to retire the Engine2D dirty tiles.
        if executor.cpu_damage_seeded and executor.render_draw_ir_composition_cpu_damaged(
            composition, images, dirty_rects):
            val mirror = executor.cpu_damage_pixels()
            if mirror.len() != self.width * self.height:
                executor.abort_cpu_damage()
                return self._reject_engine2d_frame()
            var ri = 0
            while ri + 3 < executor.cpu_damage_rects.len():
                val x = executor.cpu_damage_rects[ri].to_i32()
                val y = executor.cpu_damage_rects[ri + 1].to_i32()
                val w = executor.cpu_damage_rects[ri + 2].to_i32()
                val h = executor.cpu_damage_rects[ri + 3].to_i32()
                if x < 0 or y < 0 or w <= 0 or h <= 0 or x + w > self.width or y + h > self.height:
                    executor.abort_cpu_damage()
                    return self._reject_engine2d_frame()
                self.pixel_backend._px_blit_strided(
                    x, y, w, h, mirror, self.width, x, y)
                ri += 4
            executor.present_cpu_damage()
            self.pixel_backend.present()
            for frame in frames:
                print "[hosted-wm] content-presented scene_revision={self.render_revision} path=cpu-retained-damage window_id={frame.window_id} status={frame.engine2d_status} backend={frame.engine2d_backend} fallback={frame.material_fallback_kind} material={frame.material_fallback_sha256} theme={frame.theme_id} source={frame.theme_source_manifest_sha256}"
            self.dirty.clear()
            return true
        var accepted_composition = composition
        var accepted_result = executor.render_draw_ir_composition(composition, images)
        # A concrete Metal WM frame is device-only. The executor must return
        # one valid receipt for every requested glass surface, and that receipt
        # must describe the same completed readback device/handle the host is
        # about to present. Never infer success from a Metal plan or a CPU
        # fallback after malformed bounds/metadata/state.
        if (not host_wm_draw_ir_result_valid(
            accepted_composition, accepted_result, self.width * self.height
        ) and host_wm_draw_ir_local_recompose_required(selected_backend)):
            # Preserve the exact validated scene, taskbar, content frames, and
            # image resources. Only the producer's material target changes.
            accepted_composition = shared_wm_scene_draw_ir_composition_with_content(
                scene, taskbar_input.taskbar, frames, DRAW_IR_BACKEND_CPU,
                1000, taskbar_input.clock_label, 0
            )
            accepted_result = executor.render_draw_ir_composition(
                accepted_composition, images
            )
        if not host_wm_draw_ir_result_valid(
            accepted_composition, accepted_result, self.width * self.height
        ):
            if not host_metal_glass_receipts_valid(
                accepted_composition, accepted_result
            ):
                print "[hosted-wm] draw-ir-reject-detail reason=metal-glass-receipt requested={accepted_result.metal_device_glass_requested_count} executed={accepted_result.metal_device_glass_material_count} receipts={accepted_result.metal_device_glass_receipts.len()} unfulfilled={accepted_result.metal_device_glass_unfulfilled_count} readback_handle={accepted_result.backend_handle} readback_device={accepted_result.device_identity} source={accepted_result.readback_source}"
            else:
                print "[hosted-wm] draw-ir-reject-detail reason=render-result fallback_required={accepted_result.fallback_required} fallback_reason={accepted_result.fallback_reason} skipped={accepted_result.skipped_command_count} rendered={accepted_result.rendered_command_count} pixels={accepted_result.pixels.len()} expected_pixels={self.width * self.height}"
            return self._reject_engine2d_frame()
        self.pixel_backend.blit_pixels(0, 0, self.width, self.height, accepted_result.pixels)
        self.pixel_backend.present()
        # The ordinary result already established the compositor-visible full
        # frame. Seed the Engine2D retained mirror now, after successful
        # validation, so the next damaged frame can avoid another full copy.
        executor.seed_cpu_damage_mirror()
        for frame in frames:
            print "[hosted-wm] content-presented scene_revision={self.render_revision} window_id={frame.window_id} status={frame.engine2d_status} backend={frame.engine2d_backend} fallback={frame.material_fallback_kind} material={frame.material_fallback_sha256} theme={frame.theme_id} source={frame.theme_source_manifest_sha256}"
        self.dirty.clear()
        true

    me render_frame():
        val theme = wm_chrome_theme()
        self.render_revision = self.render_revision + 1
        # Compatibility renderer for explicit direct mode, image/motion
        # backgrounds, and same-frame fallback from render_frame_engine2d.
        val resolved_bg = self._resolve_background(theme, rt_time_now_unix_micros())
        # I-item-4 fast no-op path: only the chrome paint + final scene
        # composite + present are gated on accumulated damage (ponytail:
        # full recomposite on any damage; partial/rect-scoped recomposition
        # is deferred until profiling demands it). The content-frame
        # building loop below keeps running every call regardless of
        # `had_damage` -- it owns its own per-window cache hit/miss
        # bookkeeping (task #15's WebRenderPixelArtifactCache) which must
        # stay live independent of whether this frame actually presents.
        val had_damage = not self.dirty.is_empty()
        if had_damage and not self.native_pixel_lane:
            shared_wm_scene_render_desktop_chrome(self.backend, self.width, self.height, theme, resolved_bg.color, resolved_bg.surface)
        val frame_time = rt_time_now_unix_micros()
        # Direct compatibility rendering has no Engine2D owner; retain its
        # historical independent auto selection outside the hosted Draw IR lane.
        val taskbar_input = self._taskbar_render_input(theme, frame_time, "auto")
        if had_damage:
            if self.native_pixel_lane:
                shared_wm_scene_render_taskbar_context_to_pixel_buffer(self.pixel_backend, taskbar_input)
            else:
                shared_wm_scene_render_taskbar_context_to_backend(self.backend, taskbar_input)
                self.backend.present()
            self.dirty.clear()
        else:
            self.skipped_frame_count = self.skipped_frame_count + 1

    me apply_bridge_request(seq: i64, owner_port: i64, method: i64, window_id: i64, title: text, x: i32, y: i32, w: i32, h: i32, content: text, process_id: i64, app_id: text):
        val action = wm_action_from_bridge_request(owner_port, method, window_id, title, x, y, w, h, content, process_id, app_id)
        if method == COMP_MAXIMIZE.to_i64():
            val i = self._find_window_index(window_id)
            if i < 0 or not wm_lifecycle_owner_allows_source(
                self.windows[i].owner_port, action.src_port
            ):
                return
            self.maximize_window(window_id)
            return
        if method == COMP_RESTORE.to_i64():
            val i = self._find_window_index(window_id)
            if i < 0 or not wm_lifecycle_owner_allows_source(
                self.windows[i].owner_port, action.src_port
            ):
                return
            self.restore_window(window_id)
            return
        self.apply_wm_action(action)

    me maximize_window(window_id: i64):
        val i = self._find_window_index(window_id)
        if i < 0:
            return
        self._cancel_window_interaction(window_id)
        val prior_windows = self.windows
        var win = self.windows[i]
        if not win.maximized:
            win.restore_x = win.x
            win.restore_y = win.y
            win.restore_w = win.w
            win.restore_h = win.h
        win.x = 0
        win.y = WM_WORK_AREA_TOP
        win.w = self.width
        win.h = self.height - WM_WORK_AREA_TOP - WM_WORK_AREA_BOTTOM
        win.minimized = false
        win.maximized = true
        self.windows[i] = win
        var j = 0
        while j < self.windows.len():
            var jw = self.windows[j]
            jw.focused = jw.id == window_id
            self.windows[j] = jw
            j = j + 1
        self._mark_geometry_damage(prior_windows)

    me restore_window(window_id: i64):
        val i = self._find_window_index(window_id)
        if i < 0:
            return
        val prior_windows = self.windows
        var win = self.windows[i]
        val restoring_minimized = win.minimized
        if (not restoring_minimized and win.maximized and
            win.restore_w > 0 and win.restore_h > 0):
            win.x = win.restore_x
            win.y = win.restore_y
            win.w = win.restore_w
            win.h = win.restore_h
        win.minimized = false
        if not restoring_minimized:
            win.maximized = false
        win.focused = true
        self.windows[i] = win
        var j = 0
        while j < self.windows.len():
            if j != i:
                var other = self.windows[j]
                other.focused = false
                self.windows[j] = other
            j = j + 1
        self._mark_geometry_damage(prior_windows)

    me set_window_pointer_passthrough(window_id: i64, x: i32, y: i32, w: i32, h: i32):
        """Mark a window-local content-coordinate sub-region as click-through
        ("pointer-events: none"): pointer events landing inside it fall
        through to whatever window is underneath instead of being claimed by
        this window. w == 0 or h == 0 clears the dead region."""
        val i = self._find_window_index(window_id)
        if i < 0:
            return
        var win = self.windows[i]
        win.passthrough_x = x
        win.passthrough_y = y
        win.passthrough_w = w
        win.passthrough_h = h
        self.windows[i] = win

    me apply_wm_action(action: WmAction):
        val prior_windows = self.windows
        val out = host_compositor_apply_lifecycle_action(self, action)
        self.windows = out.windows
        self.next_window_id = out.next_window_id
        var i = 0
        while i < self.windows.len():
            var j = 0
            while j < prior_windows.len():
                if self.windows[i].id == prior_windows[j].id:
                    var iw = self.windows[i]
                    iw.maximized = prior_windows[j].maximized
                    iw.restore_x = prior_windows[j].restore_x
                    iw.restore_y = prior_windows[j].restore_y
                    iw.restore_w = prior_windows[j].restore_w
                    iw.restore_h = prior_windows[j].restore_h
                    iw.passthrough_x = prior_windows[j].passthrough_x
                    iw.passthrough_y = prior_windows[j].passthrough_y
                    iw.passthrough_w = prior_windows[j].passthrough_w
                    iw.passthrough_h = prior_windows[j].passthrough_h
                    self.windows[i] = iw
                j = j + 1
            i = i + 1
        if action.kind == "minimize":
            val minimized_index = self._find_window_index(
                action.window_id.to_i64()
            )
            if (minimized_index >= 0 and
                self.windows[minimized_index].minimized):
                self._cancel_window_interaction(action.window_id.to_i64())
        self._mark_geometry_damage(prior_windows)

    fn _find_window_index(window_id: i64) -> i32:
        var i = 0
        while i < self.windows.len():
            if self.windows[i].id == window_id:
                return i
            i = i + 1
        -1

    # I-item-4 damage tracking: diffs `prior_windows` (a snapshot taken
    # before a mutation) against self.windows (the post-mutation state) and
    # adds the old + new rect for every window that was added, removed, or
    # whose visible bounds/state (position, size, minimized, focused,
    # content, title) changed. Content-only changes (e.g. COMP_UPDATE_TREE)
    # have no geometry delta but still damage the window's current rect,
    # since its rendered pixels differ even though x/y/w/h don't.
    me _mark_geometry_damage(prior_windows: [HostedWindow]):
        var i = 0
        while i < self.windows.len():
            val win = self.windows[i]
            val prior_idx = _host_find_window_by_id(prior_windows, win.id)
            if prior_idx < 0:
                self.dirty.add_rect(win.x, win.y, win.w, win.h)
            else:
                val prior = prior_windows[prior_idx]
                if (prior.w != win.w or prior.h != win.h or
                    prior.app_id != win.app_id):
                    val external_index = self._external_web_frame_index(win.id)
                    if external_index >= 0:
                        self.external_web_frames[external_index] = _host_empty_external_web_frame()
                if prior.x != win.x or prior.y != win.y or prior.w != win.w or prior.h != win.h or prior.minimized != win.minimized or prior.focused != win.focused or prior.content != win.content or prior.title != win.title:
                    self.dirty.add_rect(prior.x, prior.y, prior.w, prior.h)
                    self.dirty.add_rect(win.x, win.y, win.w, win.h)
            i = i + 1
        var j = 0
        while j < prior_windows.len():
            if _host_find_window_by_id(self.windows, prior_windows[j].id) < 0:
                val gone = prior_windows[j]
                self._drop_window_render_state(gone.id)
                self.dirty.add_rect(gone.x, gone.y, gone.w, gone.h)
            j = j + 1

    me destroy_window(window_id: i64):
        self.apply_wm_action(wm_destroy_action(window_id))

    me focus_window(window_id: i64):
        self.apply_wm_action(wm_focus_action(window_id))

    fn _hit_shared_taskbar(x: i32, y: i32) -> i64:
        val model = self.taskbar_model()
        val metrics = WmRenderMetrics(
            scale_milli: 1000,
            top_lane_height: 44,
            titlebar_height: 28,
            taskbar_height: 56,
            min_hit_target: 56
        )
        val slot_width = metrics.min_hit_target
        val object_limit = self.width - (
            model.tray.len() as i32 + 1
        ) * slot_width
        var object_index = 0
        var pinned_index = 0
        while pinned_index < model.pinned.len():
            val rect = shared_wm_taskbar_object_rect(
                metrics, self.width, self.height, object_index
            )
            if (rect.x + rect.width <= object_limit and
                x >= rect.x and x < rect.x + rect.width and
                y >= rect.y and y < rect.y + rect.height):
                var window_index = self.windows.len() - 1
                while window_index >= 0:
                    if (self.windows[window_index].app_id ==
                        model.pinned[pinned_index].app_id):
                        return self.windows[window_index].id
                    window_index = window_index - 1
                return 0
            object_index = object_index + 1
            pinned_index = pinned_index + 1
        var running_index = 0
        while running_index < model.running.len():
            val rect = shared_wm_taskbar_object_rect(
                metrics, self.width, self.height, object_index
            )
            if (rect.x + rect.width <= object_limit and
                x >= rect.x and x < rect.x + rect.width and
                y >= rect.y and y < rect.y + rect.height):
                return model.running[running_index].window_id.to_i64()
            object_index = object_index + 1
            running_index = running_index + 1
        0

    fn _hit_shared_pinned_app(x: i32, y: i32) -> text:
        val model = self.taskbar_model()
        val metrics = WmRenderMetrics(
            scale_milli: 1000,
            top_lane_height: 44,
            titlebar_height: 28,
            taskbar_height: 56,
            min_hit_target: 56
        )
        val slot_width = metrics.min_hit_target
        val object_limit = self.width - (
            model.tray.len() as i32 + 1
        ) * slot_width
        var pinned_index = 0
        while pinned_index < model.pinned.len():
            val rect = shared_wm_taskbar_object_rect(
                metrics, self.width, self.height, pinned_index as i32
            )
            if (rect.x + rect.width <= object_limit and
                x >= rect.x and x < rect.x + rect.width and
                y >= rect.y and y < rect.y + rect.height):
                return model.pinned[pinned_index].app_id
            pinned_index = pinned_index + 1
        ""

    fn hit_taskbar(x: i32, y: i32) -> i64:
        if self.native_pixel_lane:
            return self._hit_shared_taskbar(x, y)
        wm_lifecycle_hit_taskbar(host_windows_to_lifecycle_state(self.windows), self.width, self.height, x, y)

    me pointer_move(x: i32, y: i32):
        self.pointer_x = x
        self.pointer_y = y
        val prior_windows = self.windows
        # Passthrough-rect restoration lives inside host_compositor_pointer_move
        # itself (not duplicated here) so every caller of that shared free
        # function -- this method AND SimpleOsGuiAdapter.deliver_pointer_move --
        # gets it, instead of only whichever caller remembers to copy the loop.
        val out = host_compositor_pointer_move(self, x, y)
        self.windows = out.windows
        self.next_window_id = out.next_window_id
        self.dragging = out.dragging
        self.drag_window_id = out.drag_window_id
        self.drag_offset_x = out.drag_offset_x
        self.drag_offset_y = out.drag_offset_y
        self.resizing = out.resizing
        self.resize_window_id = out.resize_window_id
        self.resize_start_x = out.resize_start_x
        self.resize_start_y = out.resize_start_y
        self.resize_start_w = out.resize_start_w
        self.resize_start_h = out.resize_start_h
        # Interactive drag/resize moves window geometry directly through
        # host_compositor_pointer_move rather than through apply_wm_action,
        # so it needs its own damage diff — otherwise a dragged window would
        # freeze on screen once render_frame()'s no-damage skip is live.
        self._mark_geometry_damage(prior_windows)

    me handle_mouse_move(x: i32, y: i32):
        self.pointer_move(x, y)

    me cancel_pointer_interaction():
        self.dragging = false
        self.drag_window_id = 0
        self.resizing = false
        self.resize_window_id = 0
        self.resize_start_x = 0
        self.resize_start_y = 0
        self.resize_start_w = 0
        self.resize_start_h = 0

    me handle_left_button(down: bool):
        val prior_windows = self.windows
        val out = host_compositor_left_button_at(self, down, self.pointer_x, self.pointer_y)
        self.windows = out.windows
        self.next_window_id = out.next_window_id
        self.dragging = out.dragging
        self.drag_window_id = out.drag_window_id
        self.drag_offset_x = out.drag_offset_x
        self.drag_offset_y = out.drag_offset_y
        self.resizing = out.resizing
        self.resize_window_id = out.resize_window_id
        self.resize_start_x = out.resize_start_x
        self.resize_start_y = out.resize_start_y
        self.resize_start_w = out.resize_start_w
        self.resize_start_h = out.resize_start_h
        self.armed_chrome_target = out.armed_chrome_target
        self.armed_chrome_window_id = out.armed_chrome_window_id
        self.armed_chrome_app_id = out.armed_chrome_app_id
        self.pending_taskbar_launch_app_id = (
            out.pending_taskbar_launch_app_id
        )
        # host_compositor_left_button_at runs focus/destroy on a byval copy
        # of `self` (see class doc above re: stage3 free-function-by-value
        # codegen), so any damage it marked internally lives on that copy's
        # `dirty` and is never copied back here. Recompute the diff fresh
        # against the true receiver instead of trying to propagate it.
        self._mark_geometry_damage(prior_windows)

    me take_pending_taskbar_launch_app_id() -> text:
        val app_id = self.pending_taskbar_launch_app_id
        self.pending_taskbar_launch_app_id = ""
        app_id

    # Generic pointer-button entry point (0=left, 1=middle, 2=right). Left
    # keeps its full chrome semantics (drag/resize/close/taskbar/focus);
    # middle/right have no WM chrome action defined yet, so they are recorded
    # on last_button/last_button_down instead of being silently dropped.
    me handle_mouse_button(button: i64, down: bool):
        self.last_button = button
        self.last_button_down = down
        if button == 0:
            self.handle_left_button(down)

    # Route a wheel delta to whichever hosted window the pointer currently
    # hovers, accumulating a per-window offset. See scroll_offsets doc above
    # for what this does and does not (yet) drive.
    me handle_mouse_wheel(dx: f64, dy: f64):
        var hit_idx = -1
        var i = 0
        while i < self.windows.len():
            val win = self.windows[i]
            if not win.minimized and self.pointer_x >= win.x and self.pointer_x < win.x + win.w and self.pointer_y >= win.y and self.pointer_y < win.y + win.h:
                hit_idx = i
            i = i + 1
        if hit_idx >= 0:
            val wid = self.windows[hit_idx].id
            # Sandboxed external frames own page scrolling. Retaining a
            # parent offset only dirties and redraws the same pixels.
            if self.requires_external_web_frame(wid):
                return
            val current = self.scroll_offsets.get(wid) ?? 0.0
            self.scroll_offsets[wid] = current + dy
            # Scroll changes rendered content without touching self.windows,
            # so the geometry diff in _mark_geometry_damage would miss it —
            # mark the scrolled window's own rect dirty directly.
            val scrolled = self.windows[hit_idx]
            self.dirty.add_rect(scrolled.x, scrolled.y, scrolled.w, scrolled.h)

    me scroll_offset_for(window_id: i64) -> f64:
        self.scroll_offsets.get(window_id) ?? 0.0

    me record_launch_failure(index: i32):
        if index < 0 or index >= self.app_processes.len():
            return
        var proc = self.app_processes[index]
        proc.failed = true
        self.app_processes[index] = proc
        val id = self.next_window_id
        self.next_window_id = self.next_window_id + 1
        self.windows.push(HostedWindow(id: id, owner_port: 0, title: proc.title + " failed", x: 40, y: 80, w: 360, h: 180, content: "failed to create a window for " + proc.app_id, process_id: proc.pid, app_id: proc.app_id, content_owner: HOST_CONTENT_OWNER_LOCAL_WEB, minimized: false, focused: true))
        self.dirty.add_rect(40, 80, 360, 180)

# ============================================================================
# I8 region-dirty background math (plan item B follow-up 1,
# doc/03_plan/os/desktop/wm_window_render_api_hardening_plan.md). Pure
# rectangle arithmetic — no backend/FFI calls — computing exactly which
# desktop sub-rects a background-only redraw is allowed to touch without
# corrupting window content a prior full render_frame() drew on top of it.
# ============================================================================

# Safety cap on the rect-subtraction fan-out (each window can split an
# existing rect into up to 4 pieces). Real hosted-WM window counts are small
# (single digits); this cap only guards a pathological layout from doing
# unbounded work — see host_background_visible_rects' `computed: false`
# escape hatch.
val HOST_BACKGROUND_REGION_DIRTY_MAX_RECTS: i32 = 256

struct HostBackgroundRegion:
    rects: [SharedWmRect]
    computed: bool

# Splits `a` into the axis-aligned pieces NOT covered by `b` (0-4 pieces):
# top/bottom strips spanning the full width of `a`, then left/right strips
# spanning only the vertical span where `a` and `b` actually overlap. No
# overlap -> `a` is returned unchanged.
fn _host_rect_subtract_one(a: SharedWmRect, b: SharedWmRect) -> [SharedWmRect]:
    val ax0 = a.x
    val ay0 = a.y
    val ax1 = a.x + a.width
    val ay1 = a.y + a.height
    val bx0 = b.x
    val by0 = b.y
    val bx1 = b.x + b.width
    val by1 = b.y + b.height
    if bx1 <= ax0 or bx0 >= ax1 or by1 <= ay0 or by0 >= ay1:
        return [a]
    var out: [SharedWmRect] = []
    if by0 > ay0:
        out.push(SharedWmRect(x: ax0, y: ay0, width: ax1 - ax0, height: by0 - ay0))
    if by1 < ay1:
        out.push(SharedWmRect(x: ax0, y: by1, width: ax1 - ax0, height: ay1 - by1))
    var my0 = ay0
    if by0 > ay0:
        my0 = by0
    var my1 = ay1
    if by1 < ay1:
        my1 = by1
    if bx0 > ax0:
        out.push(SharedWmRect(x: ax0, y: my0, width: bx0 - ax0, height: my1 - my0))
    if bx1 < ax1:
        out.push(SharedWmRect(x: bx1, y: my0, width: ax1 - bx1, height: my1 - my0))
    out

# Desktop rect minus the union of every visible (non-minimized) window rect —
# the exact set of pixels a background-only redraw may touch. `computed:
# false` is the correctness escape hatch: a pathological window layout that
# blows the rect-count safety cap aborts the computation rather than
# returning a partial (and therefore wrong) region — render_background_only
# treats that as "region can't be cheaply computed" and its caller falls back
# to a full render_frame().
fn host_background_visible_rects(windows: [HostedWindow], width: i32, height: i32) -> HostBackgroundRegion:
    if width <= 0 or height <= 0:
        return HostBackgroundRegion(rects: [], computed: true)
    var rects: [SharedWmRect] = [SharedWmRect(x: 0, y: 0, width: width, height: height)]
    for win in windows:
        if not win.minimized and win.w > 0 and win.h > 0:
            val hole = SharedWmRect(x: win.x, y: win.y, width: win.w, height: win.h)
            var next_rects: [SharedWmRect] = []
            for r in rects:
                for piece in _host_rect_subtract_one(r, hole):
                    if piece.width > 0 and piece.height > 0:
                        next_rects.push(piece)
            if next_rects.len() > HOST_BACKGROUND_REGION_DIRTY_MAX_RECTS:
                return HostBackgroundRegion(rects: [], computed: false)
            rects = next_rects
    HostBackgroundRegion(rects: rects, computed: true)

# Smallest rect containing every rect in `rects` — used to give
# backend.present_rect a single bounding invalidation rect for a
# background-only frame instead of one call per sub-rect.
fn host_background_bounding_rect(rects: [SharedWmRect]) -> SharedWmRect:
    var min_x = rects[0].x
    var min_y = rects[0].y
    var max_x = rects[0].x + rects[0].width
    var max_y = rects[0].y + rects[0].height
    for r in rects:
        if r.x < min_x:
            min_x = r.x
        if r.y < min_y:
            min_y = r.y
        val rx1 = r.x + r.width
        val ry1 = r.y + r.height
        if rx1 > max_x:
            max_x = rx1
        if ry1 > max_y:
            max_y = ry1
    SharedWmRect(x: min_x, y: min_y, width: max_x - min_x, height: max_y - min_y)

# Crops the (full-desktop-sized) resolved background surface down to `rect`'s
# sub-window so blit_pixels only writes the region host_background_visible_rects
# said is safe. Out-of-range reads (should not happen — the surface is sized
# to the same width/height the resolver was called with) degrade to opaque
# black rather than indexing out of bounds.
fn host_background_crop_surface(surface: BackgroundSurface, rect: SharedWmRect, full_width: i32) -> [u32]:
    # Pre-size once + index-store per pixel — NOT per-pixel `out.push`. Index
    # assignment hits the interpreter's strong_count==1 in-place fast path
    # (O(1)/element), whereas `arr.push` clones the whole growing array on
    # every call (O(N^2) — the measured CPU-lane anti-pattern). This runs on
    # the background-only motion path over the (large) desktop-minus-windows
    # region, so the quadratic form would dominate an animated frame. Default
    # fill is opaque black for the (should-not-happen) out-of-range reads.
    val n = rect.width * rect.height
    if n <= 0:
        return []
    var out: [u32] = [0xFF000000u32; n]
    val total = surface.pixels.len()
    var row = 0
    while row < rect.height:
        val row_start = (rect.y + row) * full_width + rect.x
        val out_row = row * rect.width
        var col = 0
        while col < rect.width:
            val idx = row_start + col
            if idx >= 0 and idx < total:
                out[out_row + col] = surface.pixels[idx]
            col = col + 1
        row = row + 1
    out

# Observability counter for HostWmHandle.pump_host_events: this file only ever
# constructs Headless handles (init_headless_host_wm), and no backend reached
# from here exposes a host event source, so the pump legitimately has zero
# events to translate. Counting each no-op tick keeps that honest and
# observable instead of a silent always-0 return (repo pattern: counted
# rejection, same as vulkan_compositor_backend.reject / simd_batch_hits).
var _host_wm_event_pump_noop_ticks: i64 = 0

fn _host_wm_note_event_pump_noop():
    _host_wm_event_pump_noop_ticks = _host_wm_event_pump_noop_ticks + 1

fn host_wm_event_pump_noop_ticks() -> i64:
    _host_wm_event_pump_noop_ticks

class HostWmLoopState:
    running: bool

class HostWmHandle:
    compositor: HostCompositor
    wm: HostWmLoopState
    event_loop_id: i64
    window_id: i64
    backend: HostBackendKind

    fn pump_host_events() -> i64:
        """Returns the number of host events pumped. Headless handles (the only
        kind this file constructs) have no host event source, so this is always
        0 — each live-handle tick is recorded in host_wm_event_pump_noop_ticks()
        so the no-op is observable rather than silent."""
        if self.event_loop_id == 0:
            return 0
        _host_wm_note_event_pump_noop()
        0

    me run_once():
        if not self.wm.running:
            return
        self.compositor.render_frame()

    me tick_forever():
        while self.wm.running:
            self.pump_host_events()
            self.run_once()
            rt_sleep_ms(HOST_WM_IDLE_SLEEP_MS.to_i64())

# Minimal headless-only WM init (item 5 of the WM hardening plan: "WM core
# must be VERY SMALL"). Builds a HostWmHandle the same way the Headless arm
# of host_compositor_bootstrap.init_host_wm's _create_backend_for_kind does
# (HeadlessHostCompositorBackend as the CompositorBackend, plain
# HostCompositor.new -- deliberately NOT new_headless's native_pixel_lane
# variant, to keep this byte-identical to the path the daemon already
# exercised), just reached without going through that file's
# _create_backend_for_kind/background-provider wiring. A caller that imports
# ONLY host_compositor_core (not host_compositor_entry, which re-exports
# host_compositor_bootstrap.*) never pulls hosted_backend_sdl2 /
# hosted_backend_cocoa / hosted_backend_win32 / background_image_provider /
# background_motion_provider into its module graph, so the resident daemon
# process (which only ever needs Headless -- see wm_daemon.wm_daemon_build_handle)
# can stay on this lean entry instead. No compositor refactor: HostCompositor
# itself is untouched, this is purely an alternate top-level constructor.
fn init_headless_host_wm(cfg: HostWmConfig) -> HostWmHandle:
    val w = cfg.initial_size.width.to_i32()
    val h = cfg.initial_size.height.to_i32()
    val backend = HeadlessHostCompositorBackend.new(w, h)
    val comp = HostCompositor.new(backend, cfg.initial_size)
    val wm = HostWmLoopState(running: true)
    HostWmHandle(compositor: comp, wm: wm, event_loop_id: 1, window_id: 1, backend: HostBackendKind.Headless)

class SimpleOsGuiAdapter:
    compositor: HostCompositor
    delivered_input_events: i64
    delivered_bridge_events: i64
    presented_frames: i64

    static fn new(backend: CompositorBackend, size: Size) -> SimpleOsGuiAdapter:
        SimpleOsGuiAdapter(
            compositor: HostCompositor.new(backend, size),
            delivered_input_events: 0,
            delivered_bridge_events: 0,
            presented_frames: 0
        )

    me deliver_bridge_request(seq: i64, owner_port: i64, method: i64, window_id: i64, title: text, x: i32, y: i32, w: i32, h: i32, content: text, process_id: i64, app_id: text):
        self.delivered_bridge_events = self.delivered_bridge_events + 1
        self.compositor.apply_bridge_request(seq, owner_port, method, window_id, title, x, y, w, h, content, process_id, app_id)

    me deliver_pointer_move(x: i32, y: i32):
        self.delivered_input_events = self.delivered_input_events + 1
        self.compositor = host_compositor_pointer_move(self.compositor, x, y)

    me deliver_left_button(down: bool):
        self.delivered_input_events = self.delivered_input_events + 1
        self.compositor = host_compositor_left_button(self.compositor, down)

    me render_framebuffer_frame():
        self.compositor.render_frame()
        self.presented_frames = self.presented_frames + 1

fn simpleos_gui_adapter_display_path_name(adapter: SimpleOsGuiAdapter) -> text:
    if adapter.compositor.width <= 0 or adapter.compositor.height <= 0:
        return "invalid"
    "simpleos-framebuffer"

fn simpleos_gui_adapter_content_renderer_name(adapter: SimpleOsGuiAdapter) -> text:
    if simpleos_gui_adapter_display_path_name(adapter) == "invalid":
        return "unsupported"
    WEB_RENDER_TARGET_SIMPLE_WEB

fn host_wm_surface_failure_reason(cfg: HostWmConfig, event_loop_id: i64, window_id: i64) -> text?:
    if cfg.backend == HostBackendKind.Tui:
        return "tui host compositor bootstrap is not implemented"
    if (cfg.initial_size.width as i32) <= 0 or (cfg.initial_size.height as i32) <= 0:
        return "host compositor size must be nonzero"
    if event_loop_id == 0 or window_id == 0:
        return "host compositor surface must be nonzero"
    nil

fn host_wm_content_renderer_name(handle: HostWmHandle) -> text:
    if handle.backend == HostBackendKind.Tui:
        return "unsupported"
    WEB_RENDER_TARGET_SIMPLE_WEB

fn _host_find_window_by_id(windows: [HostedWindow], window_id: i64) -> i32:
    var i = 0
    while i < windows.len():
        if windows[i].id == window_id:
            return i
        i = i + 1
    -1

fn host_compositor_find_window_index(comp: HostCompositor, window_id: i64) -> i32:
    var i = 0
    while i < comp.windows.len():
        if comp.windows[i].id == window_id:
            return i
        i = i + 1
    -1

fn host_compositor_close_release_target(
    comp: HostCompositor, button: i64, down: bool
) -> i64:
    if (button != 0 or down or
        comp.armed_chrome_target != "close"):
        return 0
    val index = host_compositor_find_window_index(
        comp, comp.armed_chrome_window_id
    )
    if index < 0:
        return 0
    val win = comp.windows[index]
    if (not win.minimized and
        comp.pointer_x >= win.x + win.w - 24 and
        comp.pointer_x < win.x + win.w and
        comp.pointer_y >= win.y and comp.pointer_y < win.y + 24):
        return win.id
    0

fn host_compositor_update_window_content(comp: HostCompositor, window_id: i64, body_html: text) -> HostCompositor:
    var out = comp
    out.update_window_content(window_id, body_html)
    out

fn host_compositor_update_window_title(
    comp: HostCompositor, window_id: i64, title: text
) -> HostCompositor:
    var out = comp
    out.update_window_title(window_id, title)
    out

fn host_window_to_lifecycle_state(win: HostedWindow) -> WmLifecycleWindowState:
    WmLifecycleWindowState(id: win.id, owner_port: win.owner_port, title: win.title, x: win.x, y: win.y, w: win.w, h: win.h, content: win.content, process_id: win.process_id, app_id: win.app_id, content_owner: win.content_owner, minimized: win.minimized, focused: win.focused, maximized: win.maximized, restore_x: win.restore_x, restore_y: win.restore_y, restore_w: win.restore_w, restore_h: win.restore_h)

fn host_window_from_lifecycle_state(win: WmLifecycleWindowState) -> HostedWindow:
    HostedWindow(id: win.id, owner_port: win.owner_port, title: win.title, x: win.x, y: win.y, w: win.w, h: win.h, content: win.content, process_id: win.process_id, app_id: win.app_id, content_owner: win.content_owner, minimized: win.minimized, focused: win.focused, maximized: win.maximized, restore_x: win.restore_x, restore_y: win.restore_y, restore_w: win.restore_w, restore_h: win.restore_h)

fn host_windows_to_lifecycle_state(windows: [HostedWindow]) -> [WmLifecycleWindowState]:
    var out: [WmLifecycleWindowState] = []
    var i = 0
    while i < windows.len():
        out.push(host_window_to_lifecycle_state(windows[i]))
        i = i + 1
    out

fn host_windows_from_lifecycle_state(windows: [WmLifecycleWindowState]) -> [HostedWindow]:
    var out: [HostedWindow] = []
    var i = 0
    while i < windows.len():
        out.push(host_window_from_lifecycle_state(windows[i]))
        i = i + 1
    out

fn host_compositor_apply_lifecycle_action(comp: HostCompositor, action: WmAction) -> HostCompositor:
    var out = comp
    val result = apply_wm_action_to_lifecycle_windows(host_windows_to_lifecycle_state(out.windows), out.next_window_id, out.width, out.height, action)
    out.windows = host_windows_from_lifecycle_state(result.windows)
    out.next_window_id = result.next_window_id
    out

fn host_compositor_pointer_move(comp: HostCompositor, x: i32, y: i32) -> HostCompositor:
    var out = comp
    val prior_windows = comp.windows
    val interaction = WmPointerInteractionState(dragging: out.dragging, drag_window_id: out.drag_window_id, drag_offset_x: out.drag_offset_x, drag_offset_y: out.drag_offset_y, resizing: out.resizing, resize_window_id: out.resize_window_id, resize_start_x: out.resize_start_x, resize_start_y: out.resize_start_y, resize_start_w: out.resize_start_w, resize_start_h: out.resize_start_h)
    val result = wm_lifecycle_pointer_move(host_windows_to_lifecycle_state(out.windows), out.next_window_id, out.width, out.height, interaction, x, y)
    out.windows = host_windows_from_lifecycle_state(result.windows)
    # The host_windows_to/from_lifecycle_state round-trip above goes through
    # WmLifecycleWindowState, which doesn't carry passthrough_* OR
    # maximized/restore_*, so every pointer move would otherwise silently
    # erase a window's declared click-through region AND reset its
    # maximize/restore bookkeeping (a later unmaximize would then restore to
    # 0,0,0,0). Restore both families from the pre-move snapshot, same
    # pattern as apply_wm_action's restore block. This lives here (not in
    # each caller) so HostCompositor.pointer_move AND
    # SimpleOsGuiAdapter.deliver_pointer_move -- both of which call this
    # function directly -- share one fix instead of each needing its own
    # copy of the restoration loop.
    var wi = 0
    while wi < out.windows.len():
        var wj = 0
        while wj < prior_windows.len():
            if out.windows[wi].id == prior_windows[wj].id:
                var mw = out.windows[wi]
                mw.maximized = prior_windows[wj].maximized
                mw.restore_x = prior_windows[wj].restore_x
                mw.restore_y = prior_windows[wj].restore_y
                mw.restore_w = prior_windows[wj].restore_w
                mw.restore_h = prior_windows[wj].restore_h
                mw.passthrough_x = prior_windows[wj].passthrough_x
                mw.passthrough_y = prior_windows[wj].passthrough_y
                mw.passthrough_w = prior_windows[wj].passthrough_w
                mw.passthrough_h = prior_windows[wj].passthrough_h
                out.windows[wi] = mw
            wj = wj + 1
        wi = wi + 1
    out.next_window_id = result.next_window_id
    out.dragging = result.interaction.dragging
    out.drag_window_id = result.interaction.drag_window_id
    out.drag_offset_x = result.interaction.drag_offset_x
    out.drag_offset_y = result.interaction.drag_offset_y
    out.resizing = result.interaction.resizing
    out.resize_window_id = result.interaction.resize_window_id
    out.resize_start_x = result.interaction.resize_start_x
    out.resize_start_y = result.interaction.resize_start_y
    out.resize_start_w = result.interaction.resize_start_w
    out.resize_start_h = result.interaction.resize_start_h
    out

fn host_compositor_left_button(comp: HostCompositor, down: bool) -> HostCompositor:
    host_compositor_left_button_at(comp, down, comp.pointer_x, comp.pointer_y)

fn host_compositor_left_button_at(comp: HostCompositor, down: bool, x: i32, y: i32) -> HostCompositor:
    var out = comp
    out.pointer_x = x
    out.pointer_y = y
    if down:
        # Clear any stale arming from a previous down whose matching up was
        # missed (defensive; the release path below always clears its own arm).
        out.armed_chrome_target = ""
        out.armed_chrome_window_id = 0
        out.armed_chrome_app_id = ""
        # Taskbar click: a press inside the bottom dock band that lands on a
        # window's taskbar item is a chrome ACTION (focus + restore-if-
        # minimized). Arm it on down; it fires only on a release whose
        # hit-test still resolves to the same taskbar item (release-inside).
        # A drag-away before release cancels it (see the `else` branch below).
        # Checked before the window hit-test because the dock band can
        # overlap a window that extends to the bottom of the desktop.
        val tb_id = out.hit_taskbar(x, y)
        if tb_id > 0:
            out.armed_chrome_target = "taskbar"
            out.armed_chrome_window_id = tb_id
            return out
        if out.native_pixel_lane:
            val pinned_app_id = out._hit_shared_pinned_app(x, y)
            if pinned_app_id != "":
                out.armed_chrome_target = "taskbar-launch"
                out.armed_chrome_app_id = pinned_app_id
                return out
        var hit_idx = -1
        var i = 0
        while i < out.windows.len():
            val win = out.windows[i]
            if not win.minimized and x >= win.x and x < win.x + win.w and y >= win.y and y < win.y + win.h:
                hit_idx = i
            i = i + 1
        if hit_idx >= 0:
            val hit = out.windows[hit_idx]
            if x >= hit.x + hit.w - 24 and y >= hit.y and y < hit.y + 24:
                # Close button is a chrome ACTION: arm, fire on release-inside.
                out.armed_chrome_target = "close"
                out.armed_chrome_window_id = hit.id
                return out
            # Window-body focus and titlebar drag-arming are unchanged
            # (not converted to release-based semantics).
            out.focus_window(hit.id)
            if y >= hit.y and y < hit.y + 28:
                out.dragging = true
                out.drag_window_id = hit.id
                out.drag_offset_x = x - hit.x
                out.drag_offset_y = y - hit.y
                return out
    else:
        # Release: fire the armed chrome action only if the release hit-test
        # still resolves to the same target (release-inside). Moving away
        # before release (a different taskbar item / off the close button /
        # a different window entirely) cancels the action; the armed state is
        # cleared unconditionally below either way.
        if out.armed_chrome_target == "taskbar":
            val tb_id2 = out.hit_taskbar(x, y)
            if tb_id2 == out.armed_chrome_window_id:
                out.focus_window(tb_id2)
        elif out.armed_chrome_target == "taskbar-launch":
            val launch_app_id = out._hit_shared_pinned_app(x, y)
            if launch_app_id == out.armed_chrome_app_id:
                out.pending_taskbar_launch_app_id = launch_app_id
        elif out.armed_chrome_target == "close":
            val close_target = host_compositor_close_release_target(
                out, 0, false
            )
            if close_target > 0:
                out.destroy_window(close_target)
        out.armed_chrome_target = ""
        out.armed_chrome_window_id = 0
        out.armed_chrome_app_id = ""
    val interaction = wm_lifecycle_left_button(WmPointerInteractionState(dragging: out.dragging, drag_window_id: out.drag_window_id, drag_offset_x: out.drag_offset_x, drag_offset_y: out.drag_offset_y, resizing: out.resizing, resize_window_id: out.resize_window_id, resize_start_x: out.resize_start_x, resize_start_y: out.resize_start_y, resize_start_w: out.resize_start_w, resize_start_h: out.resize_start_h), down)
    out.dragging = interaction.dragging
    out.drag_window_id = interaction.drag_window_id
    out.drag_offset_x = interaction.drag_offset_x
    out.drag_offset_y = interaction.drag_offset_y
    out.resizing = interaction.resizing
    out.resize_window_id = interaction.resize_window_id
    out.resize_start_x = interaction.resize_start_x
    out.resize_start_y = interaction.resize_start_y
    out.resize_start_w = interaction.resize_start_w
    out.resize_start_h = interaction.resize_start_h
    out

fn host_compositor_cycle_focus(comp: HostCompositor) -> HostCompositor:
    var out = comp
    if out.windows.len() == 0:
        return out
    var focused_idx = -1
    var i = 0
    while i < out.windows.len():
        if out.windows[i].focused:
            focused_idx = i
        i = i + 1
    var step = 1
    while step <= out.windows.len():
        val next_idx = (focused_idx + step) % out.windows.len()
        if not out.windows[next_idx].minimized:
            out.focus_window(out.windows[next_idx].id)
            return out
        step = step + 1
    out

fn host_compositor_focused_window_id(comp: HostCompositor) -> i64:
    var i = 0
    while i < comp.windows.len():
        if comp.windows[i].focused:
            return comp.windows[i].id
        i = i + 1
    0

fn host_compositor_minimize_focused(comp: HostCompositor) -> HostCompositor:
    val id = host_compositor_focused_window_id(comp)
    if id <= 0:
        return comp
    var out = comp
    out.apply_bridge_request(0, 0, COMP_MINIMIZE.to_i64(), id, "", 0, 0, 0, 0, "", 0, "")
    out

fn host_compositor_maximize_focused(comp: HostCompositor) -> HostCompositor:
    val id = host_compositor_focused_window_id(comp)
    if id <= 0:
        return comp
    var out = comp
    out.apply_bridge_request(0, 0, COMP_MAXIMIZE.to_i64(), id, "", 0, 0, 0, 0, "", 0, "")
    out

fn host_compositor_restore_all(comp: HostCompositor) -> HostCompositor:
    var out = comp
    var i = 0
    while i < out.windows.len():
        out.apply_bridge_request(0, 0, COMP_RESTORE.to_i64(), out.windows[i].id, "", 0, 0, 0, 0, "", 0, "")
        i = i + 1
    out

fn host_taskbar_item_width(screen_width: i32, count: i32) -> i32:
    wm_taskbar_item_width(screen_width, count)

fn host_taskbar_dock_width(screen_width: i32, count: i32) -> i32:
    wm_taskbar_dock_width(screen_width, count)

fn host_taskbar_item_x(screen_width: i32, count: i32, index: i32) -> i32:
    wm_taskbar_item_x(screen_width, count, index)

fn host_compositor_draw_taskbar(backend: CompositorBackend, windows: [HostedWindow], width: i32, height: i32, theme: WmChromeColors):
    """Draw the taskbar dock with one item per window (minimized included —
    that is how restore works). Geometry mirrors wm_lifecycle_hit_taskbar
    EXACTLY (band at height-62, 44 tall; centered items) so what the user
    clicks is what they see. Item colors come from the shared theme:
    focused window -> title_focused, minimized -> window body, else
    unfocused titlebar color."""
    val count = windows.len() as i32
    if count <= 0:
        return
    val dock_w = wm_taskbar_dock_width(width, count)
    val dock_x = (width - dock_w) / 2
    val dock_y = height - 62
    backend.fill_rect(dock_x, dock_y, dock_w, 44, theme.taskbar)
    val item_w = wm_taskbar_item_width(width, count)
    var i: i32 = 0
    while i < count:
        val win = windows[i]
        val ix = wm_taskbar_item_x(width, count, i)
        var item_color = theme.title_unfocused
        if win.focused and not win.minimized:
            item_color = theme.title_focused
        elif win.minimized:
            item_color = theme.host_window_body
        backend.fill_rect(ix + 2, dock_y + 4, item_w - 4, 36, item_color)
        backend.draw_text(ix + 8, dock_y + 14, win.title, theme.text_primary, item_color)
        i = i + 1

# Convert an opaque ARGB u32 (as stored in WmChromeColors) to a CSS "#RRGGBB"
# hex string. The alpha byte is dropped: the host chrome colors are all opaque
# (0xFF..) and the CSS engine rasterizes #RRGGBB back to the same 0xFF ARGB u32,
# so the fast-lane chrome pixels are byte-identical to the direct-draw colors.
fn _argb_to_css_hex(color: u32) -> text:
    val r = ((color / 65536u32) % 256u32).to_i64()
    val g = ((color / 256u32) % 256u32).to_i64()
    val b = (color % 256u32).to_i64()
    "#" + int_to_hex(r) + int_to_hex(g) + int_to_hex(b)

# Aqua titlebar gloss (scout prototype, CSS evidence backend): shift each RGB
# channel of an opaque ARGB u32 by `delta` (positive lightens, negative
# darkens), clamped to u8. Mirrors _wm_titlebar_shade in
# window_scene_draw_ir.spl but kept local (no cross-module private-fn
# coupling) since this backend renders titlebars as CSS, not fill_rect rows.
fn _host_argb_shade(color: u32, delta: i64) -> u32:
    val r = ((color / 65536u32) % 256u32).to_i64()
    val g = ((color / 256u32) % 256u32).to_i64()
    val b = (color % 256u32).to_i64()
    val cr = if r + delta < 0: 0 elif r + delta > 255: 255 else: r + delta
    val cg = if g + delta < 0: 0 elif g + delta > 255: 255 else: g + delta
    val cb = if b + delta < 0: 0 elif b + delta > 255: 255 else: b + delta
    0xFF000000u32 | (cr.to_u32() << 16) | (cg.to_u32() << 8) | cb.to_u32()

# Build the host WM chrome as a single HTML/CSS document. Element geometry and
# colors mirror the direct-draw chrome in render_frame() exactly (desktop
# backdrop = compositor_bg, window body = host_window_body, titlebar =
# title_focused, close button = close_button, title/close glyph text =
# text_primary). title_focused (not accent) fills the titlebar so
# text_primary's dark glyphs stay legible on it — accent is reserved for
# thin stripes that never carry text directly. Colors flow from
# wm_chrome_theme() — the single source of truth — so an installed theme
# reskins the chrome automatically.
fn host_chrome_scene_html(windows: [HostedWindow], width: i32, height: i32) -> text:
    val theme = wm_chrome_theme()
    val bg_hex = _argb_to_css_hex(theme.compositor_bg)
    val body_hex = _argb_to_css_hex(theme.host_window_body)
    val title_focused_hex = _argb_to_css_hex(theme.title_focused)
    val titlebar_gloss_top_hex = _argb_to_css_hex(_host_argb_shade(theme.title_focused, 14))
    val titlebar_gloss_bottom_hex = _argb_to_css_hex(_host_argb_shade(theme.title_focused, 0 - 14))
    val titlebar_border_hex = _argb_to_css_hex(_host_argb_shade(theme.title_focused, 0 - 40))
    val close_hex = _argb_to_css_hex(theme.close_button)
    val text_hex = _argb_to_css_hex(theme.text_primary)
    var body = ""
    for win in windows:
        if not win.minimized:
            val close_x = win.x + win.w - 24
            val title_x = win.x + 8
            val title_y = win.y + 4
            val close_text_x = win.x + win.w - 17
            val title_w = if win.w - 40 > 0: win.w - 40 else: 0
            body = body + "<div style='position:absolute;left:{win.x}px;top:{win.y}px;width:{win.w}px;height:{win.h}px;background:{body_hex}'></div>"
            body = body + "<div style='position:absolute;left:{win.x}px;top:{win.y}px;width:{win.w}px;height:23px;background:linear-gradient(to bottom, {titlebar_gloss_top_hex}, {titlebar_gloss_bottom_hex})'></div>"
            body = body + "<div style='position:absolute;left:{win.x}px;top:{win.y + 23}px;width:{win.w}px;height:1px;background:{titlebar_border_hex}'></div>"
            body = body + "<div style='position:absolute;left:{title_x}px;top:{title_y}px;width:{title_w}px;height:16px;color:{text_hex};font:12px monospace;overflow:hidden;white-space:nowrap'>{win.title}</div>"
            body = body + "<div style='position:absolute;left:{close_x}px;top:{win.y}px;width:24px;height:24px;background:{close_hex}'></div>"
            body = body + "<div style='position:absolute;left:{close_text_x}px;top:{title_y}px;width:16px;height:16px;color:{text_hex};font:12px monospace'>X</div>"
    # Taskbar dock: one item per window (minimized included — restore works
    # through its item). Geometry mirrors wm_lifecycle_hit_taskbar exactly
    # (band at height-62, 44 tall; centered items) so what the user clicks
    # is what they see.
    val tb_count = windows.len() as i32
    if tb_count > 0:
        val taskbar_hex = _argb_to_css_hex(theme.taskbar)
        val unfocused_hex = _argb_to_css_hex(theme.title_unfocused)
        val dock_w = wm_taskbar_dock_width(width, tb_count)
        val dock_x = (width - dock_w) / 2
        val dock_y = height - 62
        val item_w = wm_taskbar_item_width(width, tb_count)
        body = body + "<div style='position:absolute;left:{dock_x}px;top:{dock_y}px;width:{dock_w}px;height:44px;background:{taskbar_hex}'></div>"
        var ti = 0
        while ti < tb_count:
            val twin = windows[ti]
            val tix = wm_taskbar_item_x(width, tb_count, ti)
            var item_hex = unfocused_hex
            if twin.focused and not twin.minimized:
                item_hex = title_focused_hex
            elif twin.minimized:
                item_hex = body_hex
            val item_inner_w = item_w - 4
            val label_w = item_w - 16
            val label_y = dock_y + 14
            body = body + "<div style='position:absolute;left:{tix + 2}px;top:{dock_y + 4}px;width:{item_inner_w}px;height:36px;background:{item_hex}'></div>"
            body = body + "<div style='position:absolute;left:{tix + 8}px;top:{label_y}px;width:{label_w}px;height:16px;color:{text_hex};font:12px monospace;overflow:hidden;white-space:nowrap'>{twin.title}</div>"
            ti = ti + 1
    "<!DOCTYPE html><html><head><style>body{{margin:0;width:{width}px;height:{height}px;background:{bg_hex}}}</style></head><body>" + body + "</body></html>"

# Fingerprint the chrome-relevant scene state so render_frame() can reuse the
# cached CSS chrome pixels on unchanged scenes. Deliberately excludes window
# content (redrawn every frame) but includes size, theme colors, and every
# window's id/geometry/minimized/focused/title.
fn host_chrome_scene_fingerprint(windows: [HostedWindow], width: i32, height: i32) -> text:
    val theme = wm_chrome_theme()
    var fp = "{width}x{height}|{theme.compositor_bg}|{theme.host_window_body}|{theme.title_focused}|{theme.close_button}|{theme.text_primary}|{theme.taskbar}|{theme.title_unfocused}#"
    for win in windows:
        val minf = if win.minimized: 1 else: 0
        val focf = if win.focused: 1 else: 0
        fp = fp + "{win.id}:{win.x},{win.y},{win.w},{win.h},{minf},{focf},{win.title};"
    fp
