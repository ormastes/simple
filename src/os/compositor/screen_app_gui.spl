# `screen_type=gui` shell — host window-server surface.
#
# Host-only today. On a baremetal guest `resolve_screen_type` never yields
# `gui` (no host window server in the profile), so this opener is reached only
# on a host profile and never fabricates a guest surface.
#
# MDSOC: feature dimension, compositor layer

use os.compositor.display_backend_core.{CompositorBackend}
use os.compositor.screen_app.{ScreenApp, screen_app_new}

pub fn screen_app_gui_open(
    width: i32,
    height: i32,
    backend: CompositorBackend?,
    reason: text
) -> ScreenApp:
    """Bring up the gui shell. `backend` is nil on any target without a host
    window server; the shell then reports `is_live() == false` rather than
    pretending to paint."""
    screen_app_new("gui", width, height, backend, reason)

export screen_app_gui_open
