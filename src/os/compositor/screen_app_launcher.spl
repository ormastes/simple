# Screen-app launcher — dispatch a resolved `ScreenSelection` onto a shell,
# plus the HOST entry point for `SIMPLE_SCREEN_TYPE`.
#
# Two entry points, one decision function:
#   * guest — the kernel reads /etc/rc.conf (`rc_conf_screen_type`) and calls
#     `launch_screen_app` with the resulting `ScreenSelection`.
#   * host  — `launch_screen_app_from_env` reads `SIMPLE_SCREEN_TYPE` via
#     `screen_type_from_env_or` and runs the SAME `create_screen_backend` ->
#     `launch_screen_app` path.
# Both therefore go through `resolve_screen_type`, so host and guest select
# identically (AC-1) and the fallback logic exists exactly once.
#
# ---------------------------------------------------------------------------
# Adapter decision: this launcher targets `CompositorBackend`, NOT `ScreenHost`
# ---------------------------------------------------------------------------
# `common/ui/screen_host.spl` declares
# `present_scene(DrawIrV3Scene) -> bool` / `poll_input() -> HostInputEvent?`;
# `display_backend_core.spl` declares `CompositorBackend` as a pixel surface
# (`clear`/`fill_rect`/`blit_pixels`/`present`). A
# `screen_host_over(backend) -> ScreenHost` adapter would have to rasterize a
# `DrawIrV3Scene` into `blit_pixels` AND synthesize an input queue.
#
# It is NOT built here, for a falsifiable reason: no file in this tree would
# call it. `create_screen_backend` returns a `CompositorBackend?`, the shells
# consume exactly that, and nothing in `src/os/**` produces a `DrawIrV3Scene`
# today — the `ScreenHost` implementations are WS-B/B3 work that has not
# landed, and every current `ScreenHost` consumer lives under
# `src/app/{ui,wm}_showcase/**`. Writing the adapter now would add an unused
# rasterizer plus a stub input queue, which "NEVER add unused code" forbids and
# which would be coded against an unlanded producer.
#
# The bridge is therefore filed as follow-on work, blocked on B3: once a
# `ScreenHost` impl exists and a showcase app drives a shell, add
# `screen_host_bridge.spl` and have `ScreenApp` delegate to it. `ScreenApp` is
# shaped to allow that — it holds the surface, not a render policy.
#
# MDSOC: feature dimension, compositor layer

use os.compositor.backend_factory.{
    ScreenSelection,
    create_screen_backend,
    screen_selection_reason_or_none,
    screen_type_from_env_or
}
use os.compositor.screen_app.{ScreenApp, screen_app_new}
use os.compositor.screen_app_2d.{screen_app_2d_open}
use os.compositor.screen_app_web.{screen_app_web_open}
use os.compositor.screen_app_gui.{screen_app_gui_open}
use os.simpleos_config_matrix.{SimpleOsRuntimeProfile}

pub fn launch_screen_app(
    selection: ScreenSelection,
    width: i32,
    height: i32
) -> ScreenApp:
    """Dispatch on `selection.shell`. A `match`-shaped registry, never a Dict:
    dict reads of struct/class values are corrupt under native codegen.

    The `wm` floor is the default arm and carries a nil backend on the guest —
    the kernel owns those pixels through its verbatim BGA path, so a nil
    backend here means "kernel-painted", never "blank".
    """
    val reason = screen_selection_reason_or_none(selection.reason)
    if selection.shell == "2d":
        return screen_app_2d_open(width, height, selection.backend, reason)
    if selection.shell == "web":
        return screen_app_web_open(width, height, selection.backend, reason)
    if selection.shell == "gui":
        return screen_app_gui_open(width, height, selection.backend, reason)
    screen_app_new("wm", width, height, selection.backend, reason)

pub fn launch_screen_app_for(
    requested: text,
    width: i32,
    height: i32,
    profile: SimpleOsRuntimeProfile
) -> ScreenApp:
    """Resolve `requested` against `profile`, construct, and launch."""
    launch_screen_app(
        create_screen_backend(requested, width, height, profile),
        width,
        height
    )

pub fn launch_screen_app_from_env(
    default_type: text,
    width: i32,
    height: i32,
    profile: SimpleOsRuntimeProfile
) -> ScreenApp:
    """HOST entry point for `SIMPLE_SCREEN_TYPE`.

    This is the dispatcher `screen_type_from_env_or` was missing: the env var
    now reaches a real running shell instead of only a normalized string.
    Wiring it into `src/app/wm_showcase/**` is deferred — those files are
    frozen under a concurrent-agent edit lock — so a host caller invokes this
    directly.
    """
    launch_screen_app_for(
        screen_type_from_env_or(default_type),
        width,
        height,
        profile
    )

export launch_screen_app
export launch_screen_app_for
export launch_screen_app_from_env
