# `screen_type=2d` shell — engine2d compositor surface.
#
# The file WS-C's C5 codes against. Opening is deliberately separate from
# selection: `backend_factory.resolve_screen_type` has already decided that
# `2d` is supported on this profile before this is ever called.
#
# MDSOC: feature dimension, compositor layer

use os.compositor.display_backend_core.{CompositorBackend}
use os.compositor.screen_app.{ScreenApp, screen_app_new}

pub fn screen_app_2d_open(
    width: i32,
    height: i32,
    backend: CompositorBackend?,
    reason: text
) -> ScreenApp:
    """Bring up the 2d shell over an already-constructed engine2d backend.

    The renderer inside the 2d lane (`SIMPLE_2D_BACKEND`) is resolved by
    `Engine2dCompositorBackend.create_from_env` in the factory; this shell is
    renderer-agnostic on purpose.
    """
    screen_app_new("2d", width, height, backend, reason)

export screen_app_2d_open
