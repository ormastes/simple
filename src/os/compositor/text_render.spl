
use os.compositor.browser_compositor_backend.{set_backend_pixel_buffer_override}
use common.ui.glyph_bitmap_5x7.{glyph_index_for_char_code, glyph_row_bits}
use std.common.encoding.utf8.{text_codepoints}

fn text_width(content: text) -> i32:
    content.len().to_i32() * 8

fn text_width_2x(content: text) -> i32:
    text_width(content) * 2

fn _text_render_src_over(dst: u32, src: u32, alpha: i32) -> u32:
    val sr: i32 = ((src >> 16) & 0xFFu32).to_i32()
    val sg: i32 = ((src >> 8) & 0xFFu32).to_i32()
    val sb: i32 = (src & 0xFFu32).to_i32()
    val da: i32 = ((dst >> 24) & 0xFFu32).to_i32()
    val dr: i32 = ((dst >> 16) & 0xFFu32).to_i32()
    val dg: i32 = ((dst >> 8) & 0xFFu32).to_i32()
    val db: i32 = (dst & 0xFFu32).to_i32()
    val inv = 255 - alpha
    val rr = (sr * alpha + dr * inv) / 255
    val rg = (sg * alpha + dg * inv) / 255
    val rb = (sb * alpha + db * inv) / 255
    val ra = alpha + (da * inv) / 255
    ((ra.to_u32() & 0xFFu32) << 24) | ((rr.to_u32() & 0xFFu32) << 16) | ((rg.to_u32() & 0xFFu32) << 8) | (rb.to_u32() & 0xFFu32)

fn draw_text_at(backend, x: i32, y: i32, content: text, color: u32):
    draw_text_scaled(backend, x, y, content, color, 1)

fn draw_text_scaled(backend, x: i32, y: i32, content: text, color: u32, scale: i32):
    val alpha: i32 = ((color >> 24) & 0xFFu32).to_i32()
    if alpha <= 0:
        return
    val cps = text_codepoints(content)
    val count = cps.len().to_i32()
    if count <= 0:
        return
    val s = if scale > 0: scale else: 1
    var pixels = backend.get_pixel_buffer()
    var idx = 0
    while idx < count:
        val gi = glyph_index_for_char_code(cps[idx].to_i32())
        val ox = x + idx * 6 * s
        var row = 0
        while row < 7:
            val bits = glyph_row_bits(gi, row)
            if bits != 0:
                var col = 0
                while col < 5:
                    val mask = 1 << (4 - col)
                    if (bits & mask) != 0:
                        var dy = 0
                        while dy < s:
                            val py = y + row * s + dy
                            if py >= 0 and py < backend.height:
                                var dx = 0
                                while dx < s:
                                    val px = ox + col * s + dx
                                    if px >= 0 and px < backend.width:
                                        val pidx = py * backend.width + px
                                        if alpha >= 255:
                                            pixels[pidx] = color
                                        else:
                                            pixels[pidx] = _text_render_src_over(pixels[pidx], color, alpha)
                                    dx = dx + 1
                            dy = dy + 1
                    col = col + 1
            row = row + 1
        idx = idx + 1
    set_backend_pixel_buffer_override(backend, pixels)
    backend.report_damage(x, y, count * 6 * s, 7 * s)

fn draw_text_shadow(backend, x: i32, y: i32, content: text, color: u32, shadow_color: u32, shadow_alpha: i32):
    """Draw `content` with a 1px down-right drop shadow beneath it.

    The shadow colour's alpha channel is replaced by `shadow_alpha` (0..255);
    the raster path stores ARGB directly, so a consumer that composites the
    buffer honours the alpha.
    """
    val a = if shadow_alpha < 0: 0 else: (if shadow_alpha > 255: 255 else: shadow_alpha)
    val shadow = (shadow_color & 0x00FFFFFFu32) | (a.to_u32() << 24)
    draw_text_at(backend, x + 1, y + 1, content, shadow)
    draw_text_at(backend, x, y, content, color)
