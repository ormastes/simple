# Typed correlation boundary for an RV64 WM frame presented by Engine2D.
#
# The production caller passes the revision returned by
# `Engine2dWmFrameExecutor.render`. A zero return means that presentation
# failed and must never be promoted to WM readiness.

pub struct Rv64WmPresentReceipt:
    process_id: u64
    scene_revision: i64
    presented_revision: i64
    engine2d_presented: bool
    reason: text

pub fn rv64_wm_engine2d_present_receipt(
    process_id: u64,
    window_owner_process_id: u64,
    scene_revision: i64,
    executor_presented_revision: i64
) -> Rv64WmPresentReceipt:
    if process_id == 0u64:
        return Rv64WmPresentReceipt(process_id: process_id, scene_revision: scene_revision, presented_revision: executor_presented_revision, engine2d_presented: false, reason: "process-id-zero")
    if window_owner_process_id != process_id:
        return Rv64WmPresentReceipt(process_id: process_id, scene_revision: scene_revision, presented_revision: executor_presented_revision, engine2d_presented: false, reason: "window-owner-mismatch")
    if scene_revision <= 0:
        return Rv64WmPresentReceipt(process_id: process_id, scene_revision: scene_revision, presented_revision: executor_presented_revision, engine2d_presented: false, reason: "scene-revision-invalid")
    if executor_presented_revision != scene_revision:
        return Rv64WmPresentReceipt(process_id: process_id, scene_revision: scene_revision, presented_revision: executor_presented_revision, engine2d_presented: false, reason: "present-revision-mismatch")
    Rv64WmPresentReceipt(process_id: process_id, scene_revision: scene_revision, presented_revision: executor_presented_revision, engine2d_presented: true, reason: "presented")
