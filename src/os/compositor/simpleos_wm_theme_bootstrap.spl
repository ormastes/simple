# Freestanding-safe SimpleOS WM theme bootstrap owner.
#
# SimpleOS media does not carry the hosted package registry. The freestanding
# desktop entry points (x86_64 desktop + engine2d, arm64 desktop, riscv64
# desktop under examples/09_embedded/simple_os/arch/*/gui_entry_*.spl)
# install the exact generated snapshot before constructing their compositor
# so the first frame cannot observe Aqua defaults.

use common.ui.generated.aetheric_dark_theme_snapshot.{aetheric_dark_theme_render_snapshot}
use common.ui.theme_render_snapshot.{ThemeRenderSnapshot}
use common.ui.wm_chrome_theme.{apply_theme_render_snapshot_to_wm_chrome}
use common.ui.wm_theme_css.{apply_wm_css_theme_text}

fn install_generated_simpleos_wm_theme() -> ThemeRenderSnapshot:
    # Unlike the hosted bootstrap, the boot image deliberately has no package
    # registry. Do not inherit a process-global selection either: that can be
    # a prior hosted/Aqua scene in an in-process test harness. The guest's
    # canonical desktop contract is the generated, manifest-stamped Aetheric
    # material from its first frame onward.
    val snapshot = aetheric_dark_theme_render_snapshot()
    apply_theme_render_snapshot_to_wm_chrome(snapshot)
    snapshot

fn apply_simpleos_css_theme_override(css_text: text) -> bool:
    """Guest-side lazy wiring point for a VFS-mounted theme override (e.g.
    /THEME.CSS on the boot FAT32 image). Call this AFTER
    install_generated_simpleos_wm_theme() (so the generated Aetheric
    snapshot is the baseline) and AFTER VFS mount — never at module init,
    and never before the mount completes.

    Hands off to apply_wm_css_theme_text(), which only overrides the chrome
    palette when the CSS text actually contains at least one recognizable
    --wm-* token; empty/unreadable/garbage text is a no-op and the
    generated snapshot installed above keeps driving every chrome pipeline.
    Returns true when an override was installed.

    NOT called from this module or any freestanding entry point yet: no
    guest entry point reads the mounted theme file's bytes and passes them
    here. That VFS-read + call-site wiring is guest boot-order work (the
    module-init/VFS read-before-mount ordering landmine documented in
    wm_theme_css.spl) that has not been exercised or verified on real
    QEMU/board boot in this pass — see
    doc/08_tracking/bug/wm_theme_css_loaded_not_applied_2026-07-20.md."""
    apply_wm_css_theme_text(css_text)
