# Canonical Shared WM -> Draw IR -> Engine2D production frame executor.

use common.gpu.simpleos_host_gpu_draw_ir.{SimpleOsHostGpuImageResource, SimpleOsHostGpuImageResourceRevision, simpleos_host_gpu_image_resource}
use common.gpu.simpleos_host_gpu_protocol.{
    SIMPLEOS_HOST_GPU_PROTOCOL_VERSION,
    SIMPLEOS_HOST_GPU_NEGOTIATION_BUDGET_US,
    SIMPLEOS_HOST_GPU_STATUS_PASS,
    SIMPLEOS_HOST_GPU_STATUS_UNSUPPORTED,
    SIMPLEOS_HOST_GPU_REASON_INVALID_REQUEST,
    SIMPLEOS_HOST_GPU_REASON_TIMEOUT,
    SIMPLEOS_HOST_GPU_REASON_INVALID_HELLO,
    SIMPLEOS_HOST_GPU_REASON_STALE_GENERATION,
    SIMPLEOS_HOST_GPU_BACKEND_DIRECTX,
    SIMPLEOS_HOST_GPU_BACKEND_METAL,
    SIMPLEOS_HOST_GPU_BACKEND_VULKAN,
    simpleos_host_gpu_backend_name,
    simpleos_host_gpu_backend_mask,
    simpleos_host_gpu_guest_isa_name,
    simpleos_host_gpu_max_readback_bytes
}
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU, DrawIrComposition,
    draw_ir_batch_with_source, draw_ir_embedding_config_geometry,
    draw_ir_image_command, draw_ir_source_manual
}
use common.ui.taskbar_model.{TaskbarModel}
use common.ui.window_scene.{SharedWmScene, SharedWmWindow, WmContentFrame, wm_content_frame_checksum, wm_content_frame_web_provenance_valid}
use common.ui.window_scene_draw_ir.{
    shared_wm_content_frame_for_window,
    shared_wm_content_frame_image_uri,
    shared_wm_content_frame_positioned_image_uri,
    shared_wm_nested_content_frames,
    shared_wm_scene_draw_ir_composition_with_content,
    shared_wm_scene_window_content_rect_with_titlebar
}
use std.gc_async_mut.gpu.engine2d.engine_target.{Engine2D}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    Engine2dResolvedDrawIrImage,
    engine2d_draw_ir_adv_composition_present_with_images_evidence,
    engine2d_draw_ir_adv_composition_present_with_owner_xy_evidence,
    engine2d_draw_ir_adv_composition_present_prepared_with_images_evidence,
    engine2d_draw_ir_adv_composition_present_prepared_with_images_xy_evidence,
    engine2d_draw_ir_adv_set_owner_image_xy,
    engine2d_draw_ir_adv_clear_owner_image_xy,
    engine2d_draw_ir_adv_present_prepared_scanout_evidence,
    engine2d_draw_ir_adv_replay_prepared_scanout,
    engine2d_draw_ir_adv_capture_prepared_scanout,
    engine2d_resolved_draw_ir_image
}
use os.drivers.framebuffer.fb_driver.{FramebufferDriver}
use os.kernel.boot.monotonic_hardware.{boot_monotonic_deadline_us, boot_monotonic_elapsed_us, boot_monotonic_now_us}
use os.lib.gpu_bridge.host_gpu_ivshmem.{
    HOST_GPU_IVSHMEM_DEFAULT_TIMEOUT_POLLS,
    host_gpu_ivshmem_device_receipt_valid,
    host_gpu_ivshmem_negotiate,
    host_gpu_ivshmem_next_generation,
    host_gpu_ivshmem_submit_draw_ir,
    host_gpu_ivshmem_submit_draw_ir_retained
}

extern fn serial_println(msg: text)

# Level gate for the frame-executor trace receipts. DEFAULT OFF — flip to true
# to re-arm the window-loop/composition/present bisection from the 2026-07-26
# pointer-release investigation. Kept rather than deleted per the log-retention
# policy. Does NOT cover [wm-frame] content-presented / frame-degraded /
# engine2d-draw-ir-rejected — those are evidence and fail-closed receipts that
# must always print.
val _WM_TRACE: bool = false

fn engine2d_wm_draw_ir_backend_target(host_gpu_active: bool, host_gpu_backend: text, cpu_simd_enabled: bool) -> text:
    if host_gpu_active and host_gpu_backend != "":
        return host_gpu_backend
    if cpu_simd_enabled:
        return "cpu_simd"
    DRAW_IR_BACKEND_CPU

# A negotiated host target changes the producer's material contract (not just
# the execution preference).  Rebuilding is required when a failed host frame
# must be rendered locally under a different concrete target.
fn engine2d_wm_draw_ir_local_recompose_required(host_target: text, local_target: text) -> bool:
    host_target != local_target

class Engine2dWmFrameExecutor:
    engine: Engine2D
    framebuffer: FramebufferDriver
    host_gpu_base: u64
    host_gpu_run_id_hash: i64
    host_gpu_backend: text
    host_gpu_backend_code: i64
    draw_ir_backend_target: text
    # Immutable local material target. Host negotiation may change only the
    # host target above; this keeps the CPU/CPU-SIMD fallback contract intact.
    local_draw_ir_backend_target: text
    # Trusted scanout dims threaded in by the caller. native-build shifts
    # cross-module FramebufferDriver `.width`/`.height` field reads by one slot
    # (the [u32] back_buffer/host_buffer array fields before them mis-size the
    # class layout as seen here), so reading fb.width here yields garbage. When
    # >0 these trusted scalars override the field read. 0 = field-read fallback
    # (arm64/riscv64 callers that pass no dims — unchanged behavior).
    fb_w: i64
    fb_h: i64
    # Cross-frame image-resource retention table (revision-keyed by
    # image_uri, no pixel bytes). Threaded through host_gpu_ivshmem_submit_draw_ir_retained;
    # empty whenever retention isn't negotiated with the host, or after any
    # non-PASS receipt (fail closed — next frame re-sends full resources).
    image_resource_revisions: [SimpleOsHostGpuImageResourceRevision]
    emit_repeated_evidence: bool
    profile_emitted: bool
    prepared_composition: DrawIrComposition
    prepared_images: [Engine2dResolvedDrawIrImage]
    prepared_scanout_pixels: [u32]
    prepared_scanout_valid: bool
    prepared_image_xy: [i64]
    prepared_image_x0: i64
    prepared_image_y0: i64
    prepared_image_x1: i64
    prepared_image_y1: i64
    prepared_image_x2: i64
    prepared_image_y2: i64
    prepared_scene_revision: i64
    prepared_taskbar_revision: i64
    prepared_clock_label: text
    prepared_backend_target: text
    prepared_valid: bool

    static fn create(engine: Engine2D, framebuffer: FramebufferDriver, fb_w: i64 = 0, fb_h: i64 = 0, cpu_simd_enabled: bool = false) -> Engine2dWmFrameExecutor:
        val local_target = engine2d_wm_draw_ir_backend_target(false, "", cpu_simd_enabled)
        Engine2dWmFrameExecutor(engine: engine, framebuffer: framebuffer, host_gpu_base: 0u64, host_gpu_run_id_hash: 0, host_gpu_backend: "", host_gpu_backend_code: 0, draw_ir_backend_target: local_target, local_draw_ir_backend_target: local_target, fb_w: fb_w, fb_h: fb_h, image_resource_revisions: [], emit_repeated_evidence: true, profile_emitted: false, prepared_composition: DrawIrComposition(schema: "", composition_id: "", scene_key: "", backend_target: "", batches: []), prepared_images: [], prepared_scanout_pixels: [], prepared_scanout_valid: false, prepared_image_xy: [], prepared_image_x0: 0, prepared_image_y0: 0, prepared_image_x1: 0, prepared_image_y1: 0, prepared_image_x2: 0, prepared_image_y2: 0, prepared_scene_revision: 0, prepared_taskbar_revision: 0, prepared_clock_label: "", prepared_backend_target: "", prepared_valid: false)

    static fn create_host_gpu(engine: Engine2D, framebuffer: FramebufferDriver, base: u64, guest_isa_code: i64, backend_code: i64, fb_width: i64, fb_height: i64, negotiation_started_us: i64, cpu_simd_enabled: bool = false) -> Engine2dWmFrameExecutor:
        var executor = Engine2dWmFrameExecutor.create(engine, framebuffer, fb_width, fb_height, cpu_simd_enabled)
        val width = if fb_width > 0: fb_width else: framebuffer.width.to_i64()
        val height = if fb_height > 0: fb_height else: framebuffer.height.to_i64()
        val max_pixels = simpleos_host_gpu_max_readback_bytes() / 4
        val guest_isa = simpleos_host_gpu_guest_isa_name(guest_isa_code)
        if base != 0u64:
            serial_println("HOST_GPU_MAP_OK scope=production isa={guest_isa} base={base}")
        val deadline_us = boot_monotonic_deadline_us(negotiation_started_us, SIMPLEOS_HOST_GPU_NEGOTIATION_BUDGET_US)
        var attempts = 0
        var first_generation = 0
        var final_generation = 0
        var final_reason = SIMPLEOS_HOST_GPU_REASON_INVALID_REQUEST
        var decision_elapsed = 0
        if base == 0u64 or width <= 0 or height <= 0 or height > max_pixels or width > max_pixels / height:
            serial_println("[wm-frame] host-gpu-fallback reason=unavailable-or-readback-capacity width={width} height={height}")
            val elapsed = boot_monotonic_elapsed_us(negotiation_started_us, boot_monotonic_now_us())
            serial_println("HOST_GPU_NEGOTIATION_DONE scope=production isa={guest_isa} result=fallback backend=software attempts=0 first_generation=0 final_generation=0 elapsed_us={elapsed} budget_us={SIMPLEOS_HOST_GPU_NEGOTIATION_BUDGET_US} reason={final_reason}")
            return executor
        if guest_isa == "unsupported" or backend_code == 0 or simpleos_host_gpu_backend_mask(backend_code) == 0:
            serial_println("[wm-frame] host-gpu-fallback reason=invalid-session")
            val elapsed = boot_monotonic_elapsed_us(negotiation_started_us, boot_monotonic_now_us())
            serial_println("HOST_GPU_NEGOTIATION_DONE scope=production isa={guest_isa} result=fallback backend=software attempts=0 first_generation=0 final_generation=0 elapsed_us={elapsed} budget_us={SIMPLEOS_HOST_GPU_NEGOTIATION_BUDGET_US} reason={final_reason}")
            return executor
        if deadline_us <= 0:
            final_reason = SIMPLEOS_HOST_GPU_REASON_TIMEOUT
            serial_println("[wm-frame] host-gpu-fallback reason=invalid-clock")
            val elapsed = boot_monotonic_elapsed_us(negotiation_started_us, boot_monotonic_now_us())
            serial_println("HOST_GPU_NEGOTIATION_DONE scope=production isa={guest_isa} result=fallback backend=software attempts=0 first_generation=0 final_generation=0 elapsed_us={elapsed} budget_us={SIMPLEOS_HOST_GPU_NEGOTIATION_BUDGET_US} reason={final_reason}")
            return executor
        val backend_codes = [SIMPLEOS_HOST_GPU_BACKEND_METAL, SIMPLEOS_HOST_GPU_BACKEND_DIRECTX, SIMPLEOS_HOST_GPU_BACKEND_VULKAN]
        val expected_bytes = width * height * 4
        for candidate_code in backend_codes:
            val before_attempt = boot_monotonic_now_us()
            val before_elapsed = boot_monotonic_elapsed_us(negotiation_started_us, before_attempt)
            if before_elapsed <= 0 or before_elapsed >= SIMPLEOS_HOST_GPU_NEGOTIATION_BUDGET_US:
                final_reason = SIMPLEOS_HOST_GPU_REASON_TIMEOUT
                decision_elapsed = before_elapsed
                break
            val generation = host_gpu_ivshmem_next_generation(base)
            if generation <= 0:
                final_reason = SIMPLEOS_HOST_GPU_REASON_STALE_GENERATION
                decision_elapsed = before_elapsed
                break
            val candidate = simpleos_host_gpu_backend_name(candidate_code)
            val candidate_mask = simpleos_host_gpu_backend_mask(candidate_code)
            val hello = host_gpu_ivshmem_negotiate(base, generation, guest_isa, candidate, 0, HOST_GPU_IVSHMEM_DEFAULT_TIMEOUT_POLLS, deadline_us)
            val attempt_finished = boot_monotonic_now_us()
            val attempt_elapsed = boot_monotonic_elapsed_us(before_attempt, attempt_finished)
            val total_elapsed = boot_monotonic_elapsed_us(negotiation_started_us, attempt_finished)
            if not hello.published:
                final_reason = hello.reason
                decision_elapsed = total_elapsed
                break
            if attempts == 0:
                first_generation = generation
            attempts = attempts + 1
            final_generation = generation
            val hello_valid = (hello.completed and hello.status == SIMPLEOS_HOST_GPU_STATUS_PASS and hello.reason == 0 and
                hello.version == SIMPLEOS_HOST_GPU_PROTOCOL_VERSION and (hello.render_mask & candidate_mask) != 0 and
                hello.max_readback_bytes >= expected_bytes and hello.elapsed_us > 0 and attempt_elapsed > 0 and
                total_elapsed > 0 and total_elapsed <= SIMPLEOS_HOST_GPU_NEGOTIATION_BUDGET_US)
            val retryable = (hello.completed and hello.status == SIMPLEOS_HOST_GPU_STATUS_UNSUPPORTED and
                hello.reason == SIMPLEOS_HOST_GPU_REASON_INVALID_HELLO and hello.elapsed_us > 0 and attempt_elapsed > 0)
            val budget_failed = hello.completed and hello.status == SIMPLEOS_HOST_GPU_STATUS_PASS and hello.reason == 0 and total_elapsed > SIMPLEOS_HOST_GPU_NEGOTIATION_BUDGET_US
            val outcome = if hello_valid: "selected" elif retryable: "rejected" elif not hello.completed and hello.reason == SIMPLEOS_HOST_GPU_REASON_TIMEOUT: "timeout" elif not hello.completed and hello.reason == SIMPLEOS_HOST_GPU_REASON_STALE_GENERATION: "stale" elif budget_failed: "budget" else: "invalid"
            val marker_reason = if budget_failed: SIMPLEOS_HOST_GPU_REASON_TIMEOUT elif hello.reason == 0 and not hello_valid: SIMPLEOS_HOST_GPU_REASON_INVALID_HELLO else: hello.reason
            serial_println("HOST_GPU_NEGOTIATION_ATTEMPT scope=production isa={guest_isa} backend={candidate} generation={generation} outcome={outcome} status={hello.status} reason={marker_reason} daemon_elapsed_us={hello.elapsed_us} guest_elapsed_us={attempt_elapsed}")
            final_reason = marker_reason
            if hello_valid:
                executor.host_gpu_base = base
                executor.host_gpu_run_id_hash = generation
                executor.host_gpu_backend = candidate
                executor.host_gpu_backend_code = candidate_code
                executor.draw_ir_backend_target = engine2d_wm_draw_ir_backend_target(true, candidate, cpu_simd_enabled)
                final_reason = 0
                decision_elapsed = total_elapsed
                break
            serial_println("[wm-frame] host-gpu-fallback reason=negotiation status={hello.status} detail={hello.reason}")
            if not retryable:
                decision_elapsed = total_elapsed
                break
        val elapsed = if decision_elapsed > 0: decision_elapsed else: boot_monotonic_elapsed_us(negotiation_started_us, boot_monotonic_now_us())
        val result = if executor.host_gpu_base != 0u64: "selected" else: "fallback"
        val selected_backend = if executor.host_gpu_base != 0u64: executor.host_gpu_backend else: "software"
        serial_println("HOST_GPU_NEGOTIATION_DONE scope=production isa={guest_isa} result={result} backend={selected_backend} attempts={attempts} first_generation={first_generation} final_generation={final_generation} elapsed_us={elapsed} budget_us={SIMPLEOS_HOST_GPU_NEGOTIATION_BUDGET_US} reason={final_reason}")
        if executor.host_gpu_base != 0u64:
            serial_println("[wm-frame] host-gpu-ready backend={executor.host_gpu_backend} generation={executor.host_gpu_run_id_hash}")
        executor

    me _render_host_gpu(composition: DrawIrComposition, resources: [SimpleOsHostGpuImageResource]) -> bool:
        val generation = host_gpu_ivshmem_next_generation(self.host_gpu_base)
        if generation <= 0:
            return false
        # Use trusted scanout dims (native-build shifts cross-module fb field reads).
        val render_w = if self.fb_w > 0: self.fb_w else: self.framebuffer.width.to_i64()
        val render_h = if self.fb_h > 0: self.fb_h else: self.framebuffer.height.to_i64()
        val present_w = if self.fb_w > 0: self.fb_w.to_u32() else: self.framebuffer.width
        val present_h = if self.fb_h > 0: self.fb_h.to_u32() else: self.framebuffer.height
        val expected_bytes = render_w * render_h * 4
        val result = host_gpu_ivshmem_submit_draw_ir_retained(
            self.host_gpu_base, generation, self.host_gpu_run_id_hash, generation,
            self.host_gpu_backend, render_w, render_h,
            composition, resources, self.image_resource_revisions, HOST_GPU_IVSHMEM_DEFAULT_TIMEOUT_POLLS
        )
        self.image_resource_revisions = result.sent_resources
        val receipt = result.receipt
        if not host_gpu_ivshmem_device_receipt_valid(receipt, generation, self.host_gpu_run_id_hash, generation, self.host_gpu_backend_code, expected_bytes):
            serial_println("[wm-frame] host-gpu-fallback reason=receipt status={receipt.status} detail={receipt.reason}")
            return false
        if not self.framebuffer.present_argb32_from_mmio(receipt.output_addr, present_w, present_h, receipt.output_bytes, receipt.output_checksum):
            serial_println("[wm-frame] host-gpu-fallback reason=readback-presentation")
            return false
        serial_println("[wm-frame] host-gpu-presented backend={self.host_gpu_backend} generation={generation} run={self.host_gpu_run_id_hash} frame={generation} checksum={receipt.output_checksum}")
        true

    me replay_prepared_input_frame() -> i64:
        """Present the last admitted scanout for an input-only pointer step."""
        if not self.prepared_valid or not self.prepared_scanout_valid:
            return 0
        engine2d_draw_ir_adv_replay_prepared_scanout(
            self.engine, self.fb_w.to_i32(), self.fb_h.to_i32())
        self.prepared_scene_revision

    me render(scene: SharedWmScene, taskbar: TaskbarModel, content_frames: [WmContentFrame], scene_revision: i64, taskbar_revision: i64, clock_label: text) -> i64:
        val profile_started_us = boot_monotonic_now_us()
        if scene_revision <= 0 or taskbar_revision <= 0:
            return 0
        # The shell invokes this lane only with the exact immutable inputs
        # retained after an authoritative successful frame. Reuse the already
        # validated composition/resources, but execute every Draw IR command,
        # Engine2D operation, SIMD fill/blit and present again.
        var prepared_replay_eligible = false
        if not self.emit_repeated_evidence:
            if self.prepared_valid:
                if scene_revision == self.prepared_scene_revision:
                    if taskbar_revision == self.prepared_taskbar_revision:
                        if clock_label == self.prepared_clock_label:
                            if self.local_draw_ir_backend_target == self.prepared_backend_target:
                                prepared_replay_eligible = true
        if prepared_replay_eligible:
            var prepared_evidence_i64: [i64] = [0, 0, 0, 0, 0, 0, 0]
            var prepared_evidence_text: [text] = ["", "", ""]
            val prepared_execute_started_us = boot_monotonic_now_us()
            if self.prepared_scanout_valid:
                engine2d_draw_ir_adv_replay_prepared_scanout(
                    self.engine, self.fb_w.to_i32(), self.fb_h.to_i32())
                val prepared_scanout_rendered = 1
                if not self.profile_emitted:
                    self.profile_emitted = true
                    val prepared_finished_us = boot_monotonic_now_us()
                    val prepared_execute_us = boot_monotonic_elapsed_us(
                        prepared_execute_started_us, prepared_finished_us)
                    val prepared_total_us = boot_monotonic_elapsed_us(
                        profile_started_us, prepared_finished_us)
                    serial_println("[wm-exec-profile] prepare_us={prepared_total_us - prepared_execute_us} execute_us={prepared_execute_us} images={self.prepared_images.len()} batches={self.prepared_composition.batches.len()} rendered={prepared_scanout_rendered} skipped=0")
                if prepared_scanout_rendered <= 0:
                    self.prepared_valid = false
                    return 0
                return scene_revision

            val replay_image_xy: [i64] = [
                self.prepared_image_x0, self.prepared_image_y0,
                self.prepared_image_x1, self.prepared_image_y1,
                self.prepared_image_x2, self.prepared_image_y2]
            engine2d_draw_ir_adv_composition_present_prepared_with_images_xy_evidence(
                self.engine, self.prepared_composition, false,
                self.prepared_images, replay_image_xy,
                prepared_evidence_i64,
                prepared_evidence_text)
            val prepared_rendered = prepared_evidence_i64[5].to_i32()
            val prepared_skipped = prepared_evidence_i64[0].to_i32()
            if not self.profile_emitted:
                self.profile_emitted = true
                val prepared_finished_us = boot_monotonic_now_us()
                val prepared_execute_us = boot_monotonic_elapsed_us(
                    prepared_execute_started_us, prepared_finished_us)
                val prepared_total_us = boot_monotonic_elapsed_us(
                    profile_started_us, prepared_finished_us)
                serial_println("[wm-exec-profile] prepare_us={prepared_total_us - prepared_execute_us} execute_us={prepared_execute_us} images={self.prepared_images.len()} batches={self.prepared_composition.batches.len()} rendered={prepared_rendered} skipped={prepared_skipped}")
            if prepared_rendered <= 0:
                self.prepared_valid = false
                return 0
            return scene_revision

        # Per-window fail-closed degrade: a window whose content frame is
        # missing, has an empty URI, or duplicates another window's URI is
        # dropped from the composition (never painted from unresolved content)
        # and counted, while the background + remaining windows still compose.
        # We hand the composition builder a scene + content_frames filtered to
        # only the resolvable windows so no unresolvable image command is emitted.
        var images: [Engine2dResolvedDrawIrImage] = []
        var image_xy: [i64] = []
        var image_x0: i64 = 0
        var image_y0: i64 = 0
        var image_x1: i64 = 0
        var image_y1: i64 = 0
        var image_x2: i64 = 0
        var image_y2: i64 = 0
        var host_images: [SimpleOsHostGpuImageResource] = []
        var good_windows: [SharedWmWindow] = []
        var good_content_frames: [WmContentFrame] = []
        var expected_images = 0
        var degraded_window_count = 0
        # Stall receipts: the pointer-release render enters here and never
        # returns (shell logs [wm-render-step] at=executor-render then 300s of
        # total guest silence), while the press render on this exact path
        # completed with the SAME scene_revision moments before. Nothing below
        # logs on the success path until the very end, so without these the
        # hang cannot be attributed to a callee. One line per window plus four
        # phase markers is negligible beside a 4K repaint.
        val dbg_window_total = scene.windows.len()
        if _WM_TRACE: serial_println("[wm-exec] at=window-loop-begin windows={dbg_window_total} content_frames={content_frames.len()}")
        for window in scene.windows:
            if _WM_TRACE: serial_println("[wm-exec] at=window-begin id={window.window_id}")
            val content = shared_wm_scene_window_content_rect_with_titlebar(window, 28)
            # The native ARM64 aggregate return can corrupt SharedWmRect x/y
            # while preserving width/height. Reconstruct the canonical inset
            # from the owning window scalars and the proven content extent.
            val content_inset_x = (window.width - content.width) / 2
            val content_total_inset_y = window.height - content.height
            val content_x = window.x + content_inset_x
            val content_y = if content_total_inset_y > 0:
                window.y + content_total_inset_y - 4
            else:
                window.y
            val needs_surface = not window.minimized and content.width > 0 and content.height > 0
            if not needs_surface:
                # Minimized / zero-content windows carry no content surface; keep
                # their chrome by leaving them in the scene unchanged.
                good_windows.push(window)
            else:
                expected_images = expected_images + 1
                var resolved = false
                if self.emit_repeated_evidence:
                    for candidate in content_frames:
                        if candidate.window_id == window.window_id:
                            val expected_content = shared_wm_scene_window_content_rect_with_titlebar(window, 28)
                            val candidate_checksum = wm_content_frame_checksum(candidate.pixels)
                            serial_println("[wm-frame-candidate] window_id={window.window_id} frame_id={candidate.window_id} parent={candidate.parent_window_id} scene={candidate.scene_revision}/{scene_revision} revision={candidate.content_revision} size={candidate.width}x{candidate.height}/{expected_content.width}x{expected_content.height} pixels={candidate.pixels.len()} checksum={candidate.checksum}/{candidate_checksum}")
                if val frame = shared_wm_content_frame_for_window(content_frames, scene_revision, window, 28):
                    if not wm_content_frame_web_provenance_valid(frame):
                        serial_println("[wm-frame] content-provenance-rejected window_id={window.window_id} status={frame.engine2d_status} backend={frame.engine2d_backend} fallback={frame.material_fallback_kind} material={frame.material_fallback_sha256} theme={frame.theme_id} source={frame.theme_source_manifest_sha256}")
                    val image_uri = shared_wm_content_frame_positioned_image_uri(
                        frame, content_x, content_y)
                    if wm_content_frame_web_provenance_valid(frame) and image_uri != "":
                        var duplicate_uri = false
                        for image in images:
                            if image.image_uri == image_uri:
                                duplicate_uri = true
                        if not duplicate_uri:
                            val top_image_index = images.len()
                            images.push(engine2d_resolved_draw_ir_image(image_uri, frame.width, frame.height, frame.pixels))
                            image_xy.push(content_x.to_i64())
                            image_xy.push(content_y.to_i64())
                            if top_image_index == 0:
                                image_x0 = content_x.to_i64()
                                image_y0 = content_y.to_i64()
                            elif top_image_index == 1:
                                image_x1 = content_x.to_i64()
                                image_y1 = content_y.to_i64()
                            elif top_image_index == 2:
                                image_x2 = content_x.to_i64()
                                image_y2 = content_y.to_i64()
                            if self.host_gpu_base != 0u64:
                                host_images.push(simpleos_host_gpu_image_resource(image_uri, frame.width, frame.height, frame.pixels))
                            good_windows.push(window)
                            good_content_frames.push(frame)
                            resolved = true
                if not resolved:
                    degraded_window_count = degraded_window_count + 1
                    serial_println("[wm-frame] window-degraded window_id={window.window_id} reason=unresolved-or-duplicate-content")

        if _WM_TRACE: serial_println("[wm-exec] at=window-loop-end images={images.len()} good_windows={good_windows.len()} degraded={degraded_window_count}")
        val renderable_images = expected_images - degraded_window_count
        if images.len() != renderable_images or good_content_frames.len() != renderable_images:
            serial_println("[wm-frame] engine2d-draw-ir-rejected resolved_images={images.len()} expected_images={expected_images} degraded={degraded_window_count} content_frames={content_frames.len()} reason=resource-coverage")
            return 0
        val filtered_scene = SharedWmScene(width: scene.width, height: scene.height, backend: scene.backend, windows: good_windows, background: scene.background)
        val nested_content_frames = shared_wm_nested_content_frames(filtered_scene, content_frames, good_content_frames, scene_revision, 28)
        for frame in nested_content_frames:
            val image_uri = shared_wm_content_frame_image_uri(frame)
            images.push(engine2d_resolved_draw_ir_image(image_uri, frame.width, frame.height, frame.pixels))
            image_xy.push(9223372036854775807)
            image_xy.push(9223372036854775807)
            if self.host_gpu_base != 0u64:
                host_images.push(simpleos_host_gpu_image_resource(image_uri, frame.width, frame.height, frame.pixels))
            good_content_frames.push(frame)
        if _WM_TRACE: serial_println("[wm-exec] at=composition-begin")
        val composition = shared_wm_scene_draw_ir_composition_with_content(filtered_scene, taskbar, good_content_frames, self.draw_ir_backend_target, 1000, clock_label, 0)
        if _WM_TRACE: serial_println("[wm-exec] at=composition-end")
        if self.host_gpu_base != 0u64:
            if self._render_host_gpu(composition, host_images):
                if degraded_window_count > 0:
                    serial_println("[wm-frame] frame-degraded degraded_window_count={degraded_window_count} path=host-gpu scene_revision={scene_revision}")
                if self.emit_repeated_evidence:
                    for frame in good_content_frames:
                        serial_println("[wm-frame] content-presented scene_revision={scene_revision} path=host-gpu window_id={frame.window_id} status={frame.engine2d_status} backend={frame.engine2d_backend} fallback={frame.material_fallback_kind} material={frame.material_fallback_sha256} theme={frame.theme_id} source={frame.theme_source_manifest_sha256}")
                return scene_revision
        # The host composition is intentionally not reused after a failed
        # Metal/Vulkan request: its style metadata asks for that target's
        # device material receipts. Recompose lazily with the immutable local
        # CPU/CPU-SIMD target so Engine2D receives honest fallback semantics.
        var local_composition = composition
        if engine2d_wm_draw_ir_local_recompose_required(self.draw_ir_backend_target, self.local_draw_ir_backend_target):
            local_composition = shared_wm_scene_draw_ir_composition_with_content(filtered_scene, taskbar, good_content_frames, self.local_draw_ir_backend_target, 1000, clock_label, 0)
        if _WM_TRACE: serial_println("[wm-exec] at=present-begin")
        var render_evidence_i64: [i64] = [0, 0, 0, 0, 0, 0, 0]
        var render_evidence_text: [text] = ["", "", ""]
        val profile_execute_started_us = boot_monotonic_now_us()
        engine2d_draw_ir_adv_set_owner_image_xy(
            image_x0, image_y0, image_x1, image_y1, image_x2, image_y2)
        if self.emit_repeated_evidence:
            engine2d_draw_ir_adv_composition_present_with_owner_xy_evidence(
                self.engine, local_composition, false, images,
                image_x0, image_y0, image_x1, image_y1, image_x2, image_y2,
                render_evidence_i64, render_evidence_text)
        else:
            engine2d_draw_ir_adv_composition_present_prepared_with_images_xy_evidence(
                self.engine, local_composition, false, images,
                image_xy,
                render_evidence_i64, render_evidence_text)
        engine2d_draw_ir_adv_clear_owner_image_xy()
        val rendered_count = render_evidence_i64[5].to_i32()
        val skipped_count = render_evidence_i64[0].to_i32()
        val fallback_required = render_evidence_i64[6] != 0
        val fallback_reason = render_evidence_text[2]
        val profile_finished_us = boot_monotonic_now_us()
        if not self.emit_repeated_evidence:
            if not self.profile_emitted:
                self.profile_emitted = true
                val prepare_us = boot_monotonic_elapsed_us(profile_started_us, profile_execute_started_us)
                val execute_us = boot_monotonic_elapsed_us(profile_execute_started_us, profile_finished_us)
                serial_println("[wm-exec-profile] prepare_us={prepare_us} execute_us={execute_us} images={images.len()} batches={local_composition.batches.len()} rendered={rendered_count} skipped={skipped_count}")
        if _WM_TRACE: serial_println("[wm-exec] at=present-end rendered={rendered_count} skipped={skipped_count}")
        # A partially-unsupported composition (e.g. one taskbar icon whose
        # image never resolved because the backing disk lease is degraded)
        # must still show the commands that DID render -- rejecting the
        # whole frame over one unresolved icon regressed to a fully black
        # screen even though 9 of 14 commands were perfectly renderable
        # (SimpleOS baremetal desktop, 2026-07-16). Only bail when the
        # composition produced literally nothing.
        if rendered_count <= 0:
            serial_println("[wm-frame] engine2d-draw-ir-rejected resolved_images={images.len()} expected_images={expected_images} degraded={degraded_window_count} skipped={skipped_count} rendered={rendered_count} fallback_required={fallback_required} reason={fallback_reason}")
            return 0
        if self.emit_repeated_evidence:
            # Freeze the accepted final parent pixels for immutable FPS
            # replay. Web surfaces intentionally carry translucent pixels;
            # re-blending them on every unchanged sample is redundant. The
            # captured rectangles are already composited against the exact
            # prepared visual epoch and replay through the same Draw IR image
            # commands as opaque packed rows.
            var replay_images: [Engine2dResolvedDrawIrImage] = []
            var replay_image_index: i32 = 0
            for replay_image in images:
                var replay_x: i64 = 0
                var replay_y: i64 = 0
                if replay_image_index == 0:
                    replay_x = self.prepared_image_x0
                    replay_y = self.prepared_image_y0
                elif replay_image_index == 1:
                    replay_x = self.prepared_image_x1
                    replay_y = self.prepared_image_y1
                elif replay_image_index == 2:
                    replay_x = self.prepared_image_x2
                    replay_y = self.prepared_image_y2
                var captured = false
                if replay_image_index < 3 and replay_x >= 0 and replay_y >= 0:
                    val replay_pixel_count = (
                        replay_image.width.to_i64() *
                        replay_image.height.to_i64())
                    if replay_pixel_count > 0:
                        var replay_pixels: [u32] = [0u32; replay_pixel_count]
                        val capture_status = self.engine.copy_pixels_region_into(
                            replay_x.to_i32(), replay_y.to_i32(),
                            replay_image.width, replay_image.height,
                            replay_pixels)
                        val capture_first = if replay_pixels.len() > 0:
                            replay_pixels[0]
                        else:
                            0u32
                        serial_println("[wm-prepared-capture] index={replay_image_index} status={capture_status} xy={replay_x},{replay_y} size={replay_image.width}x{replay_image.height} pixels={replay_pixels.len()} first={capture_first}")
                        if capture_status > 0:
                            replay_images.push(engine2d_resolved_draw_ir_image(
                                replay_image.image_uri, replay_image.width,
                                replay_image.height, replay_pixels))
                            captured = true
                if not captured:
                    replay_images.push(replay_image)
                replay_image_index = replay_image_index + 1
            val scanout_w = self.fb_w.to_i32()
            val scanout_h = self.fb_h.to_i32()
            engine2d_draw_ir_adv_capture_prepared_scanout(
                self.engine, scanout_w, scanout_h)
            # The authoritative frame was already presented with these exact
            # admitted dimensions; the runtime capture has no additional
            # failure condition beyond that proven framebuffer contract.
            self.prepared_scanout_pixels = []
            self.prepared_scanout_valid = true
            self.prepared_composition = local_composition
            self.prepared_images = replay_images
            self.prepared_image_xy = image_xy
            self.prepared_scene_revision = scene_revision
            self.prepared_taskbar_revision = taskbar_revision
            self.prepared_clock_label = clock_label
            self.prepared_backend_target = self.local_draw_ir_backend_target
            self.prepared_valid = true
        if degraded_window_count > 0 or skipped_count != 0:
            serial_println("[wm-frame] frame-degraded degraded_window_count={degraded_window_count} skipped={skipped_count} rendered={rendered_count} scene_revision={scene_revision} reason={fallback_reason}")
        if self.emit_repeated_evidence:
            for frame in good_content_frames:
                serial_println("[wm-frame] content-presented scene_revision={scene_revision} path=software window_id={frame.window_id} status={frame.engine2d_status} backend={frame.engine2d_backend} fallback={frame.material_fallback_kind} material={frame.material_fallback_sha256} theme={frame.theme_id} source={frame.theme_source_manifest_sha256}")
        scene_revision

    me set_repeated_evidence(enabled: bool):
        self.emit_repeated_evidence = enabled

    me set_top_content_positions(x0: i64, y0: i64, x1: i64, y1: i64, x2: i64, y2: i64):
        """Install owner-derived positions for the three prepared WM images."""
        self.prepared_image_x0 = x0
        self.prepared_image_y0 = y0
        self.prepared_image_x1 = x1
        self.prepared_image_y1 = y1
        self.prepared_image_x2 = x2
        self.prepared_image_y2 = y2
