use std.gpu.engine2d.engine.{Engine2D}
use std.common.gpu.simpleos_host_gpu_draw_ir.{SimpleOsHostGpuImageResource}
use common.ui.draw_ir.{DRAW_IR_COMMAND_IMAGE, DrawIrComposition}
use common.ui.draw_ir_patch.{draw_ir_patch_between}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    Engine2dDrawIrAdvResult,
    Engine2dDrawIrTileOutcome,
    Engine2dResolvedDrawIrImage,
    engine2d_draw_ir_adv_composition_window_present_with_images,
    engine2d_draw_ir_adv_composition_with_images,
    engine2d_draw_ir_render_composition_damaged_deferred_cpu_with_images,
    engine2d_draw_ir_render_composition_damaged_with_images,
    engine2d_resolved_draw_ir_image
}
use os.compositor.display_backend_core.{CompositorBackend, CompositorGlassCapable}
use common.ui.render_opt.property_trees.{PropertyTrees}
use common.ui.render_opt.damage_tiles.{
    DirtyTilePyramid, damage_tiles_mark_property_damage
}
use common.ui.render_opt.damage_plan.{
    DamagePlan, DamagePlanPolicy, build_damage_plan, DAMAGE_PLAN_NONE,
    DAMAGE_PLAN_FULL
}
use std.nogc_sync_mut.io.time_ops.{time_now_nanos}
use os.compositor.vulkan_present_damage_gate.{
    hosted_vulkan_present_rects_valid,
    hosted_vulkan_present_revision_valid,
    hosted_vulkan_present_identity_valid
}

extern fn rt_env_get(key: text) -> text?

var _engine2d_compositor_next_id: i32 = 1
var _engine2d_compositor_override_enabled: bool = false
var _engine2d_compositor_override_id: i32 = 0
var _engine2d_compositor_override_width: i32 = 0
var _engine2d_compositor_override_height: i32 = 0
var _engine2d_compositor_override_pixels: [u32] = []
val _ENGINE2D_REVISION_CACHE_COMPOSITION_SATURATION: i64 = 9223372036854775806
# Full presented frames the owner must seed before any clipped retained
# replay is admitted. Deliberately small: each sample is a complete presented
# frame, so warmup cost is bounded and the pre-admission behavior is exactly
# the established full composition path.
val _ENGINE2D_RETAINED_DAMAGE_MIN_FULL_SAMPLES: i64 = 3

# Owner-issued calibration seed for retained-damage replay. The receipt is
# created by seed_retained_damage_calibration(), accumulates presented
# full-frame samples, and admits a clipped replay only after the presenting
# host has committed at least _ENGINE2D_RETAINED_DAMAGE_MIN_FULL_SAMPLES via
# complete_retained_damage_full_present(). It never enters DrawIR.
class Engine2dRetainedDamageCalibrationReceipt:
    owner_token: i64
    full_samples: i64
    seeded_ns: i64
    last_full_present_ns: i64
    presented: bool
    basis: text

pub struct Engine2dCompositorPackedDamage:
    ok: bool
    reason: text
    rects: [i64]
    pixels: [u32]
    selected_backend: text
    rendered_command_count: i32

fn _engine2d_compositor_packed_damage_reject(
    reason: text, backend: text
) -> Engine2dCompositorPackedDamage:
    Engine2dCompositorPackedDamage(
        ok: false, reason: reason, rects: [], pixels: [],
        selected_backend: backend, rendered_command_count: 0)

fn _engine2d_compositor_gpu_backend(selected: text) -> bool:
    selected != "software" and selected != "cpu" and selected != "cpu_simd"

fn _engine2d_compositor_transfer_profile() -> text:
    (rt_env_get("SIMPLE_ONE_CALL_UPLOAD") ?? "") + "\0" +
    (rt_env_get("SIMPLE_BULK_UPLOAD") ?? "") + "\0" +
    (rt_env_get("SIMPLE_SPL_GPU_TRANSFER_PATH") ?? "") + "\0" +
    (rt_env_get("SIMPLE_ONE_CALL_READBACK") ?? "")

fn _engine2d_compositor_clear_override(owner_id: i32):
    if owner_id > 0 and _engine2d_compositor_override_id != owner_id:
        return
    _engine2d_compositor_override_enabled = false
    _engine2d_compositor_override_id = 0
    _engine2d_compositor_override_width = 0
    _engine2d_compositor_override_height = 0
    _engine2d_compositor_override_pixels = []

fn _engine2d_compositor_copy_pixels(pixels: [u32]) -> [u32]:
    var copied: [u32] = []
    for pixel in pixels:
        copied.push(pixel)
    copied

fn _engine2d_compositor_pixels_checksum(pixels: [u32]) -> i64:
    var checksum: i64 = 0
    for pixel in pixels:
        checksum = (checksum + pixel.to_i64()) % 2147483647
    checksum

fn _engine2d_compositor_damage_covers_patch(
    before: DrawIrComposition, after: DrawIrComposition, dirty_rects: [i64]
) -> bool:
    if dirty_rects.len() == 0 or dirty_rects.len() % 4 != 0:
        return false
    val patch = draw_ir_patch_between(before, "cached", after, "current")
    var required = 0
    for rect in patch.damage_rects:
        if rect.present and rect.width > 0 and rect.height > 0:
            required += 1
            val rx = rect.x.to_i64()
            val ry = rect.y.to_i64()
            val rw = rect.width.to_i64()
            val rh = rect.height.to_i64()
            var covered = false
            var i = 0
            while i < dirty_rects.len():
                val dx = dirty_rects[i]
                val dy = dirty_rects[i + 1]
                val dw = dirty_rects[i + 2]
                val dh = dirty_rects[i + 3]
                if (dw > 0 and dh > 0 and dx <= rx and dy <= ry and
                    dx + dw >= rx + rw and dy + dh >= ry + rh):
                    covered = true
                    break
                i += 4
            if not covered:
                return false
    required > 0

fn engine2d_window_revision_exact_match(
    cached_producer_generation: i64,
    cached_composition_revision: i64,
    cached_composition: DrawIrComposition?,
    cached_resources: [SimpleOsHostGpuImageResource],
    producer_generation: i64,
    composition_revision: i64,
    composition: DrawIrComposition,
    resources: [SimpleOsHostGpuImageResource]
) -> bool:
    """Exact retained-frame key; revisions alone are never trusted."""
    if (producer_generation < 0 or composition_revision < 0 or
        composition_revision >= _ENGINE2D_REVISION_CACHE_COMPOSITION_SATURATION or
        cached_producer_generation != producer_generation or
        cached_composition_revision != composition_revision or
        cached_resources != resources):
        return false
    if val Some(cached) = cached_composition:
        return cached == composition
    false

# WM raster backend key. SIMPLE_GUI_BACKEND selects the Engine2D backend for
# the compositor raster lane (e.g. "metal"); default "software" keeps the
# historical CPU behavior. CPU stays the default until GPU parity + perf are
# proven — see test/02_integration/rendering/engine2d_gpu_offload_evidence.spl.
fn host_wm_render_backend_key() -> text:
    val raw = (rt_env_get("SIMPLE_GUI_BACKEND") ?? "").trim()
    if raw == "":
        return "software"
    raw

class Engine2dCompositorBackend:
    id: i32
    # ponytail: retained for read-only evidence callers; make private when
    # Simple field visibility can prevent mutation bypasses.
    engine: Engine2D
    w: i32
    h: i32
    last_backend: text
    last_readback_source: text
    last_backend_handle: i64
    last_readback_checksum: i64
    last_readback_completed: bool
    last_readback_width: i32
    last_readback_height: i32
    last_readback_stride: i32
    last_readback_format: text
    last_composition_id: text
    last_scene_key: text
    last_web_content_image_count: i32
    # ponytail: one exact retained frame per compositor; add a bounded history
    # only if alternating unchanged producer revisions are measured in practice.
    revision_cache_producer_generation: i64 = -1
    revision_cache_composition_revision: i64 = -1
    revision_cache_backend: text = ""
    revision_cache_transfer_profile: text = ""
    revision_cache_composition: DrawIrComposition? = nil
    revision_cache_resources: [SimpleOsHostGpuImageResource] = []
    revision_cache_result: Engine2dDrawIrAdvResult? = nil
    revision_reuse_count: i64 = 0
    revision_render_count: i64 = 0
    window_revision_producer_generation: i64 = -1
    window_revision_composition_revision: i64 = -1
    window_revision_composition: DrawIrComposition? = nil
    window_revision_resources: [SimpleOsHostGpuImageResource] = []
    window_render_count: i64 = 0
    window_represent_count: i64 = 0
    # Explicit damage-reporting sink (WS-D3 §9 fix). `get_pixel_buffer()`
    # returns a live alias, so callers (glass_dispatch.spl, text_render.spl)
    # call `report_damage()` with the region they just touched instead of
    # damage tracking trying to infer it from the aliased buffer. Reuses the
    # O0/O1 `PropertyTrees` damage sink as a plain rect accumulator — no
    # transform/clip/effect nodes are registered here, only `push_damage`.
    damage: PropertyTrees = PropertyTrees.create()
    damage_pyramid: DirtyTilePyramid
    last_damage_plan_mode: i64 = DAMAGE_PLAN_NONE
    last_damage_plan_rect_count: i64 = 0
    last_damage_plan_pixels: i64 = 0
    last_damage_ops_rendered: i32 = 0
    # CPU retained presentation is seeded only after a validated full frame.
    # The flat plan belongs to this frame transaction and is consumed before
    # `present_cpu_damage()` clears the SoftwareBackend dirty bits.
    cpu_damage_seeded: bool = false
    cpu_damage_rects: [i64] = []
    # Retained-damage calibration lifecycle (owner = presenting host).
    retained_damage_calibration: Engine2dRetainedDamageCalibrationReceipt? = nil
    # Vulkan presentation-owner identity binding (vulkan_present_damage_gate):
    # bound once from the first accepted swapchain receipt, then every later
    # present must match the exact tuple or the frame is rejected fail-closed.
    vulkan_present_bound_framebuffer: i64 = 0
    vulkan_present_bound_device_identity: i64 = 0
    vulkan_present_bound_adapter_identity: i64 = 0
    last_retained_replay_reason: text = "immediate-mode-no-replay-receipt"
    last_retained_replay_plan_mode: i64 = DAMAGE_PLAN_FULL

    static fn create(engine: Engine2D) -> Engine2dCompositorBackend:
        val id = _engine2d_compositor_next_id
        _engine2d_compositor_next_id = _engine2d_compositor_next_id + 1
        val width = engine.width()
        val height = engine.height()
        val pyramid = DirtyTilePyramid.create(
            width.to_i64(), height.to_i64(), [64, 256], [64, 256])
        Engine2dCompositorBackend(
            id: id,
            engine: engine,
            w: width,
            h: height,
            last_backend: engine.backend_name(),
            last_readback_source: "unavailable",
            last_backend_handle: 0,
            last_readback_checksum: 0,
            last_readback_completed: false,
            last_readback_width: 0,
            last_readback_height: 0,
            last_readback_stride: 0,
            last_readback_format: "",
            last_composition_id: "",
            last_scene_key: "",
            last_web_content_image_count: 0,
            damage_pyramid: pyramid
        )

    # Backend-by-name factory — the WM "gpu process" fix: ONE persistent
    # Engine2D session (device/queue/framebuffer created once, reused across
    # every composed frame; call shutdown() on exit — never a per-frame
    # create). "metal" uses the GPU-only fast session (1x1 CPU mirror, device
    # framebuffer is the source of truth, single-hop readback); every other
    # name falls through create_with_backend_fast() to the regular
    # create_with_backend() path unchanged.
    static fn create_named(width: i32, height: i32, backend_name: text) -> Engine2dCompositorBackend:
        val engine = Engine2D.create_with_backend_fast(width, height, backend_name)
        Engine2dCompositorBackend.create(engine)

    static fn create_from_env(width: i32, height: i32) -> Engine2dCompositorBackend:
        Engine2dCompositorBackend.create_named(width, height, host_wm_render_backend_key())

    static fn create_vulkan_window_present(width: i32, height: i32, vsync: bool = true) -> Result<Engine2dCompositorBackend, text>:
        """Create the persistent same-device DrawIR + visible-window owner."""
        match Engine2D.create_vulkan_window_present(width, height, vsync):
            Ok(engine):
                Ok(Engine2dCompositorBackend.create(engine))
            Err(reason):
                Err(reason)

    static fn create_vulkan_external_window_present(kind: i64, display: i64, window: i64, width: i32, height: i32, vsync: bool = true) -> Result<Engine2dCompositorBackend, text>:
        match Engine2D.create_vulkan_external_window_present(
            kind, display, window, width, height, vsync):
            Ok(engine):
                Ok(Engine2dCompositorBackend.create(engine))
            Err(reason):
                Err(reason)

    # The compositor owns the resolved session; child Web/WM producers must
    # consume this concrete name instead of independently reinterpreting auto.
    fn selected_backend() -> text:
        self.engine.backend_name()

    fn cpu_damage_enabled() -> bool:
        val selected = self.engine.backend_name()
        selected == "cpu" or selected == "cpu_simd" or selected == "software"

    fn window_present_enabled() -> bool:
        self.engine.window_present_enabled()

    me represent_retained_window() -> bool:
        if not self.window_present_enabled():
            return false
        if not self.engine.present_window_device():
            return false
        if val Some(receipt) = self.engine.latest_vulkan_frame_receipt():
            if (receipt.present_mode == "window-swapchain" and
                receipt.present_completed and receipt.device_present and
                receipt.no_readback and receipt.completion_known):
                self.window_represent_count += 1
                return true
        false

    fn get_pixel_buffer() -> [u32]:
        if _engine2d_compositor_override_enabled and _engine2d_compositor_override_id == self.id and _engine2d_compositor_override_width == self.w and _engine2d_compositor_override_height == self.h:
            return _engine2d_compositor_override_pixels
        self.engine.read_pixels()

    me damage_rect_count() -> i64:
        self.damage.damage_len

    me damage_rect_at(idx: i64) -> (i32, i32, i32, i32):
        (self.damage.damage_x[idx].to_i32(), self.damage.damage_y[idx].to_i32(), self.damage.damage_w[idx].to_i32(), self.damage.damage_h[idx].to_i32())

    me clear_damage():
        self.damage.clear_damage()

    fn invalidate_revision_cache():
        self.revision_cache_producer_generation = -1
        self.revision_cache_composition_revision = -1
        self.revision_cache_backend = ""
        self.revision_cache_transfer_profile = ""
        self.revision_cache_composition = nil
        self.revision_cache_resources = []
        self.revision_cache_result = nil
        self.window_revision_producer_generation = -1
        self.window_revision_composition_revision = -1
        self.window_revision_composition = nil
        self.window_revision_resources = []

    fn invalidate_frame_receipt():
        self.invalidate_revision_cache()
        self.last_readback_checksum = 0
        self.last_readback_completed = false
        self.last_readback_width = 0
        self.last_readback_height = 0
        self.last_readback_stride = 0
        self.last_readback_format = ""
        self.last_composition_id = ""
        self.last_scene_key = ""
        self.last_web_content_image_count = 0

    fn set_pixel_buffer_override(pixels: [u32]):
        self.invalidate_frame_receipt()
        _engine2d_compositor_clear_override(0)
        _engine2d_compositor_override_id = self.id
        _engine2d_compositor_override_width = self.w
        _engine2d_compositor_override_height = self.h
        _engine2d_compositor_override_pixels = pixels
        _engine2d_compositor_override_enabled = true

    fn retained_pixel_buffer_override_count() -> i64:
        if _engine2d_compositor_override_id == self.id:
            return _engine2d_compositor_override_pixels.len().to_i64()
        0

    me render_draw_ir_composition(composition: DrawIrComposition, images: [Engine2dResolvedDrawIrImage]) -> Engine2dDrawIrAdvResult:
        """Execute one canonical Draw IR frame on this persistent session and
        return its validated readback candidate to the hosted presenter."""
        _engine2d_compositor_clear_override(self.id)
        self.invalidate_frame_receipt()
        # Ordinary composition execution obtains a snapshot and presents it.
        # Any following retained read must seed from that complete frame.
        self.cpu_damage_seeded = false
        self.cpu_damage_rects = []
        self.engine.invalidate_damage_mirror()
        self.revision_render_count = self.revision_render_count + 1
        var web_content_image_count = 0
        var batch_index = 0
        # cpu-lane-loop-ok: walks DrawIR batches once per composition; bound is the batch count, the CPU lane consumes DrawIR per batch by design
        while batch_index < composition.batches.len():
            val batch = composition.batches[batch_index]
            if batch.source.style_key == "wm.content":
                var command_index = 0
                # cpu-lane-loop-ok: walks the commands of one DrawIR batch; bound is that batch command count
                while command_index < batch.commands.len():
                    if batch.commands[command_index].kind == DRAW_IR_COMMAND_IMAGE:
                        web_content_image_count = web_content_image_count + 1
                    command_index = command_index + 1
            batch_index = batch_index + 1
        val selected = self.engine.backend_name()
        val gpu_available = _engine2d_compositor_gpu_backend(selected)
        val result = engine2d_draw_ir_adv_composition_with_images(self.engine, composition, gpu_available, images)
        self.last_backend = result.selected_backend
        self.last_readback_source = result.readback_source
        self.last_backend_handle = result.backend_handle
        self.last_readback_checksum = result.readback_checksum
        if not result.fallback_required and result.skipped_command_count == 0 and result.rendered_command_count > 0 and result.pixels.len() == self.w * self.h:
            self.last_readback_completed = true
            self.last_readback_width = self.w
            self.last_readback_height = self.h
            self.last_readback_stride = self.w * 4
            self.last_readback_format = "argb8888"
            self.last_composition_id = result.unit_id
            self.last_scene_key = composition.scene_key
            self.last_web_content_image_count = web_content_image_count
        result

    me seed_cpu_damage_mirror() -> bool:
        """Seed the CPU retained mirror from a validated full-frame result."""
        if not self.cpu_damage_enabled():
            return false
        val pixels = self.engine.read_pixels_damaged(256)
        if pixels.len() != self.w * self.h:
            return false
        self.cpu_damage_seeded = true
        true

    me render_draw_ir_composition_cpu_damaged(
        composition: DrawIrComposition,
        images: [Engine2dResolvedDrawIrImage],
        dirty_rects: [i64]
    ) -> bool:
        """Replay one CPU retained frame without presenting or copying it.

        Callers consume `cpu_damage_pixels()` only for `cpu_damage_rects`, then
        call `present_cpu_damage()` exactly once. A missing seed or malformed
        plan returns false before raster mutation so the caller can use the
        normal full-frame renderer.
        """
        if (not self.cpu_damage_enabled() or not self.cpu_damage_seeded or
            dirty_rects.len() == 0 or dirty_rects.len() % 4 != 0):
            return false
        self.last_damage_ops_rendered = 0
        self.damage_pyramid.begin_frame()
        var i = 0
        while i < dirty_rects.len():
            self.damage_pyramid.mark_rect(
                dirty_rects[i], dirty_rects[i + 1],
                dirty_rects[i + 2], dirty_rects[i + 3])
            i += 4
        val plan = build_damage_plan(
            self.damage_pyramid, 0, DamagePlanPolicy.create(256, 60))
        self.last_damage_plan_mode = plan.mode
        self.last_damage_plan_rect_count = plan.output_rect_count
        self.last_damage_plan_pixels = plan.planned_pixels
        if plan.rects.len() == 0:
            return false
        val outcome: Engine2dDrawIrTileOutcome =
            engine2d_draw_ir_render_composition_damaged_deferred_cpu_with_images(
                self.engine, composition, images, plan.rects)
        self.engine = outcome.engine
        # `ops_skipped` includes commands deliberately culled by the exact
        # damage index. That is the normal retained fast path, not an
        # execution failure; only an explicit unsupported receipt rejects it.
        if (outcome.unsupported_kinds != "none" or
            outcome.ops_rendered <= 0):
            # Deferred replay may already have touched a subset of the
            # framebuffer. Clear and retire it before reporting failure so a
            # later normal full render starts from a known blank surface,
            # never from a partially blended retained frame.
            self.engine.clear(0u32)
            self.engine.present()
            self.engine.invalidate_damage_mirror()
            self.cpu_damage_seeded = false
            self.cpu_damage_rects = []
            return false
        self.revision_render_count = self.revision_render_count + 1
        self.last_damage_ops_rendered = outcome.ops_rendered
        self.cpu_damage_rects = plan.rects
        true

    me cpu_damage_pixels() -> [u32]:
        self.engine.read_pixels_damaged(256)

    me present_cpu_damage():
        self.engine.present()
        self.cpu_damage_rects = []

    me abort_cpu_damage():
        """Discard a post-replay CPU transaction that cannot be presented."""
        self.engine.clear(0u32)
        self.engine.present()
        self.engine.invalidate_damage_mirror()
        self.cpu_damage_seeded = false
        self.cpu_damage_rects = []

    # -- Retained-damage calibration lifecycle -------------------------------
    # The presenting host is the owner: it seeds the receipt, and only the
    # host's post-present commit (complete_retained_damage_full_present) can
    # mark the seed presented and count a full sample.

    me seed_retained_damage_calibration(owner_token: i64):
        """Owner-issued full seed ("full-seed-warmup"): idempotent, keeps an
        existing receipt so accumulated samples survive re-seeding."""
        if owner_token <= 0:
            return
        if self.retained_damage_calibration != nil:
            return
        self.retained_damage_calibration = Some(
            Engine2dRetainedDamageCalibrationReceipt(
                owner_token: owner_token, full_samples: 0,
                seeded_ns: time_now_nanos(), last_full_present_ns: 0,
                presented: false, basis: "full-seed-warmup"))

    me record_retained_damage_full_sample(started_ns: i64, finished_ns: i64):
        if self.retained_damage_calibration == nil or finished_ns <= started_ns:
            return
        var receipt = self.retained_damage_calibration.unwrap()
        receipt.full_samples = receipt.full_samples + 1
        self.retained_damage_calibration = Some(receipt)

    me complete_retained_damage_full_present(started_ns: i64, finished_ns: i64):
        """Host commit: called strictly AFTER the host presenter has presented
        the full seed frame. This is the ONLY place a full sample is counted,
        so a frame contributes exactly one sample and only when presented."""
        if self.retained_damage_calibration == nil or finished_ns <= started_ns:
            return
        self.record_retained_damage_full_sample(started_ns, finished_ns)
        var receipt = self.retained_damage_calibration.unwrap()
        receipt.presented = true
        receipt.last_full_present_ns = finished_ns
        self.retained_damage_calibration = Some(receipt)

    # The retained-replay admission token. nil = execute the established
    # full composition path; Some(plan) = the owner seed is presented, warm,
    # and this session's damage sink produced a measured clipped plan.
    me admitted_retained_damage_schedule(
        external_presenter: bool
    ) -> DamagePlan?:
        if self.retained_damage_calibration != nil:
            val receipt = self.retained_damage_calibration.unwrap()
            # Owner-token validation: the receipt must have been seeded by
            # THIS backend instance; a stale receipt carried across a backend
            # swap never admits a clipped replay.
            if receipt.owner_token != self.id.to_i64():
                self.retained_damage_calibration = nil
                self.last_retained_replay_reason = "immediate-mode-no-replay-receipt"
                return nil
            if not receipt.presented:
                self.last_retained_replay_reason = "presenter-full-seed-unpresented"
                return nil
            if receipt.full_samples < _ENGINE2D_RETAINED_DAMAGE_MIN_FULL_SAMPLES:
                self.last_retained_replay_reason = "full-seed-warmup"
                return nil
            if external_presenter:
                self.last_retained_replay_reason = "presenter-full-seed-unpresented"
                return nil
            self.last_retained_replay_reason = "owner-token-retained-replay"
            self.damage_pyramid.begin_frame()
            damage_tiles_mark_property_damage(self.damage_pyramid, self.damage)
            return Some(build_damage_plan(
                self.damage_pyramid, 0, DamagePlanPolicy.create(256, 60)))
        self.last_retained_replay_reason = "immediate-mode-no-replay-receipt"
        nil

    fn retained_damage_replay_manifest() -> text:
        """Greppable replay admission receipt for evidence harnesses."""
        val seeded = self.retained_damage_calibration != nil
        var samples: i64 = 0
        var presented = false
        if seeded:
            val receipt = self.retained_damage_calibration.unwrap()
            samples = receipt.full_samples
            presented = receipt.presented
        "reason={self.last_retained_replay_reason};plan_mode={self.last_retained_replay_plan_mode};seeded={seeded};presented={presented};full_samples={samples};min_full_samples={_ENGINE2D_RETAINED_DAMAGE_MIN_FULL_SAMPLES}"

    # Production retained entry: use exactly the compositor-owned damage sink
    # and exactly this Engine2D session's calibration receipt. A missing/
    # unseeded/unpresented/under-warmed receipt — or a replay rejection —
    # makes this method perform the established full composition path.
    me render_draw_ir_composition_from_retained_damage(
        composition: DrawIrComposition,
        images: [Engine2dResolvedDrawIrImage]
    ) -> Engine2dDrawIrAdvResult:
        val retained_plan = self.admitted_retained_damage_schedule(false)
        if retained_plan != nil:
            val plan = retained_plan.unwrap()
            self.last_retained_replay_plan_mode = plan.mode
            var dirty_rects: [i64] = []
            var di: i64 = 0
            while di < self.damage_rect_count():
                val (dx, dy, dw, dh) = self.damage_rect_at(di)
                dirty_rects.push(dx.to_i64())
                dirty_rects.push(dy.to_i64())
                dirty_rects.push(dw.to_i64())
                dirty_rects.push(dh.to_i64())
                di = di + 1
            if (plan.rects.len() > 0 and self.cpu_damage_seeded and
                self.render_draw_ir_composition_cpu_damaged(
                    composition, images, dirty_rects)):
                val pixels = _engine2d_compositor_copy_pixels(
                    self.cpu_damage_pixels())
                self.present_cpu_damage()
                if pixels.len() == self.w * self.h:
                    self.clear_damage()
                    return Engine2dDrawIrAdvResult(
                        schema: composition.schema,
                        unit_id: composition.composition_id,
                        selected_backend: self.engine.backend_name(),
                        fallback_required: false,
                        fallback_reason: "",
                        rendered_command_count: self.last_damage_ops_rendered,
                        skipped_command_count: 0,
                        pixels: pixels,
                        readback_source: "cpu_damage_mirror_copy",
                        backend_handle: 0,
                        device_identity: 0,
                        readback_checksum: (
                            _engine2d_compositor_pixels_checksum(pixels)))
                self.abort_cpu_damage()
        else:
            self.last_retained_replay_plan_mode = DAMAGE_PLAN_FULL
        # Deliberately NO record_retained_damage_full_sample here: the host's
        # post-present commit (complete_retained_damage_full_present) is the
        # ONLY sample increment, so rejected frames contribute nothing and
        # presented frames count exactly once.
        val result = self.render_draw_ir_composition(composition, images)
        self.clear_damage()
        result

    me render_draw_ir_composition_resources(
        composition: DrawIrComposition,
        resources: [SimpleOsHostGpuImageResource]
    ) -> Engine2dDrawIrAdvResult:
        """Resolve validated wire resources only at the Engine2D boundary."""
        var images: [Engine2dResolvedDrawIrImage] = []
        # cpu-lane-loop-ok: resolves one host image resource per DrawIR resource entry; bound is the composition resource count
        for resource in resources:
            images.push(engine2d_resolved_draw_ir_image(
                resource.image_uri,
                resource.width,
                resource.height,
                resource.pixels
            ))
        self.render_draw_ir_composition(composition, images)

    me render_draw_ir_composition_resources_revision(
        composition: DrawIrComposition,
        resources: [SimpleOsHostGpuImageResource],
        producer_generation: i64,
        composition_revision: i64
    ) -> Engine2dDrawIrAdvResult:
        """Reuse one complete result for one exact producer revision tuple."""
        val cacheable = (
            producer_generation >= 0 and
            composition_revision >= 0 and
            composition_revision < _ENGINE2D_REVISION_CACHE_COMPOSITION_SATURATION
        )
        val selected = self.engine.backend_name()
        val transfer_profile = _engine2d_compositor_transfer_profile()
        if (
            cacheable and
            self.revision_cache_producer_generation == producer_generation and
            self.revision_cache_composition_revision == composition_revision and
            self.revision_cache_backend == selected and
            self.revision_cache_transfer_profile == transfer_profile and
            self.revision_cache_resources == resources
        ):
            if val Some(cached_composition) = self.revision_cache_composition:
                if cached_composition == composition:
                    if val Some(cached) = self.revision_cache_result:
                        self.revision_reuse_count = self.revision_reuse_count + 1
                        return cached

        val result = self.render_draw_ir_composition_resources(
            composition, resources)
        val device_proven = (
            not _engine2d_compositor_gpu_backend(selected) or
            (result.readback_source == "device_readback" and
             result.backend_handle > 0 and result.device_identity > 0)
        )
        if (
            cacheable and not result.fallback_required and
            result.skipped_command_count == 0 and
            result.rendered_command_count > 0 and
            result.pixels.len() == self.w * self.h and device_proven
        ):
            self.revision_cache_producer_generation = producer_generation
            self.revision_cache_composition_revision = composition_revision
            self.revision_cache_backend = selected
            self.revision_cache_transfer_profile = transfer_profile
            self.revision_cache_composition = Some(composition)
            self.revision_cache_resources = resources
            self.revision_cache_result = Some(result)
        result

    me render_draw_ir_composition_resources_revision_damaged(
        composition: DrawIrComposition,
        resources: [SimpleOsHostGpuImageResource],
        producer_generation: i64,
        composition_revision: i64,
        dirty_rects: [i64]
    ) -> Engine2dDrawIrAdvResult:
        """Consume one producer-owned retained receipt, conservatively.

        NONE reuses the exact revision cache. LOCAL is admitted only on an
        already seeded CPU surface; all other states take the complete
        revision route, which seeds the next CPU retained update after a
        validated full result.
        """
        if dirty_rects.len() == 0:
            return self.render_draw_ir_composition_resources_revision(
                composition, resources, producer_generation,
                composition_revision)
        val contiguous_base = (
            producer_generation >= 0 and composition_revision > 0 and
            self.revision_cache_producer_generation == producer_generation and
            self.revision_cache_composition_revision == composition_revision - 1 and
            self.revision_cache_backend == self.engine.backend_name() and
            self.revision_cache_transfer_profile ==
                _engine2d_compositor_transfer_profile() and
            self.revision_cache_resources == resources)
        if (self.cpu_damage_seeded and self.cpu_damage_enabled() and
            contiguous_base and self.revision_cache_result != nil):
            val cached_composition = self.revision_cache_composition.unwrap()
            if not _engine2d_compositor_damage_covers_patch(
                cached_composition, composition, dirty_rects):
                val full = self.render_draw_ir_composition_resources_revision(
                    composition, resources, producer_generation,
                    composition_revision)
                if (not full.fallback_required and
                    full.skipped_command_count == 0 and
                    full.rendered_command_count > 0 and
                    full.pixels.len() == self.w * self.h):
                    self.seed_cpu_damage_mirror()
                return full
            var images: [Engine2dResolvedDrawIrImage] = []
            for resource in resources:
                images.push(engine2d_resolved_draw_ir_image(
                    resource.image_uri, resource.width, resource.height,
                    resource.pixels))
            if self.render_draw_ir_composition_cpu_damaged(
                composition, images, dirty_rects):
                val pixels = _engine2d_compositor_copy_pixels(
                    self.cpu_damage_pixels())
                self.present_cpu_damage()
                if pixels.len() == self.w * self.h:
                    if self.revision_cache_result != nil:
                        val retained = Engine2dDrawIrAdvResult(
                            schema: "simple-draw-ir-v2",
                            unit_id: composition.composition_id,
                            selected_backend: self.engine.backend_name(),
                            fallback_required: false,
                            fallback_reason: "",
                            rendered_command_count: self.last_damage_ops_rendered,
                            # Spatial culls are the expected retained path;
                            # unsupported execution has already failed above.
                            skipped_command_count: 0,
                            pixels: pixels,
                            readback_source: "cpu_damage_mirror_copy",
                            backend_handle: 0,
                            device_identity: 0,
                            readback_checksum: (
                                _engine2d_compositor_pixels_checksum(pixels))
                        )
                        self.revision_cache_producer_generation = producer_generation
                        self.revision_cache_composition_revision = composition_revision
                        self.revision_cache_backend = self.engine.backend_name()
                        self.revision_cache_transfer_profile = (
                            _engine2d_compositor_transfer_profile())
                        self.revision_cache_composition = Some(composition)
                        self.revision_cache_resources = resources
                        self.revision_cache_result = Some(retained)
                        return retained
                self.abort_cpu_damage()
        val full = self.render_draw_ir_composition_resources_revision(
            composition, resources, producer_generation, composition_revision)
        if (not full.fallback_required and
            full.skipped_command_count == 0 and
            full.rendered_command_count > 0 and
            full.pixels.len() == self.w * self.h):
            self.seed_cpu_damage_mirror()
        full

    me render_draw_ir_composition_resources_packed_damage(
        composition: DrawIrComposition,
        resources: [SimpleOsHostGpuImageResource],
        producer_generation: i64,
        composition_revision: i64,
        dirty_rects: [i64]
    ) -> Engine2dCompositorPackedDamage:
        """Raster an exact retained CPU update and extract only planned rows.

        The returned pixels are an independent packed sequence in rect order;
        the backend mirror remains borrowed and is never published beyond this
        call. Callers need an exact external-frame base before accepting it.
        """
        val selected = self.engine.backend_name()
        val contiguous_base = (
            self.cpu_damage_seeded and self.cpu_damage_enabled() and
            producer_generation >= 0 and composition_revision > 0 and
            self.revision_cache_producer_generation == producer_generation and
            self.revision_cache_composition_revision == composition_revision - 1 and
            self.revision_cache_backend == selected and
            self.revision_cache_transfer_profile ==
                _engine2d_compositor_transfer_profile() and
            self.revision_cache_resources == resources and
            self.revision_cache_composition != nil)
        if not contiguous_base:
            return _engine2d_compositor_packed_damage_reject(
                "missing-retained-base", selected)
        val before = self.revision_cache_composition.unwrap()
        if not _engine2d_compositor_damage_covers_patch(
            before, composition, dirty_rects):
            return _engine2d_compositor_packed_damage_reject(
                "damage-does-not-cover-patch", selected)
        var images: [Engine2dResolvedDrawIrImage] = []
        for resource in resources:
            images.push(engine2d_resolved_draw_ir_image(
                resource.image_uri, resource.width, resource.height,
                resource.pixels))
        if not self.render_draw_ir_composition_cpu_damaged(
            composition, images, dirty_rects):
            return _engine2d_compositor_packed_damage_reject(
                "retained-raster-rejected", selected)
        val rects = self.cpu_damage_rects
        val mirror = self.cpu_damage_pixels()
        var packed: [u32] = []
        var ri = 0
        while ri < rects.len():
            val x = rects[ri].to_i32()
            val y = rects[ri + 1].to_i32()
            val w = rects[ri + 2].to_i32()
            val h = rects[ri + 3].to_i32()
            var row = 0
            while row < h:
                var col = 0
                while col < w:
                    packed.push(mirror[(y + row) * self.w + x + col])
                    col += 1
                row += 1
            ri += 4
        self.present_cpu_damage()
        self.revision_cache_producer_generation = producer_generation
        self.revision_cache_composition_revision = composition_revision
        self.revision_cache_backend = selected
        self.revision_cache_transfer_profile = _engine2d_compositor_transfer_profile()
        self.revision_cache_composition = Some(composition)
        self.revision_cache_resources = resources
        # This producer intentionally never materializes a whole-frame
        # snapshot. Retaining the prior result under the new exact key would
        # make a following NONE frame re-publish stale pixels.
        self.revision_cache_result = nil
        Engine2dCompositorPackedDamage(
            ok: true, reason: "ok", rects: rects, pixels: packed,
            selected_backend: selected,
            rendered_command_count: self.last_damage_ops_rendered)

    # Fail-closed owner identity gate for every accepted swapchain receipt.
    # The tuple binds all-or-exact (see vulkan_present_damage_gate): the
    # first accepted receipt binds it; any later mismatch rejects the frame.
    me _vulkan_present_identity_admit(
        framebuffer: i64, device_identity: i64, adapter_identity: i64
    ) -> bool:
        if not hosted_vulkan_present_identity_valid(
            framebuffer, device_identity, adapter_identity,
            self.vulkan_present_bound_framebuffer,
            self.vulkan_present_bound_device_identity,
            self.vulkan_present_bound_adapter_identity):
            return false
        self.vulkan_present_bound_framebuffer = framebuffer
        self.vulkan_present_bound_device_identity = device_identity
        self.vulkan_present_bound_adapter_identity = adapter_identity
        true

    me render_draw_ir_composition_resources_window_revision(
        composition: DrawIrComposition,
        resources: [SimpleOsHostGpuImageResource],
        producer_generation: i64,
        composition_revision: i64
    ) -> bool:
        """Render a changed DrawIR revision once; re-present unchanged frames.

        Exact composition and immutable resource equality protect callers that
        accidentally reuse a revision. Successful receipts must prove a real
        visible swapchain present, known completion, and zero host readback.
        """
        val cacheable = (
            producer_generation >= 0 and composition_revision >= 0 and
            composition_revision < _ENGINE2D_REVISION_CACHE_COMPOSITION_SATURATION)
        if engine2d_window_revision_exact_match(
            self.window_revision_producer_generation,
            self.window_revision_composition_revision,
            self.window_revision_composition,
            self.window_revision_resources,
            producer_generation, composition_revision, composition, resources
        ):
            if self.engine.present_window_device():
                if val Some(receipt) = self.engine.latest_vulkan_frame_receipt():
                    if (receipt.present_mode == "window-swapchain" and
                        receipt.present_completed and receipt.device_present and
                        receipt.no_readback and receipt.completion_known and
                        self._vulkan_present_identity_admit(
                            receipt.backend_handle, receipt.device_identity,
                            receipt.swapchain_identity)):
                        self.window_represent_count += 1
                        return true
            self.invalidate_revision_cache()
            return false

        var images: [Engine2dResolvedDrawIrImage] = []
        for resource in resources:
            images.push(engine2d_resolved_draw_ir_image(
                resource.image_uri, resource.width, resource.height,
                resource.pixels))
        val result = engine2d_draw_ir_adv_composition_window_present_with_images(
            self.engine, composition, images)
        self.window_render_count += 1
        if (result.fallback_required or result.skipped_command_count != 0 or
            result.rendered_command_count <= 0):
            self.invalidate_revision_cache()
            return false
        if val Some(receipt) = self.engine.latest_vulkan_frame_receipt():
            if (receipt.present_mode == "window-swapchain" and
                receipt.present_completed and receipt.device_present and
                receipt.no_readback and receipt.completion_known and
                self._vulkan_present_identity_admit(
                    receipt.backend_handle, receipt.device_identity,
                    receipt.swapchain_identity)):
                if cacheable:
                    self.window_revision_producer_generation = producer_generation
                    self.window_revision_composition_revision = composition_revision
                    self.window_revision_composition = Some(composition)
                    self.window_revision_resources = resources
                return true
        self.invalidate_revision_cache()
        false

    me render_draw_ir_composition_resources_window_revision_damaged(
        composition: DrawIrComposition,
        resources: [SimpleOsHostGpuImageResource],
        producer_generation: i64,
        composition_revision: i64,
        dirty_rects: [i64]
    ) -> bool:
        """Update a retained visible window through one exact damage plan.

        A missing retained seed or malformed damage uses the existing
        full-frame path before any retained writes. Once damaged execution has
        started, failures invalidate the retained revision and return without
        presenting: replaying a full translucent composition over partially
        updated pixels would double-blend them.
        """
        # An unchanged retained window still needs a swapchain presentation,
        # but it needs no damage plan or DrawIR replay. Check the exact key
        # before treating an empty damage list as a full-frame fallback.
        if dirty_rects.len() == 0 and engine2d_window_revision_exact_match(
            self.window_revision_producer_generation,
            self.window_revision_composition_revision,
            self.window_revision_composition,
            self.window_revision_resources,
            producer_generation, composition_revision, composition, resources
        ):
            return self.render_draw_ir_composition_resources_window_revision(
                composition, resources, producer_generation,
                composition_revision)
        if self.window_revision_composition_revision < 0:
            return self.render_draw_ir_composition_resources_window_revision(
                composition, resources, producer_generation,
                composition_revision)
        if dirty_rects.len() == 0 or dirty_rects.len() % 4 != 0:
            return self.render_draw_ir_composition_resources_window_revision(
                composition, resources, producer_generation,
                composition_revision)
        # Presentation-owner revision gate (vulkan_present_damage_gate): a
        # retained damaged replay is admitted only for strictly newer
        # producer/composition serials than the retained base. Anything else
        # falls closed to the full-frame path before any retained writes.
        if not hosted_vulkan_present_revision_valid(
            producer_generation, self.window_revision_producer_generation,
            composition_revision, self.window_revision_composition_revision):
            return self.render_draw_ir_composition_resources_window_revision(
                composition, resources, producer_generation,
                composition_revision)

        self.damage_pyramid.begin_frame()
        var i = 0
        while i < dirty_rects.len():
            self.damage_pyramid.mark_rect(
                dirty_rects[i], dirty_rects[i + 1],
                dirty_rects[i + 2], dirty_rects[i + 3])
            i += 4
        val plan = build_damage_plan(
            self.damage_pyramid, 0, DamagePlanPolicy.create(256, 60))
        self.last_damage_plan_mode = plan.mode
        self.last_damage_plan_rect_count = plan.output_rect_count
        self.last_damage_plan_pixels = plan.planned_pixels
        if plan.rects.len() == 0:
            return self.render_draw_ir_composition_resources_window_revision(
                composition, resources, producer_generation,
                composition_revision)
        # Presentation-owner rect gate (vulkan_present_damage_gate): the plan
        # handed to acquisition/submission must be canonically valid
        # (in-bounds, non-overlapping, budgeted). An invalid plan falls
        # closed to the full-frame path before any retained writes.
        if not hosted_vulkan_present_rects_valid(
            self.w, self.h, plan.mode, plan.rects):
            return self.render_draw_ir_composition_resources_window_revision(
                composition, resources, producer_generation,
                composition_revision)

        var images: [Engine2dResolvedDrawIrImage] = []
        for resource in resources:
            images.push(engine2d_resolved_draw_ir_image(
                resource.image_uri, resource.width, resource.height,
                resource.pixels))
        val outcome: Engine2dDrawIrTileOutcome =
            engine2d_draw_ir_render_composition_damaged_with_images(
                self.engine, composition, images, plan.rects, false)
        self.engine = outcome.engine
        # `ops_skipped` includes commands intentionally culled because their
        # bounds do not intersect this exact retained damage plan. That is the
        # point of the partial-window path, not an execution failure. Only an
        # unsupported command or an empty replay invalidates the retained
        # revision before the device present.
        if (outcome.unsupported_kinds != "none" or
            outcome.ops_rendered <= 0):
            self.invalidate_revision_cache()
            return false
        # The damaged DrawIR executor finalizes its compute batch before
        # returning, which deliberately clears transient presentation state.
        # Restage the exact canonical plan on the retained engine so the
        # following swapchain present owns truthful damage metadata (and can
        # select a region transfer when the runtime supports it).
        if not self.engine.stage_present_damage(plan.rects):
            self.invalidate_revision_cache()
            return false
        if not self.engine.present_window_device():
            self.invalidate_revision_cache()
            return false
        if val Some(receipt) = self.engine.latest_vulkan_frame_receipt():
            if (receipt.present_mode == "window-swapchain" and
                receipt.present_completed and receipt.device_present and
                receipt.no_readback and receipt.completion_known and
                receipt.dirty_rect_count == plan.output_rect_count and
                self._vulkan_present_identity_admit(
                    receipt.backend_handle, receipt.device_identity,
                    receipt.swapchain_identity)):
                self.window_render_count += 1
                self.window_revision_producer_generation = producer_generation
                self.window_revision_composition_revision = composition_revision
                self.window_revision_composition = Some(composition)
                self.window_revision_resources = resources
                return true
        self.invalidate_revision_cache()
        false

    # Honest frame provenance (greppable): for the metal lane this must say
    # source=device_readback — a cpu_mirror source means the GPU lane silently
    # fell back and must never be presented as GPU rendering.
    fn frame_provenance() -> text:
        "backend={self.last_backend};source={self.last_readback_source};handle={self.last_backend_handle};checksum={self.last_readback_checksum};composition_id={self.last_composition_id};scene_key={self.last_scene_key};web_content_image_count={self.last_web_content_image_count};completed={self.last_readback_completed};width={self.last_readback_width};height={self.last_readback_height};stride={self.last_readback_stride};format={self.last_readback_format}"

    fn font_provenance() -> text:
        val identity = self.engine.selected_font_identity()
        if identity == "":
            return "identity=bitmap-default;target={self.engine.font_execution_target()}"
        "identity={identity};target={self.engine.font_execution_target()}"

    me shutdown():
        self.invalidate_frame_receipt()
        _engine2d_compositor_clear_override(self.id)
        self.engine.shutdown()

impl CompositorBackend for Engine2dCompositorBackend:
    fn width() -> i32:
        self.w

    fn height() -> i32:
        self.h

    me clear(color: u32):
        self.invalidate_frame_receipt()
        _engine2d_compositor_clear_override(self.id)
        self.engine.clear(color)
        self.engine.present()

    me fill_rect(x: i32, y: i32, w: i32, h: i32, color: u32):
        self.invalidate_frame_receipt()
        _engine2d_compositor_clear_override(self.id)
        self.engine.draw_rect_filled(x, y, w, h, color)
        self.engine.present()

    me draw_text(x: i32, y: i32, text_str: text, fg: u32, bg: u32):
        self.invalidate_frame_receipt()
        _engine2d_compositor_clear_override(self.id)
        self.engine.draw_text_bg(x, y, text_str, fg, bg, 16)
        self.engine.present()

    me draw_char_8x16(x: i32, y: i32, ch: u8, fg: u32, bg: u32):
        self.draw_text(x, y, "{ch}", fg, bg)

    me put_pixel(x: i32, y: i32, color: u32):
        self.invalidate_frame_receipt()
        _engine2d_compositor_clear_override(self.id)
        self.engine.draw_rect_filled(x, y, 1, 1, color)

    me blit_pixels(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        self.invalidate_frame_receipt()
        _engine2d_compositor_clear_override(self.id)
        self.engine.draw_image(x, y, w, h, pixels)
        self.engine.present()

    me present():
        if self.damage.damage_len > 0:
            self.damage_pyramid.begin_frame()
            damage_tiles_mark_property_damage(
                self.damage_pyramid, self.damage)
            val plan = build_damage_plan(
                self.damage_pyramid, 0,
                DamagePlanPolicy.create(256, 60))
            self.last_damage_plan_mode = plan.mode
            self.last_damage_plan_rect_count = plan.output_rect_count
            self.last_damage_plan_pixels = plan.planned_pixels
            self.engine.stage_present_damage(plan.rects)
            self.damage.clear_damage()
        else:
            self.last_damage_plan_mode = DAMAGE_PLAN_NONE
            self.last_damage_plan_rect_count = 0
            self.last_damage_plan_pixels = 0
        self.engine.present()

    me present_rect(x: i32, y: i32, w: i32, h: i32):
        self.report_damage(x, y, w, h)
        self.present()

    fn as_glass_capable() -> CompositorGlassCapable?:
        nil

    # Explicit damage-reporting contract (WS-D3 §9 fix). Clips to backend
    # bounds and drops empty/degenerate rects — a mutator racing past the
    # edge, or reporting a 0-area region, must not corrupt the damage
    # signal for everyone else.
    me report_damage(x: i32, y: i32, w: i32, h: i32):
        val cx = if x < 0: 0 else: x
        val cy = if y < 0: 0 else: y
        val cx2raw = x + w
        val cy2raw = y + h
        val cx2 = if cx2raw > self.w: self.w else: cx2raw
        val cy2 = if cy2raw > self.h: self.h else: cy2raw
        if cx2 <= cx or cy2 <= cy:
            return
        self.damage.push_damage(cx.to_u32(), cy.to_u32(), (cx2 - cx).to_u32(), (cy2 - cy).to_u32())

export engine2d_window_revision_exact_match
