"""Shared completion and rejection helpers for SOSIX display adapters.

This module exists because the cocoa, win32, and sdl2 display adapters each
defined byte-identical `_*_completion` and `_*_rejected` helpers. A fourth
backend is added by calling these shared functions rather than copying.

SDL2's extra `pixel_count` field is handled explicitly in its caller,
not by adding an optional/default here, so behaviour remains unchanged.
"""

use os.sosix.host.service_contract.{
    SosixDisplayRequest,
    SosixDisplayCompletionKey
}
use os.sosix.host.display_surface_state.{
    SosixDisplaySurfaceState
}

pub fn display_adapter_make_completion(request: SosixDisplayRequest) -> SosixDisplayCompletionKey:
    SosixDisplayCompletionKey(
        surface: request.surface,
        surface_generation: request.surface_generation,
        frame_sequence: request.frame_sequence
    )

pub struct DisplayRejectionComponents:
    accepted: bool
    reason: text
    state: SosixDisplaySurfaceState
    completion: SosixDisplayCompletionKey
    composition_id: text

pub fn display_adapter_make_rejection_components(
    reason: text,
    state: SosixDisplaySurfaceState,
    request: SosixDisplayRequest,
    composition_id: text
) -> DisplayRejectionComponents:
    DisplayRejectionComponents(
        accepted: false,
        reason: reason,
        state: state,
        completion: display_adapter_make_completion(request),
        composition_id: composition_id
    )

export display_adapter_make_completion
export DisplayRejectionComponents, display_adapter_make_rejection_components
