"""Cocoa renderer-host boundary over SOSIX capabilities and canonical Draw IR.

This adapter is pure Simple orchestration: configuration is injected as an
immutable snapshot, display authority is carried by ``SosixDisplayRequest``,
and raster ownership remains with Engine2D.  Cocoa does not expose a present
completion fence through the current backend, so a submitted frame remains
pending until a separate host completion producer observes it.
"""

use common.ui.draw_ir.{DrawIrComposition}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.compositor.hosted_backend_cocoa.{HostedCocoaBackend}
use os.sosix.host.service_contract.{
    SosixHostConfigurationSnapshot,
    SosixDisplayRequest,
    SosixDisplayCompletionKey,
    sosix_display_request_create
}
use os.sosix.host.display_surface_state.{
    SosixDisplaySurfaceState,
    sosix_display_surface_submit,
    sosix_display_present_fence_pending
}

pub struct SosixCocoaPresentSubmission:
    accepted: bool
    reason: text
    state: SosixDisplaySurfaceState
    completion: SosixDisplayCompletionKey
    composition_id: text

export SosixCocoaPresentSubmission

fn _cocoa_completion(request: SosixDisplayRequest) -> SosixDisplayCompletionKey:
    SosixDisplayCompletionKey(
        surface: request.surface,
        surface_generation: request.surface_generation,
        frame_sequence: request.frame_sequence
    )

fn _cocoa_rejected(
    reason: text,
    state: SosixDisplaySurfaceState,
    request: SosixDisplayRequest,
    composition_id: text
) -> SosixCocoaPresentSubmission:
    SosixCocoaPresentSubmission(
        accepted: false,
        reason: reason,
        state: state,
        completion: _cocoa_completion(request),
        composition_id: composition_id
    )

pub fn sosix_cocoa_submit_composition(
    configuration: SosixHostConfigurationSnapshot,
    raster: Engine2dCompositorBackend,
    display: HostedCocoaBackend,
    state: SosixDisplaySurfaceState,
    request: SosixDisplayRequest,
    composition: DrawIrComposition
) -> SosixCocoaPresentSubmission:
    if configuration.display_backend.trim().lower() != "cocoa":
        return _cocoa_rejected(
            "cocoa-not-configured", state, request, composition.composition_id)
    if display.window_id <= 0 or display.buffer_id <= 0:
        return _cocoa_rejected(
            "cocoa-surface-unavailable", state, request, composition.composition_id)
    if display.w != raster.w or display.h != raster.h:
        return _cocoa_rejected(
            "display-size-mismatch", state, request, composition.composition_id)

    val validated = sosix_display_request_create(
        request.operation,
        request.api_id,
        request.surface,
        request.surface_generation,
        request.frame_sequence,
        request.buffer,
        request.deadline_ns
    )
    if not validated.accepted:
        return _cocoa_rejected(
            validated.reason, state, request, composition.composition_id)
    val submitted = sosix_display_surface_submit(state, request)
    if not submitted.accepted:
        return _cocoa_rejected(
            submitted.reason, state, request, composition.composition_id)

    val rendered = raster.render_draw_ir_composition(composition, [])
    if (rendered.fallback_required or rendered.skipped_command_count != 0 or
        rendered.rendered_command_count == 0 or
        rendered.pixels.len() != display.w * display.h):
        return _cocoa_rejected(
            "draw-ir-render-rejected", state, request, composition.composition_id)

    display.blit_pixels(0, 0, display.w, display.h, rendered.pixels)
    display.present()
    val pending = sosix_display_present_fence_pending(
        submitted.state, _cocoa_completion(request))
    SosixCocoaPresentSubmission(
        accepted: true,
        reason: "present-awaiting-host-completion",
        state: pending.state,
        completion: _cocoa_completion(request),
        composition_id: composition.composition_id
    )

export sosix_cocoa_submit_composition
