use os.compositor.input_backend.{InputBackend}
use os.drivers.input.ps2_keyboard.{Ps2Keyboard}
use os.drivers.input.ps2_mouse.{Ps2Mouse}
use os.gui.input_event.{Key, KeyEvent, MouseEvent}

class Ps2InputBackend:
    keyboard: Ps2Keyboard
    mouse: Ps2Mouse

    static fn create(keyboard: Ps2Keyboard, mouse: Ps2Mouse) -> Ps2InputBackend:
        Ps2InputBackend(keyboard: keyboard, mouse: mouse)

impl InputBackend for Ps2InputBackend:
    me poll_key() -> KeyEvent?: self.keyboard.poll()
    me poll_mouse() -> MouseEvent?: self.mouse.poll()
    fn alt_held() -> bool: self.keyboard.alt_held
    fn shift_held() -> bool: self.keyboard.shift_held
    fn ctrl_held() -> bool: self.keyboard.ctrl_held
    fn key_to_char(key: Key) -> text?: self.keyboard.key_to_char(key)
