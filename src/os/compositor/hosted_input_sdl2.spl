# SDL2 Host Input Backend — WS-C, C4
#
# Fills the winit-only gap: `hosted_input_backend.spl` implements InputBackend
# against a winit event loop, while `hosted_backend_sdl2.spl` (the SDL2 DISPLAY
# backend) had no input peer at all. This file is that peer.
#
# It implements the `InputBackend` trait (poll_event / alt_held / shift_held /
# ctrl_held / key_to_char), deliberately mirroring `HostedInputBackend` so the
# compositor can switch host toolkits without knowing which one it got. The
# ONE ingress type is `HostInputEvent`; this class does NOT define a host event
# type of its own. `poll_key`/`poll_mouse` are inherent (non-trait) methods
# kept as the internal SDL2-queue drain that `poll_event` composes.
#
# Key code space
# --------------
# SDL2 emits **SDL keysyms** (ASCII for printables, 0x4000xxxx for the rest).
# The PS/2 driver emits **scancode set 1**. Both are translated into the shared
# `Key` enum here and only here; no SDL keysym escapes this file.
#
# `Key` is the SYMBOLIC vocabulary. The NUMERIC one is
# `common.ui.key_code` (Windows VK / W3C keyCode); the single seam from one to
# the other is `ps2_keyboard.key_to_canon`, and anything filling
# `HostInputEvent.Key.code` must go through it rather than leaking a keysym.
# `test/01_unit/os/input/producer_key_canon_spec.spl` pins this file's output
# against the other three producers at absolute canonical integers.
#
# Wheel sign
# ----------
# SDL2's `wheel_y` is positive when scrolling UP; `MouseEvent.wheel` is positive
# when scrolling DOWN (matching the PS/2 wire sign and HostInputEvent — see
# `ps2_mouse.spl`'s header). So SDL2 is the one producer that DOES flip, and the
# flip happens exactly once, in `sdl2_wheel_to_mouse_wheel` below.
#
# Externs are imported from the SDL2 SFFI module the display backend already
# uses (`std.nogc_sync_mut.io.window_sffi`), never redeclared as bare
# `extern fn` here — an unregistered extern silently returns nil under JIT, and
# a duplicate declaration is exactly how that goes unnoticed.

use os.compositor.input_backend.{InputBackend, host_event_from_polled}
use os.drivers.input.ps2_keyboard.{KeyEvent, Key}
use os.drivers.input.ps2_mouse.{MouseEvent}
use common.ui.host_input_event.{HostInputEvent}
use std.nogc_sync_mut.io.window_sffi.{
    rt_sdl2_poll_event,
    rt_sdl2_event_key_sym,
    rt_sdl2_event_key_mod,
    rt_sdl2_event_mouse_x,
    rt_sdl2_event_mouse_y,
    rt_sdl2_event_mouse_button,
    rt_sdl2_event_wheel_y
}

# ============================================================================
# SDL2 event codes (as normalised by runtime_sdl2; see
# src/lib/nogc_sync_mut/web_ui/input.spl, which decodes the same numbering)
# ============================================================================

val SDL_EV_NONE: i64 = 0
val SDL_EV_QUIT: i64 = 1
val SDL_EV_KEYDOWN: i64 = 2
val SDL_EV_KEYUP: i64 = 3
val SDL_EV_MOUSEMOTION: i64 = 4
val SDL_EV_MOUSEDOWN: i64 = 5
val SDL_EV_MOUSEUP: i64 = 6
val SDL_EV_MOUSEWHEEL: i64 = 7

# runtime_sdl2 normalises SDL_BUTTON_LEFT to 0, right to 1, middle to 2.
val SDL_BUTTON_LEFT: i64 = 0
val SDL_BUTTON_RIGHT: i64 = 1
val SDL_BUTTON_MIDDLE: i64 = 2

# SDL keymod bits
val SDL_KMOD_SHIFT: i64 = 0x0003
val SDL_KMOD_CTRL: i64 = 0x00C0
val SDL_KMOD_ALT: i64 = 0x0300

# ============================================================================
# SDL keysym → Key
# ============================================================================

fn sdl2_keysym_to_key(sym: i64) -> Key?:
    """Translate an SDL2 keysym to the shared `Key` enum.

    Printable ASCII keysyms map directly; SDL's scancode-derived keysyms
    (0x40000000 | scancode) cover the navigation, function and modifier keys.
    Returns nil for anything unmapped, which callers must skip rather than
    coerce to `Key.Unknown` (a wrong key is worse than no key).
    """
    # Printable / control ASCII
    if sym == 27: return Key.Escape
    if sym == 13: return Key.Enter
    if sym == 32: return Key.Space
    if sym == 8: return Key.Backspace
    if sym == 9: return Key.Tab
    if sym == 127: return Key.Delete
    if sym == 96: return Key.Backtick
    if sym == 45: return Key.Minus
    if sym == 61: return Key.Equals
    if sym == 91: return Key.LeftBracket
    if sym == 93: return Key.RightBracket
    if sym == 92: return Key.Backslash
    if sym == 59: return Key.Semicolon
    if sym == 39: return Key.Quote
    if sym == 44: return Key.Comma
    if sym == 46: return Key.Period
    if sym == 47: return Key.Slash

    # Digits '0'..'9' (48..57)
    if sym == 48: return Key.Num0
    if sym == 49: return Key.Num1
    if sym == 50: return Key.Num2
    if sym == 51: return Key.Num3
    if sym == 52: return Key.Num4
    if sym == 53: return Key.Num5
    if sym == 54: return Key.Num6
    if sym == 55: return Key.Num7
    if sym == 56: return Key.Num8
    if sym == 57: return Key.Num9

    # Letters — SDL reports lowercase 'a'..'z' (97..122)
    if sym == 97: return Key.A
    if sym == 98: return Key.B
    if sym == 99: return Key.C
    if sym == 100: return Key.D
    if sym == 101: return Key.E
    if sym == 102: return Key.F
    if sym == 103: return Key.G
    if sym == 104: return Key.H
    if sym == 105: return Key.I
    if sym == 106: return Key.J
    if sym == 107: return Key.K
    if sym == 108: return Key.L
    if sym == 109: return Key.M
    if sym == 110: return Key.N
    if sym == 111: return Key.O
    if sym == 112: return Key.P
    if sym == 113: return Key.Q
    if sym == 114: return Key.R
    if sym == 115: return Key.S
    if sym == 116: return Key.T
    if sym == 117: return Key.U
    if sym == 118: return Key.V
    if sym == 119: return Key.W
    if sym == 120: return Key.X
    if sym == 121: return Key.Y
    if sym == 122: return Key.Z

    # Function keys: SDLK_F1 = 1073741882 .. SDLK_F12 = 1073741893
    if sym == 1073741882: return Key.F1
    if sym == 1073741883: return Key.F2
    if sym == 1073741884: return Key.F3
    if sym == 1073741885: return Key.F4
    if sym == 1073741886: return Key.F5
    if sym == 1073741887: return Key.F6
    if sym == 1073741888: return Key.F7
    if sym == 1073741889: return Key.F8
    if sym == 1073741890: return Key.F9
    if sym == 1073741891: return Key.F10
    if sym == 1073741892: return Key.F11
    if sym == 1073741893: return Key.F12

    # Navigation cluster
    if sym == 1073741897: return Key.Insert
    if sym == 1073741898: return Key.Home
    if sym == 1073741899: return Key.PageUp
    if sym == 1073741901: return Key.End
    if sym == 1073741902: return Key.PageDown
    if sym == 1073741903: return Key.Right
    if sym == 1073741904: return Key.Left
    if sym == 1073741905: return Key.Down
    if sym == 1073741906: return Key.Up

    # Modifiers
    if sym == 1073741881: return Key.CapsLock
    if sym == 1073742048: return Key.LeftCtrl
    if sym == 1073742049: return Key.LeftShift
    if sym == 1073742050: return Key.LeftAlt
    if sym == 1073742052: return Key.RightCtrl
    if sym == 1073742053: return Key.RightShift
    if sym == 1073742054: return Key.RightAlt

    return nil

fn sdl2_wheel_to_mouse_wheel(wheel_y: i64) -> i64:
    """Convert SDL2's wheel_y (positive = UP) to MouseEvent.wheel
    (positive = DOWN). This is the ONE negation on the SDL2 path.
    """
    0 - wheel_y

# ============================================================================
# Sdl2InputBackend
# ============================================================================

class Sdl2InputBackend:
    """InputBackend reading keyboard and mouse from the SDL2 event queue.

    Peer of `HostedInputBackend` (winit). Mouse state seen while looking for a
    key event is buffered so `poll_mouse()` can return it without re-polling,
    exactly as the winit backend does.

    `_available` is false when the backend was constructed without a live SDL2
    window; in that state every poll returns nil immediately rather than
    hammering externs that may not be registered. The unavailability is
    recorded in `_unavailable_reason` so it is inspectable rather than silent.
    """
    window_id: i64
    _available: bool
    _unavailable_reason: text
    _alt_held: bool
    _shift_held: bool
    _ctrl_held: bool
    mouse_x: i64
    mouse_y: i64
    _prev_mouse_x: i64
    _prev_mouse_y: i64
    _left_pressed: bool
    _right_pressed: bool
    _middle_pressed: bool
    _left_just_pressed: bool
    _left_just_released: bool
    _right_just_pressed: bool
    _wheel: i64
    _has_buffered_mouse: bool

impl Sdl2InputBackend:

    static fn create(window_id: i64) -> Sdl2InputBackend:
        """Create an SDL2 input backend bound to an SDL2 window handle.

        A zero handle means the SDL2 display backend never came up (SDL2 not
        present, or window creation failed), so the input backend reports
        itself unavailable instead of polling into the void.
        """
        val ok = window_id != 0
        var reason: text = ""
        if not ok:
            reason = "sdl2 window handle is 0 — SDL2 display backend unavailable"
        Sdl2InputBackend(
            window_id: window_id,
            _available: ok,
            _unavailable_reason: reason,
            _alt_held: false,
            _shift_held: false,
            _ctrl_held: false,
            mouse_x: 0,
            mouse_y: 0,
            _prev_mouse_x: 0,
            _prev_mouse_y: 0,
            _left_pressed: false,
            _right_pressed: false,
            _middle_pressed: false,
            _left_just_pressed: false,
            _left_just_released: false,
            _right_just_pressed: false,
            _wheel: 0,
            _has_buffered_mouse: false
        )

    static fn create_unavailable(reason: text) -> Sdl2InputBackend:
        """Explicitly-unavailable backend, for callers that already know SDL2
        is absent and want the reason preserved for logging."""
        var b = Sdl2InputBackend.create(0)
        b._unavailable_reason = reason
        b

    fn is_available() -> bool:
        self._available

    fn unavailable_reason() -> text:
        self._unavailable_reason

    fn has_buffered_mouse() -> bool:
        self._has_buffered_mouse

    me _update_modifiers(key: Key, pressed: bool):
        """Update modifier state from a key transition."""
        match key:
            case Key.LeftShift: self._shift_held = pressed
            case Key.RightShift: self._shift_held = pressed
            case Key.LeftCtrl: self._ctrl_held = pressed
            case Key.RightCtrl: self._ctrl_held = pressed
            case Key.LeftAlt: self._alt_held = pressed
            case Key.RightAlt: self._alt_held = pressed
            case _: pass_dn

    me apply_key_mods(mods: i64):
        """Adopt SDL2's authoritative modifier bitfield (KMOD_*).

        SDL reports the live modifier state with every key event, which is more
        reliable than inferring it from press/release edges (a modifier
        released while the window lacked focus never produces a KEYUP).
        """
        self._shift_held = (mods & SDL_KMOD_SHIFT) != 0
        self._ctrl_held = (mods & SDL_KMOD_CTRL) != 0
        self._alt_held = (mods & SDL_KMOD_ALT) != 0

    me apply_mouse_button(button: i64, pressed: bool):
        """Fold an SDL2 mouse button transition into edge-triggered state.

        Hardware-free seam: specs drive this directly (mirrors
        `HostedInputBackend.record_mouse_position`).
        """
        val prev_left = self._left_pressed
        val prev_right = self._right_pressed
        if button == SDL_BUTTON_LEFT:
            self._left_pressed = pressed
            self._left_just_pressed = pressed and not prev_left
            self._left_just_released = not pressed and prev_left
        elif button == SDL_BUTTON_RIGHT:
            self._right_pressed = pressed
            self._right_just_pressed = pressed and not prev_right
        elif button == SDL_BUTTON_MIDDLE:
            self._middle_pressed = pressed
        self._has_buffered_mouse = true

    me record_mouse_position(x: i64, y: i64) -> MouseEvent:
        """Hardware-free seam: update the tracked position and build the
        resulting event with a real delta, without a live SDL2 queue."""
        self.mouse_x = x
        self.mouse_y = y
        self._build_mouse_event()

    me record_wheel(wheel_y: i64) -> MouseEvent:
        """Hardware-free seam: apply an SDL2 wheel_y detent and build the
        resulting event. Proves the single sign flip end to end."""
        self._wheel = sdl2_wheel_to_mouse_wheel(wheel_y)
        self._build_mouse_event()

    me _build_mouse_event() -> MouseEvent:
        """Construct a MouseEvent from the current buffered state.

        Deltas are the real movement since the previous event this backend
        built. Edge-triggered flags and the wheel detent are one-shot: they are
        cleared after the event is constructed so the next event does not
        repeat them.
        """
        val dx = self.mouse_x - self._prev_mouse_x
        val dy = self.mouse_y - self._prev_mouse_y
        self._prev_mouse_x = self.mouse_x
        self._prev_mouse_y = self.mouse_y
        val event = MouseEvent(
            x: self.mouse_x,
            y: self.mouse_y,
            dx: dx,
            dy: dy,
            left_pressed: self._left_pressed,
            right_pressed: self._right_pressed,
            middle_pressed: self._middle_pressed,
            left_just_pressed: self._left_just_pressed,
            right_just_pressed: self._right_just_pressed,
            left_just_released: self._left_just_released,
            wheel: self._wheel
        )
        self._left_just_pressed = false
        self._left_just_released = false
        self._right_just_pressed = false
        self._wheel = 0
        event

    me _absorb_mouse_event(ev_type: i64) -> bool:
        """Fold one SDL2 mouse-family event into internal state.

        Returns true if `ev_type` was a mouse event and was consumed.
        Shared by poll_key() (which buffers) and poll_mouse() (which emits).
        """
        if ev_type == SDL_EV_MOUSEMOTION:
            self.mouse_x = rt_sdl2_event_mouse_x()
            self.mouse_y = rt_sdl2_event_mouse_y()
            self._has_buffered_mouse = true
            return true

        if ev_type == SDL_EV_MOUSEDOWN:
            self.mouse_x = rt_sdl2_event_mouse_x()
            self.mouse_y = rt_sdl2_event_mouse_y()
            self.apply_mouse_button(rt_sdl2_event_mouse_button(), true)
            return true

        if ev_type == SDL_EV_MOUSEUP:
            self.mouse_x = rt_sdl2_event_mouse_x()
            self.mouse_y = rt_sdl2_event_mouse_y()
            self.apply_mouse_button(rt_sdl2_event_mouse_button(), false)
            return true

        if ev_type == SDL_EV_MOUSEWHEEL:
            self._wheel = sdl2_wheel_to_mouse_wheel(rt_sdl2_event_wheel_y())
            self._has_buffered_mouse = true
            return true

        false

# ============================================================================
# InputBackend Trait Implementation
# ============================================================================

impl InputBackend for Sdl2InputBackend:

    me poll_event() -> HostInputEvent?:
        """The ONE trait-level ingress: next input as a `HostInputEvent`.

        Key before mouse, matching every other backend. `poll_key`/`poll_mouse`
        below are INHERENT methods now (Workstream C step 6 removed them from
        the trait); they remain because this body and the buffering contract
        between them are what make the ordering observable.
        """
        val key_opt: KeyEvent? = self.poll_key()
        var ch = ""
        if val key_event = key_opt:
            if val Press(pressed_key) = key_event:
                if val Some(c) = self.key_to_char(pressed_key):
                    ch = c
            return host_event_from_polled(
                key_opt, nil, ch,
                self._shift_held, self._ctrl_held, self._alt_held
            )
        val mouse_opt: MouseEvent? = self.poll_mouse()
        host_event_from_polled(
            nil, mouse_opt, "",
            self._shift_held, self._ctrl_held, self._alt_held
        )

    me poll_key() -> KeyEvent?:
        """Poll the SDL2 queue for a keyboard event.

        Processes up to 16 events per call. Mouse events encountered on the way
        are folded into state and buffered for `poll_mouse()`. SDL_QUIT is
        translated to `KeyEvent.Press(Key.Escape)` so the compositor treats a
        window close as a quit request — the same contract the winit backend
        uses for EVENT_CLOSE.
        """
        if not self._available:
            return nil

        var remaining: i64 = 16
        while remaining > 0:
            remaining = remaining - 1
            var ev_type: i64 = -1
            unsafe(capabilities: [ffi]):
                ev_type = rt_sdl2_poll_event()
            if ev_type < 0:
                self._available = false
                return nil
            if ev_type == SDL_EV_NONE:
                return nil

            if ev_type == SDL_EV_QUIT:
                return KeyEvent.Press(key: Key.Escape)

            if ev_type == SDL_EV_KEYDOWN or ev_type == SDL_EV_KEYUP:
                val sym = rt_sdl2_event_key_sym()
                val mods = rt_sdl2_event_key_mod()
                self.apply_key_mods(mods)
                val pressed = ev_type == SDL_EV_KEYDOWN
                if val key = sdl2_keysym_to_key(sym):
                    self._update_modifiers(key, pressed)
                    if pressed:
                        return KeyEvent.Press(key: key)
                    else:
                        return KeyEvent.Release(key: key)
                # Unmapped keysym — skip rather than emit a wrong Key
                continue

            if self._absorb_mouse_event(ev_type):
                continue

            # Unknown / uninteresting event type — keep looking
            continue

        return nil

    me poll_mouse() -> MouseEvent?:
        """Return a buffered mouse event, or poll the queue for one.

        If `poll_key()` already buffered mouse state, that is returned first.
        Otherwise up to 16 events are polled looking for mouse input.
        """
        if not self._available:
            return nil

        if self._has_buffered_mouse:
            self._has_buffered_mouse = false
            return self._build_mouse_event()

        var remaining: i64 = 16
        while remaining > 0:
            remaining = remaining - 1
            var ev_type: i64 = -1
            unsafe(capabilities: [ffi]):
                ev_type = rt_sdl2_poll_event()
            if ev_type < 0:
                self._available = false
                return nil
            if ev_type == SDL_EV_NONE:
                return nil

            if self._absorb_mouse_event(ev_type):
                self._has_buffered_mouse = false
                return self._build_mouse_event()

            # Non-mouse event — keep looking
            continue

        return nil

    fn alt_held() -> bool:
        self._alt_held

    fn shift_held() -> bool:
        self._shift_held

    fn ctrl_held() -> bool:
        self._ctrl_held

    fn key_to_char(key: Key) -> text?:
        """Convert a Key to its character, respecting shift state.

        Mirrors the PS/2 and winit backends so text input is identical
        regardless of which host toolkit is driving the compositor.
        """
        if self._shift_held:
            match key:
                case Key.A: "A"
                case Key.B: "B"
                case Key.C: "C"
                case Key.D: "D"
                case Key.E: "E"
                case Key.F: "F"
                case Key.G: "G"
                case Key.H: "H"
                case Key.I: "I"
                case Key.J: "J"
                case Key.K: "K"
                case Key.L: "L"
                case Key.M: "M"
                case Key.N: "N"
                case Key.O: "O"
                case Key.P: "P"
                case Key.Q: "Q"
                case Key.R: "R"
                case Key.S: "S"
                case Key.T: "T"
                case Key.U: "U"
                case Key.V: "V"
                case Key.W: "W"
                case Key.X: "X"
                case Key.Y: "Y"
                case Key.Z: "Z"
                case Key.Num1: "!"
                case Key.Num2: "@"
                case Key.Num3: "#"
                case Key.Num4: "$"
                case Key.Num5: "%"
                case Key.Num6: "^"
                case Key.Num7: "&"
                case Key.Num8: "*"
                case Key.Num9: "("
                case Key.Num0: ")"
                case Key.Space: " "
                case Key.Enter: "\n"
                case Key.Minus: "_"
                case Key.Equals: "+"
                case Key.Semicolon: ":"
                case Key.Quote: "\""
                case Key.Comma: "<"
                case Key.Period: ">"
                case Key.Slash: "?"
                case Key.Backslash: "|"
                case Key.LeftBracket: "{"
                case Key.RightBracket: "}"
                case Key.Backtick: "~"
                case _: nil
        else:
            match key:
                case Key.A: "a"
                case Key.B: "b"
                case Key.C: "c"
                case Key.D: "d"
                case Key.E: "e"
                case Key.F: "f"
                case Key.G: "g"
                case Key.H: "h"
                case Key.I: "i"
                case Key.J: "j"
                case Key.K: "k"
                case Key.L: "l"
                case Key.M: "m"
                case Key.N: "n"
                case Key.O: "o"
                case Key.P: "p"
                case Key.Q: "q"
                case Key.R: "r"
                case Key.S: "s"
                case Key.T: "t"
                case Key.U: "u"
                case Key.V: "v"
                case Key.W: "w"
                case Key.X: "x"
                case Key.Y: "y"
                case Key.Z: "z"
                case Key.Num0: "0"
                case Key.Num1: "1"
                case Key.Num2: "2"
                case Key.Num3: "3"
                case Key.Num4: "4"
                case Key.Num5: "5"
                case Key.Num6: "6"
                case Key.Num7: "7"
                case Key.Num8: "8"
                case Key.Num9: "9"
                case Key.Space: " "
                case Key.Enter: "\n"
                case Key.Minus: "-"
                case Key.Equals: "="
                case Key.Semicolon: ";"
                case Key.Quote: "'"
                case Key.Comma: ","
                case Key.Period: "."
                case Key.Slash: "/"
                case Key.Backslash: "\\"
                case Key.LeftBracket: "["
                case Key.RightBracket: "]"
                case Key.Backtick: "`"
                case _: nil
