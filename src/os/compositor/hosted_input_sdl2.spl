use os.drivers.input.ps2_keyboard.{KeyEvent, Key}
use os.drivers.input.ps2_mouse.{MouseEvent}
use os.compositor.input_backend.{InputBackend}

# NOTE (2026-08-05): 3 of these 6 externs previously named functions that do
# not exist anywhere in the registered SDL2 surface, plus rt_sdl2_poll_event
# had a wrong arity (declared with a handle arg; the real C signature takes
# none) — see doc/04_architecture/ui/sdl2_seam_subset_audit.md. Fixed:
# `get_event_type` deleted (rt_sdl2_poll_event's own return value already IS
# the event-type code — see runtime_sdl2.c's rt_sdl2_poll_event, which
# returns rt_sdl2_event_code()); `get_key_code` -> `event_key_code` (real,
# returns the USB-HID *scancode* of the last event — matches the existing
# 224-231 modifier-key checks below, which are already scancode numbers) plus
# `event_key_sym` (real, added — returns the SDL *keysym*, which is what
# `_sdl_keycode_to_key` below actually decodes: ASCII-ish letters/digits and
# `SDLK_*` arrow constants, a different numbering than scancode); wrongly
# feeding a scancode into that decoder to disambiguate keys would have been a
# silent behavior bug, not a bagged decoder. `get_mouse_button` ->
# `event_mouse_button` (real; note its button-index mapping differs from raw
# SDL button constants — see the down-stream fix in `poll_events` below).
extern fn rt_sdl2_poll_event() -> i64
extern fn rt_sdl2_event_key_code() -> i64
extern fn rt_sdl2_event_key_sym() -> i64
extern fn rt_sdl2_get_mouse_x() -> i64
extern fn rt_sdl2_get_mouse_y() -> i64
extern fn rt_sdl2_event_mouse_button() -> i64

val SDL_EVENT_NONE: i64 = 0
val SDL_EVENT_QUIT: i64 = 256
val SDL_EVENT_KEYDOWN: i64 = 768
val SDL_EVENT_KEYUP: i64 = 769
val SDL_EVENT_MOUSEMOTION: i64 = 1024
val SDL_EVENT_MOUSEBUTTONDOWN: i64 = 1025
val SDL_EVENT_MOUSEBUTTONUP: i64 = 1026

class HostedSdl2Input:
    window_handle: i64
    last_mouse_x: i32
    last_mouse_y: i32
    alt_state: bool
    shift_state: bool
    ctrl_state: bool
    pending_key: KeyEvent?
    pending_mouse: MouseEvent?

    static fn new(window_handle: i64) -> HostedSdl2Input:
        HostedSdl2Input(
            window_handle: window_handle,
            last_mouse_x: 0,
            last_mouse_y: 0,
            alt_state: false,
            shift_state: false,
            ctrl_state: false,
            pending_key: nil,
            pending_mouse: nil
        )

    me poll_events():
        # rt_sdl2_poll_event()'s return value is itself the event-type code
        # (0 = no event); there is no separate "get event type" accessor.
        val event_type = rt_sdl2_poll_event()
        if event_type == 0:
            return
        if event_type == SDL_EVENT_KEYDOWN or event_type == SDL_EVENT_KEYUP:
            val code = rt_sdl2_event_key_code()
            val sym = rt_sdl2_event_key_sym()
            val pressed = event_type == SDL_EVENT_KEYDOWN
            if code == 226 or code == 230:
                self.alt_state = pressed
            elif code == 225 or code == 229:
                self.shift_state = pressed
            elif code == 224 or code == 228:
                self.ctrl_state = pressed
            self.pending_key = KeyEvent(key: _sdl_keycode_to_key(sym), pressed: pressed)
        elif event_type == SDL_EVENT_MOUSEMOTION:
            self.last_mouse_x = rt_sdl2_get_mouse_x().to_i32()
            self.last_mouse_y = rt_sdl2_get_mouse_y().to_i32()
            self.pending_mouse = MouseEvent(dx: self.last_mouse_x, dy: self.last_mouse_y, left: false, right: false, middle: false)
        elif event_type == SDL_EVENT_MOUSEBUTTONDOWN or event_type == SDL_EVENT_MOUSEBUTTONUP:
            # rt_sdl2_event_mouse_button() already remaps SDL's raw button
            # constants to 0=left, 1=right, 2=middle (see runtime_sdl2.c) —
            # different from the 1/2/3 SDL_BUTTON_* numbering the old
            # (nonexistent) rt_sdl2_get_mouse_button implied.
            val btn = rt_sdl2_event_mouse_button()
            val down = event_type == SDL_EVENT_MOUSEBUTTONDOWN
            self.pending_mouse = MouseEvent(dx: self.last_mouse_x, dy: self.last_mouse_y, left: btn == 0 and down, right: btn == 1 and down, middle: btn == 2 and down)

impl InputBackend for HostedSdl2Input:

    me poll_key() -> KeyEvent?:
        self.poll_events()
        val k = self.pending_key
        self.pending_key = nil
        k

    me poll_mouse() -> MouseEvent?:
        self.poll_events()
        val m = self.pending_mouse
        self.pending_mouse = nil
        m

    fn alt_held() -> bool:
        self.alt_state

    fn shift_held() -> bool:
        self.shift_state

    fn ctrl_held() -> bool:
        self.ctrl_state

    fn key_to_char(key: Key) -> text?:
        _key_to_char_map(key)

fn _sdl_keycode_to_key(code: i64) -> Key:
    if code >= 97 and code <= 122:
        return Key.A
    if code >= 48 and code <= 57:
        return Key.Num0
    if code == 13:
        return Key.Enter
    if code == 27:
        return Key.Escape
    if code == 8:
        return Key.Backspace
    if code == 9:
        return Key.Tab
    if code == 32:
        return Key.Space
    if code == 1073741906:
        return Key.Up
    if code == 1073741905:
        return Key.Down
    if code == 1073741904:
        return Key.Left
    if code == 1073741903:
        return Key.Right
    Key.Unknown

fn _key_to_char_map(key: Key) -> text?:
    if key == Key.A:
        return "a"
    if key == Key.Space:
        return " "
    if key == Key.Enter:
        return "\n"
    nil
