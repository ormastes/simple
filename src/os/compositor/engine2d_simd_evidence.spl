# codex-impl
# Compile-time SimpleOS adapter. Each target imports only its architecture owner;
# foreign target intrinsics never enter the guest closure.

use std.nogc_async_mut_noalloc.baremetal.common.engine2d_simd_evidence.{
    Engine2dSimdProducerEvidence
}

@cfg(x86_64)
fn simpleos_engine2d_simd_produce(
    dst: u64, scalar: u64, scratch: u64, count: u64, color: u32
) -> Engine2dSimdProducerEvidence:
    use std.nogc_async_mut_noalloc.baremetal.x86_64.engine2d_simd.{x86_engine2d_simd_produce}
    x86_engine2d_simd_produce(dst, scalar, scratch, count, color)

@cfg(arm64)
fn simpleos_engine2d_simd_produce(
    dst: u64, scalar: u64, scratch: u64, count: u64, color: u32
) -> Engine2dSimdProducerEvidence:
    use std.nogc_async_mut_noalloc.baremetal.arm64.engine2d_simd.{arm64_engine2d_simd_produce}
    arm64_engine2d_simd_produce(dst, scalar, scratch, count, color)

@cfg(riscv64)
fn simpleos_engine2d_simd_produce(
    dst: u64, scalar: u64, scratch: u64, count: u64, color: u32
) -> Engine2dSimdProducerEvidence:
    use std.nogc_async_mut_noalloc.baremetal.riscv64.engine2d_simd.{riscv64_engine2d_simd_produce}
    riscv64_engine2d_simd_produce(dst, scalar, scratch, count, color)
