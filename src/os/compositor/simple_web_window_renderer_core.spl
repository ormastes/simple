"""Dependency-light request and WmContentFrame assembly for Simple Web."""

use common.ui.web_render_api.{WEB_RENDER_TARGET_SIMPLE_WEB, WebRenderArtifact, WebRenderRequest, web_render_full_html}
use common.ui.window_scene.{WM_CONTENT_ORIGIN_SIMPLE_WEB, WmContentFrame, wm_content_frame_checksum}
use common.ui.wm_chrome_theme.{active_wm_theme_render_snapshot, active_theme_composed_css, active_theme_solid_fallback_rgba, active_theme_source_fingerprint, active_theme_text_rgba}
use nogc_sync_mut.ui.theme_package.{default_theme_id, resolved_theme_css, resolve_theme_alias, theme_package_fingerprint, theme_package_material_solid_fallback_rgba, theme_package_material_text_rgba}

fn _active_or_default_wm_theme_id() -> text:
    if val snapshot = active_wm_theme_render_snapshot():
        return snapshot.id
    default_theme_id()

fn _theme_hex_digit(value: u32) -> text:
    "0123456789ABCDEF".char_at(value.to_i64())

fn _theme_rgb_css(value: u32) -> text:
    val r = (value >> 16) & 0xFF
    val g = (value >> 8) & 0xFF
    val b = value & 0xFF
    "#{_theme_hex_digit(r >> 4)}{_theme_hex_digit(r & 0xF)}{_theme_hex_digit(g >> 4)}{_theme_hex_digit(g & 0xF)}{_theme_hex_digit(b >> 4)}{_theme_hex_digit(b & 0xF)}"

fn _wm_root_data_attrs(theme_id: text) -> text:
    val canonical_theme = resolve_theme_alias(theme_id)
    "data-wm-theme=\"{canonical_theme}\" data-wm-motion=\"standard\" data-wm-animation-style=\"spring\" data-wm-transparency=\"standard\" data-wm-energy=\"standard\" data-wm-feedback=\"standard\" data-wm-contrast=\"comfortable\" data-wm-density=\"comfortable\" data-wm-wallpaper=\"aurora\" data-wm-backdrop-motion=\"ambient\" data-wm-backdrop-intensity=\"balanced\" data-wm-dock-magnification=\"standard\" data-wm-dock-visibility=\"shown\" data-wm-surface-depth=\"layered\" data-wm-traffic-side=\"left\" data-wm-chrome-verbosity=\"full\" data-wm-window-transition=\"mac\" data-wm-accent=\"blue\" data-wm-focus-mode=\"off\" data-wm-quiet-mode=\"off\" data-wm-icon-mask=\"circle\" data-wm-corner-radius=\"round\""

fn _theme_solid_fallback_rgba(theme: text) -> u32:
    val installed = active_theme_solid_fallback_rgba(theme)
    if installed != 0u32:
        return installed
    theme_package_material_solid_fallback_rgba(theme)

fn _theme_text_rgba(theme: text) -> u32:
    val installed = active_theme_text_rgba(theme)
    if installed != 0u32:
        return installed
    theme_package_material_text_rgba(theme)

fn simple_web_content_render_request_with_theme(theme: text, title: text, body_html: text, viewport_w: i32, viewport_h: i32) -> WebRenderRequest:
    val installed_css = active_theme_composed_css(theme)
    val package_css = if installed_css != "": installed_css else: resolved_theme_css(theme)
    val css = package_css + "\n.wm-app-container { min-height: 100vh; } .wm-app-titlebar { height: 24px; } .wm-app-content { min-height: calc(100vh - 24px); }"
    val app_css = css + "body { margin: 0; overflow: hidden; background: var(--app-surface); color: var(--ui-fg); } #app { min-height: 100vh; padding: 0; } .wm-app-content { min-height: 100vh; color: var(--ui-fg); }"
    val solid_css = _theme_rgb_css(_theme_solid_fallback_rgba(theme))
    val text_css = _theme_rgb_css(_theme_text_rgba(theme))
    val app_body = "<div id='wm-app-content' class='wm-app-content widget-panel' data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' data-wm-theme-fallback='solid-material' data-wm-theme-bg='{solid_css}' data-wm-theme-fg='{text_css}'>" + body_html + "</div>"
    WebRenderRequest.html(WEB_RENDER_TARGET_SIMPLE_WEB, title, app_body, app_css, "", viewport_w, viewport_h).with_root_attrs(_wm_root_data_attrs(theme))

fn simple_web_content_render_request_with_active_theme(title: text, body_html: text, viewport_w: i32, viewport_h: i32) -> WebRenderRequest:
    simple_web_content_render_request_with_theme(_active_or_default_wm_theme_id(), title, body_html, viewport_w, viewport_h)

fn simple_web_content_full_html_with_theme(theme: text, title: text, body_html: text, viewport_w: i32, viewport_h: i32) -> text:
    web_render_full_html(simple_web_content_render_request_with_theme(theme, title, body_html, viewport_w, viewport_h))

fn _simple_web_revision_mix(hash: i64, value: i64) -> i64:
    ((hash * 131 + value) % 2147483647) + 1

fn simple_web_content_revision_with_theme(theme: text, title: text, body_html: text, width: i32, height: i32, scroll_y: i32) -> i64:
    var hash: i64 = 17
    val installed_fingerprint = active_theme_source_fingerprint(theme)
    val theme_fingerprint = if installed_fingerprint != "": installed_fingerprint else: theme_package_fingerprint(theme)
    var i = 0
    while i < theme_fingerprint.len():
        hash = _simple_web_revision_mix(hash, theme_fingerprint.char_code_at(i) as i64)
        i = i + 1
    hash = _simple_web_revision_mix(hash, 509)
    i = 0
    while i < title.len():
        hash = _simple_web_revision_mix(hash, title.char_code_at(i) as i64)
        i = i + 1
    hash = _simple_web_revision_mix(hash, 257)
    i = 0
    while i < body_html.len():
        hash = _simple_web_revision_mix(hash, body_html.char_code_at(i) as i64)
        i = i + 1
    hash = _simple_web_revision_mix(hash, width.to_i64())
    hash = _simple_web_revision_mix(hash, height.to_i64())
    _simple_web_revision_mix(hash, clamp_simple_web_scroll_px(scroll_y).to_i64())

fn simple_web_content_revision(title: text, body_html: text, width: i32, height: i32, scroll_y: i32) -> i64:
    simple_web_content_revision_with_theme(_active_or_default_wm_theme_id(), title, body_html, width, height, scroll_y)

val _MAX_SCROLL_RENDER_PX: i32 = 4000

fn clamp_simple_web_scroll_px(scroll_y: i32) -> i32:
    if scroll_y < 0:
        return 0
    if scroll_y > _MAX_SCROLL_RENDER_PX:
        return _MAX_SCROLL_RENDER_PX
    scroll_y

fn content_paint_full_height(ch: i32, scroll_y: i32) -> i32:
    ch + clamp_simple_web_scroll_px(scroll_y)

fn simple_web_window_scrolled_pixels(pixels: [u32], cw: i32, full_h: i32, ch: i32, scroll_y: i32) -> [u32]:
    if scroll_y <= 0:
        return pixels
    var out: [u32] = [0u32; cw * ch]
    var row = 0
    while row < ch:
        val src_row = scroll_y + row
        if src_row < full_h:
            var col = 0
            while col < cw:
                out[row * cw + col] = pixels[src_row * cw + col]
                col = col + 1
        row = row + 1
    out

fn simple_web_content_frame_from_artifact(artifact: WebRenderArtifact, window_id: text, scene_revision: i64, content_revision: i64, theme: text, width: i32, height: i32, scroll_y: i32, parent_window_id: text, offset_x: i32, offset_y: i32) -> WmContentFrame:
    if window_id.len() == 0 or scene_revision <= 0 or content_revision <= 0 or width <= 0 or height <= 0:
        return WmContentFrame(window_id: window_id, scene_revision: scene_revision, content_revision: content_revision, origin_kind: WM_CONTENT_ORIGIN_SIMPLE_WEB, width: width, height: height, pixels: [], checksum: 0u64, parent_window_id: parent_window_id, offset_x: offset_x, offset_y: offset_y)
    val full_h = height + clamp_simple_web_scroll_px(scroll_y)
    val visible = simple_web_window_scrolled_pixels(artifact.pixels, width, full_h, height, clamp_simple_web_scroll_px(scroll_y))
    val installed_fingerprint = active_theme_source_fingerprint(theme)
    val theme_fingerprint = if installed_fingerprint != "": installed_fingerprint else: theme_package_fingerprint(theme)
    val material_kind = artifact.material_fallback.kind
    val material_sha = artifact.material_fallback.material_sha256
    var material_digest_checked = false
    if material_kind == "solid-material":
        material_digest_checked = true
    if material_kind == "cpu-composited-material":
        material_digest_checked = true
    if material_kind == "metal-device-composited-material":
        material_digest_checked = true
    if material_digest_checked:
        if material_sha.len() != 64:
            print "[wm-content] material-sha-degenerate kind={material_kind} sha_len={material_sha.len()}"
    WmContentFrame(window_id: window_id, scene_revision: scene_revision, content_revision: content_revision, origin_kind: WM_CONTENT_ORIGIN_SIMPLE_WEB, width: width, height: height, pixels: visible, checksum: wm_content_frame_checksum(visible), parent_window_id: parent_window_id, offset_x: offset_x, offset_y: offset_y, engine2d_status: artifact.engine2d_status, engine2d_backend: artifact.engine2d_backend, engine2d_reason: artifact.engine2d_reason, material_fallback_kind: artifact.material_fallback.kind, material_fallback_reason: artifact.material_fallback.reason, material_fallback_sha256: artifact.material_fallback.material_sha256, theme_id: theme, theme_source_manifest_sha256: theme_fingerprint, font_provenance: artifact.font_provenance)
