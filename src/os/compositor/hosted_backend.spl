# Hosted Compositor Backend — winit native pixel buffer rendering
#
# Implements CompositorBackend trait using Rust FFI functions that manage
# a native-side pixel buffer via winit. This allows the SimpleOS window
# manager to render on macOS/Linux/Windows host desktops without a
# bare-metal framebuffer or GPU driver.
#
# The pixel buffer lives in Rust memory (not Simple arrays), so all
# drawing operations are fast FFI calls — critical for interpreter mode
# where array-based pixel manipulation would be too slow.

use os.compositor.display_backend_core.{CompositorBackend, CompositorGlassCapable}
use os.compositor.hosted_backend_cocoa.{HostedCocoaBackend}
use os.compositor.hosted_backend_win32.{HostedWin32Backend}
use os.compositor.hosted_backend_sdl2.{HostedSdl2Backend}
use common.ui.glyph_bitmap_8x16.{get_glyph_8x16}

# ============================================================================
# Platform Routing (Row 3 / Phase C)
# ============================================================================
#
# `select_hosted_backend()` is the single dispatch site that picks the
# REAL host surface for this machine: the macOS Cocoa backend
# (`hosted_backend_cocoa.spl::HostedCocoaBackend`), the Windows Win32
# backend (`hosted_backend_win32.spl::HostedWin32Backend`), or the SDL2
# backend (`hosted_backend_sdl2.spl::HostedSdl2Backend`) on Linux/BSD.
#
# Selection precedence (implemented in `src/runtime/hosted/select.rs`,
# which is live — the programmatic override wins, then the env var, then
# the compile-time host triple):
#   1. `rt_hosted_set_surface_override(sel)` programmatic override
#   2. `SIMPLE_HOSTED_SURFACE` env var: `winit` | `cocoa` | `win32` | `auto`
#   3. Host triple from the runtime (when env is `auto` or unset):
#        - macOS   -> selector 1 -> cocoa
#        - Windows -> selector 2 -> win32
#        - other   -> selector 0 -> "winit", read here as SDL2 (see below)
#
# Why selector 0 routes to SDL2 and NOT to this file's
# `HostedCompositorBackend`: the entire `rt_winit_buffer_*` family
# declared below has NO native definition anywhere in the repo. Its only
# implementation is the interpreter extern in
# `src/compiler_rust/compiler/src/interpreter_extern/winit_sffi/`, which
# is a `vec![color; w*h]` plus an incrementing counter — it hands back a
# plausible non-zero handle while opening no OS window at all, and a
# COMPILED build of that path would fail to link. Treating it as "a real
# backend is available" is precisely the false success this dispatcher
# exists to avoid, so `select_hosted_backend` never returns it.
# `HostedCompositorBackend` remains available for callers that hold real
# winit handles already (see `new` / `create` below).
#
# `select_hosted_backend` returns nil when NO real surface can be brought
# up. Callers must treat nil as "no real backend" and say so out loud —
# see `host_compositor_bootstrap.spl::_create_backend_for_kind`, which
# falls back to the headless backend but prints the fallback and records
# the backend it ACTUALLY selected on the handle.

# ============================================================================
# Winit Buffer FFI Declarations
# ============================================================================

extern fn rt_winit_buffer_create(w: i64, h: i64, fill_color: i64) -> i64
extern fn rt_winit_buffer_fill_rect(buf: i64, x: i64, y: i64, w: i64, h: i64, color: i64) -> bool
extern fn rt_winit_buffer_present(win: i64, buf: i64) -> bool
extern fn rt_winit_buffer_free(buf: i64) -> bool
extern fn rt_winit_buffer_read_pixel(buf: i64, x: i64, y: i64) -> i64
extern fn rt_winit_buffer_blend_rect(buf: i64, x: i64, y: i64, w: i64, h: i64, color: i64, alpha: i64) -> bool
extern fn rt_winit_buffer_blur(buf: i64, x: i64, y: i64, w: i64, h: i64, radius: i64) -> bool
extern fn rt_winit_buffer_gradient_v(buf: i64, x: i64, y: i64, w: i64, h: i64, c1: i64, c2: i64) -> bool
extern fn rt_winit_buffer_get_pixels(buf: i64) -> [i64]
extern fn rt_winit_buffer_save_bmp(buf: i64, path: text) -> bool

# Module-level state (interpreter-safe — struct fields can be nil through trait dispatch)
var _hosted_window_id: i64 = 0
var _hosted_buffer_id: i64 = 0
var _hosted_w: i32 = 0
var _hosted_h: i32 = 0

# ============================================================================
# HostedCompositorBackend
# ============================================================================

class HostedCompositorBackend:
    """CompositorBackend that renders through a winit native pixel buffer.

    All drawing is delegated to Rust-side FFI functions that operate on
    an opaque pixel buffer identified by buffer_id. The buffer is presented
    to a winit window identified by window_id.

    Colors are u32 ARGB (0xAARRGGBB), matching the CompositorBackend contract.
    The FFI layer accepts i64 for all numeric arguments.
    """
    window_id: i64
    buffer_id: i64
    w: i32
    h: i32

# ============================================================================
# CompositorBackend Trait Implementation
# ============================================================================

impl CompositorBackend for HostedCompositorBackend:

    fn width() -> i32:
        _hosted_w

    fn height() -> i32:
        _hosted_h

    me clear(color: u32):
        """Fill the entire buffer with a solid color."""
        val w_i: i64 = _hosted_w
        val h_i: i64 = _hosted_h
        val c: i64 = color
        rt_winit_buffer_fill_rect(_hosted_buffer_id, 0, 0, w_i, h_i, c)

    me fill_rect(x: i32, y: i32, w: i32, h: i32, color: u32):
        """Fill a rectangle in the pixel buffer."""
        val xi: i64 = x
        val yi: i64 = y
        val wi: i64 = w
        val hi: i64 = h
        val c: i64 = color
        rt_winit_buffer_fill_rect(_hosted_buffer_id, xi, yi, wi, hi, c)

    me draw_text(x: i32, y: i32, text_str: text, fg: u32, bg: u32):
        """Draw text using 8x16 bitmap font via native buffer.

        Each character is 8 pixels wide, 16 pixels tall.
        Iterates text as single-char strings and converts to ASCII code.
        """
        var cx = x
        for ch in text_str:
            val code = ch.ord()
            val ch_byte: u8 = code
            self.draw_char_8x16(cx, y, ch_byte, fg, bg)
            cx = cx + 8

    me draw_char_8x16(x: i32, y: i32, ch: u8, fg: u32, bg: u32):
        """Draw a single 8x16 character glyph into the pixel buffer."""
        val glyph = get_glyph_8x16(ch)
        val fg_i: i64 = fg
        val bg_i: i64 = bg
        var row: i64 = 0
        while row < 16:
            val bits: i64 = glyph[row]
            var col: i64 = 0
            while col < 8:
                val mask: i64 = 0x80 >> col
                val color = if (bits & mask) != 0: fg_i else: bg_i
                val px: i64 = x + col
                val py: i64 = y + row
                rt_winit_buffer_fill_rect(_hosted_buffer_id, px, py, 1, 1, color)
                col = col + 1
            row = row + 1

    me put_pixel(x: i32, y: i32, color: u32):
        """Write a single pixel using a 1x1 fill_rect call."""
        val xi: i64 = x
        val yi: i64 = y
        val c: i64 = color
        rt_winit_buffer_fill_rect(_hosted_buffer_id, xi, yi, 1, 1, c)

    me blit_pixels(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        """Blit a pixel array via per-pixel fill_rect calls (trait contract)."""
        var row: i32 = 0
        while row < h:
            var col: i32 = 0
            while col < w:
                val src_idx = row * w + col
                if src_idx >= 0 and src_idx < pixels.len():
                    self.put_pixel(x + col, y + row, pixels[src_idx])
                col = col + 1
            row = row + 1

    me present():
        """Present the pixel buffer to the winit window (full frame)."""
        rt_winit_buffer_present(_hosted_window_id, _hosted_buffer_id)

    me present_rect(x: i32, y: i32, w: i32, h: i32):
        """Present a rectangular region."""
        rt_winit_buffer_present(_hosted_window_id, _hosted_buffer_id)


    me report_damage(x: i32, y: i32, w: i32, h: i32):
        pass_dn
    fn as_glass_capable() -> CompositorGlassCapable?:
        # Hosted backend opts IN: the winit buffer IS the active surface and
        # rt_winit_buffer_* primitives are per-surface safe. See D2 Phase 1.
        self

# ============================================================================
# CompositorGlassCapable Trait Implementation (D2 Phase 1 — opt-in)
# ============================================================================

impl CompositorGlassCapable for HostedCompositorBackend:

    me blend_rect(x: i32, y: i32, w: i32, h: i32, color: u32, alpha: u8):
        """Alpha-blend a rectangle over existing content."""
        val xi: i64 = x
        val yi: i64 = y
        val wi: i64 = w
        val hi: i64 = h
        val c: i64 = color
        val a: i64 = alpha
        rt_winit_buffer_blend_rect(_hosted_buffer_id, xi, yi, wi, hi, c, a)

    me blur_region(x: i32, y: i32, w: i32, h: i32, radius: u32):
        """Apply box blur to a rectangular region."""
        val xi: i64 = x
        val yi: i64 = y
        val wi: i64 = w
        val hi: i64 = h
        val ri: i64 = radius
        rt_winit_buffer_blur(_hosted_buffer_id, xi, yi, wi, hi, ri)

    me gradient_v(x: i32, y: i32, w: i32, h: i32, color1: u32, color2: u32):
        """Fill a rectangle with a vertical gradient."""
        val xi: i64 = x
        val yi: i64 = y
        val wi: i64 = w
        val hi: i64 = h
        val c1: i64 = color1
        val c2: i64 = color2
        rt_winit_buffer_gradient_v(_hosted_buffer_id, xi, yi, wi, hi, c1, c2)

    fn read_pixel(x: i32, y: i32) -> u32:
        """Read a single pixel from the buffer."""
        val xi: i64 = x
        val yi: i64 = y
        val result = rt_winit_buffer_read_pixel(_hosted_buffer_id, xi, yi)
        result.to_u32()

# ============================================================================
# Static Constructor
# ============================================================================

impl HostedCompositorBackend:

    static fn new(window_id: i64, buffer_id: i64, w: i32, h: i32) -> HostedCompositorBackend:
        """Create a hosted compositor backend from existing winit handles.

        Args:
            window_id: Opaque handle from rt_winit_window_new
            buffer_id: Opaque handle from rt_winit_buffer_create
            w: Buffer width in pixels
            h: Buffer height in pixels
        """
        HostedCompositorBackend(window_id: window_id, buffer_id: buffer_id, w: w, h: h)

    static fn create(window_id: i64, w: i32, h: i32, fill_color: u32) -> HostedCompositorBackend?:
        """Create a hosted compositor backend, allocating a new pixel buffer.

        Returns nil when there is no live winit backing instead of fabricating
        a handle. This file declares no `rt_winit_window_new` — a caller MUST
        already hold a real window handle (see `new()`'s docstring); a
        `window_id <= 0` means no window was ever obtained, so there is
        nothing to attach a buffer to. The `rt_winit_buffer_*` family also has
        no native definition anywhere in the repo (interpreter-only synthetic
        counter, see the module header): a compiled build resolves no symbol
        at all, and even under the interpreter a non-positive id means no
        buffer was actually allocated. Callers must treat nil as "no real
        backend" either way.
        """
        if window_id <= 0:
            return nil
        val w64: i64 = w
        val h64: i64 = h
        val fc64: i64 = fill_color
        val buf = rt_winit_buffer_create(w64, h64, fc64)
        if buf <= 0:
            return nil
        # Store in module-level vars (interpreter trait dispatch loses struct fields)
        _hosted_window_id = window_id
        _hosted_buffer_id = buf
        _hosted_w = w
        _hosted_h = h
        HostedCompositorBackend(window_id: window_id, buffer_id: buf, w: w, h: h)

    me free():
        """Release the native pixel buffer.

        Should be called when the backend is no longer needed to avoid
        leaking the Rust-side buffer allocation.
        """
        rt_winit_buffer_free(self.buffer_id)

    fn get_pixels() -> [i64]:
        """Get all pixels from the buffer for comparison."""
        rt_winit_buffer_get_pixels(_hosted_buffer_id)

    fn save_bmp(path: text) -> bool:
        """Save the current pixel buffer to disk as a BMP file.

        Wraps rt_winit_buffer_save_bmp using the module-level buffer id so the
        backend remains the sole site that touches the raw winit FFI.
        """
        rt_winit_buffer_save_bmp(_hosted_buffer_id, path)

# ============================================================================
# Platform-routed hosted backend constructor (Row 3 / Phase C)
# ============================================================================

extern fn rt_hosted_select_surface() -> i64
extern fn rt_hosted_set_surface_override(sel: i64)

# Selector codes returned by `rt_hosted_select_surface()`. These MUST stay in
# sync with the constants in `src/runtime/hosted/select.rs`.
val HOSTED_SURFACE_WINIT: i64 = 0
val HOSTED_SURFACE_COCOA: i64 = 1
val HOSTED_SURFACE_WIN32: i64 = 2

fn hosted_surface_selector() -> i64:
    """Raw host-surface selector for this machine (see `select.rs`)."""
    rt_hosted_select_surface()

fn hosted_surface_name(sel: i64) -> text:
    """Human-readable name for a selector code, for disclosure in logs.

    Selector 0 is reported as `sdl2` rather than `winit` because that is the
    backend this file actually brings up for it — the `rt_winit_buffer_*`
    family it is named after has no native definition (see the header).
    """
    if sel == HOSTED_SURFACE_COCOA:
        return "cocoa"
    if sel == HOSTED_SURFACE_WIN32:
        return "win32"
    if sel == HOSTED_SURFACE_WINIT:
        return "sdl2"
    "unknown"

fn select_hosted_backend(window_id: i64, w: i32, h: i32, title: text, fill_color: u32) -> CompositorBackend?:
    """Bring up the real host surface for THIS machine, or return nil.

    Reads the runtime's `rt_hosted_select_surface()` selector:
      0 = Linux / BSD / unknown -> SDL2  (`hosted_backend_sdl2.spl`)
      1 = macOS                 -> Cocoa (`hosted_backend_cocoa.spl`)
      2 = Windows               -> Win32 (`hosted_backend_win32.spl`)

    Every arm goes through the backend's own `try_create`, which probes the
    OS and returns nil when the platform shim is the non-native sentinel (the
    `#ifndef __APPLE__` / `#ifndef _WIN32` builds return -1, and `rt_sdl2_init`
    returns 0 with no display). So a non-nil result here means a real window
    was obtained; nil means none was, and the caller must disclose that rather
    than substitute a headless backend silently.

    Args:
        window_id: Existing native window handle, or 0 to create one.
        w: Surface width in pixels.
        h: Surface height in pixels.
        title: Window title used when a window has to be created.
        fill_color: Initial clear color, ARGB (0xAARRGGBB).
    """
    val sel = rt_hosted_select_surface()
    if sel == HOSTED_SURFACE_COCOA:
        val cocoa = HostedCocoaBackend.try_create(window_id, w, h, fill_color)
        if cocoa != nil:
            return cocoa
        return nil
    if sel == HOSTED_SURFACE_WIN32:
        val win32 = HostedWin32Backend.try_create(window_id, w, h, fill_color)
        if win32 != nil:
            return win32
        return nil
    # Selector 0 (Linux / BSD / unknown). SDL2 is the only surface here with
    # real native definitions (src/runtime/runtime_sdl2.c); the winit buffer
    # family is interpreter-only, so it is deliberately NOT a fallback.
    #
    # KNOWN GAP (measured 2026-08-05, Linux, DISPLAY+WAYLAND_DISPLAY unset):
    # under the interpreter/JIT tooling binary the `rt_sdl2_*` externs are not
    # registered, so this arm aborts with `unknown extern function:
    # rt_sdl2_init` instead of letting `try_create` return nil. A natively
    # linked build resolves them from runtime_sdl2.c and behaves as documented.
    # Registering the rt_sdl2_* family in the interpreter extern table is what
    # would let the loud headless fallback below trigger under tooling too;
    # that belongs to the runtime lane, not this dispatcher.
    val sdl = HostedSdl2Backend.try_create(w, h, title)
    if sdl != nil:
        return sdl
    nil
