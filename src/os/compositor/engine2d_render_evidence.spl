# SimpleOS Engine2D render receipt adapter.
#
# Recording is a one-shot qualification path after presentation, never part of
# the ordinary frame loop. Pixels use canonical A,R,G,B byte order on every ISA.

use std.common.crypto.sha256.{sha256_u8_hex}
use std.nogc_async_mut_noalloc.baremetal.common.backend_render_receipt.{
    BACKEND_RENDER_RECEIPT_VERSION,
    BACKEND_RENDER_OPERATION_PRESENT,
    BackendRenderReceiptHeader,
    BackendRenderReceiptEvent,
    BackendRenderReceiptTrailer,
    backend_render_receipt_event_valid,
    backend_render_receipt_header_valid,
    backend_render_receipt_trailer_valid
}
use os.drivers.framebuffer.fb_driver.{FramebufferDriver}

val SIMPLEOS_RENDER_RUNTIME_QEMU: u32 = 1u32
val SIMPLEOS_RENDER_ARCH_X86_64: u32 = 1u32
val SIMPLEOS_RENDER_ARCH_AARCH64: u32 = 2u32
val SIMPLEOS_RENDER_ARCH_RV64: u32 = 3u32
val SIMPLEOS_RENDER_BACKEND_VIRTIO_GPU: u32 = 1u32
val SIMPLEOS_RENDER_BACKEND_BGA: u32 = 2u32
val SIMPLEOS_RENDER_FORMAT_ARGB8888: u32 = 1u32

pub struct SimpleOsRenderReceipt:
    header: BackendRenderReceiptHeader
    event: BackendRenderReceiptEvent
    trailer: BackendRenderReceiptTrailer

pub struct SimpleOsBuildIdentityV1:
    word0: u64
    word1: u64
    word2: u64
    word3: u64

fn _render_hex_word(value: text, start: i64) -> u64?:
    if start < 0 or start + 16 > value.len():
        return nil
    val digits = "0123456789abcdef"
    var out = 0u64
    var index = start
    while index < start + 16:
        val digit = digits.index_of(value[index].to_text())
        if digit < 0:
            return nil
        out = (out << 4) | digit.to_u64()
        index = index + 1
    Some(out)

fn _render_sha256_words(value: text) -> SimpleOsBuildIdentityV1?:
    if value.len() != 64:
        return nil
    val word0 = _render_hex_word(value, 0)
    val word1 = _render_hex_word(value, 16)
    val word2 = _render_hex_word(value, 32)
    val word3 = _render_hex_word(value, 48)
    if word0 == nil or word1 == nil or word2 == nil or word3 == nil:
        return nil
    Some(SimpleOsBuildIdentityV1(
        word0: word0!, word1: word1!, word2: word2!, word3: word3!))

fn simpleos_argb_canonical_bytes(pixels: [u32]) -> [u8]:
    """Encode packed ARGB pixels as stable A,R,G,B bytes."""
    var bytes: [u8] = []
    for pixel in pixels:
        bytes.push(((pixel >> 24) & 0xffu32).to_u8())
        bytes.push(((pixel >> 16) & 0xffu32).to_u8())
        bytes.push(((pixel >> 8) & 0xffu32).to_u8())
        bytes.push((pixel & 0xffu32).to_u8())
    bytes

fn simpleos_argb_pixel_sha256(pixels: [u32]) -> text:
    sha256_u8_hex(simpleos_argb_canonical_bytes(pixels))

fn simpleos_framebuffer_argb_pixels(
    framebuffer: FramebufferDriver,
    width: u32,
    height: u32
) -> [u32]:
    """Read the authoritative committed framebuffer in row-major order."""
    var pixels: [u32] = []
    var y = 0u32
    while y < height:
        var x = 0u32
        while x < width:
            pixels.push(framebuffer.read_pixel(x, y))
            x = x + 1u32
        y = y + 1u32
    pixels

fn simpleos_nonblank_pixel_count(pixels: [u32]) -> u64:
    var count = 0u64
    for pixel in pixels:
        if (pixel & 0x00ffffffu32) != 0u32:
            count = count + 1u64
    count

fn simpleos_render_receipt(
    arch_code: u32,
    backend_code: u32,
    firmware: SimpleOsBuildIdentityV1,
    boot_id: u64,
    frame_id: u64,
    surface_handle: u64,
    width: u32,
    height: u32,
    pixels: [u32]
) -> SimpleOsRenderReceipt?:
    """Build one validated header/present/trailer receipt."""
    if width == 0u32 or height == 0u32:
        return nil
    if pixels.len().to_u64() != width.to_u64() * height.to_u64():
        return nil
    val pixel_hash = _render_sha256_words(simpleos_argb_pixel_sha256(pixels))
    if pixel_hash == nil:
        return nil
    val digest = pixel_hash!
    val nonblank = simpleos_nonblank_pixel_count(pixels)
    val header = BackendRenderReceiptHeader(
        version: BACKEND_RENDER_RECEIPT_VERSION,
        arch_code: arch_code,
        runtime_code: SIMPLEOS_RENDER_RUNTIME_QEMU,
        backend_code: backend_code,
        firmware_hash_word0: firmware.word0,
        firmware_hash_word1: firmware.word1,
        firmware_hash_word2: firmware.word2,
        firmware_hash_word3: firmware.word3,
        boot_id: boot_id,
        frame_id: frame_id,
        surface_handle: surface_handle,
        width: width,
        height: height,
        stride: width * 4u32,
        format_code: SIMPLEOS_RENDER_FORMAT_ARGB8888)
    val event = BackendRenderReceiptEvent(
        sequence: 1u32,
        operation_code: BACKEND_RENDER_OPERATION_PRESENT,
        resource_id: surface_handle,
        state_before: 0u32,
        state_after: 1u32,
        value_hash: digest.word0)
    val trailer = BackendRenderReceiptTrailer(
        event_count: 1u32,
        frame_complete: true,
        pixel_hash_word0: digest.word0,
        pixel_hash_word1: digest.word1,
        pixel_hash_word2: digest.word2,
        pixel_hash_word3: digest.word3,
        nonblank_pixel_count: nonblank,
        reason_code: 0u32)
    if (not backend_render_receipt_header_valid(header) or
        not backend_render_receipt_event_valid(event, 1u32) or
        not backend_render_receipt_trailer_valid(trailer, 1u32)):
        return nil
    Some(SimpleOsRenderReceipt(
        header: header, event: event, trailer: trailer))

fn simpleos_render_receipt_from_digest(
    arch_code: u32,
    backend_code: u32,
    firmware: SimpleOsBuildIdentityV1,
    boot_id: u64,
    frame_id: u64,
    surface_handle: u64,
    width: u32,
    height: u32,
    stride: u32,
    pixel_hash: SimpleOsBuildIdentityV1,
    nonblank_pixel_count: u64
) -> SimpleOsRenderReceipt?:
    """Build a receipt from an independently streamed scanout digest."""
    if (width == 0u32 or height == 0u32 or stride != width * 4u32 or
        surface_handle == 0u64 or nonblank_pixel_count == 0u64):
        return nil
    val header = BackendRenderReceiptHeader(
        version: BACKEND_RENDER_RECEIPT_VERSION,
        arch_code: arch_code,
        runtime_code: SIMPLEOS_RENDER_RUNTIME_QEMU,
        backend_code: backend_code,
        firmware_hash_word0: firmware.word0,
        firmware_hash_word1: firmware.word1,
        firmware_hash_word2: firmware.word2,
        firmware_hash_word3: firmware.word3,
        boot_id: boot_id,
        frame_id: frame_id,
        surface_handle: surface_handle,
        width: width,
        height: height,
        stride: stride,
        format_code: SIMPLEOS_RENDER_FORMAT_ARGB8888)
    val event = BackendRenderReceiptEvent(
        sequence: 1u32,
        operation_code: BACKEND_RENDER_OPERATION_PRESENT,
        resource_id: surface_handle,
        state_before: 0u32,
        state_after: 1u32,
        value_hash: pixel_hash.word0)
    val trailer = BackendRenderReceiptTrailer(
        event_count: 1u32,
        frame_complete: true,
        pixel_hash_word0: pixel_hash.word0,
        pixel_hash_word1: pixel_hash.word1,
        pixel_hash_word2: pixel_hash.word2,
        pixel_hash_word3: pixel_hash.word3,
        nonblank_pixel_count: nonblank_pixel_count,
        reason_code: 0u32)
    if (not backend_render_receipt_header_valid(header) or
        not backend_render_receipt_event_valid(event, 1u32) or
        not backend_render_receipt_trailer_valid(trailer, 1u32)):
        return nil
    Some(SimpleOsRenderReceipt(header: header, event: event, trailer: trailer))
