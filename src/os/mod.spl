# SimpleOS — Microkernel-based Desktop Operating System
#
# Architecture:
#   Layer 0: Boot (Limine, BSD-2-Clause)
#   Layer 1: Kernel (scheduler, VMM, IPC, capabilities)
#   Layer 2: Services (init, VFS/FAT32, net, drivers)
#   Layer 3: Compositor (framebuffer + window manager)
#   Layer 4: Desktop Apps (terminal, file manager, editor)
#   Layer 5: LLM Integration (MCP OS server + widget DSL)
#
# Target: x86_64 (QEMU), RISC-V 64 (later)
# Security: Capability-based (Capsicum + OpenBSD inspired)

@when(os = "simpleos"):
# Child modules are imported explicitly by the freestanding entry closure.
# Keeping the package root metadata-only prevents one child import from
# eagerly retaining every hosted tool, app, service, and compatibility lane.
val SIMPLEOS_TARGET_ROOT: bool = true
@else:
use os.kernel
use os.machine_profile
use os.async
use os.posix
use os.services
use os.drivers
use os.crypto
use os.compositor
use os.desktop
use os.game
use os.apps
@end
