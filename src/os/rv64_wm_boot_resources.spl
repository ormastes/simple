# Narrow fail-closed predicates for the combined RV64 SSH + WM boot owner.

pub val RV64_WM_BOOT_BINARY_PATH: text = "/sys/apps/browser_demo.smf"
pub val RV64_WM_BOOT_MAX_PUMP_ATTEMPTS: i64 = 64

pub fn rv64_wm_scanout_metadata_valid(
    address: u64, width: u32, height: u32, pitch: u32, bpp: u32
) -> bool:
    (address != 0u64 and width > 0u32 and height > 0u32 and
        pitch == width * 4u32 and bpp == 32u32)

pub fn rv64_wm_snapshot_facts_ready(
    launched_pid: u64,
    snapshot_pid: u64,
    process_surface_count: i64,
    snapshot_ready: bool,
    inputs_consistent: bool,
    content_frame_count: i64,
    taskbar_revision: i64
) -> bool:
    (launched_pid > 0u64 and snapshot_pid == launched_pid and
        process_surface_count > 0 and snapshot_ready and inputs_consistent and
        content_frame_count > 0 and taskbar_revision > 0)
