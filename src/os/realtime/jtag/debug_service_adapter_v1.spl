# DebugServiceV1 harmony bridge for the existing OpenOCD JtagProbe owner.
#
# This adapter does not open sockets, spawn OpenOCD, or implement GDB-RSP/JTAG.
# OpenOcdProbe remains the transport owner.  The bridge binds that resource to
# a central DebugSessionId and puts policy/receipt gates around its operations.

use std.common.debug.capability.{CapLevel}
use std.common.debug.contracts_v1.{
    DebugSessionId, DebugPolicyV1, DebugReceiptV1,
    DebugCapabilityV1, DebugVerificationV1,
    DebugPerturbationV1, DebugRootOperationV1, DebugTargetNodeV1,
}
use std.common.debug.service_v1.{
    central_debug_service_v1_open, central_debug_service_v1_add_target,
    central_debug_service_v1_authorize, central_debug_service_v1_record,
    central_debug_service_v1_close,
}
use os.realtime.jtag.openocd_probe.{OpenOcdProbe, openocd_tcl_send}

pub enum OpenOcdActionV1:
    ReadMemory
    ReadRegister
    Poll
    Halt
    Resume
    RawMonitor
    Flash
    Reset
    WriteMemory
    WriteRegister

pub fn openocd_action_operation_v1(action: OpenOcdActionV1) -> DebugRootOperationV1:
    match action:
        case OpenOcdActionV1.ReadMemory: DebugRootOperationV1.Inspect
        case OpenOcdActionV1.ReadRegister: DebugRootOperationV1.Inspect
        case OpenOcdActionV1.Poll: DebugRootOperationV1.Inspect
        case OpenOcdActionV1.Halt: DebugRootOperationV1.Control
        case OpenOcdActionV1.Resume: DebugRootOperationV1.Control
        case OpenOcdActionV1.RawMonitor: DebugRootOperationV1.Domain
        case OpenOcdActionV1.Flash: DebugRootOperationV1.Domain
        case OpenOcdActionV1.Reset: DebugRootOperationV1.Control
        case OpenOcdActionV1.WriteMemory: DebugRootOperationV1.Control
        case OpenOcdActionV1.WriteRegister: DebugRootOperationV1.Control

pub fn openocd_action_perturbation_v1(action: OpenOcdActionV1) -> DebugPerturbationV1:
    match action:
        case OpenOcdActionV1.ReadMemory: DebugPerturbationV1.Passive
        case OpenOcdActionV1.ReadRegister: DebugPerturbationV1.Passive
        case OpenOcdActionV1.Poll: DebugPerturbationV1.Passive
        case OpenOcdActionV1.Halt: DebugPerturbationV1.Stopping
        case OpenOcdActionV1.Resume: DebugPerturbationV1.Stopping
        case OpenOcdActionV1.RawMonitor: DebugPerturbationV1.Mutating
        case OpenOcdActionV1.Flash: DebugPerturbationV1.Mutating
        case OpenOcdActionV1.Reset: DebugPerturbationV1.Mutating
        case OpenOcdActionV1.WriteMemory: DebugPerturbationV1.Mutating
        case OpenOcdActionV1.WriteRegister: DebugPerturbationV1.Mutating

fn openocd_action_name_v1(action: OpenOcdActionV1) -> text:
    match action:
        case OpenOcdActionV1.ReadMemory: "read_memory"
        case OpenOcdActionV1.ReadRegister: "read_register"
        case OpenOcdActionV1.Poll: "poll"
        case OpenOcdActionV1.Halt: "halt"
        case OpenOcdActionV1.Resume: "resume"
        case OpenOcdActionV1.RawMonitor: "raw_monitor"
        case OpenOcdActionV1.Flash: "flash"
        case OpenOcdActionV1.Reset: "reset"
        case OpenOcdActionV1.WriteMemory: "write_memory"
        case OpenOcdActionV1.WriteRegister: "write_register"

pub class OpenOcdDebugServiceAdapterV1:
    probe: OpenOcdProbe
    session_id: DebugSessionId
    resource_id: text
    bound: bool

    static fn create(probe: OpenOcdProbe) -> OpenOcdDebugServiceAdapterV1:
        OpenOcdDebugServiceAdapterV1(
            probe: probe,
            session_id: DebugSessionId(value: ""),
            resource_id: "",
            bound: false,
        )

    me bind(build_id: text, resource_id: text, policy: DebugPolicyV1) -> Result<DebugSessionId, text>:
        if self.bound:
            return Err("OpenOCD resource is already bound")
        if resource_id.trim() == "":
            return Err("OpenOCD binding requires a resource id")
        if not self.probe.connected:
            return Err("OpenOCD resource must be connected by its transport owner")
        val session_id = central_debug_service_v1_open(build_id, policy)?
        val node = DebugTargetNodeV1(
            target_id: resource_id,
            parent_target_id: "",
            kind: "embedded.openocd-jtag",
            label: "OpenOCD " + self.probe.host + ":" + self.probe.port.to_text(),
        )
        val capability = DebugCapabilityV1(
            target_id: resource_id,
            support: CapLevel.Native,
            verification: DebugVerificationV1.Unverified,
            perturbation: DebugPerturbationV1.Stopping,
            reason: "bound to an existing OpenOCD JTAG resource; each live command outcome is receipted",
        )
        match central_debug_service_v1_add_target(session_id, node, capability):
            case Err(reason):
                central_debug_service_v1_close(session_id)
                return Err(reason)
            case Ok(_): ()
        self.session_id = session_id
        self.resource_id = resource_id
        self.bound = true
        Ok(session_id)

    me read_memory(session_id: DebugSessionId, address: u64, length: i32) -> Result<[u8], text>:
        self.require_session(session_id)?
        self.authorize(OpenOcdActionV1.ReadMemory)?
        val bytes = self.probe.read_region(address, length)
        central_debug_service_v1_record(session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "openocd.read_memory.outcome", true, false, "")
        Ok(bytes)

    me read_register(session_id: DebugSessionId, name: text) -> Result<u64, text>:
        self.require_session(session_id)?
        self.authorize(OpenOcdActionV1.ReadRegister)?
        val value = self.probe.read_register(name)
        central_debug_service_v1_record(session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "openocd.read_register.outcome", true, false, "")
        Ok(value)

    me poll_halted(session_id: DebugSessionId) -> Result<bool, text>:
        self.require_session(session_id)?
        self.authorize(OpenOcdActionV1.Poll)?
        val halted = self.probe.is_halted()
        central_debug_service_v1_record(session_id, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, "openocd.poll.outcome", true, false, "")
        Ok(halted)

    me halt(session_id: DebugSessionId) -> Result<Nil, text>:
        self.require_session(session_id)?
        self.authorize(OpenOcdActionV1.Halt)?
        self.record_outcome(OpenOcdActionV1.Halt, self.probe.halt())

    me resume(session_id: DebugSessionId) -> Result<Nil, text>:
        self.require_session(session_id)?
        self.authorize(OpenOcdActionV1.Resume)?
        self.record_outcome(OpenOcdActionV1.Resume, self.probe.resume())

    me reset(session_id: DebugSessionId) -> Result<Nil, text>:
        self.require_session(session_id)?
        self.authorize(OpenOcdActionV1.Reset)?
        self.record_outcome(OpenOcdActionV1.Reset, self.probe.reset())

    me write_memory(session_id: DebugSessionId, address: u64, data: [u8]) -> Result<Nil, text>:
        self.require_session(session_id)?
        self.authorize(OpenOcdActionV1.WriteMemory)?
        self.record_outcome(OpenOcdActionV1.WriteMemory, self.probe.write_region(address, data))

    me write_register(session_id: DebugSessionId, name: text, value: u64) -> Result<Nil, text>:
        self.require_session(session_id)?
        self.authorize(OpenOcdActionV1.WriteRegister)?
        self.record_outcome(OpenOcdActionV1.WriteRegister, self.probe.write_register(name, value))

    me raw_monitor(session_id: DebugSessionId, command: text) -> Result<Nil, text>:
        if command.trim() == "":
            return Err("OpenOCD monitor command must not be empty")
        self.require_session(session_id)?
        self.authorize(OpenOcdActionV1.RawMonitor)?
        val succeeded = openocd_tcl_send(self.probe.host, self.probe.port, command)
        self.record_outcome(OpenOcdActionV1.RawMonitor, succeeded)

    me flash(session_id: DebugSessionId, image_path: text) -> Result<Nil, text>:
        if image_path.trim() == "":
            return Err("OpenOCD flash requires an image path")
        self.require_session(session_id)?
        self.authorize(OpenOcdActionV1.Flash)?
        val succeeded = openocd_tcl_send(self.probe.host, self.probe.port, "program " + image_path + " verify reset")
        self.record_outcome(OpenOcdActionV1.Flash, succeeded)

    me close(session_id: DebugSessionId) -> Result<Nil, text>:
        self.require_session(session_id)?
        central_debug_service_v1_close(session_id)?
        self.bound = false
        Ok(nil)

    fn require_session(session_id: DebugSessionId) -> Result<Nil, text>:
        if not self.bound:
            return Err("OpenOCD resource is not bound")
        if self.session_id.value != session_id.value:
            return Err("debug session id does not own this OpenOCD resource")
        Ok(nil)

    me authorize(action: OpenOcdActionV1) -> Result<DebugReceiptV1, text>:
        val receipt = central_debug_service_v1_authorize(
            self.session_id,
            openocd_action_operation_v1(action),
            openocd_action_perturbation_v1(action),
            "openocd." + openocd_action_name_v1(action),
        )
        if not receipt.allowed:
            return Err(receipt.reason)
        Ok(receipt)

    me record_outcome(action: OpenOcdActionV1, succeeded: bool) -> Result<Nil, text>:
        val perturbation = openocd_action_perturbation_v1(action)
        val changed = succeeded and perturbation != DebugPerturbationV1.Passive
        val reason = if succeeded: "" else: "OpenOCD transport owner rejected command"
        central_debug_service_v1_record(
            self.session_id,
            openocd_action_operation_v1(action),
            perturbation,
            "openocd." + openocd_action_name_v1(action) + ".outcome",
            succeeded,
            changed,
            reason,
        )
        if not succeeded:
            return Err(reason)
        Ok(nil)
