# @platform: baremetal
#
# RTOS replay hooks — called from scheduler, timer, I/O, random.
# Each hook checks rtos_replay_is_off() first — single load + branch.
#
# Hooks that make a replay-time decision run on the portable semantic replay
# core std.replay.portable_replay (DHR P6), in replay scope RR_PORTABLE_SCOPE:
#   schedule  (PR_KIND_SCHEDULE)    Replay returns the logged tid to run
#   timer     (PR_KIND_TIMER_READ)  Replay returns the logged tick
#   irq       (RR_PR_KIND_IRQ)      Replay accepts only the logged vector
#   io read   (PR_KIND_IO_READ)     Replay returns the logged value
#   random    (PR_KIND_RANDOM_READ) Replay returns the logged value
# Replay never falls back to the live value: a wrong event or an exhausted log
# is counted as a divergence and fails closed. Verify returns live and counts
# a wrong, missing or changed event.
#
# Diagnostic-only hooks make no replay decision (nothing is read back in
# Replay or Verify), so they stay on the bm_replay_core ring
# (4 x i64 per event, 4096 cap): 3 = io_write, 6 = checkpoint,
# 7 = task_create, 8 = task_exit.

use std.replay.bm_replay_core (bm_ring_push, bm_ring_count)
use std.replay.portable_replay.{
    PR_MODE_OFF, PR_MODE_RECORD, PR_MODE_REPLAY, PR_KIND_TIMER_READ, PR_KIND_RANDOM_READ,
    PR_KIND_SCHEDULE, PR_KIND_IO_READ, PR_DIV_NONE, PR_SCOPE_REALTIME,
    portable_replay_set_mode, portable_replay_mode, portable_replay_open_scope,
    portable_replay_scope_is_open, portable_replay_event, portable_replay_last_divergence,
    portable_replay_pending
}

val RR_IO_WRITE: i64 = 3
val RR_CHECKPOINT: i64 = 6
val RR_TASK_CREATE: i64 = 7
val RR_TASK_EXIT: i64 = 8

val RR_PORTABLE_SCOPE: i64 = PR_SCOPE_REALTIME
# Realtime-defined core kind (the core's own kinds are 1..4).
val RR_PR_KIND_IRQ: i64 = 6
# Tid returned by a diverging schedule replay: the scheduler NO_TASK, so
# nothing is dispatched (the core's fail-closed 0 could be a real tid).
val RR_SCHEDULE_DIVERGED: i32 = -1

var divergence_count: i32 = 0

@allow(primitive_api)  # reason: scheduler hot path; raw task ids and tick, no allocation for a domain wrapper
pub fn rr_hook_schedule(old_tid: i32, new_tid: i32, tick: u64) -> i32:
    """Record/replay a context switch decision; returns the tid to run.
    Off/Record/Verify return the live pick. Replay returns the logged tid so
    the scheduler follows the recording; a wrong event or an exhausted log is
    a counted divergence and returns RR_SCHEDULE_DIVERGED (never the live
    pick). The hook cannot see task state: a caller must treat a logged tid
    it cannot run as a divergence too."""
    if rtos_replay_is_off():
        return new_tid
    rr_portable_sync()
    val live = new_tid.to_i64()
    if rtos_replay_is_recording():
        rr_portable_record(PR_KIND_SCHEDULE, live)
        return new_tid
    if rtos_replay_is_replaying():
        val logged = rr_portable_replay(PR_KIND_SCHEDULE, live)
        if portable_replay_last_divergence(RR_PORTABLE_SCOPE) != PR_DIV_NONE:
            return RR_SCHEDULE_DIVERGED
        return logged.to_i32()
    if rtos_replay_is_verifying():
        rr_portable_verify(PR_KIND_SCHEDULE, live)
    new_tid

@allow(primitive_api)  # reason: timer ISR hot path; raw tick count, no allocation for a domain wrapper
pub fn rr_hook_timer_tick(tick: u64) -> u64:
    """Record/replay the observed timer tick; returns the tick to use.
    Replay returns the logged tick, or the core's fail-closed value on
    divergence (never the live tick). Verify returns live and reports."""
    if rtos_replay_is_off():
        return tick
    rr_portable_sync()
    val live = tick.to_i64()
    if rtos_replay_is_recording():
        rr_portable_record(PR_KIND_TIMER_READ, live)
        return tick
    if rtos_replay_is_replaying():
        return rr_portable_replay(PR_KIND_TIMER_READ, live).to_u64()
    if rtos_replay_is_verifying():
        rr_portable_verify(PR_KIND_TIMER_READ, live)
    tick

@allow(primitive_api)  # reason: IRQ entry hot path; raw hardware vector and tick, no allocation for a domain wrapper
pub fn rr_hook_irq(vector: i32, tick: u64) -> bool:
    """Record/replay an interrupt delivery; returns whether to deliver it.
    Replay delivers only the logged vector: a different vector, a wrong event
    or an exhausted log is a counted divergence and is not delivered. Verify
    always delivers and reports."""
    if rtos_replay_is_off():
        return true
    rr_portable_sync()
    val live = vector.to_i64()
    if rtos_replay_is_recording():
        rr_portable_record(RR_PR_KIND_IRQ, live)
        return true
    if rtos_replay_is_replaying():
        val logged = rr_portable_replay(RR_PR_KIND_IRQ, live)
        if portable_replay_last_divergence(RR_PORTABLE_SCOPE) != PR_DIV_NONE:
            return false
        if logged != live:
            divergence_count = divergence_count + 1
            return false
        return true
    if rtos_replay_is_verifying():
        rr_portable_verify(RR_PR_KIND_IRQ, live)
    true

fn rr_hook_io_write(addr: u64, value: u64):
    """Record an I/O write (diagnostic only: no replay decision)."""
    if rtos_replay_is_off():
        return
    if rtos_replay_is_recording():
        bm_ring_push(RR_IO_WRITE, rtos_replay_next_seq(), addr.to_i64(), value.to_i64())

fn rr_hook_io_read(addr: u64, value: u64) -> u64:
    """Record/replay an I/O read on the portable core (the value only; addr
    was never checked on replay). Replay returns the logged value, or the
    core's fail-closed value on divergence (never the live one). Verify
    consumes the logged value, reports a mismatch, and returns live."""
    if rtos_replay_is_off():
        return value
    rr_portable_sync()
    val live = value.to_i64()
    if rtos_replay_is_recording():
        rr_portable_record(PR_KIND_IO_READ, live)
        return value
    if rtos_replay_is_replaying():
        return rr_portable_replay(PR_KIND_IO_READ, live).to_u64()
    if rtos_replay_is_verifying():
        rr_portable_verify(PR_KIND_IO_READ, live)
    value

fn rr_hook_random(value: u64) -> u64:
    """Record/replay random number. In replay, returns the logged value, or
    the portable core's fail-closed value on divergence (never the live one)."""
    if rtos_replay_is_off():
        return value
    rr_portable_sync()
    if rtos_replay_is_recording():
        rtos_replay_next_seq()  # keep the shared seq numbering of the other hooks
    val replayed = portable_replay_event(PR_KIND_RANDOM_READ, RR_PORTABLE_SCOPE, value.to_i64())
    if portable_replay_last_divergence(RR_PORTABLE_SCOPE) != PR_DIV_NONE:
        # Wrong event or end-of-log: counted, and the core's fail-closed value
        # is returned — never the live value (DHR P6: no live fallback).
        divergence_count = divergence_count + 1
    replayed.to_u64()

fn rr_portable_sync():
    """Mirror the RTOS mode onto the portable replay session (DHR P6).
    Verify does not replay random reads, so it maps to Off."""
    var want = PR_MODE_OFF
    if rtos_replay_is_recording():
        want = PR_MODE_RECORD
    elif rtos_replay_is_replaying():
        want = PR_MODE_REPLAY
    if portable_replay_mode(RR_PORTABLE_SCOPE) != want:
        portable_replay_set_mode(RR_PORTABLE_SCOPE, want)
    if not portable_replay_scope_is_open(RR_PORTABLE_SCOPE):
        portable_replay_open_scope(RR_PORTABLE_SCOPE)

fn rr_portable_record(kind: i64, live: i64):
    """Log one event on the core, keeping the shared seq numbering of the
    ring hooks."""
    rtos_replay_next_seq()
    portable_replay_event(kind, RR_PORTABLE_SCOPE, live)

fn rr_portable_replay(kind: i64, live: i64) -> i64:
    """Replay one event: the logged value, or the core's fail-closed value on
    a wrong event or an exhausted log, which is counted (never `live`)."""
    val replayed = portable_replay_event(kind, RR_PORTABLE_SCOPE, live)
    if portable_replay_last_divergence(RR_PORTABLE_SCOPE) != PR_DIV_NONE:
        divergence_count = divergence_count + 1
    replayed

fn rr_portable_verify(kind: i64, live: i64):
    """Verify one event against the log. The session is Off in Verify (random
    reads are not replayed there), so the core steps in Replay for this one
    event; a wrong event, exhausted log or changed value is counted."""
    portable_replay_set_mode(RR_PORTABLE_SCOPE, PR_MODE_REPLAY)
    val logged = portable_replay_event(kind, RR_PORTABLE_SCOPE, live)
    val diverged = portable_replay_last_divergence(RR_PORTABLE_SCOPE) != PR_DIV_NONE
    portable_replay_set_mode(RR_PORTABLE_SCOPE, PR_MODE_OFF)
    if diverged or logged != live:
        divergence_count = divergence_count + 1

fn rr_hook_checkpoint(checkpoint_id: i32):
    """Insert a named checkpoint into the event log."""
    if rtos_replay_is_off():
        return
    if rtos_replay_is_recording():
        bm_ring_push(RR_CHECKPOINT, rtos_replay_next_seq(), checkpoint_id.to_i64(), 0)

fn rr_hook_task_create(task_id: i32, priority: i32):
    """Record task creation."""
    if rtos_replay_is_off():
        return
    if rtos_replay_is_recording():
        bm_ring_push(RR_TASK_CREATE, rtos_replay_next_seq(), task_id.to_i64(), priority.to_i64())

fn rr_hook_task_exit(task_id: i32):
    """Record task exit."""
    if rtos_replay_is_off():
        return
    if rtos_replay_is_recording():
        bm_ring_push(RR_TASK_EXIT, rtos_replay_next_seq(), task_id.to_i64(), 0)

pub fn rr_report_schedule_divergence():
    """Count a Replay schedule the scheduler cannot follow: the logged tid is
    not runnable (the hook itself cannot see task state)."""
    divergence_count = divergence_count + 1

fn rr_divergence_count() -> i32:
    """Return number of verify-mode divergences detected."""
    divergence_count

fn rr_reset_divergences():
    """Reset divergence counter."""
    divergence_count = 0

fn rr_event_count() -> i64:
    """Return number of logged events not yet replayed (ring + portable core)."""
    bm_ring_count() + portable_replay_pending(RR_PORTABLE_SCOPE)
