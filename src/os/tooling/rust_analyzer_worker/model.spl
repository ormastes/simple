pub enum RustAnalysisState:
    Complete
    Partial
    Failed
    Cancelled
    TimedOut

pub enum RustSuggestionApplicability:
    MachineApplicable
    MaybeIncorrect
    HasPlaceholders
    Unspecified

pub struct RustToolchainIdentityV1:
    cargo_version: text
    rustc_version: text
    clippy_version: text
    rust_analyzer_version: text
    workspace_fingerprint: text
    configuration_fingerprint: text

pub struct RustSpanV1:
    file_name: text
    byte_start: u64
    byte_end: u64
    line_start: u32
    line_end: u32
    column_start: u32
    column_end: u32

pub struct RustSuggestionV1:
    replacement: text
    applicability: RustSuggestionApplicability
    span: RustSpanV1

pub struct RustDiagnosticChildV1:
    level: text
    message: text
    spans: [RustSpanV1]
    suggestions: [RustSuggestionV1]

pub struct RustDiagnosticV1:
    code: text
    level: text
    message: text
    span: RustSpanV1
    spans: [RustSpanV1]
    suggestions: [RustSuggestionV1]
    children: [RustDiagnosticChildV1]

pub struct RustAnalysisResultV1:
    state: RustAnalysisState
    identity: RustToolchainIdentityV1
    diagnostics: [RustDiagnosticV1]
    malformed_record_count: u32
    truncated: bool
    stderr_text: text
