# Hosted-only semantic Web adapter. BrowserSession stays out of compositor core.

use std.gc_async_mut.web.browser_session.{
    BrowserSession, BrowserBookmarkSnapshot, BrowserRequest, BrowserResponse
}
use std.gc_async_mut.web.browser_session_loading.*
use std.gc_async_mut.web.browser_session_runtime.*
use std.gc_async_mut.web.browser_session_ui_access.*
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{
    be_dom_event_identity_at_element_path, be_dom_focused_id
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_hit_test_target_at_time_with_animations
}
use std.gc_async_mut.gpu.browser_engine.net.entity.request_types.{
    FetchRequest, FetchResponse, RequestMode
}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Origin, Url}
use std.gc_async_mut.gpu.browser_engine.net.fetch.{FetchEngine}
use std.gc_async_mut.gpu.browser_engine.net.h1_client.{
    build_request_bytes, h1_mock_response, parse_http_response_bytes
}
use std.gc_async_mut.gpu.browser_engine.shared.logging.{Logger, LogLevel}
use std.database.sql.types.{DbError}
use os.hosted.browser_profile_store.{BrowserBookmarkStore}
use os.hosted.hosted_browser_renderer_policy.{
    hosted_browser_transport_host
}
use common.ui.access.{WinTextActionRequest}
use common.string_builder.{StringBuilder}
use std.common.encoding.utf8.{text_without_last_codepoint}

extern fn rt_text_to_bytes(value: text) -> [u8]
extern fn rt_browser_http_job_start_public_limited(
    scheme: text, host: text, port: i64, request: [u8], timeout_ms: i64,
    max_response_bytes: i64
) -> i64
extern fn rt_browser_http_job_poll(handle: i64) -> i64
extern fn rt_browser_http_job_take_response(handle: i64) -> [u8]
extern fn rt_browser_http_job_take_error(handle: i64) -> text
extern fn rt_browser_http_job_cancel(handle: i64) -> bool
extern fn rt_browser_http_job_free(handle: i64) -> bool

fn _hosted_fetch_mode(kind: text) -> RequestMode:
    if kind == "document":
        return RequestMode.Navigate
    if kind == "style" or kind == "script":
        return RequestMode.NoCors
    RequestMode.SameOrigin

fn _hosted_fetch_headers(request: BrowserRequest) -> text:
    var lines: [text] = []
    var has_content_type = false
    for raw_line in request.headers.split("\n"):
        val line = raw_line.trim()
        if line == "":
            continue
        if line.to_lower().starts_with("content-type:"):
            has_content_type = true
        lines.push(line)
    if request.content_type != "" and not has_content_type:
        lines.push("Content-Type: {request.content_type}")
    lines.join("\r\n")

fn _hosted_wasm_hex(data: [u8]) -> text:
    var out = StringBuilder.new()
    for byte in data:
        val numeric = byte.to_i64()
        val piece = numeric.to_hex()
        out.push(if piece.len() == 1: "0{piece}" else: piece)
    out.build()

struct HostedWebContentDispatch:
    event_id: i64
    wm_target_id: i64
    semantic_target_id: text
    callback_count: i64
    mutation_revision: i64
    reason: text

class HostedWebContentSession:
    window_id: i64
    width: i32
    height: i32
    browser: BrowserSession
    network: FetchEngine
    mutation_revision: i64
    failure_reason: text
    last_target_id: text
    pressed_target_id: text
    published_body_html: text
    started_at_ms: i64
    profile_enabled: bool
    chrome_focus: text
    pressed_chrome_control: text
    address_replace_on_text: bool
    network_job_handle: i64
    network_job_request: BrowserRequest?
    network_job_fetch_request: FetchRequest?

    static fn create(window_id: i64, body_html: text, width: i32, height: i32) -> HostedWebContentSession:
        var browser = BrowserSession.new()
        val initial_url = if body_html.starts_with("about:"):
            body_html
        else:
            "simple-wm://window/{window_id}"
        val opened = browser.open_html(
            initial_url,
            "<html><body>{body_html}</body></html>"
        )
        var failure_reason = ""
        if val Err(reason) = opened:
            failure_reason = reason
        val published_html = (
            browser.current_style_html + browser.current_body_html
        )
        HostedWebContentSession(
            window_id: window_id,
            width: width,
            height: height,
            browser: browser,
            network: FetchEngine.new(
                Logger.new("hosted-browser-network", LogLevel.Error)
            ),
            mutation_revision: 0,
            failure_reason: failure_reason,
            last_target_id: "",
            pressed_target_id: "",
            published_body_html: published_html,
            started_at_ms: -1,
            profile_enabled: false,
            chrome_focus: "",
            pressed_chrome_control: "",
            address_replace_on_text: false,
            network_job_handle: 0,
            network_job_request: nil,
            network_job_fetch_request: nil
        )

    fn presentation_html() -> text:
        self.browser.current_style_html + self.browser.current_body_html

    me _commit_network_error(request: BrowserRequest, message: text):
        val _ = self.browser.commit_network_response(
            BrowserResponse.create(
                request_id: request.id,
                kind: request.kind,
                url: request.url,
                status: 0,
                headers: "",
                body: "",
                error: message
            )
        )

    me _commit_network_response(
        request: BrowserRequest, response: FetchResponse
    ):
        val body = if request.kind == "wasm":
            _hosted_wasm_hex(response.body)
        else:
            response.body_text()
        val _ = self.browser.commit_network_response(
            BrowserResponse.create(
                request_id: request.id,
                kind: request.kind,
                url: request.url,
                status: response.status.to_i32(),
                headers: response.headers,
                body: body,
                error: ""
            )
        )

    me _finalize_network_response(
        request: BrowserRequest, fetch_request: FetchRequest,
        response: FetchResponse
    ):
        match self.network.finalize_single_hop(fetch_request, response):
            Ok(finalized):
                self._commit_network_response(request, finalized)
            Err(error):
                self._commit_network_error(request, error.message)

    me cancel_network():
        if self.network_job_handle > 0:
            val _ = rt_browser_http_job_cancel(self.network_job_handle)
            val _ = rt_browser_http_job_free(self.network_job_handle)
        self.network_job_handle = 0
        self.network_job_request = nil
        self.network_job_fetch_request = nil

    me _cancel_orphaned_network_job():
        if self.network_job_handle <= 0:
            return
        if self.network_job_request == nil:
            self.cancel_network()
            return
        if not self.browser.has_inflight_request(
            self.network_job_request.unwrap()
        ):
            self.cancel_network()

    me _poll_network_job():
        if self.network_job_request == nil or self.network_job_fetch_request == nil:
            self.cancel_network()
            return
        val request = self.network_job_request.unwrap()
        val fetch_request = self.network_job_fetch_request.unwrap()
        self._cancel_orphaned_network_job()
        if self.network_job_handle <= 0:
            return
        val state = rt_browser_http_job_poll(self.network_job_handle)
        if state == 0:
            return
        val handle = self.network_job_handle
        self.network_job_handle = 0
        self.network_job_request = nil
        self.network_job_fetch_request = nil
        if state < 0:
            val _ = rt_browser_http_job_free(handle)
            self._commit_network_error(request, "browser HTTP job unavailable")
            return
        val error = rt_browser_http_job_take_error(handle)
        val raw_response = rt_browser_http_job_take_response(handle)
        val _ = rt_browser_http_job_free(handle)
        if error != "":
            self._commit_network_error(request, error)
            return
        match parse_http_response_bytes(raw_response):
            Ok(response):
                self._finalize_network_response(
                    request, fetch_request, response
                )
            Err(parse_error):
                self._commit_network_error(request, parse_error.message)

    me _pump_network_once():
        if self.network_job_handle > 0:
            self._poll_network_job()
            return
        if val Some(request) = self.browser.take_pending_request():
            self.network.set_requester_origin(
                Origin.from_url(Url.parse_or_opaque(self.browser.document_url)).to_text()
            )
            val fetch_request = FetchRequest(
                url: Url.parse_or_opaque(request.url),
                method: request.method,
                headers: _hosted_fetch_headers(request),
                body: rt_text_to_bytes(request.body),
                mode: _hosted_fetch_mode(request.kind),
                # BrowserSession owns the cookie jar and already attached the
                # sanitized Cookie header for this exact request URL.
                credentials: "omit"
            )
            match self.network.prepare_single_hop(fetch_request):
                Err(error):
                    self._commit_network_error(request, error.message)
                Ok(prepared):
                    if val Some(response) = prepared.response:
                        self._commit_network_response(request, response)
                        return
                    if val Some(mock_result) = h1_mock_response(prepared.request):
                        match mock_result:
                            Ok(response):
                                self._finalize_network_response(
                                    request, prepared.request, response
                                )
                            Err(error):
                                self._commit_network_error(
                                    request, error.message
                                )
                        return
                    val url = prepared.request.url
                    val port = if url.port > 0:
                        url.port
                    elif url.scheme == "https":
                        443
                    else:
                        80
                    val handle = rt_browser_http_job_start_public_limited(
                        url.scheme,
                        hosted_browser_transport_host(url.host),
                        port,
                        rt_text_to_bytes(build_request_bytes(prepared.request)),
                        5000, 589824
                    )
                    if handle < 0:
                        self._commit_network_error(
                            request, "browser HTTP job unavailable"
                        )
                        return
                    self.network_job_handle = handle
                    self.network_job_request = Some(request)
                    self.network_job_fetch_request = Some(prepared.request)

    fn address_text() -> text:
        if self.browser.address_draft != "":
            return self.browser.address_draft
        if self.browser.pending_url != "":
            return self.browser.pending_url
        self.browser.current_url

    me _chrome_action(
        event_id: i64, control: text, action: text, value: text
    ) -> HostedWebContentDispatch:
        val before_body = self.browser.current_body_html
        val result = self.browser.ui_access_act(WinTextActionRequest(
            target_id: "browser:session#{control}",
            action: action,
            text_value: value,
            x: 0,
            y: 0
        ))
        self._cancel_orphaned_network_job()
        if result.ok:
            if self.browser.current_body_html != before_body:
                self.published_body_html = self.presentation_html()
            self.mutation_revision = self.mutation_revision + 1
        HostedWebContentDispatch(
            event_id: event_id,
            wm_target_id: self.window_id,
            semantic_target_id: "browser:session#{control}",
            callback_count: if result.ok: 1 else: 0,
            mutation_revision: self.mutation_revision,
            reason: if result.ok: "" else: result.message
        )

    me dispatch_chrome_pointer(
        event_id: i64, control: text, down: bool
    ) -> HostedWebContentDispatch:
        self.pressed_target_id = ""
        if down:
            self.pressed_chrome_control = control
            if control == "address":
                self.chrome_focus = "address"
                self.address_replace_on_text = true
            else:
                self.chrome_focus = ""
                self.address_replace_on_text = false
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "browser:session#{control}",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: "chrome-pressed"
            )
        val pressed = self.pressed_chrome_control
        self.pressed_chrome_control = ""
        if pressed != control:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "browser:session#{control}",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: "chrome-release-target-mismatch"
            )
        if control == "address":
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "browser:session#address",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: "address-focused"
            )
        if control == "favorite" and not self.profile_enabled:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "browser:session#favorite",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: "profile-unavailable"
            )
        self._chrome_action(event_id, control, "click", "")

    me advance_at(now_ms: i64) -> bool:
        if self.failure_reason != "" or now_ms < 0:
            return false
        if self.started_at_ms < 0:
            self.started_at_ms = now_ms
        val _ = self.browser.advance_time(now_ms - self.started_at_ms)
        self._pump_network_once()
        val body_html = self.presentation_html()
        if body_html == self.published_body_html:
            return false
        self.published_body_html = body_html
        self.mutation_revision = self.mutation_revision + 1
        true

    me dispatch_pointer_at(event_id: i64, x: i32, y: i32, down: bool) -> HostedWebContentDispatch:
        self.chrome_focus = ""
        self.address_replace_on_text = false
        self.pressed_chrome_control = ""
        if self.failure_reason != "":
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: self.failure_reason
        )
        val root = self.browser.dom_root()
        val animation_time_ms = (
            self.browser.monotonic_time_ms -
            self.browser.animation_start_time_ms
        )
        self.browser.prepare_css_animation_instances(self.width)
        val target_key = simple_web_layout_hit_test_target_at_time_with_animations(
            self.browser.render_html_document(), self.width, self.height,
            x, y, animation_time_ms,
            self.browser.css_animation_instances
        )
        val target_id = if target_key.starts_with("id:"):
            target_key.slice(3, target_key.len())
        elif target_key.starts_with("path:"):
            be_dom_event_identity_at_element_path(
                root, target_key.slice(5, target_key.len())
            )
        else:
            ""
        if target_id == "":
            self.pressed_target_id = ""
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: "no-semantic-target"
            )
        val before = self.browser.current_body_html
        val callback_start = self.browser.dom_callback_count
        if down:
            self.pressed_target_id = target_id
            val _ = self.browser.dispatch_dom_event(
                target_id, "pointerdown", true, true
            )
            val _ = self.browser.dispatch_dom_event(
                target_id, "mousedown", true, true
            )
            val callback_count = self.browser.dom_callback_count - callback_start
            self._cancel_orphaned_network_job()
            val changed = self.browser.current_body_html != before
            if changed:
                self.published_body_html = self.presentation_html()
                self.mutation_revision = self.mutation_revision + 1
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: target_id,
                callback_count: callback_count,
                mutation_revision: self.mutation_revision,
                reason: if changed: "" else: "pointer-pressed"
            )
        val pressed_target_id = self.pressed_target_id
        self.pressed_target_id = ""
        val _ = self.browser.dispatch_dom_event(
            target_id, "pointerup", true, true
        )
        val _ = self.browser.dispatch_dom_event(
            target_id, "mouseup", true, true
        )
        if pressed_target_id == target_id and pressed_target_id != "":
            val _ = self.browser.dispatch_dom_event(
                target_id, "click", true, true
            )
        val callback_count = self.browser.dom_callback_count - callback_start
        self._cancel_orphaned_network_job()
        self.last_target_id = be_dom_focused_id(self.browser.dom_root())
        val changed = self.browser.current_body_html != before
        if changed:
            self.published_body_html = self.presentation_html()
            self.mutation_revision = self.mutation_revision + 1
        HostedWebContentDispatch(
            event_id: event_id,
            wm_target_id: self.window_id,
            semantic_target_id: target_id,
            callback_count: callback_count,
            mutation_revision: self.mutation_revision,
            reason: if changed:
                ""
            elif pressed_target_id == "":
                "pointer-release-without-press"
            elif pressed_target_id != target_id:
                "pointer-release-target-mismatch"
            else:
                "no-application-mutation"
        )

    me dispatch_text(event_id: i64, value: text) -> HostedWebContentDispatch:
        if self.chrome_focus == "address":
            val current = self.address_text()
            val updated = if self.address_replace_on_text:
                value
            else:
                current + value
            self.address_replace_on_text = false
            return self._chrome_action(
                event_id, "address", "set_value", updated
            )
        if self.last_target_id == "":
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: "no-focused-semantic-target"
            )
        val before = self.browser.current_body_html
        val callback_start = self.browser.dom_callback_count
        val updated = self.browser.append_dom_text_input(
            self.last_target_id, value
        )
        if val Err(reason) = updated:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: self.last_target_id,
                callback_count:
                    self.browser.dom_callback_count - callback_start,
                mutation_revision: self.mutation_revision,
                reason: reason
            )
        val callback_count = self.browser.dom_callback_count - callback_start
        self._cancel_orphaned_network_job()
        val active_id = be_dom_focused_id(self.browser.dom_root())
        self.last_target_id = active_id
        val changed = self.browser.current_body_html != before
        if changed:
            self.published_body_html = self.presentation_html()
            self.mutation_revision = self.mutation_revision + 1
        HostedWebContentDispatch(
            event_id: event_id,
            wm_target_id: self.window_id,
            semantic_target_id: self.last_target_id,
            callback_count: callback_count,
            mutation_revision: self.mutation_revision,
            reason: if changed: "" else: "no-application-mutation"
        )

    me dispatch_key(
        event_id: i64, keycode: i64, pressed: bool
    ) -> HostedWebContentDispatch:
        self.dispatch_key_with_shift(event_id, keycode, pressed, false)

    me dispatch_key_with_shift(
        event_id: i64, keycode: i64, pressed: bool, shift_key: bool
    ) -> HostedWebContentDispatch:
        if self.chrome_focus == "address":
            if not pressed:
                return HostedWebContentDispatch(
                    event_id: event_id,
                    wm_target_id: self.window_id,
                    semantic_target_id: "browser:session#address",
                    callback_count: 0,
                    mutation_revision: self.mutation_revision,
                    reason: "key-up"
                )
            if keycode == 13:
                return self._chrome_action(
                    event_id, "address", "submit", ""
                )
            if keycode == 8:
                val current = self.address_text()
                val shortened = text_without_last_codepoint(current)
                self.address_replace_on_text = false
                return self._chrome_action(
                    event_id, "address", "set_value", shortened
                )
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "browser:session#address",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: "key-down"
            )
        val focused_id = be_dom_focused_id(self.browser.dom_root())
        self.last_target_id = focused_id
        if focused_id == "" and keycode != 9:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: "no-focused-semantic-target"
            )
        val key = if keycode == 13:
            "Enter"
        elif keycode == 32:
            " "
        elif keycode == 9:
            "Tab"
        else:
            keycode.to_text()
        val before = self.browser.current_body_html
        val callback_start = self.browser.dom_callback_count
        val dispatched = self.browser.dispatch_dom_keyboard_event_with_shift(
            focused_id, key, pressed, shift_key
        )
        if val Err(reason) = dispatched:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: focused_id,
                callback_count:
                    self.browser.dom_callback_count - callback_start,
                mutation_revision: self.mutation_revision,
                reason: reason
            )
        val callback_count = self.browser.dom_callback_count - callback_start
        self._cancel_orphaned_network_job()
        val active_id = be_dom_focused_id(self.browser.dom_root())
        self.last_target_id = active_id
        val changed = self.browser.current_body_html != before
        if changed:
            self.published_body_html = self.presentation_html()
            self.mutation_revision = self.mutation_revision + 1
        HostedWebContentDispatch(
            event_id: event_id,
            wm_target_id: self.window_id,
            semantic_target_id: active_id,
            callback_count: callback_count,
            mutation_revision: self.mutation_revision,
            reason: if changed:
                ""
            elif pressed:
                "key-down"
            else:
                "key-up"
        )

    fn current_body_html() -> text:
        self.presentation_html()

    fn render_to_pixels() -> [u32]:
        self.browser.render_to_pixels(self.width, self.height).pixel_data

class HostedWebContentRegistry:
    sessions: [HostedWebContentSession]
    bookmark_store: BrowserBookmarkStore?
    profile_bookmarks: BrowserBookmarkSnapshot
    profile_failure_reason: text

    static fn create() -> HostedWebContentRegistry:
        HostedWebContentRegistry(
            sessions: [],
            bookmark_store: nil,
            profile_bookmarks: BrowserBookmarkSnapshot.create([]),
            profile_failure_reason: ""
        )

    static fn create_with_default_bookmark_store() -> HostedWebContentRegistry:
        match BrowserBookmarkStore.open_default():
            Err(e):
                var registry = HostedWebContentRegistry.create()
                registry.profile_failure_reason = e.message()
                registry
            Ok(bookmark_store):
                HostedWebContentRegistry.create_with_bookmark_store(
                    bookmark_store
                )

    static fn create_with_bookmark_store(
        bookmark_store: BrowserBookmarkStore
    ) -> HostedWebContentRegistry:
        var registry = HostedWebContentRegistry.create()
        match bookmark_store.load_bookmarks():
            Err(e):
                var opened = bookmark_store
                match opened.close():
                    Err(close_error):
                        registry.bookmark_store = Some(opened)
                        registry.profile_failure_reason = (
                            e.message() + "; close: " + close_error.message()
                        )
                    Ok(_):
                        registry.profile_failure_reason = e.message()
                registry
            Ok(bookmarks):
                registry.bookmark_store = Some(bookmark_store)
                registry.profile_bookmarks = bookmarks
                registry

    me _session_index(window_id: i64) -> i32:
        var i = 0
        while i < self.sessions.len():
            if self.sessions[i].window_id == window_id:
                return i
            i = i + 1
        -1

    me _clear_pointer_state_except(retained_index: i32):
        var i = 0
        while i < self.sessions.len():
            if i != retained_index:
                var session = self.sessions[i]
                session.pressed_target_id = ""
                session.pressed_chrome_control = ""
                self.sessions[i] = session
            i = i + 1

    me cancel_pointer_state():
        self._clear_pointer_state_except(-1)

    me _ensure(
        window_id: i64, body_html: text, width: i32, height: i32,
        profile_enabled: bool
    ) -> i32:
        val use_profile = (
            profile_enabled and self.bookmark_store != nil and
            self.profile_failure_reason == ""
        )
        val existing = self._session_index(window_id)
        if existing >= 0:
            var session = self.sessions[existing]
            session.width = width
            session.height = height
            if use_profile and not session.profile_enabled:
                session.profile_enabled = true
                val _ = session.browser.load_bookmark_snapshot(
                    self.profile_bookmarks
                )
            self.sessions[existing] = session
            return existing
        var session = HostedWebContentSession.create(
            window_id, body_html, width, height
        )
        session.profile_enabled = use_profile
        if use_profile:
            val _ = session.browser.load_bookmark_snapshot(
                self.profile_bookmarks
            )
        self.sessions.push(session)
        self.sessions.len() - 1

    me advance_window(
        window_id: i64, body_html: text, width: i32, height: i32,
        now_ms: i64, profile_enabled: bool
    ) -> bool:
        val index = self._ensure(
            window_id, body_html, width, height, profile_enabled
        )
        var session = self.sessions[index]
        val changed = session.advance_at(now_ms)
        self.sessions[index] = session
        changed

    me dispatch_pointer(event_id: i64, window_id: i64, body_html: text, width: i32, height: i32, x: i32, y: i32, down: bool) -> HostedWebContentDispatch:
        val index = self._ensure(
            window_id, body_html, width, height, false
        )
        var session = self.sessions[index]
        val receipt = session.dispatch_pointer_at(event_id, x, y, down)
        self.sessions[index] = session
        receipt

    me dispatch_text(
        event_id: i64, window_id: i64, value: text
    ) -> HostedWebContentDispatch:
        val index = self._session_index(window_id)
        if index < 0:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: 0,
                reason: "no-hosted-web-session"
            )
        var session = self.sessions[index]
        val receipt = session.dispatch_text(event_id, value)
        self.sessions[index] = session
        receipt

    me dispatch_key(
        event_id: i64, window_id: i64, keycode: i64, pressed: bool
    ) -> HostedWebContentDispatch:
        self.dispatch_key_with_shift(
            event_id, window_id, keycode, pressed, false
        )

    me dispatch_key_with_shift(
        event_id: i64,
        window_id: i64,
        keycode: i64,
        pressed: bool,
        shift_key: bool
    ) -> HostedWebContentDispatch:
        val index = self._session_index(window_id)
        if index < 0:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: 0,
                reason: "no-hosted-web-session"
            )
        var session = self.sessions[index]
        val receipt = session.dispatch_key_with_shift(
            event_id, keycode, pressed, shift_key
        )
        self.sessions[index] = session
        receipt

    fn body_html(window_id: i64) -> text:
        var i = 0
        while i < self.sessions.len():
            if self.sessions[i].window_id == window_id:
                return self.sessions[i].current_body_html()
            i = i + 1
        ""

    fn address_text(window_id: i64) -> text:
        var i = 0
        while i < self.sessions.len():
            if self.sessions[i].window_id == window_id:
                return self.sessions[i].address_text()
            i = i + 1
        ""

    me dispatch_chrome_pointer(
        event_id: i64, window_id: i64, control: text, down: bool
    ) -> HostedWebContentDispatch:
        val index = self._session_index(window_id)
        if index < 0:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: 0,
                reason: "no-hosted-web-session"
            )
        self._clear_pointer_state_except(index)
        var session = self.sessions[index]
        var bookmarks_before = session.browser.bookmark_snapshot()
        val revision_before = session.mutation_revision
        if (not down and control == "favorite" and
            session.profile_enabled):
            if self.bookmark_store == nil:
                session.pressed_chrome_control = ""
                self.sessions[index] = session
                return HostedWebContentDispatch(
                    event_id: event_id,
                    wm_target_id: window_id,
                    semantic_target_id: "browser:session#favorite",
                    callback_count: 0,
                    mutation_revision: revision_before,
                    reason: "profile-unavailable"
                )
            var bookmark_store = self.bookmark_store.unwrap()
            match bookmark_store.load_bookmarks():
                Err(e):
                    session.pressed_chrome_control = ""
                    self.sessions[index] = session
                    self.bookmark_store = Some(bookmark_store)
                    self.profile_failure_reason = e.message()
                    return HostedWebContentDispatch(
                        event_id: event_id,
                        wm_target_id: window_id,
                        semantic_target_id: "browser:session#favorite",
                        callback_count: 0,
                        mutation_revision: revision_before,
                        reason: self.profile_failure_reason
                    )
                Ok(latest):
                    bookmarks_before = latest
                    val _ = session.browser.load_bookmark_snapshot(latest)
                    self.bookmark_store = Some(bookmark_store)
        val receipt = session.dispatch_chrome_pointer(
            event_id, control, down
        )
        self.sessions[index] = session
        if not down and control == "favorite" and receipt.callback_count > 0:
            var bookmark_store = self.bookmark_store.unwrap()
            val url = session.browser.document_url
            match bookmark_store.toggle_bookmark(url, url):
                Err(e):
                    val _ = session.browser.load_bookmark_snapshot(
                        bookmarks_before
                    )
                    session.mutation_revision = revision_before
                    self.sessions[index] = session
                    self.bookmark_store = Some(bookmark_store)
                    self.profile_failure_reason = e.message()
                    return HostedWebContentDispatch(
                        event_id: receipt.event_id,
                        wm_target_id: receipt.wm_target_id,
                        semantic_target_id: receipt.semantic_target_id,
                        callback_count: 0,
                        mutation_revision: revision_before,
                        reason: self.profile_failure_reason
                    )
                Ok(enabled):
                    val _ = session.browser.load_bookmark_snapshot(
                        bookmarks_before
                    )
                    if enabled:
                        session.browser.add_favorite(url, url)
                    else:
                        session.browser.remove_favorite(url)
                    self.sessions[index] = session
                    self.profile_bookmarks = (
                        session.browser.bookmark_snapshot()
                    )
                    self.profile_failure_reason = ""
                    self.bookmark_store = Some(bookmark_store)
        receipt

    me close_window(window_id: i64) -> bool:
        val index = self._session_index(window_id)
        if index < 0:
            return true
        var closed = self.sessions[index]
        closed.cancel_network()
        var retained: [HostedWebContentSession] = []
        var i = 0
        while i < self.sessions.len():
            if i != index:
                retained.push(self.sessions[i])
            i = i + 1
        self.sessions = retained
        true

    me close() -> bool:
        var i = 0
        while i < self.sessions.len():
            var session = self.sessions[i]
            session.cancel_network()
            self.sessions[i] = session
            i = i + 1
        if self.bookmark_store != nil:
            var bookmark_store = self.bookmark_store.unwrap()
            match bookmark_store.close():
                Err(e):
                    self.bookmark_store = Some(bookmark_store)
                    self.profile_failure_reason = e.message()
                    return false
                Ok(_):
                    self.bookmark_store = nil
        self.sessions = []
        true
