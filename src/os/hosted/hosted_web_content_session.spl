# Hosted-only semantic Web adapter. BrowserSession stays out of compositor core.

use std.gc_async_mut.web.browser_session.{
    BrowserSession, BrowserBookmarkSnapshot, BrowserHstsSnapshot
}
use std.gc_async_mut.web.browser_session_loading.*
use std.gc_async_mut.web.browser_session_runtime.*
use std.gc_async_mut.gpu.browser_engine.layout.{hit_test, layout_tree}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{
    be_dom_event_identity, be_dom_focused_id
}
use std.database.sql.types.{DbError}
use os.hosted.browser_profile_store.{BrowserProfileStore}

struct HostedWebContentDispatch:
    event_id: i64
    wm_target_id: i64
    semantic_target_id: text
    callback_count: i64
    mutation_revision: i64
    reason: text

class HostedWebContentSession:
    window_id: i64
    width: i32
    height: i32
    browser: BrowserSession
    mutation_revision: i64
    failure_reason: text
    last_target_id: text
    pressed_target_id: text
    published_body_html: text
    started_at_ms: i64
    profile_enabled: bool

    static fn create(window_id: i64, body_html: text, width: i32, height: i32) -> HostedWebContentSession:
        var browser = BrowserSession.new()
        val opened = browser.open_html(
            "simple-wm://window/{window_id}",
            "<html><body>{body_html}</body></html>"
        )
        var failure_reason = ""
        if val Err(reason) = opened:
            failure_reason = reason
        HostedWebContentSession(
            window_id: window_id,
            width: width,
            height: height,
            browser: browser,
            mutation_revision: 0,
            failure_reason: failure_reason,
            last_target_id: "",
            pressed_target_id: "",
            published_body_html: body_html,
            started_at_ms: -1,
            profile_enabled: false
        )

    me advance_at(now_ms: i64) -> bool:
        if self.failure_reason != "" or now_ms < 0:
            return false
        if self.started_at_ms < 0:
            self.started_at_ms = now_ms
        val _ = self.browser.advance_time(now_ms - self.started_at_ms)
        val body_html = self.browser.current_body_html
        if body_html == self.published_body_html:
            return false
        self.published_body_html = body_html
        self.mutation_revision = self.mutation_revision + 1
        true

    me dispatch_pointer_at(event_id: i64, x: i32, y: i32, down: bool) -> HostedWebContentDispatch:
        if self.failure_reason != "":
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: self.failure_reason
            )
        val root = self.browser.dom_root()
        val layout = layout_tree(root, self.width.to_f64(), self.height.to_f64())
        val target = hit_test(layout, root, x.to_f64(), y.to_f64())
        if target == nil:
            self.pressed_target_id = ""
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: "no-semantic-target"
            )
        val target_id = be_dom_event_identity(target.unwrap())
        val before = self.browser.current_body_html
        if down:
            self.pressed_target_id = target_id
            val _ = self.browser.dispatch_dom_event(
                target_id, "pointerdown", true, true
            )
            val _ = self.browser.dispatch_dom_event(
                target_id, "mousedown", true, true
            )
            val changed = self.browser.current_body_html != before
            if changed:
                self.published_body_html = self.browser.current_body_html
                self.mutation_revision = self.mutation_revision + 1
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: target_id,
                callback_count: if changed: 1 else: 0,
                mutation_revision: self.mutation_revision,
                reason: if changed: "" else: "pointer-pressed"
            )
        val pressed_target_id = self.pressed_target_id
        self.pressed_target_id = ""
        val _ = self.browser.dispatch_dom_event(
            target_id, "pointerup", true, true
        )
        val _ = self.browser.dispatch_dom_event(
            target_id, "mouseup", true, true
        )
        if pressed_target_id == target_id and pressed_target_id != "":
            val _ = self.browser.dispatch_dom_event(
                target_id, "click", true, true
            )
        self.last_target_id = be_dom_focused_id(self.browser.dom_root())
        val changed = self.browser.current_body_html != before
        if changed:
            self.published_body_html = self.browser.current_body_html
            self.mutation_revision = self.mutation_revision + 1
        HostedWebContentDispatch(
            event_id: event_id,
            wm_target_id: self.window_id,
            semantic_target_id: target_id,
            callback_count: if changed: 1 else: 0,
            mutation_revision: self.mutation_revision,
            reason: if changed:
                ""
            elif pressed_target_id == "":
                "pointer-release-without-press"
            elif pressed_target_id != target_id:
                "pointer-release-target-mismatch"
            else:
                "no-application-mutation"
        )

    me dispatch_text(event_id: i64, value: text) -> HostedWebContentDispatch:
        if self.last_target_id == "":
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: "no-focused-semantic-target"
            )
        val before = self.browser.current_body_html
        val updated = self.browser.append_dom_text_input(
            self.last_target_id, value
        )
        if val Err(reason) = updated:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: self.last_target_id,
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: reason
            )
        val changed = self.browser.current_body_html != before
        if changed:
            self.published_body_html = self.browser.current_body_html
            self.mutation_revision = self.mutation_revision + 1
        HostedWebContentDispatch(
            event_id: event_id,
            wm_target_id: self.window_id,
            semantic_target_id: self.last_target_id,
            callback_count: if changed: 1 else: 0,
            mutation_revision: self.mutation_revision,
            reason: if changed: "" else: "no-application-mutation"
        )

    me dispatch_key(
        event_id: i64, keycode: i64, pressed: bool
    ) -> HostedWebContentDispatch:
        val focused_id = be_dom_focused_id(self.browser.dom_root())
        self.last_target_id = focused_id
        if focused_id == "":
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: "no-focused-semantic-target"
            )
        val key = if keycode == 13:
            "Enter"
        elif keycode == 32:
            " "
        else:
            keycode.to_text()
        val before = self.browser.current_body_html
        val dispatched = self.browser.dispatch_dom_keyboard_event(
            focused_id, key, pressed
        )
        if val Err(reason) = dispatched:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: self.window_id,
                semantic_target_id: focused_id,
                callback_count: 0,
                mutation_revision: self.mutation_revision,
                reason: reason
            )
        val changed = self.browser.current_body_html != before
        if changed:
            self.published_body_html = self.browser.current_body_html
            self.mutation_revision = self.mutation_revision + 1
        HostedWebContentDispatch(
            event_id: event_id,
            wm_target_id: self.window_id,
            semantic_target_id: focused_id,
            callback_count: if changed: 1 else: 0,
            mutation_revision: self.mutation_revision,
            reason: if changed:
                ""
            elif pressed:
                "key-down"
            else:
                "key-up"
        )

    fn current_body_html() -> text:
        self.browser.current_body_html

    fn render_to_pixels() -> [u32]:
        self.browser.render_to_pixels(self.width, self.height).pixel_data

class HostedWebContentRegistry:
    sessions: [HostedWebContentSession]
    profile: BrowserProfileStore?
    profile_bookmarks: BrowserBookmarkSnapshot
    profile_hsts: BrowserHstsSnapshot
    profile_loaded_at_ms: i64
    profile_failure_reason: text

    static fn create() -> HostedWebContentRegistry:
        HostedWebContentRegistry(
            sessions: [],
            profile: nil,
            profile_bookmarks: BrowserBookmarkSnapshot.create([]),
            profile_hsts: BrowserHstsSnapshot.create([]),
            profile_loaded_at_ms: 0,
            profile_failure_reason: ""
        )

    static fn create_with_default_profile(
        wall_clock_ms: i64
    ) -> HostedWebContentRegistry:
        match BrowserProfileStore.open_default():
            Err(e):
                var registry = HostedWebContentRegistry.create()
                registry.profile_failure_reason = e.message()
                registry
            Ok(profile):
                HostedWebContentRegistry.create_with_profile(
                    profile, wall_clock_ms
                )

    static fn create_with_profile(
        profile: BrowserProfileStore, wall_clock_ms: i64
    ) -> HostedWebContentRegistry:
        var registry = HostedWebContentRegistry.create()
        match profile.load_bookmarks():
            Err(e):
                var opened = profile
                val _ = opened.close()
                registry.profile_failure_reason = e.message()
                registry
            Ok(bookmarks):
                match profile.load_hsts(wall_clock_ms):
                    Err(e):
                        var opened = profile
                        val _ = opened.close()
                        registry.profile_failure_reason = e.message()
                        registry
                    Ok(hsts):
                        registry.profile = Some(profile)
                        registry.profile_bookmarks = bookmarks
                        registry.profile_hsts = hsts
                        registry.profile_loaded_at_ms = wall_clock_ms
                        registry

    me _session_index(window_id: i64) -> i32:
        var i = 0
        while i < self.sessions.len():
            if self.sessions[i].window_id == window_id:
                return i
            i = i + 1
        -1

    me _ensure(
        window_id: i64, body_html: text, width: i32, height: i32,
        profile_enabled: bool, wall_clock_ms: i64
    ) -> i32:
        val existing = self._session_index(window_id)
        if existing >= 0:
            var session = self.sessions[existing]
            session.width = width
            session.height = height
            if profile_enabled and not session.profile_enabled:
                session.profile_enabled = true
                val _ = session.browser.load_bookmark_snapshot(
                    self.profile_bookmarks
                )
                val _ = session.browser.load_hsts_snapshot(
                    self.profile_hsts, wall_clock_ms
                )
            self.sessions[existing] = session
            return existing
        var session = HostedWebContentSession.create(
            window_id, body_html, width, height
        )
        session.profile_enabled = profile_enabled
        if profile_enabled:
            val _ = session.browser.load_bookmark_snapshot(
                self.profile_bookmarks
            )
            val _ = session.browser.load_hsts_snapshot(
                self.profile_hsts, wall_clock_ms
            )
        self.sessions.push(session)
        self.sessions.len() - 1

    me advance_window(
        window_id: i64, body_html: text, width: i32, height: i32,
        now_ms: i64, profile_enabled: bool
    ) -> bool:
        val index = self._ensure(
            window_id, body_html, width, height, profile_enabled, now_ms
        )
        var session = self.sessions[index]
        val changed = session.advance_at(now_ms)
        self.sessions[index] = session
        changed

    me dispatch_pointer(event_id: i64, window_id: i64, body_html: text, width: i32, height: i32, x: i32, y: i32, down: bool) -> HostedWebContentDispatch:
        val index = self._ensure(
            window_id, body_html, width, height, false,
            self.profile_loaded_at_ms
        )
        var session = self.sessions[index]
        val receipt = session.dispatch_pointer_at(event_id, x, y, down)
        self.sessions[index] = session
        receipt

    me dispatch_text(
        event_id: i64, window_id: i64, value: text
    ) -> HostedWebContentDispatch:
        val index = self._session_index(window_id)
        if index < 0:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: 0,
                reason: "no-hosted-web-session"
            )
        var session = self.sessions[index]
        val receipt = session.dispatch_text(event_id, value)
        self.sessions[index] = session
        receipt

    me dispatch_key(
        event_id: i64, window_id: i64, keycode: i64, pressed: bool
    ) -> HostedWebContentDispatch:
        val index = self._session_index(window_id)
        if index < 0:
            return HostedWebContentDispatch(
                event_id: event_id,
                wm_target_id: window_id,
                semantic_target_id: "",
                callback_count: 0,
                mutation_revision: 0,
                reason: "no-hosted-web-session"
            )
        var session = self.sessions[index]
        val receipt = session.dispatch_key(event_id, keycode, pressed)
        self.sessions[index] = session
        receipt

    fn body_html(window_id: i64) -> text:
        var i = 0
        while i < self.sessions.len():
            if self.sessions[i].window_id == window_id:
                return self.sessions[i].current_body_html()
            i = i + 1
        ""

    me _persist_session(index: i32, wall_clock_ms: i64) -> bool:
        if index < 0 or index >= self.sessions.len():
            return true
        val session = self.sessions[index]
        if not session.profile_enabled or self.profile == nil:
            return true
        var profile = self.profile.unwrap()
        match profile.save_bookmarks(session.browser.bookmark_snapshot()):
            Err(e):
                self.profile = Some(profile)
                self.profile_failure_reason = e.message()
                return false
            Ok(_):
                match profile.save_hsts(
                    session.browser.hsts_snapshot(wall_clock_ms), wall_clock_ms
                ):
                    Err(e):
                        self.profile = Some(profile)
                        self.profile_failure_reason = e.message()
                        return false
                    Ok(_):
                        self.profile = Some(profile)
                        self.profile_bookmarks = session.browser.bookmark_snapshot()
                        self.profile_hsts = session.browser.hsts_snapshot(
                            wall_clock_ms
                        )
                        self.profile_failure_reason = ""
                        true

    me close_window(window_id: i64, wall_clock_ms: i64) -> bool:
        val index = self._session_index(window_id)
        if index < 0:
            return true
        if not self._persist_session(index, wall_clock_ms):
            return false
        var retained: [HostedWebContentSession] = []
        var i = 0
        while i < self.sessions.len():
            if i != index:
                retained.push(self.sessions[i])
            i = i + 1
        self.sessions = retained
        true

    me close(wall_clock_ms: i64) -> bool:
        var i = 0
        while i < self.sessions.len():
            if self.sessions[i].profile_enabled:
                if not self._persist_session(i, wall_clock_ms):
                    return false
                break
            i = i + 1
        if self.profile != nil:
            var profile = self.profile.unwrap()
            match profile.close():
                Err(e):
                    self.profile = Some(profile)
                    self.profile_failure_reason = e.message()
                    return false
                Ok(_):
                    self.profile = nil
        true
