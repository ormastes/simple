use common.ui.draw_ir.DrawIrComposition
use std.common.gpu.simpleos_host_gpu_draw_ir.SimpleOsHostGpuImageResource
use os.compositor.compositor_engine2d.{
    Engine2dCompositorBackend, Engine2dFrameSwitchReceipt
}

struct HostedBrowserFrameSwitchDecision:
    reused: bool
    publication_status: text
    receipt: Engine2dFrameSwitchReceipt

fn hosted_browser_frame_switch_decide(
    raster: Engine2dCompositorBackend,
    composition: DrawIrComposition,
    resources: [SimpleOsHostGpuImageResource],
    producer_generation: i64,
    composition_revision: i64,
    pending_frame: bool
) -> HostedBrowserFrameSwitchDecision:
    val receipt = raster.try_reuse_draw_ir_composition_revision(
        composition, resources, producer_generation, composition_revision)
    if receipt.reused:
        return HostedBrowserFrameSwitchDecision(
            reused: true,
            publication_status: if pending_frame: "frame" else: "none",
            receipt: receipt)
    HostedBrowserFrameSwitchDecision(
        reused: false, publication_status: "raster", receipt: receipt)

export HostedBrowserFrameSwitchDecision, hosted_browser_frame_switch_decide
