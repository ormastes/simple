# Production evidence protocol keys are intentionally visible at the live
# entry boundary. The hook is disabled unless all three are configured.
# SIMPLE_WM_EVIDENCE_SNAPSHOT_PATH
# SIMPLE_WM_EVIDENCE_CAPTURE_PATH
# SIMPLE_WM_EVIDENCE_INPUT_FIFO

val WINDOW_WIDTH: i32 = 1024
val WINDOW_HEIGHT: i32 = 720
val WINDOW_TITLE: text = "SimpleOS Shared Hosted WM"

fn _hosted_engine2d_raster_for_window(win: i64, width: i32, height: i32) -> Engine2dCompositorBackend:
    val requested = (rt_env_get("SIMPLE_GUI_BACKEND") ?? "").trim().lower()
    if requested == "vulkan-window":
        val kind = rt_winit_window_surface_kind(win)
        val display = rt_winit_window_surface_display(win)
        val window = rt_winit_window_surface_window(win)
        match Engine2dCompositorBackend.create_vulkan_external_window_present(
            kind, display, window, width, height, true):
            Ok(raster):
                print "[hosted-wm] raster-backend=vulkan-window-swapchain adopted=true kind={kind} readback=false"
                return raster
            Err(reason):
                print "[hosted-wm] vulkan-window-adoption-failed reason={reason} fallback=software"
    Engine2dCompositorBackend.create_from_env(width, height)

val EVT_CLOSE: i64 = 3
val EVT_RESIZE: i64 = 1
val EVT_MOVE: i64 = 2
val EVT_SCALE_FACTOR: i64 = 7
val EVT_FOCUS: i64 = 5
val EVT_UNFOCUS: i64 = 6
val EVT_KEY: i64 = 10
val EVT_TEXT: i64 = 11
val EVT_MOUSE_BUTTON: i64 = 20
val EVT_MOUSE_MOVE: i64 = 21
val EVT_MOUSE_WHEEL: i64 = 22

val KEY_ESCAPE: i64 = 27
val KEY_BACKSPACE: i64 = 8
val KEY_ENTER: i64 = 13
val KEY_TAB: i64 = 9
val KEY_M: i64 = 77
val KEY_R: i64 = 82
val KEY_W: i64 = 87
val KEY_F11: i64 = 122
val HOSTED_CREATE_WEB_WINDOW: i64 = 14

fn _live_proof_mode() -> bool:
    (rt_env_get("SIMPLE_HOSTED_WM_LIVE_PROOF") ?? "") == "1"

fn _seed_live_proof_surface(comp: HostCompositor) -> HostCompositor:
    var out = comp
    out.apply_bridge_request(
        100,
        100,
        HOSTED_CREATE_WEB_WINDOW,
        0,
        "Files",
        340,
        200,
        240,
        160,
        "src/ test/",
        100,
        "files"
    )
    out.apply_bridge_request(
        101,
        101,
        HOSTED_CREATE_WEB_WINDOW,
        0,
        "Terminal",
        58,
        76,
        180,
        96,
        "<style>input{display:block;width:140px;height:28px;background-color:#ef4444}input[value='z']{background-color:#2563eb}</style><input id='host-proof' value='ready' oninput=\"document.title='Typed'\">",
        101,
        "terminal"
    )
    out

fn _physical_surface_geometry(win: i64) -> HostSurfaceGeometry:
    host_surface_geometry(
        rt_winit_window_position_x(win) as i32,
        rt_winit_window_position_y(win) as i32,
        rt_winit_window_inner_width(win) as i32,
        rt_winit_window_inner_height(win) as i32,
        rt_winit_window_scale_factor_milli(win) as i32
    )

fn _restore_windowed_position(surface: HostSurfaceState, win: i64) -> bool:
    rt_winit_window_set_position(win, surface.saved_windowed_geometry.x as i64, surface.saved_windowed_geometry.y as i64) > 0

fn _request_host_fullscreen(surface: HostSurfaceState, win: i64, nonce: i64, now_micros: i64) -> HostSurfaceState:
    val target = if rt_winit_window_is_fullscreen(win) > 0: HostDisplayMode.Windowed else: HostDisplayMode.BorderlessFullscreen
    val requested = request_display_mode(surface, target, nonce, now_micros)
    if not requested.accepted or not requested.mode_request_required:
        return requested.state
    val fullscreen_enabled = target == HostDisplayMode.BorderlessFullscreen
    if rt_winit_window_set_fullscreen(win, if fullscreen_enabled: 1 else: 0) <= 0:
        return fail_or_timeout_display_transition(requested.state, nonce, "native borderless fullscreen request failed", now_micros).state
    requested.state

# winit keycode -> widget-session key name (same shape as
# host_gui_event_router.host_glfw_key_name, but for the winit lane's
# ASCII-style codes: 13=enter, 9=tab, 8=backspace, 27=escape).
fn _host_winit_gui_key_name(keycode: i64) -> text:
    if keycode >= 65 and keycode <= 90:
        return ((keycode + 32).to_u8()).to_char()
    if keycode >= 32 and keycode <= 126:
        return keycode.to_u8().to_char()
    match keycode:
        13: "enter"
        9: "tab"
        8: "backspace"
        27: "escape"
        _: ""

fn _seed_host_compositor_shared_mdi(comp: HostCompositor) -> HostCompositor:
    var out = comp
    var shared_index = 0
    while shared_index < shared_mdi_surface_count():
        val process_id = shared_mdi_surface_process_id(shared_index)
        out.apply_bridge_request(
            process_id,
            process_id,
            14,
            0,
            shared_mdi_surface_title(shared_index),
            shared_mdi_surface_x(shared_index),
            shared_mdi_surface_y(shared_index),
            shared_mdi_surface_width(shared_index),
            shared_mdi_surface_height(shared_index),
            shared_mdi_surface_content(shared_index),
            process_id,
            shared_mdi_surface_app_id(shared_index)
        )
        shared_index = shared_index + 1
    out

fn main() -> i64:
    print "MAIN-FIRST-LINE"
    val args = sys_get_args() ?? []
    if ((args.len() == 5 or args.len() == 6) and
        args[1] == BROWSER_RENDERER_WORKER_ARG):
        return hosted_browser_renderer_worker_main(args)
    if args.len() == 2 and args[1] == "--browser-render-evidence":
        val html_css_error = hosted_browser_html_css_evidence(args[0])
        if html_css_error != "":
            print "browser-render-evidence=fail phase=html-css reason={html_css_error}"
            return 1
        val animation_error = hosted_browser_animation_evidence(args[0])
        if animation_error != "":
            print "browser-render-evidence=fail phase=animation reason={animation_error}"
            return 1
        print "browser-render-evidence=pass html-css=pass animation=pass"
        return 0
    print "SimpleOS shared hosted WM ({WINDOW_WIDTH}x{WINDOW_HEIGHT})"
    print "Renderer: HostCompositor lifecycle + Simple Web app content + winit buffer backend"
    print "Controls: drag titlebars, click focus, close X, Tab cycle, W close, M minimize, R restore, Esc quit"

    var theme_snapshot = install_default_host_wm_theme()
    val theme_file = rt_env_get("SIMPLE_WM_THEME_FILE") ?? ""
    if theme_file != "":
        val theme_override_installed = apply_host_wm_css_theme_override(
            file_read(theme_file)
        )
        if theme_override_installed:
            theme_snapshot = active_host_wm_theme_snapshot()
        print "[theme-evidence] css_override_path={theme_file} installed={theme_override_installed}"
    val theme_wire_text = match theme_package_install_wire_v1_encode(
        theme_snapshot.id,
        theme_snapshot.id,
        "active-wm-theme",
        theme_snapshot
    ):
        Err(reason):
            print "ERROR: hosted theme projection rejected: {reason}"
            return 1
        Ok(value):
            value
    print "[theme-evidence] id={theme_snapshot.id} source_manifest_sha256={theme_snapshot.source_manifest_sha256} material_sha256={theme_snapshot.material_sha256} backdrop_filter=requested fallback=solid-material"

    val el = rt_winit_event_loop_new()
    val win = rt_winit_window_new(el, WINDOW_WIDTH.to_i64(), WINDOW_HEIGHT.to_i64(), WINDOW_TITLE)
    if win == 0:
        print "ERROR: winit window creation failed"
        return 1
    print "[hosted-wm] window-created backend=winit mode=windowed fullscreen=false width={WINDOW_WIDTH} height={WINDOW_HEIGHT} title={WINDOW_TITLE}"

    val backend = HostedWinitBufferBackend.create(
        win, WINDOW_WIDTH, WINDOW_HEIGHT, theme_snapshot.material.desktop_fill_rgba
    )
    if backend == nil:
        print "ERROR: hosted Simple 2D winit backend creation failed"
        rt_winit_window_free(win)
        rt_winit_event_loop_free(el)
        return 1
    print "[hosted-wm] raster-backend=simple-2d-winit-buffer source=pure-simple-pixel-mirror"
    val comp = HostCompositor.new_headless(Size(width: WINDOW_WIDTH as u64, height: WINDOW_HEIGHT as u64))
    val raster = _hosted_engine2d_raster_for_window(
        win, WINDOW_WIDTH, WINDOW_HEIGHT)
    _run_hosted_wm(
        comp, raster, backend, el, win, args[0], theme_wire_text
    )

fn _save_hosted_browser_hsts(
    renderer_in: HostedBrowserRendererProcess,
    profile_in: BrowserProfileStore?,
    wall_clock_ms: i64
) -> HostedBrowserRendererProcess?:
    var renderer = renderer_in
    if not renderer.hsts_dirty:
        return Some(renderer)
    if profile_in == nil:
        return nil
    var profile = profile_in.unwrap()
    match profile.save_hsts(
        renderer.hsts_snapshot(wall_clock_ms), wall_clock_ms
    ):
        Ok(_):
            renderer.hsts_dirty = false
            Some(renderer)
        Err(error):
            print "ERROR: hosted browser HSTS save failed reason={error.message()}"
            nil

struct HostedBrowserResourceClose:
    renderer: HostedBrowserRendererProcess
    raster: Engine2dCompositorBackend
    ok: bool

fn _browser_renderer_close_retry_due(
    close_ok: bool, now_micros: i64
) -> i64:
    if close_ok: 0 else: now_micros + 1000000

fn _close_hosted_browser_renderer_resources(
    renderer_in: HostedBrowserRendererProcess,
    browser_raster_in: Engine2dCompositorBackend,
    browser_raster_active: bool
) -> HostedBrowserResourceClose:
    var renderer = renderer_in
    var browser_raster = browser_raster_in
    var close_ok = true
    if not renderer.close():
        close_ok = false
        print "ERROR: hosted browser renderer close failed"
    if browser_raster_active:
        browser_raster.shutdown()
    HostedBrowserResourceClose(
        renderer: renderer,
        raster: browser_raster,
        ok: close_ok
    )

fn _close_hosted_browser_resources(
    renderer_in: HostedBrowserRendererProcess,
    browser_raster_in: Engine2dCompositorBackend,
    browser_raster_active: bool,
    profile_in: BrowserProfileStore?
) -> HostedBrowserResourceClose:
    var renderer = renderer_in
    var close_ok = true
    val saved_renderer = _save_hosted_browser_hsts(
        renderer, profile_in, rt_time_now_unix_micros() / 1000
    )
    if saved_renderer == nil:
        close_ok = false
    else:
        renderer = saved_renderer.unwrap()
    val renderer_close = _close_hosted_browser_renderer_resources(
        renderer, browser_raster_in, browser_raster_active
    )
    if profile_in != nil:
        var profile = profile_in.unwrap()
        match profile.close():
            Ok(_):
                pass
            Err(error):
                close_ok = false
                print "ERROR: hosted browser profile close failed reason={error.message()}"
    HostedBrowserResourceClose(
        renderer: renderer_close.renderer,
        raster: renderer_close.raster,
        ok: close_ok and renderer_close.ok
    )

# Dependency-light production event loop. Pure Simple owns scene, Web/GUI/2D
# raster, and the pixel mirror; winit only presents that final buffer.
fn _run_hosted_wm(comp_in: HostCompositor, raster_in: Engine2dCompositorBackend, presenter: HostedWinitBufferBackend, el: i64, win: i64, executable: text, theme_wire_text: text) -> i64:
    var comp = comp_in
    var raster = raster_in
    var surface = host_surface_state(_physical_surface_geometry(win))
    var display_nonce: i64 = 0
    val evidence = host_wm_evidence_config_from_env()
    if evidence.enabled and not evidence.valid:
        print "ERROR: hosted WM evidence configuration rejected: {evidence.failure_reason}"
        raster.shutdown()
        rt_winit_window_free(win)
        rt_winit_event_loop_free(el)
        return 2
    val live_proof = _live_proof_mode()
    if live_proof:
        comp = _seed_live_proof_surface(comp)
        print "[hosted-wm] live-proof-mode enabled=true"
    else:
        comp = _seed_host_compositor_shared_mdi(comp)
    var browser_profile_window_id: i64 = 0
    if not live_proof:
        for window in comp.windows:
            if window.app_id == "browser":
                browser_profile_window_id = window.id
    var browser_content_width: i32 = 1
    var browser_content_height: i32 = 1
    var browser_initial_html = ""
    var browser_initial_title = ""
    val browser_theme_id = hosted_theme_id(1, theme_wire_text)
    val browser_theme_source_manifest_sha256 = (
        hosted_theme_source_manifest_sha256(1, theme_wire_text)
    )
    val browser_theme_material_sha256 = (
        hosted_theme_material_sha256(1, theme_wire_text)
    )
    if browser_profile_window_id > 0:
        for window in comp.windows:
            if window.id == browser_profile_window_id:
                browser_content_width = window.w - 8
                browser_content_height = (
                    window.h - 36 - WM_BROWSER_TOOLBAR_HEIGHT
                )
                browser_initial_html = window.content
                browser_initial_title = window.title
    var browser_renderer = HostedBrowserRendererProcess.create_with_theme(
        1,
        browser_content_width,
        browser_content_height,
        1,
        theme_wire_text
    )
    var browser_raster = Engine2dCompositorBackend.create_from_env(
        browser_content_width, browser_content_height
    )
    var browser_raster_active = true
    var browser_renderer_ready = false
    var browser_animation_origin_micros = rt_time_now_micros()
    var browser_address_draft = "about:blank"
    var browser_address_editing = false
    var browser_address_replace_on_text = false
    var browser_pressed_control = ""
    var browser_profile: BrowserProfileStore? = nil
    var browser_home_url = BROWSER_PROFILE_DEFAULT_HOME_URL
    var browser_bookmarks = BrowserBookmarkSnapshot.create([])
    var browser_hsts = BrowserHstsSnapshot.create([])
    var browser_primary_hsts_revision: i64 = 0
    var browser_bookmark_revision: i64 = 0
    var browser_bookmark_applied_revision: i64 = 0
    var browser_resource_close_failed = false
    var browser_renderer_close_pending = false
    var browser_renderer_close_retry_at_micros: i64 = 0
    var browser_hsts_save_retry_at_micros: i64 = 0
    match BrowserProfileStore.open_default():
        Ok(profile):
            match profile.load_hsts(
                rt_time_now_unix_micros() / 1000
            ):
                Ok(hsts):
                    match profile.load_bookmarks():
                        Err(error):
                            var failed_profile = profile
                            val _ = failed_profile.close()
                            print "[hosted-wm] browser-profile-disabled reason={error.message()}"
                        Ok(bookmarks):
                            match profile.load_home_url():
                                Err(error):
                                    var failed_profile = profile
                                    val _ = failed_profile.close()
                                    print "[hosted-wm] browser-profile-disabled reason={error.message()}"
                                Ok(home_url):
                                    val _ = browser_renderer.load_hsts_snapshot(
                                        hsts,
                                        rt_time_now_unix_micros() / 1000
                                    )
                                    browser_home_url = home_url
                                    browser_hsts = hsts
                                    browser_bookmarks = bookmarks
                                    browser_bookmark_revision = 1
                                    browser_profile = Some(profile)
                Err(error):
                    var failed_profile = profile
                    val _ = failed_profile.close()
                    print "[hosted-wm] browser-profile-disabled reason={error.message()}"
        Err(error):
            print "[hosted-wm] browser-profile-disabled reason={error.message()}"
    if browser_profile_window_id > 0:
        val browser_frame_registered = comp.require_external_web_frame(
            browser_profile_window_id
        )
        val _ = browser_renderer.set_home_url(browser_home_url)
        if browser_frame_registered:
            val themed_initial_html = (
                simple_web_content_full_html_with_install_wire(
                    theme_wire_text,
                    1,
                    browser_initial_title,
                    browser_initial_html,
                    browser_content_width,
                    browser_content_height
                )
            )
            val started = browser_renderer.start_with_theme(
                executable, 2000
            )
            if started.ok:
                val initial = browser_renderer.render(
                    "init", themed_initial_html, 2000
                )
                if initial.ok:
                    val rendered = browser_raster.render_draw_ir_composition_resources_revision(
                        initial.composition, initial.image_resources,
                        initial.producer_generation,
                        initial.composition_revision
                    )
                    val revision = (
                        simple_web_content_revision_with_theme_receipt(
                        browser_theme_source_manifest_sha256,
                        browser_theme_material_sha256,
                        browser_initial_title,
                        browser_initial_html,
                        browser_content_width, browser_content_height, 0
                        )
                    )
                    val frame = (
                        simple_web_external_content_frame_with_theme_receipt(
                        browser_profile_window_id.to_text(),
                        revision,
                        1,
                        browser_renderer.theme_revision,
                        theme_wire_text,
                        browser_theme_id,
                        browser_theme_source_manifest_sha256,
                        browser_theme_material_sha256,
                        browser_content_width,
                        browser_content_height,
                        rendered,
                        initial.cpu_composited_count,
                        initial.cpu_composited_sha256,
                        initial.solid_material_count,
                        initial.solid_material_sha256
                        )
                    )
                    browser_renderer_ready = comp.set_external_web_frame(
                        browser_profile_window_id, frame
                    )
                    if browser_renderer_ready:
                        val bookmark_restore = browser_renderer.begin_bookmark_snapshot(
                            browser_bookmarks, 2000
                        )
                        if val Err(reason) = bookmark_restore:
                            print "[hosted-wm] browser-bookmark-restore-failed reason={reason}"
                        else:
                            browser_bookmark_applied_revision = (
                                browser_bookmark_revision
                            )
                        browser_animation_origin_micros = (
                            rt_time_now_micros()
                        )
                        comp = host_compositor_update_window_title(
                            comp, browser_profile_window_id,
                            browser_address_draft
                        )
                else:
                    print "[hosted-wm] browser-renderer-init-failed reason={initial.reason}"
            else:
                print "[hosted-wm] browser-renderer-start-failed reason={started.reason}"
        else:
            print "[hosted-wm] browser-renderer-start-failed reason=external-frame-capacity"
    if browser_profile_window_id <= 0 or not browser_renderer_ready:
        if not browser_renderer.close():
            browser_renderer_close_pending = true
            browser_renderer_close_retry_at_micros = (
                rt_time_now_micros() + 1000000
            )
        browser_raster.shutdown()
        browser_raster_active = false
    print "[hosted-wm] windows-ready count={comp.windows.len()}"
    if not comp.render_frame_engine2d(raster):
        if live_proof or evidence.enabled:
            print "[hosted-wm] draw-ir-rejected evidence=fail-closed"
            val _ = _close_hosted_browser_resources(
                browser_renderer, browser_raster,
                browser_raster_active, browser_profile
            )
            raster.shutdown()
            rt_winit_window_free(win)
            rt_winit_event_loop_free(el)
            return 4
        print "[hosted-wm] draw-ir-rejected retry=compatibility"
        comp.render_frame()
    if (not raster.window_present_enabled() and
        not hosted_winit_present_pure_simple_pixels(presenter, comp.pure_simple_pixel_buffer(), comp.width, comp.height)):
        print "ERROR: hosted WM initial pure-Simple frame presentation failed"
        val _ = _close_hosted_browser_resources(
            browser_renderer, browser_raster,
            browser_raster_active, browser_profile
        )
        raster.shutdown()
        rt_winit_window_free(win)
        rt_winit_event_loop_free(el)
        return 3
    print "[hosted-wm] frame-presented renderer=engine2d-draw-ir content=simple-web route=shared-wm-scene-draw-ir host=linux-windowed width={WINDOW_WIDTH} height={WINDOW_HEIGHT} raster=simple-2d-winit-buffer fallback=false revision={comp.render_revision} {raster.frame_provenance()} {raster.font_provenance()}"
    print "Frame presented: shared lifecycle windows + Simple Web MDI content"

    var evidence_nonce: i64 = 0
    var evidence_phase = "presented"
    var input_receipt = host_wm_input_receipt()
    var presented_event_id: i64 = 0
    var presented_mutation_revision: i64 = 0
    if evidence.enabled:
        val initial_pixels = comp.pure_simple_pixel_buffer()
        val backend_name = HostedWinitBufferBackend.implementation_name()
        val readback = if initial_pixels.len() == comp.width * comp.height: "presented-pixel-buffer" else: "unavailable"
        val initial_snapshot = host_wm_evidence_snapshot(
            comp.evidence_compositor_json(), surface, backend_name, false, readback,
            raster.last_backend, raster.last_readback_source, raster.last_backend_handle,
            raster.last_readback_checksum, raster.last_composition_id,
            raster.last_scene_key, raster.last_web_content_image_count,
            raster.last_readback_completed, raster.last_readback_width,
            raster.last_readback_height, raster.last_readback_stride,
            raster.last_readback_format,
            0, 0, evidence_nonce, evidence_phase,
            host_wm_input_receipt_json(input_receipt)
        )
        if not host_wm_evidence_write_snapshot(evidence.snapshot_path, initial_snapshot) or not host_wm_evidence_write_capture(evidence.capture_path, comp.width, comp.height, initial_pixels):
            print "ERROR: hosted WM initial evidence write failed"
            val _ = _close_hosted_browser_resources(
                browser_renderer, browser_raster,
                browser_raster_active, browser_profile
            )
            raster.shutdown()
            rt_winit_window_free(win)
            rt_winit_event_loop_free(el)
            return 2
        print "[hosted-wm] evidence-ready nonce=0 phase=presented"

    var running = true
    var warmup_frames: i64 = 0
    var mouse_move_events: i64 = 0
    var mouse_button_events: i64 = 0
    var focus_events: i64 = 0
    var key_events: i64 = 0
    var text_events: i64 = 0
    var window_move_events: i64 = 0
    var semantic_event_id: i64 = 0
    var web_sessions = HostedWebContentRegistry.create()
    var browser_renderers = HostedBrowserRendererRegistry.create_with_theme(
        executable, browser_home_url, 1, theme_wire_text
    )
    if browser_bookmark_revision > 0:
        browser_renderers.set_bookmark_snapshot(browser_bookmarks)
    val _ = browser_renderers.load_hsts_snapshot(
        browser_hsts, rt_time_now_unix_micros() / 1000
    )
    # Motion-background cadence seam (plan item B): the loop stays dirty-gated
    # (GUI-5a) — a due motion frame is just one more dirty *trigger*, evaluated
    # by the pure shared_wm_motion_dirty_due predicate on the loop's existing
    # iteration cadence (no new polling/sleeping is introduced). With no
    # motion source registered the seam reads -1 ("never due") and this loop
    # is byte-for-byte the old dirty decision.
    #
    # Self-re-arm: the trigger's once-per-due-value contract needs the
    # source's next-due to advance to a NEW value after it fires, which
    # normally happens as a side effect of render consuming the frame. Calling
    # shared_wm_motion_background_consume_due() right after the trigger fires
    # advances the source's bookkeeping directly at the seam, so the loop
    # re-arms itself every interval independent of what any render path does.
    #
    # I8 region-dirty (plan item B follow-up 1/2, LANDED): `other_dirty` and
    # `motion_dirty` are tracked separately so a due motion frame with NO
    # other reason to redraw takes HostCompositor.render_background_only()
    # instead of a full render_frame() — background-only advance no longer
    # re-rasters windows/chrome (host_compositor_entry.spl). Any OTHER dirty
    # reason (input, warmup) still forces the full path, which itself now
    # resolves self.background (color/image/motion) before drawing chrome
    # instead of hardcoding theme.compositor_bg — see
    # HostCompositor._resolve_background / render_frame's direct-draw branch.
    # render_background_only returns false when the background-visible region
    # can't be cheaply computed (pathological window layout); that case falls
    # back to a full render_frame() rather than risking an incorrect partial
    # paint.
    var last_motion_fired_due: i64 = -1
    val end_at = rt_time_now_micros() + 300000000
    while running and rt_time_now_micros() < end_at:
        var other_dirty = false
        var motion_dirty = false
        var evidence_capture_requested = false
        val now_micros = rt_time_now_micros()
        val wall_clock_ms = rt_time_now_unix_micros() / 1000
        if (browser_renderer_close_pending and
            now_micros >= browser_renderer_close_retry_at_micros):
            if browser_renderer.close():
                browser_renderer_close_pending = false
                browser_renderer_close_retry_at_micros = 0
            else:
                browser_renderer_close_retry_at_micros = (
                    now_micros + 1000000
                )
        if browser_renderer_ready:
            val browser_poll = browser_renderer.poll()
            if browser_renderer.hsts_dirty:
                val _ = (
                    browser_renderers.accept_renderer_hsts_snapshot(
                        browser_renderer.hsts_snapshot(wall_clock_ms),
                        wall_clock_ms
                    )
                )
                val _ = browser_renderer.load_hsts_snapshot(
                    browser_renderers.hsts_snapshot(wall_clock_ms),
                    wall_clock_ms
                )
                browser_primary_hsts_revision = (
                    browser_renderers.hsts_revision()
                )
            if val Some(browser_result) = browser_poll:
                if browser_result.ok:
                    if (browser_raster.w != browser_renderer.width or
                        browser_raster.h != browser_renderer.height):
                        browser_raster.shutdown()
                        browser_content_width = browser_renderer.width
                        browser_content_height = browser_renderer.height
                        browser_raster = (
                            Engine2dCompositorBackend.create_from_env(
                                browser_content_width,
                                browser_content_height
                            )
                        )
                    val rendered = browser_raster.render_draw_ir_composition_resources_revision(
                        browser_result.composition,
                        browser_result.image_resources,
                        browser_result.producer_generation,
                        browser_result.composition_revision
                    )
                    var current_title = browser_initial_title
                    var current_html = browser_initial_html
                    for window in comp.windows:
                        if window.id == browser_profile_window_id:
                            current_title = window.title
                            current_html = window.content
                    val revision = (
                        simple_web_content_revision_with_theme_receipt(
                        browser_theme_source_manifest_sha256,
                        browser_theme_material_sha256,
                        current_title,
                        current_html,
                        browser_content_width, browser_content_height, 0
                        )
                    )
                    val frame = (
                        simple_web_external_content_frame_with_theme_receipt(
                        browser_profile_window_id.to_text(),
                        revision,
                        1,
                        browser_renderer.theme_revision,
                        theme_wire_text,
                        browser_theme_id,
                        browser_theme_source_manifest_sha256,
                        browser_theme_material_sha256,
                        browser_content_width,
                        browser_content_height,
                        rendered,
                        browser_result.cpu_composited_count,
                        browser_result.cpu_composited_sha256,
                        browser_result.solid_material_count,
                        browser_result.solid_material_sha256
                        )
                    )
                    if comp.set_external_web_frame(
                        browser_profile_window_id, frame
                    ):
                        if (not browser_address_editing and
                            browser_renderer.document_url != ""):
                            browser_address_draft = (
                                browser_renderer.document_url
                            )
                            comp = host_compositor_update_window_title(
                                comp, browser_profile_window_id,
                                browser_address_draft
                            )
                        other_dirty = true
                else:
                    browser_renderer_ready = false
                    if browser_raster_active:
                        browser_raster.shutdown()
                        browser_raster_active = false
                    print "[hosted-wm] browser-renderer-failed reason={browser_result.reason}"
            if browser_renderer_ready:
                if val Err(reason) = browser_renderer.flush_pointer_cancel(
                    2000
                ):
                    print "[hosted-wm] browser-pointer-cancel-failed reason={reason}"
            if (browser_renderer_ready and
                browser_bookmark_applied_revision <
                    browser_bookmark_revision and
                browser_renderer.command_deadline_ms <= 0 and
                browser_renderer.network_job_handle <= 0):
                match browser_renderer.begin_bookmark_snapshot(
                    browser_bookmarks, 2000
                ):
                    Err(reason):
                        if reason != "renderer-busy":
                            browser_bookmark_applied_revision = (
                                browser_bookmark_revision
                            )
                            print "[hosted-wm] browser-bookmark-sync-failed reason={reason}"
                    Ok(_):
                        browser_bookmark_applied_revision = (
                            browser_bookmark_revision
                        )
            var desired_browser_width = browser_content_width
            var desired_browser_height = browser_content_height
            for window in comp.windows:
                if window.id == browser_profile_window_id:
                    desired_browser_width = window.w - 8
                    desired_browser_height = (
                        window.h - 36 - WM_BROWSER_TOOLBAR_HEIGHT
                    )
            if (browser_renderer_viewport_valid(
                    desired_browser_width.to_i64(),
                    desired_browser_height.to_i64()) and
                (desired_browser_width != browser_renderer.width or
                 desired_browser_height != browser_renderer.height) and
                (browser_renderer.command_deadline_ms <= 0 or
                 browser_renderer.pending_operation == "advance")):
                if val Err(reason) = browser_renderer.begin_resize(
                    desired_browser_width, desired_browser_height, 2000
                ):
                    print "[hosted-wm] browser-resize-deferred reason={reason}"
        var web_window_index = 0
        var live_browser_window_ids: [i64] = []
        while web_window_index < comp.windows.len():
            val web_window = comp.windows[web_window_index]
            if comp.requires_external_web_frame(web_window.id):
                live_browser_window_ids.push(web_window.id)
            if web_window.id != browser_profile_window_id:
                val web_content_height = web_window.h - 36 - (
                    if web_window.app_id == "browser":
                        WM_BROWSER_TOOLBAR_HEIGHT
                    else:
                        0
                )
                if comp.requires_external_web_frame(web_window.id):
                    var admitted = browser_renderers.contains(web_window.id)
                    if not admitted:
                        admitted = comp.require_external_web_frame(
                            web_window.id
                        )
                        if admitted:
                            val _ = browser_renderers.ensure(
                                web_window.id, web_window.content,
                                web_window.w - 8, web_content_height,
                                now_micros, wall_clock_ms
                            )
                    if admitted:
                        val renderer_status = browser_renderers.advance_window(
                            web_window.id, web_window.title, web_window.content,
                            web_window.w - 8, web_content_height, now_micros,
                            wall_clock_ms,
                            not web_window.minimized
                        )
                        if renderer_status == "frame":
                            val frame = browser_renderers.take_frame(
                                web_window.id
                            )
                            # take_frame() clears the registry's pending owner;
                            # transfer the unique frame to the compositor so a
                            # consumed retained base can be patched in place.
                            if comp.set_external_web_frame_owned(
                                web_window.id, frame
                            ):
                                other_dirty = true
                            else:
                                browser_renderers.fail_window(
                                    web_window.id,
                                    "external-frame-rejected"
                                )
                                comp.invalidate_external_web_frame(
                                    web_window.id
                                )
                        elif renderer_status == "failed":
                            comp.invalidate_external_web_frame(
                                web_window.id
                            )
                    if comp.is_browser_window(web_window.id):
                        val web_address = browser_renderers.address_text(
                            web_window.id
                        )
                        if (web_address != "" and
                            web_window.title != web_address):
                            comp = host_compositor_update_window_title(
                                comp, web_window.id, web_address
                            )
                            other_dirty = true
                elif not web_window.minimized:
                    val changed = web_sessions.advance_window(
                        web_window.id, web_window.content,
                        web_window.w - 8, web_content_height,
                        wall_clock_ms, false
                    )
                    if changed:
                        comp = host_compositor_update_window_content(
                            comp, web_window.id,
                            web_sessions.body_html(web_window.id)
                        )
                        other_dirty = true
            web_window_index = web_window_index + 1
        if not browser_renderers.reconcile(live_browser_window_ids):
            browser_resource_close_failed = true
        if (browser_profile_window_id > 0 and
            browser_primary_hsts_revision <
                browser_renderers.hsts_revision()):
            val shared_hsts = browser_renderers.hsts_snapshot(
                wall_clock_ms
            )
            val _ = browser_renderer.load_hsts_snapshot(
                shared_hsts, wall_clock_ms
            )
            browser_primary_hsts_revision = (
                browser_renderers.hsts_revision()
            )
        if (browser_renderers.hsts_dirty() and browser_profile != nil and
            now_micros >= browser_hsts_save_retry_at_micros):
            val shared_hsts = browser_renderers.hsts_snapshot(
                wall_clock_ms
            )
            var profile = browser_profile.unwrap()
            match profile.save_hsts(shared_hsts, wall_clock_ms):
                Ok(_):
                    browser_renderers.mark_hsts_saved()
                    browser_hsts_save_retry_at_micros = 0
                Err(error):
                    browser_hsts_save_retry_at_micros = (
                        now_micros + 1000000
                    )
                    print "ERROR: hosted browser HSTS save failed reason={error.message()}"
            browser_profile = Some(profile)
        if comp.web_animation_dirty_due(now_micros):
            other_dirty = true
        if (surface.phase == HostDisplayTransitionPhase.Requested or surface.phase == HostDisplayTransitionPhase.AwaitingResize) and now_micros > surface.deadline_micros:
            val timed_out = fail_or_timeout_display_transition(surface, surface.request_nonce, "", now_micros)
            surface = timed_out.state
            print "[hosted-wm] display-transition-failed nonce={surface.request_nonce} phase={surface.phase} reason={surface.failure_reason}"
        val motion_due = shared_wm_motion_background_next_due_micros()
        if shared_wm_motion_dirty_due(now_micros, motion_due, last_motion_fired_due):
            motion_dirty = true
            last_motion_fired_due = motion_due
            shared_wm_motion_background_consume_due(motion_due)
        var ev = rt_winit_event_loop_poll_events(el, 1)
        while ev != 0:
            val input_received_us = rt_time_now_micros()
            val kind = rt_winit_event_get_type(ev)
            if kind == EVT_CLOSE:
                if surface.phase == HostDisplayTransitionPhase.Requested or surface.phase == HostDisplayTransitionPhase.AwaitingResize:
                    val cancelled = fail_or_timeout_display_transition(surface, surface.request_nonce, "window closed during display transition", now_micros)
                    surface = cancelled.state
                    print "[hosted-wm] display-transition-failed nonce={surface.request_nonce} phase={surface.phase} reason={surface.failure_reason}"
                running = false
            elif kind == EVT_RESIZE or kind == EVT_SCALE_FACTOR:
                val physical = _physical_surface_geometry(win)
                if surface.phase == HostDisplayTransitionPhase.Requested or surface.phase == HostDisplayTransitionPhase.AwaitingResize:
                    val acknowledged = ack_surface_event(surface, surface.request_nonce, physical, now_micros)
                    surface = acknowledged.state
                    if evidence.enabled and acknowledged.accepted and surface.phase == HostDisplayTransitionPhase.Applied:
                        evidence_phase = "display-applied"
                    if acknowledged.accepted and surface.phase == HostDisplayTransitionPhase.Applied and surface.mode == HostDisplayMode.Windowed:
                        if not _restore_windowed_position(surface, win):
                            print "[hosted-wm] window-position-restore-failed x={surface.saved_windowed_geometry.x} y={surface.saved_windowed_geometry.y}"
                else:
                    surface.geometry = physical
                if physical.width > 0 and physical.height > 0:
                    comp.resize(physical.width, physical.height)
                    if raster.w != physical.width or raster.h != physical.height:
                        raster.shutdown()
                        raster = _hosted_engine2d_raster_for_window(
                            win, physical.width, physical.height)
                    other_dirty = true
                print "[hosted-wm] event surface kind={kind} mode={surface.mode} phase={surface.phase} nonce={surface.request_nonce} width={physical.width} height={physical.height} scale_milli={physical.scale_milli}"
            elif kind == EVT_MOVE:
                val position_x = rt_winit_event_window_x(ev) as i32
                val position_y = rt_winit_event_window_y(ev) as i32
                window_move_events = window_move_events + 1
                surface.geometry.x = position_x
                surface.geometry.y = position_y
                if surface.mode == HostDisplayMode.Windowed and surface.phase != HostDisplayTransitionPhase.Requested and surface.phase != HostDisplayTransitionPhase.AwaitingResize:
                    surface.saved_windowed_geometry.x = position_x
                    surface.saved_windowed_geometry.y = position_y
                other_dirty = true
                print "[hosted-wm] event window-moved count={window_move_events} x={position_x} y={position_y} mode={surface.mode}"
            elif kind == EVT_FOCUS or kind == EVT_UNFOCUS:
                focus_events = focus_events + 1
                print "[hosted-wm] event focus count={focus_events} focused={kind == EVT_FOCUS}"
            elif kind == EVT_MOUSE_MOVE:
                val mx = (rt_winit_event_mouse_x_milli(ev) / 1000).to_i32()
                val my = (rt_winit_event_mouse_y_milli(ev) / 1000).to_i32()
                comp.pointer_move(mx, my)
                # GUI-session content lane: mirror the baremetal
                # dispatch_gui_pointer_event move semantics (captured target
                # wins; otherwise the client-area hit under the pointer).
                if (comp.gui_pointer_capture_window_id > 0 or
                    comp.gui_content_window_ids.len() > 0):
                    var gui_move_window_id = comp.gui_pointer_capture_window_id
                    if gui_move_window_id == 0:
                        val gui_move_target = comp.content_target(mx, my)
                        if gui_move_target != nil:
                            gui_move_window_id = (
                                gui_move_target.unwrap().window_id
                            )
                    if (gui_move_window_id > 0 and
                        comp.is_gui_content_window(gui_move_window_id)):
                        val _ = comp.dispatch_gui_pointer_event(
                            gui_move_window_id, mx, my, "", "move"
                        )
                input_receipt = host_wm_input_record_pointer_move(input_receipt, mx, my)
                mouse_move_events = mouse_move_events + 1
                if mouse_move_events <= 3:
                    print "[hosted-wm] event mouse_move count={mouse_move_events} x={mx} y={my}"
                other_dirty = true
            elif kind == EVT_MOUSE_BUTTON:
                val button = rt_winit_event_mouse_button(ev)
                val pressed = rt_winit_event_mouse_pressed(ev) != 0
                val wm_close_window_id = (
                    host_compositor_close_release_target(
                        comp, button, pressed
                    )
                )
                var allow_wm_close = true
                if (wm_close_window_id > 0 and
                    wm_close_window_id == browser_profile_window_id):
                    val saved_renderer = _save_hosted_browser_hsts(
                        browser_renderer, browser_profile, wall_clock_ms
                    )
                    allow_wm_close = saved_renderer != nil
                    if saved_renderer != nil:
                        browser_renderer = saved_renderer.unwrap()
                elif wm_close_window_id > 0:
                    if browser_renderers.contains(wm_close_window_id):
                        allow_wm_close = browser_renderers.remove_window(
                            wm_close_window_id
                        )
                        if allow_wm_close:
                            comp.release_external_web_frame(wm_close_window_id)
                    else:
                        allow_wm_close = web_sessions.close_window(
                            wm_close_window_id
                        )
                if not allow_wm_close:
                    comp.armed_chrome_target = ""
                    comp.armed_chrome_window_id = 0
                    print "[hosted-wm] browser-window-close-rejected reason=profile-save-failed"
                val content_target = comp.content_target(comp.pointer_x, comp.pointer_y)
                val chrome_target = comp.browser_chrome_target(
                    comp.pointer_x, comp.pointer_y
                )
                # Route all buttons (0=left, 1=middle, 2=right) to the compositor,
                # not just left. Left keeps its full chrome semantics; middle/right
                # are recorded on the compositor (last_button/last_button_down) so
                # the event is observable even though no chrome action consumes
                # them yet (parity with ui.browser/app.spl's unconditional forward).
                comp.handle_mouse_button(button, pressed)
                if (allow_wm_close and wm_close_window_id > 0 and
                    host_compositor_find_window_index(
                        comp, wm_close_window_id
                    ) < 0):
                    if wm_close_window_id == browser_profile_window_id:
                        val browser_closed = _close_hosted_browser_renderer_resources(
                            browser_renderer, browser_raster,
                            browser_raster_active
                        )
                        browser_renderer = browser_closed.renderer
                        browser_raster = browser_closed.raster
                        browser_renderer_close_pending = not browser_closed.ok
                        browser_renderer_close_retry_at_micros = (
                            _browser_renderer_close_retry_due(
                                browser_closed.ok, now_micros
                            )
                        )
                        browser_renderer_ready = false
                        browser_raster_active = false
                        comp.release_external_web_frame(
                            browser_profile_window_id
                        )
                        browser_profile_window_id = 0
                input_receipt = host_wm_input_record_pointer_button(input_receipt, button, pressed)
                if button == 0 and chrome_target != nil:
                    val target = chrome_target.unwrap()
                    semantic_event_id = semantic_event_id + 1
                    var action_reason = ""
                    var callback_count: i64 = 0
                    var semantic_target_id = (
                        "browser:parent#{target.control}"
                    )
                    var mutation_revision = comp.render_revision
                    if target.window_id != browser_profile_window_id:
                        val dispatch = browser_renderers.dispatch_chrome_pointer(
                            semantic_event_id, target.window_id,
                            target.control, pressed
                        )
                        action_reason = dispatch.reason
                        callback_count = dispatch.callback_count
                        semantic_target_id = dispatch.semantic_target_id
                        mutation_revision = dispatch.mutation_revision
                        if (not pressed and target.control == "favorite" and
                            dispatch.reason == "favorite-parent"):
                            val url = browser_renderers.document_url(
                                target.window_id
                            )
                            if url == "":
                                action_reason = "no-network-document"
                            elif browser_profile == nil:
                                action_reason = "profile-unavailable"
                            else:
                                var profile = browser_profile.unwrap()
                                val commit = hosted_browser_parent_toggle_bookmark(
                                    profile,
                                    url,
                                    browser_renderers.bookmark_stored_title(
                                        target.window_id
                                    )
                                )
                                if commit.ok:
                                    browser_bookmarks = commit.bookmarks
                                    browser_bookmark_revision = (
                                        browser_bookmark_revision + 1
                                    )
                                    browser_renderers.set_bookmark_snapshot(
                                        commit.bookmarks
                                    )
                                    callback_count = 1
                                    action_reason = ""
                                else:
                                    action_reason = commit.reason
                                profile = commit.profile
                                browser_profile = Some(profile)
                        comp = host_compositor_update_window_title(
                            comp, target.window_id,
                            browser_renderers.address_text(target.window_id)
                        )
                    elif pressed:
                        match browser_renderer.cancel_pointer(
                            semantic_event_id, 2000
                        ):
                            Err(reason):
                                action_reason = reason
                            Ok(_):
                                browser_pressed_control = target.control
                                browser_address_draft = (
                                    browser_address_draft_after_control_press(
                                        target.control,
                                        browser_renderer.document_url,
                                        browser_address_draft
                                    )
                                )
                                if target.control == "address":
                                    browser_address_editing = true
                                    browser_address_replace_on_text = true
                                else:
                                    browser_address_editing = false
                                    browser_address_replace_on_text = false
                                action_reason = "chrome-pressed"
                    else:
                        val armed = browser_pressed_control
                        browser_pressed_control = ""
                        if armed != target.control:
                            action_reason = "chrome-release-target-mismatch"
                        elif target.control == "address":
                            browser_address_editing = true
                            browser_address_replace_on_text = true
                            action_reason = "address-focused"
                        elif not browser_renderer_ready:
                            action_reason = "renderer-unavailable"
                        elif target.control == "favorite":
                            if browser_renderer.document_url == "":
                                action_reason = "no-network-document"
                            elif browser_profile == nil:
                                action_reason = "profile-unavailable"
                            elif (browser_renderer.command_deadline_ms > 0 or
                                  browser_renderer.network_job_handle > 0):
                                action_reason = "renderer-busy"
                            else:
                                var profile = browser_profile.unwrap()
                                val commit = hosted_browser_parent_toggle_bookmark(
                                    profile,
                                    browser_renderer.document_url,
                                    browser_renderer.bookmark_stored_title()
                                )
                                if commit.ok:
                                    browser_bookmarks = commit.bookmarks
                                    browser_bookmark_revision = (
                                        browser_bookmark_revision + 1
                                    )
                                    browser_renderers.set_bookmark_snapshot(
                                        commit.bookmarks
                                    )
                                    callback_count = 1
                                else:
                                    action_reason = commit.reason
                                profile = commit.profile
                                browser_profile = Some(profile)
                        else:
                            if target.control == "go":
                                val address_activation = (
                                    hosted_browser_process_activate_address(
                                        browser_renderer,
                                        browser_renderer.document_url,
                                        browser_address_draft,
                                        2000
                                    )
                                )
                                callback_count = (
                                    address_activation.callback_count
                                )
                                action_reason = address_activation.reason
                                browser_address_editing = (
                                    address_activation.retain_address_focus
                                )
                                if not browser_address_editing:
                                    browser_address_replace_on_text = false
                            else:
                                browser_address_editing = false
                                browser_address_replace_on_text = false
                            if target.control == "back":
                                match browser_renderer.begin_go_back(2000):
                                    Ok(_): callback_count = 1
                                    Err(reason): action_reason = reason
                            elif target.control == "forward":
                                match browser_renderer.begin_go_forward(2000):
                                    Ok(_): callback_count = 1
                                    Err(reason): action_reason = reason
                            elif target.control == "stop":
                                match browser_renderer.begin_stop(2000):
                                    Ok(_): callback_count = 1
                                    Err(reason): action_reason = reason
                            elif target.control == "reload":
                                match browser_renderer.begin_reload(2000):
                                    Ok(_): callback_count = 1
                                    Err(reason): action_reason = reason
                            elif target.control == "home":
                                match browser_renderer.begin_go_home(2000):
                                    Ok(_): callback_count = 1
                                    Err(reason): action_reason = reason
                    input_receipt = host_wm_input_record_semantic(
                        input_receipt, semantic_event_id, target.window_id,
                        semantic_target_id, callback_count,
                        mutation_revision, action_reason, input_received_us
                    )
                    print "[hosted-wm] semantic event_origin=browser-chrome event_id={semantic_event_id} wm_target_id={target.window_id} semantic_target_id={semantic_target_id} callback_count={callback_count} reason={action_reason}"
                elif button == 0 and content_target != nil:
                    val target = content_target.unwrap()
                    semantic_event_id = semantic_event_id + 1
                    if target.window_id == browser_profile_window_id:
                        browser_address_editing = false
                        browser_address_replace_on_text = false
                        var action_reason = ""
                        var callback_count: i64 = 0
                        if not pressed and browser_pressed_control != "":
                            browser_pressed_control = ""
                            action_reason = "chrome-release-target-mismatch"
                        else:
                            if pressed:
                                browser_pressed_control = ""
                            match browser_renderer.begin_pointer(
                                semantic_event_id, target.local_x,
                                target.local_y, pressed, 2000
                            ):
                                Ok(_): callback_count = 1
                                Err(reason): action_reason = reason
                        input_receipt = host_wm_input_record_semantic(
                            input_receipt, semantic_event_id,
                            target.window_id, "browser:page",
                            callback_count, comp.render_revision,
                            action_reason, input_received_us
                        )
                    else:
                        if (comp.gui_pointer_capture_window_id > 0 or
                            comp.is_gui_content_window(target.window_id)):
                            # GUI-session content lane (baremetal
                            # dispatch_gui_pointer_event parity): the
                            # compositor translates to client-local
                            # coordinates and owns pointer capture.
                            val gui_handled = comp.dispatch_gui_pointer_event(
                                target.window_id, comp.pointer_x,
                                comp.pointer_y, "left",
                                if pressed: "down" else: "up"
                            )
                            input_receipt = host_wm_input_record_semantic(
                                input_receipt, semantic_event_id,
                                target.window_id, "gui:session",
                                if gui_handled: 1 else: 0,
                                comp.render_revision,
                                if gui_handled: "" else: (
                                    "gui-dispatch-rejected"
                                ),
                                input_received_us
                            )
                        elif comp.requires_external_web_frame(target.window_id):
                            val dispatch = browser_renderers.dispatch_pointer(
                                semantic_event_id, target.window_id,
                                target.local_x, target.local_y, pressed
                            )
                            input_receipt = host_wm_input_record_semantic(
                                input_receipt, dispatch.event_id,
                                dispatch.wm_target_id,
                                dispatch.semantic_target_id,
                                dispatch.callback_count,
                                dispatch.mutation_revision, dispatch.reason,
                                input_received_us
                            )
                        else:
                            val dispatch = web_sessions.dispatch_pointer(
                                semantic_event_id, target.window_id,
                                target.body_html, target.width, target.height,
                                target.local_x, target.local_y, pressed
                            )
                            input_receipt = host_wm_input_record_semantic(
                                input_receipt, dispatch.event_id,
                                dispatch.wm_target_id,
                                dispatch.semantic_target_id,
                                dispatch.callback_count,
                                dispatch.mutation_revision, dispatch.reason,
                                input_received_us
                            )
                            if dispatch.mutation_revision > 0:
                                comp = host_compositor_update_window_content(
                                    comp, target.window_id,
                                    web_sessions.body_html(target.window_id)
                                )
                elif button == 0:
                    if comp.gui_pointer_capture_window_id > 0:
                        # Release outside every client area still reaches the
                        # captured GUI session (window_id 0 routes via the
                        # compositor's capture id, mirroring baremetal).
                        val _ = comp.dispatch_gui_pointer_event(
                            0, comp.pointer_x, comp.pointer_y, "left",
                            if pressed: "down" else: "up"
                        )
                    web_sessions.cancel_pointer_state()
                    semantic_event_id = semantic_event_id + 1
                    browser_pressed_control = ""
                    val _ = browser_renderer.cancel_pointer(
                        semantic_event_id, 2000
                    )
                    browser_renderers.cancel_pointer_state(semantic_event_id)
                mouse_button_events = mouse_button_events + 1
                print "[hosted-wm] event mouse_button count={mouse_button_events} button={button} pressed={pressed}"
                other_dirty = true
            elif kind == EVT_MOUSE_WHEEL:
                val wheel_x_milli = rt_winit_event_wheel_x_milli(ev)
                val wheel_y_milli = rt_winit_event_wheel_y_milli(ev)
                var bounded_wheel_y_milli = wheel_y_milli
                if bounded_wheel_y_milli > BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI:
                    bounded_wheel_y_milli = BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI
                elif bounded_wheel_y_milli < 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI:
                    bounded_wheel_y_milli = 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI
                val browser_scroll_y_milli = 0 - bounded_wheel_y_milli
                val content_target = comp.content_target(
                    comp.pointer_x, comp.pointer_y
                )
                var browser_wheel = false
                if content_target != nil:
                    val target = content_target.unwrap()
                    if target.window_id == browser_profile_window_id:
                        browser_wheel = true
                        semantic_event_id = semantic_event_id + 1
                        var reason = ""
                        var callback_count: i64 = 0
                        match browser_renderer.queue_scroll(
                            semantic_event_id, browser_scroll_y_milli
                        ):
                            Ok(_): callback_count = 1
                            Err(error): reason = error
                        input_receipt = host_wm_input_record_semantic(
                            input_receipt, semantic_event_id,
                            target.window_id, "browser:page",
                            callback_count, comp.render_revision,
                            reason, input_received_us
                        )
                    elif comp.is_gui_content_window(target.window_id):
                        # GUI-session content lane: scroll goes to the widget
                        # session, not the WM scroll-offset accumulator.
                        browser_wheel = true
                        semantic_event_id = semantic_event_id + 1
                        val gui_handled = comp.dispatch_gui_scroll_event(
                            target.window_id, comp.pointer_x, comp.pointer_y,
                            wheel_x_milli, bounded_wheel_y_milli
                        )
                        input_receipt = host_wm_input_record_semantic(
                            input_receipt, semantic_event_id,
                            target.window_id, "gui:session",
                            if gui_handled: 1 else: 0,
                            comp.render_revision,
                            if gui_handled: "" else: "gui-dispatch-rejected",
                            input_received_us
                        )
                    elif comp.requires_external_web_frame(target.window_id):
                        browser_wheel = true
                        semantic_event_id = semantic_event_id + 1
                        val dispatch = browser_renderers.dispatch_scroll(
                            semantic_event_id, target.window_id,
                            browser_scroll_y_milli
                        )
                        input_receipt = host_wm_input_record_semantic(
                            input_receipt, dispatch.event_id,
                            dispatch.wm_target_id,
                            dispatch.semantic_target_id,
                            dispatch.callback_count,
                            dispatch.mutation_revision, dispatch.reason,
                            input_received_us
                        )
                if not browser_wheel:
                    comp.handle_mouse_wheel(
                        wheel_x_milli.to_f64() / 1000.0,
                        wheel_y_milli.to_f64() / 1000.0
                    )
                    other_dirty = true
            elif kind == EVT_KEY:
                val scan_code = rt_winit_event_key_scancode(ev)
                val keycode = rt_winit_event_key_keycode(ev)
                val pressed_key = rt_winit_event_key_pressed(ev) != 0
                val shift_key = rt_winit_event_key_shifted(ev) != 0
                input_receipt = host_wm_input_record_key(input_receipt, scan_code, keycode, pressed_key)
                key_events = key_events + 1
                val key_state = if pressed_key: "down" else: "up"
                print "[hosted-wm] event key count={key_events} state={key_state} scancode={scan_code} keycode={keycode}"
                var semantic_consumed = false
                val focused = host_compositor_focused_window_id(comp)
                if focused == browser_profile_window_id:
                    semantic_event_id = semantic_event_id + 1
                    var action_reason = ""
                    var callback_count: i64 = 0
                    val semantic_target_id = if browser_address_editing:
                        "browser:parent#address"
                    else:
                        "browser:page"
                    if browser_address_editing:
                        semantic_consumed = true
                        if pressed_key and keycode == KEY_ENTER:
                            val address_activation = (
                                hosted_browser_process_activate_address(
                                    browser_renderer,
                                    browser_renderer.document_url,
                                    browser_address_draft,
                                    2000
                                )
                            )
                            callback_count = address_activation.callback_count
                            action_reason = address_activation.reason
                            browser_address_editing = (
                                address_activation.retain_address_focus
                            )
                            if not browser_address_editing:
                                browser_address_replace_on_text = false
                        elif pressed_key and keycode == KEY_ESCAPE:
                            browser_address_draft = if (
                                browser_renderer.document_url != ""
                            ):
                                browser_renderer.document_url
                            else:
                                "about:blank"
                            browser_address_editing = false
                            browser_address_replace_on_text = false
                            comp = host_compositor_update_window_title(
                                comp, focused, browser_address_draft
                            )
                            callback_count = 1
                        elif pressed_key and keycode == KEY_BACKSPACE:
                            match browser_address_backspace(
                                browser_address_draft,
                                browser_address_replace_on_text
                            ):
                                Err(reason):
                                    action_reason = reason
                                Ok(updated):
                                    browser_address_draft = updated
                                    browser_address_replace_on_text = false
                                    comp = host_compositor_update_window_title(
                                        comp, focused,
                                        browser_address_draft
                                    )
                                    callback_count = 1
                    elif keycode != KEY_ESCAPE:
                        semantic_consumed = true
                        match browser_renderer.begin_key_with_shift(
                            semantic_event_id, keycode, pressed_key,
                            shift_key, 2000
                        ):
                            Ok(_): callback_count = 1
                            Err(reason): action_reason = reason
                    input_receipt = host_wm_input_record_semantic(
                        input_receipt, semantic_event_id, focused,
                        semantic_target_id,
                        callback_count, comp.render_revision, action_reason,
                        input_received_us
                    )
                elif focused > 0:
                    semantic_event_id = semantic_event_id + 1
                    if comp.is_gui_content_window(focused):
                        # GUI-session content lane: physical keys become named
                        # widget keys (baremetal dispatch_gui_key_event
                        # parity). Escape stays the WM quit key and F11 the
                        # display toggle, matching the browser lane.
                        var gui_callback: i64 = 0
                        var gui_reason = "key-up"
                        if (pressed_key and keycode != KEY_ESCAPE and
                            keycode != KEY_F11):
                            val gui_key = _host_winit_gui_key_name(keycode)
                            if gui_key == "":
                                gui_reason = "unmapped-keycode"
                            elif comp.dispatch_gui_key_event(
                                focused, gui_key, false, shift_key,
                                false, false
                            ):
                                gui_callback = 1
                                gui_reason = ""
                                semantic_consumed = true
                            else:
                                gui_reason = "gui-dispatch-rejected"
                        input_receipt = host_wm_input_record_semantic(
                            input_receipt, semantic_event_id, focused,
                            "gui:session", gui_callback,
                            comp.render_revision, gui_reason,
                            input_received_us
                        )
                    elif comp.requires_external_web_frame(focused):
                        val dispatch = browser_renderers.dispatch_key_with_shift(
                            semantic_event_id, focused, keycode, pressed_key,
                            shift_key
                        )
                        semantic_consumed = dispatch.semantic_target_id != ""
                        input_receipt = host_wm_input_record_semantic(
                            input_receipt, dispatch.event_id,
                            dispatch.wm_target_id,
                            dispatch.semantic_target_id,
                            dispatch.callback_count,
                            dispatch.mutation_revision, dispatch.reason,
                            input_received_us
                        )
                        if comp.is_browser_window(focused):
                            comp = host_compositor_update_window_title(
                                comp, focused,
                                browser_renderers.address_text(focused)
                            )
                    else:
                        val dispatch = web_sessions.dispatch_key_with_shift(
                            semantic_event_id, focused, keycode, pressed_key,
                            shift_key
                        )
                        semantic_consumed = dispatch.semantic_target_id != ""
                        input_receipt = host_wm_input_record_semantic(
                            input_receipt, dispatch.event_id,
                            dispatch.wm_target_id,
                            dispatch.semantic_target_id,
                            dispatch.callback_count,
                            dispatch.mutation_revision, dispatch.reason,
                            input_received_us
                        )
                        if dispatch.callback_count > 0:
                            comp = host_compositor_update_window_content(
                                comp, focused,
                                web_sessions.body_html(focused)
                            )
                        if dispatch.semantic_target_id == (
                            "browser:session#address"
                        ):
                            comp = host_compositor_update_window_title(
                                comp, focused,
                                web_sessions.address_text(focused)
                            )
                if pressed_key and keycode == KEY_F11:
                    display_nonce = display_nonce + 1
                    surface = _request_host_fullscreen(
                        surface, win, display_nonce, now_micros
                    )
                    print "[hosted-wm] display-request nonce={display_nonce} phase={surface.phase} requested_mode={surface.requested_mode}"
                    other_dirty = true
                elif pressed_key and not semantic_consumed:
                    if keycode == KEY_ESCAPE:
                        running = false
                    elif keycode == KEY_TAB:
                        comp = host_compositor_cycle_focus(comp)
                    elif keycode == KEY_W:
                        val focused = host_compositor_focused_window_id(comp)
                        if focused > 0:
                            if focused == browser_profile_window_id:
                                val saved_renderer = _save_hosted_browser_hsts(
                                    browser_renderer, browser_profile,
                                    wall_clock_ms
                                )
                                if saved_renderer == nil:
                                    print "[hosted-wm] browser-window-close-rejected reason=profile-save-failed"
                                else:
                                    browser_renderer = saved_renderer.unwrap()
                                    val browser_closed = _close_hosted_browser_renderer_resources(
                                        browser_renderer, browser_raster,
                                        browser_raster_active
                                    )
                                    browser_renderer = (
                                        browser_closed.renderer
                                    )
                                    browser_raster = browser_closed.raster
                                    browser_renderer_close_pending = (
                                        not browser_closed.ok
                                    )
                                    browser_renderer_close_retry_at_micros = (
                                        _browser_renderer_close_retry_due(
                                            browser_closed.ok, now_micros
                                        )
                                    )
                                    browser_renderer_ready = false
                                    browser_raster_active = false
                                    comp.release_external_web_frame(focused)
                                    comp.destroy_window(focused)
                                    browser_profile_window_id = 0
                            elif browser_renderers.contains(focused):
                                if browser_renderers.remove_window(focused):
                                    comp.release_external_web_frame(focused)
                                    comp.destroy_window(focused)
                            elif web_sessions.close_window(focused):
                                comp.destroy_window(focused)
                            else:
                                print "[hosted-wm] browser-window-close-rejected reason={web_sessions.profile_failure_reason}"
                    elif keycode == KEY_M:
                        comp = host_compositor_minimize_focused(comp)
                    elif keycode == KEY_R:
                        comp = host_compositor_restore_all(comp)
                    other_dirty = true
            elif kind == EVT_TEXT:
                val committed_text = winit_event_text(ev)
                if committed_text != "":
                    input_receipt = host_wm_input_record_text(input_receipt, committed_text)
                    text_events = text_events + 1
                    val focused = host_compositor_focused_window_id(comp)
                    if focused == browser_profile_window_id:
                        semantic_event_id = semantic_event_id + 1
                        var action_reason = ""
                        var callback_count: i64 = 0
                        if browser_address_editing:
                            match browser_address_update(
                                browser_address_draft, committed_text,
                                browser_address_replace_on_text
                            ):
                                Err(reason):
                                    action_reason = reason
                                Ok(updated):
                                    browser_address_draft = updated
                                    browser_address_replace_on_text = false
                                    comp = (
                                        host_compositor_update_window_title(
                                            comp, focused,
                                            browser_address_draft
                                        )
                                    )
                                    callback_count = 1
                        else:
                            match browser_renderer.begin_text_input(
                                semantic_event_id, committed_text, 2000
                            ):
                                Ok(_): callback_count = 1
                                Err(reason): action_reason = reason
                        input_receipt = host_wm_input_record_semantic(
                            input_receipt, semantic_event_id, focused,
                            if browser_address_editing:
                                "browser:parent#address"
                            else:
                                "browser:page",
                            callback_count, comp.render_revision,
                            action_reason, input_received_us
                        )
                    elif focused > 0:
                        semantic_event_id = semantic_event_id + 1
                        if comp.is_gui_content_window(focused):
                            # GUI-session content lane: committed text lands
                            # as a composition commit on the focused widget.
                            val gui_handled = comp.dispatch_gui_text_event(
                                focused, committed_text
                            )
                            input_receipt = host_wm_input_record_semantic(
                                input_receipt, semantic_event_id, focused,
                                "gui:session",
                                if gui_handled: 1 else: 0,
                                comp.render_revision,
                                if gui_handled: "" else: (
                                    "gui-dispatch-rejected"
                                ),
                                input_received_us
                            )
                        elif comp.requires_external_web_frame(focused):
                            val dispatch = browser_renderers.dispatch_text(
                                semantic_event_id, focused, committed_text
                            )
                            input_receipt = host_wm_input_record_semantic(
                                input_receipt, dispatch.event_id,
                                dispatch.wm_target_id,
                                dispatch.semantic_target_id,
                                dispatch.callback_count,
                                dispatch.mutation_revision, dispatch.reason,
                                input_received_us
                            )
                            if comp.is_browser_window(focused):
                                comp = host_compositor_update_window_title(
                                    comp, focused,
                                    browser_renderers.address_text(focused)
                                )
                        else:
                            val dispatch = web_sessions.dispatch_text(
                                semantic_event_id, focused, committed_text
                            )
                            input_receipt = host_wm_input_record_semantic(
                                input_receipt, dispatch.event_id,
                                dispatch.wm_target_id,
                                dispatch.semantic_target_id,
                                dispatch.callback_count,
                                dispatch.mutation_revision, dispatch.reason,
                                input_received_us
                            )
                            if dispatch.callback_count > 0:
                                comp = host_compositor_update_window_content(
                                    comp, focused,
                                    web_sessions.body_html(focused)
                                )
                            if dispatch.semantic_target_id == (
                                "browser:session#address"
                            ):
                                comp = host_compositor_update_window_title(
                                    comp, focused,
                                    web_sessions.address_text(focused)
                                )
                    print "[hosted-wm] event text count={text_events} committed={committed_text}"
                    other_dirty = true
            rt_winit_event_free(ev)
            ev = rt_winit_event_loop_poll_events(el, 1)
        val browser_animation_time_ms = (
            now_micros - browser_animation_origin_micros
        ) / 1000
        var browser_scroll_started = false
        if (browser_renderer_ready and
            browser_renderer.command_deadline_ms <= 0 and
            browser_renderer.pending_scroll_delta_milli_y != 0):
            match browser_renderer.flush_scroll(2000):
                Ok(started): browser_scroll_started = started
                Err(reason):
                    browser_renderer_ready = false
                    print "[hosted-wm] browser-scroll-failed reason={reason}"
        if (browser_renderer_ready and
            not browser_scroll_started and
            browser_renderer.command_deadline_ms <= 0 and
            browser_renderer.next_animation_ms >= 0 and
            browser_animation_time_ms >=
                browser_renderer.next_animation_ms):
            if val Err(reason) = browser_renderer.begin_advance(
                browser_animation_time_ms,
                2000
            ):
                browser_renderer_ready = false
                print "[hosted-wm] browser-animation-failed reason={reason}"
        if evidence.enabled:
            val command = host_wm_evidence_read_command(evidence.input_fifo)
            if command.valid and command.nonce > evidence_nonce:
                evidence_nonce = command.nonce
                evidence_phase = "accepted"
                if command.action == "f11":
                    display_nonce = display_nonce + 1
                    surface = _request_host_fullscreen(surface, win, display_nonce, now_micros)
                    evidence_phase = "display-requested"
                elif command.action == "tab":
                    comp = host_compositor_cycle_focus(comp)
                    evidence_phase = "applied"
                elif command.action == "minimize":
                    comp = host_compositor_minimize_focused(comp)
                    evidence_phase = "applied"
                elif command.action == "maximize":
                    comp = host_compositor_maximize_focused(comp)
                    evidence_phase = "applied"
                elif command.action == "restore":
                    val focused = host_compositor_focused_window_id(comp)
                    if focused > 0: comp.restore_window(focused)
                    evidence_phase = "applied"
                elif command.action == "close":
                    val focused = host_compositor_focused_window_id(comp)
                    var close_applied = true
                    if focused > 0:
                        if focused == browser_profile_window_id:
                            val saved_renderer = _save_hosted_browser_hsts(
                                browser_renderer, browser_profile,
                                wall_clock_ms
                            )
                            if saved_renderer == nil:
                                print "[hosted-wm] browser-window-close-rejected reason=profile-save-failed"
                                close_applied = false
                            else:
                                browser_renderer = saved_renderer.unwrap()
                                val browser_closed = _close_hosted_browser_renderer_resources(
                                    browser_renderer, browser_raster,
                                    browser_raster_active
                                )
                                browser_renderer = browser_closed.renderer
                                browser_raster = browser_closed.raster
                                browser_renderer_close_pending = (
                                    not browser_closed.ok
                                )
                                browser_renderer_close_retry_at_micros = (
                                    _browser_renderer_close_retry_due(
                                        browser_closed.ok, now_micros
                                    )
                                )
                                browser_renderer_ready = false
                                browser_raster_active = false
                                comp.release_external_web_frame(focused)
                                comp.destroy_window(focused)
                                browser_profile_window_id = 0
                        elif browser_renderers.contains(focused):
                            if browser_renderers.remove_window(focused):
                                comp.release_external_web_frame(focused)
                                comp.destroy_window(focused)
                            else:
                                close_applied = false
                        elif web_sessions.close_window(focused):
                            comp.destroy_window(focused)
                        else:
                            print "[hosted-wm] browser-window-close-rejected reason={web_sessions.profile_failure_reason}"
                            close_applied = false
                    evidence_phase = if close_applied:
                        "applied"
                    else:
                        "rejected"
                elif command.action == "pointer":
                    comp.pointer_move(command.x, command.y)
                    input_receipt = host_wm_input_record_pointer_move(input_receipt, command.x, command.y)
                    evidence_phase = "applied"
                elif command.action == "left":
                    val evidence_close_window_id = (
                        host_compositor_close_release_target(
                            comp, 0, command.down
                        )
                    )
                    var allow_evidence_close = true
                    if (evidence_close_window_id > 0 and
                        evidence_close_window_id ==
                        browser_profile_window_id):
                        val saved_renderer = _save_hosted_browser_hsts(
                            browser_renderer, browser_profile, wall_clock_ms
                        )
                        allow_evidence_close = saved_renderer != nil
                        if saved_renderer != nil:
                            browser_renderer = saved_renderer.unwrap()
                    elif evidence_close_window_id > 0:
                        if browser_renderers.contains(evidence_close_window_id):
                            allow_evidence_close = browser_renderers.remove_window(
                                evidence_close_window_id
                            )
                            if allow_evidence_close:
                                comp.release_external_web_frame(
                                    evidence_close_window_id
                                )
                        else:
                            allow_evidence_close = web_sessions.close_window(
                                evidence_close_window_id
                            )
                    if not allow_evidence_close:
                        comp.armed_chrome_target = ""
                        comp.armed_chrome_window_id = 0
                        print "[hosted-wm] browser-window-close-rejected reason=profile-save-failed"
                    comp.handle_mouse_button(0, command.down)
                    if (allow_evidence_close and
                        evidence_close_window_id > 0 and
                        host_compositor_find_window_index(
                            comp, evidence_close_window_id
                        ) < 0 and evidence_close_window_id ==
                        browser_profile_window_id):
                        val browser_closed = _close_hosted_browser_renderer_resources(
                            browser_renderer, browser_raster,
                            browser_raster_active
                        )
                        browser_renderer = browser_closed.renderer
                        browser_raster = browser_closed.raster
                        browser_renderer_close_pending = not browser_closed.ok
                        browser_renderer_close_retry_at_micros = (
                            _browser_renderer_close_retry_due(
                                browser_closed.ok, now_micros
                            )
                        )
                        browser_renderer_ready = false
                        browser_raster_active = false
                        comp.release_external_web_frame(
                            browser_profile_window_id
                        )
                        browser_profile_window_id = 0
                    input_receipt = host_wm_input_record_pointer_button(input_receipt, 0, command.down)
                    evidence_phase = if allow_evidence_close:
                        "applied"
                    else:
                        "rejected"
                elif command.action == "snapshot":
                    evidence_phase = "snapshot-only"
                    evidence_capture_requested = true
                if command.action != "snapshot":
                    other_dirty = true
        if other_dirty or warmup_frames < 12:
            if not comp.render_frame_engine2d(raster):
                if live_proof or evidence.enabled:
                    print "[hosted-wm] draw-ir-rejected evidence=fail-closed"
                    running = false
                    continue
                print "[hosted-wm] draw-ir-rejected retry=compatibility"
                comp.render_frame()
            if (not raster.window_present_enabled() and
                not hosted_winit_present_pure_simple_pixels(presenter, comp.pure_simple_pixel_buffer(), comp.width, comp.height)):
                print "ERROR: hosted WM live pure-Simple frame presentation failed"
                running = false
                continue
            val present_completed_us = rt_time_now_micros()
            if input_receipt.event_id > presented_event_id:
                presented_event_id = input_receipt.event_id
                presented_mutation_revision = input_receipt.mutation_revision
                input_receipt = host_wm_input_record_presented(
                    input_receipt, present_completed_us,
                    presenter.present_count, comp.skipped_frame_count
                )
            if warmup_frames < 12:
                warmup_frames = warmup_frames + 1
                if warmup_frames == 12:
                    print "[hosted-wm] warmup-frames-presented count={warmup_frames}"
        elif motion_dirty:
            if not comp.render_background_only(motion_due):
                if not comp.render_frame_engine2d(raster):
                    if live_proof or evidence.enabled:
                        print "[hosted-wm] draw-ir-rejected evidence=fail-closed"
                        running = false
                        continue
                    print "[hosted-wm] draw-ir-rejected retry=compatibility"
                    comp.render_frame()
            if (not raster.window_present_enabled() and
                not hosted_winit_present_pure_simple_pixels(presenter, comp.pure_simple_pixel_buffer(), comp.width, comp.height)):
                print "ERROR: hosted WM motion pure-Simple frame presentation failed"
                running = false
                continue
        elif raster.window_present_enabled():
            if not raster.represent_retained_window():
                print "ERROR: hosted WM retained Vulkan frame presentation failed"
                running = false
                continue

        if evidence.enabled and evidence_nonce > 0 and (other_dirty or evidence_capture_requested):
            val evidence_pixels = comp.pure_simple_pixel_buffer()
            val evidence_backend = HostedWinitBufferBackend.implementation_name()
            val evidence_readback = if evidence_pixels.len() == comp.width * comp.height: "presented-pixel-buffer" else: "unavailable"
            val snapshot = host_wm_evidence_snapshot(
                comp.evidence_compositor_json(), surface, evidence_backend, false, evidence_readback,
                raster.last_backend, raster.last_readback_source, raster.last_backend_handle,
                raster.last_readback_checksum, raster.last_composition_id,
                raster.last_scene_key, raster.last_web_content_image_count,
                raster.last_readback_completed, raster.last_readback_width,
                raster.last_readback_height, raster.last_readback_stride,
                raster.last_readback_format,
                presented_event_id,
                presented_mutation_revision, evidence_nonce, evidence_phase,
                host_wm_input_receipt_json(input_receipt)
            )
            if not host_wm_evidence_write_snapshot(evidence.snapshot_path, snapshot) or not host_wm_evidence_write_capture(evidence.capture_path, comp.width, comp.height, evidence_pixels):
                print "ERROR: hosted WM evidence write failed nonce={evidence_nonce}"
                running = false
            else:
                print "[hosted-wm] evidence-ack nonce={evidence_nonce} phase={evidence_phase} surface_phase={surface.phase} revision={comp.render_revision} semantic_event_id={presented_event_id} mutation_revision={presented_mutation_revision} {raster.frame_provenance()} {raster.font_provenance()}"
    var shared_hsts_closed = true
    if browser_renderers.hsts_dirty():
        if browser_profile == nil:
            shared_hsts_closed = false
        else:
            var profile = browser_profile.unwrap()
            val final_wall_clock_ms = rt_time_now_unix_micros() / 1000
            match profile.save_hsts(
                browser_renderers.hsts_snapshot(
                    final_wall_clock_ms
                ),
                final_wall_clock_ms
            ):
                Ok(_):
                    browser_renderers.mark_hsts_saved()
                Err(error):
                    shared_hsts_closed = false
                    print "ERROR: hosted browser HSTS final save failed reason={error.message()}"
            browser_profile = Some(profile)
    val profile_closed = web_sessions.close()
    val secondary_renderers_closed = browser_renderers.close()
    val browser_close = _close_hosted_browser_resources(
        browser_renderer, browser_raster,
        browser_raster_active, browser_profile
    )
    raster.shutdown()
    rt_winit_window_free(win)
    rt_winit_event_loop_free(el)
    if (not profile_closed or not secondary_renderers_closed or
        not browser_close.ok or
        not shared_hsts_closed or
        browser_resource_close_failed):
        print "ERROR: hosted browser profile close failed reason={web_sessions.profile_failure_reason}"
        return 1
    print "SimpleOS shared hosted WM closed"
    return 0
