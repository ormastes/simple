extern fn rt_sleep_ms(milliseconds: i64)
extern fn rt_time_now_monotonic_ms() -> i64
extern fn rt_text_to_bytes(value: text) -> [u8]
extern fn rt_browser_http_job_start_public_limited(
    scheme: text,
    host: text,
    port: i64,
    request: [u8],
    timeout_ms: i64,
    max_response_bytes: i64
) -> i64
extern fn rt_browser_http_job_poll(handle: i64) -> i64
extern fn rt_browser_http_job_take_response(handle: i64) -> [u8]
extern fn rt_browser_http_job_take_error(handle: i64) -> text
extern fn rt_browser_http_job_cancel(handle: i64) -> bool
extern fn rt_browser_http_job_free(handle: i64) -> bool

fn _hosted_browser_canonical_history_url(raw: text) -> text:
    if hosted_browser_canonical_navigation_url(raw) != raw:
        return ""
    raw

fn _hosted_browser_csp_directive(kind: text) -> text:
    if kind == "fetch":
        return "connect-src"
    if kind == "image":
        return "img-src"
    if kind == "style":
        return "style-src"
    if kind == "script" or kind == "module" or kind == "wasm":
        return "script-src"
    ""

fn _hosted_browser_policy_reject(reason: text) -> HostedBrowserRequestPolicy:
    HostedBrowserRequestPolicy(
        ok: false,
        reason: reason,
        mode: RequestMode.SameOrigin,
        credentials: "omit",
        canonical_url: "",
        sanitized_headers: "",
        consumes_navigation: false
    )

pub struct HostedBrowserRendererResult:
    ok: bool
    reason: text
    next_animation_ms: i64
    producer_generation: i64
    composition_revision: i64
    composition: DrawIrComposition
    image_resources: [SimpleOsHostGpuImageResource]
    cpu_composited_count: i32
    cpu_composited_sha256: text
    solid_material_count: i32
    solid_material_sha256: text
    diagnostics: text
    damage_receipt: BrowserRendererDamageReceipt

struct HostedBrowserNetworkResult:
    status: i32
    headers: text
    body: text
    error: text

fn _network_result(
    status: i32, headers: text, body: text, error: text
) -> HostedBrowserNetworkResult:
    HostedBrowserNetworkResult(
        status: status,
        headers: headers,
        body: body,
        error: error
    )

fn _renderer_binary_hex(data: [u8]) -> text:
    var out = RtStringBuilder.new()
    for byte in data:
        val piece = byte.to_i64().to_hex()
        out.push(if piece.len() == 1: "0{piece}" else: piece)
    out.finish()

pub fn hosted_browser_network_response_limit_reason(
    kind: text, headers: text, body: [u8]
) -> text:
    if rt_text_to_bytes(headers).len() > (
        BROWSER_RENDERER_MAX_NETWORK_HEADERS_BYTES
    ):
        return "renderer-network-headers-too-large"
    val body_limit = if kind == "wasm" or kind == "image":
        BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES / 2
    else:
        BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES
    if body.len() > body_limit:
        return "renderer-network-body-too-large"
    ""

fn _empty_composition() -> DrawIrComposition:
    draw_ir_composition("", "", "", [])

fn _renderer_result(ok: bool, reason: text, composition: DrawIrComposition) -> HostedBrowserRendererResult:
    HostedBrowserRendererResult(
        ok: ok,
        reason: reason,
        next_animation_ms: -1,
        producer_generation: -1,
        composition_revision: -1,
        composition: composition,
        image_resources: [],
        cpu_composited_count: 0,
        cpu_composited_sha256: "",
        solid_material_count: 0,
        solid_material_sha256: "",
        diagnostics: "",
        damage_receipt: browser_renderer_damage_receipt(DAMAGE_PLAN_FULL, [])
    )

fn _renderer_frame_result(
    composition: DrawIrComposition,
    image_resources: [SimpleOsHostGpuImageResource],
    next_animation_ms: i64,
    producer_generation: i64,
    composition_revision: i64,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text,
    diagnostics: text,
    damage_receipt: BrowserRendererDamageReceipt
) -> HostedBrowserRendererResult:
    HostedBrowserRendererResult(
        ok: true,
        reason: "ok",
        next_animation_ms: next_animation_ms,
        producer_generation: producer_generation,
        composition_revision: composition_revision,
        composition: composition,
        image_resources: image_resources,
        cpu_composited_count: cpu_composited_count,
        cpu_composited_sha256: cpu_composited_sha256,
        solid_material_count: solid_material_count,
        solid_material_sha256: solid_material_sha256,
        diagnostics: diagnostics,
        damage_receipt: damage_receipt
    )

fn _deadline_ms(timeout_ms: i64) -> i64:
    rt_time_now_monotonic_ms() + (
        if timeout_ms > 0: timeout_ms else: 2000
    )

val BROWSER_RENDERER_MAX_DEFERRED_COMMANDS: i32 = 64
pub val HOSTED_BROWSER_SITE_SWAP_REQUIRED: text = "site-swap-required"

fn browser_renderer_command_capability_new() -> Result<text, text>:
    # random_hex fails CLOSED (nil) when the CSPRNG is unavailable; the `?? ""`
    # here is the explicit conversion to a value the validity check rejects, so
    # entropy failure still routes to Err rather than minting a usable-looking
    # capability. Do not "simplify" this into an unchecked default.
    val capability = crypto_sffi.random_hex(16) ?? ""
    if not browser_renderer_command_capability_valid(capability):
        return Err("renderer-command-entropy-unavailable")
    Ok(capability)

fn _hosted_browser_schemeful_site(url: text) -> text:
    val parsed = Url.parse(url)
    if not parsed.?:
        return ""
    schemeful_site_key(Origin.from_url(parsed!))

struct _HostedBrowserDeferredCommand:
    kind: text
    payload: text
    operation: text
    timeout_ms: i64
    resize_width: i32
    resize_height: i32

struct _HostedBrowserHistoryAuthority:
    capability: text
    generation: i64
    root_request_id: i64
    reply_request_id: i64
    origin: text
    csp_policy: text
    csp_ready: bool
    sandbox_scripts: bool

fn _empty_history_authority() -> _HostedBrowserHistoryAuthority:
    _HostedBrowserHistoryAuthority(
        capability: "",
        generation: 0,
        root_request_id: 0,
        reply_request_id: 0,
        origin: "",
        csp_policy: "",
        csp_ready: false,
        sandbox_scripts: false
    )

struct _HostedBrowserPreparedCommand:
    wire: text
    capability: text
    root_command_request_id: i64
    wire_request_id: i64
    history_authority: _HostedBrowserHistoryAuthority

struct _HostedBrowserHistoryCandidate:
    ok: bool
    reason: text
    document_url: text
    document_origin: text
    document_csp_policy: text
    document_csp_ready: bool
    urls: [text]
    csp_policies: [text]
    csp_ready: [bool]
    index: i64

pub class HostedBrowserRendererProcess:
    pid: i64
    generation: i64
    width: i32
    height: i32
    next_request_id: i64
    expected_reply_to_request_id: i64
    command_deadline_ms: i64
    pending_operation: text
    hang_acknowledged: bool
    next_animation_ms: i64
    pending_resize_width: i32
    pending_resize_height: i32
    decoder: BrowserRendererCapabilityDecoder
    network: FetchEngine
    network_job_handle: i64
    network_job_fetch: BrowserRendererNetworkDecodeResult?
    network_job_policy: HostedBrowserRequestPolicy?
    network_job_request: FetchRequest?
    network_job_phase: text
    network_job_actual_request: FetchRequest?
    network_job_redirect_count: i64
    pending_wire: text
    pending_wire_offset: i64
    pending_wire_reply_to_request_id: i64
    pending_wire_is_command: bool
    staged_command_capability: text
    staged_root_command_request_id: i64
    staged_wire_request_id: i64
    staged_history_authority: _HostedBrowserHistoryAuthority
    issued_command_capability: text
    issued_root_command_request_id: i64
    issued_wire_request_id: i64
    issued_history_authority: _HostedBrowserHistoryAuthority
    admitted_history_authority: _HostedBrowserHistoryAuthority
    active_command_capability: text
    active_root_command_request_id: i64
    stop_after_write: bool
    deferred_commands: [_HostedBrowserDeferredCommand]
    pending_scroll_event_id: i64
    pending_scroll_delta_milli_y: i64
    pointer_pressed: bool
    pending_pointer_cancel_event_id: i64
    document_url: text
    document_origin: text
    site_lock: text
    site_swap_pending: bool
    site_swap_site: text
    navigation_permit: HostedBrowserNavigationPermit
    history_urls: [text]
    history_csp_policies: [text]
    history_csp_ready: [bool]
    history_index: i64
    pending_history_index: i64
    pending_history_target_url: text
    history_current_url: text
    history_back_url: text
    history_forward_url: text
    document_title: text
    document_title_url: text
    document_title_generation: i64
    document_title_reply_to_request_id: i64
    home_url: text
    pending_history_action: text
    pending_document_commit_url: text
    provisional_document_origin: text
    document_csp_policy: text
    document_csp_ready: bool
    pending_document_csp_policy: text
    pending_document_csp_ready: bool
    hsts: BrowserSession
    hsts_dirty: bool
    retained_image_resources: [SimpleOsHostGpuImageResource]
    requires_theme_handshake: bool
    theme_revision: i64
    theme_wire_text: text
    state: text

    static fn create(
        generation: i64,
        width: i32,
        height: i32
    ) -> HostedBrowserRendererProcess:
        HostedBrowserRendererProcess._create(
            generation, width, height, false, 0, ""
        )

    static fn create_with_theme(
        generation: i64,
        width: i32,
        height: i32,
        theme_revision: i64,
        theme_wire_text: text
    ) -> HostedBrowserRendererProcess:
        HostedBrowserRendererProcess._create(
            generation,
            width,
            height,
            true,
            theme_revision,
            theme_wire_text
        )

    static fn _create(
        generation: i64,
        width: i32,
        height: i32,
        requires_theme_handshake: bool,
        theme_revision: i64,
        theme_wire_text: text
    ) -> HostedBrowserRendererProcess:
        HostedBrowserRendererProcess(
            pid: 0,
            generation: generation,
            width: width,
            height: height,
            next_request_id: 2,
            expected_reply_to_request_id: 0,
            command_deadline_ms: 0,
            pending_operation: "",
            hang_acknowledged: false,
            next_animation_ms: -1,
            pending_resize_width: 0,
            pending_resize_height: 0,
            decoder: browser_renderer_capability_decoder_new(generation),
            network: FetchEngine.new(
                Logger.new("browser-renderer-broker", LogLevel.Error)
            ),
            network_job_handle: 0,
            network_job_fetch: nil,
            network_job_policy: nil,
            network_job_request: nil,
            network_job_phase: "",
            network_job_actual_request: nil,
            network_job_redirect_count: 0,
            pending_wire: "",
            pending_wire_offset: 0,
            pending_wire_reply_to_request_id: 0,
            pending_wire_is_command: false,
            staged_command_capability: "",
            staged_root_command_request_id: 0,
            staged_wire_request_id: 0,
            staged_history_authority: _empty_history_authority(),
            issued_command_capability: "",
            issued_root_command_request_id: 0,
            issued_wire_request_id: 0,
            issued_history_authority: _empty_history_authority(),
            admitted_history_authority: _empty_history_authority(),
            active_command_capability: "",
            active_root_command_request_id: 0,
            stop_after_write: false,
            deferred_commands: [],
            pending_scroll_event_id: 0,
            pending_scroll_delta_milli_y: 0,
            pointer_pressed: false,
            pending_pointer_cancel_event_id: 0,
            document_url: "",
            document_origin: "",
            site_lock: "",
            site_swap_pending: false,
            site_swap_site: "",
            navigation_permit: hosted_browser_empty_navigation_permit(),
            history_urls: [],
            history_csp_policies: [],
            history_csp_ready: [],
            history_index: -1,
            pending_history_index: -1,
            pending_history_target_url: "",
            history_current_url: "",
            history_back_url: "",
            history_forward_url: "",
            document_title: "",
            document_title_url: "",
            document_title_generation: 0,
            document_title_reply_to_request_id: 0,
            home_url: "",
            pending_history_action: "",
            pending_document_commit_url: "",
            provisional_document_origin: "",
            document_csp_policy: "",
            document_csp_ready: false,
            pending_document_csp_policy: "",
            pending_document_csp_ready: false,
            hsts: BrowserSession.new_without_runtime(),
            hsts_dirty: false,
            retained_image_resources: [],
            requires_theme_handshake: requires_theme_handshake,
            theme_revision: theme_revision,
            theme_wire_text: theme_wire_text,
            state: "new"
        )

    me load_hsts_snapshot(
        snapshot: BrowserHstsSnapshot, wall_clock_ms: i64
    ) -> i32:
        val _ = self.hsts.advance_time(rt_time_now_monotonic_ms())
        self.hsts_dirty = false
        self.hsts.load_hsts_snapshot(snapshot, wall_clock_ms)

    me _retire_renderer_command_capability():
        self.staged_command_capability = ""
        self.staged_root_command_request_id = 0
        self.staged_wire_request_id = 0
        self.staged_history_authority = _empty_history_authority()
        self.issued_command_capability = ""
        self.issued_root_command_request_id = 0
        self.issued_wire_request_id = 0
        self.issued_history_authority = _empty_history_authority()
        self.admitted_history_authority = _empty_history_authority()
        self.active_command_capability = ""
        self.active_root_command_request_id = 0

    me _require_issued_renderer_reply(
        message: BrowserRendererCapabilityMessage,
        reply_to_request_id: i64
    ) -> Result<bool, text>:
        if message.generation != self.generation:
            return Err("stale-generation")
        if (self.issued_command_capability == "" or
            message.command_capability != self.issued_command_capability or
            message.root_command_request_id !=
                self.issued_root_command_request_id):
            return Err("unissued-renderer-reply")
        if (reply_to_request_id != self.issued_wire_request_id or
            self.issued_wire_request_id <= 0):
            return Err("wrong-renderer-wire")
        self.admitted_history_authority = self.issued_history_authority
        self.issued_command_capability = ""
        self.issued_root_command_request_id = 0
        self.issued_wire_request_id = 0
        self.issued_history_authority = _empty_history_authority()
        Ok(true)

    me _admit_renderer_reply(
        message: BrowserRendererCapabilityMessage,
        reply_to_request_id: i64,
        future_reason: text
    ) -> Result<text, text>:
        match self._poll_renderer_reply(
            reply_to_request_id, future_reason
        ):
            Err(reason): return Err(reason)
            Ok(current):
                if not current:
                    return Ok("stale")
        match self._require_issued_renderer_reply(
            message, reply_to_request_id
        ):
            Err(reason): Err(reason)
            Ok(_): Ok("current")

    me hsts_snapshot(wall_clock_ms: i64) -> BrowserHstsSnapshot:
        val _ = self.hsts.advance_time(rt_time_now_monotonic_ms())
        self.hsts.hsts_snapshot(wall_clock_ms)

    me _hsts_upgrade_url(url: text) -> text:
        val _ = self.hsts.advance_time(rt_time_now_monotonic_ms())
        self.hsts._hsts_upgrade_url(url)

    me _commit_validated_https_hsts(
        response_url: text, response_headers: text
    ) -> bool:
        val header = hosted_browser_response_header_value(
            response_headers, "strict-transport-security"
        )
        if header == "":
            return false
        val _ = self.hsts.advance_time(rt_time_now_monotonic_ms())
        if not self.hsts._apply_hsts_header(header, response_url):
            return false
        self.hsts_dirty = true
        true

    me _document_site_swap_required(url: text) -> bool:
        val site = _hosted_browser_schemeful_site(url)
        if site == "":
            self._retire_renderer_site_swap()
            self.site_swap_pending = true
            self.site_swap_site = ""
            return true
        if self.site_lock == "":
            self.site_lock = site
            return false
        if site == self.site_lock:
            return false
        self._retire_renderer_site_swap()
        self.site_swap_pending = true
        self.site_swap_site = site
        true

    me _retire_renderer_site_swap():
        self._retire_renderer_command_capability()
        self.pending_wire = ""
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = 0
        self.pending_wire_is_command = false
        self.deferred_commands = []
        self.command_deadline_ms = 0
        self.pending_operation = ""
        self.network_job_handle = 0
        self.network_job_fetch = nil
        self.network_job_policy = nil
        self.network_job_request = nil
        self.network_job_phase = ""
        self.network_job_actual_request = nil
        self.network_job_redirect_count = 0
        self.retained_image_resources = []

    me _validated_navigation_permit(
        url: text,
        method: text,
        headers: text,
        body: text,
        content_type: text
    ) -> HostedBrowserNavigationPermit?:
        val canonical_url = hosted_browser_canonical_navigation_url(
            self._hsts_upgrade_url(url)
        )
        val canonical_method = method.to_upper()
        if (canonical_url == "" or
            (canonical_method != "GET" and canonical_method != "POST") or
            rt_text_to_bytes(body).len() > 524288):
            return nil
        val sanitized_headers = match hosted_browser_sanitize_fetch_headers(
            headers, content_type
        ):
            Err(_):
                return nil
            Ok(value):
                value
        Some(HostedBrowserNavigationPermit(
            active: true,
            url: canonical_url,
            method: canonical_method,
            headers: sanitized_headers,
            body: body,
            content_type: content_type,
            redirect_count: 0
        ))

    me authorize_navigation(
        url: text,
        method: text,
        headers: text,
        body: text,
        content_type: text
    ) -> bool:
        match self._validated_navigation_permit(
            url, method, headers, body, content_type
        ):
            nil:
                self.navigation_permit = (
                    hosted_browser_empty_navigation_permit()
                )
                self.pending_history_action = ""
                self.pending_document_commit_url = ""
                self.provisional_document_origin = ""
                self._clear_pending_document_csp()
                return false
            Some(permit):
                self.navigation_permit = permit
        self.pending_history_action = "push"
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        self._clear_pending_document_csp()
        true

    me _clear_pending_document_csp():
        self.pending_document_csp_policy = ""
        self.pending_document_csp_ready = false

    me _clear_document_title():
        self.document_title = ""
        self.document_title_url = ""
        self.document_title_generation = 0
        self.document_title_reply_to_request_id = 0

    fn bookmark_stored_title() -> text:
        if (self.document_title_generation != self.generation or
            self.document_title_reply_to_request_id !=
                self.expected_reply_to_request_id or
            self.document_title_url != self.document_url):
            return ""
        self.document_title

    fn _active_document_csp_policy() -> text:
        if self.provisional_document_origin != "":
            return self.pending_document_csp_policy
        self.document_csp_policy

    fn _active_document_csp_ready() -> bool:
        if self.provisional_document_origin != "":
            return self.pending_document_csp_ready
        self.document_csp_ready

    fn _active_document_csp_valid() -> bool:
        self._active_document_csp_ready() and
            browser_csp_policy_valid(self._active_document_csp_policy())

    fn _history_authority(
        capability: text,
        root_request_id: i64,
        reply_request_id: i64
    ) -> _HostedBrowserHistoryAuthority:
        val csp_policy = self._active_document_csp_policy()
        val sandbox = browser_csp_header_sandbox(csp_policy)
        _HostedBrowserHistoryAuthority(
            capability: capability,
            generation: self.generation,
            root_request_id: root_request_id,
            reply_request_id: reply_request_id,
            origin: hosted_browser_network_origin(
                self._active_renderer_document_url()
            ),
            csp_policy: csp_policy,
            csp_ready: self._active_document_csp_ready(),
            sandbox_scripts: (
                not sandbox.active or sandbox.allow_scripts
            )
        )

    me authorize_renderer_navigation(
        request: BrowserRendererNetworkDecodeResult
    ) -> bool:
        if (self.navigation_permit.active or request.kind != "document" or
            request.credentials != "include" or
            self._requester_origin() == "" or
            not self._active_document_csp_valid()):
            return false
        val sandbox = browser_csp_header_sandbox(
            self._active_document_csp_policy()
        )
        if (sandbox.active and
            (not sandbox.allow_forms or
                not sandbox.allow_top_navigation)):
            return false
        val method = request.method.to_upper()
        if method == "GET":
            if (request.body != "" or request.content_type != ""):
                return false
        elif method == "POST":
            if request.content_type != "application/x-www-form-urlencoded":
                return false
        else:
            return false
        val expected_headers = match hosted_browser_sanitize_fetch_headers(
            "", request.content_type
        ):
            Err(_):
                return false
            Ok(value):
                value
        val actual_headers = match hosted_browser_sanitize_fetch_headers(
            request.headers, request.content_type
        ):
            Err(_):
                return false
            Ok(value):
                value
        if actual_headers != expected_headers:
            return false
        val form_action_policy = self._active_document_csp_policy()
        val form_action_document_url = self._active_renderer_document_url()
        if not browser_csp_form_action_allows(
            form_action_policy, form_action_document_url, request.url
        ):
            return false
        if not self.authorize_navigation(
            request.url, method, "", request.body, request.content_type
        ):
            return false
        self.navigation_permit.form_action_policy = form_action_policy
        self.navigation_permit.form_action_document_url = (
            form_action_document_url
        )
        true

    me set_home_url(url: text) -> bool:
        val canonical_url = hosted_browser_canonical_navigation_url(url)
        if canonical_url == "":
            return false
        self.home_url = canonical_url
        true

    me _commit_document_url(url: text):
        self.document_url = url
        self.document_origin = hosted_browser_network_origin(url)
        self.provisional_document_origin = ""
        self.document_csp_policy = self.pending_document_csp_policy
        self.document_csp_ready = self.pending_document_csp_ready
        self.pending_document_csp_policy = ""
        self.pending_document_csp_ready = false
        if self.pending_history_action == "push":
            var next_history: [text] = []
            var next_csp: [text] = []
            var next_csp_ready: [bool] = []
            var index: i64 = 0
            while (index <= self.history_index and
                index < self.history_urls.len()):
                next_history.push(self.history_urls[index])
                if (index < self.history_csp_policies.len() and
                    index < self.history_csp_ready.len()):
                    next_csp.push(self.history_csp_policies[index])
                    next_csp_ready.push(self.history_csp_ready[index])
                else:
                    next_csp.push("")
                    next_csp_ready.push(false)
                index = index + 1
            next_history.push(url)
            next_csp.push(self.document_csp_policy)
            next_csp_ready.push(self.document_csp_ready)
            if next_history.len() > 64:
                var bounded: [text] = []
                var bounded_csp: [text] = []
                var bounded_csp_ready: [bool] = []
                index = next_history.len() - 64
                while index < next_history.len():
                    bounded.push(next_history[index])
                    bounded_csp.push(next_csp[index])
                    bounded_csp_ready.push(next_csp_ready[index])
                    index = index + 1
                next_history = bounded
                next_csp = bounded_csp
                next_csp_ready = bounded_csp_ready
            self.history_urls = next_history
            self.history_csp_policies = next_csp
            self.history_csp_ready = next_csp_ready
            self.history_index = self.history_urls.len() - 1
        elif (self.pending_history_action == "replace" and
            self.history_index >= 0 and
            self.history_index < self.history_urls.len()):
            while self.history_csp_policies.len() < self.history_urls.len():
                self.history_csp_policies.push("")
                self.history_csp_ready.push(false)
            self.history_urls[self.history_index] = url
            self.history_csp_policies[self.history_index] = (
                self.document_csp_policy
            )
            self.history_csp_ready[self.history_index] = (
                self.document_csp_ready
            )
        self.pending_history_action = ""
        self._sync_history_neighbors_from_ledger()

    me _sync_history_neighbors_from_ledger():
        self.history_current_url = self.document_url
        self.history_back_url = ""
        self.history_forward_url = ""
        if self.history_index > 0:
            self.history_back_url = self.history_urls[self.history_index - 1]
        if (self.history_index >= 0 and
            self.history_index < self.history_urls.len() - 1):
            self.history_forward_url = self.history_urls[self.history_index + 1]

    fn _history_snapshot_for_command(
        capability: text
    ) -> Result<text, text>:
        if (self.history_index < 0 or
            self.history_index >= self.history_urls.len() or
            not browser_renderer_command_capability_valid(capability)):
            return Err("history-snapshot-unavailable")
        var urls = self._copy_history_texts(self.history_urls)
        if self.pending_history_index >= 0:
            if (self.pending_history_index >= urls.len() or
                self.pending_history_target_url == ""):
                return Err("history-snapshot-unavailable")
            urls[self.pending_history_index] = (
                self.pending_history_target_url
            )
        self._history_snapshot_for_urls(capability, urls)

    fn _history_snapshot_for_urls(
        capability: text, urls: [text]
    ) -> Result<text, text>:
        if (self.history_index < 0 or
            self.history_index >= urls.len() or
            not browser_renderer_command_capability_valid(capability)):
            return Err("history-snapshot-unavailable")
        browser_renderer_history_proposal_encode(
            "N",
            "O",
            "",
            urls[self.history_index],
            capability,
            self.history_index,
            urls
        )

    fn _history_urls_with_traversal(
        target_index: i64, target_url: text
    ) -> Result<[text], text>:
        if (target_index < 0 or
            target_index >= self.history_urls.len() or
            _hosted_browser_canonical_history_url(target_url) != target_url):
            return Err("history-traversal-unavailable")
        var urls = self._copy_history_texts(self.history_urls)
        urls[target_index] = target_url
        Ok(urls)

    fn _history_back_index(url: text) -> i64:
        var index = self.history_index
        if (index >= 0 and index < self.history_urls.len() and
            self.history_urls[index] == self.history_current_url):
            index = index - 1
        while index >= 0:
            if self.history_urls[index] == url:
                return index
            index = index - 1
        -1

    fn _history_forward_index(url: text) -> i64:
        var index = self.history_index
        if index < 0:
            index = 0
        elif (index < self.history_urls.len() and
            self.history_urls[index] == self.history_current_url):
            index = index + 1
        while index < self.history_urls.len():
            if self.history_urls[index] == url:
                return index
            index = index + 1
        -1

    fn _history_urls_match(left: [text], right: [text]) -> bool:
        if left.len() != right.len():
            return false
        var index = 0
        while index < left.len():
            if left[index] != right[index]:
                return false
            index = index + 1
        true

    fn _copy_history_texts(values: [text]) -> [text]:
        var copied: [text] = []
        for value in values:
            copied.push(value)
        copied

    fn _copy_history_flags(values: [bool]) -> [bool]:
        var copied: [bool] = []
        for value in values:
            copied.push(value)
        copied

    fn _history_candidate_reject(
        reason: text
    ) -> _HostedBrowserHistoryCandidate:
        _HostedBrowserHistoryCandidate(
            ok: false,
            reason: reason,
            document_url: "",
            document_origin: "",
            document_csp_policy: "",
            document_csp_ready: false,
            urls: [],
            csp_policies: [],
            csp_ready: [],
            index: -1
        )

    fn _stage_history_candidate() -> _HostedBrowserHistoryCandidate:
        val initial_document = (
            self.history_urls.len() == 0 and
            self.history_index == -1 and
            self.pending_document_commit_url != "" and
            self.pending_history_action == "push"
        )
        if (not initial_document and
            (self.history_index < 0 or
                self.history_index >= self.history_urls.len())):
            return self._history_candidate_reject(
                "history-state-unavailable"
            )
        var urls = self._copy_history_texts(self.history_urls)
        var policies = self._copy_history_texts(
            self.history_csp_policies
        )
        var ready = self._copy_history_flags(self.history_csp_ready)
        while policies.len() < urls.len():
            policies.push("")
        while ready.len() < urls.len():
            ready.push(false)
        var index = self.history_index
        var document_url = self.document_url
        var document_policy = self.document_csp_policy
        var document_ready = self.document_csp_ready
        if self.pending_history_index >= 0:
            if self.pending_history_index >= urls.len():
                return self._history_candidate_reject(
                    "history-index-out-of-range"
                )
            index = self.pending_history_index
            if self.pending_history_target_url == "":
                return self._history_candidate_reject(
                    "history-target-unavailable"
                )
            urls[index] = self.pending_history_target_url
            document_url = self.pending_history_target_url
            if self.pending_document_commit_url != "":
                urls[index] = self.pending_document_commit_url
                policies[index] = self.pending_document_csp_policy
                ready[index] = self.pending_document_csp_ready
            document_url = urls[index]
            document_policy = policies[index]
            document_ready = ready[index]
        elif self.pending_document_commit_url != "":
            document_url = self.pending_document_commit_url
            document_policy = self.pending_document_csp_policy
            document_ready = self.pending_document_csp_ready
            if self.pending_history_action == "push":
                var pushed_urls: [text] = []
                var pushed_policies: [text] = []
                var pushed_ready: [bool] = []
                var copy_index: i64 = 0
                while copy_index <= index and copy_index < urls.len():
                    pushed_urls.push(urls[copy_index])
                    pushed_policies.push(policies[copy_index])
                    pushed_ready.push(ready[copy_index])
                    copy_index = copy_index + 1
                pushed_urls.push(document_url)
                pushed_policies.push(document_policy)
                pushed_ready.push(document_ready)
                if pushed_urls.len() > 64:
                    var bounded_urls: [text] = []
                    var bounded_policies: [text] = []
                    var bounded_ready: [bool] = []
                    copy_index = pushed_urls.len() - 64
                    while copy_index < pushed_urls.len():
                        bounded_urls.push(pushed_urls[copy_index])
                        bounded_policies.push(
                            pushed_policies[copy_index]
                        )
                        bounded_ready.push(pushed_ready[copy_index])
                        copy_index = copy_index + 1
                    pushed_urls = bounded_urls
                    pushed_policies = bounded_policies
                    pushed_ready = bounded_ready
                urls = pushed_urls
                policies = pushed_policies
                ready = pushed_ready
                index = urls.len() - 1
            elif self.pending_history_action == "replace":
                urls[index] = document_url
                policies[index] = document_policy
                ready[index] = document_ready
            elif self.pending_history_action != "":
                return self._history_candidate_reject(
                    "invalid-pending-history-action"
                )
        _HostedBrowserHistoryCandidate(
            ok: true,
            reason: "ok",
            document_url: document_url,
            document_origin: hosted_browser_network_origin(document_url),
            document_csp_policy: document_policy,
            document_csp_ready: document_ready,
            urls: urls,
            csp_policies: policies,
            csp_ready: ready,
            index: index
        )

    fn _history_authority_valid(
        candidate: _HostedBrowserHistoryCandidate,
        proposal: BrowserRendererHistoryProposal,
        producer_generation: i64,
        reply_to_request_id: i64
    ) -> bool:
        val authority = self.admitted_history_authority
        val sandbox = browser_csp_header_sandbox(
            candidate.document_csp_policy
        )
        val scripts_allowed = (
            not sandbox.active or sandbox.allow_scripts
        )
        (proposal.ok and
            producer_generation == self.generation and
            authority.capability != "" and
            proposal.authority_capability == authority.capability and
            authority.generation == producer_generation and
            authority.root_request_id > 0 and
            authority.reply_request_id == reply_to_request_id and
            reply_to_request_id == self.expected_reply_to_request_id and
            authority.origin == candidate.document_origin and
            authority.csp_ready and candidate.document_csp_ready and
            authority.csp_policy == candidate.document_csp_policy and
            browser_csp_policy_valid(candidate.document_csp_policy) and
            authority.sandbox_scripts == scripts_allowed and
            ((proposal.action != "P" and proposal.action != "R") or
                scripts_allowed))

    fn _history_candidate_with_proposal(
        candidate: _HostedBrowserHistoryCandidate,
        proposal: BrowserRendererHistoryProposal,
        producer_generation: i64,
        reply_to_request_id: i64
    ) -> _HostedBrowserHistoryCandidate:
        if (not candidate.ok or not self._history_authority_valid(
                candidate, proposal, producer_generation,
                reply_to_request_id
            )):
            return self._history_candidate_reject(
                "invalid-history-authority"
            )
        if (candidate.index < 0 or
            candidate.index >= candidate.urls.len()):
            return self._history_candidate_reject(
                "history-index-out-of-range"
            )
        for url in proposal.urls:
            if _hosted_browser_canonical_history_url(url) != url:
                return self._history_candidate_reject(
                    "invalid-history-url"
                )
        var expected_url = candidate.document_url
        if proposal.action == "P" or proposal.action == "R":
            if proposal.url_kind == "N":
                expected_url = browser_history_resolve_url(
                    candidate.document_url, "null"
                )
            elif proposal.url_kind == "V":
                expected_url = browser_history_resolve_url(
                    candidate.document_url, proposal.raw_url
                )
            if (_hosted_browser_canonical_history_url(expected_url) !=
                    expected_url or
                hosted_browser_network_origin(expected_url) !=
                    candidate.document_origin):
                return self._history_candidate_reject(
                    "history-origin-mismatch"
                )
        elif proposal.action == "T":
            if (self.pending_history_index < 0 or
                proposal.current_index != candidate.index):
                return self._history_candidate_reject(
                    "history-traversal-mismatch"
                )
        else:
            return self._history_candidate_reject(
                "invalid-history-action"
            )
        if proposal.resolved_url != expected_url:
            return self._history_candidate_reject(
                "history-url-mismatch"
            )
        var expected_urls = candidate.urls
        var expected_policies = candidate.csp_policies
        var expected_ready = candidate.csp_ready
        var expected_index = candidate.index
        if proposal.action == "P":
            var pushed_urls: [text] = []
            var pushed_policies: [text] = []
            var pushed_ready: [bool] = []
            var index: i64 = 0
            while index <= candidate.index:
                pushed_urls.push(candidate.urls[index])
                pushed_policies.push(candidate.csp_policies[index])
                pushed_ready.push(candidate.csp_ready[index])
                index = index + 1
            pushed_urls.push(expected_url)
            pushed_policies.push(candidate.document_csp_policy)
            pushed_ready.push(candidate.document_csp_ready)
            if pushed_urls.len() > 64:
                var bounded_urls: [text] = []
                var bounded_policies: [text] = []
                var bounded_ready: [bool] = []
                index = pushed_urls.len() - 64
                while index < pushed_urls.len():
                    bounded_urls.push(pushed_urls[index])
                    bounded_policies.push(pushed_policies[index])
                    bounded_ready.push(pushed_ready[index])
                    index = index + 1
                pushed_urls = bounded_urls
                pushed_policies = bounded_policies
                pushed_ready = bounded_ready
            expected_urls = pushed_urls
            expected_policies = pushed_policies
            expected_ready = pushed_ready
            expected_index = expected_urls.len() - 1
        elif proposal.action == "R":
            expected_urls[candidate.index] = expected_url
        if (proposal.current_index != expected_index or
            not self._history_urls_match(proposal.urls, expected_urls)):
            return self._history_candidate_reject(
                "history-ledger-mismatch"
            )
        _HostedBrowserHistoryCandidate(
            ok: true,
            reason: "ok",
            document_url: expected_url,
            document_origin: hosted_browser_network_origin(expected_url),
            document_csp_policy: candidate.document_csp_policy,
            document_csp_ready: candidate.document_csp_ready,
            urls: expected_urls,
            csp_policies: expected_policies,
            csp_ready: expected_ready,
            index: expected_index
        )

    me _commit_history_candidate(
        candidate: _HostedBrowserHistoryCandidate
    ):
        if not candidate.ok:
            return
        self.document_url = candidate.document_url
        self.document_origin = candidate.document_origin
        self.document_csp_policy = candidate.document_csp_policy
        self.document_csp_ready = candidate.document_csp_ready
        self.history_urls = candidate.urls
        self.history_csp_policies = candidate.csp_policies
        self.history_csp_ready = candidate.csp_ready
        self.history_index = candidate.index
        self.pending_history_action = ""
        self.pending_document_commit_url = ""
        self.pending_document_csp_policy = ""
        self.pending_document_csp_ready = false
        self.pending_history_index = -1
        self.pending_history_target_url = ""
        self.provisional_document_origin = ""
        self._sync_history_neighbors_from_ledger()

    me _restore_history_document(index: i64):
        self.document_url = self.history_urls[index]
        self.document_origin = hosted_browser_network_origin(
            self.document_url
        )
        self.document_csp_policy = ""
        self.document_csp_ready = false
        if (index < self.history_csp_policies.len() and
            index < self.history_csp_ready.len()):
            self.document_csp_policy = self.history_csp_policies[index]
            self.document_csp_ready = self.history_csp_ready[index]
        self.provisional_document_origin = ""
        self._sync_history_neighbors_from_ledger()

    me _stage_history_document_csp(index: i64):
        self.pending_document_csp_policy = ""
        self.pending_document_csp_ready = false
        if (index >= 0 and
            index < self.history_csp_policies.len() and
            index < self.history_csp_ready.len()):
            self.pending_document_csp_policy = (
                self.history_csp_policies[index]
            )
            self.pending_document_csp_ready = (
                self.history_csp_ready[index]
            )

    me _cancel_network_job():
        val handle = self.network_job_handle
        self.network_job_handle = 0
        self.network_job_fetch = nil
        self.network_job_policy = nil
        self.network_job_request = nil
        self.network_job_phase = ""
        self.network_job_actual_request = nil
        self.network_job_redirect_count = 0
        if handle > 0:
            val _ = rt_browser_http_job_cancel(handle)
            val _ = rt_browser_http_job_free(handle)

    fn _requester_origin() -> text:
        if self.provisional_document_origin != "":
            return self.provisional_document_origin
        self.document_origin

    fn _active_renderer_document_url() -> text:
        if self.pending_document_commit_url != "":
            return self.pending_document_commit_url
        if self.pending_history_target_url != "":
            return self.pending_history_target_url
        self.document_url

    fn _renderer_initiator_valid(
        fetch: BrowserRendererNetworkDecodeResult
    ) -> bool:
        val csp_ready = self._active_document_csp_ready()
        val sandbox = browser_csp_header_sandbox(
            self._active_document_csp_policy()
        )
        if (csp_ready and sandbox.active and
            (not sandbox.allow_scripts or
                not sandbox.allow_same_origin) and
            fetch.script_cookie_writes.len() > 0):
            return false
        if fetch.kind == "document" and self.navigation_permit.active:
            return (
                fetch.initiator_origin == "" or
                fetch.initiator_origin == "null" or
                fetch.initiator_origin == self._requester_origin()
            )
        if (csp_ready and sandbox.active and
            not sandbox.allow_same_origin):
            return (
                fetch.initiator_origin == "null" and
                fetch.credentials == "omit" and
                fetch.script_cookie_writes.len() == 0
            )
        if fetch.initiator_origin == "null":
            return (
                fetch.credentials == "omit" and
                fetch.script_cookie_writes.len() == 0
            )
        fetch.initiator_origin != "" and (
            fetch.initiator_origin == self._requester_origin()
        )

    fn _renderer_request_policy(
        fetch: BrowserRendererNetworkDecodeResult,
        effective_url: text
    ) -> HostedBrowserRequestPolicy:
        val csp_policy = self._active_document_csp_policy()
        val csp_ready = self._active_document_csp_ready()
        val sandbox = browser_csp_header_sandbox(csp_policy)
        val requester_origin = self._requester_origin()
        val policy_origin = if (
            csp_ready and sandbox.active and
            not sandbox.allow_same_origin
        ):
            "null"
        else:
            requester_origin
        if (fetch.kind != "document" and
            policy_origin == "null" and
            requester_origin.starts_with("https://") and
            effective_url.starts_with("http://")):
            return _hosted_browser_policy_reject(
                "mixed-content-blocked"
            )
        val trusted_initial_bootstrap = (
            fetch.kind == "document" and
            self.document_url == "" and
            self.navigation_permit.active
        )
        if (fetch.kind == "document" and
            not trusted_initial_bootstrap and
            not self._active_document_csp_valid()):
            return _hosted_browser_policy_reject(
                "csp-policy-unavailable"
            )
        val policy = hosted_browser_renderer_request_policy(
            policy_origin,
            self.navigation_permit,
            fetch,
            effective_url
        )
        if not policy.ok or fetch.kind == "document":
            return policy
        val directive = _hosted_browser_csp_directive(fetch.kind)
        if directive == "":
            return _hosted_browser_policy_reject("csp-policy-unavailable")
        val document_url = self._active_renderer_document_url()
        if (not csp_ready or document_url == "" or
            not browser_csp_policy_valid(csp_policy)):
            return _hosted_browser_policy_reject(
                "csp-policy-unavailable"
            )
        if not browser_csp_allows(
            csp_policy, directive,
            if sandbox.allow_same_origin: document_url else: "about:blank",
            policy.canonical_url, false
        ):
            return _hosted_browser_policy_reject(
                "csp-{directive}-blocked"
            )
        policy

    fn _poll_renderer_reply(
        reply_to_request_id: i64, future_reason: text
    ) -> Result<bool, text>:
        if reply_to_request_id < self.expected_reply_to_request_id:
            return Ok(false)
        if reply_to_request_id > self.expected_reply_to_request_id:
            return Err(future_reason)
        Ok(true)

    me begin_resume_site_swap(timeout_ms: i64) -> Result<bool, text>:
        if (not self.site_swap_pending or
            not self.navigation_permit.active):
            return Err("site-swap-state")
        if self.state != "active":
            return Err("invalid-renderer-state")
        val capability = match browser_renderer_command_capability_new():
            Err(reason): return Err(reason)
            Ok(value): value
        val history_snapshot = match self._history_snapshot_for_command(
            capability
        ):
            Err(reason):
                return Err(reason)
            Ok(value):
                value
        val command = browser_renderer_navigation_encode_with_history(
                self.generation,
                self.next_request_id,
                "open",
                self.navigation_permit.url,
                self.navigation_permit.method,
                self.navigation_permit.headers,
                self.navigation_permit.body,
                self.navigation_permit.content_type,
                history_snapshot
            )
        val prepared = match (
            self._prepare_renderer_command_with_capability(
                command, capability
            )
        ):
            Err(reason): return Err(reason)
            Ok(value): value
        val started = self._begin_navigation_command(
            prepared,
            "open",
            "navigation",
            timeout_ms
        )
        if val Ok(_) = started:
            self.site_swap_pending = false
            self.site_swap_site = ""
        started

    me _apply_script_cookie_writes(writes: [text]) -> bool:
        if writes.len() == 0:
            return true
        val source_url = self._active_renderer_document_url()
        val source_origin = self._requester_origin()
        if (source_url == "" or source_origin == "" or
            hosted_browser_network_origin(source_url) != source_origin):
            return false
        # Script writes precede request preparation, so they must not inherit
        # a prior request's top-level partition owner.
        self.network.set_requester_origin(source_origin)
        self.network.store_script_cookies(writes, source_url)

    me _replace_pending_navigation() -> bool:
        if self.pending_wire != "" and self.pending_wire_offset > 0:
            return false
        self.stop_after_write = false
        self._cancel_pending_for_stop()

    me _cancel_pending_for_stop() -> bool:
        if self.pending_wire != "" and self.pending_wire_offset > 0:
            return false
        self.pending_wire = ""
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = 0
        self.pending_wire_is_command = false
        self.deferred_commands = []
        self.pending_scroll_event_id = 0
        self.pending_scroll_delta_milli_y = 0
        self._cancel_network_job()
        self.command_deadline_ms = 0
        self.pending_operation = ""
        self.next_animation_ms = -1
        self.pending_resize_width = 0
        self.pending_resize_height = 0
        self.pending_history_index = -1
        self.pending_history_target_url = ""
        self.navigation_permit = hosted_browser_empty_navigation_permit()
        self.pending_history_action = ""
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        self._clear_pending_document_csp()
        self._retire_renderer_command_capability()
        true

    me _begin_stop_after_write() -> text:
        if not self.stop_after_write or self.pending_wire != "":
            return ""
        val remaining_ms = (
            self.command_deadline_ms - rt_time_now_monotonic_ms()
        )
        val command = browser_renderer_navigation_encode(
            self.generation, self.next_request_id,
            "stop", "", "", "", "", ""
        )
        val prepared = match self._prepare_renderer_command(command):
            Err(reason): return reason
            Ok(value): value
        self.stop_after_write = false
        if not self._cancel_pending_for_stop():
            return "renderer-busy"
        match self._begin_navigation_command(
            prepared,
            "stop", "stop",
            if remaining_ms > 0: remaining_ms else: 1
        ):
            Err(reason): reason
            Ok(_): ""

    me close(preserve_parent_state: bool = false) -> bool:
        self._cancel_network_job()
        self.command_deadline_ms = 0
        self.pending_operation = ""
        self.next_animation_ms = -1
        self.pending_resize_width = 0
        self.pending_resize_height = 0
        self.pending_history_index = -1
        self.pending_history_target_url = ""
        self.navigation_permit = hosted_browser_empty_navigation_permit()
        self.pending_history_action = ""
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        self._clear_pending_document_csp()
        self.site_swap_pending = false
        self.site_swap_site = ""
        self.pending_wire = ""
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = 0
        self.pending_wire_is_command = false
        self.stop_after_write = false
        self.deferred_commands = []
        self.pending_scroll_event_id = 0
        self.pending_scroll_delta_milli_y = 0
        self.pointer_pressed = false
        self.pending_pointer_cancel_event_id = 0
        self._retire_renderer_command_capability()
        self.retained_image_resources = []
        if self.pid > 0:
            if not process_close_piped(self.pid):
                return false
        self.pid = 0
        self.decoder = browser_renderer_capability_decoder_new(self.generation)
        self.network = FetchEngine.new(
            Logger.new("browser-renderer-broker", LogLevel.Error)
        )
        if not preserve_parent_state:
            self.site_lock = ""
            self.history_urls = []
            self.history_csp_policies = []
            self.history_csp_ready = []
            self.history_index = -1
            self.history_current_url = ""
            self.history_back_url = ""
            self.history_forward_url = ""
            self.document_url = ""
            self.document_origin = ""
            self.document_csp_policy = ""
            self.document_csp_ready = false
            self._clear_document_title()
            self.home_url = ""
            self.hsts.hsts_policies = []
            self.hsts_dirty = false
        if self.state != "failed":
            self.state = "closed"
        true

    me fail(reason: text) -> HostedBrowserRendererResult:
        self.state = "failed"
        val close_reason = if self.close(true):
            ""
        else:
            ";renderer-close-failed"
        _renderer_result(false, reason + close_reason, _empty_composition())

    me begin_start(executable: text, timeout_ms: i64) -> Result<bool, text>:
        if self.state != "new" or executable == "" or self.generation <= 0 or
            self.width <= 0 or self.height <= 0:
            return Err("invalid-launch")
        if (self.requires_theme_handshake and not
            hosted_theme_wire_valid(
                self.theme_revision, self.theme_wire_text
            )):
            return Err("invalid-theme-projection")
        val worker_args = if self.requires_theme_handshake:
            [
                BROWSER_RENDERER_WORKER_ARG,
                self.generation.to_text(),
                self.width.to_text(),
                self.height.to_text(),
                "--theme-runtime"
            ]
        else:
            [
                BROWSER_RENDERER_WORKER_ARG,
                self.generation.to_text(),
                self.width.to_text(),
                self.height.to_text()
            ]
        self.pid = browser_renderer_spawn_sandboxed(
            executable, worker_args
        )
        if self.pid <= 0:
            self.pid = 0
            self.state = "failed"
            return Err("sandbox-unavailable")
        self.state = "starting"
        self.command_deadline_ms = _deadline_ms(timeout_ms)
        self.pending_operation = "start"
        Ok(true)

    me start(executable: text, timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_start(executable, timeout_ms):
            Err(reason):
                self.fail(reason)
            Ok(_):
                self._await_pending()

    me start_with_theme(
        executable: text, timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if not self.requires_theme_handshake:
            return self.fail("theme-handshake-not-required")
        val started = self.start(executable, timeout_ms)
        if not started.ok:
            return started
        match self.begin_theme_init(timeout_ms):
            Err(reason):
                self.fail(reason)
            Ok(_):
                self._await_pending()

    me _finalize_network(
        kind: text,
        request: FetchRequest,
        response: FetchResponse
    ) -> HostedBrowserNetworkResult:
        match self.network.finalize_single_hop(request, response):
            Err(error):
                _network_result(0, "", "", error.message)
            Ok(finalized):
                self._network_response(kind, finalized)

    fn _network_response(
        kind: text, response: FetchResponse
    ) -> HostedBrowserNetworkResult:
        val limit_reason = hosted_browser_network_response_limit_reason(
            kind, response.headers, response.body
        )
        if limit_reason != "":
            return _network_result(0, "", "", limit_reason)
        val body = if kind == "wasm" or kind == "image":
            _renderer_binary_hex(response.body)
        else:
            response.body_text()
        if rt_text_to_bytes(body).len() > (
            BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES
        ):
            return _network_result(
                0, "", "", "renderer-network-body-too-large"
            )
        _network_result(
            response.status.to_i32(),
            response.headers,
            body,
            ""
        )

    me _start_network_job(
        fetch: BrowserRendererNetworkDecodeResult,
        policy: HostedBrowserRequestPolicy,
        redirect_count: i64
    ) -> HostedBrowserNetworkResult?:
        val transport_url = hosted_browser_canonical_http_url(
            policy.canonical_url
        )
        val request = FetchRequest(
            url: Url.parse_or_opaque(transport_url),
            method: fetch.method,
            headers: policy.sanitized_headers,
            body: rt_text_to_bytes(fetch.body),
            mode: policy.mode,
            credentials: policy.credentials
        )
        val requester_origin = if fetch.initiator_origin != "":
            fetch.initiator_origin
        else:
            self._requester_origin()
        self.network.set_requester_origin(requester_origin)
        val plan = self.network.build_cors_preflight(request)
        if val Some(preflight_request) = plan.preflight_request:
            if val Some(mock_result) = h1_mock_response(preflight_request):
                match mock_result:
                    Err(error):
                        return Some(_network_result(
                            0, "", "", error.message
                        ))
                    Ok(response):
                        val allowed = match self.network.validate_cors_preflight(
                            plan.actual_request, response
                        ):
                            Err(_): false
                            Ok(value): value
                        if not allowed:
                            return Some(_network_result(
                                0, "", "", "network: CORS preflight denied"
                            ))
                        return self._start_actual_network_job(
                            fetch, policy, redirect_count,
                            plan.actual_request
                        )
            return self._start_runtime_network_job(
                fetch, policy, redirect_count, preflight_request,
                "preflight", Some(plan.actual_request)
            )
        self._start_actual_network_job(
            fetch, policy, redirect_count, plan.actual_request
        )

    me _start_actual_network_job(
        fetch: BrowserRendererNetworkDecodeResult,
        policy: HostedBrowserRequestPolicy,
        redirect_count: i64,
        request: FetchRequest
    ) -> HostedBrowserNetworkResult?:
        val requester_origin = if fetch.initiator_origin != "":
            fetch.initiator_origin
        else:
            self._requester_origin()
        val active_document_url = self._active_renderer_document_url()
        val site_for_cookies_url = if requester_origin == "null":
            ""
        elif active_document_url != "":
            active_document_url
        else:
            "about:blank"
        match self.network.prepare_single_hop_after_cors_preflight(
            request, site_for_cookies_url, policy.consumes_navigation
        ):
            Err(error):
                return Some(_network_result(
                    0, "", "", error.message
                ))
            Ok(prepared):
                if val Some(response) = prepared.response:
                    return Some(self._network_response(
                        fetch.kind, response
                    ))
                if val Some(mock_result) = h1_mock_response(prepared.request):
                    match mock_result:
                        Err(error):
                            return Some(_network_result(
                                0, "", "", error.message
                            ))
                        Ok(response):
                            val raw_response = self._network_response(
                                fetch.kind, response
                            )
                            if val Err(reason) = self._form_action_redirect_allowed(
                                policy, raw_response, redirect_count
                            ):
                                return Some(_network_result(
                                    0, "", "", reason
                                ))
                            return Some(self._finalize_network(
                                fetch.kind, prepared.request, response
                            ))
                self._start_runtime_network_job(
                    fetch, policy, redirect_count, prepared.request,
                    "actual", nil
                )

    me _start_runtime_network_job(
        fetch: BrowserRendererNetworkDecodeResult,
        policy: HostedBrowserRequestPolicy,
        redirect_count: i64,
        request: FetchRequest,
        phase: text,
        actual_request: FetchRequest?
    ) -> HostedBrowserNetworkResult?:
        val url = request.url
        val port = if url.port > 0:
            url.port
        elif url.scheme == "https":
            443
        else:
            80
        val remaining_ms = (
            self.command_deadline_ms - rt_time_now_monotonic_ms()
        )
        if remaining_ms <= 0:
            return Some(_network_result(
                0, "", "", "renderer-network-timeout"
            ))
        val raw_limit = if phase == "preflight":
            65536
        elif fetch.kind == "wasm" or fetch.kind == "image":
            327680
        else:
            589824
        val handle = rt_browser_http_job_start_public_limited(
            url.scheme,
            hosted_browser_transport_host(url.host),
            port,
            rt_text_to_bytes(build_request_bytes(request)),
            remaining_ms,
            raw_limit
        )
        if handle < 0:
            return Some(_network_result(
                0, "", "", "network: Network request failed"
            ))
        self.network_job_handle = handle
        self.network_job_fetch = Some(fetch)
        self.network_job_policy = Some(policy)
        self.network_job_request = Some(request)
        self.network_job_phase = phase
        self.network_job_actual_request = actual_request
        self.network_job_redirect_count = redirect_count
        nil

    fn _form_action_redirect_allowed(
        policy: HostedBrowserRequestPolicy,
        response: HostedBrowserNetworkResult,
        redirect_count: i64
    ) -> Result<bool, text>:
        if (policy.form_action_document_url == "" or
            not hosted_browser_redirect_status(response.status)):
            return Ok(true)
        val location = hosted_browser_response_header_value(
            response.headers, "location"
        )
        if location == "" or redirect_count >= 20:
            return Err("invalid-navigation-redirect")
        val redirected = resolve_fetch_redirect_url(
            Url.parse_or_opaque(policy.canonical_url), location
        )
        if not redirected.?:
            return Err("invalid-navigation-redirect")
        val original_redirected_url = hosted_browser_canonical_navigation_url(
            redirected!.to_text()
        )
        val redirected_url = hosted_browser_canonical_navigation_url(
            self._hsts_upgrade_url(original_redirected_url)
        )
        val base = Url.parse_or_opaque(policy.canonical_url)
        if (redirected_url == "" or
            (base.scheme == "https" and
                not redirected_url.starts_with("https://"))):
            return Err("invalid-navigation-redirect")
        if not browser_csp_form_action_allows_after_redirect(
            policy.form_action_policy,
            policy.form_action_document_url, redirected_url
        ):
            return Err("CSP blocked form redirect: {redirected_url}")
        Ok(true)

    me _record_document_response(
        request: BrowserRendererNetworkDecodeResult,
        policy: HostedBrowserRequestPolicy,
        response: HostedBrowserNetworkResult,
        redirect_count: i64
    ) -> Result<text, text>:
        if response.status <= 0:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_action = ""
            self.pending_history_index = -1
            self.pending_history_target_url = ""
            self.pending_document_commit_url = ""
            self.provisional_document_origin = ""
            self._clear_pending_document_csp()
            return Ok(response.headers)
        self._form_action_redirect_allowed(
            policy, response, redirect_count
        )?
        if not hosted_browser_redirect_status(response.status):
            if browser_header_has_attachment_disposition(response.headers):
                return Err("document-attachment-unsupported")
            self.pending_document_commit_url = policy.canonical_url
            self.provisional_document_origin = hosted_browser_network_origin(
                policy.canonical_url
            )
            val header_csp = browser_header_content_security_policy(
                response.headers
            )
            if (response.status == 304 and
                policy.canonical_url == self.document_url and
                self.document_csp_ready):
                self.pending_document_csp_policy = (
                    self.document_csp_policy
                )
                if header_csp != "":
                    self.pending_document_csp_policy = (
                        self.pending_document_csp_policy + "\n" +
                        header_csp
                    )
            elif response.status == 304:
                self.pending_document_csp_policy = ""
            else:
                self.pending_document_csp_policy = (
                    browser_document_csp_policy(
                        response.body, policy.canonical_url, header_csp
                    )
                )
            self.pending_document_csp_ready = browser_csp_policy_valid(
                self.pending_document_csp_policy
            ) and (response.status != 304 or
                policy.canonical_url == self.document_url and
                self.document_csp_ready)
            return Ok(response.headers)
        val location = hosted_browser_response_header_value(
            response.headers, "location"
        )
        if location == "" or redirect_count >= 20:
            return Err("invalid-navigation-redirect")
        val base = Url.parse_or_opaque(policy.canonical_url)
        val redirected = resolve_fetch_redirect_url(base, location)
        if not redirected.?:
            return Err("invalid-navigation-redirect")
        val original_redirected_url = hosted_browser_canonical_navigation_url(
            redirected!.to_text()
        )
        val redirected_url = hosted_browser_canonical_navigation_url(
            self._hsts_upgrade_url(original_redirected_url)
        )
        if (redirected_url == "" or
            (base.scheme == "https" and
                not redirected_url.starts_with("https://"))):
            return Err("invalid-navigation-redirect")
        val prior_method = request.method.to_upper()
        val next_method = if (
            response.status == 303 or
            ((response.status == 301 or response.status == 302) and
                prior_method == "POST")
        ):
            "GET"
        else:
            prior_method
        val preserve_body = next_method != "GET" and next_method != "HEAD"
        val same_origin = hosted_browser_network_origin(
            policy.canonical_url
        ) == hosted_browser_network_origin(redirected_url)
        val next_content_type = if preserve_body:
            request.content_type
        else:
            ""
        val next_headers = if same_origin:
            policy.sanitized_headers
        elif next_content_type != "":
            "Content-Type: {next_content_type}"
        else:
            ""
        self.navigation_permit = HostedBrowserNavigationPermit(
            active: true,
            url: redirected_url,
            method: next_method,
            headers: next_headers,
            body: if preserve_body: request.body else: "",
            content_type: next_content_type,
            redirect_count: redirect_count + 1,
            form_action_policy: policy.form_action_policy,
            form_action_document_url: policy.form_action_document_url
        )
        if redirected_url != original_redirected_url:
            return Ok(hosted_browser_replace_response_header(
                response.headers, "Location", redirected_url
            ))
        Ok(response.headers)

    me _write_network_response(
        fetch: BrowserRendererNetworkDecodeResult,
        policy: HostedBrowserRequestPolicy,
        response: HostedBrowserNetworkResult,
        redirect_count: i64,
        transport_upgrade: bool = false
    ) -> text:
        var response_headers = response.headers
        var response_status = response.status
        var response_body = response.body
        var response_error = response.error
        val attachment_rejected = (
            policy.consumes_navigation and
            response.status > 0 and
            not hosted_browser_redirect_status(response.status) and
            browser_header_has_attachment_disposition(response.headers)
        )
        if attachment_rejected:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_action = ""
            self.pending_history_index = -1
            self.pending_history_target_url = ""
            self.pending_document_commit_url = ""
            self.provisional_document_origin = ""
            self._clear_pending_document_csp()
            response_status = 0
            response_body = ""
            response_error = "document-attachment-unsupported"
        elif policy.consumes_navigation:
            match self._record_document_response(
                fetch, policy, response, redirect_count
            ):
                Err(reason):
                    return reason
                Ok(headers):
                    response_headers = headers
            if (hosted_browser_redirect_status(response.status) and
                self.navigation_permit.active and
                self._document_site_swap_required(
                    self.navigation_permit.url
                )):
                return HOSTED_BROWSER_SITE_SWAP_REQUIRED
        response_headers = hosted_browser_remove_response_header(
            response_headers, "set-cookie"
        )
        response_headers = hosted_browser_remove_response_header(
            response_headers, "set-cookie2"
        )
        if hosted_browser_redirect_status(response.status):
            val location = hosted_browser_response_header_value(
                response_headers, "location"
            )
            if location != "":
                val redirected = resolve_fetch_redirect_url(
                    Url.parse_or_opaque(policy.canonical_url), location
                )
                val redirect_url = hosted_browser_canonical_navigation_url(
                    redirected.to_text()
                )
                val effective_redirect_url = self._hsts_upgrade_url(
                    redirect_url
                )
                if (redirect_url != "" and
                    effective_redirect_url != redirect_url and
                    hosted_browser_hsts_upgrade_valid(
                        redirect_url, effective_redirect_url
                    )):
                    response_headers = hosted_browser_replace_response_header(
                        response_headers, "Location",
                        effective_redirect_url
                    )
        response_headers = hosted_browser_remove_response_header(
            response_headers, "strict-transport-security"
        )
        response_headers = hosted_browser_remove_response_header(
            response_headers, "x-simple-broker-transport-upgrade"
        )
        if policy.mode == RequestMode.Cors:
            response_headers = hosted_browser_cors_response_headers(
                response_headers,
                hosted_browser_redirect_status(response.status),
                policy.credentials
            )
        if transport_upgrade:
            if response_headers != "":
                response_headers = response_headers + "\r\n"
            response_headers = response_headers +
                "X-Simple-Broker-Transport-Upgrade: 1"
        val wire = browser_renderer_network_response_encode(
            self.generation,
            self.next_request_id,
            fetch.request_id,
            fetch.kind,
            fetch.url,
            response_status,
            response_headers,
            response_body,
            response_error
        )
        if not wire.ok:
            return wire.reason
        if (self.active_command_capability == "" or
            self.active_root_command_request_id <= 0):
            return "renderer-command-capability-missing"
        val bound_wire = browser_renderer_capability_bind_encoded(
            wire,
            self.generation,
            self.next_request_id,
            self.active_root_command_request_id,
            self.active_command_capability
        )
        if not bound_wire.ok:
            return bound_wire.reason
        if self.pending_wire != "":
            return "renderer-write-state"
        self.staged_command_capability = self.active_command_capability
        self.staged_root_command_request_id = (
            self.active_root_command_request_id
        )
        self.staged_wire_request_id = self.next_request_id
        self.staged_history_authority = self._history_authority(
            self.active_command_capability,
            self.active_root_command_request_id,
            self.next_request_id
        )
        self.expected_reply_to_request_id = self.next_request_id
        self.pending_wire = bound_wire.wire
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = self.next_request_id
        self.pending_wire_is_command = false
        ""

    me _queue_hsts_transport_upgrade(
        fetch: BrowserRendererNetworkDecodeResult,
        policy: HostedBrowserRequestPolicy,
        redirect_count: i64
    ) -> text:
        self._write_network_response(
            fetch,
            policy,
            _network_result(
                307,
                "Location: {policy.canonical_url}",
                "",
                ""
            ),
            redirect_count,
            true
        )

    me _complete_pending_wire_write():
        if self.staged_command_capability != "":
            self.issued_command_capability = (
                self.staged_command_capability
            )
            self.issued_root_command_request_id = (
                self.staged_root_command_request_id
            )
            self.issued_wire_request_id = self.staged_wire_request_id
            self.issued_history_authority = (
                self.staged_history_authority
            )
            self.staged_command_capability = ""
            self.staged_root_command_request_id = 0
            self.staged_wire_request_id = 0
            self.staged_history_authority = _empty_history_authority()
        self.expected_reply_to_request_id = (
            self.pending_wire_reply_to_request_id
        )
        self.next_request_id = (
            self.pending_wire_reply_to_request_id + 1
        )
        self.pending_wire = ""
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = 0
        self.pending_wire_is_command = false

    me _flush_pending_wire_once() -> text:
        if self.pending_wire == "":
            return ""
        val written = process_write_stdin_some(
            self.pid,
            self.pending_wire,
            self.pending_wire_offset,
            8192
        )
        if written < 0:
            return "renderer-write-failed"
        if written == 0:
            if not process_is_piped_alive(self.pid):
                self.pid = 0
                return "renderer-crashed"
            return ""
        self.pending_wire_offset = self.pending_wire_offset + written
        if self.pending_wire_offset >= self.pending_wire.len():
            self._complete_pending_wire_write()
        ""

    me _poll_network_job() -> text:
        if self.network_job_handle <= 0:
            return ""
        if (self.network_job_fetch == nil or
            self.network_job_policy == nil or
            self.network_job_request == nil or
            (self.network_job_phase != "preflight" and
                self.network_job_phase != "actual") or
            (self.network_job_phase == "preflight" and
                self.network_job_actual_request == nil)):
            self._cancel_network_job()
            return "renderer-network-state"
        val state = rt_browser_http_job_poll(self.network_job_handle)
        if state == 0:
            return ""
        val handle = self.network_job_handle
        val fetch = self.network_job_fetch.unwrap()
        val policy = self.network_job_policy.unwrap()
        val request = self.network_job_request.unwrap()
        val phase = self.network_job_phase
        val actual_request = self.network_job_actual_request
        val redirect_count = self.network_job_redirect_count
        self.network_job_handle = 0
        self.network_job_fetch = nil
        self.network_job_policy = nil
        self.network_job_request = nil
        self.network_job_phase = ""
        self.network_job_actual_request = nil
        self.network_job_redirect_count = 0
        var response = _network_result(
            0, "", "", "network: Network request failed"
        )
        if state < 0:
            val _ = rt_browser_http_job_free(handle)
        else:
            val error = rt_browser_http_job_take_error(handle)
            val raw_response = rt_browser_http_job_take_response(handle)
            val _ = rt_browser_http_job_free(handle)
            if error != "":
                response = _network_result(
                    0, "", "",
                    hosted_browser_network_error(request.url.scheme, error)
                )
            else:
                match parse_http_response_bytes(raw_response):
                    Err(parse_error):
                        response = _network_result(
                            0, "", "",
                            hosted_browser_network_error(
                                request.url.scheme, parse_error.message
                            )
                        )
                    Ok(parsed):
                        if phase == "preflight":
                            val allowed = match self.network.validate_cors_preflight(
                                actual_request.unwrap(), parsed
                            ):
                                Err(_): false
                                Ok(value): value
                            if not allowed:
                                response = _network_result(
                                    0, "", "",
                                    "network: CORS preflight denied"
                                )
                            else:
                                val actual_result = self._start_actual_network_job(
                                    fetch, policy, redirect_count,
                                    actual_request.unwrap()
                                )
                                if val Some(actual_response) = actual_result:
                                    response = actual_response
                                else:
                                    return ""
                        else:
                            # Only an authenticated actual HTTPS response may
                            # seed HSTS; OPTIONS has no observable side effects.
                            val raw_response = self._network_response(
                                fetch.kind, parsed
                            )
                            if val Err(reason) = self._form_action_redirect_allowed(
                                policy, raw_response, redirect_count
                            ):
                                response = _network_result(0, "", "", reason)
                            else:
                                if request.url.scheme == "https":
                                    val _ = self._commit_validated_https_hsts(
                                        request.url.to_text(), parsed.headers
                                    )
                                response = self._finalize_network(
                                    fetch.kind, request, parsed
                                )
        self._write_network_response(
            fetch, policy, response, redirect_count
        )

    fn _prepare_renderer_command(
        request: BrowserRendererEncodeResult
    ) -> Result<_HostedBrowserPreparedCommand, text>:
        val capability = match browser_renderer_command_capability_new():
            Err(reason): return Err(reason)
            Ok(value): value
        self._prepare_renderer_command_with_capability(
            request, capability
        )

    fn _prepare_renderer_command_with_capability(
        request: BrowserRendererEncodeResult,
        capability: text
    ) -> Result<_HostedBrowserPreparedCommand, text>:
        if not request.ok:
            return Err(request.reason)
        if self.pending_wire != "" and self.pending_wire_offset > 0:
            return Err("renderer-busy")
        if not browser_renderer_command_capability_valid(capability):
            return Err("invalid-command-capability")
        val bound_request = browser_renderer_capability_bind_encoded(
            request,
            self.generation,
            self.next_request_id,
            self.next_request_id,
            capability
        )
        if not bound_request.ok:
            return Err(bound_request.reason)
        Ok(_HostedBrowserPreparedCommand(
            wire: bound_request.wire,
            capability: capability,
            root_command_request_id: self.next_request_id,
            wire_request_id: self.next_request_id,
            history_authority: self._history_authority(
                capability, self.next_request_id, self.next_request_id
            )
        ))

    me _begin_prepared_renderer_command(
        prepared: _HostedBrowserPreparedCommand,
        operation: text,
        timeout_ms: i64
    ) -> Result<bool, text>:
        if self.command_deadline_ms > 0:
            return Err("renderer-busy")
        val deadline = _deadline_ms(timeout_ms)
        self.active_command_capability = prepared.capability
        self.active_root_command_request_id = (
            prepared.root_command_request_id
        )
        self.staged_command_capability = prepared.capability
        self.staged_root_command_request_id = (
            prepared.root_command_request_id
        )
        self.staged_wire_request_id = prepared.wire_request_id
        self.staged_history_authority = prepared.history_authority
        self.expected_reply_to_request_id = prepared.wire_request_id
        self.pending_wire = prepared.wire
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = self.next_request_id
        self.pending_wire_is_command = true
        self.command_deadline_ms = deadline
        self.pending_operation = operation
        self.hang_acknowledged = false
        Ok(true)

    me _begin_frame_request(
        request: BrowserRendererEncodeResult,
        operation: text,
        timeout_ms: i64
    ) -> Result<bool, text>:
        if self.command_deadline_ms > 0:
            return Err("renderer-busy")
        val prepared = match self._prepare_renderer_command(request):
            Err(reason): return Err(reason)
            Ok(value): value
        self._begin_prepared_renderer_command(
            prepared, operation, timeout_ms
        )

    me _begin_after_animation(
        request: BrowserRendererEncodeResult,
        operation: text,
        timeout_ms: i64,
        resize_width: i32 = 0,
        resize_height: i32 = 0
    ) -> Result<bool, text>:
        if self.command_deadline_ms <= 0:
            val prepared = match self._prepare_renderer_command(request):
                Err(reason): return Err(reason)
                Ok(value): value
            self.pending_resize_width = resize_width
            self.pending_resize_height = resize_height
            return self._begin_prepared_renderer_command(
                prepared, operation, timeout_ms
            )
        if not request.ok:
            return Err(request.reason)
        if self.network_job_handle > 0:
            return Err("renderer-busy")
        val queueable_pending = (
            self.pending_operation == "advance" or
            self.pending_operation == "pointer" or
            self.pending_operation == "pointer-cancel" or
            self.pending_operation == "key" or
            self.pending_operation == "text" or
            self.pending_operation == "bookmark-snapshot" or
            self.pending_operation == "resize" or
            self.pending_operation == "scroll"
        )
        if not queueable_pending:
            return Err("renderer-busy")
        if (
            self.pending_operation == "advance" and
            self.deferred_commands.len() == 0 and
            self.pending_wire != "" and self.pending_wire_is_command and
            self.pending_wire_offset <= 0
        ):
            val prepared = match self._prepare_renderer_command(request):
                Err(reason): return Err(reason)
                Ok(value): value
            self.pending_wire = ""
            self.pending_wire_offset = 0
            self.pending_wire_reply_to_request_id = 0
            self.pending_wire_is_command = false
            self.command_deadline_ms = 0
            self.pending_operation = ""
            self._retire_renderer_command_capability()
            self.pending_resize_width = resize_width
            self.pending_resize_height = resize_height
            return self._begin_prepared_renderer_command(
                prepared, operation, timeout_ms
            )
        if operation == "resize" and self.deferred_commands.len() > 0:
            val newest_index = self.deferred_commands.len() - 1
            val newest = self.deferred_commands[newest_index]
            if newest.operation == "resize":
                if (newest.resize_width == resize_width and
                    newest.resize_height == resize_height):
                    return Ok(false)
                self.deferred_commands[newest_index] = (
                    _HostedBrowserDeferredCommand(
                        kind: request.kind,
                        payload: request.payload,
                        operation: operation,
                        timeout_ms: timeout_ms,
                        resize_width: resize_width,
                        resize_height: resize_height
                    )
                )
                return Ok(true)
        if self.deferred_commands.len() >= (
            BROWSER_RENDERER_MAX_DEFERRED_COMMANDS
        ):
            return Err("renderer-input-queue-full")
        self.deferred_commands.push(_HostedBrowserDeferredCommand(
            kind: request.kind,
            payload: request.payload,
            operation: operation,
            timeout_ms: timeout_ms,
            resize_width: resize_width,
            resize_height: resize_height
        ))
        Ok(true)

    me _activate_deferred_command() -> text:
        if self.deferred_commands.len() == 0:
            return ""
        # ponytail: O(n) shift is bounded at 64; use a ring only if this grows.
        val deferred = self.deferred_commands[0]
        val request = BrowserRendererEncodeResult(
            ok: true,
            reason: "ok",
            wire: "",
            kind: deferred.kind,
            payload: deferred.payload
        )
        val prepared = match self._prepare_renderer_command(request):
            Err(reason): return reason
            Ok(value): value
        val _ = self.deferred_commands.remove(0)
        self.pending_resize_width = deferred.resize_width
        self.pending_resize_height = deferred.resize_height
        match self._begin_prepared_renderer_command(
            prepared, deferred.operation, deferred.timeout_ms
        ):
            Err(reason): reason
            Ok(_): ""

    me _dispatch_renderer_fetch(
        fetch: BrowserRendererNetworkDecodeResult
    ) -> HostedBrowserRendererResult?:
        if not fetch.ok:
            return Some(self.fail(fetch.reason))
        if not self._renderer_initiator_valid(fetch):
            return Some(self.fail("invalid-renderer-initiator"))
        var renderer_navigation = false
        if (fetch.kind == "document" and
            not self.navigation_permit.active):
            if not self._active_document_csp_valid():
                return Some(self.fail("csp-policy-unavailable"))
            if not self.authorize_renderer_navigation(fetch):
                return Some(self.fail("unauthorized-document-request"))
            renderer_navigation = true
        val effective_url = self._hsts_upgrade_url(fetch.url)
        val request_url = hosted_browser_canonical_http_url(fetch.url)
        if renderer_navigation and request_url != effective_url:
            val transport_policy = HostedBrowserRequestPolicy(
                ok: true,
                reason: "ok",
                mode: RequestMode.Navigate,
                credentials: "include",
                canonical_url: effective_url,
                sanitized_headers: self.navigation_permit.headers,
                consumes_navigation: true,
                form_action_policy: self.navigation_permit.form_action_policy,
                form_action_document_url: (
                    self.navigation_permit.form_action_document_url
                )
            )
            val reason = self._queue_hsts_transport_upgrade(
                fetch, transport_policy, -1
            )
            if reason != "":
                if reason == HOSTED_BROWSER_SITE_SWAP_REQUIRED:
                    return Some(_renderer_result(
                        false, reason, _empty_composition()
                    ))
                return Some(self.fail(reason))
            return nil
        val policy = self._renderer_request_policy(fetch, effective_url)
        if not policy.ok:
            if (policy.reason == "mixed-content-blocked" or
                policy.reason.starts_with("csp-")):
                val reason = self._write_network_response(
                    fetch,
                    policy,
                    _network_result(0, "", "", policy.reason),
                    0
                )
                if reason != "":
                    return Some(self.fail(reason))
                return nil
            return Some(self.fail(policy.reason))
        if not self._apply_script_cookie_writes(
            fetch.script_cookie_writes
        ):
            return Some(self.fail("invalid-script-cookie-write"))
        if (fetch.kind == "document" and
            self._document_site_swap_required(policy.canonical_url)):
            return Some(_renderer_result(
                false,
                HOSTED_BROWSER_SITE_SWAP_REQUIRED,
                _empty_composition()
            ))
        var redirect_count: i64 = 0
        if policy.consumes_navigation:
            redirect_count = self.navigation_permit.redirect_count
            self.navigation_permit = hosted_browser_empty_navigation_permit()
        if (fetch.kind != "document" and
            policy.canonical_url != request_url):
            val reason = self._queue_hsts_transport_upgrade(
                fetch, policy, redirect_count
            )
            if reason != "":
                return Some(self.fail(reason))
            return nil
        if val Some(response) = self._start_network_job(
            fetch, policy, redirect_count
        ):
            val reason = self._write_network_response(
                fetch, policy, response, redirect_count
            )
            if reason != "":
                if reason == HOSTED_BROWSER_SITE_SWAP_REQUIRED:
                    return Some(_renderer_result(
                        false, reason, _empty_composition()
                    ))
                return Some(self.fail(reason))
        nil

    me _accept_theme_ready_message(
        message: BrowserRendererMessage
    ) -> HostedBrowserRendererResult:
        if self.state != "await-theme-ready":
            return self.fail("invalid-renderer-state")
        if (message.kind != "theme_ready" or
            message.request_id != self.expected_reply_to_request_id):
            return self.fail("expected-theme-ready")
        if not hosted_theme_ready_payload_matches(
            self.theme_revision,
            self.theme_wire_text,
            message.payload
        ):
            return self.fail("theme-ready-mismatch")
        self.command_deadline_ms = 0
        self.pending_operation = ""
        self.expected_reply_to_request_id = 0
        self._retire_renderer_command_capability()
        self.state = "await-init"
        _renderer_result(true, "theme-ready", _empty_composition())

    me _accept_decoded_frame(
        frame: BrowserRendererFrameDecodeResult,
        producer_generation: i64
    ) -> HostedBrowserRendererResult:
        if not frame.ok:
            return self.fail(frame.reason)
        if (self.pending_document_commit_url != "" and
            not frame.history_state_present):
            return self.fail("missing-frame-history")
        val history_transaction = (
            self.pending_document_commit_url != "" or
            self.pending_history_index >= 0 or
            frame.history_proposal_present
        )
        if history_transaction:
            if not frame.history_state_present:
                return self.fail("missing-frame-history")
            var candidate = self._stage_history_candidate()
            if frame.history_proposal_present:
                candidate = self._history_candidate_with_proposal(
                    candidate,
                    browser_renderer_history_proposal_decode(
                        frame.history_proposal
                    ),
                    producer_generation,
                    frame.reply_to_request_id
                )
            if (not candidate.ok or
                frame.history_current_url != candidate.document_url):
                return self.fail("invalid-frame-history")
            self._commit_history_candidate(candidate)
        elif (frame.history_state_present and
            frame.history_current_url != self.document_url):
            return self.fail("invalid-frame-history")
        val committed_title_url = self.document_url
        self._clear_document_title()
        if (frame.document_title_present and
            producer_generation == self.generation and
            frame.reply_to_request_id ==
                self.expected_reply_to_request_id and
            frame.history_current_url == committed_title_url):
            self.document_title = frame.document_title
            self.document_title_url = committed_title_url
            self.document_title_generation = producer_generation
            self.document_title_reply_to_request_id = (
                frame.reply_to_request_id
            )
        self.pending_history_index = -1
        self.pending_history_target_url = ""
        if self.pending_operation == "resize":
            self.width = self.pending_resize_width
            self.height = self.pending_resize_height
        val completed_pointer_cancel = (
            self.pending_operation == "pointer-cancel"
        )
        self.pending_resize_width = 0
        self.pending_resize_height = 0
        self.next_animation_ms = frame.next_animation_ms
        self.retained_image_resources = frame.image_resources
        self.command_deadline_ms = 0
        self.pending_operation = ""
        self._retire_renderer_command_capability()
        if completed_pointer_cancel:
            self.pointer_pressed = false
            self.pending_pointer_cancel_event_id = 0
        val deferred_reason = self._activate_deferred_command()
        if deferred_reason != "":
            return self.fail(deferred_reason)
        self.state = "active"
        _renderer_frame_result(
            frame.composition,
            frame.image_resources,
            frame.next_animation_ms,
            producer_generation,
            frame.composition_revision,
            frame.cpu_composited_count,
            frame.cpu_composited_sha256,
            frame.solid_material_count,
            frame.solid_material_sha256,
            frame.diagnostics,
            frame.damage_receipt
        )

    me poll() -> HostedBrowserRendererResult?:
        if self.command_deadline_ms <= 0:
            return nil
        if rt_time_now_monotonic_ms() >= (
            self.command_deadline_ms
        ):
            if (self.pending_operation == "test_hang_after_ready" and
                not self.hang_acknowledged):
                return Some(self.fail("renderer-hang-unacknowledged"))
            return Some(self.fail("renderer-timeout"))
        if self.state == "starting":
            val chunk = process_read_stdout(self.pid)
            val decoded = browser_renderer_capability_decoder_feed(
                self.decoder, chunk
            )
            self.decoder = decoded.decoder
            if decoded.status == "violation":
                return Some(self.fail(decoded.decoder.error))
            if decoded.status == "message":
                if (decoded.message.kind != "ready" or
                    decoded.message.request_id != 1 or
                    decoded.message.payload != ""):
                    return Some(self.fail("expected-ready"))
                if decoded.decoder.buffer_len != 0:
                    return Some(self.fail("unexpected-ready-buffer"))
                self.command_deadline_ms = 0
                self.pending_operation = ""
                self.state = if self.requires_theme_handshake:
                    "await-theme-init"
                else:
                    "await-init"
                return Some(_renderer_result(
                    true, "ok", _empty_composition()
                ))
            if chunk == "" and not process_is_piped_alive(self.pid):
                self.pid = 0
                return Some(self.fail("renderer-crashed"))
            return nil
        if self.pending_wire != "":
            val reason = self._flush_pending_wire_once()
            if reason != "":
                return Some(self.fail(reason))
            val stop_reason = self._begin_stop_after_write()
            if stop_reason != "":
                return Some(self.fail(stop_reason))
            return nil
        if self.network_job_handle > 0:
            val reason = self._poll_network_job()
            if reason != "":
                if reason == HOSTED_BROWSER_SITE_SWAP_REQUIRED:
                    return Some(_renderer_result(
                        false, reason, _empty_composition()
                    ))
                return Some(self.fail(reason))
            return nil
        val chunk = process_read_stdout(self.pid)
        val decoded = browser_renderer_capability_decoder_feed(
            self.decoder, chunk
        )
        self.decoder = decoded.decoder
        if decoded.status == "violation":
            return Some(self.fail(decoded.decoder.error))
        if decoded.status == "message":
            val payload_message = (
                browser_renderer_capability_payload_message(decoded.message)
            )
            if self.state == "await-theme-ready":
                match self._require_issued_renderer_reply(
                    decoded.message, decoded.message.request_id
                ):
                    Err(reason):
                        return Some(self.fail(reason))
                    Ok(_): ()
                return Some(self._accept_theme_ready_message(
                    payload_message
                ))
            if decoded.message.kind == "test_hang_ready":
                if (self.pending_operation != "test_hang_after_ready" or
                    self.hang_acknowledged or
                    decoded.message.request_id != (
                        self.expected_reply_to_request_id
                    ) or decoded.message.payload != ""):
                    return Some(self.fail("unexpected-test-hang-ready"))
                match self._require_issued_renderer_reply(
                    decoded.message, decoded.message.request_id
                ):
                    Err(reason):
                        return Some(self.fail(reason))
                    Ok(_): ()
                self.hang_acknowledged = true
                return nil
            if decoded.message.kind == "fetch_request":
                val fetch_reply_to_request_id = (
                    browser_renderer_fetch_request_reply_to_request_id(
                        payload_message
                    )
                )
                if fetch_reply_to_request_id <= 0:
                    return Some(self.fail(
                        "malformed-network-request"
                    ))
                match self._admit_renderer_reply(
                    decoded.message,
                    fetch_reply_to_request_id,
                    "stale-renderer-request"
                ):
                    Err(reason):
                        return Some(self.fail(reason))
                    Ok(disposition):
                        if disposition == "stale":
                            return nil
                val fetch = browser_renderer_fetch_request_decode(
                    payload_message
                )
                if not fetch.ok:
                    return Some(self.fail(fetch.reason))
                return self._dispatch_renderer_fetch(fetch)
            val frame_reply_to_request_id = (
                browser_renderer_frame_reply_to_request_id(payload_message)
            )
            if frame_reply_to_request_id <= 0:
                return Some(self.fail("malformed-material-witness"))
            match self._admit_renderer_reply(
                decoded.message,
                frame_reply_to_request_id,
                "stale-renderer-frame"
            ):
                Err(reason):
                    return Some(self.fail(reason))
                Ok(disposition):
                    if disposition == "stale":
                        return nil
            val decode_width = if self.pending_operation == "resize":
                self.pending_resize_width
            else:
                self.width
            val decode_height = if self.pending_operation == "resize":
                self.pending_resize_height
            else:
                self.height
            val frame = browser_renderer_frame_decode_with_retained_images(
                payload_message, decode_width, decode_height,
                self.retained_image_resources
            )
            return Some(self._accept_decoded_frame(
                frame, decoded.message.generation
            ))
        if chunk == "" and not process_is_piped_alive(self.pid):
            self.pid = 0
            return Some(self.fail("renderer-crashed"))
        nil

    me _await_frame(
        request: BrowserRendererEncodeResult,
        timeout_ms: i64,
        operation: text = "sync"
    ) -> HostedBrowserRendererResult:
        match self._begin_frame_request(request, operation, timeout_ms):
            Err(reason):
                if reason == "renderer-busy":
                    return _renderer_result(
                        false, reason, _empty_composition()
                    )
                return self.fail(reason)
            Ok(_):
                return self._await_pending()
        self.fail("renderer-timeout")

    me _await_pending() -> HostedBrowserRendererResult:
        while true:
            if val Some(result) = self.poll():
                return result
            rt_sleep_ms(1)
        self.fail("renderer-timeout")

    me render(
        kind: text,
        payload: text,
        timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if ((self.state == "await-init" and kind != "init") or
            (self.state == "active" and kind != "advance") or
            (self.state != "await-init" and self.state != "active")):
            return self.fail("invalid-renderer-state")
        val request = if kind == "advance":
            browser_renderer_advance_encode(
                self.generation,
                self.next_request_id,
                payload.to_i64() ?? -1
            )
        else:
            browser_renderer_message_encode(
                kind, self.generation, self.next_request_id, payload
            )
        self._await_frame(request, timeout_ms)

    me begin_init(payload: text, timeout_ms: i64) -> Result<bool, text>:
        if self.state != "await-init":
            return Err("invalid-renderer-state")
        self._begin_frame_request(browser_renderer_message_encode(
            "init", self.generation, self.next_request_id, payload
        ), "init", timeout_ms)

    me begin_theme_init(timeout_ms: i64) -> Result<bool, text>:
        if (not self.requires_theme_handshake or
            self.state != "await-theme-init"):
            return Err("invalid-renderer-state")
        val payload = hosted_theme_init_encode(
            self.theme_revision, self.theme_wire_text
        )
        val request = match payload:
            Err(reason):
                return Err(reason)
            Ok(value):
                browser_renderer_message_encode(
                    "theme_init",
                    self.generation,
                    self.next_request_id,
                    value
                )
        val started = self._begin_frame_request(
            request, "theme-init", timeout_ms
        )
        if val Ok(_) = started:
            self.state = "await-theme-ready"
        started

    me test_crash_after_ready(
        timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if self.state != "active":
            return self.fail("invalid-renderer-state")
        self._await_frame(
            browser_renderer_message_encode(
                "test_crash_after_ready", self.generation,
                self.next_request_id, ""
            ), timeout_ms, "test_crash_after_ready"
        )

    me test_hang_after_ready(
        timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if self.state != "active":
            return self.fail("invalid-renderer-state")
        self._await_frame(
            browser_renderer_message_encode(
                "test_hang_after_ready", self.generation,
                self.next_request_id, ""
            ), timeout_ms, "test_hang_after_ready"
        )

    me begin_advance(
        animation_time_ms: i64,
        timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        self._begin_frame_request(browser_renderer_advance_encode(
            self.generation,
            self.next_request_id,
            animation_time_ms
        ), "advance", timeout_ms)

    me begin_resize(
        width: i32, height: i32, timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        if width == self.width and height == self.height:
            return Ok(false)
        val started = self._begin_after_animation(
            browser_renderer_resize_encode(
                self.generation, self.next_request_id, width, height
            ),
            "resize",
            timeout_ms,
            width,
            height
        )
        if val Err(_) = started:
            self.pending_resize_width = 0
            self.pending_resize_height = 0
        started

    me begin_bookmark_snapshot(
        snapshot: BrowserBookmarkSnapshot,
        timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        var urls: [text] = []
        var titles: [text] = []
        for entry in snapshot.entries:
            urls.push(entry.first)
            titles.push(entry.second)
        self._begin_after_animation(
            browser_renderer_bookmark_snapshot_encode(
                self.generation, self.next_request_id, urls, titles
            ),
            "bookmark-snapshot",
            timeout_ms
        )

    me _begin_navigation_command(
        prepared: _HostedBrowserPreparedCommand,
        action: text,
        operation: text,
        timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        val started = self._begin_prepared_renderer_command(
            prepared, operation, timeout_ms
        )
        if val Ok(_) = started:
            self.pointer_pressed = false
            self.pending_pointer_cancel_event_id = 0
            if action != "stop":
                self.pending_scroll_event_id = 0
                self.pending_scroll_delta_milli_y = 0
        started

    me begin_navigate(
        url: text,
        method: text,
        headers: text,
        body: text,
        content_type: text,
        timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        val permit = match self._validated_navigation_permit(
            url, method, headers, body, content_type
        ):
            nil:
                return Err("invalid-navigation")
            Some(value):
                value
        val command = browser_renderer_navigation_encode(
            self.generation,
            self.next_request_id,
            "open",
            permit.url,
            permit.method,
            permit.headers,
            permit.body,
            permit.content_type
        )
        if not command.ok:
            return Err(command.reason)
        val prepared = match self._prepare_renderer_command(command):
            Err(reason): return Err(reason)
            Ok(value): value
        if not self._replace_pending_navigation():
            return Err("renderer-busy")
        self.navigation_permit = permit
        self.pending_history_action = "push"
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        self._clear_pending_document_csp()
        val started = self._begin_navigation_command(
            prepared, "open", "navigation", timeout_ms
        )
        if val Err(_) = started:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_action = ""
        started

    me begin_go_home(timeout_ms: i64) -> Result<bool, text>:
        if self.home_url == "":
            return Err("home-unconfigured")
        if self.state != "active":
            return Err("invalid-renderer-state")
        val permit = match self._validated_navigation_permit(
            self.home_url, "GET", "", "", ""
        ):
            nil:
                return Err("invalid-navigation")
            Some(value):
                value
        val command = browser_renderer_navigation_encode(
            self.generation, self.next_request_id,
            "home", permit.url, "GET", "", "", ""
        )
        if not command.ok:
            return Err(command.reason)
        val prepared = match self._prepare_renderer_command(command):
            Err(reason): return Err(reason)
            Ok(value): value
        if not self._replace_pending_navigation():
            return Err("renderer-busy")
        self.navigation_permit = permit
        self.pending_history_action = "push"
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        self._clear_pending_document_csp()
        val started = self._begin_navigation_command(
            prepared, "home", "navigation", timeout_ms
        )
        if val Err(_) = started:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_action = ""
        started

    me begin_go_back(timeout_ms: i64) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        val target_url = if self.history_back_url != "":
            self.history_back_url
        elif self.history_index > 0:
            self.history_urls[self.history_index - 1]
        else:
            ""
        if target_url == "":
            return Err("cannot-go-back")
        val permit = match self._validated_navigation_permit(
            target_url, "GET", "", "", ""
        ):
            nil:
                return Err("invalid-navigation")
            Some(value):
                value
        val capability = match browser_renderer_command_capability_new():
            Err(reason): return Err(reason)
            Ok(value): value
        val target_index = self._history_back_index(target_url)
        val traversal_urls = match self._history_urls_with_traversal(
            target_index, permit.url
        ):
            Err(reason): return Err(reason)
            Ok(value): value
        val upgraded_history_snapshot = match self._history_snapshot_for_urls(
            capability, traversal_urls
        ):
            Err(reason): return Err(reason)
            Ok(value): value
        val command = browser_renderer_navigation_encode_with_history(
            self.generation, self.next_request_id,
            "back", permit.url, "GET", "", "", "",
            upgraded_history_snapshot
        )
        if not command.ok:
            return Err(command.reason)
        val prepared = match (
            self._prepare_renderer_command_with_capability(
                command, capability
            )
        ):
            Err(reason): return Err(reason)
            Ok(value): value
        if not self._replace_pending_navigation():
            return Err("renderer-busy")
        self.navigation_permit = permit
        self.pending_history_index = target_index
        self.pending_history_target_url = permit.url
        self.provisional_document_origin = hosted_browser_network_origin(
            permit.url
        )
        self._stage_history_document_csp(self.pending_history_index)
        val started = self._begin_navigation_command(
            prepared, "back", "history", timeout_ms
        )
        if val Err(_) = started:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_index = -1
            self.pending_history_target_url = ""
            self.provisional_document_origin = ""
            self._clear_pending_document_csp()
        started

    me begin_go_forward(timeout_ms: i64) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        val target_url = if self.history_forward_url != "":
            self.history_forward_url
        elif (self.history_index >= 0 and
            self.history_index < self.history_urls.len() - 1):
            self.history_urls[self.history_index + 1]
        else:
            ""
        if target_url == "":
            return Err("cannot-go-forward")
        val permit = match self._validated_navigation_permit(
            target_url, "GET", "", "", ""
        ):
            nil:
                return Err("invalid-navigation")
            Some(value):
                value
        val capability = match browser_renderer_command_capability_new():
            Err(reason): return Err(reason)
            Ok(value): value
        val target_index = self._history_forward_index(target_url)
        val traversal_urls = match self._history_urls_with_traversal(
            target_index, permit.url
        ):
            Err(reason): return Err(reason)
            Ok(value): value
        val history_snapshot = match self._history_snapshot_for_urls(
            capability, traversal_urls
        ):
            Err(reason): return Err(reason)
            Ok(value): value
        val command = browser_renderer_navigation_encode_with_history(
            self.generation, self.next_request_id,
            "forward", permit.url, "GET", "", "", "", history_snapshot
        )
        if not command.ok:
            return Err(command.reason)
        val prepared = match (
            self._prepare_renderer_command_with_capability(
                command, capability
            )
        ):
            Err(reason): return Err(reason)
            Ok(value): value
        if not self._replace_pending_navigation():
            return Err("renderer-busy")
        self.navigation_permit = permit
        self.pending_history_index = target_index
        self.pending_history_target_url = permit.url
        self.provisional_document_origin = hosted_browser_network_origin(
            permit.url
        )
        self._stage_history_document_csp(self.pending_history_index)
        val started = self._begin_navigation_command(
            prepared, "forward", "history", timeout_ms
        )
        if val Err(_) = started:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_index = -1
            self.pending_history_target_url = ""
            self.provisional_document_origin = ""
            self._clear_pending_document_csp()
        started

    me begin_reload(timeout_ms: i64) -> Result<bool, text>:
        if self.document_url == "":
            return Err("cannot-reload")
        if self.state != "active":
            return Err("invalid-renderer-state")
        val permit = match self._validated_navigation_permit(
            self.document_url, "GET", "", "", ""
        ):
            nil:
                return Err("invalid-navigation")
            Some(value):
                value
        val command = browser_renderer_navigation_encode(
            self.generation, self.next_request_id,
            "reload", permit.url, "GET", "", "", ""
        )
        if not command.ok:
            return Err(command.reason)
        val prepared = match self._prepare_renderer_command(command):
            Err(reason): return Err(reason)
            Ok(value): value
        if not self._replace_pending_navigation():
            return Err("renderer-busy")
        self.navigation_permit = permit
        self.pending_history_action = "replace"
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        self._clear_pending_document_csp()
        val started = self._begin_navigation_command(
            prepared, "reload", "history", timeout_ms
        )
        if val Err(_) = started:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_action = ""
        started

    me begin_stop(timeout_ms: i64) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        if self.command_deadline_ms > 0:
            if self.pending_operation == "stop" or self.stop_after_write:
                return Ok(false)
            if self.pending_wire != "" and self.pending_wire_offset > 0:
                self.command_deadline_ms = _deadline_ms(timeout_ms)
                self.stop_after_write = true
                return Ok(true)
        val command = browser_renderer_navigation_encode(
            self.generation, self.next_request_id,
            "stop", "", "", "", "", ""
        )
        val prepared = match self._prepare_renderer_command(command):
            Err(reason): return Err(reason)
            Ok(value): value
        if self.command_deadline_ms > 0:
            if not self._cancel_pending_for_stop():
                return Err("renderer-busy")
        else:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_action = ""
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        self._clear_pending_document_csp()
        self._begin_navigation_command(
            prepared,
            "stop", "stop", timeout_ms
        )

    me navigate(
        url: text,
        method: text,
        headers: text,
        body: text,
        content_type: text,
        timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        match self.begin_navigate(
            url, method, headers, body, content_type, timeout_ms
        ):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me go_home(timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_go_home(timeout_ms):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me go_back(timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_go_back(timeout_ms):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me go_forward(timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_go_forward(timeout_ms):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me reload(timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_reload(timeout_ms):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me stop(timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_stop(timeout_ms):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me pointer(
        event_id: i64, x: i64, y: i64, pressed: bool, timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if self.state != "active":
            return self.fail("invalid-renderer-state")
        if pressed and self.pending_pointer_cancel_event_id > 0:
            return _renderer_result(
                false, "pointer-cancel-pending", _empty_composition()
            )
        if not pressed and not self.pointer_pressed:
            return _renderer_result(
                false, "pointer-release-target-mismatch",
                _empty_composition()
            )
        val result = self._await_frame(browser_renderer_pointer_encode(
            self.generation, self.next_request_id,
            event_id, x, y, pressed
        ), timeout_ms)
        if result.ok:
            self.pointer_pressed = pressed
        result

    me begin_pointer(
        event_id: i64, x: i64, y: i64, pressed: bool, timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        if pressed and self.pending_pointer_cancel_event_id > 0:
            return Err("pointer-cancel-pending")
        if not pressed and not self.pointer_pressed:
            return Err("pointer-release-target-mismatch")
        val started = self._begin_after_animation(browser_renderer_pointer_encode(
            self.generation, self.next_request_id,
            event_id, x, y, pressed
        ), "pointer", timeout_ms)
        if val Ok(_) = started:
            self.pointer_pressed = pressed
            if not pressed:
                self.pending_pointer_cancel_event_id = 0
        started

    me cancel_pointer(
        event_id: i64, timeout_ms: i64
    ) -> Result<bool, text>:
        if not self.pointer_pressed:
            if self.pending_pointer_cancel_event_id <= 0:
                return Ok(false)
            if self.command_deadline_ms > 0 or self.network_job_handle > 0:
                return Ok(false)
        val cancel_event_id = if self.pending_pointer_cancel_event_id > 0:
            self.pending_pointer_cancel_event_id
        else:
            event_id
        val request = browser_renderer_pointer_encode(
            self.generation, self.next_request_id,
            cancel_event_id, -1, -1, false
        )
        match self._begin_after_animation(
            request, "pointer-cancel", timeout_ms
        ):
            Err(reason):
                if reason == "renderer-busy":
                    self.pointer_pressed = false
                    self.pending_pointer_cancel_event_id = cancel_event_id
                    return Ok(true)
                Err(reason)
            Ok(started):
                self.pointer_pressed = false
                self.pending_pointer_cancel_event_id = cancel_event_id
                Ok(started)

    me flush_pointer_cancel(timeout_ms: i64) -> Result<bool, text>:
        if self.pending_pointer_cancel_event_id <= 0:
            return Ok(false)
        if self.command_deadline_ms > 0 or self.network_job_handle > 0:
            return Ok(false)
        self.cancel_pointer(
            self.pending_pointer_cancel_event_id, timeout_ms
        )

    me queue_scroll(
        event_id: i64, delta_milli_y: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        if event_id <= 0:
            return Err("invalid-action")
        var bounded = delta_milli_y
        if bounded > BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI:
            bounded = BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI
        elif bounded < 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI:
            bounded = 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI
        var combined = self.pending_scroll_delta_milli_y + bounded
        if combined > BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI:
            combined = BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI
        elif combined < 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI:
            combined = 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI
        self.pending_scroll_event_id = event_id
        self.pending_scroll_delta_milli_y = combined
        Ok(combined != 0)

    me flush_scroll(timeout_ms: i64) -> Result<bool, text>:
        if self.pending_scroll_delta_milli_y == 0:
            self.pending_scroll_event_id = 0
            return Ok(false)
        if self.state != "active":
            return Err("invalid-renderer-state")
        if self.command_deadline_ms > 0:
            return Err("renderer-busy")
        val started = self._begin_frame_request(
            browser_renderer_scroll_encode(
                self.generation,
                self.next_request_id,
                self.pending_scroll_event_id,
                self.pending_scroll_delta_milli_y
            ),
            "scroll",
            timeout_ms
        )
        if val Ok(_) = started:
            self.pending_scroll_event_id = 0
            self.pending_scroll_delta_milli_y = 0
        started

    me key(
        event_id: i64, key_code: i64, pressed: bool, timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if self.state != "active":
            return self.fail("invalid-renderer-state")
        self._await_frame(browser_renderer_key_encode(
            self.generation, self.next_request_id,
            event_id, key_code, pressed
        ), timeout_ms)

    me begin_key(
        event_id: i64, key_code: i64, pressed: bool, timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        self._begin_after_animation(browser_renderer_key_encode(
            self.generation, self.next_request_id,
            event_id, key_code, pressed
        ), "key", timeout_ms)

    me begin_key_with_shift(
        event_id: i64,
        key_code: i64,
        pressed: bool,
        shift_key: bool,
        timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        self._begin_after_animation(browser_renderer_key_with_shift_encode(
            self.generation, self.next_request_id,
            event_id, key_code, pressed, shift_key
        ), "key", timeout_ms)

    me text_input(
        event_id: i64, value: text, timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if self.state != "active":
            return self.fail("invalid-renderer-state")
        self._await_frame(browser_renderer_text_encode(
            self.generation, self.next_request_id, event_id, value
        ), timeout_ms)

    me begin_text_input(
        event_id: i64, value: text, timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        self._begin_after_animation(browser_renderer_text_encode(
            self.generation, self.next_request_id, event_id, value
        ), "text", timeout_ms)

    me chrome(
        event_id: i64, control: text, pressed: bool, timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if self.state != "active":
            return self.fail("invalid-renderer-state")
        self._await_frame(browser_renderer_chrome_encode(
            self.generation, self.next_request_id,
            event_id, control, pressed
        ), timeout_ms)

pub struct HostedBrowserAddressNavigationResult:
    callback_count: i64
    reason: text
    retain_address_focus: bool
    target_url: text

fn _hosted_browser_address_navigation_result(
    callback_count: i64,
    reason: text,
    retain_address_focus: bool,
    target_url: text
) -> HostedBrowserAddressNavigationResult:
    HostedBrowserAddressNavigationResult(
        callback_count: callback_count,
        reason: reason,
        retain_address_focus: retain_address_focus,
        target_url: target_url
    )

pub fn hosted_browser_process_activate_address(
    renderer: HostedBrowserRendererProcess,
    document_url: text,
    address_draft: text,
    timeout_ms: i64
) -> HostedBrowserAddressNavigationResult:
    """Normalize and admit one direct hosted Go/Enter navigation.

    The caller clears address focus only when callback_count is one. Failed
    normalization cannot mutate the renderer and requests focus retention;
    command admission and any later cancellation stay owned by `renderer`.
    """
    val target = match normalize_browser_address_reference_url(
        document_url, address_draft
    ):
        Err(reason):
            return _hosted_browser_address_navigation_result(
                0, reason, true, ""
            )
        Ok(url):
            url
    match renderer.begin_navigate(
        target, "GET", "", "", "", timeout_ms
    ):
        Err(reason):
            _hosted_browser_address_navigation_result(
                0, reason, true, target
            )
        Ok(_):
            _hosted_browser_address_navigation_result(
                1, "", false, target
            )
