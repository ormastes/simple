    browser_renderer_decoder_feed, browser_renderer_decoder_new,
    browser_renderer_fetch_request_decode,
    browser_renderer_frame_decode,
    browser_renderer_frame_reply_to_request_id,
    browser_renderer_key_encode, browser_renderer_key_with_shift_encode,
    browser_renderer_message_encode,
    browser_renderer_message_resequence,
    browser_renderer_navigation_encode,
    browser_renderer_network_response_encode,
    browser_renderer_pointer_encode, browser_renderer_resize_encode,
    browser_renderer_scroll_encode,
