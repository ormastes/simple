    hosted_browser_sanitize_fetch_headers
}

extern fn rt_sleep_ms(milliseconds: i64)
extern fn rt_time_now_monotonic_ms() -> i64
extern fn rt_text_to_bytes(value: text) -> [u8]
extern fn rt_browser_http_job_start_public_limited(
    scheme: text,
    host: text,
    port: i64,
    request: [u8],
    timeout_ms: i64,
    max_response_bytes: i64
) -> i64
extern fn rt_browser_http_job_poll(handle: i64) -> i64
extern fn rt_browser_http_job_take_response(handle: i64) -> [u8]
extern fn rt_browser_http_job_take_error(handle: i64) -> text
extern fn rt_browser_http_job_cancel(handle: i64) -> bool
extern fn rt_browser_http_job_free(handle: i64) -> bool

fn _hosted_browser_canonical_history_url(raw: text) -> text:
    if (raw == "" or raw != raw.trim() or raw.contains("\0") or
        raw.contains("\r") or raw.contains("\n") or
        rt_text_to_bytes(raw).len() > 8192):
        return ""
    val fragment_at = raw.index_of("#")
    val transport = if fragment_at >= 0:
        raw.slice(0, fragment_at)
    else:
        raw
    if hosted_browser_canonical_http_url(transport) != transport:
        return ""
    raw

pub struct HostedBrowserRendererResult:
    ok: bool
    reason: text
    next_animation_ms: i64
    composition: DrawIrComposition
    cpu_composited_count: i32
    cpu_composited_sha256: text
    solid_material_count: i32
    solid_material_sha256: text
    diagnostics: text

struct HostedBrowserNetworkResult:
    status: i32
    headers: text
    body: text
    error: text

fn _network_result(
    status: i32, headers: text, body: text, error: text
) -> HostedBrowserNetworkResult:
    HostedBrowserNetworkResult(
        status: status,
        headers: headers,
        body: body,
        error: error
    )

fn _renderer_wasm_hex(data: [u8]) -> text:
    var out = RtStringBuilder.new()
    for byte in data:
        val piece = byte.to_i64().to_hex()
        out.push(if piece.len() == 1: "0{piece}" else: piece)
    out.finish()

pub fn hosted_browser_network_response_limit_reason(
    kind: text, headers: text, body: [u8]
) -> text:
    if rt_text_to_bytes(headers).len() > (
        BROWSER_RENDERER_MAX_NETWORK_HEADERS_BYTES
    ):
        return "renderer-network-headers-too-large"
    val body_limit = if kind == "wasm":
        BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES / 2
    else:
        BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES
    if body.len() > body_limit:
        return "renderer-network-body-too-large"
    ""

fn _empty_composition() -> DrawIrComposition:
    draw_ir_composition("", "", "", [])

fn _renderer_result(ok: bool, reason: text, composition: DrawIrComposition) -> HostedBrowserRendererResult:
    HostedBrowserRendererResult(
        ok: ok,
        reason: reason,
        next_animation_ms: -1,
        composition: composition,
        cpu_composited_count: 0,
        cpu_composited_sha256: "",
        solid_material_count: 0,
        solid_material_sha256: "",
        diagnostics: ""
    )

fn _renderer_frame_result(
    composition: DrawIrComposition,
    next_animation_ms: i64,
    cpu_composited_count: i32,
    cpu_composited_sha256: text,
    solid_material_count: i32,
    solid_material_sha256: text,
    diagnostics: text
) -> HostedBrowserRendererResult:
    HostedBrowserRendererResult(
        ok: true,
        reason: "ok",
        next_animation_ms: next_animation_ms,
        composition: composition,
        cpu_composited_count: cpu_composited_count,
        cpu_composited_sha256: cpu_composited_sha256,
        solid_material_count: solid_material_count,
        solid_material_sha256: solid_material_sha256,
        diagnostics: diagnostics
    )

fn _deadline_ms(timeout_ms: i64) -> i64:
    rt_time_now_monotonic_ms() + (
        if timeout_ms > 0: timeout_ms else: 2000
    )

pub class HostedBrowserRendererProcess:
    pid: i64
    generation: i64
    width: i32
    height: i32
    next_request_id: i64
    expected_reply_to_request_id: i64
    command_deadline_ms: i64
    pending_operation: text
    hang_acknowledged: bool
    next_animation_ms: i64
    pending_resize_width: i32
    pending_resize_height: i32
    decoder: BrowserRendererDecoder
    network: FetchEngine
    network_job_handle: i64
    network_job_fetch: BrowserRendererNetworkDecodeResult?
    network_job_policy: HostedBrowserRequestPolicy?
    network_job_request: FetchRequest?
    network_job_redirect_count: i64
    pending_wire: text
    pending_wire_offset: i64
    pending_wire_reply_to_request_id: i64
    pending_wire_is_command: bool
    deferred_wire: text
    deferred_operation: text
    deferred_timeout_ms: i64
    deferred_resize_width: i32
    deferred_resize_height: i32
    pending_scroll_event_id: i64
    pending_scroll_delta_milli_y: i64
    document_url: text
    document_origin: text
    navigation_permit: HostedBrowserNavigationPermit
    history_urls: [text]
    history_index: i64
    pending_history_index: i64
    pending_history_target_url: text
    history_current_url: text
    history_back_url: text
    history_forward_url: text
    home_url: text
    pending_history_action: text
    pending_document_commit_url: text
    provisional_document_origin: text
    hsts: BrowserSession
    hsts_dirty: bool
    state: text

    static fn create(
        generation: i64,
        width: i32,
        height: i32
    ) -> HostedBrowserRendererProcess:
        HostedBrowserRendererProcess(
            pid: 0,
            generation: generation,
            width: width,
            height: height,
            next_request_id: 2,
            expected_reply_to_request_id: 0,
            command_deadline_ms: 0,
            pending_operation: "",
            hang_acknowledged: false,
            next_animation_ms: -1,
            pending_resize_width: 0,
            pending_resize_height: 0,
            decoder: browser_renderer_decoder_new(generation),
            network: FetchEngine.new(
                Logger.new("browser-renderer-broker", LogLevel.Error)
            ),
            network_job_handle: 0,
            network_job_fetch: nil,
            network_job_policy: nil,
            network_job_request: nil,
            network_job_redirect_count: 0,
            pending_wire: "",
            pending_wire_offset: 0,
            pending_wire_reply_to_request_id: 0,
            pending_wire_is_command: false,
            deferred_wire: "",
            deferred_operation: "",
            deferred_timeout_ms: 0,
            deferred_resize_width: 0,
            deferred_resize_height: 0,
            pending_scroll_event_id: 0,
            pending_scroll_delta_milli_y: 0,
            document_url: "",
            document_origin: "",
            navigation_permit: hosted_browser_empty_navigation_permit(),
            history_urls: [],
            history_index: -1,
            pending_history_index: -1,
            pending_history_target_url: "",
            history_current_url: "",
            history_back_url: "",
            history_forward_url: "",
            home_url: "",
            pending_history_action: "",
            pending_document_commit_url: "",
            provisional_document_origin: "",
            hsts: BrowserSession.new_without_runtime(),
            hsts_dirty: false,
            state: "new"
        )

    me load_hsts_snapshot(
        snapshot: BrowserHstsSnapshot, wall_clock_ms: i64
    ) -> i32:
        val _ = self.hsts.advance_time(rt_time_now_monotonic_ms())
        self.hsts_dirty = false
        self.hsts.load_hsts_snapshot(snapshot, wall_clock_ms)

    me hsts_snapshot(wall_clock_ms: i64) -> BrowserHstsSnapshot:
        val _ = self.hsts.advance_time(rt_time_now_monotonic_ms())
        self.hsts.hsts_snapshot(wall_clock_ms)

    me _hsts_upgrade_url(url: text) -> text:
        val _ = self.hsts.advance_time(rt_time_now_monotonic_ms())
        self.hsts._hsts_upgrade_url(url)

    me authorize_navigation(
        url: text,
        method: text,
        headers: text,
        body: text,
        content_type: text
    ) -> bool:
        val canonical_url = hosted_browser_canonical_http_url(
            self._hsts_upgrade_url(url)
        )
        val canonical_method = method.to_upper()
        if (canonical_url == "" or
            (canonical_method != "GET" and canonical_method != "POST") or
            rt_text_to_bytes(body).len() > 524288):
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_action = ""
            self.pending_document_commit_url = ""
            self.provisional_document_origin = ""
            return false
        val sanitized_headers = match hosted_browser_sanitize_fetch_headers(
            headers, content_type
        ):
            Err(_):
                self.navigation_permit = hosted_browser_empty_navigation_permit()
                self.pending_history_action = ""
                self.pending_document_commit_url = ""
                self.provisional_document_origin = ""
                return false
            Ok(value):
                value
        self.navigation_permit = HostedBrowserNavigationPermit(
            active: true,
            url: canonical_url,
            method: canonical_method,
            headers: sanitized_headers,
            body: body,
            content_type: content_type,
            redirect_count: 0
        )
        self.pending_history_action = "push"
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        true

    me set_home_url(url: text) -> bool:
        val canonical_url = hosted_browser_canonical_http_url(url)
        if canonical_url == "":
            return false
        self.home_url = canonical_url
        true

    me _commit_document_url(url: text):
        self.document_url = url
        self.document_origin = hosted_browser_network_origin(url)
        self.provisional_document_origin = ""
        if self.pending_history_action == "push":
            var next_history: [text] = []
            var index: i64 = 0
            while (index <= self.history_index and
                index < self.history_urls.len()):
                next_history.push(self.history_urls[index])
                index = index + 1
            next_history.push(url)
            if next_history.len() > 64:
                var bounded: [text] = []
                index = next_history.len() - 64
                while index < next_history.len():
                    bounded.push(next_history[index])
                    index = index + 1
                next_history = bounded
            self.history_urls = next_history
            self.history_index = self.history_urls.len() - 1
        elif (self.pending_history_action == "replace" and
            self.history_index >= 0 and
            self.history_index < self.history_urls.len()):
            self.history_urls[self.history_index] = url
        self.pending_history_action = ""
        self._sync_history_neighbors_from_ledger()

    me _sync_history_neighbors_from_ledger():
        self.history_current_url = self.document_url
        self.history_back_url = ""
        self.history_forward_url = ""
        if self.history_index > 0:
            self.history_back_url = self.history_urls[self.history_index - 1]
        if (self.history_index >= 0 and
            self.history_index < self.history_urls.len() - 1):
            self.history_forward_url = self.history_urls[self.history_index + 1]

    fn _history_back_index(url: text) -> i64:
        var index = self.history_index
        if (index >= 0 and index < self.history_urls.len() and
            self.history_urls[index] == self.history_current_url):
            index = index - 1
        while index >= 0:
            if self.history_urls[index] == url:
                return index
            index = index - 1
        -1

    fn _history_forward_index(url: text) -> i64:
        var index = self.history_index
        if index < 0:
            index = 0
        elif (index < self.history_urls.len() and
            self.history_urls[index] == self.history_current_url):
            index = index + 1
        while index < self.history_urls.len():
            if self.history_urls[index] == url:
                return index
            index = index + 1
        -1

    fn _history_neighbor_allowed(url: text, current_url: text) -> bool:
        if url == "":
            return true
        val canonical = _hosted_browser_canonical_history_url(url)
        if canonical == "":
            return false
        if hosted_browser_network_origin(canonical) == (
            hosted_browser_network_origin(current_url)
        ):
            return true
        (canonical == self.document_url or
            canonical == self.history_current_url or
            canonical == self.history_back_url or
            canonical == self.history_forward_url or
            (self.history_index > 0 and
                self.history_urls[self.history_index - 1] == canonical) or
            (self.history_index >= 0 and
                self.history_index < self.history_urls.len() - 1 and
                self.history_urls[self.history_index + 1] == canonical))

    fn _frame_history_state_valid(
        current_url: text, back_url: text, forward_url: text
    ) -> bool:
        val current = _hosted_browser_canonical_history_url(current_url)
        if current == "":
            return false
        var trusted_url = self.document_url
        if self.pending_document_commit_url != "":
            trusted_url = self.pending_document_commit_url
        elif self.pending_history_target_url != "":
            trusted_url = self.pending_history_target_url
        elif (self.pending_history_index >= 0 and
            self.pending_history_index < self.history_urls.len()):
            trusted_url = self.history_urls[self.pending_history_index]
        val trusted = _hosted_browser_canonical_history_url(trusted_url)
        if (trusted == "" or hosted_browser_network_origin(current) !=
            hosted_browser_network_origin(trusted)):
            return false
        (self._history_neighbor_allowed(back_url, current) and
            self._history_neighbor_allowed(forward_url, current))

    me _apply_frame_history_state(
        current_url: text, back_url: text, forward_url: text
    ):
        self.document_url = current_url
        self.document_origin = hosted_browser_network_origin(current_url)
        self.history_current_url = current_url
        self.history_back_url = back_url
        self.history_forward_url = forward_url

    me _cancel_network_job():
        val handle = self.network_job_handle
        self.network_job_handle = 0
        self.network_job_fetch = nil
        self.network_job_policy = nil
        self.network_job_request = nil
        self.network_job_redirect_count = 0
        if handle > 0:
            val _ = rt_browser_http_job_cancel(handle)
            val _ = rt_browser_http_job_free(handle)

    fn _requester_origin() -> text:
        if self.provisional_document_origin != "":
            return self.provisional_document_origin
        self.document_origin

    me _replace_pending_navigation() -> bool:
        if self.command_deadline_ms <= 0:
            return true
        if (self.deferred_wire != "" or self.network_job_handle > 0 or
            self.pending_wire == "" or not self.pending_wire_is_command or
            self.pending_wire_offset > 0):
            return false
        self.pending_wire = ""
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = 0
        self.pending_wire_is_command = false
        self.command_deadline_ms = 0
        self.pending_operation = ""
        self.next_animation_ms = -1
        self.pending_resize_width = 0
        self.pending_resize_height = 0
        self.pending_history_index = -1
        self.pending_history_target_url = ""
        self.navigation_permit = hosted_browser_empty_navigation_permit()
        self.pending_history_action = ""
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        true

    me _cancel_pending_for_stop() -> bool:
        if self.pending_wire != "" and self.pending_wire_offset > 0:
            return false
        self.pending_wire = ""
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = 0
        self.pending_wire_is_command = false
        self.deferred_wire = ""
        self.deferred_operation = ""
        self.deferred_timeout_ms = 0
        self.deferred_resize_width = 0
        self.deferred_resize_height = 0
        self.pending_scroll_event_id = 0
        self.pending_scroll_delta_milli_y = 0
        self._cancel_network_job()
        self.command_deadline_ms = 0
        self.pending_operation = ""
        self.next_animation_ms = -1
        self.pending_resize_width = 0
        self.pending_resize_height = 0
        self.pending_history_index = -1
        self.pending_history_target_url = ""
        self.navigation_permit = hosted_browser_empty_navigation_permit()
        self.pending_history_action = ""
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        true

    me close() -> bool:
        self._cancel_network_job()
        self.command_deadline_ms = 0
        self.pending_operation = ""
        self.next_animation_ms = -1
        self.pending_resize_width = 0
        self.pending_resize_height = 0
        self.pending_history_index = -1
        self.pending_history_target_url = ""
        self.navigation_permit = hosted_browser_empty_navigation_permit()
        self.pending_history_action = ""
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        self.pending_wire = ""
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = 0
        self.pending_wire_is_command = false
        self.deferred_wire = ""
        self.deferred_operation = ""
        self.deferred_timeout_ms = 0
        self.deferred_resize_width = 0
        self.deferred_resize_height = 0
        self.pending_scroll_event_id = 0
        self.pending_scroll_delta_milli_y = 0
        if self.pid > 0:
            if not process_close_piped(self.pid):
                return false
        self.pid = 0
        self.decoder = browser_renderer_decoder_new(self.generation)
        self.network = FetchEngine.new(
            Logger.new("browser-renderer-broker", LogLevel.Error)
        )
        self.history_urls = []
        self.history_index = -1
        self.history_current_url = ""
        self.history_back_url = ""
        self.history_forward_url = ""
        self.document_url = ""
        self.document_origin = ""
        self.home_url = ""
        if self.state != "failed":
            self.state = "closed"
        true

    me fail(reason: text) -> HostedBrowserRendererResult:
        self.state = "failed"
        val close_reason = if self.close():
            ""
        else:
            ";renderer-close-failed"
        _renderer_result(false, reason + close_reason, _empty_composition())

    me begin_start(executable: text, timeout_ms: i64) -> Result<bool, text>:
        if self.state != "new" or executable == "" or self.generation <= 0 or
            self.width <= 0 or self.height <= 0:
            return Err("invalid-launch")
        self.pid = browser_renderer_spawn_sandboxed(executable, [
            BROWSER_RENDERER_WORKER_ARG,
            self.generation.to_text(),
            self.width.to_text(),
            self.height.to_text()
        ])
        if self.pid <= 0:
            self.pid = 0
            self.state = "failed"
            return Err("sandbox-unavailable")
        self.state = "starting"
        self.command_deadline_ms = _deadline_ms(timeout_ms)
        self.pending_operation = "start"
        Ok(true)

    me start(executable: text, timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_start(executable, timeout_ms):
            Err(reason):
                self.fail(reason)
            Ok(_):
                self._await_pending()

    me _finalize_network(
        kind: text,
        request: FetchRequest,
        response: FetchResponse,
        authenticated_https: bool
    ) -> HostedBrowserNetworkResult:
        if authenticated_https and request.url.scheme == "https":
            val hsts_header = hosted_browser_response_header_value(
                response.headers, "strict-transport-security"
            )
            if (hsts_header != "" and self.hsts._apply_hsts_header(
                hsts_header, request.url.to_text()
            )):
                self.hsts_dirty = true
        match self.network.finalize_single_hop(request, response):
            Err(error):
                _network_result(0, "", "", error.message)
            Ok(finalized):
                self._network_response(kind, finalized)

    fn _network_response(
        kind: text, response: FetchResponse
    ) -> HostedBrowserNetworkResult:
        val limit_reason = hosted_browser_network_response_limit_reason(
            kind, response.headers, response.body
        )
        if limit_reason != "":
            return _network_result(0, "", "", limit_reason)
        val body = if kind == "wasm":
            _renderer_wasm_hex(response.body)
        else:
            response.body_text()
        if rt_text_to_bytes(body).len() > (
            BROWSER_RENDERER_MAX_NETWORK_BODY_BYTES
        ):
            return _network_result(
                0, "", "", "renderer-network-body-too-large"
            )
        _network_result(
            response.status.to_i32(),
            response.headers,
            body,
            ""
        )

    me _start_network_job(
        fetch: BrowserRendererNetworkDecodeResult,
        policy: HostedBrowserRequestPolicy,
        redirect_count: i64
    ) -> HostedBrowserNetworkResult?:
        val request = FetchRequest(
            url: Url.parse(policy.canonical_url),
            method: fetch.method,
            headers: policy.sanitized_headers,
            body: rt_text_to_bytes(fetch.body),
            mode: policy.mode,
            credentials: "omit"
        )
        self.network.set_requester_origin(self._requester_origin())
        match self.network.prepare_single_hop(request):
            Err(error):
                return Some(_network_result(
                    0, "", "", error.message
                ))
            Ok(prepared):
                if val Some(response) = prepared.response:
                    return Some(self._network_response(
                        fetch.kind, response
                    ))
                if val Some(mock_result) = h1_mock_response(prepared.request):
                    match mock_result:
                        Err(error):
                            return Some(_network_result(
                                0, "", "", error.message
                            ))
                        Ok(response):
                            return Some(self._finalize_network(
                                fetch.kind, prepared.request, response, false
                            ))
                val url = prepared.request.url
                val port = if url.port > 0:
                    url.port
                elif url.scheme == "https":
                    443
                else:
                    80
                val remaining_ms = (
                    self.command_deadline_ms -
                    rt_time_now_monotonic_ms()
                )
                if remaining_ms <= 0:
                    return Some(_network_result(
                        0, "", "", "renderer-network-timeout"
                    ))
                val raw_limit = if fetch.kind == "wasm":
                    327680
                else:
                    589824
                val handle = rt_browser_http_job_start_public_limited(
                    url.scheme,
                    url.host,
                    port,
                    rt_text_to_bytes(build_request_bytes(prepared.request)),
                    remaining_ms,
                    raw_limit
                )
                if handle < 0:
                    return Some(_network_result(
                        0, "", "", "renderer-network-unavailable"
                    ))
                self.network_job_handle = handle
                self.network_job_fetch = Some(fetch)
                self.network_job_policy = Some(policy)
                self.network_job_request = Some(prepared.request)
                self.network_job_redirect_count = redirect_count
                nil

    me _record_document_response(
        request: BrowserRendererNetworkDecodeResult,
        policy: HostedBrowserRequestPolicy,
        response: HostedBrowserNetworkResult,
        redirect_count: i64
    ) -> Result<text, text>:
        if response.status <= 0:
            return Ok(response.headers)
        if not hosted_browser_redirect_status(response.status):
            self.pending_document_commit_url = policy.canonical_url
            self.provisional_document_origin = hosted_browser_network_origin(
                policy.canonical_url
            )
            return Ok(response.headers)
        val location = hosted_browser_response_header_value(
            response.headers, "location"
        )
        if location == "" or redirect_count >= 20:
            return Err("invalid-navigation-redirect")
        val base = Url.parse(policy.canonical_url)
        val redirected = resolve_fetch_redirect_url(base, location)
        val original_redirected_url = hosted_browser_canonical_http_url(
            redirected.to_text()
        )
        val redirected_url = hosted_browser_canonical_http_url(
            self._hsts_upgrade_url(original_redirected_url)
        )
        if (redirected_url == "" or
            (base.scheme == "https" and
                not redirected_url.starts_with("https://"))):
            return Err("invalid-navigation-redirect")
        val prior_method = request.method.to_upper()
        val next_method = if response.status == 303 or
            ((response.status == 301 or response.status == 302) and
                prior_method == "POST"):
            "GET"
        else:
            prior_method
        val preserve_body = next_method != "GET" and next_method != "HEAD"
        val same_origin = hosted_browser_network_origin(
            policy.canonical_url
        ) == hosted_browser_network_origin(redirected_url)
        val next_content_type = if preserve_body:
            request.content_type
        else:
            ""
        val next_headers = if same_origin:
            policy.sanitized_headers
        elif next_content_type != "":
            "Content-Type: {next_content_type}"
        else:
            ""
        self.navigation_permit = HostedBrowserNavigationPermit(
            active: true,
            url: redirected_url,
            method: next_method,
            headers: next_headers,
            body: if preserve_body: request.body else: "",
            content_type: next_content_type,
            redirect_count: redirect_count + 1
        )
        if redirected_url != original_redirected_url:
            return Ok(hosted_browser_replace_response_header(
                response.headers, "Location", redirected_url
            ))
        Ok(response.headers)

    me _write_network_response(
        fetch: BrowserRendererNetworkDecodeResult,
        policy: HostedBrowserRequestPolicy,
        response: HostedBrowserNetworkResult,
        redirect_count: i64,
        transport_upgrade: bool = false
    ) -> text:
        var response_headers = response.headers
        if policy.consumes_navigation:
            match self._record_document_response(
                fetch, policy, response, redirect_count
            ):
                Err(reason):
                    return reason
                Ok(headers):
                    response_headers = headers
        if hosted_browser_redirect_status(response.status):
            val location = hosted_browser_response_header_value(
                response_headers, "location"
            )
            if location != "":
                val redirected = resolve_fetch_redirect_url(
                    Url.parse(policy.canonical_url), location
                )
                val redirect_url = hosted_browser_canonical_http_url(
                    redirected.to_text()
                )
                val effective_redirect_url = self._hsts_upgrade_url(
                    redirect_url
                )
                if (redirect_url != "" and
                    effective_redirect_url != redirect_url and
                    hosted_browser_hsts_upgrade_valid(
                        redirect_url, effective_redirect_url
                    )):
                    response_headers = hosted_browser_replace_response_header(
                        response_headers, "Location",
                        effective_redirect_url
                    )
        response_headers = hosted_browser_remove_response_header(
            response_headers, "strict-transport-security"
        )
        response_headers = hosted_browser_remove_response_header(
            response_headers, "x-simple-broker-transport-upgrade"
        )
        if policy.mode == RequestMode.Cors:
            response_headers = hosted_browser_cors_response_headers(
                response_headers,
                hosted_browser_redirect_status(response.status)
            )
        if transport_upgrade:
            if response_headers != "":
                response_headers = response_headers + "\r\n"
            response_headers = response_headers +
                "X-Simple-Broker-Transport-Upgrade: 1"
        val wire = browser_renderer_network_response_encode(
            self.generation,
            self.next_request_id,
            fetch.request_id,
            fetch.kind,
            fetch.url,
            response.status,
            response_headers,
            response.body,
            response.error
        )
        if not wire.ok:
            return wire.reason
        if self.pending_wire != "":
            return "renderer-write-state"
        self.pending_wire = wire.wire
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = self.next_request_id
        self.pending_wire_is_command = false
        ""

    me _queue_hsts_transport_upgrade(
        fetch: BrowserRendererNetworkDecodeResult,
        policy: HostedBrowserRequestPolicy,
        redirect_count: i64
    ) -> text:
        self._write_network_response(
            fetch,
            policy,
            _network_result(
                307,
                "Location: {policy.canonical_url}",
                "",
                ""
            ),
            redirect_count,
            true
        )

    me _flush_pending_wire_once() -> text:
        if self.pending_wire == "":
            return ""
        val written = process_write_stdin_some(
            self.pid,
            self.pending_wire,
            self.pending_wire_offset,
            8192
        )
        if written < 0:
            return "renderer-write-failed"
        if written == 0:
            if not process_is_piped_alive(self.pid):
                self.pid = 0
                return "renderer-crashed"
            return ""
        self.pending_wire_offset = self.pending_wire_offset + written
        if self.pending_wire_offset >= self.pending_wire.len():
            self.expected_reply_to_request_id = (
                self.pending_wire_reply_to_request_id
            )
            self.next_request_id = (
                self.pending_wire_reply_to_request_id + 1
            )
            self.pending_wire = ""
            self.pending_wire_offset = 0
            self.pending_wire_reply_to_request_id = 0
            self.pending_wire_is_command = false
        ""

    me _poll_network_job() -> text:
        if self.network_job_handle <= 0:
            return ""
        if (self.network_job_fetch == nil or
            self.network_job_policy == nil or
            self.network_job_request == nil):
            self._cancel_network_job()
            return "renderer-network-state"
        val state = rt_browser_http_job_poll(self.network_job_handle)
        if state == 0:
            return ""
        val handle = self.network_job_handle
        val fetch = self.network_job_fetch.unwrap()
        val policy = self.network_job_policy.unwrap()
        val request = self.network_job_request.unwrap()
        val redirect_count = self.network_job_redirect_count
        self.network_job_handle = 0
        self.network_job_fetch = nil
        self.network_job_policy = nil
        self.network_job_request = nil
        self.network_job_redirect_count = 0
        var response = _network_result(
            0, "", "", "renderer-network-unavailable"
        )
        if state < 0:
            val _ = rt_browser_http_job_free(handle)
        else:
            val error = rt_browser_http_job_take_error(handle)
            val raw_response = rt_browser_http_job_take_response(handle)
            val _ = rt_browser_http_job_free(handle)
            if error != "":
                response = _network_result(0, "", "", error)
            else:
                match parse_http_response_bytes(raw_response):
                    Err(parse_error):
                        response = _network_result(
                            0, "", "", parse_error.message
                        )
                    Ok(parsed):
                        response = self._finalize_network(
                            fetch.kind, request, parsed,
                            request.url.scheme == "https"
                        )
        self._write_network_response(
            fetch, policy, response, redirect_count
        )

    me _begin_frame_request(
        request: BrowserRendererEncodeResult,
        operation: text,
        timeout_ms: i64
    ) -> Result<bool, text>:
        if self.command_deadline_ms > 0:
            return Err("renderer-busy")
        if not request.ok:
            return Err(request.reason)
        val deadline = _deadline_ms(timeout_ms)
        self.pending_wire = request.wire
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = self.next_request_id
        self.pending_wire_is_command = true
        self.command_deadline_ms = deadline
        self.pending_operation = operation
        self.hang_acknowledged = false
        Ok(true)

    me _begin_after_animation(
        request: BrowserRendererEncodeResult,
        operation: text,
        timeout_ms: i64,
        resize_width: i32 = 0,
        resize_height: i32 = 0
    ) -> Result<bool, text>:
        if self.command_deadline_ms <= 0:
            self.pending_resize_width = resize_width
            self.pending_resize_height = resize_height
            return self._begin_frame_request(
                request, operation, timeout_ms
            )
        if (self.pending_operation != "advance" or
            self.network_job_handle > 0 or self.deferred_wire != "" or
            not request.ok):
            return Err(if request.ok: "renderer-busy" else: request.reason)
        if self.pending_wire != "" and self.pending_wire_is_command:
            if self.pending_wire_offset > 0:
                return Err("renderer-busy")
            self.pending_wire = ""
            self.pending_wire_offset = 0
            self.pending_wire_reply_to_request_id = 0
            self.pending_wire_is_command = false
            self.command_deadline_ms = 0
            self.pending_operation = ""
            self.pending_resize_width = resize_width
            self.pending_resize_height = resize_height
            return self._begin_frame_request(
                request, operation, timeout_ms
            )
        self.deferred_wire = request.wire
        self.deferred_operation = operation
        self.deferred_timeout_ms = timeout_ms
        self.deferred_resize_width = resize_width
        self.deferred_resize_height = resize_height
        Ok(true)

    me _activate_deferred_command() -> text:
        if self.deferred_wire == "":
            return ""
        val request = browser_renderer_message_resequence(
            self.deferred_wire, self.generation, self.next_request_id
        )
        if not request.ok:
            return request.reason
        self.pending_wire = request.wire
        self.pending_wire_offset = 0
        self.pending_wire_reply_to_request_id = self.next_request_id
        self.pending_wire_is_command = true
        self.command_deadline_ms = _deadline_ms(self.deferred_timeout_ms)
        self.pending_operation = self.deferred_operation
        self.pending_resize_width = self.deferred_resize_width
        self.pending_resize_height = self.deferred_resize_height
        self.deferred_wire = ""
        self.deferred_operation = ""
        self.deferred_timeout_ms = 0
        self.deferred_resize_width = 0
        self.deferred_resize_height = 0
        ""

    me poll() -> HostedBrowserRendererResult?:
        if self.command_deadline_ms <= 0:
            return nil
        if rt_time_now_monotonic_ms() >= (
            self.command_deadline_ms
        ):
            if (self.pending_operation == "test_hang_after_ready" and
                not self.hang_acknowledged):
                return Some(self.fail("renderer-hang-unacknowledged"))
            return Some(self.fail("renderer-timeout"))
        if self.state == "starting":
            val chunk = process_read_stdout(self.pid)
            val decoded = browser_renderer_decoder_feed(self.decoder, chunk)
            self.decoder = decoded.decoder
            if decoded.status == "violation":
                return Some(self.fail(decoded.decoder.error))
            if decoded.status == "message":
                if (decoded.message.kind != "ready" or
                    decoded.message.request_id != 1 or
                    decoded.message.payload != ""):
                    return Some(self.fail("expected-ready"))
                self.command_deadline_ms = 0
                self.pending_operation = ""
                self.state = "await-init"
                return Some(_renderer_result(
                    true, "ok", _empty_composition()
                ))
            if chunk == "" and not process_is_piped_alive(self.pid):
                self.pid = 0
                return Some(self.fail("renderer-crashed"))
            return nil
        if self.pending_wire != "":
            val reason = self._flush_pending_wire_once()
            if reason != "":
                return Some(self.fail(reason))
            return nil
        if self.network_job_handle > 0:
            val reason = self._poll_network_job()
            if reason != "":
                return Some(self.fail(reason))
            return nil
        val chunk = process_read_stdout(self.pid)
        val decoded = browser_renderer_decoder_feed(self.decoder, chunk)
        self.decoder = decoded.decoder
        if decoded.status == "violation":
            return Some(self.fail(decoded.decoder.error))
        if decoded.status == "message":
            if decoded.message.kind == "test_hang_ready":
                if (self.pending_operation != "test_hang_after_ready" or
                    self.hang_acknowledged or
                    decoded.message.request_id != (
                        self.expected_reply_to_request_id
                    ) or decoded.message.payload != ""):
                    return Some(self.fail("unexpected-test-hang-ready"))
                self.hang_acknowledged = true
                return nil
            if decoded.message.kind == "fetch_request":
                val fetch = browser_renderer_fetch_request_decode(
                    decoded.message
                )
                if not fetch.ok:
                    return Some(self.fail(fetch.reason))
                if fetch.reply_to_request_id < (
                    self.expected_reply_to_request_id
                ):
                    return nil
                if fetch.reply_to_request_id > (
                    self.expected_reply_to_request_id
                ):
                    return Some(self.fail("stale-renderer-request"))
                val effective_url = self._hsts_upgrade_url(fetch.url)
                val policy = hosted_browser_renderer_request_policy(
                    self._requester_origin(),
                    self.navigation_permit,
                    fetch,
                    effective_url
                )
                if not policy.ok:
                    if (policy.reason == "mixed-content-blocked" or
                        policy.reason ==
                            "cross-origin-preflight-unavailable"):
                        val reason = self._write_network_response(
                            fetch,
                            policy,
                            _network_result(
                                0, "", "", policy.reason
                            ),
                            0
                        )
                        if reason != "":
                            return Some(self.fail(reason))
                        return nil
                    return Some(self.fail(policy.reason))
                var redirect_count: i64 = 0
                if policy.consumes_navigation:
                    redirect_count = self.navigation_permit.redirect_count
                    self.navigation_permit = (
                        hosted_browser_empty_navigation_permit()
                    )
                val request_url = hosted_browser_canonical_http_url(fetch.url)
                if (fetch.kind != "document" and
                    policy.canonical_url != request_url):
                    val reason = self._queue_hsts_transport_upgrade(
                        fetch, policy, redirect_count
                    )
                    if reason != "":
                        return Some(self.fail(reason))
                    return nil
                if val Some(response) = self._start_network_job(
                    fetch, policy, redirect_count
                ):
                    val reason = self._write_network_response(
                        fetch, policy, response, redirect_count
                    )
                    if reason != "":
                        return Some(self.fail(reason))
                return nil
            val frame_reply_to_request_id = (
                browser_renderer_frame_reply_to_request_id(decoded.message)
            )
            if frame_reply_to_request_id <= 0:
                return Some(self.fail("malformed-material-witness"))
            if frame_reply_to_request_id < (
                self.expected_reply_to_request_id
            ):
                return nil
            if frame_reply_to_request_id > (
                self.expected_reply_to_request_id
            ):
                return Some(self.fail("stale-renderer-frame"))
            val decode_width = if self.pending_operation == "resize":
                self.pending_resize_width
            else:
                self.width
            val decode_height = if self.pending_operation == "resize":
                self.pending_resize_height
            else:
                self.height
            val frame = browser_renderer_frame_decode(
                decoded.message, decode_width, decode_height
            )
            if not frame.ok:
                return Some(self.fail(frame.reason))
            val has_trusted_document = (
                self.document_url != "" or
                self.pending_document_commit_url != ""
            )
            val unchanged_history_state = (
                self.pending_document_commit_url == "" and
                self.pending_history_target_url == "" and
                self.pending_history_index < 0 and
                frame.history_current_url == self.history_current_url and
                frame.history_back_url == self.history_back_url and
                frame.history_forward_url == self.history_forward_url
            )
            if (frame.history_state_present and has_trusted_document and
                not unchanged_history_state and
                not self._frame_history_state_valid(
                    frame.history_current_url,
                    frame.history_back_url,
                    frame.history_forward_url
                )):
                return Some(self.fail("invalid-frame-history"))
            if self.pending_document_commit_url != "":
                self._commit_document_url(
                    self.pending_document_commit_url
                )
                self.pending_document_commit_url = ""
                self.provisional_document_origin = ""
            if self.pending_history_index >= 0:
                self.history_index = self.pending_history_index
                self.document_url = self.history_urls[self.history_index]
                self.document_origin = hosted_browser_network_origin(
                    self.document_url
                )
                self.provisional_document_origin = ""
                self._sync_history_neighbors_from_ledger()
            if (frame.history_state_present and has_trusted_document and
                not unchanged_history_state):
                self._apply_frame_history_state(
                    frame.history_current_url,
                    frame.history_back_url,
                    frame.history_forward_url
                )
            self.pending_history_index = -1
            self.pending_history_target_url = ""
            if self.pending_operation == "resize":
                self.width = self.pending_resize_width
                self.height = self.pending_resize_height
            self.pending_resize_width = 0
            self.pending_resize_height = 0
            self.next_animation_ms = frame.next_animation_ms
            self.command_deadline_ms = 0
            self.pending_operation = ""
            val deferred_reason = self._activate_deferred_command()
            if deferred_reason != "":
                return Some(self.fail(deferred_reason))
            self.state = "active"
            return Some(_renderer_frame_result(
                frame.composition,
                frame.next_animation_ms,
                frame.cpu_composited_count,
                frame.cpu_composited_sha256,
                frame.solid_material_count,
                frame.solid_material_sha256,
                frame.diagnostics
            ))
        if chunk == "" and not process_is_piped_alive(self.pid):
            self.pid = 0
            return Some(self.fail("renderer-crashed"))
        nil

    me _await_frame(
        request: BrowserRendererEncodeResult,
        timeout_ms: i64,
        operation: text = "sync"
    ) -> HostedBrowserRendererResult:
        match self._begin_frame_request(request, operation, timeout_ms):
            Err(reason):
                if reason == "renderer-busy":
                    return _renderer_result(
                        false, reason, _empty_composition()
                    )
                return self.fail(reason)
            Ok(_):
                return self._await_pending()
        self.fail("renderer-timeout")

    me _await_pending() -> HostedBrowserRendererResult:
        while true:
            if val Some(result) = self.poll():
                return result
            rt_sleep_ms(1)
        self.fail("renderer-timeout")

    me render(
        kind: text,
        payload: text,
        timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if ((self.state == "await-init" and kind != "init") or
            (self.state == "active" and kind != "advance") or
            (self.state != "await-init" and self.state != "active")):
            return self.fail("invalid-renderer-state")
        val request = if kind == "advance":
            browser_renderer_advance_encode(
                self.generation,
                self.next_request_id,
                payload.to_i64() ?? -1
            )
        else:
            browser_renderer_message_encode(
                kind, self.generation, self.next_request_id, payload
            )
        self._await_frame(request, timeout_ms)

    me begin_init(payload: text, timeout_ms: i64) -> Result<bool, text>:
        if self.state != "await-init":
            return Err("invalid-renderer-state")
        self._begin_frame_request(browser_renderer_message_encode(
            "init", self.generation, self.next_request_id, payload
        ), "init", timeout_ms)

    me test_crash_after_ready(
        timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if self.state != "active":
            return self.fail("invalid-renderer-state")
        self._await_frame(
            browser_renderer_message_encode(
                "test_crash_after_ready", self.generation,
                self.next_request_id, ""
            ), timeout_ms, "test_crash_after_ready"
        )

    me test_hang_after_ready(
        timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if self.state != "active":
            return self.fail("invalid-renderer-state")
        self._await_frame(
            browser_renderer_message_encode(
                "test_hang_after_ready", self.generation,
                self.next_request_id, ""
            ), timeout_ms, "test_hang_after_ready"
        )

    me begin_advance(
        animation_time_ms: i64,
        timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        self._begin_frame_request(browser_renderer_advance_encode(
            self.generation,
            self.next_request_id,
            animation_time_ms
        ), "advance", timeout_ms)

    me begin_resize(
        width: i32, height: i32, timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        if width == self.width and height == self.height:
            return Ok(false)
        val started = self._begin_after_animation(
            browser_renderer_resize_encode(
                self.generation, self.next_request_id, width, height
            ),
            "resize",
            timeout_ms,
            width,
            height
        )
        if val Err(_) = started:
            self.pending_resize_width = 0
            self.pending_resize_height = 0
        started

    me _begin_navigation_command(
        action: text,
        url: text,
        method: text,
        headers: text,
        body: text,
        content_type: text,
        operation: text,
        timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        val started = self._begin_frame_request(browser_renderer_navigation_encode(
            self.generation,
            self.next_request_id,
            action,
            url,
            method,
            headers,
            body,
            content_type
        ), operation, timeout_ms)
        if action != "stop":
            if val Ok(_) = started:
                self.pending_scroll_event_id = 0
                self.pending_scroll_delta_milli_y = 0
        started

    me begin_navigate(
        url: text,
        method: text,
        headers: text,
        body: text,
        content_type: text,
        timeout_ms: i64
    ) -> Result<bool, text>:
        if not self._replace_pending_navigation():
            return Err("renderer-busy")
        if not self.authorize_navigation(
            url, method, headers, body, content_type
        ):
            return Err("invalid-navigation")
        val started = self._begin_navigation_command(
            "open",
            self.navigation_permit.url,
            self.navigation_permit.method,
            headers,
            body,
            content_type,
            "navigation",
            timeout_ms
        )
        if val Err(_) = started:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_action = ""
        started

    me begin_go_home(timeout_ms: i64) -> Result<bool, text>:
        if self.home_url == "":
            return Err("home-unconfigured")
        if not self._replace_pending_navigation():
            return Err("renderer-busy")
        if not self.authorize_navigation(
            self.home_url, "GET", "", "", ""
        ):
            return Err("invalid-navigation")
        val started = self._begin_navigation_command(
            "home", self.navigation_permit.url, "GET", "", "", "",
            "navigation", timeout_ms
        )
        if val Err(_) = started:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_action = ""
        started

    me begin_go_back(timeout_ms: i64) -> Result<bool, text>:
        val target_url = if self.history_back_url != "":
            self.history_back_url
        elif self.history_index > 0:
            self.history_urls[self.history_index - 1]
        else:
            ""
        if target_url == "":
            return Err("cannot-go-back")
        if not self._replace_pending_navigation():
            return Err("renderer-busy")
        self.pending_history_index = self._history_back_index(target_url)
        self.pending_history_target_url = target_url
        self.provisional_document_origin = hosted_browser_network_origin(
            target_url
        )
        val started = self._begin_navigation_command(
            "back",
            target_url,
            "GET", "", "", "", "history", timeout_ms
        )
        if val Err(_) = started:
            self.pending_history_index = -1
            self.pending_history_target_url = ""
            self.provisional_document_origin = ""
        started

    me begin_go_forward(timeout_ms: i64) -> Result<bool, text>:
        val target_url = if self.history_forward_url != "":
            self.history_forward_url
        elif (self.history_index >= 0 and
            self.history_index < self.history_urls.len() - 1):
            self.history_urls[self.history_index + 1]
        else:
            ""
        if target_url == "":
            return Err("cannot-go-forward")
        if not self._replace_pending_navigation():
            return Err("renderer-busy")
        self.pending_history_index = self._history_forward_index(target_url)
        self.pending_history_target_url = target_url
        self.provisional_document_origin = hosted_browser_network_origin(
            target_url
        )
        val started = self._begin_navigation_command(
            "forward",
            target_url,
            "GET", "", "", "", "history", timeout_ms
        )
        if val Err(_) = started:
            self.pending_history_index = -1
            self.pending_history_target_url = ""
            self.provisional_document_origin = ""
        started

    me begin_reload(timeout_ms: i64) -> Result<bool, text>:
        if self.document_url == "":
            return Err("cannot-reload")
        if not self._replace_pending_navigation():
            return Err("renderer-busy")
        if not self.authorize_navigation(
            self.document_url, "GET", "", "", ""
        ):
            return Err("invalid-navigation")
        self.pending_history_action = "replace"
        val started = self._begin_navigation_command(
            "reload", self.navigation_permit.url, "GET", "", "", "",
            "history", timeout_ms
        )
        if val Err(_) = started:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_action = ""
        started

    me begin_stop(timeout_ms: i64) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        if self.command_deadline_ms > 0:
            if self.pending_operation == "stop":
                return Ok(false)
            if not self._cancel_pending_for_stop():
                return Err("renderer-busy")
        else:
            self.navigation_permit = hosted_browser_empty_navigation_permit()
            self.pending_history_action = ""
        self.pending_document_commit_url = ""
        self.provisional_document_origin = ""
        self._begin_navigation_command(
            "stop", "", "", "", "", "", "stop", timeout_ms
        )

    me navigate(
        url: text,
        method: text,
        headers: text,
        body: text,
        content_type: text,
        timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        match self.begin_navigate(
            url, method, headers, body, content_type, timeout_ms
        ):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me go_home(timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_go_home(timeout_ms):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me go_back(timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_go_back(timeout_ms):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me go_forward(timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_go_forward(timeout_ms):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me reload(timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_reload(timeout_ms):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me stop(timeout_ms: i64) -> HostedBrowserRendererResult:
        match self.begin_stop(timeout_ms):
            Err(reason):
                _renderer_result(false, reason, _empty_composition())
            Ok(_):
                self._await_pending()

    me pointer(
        event_id: i64, x: i64, y: i64, pressed: bool, timeout_ms: i64
    ) -> HostedBrowserRendererResult:
        if self.state != "active":
            return self.fail("invalid-renderer-state")
        self._await_frame(browser_renderer_pointer_encode(
            self.generation, self.next_request_id,
            event_id, x, y, pressed
        ), timeout_ms)

    me begin_pointer(
        event_id: i64, x: i64, y: i64, pressed: bool, timeout_ms: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        self._begin_after_animation(browser_renderer_pointer_encode(
            self.generation, self.next_request_id,
            event_id, x, y, pressed
        ), "pointer", timeout_ms)

    me queue_scroll(
        event_id: i64, delta_milli_y: i64
    ) -> Result<bool, text>:
        if self.state != "active":
            return Err("invalid-renderer-state")
        if event_id <= 0:
            return Err("invalid-action")
        var bounded = delta_milli_y
        if bounded > BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI:
            bounded = BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI
        elif bounded < 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI:
            bounded = 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI
        var combined = self.pending_scroll_delta_milli_y + bounded
        if combined > BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI:
            combined = BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI
        elif combined < 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI:
            combined = 0 - BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI
        self.pending_scroll_event_id = event_id
        self.pending_scroll_delta_milli_y = combined
        Ok(combined != 0)

    me flush_scroll(timeout_ms: i64) -> Result<bool, text>:
        if self.pending_scroll_delta_milli_y == 0:
            self.pending_scroll_event_id = 0
            return Ok(false)
        if self.state != "active":
            return Err("invalid-renderer-state")
        if self.command_deadline_ms > 0:
            return Err("renderer-busy")
        val started = self._begin_frame_request(
            browser_renderer_scroll_encode(
                self.generation,
                self.next_request_id,
                self.pending_scroll_event_id,
                self.pending_scroll_delta_milli_y
            ),
            "scroll",
            timeout_ms
        )
        if val Ok(_) = started:
            self.pending_scroll_event_id = 0
            self.pending_scroll_delta_milli_y = 0
        started

    me key(
        event_id: i64, key_code: i64, pressed: bool, timeout_ms: i64
