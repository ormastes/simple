# Durable browser profile state. BrowserSession never performs profile I/O.

use std.database.sql.connection.{Database}
use std.database.sql.types.{DbValue, DbError}
use std.gc_async_mut.web.browser_session.{
    BrowserBookmarkSnapshot, BrowserHstsSnapshot, BrowserHstsSnapshotEntry,
    browser_bookmark_stored_title
}
use std.gc_async_mut.web.browser_session_url.{
    network_navigation_hostname_valid, normalize_network_navigation_url
}
use std.js.types.pair.{Pair}
use common.web.host_policy.{is_ip_host_literal}
use common.web.public_suffix.{is_public_suffix}
use std.nogc_sync_mut.env.platform.{get_data_dir}
use std.sffi.io.{dir_create_all}
use std.common.encoding.utf8.{text_byte_len}

val BROWSER_PROFILE_SCHEMA_VERSION: i64 = 1
val BROWSER_PROFILE_MAX_BOOKMARKS: i64 = 256
val BROWSER_PROFILE_MAX_HSTS: i64 = 1024
val BROWSER_PROFILE_MAX_HSTS_LIFETIME_MS: i64 = 315360000000
val BROWSER_PROFILE_DEFAULT_HOME_URL: text = "https://example.com/"

fn _browser_profile_home_url(raw_url: text) -> text:
    if text_byte_len(raw_url) > 2048:
        return ""
    match normalize_network_navigation_url(raw_url):
        Err(_):
            ""
        Ok(url):
            if (
                (url.starts_with("http://") or
                 url.starts_with("https://")) and
                text_byte_len(url) <= 2048
            ):
                url
            else:
                ""

fn browser_profile_default_dir() -> text:
    get_data_dir() + "/simple/browser"

fn browser_profile_default_path() -> text:
    browser_profile_default_dir() + "/profile.sqlite3"

pub struct BrowserBookmarkMutation:
    enabled: bool
    bookmarks: BrowserBookmarkSnapshot

class BrowserProfileStore:
    db: Database
    _fail_next_bookmark_snapshot_read: bool

impl BrowserProfileStore:
    static fn open(path: text) -> Result<BrowserProfileStore, DbError>:
        BrowserProfileStore.from_database(Database.open(path)?)

    static fn open_default() -> Result<BrowserProfileStore, DbError>:
        val dir = browser_profile_default_dir()
        if not dir_create_all(dir):
            return Err(DbError.ConnectionFailed(
                path: dir, message: "cannot create browser profile directory"
            ))
        BrowserProfileStore.open(browser_profile_default_path())

    static fn memory() -> Result<BrowserProfileStore, DbError>:
        BrowserProfileStore.from_database(Database.memory()?)

    static fn from_database(db: Database) -> Result<BrowserProfileStore, DbError>:
        var store = BrowserProfileStore(
            db: db,
            _fail_next_bookmark_snapshot_read: false
        )
        match store.init_schema():
            Ok(_):
                Ok(store)
            Err(e):
                val _ = store.db.close()
                Err(e)

    me close() -> Result<(), DbError>:
        self.db.close()

    me init_schema() -> Result<(), DbError>:
        self.db.exec_sql(
            "CREATE TABLE IF NOT EXISTS browser_profile_meta (" +
            "id INTEGER PRIMARY KEY CHECK (id = 1)," +
            "schema_version INTEGER NOT NULL," +
            "home_url TEXT NOT NULL DEFAULT " +
            "'{BROWSER_PROFILE_DEFAULT_HOME_URL}')"
        )?
        val meta_columns = self.db.query(
            "PRAGMA table_info(browser_profile_meta)", []
        )?
        var has_home_url = false
        for column in meta_columns:
            if column.get_text("name") == "home_url":
                has_home_url = true
        if not has_home_url:
            self.db.exec_sql(
                "ALTER TABLE browser_profile_meta ADD COLUMN " +
                "home_url TEXT NOT NULL DEFAULT " +
                "'{BROWSER_PROFILE_DEFAULT_HOME_URL}'"
            )?
        self.db.exec_sql(
            "CREATE TABLE IF NOT EXISTS browser_bookmarks (" +
            "position INTEGER PRIMARY KEY," +
            "url TEXT NOT NULL UNIQUE," +
            "title TEXT NOT NULL)"
        )?
        self.db.exec_sql(
            "CREATE TABLE IF NOT EXISTS browser_hsts (" +
            "host TEXT PRIMARY KEY," +
            "received_at_unix_ms INTEGER NOT NULL," +
            "expires_at_unix_ms INTEGER NOT NULL," +
            "include_subdomains INTEGER NOT NULL CHECK (include_subdomains IN (0, 1)))"
        )?
        self.db.exec(
            "INSERT OR IGNORE INTO browser_profile_meta (id, schema_version) VALUES (?, ?)",
            [
                DbValue.Integer(value: 1),
                DbValue.Integer(value: BROWSER_PROFILE_SCHEMA_VERSION)
            ]
        )?
        val row = self.db.query_one(
            "SELECT schema_version FROM browser_profile_meta WHERE id = ?",
            [DbValue.Integer(value: 1)]
        )?
        if row == nil:
            return Err(DbError.MigrationFailed(
                id: "browser-profile", reason: "schema version row missing"
            ))
        val version = row.unwrap().get_int("schema_version")
        if version == nil or version.unwrap() != BROWSER_PROFILE_SCHEMA_VERSION:
            return Err(DbError.MigrationFailed(
                id: "browser-profile", reason: "unsupported schema version"
            ))
        Ok(())

    me save_home_url(raw_url: text) -> Result<(), DbError>:
        val home_url = _browser_profile_home_url(raw_url)
        if home_url == "":
            return Err(DbError.ConstraintViolation(
                "invalid browser home URL"
            ))
        self.db.exec(
            "UPDATE browser_profile_meta SET home_url = ? WHERE id = 1",
            [DbValue.Text(value: home_url)]
        )?
        Ok(())

    fn load_home_url() -> Result<text, DbError>:
        val row = self.db.query_one(
            "SELECT home_url FROM browser_profile_meta WHERE id = ?",
            [DbValue.Integer(value: 1)]
        )?
        if row == nil:
            return Ok(BROWSER_PROFILE_DEFAULT_HOME_URL)
        val stored = row.unwrap().get_text("home_url")
        if stored == nil:
            return Ok(BROWSER_PROFILE_DEFAULT_HOME_URL)
        val home_url = _browser_profile_home_url(stored.unwrap())
        Ok(if home_url == "":
            BROWSER_PROFILE_DEFAULT_HOME_URL
        else:
            home_url
        )

    me save_bookmarks(snapshot: BrowserBookmarkSnapshot) -> Result<(), DbError>:
        if snapshot.entries.len() > BROWSER_PROFILE_MAX_BOOKMARKS:
            return Err(DbError.ConstraintViolation("too many browser bookmarks"))
        var normalized: [Pair<text, text>] = []
        for entry in snapshot.entries:
            if entry.first.len() > 2048:
                return Err(DbError.ConstraintViolation("oversized browser bookmark"))
            match normalize_network_navigation_url(entry.first):
                Err(_):
                    return Err(DbError.ConstraintViolation("invalid browser bookmark URL"))
                Ok(url):
                    normalized.push(Pair(
                        first: url,
                        second: browser_bookmark_stored_title(entry.second)
                    ))

        var tx = self.db.begin()?
        if val Err(e) = self.db.exec("DELETE FROM browser_bookmarks", []):
            tx.rollback()?
            return Err(e)
        var position: i64 = 0
        for entry in normalized:
            if val Err(e) = self.db.exec(
                "INSERT INTO browser_bookmarks (position, url, title) VALUES (?, ?, ?)",
                [
                    DbValue.Integer(value: position),
                    DbValue.Text(value: entry.first),
                    DbValue.Text(value: entry.second)
                ]
            ):
                tx.rollback()?
                return Err(e)
            position = position + 1
        tx.commit()?
        Ok(())

    me _change_bookmark(
        raw_url: text, title: text, toggle: bool, requested_enabled: bool
    ) -> Result<BrowserBookmarkMutation, DbError>:
        if raw_url.len() > 2048:
            return Err(DbError.ConstraintViolation(
                "oversized browser bookmark"
            ))
        val url = match normalize_network_navigation_url(raw_url):
            Err(_):
                return Err(DbError.ConstraintViolation(
                    "invalid browser bookmark URL"
                ))
            Ok(value):
                value
        val stored_title = browser_bookmark_stored_title(title)
        var tx = self.db.begin()?
        if val Err(e) = self.db.exec(
            "UPDATE browser_profile_meta SET schema_version = " +
            "schema_version WHERE id = 1",
            []
        ):
            tx.rollback()?
            return Err(e)
        val existing = match self.db.query_one(
            "SELECT position FROM browser_bookmarks WHERE url = ?",
            [DbValue.Text(value: url)]
        ):
            Err(e):
                tx.rollback()?
                return Err(e)
            Ok(value):
                value
        val enabled = if toggle:
            existing == nil
        else:
            requested_enabled
        if not enabled:
            if val Err(e) = self.db.exec(
                "DELETE FROM browser_bookmarks WHERE url = ?",
                [DbValue.Text(value: url)]
            ):
                tx.rollback()?
                return Err(e)
        elif existing != nil:
            if val Err(e) = self.db.exec(
                "INSERT INTO browser_bookmarks (position, url, title) " +
                "VALUES (?, ?, ?) ON CONFLICT(url) DO UPDATE SET " +
                "title = excluded.title",
                [
                    DbValue.Integer(
                        value: existing.unwrap().get_int(
                            "position"
                        ).unwrap()
                    ),
                    DbValue.Text(value: url),
                    DbValue.Text(value: stored_title),
                ]
            ):
                tx.rollback()?
                return Err(e)
        else:
            val count = match self.db.query_one(
                "SELECT COUNT(*) AS bookmark_count " +
                "FROM browser_bookmarks",
                []
            ):
                Err(e):
                    tx.rollback()?
                    return Err(e)
                Ok(value):
                    value
            if (count == nil or
                count.unwrap().get_int("bookmark_count") == nil):
                tx.rollback()?
                return Err(DbError.ConstraintViolation(
                    "browser bookmark count unavailable"
                ))
            if count.unwrap().get_int("bookmark_count").unwrap() >= (
                BROWSER_PROFILE_MAX_BOOKMARKS
            ):
                tx.rollback()?
                return Err(DbError.ConstraintViolation(
                    "too many browser bookmarks"
                ))
            val last = match self.db.query_one(
                "SELECT COALESCE(MAX(position), -1) AS max_position " +
                "FROM browser_bookmarks",
                []
            ):
                Err(e):
                    tx.rollback()?
                    return Err(e)
                Ok(value):
                    value
            if last == nil or last.unwrap().get_int("max_position") == nil:
                tx.rollback()?
                return Err(DbError.ConstraintViolation(
                    "browser bookmark position unavailable"
                ))
            if val Err(e) = self.db.exec(
                "INSERT INTO browser_bookmarks (position, url, title) " +
                "VALUES (?, ?, ?)",
                [
                    DbValue.Integer(
                        value: last.unwrap().get_int(
                            "max_position"
                        ).unwrap() + 1
                    ),
                    DbValue.Text(value: url),
                    DbValue.Text(value: stored_title)
                ]
            ):
                tx.rollback()?
                return Err(e)
        if self._fail_next_bookmark_snapshot_read:
            self._fail_next_bookmark_snapshot_read = false
            tx.rollback()?
            return Err(DbError.ConstraintViolation(
                "injected post-mutation bookmark snapshot read failure"
            ))
        val bookmarks = match self.load_bookmarks():
            Err(e):
                tx.rollback()?
                return Err(e)
            Ok(value):
                value
        match tx.commit():
            Err(e):
                val _ = tx.rollback()
                Err(e)
            Ok(_):
                Ok(BrowserBookmarkMutation(
                    enabled: enabled,
                    bookmarks: bookmarks
                ))

    me set_bookmark(
        raw_url: text, title: text, enabled: bool
    ) -> Result<(), DbError>:
        val _ = self._change_bookmark(
            raw_url, title, false, enabled
        )?
        Ok(())

    me toggle_bookmark(
        raw_url: text, title: text
    ) -> Result<bool, DbError>:
        Ok(self._change_bookmark(
            raw_url, title, true, false
        )?.enabled)

    me toggle_bookmark_with_snapshot(
        raw_url: text, title: text
    ) -> Result<BrowserBookmarkMutation, DbError>:
        self._change_bookmark(raw_url, title, true, false)

    me inject_post_mutation_bookmark_snapshot_read_failure():
        self._fail_next_bookmark_snapshot_read = true

    fn load_bookmarks() -> Result<BrowserBookmarkSnapshot, DbError>:
        val rows = self.db.query(
            "SELECT position, url, title FROM browser_bookmarks " +
            "ORDER BY position LIMIT ?",
            [DbValue.Integer(value: BROWSER_PROFILE_MAX_BOOKMARKS + 1)]
        )?
        if rows.len() > BROWSER_PROFILE_MAX_BOOKMARKS:
            return Err(DbError.ConstraintViolation("browser bookmark store exceeds limit"))
        var entries: [Pair<text, text>] = []
        for row in rows:
            val url = row.get_text("url")
            val title = row.get_text("title")
            if url != nil and title != nil:
                if url.unwrap().len() <= 2048:
                    match normalize_network_navigation_url(url.unwrap()):
                        Ok(normalized):
                            entries.push(Pair(
                                first: normalized,
                                second: browser_bookmark_stored_title(
                                    title.unwrap()
                                )
                            ))
                        Err(_):
                            pass_dn("ignore corrupt bookmark row")
        Ok(BrowserBookmarkSnapshot.create(entries))

    me save_hsts(
        snapshot: BrowserHstsSnapshot, wall_clock_ms: i64
    ) -> Result<(), DbError>:
        if snapshot.entries.len() > BROWSER_PROFILE_MAX_HSTS:
            return Err(DbError.ConstraintViolation("too many HSTS policies"))
        for entry in snapshot.entries:
            val host = entry.host.lower()
            val remaining = entry.expires_at_unix_ms - wall_clock_ms
            val lifetime = entry.expires_at_unix_ms - entry.received_at_unix_ms
            if (
                entry.host != entry.host.trim() or
                not network_navigation_hostname_valid(host) or
                is_ip_host_literal(host) or is_public_suffix(host) or
                remaining <= 0 or
                remaining > BROWSER_PROFILE_MAX_HSTS_LIFETIME_MS or
                lifetime <= 0 or
                lifetime > BROWSER_PROFILE_MAX_HSTS_LIFETIME_MS
            ):
                return Err(DbError.ConstraintViolation("invalid HSTS policy"))

        var tx = self.db.begin()?
        if val Err(e) = self.db.exec("DELETE FROM browser_hsts", []):
            tx.rollback()?
            return Err(e)
        for entry in snapshot.entries:
            if val Err(e) = self.db.exec(
                "INSERT INTO browser_hsts (" +
                "host, received_at_unix_ms, expires_at_unix_ms, include_subdomains" +
                ") VALUES (?, ?, ?, ?)",
                [
                    DbValue.Text(value: entry.host.lower()),
                    DbValue.Integer(value: entry.received_at_unix_ms),
                    DbValue.Integer(value: entry.expires_at_unix_ms),
                    DbValue.Integer(value: if entry.include_subdomains: 1 else: 0)
                ]
            ):
                tx.rollback()?
                return Err(e)
        tx.commit()?
        Ok(())

    fn load_hsts(wall_clock_ms: i64) -> Result<BrowserHstsSnapshot, DbError>:
        val rows = self.db.query(
            "SELECT host, received_at_unix_ms, expires_at_unix_ms, " +
            "include_subdomains FROM browser_hsts ORDER BY host LIMIT ?",
            [DbValue.Integer(value: BROWSER_PROFILE_MAX_HSTS + 1)]
        )?
        if rows.len() > BROWSER_PROFILE_MAX_HSTS:
            return Err(DbError.ConstraintViolation("HSTS store exceeds limit"))
        var seen_hosts: [text] = []
        var duplicate_hosts: [text] = []
        for row in rows:
            val host = row.get_text("host")
            if host != nil:
                val raw_host = host.unwrap()
                val normalized = raw_host.lower()
                if (
                    raw_host == raw_host.trim() and
                    network_navigation_hostname_valid(normalized) and
                    not is_ip_host_literal(normalized) and
                    not is_public_suffix(normalized)
                ):
                    var seen = false
                    for seen_host in seen_hosts:
                        if seen_host == normalized:
                            seen = true
                    if seen:
                        duplicate_hosts.push(normalized)
                    else:
                        seen_hosts.push(normalized)
        var entries: [BrowserHstsSnapshotEntry] = []
        for row in rows:
            val host = row.get_text("host")
            val received = row.get_int("received_at_unix_ms")
            val expires = row.get_int("expires_at_unix_ms")
            val include_subdomains = row.get_int("include_subdomains")
            if (
                host != nil and received != nil and expires != nil and
                include_subdomains != nil
            ):
                val raw_host = host.unwrap()
                val normalized = raw_host.lower()
                val remaining = expires.unwrap() - wall_clock_ms
                val lifetime = expires.unwrap() - received.unwrap()
                var duplicate = false
                for duplicate_host in duplicate_hosts:
                    if duplicate_host == normalized:
                        duplicate = true
                if (
                    not duplicate and
                    raw_host == raw_host.trim() and
                    network_navigation_hostname_valid(normalized) and
                    not is_ip_host_literal(normalized) and
                    not is_public_suffix(normalized) and
                    remaining > 0 and
                    remaining <= BROWSER_PROFILE_MAX_HSTS_LIFETIME_MS and
                    lifetime > 0 and
                    lifetime <= BROWSER_PROFILE_MAX_HSTS_LIFETIME_MS and
                    (include_subdomains.unwrap() == 0 or include_subdomains.unwrap() == 1)
                ):
                    entries.push(BrowserHstsSnapshotEntry(
                        host: normalized,
                        received_at_unix_ms: received.unwrap(),
                        expires_at_unix_ms: expires.unwrap(),
                        include_subdomains: include_subdomains.unwrap() == 1
                    ))
        Ok(BrowserHstsSnapshot.create(entries))

pub struct HostedBrowserParentBookmarkCommit:
    profile: BrowserProfileStore
    ok: bool
    enabled: bool
    bookmarks: BrowserBookmarkSnapshot
    reason: text

pub fn hosted_browser_parent_toggle_bookmark(
    profile_in: BrowserProfileStore,
    url: text,
    stored_title: text
) -> HostedBrowserParentBookmarkCommit:
    var profile = profile_in
    match profile.toggle_bookmark_with_snapshot(url, stored_title):
        Err(error):
            HostedBrowserParentBookmarkCommit(
                profile: profile,
                ok: false,
                enabled: false,
                bookmarks: BrowserBookmarkSnapshot.create([]),
                reason: error.message()
            )
        Ok(mutation):
            HostedBrowserParentBookmarkCommit(
                profile: profile,
                ok: true,
                enabled: mutation.enabled,
                bookmarks: mutation.bookmarks,
                reason: ""
            )

class BrowserBookmarkStore:
    _profile: BrowserProfileStore

impl BrowserBookmarkStore:
    static fn open_default() -> Result<BrowserBookmarkStore, DbError>:
        Ok(BrowserBookmarkStore(
            _profile: BrowserProfileStore.open_default()?
        ))

    static fn memory() -> Result<BrowserBookmarkStore, DbError>:
        Ok(BrowserBookmarkStore(
            _profile: BrowserProfileStore.memory()?
        ))

    static fn from_profile(
        profile: BrowserProfileStore
    ) -> BrowserBookmarkStore:
        BrowserBookmarkStore(_profile: profile)

    fn load_bookmarks() -> Result<BrowserBookmarkSnapshot, DbError>:
        self._profile.load_bookmarks()

    me toggle_bookmark(
        raw_url: text, title: text
    ) -> Result<bool, DbError>:
        self._profile.toggle_bookmark(raw_url, title)

    me toggle_bookmark_with_snapshot(
        raw_url: text, title: text
    ) -> Result<BrowserBookmarkMutation, DbError>:
        self._profile.toggle_bookmark_with_snapshot(raw_url, title)

    me inject_post_mutation_bookmark_snapshot_read_failure():
        self._profile.inject_post_mutation_bookmark_snapshot_read_failure()

    me close() -> Result<(), DbError>:
        self._profile.close()
