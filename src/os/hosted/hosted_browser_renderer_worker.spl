"""Hidden, fail-closed browser renderer worker entry."""

use common.string_builder.{StringBuilder}
use std.common.web.browser_renderer_protocol.{
    BROWSER_RENDERER_MAX_DIAGNOSTIC_BYTES,
    BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI,
    BROWSER_RENDERER_MAX_VIEWPORT,
    BROWSER_RENDERER_WORKER_ARG,
    BrowserRendererEncodeResult, BrowserRendererMessage,
    BrowserTextInputOverlay, browser_text_input_overlay_empty,
    browser_renderer_action_decode,
    browser_renderer_decoder_feed, browser_renderer_decoder_new,
    browser_renderer_fetch_request_encode,
    browser_renderer_frame_encode_with_diagnostics,
    browser_renderer_message_encode,
    browser_renderer_navigation_decode,
    browser_renderer_network_response_decode,
    browser_renderer_resize_decode
}
use common.ui.access.{WinTextActionRequest}
use std.common.encoding.utf8.{text_without_last_codepoint}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{
    be_dom_event_identity_at_element_path, be_dom_find_path_to_id,
    be_dom_focused_id, be_dom_layout_target_key
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    InputTextVisualMap, SimpleWebLayoutHitIndex,
    input_text_source_byte_at_x,
    simple_web_layout_hit_test_index,
    simple_web_layout_render_html_draw_ir_result_at_time,
    simple_web_layout_render_html_draw_ir_result_with_overlay_at_scroll_time
}
use std.gc_async_mut.web.browser_session.{
    BrowserResponse, BrowserSession
}
use std.gc_async_mut.web.browser_session_runtime.*
use std.gc_async_mut.web.browser_session_ui_access.*
use std.nogc_sync_mut.io.process_ops.{browser_renderer_sandbox_enter}

extern fn rt_browser_renderer_read_stdin_some(max_bytes: i64) -> text
extern fn rt_browser_renderer_write_protocol_some(data: text, data_len: i64, offset: i64, max_bytes: i64) -> i64
extern fn rt_stdout_flush()

val _WORKER_READ_BYTES: i64 = 8192
val _WORKER_CARET_HALF_PERIOD_MS: i64 = 500

fn _worker_reject(reason: text) -> BrowserRendererEncodeResult:
    BrowserRendererEncodeResult(ok: false, reason: reason, wire: "")

pub struct HostedBrowserRendererWorkerResult:
    ok: bool
    reason: text
    initialized: bool
    animation_time_ms: i64
    wire: text
    hit_index: SimpleWebLayoutHitIndex?
    resolved_input_view_start_byte: i64
    resolved_scroll_y: i32
    max_scroll_y: i32

fn _worker_result_reject(
    reason: text,
    initialized: bool,
    animation_time_ms: i64
) -> HostedBrowserRendererWorkerResult:
    HostedBrowserRendererWorkerResult(
        ok: false,
        reason: reason,
        initialized: initialized,
        animation_time_ms: animation_time_ms,
        wire: "",
        hit_index: nil,
        resolved_input_view_start_byte: 0,
        resolved_scroll_y: 0,
        max_scroll_y: 0
    )

fn _worker_next_animation_ms(
    css_animation_end_ms: i64,
    script_timer_due_ms: i64,
    caret_due_ms: i64,
    current_time_ms: i64
) -> i64:
    var next: i64 = -1
    if css_animation_end_ms == -2 or css_animation_end_ms > current_time_ms:
        next = current_time_ms + 16
        if css_animation_end_ms >= 0 and next > css_animation_end_ms:
            next = css_animation_end_ms
    if script_timer_due_ms >= 0:
        val timer_next = if script_timer_due_ms <= current_time_ms:
            current_time_ms + 1
        else:
            script_timer_due_ms
        if next < 0 or timer_next < next:
            next = timer_next
    if caret_due_ms >= 0 and (next < 0 or caret_due_ms < next):
        next = caret_due_ms
    next

fn _worker_document_animation_time_ms(
    session: BrowserSession, current_time_ms: i64
) -> i64:
    val elapsed = current_time_ms - session.animation_start_time_ms
    if elapsed > 0: elapsed else: 0

fn _worker_diagnostics(session: BrowserSession) -> text:
    var diagnostics = StringBuilder.new()
    var used: i64 = 0
    for warning in session.warnings:
        if used >= BROWSER_RENDERER_MAX_DIAGNOSTIC_BYTES:
            return diagnostics.build()
        if used > 0:
            diagnostics.push("\n")
            used = used + 1
        val remaining = (
            BROWSER_RENDERER_MAX_DIAGNOSTIC_BYTES - used
        )
        if warning.len() > remaining:
            diagnostics.push(warning.slice(0, remaining))
            return diagnostics.build()
        diagnostics.push(warning)
        used = used + warning.len()
    diagnostics.build()

fn _worker_frame(
    session: BrowserSession,
    message: BrowserRendererMessage,
    width: i32,
    height: i32,
    animation_time_ms: i64,
    response_request_id: i64,
    overlay: BrowserTextInputOverlay,
    caret_due_ms: i64,
    scroll_y: i32
) -> HostedBrowserRendererWorkerResult:
    val document_animation_time_ms = _worker_document_animation_time_ms(
        session, animation_time_ms
    )
    val layout = simple_web_layout_render_html_draw_ir_result_with_overlay_at_scroll_time(
        session.render_html_document(),
        width,
        height,
        document_animation_time_ms,
        scroll_y,
        overlay
    )
    val css_animation_end_ms = if layout.animation_end_ms >= 0:
        session.animation_start_time_ms + layout.animation_end_ms
    else:
        layout.animation_end_ms
    val encoded = browser_renderer_frame_encode_with_diagnostics(
        layout.composition,
        message.generation,
        response_request_id,
        message.request_id,
        _worker_next_animation_ms(
            css_animation_end_ms,
            session.next_script_timer_due_ms(),
            caret_due_ms,
            animation_time_ms
        ),
        layout.material_witness.cpu_composited_count,
        layout.material_witness.cpu_composited_sha256,
        layout.material_witness.solid_material_count,
        layout.material_witness.solid_material_sha256,
        _worker_diagnostics(session)
    )
    if not encoded.ok:
        return _worker_result_reject(
            encoded.reason, true, animation_time_ms
        )
    HostedBrowserRendererWorkerResult(
        ok: true,
        reason: "ok",
        initialized: true,
        animation_time_ms: animation_time_ms,
        wire: encoded.wire,
        hit_index: Some(layout.hit_index),
        resolved_input_view_start_byte:
            layout.resolved_input_view_start_byte,
        resolved_scroll_y: layout.resolved_scroll_y,
        max_scroll_y: layout.max_scroll_y
    )

pub class HostedBrowserRendererWorkerSession:
    browser: BrowserSession
    width: i32
    height: i32
    initialized: bool
    animation_time_ms: i64
    expected_request_id: i64
    next_outbound_id: i64
    pressed_target_id: text
    pressed_chrome_control: text
    chrome_focus: text
    address_replace_on_text: bool
    last_hit_index: SimpleWebLayoutHitIndex?
    input_view_target_key: text
    input_view_start_byte: i64
    caret_blink_epoch_ms: i64
    pressed_pointer_default_prevented: bool
    scroll_milli_y: i64

    static fn create(width: i32, height: i32) -> HostedBrowserRendererWorkerSession:
        var browser = BrowserSession.new()
        browser.broker_network_policy = true
        HostedBrowserRendererWorkerSession(
            browser: browser,
            width: width,
            height: height,
            initialized: false,
            animation_time_ms: 0,
            expected_request_id: 2,
            next_outbound_id: 2,
            pressed_target_id: "",
            pressed_chrome_control: "",
            chrome_focus: "",
            address_replace_on_text: false,
            last_hit_index: nil,
            input_view_target_key: "",
            input_view_start_byte: 0,
            caret_blink_epoch_ms: 0,
            pressed_pointer_default_prevented: false,
            scroll_milli_y: 0
        )

    me _target_at(x: i64, y: i64) -> text:
        if self.last_hit_index == nil:
            return ""
        val root = self.browser.dom_root()
        val target_key = simple_web_layout_hit_test_index(
            self.last_hit_index.unwrap(), x.to_i32(), y.to_i32()
        )
        if target_key.starts_with("id:"):
            return target_key.slice(3, target_key.len())
        if target_key.starts_with("path:"):
            return be_dom_event_identity_at_element_path(
                root, target_key.slice(5, target_key.len())
            )
        ""

    me _input_byte_at(target_key: text, x: i64) -> i64:
        if self.last_hit_index == nil:
            return 0
        for hit in self.last_hit_index.unwrap().input_text_hits:
            if hit.target_key == target_key:
                return input_text_source_byte_at_x(
                    InputTextVisualMap(
                        display_text: "",
                        source_boundary_bytes: hit.source_boundary_bytes,
                        boundary_x_px: hit.boundary_x_px
                    ),
                    x.to_i32()
                )
        0

    me _reset_caret_blink():
        self.caret_blink_epoch_ms = self.animation_time_ms

    me _text_overlay() -> BrowserTextInputOverlay:
        val root = self.browser.dom_root()
        val target_id = be_dom_focused_id(root)
        if target_id == "":
            return browser_text_input_overlay_empty()
        val path = be_dom_find_path_to_id(root, target_id)
        if path.len() == 0 or
           not dom_text_control_selectable(path[path.len() - 1]):
            return browser_text_input_overlay_empty()
        val _ = self.browser.ensure_dom_text_selection(target_id)
        val target_key = be_dom_layout_target_key(root, target_id)
        if target_key == "":
            return browser_text_input_overlay_empty()
        if self.input_view_target_key != target_key:
            self.input_view_target_key = target_key
            self.input_view_start_byte = 0
        val collapsed = (
            self.browser.text_selection_anchor_byte ==
            self.browser.text_selection_focus_byte
        )
        val blink_elapsed = (
            self.animation_time_ms - self.caret_blink_epoch_ms
        )
        val blink_visible = (
            blink_elapsed < 0 or
            (blink_elapsed / _WORKER_CARET_HALF_PERIOD_MS) % 2 == 0
        )
        BrowserTextInputOverlay(
            target_key: target_key,
            anchor_byte: self.browser.text_selection_anchor_byte,
            focus_byte: self.browser.text_selection_focus_byte,
            view_start_byte: self.input_view_start_byte,
            caret_visible: collapsed and blink_visible
        )

    me _caret_due_ms(overlay: BrowserTextInputOverlay) -> i64:
        if not overlay.caret_visible and
           overlay.anchor_byte != overlay.focus_byte:
            return -1
        if overlay.target_key == "":
            return -1
        val elapsed = self.animation_time_ms - self.caret_blink_epoch_ms
        val phase = if elapsed > 0:
            elapsed / _WORKER_CARET_HALF_PERIOD_MS
        else:
            0
        self.caret_blink_epoch_ms +
            (phase + 1) * _WORKER_CARET_HALF_PERIOD_MS

    me _clear_page_text_focus_state():
        self.browser.clear_dom_focus()
        self.input_view_target_key = ""
        self.input_view_start_byte = 0
        self.caret_blink_epoch_ms = 0

    me _chrome_action(control: text, action: text, value: text):
        val _ = self.browser.ui_access_act(WinTextActionRequest(
            target_id: "browser:session#{control}",
            action: action,
            text_value: value,
            x: 0,
            y: 0
        ))

    me _dispatch_pointer(message: BrowserRendererMessage) -> text:
        val action = browser_renderer_action_decode(message)
        if not action.ok:
            return action.reason
        self.chrome_focus = ""
        self.address_replace_on_text = false
        self.pressed_chrome_control = ""
        val target_id = self._target_at(action.x, action.y)
        if target_id == "":
            self.pressed_target_id = ""
            self.pressed_pointer_default_prevented = false
            if action.pressed:
                self._clear_page_text_focus_state()
            return ""
        if action.pressed:
            self.pressed_target_id = target_id
            val pointer_down = self.browser.dispatch_dom_event(
                target_id, "pointerdown", true, true
            )
            val mouse_down = self.browser.dispatch_dom_event(
                target_id, "mousedown", true, true
            )
            val focused_id = be_dom_focused_id(self.browser.dom_root())
            val target_path = be_dom_find_path_to_id(
                self.browser.dom_root(), target_id
            )
            val selectable = (
                target_path.len() > 0 and
                dom_text_control_selectable(
                    target_path[target_path.len() - 1]
                )
            )
            val default_allowed = (
                not pointer_down.event.default_prevented and
                not mouse_down.event.default_prevented
            )
            self.pressed_pointer_default_prevented = not default_allowed
            if selectable and focused_id == target_id and default_allowed:
                val target_key = be_dom_layout_target_key(
                    self.browser.dom_root(), target_id
                )
                val source_byte = self._input_byte_at(
                    target_key, action.x
                )
                val _ = self.browser.set_dom_text_selection(
                    target_id, source_byte, source_byte
                )
                self.input_view_target_key = target_key
                self._reset_caret_blink()
            elif default_allowed:
                if focused_id == target_id:
                    self.input_view_target_key = ""
                    self.input_view_start_byte = 0
                    self.caret_blink_epoch_ms = 0
                else:
                    self._clear_page_text_focus_state()
            return ""
        val pressed_target_id = self.pressed_target_id
        val pointer_default_prevented = (
            self.pressed_pointer_default_prevented
        )
        self.pressed_target_id = ""
        self.pressed_pointer_default_prevented = false
        val _ = self.browser.dispatch_dom_event(
            target_id, "pointerup", true, true
        )
        val _ = self.browser.dispatch_dom_event(
            target_id, "mouseup", true, true
        )
        if pressed_target_id == target_id:
            val _ = self.browser.dispatch_dom_event(
                target_id, "click", true, true
            )
        if not pointer_default_prevented:
            self._reset_caret_blink()
        ""

    me _dispatch_text(message: BrowserRendererMessage) -> text:
        val action = browser_renderer_action_decode(message)
        if not action.ok:
            return action.reason
        if self.chrome_focus == "address":
            val current = if self.browser.address_draft != "":
                self.browser.address_draft
            else:
                self.browser.current_url
            val updated = if self.address_replace_on_text:
                action.value
            else:
                current + action.value
            self.address_replace_on_text = false
            self._chrome_action("address", "set_value", updated)
            return ""
        val target_id = be_dom_focused_id(self.browser.dom_root())
        if target_id != "":
            val _ = self.browser.append_dom_text_input(
                target_id, action.value
            )
        self._reset_caret_blink()
        ""

    me _dispatch_key(message: BrowserRendererMessage) -> text:
        val action = browser_renderer_action_decode(message)
        if not action.ok:
            return action.reason
        if self.chrome_focus == "address":
            if not action.pressed:
                return ""
            if action.key_code == 13:
                return "navigation-command-required"
            elif action.key_code == 8:
                val current = if self.browser.address_draft != "":
                    self.browser.address_draft
                else:
                    self.browser.current_url
                val shortened = if current.len() > 0:
                    text_without_last_codepoint(current)
                else:
                    ""
                self.address_replace_on_text = false
                self._chrome_action("address", "set_value", shortened)
            return ""
        self._reset_caret_blink()
        val target_id = be_dom_focused_id(self.browser.dom_root())
        if target_id == "" and action.key_code != 9:
            return ""
        val key = if action.key_code == 13:
            "Enter"
        elif action.key_code == 32:
            " "
        elif action.key_code == 9:
            "Tab"
        else:
            action.key_code.to_text()
        val _ = self.browser.dispatch_dom_keyboard_event_with_shift(
            target_id, key, action.pressed, action.shift_key
        )
        ""

    me _dispatch_chrome(message: BrowserRendererMessage) -> text:
        val action = browser_renderer_action_decode(message)
        if not action.ok:
            return action.reason
        self.pressed_target_id = ""
        self.pressed_pointer_default_prevented = false
        if action.pressed:
            self._clear_page_text_focus_state()
            self.pressed_chrome_control = action.value
            if action.value == "address":
                self.chrome_focus = "address"
                self.address_replace_on_text = true
            else:
                self.chrome_focus = ""
                self.address_replace_on_text = false
            return ""
        val pressed = self.pressed_chrome_control
        self.pressed_chrome_control = ""
        if pressed != action.value:
            return ""
        if (action.value == "back" or action.value == "forward" or
            action.value == "stop" or action.value == "home"):
            return "navigation-command-required"
        if action.value != "address":
            self._chrome_action(action.value, "click", "")
        ""

    me _dispatch_navigation(message: BrowserRendererMessage) -> text:
        val navigation = browser_renderer_navigation_decode(message)
        if not navigation.ok:
            return navigation.reason
        self.pressed_target_id = ""
        self.pressed_pointer_default_prevented = false
        self.pressed_chrome_control = ""
        self.chrome_focus = ""
        self.address_replace_on_text = false
        self._clear_page_text_focus_state()
        if navigation.action == "stop":
            self.browser.stop_loading()
            return ""
        val result: Result<bool, text> = if (
            navigation.action == "open" or navigation.action == "home"
        ):
            self.browser.begin_network_navigation(
                navigation.url,
                navigation.method,
                navigation.headers,
                navigation.body,
                navigation.content_type
            )
        elif navigation.action == "back":
            self.browser.go_back()
        elif navigation.action == "forward":
            self.browser.go_forward()
        else:
            self.browser.reload()
        if val Err(reason) = result:
            return reason
        val actual_url = if self.browser.pending_url != "":
            self.browser.pending_url
        else:
            self.browser.current_url
        if actual_url != navigation.url:
            return "navigation-target-mismatch"
        ""

    me handle(message: BrowserRendererMessage) -> HostedBrowserRendererWorkerResult:
        if message.request_id != self.expected_request_id:
            return _worker_result_reject(
                "unexpected-request-id",
                self.initialized,
                self.animation_time_ms
            )
        if not self.initialized:
            if message.kind != "init":
                return _worker_result_reject(
                    "expected-init", false, self.animation_time_ms
                )
            if val Err(reason) = self.browser.open_html(
                "simple-renderer://document", message.payload
            ):
                return _worker_result_reject(
                    reason, false, self.animation_time_ms
                )
            self.initialized = true
            self.animation_time_ms = 0
        else:
            var reason = ""
            if message.kind == "advance":
                val action = browser_renderer_action_decode(message)
                if not action.ok:
                    reason = action.reason
                elif action.now_ms < self.animation_time_ms:
                    reason = "invalid-animation-time"
                else:
                    val _ = self.browser.advance_time(action.now_ms)
                    self.animation_time_ms = action.now_ms
            elif message.kind == "pointer":
                reason = self._dispatch_pointer(message)
            elif message.kind == "scroll":
                val action = browser_renderer_action_decode(message)
                if not action.ok:
                    reason = action.reason
                else:
                    var next_scroll = self.scroll_milli_y + action.y
                    if next_scroll < 0:
                        next_scroll = 0
                    elif next_scroll > BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI:
                        next_scroll = BROWSER_RENDERER_MAX_SCROLL_DELTA_MILLI
                    self.scroll_milli_y = next_scroll
            elif message.kind == "text":
                reason = self._dispatch_text(message)
            elif message.kind == "key":
                reason = self._dispatch_key(message)
            elif message.kind == "chrome":
                reason = self._dispatch_chrome(message)
            elif message.kind == "navigation":
                reason = self._dispatch_navigation(message)
            elif message.kind == "resize":
                val resize = browser_renderer_resize_decode(message)
                if not resize.ok:
                    reason = resize.reason
                else:
                    self.width = resize.width
                    self.height = resize.height
            elif message.kind == "network_response":
                val response = browser_renderer_network_response_decode(
                    message
                )
                if not response.ok:
                    reason = response.reason
                else:
                    val committed = self.browser.commit_network_response(
                        BrowserResponse.create(
                        request_id: response.request_id,
                        kind: response.kind,
                        url: response.url,
                        status: response.status,
                        headers: response.headers,
                        body: response.body,
                        error: response.error
                    )
                    )
                    if val Err(commit_reason) = committed:
                        reason = commit_reason
                    elif response.kind == "document":
                        self.scroll_milli_y = 0
            else:
                reason = "unexpected-action"
            if reason != "":
                return _worker_result_reject(
                    reason, true, self.animation_time_ms
                )
        self.expected_request_id = self.expected_request_id + 1
        val response_id = self.next_outbound_id
        self.next_outbound_id = self.next_outbound_id + 1
        if val Some(request) = self.browser.take_pending_request():
            val encoded = browser_renderer_fetch_request_encode(
                message.generation,
                response_id,
                message.request_id,
                request.id,
                request.kind,
                request.url,
                request.method,
                request.headers,
                request.body,
                request.content_type
            )
            if not encoded.ok:
                return _worker_result_reject(
                    encoded.reason, true, self.animation_time_ms
                )
            return HostedBrowserRendererWorkerResult(
                ok: true,
                reason: "ok",
                initialized: true,
                animation_time_ms: self.animation_time_ms,
                wire: encoded.wire,
                hit_index: nil,
                resolved_input_view_start_byte:
                    self.input_view_start_byte,
                resolved_scroll_y: 0,
                max_scroll_y: 0
            )
        val overlay = self._text_overlay()
        val frame = _worker_frame(
            self.browser, message, self.width, self.height,
            self.animation_time_ms, response_id, overlay,
            self._caret_due_ms(overlay),
            (self.scroll_milli_y / 1000).to_i32()
        )
        if frame.hit_index != nil:
            self.last_hit_index = frame.hit_index
            val max_scroll_milli_y = frame.max_scroll_y.to_i64() * 1000
            if self.scroll_milli_y > max_scroll_milli_y:
                self.scroll_milli_y = max_scroll_milli_y
        if overlay.target_key != "":
            self.input_view_target_key = overlay.target_key
            self.input_view_start_byte =
                frame.resolved_input_view_start_byte
        frame

pub fn hosted_browser_renderer_handle_request(
    session: BrowserSession,
    message: BrowserRendererMessage,
    width: i32,
    height: i32,
    initialized: bool,
    animation_time_ms: i64,
    expected_request_id: i64
) -> HostedBrowserRendererWorkerResult:
    if message.request_id != expected_request_id:
        return _worker_result_reject(
            "unexpected-request-id", initialized, animation_time_ms
        )
    var next_time_ms = animation_time_ms
    if not initialized:
        if message.kind != "init":
            return _worker_result_reject(
                "expected-init", initialized, animation_time_ms
            )
        if val Err(reason) = session.open_html(
            "simple-renderer://document", message.payload
        ):
            return _worker_result_reject(
                reason, initialized, animation_time_ms
            )
        next_time_ms = 0
    else:
        if message.kind != "advance":
            return _worker_result_reject(
                "expected-advance", initialized, animation_time_ms
            )
        val requested_time_ms = message.payload.to_i64() ?? -1
        if requested_time_ms < animation_time_ms or
            str(requested_time_ms) != message.payload:
            return _worker_result_reject(
                "invalid-animation-time", initialized, animation_time_ms
            )
        val _ = session.advance_time(requested_time_ms)
        next_time_ms = requested_time_ms

    _worker_frame(
        session, message, width, height, next_time_ms, message.request_id,
        browser_text_input_overlay_empty(), -1
    )

pub fn hosted_browser_renderer_handle_init(
    message: BrowserRendererMessage,
    width: i32,
    height: i32,
    animation_time_ms: i64,
    response_request_id: i64
) -> BrowserRendererEncodeResult:
    if message.kind != "init":
        return _worker_reject("expected-init")
    var session = BrowserSession.new()
    if val Err(reason) = session.open_html(
        "simple-renderer://document", message.payload
    ):
        return _worker_reject(reason)
    if animation_time_ms > 0:
        val _ = session.advance_time(animation_time_ms)
    val document_animation_time_ms = _worker_document_animation_time_ms(
        session, animation_time_ms
    )
    val layout = simple_web_layout_render_html_draw_ir_result_at_time(
        session.render_html_document(),
        width,
        height,
        document_animation_time_ms
    )
    val css_animation_end_ms = if layout.animation_end_ms >= 0:
        session.animation_start_time_ms + layout.animation_end_ms
    else:
        layout.animation_end_ms
    browser_renderer_frame_encode_with_diagnostics(
        layout.composition,
        message.generation,
        response_request_id,
        message.request_id,
        _worker_next_animation_ms(
            css_animation_end_ms,
            session.next_script_timer_due_ms(),
            -1,
            animation_time_ms
        ),
        layout.material_witness.cpu_composited_count,
        layout.material_witness.cpu_composited_sha256,
        layout.material_witness.solid_material_count,
        layout.material_witness.solid_material_sha256,
        _worker_diagnostics(session)
    )

fn _worker_write(wire: text) -> bool:
    var offset: i64 = 0
    while offset < wire.len():
        val written = rt_browser_renderer_write_protocol_some(
            wire, wire.len(), offset, 8192
        )
        if written <= 0:
            return false
        offset = offset + written
    rt_stdout_flush()
    true

pub fn hosted_browser_renderer_worker_main(args: [text]) -> i64:
    if args.len() != 5 or args[1] != BROWSER_RENDERER_WORKER_ARG:
        return 64

    val generation = args[2].to_i64() ?? -1
    val width_i64 = args[3].to_i64() ?? -1
    val height_i64 = args[4].to_i64() ?? -1
    if generation <= 0 or width_i64 <= 0 or height_i64 <= 0 or
        width_i64 > BROWSER_RENDERER_MAX_VIEWPORT or
        height_i64 > BROWSER_RENDERER_MAX_VIEWPORT:
        return 64
    if not browser_renderer_sandbox_enter():
        return 70

    val ready = browser_renderer_message_encode("ready", generation, 1, "")
    if not ready.ok or not _worker_write(ready.wire):
        return 71

    var decoder = browser_renderer_decoder_new(generation)
    var session = HostedBrowserRendererWorkerSession.create(
        width_i64.to_i32(), height_i64.to_i32()
    )
    while true:
        val chunk = rt_browser_renderer_read_stdin_some(_WORKER_READ_BYTES)
        if chunk == "":
            return if decoder.buffer_len == 0: 0 else: 72
        val decoded = browser_renderer_decoder_feed(decoder, chunk)
        decoder = decoded.decoder
        if decoded.status == "violation":
            return 73
        if decoded.status == "message":
            if decoded.message.kind == "test_crash_after_ready":
                if not session.initialized or
                    decoded.message.request_id != session.expected_request_id:
                    return 74
                return 75
            if decoded.message.kind == "test_hang_after_ready":
                if not session.initialized or
                    decoded.message.request_id != session.expected_request_id:
                    return 74
                val acknowledged = browser_renderer_message_encode(
                    "test_hang_ready", decoded.message.generation,
                    decoded.message.request_id, ""
                )
                if not acknowledged.ok or not _worker_write(acknowledged.wire):
                    return 74
                while true:
                    val ignored = rt_browser_renderer_read_stdin_some(
                        _WORKER_READ_BYTES
                    )
                    if ignored == "":
                        return 76
            val frame = session.handle(decoded.message)
            if not frame.ok or not _worker_write(frame.wire):
                return 74
