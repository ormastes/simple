fn _worker_network_history_neighbor(url: text) -> text:
    if url.starts_with("http://") or url.starts_with("https://"):
        return url
    ""
use std.gc_async_mut.web.browser_session_runtime.*
use std.gc_async_mut.web.browser_session_ui_access.*
use std.nogc_sync_mut.io.process_ops.{browser_renderer_sandbox_enter}
use os.compositor.simple_web_window_renderer.{
    simple_web_content_full_html_matches_install_wire
}
