"""Bounded secondary hosted-browser renderer ownership."""

use common.ui.window_scene.{WmContentFrame, WM_CONTENT_ORIGIN_SIMPLE_WEB}
use common.ui.wm_chrome_theme.{
    active_wm_theme_id
}
use nogc_sync_mut.ui.theme_package.{default_theme_id}
use std.gc_async_mut.web.browser_session_url.{
    browser_address_backspace, browser_address_update,
    browser_address_draft_after_control_press,
    normalize_browser_address_reference_url
}
use std.gc_async_mut.web.browser_session.{
    BrowserBookmarkSnapshot, BrowserHstsSnapshot, BrowserSession
}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.compositor.simple_web_window_renderer.{
    simple_web_content_revision_with_theme,
    simple_web_content_revision_with_theme_receipt,
    simple_web_content_full_html_with_install_wire,
    simple_web_external_content_frame,
    simple_web_external_content_frame_with_theme_receipt
}
use os.hosted.hosted_browser_renderer_process.{
    HOSTED_BROWSER_SITE_SWAP_REQUIRED,
    HostedBrowserRendererProcess,
    HostedBrowserRendererResult
}
use std.common.web.browser_renderer_protocol.{browser_renderer_viewport_valid}
use common.ui.render_opt.damage_plan.{DAMAGE_PLAN_NONE, DAMAGE_PLAN_LOCAL}
use os.hosted.hosted_theme_runtime.{
    hosted_theme_id,
    hosted_theme_material_sha256,
    hosted_theme_source_manifest_sha256,
    hosted_theme_wire_valid
}

extern fn rt_time_now_monotonic_ms() -> i64
val HOSTED_BROWSER_RENDERER_REGISTRY_MAX_COUNT: i64 = 4

pub struct HostedBrowserRendererDispatch:
    event_id: i64
    wm_target_id: i64
    semantic_target_id: text
    callback_count: i64
    mutation_revision: i64
    reason: text

fn _dispatch(
    event_id: i64, window_id: i64, target: text,
    callback_count: i64, revision: i64, reason: text
) -> HostedBrowserRendererDispatch:
    HostedBrowserRendererDispatch(
        event_id: event_id,
        wm_target_id: window_id,
        semantic_target_id: target,
        callback_count: callback_count,
        mutation_revision: revision,
        reason: reason
    )

fn _empty_registry_frame() -> WmContentFrame:
    WmContentFrame(
        window_id: "",
        scene_revision: 0,
        content_revision: 0,
        origin_kind: "",
        width: 0,
        height: 0,
        pixels: [],
        checksum: 0u64,
        parent_window_id: "",
        offset_x: 0,
        offset_y: 0
    )

# Full snapshots use a checksum, while retained deltas deliberately leave it
# zero until HostCompositor applies them. Window identity is the common
# nonempty transaction marker for both forms.
pub fn hosted_browser_renderer_frame_pending(frame: WmContentFrame) -> bool:
    frame.window_id != ""

fn _drop_renderer_close_failure(reason: text) -> text:
    val marker = "renderer-close-failed"
    if reason == "":
        ""
    elif reason == marker:
        ""
    elif reason.ends_with(";" + marker):
        reason.substring(0, reason.len() - (marker.len() + 1))
    elif reason.starts_with(marker + ";"):
        reason.substring(marker.len() + 1, reason.len())
    else:
        reason.replace(";" + marker + ";", ";")

fn _active_or_default_wm_theme_id() -> text:
    val active_theme = active_wm_theme_id()
    if active_theme != "": active_theme else: default_theme_id()

class HostedBrowserRendererEntry:
    window_id: i64
    renderer: HostedBrowserRendererProcess
    raster: Engine2dCompositorBackend
    renderer_closed: bool
    raster_closed: bool
    ready: bool
    close_pending: bool
    close_retry_at_micros: i64
    animation_origin_micros: i64
    startup_html: text
    address_draft: text
    address_editing: bool
    address_replace_on_text: bool
    pressed_control: text
    mutation_revision: i64
    # Transport identity is monotonic per persistent hosted renderer. It is
    # distinct from the semantic HTML/theme revision: retained animations can
    # change pixels while that semantic key remains constant.
    published_content_revision: i64
    # Metadata for the compositor-owned base frame.  Deliberately retain no
    # pixels here: HostCompositor is the sole owner of the retained snapshot.
    published_frame_valid: bool
    published_frame_width: i32
    published_frame_height: i32
    published_frame_backend: text
    published_frame_material_kind: text
    published_frame_material_reason: text
    published_frame_material_sha256: text
    published_frame_theme_id: text
    published_frame_theme_source_manifest_sha256: text
    published_theme_revision: i64
    published_renderer_theme_revision: i64
    published_cpu_composited_count: i32
    published_cpu_composited_sha256: text
    published_solid_material_count: i32
    published_solid_material_sha256: text
    pending_frame: WmContentFrame
    failure_reason: text
    failure_published: bool
    bookmark_revision: i64

    static fn create(
        window_id: i64,
        renderer: HostedBrowserRendererProcess,
        raster: Engine2dCompositorBackend,
        animation_origin_micros: i64,
        startup_html: text
    ) -> HostedBrowserRendererEntry:
        HostedBrowserRendererEntry(
            window_id: window_id,
            renderer: renderer,
            raster: raster,
            renderer_closed: false,
            raster_closed: false,
            ready: false,
            close_pending: false,
            close_retry_at_micros: 0,
            animation_origin_micros: animation_origin_micros,
            startup_html: startup_html,
            address_draft: "about:blank",
            address_editing: false,
            address_replace_on_text: false,
            pressed_control: "",
            mutation_revision: 0,
            published_content_revision: 0,
            published_frame_valid: false,
            published_frame_width: 0,
            published_frame_height: 0,
            published_frame_backend: "",
            published_frame_material_kind: "",
            published_frame_material_reason: "",
            published_frame_material_sha256: "",
            published_frame_theme_id: "",
            published_frame_theme_source_manifest_sha256: "",
            published_theme_revision: 0,
            published_renderer_theme_revision: 0,
            published_cpu_composited_count: 0,
            published_cpu_composited_sha256: "",
            published_solid_material_count: 0,
            published_solid_material_sha256: "",
            pending_frame: _empty_registry_frame(),
            failure_reason: "",
            failure_published: false,
            bookmark_revision: 0
        )

pub class HostedBrowserRendererRegistry:
    entries: [HostedBrowserRendererEntry]
    executable: text
    home_url: text
    next_generation: i64
    pressed_window_id: i64
    pressed_event_id: i64
    pending_cancel_window_id: i64
    pending_cancel_event_id: i64
    pointer_cancel_receipt_count: i64
    bookmark_snapshot: BrowserBookmarkSnapshot
    bookmark_revision: i64
    hsts: BrowserSession
    shared_hsts_dirty: bool
    shared_hsts_revision: i64
    theme_enabled: bool
    theme_revision: i64
    theme_wire_text: text
    theme_id: text
    theme_source_manifest_sha256: text
    theme_material_sha256: text

    static fn create(
        executable: text,
        home_url: text
    ) -> HostedBrowserRendererRegistry:
        HostedBrowserRendererRegistry(
            entries: [],
            executable: executable,
            home_url: home_url,
            next_generation: 2,
            pressed_window_id: 0,
            pressed_event_id: 0,
            pending_cancel_window_id: 0,
            pending_cancel_event_id: 0,
            pointer_cancel_receipt_count: 0,
            bookmark_snapshot: BrowserBookmarkSnapshot.create([]),
            bookmark_revision: 0,
            hsts: BrowserSession.new_without_runtime(),
            shared_hsts_dirty: false,
            shared_hsts_revision: 0,
            theme_enabled: false,
            theme_revision: 0,
            theme_wire_text: "",
            theme_id: "",
            theme_source_manifest_sha256: "",
            theme_material_sha256: ""
        )

    static fn create_with_theme(
        executable: text,
        home_url: text,
        theme_revision: i64,
        theme_wire_text: text
    ) -> HostedBrowserRendererRegistry:
        var registry = HostedBrowserRendererRegistry.create(
            executable, home_url
        )
        registry.theme_enabled = true
        registry.theme_revision = theme_revision
        registry.theme_wire_text = theme_wire_text
        if hosted_theme_wire_valid(theme_revision, theme_wire_text):
            registry.theme_id = hosted_theme_id(
                theme_revision, theme_wire_text
            )
            registry.theme_source_manifest_sha256 = (
                hosted_theme_source_manifest_sha256(
                    theme_revision, theme_wire_text
                )
            )
            registry.theme_material_sha256 = (
                hosted_theme_material_sha256(
                    theme_revision, theme_wire_text
                )
            )
        registry

    me set_bookmark_snapshot(snapshot: BrowserBookmarkSnapshot):
        self.bookmark_snapshot = snapshot
        self.bookmark_revision = self.bookmark_revision + 1

    me load_hsts_snapshot(
        snapshot: BrowserHstsSnapshot, wall_clock_ms: i64
    ) -> i32:
        val _ = self.hsts.advance_time(rt_time_now_monotonic_ms())
        val accepted = self.hsts.load_hsts_snapshot(
            snapshot, wall_clock_ms
        )
        val canonical = self.hsts.hsts_snapshot(wall_clock_ms)
        var index: i32 = 0
        while index < self.entries.len():
            var entry = self.entries[index]
            val _ = entry.renderer.load_hsts_snapshot(
                canonical, wall_clock_ms
            )
            self.entries[index] = entry
            index = index + 1
        self.shared_hsts_dirty = false
        accepted

    me accept_renderer_hsts_snapshot(
        snapshot: BrowserHstsSnapshot, wall_clock_ms: i64
    ) -> i32:
        val accepted = self.load_hsts_snapshot(snapshot, wall_clock_ms)
        self.shared_hsts_dirty = true
        self.shared_hsts_revision = self.shared_hsts_revision + 1
        accepted

    me hsts_snapshot(wall_clock_ms: i64) -> BrowserHstsSnapshot:
        val _ = self.hsts.advance_time(rt_time_now_monotonic_ms())
        self.hsts.hsts_snapshot(wall_clock_ms)

    me hsts_upgrade_url(url: text) -> text:
        val _ = self.hsts.advance_time(rt_time_now_monotonic_ms())
        self.hsts._hsts_upgrade_url(url)

    fn hsts_dirty() -> bool:
        self.shared_hsts_dirty

    fn hsts_revision() -> i64:
        self.shared_hsts_revision

    me mark_hsts_saved():
        self.shared_hsts_dirty = false

    fn _index(window_id: i64) -> i32:
        var i = 0
        while i < self.entries.len():
            if self.entries[i].window_id == window_id:
                return i
            i = i + 1
        -1

    fn contains(window_id: i64) -> bool:
        self._index(window_id) >= 0

    fn document_url(window_id: i64) -> text:
        val index = self._index(window_id)
        if index < 0:
            return ""
        val entry = self.entries[index]
        entry.renderer.document_url

    fn bookmark_stored_title(window_id: i64) -> text:
        val index = self._index(window_id)
        if index < 0:
            return ""
        self.entries[index].renderer.bookmark_stored_title()

    fn address_text(window_id: i64) -> text:
        val index = self._index(window_id)
        if index < 0:
            return ""
        self.entries[index].address_draft

    me _teardown(index: i32, reason: text) -> bool:
        var entry = self.entries[index]
        if self.pressed_window_id == entry.window_id:
            self.pressed_window_id = 0
            self.pressed_event_id = 0
        entry.pressed_control = ""
        if self.pending_cancel_window_id == entry.window_id:
            self.pending_cancel_window_id = 0
            self.pending_cancel_event_id = 0
        entry.ready = false
        entry.pending_frame = _empty_registry_frame()
        if reason != "":
            entry.failure_reason = reason
        if not entry.renderer_closed:
            if entry.renderer.close():
                entry.renderer_closed = true
                entry.close_pending = false
                entry.close_retry_at_micros = 0
                if reason == "":
                    entry.failure_reason = _drop_renderer_close_failure(
                        entry.failure_reason
                    )
            else:
                entry.close_pending = true
                if entry.failure_reason == "":
                    entry.failure_reason = "renderer-close-failed"
                elif not entry.failure_reason.ends_with(
                    ";renderer-close-failed"
                ):
                    entry.failure_reason = (
                        entry.failure_reason + ";renderer-close-failed"
                    )
        if not entry.raster_closed:
            entry.raster.shutdown()
            entry.raster_closed = true
        self.entries[index] = entry
        entry.renderer_closed and entry.raster_closed

    me _fail(index: i32, reason: text) -> text:
        val _ = self._teardown(index, reason)
        var entry = self.entries[index]
        entry.failure_published = true
        self.entries[index] = entry
        "failed"

    me _begin_site_swap(index: i32, wall_clock_ms: i64) -> text:
        var entry = self.entries[index]
        if (not entry.renderer.site_swap_pending or
            entry.renderer.site_swap_site == "" or
            not entry.renderer.navigation_permit.active):
            self.entries[index] = entry
            return self._fail(index, "site-swap-state")
        val site = entry.renderer.site_swap_site
        val permit = entry.renderer.navigation_permit
        val cookie_store = entry.renderer.network.cookie_store
        val document_url = entry.renderer.document_url
        val document_origin = entry.renderer.document_origin
        val history_urls = entry.renderer.history_urls
        val history_csp_policies = entry.renderer.history_csp_policies
        val history_csp_ready = entry.renderer.history_csp_ready
        val history_index = entry.renderer.history_index
        val history_current_url = entry.renderer.history_current_url
        val history_back_url = entry.renderer.history_back_url
        val history_forward_url = entry.renderer.history_forward_url
        val pending_history_action = entry.renderer.pending_history_action
        val pending_history_index = entry.renderer.pending_history_index
        val pending_history_target_url = (
            entry.renderer.pending_history_target_url
        )
        val document_csp_policy = entry.renderer.document_csp_policy
        val document_csp_ready = entry.renderer.document_csp_ready
        val pending_document_csp_policy = (
            entry.renderer.pending_document_csp_policy
        )
        val pending_document_csp_ready = (
            entry.renderer.pending_document_csp_ready
        )
        val provisional_document_origin = (
            entry.renderer.provisional_document_origin
        )
        val home_url = entry.renderer.home_url
        var restart_html = ""
        if self.theme_enabled:
            if not hosted_theme_wire_valid(
                self.theme_revision, self.theme_wire_text
            ):
                self.entries[index] = entry
                return self._fail(index, "invalid-theme-projection")
            restart_html = (
                simple_web_content_full_html_with_install_wire(
                    self.theme_wire_text,
                    self.theme_revision,
                    "",
                    "",
                    entry.renderer.width,
                    entry.renderer.height
                )
            )
            if restart_html == "":
                self.entries[index] = entry
                return self._fail(
                    index, "theme-parent-projection-mismatch"
                )
        if self.pressed_window_id == entry.window_id:
            self.pressed_window_id = 0
            self.pressed_event_id = 0
        entry.pressed_control = ""
        if self.pending_cancel_window_id == entry.window_id:
            self.pending_cancel_window_id = 0
            self.pending_cancel_event_id = 0
        if not entry.renderer.close():
            self.entries[index] = entry
            return self._fail(index, "site-swap-close-failed")
        val generation = self.next_generation
        self.next_generation = self.next_generation + 1
        var replacement = if self.theme_enabled:
            HostedBrowserRendererProcess.create_with_theme(
                generation,
                entry.renderer.width,
                entry.renderer.height,
                self.theme_revision,
                self.theme_wire_text
            )
        else:
            HostedBrowserRendererProcess.create(
                generation, entry.renderer.width, entry.renderer.height
            )
        replacement.network.cookie_store = cookie_store
        replacement.document_url = document_url
        replacement.document_origin = document_origin
        replacement.history_urls = history_urls
        replacement.history_csp_policies = history_csp_policies
        replacement.history_csp_ready = history_csp_ready
        replacement.history_index = history_index
        replacement.history_current_url = history_current_url
        replacement.history_back_url = history_back_url
        replacement.history_forward_url = history_forward_url
        replacement.pending_history_action = pending_history_action
        replacement.pending_history_index = pending_history_index
        replacement.pending_history_target_url = pending_history_target_url
        replacement.document_csp_policy = document_csp_policy
        replacement.document_csp_ready = document_csp_ready
        replacement.pending_document_csp_policy = (
            pending_document_csp_policy
        )
        replacement.pending_document_csp_ready = pending_document_csp_ready
        replacement.provisional_document_origin = (
            provisional_document_origin
        )
        replacement.navigation_permit = permit
        replacement.site_lock = site
        replacement.site_swap_pending = true
        replacement.site_swap_site = site
        val _ = replacement.set_home_url(home_url)
        val _ = replacement.load_hsts_snapshot(
            self.hsts_snapshot(wall_clock_ms), wall_clock_ms
        )
        entry.renderer = replacement
        entry.renderer_closed = false
        entry.close_pending = false
        entry.close_retry_at_micros = 0
        entry.ready = false
        # A new renderer generation must not retain the prior site's pixels or
        # image payload while its replacement starts.
        entry.pending_frame = _empty_registry_frame()
        entry.published_frame_valid = false
        entry.raster.invalidate_frame_receipt()
        entry.startup_html = restart_html
        entry.bookmark_revision = -1
        val started = entry.renderer.begin_start(
            self.executable, 2000
        )
        self.entries[index] = entry
        match started:
            Err(reason):
                self._fail(index, "site-swap-{reason}")
            Ok(_):
                "none"

    me _store_frame(
        index: i32,
        result: HostedBrowserRendererResult,
        title: text,
        body_html: text
    ) -> text:
        var entry = self.entries[index]
        if entry.raster_closed:
            return self._fail(index, "renderer-raster-unavailable")
        var raster = entry.raster
        if (raster.w != entry.renderer.width or
            raster.h != entry.renderer.height):
            raster.shutdown()
            raster = Engine2dCompositorBackend.create_from_env(
                entry.renderer.width, entry.renderer.height
            )
            entry.published_frame_valid = false
        val theme = if self.theme_enabled:
            self.theme_id
        else:
            _active_or_default_wm_theme_id()
        val semantic_revision = if self.theme_enabled:
            simple_web_content_revision_with_theme_receipt(
                self.theme_source_manifest_sha256,
                self.theme_material_sha256,
                title,
                body_html,
                entry.renderer.width,
                entry.renderer.height,
                0
            )
        else:
            simple_web_content_revision_with_theme(
                theme,
                title,
                body_html,
                entry.renderer.width,
                entry.renderer.height,
                0
            )
        if semantic_revision <= 0 or
            entry.published_content_revision >= 9223372036854775806:
            self.entries[index] = entry
            return self._fail(index, "renderer-content-revision-unavailable")
        val revision = entry.published_content_revision + 1
        # A packed update is legal only when every provenance input remains
        # identical to the frame retained by HostCompositor.  The packed CPU
        # executor independently verifies DrawIR coverage and base revision.
        val packed_base_valid = (
            result.damage_receipt.mode == DAMAGE_PLAN_LOCAL and
            entry.published_frame_valid and
            entry.published_content_revision > 0 and
            # The full base must have left the registry; otherwise replacing
            # a queued full frame with a delta would leave HostCompositor with
            # no base snapshot to patch.
            entry.pending_frame.window_id == "" and
            entry.published_frame_width == entry.renderer.width and
            entry.published_frame_height == entry.renderer.height and
            entry.published_frame_theme_id == theme and
            entry.published_theme_revision == self.theme_revision and
            entry.published_renderer_theme_revision == entry.renderer.theme_revision and
            entry.published_frame_material_kind == "solid-material" and
            entry.published_cpu_composited_count == result.cpu_composited_count and
            entry.published_cpu_composited_sha256 == result.cpu_composited_sha256 and
            entry.published_solid_material_count == result.solid_material_count and
            entry.published_solid_material_sha256 == result.solid_material_sha256)
        if packed_base_valid:
            val packed = raster.render_draw_ir_composition_resources_packed_damage(
                result.composition, result.image_resources,
                result.producer_generation, result.composition_revision,
                result.damage_receipt.rects
            )
            if (packed.ok and packed.selected_backend == entry.published_frame_backend and
                packed.rects.len() > 0 and packed.pixels.len() > 0):
                val frame = WmContentFrame(
                    window_id: entry.window_id.to_text(), scene_revision: 0,
                    content_revision: revision,
                    origin_kind: WM_CONTENT_ORIGIN_SIMPLE_WEB,
                    width: entry.renderer.width, height: entry.renderer.height,
                    pixels: [], checksum: 0u64, parent_window_id: "",
                    offset_x: 0, offset_y: 0,
                    engine2d_status: "engine2d_rendered",
                    engine2d_backend: packed.selected_backend,
                    engine2d_reason: "draw-ir-retained-damage",
                    material_fallback_kind: entry.published_frame_material_kind,
                    material_fallback_reason: entry.published_frame_material_reason,
                    material_fallback_sha256: entry.published_frame_material_sha256,
                    theme_id: entry.published_frame_theme_id,
                    theme_source_manifest_sha256:
                        entry.published_frame_theme_source_manifest_sha256,
                    base_content_revision: entry.published_content_revision,
                    damage_rects: packed.rects, damage_pixels: packed.pixels
                )
                entry.raster = raster
                entry.mutation_revision = entry.mutation_revision + 1
                entry.published_content_revision = revision
                if not entry.address_editing and entry.renderer.document_url != "":
                    entry.address_draft = entry.renderer.document_url
                    entry.startup_html = ""
                entry.pending_frame = frame
                self.entries[index] = entry
                return "frame"
        val rendered = if result.damage_receipt.mode == DAMAGE_PLAN_NONE:
            raster.render_draw_ir_composition_resources_revision(
                result.composition, result.image_resources,
                result.producer_generation, result.composition_revision
            )
        else:
            raster.render_draw_ir_composition_resources_revision_damaged(
                result.composition, result.image_resources,
                result.producer_generation, result.composition_revision,
                result.damage_receipt.rects
            )
        entry.raster = raster
        val frame = if self.theme_enabled:
            simple_web_external_content_frame_with_theme_receipt(
                entry.window_id.to_text(),
                revision,
                self.theme_revision,
                entry.renderer.theme_revision,
                self.theme_wire_text,
                theme,
                self.theme_source_manifest_sha256,
                self.theme_material_sha256,
                entry.renderer.width,
                entry.renderer.height,
                rendered,
                result.cpu_composited_count,
                result.cpu_composited_sha256,
                result.solid_material_count,
                result.solid_material_sha256
            )
        else:
            simple_web_external_content_frame(
                entry.window_id.to_text(),
                revision,
                theme,
                entry.renderer.width,
                entry.renderer.height,
                rendered,
                result.cpu_composited_count,
                result.cpu_composited_sha256,
                result.solid_material_count,
                result.solid_material_sha256
            )
        if frame.checksum == 0u64 or frame.pixels.len() == 0:
            self.entries[index] = entry
            return self._fail(index, "renderer-raster-rejected")
        entry.mutation_revision = entry.mutation_revision + 1
        entry.published_content_revision = revision
        entry.published_frame_valid = true
        entry.published_frame_width = frame.width
        entry.published_frame_height = frame.height
        entry.published_frame_backend = frame.engine2d_backend
        entry.published_frame_material_kind = frame.material_fallback_kind
        entry.published_frame_material_reason = frame.material_fallback_reason
        entry.published_frame_material_sha256 = frame.material_fallback_sha256
        entry.published_frame_theme_id = frame.theme_id
        entry.published_frame_theme_source_manifest_sha256 = (
            frame.theme_source_manifest_sha256)
        entry.published_theme_revision = self.theme_revision
        entry.published_renderer_theme_revision = entry.renderer.theme_revision
        entry.published_cpu_composited_count = result.cpu_composited_count
        entry.published_cpu_composited_sha256 = result.cpu_composited_sha256
        entry.published_solid_material_count = result.solid_material_count
        entry.published_solid_material_sha256 = result.solid_material_sha256
        if not entry.address_editing and entry.renderer.document_url != "":
            entry.address_draft = entry.renderer.document_url
            entry.startup_html = ""
        entry.pending_frame = frame
        self.entries[index] = entry
        "frame"

    me ensure(
        window_id: i64,
        initial_html: text,
        width: i32,
        height: i32,
        now_micros: i64,
        wall_clock_ms: i64
    ) -> text:
        val existing = self._index(window_id)
        if existing >= 0:
            if hosted_browser_renderer_frame_pending(
                self.entries[existing].pending_frame
            ):
                return "frame"
            if (self.entries[existing].renderer_closed or
                self.entries[existing].close_pending or
                self.entries[existing].failure_reason != ""):
                return "failed"
            return "none"
        if (window_id <= 0 or self.executable == "" or
            not browser_renderer_viewport_valid(width.to_i64(), height.to_i64()) or
            self.entries.len() >= HOSTED_BROWSER_RENDERER_REGISTRY_MAX_COUNT):
            return "failed"
        val generation = self.next_generation
        self.next_generation = self.next_generation + 1
        var startup_html = initial_html
        if self.theme_enabled:
            if not hosted_theme_wire_valid(
                self.theme_revision, self.theme_wire_text
            ):
                return "failed"
            startup_html = (
                simple_web_content_full_html_with_install_wire(
                    self.theme_wire_text,
                    self.theme_revision,
                    "",
                    initial_html,
                    width,
                    height
                )
            )
            if startup_html == "":
                return "failed"
        val process = if self.theme_enabled:
            HostedBrowserRendererProcess.create_with_theme(
                generation,
                width,
                height,
                self.theme_revision,
                self.theme_wire_text
            )
        else:
            HostedBrowserRendererProcess.create(
                generation, width, height
            )
        var entry = HostedBrowserRendererEntry.create(
            window_id,
            process,
            Engine2dCompositorBackend.create_from_env(width, height),
            now_micros,
            startup_html
        )
        val _ = entry.renderer.set_home_url(self.home_url)
        val snapshot = self.hsts_snapshot(wall_clock_ms)
        val _ = entry.renderer.load_hsts_snapshot(snapshot, wall_clock_ms)
        self.entries.push(entry)
        val index = self.entries.len() - 1
        val started = entry.renderer.begin_start(self.executable, 2000)
        self.entries[index] = entry
        match started:
            Err(reason):
                self._fail(index, reason)
            Ok(_):
                "none"

    me _accept_polled_result(
        index: i32,
        result: HostedBrowserRendererResult,
        title: text,
        body_html: text,
        now_micros: i64,
        wall_clock_ms: i64
    ) -> text:
        var entry = self.entries[index]
        val was_ready = entry.ready
        if not result.ok:
            if result.reason == HOSTED_BROWSER_SITE_SWAP_REQUIRED:
                return self._begin_site_swap(index, wall_clock_ms)
            return self._fail(index, result.reason)
        if entry.renderer.state == "await-theme-init":
            val theme_started = entry.renderer.begin_theme_init(2000)
            self.entries[index] = entry
            match theme_started:
                Err(reason):
                    return self._fail(index, reason)
                Ok(_):
                    return "none"
        if entry.renderer.state == "await-init":
            val initialized = entry.renderer.begin_init(
                entry.startup_html, 2000
            )
            self.entries[index] = entry
            match initialized:
                Err(reason):
                    return self._fail(index, reason)
                Ok(_):
                    return "none"
        if entry.renderer.site_swap_pending:
            val resumed = entry.renderer.begin_resume_site_swap(2000)
            self.entries[index] = entry
            match resumed:
                Err(reason):
                    return self._fail(index, reason)
                Ok(_):
                    return "none"
        entry.ready = true
        if not was_ready:
            entry.animation_origin_micros = now_micros
        self.entries[index] = entry
        self._store_frame(index, result, title, body_html)

    me advance_window(
        window_id: i64,
        title: text,
        body_html: text,
        width: i32,
        height: i32,
        now_micros: i64,
        wall_clock_ms: i64,
        visible: bool
    ) -> text:
        val index = self._index(window_id)
        if index < 0:
            return "failed"
        var entry = self.entries[index]
        if entry.close_pending:
            if entry.close_retry_at_micros <= 0:
                entry.close_retry_at_micros = now_micros + 1000000
            elif now_micros >= entry.close_retry_at_micros:
                if entry.renderer.close():
                    entry.renderer_closed = true
                    entry.close_pending = false
                    entry.close_retry_at_micros = 0
                    entry.failure_reason = _drop_renderer_close_failure(
                        entry.failure_reason
                    )
                else:
                    entry.close_retry_at_micros = now_micros + 1000000
            self.entries[index] = entry
            return if entry.failure_published: "none" else: "failed"
        if entry.renderer_closed or entry.failure_reason != "":
            return if entry.failure_published: "none" else: "failed"
        val polled = entry.renderer.poll()
        self.entries[index] = entry
        if entry.renderer.hsts_dirty:
            val learned = entry.renderer.hsts_snapshot(wall_clock_ms)
            val _ = self.accept_renderer_hsts_snapshot(
                learned, wall_clock_ms
            )
            entry = self.entries[index]
        if val Some(result) = polled:
            return self._accept_polled_result(
                index,
                result,
                title,
                body_html,
                now_micros,
                wall_clock_ms
            )
        if not entry.ready:
            return "none"
        if (entry.bookmark_revision < self.bookmark_revision and
            entry.renderer.command_deadline_ms <= 0 and
            entry.renderer.network_job_handle <= 0):
            match entry.renderer.begin_bookmark_snapshot(
                self.bookmark_snapshot, 2000
            ):
                Err(reason):
                    self.entries[index] = entry
                    if reason != "renderer-busy":
                        return self._fail(index, reason)
                Ok(_):
                    entry.bookmark_revision = self.bookmark_revision
                    self.entries[index] = entry
                    return "none"
        if (self.pending_cancel_window_id == window_id and
            self.pending_cancel_event_id > 0 and
            entry.renderer.command_deadline_ms <= 0):
            match entry.renderer.begin_pointer(
                self.pending_cancel_event_id, -1, -1, false, 2000
            ):
                Ok(_):
                    self.pointer_cancel_receipt_count = (
                        self.pointer_cancel_receipt_count + 1
                    )
                    self.pending_cancel_window_id = 0
                    self.pending_cancel_event_id = 0
                Err(_):
                    pass
            self.entries[index] = entry
        if not visible:
            return "none"
        if not browser_renderer_viewport_valid(width.to_i64(), height.to_i64()):
            return self._fail(index, "invalid-renderer-viewport")
        if (width != entry.renderer.width or height != entry.renderer.height):
            match entry.renderer.begin_resize(width, height, 2000):
                Err(reason):
                    self.entries[index] = entry
                    if reason != "renderer-busy":
                        return self._fail(index, reason)
                Ok(_):
                    self.entries[index] = entry
            return "none"
        if entry.renderer.command_deadline_ms <= 0:
            match entry.renderer.flush_scroll(2000):
                Err(reason):
                    self.entries[index] = entry
                    if reason != "renderer-busy":
                        return self._fail(index, reason)
                Ok(started):
                    self.entries[index] = entry
                    if started:
                        return "none"
        val animation_time_ms = (
            now_micros - entry.animation_origin_micros
        ) / 1000
        if (entry.renderer.command_deadline_ms <= 0 and
            entry.renderer.next_animation_ms >= 0 and
            animation_time_ms >= entry.renderer.next_animation_ms):
            match entry.renderer.begin_advance(animation_time_ms, 2000):
                Err(reason):
                    self.entries[index] = entry
                    if reason != "renderer-busy":
                        return self._fail(index, reason)
                Ok(_):
                    self.entries[index] = entry
        "none"

    me take_frame(window_id: i64) -> WmContentFrame:
        val index = self._index(window_id)
        if index < 0:
            return _empty_registry_frame()
        var entry = self.entries[index]
        val frame = entry.pending_frame
        entry.pending_frame = _empty_registry_frame()
        self.entries[index] = entry
        frame

    me _begin_pointer(
        window_id: i64, event_id: i64, x: i64, y: i64, pressed: bool
    ) -> Result<bool, text>:
        val index = self._index(window_id)
        if index < 0 or not self.entries[index].ready:
            return Err("renderer-unavailable")
        var entry = self.entries[index]
        val result = entry.renderer.begin_pointer(
            event_id, x, y, pressed, 2000
        )
        self.entries[index] = entry
        result

    me _begin_address_navigation(index: i64) -> Result<bool, text>:
        var entry = self.entries[index]
        val url = normalize_browser_address_reference_url(
            entry.renderer.document_url, entry.address_draft
        )?
        val result = entry.renderer.begin_navigate(
            url, "GET", "", "", "", 2000
        )
        if val Ok(_) = result:
            entry.address_editing = false
            entry.address_replace_on_text = false
        self.entries[index] = entry
        result

    me _begin_control(window_id: i64, control: text) -> Result<bool, text>:
        val index = self._index(window_id)
        if index < 0 or not self.entries[index].ready:
            return Err("renderer-unavailable")
        if control == "go":
            return self._begin_address_navigation(index)
        var entry = self.entries[index]
        val result = if control == "back":
            entry.renderer.begin_go_back(2000)
        elif control == "forward":
            entry.renderer.begin_go_forward(2000)
        elif control == "stop":
            entry.renderer.begin_stop(2000)
        elif control == "reload":
            entry.renderer.begin_reload(2000)
        elif control == "home":
            entry.renderer.begin_go_home(2000)
        elif control == "favorite":
            if (entry.renderer.command_deadline_ms > 0 or
                entry.renderer.network_job_handle > 0):
                Err("renderer-busy")
            else:
                Ok(false)
        else:
            Err("unknown-browser-control")
        self.entries[index] = entry
        result

    me _clear_pressed_controls():
        if self.pending_cancel_window_id > 0:
            return
        val armed_window_id = self.pressed_window_id
        val armed_event_id = self.pressed_event_id
        val index = self._index(armed_window_id)
        self.pressed_window_id = 0
        self.pressed_event_id = 0
        if index < 0:
            self.pending_cancel_window_id = 0
            self.pending_cancel_event_id = 0
            return
        var entry = self.entries[index]
        val page_press = entry.pressed_control == ""
        entry.pressed_control = ""
        if not page_press:
            self.entries[index] = entry
            return
        self.pending_cancel_window_id = armed_window_id
        self.pending_cancel_event_id = armed_event_id
        if entry.ready and entry.renderer.command_deadline_ms <= 0:
            match entry.renderer.begin_pointer(
                armed_event_id, -1, -1, false, 2000
            ):
                Ok(_):
                    self.pointer_cancel_receipt_count = (
                        self.pointer_cancel_receipt_count + 1
                    )
                    self.pending_cancel_window_id = 0
                    self.pending_cancel_event_id = 0
                Err(_):
                    pass
        self.entries[index] = entry

    me dispatch_pointer(
        event_id: i64, window_id: i64, x: i64, y: i64, pressed: bool
    ) -> HostedBrowserRendererDispatch:
        val index = self._index(window_id)
        if index < 0:
            return _dispatch(event_id, window_id, "", 0, 0,
                "renderer-unavailable")
        var entry = self.entries[index]
        if (not pressed and
            (self.pressed_window_id != window_id or
             entry.pressed_control != "")):
            return _dispatch(event_id, window_id, "browser:page", 0,
                entry.mutation_revision, "pointer-release-target-mismatch")
        if pressed and self.pending_cancel_window_id > 0:
            return _dispatch(event_id, window_id, "browser:page", 0,
                entry.mutation_revision, "pointer-cancel-pending")
        if pressed:
            self._clear_pressed_controls()
            entry = self.entries[index]
        entry.address_editing = false
        entry.address_replace_on_text = false
        self.entries[index] = entry
        match self._begin_pointer(window_id, event_id, x, y, pressed):
            Err(reason):
                _dispatch(event_id, window_id, "browser:page", 0,
                    entry.mutation_revision, reason)
            Ok(_):
                if pressed:
                    self.pressed_window_id = window_id
                    self.pressed_event_id = event_id
                else:
                    self.pressed_window_id = 0
                    self.pressed_event_id = 0
                _dispatch(event_id, window_id, "browser:page", 1,
                    entry.mutation_revision, "")

    me dispatch_scroll(
        event_id: i64, window_id: i64, delta_milli_y: i64
    ) -> HostedBrowserRendererDispatch:
        val index = self._index(window_id)
        if index < 0 or not self.entries[index].ready:
            return _dispatch(event_id, window_id, "browser:page", 0, 0,
                "renderer-unavailable")
        var entry = self.entries[index]
        val queued = entry.renderer.queue_scroll(event_id, delta_milli_y)
        self.entries[index] = entry
        match queued:
            Err(reason):
                _dispatch(event_id, window_id, "browser:page", 0,
                    entry.mutation_revision, reason)
            Ok(_):
                _dispatch(event_id, window_id, "browser:page", 1,
                    entry.mutation_revision, "")

    me dispatch_chrome_pointer(
        event_id: i64, window_id: i64, control: text, pressed: bool
    ) -> HostedBrowserRendererDispatch:
        val index = self._index(window_id)
        if index < 0:
            return _dispatch(event_id, window_id, "", 0, 0,
                "renderer-unavailable")
        var entry = self.entries[index]
        val target = "browser:parent#{control}"
        if pressed:
            if self.pending_cancel_window_id > 0:
                return _dispatch(event_id, window_id, target, 0,
                    entry.mutation_revision, "pointer-cancel-pending")
            self._clear_pressed_controls()
            entry = self.entries[index]
            entry.pressed_control = control
            self.pressed_window_id = window_id
            self.pressed_event_id = event_id
            entry.address_draft = browser_address_draft_after_control_press(
                control, entry.renderer.document_url, entry.address_draft
            )
            if control == "address":
                entry.address_editing = true
                entry.address_replace_on_text = true
            else:
                entry.address_editing = false
                entry.address_replace_on_text = false
            self.entries[index] = entry
            return _dispatch(event_id, window_id, target, 0,
                entry.mutation_revision, "chrome-pressed")
        val armed = entry.pressed_control
        if self.pressed_window_id != window_id or armed != control:
            return _dispatch(event_id, window_id, target, 0,
                entry.mutation_revision, "chrome-release-target-mismatch")
        entry.pressed_control = ""
        self.pressed_window_id = 0
        self.pressed_event_id = 0
        if control == "address":
            entry.address_editing = true
            entry.address_replace_on_text = true
            self.entries[index] = entry
            return _dispatch(event_id, window_id, target, 0,
                entry.mutation_revision, "address-focused")
        self.entries[index] = entry
        match self._begin_control(window_id, control):
            Err(reason):
                _dispatch(event_id, window_id, target, 0,
                    entry.mutation_revision, reason)
            Ok(_):
                if control == "home":
                    entry = self.entries[index]
                    entry.address_draft = (
                        entry.renderer.navigation_permit.url
                    )
                    entry.address_editing = false
                    entry.address_replace_on_text = false
                    self.entries[index] = entry
                if control == "favorite":
                    _dispatch(event_id, window_id, target, 0,
                        entry.mutation_revision, "favorite-parent")
                else:
                    _dispatch(event_id, window_id, target, 1,
                        entry.mutation_revision, "")

    me dispatch_key_with_shift(
        event_id: i64, window_id: i64, key_code: i64,
        pressed: bool, shift_key: bool
    ) -> HostedBrowserRendererDispatch:
        val index = self._index(window_id)
        if index < 0:
            return _dispatch(event_id, window_id, "", 0, 0,
                "renderer-unavailable")
        var entry = self.entries[index]
        if entry.address_editing:
            if not pressed:
                return _dispatch(event_id, window_id,
                    "browser:parent#address", 0,
                    entry.mutation_revision, "key-up")
            if key_code == 13:
                match self._begin_address_navigation(index):
                    Err(reason):
                        return _dispatch(event_id, window_id,
                            "browser:parent#address", 0,
                            entry.mutation_revision, reason)
                    Ok(_):
                        return _dispatch(event_id, window_id,
                            "browser:parent#address", 1,
                            entry.mutation_revision, "")
            if key_code == 27:
                entry.address_draft = if entry.renderer.document_url != "":
                    entry.renderer.document_url
                else:
                    "about:blank"
                entry.address_editing = false
                entry.address_replace_on_text = false
            elif key_code == 8:
                val updated = match browser_address_backspace(
                    entry.address_draft, entry.address_replace_on_text
                ):
                    Err(reason):
                        return _dispatch(event_id, window_id,
                            "browser:parent#address", 0,
                            entry.mutation_revision, reason)
                    Ok(value): value
                entry.address_draft = updated
                entry.address_replace_on_text = false
            self.entries[index] = entry
            return _dispatch(event_id, window_id,
                "browser:parent#address", 1,
                entry.mutation_revision, "")
        if not entry.ready:
            return _dispatch(event_id, window_id, "browser:page", 0,
                entry.mutation_revision, "renderer-unavailable")
        val result = entry.renderer.begin_key_with_shift(
            event_id, key_code, pressed, shift_key, 2000
        )
        self.entries[index] = entry
        match result:
            Err(reason):
                _dispatch(event_id, window_id, "browser:page", 0,
                    entry.mutation_revision, reason)
            Ok(_):
                _dispatch(event_id, window_id, "browser:page", 1,
                    entry.mutation_revision, "")

    me dispatch_text(
        event_id: i64, window_id: i64, value: text
    ) -> HostedBrowserRendererDispatch:
        val index = self._index(window_id)
        if index < 0:
            return _dispatch(event_id, window_id, "", 0, 0,
                "renderer-unavailable")
        var entry = self.entries[index]
        if entry.address_editing:
            val updated = match browser_address_update(
                entry.address_draft, value,
                entry.address_replace_on_text
            ):
                Err(reason):
                    return _dispatch(event_id, window_id,
                        "browser:parent#address", 0,
                        entry.mutation_revision, reason)
                Ok(next): next
            entry.address_draft = updated
            entry.address_replace_on_text = false
            self.entries[index] = entry
            return _dispatch(event_id, window_id,
                "browser:parent#address", 1,
                entry.mutation_revision, "")
        if not entry.ready:
            return _dispatch(event_id, window_id, "browser:page", 0,
                entry.mutation_revision, "renderer-unavailable")
        val result = entry.renderer.begin_text_input(event_id, value, 2000)
        self.entries[index] = entry
        match result:
            Err(reason):
                _dispatch(event_id, window_id, "browser:page", 0,
                    entry.mutation_revision, reason)
            Ok(_):
                _dispatch(event_id, window_id, "browser:page", 1,
                    entry.mutation_revision, "")

    me cancel_pointer_state(_event_id: i64):
        self._clear_pressed_controls()

    me remove_window(window_id: i64) -> bool:
        val index = self._index(window_id)
        if index < 0:
            return true
        if not self._teardown(index, ""):
            return false
        var kept: [HostedBrowserRendererEntry] = []
        var i = 0
        while i < self.entries.len():
            if i != index:
                kept.push(self.entries[i])
            i = i + 1
        self.entries = kept
        true

    me fail_window(window_id: i64, reason: text):
        val index = self._index(window_id)
        if index >= 0:
            val _ = self._fail(index, reason)

    me reconcile(live_window_ids: [i64]) -> bool:
        var any_missing = false
        var scan = 0
        while scan < self.entries.len():
            var live = false
            for window_id in live_window_ids:
                if window_id == self.entries[scan].window_id:
                    live = true
            if not live:
                any_missing = true
            scan = scan + 1
        if not any_missing:
            return true
        var retained: [HostedBrowserRendererEntry] = []
        var ok = true
        var i = 0
        while i < self.entries.len():
            var live = false
            for window_id in live_window_ids:
                if window_id == self.entries[i].window_id:
                    live = true
            if live:
                retained.push(self.entries[i])
            elif not self._teardown(i, "window-destroyed"):
                retained.push(self.entries[i])
                ok = false
            i = i + 1
        self.entries = retained
        ok

    me close() -> bool:
        var retained: [HostedBrowserRendererEntry] = []
        var ok = true
        var i = 0
        while i < self.entries.len():
            if not self._teardown(i, ""):
                retained.push(self.entries[i])
                ok = false
            i = i + 1
        self.entries = retained
        if ok:
            self.hsts.hsts_policies = []
            self.shared_hsts_dirty = false
        ok
