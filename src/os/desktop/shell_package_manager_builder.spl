use common.ui.widget.{UITree}
use os.desktop.shell_ui_builders.{_build_app_tree}
use os.apps.package_manager.package_manager.{PackageManagerApp}

fn _build_app_tree_with_package_manager(name: text) -> UITree:
    if name == "Package Manager":
        val app = PackageManagerApp.new()
        val session = app.build_ui()
        return session.current_tree()
    _build_app_tree(name)
