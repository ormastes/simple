use common.ui.widget.{UITree}

@cfg("os", "simpleos")
use os.desktop.shell_ui_builders_simpleos.{_build_taskbar_tree as _selected_taskbar_tree, _build_launcher_tree as _selected_launcher_tree, _build_app_tree as _selected_app_tree}

@cfg("os", "macos")
use os.desktop.shell_ui_builders.{_build_taskbar_tree as _selected_taskbar_tree, _build_launcher_tree as _selected_launcher_tree, _build_app_tree as _selected_app_tree}
@cfg("os", "linux")
use os.desktop.shell_ui_builders.{_build_taskbar_tree as _selected_taskbar_tree, _build_launcher_tree as _selected_launcher_tree, _build_app_tree as _selected_app_tree}
@cfg("os", "windows")
use os.desktop.shell_ui_builders.{_build_taskbar_tree as _selected_taskbar_tree, _build_launcher_tree as _selected_launcher_tree, _build_app_tree as _selected_app_tree}
@cfg("os", "freebsd")
use os.desktop.shell_ui_builders.{_build_taskbar_tree as _selected_taskbar_tree, _build_launcher_tree as _selected_launcher_tree, _build_app_tree as _selected_app_tree}
@cfg("os", "openbsd")
use os.desktop.shell_ui_builders.{_build_taskbar_tree as _selected_taskbar_tree, _build_launcher_tree as _selected_launcher_tree, _build_app_tree as _selected_app_tree}
@cfg("os", "netbsd")
use os.desktop.shell_ui_builders.{_build_taskbar_tree as _selected_taskbar_tree, _build_launcher_tree as _selected_launcher_tree, _build_app_tree as _selected_app_tree}
@cfg("os", "android")
use os.desktop.shell_ui_builders.{_build_taskbar_tree as _selected_taskbar_tree, _build_launcher_tree as _selected_launcher_tree, _build_app_tree as _selected_app_tree}

fn build_taskbar_tree_target(window_titles: [text], clock: text) -> UITree:
    _selected_taskbar_tree(window_titles, clock)

fn build_launcher_tree_target() -> UITree:
    _selected_launcher_tree()

fn build_app_tree_target(name: text) -> UITree:
    _selected_app_tree(name)

export build_taskbar_tree_target, build_launcher_tree_target, build_app_tree_target
