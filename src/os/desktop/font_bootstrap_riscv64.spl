# RV64 SimpleOS desktop font registration through the native VirtIO FAT32 root.

use std.common.encoding.font_registry.{selected_font_asset_candidates, simpleos_font_asset_guest_path, simpleos_font_asset_short_guest_path}
use std.nogc_sync_mut.text_layout.font_renderer.{font_renderer_register_selected_bytes_static, font_renderer_use_registered_selected_bytes_only_static}
use os.services.vfs.riscv64_font_vfs.{riscv64_font_vfs_read_file_bytes}

fn simpleos_desktop_register_selected_fonts_from_riscv64_virtio_fat32() -> bool:
    """Register pinned desktop faces from the mounted RV64 VirtIO FAT32 media."""
    font_renderer_use_registered_selected_bytes_only_static()
    val candidates = selected_font_asset_candidates()
    var registered = 0
    for candidate in candidates:
        val canonical_blob = riscv64_font_vfs_read_file_bytes(simpleos_font_asset_guest_path(candidate))
        var registered_candidate = canonical_blob.len() > 0 and font_renderer_register_selected_bytes_static(candidate.local_path, canonical_blob)
        if not registered_candidate:
            val short_blob = riscv64_font_vfs_read_file_bytes(simpleos_font_asset_short_guest_path(candidate))
            registered_candidate = short_blob.len() > 0 and font_renderer_register_selected_bytes_static(candidate.local_path, short_blob)
        if registered_candidate:
            registered = registered + 1
    registered == candidates.len()
