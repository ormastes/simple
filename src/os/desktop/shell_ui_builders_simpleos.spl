# Narrow freestanding desktop builders. Application implementations stay out
# of the kernel closure; launching an app still produces a real widget tree.
use common.ui.widget.{WidgetNode, UITree}
use common.ui.builder.{column, row, text_widget, button, label, build_tree_with_title, with_width, with_flex}

val TASKBAR_HEIGHT: i32 = 32

fn _build_taskbar_tree(window_titles: [text], clock: text) -> UITree:
    var window_buttons: [WidgetNode] = []
    var index: i32 = 0
    for title in window_titles:
        var item = button("taskbar_win_{index}", title, "focus_win_{title}")
        item = with_flex(item, 1)
        window_buttons = window_buttons.push(item)
        index = index + 1
    var window_list = row("taskbar_window_list", window_buttons)
    window_list = with_flex(window_list, 1)
    var launcher = button("taskbar_launcher", "Apps", "launcher")
    launcher = with_width(launcher, 60)
    var clock_label = label("taskbar_clock", clock)
    clock_label = with_width(clock_label, 80)
    build_tree_with_title(row("taskbar_root", [
        launcher, window_list, clock_label, label("taskbar_status", "SIMD")
    ]), "SimpleOS Taskbar", "dark")

fn _build_launcher_tree() -> UITree:
    build_tree_with_title(column("launcher_root", [
        label("launcher_title", "Applications"),
        button("launcher_browser", "Simple Browser", "launch_Simple Browser"),
        button("launcher_terminal", "Terminal", "launch_Terminal"),
        button("launcher_files", "File Explorer", "launch_File Explorer")
    ]), "App Launcher", "dark")

fn _build_app_tree(name: text) -> UITree:
    build_tree_with_title(column("simpleos_app_root", [
        label("simpleos_app_title", name),
        text_widget("simpleos_app_body", "{name} is ready")
    ]), name, "dark")

export _build_taskbar_tree, _build_launcher_tree, _build_app_tree
