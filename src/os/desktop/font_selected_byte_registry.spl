# Freestanding selected-font byte registry.
#
# The SimpleOS renderer currently uses the canonical bitmap text fallback, but
# selected SFNT bytes are retained here for future vector consumers without
# importing the hosted FontRenderer/Skia/rt_font closure into the kernel.

use std.common.encoding.font_registry.{font_registry_force_native_digest_route, validate_selected_font_asset}

var _simpleos_selected_font_paths: [text] = []
var _simpleos_selected_font_blobs: [[u8]] = []

fn simpleos_font_registry_begin():
    font_registry_force_native_digest_route()
    _simpleos_selected_font_paths = []
    _simpleos_selected_font_blobs = []

fn simpleos_font_registry_register_selected_bytes(path: text, blob: [u8]) -> bool:
    val validation = validate_selected_font_asset(path, blob)
    if not validation.selected or not validation.valid:
        return false
    var index: i64 = 0
    while index < _simpleos_selected_font_paths.len():
        if _simpleos_selected_font_paths[index] == path:
            return true
        index = index + 1
    _simpleos_selected_font_paths = _simpleos_selected_font_paths.push(path)
    _simpleos_selected_font_blobs = _simpleos_selected_font_blobs.push(blob)
    true

fn simpleos_font_registry_selected_bytes(path: text) -> ([u8], bool):
    var index: i64 = 0
    while index < _simpleos_selected_font_paths.len():
        if _simpleos_selected_font_paths[index] == path:
            return (_simpleos_selected_font_blobs[index], true)
        index = index + 1
    ([], false)
