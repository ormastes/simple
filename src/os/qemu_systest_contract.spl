# ---------------------------------------------------------------------------
# aarch64-apple-darwin hosted descriptor (native macOS process — NOT QEMU)
#
# This lane runs the built darwin binary directly as a child process.
# There is no QEMU, no bare-metal boot, no UART serial. Output is captured
# from stdout. The binary path serves as both kernel_path (missing-media check)
# and qemu_bin (the executable to run). qemu_args is [] — the binary reads
# its app path from a hardcoded constant in fs_exec_entry.spl.
#
# On Linux: binary is absent → run_qemu_systest returns missing-media → RED (expected).
# On Apple Silicon Mac: binary present → process runs → markers in stdout → GREEN.
# ---------------------------------------------------------------------------

pub fn aarch64_darwin_binary_path() -> text:
    "build/os/darwin-aarch64/simpleos_aarch64_darwin_fs_exec"

pub fn aarch64_darwin_app_path() -> text:
    "build/os/darwin-aarch64/hello_world.smf"

pub fn aarch64_darwin_qemu_bin() -> text:
    # Not QEMU — this IS the binary to execute directly as a host process.
    "build/os/darwin-aarch64/simpleos_aarch64_darwin_fs_exec"

pub fn aarch64_darwin_qemu_args() -> [text]:
    # No extra args — the binary reads app path from a hardcoded constant.
    []

pub fn aarch64_darwin_markers() -> [text]:
    # Hosted marker set — asserts REAL host-process capabilities only.
    # Bare-metal-only markers (ELF_LOAD_OK, user-svc-exit:ok, SMF_WM_GUI_LAUNCH_OK,
    # NATIVE_GUI_PROCESS_RENDER_OK) are intentionally absent — they would be lies.
    ["HOSTED_FS_READ_OK",
     "HOSTED_APP_PARSE_OK",
     "HOSTED_PROCESS_LAUNCH_OK",
     "HOSTED_EXIT_OK",
     "TEST PASSED"]

pub fn aarch64_darwin_timeout_ms() -> i64:
    15000

# ---------------------------------------------------------------------------
# Run helper — spawn QEMU, write serial log, return classification
# ---------------------------------------------------------------------------

pub fn run_qemu_systest(
    arch: text,
    kernel_path: text,
    image_path: text,
    qemu_bin: text,
    qemu_args: [text],
    markers: [text],
    timeout_ms: i64
) -> text:
    """Spawn QEMU for one arch, write serial log, return classification string.

    Returns 'missing-media:<path>' immediately if kernel or image is absent.
    Otherwise runs QEMU and calls classify_serial on the combined output.
    Serial log is written to build/os/systest/<arch>.serial.log.
    """
    if not rt_file_exists(kernel_path):
        return SYSTEST_PREFIX_MISSING_MEDIA + kernel_path
    if not rt_file_exists(image_path):
        return SYSTEST_PREFIX_MISSING_MEDIA + image_path
    val accelerator = env_get("SIMPLE_QEMU_ACCELERATOR") ?? ""
    val accelerated_args = qemu_args_with_accelerator(qemu_args, accelerator)
    if accelerated_args.len() == 0:
        return SYSTEST_BOOT_FAIL_ACCELERATOR_UNSUPPORTED
    val nonce = env_get("SOSIX_QEMU_NONCE") ?? ""
    if nonce.len() == 0:
        return SYSTEST_BOOT_FAIL_NONCE_UNSUPPORTED
    rt_dir_create_all("build/os/systest")
    val run_image = "build/os/systest/" + arch + "." + nonce + ".nonce.img"
    val prepared = rt_process_run_timeout(
        "sh", ["scripts/os/prepare_qemu_nonce_media.shs", image_path, run_image, nonce], 30000)
    if prepared[2] != 0:
        return SYSTEST_BOOT_FAIL_NONCE_UNSUPPORTED
    val effective_args = qemu_args_with_run_image(accelerated_args, image_path, run_image)
    if effective_args.len() == 0:
        return SYSTEST_BOOT_FAIL_NONCE_UNSUPPORTED
    val log_path = "build/os/systest/" + arch + ".serial.log"
    val result = rt_process_run_timeout(qemu_bin, effective_args, timeout_ms)
    val serial = result[0] + result[1]
    rt_file_write_text(log_path, serial)
    classify_serial_with_nonce(serial, markers, nonce)


