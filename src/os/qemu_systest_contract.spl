"""
QEMU System Test Contract — Per-Architecture Descriptors and Classification.

**Feature IDs:** #QEMU-SYSTEST-MULTIARCH-AC1
**Category:** OS system test infrastructure

Provides hardcoded per-arch QEMU boot descriptors and a pure classifier
function for use by system specs. Does NOT call simpleos_platform_* or any
catalog-lane accessor (those crash in interpreter mode). All argv is hardcoded
from the lane reference data in src/os/port/_SimpleosMultiplatformBuild/platform_target_catalog.spl.

Serial logs are written to build/os/systest/<arch>.serial.log.
"""

use os.fs_exec_fallback_contract.{fs_exec_serial_has_fallback}
use os.simpleos_config_matrix.{
    qemu_riscv64_desktop_image_path,
    qemu_riscv64_desktop_kernel_path,
    qemu_riscv64_desktop_qemu_args,
    qemu_riscv64_desktop_qemu_args_status
}
use std.nogc_sync_mut.io.env_ops.{env_get}

extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_dir_create_all(path: text) -> bool

# ---------------------------------------------------------------------------
# Classification results (string constants)
# ---------------------------------------------------------------------------

pub val SYSTEST_PASS: text = "pass"
pub val SYSTEST_PREFIX_MISSING_MEDIA: text = "missing-media:"
pub val SYSTEST_PREFIX_BOOT_FAIL: text = "boot-fail:"
pub val SYSTEST_BOOT_FAIL_FALLBACK: text = "boot-fail:fallback"
pub val SYSTEST_BOOT_FAIL_NONCE_UNSUPPORTED: text = "boot-fail:nonce-unsupported"
pub val SYSTEST_BOOT_FAIL_ACCELERATOR_UNSUPPORTED: text = "boot-fail:accelerator-unsupported"

export SYSTEST_PASS, SYSTEST_PREFIX_MISSING_MEDIA, SYSTEST_PREFIX_BOOT_FAIL, SYSTEST_BOOT_FAIL_FALLBACK

pub fn qemu_args_with_accelerator(qemu_args: [text], accelerator: text) -> [text]:
    if accelerator != "kvm" and accelerator != "tcg":
        return []
    var result: [text] = []
    for arg in qemu_args:
        result.push(arg)
    result.push("-accel")
    result.push(accelerator)
    result

pub fn classify_serial_with_nonce(serial: text, markers: [text], nonce: text) -> text:
    if nonce.len() == 0 or not serial.contains(qemu_nonce_serial_marker(nonce)):
        return SYSTEST_BOOT_FAIL_NONCE_UNSUPPORTED
    classify_serial(serial, markers)

pub fn qemu_nonce_serial_marker(nonce: text) -> text:
    "SIMPLEOS_QEMU_NONCE=" + nonce

pub fn qemu_args_with_run_image(qemu_args: [text], source_image: text, run_image: text) -> [text]:
    if source_image.len() == 0 or run_image.len() == 0:
        return []
    var result: [text] = []
    var replacements = 0
    for arg in qemu_args:
        if arg.contains(source_image):
            result.push(arg.replace(source_image, run_image))
            replacements = replacements + 1
        else:
            result.push(arg)
    if replacements != 1:
        return []
    result

# ---------------------------------------------------------------------------
# Classifier — pure text-in, no I/O (testable without QEMU)
# ---------------------------------------------------------------------------

pub fn classify_serial(serial: text, markers: [text]) -> text:
    """Classify a completed QEMU serial log against required markers.

    Returns:
      'pass'                     — all markers present, no fallback pattern
      'boot-fail:fallback'       — fallback pattern detected in serial
      'boot-fail:<marker>'       — first missing marker
    """
    if fs_exec_serial_has_fallback(serial):
        return SYSTEST_BOOT_FAIL_FALLBACK
    val n = markers.len()
    val i = 0
    while i < n:
        val m = markers[i]
        if not serial.contains(m):
            return "boot-fail:" + m
        val i = i + 1
    SYSTEST_PASS

# ---------------------------------------------------------------------------
# Shared defaults
# ---------------------------------------------------------------------------

# Default QEMU boot timeout for the freestanding lanes (all 6 share 60s; the
# hosted darwin lane keeps its own shorter budget).
pub fn default_qemu_timeout_ms() -> i64:
    60000

# Standard SMF fs-exec acceptance markers shared verbatim by the lanes whose
# success path is load-proof + CLI/WM launch + native render (riscv32, arm32,
# x86_64). Lanes with extra/arch-specific proofs (riscv64 SMF_FS_PASS, arm64
# EL0 svc round-trip, x86_32 initrd payload, hosted darwin) keep their own sets.
pub fn standard_smf_markers() -> [text]:
    ["ELF_LOAD_OK",
     "SMF_CLI_LAUNCH_OK",
     "SMF_WM_GUI_LAUNCH_OK",
     "NATIVE_GUI_PROCESS_RENDER_OK",
     "TEST PASSED"]

