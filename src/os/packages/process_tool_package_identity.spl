use os.tools.shell.process.process_artifact_contract.{
    ProcessToolArtifactContractV1,
    process_tool_artifact_contract_v1,
    process_tool_artifact_contract_valid_v1
}

pub const PROCESS_TOOL_PACKAGE_IDENTITY_SCHEMA_V1: i64 = 1

pub struct ProcessToolPackageIdentityV1:
    schema_version: i64
    package_name: text
    artifact: ProcessToolArtifactContractV1
    artifact_digest: text
    admission_receipt_id: text
    blocker: text

pub fn process_tool_package_identity_v1(
    command: text
) -> Result<ProcessToolPackageIdentityV1, text>:
    val artifact = process_tool_artifact_contract_v1(command)
    match artifact:
        case Err(reason): Err(reason)
        case Ok(value): Ok(ProcessToolPackageIdentityV1(
            schema_version: PROCESS_TOOL_PACKAGE_IDENTITY_SCHEMA_V1,
            package_name: "simpleos-process-tools",
            artifact: value,
            artifact_digest: "",
            admission_receipt_id: "",
            blocker: "target-artifact-and-loader-token-unavailable"))

pub fn process_tool_package_identity(command: text) -> Result<ProcessToolPackageIdentityV1, text>:
    process_tool_package_identity_v1(command)

pub fn process_tool_package_identity_blocked_v1(
    identity: ProcessToolPackageIdentityV1
) -> bool:
    identity.schema_version == PROCESS_TOOL_PACKAGE_IDENTITY_SCHEMA_V1 and
        identity.package_name == "simpleos-process-tools" and
        process_tool_artifact_contract_valid_v1(identity.artifact) and
        identity.artifact_digest == "" and
        identity.admission_receipt_id == "" and
        identity.blocker == "target-artifact-and-loader-token-unavailable"
