# Package projection for filesystem-launched checksum tools.
#
# Artifact bytes and digests are intentionally absent until a target-native
# build is admitted. This projection cannot turn a source entrypoint into a
# package success claim.

use os.tools.shell.checksum.checksum_artifact_contract.{
    ChecksumToolArtifactContractV1, checksum_tool_artifact_contract_v1,
    checksum_tool_artifact_contract_valid_v1
}

pub const CHECKSUM_TOOL_PACKAGE_IDENTITY_SCHEMA_V1: i64 = 1

pub struct ChecksumToolPackageIdentityV1:
    schema_version: i64
    package_name: text
    artifact: ChecksumToolArtifactContractV1
    artifact_digest: text
    admission_receipt_id: text
    blocker: text

pub fn checksum_tool_package_identity_v1(
    command: text
) -> Result<ChecksumToolPackageIdentityV1, text>:
    val artifact = checksum_tool_artifact_contract_v1(command)
    match artifact:
        case Err(reason): Err(reason)
        case Ok(value):
            Ok(ChecksumToolPackageIdentityV1(
                schema_version: CHECKSUM_TOOL_PACKAGE_IDENTITY_SCHEMA_V1,
                package_name: "simpleos-checksum-tools",
                artifact: value,
                artifact_digest: "",
                admission_receipt_id: "",
                blocker: "target-artifact-and-loader-token-unavailable",
            ))

pub fn checksum_tool_package_identity_blocked_v1(
    identity: ChecksumToolPackageIdentityV1
) -> bool:
    identity.schema_version == CHECKSUM_TOOL_PACKAGE_IDENTITY_SCHEMA_V1 and
        identity.package_name == "simpleos-checksum-tools" and
        checksum_tool_artifact_contract_valid_v1(identity.artifact) and
        identity.artifact_digest == "" and
        identity.admission_receipt_id == "" and
        identity.blocker == "target-artifact-and-loader-token-unavailable"

