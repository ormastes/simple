# Closed host/guest evidence descriptor.  This is a contract model: the live
# runner must supply the actual QEMU/QMP/serial/SSH owners before promotion.

enum GuestEvidenceOperation:
    Version
    Compile
    Run
    PayloadList

struct SimpleOsQemuEvidenceDescriptor:
    isa: text
    accelerator: text
    base_image: text
    overlay_image: text
    firmware: text
    cloudinit: text
    ssh_port: i64
    ssh_user: text
    guest_program: text
    operation: GuestEvidenceOperation
    challenge: text
    serial_log: text
    ssh_log: text
    timeout_ms: i64
    contract_only: bool

pub fn simpleos_qemu_evidence_descriptor_valid(d: SimpleOsQemuEvidenceDescriptor) -> bool:
    (d.isa == "x86_32" or d.isa == "x86_64" or d.isa == "arm32" or d.isa == "arm64" or d.isa == "riscv32" or d.isa == "riscv64") and
    (d.accelerator == "kvm" or d.accelerator == "tcg") and
    d.base_image.len() > 0 and d.overlay_image.len() > 0 and d.firmware.len() > 0 and d.cloudinit.len() > 0 and
    d.ssh_port > 0 and d.ssh_port < 65536 and d.ssh_user.len() > 0 and
    d.guest_program.starts_with("/") and d.guest_program.contains("..") == false and
    d.challenge.len() >= 16 and d.serial_log.len() > 0 and d.ssh_log.len() > 0 and d.timeout_ms > 0

pub fn simpleos_qemu_evidence_contract_only(d: SimpleOsQemuEvidenceDescriptor) -> bool:
    d.contract_only and simpleos_qemu_evidence_descriptor_valid(d)
