"""Backend-neutral SimpleOS ProcessingIR device submission port."""

use common.gpu.simpleos_host_gpu_protocol.{
    SIMPLEOS_HOST_GPU_STATUS_FAIL,
    SIMPLEOS_HOST_GPU_REASON_INVALID_REQUEST
}
use os.lib.gpu_bridge.host_gpu_ivshmem.{
    HostGpuIvshmemReceipt,
    HostGpuIvshmemHelloReceipt
}

trait ProcessingDevicePort:
    fn backend_name() -> text
    fn backend_code() -> i64
    fn negotiated(hello: HostGpuIvshmemHelloReceipt) -> bool
    fn submit_fill_u32(generation: i64, run_id_hash: i64, frame_id: i64,
                       element_count: i64, value: u32) -> HostGpuIvshmemReceipt
    fn device_receipt_valid(receipt: HostGpuIvshmemReceipt,
                            generation: i64, run_id_hash: i64,
                            frame_id: i64, expected_bytes: i64) -> bool

fn processing_device_failure_receipt(generation: i64) -> HostGpuIvshmemReceipt:
    HostGpuIvshmemReceipt(
        completed: false,
        status: SIMPLEOS_HOST_GPU_STATUS_FAIL,
        reason: SIMPLEOS_HOST_GPU_REASON_INVALID_REQUEST,
        generation: generation,
        native_handle: 0,
        output_addr: 0u64,
        output_bytes: 0,
        output_checksum: 0,
        elapsed_us: 0,
        readback_source: 0,
        device_identity: 0,
        run_id_hash: 0,
        frame_id: 0,
        backend_code: 0)

export ProcessingDevicePort, processing_device_failure_receipt
