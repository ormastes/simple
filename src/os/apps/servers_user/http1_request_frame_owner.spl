# Incremental HTTP/1 request framing for the filesystem-launched server.
#
# Http1RequestFrameOwner is deliberately module-private.  The socket-facing
# API owns it for the whole connection, so no caller can forge scan offsets,
# line counters, or a cached Content-Length resume tuple.

use os.userlib.net.{Socket, socket_recv, socket_send_range}
use std.nogc_sync_mut.http_server.server.{SecureServerPolicy, secure_server_policy_error}
use std.nogc_sync_mut.http_server.parser.{parse_request_line}
use std.common.net.http_core.{body_decision}
use std.nogc_sync_mut.binary_io.{bytes_to_string}
use std.fs_driver.bytes_util.{text_to_bytes_pure}

pub class Http1OwnedFrameResult:
    complete: bool
    request: text
    websocket_upgrade_candidate: bool
    upgrade_tail: [u8]
    connection_tail: [u8]
    close_connection: bool
    error: text
    scanned_bytes: i64

fn _http_field_token_byte(byte: u8) -> bool:
    (byte >= 48u8 and byte <= 57u8) or
        (byte >= 65u8 and byte <= 90u8) or
        (byte >= 97u8 and byte <= 122u8) or
        byte == 33u8 or byte == 35u8 or byte == 36u8 or byte == 37u8 or
        byte == 38u8 or byte == 39u8 or byte == 42u8 or byte == 43u8 or
        byte == 45u8 or byte == 46u8 or byte == 94u8 or byte == 95u8 or
        byte == 96u8 or byte == 124u8 or byte == 126u8

fn _http_request_method_token_valid(line_bytes: [u8]) -> bool:
    # RFC 9110 method is a non-empty ASCII token. Validate the method directly
    # in the bounded request-line snapshot already owned by the framer, before
    # the text parser or route owner can observe it. This avoids allocating a
    # second method byte array on the connection hot path.
    var index: u64 = 0u64
    while index < line_bytes.len() and line_bytes[index] != 32u8:
        if not _http_field_token_byte(line_bytes[index]):
            return false
        index = index + 1u64
    index > 0u64 and index < line_bytes.len()

fn _http_field_name_is_host(line_bytes: [u8], colon: i64) -> bool:
    # Header names are already restricted to ASCII tchar bytes.  Compare the
    # four Host bytes directly so the incremental hot path does not allocate a
    # lowercase copy of every field name or rescan the retained header list.
    return (colon == 4 and
        (line_bytes[0u64] == 72u8 or line_bytes[0u64] == 104u8) and
        (line_bytes[1u64] == 79u8 or line_bytes[1u64] == 111u8) and
        (line_bytes[2u64] == 83u8 or line_bytes[2u64] == 115u8) and
        (line_bytes[3u64] == 84u8 or line_bytes[3u64] == 116u8))

fn _http_field_name_is_expect(line_bytes: [u8], colon: i64) -> bool:
    # The filesystem server has no interim-response transport. Recognize the
    # field without allocating a lowercase header-name copy, then fail before
    # the owner begins waiting for a declared body.
    return (colon == 6 and
        (line_bytes[0u64] == 69u8 or line_bytes[0u64] == 101u8) and
        (line_bytes[1u64] == 88u8 or line_bytes[1u64] == 120u8) and
        (line_bytes[2u64] == 80u8 or line_bytes[2u64] == 112u8) and
        (line_bytes[3u64] == 69u8 or line_bytes[3u64] == 101u8) and
        (line_bytes[4u64] == 67u8 or line_bytes[4u64] == 99u8) and
        (line_bytes[5u64] == 84u8 or line_bytes[5u64] == 116u8))

fn _http_field_value_bytes_valid(line_bytes: [u8], colon: i64) -> bool:
    # RFC 9110 field-content admits SP, HTAB, visible ASCII, and obs-text.
    # Reject every other control byte before converting/slicing the value so
    # NUL and delimiter-like controls cannot be interpreted differently by a
    # route, logger, proxy, or cache. Scan the owner's bounded line in place;
    # this adds no per-header allocation on the request hot path.
    var index = (colon + 1) as u64
    while index < line_bytes.len():
        val byte = line_bytes[index]
        if byte != 9u8 and byte != 32u8 and
            (byte < 33u8 or (byte > 126u8 and byte < 128u8)):
            return false
        index = index + 1u64
    true

fn _http_ascii_lower(byte: u8) -> u8:
    if byte >= 65u8 and byte <= 90u8: byte + 32u8 else: byte

fn _http_connection_token_kind(bytes: [u8], start: u64, end: u64) -> i32:
    val length = end - start
    if (length == 5u64 and
        _http_ascii_lower(bytes[start]) == 99u8 and
        _http_ascii_lower(bytes[start + 1u64]) == 108u8 and
        _http_ascii_lower(bytes[start + 2u64]) == 111u8 and
        _http_ascii_lower(bytes[start + 3u64]) == 115u8 and
        _http_ascii_lower(bytes[start + 4u64]) == 101u8):
        return 1
    if (length == 10u64 and
        _http_ascii_lower(bytes[start]) == 107u8 and
        _http_ascii_lower(bytes[start + 1u64]) == 101u8 and
        _http_ascii_lower(bytes[start + 2u64]) == 101u8 and
        _http_ascii_lower(bytes[start + 3u64]) == 112u8 and
        bytes[start + 4u64] == 45u8 and
        _http_ascii_lower(bytes[start + 5u64]) == 97u8 and
        _http_ascii_lower(bytes[start + 6u64]) == 108u8 and
        _http_ascii_lower(bytes[start + 7u64]) == 105u8 and
        _http_ascii_lower(bytes[start + 8u64]) == 118u8 and
        _http_ascii_lower(bytes[start + 9u64]) == 101u8):
        return 2
    if (length == 7u64 and
        _http_ascii_lower(bytes[start]) == 117u8 and
        _http_ascii_lower(bytes[start + 1u64]) == 112u8 and
        _http_ascii_lower(bytes[start + 2u64]) == 103u8 and
        _http_ascii_lower(bytes[start + 3u64]) == 114u8 and
        _http_ascii_lower(bytes[start + 4u64]) == 97u8 and
        _http_ascii_lower(bytes[start + 5u64]) == 100u8 and
        _http_ascii_lower(bytes[start + 6u64]) == 101u8):
        return 3
    0

fn _http_connection_options(value: text) -> (bool, bool, bool, bool):
    # RFC 9110 Connection is a comma list of field-name tokens. Parse it once
    # as ASCII bytes so lifecycle decisions never depend on split/lower
    # allocations or accept whitespace inside a token. Empty list members are
    # tolerated as required by the HTTP list extension. Since the `#element`
    # form permits an empty list, an OWS/comma-only value is valid and carries
    # no persistence option.
    val bytes = text_to_bytes_pure(value)
    var token_start: i64 = -1
    var after_token = false
    var close = false
    var keep_alive = false
    var upgrade = false
    var index: u64 = 0u64
    while index < bytes.len():
        val byte = bytes[index]
        if _http_field_token_byte(byte):
            if after_token:
                return (false, false, false, false)
            if token_start < 0:
                token_start = index.to_i64()
        elif byte == 32u8 or byte == 9u8:
            if token_start >= 0:
                val kind = _http_connection_token_kind(
                    bytes, token_start.to_u64(), index)
                close = close or kind == 1
                keep_alive = keep_alive or kind == 2
                upgrade = upgrade or kind == 3
                token_start = -1
                after_token = true
        elif byte == 44u8:
            if token_start >= 0:
                val kind = _http_connection_token_kind(
                    bytes, token_start.to_u64(), index)
                close = close or kind == 1
                keep_alive = keep_alive or kind == 2
                upgrade = upgrade or kind == 3
            token_start = -1
            after_token = false
        else:
            return (false, false, false, false)
        index = index + 1u64
    if token_start >= 0:
        val kind = _http_connection_token_kind(
            bytes, token_start.to_u64(), bytes.len())
        close = close or kind == 1
        keep_alive = keep_alive or kind == 2
        upgrade = upgrade or kind == 3
    (true, close, keep_alive, upgrade)

fn _http_upgrade_name_is_websocket(
    bytes: [u8], start: u64, end: u64
) -> bool:
    end - start == 9u64 and
        _http_ascii_lower(bytes[start]) == 119u8 and
        _http_ascii_lower(bytes[start + 1u64]) == 101u8 and
        _http_ascii_lower(bytes[start + 2u64]) == 98u8 and
        _http_ascii_lower(bytes[start + 3u64]) == 115u8 and
        _http_ascii_lower(bytes[start + 4u64]) == 111u8 and
        _http_ascii_lower(bytes[start + 5u64]) == 99u8 and
        _http_ascii_lower(bytes[start + 6u64]) == 107u8 and
        _http_ascii_lower(bytes[start + 7u64]) == 101u8 and
        _http_ascii_lower(bytes[start + 8u64]) == 116u8

fn _http_upgrade_options(value: text) -> (bool, bool):
    # RFC 9110 Upgrade is `#protocol`, where each protocol is a token with an
    # optional immediately-adjacent `/token` version. Validate the complete
    # field before it can influence the framing handoff. Empty comma members
    # are tolerated; the `#protocol` form also permits an empty list.
    val bytes = text_to_bytes_pure(value)
    var phase: i32 = 0  # 0=between, 1=name, 2=need-version, 3=version, 4=OWS
    var name_start: u64 = 0u64
    var name_end: u64 = 0u64
    var websocket = false
    var index: u64 = 0u64
    while index < bytes.len():
        val byte = bytes[index]
        if _http_field_token_byte(byte):
            if phase == 0:
                name_start = index
                phase = 1
            elif phase == 2:
                phase = 3
            elif phase == 4:
                return (false, false)
        elif byte == 47u8:
            if phase != 1:
                return (false, false)
            name_end = index
            phase = 2
        elif byte == 32u8 or byte == 9u8:
            if phase == 1:
                name_end = index
                websocket = websocket or
                    _http_upgrade_name_is_websocket(bytes, name_start, name_end)
                phase = 4
            elif phase == 3:
                phase = 4
            elif phase == 2:
                return (false, false)
        elif byte == 44u8:
            if phase == 1:
                name_end = index
                websocket = websocket or
                    _http_upgrade_name_is_websocket(bytes, name_start, name_end)
            elif phase == 2:
                return (false, false)
            phase = 0
        else:
            return (false, false)
        index = index + 1u64
    if phase == 1:
        websocket = websocket or
            _http_upgrade_name_is_websocket(bytes, name_start, bytes.len())
    elif phase == 2:
        return (false, false)
    (true, websocket)

fn _http_hex_byte(byte: u8) -> i64:
    if byte >= 48u8 and byte <= 57u8: return (byte - 48u8) as i64
    if byte >= 65u8 and byte <= 70u8: return (byte - 55u8) as i64
    if byte >= 97u8 and byte <= 102u8: return (byte - 87u8) as i64
    -1

fn _http_origin_form_literal_byte(byte: u8) -> bool:
    # RFC 3986 pchar plus '/' and '?' for origin-form path/query.
    (byte >= 48u8 and byte <= 57u8) or
        (byte >= 65u8 and byte <= 90u8) or
        (byte >= 97u8 and byte <= 122u8) or
        byte == 33u8 or byte == 36u8 or byte == 38u8 or byte == 39u8 or
        byte == 40u8 or byte == 41u8 or byte == 42u8 or byte == 43u8 or
        byte == 44u8 or byte == 45u8 or byte == 46u8 or byte == 47u8 or
        byte == 58u8 or byte == 59u8 or byte == 61u8 or byte == 64u8 or
        byte == 95u8 or byte == 126u8 or byte == 63u8

fn http1_origin_form_target_is_valid(method: text, target: text) -> bool:
    # This filesystem service deliberately routes only origin-form. RFC 9112's
    # valid OPTIONS asterisk-form, CONNECT authority-form, and proxy
    # absolute-form are rejected because the downstream route API accepts only
    # a path and has no authority or asterisk representation. Query syntax is
    # part of origin-form and is retained for the route/upgrade owner to
    # interpret; it must not be confused with the filesystem path component.
    # This validation creates one bounded byte snapshot; no decoded target or
    # second expanded buffer is created. The retained request is still
    # reparsed later by the existing route owner.
    val bytes = text_to_bytes_pure(target)
    if method == "CONNECT" or bytes.len() == 0u64 or bytes[0u64] != 47u8:
        return false
    var index: u64 = 0u64
    var in_query = false
    while index < bytes.len():
        val byte = bytes[index]
        if byte != 37u8 and not _http_origin_form_literal_byte(byte):
            return false
        if byte == 63u8:
            # The first '?' separates path from query. Subsequent '?' bytes
            # are valid query data under RFC 3986.
            in_query = true
        if byte == 37u8:
            if index + 2u64 >= bytes.len() or
                _http_hex_byte(bytes[index + 1u64]) < 0 or
                _http_hex_byte(bytes[index + 2u64]) < 0:
                return false
            val decoded = (_http_hex_byte(bytes[index + 1u64]) * 16 +
                _http_hex_byte(bytes[index + 2u64]))
            # Controls and backslash stay forbidden in either component. In
            # the path, encoded '/' or '?' could change component shape after
            # one decode; inside the query they are ordinary encoded data.
            if (decoded <= 31 or decoded == 127 or decoded == 92 or
                (not in_query and (decoded == 47 or decoded == 63))):
                return false
            index = index + 3u64
        else:
            index = index + 1u64
    true

val CHUNK_SIZE: i32 = 0
val CHUNK_SIZE_LF: i32 = 1
val CHUNK_DATA: i32 = 2
val CHUNK_DATA_CR: i32 = 3
val CHUNK_DATA_LF: i32 = 4
val CHUNK_TRAILER: i32 = 5
val CHUNK_TRAILER_LF: i32 = 6
val CHUNK_COMPLETE: i32 = 7

val CHUNK_EXT_NONE: i32 = 0
val CHUNK_EXT_NAME_START: i32 = 1
val CHUNK_EXT_NAME: i32 = 2
val CHUNK_EXT_VALUE_START: i32 = 3
val CHUNK_EXT_TOKEN_VALUE: i32 = 4
val CHUNK_EXT_QUOTED_VALUE: i32 = 5
val CHUNK_EXT_QUOTED_ESCAPE: i32 = 6
val CHUNK_EXT_VALUE_COMPLETE: i32 = 7

fn _host_ascii_alpha_numeric(ch: text) -> bool:
    (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
        (ch >= "0" and ch <= "9")

fn _host_decimal_digit(ch: text) -> i64:
    if ch == "0": return 0
    if ch == "1": return 1
    if ch == "2": return 2
    if ch == "3": return 3
    if ch == "4": return 4
    if ch == "5": return 5
    if ch == "6": return 6
    if ch == "7": return 7
    if ch == "8": return 8
    if ch == "9": return 9
    -1

fn _host_hex_digit(ch: text) -> bool:
    _host_decimal_digit(ch) >= 0 or
        (ch >= "a" and ch <= "f") or (ch >= "A" and ch <= "F")

fn _host_ipv4_tail_is_valid(authority: text, start: i64, end: i64) -> bool:
    var component_count: i32 = 0
    var index = start
    while index < end:
        val component_start = index
        var value: i64 = 0
        while index < end and authority.char_at(index) != ".":
            val digit = _host_decimal_digit(authority.char_at(index))
            if digit < 0 or index - component_start >= 3:
                return false
            value = value * 10 + digit
            if value > 255:
                return false
            index = index + 1
        if index == component_start:
            return false
        if index - component_start > 1 and authority.char_at(component_start) == "0":
            return false
        component_count = component_count + 1
        if index < end:
            index = index + 1
            if index == end:
                return false
    component_count == 4

fn _host_ipv6_is_valid(authority: text, start: i64, end: i64) -> bool:
    if start >= end:
        return false
    var index = start
    var group_count: i32 = 0
    var compressed = false
    if authority.char_at(index) == ":":
        if index + 1 >= end or authority.char_at(index + 1) != ":":
            return false
        compressed = true
        index = index + 2
        if index == end:
            return true
    while index < end:
        val group_start = index
        var has_dot = false
        while index < end and authority.char_at(index) != ":":
            if authority.char_at(index) == ".":
                has_dot = true
            index = index + 1
        if index == group_start:
            return false
        if has_dot:
            if index != end or not _host_ipv4_tail_is_valid(
                authority, group_start, end):
                return false
            group_count = group_count + 2
        else:
            val group_length = index - group_start
            if group_length > 4:
                return false
            var hex_index = group_start
            while hex_index < index:
                if not _host_hex_digit(authority.char_at(hex_index)):
                    return false
                hex_index = hex_index + 1
            group_count = group_count + 1
        if group_count > 8:
            return false
        if index < end:
            if index + 1 < end and authority.char_at(index + 1) == ":":
                if compressed:
                    return false
                compressed = true
                index = index + 2
                if index == end:
                    break
            else:
                index = index + 1
                if index == end:
                    return false
    if compressed:
        group_count < 8
    else:
        group_count == 8

fn _host_port_is_valid(authority: text, start: i64) -> bool:
    if start >= authority.len():
        return false
    var value: i64 = 0
    var index = start
    while index < authority.len():
        val ch = authority.char_at(index)
        val digit = _host_decimal_digit(ch)
        if digit < 0:
            return false
        value = value * 10 + digit
        if value > 65535:
            return false
        index = index + 1
    value > 0

fn _host_reg_name_is_valid(authority: text, end: i64) -> bool:
    if end < 1 or end > 253:
        return false
    var label_length: i64 = 0
    var label_ends_hyphen = false
    var index: i64 = 0
    while index < end:
        val ch = authority.char_at(index)
        if ch == ".":
            if label_length == 0 or label_ends_hyphen:
                return false
            label_length = 0
            label_ends_hyphen = false
        else:
            if not _host_ascii_alpha_numeric(ch) and ch != "-":
                return false
            if label_length == 0 and ch == "-":
                return false
            label_length = label_length + 1
            if label_length > 63:
                return false
            label_ends_hyphen = ch == "-"
        index = index + 1
    label_length > 0 and not label_ends_hyphen

fn http1_host_authority_is_valid(authority: text) -> bool:
    # Filesystem service deployment profile: bounded ASCII DNS/IPv4 reg-name
    # or bracketed IPv6 literal, with an optional nonzero TCP port. Reject URI
    # userinfo, path/query/fragment material, ambiguous unbracketed IPv6, and
    # Unicode before any route owner can interpret the authority differently.
    if authority.len() < 1 or authority.len() > 261:
        return false
    if authority.starts_with("["):
        val close = authority.index_of("]")
        if close <= 1:
            return false
        if not _host_ipv6_is_valid(authority, 1, close):
            return false
        if close + 1 == authority.len():
            return true
        return (authority.char_at(close + 1) == ":" and
            _host_port_is_valid(authority, close + 2))

    var colon: i64 = -1
    var index: i64 = 0
    while index < authority.len():
        if authority.char_at(index) == ":":
            if colon >= 0:
                return false
            colon = index
        index = index + 1
    val host_end = if colon < 0: authority.len() else: colon
    if not _host_reg_name_is_valid(authority, host_end):
        return false
    colon < 0 or _host_port_is_valid(authority, colon + 1)

pub(package) class Http1RequestFrameOwner:
    policy: SecureServerPolicy
    retained: [u8]
    line_start: i64
    request_line_seen: bool
    request_method: text
    request_version: text
    host_seen: bool
    host_nonempty: bool
    header_count: i32
    headers: [(text, text)]
    pending_cr: bool
    headers_complete: bool
    expected_total: i64
    terminal_error: text
    scanned_bytes: i64
    maximum_retained: i64
    websocket_upgrade_candidate: bool
    upgrade_tail: [u8]
    body_start: i64
    chunked: bool
    transfer_encoding_seen: bool
    expect_seen: bool
    expect_continue: bool
    connection_close: bool
    connection_keep_alive: bool
    connection_upgrade: bool
    chunk_phase: i32
    chunk_cursor: i64
    chunk_line_start: i64
    chunk_line_length: i64
    chunk_size_value: i64
    chunk_size_digits: i32
    chunk_extension: bool
    chunk_extension_phase: i32
    chunk_remaining: i64
    chunk_decoded: i64
    chunk_trailer_count: i32

    pub(package) static fn create(policy: SecureServerPolicy) -> Http1RequestFrameOwner:
        Http1RequestFrameOwner(
            policy: policy,
            retained: [],
            line_start: 0,
            request_line_seen: false,
            request_method: "",
            request_version: "",
            host_seen: false,
            host_nonempty: false,
            header_count: 0,
            headers: [],
            pending_cr: false,
            headers_complete: false,
            expected_total: -1,
            terminal_error: "",
            scanned_bytes: 0,
            maximum_retained: policy.max_request_line as i64 + 2 +
                policy.max_header_count as i64 *
                    (policy.max_header_line as i64 + 2) + 2 +
                # One-byte chunks can carry five framing bytes (`1\r\nX\r\n`)
                # per decoded byte. Keep the encoded cap finite while allowing
                # every body admitted by the decoded-size policy.
                policy.max_body as i64 * 6 + 5,
            websocket_upgrade_candidate: false,
            upgrade_tail: [],
            body_start: -1,
            chunked: false,
            transfer_encoding_seen: false,
            expect_seen: false,
            expect_continue: false,
            connection_close: false,
            connection_keep_alive: false,
            connection_upgrade: false,
            chunk_phase: CHUNK_SIZE,
            chunk_cursor: -1,
            chunk_line_start: -1,
            chunk_line_length: 0,
            chunk_size_value: 0,
            chunk_size_digits: 0,
            chunk_extension: false,
            chunk_extension_phase: CHUNK_EXT_NONE,
            chunk_remaining: 0,
            chunk_decoded: 0,
            chunk_trailer_count: 0
        )

    pub(package) fn terminal() -> bool:
        self.terminal_error != "" or
            (self.expected_total >= 0 and self.retained.len() as i64 >= self.expected_total)

    fn complete() -> bool:
        self.terminal_error == "" and self.expected_total >= 0 and
            self.retained.len() as i64 == self.expected_total

    me _fail(message: text):
        if self.terminal_error == "":
            self.terminal_error = message

    me _finish_line(line_end: i64):
        val line_bytes = self.retained.slice(self.line_start as u64, line_end as u64)
        if not self.request_line_seen:
            if line_bytes.len() == 0u64:
                self._fail("400 Empty request line")
                return
            if not _http_request_method_token_valid(line_bytes):
                self._fail("400 Invalid HTTP method token")
                return
            val line = bytes_to_string(line_bytes)
            val parsed = parse_request_line(line)
            if parsed.0 == "" or parsed.1 == "" or parsed.2 == "":
                self._fail("400 Malformed request line")
                return
            if parsed.2 != "HTTP/1.1" and parsed.2 != "HTTP/1.0":
                self._fail("400 Unsupported HTTP version")
                return
            if not http1_origin_form_target_is_valid(parsed.0, parsed.1):
                self._fail("400 Invalid origin-form request target")
                return
            self.request_method = parsed.0
            self.request_version = parsed.2
            self.request_line_seen = true
            return

        if line_bytes.len() == 0u64:
            # Upgrade alone is not a WebSocket handoff. RFC 6455 requires GET
            # over HTTP/1.1 and RFC 9110 requires the matching Connection
            # option so intermediaries know both fields are hop-by-hop.
            self.websocket_upgrade_candidate =
                self.websocket_upgrade_candidate and
                self.connection_upgrade and
                self.request_method == "GET" and
                self.request_version == "HTTP/1.1"
            val decision = body_decision(self.headers, self.policy.max_body, true)
            if decision.0 != "":
                self._fail(decision.0)
                return
            if self.request_version == "HTTP/1.1" and
                (not self.host_seen or not self.host_nonempty):
                # The filesystem server's deployment policy rejects an empty
                # Host even though RFC 9112 permits it when target authority
                # is undefined. Host grammar and configured-authority binding
                # are separate policy work and are not inferred here.
                self._fail("400 HTTP/1.1 requires one non-empty Host header")
                return
            if self.request_version == "HTTP/1.0" and decision.2:
                self._fail("400 HTTP/1.0 does not support chunked request bodies")
                return
            if self.websocket_upgrade_candidate and
                (decision.1 > 0 or decision.2):
                self._fail("400 WebSocket upgrade request must not carry a body")
                return
            self.headers_complete = true
            self.body_start = self.retained.len() as i64
            self.chunked = decision.2
            self.chunk_cursor = self.body_start
            self.chunk_line_start = self.body_start
            # A WebSocket candidate has no HTTP request body. Any bytes after
            # the header are owned frame tail and are validated only after the
            # complete handshake is accepted.
            self.expected_total = if self.websocket_upgrade_candidate:
                self.retained.len() as i64
            elif self.chunked:
                -1
            else:
                self.retained.len() as i64 + decision.1 as i64
            if self.expected_total > self.maximum_retained:
                self._fail("413 Request exceeds retained-byte policy")
            return

        self.header_count = self.header_count + 1
        if self.header_count > self.policy.max_header_count:
            self._fail("431 Too many headers")
            return
        if line_bytes[0u64] == 32u8 or line_bytes[0u64] == 9u8:
            self._fail("400 Obsolete folded header is not supported")
            return
        var colon: i64 = -1
        var name_index: i64 = 0
        while name_index < line_bytes.len() as i64 and colon < 0:
            val byte = line_bytes[name_index as u64]
            if byte == 58u8:
                colon = name_index
            elif not _http_field_token_byte(byte):
                self._fail("400 Invalid header field name")
                return
            name_index = name_index + 1
        if colon <= 0:
            self._fail("400 Malformed header line")
            return
        if not _http_field_value_bytes_valid(line_bytes, colon):
            self._fail("400 Invalid header field value")
            return
        val line = bytes_to_string(line_bytes)
        val name = line.slice(0, colon)
        val value = line.slice(colon + 1, line.len()).trim()
        if _http_field_name_is_expect(line_bytes, colon):
            if self.expect_seen or self.request_version != "HTTP/1.1" or
                value.lower() != "100-continue":
                self._fail("417 Expectation Failed")
                return
            self.expect_seen = true
            self.expect_continue = true
        if _http_field_name_is_host(line_bytes, colon):
            # RFC 9112 permits exactly one Host field in an HTTP/1.1 request.
            # Reject duplicates even when their values agree: intermediaries
            # can select different occurrences, turning an otherwise valid
            # authority into a routing/cache-poisoning ambiguity.
            if self.host_seen:
                self._fail("400 Duplicate Host header")
                return
            if not http1_host_authority_is_valid(value):
                self._fail("400 Invalid Host authority")
                return
            self.host_seen = true
            self.host_nonempty = value != ""
        if name.lower() == "upgrade":
            val upgrades = _http_upgrade_options(value)
            if not upgrades.0:
                self._fail("400 Invalid Upgrade protocol list")
                return
            self.websocket_upgrade_candidate =
                self.websocket_upgrade_candidate or upgrades.1
        if name.lower() == "transfer-encoding":
            # This transport implements exactly the RFC 9112 chunked coding.
            # Reject stacked/unknown codings instead of letting different
            # downstream owners disagree about the message boundary.
            if self.transfer_encoding_seen or value.lower().trim() != "chunked":
                self._fail("501 Transfer-Encoding is not supported")
                return
            self.transfer_encoding_seen = true
        if name.lower() == "connection":
            val options = _http_connection_options(value)
            if not options.0:
                self._fail("400 Invalid Connection token list")
                return
            self.connection_close = self.connection_close or options.1
            self.connection_keep_alive = self.connection_keep_alive or options.2
            self.connection_upgrade = self.connection_upgrade or options.3
        self.headers.push((name, value))

    me _validate_chunk_trailer(line_start: i64, line_end: i64) -> bool:
        val line_bytes = self.retained.slice(line_start as u64, line_end as u64)
        val line = bytes_to_string(line_bytes)
        if line.starts_with(" ") or line.starts_with("\t"):
            return false
        val colon = line.index_of(":")
        if colon <= 0:
            return false
        var index: i64 = 0
        while index < colon:
            if not _http_field_token_byte(line_bytes[index as u64]):
                return false
            index = index + 1
        val name = line.slice(0, colon).lower()
        # RFC 9110 forbids trailer fields that affect framing, routing,
        # authentication, request processing, response control, or payload
        # interpretation.  The route owner has already made all of those
        # decisions before trailers arrive, so accepting one here would let a
        # downstream intermediary observe authority that this server ignored.
        # Keep this fail-closed list local to the framing owner: it scans each
        # trailer once and retains no second metadata collection.
        not (name == "content-length" or name == "transfer-encoding" or
            name == "host" or name == "connection" or name == "upgrade" or
            name == "te" or name == "trailer" or
            name == "authorization" or name == "proxy-authorization" or
            name == "proxy-authenticate" or name == "www-authenticate" or
            name == "cookie" or name == "set-cookie" or
            name == "cache-control" or name == "max-forwards" or
            name == "expect" or name == "range" or
            name == "content-encoding" or name == "content-type" or
            name == "content-range")

    me _accept_chunk_extension_byte(byte: u8) -> bool:
        # RFC 9112 chunk extensions use `;token[=token-or-quoted-string]`.
        # Validate in the existing byte scan so malformed extension syntax
        # cannot produce a message boundary that differs from an intermediary,
        # without retaining extension metadata or allocating token strings.
        if self.chunk_extension_phase == CHUNK_EXT_NAME_START:
            if not _http_field_token_byte(byte):
                return false
            self.chunk_extension_phase = CHUNK_EXT_NAME
            return true
        if self.chunk_extension_phase == CHUNK_EXT_NAME:
            if byte == 61u8:
                self.chunk_extension_phase = CHUNK_EXT_VALUE_START
                return true
            if byte == 59u8:
                self.chunk_extension_phase = CHUNK_EXT_NAME_START
                return true
            return _http_field_token_byte(byte)
        if self.chunk_extension_phase == CHUNK_EXT_VALUE_START:
            if byte == 34u8:
                self.chunk_extension_phase = CHUNK_EXT_QUOTED_VALUE
                return true
            if not _http_field_token_byte(byte):
                return false
            self.chunk_extension_phase = CHUNK_EXT_TOKEN_VALUE
            return true
        if self.chunk_extension_phase == CHUNK_EXT_TOKEN_VALUE:
            if byte == 59u8:
                self.chunk_extension_phase = CHUNK_EXT_NAME_START
                return true
            return _http_field_token_byte(byte)
        if self.chunk_extension_phase == CHUNK_EXT_QUOTED_VALUE:
            if byte == 34u8:
                self.chunk_extension_phase = CHUNK_EXT_VALUE_COMPLETE
                return true
            if byte == 92u8:
                self.chunk_extension_phase = CHUNK_EXT_QUOTED_ESCAPE
                return true
            return byte == 9u8 or byte == 32u8 or
                (byte >= 33u8 and byte != 127u8)
        if self.chunk_extension_phase == CHUNK_EXT_QUOTED_ESCAPE:
            if not (byte == 9u8 or byte == 32u8 or
                (byte >= 33u8 and byte != 127u8)):
                return false
            self.chunk_extension_phase = CHUNK_EXT_QUOTED_VALUE
            return true
        if self.chunk_extension_phase == CHUNK_EXT_VALUE_COMPLETE:
            if byte != 59u8:
                return false
            self.chunk_extension_phase = CHUNK_EXT_NAME_START
            return true
        false

    fn _chunk_extension_complete() -> bool:
        self.chunk_extension_phase == CHUNK_EXT_NONE or
            self.chunk_extension_phase == CHUNK_EXT_NAME or
            self.chunk_extension_phase == CHUNK_EXT_TOKEN_VALUE or
            self.chunk_extension_phase == CHUNK_EXT_VALUE_COMPLETE

    me _scan_chunked_body():
        while (self.terminal_error == "" and
            self.chunk_phase != CHUNK_COMPLETE and
            self.chunk_cursor < self.retained.len() as i64):
            if self.chunk_phase == CHUNK_DATA:
                val available = self.retained.len() as i64 - self.chunk_cursor
                val take = if available < self.chunk_remaining:
                    available
                else:
                    self.chunk_remaining
                self.chunk_cursor = self.chunk_cursor + take
                self.chunk_remaining = self.chunk_remaining - take
                self.chunk_decoded = self.chunk_decoded + take
                if self.chunk_decoded > self.policy.max_body as i64:
                    self._fail("413 Chunked body exceeds decoded-size policy")
                elif self.chunk_remaining == 0:
                    self.chunk_phase = CHUNK_DATA_CR
                continue

            val byte = self.retained[self.chunk_cursor as u64]
            self.chunk_cursor = self.chunk_cursor + 1
            if self.chunk_phase == CHUNK_SIZE:
                self.chunk_line_length = self.chunk_line_length + 1
                if self.chunk_line_length > self.policy.max_header_line as i64:
                    self._fail("431 Chunk-size line exceeds policy")
                elif byte == 13u8:
                    if self.chunk_size_digits == 0 or
                        not self._chunk_extension_complete():
                        self._fail("400 Malformed chunk size")
                    else:
                        self.chunk_phase = CHUNK_SIZE_LF
                elif byte == 10u8 or byte < 32u8 or byte == 127u8:
                    self._fail("400 Malformed chunk-size line")
                elif byte == 59u8:
                    if not self.chunk_extension:
                        self.chunk_extension = true
                        self.chunk_extension_phase = CHUNK_EXT_NAME_START
                    elif not self._accept_chunk_extension_byte(byte):
                        self._fail("400 Malformed chunk extension")
                elif not self.chunk_extension:
                    val digit = _http_hex_byte(byte)
                    if digit < 0:
                        self._fail("400 Malformed chunk size")
                    elif self.chunk_size_value > 134217727 / 16:
                        self._fail("413 Chunk size exceeds policy")
                    else:
                        self.chunk_size_value = self.chunk_size_value * 16 + digit
                        self.chunk_size_digits = self.chunk_size_digits + 1
                elif not self._accept_chunk_extension_byte(byte):
                    self._fail("400 Malformed chunk extension")
            elif self.chunk_phase == CHUNK_SIZE_LF:
                if byte != 10u8:
                    self._fail("400 Malformed chunk-size terminator")
                elif self.chunk_size_value == 0:
                    self.chunk_phase = CHUNK_TRAILER
                    self.chunk_line_start = self.chunk_cursor
                    self.chunk_line_length = 0
                else:
                    if self.chunk_decoded + self.chunk_size_value >
                        self.policy.max_body as i64:
                        self._fail("413 Chunked body exceeds decoded-size policy")
                    else:
                        self.chunk_remaining = self.chunk_size_value
                        self.chunk_phase = CHUNK_DATA
                self.chunk_size_value = 0
                self.chunk_size_digits = 0
                self.chunk_extension = false
                self.chunk_extension_phase = CHUNK_EXT_NONE
                self.chunk_line_length = 0
            elif self.chunk_phase == CHUNK_DATA_CR:
                if byte != 13u8:
                    self._fail("400 Malformed chunk data terminator")
                else:
                    self.chunk_phase = CHUNK_DATA_LF
            elif self.chunk_phase == CHUNK_DATA_LF:
                if byte != 10u8:
                    self._fail("400 Malformed chunk data terminator")
                else:
                    self.chunk_phase = CHUNK_SIZE
                    self.chunk_line_start = self.chunk_cursor
            elif self.chunk_phase == CHUNK_TRAILER:
                if byte == 13u8:
                    self.chunk_phase = CHUNK_TRAILER_LF
                elif byte == 10u8 or (byte < 32u8 and byte != 9u8) or byte == 127u8:
                    self._fail("400 Malformed chunk trailer")
                else:
                    self.chunk_line_length = self.chunk_line_length + 1
                    if self.chunk_line_length > self.policy.max_header_line as i64:
                        self._fail("431 Chunk trailer line exceeds policy")
            elif self.chunk_phase == CHUNK_TRAILER_LF:
                if byte != 10u8:
                    self._fail("400 Malformed chunk trailer terminator")
                elif self.chunk_line_length == 0:
                    self.chunk_phase = CHUNK_COMPLETE
                    self.expected_total = self.chunk_cursor
                else:
                    if not self._validate_chunk_trailer(
                        self.chunk_line_start, self.chunk_cursor - 2):
                        self._fail("400 Invalid chunk trailer field")
                    else:
                        # The configured field-count bound applies to the
                        # complete request, not independently to the header
                        # and trailer sections.  Separate allowances let a
                        # chunked request nearly double the parser's bounded
                        # field-processing work and retained metadata budget.
                        # Compare before incrementing so the subtraction stays
                        # within the validated positive policy range.
                        if self.chunk_trailer_count >=
                            self.policy.max_header_count - self.header_count:
                            self._fail("431 Too many chunk trailer fields")
                        else:
                            self.chunk_trailer_count = self.chunk_trailer_count + 1
                            self.chunk_phase = CHUNK_TRAILER
                            self.chunk_line_start = self.chunk_cursor
                            self.chunk_line_length = 0

    pub(package) me append(fragment: [u8]):
        if self.terminal():
            self._fail("400 Data supplied after terminal request frame")
            return
        var index: u64 = 0
        while index < fragment.len():
            if self.headers_complete:
                val remaining = fragment.len() - index
                if self.websocket_upgrade_candidate:
                    # socket_recv is capped at 8192 bytes. Preserve only the
                    # read-ahead from the exact fragment that completed the
                    # header; later reads belong to the RFC6455 owner.
                    if self.upgrade_tail.len() + remaining > 8192u64:
                        self._fail("413 WebSocket upgrade tail exceeds read quantum")
                        return
                    self.upgrade_tail.extend(fragment.slice(index, fragment.len()))
                    self.scanned_bytes = self.scanned_bytes + remaining as i64
                    return
                val incoming = if index == 0u64:
                    fragment
                else:
                    fragment.slice(index, fragment.len())
                if self.chunked:
                    # One recv quantum may contain the terminal chunk plus the
                    # next pipelined request. Permit that transient read-ahead,
                    # split it at the canonical boundary, then apply the cap to
                    # this request alone.
                    if self.retained.len() as i64 + remaining as i64 >
                        self.maximum_retained + 8192:
                        self._fail("413 Request exceeds retained-byte policy")
                        return
                    self.retained.extend(incoming)
                    self.scanned_bytes = self.scanned_bytes + remaining as i64
                    self._scan_chunked_body()
                    if self.terminal_error != "":
                        return
                    if self.chunk_phase != CHUNK_COMPLETE and
                        self.retained.len() as i64 >
                        self.maximum_retained:
                        self._fail("413 Request exceeds retained-byte policy")
                        return
                    if self.chunk_phase == CHUNK_COMPLETE:
                        if self.expected_total > self.maximum_retained:
                            self._fail("413 Request exceeds retained-byte policy")
                            return
                        if self.retained.len() as i64 > self.expected_total:
                            self.upgrade_tail = self.retained.slice(
                                self.expected_total as u64, self.retained.len())
                            self.retained = self.retained.slice(0u64, self.expected_total as u64)
                    return
                val allowed = self.expected_total - self.retained.len() as i64
                val accepted = if remaining as i64 < allowed:
                    remaining
                else:
                    allowed as u64
                if accepted > 0u64:
                    self.retained.extend(incoming.slice(0u64, accepted))
                if remaining > accepted:
                    self.upgrade_tail = incoming.slice(accepted, incoming.len())
                self.scanned_bytes = self.scanned_bytes + remaining as i64
                return
            if self.retained.len() as i64 >= self.maximum_retained:
                self._fail("413 Request exceeds retained-byte policy")
                return
            val byte = fragment[index]
            self.retained.push(byte)
            self.scanned_bytes = self.scanned_bytes + 1

            if self.pending_cr:
                if byte != 10u8:
                    self._fail("400 Embedded CR in HTTP header section")
                    return
                self.pending_cr = false
                val line_end = self.retained.len() as i64 - 2
                self._finish_line(line_end)
                self.line_start = self.retained.len() as i64
                if self.terminal_error != "":
                    return
            elif byte == 13u8:
                self.pending_cr = true
            elif byte == 10u8:
                self._fail("400 Bare LF in HTTP header section")
                return
            elif (byte < 32u8 and byte != 9u8) or byte == 127u8:
                self._fail("400 Control byte in HTTP header section")
                return
            else:
                val line_bytes = self.retained.len() as i64 - self.line_start
                val line_limit = if self.request_line_seen:
                    self.policy.max_header_line as i64
                else:
                    self.policy.max_request_line as i64
                if line_bytes > line_limit:
                    self._fail("431 HTTP line exceeds policy")
                    return
            index = index + 1

    pub(package) fn result() -> Http1OwnedFrameResult:
        if self.complete():
            return Http1OwnedFrameResult(
                complete: true,
                request: bytes_to_string(self.retained),
                websocket_upgrade_candidate: self.websocket_upgrade_candidate,
                upgrade_tail: self.upgrade_tail,
                connection_tail: self.upgrade_tail,
                close_connection: self.connection_close or
                    (self.request_version == "HTTP/1.0" and not self.connection_keep_alive),
                error: "",
                scanned_bytes: self.scanned_bytes
            )
        val message = if self.terminal_error == "":
            "400 Incomplete HTTP request"
        else:
            self.terminal_error
        Http1OwnedFrameResult(
            complete: false,
            request: "",
            websocket_upgrade_candidate: false,
            upgrade_tail: [],
            connection_tail: [],
            close_connection: true,
            error: message,
            scanned_bytes: self.scanned_bytes
        )

class Http1ReceiveProgressOwner:
    limit: i32
    consecutive_no_progress: i32

    static fn create(limit: i32) -> Http1ReceiveProgressOwner:
        Http1ReceiveProgressOwner(
            limit: limit,
            consecutive_no_progress: 0
        )

    me observe(made_progress: bool) -> bool:
        if made_progress:
            self.consecutive_no_progress = 0
            return false
        self.consecutive_no_progress = self.consecutive_no_progress + 1
        self.consecutive_no_progress >= self.limit

fn _invalid_policy_result(message: text) -> Http1OwnedFrameResult:
    Http1OwnedFrameResult(
        complete: false,
        request: "",
        websocket_upgrade_candidate: false,
        upgrade_tail: [],
        connection_tail: [],
        close_connection: true,
        error: "400 Invalid HTTP framing policy: {message}",
        scanned_bytes: 0
    )

fn _send_http1_continue(socket: Socket) -> bool:
    val wire = text_to_bytes_pure("HTTP/1.1 100 Continue\r\n\r\n")
    var sent: u64 = 0u64
    var attempts: i32 = 0
    while sent < wire.len().to_u64() and attempts < 16:
        match socket_send_range(socket, wire, sent, 4096u64):
            case Err(_): return false
            case Ok(progress):
                if progress.0 == 0u64:
                    attempts = attempts + 1
                else:
                    sent = sent + progress.0
    sent == wire.len().to_u64()

# Production entry point.  No resumable state crosses this boundary.
fn recv_http1_request_owned(
    socket: Socket, policy: SecureServerPolicy
) -> Http1OwnedFrameResult:
    recv_http1_request_owned_with_tail(socket, policy, [])

fn recv_http1_request_owned_with_tail(
    socket: Socket, policy: SecureServerPolicy, initial: [u8]
) -> Http1OwnedFrameResult:
    val policy_error = secure_server_policy_error(policy)
    if policy_error != "":
        return _invalid_policy_result(policy_error)
    var owner = Http1RequestFrameOwner.create(policy)
    var progress = Http1ReceiveProgressOwner.create(policy.max_read_iters)
    var continue_sent = false
    if initial.len() > 0u64:
        owner.append(initial)
    while not owner.terminal():
        if (owner.headers_complete and owner.expect_continue and
            not continue_sent):
            if not _send_http1_continue(socket):
                owner._fail("transport: failed to send 100 Continue")
                break
            continue_sent = true
        match socket_recv(socket, 8192u64):
            Ok(fragment):
                if fragment.len() == 0u64:
                    # The socket adapter returns Ok([]) only for recv()==0:
                    # the peer performed an orderly shutdown. Retrying cannot
                    # make progress and would hold a dead connection until the
                    # read-iteration policy expires.
                    owner._fail("transport: peer closed before request completed")
                else:
                    val _ = progress.observe(true)
                    owner.append(fragment)
            Err(_):
                if progress.observe(false):
                    owner._fail("408 Consecutive no-progress receive limit exceeded")
    owner.result()

# Pure batch seam for correctness tests.  It owns the scanner from creation to
# terminal result and deliberately exposes no constructor or resume material.
fn frame_http1_fragments_owned_for_test(
    fragments: [[u8]], policy: SecureServerPolicy
) -> Http1OwnedFrameResult:
    val policy_error = secure_server_policy_error(policy)
    if policy_error != "":
        return _invalid_policy_result(policy_error)
    var owner = Http1RequestFrameOwner.create(policy)
    for fragment in fragments:
        if owner.terminal():
            owner._fail("400 Data supplied after terminal request frame")
            break
        owner.append(fragment)
    owner.result()

fn http1_no_progress_terminal_index_for_test(
    made_progress_events: [bool], limit: i32
) -> i64:
    if limit <= 0:
        return 0
    var owner = Http1ReceiveProgressOwner.create(limit)
    var index: i64 = 0
    for made_progress in made_progress_events:
        if owner.observe(made_progress):
            return index
        index = index + 1
    -1

export Http1OwnedFrameResult
export Http1RequestFrameOwner
export recv_http1_request_owned, recv_http1_request_owned_with_tail
export frame_http1_fragments_owned_for_test
export http1_no_progress_terminal_index_for_test
export http1_host_authority_is_valid
export http1_origin_form_target_is_valid
