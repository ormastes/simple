# Filesystem-launched SimpleOS server process.
#
# Transport is the thin user-syscall adapter. HTTP classification, response
# framing/security headers, database authentication/capability checks,
# transaction semantics, bounded responses, commit identity, and durability
# are all delegated to their canonical Pure-Simple owners.

use os.userlib.net.{IpAddr, SockAddr, Socket, socket, bind, listen, accept, socket_recv, socket_send_range}
use os.userlib.fs.{read_file_bytes_direct, read_file_bytes_direct_owned}
use os.userlib.syscall_raw.{syscall}
use os.kernel.net.http_route.{http_classify_request, HttpRouteKind}
use std.nogc_sync_mut.http_server.types.{HttpResponse, HttpStatus}
use std.nogc_sync_mut.http_server.response.{
    serialize_response, serialize_response_head_for_body_length,
    bounded_response_wire,
    response_wire_parts_fit, with_default_security_headers
}
use std.nogc_sync_mut.http_server.mime.{mime_from_path}
use std.nogc_sync_mut.http_server.server.{
    SecureServerPolicy, plaintext_development_capability,
    request_parse_error_status
}
use os.apps.dbd.dbd.{DbdServer}
use std.fs_driver.bytes_util.{text_to_bytes_pure}
use std.common.crypto.secure_memory.{SecureZeroReport, secure_zero_u8_slots}
use os.apps.servers_user.database_persistence_adapter.{
    simpleos_database_dbfs_vfs_caps
}
use os.apps.servers_user.http1_request_frame_owner.{recv_http1_request_owned}
use os.apps.servers_user.rfc6455_server_owner.{
    Rfc6455ServerConnectionOwner, Rfc6455ServerEvent,
    validate_rfc6455_server_handshake
}
use os.kernel.loader.server_launch_grants.{
    SIMPLEOS_SERVER_EXECUTABLE_V1,
    SIMPLEOS_SERVER_DB_KEY_V1,
    SIMPLEOS_SERVER_DB_CERTIFICATE_V1,
    SIMPLEOS_SERVER_DB_PRIVATE_KEY_V1,
    SIMPLEOS_SERVER_HTTP_PORT_V1,
    SIMPLEOS_SERVER_DATABASE_PORT_V1,
    simpleos_server_public_file_path_v1
}

val HTTP_PORT: u16 = SIMPLEOS_SERVER_HTTP_PORT_V1
val DB_PORT: u16 = SIMPLEOS_SERVER_DATABASE_PORT_V1
val MAX_IDLE_POLLS: i64 = 10000000
val DB_CREDENTIAL_PATH: text = SIMPLEOS_SERVER_DB_KEY_V1
val DB_CERTIFICATE_PATH: text = SIMPLEOS_SERVER_DB_CERTIFICATE_V1
val DB_PRIVATE_KEY_PATH: text = SIMPLEOS_SERVER_DB_PRIVATE_KEY_V1
val MAX_DB_CREDENTIAL_BYTES: u64 = 128u64
val MAX_WIRE_RESPONSE: u64 = 65536
val MAX_WEBSOCKET_READS: i32 = 200

fn debug_line(message: text):
    val bytes = text_to_bytes_pure(message + "\n")
    for byte in bytes:
        val _ = syscall(60, byte as u64, 0, 0, 0, 0)

fn close_fd(fd: i32):
    val _ = syscall(33, fd as u64, 0, 0, 0, 0)

fn http_listener_requires_partial_startup_close(
    http_listener_ready: bool, db_listener_fd: i64
) -> bool:
    http_listener_ready and db_listener_fd < 0

fn listener_requires_setup_failure_close(
    socket_created: bool, bind_ready: bool, listen_ready: bool
) -> bool:
    socket_created and (not bind_ready or not listen_ready)

fn send_all(sock: Socket, bytes: [u8]) -> bool:
    var sent: u64 = 0
    var attempts: i32 = 0
    var send_window: u64 = 4096u64
    while sent < bytes.len() as u64 and attempts < 64:
        match socket_send_range(sock, bytes, sent, send_window):
            Ok(progress):
                val count = progress.0
                val staged = progress.1
                if count == 0:
                    attempts = attempts + 1
                else:
                    sent = sent + count
                    if count < staged:
                        send_window = count
                    elif send_window < 4096u64:
                        val doubled = send_window * 2u64
                        send_window = if doubled < 4096u64: doubled else: 4096u64
            Err(_):
                attempts = attempts + 1
    sent == bytes.len() as u64

class HttpWireParts:
    head: [u8]
    body: [u8]

fn http_wire_parts_fit(parts: HttpWireParts, max_wire_bytes: u64) -> bool:
    val head_len = parts.head.len().to_u64()
    val body_len = parts.body.len().to_u64()
    response_wire_parts_fit(head_len, body_len, max_wire_bytes)

fn _text_response_parts(response: HttpResponse) -> HttpWireParts:
    HttpWireParts(head: text_to_bytes_pure(serialize_response(response)), body: [])

fn http_frame_rejection_wire(error: text, max_wire_bytes: u64) -> [u8]:
    val rejected = HttpResponse(
        status: request_parse_error_status(error),
        headers: [], body: "ERR HTTP request rejected\n"
    )
    val wire = bounded_response_wire(
        with_default_security_headers(rejected, false),
        max_wire_bytes.to_i64()
    )
    if wire == "":
        return []
    text_to_bytes_pure(wire)

fn _byte_response_parts(response: HttpResponse, body: [u8]) -> HttpWireParts:
    val head = serialize_response_head_for_body_length(response, body.len().to_i64())
    HttpWireParts(head: text_to_bytes_pure(head), body: body)

fn bind_listener(port: u16) -> Result<Socket, text>:
    val ip = IpAddr.from_text("0.0.0.0")?
    match socket(2u32, 1u32):
        case Err(message): Err(message)
        case Ok(listener):
            match bind(listener, SockAddr(ip: ip, port: port)):
                case Err(message):
                    if listener_requires_setup_failure_close(true, false, false):
                        close_fd(listener.fd)
                    Err(message)
                case Ok(_):
                    match listen(listener, 8):
                        case Err(message):
                            if listener_requires_setup_failure_close(true, true, false):
                                close_fd(listener.fd)
                            Err(message)
                        case Ok(_): Ok(listener)

fn http_response(request: text) -> HttpWireParts:
    val route = http_classify_request(request)
    var response = HttpResponse(
        status: HttpStatus.NotFound,
        headers: [],
        body: "ERR route not found\n"
    )
    match route.kind:
        case HttpRouteKind.BadRequest:
            response = HttpResponse(status: HttpStatus.BadRequest, headers: [], body: "ERR malformed request\n")
        case HttpRouteKind.NotFound:
            response = HttpResponse(status: HttpStatus.NotFound, headers: [], body: "ERR route not found\n")
        case HttpRouteKind.Status:
            response = HttpResponse(
                status: HttpStatus.Ok,
                headers: [("Content-Type", "text/html; charset=utf-8")],
                body: "<html><body>SimpleOS ready</body></html>"
            )
        case HttpRouteKind.Health:
            response = HttpResponse(
                status: HttpStatus.Ok,
                headers: [("Content-Type", "application/json")],
                body: "{\"status\":\"ok\",\"server\":\"SimpleOS\"}\n"
            )
        case HttpRouteKind.File:
            # The combined image also owns private database provisioning
            # files. Resolve public assets through the launch grant manifest;
            # never derive an arbitrary /SYS path from network input.
            val public_path = simpleos_server_public_file_path_v1(route.file_path)
            if public_path == nil:
                return _text_response_parts(with_default_security_headers(
                    HttpResponse(
                        status: HttpStatus.NotFound, headers: [],
                        body: "ERR file not found\n"), false))
            val mounted_path = public_path.unwrap()
            match read_file_bytes_direct(mounted_path, 65536):
                Err(_):
                    response = HttpResponse(status: HttpStatus.NotFound, headers: [], body: "ERR file not found\n")
                Ok(bytes):
                    val file_response = with_default_security_headers(HttpResponse(
                        status: HttpStatus.Ok,
                        headers: [("Content-Type", mime_from_path(mounted_path))],
                        body: ""
                    ), false)
                    return _byte_response_parts(file_response, bytes)
    _text_response_parts(with_default_security_headers(response, false))

fn send_websocket_events(client: Socket, events: [Rfc6455ServerEvent]) -> bool:
    for event in events:
        if event.outbound.len() > 0u64 and not send_all(client, event.outbound):
            return false
    true

class WebSocketTransportOwner:
    active: bool
    client: Socket
    protocol: Rfc6455ServerConnectionOwner
    consecutive_no_progress: i32

    static fn create() -> WebSocketTransportOwner:
        WebSocketTransportOwner(
            active: false,
            client: Socket(fd: -1),
            protocol: Rfc6455ServerConnectionOwner.create(),
            consecutive_no_progress: 0
        )

    fn can_adopt() -> bool: not self.active

    me _release():
        if self.active:
            close_fd(self.client.fd)
        self.active = false
        self.client = Socket(fd: -1)
        self.consecutive_no_progress = 0

    me _policy_close():
        if not self.active:
            return
        val event = self.protocol.close_for_policy()
        if event.outbound.len() > 0u64:
            val _ = send_all(self.client, event.outbound)
        self._release()

    me adopt(client: Socket, tail: [u8]) -> bool:
        if self.active:
            return false
        self.active = true
        self.client = client
        self.protocol = Rfc6455ServerConnectionOwner.create()
        self.consecutive_no_progress = 0
        val events = self.protocol.append_tail(tail)
        if not send_websocket_events(self.client, events):
            self._release()
            return true
        if self.protocol.is_terminal():
            self._release()
        true

    me step() -> bool:
        # One bounded receive per outer service-loop iteration prevents a
        # persistent WebSocket from starving HTTP accepts or DB service work.
        if not self.active:
            return false
        match socket_recv(self.client, 8192u64):
            Err(_):
                # A transport error is terminal; retrying it would hot-spin.
                self._release()
                false
            Ok(input):
                if input.len() == 0u64:
                    self.consecutive_no_progress = self.consecutive_no_progress + 1
                    if self.consecutive_no_progress >= MAX_WEBSOCKET_READS:
                        self._policy_close()
                    return false
                self.consecutive_no_progress = 0
                val events = self.protocol.append_tail(input)
                if not send_websocket_events(self.client, events):
                    self._release()
                    return false
                if self.protocol.is_terminal():
                    self._release()
                true

    me handle_http(listener: Socket, policy: SecureServerPolicy) -> bool:
        # Accept/adopt is a mutation of this same authoritative owner. No fd
        # authority is returned through or retained by a value-parameter copy.
        match accept(listener):
            Err(_): false
            Ok(client):
                var client_transferred = false
                val frame = recv_http1_request_owned(client, policy)
                if frame.complete:
                    if frame.websocket_upgrade_candidate:
                        val decision = validate_rfc6455_server_handshake(frame.request)
                        if (decision.accepted and
                            frame.request.starts_with("GET /ws HTTP/1.1\r\n") and
                            self.can_adopt()):
                            if send_all(client, text_to_bytes_pure(decision.response)):
                                client_transferred = self.adopt(client, frame.upgrade_tail)
                        else:
                            val rejected = HttpResponse(
                                status: HttpStatus.BadRequest,
                                headers: [], body: "ERR invalid WebSocket upgrade\n"
                            )
                            val wire = serialize_response(
                                with_default_security_headers(rejected, false))
                            val _ = send_all(client, text_to_bytes_pure(wire))
                    else:
                        val response = http_response(frame.request)
                        if http_wire_parts_fit(response, MAX_WIRE_RESPONSE):
                            val head_sent = send_all(client, response.head)
                            if head_sent and response.body.len() > 0:
                                val _body_sent = send_all(client, response.body)
                else:
                    val wire = http_frame_rejection_wire(
                        frame.error, MAX_WIRE_RESPONSE)
                    if wire.len() > 0u64:
                        val _ = send_all(client, wire)
                if not client_transferred:
                    close_fd(client.fd)
                true

    me shutdown():
        self._policy_close()

fn publish_credential_zeroization(phase: text, report: SecureZeroReport, hash_workspace_zeroized: bool):
    val status = if report.verified(): "verified" else: "failed"
    val hash_status = if hash_workspace_zeroized: "verified" else: "failed"
    debug_line("[simpleos-servers-user] credential-zeroization phase={phase} " +
        "method=volatile-u8-exact-byte-readback-v1 bytes={report.slot_count} " +
        "overwritten={report.overwritten_slots} " +
        "residual_nonzero={report.residual_nonzero_slots} " +
        "hash_workspace={hash_status} status={status}")

fn credential_byte_is_space(b: u8) -> bool:
    # The exact set `text.trim()` strips, matched on bytes so the credential
    # never has to become a `text` to be trimmed.
    b == 32u8 or b == 9u8 or b == 10u8 or b == 13u8 or b == 11u8 or b == 12u8

fn provision_database_service(server: DbdServer) -> bool:
    # The credential exists ONLY as mutable byte buffers, from the file read
    # through digest registration.  Nothing here builds a `text` from it: an
    # immutable `text` cannot be zeroized, so every copy would survive for the
    # process lifetime and could reach a core dump or a retained acceptance
    # image. Only the SHA-256 digest is retained, by CapabilityTable. The sole
    # owned buffer is wiped on every path. Surrounding whitespace is rejected
    # instead of trimmed, because trimming would create a second secret copy.
    # doc/08_tracking/bug/simpleos_server_credential_zeroization_gap_2026-08-14.md
    match read_file_bytes_direct_owned(DB_CREDENTIAL_PATH, MAX_DB_CREDENTIAL_BYTES + 1u64):
        Err(_): nil
        Ok(loaded_bytes):
            var credential = loaded_bytes
            if (credential.len() == 0u64 or credential.len() > MAX_DB_CREDENTIAL_BYTES or
                credential_byte_is_space(credential[0u64]) or
                credential_byte_is_space(credential[credential.len() - 1u64])):
                val rejected_report = secure_zero_u8_slots(credential)
                publish_credential_zeroization("loaded-rejected", rejected_report, false)
                return false
            match read_file_bytes_direct_owned(DB_CERTIFICATE_PATH, 65536u64):
                Err(_):
                    val report = secure_zero_u8_slots(credential)
                    publish_credential_zeroization("certificate-missing", report, false)
                    false
                Ok(loaded_cert):
                    var cert = loaded_cert
                    match read_file_bytes_direct_owned(DB_PRIVATE_KEY_PATH, 16384u64):
                        Err(_):
                            val _ = secure_zero_u8_slots(cert)
                            val report = secure_zero_u8_slots(credential)
                            publish_credential_zeroization("private-key-missing", report, false)
                            false
                        Ok(loaded_key):
                            var key = loaded_key
                            val admitted = server.provision_service(
                                "operator", credential, [cert], key, 0x0807u16)
                            val credential_report = secure_zero_u8_slots(credential)
                            val cert_report = secure_zero_u8_slots(cert)
                            val key_report = secure_zero_u8_slots(key)
                            val all_wiped = credential_report.verified() and
                                cert_report.verified() and key_report.verified()
                            publish_credential_zeroization(
                                "loaded", credential_report, admitted and all_wiped)
                            admitted and all_wiped

fn main() -> i64:
    var db_server = DbdServer.new()
    if not provision_database_service(db_server):
        debug_line("[simpleos-servers-user] credential=blocked path=" + DB_CREDENTIAL_PATH)
        return 5
    val dbfs_caps = simpleos_database_dbfs_vfs_caps()
    if not db_server.attach_filesystem_dbfs_vfs(dbfs_caps.0, dbfs_caps.1, dbfs_caps.2):
        debug_line("[simpleos-servers-user] dbfs-vfs=blocked reason=" + db_server.service_blocker())
        val _ = db_server.close_service()
        return 6
    db_server.replay_log()
    if not db_server.service_ready():
        debug_line("[simpleos-servers-user] dbd=blocked reason=" + db_server.service_blocker())
        val _ = db_server.close_service()
        return 7

    # Plaintext is explicitly a development listener on all guest interfaces.
    # QEMU hostfwd may narrow host exposure, but the guest bind itself does not.
    # Production TLS remains fail-closed outside this explicit capability.
    val capability = plaintext_development_capability("QEMU guest development listener")
    if capability.is_err():
        val _ = db_server.close_service()
        return 2
    val secure_policy = SecureServerPolicy.plaintext_dev(capability.unwrap())
    if secure_policy.max_request_line < 1 or secure_policy.max_connections < 1:
        val _ = db_server.close_service()
        return 2

    val http_result = bind_listener(HTTP_PORT)
    val db_listener = db_server.bind_listener(DB_PORT.to_i64())
    if http_result.is_err() or db_listener < 0:
        debug_line("[simpleos-servers-user] listener bind=fail")
        if http_listener_requires_partial_startup_close(
            http_result.is_ok(), db_listener):
            close_fd(http_result.unwrap().fd)
        val _ = db_server.close_service()
        return 3
    val http_listener = http_result.unwrap()

    debug_line("[simpleos-servers-user] executable=" +
        SIMPLEOS_SERVER_EXECUTABLE_V1 + " launch=ok")
    debug_line("[simpleos-servers-user] http=:8080 db=:5433 ready=ok")

    var idle_polls: i64 = 0
    var accepted_connections: i64 = 0
    var websocket = WebSocketTransportOwner.create()
    while idle_polls < MAX_IDLE_POLLS:
        if accepted_connections >= secure_policy.max_connections:
            break
        val websocket_work = websocket.step()
        val http_work = websocket.handle_http(http_listener, secure_policy)
        if http_work:
            accepted_connections = accepted_connections + 1
        var db_work = false
        if accepted_connections < secure_policy.max_connections:
            db_work = db_server.accept_and_handle_once()
            if db_work:
                accepted_connections = accepted_connections + 1
        if websocket_work or http_work or db_work:
            idle_polls = 0
        else:
            idle_polls = idle_polls + 1
            val _ = syscall(2, 0, 0, 0, 0, 0)

    websocket.shutdown()
    close_fd(http_listener.fd)
    val _ = db_server.close_service()
    debug_line("[simpleos-servers-user] bounded idle stop")
    0

export http_listener_requires_partial_startup_close
export listener_requires_setup_failure_close
export http_frame_rejection_wire
