# Filesystem-launched SimpleOS server process.
#
# Transport is the thin user-syscall adapter. HTTP classification, response
# framing/security headers, database authentication/capability checks,
# transaction semantics, bounded responses, commit identity, and durability
# are all delegated to their canonical Pure-Simple owners.

use os.userlib.net.{IpAddr, SockAddr, Socket, socket, bind, listen, accept, socket_send, socket_recv}
use os.userlib.fs.{read_file_bytes_direct, read_file_bytes_direct_owned}
use os.userlib.syscall_raw.{syscall}
use os.userlib.server_startup.{server_startup_admission_consume_v1}
use os.kernel.net.http_route.{http_classify_request, HttpRouteKind}
use std.nogc_sync_mut.http_server.types.{HttpResponse, HttpStatus}
use std.nogc_sync_mut.http_server.response.{serialize_response, with_default_security_headers}
use std.nogc_sync_mut.http_server.mime.{mime_from_path}
use std.nogc_sync_mut.http_server.server.{SecureServerPolicy, plaintext_development_capability}
use std.nogc_sync_mut.http_server.parser.{parse_request_line, headers_decision}
use os.apps.dbd.dbd.{DbdServer}
use os.apps.dbd.dbd_close_owner.{
    DbdCloseOwnerV1, DbdCloseDispositionV1
}
use std.fs_driver.bytes_util.{text_to_bytes_pure}
use std.nogc_sync_mut.binary_io.{bytes_to_string}
use std.common.crypto.secure_memory.{SecureZeroReport, secure_zero_u8_slots}
use os.apps.servers_user.database_persistence_adapter.{
    simpleos_database_dbfs_vfs_caps
}

val HTTP_PORT: u16 = 8080u16
val MAX_IDLE_POLLS: i64 = 10000000
val DB_CREDENTIAL_PATH: text = "/SYS/SRVDB.KEY"
val DB_CERTIFICATE_PATH: text = "/SYS/SRVDB.CRT"
val DB_PRIVATE_KEY_PATH: text = "/SYS/SRVDB.PK8"
val MAX_DB_CREDENTIAL_BYTES: u64 = 128u64
val MAX_WIRE_RESPONSE: u64 = 65536

fn debug_line(message: text):
    val bytes = text_to_bytes_pure(message + "\n")
    for byte in bytes:
        val _ = syscall(60, byte as u64, 0, 0, 0, 0)

fn close_fd(fd: i32) -> bool:
    syscall(33, fd as u64, 0, 0, 0, 0) >= 0

fn server_shutdown_exit_code_v1(
    websocket_closed: bool, http_listener_closed: bool,
    database_closed: bool
) -> i64:
    """Return success only after every live server resource owner closes."""
    if websocket_closed and http_listener_closed and database_closed:
        return 0
    9

fn send_all(sock: Socket, bytes: [u8]) -> bool:
    var sent: u64 = 0
    var attempts: i32 = 0
    while sent < bytes.len() as u64 and attempts < 64:
        val remaining = bytes.slice(sent, bytes.len() as u64)
        match socket_send(sock, remaining):
            Ok(count):
                if count == 0:
                    attempts = attempts + 1
                else:
                    sent = sent + count
            Err(_):
                attempts = attempts + 1
    sent == bytes.len() as u64

fn bind_listener(port: u16) -> Result<Socket, text>:
    val ip = IpAddr.from_text("0.0.0.0")?
    val listener = socket(2u32, 1u32)?
    val _bound = bind(listener, SockAddr(ip: ip, port: port))?
    val _listening = listen(listener, 8)?
    Ok(listener)

fn bounded_http_request(request: text, policy: SecureServerPolicy) -> bool:
    val sections = request.split("\r\n\r\n")
    if sections.len() != 2:
        return false
    val lines = sections[0].split("\r\n")
    if lines.len() < 1 or lines.len() - 1 > policy.max_header_count as i64:
        return false
    if lines[0].len() > policy.max_request_line:
        return false
    val request_parts = parse_request_line(lines[0])
    if request_parts.0 == "" or request_parts.1 == "" or request_parts.2 == "":
        return false
    var headers: [(text, text)] = []
    var index: i64 = 1
    while index < lines.len():
        if lines[index].len() > policy.max_header_line:
            return false
        val separator = lines[index].find(":")
        if separator <= 0:
            return false
        headers.push((lines[index].slice(0, separator), lines[index].slice(separator + 1, lines[index].len()).trim()))
        index = index + 1
    val body_decision = headers_decision(headers, policy.max_body)
    body_decision.0 == "" and sections[1].len() == body_decision.1 as i64

fn http_response(request: text) -> text:
    val route = http_classify_request(request)
    var response = HttpResponse(
        status: HttpStatus.NotFound,
        headers: [],
        body: "ERR route not found\n"
    )
    match route.kind:
        case HttpRouteKind.BadRequest:
            response = HttpResponse(status: HttpStatus.BadRequest, headers: [], body: "ERR malformed request\n")
        case HttpRouteKind.NotFound:
            response = HttpResponse(status: HttpStatus.NotFound, headers: [], body: "ERR route not found\n")
        case HttpRouteKind.Status:
            response = HttpResponse(
                status: HttpStatus.Ok,
                headers: [("Content-Type", "text/html; charset=utf-8")],
                body: "<html><body>SimpleOS ready</body></html>"
            )
        case HttpRouteKind.Health:
            response = HttpResponse(
                status: HttpStatus.Ok,
                headers: [("Content-Type", "application/json")],
                body: "{\"status\":\"ok\",\"server\":\"SimpleOS\"}\n"
            )
        case HttpRouteKind.File:
            # /files/X is the public route; the immutable system document is
            # stored under /SYS/X on the mounted FAT32 image.
            val mounted_path = "/SYS" + route.file_path
            match read_file_bytes_direct(mounted_path, 65536):
                Err(_):
                    response = HttpResponse(status: HttpStatus.NotFound, headers: [], body: "ERR file not found\n")
                Ok(bytes):
                    response = HttpResponse(
                        status: HttpStatus.Ok,
                        headers: [("Content-Type", mime_from_path(mounted_path))],
                        body: bytes_to_string(bytes)
                    )
    serialize_response(with_default_security_headers(response, false))

fn handle_http(listener: Socket, policy: SecureServerPolicy) -> bool:
    match accept(listener):
        Err(_): false
        Ok(client):
            match socket_recv(client, 8192):
                Err(_): debug_line("[simpleos-servers-user] http recv=fail")
                Ok(bytes):
                    val request = bytes_to_string(bytes)
                    if bounded_http_request(request, policy):
                        val response = text_to_bytes_pure(http_response(request))
                        if response.len() <= MAX_WIRE_RESPONSE:
                            val _sent = send_all(client, response)
                    else:
                        val rejected = HttpResponse(
                            status: HttpStatus.BadRequest,
                            headers: [], body: "ERR incomplete request\n"
                        )
                        val wire = serialize_response(with_default_security_headers(rejected, false))
                        val _ = send_all(client, text_to_bytes_pure(wire))
            close_fd(client.fd)
            true

fn server_store() -> SdnDatabase:
    val loaded = SdnDatabase.load(DB_PATH)
    var store = loaded ?? SdnDatabase.new(DB_PATH)
    if not store.get_table("records").?:
        store.set_table("records", SdnTable.new(
            "records", ["id", "value", "valid", "_db_server_version"]
        ))
    store

fn publish_credential_zeroization(phase: text, report: SecureZeroReport, hash_workspace_zeroized: bool):
    val status = if report.verified(): "verified" else: "failed"
    val hash_status = if hash_workspace_zeroized: "verified" else: "failed"
    debug_line("[simpleos-servers-user] credential-zeroization phase={phase} " +
        "method=volatile-u8-exact-byte-readback-v1 bytes={report.slot_count} " +
        "overwritten={report.overwritten_slots} " +
        "residual_nonzero={report.residual_nonzero_slots} " +
        "hash_workspace={hash_status} status={status}")

fn credential_byte_is_space(b: u8) -> bool:
    # The exact set `text.trim()` strips, matched on bytes so the credential
    # never has to become a `text` to be trimmed.
    b == 32u8 or b == 9u8 or b == 10u8 or b == 13u8 or b == 11u8 or b == 12u8

fn load_server_policy() -> CapabilityTable?:
    # The credential exists ONLY as mutable byte buffers, from the file read
    # through digest registration.  Nothing here builds a `text` from it: an
    # immutable `text` cannot be zeroized, so every copy would survive for the
    # process lifetime and could reach a core dump or a retained acceptance
    # image. Only the SHA-256 digest is retained, by CapabilityTable. The sole
    # owned buffer is wiped on every path. Surrounding whitespace is rejected
    # instead of trimmed, because trimming would create a second secret copy.
    # doc/08_tracking/bug/simpleos_server_credential_zeroization_gap_2026-08-14.md
    match read_file_bytes_direct_owned(DB_CREDENTIAL_PATH, MAX_DB_CREDENTIAL_BYTES + 1u64):
        Err(_): nil
        Ok(loaded_bytes):
            var bytes = loaded_bytes
            if (bytes.len() == 0u64 or bytes.len() > MAX_DB_CREDENTIAL_BYTES or
                credential_byte_is_space(bytes[0u64]) or
                credential_byte_is_space(bytes[bytes.len() - 1u64])):
                if bytes.len() > 0u64:
                    val rejected_report = secure_zero_u8_slots(bytes)
                    publish_credential_zeroization("loaded-rejected", rejected_report, false)
                nil
            else:
                var policy = CapabilityTable.new()
                val registration_ok = policy.register_authenticated_bytes(capability_with("operator", [
                    grant_key("records", "read"), grant_key("records", "write")
                ]), bytes)
                val loaded_report = secure_zero_u8_slots(bytes)
                publish_credential_zeroization("loaded", loaded_report, registration_ok)
                if registration_ok and loaded_report.verified():
                    Some(policy)
                else:
                    nil

fn handle_db(listener: Socket, server: DbServerCapsule) -> bool:
    match accept(listener):
        Err(_): false
        Ok(client):
            match socket_recv(client, 8192):
                Err(_): debug_line("[arm64-servers-user] db recv=fail")
                Ok(bytes):
                    val line = bytes_to_string(bytes).trim()
                    val reply = server.handle_message(line) + "\n"
                    val _ = send_all(client, text_to_bytes_pure(reply))
            close_fd(client.fd)
            true

fn main() -> i64:
    # DBD owns its endpoint and persistence namespace.  This filesystem
    # launcher only consumes the one-shot startup receipt before handing off
    # to that canonical owner; it must not recreate either authority locally.
    var db_server = DbdServer.new_filesystem_launched_v1()
    if not db_server.startup_evidence_ready_v1():
        debug_line("[simpleos-servers-user] startup-evidence=blocked")
        return 8
    if not provision_database_service(db_server):
        debug_line("[simpleos-servers-user] credential=blocked path=" + DB_CREDENTIAL_PATH)
        return 5
    val dbfs_caps = simpleos_database_dbfs_vfs_caps()
    if not db_server.attach_filesystem_dbfs_vfs(dbfs_caps.0, dbfs_caps.1, dbfs_caps.2):
        debug_line("[simpleos-servers-user] dbfs-vfs=blocked reason=" + db_server.service_blocker())
        val _ = db_server.close_service()
        return 6
    db_server.replay_log()
    if not db_server.service_ready():
        debug_line("[simpleos-servers-user] dbd=blocked reason=" + db_server.service_blocker())
        val _ = db_server.close_service()
        return 7

    # Plaintext is narrowly authorized for loopback hostfwd acceptance. The
    # canonical secure policy still supplies every request/connection bound;
    # production TLS remains fail-closed outside this explicit capability.
    val capability = plaintext_development_capability("isolated QEMU hostfwd acceptance")
    if capability.is_err():
        val _ = db_server.close_service()
        return 2
    val secure_policy = SecureServerPolicy.plaintext_dev(capability.unwrap())
    if secure_policy.max_request_line < 1 or secure_policy.max_connections < 1:
        val _ = db_server.close_service()
        return 2

    val http_result = bind_listener(HTTP_PORT)
    val db_listener = db_server.bind_listener()
    if http_result.is_err() or db_listener < 0:
        debug_line("[simpleos-servers-user] listener bind=fail")
        val _ = db_server.close_service()
        return 3
    val http_listener = http_result.unwrap()

    debug_line("[simpleos-servers-user] executable=/SERVERS.ELF launch=ok")
    debug_line("[simpleos-servers-user] http=:8080 db=:" + DBD_PORT.to_text() + " ready=ok")

    var idle_polls: i64 = 0
    var accepted_connections: i64 = 0
    while idle_polls < MAX_IDLE_POLLS:
        if accepted_connections >= secure_policy.max_connections:
            break
        val http_work = handle_http(http_listener, secure_policy)
        if http_work:
            accepted_connections = accepted_connections + 1
        var db_work = false
        if accepted_connections < secure_policy.max_connections:
            db_work = db_server.accept_and_handle_once()
            if db_work:
                accepted_connections = accepted_connections + 1
        if http_work or db_work:
            idle_polls = 0
        else:
            idle_polls = idle_polls + 1
            val _ = syscall(2, 0, 0, 0, 0, 0)

    close_fd(http_listener.fd)
    val _ = db_server.close_service()
    debug_line("[simpleos-servers-user] bounded idle stop")
    0
