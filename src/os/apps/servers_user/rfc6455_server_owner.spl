# Bounded server-side RFC 6455 prerequisite for the filesystem server.
#
# This owner is intentionally transport-free.  A future HTTP connection owner
# may validate an upgrade, write the returned response, and transfer both the
# socket and any bytes read past the HTTP header through append_tail().  Nothing
# in this module makes WebSocket reachable from /SERVERS.ELF.

use std.nogc_sync_mut.websocket.handshake.{compute_websocket_accept}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use os.apps.servers_user.http1_request_frame_owner.{
    http1_host_authority_is_valid, http1_origin_form_target_is_valid
}

pub val RFC6455_MAX_MESSAGE_BYTES: u64 = 65536u64
pub val RFC6455_MAX_RETAINED_FRAME_BYTES: u64 = 65550u64
pub val RFC6455_MAX_FRAGMENTS: i32 = 1024
pub val RFC6455_MAX_HANDSHAKE_BYTES: u64 = 65550u64
pub val RFC6455_MAX_HANDSHAKE_LINE_BYTES: u64 = 8192u64
pub val RFC6455_MAX_HANDSHAKE_HEADERS: i32 = 100
pub val RFC6455_MAX_INPUT_CHUNK_BYTES: u64 = 8192u64
pub val RFC6455_MAX_EVENTS_PER_APPEND: u64 = 1367u64

pub class Rfc6455HandshakeDecision:
    accepted: bool
    response: text
    error: text

pub enum Rfc6455ServerEventKind:
    FragmentProgress
    TextMessage
    BinaryMessage
    Ping
    Pong
    PeerClose
    ProtocolClose

pub class Rfc6455ServerEvent:
    kind: Rfc6455ServerEventKind
    payload: [u8]
    outbound: [u8]
    close_code: i64
    error: text

fn _handshake_reject(error: text) -> Rfc6455HandshakeDecision:
    Rfc6455HandshakeDecision(accepted: false, response: "", error: error)

fn _ascii_token_byte(byte: u8) -> bool:
    (byte >= 48u8 and byte <= 57u8) or
        (byte >= 65u8 and byte <= 90u8) or
        (byte >= 97u8 and byte <= 122u8) or
        byte == 33u8 or byte == 35u8 or byte == 36u8 or byte == 37u8 or
        byte == 38u8 or byte == 39u8 or byte == 42u8 or byte == 43u8 or
        byte == 45u8 or byte == 46u8 or byte == 94u8 or byte == 95u8 or
        byte == 96u8 or byte == 124u8 or byte == 126u8

fn _field_name_valid(name: text) -> bool:
    val bytes = name.bytes()
    if bytes.len() == 0:
        return false
    for byte in bytes:
        if not _ascii_token_byte(byte.to_u8()):
            return false
    true

fn _strict_crlf(bytes: [u8]) -> bool:
    var index: u64 = 0u64
    var line_bytes: u64 = 0u64
    var separators: i32 = 0
    while index < bytes.len():
        if bytes[index] == 13:
            if index + 1u64 >= bytes.len() or bytes[index + 1u64] != 10:
                return false
            if line_bytes > RFC6455_MAX_HANDSHAKE_LINE_BYTES:
                return false
            separators = separators + 1
            # Request line + at most 100 header lines + terminal empty line.
            # Bound this before split("\r\n") can allocate an element for
            # every attacker-controlled separator in the 65 KiB envelope.
            if separators > RFC6455_MAX_HANDSHAKE_HEADERS + 2:
                return false
            line_bytes = 0u64
            index = index + 2u64
        elif bytes[index] == 10:
            return false
        else:
            line_bytes = line_bytes + 1u64
            if line_bytes > RFC6455_MAX_HANDSHAKE_LINE_BYTES:
                return false
            index = index + 1u64
    true

fn _token_list_count(value: text, expected: text) -> i32:
    var count = 0
    for part in value.split(","):
        if part.trim().lower() == expected:
            count = count + 1
    count

fn _request_line_has_three_nonempty_parts(wire: [u8]) -> bool:
    # Reuse the already-bounded wire snapshot before either split allocation.
    # RFC 9112's request-line has exactly two SP separators and no empty
    # component; HTAB is not an alternate separator.
    var spaces: i32 = 0
    var token_bytes: u64 = 0u64
    var index: u64 = 0u64
    while index < wire.len() and wire[index] != 13u8:
        val byte = wire[index]
        if byte == 32:
            if token_bytes == 0u64 or spaces >= 2:
                return false
            spaces = spaces + 1
            token_bytes = 0u64
        elif byte == 9u8:
            return false
        else:
            token_bytes = token_bytes + 1u64
        index = index + 1u64
    index < wire.len() and spaces == 2 and token_bytes > 0u64

fn _token_list_valid(value: text, allow_protocol_version: bool) -> bool:
    for raw_part in value.split(","):
        val part = raw_part.trim()
        if part == "":
            # RFC list extension permits and requires recipients to ignore
            # empty members. The bounded handshake size/header limits cap how
            # many a peer can send.
            continue
        val slash = part.find("/")
        if slash >= 0:
            if not allow_protocol_version or slash == 0 or slash + 1 == part.len() or
                part.slice(slash + 1, part.len()).contains("/"):
                return false
        for byte in part.bytes():
            if byte == 47:
                if not allow_protocol_version:
                    return false
            elif not _ascii_token_byte(byte.to_u8()):
                return false
    true

fn _field_value_valid(value: text) -> bool:
    # RFC 9110 field-content permits HTAB, SP, visible ASCII and obs-text.
    # Reject every other C0 control plus DEL before trimming or tokenization.
    for byte in value.bytes():
        if (byte < 32 and byte != 9) or byte == 127:
            return false
    true

fn _base64_symbol(byte: u8) -> bool:
    (byte >= 65u8 and byte <= 90u8) or
        (byte >= 97u8 and byte <= 122u8) or
        (byte >= 48u8 and byte <= 57u8) or byte == 43u8 or byte == 47u8

fn _websocket_key_is_canonical_16_bytes(key: text) -> bool:
    # Sixteen octets have one canonical RFC 4648 shape: 22 data symbols and
    # two padding bytes.  The low four bits of data symbol 22 must be zero.
    val bytes = key.bytes()
    if bytes.len() != 24:
        return false
    var index: u64 = 0u64
    while index < 22u64:
        if not _base64_symbol(bytes[index].to_u8()):
            return false
        index = index + 1u64
    if bytes[22u64] != 61 or bytes[23u64] != 61:
        return false
    val last = bytes[21u64]
    last == 65 or last == 81 or last == 103 or last == 119

pub fn validate_rfc6455_server_handshake(request: text) -> Rfc6455HandshakeDecision:
    val wire = request.bytes()
    if wire.len() > RFC6455_MAX_HANDSHAKE_BYTES:
        return _handshake_reject("handshake exceeds 65550 bytes")
    if not _strict_crlf(wire) or not request.ends_with("\r\n\r\n"):
        return _handshake_reject("handshake requires strict CRLF framing")
    if not _request_line_has_three_nonempty_parts(wire):
        return _handshake_reject("malformed WebSocket request line")
    val lines = request.split("\r\n")
    if lines.len() < 3:
        return _handshake_reject("handshake is incomplete")
    if lines[0].len().to_u64() > RFC6455_MAX_HANDSHAKE_LINE_BYTES:
        return _handshake_reject("handshake request line exceeds 8192 bytes")
    val request_parts = lines[0].split(" ")
    if request_parts.len() != 3 or request_parts[0] != "GET" or
        request_parts[2] != "HTTP/1.1":
        return _handshake_reject("WebSocket upgrade requires GET HTTP/1.1")
    # The direct/exported handshake seam must not admit a request target that
    # the production HTTP owner rejects before handoff.  In particular, keep
    # backslashes, encoded path separators, and encoded controls out of both
    # paths through the shared bounded origin-form policy while retaining the
    # query component permitted in a WebSocket resource name.
    if not http1_origin_form_target_is_valid("GET", request_parts[1]):
        return _handshake_reject("invalid WebSocket request target")

    var host = ""
    var version = ""
    var key = ""
    var websocket_upgrade_token_count = 0
    var connection_upgrade_token_count = 0
    var host_count = 0
    var upgrade_count = 0
    var connection_count = 0
    var version_count = 0
    var key_count = 0
    var index: u64 = 1u64
    while index < lines.len() and lines[index] != "":
        val line = lines[index]
        if line.len().to_u64() > RFC6455_MAX_HANDSHAKE_LINE_BYTES:
            return _handshake_reject("handshake header line exceeds 8192 bytes")
        if index > RFC6455_MAX_HANDSHAKE_HEADERS.to_u64():
            return _handshake_reject("handshake exceeds 100 headers")
        if line.starts_with(" ") or line.starts_with("\t"):
            return _handshake_reject("obsolete folded headers are forbidden")
        val colon = line.find(":")
        if colon <= 0:
            return _handshake_reject("malformed handshake header")
        val name = line.slice(0, colon)
        if not _field_name_valid(name):
            return _handshake_reject("invalid handshake field name")
        val raw_value = line.slice(colon + 1, line.len())
        if not _field_value_valid(raw_value):
            return _handshake_reject("invalid control byte in handshake field value")
        val value = raw_value.trim()
        val lower = name.lower()
        if lower == "host":
            host_count = host_count + 1
            host = value
        elif lower == "upgrade":
            if not _token_list_valid(value, true):
                return _handshake_reject("invalid Upgrade protocol list")
            upgrade_count = upgrade_count + 1
            websocket_upgrade_token_count = websocket_upgrade_token_count +
                _token_list_count(value, "websocket")
        elif lower == "connection":
            if not _token_list_valid(value, false):
                return _handshake_reject("invalid Connection token list")
            connection_count = connection_count + 1
            connection_upgrade_token_count = connection_upgrade_token_count +
                _token_list_count(value, "upgrade")
        elif lower == "sec-websocket-version":
            version_count = version_count + 1
            version = value
        elif lower == "sec-websocket-key":
            key_count = key_count + 1
            key = value
        elif lower == "content-length" or lower == "transfer-encoding":
            return _handshake_reject("WebSocket upgrade request body framing is forbidden")
        elif lower == "origin":
            # This development endpoint has no configured browser-origin
            # allowlist. Refuse browser ambient-authority upgrades instead of
            # pretending that a non-empty Origin is authenticated.
            return _handshake_reject("WebSocket Origin policy is not configured")
        index = index + 1u64

    # split("\r\n") leaves two terminal empty elements for the required
    # header terminator.  Anything after the first empty line is smuggling,
    # not another handshake header block.
    if index + 2u64 != lines.len():
        return _handshake_reject("bytes follow the WebSocket handshake")

    if host_count != 1 or not http1_host_authority_is_valid(host):
        # Keep the alternate/direct handshake seam on the exact authority
        # policy owned by the incremental HTTP/1 framer.  Production normally
        # reaches this after framing, but the exported handshake function must
        # not become a weaker second protocol path.
        return _handshake_reject("handshake requires exactly one valid Host authority")
    if upgrade_count < 1 or websocket_upgrade_token_count != 1:
        return _handshake_reject("handshake requires one unambiguous WebSocket Upgrade token")
    if connection_count < 1 or connection_upgrade_token_count != 1:
        return _handshake_reject("handshake requires one unambiguous Connection upgrade token")
    if version_count != 1 or version != "13":
        return _handshake_reject("handshake requires Sec-WebSocket-Version 13")
    if key_count != 1 or not _websocket_key_is_canonical_16_bytes(key):
        return _handshake_reject("handshake requires one canonical 16-byte Sec-WebSocket-Key")

    val accept = compute_websocket_accept(key)
    val response = "HTTP/1.1 101 Switching Protocols\r\n" +
        "Upgrade: websocket\r\n" +
        "Connection: Upgrade\r\n" +
        "Sec-WebSocket-Accept: {accept}\r\n\r\n"
    Rfc6455HandshakeDecision(accepted: true, response: response, error: "")

fn _server_frame(opcode: u8, payload: [u8]) -> [u8]:
    var result: [u8] = [0x80u8 | opcode]
    if payload.len() < 126u64:
        result.push(payload.len().to_u8())
    else:
        result.push(126u8)
        result.push(((payload.len() >> 8u64) & 255u64).to_u8())
        result.push((payload.len() & 255u64).to_u8())
    result.extend(payload)
    result

fn _close_payload(code: i64) -> [u8]:
    [((code >> 8) & 255).to_u8(), (code & 255).to_u8()]

fn _valid_close_code(code: i64) -> bool:
    if code >= 3000 and code <= 4999:
        return true
    if code < 1000 or code > 1014:
        return false
    code != 1004 and code != 1005 and code != 1006

fn _event(kind: Rfc6455ServerEventKind, payload: [u8], outbound: [u8],
    close_code: i64, error: text) -> Rfc6455ServerEvent:
    Rfc6455ServerEvent(kind: kind, payload: payload, outbound: outbound,
        close_code: close_code, error: error)

pub class Rfc6455ServerConnectionOwner:
    wire: [u8]
    wire_start: u64
    fragmented: [u8]
    fragmented_opcode: u8
    fragment_count: i32
    utf8_remaining: i32
    utf8_next_min: u8
    utf8_next_max: u8
    terminal: bool
    failed: bool

    static fn create() -> Rfc6455ServerConnectionOwner:
        Rfc6455ServerConnectionOwner(wire: [], fragmented: [],
            wire_start: 0u64, fragmented_opcode: 0u8,
            fragment_count: 0,
            utf8_remaining: 0, utf8_next_min: 0x80u8,
            utf8_next_max: 0xBFu8,
            terminal: false, failed: false)

    me _reset_utf8_state():
        self.utf8_remaining = 0
        self.utf8_next_min = 0x80u8
        self.utf8_next_max = 0xBFu8

    me _accept_text_fragment(payload: [u8], final_fragment: bool) -> bool:
        # RFC 6455 applies UTF-8 validity to the complete text message, whose
        # code points may cross frame boundaries.  Keep the decoder state on
        # the connection so every payload byte is inspected exactly once.
        for byte in payload:
            if self.utf8_remaining > 0:
                if byte < self.utf8_next_min or byte > self.utf8_next_max:
                    return false
                self.utf8_remaining = self.utf8_remaining - 1
                self.utf8_next_min = 0x80u8
                self.utf8_next_max = 0xBFu8
            elif byte <= 0x7Fu8:
                pass
            elif byte >= 0xC2u8 and byte <= 0xDFu8:
                self.utf8_remaining = 1
                self.utf8_next_min = 0x80u8
                self.utf8_next_max = 0xBFu8
            elif byte == 0xE0u8:
                self.utf8_remaining = 2
                self.utf8_next_min = 0xA0u8
                self.utf8_next_max = 0xBFu8
            elif byte >= 0xE1u8 and byte <= 0xECu8:
                self.utf8_remaining = 2
                self.utf8_next_min = 0x80u8
                self.utf8_next_max = 0xBFu8
            elif byte == 0xEDu8:
                self.utf8_remaining = 2
                self.utf8_next_min = 0x80u8
                self.utf8_next_max = 0x9Fu8
            elif byte >= 0xEEu8 and byte <= 0xEFu8:
                self.utf8_remaining = 2
                self.utf8_next_min = 0x80u8
                self.utf8_next_max = 0xBFu8
            elif byte == 0xF0u8:
                self.utf8_remaining = 3
                self.utf8_next_min = 0x90u8
                self.utf8_next_max = 0xBFu8
            elif byte >= 0xF1u8 and byte <= 0xF3u8:
                self.utf8_remaining = 3
                self.utf8_next_min = 0x80u8
                self.utf8_next_max = 0xBFu8
            elif byte == 0xF4u8:
                self.utf8_remaining = 3
                self.utf8_next_min = 0x80u8
                self.utf8_next_max = 0x8Fu8
            else:
                return false
        not final_fragment or self.utf8_remaining == 0

    me _fail(code: i64, message: text) -> Rfc6455ServerEvent:
        self.failed = true
        self.terminal = true
        self.wire = []
        self.wire_start = 0u64
        self.fragmented = []
        self.fragmented_opcode = 0u8
        self.fragment_count = 0
        self._reset_utf8_state()
        _event(Rfc6455ServerEventKind.ProtocolClose, [],
            _server_frame(8u8, _close_payload(code)), code, message)

    me _message(opcode: u8, payload: [u8]) -> Rfc6455ServerEvent:
        if opcode == 1u8:
            return _event(Rfc6455ServerEventKind.TextMessage, payload, [], 0, "")
        _event(Rfc6455ServerEventKind.BinaryMessage, payload, [], 0, "")

    me _process(fin: bool, opcode: u8, payload: [u8]) -> Rfc6455ServerEvent:
        if opcode == 8u8:
            if payload.len() == 1u64:
                return self._fail(1002, "close payload cannot contain one byte")
            var code: i64 = 0
            var reason: [u8] = []
            if payload.len() >= 2u64:
                code = (payload[0u64].to_i64() << 8) | payload[1u64].to_i64()
                if not _valid_close_code(code):
                    return self._fail(1002, "invalid close status code")
                reason = payload.slice(2u64, payload.len())
                if validated_utf8_bytes_to_text_linear(reason).is_err():
                    return self._fail(1007, "close reason is not valid UTF-8")
            self.terminal = true
            self.wire = []
            self.wire_start = 0u64
            self.fragmented = []
            self.fragmented_opcode = 0u8
            self.fragment_count = 0
            self._reset_utf8_state()
            return _event(Rfc6455ServerEventKind.PeerClose, payload,
                _server_frame(8u8, payload), code, "")
        if opcode == 9u8:
            return _event(Rfc6455ServerEventKind.Ping, payload,
                _server_frame(10u8, payload), 0, "")
        if opcode == 10u8:
            return _event(Rfc6455ServerEventKind.Pong, payload, [], 0, "")

        if opcode == 0u8:
            if self.fragmented_opcode == 0u8:
                return self._fail(1002, "continuation without fragmented message")
            if self.fragment_count >= RFC6455_MAX_FRAGMENTS:
                return self._fail(1009, "fragment count exceeds 1024")
            if (self.fragmented.len() > RFC6455_MAX_MESSAGE_BYTES or
                payload.len() > RFC6455_MAX_MESSAGE_BYTES - self.fragmented.len()):
                return self._fail(1009, "fragmented message exceeds 65536 bytes")
            if self.fragmented_opcode == 1u8 and
                not self._accept_text_fragment(payload, fin):
                return self._fail(1007, "text message is not valid UTF-8")
            self.fragmented.extend(payload)
            self.fragment_count = self.fragment_count + 1
            if fin:
                val complete = self.fragmented
                val message_opcode = self.fragmented_opcode
                self.fragmented = []
                self.fragmented_opcode = 0u8
                self.fragment_count = 0
                self._reset_utf8_state()
                return self._message(message_opcode, complete)
            return _event(Rfc6455ServerEventKind.FragmentProgress, [], [], 0, "")

        if self.fragmented_opcode != 0u8:
            return self._fail(1002, "new data frame during fragmented message")
        if opcode == 1u8 and not self._accept_text_fragment(payload, fin):
            return self._fail(1007, "text message is not valid UTF-8")
        if fin:
            self._reset_utf8_state()
            return self._message(opcode, payload)
        self.fragmented_opcode = opcode
        self.fragmented = payload
        self.fragment_count = 1
        _event(Rfc6455ServerEventKind.FragmentProgress, [], [], 0, "")

    me _drain_wire() -> [Rfc6455ServerEvent]:
        var events: [Rfc6455ServerEvent] = []
        while (not self.terminal and self.wire.len() >= self.wire_start and
            self.wire.len() - self.wire_start >= 2u64):
            val frame_start = self.wire_start
            val first = self.wire[frame_start]
            val second = self.wire[frame_start + 1u64]
            val fin = (first & 0x80u8) != 0u8
            val rsv = first & 0x70u8
            val opcode = first & 0x0Fu8
            val masked = (second & 0x80u8) != 0u8
            val length_tag = second & 0x7Fu8
            if rsv != 0u8:
                events.push(self._fail(1002, "RSV bits require a negotiated extension"))
                break
            if not (opcode == 0u8 or opcode == 1u8 or opcode == 2u8 or
                opcode == 8u8 or opcode == 9u8 or opcode == 10u8):
                events.push(self._fail(1002, "reserved or unknown opcode"))
                break
            if not masked:
                events.push(self._fail(1002, "client frame must be masked"))
                break

            var header_without_mask: u64 = 2u64
            var payload_length: u64 = length_tag.to_u64()
            if length_tag == 126u8:
                if self.wire.len() - frame_start < 4u64:
                    break
                payload_length = (self.wire[frame_start + 2u64].to_u64() << 8u64) |
                    self.wire[frame_start + 3u64].to_u64()
                header_without_mask = 4u64
                if payload_length < 126u64:
                    events.push(self._fail(1002, "non-canonical 16-bit payload length"))
                    break
            elif length_tag == 127u8:
                if self.wire.len() - frame_start < 10u64:
                    break
                if (self.wire[frame_start + 2u64] & 0x80u8) != 0u8:
                    events.push(self._fail(1002, "63-bit payload length MSB must be zero"))
                    break
                payload_length = 0u64
                var length_index: u64 = 2u64
                while length_index < 10u64:
                    payload_length = (payload_length << 8u64) |
                        self.wire[frame_start + length_index].to_u64()
                    length_index = length_index + 1u64
                header_without_mask = 10u64
                if payload_length < 65536u64:
                    events.push(self._fail(1002, "non-canonical 64-bit payload length"))
                    break

            val control = opcode >= 8u8
            if control and (not fin or payload_length > 125u64):
                events.push(self._fail(1002, "control frame must be final and at most 125 bytes"))
                break
            if payload_length > RFC6455_MAX_MESSAGE_BYTES:
                events.push(self._fail(1009, "frame payload exceeds 65536 bytes"))
                break
            val header_size = header_without_mask + 4u64
            if header_size > RFC6455_MAX_RETAINED_FRAME_BYTES or
                payload_length > RFC6455_MAX_RETAINED_FRAME_BYTES - header_size:
                events.push(self._fail(1009, "frame exceeds retained-byte bound"))
                break

            # Do not act on fragmentation semantics until the complete frame
            # header, including the mandatory client masking key, is present.
            # The payload may still be absent: that is the point at which this
            # preflight can reject without allocating an unmasked copy.
            if self.wire.len() - frame_start < header_size:
                break

            # Admit fragmentation state and cumulative size from the header
            # before waiting for, allocating, or unmasking the payload. The
            # semantic owner repeats these invariants when committing state,
            # but deferring the first check let a peer force a full 64 KiB
            # temporary allocation for a continuation that was already known
            # to exceed the message or fragment-count bound.
            if opcode == 0u8:
                if self.fragmented_opcode == 0u8:
                    events.push(self._fail(
                        1002, "continuation without fragmented message"))
                    break
                if self.fragment_count >= RFC6455_MAX_FRAGMENTS:
                    events.push(self._fail(
                        1009, "fragment count exceeds 1024"))
                    break
                if (self.fragmented.len() > RFC6455_MAX_MESSAGE_BYTES or
                    payload_length > RFC6455_MAX_MESSAGE_BYTES -
                        self.fragmented.len()):
                    events.push(self._fail(
                        1009, "fragmented message exceeds 65536 bytes"))
                    break
            elif (opcode == 1u8 or opcode == 2u8) and
                self.fragmented_opcode != 0u8:
                events.push(self._fail(
                    1002, "new data frame during fragmented message"))
                break
            val total = header_size + payload_length
            if self.wire.len() - frame_start < total:
                break

            val mask_offset = frame_start + header_without_mask
            var payload: [u8] = [0u8; payload_length]
            var payload_index: u64 = 0u64
            var mask_index: u64 = 0u64
            while payload_index < payload_length:
                payload[payload_index] = self.wire[frame_start + header_size + payload_index] ^
                    self.wire[mask_offset + mask_index]
                payload_index = payload_index + 1u64
                mask_index = mask_index + 1u64
                if mask_index == 4u64:
                    mask_index = 0u64
            self.wire_start = frame_start + total
            events.push(self._process(fin, opcode, payload))
        if not self.terminal:
            if self.wire_start == self.wire.len():
                self.wire = []
                self.wire_start = 0u64
            elif self.wire_start > 0u64:
                # Compact at most once per drain, never once per frame.
                self.wire = self.wire.slice(self.wire_start, self.wire.len())
                self.wire_start = 0u64
        events

    me append_tail(input: [u8]) -> [Rfc6455ServerEvent]:
        # Explicit tail-input seam: the future HTTP owner must transfer bytes
        # already read beyond the upgrade header through this same bounded API.
        # Transport reads are capped so both retained bytes and returned event
        # objects remain bounded. Incomplete frames may span calls.
        var events: [Rfc6455ServerEvent] = []
        if self.terminal:
            return events
        if input.len() > RFC6455_MAX_INPUT_CHUNK_BYTES:
            events.push(self._fail(1009, "tail input exceeds 8192-byte call bound"))
            return events
        var input_index: u64 = 0u64
        while input_index < input.len() and not self.terminal:
            if self.wire.len() < self.wire_start:
                events.push(self._fail(1002, "invalid retained-frame cursor"))
                break
            val retained = self.wire.len() - self.wire_start
            if retained > RFC6455_MAX_RETAINED_FRAME_BYTES:
                events.push(self._fail(1009, "retained frame bytes exceed 65550"))
                break
            val capacity = RFC6455_MAX_RETAINED_FRAME_BYTES - retained
            if capacity == 0u64:
                events.push(self._fail(1009, "incomplete frame fills retained-byte bound"))
                break
            val remaining = input.len() - input_index
            val take = if remaining < capacity: remaining else: capacity
            # Append directly from the caller-owned chunk.  Building a slice
            # here allocated and copied every accepted byte into a temporary
            # array before `extend` copied it again into the retained wire
            # buffer.  The indexed loop keeps the same bounded ordering and
            # cursor semantics with one copy and no per-chunk temporary.
            val input_end = input_index + take
            while input_index < input_end:
                self.wire.push(input[input_index])
                input_index = input_index + 1u64
            events.extend(self._drain_wire())
            if events.len() > RFC6455_MAX_EVENTS_PER_APPEND:
                events = [self._fail(1009, "event count exceeds per-call bound")]
                return events
        if input.len() == 0u64 and not self.terminal:
            events.extend(self._drain_wire())
        events

    me close_for_policy() -> Rfc6455ServerEvent:
        # 1001 (Going Away) is the bounded server-lifecycle close. It is
        # emitted at most once because every later call observes terminal.
        if self.terminal:
            return _event(Rfc6455ServerEventKind.ProtocolClose, [], [], 0,
                "connection is already terminal")
        self.terminal = true
        self.wire = []
        self.wire_start = 0u64
        self.fragmented = []
        self.fragmented_opcode = 0u8
        self.fragment_count = 0
        self._reset_utf8_state()
        _event(Rfc6455ServerEventKind.ProtocolClose, [],
            _server_frame(8u8, _close_payload(1001)), 1001,
            "server connection policy ended the session")

    fn is_terminal() -> bool: self.terminal
    fn protocol_failed() -> bool: self.failed
    fn retained_wire_bytes() -> u64:
        if self.wire.len() < self.wire_start: 0u64 else: self.wire.len() - self.wire_start
    fn retained_message_bytes() -> u64: self.fragmented.len()

export Rfc6455HandshakeDecision, Rfc6455ServerEventKind, Rfc6455ServerEvent
export Rfc6455ServerConnectionOwner
export validate_rfc6455_server_handshake
