# Package-only coordinator between the ordered inbound H2 control owner and the
# transactional response owner. No response admission may be consumed until
# this coordinator has applied every earlier action from the same feed result.

use os.apps.servers_user.web_h2_control_owner_v1.{WebH2ControlOwnerV1, WebH2ControlFeedStatusV1, WebH2PreparedControlRecordV1, H2OrderedInboundActionV1, H2OrderedInboundActionKindV1}
use os.apps.servers_user.web_h2_response_owner_v1.{WebH2ResponseOwnerV1}
use os.apps.servers_user.web_h2_response_authority_v1.{WebH2ResponseAdmissionReceiptV1}
use os.apps.servers_user.web_h2_request_owner_v1.{WebH2RequestEventV1, WebH2RequestEventKindV1}
use std.http.h2.h2_frame.{H2_ERR_FLOW_CONTROL_ERROR}

pub(package) enum WebH2OrderedApplyStatusV1:
    Applied
    Busy
    ProtocolError

pub(package) class WebH2OrderedApplyResultV1:
    status: WebH2OrderedApplyStatusV1
    blocker: text

pub(package) class WebH2CoordinatorFeedResultV1:
    control_status: WebH2ControlFeedStatusV1
    apply_result: WebH2OrderedApplyResultV1
    response_admissions: [WebH2ResponseAdmissionReceiptV1]
    request_events: [WebH2RequestEventV1]
    settings_ack_required: bool
    peer_goaway: bool
    close_after_error_goaway: bool
    blocker: text

pub(package) class WebH2CoordinatorV1:
    control_owner: WebH2ControlOwnerV1
    response_owner: WebH2ResponseOwnerV1
    pending_actions: [H2OrderedInboundActionV1]
    pending_admissions: [WebH2ResponseAdmissionReceiptV1]
    pending_request_events: [WebH2RequestEventV1]
    pending_settings_ack: bool
    pending_peer_goaway: bool

    pub static fn create(connection_epoch: u64, connection_send_window: i64,
        peer_max_frame_size: i64) -> WebH2CoordinatorV1:
        var response = WebH2ResponseOwnerV1.create(connection_send_window,
            peer_max_frame_size)
        val binding = response.bind_request_owner(connection_epoch)
        WebH2CoordinatorV1(control_owner: WebH2ControlOwnerV1.create_bound(binding),
            response_owner: response, pending_actions: [],
            pending_admissions: [], pending_request_events: [],
            pending_settings_ack: false, pending_peer_goaway: false)

    pub me fn feed_authenticated_plaintext(plaintext: [u8], authenticated: bool) -> WebH2CoordinatorFeedResultV1:
        if self.pending_actions.len() > 0u64:
            return WebH2CoordinatorFeedResultV1(
                control_status: WebH2ControlFeedStatusV1.NeedMore,
                apply_result: WebH2OrderedApplyResultV1(
                status: WebH2OrderedApplyStatusV1.Busy,
                    blocker: "ordered-actions-pending"), response_admissions: [],
                request_events: [], settings_ack_required: false,
                peer_goaway: false, close_after_error_goaway: false,
                blocker: "ordered-actions-pending")
        val control_result = self.control_owner.feed_authenticated_plaintext(
            plaintext, authenticated)
        var applied = _applied_v1()
        if control_result.close_after_error_goaway:
            applied = WebH2OrderedApplyResultV1(
                status: WebH2OrderedApplyStatusV1.ProtocolError,
                blocker: control_result.blocker)
        var action_index: i64 = 0
        while applied.status == WebH2OrderedApplyStatusV1.Applied and action_index < control_result.ordered_actions.len().to_i64():
            applied = apply_ordered_action(self.response_owner,
                control_result.ordered_actions[action_index])
            if applied.status != WebH2OrderedApplyStatusV1.Applied: break
            action_index = action_index + 1
        var admissions: [WebH2ResponseAdmissionReceiptV1] = []
        var request_events: [WebH2RequestEventV1] = []
        var peer_goaway = false
        if applied.status == WebH2OrderedApplyStatusV1.Applied:
            for action in control_result.ordered_actions:
                for admission in action.response_admissions:
                    admissions.push(admission)
                for event in action.request_events: request_events.push(event)
                if action.kind == H2OrderedInboundActionKindV1.PeerGoaway:
                    peer_goaway = true
        elif applied.status == WebH2OrderedApplyStatusV1.Busy:
            self.pending_actions = control_result.ordered_actions.slice(
                action_index.to_u64(), control_result.ordered_actions.len())
            var pending_index = action_index
            while pending_index < control_result.ordered_actions.len().to_i64():
                val action = control_result.ordered_actions[pending_index]
                for admission in action.response_admissions:
                    self.pending_admissions.push(admission)
                for event in action.request_events:
                    self.pending_request_events.push(event)
                if action.kind == H2OrderedInboundActionKindV1.PeerGoaway:
                    self.pending_peer_goaway = true
                pending_index = pending_index + 1
            self.pending_settings_ack = control_result.settings_ack_required
        elif applied.status == WebH2OrderedApplyStatusV1.ProtocolError:
            val retained_error = if control_result.protocol_error_code > 0:
                control_result.protocol_error_code else: H2_ERR_FLOW_CONTROL_ERROR
            _ = self.control_owner.fail_protocol_from_coordinator_v1(
                retained_error,
                self.response_owner.local_goaway_cutoff_v1())
            self.response_owner.cancel()
        WebH2CoordinatorFeedResultV1(control_status: control_result.status,
            apply_result: applied, response_admissions: admissions,
            request_events: request_events,
            settings_ack_required: control_result.settings_ack_required and
                applied.status == WebH2OrderedApplyStatusV1.Applied,
            peer_goaway: peer_goaway,
            close_after_error_goaway: control_result.close_after_error_goaway or
                applied.status == WebH2OrderedApplyStatusV1.ProtocolError,
            blocker: if applied.status == WebH2OrderedApplyStatusV1.Applied:
                control_result.blocker else: applied.blocker)

    pub me fn retry_pending_ordered_actions_v1() -> WebH2CoordinatorFeedResultV1:
        if self.pending_actions.len() == 0u64:
            return WebH2CoordinatorFeedResultV1(
                control_status: WebH2ControlFeedStatusV1.Accepted,
                apply_result: _applied_v1(), response_admissions: [],
                request_events: [], settings_ack_required: false,
                peer_goaway: false, close_after_error_goaway: false,
                blocker: "")
        val applied = apply_ordered_actions_v1(self.response_owner,
            self.pending_actions)
        var admissions: [WebH2ResponseAdmissionReceiptV1] = []
        var request_events: [WebH2RequestEventV1] = []
        var ack_required = false
        var peer_goaway = false
        if applied.status == WebH2OrderedApplyStatusV1.Applied:
            admissions = self.pending_admissions
            request_events = self.pending_request_events
            ack_required = self.pending_settings_ack
            peer_goaway = self.pending_peer_goaway
            self.pending_actions = []
            self.pending_admissions = []
            self.pending_request_events = []
            self.pending_settings_ack = false
            self.pending_peer_goaway = false
        elif applied.status == WebH2OrderedApplyStatusV1.ProtocolError:
            _ = self.control_owner.fail_protocol_from_coordinator_v1(
                H2_ERR_FLOW_CONTROL_ERROR,
                self.response_owner.local_goaway_cutoff_v1())
            self.response_owner.cancel()
            self.pending_actions = []
            self.pending_admissions = []
            self.pending_request_events = []
            self.pending_settings_ack = false
            self.pending_peer_goaway = false
        WebH2CoordinatorFeedResultV1(
            control_status: WebH2ControlFeedStatusV1.Accepted,
            apply_result: applied, response_admissions: admissions,
            request_events: request_events,
            settings_ack_required: ack_required,
            peer_goaway: peer_goaway,
            close_after_error_goaway:
                applied.status == WebH2OrderedApplyStatusV1.ProtocolError,
            blocker: applied.blocker)

    pub me fn prepare_error_goaway_v1() -> WebH2PreparedControlRecordV1:
        self.control_owner.prepare_retained_error_goaway_v1()

    pub me fn abort_error_goaway_v1(token: i64) -> bool:
        self.control_owner.abort_control(token)

    pub me fn commit_error_goaway_v1(token: i64) -> bool:
        self.control_owner.commit_control(token)

    pub me fn fail_application_protocol_v1(error_code: i64) -> bool:
        val retained = self.control_owner.fail_protocol_from_coordinator_v1(
            error_code, self.response_owner.local_goaway_cutoff_v1())
        val _ = self.response_owner.cancel()
        retained

    pub fn must_close_v1() -> bool: self.control_owner.must_close_v1()

fn _applied_v1() -> WebH2OrderedApplyResultV1:
    WebH2OrderedApplyResultV1(status: WebH2OrderedApplyStatusV1.Applied,
        blocker: "")

fn _protocol_error_v1(_owner: WebH2ResponseOwnerV1, blocker: text) -> WebH2OrderedApplyResultV1:
    WebH2OrderedApplyResultV1(
        status: WebH2OrderedApplyStatusV1.ProtocolError, blocker: blocker)

pub(package) fn apply_ordered_action(owner: WebH2ResponseOwnerV1,
    action: H2OrderedInboundActionV1) -> WebH2OrderedApplyResultV1:
    match action.kind:
        case SettingsInitialWindow(new_window, _):
            if owner.response_transaction_pending_v1():
                return WebH2OrderedApplyResultV1(
                    status: WebH2OrderedApplyStatusV1.Busy,
                    blocker: "response-transaction-pending")
            if not owner.apply_peer_settings_initial_window_v1(new_window):
                return _protocol_error_v1(owner,
                    "peer-initial-window-rebase-rejected")
        case ConnectionWindowUpdate(increment):
            if not owner.update_connection_window(increment):
                return _protocol_error_v1(owner,
                    "connection-window-update-rejected")
        case StreamWindowUpdate(stream_id, increment):
            if not owner.apply_stream_window_update_v1(stream_id, increment):
                return _protocol_error_v1(owner,
                    "stream-window-update-rejected")
        case Request:
            for admission in action.response_admissions:
                if not owner.register_admission_flow_v1(admission):
                    return _protocol_error_v1(owner,
                        "response-flow-admission-rejected")
            for event in action.request_events:
                if event.kind == WebH2RequestEventKindV1.Reset:
                    if not owner.revoke_request_stream(event.stream_id):
                        return _protocol_error_v1(owner,
                            "response-stream-revoke-rejected")
            return _applied_v1()
        case Control:
            return _applied_v1()
        case PeerGoaway:
            if not owner.receive_peer_goaway():
                return _protocol_error_v1(owner, "peer-goaway-rejected")
            return _applied_v1()
    _applied_v1()

pub(package) fn apply_ordered_actions_v1(owner: WebH2ResponseOwnerV1,
    actions: [H2OrderedInboundActionV1]) -> WebH2OrderedApplyResultV1:
    for action in actions:
        val applied = apply_ordered_action(owner, action)
        if applied.status != WebH2OrderedApplyStatusV1.Applied:
            return applied
    _applied_v1()

export WebH2OrderedApplyStatusV1, WebH2OrderedApplyResultV1
export apply_ordered_action, apply_ordered_actions_v1
export WebH2CoordinatorV1, WebH2CoordinatorFeedResultV1
