# Transport-neutral TLS application stream for the filesystem-launched web
# service.  The owner deliberately knows nothing about sockets, artifacts,
# provisioning, HTTP, or WebSocket framing.

use os.tls13.application_record_session_v1.{
    Tls13ApplicationRecordSessionV1,
    Tls13ApplicationSessionStatusV1,
    Tls13ApplicationIngressStatusV1,
    Tls13ApplicationIngressV1
}
use os.tls13.server_types.{Tls13ServerContext}
use std.common.net.tls_application_record_stream_v1.{
    TLS_MAX_FRAGMENT_LENGTH_V1,
    TLS_MAX_RX_BUFFER_LENGTH_V1,
    TLS_MAX_SEQUENCE_V1
}
use std.common.crypto.secure_memory.{secure_zero_u8_slots, secure_zero_u8_range}
use std.common.string_core.{bytes_to_text}

pub val WEB_TLS_MAX_RESPONSE_PLAINTEXT_V1: i64 = 65536
pub val WEB_TLS_MAX_INGRESS_WIRE_BYTES_V1: i64 = TLS_MAX_RX_BUFFER_LENGTH_V1
pub val WEB_TLS_MAX_INGRESS_PLAINTEXT_V1: i64 = TLS_MAX_FRAGMENT_LENGTH_V1 * 2

pub enum WebTlsStreamStatusV1:
    Open
    PeerClosed
    LocalCloseRequested
    ClosePending
    LocalClosed
    Closed
    Failed

pub enum WebTlsApplicationProtocolV1:
    Http2
    Http1

pub enum WebTlsSendKindV1:
    None
    Application
    CloseNotify

pub class WebTlsPreparedRecordV1:
    token: i64
    kind: WebTlsSendKindV1
    wire_bytes: [u8]
    final_application_chunk: bool

pub class WebTlsIngressEventV1:
    ingress: Tls13ApplicationIngressV1
    # Frames authenticated before a coalesced close_notify remain one ordered
    # event for the HTTP/WS owner.  This flag applies only to those returned
    # frames; dispatch_stopped applies to all later ingress.
    authenticated_frames_dispatchable: bool
    dispatch_stopped: bool
    reciprocal_close_required: bool

fn _web_tls_empty_ingress_v1(
    status: Tls13ApplicationIngressStatusV1
) -> Tls13ApplicationIngressV1:
    Tls13ApplicationIngressV1(
        plaintext_frames: [],
        remainder_length: 0,
        status: status,
        authenticated_record_count: 0)

fn _web_tls_copy_bytes_v1(source: [u8]) -> [u8]:
    var copied: [u8] = []
    for byte in source:
        copied.push(byte)
    copied

pub class WebTlsStreamOwnerV1:
    inner: Tls13ApplicationRecordSessionV1
    status: WebTlsStreamStatusV1
    response_plaintext: [u8]
    response_offset: u64
    pending_token: i64
    pending_kind: WebTlsSendKindV1
    next_token: i64
    # Public negotiation metadata is retained independently of the handshake
    # context. Traffic keys remain owned only by `inner` and the caller can
    # retire the transient context immediately after construction.
    negotiated_alpn_bytes: [u8]
    protocol: WebTlsApplicationProtocolV1

    pub static fn from_context(
        context: Tls13ServerContext
    ) -> Result<WebTlsStreamOwnerV1, text>:
        # This is the application-protocol commit boundary.  A completed TLS
        # context is not dispatchable merely because it contains traffic keys:
        # WEB owns exactly two handlers, and must reject absent, aliased, or
        # unknown ALPN before constructing an open application stream.
        val h2: [u8] = [104u8, 50u8]
        val h1: [u8] = [104u8, 116u8, 116u8, 112u8, 47u8, 49u8, 46u8, 49u8]
        val protocol = if context.selected_alpn == h2:
            WebTlsApplicationProtocolV1.Http2
        elif context.selected_alpn == h1:
            WebTlsApplicationProtocolV1.Http1
        else:
            return Err("web-tls-alpn-not-dispatchable")
        match Tls13ApplicationRecordSessionV1.from_context(context):
            case Err(reason): Err(reason)
            case Ok(session):
                Ok(WebTlsStreamOwnerV1(
                    inner: session,
                    status: WebTlsStreamStatusV1.Open,
                    response_plaintext: [],
                    response_offset: 0u64,
                    pending_token: 0,
                    pending_kind: WebTlsSendKindV1.None,
                    next_token: 1,
                    negotiated_alpn_bytes: _web_tls_copy_bytes_v1(
                        context.selected_alpn),
                    protocol: protocol))

    me wipe_response():
        val _ = secure_zero_u8_slots(self.response_plaintext)
        self.response_plaintext = []
        self.response_offset = 0u64

    me fail():
        self.wipe_response()
        self.pending_token = 0
        self.pending_kind = WebTlsSendKindV1.None
        self.inner.close()
        self.status = WebTlsStreamStatusV1.Failed

    pub fn can_dispatch() -> bool:
        self.status == WebTlsStreamStatusV1.Open

    pub fn has_pending_send() -> bool:
        self.pending_kind != WebTlsSendKindV1.None

    pub fn has_response_bytes() -> bool:
        self.response_offset < self.response_plaintext.len()

    pub fn response_remaining() -> i64:
        if self.response_offset >= self.response_plaintext.len(): return 0
        (self.response_plaintext.len() - self.response_offset).to_i64()

    pub me fn ingest(wire_bytes: [u8]) -> WebTlsIngressEventV1:
        val dispatch_was_open = self.can_dispatch()
        val local_close_was_pending = (
            self.status == WebTlsStreamStatusV1.ClosePending and
            self.pending_kind == WebTlsSendKindV1.CloseNotify)
        if (self.status == WebTlsStreamStatusV1.Failed or
            self.status == WebTlsStreamStatusV1.Closed or
            self.status == WebTlsStreamStatusV1.PeerClosed or
            wire_bytes.len().to_i64() > WEB_TLS_MAX_INGRESS_WIRE_BYTES_V1):
            if wire_bytes.len().to_i64() > WEB_TLS_MAX_INGRESS_WIRE_BYTES_V1:
                self.fail()
                return WebTlsIngressEventV1(
                    ingress: _web_tls_empty_ingress_v1(
                        Tls13ApplicationIngressStatusV1.Overflow),
                    authenticated_frames_dispatchable: false,
                    dispatch_stopped: true,
                    reciprocal_close_required: false)
            return WebTlsIngressEventV1(
                ingress: _web_tls_empty_ingress_v1(
                    Tls13ApplicationIngressStatusV1.SessionClosed),
                authenticated_frames_dispatchable: false,
                dispatch_stopped: true,
                reciprocal_close_required: false)

        var ingress = self.inner.ingest(wire_bytes)
        var plaintext_bytes: i64 = 0
        for frame in ingress.plaintext_frames:
            plaintext_bytes = plaintext_bytes + frame.len().to_i64()
        if plaintext_bytes > WEB_TLS_MAX_INGRESS_PLAINTEXT_V1:
            val _ = ingress.zeroize_plaintext_frames()
            self.fail()
            return WebTlsIngressEventV1(
                ingress: _web_tls_empty_ingress_v1(
                    Tls13ApplicationIngressStatusV1.Overflow),
                authenticated_frames_dispatchable: false,
                dispatch_stopped: true,
                reciprocal_close_required: false)

        val terminal_error = (
            ingress.status == Tls13ApplicationIngressStatusV1.Malformed or
            ingress.status == Tls13ApplicationIngressStatusV1.Overflow or
            ingress.status == Tls13ApplicationIngressStatusV1.AuthenticationFailed or
            ingress.status == Tls13ApplicationIngressStatusV1.SequenceExhausted or
            ingress.status == Tls13ApplicationIngressStatusV1.UnexpectedContentType)
        if terminal_error:
            val _ = ingress.zeroize_plaintext_frames()
            self.fail()
            return WebTlsIngressEventV1(
                ingress: ingress,
                authenticated_frames_dispatchable: false,
                dispatch_stopped: true,
                reciprocal_close_required: false)

        if ingress.status == Tls13ApplicationIngressStatusV1.CloseNotify:
            if local_close_was_pending:
                # The reciprocal record is already sealed.  Preserve its
                # transaction and let commit_send observe inner Closed.
                self.status = WebTlsStreamStatusV1.ClosePending
            elif self.status == WebTlsStreamStatusV1.LocalClosed:
                self.status = WebTlsStreamStatusV1.Closed
            else:
                self.status = WebTlsStreamStatusV1.PeerClosed
            return WebTlsIngressEventV1(
                ingress: ingress,
                authenticated_frames_dispatchable: (
                    dispatch_was_open and ingress.plaintext_frames.len() > 0u64),
                dispatch_stopped: true,
                reciprocal_close_required: (
                    self.status == WebTlsStreamStatusV1.PeerClosed and
                    not local_close_was_pending))

        WebTlsIngressEventV1(
            ingress: ingress,
            authenticated_frames_dispatchable: (
                dispatch_was_open and ingress.plaintext_frames.len() > 0u64),
            dispatch_stopped: not self.can_dispatch(),
            reciprocal_close_required: false)

    pub me fn begin_application(response: [u8]) -> bool:
        if (self.status != WebTlsStreamStatusV1.Open or
            self.has_pending_send() or self.has_response_bytes() or
            response.len() == 0 or
            response.len().to_i64() > WEB_TLS_MAX_RESPONSE_PLAINTEXT_V1):
            return false
        # Own a copy so later zeroization cannot mutate the HTTP/WS owner's
        # source buffer through an implementation-specific array alias.
        self.response_plaintext = _web_tls_copy_bytes_v1(response)
        self.response_offset = 0u64
        true

    pub me fn request_local_close() -> bool:
        if self.status != WebTlsStreamStatusV1.Open: return false
        self.status = WebTlsStreamStatusV1.LocalCloseRequested
        true

    pub me fn prepare_next() -> WebTlsPreparedRecordV1:
        if self.has_pending_send():
            return WebTlsPreparedRecordV1(
                token: 0, kind: WebTlsSendKindV1.None,
                wire_bytes: [], final_application_chunk: false)

        if self.has_response_bytes():
            if self.next_token >= TLS_MAX_SEQUENCE_V1:
                self.fail()
                return WebTlsPreparedRecordV1(
                    token: 0, kind: WebTlsSendKindV1.None,
                    wire_bytes: [], final_application_chunk: false)
            val remaining = self.response_plaintext.len() - self.response_offset
            val chunk_length = if remaining.to_i64() > TLS_MAX_FRAGMENT_LENGTH_V1:
                TLS_MAX_FRAGMENT_LENGTH_V1.to_u64()
            else:
                remaining
            val final_chunk = chunk_length == remaining
            var chunk = self.response_plaintext.slice(
                self.response_offset, self.response_offset + chunk_length)
            val record = self.inner.seal_application(chunk)
            val _ = secure_zero_u8_slots(chunk)
            if record.len() == 0:
                self.fail()
                return WebTlsPreparedRecordV1(
                    token: 0, kind: WebTlsSendKindV1.None,
                    wire_bytes: [], final_application_chunk: false)
            self.pending_token = self.next_token
            self.next_token = self.next_token + 1
            self.pending_kind = WebTlsSendKindV1.Application
            return WebTlsPreparedRecordV1(
                token: self.pending_token,
                kind: self.pending_kind,
                wire_bytes: record,
                final_application_chunk: final_chunk)

        if (self.status == WebTlsStreamStatusV1.LocalCloseRequested or
            self.status == WebTlsStreamStatusV1.PeerClosed):
            if self.next_token >= TLS_MAX_SEQUENCE_V1:
                self.fail()
                return WebTlsPreparedRecordV1(
                    token: 0, kind: WebTlsSendKindV1.None,
                    wire_bytes: [], final_application_chunk: false)
            val record = self.inner.seal_close_notify()
            if record.len() == 0:
                self.fail()
                return WebTlsPreparedRecordV1(
                    token: 0, kind: WebTlsSendKindV1.None,
                    wire_bytes: [], final_application_chunk: false)
            self.pending_token = self.next_token
            self.next_token = self.next_token + 1
            self.pending_kind = WebTlsSendKindV1.CloseNotify
            self.status = WebTlsStreamStatusV1.ClosePending
            return WebTlsPreparedRecordV1(
                token: self.pending_token,
                kind: self.pending_kind,
                wire_bytes: record,
                final_application_chunk: false)

        WebTlsPreparedRecordV1(
            token: 0, kind: WebTlsSendKindV1.None,
            wire_bytes: [], final_application_chunk: false)

    pub me fn commit_send(token: i64) -> bool:
        if token <= 0 or token != self.pending_token:
            if self.has_pending_send(): self.fail()
            return false
        if self.pending_kind == WebTlsSendKindV1.Application:
            val remaining = self.response_plaintext.len() - self.response_offset
            val committed = if remaining.to_i64() > TLS_MAX_FRAGMENT_LENGTH_V1:
                TLS_MAX_FRAGMENT_LENGTH_V1.to_u64()
            else:
                remaining
            val wipe = secure_zero_u8_range(
                self.response_plaintext, self.response_offset, committed)
            if not wipe.verified():
                self.fail()
                return false
            self.response_offset = self.response_offset + committed
            if self.response_offset == self.response_plaintext.len():
                self.wipe_response()
        elif self.pending_kind == WebTlsSendKindV1.CloseNotify:
            if not self.inner.commit_close_notify_sent():
                self.fail()
                return false
            if self.inner.status == Tls13ApplicationSessionStatusV1.Closed:
                self.status = WebTlsStreamStatusV1.Closed
            else:
                self.status = WebTlsStreamStatusV1.LocalClosed
        else:
            return false
        self.pending_token = 0
        self.pending_kind = WebTlsSendKindV1.None
        true

    pub me fn abort_send(token: i64, sent_byte_count: i64 = 0) -> bool:
        if (token <= 0 or token != self.pending_token or
            sent_byte_count < 0):
            if self.has_pending_send(): self.fail()
            return false
        if self.pending_kind == WebTlsSendKindV1.CloseNotify:
            val _ = self.inner.abort_close_notify_send()
        self.fail()
        true

    pub me fn transport_eof() -> bool:
        if self.status == WebTlsStreamStatusV1.Closed: return true
        self.fail()
        false

    pub fn send_sequence() -> i64: self.inner.server_sequence
    pub fn receive_sequence() -> i64: self.inner.stream.sequence()
    pub fn negotiated_alpn() -> text:
        bytes_to_text(self.negotiated_alpn_bytes)
    pub fn is_http2() -> bool:
        self.protocol == WebTlsApplicationProtocolV1.Http2
    pub fn is_http1() -> bool:
        self.protocol == WebTlsApplicationProtocolV1.Http1
    pub fn retained_response_nonzero_bytes() -> i64:
        var count: i64 = 0
        for byte in self.response_plaintext:
            if byte != 0u8: count = count + 1
        count

export WebTlsStreamOwnerV1, WebTlsStreamStatusV1, WebTlsApplicationProtocolV1
export WebTlsPreparedRecordV1, WebTlsSendKindV1, WebTlsIngressEventV1
export WEB_TLS_MAX_RESPONSE_PLAINTEXT_V1
export WEB_TLS_MAX_INGRESS_WIRE_BYTES_V1, WEB_TLS_MAX_INGRESS_PLAINTEXT_V1
