# Bounded HTTP/2 response owner. The connection/request owner admits a client
# stream before passing its Headers admission event to issue_lease; only the
# owner-issued lease can prepare a response. This module owns no socket, TLS, WEB, or
# ALPN integration.

use std.http.h2.h2_frame.{H2Frame, H2HeadersFrame, H2DataFrame, H2_FLAG_END_HEADERS, H2_FLAG_END_STREAM, H2_DEFAULT_MAX_FRAME_SIZE}
use std.http.h2.h2_hpack.{HpackEntry, hpack_static_table}
use std.http.h2.h2_writer.{h2_write_frame}
use os.apps.servers_user.web_h2_response_authority_v1.{WebH2ResponseOwnerBindingV1, WebH2ResponseAdmissionReceiptV1, WebH2LocalGoawayCutoffV1, WebH2ResponseAuthorityStateV1, web_h2_allocate_response_owner_instance_v1, web_h2_response_authority_new_v1, web_h2_response_authority_bind_v1, web_h2_response_authority_revoke_all_v1, web_h2_response_authority_revoke_stream_v1, web_h2_response_authority_consume_v1, web_h2_response_authority_valid_v1}

pub val WEB_H2_RESPONSE_MAX_STREAMS_V1: i64 = 64
pub val WEB_H2_RESPONSE_MAX_HEADER_FIELDS_V1: i64 = 64
pub val WEB_H2_RESPONSE_MAX_HEADER_LIST_V1: i64 = 32768
pub val WEB_H2_RESPONSE_MAX_HEADER_STRING_V1: i64 = 8192
pub val WEB_H2_RESPONSE_MAX_BODY_V1: i64 = 65536
pub val WEB_H2_RESPONSE_MAX_WIRE_V1: i64 = 131072
pub val WEB_H2_RESPONSE_MAX_WINDOW_V1: i64 = 2147483647
pub val WEB_H2_RESPONSE_MIN_WINDOW_V1: i64 = -2147483648

pub struct WebH2ResponseLeaseV1:
    _connection_epoch: u64
    _owner_instance: u64
    _stream_id: i64
    _stream_generation: u64

pub enum WebH2ResponsePrepareStatusV1:
    Prepared
    InvalidLease
    InvalidHeaders
    FlowBlocked
    Busy
    Closed
    LifecycleError
    Overflow

pub struct WebH2ResponseTransactionV1:
    _connection_epoch: u64
    _owner_instance: u64
    _token: i64
    _stream_generation: u64

pub class WebH2PreparedResponseV1:
    status: WebH2ResponsePrepareStatusV1
    transaction: WebH2ResponseTransactionV1
    stream_id: i64
    wire_bytes: [u8]
    blocker: text

class WebH2ResponseStreamV1:
    stream_id: i64
    generation: u64
    send_window: i64
    response_started: bool
    local_closed: bool
    lease_issued: bool

fn _empty_prepared(status: WebH2ResponsePrepareStatusV1, blocker: text) -> WebH2PreparedResponseV1:
    WebH2PreparedResponseV1(status: status, transaction: WebH2ResponseTransactionV1(
        _connection_epoch: 0u64, _owner_instance: 0u64, _token: 0,
        _stream_generation: 0u64), stream_id: 0,
        wire_bytes: [], blocker: blocker)

fn _append_bytes(target: [u8], source: [u8]) -> [u8]:
    for byte in source: target.push(byte)
    target

fn _expected_lifecycle_nonce(epoch: u64, owner_instance: u64, stream_id: i64, generation: u64) -> u64:
    ((epoch ^ owner_instance ^ stream_id.to_u64() ^ generation ^ (generation >> 17)) | 1u64)

fn _append_hpack_int(target: [u8], value: i64, prefix_bits: i64, prefix_tag: i64) -> [u8]:
    val prefix_max = (1 << prefix_bits) - 1
    if value < prefix_max:
        target.push(prefix_tag | value)
        return target
    target.push(prefix_tag | prefix_max)
    var remaining = value - prefix_max
    while remaining >= 128:
        target.push((remaining % 128) | 128)
        remaining = remaining / 128
    target.push(remaining)
    target

fn _append_raw_string(target: [u8], value: text) -> [u8]:
    # The Huffman bit is deliberately zero. Values are bounded before encoding.
    target = _append_hpack_int(target, value.len().to_i64(), 7, 0)
    for ch in value: target.push(ch.to_u8())
    target

fn _static_exact_index(entry: HpackEntry, table: [HpackEntry]) -> i64:
    var index: i64 = 0
    while index < table.len().to_i64():
        if table[index].name == entry.name and table[index].value == entry.value:
            return index + 1
        index = index + 1
    0

fn _static_name_index(name: text, table: [HpackEntry]) -> i64:
    var index: i64 = 0
    while index < table.len().to_i64():
        if table[index].name == name: return index + 1
        index = index + 1
    0

fn _lowercase_response_name(name: text) -> bool:
    if name.len() == 0u64: return false
    var offset: i64 = 0
    for ch in name:
        val codepoint = ch.to_i64() ?? -1
        if codepoint < 0 or codepoint > 127: return false
        val byte = ch.to_u8()
        if byte >= 65u8 and byte <= 90u8: return false
        val pseudo_colon = offset == 0 and byte == 58u8
        val token = (byte >= 97u8 and byte <= 122u8) or (byte >= 48u8 and byte <= 57u8) or byte == 33u8 or byte == 35u8 or byte == 36u8 or byte == 37u8 or byte == 38u8 or byte == 39u8 or byte == 42u8 or byte == 43u8 or byte == 45u8 or byte == 46u8 or byte == 94u8 or byte == 95u8 or byte == 96u8 or byte == 124u8 or byte == 126u8
        if not pseudo_colon and not token: return false
        offset = offset + 1
    true

fn _valid_response_value(value: text) -> bool:
    for ch in value:
        val codepoint = ch.to_i64() ?? -1
        if codepoint < 0 or codepoint > 127: return false
        val byte = ch.to_u8()
        if byte == 0u8 or byte == 10u8 or byte == 13u8 or byte == 127u8: return false
        if byte < 32u8 and byte != 9u8: return false
    true

fn _valid_status(value: text) -> bool:
    if value.len() != 3u64: return false
    # This one-shot V1 emits final responses only; informational 1xx (and 101)
    # require a multi-response lifecycle that is intentionally not exposed.
    if value[0].to_u8() < 50u8 or value[0].to_u8() > 53u8: return false
    for ch in value:
        val byte = ch.to_u8()
        if byte < 48u8 or byte > 57u8: return false
    true

fn _bounded_decimal(value: text, cap: i64) -> i64:
    if value.len() == 0u64: return -1
    var parsed: i64 = 0
    for ch in value:
        val byte = ch.to_u8()
        if byte < 48u8 or byte > 57u8: return -1
        val digit = (byte - 48u8).to_i64()
        if parsed > (cap - digit) / 10: return -1
        parsed = parsed * 10 + digit
    parsed

fn _response_headers_valid(headers: [HpackEntry], body_len: i64,
    declared_content_length: i64) -> bool:
    if headers.len() == 0u64 or headers.len().to_i64() > WEB_H2_RESPONSE_MAX_HEADER_FIELDS_V1: return false
    var list_size: i64 = 0
    var status_seen = false
    var regular_seen = false
    var content_length_seen = false
    var status_value = ""
    var index: i64 = 0
    for header in headers:
        if header.name.len().to_i64() > WEB_H2_RESPONSE_MAX_HEADER_STRING_V1 or header.value.len().to_i64() > WEB_H2_RESPONSE_MAX_HEADER_STRING_V1: return false
        list_size = list_size + header.name.len().to_i64() + header.value.len().to_i64() + 32
        if list_size > WEB_H2_RESPONSE_MAX_HEADER_LIST_V1: return false
        if not _lowercase_response_name(header.name) or not _valid_response_value(header.value): return false
        if header.name.len() > 0u64 and header.name[0] == ":":
            if regular_seen or header.name != ":status" or status_seen or index != 0: return false
            if not _valid_status(header.value): return false
            status_seen = true
            status_value = header.value
        else:
            regular_seen = true
            if header.name == "connection" or header.name == "proxy-connection" or header.name == "keep-alive" or header.name == "upgrade" or header.name == "transfer-encoding" or header.name == "te": return false
            if header.name == "content-length":
                if (content_length_seen or
                    _bounded_decimal(header.value, WEB_H2_RESPONSE_MAX_BODY_V1) !=
                        declared_content_length): return false
                content_length_seen = true
        index = index + 1
    if (status_value == "204" or status_value == "304") and body_len != 0: return false
    status_seen

fn _encode_response_headers(headers: [HpackEntry]) -> [u8]:
    val table = hpack_static_table().static_entries
    var out: [u8] = []
    for header in headers:
        val exact = _static_exact_index(header, table)
        if exact > 0:
            out = _append_hpack_int(out, exact, 7, 128)
        else:
            # Literal without indexing. Dynamic-table mutation is never emitted.
            val name_index = _static_name_index(header.name, table)
            out = _append_hpack_int(out, name_index, 4, 0)
            if name_index == 0: out = _append_raw_string(out, header.name)
            out = _append_raw_string(out, header.value)
    out

pub class WebH2ResponseOwnerV1:
    streams: [WebH2ResponseStreamV1]
    admitted_stream_ids: [i64]
    connection_epoch: u64
    owner_instance: u64
    authority: WebH2ResponseAuthorityStateV1
    connection_send_window: i64
    peer_max_frame_size: i64
    peer_initial_stream_window: i64
    last_admitted_stream_id: i64
    highest_completed_stream_id: i64
    highest_revoked_stream_id: i64
    next_token: i64
    pending_token: i64
    pending_stream_index: i64
    pending_body_bytes: i64
    pending_end_stream: bool
    pending_wire_bytes: [u8]
    goaway: bool
    cancelled: bool

    pub static fn create(connection_send_window: i64, peer_max_frame_size: i64) -> WebH2ResponseOwnerV1:
        val safe_window = if connection_send_window >= 0 and connection_send_window <= WEB_H2_RESPONSE_MAX_WINDOW_V1: connection_send_window else: 0
        val safe_frame = if peer_max_frame_size >= H2_DEFAULT_MAX_FRAME_SIZE and peer_max_frame_size <= 16777215: peer_max_frame_size else: H2_DEFAULT_MAX_FRAME_SIZE
        val instance = web_h2_allocate_response_owner_instance_v1()
        val authority = web_h2_response_authority_new_v1(instance)
        if instance == 0u64: web_h2_response_authority_revoke_all_v1(authority)
        WebH2ResponseOwnerV1(streams: [], admitted_stream_ids: [], connection_epoch: 0u64,
            owner_instance: instance, authority: authority,
            connection_send_window: safe_window,
            peer_max_frame_size: safe_frame,
            peer_initial_stream_window: 65535, next_token: 1,
            last_admitted_stream_id: 0,
            highest_completed_stream_id: 0,
            highest_revoked_stream_id: 0,
            pending_token: 0, pending_stream_index: -1, pending_body_bytes: 0,
            pending_end_stream: false, pending_wire_bytes: [], goaway: false,
            cancelled: false)

    pub me fn bind_request_owner(connection_epoch: u64) -> WebH2ResponseOwnerBindingV1:
        if not web_h2_response_authority_bind_v1(self.authority, connection_epoch):
            self.terminal_revoke()
            return WebH2ResponseOwnerBindingV1(_connection_epoch: 0u64,
                _response_owner_instance: 0u64, _authority: self.authority)
        self.connection_epoch = connection_epoch
        WebH2ResponseOwnerBindingV1(_connection_epoch: self.connection_epoch,
            _response_owner_instance: self.owner_instance, _authority: self.authority)

    me stream_index(stream_id: i64) -> i64:
        var index: i64 = 0
        while index < self.streams.len().to_i64():
            if self.streams[index].stream_id == stream_id: return index
            index = index + 1
        -1

    me lease_index(lease: WebH2ResponseLeaseV1) -> i64:
        if lease._connection_epoch != self.connection_epoch or lease._owner_instance != self.owner_instance: return -1
        val index = self.stream_index(lease._stream_id)
        if index < 0 or self.streams[index].generation != lease._stream_generation: return -1
        index

    me remove_stream_at(remove_index: i64):
        var retained: [WebH2ResponseStreamV1] = []
        var index: i64 = 0
        while index < self.streams.len().to_i64():
            if index != remove_index: retained.push(self.streams[index])
            index = index + 1
        self.streams = retained

    pub me fn issue_lease(admission: WebH2ResponseAdmissionReceiptV1, initial_send_window: i64) -> WebH2ResponseLeaseV1:
        val invalid = WebH2ResponseLeaseV1(_connection_epoch: 0u64,
            _owner_instance: 0u64, _stream_id: 0, _stream_generation: 0u64)
        if admission._connection_epoch == 0u64 or admission._connection_epoch != self.connection_epoch or admission._response_owner_instance != self.owner_instance: return invalid
        if admission._authority.response_owner_instance != self.owner_instance: return invalid
        val stream_id = admission._stream_id
        if admission._lifecycle_nonce != _expected_lifecycle_nonce(admission._connection_epoch, admission._response_owner_instance, stream_id, admission._stream_generation): return invalid
        if self.stream_index(stream_id) < 0:
            if initial_send_window != self.peer_initial_stream_window: return invalid
            if not self.register_admission_flow_v1(admission): return invalid
        val index = self.stream_index(stream_id)
        if index < 0 or self.streams[index].lease_issued or self.streams[index].generation != admission._stream_generation: return invalid
        self.streams[index].lease_issued = true
        WebH2ResponseLeaseV1(_connection_epoch: self.connection_epoch,
            _owner_instance: self.owner_instance, _stream_id: stream_id,
            _stream_generation: admission._stream_generation)

    pub me fn register_admission_flow_v1(admission: WebH2ResponseAdmissionReceiptV1) -> bool:
        if admission._connection_epoch != self.connection_epoch or admission._response_owner_instance != self.owner_instance: return false
        val stream_id = admission._stream_id
        if admission._lifecycle_nonce != _expected_lifecycle_nonce(admission._connection_epoch, admission._response_owner_instance, stream_id, admission._stream_generation): return false
        if self.stream_index(stream_id) >= 0: return true
        if self.cancelled or self.goaway or stream_id <= 0 or stream_id % 2 == 0 or stream_id <= self.last_admitted_stream_id or self.streams.len().to_i64() >= WEB_H2_RESPONSE_MAX_STREAMS_V1: return false
        if not web_h2_response_authority_consume_v1(self.authority, stream_id):
            # A later same-feed RST may already have synchronously revoked it.
            self.last_admitted_stream_id = stream_id
            self.admitted_stream_ids.push(stream_id)
            return true
        self.last_admitted_stream_id = stream_id
        self.admitted_stream_ids.push(stream_id)
        self.streams.push(WebH2ResponseStreamV1(stream_id: stream_id,
            generation: admission._stream_generation,
            send_window: self.peer_initial_stream_window,
            response_started: false, local_closed: false, lease_issued: false))
        true

    pub me fn prepare_response(lease: WebH2ResponseLeaseV1, headers: [HpackEntry], body: [u8], end_stream: bool) -> WebH2PreparedResponseV1:
        self.prepare_response_owned_v1(lease, headers, body, end_stream,
            body.len().to_i64())

    pub me fn prepare_head_response_v1(lease: WebH2ResponseLeaseV1,
        headers: [HpackEntry], representation_length: i64
    ) -> WebH2PreparedResponseV1:
        if representation_length < 0 or representation_length > WEB_H2_RESPONSE_MAX_BODY_V1:
            return _empty_prepared(WebH2ResponsePrepareStatusV1.Overflow,
                "head-representation-length-cap")
        self.prepare_response_owned_v1(lease, headers, [], true,
            representation_length)

    me prepare_response_owned_v1(lease: WebH2ResponseLeaseV1,
        headers: [HpackEntry], body: [u8], end_stream: bool,
        declared_content_length: i64) -> WebH2PreparedResponseV1:
        if self.cancelled: return _empty_prepared(WebH2ResponsePrepareStatusV1.Closed, "response-owner-cancelled")
        if self.pending_token != 0: return _empty_prepared(WebH2ResponsePrepareStatusV1.Busy, "response-transaction-pending")
        val stream_index = self.lease_index(lease)
        if stream_index < 0: return _empty_prepared(WebH2ResponsePrepareStatusV1.InvalidLease, "invalid-response-lease")
        if not web_h2_response_authority_valid_v1(self.authority, lease._stream_id): return _empty_prepared(WebH2ResponsePrepareStatusV1.InvalidLease, "revoked-response-lease")
        if self.streams[stream_index].local_closed or self.streams[stream_index].response_started: return _empty_prepared(WebH2ResponsePrepareStatusV1.Closed, "response-already-started-or-closed")
        if body.len().to_i64() > WEB_H2_RESPONSE_MAX_BODY_V1: return _empty_prepared(WebH2ResponsePrepareStatusV1.Overflow, "response-body-cap")
        if not end_stream: return _empty_prepared(WebH2ResponsePrepareStatusV1.LifecycleError, "one-shot-response-requires-end-stream")
        if not _response_headers_valid(headers, body.len().to_i64(),
            declared_content_length):
            return _empty_prepared(WebH2ResponsePrepareStatusV1.InvalidHeaders,
                "invalid-response-headers")
        val header_block = _encode_response_headers(headers)
        if header_block.len().to_i64() > self.peer_max_frame_size: return _empty_prepared(WebH2ResponsePrepareStatusV1.Overflow, "response-header-frame-cap")
        val body_len = body.len().to_i64()
        if body_len > self.connection_send_window or body_len > self.streams[stream_index].send_window: return _empty_prepared(WebH2ResponsePrepareStatusV1.FlowBlocked, "response-send-window")
        var wire: [u8] = []
        val headers_flags = H2_FLAG_END_HEADERS | (if end_stream and body_len == 0: H2_FLAG_END_STREAM else: 0)
        wire = _append_bytes(wire, h2_write_frame(H2Frame.Headers(H2HeadersFrame(
            stream_id: lease._stream_id, flags: headers_flags,
            header_block: header_block))))
        var offset: i64 = 0
        while offset < body_len:
            val remaining = body_len - offset
            val chunk_len = if remaining < self.peer_max_frame_size: remaining else: self.peer_max_frame_size
            var chunk: [u8] = []
            var chunk_offset: i64 = 0
            while chunk_offset < chunk_len:
                chunk.push(body[offset + chunk_offset])
                chunk_offset = chunk_offset + 1
            val data_flags = if end_stream and offset + chunk_len == body_len: H2_FLAG_END_STREAM else: 0
            wire = _append_bytes(wire, h2_write_frame(H2Frame.Data(H2DataFrame(
                stream_id: lease._stream_id, flags: data_flags, data: chunk))))
            offset = offset + chunk_len
        if wire.len().to_i64() > WEB_H2_RESPONSE_MAX_WIRE_V1: return _empty_prepared(WebH2ResponsePrepareStatusV1.Overflow, "response-wire-cap")
        self.pending_token = self.next_token
        self.next_token = self.next_token + 1
        self.pending_stream_index = stream_index
        self.pending_body_bytes = body_len
        self.pending_end_stream = end_stream
        self.pending_wire_bytes = wire
        WebH2PreparedResponseV1(status: WebH2ResponsePrepareStatusV1.Prepared,
            transaction: WebH2ResponseTransactionV1(
                _connection_epoch: self.connection_epoch, _token: self.pending_token,
                _stream_generation: lease._stream_generation,
                _owner_instance: self.owner_instance), stream_id: lease._stream_id,
            wire_bytes: self.pending_wire_bytes, blocker: "")

    pub me fn commit_response(transaction: WebH2ResponseTransactionV1) -> bool:
        if transaction._connection_epoch != self.connection_epoch or transaction._owner_instance != self.owner_instance or transaction._token <= 0 or transaction._token != self.pending_token or self.pending_stream_index < 0: return false
        val index = self.pending_stream_index
        if not web_h2_response_authority_valid_v1(self.authority, self.streams[index].stream_id):
            self.terminal_revoke()
            return false
        if self.streams[index].generation != transaction._stream_generation: return false
        self.connection_send_window = self.connection_send_window - self.pending_body_bytes
        self.streams[index].send_window = self.streams[index].send_window - self.pending_body_bytes
        self.streams[index].response_started = true
        if self.pending_end_stream: self.streams[index].local_closed = true
        if self.pending_end_stream and self.streams[index].stream_id > self.highest_completed_stream_id:
            self.highest_completed_stream_id = self.streams[index].stream_id
        self.clear_pending()
        self.remove_stream_at(index)
        true

    pub me fn abort_response(transaction: WebH2ResponseTransactionV1) -> bool:
        if transaction._connection_epoch != self.connection_epoch or transaction._owner_instance != self.owner_instance or transaction._token <= 0 or transaction._token != self.pending_token or self.pending_stream_index < 0: return false
        if self.streams[self.pending_stream_index].generation != transaction._stream_generation: return false
        if not web_h2_response_authority_valid_v1(self.authority,
            self.streams[self.pending_stream_index].stream_id):
            self.terminal_revoke()
            return false
        self.clear_pending()
        true

    me clear_pending():
        self.pending_token = 0
        self.pending_stream_index = -1
        self.pending_body_bytes = 0
        self.pending_end_stream = false
        self.pending_wire_bytes = []

    me terminal_revoke():
        web_h2_response_authority_revoke_all_v1(self.authority)
        self.cancelled = true
        self.goaway = true
        self.clear_pending()
        self.streams = []

    pub me fn update_connection_window(increment: i64) -> bool:
        if self.cancelled or not web_h2_response_authority_valid_v1(self.authority, 0) or increment <= 0 or self.connection_send_window > WEB_H2_RESPONSE_MAX_WINDOW_V1 - increment: return false
        self.connection_send_window = self.connection_send_window + increment
        true

    pub me fn update_stream_window(lease: WebH2ResponseLeaseV1, increment: i64) -> bool:
        val index = self.lease_index(lease)
        if index < 0 or not web_h2_response_authority_valid_v1(self.authority, lease._stream_id) or increment <= 0 or self.streams[index].send_window > WEB_H2_RESPONSE_MAX_WINDOW_V1 - increment: return false
        self.streams[index].send_window = self.streams[index].send_window + increment
        true

    pub me fn apply_stream_window_update_v1(stream_id: i64, increment: i64) -> bool:
        if self.cancelled or increment <= 0: return false
        val index = self.stream_index(stream_id)
        if index < 0:
            for admitted_id in self.admitted_stream_ids:
                if admitted_id == stream_id: return true
            return false
        if not web_h2_response_authority_valid_v1(self.authority, stream_id): return false
        if self.streams[index].send_window > WEB_H2_RESPONSE_MAX_WINDOW_V1 - increment: return false
        self.streams[index].send_window = self.streams[index].send_window + increment
        true

    pub me fn apply_peer_settings_initial_window_v1(new_window: i64) -> bool:
        # RFC 9113 section 6.9.2 applies the signed delta to every active
        # stream. Preflight every stream so rejection leaves all state intact.
        if self.cancelled or self.pending_token != 0 or new_window < 0 or new_window > WEB_H2_RESPONSE_MAX_WINDOW_V1: return false
        val delta = new_window - self.peer_initial_stream_window
        for stream in self.streams:
            if delta > 0 and stream.send_window > WEB_H2_RESPONSE_MAX_WINDOW_V1 - delta: return false
            if delta < 0 and stream.send_window < WEB_H2_RESPONSE_MIN_WINDOW_V1 - delta: return false
        var index: i64 = 0
        while index < self.streams.len().to_i64():
            self.streams[index].send_window = self.streams[index].send_window + delta
            index = index + 1
        self.peer_initial_stream_window = new_window
        true

    pub me fn cancel_stream(stream_id: i64) -> bool:
        val index = self.stream_index(stream_id)
        if index < 0: return false
        web_h2_response_authority_revoke_stream_v1(self.authority, stream_id)
        # Revocation during a prepared write fails the entire response owner
        # closed so the escaped record can never be committed or followed.
        if self.pending_stream_index == index:
            self.terminal_revoke()
            return true
        self.remove_stream_at(index)
        true

    pub me fn revoke_request_stream(stream_id: i64) -> bool:
        if stream_id <= 0 or stream_id % 2 == 0: return false
        if stream_id > self.highest_revoked_stream_id: self.highest_revoked_stream_id = stream_id
        web_h2_response_authority_revoke_stream_v1(self.authority, stream_id)
        val index = self.stream_index(stream_id)
        if index < 0: return true
        if self.pending_stream_index == index:
            self.terminal_revoke()
            return true
        self.remove_stream_at(index)
        true

    pub me fn receive_peer_goaway() -> bool:
        self.goaway = true
        # A peer GOAWAY last-stream-id concerns locally initiated streams. This
        # server V1 never initiates streams, so admitted odd request streams stay.
        true

    pub me fn cancel() -> bool:
        self.terminal_revoke()
        true

    pub fn connection_send_credit() -> i64:
        if self.cancelled or not web_h2_response_authority_valid_v1(self.authority, 0): return -1
        self.connection_send_window
    pub fn stream_send_credit(lease: WebH2ResponseLeaseV1) -> i64:
        val index = self.lease_index(lease)
        if index < 0 or not web_h2_response_authority_valid_v1(self.authority, lease._stream_id): return -1
        self.streams[index].send_window
    pub fn highest_completed_stream() -> i64: self.highest_completed_stream_id
    pub fn response_transaction_pending_v1() -> bool: self.pending_token != 0
    pub fn local_goaway_cutoff_v1() -> WebH2LocalGoawayCutoffV1:
        WebH2LocalGoawayCutoffV1(_connection_epoch: self.connection_epoch,
            _response_owner_instance: self.owner_instance,
            _highest_completed_stream_id: self.highest_completed_stream_id)

export WebH2ResponseOwnerV1, WebH2ResponseLeaseV1
export WebH2ResponsePrepareStatusV1, WebH2PreparedResponseV1, WebH2ResponseTransactionV1
export WEB_H2_RESPONSE_MAX_STREAMS_V1, WEB_H2_RESPONSE_MAX_HEADER_FIELDS_V1
export WEB_H2_RESPONSE_MAX_HEADER_LIST_V1, WEB_H2_RESPONSE_MAX_HEADER_STRING_V1
export WEB_H2_RESPONSE_MAX_BODY_V1, WEB_H2_RESPONSE_MAX_WIRE_V1
export WEB_H2_RESPONSE_MAX_WINDOW_V1, WEB_H2_RESPONSE_MIN_WINDOW_V1
