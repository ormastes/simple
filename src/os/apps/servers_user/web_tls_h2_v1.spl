# Bounded HTTP/2 production loop for the filesystem-launched WEB service.
# The socket carries TLS wire bytes only. The H2 coordinator consumes only
# authenticated application plaintext and all outbound H2 state commits after
# the enclosing TLS send transaction commits.

use os.userlib.net.{Socket, socket_recv, socket_send_range}
use std.fs_driver.bytes_util.{text_to_bytes_pure}
use std.http.h2.h2_frame.{H2_ERR_NO_ERROR, H2_ERR_PROTOCOL_ERROR}
use std.http.h2.h2_hpack.{HpackEntry}
use os.apps.servers_user.web_tls_stream_owner.{WebTlsStreamOwnerV1, WebTlsSendKindV1}
use os.apps.servers_user.web_h2_control_owner_v1.{WebH2ControlSendKindV1, WebH2PreparedControlRecordV1}
use os.apps.servers_user.web_h2_request_owner_v1.{WebH2RequestEventKindV1}
use os.apps.servers_user.web_h2_response_owner_v1.{WebH2ResponseLeaseV1, WebH2ResponsePrepareStatusV1, WebH2PreparedResponseV1}
use os.apps.servers_user.web_h2_coordinator_v1.{WebH2CoordinatorV1, WebH2CoordinatorFeedResultV1, WebH2OrderedApplyStatusV1}

pub val WEB_TLS_H2_MAX_RECORD_READS_V1: i32 = 400
pub val WEB_TLS_H2_SOCKET_READ_BYTES_V1: u64 = 8192u64

class WebTlsH2PendingRequestV1:
    stream_id: i64
    method: text
    path: text
    lease: WebH2ResponseLeaseV1
    ended: bool

fn _h2_header_value_v1(headers: [HpackEntry], name: text) -> text:
    for header in headers:
        if header.name == name: return header.value
    ""

fn _h2_tls_send_application_v1(
    socket: Socket, stream: WebTlsStreamOwnerV1, plaintext: [u8]
) -> bool:
    if plaintext.len() == 0u64 or not stream.begin_application(plaintext):
        return false
    while stream.has_response_bytes() or stream.has_pending_send():
        val prepared = stream.prepare_next()
        if prepared.kind != WebTlsSendKindV1.Application: return false
        var sent: u64 = 0u64
        while sent < prepared.wire_bytes.len():
            match socket_send_range(socket, prepared.wire_bytes, sent, 4096u64):
                case Err(_):
                    val _ = stream.abort_send(prepared.token, sent.to_i64())
                    return false
                case Ok(progress):
                    if progress.0 == 0u64:
                        val _ = stream.abort_send(prepared.token, sent.to_i64())
                        return false
                    sent = sent + progress.0
        if not stream.commit_send(prepared.token): return false
    true

fn _h2_tls_send_close_v1(
    socket: Socket, stream: WebTlsStreamOwnerV1, reciprocal: bool = false
) -> bool:
    if not reciprocal and not stream.request_local_close(): return false
    val prepared = stream.prepare_next()
    if prepared.kind != WebTlsSendKindV1.CloseNotify: return false
    var sent: u64 = 0u64
    while sent < prepared.wire_bytes.len():
        match socket_send_range(socket, prepared.wire_bytes, sent, 4096u64):
            case Err(_):
                val _ = stream.abort_send(prepared.token, sent.to_i64())
                return false
            case Ok(progress):
                if progress.0 == 0u64:
                    val _ = stream.abort_send(prepared.token, sent.to_i64())
                    return false
                sent = sent + progress.0
    stream.commit_send(prepared.token)

fn _h2_send_control_v1(socket: Socket, stream: WebTlsStreamOwnerV1,
    coordinator: WebH2CoordinatorV1,
    prepared: WebH2PreparedControlRecordV1) -> bool:
    if prepared.kind == WebH2ControlSendKindV1.None: return false
    if not _h2_tls_send_application_v1(socket, stream, prepared.wire_bytes):
        val _ = coordinator.control_owner.abort_control(prepared.token)
        return false
    if not coordinator.control_owner.commit_control(prepared.token):
        val _ = coordinator.response_owner.cancel()
        val _ = stream.transport_eof()
        return false
    true

fn _h2_send_response_v1(socket: Socket, stream: WebTlsStreamOwnerV1,
    coordinator: WebH2CoordinatorV1,
    prepared: WebH2PreparedResponseV1) -> bool:
    if prepared.status != WebH2ResponsePrepareStatusV1.Prepared: return false
    if not _h2_tls_send_application_v1(socket, stream, prepared.wire_bytes):
        val _ = coordinator.response_owner.abort_response(prepared.transaction)
        return false
    if not coordinator.response_owner.commit_response(prepared.transaction):
        val _ = coordinator.response_owner.cancel()
        val _ = stream.transport_eof()
        return false
    true

fn _h2_drain_control_debt_v1(socket: Socket, stream: WebTlsStreamOwnerV1,
    coordinator: WebH2CoordinatorV1) -> bool:
    while true:
        val ack = coordinator.control_owner.prepare_settings_ack()
        if ack.kind == WebH2ControlSendKindV1.None: break
        if not _h2_send_control_v1(socket, stream, coordinator, ack): return false
    while coordinator.control_owner.ping_ack_debt_count() > 0:
        val ack = coordinator.control_owner.prepare_ping_ack()
        if not _h2_send_control_v1(socket, stream, coordinator, ack): return false
    true

fn _h2_response_headers_v1(status: text, body_length: i64,
    _head_only: bool) -> [HpackEntry]:
    var headers = [HpackEntry(name: ":status", value: status),
        HpackEntry(name: "content-type", value: "text/html; charset=utf-8")]
    headers.push(HpackEntry(name: "content-length",
        value: body_length.to_text()))
    headers

fn _h2_prepare_static_response_v1(coordinator: WebH2CoordinatorV1,
    request: WebTlsH2PendingRequestV1,
    static_asset: [u8]) -> WebH2PreparedResponseV1:
    val head_only = request.method == "HEAD"
    val found = (request.method == "GET" or head_only) and
        (request.path == "/" or request.path == "/SERVER.HTM")
    val status = if found: "200" else: "404"
    val selected_body = if found:
        static_asset
    else:
        text_to_bytes_pure("ERR route not found\n")
    val body: [u8] = if head_only: [] else: selected_body
    val headers = _h2_response_headers_v1(
        status, selected_body.len().to_i64(), head_only)
    if head_only:
        return coordinator.response_owner.prepare_head_response_v1(
            request.lease, headers, selected_body.len().to_i64())
    coordinator.response_owner.prepare_response(
        request.lease, headers, body, true)

fn _h2_remove_request_v1(requests: [WebTlsH2PendingRequestV1],
    stream_id: i64) -> [WebTlsH2PendingRequestV1]:
    var retained: [WebTlsH2PendingRequestV1] = []
    for request in requests:
        if request.stream_id != stream_id: retained.push(request)
    retained

fn _h2_apply_requests_v1(coordinator: WebH2CoordinatorV1,
    result: WebH2CoordinatorFeedResultV1,
    requests: [WebTlsH2PendingRequestV1]
) -> (bool, [WebTlsH2PendingRequestV1]):
    var retained = requests
    var admission_index: i64 = 0
    var reset_streams: [i64] = []
    for event in result.request_events:
        if event.kind == WebH2RequestEventKindV1.Reset:
            reset_streams.push(event.stream_id)
    for event in result.request_events:
        if event.kind == WebH2RequestEventKindV1.Headers:
            if admission_index >= result.response_admissions.len().to_i64():
                val _ = coordinator.response_owner.cancel()
                return (false, [])
            val lease = coordinator.response_owner.issue_lease(
                result.response_admissions[admission_index],
                coordinator.control_owner.negotiated_peer_initial_stream_window())
            admission_index = admission_index + 1
            if coordinator.response_owner.stream_send_credit(lease) >= 0:
                retained.push(WebTlsH2PendingRequestV1(
                    stream_id: event.stream_id,
                    method: _h2_header_value_v1(event.headers, ":method"),
                    path: _h2_header_value_v1(event.headers, ":path"),
                    lease: lease, ended: false))
            else:
                var reset_correlated = false
                for reset_stream in reset_streams:
                    if reset_stream == event.stream_id: reset_correlated = true
                if not reset_correlated: return (false, [])
        elif event.kind == WebH2RequestEventKindV1.EndStream:
            var index: i64 = 0
            while index < retained.len().to_i64():
                if retained[index].stream_id == event.stream_id:
                    retained[index].ended = true
                index = index + 1
        elif event.kind == WebH2RequestEventKindV1.Reset:
            retained = _h2_remove_request_v1(retained, event.stream_id)
        elif event.kind == WebH2RequestEventKindV1.Data:
            pass_do_nothing("bounded request owner accounts static-route body bytes")
    (true, retained)

fn _h2_serve_ready_v1(socket: Socket, stream: WebTlsStreamOwnerV1,
    coordinator: WebH2CoordinatorV1,
    requests: [WebTlsH2PendingRequestV1], static_asset: [u8]
) -> (bool, [WebTlsH2PendingRequestV1]):
    var retained: [WebTlsH2PendingRequestV1] = []
    for request in requests:
        if not request.ended:
            retained.push(request)
            continue
        val prepared = _h2_prepare_static_response_v1(
            coordinator, request, static_asset)
        if prepared.status == WebH2ResponsePrepareStatusV1.FlowBlocked:
            retained.push(request)
        elif prepared.status != WebH2ResponsePrepareStatusV1.Prepared:
            val _ = coordinator.response_owner.cancel()
            return (false, [])
        elif not _h2_send_response_v1(
            socket, stream, coordinator, prepared):
            return (false, [])
    (true, retained)

fn _h2_error_goaway_close_v1(socket: Socket, stream: WebTlsStreamOwnerV1,
    coordinator: WebH2CoordinatorV1) -> bool:
    val prepared = coordinator.prepare_error_goaway_v1()
    if prepared.kind != WebH2ControlSendKindV1.None:
        if not _h2_tls_send_application_v1(socket, stream, prepared.wire_bytes):
            val _ = coordinator.abort_error_goaway_v1(prepared.token)
            return false
        if not coordinator.commit_error_goaway_v1(prepared.token):
            val _ = stream.transport_eof()
            return false
    _h2_tls_send_close_v1(socket, stream)

pub fn web_tls_h2_handle_v1(socket: Socket, stream: WebTlsStreamOwnerV1,
    static_asset: [u8]) -> bool:
    if stream.negotiated_alpn() != "h2": return false
    var coordinator = WebH2CoordinatorV1.create(1u64, 65535, 16384)
    if not _h2_send_control_v1(socket, stream, coordinator,
        coordinator.control_owner.prepare_server_settings()): return false
    var requests: [WebTlsH2PendingRequestV1] = []
    var reads: i32 = 0
    var peer_goaway = false
    while reads < WEB_TLS_H2_MAX_RECORD_READS_V1 and not peer_goaway:
        match socket_recv(socket, WEB_TLS_H2_SOCKET_READ_BYTES_V1):
            case Err(_):
                val _ = coordinator.response_owner.cancel()
                return false
            case Ok(wire):
                if wire.len() == 0u64:
                    val _ = coordinator.response_owner.cancel()
                    return stream.transport_eof()
                var ingress = stream.ingest(wire)
                val peer_tls_close = ingress.reciprocal_close_required
                if (not ingress.authenticated_frames_dispatchable and
                    not peer_tls_close):
                    val _ = ingress.ingress.zeroize_plaintext_frames()
                    val _ = coordinator.response_owner.cancel()
                    return false
                for plaintext in ingress.ingress.plaintext_frames:
                    val result = coordinator.feed_authenticated_plaintext(
                        plaintext, true)
                    if result.close_after_error_goaway or
                        result.apply_result.status == WebH2OrderedApplyStatusV1.ProtocolError:
                        val _ = ingress.ingress.zeroize_plaintext_frames()
                        if peer_tls_close:
                            val _ = coordinator.response_owner.cancel()
                            return _h2_tls_send_close_v1(socket, stream, true)
                        return _h2_error_goaway_close_v1(
                            socket, stream, coordinator)
                    if result.apply_result.status == WebH2OrderedApplyStatusV1.Busy:
                        val _ = ingress.ingress.zeroize_plaintext_frames()
                        if peer_tls_close:
                            val _ = coordinator.response_owner.cancel()
                            return _h2_tls_send_close_v1(socket, stream, true)
                        val _ = coordinator.fail_application_protocol_v1(
                            H2_ERR_PROTOCOL_ERROR)
                        return _h2_error_goaway_close_v1(
                            socket, stream, coordinator)
                    val applied_requests = _h2_apply_requests_v1(
                        coordinator, result, requests)
                    if not applied_requests.0:
                        val _ = ingress.ingress.zeroize_plaintext_frames()
                        if peer_tls_close:
                            val _ = coordinator.response_owner.cancel()
                            return _h2_tls_send_close_v1(socket, stream, true)
                        val _ = coordinator.fail_application_protocol_v1(
                            H2_ERR_PROTOCOL_ERROR)
                        return _h2_error_goaway_close_v1(
                            socket, stream, coordinator)
                    requests = applied_requests.1
                    if peer_tls_close: continue
                    if not _h2_drain_control_debt_v1(
                        socket, stream, coordinator):
                        val _ = ingress.ingress.zeroize_plaintext_frames()
                        return false
                    val served = _h2_serve_ready_v1(
                        socket, stream, coordinator, requests, static_asset)
                    if not served.0:
                        val _ = ingress.ingress.zeroize_plaintext_frames()
                        val _ = coordinator.fail_application_protocol_v1(
                            H2_ERR_PROTOCOL_ERROR)
                        return _h2_error_goaway_close_v1(
                            socket, stream, coordinator)
                    requests = served.1
                    if result.peer_goaway: peer_goaway = true
                val _ = ingress.ingress.zeroize_plaintext_frames()
                if peer_tls_close:
                    val _ = coordinator.response_owner.cancel()
                    return _h2_tls_send_close_v1(socket, stream, true)
        reads = reads + 1
    val goaway = coordinator.control_owner.prepare_local_goaway_v1(
        coordinator.response_owner.local_goaway_cutoff_v1(), H2_ERR_NO_ERROR)
    if goaway.kind == WebH2ControlSendKindV1.None:
        val _ = coordinator.response_owner.cancel()
        return _h2_tls_send_close_v1(socket, stream)
    if not _h2_send_control_v1(socket, stream, coordinator, goaway):
        val _ = coordinator.response_owner.cancel()
        return false
    val _ = coordinator.response_owner.cancel()
    _h2_tls_send_close_v1(socket, stream)

export web_tls_h2_handle_v1
export WEB_TLS_H2_MAX_RECORD_READS_V1, WEB_TLS_H2_SOCKET_READ_BYTES_V1
