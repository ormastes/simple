# Bounded receive-only HTTP/2 request owner. This layer consumes parsed frames;
# it owns HPACK state, the sole CONTINUATION assembly buffer, and client stream
# admission. It deliberately has no response, transport, TLS, or ALPN API.

use std.http.h2.h2_frame.{H2Frame, H2HeadersFrame, H2ContinuationFrame, H2DataFrame, H2RstStreamFrame, H2_FLAG_END_HEADERS, H2_FLAG_END_STREAM}
use std.http.h2.h2_hpack.{HpackEntry, HpackTable, hpack_static_table}
use std.common.string_core.{bytes_to_text}
use std.common.hpack.huffman_h2.{hpack_huffman_decode_bounded}
use os.apps.servers_user.http1_request_frame_owner.{http1_host_authority_is_valid, http1_origin_form_target_is_valid}
use os.apps.servers_user.web_h2_response_authority_v1.{WebH2ResponseOwnerBindingV1, WebH2ResponseAdmissionReceiptV1, WebH2ResponseAuthorityStateV1, web_h2_response_authority_revoke_all_v1}

pub val WEB_H2_MAX_HEADER_BLOCK_V1: i64 = 32768
pub val WEB_H2_MAX_HEADER_LIST_V1: i64 = 65536
pub val WEB_H2_MAX_HEADER_FIELDS_V1: i64 = 100
pub val WEB_H2_MAX_HEADER_STRING_V1: i64 = 8192
pub val WEB_H2_MAX_DYNAMIC_TABLE_V1: i64 = 4096
pub val WEB_H2_MAX_ACTIVE_STREAMS_V1: i64 = 64
pub val WEB_H2_INITIAL_RECEIVE_WINDOW_V1: i64 = 65535
pub val WEB_H2_MAX_DATA_EVENTS_PER_STREAM_V1: i64 = 256

pub enum WebH2RequestEventKindV1:
    Headers
    Data
    EndStream
    Reset

pub class WebH2RequestEventV1:
    kind: WebH2RequestEventKindV1
    stream_id: i64
    headers: [HpackEntry]
    data: [u8]

pub enum WebH2RequestFrameStatusV1:
    Accepted
    NotRequestFrame
    ProtocolError
    CompressionError
    Overflow

pub class WebH2RequestFrameResultV1:
    status: WebH2RequestFrameStatusV1
    events: [WebH2RequestEventV1]
    response_admissions: [WebH2ResponseAdmissionReceiptV1]
    blocker: text

fn _response_lifecycle_nonce(epoch: u64, owner_instance: u64, stream_id: i64, generation: u64) -> u64:
    ((epoch ^ owner_instance ^ stream_id.to_u64() ^ generation ^ (generation >> 17)) | 1u64)

class WebH2RequestStreamV1:
    id: i64
    receive_window: i64
    expected_content_length: i64
    received_content_length: i64
    data_event_count: i64

class WebH2DecodeOkV1:
    headers: [HpackEntry]

enum WebH2DecodeResultV1:
    Ok(WebH2DecodeOkV1)
    Rejected(reason: text)
    Overflow(reason: text)

fn _request_result(status: WebH2RequestFrameStatusV1, blocker: text) -> WebH2RequestFrameResultV1:
    WebH2RequestFrameResultV1(status: status, events: [], response_admissions: [], blocker: blocker)

fn _copy_bytes(source: [u8]) -> [u8]:
    var copied: [u8] = []
    for byte in source: copied.push(byte)
    copied

fn _entry_size(entry: HpackEntry) -> i64:
    entry.name.len().to_i64() + entry.value.len().to_i64() + 32

fn _lowercase_header_name(name: text) -> bool:
    if name.len() == 0u64: return false
    var offset: i64 = 0
    for ch in name:
        val byte = ch.to_u8()
        if byte >= 65u8 and byte <= 90u8: return false
        val pseudo_colon = offset == 0 and byte == 58u8
        val token = (byte >= 97u8 and byte <= 122u8) or (byte >= 48u8 and byte <= 57u8) or byte == 33u8 or byte == 35u8 or byte == 36u8 or byte == 37u8 or byte == 38u8 or byte == 39u8 or byte == 42u8 or byte == 43u8 or byte == 45u8 or byte == 46u8 or byte == 94u8 or byte == 95u8 or byte == 96u8 or byte == 124u8 or byte == 126u8
        if not pseudo_colon and not token: return false
        offset = offset + 1
    true

fn _valid_header_value(value: text) -> bool:
    if value.len() > 0u64:
        val first = value.char_at(0).to_u8()
        val last = value.char_at(value.len().to_i64() - 1).to_u8()
        if first == 32u8 or first == 9u8 or last == 32u8 or last == 9u8:
            return false
    for ch in value:
        val byte = ch.to_u8()
        if byte == 0u8 or byte == 10u8 or byte == 13u8 or byte == 127u8: return false
        if byte < 32u8 and byte != 9u8: return false
    true

fn _valid_method_token(method: text) -> bool:
    if method.len() == 0u64: return false
    for ch in method:
        val byte = ch.to_u8()
        val alpha_numeric = (byte >= 65u8 and byte <= 90u8) or (byte >= 97u8 and byte <= 122u8) or (byte >= 48u8 and byte <= 57u8)
        val punctuation = byte == 33u8 or byte == 35u8 or byte == 36u8 or byte == 37u8 or byte == 38u8 or byte == 39u8 or byte == 42u8 or byte == 43u8 or byte == 45u8 or byte == 46u8 or byte == 94u8 or byte == 95u8 or byte == 96u8 or byte == 124u8 or byte == 126u8
        if not alpha_numeric and not punctuation: return false
    true

fn _valid_scheme_syntax(scheme: text) -> bool:
    if scheme.len() == 0u64: return false
    var index: i64 = 0
    for ch in scheme:
        val byte = ch.to_u8()
        val alpha = (byte >= 65u8 and byte <= 90u8) or (byte >= 97u8 and byte <= 122u8)
        val later = alpha or (byte >= 48u8 and byte <= 57u8) or byte == 43u8 or byte == 45u8 or byte == 46u8
        if (index == 0 and not alpha) or (index > 0 and not later): return false
        index = index + 1
    true

fn _decimal_content_length(value: text) -> i64:
    if value.len() == 0u64: return -1
    var parsed: i64 = 0
    for ch in value:
        val byte = ch.to_u8()
        if byte < 48u8 or byte > 57u8: return -1
        val digit = (byte - 48u8).to_i64()
        if parsed > (WEB_H2_INITIAL_RECEIVE_WINDOW_V1 - digit) / 10: return -1
        parsed = parsed * 10 + digit
    parsed

fn _forbidden_connection_header(name: text, value: text) -> bool:
    if name == "connection" or name == "proxy-connection" or name == "keep-alive" or name == "upgrade" or name == "transfer-encoding": return true
    name == "te" and value != "trailers"

# Extract an already syntax-validated authority's host extent and numeric port.
# A zero default preserves the distinction between an absent CONNECT port and
# every legal explicit port.
fn _authority_parts(authority: text, default_port: i64) -> (i64, i64, bool):
    var host_end = authority.len().to_i64()
    var port_start: i64 = -1
    if authority.starts_with("["):
        val close = authority.index_of("]")
        host_end = close + 1
        if host_end < authority.len().to_i64(): port_start = host_end + 1
    else:
        val colon = authority.index_of(":")
        if colon >= 0:
            host_end = colon
            port_start = colon + 1
    if port_start < 0: return (host_end, default_port, false)
    var port: i64 = 0
    var index = port_start
    while index < authority.len().to_i64():
        port = port * 10 + (authority.char_at(index).to_u8() - 48u8).to_i64()
        index = index + 1
    (host_end, port, true)

# Compare validated ASCII host material without lowercase allocations, and
# compare ports numerically so leading zeroes and scheme defaults do not create
# false routing disagreement.
fn _authority_semantic_equal(left: text, right: text, default_port: i64) -> bool:
    val left_parts = _authority_parts(left, default_port)
    val right_parts = _authority_parts(right, default_port)
    if left_parts.0 != right_parts.0 or left_parts.1 != right_parts.1: return false
    var index: i64 = 0
    while index < left_parts.0:
        var left_byte = left.char_at(index).to_u8()
        var right_byte = right.char_at(index).to_u8()
        if left_byte >= 65u8 and left_byte <= 90u8:
            left_byte = left_byte + 32u8
        if right_byte >= 65u8 and right_byte <= 90u8:
            right_byte = right_byte + 32u8
        if left_byte != right_byte: return false
        index = index + 1
    true

# Decode without ever evaluating an overflowing shift/addition. `cap` is the
# largest value meaningful to the caller, so overlong encodings fail early.
fn _bounded_hpack_int(data: [u8], offset: i64, prefix_bits: i64, cap: i64) -> (i64, i64, text):
    if offset < 0 or offset >= data.len().to_i64(): return (0, 0, "truncated-hpack-integer")
    val max_prefix = (1 << prefix_bits) - 1
    val first = data[offset] & max_prefix
    if first < max_prefix:
        if first > cap: return (0, 0, "hpack-integer-cap")
        return (first, 1, "")
    var value = max_prefix
    var shift: i64 = 0
    var pos = offset + 1
    while pos < data.len().to_i64() and shift <= 28:
        val byte = data[pos]
        val chunk = byte & 0x7f
        if value > cap or chunk > ((cap - value) >> shift): return (0, 0, "hpack-integer-cap")
        value = value + (chunk << shift)
        pos = pos + 1
        if (byte & 0x80) == 0: return (value, pos - offset, "")
        shift = shift + 7
    (0, 0, "invalid-hpack-integer")

pub class WebH2RequestOwnerV1:
    dynamic_entries: [HpackEntry]
    dynamic_size: i64
    dynamic_limit: i64
    active_streams: [WebH2RequestStreamV1]
    completed_streams: [i64]
    admitted_stream_count: i64
    last_client_stream_id: i64
    continuation_stream_id: i64
    continuation_end_stream: bool
    header_block: [u8]
    connection_receive_window: i64
    failed: bool
    connection_epoch: u64
    response_owner_instance: u64
    response_authority: WebH2ResponseAuthorityStateV1?
    next_response_generation: u64

    pub static fn create() -> WebH2RequestOwnerV1:
        WebH2RequestOwnerV1(dynamic_entries: [], dynamic_size: 0,
            dynamic_limit: WEB_H2_MAX_DYNAMIC_TABLE_V1, active_streams: [],
            completed_streams: [], admitted_stream_count: 0,
            last_client_stream_id: 0, continuation_stream_id: 0,
            continuation_end_stream: false, header_block: [],
            connection_receive_window: WEB_H2_INITIAL_RECEIVE_WINDOW_V1,
            failed: false, connection_epoch: 0u64, response_owner_instance: 0u64,
            response_authority: nil, next_response_generation: 1u64)

    pub static fn create_bound(binding: WebH2ResponseOwnerBindingV1) -> WebH2RequestOwnerV1:
        var owner = WebH2RequestOwnerV1.create()
        owner.connection_epoch = binding._connection_epoch
        owner.response_owner_instance = binding._response_owner_instance
        owner.response_authority = Some(binding._authority)
        owner

    me fail():
        if self.response_authority:
            web_h2_response_authority_revoke_all_v1(self.response_authority.value)
        self.failed = true
        self.dynamic_entries = []
        self.dynamic_size = 0
        self.dynamic_limit = WEB_H2_MAX_DYNAMIC_TABLE_V1
        self.active_streams = []
        self.completed_streams = []
        self.continuation_stream_id = 0
        self.header_block = []

    pub me fn cancel():
        self.fail()

    pub fn continuation_open() -> bool: self.continuation_stream_id != 0

    me lookup(index: i64, static_table: HpackTable) -> HpackEntry?:
        if index <= 0: return nil
        if index <= static_table.static_entries.len().to_i64():
            return Some(static_table.static_entries[index - 1])
        val dynamic_index = index - static_table.static_entries.len().to_i64() - 1
        if dynamic_index < 0 or dynamic_index >= self.dynamic_entries.len().to_i64(): return nil
        Some(self.dynamic_entries[dynamic_index])

    me evict_to_limit():
        while self.dynamic_size > self.dynamic_limit and self.dynamic_entries.len() > 0u64:
            val last = self.dynamic_entries.len() - 1u64
            self.dynamic_size = self.dynamic_size - _entry_size(self.dynamic_entries[last])
            self.dynamic_entries = self.dynamic_entries.slice(0u64, last)

    me insert_dynamic(entry: HpackEntry):
        val size = _entry_size(entry)
        if size > self.dynamic_limit:
            self.dynamic_entries = []
            self.dynamic_size = 0
            return
        var next: [HpackEntry] = [entry]
        for prior in self.dynamic_entries: next.push(prior)
        self.dynamic_entries = next
        self.dynamic_size = self.dynamic_size + size
        self.evict_to_limit()

    me decode_string(data: [u8], offset: i64) -> (text, i64, text):
        if offset < 0 or offset >= data.len().to_i64(): return ("", 0, "truncated-hpack-string")
        val decoded = _bounded_hpack_int(data, offset, 7, WEB_H2_MAX_HEADER_STRING_V1)
        if decoded.2 != "": return ("", 0, decoded.2)
        val start = offset + decoded.1
        if start > data.len().to_i64() or decoded.0 > data.len().to_i64() - start: return ("", 0, "truncated-hpack-string")
        if (data[offset] & 0x80) != 0:
            val huffman = hpack_huffman_decode_bounded(data, start, decoded.0, WEB_H2_MAX_HEADER_STRING_V1)
            if not huffman.is_ok(): return ("", 0, huffman.unwrap_err())
            return (bytes_to_text(huffman.unwrap()), decoded.1 + decoded.0, "")
        val bytes = data.slice(start.to_u64(), (start + decoded.0).to_u64())
        (bytes_to_text(bytes), decoded.1 + decoded.0, "")

    me decode_block(data: [u8]) -> WebH2DecodeResultV1:
        val static_table = hpack_static_table()
        var headers: [HpackEntry] = []
        var list_size: i64 = 0
        var pos: i64 = 0
        var allow_size_update = true
        var size_update_count: i64 = 0
        while pos < data.len().to_i64():
            val first = data[pos]
            if (first & 0x20) != 0 and (first & 0xC0) == 0:
                if not allow_size_update: return WebH2DecodeResultV1.Rejected("late-dynamic-table-size-update")
                if size_update_count >= 2: return WebH2DecodeResultV1.Rejected("too-many-dynamic-table-size-updates")
                val update = _bounded_hpack_int(data, pos, 5, WEB_H2_MAX_DYNAMIC_TABLE_V1)
                if update.2 != "": return WebH2DecodeResultV1.Overflow("dynamic-table-cap")
                self.dynamic_limit = update.0
                self.evict_to_limit()
                size_update_count = size_update_count + 1
                pos = pos + update.1
                continue
            allow_size_update = false
            val indexed = (first & 0x80) != 0
            val incremental = (first & 0x40) != 0
            val prefix = if indexed: 7 else: if incremental: 6 else: 4
            val decoded_index = _bounded_hpack_int(data, pos, prefix,
                61 + WEB_H2_MAX_DYNAMIC_TABLE_V1 / 32)
            if decoded_index.2 != "": return WebH2DecodeResultV1.Rejected("invalid-hpack-index")
            pos = pos + decoded_index.1
            if indexed:
                val found = self.lookup(decoded_index.0, static_table)
                if found:
                    val entry = found.value
                    list_size = list_size + _entry_size(entry)
                    if headers.len().to_i64() >= WEB_H2_MAX_HEADER_FIELDS_V1 or list_size > WEB_H2_MAX_HEADER_LIST_V1: return WebH2DecodeResultV1.Overflow("header-list-cap")
                    headers.push(entry)
                else: return WebH2DecodeResultV1.Rejected("invalid-hpack-index")
            else:
                var name = ""
                if decoded_index.0 == 0:
                    val decoded_name = self.decode_string(data, pos)
                    if decoded_name.2 != "": return WebH2DecodeResultV1.Rejected(decoded_name.2)
                    name = decoded_name.0
                    pos = pos + decoded_name.1
                else:
                    val found_name = self.lookup(decoded_index.0, static_table)
                    if found_name: name = found_name.value.name
                    else: return WebH2DecodeResultV1.Rejected("invalid-hpack-name-index")
                val decoded_value = self.decode_string(data, pos)
                if decoded_value.2 != "": return WebH2DecodeResultV1.Rejected(decoded_value.2)
                pos = pos + decoded_value.1
                val entry = HpackEntry(name: name, value: decoded_value.0)
                list_size = list_size + _entry_size(entry)
                if headers.len().to_i64() >= WEB_H2_MAX_HEADER_FIELDS_V1 or list_size > WEB_H2_MAX_HEADER_LIST_V1: return WebH2DecodeResultV1.Overflow("header-list-cap")
                headers.push(entry)
                if incremental: self.insert_dynamic(entry)
        WebH2DecodeResultV1.Ok(WebH2DecodeOkV1(headers: headers))

    me validate_request(headers: [HpackEntry]) -> text:
        var regular_seen = false
        var method = ""
        var scheme = ""
        var path = ""
        var authority = ""
        var method_seen = false
        var scheme_seen = false
        var path_seen = false
        var authority_seen = false
        var content_length_seen = false
        var content_length: i64 = -1
        var host_seen = false
        var host = ""
        for header in headers:
            if not _lowercase_header_name(header.name): return "invalid-header-name"
            if not _valid_header_value(header.value): return "invalid-header-value"
            val pseudo = header.name.len() > 0u64 and header.name[0] == ":"
            if pseudo:
                if regular_seen: return "pseudo-header-after-regular-header"
                if header.name == ":method":
                    if method_seen: return "duplicate-method-pseudo-header"
                    method_seen = true
                    method = header.value
                elif header.name == ":scheme":
                    if scheme_seen: return "duplicate-scheme-pseudo-header"
                    scheme_seen = true
                    scheme = header.value
                elif header.name == ":path":
                    if path_seen: return "duplicate-path-pseudo-header"
                    path_seen = true
                    path = header.value
                elif header.name == ":authority":
                    if authority_seen: return "duplicate-authority-pseudo-header"
                    authority_seen = true
                    authority = header.value
                else: return "invalid-request-pseudo-header"
            else:
                regular_seen = true
                if _forbidden_connection_header(header.name, header.value): return "connection-specific-header"
                if header.name == "host":
                    if host_seen: return "duplicate-host-header"
                    host_seen = true
                    host = header.value
                if header.name == "content-length":
                    val parsed_length = _decimal_content_length(header.value)
                    if parsed_length < 0: return "invalid-content-length"
                    if content_length_seen and parsed_length != content_length: return "conflicting-content-length"
                    content_length_seen = true
                    content_length = parsed_length
        if not method_seen: return "missing-method-pseudo-header"
        if not _valid_method_token(method): return "invalid-method-token"
        if method == "CONNECT":
            if scheme_seen or path_seen: return "invalid-connect-pseudo-header-set"
            if not authority_seen or not http1_host_authority_is_valid(authority):
                return "missing-or-invalid-connect-authority"
            if not _authority_parts(authority, 0).2:
                return "connect-authority-requires-port"
            if host_seen:
                if not http1_host_authority_is_valid(host): return "invalid-host-header"
                if not _authority_semantic_equal(host, authority, 0): return "host-authority-mismatch"
            return "connect-method-not-owned"
        else:
            if not scheme_seen or not _valid_scheme_syntax(scheme) or scheme != "https": return "unsupported-or-invalid-request-scheme"
            if not path_seen: return "missing-request-path"
            if path == "*":
                if method != "OPTIONS": return "asterisk-path-requires-options"
            elif not http1_origin_form_target_is_valid(method, path):
                return "invalid-origin-form-path"
        if authority_seen and not http1_host_authority_is_valid(authority):
            return "missing-or-invalid-authority"
        if host_seen:
            if not http1_host_authority_is_valid(host): return "invalid-host-header"
            val default_port = if scheme == "https": 443 else: if scheme == "http": 80 else: 0
            if authority_seen and not _authority_semantic_equal(host, authority, default_port):
                return "host-authority-mismatch"
        elif not authority_seen:
            return "missing-or-invalid-authority"
        ""

    me request_content_length(headers: [HpackEntry]) -> i64:
        for header in headers:
            if header.name == "content-length": return _decimal_content_length(header.value)
        -1

    me active_index(stream_id: i64) -> i64:
        var i: i64 = 0
        while i < self.active_streams.len().to_i64():
            if self.active_streams[i].id == stream_id: return i
            i = i + 1
        -1

    me close_stream(stream_id: i64):
        val index = self.active_index(stream_id)
        if index < 0: return
        var retained: [WebH2RequestStreamV1] = []
        var i: i64 = 0
        while i < self.active_streams.len().to_i64():
            if i != index: retained.push(self.active_streams[i])
            i = i + 1
        self.active_streams = retained

    me completed_index(stream_id: i64) -> i64:
        var index: i64 = 0
        while index < self.completed_streams.len().to_i64():
            if self.completed_streams[index] == stream_id: return index
            index = index + 1
        -1

    me remember_completed_stream(stream_id: i64):
        if self.completed_index(stream_id) < 0: self.completed_streams.push(stream_id)

    me finish_headers(stream_id: i64, end_stream: bool) -> WebH2RequestFrameResultV1:
        val block = self.header_block
        self.header_block = []
        self.continuation_stream_id = 0
        self.continuation_end_stream = false
        match self.decode_block(block):
            case Rejected(reason):
                self.fail()
                return _request_result(WebH2RequestFrameStatusV1.CompressionError, reason)
            case Overflow(reason):
                self.fail()
                return _request_result(WebH2RequestFrameStatusV1.Overflow, reason)
            case Ok(ok):
                val invalid = self.validate_request(ok.headers)
                if invalid != "":
                    self.fail()
                    return _request_result(WebH2RequestFrameStatusV1.ProtocolError, invalid)
                self.active_streams.push(WebH2RequestStreamV1(
                    id: stream_id,
                    receive_window: WEB_H2_INITIAL_RECEIVE_WINDOW_V1,
                    expected_content_length: self.request_content_length(ok.headers),
                    received_content_length: 0,
                    data_event_count: 0))
                self.admitted_stream_count = self.admitted_stream_count + 1
                self.last_client_stream_id = stream_id
                var response_admissions: [WebH2ResponseAdmissionReceiptV1] = []
                if self.response_authority:
                    if self.next_response_generation == 18446744073709551615u64:
                        self.fail()
                        return _request_result(WebH2RequestFrameStatusV1.Overflow,
                            "response-admission-generation-exhausted")
                    val response_generation = self.next_response_generation
                    self.next_response_generation = self.next_response_generation + 1u64
                    response_admissions.push(WebH2ResponseAdmissionReceiptV1(
                        _connection_epoch: self.connection_epoch,
                        _response_owner_instance: self.response_owner_instance,
                        _stream_id: stream_id,
                        _stream_generation: response_generation,
                        _lifecycle_nonce: _response_lifecycle_nonce(self.connection_epoch,
                            self.response_owner_instance, stream_id, response_generation),
                        _authority: self.response_authority.value))
                var events = [WebH2RequestEventV1(kind: WebH2RequestEventKindV1.Headers, stream_id: stream_id, headers: ok.headers, data: [])]
                if end_stream:
                    val stream_index = self.active_index(stream_id)
                    if self.active_streams[stream_index].expected_content_length > 0:
                        self.fail()
                        return _request_result(WebH2RequestFrameStatusV1.ProtocolError, "content-length-mismatch")
                    events.push(WebH2RequestEventV1(kind: WebH2RequestEventKindV1.EndStream, stream_id: stream_id, headers: [], data: []))
                    self.close_stream(stream_id)
                    self.remember_completed_stream(stream_id)
                return WebH2RequestFrameResultV1(status: WebH2RequestFrameStatusV1.Accepted, events: events, response_admissions: response_admissions, blocker: "")

    pub me fn admit_frame(frame: H2Frame) -> WebH2RequestFrameResultV1:
        if self.failed: return _request_result(WebH2RequestFrameStatusV1.ProtocolError, "h2-request-owner-failed")
        if self.continuation_stream_id != 0:
            match frame:
                case Continuation(cont):
                    if cont.stream_id != self.continuation_stream_id:
                        self.fail()
                        return _request_result(WebH2RequestFrameStatusV1.ProtocolError, "continuation-stream-mismatch")
                    if self.header_block.len().to_i64() + cont.header_block.len().to_i64() > WEB_H2_MAX_HEADER_BLOCK_V1:
                        self.fail()
                        return _request_result(WebH2RequestFrameStatusV1.Overflow, "header-block-cap")
                    for byte in cont.header_block: self.header_block.push(byte)
                    if (cont.flags & H2_FLAG_END_HEADERS) != 0: return self.finish_headers(cont.stream_id, self.continuation_end_stream)
                    return _request_result(WebH2RequestFrameStatusV1.Accepted, "")
                case _:
                    self.fail()
                    return _request_result(WebH2RequestFrameStatusV1.ProtocolError, "expected-exact-continuation")
        match frame:
            case Headers(headers):
                if headers.stream_id <= 0 or headers.stream_id % 2 == 0 or headers.stream_id <= self.last_client_stream_id or self.active_streams.len().to_i64() >= WEB_H2_MAX_ACTIVE_STREAMS_V1 or self.admitted_stream_count >= WEB_H2_MAX_ACTIVE_STREAMS_V1:
                    self.fail()
                    return _request_result(WebH2RequestFrameStatusV1.ProtocolError, "invalid-client-stream-admission")
                if headers.header_block.len().to_i64() > WEB_H2_MAX_HEADER_BLOCK_V1:
                    self.fail()
                    return _request_result(WebH2RequestFrameStatusV1.Overflow, "header-block-cap")
                self.header_block = _copy_bytes(headers.header_block)
                val end_stream = (headers.flags & H2_FLAG_END_STREAM) != 0
                if (headers.flags & H2_FLAG_END_HEADERS) != 0: return self.finish_headers(headers.stream_id, end_stream)
                self.continuation_stream_id = headers.stream_id
                self.continuation_end_stream = end_stream
                return _request_result(WebH2RequestFrameStatusV1.Accepted, "")
            case Data(data):
                val stream_index = self.active_index(data.stream_id)
                if stream_index < 0:
                    self.fail()
                    return _request_result(WebH2RequestFrameStatusV1.ProtocolError, "data-on-inactive-stream")
                val data_len = data.data.len().to_i64()
                if self.active_streams[stream_index].data_event_count >= WEB_H2_MAX_DATA_EVENTS_PER_STREAM_V1:
                    self.fail()
                    return _request_result(WebH2RequestFrameStatusV1.Overflow, "data-event-cap")
                if data_len > self.connection_receive_window or data_len > self.active_streams[stream_index].receive_window:
                    self.fail()
                    return _request_result(WebH2RequestFrameStatusV1.ProtocolError, "receive-flow-control-exhausted")
                self.connection_receive_window = self.connection_receive_window - data_len
                self.active_streams[stream_index].receive_window = self.active_streams[stream_index].receive_window - data_len
                self.active_streams[stream_index].received_content_length = self.active_streams[stream_index].received_content_length + data_len
                self.active_streams[stream_index].data_event_count = self.active_streams[stream_index].data_event_count + 1
                val expected = self.active_streams[stream_index].expected_content_length
                if expected >= 0 and self.active_streams[stream_index].received_content_length > expected:
                    self.fail()
                    return _request_result(WebH2RequestFrameStatusV1.ProtocolError, "content-length-overrun")
                var events = [WebH2RequestEventV1(kind: WebH2RequestEventKindV1.Data, stream_id: data.stream_id, headers: [], data: _copy_bytes(data.data))]
                if (data.flags & H2_FLAG_END_STREAM) != 0:
                    if expected >= 0 and self.active_streams[stream_index].received_content_length != expected:
                        self.fail()
                        return _request_result(WebH2RequestFrameStatusV1.ProtocolError, "content-length-mismatch")
                    events.push(WebH2RequestEventV1(kind: WebH2RequestEventKindV1.EndStream, stream_id: data.stream_id, headers: [], data: []))
                    self.close_stream(data.stream_id)
                    self.remember_completed_stream(data.stream_id)
                return WebH2RequestFrameResultV1(status: WebH2RequestFrameStatusV1.Accepted, events: events, response_admissions: [], blocker: "")
            case RstStream(reset):
                val active = self.active_index(reset.stream_id)
                val completed = self.completed_index(reset.stream_id)
                # A reset for an already closed, previously admitted stream is
                # legal and still must synchronously revoke response authority.
                if active < 0 and completed < 0:
                    self.fail()
                    return _request_result(WebH2RequestFrameStatusV1.ProtocolError, "reset-on-inactive-stream")
                if active >= 0:
                    self.close_stream(reset.stream_id)
                    self.remember_completed_stream(reset.stream_id)
                return WebH2RequestFrameResultV1(status: WebH2RequestFrameStatusV1.Accepted,
                    events: [WebH2RequestEventV1(kind: WebH2RequestEventKindV1.Reset,
                        stream_id: reset.stream_id, headers: [], data: [])],
                    response_admissions: [], blocker: "")
            case Continuation(_):
                self.fail()
                return _request_result(WebH2RequestFrameStatusV1.ProtocolError, "unexpected-continuation")
            case _:
                return _request_result(WebH2RequestFrameStatusV1.NotRequestFrame, "")

export WebH2RequestOwnerV1, WebH2RequestFrameResultV1
export WebH2RequestFrameStatusV1, WebH2RequestEventV1, WebH2RequestEventKindV1
export WEB_H2_MAX_HEADER_BLOCK_V1, WEB_H2_MAX_HEADER_LIST_V1
export WEB_H2_MAX_HEADER_FIELDS_V1, WEB_H2_MAX_HEADER_STRING_V1
export WEB_H2_MAX_DYNAMIC_TABLE_V1, WEB_H2_MAX_ACTIVE_STREAMS_V1
export WEB_H2_INITIAL_RECEIVE_WINDOW_V1
export WEB_H2_MAX_DATA_EVENTS_PER_STREAM_V1
