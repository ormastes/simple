# Dedicated filesystem-launched `/WEB.ELF` entry.
#
# Startup, file authority, endpoint binding, TLS handshake, and application
# record ownership are real and fail closed. Exact negotiated H2 and H1/RFC6455
# handlers consume authenticated TLS plaintext only. There is no no-ALPN
# fallback, plaintext sniff/socket bypass, or H3 claim.

use os.userlib.web_startup.{
    web_startup_admission_consume_v1, web_startup_admission_endpoint_v1
}
use os.userlib.fs.{read_file_bytes_direct_owned}
use os.userlib.net.{IpAddr, SockAddr, Socket, socket, bind, listen, accept}
use os.userlib.syscall_raw.{syscall}
use os.kernel.loader.web_launch_grants.{
    SIMPLEOS_WEB_STATIC_FILE_V1, SIMPLEOS_WEB_TLS_CERTIFICATE_V1,
    SIMPLEOS_WEB_TLS_PRIVATE_KEY_V1
}
use os.apps.web_user.web_tls_provisioning_v1.{
    WebTlsProvisioningOwnerV1, WEB_TLS_MAX_CERTIFICATE_BYTES_V1,
    WEB_TLS_MAX_PRIVATE_KEY_BYTES_V1
}
use os.apps.web_user.web_tls_transport_v1.{
    web_tls_transport_accept_v1, WebTlsTransportAcceptStatusV1
}
use os.apps.web_user.web_tls_http1_v1.{
    web_tls_http1_handle_v1, WEB_TLS_HTTP_MAX_STATIC_ASSET_V1
}
use os.apps.servers_user.web_tls_h2_v1.{web_tls_h2_handle_v1}
use os.tls13.server_types.{Tls13ServerConfig}

fn _web_close_fd_v1(fd: i32):
    val _ = syscall(33u64, fd.to_u64(), 0u64, 0u64, 0u64, 0u64)

fn _web_endpoint_ip_v1(address: u32) -> IpAddr:
    IpAddr(octets: [
        (address and 0xFFu32).to_u8(),
        ((address >> 8u32) and 0xFFu32).to_u8(),
        ((address >> 16u32) and 0xFFu32).to_u8(),
        ((address >> 24u32) and 0xFFu32).to_u8()])

fn _web_bind_exact_v1(address: u32, port: u16) -> Result<Socket, text>:
    if address == 0u32 or port == 0u16: return Err("web-endpoint-invalid")
    val created = socket(2u32, 1u32)?
    match bind(created, SockAddr(ip: _web_endpoint_ip_v1(address), port: port)):
        case Err(reason):
            _web_close_fd_v1(created.fd)
            Err(reason)
        case Ok(_):
            match listen(created, 8):
                case Err(reason):
                    _web_close_fd_v1(created.fd)
                    Err(reason)
                case Ok(_): Ok(created)

fn _web_serve_listener_v1(
    listener: Socket, config: Tls13ServerConfig, static_asset: [u8]
) -> i64:
    # The listener stays owned by the service across peers. Each accepted
    # descriptor is independently handed to the bounded TLS/application path
    # and closed before the next blocking accept. An accept error is terminal
    # for this listener because the userlib accept boundary does not expose a
    # retryable-error classification.
    while true:
        match accept(listener):
            case Err(_): return 4
            case Ok(client):
                var accepted = web_tls_transport_accept_v1(client, config)
                if accepted.status == WebTlsTransportAcceptStatusV1.Accepted:
                    if accepted.stream != nil:
                        var tls_stream = accepted.stream.unwrap()
                        if tls_stream.is_http2():
                            val _ = web_tls_h2_handle_v1(
                                client, tls_stream, static_asset)
                        elif tls_stream.is_http1():
                            val _ = web_tls_http1_handle_v1(
                                client, tls_stream, static_asset)
                        else:
                            val _ = tls_stream.transport_eof()
                        # A peer that did not complete reciprocal close leaves a
                        # directional secret live. Quarantine it before fd close.
                        val _ = tls_stream.transport_eof()
                _web_close_fd_v1(client.fd)

fn main() -> i64:
    val admission = web_startup_admission_consume_v1()
    val endpoint = web_startup_admission_endpoint_v1(admission)
    if endpoint == nil: return 8

    # Every filesystem read is an exact path already present in the WEB pouch.
    # Read the public asset before bind as startup evidence, but never interpret
    # it as certificate/key material or derive another path from network input.
    val static_asset_result = read_file_bytes_direct_owned(
        SIMPLEOS_WEB_STATIC_FILE_V1,
        WEB_TLS_HTTP_MAX_STATIC_ASSET_V1 + 1u64)
    if static_asset_result.is_err(): return 5
    val static_asset = static_asset_result.unwrap()
    if static_asset.len() > WEB_TLS_HTTP_MAX_STATIC_ASSET_V1: return 5
    var provisioning = WebTlsProvisioningOwnerV1.new()
    val certificate = read_file_bytes_direct_owned(
        SIMPLEOS_WEB_TLS_CERTIFICATE_V1,
        WEB_TLS_MAX_CERTIFICATE_BYTES_V1 + 1u64)
    if certificate.is_err(): return 5
    val private_key = read_file_bytes_direct_owned(
        SIMPLEOS_WEB_TLS_PRIVATE_KEY_V1,
        WEB_TLS_MAX_PRIVATE_KEY_BYTES_V1 + 1u64)
    if private_key.is_err():
        # Route the already-owned certificate through the provisioning
        # owner's rejecting path so it is wiped before returning.
        val _ = provisioning.admit(certificate.unwrap(), [])
        return 5

    if not provisioning.admit(certificate.unwrap(), private_key.unwrap()):
        return 5
    val config_result = provisioning.config()
    if config_result.is_err():
        provisioning.quarantine()
        return 5
    val config = config_result.unwrap()

    val projected = endpoint.unwrap()
    val listener = _web_bind_exact_v1(
        projected.bind_ipv4_address, projected.port)
    if listener.is_err():
        provisioning.quarantine()
        return 3
    val owned_listener = listener.unwrap()

    # Listener and provisioning lifetime ends only when the listener loop
    # receives a terminal accept failure (or its supervising owner shuts down).
    val serve_status = _web_serve_listener_v1(
        owned_listener, config, static_asset)
    _web_close_fd_v1(owned_listener.fd)
    provisioning.close()
    serve_status

export _web_bind_exact_v1
