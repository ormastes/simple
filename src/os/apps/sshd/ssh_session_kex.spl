    [
        0x00, 0x00, 0x00, 0x0b, 0x73, 0x73, 0x68, 0x2d,
        0x65, 0x64, 0x32, 0x35, 0x35, 0x31, 0x39, 0x00,
        0x00, 0x00, 0x40, 0x72, 0x17, 0xd3, 0x88, 0xf0,
        0xf3, 0x0d, 0x43, 0x71, 0xd0, 0xe8, 0xf2, 0x9b,
        0x6c, 0xc8, 0x25, 0x9e, 0x14, 0x6b, 0xed, 0x15,
        0x2c, 0xa9, 0x8b, 0xa5, 0xc6, 0x74, 0x76, 0x62,
        0xee, 0x1e, 0xf5, 0x40, 0x5e, 0x01, 0xba, 0x7b,
        0x23, 0x12, 0x2c, 0xbd, 0x08, 0xf6, 0xa3, 0x59,
        0xbb, 0xce, 0x6b, 0x1d, 0x42, 0x59, 0xd4, 0x9f,
        0xe7, 0xf5, 0x1e, 0x01, 0x00, 0x19, 0xcb, 0x78,
        0x69, 0x62, 0x09
    ]

fn _derive_key_live_runtime_sha256(shared_secret: [u8], exchange_hash: [u8], letter: u8, session_id: [u8], needed: u64) -> [u8]:
    var input: [u8] = []
    val shared_secret_mpint = curve25519_shared_secret_mpint_bytes(shared_secret)
    input = _push_mpint_bytes(input, shared_secret_mpint)
    input = _push_bytes(input, exchange_hash)
    input = _append_byte(input, letter)
    input = _push_bytes(input, session_id)
    val k1 = rt_tls13_sha256(input)
    var key_material: [u8] = _push_bytes([], k1)
    while key_material.len() < needed:
        var ext_input: [u8] = []
        ext_input = _push_mpint_bytes(ext_input, shared_secret_mpint)
        ext_input = _push_bytes(ext_input, exchange_hash)
        ext_input = _push_bytes(ext_input, key_material)
        val next = rt_tls13_sha256(ext_input)
        key_material = _push_bytes(key_material, next)
    var result: [u8] = []
    var i: u64 = 0
    while i < needed:
        result = _append_byte(result, ssh_session_u8_at(key_material, i))
        i = i + 1
    result

impl SshSession:

    # Phase 2: Key Exchange

    me do_kex() -> bool:
        """Perform key exchange (curve25519-sha256)."""
        self._do_kex([])

    me do_rekey(client_kexinit: [u8]) -> bool:
        """Complete one peer-initiated rekey while preserving connection state.

        The caller has already authenticated and decrypted client_kexinit with
        the old inbound key.  Rekey owns no channel/authentication state and
        publishes each new directional key only after that direction's
        NEWKEYS boundary.
        """
        if not self.cipher.active or client_kexinit.len() == 0u64:
            return false
        # The freestanding rekey scalar derivation is keyed by this host
        # secret.  Never fall back to peer-only deterministic material.
        if self.host_keys.ed25519_seed == nil:
            return false
        if self.rekey_in_progress or self.rekey_count >= 16u32:
            return false
        self.rekey_in_progress = true
        val completed = self._do_kex(client_kexinit)
        self.rekey_in_progress = false
        if completed:
            self.rekey_count = self.rekey_count + 1u32
        completed

    me _do_kex(preloaded_client_kexinit: [u8]) -> bool:
        """Perform initial KEX or one staged rekey."""
        val was_rekey = self.cipher.active
        val state_before_kex = self.state
        log_info("[app.sshd] " + "[sshd-session] kex start")
        # Send our KEXINIT — advertise algorithms available in our host key set
        val server_kexinit = ssh_build_kexinit_for_host_keys_and_certs(self.host_keys, self.host_certs)
        log_raw_println("[sshd-session] server kexinit len={server_kexinit.len()}")
        self.server_kexinit_payload = server_kexinit
        self.send_packet(server_kexinit)

        # A peer-initiated rekey arrives through the connection dispatcher, so
        # do not consume the following KEX_ECDH_INIT as a second KEXINIT.
        val client_payload =
            if preloaded_client_kexinit.len() > 0u64:
                preloaded_client_kexinit
            else:
                self.recv_packet_payload()
        log_info("[app.sshd] " + "[sshd-session] client kexinit received")
        if client_payload.len() == 0:
            log_info("[app.sshd] " + "[sshd-session] client kexinit missing")
            self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "no KEXINIT received")
            return false
        if ssh_session_u8_at(client_payload, 0) == SSH_MSG_IGNORE or ssh_session_u8_at(client_payload, 0) == SSH_MSG_DEBUG:
            self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "unexpected pre-kex control message")
            return false
        self.client_kexinit_payload = client_payload

        # Parse client KEXINIT. Prefer the structural byte parser on the live
        # path; OpenSSH name-lists can be large enough to trip baremetal text
        # conversion before negotiation.
        val using_live_openssh_profile = true
        serial_println("[sshd-session] using live OpenSSH constrained KEX profile")
        val client_kex = match _parse_kexinit_fast(client_payload):
            Ok(parsed): parsed
            Err(_):
                self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "bad KEXINIT")
                return false
        if client_kex.first_kex_packet_follows:
            # This constrained transport cannot prove that an optimistic guess
            # matches both selected algorithms without retaining the original
            # ordered name-list heads.  Fail closed instead of interpreting a
            # guessed packet under the wrong KEX state.
            self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "optimistic KEX unsupported")
            return false
        val server_kex = match _parse_kexinit_fast(server_kexinit):
            Ok(parsed): parsed
            Err(_):
                self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "bad server KEXINIT")
                return false
        log_info("[app.sshd] " + "[sshd-session] client kexinit parsed")
        log_raw_println("[sshd-session] client kex list={client_kex.kex_algorithms}")
        log_raw_println("[sshd-session] client hostkey list={client_kex.server_host_key_algorithms}")
        log_raw_println("[sshd-session] client enc c2s={client_kex.encryption_client_to_server}")
        log_raw_println("[sshd-session] client mac c2s={client_kex.mac_client_to_server}")

        val algos_early = match ssh_negotiate_algorithms(client_kex, server_kex):
            Ok(negotiated): negotiated
            Err(_):
                self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "no matching KEX algorithms")
                return false
        val strict_kex = ssh_kex_uses_strict_kex(client_kex, server_kex)
        log_info("[app.sshd] " + "[sshd-session] negotiated kex={algos_early.kex} hostkey={algos_early.host_key} c2s={algos_early.cipher_c2s} s2c={algos_early.cipher_s2c}")
        serial_println("[sshd-session] negotiated kex={algos_early.kex} hostkey={algos_early.host_key} c2s={algos_early.cipher_c2s} s2c={algos_early.cipher_s2c}")

        # Receive KEX_ECDH_INIT (client's ephemeral public key)
        val kex_init_payload = self.recv_packet_payload()
        log_raw_println("[sshd-session] client ecdh init received")
        if kex_init_payload.len() == 0:
            log_raw_println("[sshd-session] client ecdh init missing")
            self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "no KEX_ECDH_INIT")
            return false
        if ssh_validate_kex_ecdh_init_payload(kex_init_payload, strict_kex).is_err():
            self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "bad KEX_ECDH_INIT")
            return false
        var client_public: [u8] = []
        if using_live_openssh_profile:
            if kex_init_payload.len() < 37:
                log_raw_println("[sshd-session] client ecdh init live len err len={kex_init_payload.len()}")
                self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "bad KEX_ECDH_INIT")
                return false
            serial_println("[sshd-session] live ecdh key slice start")
            client_public = _slice_range(kex_init_payload, 5, 37)
            serial_println("[sshd-session] live ecdh key slice len={client_public.len()}")
        else:
            val r_client_pub = ssh_parse_kex_ecdh_init(kex_init_payload)
            client_public = match r_client_pub:
                Ok(parsed):
                    parsed
                Err(_):
                    log_raw_println("[sshd-session] client ecdh init parse err")
                    self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "bad KEX_ECDH_INIT")
                    return false
        log_raw_println("[sshd-session] client ecdh pub len={client_public.len()}")
        if not using_live_openssh_profile:
            log_raw_println("[sshd-session] client ecdh pub={_bytes_to_hex(client_public)}")
            serial_println("[sshd-session] client ecdh pub={_bytes_to_hex(client_public)}")

        # Generate our ephemeral keypair without the hosted random runtime path.
        serial_println("[sshd-session] server private generation start")
        val server_private = if was_rekey:
            _derive_session_x25519_private_key(
                self.host_keys.ed25519_seed,
                client_public,
                self.client_kexinit_payload,
                self.rekey_count + 1u32
            )
        elif using_live_openssh_profile:
            _live_bootstrap_x25519_private_key()
        elif client_public.len() == 32:
            _derive_session_x25519_private_key(self.host_keys.ed25519_seed, client_public, self.client_kexinit_payload, 0u32)
        else:
            _live_bootstrap_x25519_private_key()
        serial_println("[sshd-session] server private generation len={server_private.len()}")
        serial_println("[sshd-session] server public generation start")
        val server_public = if using_live_openssh_profile and server_private.len() == 32:
            _rv64_live_x25519_public_alpha(server_private)
        elif server_private.len() == 32:
            x25519_base(server_private)
        else:
            []
        serial_println("[sshd-session] server public generation len={server_public.len()}")
        log_info("[app.sshd] " + "[sshd-session] server ecdh material ready pub_len={server_public.len()}")
        if server_public.len() != 32:
            self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "server X25519 public failed")
            return false
        log_info("[app.sshd] " + "[sshd-session] server ecdh pub len={server_public.len()}")
        if not using_live_openssh_profile:
            log_info("[app.sshd] " + "[sshd-session] server ecdh pub={_bytes_to_hex(server_public)}")

        # Compute shared secret
        serial_println("[sshd-session] shared secret generation start")
        val shared_secret = if using_live_openssh_profile and server_private.len() == 32 and client_public.len() == 32:
            _rv64_live_x25519_shared_alpha(server_private, client_public)
        elif server_private.len() == 32 and client_public.len() == 32:
            x25519(server_private, client_public)
        else:
            []
        serial_println("[sshd-session] shared secret generation len={shared_secret.len()}")
        if shared_secret.len() != 32:
            self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "server X25519 shared failed")
            return false
        log_info("[app.sshd] " + "[sshd-session] shared secret len={shared_secret.len()}")
        # Length is sufficient operational evidence.  Secret bytes must never
        # cross into either the kernel log or the serial diagnostic channel.

        # Resolve negotiated algorithms — needed now for host-key-blob type
        var negotiated_hk_algo = algos_early.host_key

        # Build host key blob for the negotiated algorithm
        var host_key_blob = if self.host_ed25519_public.len() == 32: ssh_build_ed25519_host_key_blob(self.host_ed25519_public) else: _build_live_host_key_blob_for_algo(negotiated_hk_algo, self.host_keys, self.host_certs, self.host_ed25519_public)
        if host_key_blob.len() == 0:
            if self.host_ed25519_public.len() == 32:
                negotiated_hk_algo = "ssh-ed25519"
                host_key_blob = ssh_build_ed25519_host_key_blob(self.host_ed25519_public)
            elif self.host_keys.ed25519_seed != nil:
                val fallback_pubkey = _ed25519_public_key_from_seed(self.host_keys.ed25519_seed)
                if fallback_pubkey.len() == 32:
                    negotiated_hk_algo = "ssh-ed25519"
                    host_key_blob = ssh_build_ed25519_host_key_blob(fallback_pubkey)
        log_info("[app.sshd] " + "[sshd-session] host key algo={negotiated_hk_algo} blob len={host_key_blob.len()}")
        if using_live_openssh_profile:
            serial_println("[sshd-session] host key blob len={host_key_blob.len()}")
        else:
            log_info("[app.sshd] " + "[sshd-session] host key blob={_bytes_to_hex(host_key_blob)}")
            serial_println("[sshd-session] host key blob={_bytes_to_hex(host_key_blob)}")

        # Compute exchange hash.
        # NOTE: on x64 freestanding native-build, storing an extern `[u8]` return
        # (ANY-erased across the C facade) directly into a typed local/var drops
        # the BYTE_PACKED representation and corrupts the handle (same class as
        # the abi_probe P9 if-expr phi-merge bug). Pass the extern return straight
        # through `_copy_bytes_stable` — the proven-safe idiom used throughout —
        # so `exchange_hash` holds a Simple-built packed copy. Verified: with this
        # form the ed25519 signature verifies against a real OpenSSH client.
        serial_println("[sshd-session] exchange hash generation start")
        var exchange_hash = _zeroed_32_bytes()
        if using_live_openssh_profile:
            exchange_hash = _copy_bytes_stable(rt_ssh_curve25519_exchange_hash(
                self.client_version_bytes,
                self.server_version_bytes,
                self.client_kexinit_payload,
                self.server_kexinit_payload,
                host_key_blob,
                client_public,
                server_public,
                shared_secret
            ))
        else:
            exchange_hash = ssh_kex_compute_exchange_hash(
                self.client_version_bytes,
                self.server_version_bytes,
                self.client_kexinit_payload,
                self.server_kexinit_payload,
                host_key_blob,
                client_public,
                server_public,
                shared_secret
            )
        log_info("[app.sshd] " + "[sshd-session] exchange hash len={exchange_hash.len()}")
        if using_live_openssh_profile:
            serial_println("[sshd-session] exchange hash len={exchange_hash.len()}")
            serial_println("[sshd-session] exchange hash={_bytes_to_hex(exchange_hash)}")
        else:
            serial_println("[sshd-session] exchange hash={_bytes_to_hex(exchange_hash)}")

        # Session ID is the first exchange hash
        if self.session_id.len() == 0:
            self.session_id = exchange_hash

        # Sign the exchange hash with the appropriate host key.
        # For Ed25519 on the live lane, use the daemon's stored public key
        # directly so the signature is bound to the exact host key blob we
        # advertised, instead of re-deriving a public key mid-KEX.
        var sig_blob: [u8] = []
        if negotiated_hk_algo == "ssh-ed25519" and self.host_keys.ed25519_seed != nil and self.host_ed25519_public.len() == 32:
            val stable_seed = _copy_bytes_stable(self.host_keys.ed25519_seed)
            val stable_pub = _copy_bytes_stable(self.host_ed25519_public)
            val stable_hash = _copy_bytes_stable(exchange_hash)
            serial_println("[sshd-session] host ed25519 material ready pub_len={stable_pub.len()}")
            serial_println("[sshd-session] host ed25519 sign pure start")
            var sig_raw: [u8] = []
            if using_live_openssh_profile:
                serial_println("[sshd-session] ed25519 alpha runtime start")
                val runtime_sig_result = ed25519_sign_live_runtime_only(stable_seed, stable_pub, stable_hash)
                if runtime_sig_result.is_err():
                    log_info("[app.sshd] [sshd-session] host key runtime signing failed")
                    self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "host key signing failed")
                    return false
                val runtime_sig = runtime_sig_result.unwrap()
                serial_println("[sshd-session] ed25519 alpha runtime done len={runtime_sig.len()}")
                serial_println("[sshd-session] ed25519 alpha pure start")
                val pure_sig = ed25519_sign_live_pure_only(stable_seed, stable_pub, stable_hash)
                serial_println("[sshd-session] ed25519 alpha pure done len={pure_sig.len()}")
                if not dual_backend_bytes_equal(runtime_sig, pure_sig):
                    serial_println("[sshd-session] ed25519 alpha mismatch: using runtime signature")
                    serial_println("[sshd-session] ed25519 alpha runtime sig={_bytes_to_hex(runtime_sig)}")
                    serial_println("[sshd-session] ed25519 alpha pure sig={_bytes_to_hex(pure_sig)}")
                sig_raw = runtime_sig
            else:
                sig_raw = ed25519_sign(stable_seed, stable_pub, stable_hash)
            serial_println("[sshd-session] host ed25519 sign pure len={sig_raw.len()}")
            if using_live_openssh_profile:
                serial_println("[sshd-session] host ed25519 sig raw={_bytes_to_hex(sig_raw)}")
            if sig_raw.len() != 64:
                log_info("[app.sshd] " + "[sshd-session] host key signing err")
                self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "host key signing failed")
                return false
            sig_blob = ssh_put_u32(sig_blob, 11)
            sig_blob.push(0x73)
            sig_blob.push(0x73)
            sig_blob.push(0x68)
            sig_blob.push(0x2D)
            sig_blob.push(0x65)
            sig_blob.push(0x64)
            sig_blob.push(0x32)
            sig_blob.push(0x35)
            sig_blob.push(0x35)
            sig_blob.push(0x31)
            sig_blob.push(0x39)
            sig_blob.push(0x00)
            sig_blob.push(0x00)
            sig_blob.push(0x00)
            sig_blob.push(0x40)
            var sig_i: u64 = 0
            while sig_i < 64 and sig_i < sig_raw.len():
                sig_blob.push(ssh_session_u8_at(sig_raw, sig_i))
                sig_i = sig_i + 1
        else:
            log_info("[app.sshd] " + "[sshd-session] unexpected non-ed25519 host key algo={negotiated_hk_algo}")
            self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "unsupported host key algorithm")
            return false
        log_info("[app.sshd] " + "[sshd-session] sig blob len={sig_blob.len()}")
        if using_live_openssh_profile:
            serial_println("[sshd-session] sig blob len={sig_blob.len()}")
        else:
            serial_println("[sshd-session] sig blob={_bytes_to_hex(sig_blob)}")
        if negotiated_hk_algo == "ssh-ed25519" and not using_live_openssh_profile:
            val sig_pubkey = _extract_ed25519_pubkey(host_key_blob)
            val sig_raw = _unwrap_ssh_signature(sig_blob)
            val sig_verify = if ed25519_verify(sig_pubkey, exchange_hash, sig_raw): 1 else: 0
            log_info("[app.sshd] " + "[sshd-session] sig self-verify rc={sig_verify} pub len={sig_pubkey.len()} raw len={sig_raw.len()}")
            log_info("[app.sshd] " + "[sshd-session] sig self-verify pub={_bytes_to_hex(sig_pubkey)}")
            log_info("[app.sshd] " + "[sshd-session] sig self-verify hash={_bytes_to_hex(exchange_hash)}")
            log_info("[app.sshd] " + "[sshd-session] sig self-verify raw={_bytes_to_hex(sig_raw)}")
            serial_println("[sshd-session] sig self-verify raw={_bytes_to_hex(sig_raw)}")

        # Send KEX_ECDH_REPLY
        val reply = ssh_build_kex_ecdh_reply(host_key_blob, server_public, sig_blob)
        if using_live_openssh_profile:
            self.send_packet(reply)
            serial_println("[sshd-session] kex reply sent")
        else:
            log_info("[app.sshd] " + "[sshd-session] kex reply len={reply.len()}")
            serial_println("[sshd-session] server ecdh pub={_bytes_to_hex(server_public)}")
            serial_println("[sshd-session] kex reply={_bytes_to_hex(reply)}")
            self.send_packet(reply)

        # Send NEWKEYS
        val newkeys = ssh_build_newkeys()
        if using_live_openssh_profile:
            self.send_packet(newkeys)
            serial_println("[sshd-session] newkeys sent")
        else:
            self.send_packet(newkeys)
        if using_live_openssh_profile:
            serial_println("[sshd-session] session_id len={self.session_id.len()}")
        else:
            serial_println("[sshd-session] session_id={_bytes_to_hex(self.session_id)}")
        val keys = ssh_derive_keys(shared_secret, exchange_hash, self.session_id)
        if using_live_openssh_profile:
            serial_println("[sshd-session] derived iv_s2c len={keys.iv_s2c.len()} key_s2c len={keys.enc_key_s2c.len()}")
            val runtime_iv_s2c = _derive_key_live_runtime_sha256(shared_secret, exchange_hash, 0x42, self.session_id, 12)
            val runtime_key_s2c = _derive_key_live_runtime_sha256(shared_secret, exchange_hash, 0x44, self.session_id, 32)
            if not dual_backend_bytes_equal(keys.iv_s2c, runtime_iv_s2c) or not dual_backend_bytes_equal(keys.enc_key_s2c, runtime_key_s2c):
                serial_println("[sshd-session] kdf sha256 alpha mismatch: using runtime session keys")
        else:
            serial_println("[sshd-session] derived directional key material")
        # Derive into locals.  During rekey the old inbound material must stay
        # live until the peer's NEWKEYS has been authenticated; publishing it
        # earlier would attempt to decrypt that packet with the new key.
        var next_iv_c2s: [u8] = []
        var next_iv_s2c: [u8] = []
        if using_live_openssh_profile:
            next_iv_c2s = _derive_key_live_runtime_sha256(shared_secret, exchange_hash, 0x41, self.session_id, 12)
            next_iv_s2c = _derive_key_live_runtime_sha256(shared_secret, exchange_hash, 0x42, self.session_id, 12)
        else:
            next_iv_c2s = _copy_bytes_stable(keys.iv_c2s)
            next_iv_s2c = _copy_bytes_stable(keys.iv_s2c)
        var enc_key_len: u64 = 0
        if algos_early.cipher_c2s == "aes256-gcm@openssh.com" and algos_early.cipher_s2c == "aes256-gcm@openssh.com":
            enc_key_len = 32
        elif algos_early.cipher_c2s == "aes128-gcm@openssh.com" and algos_early.cipher_s2c == "aes128-gcm@openssh.com":
            enc_key_len = 16
        elif algos_early.cipher_c2s == "aes256-ctr" and algos_early.cipher_s2c == "aes256-ctr":
            enc_key_len = 32
        else:
            self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "unsupported cipher negotiation")
            return false
        var next_enc_key_c2s: [u8] = []
        var next_enc_key_s2c: [u8] = []
        var next_mac_key_c2s: [u8] = []
        var next_mac_key_s2c: [u8] = []
        if using_live_openssh_profile:
            next_enc_key_c2s = _derive_key_live_runtime_sha256(shared_secret, exchange_hash, 0x43, self.session_id, enc_key_len)
            next_enc_key_s2c = _derive_key_live_runtime_sha256(shared_secret, exchange_hash, 0x44, self.session_id, enc_key_len)
            next_mac_key_c2s = _derive_key_live_runtime_sha256(shared_secret, exchange_hash, 0x45, self.session_id, 32)
            next_mac_key_s2c = _derive_key_live_runtime_sha256(shared_secret, exchange_hash, 0x46, self.session_id, 32)
        else:
            next_enc_key_c2s = _copy_prefix_stable(keys.enc_key_c2s, enc_key_len)
            next_enc_key_s2c = _copy_prefix_stable(keys.enc_key_s2c, enc_key_len)
            next_mac_key_c2s = _copy_bytes_stable(keys.mac_key_c2s)
            next_mac_key_s2c = _copy_bytes_stable(keys.mac_key_s2c)

        # Our NEWKEYS was just sent with the old outbound key.  RFC 4253 makes
        # the next outbound packet use the new key, independently of inbound.
        self.iv_s2c = next_iv_s2c
        self.enc_key_s2c = next_enc_key_s2c
        self.mac_key_s2c = next_mac_key_s2c
        self.ctr_counter_s2c = _copy_bytes_stable(next_iv_s2c)
        self.negotiated_cipher_s2c = algos_early.cipher_s2c
        self.negotiated_mac_s2c = algos_early.mac_s2c
        if was_rekey and strict_kex:
            self.cipher.seq_s2c = 0u32
        if using_live_openssh_profile:
            serial_println("[sshd-session] staged key lengths iv_c2s={next_iv_c2s.len()} iv_s2c={next_iv_s2c.len()} key_c2s={next_enc_key_c2s.len()} key_s2c={next_enc_key_s2c.len()}")
        else:
            serial_println("[sshd-session] staged directional keys")

        # Keep inbound and outbound plaintext until the client's NEWKEYS is
        # consumed. Sending encrypted EXT_INFO before this point races
        # OpenSSH's strict-kex state, where it is still waiting for our
        # plaintext NEWKEYS.
        var sent_server_ext_info_early = false

        # Receive client NEWKEYS under the pre-NEWKEYS plaintext framing.
        var client_newkeys: [u8] = []
        var client_newkeys_attempts: u64 = 0
        while client_newkeys.len() == 0 and client_newkeys_attempts < 1000:
            client_newkeys = self.recv_packet_payload()
            if client_newkeys.len() == 0:
                rt_thread_sleep(1)
            client_newkeys_attempts = client_newkeys_attempts + 1
        var client_newkeys_len: u64 = client_newkeys.len()
        var client_newkeys_type: u8 = 0
        if client_newkeys_len > 0:
            client_newkeys_type = ssh_session_u8_at(client_newkeys, 0)
        serial_println("[sshd-session] client NEWKEYS len={client_newkeys_len} type=0x{format_hex(client_newkeys_type.to_i64())}")
        if client_newkeys_len != 1 or ssh_validate_newkeys_payload(client_newkeys, strict_kex).is_err():
            log_raw_println("[sshd-session] invalid client NEWKEYS payload")
            self.disconnect(SSH_DISCONNECT_PROTOCOL_ERROR, "invalid NEWKEYS")
            return false

        # The authenticated peer NEWKEYS is the inbound publication boundary.
        self.iv_c2s = next_iv_c2s
        self.enc_key_c2s = next_enc_key_c2s
        self.mac_key_c2s = next_mac_key_c2s
        self.ctr_counter_c2s = _copy_bytes_stable(next_iv_c2s)
        self.negotiated_cipher_c2s = algos_early.cipher_c2s
        self.negotiated_mac_c2s = algos_early.mac_c2s

        # Strict KEX resets each encrypted direction at its own NEWKEYS
        # boundary.  Initial KEX has no encrypted counters but initializes both
        # to the same canonical value before cipher activation.
        if strict_kex:
            self.cipher.seq_c2s = 0u32
            if not was_rekey and not sent_server_ext_info_early:
                self.cipher.seq_s2c = 0u32
        elif not was_rekey:
            # Without strict-KEX, RFC 4253 sequence numbers span the plaintext
            # handshake instead of restarting at cipher activation.
            self.cipher.seq_c2s = self.recv_seq
            self.cipher.seq_s2c = self.send_seq
        self.cipher.active = true
        if was_rekey:
            self.state = state_before_kex
        else:
            self.state = SshSessionState.Authentication
        serial_println("[sshd-session] cipher activated c2s_seq={self.cipher.seq_c2s} s2c_seq={self.cipher.seq_s2c} recv_seq={self.recv_seq} send_seq={self.send_seq}")
        log_info("[app.sshd] " + "[sshd-session] cipher activated")

        if not using_live_openssh_profile and not sent_server_ext_info_early:
            val ext_info = ssh_build_ext_info_server_sig_algs(if using_live_openssh_profile: _live_host_key_sig_algs() else: host_key_set_advertised_algorithms(self.host_keys))
            self.send_packet(ext_info)
        log_info("[app.sshd] " + "[sshd-session] kex ok")

        true
