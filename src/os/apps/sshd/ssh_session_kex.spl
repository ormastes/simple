    [
        0x00, 0x00, 0x00, 0x0b, 0x73, 0x73, 0x68, 0x2d,
        0x65, 0x64, 0x32, 0x35, 0x35, 0x31, 0x39, 0x00,
        0x00, 0x00, 0x20, 0xd7, 0x5a, 0x98, 0x01, 0x82,
        0xb1, 0x0a, 0xb7, 0xd5, 0x4b, 0xfe, 0xd3, 0xc9,
        0x64, 0x07, 0x3a, 0x0e, 0xe1, 0x72, 0xf3, 0xda,
        0xa6, 0x23, 0x25, 0xaf, 0x02, 0x1a, 0x68, 0xf7,
        0x07, 0x51, 0x1a
    ]

fn _build_live_kex_ecdh_reply(host_key_blob: [u8], server_public: [u8], signature: [u8]) -> [u8]:
    var buf: [u8] = []
    buf.push((31) as u8)
    buf = _push_string_live(buf, host_key_blob)
    buf = _push_string_live(buf, server_public)
    buf = _push_string_live(buf, signature)
    buf

