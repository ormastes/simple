# SSH session key exchange; extracted from ssh_session.spl.

use os.apps.sshd.ssh_packet.{ssh_put_u32, ssh_get_u32}
use os.apps.sshd.ssh_hex.{format_hex}
use os.apps.sshd.ssh_transport.{SshKexInit, SshAlgorithms, SSH_MSG_KEXINIT, SSH_MSG_IGNORE, SSH_MSG_DEBUG, SSH_DISCONNECT_PROTOCOL_ERROR, ssh_negotiate_algorithms, ssh_build_ext_info_server_sig_algs, ssh_kex_uses_strict_kex, ssh_build_disconnect}
use os.apps.sshd.ssh_kex.{ssh_build_kex_ecdh_reply, ssh_parse_kex_ecdh_init, ssh_build_newkeys, ssh_build_kexinit_for_host_keys_and_certs, host_key_set_advertised_algorithms}
use os.apps.sshd.ssh_kex_core.{ssh_kex_compute_exchange_hash, ssh_derive_keys}
use os.apps.sshd.ssh_kex_primitives.{HostKeySet, HostCertificateSet, SSH_MSG_KEX_ECDH_REPLY, ssh_build_ed25519_host_key_blob, _append_byte, _push_bytes, _push_mpint_bytes, curve25519_shared_secret_mpint_bytes}
use os.apps.sshd.ssh_session.{SshSession, SshSessionState}
use os.apps.sshd.ssh_session_helpers.{ssh_session_u8_at, _slice_range, _bytes_to_hex, _copy_bytes_stable, _copy_prefix_stable, _parse_kexinit_fast, _build_live_host_key_blob_for_algo, _ed25519_public_key_from_seed, _unwrap_ssh_signature, _extract_ed25519_pubkey, _zeroed_32_bytes}
use os.kernel.log.klog_api.{log_info}
use os.kernel.net.rt_net_socket_facade.{rt_net_last_ssh_plain_payload_len, rt_net_last_ssh_plain_payload_slice}
use os.crypto.dual_backend.{dual_backend_alpha_default_mode, dual_backend_bytes_equal, dual_backend_choose_bytes, dual_backend_run_bytes}
use os.crypto.ed25519.{ed25519_keypair_from_seed, ed25519_sign, ed25519_sign_live_pure_only, ed25519_sign_live_runtime_only, ed25519_verify}
use os.crypto.curve25519.{x25519, x25519_base}
extern fn rt_tls13_x25519_public_key(scalar: [u8]) -> [u8]
extern fn rt_tls13_x25519_shared_secret(scalar: [u8], point: [u8]) -> [u8]
extern fn rt_tls13_sha256(data: [u8]) -> [u8]
extern fn rt_ssh_curve25519_exchange_hash(client_version: [u8], server_version: [u8], client_kexinit: [u8], server_kexinit: [u8], host_key_blob: [u8], client_public: [u8], server_public: [u8], shared_secret: [u8]) -> [u8]
extern fn rt_boot_tcp_send_kex_reply_ed25519(fd: i64, host_key_blob: [u8], server_public: [u8], sig_blob: [u8]) -> i64
extern fn rt_boot_tcp_send_newkeys_fixed(fd: i64) -> i64
extern fn serial_println(msg: text)

fn log_raw_println(msg: text):
    serial_println(msg)

fn _live_exchange_hash_debug(
    client_version: [u8],
    server_version: [u8],
    client_kexinit: [u8],
    server_kexinit: [u8],
    host_key_blob: [u8],
    client_public: [u8],
    server_public: [u8],
    shared_secret: [u8]
) -> [u8]:
    serial_println("[sshd-session] exchash: v_c")
    var hash_input: [u8] = []
    hash_input = _push_string_live(hash_input, client_version)
    serial_println("[sshd-session] exchash: v_s")
    hash_input = _push_string_live(hash_input, server_version)
    serial_println("[sshd-session] exchash: i_c")
    hash_input = _push_string_live(hash_input, client_kexinit)
    serial_println("[sshd-session] exchash: i_s")
    hash_input = _push_string_live(hash_input, server_kexinit)
    serial_println("[sshd-session] exchash: k_s")
    hash_input = _push_string_live(hash_input, host_key_blob)
    serial_println("[sshd-session] exchash: q_c")
    hash_input = _push_string_live(hash_input, client_public)
    serial_println("[sshd-session] exchash: q_s")
    hash_input = _push_string_live(hash_input, server_public)
    serial_println("[sshd-session] exchash: k")
    hash_input = _push_mpint_bytes(hash_input, curve25519_shared_secret_mpint_bytes(shared_secret))
    serial_println("[sshd-session] exchash: sha256 input len={hash_input.len()}")
    val digest = rt_tls13_sha256(hash_input)
    serial_println("[sshd-session] exchash: sha256 out len={digest.len()}")
    digest

fn _live_exchange_hash_fast(
    client_version: [u8],
    server_version: [u8],
    client_kexinit: [u8],
    server_kexinit: [u8],
    host_key_blob: [u8],
    client_public: [u8],
    server_public: [u8],
    shared_secret: [u8]
) -> [u8]:
    serial_println("[sshd-session] exchash lens vc={client_version.len()} vs={server_version.len()} ic={client_kexinit.len()} is={server_kexinit.len()} ks={host_key_blob.len()} qc={client_public.len()} qs={server_public.len()} k={shared_secret.len()}")
    serial_println("[sshd-session] exchash sha vc={_bytes_to_hex(rt_tls13_sha256(client_version))}")
    serial_println("[sshd-session] exchash sha vs={_bytes_to_hex(rt_tls13_sha256(server_version))}")
    serial_println("[sshd-session] exchash sha ic={_bytes_to_hex(rt_tls13_sha256(client_kexinit))}")
    serial_println("[sshd-session] exchash sha is={_bytes_to_hex(rt_tls13_sha256(server_kexinit))}")
    serial_println("[sshd-session] exchash sha ks={_bytes_to_hex(rt_tls13_sha256(host_key_blob))}")
    serial_println("[sshd-session] exchash sha qc={_bytes_to_hex(rt_tls13_sha256(client_public))}")
    serial_println("[sshd-session] exchash sha qs={_bytes_to_hex(rt_tls13_sha256(server_public))}")
    val shared_secret_mpint = curve25519_shared_secret_mpint_bytes(shared_secret)
    # Never log the shared secret, its SSH mpint encoding, or a digest of
    # either.  A digest still exposes an offline equality oracle for ephemeral
    # KEX material and makes production serial logs security-sensitive.
    var hash_input: [u8] = []
    hash_input = _push_string_live(hash_input, client_version)
    hash_input = _push_string_live(hash_input, server_version)
    hash_input = _push_string_live(hash_input, client_kexinit)
    hash_input = _push_string_live(hash_input, server_kexinit)
    hash_input = _push_string_live(hash_input, host_key_blob)
    hash_input = _push_string_live(hash_input, client_public)
    hash_input = _push_string_live(hash_input, server_public)
    hash_input = _push_mpint_bytes(hash_input, shared_secret_mpint)
    rt_tls13_sha256(hash_input)

fn _live_bootstrap_x25519_private_key() -> [u8]:
    """Deterministic live-QEMU bootstrap scalar used only while baremetal random_bytes is unstable."""
    var key: [u8] = []
    key.push((0x48) as u8)
    key.push((0x9c) as u8)
    key.push((0x2a) as u8)
    key.push((0x61) as u8)
    key.push((0xf5) as u8)
    key.push((0x33) as u8)
    key.push((0x17) as u8)
    key.push((0xb8) as u8)
    key.push((0x2d) as u8)
    key.push((0x74) as u8)
    key.push((0xa1) as u8)
    key.push((0x0e) as u8)
    key.push((0xcc) as u8)
    key.push((0x59) as u8)
    key.push((0x83) as u8)
    key.push((0x42) as u8)
    key.push((0x91) as u8)
    key.push((0x06) as u8)
    key.push((0xdf) as u8)
    key.push((0x38) as u8)
    key.push((0xbe) as u8)
    key.push((0x27) as u8)
    key.push((0x65) as u8)
    key.push((0xaa) as u8)
    key.push((0x14) as u8)
    key.push((0xe7) as u8)
    key.push((0x90) as u8)
    key.push((0x4b) as u8)
    key.push((0x6c) as u8)
    key.push((0x21) as u8)
    key.push((0xd3) as u8)
    key.push((0x7f) as u8)
    key

fn _live_bootstrap_x25519_public_key() -> [u8]:
    [
        0x8c, 0x16, 0xc1, 0xdd, 0x75, 0xb7, 0x97, 0xa2,
        0x9b, 0xa2, 0xc1, 0x7e, 0xb5, 0xa7, 0x68, 0xe4,
        0x4a, 0x76, 0x0b, 0x9a, 0x0d, 0x0f, 0x8c, 0x59,
        0x72, 0xca, 0xfb, 0x72, 0xef, 0xe1, 0x03, 0x37
    ]

fn _live_host_key_sig_algs() -> text:
    "ssh-ed25519"

fn _rv64_live_x25519_public_runtime_probe(server_private: [u8]) -> [u8]:
    val out = rt_tls13_x25519_public_key(server_private)
    serial_println("[sshd-session] x25519 public runtime len={out.len()}")
    out

fn _rv64_live_x25519_public_pure_probe(server_private: [u8]) -> [u8]:
    serial_println("[sshd-session] x25519 public pure start")
    val out = x25519_base(server_private)
    serial_println("[sshd-session] x25519 public pure len={out.len()}")
    out

fn _rv64_live_x25519_public_alpha(server_private: [u8]) -> [u8]:
    val runtime_out = _rv64_live_x25519_public_runtime_probe(server_private)
    val pure_out = _rv64_live_x25519_public_pure_probe(server_private)
    val selected = dual_backend_choose_bytes(
        "curve25519",
        "rv64_live_public",
        dual_backend_alpha_default_mode(),
        [
            "priv_len=" + server_private.len().to_text()
        ],
        runtime_out,
        pure_out
    )
    if not dual_backend_bytes_equal(runtime_out, pure_out):
        serial_println("[sshd-session] x25519 public alpha mismatch: refusing runtime output")
        return []
    selected

fn _rv64_live_x25519_shared_alpha(server_private: [u8], client_public: [u8]) -> [u8]:
    val runtime_out = rt_tls13_x25519_shared_secret(server_private, client_public)
    val pure_out = x25519(server_private, client_public)
    val selected = dual_backend_choose_bytes(
        "curve25519",
        "rv64_live_shared",
        dual_backend_alpha_default_mode(),
        [
            "priv_len=" + server_private.len().to_text(),
            "pub_len=" + client_public.len().to_text()
        ],
        runtime_out,
        pure_out
    )
    if not dual_backend_bytes_equal(runtime_out, pure_out):
        serial_println("[sshd-session] x25519 shared alpha mismatch: refusing runtime output")
        return []
    selected


fn _derive_session_x25519_private_key(host_seed: [u8]?, client_public: [u8], client_kexinit_payload: [u8], rekey_epoch: u32) -> [u8]:
    var seed_material: [u8] = []
    if host_seed != nil:
        seed_material = _copy_bytes_stable(host_seed)
    val stable_client_public = _copy_bytes_stable(client_public)
    var i: u64 = 0
    while i < stable_client_public.len():
        seed_material.push(ssh_session_u8_at(stable_client_public, i))
        i = i + 1
    val stable_kex_prefix = _copy_prefix_stable(client_kexinit_payload, 64)
    i = 0
    while i < stable_kex_prefix.len():
        seed_material.push(ssh_session_u8_at(stable_kex_prefix, i))
        i = i + 1
    # Bind peer-controlled repeat proposals to a monotonically bounded daemon
    # epoch so two accepted rekeys cannot reuse the server ephemeral scalar.
    seed_material.push(((rekey_epoch >> 24) & 0xFFu32).to_u8())
    seed_material.push(((rekey_epoch >> 16) & 0xFFu32).to_u8())
    seed_material.push(((rekey_epoch >> 8) & 0xFFu32).to_u8())
    seed_material.push((rekey_epoch & 0xFFu32).to_u8())
    val digest = ssh_kex_compute_exchange_hash(
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        seed_material
    )
    if digest.len() != 32:
        return _live_bootstrap_x25519_private_key()
    _copy_bytes_stable(digest)

