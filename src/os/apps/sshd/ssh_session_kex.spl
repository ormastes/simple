fn _push_u32_be_live(buf: [u8], val_: u64) -> [u8]:
    var out = buf
    out.push((((val_ >> 24) & 0xFF).to_i64()) as u8)
    out.push((((val_ >> 16) & 0xFF).to_i64()) as u8)
    out.push((((val_ >> 8) & 0xFF).to_i64()) as u8)
    out.push(((val_ & 0xFF).to_i64()) as u8)
    out

fn _push_bytes_live(buf: [u8], data: [u8]) -> [u8]:
    var out = buf
    var i: u64 = 0
    while i < data.len():
        out.push((ssh_session_u8_at(data, i).to_i64()) as u8)
        i = i + 1
    out

fn _push_string_live(buf: [u8], data: [u8]) -> [u8]:
    _push_bytes_live(_push_u32_be_live(buf, data.len()), data)

fn _build_live_ed25519_host_key_blob(public_key: [u8]) -> [u8]:
    var blob: [u8] = []
    blob = _push_u32_be_live(blob, 11)
    blob.push((0x73) as u8)
    blob.push((0x73) as u8)
    blob.push((0x68) as u8)
    blob.push((0x2D) as u8)
    blob.push((0x65) as u8)
    blob.push((0x64) as u8)
    blob.push((0x32) as u8)
    blob.push((0x35) as u8)
    blob.push((0x35) as u8)
    blob.push((0x31) as u8)
    blob.push((0x39) as u8)
    blob = _push_string_live(blob, public_key)
    blob

