#![allow(unnamed_duplicate_typed_args)]
# SSH Authentication — RFC 4252
#
# Supports public-key authentication. Password requests fail closed until the
# verifier and compiler-resistant secret-zeroization blocker is resolved.
#
# Authentication flow:
#   1. Client sends SSH_MSG_SERVICE_REQUEST for "ssh-userauth"
#   2. Server responds with SSH_MSG_SERVICE_ACCEPT
#   3. Client sends SSH_MSG_USERAUTH_REQUEST with method
#   4. Server responds SUCCESS or FAILURE

use os.apps.sshd.ssh_packet.{ssh_put_u32, ssh_put_text, ssh_put_string, ssh_put_bool, ssh_put_byte, ssh_get_u32, ssh_get_string, ssh_get_text, ssh_ascii_text_to_bytes, SshTextResult, SshStringResult}
use os.crypto.ed25519.{ed25519_verify}

# ============================================================================
# Constants
# ============================================================================

val SSH_MSG_USERAUTH_REQUEST: u8 = 50
val SSH_MSG_USERAUTH_FAILURE: u8 = 51
val SSH_MSG_USERAUTH_SUCCESS: u8 = 52
val SSH_MSG_USERAUTH_BANNER: u8 = 53
val SSH_MSG_USERAUTH_PK_OK: u8 = 60
val SSH_MSG_USERAUTH_INFO_REQUEST: u8 = 60
val SSH_MSG_USERAUTH_INFO_RESPONSE: u8 = 61

# Maximum authentication attempts before disconnect
val MAX_AUTH_ATTEMPTS: u32 = 6
val MAX_USERS: u32 = 64
val MAX_AUTHORIZED_KEYS_PER_USER: i64 = 128
val MAX_AUTH_REQUEST_BYTES: i64 = 32768

# ============================================================================
# Types
# ============================================================================

struct SshAuthRequest:
    """Parsed authentication request."""
    username: text
    service: text       # "ssh-connection"
    method: text        # "password", "publickey", or "none"
    password: text      # For password auth (empty otherwise)
    key_algo: text      # For publickey auth
    key_blob: [u8]      # For publickey auth
    has_signature: bool  # For publickey: true means verify, false means probe
    signature: [u8]     # For publickey: client's signature over session data

struct SshPasswordVerifier:
    """Versioned verifier record; plaintext passwords are never retained."""
    version: text
    salt: [u8]
    derived_key: [u8]
    iterations: i64

struct SshPublicKeyAuthCheck:
    valid: bool
    probe_accepted: bool
    algorithm: text
    key_blob: [u8]

struct SshUser:
    """A user entry in the authentication database."""
    username: text
    password_verifier: SshPasswordVerifier?
    authorized_keys: [[u8]] # List of public key blobs

fn _ssh_username_safe(username: text) -> bool:
    if username.len() == 0 or username.len() > 64:
        return false
    var i: i64 = 0
    while i < username.len():
        val code = username.char_code_at(i)
        if code < 33 or code > 126:
            return false
        i = i + 1
    true

class SshUserDb:
    """Simple user database for SSH authentication."""
    users: [SshUser]

impl SshUserDb:

    static fn new() -> SshUserDb:
        """Create an empty user database."""
        SshUserDb(users: [])

    me add_user_identity(username: text):
        """Add a bounded identity; authentication material is attached separately."""
        if not _ssh_username_safe(username) or self.users.len().to_u32() >= MAX_USERS:
            return
        for existing in self.users:
            if existing.username == username:
                return
        self.users.push(SshUser(
            username: username,
            password_verifier: nil,
            authorized_keys: []
        ))

    me add_user_key(username: text, key_blob: [u8]):
        """Add an authorized public key for an existing user."""
        if _ssh_public_key_material(key_blob).len() != 32:
            return
        var i: u64 = 0
        while i < self.users.len():
            if self.users[i].username == username:
                if self.users[i].authorized_keys.len() >= MAX_AUTHORIZED_KEYS_PER_USER:
                    return
                for existing in self.users[i].authorized_keys:
                    if _blobs_equal(existing, key_blob):
                        return
                var user = self.users[i]
                user.authorized_keys.push(key_blob)
                self.users[i] = user
                return
            i = i + 1

    me add_password_verifier(username: text, verifier: SshPasswordVerifier):
        """Attach an operator-provisioned verifier record, never plaintext."""
        var i: u64 = 0
        while i < self.users.len():
            if self.users[i].username == username:
                var user = self.users[i]
                user.password_verifier = verifier
                self.users[i] = user
                return
            i = i + 1

    fn find_user(username: text) -> SshUser?:
        """Look up a user by name. Returns nil if not found."""
        var i: u64 = 0
        while i < self.users.len():
            if self.users[i].username == username:
                return self.users[i]
            i = i + 1
        nil

    fn has_authorized_key() -> bool:
        for user in self.users:
            for key_blob in user.authorized_keys:
                if _ssh_public_key_material(key_blob).len() == 32:
                    return true
        false

    fn authenticate_password(username: text, password_val: text) -> bool:
        """Password authentication is fail-closed until verifier zeroization is proven.

        Do not reintroduce plaintext comparison: the repository has no
        compiler-resistant wipe primitive for password/KDF temporaries.
        Public-key authentication remains available through authenticate_key.
        """
        false

    fn authenticate_key(username: text, key_blob: [u8]) -> bool:
        """Check if a public key is authorized for this user.

        Returns true if the key_blob matches one of the user's authorized keys.
        NOTE: Uses var locals to work around baremetal Cranelift codegen bug.
        """
        var user = self.find_user(username)
        if user == nil:
            return false

        var ki: u64 = 0
        while ki < user.authorized_keys.len():
            var stored = user.authorized_keys[ki]
            if _blobs_equal(stored, key_blob):
                return true
            ki = ki + 1

        false


# ============================================================================
# Deprecated compatibility constructor; production-safe empty DB. Historical
# callers must migrate to an operator-supplied SshdCredentialProvider.
fn sshd_create_default_users() -> SshUserDb:
    SshUserDb.new()

# Message Parsing
# ============================================================================

fn ssh_parse_auth_request(data: [u8]) -> Result<SshAuthRequest, text>:
    """Parse SSH_MSG_USERAUTH_REQUEST.

    Format:
      byte      SSH_MSG_USERAUTH_REQUEST (50)
      string    user name
      string    service name ("ssh-connection")
      string    method name ("password", "publickey", "none")
      ... method-specific fields ...
    """
    if data.len() < 2 or data.len() > MAX_AUTH_REQUEST_BYTES:
        return Err("USERAUTH_REQUEST too short")
    if data[0] != SSH_MSG_USERAUTH_REQUEST:
        return Err("not a USERAUTH_REQUEST")

    var off: u64 = 1

    # Username
    var username: text = ""
    match ssh_get_text(data, off):
        Ok(user_pair):
            username = user_pair.value
            off = user_pair.next_offset
        Err(_):
            return Err("USERAUTH: bad username")
    if not _ssh_username_safe(username):
        return Err("USERAUTH: invalid username")

    # Service name
    var service: text = ""
    match ssh_get_text(data, off):
        Ok(svc_pair):
            service = svc_pair.value
            off = svc_pair.next_offset
        Err(_):
            return Err("USERAUTH: bad service")
    if service != "ssh-connection":
        return Err("USERAUTH: unsupported service")

    # Method name
    var method: text = ""
    match ssh_get_text(data, off):
        Ok(meth_pair):
            method = meth_pair.value
            off = meth_pair.next_offset
        Err(_):
            return Err("USERAUTH: bad method")

    var password_val: text = ""
    var key_algo: text = ""
    var key_blob: [u8] = []
    var has_signature: bool = false
    var signature: [u8] = []

    if method == "password":
        # Fail before decoding the secret into immutable text. Password auth
        # remains unavailable until compiler-resistant temporary zeroization
        # exists and is covered by evidence.
        return Err("USERAUTH: password authentication disabled")

    elif method == "publickey":
        # bool    has_signature
        # string  public key algorithm name
        # string  public key blob
        # [string signature]  — only present when has_signature is true
        if off >= data.len() or data[off] > 1:
            return Err("USERAUTH: bad publickey signature flag")
        has_signature = data[off] == 1
        off = off + 1
        match ssh_get_text(data, off):
            Ok(algo_pair):
                key_algo = algo_pair.value
                off = algo_pair.next_offset
            Err(_):
                return Err("USERAUTH: missing publickey algorithm")
        if key_algo != "ssh-ed25519":
            return Err("USERAUTH: unsupported publickey algorithm")
        match ssh_get_string(data, off):
            Ok(blob_pair):
                key_blob = blob_pair.data
                off = blob_pair.next_offset
            Err(_):
                return Err("USERAUTH: missing publickey blob")
        if _ssh_public_key_material(key_blob).len() != 32:
            return Err("USERAUTH: malformed publickey blob")
        # Read signature if has_signature is true
        if has_signature:
            if off >= data.len():
                return Err("USERAUTH: missing publickey signature")
            match ssh_get_string(data, off):
                Ok(sig_pair):
                    signature = sig_pair.data
                    off = sig_pair.next_offset
                Err(_):
                    return Err("USERAUTH: missing publickey signature")
            if _ssh_public_key_signature(signature, key_algo).len() != 64:
                return Err("USERAUTH: malformed publickey signature")

    elif method != "none":
        return Err("USERAUTH: unsupported authentication method")

    if off != data.len():
        return Err("USERAUTH: trailing method data")
    Ok(SshAuthRequest(
        username: username,
        service: service,
        method: method,
        password: password_val,
        key_algo: key_algo,
        key_blob: key_blob,
        has_signature: has_signature,
        signature: signature
    ))

fn _ssh_public_key_material(key_blob: [u8]) -> [u8]:
    if key_blob.len() > 256:
        return []
    val key_type = ssh_get_text(key_blob, 0)
    match key_type:
        case Err(_): return []
        case Ok(type_pair):
            if type_pair.value != "ssh-ed25519":
                return []
            val key = ssh_get_string(key_blob, type_pair.next_offset)
            match key:
                case Err(_): return []
                case Ok(key_pair):
                    if key_pair.next_offset != key_blob.len() or key_pair.data.len() != 32:
                        return []
                    key_pair.data

fn _ssh_public_key_signature(signature: [u8], algorithm: text) -> [u8]:
    if signature.len() > 256:
        return []
    val signature_type = ssh_get_text(signature, 0)
    match signature_type:
        case Err(_): return []
        case Ok(type_pair):
            if type_pair.value != algorithm:
                return []
            val raw = ssh_get_string(signature, type_pair.next_offset)
            match raw:
                case Err(_): return []
                case Ok(raw_pair):
                    if raw_pair.next_offset != signature.len() or raw_pair.data.len() != 64:
                        return []
                    raw_pair.data

fn _ssh_public_key_signed_data(session_id: [u8], request: SshAuthRequest) -> [u8]:
    var data: [u8] = []
    data = ssh_put_string(data, session_id)
    data = ssh_put_byte(data, SSH_MSG_USERAUTH_REQUEST)
    data = ssh_put_text(data, request.username)
    data = ssh_put_text(data, request.service)
    data = ssh_put_text(data, request.method)
    data = ssh_put_bool(data, true)
    data = ssh_put_text(data, request.key_algo)
    ssh_put_string(data, request.key_blob)

fn ssh_check_public_key_auth(
    request: SshAuthRequest,
    session_id: [u8],
    user_db: SshUserDb
) -> SshPublicKeyAuthCheck:
    val rejected = SshPublicKeyAuthCheck(
        valid: false, probe_accepted: false,
        algorithm: request.key_algo, key_blob: request.key_blob)
    if request.method != "publickey" or request.service != "ssh-connection" or
        not _ssh_username_safe(request.username) or
        request.key_algo != "ssh-ed25519" or session_id.len() < 32 or
        session_id.len() > 64:
        return rejected
    val public_key = _ssh_public_key_material(request.key_blob)
    if public_key.len() != 32 or not user_db.authenticate_key(
        request.username, request.key_blob):
        return rejected
    if not request.has_signature:
        if request.signature.len() != 0:
            return rejected
        return SshPublicKeyAuthCheck(
            valid: false, probe_accepted: true,
            algorithm: request.key_algo, key_blob: request.key_blob)
    val signature = _ssh_public_key_signature(request.signature, request.key_algo)
    if signature.len() != 64:
        return rejected
    val signed_data = _ssh_public_key_signed_data(session_id, request)
    SshPublicKeyAuthCheck(
        valid: ed25519_verify(public_key, signed_data, signature),
        probe_accepted: false,
        algorithm: request.key_algo,
        key_blob: request.key_blob)

# ============================================================================
# Message Builders
# ============================================================================

fn ssh_build_auth_success() -> [u8]:
    """Build SSH_MSG_USERAUTH_SUCCESS message."""
    var buf: [u8] = []
    buf.push(SSH_MSG_USERAUTH_SUCCESS)
    buf

fn _push_raw_string(buf: [u8], data: [u8]) -> [u8]:
    var out = ssh_put_u32(buf, data.len().to_u32())
    var i: u64 = 0
    while i < data.len():
        out.push(data[i])
        i = i + 1
    out

fn ssh_build_auth_failure(methods: [text], partial_success: bool) -> [u8]:
    """Build SSH_MSG_USERAUTH_FAILURE with available methods.

    Format:
      byte      SSH_MSG_USERAUTH_FAILURE (51)
      name-list authentications that can continue
      boolean   partial success
    """
    var buf: [u8] = []
    buf.push(SSH_MSG_USERAUTH_FAILURE)

    # Build comma-separated method list
    var method_str: text = ""
    var i: u64 = 0
    while i < methods.len():
        if i > 0:
            method_str = method_str + ","
        method_str = method_str + methods[i]
        i = i + 1

    buf = _push_raw_string(buf, ssh_ascii_text_to_bytes(method_str))
    buf = ssh_put_bool(buf, partial_success)
    buf

fn ssh_build_auth_banner(message: text) -> [u8]:
    """Build SSH_MSG_USERAUTH_BANNER message.

    Format:
      byte      SSH_MSG_USERAUTH_BANNER (53)
      string    message (UTF-8)
      string    language tag
    """
    var buf: [u8] = []
    buf.push(SSH_MSG_USERAUTH_BANNER)
    buf = _push_raw_string(buf, ssh_ascii_text_to_bytes(message))
    buf = ssh_put_u32(buf, 0)   # language tag
    buf

fn ssh_build_userauth_pk_ok(algo: text, key_blob: [u8]) -> [u8]:
    """Build SSH_MSG_USERAUTH_PK_OK response (RFC 4252 section 7).

    Sent when has_signature=false and the key is acceptable.
    Tells the client to retry with a real signature.

    Format:
      byte      SSH_MSG_USERAUTH_PK_OK (60)
      string    public key algorithm name
      string    public key blob
    """
    var buf: [u8] = []
    buf.push(SSH_MSG_USERAUTH_PK_OK)
    buf = _push_raw_string(buf, ssh_ascii_text_to_bytes(algo))
    buf = ssh_put_string(buf, key_blob)
    buf

fn ssh_build_userauth_info_request(name: text, instruction: text, prompt: text, echo: bool) -> [u8]:
    """Build SSH_MSG_USERAUTH_INFO_REQUEST for keyboard-interactive auth."""
    var buf: [u8] = []
    buf.push(SSH_MSG_USERAUTH_INFO_REQUEST)
    buf = _push_raw_string(buf, ssh_ascii_text_to_bytes(name))
    buf = _push_raw_string(buf, ssh_ascii_text_to_bytes(instruction))
    buf = ssh_put_u32(buf, 0)
    buf = ssh_put_u32(buf, 1)
    buf = _push_raw_string(buf, ssh_ascii_text_to_bytes(prompt))
    buf = ssh_put_bool(buf, echo)
    buf

fn ssh_parse_userauth_info_response(data: [u8]) -> Result<text, text>:
    """Parse SSH_MSG_USERAUTH_INFO_RESPONSE and return the first response."""
    if data.len() < 5:
        return Err("USERAUTH_INFO_RESPONSE too short")
    if data[0] != SSH_MSG_USERAUTH_INFO_RESPONSE:
        return Err("not a USERAUTH_INFO_RESPONSE")
    val count = ssh_get_u32(data, 1).to_u64()
    if count < 1:
        return Err("USERAUTH_INFO_RESPONSE missing response")
    match ssh_get_text(data, 5):
        Ok(response):
            Ok(response.value)
        Err(_):
            Err("USERAUTH_INFO_RESPONSE bad response")

# ============================================================================
# Internal Helpers
# ============================================================================

fn _blobs_equal(a: [u8], b: [u8]) -> bool:
    """Constant-time comparison of two byte arrays."""
    if a.len() != b.len():
        return false

    var diff: u8 = 0
    var i: u64 = 0
    while i < a.len():
        diff = diff | (a[i] ^ b[i])
        i = i + 1

    diff == 0

export SshPasswordVerifier, SshPublicKeyAuthCheck
export SSH_MSG_USERAUTH_REQUEST, SSH_MSG_USERAUTH_FAILURE, SSH_MSG_USERAUTH_PK_OK, SSH_MSG_USERAUTH_SUCCESS
export MAX_AUTH_ATTEMPTS, MAX_AUTHORIZED_KEYS_PER_USER, sshd_create_default_users
export ssh_check_public_key_auth
