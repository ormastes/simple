# SSH Channel Multiplexing — RFC 4254
#
# Manages SSH channels for session, exec, and forwarding requests.
# Each channel has independent flow control via sliding window.
#
# Channel lifecycle:
#   CHANNEL_OPEN -> OPEN_CONFIRMATION -> data transfer -> CHANNEL_CLOSE

use os.apps.sshd.ssh_packet.{ssh_put_u32, ssh_put_text, ssh_put_string, ssh_put_bool, ssh_put_byte, ssh_get_u32, ssh_get_string, ssh_get_text, SshTextResult, SshStringResult}

# ============================================================================
# Constants
# ============================================================================

val SSH_MSG_CHANNEL_OPEN: u8 = 90
val SSH_MSG_CHANNEL_OPEN_CONFIRMATION: u8 = 91
val SSH_MSG_CHANNEL_OPEN_FAILURE: u8 = 92
val SSH_INVALID_CHANNEL_ID: u32 = 4294967295u32
val SSH_MAX_CHANNELS_PER_SESSION: i64 = 256
val SSH_MSG_CHANNEL_WINDOW_ADJUST: u8 = 93
val SSH_MSG_CHANNEL_DATA: u8 = 94
val SSH_MSG_CHANNEL_EXTENDED_DATA: u8 = 95
val SSH_MSG_CHANNEL_EOF: u8 = 96
val SSH_MSG_CHANNEL_CLOSE: u8 = 97
val SSH_MSG_CHANNEL_REQUEST: u8 = 98
val SSH_MSG_CHANNEL_SUCCESS: u8 = 99
val SSH_MSG_CHANNEL_FAILURE: u8 = 100

# Default window and packet sizes
val DEFAULT_WINDOW_SIZE: u32 = 2097152    # 2 MiB
val DEFAULT_MAX_PACKET: u32 = 32768       # 32 KiB

# Channel open failure reason codes (RFC 4254 section 5.1)
val SSH_OPEN_ADMINISTRATIVELY_PROHIBITED: u32 = 1
val SSH_OPEN_CONNECT_FAILED: u32 = 2
val SSH_OPEN_UNKNOWN_CHANNEL_TYPE: u32 = 3
val SSH_OPEN_RESOURCE_SHORTAGE: u32 = 4

# ============================================================================
# Types
# ============================================================================

enum ChannelType:
    Session
    DirectTcpip
    ForwardedTcpip

enum ChannelState:
    Opening
    Open
    Closing
    Closed

enum ChannelTerminalRequestV1:
    None
    Shell
    Exec
    Subsystem

struct SshChannel:
    """State for one SSH channel."""
    local_id: u32
    remote_id: u32
    channel_type: ChannelType
    state: ChannelState
    local_window: u32       # Bytes we can still receive
    remote_window: u32      # Bytes we can still send
    local_max_packet: u32
    remote_max_packet: u32
    pty_requested: bool
    shell_requested: bool
    terminal_request: ChannelTerminalRequestV1
    peer_eof: bool
    env_vars: [(text, text)]

class ChannelTable:
    """Manages all active SSH channels for one session."""
    channels: [SshChannel]
    next_id: u32

impl ChannelTable:

    pub static fn new() -> ChannelTable:
        """Create an empty channel table."""
        ChannelTable(channels: [], next_id: 0)

    pub me open(channel_type: ChannelType, remote_id: u32, remote_window: u32, remote_max_packet: u32) -> u32:
        """Allocate a new channel. Returns the local channel ID."""
        if self.channels.len() >= SSH_MAX_CHANNELS_PER_SESSION or self.next_id == SSH_INVALID_CHANNEL_ID or self.has_remote_id(remote_id):
            return SSH_INVALID_CHANNEL_ID
        val local_id = self.next_id
        self.channels.push(SshChannel(
            local_id: local_id,
            remote_id: remote_id,
            channel_type: channel_type,
            state: ChannelState.Open,
            local_window: DEFAULT_WINDOW_SIZE,
            remote_window: remote_window,
            local_max_packet: DEFAULT_MAX_PACKET,
            remote_max_packet: remote_max_packet,
            pty_requested: false,
            shell_requested: false,
            terminal_request: ChannelTerminalRequestV1.None,
            peer_eof: false,
            env_vars: []
        ))
        self.next_id = local_id + 1

        local_id

    pub me seed_open(local_id: u32, channel_type: ChannelType, remote_id: u32, remote_window: u32, remote_max_packet: u32) -> bool:
        """Seed a known-open channel without touching the C-side table."""
        if local_id == SSH_INVALID_CHANNEL_ID:
            return false
        val idx = self._find_local_index(local_id)
        # A repeated/replayed CHANNEL_OPEN must never overwrite an active
        # entry or refresh its windows.  Callers send OPEN_FAILURE instead.
        if idx >= 0 or self.has_remote_id(remote_id):
            return false
        if self.channels.len() >= SSH_MAX_CHANNELS_PER_SESSION:
            return false
        val seeded = SshChannel(
            local_id: local_id,
            remote_id: remote_id,
            channel_type: channel_type,
            state: ChannelState.Open,
            local_window: DEFAULT_WINDOW_SIZE,
            remote_window: remote_window,
            local_max_packet: DEFAULT_MAX_PACKET,
            remote_max_packet: remote_max_packet,
            pty_requested: false,
            shell_requested: false,
            terminal_request: ChannelTerminalRequestV1.None,
            peer_eof: false,
            env_vars: []
        )
        self.channels.push(seeded)
        if self.next_id <= local_id:
            self.next_id = local_id + 1
        true

    pub fn has_remote_id(remote_id: u32) -> bool:
        for channel in self.channels:
            if channel.state != ChannelState.Closed and channel.remote_id == remote_id:
                return true
        false

    pub me session_channel_open_response(remote_id: u32, remote_window: u32, remote_max_packet: u32) -> [u8]:
        val local_id: u32 = 0
        if !self.seed_open(local_id, ChannelType.Session, remote_id, remote_window, remote_max_packet):
            val reason = if self._find_local_index(local_id) >= 0 or self.has_remote_id(remote_id): "channel already open" else: "channel capacity exhausted"
            return ssh_build_channel_open_failure(remote_id, 4, reason)
        ssh_build_channel_open_confirmation(remote_id, local_id, DEFAULT_WINDOW_SIZE, DEFAULT_MAX_PACKET)

    pub me close(local_id: u32) -> bool:
        """Mark a channel as closed."""
        val idx = self._find_local_index(local_id)
        if idx >= 0:
            self.channels[idx as u64].state = ChannelState.Closed
            return true
        false

    pub fn find(local_id: u32) -> SshChannel?:
        """Find a channel by local ID. Returns nil if not found."""
        val idx = self._find_local_index(local_id)
        if idx >= 0:
            return self.channels[idx as u64]
        nil

    pub fn is_open_session(local_id: u32) -> bool:
        """Return true only for a live RFC 4254 session channel."""
        val idx = self._find_local_index(local_id)
        if idx < 0:
            return false
        val channel = self.channels[idx as u64]
        channel.state == ChannelState.Open and
            channel.channel_type == ChannelType.Session

    pub me begin_terminal_request(
        local_id: u32, request: ChannelTerminalRequestV1
    ) -> bool:
        """Commit one shell, exec, or subsystem request exactly once.

        The per-session ChannelTable is the sole mutable request-state owner.
        Invalid channels and a second terminal request leave state unchanged.
        """
        if request == ChannelTerminalRequestV1.None:
            return false
        val idx = self._find_local_index(local_id)
        if idx < 0:
            return false
        val channel = self.channels[idx as u64]
        if channel.state != ChannelState.Open or
            channel.channel_type != ChannelType.Session or
            channel.terminal_request != ChannelTerminalRequestV1.None:
            return false
        self.channels[idx as u64].terminal_request = request
        self.channels[idx as u64].shell_requested =
            request == ChannelTerminalRequestV1.Shell
        true

    pub me mark_pty_requested_once(local_id: u32) -> bool:
        """Commit one PTY request on an open session before its terminal request."""
        val idx = self._find_local_index(local_id)
        if idx < 0:
            return false
        val channel = self.channels[idx as u64]
        if channel.state != ChannelState.Open or
            channel.channel_type != ChannelType.Session or
            channel.pty_requested or
            channel.terminal_request != ChannelTerminalRequestV1.None:
            return false
        self.channels[idx as u64].pty_requested = true
        true

    pub fn window_change_allowed(local_id: u32) -> bool:
        """Accept geometry updates only for a live PTY-backed shell."""
        val idx = self._find_local_index(local_id)
        if idx < 0:
            return false
        val channel = self.channels[idx as u64]
        channel.state == ChannelState.Open and
            channel.channel_type == ChannelType.Session and
            channel.pty_requested and
            channel.terminal_request == ChannelTerminalRequestV1.Shell

    fn find_mut(local_id: u32) -> SshChannel?:
        """Find a channel by local ID (mutable access).
        Delegates to find() which uses C-side table."""
        self.find(local_id)

    pub me adjust_window(local_id: u32, bytes: u32) -> bool:
        """Increase local receive window by bytes."""
        val idx = self._find_local_index(local_id)
        if idx >= 0:
            val current = self.channels[idx as u64].local_window
            if bytes > 4294967295u32 - current:
                return false
            var new_window: u32 = current + bytes
            self.channels[idx as u64].local_window = new_window
            return true
        false

    pub me adjust_remote_window(local_id: u32, bytes: u32) -> bool:
        """Increase peer send window with checked u32 arithmetic."""
        val idx = self._find_local_index(local_id)
        if idx < 0:
            return false
        if self.channels[idx as u64].state != ChannelState.Open or bytes == 0u32:
            return false
        val current = self.channels[idx as u64].remote_window
        if bytes > 4294967295u32 - current:
            return false
        self.channels[idx as u64].remote_window = current + bytes
        true

    pub me consume_remote_window(local_id: u32, bytes: u32) -> bool:
        """Consume bytes from the remote send window. Returns false if insufficient."""
        val idx = self._find_local_index(local_id)
        if idx < 0:
            return false
        if self.channels[idx as u64].state == ChannelState.Closed:
            return false
        var rw = self.channels[idx as u64].remote_window
        if rw < bytes:
            return false
        self.channels[idx as u64].remote_window = rw - bytes
        true

    pub me consume_local_window(local_id: u32, bytes: u32) -> bool:
        """Admit peer data only on an open, non-EOF channel.

        The peer's string must fit both its remaining window and the maximum
        packet size that this endpoint advertised.
        """
        val idx = self._find_local_index(local_id)
        if idx >= 0:
            if self.channels[idx as u64].state != ChannelState.Open or self.channels[idx as u64].peer_eof:
                return false
            if bytes > self.channels[idx as u64].local_max_packet:
                return false
            var lw = self.channels[idx as u64].local_window
            if lw < bytes:
                return false
            self.channels[idx as u64].local_window = lw - bytes
            return true
        false

    pub me mark_peer_eof(local_id: u32) -> bool:
        """Record the peer's receive half-close exactly once."""
        val idx = self._find_local_index(local_id)
        if idx < 0 or self.channels[idx as u64].state != ChannelState.Open:
            return false
        if self.channels[idx as u64].peer_eof:
            return false
        self.channels[idx as u64].peer_eof = true
        true

    pub me remove_closed():
        """Remove all channels in Closed state."""
        var new_channels: [SshChannel] = []
        var i: u64 = 0
        while i < self.channels.len():
            var ch: SshChannel = self.channels[i]
            match ch.state:
                ChannelState.Closed:
                    pass_dn
                _:
                    new_channels.push(ch)
            i = i + 1
        self.channels = new_channels

    fn _find_local_index(local_id: u32) -> i64:
        var i: u64 = 0
        while i < self.channels.len():
            if self.channels[i].local_id == local_id:
                return i.to_i64()
            i = i + 1
        -1

# ============================================================================
# Message Parsing
# ============================================================================

fn ssh_parse_channel_open(data: [u8]) -> Result<(text, u32, u32, u32), text>:
    """Parse SSH_MSG_CHANNEL_OPEN.

    Format:
      byte      SSH_MSG_CHANNEL_OPEN (90)
      string    channel type ("session", "direct-tcpip", etc.)
      uint32    sender channel
      uint32    initial window size
      uint32    maximum packet size
      ... channel-type-specific data ...

    Returns: (channel_type, sender_channel, window, max_packet)
    """
    if data.len() < 2:
        return Err("CHANNEL_OPEN too short")
    if data[0] != SSH_MSG_CHANNEL_OPEN:
        return Err("not a CHANNEL_OPEN")

    var off: u64 = 1

    var ch_type: text = ""
    match ssh_get_text(data, off):
        Ok(type_pair):
            ch_type = type_pair.value
            off = type_pair.next_offset
        Err(_):
            return Err("CHANNEL_OPEN: bad channel type")

    if off + 12 > data.len():
        return Err("CHANNEL_OPEN: truncated")

    var sender: u32 = ssh_get_u32(data, off)
    off = off + 4
    var window: u32 = ssh_get_u32(data, off)
    off = off + 4
    var max_packet: u32 = ssh_get_u32(data, off)

    Ok((ch_type, sender, window, max_packet))

fn ssh_parse_channel_data(data: [u8]) -> Result<(u32, [u8]), text>:
    """Parse SSH_MSG_CHANNEL_DATA.

    Format:
      byte      SSH_MSG_CHANNEL_DATA (94)
      uint32    recipient channel
      string    data

    Returns: (recipient_channel, data_bytes)
    """
    if data.len() < 6:
        return Err("CHANNEL_DATA too short")
    if data[0] != SSH_MSG_CHANNEL_DATA:
        return Err("not a CHANNEL_DATA")

    var recipient: u32 = ssh_get_u32(data, 1)
    match ssh_get_string(data, 5):
        Ok(data_pair):
            Ok((recipient, data_pair.data))
        Err(_):
            Err("CHANNEL_DATA: bad data field")

fn ssh_parse_channel_request(data: [u8]) -> Result<(u32, text, bool, u64), text>:
    """Parse SSH_MSG_CHANNEL_REQUEST.

    Format:
      byte      SSH_MSG_CHANNEL_REQUEST (98)
      uint32    recipient channel
      string    request type ("pty-req", "shell", "exec", "env", etc.)
      boolean   want reply

    Returns: (recipient_channel, request_type, want_reply, offset_after_header)
    """
    if data.len() < 6:
        return Err("CHANNEL_REQUEST too short")
    if data[0] != SSH_MSG_CHANNEL_REQUEST:
        return Err("not a CHANNEL_REQUEST")

    var recipient: u32 = ssh_get_u32(data, 1)
    var off: u64 = 5

    var req_type: text = ""
    match ssh_get_text(data, off):
        Ok(type_pair):
            req_type = type_pair.value
            off = type_pair.next_offset
        Err(_):
            return Err("CHANNEL_REQUEST: bad type")

    if off >= data.len():
        return Err("CHANNEL_REQUEST: missing want_reply")
    var want_reply: bool = data[off] != 0
    off = off + 1

    Ok((recipient, req_type, want_reply, off))

fn ssh_parse_window_adjust(data: [u8]) -> Result<(u32, u32), text>:
    """Parse SSH_MSG_CHANNEL_WINDOW_ADJUST.

    Returns: (recipient_channel, bytes_to_add)
    """
    if data.len() < 9:
        return Err("WINDOW_ADJUST too short")
    if data[0] != SSH_MSG_CHANNEL_WINDOW_ADJUST:
        return Err("not a WINDOW_ADJUST")

    var recipient: u32 = ssh_get_u32(data, 1)
    var bytes_to_add: u32 = ssh_get_u32(data, 5)
    Ok((recipient, bytes_to_add))

fn ssh_parse_channel_eof(data: [u8]) -> Result<u32, text>:
    """Parse SSH_MSG_CHANNEL_EOF. Returns recipient channel."""
    if data.len() < 5:
        return Err("CHANNEL_EOF too short")
    if data[0] != SSH_MSG_CHANNEL_EOF:
        return Err("not a CHANNEL_EOF")
    Ok(ssh_get_u32(data, 1))

fn ssh_parse_channel_close(data: [u8]) -> Result<u32, text>:
    """Parse SSH_MSG_CHANNEL_CLOSE. Returns recipient channel."""
    if data.len() < 5:
        return Err("CHANNEL_CLOSE too short")
    if data[0] != SSH_MSG_CHANNEL_CLOSE:
        return Err("not a CHANNEL_CLOSE")
    Ok(ssh_get_u32(data, 1))

# ============================================================================
# Message Builders
# ============================================================================

fn ssh_build_channel_open_confirmation(recipient: u32, sender: u32, window: u32, max_packet: u32) -> [u8]:
    """Build SSH_MSG_CHANNEL_OPEN_CONFIRMATION."""
    var buf: [u8] = []
    buf.push(SSH_MSG_CHANNEL_OPEN_CONFIRMATION)
    buf = ssh_put_u32(buf, recipient)    # recipient channel (client's)
    buf = ssh_put_u32(buf, sender)       # sender channel (our local ID)
    buf = ssh_put_u32(buf, window)       # initial window size
    buf = ssh_put_u32(buf, max_packet)   # maximum packet size
    buf

fn ssh_build_channel_open_failure(recipient: u32, reason: u32, description: text) -> [u8]:
    """Build SSH_MSG_CHANNEL_OPEN_FAILURE."""
    var buf: [u8] = []
    buf.push(SSH_MSG_CHANNEL_OPEN_FAILURE)
    buf = ssh_put_u32(buf, recipient)
    buf = ssh_put_u32(buf, reason)
    buf = ssh_put_text(buf, description)
    buf = ssh_put_text(buf, "")     # language tag
    buf

fn ssh_build_channel_data(recipient: u32, payload: [u8]) -> [u8]:
    """Build SSH_MSG_CHANNEL_DATA."""
    var buf: [u8] = []
    buf.push(SSH_MSG_CHANNEL_DATA)
    buf = ssh_put_u32(buf, recipient)
    buf = ssh_put_string(buf, payload)
    buf

fn ssh_build_channel_window_adjust(recipient: u32, bytes: u32) -> [u8]:
    """Build SSH_MSG_CHANNEL_WINDOW_ADJUST."""
    var buf: [u8] = []
    buf.push(SSH_MSG_CHANNEL_WINDOW_ADJUST)
    buf = ssh_put_u32(buf, recipient)
    buf = ssh_put_u32(buf, bytes)
    buf

fn ssh_build_channel_eof(recipient: u32) -> [u8]:
    """Build SSH_MSG_CHANNEL_EOF."""
    var buf: [u8] = []
    buf.push(SSH_MSG_CHANNEL_EOF)
    buf = ssh_put_u32(buf, recipient)
    buf

fn ssh_build_channel_close(recipient: u32) -> [u8]:
    """Build SSH_MSG_CHANNEL_CLOSE."""
    var buf: [u8] = []
    buf.push(SSH_MSG_CHANNEL_CLOSE)
    buf = ssh_put_u32(buf, recipient)
    buf

fn ssh_build_channel_success(recipient: u32) -> [u8]:
    """Build SSH_MSG_CHANNEL_SUCCESS."""
    var buf: [u8] = []
    buf.push(SSH_MSG_CHANNEL_SUCCESS)
    buf = ssh_put_u32(buf, recipient)
    buf

fn ssh_build_channel_failure(recipient: u32) -> [u8]:
    """Build SSH_MSG_CHANNEL_FAILURE."""
    var buf: [u8] = []
    buf.push(SSH_MSG_CHANNEL_FAILURE)
    buf = ssh_put_u32(buf, recipient)
    buf

export ChannelTable, SshChannel, ChannelType, ChannelState, ChannelTerminalRequestV1
export ssh_parse_channel_open, ssh_parse_channel_data, ssh_parse_channel_request
export ssh_parse_window_adjust, ssh_parse_channel_eof, ssh_parse_channel_close
export ssh_build_channel_open_confirmation, ssh_build_channel_open_failure
export ssh_build_channel_data, ssh_build_channel_window_adjust
export ssh_build_channel_eof, ssh_build_channel_close
export ssh_build_channel_success, ssh_build_channel_failure
export SSH_MSG_CHANNEL_OPEN, SSH_MSG_CHANNEL_OPEN_CONFIRMATION, SSH_MSG_CHANNEL_OPEN_FAILURE, SSH_MSG_CHANNEL_DATA, SSH_MSG_CHANNEL_EXTENDED_DATA, SSH_MSG_CHANNEL_WINDOW_ADJUST, SSH_INVALID_CHANNEL_ID, SSH_MAX_CHANNELS_PER_SESSION
export SSH_MSG_CHANNEL_EOF, SSH_MSG_CHANNEL_CLOSE, SSH_MSG_CHANNEL_REQUEST
export DEFAULT_WINDOW_SIZE, DEFAULT_MAX_PACKET
