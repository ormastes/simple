# Stable SSH identification-line conversion and validation.

use os.apps.sshd.ssh_session_helpers.{ssh_session_u8_at, _slice_range, _copy_bytes_stable}

extern fn rt_push_byte(arr: [u8], byte_val: i64) -> [u8]

pub fn ssh_identification_text_to_bytes_stable(line: text) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < line.len():
        out = rt_push_byte(out, line.char_at(i).to_i64() & 0xFF)
        i = i + 1
    out

pub fn ssh_identification_bytes_start_ssh2(data: [u8]) -> bool:
    if data.len() < 8:
        return false
    ssh_session_u8_at(data, 0) == 0x53 and
        ssh_session_u8_at(data, 1) == 0x53 and
        ssh_session_u8_at(data, 2) == 0x48 and
        ssh_session_u8_at(data, 3) == 0x2D and
        ssh_session_u8_at(data, 4) == 0x32 and
        ssh_session_u8_at(data, 5) == 0x2E and
        ssh_session_u8_at(data, 6) == 0x30 and
        ssh_session_u8_at(data, 7) == 0x2D

pub fn ssh_identification_bytes_trim_crlf(data: [u8]) -> [u8]:
    if data.len() >= 2 and ssh_session_u8_at(data, data.len() - 2) == 0x0D and ssh_session_u8_at(data, data.len() - 1) == 0x0A:
        return _slice_range(data, 0, data.len() - 2)
    if data.len() >= 1 and (ssh_session_u8_at(data, data.len() - 1) == 0x0D or ssh_session_u8_at(data, data.len() - 1) == 0x0A):
        return _slice_range(data, 0, data.len() - 1)
    _copy_bytes_stable(data)
