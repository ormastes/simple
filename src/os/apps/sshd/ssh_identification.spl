# Stable SSH identification-line conversion and validation.

use os.apps.sshd.ssh_session_helpers.{ssh_session_u8_at, _slice_range, _copy_bytes_stable}

pub fn ssh_identification_text_to_bytes_stable(line: text) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < line.len():
        out.push((line.char_at(i).to_i64() & 0xFF).to_u8())
        i = i + 1
    out

pub fn ssh_identification_bytes_start_ssh2(data: [u8]) -> bool:
    if data.len() < 8:
        return false
    ssh_session_u8_at(data, 0) == 0x53 and
        ssh_session_u8_at(data, 1) == 0x53 and
        ssh_session_u8_at(data, 2) == 0x48 and
        ssh_session_u8_at(data, 3) == 0x2D and
        ssh_session_u8_at(data, 4) == 0x32 and
        ssh_session_u8_at(data, 5) == 0x2E and
        ssh_session_u8_at(data, 6) == 0x30 and
        ssh_session_u8_at(data, 7) == 0x2D

pub fn ssh_identification_bytes_valid_ssh2(data: [u8]) -> bool:
    """Validate one CRLF-trimmed RFC 4253 identification string.

    The wire line is limited to 255 bytes including CRLF, so the retained
    exchange-hash value can contain at most 253 bytes.  The protocol and
    software versions are printable US-ASCII tokens; a space is allowed only
    after a non-empty software version, where it begins the optional comment.
    Rejecting controls and non-ASCII bytes also prevents transcript/log
    confusion from attacker-controlled identification material.
    """
    if data.len() <= 8u64 or data.len() > 253u64:
        return false
    if not ssh_identification_bytes_start_ssh2(data):
        return false
    # `SSH-2.0-` must be followed by a non-empty software-version token.
    if ssh_session_u8_at(data, 8u64) == 0x20u8:
        return false
    var index: u64 = 8u64
    var comment_started = false
    while index < data.len():
        val byte = ssh_session_u8_at(data, index)
        if byte < 0x20u8 or byte > 0x7Eu8:
            return false
        if not comment_started and byte == 0x20u8:
            comment_started = true
        index = index + 1u64
    true

pub fn ssh_identification_bytes_trim_crlf(data: [u8]) -> [u8]:
    if data.len() >= 2 and ssh_session_u8_at(data, data.len() - 2) == 0x0D and ssh_session_u8_at(data, data.len() - 1) == 0x0A:
        return _slice_range(data, 0, data.len() - 2)
    if data.len() >= 1 and (ssh_session_u8_at(data, data.len() - 1) == 0x0D or ssh_session_u8_at(data, data.len() - 1) == 0x0A):
        return _slice_range(data, 0, data.len() - 1)
    _copy_bytes_stable(data)
