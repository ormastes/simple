# SSH filesystem-exec result contract shared by unsupported target paths.

# A command name that cannot be resolved is reported as 127.  A target whose
# filesystem-exec backend is unavailable after SSH accepted the request uses
# the distinct canonical shell status 126.  Empty output preserves the existing
# channel API; unsupported execution cannot claim captured or truncated data.
pub fn sshd_unsupported_architecture_exec_result_v1() -> ([u8], i64, bool):
    ([], 126, false)
