# SSH Session — Canonical Interactive Channel Owner (Phase 5)
#
# The SshSession instance remains the sole mutable session/channel/SFTP owner.
# This module contributes only cohesive impl methods and bounded wire helpers.

use os.apps.sshd.ssh_session.{SshSession, SshSessionState}
use os.apps.sshd.ssh_hex.{format_hex}
use os.apps.sshd.ssh_packet.{ssh_ascii_text_to_bytes}
use os.apps.sshd.ssh_transport.{SSH_MSG_DISCONNECT, SSH_MSG_IGNORE, SSH_MSG_KEXINIT}
use os.apps.sshd.ssh_channel.{ChannelState, SSH_MSG_CHANNEL_REQUEST, SSH_INVALID_CHANNEL_ID, SSH_MAX_CHANNELS_PER_SESSION, DEFAULT_WINDOW_SIZE, ssh_parse_channel_data, ssh_build_channel_window_adjust}
use os.apps.sshd.ssh_remote_shell.{SshRemoteShell}
use os.apps.sshd.ssh_sftp_v3.{SftpSessionV3}
use os.apps.sshd.ssh_session_helpers.{_u8_at, _copy_bytes_stable, _push_u32_be_stable, _read_u32_stable, _read_text_field_fast, _bytes_to_hex, _build_channel_success_stable, _build_channel_failure_stable, _build_channel_eof_stable, _build_channel_close_stable, _build_channel_exit_status_stable}
use os.kernel.log.klog_api.{log_info}
use std.common.string_core.{text_to_bytes}

extern fn rt_string_from_byte_array(arr: [u8]) -> text
extern fn rt_thread_sleep(ms: i64) -> i64
extern fn rt_push_byte(arr: [u8], byte_val: i64) -> [u8]
extern fn rt_bytes_concat(a: [u8], b: [u8]) -> [u8]
extern fn serial_println(msg: text)

fn _build_channel_data_stable(recipient: u32, data: [u8]) -> [u8]:
    var payload: [u8] = []
    payload = rt_push_byte(payload, 94)
    payload = _push_u32_be_stable(payload, recipient)
    payload = _push_u32_be_stable(payload, data.len().to_u32())
    # Copy the DATA via the `.push` intrinsic, NOT the `payload =
    # rt_push_byte(payload, ..)` reassignment form: on x86_64 freestanding
    # native-build the reassignment form drops the BYTE_PACKED representation
    # once the array grows large and corrupts the copy — this was the Inc-3
    # getfile 0x53-garbage bug (712-byte /hello.o delivered as garbage while
    # small handshake/exit packets, which stay inline-packed, delivered fine).
    # See _copy_bytes_stable's note. The 9-byte header above stays small enough
    # for the reassignment helpers.
    var i: u64 = 0
    while i < data.len():
        payload.push(_u8_at(data, i))
        i = i + 1
    payload

fn _payload_field_equals_bytes_stable(payload: [u8], field_offset: u64, expected: [u8]) -> bool:
    if field_offset + 4 > payload.len():
        return false
    val field_len = _read_u32_stable(payload, field_offset).to_u64()
    if field_len != expected.len():
        return false
    val start = field_offset + 4
    if start + field_len > payload.len():
        return false
    var i: u64 = 0
    while i < expected.len():
        if _u8_at(payload, start + i) != _u8_at(expected, i):
            return false
        i = i + 1
    true

fn _is_live_channel_open_session(payload: [u8]) -> bool:
    if payload.len() < 24:
        return false
    _u8_at(payload, 0) == 90 and
        _u8_at(payload, 1) == 0 and
        _u8_at(payload, 2) == 0 and
        _u8_at(payload, 3) == 0 and
        _u8_at(payload, 4) == 7 and
        _u8_at(payload, 5) == 0x73 and
        _u8_at(payload, 6) == 0x65 and
        _u8_at(payload, 7) == 0x73 and
        _u8_at(payload, 8) == 0x73 and
        _u8_at(payload, 9) == 0x69 and
        _u8_at(payload, 10) == 0x6F and
        _u8_at(payload, 11) == 0x6E

fn _field_range_equals_bytes_stable(payload: [u8], start: u64, end: u64, expected: [u8]) -> bool:
    if end < start:
        return false
    if end - start != expected.len():
        return false
    var i: u64 = 0
    while i < expected.len():
        if _u8_at(payload, start + i) != _u8_at(expected, i):
            return false
        i = i + 1
    true

pub fn ssh_channel_request_is_sftp(payload: [u8]) -> bool:
    """Recognize one exact RFC 4254 `subsystem` request for `sftp`."""
    if payload.len() < 23 or _u8_at(payload, 0) != SSH_MSG_CHANNEL_REQUEST:
        return false
    val request_len = _read_u32_stable(payload, 5).to_u64()
    val request_start: u64 = 9
    val request_end = request_start + request_len
    if request_end >= payload.len():
        return false
    if not _field_range_equals_bytes_stable(
        payload, request_start, request_end,
        [0x73, 0x75, 0x62, 0x73, 0x79, 0x73, 0x74, 0x65, 0x6D]
    ):
        return false
    val subsystem_offset = request_end + 1
    if not _payload_field_equals_bytes_stable(
        payload, subsystem_offset, [0x73, 0x66, 0x74, 0x70]
    ):
        return false
    subsystem_offset + 8 == payload.len()

pub fn ssh_sftp_principal_admitted(
    state: SshSessionState, principal: text, active_channels: i64
) -> bool:
    """Fail-closed SFTP admission at the canonical session/auth boundary.

    Parsing an SFTP subsystem request is not authorization.  The session owner
    admits it only after RFC 4252 authentication committed a non-empty
    principal, and only while the bounded channel table is non-empty and within
    its configured capacity.  This is deliberately independent of filesystem
    access; SftpSessionV3 remains the sole bounded protocol owner.
    """
    state == SshSessionState.Interactive and principal != "" and
        active_channels > 0 and active_channels <= SSH_MAX_CHANNELS_PER_SESSION

# Phase 2e Inc 3: scp-source (`scp -f <path>`) file retrieval. The FAT read
# below is a plain C buffer read (simpleos_fat32_stream_open/stream_read_at
# — the SAME primitive x86_64_fs_exec_spawn_heap already proved works
# POST rt_net_init+vmm+SSH activity, streaming the 124.6 MB clang ELF over
# real SSH, Phase 2e Inc 1), NOT a ring-3 CPL transition, so it is safe to
# call from this DEEP session-dispatch frame (unlike the ring-3 spawn, which
# must be deferred to the shallow accept-loop frame — see
# doc/08_tracking/bug/x64_ssh_kernel_fat32_stream_open_zero.md bug #2).
# x86_64-only: guarded with @cfg so shared sshd.spl/ssh_session.spl still
# compile for the rv64/arm SSH lanes (mirrors sshd.spl's
# _sshd_run_pending_ring3_exec per-arch stub pattern).
@cfg(x86_64)
extern fn simpleos_fat32_stream_open(path: text) -> i64
@cfg(x86_64)
extern fn simpleos_fat32_stream_read_at(file_off: u64, dst: u64, len: u64) -> i64
@cfg(x86_64)
extern fn simpleos_fat32_path_read_buffer_addr() -> u64
@cfg(x86_64)
extern fn mmio_read8(addr: u64) -> u8

fn _scp_ctrl_line(size: i64, name_bytes: [u8]) -> [u8]:
    """Build the scp-source `C0644 <size> <name>\n` control line as raw [u8].
    NEVER via text interpolation: on the x64 freestanding target, interpolating
    an int / dynamic-text field and converting the result to bytes yields an
    EMPTY buffer (same freestanding class as the char_code_at / text-store bugs
    — see doc/08_tracking/bug/x64_freestanding_char_code_at_dynamic_text.md).
    Manual base-10 digits + [u8] concat is the reliable path."""
    var digits: [u8] = []
    var v = size
    if v <= 0:
        digits = _copy_bytes_stable([0x30])
    else:
        while v > 0:
            var db: [u8] = []
            db = rt_push_byte(db, (v % 10) + 0x30)
            digits = rt_bytes_concat(db, digits)
            v = v / 10
    var out = _copy_bytes_stable([0x43, 0x30, 0x36, 0x34, 0x34, 0x20])
    out = rt_bytes_concat(out, digits)
    out = rt_bytes_concat(out, _copy_bytes_stable([0x20]))
    out = rt_bytes_concat(out, name_bytes)
    out = rt_bytes_concat(out, _copy_bytes_stable([0x0A]))
    out

@cfg(x86_64)
fn _scp_read_file_bytes(path: text) -> ([u8], i64):
    val fsize = simpleos_fat32_stream_open(path)
    if fsize <= 0 or fsize > 4194304:
        serial_println("[sshd-session] scp read-open-fail path={path} fsize={fsize}")
        return ([], -1)
    val buf = simpleos_fat32_path_read_buffer_addr()
    if buf == 0.to_u64():
        return ([], -1)
    val n = simpleos_fat32_stream_read_at(0.to_u64(), buf, fsize.to_u64())
    if n != fsize:
        serial_println("[sshd-session] scp read-short path={path} want={fsize} got={n}")
        return ([], -1)
    # Build the [u8] by reading each byte straight from the FAT buffer via
    # mmio_read8 (the proven Inc-1 raw-read idiom) — a Simple-native packed [u8]
    # that _u8_at reads reliably at any stack depth. (`b` is bound before
    # `.to_i64()` only for clarity; a chained form would work too.)
    var out: [u8] = []
    var i: u64 = 0
    while i < fsize.to_u64():
        val b = mmio_read8(buf + i)
        out = rt_push_byte(out, b.to_i64())
        i = i + 1
    (out, fsize)

@cfg(x86)
fn _scp_read_file_bytes(path: text) -> ([u8], i64):
    ([], -1)

@cfg(arm64)
fn _scp_read_file_bytes(path: text) -> ([u8], i64):
    ([], -1)

@cfg(arm32)
fn _scp_read_file_bytes(path: text) -> ([u8], i64):
    ([], -1)

@cfg(riscv64)
fn _scp_read_file_bytes(path: text) -> ([u8], i64):
    ([], -1)

@cfg(riscv32)
fn _scp_read_file_bytes(path: text) -> ([u8], i64):
    ([], -1)

# Raw [u8] scan helpers for the scp -f command — NEVER text.char_at/
# starts_with on dynamically-built text (mis-decodes; see
# doc/08_tracking/bug/x64_freestanding_char_code_at_dynamic_text.md). Mirrors
# sshd.spl's _sshd_tokenize_command idiom (text_to_bytes +
# rt_bytes_u8_at), just applied inline in this deep dispatch frame — bulk
# byte-array conversion is proven reliable at any stack depth (unlike the
# per-char text accessors), see that doc's workaround note.
fn _scp_last_token_bytes(command: text) -> [u8]:
    """Return the LAST whitespace-delimited token of `command` as raw bytes
    (the scp -f path — handles `scp -f /hello.o`, `scp -pf /hello.o`, etc.,
    since the path is always the final token regardless of flag combos)."""
    val bytes = text_to_bytes(command)
    var last: [u8] = []
    var cur: [u8] = []
    var i: i64 = 0
    val n = bytes.len().to_i64()
    while i < n:
        val code = rt_bytes_u8_at(bytes, i)
        if code == 32:
            if cur.len() > 0:
                last = cur
                cur = []
        else:
            cur = rt_push_byte(cur, code)
        i = i + 1
    if cur.len() > 0:
        last = cur
    last

fn _scp_basename_bytes(path_bytes: [u8]) -> [u8]:
    """Return the bytes after the last '/' in `path_bytes` (the scp control
    line's basename field)."""
    var last_slash: i64 = -1
    var i: i64 = 0
    val n = path_bytes.len().to_i64()
    while i < n:
        if rt_bytes_u8_at(path_bytes, i) == 0x2F:
            last_slash = i
        i = i + 1
    var out: [u8] = []
    var j = last_slash + 1
    while j < n:
        out = rt_push_byte(out, rt_bytes_u8_at(path_bytes, j))
        j = j + 1
    out

# ============================================================================
# Types
# ============================================================================

impl SshSession:

    me do_interactive():
        """Handle channel packets in the live session module."""
        log_info("[app.sshd] " + "[sshd-session] interactive")
        self.state = SshSessionState.Interactive
        serial_println("[sshd-session] interactive-inline enter state={self.state} recv_buf_len={self.recv_buf.len()} seq_c2s={self.cipher.seq_c2s}")
        var iterations: u64 = 0
        while iterations < 128:
            iterations = iterations + 1
            if self.state == SshSessionState.Closed:
                serial_println("[sshd-session] interactive-inline break closed")
                return

            self._forward_shell_output()

            val payload = self.recv_packet_payload()
            val payload_len = payload.len()
            if payload_len == 0:
                # Phase 2e Inc 3: during an in-flight scp-source handshake the
                # client's next single-byte ack may not have landed yet on this
                # non-blocking read — poll again instead of tearing the channel
                # down (a premature close here is what made scp report "closed by
                # remote host" after a correctly-sent C-record). Bounded by the
                # 128-iteration budget; the transfer is tiny + local.
                if self.scp_pending and self.scp_stage < 2u32:
                    rt_thread_sleep(5)
                    continue
                serial_println("[sshd-session] interactive-inline empty payload closing recv_buf_len={self.recv_buf.len()} seq_c2s={self.cipher.seq_c2s} recv_seq={self.recv_seq}")
                self.state = SshSessionState.Closed
                return

            val msg_type = _u8_at(payload, 0)
            serial_println("[sshd-session] interactive-inline msg_type=0x{format_hex(msg_type.to_i64())} len={payload_len} seq_c2s={self.cipher.seq_c2s}")

            if msg_type == 90:
                self._handle_channel_open(payload)
            elif msg_type == 94:
                self._handle_channel_data(payload)
            elif msg_type == 93:
                if payload.len() >= 9u64:
                    val recipient = _read_u32_stable(payload, 1u64)
                    val adjustment = _read_u32_stable(payload, 5u64)
                    if not self.channels.adjust_remote_window(recipient, adjustment):
                        self.state = SshSessionState.Closed
                        return
                continue
            elif msg_type == 96:
                # Peer EOF is half-close notification; retain the channel
                # until an explicit SSH_MSG_CHANNEL_CLOSE arrives.
                if payload.len() < 5u64 or not self.channels.mark_peer_eof(_read_u32_stable(payload, 1u64)):
                    self.state = SshSessionState.Closed
                    return
                continue
            elif msg_type == 97:
                self._handle_channel_close(payload)
            elif msg_type == 98:
                self._handle_channel_request(payload)
            elif msg_type == SSH_MSG_DISCONNECT:
                self.state = SshSessionState.Closed
                return
            elif msg_type == SSH_MSG_IGNORE:
                # RFC 4253 defines IGNORE as intentionally response-free.
                continue
            elif msg_type == SSH_MSG_KEXINIT:
                self.client_kexinit_payload = payload
                self.do_kex()
            else:
                serial_println("[sshd-session] interactive-inline ignore msg_type=0x{format_hex(msg_type.to_i64())}")

        serial_println("[sshd-session] interactive-inline iteration limit closing")
        self.state = SshSessionState.Closed

    me _handle_channel_open(payload: [u8]):
        serial_println("[sshd-session] inline channel_open len={payload.len()}")
        if payload.len() < 24 or _u8_at(payload, 0) != 90:
            return
        if not _is_live_channel_open_session(payload):
            serial_println("[sshd-session] inline channel_open unsupported type payload={_bytes_to_hex(payload)}")
            return
        val next_offset: u64 = 12
        if next_offset + 12 > payload.len():
            serial_println("[sshd-session] inline channel_open truncated payload={_bytes_to_hex(payload)}")
            return

        val remote_id = _read_u32_stable(payload, next_offset)
        val remote_window = _read_u32_stable(payload, next_offset + 4)
        val remote_max_packet = _read_u32_stable(payload, next_offset + 8)
        serial_println("[sshd-session] inline channel open=session remote_id={remote_id} window={remote_window}")
        val response = self.channels.session_channel_open_response(remote_id, remote_window, remote_max_packet)
        if response[0] == 91:
            self.active_remote_channel_id = remote_id
        serial_println("[sshd-session] inline channel_open response len={response.len()}")
        self.send_packet(response)

    me _handle_channel_request(payload: [u8]):
        if payload.len() < 11 or _u8_at(payload, 0) != 98:
            return
        val recipient = _read_u32_stable(payload, 1)
        if 9 > payload.len():
            return
        val request_len = _read_u32_stable(payload, 5).to_u64()
        val request_start: u64 = 9
        val request_end = request_start + request_len
        if request_end >= payload.len():
            return
        val want_reply = _u8_at(payload, request_end) != 0
        val off = request_end + 1
        val reply_remote_id =
            if recipient == 0:
                self.active_remote_channel_id
            else:
                val ch = self.channels.find(recipient)
                if ch != nil:
                    ch.remote_id
                else:
                    0u32

        if ssh_channel_request_is_sftp(payload):
            if not ssh_sftp_principal_admitted(
                self.state, self.authenticated_user,
                self.channels.channels.len().to_i64()
            ):
                if want_reply:
                    self.send_packet(_build_channel_failure_stable(reply_remote_id))
                return
            val channel = self.channels.find(recipient)
            if channel == nil or (self.sftp_enabled and self.sftp_local_channel_id != recipient):
                if want_reply:
                    self.send_packet(_build_channel_failure_stable(reply_remote_id))
                return
            self.sftp = SftpSessionV3.new()
            self.sftp_enabled = true
            self.sftp_local_channel_id = recipient
            if want_reply:
                self.send_packet(_build_channel_success_stable(reply_remote_id))
        elif self.sftp_enabled and self.sftp_local_channel_id == recipient:
            if want_reply:
                self.send_packet(_build_channel_failure_stable(reply_remote_id))
        elif _field_range_equals_bytes_stable(payload, request_start, request_end, [0x70, 0x74, 0x79, 0x2D, 0x72, 0x65, 0x71]):
            self._mark_channel_shell(recipient)
            if want_reply:
                self.send_packet(_build_channel_success_stable(reply_remote_id))
        elif _field_range_equals_bytes_stable(payload, request_start, request_end, [0x65, 0x6E, 0x76]):
            if want_reply:
                self.send_packet(_build_channel_success_stable(reply_remote_id))
        elif _field_range_equals_bytes_stable(payload, request_start, request_end, [0x73, 0x68, 0x65, 0x6C, 0x6C]):
            serial_println("[sshd-session] inline channel request=shell want_reply={want_reply}")
            self._mark_channel_shell(recipient)
            if want_reply:
                self.send_packet(_build_channel_success_stable(reply_remote_id))
            self._ensure_shell_started(true)
            self._forward_shell_output()
        elif _field_range_equals_bytes_stable(payload, request_start, request_end, [0x65, 0x78, 0x65, 0x63]):
            serial_println("[sshd-session] inline channel request=exec want_reply={want_reply}")
            self._handle_exec_request(payload, off, recipient, reply_remote_id, want_reply)
        elif _field_range_equals_bytes_stable(payload, request_start, request_end, [0x77, 0x69, 0x6E, 0x64, 0x6F, 0x77, 0x2D, 0x63, 0x68, 0x61, 0x6E, 0x67, 0x65]):
            # Resize metadata is accepted for compatibility; this shell has no
            # terminal geometry owner to update.
            if want_reply:
                self.send_packet(_build_channel_success_stable(reply_remote_id))
            return
        else:
            serial_println("[sshd-session] inline channel request unsupported payload={_bytes_to_hex(payload)}")
            if want_reply:
                self.send_packet(_build_channel_failure_stable(reply_remote_id))

    me _handle_exec_request(payload: [u8], off: u64, local_id: u32, remote_id: u32, want_reply: bool):
        val r_command = _read_text_field_fast(payload, off)
        if r_command.is_err():
            if want_reply:
                self.send_packet(_build_channel_failure_stable(remote_id))
            return

        val command = r_command.unwrap().value
        serial_println("[sshd-session] exec command={command}")
        self._mark_channel_shell(local_id)
        if want_reply:
            self.send_packet(_build_channel_success_stable(remote_id))

        if command.trim() == "true":
            self._finish_exec_request(local_id, remote_id, 0, [])
            return

        # Absolute-path command -> ring-3 filesystem exec of /FSEXEC.ELF. Detect the
        # leading '/' from the RAW payload byte (off+4 is the first byte of the exec
        # command string; off is its 4-byte length prefix) — text starts_with
        # mis-decodes on the x64 freestanding path. Pass the path as a LITERAL text
        # (rodata constant, marshals correctly to the C FAT open); the decoded
        # `command` mis-decodes ("/FSEXEC.ELF" -> "/E") via the x64 freestanding
        # text-return-into-store heap-tag mangling (root cause tracked in
        # doc/08_tracking/bug/x64_ssh_kernel_fat32_stream_open_zero.md). Send the
        # channel exit FIRST (spawn does not return on success; the connection drops).
        if _u8_at(payload, off + 4) == 0x2Fu8:
            serial_println("[sshd-session] exec ring3 DEFER absolute-path command={command}")
            # DEFER the ring-3 spawn out of this deep call stack. Spawning inline
            # here (many frames deep: run->loop->handle_packet->channel_request->
            # exec_request + crypto) faults in ring-0 before the spawn's first line
            # (kernel-stack overflow); the sshd accept loop runs it from a SHALLOW
            # frame (like the prod boot entry) instead. Set a pending flag; the accept
            # loop performs the spawn after run() returns and sends the real exit code.
            # Store the intact `command` text (whole-value store/compare is fine on
            # this deep frame — only per-char predicates are unreliable, see the
            # Phase 2e Inc 2 note below) so the shallow frame can tokenize argv[0]
            # itself instead of assuming a fixed "/FSEXEC.ELF" target (Phase 2 Lane A
            # PATH-resolution generalization — argv[0] already starts with '/' here,
            # so fs_exec_resolve returns it unchanged).
            # Store channel info so the accept loop can send the real exit status after spawn.
            self.pending_ring3_exec_remote_id = remote_id
            self.pending_ring3_exec_local_id = local_id
            self.pending_ring3_exec = true
            self.pending_ring3_exec_command = command
            self.state = SshSessionState.Closed
            return

        # Phase 2e Inc 1/2: a command beginning with 'c' (e.g. `ssh ... clang
        # -cc1 ...`) defers the CLANG heap-stream spawn instead of the plain
        # /FSEXEC.ELF path. TRIGGER detection stays the same RAW-byte test as
        # the '/' case above (per-char text predicates like `starts_with` are
        # unreliable this deep — see
        # doc/08_tracking/bug/x64_freestanding_text_char_at_starts_with.md
        # §Status point 3). The decoded `command` text ITSELF is fine to store
        # (rt_string_from_byte_array-into-field is fixed at HEAD, per the same
        # doc §Status point 2) — only per-char decode/predicates are broken
        # deep. So we store the intact `command` text here and let the
        # SHALLOW accept-loop frame (sshd.spl) tokenize it into argv; no
        # parsing happens in this deep frame (Phase 2e Inc 2).
        if _u8_at(payload, off + 4) == 0x63u8:
            serial_println("[sshd-session] exec ring3 DEFER command={command}")
            self.pending_ring3_exec_remote_id = remote_id
            self.pending_ring3_exec_local_id = local_id
            self.pending_ring3_exec = true
            self.pending_ring3_exec_command = command
            self.state = SshSessionState.Closed
            return

        # Phase 2e Inc 3 (getfile): `ssh root@host getfile /path` returns the raw
        # file bytes as channel stdout in ONE shot. Unlike scp, plain ssh has no
        # ack protocol — it just receives the channel-data (TCP-buffered) before
        # the exit-status/close, so a byte-exact download works without an
        # interactive handshake. Detect 'g' (0x67) by raw byte (deep text
        # predicates are unreliable — see x64_freestanding_text_char_at bug).
        if _u8_at(payload, off + 4) == 0x67u8:
            val gpath_bytes = _scp_last_token_bytes(command)
            val gpath_text = rt_string_from_byte_array(gpath_bytes)
            val (gfile_bytes, gfsize) = _scp_read_file_bytes(gpath_text)
            serial_println("[sshd-session] getfile path={gpath_text} fsize={gfsize} bytes={gfile_bytes.len()}")
            if gfsize <= 0:
                self._finish_exec_request(local_id, remote_id, 1, [])
                return
            self._finish_exec_request(local_id, remote_id, 0, gfile_bytes)
            return

        # Phase 2e Inc 3: `scp -f <path>` (legacy scp-source; `scp -O
        # root@host:/hello.o .` on the host runs this on the guest).
        # Detected via 4 RAW payload bytes ('s','c','p',' ') — same raw-byte
        # idiom as the '/' and 'c' branches above (deep text.starts_with is
        # unreliable — see
        # doc/08_tracking/bug/x64_freestanding_text_char_at_starts_with.md
        # §Status point 3); the 4-byte check also can't collide with the
        # unrelated "simple "/"simple.smf " exec commands handled below
        # (those differ at the 2nd byte: 'i' vs 'c'). UNLIKE the '/' and 'c'
        # branches, this does NOT defer to the shallow accept loop: the FAT
        # read is a plain C buffer read (no ring-3 CPL transition — see the
        # note above _scp_read_file_bytes), and the scp handshake needs this
        # SAME session's packet loop to keep delivering
        # SSH_MSG_CHANNEL_DATA acks, so `state` must stay Interactive.
        if (payload.len() >= off + 8 and
            _u8_at(payload, off + 4) == 0x73u8 and
            _u8_at(payload, off + 5) == 0x63u8 and
            _u8_at(payload, off + 6) == 0x70u8 and
            _u8_at(payload, off + 7) == 0x20u8):
            serial_println("[sshd-session] exec scp-source command={command}")
            val path_bytes = _scp_last_token_bytes(command)
            val name_bytes = _scp_basename_bytes(path_bytes)
            val path_text = rt_string_from_byte_array(path_bytes)
            val (file_bytes, fsize) = _scp_read_file_bytes(path_text)
            serial_println("[sshd-session] scp read path={path_text} fsize={fsize}")
            if fsize <= 0:
                self._finish_exec_request(local_id, remote_id, 1, [])
                return
            self.scp_pending = true
            self.scp_stage = 0
            self.scp_local_id = local_id
            self.scp_remote_id = remote_id
            self.scp_file_bytes = file_bytes
            self.scp_file_name = rt_string_from_byte_array(name_bytes)
            # Do NOT close state or send an exit status yet — wait for the
            # client's scp ready-ack (0x00) delivered as SSH_MSG_CHANNEL_DATA
            # and stepped by _scp_step (see _handle_channel_data).
            return

        # Phase 2 Lane A: generic PATH-resolved exec fallback for command
        # names that don't hit the '/' / 'c' / 'g' / "scp " raw-byte triggers
        # above (e.g. "nosuchcmd", or any future PATH-resolvable binary that
        # hasn't been given its own trigger byte). Same safe deferral as the
        # '/' and 'c' branches: store the intact `command` text and let the
        # SHALLOW accept-loop frame (sshd.spl `_sshd_run_pending_exec`)
        # tokenize argv[0], resolve it via fs_exec_resolve, and either spawn
        # it or return exit 127 "command not found" — never spawns from this
        # deep frame, and never falls into the interactive toy shell for a
        # one-shot `ssh host cmd` exec request.
        self.pending_ring3_exec_remote_id = remote_id
        self.pending_ring3_exec_local_id = local_id
        self.pending_ring3_exec = true
        self.pending_ring3_exec_command = command
        self.state = SshSessionState.Closed

    me _handle_channel_data(payload: [u8]):
        if self.sftp_enabled and not ssh_sftp_principal_admitted(
            self.state, self.authenticated_user,
            self.channels.channels.len().to_i64()
        ):
            # Authentication state is authoritative.  If it is absent or was
            # revoked, tear down the subsystem before parsing any attacker data.
            self.sftp = SftpSessionV3.new()
            self.sftp_enabled = false
            self.sftp_local_channel_id = SSH_INVALID_CHANNEL_ID
            return
        val parsed = ssh_parse_channel_data(payload)
        if parsed.is_err():
            return
        val channel_data = parsed.unwrap()
        val recipient = channel_data.0
        val data = channel_data.1
        if not self.channels.consume_local_window(recipient, data.len().to_u32()):
            return

        if self.sftp_enabled and recipient == self.sftp_local_channel_id:
            val channel = self.channels.find(recipient)
            if channel == nil:
                self.state = SshSessionState.Closed
                return
            var response = self.sftp.handle_packet(data)
            # Drain every complete coalesced frame already admitted by the
            # bounded SFTP owner. Each iteration consumes at least one framed
            # request, so work remains linear in the received bytes.
            while response.len() > 0:
                if response.len() > channel.remote_max_packet.to_u64():
                    self.state = SshSessionState.Closed
                    return
                if not self.channels.consume_remote_window(recipient, response.len().to_u32()):
                    self.state = SshSessionState.Closed
                    return
                self.send_packet(_build_channel_data_stable(channel.remote_id, response))
                response = self.sftp.handle_packet([])
            if channel.local_window < DEFAULT_WINDOW_SIZE / 2:
                val adjustment = DEFAULT_WINDOW_SIZE - channel.local_window
                if self.channels.adjust_window(recipient, adjustment):
                    self.send_packet(ssh_build_channel_window_adjust(channel.remote_id, adjustment))
            return

        if self.scp_pending and recipient == self.scp_local_id:
            self._scp_step(payload)
            return
        if val shell = self.shell:
            if not shell.feed_remote_input(rt_string_from_byte_array(data)):
                self.state = SshSessionState.Closed
            self._forward_shell_output()

    me _scp_step(payload: [u8]):
        """Drive the scp-source (`scp -f`) handshake state machine (Phase 2e
        Inc 3). Reads the client's single-byte ack directly via the raw [u8]
        accessor (never text) — the SSH_MSG_CHANNEL_DATA wire format is
        byte-type(1) + recipient(4) + string-len(4) + raw bytes, so the ack
        byte sits at payload offset 9. Stages:
          0: got the initial ready-ack -> send `C0644 <size> <name>\\n`
          1: got the ack for the control line -> send the file bytes + 0x00
          2: got the final ack -> send exit-status 0 / eof / close
        """
        if payload.len() < 10:
            return
        val data_len = _read_u32_stable(payload, 5).to_u64()
        if data_len < 1:
            return
        val ack = _u8_at(payload, 9)
        serial_println("[sshd-session] scp step stage={self.scp_stage} ack=0x{format_hex(ack.to_i64())}")
        # One-shot the whole scp-source response on the client's first ready-ack:
        # C-record + file bytes + trailing 0x00, then exit-status/eof/close.
        # OpenSSH's scp sink buffers pipelined data, so it need not receive the
        # intermediate ack before the body, and one-shotting avoids depending on
        # a persistent multi-stage cursor across reconnects (each new TCP
        # connection is a fresh SshSession with scp_stage=0). Re-entry after this
        # is harmless: _finish closes the channel, so any later ack's
        # window-consume fails and sends nothing.
        # (ctrl_len/body_len are bound before the sends only for readability; a
        # chained `.len().to_u32()` here would work too — the earlier
        # "chained-cast mis-lowering" theory did not reproduce; see
        # doc/08_tracking/bug/x64_freestanding_chained_len_cast_miscompile.md.)
        val size = self.scp_file_bytes.len().to_i64()
        val name_bytes = text_to_bytes(self.scp_file_name)
        val ctrl = _scp_ctrl_line(size, name_bytes)
        val ctrl_len = ctrl.len()
        serial_println("[sshd-session] scp one-shot size={size} ctrl_len={ctrl_len}")
        if self.channels.consume_remote_window(self.scp_local_id, ctrl_len.to_u32()):
            self.send_packet(_build_channel_data_stable(self.scp_remote_id, ctrl))
        val body = self.scp_file_bytes
        val body_len = body.len()
        if self.channels.consume_remote_window(self.scp_local_id, body_len.to_u32()):
            self.send_packet(_build_channel_data_stable(self.scp_remote_id, body))
        val zero: [u8] = _copy_bytes_stable([0])
        if self.channels.consume_remote_window(self.scp_local_id, 1u32):
            self.send_packet(_build_channel_data_stable(self.scp_remote_id, zero))
        self.scp_pending = false
        self._finish_exec_request(self.scp_local_id, self.scp_remote_id, 0, [])

    me _handle_channel_close(payload: [u8]):
        if payload.len() < 5:
            return
        val recipient = _read_u32_stable(payload, 1)
        val channel = self.channels.find(recipient)
        if channel == nil:
            self.state = SshSessionState.Closed
            return
        if self.sftp_enabled and recipient == self.sftp_local_channel_id:
            self.sftp = SftpSessionV3.new()
            self.sftp_enabled = false
            self.sftp_local_channel_id = SSH_INVALID_CHANNEL_ID
        val remote_id = channel.remote_id
        self.send_packet(_build_channel_close_stable(remote_id))
        self.channels.close(recipient)
        self.channels.remove_closed()
        if self.channels.channels.len() == 0:
            self.state = SshSessionState.Closed

    me _mark_channel_shell(local_id: u32):
        var i: u64 = 0
        while i < self.channels.channels.len():
            if self.channels.channels[i].local_id == local_id:
                self.channels.channels[i].shell_requested = true
            i = i + 1

    me _ensure_shell_started(show_prompt: bool):
        if self.shell != nil:
            return
        var shell = SshRemoteShell.new()
        if show_prompt:
            shell.show_prompt()
        self.shell = shell

    me _finish_exec_request(local_id: u32, remote_id: u32, exit_status: u32, output: [u8]):
        # Sends the command output as one channel-data packet, then
        # exit-status/eof/close. The real Inc-3 getfile fix was in
        # _build_channel_data_stable (`.push` vs the rt_push_byte reassignment
        # form — the latter dropped BYTE_PACKED for large [u8] and corrupted the
        # payload). An earlier `output.len().to_u32()`→bound-var change here was
        # NOT necessary: this chained form is proven to deliver byte-exact (see
        # doc/08_tracking/bug/x64_freestanding_chained_len_cast_miscompile.md,
        # which records that the chained-cast mis-lowering did not reproduce).
        if output.len() > 0 and self.channels.consume_remote_window(local_id, output.len().to_u32()):
            self.send_packet(_build_channel_data_stable(remote_id, output))
        self.send_packet(_build_channel_exit_status_stable(remote_id, exit_status))
        self.send_packet(_build_channel_eof_stable(remote_id))
        self.send_packet(_build_channel_close_stable(remote_id))
        self.channels.close(local_id)
        self.channels.remove_closed()
        if self.channels.channels.len() == 0:
            self.state = SshSessionState.Closed

    me _send_deferred_ring3_exec_response():
        """Send the real exit status for a deferred ring-3 execution after the spawn completes.

        Called from the accept loop after _sshd_run_pending_exec() returns the exit code.
        """
        if self.pending_ring3_exec:
            val remote_id = self.pending_ring3_exec_remote_id
            val local_id = self.pending_ring3_exec_local_id
            var exit_code = self.pending_ring3_exec_exit_code.to_u32()
            if self.pending_ring3_exec_stdout.len() > 0:
                if self.channels.consume_remote_window(local_id, self.pending_ring3_exec_stdout.len().to_u32()):
                    self.send_packet(_build_channel_data_stable(remote_id, self.pending_ring3_exec_stdout))
                else:
                    # Do not silently drop a real child result and then report
                    # success. This bounded one-shot response has no retained
                    # window-adjust buffer, so fail closed before EOF/CLOSE.
                    exit_code = SSH_EXIT_REMOTE_WINDOW_EXHAUSTED
                    serial_println("[sshd] deferred exec stdout blocked by remote window; reporting rc={exit_code} bytes={self.pending_ring3_exec_stdout.len()}")
            if self.pending_ring3_exec_stdout_truncated:
                serial_println("[sshd] deferred exec stdout truncated bytes={self.pending_ring3_exec_stdout.len()}")
            serial_println("[sshd] sending deferred exit-status rc={exit_code} remote_id={remote_id}")
            self.send_packet(_build_channel_exit_status_stable(remote_id, exit_code))
            self.send_packet(_build_channel_eof_stable(remote_id))
            self.send_packet(_build_channel_close_stable(remote_id))
            self.channels.close(local_id)
            self.channels.remove_closed()

    me _forward_shell_output():
        if self.shell == nil:
            return
        if val shell = self.shell:
            val output = shell.take_remote_output()
            if output != "":
                self._send_shell_output(ssh_ascii_text_to_bytes(output))

    me _send_shell_output(output: [u8]):
        if output.len() == 0:
            return
        var i: u64 = 0
        while i < self.channels.channels.len():
            val ch = self.channels.channels[i]
            if ch.shell_requested:
                match ch.state:
                    ChannelState.Open:
                        val send_len = output.len().to_u32()
                        if self.channels.consume_remote_window(ch.local_id, send_len):
                            self.send_packet(_build_channel_data_stable(ch.remote_id, output))
                        return
                    _:
                        # A non-open channel cannot receive shell output.
                        return
            i = i + 1
