# SSH session terminal lifecycle owner.

use os.apps.sshd.ssh_session.{SshSession, SshSessionState}
use os.apps.sshd.ssh_channel.{ChannelTable, SSH_INVALID_CHANNEL_ID}
use os.apps.sshd.ssh_sftp_v3.{SftpSessionV3}

impl SshSession:
    pub me transition_transport_failed():
        """Invalidate encrypted transport ownership after authentication failure.

        An AEAD/MAC failure is terminal for an SSH connection.  Keeping the
        cipher active after returning an empty payload lets outer protocol
        loops mistake authentication failure for an incomplete read and retry
        with the same key/sequence state.  Clear all peer-controlled buffered
        bytes and traffic secrets before publishing Closed.
        """
        self.recv_ring.clear()
        self.cipher.active = false
        self.enc_key_c2s = []
        self.enc_key_s2c = []
        self.iv_c2s = []
        self.iv_s2c = []
        self.mac_key_c2s = []
        self.mac_key_s2c = []
        self.ctr_counter_c2s = []
        self.ctr_counter_s2c = []
        self.transition_closed()

    pub me transition_closed():
        """Close SFTP objects and clear ownership before entering Closed."""
        # Terminal invalidation precedes publication of Closed.  This owner is
        # presently consumed only by ARM64; x86/RV session behavior is otherwise
        # unchanged and no loader adapter is reachable through this core seam.
        match self.arm64_request_contexts:
            case Some(owner):
                owner.daemon_drain()
                self.arm64_request_contexts = Some(owner)
            case nil: ()
        self.sftp.close_all()
        self.sftp_enabled = false
        self.sftp_local_channel_id = SSH_INVALID_CHANNEL_ID
        self.sftp_tx_pending = []
        self.sftp_tx_head = 0u64
        self.exec_tx = []
        # A transport failure or final connection close cannot receive the
        # next SCP ACK/WINDOW_ADJUST. Release the retained file before Closed
        # is observable rather than waiting for socket-owner finalization.
        self.scp_pending = false
        self.scp_stage = 0u32
        self.scp_local_id = 0u32
        self.scp_remote_id = 0u32
        self.scp_file_bytes = []
        self.scp_file_name = ""
        self.state = SshSessionState.Closed

    pub me release_terminal_resources():
        """Release all connection-owned state after the socket is closed.

        `transition_closed` deliberately preserves deferred-exec fields: the
        shallow daemon frame must consume them after the deep protocol loop
        exits.  Once the daemon closes the socket, however, no channel, shell,
        transfer, authentication, or traffic-secret state may remain owned by
        the session.  Keeping this as a distinct terminal boundary preserves
        deferred execution while making repeated final cleanup idempotent.
        """
        self.transition_closed()
        self.channels = ChannelTable.new()
        self.shell = nil
        self.sftp = SftpSessionV3.new()

        self.pending_ring3_exec = false
        self.pending_ring3_exec_exit_code = 0u32
        self.pending_ring3_exec_stdout = []
        self.pending_ring3_exec_stdout_truncated = false
        self.pending_ring3_exec_admitted = false
        self.pending_ring3_exec_want_reply = false
        self.pending_ring3_exec_remote_id = 0u32
        self.pending_ring3_exec_local_id = 0u32
        self.pending_ring3_exec_command = ""

        self.scp_pending = false
        self.scp_stage = 0u32
        self.scp_local_id = 0u32
        self.scp_remote_id = 0u32
        self.scp_file_bytes = []
        self.scp_file_name = ""

        self.authenticated_user = ""
        self.capability_authenticated = false
        self.capability_channel_opened = false
        self.capability_sftp_opened = false
        self.active_remote_channel_id = 0u32
        self.recv_ring.clear()

        self.cipher.active = false
        self.session_id = []
        self.enc_key_c2s = []
        self.enc_key_s2c = []
        self.iv_c2s = []
        self.iv_s2c = []
        self.mac_key_c2s = []
        self.mac_key_s2c = []
        self.ctr_counter_c2s = []
        self.ctr_counter_s2c = []
