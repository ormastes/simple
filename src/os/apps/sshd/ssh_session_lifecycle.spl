# SSH session terminal lifecycle owner.

use os.apps.sshd.ssh_session.{SshSession, SshSessionState}
use os.apps.sshd.ssh_channel.{SSH_INVALID_CHANNEL_ID}

impl SshSession:
    pub me transition_closed():
        """Close SFTP objects and clear ownership before entering Closed."""
        self.sftp.close_all()
        self.sftp_enabled = false
        self.sftp_local_channel_id = SSH_INVALID_CHANNEL_ID
        self.state = SshSessionState.Closed
