use std.string_builder.{StringBuilder}

class SshRemoteShell:
    input_line: text
    output: text
    running: bool

impl SshRemoteShell:

    static fn new() -> SshRemoteShell:
        SshRemoteShell(
            input_line: "",
            output: "SimpleOS Shell v0.2\nType 'help' for available commands.\n\n",
            running: true
        )

    me show_prompt():
        self.output = "{self.output}user@simpleos:/# $ "

    me feed_remote_input(input: text) -> bool:
        """Feed remote bytes into the shell, executing each completed line.

        Iterates by single-character text slice rather than `for ch in input`:
        char values produced by text iteration do not compare equal to char
        literals (every `ch == '\n'` was false), so the old loop never
        terminated a line and therefore never executed a command — the session
        returned banner + prompt only.
        """
        var i: u64 = 0
        while i < input.len():
            val c = input[i:i + 1]
            if c == "\r":
                i = i + 1
            else:
                if c == "\n":
                    self.output = "{self.output}\n"
                    self._execute_line(self.input_line.trim())
                    self.input_line = ""
                    if self.running:
                        self.show_prompt()
                else:
                    self.input_line = "{self.input_line}{c}"
                i = i + 1
        self.running

    me take_remote_output() -> text:
        val out = self.output
        self.output = ""
        out

    me _execute_line(line: text):
        if line == "":
            return
        if line == "exit":
            self.running = false
            return
        if line == "help":
            self.output = "{self.output}Built-ins: echo help pwd true whoami exit\n"
            return
        if line == "pwd":
            self.output = "{self.output}/\n"
            return
        if line == "whoami":
            self.output = "{self.output}root\n"
            return
        if line == "true":
            return
        if line.starts_with("echo "):
            self.output = "{self.output}{line.slice(5, line.len())}\n"
            return
        self.output = "{self.output}command not found: {line}\n"
