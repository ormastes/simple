# Bounded SSH connection-layer global-request classification.
#
# The authenticated SshSession owns dispatch. This leaf observes the immutable
# packet and returns a scalar decision; it retains no request bytes or mutable
# connection state.

val SSH_MSG_GLOBAL_REQUEST: u8 = 80u8
val SSH_MSG_REQUEST_FAILURE: u8 = 82u8

enum SshGlobalRequestDecisionV1:
    Malformed
    NoReply
    ReplyFailure

fn _global_request_u32_be(payload: [u8], offset: u64) -> u32:
    payload[offset].to_u32() * 16777216u32 +
        payload[offset + 1u64].to_u32() * 65536u32 +
        payload[offset + 2u64].to_u32() * 256u32 +
        payload[offset + 3u64].to_u32()

pub fn ssh_global_request_classify(
    payload: [u8]
) -> SshGlobalRequestDecisionV1:
    """Classify one complete RFC 4254 global request without retaining bytes.

    Unknown request-specific trailing fields are intentionally not decoded.
    RFC 4254 requires an unsupported request with `want-reply` to receive
    REQUEST_FAILURE. OpenSSH deliberately uses an otherwise-unsupported
    `keepalive@openssh.com` request with `want-reply` to elicit either response,
    so it follows the same failure path as every other unsupported request.
    """
    if payload.len() < 6u64 or payload[0u64] != SSH_MSG_GLOBAL_REQUEST:
        return SshGlobalRequestDecisionV1.Malformed
    val name_len = _global_request_u32_be(payload, 1u64).to_u64()
    val name_start: u64 = 5u64
    # Reserve one byte for want-reply before forming name_start + name_len.
    # This admits every complete u32-sized SSH string, including an empty name,
    # without overflow or a profile-specific semantic length limit.
    if name_len > payload.len() - 6u64:
        return SshGlobalRequestDecisionV1.Malformed
    val want_reply_offset = name_start + name_len
    if want_reply_offset >= payload.len():
        return SshGlobalRequestDecisionV1.Malformed
    val want_reply = payload[want_reply_offset] != 0u8
    if not want_reply:
        return SshGlobalRequestDecisionV1.NoReply
    SshGlobalRequestDecisionV1.ReplyFailure

pub fn ssh_global_request_reply_payload(
    decision: SshGlobalRequestDecisionV1
) -> [u8]:
    """Return the bounded one-byte response, or empty when none is allowed."""
    match decision:
        SshGlobalRequestDecisionV1.ReplyFailure: [SSH_MSG_REQUEST_FAILURE]
        _: []

export SshGlobalRequestDecisionV1
export SSH_MSG_GLOBAL_REQUEST, SSH_MSG_REQUEST_FAILURE
