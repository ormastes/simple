# Generation-bound lifecycle owner for one SSH session's deferred filesystem
# execution.  SshSession is the sole mutable owner and the shallow daemon frame
# is its only consumer; no mutable payload crosses an execution domain.

pub val SSH_DEFERRED_EXEC_COMMAND_MAX_V1: u64 = 4096u64
pub val SSH_DEFERRED_EXEC_STDOUT_MAX_V1: u64 = 4194304u64

pub enum SshDeferredExecStateV1:
    Idle
    LaunchPending
    LaunchClaimed
    ExecutedResponsePending
    ResponseConsuming
    Consumed
    Terminal

# A handle is an exact scalar coordinate.  It carries neither the command nor
# the result and therefore cannot independently recreate deferred work.
pub struct SshDeferredExecHandleV1:
    generation: u64
    nonce: u64
    request_ordinal: u64
    local_id: u32
    remote_id: u32

pub struct SshDeferredExecClaimV1:
    handle: SshDeferredExecHandleV1
    local_id: u32
    remote_id: u32
    want_reply: bool
    command: text

pub struct SshDeferredExecResponseV1:
    handle: SshDeferredExecHandleV1
    local_id: u32
    remote_id: u32
    want_reply: bool
    exit_code: u32
    stdout: [u8]
    stdout_truncated: bool
    admitted: bool

pub class SshDeferredExecOwnerV1:
    state: SshDeferredExecStateV1
    generation: u64
    nonce: u64
    next_nonce: u64
    request_ordinal: u64
    local_id: u32
    remote_id: u32
    want_reply: bool
    command: text
    exit_code: u32
    stdout: [u8]
    stdout_truncated: bool
    admitted: bool

impl SshDeferredExecOwnerV1:
    pub static fn create() -> SshDeferredExecOwnerV1:
        SshDeferredExecOwnerV1(
            state: SshDeferredExecStateV1.Idle,
            generation: 0u64,
            nonce: 0u64,
            next_nonce: 0u64,
            request_ordinal: 0u64,
            local_id: 0u32,
            remote_id: 0u32,
            want_reply: false,
            command: "",
            exit_code: 0u32,
            stdout: [],
            stdout_truncated: false,
            admitted: false)

    fn _handle_matches(handle: SshDeferredExecHandleV1) -> bool:
        handle.generation != 0u64 and handle.nonce != 0u64 and
            handle.request_ordinal != 0u64 and
            self.generation == handle.generation and self.nonce == handle.nonce and
            self.request_ordinal == handle.request_ordinal and
            self.local_id == handle.local_id and self.remote_id == handle.remote_id

    fn _handle() -> SshDeferredExecHandleV1:
        SshDeferredExecHandleV1(
            generation: self.generation,
            nonce: self.nonce,
            request_ordinal: self.request_ordinal,
            local_id: self.local_id,
            remote_id: self.remote_id)

    pub fn lifecycle_state() -> SshDeferredExecStateV1:
        self.state

    pub fn is_launch_pending() -> bool:
        self.state == SshDeferredExecStateV1.LaunchPending

    pub fn can_admit() -> bool:
        self.state == SshDeferredExecStateV1.Idle or
            self.state == SshDeferredExecStateV1.Consumed

    pub me admit(
        local_id: u32, remote_id: u32, want_reply: bool, command: text
    ) -> Option<SshDeferredExecHandleV1>:
        if not self.can_admit() or command.len() == 0u64 or
            command.len() > SSH_DEFERRED_EXEC_COMMAND_MAX_V1:
            return nil
        # Neither identity component may wrap.  Exhaustion terminalizes the
        # session-local owner so a stale handle can never become live again.
        if self.generation == 0xffffffffffffffffu64 or
            self.next_nonce == 0xffffffffffffffffu64 or
            self.request_ordinal == 0xffffffffffffffffu64:
            self.close()
            return nil
        self.generation = self.generation + 1u64
        self.next_nonce = self.next_nonce + 1u64
        self.request_ordinal = self.request_ordinal + 1u64
        self.nonce = self.next_nonce
        self.local_id = local_id
        self.remote_id = remote_id
        self.want_reply = want_reply
        self.command = command
        self.exit_code = 0u32
        self.stdout = []
        self.stdout_truncated = false
        self.admitted = false
        self.state = SshDeferredExecStateV1.LaunchPending
        Some(self._handle())

    pub me claim() -> Option<SshDeferredExecClaimV1>:
        if self.state != SshDeferredExecStateV1.LaunchPending:
            return nil
        val handle = self._handle()
        val claim = SshDeferredExecClaimV1(
            handle: handle,
            local_id: self.local_id,
            remote_id: self.remote_id,
            want_reply: self.want_reply,
            command: self.command)
        # Commit LaunchClaimed and remove the sole retryable command before the
        # caller can spawn.  There is deliberately no rollback transition.
        self.command = ""
        self.state = SshDeferredExecStateV1.LaunchClaimed
        Some(claim)

    pub me publish_result(
        handle: SshDeferredExecHandleV1,
        stdout: [u8], exit_code: u32, stdout_truncated: bool, admitted: bool
    ) -> bool:
        if self.state != SshDeferredExecStateV1.LaunchClaimed or
            not self._handle_matches(handle) or
            stdout.len() > SSH_DEFERRED_EXEC_STDOUT_MAX_V1:
            return false
        self.stdout = stdout
        self.exit_code = exit_code
        self.stdout_truncated = stdout_truncated
        self.admitted = admitted
        self.state = SshDeferredExecStateV1.ExecutedResponsePending
        true

    pub me begin_response(
        handle: SshDeferredExecHandleV1
    ) -> Option<SshDeferredExecResponseV1>:
        if self.state != SshDeferredExecStateV1.ExecutedResponsePending or
            not self._handle_matches(handle):
            return nil
        val response = SshDeferredExecResponseV1(
            handle: handle,
            local_id: self.local_id,
            remote_id: self.remote_id,
            want_reply: self.want_reply,
            exit_code: self.exit_code,
            stdout: self.stdout,
            stdout_truncated: self.stdout_truncated,
            admitted: self.admitted)
        # ResponseConsuming is non-retryable.  The retained result is removed
        # before any transport call; send failure can drop bytes but cannot
        # republish the command or spawn it again.
        self.stdout = []
        self.stdout_truncated = false
        self.admitted = false
        self.state = SshDeferredExecStateV1.ResponseConsuming
        Some(response)

    pub me finish_response(handle: SshDeferredExecHandleV1) -> bool:
        if self.state != SshDeferredExecStateV1.ResponseConsuming or
            not self._handle_matches(handle):
            return false
        self.local_id = 0u32
        self.remote_id = 0u32
        self.want_reply = false
        self.exit_code = 0u32
        self.state = SshDeferredExecStateV1.Consumed
        true

    pub me close():
        # Terminal close is idempotent and releases every dynamic payload.
        self.command = ""
        self.stdout = []
        self.local_id = 0u32
        self.remote_id = 0u32
        self.want_reply = false
        self.exit_code = 0u32
        self.stdout_truncated = false
        self.admitted = false
        self.state = SshDeferredExecStateV1.Terminal
