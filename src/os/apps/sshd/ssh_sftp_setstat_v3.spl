# Strict, bounded SFTP v3 SETSTAT/FSETSTAT request codec.
#
# This module does not execute filesystem operations.  It decodes the SIZE and
# PERMISSIONS subset for the session owner, which retains filesystem authority
# and handle state.  In particular, decoding FSETSTAT is not an assertion that
# every requested mutation can be executed by the available handle facades.

use os.apps.sshd.ssh_packet.{ssh_get_u32}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}

pub val SSH_FXP_SETSTAT_V3: u8 = 9u8
pub val SSH_FXP_FSETSTAT_V3: u8 = 10u8
pub val SSH_FILEXFER_ATTR_SIZE_V3: u32 = 0x00000001u32
pub val SSH_FILEXFER_ATTR_PERMISSIONS_V3: u32 = 0x00000004u32

val SFTP_SETSTAT_MAX_PACKET_V3: u64 = 35000u64
val SFTP_SETSTAT_MAX_PATH_V3: u64 = 4096u64
val SFTP_SETSTAT_MAX_HANDLE_V3: u64 = 256u64

pub enum SftpSetstatTargetKindV3:
    Path
    Handle

pub struct SftpSetstatRequestV3:
    target_kind: SftpSetstatTargetKindV3
    request_id: u32
    path: text
    handle: [u8]
    has_size: bool
    size: u64
    has_permissions: bool
    mode: u16

fn _setstat_copy_v3(data: [u8], start: u64, length: u64) -> [u8]:
    var out: [u8] = []
    var index: u64 = 0u64
    while index < length:
        out.push(data[start + index])
        index = index + 1u64
    out

fn _setstat_path_admitted_v3(bytes: [u8]) -> bool:
    if bytes.len() == 0u64 or bytes.len() > SFTP_SETSTAT_MAX_PATH_V3 or
        bytes[0u64] != 47u8:
        return false
    var component_len: u64 = 0u64
    var component_dots: u64 = 0u64
    var index: u64 = 1u64
    while index < bytes.len():
        val byte = bytes[index]
        if byte == 0u8:
            return false
        if byte == 47u8:
            if component_len == 1u64 and component_dots == 1u64:
                return false
            if component_len == 2u64 and component_dots == 2u64:
                return false
            component_len = 0u64
            component_dots = 0u64
        else:
            component_len = component_len + 1u64
            if byte == 46u8 and component_dots + 1u64 == component_len:
                component_dots = component_dots + 1u64
        index = index + 1u64
    not ((component_len == 1u64 and component_dots == 1u64) or
        (component_len == 2u64 and component_dots == 2u64))

fn _setstat_string_v3(
    frame: [u8], offset: u64, maximum: u64
) -> Result<([u8], u64), text>:
    if offset > frame.len() or frame.len() - offset < 4u64:
        return Err("truncated SETSTAT target length")
    val length = ssh_get_u32(frame, offset).to_u64()
    if length == 0u64 or length > maximum:
        return Err("invalid SETSTAT target length")
    val start = offset + 4u64
    if start > frame.len() or length > frame.len() - start:
        return Err("truncated SETSTAT target")
    Ok((_setstat_copy_v3(frame, start, length), start + length))

pub fn sftp_setstat_request_id_v3(frame: [u8]) -> u32:
    """Return the request id when its fixed prefix exists, otherwise zero."""
    if frame.len() < 9u64:
        return 0u32
    ssh_get_u32(frame, 5u64)

pub fn sftp_setstat_decode_v3(frame: [u8]) -> Result<SftpSetstatRequestV3, text>:
    """Decode the SIZE/PERMISSIONS subset of one complete v3 SETSTAT request.

    FSETSTAT is decoded to an opaque handle target for session-owner validation.
    UID/GID, times, extensions, empty attributes, and unknown flags are rejected
    rather than silently ignored.
    """
    if frame.len() < 17u64 or frame.len() > SFTP_SETSTAT_MAX_PACKET_V3 + 4u64:
        return Err("invalid SETSTAT request length")
    val declared = ssh_get_u32(frame, 0u64).to_u64()
    if declared + 4u64 != frame.len():
        return Err("invalid SETSTAT request framing")
    val kind = frame[4u64]
    if kind != SSH_FXP_SETSTAT_V3 and kind != SSH_FXP_FSETSTAT_V3:
        return Err("not an SFTP v3 SETSTAT request")
    val maximum = if kind == SSH_FXP_SETSTAT_V3:
        SFTP_SETSTAT_MAX_PATH_V3
    else:
        SFTP_SETSTAT_MAX_HANDLE_V3
    val target = _setstat_string_v3(frame, 9u64, maximum)?
    val after_target = target.1
    if after_target > frame.len() or frame.len() - after_target < 4u64:
        return Err("invalid SETSTAT attributes length")
    val flags = ssh_get_u32(frame, after_target)
    val supported = SSH_FILEXFER_ATTR_SIZE_V3 |
        SSH_FILEXFER_ATTR_PERMISSIONS_V3
    if flags == 0u32 or (flags & supported) != flags:
        return Err("unsupported SETSTAT attributes")
    val has_size = (flags & SSH_FILEXFER_ATTR_SIZE_V3) != 0u32
    val has_permissions =
        (flags & SSH_FILEXFER_ATTR_PERMISSIONS_V3) != 0u32
    val expected_attributes = 4u64 + (if has_size: 8u64 else: 0u64) +
        (if has_permissions: 4u64 else: 0u64)
    if frame.len() - after_target != expected_attributes:
        return Err("invalid SETSTAT attributes length")
    var attribute_offset = after_target + 4u64
    var size: u64 = 0u64
    if has_size:
        size = (ssh_get_u32(frame, attribute_offset).to_u64() << 32u64) |
            ssh_get_u32(frame, attribute_offset + 4u64).to_u64()
        attribute_offset = attribute_offset + 8u64
        if size > 0x7FFFFFFFFFFFFFFFu64:
            return Err("SETSTAT size exceeds supported range")
    var mode: u16 = 0u16
    if has_permissions:
        mode = (ssh_get_u32(frame, attribute_offset) & 0xFFFu32).to_u16()
    if kind == SSH_FXP_FSETSTAT_V3:
        return Ok(SftpSetstatRequestV3(
            target_kind: SftpSetstatTargetKindV3.Handle,
            request_id: ssh_get_u32(frame, 5u64), path: "",
            handle: target.0, has_size: has_size, size: size,
            has_permissions: has_permissions, mode: mode))
    if not _setstat_path_admitted_v3(target.0):
        return Err("SETSTAT path denied")
    match validated_utf8_bytes_to_text_linear(target.0):
        Err(_): Err("SETSTAT path is not valid UTF-8")
        Ok(decoded_path): Ok(SftpSetstatRequestV3(
            target_kind: SftpSetstatTargetKindV3.Path,
            request_id: ssh_get_u32(frame, 5u64), path: decoded_path,
            handle: [], has_size: has_size, size: size,
            has_permissions: has_permissions, mode: mode))

pub fn sftp_setstat_is_path_v3(request: SftpSetstatRequestV3) -> bool:
    match request.target_kind:
        case SftpSetstatTargetKindV3.Path: true
        case _: false

pub fn sftp_setstat_is_handle_v3(request: SftpSetstatRequestV3) -> bool:
    match request.target_kind:
        case SftpSetstatTargetKindV3.Handle: true
        case _: false

export SftpSetstatTargetKindV3, SftpSetstatRequestV3
export sftp_setstat_decode_v3, sftp_setstat_request_id_v3
export sftp_setstat_is_path_v3, sftp_setstat_is_handle_v3
