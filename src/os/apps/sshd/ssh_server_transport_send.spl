# Pure-Simple ownership model for one synchronous SSH server TCP write.

const SSH_SERVER_SEND_RETRY_WINDOW: u64 = 4096u64
const SSH_SERVER_SEND_MAX_ATTEMPTS: u64 = 64u64

class SshServerSendCursorV1:
    sent: u64 = 0u64
    attempts: u64 = 0u64
    retry_limit: u64 = SSH_SERVER_SEND_RETRY_WINDOW

struct SshServerSendRangeV1:
    start: u64
    end: u64

impl SshServerSendRangeV1:
    pub fn len() -> u64:
        self.end - self.start

pub fn ssh_server_send_offer_v1(
    cursor: SshServerSendCursorV1, total: u64
) -> Result<SshServerSendRangeV1, text>:
    """Borrow the next exact range without advancing transport ownership."""
    if cursor.sent > total:
        return Err("send cursor exceeded buffer length")
    if cursor.sent == total:
        return Ok(SshServerSendRangeV1(start: total, end: total))
    if cursor.attempts >= SSH_SERVER_SEND_MAX_ATTEMPTS:
        return Err("transport write attempt limit exceeded")
    val remaining = total - cursor.sent
    if cursor.attempts == 0u64:
        return Ok(SshServerSendRangeV1(start: cursor.sent, end: total))
    val adaptive = if cursor.retry_limit < SSH_SERVER_SEND_RETRY_WINDOW:
        cursor.retry_limit
    else:
        SSH_SERVER_SEND_RETRY_WINDOW
    if remaining <= adaptive:
        return Ok(SshServerSendRangeV1(start: cursor.sent, end: total))
    Ok(SshServerSendRangeV1(
        start: cursor.sent,
        end: cursor.sent + adaptive
    ))

pub fn ssh_server_send_accept_v1(
    cursor: SshServerSendCursorV1,
    total: u64,
    offered: u64,
    wrote: i64
) -> Result<bool, text>:
    """Commit exactly the bytes acknowledged by one transport write."""
    val range_result = ssh_server_send_offer_v1(cursor, total)
    if range_result.is_err():
        return Err(range_result.unwrap_err())
    val expected = range_result.unwrap().len()
    if expected == 0u64 or offered != expected:
        return Err("send offer did not match cursor")
    if wrote < 0:
        return Err("transport write failed: {wrote}")
    if wrote == 0:
        return Err("transport write made no progress")
    val advanced = wrote.to_u64()
    if advanced > offered:
        return Err("transport write exceeded offer")
    # The `[u8]` runtime boundary cannot loan an offset/length view. Bound
    # retry allocation/dispatch independently of packet size so adversarial
    # one-byte progress fails closed instead of driving O(total) allocations.
    if cursor.attempts >= SSH_SERVER_SEND_MAX_ATTEMPTS:
        return Err("transport write attempt limit exceeded")
    cursor.sent = cursor.sent + advanced
    cursor.attempts = cursor.attempts + 1u64
    # Never copy more bytes on the next retry than the transport just
    # accepted. This makes total staged bytes O(total), including a hostile
    # one-byte-at-a-time transport. Small writes still require O(total) small
    # arrays because `[u8]` has no native offset/length loan on this boundary.
    cursor.retry_limit = advanced
    Ok(cursor.sent == total)

pub fn ssh_server_committed_sequences_v1(
    send_seq: u32, cipher_seq: u32, encrypted: bool, complete: bool
) -> (u32, u32):
    """Commit packet sequence ownership only after exact wire delivery."""
    if not complete:
        return (send_seq, cipher_seq)
    val next_send = (send_seq + 1u32) & 0xFFFFFFFFu32
    val next_cipher = if encrypted:
        (cipher_seq + 1u32) & 0xFFFFFFFFu32
    else:
        cipher_seq
    (next_send, next_cipher)

export SSH_SERVER_SEND_RETRY_WINDOW, SSH_SERVER_SEND_MAX_ATTEMPTS
export SshServerSendCursorV1
export SshServerSendRangeV1, ssh_server_send_offer_v1
export ssh_server_send_accept_v1, ssh_server_committed_sequences_v1
