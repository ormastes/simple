# SSH Session — Per-client connection handler
# Lifecycle: version -> key exchange -> authentication -> channel -> shell.
#
# Implementation is split across:
#   ssh_session_helpers.spl  — extern fns, constants, structs, low-level helpers
#   ssh_session_kex.spl      — Phase 2: key exchange (do_kex)
#   ssh_session_auth.spl     — Phase 3+4: service request and authentication
#   ssh_session_channel.spl  — Phase 5: interactive channel management
use os.apps.sshd.ssh_packet.{SshPacket, SshTextResult, SshStringResult, ssh_packet_build, ssh_put_u32, ssh_put_string, ssh_put_text, ssh_put_byte, ssh_put_bool, ssh_get_u32, ssh_get_string, ssh_get_text, ssh_ascii_text_to_bytes}
use os.apps.sshd.ssh_transport.{SshKexInit, SshAlgorithms, SSH_MSG_KEXINIT, SSH_MSG_NEWKEYS, SSH_MSG_DISCONNECT, SSH_MSG_IGNORE, SSH_MSG_DEBUG, SSH_DISCONNECT_PROTOCOL_ERROR, ssh_build_version_string, ssh_parse_kexinit, ssh_negotiate_algorithms, ssh_build_service_accept, ssh_parse_service_request, ssh_build_disconnect, ssh_build_ext_info_server_sig_algs, ssh_kex_uses_strict_kex}
use os.apps.sshd.ssh_kex.{ssh_build_kex_ecdh_reply, ssh_parse_kex_ecdh_init, ssh_build_newkeys, ssh_build_kexinit_for_host_keys_and_certs}
use os.apps.sshd.ssh_kex_core.{ssh_kex_compute_exchange_hash, ssh_derive_keys}
use os.apps.sshd.ssh_kex_primitives.{HostKeySet, HostCertificateSet, SshKexState, SshSessionKeys, SSH_MSG_KEX_ECDH_INIT, SSH_MSG_KEX_ECDH_REPLY, ssh_build_ed25519_host_key_blob}
use os.apps.sshd.ssh_cipher_live.{SshCipher, ssh_encrypt_packet_aes_gcm, ssh_decrypt_packet_aes_gcm, ssh_decrypt_packet_aes256_gcm_payload_direct, ssh_encrypt_packet_aes128_gcm, ssh_decrypt_packet_aes128_gcm}
use os.apps.sshd.ssh_sftp_v3.{SftpSessionV3}
use os.apps.sshd.ssh_auth.{SshUserDb, SshAuthRequest, SSH_MSG_USERAUTH_REQUEST, SSH_MSG_USERAUTH_PK_OK, MAX_AUTH_ATTEMPTS, ssh_parse_auth_request, ssh_check_public_key_auth, ssh_build_auth_success, ssh_build_auth_failure, ssh_build_auth_banner, ssh_build_userauth_pk_ok, ssh_build_userauth_info_request, ssh_parse_userauth_info_response}
use os.apps.sshd.ssh_channel.{ChannelTable, SSH_INVALID_CHANNEL_ID}
use os.apps.sshd.ssh_hex.{format_hex}
use os.apps.sshd.ssh_recv_ring.{SshRecvRing, ssh_recv_ring_new}
use os.apps.sshd.rsa_pubkey.{ssh_rsa_blob_to_spki_der}
use os.apps.sshd.ssh_remote_shell.{SshRemoteShell}
use os.kernel.log.klog_api.{log_info}
use os.kernel.net.rt_net_socket_facade.{rt_net_send_bytes, rt_net_send_ssh_banner, rt_net_recv_bytes, rt_net_recv_ssh_plain_packet_payload, rt_net_recv_ssh_encrypted_packet, rt_net_ssh_encrypted_read_plan, rt_net_recv_version_text, rt_net_recv_version_bytes, rt_net_close}
use os.crypto.ed25519.{ed25519_keypair_from_seed, ed25519_sign}
use os.apps.sshd.ssh_identification.{ssh_identification_text_to_bytes_stable, ssh_identification_bytes_start_ssh2, ssh_identification_bytes_trim_crlf}

pub fn ssh_recv_ring_u32_be(ring: SshRecvRing, offset: u64) -> u32:
    """Read a big-endian u32 out of the receive ring without materializing it."""
    if offset + 4u64 > ring.len():
        return 0u32
    val b0 = ring.byte_at(offset).to_u32()
    val b1 = ring.byte_at(offset + 1u64).to_u32()
    val b2 = ring.byte_at(offset + 2u64).to_u32()
    val b3 = ring.byte_at(offset + 3u64).to_u32()
    (b0 * 16777216u32) + (b1 * 65536u32) + (b2 * 256u32) + b3

pub fn ssh_encrypted_packet_frame_allowed(packet: [u8]) -> bool:
    """Validate a complete OpenSSH AES-GCM wire frame before observation."""
    if packet.len() < 20u64:
        return false
    val packet_length = ssh_get_u32(packet, 0)
    val plan = rt_net_ssh_encrypted_read_plan(packet_length)
    if plan == nil:
        return false
    packet.len() == plan.unwrap().total_frame_bytes

# Pull in helpers and split impl blocks
use os.apps.sshd.ssh_session_helpers.{RECV_BUF_SIZE, PlainPacketHeader, _SshTextField, ssh_session_u8_at, _slice_range, _zeroed_32_bytes, _copy_bytes_stable, _copy_prefix_stable, _publickey_only_auth_failure_payload, _build_plain_packet_header, _zero_padding_bytes, _copy_range_stable, _push_u32_be_stable, _build_channel_open_confirmation_stable, _build_channel_success_stable, _build_channel_failure_stable, _build_channel_eof_stable, _build_channel_close_stable, _build_channel_exit_status_stable, _read_u32_stable, _read_text_field_fast, _parse_kexinit_fast, _is_ssh_userauth_service_request, _text_equals_bytes, _payload_text_field_equals_bytes, _payload_field_is_ssh_connection, _payload_field_is_none, _payload_field_is_password, _payload_field_is_publickey, _bytes_to_hex, _ed25519_public_key_from_seed, ssh_validate_kex_payload, ssh_validate_kex_ecdh_init_payload, ssh_validate_newkeys_payload}
export use os.apps.sshd.ssh_session_kex.*
