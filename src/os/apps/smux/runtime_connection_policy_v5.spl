# V5 consumes the enrolled policy; requests cannot replace its principal/rights.
# V4 Linux continues to use its existing protected configuration loader.
use std.nogc_sync_mut.orchestration.host_local_root_v3.HostLocalRootV3
use std.nogc_sync_mut.orchestration.host_primary_connection_policy_v3.host_primary_connection_policy_bytes_v3
use std.common.contracts.mux.session_runtime_control_v1.SessionRuntimeControlKindV1
use os.apps.smux.runtime_control_policy_v1.{SmuxRuntimeControlPolicyV1, smux_runtime_control_policy_decode_v1}

# The signed-enrollment LinuxService has no direct terminal provider, and its enrolled broker policy (v4
# linux-host-service-broker-policy) is a different, disjoint schema that is never decoded as a control policy. Its
# control policy is this fixed constant: the single Input right of its V4 agent pane and nothing else (no Geometry:
# Resize is refused on V4 and no installed-policy source exists), and a short lease. It is a compile-time CEILING, not
# a grant: the right is exercised only while host_linux_service_agent_terminal_authority_v4 is Ok, which every control
# issue, every pane Write and capabilities_v5 re-ask (an expired or revoked approval ends it mid-connection). The
# policy cannot be derived from that authority here: this loader runs at open, before any agent attach exists, and
# the owner compares a reloaded policy against the opened one, so a derived policy would flip after attach. The lease
# TTL bounds only the monotonic control lease; the approval's wall-clock expiry is enforced by the per-Write re-check.
fn linux_service_agent_pane_policy_v5() -> SmuxRuntimeControlPolicyV1:
    SmuxRuntimeControlPolicyV1(principal_id: "linux-service-agent-pane", allowed: [SessionRuntimeControlKindV1.Input],
        max_lease_ms: 5000)

pub fn smux_runtime_connection_policy_load_v5(local: HostLocalRootV3) -> Result<SmuxRuntimeControlPolicyV1, text>:
    match local:
        case HostLocalRootV3.LinuxService(service):
            val current = service.current_v4()?
            return Ok(linux_service_agent_pane_policy_v5())
        case _: pass
    val bytes = host_primary_connection_policy_bytes_v3(local)?
    smux_runtime_control_policy_decode_v1(bytes)
