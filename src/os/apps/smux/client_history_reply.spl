# Interactive history replies keep newest whole lines within the wire budget.
# Public history capture keeps its own explicit-limit semantics unchanged.
use std.common.text_bytes.{text_to_bytes}

pub fn client_history_reply(prefix: text, content: text, limit: i64 = 65536) -> Result<text, text>:
    var used = text_to_bytes(prefix).len()
    if used > limit:
        return Err("client history prefix exceeds reply limit")
    if content == "":
        return Ok(prefix)
    val trailing_newline = content.ends_with("\n")
    var lines = content.split("\n")
    if trailing_newline:
        lines = lines[0:lines.len() - 1]
    var retained = 0
    var index = lines.len() - 1
    var inspected = 0
    # The client-history caller requests at most 2000 rows. Retain the same
    # finite newest-row window even if another caller supplies more lines.
    while index >= 0 and inspected < 2000:
        val line = lines[index]
        var cost = text_to_bytes(line).len()
        if retained > 0 or trailing_newline:
            cost = cost + 1
        if cost > limit - used:
            if retained == 0:
                return Err("newest client history line exceeds reply limit")
            break
        retained = retained + 1
        used = used + cost
        index = index - 1
        inspected = inspected + 1
    val ending = if trailing_newline: "\n" else: ""
    return Ok(prefix + lines[index + 1:].join("\n") + ending)

export client_history_reply
