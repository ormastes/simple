# Pure default-key decoder. Controller owns sessions, copy state and effects.
# Input bytes are forwarded exactly; a prefix may span successive read chunks.
# Text cannot carry a split scalar: the runtime replaces malformed UTF-8 with
# U+FFFD, so a read chunk stays [u8] until the client frames it for the pane.
use std.common.text_bytes.{bytes_to_text}
struct ClientInputState:
    prefix: bool

struct ClientInputAction:
    kind: text
    data: [u8]

struct ClientInputStep:
    state: ClientInputState
    actions: [ClientInputAction]

pub fn client_input_new() -> ClientInputState:
    return ClientInputState(prefix: false)

fn _client_input_binding(key: text) -> text:
    if key == "d": return "detach"
    if key == "%": return "split-vertical"
    if key == "\"": return "split-horizontal"
    if key == "c": return "new-window"
    if key == "n": return "next-window"
    if key == "o": return "next-pane"
    if key == "z": return "toggle-zoom"
    if key == " ": return "cycle-layout"
    if key == "[": return "copy-mode"
    if key == "k": return "copy-up"
    if key == "j": return "copy-down"
    if key == "q": return "copy-exit"
    return ""

pub fn client_input_feed(state: ClientInputState, data: [u8]) -> ClientInputStep:
    var prefix = state.prefix
    var input: [u8] = []
    var actions: [ClientInputAction] = []
    # Match only ASCII control/binding bytes, so a UTF-8 fragment is never decoded.
    for byte in data:
        if prefix:
            prefix = false
            val binding = if byte < 128: _client_input_binding(bytes_to_text([byte])) else: ""
            if byte == 2:
                input.push(byte)
            elif binding == "":
                # Unknown bindings are transparent, including the prefix.
                input.push(2)
                input.push(byte)
            else:
                if input.len() > 0:
                    actions.push(ClientInputAction(kind: "input", data: input))
                    input = []
                actions.push(ClientInputAction(kind: binding, data: []))
        elif byte == 2:
            prefix = true
        else:
            input.push(byte)
    if input.len() > 0:
        actions.push(ClientInputAction(kind: "input", data: input))
    return ClientInputStep(state: ClientInputState(prefix: prefix), actions: actions)

export ClientInputState, ClientInputAction, ClientInputStep
export client_input_new, client_input_feed
