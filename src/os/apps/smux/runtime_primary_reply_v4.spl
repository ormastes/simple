use os.apps.smux.runtime_binding_state_v3.{SmuxRuntimeBindingOwnerV3, SmuxRuntimeBindingTurnV3}
use os.apps.smux.runtime_primary_state_v4.SmuxRuntimePrimaryEntryV4
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical

pub fn smux_primary_reply_v4(owner: SmuxRuntimeBindingOwnerV3, uid: text, status: text,
        code: text, digest: text = "", binding_digest: text = "", stream_owned: bool = false,
        release_pending: bool = false) -> SmuxRuntimeBindingTurnV3:
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("smux-primary-binding-reply"),
        "bindingUid": SdnValue.String(uid), "serviceIncarnation": SdnValue.String(owner.service_incarnation),
        "status": SdnValue.String(status), "code": SdnValue.String(code), "requestDigest": SdnValue.String(digest),
        "bindingDigest": SdnValue.String(binding_digest), "streamOwned": SdnValue.Bool(stream_owned),
        "hostReleasePending": SdnValue.Bool(release_pending), "outputMode": SdnValue.String("primary-attach"),
        "inputSupported": SdnValue.Bool(false), "geometrySupported": SdnValue.Bool(false), "interactive": SdnValue.Bool(false)}
    SmuxRuntimeBindingTurnV3(owner, sdn_encode_canonical(SdnValue.Dict(fields)))

pub fn smux_primary_entry_reply_v4(owner: SmuxRuntimeBindingOwnerV3,
        entry: SmuxRuntimePrimaryEntryV4) -> SmuxRuntimeBindingTurnV3:
    smux_primary_reply_v4(owner, entry.request.target.binding_uid, entry.status, entry.code,
        entry.plan.request_digest, entry.plan.identity.binding_digest, entry.adopted and entry.status == "adopted-opening",
        entry.status != "released")

pub fn smux_primary_capabilities_v4(configured: bool) -> text:
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("smux-primary-binding-capabilities"),
        "authenticationScope": SdnValue.String("trusted-local-owner"), "planningSupported": SdnValue.Bool(configured),
        "primaryPlanRequired": SdnValue.Bool(true), "inputSupported": SdnValue.Bool(false),
        "inputControlProtocol": SdnValue.String("runtime-primary-control-v4"),
        "geometryControlProtocol": SdnValue.String("runtime-primary-control-v4"),
        "geometryAttemptRequired": SdnValue.Bool(true),
        "geometrySupported": SdnValue.Bool(false), "interactive": SdnValue.Bool(false),
        "outputMode": SdnValue.String("primary-attach"), "qualification": SdnValue.String("source-only-not-run"),
        "reason": SdnValue.String(if configured: "provider-plan-and-signed-helper-required" else: "host-policy-unavailable")}
    sdn_encode_canonical(SdnValue.Dict(fields))
