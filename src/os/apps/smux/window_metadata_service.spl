# Pure metadata transform. The API owns publication and closing/write guards.
use os.apps.smux.contract.{MuxWindow, MuxPane}
use os.apps.smux.service.{ServiceState, PaneRecord}
use std.common.contracts.mux.request_validation_v1.{mux_validate_name_v1}

# Caller admits registry capacity and owns the generated identifiers.
pub fn add_window_state(before: ServiceState, session_id: text, name: text, window_id: text, pane_id: text) -> ServiceState:
    val window = MuxWindow.create(window_id, session_id, name)
    var st = before.add_window(window)
    st = st.add_pane(PaneRecord.create(MuxPane.create(pane_id, window_id, session_id)).with_focus(true))
    st.with_next_id(before.next_id + 2)

# Caller validates membership and writable/closing fences before publication.
pub fn activate_window_state(before: ServiceState, session_id: text, window_id: text) -> ServiceState:
    var st = before
    var i = 0
    while i < st.window_count:
        val w = st.get_window(i)
        if w.session_id == session_id:
            st = st.replace_window(i, w.with_active(w.id == window_id))
        i = i + 1
    st

pub fn rename_window_state(st: ServiceState, session_id: text, window_id: text, name: text) -> Result<ServiceState, text>:
    """Rename one existing member without changing identity, geometry or children."""
    val index = st.find_window_idx(window_id)
    if st.find_session_idx(session_id) < 0 or index < 0:
        return Err("unknown session or window")
    val window = st.get_window(index)
    if window.session_id != session_id: return Err("window does not belong to session")
    val valid = mux_validate_name_v1(name)
    if valid.is_err(): return Err(valid.unwrap_err().detail)
    # Names are display labels, not identity; duplicates and ID-like names are valid.
    if name == window.name: return Ok(st)
    val renamed = MuxWindow(id: window.id, session_id: window.session_id, name: name,
        is_active: window.is_active, layout: window.layout,
        canvas_cols: window.canvas_cols, canvas_rows: window.canvas_rows,
        manual_rects: window.manual_rects, manual_cols: window.manual_cols,
        manual_rows: window.manual_rows, zoom_pane: window.zoom_pane,
        presentation: window.presentation)
    return Ok(st.replace_window(index, renamed))
