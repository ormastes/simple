# Independent foreground owner for hosted smux. Request clients can exit while
# this process keeps every pane and drains its output. No thread shares _svc.
# TCP/ConPTY provider availability must be qualified on the selected runtime.
use std.io.tcp.{TcpListener, TcpStream, tcp_backend_set_nonblocking}
use std.common.string_core.{bytes_to_text, text_to_bytes}
use std.sosix.time.{sosix_time_now_monotonic_ms as time_now_monotonic_ms,
    sosix_sleep_ms as thread_sleep_ms}
use std.sosix.pty.{sosix_pty_cleanup_pending as pty_cleanup_pending}
use std.sosix.stdio.{sosix_println}
use os.apps.smux.api.{smux_poll_output, smux_reset_for_test, smux_reap_expired_clients,
    smux_owner_snapshot, smux_configuration_revision, smux_window_closing}
use os.apps.smux.service.ServiceState
use os.apps.smux.smux_remote.{smux_remote_dispatch}
use os.apps.smux.runtime_binding_protocol_v1.{smux_runtime_binding_capabilities_v1, smux_runtime_binding_refusal_v3}
use os.apps.smux.client_leases.{SMUX_CLIENT_LEASE_SWEEP_MS}
use std.common.crypto.constant_time.{constant_time_compare}
use std.nogc_sync_mut.io.file_ops.{file_read, file_write}
use std.nogc_sync_mut.io.retained_file.{RetainedPrivateCredentialV1,
    retained_private_credential_open_v1, retained_private_credential_read_v1,
    retained_private_credential_publish_v1, retained_private_credential_close_v1}
use std.common.task_runner.distributed_operation_journal_v2.{DistributedOperationJournalOpenCleanupV2,
    distributed_operation_journal_open_cleanup_v2}
use std.nogc_sync_mut.io.file_lock_owned_v2.FileLockReleaseStateV2
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.sosix.entropy.sosix_random_hex
use std.common.build_manager.contracts.builder_identifier_valid_v1
use os.apps.smux.smux_runtime_control_owner_v1.{SmuxRuntimeControlOwnerV1, smux_runtime_control_owner_new_v1}
use os.apps.smux.runtime_control_policy_v1.smux_runtime_control_policy_load_v1
use os.apps.smux.runtime_control_request_v1.smux_runtime_control_request_from_token_v1
use os.apps.smux.runtime_control_service_v1.{smux_runtime_control_service_v1, smux_runtime_control_sweep_v1}
use os.apps.smux.runtime_binding_request_v3.smux_runtime_bind_request_from_token_v3
use os.apps.smux.runtime_binding_target_v3.{smux_runtime_target_v3, smux_runtime_target_encode_v3}
use os.apps.smux.runtime_binding_target_create_v3.smux_runtime_target_create_v3
use os.apps.smux.runtime_binding_owner_v3.{SmuxRuntimeBindingOwnerV3,
    smux_runtime_binding_owner_open_v3, smux_runtime_binding_owner_close_v3,
    smux_runtime_binding_plan_v3, smux_runtime_binding_bind_v3, smux_runtime_binding_inspect_v3,
    smux_runtime_binding_prepare_v3,
    smux_runtime_binding_capabilities_v3, smux_runtime_binding_stop_allowed_v3}

const REQUEST_LIMIT: i64 = 4096
const REPLY_LIMIT: i64 = 65536
const CLIENT_LIMIT: i64 = 16
const CLIENT_DEADLINE_MS: i64 = 2000

# Exclusive in-process host/smux composition, not an independent host daemon.
# No wire request selects its root or policy; the host holds one journal writer.
var _runtime_binding_owner: SmuxRuntimeBindingOwnerV3? = nil
# Installed once per service incarnation, after protected host startup. A
# malformed/absent policy denies controls without enabling legacy authority.
var _runtime_control_owner: SmuxRuntimeControlOwnerV1? = nil
var _runtime_credential_owner: RetainedPrivateCredentialV1? = nil
var _runtime_journal_cleanup: DistributedOperationJournalOpenCleanupV2? = nil
var _runtime_journal_cleanup_state: FileLockReleaseStateV2? = nil
var _runtime_configured: bool = false
var _runtime_cleanup_only: bool = false
var _runtime_host_released: bool = false
var _runtime_credential_consumed: bool = false

# Only native/host owned turns can advance these local observations. They
# never authorize descriptor IO or a new writer; native generations do that.
fn runtime_close_host_v3() -> bool:
    if _runtime_host_released: return true
    if _runtime_binding_owner != nil:
        val outcome = smux_runtime_binding_owner_close_v3(_runtime_binding_owner.unwrap())
        if outcome.is_err(): return false
        val closed = outcome.unwrap()
        _runtime_binding_owner = nil
        _runtime_journal_cleanup = closed.cleanup
        _runtime_journal_cleanup_state = Some(closed.state)
        _runtime_cleanup_only = true
        _runtime_host_released = (closed.state == FileLockReleaseStateV2.Released and closed.closed and
            closed.cleanup == nil and closed.error == "")
        return _runtime_host_released
    if _runtime_journal_cleanup != nil:
        val closed = distributed_operation_journal_open_cleanup_v2(_runtime_journal_cleanup.unwrap())
        _runtime_journal_cleanup = closed.cleanup
        _runtime_journal_cleanup_state = Some(closed.state)
        _runtime_host_released = (closed.state == FileLockReleaseStateV2.Released and closed.closed and
            closed.cleanup == nil and closed.error == "")
    _runtime_host_released

fn runtime_close_credential_v3() -> bool:
    if _runtime_credential_consumed: return false
    if _runtime_credential_owner == nil: return false
    val closed = retained_private_credential_close_v1(_runtime_credential_owner.unwrap())
    _runtime_credential_owner = closed.owner
    _runtime_credential_consumed = closed.consumed
    # A consumed-error is explicit uncertainty, not success or retry authority.
    if closed.completed and closed.consumed and closed.error == "":
        _runtime_credential_owner = nil
        return true
    false

fn runtime_stop_reply_v3() -> text:
    if (_runtime_binding_owner != nil and
            not smux_runtime_binding_stop_allowed_v3(_runtime_binding_owner.unwrap())):
        return "smux: stop refused: runtime helper cleanup or host release pending"
    if smux_server_stop_reply_v1(smux_owner_snapshot()) != "smux: stopping server":
        return "smux: stop refused: terminal cleanup or host release pending"
    _runtime_cleanup_only = true
    _runtime_control_owner = nil
    # Close the real host writer while the authenticated recovery listener is
    # still available. No success response precedes actual owned release.
    if not runtime_close_host_v3(): return "smux: stop refused: host writer cleanup unconfirmed"
    if not runtime_close_credential_v3(): return "smux: stop refused: credential cleanup unconfirmed"
    "smux: stopping server"

class PendingClient:
    stream: TcpStream
    input: [u8]
    output: [u8]
    offset: i64
    deadline: i64
    replying: bool
    stop_owner: bool

fn valid_token(token: text) -> bool:
    return token != "" and token.len() <= 128 and not token.contains(" ") and not token.contains("\t") and not token.contains("\r") and not token.contains("\n")

fn local_endpoint(address: text) -> bool:
    if not address.starts_with("127.0.0.1:"):
        return false
    val parts = address.split(":")
    if parts.len() != 2:
        return false
    val port = parts[1].to_int() ?? 0
    return port > 0 and port <= 65535

# Pure stop admission; no native handle, signal or process lookup is performed.
pub fn smux_server_stop_reply_v1(snapshot: ServiceState) -> text:
    var index = 0
    while index < snapshot.pane_count:
        val pane = snapshot.get_pane(index)
        if (pane.owned_terminal_transfer != nil or pane.helper_cleaned_awaiting_release or
                pane.terminal_ref != nil):
            return "smux: stop refused: terminal cleanup or host release pending"
        index = index + 1
    # Authenticated dispatch separately checks the configured owner, including
    # provider CleanupRequired authority that has no pane/reference yet.
    return "smux: stopping server"

# One complete frame, without its newline. Authentication precedes command
# dispatch, including stop-server. Neither errors nor logs reveal the token.
pub fn smux_server_dispatch(request: text, token: text) -> text:
    if text_to_bytes(request).len() > REQUEST_LIMIT or request.contains("\n") or request.contains("\r"):
        return "smux: invalid request"
    if not valid_token(token):
        return "smux: unauthorized"
    # The token is the first space-separated field, compared in constant time.
    val presented = request.split(" ")[0]
    if presented.len() == request.len() or not constant_time_compare(presented, token):
        return "smux: unauthorized"
    val command = request[presented.len() + 1:]
    if _runtime_configured:
        if command == "stop-server": return runtime_stop_reply_v3()
        if _runtime_cleanup_only: return "smux: runtime initialization or writer cleanup unconfirmed"
    # This authenticated text adapter negotiates explicit absence. It does not
    # expose runtime binding through the unauthenticated remote dispatcher.
    if command == "runtime-binding-capabilities-v1":
        if _runtime_binding_owner != nil:
            return smux_runtime_binding_capabilities_v3(_runtime_binding_owner.unwrap())
        return smux_runtime_binding_capabilities_v1()
    val parts = command.split(" ")
    if parts.len() == 0: return "smux: invalid request"
    if parts[0] == "runtime-control-v1":
        if (_runtime_binding_owner == nil or _runtime_control_owner == nil or not _runtime_configured):
            return "smux: runtime control policy unavailable"
        if parts.len() != 2: return "smux: invalid runtime control request"
        val parsed = smux_runtime_control_request_from_token_v1(parts[1])
        if parsed.is_err(): return "smux: invalid runtime control request"
        # Only this branch, after the retained service credential comparison,
        # projects the installed trusted-local-owner principal into issuance.
        val turn = smux_runtime_control_service_v1(_runtime_binding_owner.unwrap(), _runtime_control_owner.unwrap(), parsed.unwrap())
        _runtime_control_owner = turn.owner
        return turn.reply
    if parts[0] == "create-runtime-target-v3":
        if _runtime_binding_owner == nil: return smux_runtime_binding_refusal_v3()
        if parts.len() != 2: return "smux: invalid runtime target name"
        val created = smux_runtime_target_create_v3(parts[1], _runtime_binding_owner.unwrap().service_incarnation)
        if created.is_err(): return "smux: " + created.unwrap_err()
        return created.unwrap()
    if parts[0] == "plan-existing-runtime-v3" or parts[0] == "bind-existing-runtime-v3":
        if _runtime_binding_owner == nil: return smux_runtime_binding_refusal_v3()
        if parts.len() != 2: return "smux: invalid runtime binding request"
        val request = smux_runtime_bind_request_from_token_v3(parts[1])
        if request.is_err(): return "smux: invalid runtime binding request"
        val owner = _runtime_binding_owner.unwrap()
        val turn = if parts[0] == "plan-existing-runtime-v3":
            smux_runtime_binding_plan_v3(owner, request.unwrap())
        else:
            smux_runtime_binding_bind_v3(owner, request.unwrap())
        # Retain cleanup and uncertainty authority even when the reply fails.
        _runtime_binding_owner = turn.owner
        return turn.reply
    if parts[0] == "inspect-runtime-binding-v3" or parts[0] == "prepare-runtime-helper-v3":
        if _runtime_binding_owner == nil: return smux_runtime_binding_refusal_v3()
        if parts.len() != 2 or not builder_identifier_valid_v1(parts[1]): return "smux: invalid runtime binding UID"
        val turn = if parts[0] == "prepare-runtime-helper-v3":
            smux_runtime_binding_prepare_v3(_runtime_binding_owner.unwrap(), parts[1])
        else:
            smux_runtime_binding_inspect_v3(_runtime_binding_owner.unwrap(), parts[1])
        _runtime_binding_owner = turn.owner
        return turn.reply
    if parts[0] == "runtime-binding-target-v3":
        if _runtime_binding_owner == nil: return smux_runtime_binding_refusal_v3()
        if parts.len() != 4: return "smux: invalid runtime target"
        val owner = _runtime_binding_owner.unwrap()
        val target = smux_runtime_target_v3(smux_owner_snapshot(), smux_configuration_revision(),
            smux_window_closing(parts[1], parts[2]), owner.service_incarnation, parts[1], parts[2], parts[3])
        if target.is_err(): return "smux: " + target.unwrap_err()
        return smux_runtime_target_encode_v3(target.unwrap())
    if command == "stop-server":
        return smux_server_stop_reply_v1(smux_owner_snapshot())
    return smux_remote_dispatch(command)

fn prepare_reply(client: PendingClient, reply: text, stop: bool) -> PendingClient:
    var output = text_to_bytes(reply)
    if output.len() > REPLY_LIMIT:
        output = text_to_bytes("smux: reply exceeds limit")
    output = text_to_bytes("SMUX/1 " + output.len().to_text() + "\n") + output
    return PendingClient(stream: client.stream, input: [], output: output,
        offset: 0, deadline: time_now_monotonic_ms() + CLIENT_DEADLINE_MS,
        replying: true, stop_owner: stop)

# EOF alone cannot certify a complete response: a failed partial socket write
# also ends the stream. The length frame makes truncation an explicit failure.
pub fn smux_server_decode_reply(wire: [u8]) -> Result<text, text>:
    var newline: i64 = -1
    var i: i64 = 0
    while i < wire.len() and i < 32 and newline < 0:
        if wire[i] == 10:
            newline = i
        i = i + 1
    if newline < 0:
        return Err("invalid smux response header")
    val header = bytes_to_text(wire[0:newline])
    if not header.starts_with("SMUX/1 "):
        return Err("invalid smux response header")
    # to_int() yields 0 (not nil) for non-numeric text, so admit digits explicitly.
    val length_text = header[7:]
    if length_text == "" or length_text.len() > 19:
        return Err("invalid smux response length")
    for ch in length_text:
        if ch < "0" or ch > "9":
            return Err("invalid smux response length")
    val length = length_text.to_int() ?? -1
    if length < 0 or length > REPLY_LIMIT:
        return Err("invalid smux response length")
    if wire.len() - newline - 1 != length:
        return Err("incomplete smux response")
    return Ok(bytes_to_text(wire[newline + 1:]))

# Explicit owner lifetime: EOF or closure of a request socket closes ONLY that
# socket. Only authenticated stop-server shuts down children and the listener.
pub fn smux_server_serve(address: text, token: text) -> i64:
    if not local_endpoint(address) or not valid_token(token):
        return 1
    val bound = TcpListener.bind(address)
    if bound.is_err():
        return 1
    _serve_on(bound.unwrap(), address, token)

# Owner-file mode. The file (in a directory only the user can open) holds
# `<id> <token>`; the owner binds an OS-chosen loopback port FIRST, then
# rewrites the file as `<id> 127.0.0.1:PORT <token> <pid>`. No client ever
# sends the token while discovering a port, and a client can check that the
# recorded pid is the one listening before it authenticates.
pub fn smux_server_serve_owner_file(path: text) -> i64:
    val f = file_read(path).trim().split(" ")
    if f.len() != 2 or not valid_token(f[1]):
        return 1
    val bound = TcpListener.bind("127.0.0.1:0")
    if bound.is_err():
        return 1
    var listener = bound.unwrap()
    val local = listener.local_addr()
    if local.is_err() or not local_endpoint(local.unwrap()):
        val _closed = listener.close()
        return 1
    val address = local.unwrap()
    # A starter that gave up removes or replaces the file; serving then would
    # leave an owner no client can reach, so a stale start exits instead.
    if file_read(path).trim() != f[0] + " " + f[1]:
        val _closed = listener.close()
        return 1
    if not file_write(path, f[0] + " " + address + " " + f[1] + " " + getpid().to_text() + "\n"):
        val _closed = listener.close()
        return 1
    _serve_on(listener, address, f[1])

# Configured mode has an immutable input and an exclusively published .ready
# generation. Only canonical native owners read/publish/close those files.
# Legacy path-based owner-file mode above never opens a host runtime owner.
pub fn smux_server_serve_runtime_owner_file(path: text, host_root: text) -> i64:
    if _runtime_configured or _runtime_binding_owner != nil or _runtime_credential_owner != nil: return 1
    _runtime_control_owner = nil
    val credential = retained_private_credential_open_v1(path)
    _runtime_credential_owner = credential.owner
    if credential.owner == nil: return 1
    _runtime_configured = true
    _runtime_credential_consumed = false
    _runtime_host_released = true
    _runtime_cleanup_only = true
    if credential.error != "" or credential.state != "open":
        val _closed = runtime_close_credential_v3()
        return 1
    val initial = retained_private_credential_read_v1(credential.owner.unwrap())
    _runtime_credential_owner = initial.owner
    if initial.error != "":
        val _closed = runtime_close_credential_v3()
        return 1
    # Native opening already checked the exact bounded ASCII input layout;
    # this parse is not a second path read or a filesystem authority claim.
    val fields = bytes_to_text(initial.bytes).trim().split(" ")
    if fields.len() != 2 or not valid_token(fields[1]):
        val _closed = runtime_close_credential_v3()
        return 1
    val bound = TcpListener.bind("127.0.0.1:0")
    if bound.is_err():
        val _closed = runtime_close_credential_v3()
        return 1
    var listener = bound.unwrap()
    val address = listener.local_addr()
    if address.is_err() or not local_endpoint(address.unwrap()):
        val _socket_closed = listener.close()
        val _closed = runtime_close_credential_v3()
        return 1
    val incarnation = sosix_random_hex(16)
    if incarnation == nil:
        val _socket_closed = listener.close()
        val _closed = runtime_close_credential_v3()
        return 1
    val opened = smux_runtime_binding_owner_open_v3(host_root, incarnation.unwrap())
    _runtime_binding_owner = opened.owner
    _runtime_journal_cleanup = opened.cleanup
    _runtime_journal_cleanup_state = opened.cleanup_state
    _runtime_host_released = opened.rejected
    var startup_failed = opened.owner == nil
    if opened.owner != nil:
        val control_policy = smux_runtime_control_policy_load_v1(opened.owner.unwrap().local)
        if control_policy.is_ok():
            val controls = smux_runtime_control_owner_new_v1(control_policy.unwrap(), incarnation.unwrap())
            if controls.is_ok(): _runtime_control_owner = Some(controls.unwrap())
        val ready = fields[0] + " " + address.unwrap() + " " + fields[1] + " " +
            getpid().to_text() + " " + incarnation.unwrap() + "\n"
        val published = retained_private_credential_publish_v1(_runtime_credential_owner.unwrap(),
            initial.bytes, text_to_bytes(ready))
        _runtime_credential_owner = published.owner
        if published.completed and published.error == "" and published.state == "published":
            _runtime_cleanup_only = false
        else:
            startup_failed = true
    if startup_failed:
        # One compensation attempt, then retain the exact canonical outcome.
        # An unresolved host writer must keep its authenticated cleanup channel.
        if runtime_close_host_v3():
            if runtime_close_credential_v3():
                val _socket_closed = listener.close()
                return 1
        _runtime_cleanup_only = true
    val code = _serve_on(listener, address.unwrap(), fields[1], not startup_failed)
    # Configured stop closes the actual host/credential owners BEFORE the
    # response permits the listener loop to exit; never retry copied handles.
    if (not _runtime_host_released or _runtime_binding_owner != nil or _runtime_journal_cleanup != nil or
            _runtime_credential_owner != nil or not _runtime_credential_consumed): return 1
    _runtime_configured = false
    if startup_failed: return 1
    code

fn _serve_on(bound_listener: TcpListener, address: text, token: text, initialized: bool = true) -> i64:
    var listener = bound_listener
    var clients: [PendingClient] = []
    var stop = false
    var socket_cleanup_failed = false
    var client_reap_deadline: i64 = 0
    var lease_error_reported = false
    sosix_println(if initialized: "smux: owner ready " + address else: "smux: owner cleanup pending " + address)
    while not stop:
        val reap_now = time_now_monotonic_ms()
        if reap_now < 0 or reap_now >= client_reap_deadline:
            val reaped = smux_reap_expired_clients()
            if reaped.is_err():
                # Keep background children alive when lease time cannot be
                # established; report the failure once rather than flooding
                # the owner log or pretending stale attachments were reaped.
                if not lease_error_reported:
                    sosix_println("smux: client lease sweep failed: " + reaped.unwrap_err())
                    lease_error_reported = true
            else:
                lease_error_reported = false
            client_reap_deadline = reap_now + SMUX_CLIENT_LEASE_SWEEP_MS
            if _runtime_binding_owner != nil and _runtime_control_owner != nil and not _runtime_cleanup_only:
                _runtime_control_owner = Some(smux_runtime_control_sweep_v1(_runtime_binding_owner.unwrap(), _runtime_control_owner.unwrap()))
        val _polled = smux_poll_output()
        val accepted = listener.accept_timeout(10)
        if accepted.is_ok():
            var stream = accepted.unwrap()
            if clients.len() >= CLIENT_LIMIT or not tcp_backend_set_nonblocking(stream.fd, true):
                if stream.close().is_err():
                    socket_cleanup_failed = true
            else:
                clients.push(PendingClient(stream: stream, input: [], output: [],
                    offset: 0, deadline: time_now_monotonic_ms() + CLIENT_DEADLINE_MS,
                    replying: false, stop_owner: false))
        var pending: [PendingClient] = []
        for original in clients:
            var client = original
            var finished = time_now_monotonic_ms() >= client.deadline
            if not finished and not client.replying:
                val read = client.stream.read(4096)
                if read.is_ok():
                    val chunk = read.unwrap()
                    if chunk.len() == 0:
                        finished = true
                    else:
                        # Preserve bytes until the complete frame arrives, so
                        # a split UTF-8 sequence is never decoded in isolation.
                        client.input = client.input + chunk
                        var newline: i64 = -1
                        var i: i64 = 0
                        while i < client.input.len() and newline < 0:
                            if client.input[i] == 10:
                                newline = i
                            i = i + 1
                        if newline >= 0:
                            if newline != client.input.len() - 1 or newline > REQUEST_LIMIT:
                                client = prepare_reply(client, "smux: invalid request", false)
                            else:
                                val frame = bytes_to_text(client.input[0:newline])
                                val reply = smux_server_dispatch(frame, token)
                                client = prepare_reply(client, reply, reply == "smux: stopping server")
                        elif client.input.len() > REQUEST_LIMIT:
                            client = prepare_reply(client, "smux: invalid request", false)
                # The current facade conflates WouldBlock with read errors.
                # Keep partial input until the absolute deadline; never restart
                # its clock when a peer trickles bytes into the socket.
            if not finished and client.replying:
                var end = client.offset + 4096
                if end > client.output.len():
                    end = client.output.len()
                val written = client.stream.write(client.output[client.offset:end])
                if written.is_ok():
                    val count = written.unwrap()
                    if count <= 0:
                        finished = true
                    else:
                        client.offset = client.offset + count
                        finished = client.offset >= client.output.len()
                # A short or WouldBlock write retains the exact remaining bytes.
            if finished:
                if client.stop_owner:
                    stop = true
                if client.stream.close().is_err():
                    socket_cleanup_failed = true
            else:
                pending.push(client)
        clients = pending
    for client in clients:
        var stream = client.stream
        if stream.close().is_err():
            socket_cleanup_failed = true
    if listener.close().is_err():
        socket_cleanup_failed = true
    smux_reset_for_test()
    val cleanup_deadline = time_now_monotonic_ms() + 2000
    var cleanup = pty_cleanup_pending()
    while cleanup > 0 and time_now_monotonic_ms() < cleanup_deadline:
        thread_sleep_ms(5)
        cleanup = pty_cleanup_pending()
    if cleanup != 0 or socket_cleanup_failed:
        return 1
    return 0

# Each invocation is a disposable client. A partial response or a timeout is
# an error, not a successful capture. EOF must agree with the byte length frame.
pub fn smux_server_request(address: text, token: text, command: text) -> Result<text, text>:
    if not local_endpoint(address) or not valid_token(token):
        return Err("invalid smux endpoint or token")
    val frame = token + " " + command
    if text_to_bytes(frame).len() > REQUEST_LIMIT or frame.contains("\n") or frame.contains("\r"):
        return Err("invalid smux request")
    val connected = TcpStream.connect_timeout(address, 1000)
    if connected.is_err():
        return Err("smux owner unavailable")
    var stream = connected.unwrap()
    if stream.set_read_timeout(1000).is_err() or stream.set_write_timeout(1000).is_err():
        val _closed = stream.close()
        return Err("smux transport timeout unavailable")
    val deadline = time_now_monotonic_ms() + 5000
    val request_bytes = text_to_bytes(frame + "\n")
    var offset: i64 = 0
    while offset < request_bytes.len() and time_now_monotonic_ms() < deadline:
        val written = stream.write(request_bytes[offset:])
        if written.is_err():
            val _closed = stream.close()
            return Err("smux request write failed")
        val count = written.unwrap()
        if count <= 0:
            val _closed = stream.close()
            return Err("smux request write failed")
        offset = offset + count
    if offset != request_bytes.len():
        val _closed = stream.close()
        return Err("smux request write timeout")
    var output: [u8] = []
    while time_now_monotonic_ms() < deadline:
        val read = stream.read(4096)
        if read.is_err():
            val _closed = stream.close()
            return Err("smux response read failed")
        if read.is_ok():
            val chunk = read.unwrap()
            if chunk.len() == 0:
                if stream.close().is_err():
                    return Err("smux response close failed")
                if output.len() == 0:
                    return Err("empty smux response")
                return smux_server_decode_reply(output)
            output = output + chunk
            if output.len() > REPLY_LIMIT + 32:
                val _closed = stream.close()
                return Err("smux response exceeds limit")
    val _closed = stream.close()
    return Err("smux response timeout")

export smux_server_dispatch, smux_server_stop_reply_v1, smux_server_decode_reply, smux_server_serve, smux_server_serve_owner_file, smux_server_serve_runtime_owner_file, smux_server_request
