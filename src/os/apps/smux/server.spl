const REQUEST_LIMIT: i64 = 4096
const CONNECTION_REQUEST_LIMIT_V5: i64 = 2796500
const CLIENT_LIMIT: i64 = 16
const CLIENT_DEADLINE_MS: i64 = 2000

# Exclusive in-process host/smux composition, not an independent host daemon.
# No wire request selects its root or policy; the host holds one journal writer.
var _runtime_binding_owner: SmuxRuntimeBindingOwnerV3? = nil
# Installed once per service incarnation, after protected host startup. A
# malformed/absent policy denies controls without enabling legacy authority.
var _runtime_control_owner: SmuxRuntimeControlOwnerV1? = nil
var _runtime_credential_owner: RetainedPrivateCredentialV1? = nil
var _runtime_journal_cleanup: DistributedOperationJournalOpenCleanupV2? = nil
var _runtime_journal_cleanup_state: FileLockReleaseStateV2? = nil
var _runtime_configured: bool = false
var _runtime_cleanup_only: bool = false
var _runtime_host_released: bool = false
var _runtime_credential_consumed: bool = false
var _runtime_connection_owner: SmuxRuntimeConnectionOwnerV5? = nil
var _runtime_connection_domain: HostServiceDomainV3? = nil
var _runtime_connection_cleanup: HostServiceCleanupV3? = nil
var _runtime_connection_credential: RetainedPrivateCredentialV2? = nil
var _runtime_auth_mode_v6: bool = false
var _runtime_auth_reader_v6: Option<HostServiceReadyReaderV1> = nil
var _runtime_auth_quiescing_v6: bool = false
var _runtime_auth_error_v6: text = ""
var _runtime_auth_connections_cleanup_v6: [HostServiceAuthConnectionV6] = []

# Only native/host owned turns can advance these local observations. They
# never authorize descriptor IO or a new writer; native generations do that.
fn runtime_close_host_v3() -> bool:
    if _runtime_host_released: return true
    if _runtime_connection_owner != nil:
        val closed = smux_runtime_connection_close_v5(_runtime_connection_owner.unwrap())
        _runtime_connection_owner = closed.owner
        _runtime_connection_cleanup = closed.cleanup
        _runtime_host_released = closed.closed and closed.owner == nil and closed.cleanup == nil and closed.error == ""
        return _runtime_host_released
    if _runtime_connection_domain != nil:
        val closed = host_service_domain_close_v3(_runtime_connection_domain.unwrap())
        _runtime_connection_domain = nil
        _runtime_connection_cleanup = closed.cleanup
        _runtime_host_released = closed.closed and closed.cleanup.is_none() and closed.error == ""
        return _runtime_host_released
    if _runtime_connection_cleanup != nil:
        val closed = host_service_cleanup_v3(_runtime_connection_cleanup.unwrap())
        _runtime_connection_cleanup = closed.cleanup
        _runtime_host_released = closed.closed and closed.cleanup.is_none() and closed.error == ""
        return _runtime_host_released
    if _runtime_binding_owner != nil:
        val outcome = smux_runtime_binding_owner_close_v3(_runtime_binding_owner.unwrap())
        if outcome.is_err(): return false
        val closed = outcome.unwrap()
        _runtime_binding_owner = nil
        _runtime_journal_cleanup = closed.cleanup
        _runtime_journal_cleanup_state = Some(closed.state)
        _runtime_cleanup_only = true
        _runtime_host_released = (closed.state == FileLockReleaseStateV2.Released and closed.closed and
            closed.cleanup == nil and closed.error == "")
        return _runtime_host_released
    if _runtime_journal_cleanup != nil:
        val closed = distributed_operation_journal_open_cleanup_v2(_runtime_journal_cleanup.unwrap())
        _runtime_journal_cleanup = closed.cleanup
        _runtime_journal_cleanup_state = Some(closed.state)
        _runtime_host_released = (closed.state == FileLockReleaseStateV2.Released and closed.closed and
            closed.cleanup == nil and closed.error == "")
    _runtime_host_released

fn runtime_close_credential_v3() -> bool:
    if _runtime_credential_consumed: return false
    if _runtime_connection_credential != nil:
        val closed = retained_private_credential_close_v2(_runtime_connection_credential.unwrap())
        _runtime_connection_credential = Some(closed.owner)
        _runtime_credential_consumed = closed.consumed
        if closed.completed and closed.consumed and closed.error == "":
            _runtime_connection_credential = nil
            return true
        return false
    if _runtime_credential_owner == nil: return false
    val closed = retained_private_credential_close_v1(_runtime_credential_owner.unwrap())
    _runtime_credential_owner = closed.owner
    _runtime_credential_consumed = closed.consumed
    # A consumed-error is explicit uncertainty, not success or retry authority.
    if closed.completed and closed.consumed and closed.error == "":
        _runtime_credential_owner = nil
        return true
    false

fn runtime_stop_reply_v3() -> text:
    if _runtime_connection_owner != nil and not smux_runtime_connection_stop_allowed_v5(_runtime_connection_owner.unwrap()):
        return "smux: stop refused: provider connection cleanup or host release pending"
    if (_runtime_control_owner != nil and not smux_primary_input_stop_allowed_v4(_runtime_control_owner.unwrap())):
        return "smux: stop refused: input revocation or receipt reconciliation pending"
    if (_runtime_control_owner != nil and not smux_primary_geometry_stop_allowed_v4(_runtime_control_owner.unwrap())):
        return "smux: stop refused: geometry cleanup or receipt reconciliation pending"
    if (_runtime_binding_owner != nil and
            not smux_runtime_binding_stop_allowed_v3(_runtime_binding_owner.unwrap())):
        return "smux: stop refused: runtime helper cleanup or host release pending"
    if smux_server_stop_reply_v1(smux_owner_snapshot()) != "smux: stopping server":
        return "smux: stop refused: terminal cleanup or host release pending"
    _runtime_cleanup_only = true
    _runtime_control_owner = nil
    # Close the real host writer while the authenticated recovery listener is
    # still available. No success response precedes actual owned release.
    if not runtime_close_host_v3(): return "smux: stop refused: host writer cleanup unconfirmed"
    if not runtime_close_credential_v3(): return "smux: stop refused: credential cleanup unconfirmed"
    "smux: stopping server"


pub fn smux_server_dispatch(request: text, token: text) -> text:
    if _runtime_auth_mode_v6: return "smux: legacy protocol unavailable in authenticated Host mode"
    if text_to_bytes(request).len() > CONNECTION_REQUEST_LIMIT_V5 or request.contains("\n") or request.contains("\r"):
        return "smux: invalid request"
    if not valid_token(token):
        return "smux: unauthorized"
    # The token is the first space-separated field, compared in constant time.
    val presented = request.split(" ")[0]
    if presented.len() == request.len() or not constant_time_compare(presented, token):
        return "smux: unauthorized"
    val command = request[presented.len() + 1:]
    if not command.starts_with("runtime-connection-v5 ") and text_to_bytes(request).len() > REQUEST_LIMIT:
        return "smux: invalid request"
    if _runtime_configured:
        if command == "stop-server": return runtime_stop_reply_v3()
        if _runtime_cleanup_only: return "smux: runtime initialization or writer cleanup unconfirmed"
    # This authenticated text adapter negotiates explicit absence. It does not
    # expose runtime binding through the unauthenticated remote dispatcher.
    if command == "runtime-binding-capabilities-v1":
        if _runtime_binding_owner != nil:
            return smux_runtime_binding_capabilities_v3(_runtime_binding_owner.unwrap())
        return smux_runtime_binding_capabilities_v1()
    if command == "runtime-primary-capabilities-v4":
        return smux_primary_capabilities_v4(_runtime_binding_owner != nil)
    val parts = command.split(" ")
    if parts.len() == 0: return "smux: invalid request"
    if parts[0] == "runtime-connection-v5":
        if _runtime_connection_owner == nil: return "smux: configured provider connection unavailable"
        if parts.len() != 2: return "smux: invalid provider connection request"
        val turn = smux_runtime_connection_dispatch_v5(_runtime_connection_owner.unwrap(), parts[1])
        _runtime_connection_owner = Some(turn.owner)
        return turn.response
    if parts[0] == "plan-primary-runtime-v4" or parts[0] == "bind-primary-runtime-v4":
        if _runtime_binding_owner == nil: return smux_primary_capabilities_v4(false)
        if parts.len() != 2: return "smux: invalid primary binding request"
        val parsed = smux_runtime_primary_request_from_token_v4(parts[1])
        if parsed.is_err(): return "smux: invalid primary binding request"
        val turn = if parts[0] == "plan-primary-runtime-v4":
            smux_primary_plan_v4(_runtime_binding_owner.unwrap(), parsed.unwrap())
        else: smux_primary_bind_v4(_runtime_binding_owner.unwrap(), parsed.unwrap())
        _runtime_binding_owner = turn.owner
        return turn.reply
    if (parts[0] == "prepare-primary-helper-v4" or parts[0] == "inspect-primary-binding-v4" or
            parts[0] == "cleanup-primary-binding-v4"):
        if _runtime_binding_owner == nil: return smux_primary_capabilities_v4(false)
        if parts.len() != 2 or not builder_identifier_valid_v1(parts[1]): return "smux: invalid primary binding UID"
        if parts[0] == "cleanup-primary-binding-v4" and _runtime_control_owner != nil:
            val observed = smux_primary_control_refresh_v4(_runtime_binding_owner.unwrap(), _runtime_control_owner.unwrap(), parts[1])
            val retired = smux_runtime_control_invalidate_binding_v1(observed, parts[1],
                "primary-helper-cleanup", time_now_monotonic_ms())
            _runtime_control_owner = Some(smux_primary_controls_sync_v4(_runtime_binding_owner.unwrap(), retired))
        val turn = if parts[0] == "prepare-primary-helper-v4":
            smux_primary_prepare_v4(_runtime_binding_owner.unwrap(), parts[1])
        else: smux_primary_inspect_v4(_runtime_binding_owner.unwrap(), parts[1], parts[0] == "cleanup-primary-binding-v4")
        _runtime_binding_owner = turn.owner
        if _runtime_control_owner != nil:
            _runtime_control_owner = Some(smux_primary_controls_sync_v4(turn.owner, _runtime_control_owner.unwrap()))
        return turn.reply
    if parts[0] == "runtime-primary-control-v4":
        if (_runtime_binding_owner == nil or _runtime_control_owner == nil or not _runtime_configured):
            return "smux: runtime control policy unavailable"
        if parts.len() != 2: return "smux: invalid primary control request"
        val parsed = smux_primary_control_request_from_token_v4(parts[1])
        if parsed.is_err(): return "smux: invalid primary control request"
        val turn = smux_primary_control_service_v4(_runtime_binding_owner.unwrap(), _runtime_control_owner.unwrap(), parsed.unwrap())
        _runtime_control_owner = Some(smux_primary_controls_sync_v4(_runtime_binding_owner.unwrap(), turn.owner))
        return turn.reply
    if parts[0] == "runtime-control-v1":
        if (_runtime_binding_owner == nil or _runtime_control_owner == nil or not _runtime_configured):
            return "smux: runtime control policy unavailable"
        if parts.len() != 2: return "smux: invalid runtime control request"
        val parsed = smux_runtime_control_request_from_token_v1(parts[1])
        if parsed.is_err(): return "smux: invalid runtime control request"
        # Only this branch, after the retained service credential comparison,
        # projects the installed trusted-local-owner principal into issuance.
        val refreshed = smux_primary_control_refresh_v4(_runtime_binding_owner.unwrap(), _runtime_control_owner.unwrap(), parsed.unwrap().binding_uid)
        val turn = smux_runtime_control_service_v1(_runtime_binding_owner.unwrap(), refreshed, parsed.unwrap())
        _runtime_control_owner = Some(smux_primary_controls_sync_v4(_runtime_binding_owner.unwrap(), turn.owner))
        if _runtime_control_owner.unwrap().input_sync_error != "":
            return "smux: runtime input synchronization pending; inspect primary control"
        return turn.reply
    if parts[0] == "create-runtime-target-v3":
        if _runtime_binding_owner == nil: return smux_runtime_binding_refusal_v3()
        if parts.len() != 2: return "smux: invalid runtime target name"
        val created = smux_runtime_target_create_v3(parts[1], _runtime_binding_owner.unwrap().service_incarnation)
        if created.is_err(): return "smux: " + created.unwrap_err()
        return created.unwrap()
    if parts[0] == "plan-existing-runtime-v3" or parts[0] == "bind-existing-runtime-v3":
        if _runtime_binding_owner == nil: return smux_runtime_binding_refusal_v3()
        if parts.len() != 2: return "smux: invalid runtime binding request"
        val request = smux_runtime_bind_request_from_token_v3(parts[1])
        if request.is_err(): return "smux: invalid runtime binding request"
        val owner = _runtime_binding_owner.unwrap()
        val turn = if parts[0] == "plan-existing-runtime-v3":
            smux_runtime_binding_plan_v3(owner, request.unwrap())
        else:
            smux_runtime_binding_bind_v3(owner, request.unwrap())
        # Retain cleanup and uncertainty authority even when the reply fails.
        _runtime_binding_owner = turn.owner
        return turn.reply
    if parts[0] == "inspect-runtime-binding-v3" or parts[0] == "prepare-runtime-helper-v3":
        if _runtime_binding_owner == nil: return smux_runtime_binding_refusal_v3()
        if parts.len() != 2 or not builder_identifier_valid_v1(parts[1]): return "smux: invalid runtime binding UID"
        val turn = if parts[0] == "prepare-runtime-helper-v3":
            smux_runtime_binding_prepare_v3(_runtime_binding_owner.unwrap(), parts[1])
        else:
            smux_runtime_binding_inspect_v3(_runtime_binding_owner.unwrap(), parts[1])
        _runtime_binding_owner = turn.owner
        return turn.reply
    if parts[0] == "runtime-binding-target-v3":
        if _runtime_binding_owner == nil: return smux_runtime_binding_refusal_v3()
        if parts.len() != 4: return "smux: invalid runtime target"
        val owner = _runtime_binding_owner.unwrap()
        val target = smux_runtime_target_v3(smux_owner_snapshot(), smux_configuration_revision(),
            smux_window_closing(parts[1], parts[2]), owner.service_incarnation, parts[1], parts[2], parts[3])
        if target.is_err(): return "smux: " + target.unwrap_err()
        return smux_runtime_target_encode_v3(target.unwrap())
    if command == "stop-server":
        return smux_server_stop_reply_v1(smux_owner_snapshot())
    val reply = smux_remote_dispatch(command)
    if _runtime_connection_owner != nil:
        _runtime_connection_owner = Some(smux_runtime_connection_controls_sync_v5(_runtime_connection_owner.unwrap()))
    if _runtime_binding_owner != nil and _runtime_control_owner != nil:
        _runtime_control_owner = Some(smux_primary_controls_sync_v4(_runtime_binding_owner.unwrap(), _runtime_control_owner.unwrap()))
    return reply

fn authenticated_stop_v6(connection: HostServiceAuthConnectionV6,
        request: HostServiceOperationRequestV6) -> HostServiceOperationReplyV6:
    var reason = ""
    val allowed = host_service_auth_connection_stop_guard_v6(connection)
    if allowed.is_err(): reason = allowed.unwrap_err()
    elif _runtime_connection_owner.is_none(): reason = "runtime-host-owner-unavailable"
    else:
        val matched = smux_runtime_connection_stop_match_v6(_runtime_connection_owner.unwrap(), request)
        if matched.is_err(): reason = matched.unwrap_err()
        elif smux_server_stop_reply_v1(smux_owner_snapshot()) != "smux: stopping server":
            reason = "runtime-host-terminal-cleanup-pending"
    if reason == "":
        # No yield or callback between exact request checks, quiescing and close.
        # A partial/failed close never reopens normal service admission.
        _runtime_auth_quiescing_v6 = true
        _runtime_cleanup_only = true
        if not runtime_close_host_v3(): reason = "runtime-host-close-unconfirmed"
        if reason != "" and _runtime_auth_error_v6 == "": _runtime_auth_error_v6 = reason
    HostServiceOperationReplyV6(request.action, request.service_incarnation, "", request.scope_digest,
        "", false, if reason == "": 0 else: 2, "", reason)

fn authenticated_client_line_v6(original: PendingClient, line: text) -> PendingClient:
    var client = original
    if _runtime_auth_quiescing_v6 or _runtime_auth_reader_v6.is_none():
        client.deadline = 0
        return client
    if _runtime_connection_owner.is_none():
        client.deadline = 0
        return client
    val actual_journal = smux_runtime_connection_auth_current_v6(_runtime_connection_owner.unwrap())
    if actual_journal.is_err():
        client.deadline = 0
        return client
    val consumed = smux_pending_auth_request_v6(client, _runtime_auth_reader_v6.unwrap(), line)
    client = consumed.client
    if consumed.error != "":
        client.deadline = 0
        return client
    if consumed.request.is_none(): return client
    val connection = client.auth_connection.unwrap()
    val request = consumed.request.unwrap()
    var reply = HostServiceOperationReplyV6(request.action, request.service_incarnation, request.operation_id,
        request.scope_digest, request.request_digest, false, 2, "", "runtime-host-owner-unavailable")
    if request.action == "service-stop": reply = authenticated_stop_v6(connection, request)
    elif _runtime_connection_owner.is_some():
        val turn = smux_runtime_connection_host_operation_v6(_runtime_connection_owner.unwrap(), request)
        _runtime_connection_owner = Some(turn.owner)
        reply = turn.reply
    # Preserve the real domain/cleanup result even if serialization or delivery
    # later fails. Such a failure never authorizes resending the operation.
    val encoded = host_service_operation_reply_encode_v6(reply)
    if encoded.is_err():
        if _runtime_auth_quiescing_v6 and _runtime_auth_error_v6 == "": _runtime_auth_error_v6 = encoded.unwrap_err()
        client.stop_owner = _runtime_auth_quiescing_v6
        client.deadline = 0
        return client
    val sealed = host_service_auth_connection_reply_v6(connection, encoded.unwrap())
    if sealed.is_err():
        if _runtime_auth_quiescing_v6 and _runtime_auth_error_v6 == "": _runtime_auth_error_v6 = sealed.unwrap_err()
        client.stop_owner = _runtime_auth_quiescing_v6
        client.deadline = 0
        return client
    authenticated_client_output_v6(client, sealed.unwrap(), false, _runtime_auth_quiescing_v6)

pub fn smux_server_serve(address: text, token: text) -> i64:
    if not local_endpoint(address) or not valid_token(token):
        return 1
    val bound = TcpListener.bind(address)
    if bound.is_err():
        return 1
    _serve_on(bound.unwrap(), address, token)

# Owner-file mode. The file (in a directory only the user can open) holds
# `<id> <token>`; the owner binds an OS-chosen loopback port FIRST, then
# rewrites the file as `<id> 127.0.0.1:PORT <token> <pid>`. No client ever
# sends the token while discovering a port, and a client can check that the
# recorded pid is the one listening before it authenticates.
pub fn smux_server_serve_owner_file(path: text) -> i64:
    val f = file_read(path).trim().split(" ")
    if f.len() != 2 or not valid_token(f[1]):
        return 1
    val bound = TcpListener.bind("127.0.0.1:0")
    if bound.is_err():
        return 1
    var listener = bound.unwrap()
    val local = listener.local_addr()
    if local.is_err() or not local_endpoint(local.unwrap()):
        val _closed = listener.close()
        return 1
    val address = local.unwrap()
    # A starter that gave up removes or replaces the file; serving then would
    # leave an owner no client can reach, so a stale start exits instead.
    if file_read(path).trim() != f[0] + " " + f[1]:
        val _closed = listener.close()
        return 1
    if not file_write(path, f[0] + " " + address + " " + f[1] + " " + getpid().to_text() + "\n"):
        val _closed = listener.close()
        return 1
    _serve_on(listener, address, f[1])

# Configured mode has an immutable input and an exclusively published .ready
# generation. Only canonical native owners read/publish/close those files.
# Legacy path-based owner-file mode above never opens a host runtime owner.
pub fn smux_server_serve_runtime_owner_file(path: text, host_root: text) -> i64:
    if _runtime_configured or _runtime_binding_owner != nil or _runtime_credential_owner != nil: return 1
    _runtime_control_owner = nil
    val credential = retained_private_credential_open_v1(path)
    _runtime_credential_owner = credential.owner
    if credential.owner == nil: return 1
    _runtime_configured = true
    _runtime_credential_consumed = false
    _runtime_host_released = true
    _runtime_cleanup_only = true
    if credential.error != "" or credential.state != "open":
        val _closed = runtime_close_credential_v3()
        return 1
    val initial = retained_private_credential_read_v1(credential.owner.unwrap())
    _runtime_credential_owner = initial.owner
    if initial.error != "":
        val _closed = runtime_close_credential_v3()
        return 1
    # Native opening already checked the exact bounded ASCII input layout;
    # this parse is not a second path read or a filesystem authority claim.
    val fields = bytes_to_text(initial.bytes).trim().split(" ")
    if fields.len() != 2 or not valid_token(fields[1]):
        val _closed = runtime_close_credential_v3()
        return 1
    val bound = TcpListener.bind("127.0.0.1:0")
    if bound.is_err():
        val _closed = runtime_close_credential_v3()
        return 1
    var listener = bound.unwrap()
    val address = listener.local_addr()
    if address.is_err() or not local_endpoint(address.unwrap()):
        val _socket_closed = listener.close()
        val _closed = runtime_close_credential_v3()
        return 1
    val incarnation = sosix_random_hex(16)
    if incarnation == nil:
        val _socket_closed = listener.close()
        val _closed = runtime_close_credential_v3()
        return 1
    val opened = smux_runtime_binding_owner_open_v3(host_root, incarnation.unwrap())
    _runtime_binding_owner = opened.owner
    _runtime_journal_cleanup = opened.cleanup
    _runtime_journal_cleanup_state = opened.cleanup_state
    _runtime_host_released = opened.rejected
    var startup_failed = opened.owner == nil
    if opened.owner != nil:
        val control_policy = smux_runtime_control_policy_load_v1(opened.owner.unwrap().local)
        if control_policy.is_ok():
            val controls = smux_runtime_control_owner_new_v1(control_policy.unwrap(), incarnation.unwrap())
            if controls.is_ok():
                var configured = controls.unwrap()
                val geometry = smux_primary_geometry_policy_load_v1(opened.owner.unwrap().local)
                if geometry.is_ok():
                    configured.geometry_policy_bytes = geometry.unwrap()
                    configured.geometry_policy_error = ""
                else: configured.geometry_policy_error = "primary-geometry-policy-unavailable"
                _runtime_control_owner = Some(configured)
        val ready = fields[0] + " " + address.unwrap() + " " + fields[1] + " " +
            getpid().to_text() + " " + incarnation.unwrap() + "\n"
        val published = retained_private_credential_publish_v1(_runtime_credential_owner.unwrap(),
            initial.bytes, text_to_bytes(ready))
        _runtime_credential_owner = published.owner
        if published.completed and published.error == "" and published.state == "published":
            _runtime_cleanup_only = false
        else:
            startup_failed = true
    if startup_failed:
        # One compensation attempt, then retain the exact canonical outcome.
        # An unresolved host writer must keep its authenticated cleanup channel.
        if runtime_close_host_v3():
            if runtime_close_credential_v3():
                val _socket_closed = listener.close()
                return 1
        _runtime_cleanup_only = true
    val code = _serve_on(listener, address.unwrap(), fields[1], not startup_failed)
    # Configured stop closes the actual host/credential owners BEFORE the
    # response permits the listener loop to exit; never retry copied handles.
    if (not _runtime_host_released or _runtime_binding_owner != nil or _runtime_journal_cleanup != nil or
            _runtime_credential_owner != nil or not _runtime_credential_consumed): return 1
    _runtime_configured = false
    if startup_failed: return 1
    code

# Trusted configured composition supplies the actual already-open Host domain.
# No request can select deployment roots or reconstruct a journal writer. The
# existing listener/authentication/pane loop is shared with V3/V4.
# Transfer every still-live startup/cleanup obligation to trusted composition.
# An unsuccessful startup never turns absent ready publication into a release.
fn runtime_connection_result_v5(code: i64) -> SmuxRuntimeServerTurnV5:
    val turn = SmuxRuntimeServerTurnV5(code, _runtime_connection_owner, _runtime_connection_domain,
        _runtime_connection_cleanup, _runtime_connection_credential, _runtime_auth_error_v6,
        _runtime_auth_reader_v6, _runtime_auth_connections_cleanup_v6)
    _runtime_connection_owner = nil
    _runtime_connection_domain = nil
    _runtime_connection_cleanup = nil
    _runtime_connection_credential = nil
    _runtime_auth_reader_v6 = nil
    _runtime_auth_connections_cleanup_v6 = []
    _runtime_auth_mode_v6 = false
    _runtime_auth_quiescing_v6 = false
    _runtime_auth_error_v6 = ""
    _runtime_configured = false
    _runtime_cleanup_only = false
    turn

pub fn smux_server_serve_runtime_domain_v5(path: text, domain: HostServiceDomainV3,
        endpoint: text = "127.0.0.1:0") -> SmuxRuntimeServerTurnV5:
    if endpoint != "127.0.0.1:0":
        return SmuxRuntimeServerTurnV5(1, nil, Some(domain), nil, nil, "primary-service-loopback-auto-required")
    if (_runtime_configured or _runtime_binding_owner != nil or _runtime_credential_owner != nil or
            _runtime_connection_owner != nil or _runtime_connection_domain != nil or
            _runtime_connection_cleanup != nil or _runtime_connection_credential != nil):
        return SmuxRuntimeServerTurnV5(1, nil, Some(domain), nil, nil)
    _runtime_connection_domain = Some(domain)
    _runtime_host_released = false
    _runtime_configured = true
    _runtime_cleanup_only = true
    _runtime_credential_consumed = false
    val credential = retained_private_credential_open_v2(path)
    _runtime_connection_credential = credential.owner
    if credential.owner == nil or credential.error != "" or credential.state != "open":
        val _host = runtime_close_host_v3()
        val _credential = runtime_close_credential_v3()
        return runtime_connection_result_v5(1)
    val initial = retained_private_credential_read_v2(credential.owner.unwrap())
    _runtime_connection_credential = Some(initial.owner)
    if initial.error != "":
        val _host = runtime_close_host_v3()
        val _credential = runtime_close_credential_v3()
        return runtime_connection_result_v5(1)
    val fields = bytes_to_text(initial.bytes).trim().split(" ")
    if fields.len() != 2 or not valid_token(fields[1]):
        val _host = runtime_close_host_v3()
        val _credential = runtime_close_credential_v3()
        return runtime_connection_result_v5(1)
    val bound = TcpListener.bind(endpoint)
    if bound.is_err():
        val _host = runtime_close_host_v3()
        val _credential = runtime_close_credential_v3()
        return runtime_connection_result_v5(1)
    var listener = bound.unwrap()
    val address = listener.local_addr()
    val incarnation = sosix_random_hex(16)
    if address.is_err() or not local_endpoint(address.unwrap()) or incarnation == nil:
        val _socket = listener.close()
        val _host = runtime_close_host_v3()
        val _credential = runtime_close_credential_v3()
        return runtime_connection_result_v5(1)
    val opened = smux_runtime_connection_open_v5(_runtime_connection_domain.unwrap(), incarnation.unwrap())
    _runtime_connection_domain = opened.retained
    _runtime_connection_owner = opened.owner
    var failed = opened.owner == nil or opened.error != ""
    if not failed:
        val ready = fields[0] + " " + address.unwrap() + " " + fields[1] + " " + getpid().to_text() + " " + incarnation.unwrap() + "\n"
        val published = retained_private_credential_publish_v2(_runtime_connection_credential.unwrap(),
            initial.bytes, text_to_bytes(ready))
        _runtime_connection_credential = Some(published.owner)
        # Historical publication_state or successful cleanup never proves ready.
        if published.completed and published.error == "" and published.state == "published":
            _runtime_cleanup_only = false
        else: failed = true
    if failed:
        if runtime_close_host_v3() and runtime_close_credential_v3():
            val _socket = listener.close()
            return runtime_connection_result_v5(1)
        _runtime_cleanup_only = true
    val code = _serve_on(listener, address.unwrap(), fields[1], not failed)
    if (not _runtime_host_released or not _runtime_credential_consumed or _runtime_connection_owner != nil or
            _runtime_connection_domain != nil or _runtime_connection_cleanup != nil or _runtime_connection_credential != nil):
        return runtime_connection_result_v5(1)
    _runtime_configured = false
    if failed: return runtime_connection_result_v5(1)
    runtime_connection_result_v5(code)

fn runtime_authenticated_failed_v6(listener: Option<TcpListener>, reason: text) -> SmuxRuntimeServerTurnV5:
    _runtime_auth_quiescing_v6 = true
    _runtime_cleanup_only = true
    if _runtime_auth_error_v6 == "": _runtime_auth_error_v6 = reason
    if listener.is_some():
        var retained_listener = listener.unwrap()
        val closed = retained_listener.close()
        # The existing TCP facade consumes this descriptor even on failure.
        # Report uncertainty and never retry its raw number.
        if closed.is_err() and _runtime_auth_error_v6 == "": _runtime_auth_error_v6 = "host-service-auth-listener-close-unconfirmed"
    runtime_connection_result_v5(2)

# Explicit mode over the same listener and same retained Host domain. The
# private V6 setup never enters the legacy initial/ready parser or bearer wire.
pub fn smux_server_serve_runtime_authenticated_v6(setup_path: text, setup_digest: text,
        domain: HostServiceDomainV3, endpoint: text = "127.0.0.1:0") -> SmuxRuntimeServerTurnV5:
    if endpoint != "127.0.0.1:0":
        return SmuxRuntimeServerTurnV5(2, nil, Some(domain), nil, nil, "primary-service-loopback-auto-required")
    if (_runtime_configured or _runtime_binding_owner.is_some() or _runtime_credential_owner.is_some() or
            _runtime_connection_owner.is_some() or _runtime_connection_domain.is_some() or
            _runtime_connection_cleanup.is_some() or _runtime_connection_credential.is_some() or _runtime_auth_reader_v6.is_some()):
        return SmuxRuntimeServerTurnV5(2, nil, Some(domain), nil, nil, "primary-service-already-running")
    _runtime_configured = true
    _runtime_auth_mode_v6 = true
    _runtime_cleanup_only = true
    _runtime_host_released = false
    _runtime_credential_consumed = true
    val prepared = smux_runtime_authenticated_prepare_v6(setup_path, setup_digest, domain, endpoint)
    _runtime_connection_domain = prepared.domain
    _runtime_connection_owner = prepared.owner
    _runtime_auth_reader_v6 = prepared.reader
    if prepared.error != "" or prepared.listener.is_none():
        return runtime_authenticated_failed_v6(prepared.listener, prepared.error)
    _runtime_cleanup_only = false
    val code = _serve_on(prepared.listener.unwrap(), prepared.address, "")
    if _runtime_host_released and _runtime_auth_connections_cleanup_v6.len() == 0 and _runtime_auth_reader_v6.is_some():
        val closed = smux_runtime_authenticated_reader_close_v6(_runtime_auth_reader_v6.unwrap())
        _runtime_auth_reader_v6 = closed.owner
        if (not closed.completed or closed.error != "") and _runtime_auth_error_v6 == "":
            _runtime_auth_error_v6 = "host-service-auth-reader-close:" + closed.error
    # Reader and any failed logical close stay in the existing process-local
    # recovery carrier after socket/listener drain. No native cap is serialized.
    runtime_connection_result_v5(if _runtime_host_released and _runtime_auth_error_v6 == "": code else: 2)

fn _serve_on(bound_listener: TcpListener, address: text, token: text, initialized: bool = true) -> i64:
    var listener = bound_listener
    var clients: [PendingClient] = []
    var stop = false
    var socket_cleanup_failed = false
    var client_reap_deadline: i64 = 0
    var lease_error_reported = false
    sosix_println(if initialized: "smux: owner ready " + address else: "smux: owner cleanup pending " + address)
    while not stop:
        val reap_now = time_now_monotonic_ms()
        if reap_now < 0 or reap_now >= client_reap_deadline:
            val reaped = smux_reap_expired_clients()
            if reaped.is_err():
                # Keep background children alive when lease time cannot be
                # established; report the failure once rather than flooding
                # the owner log or pretending stale attachments were reaped.
                if not lease_error_reported:
                    sosix_println("smux: client lease sweep failed: " + reaped.unwrap_err())
                    lease_error_reported = true
            else:
                lease_error_reported = false
            client_reap_deadline = reap_now + SMUX_CLIENT_LEASE_SWEEP_MS
            if _runtime_connection_owner != nil:
                _runtime_connection_owner = Some(smux_runtime_connection_controls_sync_v5(_runtime_connection_owner.unwrap()))
            if _runtime_binding_owner != nil and _runtime_control_owner != nil and not _runtime_cleanup_only:
                _runtime_control_owner = Some(smux_primary_controls_sync_v4(_runtime_binding_owner.unwrap(), _runtime_control_owner.unwrap(), true))
        if _runtime_connection_owner != nil and not _runtime_cleanup_only:
            _runtime_connection_owner = Some(smux_runtime_connection_poll_v5(_runtime_connection_owner.unwrap()))
        val _polled = smux_poll_output()
        # Quiescing auth skips accept entirely. Kept as a typed statement: the
        # former `if ...: Err(text) else: Result<TcpStream, IoError>` expression
        # mixed error types and native HIR lowered `stream` as ANY.
        val quiescing = _runtime_auth_mode_v6 and _runtime_auth_quiescing_v6
        val accepted: Result<TcpStream, IoError> = if quiescing: Err(IoError(kind: IoErrorKind.WouldBlock, message: "host-service-auth-quiescing", source: nil)) else: listener.accept_timeout(10)
        if accepted.is_ok():
            var stream: TcpStream = accepted.unwrap()
            if clients.len() >= CLIENT_LIMIT or stream.enable_nonblocking().is_err():
                if stream.close().is_err():
                    socket_cleanup_failed = true
            else:
                clients.push(PendingClient(stream: stream, input: [], output: [],
                    offset: 0, deadline: time_now_monotonic_ms() + CLIENT_DEADLINE_MS,
                    replying: false, stop_owner: false))
        var pending: [PendingClient] = []
        for original in clients:
            var client = original
            var finished = time_now_monotonic_ms() >= client.deadline
            if not finished and not client.replying:
                val input_limit = if _runtime_auth_mode_v6: smux_pending_auth_line_limit_v6(client) else: CONNECTION_REQUEST_LIMIT_V5
                val remaining = if _runtime_auth_mode_v6: input_limit - client.input.len() + 1 else: 65536
                val read = client.stream.read(if remaining < 65536: remaining else: 65536)
                if read.is_ok():
                    val chunk = read.unwrap()
                    if chunk.len() == 0:
                        finished = true
                    else:
                        # Preserve bytes until the complete frame arrives, so
                        # a split UTF-8 sequence is never decoded in isolation.
                        val previous_bytes = client.input.len()
                        client.input = client.input + chunk
                        var newline: i64 = -1
                        var i: i64 = previous_bytes
                        while i < client.input.len() and newline < 0:
                            if client.input[i] == 10:
                                newline = i
                            i = i + 1
                        if newline >= 0:
                            if newline != client.input.len() - 1 or (if _runtime_auth_mode_v6: client.input.len() > input_limit else: newline > CONNECTION_REQUEST_LIMIT_V5):
                                if _runtime_auth_mode_v6: client.deadline = 0
                                else: client = prepare_reply(client, "smux: invalid request", false)
                            else:
                                if _runtime_auth_mode_v6:
                                    client = authenticated_client_line_v6(client, bytes_to_text(client.input))
                                else:
                                    val frame = bytes_to_text(client.input[0:newline])
                                    val reply = smux_server_dispatch(frame, token)
                                    client = prepare_reply(client, reply, reply == "smux: stopping server")
                        elif client.input.len() > input_limit:
                            if _runtime_auth_mode_v6: client.deadline = 0
                            else: client = prepare_reply(client, "smux: invalid request", false)
                # The current facade conflates WouldBlock with read errors.
                # Keep partial input until the absolute deadline; never restart
                # its clock when a peer trickles bytes into the socket.
            if _runtime_auth_mode_v6 and time_now_monotonic_ms() >= client.deadline: finished = true
            if not finished and client.replying and _runtime_auth_mode_v6:
                var end = client.offset + 65536
                if end > client.output.len(): end = client.output.len()
                val written = client.stream.write(client.output[client.offset:end])
                if written.is_ok():
                    val count = written.unwrap()
                    if count <= 0 or count > end - client.offset: finished = true
                    else:
                        client.offset = client.offset + count
                        if client.offset == client.output.len():
                            if client.auth_challenge:
                                client.auth_challenge = false
                                client.replying = false
                                client.input = []
                                client.output = []
                                client.offset = 0
                            else: finished = true
            elif not finished and client.replying:
                # Drain as much of the reply as the socket takes NOW. One 4 KiB
                # chunk per loop turn was not enough: every turn also polls the
                # pane PTYs through the VT screen, so a pane printing a few
                # hundred KB made each turn tens of milliseconds and a 400 KB
                # `history-joined` reply (100 turns) hit the 2 s client deadline
                # half-sent; the client saw "incomplete smux response" and
                # `capture_pane` reported an EMPTY transcript (smux pane drops
                # console stdout, 2026-11-12). Progress also renews the deadline:
                # the clock bounds a peer that stops reading, not a long reply.
                var progressed = false
                while not finished:
                    var end = client.offset + 4096
                    if end > client.output.len():
                        end = client.output.len()
                    val written = client.stream.write(client.output[client.offset:end])
                    if written.is_err():
                        # WouldBlock (conflated with errors by the facade): keep
                        # the exact remaining bytes for the next turn.
                        break
                    val count = written.unwrap()
                    if count <= 0:
                        finished = true
                    else:
                        progressed = true
                        client.offset = client.offset + count
                        finished = client.offset >= client.output.len()
                if progressed and not finished:
                    client.deadline = time_now_monotonic_ms() + CLIENT_DEADLINE_MS
            if finished:
                if client.auth_connection.is_some():
                    val retired = host_service_auth_connection_close_v6(client.auth_connection.unwrap())
                    if retired.is_err():
                        _runtime_auth_connections_cleanup_v6.push(client.auth_connection.unwrap())
                        if _runtime_auth_error_v6 == "": _runtime_auth_error_v6 = retired.unwrap_err()
                if (_runtime_auth_mode_v6 and client.stop_owner and
                        (client.offset != client.output.len() or client.output.len() == 0)):
                    if _runtime_auth_error_v6 == "": _runtime_auth_error_v6 = "host-service-auth-stop-delivery-unknown"
                if client.stop_owner:
                    stop = true
                if client.stream.close().is_err():
                    socket_cleanup_failed = true
            else:
                pending.push(client)
        clients = pending
    for client in clients:
        if client.auth_connection.is_some():
            val retired = host_service_auth_connection_close_v6(client.auth_connection.unwrap())
            if retired.is_err():
                _runtime_auth_connections_cleanup_v6.push(client.auth_connection.unwrap())
                if _runtime_auth_error_v6 == "": _runtime_auth_error_v6 = retired.unwrap_err()
        var stream = client.stream
        if stream.close().is_err():
            socket_cleanup_failed = true
    if listener.close().is_err():
        socket_cleanup_failed = true
    smux_reset_for_test()
    val cleanup_deadline = time_now_monotonic_ms() + 2000
    var cleanup = pty_cleanup_pending()
    while cleanup > 0 and time_now_monotonic_ms() < cleanup_deadline:
        thread_sleep_ms(5)
        cleanup = pty_cleanup_pending()
    if cleanup != 0 or socket_cleanup_failed or _runtime_auth_error_v6 != "":
        return 1
    return 0

# Each invocation is a disposable client. A partial response or a timeout is
# an error, not a successful capture. EOF must agree with the byte length frame.
# The owner answers a liveness query within the 1s default; a request it must
# WORK for (spawn-window starts a ConPTY and a shell, kill-window reaps one)
# takes seconds on a loaded box, so those callers pass `reply_ms`.
export smux_server_dispatch, smux_server_stop_reply_v1, smux_server_decode_reply, smux_server_serve, smux_server_serve_owner_file, smux_server_serve_runtime_owner_file, smux_server_serve_runtime_domain_v5, smux_server_serve_runtime_authenticated_v6, smux_server_request, smux_server_request_within
