# Fixed protected configuration. It supplies local-owner policy, never provider
# support, authenticated remote principal identity or a native control handle.
use std.common.contracts.mux.session_runtime_control_v1.SessionRuntimeControlKindV1
use std.common.build_manager.contracts.builder_identifier_valid_v1
use std.common.sdn.value.SdnValue
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.nogc_sync_mut.orchestration.host_local_root_v1.HostLocalRootV1
use std.nogc_sync_mut.io.file_ops.file_read_regular_no_follow_bounded

pub struct SmuxRuntimeControlPolicyV1:
    principal_id: text
    allowed: [SessionRuntimeControlKindV1]
    max_lease_ms: i64

pub fn smux_runtime_control_policy_validate_v1(policy: SmuxRuntimeControlPolicyV1) -> Result<(), text>:
    if not builder_identifier_valid_v1(policy.principal_id): return Err("control-policy-principal-invalid")
    if policy.max_lease_ms < 1 or policy.max_lease_ms > 15000: return Err("control-policy-ttl-invalid")
    if policy.allowed.len() > 2: return Err("control-policy-rights-invalid")
    var seen: [SessionRuntimeControlKindV1] = []
    for kind in policy.allowed:
        if seen.contains(kind): return Err("control-policy-right-duplicate")
        seen.push(kind)
    Ok(())

pub fn smux_runtime_control_policy_decode_v1(bytes: text) -> Result<SmuxRuntimeControlPolicyV1, text>:
    if bytes.bytes().len() < 1 or bytes.bytes().len() > 4096: return Err("control-policy-size")
    val parsed = sdn_parse_strict_v1(bytes, SdnStrictLimitsV1(max_source_bytes: 4096,
        max_depth: 3, max_nodes: 32, max_rows: 0, max_cells: 0, max_columns: 8))
    if parsed.is_err(): return Err("control-policy-syntax")
    val fields = match parsed.unwrap().value:
        case SdnValue.Dict(value): value
        case _: return Err("control-policy-object")
    val keys = ["version", "kind", "principalId", "allowed", "maxLeaseMs"]
    if fields.len() != keys.len(): return Err("control-policy-fields")
    for key in keys:
        if not fields.contains_key(key): return Err("control-policy-fields")
    if fields["version"] != SdnValue.Int(1) or fields["kind"] != SdnValue.String("smux-runtime-control-policy"):
        return Err("control-policy-version")
    val principal = match fields["principalId"]:
        case SdnValue.String(value): value
        case _: return Err("control-policy-principal-type")
    val ttl = match fields["maxLeaseMs"]:
        case SdnValue.Int(value): value
        case _: return Err("control-policy-ttl-type")
    var allowed: [SessionRuntimeControlKindV1] = []
    match fields["allowed"]:
        case SdnValue.Array(entries):
            if entries.len() > 2: return Err("control-policy-rights-invalid")
            for entry in entries:
                match entry:
                    case SdnValue.String(value):
                        if value == "input": allowed.push(SessionRuntimeControlKindV1.Input)
                        elif value == "geometry": allowed.push(SessionRuntimeControlKindV1.Geometry)
                        else: return Err("control-policy-right-unsupported")
                    case _: return Err("control-policy-right-type")
        case _: return Err("control-policy-rights-type")
    val policy = SmuxRuntimeControlPolicyV1(principal_id: principal, allowed: allowed, max_lease_ms: ttl)
    smux_runtime_control_policy_validate_v1(policy)?
    Ok(policy)

pub fn smux_runtime_control_policy_load_v1(local: HostLocalRootV1) -> Result<SmuxRuntimeControlPolicyV1, text>:
    val bytes = file_read_regular_no_follow_bounded(local.root + "/smux-runtime-control-policy.sdn", 4096)?
    smux_runtime_control_policy_decode_v1(bytes)
