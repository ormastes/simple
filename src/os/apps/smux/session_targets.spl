# Session IDs remain stable when names change. A name is usable only when it
# identifies exactly one session; never let a name shadow another session's ID.
use os.apps.smux.api.{smux_list_sessions}

pub fn smux_resolve_session(target: text) -> text:
    val sessions = smux_list_sessions()
    for session in sessions:
        if session.id == target: return session.id
    var found = ""
    for session in sessions:
        if session.name == target:
            if found != "": return ""
            found = session.id
    return found
