# Pure bounded cell-row history and grid serialization. No screen or I/O owner.

pub fn vt_history_bound(limit: i64) -> i64:
    if limit < 0:
        return 0
    if limit > 10000:
        return 10000
    return limit

pub fn vt_history_trim(saved: [[text]], limit: i64) -> [[text]]:
    val bound = vt_history_bound(limit)
    if bound == 0:
        return []
    if saved.len() > bound:
        return saved[saved.len() - bound:]
    return saved

pub fn vt_history_append(saved: [[text]], line: [text], limit: i64) -> [[text]]:
    val bound = vt_history_bound(limit)
    if bound == 0:
        return []
    var out = vt_history_trim(saved, bound - 1)
    out.push(line)
    return out

fn _history_drop_blank_tail(rows0: [text]) -> [text]:
    var rows = rows0
    while rows.len() > 0 and rows[rows.len() - 1] == "":
        rows = rows[0:rows.len() - 1]
    return rows

pub fn vt_grid_text(shown: [[text]]) -> text:
    var rows: [text] = []
    for line in shown:
        rows.push(line.join("").trim_end())
    return _history_drop_blank_tail(rows).join("\n")

pub fn vt_history_capture(saved: [[text]], shown: [[text]], max_lines: i64) -> text:
    val bound = vt_history_bound(max_lines)
    if bound == 0:
        return ""
    var rows: [text] = []
    for line in saved:
        rows.push(line.join("").trim_end())
    for line in shown:
        rows.push(line.join("").trim_end())
    rows = _history_drop_blank_tail(rows)
    if rows.len() > bound:
        rows = rows[rows.len() - bound:]
    return rows.join("\n")

# Existing SGR run encoding shared by visible and synchronized snapshots.
pub fn vt_grid_styled_text(shown: [[text]], styles: [[text]]) -> text:
    val esc = "\x1b"
    var rows: [text] = []
    var r = 0
    while r < shown.len():
        val line = shown[r]
        val aline = styles[r]
        var end = line.len()
        while end > 0 and (line[end - 1] == " " or line[end - 1] == "") and aline[end - 1] == "":
            end = end - 1
        var out = ""
        var cur = ""
        var c = 0
        while c < end:
            if aline[c] != cur:
                cur = aline[c]
                out = out + (if cur == "": esc + "[0m" else: esc + "[0;" + cur + "m")
            out = out + line[c]
            c = c + 1
        if cur != "":
            out = out + esc + "[0m"
        rows.push(out)
        r = r + 1
    return _history_drop_blank_tail(rows).join("\n")

export vt_history_bound, vt_history_trim, vt_history_append, vt_history_capture
export vt_grid_text, vt_grid_styled_text
