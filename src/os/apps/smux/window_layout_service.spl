# Window layout projections and backend resize transaction. The API remains
# the sole writer of authoritative service state; helpers consume snapshots.
use os.apps.smux.service.{ServiceState}
use os.apps.smux.mux_rects.{MuxRect, mux_layout_known, mux_layout_rects}
use std.nogc_sync_mut.sosix.pty.{sosix_pty_can_resize as pty_can_resize,
    sosix_pty_resize as pty_resize}

fn window_index(st: ServiceState, session_id: text, window_id: text) -> int:
    val idx = st.find_window_idx(window_id)
    if idx < 0:
        return -1
    if st.get_window(idx).session_id != session_id:
        return -1
    return idx

pub fn invalidate_window_layout(st: ServiceState, session_id: text, window_id: text) -> ServiceState:
    val idx = window_index(st, session_id, window_id)
    if idx < 0:
        return st
    val window = st.get_window(idx)
    return st.replace_window(idx, window.with_layout("manual", window.canvas_cols, window.canvas_rows))

pub fn window_layout_name(st: ServiceState, session_id: text, window_id: text) -> Result<text, text>:
    val idx = window_index(st, session_id, window_id)
    if idx < 0:
        return Err("unknown window: " + window_id)
    return Ok(st.get_window(idx).layout)

pub fn window_layout_rects(st: ServiceState, session_id: text, window_id: text) -> [MuxRect]:
    var empty: [MuxRect] = []
    val idx = window_index(st, session_id, window_id)
    if idx < 0:
        return empty
    val window = st.get_window(idx)
    if not mux_layout_known(window.layout):
        return empty
    var ids: [text] = []
    var i = 0
    while i < st.pane_count:
        val pane = st.get_pane(i).pane
        if pane.session_id == session_id and pane.window_id == window_id:
            ids.push(pane.id)
        i = i + 1
    return mux_layout_rects(ids, window.canvas_cols as i64, window.canvas_rows as i64, window.layout)

pub fn resize_layout_children(st: ServiceState, indices: [int], rects: [MuxRect]) -> Result<bool, text>:
    if indices.len() != rects.len():
        return Err("layout pane mapping mismatch")
    var checked = 0
    while checked < indices.len():
        val rect = rects[checked]
        if indices[checked] < 0 or indices[checked] >= st.pane_count:
            return Err("invalid layout pane index")
        if rect.cols <= 0 or rect.rows <= 0 or rect.cols > 32767 or rect.rows > 32767:
            return Err("invalid layout pane dimensions")
        if rect.cols * rect.rows > 262144:
            return Err("layout pane dimensions exceed service limit")
        checked = checked + 1
    if not pty_can_resize():
        return Ok(true)
    var changed: [int] = []
    var i = 0
    while i < indices.len():
        val pane = st.get_pane(indices[i])
        val rect = rects[i]
        if pane.pty_fd >= 0:
            if not pty_resize(pane.pty_fd as i32, rect.rows as i32, rect.cols as i32):
                var rollback_failed = false
                for prior in changed:
                    val old = st.get_pane(prior)
                    if not pty_resize(old.pty_fd as i32, old.pane.rows as i32, old.pane.cols as i32):
                        rollback_failed = true
                if rollback_failed:
                    return Err("terminal layout resize failed; rollback incomplete")
                return Err("terminal layout resize failed: " + pane.pane.id)
            changed.push(indices[i])
        i = i + 1
    return Ok(true)
