# api.spl — Public smux service API.
#
# Provides tmux-shaped operations over the native session/window/pane service.
# Uses module-level mutable state to persist sessions across detach.
#
# A pane is a slot; a CHILD is attached to it explicitly, either over pipes
# (`smux_pane_spawn`) or over a real pseudo-terminal (`smux_pane_spawn_pty`,
# POSIX openpty or Windows ConPTY through `std.sys.pty`). Input goes to the
# child, and every capture first drains whatever the child printed, so a
# capture shows what the child actually produced — never an echo of the input.
#
# Every pane-addressed verb validates the whole (session, window, pane) triple
# and fails typed on a mismatch; capacity refusals create nothing.
#
# Each pub fn writes `_svc` exactly once, at the end: a helper that writes
# `_svc` and is then followed by a read of `_svc` in the same frame loses the
# helper's write on older bootstrap interpreters whose call frame cached the
# module binding. Helpers below are therefore pure (state in, value out).

use os.apps.smux.contract.{
    MuxSession, MuxWindow, MuxPane, MuxCapture, MuxClientAttachment,
    SmuxMetrics, MuxBackendKind
}
use os.apps.smux.service.{ServiceState, PaneRecord}
use os.apps.smux.frame_snapshot.{smux_frame_validate, smux_frame_from_state}
use os.apps.smux.vt_screen.{vt_new, vt_feed}
use os.apps.smux.layout.{smux_plan_split}
use os.apps.smux.mux_rects.{MuxRect, mux_layout_known, mux_layout_rects}
use os.apps.smux.window_layout_service.{
    invalidate_window_layout as _invalidate_window_layout,
    window_layout_name, window_layout_rects,
    resize_layout_children as _resize_layout_children
}
use std.sys.pty.{
    open as pty_open,
    spawn as pty_spawn,
    write_some as pty_write_some,
    input_pending as pty_input_pending,
    read as pty_read,
    close as pty_close,
    is_running as pty_is_running,
    can_resize as pty_can_resize,
    resize as pty_resize
}
use std.nogc_sync_mut.io.process_ops.{process_spawn_piped, process_write_stdin_some,
    process_read_stdout, process_is_piped_alive, process_close_piped}
use std.io_runtime.{time_now_unix_micros}
use os.apps.smux.input_queue.{pane_input_enqueue, pane_input_remaining,
    pane_input_advance, pane_input_fail}

# =========================================================================
# Global service state
# =========================================================================

const SMUX_CAPACITY: int = 8

var _svc: ServiceState = ServiceState.empty()

# =========================================================================
# Test support
# =========================================================================

pub fn smux_reset_for_test():
    # Reap every attached child first: a reset must not leak processes.
    var i = 0
    while i < _svc.pane_count:
        _release_child(_svc.get_pane(i))
        i = i + 1
    _svc = ServiceState.empty()

# =========================================================================
# Pure helpers
# =========================================================================

fn id_text(n: int) -> text:
    return "id" + n.to_text()

fn _now_ns() -> u64:
    return (time_now_unix_micros() * 1000) as u64

fn _with_startup(st: ServiceState) -> ServiceState:
    val m = st.metrics
    return st.with_metrics(SmuxMetrics(
        startup_count: m.startup_count + 1,
        last_startup_ns: _now_ns(),
        resize_count: m.resize_count,
        capture_count: m.capture_count
    ))

# Index of the pane only when it belongs to exactly this session AND window.
fn _pane_idx(st: ServiceState, session_id: text, window_id: text, pane_id: text) -> int:
    val idx = st.find_pane_idx(pane_id)
    if idx < 0:
        return -1
    val p = st.get_pane(idx).pane
    if p.session_id != session_id or p.window_id != window_id:
        return -1
    return idx

fn _window_idx(st: ServiceState, session_id: text, window_id: text) -> int:
    val idx = st.find_window_idx(window_id)
    if idx < 0:
        return -1
    if st.get_window(idx).session_id != session_id:
        return -1
    return idx

fn _has_child(pr: PaneRecord) -> bool:
    return pr.child_pid > 0

fn _is_pty(pr: PaneRecord) -> bool:
    return pr.pty_fd >= 0

fn _release_child(pr: PaneRecord):
    if _is_pty(pr):
        val _c = pty_close(pr.pty_fd as i32)
    elif _has_child(pr):
        val _p = process_close_piped(pr.child_pid)

fn _child_alive(pr: PaneRecord) -> bool:
    if _is_pty(pr):
        return pty_is_running(pr.pty_fd as i32)
    if _has_child(pr):
        return process_is_piped_alive(pr.child_pid)
    return false

# Terminal output -> plain lines. CSI sequences are dropped, except a cursor
# position (`ESC[row;colH`) which a ConPTY uses instead of a newline, so it
# becomes one, and a cursor-forward (`ESC[nC`) which full-screen TUIs use
# instead of spaces, so it becomes n spaces. OSC titles (`ESC]...BEL`) are
# dropped. `\r` is dropped.
fn _clean_output(raw: text) -> text:
    val esc = "\x1b"
    val bel = "\x07"
    var out = ""
    var params = ""
    var mode = 0  # 0 text, 1 after ESC, 2 CSI, 3 OSC
    for ch in raw.chars():
        if mode == 0:
            if ch == esc:
                mode = 1
            elif ch != "\r":
                out = out + ch
        elif mode == 1:
            if ch == "[":
                mode = 2
                params = ""
            elif ch == "]":
                mode = 3
            else:
                mode = 0
        elif mode == 2:
            if ch >= "@" and ch <= "~":
                if ch == "H" and out != "" and not out.ends_with("\n"):
                    out = out + "\n"
                if ch == "C":
                    var n = params.to_int() ?? 1
                    if n < 1:
                        n = 1
                    while n > 0:
                        out = out + " "
                        n = n - 1
                mode = 0
            else:
                params = params + ch
        else:
            if ch == bel:
                mode = 0
            elif ch == esc:
                mode = 1
    return out

# Pulls whatever the child printed since the last drain into the pane tail.
# Reads are chunked (a PTY read returns at most one buffer), so keep reading
# until the child has nothing pending. Bounded so a child that prints forever
# cannot stall the caller.
#
# A PTY chunk is applied to the screen as soon as it is read. Replies to startup
# queries share the bounded input queue; one provider write follows each drain.
# A child waiting on that answer can resume after the provider delivers it.
fn _flush_input(pr0: PaneRecord) -> PaneRecord:
    if pr0.input.error != "" or not _has_child(pr0):
        return pr0
    if _is_pty(pr0):
        val pending = pty_input_pending(pr0.pty_fd as i32)
        if pending.is_err():
            return pr0.with_input(pane_input_fail(pr0.input, pending.unwrap_err()))
        if pending.unwrap():
            return pr0
    val bytes = pane_input_remaining(pr0.input)
    if bytes.len() == 0:
        return pr0
    val accepted = if _is_pty(pr0): pty_write_some(pr0.pty_fd as i32, bytes) else: process_write_stdin_some(pr0.child_pid, pr0.input.original, pr0.input.offset, 4096)
    if accepted < 0:
        return pr0.with_input(pane_input_fail(pr0.input, "write failed: " + pr0.pane.id))
    val advanced = pane_input_advance(pr0.input, accepted)
    if advanced.is_err():
        return pr0.with_input(pane_input_fail(pr0.input, advanced.unwrap_err()))
    return pr0.with_input(advanced.unwrap())

fn _drain(pr0: PaneRecord) -> PaneRecord:
    return _drain_bounded(pr0, 256)

fn _drain_bounded(pr0: PaneRecord, limit: int) -> PaneRecord:
    return _flush_input(_drain_bounded_no_flush(pr0, limit))

fn _drain_bounded_no_flush(pr0: PaneRecord, limit: int) -> PaneRecord:
    var pr = pr0
    var raw = ""
    var reads = 0
    var more = _has_child(pr)
    while more and reads < limit:
        var chunk = ""
        if _is_pty(pr):
            chunk = pty_read(pr.pty_fd as i32, 0)
            if chunk != "":
                pr = pr.feed_screen(chunk)
        else:
            chunk = process_read_stdout(pr.child_pid)
            raw = raw + chunk
        more = chunk != ""
        reads = reads + 1
    # Query replies share the ordered input queue. Overflow is a typed input
    # failure; clear the reply accumulator instead of retaining an unbounded
    # second queue outside the pane input limit.
    val owed = pr.replies()
    if owed != "":
        val queued = pane_input_enqueue(pr.input, owed)
        if queued.is_ok():
            pr = pr.with_input(queued.unwrap()).without_replies()
        else:
            pr = pr.with_input(pane_input_fail(pr.input, queued.unwrap_err())).without_replies()
    if raw != "":
        pr = pr.feed(_clean_output(raw))
    return pr

# The independent service owner calls this on every event-loop turn, even
# without attached clients. A noisy pane gets eight read chunks per turn.
# Each pane gets at most one input write of 4096 bytes per turn. Fairness also
# requires the selected PTY/process provider's real nonblocking write surface.
pub fn smux_poll_output() -> int:
    var st = _svc
    var live = 0
    var i = 0
    while i < st.pane_count:
        val pane = st.get_pane(i)
        if _has_child(pane):
            st = st.replace_pane(i, _drain_bounded(pane, 8))
            live = live + 1
        i = i + 1
    _svc = st
    return live

fn _closed_record() -> PaneRecord:
    return PaneRecord.create(MuxPane(
        id: "",
        window_id: "",
        session_id: "",
        backend_kind: MuxBackendKind.NativeShell,
        state: "closed",
        cols: 0,
        rows: 0
    ))

# =========================================================================
# Session management
# =========================================================================

pub fn smux_admission_available() -> bool:
    return (_svc.session_count < SMUX_CAPACITY and
        _svc.window_count < SMUX_CAPACITY and
        _svc.pane_count < SMUX_CAPACITY)

pub fn smux_create_session(name: text) -> MuxSession:
    # All-or-nothing: a session needs one session, window and pane slot.
    if not smux_admission_available():
        return MuxSession.create("", name)
    val n = _svc.next_id
    val sid = id_text(n)
    val session = MuxSession(id: sid, name: name, created_at: _now_ns(), generation: 0)
    var st = _svc.add_session(session)

    # auto-create initial window and (focused) pane
    val wid = id_text(n + 1)
    st = st.add_window(MuxWindow.create(wid, sid, "main").with_active(true))
    st = st.add_pane(PaneRecord.create(MuxPane.create(id_text(n + 2), wid, sid)).with_focus(true))

    _svc = _with_startup(st).with_next_id(n + 3)
    return session

pub fn smux_list_sessions() -> [MuxSession]:
    var result: [MuxSession] = []
    var i = 0
    while i < _svc.session_count:
        result.push(_svc.get_session(i))
        i = i + 1
    return result

pub fn smux_attach(session_id: text, client_id: text, cols: int, rows: int) -> MuxClientAttachment:
    # Refused attachments must not look successful or consume a client slot.
    val refused = MuxClientAttachment(client_id: client_id, session_id: session_id,
        attached: false, cols: cols, rows: rows)
    if _svc.find_session_idx(session_id) < 0 or client_id == "" or cols <= 0 or rows <= 0:
        return refused
    val existing = _svc.find_client_idx(client_id)
    if existing < 0 and _svc.client_count >= 4:
        return refused
    val att = MuxClientAttachment.create(client_id, session_id, cols, rows)
    var st = _svc
    if existing >= 0:
        st = st.remove_client(existing)
    _svc = st.add_client(att)
    return att

pub fn smux_detach(client_id: text) -> bool:
    val idx = _svc.find_client_idx(client_id)
    if idx < 0:
        return false
    _svc = _svc.remove_client(idx)
    return true

pub fn smux_list_clients() -> [MuxClientAttachment]:
    val clients = [_svc.c0, _svc.c1, _svc.c2, _svc.c3]
    return clients[0:_svc.client_count]

pub fn smux_detach_from(session_id: text, client_id: text) -> bool:
    val idx = _svc.find_client_idx(client_id)
    if idx < 0:
        return false
    if _svc.get_client(idx).session_id != session_id:
        return false
    _svc = _svc.remove_client(idx)
    return true

# =========================================================================
# Window management
# =========================================================================

pub fn smux_new_window(session_id: text, name: text) -> MuxWindow:
    if (_svc.find_session_idx(session_id) < 0 or
            _svc.window_count >= SMUX_CAPACITY or _svc.pane_count >= SMUX_CAPACITY):
        return MuxWindow.create("", session_id, name)
    val n = _svc.next_id
    val wid = id_text(n)
    val window = MuxWindow.create(wid, session_id, name)
    var st = _svc.add_window(window)
    st = st.add_pane(PaneRecord.create(MuxPane.create(id_text(n + 1), wid, session_id)).with_focus(true))
    _svc = st.with_next_id(n + 2)
    return window

pub fn smux_list_windows(session_id: text) -> [MuxWindow]:
    var result: [MuxWindow] = []
    var i = 0
    while i < _svc.window_count:
        val w = _svc.get_window(i)
        if w.session_id == session_id:
            result.push(w)
        i = i + 1
    return result

pub fn smux_focus_window(session_id: text, window_id: text) -> bool:
    if _window_idx(_svc, session_id, window_id) < 0:
        return false
    var st = _svc
    var i = 0
    while i < st.window_count:
        val w = st.get_window(i)
        if w.session_id == session_id:
            st = st.replace_window(i, w.with_active(w.id == window_id))
        i = i + 1
    _svc = st
    return true

pub fn smux_active_window(session_id: text) -> Result<MuxWindow, text>:
    for w in smux_list_windows(session_id):
        if w.is_active:
            return Ok(w)
    return Err("no active window in session: " + session_id)

# =========================================================================
# Pane management
# =========================================================================

pub fn smux_list_panes(session_id: text, window_id: text) -> [MuxPane]:
    var result: [MuxPane] = []
    var i = 0
    while i < _svc.pane_count:
        val pr = _svc.get_pane(i)
        if (pr.pane.session_id == session_id and
            pr.pane.window_id == window_id):
            result.push(pr.pane)
        i = i + 1
    return result

pub fn smux_split_pane(session_id: text, window_id: text, pane_id: text, direction: text) -> Result<MuxPane, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    if _svc.pane_count >= SMUX_CAPACITY:
        return Err("pane capacity reached")
    val original = _svc.get_pane(idx)
    val planned = smux_plan_split(original.pane.cols as i32, original.pane.rows as i32, direction)
    if planned.is_err():
        return Err(planned.unwrap_err())
    val plan = planned.unwrap()
    if _is_pty(original) and pty_can_resize():
        if not pty_resize(original.pty_fd as i32, plan.old_rows, plan.old_cols):
            return Err("terminal resize failed: " + pane_id)
    val n = _svc.next_id
    val added = PaneRecord.create(MuxPane.create(id_text(n), window_id, session_id)).resize(plan.new_cols as int, plan.new_rows as int)
    val resized = original.resize(plan.old_cols as int, plan.old_rows as int)
    val changed = _svc.replace_pane(idx, resized).add_pane(added).with_next_id(n + 1)
    _svc = _invalidate_window_layout(changed, session_id, window_id)
    val new_pane = added.pane
    return Ok(new_pane)

# Remove the pane and request child teardown. The native provider retains any
# cancellation/tree cleanup until its cleanup_pending sweep proves completion.
pub fn smux_close_pane(session_id: text, window_id: text, pane_id: text) -> bool:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return false
    _release_child(_svc.get_pane(idx))
    _svc = _invalidate_window_layout(_svc.remove_pane(idx), session_id, window_id)
    return true

pub fn smux_focus_pane(session_id: text, window_id: text, pane_id: text) -> bool:
    if _pane_idx(_svc, session_id, window_id, pane_id) < 0:
        return false
    var st = _svc
    var i = 0
    while i < st.pane_count:
        val pr = st.get_pane(i)
        if pr.pane.session_id == session_id and pr.pane.window_id == window_id:
            st = st.replace_pane(i, pr.with_focus(pr.pane.id == pane_id))
        i = i + 1
    _svc = st
    return true

pub fn smux_focused_pane(session_id: text, window_id: text) -> Result<MuxPane, text>:
    var i = 0
    while i < _svc.pane_count:
        val pr = _svc.get_pane(i)
        if pr.pane.session_id == session_id and pr.pane.window_id == window_id and pr.focus:
            return Ok(pr.pane)
        i = i + 1
    return Err("no focused pane in window: " + window_id)

# Native provider resizing precedes the corresponding VT/service commit.
# Providers without a resize capability retain their documented grid-only path.
pub fn smux_resize(session_id: text, window_id: text, pane_id: text, cols: int, rows: int) -> Result<MuxPane, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    if cols <= 0 or rows <= 0:
        return Err("pane dimensions must be positive")
    if cols > 32767 or rows > 32767:
        return Err("pane dimensions exceed service limit")
    if cols * rows > 262144:
        return Err("pane dimensions exceed service limit")
    val original = _svc.get_pane(idx)
    if _is_pty(original) and pty_can_resize():
        if not pty_resize(original.pty_fd as i32, rows as i32, cols as i32):
            return Err("terminal resize failed: " + pane_id)
    val updated = original.resize(cols, rows)
    val m = _svc.metrics
    val changed = _svc.replace_pane(idx, updated).with_metrics(SmuxMetrics(
        startup_count: m.startup_count,
        last_startup_ns: m.last_startup_ns,
        resize_count: m.resize_count + 1,
        capture_count: m.capture_count
    ))
    _svc = _invalidate_window_layout(changed, session_id, window_id)
    return Ok(updated.pane)

# =========================================================================
# Child processes
# =========================================================================

# Attaches a piped child (no controlling terminal). Returns its pid.
pub fn smux_pane_spawn(session_id: text, window_id: text, pane_id: text, cmd: text, args: [text]) -> Result<i64, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    val pr = _svc.get_pane(idx)
    if _has_child(pr):
        return Err("pane already has a child: " + pane_id)
    if cmd == "":
        return Err("empty command")
    val pid = process_spawn_piped(cmd, args)
    if pid <= 0:
        return Err("spawn failed: " + cmd)
    _svc = _svc.replace_pane(idx, pr.with_child(pid))
    return Ok(pid)

# Attaches a child on a real pseudo-terminal sized to the pane geometry.
# `command_line` is handed to the platform launcher as one line (a shell path
# on POSIX, a CreateProcess command line on Windows). Returns its pid.
pub fn smux_pane_spawn_pty(session_id: text, window_id: text, pane_id: text, command_line: text) -> Result<i64, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    val pr = _svc.get_pane(idx)
    if _has_child(pr):
        return Err("pane already has a child: " + pane_id)
    if command_line == "":
        return Err("empty command")
    val handle = pty_open(pr.pane.rows as i32, pr.pane.cols as i32)
    if handle < 0:
        return Err("pty open failed")
    val pid = pty_spawn(handle, command_line)
    if pid <= 0:
        val _c = pty_close(handle)
        return Err("pty spawn failed: " + command_line)
    _svc = _svc.replace_pane(idx, pr.with_pty(pid, handle as i64))
    return Ok(pid)

pub fn smux_pane_is_pty(session_id: text, window_id: text, pane_id: text) -> Result<bool, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    return Ok(_is_pty(_svc.get_pane(idx)))

pub fn smux_pane_alive(session_id: text, window_id: text, pane_id: text) -> Result<bool, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    return Ok(_child_alive(_svc.get_pane(idx)))

# Ends the PTY child but keeps the pane (and its captured output).
pub fn smux_pane_close_pty(session_id: text, window_id: text, pane_id: text) -> bool:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return false
    val pr = _svc.get_pane(idx)
    if not _is_pty(pr):
        return false
    if not pty_close(pr.pty_fd as i32):
        # Keep this exact token so a caller can retry deferred teardown. Native
        # close never reopens a PID and never frees pending OVERLAPPED memory.
        return false
    _svc = _svc.replace_pane(idx, pr.with_pty(-1, -1))
    return true

# =========================================================================
# Input / Output
# =========================================================================

# Accepts raw input into the pane's bounded owner queue and offers one byte
# prefix to its provider. A pane without a child refuses input. Delivery may
# remain pending after acceptance; smux_input_status reports progress/errors.
pub fn smux_send_text(session_id: text, window_id: text, pane_id: text, text_input: text) -> Result<text, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    val pr = _svc.get_pane(idx)
    if not _has_child(pr):
        return Err("pane has no child: " + pane_id)
    val queued = pane_input_enqueue(pr.input, text_input)
    if queued.is_err():
        return Err(queued.unwrap_err())
    val updated = _flush_input(pr.with_input(queued.unwrap()))
    _svc = _svc.replace_pane(idx, updated)
    if updated.input.error != "":
        return Err(updated.input.error)
    # Acceptance into a bounded owner/provider queue is not child delivery.
    return Ok("accepted")

pub fn smux_input_status(session_id: text, window_id: text, pane_id: text) -> Result<text, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    val pr = _svc.get_pane(idx)
    if pr.input.error != "":
        return Err(pr.input.error)
    if _is_pty(pr):
        val pending = pty_input_pending(pr.pty_fd as i32)
        if pending.is_err():
            _svc = _svc.replace_pane(idx, pr.with_input(pane_input_fail(pr.input, pending.unwrap_err())))
            return Err(pending.unwrap_err())
        if pending.unwrap():
            return Ok("pending")
    val remaining = pr.input.bytes.len() - pr.input.offset
    if remaining > 0:
        return Ok("queued:" + remaining.to_text())
    return Ok("idle")

# Types `command` and submits it: Enter is `\r` on a terminal (what a key
# press sends) and `\n` on a pipe.
pub fn smux_send_command(session_id: text, window_id: text, pane_id: text, command: text) -> Result<text, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    val enter = if _is_pty(_svc.get_pane(idx)): "\r" else: "\n"
    return smux_send_text(session_id, window_id, pane_id, command + enter)

pub fn smux_capture(session_id: text, window_id: text, pane_id: text, history_lines: int) -> Result<MuxCapture, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    val drained = _drain(_svc.get_pane(idx))
    val m = _svc.metrics
    _svc = _svc.replace_pane(idx, drained).with_metrics(SmuxMetrics(
        startup_count: m.startup_count,
        last_startup_ns: m.last_startup_ns,
        resize_count: m.resize_count,
        capture_count: m.capture_count + 1
    ))
    return Ok(drained.capture(history_lines))

# Like smux_capture, but each row keeps its styling as ANSI SGR runs
# (`ESC[0;<params>m` where attributes change, `ESC[0m` at a styled row's end).
pub fn smux_capture_styled(session_id: text, window_id: text, pane_id: text, history_lines: int) -> Result<text, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    val drained = _drain(_svc.get_pane(idx))
    val m = _svc.metrics
    _svc = _svc.replace_pane(idx, drained).with_metrics(SmuxMetrics(
        startup_count: m.startup_count,
        last_startup_ns: m.last_startup_ns,
        resize_count: m.resize_count,
        capture_count: m.capture_count + 1
    ))
    return Ok(drained.styled_capture(history_lines))

# True when the pane's child has bracketed paste (?2004) enabled. Drains first:
# the mode is set by what the child printed.
pub fn smux_pane_bracketed_paste(session_id: text, window_id: text, pane_id: text) -> Result<bool, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    val drained = _drain(_svc.get_pane(idx))
    _svc = _svc.replace_pane(idx, drained)
    return Ok(drained.bracketed_paste())

# Pastes `body` into the pane: wrapped in ESC[200~ ... ESC[201~ when the child
# enabled bracketed paste, so it is taken as one paste (newlines included)
# rather than typed keys; sent as-is otherwise. Does not submit.
pub fn smux_paste_text(session_id: text, window_id: text, pane_id: text, body: text) -> Result<text, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    # Read/queue terminal replies without a write, then flush the complete
    # input stream once after appending the paste below.
    val drained = _drain_bounded_no_flush(_svc.get_pane(idx), 256)
    if not _has_child(drained):
        return Err("pane has no child: " + pane_id)
    var payload = body
    if drained.bracketed_paste():
        payload = "\x1b[200~" + body + "\x1b[201~"
    val queued = pane_input_enqueue(drained.input, payload)
    if queued.is_err():
        _svc = _svc.replace_pane(idx, drained)
        return Err(queued.unwrap_err())
    val updated = _flush_input(drained.with_input(queued.unwrap()))
    _svc = _svc.replace_pane(idx, updated)
    if updated.input.error != "":
        return Err(updated.input.error)
    return Ok("accepted")

# =========================================================================
# Backend contract
# =========================================================================

pub fn smux_backend_contract_name() -> text:
    return "smux-native"

# =========================================================================
# Deferred feature gate
# =========================================================================

pub fn smux_is_deferred_feature(feature: text) -> bool:
    # Hosted interactive copy navigation/line selection is implemented.
    # Exact tmux key-table/config compatibility remains separately deferred.
    if feature == "mouse":
        return true
    if feature == "key-table-compat":
        return true
    if feature == "tmux-conf":
        return true
    if feature == "control-mode":
        return true
    return false

# =========================================================================
# Observability
# =========================================================================

pub fn smux_metrics() -> SmuxMetrics:
    return _svc.metrics

# A cell-preserving snapshot for composite frames. Wide glyph continuations
# remain empty cells; reconstructing columns from a flattened text loses them.
pub fn smux_capture_cells(session_id: text, window_id: text, pane_id: text) -> Result<[[text]], text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    val drained = _drain(_svc.get_pane(idx))
    val screen = if _is_pty(drained): drained.screen else: vt_feed(vt_new(drained.pane.rows, drained.pane.cols), drained.tail)
    val shown = if screen.frozen.len() > 0: screen.frozen else: screen.cells
    val m = _svc.metrics
    _svc = _svc.replace_pane(idx, drained).with_metrics(SmuxMetrics(
        startup_count: m.startup_count, last_startup_ns: m.last_startup_ns,
        resize_count: m.resize_count, capture_count: m.capture_count + 1))
    return Ok(shown)

# A directional split, pane removal or arbitrary pane resize invalidates the
# named plan for this window. Manual mode deliberately exposes no fabricated
# coordinates; select a named layout again to establish a complete canvas.
pub fn smux_window_layout(session_id: text, window_id: text) -> Result<text, text>:
    return window_layout_name(_svc, session_id, window_id)

# Rectangles use production pane IDs and the persisted window canvas. Unknown
# or manual windows have no named geometry. This never captures child output.
pub fn smux_window_rects(session_id: text, window_id: text) -> [MuxRect]:
    return window_layout_rects(_svc, session_id, window_id)

# Commit metadata and pane grids once after complete validation. Child handles,
# process IDs, focus and output owners are retained by PaneRecord.resize.
# A capable provider receives each resize first; failure triggers best-effort
# rollback before any service metadata is committed. Legacy providers remain
# explicitly grid-only. Actual child geometry still requires runtime evidence.
pub fn smux_select_layout(session_id: text, window_id: text, name: text, cols: int, rows: int) -> Result<[MuxRect], text>:
    val wi = _window_idx(_svc, session_id, window_id)
    if wi < 0:
        return Err("unknown window: " + window_id)
    if not mux_layout_known(name):
        return Err("invalid layout: " + name)
    if cols <= 0 or rows <= 0:
        return Err("layout canvas dimensions must be positive")
    if cols > 32767 or rows > 32767:
        return Err("layout canvas dimensions exceed service limit")
    if cols * rows > 262144:
        return Err("layout canvas dimensions exceed service limit")
    var ids: [text] = []
    var indices: [int] = []
    var i = 0
    while i < _svc.pane_count:
        val pane = _svc.get_pane(i).pane
        if pane.session_id == session_id and pane.window_id == window_id:
            ids.push(pane.id)
            indices.push(i)
        i = i + 1
    if ids.len() == 0:
        return Err("no panes in window: " + window_id)
    val rects = mux_layout_rects(ids, cols as i64, rows as i64, name)
    if rects.len() != ids.len():
        return Err("layout cannot fit panes in canvas")
    val backend = _resize_layout_children(_svc, indices, rects)
    if backend.is_err():
        return Err(backend.unwrap_err())
    var st = _svc
    i = 0
    while i < rects.len():
        val rect = rects[i]
        val pane = st.get_pane(indices[i])
        st = st.replace_pane(indices[i], pane.resize(rect.cols as int, rect.rows as int))
        i = i + 1
    val window = st.get_window(wi)
    _svc = st.replace_window(wi, window.with_layout(name, cols, rows))
    return Ok(rects)

# Capture retained terminal history plus the visible frame in one snapshot.
# Limit validation and full pane ownership precede any drain or state change.
pub fn smux_capture_history(session_id: text, window_id: text, pane_id: text, max_lines: int) -> Result<MuxCapture, text>:
    val idx = _pane_idx(_svc, session_id, window_id, pane_id)
    if idx < 0:
        return Err("unknown pane: " + pane_id)
    if max_lines <= 0 or max_lines > 10000:
        return Err("history line limit must be between 1 and 10000")
    val drained = _drain(_svc.get_pane(idx))
    val capture = drained.capture_history(max_lines)
    val metrics = _svc.metrics
    _svc = _svc.replace_pane(idx, drained).with_metrics(SmuxMetrics(
        startup_count: metrics.startup_count, last_startup_ns: metrics.last_startup_ns,
        resize_count: metrics.resize_count, capture_count: metrics.capture_count + 1))
    return Ok(capture)

# One bounded drain per pane and one authoritative commit for a complete frame.
pub fn smux_capture_frame(session_id: text, window_id: text, cursor_pane: text = "") -> Result<text, text>:
    val reason = smux_frame_validate(_svc, session_id, window_id, cursor_pane)
    if reason != "": return Err(reason)
    var st = _svc
    var i = 0
    while i < st.pane_count:
        val pane = st.get_pane(i)
        if pane.pane.session_id == session_id and pane.pane.window_id == window_id:
            st = st.replace_pane(i, _drain_bounded(pane, 8))
        i = i + 1
    val metrics = st.metrics
    st = st.with_metrics(SmuxMetrics(startup_count: metrics.startup_count,
        last_startup_ns: metrics.last_startup_ns, resize_count: metrics.resize_count,
        capture_count: metrics.capture_count + 1))
    val frame = smux_frame_from_state(st, session_id, window_id, cursor_pane)
    _svc = st
    return frame
