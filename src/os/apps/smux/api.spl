# api.spl — Public smux service API.
#
# Provides tmux-shaped operations over the native session/window/pane service.
# Uses module-level mutable state to persist sessions across detach.
#
# A pane is a slot; a CHILD is attached to it explicitly, either over pipes
# (`smux_pane_spawn`) or over a real pseudo-terminal (`smux_pane_spawn_pty`,
# POSIX openpty or Windows ConPTY through `std.sys.pty`). Input goes to the
# child, and every capture first drains whatever the child printed, so a
# capture shows what the child actually produced — never an echo of the input.
#
# Every pane-addressed verb validates the whole (session, window, pane) triple
# and fails typed on a mismatch; capacity refusals create nothing.
#
# Each pub fn writes `_svc` exactly once, at the end: a helper that writes
# `_svc` and is then followed by a read of `_svc` in the same frame loses the
# helper's write on older bootstrap interpreters whose call frame cached the
# module binding. Helpers receive explicit snapshots; only this API commits
# the returned state. Native effects remain in their Sosix-backed owners.

use os.apps.smux.contract.{
    MuxSession, MuxWindow, MuxPane, MuxCapture, MuxClientAttachment,
    SmuxMetrics, MuxBackendKind
}
use os.apps.smux.service.{ServiceState, PaneRecord}
use os.apps.smux.service_revision.{ServiceRevisionState, service_revision_new,
    service_revision_publish, service_revision_writable, service_revision_reset, service_attachment_identities, service_revision_rollback_allowed}
use os.apps.smux.client_attachment_service.{ClientAttachmentUpdate, client_attachment_index,
    client_attach_leased, client_resize_leased, client_reap_expired, client_attach_unmanaged}
use os.apps.smux.pane_io_service.{pane_release_best_effort as _release_child,
    pane_poll_state,
    pane_spawn_state,
    pane_spawn_pty_state,
    pane_is_pty_state,
    pane_alive_state,
    pane_close_pty_state,
    pane_send_state,
    pane_input_status_state,
    pane_command_state,
    pane_capture_state,
    pane_capture_styled_state,
    pane_bracketed_paste_state,
    pane_paste_state,
    pane_capture_cells_state,
    pane_capture_history_state,
    pane_capture_frame_state}
use os.apps.smux.session_lifecycle.{rename_session_state, remove_session_state, remove_window_state}
use os.apps.smux.child_lifecycle.{close_owned_children}
use os.apps.smux.pane_lifecycle.{PaneClosePending, close_pane_state,
    pane_close_window_pending, pane_close_poll_windows, pane_close_forget}
use os.apps.smux.split_checkpoint.{SplitCheckpoint, split_checkpoint_capture, split_checkpoint_restore}
use os.apps.smux.client_leases.{ClientLeaseState, smux_leases_new,
    smux_lease_admit, smux_lease_heartbeat, smux_lease_check, smux_lease_expiry_candidates,
    smux_lease_expire, smux_lease_remove, smux_lease_token_matches,
    smux_lease_forget_client, smux_lease_forget_session}
use std.sosix.time.{sosix_time_now_monotonic_ms}
use os.apps.smux.client_notifications.{smux_notifications_clear_recipient, smux_notifications_clear_all}
use os.apps.smux.mux_rects.{MuxRect, mux_layout_known}
use os.apps.smux.window_layout_service.{
    window_layout_name, window_layout_rects, window_content_rects, arrange_window_state as _arrange_window,
    split_window_sized_state, resize_pane_state, focus_window_state, toggle_zoom_state,
    WindowGeometryUpdate
}
use std.common.contracts.mux.execution_v1.{MuxSplitSizeV1, MuxBorderV1, MuxBorderStatusV1}
use os.apps.smux.pane_presentation.{pane_is_hidden}
use os.apps.smux.pane_presentation_service.{set_pane_title_state, set_pane_border_state,
    set_pane_border_status_state, hide_pane_state, show_pane_state, rebalance_window_state}
use std.sosix.time.{sosix_time_now_unix_micros as time_now_unix_micros}

# Global service state

const SMUX_CAPACITY: int = 8

var _svc: ServiceState = ServiceState.empty()
var _revisions: ServiceRevisionState = service_revision_new()
var _client_leases: ClientLeaseState = ClientLeaseState(owner_nonce: "",
    next_generation: 1, last_now_ms: 0, leases: [])
var _split_checkpoints: [SplitCheckpoint] = []
var _closing_sessions: [text] = []
var _closing_windows: [text] = []
var _closing_panes: [PaneClosePending] = []

# Every publication compares the immediate prior authoritative snapshot. Output
# and input progress do not advance configuration; legacy mutations do.
fn _publish(next: ServiceState) -> ServiceState:
    _revisions = service_revision_publish(_revisions, _svc, next, _closing_sessions, _closing_windows, _closing_panes,
        _client_leases.owner_nonce, service_attachment_identities(_client_leases))
    return next

pub fn smux_configuration_writable() -> bool:
    return service_revision_writable(_revisions)

pub fn smux_configuration_revision() -> ServiceRevisionState:
    return _revisions

# Internal server projection only: never serialize native handles from this value.
pub fn smux_owner_snapshot() -> ServiceState:
    return _svc

fn _clear_attachment_notices(update: ClientAttachmentUpdate):
    for item in update.cleared:
        smux_notifications_clear_recipient(item.session_id, item.client_id)

# Incomplete compensation leaves native geometry unknown. Keep every handle
# and admit only the existing checked window/session teardown paths.
fn _geometry_quarantine(window_id: text, outcome: WindowGeometryUpdate):
    if outcome.uncertain and not _closing_windows.contains(window_id):
        _closing_windows.push(window_id)
        val _observed = _publish(_svc)

# Test support

pub fn smux_reset_for_test():
    _revisions = service_revision_reset(_revisions)
    smux_notifications_clear_all()
    # Empty incarnation triggers fresh secure entropy on the next admission.
    _client_leases = ClientLeaseState(owner_nonce: "", next_generation: 1, last_now_ms: 0, leases: [])
    _split_checkpoints = []
    _closing_sessions = []
    _closing_windows = []
    _closing_panes = []
    # Reap every attached child first: a reset must not leak processes.
    var i = 0
    while i < _svc.pane_count:
        _release_child(_svc.get_pane(i))
        i = i + 1
    _svc = _publish(ServiceState.empty())

# Pure helpers

fn id_text(n: int) -> text:
    return "id" + n.to_text()

fn _now_ns() -> u64:
    return (time_now_unix_micros() * 1000) as u64

fn _with_startup(st: ServiceState) -> ServiceState:
    val m = st.metrics
    return st.with_metrics(SmuxMetrics(
        startup_count: m.startup_count + 1,
        last_startup_ns: _now_ns(),
        resize_count: m.resize_count,
        capture_count: m.capture_count
    ))

# Index of the pane only when it belongs to exactly this session AND window.
fn _pane_idx(st: ServiceState, session_id: text, window_id: text, pane_id: text) -> int:
    val idx = st.find_pane_idx(pane_id)
    if idx < 0:
        return -1
    val p = st.get_pane(idx).pane
    if p.session_id != session_id or p.window_id != window_id:
        return -1
    return idx

fn _window_idx(st: ServiceState, session_id: text, window_id: text) -> int:
    val idx = st.find_window_idx(window_id)
    if idx < 0:
        return -1
    if st.get_window(idx).session_id != session_id:
        return -1
    return idx

pub fn smux_poll_output() -> int:
    val updated = pane_poll_state(_svc, _closing_sessions, pane_close_poll_windows(_closing_panes, _closing_windows))
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

fn _closed_record() -> PaneRecord:
    return PaneRecord.create(MuxPane(
        id: "",
        window_id: "",
        session_id: "",
        backend_kind: MuxBackendKind.NativeShell,
        state: "closed",
        cols: 0,
        rows: 0
    ))

# Session management

pub fn smux_admission_available() -> bool:
    if not smux_configuration_writable(): return false
    return (_svc.session_count < SMUX_CAPACITY and
        _svc.window_count < SMUX_CAPACITY and
        _svc.pane_count < SMUX_CAPACITY)

pub fn smux_create_session(name: text) -> MuxSession:
    # All-or-nothing: a session needs one session, window and pane slot.
    if not smux_admission_available():
        return MuxSession.create("", name)
    val n = _svc.next_id
    val sid = id_text(n)
    val session = MuxSession(id: sid, name: name, created_at: _now_ns(), generation: 0)
    var st = _svc.add_session(session)

    # auto-create initial window and (focused) pane
    val wid = id_text(n + 1)
    st = st.add_window(MuxWindow.create(wid, sid, "main").with_active(true))
    st = st.add_pane(PaneRecord.create(MuxPane.create(id_text(n + 2), wid, sid)).with_focus(true))

    _svc = _publish(_with_startup(st).with_next_id(n + 3))
    return session

pub fn smux_list_sessions() -> [MuxSession]:
    var result: [MuxSession] = []
    var i = 0
    while i < _svc.session_count:
        result.push(_svc.get_session(i))
        i = i + 1
    return result

pub fn smux_session_closing(session_id: text) -> bool:
    for pending in _closing_sessions:
        if pending == session_id:
            return true
    return false

pub fn smux_rename_session(session_id: text, name: text) -> Result<MuxSession, text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    if smux_session_closing(session_id):
        return Err("session is closing: " + session_id)
    val renamed = rename_session_state(_svc, session_id, name)
    if renamed.is_err():
        return Err(renamed.unwrap_err())
    val st = renamed.unwrap()
    val session = st.get_session(st.find_session_idx(session_id))
    _svc = _publish(st)
    return Ok(session)

# A false native close is retained for retry, including quarantine completion.
# Failure can follow successful closes of sibling panes: this is deliberately
# partial teardown, not an atomic rollback. At most eight owners are visited.
# The piped Windows backend may block 100ms + 5s per close; this is not async.
pub fn smux_kill_session(session_id: text) -> Result<bool, text>:
    if _svc.find_session_idx(session_id) < 0:
        return Err("unknown session: " + session_id)
    if not smux_session_closing(session_id):
        _closing_sessions.push(session_id)
    _closing_panes = pane_close_forget(_closing_panes, session_id)
    val st = close_owned_children(_svc, session_id)
    val removed = remove_session_state(st, session_id)
    if removed.is_err():
        _svc = _publish(st)
        return Err("partial session cleanup pending or failed; retry kill: " + session_id)
    var i = 0
    while i < st.client_count:
        val client = st.get_client(i)
        if client.session_id == session_id:
            smux_notifications_clear_recipient(session_id, client.client_id)
        i = i + 1
    var checkpoints: [SplitCheckpoint] = []
    for saved in _split_checkpoints:
        if saved.before.session_id != session_id:
            checkpoints.push(saved)
    var pending: [text] = []
    for closing in _closing_sessions:
        if closing != session_id:
            pending.push(closing)
    _split_checkpoints = checkpoints
    _closing_sessions = pending
    var windows: [text] = []
    for closing in _closing_windows:
        val wi = st.find_window_idx(closing)
        if wi >= 0 and st.get_window(wi).session_id != session_id:
            windows.push(closing)
    _closing_windows = windows
    _client_leases = smux_lease_forget_session(_client_leases, session_id)
    _svc = _publish(removed.unwrap())
    return Ok(true)

pub fn smux_attach_leased(session_id: text, client_id: text, cols: int, rows: int) -> Result<text, text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    val changed = client_attach_leased(_svc, _client_leases, smux_session_closing(session_id), session_id, client_id, cols, rows, sosix_time_now_monotonic_ms())
    if changed.is_err(): return Err(changed.unwrap_err())
    val update = changed.unwrap()
    _clear_attachment_notices(update)
    _client_leases = update.leases
    _svc = _publish(update.state)
    return Ok(update.token)

pub fn smux_client_heartbeat(session_id: text, client_id: text, token: text) -> Result<bool, text>:
    if smux_session_closing(session_id) or client_attachment_index(_svc, session_id, client_id) < 0:
        return Err("client lease attachment unavailable")
    val renewed = smux_lease_heartbeat(_client_leases, session_id, client_id, token, sosix_time_now_monotonic_ms())
    if renewed.is_err(): return Err(renewed.unwrap_err())
    _client_leases = renewed.unwrap()
    return Ok(true)

pub fn smux_client_check_lease(session_id: text, client_id: text, token: text) -> Result<bool, text>:
    if smux_session_closing(session_id) or client_attachment_index(_svc, session_id, client_id) < 0:
        return Err("client lease attachment unavailable")
    return smux_lease_check(_client_leases, session_id, client_id, token, sosix_time_now_monotonic_ms())

pub fn smux_client_resize_leased(session_id: text, client_id: text, token: text, cols: int, rows: int) -> Result<bool, text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    val changed = client_resize_leased(_svc, _client_leases, smux_session_closing(session_id), session_id, client_id, token, cols, rows, sosix_time_now_monotonic_ms())
    if changed.is_err(): return Err(changed.unwrap_err())
    val update = changed.unwrap()
    _client_leases = update.leases
    _svc = _publish(update.state)
    return Ok(true)

pub fn smux_detach_leased(session_id: text, client_id: text, token: text) -> Result<bool, text>:
    val idx = client_attachment_index(_svc, session_id, client_id)
    if idx < 0 or not smux_lease_token_matches(_client_leases, session_id, client_id, token):
        return Err("client lease identity mismatch")
    val leases = smux_lease_remove(_client_leases, session_id, client_id, token)
    val st = _svc.remove_client(idx)
    smux_notifications_clear_recipient(session_id, client_id)
    _client_leases = leases
    _svc = _publish(st)
    return Ok(true)

# Periodic server housekeeping, also usable before admission. Expiry removes
# only the exact leased attachment and its notices; pane/process owners survive.
# A clock failure refuses expiry without dropping any attachment or child.
pub fn smux_reap_expired_clients() -> Result<int, text>:
    val changed = client_reap_expired(_svc, _client_leases, sosix_time_now_monotonic_ms())
    if changed.is_err(): return Err(changed.unwrap_err())
    val update = changed.unwrap()
    _clear_attachment_notices(update)
    _client_leases = update.leases
    _svc = _publish(update.state)
    return Ok(update.removed)

pub fn smux_attach(session_id: text, client_id: text, cols: int, rows: int) -> MuxClientAttachment:
    val refused = MuxClientAttachment(client_id: client_id, session_id: session_id, attached: false, cols: cols, rows: rows)
    if not smux_configuration_writable(): return refused
    val changed = client_attach_unmanaged(_svc, _client_leases, smux_session_closing(session_id), session_id, client_id, cols, rows)
    if changed.is_err(): return refused
    val update = changed.unwrap()
    _clear_attachment_notices(update)
    _svc = _publish(update.state)
    return MuxClientAttachment.create(client_id, session_id, cols, rows)

pub fn smux_detach(client_id: text) -> bool:
    val idx = _svc.find_client_idx(client_id)
    if idx < 0:
        return false
    smux_notifications_clear_recipient(_svc.get_client(idx).session_id, client_id)
    _client_leases = smux_lease_forget_client(_client_leases, client_id)
    _svc = _publish(_svc.remove_client(idx))
    return true

pub fn smux_list_clients() -> [MuxClientAttachment]:
    val clients = [_svc.c0, _svc.c1, _svc.c2, _svc.c3]
    return clients[0:_svc.client_count]

pub fn smux_detach_from(session_id: text, client_id: text) -> bool:
    val idx = _svc.find_client_idx(client_id)
    if idx < 0:
        return false
    if _svc.get_client(idx).session_id != session_id:
        return false
    smux_notifications_clear_recipient(session_id, client_id)
    _client_leases = smux_lease_forget_client(_client_leases, client_id)
    _svc = _publish(_svc.remove_client(idx))
    return true

# Window management

pub fn smux_window_closing(session_id: text, window_id: text) -> bool:
    if smux_session_closing(session_id): return true
    if pane_close_window_pending(_closing_panes, session_id, window_id): return true
    for closing in _closing_windows:
        if closing == window_id: return true
    return false

pub fn smux_kill_window(session_id: text, window_id: text) -> Result<bool, text>:
    if _window_idx(_svc, session_id, window_id) < 0:
        return Err("unknown window in session: " + window_id)
    # Delegate before taking a snapshot: session kill owns its sole commit and
    # attachment/lease teardown. This also covers an earlier partial close
    # whose window became the final survivor between retry attempts.
    if smux_list_windows(session_id).len() == 1:
        return smux_kill_session(session_id)
    if smux_session_closing(session_id):
        return Err("session is closing; retry kill-session: " + session_id)
    if not _closing_windows.contains(window_id):
        _closing_windows.push(window_id)
    _closing_panes = pane_close_forget(_closing_panes, session_id, window_id)
    val st = close_owned_children(_svc, session_id, window_id)
    val removed = remove_window_state(st, session_id, window_id)
    if removed.is_err():
        _svc = _publish(st)
        return Err("partial window cleanup pending or failed; retry kill-window: " + window_id)
    var checkpoints: [SplitCheckpoint] = []
    for saved in _split_checkpoints:
        if saved.before.id != window_id: checkpoints.push(saved)
    var pending: [text] = []
    for closing in _closing_windows:
        if closing != window_id: pending.push(closing)
    _split_checkpoints = checkpoints
    _closing_windows = pending
    _svc = _publish(removed.unwrap())
    return Ok(true)

pub fn smux_new_window(session_id: text, name: text) -> MuxWindow:
    if not smux_configuration_writable(): return MuxWindow.create("", session_id, name)
    if (smux_session_closing(session_id) or _svc.find_session_idx(session_id) < 0 or
            _svc.window_count >= SMUX_CAPACITY or _svc.pane_count >= SMUX_CAPACITY):
        return MuxWindow.create("", session_id, name)
    val n = _svc.next_id
    val wid = id_text(n)
    val window = MuxWindow.create(wid, session_id, name)
    var st = _svc.add_window(window)
    st = st.add_pane(PaneRecord.create(MuxPane.create(id_text(n + 1), wid, session_id)).with_focus(true))
    _svc = _publish(st.with_next_id(n + 2))
    return window

pub fn smux_list_windows(session_id: text) -> [MuxWindow]:
    var result: [MuxWindow] = []
    var i = 0
    while i < _svc.window_count:
        val w = _svc.get_window(i)
        if w.session_id == session_id:
            result.push(w)
        i = i + 1
    return result

pub fn smux_focus_window(session_id: text, window_id: text) -> bool:
    if not smux_configuration_writable(): return false
    if smux_window_closing(session_id, window_id): return false
    if _window_idx(_svc, session_id, window_id) < 0:
        return false
    var st = _svc
    var i = 0
    while i < st.window_count:
        val w = st.get_window(i)
        if w.session_id == session_id:
            st = st.replace_window(i, w.with_active(w.id == window_id))
        i = i + 1
    _svc = _publish(st)
    return true

pub fn smux_active_window(session_id: text) -> Result<MuxWindow, text>:
    for w in smux_list_windows(session_id):
        if w.is_active:
            return Ok(w)
    return Err("no active window in session: " + session_id)

# Pane management

pub fn smux_list_panes(session_id: text, window_id: text) -> [MuxPane]:
    var result: [MuxPane] = []
    var i = 0
    while i < _svc.pane_count:
        val pr = _svc.get_pane(i)
        if (pr.pane.session_id == session_id and
            pr.pane.window_id == window_id):
            result.push(pr.pane)
        i = i + 1
    return result

pub fn smux_split_pane(session_id: text, window_id: text, pane_id: text, direction: text) -> Result<MuxPane, text>:
    return smux_split_pane_sized(session_id, window_id, pane_id, direction, MuxSplitSizeV1.Equal)

pub fn smux_split_pane_sized(session_id: text, window_id: text, pane_id: text, direction: text, size: MuxSplitSizeV1) -> Result<MuxPane, text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    if smux_window_closing(session_id, window_id): return Err("window or session is closing: " + window_id)
    val before = _svc
    val added_id = id_text(before.next_id)
    val result = split_window_sized_state(before, added_id, session_id, window_id, pane_id, direction, size)
    _geometry_quarantine(window_id, result)
    if result.is_err(): return Err(result.unwrap_err())
    val committed = result.unwrap()
    val checkpoint = split_checkpoint_capture(before, committed, session_id, window_id, added_id)
    var checkpoints: [SplitCheckpoint] = []
    for saved in _split_checkpoints:
        if saved.before.id != window_id and before.find_window_idx(saved.before.id) >= 0:
            checkpoints.push(saved)
    checkpoints.push(checkpoint)
    val new_pane = committed.get_pane(committed.find_pane_idx(added_id)).pane
    _split_checkpoints = checkpoints
    _svc = _publish(committed)
    return Ok(new_pane)

# Only the most recent split in this window can be rolled back. The opaque
# service-owned checkpoint compares IDs, child handles and complete geometry;
# callers cannot supply replacement state or resurrect a removed child.
pub fn smux_rollback_split(session_id: text, window_id: text, added_pane_id: text) -> Result<bool, text>:
    # Checked compensation may consume the reserved cleanup tick; no new split.
    if smux_window_closing(session_id, window_id): return Err("window or session is closing: " + window_id)
    var match_index = -1
    var i = 0
    while i < _split_checkpoints.len():
        val checkpoint = _split_checkpoints[i]
        if checkpoint.before.session_id == session_id and checkpoint.before.id == window_id and checkpoint.added_pane == added_pane_id:
            match_index = i
        i = i + 1
    if match_index < 0:
        return Err("split rollback checkpoint missing")
    if not service_revision_rollback_allowed(_revisions, match_index >= 0, smux_window_closing(session_id, window_id)):
        return Err("split rollback authority unavailable")
    val restored = split_checkpoint_restore(_svc, _split_checkpoints[match_index])
    _geometry_quarantine(window_id, restored)
    if restored.is_err():
        return Err(restored.unwrap_err())
    var remaining: [SplitCheckpoint] = []
    i = 0
    while i < _split_checkpoints.len():
        if i != match_index:
            remaining.push(_split_checkpoints[i])
        i = i + 1
    _split_checkpoints = remaining
    _svc = _publish(restored.unwrap())
    return Ok(true)

# False preserves the native handle and freezes this window for close retry.
# Only successful native teardown permits pane removal/geometry commit.
pub fn smux_close_pane(session_id: text, window_id: text, pane_id: text) -> bool:
    if _pane_idx(_svc, session_id, window_id, pane_id) < 0: return false
    if smux_list_panes(session_id, window_id).len() == 1:
        return smux_kill_window(session_id, window_id).is_ok()
    if smux_session_closing(session_id) or _closing_windows.contains(window_id): return false
    val updated = close_pane_state(_svc, _closing_panes, session_id, window_id, pane_id)
    if updated.uncertain and not _closing_windows.contains(window_id): _closing_windows.push(window_id)
    if updated.closed:
        var kept: [SplitCheckpoint] = []
        for saved in _split_checkpoints:
            if saved.before.id != window_id: kept.push(saved)
        _split_checkpoints = kept
    _closing_panes = updated.pending
    _svc = _publish(updated.state)
    return updated.closed

pub fn smux_focus_pane(session_id: text, window_id: text, pane_id: text) -> bool:
    if not smux_configuration_writable(): return false
    if smux_window_closing(session_id, window_id): return false
    val updated = focus_window_state(_svc, session_id, window_id, pane_id)
    _geometry_quarantine(window_id, updated)
    if updated.is_err(): return false
    _svc = _publish(updated.state)
    return true

pub fn smux_zoomed_pane(session_id: text, window_id: text) -> text:
    val wi = _svc.find_window_idx(window_id)
    if wi < 0 or _svc.get_window(wi).session_id != session_id: return ""
    return _svc.get_window(wi).zoom_pane

# A valid target toggles the entire window. Empty success means restored (or
# an unchanged single-pane window), never an unsupported default implementation.
pub fn smux_toggle_zoom(session_id: text, window_id: text, pane_id: text) -> Result<text, text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    if smux_window_closing(session_id, window_id): return Err("window or session is closing: " + window_id)
    val updated = toggle_zoom_state(_svc, session_id, window_id, pane_id)
    _geometry_quarantine(window_id, updated)
    if updated.is_err(): return Err(updated.error)
    val zoom = updated.state.get_window(updated.state.find_window_idx(window_id)).zoom_pane
    _svc = _publish(updated.state)
    return Ok(zoom)

pub fn smux_focused_pane(session_id: text, window_id: text) -> Result<MuxPane, text>:
    var i = 0
    while i < _svc.pane_count:
        val pr = _svc.get_pane(i)
        if pr.pane.session_id == session_id and pr.pane.window_id == window_id and pr.focus:
            return Ok(pr.pane)
        i = i + 1
    return Err("no focused pane in window: " + window_id)

# Native provider resizing precedes the corresponding VT/service commit.
# Piped/no-child panes permit grid-only changes; owned PTYs require resizing.
pub fn smux_resize(session_id: text, window_id: text, pane_id: text, cols: int, rows: int) -> Result<MuxPane, text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    if smux_window_closing(session_id, window_id): return Err("window or session is closing: " + window_id)
    val result = resize_pane_state(_svc, session_id, window_id, pane_id, cols, rows)
    _geometry_quarantine(window_id, result)
    if result.is_err(): return Err(result.unwrap_err())
    val updated = result.unwrap()
    val pane = updated.get_pane(updated.find_pane_idx(pane_id)).pane
    _svc = _publish(updated)
    return Ok(pane)

# Child processes

# Attaches a piped child (no controlling terminal). Returns its pid.
pub fn smux_pane_spawn(session_id: text, window_id: text, pane_id: text, cmd: text, args: [text]) -> Result<i64, text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    val updated = pane_spawn_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id, cmd, args)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

# Attaches a child on a real pseudo-terminal sized to the pane geometry.
# `command_line` is handed to the platform launcher as one line (a shell path
# on POSIX, a CreateProcess command line on Windows). Returns its pid.
pub fn smux_pane_spawn_pty(session_id: text, window_id: text, pane_id: text, command_line: text) -> Result<i64, text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    val updated = pane_spawn_pty_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id, command_line)
    if updated.cleanup_pending:
        _closing_panes.push(PaneClosePending(session_id: session_id, window_id: window_id, pane_id: pane_id))
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

pub fn smux_pane_is_pty(session_id: text, window_id: text, pane_id: text) -> Result<bool, text>:
    val updated = pane_is_pty_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

pub fn smux_pane_alive(session_id: text, window_id: text, pane_id: text) -> Result<bool, text>:
    val updated = pane_alive_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

# Ends the PTY child but keeps the pane (and its captured output).
pub fn smux_pane_close_pty(session_id: text, window_id: text, pane_id: text) -> bool:
    val updated = pane_close_pty_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

# Input / Output

# Accepts raw input into the pane's bounded owner queue and offers one byte
# prefix to its provider. A pane without a child refuses input. Delivery may
# remain pending after acceptance; smux_input_status reports progress/errors.
pub fn smux_send_text(session_id: text, window_id: text, pane_id: text, text_input: text) -> Result<text, text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    val updated = pane_send_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id, text_input)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

pub fn smux_input_status(session_id: text, window_id: text, pane_id: text) -> Result<text, text>:
    val updated = pane_input_status_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

# Types `command` and submits it: Enter is `\r` on a terminal (what a key
# press sends) and `\n` on a pipe.
pub fn smux_send_command(session_id: text, window_id: text, pane_id: text, command: text) -> Result<text, text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    val updated = pane_command_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id, command)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

pub fn smux_capture(session_id: text, window_id: text, pane_id: text, history_lines: int) -> Result<MuxCapture, text>:
    val updated = pane_capture_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id, history_lines)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

# Like smux_capture, but each row keeps its styling as ANSI SGR runs
# (`ESC[0;<params>m` where attributes change, `ESC[0m` at a styled row's end).
pub fn smux_capture_styled(session_id: text, window_id: text, pane_id: text, history_lines: int) -> Result<text, text>:
    val updated = pane_capture_styled_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id, history_lines)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

# True when the pane's child has bracketed paste (?2004) enabled. Drains first:
# the mode is set by what the child printed.
pub fn smux_pane_bracketed_paste(session_id: text, window_id: text, pane_id: text) -> Result<bool, text>:
    val updated = pane_bracketed_paste_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

# Pastes `body` into the pane: wrapped in ESC[200~ ... ESC[201~ when the child
# enabled bracketed paste, so it is taken as one paste (newlines included)
# rather than typed keys; sent as-is otherwise. Does not submit.
pub fn smux_paste_text(session_id: text, window_id: text, pane_id: text, body: text) -> Result<text, text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    val updated = pane_paste_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id, body)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

# Backend contract

pub fn smux_backend_contract_name() -> text:
    return "smux-native"

# Deferred feature gate

pub fn smux_is_deferred_feature(feature: text) -> bool:
    # Hosted interactive copy navigation/line selection is implemented.
    # Exact tmux key-table/config compatibility remains separately deferred.
    if feature == "mouse":
        return true
    if feature == "key-table-compat":
        return true
    if feature == "tmux-conf":
        return true
    if feature == "control-mode":
        return true
    return false

# Observability

pub fn smux_metrics() -> SmuxMetrics:
    return _svc.metrics

# A cell-preserving snapshot for composite frames. Wide glyph continuations
# remain empty cells; reconstructing columns from a flattened text loses them.
pub fn smux_capture_cells(session_id: text, window_id: text, pane_id: text) -> Result<[[text]], text>:
    val updated = pane_capture_cells_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

# A directional split, pane removal or explicit pane resize replaces the named
# plan with persisted manual coordinates. Named selection remains explicit.
pub fn smux_window_layout(session_id: text, window_id: text) -> Result<text, text>:
    return window_layout_name(_svc, session_id, window_id)

# Rectangles use production pane IDs and persisted named or manual geometry.
# This never captures child output.
pub fn smux_window_rects(session_id: text, window_id: text) -> [MuxRect]:
    return window_content_rects(_svc, session_id, window_id)

# Commit metadata and pane grids once after complete validation. Child handles,
# process IDs, focus and output owners are retained by PaneRecord.resize.
# A capable provider receives each resize first; failure triggers best-effort
# rollback before any service metadata is committed. Owned PTYs refuse missing
# resize support. Actual child geometry still requires runtime evidence.
pub fn smux_select_layout(session_id: text, window_id: text, name: text, cols: int, rows: int) -> Result<[MuxRect], text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    if smux_window_closing(session_id, window_id): return Err("window or session is closing: " + window_id)
    if not mux_layout_known(name):
        return Err("invalid layout: " + name)
    val planned = _arrange_window(_svc, session_id, window_id, name, cols, rows)
    _geometry_quarantine(window_id, planned)
    if planned.is_err():
        return Err(planned.unwrap_err())
    val changed = planned.unwrap()
    val rects = window_layout_rects(changed, session_id, window_id)
    _svc = _publish(changed)
    return Ok(rects)

# Reflow the existing plan, including manual nested splits. Never select an
# unrelated named layout because a window has manual geometry.
pub fn smux_arrange_window(session_id: text, window_id: text, cols: int, rows: int) -> Result<[MuxRect], text>:
    if not smux_configuration_writable(): return Err("service revision authority exhausted")
    if smux_window_closing(session_id, window_id): return Err("window or session is closing: " + window_id)
    val planned = _arrange_window(_svc, session_id, window_id, "", cols, rows)
    _geometry_quarantine(window_id, planned)
    if planned.is_err():
        return Err(planned.unwrap_err())
    val changed = planned.unwrap()
    val rects = window_layout_rects(changed, session_id, window_id)
    _svc = _publish(changed)
    return Ok(rects)

# Capture retained terminal history plus the visible frame in one snapshot.
# Limit validation and full pane ownership precede any drain or state change.
pub fn smux_capture_history(session_id: text, window_id: text, pane_id: text, max_lines: int) -> Result<MuxCapture, text>:
    val updated = pane_capture_history_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, pane_id, max_lines)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

# One bounded drain per pane and one authoritative commit for a complete frame.
pub fn smux_capture_frame(session_id: text, window_id: text, cursor_pane: text = "") -> Result<text, text>:
    val updated = pane_capture_frame_state(_svc, smux_window_closing(session_id, window_id), session_id, window_id, cursor_pane)
    if updated.commit: _svc = _publish(updated.state)
    return updated.result

# Presentation helpers own native compensation; API owns the one publication.
fn _presentation_open(session: text, window: text) -> bool:
    return smux_configuration_writable() and not smux_window_closing(session, window)

fn _publish_geometry(window: text, update: WindowGeometryUpdate) -> Result<bool, text>:
    _geometry_quarantine(window, update)
    if update.is_err(): return Err(update.error)
    _svc = _publish(update.state)
    return Ok(true)

pub fn smux_pane_hidden(session: text, window: text, pane: text) -> bool:
    return pane_is_hidden(_svc, session, window, pane)

pub fn smux_set_pane_title(session: text, window: text, pane: text, title: text) -> Result<bool, text>:
    if not _presentation_open(session, window): return Err("window mutation authority unavailable")
    return _publish_geometry(window, set_pane_title_state(_svc, session, window, pane, title))

pub fn smux_set_pane_border(session: text, window: text, pane: text, border: MuxBorderV1) -> Result<bool, text>:
    if not _presentation_open(session, window): return Err("window mutation authority unavailable")
    return _publish_geometry(window, set_pane_border_state(_svc, session, window, pane, border))

pub fn smux_set_pane_border_status(session: text, window: text, pane: text, status: MuxBorderStatusV1) -> Result<bool, text>:
    if not _presentation_open(session, window): return Err("window mutation authority unavailable")
    return _publish_geometry(window, set_pane_border_status_state(_svc, session, window, pane, status))

pub fn smux_hide_pane(session: text, window: text, pane: text) -> Result<bool, text>:
    if not _presentation_open(session, window): return Err("window mutation authority unavailable")
    return _publish_geometry(window, hide_pane_state(_svc, session, window, pane))

pub fn smux_show_pane(session: text, window: text, pane: text) -> Result<bool, text>:
    if not _presentation_open(session, window): return Err("window mutation authority unavailable")
    return _publish_geometry(window, show_pane_state(_svc, session, window, pane))

pub fn smux_rebalance_window(session: text, window: text) -> Result<bool, text>:
    if not _presentation_open(session, window): return Err("window mutation authority unavailable")
    return _publish_geometry(window, rebalance_window_state(_svc, session, window))
