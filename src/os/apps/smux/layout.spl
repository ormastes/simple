# Smux Layout Helpers

class MuxSplitPlan:
    old_cols: i32
    old_rows: i32
    new_cols: i32
    new_rows: i32

pub fn smux_plan_split(cols: i32, rows: i32, direction: text) -> Result<MuxSplitPlan, text>:
    if cols <= 0 or rows <= 0:
        return Err("pane dimensions must be positive")
    if direction == "horizontal" or direction == "h":
        if rows < 3:
            return Err("pane too small for horizontal split")
        val old_rows = (rows - 1) / 2
        val new_rows = rows - old_rows - 1
        return Ok(MuxSplitPlan(old_cols: cols, old_rows: old_rows, new_cols: cols, new_rows: new_rows))

    if direction == "vertical" or direction == "v":
        if cols < 3:
            return Err("pane too small for vertical split")
        val old_cols = (cols - 1) / 2
        val new_cols = cols - old_cols - 1
        return Ok(MuxSplitPlan(old_cols: old_cols, old_rows: rows, new_cols: new_cols, new_rows: rows))

    Err("invalid split direction: {direction}")

