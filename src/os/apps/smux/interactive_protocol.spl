# Explicit-target interactive commands. No mutation of session-global focus.
use os.apps.smux.api.{smux_list_windows, smux_list_panes,
    smux_send_text, smux_capture_frame, smux_select_layout, smux_arrange_window, smux_split_pane,
    smux_pane_spawn_pty, smux_rollback_split, smux_capture_history,
    smux_list_clients, smux_attach, smux_window_layout, smux_toggle_zoom, smux_zoomed_pane, smux_pane_hidden}
use os.apps.smux.contract.{MuxWindow, MuxPane}
use os.apps.smux.session_targets.{smux_resolve_session}
use os.apps.smux.lifecycle_reply.{smux_missing_window_reply, smux_missing_session_reply}
use std.sosix.pty.{sosix_pty_default_shell as platform_default_shell}
use std.common.string_core.{bytes_to_text}
use os.apps.smux.client_history_reply.{client_history_reply}

fn hex_digit(ch: i64) -> i64:
    if ch >= 48 and ch <= 57: return ch - 48
    if ch >= 97 and ch <= 102: return ch - 87
    if ch >= 65 and ch <= 70: return ch - 55
    return -1

fn complete_utf8(bytes: [u8]) -> bool:
    var i: i64 = 0
    while i < bytes.len():
        val lead = bytes[i] as i64
        var count: i64 = 0
        var low: i64 = 128
        var high: i64 = 191
        if lead < 128:
            i = i + 1
            continue
        elif lead >= 194 and lead <= 223: count = 1
        elif lead >= 224 and lead <= 239:
            count = 2
            if lead == 224: low = 160
            if lead == 237: high = 159
        elif lead >= 240 and lead <= 244:
            count = 3
            if lead == 240: low = 144
            if lead == 244: high = 143
        else: return false
        if i + count >= bytes.len(): return false
        val second = bytes[i + 1] as i64
        if second < low or second > high: return false
        var j: i64 = 2
        while j <= count:
            val continuation = bytes[i + j] as i64
            if continuation < 128 or continuation > 191: return false
            j = j + 1
        i = i + count + 1
    return true

pub fn smux_input_hex_decode(hex: text) -> Result<text, text>:
    if hex.len() == 0 or hex.len() > 2048 or hex.len() % 2 != 0:
        return Err("input requires 1..1024 complete UTF-8 bytes encoded as hex")
    var bytes: [u8] = []
    var i: i64 = 0
    while i < hex.len():
        val high = hex_digit(hex.byte_at(i))
        val low = hex_digit(hex.byte_at(i + 1))
        if high < 0 or low < 0: return Err("input contains invalid hex")
        bytes.push((high * 16 + low) as u8)
        i = i + 2
    if not complete_utf8(bytes): return Err("input is not complete UTF-8")
    return Ok(bytes_to_text(bytes))

fn session_identity(name: text) -> text:
    return smux_resolve_session(name)

fn target_window(session: text, window: text) -> Result<MuxWindow, text>:
    for candidate in smux_list_windows(session):
        if candidate.id == window: return Ok(candidate)
    return Err("unknown window: " + window)

fn target_pane(session: text, window: text, pane: text) -> Result<MuxPane, text>:
    for candidate in smux_list_panes(session, window):
        if candidate.id == pane: return Ok(candidate)
    return Err("unknown pane: " + pane)

fn valid_canvas(cols: int, rows: int) -> bool:
    return cols > 0 and cols <= 512 and rows > 0 and rows <= 256 and cols * rows <= 60000

# Read authoritative attachments each request. No separate client-size registry
# can outlive detach or retain an old size after an attachment is replaced.
fn attached_canvas(session: text, fallback_cols: int, fallback_rows: int) -> [int]:
    var cols = fallback_cols
    var rows = fallback_rows
    var found = false
    for client in smux_list_clients():
        if client.attached and client.session_id == session and client.cols > 0 and client.rows > 0:
            if not found or client.cols < cols: cols = client.cols
            if not found or client.rows < rows: rows = client.rows
            found = true
    return [cols, rows]

fn size_client(session: text, client_id: text, cols: int, rows: int) -> text:
    if client_id == "" or not valid_canvas(cols, rows): return "smux: client-size invalid dimensions or client"
    for client in smux_list_clients():
        if client.client_id == client_id and client.session_id != session:
            return "smux: client-size client belongs to another session"
    if not smux_attach(session, client_id, cols, rows).attached:
        return "smux: attach refused: " + client_id
    return "smux: attached " + client_id

fn reflow_attached_frame(session: text, window: MuxWindow) -> text:
    val size = attached_canvas(session, window.canvas_cols, window.canvas_rows)
    if not valid_canvas(size[0], size[1]): return "frame canvas exceeds remote limit"
    if size[0] == window.canvas_cols and size[1] == window.canvas_rows: return ""
    val resized = smux_arrange_window(session, window.id, size[0], size[1])
    if resized.is_err(): return resized.unwrap_err()
    return ""

fn interactive_split(session: text, window: MuxWindow, pane: MuxPane, direction: text) -> text:
    val split = smux_split_pane(session, window.id, pane.id, direction)
    if split.is_err(): return "smux: split failed: " + split.unwrap_err()
    val added = split.unwrap()
    val spawned = smux_pane_spawn_pty(session, window.id, added.id, platform_default_shell())
    if spawned.is_err():
        val restored = smux_rollback_split(session, window.id, added.id)
        return "smux: split failed: " + spawned.unwrap_err() + (if restored.is_ok(): "" else: "; rollback incomplete: " + restored.unwrap_err())
    return "smux: split pane " + added.id

pub fn smux_interactive_dispatch(line: text) -> text:
    val parts = line.trim().split(" ")
    if parts.len() == 0: return ""
    val verb = parts[0]
    if verb != "input" and verb != "frame" and verb != "client-size" and verb != "client-panes" and verb != "client-layout" and verb != "client-split" and verb != "client-history" and verb != "client-zoom":
        return ""
    if parts.len() < 3: return "smux: interactive command requires session and window"
    val session = session_identity(parts[1])
    if session == "": return smux_missing_session_reply(parts[1])
    if verb == "client-size":
        if parts.len() != 5: return "smux: client-size requires session client cols rows"
        return size_client(session, parts[2], parts[3].to_int() ?? 0, parts[4].to_int() ?? 0)
    val found = target_window(session, parts[2])
    if found.is_err(): return smux_missing_window_reply(parts[2])
    val window = found.unwrap()
    if verb == "frame":
        if parts.len() != 3 and parts.len() != 4: return "smux: frame requires session window and optional cursor pane"
        val pane = if parts.len() == 4: parts[3] else: ""
        if pane != "" and target_pane(session, window.id, pane).is_err(): return "smux: unknown cursor pane: " + pane
        val reflow_error = reflow_attached_frame(session, window)
        if reflow_error != "": return "smux: frame failed: " + reflow_error
        val frame = smux_capture_frame(session, window.id, pane)
        if frame.is_err(): return "smux: frame failed: " + frame.unwrap_err()
        return frame.unwrap()
    if verb == "client-panes":
        if parts.len() != 3: return "smux: client-panes requires session and window"
        var reply = "smux: panes[" + parts[1] + "]:\n"
        val zoom = smux_zoomed_pane(session, window.id)
        for pane in smux_list_panes(session, window.id):
            if not smux_pane_hidden(session, window.id, pane.id) and (zoom == "" or zoom == pane.id):
                reply = reply + pane.id + " " + pane.cols.to_text() + "x" + pane.rows.to_text() + "\n"
        return reply
    if verb == "client-layout":
        if parts.len() != 6: return "smux: client-layout requires session window name cols rows"
        val cols = parts[4].to_int() ?? 0
        val rows = parts[5].to_int() ?? 0
        if not valid_canvas(cols, rows):
            return "smux: layout failed: canvas exceeds remote limit"
        val size = attached_canvas(session, cols, rows)
        val bounded_cols = if size[0] < cols: size[0] else: cols
        val bounded_rows = if size[1] < rows: size[1] else: rows
        if not valid_canvas(bounded_cols, bounded_rows): return "smux: layout failed: canvas exceeds remote limit"
        val layout = parts[3]
        val selected = if layout == "current": smux_arrange_window(session, window.id, bounded_cols, bounded_rows) else: smux_select_layout(session, window.id, layout, bounded_cols, bounded_rows)
        if selected.is_err(): return "smux: layout failed: " + selected.unwrap_err()
        val applied = smux_window_layout(session, window.id)
        if applied.is_err(): return "smux: layout failed: " + applied.unwrap_err()
        return "smux: layout " + applied.unwrap()
    if parts.len() < 4: return "smux: interactive command requires pane"
    val selected_pane = target_pane(session, window.id, parts[3])
    if selected_pane.is_err(): return "smux: " + selected_pane.unwrap_err()
    if verb == "client-zoom":
        if parts.len() != 4: return "smux: client-zoom requires session window pane"
        val result = smux_toggle_zoom(session, window.id, parts[3])
        if result.is_err(): return "smux: zoom failed: " + result.unwrap_err()
        return if result.unwrap() == "": "smux: zoom restored" else: "smux: zoom " + result.unwrap()
    if verb == "input":
        if parts.len() != 5: return "smux: input requires session window pane hex"
        if smux_pane_hidden(session, window.id, parts[3]): return "smux: input pane is explicitly hidden: " + parts[3]
        val zoom = smux_zoomed_pane(session, window.id)
        if zoom != "" and zoom != parts[3]: return "smux: input pane is hidden by window zoom: " + parts[3]
        val decoded = smux_input_hex_decode(parts[4])
        if decoded.is_err(): return "smux: input failed: " + decoded.unwrap_err()
        val sent = smux_send_text(session, window.id, parts[3], decoded.unwrap())
        if sent.is_err(): return "smux: input failed: " + sent.unwrap_err()
        return "smux: input accepted"
    if verb == "client-split":
        if parts.len() != 5: return "smux: client-split requires session window pane direction"
        return interactive_split(session, window, selected_pane.unwrap(), parts[4])
    if parts.len() != 5: return "smux: client-history requires session window pane lines"
    val count = parts[4].to_int() ?? 0
    if count <= 0 or count > 2000: return "smux: history line count must be between 1 and 2000"
    val history = smux_capture_history(session, window.id, parts[3], count)
    if history.is_err(): return "smux: history failed: " + history.unwrap_err()
    val bounded = client_history_reply("smux: history[" + parts[1] + "]:\n", history.unwrap().content)
    if bounded.is_err(): return "smux: history failed: " + bounded.unwrap_err()
    return bounded.unwrap()
