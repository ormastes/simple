# Transport state for the existing shared listener. These fields are DATA plus
# actual opaque socket/challenge capabilities; constructing data never mints a
# verified request. The canonical IO challenge owns replay/deadline admission.
use std.io.tcp.TcpStream
use std.common.string_core.text_to_bytes
use std.sosix.time.{sosix_time_now_monotonic_ms as time_now_monotonic_ms}
use std.nogc_sync_mut.io.host_service_auth_connection_v6.*
use std.nogc_sync_mut.io.host_service_ready_reader_v1.HostServiceReadyReaderV1
use std.common.contracts.orchestration.host_service_auth_frame_v6.host_service_auth_frame_line_decode_v6
use std.common.contracts.orchestration.host_service_operation_v6.HostServiceOperationRequestV6

const REPLY_LIMIT: i64 = 1048576
const CLIENT_DEADLINE_MS: i64 = 2000

pub struct SmuxPendingAuthRequestTurnV6:
    client: PendingClient
    request: Option<HostServiceOperationRequestV6>
    error: text

# The existing listener calls this and dispatches the returned request in the
# same turn. Only take_v6 can produce it; no raw frame creates native authority.
pub fn smux_pending_auth_request_v6(original: PendingClient, reader: HostServiceReadyReaderV1,
        line: text) -> SmuxPendingAuthRequestTurnV6:
    var client = original
    val frame = host_service_auth_frame_line_decode_v6(line)
    if frame.is_err(): return SmuxPendingAuthRequestTurnV6(client, nil, frame.unwrap_err())
    if client.auth_connection.is_none():
        val opened = host_service_auth_connection_begin_v6(reader, frame.unwrap(), client.deadline)
        if opened.is_err(): return SmuxPendingAuthRequestTurnV6(client, nil, opened.unwrap_err())
        client.auth_connection = Some(opened.unwrap().owner)
        return SmuxPendingAuthRequestTurnV6(authenticated_client_output_v6(client, opened.unwrap().challenge, true), nil, "")
    val connection = client.auth_connection.unwrap()
    val verified = host_service_auth_connection_accept_v6(connection, frame.unwrap())
    if verified.is_err(): return SmuxPendingAuthRequestTurnV6(client, nil, verified.unwrap_err())
    val taken = host_service_auth_connection_take_v6(connection, verified.unwrap())
    if taken.is_err(): return SmuxPendingAuthRequestTurnV6(client, nil, taken.unwrap_err())
    SmuxPendingAuthRequestTurnV6(client, Some(taken.unwrap()), "")

pub struct PendingClient:
    stream: TcpStream
    input: [u8]
    output: [u8]
    offset: i64
    deadline: i64
    replying: bool
    stop_owner: bool
    auth_connection: Option<HostServiceAuthConnectionV6> = nil
    auth_challenge: bool = false

pub fn authenticated_client_output_v6(original: PendingClient, body: text,
        challenge: bool, stop: bool = false) -> PendingClient:
    var client = original
    client.input = []
    client.output = text_to_bytes("SMUX/1 " + body.byte_len().to_text() + "\n" + body)
    client.offset = 0
    client.replying = true
    client.auth_challenge = challenge
    client.stop_owner = stop
    # Never renew the original deadline after challenge, request or progress.
    client


pub fn prepare_reply(client: PendingClient, reply: text, stop: bool) -> PendingClient:
    var output = text_to_bytes(reply)
    if output.len() > REPLY_LIMIT:
        output = text_to_bytes("smux: reply exceeds limit")
    output = text_to_bytes("SMUX/1 " + output.len().to_text() + "\n") + output
    return PendingClient(stream: client.stream, input: [], output: output,
        offset: 0, deadline: time_now_monotonic_ms() + CLIENT_DEADLINE_MS,
        replying: true, stop_owner: stop)

# EOF alone cannot certify a complete response: a failed partial socket write
# also ends the stream. The length frame makes truncation an explicit failure.

# Inclusive wire bound includes prefix, unpadded base64 and final LF. This is
# checked before the listener appends bytes or decodes a handshake frame.
pub fn smux_pending_auth_line_limit_v6(client: PendingClient) -> i64:
    if client.auth_connection.is_none(): 5484 else: 2796225
