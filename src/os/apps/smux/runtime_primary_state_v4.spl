# V4 primary provenance only. The latest Host root lives solely in the existing
# runtime binding owner. After adoption the only live session is in PaneRecord.
use os.apps.smux.runtime_primary_request_v4.SmuxRuntimePrimaryRequestV4
use std.common.contracts.container.primary_attach_v1.ContainerPrimaryAttachPlanV1
use std.nogc_sync_mut.orchestration.host_helper_owner_v1.HostHelperLeaseV1
use std.nogc_sync_mut.orchestration.host_primary_attach_recovery_v1.HostPrimaryAttachRecoveredV1
use std.nogc_sync_mut.orchestration.host_helper_settlement_commit_v1.HostHelperSettlementAckV1
use std.nogc_async_mut.container.terminal_session_v1.ContainerPrimaryAttachSessionV1
use std.nogc_sync_mut.io.process_ops.PipedProcessOwnedSpawnV2

pub struct SmuxRuntimePrimaryEntryV4:
    request: SmuxRuntimePrimaryRequestV4
    plan: ContainerPrimaryAttachPlanV1
    helper: HostHelperLeaseV1? = nil
    session: ContainerPrimaryAttachSessionV1? = nil
    cleanup_spawn: PipedProcessOwnedSpawnV2? = nil
    recovered: HostPrimaryAttachRecoveredV1? = nil
    adopted: bool = false
    session_identity: text = ""
    native_identity: text = ""
    settlement_ack: HostHelperSettlementAckV1? = nil
    status: text = "unconfirmed"
    code: text = "primary-host-release-pending"

pub fn smux_primary_index_v4(entries: [SmuxRuntimePrimaryEntryV4], uid: text) -> int:
    var index = 0
    while index < entries.len():
        if entries[index].request.target.binding_uid == uid: return index
        index = index + 1
    -1
