#![allow(REQC004)]
# Resolve authority only from the live adopted pane and its retained binding.
# This function never reads output and never opens a second native transport.
use os.apps.smux.runtime_binding_state_v3.{SmuxRuntimeBindingOwnerV3, smux_runtime_binding_index_v3, smux_output_entry_blocks_v4}
use os.apps.smux.api.{smux_owner_snapshot, smux_configuration_revision, smux_window_closing, smux_client_lease_snapshot}
use os.apps.smux.client_leases.ClientLease
use os.apps.smux.runtime_binding_target_v3.smux_runtime_target_v3
use std.common.contracts.mux.session_runtime_control_v1.{SessionRuntimeControlTargetV1, session_runtime_control_target_validate_v1}
use std.sosix.process.{PipedProcessOwnedSpawnV2, PipedProcessOwnedTransferV2,
    sosix_process_piped_owned_transfer_equal_v2, sosix_process_validate_piped_owned_transfer_v2}
use os.apps.smux.runtime_primary_state_v4.smux_primary_index_v4
use std.common.task_runner.distributed_operation_journal_v2.distributed_operation_journal_lookup_v2
use std.nogc_async_mut.container.terminal_session_v1.{ContainerPrimaryAttachSessionV1,
    ContainerOwnedTerminalSessionV1, container_primary_attach_identity_v1,
    container_primary_attach_adoption_v1, container_primary_attach_native_cleaned_v1,
    container_terminal_validate_v1}

pub struct SmuxRuntimeControlResolvedV1:
    target: SessionRuntimeControlTargetV1
    attachment: ClientLease
    primary: ContainerPrimaryAttachSessionV1? = nil

fn primary_control_target_v4(owner: SmuxRuntimeBindingOwnerV3, uid: text,
        client_id: text, attachment_token: text) -> Result<SmuxRuntimeControlResolvedV1, text>:
    val index = smux_primary_index_v4(owner.primary_entries, uid)
    if index < 0: return Err("runtime-control-binding-unavailable")
    val entry = owner.primary_entries[index]
    if (not entry.adopted or entry.helper == nil or entry.session != nil or entry.cleanup_spawn != nil or
            entry.recovered != nil or entry.settlement_ack != nil or entry.status != "adopted-opening"):
        return Err("runtime-control-primary-not-adopted")
    val request = entry.request.target
    val parent = distributed_operation_journal_lookup_v2(owner.local.capacity.journal, request.workload_operation_id)
    val helper = distributed_operation_journal_lookup_v2(owner.local.capacity.journal, request.helper_operation_id)
    if (parent.is_err() or helper.is_err() or parent.unwrap().state != "executing" or helper.unwrap().state != "executing"):
        return Err("runtime-control-primary-host-not-executing")
    val attachment = smux_client_lease_snapshot(request.session_id, client_id, attachment_token)?
    val snapshot = smux_owner_snapshot()
    val current = smux_runtime_target_v3(snapshot, smux_configuration_revision(),
        smux_window_closing(request.session_id, request.window_id), owner.service_incarnation,
        request.session_id, request.window_id, request.pane_id)?
    if (current.epoch != request.expected_epoch or current.epoch > 9223372036854775807 or
            current.child_incarnation > 9223372036854775807 or
            current.child_incarnation != request.expected_child_incarnation + 1):
        return Err("runtime-control-primary-incarnation")
    val pane = snapshot.get_pane(snapshot.find_pane_idx(request.pane_id))
    if pane.helper_cleaned_awaiting_release or pane.terminal_eof or pane.terminal_read_error != "":
        return Err("runtime-control-primary-stream-unavailable")
    val session = match pane.owned_terminal_session:
        case Some(ContainerOwnedTerminalSessionV1.PrimaryAttach(value)): value
        case _: return Err("runtime-control-primary-owner-missing")
    val adoption = match container_primary_attach_adoption_v1(session):
        case Some(value): value
        case nil: return Err("runtime-control-primary-adoption-missing")
    if (container_primary_attach_identity_v1(session) != entry.session_identity or
            container_primary_attach_native_cleaned_v1(session) or adoption.binding_uid != uid or
            adoption.service_incarnation != owner.service_incarnation or adoption.session_id != request.session_id or
            adoption.window_id != request.window_id or adoption.pane_id != request.pane_id or
            adoption.service_epoch != current.epoch as i64 or adoption.child_incarnation != current.child_incarnation as i64):
        return Err("runtime-control-primary-adoption-changed")
    container_terminal_validate_v1(ContainerOwnedTerminalSessionV1.PrimaryAttach(session))?
    val target = SessionRuntimeControlTargetV1(scope: owner.local.scope, runtime: entry.plan.runtime,
        workload_request_digest: entry.plan.workload.request_digest, binding_uid: uid,
        binding_digest: entry.plan.identity.binding_digest, service_incarnation: owner.service_incarnation,
        session_id: request.session_id, window_id: request.window_id, pane_id: request.pane_id,
        service_epoch: current.epoch as i64, child_incarnation: current.child_incarnation as i64,
        client_id: attachment.client_id, attachment_generation: attachment.generation,
        execution_kind: "primary", native_exec_id: "", exec_request_digest: "")
    session_runtime_control_target_validate_v1(target)?
    Ok(SmuxRuntimeControlResolvedV1(target, attachment, Some(session)))

pub fn smux_runtime_control_target_v1(owner: SmuxRuntimeBindingOwnerV3, uid: text,
        client_id: text, attachment_token: text) -> Result<SmuxRuntimeControlResolvedV1, text>:
    val index = smux_runtime_binding_index_v3(owner, uid)
    if index < 0: return primary_control_target_v4(owner, uid, client_id, attachment_token)
    val entry = owner.entries[index]
    if not smux_output_entry_blocks_v4(entry, uid):
        return primary_control_target_v4(owner, uid, client_id, attachment_token)
    if (not entry.adopted or entry.native_cleaned or entry.retained == nil or
            entry.recovered != nil or entry.settlement_ack != nil):
        return Err("runtime-control-binding-not-adopted")
    val request = entry.request
    val attachment = smux_client_lease_snapshot(request.session_id, client_id, attachment_token)?
    val snapshot = smux_owner_snapshot()
    val current = smux_runtime_target_v3(snapshot, smux_configuration_revision(),
        smux_window_closing(request.session_id, request.window_id), owner.service_incarnation,
        request.session_id, request.window_id, request.pane_id)?
    if (current.epoch != request.expected_epoch or current.epoch > 9223372036854775807 or
            current.child_incarnation > 9223372036854775807):
        return Err("runtime-control-target-incarnation")
    val pane = snapshot.get_pane(snapshot.find_pane_idx(request.pane_id))
    if (pane.output_terminal_transfer() == nil or pane.helper_cleaned_awaiting_release or
            pane.terminal_eof or pane.terminal_read_error != ""):
        return Err("runtime-control-stream-unavailable")
    val original = match entry.retained.unwrap().child_spawn:
        case PipedProcessOwnedSpawnV2.Ready(native_owner, reference):
            PipedProcessOwnedTransferV2(native_owner, reference)
        case _: return Err("runtime-control-stream-not-transferred")
    if not sosix_process_piped_owned_transfer_equal_v2(original, pane.output_terminal_transfer().unwrap()):
        return Err("runtime-control-stream-replaced")
    sosix_process_validate_piped_owned_transfer_v2(pane.output_terminal_transfer().unwrap())?
    # The current output adapter follows the primary container process only.
    # Exec controls require a separate actual retained exec birth consumer.
    val target = SessionRuntimeControlTargetV1(scope: owner.local.scope, runtime: entry.plan.runtime,
        workload_request_digest: entry.plan.workload.request_digest, binding_uid: uid,
        binding_digest: entry.plan.identity.binding_digest, service_incarnation: owner.service_incarnation,
        session_id: request.session_id, window_id: request.window_id, pane_id: request.pane_id,
        service_epoch: current.epoch as i64, child_incarnation: current.child_incarnation as i64,
        client_id: attachment.client_id, attachment_generation: attachment.generation,
        execution_kind: "primary", native_exec_id: "", exec_request_digest: "")
    session_runtime_control_target_validate_v1(target)?
    Ok(SmuxRuntimeControlResolvedV1(target, attachment))
