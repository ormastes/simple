# Exact authenticated protocol errors used for client view recovery. Transport
# errors and lease failures must never be mistaken for resource disappearance.
pub fn smux_missing_window_reply(window_id: text) -> text:
    return "smux: unknown window: " + window_id

pub fn smux_missing_session_reply(session_id: text) -> text:
    return "smux: unknown session " + session_id
