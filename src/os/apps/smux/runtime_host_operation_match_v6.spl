# Pure correlation only. The canonical owner supplies its actual retained tuple
# immediately before the effect; caller metadata cannot mint that authority.
use std.common.contracts.orchestration.host_service_operation_v6.{HostServiceOperationRequestV6,
    host_service_operation_validate_v6}

pub fn smux_host_operation_match_v6(request: HostServiceOperationRequestV6,
        incarnation: text, scope_digest: text, operation_id: text, request_digest: text) -> Result<bool, text>:
    val valid = host_service_operation_validate_v6(request)?
    if request.action != "progress" and request.action != "cancel": return Err("runtime-host-bound-action")
    if (request.service_incarnation != incarnation or request.scope_digest != scope_digest or
            request.operation_id != operation_id or request.request_digest != request_digest):
        return Err("runtime-host-bound-operation-mismatch")
    Ok(true)
