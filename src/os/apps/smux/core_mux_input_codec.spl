# Exact explicit paste framing only. Typed keys require a separate mode/policy lane.
use std.common.contracts.mux.execution_v1.{MuxPasteV1}
use std.common.text_bytes.{text_byte_extraction_checked}

pub fn core_mux_paste_bytes_v1(paste: MuxPasteV1, max_bytes: i64) -> Result<[u8], text>:
    """Frame an entire paste without decoding its literal byte body."""
    if max_bytes < 0 or max_bytes > 65536: return Err("invalid paste capacity")
    val overhead = (if paste.bracketed: 12 else: 0) + (if paste.append_enter: 1 else: 0)
    if overhead > max_bytes or paste.bytes.len() > max_bytes - overhead:
        return Err("paste input capacity reached")
    val size = paste.bytes.len() + overhead
    var output: [u8] = [0u8; size]
    if text_byte_extraction_checked(size, output).is_err(): return Err("paste input allocation failed")
    var offset = 0
    if paste.bracketed:
        for byte in [27u8, 91u8, 50u8, 48u8, 48u8, 126u8]:
            output[offset] = byte
            offset = offset + 1
    for byte in paste.bytes:
        output[offset] = byte
        offset = offset + 1
    if paste.bracketed:
        for byte in [27u8, 91u8, 50u8, 48u8, 49u8, 126u8]:
            output[offset] = byte
            offset = offset + 1
    if paste.append_enter: output[offset] = 13u8
    return Ok(output)
