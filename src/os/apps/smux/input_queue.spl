# Sole-owner bounded input state. Offsets count bytes, including partial UTF-8
# scalars. Keep original text for the piped-process byte-offset ABI.
use std.common.text_bytes.{boxed_text_bytes_checked, text_bytes_concat_checked}

struct PaneInput:
    original: text
    bytes: [u8]
    offset: i64
    error: text
    # This stream cannot use the piped text ABI after arbitrary bytes enter it.
    literal_pty: bool = false

pub fn pane_input_new() -> PaneInput:
    return PaneInput(original: "", bytes: [], offset: 0, error: "")

pub fn pane_input_enqueue(queue: PaneInput, data: text) -> Result<PaneInput, text>:
    if queue.error != "":
        return Err(queue.error)
    if queue.offset < 0 or queue.offset > queue.bytes.len():
        return Err("invalid pane input offset")
    val extracted = boxed_text_bytes_checked(data)
    if extracted.is_err(): return Err("pane input byte extraction failed")
    val encoded = extracted.unwrap()
    # Count retained storage, not just the unconsumed suffix. Compact only at
    # completion, because slicing text inside a UTF-8 scalar corrupts replay.
    if queue.bytes.len() > 65536 or encoded.len() > 65536 - queue.bytes.len():
        return Err("pane input capacity reached")
    val joined = text_bytes_concat_checked(queue.bytes, encoded)
    if joined.is_err(): return Err("pane input allocation failed")
    val original = if queue.literal_pty: "" else: queue.original + data
    if not queue.literal_pty and original.len() != queue.original.len() + data.len():
        return Err("pane input text allocation failed")
    return Ok(PaneInput(original: original, bytes: joined.unwrap(),
        offset: queue.offset, error: "", literal_pty: queue.literal_pty))

pub fn pane_input_enqueue_bytes_v1(queue: PaneInput, data: [u8]) -> Result<PaneInput, text>:
    """Append exact terminal-channel bytes; never convert them through text."""
    if queue.error != "": return Err(queue.error)
    if queue.offset < 0 or queue.offset > queue.bytes.len(): return Err("invalid pane input offset")
    if queue.bytes.len() > 65536 or data.len() > 65536 - queue.bytes.len():
        return Err("pane input capacity reached")
    if data.len() == 0: return Ok(queue)
    val joined = text_bytes_concat_checked(queue.bytes, data)
    if joined.is_err(): return Err("pane input allocation failed")
    return Ok(PaneInput(original: "", bytes: joined.unwrap(), offset: queue.offset,
        error: "", literal_pty: true))

pub fn pane_input_remaining(queue: PaneInput) -> [u8]:
    if queue.offset < 0 or queue.offset > queue.bytes.len():
        return []
    var end = queue.offset + 4096
    if end > queue.bytes.len():
        end = queue.bytes.len()
    return queue.bytes[queue.offset:end]

# Length of the next paced PTY write: at most `limit` bytes, but never ending
# inside a UTF-8 scalar or an ESC sequence (ConPTY reads a lone trailing ESC
# as the Escape key). An escape sequence longer than `limit` is sent whole.
pub fn pane_input_paced_len(bytes: [u8], limit: i64) -> i64:
    var i: i64 = 0
    while i < bytes.len() and (i < limit or i == 0):
        i = i + _paced_unit_len(bytes, i)
    if i > bytes.len(): return bytes.len()
    return i

fn _paced_unit_len(bytes: [u8], at: i64) -> i64:
    val b = bytes[at] as i64
    if b == 27:
        if at + 1 >= bytes.len(): return 1
        val next = bytes[at + 1] as i64
        if next == 79: return if at + 2 < bytes.len(): 3 else: 2
        if next != 91: return 2
        var j = at + 2
        while j < bytes.len():
            val c = bytes[j] as i64
            if c >= 64 and c <= 126: return j - at + 1
            j = j + 1
        return j - at
    var n: i64 = 1
    while at + n < bytes.len() and ((bytes[at + n] as i64) & 192) == 128:
        n = n + 1
    return n

pub fn pane_input_advance(queue: PaneInput, accepted: i64) -> Result<PaneInput, text>:
    if queue.error != "":
        return Err(queue.error)
    if queue.offset < 0 or queue.offset > queue.bytes.len():
        return Err("invalid pane input offset")
    if accepted < 0 or accepted > queue.bytes.len() - queue.offset or accepted > 4096:
        return Err("invalid pane input byte count")
    val offset = queue.offset + accepted
    if offset == queue.bytes.len():
        return Ok(pane_input_new())
    return Ok(PaneInput(original: queue.original, bytes: queue.bytes,
        offset: offset, error: "", literal_pty: queue.literal_pty))

pub fn pane_input_fail(queue: PaneInput, error: text) -> PaneInput:
    var reason = error
    if queue.error != "":
        reason = queue.error
    elif reason == "":
        reason = "pane input write failed"
    return PaneInput(original: queue.original, bytes: queue.bytes,
        offset: queue.offset, error: reason, literal_pty: queue.literal_pty)

export PaneInput, pane_input_new, pane_input_enqueue, pane_input_remaining
export pane_input_advance, pane_input_fail
export pane_input_enqueue_bytes_v1, pane_input_paced_len
