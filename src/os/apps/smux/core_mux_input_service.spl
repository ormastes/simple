# No API/global authority and no key encoding. The caller commits each returned
# state exactly once, including failed writes after real queue/native effects.
use std.common.contracts.mux.execution_v1.{MuxPasteV1}
use os.apps.smux.service.{ServiceState}
use os.apps.smux.pane_io_service.{PaneTextUpdate, pane_send_bytes_state}
use os.apps.smux.core_mux_input_codec.{core_mux_paste_bytes_v1}

pub fn core_mux_paste_state_v1(before: ServiceState, closing: bool, session_id: text, window_id: text, pane_id: text, paste: MuxPasteV1) -> PaneTextUpdate:
    val payload = core_mux_paste_bytes_v1(paste, 65536)
    if payload.is_err(): return PaneTextUpdate(state: before, commit: false, result: Err(payload.unwrap_err()))
    # Explicit flags override neither bytes nor terminal state: caller selected
    # the framing. The one enqueue checks remaining retained capacity atomically.
    return pane_send_bytes_state(before, closing, session_id, window_id, pane_id, payload.unwrap())
