# mux_model.spl — in-process session/window/pane multiplexer state for the `cs`
# caret suite (and any host without tmux, i.e. Windows).
#
# EVERY function here is PURE over MuxSession: no I/O, no module-level mutable
# state, no pty is ever opened. A pane's process is identified by the opaque
# `pty_handle` / `pid` the CALLER supplies. That is what makes this testable with
# no pty, no tmux and no terminal attached.
#
# Relationship to the older smux surface (deliberate, not a duplicate module):
# os.apps.smux.contract already defines class-based MuxSession/MuxWindow/MuxPane,
# but those are BACKEND-CONTROL records (backend kind, generation, attachment) used
# by service.spl/api.spl and three existing specs. This module is a different
# surface: the pure in-process STATE model that owns a live TermScreen per pane.
# The two are never imported together, and mod.spl is intentionally left alone so
# the names cannot collide.
#
# Reused rather than reinvented:
#   - os.apps.smux.mux_rects  — the geometry split (see its `ponytail:` marker).
#   - std.common.term         — the pure VT/ANSI screen; panes hold TermScreen and
#                               never re-implement scrollback or rendering.
#
# ponytail: v1 lays panes out as N even vertical columns and has no split tree, so
# `mux_zoom_pane` is the only non-uniform geometry. Upgrade path: the recursive
# MuxLayoutNode described in mux_rects.spl — this file only consumes [MuxRect], so
# nothing below changes when that lands.

# NAMING: these are `*State` and not `MuxSession`/`MuxWindow`/`MuxPane` on
# purpose. `contract.spl` in this same package already defines CLASSES by those
# three names, with different fields (backend kind, generation, attachment),
# and `mod.spl` — the package hub — imports them. Two different types sharing a
# name inside one package is a trap for whoever imports the hub next, even
# while nothing co-imports them today. The suffix makes the two surfaces
# impossible to confuse at a call site.
use std.common.term.emulator.{
    TermScreen,
    term_new,
    term_feed,
    term_resize,
    term_render_text
}
use os.apps.smux.mux_rects.{
    MuxRect,
    mux_rect_to_text,
    mux_full_rect,
    mux_even_columns
}

struct MuxPane:
    pane_id: text
    title: text
    pty_handle: i64        # -1 when not attached
    pid: i64               # -1 when unknown
    screen: TermScreen
    active: bool
    zoomed: bool

struct MuxWindow:
    window_id: text
    panes: [MuxPane]
    active_pane: i64       # index; -1 when none

struct MuxSession:
    session_id: text
    windows: [MuxWindow]
    active_window: i64
    cols: i64
    rows: i64

# ---------------------------------------------------------------- internals

fn mux_pane_id_taken(w: MuxWindow, candidate: text) -> bool:
    var i = 0
    while i < w.panes.len():
        if w.panes[i].pane_id == candidate:
            return true
        i = i + 1
    return false

fn mux_next_pane_id(s: MuxSession, w: MuxWindow) -> text:
    var k = 0
    while k < 4096:
        val candidate = s.session_id + "." + w.window_id + ".p" + k.to_text()
        if mux_pane_id_taken(w, candidate) == false:
            return candidate
        k = k + 1
    return s.session_id + "." + w.window_id + ".p_overflow"

fn mux_window_zoom_index(w: MuxWindow) -> i64:
    var i = 0
    while i < w.panes.len():
        if w.panes[i].zoomed:
            return i
        i = i + 1
    return -1

# Geometry for one window at the given size. A zoomed pane owns the whole area
# and is the ONLY rect returned.
fn mux_window_rects(w: MuxWindow, cols: i64, rows: i64) -> [MuxRect]:
    val z = mux_window_zoom_index(w)
    if z >= 0:
        var one: [MuxRect] = []
        one.push(mux_full_rect(w.panes[z].pane_id, cols, rows))
        return one
    var ids: [text] = []
    var i = 0
    while i < w.panes.len():
        ids.push(w.panes[i].pane_id)
        i = i + 1
    return mux_even_columns(ids, cols, rows)

fn mux_rect_for(rects: [MuxRect], pane_id: text) -> MuxRect:
    var i = 0
    while i < rects.len():
        if rects[i].pane_id == pane_id:
            return rects[i]
        i = i + 1
    return MuxRect(pane_id: pane_id, col: 0, row: 0, cols: 0, rows: 0)

# Re-lay-out one window and term_resize every pane's screen to its own rect so
# content is never silently lost. A pane hidden behind a zoomed pane keeps the
# size it had; only visible panes are re-sized.
fn mux_relayout_window(w: MuxWindow, cols: i64, rows: i64, mark_active: bool) -> MuxWindow:
    val rects = mux_window_rects(w, cols, rows)
    var out: [MuxPane] = []
    var i = 0
    while i < w.panes.len():
        val p = w.panes[i]
        val r = mux_rect_for(rects, p.pane_id)
        var screen = p.screen
        if r.cols > 0 and r.rows > 0:
            screen = term_resize(screen, r.cols, r.rows)
        var is_active = p.active
        if mark_active:
            is_active = i == w.active_pane
        out.push(MuxPane(
            pane_id: p.pane_id,
            title: p.title,
            pty_handle: p.pty_handle,
            pid: p.pid,
            screen: screen,
            active: is_active,
            zoomed: p.zoomed
        ))
        i = i + 1
    return MuxWindow(window_id: w.window_id, panes: out, active_pane: w.active_pane)

fn mux_with_windows(s: MuxSession, windows: [MuxWindow]) -> MuxSession:
    return MuxSession(
        session_id: s.session_id,
        windows: windows,
        active_window: s.active_window,
        cols: s.cols,
        rows: s.rows
    )

fn mux_replace_window(s: MuxSession, idx: i64, w: MuxWindow) -> MuxSession:
    var out: [MuxWindow] = []
    var i = 0
    while i < s.windows.len():
        if i == idx:
            out.push(w)
        else:
            out.push(s.windows[i])
        i = i + 1
    return mux_with_windows(s, out)

fn mux_locate(s: MuxSession, pane_id: text) -> (i64, i64):
    var wi = 0
    while wi < s.windows.len():
        val w = s.windows[wi]
        var pi = 0
        while pi < w.panes.len():
            if w.panes[pi].pane_id == pane_id:
                return (wi, pi)
            pi = pi + 1
        wi = wi + 1
    return (-1, -1)

fn mux_pad_to(line: text, width: i64) -> text:
    var out = line
    if out.len() > width:
        return out.substring(0, width)
    while out.len() < width:
        out = out + " "
    return out

fn mux_line_of(lines: [text], idx: i64) -> text:
    if idx < 0:
        return ""
    if idx >= lines.len():
        return ""
    return lines[idx]

# ---------------------------------------------------------------- public API

fn mux_new(session_id: text, cols: i64, rows: i64) -> MuxSession:
    var c = cols
    if c < 1:
        c = 1
    var r = rows
    if r < 1:
        r = 1
    var panes: [MuxPane] = []
    var windows: [MuxWindow] = []
    windows.push(MuxWindow(window_id: session_id + ".w0", panes: panes, active_pane: -1))
    return MuxSession(
        session_id: session_id,
        windows: windows,
        active_window: 0,
        cols: c,
        rows: r
    )

fn mux_add_pane(s: MuxSession, title: text, pty_handle: i64, pid: i64) -> (MuxSession, text):
    if s.windows.len() == 0:
        return (s, "")
    var wi = s.active_window
    if wi < 0 or wi >= s.windows.len():
        wi = 0
    val w = s.windows[wi]
    val pane_id = mux_next_pane_id(s, w)
    var panes: [MuxPane] = []
    var i = 0
    while i < w.panes.len():
        val p = w.panes[i]
        panes.push(MuxPane(
            pane_id: p.pane_id,
            title: p.title,
            pty_handle: p.pty_handle,
            pid: p.pid,
            screen: p.screen,
            active: false,
            zoomed: p.zoomed
        ))
        i = i + 1
    panes.push(MuxPane(
        pane_id: pane_id,
        title: title,
        pty_handle: pty_handle,
        pid: pid,
        screen: term_new(s.cols, s.rows),
        active: true,
        zoomed: false
    ))
    val grown = MuxWindow(window_id: w.window_id, panes: panes, active_pane: panes.len() - 1)
    val laid = mux_relayout_window(grown, s.cols, s.rows, true)
    val next = mux_replace_window(s, wi, laid)
    return (MuxSession(
        session_id: next.session_id,
        windows: next.windows,
        active_window: wi,
        cols: next.cols,
        rows: next.rows
    ), pane_id)

fn mux_select_pane(s: MuxSession, pane_id: text) -> (MuxSession, bool):
    val loc = mux_locate(s, pane_id)
    val wi = loc.0
    val pi = loc.1
    if wi < 0:
        return (s, false)
    val w = s.windows[wi]
    val selected = MuxWindow(window_id: w.window_id, panes: w.panes, active_pane: pi)
    val laid = mux_relayout_window(selected, s.cols, s.rows, true)
    val next = mux_replace_window(s, wi, laid)
    return (MuxSession(
        session_id: next.session_id,
        windows: next.windows,
        active_window: wi,
        cols: next.cols,
        rows: next.rows
    ), true)

fn mux_zoom_pane(s: MuxSession, pane_id: text) -> (MuxSession, bool):
    val loc = mux_locate(s, pane_id)
    val wi = loc.0
    val pi = loc.1
    if wi < 0:
        return (s, false)
    val w = s.windows[wi]
    val was_zoomed = w.panes[pi].zoomed
    var panes: [MuxPane] = []
    var i = 0
    while i < w.panes.len():
        val p = w.panes[i]
        var z = false
        if i == pi and was_zoomed == false:
            z = true
        panes.push(MuxPane(
            pane_id: p.pane_id,
            title: p.title,
            pty_handle: p.pty_handle,
            pid: p.pid,
            screen: p.screen,
            active: p.active,
            zoomed: z
        ))
        i = i + 1
    var active = w.active_pane
    if was_zoomed == false:
        active = pi
    val toggled = MuxWindow(window_id: w.window_id, panes: panes, active_pane: active)
    val laid = mux_relayout_window(toggled, s.cols, s.rows, true)
    return (mux_replace_window(s, wi, laid), true)

fn mux_kill_pane(s: MuxSession, pane_id: text) -> (MuxSession, bool):
    val loc = mux_locate(s, pane_id)
    val wi = loc.0
    val pi = loc.1
    if wi < 0:
        return (s, false)
    val w = s.windows[wi]
    var panes: [MuxPane] = []
    var i = 0
    while i < w.panes.len():
        if i != pi:
            panes.push(w.panes[i])
        i = i + 1
    # Keep the active index valid: it can never dangle past the shrunken list,
    # and it is -1 exactly when no pane remains.
    var active = w.active_pane
    if panes.len() == 0:
        active = -1
    else:
        if active > pi:
            active = active - 1
        if active >= panes.len():
            active = panes.len() - 1
        if active < 0:
            active = 0
    val shrunk = MuxWindow(window_id: w.window_id, panes: panes, active_pane: active)
    val laid = mux_relayout_window(shrunk, s.cols, s.rows, true)
    return (mux_replace_window(s, wi, laid), true)

fn mux_feed_pane(s: MuxSession, pane_id: text, bytes: text) -> MuxSession:
    val loc = mux_locate(s, pane_id)
    val wi = loc.0
    val pi = loc.1
    if wi < 0:
        return s
    val w = s.windows[wi]
    var panes: [MuxPane] = []
    var i = 0
    while i < w.panes.len():
        val p = w.panes[i]
        var screen = p.screen
        if i == pi:
            screen = term_feed(screen, bytes)
        panes.push(MuxPane(
            pane_id: p.pane_id,
            title: p.title,
            pty_handle: p.pty_handle,
            pid: p.pid,
            screen: screen,
            active: p.active,
            zoomed: p.zoomed
        ))
        i = i + 1
    val fed = MuxWindow(window_id: w.window_id, panes: panes, active_pane: w.active_pane)
    return mux_replace_window(s, wi, fed)

fn mux_resize(s: MuxSession, cols: i64, rows: i64) -> MuxSession:
    var c = cols
    if c < 1:
        c = 1
    var r = rows
    if r < 1:
        r = 1
    var windows: [MuxWindow] = []
    var i = 0
    while i < s.windows.len():
        windows.push(mux_relayout_window(s.windows[i], c, r, true))
        i = i + 1
    return MuxSession(
        session_id: s.session_id,
        windows: windows,
        active_window: s.active_window,
        cols: c,
        rows: r
    )

fn mux_pane_rects(s: MuxSession) -> [text]:
    var out: [text] = []
    if s.windows.len() == 0:
        return out
    var wi = s.active_window
    if wi < 0 or wi >= s.windows.len():
        return out
    val rects = mux_window_rects(s.windows[wi], s.cols, s.rows)
    var i = 0
    while i < rects.len():
        out.push(mux_rect_to_text(rects[i]))
        i = i + 1
    return out

fn mux_find_pane(s: MuxSession, pane_id: text) -> MuxPane?:
    val loc = mux_locate(s, pane_id)
    val wi = loc.0
    val pi = loc.1
    if wi < 0:
        return None
    return Some(s.windows[wi].panes[pi])

# Composite frame of the ACTIVE window: one header row naming each visible pane
# (the active one bracketed with '*'), then the panes' own term_render_text
# sliced into their column bands.
fn mux_render(s: MuxSession) -> text:
    if s.windows.len() == 0:
        return ""
    var wi = s.active_window
    if wi < 0 or wi >= s.windows.len():
        return ""
    val w = s.windows[wi]
    val rects = mux_window_rects(w, s.cols, s.rows)
    if rects.len() == 0:
        return ""

    var header = ""
    var bodies: [[text]] = []
    var widths: [i64] = []
    var height = 0
    var ri = 0
    while ri < rects.len():
        val r = rects[ri]
        val found = mux_find_pane(s, r.pane_id)
        var label = r.pane_id
        var rendered = ""
        if found?:
            val p = found!
            if p.active:
                label = "*" + p.title
            else:
                label = " " + p.title
            rendered = term_render_text(p.screen)
        header = header + mux_pad_to(label, r.cols)
        bodies.push(rendered.split("\n"))
        widths.push(r.cols)
        if r.rows > height:
            height = r.rows
        ri = ri + 1

    var out = header
    var row = 0
    while row < height:
        var line = ""
        var ci = 0
        while ci < bodies.len():
            line = line + mux_pad_to(mux_line_of(bodies[ci], row), widths[ci])
            ci = ci + 1
        out = out + "\n" + line
        row = row + 1
    return out

export MuxPane, MuxWindow, MuxSession
export mux_new, mux_add_pane, mux_select_pane, mux_zoom_pane, mux_kill_pane
export mux_feed_pane, mux_resize, mux_pane_rects, mux_render, mux_find_pane
