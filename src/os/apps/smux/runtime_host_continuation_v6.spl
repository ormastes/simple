# Restriction/correlation data from the canonical caller, never authority.
# query/bound derive the authoritative scope from the supplied actual Domain.
pub struct SmuxHostContextV6:
    service_incarnation: text
    scope_digest: text
    closing: bool
    planning_pending: bool
    geometry_pending: bool
    connection_pending: bool

# The canonical owner retains one read receipt in memory for an exact live attach.
struct SmuxRemotePaneV6:
    operation_id: text
    binding_uid: text
    attach_digest: text
    epoch: i64
    claim_receipt: text
    read_id: i64 = 0
    read_receipt: text = ""
    read_error: text = ""

pub class SmuxHostContinuationV6:
    execution: Option<HostServiceExecutionV4> = nil
    execution_operation_id: text = ""
    execution_request_digest: text = ""
    execution_constraint: Option<ContainerPreStartConstraintV1> = nil
    execution_response: text = ""
    execution_error: text = ""
    execution_exit_code: i64 = 0
    execution_cancelled: bool = false
    controller_inspection: Option<HostControllerInspectionSessionV3> = nil
    auth_publication: Option<HostServiceAuthListenerPublicationV6> = nil
    auth_request_digest: text = ""
    auth_ready_digest: text = ""
    auth_lease_digest: text = ""
    auth_authority_digest: text = ""
    auth_deployment_root: text = ""
    auth_error: text = ""
    auth_completed: bool = false
    # The brokered pane's ONLY record of a V4 agent attach: a lease the agent issued once. Not authority.
    agent_pane_lease: Option<HostAgentPaneLeaseV4> = None
    agent_pane_revoked: bool = false
    agent_pane_operation_id: text = ""
    remote_agent_pane: Option<SmuxRemotePaneV6> = None
    agent_pane_target_intent: text = ""
    agent_pane_target: Option<HostAgentPaneTargetReceiptV6> = None

    pub fn execution_pending_v6() -> bool: self.execution.is_some()
    pub fn inspection_pending_v6() -> bool:
        self.controller_inspection.is_some() and self.controller_inspection.unwrap().pending_v3()
    pub fn publication_pending_v6() -> bool: self.auth_publication.is_some()
    pub fn pending_v6() -> bool:
        self.execution_pending_v6() or self.inspection_pending_v6() or self.publication_pending_v6()

pub struct SmuxHostProgressV6:
    operation_id: text
    pending: bool
    response: text
    exit_code: i64
    error: text

pub struct SmuxHostStateTurnV6:
    domain: HostServiceDomainV3
    state: SmuxHostContinuationV6

pub struct SmuxHostTurnV6:
    domain: HostServiceDomainV3
    state: SmuxHostContinuationV6
    response: text
    error: text

pub struct SmuxHostOperationTurnV6:
    domain: HostServiceDomainV3
    state: SmuxHostContinuationV6
    reply: HostServiceOperationReplyV6

pub struct SmuxHostBoundTurnV6:
    domain: HostServiceDomainV3
    state: SmuxHostContinuationV6
    progress: Option<SmuxHostProgressV6>
    error: text

pub struct SmuxHostPublicationTurnV6:
    domain: HostServiceDomainV3
    state: SmuxHostContinuationV6
    ready_digest: text
    lease_digest: text
    authority_digest: text
    deployment_root: text
    completed: bool
    cleanup_pending: bool
    error: text

# Empty state only: no raw restoration DTO, native owner or authority inputs.
pub fn smux_host_continuation_new_v6() -> SmuxHostContinuationV6:
    SmuxHostContinuationV6()

fn constraint_equal_v6(left: Option<ContainerPreStartConstraintV1>,
        right: Option<ContainerPreStartConstraintV1>) -> bool:
    if left.is_none() or right.is_none(): return left.is_none() and right.is_none()
    val a = left.unwrap()
    val b = right.unwrap()
    (a.request_digest == b.request_digest and a.scope_bytes == b.scope_bytes and
        a.provider_generation == b.provider_generation and a.requested_image_ref == b.requested_image_ref and
        a.requested_image_kind == b.requested_image_kind and a.image_config_id == b.image_config_id and
        a.primary_argv == b.primary_argv and a.working_directory == b.working_directory and
        a.configured_user == b.configured_user and a.environment_digest == b.environment_digest and
        a.mounts == b.mounts and a.require_readonly_rootfs == b.require_readonly_rootfs)

fn refused_v6(domain: HostServiceDomainV3, state: SmuxHostContinuationV6, error: text) -> SmuxHostTurnV6:
    SmuxHostTurnV6(domain, state, "", error)

pub fn smux_host_continuation_begin_constrained_v6(domain: HostServiceDomainV3,
        original: SmuxHostContinuationV6, request: HostServiceRequestV2, context: SmuxHostContextV6,
        requested_constraint: Option<ContainerPreStartConstraintV1> = nil) -> SmuxHostTurnV6:
    if original.inspection_pending_v6() and request.action != "host-status":
        return refused_v6(domain, original, "runtime-controller-inspection-pending")
    if requested_constraint.is_some() and request.action != "host-execute":
        return refused_v6(domain, original, "runtime-host-constraint-action")
    val constraint = if requested_constraint.is_some(): Some(container_pre_start_constraint_copy_v1(requested_constraint.unwrap())) else: nil
    if context.closing: return refused_v6(domain, original, "runtime-connection-closing")
    var state = original
    if request.action != "host-status" and context.geometry_pending: return refused_v6(domain, state, "runtime-geometry-pending")
    if request.action == "host-execute":
        val digest = sha256_text(request.operation_id + "\n" + request.payload)
        if state.execution_request_digest == digest:
            if not constraint_equal_v6(state.execution_constraint, constraint):
                return refused_v6(domain, state, "runtime-host-execution-constraint-changed")
            return SmuxHostTurnV6(domain, state, state.execution_response, state.execution_error)
        if state.execution.is_some(): return refused_v6(domain, state, "runtime-host-execution-pending")
        if context.planning_pending: return refused_v6(domain, state, "runtime-connection-inspection-pending")
        if context.connection_pending: return refused_v6(domain, state, "runtime-connection-opening")
        val begun = host_service_execution_begin_constrained_v4(domain, request, constraint)
        val returned_domain = begun.domain
        state.execution = begun.continuation
        state.execution_operation_id = request.operation_id
        state.execution_request_digest = digest
        state.execution_constraint = constraint
        state.execution_response = begun.response ?? ""
        state.execution_error = begun.error
        state.execution_exit_code = begun.exit_code
        state.execution_cancelled = false
        return SmuxHostTurnV6(returned_domain, state, state.execution_response, state.execution_error)
    if (state.execution.is_some() or context.planning_pending) and request.action != "host-status":
        return refused_v6(domain, state, "runtime-host-execution-pending")
    if (request.action == "host-agent-pane-claim" or request.action == "host-agent-pane-read" or
            request.action == "host-agent-pane-resize"):
        if state.remote_agent_pane.is_some():
            return refused_v6(domain, state, "runtime-agent-pane-remote-held")
        return agent_pane_turn_v6(domain, state, request, context, context.service_incarnation)
    val turn = host_service_domain_turn_v3(domain, request)
    state = retain_agent_attach_state_v6(state, request, turn.exit_code)
    SmuxHostTurnV6(turn.owner, state, turn.response,
        if turn.exit_code == 0: "" else: "runtime-host-request-refused")

# One lease record follows accepted attach in both trusted and authenticated
# routes. An exact replay of the same run leaves its held lease untouched.
fn retain_agent_attach_state_v6(original: SmuxHostContinuationV6, request: HostServiceRequestV2,
        exit_code: i64) -> SmuxHostContinuationV6:
    var state = original
    if (request.action == "host-agent-attach" and exit_code == 0 and
            smux_agent_pane_attach_supersedes_v1(state.agent_pane_operation_id, request.operation_id)):
        state.agent_pane_lease = None
        state.agent_pane_revoked = false
        state.agent_pane_operation_id = ""
        state.remote_agent_pane = None
    if (request.action == "host-agent-detach" or request.action == "host-agent-cancel") and exit_code == 0 and
            state.remote_agent_pane.is_some() and state.agent_pane_operation_id == request.operation_id:
        state.remote_agent_pane = None
        state.agent_pane_lease = None
        state.agent_pane_revoked = true
    state

# milestone_0024 PR3c: the pane family. Claim and Read reach the agent only through the domain pass-throughs
# (terminal-authority gated, the service's own clock); the lease record is dropped when the agent refuses it.
fn agent_pane_turn_v6(domain: HostServiceDomainV3, original: SmuxHostContinuationV6,
        request: HostServiceRequestV2, context: SmuxHostContextV6, registry_incarnation: text) -> SmuxHostTurnV6:
    var state = original
    if context.connection_pending: return refused_v6(domain, state, "runtime-connection-opening")
    if not builder_identifier_valid_v1(request.operation_id): return refused_v6(domain, state, "runtime-agent-pane-operation")
    if request.action == "host-agent-pane-resize":
        return refused_v6(domain, state, smux_agent_pane_resize_refusal_v1())
    # The payload names the controller-signed binding uid of the pane the caller means; the owner refuses a mismatch.
    if not builder_identifier_valid_v1(request.payload): return refused_v6(domain, state, "runtime-agent-pane-payload")
    val registry_check = fn(binding: HostAgentPaneBindingV4) -> text:
        pane_registry_check_v6(binding, registry_incarnation)
    if request.action == "host-agent-pane-claim":
        val gate = smux_agent_pane_claim_gate_v1(state.agent_pane_lease, state.agent_pane_revoked)
        if gate != "": return refused_v6(domain, state, gate)
        val issued = host_service_domain_attachment_lease_v3(domain, request.payload, registry_check)
        val claimed = smux_agent_pane_claimed_v1(issued.lease, issued.error)
        state.agent_pane_lease = claimed.lease
        if claimed.lease.is_some(): state.agent_pane_operation_id = claimed.lease.unwrap().operation_id
        return SmuxHostTurnV6(issued.owner, state, claimed.response, claimed.error)
    val read_gate = smux_agent_pane_read_gate_v1(state.agent_pane_lease, state.agent_pane_revoked)
    if read_gate != "": return refused_v6(domain, state, read_gate)
    val io = host_service_domain_pane_io_v3(domain, request.payload, registry_check, state.agent_pane_lease.unwrap(), HostAgentPaneOpV4.Read)
    val read = smux_agent_pane_read_done_v1(state.agent_pane_lease, io.result)
    state.agent_pane_lease = read.lease
    state.agent_pane_revoked = read.revoked
    SmuxHostTurnV6(io.owner, state, read.response, read.error)

# Allocate only vacant smux metadata for the exact executing run. The
# existing signed attach remains the sole path to native terminal authority.
fn remote_pane_target_v6(domain: HostServiceDomainV3, original: SmuxHostContinuationV6,
        request: HostServiceRequestV2, context: SmuxHostContextV6) -> SmuxHostTurnV6:
    var state = original
    val local = match domain.local:
        case HostLocalRootV3.LinuxService(value): value
        case _: return refused_v6(domain, state, "runtime-agent-pane-requires-linux-service")
    val checked = host_linux_service_agent_pane_target_authority_v4(local, request.operation_id, request.payload)
    if checked.is_err(): return refused_v6(domain, state, checked.unwrap_err())
    val authority = checked.unwrap()
    val invoke_digest = sha256_text(request.payload)
    val name = "agent-pane-" + sha256_text(context.service_incarnation + "\n" + authority.service_incarnation +
        "\n" + request.operation_id + "\n" + invoke_digest)
    if state.agent_pane_target_intent != "":
        if state.agent_pane_target_intent != name:
            return refused_v6(domain, state, "runtime-agent-pane-target-conflict")
        if state.agent_pane_target.is_none():
            return refused_v6(domain, state, "runtime-agent-pane-target-unconfirmed")
        val receipt = state.agent_pane_target.unwrap()
        if receipt.service_epoch != authority.service_epoch:
            return refused_v6(domain, state, "runtime-agent-pane-target-fence")
        val current = smux_runtime_target_v3(smux_owner_snapshot(), smux_configuration_revision(),
            smux_window_closing(receipt.session_id, receipt.window_id), authority.service_incarnation,
            receipt.session_id, receipt.window_id, receipt.pane_id)
        if current.is_err() or not current.unwrap().vacant:
            return refused_v6(domain, state, "runtime-agent-pane-target-unavailable")
        return SmuxHostTurnV6(domain, state, host_agent_pane_target_receipt_encode_v6(receipt), "")
    # The legacy helper can reuse a session by name. A new intent must
    # refuse any existing session, since this owner has no allocation record.
    for session in smux_list_sessions():
        if session.name == name:
            return refused_v6(domain, state, "runtime-agent-pane-target-name-collision")
    state.agent_pane_target_intent = name
    val created = smux_runtime_target_create_v3(name, authority.service_incarnation)
    if created.is_err(): return refused_v6(domain, state, "runtime-agent-pane-target-unconfirmed")
    val target = smux_runtime_target_decode_v3(created.unwrap())
    if target.is_err(): return refused_v6(domain, state, "runtime-agent-pane-target-unconfirmed")
    val pane = target.unwrap()
    val receipt = HostAgentPaneTargetReceiptV6(request.operation_id, invoke_digest, authority.service_incarnation,
        authority.service_epoch, pane.session_id, pane.window_id, pane.pane_id)
    state.agent_pane_target = Some(receipt)
    SmuxHostTurnV6(domain, state, host_agent_pane_target_receipt_encode_v6(receipt), "")

fn remote_pane_authority_v6(domain: HostServiceDomainV3, operation_id: text,
        pane: HostAgentPaneStreamRequestV6) -> Result<HostAgentTerminalAuthorityV4, text>:
    val local = match domain.local:
        case HostLocalRootV3.LinuxService(value): value
        case _: return Err("runtime-agent-pane-requires-linux-service")
    val authority = host_linux_service_agent_terminal_authority_v4(local)?
    if authority.operation_id != operation_id: return Err("runtime-agent-pane-operation-mismatch")
    if authority.binding.binding_uid != pane.binding_uid: return Err("attach-binding-mismatch")
    if authority.attach_digest != pane.attach_digest: return Err("runtime-agent-pane-attach-mismatch")
    # The pane binding uses Host continuity. V6 separately authenticates its
    # transport listener incarnation in smux_host_continuation_query_v6.
    val registry_error = pane_registry_check_v6(authority.binding, local.scope_v4().continuity_id)
    if registry_error != "": return Err(registry_error)
    Ok(authority)

fn remote_pane_receipt_v6(operation_id: text, request: HostAgentPaneStreamRequestV6, epoch: i64, payload: text) -> text:
    host_agent_pane_stream_receipt_encode_v6(HostAgentPaneStreamReceiptV6(operation_id, request.binding_uid,
        request.attach_digest, epoch, request.read_id, payload, sha256_text(payload)))

fn remote_pane_turn_v6(domain: HostServiceDomainV3, original: SmuxHostContinuationV6,
        request: HostServiceRequestV2, context: SmuxHostContextV6) -> SmuxHostTurnV6:
    var state = original
    val decoded = host_agent_pane_stream_request_decode_v6(request.payload)
    if decoded.is_err(): return refused_v6(domain, state, decoded.unwrap_err())
    val pane = decoded.unwrap()
    val claiming = request.action == "host-agent-pane-claim"
    val sub = if claiming: "agent-pane-claim" else: "agent-pane-read"
    if not host_agent_pane_stream_request_matches_v6(sub, pane):
        return refused_v6(domain, state, "runtime-agent-pane-cursor")
    val checked = remote_pane_authority_v6(domain, request.operation_id, pane)
    if checked.is_err(): return refused_v6(domain, state, checked.unwrap_err())
    val authority = checked.unwrap()
    val epoch = authority.lease_epoch
    val registry_incarnation = authority.binding.service_incarnation
    val routed = HostServiceRequestV2(request.action, request.operation_id, pane.binding_uid)
    if state.remote_agent_pane.is_none():
        if not claiming: return refused_v6(domain, state, "runtime-agent-pane-not-claimed")
        val turn = agent_pane_turn_v6(domain, state, routed, context, registry_incarnation)
        if turn.error != "": return turn
        state = turn.state
        val receipt = remote_pane_receipt_v6(request.operation_id, pane, epoch, turn.response)
        state.remote_agent_pane = Some(SmuxRemotePaneV6(operation_id: request.operation_id, binding_uid: pane.binding_uid,
            attach_digest: pane.attach_digest, epoch: epoch, claim_receipt: receipt))
        return SmuxHostTurnV6(turn.domain, state, receipt, "")
    var held = state.remote_agent_pane.unwrap()
    if held.operation_id != request.operation_id or held.binding_uid != pane.binding_uid or
            held.attach_digest != pane.attach_digest or held.epoch != epoch:
        return refused_v6(domain, state, "runtime-agent-pane-lease-mismatch")
    val gate = smux_agent_pane_read_gate_v1(state.agent_pane_lease, state.agent_pane_revoked)
    if gate != "": return refused_v6(domain, state, gate)
    val lease = state.agent_pane_lease.unwrap()
    val fingerprint = host_agent_pane_lease_fingerprint_v4(held.operation_id, held.epoch, held.attach_digest)
    if lease.operation_id != held.operation_id or lease.epoch != held.epoch or lease.fingerprint != fingerprint:
        return refused_v6(domain, state, "runtime-agent-pane-lease-mismatch")
    if claiming: return SmuxHostTurnV6(domain, state, held.claim_receipt, "")
    if pane.epoch != held.epoch: return refused_v6(domain, state, "runtime-agent-pane-lease-mismatch")
    if pane.read_id == held.read_id: return SmuxHostTurnV6(domain, state, held.read_receipt, held.read_error)
    if pane.read_id < held.read_id: return refused_v6(domain, state, "runtime-agent-pane-replay-gap")
    if pane.read_id - held.read_id != 1: return refused_v6(domain, state, "runtime-agent-pane-read-out-of-order")
    val turn = agent_pane_turn_v6(domain, state, routed, context, registry_incarnation)
    state = turn.state
    held.read_id = pane.read_id
    held.read_receipt = ""
    held.read_error = turn.error
    # Record the consumed cursor and actual owner before forming a success reply.
    state.remote_agent_pane = Some(held)
    if turn.error != "": return SmuxHostTurnV6(turn.domain, state, "", turn.error)
    held.read_receipt = remote_pane_receipt_v6(request.operation_id, pane, epoch, turn.response)
    state.remote_agent_pane = Some(held)
    SmuxHostTurnV6(turn.domain, state, held.read_receipt, "")

# smux's own registry consistency check on the VERIFIED binding (never authority).
fn pane_registry_check_v6(binding: HostAgentPaneBindingV4, incarnation: text) -> text:
    var ids: [text] = []
    for pane in smux_list_panes(binding.session_id, binding.window_id):
        ids.push(pane.id)
    smux_agent_pane_registry_match_v1(binding, incarnation, ids)

# milestone_0025 PR4: "" when a pane Write may proceed to the owner's control-lease issue: the same gates as Read
# (operation id, no connection opening, no pending execution/inspection/planning, a held, un-revoked pane lease).
pub fn smux_host_continuation_pane_write_gate_v6(state: SmuxHostContinuationV6, context: SmuxHostContextV6,
        operation_id: text) -> text:
    if context.connection_pending: return "runtime-connection-opening"
    if not builder_identifier_valid_v1(operation_id): return "runtime-agent-pane-operation"
    if state.execution.is_some() or context.planning_pending: return "runtime-host-execution-pending"
    smux_agent_pane_read_gate_v1(state.agent_pane_lease, state.agent_pane_revoked)

# The Write itself, after the owner minted `write` (its lease and target) from signed authority. The same registry
# consistency check and brokered pane io as Read; the service re-verifies terminal authority on this very call.
pub fn smux_host_continuation_pane_write_v6(domain: HostServiceDomainV3, original: SmuxHostContinuationV6,
        context: SmuxHostContextV6, binding_uid: text, write: HostAgentPaneWriteV4) -> SmuxHostTurnV6:
    var state = original
    val incarnation = context.service_incarnation
    val registry_check = fn(binding: HostAgentPaneBindingV4) -> text:
        pane_registry_check_v6(binding, incarnation)
    val io = host_service_domain_pane_io_v3(domain, binding_uid, registry_check, state.agent_pane_lease.unwrap(),
        HostAgentPaneOpV4.Write(write))
    val done = smux_agent_pane_write_done_v1(state.agent_pane_lease, io.result)
    state.agent_pane_lease = done.lease
    state.agent_pane_revoked = done.revoked
    SmuxHostTurnV6(io.owner, state, done.response, done.error)

# The agent refused before the io (terminal authority no longer verifies): the same record update as a refused Read.
pub fn smux_host_continuation_pane_write_refused_v6(domain: HostServiceDomainV3, original: SmuxHostContinuationV6,
        error: text) -> SmuxHostTurnV6:
    var state = original
    val done = smux_agent_pane_write_done_v1(state.agent_pane_lease, host_agent_pane_io_refused_v4(error))
    state.agent_pane_lease = done.lease
    state.agent_pane_revoked = done.revoked
    SmuxHostTurnV6(domain, state, "", done.error)

pub fn smux_host_continuation_progress_v6(state: SmuxHostContinuationV6) -> SmuxHostProgressV6:
    SmuxHostProgressV6(state.execution_operation_id, state.execution.is_some(),
        state.execution_response, state.execution_exit_code, state.execution_error)

fn inspection_step_v6(domain: HostServiceDomainV3, original: SmuxHostContinuationV6,
        cancel: bool) -> SmuxHostStateTurnV6:
    var state = original
    if state.controller_inspection.is_none(): return SmuxHostStateTurnV6(domain, state)
    val turn = host_controller_inspection_session_step_v3(domain, state.controller_inspection.unwrap(), cancel)
    val returned_domain = turn.domain
    state.controller_inspection = Some(turn.session)
    SmuxHostStateTurnV6(returned_domain, state)

fn execution_step_v6(domain: HostServiceDomainV3, original: SmuxHostContinuationV6,
        cancel: bool) -> SmuxHostStateTurnV6:
    var state = original
    if val execution = state.execution:
        val turn = host_service_execution_step_v4(domain, execution, cancel or state.execution_cancelled)
        val returned_domain = turn.domain
        state.execution = turn.continuation
        state.execution_error = turn.error
        state.execution_exit_code = turn.exit_code
        if val response = turn.response: state.execution_response = response
        return SmuxHostStateTurnV6(returned_domain, state)
    SmuxHostStateTurnV6(domain, state)

pub fn smux_host_continuation_step_v6(domain: HostServiceDomainV3,
        state: SmuxHostContinuationV6, cancel: bool = false) -> SmuxHostStateTurnV6:
    if state.inspection_pending_v6(): return inspection_step_v6(domain, state, cancel)
    execution_step_v6(domain, state, cancel)

# Exact legacy host-cancel semantics: latch execution cancellation only. It
# never starts inspection/publication cleanup or renews launch authority.
pub fn smux_host_continuation_cancel_execution_v6(domain: HostServiceDomainV3,
        original: SmuxHostContinuationV6) -> SmuxHostStateTurnV6:
    var state = original
    state.execution_cancelled = true
    execution_step_v6(domain, state, true)

fn actual_scope_v6(domain: HostServiceDomainV3) -> Result<text, text>:
    val scope = match domain.local:
        case HostLocalRootV3.Linux(local): local.scope
        case HostLocalRootV3.Windows(local): local.scope_v3()
        case HostLocalRootV3.LinuxService(local): local.scope_v4()
    container_scope_fence_id_v2(scope)

fn operation_reply_v6(domain: HostServiceDomainV3, state: SmuxHostContinuationV6,
        request: HostServiceOperationRequestV6, pending: bool, code: i64,
        payload: text, error: text) -> SmuxHostOperationTurnV6:
    SmuxHostOperationTurnV6(domain, state, HostServiceOperationReplyV6(request.action, request.service_incarnation,
        request.operation_id, request.scope_digest, request.request_digest, pending,
        if error != "" and code == 0: 2 else: code, payload, error))

# milestone_0030 N10: the ONE V6 `remote-build` action. The payload names the sub-operation and carries the route
# frame; the matching Host-domain route action runs through the same gates as every other Host request (nothing may
# run while an execution, planning, geometry or connection step is pending).
fn remote_build_query_v6(domain: HostServiceDomainV3, state: SmuxHostContinuationV6,
        request: HostServiceOperationRequestV6, context: SmuxHostContextV6) -> SmuxHostOperationTurnV6:
    val sub = host_remote_build_sub_decode_v6(request.payload)
    if sub.is_err(): return operation_reply_v6(domain, state, request, false, 2, "", sub.unwrap_err())
    val action = host_remote_build_sub_domain_action_v6(sub.unwrap().sub)
    if action.is_err(): return operation_reply_v6(domain, state, request, false, 2, "", action.unwrap_err())
    if state.inspection_pending_v6(): return operation_reply_v6(domain, state, request, false, 2, "", "runtime-controller-inspection-pending")
    if state.execution.is_some() or context.planning_pending:
        return operation_reply_v6(domain, state, request, false, 2, "", "runtime-host-execution-pending")
    if context.connection_pending: return operation_reply_v6(domain, state, request, false, 2, "", "runtime-connection-opening")
    if context.geometry_pending: return operation_reply_v6(domain, state, request, false, 2, "", "runtime-geometry-pending")
    val turn = host_service_domain_turn_v3(domain, HostServiceRequestV2(action.unwrap(), request.operation_id, sub.unwrap().frame))
    operation_reply_v6(turn.owner, state, request, false, turn.exit_code, turn.response,
        if turn.exit_code == 0: "" else: "runtime-host-request-refused")

# milestone_0046: the ONE V6 `host-control` action (controller-signed Host service actions and their read-only inspects).
# The sub names a closed Host-domain route; it runs through the same pending gates as `remote-build`. Authority is the
# Host owner's verification of the signed frame, never this route.
fn agent_runtime_observation_v6(domain: HostServiceDomainV3, operation_id: text, invoke_source: text) -> Result<text, text>:
    val local = match domain.local:
        case HostLocalRootV3.LinuxService(owner): owner
        case _: return Err("runtime-agent-inspect-requires-linux-service")
    val observed = host_linux_service_agent_runtime_inspect_v4(local, operation_id, invoke_source)?
    host_execution_observation_encode_v2(observed)

fn host_control_query_v6(domain: HostServiceDomainV3, state: SmuxHostContinuationV6,
        request: HostServiceOperationRequestV6, context: SmuxHostContextV6) -> SmuxHostOperationTurnV6:
    val sub = host_control_sub_decode_v6(request.payload)
    if sub.is_err(): return operation_reply_v6(domain, state, request, false, 2, "", sub.unwrap_err())
    val action = host_control_sub_domain_action_v6(sub.unwrap().sub)
    if action.is_err(): return operation_reply_v6(domain, state, request, false, 2, "", action.unwrap_err())
    if state.inspection_pending_v6(): return operation_reply_v6(domain, state, request, false, 2, "", "runtime-controller-inspection-pending")
    if state.execution.is_some() or context.planning_pending:
        return operation_reply_v6(domain, state, request, false, 2, "", "runtime-host-execution-pending")
    if context.connection_pending: return operation_reply_v6(domain, state, request, false, 2, "", "runtime-connection-opening")
    if context.geometry_pending: return operation_reply_v6(domain, state, request, false, 2, "", "runtime-geometry-pending")
    if sub.unwrap().sub == HOST_AGENT_RUNTIME_INSPECT_SUB_V6:
        val result = agent_runtime_observation_v6(domain, request.operation_id, sub.unwrap().frame)
        return match result:
            case Ok(payload): operation_reply_v6(domain, state, request, false, 0, payload, "")
            case Err(code): operation_reply_v6(domain, state, request, false, 2, "", code)
    if HOST_AGENT_PANE_SUBS_V6.contains(sub.unwrap().sub) or sub.unwrap().sub == HOST_AGENT_PANE_TARGET_SUB_V6:
        val routed = HostServiceRequestV2(action.unwrap(), request.operation_id, sub.unwrap().frame)
        val turn = if sub.unwrap().sub == HOST_AGENT_PANE_TARGET_SUB_V6:
            remote_pane_target_v6(domain, state, routed, context)
        else:
            remote_pane_turn_v6(domain, state, routed, context)
        return operation_reply_v6(turn.domain, turn.state, request, false, if turn.error == "": 0 else: 2,
            turn.response, turn.error)
    if HOST_AGENT_CONTROL_SUBS_V6.contains(sub.unwrap().sub):
        match domain.local:
            case HostLocalRootV3.LinuxService(_): ()
            case _: return operation_reply_v6(domain, state, request, false, 2, "", "runtime-agent-control-requires-linux-service")
        val routed = HostServiceRequestV2(action.unwrap(), request.operation_id, sub.unwrap().frame)
        val turn = host_service_domain_turn_v3(domain, routed)
        val retained = retain_agent_attach_state_v6(state, routed, turn.exit_code)
        return operation_reply_v6(turn.owner, retained, request, false, turn.exit_code, turn.response,
            if turn.exit_code == 0: "" else: "runtime-host-request-refused")
    val turn = host_service_domain_turn_v3(domain, HostServiceRequestV2(action.unwrap(), request.operation_id, sub.unwrap().frame))
    operation_reply_v6(turn.owner, state, request, false, turn.exit_code, turn.response,
        if turn.exit_code == 0: "" else: "runtime-host-request-refused")

pub fn smux_host_continuation_query_v6(domain: HostServiceDomainV3,
        original: SmuxHostContinuationV6, request: HostServiceOperationRequestV6,
        context: SmuxHostContextV6) -> SmuxHostOperationTurnV6:
    val valid = host_service_operation_validate_v6(request)
    if valid.is_err(): return operation_reply_v6(domain, original, request, false, 2, "", valid.unwrap_err())
    val origin = host_controller_retained_origin_v3(domain)
    if origin.is_err(): return operation_reply_v6(domain, original, request, false, 2, "", origin.unwrap_err())
    if request.service_incarnation != context.service_incarnation:
        return operation_reply_v6(domain, original, request, false, 2, "", "runtime-host-incarnation-mismatch")
    if context.closing: return operation_reply_v6(domain, original, request, false, 2, "", "runtime-connection-closing")
    if request.action == "service-stop":
        return operation_reply_v6(domain, original, request, false, 2, "", "runtime-host-stop-requires-listener-lifecycle")
    val scope = actual_scope_v6(domain)
    if scope.is_err(): return operation_reply_v6(domain, original, request, false, 2, "", scope.unwrap_err())
    if context.scope_digest != scope.unwrap() or (request.action != "status" and request.scope_digest != scope.unwrap()):
        return operation_reply_v6(domain, original, request, false, 2, "", "runtime-host-scope-mismatch")
    var state = original
    if request.action == "remote-build": return remote_build_query_v6(domain, state, request, context)
    if request.action == "host-control": return host_control_query_v6(domain, state, request, context)
    if request.action == "status":
        val status = host_controller_status_v3(domain)
        if status.is_err(): return operation_reply_v6(domain, state, request, false, 2, "", status.unwrap_err())
        val encoded = host_controller_status_encode_v3(status.unwrap())
        if encoded.is_err(): return operation_reply_v6(domain, state, request, false, 2, "", encoded.unwrap_err())
        return operation_reply_v6(domain, state, request, false, 0, encoded.unwrap(), "")
    if ["validate", "prepare", "execute"].contains(request.action):
        val turn = smux_host_continuation_begin_constrained_v6(domain, state,
            HostServiceRequestV2("host-" + request.action, request.operation_id, request.payload), context)
        state = turn.state
        val exact_execution = (request.action == "execute" and state.execution_operation_id == request.operation_id and
            state.execution_request_digest == request.request_digest)
        return operation_reply_v6(turn.domain, state, request, exact_execution and state.execution.is_some(),
            if exact_execution: state.execution_exit_code else: if turn.error == "": 0 else: 2,
            turn.response, turn.error)
    if state.controller_inspection.is_some():
        val session = state.controller_inspection.unwrap()
        if session.matches_v3(request.operation_id, request.request_digest):
            val stepped = if request.action == "cancel": inspection_step_v6(domain, state, true) else: SmuxHostStateTurnV6(domain, state)
            state = stepped.state
            val current = state.controller_inspection.unwrap()
            return operation_reply_v6(stepped.domain, state, request, current.pending_v3(), current.exit_code_v3(),
                current.response_v3(), current.error_v3())
        if session.pending_v3(): return operation_reply_v6(domain, state, request, false, 2, "", "runtime-controller-inspection-pending")
    if request.action == "inspect":
        if state.execution.is_some() or context.planning_pending or context.geometry_pending:
            return operation_reply_v6(domain, state, request, false, 2, "", "runtime-host-operation-pending")
        if context.connection_pending:
            return operation_reply_v6(domain, state, request, false, 2, "", "runtime-connection-opening")
        val begun = host_controller_inspection_session_begin_v3(domain, request.operation_id, request.request_digest)
        val returned_domain = begun.domain
        state.controller_inspection = Some(begun.session)
        return operation_reply_v6(returned_domain, state, request, begun.session.pending_v3(), begun.session.exit_code_v3(),
            begun.session.response_v3(), begun.session.error_v3())
    val controlled = smux_host_continuation_bound_v6(domain, state, request, context)
    state = controlled.state
    if controlled.progress.is_none(): return operation_reply_v6(controlled.domain, state, request, false, 2, "", controlled.error)
    val progress = controlled.progress.unwrap()
    operation_reply_v6(controlled.domain, state, request, progress.pending, progress.exit_code, progress.response, progress.error)

pub fn smux_host_continuation_bound_v6(domain: HostServiceDomainV3,
        original: SmuxHostContinuationV6, request: HostServiceOperationRequestV6,
        context: SmuxHostContextV6) -> SmuxHostBoundTurnV6:
    val origin = host_controller_retained_origin_v3(domain)
    if origin.is_err(): return SmuxHostBoundTurnV6(domain, original, nil, origin.unwrap_err())
    val scope = actual_scope_v6(domain)
    if scope.is_err(): return SmuxHostBoundTurnV6(domain, original, nil, scope.unwrap_err())
    if context.scope_digest != scope.unwrap(): return SmuxHostBoundTurnV6(domain, original, nil, "runtime-host-scope-mismatch")
    val matched = smux_host_operation_match_v6(request, context.service_incarnation, scope.unwrap(),
        original.execution_operation_id, original.execution_request_digest)
    if matched.is_err(): return SmuxHostBoundTurnV6(domain, original, nil, matched.unwrap_err())
    val turn = if request.action == "cancel": smux_host_continuation_cancel_execution_v6(domain, original) else: SmuxHostStateTurnV6(domain, original)
    SmuxHostBoundTurnV6(turn.domain, turn.state, Some(smux_host_continuation_progress_v6(turn.state)), "")

# Read-only listener lifecycle correlation. The canonical V5 adapter supplies
# its actual all-obligations result; this check neither closes nor grants IO.
pub fn smux_host_continuation_stop_match_v6(domain: HostServiceDomainV3,
        state: SmuxHostContinuationV6, request: HostServiceOperationRequestV6,
        context: SmuxHostContextV6, obligations_pending: bool) -> Result<bool, text>:
    val valid = host_service_operation_validate_v6(request)?
    val origin = host_controller_retained_origin_v3(domain)?
    if request.action != "service-stop" or request.service_incarnation != context.service_incarnation:
        return Err("runtime-host-stop-identity")
    val scope = actual_scope_v6(domain)?
    if context.scope_digest != scope or request.scope_digest != scope:
        return Err("runtime-host-stop-scope")
    if state.pending_v6() or obligations_pending: return Err("runtime-host-stop-obligations-pending")
    Ok(true)

fn publication_result_v6(domain: HostServiceDomainV3, state: SmuxHostContinuationV6) -> SmuxHostPublicationTurnV6:
    SmuxHostPublicationTurnV6(domain, state, state.auth_ready_digest, state.auth_lease_digest,
        state.auth_authority_digest, state.auth_deployment_root, state.auth_completed and state.auth_error == "",
        state.auth_publication.is_some(), state.auth_error)

fn publication_accept_v6(original: SmuxHostContinuationV6,
        turn: HostControllerPublicationTurnV3) -> SmuxHostStateTurnV6:
    val returned_domain = turn.domain
    var state = original
    state.auth_publication = turn.publication
    if turn.ready_digest != "": state.auth_ready_digest = turn.ready_digest
    if turn.lease_digest != "": state.auth_lease_digest = turn.lease_digest
    if turn.authority_digest != "": state.auth_authority_digest = turn.authority_digest
    if state.auth_error == "" and turn.error != "": state.auth_error = turn.error
    state.auth_completed = turn.completed and not turn.cleanup_pending and state.auth_error == ""
    SmuxHostStateTurnV6(returned_domain, state)

pub fn smux_host_continuation_publication_v6(domain: HostServiceDomainV3,
        original: SmuxHostContinuationV6, listener: TcpListener, setup_path: text,
        pin: text, incarnation: text) -> SmuxHostPublicationTurnV6:
    var state = original
    val digest = sha256_text(setup_path + "\n" + pin)
    if state.auth_request_digest != "" and state.auth_request_digest != digest:
        if state.auth_error == "": state.auth_error = "runtime-auth-startup-changed"
        return publication_result_v6(domain, state)
    if state.auth_publication.is_some():
        val turn = host_controller_publication_step_v3(domain, listener, state.auth_publication.unwrap(), state.auth_error != "")
        val accepted = publication_accept_v6(state, turn)
        return publication_result_v6(accepted.domain, accepted.state)
    if state.auth_request_digest != "": return publication_result_v6(domain, state)
    state.auth_request_digest = digest
    val binding = host_controller_journal_binding_v3(domain)
    if binding.is_err():
        state.auth_error = binding.unwrap_err()
        return publication_result_v6(domain, state)
    state.auth_deployment_root = binding.unwrap().deployment_root
    state.auth_lease_digest = binding.unwrap().lease_digest
    state.auth_authority_digest = binding.unwrap().authority_digest
    val begun = host_controller_publication_begin_v3(domain, listener, setup_path, pin, incarnation)
    val accepted = publication_accept_v6(state, begun)
    publication_result_v6(accepted.domain, accepted.state)

# Cleanup deliberately performs no renewed launch-policy check.
pub fn smux_host_continuation_close_publication_v6(domain: HostServiceDomainV3,
        state: SmuxHostContinuationV6) -> SmuxHostStateTurnV6:
    if state.auth_publication.is_none(): return SmuxHostStateTurnV6(domain, state)
    publication_accept_v6(state, host_controller_publication_close_v3(domain, state.auth_publication.unwrap()))

pub fn smux_host_continuation_current_v6(domain: HostServiceDomainV3,
        state: SmuxHostContinuationV6, closing: bool) -> Result<bool, text>:
    val origin = host_controller_retained_origin_v3(domain)?
    if closing or not state.auth_completed or state.auth_error != "": return Err("runtime-auth-not-ready")
    match domain.local:
        case HostLocalRootV3.LinuxService(local):
            # Full service recheck; it also guarantees capacity is present.
            val checked = local.current_v4()?
        case _: pass
    val journal = match domain.local:
        case HostLocalRootV3.Windows(local): local.capacity_v3().journal
        case HostLocalRootV3.Linux(_): return Err("runtime-auth-backend")
        case HostLocalRootV3.LinuxService(local): local.capacity.unwrap().journal
    if journal.lease_digest != state.auth_lease_digest or journal.authority_digest != state.auth_authority_digest:
        return Err("runtime-auth-journal-changed")
    val current = distributed_operation_journal_lookup_v2(journal, "")
    if current.is_ok() or current.unwrap_err() != "OPERATION_NOT_FOUND": return Err("runtime-auth-journal-not-current")
    Ok(true)
