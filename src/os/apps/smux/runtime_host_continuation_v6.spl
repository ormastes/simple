# One opaque Host continuation state. The canonical V5 owner alone retains the
# Domain/journal; every effect returns its actual Domain with this state.
use std.common.contracts.container.pre_start_constraint_v1.{ContainerPreStartConstraintV1, container_pre_start_constraint_copy_v1}
use std.common.contracts.container.execution_v2.container_scope_fence_id_v2
use std.common.contracts.orchestration.host_service_operation_v6.{HostServiceOperationRequestV6, host_service_operation_validate_v6}
use std.common.contracts.orchestration.host_service_operation_reply_v6.HostServiceOperationReplyV6
use std.common.contracts.orchestration.host_controller_status_v3.host_controller_status_encode_v3
use std.nogc_sync_mut.orchestration.host_controller_observation_v3.{host_controller_retained_origin_v3, host_controller_status_v3}
use std.nogc_sync_mut.orchestration.host_controller_inspection_session_v3.*
use std.nogc_sync_mut.orchestration.host_controller_publication_v3.*
use std.nogc_sync_mut.io.host_service_auth_listener_publication_v6.HostServiceAuthListenerPublicationV6
use std.common.task_runner.distributed_operation_journal_v2.distributed_operation_journal_lookup_v2
use std.nogc_sync_mut.orchestration.host_local_root_v3.HostLocalRootV3
use std.nogc_sync_mut.orchestration.host_service_domain_v3.{HostServiceDomainV3, host_service_domain_turn_v3}
use std.nogc_sync_mut.orchestration.host_service_domain_v2.HostServiceRequestV2
use std.nogc_sync_mut.orchestration.host_service_execution_v4.{HostServiceExecutionV4,
    host_service_execution_begin_constrained_v4, host_service_execution_step_v4}
use std.io.tcp.TcpListener
use std.common.crypto.sha256.sha256_text
use os.apps.smux.runtime_host_operation_match_v6.smux_host_operation_match_v6

# Restriction/correlation data from the canonical caller, never authority.
# query/bound derive the authoritative scope from the supplied actual Domain.
pub struct SmuxHostContextV6:
    service_incarnation: text
    scope_digest: text
    closing: bool
    planning_pending: bool
    geometry_pending: bool
    connection_pending: bool

pub class SmuxHostContinuationV6:
    execution: Option<HostServiceExecutionV4> = nil
    execution_operation_id: text = ""
    execution_request_digest: text = ""
    execution_constraint: Option<ContainerPreStartConstraintV1> = nil
    execution_response: text = ""
    execution_error: text = ""
    execution_exit_code: i64 = 0
    execution_cancelled: bool = false
    controller_inspection: Option<HostControllerInspectionSessionV3> = nil
    auth_publication: Option<HostServiceAuthListenerPublicationV6> = nil
    auth_request_digest: text = ""
    auth_ready_digest: text = ""
    auth_lease_digest: text = ""
    auth_authority_digest: text = ""
    auth_deployment_root: text = ""
    auth_error: text = ""
    auth_completed: bool = false

    pub fn execution_pending_v6() -> bool: self.execution.is_some()
    pub fn inspection_pending_v6() -> bool:
        self.controller_inspection.is_some() and self.controller_inspection.unwrap().pending_v3()
    pub fn publication_pending_v6() -> bool: self.auth_publication.is_some()
    pub fn pending_v6() -> bool:
        self.execution_pending_v6() or self.inspection_pending_v6() or self.publication_pending_v6()

pub struct SmuxHostProgressV6:
    operation_id: text
    pending: bool
    response: text
    exit_code: i64
    error: text

pub struct SmuxHostStateTurnV6:
    domain: HostServiceDomainV3
    state: SmuxHostContinuationV6

pub struct SmuxHostTurnV6:
    domain: HostServiceDomainV3
    state: SmuxHostContinuationV6
    response: text
    error: text

pub struct SmuxHostOperationTurnV6:
    domain: HostServiceDomainV3
    state: SmuxHostContinuationV6
    reply: HostServiceOperationReplyV6

pub struct SmuxHostBoundTurnV6:
    domain: HostServiceDomainV3
    state: SmuxHostContinuationV6
    progress: Option<SmuxHostProgressV6>
    error: text

pub struct SmuxHostPublicationTurnV6:
    domain: HostServiceDomainV3
    state: SmuxHostContinuationV6
    ready_digest: text
    lease_digest: text
    authority_digest: text
    deployment_root: text
    completed: bool
    cleanup_pending: bool
    error: text

# Empty state only: no raw restoration DTO, native owner or authority inputs.
pub fn smux_host_continuation_new_v6() -> SmuxHostContinuationV6:
    SmuxHostContinuationV6()

fn constraint_equal_v6(left: Option<ContainerPreStartConstraintV1>,
        right: Option<ContainerPreStartConstraintV1>) -> bool:
    if left.is_none() or right.is_none(): return left.is_none() and right.is_none()
    val a = left.unwrap()
    val b = right.unwrap()
    (a.request_digest == b.request_digest and a.scope_bytes == b.scope_bytes and
        a.provider_generation == b.provider_generation and a.requested_image_ref == b.requested_image_ref and
        a.requested_image_kind == b.requested_image_kind and a.image_config_id == b.image_config_id and
        a.primary_argv == b.primary_argv and a.working_directory == b.working_directory and
        a.configured_user == b.configured_user and a.environment_digest == b.environment_digest and
        a.mounts == b.mounts and a.require_readonly_rootfs == b.require_readonly_rootfs)

fn refused_v6(domain: HostServiceDomainV3, state: SmuxHostContinuationV6, error: text) -> SmuxHostTurnV6:
    SmuxHostTurnV6(domain, state, "", error)

pub fn smux_host_continuation_begin_constrained_v6(domain: HostServiceDomainV3,
        original: SmuxHostContinuationV6, request: HostServiceRequestV2, context: SmuxHostContextV6,
        requested_constraint: Option<ContainerPreStartConstraintV1> = nil) -> SmuxHostTurnV6:
    if original.inspection_pending_v6() and request.action != "host-status":
        return refused_v6(domain, original, "runtime-controller-inspection-pending")
    if requested_constraint.is_some() and request.action != "host-execute":
        return refused_v6(domain, original, "runtime-host-constraint-action")
    val constraint = if requested_constraint.is_some(): Some(container_pre_start_constraint_copy_v1(requested_constraint.unwrap())) else: nil
    if context.closing: return refused_v6(domain, original, "runtime-connection-closing")
    var state = original
    if request.action != "host-status" and context.geometry_pending: return refused_v6(domain, state, "runtime-geometry-pending")
    if request.action == "host-execute":
        val digest = sha256_text(request.operation_id + "\n" + request.payload)
        if state.execution_request_digest == digest:
            if not constraint_equal_v6(state.execution_constraint, constraint):
                return refused_v6(domain, state, "runtime-host-execution-constraint-changed")
            return SmuxHostTurnV6(domain, state, state.execution_response, state.execution_error)
        if state.execution.is_some(): return refused_v6(domain, state, "runtime-host-execution-pending")
        if context.planning_pending: return refused_v6(domain, state, "runtime-connection-inspection-pending")
        if context.connection_pending: return refused_v6(domain, state, "runtime-connection-opening")
        val begun = host_service_execution_begin_constrained_v4(domain, request, constraint)
        val returned_domain = begun.domain
        state.execution = begun.continuation
        state.execution_operation_id = request.operation_id
        state.execution_request_digest = digest
        state.execution_constraint = constraint
        state.execution_response = begun.response ?? ""
        state.execution_error = begun.error
        state.execution_exit_code = begun.exit_code
        state.execution_cancelled = false
        return SmuxHostTurnV6(returned_domain, state, state.execution_response, state.execution_error)
    if (state.execution.is_some() or context.planning_pending) and request.action != "host-status":
        return refused_v6(domain, state, "runtime-host-execution-pending")
    val turn = host_service_domain_turn_v3(domain, request)
    SmuxHostTurnV6(turn.owner, state, turn.response,
        if turn.exit_code == 0: "" else: "runtime-host-request-refused")

pub fn smux_host_continuation_progress_v6(state: SmuxHostContinuationV6) -> SmuxHostProgressV6:
    SmuxHostProgressV6(state.execution_operation_id, state.execution.is_some(),
        state.execution_response, state.execution_exit_code, state.execution_error)

fn inspection_step_v6(domain: HostServiceDomainV3, original: SmuxHostContinuationV6,
        cancel: bool) -> SmuxHostStateTurnV6:
    var state = original
    if state.controller_inspection.is_none(): return SmuxHostStateTurnV6(domain, state)
    val turn = host_controller_inspection_session_step_v3(domain, state.controller_inspection.unwrap(), cancel)
    val returned_domain = turn.domain
    state.controller_inspection = Some(turn.session)
    SmuxHostStateTurnV6(returned_domain, state)

fn execution_step_v6(domain: HostServiceDomainV3, original: SmuxHostContinuationV6,
        cancel: bool) -> SmuxHostStateTurnV6:
    var state = original
    if val execution = state.execution:
        val turn = host_service_execution_step_v4(domain, execution, cancel or state.execution_cancelled)
        val returned_domain = turn.domain
        state.execution = turn.continuation
        state.execution_error = turn.error
        state.execution_exit_code = turn.exit_code
        if val response = turn.response: state.execution_response = response
        return SmuxHostStateTurnV6(returned_domain, state)
    SmuxHostStateTurnV6(domain, state)

pub fn smux_host_continuation_step_v6(domain: HostServiceDomainV3,
        state: SmuxHostContinuationV6, cancel: bool = false) -> SmuxHostStateTurnV6:
    if state.inspection_pending_v6(): return inspection_step_v6(domain, state, cancel)
    execution_step_v6(domain, state, cancel)

# Exact legacy host-cancel semantics: latch execution cancellation only. It
# never starts inspection/publication cleanup or renews launch authority.
pub fn smux_host_continuation_cancel_execution_v6(domain: HostServiceDomainV3,
        original: SmuxHostContinuationV6) -> SmuxHostStateTurnV6:
    var state = original
    state.execution_cancelled = true
    execution_step_v6(domain, state, true)

fn actual_scope_v6(domain: HostServiceDomainV3) -> Result<text, text>:
    val scope = match domain.local:
        case HostLocalRootV3.Linux(local): local.scope
        case HostLocalRootV3.Windows(local): local.scope_v3()
        case HostLocalRootV3.LinuxService(local): local.scope_v4()
    container_scope_fence_id_v2(scope)

fn operation_reply_v6(domain: HostServiceDomainV3, state: SmuxHostContinuationV6,
        request: HostServiceOperationRequestV6, pending: bool, code: i64,
        payload: text, error: text) -> SmuxHostOperationTurnV6:
    SmuxHostOperationTurnV6(domain, state, HostServiceOperationReplyV6(request.action, request.service_incarnation,
        request.operation_id, request.scope_digest, request.request_digest, pending,
        if error != "" and code == 0: 2 else: code, payload, error))

pub fn smux_host_continuation_query_v6(domain: HostServiceDomainV3,
        original: SmuxHostContinuationV6, request: HostServiceOperationRequestV6,
        context: SmuxHostContextV6) -> SmuxHostOperationTurnV6:
    val valid = host_service_operation_validate_v6(request)
    if valid.is_err(): return operation_reply_v6(domain, original, request, false, 2, "", valid.unwrap_err())
    val origin = host_controller_retained_origin_v3(domain)
    if origin.is_err(): return operation_reply_v6(domain, original, request, false, 2, "", origin.unwrap_err())
    if request.service_incarnation != context.service_incarnation:
        return operation_reply_v6(domain, original, request, false, 2, "", "runtime-host-incarnation-mismatch")
    if context.closing: return operation_reply_v6(domain, original, request, false, 2, "", "runtime-connection-closing")
    if request.action == "service-stop":
        return operation_reply_v6(domain, original, request, false, 2, "", "runtime-host-stop-requires-listener-lifecycle")
    val scope = actual_scope_v6(domain)
    if scope.is_err(): return operation_reply_v6(domain, original, request, false, 2, "", scope.unwrap_err())
    if context.scope_digest != scope.unwrap() or (request.action != "status" and request.scope_digest != scope.unwrap()):
        return operation_reply_v6(domain, original, request, false, 2, "", "runtime-host-scope-mismatch")
    var state = original
    if request.action == "status":
        val status = host_controller_status_v3(domain)
        if status.is_err(): return operation_reply_v6(domain, state, request, false, 2, "", status.unwrap_err())
        val encoded = host_controller_status_encode_v3(status.unwrap())
        if encoded.is_err(): return operation_reply_v6(domain, state, request, false, 2, "", encoded.unwrap_err())
        return operation_reply_v6(domain, state, request, false, 0, encoded.unwrap(), "")
    if ["validate", "prepare", "execute"].contains(request.action):
        val turn = smux_host_continuation_begin_constrained_v6(domain, state,
            HostServiceRequestV2("host-" + request.action, request.operation_id, request.payload), context)
        state = turn.state
        val exact_execution = (request.action == "execute" and state.execution_operation_id == request.operation_id and
            state.execution_request_digest == request.request_digest)
        return operation_reply_v6(turn.domain, state, request, exact_execution and state.execution.is_some(),
            if exact_execution: state.execution_exit_code else: if turn.error == "": 0 else: 2,
            turn.response, turn.error)
    if state.controller_inspection.is_some():
        val session = state.controller_inspection.unwrap()
        if session.matches_v3(request.operation_id, request.request_digest):
            val stepped = if request.action == "cancel": inspection_step_v6(domain, state, true) else: SmuxHostStateTurnV6(domain, state)
            state = stepped.state
            val current = state.controller_inspection.unwrap()
            return operation_reply_v6(stepped.domain, state, request, current.pending_v3(), current.exit_code_v3(),
                current.response_v3(), current.error_v3())
        if session.pending_v3(): return operation_reply_v6(domain, state, request, false, 2, "", "runtime-controller-inspection-pending")
    if request.action == "inspect":
        if state.execution.is_some() or context.planning_pending or context.geometry_pending:
            return operation_reply_v6(domain, state, request, false, 2, "", "runtime-host-operation-pending")
        if context.connection_pending:
            return operation_reply_v6(domain, state, request, false, 2, "", "runtime-connection-opening")
        val begun = host_controller_inspection_session_begin_v3(domain, request.operation_id, request.request_digest)
        val returned_domain = begun.domain
        state.controller_inspection = Some(begun.session)
        return operation_reply_v6(returned_domain, state, request, begun.session.pending_v3(), begun.session.exit_code_v3(),
            begun.session.response_v3(), begun.session.error_v3())
    val controlled = smux_host_continuation_bound_v6(domain, state, request, context)
    state = controlled.state
    if controlled.progress.is_none(): return operation_reply_v6(controlled.domain, state, request, false, 2, "", controlled.error)
    val progress = controlled.progress.unwrap()
    operation_reply_v6(controlled.domain, state, request, progress.pending, progress.exit_code, progress.response, progress.error)

pub fn smux_host_continuation_bound_v6(domain: HostServiceDomainV3,
        original: SmuxHostContinuationV6, request: HostServiceOperationRequestV6,
        context: SmuxHostContextV6) -> SmuxHostBoundTurnV6:
    val origin = host_controller_retained_origin_v3(domain)
    if origin.is_err(): return SmuxHostBoundTurnV6(domain, original, nil, origin.unwrap_err())
    val scope = actual_scope_v6(domain)
    if scope.is_err(): return SmuxHostBoundTurnV6(domain, original, nil, scope.unwrap_err())
    if context.scope_digest != scope.unwrap(): return SmuxHostBoundTurnV6(domain, original, nil, "runtime-host-scope-mismatch")
    val matched = smux_host_operation_match_v6(request, context.service_incarnation, scope.unwrap(),
        original.execution_operation_id, original.execution_request_digest)
    if matched.is_err(): return SmuxHostBoundTurnV6(domain, original, nil, matched.unwrap_err())
    val turn = if request.action == "cancel": smux_host_continuation_cancel_execution_v6(domain, original) else: SmuxHostStateTurnV6(domain, original)
    SmuxHostBoundTurnV6(turn.domain, turn.state, Some(smux_host_continuation_progress_v6(turn.state)), "")

# Read-only listener lifecycle correlation. The canonical V5 adapter supplies
# its actual all-obligations result; this check neither closes nor grants IO.
pub fn smux_host_continuation_stop_match_v6(domain: HostServiceDomainV3,
        state: SmuxHostContinuationV6, request: HostServiceOperationRequestV6,
        context: SmuxHostContextV6, obligations_pending: bool) -> Result<bool, text>:
    val valid = host_service_operation_validate_v6(request)?
    val origin = host_controller_retained_origin_v3(domain)?
    if request.action != "service-stop" or request.service_incarnation != context.service_incarnation:
        return Err("runtime-host-stop-identity")
    val scope = actual_scope_v6(domain)?
    if context.scope_digest != scope or request.scope_digest != scope:
        return Err("runtime-host-stop-scope")
    if state.pending_v6() or obligations_pending: return Err("runtime-host-stop-obligations-pending")
    Ok(true)

fn publication_result_v6(domain: HostServiceDomainV3, state: SmuxHostContinuationV6) -> SmuxHostPublicationTurnV6:
    SmuxHostPublicationTurnV6(domain, state, state.auth_ready_digest, state.auth_lease_digest,
        state.auth_authority_digest, state.auth_deployment_root, state.auth_completed and state.auth_error == "",
        state.auth_publication.is_some(), state.auth_error)

fn publication_accept_v6(original: SmuxHostContinuationV6,
        turn: HostControllerPublicationTurnV3) -> SmuxHostStateTurnV6:
    val returned_domain = turn.domain
    var state = original
    state.auth_publication = turn.publication
    if turn.ready_digest != "": state.auth_ready_digest = turn.ready_digest
    if turn.lease_digest != "": state.auth_lease_digest = turn.lease_digest
    if turn.authority_digest != "": state.auth_authority_digest = turn.authority_digest
    if state.auth_error == "" and turn.error != "": state.auth_error = turn.error
    state.auth_completed = turn.completed and not turn.cleanup_pending and state.auth_error == ""
    SmuxHostStateTurnV6(returned_domain, state)

pub fn smux_host_continuation_publication_v6(domain: HostServiceDomainV3,
        original: SmuxHostContinuationV6, listener: TcpListener, setup_path: text,
        pin: text, incarnation: text) -> SmuxHostPublicationTurnV6:
    var state = original
    val digest = sha256_text(setup_path + "\n" + pin)
    if state.auth_request_digest != "" and state.auth_request_digest != digest:
        if state.auth_error == "": state.auth_error = "runtime-auth-startup-changed"
        return publication_result_v6(domain, state)
    if state.auth_publication.is_some():
        val turn = host_controller_publication_step_v3(domain, listener, state.auth_publication.unwrap(), state.auth_error != "")
        val accepted = publication_accept_v6(state, turn)
        return publication_result_v6(accepted.domain, accepted.state)
    if state.auth_request_digest != "": return publication_result_v6(domain, state)
    state.auth_request_digest = digest
    val binding = host_controller_journal_binding_v3(domain)
    if binding.is_err():
        state.auth_error = binding.unwrap_err()
        return publication_result_v6(domain, state)
    state.auth_deployment_root = binding.unwrap().deployment_root
    state.auth_lease_digest = binding.unwrap().lease_digest
    state.auth_authority_digest = binding.unwrap().authority_digest
    val begun = host_controller_publication_begin_v3(domain, listener, setup_path, pin, incarnation)
    val accepted = publication_accept_v6(state, begun)
    publication_result_v6(accepted.domain, accepted.state)

# Cleanup deliberately performs no renewed launch-policy check.
pub fn smux_host_continuation_close_publication_v6(domain: HostServiceDomainV3,
        state: SmuxHostContinuationV6) -> SmuxHostStateTurnV6:
    if state.auth_publication.is_none(): return SmuxHostStateTurnV6(domain, state)
    publication_accept_v6(state, host_controller_publication_close_v3(domain, state.auth_publication.unwrap()))

pub fn smux_host_continuation_current_v6(domain: HostServiceDomainV3,
        state: SmuxHostContinuationV6, closing: bool) -> Result<bool, text>:
    val origin = host_controller_retained_origin_v3(domain)?
    if closing or not state.auth_completed or state.auth_error != "": return Err("runtime-auth-not-ready")
    match domain.local:
        case HostLocalRootV3.LinuxService(local):
            # Full service recheck; it also guarantees capacity is present.
            val checked = local.current_v4()?
        case _: pass
    val journal = match domain.local:
        case HostLocalRootV3.Windows(local): local.capacity_v3().journal
        case HostLocalRootV3.Linux(_): return Err("runtime-auth-backend")
        case HostLocalRootV3.LinuxService(local): local.capacity.unwrap().journal
    if journal.lease_digest != state.auth_lease_digest or journal.authority_digest != state.auth_authority_digest:
        return Err("runtime-auth-journal-changed")
    val current = distributed_operation_journal_lookup_v2(journal, "")
    if current.is_ok() or current.unwrap_err() != "OPERATION_NOT_FOUND": return Err("runtime-auth-journal-not-current")
    Ok(true)
