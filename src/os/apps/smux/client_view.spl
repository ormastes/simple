# Pure client wire helpers. View selection belongs to this terminal process;
# frames and input always carry explicit window/pane ids.
use std.common.string_core.{text_to_bytes}
use os.apps.smux.vt_screen.{vt_cell_width}

pub fn client_input_hex(data: text) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    for byte in text_to_bytes(data):
        val value = byte as i64
        out = out + digits[value / 16:value / 16 + 1] + digits[value % 16:value % 16 + 1]
    return out

pub fn client_reply_ids(reply: text, header: text) -> Result<[text], text>:
    if not reply.starts_with(header):
        return Err(reply)
    var ids: [text] = []
    val lines = reply.split("\n")
    var i = 1
    while i < lines.len():
        val fields = lines[i].split(" ")
        if fields.len() > 0 and fields[0] != "":
            val id = fields[0]
            if not id.starts_with("id") or id.len() <= 2:
                return Err("invalid resource list")
            for ch in id[2:].chars():
                if ch < "0" or ch > "9":
                    return Err("invalid resource id")
            if ids.contains(id):
                return Err("duplicate resource id")
            ids.push(id)
            if ids.len() > 8:
                return Err("resource list exceeds capacity")
        i = i + 1
    return Ok(ids)

pub fn client_frame_body(reply: text, max_cols: i64 = 512, max_rows: i64 = 256) -> Result<text, text>:
    val lines = reply.split("\n")
    if lines.len() < 2:
        return Err("missing terminal frame")
    val fields = lines[0].split(" ")
    if fields.len() != 3 or fields[0] != "SMUX-FRAME/1":
        return Err("invalid terminal frame")
    val cols = fields[1].to_int() ?? 0
    val rows = fields[2].to_int() ?? 0
    if cols <= 0 or rows <= 0 or cols > 512 or rows > 256 or cols * rows > 60000 or cols > max_cols or rows > max_rows:
        return Err("invalid terminal frame dimensions")
    return Ok(lines[1:].join("\n"))

pub fn client_next_id(ids: [text], current: text) -> text:
    if ids.len() == 0:
        return ""
    var i = 0
    while i < ids.len():
        if ids[i] == current:
            return ids[(i + 1) % ids.len()]
        i = i + 1
    return ids[0]

pub fn client_clip_line(line: text, cols: i64) -> text:
    var result = ""
    var width: i64 = 0
    for scalar in line.chars():
        if scalar >= " " and not (scalar >= "\u{7f}" and scalar <= "\u{9f}"):
            val cells = vt_cell_width(scalar)
            if cells > 0 and width + cells > cols:
                break
            if cells > 0 or width > 0:
                result = result + scalar
                width = width + cells
    return result

pub fn client_copy_frame(lines: [text], offset: i64, rows: i64, cols: i64 = 512, mark: i64 = -1) -> text:
    var end = lines.len() - offset
    if end < 0:
        end = 0
    var start = end - rows
    if start < 0:
        start = 0
    # Clip old wider history rows by terminal cells after a console resize.
    # A selected line range is visible and clipboard serialization stays plain.
    var output: [text] = []
    var i = start
    while i < end:
        var line = client_clip_line(lines[i], cols)
        if mark >= 0 and ((i >= mark and i < end) or (i <= mark and i == end - 1)):
            line = "\x1b[7m" + line + "\x1b[0m"
        output.push(line)
        i = i + 1
    return "\x1b[?25l\x1b[H\x1b[2J" + output.join("\r\n")
