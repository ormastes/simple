struct ConnectionEntryV5:
    request: SmuxRuntimePrimaryRequestV4
    plan: ContainerPrimaryConnectionPlanV2
    target: SessionRuntimeControlTargetV1
    prepared: HostPreparedReservationReceiptV1? = nil
    helper: HostHelperLeaseV1? = nil
    task: HostPrimaryConnectionTaskV3? = nil
    retained: ContainerOwnedTerminalSessionV2? = nil
    session_identity: text = ""
    adopted: bool = false
    error: text = ""
    recovery_required: bool = false
    input_request: ContainerPrimaryInputRequestV2? = nil
    input_digest: text = ""
    input_receipt: ContainerPrimaryInputWriteV2? = nil
    settled: bool = false
    release_requested: bool = false
    prepare_deadline_ms: i64 = 0
    prepare_request_digest: text = ""
    geometry: SmuxConnectionGeometryV5? = nil

pub class SmuxRuntimeConnectionOwnerV5:
    domain: HostServiceDomainV3
    service_incarnation: text
    controls: SmuxRuntimeControlOwnerV1
    entries: [ConnectionEntryV5]
    host: SmuxHostContinuationV6
    closing: bool = false
    control_sync_error: text = ""
    cursor: int = 0
    planning: HostPrimaryConnectionPlanningV4? = nil
    planning_request: SmuxRuntimePrimaryRequestV4? = nil
    planning_digest: text = ""
    planning_client: text = ""
    planning_token: text = ""
    planning_error: text = ""
    planning_cancelled: bool = false

pub struct SmuxRuntimeConnectionOpenV5:
    owner: SmuxRuntimeConnectionOwnerV5?
    retained: HostServiceDomainV3?
    error: text

pub struct SmuxRuntimeConnectionTurnV5:
    owner: SmuxRuntimeConnectionOwnerV5
    plan: ContainerPrimaryConnectionPlanV2?
    prepared: HostPreparedReservationReceiptV1?
    response: text
    error: text

pub struct SmuxRuntimeConnectionInputTurnV5:
    owner: SmuxRuntimeConnectionOwnerV5
    revision: i64
    nonce: text
    receipt: ContainerPrimaryInputWriteV2?
    error: text

pub struct SmuxRuntimeConnectionCloseV5:
    owner: SmuxRuntimeConnectionOwnerV5?
    cleanup: HostServiceCleanupV3?
    closed: bool
    error: text

pub fn smux_runtime_connection_stop_allowed_v5(owner: SmuxRuntimeConnectionOwnerV5) -> bool:
    if owner.host.publication_pending_v6(): return false
    if owner.host.inspection_pending_v6(): return false
    if owner.host.execution_pending_v6() or owner.planning.is_some() or owner.control_sync_error != "": return false
    for entry in owner.entries:
        if entry.geometry.is_some() and entry.geometry.unwrap().pending_v5(): return false
        if not entry.settled and (entry.prepared.is_some() or entry.helper.is_some() or entry.task.is_some() or entry.retained.is_some() or entry.recovery_required): return false
    true

pub fn smux_runtime_connection_close_v5(owner: SmuxRuntimeConnectionOwnerV5) -> SmuxRuntimeConnectionCloseV5:
    if not smux_runtime_connection_stop_allowed_v5(owner):
        return SmuxRuntimeConnectionCloseV5(Some(owner), nil, false, "runtime-connection-release-pending")
    val closed = host_service_domain_close_v3(owner.domain)
    SmuxRuntimeConnectionCloseV5(nil, closed.cleanup, closed.closed, closed.error)

pub fn smux_runtime_connection_release_v5(original: SmuxRuntimeConnectionOwnerV5,
        uid: text) -> SmuxRuntimeConnectionTurnV5:
    if original.host.inspection_pending_v6(): return reply_v5(original, "runtime-controller-inspection-pending")
    if original.host.execution_pending_v6() or original.planning.is_some() or original.host.inspection_pending_v6(): return reply_v5(original, "runtime-host-execution-pending")
    val index = index_v5(original, uid)
    if index < 0: return reply_v5(original, "runtime-connection-binding-unavailable")
    var owner = original
    var entry = owner.entries[index]
    if entry.settled: return reply_v5(owner, "")
    entry.release_requested = true
    owner.entries[index] = entry
    if entry.geometry.is_some() and entry.geometry.unwrap().pending_v5():
        owner = geometry_step_v5(owner, index, true)
        entry = owner.entries[index]
        if entry.geometry.is_some() and entry.geometry.unwrap().pending_v5(): return reply_v5(owner, "runtime-geometry-cleanup-pending")
    if entry.task.is_none() and entry.helper.is_some():
        entry.task = Some(host_primary_connection_cleanup_task_v3(entry.plan, entry.helper.unwrap()))
        owner.entries[index] = entry
    if entry.task.is_none():
        if entry.prepared.is_none(): return reply_v5(owner, "runtime-connection-preparation-required")
        val expired = host_primary_connection_expire_prepared_v3(owner.domain.local, entry.plan.identity.operation_id)
        owner.domain = HostServiceDomainV3(expired.local)
        entry.settled = expired.released
        entry.error = expired.error
        entry.recovery_required = expired.error != "" and expired.error != "prepare-not-expired"
        owner.entries[index] = entry
        return reply_v5(owner, expired.error)
    if entry.task.unwrap().pending_v3() or entry.task.unwrap().has_session_v3():
        val cancelled = host_primary_connection_progress_v3(owner.domain.local, entry.task.unwrap(), true)
        owner.domain = HostServiceDomainV3(cancelled.local)
        entry.task = cancelled.task
        entry.error = cancelled.error
        owner.entries[index] = entry
        if entry.task.is_none() or entry.task.unwrap().pending_v3(): return reply_v5(owner, "runtime-connection-cleanup-pending")
        if entry.task.unwrap().has_session_v3():
            val transferred = host_primary_connection_cleanup_transfer_v3(entry.task.unwrap())
            entry.task = Some(transferred.task)
            entry.retained = transferred.session
            owner.entries[index] = entry
            if transferred.error != "": return reply_v5(owner, transferred.error)
    var session: ContainerOwnedTerminalSessionV2? = entry.retained
    if entry.adopted:
        val borrowed = pane_session_v5(entry)
        if borrowed.is_err(): return reply_v5(owner, borrowed.unwrap_err())
        val revoked = container_primary_input_revoke_v2(borrowed.unwrap())
        if revoked.is_err(): return reply_v5(owner, revoked.unwrap_err())
        val cleaned = smux_pane_cleanup_primary_v5(entry.target.pane_id, entry.session_identity)
        if cleaned.is_err(): return reply_v5(owner, cleaned.unwrap_err())
        if not cleaned.unwrap(): return reply_v5(owner, "runtime-connection-cleanup-pending")
        val updated = pane_session_v5(entry)
        if updated.is_err(): return reply_v5(owner, updated.unwrap_err())
        session = Some(updated.unwrap())
    elif session != nil:
        val cleaned = container_terminal_cleanup_v2(session.unwrap())
        entry.retained = Some(cleaned.session)
        owner.entries[index] = entry
        if cleaned.error != "": return reply_v5(owner, cleaned.error)
        if not cleaned.cleaned: return reply_v5(owner, "runtime-connection-cleanup-pending")
        session = Some(cleaned.session)
    if session == nil:
        val abandoned = host_primary_connection_attempt_release_v3(owner.domain.local, entry.task.unwrap())
        owner.domain = HostServiceDomainV3(abandoned.local)
        entry.task = Some(abandoned.task)
        entry.error = abandoned.error
        entry.settled = abandoned.settled
        if abandoned.settled: entry.recovery_required = false
        owner.entries[index] = entry
        return reply_v5(owner, abandoned.error)
    val released = host_primary_connection_release_v3(owner.domain.local, entry.task.unwrap(), session.unwrap())
    owner.domain = HostServiceDomainV3(released.local)
    entry.task = Some(released.task)
    if not entry.adopted: entry.retained = Some(released.session)
    entry.error = released.error
    owner.entries[index] = entry
    if released.error != "" or released.ack == nil: return reply_v5(owner, released.error)
    if entry.adopted:
        val published = smux_pane_primary_settlement_v5(entry.target.pane_id, entry.session_identity, released.ack.unwrap())
        if published.is_err(): return reply_v5(owner, published.unwrap_err())
    entry.adopted = false
    entry.retained = nil
    entry.settled = true
    owner.entries[index] = entry
    reply_v5(owner, "")

struct ConnectionResolvedV5:
    session: ContainerOwnedTerminalSessionV2
    target: SessionRuntimeControlTargetV1
    attachment: ClientLease

fn pane_session_v5(entry: ConnectionEntryV5) -> Result<ContainerOwnedTerminalSessionV2, text>:
    val snapshot = smux_owner_snapshot()
    val index = snapshot.find_pane_idx(entry.request.target.pane_id)
    if index < 0: return Err("runtime-connection-pane-missing")
    val pane = snapshot.get_pane(index)
    if pane.owned_terminal_session.is_none(): return Err("runtime-connection-pane-owner-missing")
    val session = pane.owned_terminal_session.unwrap()
    val view = container_primary_terminal_view_v2(session)?
    if view.fingerprint != entry.session_identity or view.adoption.is_none():
        return Err("runtime-connection-pane-owner-changed")
    val adoption = view.adoption.unwrap()
    if (adoption.binding_uid != entry.target.binding_uid or adoption.service_incarnation != entry.target.service_incarnation or
            adoption.session_id != entry.target.session_id or adoption.window_id != entry.target.window_id or
            adoption.pane_id != entry.target.pane_id or adoption.service_epoch != entry.target.service_epoch or
            adoption.child_incarnation != entry.target.child_incarnation or pane.child_incarnation != entry.target.child_incarnation as u64):
        return Err("runtime-connection-pane-adoption-changed")
    Ok(session)

fn resolve_v5(owner: SmuxRuntimeConnectionOwnerV5, index: int,
        client_id: text, token: text) -> Result<ConnectionResolvedV5, text>:
    val entry = owner.entries[index]
    if not entry.adopted or entry.task.is_none() or entry.retained.is_some() or owner.closing:
        return Err("runtime-connection-not-adopted")
    host_primary_connection_control_live_v3(owner.domain.local, entry.task.unwrap())?
    val policy = smux_runtime_connection_policy_load_v5(owner.domain.local)?
    if (policy.principal_id != owner.controls.policy.principal_id or policy.allowed != owner.controls.policy.allowed or
            policy.max_lease_ms != owner.controls.policy.max_lease_ms): return Err("runtime-connection-control-policy-changed")
    val session = pane_session_v5(entry)?
    val snapshot = smux_owner_snapshot()
    val pane = snapshot.get_pane(snapshot.find_pane_idx(entry.target.pane_id))
    if pane.helper_cleaned_awaiting_release or pane.terminal_eof or pane.terminal_read_error != "":
        return Err("runtime-connection-stream-unavailable")
    val attachment = smux_client_lease_snapshot(entry.target.session_id, client_id, token)?
    val current = smux_runtime_target_v3(smux_owner_snapshot(), smux_configuration_revision(),
        smux_window_closing(entry.target.session_id, entry.target.window_id), owner.service_incarnation,
        entry.target.session_id, entry.target.window_id, entry.target.pane_id)?
    if current.epoch != entry.target.service_epoch as u64 or current.child_incarnation != entry.target.child_incarnation as u64:
        return Err("runtime-connection-target-changed")
    var target = entry.target
    target.client_id = attachment.client_id
    target.attachment_generation = attachment.generation
    session_runtime_control_target_binding_match_v1(entry.target, target)?
    Ok(ConnectionResolvedV5(session, target, attachment))

fn input_reply_v5(owner: SmuxRuntimeConnectionOwnerV5, index: int,
        revision: i64, nonce: text, error: text) -> SmuxRuntimeConnectionInputTurnV5:
    val receipt = if index < 0: nil else: owner.entries[index].input_receipt
    SmuxRuntimeConnectionInputTurnV5(owner, revision, nonce, receipt, error)

fn input_refresh_v5(original: SmuxRuntimeConnectionOwnerV5, index: int) -> SmuxRuntimeConnectionOwnerV5:
    var owner = original
    var entry = owner.entries[index]
    if entry.input_request.is_none(): return owner
    val session = pane_session_v5(entry)
    if session.is_err(): return owner
    val observed = container_primary_input_observe_v2(session.unwrap(), entry.input_request.unwrap())
    if observed.is_ok() and observed.unwrap().is_some():
        entry.input_receipt = observed.unwrap()
        owner.entries[index] = entry
    # An error or absent history never clears the reserved uncertainty.
    owner

pub fn smux_runtime_connection_input_issue_v5(original: SmuxRuntimeConnectionOwnerV5,
        uid: text, client_id: text, token: text, expected_revision: i64,
        expected_target_digest: text) -> SmuxRuntimeConnectionInputTurnV5:
    val index = index_v5(original, uid)
    if index < 0: return input_reply_v5(original, index, 0, "", "runtime-connection-binding-unavailable")
    var owner = input_refresh_v5(original, index)
    val resolved = resolve_v5(owner, index, client_id, token)
    if resolved.is_err(): return input_reply_v5(owner, index, 0, "", resolved.unwrap_err())
    val target_digest = session_runtime_control_target_digest_v1(resolved.unwrap().target)
    if target_digest.is_err() or target_digest.unwrap() != expected_target_digest:
        return input_reply_v5(owner, index, 0, "", "runtime-connection-target-digest")
    val gate = container_primary_input_gate_v2(resolved.unwrap().session)
    if gate.is_err(): return input_reply_v5(owner, index, 0, "", gate.unwrap_err())
    if gate.unwrap().pending or gate.unwrap().unknown:
        return input_reply_v5(owner, index, 0, "", "runtime-connection-input-unresolved")
    if val receipt = owner.entries[index].input_receipt:
        if receipt.disposition == ContainerPrimaryInputDispositionV2.Unknown or receipt.disposition == ContainerPrimaryInputDispositionV2.Queued:
            return input_reply_v5(owner, index, 0, "", "runtime-connection-input-unresolved")
    val fresh = sosix_random_hex(32)
    if fresh == nil: return input_reply_v5(owner, index, 0, "", "runtime-connection-entropy-unavailable")
    val issued = smux_runtime_control_issue_v1(owner.controls, resolved.unwrap().target, SessionRuntimeControlKindV1.Input,
        token, resolved.unwrap().attachment.deadline_ms, expected_revision, fresh.unwrap(), sosix_time_now_monotonic_ms())
    owner.controls = issued.owner
    if issued.error != "" or issued.lease.is_none(): return input_reply_v5(owner, index, issued.revision, "", issued.error)
    if (gate.unwrap().active and gate.unwrap().revision == issued.lease.unwrap().revision and
            gate.unwrap().target_digest == target_digest.unwrap() and gate.unwrap().nonce_digest == issued.lease.unwrap().nonce_digest and
            gate.unwrap().expires_monotonic_ns == issued.lease.unwrap().expires_monotonic_ms * 1000000):
        return input_reply_v5(owner, index, issued.revision, issued.nonce, "")
    val installed = container_primary_input_install_v2(resolved.unwrap().session, issued.lease.unwrap(),
        resolved.unwrap().target, owner.controls.policy.principal_id, issued.nonce)
    if installed.is_err(): return input_reply_v5(owner, index, issued.revision, issued.nonce, installed.unwrap_err())
    val actual = installed.unwrap()
    if (not actual.controlled or not actual.active or actual.pending or actual.unknown or
            actual.revision != issued.lease.unwrap().revision or actual.target_digest != target_digest.unwrap() or
            actual.nonce_digest != issued.lease.unwrap().nonce_digest or
            actual.expires_monotonic_ns != issued.lease.unwrap().expires_monotonic_ms * 1000000):
        return input_reply_v5(owner, index, issued.revision, issued.nonce, "runtime-connection-input-install-not-current")
    input_reply_v5(owner, index, issued.revision, issued.nonce, "")

pub fn smux_runtime_connection_input_write_v5(original: SmuxRuntimeConnectionOwnerV5,
        uid: text, client_id: text, token: text, nonce: text, revision: i64,
        attempt: i64, frame_sequence: i64, payload: text, offset: i64, maximum: i64) -> SmuxRuntimeConnectionInputTurnV5:
    val index = index_v5(original, uid)
    if index < 0: return input_reply_v5(original, index, 0, "", "runtime-connection-binding-unavailable")
    if (payload.byte_len() < 1 or payload.byte_len() > 65536 or offset < 0 or offset >= payload.byte_len() or
            maximum < 1 or maximum > 4096 or maximum > payload.byte_len() - offset or
            attempt < 1 or attempt > 1152921504606846975 or frame_sequence < 1 or frame_sequence > 1152921504606846975):
        return input_reply_v5(original, index, revision, "", "runtime-connection-input-range")
    var owner = input_refresh_v5(original, index)
    val resolved = resolve_v5(owner, index, client_id, token)
    if resolved.is_err(): return input_reply_v5(owner, index, revision, "", resolved.unwrap_err())
    val checked = smux_runtime_control_check_v1(owner.controls, uid, SessionRuntimeControlKindV1.Input,
        nonce, revision, resolved.unwrap().target, sosix_time_now_monotonic_ms())
    owner.controls = checked.owner
    if checked.error != "" or checked.lease.is_none(): return input_reply_v5(owner, index, revision, "", checked.error)
    val target_digest = session_runtime_control_target_digest_v1(resolved.unwrap().target)
    if target_digest.is_err(): return input_reply_v5(owner, index, revision, "", target_digest.unwrap_err())
    val digest = sha256_text(target_digest.unwrap() + "\n" + revision.to_text() + "\n" + sha256_text(nonce) + "\n" +
        checked.lease.unwrap().expires_monotonic_ms.to_text() + "\n" + attempt.to_text() + "\n" + frame_sequence.to_text() + "\n" +
        sha256_text(payload) + "\n" + offset.to_text() + "\n" + maximum.to_text())
    var entry = owner.entries[index]
    if val previous = entry.input_request:
        if attempt == previous.attempt:
            return input_reply_v5(owner, index, revision, "", if entry.input_digest == digest: "" else: "runtime-connection-attempt-changed")
        if attempt != previous.attempt + 1: return input_reply_v5(owner, index, revision, "", "runtime-connection-attempt-not-next")
        if entry.input_receipt.is_none(): return input_reply_v5(owner, index, revision, "", "runtime-connection-input-unresolved")
        val prior = entry.input_receipt.unwrap().disposition
        if prior == ContainerPrimaryInputDispositionV2.Unknown or prior == ContainerPrimaryInputDispositionV2.Queued:
            return input_reply_v5(owner, index, revision, "", "runtime-connection-input-unresolved")
        val accepted = owner.entries[index].input_receipt.unwrap().accepted_bytes
        val next_offset = previous.offset + accepted
        if next_offset < previous.payload.byte_len():
            if frame_sequence != previous.frame_sequence or payload != previous.payload or offset != next_offset:
                return input_reply_v5(owner, index, revision, "", "runtime-connection-input-suffix-required")
        elif frame_sequence != previous.frame_sequence + 1 or offset != 0:
            return input_reply_v5(owner, index, revision, "", "runtime-connection-input-next-frame-required")
    elif attempt != 1 or frame_sequence != 1 or offset != 0:
        return input_reply_v5(owner, index, revision, "", "runtime-connection-first-attempt")
    val request = ContainerPrimaryInputRequestV2(checked.lease.unwrap(), resolved.unwrap().target,
        owner.controls.policy.principal_id, nonce, attempt, frame_sequence, payload, offset, maximum)
    entry.input_request = Some(request)
    entry.input_digest = digest
    entry.input_receipt = Some(ContainerPrimaryInputWriteV2(ContainerPrimaryInputDispositionV2.Unknown, attempt, -1,
        "runtime-connection-awaiting-native-receipt"))
    owner.entries[index] = entry
    val written = container_primary_input_write_v2(resolved.unwrap().session, request)
    if written.is_err(): return input_reply_v5(owner, index, revision, "", written.unwrap_err())
    entry.input_receipt = Some(written.unwrap())
    owner.entries[index] = entry
    input_reply_v5(owner, index, revision, "", written.unwrap().error)

pub fn smux_runtime_connection_input_observe_v5(original: SmuxRuntimeConnectionOwnerV5,
        uid: text) -> SmuxRuntimeConnectionInputTurnV5:
    val index = index_v5(original, uid)
    if index < 0: return input_reply_v5(original, index, 0, "", "runtime-connection-binding-unavailable")
    input_reply_v5(input_refresh_v5(original, index), index, 0, "", "")

pub fn smux_runtime_connection_input_resolve_v5(owner: SmuxRuntimeConnectionOwnerV5,
        uid: text, client_id: text, token: text) -> Result<text, text>:
    val index = index_v5(owner, uid)
    if index < 0: return Err("runtime-connection-binding-unavailable")
    val resolved = resolve_v5(owner, index, client_id, token)?
    session_runtime_control_target_digest_v1(resolved.target)

pub fn smux_runtime_connection_input_revoke_v5(original: SmuxRuntimeConnectionOwnerV5,
        uid: text, expected_revision: i64) -> SmuxRuntimeConnectionInputTurnV5:
    val index = index_v5(original, uid)
    if index < 0: return input_reply_v5(original, index, 0, "", "runtime-connection-binding-unavailable")
    var owner = original
    val revoked = smux_runtime_control_revoke_v1(owner.controls, uid, SessionRuntimeControlKindV1.Input,
        expected_revision, sosix_time_now_monotonic_ms())
    owner.controls = revoked.owner
    if revoked.error != "": return input_reply_v5(owner, index, revoked.revision, "", revoked.error)
    val session = pane_session_v5(owner.entries[index])
    if session.is_err(): return input_reply_v5(owner, index, revoked.revision, "", session.unwrap_err())
    val native = container_primary_input_revoke_v2(session.unwrap())
    owner = input_refresh_v5(owner, index)
    input_reply_v5(owner, index, revoked.revision, "", if native.is_err(): native.unwrap_err() else: "")

pub fn smux_runtime_connection_open_v5(domain: HostServiceDomainV3,
        incarnation: text) -> SmuxRuntimeConnectionOpenV5:
    val policy = smux_runtime_connection_policy_load_v5(domain.local)
    if policy.is_err(): return SmuxRuntimeConnectionOpenV5(nil, Some(domain), policy.unwrap_err())
    # The signed-enrollment LinuxService has no direct primary-connection provider
    # (supported_v3 stays false for it). Its only terminal is the V4 agent pane,
    # whose Input right is the fixed policy policy_load_v5 returned and is usable
    # only while the terminal-authority accessor is Ok (capabilities_v5 and every
    # pane Write re-ask it). Its admission is the full current_v4 recheck
    # policy_load_v5 just ran, whose own error text was returned above.
    val supported = match domain.local:
        case HostLocalRootV3.LinuxService(_): true
        case _: host_primary_connection_supported_v3(domain.local)
    if not supported:
        return SmuxRuntimeConnectionOpenV5(nil, Some(domain), "runtime-connection-provider-unavailable")
    val controls = smux_runtime_control_owner_new_v1(policy.unwrap(), incarnation)
    if controls.is_err(): return SmuxRuntimeConnectionOpenV5(nil, Some(domain), controls.unwrap_err())
    SmuxRuntimeConnectionOpenV5(Some(SmuxRuntimeConnectionOwnerV5(domain, incarnation, controls.unwrap(), [], smux_host_continuation_new_v6())), nil, "")

fn reply_v5(owner: SmuxRuntimeConnectionOwnerV5, error: text) -> SmuxRuntimeConnectionTurnV5:
    SmuxRuntimeConnectionTurnV5(owner, nil, nil, "", error)

fn index_v5(owner: SmuxRuntimeConnectionOwnerV5, uid: text) -> int:
    for index in 0..owner.entries.len():
        if owner.entries[index].request.target.binding_uid == uid: return index
    -1

# Existing shared Host request vocabulary. Blocking lifecycle effects are
# explicitly reserved for the owned continuation port, not this control turn.
pub fn smux_runtime_connection_scope_v5(owner: SmuxRuntimeConnectionOwnerV5) -> ContainerHostScopeV2:
    match owner.domain.local:
        case HostLocalRootV3.Linux(local): local.scope
        case HostLocalRootV3.Windows(local): local.scope_v3()
        case HostLocalRootV3.LinuxService(local): local.scope_v4()

# Correlation/restriction data only. V6 independently derives the actual scope
# from the same supplied Domain before query/bound effects or replies.
fn host_context_v6(owner: SmuxRuntimeConnectionOwnerV5) -> SmuxHostContextV6:
    var connection_pending = false
    for entry in owner.entries:
        if entry.task.is_some() and entry.task.unwrap().pending_v3():
            connection_pending = true
            break
    val scope = container_scope_fence_id_v2(smux_runtime_connection_scope_v5(owner))
    SmuxHostContextV6(owner.service_incarnation, if scope.is_ok(): scope.unwrap() else: "",
        owner.closing, owner.planning.is_some(), geometry_pending_v5(owner), connection_pending)

fn host_accept_v6(original: SmuxRuntimeConnectionOwnerV5, turn: SmuxHostStateTurnV6) -> SmuxRuntimeConnectionOwnerV5:
    var owner = original
    owner.domain = turn.domain
    owner.host = turn.state
    owner

pub fn smux_runtime_connection_host_v5(original: SmuxRuntimeConnectionOwnerV5,
        request: HostServiceRequestV2) -> SmuxRuntimeConnectionTurnV5:
    smux_runtime_connection_host_constrained_v5(original, request, nil)

# milestone_0025 PR4: a pane Write through the smux control lease. Only here is the owner's control owner
# reachable, so the write is intercepted before the continuation. Rights come from the verified terminal
# authority alone: the target is built by the service from the signed binding and the attached session, the body
# names only the binding uid and the byte window, and the lease principal is the fixed policy's. A fresh Input
# lease is issued per Write (TTL = policy max, bounded by the 15 s validator), the service re-verifies terminal
# authority again inside the pane io on this very call, and the lease is revoked when the write returns. Native
# input revisions must rise per attach and each owner's control revision restarts at 1: that is safe only while the
# pane lease is handed out once per attachment (one connection ever writes); revisit if that rule changes.
fn agent_pane_write_turn_v5(original: SmuxRuntimeConnectionOwnerV5, request: HostServiceRequestV2) -> SmuxRuntimeConnectionTurnV5:
    if original.closing: return reply_v5(original, "runtime-connection-closing")
    val context = host_context_v6(original)
    val gate = smux_host_continuation_pane_write_gate_v6(original.host, context, request.operation_id)
    if gate != "": return reply_v5(original, gate)
    val body = smux_agent_pane_write_decode_v1(request.payload)
    if body.is_err(): return reply_v5(original, body.unwrap_err())
    val service = match original.domain.local:
        case HostLocalRootV3.LinuxService(value): value
        case _: return reply_v5(original, "host-linux-service-action-route")
    var owner = original
    # A refusal of the terminal AUTHORITY is the agent's own answer and drops the pane lease like a refused Read;
    # a target-construction refusal (session not adopted yet, plan mismatch) keeps it.
    val authority = host_linux_service_agent_terminal_authority_v4(service)
    if authority.is_err(): return agent_pane_write_refused_v5(owner, authority.unwrap_err())
    val target = host_linux_service_agent_pane_control_target_v4(service)
    if target.is_err(): return reply_v5(owner, target.unwrap_err())
    if target.unwrap().binding_uid != body.unwrap().binding_uid:
        return reply_v5(owner, "attach-binding-mismatch")
    if target.unwrap().service_incarnation != owner.service_incarnation:
        return reply_v5(owner, "attach-binding-registry-mismatch")
    val uid = target.unwrap().binding_uid
    val digest = session_runtime_control_target_digest_v1(target.unwrap())
    if digest.is_err(): return reply_v5(owner, digest.unwrap_err())
    val fresh = sosix_random_hex(32)
    if fresh.is_none(): return reply_v5(owner, "runtime-connection-entropy-unavailable")
    val now = sosix_time_now_monotonic_ms()
    val held = smux_runtime_control_find_v1(owner.controls, uid, SessionRuntimeControlKindV1.Input)
    val expected_revision = if held.is_none(): 0 else: held.unwrap().lease.revision
    # A token from signed data only (target digest + lease epoch), never smux client-lease state.
    val token = smux_agent_pane_control_token_v1(digest.unwrap(), target.unwrap().attachment_generation)
    val issued = smux_runtime_control_issue_v1(owner.controls, target.unwrap(), SessionRuntimeControlKindV1.Input,
        token, now + owner.controls.policy.max_lease_ms, expected_revision, fresh.unwrap(), now)
    owner.controls = issued.owner
    if issued.error != "" or issued.lease.is_none(): return reply_v5(owner, issued.error)
    val write = HostAgentPaneWriteV4(lease: issued.lease.unwrap(), target: target.unwrap(),
        principal: owner.controls.policy.principal_id, nonce: issued.nonce, attempt: body.unwrap().attempt,
        write_id: body.unwrap().write_id,
        offset: body.unwrap().offset, maximum: body.unwrap().maximum, data: body.unwrap().data)
    val shaped = host_agent_pane_write_check_v4(write)
    if shaped.is_err():
        val dropped = smux_runtime_control_revoke_v1(owner.controls, uid, SessionRuntimeControlKindV1.Input,
            issued.revision, sosix_time_now_monotonic_ms())
        owner.controls = dropped.owner
        return reply_v5(owner, smux_agent_pane_write_revoke_report_v1("", shaped.unwrap_err(), dropped.error).error)
    val turn = smux_host_continuation_pane_write_v6(owner.domain, owner.host, context, uid, write)
    owner.domain = turn.domain
    owner.host = turn.state
    val retired = smux_runtime_control_revoke_v1(owner.controls, uid, SessionRuntimeControlKindV1.Input,
        issued.revision, sosix_time_now_monotonic_ms())
    owner.controls = retired.owner
    val report = smux_agent_pane_write_revoke_report_v1(turn.response, turn.error, retired.error)
    SmuxRuntimeConnectionTurnV5(owner, None, None, report.response, report.error)

# A terminal-authority refusal is the agent's own answer: it drops the pane lease exactly as a refused Read does.
fn agent_pane_write_refused_v5(original: SmuxRuntimeConnectionOwnerV5, error: text) -> SmuxRuntimeConnectionTurnV5:
    var owner = original
    val turn = smux_host_continuation_pane_write_refused_v6(owner.domain, owner.host, error)
    owner.host = turn.state
    SmuxRuntimeConnectionTurnV5(owner, None, None, "", turn.error)

# Restriction only: this is the SAME retained signed Host domain and writer.
pub fn smux_runtime_connection_host_constrained_v5(original: SmuxRuntimeConnectionOwnerV5,
        request: HostServiceRequestV2, requested_constraint: Option<ContainerPreStartConstraintV1>) -> SmuxRuntimeConnectionTurnV5:
    if request.action == "host-agent-pane-write": return agent_pane_write_turn_v5(original, request)
    val turn = smux_host_continuation_begin_constrained_v6(original.domain, original.host,
        request, host_context_v6(original), requested_constraint)
    var owner = original
    owner.domain = turn.domain
    owner.host = turn.state
    SmuxRuntimeConnectionTurnV5(owner, None, None, turn.response, turn.error)

pub fn smux_runtime_connection_plan_v5(original: SmuxRuntimeConnectionOwnerV5,
        request: SmuxRuntimePrimaryRequestV4, resources: ContainerOutputResourcesV2,
        client_id: text, attachment_token: text) -> SmuxRuntimeConnectionTurnV5:
    if original.host.inspection_pending_v6(): return reply_v5(original, "runtime-controller-inspection-pending")
    if original.closing: return reply_v5(original, "runtime-connection-closing")
    if original.host.execution_pending_v6() or original.host.inspection_pending_v6(): return reply_v5(original, "runtime-host-execution-pending")
    if geometry_pending_v5(original): return reply_v5(original, "runtime-geometry-pending")
    val digest = smux_runtime_primary_request_digest_v4(request)
    if digest.is_err(): return reply_v5(original, digest.unwrap_err())
    val checked = smux_runtime_binding_target_check_v3(request.target, original.service_incarnation)
    if checked.is_err(): return reply_v5(original, checked.unwrap_err())
    val attachment = smux_client_lease_snapshot(request.target.session_id, client_id, attachment_token)
    if attachment.is_err(): return reply_v5(original, attachment.unwrap_err())
    if request.target.expected_epoch > 9223372036854775807 or request.target.expected_child_incarnation >= 9223372036854775807:
        return reply_v5(original, "runtime-connection-target-bound")
    val existing = index_v5(original, request.target.binding_uid)
    if existing >= 0:
        val entry = original.entries[existing]
        if entry.plan.identity.binding_digest != digest.unwrap() or entry.plan.resources != resources:
            return reply_v5(original, "runtime-connection-binding-exists")
        return SmuxRuntimeConnectionTurnV5(original, Some(entry.plan), entry.prepared, "", entry.error)
    if original.entries.len() >= 16: return reply_v5(original, "runtime-connection-capacity")
    for entry in original.entries:
        if entry.task.is_some() and entry.task.unwrap().pending_v3(): return reply_v5(original, "runtime-connection-opening")
    var owner = original
    val request_digest = sha256_text(digest.unwrap() + "\n" + resources.cpu_millis.to_text() + "\n" + resources.memory_bytes.to_text() +
        "\n" + client_id + "\n" + sha256_text(attachment_token))
    if owner.planning.is_some():
        return reply_v5(owner, if owner.planning_digest == request_digest: "runtime-connection-plan-pending" else: "runtime-connection-inspection-busy")
    owner.planning_request = Some(request)
    owner.planning_digest = request_digest
    owner.planning_client = client_id
    owner.planning_token = attachment_token
    owner.planning_error = ""
    owner.planning_cancelled = false
    val turn = host_primary_connection_plan_begin_v4(owner.domain.local, request.target.workload_operation_id,
        request.target.helper_operation_id, request.target.parent_budget_digest, digest.unwrap(), resources, request.terminal_mode)
    planning_turn_v5(owner, turn)

fn planning_turn_v5(original: SmuxRuntimeConnectionOwnerV5, turn: HostPrimaryConnectionPlanningTurnV4) -> SmuxRuntimeConnectionTurnV5:
    var owner = original
    owner.domain = HostServiceDomainV3(turn.local)
    owner.planning = turn.planning
    owner.planning_error = turn.error
    if turn.planning.is_some(): return reply_v5(owner, if turn.error == "": "runtime-connection-plan-pending" else: turn.error)
    if turn.error != "" or turn.plan.is_none(): return reply_v5(owner, if turn.error == "": "runtime-connection-plan-missing" else: turn.error)
    if owner.planning_request.is_none(): return reply_v5(owner, "runtime-connection-planning-request-missing")
    val request = owner.planning_request.unwrap()
    val checked = smux_runtime_binding_target_check_v3(request.target, owner.service_incarnation)
    if checked.is_err():
        owner.planning_error = checked.unwrap_err()
        return reply_v5(owner, checked.unwrap_err())
    val attachment = smux_client_lease_snapshot(request.target.session_id, owner.planning_client, owner.planning_token)
    if attachment.is_err():
        owner.planning_error = attachment.unwrap_err()
        return reply_v5(owner, attachment.unwrap_err())
    val plan = turn.plan.unwrap()
    val scope = container_primary_connection_scope_v2(plan)
    val target = SessionRuntimeControlTargetV1(scope: scope, runtime: plan.runtime,
        workload_request_digest: plan.workload.request_digest, binding_uid: request.target.binding_uid,
        binding_digest: plan.identity.binding_digest, service_incarnation: owner.service_incarnation,
        session_id: request.target.session_id, window_id: request.target.window_id, pane_id: request.target.pane_id,
        service_epoch: request.target.expected_epoch as i64, child_incarnation: (request.target.expected_child_incarnation + 1) as i64,
        client_id: attachment.unwrap().client_id, attachment_generation: attachment.unwrap().generation,
        execution_kind: "primary", native_exec_id: "", exec_request_digest: "")
    owner.entries.push(ConnectionEntryV5(request, plan, target))
    SmuxRuntimeConnectionTurnV5(owner, Some(plan), nil, "", "")

fn helper_match_v5(entry: ConnectionEntryV5, request: HostHelperRequestV1) -> bool:
    (request.operation.id == entry.request.target.helper_operation_id and request.plan.helper_kind == "primary-connection" and
        request.plan.request_digest == entry.plan.request_digest)

pub fn smux_runtime_connection_prepare_v5(original: SmuxRuntimeConnectionOwnerV5,
        uid: text, request: HostHelperRequestV1) -> SmuxRuntimeConnectionTurnV5:
    val index = index_v5(original, uid)
    if original.host.execution_pending_v6() or original.planning.is_some() or original.host.inspection_pending_v6(): return reply_v5(original, "runtime-host-execution-pending")
    if index < 0 or original.closing: return reply_v5(original, "runtime-connection-binding-unavailable")
    var owner = original
    var entry = owner.entries[index]
    if not helper_match_v5(entry, request) or entry.task.is_some() or entry.helper.is_some():
        return reply_v5(owner, "runtime-connection-helper-mismatch")
    val encoded = host_helper_request_encode_v1(request)
    if encoded.is_err(): return reply_v5(owner, encoded.unwrap_err())
    val digest = sha256_text(encoded.unwrap())
    if entry.prepare_request_digest != "" and entry.prepare_request_digest != digest:
        return reply_v5(owner, "runtime-connection-preparation-retry-mismatch")
    if entry.recovery_required: return reply_v5(owner, "runtime-connection-preparation-recovery-required")
    if entry.prepared.is_some():
        return SmuxRuntimeConnectionTurnV5(owner, nil, entry.prepared, "", entry.error)
    entry.prepare_request_digest = digest
    entry.prepare_deadline_ms = request.intent.reservation.prepare_deadline_ms
    owner.entries[index] = entry
    val turn = host_primary_connection_helper_prepare_v3(owner.domain.local, request)
    owner.domain = HostServiceDomainV3(turn.local)
    if turn.receipt.is_some(): entry.prepared = turn.receipt
    entry.recovery_required = entry.recovery_required or turn.recovery_required
    entry.error = turn.error
    owner.entries[index] = entry
    SmuxRuntimeConnectionTurnV5(owner, nil, turn.receipt, "", turn.error)

pub fn smux_runtime_connection_bind_v5(original: SmuxRuntimeConnectionOwnerV5,
        uid: text, request: HostHelperRequestV1, signed: DistributedSignedGrantV2,
        approval: DistributedSignedApprovalV2) -> SmuxRuntimeConnectionTurnV5:
    val index = index_v5(original, uid)
    if original.host.execution_pending_v6() or original.planning.is_some() or original.host.inspection_pending_v6(): return reply_v5(original, "runtime-host-execution-pending")
    if geometry_pending_v5(original): return reply_v5(original, "runtime-geometry-pending")
    for pending_entry in original.entries:
        if pending_entry.task.is_some() and pending_entry.task.unwrap().pending_v3(): return reply_v5(original, "runtime-connection-opening")
    if index < 0 or original.closing: return reply_v5(original, "runtime-connection-binding-unavailable")
    var owner = original
    var entry = owner.entries[index]
    if (not helper_match_v5(entry, request) or entry.prepared.is_none() or entry.task.is_some() or
            entry.helper.is_some() or entry.recovery_required): return reply_v5(owner, "runtime-connection-helper-unavailable")
    val checked = smux_runtime_binding_target_check_v3(entry.request.target, owner.service_incarnation)
    if checked.is_err(): return reply_v5(owner, checked.unwrap_err())
    val begun = host_primary_connection_helper_begin_v3(owner.domain.local, request, entry.prepared.unwrap(), signed, approval)
    owner.domain = HostServiceDomainV3(begun.local)
    entry.helper = begun.helper
    entry.recovery_required = begun.recovery_required
    entry.error = begun.error
    owner.entries[index] = entry
    if begun.error != "" or begun.helper.is_none(): return reply_v5(owner, if begun.error == "": "runtime-connection-helper-missing" else: begun.error)
    val opened = host_primary_connection_open_v3(owner.domain.local, entry.plan, begun.helper.unwrap())
    owner.domain = HostServiceDomainV3(opened.local)
    entry.task = opened.task
    entry.error = opened.error
    owner.entries[index] = entry
    reply_v5(owner, opened.error)

# At most one native exchange step per call. No output read occurs here; once
# adopted, the canonical pane owns the only reader and the task retains metadata.
pub fn smux_runtime_connection_progress_v5(original: SmuxRuntimeConnectionOwnerV5,
        uid: text, cancel: bool) -> SmuxRuntimeConnectionTurnV5:
    val index = index_v5(original, uid)
    if original.host.execution_pending_v6() or original.host.inspection_pending_v6(): return reply_v5(original, "runtime-host-execution-pending")
    if index < 0:
        if original.planning_request.is_some() and original.planning_request.unwrap().target.binding_uid == uid:
            if original.planning.is_none(): return reply_v5(original, original.planning_error)
            var planned_owner = original
            planned_owner.planning_cancelled = original.planning_cancelled or cancel
            val turn = host_primary_connection_plan_step_v4(planned_owner.domain.local, planned_owner.planning.unwrap(), planned_owner.planning_cancelled)
            return planning_turn_v5(planned_owner, turn)
        return reply_v5(original, "runtime-connection-binding-unavailable")
    if original.planning.is_some(): return reply_v5(original, "runtime-connection-inspection-pending")
    var owner = original
    var entry = owner.entries[index]
    if entry.task.is_none() or entry.adopted or entry.retained.is_some(): return reply_v5(owner, "runtime-connection-progress-state")
    val progressed = host_primary_connection_progress_v3(owner.domain.local, entry.task.unwrap(), cancel or owner.closing)
    owner.domain = HostServiceDomainV3(progressed.local)
    entry.task = progressed.task
    entry.error = progressed.error
    owner.entries[index] = entry
    if progressed.error != "" or progressed.task.is_none(): return reply_v5(owner, progressed.error)
    if cancel or owner.closing or not progressed.task.unwrap().has_session_v3(): return reply_v5(owner, "")
    val transfer = host_primary_connection_transfer_v3(progressed.task.unwrap())
    entry.task = Some(transfer.task)
    entry.retained = transfer.session
    entry.error = transfer.error
    owner.entries[index] = entry
    if transfer.error != "" or transfer.session.is_none(): return reply_v5(owner, transfer.error)
    val view = container_primary_terminal_view_v2(transfer.session.unwrap())
    if view.is_err(): return reply_v5(owner, view.unwrap_err())
    entry.session_identity = view.unwrap().fingerprint
    val adopted = smux_pane_adopt_primary_v5(entry.target, entry.request.target.expected_revision, transfer.session.unwrap())
    entry.retained = adopted.retained
    entry.adopted = adopted.adopted
    entry.error = adopted.error
    owner.entries[index] = entry
    reply_v5(owner, adopted.error)

pub struct SmuxRuntimeHostProgressV5:
    operation_id: text
    pending: bool
    response: text
    exit_code: i64
    error: text

pub fn smux_runtime_connection_host_progress_v5(owner: SmuxRuntimeConnectionOwnerV5) -> SmuxRuntimeHostProgressV5:
    val progress = smux_host_continuation_progress_v6(owner.host)
    SmuxRuntimeHostProgressV5(progress.operation_id, progress.pending,
        progress.response, progress.exit_code, progress.error)

pub struct SmuxRuntimeHostBoundTurnV6:
    owner: SmuxRuntimeConnectionOwnerV5
    progress: Option<SmuxRuntimeHostProgressV5>
    error: text

pub struct SmuxRuntimeHostOperationTurnV6:
    owner: SmuxRuntimeConnectionOwnerV5
    reply: HostServiceOperationReplyV6

pub struct SmuxRuntimeAuthPublicationTurnV6:
    owner: SmuxRuntimeConnectionOwnerV5
    ready_digest: text
    lease_digest: text
    authority_digest: text
    deployment_root: text
    completed: bool
    cleanup_pending: bool
    error: text

pub fn smux_runtime_connection_auth_publication_v6(original: SmuxRuntimeConnectionOwnerV5,
        listener: TcpListener, setup_path: text, pin: text) -> SmuxRuntimeAuthPublicationTurnV6:
    val turn = smux_host_continuation_publication_v6(original.domain, original.host,
        listener, setup_path, pin, original.service_incarnation)
    var owner = original
    owner.domain = turn.domain
    owner.host = turn.state
    SmuxRuntimeAuthPublicationTurnV6(owner, turn.ready_digest, turn.lease_digest,
        turn.authority_digest, turn.deployment_root, turn.completed, turn.cleanup_pending, turn.error)

# Current writer/lease proof only. Cleanup never acquires a new launch grant.
pub fn smux_runtime_connection_auth_current_v6(owner: SmuxRuntimeConnectionOwnerV5) -> Result<bool, text>:
    smux_host_continuation_current_v6(owner.domain, owner.host, owner.closing)

# Data validation inside the caller's uninterrupted canonical listener turn.
# The listener must quiesce before calling close and must retain its result.
pub fn smux_runtime_connection_stop_match_v6(owner: SmuxRuntimeConnectionOwnerV5,
        request: HostServiceOperationRequestV6) -> Result<bool, text>:
    smux_host_continuation_stop_match_v6(owner.domain, owner.host, request, host_context_v6(owner),
        not smux_runtime_connection_stop_allowed_v5(owner))

# Trusted transport adapter, called only after the canonical challenge is taken.
# The caller immediately replaces its sole stored owner with this returned one.
pub fn smux_runtime_connection_host_operation_v6(original: SmuxRuntimeConnectionOwnerV5,
        request: HostServiceOperationRequestV6) -> SmuxRuntimeHostOperationTurnV6:
    val turn = smux_host_continuation_query_v6(original.domain, original.host, request, host_context_v6(original))
    var owner = original
    owner.domain = turn.domain
    owner.host = turn.state
    SmuxRuntimeHostOperationTurnV6(owner, turn.reply)

# No public read-then-unbound-cancel composition. Check and effect run in the
# same canonical native turn against the actual stored execution tuple.
pub fn smux_runtime_connection_host_bound_v6(original: SmuxRuntimeConnectionOwnerV5,
        request: HostServiceOperationRequestV6) -> SmuxRuntimeHostBoundTurnV6:
    val turn = smux_host_continuation_bound_v6(original.domain, original.host, request, host_context_v6(original))
    var owner = original
    owner.domain = turn.domain
    owner.host = turn.state
    val progress = match turn.progress:
        case Some(value): Some(SmuxRuntimeHostProgressV5(value.operation_id, value.pending,
            value.response, value.exit_code, value.error))
        case None: nil
    SmuxRuntimeHostBoundTurnV6(owner, progress, turn.error)

pub fn smux_runtime_connection_host_cancel_v5(original: SmuxRuntimeConnectionOwnerV5) -> SmuxRuntimeConnectionOwnerV5:
    host_accept_v6(original, smux_host_continuation_cancel_execution_v6(original.domain, original.host))

# One actual cooperative stage per shared listener turn. The same canonical
# thread owns Host progression and the native pipe; no worker receives copies.
pub fn smux_runtime_connection_poll_v5(original: SmuxRuntimeConnectionOwnerV5) -> SmuxRuntimeConnectionOwnerV5:
    var owner = original
    if owner.host.inspection_pending_v6() or owner.host.execution_pending_v6():
        return host_accept_v6(owner, smux_host_continuation_step_v6(owner.domain, owner.host, owner.closing))
    if val planning = owner.planning:
        val turn = host_primary_connection_plan_step_v4(owner.domain.local, planning, owner.closing or owner.planning_cancelled)
        return planning_turn_v5(owner, turn).owner
    if owner.entries.len() == 0: return owner
    var examined = 0
    while examined < owner.entries.len():
        if owner.cursor >= owner.entries.len(): owner.cursor = 0
        val index = owner.cursor
        owner.cursor = owner.cursor + 1
        examined = examined + 1
        val entry = owner.entries[index]
        if entry.geometry.is_some() and entry.geometry.unwrap().pending_v5():
            return geometry_step_v5(owner, index, owner.closing or entry.release_requested)
        if (entry.release_requested and not entry.settled and not entry.recovery_required and entry.task.is_none() and
                entry.helper.is_none() and entry.prepared.is_some() and sosix_time_now_monotonic_ms() >= entry.prepare_deadline_ms):
            return smux_runtime_connection_release_v5(owner, entry.target.binding_uid).owner
        if entry.task.is_some() and not entry.adopted and entry.retained.is_none() and not entry.settled:
            if entry.task.unwrap().pending_v3() or entry.task.unwrap().has_session_v3():
                return smux_runtime_connection_progress_v5(owner, entry.target.binding_uid, owner.closing).owner
    owner

pub fn smux_runtime_connection_recover_v5(original: SmuxRuntimeConnectionOwnerV5) -> SmuxRuntimeConnectionOwnerV5:
    var owner = original
    owner.closing = true
    if owner.host.publication_pending_v6():
        return host_accept_v6(owner, smux_host_continuation_close_publication_v6(owner.domain, owner.host))
    if owner.host.inspection_pending_v6():
        return host_accept_v6(owner, smux_host_continuation_step_v6(owner.domain, owner.host, true))
    if owner.host.execution_pending_v6(): return smux_runtime_connection_host_cancel_v5(owner)
    if val planning = owner.planning:
        owner.planning_cancelled = true
        val turn = host_primary_connection_plan_step_v4(owner.domain.local, planning, true)
        return planning_turn_v5(owner, turn).owner
    for entry in owner.entries:
        if not entry.settled and (entry.task.is_some() or entry.prepared.is_some()):
            return smux_runtime_connection_release_v5(owner, entry.target.binding_uid).owner
    owner

# Synchronize actual native gates after generic attachment mutations and sweeps.
# Revocation never installs a lease or erases a queued/Unknown attempt receipt.
pub fn smux_runtime_connection_controls_sync_v5(original: SmuxRuntimeConnectionOwnerV5) -> SmuxRuntimeConnectionOwnerV5:
    var owner = original
    owner.control_sync_error = ""
    for index in 0..owner.entries.len():
        val entry = owner.entries[index]
        if not entry.adopted or entry.settled: continue
        val session = pane_session_v5(entry)
        if session.is_err():
            owner.control_sync_error = session.unwrap_err()
            continue
        val state = container_primary_input_gate_v2(session.unwrap())
        if state.is_err():
            owner.control_sync_error = state.unwrap_err()
            continue
        val record = smux_runtime_control_find_v1(owner.controls, entry.target.binding_uid, SessionRuntimeControlKindV1.Input)
        var eligible = false
        if record != nil and record.unwrap().active and not owner.closing:
            val value = record.unwrap()
            val resolved = resolve_v5(owner, index, value.lease.target.client_id, value.attachment_token)
            if resolved.is_ok():
                val checked = smux_runtime_control_check_v1(owner.controls, entry.target.binding_uid,
                    SessionRuntimeControlKindV1.Input, value.nonce, value.lease.revision,
                    resolved.unwrap().target, sosix_time_now_monotonic_ms())
                owner.controls = checked.owner
                if checked.error == "" and checked.lease.is_some():
                    val lease = checked.lease.unwrap()
                    val digest = session_runtime_control_target_digest_v1(lease.target)
                    eligible = (digest.is_ok() and state.unwrap().controlled and state.unwrap().active and
                        state.unwrap().target_digest == digest.unwrap() and state.unwrap().nonce_digest == lease.nonce_digest and
                        state.unwrap().revision == lease.revision and lease.expires_monotonic_ms <= 9223372036854 and
                        state.unwrap().expires_monotonic_ns == lease.expires_monotonic_ms * 1000000)
        if eligible: continue
        # Retire issuer first; an inactive native gate never authorizes reissue
        # at the same revision. Revoke still retains any already queued bytes.
        if record != nil and record.unwrap().active:
            val retired = smux_runtime_control_revoke_v1(owner.controls, entry.target.binding_uid,
                SessionRuntimeControlKindV1.Input, record.unwrap().lease.revision, sosix_time_now_monotonic_ms())
            owner.controls = retired.owner
            if retired.error != "": owner.control_sync_error = retired.error
        if state.unwrap().active:
            val revoked = container_primary_input_revoke_v2(session.unwrap())
            if revoked.is_err(): owner.control_sync_error = revoked.unwrap_err()
        owner = input_refresh_v5(owner, index)
    # At most one Geometry exchange may be pending in this coordinator. Invalid
    # generic attachment/policy changes cancel that owner before another write.
    for index in 0..owner.entries.len():
        val entry = owner.entries[index]
        if not entry.adopted or entry.settled: continue
        val record = smux_runtime_control_find_v1(owner.controls, entry.target.binding_uid, SessionRuntimeControlKindV1.Geometry)
        var eligible = false
        if record != nil and record.unwrap().active and not owner.closing:
            val value = record.unwrap()
            val resolved = resolve_v5(owner, index, value.lease.target.client_id, value.attachment_token)
            if resolved.is_ok():
                val checked = smux_runtime_control_check_v1(owner.controls, entry.target.binding_uid,
                    SessionRuntimeControlKindV1.Geometry, value.nonce, value.lease.revision,
                    resolved.unwrap().target, sosix_time_now_monotonic_ms())
                owner.controls = checked.owner
                eligible = checked.error == "" and checked.lease.is_some()
        if eligible: continue
        if record != nil and record.unwrap().active:
            val retired = smux_runtime_control_revoke_v1(owner.controls, entry.target.binding_uid,
                SessionRuntimeControlKindV1.Geometry, record.unwrap().lease.revision, sosix_time_now_monotonic_ms())
            owner.controls = retired.owner
            if retired.error != "": owner.control_sync_error = retired.error
        if entry.geometry.is_some() and entry.geometry.unwrap().pending_v5():
            owner = geometry_step_v5(owner, index, true)
    owner

pub struct SmuxRuntimeConnectionGeometryTurnV5:
    owner: SmuxRuntimeConnectionOwnerV5
    revision: i64
    nonce: text
    receipt: HostPrimaryGeometryReceiptV1?
    error: text

pub struct SmuxConnectionGeometryTargetV5:
    target_digest: text
    wire_digest: text

fn geometry_pending_v5(owner: SmuxRuntimeConnectionOwnerV5) -> bool:
    for entry in owner.entries:
        if entry.geometry.is_some() and entry.geometry.unwrap().pending_v5(): return true
    false

fn geometry_reply_v5(owner: SmuxRuntimeConnectionOwnerV5, index: int,
        revision: i64, nonce: text, error: text) -> SmuxRuntimeConnectionGeometryTurnV5:
    val receipt = if index < 0 or owner.entries[index].geometry.is_none(): nil else: owner.entries[index].geometry.unwrap().receipt_v5()
    SmuxRuntimeConnectionGeometryTurnV5(owner, revision, nonce, receipt, error)

pub fn smux_runtime_connection_geometry_resolve_v5(owner: SmuxRuntimeConnectionOwnerV5,
        uid: text, client: text, token: text, columns: i64, rows: i64) -> Result<SmuxConnectionGeometryTargetV5, text>:
    val index = index_v5(owner, uid)
    if index < 0: return Err("runtime-connection-binding-unavailable")
    val resolved = resolve_v5(owner, index, client, token)?
    Ok(SmuxConnectionGeometryTargetV5(session_runtime_control_target_digest_v1(resolved.target)?,
        container_primary_geometry_wire_digest_v2(resolved.session, columns, rows)?))

pub fn smux_runtime_connection_geometry_issue_v5(original: SmuxRuntimeConnectionOwnerV5,
        uid: text, client: text, token: text, revision: i64, digest: text) -> SmuxRuntimeConnectionGeometryTurnV5:
    val index = index_v5(original, uid)
    if index < 0: return geometry_reply_v5(original, index, 0, "", "runtime-connection-binding-unavailable")
    var owner = original
    val entry = owner.entries[index]
    if entry.geometry.is_some() and entry.geometry.unwrap().unresolved_v5():
        return geometry_reply_v5(owner, index, revision, "", "runtime-geometry-prior-unresolved")
    val resolved = resolve_v5(owner, index, client, token)
    if resolved.is_err(): return geometry_reply_v5(owner, index, revision, "", resolved.unwrap_err())
    val target = session_runtime_control_target_digest_v1(resolved.unwrap().target)
    val tty = container_primary_geometry_wire_digest_v2(resolved.unwrap().session, 1, 1)
    if tty.is_err(): return geometry_reply_v5(owner, index, revision, "", tty.unwrap_err())
    if target.is_err() or target.unwrap() != digest: return geometry_reply_v5(owner, index, revision, "", "runtime-geometry-target-digest")
    val nonce = sosix_random_hex(32)
    if nonce == nil: return geometry_reply_v5(owner, index, revision, "", "runtime-connection-entropy-unavailable")
    val issued = smux_runtime_control_issue_v1(owner.controls, resolved.unwrap().target, SessionRuntimeControlKindV1.Geometry,
        token, resolved.unwrap().attachment.deadline_ms, revision, nonce.unwrap(), sosix_time_now_monotonic_ms())
    owner.controls = issued.owner
    geometry_reply_v5(owner, index, issued.revision, issued.nonce, issued.error)

pub fn smux_runtime_connection_geometry_resize_v5(original: SmuxRuntimeConnectionOwnerV5,
        uid: text, client: text, token: text, nonce: text, revision: i64,
        attempt: i64, columns: i64, rows: i64, wire_digest: text) -> SmuxRuntimeConnectionGeometryTurnV5:
    val index = index_v5(original, uid)
    if index < 0: return geometry_reply_v5(original, index, revision, "", "runtime-connection-binding-unavailable")
    if original.host.inspection_pending_v6(): return geometry_reply_v5(original, index, revision, "", "runtime-controller-inspection-pending")
    var owner = original
    if owner.host.execution_pending_v6() or owner.planning.is_some(): return geometry_reply_v5(owner, index, revision, "", "runtime-host-execution-pending")
    for other in owner.entries:
        if other.target.binding_uid != uid and other.geometry.is_some() and other.geometry.unwrap().pending_v5():
            return geometry_reply_v5(owner, index, revision, "", "runtime-geometry-pending")
        if other.task.is_some() and other.task.unwrap().pending_v3():
            return geometry_reply_v5(owner, index, revision, "", "runtime-connection-opening")
    val resolved = resolve_v5(owner, index, client, token)
    if resolved.is_err(): return geometry_reply_v5(owner, index, revision, "", resolved.unwrap_err())
    val wire = container_primary_geometry_wire_digest_v2(resolved.unwrap().session, columns, rows)
    if wire.is_err(): return geometry_reply_v5(owner, index, revision, "", wire.unwrap_err())
    if wire.unwrap() != wire_digest: return geometry_reply_v5(owner, index, revision, "", "runtime-geometry-wire-digest")
    val checked = smux_runtime_control_check_v1(owner.controls, uid, SessionRuntimeControlKindV1.Geometry,
        nonce, revision, resolved.unwrap().target, sosix_time_now_monotonic_ms())
    owner.controls = checked.owner
    if checked.error != "" or checked.lease.is_none(): return geometry_reply_v5(owner, index, revision, "", checked.error)
    val request = ContainerPrimaryGeometryRequestV1(checked.lease.unwrap(), resolved.unwrap().target,
        owner.controls.policy.principal_id, nonce, attempt, columns, rows, wire_digest)
    var entry = owner.entries[index]
    val state = entry.geometry ?? smux_connection_geometry_new_v5()
    val begun = smux_connection_geometry_begin_v5(owner.domain, entry.task.unwrap(), resolved.unwrap().session, state, request)
    owner.domain = begun.domain
    entry.geometry = Some(begun.state)
    owner.entries[index] = entry
    geometry_reply_v5(owner, index, revision, "", begun.error)

fn geometry_step_v5(original: SmuxRuntimeConnectionOwnerV5, index: int, cancel: bool) -> SmuxRuntimeConnectionOwnerV5:
    var owner = original
    var entry = owner.entries[index]
    if entry.geometry.is_none() or not entry.geometry.unwrap().pending_v5(): return owner
    val state = entry.geometry.unwrap()
    val request = state.request_v5()
    val record = smux_runtime_control_find_v1(owner.controls, entry.target.binding_uid, SessionRuntimeControlKindV1.Geometry)
    var stop = cancel or owner.closing or request == nil or record == nil or entry.task.is_none()
    var resolved: ConnectionResolvedV5? = nil
    if not stop:
        val live = record.unwrap()
        val target = resolve_v5(owner, index, live.lease.target.client_id, live.attachment_token)
        if not live.active or target.is_err(): stop = true
        else:
            resolved = Some(target.unwrap())
            val checked = smux_runtime_control_check_v1(owner.controls, entry.target.binding_uid, SessionRuntimeControlKindV1.Geometry,
                request.unwrap().nonce, request.unwrap().lease.revision, target.unwrap().target, sosix_time_now_monotonic_ms())
            owner.controls = checked.owner
            if checked.error != "" or checked.lease.is_none(): stop = true
            else:
                var current = request.unwrap()
                current.lease = checked.lease.unwrap()
                current.target = target.unwrap().target
                val same = container_primary_geometry_request_same_v1(request.unwrap(), current)
                if same.is_err() or not same.unwrap(): stop = true
    val turn = if stop:
        smux_connection_geometry_cancel_v5(owner.domain, state, "runtime-geometry-authority-retired")
    else:
        smux_connection_geometry_step_v5(owner.domain, entry.task.unwrap(), resolved.unwrap().session, state, request.unwrap())
    owner.domain = turn.domain
    entry.geometry = Some(turn.state)
    owner.entries[index] = entry
    owner

pub fn smux_runtime_connection_geometry_observe_v5(owner: SmuxRuntimeConnectionOwnerV5,
        uid: text) -> SmuxRuntimeConnectionGeometryTurnV5:
    val index = index_v5(owner, uid)
    if index < 0: return geometry_reply_v5(owner, index, 0, "", "runtime-connection-binding-unavailable")
    val state = owner.entries[index].geometry
    geometry_reply_v5(owner, index, 0, "", if state == nil: "runtime-geometry-no-attempt" else: state.unwrap().error_v5())

pub fn smux_runtime_connection_geometry_cancel_v5(original: SmuxRuntimeConnectionOwnerV5,
        uid: text, expected_revision: i64?) -> SmuxRuntimeConnectionGeometryTurnV5:
    val index = index_v5(original, uid)
    if index < 0: return geometry_reply_v5(original, index, 0, "", "runtime-connection-binding-unavailable")
    var owner = original
    val record = smux_runtime_control_find_v1(owner.controls, uid, SessionRuntimeControlKindV1.Geometry)
    val revision = expected_revision ?? (if record == nil: 0 else: record.unwrap().lease.revision)
    if record != nil:
        val retired = smux_runtime_control_revoke_v1(owner.controls, uid, SessionRuntimeControlKindV1.Geometry,
            revision, sosix_time_now_monotonic_ms())
        owner.controls = retired.owner
        if retired.error != "": return geometry_reply_v5(owner, index, retired.revision, "", retired.error)
    elif expected_revision != nil: return geometry_reply_v5(owner, index, revision, "", "runtime-geometry-lease-unavailable")
    owner = geometry_step_v5(owner, index, true)
    val state = owner.entries[index].geometry
    geometry_reply_v5(owner, index, revision, "", if state == nil: "" else: state.unwrap().error_v5())

pub struct SmuxConnectionCapabilitiesV5:
    available: bool
    input_allowed: bool
    geometry_allowed: bool

pub fn smux_runtime_connection_capabilities_v5(owner: SmuxRuntimeConnectionOwnerV5) -> SmuxConnectionCapabilitiesV5:
    match owner.domain.local:
        case HostLocalRootV3.LinuxService(service):
            if owner.closing: return SmuxConnectionCapabilitiesV5(false, false, false)
            val loaded = smux_runtime_connection_policy_load_v5(owner.domain.local)
            if loaded.is_err() or loaded.unwrap().allowed != owner.controls.policy.allowed:
                return SmuxConnectionCapabilitiesV5(false, false, false)
            # Input only while the controller-signed terminal authority verifies NOW; Geometry is never offered on V4.
            val live = host_linux_service_agent_terminal_authority_v4(service).is_ok()
            return SmuxConnectionCapabilitiesV5(live, live and loaded.unwrap().allowed.contains(SessionRuntimeControlKindV1.Input), false)
        case _: pass
    if owner.closing or not host_primary_connection_supported_v3(owner.domain.local):
        return SmuxConnectionCapabilitiesV5(false, false, false)
    val policy = smux_runtime_connection_policy_load_v5(owner.domain.local)
    if policy.is_err(): return SmuxConnectionCapabilitiesV5(false, false, false)
    val current = policy.unwrap()
    if (current.principal_id != owner.controls.policy.principal_id or current.allowed != owner.controls.policy.allowed or
            current.max_lease_ms != owner.controls.policy.max_lease_ms): return SmuxConnectionCapabilitiesV5(false, false, false)
    SmuxConnectionCapabilitiesV5(true, current.allowed.contains(SessionRuntimeControlKindV1.Input),
        current.allowed.contains(SessionRuntimeControlKindV1.Geometry))
