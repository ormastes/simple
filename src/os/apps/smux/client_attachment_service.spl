# Explicit-state attachment transforms. API publishes; no registry lives here.
use os.apps.smux.service.{ServiceState}
use os.apps.smux.contract.{MuxClientAttachment}
use os.apps.smux.client_context_service.{client_context_put}
use os.apps.smux.client_leases.{ClientLeaseState, smux_leases_new, smux_lease_admit,
    smux_lease_heartbeat, smux_lease_expiry_candidates, smux_lease_expire}
use std.sosix.entropy.{sosix_random_hex}

pub struct ClientAttachmentUpdate:
    state: ServiceState
    leases: ClientLeaseState
    token: text
    removed: int
    cleared: [MuxClientAttachment]

pub fn client_attachment_index(st: ServiceState, session: text, client: text) -> int:
    val idx = st.find_client_idx(client)
    if idx < 0 or st.get_client(idx).session_id != session: return -1
    return idx

fn canvas_valid(cols: int, rows: int) -> bool:
    return cols > 0 and cols <= 512 and rows > 0 and rows <= 256 and cols * rows <= 60000

pub fn client_attach_leased(st: ServiceState, leases: ClientLeaseState, closing: bool,
    session: text, client: text, cols: int, rows: int, now_ms: i64) -> Result<ClientAttachmentUpdate, text>:
    if closing or st.find_session_idx(session) < 0: return Err("client lease session unavailable")
    if client == "" or not canvas_valid(cols, rows): return Err("client lease target or dimensions invalid")
    val idx = st.find_client_idx(client)
    if idx < 0 and st.client_count >= 4: return Err("client attachment capacity reached")
    var owner = leases
    if owner.owner_nonce == "":
        val raw = sosix_random_hex(16)
        if raw == nil: return Err("client lease secure entropy unavailable")
        val initialized = smux_leases_new(raw ?? "")
        if initialized.is_err(): return Err(initialized.unwrap_err())
        owner = initialized.unwrap()
    val admitted = smux_lease_admit(owner, session, client, now_ms)
    if admitted.is_err(): return Err(admitted.unwrap_err())
    var cleared: [MuxClientAttachment] = []
    if idx >= 0:
        cleared.push(st.get_client(idx))
    val attachment = MuxClientAttachment(client_id: client, session_id: session,
        attached: true, cols: cols, rows: rows,
        attachment_generation: admitted.unwrap().lease.generation)
    return Ok(ClientAttachmentUpdate(state: client_context_put(st, idx, attachment),
        leases: admitted.unwrap().state, token: admitted.unwrap().lease.token, removed: 0, cleared: cleared))

pub fn client_resize_leased(st: ServiceState, leases: ClientLeaseState, closing: bool,
    session: text, client: text, token: text, cols: int, rows: int, now_ms: i64) -> Result<ClientAttachmentUpdate, text>:
    if closing or not canvas_valid(cols, rows): return Err("client lease session or dimensions invalid")
    val idx = client_attachment_index(st, session, client)
    if idx < 0: return Err("client lease attachment unavailable")
    val renewed = smux_lease_heartbeat(leases, session, client, token, now_ms)
    if renewed.is_err(): return Err(renewed.unwrap_err())
    val attachment = MuxClientAttachment(client_id: client, session_id: session,
        attached: true, cols: cols, rows: rows,
        attachment_generation: st.get_client(idx).attachment_generation)
    return Ok(ClientAttachmentUpdate(state: client_context_put(st, idx, attachment),
        leases: renewed.unwrap(), token: token, removed: 0, cleared: []))

pub fn client_reap_expired(st: ServiceState, leases: ClientLeaseState, now_ms: i64) -> Result<ClientAttachmentUpdate, text>:
    val candidates = smux_lease_expiry_candidates(leases, now_ms)
    if candidates.is_err(): return Err(candidates.unwrap_err())
    var changed = st
    var owner = leases
    var cleared: [MuxClientAttachment] = []
    for candidate in candidates.unwrap():
        val expired = smux_lease_expire(owner, candidate.session_id, candidate.client_id, candidate.token, now_ms)
        if expired.is_ok():
            val idx = client_attachment_index(changed, candidate.session_id, candidate.client_id)
            if idx >= 0:
                cleared.push(changed.get_client(idx))
                changed = changed.remove_client(idx)
            owner = expired.unwrap()
    return Ok(ClientAttachmentUpdate(state: changed, leases: owner, token: "", removed: cleared.len(), cleared: cleared))

pub fn client_attach_unmanaged(st: ServiceState, leases: ClientLeaseState, closing: bool,
    session: text, client: text, cols: int, rows: int) -> Result<ClientAttachmentUpdate, text>:
    if closing or st.find_session_idx(session) < 0 or client == "" or cols <= 0 or rows <= 0:
        return Err("client attachment invalid")
    for lease in leases.leases:
        if lease.client_id == client: return Err("client attachment is leased")
    val idx = st.find_client_idx(client)
    if idx < 0 and st.client_count >= 4: return Err("client attachment capacity reached")
    var cleared: [MuxClientAttachment] = []
    if idx >= 0:
        if st.get_client(idx).session_id != session: cleared.push(st.get_client(idx))
    return Ok(ClientAttachmentUpdate(state: client_context_put(st, idx, MuxClientAttachment.create(client, session, cols, rows)),
        leases: leases, token: "", removed: 0, cleared: cleared))
