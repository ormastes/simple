# The SGR state applied to the next printed character.
pub struct VtPen:
    bold: bool
    dim: bool
    italic: bool
    underline: bool
    reverse: bool
    # "" default, else the SGR parameters selecting it ("31", "38;5;196",
    # "38;2;r;g;b"; the same with 4x/48 for the background).
    fg: text
    bg: text

# Terminal modes and the parser side-channels.
pub struct VtModes:
    cursor_visible: bool
    bracketed: bool
    pen: VtPen
    # Canonical SGR parameters of `pen` ("" = default), stored in each cell.
    pen_sgr: text
    # Bytes owed to the child in answer to queries, oldest first.
    replies: text
    # Leading bytes of the OSC string being parsed (enough to classify it).
    osc: text
    # DECCKM (?1): live child input mode, independent of visual snapshots.
    application_cursor: bool = false

# The main screen while the alternate screen is shown.
pub struct VtAlt:
    on: bool
    cells: [[text]]
    attrs: [[text]]
    wrapped: [bool]
    cell_loss: [[i64]]
    row: i64
    col: i64

pub struct VtScreen:
    rows: i64
    cols: i64
    cells: [[text]]
    # Per-cell canonical SGR parameters, parallel to `cells` ("" = default).
    attrs: [[text]]
    wrapped: [bool]
    cell_loss: [[i64]]
    row: i64
    col: i64
    saved_row: i64
    saved_col: i64
    # Scroll region, inclusive rows.
    top: i64
    bottom: i64
    # Escape-parser state, kept so a sequence split across two reads still
    # parses: 0 text, 1 after ESC, 2 CSI, 3 OSC, 4 DCS/APC/PM/SOS string,
    # 5 one designator byte to skip; 6 bounded malformed/oversized CSI discard.
    mode: i64
    params: text
    # Synchronized output (DEC mode 2026): while a program holds the mode set,
    # this is the last complete frame and captures show it instead of the
    # half-drawn `cells`. Empty when no frame is being drawn.
    frozen: [[text]]
    frozen_attrs: [[text]]
    frozen_wrapped: [bool]
    frozen_loss: [[i64]]
    frozen_row: i64
    frozen_col: i64
    frozen_cursor_visible: bool
    # Saved primary-screen cell rows; alternate output never appends here.
    history: [[text]]
    history_attrs: [[text]]
    history_wrapped: [bool]
    history_loss: [[i64]]
    history_limit: i64
    frozen_history: [[text]]
    frozen_history_attrs: [[text]]
    frozen_history_wrapped: [bool]
    frozen_history_loss: [[i64]]
    discarded_controls: u64
    # Reset for each operation; synchronized writes remain unpublished.
    capture_dirty: bool
    modes: VtModes
    alt: VtAlt
