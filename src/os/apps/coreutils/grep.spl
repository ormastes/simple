# Filesystem process entrypoint for the pure-Simple grep utility.

use os.apps.terminal.terminal.{Terminal}
use os.apps.coreutils.grep_vfs_adapter.{grep_process_vfs}
use os.tools.shell.grep.grep_tool.{tool_grep}

extern fn stdout_write(data: text)

fn main_grep(args: [text]) -> i32:
    var terminal = Terminal.new(80, 24)
    var vfs = grep_process_vfs()
    val exit_code = tool_grep(vfs, "/", args, terminal)
    stdout_write(terminal.take_mirrored_output())
    exit_code

export main_grep
