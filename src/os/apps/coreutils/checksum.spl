# Filesystem process entrypoints for the pure-Simple checksum utilities.
#
# Both entrypoints delegate all parsing, bounded VFS reads, hashing, and exit
# behavior to the canonical checksum owner. This file only bridges the tool's
# Terminal output to process stdout.

use os.apps.terminal.terminal.{Terminal}
use os.apps.coreutils.checksum_vfs_adapter.{checksum_process_vfs}
use os.tools.shell.checksum.checksum_tool.{tool_md5sum, tool_sha256sum}

extern fn stdout_write(data: text)

fn _checksum_emit_process_output(output: text):
    stdout_write(output)

fn main_sha256sum(args: [text]) -> i32:
    var terminal = Terminal.new(80, 24)
    var vfs = checksum_process_vfs()
    val exit_code = tool_sha256sum(vfs, "/", args, terminal)
    _checksum_emit_process_output(terminal.take_mirrored_output())
    exit_code

fn main_md5sum(args: [text]) -> i32:
    var terminal = Terminal.new(80, 24)
    var vfs = checksum_process_vfs()
    val exit_code = tool_md5sum(vfs, "/", args, terminal)
    _checksum_emit_process_output(terminal.take_mirrored_output())
    exit_code

export main_sha256sum, main_md5sum
