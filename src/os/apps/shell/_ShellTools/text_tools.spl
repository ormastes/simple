# Text/file tools: path helpers, staged-toolchain detection, touch/head/tail/wc/sort
use os.apps.shell.shell_tools.*
#![allow(unnamed_duplicate_typed_args)]
# Shell Extended Tools
#
# Additional built-in commands for the SimpleOS shell.
# Each tool is a standalone function returning an i32 exit code.
#
# MDSOC: feature dimension, shell layer

use os.apps.terminal.terminal.{Terminal}
use os.kernel.types.fs_types.{FsNode, FsNodeKind}
use os.services.vfs.vfs.{VfsManager}
use os.tools.tool_registry.{ToolRegistry}

# =========================================================================
# Path Resolution (shared helper)
# =========================================================================

fn _resolve_tool_path(cwd: text, path: text) -> text:
    """Resolve a relative path against cwd for tool use."""
    if path.starts_with("/"):
        return _normalize(path)
    if path == "..":
        return _parent(cwd)
    if path == ".":
        return cwd
    val full = if cwd == "/": "/{path}" else: "{cwd}/{path}"
    return _normalize(full)

fn _normalize(path: text) -> text:
    """Normalize path by resolving . and .. components."""
    var parts: [text] = []
    var current = ""
    for ch in path:
        if ch == "/":
            if current == "..":
                if parts.len() > 0:
                    var new_parts: [text] = []
                    var j = 0
                    while j < parts.len() - 1:
                        new_parts = new_parts.push(parts[j])
                        j = j + 1
                    parts = new_parts
            elif current != "." and current != "":
                parts = parts.push(current)
            current = ""
        else:
            current = "{current}{ch}"
    if current == "..":
        if parts.len() > 0:
            var new_parts: [text] = []
            var j = 0
            while j < parts.len() - 1:
                new_parts = new_parts.push(parts[j])
                j = j + 1
            parts = new_parts
    elif current != "." and current != "":
        parts = parts.push(current)
    if parts.len() == 0:
        return "/"
    var result = ""
    for part in parts:
        result = "{result}/{part}"
    return result

fn _parent(path: text) -> text:
    """Get parent directory of a path."""
    if path == "/":
        return "/"
    var last_slash = 0
    var i = 0
    for ch in path:
        if ch == "/":
            last_slash = i
        i = i + 1
    if last_slash == 0:
        return "/"
    return path.slice(0, last_slash)

# =========================================================================
# Output Helpers
# =========================================================================

fn _write_line(terminal: Terminal, line: text):
    """Write a line with newline to terminal."""
    terminal.write_string("{line}\n")

fn _write_error(terminal: Terminal, msg: text):
    """Write an error message in red."""
    val esc = "\u{001b}"
    terminal.write_string("{esc}[31m{msg}{esc}[0m\n")

fn _parse_int(s: text) -> i32:
    """Parse an i32 from text, returning -1 on failure."""
    var result: i32 = 0
    var found_digit = false
    for ch in s:
        if ch >= "0" and ch <= "9":
            val digit = ch.to_i32() - "0".to_i32()
            result = result * 10 + digit
            found_digit = true
        else:
            return -1
    if not found_digit:
        return -1
    return result

fn _split_text_on(content: text, delimiter: text) -> [text]:
    """Split text on a single-character delimiter without relying on text.split."""
    var parts: [text] = []
    var current = ""
    val terminated = "{content}{delimiter}"
    for ch in terminated:
        if ch == delimiter:
            parts = parts.push(current)
            current = ""
        else:
            current = "{current}{ch}"
    return parts

fn _split_lines(content: text) -> [text]:
    return _split_text_on(content, "\n")

fn _split_spaces(content: text) -> [text]:
    return _split_text_on(content, " ")

fn _tool_env_value(env_pairs: [(text, text)], key: text, default_value: text) -> text:
    for pair in env_pairs:
        if pair.0 == key:
            return pair.1
    default_value

fn _tool_path_candidates(command: text, cwd: text, path_env: text) -> [text]:
    if command == "":
        return []
    if command.contains("/"):
        return [_resolve_tool_path(cwd, command)]
    var candidates: [text] = []
    for raw_dir in _split_text_on(path_env, ":"):
        val dir = raw_dir.trim()
        if dir == "":
            continue
        if dir == "/":
            candidates = candidates.push("/{command}")
        else:
            candidates = candidates.push(_normalize("{dir}/{command}"))
    candidates

struct ToolchainManifestPaths:
    version_path: text
    manifest_path: text
    canonical_path: text

fn _toolchain_manifest_paths(command: text) -> ToolchainManifestPaths:
    match command:
        "cmake":
            ToolchainManifestPaths(version_path: "/SYS/CMAKEVER.TXT", manifest_path: "/SYS/CMAKEMAN.TXT", canonical_path: "/usr/bin/cmake")
        "clang":
            ToolchainManifestPaths(version_path: "/SYS/CLANGVER.TXT", manifest_path: "/SYS/CLANGMAN.TXT", canonical_path: "/usr/bin/clang")
        "clang-20":
            ToolchainManifestPaths(version_path: "/SYS/CLANGVER.TXT", manifest_path: "/SYS/CLANGMAN.TXT", canonical_path: "/usr/bin/clang-20")
        "lld":
            ToolchainManifestPaths(version_path: "/SYS/LLVMVER.TXT", manifest_path: "/SYS/LLVMMAN.TXT", canonical_path: "/usr/bin/lld")
        "ld.lld":
            ToolchainManifestPaths(version_path: "/SYS/LLVMVER.TXT", manifest_path: "/SYS/LLVMMAN.TXT", canonical_path: "/usr/bin/ld.lld")
        "llvm-ar":
            ToolchainManifestPaths(version_path: "/SYS/LLVMVER.TXT", manifest_path: "/SYS/LLVMMAN.TXT", canonical_path: "/usr/bin/llvm-ar")
        "llvm-nm":
            ToolchainManifestPaths(version_path: "/SYS/LLVMVER.TXT", manifest_path: "/SYS/LLVMMAN.TXT", canonical_path: "/usr/bin/llvm-nm")
        "llvm-ranlib":
            ToolchainManifestPaths(version_path: "/SYS/LLVMVER.TXT", manifest_path: "/SYS/LLVMMAN.TXT", canonical_path: "/usr/bin/llvm-ranlib")
        "llvm-objdump":
            ToolchainManifestPaths(version_path: "/SYS/LLVMVER.TXT", manifest_path: "/SYS/LLVMMAN.TXT", canonical_path: "/usr/bin/llvm-objdump")
        "llvm-objcopy":
            ToolchainManifestPaths(version_path: "/SYS/LLVMVER.TXT", manifest_path: "/SYS/LLVMMAN.TXT", canonical_path: "/usr/bin/llvm-objcopy")
        "llvm-strip":
            ToolchainManifestPaths(version_path: "/SYS/LLVMVER.TXT", manifest_path: "/SYS/LLVMMAN.TXT", canonical_path: "/usr/bin/llvm-strip")
        "rustc":
            ToolchainManifestPaths(version_path: "/SYS/RUSTVER.TXT", manifest_path: "/SYS/RUSTMAN.TXT", canonical_path: "/usr/bin/rustc")
        "cargo":
            ToolchainManifestPaths(version_path: "/SYS/CARGOVER.TXT", manifest_path: "/SYS/RUSTMAN.TXT", canonical_path: "/usr/bin/cargo")
        "cargo-simpleos":
            ToolchainManifestPaths(version_path: "/SYS/CARGOVER.TXT", manifest_path: "/SYS/RUSTMAN.TXT", canonical_path: "/usr/bin/cargo-simpleos")
        "ninja":
            ToolchainManifestPaths(version_path: "/SYS/NINJAVER.TXT", manifest_path: "/SYS/NINJAMAN.TXT", canonical_path: "/usr/bin/ninja")
        _:
            ToolchainManifestPaths(version_path: "", manifest_path: "", canonical_path: "")

fn _toolchain_command_supported(command: text) -> bool:
    val paths = _toolchain_manifest_paths(command)
    paths.version_path != ""

fn toolchain_canonical_path(command: text) -> text:
    """Return the fixed guest filesystem path for a known toolchain command."""
    _toolchain_manifest_paths(command).canonical_path

fn tool_try_staged_toolchain(vfs: VfsManager?, _cwd: text, _path_env: text,
                             command: text, args: [text], terminal: Terminal) -> i32?:
    """Report diagnostic-only package metadata without claiming tool success.

    Normal toolchain invocations must return `nil` so the shell launches the
    canonical guest executable. Manifest/version text is not execution evidence
    and must never produce a successful command status.
    """
    if not _toolchain_command_supported(command):
        return nil
    val paths = _toolchain_manifest_paths(command)
    if vfs == nil:
        return nil
    val payload_stat = vfs.stat(paths.canonical_path)
    if payload_stat.is_err():
        return nil
    val payload_kind = payload_stat.unwrap().kind
    if payload_kind != FsNodeKind.File:
        return nil
    if args.len() != 2 or args[0] != "--print" or args[1] != "simpleos-wrapper-status":
        return nil

    _write_line(terminal, "manifest={paths.manifest_path}")
    _write_line(terminal, "payload={paths.canonical_path}")
    _write_line(terminal, "diagnostic-only=true")
    _write_line(terminal, "capability-authorized=false")
    _write_error(terminal, "{command}: metadata is not execution evidence")
    78

# =========================================================================
# touch — Create empty files or update timestamps
# =========================================================================

fn tool_touch(vfs: VfsManager?, cwd: text, args: [text]) -> i32:
    """Create empty files. If file exists, this is a no-op (no timestamp update in VFS yet)."""
    if args.len() == 0:
        return 1
    if vfs == nil:
        return 1
    var exit_code: i32 = 0
    for filename in args:
        val path = _resolve_tool_path(cwd, filename)
        # Check if file already exists
        val stat_result = vfs.stat(path)
        if stat_result.is_ok():
            # File exists — would update timestamp but VFS doesn't support it yet
            pass_dn
        else:
            # Create empty file by writing empty content
            val write_result = vfs.write_text(path, "")
            if write_result.is_err():
                exit_code = 1
    return exit_code

# =========================================================================
# head — Show first N lines of a file
# =========================================================================

fn tool_head(vfs: VfsManager?, cwd: text, args: [text], terminal: Terminal) -> i32:
    """Show first N lines of a file (default 10)."""
    if vfs == nil:
        _write_error(terminal, "head: no filesystem mounted")
        return 1
    var n: i32 = 10
    var file_path: text = ""

    # Parse args: [-n N] FILE
    var i = 0
    while i < args.len():
        if args[i] == "-n" and i + 1 < args.len():
            val parsed = _parse_int(args[i + 1])
            if parsed > 0:
                n = parsed
            i = i + 2
        else:
            file_path = args[i]
            i = i + 1

    if file_path == "":
        _write_error(terminal, "head: missing file operand")
        return 1

    val path = _resolve_tool_path(cwd, file_path)
    val result = vfs.read_text(path)
    if result.is_err():
        _write_error(terminal, "head: {path}: {result.unwrap_err()}")
        return 1

    val content = result.unwrap()
    val lines = _split_lines(content)
    var count: i32 = 0
    for line in lines:
        if count >= n:
            return 0
        _write_line(terminal, line)
        count = count + 1
    return 0

# =========================================================================
# tail — Show last N lines of a file
# =========================================================================

fn tool_tail(vfs: VfsManager?, cwd: text, args: [text], terminal: Terminal) -> i32:
    """Show last N lines of a file (default 10)."""
    if vfs == nil:
        _write_error(terminal, "tail: no filesystem mounted")
        return 1
    var n: i32 = 10
    var file_path: text = ""

    # Parse args: [-n N] FILE
    var i = 0
    while i < args.len():
        if args[i] == "-n" and i + 1 < args.len():
            val parsed = _parse_int(args[i + 1])
            if parsed > 0:
                n = parsed
            i = i + 2
        else:
            file_path = args[i]
            i = i + 1

    if file_path == "":
        _write_error(terminal, "tail: missing file operand")
        return 1

    val path = _resolve_tool_path(cwd, file_path)
    val result = vfs.read_text(path)
    if result.is_err():
        _write_error(terminal, "tail: {path}: {result.unwrap_err()}")
        return 1

    val content = result.unwrap()
    val lines = _split_lines(content)
    val total = lines.len() as i32
    val start = if total > n: total - n else: 0
    var idx: i32 = 0
    for line in lines:
        if idx >= start:
            _write_line(terminal, line)
        idx = idx + 1
    return 0

# =========================================================================
# wc — Word/line/char count
# =========================================================================

fn tool_wc(vfs: VfsManager?, cwd: text, args: [text], terminal: Terminal) -> i32:
    """Count lines, words, and characters in files."""
    if vfs == nil:
        _write_error(terminal, "wc: no filesystem mounted")
        return 1

    # Parse flags
    var count_lines = false
    var count_words = false
    var count_chars = false
    var files: [text] = []

    for arg in args:
        if arg == "-l":
            count_lines = true
        elif arg == "-w":
            count_words = true
        elif arg == "-c":
            count_chars = true
        else:
            files = files.push(arg)

    # Default: show all counts
    if not count_lines and not count_words and not count_chars:
        count_lines = true
        count_words = true
        count_chars = true

    if files.len() == 0:
        _write_error(terminal, "wc: missing file operand")
        return 1

    var exit_code: i32 = 0
    var total_lines: i32 = 0
    var total_words: i32 = 0
    var total_chars: i32 = 0

    for filename in files:
        val path = _resolve_tool_path(cwd, filename)
        val result = vfs.read_text(path)
        if result.is_err():
            _write_error(terminal, "wc: {path}: {result.unwrap_err()}")
            exit_code = 1
        else:
            val content = result.unwrap()
            val lines = _split_lines(content)
            val num_lines = lines.len() as i32
            var num_words: i32 = 0
            for line in lines:
                # Count words by splitting on spaces
                val words = _split_spaces(line)
                for w in words:
                    if w.trim() != "":
                        num_words = num_words + 1
            val num_chars = content.len() as i32

            total_lines = total_lines + num_lines
            total_words = total_words + num_words
            total_chars = total_chars + num_chars

            var output = ""
            if count_lines:
                output = "  {num_lines}"
            if count_words:
                output = "{output}  {num_words}"
            if count_chars:
                output = "{output}  {num_chars}"
            _write_line(terminal, "{output}  {filename}")

    # Print total if multiple files
    if files.len() > 1:
        var output = ""
        if count_lines:
            output = "  {total_lines}"
        if count_words:
            output = "{output}  {total_words}"
        if count_chars:
            output = "{output}  {total_chars}"
        _write_line(terminal, "{output}  total")

    return exit_code

# =========================================================================
# sort — Sort lines alphabetically
# =========================================================================

fn tool_sort(vfs: VfsManager?, cwd: text, args: [text], terminal: Terminal) -> i32:
    """Sort lines of a file alphabetically."""
    if vfs == nil:
        _write_error(terminal, "sort: no filesystem mounted")
        return 1
    if args.len() == 0:
        _write_error(terminal, "sort: missing file operand")
        return 1

    val path = _resolve_tool_path(cwd, args[0])
    val result = vfs.read_text(path)
    if result.is_err():
        _write_error(terminal, "sort: {path}: {result.unwrap_err()}")
        return 1

    val content = result.unwrap()
    val lines = _split_lines(content)

    # Simple insertion sort (adequate for shell use)
    var sorted: [text] = []
    for line in lines:
        sorted = _insert_sorted(sorted, line)
    for s in sorted:
        _write_line(terminal, s)
    return 0
