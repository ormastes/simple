# Pure PATH planning. Presence and bytes belong to the authenticated loader;
# neither an existence probe nor a byte read is allowed during name planning.

pub struct ShellPathPlan:
    directories: [text]

fn _shell_path_clean(path: text) -> bool:
    if not path.starts_with("/") or path.contains("//") or path.contains("\\") or path.contains("\0"):
        return false
    for component in path.split("/"):
        if component == "." or component == "..": return false
    true

pub fn shell_path_plan(path_env: text) -> ShellPathPlan:
    """Retain only absolute, traversal-free directories, in PATH order."""
    var directories: [text] = []
    for dir in path_env.split(":"):
        if _shell_path_clean(dir): directories.push(dir)
    ShellPathPlan(directories: directories)

pub fn shell_path_candidates(plan: ShellPathPlan, command: text) -> [text]:
    """Construct names without querying a filesystem or revealing presence."""
    if command == "" or command.contains("\0") or command.contains("\\"):
        return []
    if command.contains("/"):
        if _shell_path_clean(command): return [command]
        return []
    if command == "." or command == "..": return []
    var candidates: [text] = []
    for dir in plan.directories:
        val separator = if dir.ends_with("/"): "" else: "/"
        candidates.push(dir + separator + command)
    candidates

pub fn shell_path_resolve_snapshot(plan: ShellPathPlan, command: text, authorized_paths: [text]) -> text?:
    """Select from a caller-authorized snapshot; never acquire one implicitly."""
    for candidate in shell_path_candidates(plan, command):
        if authorized_paths.contains(candidate): return Some(candidate)
    nil
