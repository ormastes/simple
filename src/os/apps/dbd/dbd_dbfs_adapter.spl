# Typed DBFS persistence adapter for the SimpleOS database daemon.
#
# A device-backed DbFsDriver now owns namespace persistence and an acknowledged
# BlockDevice flush.  This adapter admits only that typed capability; hosted
# and otherwise unserialized drivers remain useful for diagnostics but can
# never make the daemon ready.

use std.db.dbfs_driver.dbfs_driver.{DbFsDriver}
use std.fs_driver.instance.{DriverInstance}
use std.fs_driver.types.{Path, OpenFlags}
use std.fs_driver.error.{FsError}
use std.common.contracts.os.server_data_namespace_v1.{
    SERVER_DATA_DATABASE_ROOT_PATH_V1
}
use os.userlib.fs.{
    file_open_direct, file_read_direct, file_write_direct, file_close_direct,
    file_sync_direct, file_rename_direct, file_fstat_bounded
}
use os.services.vfs.dbfs_mount_capability.{
    dbfs_vfs_mount_capability_snapshot_v1,
    dbfs_vfs_mount_capability_snapshot_current_v1
}
use std.common.hash.adler32.{adler32}

pub val DBD_DBFS_MAX_RECOVERY_BYTES: i64 = 1024 * 1024
pub val DBD_DBFS_STORAGE_ROOT_V1: text = SERVER_DATA_DATABASE_ROOT_PATH_V1
pub val DBD_DBFS_JOURNAL_PATH_V1: text = DBD_DBFS_STORAGE_ROOT_V1 + "/DBD.LOG"
pub val DBD_DBFS_QUARANTINE_PATH_V1: text =
    DBD_DBFS_STORAGE_ROOT_V1 + "/DBD.LOG.QUARANTINE"
val DBD_DBFS_MAX_GENERATION: i64 = 9223372036854775807
val DBD_DBFS_EXCLUSIVE_OPEN_COLLISION_V1: text = "open failed with code -17"
# A power loss can leave an unreachable exclusive staging name behind.  Probe
# only a small fixed number of later generation names so restart recovery does
# not turn that stale inode into a permanent durable-write denial of service.
val DBD_DBFS_MAX_STAGING_OPEN_ATTEMPTS_V1: i64 = 64

pub fn dbd_dbfs_temp_path_v1(generation: i64) -> text:
    if generation <= 0 or generation >= DBD_DBFS_MAX_GENERATION:
        return ""
    DBD_DBFS_STORAGE_ROOT_V1 + "/DBD.LOG.NEW." + generation.to_text()

pub enum DbdDbfsAdapterState:
    Detached
    MountedSyncUnsupported
    MountedDurable
    Quarantined
    Closed

pub struct DbdDbfsCommitReceiptV1:
    """Evidence returned only after durable publication and exact readback."""
    driver_instance_id: i64
    mount_generation: u64
    commit_generation: i64
    byte_count: i64
    checksum: i64

pub class DbdDbfsAdapter:
    state: DbdDbfsAdapterState
    driver: DbFsDriver?
    driver_instance_id: i64
    generation: i64
    open_handles: i64
    last_error: text
    filesystem_vfs: bool
    filesystem_vfs_transactional_replace: bool
    filesystem_vfs_generation: u64

    me verification_handle_acquired_v1():
        self.open_handles = self.open_handles + 1

    me finish_postflush_verification_v1(
        size_matches: bool, read_matches: bool, close_succeeded: bool
    ) -> Result<(), text>:
        if close_succeeded:
            self.open_handles = self.open_handles - 1
        else:
            # Retain the lease count: the backing owner still owns a handle
            # whose release was not proved. close/reset remain unavailable.
            self.state = DbdDbfsAdapterState.Quarantined
            self.last_error = "dbfs-commit-postflush-verify-close-failed"
            return Err(self.last_error)
        if not size_matches or not read_matches:
            self.state = DbdDbfsAdapterState.Quarantined
            self.last_error = "dbfs-commit-postflush-verify-failed"
            return Err(self.last_error)
        Ok(())

    pub static fn detached(reason: text) -> DbdDbfsAdapter:
        DbdDbfsAdapter(
            state: DbdDbfsAdapterState.Detached,
            driver: nil,
            driver_instance_id: 0,
            generation: 1,
            open_handles: 0,
            last_error: reason,
            filesystem_vfs: false,
            filesystem_vfs_transactional_replace: false,
            filesystem_vfs_generation: 0u64
        )

    fn filesystem_vfs_mount_current() -> bool:
        if not self.filesystem_vfs or self.filesystem_vfs_generation == 0u64:
            return false
        val snapshot = dbfs_vfs_mount_capability_snapshot_v1()
        snapshot.code == 1 and
            snapshot.generation == self.filesystem_vfs_generation

    pub fn ready() -> bool:
        # No caller-controlled flag can promote this adapter.  Readiness needs
        # a future concrete DBFS durable-sync owner and a new typed state.
        match self.state:
            case DbdDbfsAdapterState.Detached: false
            case DbdDbfsAdapterState.MountedSyncUnsupported: false
            case DbdDbfsAdapterState.MountedDurable:
                not self.filesystem_vfs or self.filesystem_vfs_mount_current()
            case DbdDbfsAdapterState.Quarantined: false
            case DbdDbfsAdapterState.Closed: false

    pub fn blocker() -> text:
        match self.state:
            case DbdDbfsAdapterState.Detached:
                if self.last_error != "": self.last_error else: "dbfs-root-driver-unavailable"
            case DbdDbfsAdapterState.MountedSyncUnsupported:
                if self.last_error != "": self.last_error else: "dbfs-durable-sync-unavailable"
            case DbdDbfsAdapterState.MountedDurable:
                if self.filesystem_vfs and not self.filesystem_vfs_mount_current():
                    "dbfs-vfs-mount-generation-stale"
                else:
                    ""
            case DbdDbfsAdapterState.Quarantined:
                if self.last_error != "": self.last_error else: "dbfs-adapter-quarantined"
            case DbdDbfsAdapterState.Closed:
                "dbfs-adapter-closed"

    pub me read_existing_bounded(path: text, max_bytes: i64) -> Result<[u8], text>:
        if self.state != DbdDbfsAdapterState.MountedSyncUnsupported and
            self.state != DbdDbfsAdapterState.MountedDurable:
            return Err(self.blocker())
        if self.filesystem_vfs and not self.filesystem_vfs_mount_current():
            return Err("dbfs-vfs-mount-generation-stale")
        if path != DBD_DBFS_JOURNAL_PATH_V1 or max_bytes <= 0 or
            max_bytes > DBD_DBFS_MAX_RECOVERY_BYTES:
            return Err("dbfs-recovery-read-invalid-boundary")
        if self.filesystem_vfs:
            val opened = file_open_direct(path, 0u32)
            if opened.is_err(): return Err("dbfs-recovery-journal-not-found")
            val fd = opened.unwrap()
            # Bind recovery to the opened inode's exact length.  Reading only
            # `max_bytes` could accept a valid checksummed prefix of an
            # oversized journal, while accepting a short descriptor read
            # could silently discard durable tail records.  Transactional
            # replacement keeps this opened inode stable across publication.
            val stat = file_fstat_bounded(fd as u64)
            if stat.is_err():
                val _ = file_close_direct(fd)
                return Err("dbfs-recovery-stat-failed")
            val size = stat.unwrap().size
            if size > max_bytes.to_u64():
                val _ = file_close_direct(fd)
                return Err("dbfs-recovery-journal-too-large")
            if size == 0u64:
                if not file_close_direct(fd):
                    self.state = DbdDbfsAdapterState.Quarantined
                    self.last_error = "dbfs-recovery-close-failed"
                    return Err(self.last_error)
                if not self.filesystem_vfs_mount_current():
                    return Err("dbfs-vfs-mount-changed-during-recovery")
                return Ok([])
            val read = file_read_direct(fd, size)
            if not file_close_direct(fd):
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-recovery-close-failed"
                return Err(self.last_error)
            if read.is_err(): return Err("dbfs-recovery-read-failed")
            if read.unwrap().len() != size:
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-recovery-short-read"
                return Err(self.last_error)
            if not self.filesystem_vfs_mount_current():
                return Err("dbfs-vfs-mount-changed-during-recovery")
            return read
        val driver = match self.driver:
            Some(value): value
            nil: return Err("dbfs-root-driver-unavailable")
        val stat = driver.stat_path(Path(raw: path))
        if stat.is_err():
            return Err("dbfs-recovery-journal-not-found")
        val size = stat.unwrap().size
        if size < 0 or size > max_bytes:
            return Err("dbfs-recovery-journal-too-large")
        val opened = driver.open_path(Path(raw: path), OpenFlags.read_only())
        if opened.is_err():
            return Err("dbfs-recovery-open-failed")
        val handle = opened.unwrap()
        self.open_handles = self.open_handles + 1
        val read = driver.read_bytes_handle(handle, size)
        val closed = driver.close_handle(handle)
        if closed.is_err():
            # The backend may still own the handle.  Retain the lease count so
            # close/reset cannot discard the driver and conceal the leak.
            self.state = DbdDbfsAdapterState.Quarantined
            self.last_error = "dbfs-recovery-close-failed"
            return Err(self.last_error)
        self.open_handles = self.open_handles - 1
        if read.is_err():
            return Err("dbfs-recovery-read-failed")
        val bytes = read.unwrap()
        if bytes.len().to_i64() != size:
            self.state = DbdDbfsAdapterState.Quarantined
            self.last_error = "dbfs-recovery-short-read"
            return Err(self.last_error)
        Ok(bytes)

    pub me commit_and_sync(path: text, bytes: [u8]) -> Result<DbdDbfsCommitReceiptV1, text>:
        if self.state != DbdDbfsAdapterState.MountedDurable:
            return Err(self.blocker())
        if self.filesystem_vfs and not self.filesystem_vfs_mount_current():
            return Err("dbfs-vfs-mount-generation-stale")
        if path != DBD_DBFS_JOURNAL_PATH_V1 or bytes.len().to_i64() <= 0 or
            bytes.len().to_i64() > DBD_DBFS_MAX_RECOVERY_BYTES:
            return Err("dbfs-commit-invalid-boundary")
        if self.filesystem_vfs:
            if not self.filesystem_vfs_transactional_replace:
                return Err("dbfs-vfs-transactional-replace-unavailable")
            if self.generation <= 0 or self.generation >= DBD_DBFS_MAX_GENERATION:
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-commit-generation-exhausted"
                return Err(self.last_error)
            # An exclusive name prevents concurrent owners from truncating or
            # substituting the same staging inode.  Publication still relies
            # on the DBFS transactional-replace owner for serialization.
            var temp_path = dbd_dbfs_temp_path_v1(self.generation)
            var opened = file_open_direct(temp_path, 0xC1u32)
            var open_attempts: i64 = 1
            while (opened.is_err() and
                opened.unwrap_err() == DBD_DBFS_EXCLUSIVE_OPEN_COLLISION_V1 and
                open_attempts < DBD_DBFS_MAX_STAGING_OPEN_ATTEMPTS_V1):
                if self.generation >= DBD_DBFS_MAX_GENERATION - 1:
                    self.state = DbdDbfsAdapterState.Quarantined
                    self.last_error = "dbfs-commit-generation-exhausted"
                    return Err(self.last_error)
                self.generation = self.generation + 1
                temp_path = dbd_dbfs_temp_path_v1(self.generation)
                opened = file_open_direct(temp_path, 0xC1u32)
                open_attempts = open_attempts + 1
            if opened.is_err():
                if opened.unwrap_err() == DBD_DBFS_EXCLUSIVE_OPEN_COLLISION_V1:
                    return Err("dbfs-commit-staging-name-unavailable")
                return Err("dbfs-commit-open-failed")
            val fd = opened.unwrap()
            val written = file_write_direct(fd, bytes)
            if written.is_err() or written.unwrap() != bytes.len().to_u64() or
                file_sync_direct(fd).is_err():
                val _ = file_close_direct(fd)
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-commit-sync-failed"
                return Err(self.last_error)
            if not file_close_direct(fd):
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-commit-staging-close-failed"
                return Err(self.last_error)
            if file_rename_direct(temp_path, path).is_err():
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-commit-transactional-replace-failed"
                return Err(self.last_error)
            val directory = file_open_direct(DBD_DBFS_STORAGE_ROOT_V1, 0u32)
            if directory.is_err() or file_sync_direct(directory.unwrap()).is_err():
                if directory.is_ok():
                    val _ = file_close_direct(directory.unwrap())
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-commit-namespace-sync-failed"
                return Err(self.last_error)
            if not file_close_direct(directory.unwrap()):
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-commit-namespace-close-failed"
                return Err(self.last_error)
            if not self.filesystem_vfs_mount_current():
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-vfs-mount-changed-during-commit"
                return Err(self.last_error)
            val verified = file_open_direct(path, 0u32)
            if verified.is_err():
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-commit-postflush-verify-open-failed"
                return Err(self.last_error)
            val verify_fd = verified.unwrap()
            val verify_stat = file_fstat_bounded(verify_fd as u64)
            val verify_read = if verify_stat.is_ok() and
                    verify_stat.unwrap().size == bytes.len().to_u64():
                file_read_direct(verify_fd, verify_stat.unwrap().size)
            else:
                Err("dbfs-commit-postflush-size-mismatch")
            val verify_closed = file_close_direct(verify_fd)
            if verify_read.is_err() or not verify_closed or verify_read.unwrap() != bytes:
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-commit-postflush-verify-failed"
                return Err(self.last_error)
            if not self.filesystem_vfs_mount_current():
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-vfs-mount-changed-during-verification"
                return Err(self.last_error)
            val committed_generation = self.generation
            self.generation = self.generation + 1
            return Ok(DbdDbfsCommitReceiptV1(
                driver_instance_id: 0,
                mount_generation: self.filesystem_vfs_generation,
                commit_generation: committed_generation,
                byte_count: bytes.len().to_i64(),
                checksum: adler32(bytes)))
        val driver = match self.driver:
            Some(value): value
            nil: return Err("dbfs-root-driver-unavailable")
        if not driver.transactional_replace_ready():
            return Err("dbfs-transactional-replace-unavailable")
        if self.generation <= 0 or self.generation >= DBD_DBFS_MAX_GENERATION:
            self.state = DbdDbfsAdapterState.Quarantined
            self.last_error = "dbfs-commit-generation-exhausted"
            return Err(self.last_error)
        # Never overwrite the durable journal inode in place. A power loss
        # during that write could leave neither the old nor the new journal
        # replayable. DBFS rename publishes a new namespace checkpoint under
        # the shared transaction owner; syncing the still-open inode after
        # rename makes that checkpoint durable before success is returned.
        # Truncation deliberately permits reuse of an unreachable staging
        # inode left by an interrupted commit after a service restart.
        val temp_path = dbd_dbfs_temp_path_v1(self.generation)
        val opened = driver.open_path(
            Path(raw: temp_path),
            OpenFlags.read_write().with_create().with_trunc())
        if opened.is_err(): return Err("dbfs-commit-open-failed")
        val handle = opened.unwrap()
        self.open_handles = self.open_handles + 1
        var published = false
        val written = driver.write_bytes_handle(handle, bytes)
        if written.is_err():
            self.state = DbdDbfsAdapterState.Quarantined
            self.last_error = "dbfs-commit-write-failed"
        elif driver.fsync(handle).is_err():
            self.state = DbdDbfsAdapterState.Quarantined
            self.last_error = "dbfs-commit-sync-failed"
        elif driver.rename_path(temp_path, path).is_err():
            self.state = DbdDbfsAdapterState.Quarantined
            self.last_error = "dbfs-commit-transactional-replace-failed"
        else:
            # Rename is the atomic publication point.  Remember it separately
            # from adapter state so a later close failure cannot turn an
            # earlier write/sync/rename rejection into an "outcome uncertain"
            # result that falsely implies the new journal may be visible.
            published = true
            if driver.fsync(handle).is_err():
                self.state = DbdDbfsAdapterState.Quarantined
                self.last_error = "dbfs-commit-namespace-sync-failed"
        val closed = driver.close_handle(handle)
        if closed.is_err():
            self.state = DbdDbfsAdapterState.Quarantined
            self.last_error = if published:
                "dbfs-commit-postpublish-close-failed"
            else:
                "dbfs-commit-staging-close-failed"
            return Err(self.last_error)
        self.open_handles = self.open_handles - 1
        if self.state == DbdDbfsAdapterState.Quarantined:
            return Err(self.last_error)
        val verify_open = driver.open_path(Path(raw: path), OpenFlags.read_only())
        if verify_open.is_err():
            self.state = DbdDbfsAdapterState.Quarantined
            self.last_error = "dbfs-commit-postflush-verify-open-failed"
            return Err(self.last_error)
        val verify_handle = verify_open.unwrap()
        self.verification_handle_acquired_v1()
        val verify_stat = driver.stat_path(Path(raw: path))
        val size_matches = (verify_stat.is_ok() and
            verify_stat.unwrap().size == bytes.len().to_i64())
        val verify_read = if size_matches:
            driver.read_bytes_handle(verify_handle, bytes.len().to_i64())
        else:
            Err(FsError.Corrupt)
        val verify_closed = driver.close_handle(verify_handle)
        val read_matches = verify_read.is_ok() and verify_read.unwrap() == bytes
        val verified = self.finish_postflush_verification_v1(
            size_matches, read_matches, verify_closed.is_ok())
        if verified.is_err(): return Err(verified.unwrap_err())
        val committed_generation = self.generation
        self.generation = self.generation + 1
        Ok(DbdDbfsCommitReceiptV1(
            driver_instance_id: self.driver_instance_id,
            mount_generation: 0u64,
            commit_generation: committed_generation,
            byte_count: bytes.len().to_i64(),
            checksum: adler32(bytes)))

    pub fn commit_outcome_uncertain() -> bool:
        """Whether the last failed commit crossed its atomic publish point.

        Once transactional rename succeeds, a later namespace-sync, close, or
        mount-generation failure cannot honestly be reported as an abort: the
        new journal name may already be visible and may survive restart.  The
        adapter remains quarantined, and this predicate lets the protocol
        distinguish that indeterminate result from failures before rename.
        """
        self.state == DbdDbfsAdapterState.Quarantined and (
            self.last_error == "dbfs-commit-namespace-sync-failed" or
            self.last_error == "dbfs-commit-namespace-close-failed" or
            self.last_error == "dbfs-vfs-mount-changed-during-commit" or
            self.last_error == "dbfs-vfs-mount-changed-during-verification" or
            self.last_error == "dbfs-commit-postpublish-close-failed" or
            self.last_error == "dbfs-commit-postflush-verify-open-failed" or
            self.last_error == "dbfs-commit-postflush-verify-close-failed" or
            self.last_error == "dbfs-commit-postflush-verify-failed")

    pub me quarantine(reason: text) -> bool:
        if reason.trim() == "" or self.open_handles != 0:
            return false
        self.state = DbdDbfsAdapterState.Quarantined
        self.last_error = reason
        true

    pub me close() -> bool:
        if self.open_handles != 0:
            return false
        self.driver = nil
        self.driver_instance_id = 0
        self.filesystem_vfs = false
        self.filesystem_vfs_transactional_replace = false
        self.filesystem_vfs_generation = 0u64
        self.state = DbdDbfsAdapterState.Closed
        true

    pub me reset_for_restart() -> bool:
        if self.open_handles != 0 or self.generation >= DBD_DBFS_MAX_GENERATION:
            return false
        val preserve_quarantine = self.state == DbdDbfsAdapterState.Quarantined
        self.driver = nil
        self.driver_instance_id = 0
        self.filesystem_vfs = false
        self.filesystem_vfs_transactional_replace = false
        self.filesystem_vfs_generation = 0u64
        self.generation = self.generation + 1
        if preserve_quarantine:
            # Restart may release the old driver owner, but it must not erase
            # the reason durable recovery was quarantined.  Only constructing
            # a newly discovered typed adapter starts a new admission attempt.
            self.state = DbdDbfsAdapterState.Quarantined
        else:
            self.state = DbdDbfsAdapterState.Detached
            self.last_error = "dbfs-root-driver-unavailable"
        true

pub struct DbdDbfsVerificationFailureProbeV1:
    adapter: DbdDbfsAdapter
    receipt: Option<DbdDbfsCommitReceiptV1>
    reason: text

pub fn dbd_dbfs_adapter_from_driver(driver: DriverInstance) -> DbdDbfsAdapter:
    match driver:
        case DriverInstance.DbFs(dbfs):
            val durable = dbfs.durability_serialization_ready() and
                dbfs.transactional_replace_ready()
            val mounted_state = if durable:
                DbdDbfsAdapterState.MountedDurable
            else:
                DbdDbfsAdapterState.MountedSyncUnsupported
            val mounted_error = if durable:
                ""
            else:
                if not dbfs.durability_serialization_ready():
                    "dbfs-" + dbfs.durability_serialization_blocker()
                else:
                    "dbfs-transactional-replace-unavailable"
            DbdDbfsAdapter(
                state: mounted_state,
                driver: Some(dbfs),
                driver_instance_id: dbfs.inst_id,
                generation: 1,
                open_handles: 0,
                last_error: mounted_error,
                filesystem_vfs: false,
                filesystem_vfs_transactional_replace: false,
                filesystem_vfs_generation: 0u64
            )
        case _:
            DbdDbfsAdapter.detached("mounted-root-is-not-dbfs")

pub fn dbd_dbfs_adapter_from_filesystem_vfs() -> DbdDbfsAdapter:
    """Fail closed until syscalls bind to the canonical mounted DBFS owner.

    The current filesystem-process file descriptors are registered by the
    FAT32 syscall table, while the capability snapshot describes a different
    in-kernel DBFS driver. A generation snapshot cannot bridge that authority
    mismatch, so this path must not mint a durable adapter or receipt.
    """
    DbdDbfsAdapter.detached("filesystem-vfs-dbfs-operation-authority-unavailable")

pub fn dbd_dbfs_verification_close_failure_probe_v1(
    source: DbdDbfsAdapter
) -> DbdDbfsVerificationFailureProbeV1:
    """Exercise the real negative verifier transition without minting authority.

    This diagnostic has no success input: it models a handle acquisition,
    failed stat/size verification, and failed close. Therefore it can only
    quarantine an adapter and can never construct a commit receipt.
    """
    var adapter = source
    adapter.verification_handle_acquired_v1()
    val failed = adapter.finish_postflush_verification_v1(false, false, false)
    DbdDbfsVerificationFailureProbeV1(
        adapter: adapter,
        receipt: None,
        reason: if failed.is_err(): failed.unwrap_err() else: "unexpected-success")
