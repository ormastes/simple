# dbd protocol core — pure, socket-free, VFS-free logic for the db daemon.
#
# Reuses the REAL Simple RESP server engine
# (std.nogc_sync_mut.redis.server.RedisServer, the same engine
# src/app/redis_server/main.spl runs hosted): parse_next_request handles the
# wire framing and RedisServer.dispatch handles command semantics. This
# module adds ONLY the durability seam RedisServer lacks (it is a pure
# in-memory store): a write-ahead journal of mutating commands that is
# replayed through the SAME RedisServer.dispatch() at startup. It never
# reimplements RESP parsing, SET/GET/DEL semantics, or reply framing.
#
# Everything here is pure (no rt_net_* externs, no VFS): the transport
# (src/os/apps/dbd/dbd.spl) supplies the socket + the VFS byte store, and
# specs drive these functions directly. That keeps the durable-KV behavior
# verifiable with `simple run <spec>` without a network or a mounted disk.

use std.nogc_sync_mut.redis.server.{RedisServer, parse_next_request}
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.common.base_encoding.base64.{base64_encode, base64_decode}

pub val DBD_MAX_JOURNAL_BYTES: i64 = 1024 * 1024
pub val DBD_MAX_JOURNAL_RECORDS: i64 = 4096
pub val DBD_MAX_JOURNAL_ARGS: i64 = 16
pub val DBD_MAX_JOURNAL_LINE_BYTES: i64 = 512
pub val DBD_MAX_SESSION_BYTES: i64 = 65536
pub val DBD_MAX_REQUESTS_PER_SESSION: i64 = 64
pub val DBD_MAX_RESPONSE_BYTES_PER_SESSION: i64 = 65536
pub val DBD_MAX_TRANSACTION_COMMANDS: i64 = 32
pub val DBD_MAX_TRANSACTION_BYTES: i64 = 16384
pub val DBD_MAX_PRINCIPAL_BYTES: i64 = 64
pub val DBD_MIN_CREDENTIAL_BYTES: i64 = 32
pub val DBD_MAX_CREDENTIAL_BYTES: i64 = 128
pub val DBD_MAX_AUTH_ATTEMPTS_PER_SESSION: i64 = 4
pub val DBD_BOOT_CREDENTIAL_OWNER_BLOCKER: text =
    "boot-mutable-credential-owner-unavailable"

val DBD_UNKNOWN_PRINCIPAL_DIGEST: text = sha256_text("dbd-unknown-principal")
val DBD_UNKNOWN_CREDENTIAL_DIGEST: text = sha256_text("dbd-unknown-credential")

# Owner-admission facts, not user configuration. DBD wires its bounded
# provisioning owner into tls13_accept, authenticates every application record
# before mutable-byte AUTH ingress, and retains only credential digests after
# provisioning. Boot credential and entropy owners are still absent, so the
# corresponding production gates remain false. Keeping these private prevents
# a socket caller from manufacturing a boolean "verified" claim.
val DBD_AUTH_FRAMING_OWNER_VERIFIED: bool = true
val DBD_AUTHENTICATION_OWNER_VERIFIED: bool = false
val DBD_TLS_OWNER_VERIFIED: bool = false
val DBD_DBFS_OWNER_VERIFIED: bool = false

# Advertised capabilities are intentionally conservative: features without a
# verified implementation must remain visibly blocked.
pub val DBD_CAPABILITY_STATE: text = "protocol=RESP;profile=basic;limits=bounded;journal=ChecksummedBase64V1;filesystem_launch=VerifiedArtifactSecurityGatedV1;close_owner=RetryableQuarantineV1;quit=TerminalAfterReplyV1;auth=DigestVerifierImplementedUnprovisionedV1;auth_provider=ConfiguredTokenV1;auth_framing=DbdMutableAuthRequestOwnerV1;command_framing=DbdAuthenticatedRespIngressV1;tls=Blocked;tls_record_owner=AuthenticatedV1;tls_handshake_authority=BlockedCertificatePrivateKeyEntropyOwner;transactions=BoundedDbfsAtomicExecNoWatchV1;dbfs_adapter=GenerationBoundTransactionalReplaceV1;live_dbfs_durability=ProvisioningGated"

pub fn dbd_production_startup_ready() -> bool:
    """True only after real auth, TLS, and DBFS owners verify admission."""
    DBD_AUTH_FRAMING_OWNER_VERIFIED and DBD_AUTHENTICATION_OWNER_VERIFIED and
        DBD_TLS_OWNER_VERIFIED and DBD_DBFS_OWNER_VERIFIED

pub fn dbd_production_startup_blocker() -> text:
    """Return a non-secret, stable production startup blocker."""
    if not DBD_AUTHENTICATION_OWNER_VERIFIED:
        return DBD_BOOT_CREDENTIAL_OWNER_BLOCKER
    if not DBD_TLS_OWNER_VERIFIED:
        return "tls-owner-unavailable"
    if not DBD_DBFS_OWNER_VERIFIED:
        return "dbfs-engine-owner-unavailable"
    ""

pub fn dbd_dbfs_persistence_ready() -> bool:
    """True only when dbd can reach a mounted, durable DBFS engine owner."""
    DBD_DBFS_OWNER_VERIFIED

pub fn dbd_dbfs_persistence_blocker() -> text:
    if DBD_DBFS_OWNER_VERIFIED:
        return ""
    "dbfs-engine-owner-unavailable"

fn _dbd_ascii_fold(code: i64) -> i64:
    if code >= 97 and code <= 122:
        return code - 32
    code

fn _dbd_ascii_match_at(message: text, start: i64, marker: text) -> bool:
    if start < 0 or start + marker.len() > message.len():
        return false
    var i: i64 = 0
    while i < marker.len():
        if _dbd_ascii_fold(message.char_code_at(start + i)) != marker.char_code_at(i):
            return false
        i = i + 1
    true

fn _dbd_diagnostic_contains_credential(message: text) -> bool:
    var i: i64 = 0
    while i < message.len():
        if _dbd_ascii_match_at(message, i, "AUTH ") or
            _dbd_ascii_match_at(message, i, "PASSWORD=") or
            _dbd_ascii_match_at(message, i, "CREDENTIAL=") or
            _dbd_ascii_match_at(message, i, "SECRET=") or
            _dbd_ascii_match_at(message, i, "TOKEN="):
            return true
        i = i + 1
    false

pub fn dbd_redact_diagnostic(message: text) -> text:
    """Replace a credential-shaped diagnostic without copying its payload."""
    if _dbd_diagnostic_contains_credential(message):
        return "[dbd] sensitive diagnostic redacted"
    message

pub class DbdSessionBudget:
    """Cumulative, per-connection admission budget for the transport owner."""
    received_bytes: i64
    request_count: i64
    response_bytes: i64
    closed: bool

    pub static fn new() -> DbdSessionBudget:
        DbdSessionBudget(received_bytes: 0, request_count: 0,
                         response_bytes: 0, closed: false)

    pub me admit_receive(byte_count: i64) -> bool:
        if self.closed or byte_count <= 0 or byte_count > DBD_MAX_SESSION_BYTES:
            return false
        if self.received_bytes > DBD_MAX_SESSION_BYTES - byte_count:
            return false
        self.received_bytes = self.received_bytes + byte_count
        true

    pub me admit_request() -> bool:
        if self.closed or self.request_count >= DBD_MAX_REQUESTS_PER_SESSION:
            return false
        self.request_count = self.request_count + 1
        true

    pub me admit_response(byte_count: i64) -> bool:
        if self.closed or byte_count < 0 or byte_count > DBD_MAX_RESPONSE_BYTES_PER_SESSION:
            return false
        if self.response_bytes > DBD_MAX_RESPONSE_BYTES_PER_SESSION - byte_count:
            return false
        self.response_bytes = self.response_bytes + byte_count
        true

    pub me close():
        self.closed = true

pub class DbdPersistenceBudget:
    """Durability admission state retained by the canonical daemon owner."""
    healthy: bool
    record_count: i64
    journal_bytes: i64

    pub static fn new() -> DbdPersistenceBudget:
        DbdPersistenceBudget(healthy: true, record_count: 0, journal_bytes: 0)

    pub static fn restored(record_count: i64, journal_bytes: i64) -> DbdPersistenceBudget:
        val valid = record_count >= 0 and record_count <= DBD_MAX_JOURNAL_RECORDS and
            journal_bytes >= 0 and journal_bytes <= DBD_MAX_JOURNAL_BYTES
        DbdPersistenceBudget(healthy: valid, record_count: record_count,
                             journal_bytes: journal_bytes)

    pub fn can_append(line_bytes: i64) -> bool:
        if not self.healthy or line_bytes <= 0 or
            self.record_count >= DBD_MAX_JOURNAL_RECORDS:
            return false
        line_bytes <= DBD_MAX_JOURNAL_BYTES - self.journal_bytes

    pub me commit_verified(line_bytes: i64) -> bool:
        if not self.can_append(line_bytes):
            return false
        self.record_count = self.record_count + 1
        self.journal_bytes = self.journal_bytes + line_bytes
        true

    pub fn can_append_batch(record_count: i64, byte_count: i64) -> bool:
        if not self.healthy or record_count <= 0 or byte_count <= 0:
            return false
        if record_count > DBD_MAX_JOURNAL_RECORDS - self.record_count:
            return false
        byte_count <= DBD_MAX_JOURNAL_BYTES - self.journal_bytes

    pub me commit_verified_batch(record_count: i64, byte_count: i64) -> bool:
        if not self.can_append_batch(record_count, byte_count):
            return false
        self.record_count = self.record_count + record_count
        self.journal_bytes = self.journal_bytes + byte_count
        true

    pub me mark_unhealthy():
        self.healthy = false

fn _dbd_principal_valid(principal: text) -> bool:
    if principal.len() <= 0 or principal.len() > DBD_MAX_PRINCIPAL_BYTES:
        return false
    var i: i64 = 0
    while i < principal.len():
        val code = principal.char_code_at(i)
        if code < 33 or code > 126:
            return false
        i = i + 1
    true

fn _dbd_principal_bytes_valid(principal: [u8]) -> bool:
    if principal.len().to_i64() <= 0 or
        principal.len().to_i64() > DBD_MAX_PRINCIPAL_BYTES:
        return false
    for byte in principal:
        if byte < 33u8 or byte > 126u8:
            return false
    true

fn _dbd_digest_equal(left: text, right: text) -> bool:
    # Both inputs are SHA-256 hex digests.  Iterate the full fixed width and
    # combine every mismatch before deciding; never early-return on content.
    var different: i64 = 0
    var i: i64 = 0
    while i < 64:
        different = different |
            (left.char_code_at(i) ^ right.char_code_at(i))
        i = i + 1
    different == 0

pub class DbdCredentialProvider:
    """Configured verifier material; never retains the credential bytes."""
    configured: bool
    principal: text
    principal_digest: text
    credential_digest: text

    pub static fn new() -> DbdCredentialProvider:
        DbdCredentialProvider(configured: false, principal: "",
            principal_digest: DBD_UNKNOWN_PRINCIPAL_DIGEST,
            credential_digest: DBD_UNKNOWN_CREDENTIAL_DIGEST)

    pub me configure_bytes(principal: text, credential: [u8]) -> bool:
        # A failed replacement revokes the previous verifier rather than
        # silently continuing with stale credentials.
        self.configured = false
        self.principal = ""
        self.principal_digest = DBD_UNKNOWN_PRINCIPAL_DIGEST
        self.credential_digest = DBD_UNKNOWN_CREDENTIAL_DIGEST
        if not _dbd_principal_valid(principal) or
            credential.len().to_i64() < DBD_MIN_CREDENTIAL_BYTES or
            credential.len().to_i64() > DBD_MAX_CREDENTIAL_BYTES:
            return false
        self.principal = principal
        self.principal_digest = sha256_text(principal)
        self.credential_digest = sha256_u8_hex(credential)
        self.configured = true
        true

    pub me revoke():
        self.configured = false
        self.principal = ""
        self.principal_digest = DBD_UNKNOWN_PRINCIPAL_DIGEST
        self.credential_digest = DBD_UNKNOWN_CREDENTIAL_DIGEST

pub class DbdAuthSession:
    """One connection's bounded authentication attempts and admitted identity."""
    session_id: i64
    attempts: i64
    authenticated: bool
    identity: text
    identity_generation: i64
    closed: bool

    pub static fn new(session_id: i64) -> DbdAuthSession:
        DbdAuthSession(session_id: session_id, attempts: 0,
            authenticated: false, identity: "", identity_generation: 0,
            closed: session_id <= 0)

    me begin_attempt() -> bool:
        if self.closed or self.authenticated or
            self.attempts >= DBD_MAX_AUTH_ATTEMPTS_PER_SESSION:
            return false
        self.attempts = self.attempts + 1
        true

    me reject_attempt() -> bool:
        if self.attempts >= DBD_MAX_AUTH_ATTEMPTS_PER_SESSION:
            self.closed = true
        false

    me commit_digest_authentication(
        provider: DbdCredentialProvider,
        principal_valid: bool,
        supplied_principal_digest: text,
        supplied_credential_digest: text
    ) -> bool:
        val principal_matches = _dbd_digest_equal(
            provider.principal_digest, supplied_principal_digest)
        val credential_matches = _dbd_digest_equal(
            provider.credential_digest, supplied_credential_digest)
        if provider.configured and principal_valid and
            principal_matches and credential_matches:
            self.authenticated = true
            self.identity = provider.principal
            self.identity_generation = self.identity_generation + 1
            return true
        self.reject_attempt()

    pub me authenticate(
        provider: DbdCredentialProvider,
        principal: text,
        candidate: [u8]
    ) -> bool:
        if not self.begin_attempt():
            return false
        if candidate.len().to_i64() < DBD_MIN_CREDENTIAL_BYTES or
            candidate.len().to_i64() > DBD_MAX_CREDENTIAL_BYTES:
            return self.reject_attempt()
        val principal_valid = _dbd_principal_valid(principal)
        val supplied_principal_digest = if principal_valid:
            sha256_text(principal)
        else:
            DBD_UNKNOWN_PRINCIPAL_DIGEST
        val supplied_credential_digest = sha256_u8_hex(candidate)
        self.commit_digest_authentication(
            provider, principal_valid, supplied_principal_digest,
            supplied_credential_digest)

    pub me authenticate_bytes(
        provider: DbdCredentialProvider,
        principal: [u8],
        candidate: [u8]
    ) -> bool:
        """Authenticate mutable wire fields without creating secret text."""
        if not self.begin_attempt():
            return false
        if candidate.len().to_i64() < DBD_MIN_CREDENTIAL_BYTES or
            candidate.len().to_i64() > DBD_MAX_CREDENTIAL_BYTES:
            return self.reject_attempt()
        val principal_valid = _dbd_principal_bytes_valid(principal)
        val supplied_principal_digest = if principal_valid:
            sha256_u8_hex(principal)
        else:
            DBD_UNKNOWN_PRINCIPAL_DIGEST
        val supplied_credential_digest = sha256_u8_hex(candidate)
        self.commit_digest_authentication(
            provider, principal_valid, supplied_principal_digest,
            supplied_credential_digest)

    pub fn can_dispatch() -> bool:
        self.authenticated and not self.closed and self.identity != "" and
            self.identity_generation > 0

    pub me close():
        self.authenticated = false
        self.identity = ""
        self.closed = true

pub fn dbd_command_is_mutating(cmd: text) -> bool:
    """True for every command the canonical Redis engine can mutate with."""
    val u = cmd.upper()
    u == "SET" or u == "DEL" or u == "INCR" or u == "EXPIRE" or
        u == "FLUSHALL"

pub fn dbd_command_has_durable_journal_semantics(cmd: text) -> bool:
    """True only for mutations whose exact restart semantics are implemented."""
    val u = cmd.upper()
    u == "SET" or u == "DEL"

pub fn dbd_command_terminates_session(args: [text]) -> bool:
    """Match the canonical Redis engine's terminal QUIT command.

    The hosted server closes after any parsed QUIT command, including one
    carrying extra arguments.  The SimpleOS transport must make the same
    lifecycle decision after sending the canonical dispatch reply; otherwise
    commands pipelined behind QUIT execute on a connection the peer was told
    had terminated.
    """
    args.len() > 0 and args[0].upper() == "QUIT"

pub enum DbdTransactionQueueStatusV1:
    Queued
    NotActive
    InvalidControl
    LimitExceeded
    DurabilityUnsupported

pub class DbdTransactionOwnerV1:
    """Bounded per-session MULTI queue; the DbdServer remains commit owner."""
    active: bool
    failed: bool
    queued_command_count: i64
    queued_bytes: i64
    commands: [[text]]

    pub static fn new() -> DbdTransactionOwnerV1:
        DbdTransactionOwnerV1(
            active: false, failed: false, queued_command_count: 0,
            queued_bytes: 0, commands: [])

    pub me begin(args: [text]) -> bool:
        if self.active or args.len() != 1:
            return false
        self.active = true
        self.failed = false
        self.queued_command_count = 0
        self.queued_bytes = 0
        self.commands = []
        true

    pub fn is_active() -> bool:
        self.active

    pub fn is_failed() -> bool:
        self.failed

    me fail_queue():
        # Once EXEC is guaranteed to abort, queued argument payloads have no
        # remaining consumer. Release them immediately instead of retaining
        # attacker-controlled text until EXEC, DISCARD, or connection close.
        # Scalar accounting remains intact so later queue-limit replies keep
        # the same bounded protocol behavior without copying doomed payloads.
        self.failed = true
        self.commands = []

    pub me queue(args: [text]) -> DbdTransactionQueueStatusV1:
        if not self.active:
            return DbdTransactionQueueStatusV1.NotActive
        if args.len() == 0 or args.len().to_i64() > DBD_MAX_JOURNAL_ARGS:
            self.fail_queue()
            return DbdTransactionQueueStatusV1.LimitExceeded
        val command = args[0].upper()
        if command == "MULTI" or command == "EXEC" or command == "DISCARD" or
            command == "WATCH" or command == "UNWATCH" or
            command == "AUTH" or command == "QUIT":
            self.fail_queue()
            return DbdTransactionQueueStatusV1.InvalidControl
        if dbd_command_is_mutating(command) and
            not dbd_command_has_durable_journal_semantics(command):
            self.fail_queue()
            return DbdTransactionQueueStatusV1.DurabilityUnsupported
        if dbd_command_has_durable_journal_semantics(command) and
            not dbd_journal_args_valid(args):
            self.fail_queue()
            return DbdTransactionQueueStatusV1.DurabilityUnsupported
        var command_bytes: i64 = 8
        for arg in args:
            if arg.len() > DBD_MAX_TRANSACTION_BYTES - command_bytes:
                self.fail_queue()
                return DbdTransactionQueueStatusV1.LimitExceeded
            command_bytes = command_bytes + arg.len()
        if self.queued_command_count >= DBD_MAX_TRANSACTION_COMMANDS or
            command_bytes > DBD_MAX_TRANSACTION_BYTES - self.queued_bytes:
            self.fail_queue()
            return DbdTransactionQueueStatusV1.LimitExceeded
        # A prior error already doomed this transaction. Preserve the normal
        # QUEUED reply and bounded scalar accounting, but do not retain another
        # argument graph that take_for_exec() can never dispatch.
        if not self.failed:
            self.commands.push(args)
        self.queued_command_count = self.queued_command_count + 1
        self.queued_bytes = self.queued_bytes + command_bytes
        DbdTransactionQueueStatusV1.Queued

    pub me take_for_exec() -> [[text]]:
        if not self.active or self.failed:
            self.clear()
            return []
        val owned = self.commands
        self.active = false
        self.failed = false
        self.queued_command_count = 0
        self.queued_bytes = 0
        self.commands = []
        owned

    pub me discard() -> bool:
        if not self.active:
            return false
        self.clear()
        true

    pub me clear():
        self.active = false
        self.failed = false
        self.queued_command_count = 0
        self.queued_bytes = 0
        self.commands = []

fn _dbd_journal_scalar_safe(value: text) -> bool:
    if value.len() > DBD_MAX_JOURNAL_LINE_BYTES:
        return false
    true

pub fn dbd_journal_args_valid(args: [text]) -> bool:
    if args.len() == 0 or args.len().to_i64() > DBD_MAX_JOURNAL_ARGS:
        return false
    for arg in args:
        if not _dbd_journal_scalar_safe(arg):
            return false
    val cmd = args[0].upper()
    if cmd == "SET":
        args.len() == 3 and args[1].len() > 0
    elif cmd == "DEL":
        # Match the canonical Redis owner: DEL accepts one or more keys and
        # returns the number removed.  Retaining the complete argument vector
        # in one integrity-bound record makes replay atomic at the command
        # boundary instead of forcing callers to split one wire command into
        # several independently recoverable mutations.
        if args.len() < 2:
            return false
        var key_index: u64 = 1
        while key_index < args.len():
            if args[key_index].len() == 0:
                return false
            key_index = key_index + 1u64
        true
    else:
        false

pub fn dbd_encode_journal_line(args: [text]) -> text:
    """Encode one mutation as a checksummed, delimiter-safe J1 record.

    Each argument is canonical base64 with a non-empty ``B`` tag, so spaces,
    empty values, CR/LF, and Unicode remain unambiguous within one journal
    line.  The digest covers the exact encoded argument sequence; replay
    rejects torn or modified records before applying any mutation.
    """
    if not dbd_journal_args_valid(args):
        return ""
    var body_parts: [text] = []
    var body_bytes: i64 = 0
    for arg in args:
        val field = " B" + base64_encode(arg)
        # Reserve the fixed ``J1 `` prefix, 64-byte SHA-256, and separator.
        if field.len() > DBD_MAX_JOURNAL_LINE_BYTES - 68 - body_bytes:
            return ""
        body_parts.push(field)
        body_bytes = body_bytes + field.len()
    # Join once.  Multi-key DEL is bounded to DBD_MAX_JOURNAL_ARGS, but
    # repeated immutable-text concatenation would still copy earlier fields
    # for every key on this persistence hot path.
    val body = body_parts.join("")
    "J1 " + sha256_text(body) + body

fn _dbd_decode_j1_journal_line(line: text) -> [text]:
    var rejected: [text] = []
    val fields = line.split(" ")
    if fields.len() < 4 or fields[0] != "J1" or fields[1].len() != 64:
        return rejected
    var body_parts: [text] = []
    var args: [text] = []
    var i: u64 = 2
    while i < fields.len():
        val field = fields[i]
        if not field.starts_with("B"):
            return rejected
        val encoded = field.substring(1, field.len())
        val decoded = base64_decode(encoded)
        # Require the one canonical representation; permissive or malformed
        # base64 must never be normalized into a different durable command.
        if base64_encode(decoded) != encoded:
            return rejected
        body_parts.push(" " + field)
        args.push(decoded)
        i = i + 1
    val body = body_parts.join("")
    if sha256_text(body) != fields[1] or not dbd_journal_args_valid(args):
        return rejected
    args

pub fn dbd_decode_journal_line(line: text) -> [text]:
    """Decode only an integrity-bound J1 record.

    Pre-J1 scalar records are intentionally rejected.  Accepting them beside
    J1 would let an injected ``SET``/``DEL`` line bypass the record digest.
    Any future legacy importer must be an offline, one-shot migration owner
    that rewrites the complete journal before production replay.
    """
    var args: [text] = []
    if line.len() == 0 or line.len() > DBD_MAX_JOURNAL_LINE_BYTES:
        return args
    if line.starts_with("J1 "):
        return _dbd_decode_j1_journal_line(line)
    args

pub class DbdEngine:
    """The real RESP store (RedisServer) plus journal replay.

    dispatch() delegates verbatim to RedisServer.dispatch(); replay_journal()
    re-dispatches each journaled command through that same method — so
    reconstruction after a reboot uses the real engine, never a shadow copy
    of its semantics.
    """
    engine: RedisServer

    pub static fn new() -> DbdEngine:
        DbdEngine(engine: RedisServer.create())

    pub me dispatch(args: [text]) -> text:
        self.engine.dispatch(args)

    pub me replay_journal(log_text: text) -> i64:
        """Replay a durable journal (newline-separated encoded commands) through
        the real engine. Returns the number of commands replayed."""
        if log_text.len() > DBD_MAX_JOURNAL_BYTES:
            return -1
        if log_text.len() > 0 and not log_text.ends_with("\n"):
            return -1
        # Validate the complete bounded journal before applying any mutation.
        # A corrupt later record must not leave a partially reconstructed DB.
        var commands: [[text]] = []
        for line in log_text.split("\n"):
            if line.len() > 0:
                if commands.len() >= DBD_MAX_JOURNAL_RECORDS:
                    return -1
                val args = dbd_decode_journal_line(line)
                if not dbd_journal_args_valid(args):
                    return -1
                commands.push(args)
        for args in commands:
            self.engine.dispatch(args)
        commands.len().to_i64()

pub fn dbd_parse_next_authenticated_command(
    buffer: text
) -> ([text], text, bool):
    """Expose the canonical RESP parser only after transport authentication."""
    match parse_next_request(buffer):
        case Some(request): (request.args, request.rest, true)
        case nil: ([], buffer, false)
