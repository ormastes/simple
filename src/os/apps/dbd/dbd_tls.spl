# DBD-owned TLS 1.3 application-record session.
#
# Framing and bounded accumulation belong to the shared V1 record stream.
# This adapter owns only established traffic keys, sequence commitment, and
# the authenticated plaintext frames returned to the DBD transport.  It does
# not own sockets, listeners, credentials, or service lifecycle state.

use std.common.net.tls_application_record_stream_v1.{
    TlsApplicationRecordStreamV1,
    TLS_APPLICATION_DATA_TYPE_V1,
    TLS_MAX_FRAGMENT_LENGTH_V1,
    TLS_MAX_SEQUENCE_V1,
    tls_application_record_sequence_can_advance_v1,
    tls_application_record_stream_new_v1
}
use os.tls13.handshake13.{
    CIPHER_AES_128_GCM_SHA256,
    CIPHER_CHACHA20_POLY1305_SHA256
}
use os.tls13.record13.{
    RecordKey, RecordResult,
    record13_decrypt_for_suite, record13_encrypt_for_suite
}
use os.tls13.server_types.{Tls13ServerContext}

pub enum DbdTlsSessionStatusV1:
    Established
    Failed
    Closed

pub enum DbdTlsIngressStatusV1:
    NeedMore
    Authenticated
    Malformed
    Overflow
    AuthenticationFailed
    SequenceExhausted
    UnexpectedContentType
    SessionClosed

pub class DbdTlsSessionV1:
    """Established TLS traffic owner; retained bytes are ciphertext only."""
    stream: TlsApplicationRecordStreamV1
    cipher_suite: u16
    client_key: RecordKey
    server_key: RecordKey
    server_sequence: i64
    status: DbdTlsSessionStatusV1

    pub static fn from_context(ctx: Tls13ServerContext) -> Result<DbdTlsSessionV1, text>:
        val key_length = if ctx.cipher_suite == CIPHER_AES_128_GCM_SHA256:
            16
        elif ctx.cipher_suite == CIPHER_CHACHA20_POLY1305_SHA256:
            32
        else:
            return Err("dbd-tls-cipher-suite-unsupported")
        if (ctx.client_app_key.len().to_i64() != key_length or
            ctx.server_app_key.len().to_i64() != key_length or
            ctx.client_app_iv.len().to_i64() != 12 or
            ctx.server_app_iv.len().to_i64() != 12):
            return Err("dbd-tls-traffic-key-shape-invalid")
        if (ctx.client_seq > TLS_MAX_SEQUENCE_V1.to_u64() or
            ctx.server_seq > TLS_MAX_SEQUENCE_V1.to_u64()):
            return Err("dbd-tls-sequence-invalid")
        Ok(DbdTlsSessionV1(
            stream: tls_application_record_stream_new_v1(ctx.client_seq.to_i64()),
            cipher_suite: ctx.cipher_suite,
            client_key: RecordKey(key: ctx.client_app_key, iv: ctx.client_app_iv),
            server_key: RecordKey(key: ctx.server_app_key, iv: ctx.server_app_iv),
            server_sequence: ctx.server_seq.to_i64(),
            status: DbdTlsSessionStatusV1.Established
        ))

    me fail():
        self.stream = tls_application_record_stream_new_v1(
            self.stream.sequence())
        self.client_key = RecordKey(key: [], iv: [])
        self.server_key = RecordKey(key: [], iv: [])
        self.cipher_suite = 0u16
        self.status = DbdTlsSessionStatusV1.Failed

    pub me seal_application(plaintext: [u8]) -> [u8]:
        """Encrypt one response and commit its sequence only on success."""
        if self.status != DbdTlsSessionStatusV1.Established or
            plaintext.len() == 0 or
            plaintext.len().to_i64() > TLS_MAX_FRAGMENT_LENGTH_V1:
            return []
        if not tls_application_record_sequence_can_advance_v1(self.server_sequence):
            self.fail()
            return []
        val record = record13_encrypt_for_suite(
            self.cipher_suite,
            self.server_key,
            self.server_sequence.to_u64(),
            TLS_APPLICATION_DATA_TYPE_V1.to_u8(),
            plaintext
        )
        if record.len() == 0:
            self.fail()
            return []
        self.server_sequence = self.server_sequence + 1
        record

    pub me close():
        self.fail()
        self.status = DbdTlsSessionStatusV1.Closed

pub struct DbdTlsIngressV1:
    """Authenticated plaintext frames plus ciphertext framing remainder."""
    plaintext_frames: [[u8]]
    remainder_length: i64
    status: DbdTlsIngressStatusV1
    authenticated_record_count: i64

impl DbdTlsIngressV1:
    pub me fn zeroize_plaintext_frame(frame_index: u64) -> i64:
        if frame_index >= self.plaintext_frames.len():
            return 0
        var wiped: i64 = 0
        var byte_index: u64 = 0
        while byte_index < self.plaintext_frames[frame_index].len():
            self.plaintext_frames[frame_index][byte_index] = 0u8
            wiped = wiped + 1
            byte_index = byte_index + 1u64
        wiped

    pub me fn zeroize_plaintext_frames() -> i64:
        var wiped: i64 = 0
        var frame_index: u64 = 0
        while frame_index < self.plaintext_frames.len():
            wiped = wiped + self.zeroize_plaintext_frame(frame_index)
            frame_index = frame_index + 1u64
        wiped

    pub fn retained_plaintext_nonzero_byte_count() -> i64:
        var retained: i64 = 0
        for frame in self.plaintext_frames:
            for byte in frame:
                if byte != 0u8:
                    retained = retained + 1
        retained

fn _dbd_tls_ingress_v1(
    status: DbdTlsIngressStatusV1,
    remainder_length: i64,
    frames: [[u8]],
    count: i64
) -> DbdTlsIngressV1:
    DbdTlsIngressV1(
        plaintext_frames: frames,
        remainder_length: remainder_length,
        status: status,
        authenticated_record_count: count
    )

fn _dbd_tls_empty_ingress_v1(
    status: DbdTlsIngressStatusV1
) -> DbdTlsIngressV1:
    _dbd_tls_ingress_v1(status, 0, [], 0)

impl DbdTlsSessionV1:
  pub me fn ingest(bytes: [u8]) -> DbdTlsIngressV1:
    """Frame and authenticate inbound records, committing each sequence only
    after its AEAD verification succeeds. No plaintext is retained in the
    returned session.
    """
    if self.status != DbdTlsSessionStatusV1.Established:
        return _dbd_tls_empty_ingress_v1(
            DbdTlsIngressStatusV1.SessionClosed)

    val proposed = self.stream.ingest(bytes)
    if proposed.is_malformed():
        self.fail()
        return _dbd_tls_empty_ingress_v1(DbdTlsIngressStatusV1.Malformed)
    if proposed.is_overflow():
        self.fail()
        return _dbd_tls_empty_ingress_v1(DbdTlsIngressStatusV1.Overflow)
    if proposed.is_sequence_exhausted():
        self.fail()
        return _dbd_tls_empty_ingress_v1(
            DbdTlsIngressStatusV1.SequenceExhausted)
    if proposed.is_proposal_pending():
        self.fail()
        return _dbd_tls_empty_ingress_v1(DbdTlsIngressStatusV1.Malformed)

    var frames: [[u8]] = []
    var authenticated: i64 = 0
    var index: u64 = 0
    val proposed_records = proposed.framed_records()
    while index < proposed_records.len():
        val record_sequence = self.stream.sequence() + index.to_i64()
        if not tls_application_record_sequence_can_advance_v1(
            record_sequence):
            var wipe_frame_index: u64 = 0
            while wipe_frame_index < frames.len():
                var prior = frames[wipe_frame_index]
                var wipe_byte_index: u64 = 0
                while wipe_byte_index < prior.len():
                    prior[wipe_byte_index] = 0u8
                    wipe_byte_index = wipe_byte_index + 1u64
                frames[wipe_frame_index] = prior
                wipe_frame_index = wipe_frame_index + 1u64
            val _ = self.stream.reject_authentication(
                proposed.proposal_token())
            self.fail()
            return _dbd_tls_empty_ingress_v1(
                DbdTlsIngressStatusV1.SequenceExhausted)
        val decrypted = record13_decrypt_for_suite(
            self.cipher_suite,
            self.client_key,
            record_sequence.to_u64(),
            proposed_records[index]
        )
        match decrypted:
            case RecordResult.Err(_):
                var wipe_frame_index: u64 = 0
                while wipe_frame_index < frames.len():
                    var prior = frames[wipe_frame_index]
                    var wipe_byte_index: u64 = 0
                    while wipe_byte_index < prior.len():
                        prior[wipe_byte_index] = 0u8
                        wipe_byte_index = wipe_byte_index + 1u64
                    frames[wipe_frame_index] = prior
                    wipe_frame_index = wipe_frame_index + 1u64
                val _ = self.stream.reject_authentication(
                    proposed.proposal_token())
                self.fail()
                return _dbd_tls_empty_ingress_v1(
                    DbdTlsIngressStatusV1.AuthenticationFailed)
            case RecordResult.Ok(content_type, plaintext_value):
                var plaintext = plaintext_value
                if content_type != TLS_APPLICATION_DATA_TYPE_V1:
                    var wipe_plaintext_index: u64 = 0
                    while wipe_plaintext_index < plaintext.len():
                        plaintext[wipe_plaintext_index] = 0u8
                        wipe_plaintext_index = wipe_plaintext_index + 1u64
                    var wipe_frame_index: u64 = 0
                    while wipe_frame_index < frames.len():
                        var prior = frames[wipe_frame_index]
                        var wipe_byte_index: u64 = 0
                        while wipe_byte_index < prior.len():
                            prior[wipe_byte_index] = 0u8
                            wipe_byte_index = wipe_byte_index + 1u64
                        frames[wipe_frame_index] = prior
                        wipe_frame_index = wipe_frame_index + 1u64
                    val _ = self.stream.reject_authentication(
                        proposed.proposal_token())
                    self.fail()
                    return _dbd_tls_empty_ingress_v1(
                        DbdTlsIngressStatusV1.UnexpectedContentType)
                frames.push(plaintext)
                var wipe_plaintext_index: u64 = 0
                while wipe_plaintext_index < plaintext.len():
                    plaintext[wipe_plaintext_index] = 0u8
                    wipe_plaintext_index = wipe_plaintext_index + 1u64
                authenticated = authenticated + 1
        index = index + 1u64

    if proposed_records.len() > 0:
        if not proposed.requires_commit() or
            not self.stream.commit_authenticated(
                proposed.proposal_token(), proposed_records.len().to_i64()):
            var wipe_frame_index: u64 = 0
            while wipe_frame_index < frames.len():
                var prior = frames[wipe_frame_index]
                var wipe_byte_index: u64 = 0
                while wipe_byte_index < prior.len():
                    prior[wipe_byte_index] = 0u8
                    wipe_byte_index = wipe_byte_index + 1u64
                frames[wipe_frame_index] = prior
                wipe_frame_index = wipe_frame_index + 1u64
            self.fail()
            return _dbd_tls_empty_ingress_v1(
                DbdTlsIngressStatusV1.Malformed)
    val status = if authenticated > 0:
        DbdTlsIngressStatusV1.Authenticated
    else:
        DbdTlsIngressStatusV1.NeedMore
    _dbd_tls_ingress_v1(
        status, proposed.remaining_byte_count(), frames, authenticated)
