# Thin DBD compatibility facade over the shared TLS 1.3 record owner.
#
# The facade retains DBD's established public constructor, three-state status,
# and record operations. The former public raw stream/key/sequence fields were
# internal implementation exposure and are intentionally removed: supported
# compatibility consists of the constructor, status, operations, and the
# read-only audit accessors below. All framing, sequences, traffic keys,
# directional-close state, plaintext frames, and zeroization remain owned by
# the shared session.

use os.tls13.application_record_session_v1.{
    Tls13ApplicationRecordSessionV1,
    Tls13ApplicationSessionStatusV1,
    Tls13ApplicationIngressStatusV1,
    Tls13ApplicationIngressV1
}
use os.tls13.server_types.{Tls13ServerContext}

pub enum DbdTlsSessionStatusV1:
    Established
    Failed
    Closed

type DbdTlsIngressStatusV1 = Tls13ApplicationIngressStatusV1
type DbdTlsIngressV1 = Tls13ApplicationIngressV1

fn _dbd_tls_compatibility_status_v1(
    status: Tls13ApplicationSessionStatusV1
) -> DbdTlsSessionStatusV1:
    match status:
        case Tls13ApplicationSessionStatusV1.Failed:
            DbdTlsSessionStatusV1.Failed
        case Tls13ApplicationSessionStatusV1.Closed:
            DbdTlsSessionStatusV1.Closed
        case _:
            # Peer-close and local/pending directional-close states retain a
            # live direction and remain Established in DBD's legacy API.
            DbdTlsSessionStatusV1.Established

pub class DbdTlsSessionV1:
    inner: Tls13ApplicationRecordSessionV1
    status: DbdTlsSessionStatusV1
    explicit_closed: bool

    pub static fn from_context(
        ctx: Tls13ServerContext
    ) -> Result<DbdTlsSessionV1, text>:
        match Tls13ApplicationRecordSessionV1.from_context(ctx):
            case Ok(session):
                Ok(DbdTlsSessionV1(
                    inner: session,
                    status: DbdTlsSessionStatusV1.Established,
                    explicit_closed: false))
            case Err(reason):
                if reason == "tls-application-cipher-suite-unsupported":
                    Err("dbd-tls-cipher-suite-unsupported")
                elif reason == "tls-application-traffic-key-shape-invalid":
                    Err("dbd-tls-traffic-key-shape-invalid")
                elif reason == "tls-application-sequence-invalid":
                    Err("dbd-tls-sequence-invalid")
                else:
                    Err(reason)

    me sync_status():
        if self.explicit_closed:
            self.status = DbdTlsSessionStatusV1.Closed
            return
        self.status = _dbd_tls_compatibility_status_v1(self.inner.status)

    pub me fn ingest(bytes: [u8]) -> DbdTlsIngressV1:
        val ingress = self.inner.ingest(bytes)
        self.sync_status()
        ingress

    pub me fn seal_application(plaintext: [u8]) -> [u8]:
        val record = self.inner.seal_application(plaintext)
        self.sync_status()
        record

    pub me fn seal_close_notify() -> [u8]:
        val record = self.inner.seal_close_notify()
        self.sync_status()
        record

    pub me fn commit_close_notify_sent() -> bool:
        val committed = self.inner.commit_close_notify_sent()
        self.sync_status()
        committed

    pub me fn abort_close_notify_send() -> bool:
        val aborted = self.inner.abort_close_notify_send()
        self.sync_status()
        aborted

    pub me close():
        # close() is an explicit legacy lifecycle decision. Ask the sole
        # cryptographic owner to complete terminal teardown first, then latch
        # Closed even when the inner owner was already terminally Failed.
        self.inner.close()
        self.explicit_closed = true
        self.status = DbdTlsSessionStatusV1.Closed

    pub fn receive_sequence() -> i64: self.inner.stream.sequence()
    pub fn receive_byte_work() -> i64: self.inner.stream.byte_work()
    pub fn receive_has_pending_proposal() -> bool:
        self.inner.stream.has_pending_proposal()
    pub fn send_sequence() -> i64: self.inner.server_sequence
    pub fn client_key_length() -> u64: self.inner.client_key.key.len()
    pub fn server_key_length() -> u64: self.inner.server_key.key.len()
    pub fn secret_zeroization_verified() -> bool:
        self.inner.last_secret_zeroization_verified

export DbdTlsSessionV1, DbdTlsSessionStatusV1
export DbdTlsIngressStatusV1, DbdTlsIngressV1
