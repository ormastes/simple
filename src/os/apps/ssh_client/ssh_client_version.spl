#![allow(unnamed_duplicate_typed_args)]
# SSH client version exchange — RFC 4253 section 4.2
#
# Direction-asymmetric half of the version exchange:
#   * The CLIENT sends its identification string first and MAY receive any
#     number of informational lines from the server BEFORE the server's own
#     identification string. A server never has to skip a preamble, so
#     ssh_transport.spl has no code for it.
#   * The CLIENT is the side that must enforce the 255-byte cap and reject
#     control characters in the peer banner (an over-long or NUL-bearing
#     banner is a classic client-side smuggling vector).
#
# The SSH-2.0- prefix / CRLF check itself is NOT reimplemented here: it is
# delegated to os.apps.sshd.ssh_transport.ssh_parse_version_string, which is
# direction-agnostic.

use os.apps.sshd.ssh_transport.{ssh_parse_version_string}
use os.apps.sshd.ssh_packet.{ssh_ascii_bytes_to_text}

extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64

# RFC 4253 section 4.2: the identification string (including CR LF) must not
# exceed 255 characters.
val SSH_CLIENT_MAX_BANNER: u64 = 255
# Bound the informational preamble so a hostile server cannot stream forever.
val SSH_CLIENT_MAX_PREAMBLE_LINES: u64 = 64

struct SshClientBanner:
    """A validated peer identification string."""
    version: text        # e.g. "SSH-2.0-OpenSSH_9.6" (no CR LF)
    raw: [u8]            # same bytes, no CR LF — this is V_S for the exchange hash
    consumed: u64        # bytes consumed from the input, including CR LF
    preamble_lines: u64  # informational lines skipped before the ID string

fn _sshcli_u8_at(data: [u8], idx: u64) -> u8:
    rt_bytes_u8_at(data, idx.to_i64()).to_u8()

fn ssh_client_version_text() -> text:
    "SSH-2.0-SimpleSSH_1.0"

fn ssh_client_version_bytes() -> [u8]:
    """Client identification string WITHOUT CR LF.

    This is V_C: the exchange hash covers the banner without its terminator.
    Written as literal bytes (not .to_bytes()) for the same baremetal reason
    ssh_transport.ssh_build_version_string does.
    """
    var buf: [u8] = []
    # S    S     H     -     2     .     0     -
    buf.push(0x53)
    buf.push(0x53)
    buf.push(0x48)
    buf.push(0x2D)
    buf.push(0x32)
    buf.push(0x2E)
    buf.push(0x30)
    buf.push(0x2D)
    # S    i     m     p     l     e     S     S     H
    buf.push(0x53)
    buf.push(0x69)
    buf.push(0x6D)
    buf.push(0x70)
    buf.push(0x6C)
    buf.push(0x65)
    buf.push(0x53)
    buf.push(0x53)
    buf.push(0x48)
    # _    1     .     0
    buf.push(0x5F)
    buf.push(0x31)
    buf.push(0x2E)
    buf.push(0x30)
    buf

fn ssh_client_version_wire() -> [u8]:
    """Client identification string WITH CR LF — what actually goes on the wire."""
    var buf: [u8] = ssh_client_version_bytes()
    buf.push(0x0D)
    buf.push(0x0A)
    buf

fn _sshcli_find_crlf(data: [u8], start: u64) -> i64:
    """Index of the CR of the first CR LF at or after start, or -1."""
    var i: u64 = start
    while i + 1 < data.len():
        if _sshcli_u8_at(data, i) == 0x0D and _sshcli_u8_at(data, i + 1) == 0x0A:
            return i.to_i64()
        i = i + 1
    -1

fn _line_starts_with_ssh_dash(data: [u8], start: u64, end: u64) -> bool:
    if end < start + 4:
        return false
    _sshcli_u8_at(data, start) == 0x53 and
        _sshcli_u8_at(data, start + 1) == 0x53 and
        _sshcli_u8_at(data, start + 2) == 0x48 and
        _sshcli_u8_at(data, start + 3) == 0x2D

fn _sshcli_slice(data: [u8], start: u64, end: u64) -> [u8]:
    var out: [u8] = []
    var i: u64 = start
    while i < end and i < data.len():
        out.push(_sshcli_u8_at(data, i))
        i = i + 1
    out

fn _sshcli_has_control_bytes(data: [u8]) -> bool:
    """Any byte < 0x20 or == 0x7F is illegal in an identification string."""
    var i: u64 = 0
    while i < data.len():
        val b: u8 = _sshcli_u8_at(data, i)
        if b < 0x20 or b == 0x7F:
            return true
        i = i + 1
    false

fn ssh_client_parse_server_banner(data: [u8]) -> Result<SshClientBanner, text>:
    """Client-side server banner reader. Fails closed on every malformed input.

    Rejects: no CR LF, banner longer than 255 bytes including CR LF, control
    bytes in the banner, an empty softwareversion field, a non-SSH-2.0 protocol
    version, and an unterminated / over-long informational preamble.
    """
    var offset: u64 = 0
    var lines: u64 = 0
    while lines <= SSH_CLIENT_MAX_PREAMBLE_LINES:
        val crlf: i64 = _sshcli_find_crlf(data, offset)
        if crlf < 0:
            return Err("ssh client banner: no CRLF terminator")
        var end: u64 = crlf.to_u64()
        if not _line_starts_with_ssh_dash(data, offset, end):
            # Informational preamble line — RFC 4253 allows it before the ID.
            lines = lines + 1
            offset = end + 2
        else:
            var line_len: u64 = (end - offset) + 2
            if line_len > SSH_CLIENT_MAX_BANNER:
                return Err("ssh client banner: exceeds 255 bytes")
            var body: [u8] = _sshcli_slice(data, offset, end)
            if _sshcli_has_control_bytes(body):
                return Err("ssh client banner: control byte in identification string")
            if body.len() <= 8:
                return Err("ssh client banner: empty softwareversion")
            var with_crlf: [u8] = body
            with_crlf.push(0x0D)
            with_crlf.push(0x0A)
            # Reuse the direction-agnostic prefix/version check.
            match ssh_parse_version_string(with_crlf):
                Ok(v):
                    return Ok(SshClientBanner(
                        version: v,
                        raw: body,
                        consumed: end + 2,
                        preamble_lines: lines
                    ))
                Err(e):
                    return Err("ssh client banner: " + e)
    Err("ssh client banner: preamble too long")

fn ssh_client_banner_text(banner: SshClientBanner) -> text:
    ssh_ascii_bytes_to_text(banner.raw)

export SshClientBanner, SSH_CLIENT_MAX_BANNER, SSH_CLIENT_MAX_PREAMBLE_LINES
export ssh_client_version_text, ssh_client_version_bytes, ssh_client_version_wire
export ssh_client_parse_server_banner, ssh_client_banner_text
