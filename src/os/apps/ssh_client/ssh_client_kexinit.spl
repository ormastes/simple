#![allow(unnamed_duplicate_typed_args)]
# SSH client KEXINIT — RFC 4253 section 7.1
#
# Direction-asymmetric half: the client advertises `ext-info-c` and
# `kex-strict-c-v00@openssh.com` (the server advertises the -s spellings), and
# the client supplies its own 16-byte cookie. ssh_transport.ssh_build_kexinit
# builds the SERVER proposal only.
#
# The PARSER (ssh_parse_kexinit) and the NEGOTIATOR (ssh_negotiate_algorithms)
# are direction-agnostic and are reused verbatim — there is exactly one owner
# of KEXINIT decoding and algorithm selection in the tree.

use os.apps.sshd.ssh_transport.{
    SshKexInit, SshAlgorithms, SSH_MSG_KEXINIT,
    ssh_parse_kexinit, ssh_negotiate_algorithms, ssh_kex_uses_strict_kex
}
use os.apps.sshd.ssh_packet.{ssh_put_u32, ssh_put_text, ssh_put_bool}

extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64

# Client preference order. The negotiated result must be a subset of what the
# reused ssh_negotiate_algorithms actually implements.
val SSH_CLIENT_KEX_ALGORITHMS: text = "curve25519-sha256,ext-info-c,kex-strict-c-v00@openssh.com"
val SSH_CLIENT_HOST_KEY_ALGORITHMS: text = "ssh-ed25519"
val SSH_CLIENT_CIPHERS: text = "aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr"
val SSH_CLIENT_MACS: text = "hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com"
val SSH_CLIENT_COMPRESSION: text = "none"

fn _sshcli_u8_at(data: [u8], idx: u64) -> u8:
    rt_bytes_u8_at(data, idx.to_i64()).to_u8()

fn ssh_client_build_kexinit(cookie: [u8]) -> [u8]:
    """Build the client SSH_MSG_KEXINIT payload (I_C).

    `cookie` must be 16 bytes; shorter input is zero-extended and longer input
    is truncated, so the wire encoding is always well-formed. The caller owns
    randomness — passing a fixed cookie makes the encoding testable.
    """
    var buf: [u8] = []
    buf.push(SSH_MSG_KEXINIT)

    var i: u64 = 0
    while i < 16:
        if i < cookie.len():
            buf.push(_sshcli_u8_at(cookie, i))
        else:
            buf.push(0)
        i = i + 1

    buf = ssh_put_text(buf, SSH_CLIENT_KEX_ALGORITHMS)
    buf = ssh_put_text(buf, SSH_CLIENT_HOST_KEY_ALGORITHMS)
    buf = ssh_put_text(buf, SSH_CLIENT_CIPHERS)
    buf = ssh_put_text(buf, SSH_CLIENT_CIPHERS)
    buf = ssh_put_text(buf, SSH_CLIENT_MACS)
    buf = ssh_put_text(buf, SSH_CLIENT_MACS)
    buf = ssh_put_text(buf, SSH_CLIENT_COMPRESSION)
    buf = ssh_put_text(buf, SSH_CLIENT_COMPRESSION)
    buf = ssh_put_text(buf, "")
    buf = ssh_put_text(buf, "")
    buf = ssh_put_bool(buf, false)
    buf = ssh_put_u32(buf, 0)
    buf

fn ssh_client_kexinit_proposal() -> SshKexInit:
    """The client proposal as a struct, for negotiation without a round-trip."""
    var cookie: [u8] = []
    var i: u64 = 0
    while i < 16:
        cookie.push(0)
        i = i + 1
    SshKexInit(
        cookie: cookie,
        kex_algorithms: SSH_CLIENT_KEX_ALGORITHMS,
        server_host_key_algorithms: SSH_CLIENT_HOST_KEY_ALGORITHMS,
        encryption_client_to_server: SSH_CLIENT_CIPHERS,
        encryption_server_to_client: SSH_CLIENT_CIPHERS,
        mac_client_to_server: SSH_CLIENT_MACS,
        mac_server_to_client: SSH_CLIENT_MACS,
        compression_client_to_server: SSH_CLIENT_COMPRESSION,
        compression_server_to_client: SSH_CLIENT_COMPRESSION,
        first_kex_packet_follows: false
    )

fn ssh_client_negotiate_from_payloads(client_payload: [u8], server_payload: [u8]) -> Result<SshAlgorithms, text>:
    """Decode both KEXINIT payloads and select algorithms (client preference).

    Both the decode and the selection are the reused sshd implementations.
    """
    val client = ssh_parse_kexinit(client_payload)?
    val server = ssh_parse_kexinit(server_payload)?
    ssh_negotiate_algorithms(client, server)

fn ssh_client_strict_kex_from_payloads(client_payload: [u8], server_payload: [u8]) -> Result<bool, text>:
    """True when both sides advertise OpenSSH strict-KEX."""
    val client = ssh_parse_kexinit(client_payload)?
    val server = ssh_parse_kexinit(server_payload)?
    Ok(ssh_kex_uses_strict_kex(client.kex_algorithms, server.kex_algorithms))

export SSH_CLIENT_KEX_ALGORITHMS, SSH_CLIENT_HOST_KEY_ALGORITHMS
export SSH_CLIENT_CIPHERS, SSH_CLIENT_MACS, SSH_CLIENT_COMPRESSION
export ssh_client_build_kexinit, ssh_client_kexinit_proposal
export ssh_client_negotiate_from_payloads, ssh_client_strict_kex_from_payloads
