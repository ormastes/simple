#![allow(unnamed_duplicate_typed_args)]
# SSH client session state machine — socket-free by construction.
#
# The whole client protocol flow is expressed as a pure function of
# (state, inbound payload) -> (new state, outbound payload). No sockets, no
# file descriptors, no globals: a test can drive a complete handshake by
# feeding byte vectors, and the same driver can later be wired to a real
# socket (or to sshd in-process) without changing any protocol logic.
#
# Payload level only: framing/encryption is applied by the packet layer
# (os.apps.sshd.ssh_packet / ssh_cipher) around what this module emits.

use os.apps.ssh_client.ssh_client_version.{
    SshClientBanner, ssh_client_version_bytes, ssh_client_version_wire,
    ssh_client_parse_server_banner
}
use os.apps.ssh_client.ssh_client_kexinit.{
    ssh_client_build_kexinit, ssh_client_negotiate_from_payloads
}
use os.apps.ssh_client.ssh_known_hosts.{SshKnownHostsDb}
use os.apps.ssh_client.ssh_client_kex.{
    SshClientKexResult, ssh_client_build_kex_ecdh_init, ssh_client_complete_kex,
    ssh_client_build_newkeys, SSH_MSG_NEWKEYS_C
}
use os.apps.ssh_client.ssh_client_auth.{
    SshAuthReply, ssh_client_build_service_request, ssh_client_parse_service_accept,
    ssh_client_build_userauth_password, ssh_client_build_userauth_publickey_ed25519,
    ssh_client_parse_userauth_reply,
    SSH_SERVICE_USERAUTH, SSH_SERVICE_CONNECTION,
    SSH_AUTH_REPLY_SUCCESS, SSH_AUTH_REPLY_FAILURE, SSH_AUTH_REPLY_BANNER
}
use os.apps.ssh_client.ssh_client_channel.{
    SshChannelMessage, ssh_client_build_channel_open_session,
    ssh_client_build_exec_request, ssh_client_parse_channel_message,
    ssh_client_build_channel_close,
    SSH_CHAN_OPEN_OK, SSH_CHAN_OPEN_FAILED, SSH_CHAN_DATA, SSH_CHAN_STDERR,
    SSH_CHAN_EOF, SSH_CHAN_CLOSE, SSH_CHAN_EXIT_STATUS,
    SSH_CHAN_WINDOW_ADJUST, SSH_CHAN_REQ_SUCCESS, SSH_CHAN_REQ_FAILURE
}
use os.apps.sshd.ssh_kex_primitives.{SshSessionKeys}
use os.apps.sshd.ssh_kex_core.{ssh_kex_public_from_private}

extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64

# State names.
val SSH_ST_INIT: text = "init"
val SSH_ST_BANNER: text = "await_banner"
val SSH_ST_KEXINIT: text = "await_kexinit"
val SSH_ST_KEXREPLY: text = "await_kexreply"
val SSH_ST_NEWKEYS: text = "await_newkeys"
val SSH_ST_SERVICE: text = "await_service_accept"
val SSH_ST_AUTH: text = "await_auth"
val SSH_ST_CHANNEL: text = "await_channel_open"
val SSH_ST_EXEC: text = "await_exec_reply"
val SSH_ST_RUNNING: text = "running"
val SSH_ST_DONE: text = "done"

val SSH_AUTH_PASSWORD: text = "password"
val SSH_AUTH_PUBLICKEY: text = "publickey"

struct SshClientConfig:
    """Everything the client needs; all randomness supplied by the caller so a
    handshake is fully reproducible in a spec."""
    host: text
    user: text
    command: text
    auth_method: text     # SSH_AUTH_PASSWORD | SSH_AUTH_PUBLICKEY
    password: text
    user_key_blob: [u8]   # ssh-ed25519 public key blob for publickey auth
    user_private_seed: [u8]
    user_public_key: [u8]
    kex_private: [u8]     # 32-byte X25519 scalar
    kexinit_cookie: [u8]  # 16 bytes

struct SshClientSession:
    """Immutable-by-convention client state. Every step returns a new value."""
    config: SshClientConfig
    known_hosts: SshKnownHostsDb
    state: text
    client_version: [u8]
    server_version: [u8]
    server_banner: text
    client_kexinit: [u8]
    server_kexinit: [u8]
    negotiated_kex: text
    negotiated_host_key: text
    negotiated_cipher: text
    session_id: [u8]
    keys: SshSessionKeys
    local_channel: u32
    remote_channel: u32
    exit_status: u32
    got_exit_status: bool
    stdout_bytes: [u8]
    stderr_bytes: [u8]

struct SshClientStep:
    """Result of one protocol step."""
    session: SshClientSession
    outbound: [u8]
    has_outbound: bool

fn _sshcli_u8_at(data: [u8], idx: u64) -> u8:
    rt_bytes_u8_at(data, idx.to_i64()).to_u8()

fn _sshcli_copy(data: [u8]) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < data.len():
        out.push(_sshcli_u8_at(data, i))
        i = i + 1
    out

fn _sshcli_append(dst: [u8], src: [u8]) -> [u8]:
    var out: [u8] = _sshcli_copy(dst)
    var i: u64 = 0
    while i < src.len():
        out.push(_sshcli_u8_at(src, i))
        i = i + 1
    out

fn _empty_keys() -> SshSessionKeys:
    SshSessionKeys(
        iv_c2s: [],
        iv_s2c: [],
        enc_key_c2s: [],
        enc_key_s2c: [],
        mac_key_c2s: [],
        mac_key_s2c: []
    )

fn ssh_client_session_new(config: SshClientConfig, known_hosts: SshKnownHostsDb) -> SshClientSession:
    SshClientSession(
        config: config,
        known_hosts: known_hosts,
        state: SSH_ST_INIT,
        client_version: ssh_client_version_bytes(),
        server_version: [],
        server_banner: "",
        client_kexinit: [],
        server_kexinit: [],
        negotiated_kex: "",
        negotiated_host_key: "",
        negotiated_cipher: "",
        session_id: [],
        keys: _empty_keys(),
        local_channel: 0,
        remote_channel: 0,
        exit_status: 0,
        got_exit_status: false,
        stdout_bytes: [],
        stderr_bytes: []
    )

fn ssh_client_session_start(session: SshClientSession) -> Result<SshClientStep, text>:
    """Emit the client identification string. The client always speaks first."""
    if session.state != SSH_ST_INIT:
        return Err("ssh client: start called in state " + session.state)
    var s = session
    s.state = SSH_ST_BANNER
    Ok(SshClientStep(session: s, outbound: ssh_client_version_wire(), has_outbound: true))

fn _step_banner(session: SshClientSession, inbound: [u8]) -> Result<SshClientStep, text>:
    val banner: SshClientBanner = ssh_client_parse_server_banner(inbound)?
    var s = session
    s.server_version = banner.raw
    s.server_banner = banner.version
    s.client_kexinit = ssh_client_build_kexinit(session.config.kexinit_cookie)
    s.state = SSH_ST_KEXINIT
    Ok(SshClientStep(session: s, outbound: _sshcli_copy(s.client_kexinit), has_outbound: true))

fn _step_kexinit(session: SshClientSession, inbound: [u8]) -> Result<SshClientStep, text>:
    val algorithms = ssh_client_negotiate_from_payloads(session.client_kexinit, inbound)?
    if algorithms.kex != "curve25519-sha256":
        return Err("ssh client: unsupported negotiated kex " + algorithms.kex)
    if algorithms.host_key != "ssh-ed25519":
        return Err("ssh client: unsupported negotiated host key " + algorithms.host_key)

    var s = session
    s.server_kexinit = _sshcli_copy(inbound)
    s.negotiated_kex = algorithms.kex
    s.negotiated_host_key = algorithms.host_key
    s.negotiated_cipher = algorithms.cipher_c2s
    s.state = SSH_ST_KEXREPLY

    val client_public = _client_public(session.config.kex_private)
    if client_public.len() != 32:
        return Err("ssh client: failed to derive ephemeral public key")
    val init_payload = ssh_client_build_kex_ecdh_init(client_public)?
    Ok(SshClientStep(session: s, outbound: init_payload, has_outbound: true))

fn _client_public(private_key: [u8]) -> [u8]:
    ssh_kex_public_from_private(private_key)

fn _step_kexreply(session: SshClientSession, inbound: [u8]) -> Result<SshClientStep, text>:
    val result: SshClientKexResult = ssh_client_complete_kex(
        session.config.host,
        session.known_hosts,
        session.config.kex_private,
        session.client_version,
        session.server_version,
        session.client_kexinit,
        session.server_kexinit,
        inbound
    )?
    var s = session
    s.session_id = result.session_id
    s.keys = result.keys
    s.state = SSH_ST_NEWKEYS
    Ok(SshClientStep(session: s, outbound: ssh_client_build_newkeys(), has_outbound: true))

fn _step_newkeys(session: SshClientSession, inbound: [u8]) -> Result<SshClientStep, text>:
    if inbound.len() != 1 or _sshcli_u8_at(inbound, 0) != SSH_MSG_NEWKEYS_C:
        return Err("ssh client: expected SSH_MSG_NEWKEYS")
    var s = session
    s.state = SSH_ST_SERVICE
    Ok(SshClientStep(
        session: s,
        outbound: ssh_client_build_service_request(SSH_SERVICE_USERAUTH),
        has_outbound: true
    ))

fn _build_auth_request(session: SshClientSession) -> Result<[u8], text>:
    val cfg = session.config
    if cfg.auth_method == SSH_AUTH_PASSWORD:
        return Ok(ssh_client_build_userauth_password(cfg.user, SSH_SERVICE_CONNECTION, cfg.password))
    if cfg.auth_method == SSH_AUTH_PUBLICKEY:
        return ssh_client_build_userauth_publickey_ed25519(
            session.session_id,
            cfg.user,
            SSH_SERVICE_CONNECTION,
            cfg.user_key_blob,
            cfg.user_private_seed,
            cfg.user_public_key
        )
    Err("ssh client: unsupported auth method " + cfg.auth_method)

fn _step_service(session: SshClientSession, inbound: [u8]) -> Result<SshClientStep, text>:
    ssh_client_parse_service_accept(inbound, SSH_SERVICE_USERAUTH)?
    val request = _build_auth_request(session)?
    var s = session
    s.state = SSH_ST_AUTH
    Ok(SshClientStep(session: s, outbound: request, has_outbound: true))

fn _step_auth(session: SshClientSession, inbound: [u8]) -> Result<SshClientStep, text>:
    val reply: SshAuthReply = ssh_client_parse_userauth_reply(inbound)?
    if reply.kind == SSH_AUTH_REPLY_BANNER:
        # Informational only — stay in the same state, send nothing.
        return Ok(SshClientStep(session: session, outbound: [], has_outbound: false))
    if reply.kind == SSH_AUTH_REPLY_FAILURE:
        return Err("ssh client: authentication failed (may continue: " + reply.methods + ")")
    if reply.kind != SSH_AUTH_REPLY_SUCCESS:
        return Err("ssh client: unexpected auth reply " + reply.kind)
    var s = session
    s.state = SSH_ST_CHANNEL
    Ok(SshClientStep(
        session: s,
        outbound: ssh_client_build_channel_open_session(session.local_channel),
        has_outbound: true
    ))

fn _step_channel(session: SshClientSession, inbound: [u8]) -> Result<SshClientStep, text>:
    val msg: SshChannelMessage = ssh_client_parse_channel_message(inbound)?
    if msg.kind == SSH_CHAN_OPEN_FAILED:
        return Err("ssh client: channel open refused: " + msg.reason)
    if msg.kind != SSH_CHAN_OPEN_OK:
        return Err("ssh client: expected channel open confirmation, got " + msg.kind)
    if msg.recipient != session.local_channel:
        return Err("ssh client: channel confirmation for wrong channel")
    var s = session
    s.remote_channel = msg.sender
    s.state = SSH_ST_EXEC
    val request = ssh_client_build_exec_request(msg.sender, session.config.command, true)?
    Ok(SshClientStep(session: s, outbound: request, has_outbound: true))

fn _step_exec(session: SshClientSession, inbound: [u8]) -> Result<SshClientStep, text>:
    val msg: SshChannelMessage = ssh_client_parse_channel_message(inbound)?
    if msg.kind == SSH_CHAN_REQ_FAILURE:
        return Err("ssh client: exec request refused")
    if msg.kind != SSH_CHAN_REQ_SUCCESS:
        return Err("ssh client: expected exec reply, got " + msg.kind)
    var s = session
    s.state = SSH_ST_RUNNING
    Ok(SshClientStep(session: s, outbound: [], has_outbound: false))

fn _step_running(session: SshClientSession, inbound: [u8]) -> Result<SshClientStep, text>:
    val msg: SshChannelMessage = ssh_client_parse_channel_message(inbound)?
    var s = session
    if msg.kind == SSH_CHAN_DATA:
        s.stdout_bytes = _sshcli_append(session.stdout_bytes, msg.data)
        return Ok(SshClientStep(session: s, outbound: [], has_outbound: false))
    if msg.kind == SSH_CHAN_STDERR:
        s.stderr_bytes = _sshcli_append(session.stderr_bytes, msg.data)
        return Ok(SshClientStep(session: s, outbound: [], has_outbound: false))
    if msg.kind == SSH_CHAN_EXIT_STATUS:
        s.exit_status = msg.exit_status
        s.got_exit_status = true
        return Ok(SshClientStep(session: s, outbound: [], has_outbound: false))
    if msg.kind == SSH_CHAN_WINDOW_ADJUST or msg.kind == SSH_CHAN_EOF:
        return Ok(SshClientStep(session: s, outbound: [], has_outbound: false))
    if msg.kind == SSH_CHAN_CLOSE:
        s.state = SSH_ST_DONE
        return Ok(SshClientStep(
            session: s,
            outbound: ssh_client_build_channel_close(session.remote_channel),
            has_outbound: true
        ))
    Err("ssh client: unexpected channel message " + msg.kind)

fn ssh_client_session_step(session: SshClientSession, inbound: [u8]) -> Result<SshClientStep, text>:
    """Feed one inbound payload; get the next outbound payload (if any).

    Every failure path returns Err and leaves no partially advanced state — the
    caller must abort the connection.
    """
    if session.state == SSH_ST_BANNER:
        return _step_banner(session, inbound)
    if session.state == SSH_ST_KEXINIT:
        return _step_kexinit(session, inbound)
    if session.state == SSH_ST_KEXREPLY:
        return _step_kexreply(session, inbound)
    if session.state == SSH_ST_NEWKEYS:
        return _step_newkeys(session, inbound)
    if session.state == SSH_ST_SERVICE:
        return _step_service(session, inbound)
    if session.state == SSH_ST_AUTH:
        return _step_auth(session, inbound)
    if session.state == SSH_ST_CHANNEL:
        return _step_channel(session, inbound)
    if session.state == SSH_ST_EXEC:
        return _step_exec(session, inbound)
    if session.state == SSH_ST_RUNNING:
        return _step_running(session, inbound)
    Err("ssh client: no inbound expected in state " + session.state)

export SshClientConfig, SshClientSession, SshClientStep
export SSH_ST_INIT, SSH_ST_BANNER, SSH_ST_KEXINIT, SSH_ST_KEXREPLY, SSH_ST_NEWKEYS
export SSH_ST_SERVICE, SSH_ST_AUTH, SSH_ST_CHANNEL, SSH_ST_EXEC, SSH_ST_RUNNING, SSH_ST_DONE
export SSH_AUTH_PASSWORD, SSH_AUTH_PUBLICKEY
export ssh_client_session_new, ssh_client_session_start, ssh_client_session_step
