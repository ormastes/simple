#![allow(unnamed_duplicate_typed_args)]
"""Bounded TCP transport for the socket-free SSH client session.

This module owns stream accumulation and socket policy only.  SSH packet
encoding, parsing, and AEAD remain owned by ssh_packet/ssh_cipher.
"""

use os.apps.ssh_client.ssh_client_session.{
    SshClientSession, SshClientStep, ssh_client_session_start,
    ssh_client_session_step, SSH_ST_BANNER, SSH_ST_DONE, SSH_ST_NEWKEYS
}
use os.apps.sshd.ssh_packet.{ssh_get_u32, ssh_packet_build, ssh_packet_read}
use os.apps.sshd.ssh_cipher_live.{
    ssh_encrypt_packet_aes_gcm, ssh_decrypt_packet_aes_gcm,
    ssh_encrypt_packet_aes128_gcm, ssh_decrypt_packet_aes128_gcm
}
use nogc_sync_mut.io.tcp.{TcpStream}

const SSH_CLIENT_DEFAULT_MAX_FRAME: i64 = 35000
const SSH_CLIENT_DEFAULT_MAX_BUFFER: i64 = 70032
const SSH_CLIENT_DEFAULT_IO_TIMEOUT_MS: i64 = 10000
const SSH_CLIENT_GCM_TAG_BYTES: i64 = 16

enum SshClientTransportError:
    None
    InvalidLimit
    BufferOverflow
    FrameTooLarge
    UnexpectedEof
    IoFailure
    ProtocolFailure
    Closed

struct SshClientTransportStatus:
    ok: bool
    error: SshClientTransportError
    detail: text

fn ssh_client_transport_ok() -> SshClientTransportStatus:
    SshClientTransportStatus(ok: true, error: SshClientTransportError.None, detail: "")

fn ssh_client_transport_failure(error: SshClientTransportError, detail: text) -> SshClientTransportStatus:
    SshClientTransportStatus(ok: false, error: error, detail: detail)

fn _sshct_copy_range(data: [u8], start: i64, finish: i64) -> [u8]:
    var out: [u8] = []
    var i = start
    while i < finish and i < data.len():
        out.push(data[i])
        i = i + 1
    out

fn _sshct_append(dst: [u8], src: [u8]) -> [u8]:
    var out = _sshct_copy_range(dst, 0, dst.len())
    var i = 0
    while i < src.len():
        out.push(src[i])
        i = i + 1
    out

fn ssh_client_banner_identification_ready(data: [u8]) -> bool:
    """True when the final complete line is an SSH identification line.

    Informational lines are legal before the server identification string.
    The transport therefore must not invoke the strict whole-banner parser
    merely because an informational line became complete.
    """
    if data.len() < 5 or data[data.len() - 1] != 10:
        return false
    var start = data.len() - 1
    while start > 0 and data[start - 1] != 10:
        start = start - 1
    if data.len() - start < 4:
        return false
    if data[start] != 83: return false
    if data[start + 1] != 83: return false
    if data[start + 2] != 72: return false
    data[start + 3] == 45

class SshClientWireFramer:
    receive_buffer: [u8]
    frames: [[u8]]
    max_frame: i64
    max_buffer: i64
    encrypted: bool
    closed: bool
    status: SshClientTransportStatus

    me fail(error: SshClientTransportError, detail: text):
        if self.closed: return
        self.closed = true
        self.receive_buffer = []
        self.status = ssh_client_transport_failure(error, detail)

    me feed(bytes: [u8]):
        if self.closed: return
        if bytes.len() > self.max_buffer - self.receive_buffer.len():
            self.fail(SshClientTransportError.BufferOverflow, "SSH receive buffer exceeds configured limit")
            return
        self.receive_buffer = _sshct_append(self.receive_buffer, bytes)
        self.drive()

    me drive():
        while not self.closed and self.receive_buffer.len() >= 4:
            val packet_length = ssh_get_u32(self.receive_buffer, 0).to_i64()
            # padding_length plus at least four padding octets is the smallest
            # legal SSH binary packet body (RFC 4253 section 6).
            if packet_length < 5:
                self.fail(SshClientTransportError.ProtocolFailure, "SSH packet length is smaller than minimum")
                return
            if packet_length > self.max_frame:
                self.fail(SshClientTransportError.FrameTooLarge, "SSH packet exceeds configured frame limit")
                return
            var total = 4 + packet_length
            if self.encrypted:
                total = total + SSH_CLIENT_GCM_TAG_BYTES
            if total > self.max_buffer:
                self.fail(SshClientTransportError.FrameTooLarge, "SSH packet exceeds configured buffer limit")
                return
            if self.receive_buffer.len() < total: return
            self.frames.push(_sshct_copy_range(self.receive_buffer, 0, total))
            self.receive_buffer = _sshct_copy_range(self.receive_buffer, total, self.receive_buffer.len())

    me drain_frames() -> [[u8]]:
        val drained = self.frames
        self.frames = []
        drained

    me close_input():
        if self.closed: return
        if self.receive_buffer.len() > 0:
            self.fail(SshClientTransportError.UnexpectedEof, "peer closed during an SSH frame")
            return
        self.closed = true
        self.status = ssh_client_transport_failure(SshClientTransportError.Closed, "peer closed SSH transport")

fn ssh_client_wire_framer(max_frame: i64 = SSH_CLIENT_DEFAULT_MAX_FRAME,
        max_buffer: i64 = SSH_CLIENT_DEFAULT_MAX_BUFFER) -> SshClientWireFramer:
    var framer = SshClientWireFramer(receive_buffer: [], frames: [],
        max_frame: max_frame, max_buffer: max_buffer, encrypted: false,
        closed: false, status: ssh_client_transport_ok())
    if (max_frame < 5 or max_buffer < 4 + SSH_CLIENT_GCM_TAG_BYTES or
            max_frame > max_buffer - 4 - SSH_CLIENT_GCM_TAG_BYTES):
        framer.fail(SshClientTransportError.InvalidLimit, "SSH transport limits are invalid")
    framer

class SshClientTransportDriver:
    session: SshClientSession
    framer: SshClientWireFramer
    writes: [[u8]]
    banner_buffer: [u8]
    outbound_sequence: u32
    inbound_sequence: u32
    encrypted: bool
    closed: bool
    status: SshClientTransportStatus

    me fail(error: SshClientTransportError, detail: text):
        if self.closed: return
        self.closed = true
        self.status = ssh_client_transport_failure(error, detail)

    me queue_step(step: SshClientStep):
        self.session = step.session
        if not step.has_outbound: return
        if self.session.state == SSH_ST_BANNER:
            self.writes.push(step.outbound)
            return
        var wire: [u8] = []
        if self.encrypted:
            if self.session.negotiated_cipher == "aes128-gcm@openssh.com":
                wire = ssh_encrypt_packet_aes128_gcm(step.outbound, self.outbound_sequence,
                    self.session.keys.enc_key_c2s, self.session.keys.iv_c2s)
            else:
                wire = ssh_encrypt_packet_aes_gcm(step.outbound, self.outbound_sequence,
                    self.session.keys.enc_key_c2s, self.session.keys.iv_c2s)
        else:
            wire = ssh_packet_build(step.outbound, self.outbound_sequence)
        self.outbound_sequence = self.outbound_sequence + 1
        self.writes.push(wire)

    me start():
        if self.closed: return
        val result = ssh_client_session_start(self.session)
        if result.is_err():
            self.fail(SshClientTransportError.ProtocolFailure, result.unwrap_err())
            return
        self.queue_step(result.unwrap())

    me feed_banner(bytes: [u8]) -> i64:
        var consumed = 0
        while consumed < bytes.len():
            self.banner_buffer.push(bytes[consumed])
            consumed = consumed + 1
            if self.banner_buffer.len() > self.framer.max_frame:
                self.fail(SshClientTransportError.FrameTooLarge, "SSH banner exceeds configured frame limit")
                return consumed
            if ssh_client_banner_identification_ready(self.banner_buffer):
                val result = ssh_client_session_step(self.session, self.banner_buffer)
                self.banner_buffer = []
                if result.is_err():
                    self.fail(SshClientTransportError.ProtocolFailure, result.unwrap_err())
                    return consumed
                self.queue_step(result.unwrap())
                return consumed
        consumed

    me feed(bytes: [u8]):
        if self.closed: return
        var offset = 0
        if self.session.state == SSH_ST_BANNER:
            offset = self.feed_banner(bytes)
            if self.closed or self.session.state == SSH_ST_BANNER: return
        if offset < bytes.len():
            self.framer.feed(_sshct_copy_range(bytes, offset, bytes.len()))
        if not self.framer.status.ok:
            self.fail(self.framer.status.error, self.framer.status.detail)
            return
        val frames = self.framer.drain_frames()
        var i = 0
        while i < frames.len() and not self.closed:
            var payload: [u8] = []
            if self.encrypted:
                var decrypted: Result<[u8], text> = Err("SSH cipher was not selected")
                if self.session.negotiated_cipher_s2c == "aes128-gcm@openssh.com":
                    decrypted = ssh_decrypt_packet_aes128_gcm(frames[i], self.inbound_sequence,
                        self.session.keys.enc_key_s2c, self.session.keys.iv_s2c)
                else:
                    decrypted = ssh_decrypt_packet_aes_gcm(frames[i], self.inbound_sequence,
                        self.session.keys.enc_key_s2c, self.session.keys.iv_s2c)
                if decrypted.is_err():
                    self.fail(SshClientTransportError.ProtocolFailure, decrypted.unwrap_err())
                    return
                payload = decrypted.unwrap()
            else:
                val parsed = ssh_packet_read(frames[i], 0)
                if parsed.is_err():
                    self.fail(SshClientTransportError.ProtocolFailure, parsed.unwrap_err())
                    return
                payload = parsed.unwrap().packet.payload
            self.inbound_sequence = self.inbound_sequence + 1
            val was_newkeys = self.session.state == SSH_ST_NEWKEYS
            val result = ssh_client_session_step(self.session, payload)
            if result.is_err():
                self.fail(SshClientTransportError.ProtocolFailure, result.unwrap_err())
                return
            if was_newkeys:
                if (result.unwrap().session.negotiated_cipher != "aes256-gcm@openssh.com" and
                        result.unwrap().session.negotiated_cipher != "aes128-gcm@openssh.com"):
                    self.fail(SshClientTransportError.ProtocolFailure,
                        "SSH TCP adapter does not implement outbound cipher " + result.unwrap().session.negotiated_cipher)
                    return
                if (result.unwrap().session.negotiated_cipher_s2c != "aes256-gcm@openssh.com" and
                        result.unwrap().session.negotiated_cipher_s2c != "aes128-gcm@openssh.com"):
                    self.fail(SshClientTransportError.ProtocolFailure,
                        "SSH TCP adapter does not implement inbound cipher " + result.unwrap().session.negotiated_cipher_s2c)
                    return
                self.encrypted = true
                self.framer.encrypted = true
            self.queue_step(result.unwrap())
            if self.session.state == SSH_ST_DONE:
                self.closed = true
            i = i + 1

    me peer_closed():
        if self.closed: return
        if self.session.state == SSH_ST_DONE:
            self.closed = true
            return
        if self.banner_buffer.len() > 0 or self.framer.receive_buffer.len() > 0:
            self.fail(SshClientTransportError.UnexpectedEof, "peer closed with partial SSH input")
            return
        self.fail(SshClientTransportError.UnexpectedEof, "peer closed before SSH session completed")

    me drain_writes() -> [[u8]]:
        val drained = self.writes
        self.writes = []
        drained

fn ssh_client_transport_driver(session: SshClientSession,
        max_frame: i64 = SSH_CLIENT_DEFAULT_MAX_FRAME,
        max_buffer: i64 = SSH_CLIENT_DEFAULT_MAX_BUFFER) -> SshClientTransportDriver:
    val framer = ssh_client_wire_framer(max_frame, max_buffer)
    SshClientTransportDriver(session: session, framer: framer, writes: [],
        banner_buffer: [], outbound_sequence: 0, inbound_sequence: 0,
        encrypted: false, closed: not framer.status.ok, status: framer.status)

fn ssh_client_drive_tcp(stream: TcpStream, driver: SshClientTransportDriver,
        timeout_ms: i64 = SSH_CLIENT_DEFAULT_IO_TIMEOUT_MS) -> SshClientTransportStatus:
    """Run a configured session on an exclusively owned canonical TcpStream.

    This synchronous adapter does not spawn threads or share the descriptor.
    It closes the stream on every return path; callers must not reuse it.
    """
    if timeout_ms <= 0:
        return ssh_client_transport_failure(SshClientTransportError.InvalidLimit, "SSH I/O timeout must be positive")
    if stream.set_nodelay(true).is_err() or stream.set_read_timeout(timeout_ms).is_err() or stream.set_write_timeout(timeout_ms).is_err():
        stream.close_status()
        return ssh_client_transport_failure(SshClientTransportError.IoFailure, "failed to configure SSH TCP stream")
    driver.start()
    while not driver.closed:
        val writes = driver.drain_writes()
        var i = 0
        while i < writes.len():
            if stream.write_all(writes[i]).is_err():
                driver.fail(SshClientTransportError.IoFailure, "SSH TCP write failed")
                break
            i = i + 1
        if driver.closed: break
        val read_result = stream.read(8192)
        if read_result.is_err():
            driver.fail(SshClientTransportError.IoFailure, "SSH TCP read failed or timed out")
            break
        val bytes = read_result.unwrap()
        if bytes.len() == 0:
            driver.peer_closed()
        else:
            driver.feed(bytes)
    # A successful CHANNEL_CLOSE transition queues the reciprocal close and
    # enters DONE in the same read turn.  Flush only that successful terminal
    # output; never emit buffered protocol data after a failure.
    if driver.status.ok:
        val final_writes = driver.drain_writes()
        var final_i = 0
        while final_i < final_writes.len():
            if stream.write_all(final_writes[final_i]).is_err():
                driver.status = ssh_client_transport_failure(
                    SshClientTransportError.IoFailure, "SSH TCP final write failed")
                break
            final_i = final_i + 1
    stream.close_status()
    driver.status

export SSH_CLIENT_DEFAULT_MAX_FRAME, SSH_CLIENT_DEFAULT_MAX_BUFFER, SSH_CLIENT_DEFAULT_IO_TIMEOUT_MS
export SshClientTransportError, SshClientTransportStatus
export SshClientWireFramer, ssh_client_wire_framer
export ssh_client_banner_identification_ready
export SshClientTransportDriver, ssh_client_transport_driver, ssh_client_drive_tcp
