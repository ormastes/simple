# POSIX errno compatibility facade for SimpleOS.
#
# Numeric ABI status values are owned by os.kernel.errno so lower SimpleOS
# layers do not depend on the POSIX compatibility namespace.

export use os.kernel.errno.{ESUCCESS, EPERM, ENOENT, ESRCH, EINTR, EIO, ENXIO, E2BIG, ENOEXEC, EBADF, ECHILD, EAGAIN, ENOMEM, EACCES, EFAULT, EBUSY, EEXIST, EXDEV, ENODEV, ENOTDIR, EISDIR, EINVAL, ENFILE, EMFILE, ENOTTY, EFBIG, ENOSPC, ESPIPE, EROFS, EPIPE, ERANGE, ENAMETOOLONG, ENOSYS, ENOTEMPTY, ELOOP, ENOMSG, ENOTSOCK, EMSGSIZE, EPROTONOSUPPORT, EAFNOSUPPORT, EADDRINUSE, ENETUNREACH, ECONNRESET, ENOTCONN, ETIMEDOUT, ECONNREFUSED, EINPROGRESS, EWOULDBLOCK}
