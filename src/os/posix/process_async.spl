"""
# POSIX Process Async Facade

Ownership lives in `os.kernel.process_async`; POSIX re-exports it for compatibility.
"""

export use os.kernel.process_async.{PROCESS_MAX_REQUESTS, PROCESS_REQ_FREE, PROCESS_REQ_PENDING, PROCESS_REQ_COMPLETE, PROCESS_REQ_ERROR, PROCESS_OP_NONE, PROCESS_OP_FORK, PROCESS_OP_EXECVE, PROCESS_OP_SPAWN, PROCESS_OP_WAITPID, PROCESS_OP_EXIT, PROCESS_OP_GETPID, PROCESS_OP_SIGNAL, PROCESS_WNOHANG, process_async_init, process_async_alloc_request, process_async_free_request, process_async_is_complete, process_async_result, process_async_fork, process_async_execve, process_async_spawn, process_async_waitpid, process_async_getpid, process_async_signal, process_async_exit, process_wait_request}
