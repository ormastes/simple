# POSIX Server Tier-1 Port-Enabling Contract (Lane PXS)
#
# Master plan section 9.3 (`doc/01_research/domain/simpleos_production_host_master_plan.md`)
# gives the port-enabling ORDER for standing up LLVM / OpenSSH / SQLite / build
# systems on SimpleOS:
#
#   (1) posix_spawn/exec/waitpid -> (2) signals + process groups ->
#   (3) full FD semantics -> (4) pipes + AF_UNIX -> (5) poll/select -> ...
#
# This file is the TYPED CONTRACT for that first tier: a pure-Simple model,
# no live syscalls, no real libc build. It exists so the actual libc ports
# have a typed target and so the honest supported/unsupported status is
# machine-checked instead of asserted in prose. Statuses are aligned to the
# real profile matrix published by Lane P5:
#   `doc/02_requirements/os/posix_profiles.md`
#
# Honesty rule (mirrors P5): a facility whose backing is NOT actually
# implemented MUST report `unsupported` with a reason. It may never report a
# fake `supported`. `honesty_violations()` machine-checks this invariant.
#
# Order-as-dependency: the section 9.3 order is a real constraint, not a
# suggestion. `can_enable(name, enabled_set)` denies a facility whose
# prerequisite tier is not yet enabled (e.g. `poll` is denied until the
# full-FD-semantics tier `dup2` is enabled; `af_unix_socketpair` likewise).

use os.posix.errno.*

# ============================================================================
# Facility — one POSIX Server tier-1 facility and its SimpleOS backing/status
# ============================================================================

struct Facility:
    """A single POSIX facility, its owning profile, backing, and honest status.

    Fields:
      name        canonical facility id used by all query functions
      profile     "A" native SOSIX | "B" POSIX core | "C" POSIX server | "D" linux
      backing     SimpleOS facility / owning file that provides it
      status      "supported" | "partial" | "unsupported"
      implemented whether the backing is actually implemented (honesty anchor)
      reason      why this status (esp. for partial/unsupported)
    """
    name: text
    profile: text
    backing: text
    status: text
    implemented: bool
    reason: text

# ============================================================================
# The tier-1 facility table (driven by the P5 matrix)
# ============================================================================

fn all_facilities() -> [Facility]:
    """Return the fresh tier-1 facility table.

    Rebuilt on every call (arrays are value types); callers never mutate the
    canonical set. Statuses mirror `doc/02_requirements/os/posix_profiles.md`.
    """
    var facs: [Facility] = []

    # (1) posix_spawn/exec/waitpid — P5: implemented (sync wrapper), both the
    # host-Linux passthrough and the SimpleOS syscall path are wired.
    facs.push(Facility(
        name: "posix_spawn", profile: "B",
        backing: "os.kernel.process_compat + simpleos_process.c",
        status: "supported", implemented: true,
        reason: "sync spawn wrapper wired over kernel process path"))
    facs.push(Facility(
        name: "execve", profile: "B",
        backing: "os.kernel.process_compat + simpleos_process.c",
        status: "supported", implemented: true,
        reason: "execve wired; host passthrough + SimpleOS syscall path"))
    facs.push(Facility(
        name: "waitpid", profile: "B",
        backing: "os.kernel.process_compat + simpleos_process_wait.c",
        status: "supported", implemented: true,
        reason: "waitpid reaps child exit status via kernel wait path"))

    # fork — basic sync-wrapper fork exists, but COW fork sits at the END of
    # the section 9.3 order (extended compat). Honestly partial, not full.
    facs.push(Facility(
        name: "fork", profile: "B",
        backing: "os.kernel.process_compat + simpleos_fork.c",
        status: "partial", implemented: true,
        reason: "sync-wrapper fork wired; copy-on-write fork not yet (last in section 9.3 order)"))

    # (2) signals + process groups
    facs.push(Facility(
        name: "signals", profile: "B",
        backing: "signal_compat.spl + signal_dispatch.spl + simpleos_signal.c",
        status: "supported", implemented: true,
        reason: "signal/kill/sigprocmask/raise wired over SimpleOS signal syscalls"))
    facs.push(Facility(
        name: "process_groups", profile: "C",
        backing: "absent (no setpgid/getpgid symbol wired)",
        status: "unsupported", implemented: false,
        reason: "no setpgid/getpgid/setsid implementation exists yet; fail-closed"))

    # (3) full FD semantics — dup/dup2 over the FD table.
    facs.push(Facility(
        name: "dup2", profile: "B",
        backing: "os.kernel.fd_io.spl (facade os.posix.fd_io.spl) + simpleos_fs.c",
        status: "supported", implemented: true,
        reason: "open/read/write/close/lseek/dup/dup2 implemented over VFS IPC"))

    # (4) pipes + AF_UNIX
    facs.push(Facility(
        name: "pipe", profile: "B",
        backing: "os.kernel.pipe_compat.spl (ring buffer + notification pair)",
        status: "supported", implemented: true,
        reason: "pipe() wired via ring buffer + notification pair"))
    facs.push(Facility(
        name: "af_unix_socketpair", profile: "C",
        backing: "absent (no sys/un.h implementation beyond header)",
        status: "unsupported", implemented: false,
        reason: "AF_UNIX / socketpair not wired; fail-closed per P5 matrix"))

    # (5) poll/select
    facs.push(Facility(
        name: "poll", profile: "B",
        backing: "select_compat.spl + simpleos_poll.c (notification multiplexing)",
        status: "supported", implemented: true,
        reason: "poll() implemented via kernel notification multiplexing"))
    facs.push(Facility(
        name: "select", profile: "B",
        backing: "select_compat.spl + simpleos_poll.c (notification multiplexing)",
        status: "supported", implemented: true,
        reason: "select() implemented via kernel notification multiplexing"))

    return facs

# ============================================================================
# Lookup helpers
# ============================================================================

fn _streq(a: text, b: text) -> bool:
    return a == b

fn list_contains(xs: [text], v: text) -> bool:
    """True if `v` is present in `xs`. Public so specs can assert membership."""
    var i: u64 = 0
    while i < xs.len():
        if _streq(xs[i], v):
            return true
        i = i + 1
    return false

fn find_facility(name: text) -> Facility:
    """Look up a facility by name.

    Fail-closed default: an unknown name yields an `unsupported` facility, never
    a fake supported one.
    """
    val facs = all_facilities()
    var i: u64 = 0
    while i < facs.len():
        if _streq(facs[i].name, name):
            return facs[i]
        i = i + 1
    return Facility(
        name: name, profile: "?", backing: "unknown",
        status: "unsupported", implemented: false,
        reason: "unknown facility (fail-closed default)")

fn facility_status(name: text) -> text:
    """The honest status of `name`: supported | partial | unsupported."""
    return find_facility(name).status

fn facility_reason(name: text) -> text:
    """The reason string for the facility's status."""
    return find_facility(name).reason

fn facility_profile(name: text) -> text:
    """The owning profile (A/B/C/D) of `name`."""
    return find_facility(name).profile

# ============================================================================
# Profile queries
# ============================================================================

fn _profile_rank(p: text) -> i64:
    if _streq(p, "A"):
        return 0
    if _streq(p, "B"):
        return 1
    if _streq(p, "C"):
        return 2
    if _streq(p, "D"):
        return 3
    return 99

fn profile_supported_set(profile: text) -> [text]:
    """Names of facilities honestly SUPPORTED at the given profile.

    Profiles are cumulative on the POSIX axis: C (POSIX server) includes the B
    (POSIX core) surface, D includes C. Profile A is the native SOSIX async API
    and does NOT expose the POSIX adapter symbols, so its set is empty of these
    tier-1 facilities — that is the honest statement, not a bug. Only facilities
    whose status is `supported` are included.
    """
    val facs = all_facilities()
    val want = _profile_rank(profile)
    var out: [text] = []
    var i: u64 = 0
    while i < facs.len():
        val r = _profile_rank(facs[i].profile)
        if _streq(facs[i].status, "supported") and r >= 1 and r <= want:
            out.push(facs[i].name)
        i = i + 1
    return out

# ============================================================================
# Section 9.3 order as a real dependency constraint
# ============================================================================

fn prerequisites(name: text) -> [text]:
    """Facilities that MUST be enabled before `name` can be enabled.

    Encodes the master-plan section 9.3 port-enabling order as edges:
      spawn/exec/waitpid -> signals -> process_groups -> dup2(FD semantics)
      -> {pipe, af_unix_socketpair, poll, select}
    """
    if _streq(name, "signals"):
        return ["waitpid"]
    if _streq(name, "process_groups"):
        return ["signals"]
    if _streq(name, "dup2"):
        return ["process_groups"]
    if _streq(name, "pipe"):
        return ["dup2"]
    if _streq(name, "af_unix_socketpair"):
        return ["dup2"]
    if _streq(name, "poll"):
        return ["dup2"]
    if _streq(name, "select"):
        return ["dup2"]
    return []

fn can_enable(name: text, enabled: [text]) -> bool:
    """True only if every section 9.3 prerequisite of `name` is already enabled.

    This makes the port-enabling ORDER a machine-checked constraint: e.g.
    `can_enable("poll", set-without-dup2)` is false, and becomes true once the
    full-FD-semantics tier (`dup2`) is in `enabled`.
    """
    val reqs = prerequisites(name)
    var i: u64 = 0
    while i < reqs.len():
        if not list_contains(enabled, reqs[i]):
            return false
        i = i + 1
    return true

# ============================================================================
# Honesty invariant — machine-checked fail-closed rule
# ============================================================================

fn honesty_violations() -> [text]:
    """Names of facilities that report `supported` while NOT implemented.

    The fail-closed rule (mirroring Lane P5): a facility whose backing is not
    actually implemented must never report `supported`. A non-empty result is a
    dishonest-stub defect. The spec asserts this list is empty.
    """
    val facs = all_facilities()
    var out: [text] = []
    var i: u64 = 0
    while i < facs.len():
        if (not facs[i].implemented) and _streq(facs[i].status, "supported"):
            out.push(facs[i].name)
        i = i + 1
    return out
