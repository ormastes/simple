# Hosted dynamic-library runtime provider. Product loader code imports these
# semantic aliases and never declares or calls raw rt_* intrinsics directly.

@unsafe(reason: "host dynamic-library open ABI; non-positive handle is failure", capabilities: [ffi])
extern fn rt_host_dynlib_open(path: text, mode: i64) -> i64
@unsafe(reason: "host dynamic-library symbol ABI; non-positive address is failure", capabilities: [ffi])
extern fn rt_host_dynlib_symbol(handle: i64, name: text) -> i64
@unsafe(reason: "host dynamic-library close ABI; zero is success", capabilities: [ffi])
extern fn rt_host_dynlib_close(handle: i64) -> i64

fn host_dynlib_open(path: text, mode: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_host_dynlib_open(path, mode)

fn host_dynlib_symbol(handle: i64, name: text) -> i64:
    unsafe(capabilities: [ffi]):
        rt_host_dynlib_symbol(handle, name)

fn host_dynlib_close(handle: i64) -> i64:
    unsafe(capabilities: [ffi]):
        rt_host_dynlib_close(handle)
