"""
# POSIX Process Compatibility Facade

Ownership lives in `os.kernel.process_compat`; POSIX re-exports it for compatibility.
"""

export use os.kernel.process_compat.{WNOHANG, posix_fork, posix_execve, posix_spawn, posix_spawn_with_args, posix_waitpid, posix_exit, posix_getpid, posix_getppid, posix_kill}
