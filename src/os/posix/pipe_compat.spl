"""
# POSIX Pipe Compatibility Facade

Ownership lives in `os.kernel.pipe_compat`; POSIX re-exports it for compatibility.
"""

export use os.kernel.pipe_compat.{PIPE_BUF_SIZE, MAX_PIPES, pipe_init, posix_pipe, pipe_read, pipe_write, pipe_close_read, pipe_close_write, pipe_get_data_notif, pipe_get_space_notif, pipe_has_data, pipe_has_space}
