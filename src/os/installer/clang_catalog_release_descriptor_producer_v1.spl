"""Offline Pure Simple producer for one signed Clang catalog release.

The caller supplies already-computed payload and SCR1 digests in the canonical
loader order.  This module has no filesystem or foreign-function boundary.
"""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.crypto.ed25519.{
    pure_ed25519_sign_from_seed_v1}
use std.common.crypto.sha256.{sha256_u8_hex}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1}
use os.kernel.loader.clang_sysroot_catalog_bundle_v1.{
    CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1,
    clang_sysroot_catalog_required_paths_v1}
use os.kernel.loader.clang_catalog_release_descriptor_v1.{
    CLANG_CATALOG_RELEASE_DESCRIPTOR_DOMAIN_V1,
    ClangCatalogReleaseDescriptorRowV1, ClangCatalogReleaseDescriptorV1,
    clang_catalog_release_descriptor_signing_bytes_v1,
    clang_catalog_release_descriptor_verify_v1}
use os.kernel.loader.clang_catalog_release_descriptor_codec_v1.{
    encode_clang_catalog_release_descriptor_v1,
    decode_clang_catalog_release_descriptor_v1}

pub struct ClangCatalogReleaseDescriptorProduceResultV1:
    ok: bool
    reason: text
    descriptor_bytes: [u8]
    public_key: [u8]
    public_key_sha256: text

fn _producer_reject_v1(reason: text) -> ClangCatalogReleaseDescriptorProduceResultV1:
    ClangCatalogReleaseDescriptorProduceResultV1(
        ok: false, reason: reason, descriptor_bytes: [], public_key: [],
        public_key_sha256: "")

fn _bytes_equal_v1(left: [u8], right: [u8]) -> bool:
    if left.len() != right.len(): return false
    var index: i64 = 0
    while index < left.len():
        if left[index] != right[index]: return false
        index = index + 1
    true

pub fn produce_clang_catalog_release_descriptor_v1(
    target: ManifestTarget,
    release_id: text,
    signer_key_id: text,
    payload_sha256: [text],
    scr1_sha256: [text],
    signing_seed: [u8]
) -> ClangCatalogReleaseDescriptorProduceResultV1:
    """Sign and canonically encode exactly nine ordered catalog rows."""
    if (payload_sha256.len() != CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1 or
        scr1_sha256.len() != CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1):
        return _producer_reject_v1("digest-row-count-invalid")
    if signing_seed.len() != 32:
        return _producer_reject_v1("signing-key-invalid")
    val paths = clang_sysroot_catalog_required_paths_v1()
    if paths.len() != CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1:
        return _producer_reject_v1("catalog-shape-invalid")

    var rows: [ClangCatalogReleaseDescriptorRowV1] = []
    var index: i64 = 0
    while index < CLANG_SYSROOT_CATALOG_RECORD_COUNT_V1:
        rows.push(ClangCatalogReleaseDescriptorRowV1(
            canonical_path: paths[index],
            payload_sha256: payload_sha256[index],
            scr1_sha256: scr1_sha256[index]))
        index = index + 1
    val unsigned = ClangCatalogReleaseDescriptorV1(
        domain: CLANG_CATALOG_RELEASE_DESCRIPTOR_DOMAIN_V1,
        target: target, release_id: release_id,
        signer_key_id: signer_key_id, rows: rows, signature: [])
    val signing_result = clang_catalog_release_descriptor_signing_bytes_v1(unsigned)
    val signing_bytes = match signing_result:
        case Ok(value): value
        case Err(_): return _producer_reject_v1("descriptor-input-invalid")

    # The seed is borrowed. The safe-artifact authority that read it owns
    # compiler-resistant zeroization after this pure signing operation.
    val signed = pure_ed25519_sign_from_seed_v1(signing_seed, signing_bytes)
    if signed.public_key.len() != 32:
        return _producer_reject_v1("signing-failed")
    if signed.signature.len() != 64:
        return _producer_reject_v1("signing-failed")
    val descriptor = ClangCatalogReleaseDescriptorV1(
        domain: unsigned.domain, target: unsigned.target,
        release_id: unsigned.release_id,
        signer_key_id: unsigned.signer_key_id, rows: unsigned.rows,
        signature: signed.signature)
    val root = ExecutableManifestTrustedSignerV1(
        key_id: signer_key_id, public_key: signed.public_key)
    if not clang_catalog_release_descriptor_verify_v1(
        descriptor, [root]).ok:
        return _producer_reject_v1("self-verification-failed")
    val encoded = encode_clang_catalog_release_descriptor_v1(descriptor)
    if not encoded.ok:
        return _producer_reject_v1("encoding-failed")
    val decoded = decode_clang_catalog_release_descriptor_v1(encoded.bytes)
    if not decoded.ok or not clang_catalog_release_descriptor_verify_v1(
        decoded.value, [root]).ok:
        return _producer_reject_v1("encoding-consistency-failed")
    val canonical = encode_clang_catalog_release_descriptor_v1(decoded.value)
    if not canonical.ok or not _bytes_equal_v1(canonical.bytes, encoded.bytes):
        return _producer_reject_v1("encoding-consistency-failed")

    ClangCatalogReleaseDescriptorProduceResultV1(
        ok: true, reason: "", descriptor_bytes: encoded.bytes,
        public_key: signed.public_key,
        public_key_sha256: sha256_u8_hex(signed.public_key))
