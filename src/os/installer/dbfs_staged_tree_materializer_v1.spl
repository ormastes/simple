"""Bounded retained-tree to DBFS materialization bridge.

DBFS currently publishes one streamed inode at a time.  It does not expose a
transaction that can publish a complete namespace generation containing many
new files.  This adapter therefore promises per-file atomicity only and makes
that limitation explicit in every tree receipt.  A file remains in a private
DBFS blob reservation until its retained identity and SHA-256 are revalidated.
"""

use os.installer.staged_root_tree_enumerator_v1.{
    StagedRootTreeEntryKindV1, StagedRootTreeEnumerationV1,
    StagedRootTreeEntryV1}
use os.installer.staged_root_tree_retained_provider_v1.{
    StagedRootTreeRetainedProviderV1}
use nogc_sync_mut.db.dbfs_driver.dbfs_driver.{DbFsDriver}
use nogc_sync_mut.db.dbfs_driver.streaming_ingest.{
    DBFS_STREAM_INGEST_MAX_CHUNK_BYTES, DbfsPublicationStateV1,
    DbfsStreamIngestLease}
use nogc_sync_mut.fs_driver.nvfs_driver.{
    NvfsDriver, NvfsStreamIngestLeaseV1, NvfsPublicationStateV1,
    NVFS_STREAM_INGEST_PROVIDER_V1}
use std.fs_driver.error.{FsError}
use std.common.crypto.sha256.{
    sha256_stream_v1_new, sha256_stream_v1_update,
    sha256_stream_v1_finish_hex}

pub class DbfsStagedFileMaterializeReceiptV1:
    ok: bool
    error_code: text
    exact_path: text
    exact_size: i64
    sha256: text
    published: bool
    publication_state: text

pub class DbfsStagedTreeMaterializeReceiptV1:
    ok: bool
    error_code: text
    error_path: text
    files_planned: i64
    files_published: i64
    directories_planned: i64
    directories_published: i64
    bytes_published: i64
    tree_atomic: bool
    publication_model: text
    current_entry_state: text

pub(package) enum StagedTreePublicationSinkV1:
    Dbfs(driver: DbFsDriver)
    Nvfs(driver: NvfsDriver)

enum StagedTreePublicationLeaseV1:
    Dbfs(lease: DbfsStreamIngestLease)
    Nvfs(lease: NvfsStreamIngestLeaseV1)

class StagedTreeSinkOutcomeV1:
    state: text
    error_code: text
    size: i64
    bytes_written: i64
    sha256: text
    evidence_present: bool

fn _sink_begin_v1(sink: StagedTreePublicationSinkV1, path: text,
    exact_size: i64) -> Result<StagedTreePublicationLeaseV1, FsError>:
    match sink:
        case StagedTreePublicationSinkV1.Dbfs(driver):
            val lease = driver.stream_ingest_begin(path, exact_size)?
            Ok(StagedTreePublicationLeaseV1.Dbfs(lease: lease))
        case StagedTreePublicationSinkV1.Nvfs(driver):
            val lease = driver.stream_ingest_begin_v1(path, exact_size)?
            Ok(StagedTreePublicationLeaseV1.Nvfs(lease: lease))

fn _sink_append_v1(sink: StagedTreePublicationSinkV1,
    lease: StagedTreePublicationLeaseV1, offset: i64,
    data: [u8]) -> Result<i64, FsError>:
    match sink:
        case StagedTreePublicationSinkV1.Dbfs(driver):
            match lease:
                case StagedTreePublicationLeaseV1.Dbfs(value):
                    driver.stream_ingest_append(value, offset, data)
                else: Err(FsError.InvalidArg)
        case StagedTreePublicationSinkV1.Nvfs(driver):
            match lease:
                case StagedTreePublicationLeaseV1.Nvfs(value):
                    driver.stream_ingest_append_v1(value, offset, data)
                else: Err(FsError.InvalidArg)

fn _sink_abort_v1(sink: StagedTreePublicationSinkV1,
    lease: StagedTreePublicationLeaseV1) -> bool:
    val result = match sink:
        case StagedTreePublicationSinkV1.Dbfs(driver):
            match lease:
                case StagedTreePublicationLeaseV1.Dbfs(value):
                    driver.stream_ingest_abort(value)
                else: Err(FsError.InvalidArg)
        case StagedTreePublicationSinkV1.Nvfs(driver):
            match lease:
                case StagedTreePublicationLeaseV1.Nvfs(value):
                    driver.stream_ingest_abort_v1(value)
                else: Err(FsError.InvalidArg)
    result.is_ok() and result.unwrap()

fn _sink_finish_v1(sink: StagedTreePublicationSinkV1,
    lease: StagedTreePublicationLeaseV1,
    expected_sha256: text) -> StagedTreeSinkOutcomeV1:
    match sink:
        case StagedTreePublicationSinkV1.Dbfs(driver):
            match lease:
                case StagedTreePublicationLeaseV1.Dbfs(value):
                    val outcome = driver.stream_ingest_finish_outcome_v1(
                        value, expected_sha256)
                    val state = if outcome.publication_state() == DbfsPublicationStateV1.Published:
                        "published"
                    elif outcome.publication_state() == DbfsPublicationStateV1.Indeterminate:
                        "indeterminate"
                    else: "not-published"
                    if val evidence = outcome.publication_evidence():
                        return StagedTreeSinkOutcomeV1(
                            state: state, error_code: outcome.publication_error_code(),
                            size: evidence.size(), bytes_written: evidence.bytes_written(),
                            sha256: evidence.stored_sha256(), evidence_present: true)
                    StagedTreeSinkOutcomeV1(state: state,
                        error_code: outcome.publication_error_code(), size: 0,
                        bytes_written: 0, sha256: "", evidence_present: false)
                else: StagedTreeSinkOutcomeV1(state: "not-published",
                    error_code: "staged-tree-sink-lease-mismatch", size: 0,
                    bytes_written: 0, sha256: "", evidence_present: false)
        case StagedTreePublicationSinkV1.Nvfs(driver):
            match lease:
                case StagedTreePublicationLeaseV1.Nvfs(value):
                    val outcome = driver.stream_ingest_finish_outcome_v1(
                        value, expected_sha256)
                    val state = if outcome.publication_state() == NvfsPublicationStateV1.Published:
                        "published"
                    elif outcome.publication_state() == NvfsPublicationStateV1.Indeterminate:
                        "indeterminate"
                    else: "not-published"
                    if outcome.provider_id() != NVFS_STREAM_INGEST_PROVIDER_V1:
                        return StagedTreeSinkOutcomeV1(state: state,
                            error_code: "nvfs-publication-provider-mismatch",
                            size: 0, bytes_written: 0, sha256: "",
                            evidence_present: false)
                    if val evidence = outcome.publication_evidence():
                        return StagedTreeSinkOutcomeV1(
                            state: state, error_code: outcome.publication_error_code(),
                            size: evidence.size(), bytes_written: evidence.bytes_written(),
                            sha256: evidence.stored_sha256(), evidence_present: true)
                    StagedTreeSinkOutcomeV1(state: state,
                        error_code: outcome.publication_error_code(), size: 0,
                        bytes_written: 0, sha256: "", evidence_present: false)
                else: StagedTreeSinkOutcomeV1(state: "not-published",
                    error_code: "staged-tree-sink-lease-mismatch", size: 0,
                    bytes_written: 0, sha256: "", evidence_present: false)

fn _sink_mkdir_v1(sink: StagedTreePublicationSinkV1,
    path: text) -> StagedTreeSinkOutcomeV1:
    match sink:
        case StagedTreePublicationSinkV1.Dbfs(driver):
            val outcome = driver.mkdir_publication_outcome_v1(path, 0o755u32)
            val state = if outcome.publication_state() == DbfsPublicationStateV1.Published:
                "published"
            elif outcome.publication_state() == DbfsPublicationStateV1.Indeterminate:
                "indeterminate"
            else: "not-published"
            StagedTreeSinkOutcomeV1(state: state,
                error_code: outcome.publication_error_code(), size: 0,
                bytes_written: 0, sha256: "", evidence_present: false)
        case StagedTreePublicationSinkV1.Nvfs(driver):
            val outcome = driver.mkdir_publication_outcome_v1(path, 0o755u32)
            val state = if outcome.publication_state() == NvfsPublicationStateV1.Published:
                "published"
            elif outcome.publication_state() == NvfsPublicationStateV1.Indeterminate:
                "indeterminate"
            else: "not-published"
            if outcome.provider_id() != NVFS_STREAM_INGEST_PROVIDER_V1:
                return StagedTreeSinkOutcomeV1(state: state,
                    error_code: "nvfs-publication-provider-mismatch",
                    size: 0, bytes_written: 0, sha256: "",
                    evidence_present: false)
            StagedTreeSinkOutcomeV1(state: state,
                error_code: outcome.publication_error_code(), size: 0,
                bytes_written: 0, sha256: "", evidence_present: false)

fn _dbfs_staged_file_error_v1(code: text, path: text,
    exact_size: i64) -> DbfsStagedFileMaterializeReceiptV1:
    DbfsStagedFileMaterializeReceiptV1(
        ok: false, error_code: code, exact_path: path,
        exact_size: exact_size, sha256: "", published: false,
        publication_state: "not-published")

fn _materialize_retained_file_to_sink_v1(
    sink: StagedTreePublicationSinkV1,
    provider: StagedRootTreeRetainedProviderV1,
    entry: StagedRootTreeEntryV1,
) -> DbfsStagedFileMaterializeReceiptV1:
    if entry.kind != StagedRootTreeEntryKindV1.Regular:
        return _dbfs_staged_file_error_v1(
            "dbfs-materializer-entry-not-regular", entry.relative_path,
            entry.size_bytes)
    val exact_path = "/" + entry.relative_path
    val provider_lease = provider.validate_file(entry)
    if not provider_lease.ok:
        return _dbfs_staged_file_error_v1(
            provider_lease.error_code, exact_path, entry.size_bytes)
    val ingest_result = _sink_begin_v1(sink, exact_path, entry.size_bytes)
    if ingest_result.is_err():
        val _ = provider.abort_file(provider_lease)
        return _dbfs_staged_file_error_v1(
            "dbfs-materializer-ingest-begin-failed", exact_path,
            entry.size_bytes)
    val ingest_lease = ingest_result.unwrap()
    val digest = sha256_stream_v1_new()
    var offset: i64 = 0
    while offset < entry.size_bytes:
        val remaining = entry.size_bytes - offset
        val count = if remaining < DBFS_STREAM_INGEST_MAX_CHUNK_BYTES:
            remaining
        else:
            DBFS_STREAM_INGEST_MAX_CHUNK_BYTES
        val read = provider.read_file(provider_lease, offset, count)
        if not read.ok or read.offset != offset or
            read.next_offset != offset + read.data.len() or
            read.data.len() as i64 != count:
            val _ = _sink_abort_v1(sink, ingest_lease)
            val _ = provider.abort_file(provider_lease)
            return _dbfs_staged_file_error_v1(
                "dbfs-materializer-retained-read-failed", exact_path,
                entry.size_bytes)
        if not sha256_stream_v1_update(digest, read.data):
            val _ = _sink_abort_v1(sink, ingest_lease)
            val _ = provider.abort_file(provider_lease)
            return _dbfs_staged_file_error_v1(
                "dbfs-materializer-sha-update-failed", exact_path,
                entry.size_bytes)
        val appended = _sink_append_v1(sink, ingest_lease, offset, read.data)
        if appended.is_err() or appended.unwrap() != count:
            val _ = _sink_abort_v1(sink, ingest_lease)
            val _ = provider.abort_file(provider_lease)
            return _dbfs_staged_file_error_v1(
                "dbfs-materializer-ingest-append-failed", exact_path,
                entry.size_bytes)
        offset = offset + count
    val streamed_sha = sha256_stream_v1_finish_hex(digest)
    if streamed_sha.is_none() or
        streamed_sha.unwrap() != entry.provider_digest_sha256:
        val _ = _sink_abort_v1(sink, ingest_lease)
        val _ = provider.abort_file(provider_lease)
        return _dbfs_staged_file_error_v1(
            "dbfs-materializer-sha-mismatch", exact_path, entry.size_bytes)
    val finish = provider.finish_file(
        provider_lease, entry.size_bytes, streamed_sha.unwrap())
    if not finish.ok or
        finish.admission_digest_sha256 != entry.provider_digest_sha256:
        val _ = _sink_abort_v1(sink, ingest_lease)
        val _ = provider.abort_file(provider_lease)
        return _dbfs_staged_file_error_v1(
            "dbfs-materializer-retained-finish-failed", exact_path,
            entry.size_bytes)
    val outcome = _sink_finish_v1(
        sink, ingest_lease, entry.provider_digest_sha256)
    if outcome.state == "not-published":
        val _ = _sink_abort_v1(sink, ingest_lease)
        return _dbfs_staged_file_error_v1(
            outcome.error_code, exact_path,
            entry.size_bytes)
    if outcome.state == "indeterminate":
        return DbfsStagedFileMaterializeReceiptV1(
            ok: false, error_code: outcome.error_code,
            exact_path: exact_path, exact_size: entry.size_bytes,
            sha256: entry.provider_digest_sha256, published: false,
            publication_state: "indeterminate")
    if not outcome.evidence_present:
        return DbfsStagedFileMaterializeReceiptV1(
            ok: false, error_code: "dbfs-materializer-published-evidence-absent",
            exact_path: exact_path, exact_size: entry.size_bytes,
            sha256: entry.provider_digest_sha256, published: true,
            publication_state: "published")
    if outcome.size != entry.size_bytes or
        outcome.bytes_written != entry.size_bytes or
        outcome.sha256 != entry.provider_digest_sha256:
        return DbfsStagedFileMaterializeReceiptV1(
            ok: false,
            error_code: "dbfs-materializer-published-evidence-mismatch",
            exact_path: exact_path, exact_size: entry.size_bytes,
            sha256: outcome.sha256, published: true,
            publication_state: "published")
    if outcome.error_code != "":
        return DbfsStagedFileMaterializeReceiptV1(
            ok: false, error_code: outcome.error_code,
            exact_path: exact_path, exact_size: entry.size_bytes,
            sha256: outcome.sha256, published: true,
            publication_state: "published")
    DbfsStagedFileMaterializeReceiptV1(
        ok: true, error_code: "", exact_path: exact_path,
        exact_size: entry.size_bytes,
        sha256: entry.provider_digest_sha256, published: true,
        publication_state: "published")

pub(package) fn dbfs_materialize_retained_file_v1(
    driver: DbFsDriver, provider: StagedRootTreeRetainedProviderV1,
    entry: StagedRootTreeEntryV1,
) -> DbfsStagedFileMaterializeReceiptV1:
    _materialize_retained_file_to_sink_v1(
        StagedTreePublicationSinkV1.Dbfs(driver: driver), provider, entry)

pub(package) fn nvfs_materialize_retained_file_with_sink_v1(
    driver: NvfsDriver, provider: StagedRootTreeRetainedProviderV1,
    entry: StagedRootTreeEntryV1,
) -> DbfsStagedFileMaterializeReceiptV1:
    _materialize_retained_file_to_sink_v1(
        StagedTreePublicationSinkV1.Nvfs(driver: driver), provider, entry)

pub(package) fn materialize_retained_tree_with_sink_v1(
    sink: StagedTreePublicationSinkV1,
    provider: StagedRootTreeRetainedProviderV1,
    plan: StagedRootTreeEnumerationV1, publication_model: text,
) -> DbfsStagedTreeMaterializeReceiptV1:
    if not plan.ok:
        return DbfsStagedTreeMaterializeReceiptV1(
            ok: false, error_code: plan.error_code,
            error_path: plan.error_path,
            files_planned: plan.regular_file_count,
            files_published: 0, directories_planned: plan.directory_count,
            directories_published: 0, bytes_published: 0, tree_atomic: false,
            publication_model: publication_model,
            current_entry_state: "not-published")
    var files_published: i64 = 0
    var directories_published: i64 = 0
    var bytes_published: i64 = 0
    for entry in plan.entries:
        if entry.kind == StagedRootTreeEntryKindV1.Directory:
            val exact_directory = "/" + entry.relative_path
            val directory_outcome = _sink_mkdir_v1(sink, exact_directory)
            if directory_outcome.state != "published" or
                directory_outcome.error_code != "":
                val published_directories = if directory_outcome.state == "published":
                    directories_published + 1
                else: directories_published
                return DbfsStagedTreeMaterializeReceiptV1(
                    ok: false, error_code: directory_outcome.error_code,
                    error_path: exact_directory,
                    files_planned: plan.regular_file_count,
                    files_published: files_published,
                    directories_planned: plan.directory_count,
                    directories_published: published_directories,
                    bytes_published: bytes_published, tree_atomic: false,
                    publication_model: publication_model,
                    current_entry_state: directory_outcome.state)
            directories_published = directories_published + 1
        elif entry.kind == StagedRootTreeEntryKindV1.Regular:
            val receipt = _materialize_retained_file_to_sink_v1(
                sink, provider, entry)
            if not receipt.ok:
                val published_count = if receipt.published:
                    files_published + 1
                else:
                    files_published
                val published_bytes = if receipt.published:
                    bytes_published + receipt.exact_size
                else:
                    bytes_published
                return DbfsStagedTreeMaterializeReceiptV1(
                    ok: false, error_code: receipt.error_code,
                    error_path: receipt.exact_path,
                    files_planned: plan.regular_file_count,
                    files_published: published_count,
                    directories_planned: plan.directory_count,
                    directories_published: directories_published,
                    bytes_published: published_bytes, tree_atomic: false,
                    publication_model: publication_model,
                    current_entry_state: receipt.publication_state)
            files_published = files_published + 1
            bytes_published = bytes_published + receipt.exact_size
        else:
            return DbfsStagedTreeMaterializeReceiptV1(
                ok: false,
                error_code: "dbfs-materializer-unsupported-entry-kind",
                error_path: "/" + entry.relative_path,
                files_planned: plan.regular_file_count,
                files_published: files_published,
                directories_planned: plan.directory_count,
                directories_published: directories_published,
                bytes_published: bytes_published, tree_atomic: false,
                publication_model: publication_model,
                current_entry_state: "not-published")
    DbfsStagedTreeMaterializeReceiptV1(
        ok: files_published == plan.regular_file_count and
            directories_published == plan.directory_count, error_code: "",
        error_path: "", files_planned: plan.regular_file_count,
        files_published: files_published,
        directories_planned: plan.directory_count,
        directories_published: directories_published,
        bytes_published: bytes_published,
        tree_atomic: false,
        publication_model: publication_model,
        current_entry_state: "published")

pub(package) fn image_builder_materialize_retained_tree_to_dbfs_v1(
    driver: DbFsDriver, provider: StagedRootTreeRetainedProviderV1,
    plan: StagedRootTreeEnumerationV1,
) -> DbfsStagedTreeMaterializeReceiptV1:
    materialize_retained_tree_with_sink_v1(
        StagedTreePublicationSinkV1.Dbfs(driver: driver), provider, plan,
        "dbfs-per-entry-atomic-v1")
