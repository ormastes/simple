"""Owned descriptor-relative provider for staged-root enumeration and streaming.

The native boundary owns a fixed-capacity session containing the root, every
walked directory, and every regular file.  This Pure Simple facade owns that
session as one linear lifecycle.  Snapshots and read receipts are value copies;
only this object may redeem the opaque handle.  Reads are positioned on the
retained file descriptor and never reopen `relative_path`.

The production provider is Linux-hosted only.  Other native hosts fail closed;
the SimpleOS kernel needs a separate VFS-native retained-tree owner rather than
path emulation.
"""

use os.installer.staged_root_tree_enumerator_v1.*

pub const STAGED_ROOT_TREE_READ_MAX_BYTES_V1: i64 = 1048576

@unsafe(reason: "opens and retains one descriptor-relative staged tree", capabilities: [ffi])
extern fn rt_staged_tree_provider_open_v1(root: text, max_depth: i64,
    max_entries: i64, max_file_bytes: i64, max_aggregate_bytes: i64) -> i64
extern fn rt_staged_tree_provider_receipt_v1(handle: i64) -> i64
@unsafe(reason: "reads immutable metadata from the retained tree owner", capabilities: [ffi])
extern fn rt_staged_tree_provider_scalar_v1(handle: i64, receipt: i64,
    entry: i64, field: i64) -> i64
@unsafe(reason: "copies one bounded retained relative path", capabilities: [ffi])
extern fn rt_staged_tree_provider_path_v1(handle: i64, receipt: i64,
    entry: i64) -> text?
extern fn rt_staged_tree_provider_digest_v1(handle: i64, receipt: i64,
    entry: i64) -> text?
@unsafe(reason: "positioned read through a retained regular-file descriptor", capabilities: [ffi])
extern fn rt_staged_tree_provider_read_v1(handle: i64, receipt: i64,
    slot: i64, offset: i64, max_bytes: i64) -> [u8]?
@unsafe(reason: "revalidates the retained descriptor identity after streaming", capabilities: [ffi])
extern fn rt_staged_tree_provider_finish_v1(handle: i64, receipt: i64,
    slot: i64, expected_size: i64, streamed_digest_sha256: text) -> i64
@unsafe(reason: "consumes all descriptors owned by a retained tree session", capabilities: [ffi])
extern fn rt_staged_tree_provider_close_v1(handle: i64, receipt: i64) -> i64

pub class StagedRootTreeRetainedReadV1:
    ok: bool
    error_code: text
    data: [u8]
    offset: i64
    next_offset: i64
    eof: bool
    device: i64
    inode: i64
    size_bytes: i64

pub class StagedRootTreeRetainedFinishV1:
    ok: bool
    error_code: text
    device: i64
    inode: i64
    size_bytes: i64
    admission_digest_sha256: text

class StagedRootTreeFileLeaseAuthorityV1:
    provider_receipt: u64
    provider_slot: i64
    generation: u64
    nonce: u64

pub(package) class StagedRootTreeRetainedValidationV1:
    ok: bool
    error_code: text
    admission_digest_sha256: text
    _authority: StagedRootTreeFileLeaseAuthorityV1

pub class StagedRootTreeProviderCloseV1:
    ok: bool
    quarantined: bool
    error_code: text

pub(package) class StagedRootTreeRetainedProviderV1:
    _handle: i64
    _receipt: u64
    _root_device: i64
    _entry_count: i64
    _closed: bool
    _quarantined: bool
    _next_lease_generation: u64
    _active_lease_generation: u64
    _active_lease_slot: i64
    _active_lease_nonce: u64

    fn receipt() -> u64: self._receipt
    fn is_closed() -> bool: self._closed
    fn is_quarantined() -> bool: self._quarantined

    fn snapshot() -> Result<StagedRootTreeProviderSnapshotV1, text>:
        if self._closed or self._quarantined or self._handle <= 0:
            return Err("retained-tree-provider-not-live")
        var entries: [StagedRootTreeProviderEntryV1] = []
        var index: i64 = 0
        while index < self._entry_count:
            val path_result = _staged_root_tree_provider_path_v1(
                self._handle, self._receipt, index)
            if path_result.is_err(): return Err(path_result.unwrap_err())
            val kind_value = _staged_root_tree_provider_scalar_v1(
                self._handle, self._receipt, index, 0)
            val kind = if kind_value == 1:
                StagedRootTreeEntryKindV1.Directory
            elif kind_value == 2:
                StagedRootTreeEntryKindV1.Regular
            else:
                return Err("retained-tree-provider-invalid-kind")
            val digest = if kind_value == 2:
                _staged_root_tree_provider_digest_v1(self._handle, self._receipt, index)
            else:
                ""
            if kind_value == 2 and digest.len() != 64:
                return Err("retained-tree-provider-invalid-digest")
            entries.push(StagedRootTreeProviderEntryV1(
                relative_path: path_result.unwrap(), kind: kind,
                device: _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, index, 1),
                inode: _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, index, 2),
                link_count: _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, index, 3),
                size_bytes: _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, index, 4),
                modified_seconds: _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, index, 5),
                modified_nanoseconds: _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, index, 6),
                provider_receipt: self._receipt,
                provider_slot: _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, index, 7),
                provider_digest_sha256: digest))
            index = index + 1
        Ok(StagedRootTreeProviderSnapshotV1(
            root_device: self._root_device, provider_receipt: self._receipt,
            root_retained: true, directories_retained: true,
            nofollow_walk: true, walk_complete: true, entries: entries))

    fn enumerate(bounds: StagedRootTreeBoundsV1) -> StagedRootTreeEnumerationV1:
        val snapshot_result = self.snapshot()
        if snapshot_result.is_err():
            return StagedRootTreeEnumerationV1(
                ok: false, error_code: snapshot_result.unwrap_err(), error_path: "",
                entries: [], regular_file_count: 0, directory_count: 0,
                aggregate_file_bytes: 0)
        staged_root_tree_enumerate_v1(snapshot_result.unwrap(), bounds)

    me read_file(lease: StagedRootTreeRetainedValidationV1,
        offset: i64, max_bytes: i64) -> StagedRootTreeRetainedReadV1:
        if self._closed or self._quarantined:
            return _staged_root_tree_read_error_v1("retained-tree-provider-not-live")
        if not _staged_root_tree_lease_matches_v1(self, lease):
            return _staged_root_tree_read_error_v1("retained-tree-foreign-receipt")
        val provider_receipt = lease._authority.provider_receipt
        val provider_slot = lease._authority.provider_slot
        if provider_slot < 0 or provider_slot >= self._entry_count or offset < 0 or
            max_bytes < 0 or max_bytes > STAGED_ROOT_TREE_READ_MAX_BYTES_V1:
            return _staged_root_tree_read_error_v1("retained-tree-invalid-read")
        val kind = _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, provider_slot, 0)
        val device = _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, provider_slot, 1)
        val inode = _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, provider_slot, 2)
        val size_bytes = _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, provider_slot, 4)
        if kind != 2 or device != self._root_device or inode <= 0 or
            size_bytes < 0 or offset > size_bytes:
            return _staged_root_tree_read_error_v1("retained-tree-slot-not-regular")
        var payload: [u8]? = nil
        unsafe(capabilities: [ffi]):
            payload = rt_staged_tree_provider_read_v1(
                self._handle, provider_receipt.to_i64(), provider_slot,
                offset, max_bytes)
        if val data = payload:
            val next_offset = offset + data.len()
            if next_offset < offset or next_offset > size_bytes:
                self._quarantined = true
                return _staged_root_tree_read_error_v1("retained-tree-read-overflow")
            return StagedRootTreeRetainedReadV1(
                ok: true, error_code: "", data: data, offset: offset,
                next_offset: next_offset, eof: next_offset == size_bytes,
                device: device, inode: inode, size_bytes: size_bytes)
        self._quarantined = true
        _staged_root_tree_read_error_v1("retained-tree-native-read-failed")

    me validate_file(entry: StagedRootTreeEntryV1) -> StagedRootTreeRetainedValidationV1:
        if self._closed or self._quarantined or
            entry.kind != StagedRootTreeEntryKindV1.Regular or
            entry.provider_receipt != self._receipt or entry.provider_slot < 0 or
            entry.provider_slot >= self._entry_count or self._active_lease_generation != 0u64 or
            self._next_lease_generation == 0xffffffffffffffffu64:
            return _staged_root_tree_validation_error_v1("retained-tree-row-authority-mismatch")
        val slot = entry.provider_slot
        val path_result = _staged_root_tree_provider_path_v1(self._handle, self._receipt, slot)
        if path_result.is_err() or path_result.unwrap() != entry.relative_path or
            _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, slot, 0) != 2 or
            _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, slot, 1) != entry.device or
            _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, slot, 2) != entry.inode or
            _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, slot, 4) != entry.size_bytes or
            _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, slot, 5) != entry.modified_seconds or
            _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, slot, 6) != entry.modified_nanoseconds:
            return _staged_root_tree_validation_error_v1("retained-tree-row-metadata-mismatch")
        val digest = _staged_root_tree_provider_digest_v1(self._handle, self._receipt, slot)
        if digest.len() != 64 or digest != entry.provider_digest_sha256:
            return _staged_root_tree_validation_error_v1("retained-tree-row-digest-mismatch")
        self._next_lease_generation = self._next_lease_generation + 1u64
        var nonce = self._receipt ^ self._handle.to_u64() ^
            self._next_lease_generation ^ 0xd6e8feb86659fd93u64
        if nonce == 0u64: nonce = 0xa5a5a5a5a5a5a5a5u64
        self._active_lease_generation = self._next_lease_generation
        self._active_lease_slot = slot
        self._active_lease_nonce = nonce
        StagedRootTreeRetainedValidationV1(ok: true, error_code: "",
            admission_digest_sha256: digest,
            _authority: StagedRootTreeFileLeaseAuthorityV1(
                provider_receipt: self._receipt, provider_slot: slot,
                generation: self._next_lease_generation, nonce: nonce))

    me finish_file(lease: StagedRootTreeRetainedValidationV1, expected_size: i64,
        streamed_digest_sha256: text) -> StagedRootTreeRetainedFinishV1:
        if self._closed or self._quarantined or not _staged_root_tree_lease_matches_v1(self, lease) or
            expected_size < 0 or
            streamed_digest_sha256.len() != 64:
            return _staged_root_tree_finish_error_v1("retained-tree-invalid-finish")
        val provider_receipt = lease._authority.provider_receipt
        val provider_slot = lease._authority.provider_slot
        val device = _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, provider_slot, 1)
        val inode = _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, provider_slot, 2)
        val size_bytes = _staged_root_tree_provider_scalar_v1(self._handle, self._receipt, provider_slot, 4)
        var status: i64 = 0
        unsafe(capabilities: [ffi]):
            status = rt_staged_tree_provider_finish_v1(
                self._handle, provider_receipt.to_i64(), provider_slot, expected_size,
                streamed_digest_sha256)
        if status != 1:
            self._quarantined = true
            return _staged_root_tree_finish_error_v1("retained-tree-identity-changed")
        self._active_lease_generation = 0u64
        self._active_lease_slot = -1
        self._active_lease_nonce = 0u64
        StagedRootTreeRetainedFinishV1(
            ok: true, error_code: "", device: device, inode: inode,
            size_bytes: size_bytes,
            admission_digest_sha256: streamed_digest_sha256)

    me abort_file(lease: StagedRootTreeRetainedValidationV1) -> bool:
        if not _staged_root_tree_lease_matches_v1(self, lease): return false
        self._active_lease_generation = 0u64
        self._active_lease_slot = -1
        self._active_lease_nonce = 0u64
        true

    me close() -> StagedRootTreeProviderCloseV1:
        if self._closed:
            return StagedRootTreeProviderCloseV1(
                ok: false, quarantined: self._quarantined,
                error_code: "retained-tree-provider-already-closed")
        var status: i64 = 0
        if self._active_lease_generation != 0u64:
            return StagedRootTreeProviderCloseV1(ok: false, quarantined: false,
                error_code: "retained-tree-file-lease-outstanding")
        unsafe(capabilities: [ffi]):
            status = rt_staged_tree_provider_close_v1(self._handle, self._receipt.to_i64())
        self._closed = true
        self._handle = -1
        if status != 1:
            self._quarantined = true
            return StagedRootTreeProviderCloseV1(
                ok: false, quarantined: true,
                error_code: "retained-tree-provider-close-failed")
        StagedRootTreeProviderCloseV1(ok: true, quarantined: false, error_code: "")

fn _staged_root_tree_provider_scalar_v1(handle: i64, receipt: u64,
    entry: i64, field: i64) -> i64:
    var value: i64 = -1
    unsafe(capabilities: [ffi]):
        value = rt_staged_tree_provider_scalar_v1(
            handle, receipt.to_i64(), entry, field)
    value

fn _staged_root_tree_provider_path_v1(handle: i64, receipt: u64,
    entry: i64) -> Result<text, text>:
    var path: text? = nil
    unsafe(capabilities: [ffi]):
        path = rt_staged_tree_provider_path_v1(handle, receipt.to_i64(), entry)
    if val value = path:
        if value.len() > 0 and value.len() <= STAGED_ROOT_TREE_MAX_PATH_BYTES_V1:
            return Ok(value)
    Err("retained-tree-provider-invalid-path")

fn _staged_root_tree_provider_digest_v1(handle: i64, receipt: u64,
    entry: i64) -> text:
    var digest: text? = nil
    unsafe(capabilities: [ffi]):
        digest = rt_staged_tree_provider_digest_v1(handle, receipt.to_i64(), entry)
    digest ?? ""

fn _staged_root_tree_read_error_v1(code: text) -> StagedRootTreeRetainedReadV1:
    StagedRootTreeRetainedReadV1(
        ok: false, error_code: code, data: [], offset: 0, next_offset: 0,
        eof: false, device: -1, inode: -1, size_bytes: -1)

fn _staged_root_tree_finish_error_v1(code: text) -> StagedRootTreeRetainedFinishV1:
    StagedRootTreeRetainedFinishV1(
        ok: false, error_code: code, device: -1, inode: -1, size_bytes: -1,
        admission_digest_sha256: "")

fn _staged_root_tree_validation_error_v1(code: text) -> StagedRootTreeRetainedValidationV1:
    StagedRootTreeRetainedValidationV1(
        ok: false, error_code: code, admission_digest_sha256: "",
        _authority: StagedRootTreeFileLeaseAuthorityV1(
            provider_receipt: 0u64, provider_slot: -1,
            generation: 0u64, nonce: 0u64))

fn _staged_root_tree_lease_matches_v1(provider: StagedRootTreeRetainedProviderV1,
    lease: StagedRootTreeRetainedValidationV1) -> bool:
    lease.ok and lease._authority.provider_receipt == provider._receipt and
        lease._authority.provider_slot == provider._active_lease_slot and
        lease._authority.generation != 0u64 and
        lease._authority.generation == provider._active_lease_generation and
        lease._authority.nonce != 0u64 and
        lease._authority.nonce == provider._active_lease_nonce

pub(package) fn staged_root_tree_retained_provider_open_v1(
    trusted_absolute_root: text, bounds: StagedRootTreeBoundsV1,
) -> Result<StagedRootTreeRetainedProviderV1, text>:
    if not trusted_absolute_root.starts_with("/") or
        trusted_absolute_root.contains("\0") or trusted_absolute_root.len() > 4095:
        return Err("retained-tree-invalid-root")
    var handle: i64 = -1
    unsafe(capabilities: [ffi]):
        handle = rt_staged_tree_provider_open_v1(
            trusted_absolute_root, bounds.max_depth, bounds.max_entries,
            bounds.max_file_bytes, bounds.max_aggregate_bytes)
    if handle <= 0: return Err("retained-tree-native-open-or-walk-failed")
    var receipt_value: i64 = -1
    unsafe(capabilities: [ffi]): receipt_value = rt_staged_tree_provider_receipt_v1(handle)
    val receipt = if receipt_value > 0: receipt_value.to_u64() else: 0u64
    val root_device = _staged_root_tree_provider_scalar_v1(handle, receipt, -1, 1)
    val entry_count = _staged_root_tree_provider_scalar_v1(handle, receipt, -1, 2)
    if receipt_value <= 0 or root_device <= 0 or entry_count < 0 or
        entry_count > bounds.max_entries:
        unsafe(capabilities: [ffi]):
            _ = rt_staged_tree_provider_close_v1(handle, receipt_value)
        return Err("retained-tree-native-metadata-invalid")
    Ok(StagedRootTreeRetainedProviderV1(
        _handle: handle, _receipt: receipt_value.to_u64(),
        _root_device: root_device, _entry_count: entry_count,
        _closed: false, _quarantined: false,
        _next_lease_generation: 0u64, _active_lease_generation: 0u64,
        _active_lease_slot: -1, _active_lease_nonce: 0u64))
