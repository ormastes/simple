## SimpleOS staged filesystem image builder.
use os.packages.os_packages.{list_all_packages}
use os.tools.pkg.pkg_format.{ExtendedManifest, PkgArch, PackageType, pkg_arch_to_text, pkg_arch_from_text}
use os.port.font_bundle.{simpleos_font_bundle_entries, load_simpleos_font_bundle_entry}
use os.installer.path_utils.{parent_dir_chain}
use os.installer.image_package_payload_policy.{IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1, image_package_payload_decision_v1, image_native_executable_payload_admitted_v1, image_package_metadata_payload_v1}
use os.installer.image_builder_payloads.{
    IMAGE_SIMPLE_TOOLCHAIN_ROLE_PATHS, IMAGE_CLANG_GUEST_BIN_PATHS,
    IMAGE_RUSTC_GUEST_BIN_PATHS, image_target_architecture,
    image_effective_simple_binary, image_validate_simple_binary,
    image_load_validated_simple_binary,
    image_effective_clang_binary, image_effective_rustc_binary,
    image_effective_sysroot_dir, image_copy_tree,
    image_simple_toolchain_manifest, image_clang_fixture_payload,
    image_clang_embedded_payload, image_rust_fixture_payload,
    image_rust_embedded_payload, image_fstab_payload,
    image_normalized_rootfs_backend, image_rootfs_backend_payload,
    image_rootfs_boot_marker, image_rc_conf_payload,
    image_default_bootloader_config, image_installer_bootloader_config,
}
use os.installer.image_bounded_file_reader.{IMAGE_MAX_PACKAGE_ARCHIVE_BYTES_V1, image_read_file_bounded_v1, image_read_text_bounded_v1}
extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_write_bytes(path: text, content: [u8]) -> bool
extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_dir_list(path: text) -> [text]
val DEFAULT_IMAGE_SIZE_MB: u64 = 512
val EFI_PARTITION_SIZE_MB: u64 = 64
val _ROOT_LAYOUT = [
    "/boot",
    "/boot/efi",
    "/bin",
    "/sbin",
    "/etc",
    "/etc/shell",
    "/etc/pkg",
    "/etc/registry",
    "/lib",
    "/usr",
    "/usr/bin",
    "/usr/sbin",
    "/usr/lib",
    "/usr/libexec",
    "/usr/libexec/simpleos-installer",
    "/usr/libexec/simpleos-installer/kernel",
    "/usr/libexec/simpleos-installer/packages",
    "/usr/local",
    "/usr/local/bin",
    "/usr/local/lib",
    "/usr/local/share",
    "/usr/local/share/themes",
    "/var",
    "/var/cache",
    "/var/cache/pkg",
    "/var/db",
    "/var/db/pkg",
    "/var/db/pkg/installed",
    "/var/log",
    "/tmp",
    "/home"
]

struct ImageConfig:
    arch: PkgArch
    output_path: text
    image_size_mb: u64
    kernel_path: text
    bootloader_config: text
    package_dir: text
    simple_binary: text
    include_installer: bool
struct PartitionLayout:
    efi_start_sector: u64
    efi_size_sectors: u64
    root_start_sector: u64
    root_size_sectors: u64
    total_sectors: u64
var _image_builder_rootfs_backend: text = "fat32"

val _IMAGE_SCREEN_TYPES: [text] = ["wm", "2d", "web", "gui"]
val _IMAGE_SCREEN_SIMD_VALUES: [text] = ["auto", "on", "off", "sse2", "avx2", "neon"]
var _image_builder_screen_type: text = ""
var _image_builder_screen_res: text = ""
var _image_builder_screen_simd: text = ""
fn _image_builder_reset_screen():
    _image_builder_screen_type = ""
    _image_builder_screen_res = ""
    _image_builder_screen_simd = ""
fn _validated_screen_type(raw: text) -> Result<text, text>:
    val value = raw.trim().to_lower()
    if value == "":
        return Result.Ok("")
    for t in _IMAGE_SCREEN_TYPES:
        if value == t:
            return Result.Ok(value)
    Result.Err("SimpleOS image screen_type invalid: \"{raw}\" (want wm|2d|web|gui)")
fn _validated_screen_simd(raw: text) -> Result<text, text>:
    val value = raw.trim().to_lower()
    if value == "":
        return Result.Ok("")
    for s in _IMAGE_SCREEN_SIMD_VALUES:
        if value == s:
            return Result.Ok(value)
    Result.Err("SimpleOS image screen_simd invalid: \"{raw}\" (want auto|on|off|sse2|avx2|neon)")
fn _validated_screen_res(raw: text) -> Result<text, text>:
    val value = raw.trim().to_lower()
    if value == "":
        return Result.Ok("")
    val parts = value.split("x")
    if parts.len() != 2:
        return Result.Err("SimpleOS image screen_res invalid: \"{raw}\" (want WxH)")
    val w = parts[0].to_i64()
    val h = parts[1].to_i64()
    if w <= 0 or h <= 0:
        return Result.Err("SimpleOS image screen_res invalid: \"{raw}\" (want WxH)")
    Result.Ok("{w}x{h}")
pub fn image_builder_set_screen(screen_type: text, screen_res: text, screen_simd: text) -> Result<bool, text>:
    """Request validated boot screen configuration for the next image build."""
    val t = _validated_screen_type(screen_type)?
    val r = _validated_screen_res(screen_res)?
    val s = _validated_screen_simd(screen_simd)?
    _image_builder_screen_type = t
    _image_builder_screen_res = r
    _image_builder_screen_simd = s
    Result.Ok(true)

class ImageBuilder:
    config: ImageConfig
    layout: PartitionLayout
impl ImageBuilder:
    static fn new(config: ImageConfig) -> ImageBuilder:
        val layout = _compute_layout(config.image_size_mb)
        ImageBuilder(config: config, layout: layout)

    fn build() -> Result<text, text>:
        val arch_name = pkg_arch_to_text(self.config.arch)
        val artifact_kind = if self.config.include_installer: "installer-dvd" else: "disk-image"
        val simple_binary = image_effective_simple_binary(self.config.simple_binary)
        if simple_binary != "":
            val simple_check = image_validate_simple_binary(simple_binary, self.config.arch)
            if val Err(e) = simple_check:
                return Err(e)
        var kernel_bytes: [u8] = []
        if self.config.kernel_path != "" and rt_file_exists(self.config.kernel_path):
            kernel_bytes = image_read_file_bounded_v1(self.config.kernel_path, IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1, "SimpleOS kernel payload")?
        var font_guest_paths: [text] = []
        var font_blobs: [[u8]] = []
        for entry in simpleos_font_bundle_entries():
            val loaded = load_simpleos_font_bundle_entry(entry)
            if not loaded.valid:
                return Err("SimpleOS font bundle entry invalid: " + loaded.reason)
            font_guest_paths.push(entry.guest_long_path)
            font_blobs.push(loaded.data)
        print "Creating {artifact_kind}: {self.config.output_path}"
        print "  Architecture: {arch_name}"
        print "  Size: {self.config.image_size_mb} MB"
        val staging_root = _staging_root(self.config.output_path)
        val efi_root = "{staging_root}/efi"
        val rootfs_root = "{staging_root}/rootfs"
        val reports_root = "{staging_root}/reports"
        _ensure_dir(staging_root)
        _ensure_dir(efi_root)
        _ensure_dir(rootfs_root)
        _ensure_dir(reports_root)
        var deploy_manifest = _manifest_header(self.config, self.layout)
        deploy_manifest = deploy_manifest + self._populate_efi_partition(efi_root, kernel_bytes)
        val root_manifest = self._populate_root_partition(
            rootfs_root, kernel_bytes, font_guest_paths, font_blobs)?
        deploy_manifest = deploy_manifest + root_manifest

        if self.config.include_installer:
            deploy_manifest = deploy_manifest + self._populate_install_media(rootfs_root, kernel_bytes)?
        val manifest_path = "{reports_root}/deployed-files.sdn"
        write_text(manifest_path, deploy_manifest)
        write_text(_sidecar_manifest_path(self.config.output_path), deploy_manifest)
        val artifact_result = self._materialize_primary_artifact(manifest_path)
        if val Err(e) = artifact_result:
            return Result.Err(e)

        print "  Staged filesystem: {rootfs_root}; manifest: {manifest_path}"
        print "Image created: {self.config.output_path}"
        Result.Ok(self.config.output_path)

    fn _native_payload_manifest(
        destination: text, guest_path: text, owner: text, role: text, bytes: [u8],
    ) -> text:
        val decision = image_package_payload_decision_v1(
            owner, guest_path, bytes, image_target_architecture(self.config.arch))
        if decision.write_payload:
            if rt_file_write_bytes(destination, bytes):
                return _manifest_file(guest_path, role, owner)
            return image_package_payload_decision_v1(
                owner, guest_path, [], image_target_architecture(self.config.arch)).inventory_row
        decision.inventory_row

    fn _populate_efi_partition(efi_root: text, kernel_bytes: [u8]) -> text:
        _ensure_dir("{efi_root}/EFI")
        _ensure_dir("{efi_root}/EFI/BOOT")
        _ensure_dir("{efi_root}/simpleos")

        write_text("{efi_root}/limine.cfg", _effective_bootloader_config(self.config))

        var manifest = self._native_payload_manifest(
            "{efi_root}/kernel.elf", "/boot/kernel.elf",
            "simpleos-kernel", "efi-kernel", kernel_bytes)
        manifest = manifest + _manifest_file("/boot/limine.cfg", "bootloader-config", "simpleos-kernel")
        manifest

    fn _populate_root_partition(
        rootfs_root: text, kernel_bytes: [u8],
        font_guest_paths: [text], font_blobs: [[u8]],
    ) -> Result<text, text>:
        if font_guest_paths.len() != font_blobs.len():
            return Err("SimpleOS font asset staging input mismatch")
        for dir in _ROOT_LAYOUT:
            _ensure_dir("{rootfs_root}{dir}")

        write_text("{rootfs_root}/etc/hostname", "simpleos\n")
        write_text("{rootfs_root}/etc/fstab", image_fstab_payload())
        write_text("{rootfs_root}/etc/rc.conf", _rc_conf_template())
        _image_builder_reset_screen()
        write_text("{rootfs_root}/etc/pkg/repos.sdn", _pkg_repo_template())
        write_text("{rootfs_root}/etc/shell/profile.sdn", "shell = \"/bin/shell\"\n")
        write_text("{rootfs_root}/etc/rootfs.sdn", image_rootfs_backend_payload(_image_builder_rootfs_backend))
        _ensure_dir("{rootfs_root}/SYS")
        write_text("{rootfs_root}/SYS/ROOTFS.CFG", image_rootfs_boot_marker(_image_builder_rootfs_backend))

        var manifest = ""
        manifest = manifest + _manifest_file("/etc/hostname", "system-config", "simpleos-core")
        manifest = manifest + _manifest_file("/etc/fstab", "system-config", "simpleos-core")
        manifest = manifest + _manifest_file("/etc/rc.conf", "system-config", "simpleos-core")
        manifest = manifest + _manifest_file("/etc/pkg/repos.sdn", "pkg-config", "simpleos-tools")
        manifest = manifest + _manifest_file("/etc/shell/profile.sdn", "shell-config", "simpleos-shell")
        manifest = manifest + _manifest_file("/etc/rootfs.sdn", "rootfs-config", "simpleos-core")
        manifest = manifest + image_package_payload_decision_v1(
            "simpleos-core", "/sbin/init", [], image_target_architecture(self.config.arch)).inventory_row
        manifest = manifest + self._native_payload_manifest(
            "{rootfs_root}/boot/kernel.elf", "/boot/kernel.elf",
            "simpleos-kernel", "runtime-kernel", kernel_bytes)
        manifest = manifest + image_package_payload_decision_v1(
            "simpleos-core", "/bin/simplebox", [], image_target_architecture(self.config.arch)).inventory_row
        manifest = manifest + _manifest_file("/SYS/ROOTFS.CFG", "rootfs-boot-marker", "simpleos-core")

        val packages = list_all_packages(self.config.arch)
        for pkg in packages:
            manifest = manifest + self._deploy_package(rootfs_root, pkg)?

        manifest = manifest + self._stage_simple_toolchain_payload(rootfs_root)?
        manifest = manifest + self._stage_clang_toolchain_payload(rootfs_root)
        manifest = manifest + self._stage_rust_toolchain_payload(rootfs_root)
        var font_index: i64 = 0
        while font_index < font_guest_paths.len() and font_index < font_blobs.len():
            val font_path = font_guest_paths[font_index]
            _ensure_parent_dirs(rootfs_root, font_path)
            if not rt_file_write_bytes(rootfs_root + font_path, font_blobs[font_index]):
                return Err("SimpleOS font asset staging failed: " + font_path)
            val kind = if font_path.ends_with(".ttf"): "font-asset" else: "font-notice"
            manifest = manifest + _manifest_file(font_path, kind, "simpleos-core")
            font_index = font_index + 1
        Ok(manifest)

    fn _stage_simple_toolchain_payload(rootfs_root: text) -> Result<text, text>:
        val simple_binary = image_effective_simple_binary(self.config.simple_binary)
        if simple_binary == "" or not rt_file_exists(simple_binary):
            var blocked = ""
            for guest_path in IMAGE_SIMPLE_TOOLCHAIN_ROLE_PATHS:
                blocked = blocked + image_package_payload_decision_v1(
                    "simpleos-tools", guest_path, [], image_target_architecture(self.config.arch)).inventory_row
            return Ok(blocked)
        val simple_bytes = image_load_validated_simple_binary(
            simple_binary, self.config.arch)?

        var manifest = ""
        for guest_path in IMAGE_SIMPLE_TOOLCHAIN_ROLE_PATHS:
            val decision = image_package_payload_decision_v1(
                "simpleos-tools", guest_path, simple_bytes,
                image_target_architecture(self.config.arch))
            if not decision.write_payload or not decision.manifest_deployed:
                return Err("SimpleOS essential toolchain policy rejected: {guest_path}")
            val target_path = "{rootfs_root}{guest_path}"
            _ensure_parent_dirs(rootfs_root, guest_path)
            val ok = rt_file_write_bytes(target_path, simple_bytes)
            if not ok:
                return Err("SimpleOS essential toolchain staging failed: {guest_path}")
            manifest = manifest + _manifest_file(guest_path, "simple-toolchain-role", "simpleos-tools")

        _ensure_dir("{rootfs_root}/SYS")
        write_text("{rootfs_root}/SYS/SIMPLETOOL.SDN", image_simple_toolchain_manifest(simple_binary))
        manifest = manifest + _manifest_file("/SYS/SIMPLETOOL.SDN", "simple-toolchain-manifest", "simpleos-tools")
        Ok(manifest)

    fn _stage_clang_toolchain_payload(rootfs_root: text) -> text:
        val clang_binary = image_effective_clang_binary()
        if clang_binary == "" or not rt_file_exists(clang_binary):
            var blocked = ""
            for guest_path in IMAGE_CLANG_GUEST_BIN_PATHS:
                blocked = blocked + image_package_payload_decision_v1(
                    "simpleos-tools", guest_path, [],
                    image_target_architecture(self.config.arch)).inventory_row
            _ensure_dir("{rootfs_root}/SYS")
            write_text("{rootfs_root}/SYS/CLANGTOOL.SDN", image_clang_fixture_payload())
            return blocked + _manifest_file(
                "/SYS/CLANGTOOL.SDN", "clang-toolchain-fixture", "simpleos-tools")
        val clang_bytes = image_read_file_bounded_v1(clang_binary, IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1, "SimpleOS Clang payload").unwrap_or([])
        val architecture = image_target_architecture(self.config.arch)
        if not image_native_executable_payload_admitted_v1(clang_bytes, architecture):
            var blocked = ""
            for guest_path in IMAGE_CLANG_GUEST_BIN_PATHS:
                blocked = blocked + image_package_payload_decision_v1(
                    "simpleos-tools", guest_path, [], architecture).inventory_row
            return blocked

        var manifest = ""
        for guest_path in IMAGE_CLANG_GUEST_BIN_PATHS:
            _ensure_parent_dirs(rootfs_root, guest_path)
            val decision = image_package_payload_decision_v1(
                "simpleos-tools", guest_path, clang_bytes, architecture)
            if decision.write_payload:
                if rt_file_write_bytes("{rootfs_root}{guest_path}", clang_bytes):
                    manifest = manifest + _manifest_file(guest_path, "clang-toolchain-binary", "simpleos-tools")
                else:
                    manifest = manifest + image_package_payload_decision_v1(
                        "simpleos-tools", guest_path, [], architecture).inventory_row

        val sysroot = image_effective_sysroot_dir()
        var sysroot_embedded = false
        if sysroot != "" and rt_file_exists(sysroot):
            _ensure_dir("{rootfs_root}/usr/lib")
            _ensure_dir("{rootfs_root}/usr/share/simpleos")
            val libs_ok = image_copy_tree("{sysroot}/lib", "{rootfs_root}/usr/lib")
            val sysroot_ok = image_copy_tree(sysroot, "{rootfs_root}/usr/share/simpleos")
            sysroot_embedded = libs_ok and sysroot_ok
            if libs_ok:
                manifest = manifest + _manifest_file("/usr/lib", "clang-sysroot-libs", "simpleos-tools")
            if sysroot_ok:
                manifest = manifest + _manifest_file("/usr/share/simpleos", "clang-sysroot", "simpleos-tools")

        _ensure_dir("{rootfs_root}/SYS")
        write_text("{rootfs_root}/SYS/CLANGTOOL.SDN", image_clang_embedded_payload(clang_binary, sysroot, sysroot_embedded))
        manifest = manifest + _manifest_file("/SYS/CLANGTOOL.SDN", "clang-toolchain-manifest", "simpleos-tools")
        manifest

    fn _stage_rust_toolchain_payload(rootfs_root: text) -> text:
        val rustc_binary = image_effective_rustc_binary()
        if rustc_binary == "" or not rt_file_exists(rustc_binary):
            var blocked = ""
            for guest_path in IMAGE_RUSTC_GUEST_BIN_PATHS:
                blocked = blocked + image_package_payload_decision_v1(
                    "simpleos-tools", guest_path, [],
                    image_target_architecture(self.config.arch)).inventory_row
            _ensure_dir("{rootfs_root}/SYS")
            write_text("{rootfs_root}/SYS/RUSTTOOL.SDN", image_rust_fixture_payload())
            return blocked + _manifest_file(
                "/SYS/RUSTTOOL.SDN", "rust-toolchain-fixture", "simpleos-tools")
        val rustc_bytes = image_read_file_bounded_v1(rustc_binary, IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1, "SimpleOS Rust payload").unwrap_or([])
        val architecture = image_target_architecture(self.config.arch)
        if not image_native_executable_payload_admitted_v1(rustc_bytes, architecture):
            var blocked = ""
            for guest_path in IMAGE_RUSTC_GUEST_BIN_PATHS:
                blocked = blocked + image_package_payload_decision_v1(
                    "simpleos-tools", guest_path, [], architecture).inventory_row
            return blocked

        var manifest = ""
        for guest_path in IMAGE_RUSTC_GUEST_BIN_PATHS:
            _ensure_parent_dirs(rootfs_root, guest_path)
            val decision = image_package_payload_decision_v1(
                "simpleos-tools", guest_path, rustc_bytes, architecture)
            if decision.write_payload:
                if rt_file_write_bytes("{rootfs_root}{guest_path}", rustc_bytes):
                    manifest = manifest + _manifest_file(guest_path, "rust-toolchain-binary", "simpleos-tools")
                else:
                    manifest = manifest + image_package_payload_decision_v1(
                        "simpleos-tools", guest_path, [], architecture).inventory_row

        _ensure_dir("{rootfs_root}/SYS")
        write_text("{rootfs_root}/SYS/RUSTTOOL.SDN", image_rust_embedded_payload(rustc_binary))
        manifest = manifest + _manifest_file("/SYS/RUSTTOOL.SDN", "rust-toolchain-manifest", "simpleos-tools")
        manifest

    fn _populate_install_media(rootfs_root: text, kernel_bytes: [u8]) -> Result<text, text>:
        val installer_root = "{rootfs_root}/usr/libexec/simpleos-installer"
        _ensure_dir(installer_root)
        _ensure_dir("{installer_root}/kernel")
        _ensure_dir("{installer_root}/packages")

        var manifest = image_package_payload_decision_v1(
            "simpleos-installer", "/usr/libexec/simpleos-installer/installer",
            [], image_target_architecture(self.config.arch)).inventory_row
        manifest = manifest + self._native_payload_manifest(
            "{installer_root}/kernel/kernel.elf",
            "/usr/libexec/simpleos-installer/kernel/kernel.elf",
            "simpleos-installer", "install-media-kernel", kernel_bytes)

        if self.config.package_dir != "":
            val entries = readdir(self.config.package_dir)
            for entry in entries:
                if entry.ends_with(".spk"):
                    val source_path = "{self.config.package_dir}/{entry}"
                    val content = image_read_text_bounded_v1(
                        source_path, IMAGE_MAX_PACKAGE_ARCHIVE_BYTES_V1,
                        "SimpleOS install package")?
                    if not write_text("{installer_root}/packages/{entry}", content):
                        return Err("SimpleOS install package staging failed: {entry}")
                    manifest = manifest + _manifest_file("/usr/libexec/simpleos-installer/packages/{entry}", "install-package", "simpleos-installer")
        Ok(manifest)

    fn _deploy_package(rootfs_root: text, pkg: ExtendedManifest) -> Result<text, text>:
        var manifest = ""
        var deployed_count: i64 = 0
        var blocked_count: i64 = 0
        if pkg.pkg_type == PackageType.Meta:
            if not write_text("{rootfs_root}/var/db/pkg/installed/{pkg.base.name}.sdn",
                "# meta-package\nname = \"{pkg.base.name}\"\n"):
                return Err("Package database write failed: {pkg.base.name}")
            return Ok(_manifest_file("/var/db/pkg/installed/{pkg.base.name}.sdn", "pkg-db", pkg.base.name))

        for file_path in pkg.base.files:
            if file_path == "":
                continue
            if file_path.ends_with("/"):
                _ensure_dir("{rootfs_root}{file_path}")
                manifest = manifest + _manifest_dir(file_path, pkg.base.name)
                deployed_count = deployed_count + 1
            else:
                val decision = image_package_payload_decision_v1(
                    pkg.base.name, file_path, [], image_target_architecture(self.config.arch))
                if decision.action == "reject-invalid-metadata":
                    return Err("Package payload metadata rejected: {pkg.base.name}")
                if decision.write_payload:
                    _ensure_parent_dirs(rootfs_root, file_path)
                    val owned_payload = image_package_metadata_payload_v1(
                        pkg.base.name, file_path, self.config.arch)
                    if owned_payload == "":
                        return Err("Installer-owned package metadata renderer missing: {file_path}")
                    if not write_text("{rootfs_root}{file_path}", owned_payload):
                        return Err("Package metadata payload write failed: {file_path}")
                if decision.manifest_deployed:
                    manifest = manifest + _manifest_file(file_path, "package-metadata", pkg.base.name)
                    deployed_count = deployed_count + 1
                else:
                    manifest = manifest + decision.inventory_row
                    blocked_count = blocked_count + 1
        if not write_text("{rootfs_root}/var/db/pkg/installed/{pkg.base.name}.sdn",
            _installed_pkg_record(pkg, deployed_count, blocked_count)):
            return Err("Package database write failed: {pkg.base.name}")
        manifest = manifest + _manifest_file("/var/db/pkg/installed/{pkg.base.name}.sdn", "pkg-db", pkg.base.name)
        Ok(manifest)

    fn _materialize_primary_artifact(manifest_path: text) -> Result<bool, text>:
        if self.config.arch == PkgArch.X86_64 and not self.config.include_installer:
            val args = [
                "-c",
                _make_os_disk_command(self.config)
            ]
            val (stdout, stderr, exit_code) = rt_process_run_timeout("/bin/sh", args, 120000)
            if stdout != "":
                print stdout.trim()
            if stderr != "":
                print stderr.trim()
            if exit_code == 0 and rt_file_exists(self.config.output_path):
                return Result.Ok(true)
            return Result.Err("FAT32 disk generation failed; refusing non-bootable descriptor fallback")
        _write_artifact_descriptor(self.config, self.layout, manifest_path)
        Result.Ok(true)

fn build_usb_installer_image(
    arch: PkgArch,
    kernel_path: text,
    package_dir: text,
    output_path: text,
    size_mb: u64
) -> Result<text, text>:
    val config = ImageConfig(
        arch: arch,
        output_path: output_path,
        image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
        kernel_path: kernel_path,
        bootloader_config: image_installer_bootloader_config(arch),
        package_dir: package_dir,
        simple_binary: "",
        include_installer: true
    )
    _image_builder_rootfs_backend = "fat32"
    ImageBuilder.new(config).build()

fn build_usb_installer_image_with_rootfs(
    arch: PkgArch,
    kernel_path: text,
    package_dir: text,
    output_path: text,
    size_mb: u64,
    rootfs_backend: text
) -> Result<text, text>:
    val config = ImageConfig(
        arch: arch,
        output_path: output_path,
        image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
        kernel_path: kernel_path,
        bootloader_config: image_installer_bootloader_config(arch),
        package_dir: package_dir,
        simple_binary: "",
        include_installer: true
    )
    _image_builder_rootfs_backend = image_normalized_rootfs_backend(rootfs_backend)
    ImageBuilder.new(config).build()

fn build_install_image(
    arch: PkgArch,
    kernel_path: text,
    package_dir: text,
    output_path: text,
    size_mb: u64
) -> Result<text, text>:
    val config = ImageConfig(
