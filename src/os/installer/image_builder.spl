fn _print_image_usage():
    print "Usage: image-builder create [options] [--clang-bundle-root=DIR --clang-bundle-source=REL --clang-bundle-output=REL --clang-bundle-sam1=REL --clang-bundle-seed=REL --clang-bundle-trust=REL [--clang-bundle-aliases=REL]]"
    print "Signed Clang triplet: --signed-clang-root=DIR --signed-clang-sources=CLANG,LLD,HELLO --signed-clang-bundle=REL --signed-clang-payload-leaves=CLANG,LLD,HELLO --signed-clang-scr1-leaves=CLANG,LLD,HELLO --signed-clang-sam1=CLANG,LLD,HELLO --signed-clang-seed=REL --signed-clang-trust=REL --signed-clang-canonical-paths=/usr/bin/clang,/usr/bin/ld.lld,/work/hello.elf --signed-clang-max-bytes=N,N,N --signed-clang-target=TRIPLE"

fn run_image_builder(args: [text]) -> i32:
    for arg in args:
        if arg == "-h":
            _print_image_usage()
            return 0
    if args.len() < 1 or args[0] != "create":
        _print_image_usage()
        return 1

    var arch_str = "x86_64"
    var output = "simpleos.img"
    var size_mb: u64 = DEFAULT_IMAGE_SIZE_MB
    var kernel_elf = ""
    var packages = ""
    var simple_binary = ""
    var simplebox_artifact_path = ""
    var simplebox_receipt_path = ""
    var signed_catalog = ImageSignedCatalogRequestV1(
        trusted_root: "", artifact_relative_path: "",
        build_receipt_relative_path: "", manifest_relative_path: "",
        identity_receipt_relative_path: "", signer_seed_relative_path: "",
        trust_config_relative_path: "", aliases_relative_path: "",
        output_scr1_relative_path: "")
    var signed_toolchain = ImageSignedToolchainCatalogRequestV1(
        trusted_root: "", artifact_relative_path: "",
        manifest_relative_paths: [], identity_receipt_relative_paths: [],
        signer_seed_relative_path: "", trust_config_relative_path: "",
        output_scr1_relative_paths: [])
    var signed_clang = ImageSignedClangBundleRequestV1(
        trusted_root: "", source_relative_paths: [], bundle_relative_path: "",
        payload_leaves: [], scr1_leaves: [], manifest_relative_paths: [],
        signer_seed_relative_path: "", trust_config_relative_path: "",
        canonical_guest_paths: [], max_artifact_bytes: [], target_triple: "")
    var clang_bundle_root = ""
    var clang_bundle_source = ""
    var clang_bundle_output = ""
    var clang_bundle_sam1 = ""
    var clang_bundle_seed = ""
    var clang_bundle_trust = ""
    var clang_bundle_aliases = ""
    var installer = false
    var rootfs_backend = "fat32"
    var screen_type = ""
    var screen_res = ""
    var screen_simd = ""

    var i = 1
    while i < args.len():
        val arg = args[i]
        if arg.starts_with("--arch="):
            arch_str = arg.slice(7, arg.len())
        else if arg.starts_with("--output="):
            output = arg.slice(9, arg.len())
        else if arg.starts_with("--size="):
            size_mb = arg.slice(7, arg.len()).to_u64()
        else if arg.starts_with("--kernel="):
            kernel_elf = arg.slice(9, arg.len())
        else if arg.starts_with("--packages="):
            packages = arg.slice(11, arg.len())
        else if arg.starts_with("--simple-binary="):
            simple_binary = arg.slice(16, arg.len())
        else if arg.starts_with("--simplebox-artifact="):
            simplebox_artifact_path = arg.slice(21, arg.len())
        else if arg.starts_with("--simplebox-receipt="):
            simplebox_receipt_path = arg.slice(20, arg.len())
        else if arg.starts_with("--signed-catalog-root="):
            signed_catalog.trusted_root = arg.slice(22, arg.len())
        else if arg.starts_with("--signed-catalog-artifact="):
            signed_catalog.artifact_relative_path = arg.slice(26, arg.len())
        else if arg.starts_with("--signed-catalog-sam1="):
            signed_catalog.manifest_relative_path = arg.slice(22, arg.len())
        else if arg.starts_with("--signed-catalog-identity-receipt="):
            signed_catalog.identity_receipt_relative_path = arg.slice(34, arg.len())
        else if arg.starts_with("--signed-catalog-seed="):
            signed_catalog.signer_seed_relative_path = arg.slice(22, arg.len())
        else if arg.starts_with("--signed-catalog-trust="):
            signed_catalog.trust_config_relative_path = arg.slice(23, arg.len())
        else if arg.starts_with("--signed-catalog-aliases="):
            signed_catalog.aliases_relative_path = arg.slice(25, arg.len())
        else if arg.starts_with("--signed-catalog-output="):
            signed_catalog.output_scr1_relative_path = arg.slice(24, arg.len())
        else if arg.starts_with("--signed-toolchain-root="):
            signed_toolchain.trusted_root = arg.slice(24, arg.len())
        else if arg.starts_with("--signed-toolchain-artifact="):
            signed_toolchain.artifact_relative_path = arg.slice(28, arg.len())
        else if arg.starts_with("--signed-toolchain-sam1="):
            signed_toolchain.manifest_relative_paths =
                arg.slice(24, arg.len()).split(",")
        else if arg.starts_with("--signed-toolchain-identity-receipts="):
            signed_toolchain.identity_receipt_relative_paths =
                arg.slice(37, arg.len()).split(",")
        else if arg.starts_with("--signed-toolchain-seed="):
            signed_toolchain.signer_seed_relative_path = arg.slice(24, arg.len())
        else if arg.starts_with("--signed-toolchain-trust="):
            signed_toolchain.trust_config_relative_path = arg.slice(25, arg.len())
        else if arg.starts_with("--signed-toolchain-outputs="):
            signed_toolchain.output_scr1_relative_paths =
                arg.slice(27, arg.len()).split(",")
        else if arg.starts_with("--signed-clang-root="):
            signed_clang.trusted_root = arg.slice(20, arg.len())
        else if arg.starts_with("--signed-clang-sources="):
            signed_clang.source_relative_paths = arg.slice(23, arg.len()).split(",")
        else if arg.starts_with("--signed-clang-bundle="):
            signed_clang.bundle_relative_path = arg.slice(22, arg.len())
        else if arg.starts_with("--signed-clang-payload-leaves="):
            signed_clang.payload_leaves = arg.slice(30, arg.len()).split(",")
        else if arg.starts_with("--signed-clang-scr1-leaves="):
            signed_clang.scr1_leaves = arg.slice(27, arg.len()).split(",")
        else if arg.starts_with("--signed-clang-sam1="):
            signed_clang.manifest_relative_paths = arg.slice(20, arg.len()).split(",")
        else if arg.starts_with("--signed-clang-seed="):
            signed_clang.signer_seed_relative_path = arg.slice(20, arg.len())
        else if arg.starts_with("--signed-clang-trust="):
            signed_clang.trust_config_relative_path = arg.slice(21, arg.len())
        else if arg.starts_with("--signed-clang-canonical-paths="):
            signed_clang.canonical_guest_paths = arg.slice(31, arg.len()).split(",")
        else if arg.starts_with("--signed-clang-max-bytes="):
            signed_clang.max_artifact_bytes = []
            for value in arg.slice(25, arg.len()).split(","):
                signed_clang.max_artifact_bytes.push(value.to_i64())
        else if arg.starts_with("--signed-clang-target="):
            signed_clang.target_triple = arg.slice(22, arg.len())
        else if arg.starts_with("--clang-bundle-root="):
            clang_bundle_root = arg.slice(20, arg.len())
        else if arg.starts_with("--clang-bundle-source="):
            clang_bundle_source = arg.slice(22, arg.len())
        else if arg.starts_with("--clang-bundle-output="):
            clang_bundle_output = arg.slice(22, arg.len())
        else if arg.starts_with("--clang-bundle-sam1="):
            clang_bundle_sam1 = arg.slice(20, arg.len())
        else if arg.starts_with("--clang-bundle-seed="):
            clang_bundle_seed = arg.slice(20, arg.len())
        else if arg.starts_with("--clang-bundle-trust="):
            clang_bundle_trust = arg.slice(21, arg.len())
        else if arg.starts_with("--clang-bundle-aliases="):
            clang_bundle_aliases = arg.slice(23, arg.len())
        else if arg.starts_with("--rootfs="):
            rootfs_backend = arg.slice(9, arg.len())
        else if arg.starts_with("--screen-type="):
            screen_type = arg.slice(14, arg.len())
        else if arg.starts_with("--screen-res="):
            screen_res = arg.slice(13, arg.len())
        else if arg.starts_with("--screen-simd="):
            screen_simd = arg.slice(14, arg.len())
        else if arg == "--installer":
            installer = true
        i = i + 1

    val arch_result = pkg_arch_from_text(arch_str)
    if val Err(e) = arch_result:
        print "Error: {e}"
        return 1
    val arch = arch_result.unwrap()

    val clang_bundle_present = clang_bundle_root != "" or clang_bundle_source != "" or
        clang_bundle_output != "" or clang_bundle_sam1 != "" or
        clang_bundle_seed != "" or clang_bundle_trust != "" or
        clang_bundle_aliases != ""
    if clang_bundle_present and _signed_clang_bundle_present_v1(signed_clang):
        print "Error: legacy and signed Clang bundle modes are mutually exclusive"
        return 1
    if clang_bundle_present:
        if clang_bundle_root == "" or clang_bundle_source == "" or
            clang_bundle_output == "" or clang_bundle_sam1 == "" or
            clang_bundle_seed == "" or clang_bundle_trust == "":
            print "Error: Clang bundle options are incomplete"
            return 1
        val clang_target_arch = match arch:
            PkgArch.X86_64: "x86_64"
            PkgArch.Arm64: "aarch64"
            PkgArch.Riscv64: "riscv64"
            PkgArch.Riscv32: "riscv32"
            PkgArch.Any: ""
        if clang_target_arch == "":
            print "Error: Clang bundle requires a concrete target architecture"
            return 1
        val bundled = image_builder_stage_clang_signed_bundle_v1(
            clang_bundle_root, clang_bundle_source, clang_bundle_output,
            clang_bundle_sam1, clang_bundle_seed, clang_bundle_trust,
            clang_bundle_aliases, clang_target_arch)
        if val Err(e) = bundled:
            print "Error: {e}"
            return 1
        print bundled.unwrap()
        # This command prepares an atomic host-side payload+SCR1 directory.
        # The current disk writer does not ingest that directory; callers must
        # explicitly add a later media-ingestion step rather than infer that
        # successful bundle preparation changed the output disk image.
        print "Clang signed bundle prepared outside the disk image; disk embedding is not yet supported"

    val screen_result = image_builder_set_screen(screen_type, screen_res, screen_simd)
    if val Err(e) = screen_result:
        print "Error: {e}"
        return 1

    var simplebox_artifact = _empty_simplebox_artifact_v1()
    var signed_catalog_media = _empty_signed_catalog_media_v1()
    if _signed_catalog_request_present_v1(signed_catalog):
        if simplebox_artifact_path != "":
            print "Error: signed catalog mode reads the artifact only from --signed-catalog-root; do not also pass --simplebox-artifact"
            return 1
        signed_catalog.build_receipt_relative_path = simplebox_receipt_path
        val loaded = _produce_and_load_signed_catalog_media_v1(signed_catalog)
        if val Err(e) = loaded:
            print "Error: {e}"
            return 1
        val signed = loaded.unwrap()
        signed_catalog_media = signed.media
        simplebox_artifact = ImageSimpleboxArtifactV1(
            bytes: signed.artifact_bytes, receipt: signed.receipt)
    else if simplebox_artifact_path != "" or simplebox_receipt_path != "":
        val loaded = _load_simplebox_artifact_v1(
            simplebox_artifact_path, simplebox_receipt_path)
        if val Err(e) = loaded:
            print "Error: {e}"
            return 1
        simplebox_artifact = loaded.unwrap()

    if _signed_toolchain_request_present_v1(signed_toolchain):
        if arch == PkgArch.Riscv32 or arch == PkgArch.Any:
            print "Error: signed toolchain catalog media supports x86_64, arm64, and riscv64"
            return 1
        val loaded_toolchain = _produce_and_load_signed_toolchain_catalog_v1(
            signed_toolchain, arch)
        if val Err(e) = loaded_toolchain:
            print "Error: {e}"
            return 1
        val toolchain = loaded_toolchain.unwrap()
        signed_catalog_media.toolchain_enabled = toolchain.toolchain_enabled
        signed_catalog_media.toolchain_artifact_bytes =
            toolchain.toolchain_artifact_bytes
        signed_catalog_media.toolchain_scr1_bytes = toolchain.toolchain_scr1_bytes
        signed_catalog_media.toolchain_trust_config_bytes =
            toolchain.toolchain_trust_config_bytes

    if _signed_clang_bundle_present_v1(signed_clang):
        val produced_clang = _produce_signed_clang_bundle_v1(signed_clang, arch)
        if val Err(e) = produced_clang:
            print "Error: {e}"
            return 1
        val clang_media = produced_clang.unwrap()
        signed_catalog_media.signed_clang_enabled = clang_media.signed_clang_enabled
        signed_catalog_media.signed_clang_artifact_paths = clang_media.signed_clang_artifact_paths
        signed_catalog_media.signed_clang_artifact_sha256 = clang_media.signed_clang_artifact_sha256
        signed_catalog_media.signed_clang_scr1_bytes = clang_media.signed_clang_scr1_bytes
        signed_catalog_media.signed_clang_trust_config_bytes = clang_media.signed_clang_trust_config_bytes

    val result = if installer:
        val config = ImageConfig(
            arch: arch,
            output_path: output,
            image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
            kernel_path: kernel_elf,
            bootloader_config: image_installer_bootloader_config(arch),
            package_dir: packages,
            simple_binary: simple_binary,
            simplebox_artifact: simplebox_artifact,
            signed_catalog_media: signed_catalog_media,
            include_installer: true
        )
        _image_builder_rootfs_backend = image_normalized_rootfs_backend(rootfs_backend)
        _build_image_v1(config)
    else:
        val config = ImageConfig(
            arch: arch,
            output_path: output,
            image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
            kernel_path: kernel_elf,
            bootloader_config: "",
            package_dir: packages,
            simple_binary: simple_binary,
            simplebox_artifact: simplebox_artifact,
            signed_catalog_media: signed_catalog_media,
            include_installer: false
        )
        _image_builder_rootfs_backend = image_normalized_rootfs_backend(rootfs_backend)
        _build_image_v1(config)

    if val Ok(path) = result:
        print "Artifact created: {path}"
        return 0
    else if val Err(e) = result:
        print "Error: {e}"
        return 1
    0

fn _compute_layout(image_size_mb: u64) -> PartitionLayout:
    val total_sectors = (image_size_mb * 1024 * 1024) / 512
    val efi_start: u64 = 2048
    val efi_sectors = (EFI_PARTITION_SIZE_MB * 1024 * 1024) / 512
    val root_start = efi_start + efi_sectors
    val reserved_end = root_start + 2048
    val root_sectors = if total_sectors > reserved_end:
        total_sectors - reserved_end
    else:
        0u64
    PartitionLayout(
        efi_start_sector: efi_start,
        efi_size_sectors: efi_sectors,
        root_start_sector: root_start,
        root_size_sectors: root_sectors,
        total_sectors: total_sectors
    )

fn _staging_root(output_path: text) -> text:
    "{output_path}.contents"

fn _sidecar_manifest_path(output_path: text) -> text:
    "{output_path}.manifest.sdn"

val _IMAGE_ROOTFS_CLUSTER_BYTES_V1: u64 = 4096u64
val _IMAGE_ROOTFS_METADATA_MIN_BYTES_V1: u64 = 4194304u64
val _IMAGE_ROOTFS_MAX_ENTRIES_V1: i64 = 65536
val _IMAGE_ROOTFS_MAX_DEPTH_V1: i64 = 64

fn _checked_rootfs_add_v1(left: u64, right: u64) -> Result<u64, text>:
    val sum = left + right
    if sum < left:
        return Err("SimpleOS staged rootfs budget arithmetic overflow")
    Ok(sum)

fn _staged_rootfs_allocation_v1(
    path: text, depth: i64,
) -> Result<(u64, i64), text>:
    if depth > _IMAGE_ROOTFS_MAX_DEPTH_V1:
        return Err("SimpleOS staged rootfs directory depth exceeds bound")
    if not rt_dir_exists(path):
        val size = rt_file_size(path)
        if size < 0:
            return Err("SimpleOS staged rootfs contains an unreadable file: {path}")
        val raw = size.to_u64()
        val rounded = if raw == 0u64:
            _IMAGE_ROOTFS_CLUSTER_BYTES_V1
        else:
            ((raw - 1u64) / _IMAGE_ROOTFS_CLUSTER_BYTES_V1 + 1u64) *
                _IMAGE_ROOTFS_CLUSTER_BYTES_V1
        if rounded < raw:
            return Err("SimpleOS staged rootfs file allocation overflow")
        return Ok((rounded, 1))
    val entries = rt_dir_list(path)
    if entries == nil:
        return Err("SimpleOS staged rootfs directory is unreadable: {path}")
    var allocation = _IMAGE_ROOTFS_CLUSTER_BYTES_V1
    var count: i64 = 1
    for name in entries:
        if name == "" or name == "." or name == ".." or
           name.contains("/") or name.contains("\\"):
            return Err("SimpleOS staged rootfs directory entry is invalid")
        val child = _staged_rootfs_allocation_v1("{path}/{name}", depth + 1)?
        allocation = _checked_rootfs_add_v1(allocation, child[0])?
        count = count + child[1]
        if count > _IMAGE_ROOTFS_MAX_ENTRIES_V1:
            return Err("SimpleOS staged rootfs entry count exceeds bound")
    Ok((allocation, count))

fn _validate_staged_rootfs_budget_v1(
    rootfs_root: text, layout: PartitionLayout,
) -> Result<bool, text>:
    val capacity = layout.root_size_sectors * 512u64
    if layout.root_size_sectors > 0u64 and
       capacity / 512u64 != layout.root_size_sectors:
        return Err("SimpleOS root partition capacity arithmetic overflow")
    val measured = _staged_rootfs_allocation_v1(rootfs_root, 0)?
    val staged = measured[0]
    val ten_percent = capacity / 10u64
    val metadata_reserve = if ten_percent > _IMAGE_ROOTFS_METADATA_MIN_BYTES_V1:
        ten_percent
    else:
        _IMAGE_ROOTFS_METADATA_MIN_BYTES_V1
    if metadata_reserve > capacity:
        return Err("SimpleOS staged rootfs metadata reserve exceeds root partition capacity")
    if staged > capacity - metadata_reserve:
        return Err("SimpleOS aggregate staged rootfs allocation exceeds root partition capacity")
    Ok(true)

fn write_text(path: text, content: text) -> bool:
    rt_file_write_text(path, content)

fn readdir(path: text) -> [text]:
    rt_dir_list(path) ?? []

fn mkdir(path: text):
    val _ok = rt_dir_create_all(path)

fn _ensure_dir(path: text):
    if path == "":
        return
    val parts = path.split("/")
    var current = ""
    val absolute = path.starts_with("/")
    for raw in parts:
        val part = raw.trim()
        if part == "":
            continue
        if current == "":
            current = if absolute: "/" + part else: part
        else:
            current = current + "/" + part
        mkdir(current)

fn _ensure_parent_dirs(rootfs_root: text, file_path: text):
    for dir in parent_dir_chain(rootfs_root, file_path):
        mkdir(dir)

fn _manifest_header(config: ImageConfig, layout: PartitionLayout) -> text:
    val kind = if config.include_installer: "installer-dvd" else: "disk-image"
    val rootfs_backend = image_normalized_rootfs_backend(_image_builder_rootfs_backend)
    var out = "[artifact]\n"
    out = out + "arch = \"{pkg_arch_to_text(config.arch)}\"\n"
    out = out + "output = \"{config.output_path}\"\n"
    out = out + "kind = \"{kind}\"\n"
    out = out + "rootfs_backend = \"{rootfs_backend}\"\n"
    out = out + "image_size_mb = {config.image_size_mb}\n"
    out = out + "efi_start_sector = {layout.efi_start_sector}\n"
    out = out + "efi_size_sectors = {layout.efi_size_sectors}\n"
    out = out + "root_start_sector = {layout.root_start_sector}\n"
    out = out + "root_size_sectors = {layout.root_size_sectors}\n\n"
    out

fn _manifest_file(path: text, role: text, owner: text) -> text:
    "[deploy]\npath = \"{path}\"\nkind = \"file\"\nrole = \"{role}\"\nowner = \"{owner}\"\n\n"

fn _manifest_dir(path: text, owner: text) -> text:
    "[deploy]\npath = \"{path}\"\nkind = \"dir\"\nrole = \"package-dir\"\nowner = \"{owner}\"\n\n"

fn _installed_pkg_record(pkg: ExtendedManifest, deployed_count: i64, blocked_count: i64) -> text:
    var out = "[package]\n"
    out = out + "name = \"{pkg.base.name}\"\n"
    out = out + "version = \"{pkg.base.version.to_text()}\"\n"
    out = out + "arch = \"{pkg_arch_to_text(pkg.arch)}\"\n"
    out = out + "declared_files = {pkg.base.files.len()}\n"
    out = out + "deployed_files = {deployed_count}\n"
    out = out + "blocked_files = {blocked_count}\n"
    out

fn _effective_bootloader_config(config: ImageConfig) -> text:
    if config.bootloader_config != "":
        return config.bootloader_config
    image_default_bootloader_config(config.arch)

fn _basename(path: text) -> text:
    var out = path
    for seg in path.split("/"):
        if seg.trim() != "":
            out = seg.trim()
    out

fn detect_iso_tool() -> text:
    val cmd = "command -v xorriso || command -v mkisofs || command -v genisoimage || true"
    val (stdout, _e, _c) = rt_process_run_timeout("/bin/sh", ["-c", cmd], 15000)
    val found = stdout.trim()
    if found == "":
        return "iso-tool-missing"
    _basename(found)

fn _shell_quote(value: text) -> text:
    "'" + value.replace("'", "'\\''") + "'"

fn _make_os_disk_command(config: ImageConfig) -> text:
    val simple_binary = image_effective_simple_binary(config.simple_binary)
    var command = ""
    if simple_binary != "":
        command = command + "SIMPLEOS_SIMPLE_BINARY=" + _shell_quote(simple_binary) + " "
    command = command + "sh scripts/os/make_os_disk.shs "
    command = command + _shell_quote(config.image_size_mb.to_text()) + " "
    command = command + _shell_quote(config.output_path) + " "
    command = command + _shell_quote(config.kernel_path) + " "
    command + "x86_64"

fn _rc_conf_template() -> text:
    image_rc_conf_payload(
        _image_builder_screen_type,
        _image_builder_screen_res,
        _image_builder_screen_simd
    )

fn _pkg_repo_template() -> text:
    "[repositories]\nlocal = \"/var/cache/pkg/local\"\n"

fn _write_artifact_descriptor(config: ImageConfig, layout: PartitionLayout, manifest_path: text):
    var out = _manifest_header(config, layout)
    out = out + "[descriptor]\n"
    out = out + "staging_root = \"{_staging_root(config.output_path)}\"\n"
    out = out + "deploy_manifest = \"{manifest_path}\"\n"
    out = out + "materialized = false\n"
    write_text(config.output_path, out)
