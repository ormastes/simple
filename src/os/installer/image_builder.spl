pub fn build_install_image_with_simplebox_artifact_observed_v1(
    arch: PkgArch,
    kernel_path: text,
    package_dir: text,
    output_path: text,
    size_mb: u64,
    artifact: ImageSimpleboxArtifactV1,
) -> Result<(text, ImageSimpleboxValidationMetricsV1), text>:
    """Build through the production core and return local validation work."""
    val config = ImageConfig(
        arch: arch,
        output_path: output_path,
        image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
        kernel_path: kernel_path,
        bootloader_config: "",
        package_dir: package_dir,
        simple_binary: "",
        simplebox_artifact: artifact,
        signed_catalog_media: _empty_signed_catalog_media_v1(),
        include_installer: false
    )
    _image_builder_rootfs_backend = "fat32"
    val observer = _ImageSimpleboxValidationObserverV1.new()
    val built = ImageBuilder.new(config).build(observer)?
    Ok((built, observer.snapshot()))

