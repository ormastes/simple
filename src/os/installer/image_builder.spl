struct ImageConfig:
    arch: PkgArch
    output_path: text
    image_size_mb: u64
    kernel_path: text
    bootloader_config: text
    package_dir: text
    simple_binary: text
    simplebox_artifact: ImageSimpleboxArtifactV1
    signed_catalog_media: ImageSignedCatalogMediaV1
    include_installer: bool

struct ImageSignedCatalogMediaV1:
    enabled: bool
    scr1_bytes: [u8]
    trust_config_bytes: [u8]
    toolchain_enabled: bool
    toolchain_artifact_bytes: [u8]
    toolchain_scr1_bytes: [[u8]]
    toolchain_trust_config_bytes: [u8]
    signed_clang_enabled: bool
    # Payloads remain in the atomically published signed bundle.  Retaining
    # only their validated paths avoids holding three toolchain images in the
    # GC heap until rootfs construction (and avoids another whole-file copy at
    # each image destination).
    signed_clang_artifact_paths: [text]
    signed_clang_artifact_sha256: [text]
    signed_clang_scr1_bytes: [[u8]]
    signed_clang_trust_config_bytes: [u8]

fn _empty_signed_catalog_media_v1() -> ImageSignedCatalogMediaV1:
    ImageSignedCatalogMediaV1(
        enabled: false, scr1_bytes: [], trust_config_bytes: [],
        toolchain_enabled: false, toolchain_artifact_bytes: [],
        toolchain_scr1_bytes: [], toolchain_trust_config_bytes: [],
        signed_clang_enabled: false, signed_clang_artifact_paths: [],
        signed_clang_artifact_sha256: [],
        signed_clang_scr1_bytes: [], signed_clang_trust_config_bytes: [])

pub fn image_builder_stage_clang_signed_bundle_v1(trusted_root: text,
    source_relative: text, bundle_relative: text, manifest_relative: text,
    seed_relative: text, trust_relative: text, aliases_relative: text,
    target_arch: text) -> Result<text, text>:
    val result = signed_catalog_bundle_produce_v1(SignedCatalogBundleProduceRequestV1(
        trusted_absolute_root: trusted_root, source_relative_path: source_relative,
        bundle_relative_path: bundle_relative, payload_leaf: "clang",
        scr1_leaf: "clang.scr1", manifest_relative_path: manifest_relative,
        signer_seed_relative_path: seed_relative,
        trust_config_relative_path: trust_relative,
        aliases_relative_path: aliases_relative, canonical_path: "/usr/bin/clang",
        target_arch: target_arch, max_artifact_bytes: 1073741824))
    if not result.ok: return Err(result.reason)
    Ok(result.receipt_line)

pub struct ImageSimpleboxArtifactV1:
    bytes: [u8]
    receipt: ImageSimpleboxArtifactReceiptV1

pub struct ImageSimpleboxArtifactReceiptV1:
    schema_version: i64
    artifact_sha256: text
    target: text
    canonical_role: text
    entry: text
    entry_closure: bool
    backend: text
    compiler: text

pub struct ImageSimpleboxValidationMetricsV1:
    validation_calls: i64
    hash_bytes: i64
    executable_admission_calls: i64

struct ImageSimpleboxValidatedDecisionV1:
    artifact: ImageSimpleboxArtifactV1
    write_payload: bool
    manifest_deployed: bool

class _ImageSimpleboxValidationObserverV1:
    validation_calls: i64
    hash_bytes: i64
    executable_admission_calls: i64
impl _ImageSimpleboxValidationObserverV1:
    static fn new() -> _ImageSimpleboxValidationObserverV1:
        _ImageSimpleboxValidationObserverV1(
            validation_calls: 0, hash_bytes: 0,
            executable_admission_calls: 0)
    fn snapshot() -> ImageSimpleboxValidationMetricsV1:
        ImageSimpleboxValidationMetricsV1(
            validation_calls: self.validation_calls,
            hash_bytes: self.hash_bytes,
            executable_admission_calls: self.executable_admission_calls)

fn _empty_simplebox_validated_decision_v1() -> ImageSimpleboxValidatedDecisionV1:
    ImageSimpleboxValidatedDecisionV1(
        artifact: _empty_simplebox_artifact_v1(),
        write_payload: false, manifest_deployed: false)

fn _empty_simplebox_artifact_v1() -> ImageSimpleboxArtifactV1:
    ImageSimpleboxArtifactV1(
        bytes: [],
        receipt: ImageSimpleboxArtifactReceiptV1(
            schema_version: 0, artifact_sha256: "", target: "",
            canonical_role: "", entry: "", entry_closure: false,
            backend: "", compiler: ""))

fn _safe_simplebox_receipt_scalar_v1(value: text) -> bool:
    value != "" and value.len() <= 1024 and not value.contains("\0") and
        not value.contains("\n") and not value.contains("\r") and
        not value.contains("\t") and not value.contains("\"") and
        not value.contains("\\")

fn _valid_simplebox_sha256_v1(value: text) -> bool:
    if value.len() != 64:
        return false
    for ch in value:
        if not ((ch >= '0' and ch <= '9') or (ch >= 'a' and ch <= 'f')):
            return false
    true

fn _valid_simplebox_provenance_receipt_v1(
    receipt: ImageSimpleboxArtifactReceiptV1,
) -> bool:
    receipt.schema_version == 1 and
        _valid_simplebox_sha256_v1(receipt.artifact_sha256) and
        (receipt.target == "x86_64-unknown-simpleos" or
         receipt.target == "aarch64-unknown-simpleos" or
         receipt.target == "riscv64gc-unknown-simpleos" or
         receipt.target == "riscv32-unknown-simpleos") and
        receipt.canonical_role == SIMPLEBOX_CANONICAL_PATH_V1 and
        receipt.entry == "src/os/tools/simplebox/simplebox_main.spl" and
        receipt.entry_closure and
        (receipt.backend == "llvm" or receipt.backend == "cranelift") and
        _safe_simplebox_receipt_scalar_v1(receipt.compiler) and
        not receipt.compiler.contains("compiler_rust") and
        not receipt.compiler.contains("simple_seed") and
        not receipt.compiler.contains("target/bootstrap")

fn _validate_simplebox_artifact_v1(
    artifact: ImageSimpleboxArtifactV1, arch: PkgArch,
    observer: _ImageSimpleboxValidationObserverV1,
) -> Result<ImageSimpleboxValidatedDecisionV1, text>:
    observer.validation_calls = observer.validation_calls + 1
    if artifact.bytes.len() == 0:
        return Err("SimpleOS simplebox artifact bytes are required")
    if artifact.bytes.len() > IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1:
        return Err("SimpleOS simplebox artifact exceeds bounded payload limit")
    val receipt = artifact.receipt
    if receipt.schema_version != 1:
        return Err("SimpleOS simplebox artifact receipt schema is invalid")
    if not _valid_simplebox_sha256_v1(receipt.artifact_sha256):
        return Err("SimpleOS simplebox artifact SHA-256 is invalid")
    observer.hash_bytes = observer.hash_bytes + artifact.bytes.len()
    if sha256_u8_hex(artifact.bytes) != receipt.artifact_sha256:
        return Err("SimpleOS simplebox artifact SHA-256 does not match its bytes")
    if receipt.target != _simplebox_target_triple_v1(arch):
        return Err("SimpleOS simplebox artifact receipt target mismatch")
    if receipt.canonical_role != SIMPLEBOX_CANONICAL_PATH_V1:
        return Err("SimpleOS simplebox artifact receipt canonical role mismatch")
    if receipt.entry != "src/os/tools/simplebox/simplebox_main.spl" or
       not receipt.entry_closure:
        return Err("SimpleOS simplebox artifact receipt entry closure is invalid")
    if receipt.backend != "llvm" and receipt.backend != "cranelift":
        return Err("SimpleOS simplebox artifact receipt backend is invalid")
    if not _safe_simplebox_receipt_scalar_v1(receipt.compiler):
        return Err("SimpleOS simplebox artifact receipt compiler is missing or invalid")
    if receipt.compiler.contains("compiler_rust") or
       receipt.compiler.contains("simple_seed") or
       receipt.compiler.contains("target/bootstrap"):
        return Err("SimpleOS simplebox artifact was built by a bootstrap seed")
    # This is the sole executable parser/admission call for the artifact.  The
    # returned value-semantic decision is passed to staging; staging must not
    # hash or parse the payload again.
    observer.executable_admission_calls =
        observer.executable_admission_calls + 1
    val payload_decision = image_package_payload_decision_v1(
        "simpleos-tools", SIMPLEBOX_CANONICAL_PATH_V1, artifact.bytes,
        image_target_architecture(arch))
    if not payload_decision.write_payload or not payload_decision.manifest_deployed:
        return Err("SimpleOS simplebox artifact executable structure or architecture is invalid")
    Ok(ImageSimpleboxValidatedDecisionV1(
        artifact: artifact,
        write_payload: payload_decision.write_payload,
        manifest_deployed: payload_decision.manifest_deployed))

fn _simplebox_target_triple_v1(arch: PkgArch) -> text:
    match arch:
        PkgArch.X86_64: "x86_64-unknown-simpleos"
        PkgArch.Arm64: "aarch64-unknown-simpleos"
        PkgArch.Riscv64: "riscv64gc-unknown-simpleos"
        PkgArch.Riscv32: "riscv32-unknown-simpleos"
        PkgArch.Any: "x86_64-unknown-simpleos"

fn _simplebox_receipt_field_v1(receipt: text, key: text) -> Result<text, text>:
    val prefix = "{key}="
    var found = ""
    var count: i64 = 0
    for line in receipt.split("\n"):
        if line.starts_with(prefix):
            count = count + 1
            found = line.slice(prefix.len(), line.len())
    if count != 1 or found == "":
        return Err("SimpleOS simplebox artifact receipt has invalid {key}")
    Ok(found)

fn _load_simplebox_artifact_v1(
    artifact_path: text, receipt_path: text,
) -> Result<ImageSimpleboxArtifactV1, text>:
    if artifact_path == "" or receipt_path == "":
        return Err("SimpleOS simplebox artifact and receipt paths are both required")
    val bytes = image_read_file_bounded_v1(
        artifact_path, IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1,
        "SimpleOS simplebox artifact")?
    val receipt = _load_simplebox_receipt_v1(receipt_path)?
    Ok(ImageSimpleboxArtifactV1(bytes: bytes, receipt: receipt))

fn _load_simplebox_receipt_v1(
    receipt_path: text,
) -> Result<ImageSimpleboxArtifactReceiptV1, text>:
    if receipt_path == "":
        return Err("SimpleOS simplebox build receipt path is required")
    val text_receipt = image_read_text_bounded_v1(
        receipt_path, IMAGE_MAX_BUILD_STAMP_BYTES_V1,
        "SimpleOS simplebox artifact receipt")?
    _parse_simplebox_receipt_v1(text_receipt)

fn _parse_simplebox_receipt_v1(
    text_receipt: text,
) -> Result<ImageSimpleboxArtifactReceiptV1, text>:
    Ok(ImageSimpleboxArtifactReceiptV1(
        schema_version: _simplebox_receipt_field_v1(
            text_receipt, "schema_version")?.to_i64(),
        artifact_sha256: _simplebox_receipt_field_v1(
            text_receipt, "artifact_sha256")?,
        target: _simplebox_receipt_field_v1(text_receipt, "target")?,
        canonical_role: _simplebox_receipt_field_v1(
            text_receipt, "canonical_role")?,
        entry: _simplebox_receipt_field_v1(text_receipt, "entry")?,
        entry_closure: _simplebox_receipt_field_v1(
            text_receipt, "entry_closure")? == "true",
        backend: _simplebox_receipt_field_v1(text_receipt, "backend")?,
        compiler: _simplebox_receipt_field_v1(text_receipt, "compiler")?))

struct ImageSignedCatalogRequestV1:
    trusted_root: text
    artifact_relative_path: text
    build_receipt_relative_path: text
    manifest_relative_path: text
    identity_receipt_relative_path: text
    signer_seed_relative_path: text
    trust_config_relative_path: text
    aliases_relative_path: text
    output_scr1_relative_path: text

struct ImageSignedCatalogLoadV1:
    media: ImageSignedCatalogMediaV1
    artifact_bytes: [u8]
    receipt: ImageSimpleboxArtifactReceiptV1

struct ImageSignedToolchainCatalogRequestV1:
    trusted_root: text
    artifact_relative_path: text
    manifest_relative_paths: [text]
    identity_receipt_relative_paths: [text]
    signer_seed_relative_path: text
    trust_config_relative_path: text
    output_scr1_relative_paths: [text]

struct ImageSignedClangBundleRequestV1:
    trusted_root: text
    source_relative_paths: [text]
    bundle_relative_path: text
    payload_leaves: [text]
    scr1_leaves: [text]
    manifest_relative_paths: [text]
    signer_seed_relative_path: text
    trust_config_relative_path: text
    canonical_guest_paths: [text]
    max_artifact_bytes: [i64]
    target_triple: text

fn _signed_toolchain_request_present_v1(
    request: ImageSignedToolchainCatalogRequestV1,
) -> bool:
    request.trusted_root != "" or request.artifact_relative_path != "" or
        request.manifest_relative_paths.len() > 0 or
        request.identity_receipt_relative_paths.len() > 0 or
        request.signer_seed_relative_path != "" or
        request.trust_config_relative_path != "" or
        request.output_scr1_relative_paths.len() > 0

fn _signed_toolchain_request_complete_v1(
    request: ImageSignedToolchainCatalogRequestV1,
) -> bool:
    if not (request.trusted_root != "" and request.artifact_relative_path != "" and
        request.signer_seed_relative_path != "" and
        request.trust_config_relative_path != "" and
        request.manifest_relative_paths.len() == 3 and
        request.identity_receipt_relative_paths.len() == 3 and
        request.output_scr1_relative_paths.len() == 3):
        return false
    var paths = [request.artifact_relative_path,
        request.signer_seed_relative_path, request.trust_config_relative_path]
    for path in request.manifest_relative_paths: paths.push(path)
    for path in request.identity_receipt_relative_paths: paths.push(path)
    for path in request.output_scr1_relative_paths: paths.push(path)
    var index: i64 = 0
    while index < paths.len():
        if not hosted_safe_artifact_relative_path_valid_v1(paths[index]):
            return false
        var prior: i64 = 0
        while prior < index:
            # Inputs and outputs share one retained directory authority.  A
            # duplicate canonical lexical path could make two roles consume
            # the same evidence or target the same publication leaf.
            if paths[prior] == paths[index]: return false
            prior = prior + 1
        index = index + 1
    true

fn _produce_and_load_signed_toolchain_catalog_v1(
    request: ImageSignedToolchainCatalogRequestV1,
    arch: PkgArch,
) -> Result<ImageSignedCatalogMediaV1, text>:
    if not _signed_toolchain_request_complete_v1(request):
        return Err("signed toolchain catalog requested but triplet inputs are incomplete")
    val target_arch = match arch:
        PkgArch.X86_64: "x86_64"
        PkgArch.Arm64: "aarch64"
        PkgArch.Riscv64: "riscv64"
        else: ""
    if target_arch == "": return Err("signed toolchain catalog target unsupported")
    # Three independent publications cannot form one authenticated media
    # transaction. Keep disk ingestion fail-closed until a retained-directory
    # owner can stage, authenticate, publish, and consume the whole triplet.
    Err("signed toolchain catalog production requires atomic triplet publication")

fn _signed_clang_bundle_present_v1(
    request: ImageSignedClangBundleRequestV1,
) -> bool:
    request.trusted_root != "" or request.source_relative_paths.len() > 0 or
        request.bundle_relative_path != "" or request.payload_leaves.len() > 0 or
        request.scr1_leaves.len() > 0 or request.manifest_relative_paths.len() > 0 or
        request.signer_seed_relative_path != "" or
        request.trust_config_relative_path != "" or
        request.canonical_guest_paths.len() > 0 or
        request.max_artifact_bytes.len() > 0 or request.target_triple != ""

fn _wipe_image_signing_seed_v1(seed: [u8]):
    val _ = secure_zero_u8_slots(seed)

fn _signed_clang_bundle_complete_v1(
    request: ImageSignedClangBundleRequestV1, arch: PkgArch,
) -> bool:
    if (arch == PkgArch.Any or request.trusted_root == "" or
        request.bundle_relative_path == "" or
        request.signer_seed_relative_path == "" or
        request.trust_config_relative_path == "" or
        request.source_relative_paths.len() != 3 or
        request.payload_leaves.len() != 3 or request.scr1_leaves.len() != 3 or
        request.manifest_relative_paths.len() != 3 or
        request.canonical_guest_paths !=
            ["/usr/bin/clang", "/usr/bin/ld.lld", "/work/hello.elf"] or
        request.max_artifact_bytes.len() != 3 or
        request.target_triple != image_target_triple_v1(arch)):
        return false
    var aggregate: i64 = 0
    var paths = [request.bundle_relative_path,
        request.signer_seed_relative_path, request.trust_config_relative_path]
    for path in request.source_relative_paths: paths.push(path)
    for path in request.manifest_relative_paths: paths.push(path)
    var index: i64 = 0
    while index < paths.len():
        if not hosted_safe_artifact_relative_path_valid_v1(paths[index]): return false
        var prior: i64 = 0
        while prior < index:
            if paths[prior] == paths[index]: return false
            prior = prior + 1
        index = index + 1
    for bound in request.max_artifact_bytes:
        if bound <= 0 or bound > HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1 or
            aggregate > 3221225472 - bound:
            return false
        aggregate = aggregate + bound
    aggregate <= 3221225472 - (3 * SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1)

fn _produce_signed_clang_bundle_v1(
    request: ImageSignedClangBundleRequestV1, arch: PkgArch,
) -> Result<ImageSignedCatalogMediaV1, text>:
    if not _signed_clang_bundle_complete_v1(request, arch):
        return Err("signed Clang bundle requested but exact triplet inputs are incomplete")
    val target_arch = match arch:
        PkgArch.X86_64: "x86_64"
        PkgArch.Arm64: "aarch64"
        PkgArch.Riscv64: "riscv64"
        PkgArch.Riscv32: "riscv32"
        PkgArch.Any: ""
    val opened = hosted_safe_artifact_root_acquire_v1(request.trusted_root)
    if val Err(reason) = opened: return Err("signed Clang root rejected: " + reason)
    val authority = opened.unwrap()
    var manifests: [[u8]] = []
    val aliases: [[u8]] = [[], [], []]
    for path in request.manifest_relative_paths:
        val read = hosted_safe_artifact_read_once_v1(authority, path, 262144)
        if val Err(reason) = read:
            _ = hosted_safe_artifact_root_close_v1(authority)
            return Err("signed Clang manifest rejected: " + reason)
        manifests.push(read.unwrap())
    val seed_read = hosted_safe_artifact_read_once_v1(
        authority, request.signer_seed_relative_path, 32)
    if val Err(reason) = seed_read:
        _ = hosted_safe_artifact_root_close_v1(authority)
        return Err("signed Clang seed rejected: " + reason)
    val seed = seed_read.unwrap()
    defer _wipe_image_signing_seed_v1(seed)
    val trust_read = hosted_safe_artifact_read_once_v1(
        authority, request.trust_config_relative_path, 16384)
    if val Err(reason) = trust_read:
        _ = hosted_safe_artifact_root_close_v1(authority)
        return Err("signed Clang trust rejected: " + reason)
    val trust = trust_read.unwrap()
    var aggregate: i64 = 3 * SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1
    for bound in request.max_artifact_bytes: aggregate = aggregate + bound
    val begun = hosted_safe_artifact_bundle3_begin_v1(
        authority, request.source_relative_paths[0], request.source_relative_paths[1],
        request.source_relative_paths[2], request.bundle_relative_path,
        request.payload_leaves[0], request.scr1_leaves[0],
        request.payload_leaves[1], request.scr1_leaves[1],
        request.payload_leaves[2], request.scr1_leaves[2], aggregate)
    if val Err(reason) = begun:
        _ = hosted_safe_artifact_root_close_v1(authority)
        return Err("signed Clang bundle begin rejected: " + reason)
    val bundle = begun.unwrap()
    var receipts: [text] = []
    var artifact_sha256: [text] = []
    var slot: i64 = 0
    while slot < 3:
        var artifact: [u8] = []
        var complete = false
        while not complete:
            val remaining = request.max_artifact_bytes[slot] - artifact.len()
            if remaining <= 0:
                _ = hosted_safe_artifact_bundle3_finish_v1(bundle, false)
                _ = hosted_safe_artifact_root_close_v1(authority)
                return Err("signed Clang payload exceeds its slot bound")
            # The retained provider deliberately caps each transfer at 16 MiB;
            # the request bound is an artifact-wide ceiling, not a chunk size.
            val chunk_bound = if remaining < 16777216: remaining else: 16777216
            val read = hosted_safe_artifact_bundle3_read_stage_v1(
                bundle, slot, chunk_bound)
            if val Err(finish) = read:
                _ = hosted_safe_artifact_root_close_v1(authority)
                return Err("signed Clang payload staging rejected: " + finish.detail)
            val chunk = read.unwrap()
            if chunk.len() > request.max_artifact_bytes[slot] - artifact.len():
                _ = hosted_safe_artifact_bundle3_finish_v1(bundle, false)
                _ = hosted_safe_artifact_root_close_v1(authority)
                return Err("signed Clang payload exceeds its slot bound")
            for byte in chunk: artifact.push(byte)
            val done = hosted_safe_artifact_bundle3_slot_complete_v1(bundle, slot)
            if val Err(reason) = done:
                _ = hosted_safe_artifact_bundle3_finish_v1(bundle, false)
                _ = hosted_safe_artifact_root_close_v1(authority)
                return Err("signed Clang completion rejected: " + reason)
            complete = done.unwrap()
            if not complete and chunk.len() == 0:
                _ = hosted_safe_artifact_bundle3_finish_v1(bundle, false)
                _ = hosted_safe_artifact_root_close_v1(authority)
                return Err("signed Clang payload staging made no progress")
        val identity_result = hosted_safe_artifact_bundle3_identity_v1(bundle, slot)
        if val Err(finish) = identity_result:
            _ = hosted_safe_artifact_root_close_v1(authority)
            return Err("signed Clang identity rejected: " + finish.detail)
        val identity = identity_result.unwrap()
        if artifact.len() == 0 or identity[2] != artifact.len():
            _ = hosted_safe_artifact_bundle3_finish_v1(bundle, false)
            _ = hosted_safe_artifact_root_close_v1(authority)
            return Err("signed Clang payload identity size mismatch")
        val digest = sha256_u8_hex(artifact)
        if not image_native_executable_payload_admitted_v1(
            artifact, image_target_architecture(arch)):
            _ = hosted_safe_artifact_bundle3_finish_v1(bundle, false)
            _ = hosted_safe_artifact_root_close_v1(authority)
            return Err("signed Clang payload executable admission rejected: " +
                request.canonical_guest_paths[slot])
        receipts.push("schema=simpleos-artifact-identity-v1\nartifact_sha256={digest}\nartifact_size={artifact.len()}\nartifact_identity=dev={identity[0]}:ino={identity[1]}:size={identity[2]}:mtime={identity[3]}.{identity[4]}\ncanonical_path={request.canonical_guest_paths[slot]}\ntarget_os=simpleos\ntarget_arch={target_arch}\ntarget_abi=simpleos\nmanifest_sam1_sha256={sha256_u8_hex(manifests[slot])}\n")
        artifact_sha256.push(digest)
        slot = slot + 1
    val encoded = signed_catalog_encode_authenticated_batch3_v1(
        manifests, receipts, seed, trust, aliases, request.scr1_leaves,
        request.canonical_guest_paths, target_arch)
    if val Err(reason) = encoded:
        _ = hosted_safe_artifact_bundle3_finish_v1(bundle, false)
        _ = hosted_safe_artifact_root_close_v1(authority)
        return Err("signed Clang SCR1 encoding rejected: " + reason)
    val records = encoded.unwrap().records
    slot = 0
    while slot < 3:
        val staged = hosted_safe_artifact_bundle3_stage_scr1_v1(
            bundle, slot, records[slot], SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1)
        if val Err(finish) = staged:
            _ = hosted_safe_artifact_root_close_v1(authority)
            return Err("signed Clang SCR1 staging rejected: " + finish.detail)
        slot = slot + 1
    val finished = hosted_safe_artifact_bundle3_finish_v1(bundle, true)
    if val Err(reason) = finished:
        _ = hosted_safe_artifact_root_close_v1(authority)
        return Err("signed Clang bundle finish rejected: " + reason)
    val receipt = finished.unwrap()
    val closed = hosted_safe_artifact_root_close_v1(authority)
    if val Err(reason) = closed: return Err("signed Clang root close failed: " + reason)
    if not receipt.committed or not receipt.durable or receipt.quarantined or
        receipt.artifact_count != 3:
        return Err("signed Clang bundle was not durably published: " + receipt.detail)
    var media = _empty_signed_catalog_media_v1()
    media.signed_clang_enabled = true
    val bundle_prefix = if request.trusted_root.ends_with("/"):
        request.trusted_root + request.bundle_relative_path
    else:
        request.trusted_root + "/" + request.bundle_relative_path
    media.signed_clang_artifact_paths = [
        bundle_prefix + "/" + request.payload_leaves[0],
        bundle_prefix + "/" + request.payload_leaves[1],
        bundle_prefix + "/" + request.payload_leaves[2],
    ]
    media.signed_clang_artifact_sha256 = artifact_sha256
    media.signed_clang_scr1_bytes = records
    media.signed_clang_trust_config_bytes = trust
    Ok(media)

fn _signed_catalog_request_present_v1(request: ImageSignedCatalogRequestV1) -> bool:
    request.trusted_root != "" or request.artifact_relative_path != "" or
        request.manifest_relative_path != "" or
        request.identity_receipt_relative_path != "" or
        request.signer_seed_relative_path != "" or
        request.trust_config_relative_path != "" or
        request.aliases_relative_path != "" or
        request.output_scr1_relative_path != ""

fn _signed_catalog_request_complete_v1(request: ImageSignedCatalogRequestV1) -> bool:
    if request.trusted_root == "" or request.artifact_relative_path == "" or
        request.build_receipt_relative_path == "" or
        request.manifest_relative_path == "" or
        request.identity_receipt_relative_path == "" or
        request.signer_seed_relative_path == "" or
        request.trust_config_relative_path == "" or
        request.output_scr1_relative_path == "":
        return false
    val required = [request.artifact_relative_path,
        request.build_receipt_relative_path,
        request.manifest_relative_path, request.identity_receipt_relative_path,
        request.signer_seed_relative_path, request.trust_config_relative_path,
        request.output_scr1_relative_path]
    var index: i64 = 0
    while index < required.len():
        var prior: i64 = 0
        while prior < index:
            if required[prior] == required[index]: return false
            prior = prior + 1
        if request.aliases_relative_path != "" and
            request.aliases_relative_path == required[index]:
            return false
        index = index + 1
    true

fn _produce_and_load_signed_catalog_media_v1(
    request: ImageSignedCatalogRequestV1,
) -> Result<ImageSignedCatalogLoadV1, text>:
    # This is deliberately the pinned Simplebox catalog path, not a general
    # Clang/LLVM payload path.  The boot ingestion owner enforces this same
    # 16 MiB payload ceiling before catalog mutation.
    if not _signed_catalog_request_complete_v1(request):
        return Err("signed catalog requested but required signing inputs are missing")
    # Validate build provenance before the producer durably publishes SCR1.
    # The receipt is still read beneath the same no-follow trusted root.
    val receipt_root = hosted_safe_artifact_root_acquire_v1(request.trusted_root)
    if val Err(reason) = receipt_root:
        return Err("signed catalog receipt root rejected: " + reason)
    val receipt_authority = receipt_root.unwrap()
    val build_receipt = hosted_safe_artifact_read_once_v1(
        receipt_authority, request.build_receipt_relative_path,
        IMAGE_MAX_BUILD_STAMP_BYTES_V1)
    val receipt_closed = hosted_safe_artifact_root_close_v1(receipt_authority)
    if val Err(reason) = receipt_closed:
        return Err("signed catalog receipt root close failed: " + reason)
    if val Err(reason) = build_receipt:
        return Err("signed Simplebox build receipt read rejected: " + reason)
    val parsed_receipt = _parse_simplebox_receipt_v1(
        bytes_to_text(build_receipt.unwrap()))?
    if not _valid_simplebox_provenance_receipt_v1(parsed_receipt):
        return Err("signed catalog requires a valid self-hosted Simplebox build receipt")
    val produced = signed_catalog_record_produce_v1(
        SignedCatalogRecordProduceRequestV1(
            trusted_absolute_root: request.trusted_root,
            manifest_relative_path: request.manifest_relative_path,
            artifact_receipt_relative_path: request.identity_receipt_relative_path,
            signer_seed_relative_path: request.signer_seed_relative_path,
            trust_config_relative_path: request.trust_config_relative_path,
            aliases_relative_path: request.aliases_relative_path,
            output_scr1_relative_path: request.output_scr1_relative_path,
            expected_canonical_path: SIMPLEBOX_CANONICAL_PATH_V1,
            expected_target_arch: ""))
    if not produced.ok:
        return Err("signed catalog production rejected: " + produced.reason)

    val opened = hosted_safe_artifact_root_acquire_v1(request.trusted_root)
    if val Err(reason) = opened:
        return Err("signed catalog media root rejected: " + reason)
    val authority = opened.unwrap()
    val artifact = hosted_safe_artifact_read_once_v1(
        authority, request.artifact_relative_path,
        HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1)
    val scr1 = hosted_safe_artifact_read_once_v1(
        authority, request.output_scr1_relative_path,
        SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1)
    val trust = hosted_safe_artifact_read_once_v1(
        authority, request.trust_config_relative_path, 16384)
    val closed = hosted_safe_artifact_root_close_v1(authority)
    if val Err(reason) = closed:
        return Err("signed catalog media root close failed: " + reason)
    if val Err(reason) = artifact:
        return Err("signed Simplebox artifact read rejected (payload must be at most " +
            HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1.to_text() + " bytes): " + reason)
    if val Err(reason) = scr1:
        return Err("signed catalog SCR1 read rejected: " + reason)
    if val Err(reason) = trust:
        return Err("signed catalog trust config read rejected: " + reason)
    val artifact_bytes = artifact.unwrap()
    if artifact_bytes.len() == 0 or
        sha256_u8_hex(artifact_bytes) != parsed_receipt.artifact_sha256:
        return Err("signed catalog retained artifact does not match image artifact")
    Ok(ImageSignedCatalogLoadV1(
        media: ImageSignedCatalogMediaV1(
            enabled: true, scr1_bytes: scr1.unwrap(),
            trust_config_bytes: trust.unwrap(), toolchain_enabled: false,
            toolchain_artifact_bytes: [], toolchain_scr1_bytes: [],
            toolchain_trust_config_bytes: [], signed_clang_enabled: false,
            signed_clang_artifact_paths: [], signed_clang_artifact_sha256: [],
            signed_clang_scr1_bytes: [],
            signed_clang_trust_config_bytes: []),
        artifact_bytes: artifact_bytes, receipt: parsed_receipt))
struct PartitionLayout:
    efi_start_sector: u64
    efi_size_sectors: u64
    root_start_sector: u64
    root_size_sectors: u64
    total_sectors: u64
var _image_builder_rootfs_backend: text = "fat32"

val _IMAGE_SCREEN_TYPES: [text] = ["wm", "2d", "web", "gui"]
val _IMAGE_SCREEN_SIMD_VALUES: [text] = ["auto", "on", "off", "sse2", "avx2", "neon"]
var _image_builder_screen_type: text = ""
var _image_builder_screen_res: text = ""
var _image_builder_screen_simd: text = ""
fn _image_builder_reset_screen():
    _image_builder_screen_type = ""
    _image_builder_screen_res = ""
    _image_builder_screen_simd = ""
fn _validated_screen_type(raw: text) -> Result<text, text>:
    val value = raw.trim().to_lower()
    if value == "":
        return Result.Ok("")
    for t in _IMAGE_SCREEN_TYPES:
        if value == t:
            return Result.Ok(value)
    Result.Err("SimpleOS image screen_type invalid: \"{raw}\" (want wm|2d|web|gui)")
fn _validated_screen_simd(raw: text) -> Result<text, text>:
    val value = raw.trim().to_lower()
    if value == "":
        return Result.Ok("")
    for s in _IMAGE_SCREEN_SIMD_VALUES:
        if value == s:
            return Result.Ok(value)
    Result.Err("SimpleOS image screen_simd invalid: \"{raw}\" (want auto|on|off|sse2|avx2|neon)")
fn _validated_screen_res(raw: text) -> Result<text, text>:
    val value = raw.trim().to_lower()
    if value == "":
        return Result.Ok("")
    val parts = value.split("x")
    if parts.len() != 2:
        return Result.Err("SimpleOS image screen_res invalid: \"{raw}\" (want WxH)")
    val w = parts[0].to_i64()
    val h = parts[1].to_i64()
    if w <= 0 or h <= 0:
        return Result.Err("SimpleOS image screen_res invalid: \"{raw}\" (want WxH)")
    Result.Ok("{w}x{h}")
pub fn image_builder_set_screen(screen_type: text, screen_res: text, screen_simd: text) -> Result<bool, text>:
    """Request validated boot screen configuration for the next image build."""
    val t = _validated_screen_type(screen_type)?
    val r = _validated_screen_res(screen_res)?
    val s = _validated_screen_simd(screen_simd)?
    _image_builder_screen_type = t
    _image_builder_screen_res = r
    _image_builder_screen_simd = s
    Result.Ok(true)

class ImageBuilder:
    config: ImageConfig
    layout: PartitionLayout
impl ImageBuilder:
    static fn new(config: ImageConfig) -> ImageBuilder:
        val layout = _compute_layout(config.image_size_mb)
        ImageBuilder(config: config, layout: layout)

    fn build(observer: _ImageSimpleboxValidationObserverV1) -> Result<text, text>:
        if self.config.image_size_mb < MIN_IMAGE_SIZE_MB_V1:
            return Err("SimpleOS image size must be at least {MIN_IMAGE_SIZE_MB_V1} MB")
        val arch_name = pkg_arch_to_text(self.config.arch)
        val artifact_kind = if self.config.include_installer: "installer-dvd" else: "disk-image"
        val simple_binary = image_effective_simple_binary(self.config.simple_binary)
        if simple_binary != "":
            val simple_check = image_validate_simple_binary(simple_binary, self.config.arch)
            if val Err(e) = simple_check:
                return Err(e)
        var simplebox_decision = _empty_simplebox_validated_decision_v1()
        if self.config.simplebox_artifact.bytes.len() > 0 or
           self.config.simplebox_artifact.receipt.schema_version != 0:
            simplebox_decision = _validate_simplebox_artifact_v1(
                self.config.simplebox_artifact, self.config.arch, observer)?
        var kernel_bytes: [u8] = []
        if self.config.kernel_path != "" and rt_file_exists(self.config.kernel_path):
            kernel_bytes = image_read_file_bounded_v1(self.config.kernel_path, IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1, "SimpleOS kernel payload")?
        var font_guest_paths: [text] = []
        var font_blobs: [[u8]] = []
        for entry in simpleos_font_bundle_entries():
            val loaded = load_simpleos_font_bundle_entry(entry)
            if not loaded.valid:
                return Err("SimpleOS font bundle entry invalid: " + loaded.reason)
            font_guest_paths.push(entry.guest_long_path)
            font_blobs.push(loaded.data)
        print "Creating {artifact_kind}: {self.config.output_path}"
        print "  Architecture: {arch_name}"
        print "  Size: {self.config.image_size_mb} MB"
        val staging_root = _staging_root(self.config.output_path)
        val efi_root = "{staging_root}/efi"
        val rootfs_root = "{staging_root}/rootfs"
        val reports_root = "{staging_root}/reports"
        _ensure_dir(staging_root)
        _ensure_dir(efi_root)
        _ensure_dir(rootfs_root)
        _ensure_dir(reports_root)
        var deploy_manifest = _manifest_header(self.config, self.layout)
        deploy_manifest = deploy_manifest + self._populate_efi_partition(efi_root, kernel_bytes)
        val root_manifest = self._populate_root_partition(
            rootfs_root, kernel_bytes, font_guest_paths, font_blobs,
            simplebox_decision)?
        deploy_manifest = deploy_manifest + root_manifest

        if self.config.include_installer:
            deploy_manifest = deploy_manifest + self._populate_install_media(rootfs_root, kernel_bytes)?
        _validate_staged_rootfs_budget_v1(rootfs_root, self.layout)?
        val manifest_path = "{reports_root}/deployed-files.sdn"
        write_text(manifest_path, deploy_manifest)
        write_text(_sidecar_manifest_path(self.config.output_path), deploy_manifest)
        val artifact_result = self._materialize_primary_artifact(manifest_path)
        if val Err(e) = artifact_result:
            return Result.Err(e)

        print "  Staged filesystem: {rootfs_root}; manifest: {manifest_path}"
        print "Image created: {self.config.output_path}"
        Result.Ok(self.config.output_path)

    fn _native_payload_manifest(
        destination: text, guest_path: text, owner: text, role: text, bytes: [u8],
    ) -> text:
        val decision = image_package_payload_decision_v1(
            owner, guest_path, bytes, image_target_architecture(self.config.arch))
        if decision.write_payload:
            if rt_file_write_bytes(destination, bytes):
                return _manifest_file(guest_path, role, owner)
            return image_package_payload_decision_v1(
                owner, guest_path, [], image_target_architecture(self.config.arch)).inventory_row
        decision.inventory_row

    fn _populate_efi_partition(efi_root: text, kernel_bytes: [u8]) -> text:
        _ensure_dir("{efi_root}/EFI")
        _ensure_dir("{efi_root}/EFI/BOOT")
        _ensure_dir("{efi_root}/simpleos")

        write_text("{efi_root}/limine.cfg", _effective_bootloader_config(self.config))

        var manifest = self._native_payload_manifest(
            "{efi_root}/kernel.elf", "/boot/kernel.elf",
            "simpleos-kernel", "efi-kernel", kernel_bytes)
        manifest = manifest + _manifest_file("/boot/limine.cfg", "bootloader-config", "simpleos-kernel")
        manifest

    fn _populate_root_partition(
        rootfs_root: text, kernel_bytes: [u8],
        font_guest_paths: [text], font_blobs: [[u8]],
        simplebox_decision: ImageSimpleboxValidatedDecisionV1,
    ) -> Result<text, text>:
        if font_guest_paths.len() != font_blobs.len():
            return Err("SimpleOS font asset staging input mismatch")
        for dir in _ROOT_LAYOUT:
            _ensure_dir("{rootfs_root}{dir}")

        write_text("{rootfs_root}/etc/hostname", "simpleos\n")
        write_text("{rootfs_root}/etc/fstab", image_fstab_payload())
        write_text("{rootfs_root}/etc/rc.conf", _rc_conf_template())
        _image_builder_reset_screen()
        write_text("{rootfs_root}/etc/pkg/repos.sdn", _pkg_repo_template())
        write_text("{rootfs_root}/etc/shell/profile.sdn", "shell = \"/bin/shell\"\n")
        write_text("{rootfs_root}/etc/rootfs.sdn", image_rootfs_backend_payload(_image_builder_rootfs_backend))
        _ensure_dir("{rootfs_root}/SYS")
        write_text("{rootfs_root}/SYS/ROOTFS.CFG", image_rootfs_boot_marker(_image_builder_rootfs_backend))

        var manifest = ""
        manifest = manifest + _manifest_file("/etc/hostname", "system-config", "simpleos-core")
        manifest = manifest + _manifest_file("/etc/fstab", "system-config", "simpleos-core")
        manifest = manifest + _manifest_file("/etc/rc.conf", "system-config", "simpleos-core")
        manifest = manifest + _manifest_file("/etc/pkg/repos.sdn", "pkg-config", "simpleos-tools")
        manifest = manifest + _manifest_file("/etc/shell/profile.sdn", "shell-config", "simpleos-shell")
        manifest = manifest + _manifest_file("/etc/rootfs.sdn", "rootfs-config", "simpleos-core")
        manifest = manifest + image_package_payload_decision_v1(
            "simpleos-core", "/sbin/init", [], image_target_architecture(self.config.arch)).inventory_row
        manifest = manifest + self._native_payload_manifest(
            "{rootfs_root}/boot/kernel.elf", "/boot/kernel.elf",
            "simpleos-kernel", "runtime-kernel", kernel_bytes)
        manifest = manifest + self._stage_simplebox_payload(
            rootfs_root, simplebox_decision)?
        manifest = manifest + self._stage_signed_catalog_media(
            rootfs_root, simplebox_decision)?
        manifest = manifest + _manifest_file("/SYS/ROOTFS.CFG", "rootfs-boot-marker", "simpleos-core")

        val packages = list_all_packages(self.config.arch)
        for pkg in packages:
            manifest = manifest + self._deploy_package(rootfs_root, pkg)?

        manifest = manifest + self._stage_simple_toolchain_payload(rootfs_root)?
        manifest = manifest + self._stage_clang_toolchain_payload(rootfs_root)?
        manifest = manifest + self._stage_rust_toolchain_payload(rootfs_root)
        var font_index: i64 = 0
        while font_index < font_guest_paths.len() and font_index < font_blobs.len():
            val font_path = font_guest_paths[font_index]
            _ensure_parent_dirs(rootfs_root, font_path)
            if not rt_file_write_bytes(rootfs_root + font_path, font_blobs[font_index]):
                return Err("SimpleOS font asset staging failed: " + font_path)
            val kind = if font_path.ends_with(".ttf"): "font-asset" else: "font-notice"
            manifest = manifest + _manifest_file(font_path, kind, "simpleos-core")
            font_index = font_index + 1
        Ok(manifest)

    fn _stage_simplebox_payload(
        rootfs_root: text,
        validated: ImageSimpleboxValidatedDecisionV1,
    ) -> Result<text, text>:
        val artifact = validated.artifact
        if artifact.bytes.len() == 0:
            return Ok(image_package_payload_decision_v1(
                "simpleos-core", SIMPLEBOX_CANONICAL_PATH_V1, [],
                image_target_architecture(self.config.arch)).inventory_row)
        if not validated.write_payload or not validated.manifest_deployed:
            return Err("SimpleOS simplebox payload policy rejected")
        if not rt_file_write_bytes(rootfs_root + SIMPLEBOX_CANONICAL_PATH_V1, artifact.bytes):
            return Err("SimpleOS simplebox artifact staging failed")
        val receipt = artifact.receipt
        var manifest = _manifest_file(
            SIMPLEBOX_CANONICAL_PATH_V1, "simplebox-native", "simpleos-tools")
        manifest = manifest + "[artifact_receipt]\npath = \"{SIMPLEBOX_CANONICAL_PATH_V1}\"\nschema_version = {receipt.schema_version}\nartifact_sha256 = \"{receipt.artifact_sha256}\"\ntarget = \"{receipt.target}\"\ncanonical_role = \"{receipt.canonical_role}\"\nentry = \"{receipt.entry}\"\nentry_closure = {receipt.entry_closure}\nbackend = \"{receipt.backend}\"\ncompiler = \"{receipt.compiler}\"\n\n"
        for alias in simplebox_canonical_aliases_v1():
            manifest = manifest + "[deploy_alias]\npath = \"{alias}\"\nalias_of = \"{SIMPLEBOX_CANONICAL_PATH_V1}\"\nartifact_sha256 = \"{receipt.artifact_sha256}\"\n\n"
        Ok(manifest)

    fn _stage_signed_catalog_media(
        rootfs_root: text,
        validated: ImageSimpleboxValidatedDecisionV1,
    ) -> Result<text, text>:
        val media = self.config.signed_catalog_media
        if not media.enabled: return Ok("")
        if validated.artifact.bytes.len() == 0 or
            media.scr1_bytes.len() == 0 or media.trust_config_bytes.len() == 0:
            return Err("signed catalog media is incomplete")
        if not rt_file_write_bytes(
            "{rootfs_root}/boot/bin/simplebox", validated.artifact.bytes):
            return Err("signed catalog boot payload staging failed")
        if not rt_file_write_bytes(
            "{rootfs_root}/boot/catalog/simplebox.scr1", media.scr1_bytes):
            return Err("signed catalog SCR1 staging failed")
        if not rt_file_write_bytes(
            "{rootfs_root}/boot/catalog/simplebox.trust", media.trust_config_bytes):
            return Err("signed catalog trust config staging failed")
        var manifest = _manifest_file(
            "/boot/bin/simplebox", "boot-catalog-payload", "simpleos-loader")
        manifest = manifest + _manifest_file(
            "/boot/catalog/simplebox.scr1", "boot-catalog-scr1", "simpleos-loader")
        manifest = manifest + _manifest_file(
            "/boot/catalog/simplebox.trust", "boot-catalog-trust", "simpleos-loader")
        Ok(manifest)

    fn _stage_simple_toolchain_payload(rootfs_root: text) -> Result<text, text>:
        val simple_binary = image_effective_simple_binary(self.config.simple_binary)
        if simple_binary == "" or not rt_file_exists(simple_binary):
            var blocked = ""
            for guest_path in IMAGE_SIMPLE_TOOLCHAIN_ROLE_PATHS:
                blocked = blocked + image_package_payload_decision_v1(
                    "simpleos-tools", guest_path, [], image_target_architecture(self.config.arch)).inventory_row
            return Ok(blocked)
        val simple_bytes = image_load_validated_simple_binary(
            simple_binary, self.config.arch)?

        val signed_media = self.config.signed_catalog_media
        if signed_media.toolchain_enabled:
            if signed_media.toolchain_scr1_bytes.len() != 3 or
                signed_media.toolchain_trust_config_bytes.len() == 0 or
                signed_media.toolchain_artifact_bytes != simple_bytes:
                return Err("signed toolchain catalog does not bind the staged Simple payload")
            val record_names = ["simple_interpreter.scr1", "simple_compiler.scr1",
                "simple_loader.scr1"]
            var record_index: i64 = 0
            while record_index < record_names.len():
                if not rt_file_write_bytes(
                    "{rootfs_root}/boot/catalog/{record_names[record_index]}",
                    signed_media.toolchain_scr1_bytes[record_index]):
                    return Err("signed toolchain SCR1 staging failed")
                record_index = record_index + 1
            if not rt_file_write_bytes(
                "{rootfs_root}/boot/catalog/simple_toolchain.trust",
                signed_media.toolchain_trust_config_bytes):
                return Err("signed toolchain trust config staging failed")

        var manifest = ""
        for guest_path in IMAGE_SIMPLE_TOOLCHAIN_ROLE_PATHS:
            val decision = image_package_payload_decision_v1(
                "simpleos-tools", guest_path, simple_bytes,
                image_target_architecture(self.config.arch))
            if not decision.write_payload or not decision.manifest_deployed:
                return Err("SimpleOS essential toolchain policy rejected: {guest_path}")
            val target_path = "{rootfs_root}{guest_path}"
            _ensure_parent_dirs(rootfs_root, guest_path)
            val ok = rt_file_write_bytes(target_path, simple_bytes)
            if not ok:
                return Err("SimpleOS essential toolchain staging failed: {guest_path}")
            manifest = manifest + _manifest_file(guest_path, "simple-toolchain-role", "simpleos-tools")

        if signed_media.toolchain_enabled:
            manifest = manifest + _manifest_file(
                "/boot/catalog/simple_interpreter.scr1", "boot-catalog-scr1", "simpleos-loader")
            manifest = manifest + _manifest_file(
                "/boot/catalog/simple_compiler.scr1", "boot-catalog-scr1", "simpleos-loader")
            manifest = manifest + _manifest_file(
                "/boot/catalog/simple_loader.scr1", "boot-catalog-scr1", "simpleos-loader")
            manifest = manifest + _manifest_file(
                "/boot/catalog/simple_toolchain.trust", "boot-catalog-trust", "simpleos-loader")

        _ensure_dir("{rootfs_root}/SYS")
        write_text("{rootfs_root}/SYS/SIMPLETOOL.SDN", image_simple_toolchain_manifest(simple_binary))
        manifest = manifest + _manifest_file("/SYS/SIMPLETOOL.SDN", "simple-toolchain-manifest", "simpleos-tools")
        Ok(manifest)

    fn _stage_clang_toolchain_payload(rootfs_root: text) -> Result<text, text>:
        val signed_media = self.config.signed_catalog_media
        if signed_media.signed_clang_enabled:
            if signed_media.signed_clang_artifact_paths.len() != 3 or
                signed_media.signed_clang_artifact_sha256.len() != 3 or
                signed_media.signed_clang_scr1_bytes.len() != 3 or
                signed_media.signed_clang_trust_config_bytes.len() == 0:
                return Err("signed Clang media is incomplete")
            val guest_paths = ["/usr/bin/clang", "/usr/bin/ld.lld", "/work/hello.elf"]
            val boot_payloads = ["/boot/bin/clang", "/boot/bin/ld.lld", "/boot/bin/hello.elf"]
            val boot_records = ["/boot/catalog/clang.scr1", "/boot/catalog/ld.lld.scr1",
                "/boot/catalog/hello.elf.scr1"]
            var manifest = ""
            var index: i64 = 0
            while index < 3:
                val source = signed_media.signed_clang_artifact_paths[index]
                val expected_sha256 =
                    signed_media.signed_clang_artifact_sha256[index]
                _ensure_parent_dirs(rootfs_root, guest_paths[index])
                _ensure_parent_dirs(rootfs_root, boot_payloads[index])
                # The pathname names the payload published by the retained
                # bundle transaction, but the root owner is already closed and
                # the namespace can change.  Stream it once, then authenticate
                # the image-owned copy against the admitted digest below.
                if not rt_file_copy(source, rootfs_root + guest_paths[index]):
                    return Err("signed Clang payload staging failed: " + guest_paths[index])
                # The digest is authenticated in its SCR1 record, so a
                # replacement or short copy after publication fails closed.
                if rt_file_hash_sha256(rootfs_root + guest_paths[index]) !=
                        expected_sha256:
                    return Err("signed Clang payload copy digest mismatch: " +
                        guest_paths[index])
                # Consume the mutable published path once.  Derive the loader
                # copy from the verified image-owned destination so a bundle
                # replacement cannot split the installed pair.
                if not rt_file_copy(
                    rootfs_root + guest_paths[index],
                    rootfs_root + boot_payloads[index]) or
                    rt_file_hash_sha256(rootfs_root + boot_payloads[index]) !=
                        expected_sha256:
                    return Err("signed Clang boot payload staging failed: " +
                        boot_payloads[index])
                if not rt_file_write_bytes(
                    rootfs_root + boot_records[index],
                    signed_media.signed_clang_scr1_bytes[index]):
                    return Err("signed Clang SCR1 staging failed: " + boot_records[index])
                manifest = manifest + _manifest_file(
                    guest_paths[index], "signed-clang-toolchain-payload", "simpleos-tools")
                manifest = manifest + _manifest_file(
                    boot_payloads[index], "boot-catalog-payload", "simpleos-loader")
                manifest = manifest + _manifest_file(
                    boot_records[index], "boot-catalog-scr1", "simpleos-loader")
                index = index + 1
            if not rt_file_write_bytes(
                "{rootfs_root}/boot/catalog/clang_toolchain.trust",
                signed_media.signed_clang_trust_config_bytes):
                return Err("signed Clang trust staging failed")
            manifest = manifest + _manifest_file(
                "/boot/catalog/clang_toolchain.trust", "boot-catalog-trust",
                "simpleos-loader")

            return Ok(manifest)
        val clang_binary = image_effective_clang_binary()
        if clang_binary == "" or not rt_file_exists(clang_binary):
            var blocked = ""
            for guest_path in IMAGE_CLANG_GUEST_BIN_PATHS:
                blocked = blocked + image_package_payload_decision_v1(
                    "simpleos-tools", guest_path, [],
                    image_target_architecture(self.config.arch)).inventory_row
            _ensure_dir("{rootfs_root}/SYS")
            write_text("{rootfs_root}/SYS/CLANGTOOL.SDN", image_clang_fixture_payload())
            return Ok(blocked + _manifest_file(
                "/SYS/CLANGTOOL.SDN", "clang-toolchain-fixture", "simpleos-tools"))
        val clang_bytes = image_read_file_bounded_v1(clang_binary, IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1, "SimpleOS Clang payload").unwrap_or([])
        val architecture = image_target_architecture(self.config.arch)
        if not image_native_executable_payload_admitted_v1(clang_bytes, architecture):
            var blocked = ""
            for guest_path in IMAGE_CLANG_GUEST_BIN_PATHS:
                blocked = blocked + image_package_payload_decision_v1(
                    "simpleos-tools", guest_path, [], architecture).inventory_row
            return Ok(blocked)

        var manifest = ""
        for guest_path in IMAGE_CLANG_GUEST_BIN_PATHS:
            _ensure_parent_dirs(rootfs_root, guest_path)
            val decision = image_package_payload_decision_v1(
                "simpleos-tools", guest_path, clang_bytes, architecture)
            if decision.write_payload:
                if rt_file_write_bytes("{rootfs_root}{guest_path}", clang_bytes):
                    manifest = manifest + _manifest_file(guest_path, "clang-toolchain-binary", "simpleos-tools")
                else:
                    manifest = manifest + image_package_payload_decision_v1(
                        "simpleos-tools", guest_path, [], architecture).inventory_row

        val sysroot = image_effective_sysroot_dir(self.config.arch)
        var sysroot_embedded = false
        var include_root_sha256 = ""
        if image_clang_sysroot_complete_v1(sysroot):
            _ensure_dir("{rootfs_root}/usr/include")
            _ensure_dir("{rootfs_root}/usr/lib")
            _ensure_dir("{rootfs_root}/usr/share/simpleos")
            val includes_ok = image_copy_tree(
                "{sysroot}/include", "{rootfs_root}/usr/include")
            val libs_ok = image_copy_tree(
                "{sysroot}/lib", "{rootfs_root}/usr/lib")
            val linker_ok = image_copy_tree(
                "{sysroot}/share/simpleos", "{rootfs_root}/usr/share/simpleos")
            val include_manifest = clang_include_manifest_build_v1(
                "{sysroot}/include", image_target_triple_v1(self.config.arch))
            var include_manifest_ok = false
            if includes_ok and include_manifest.ok:
                include_manifest_ok = write_text(
                    "{rootfs_root}/usr/include/.simpleos-sysroot.merkle",
                    include_manifest.content)
                if include_manifest_ok:
                    include_root_sha256 = include_manifest.root_sha256
            sysroot_embedded = include_manifest_ok and libs_ok and linker_ok
            if include_manifest_ok:
                manifest = manifest + _manifest_file(
                    "/usr/include", "clang-sysroot-headers", "simpleos-tools")
                manifest = manifest + _manifest_file(
                    "/usr/include/.simpleos-sysroot.merkle",
                    "clang-sysroot-header-proof", "simpleos-tools")
            if libs_ok:
                manifest = manifest + _manifest_file("/usr/lib", "clang-sysroot-libs", "simpleos-tools")
            if linker_ok:
                manifest = manifest + _manifest_file(
                    "/usr/share/simpleos/simpleos.ld",
                    "clang-sysroot-linker-script", "simpleos-tools")

        _ensure_dir("{rootfs_root}/SYS")
        write_text(
            "{rootfs_root}/SYS/CLANGTOOL.SDN",
            image_clang_embedded_payload(
                clang_binary, sysroot, sysroot_embedded, self.config.arch,
                include_root_sha256))
        manifest = manifest + _manifest_file("/SYS/CLANGTOOL.SDN", "clang-toolchain-manifest", "simpleos-tools")
        Ok(manifest)

    fn _stage_rust_toolchain_payload(rootfs_root: text) -> text:
        val rustc_binary = image_effective_rustc_binary()
        if rustc_binary == "" or not rt_file_exists(rustc_binary):
            var blocked = ""
            for guest_path in IMAGE_RUSTC_GUEST_BIN_PATHS:
                blocked = blocked + image_package_payload_decision_v1(
                    "simpleos-tools", guest_path, [],
                    image_target_architecture(self.config.arch)).inventory_row
            _ensure_dir("{rootfs_root}/SYS")
            write_text("{rootfs_root}/SYS/RUSTTOOL.SDN", image_rust_fixture_payload())
            return blocked + _manifest_file(
                "/SYS/RUSTTOOL.SDN", "rust-toolchain-fixture", "simpleos-tools")
        val rustc_bytes = image_read_file_bounded_v1(rustc_binary, IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1, "SimpleOS Rust payload").unwrap_or([])
        val architecture = image_target_architecture(self.config.arch)
        if not image_native_executable_payload_admitted_v1(rustc_bytes, architecture):
            var blocked = ""
            for guest_path in IMAGE_RUSTC_GUEST_BIN_PATHS:
                blocked = blocked + image_package_payload_decision_v1(
                    "simpleos-tools", guest_path, [], architecture).inventory_row
            return blocked

        var manifest = ""
        for guest_path in IMAGE_RUSTC_GUEST_BIN_PATHS:
            _ensure_parent_dirs(rootfs_root, guest_path)
            val decision = image_package_payload_decision_v1(
                "simpleos-tools", guest_path, rustc_bytes, architecture)
            if decision.write_payload:
                if rt_file_write_bytes("{rootfs_root}{guest_path}", rustc_bytes):
                    manifest = manifest + _manifest_file(guest_path, "rust-toolchain-binary", "simpleos-tools")
                else:
                    manifest = manifest + image_package_payload_decision_v1(
                        "simpleos-tools", guest_path, [], architecture).inventory_row

        _ensure_dir("{rootfs_root}/SYS")
        write_text("{rootfs_root}/SYS/RUSTTOOL.SDN", image_rust_embedded_payload(rustc_binary))
        manifest = manifest + _manifest_file("/SYS/RUSTTOOL.SDN", "rust-toolchain-manifest", "simpleos-tools")
        manifest

    fn _populate_install_media(rootfs_root: text, kernel_bytes: [u8]) -> Result<text, text>:
        val installer_root = "{rootfs_root}/usr/libexec/simpleos-installer"
        _ensure_dir(installer_root)
        _ensure_dir("{installer_root}/kernel")
        _ensure_dir("{installer_root}/packages")

        var manifest = image_package_payload_decision_v1(
            "simpleos-installer", "/usr/libexec/simpleos-installer/installer",
            [], image_target_architecture(self.config.arch)).inventory_row
        manifest = manifest + self._native_payload_manifest(
            "{installer_root}/kernel/kernel.elf",
            "/usr/libexec/simpleos-installer/kernel/kernel.elf",
            "simpleos-installer", "install-media-kernel", kernel_bytes)

        if self.config.package_dir != "":
            val entries = readdir(self.config.package_dir)
            for entry in entries:
                if entry.ends_with(".spk"):
                    val source_path = "{self.config.package_dir}/{entry}"
                    val content = image_read_text_bounded_v1(
                        source_path, IMAGE_MAX_PACKAGE_ARCHIVE_BYTES_V1,
                        "SimpleOS install package")?
                    if not write_text("{installer_root}/packages/{entry}", content):
                        return Err("SimpleOS install package staging failed: {entry}")
                    manifest = manifest + _manifest_file("/usr/libexec/simpleos-installer/packages/{entry}", "install-package", "simpleos-installer")
        Ok(manifest)

    fn _deploy_package(rootfs_root: text, pkg: ExtendedManifest) -> Result<text, text>:
        var manifest = ""
        var deployed_count: i64 = 0
        var blocked_count: i64 = 0
        if pkg.pkg_type == PackageType.Meta:
            if not write_text("{rootfs_root}/var/db/pkg/installed/{pkg.base.name}.sdn",
                "# meta-package\nname = \"{pkg.base.name}\"\n"):
                return Err("Package database write failed: {pkg.base.name}")
            return Ok(_manifest_file("/var/db/pkg/installed/{pkg.base.name}.sdn", "pkg-db", pkg.base.name))

        for file_path in pkg.base.files:
            if file_path == "":
                continue
            if file_path.ends_with("/"):
                _ensure_dir("{rootfs_root}{file_path}")
                manifest = manifest + _manifest_dir(file_path, pkg.base.name)
                deployed_count = deployed_count + 1
            else:
                val decision = image_package_payload_decision_v1(
                    pkg.base.name, file_path, [], image_target_architecture(self.config.arch))
                if decision.action == "reject-invalid-metadata":
                    return Err("Package payload metadata rejected: {pkg.base.name}")
                if decision.write_payload:
                    _ensure_parent_dirs(rootfs_root, file_path)
                    val owned_payload = image_package_metadata_payload_v1(
                        pkg.base.name, file_path, self.config.arch)
                    if owned_payload == "":
                        return Err("Installer-owned package metadata renderer missing: {file_path}")
                    if not write_text("{rootfs_root}{file_path}", owned_payload):
                        return Err("Package metadata payload write failed: {file_path}")
                if decision.manifest_deployed:
                    manifest = manifest + _manifest_file(file_path, "package-metadata", pkg.base.name)
                    deployed_count = deployed_count + 1
                else:
                    manifest = manifest + decision.inventory_row
                    blocked_count = blocked_count + 1
        if not write_text("{rootfs_root}/var/db/pkg/installed/{pkg.base.name}.sdn",
            _installed_pkg_record(pkg, deployed_count, blocked_count)):
            return Err("Package database write failed: {pkg.base.name}")
        manifest = manifest + _manifest_file("/var/db/pkg/installed/{pkg.base.name}.sdn", "pkg-db", pkg.base.name)
        Ok(manifest)

    fn _materialize_primary_artifact(manifest_path: text) -> Result<bool, text>:
        if self.config.arch == PkgArch.X86_64 and not self.config.include_installer:
            val args = [
                "-c",
                _make_os_disk_command(self.config)
            ]
            val (stdout, stderr, exit_code) = rt_process_run_timeout("/bin/sh", args, 120000)
            if stdout != "":
                print stdout.trim()
            if stderr != "":
                print stderr.trim()
            if exit_code == 0 and rt_file_exists(self.config.output_path):
                return Result.Ok(true)
            return Result.Err("FAT32 disk generation failed; refusing non-bootable descriptor fallback")
        _write_artifact_descriptor(self.config, self.layout, manifest_path)
        Result.Ok(true)

fn _build_image_v1(config: ImageConfig) -> Result<text, text>:
    ImageBuilder.new(config).build(_ImageSimpleboxValidationObserverV1.new())

fn build_usb_installer_image(
    arch: PkgArch,
    kernel_path: text,
    package_dir: text,
    output_path: text,
    size_mb: u64
) -> Result<text, text>:
    val config = ImageConfig(
        arch: arch,
        output_path: output_path,
        image_size_mb: if size_mb > 0: size_mb else: DEFAULT_IMAGE_SIZE_MB,
        kernel_path: kernel_path,
        bootloader_config: image_installer_bootloader_config(arch),
        package_dir: package_dir,
        simple_binary: "",
        simplebox_artifact: _empty_simplebox_artifact_v1(),
        signed_catalog_media: _empty_signed_catalog_media_v1(),
        include_installer: true
    )
    _image_builder_rootfs_backend = "fat32"
    _build_image_v1(config)

