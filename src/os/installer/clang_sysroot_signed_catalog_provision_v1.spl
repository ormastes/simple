"""Safe-root provisioner for the six externally signed Clang sysroot rows."""

use os.installer.signed_catalog_bundle_provisioner_v1.{
    SignedCatalogExternalInputV1, SignedCatalogBoundBundleV1,
    signed_catalog_bundle_provision_from_safe_root_v1
}
use os.kernel.loader.clang_sysroot_launch_grants_v1.{
    CLANG_SYSROOT_INCLUDE_MANIFEST_PATH_V1,
    CLANG_SYSROOT_LINKER_SCRIPT_PATH_V1, CLANG_SYSROOT_CRT0_PATH_V1,
    CLANG_SYSROOT_LIBC_PATH_V1, CLANG_SYSROOT_RUNTIME_PATH_V1,
    CLANG_SYSROOT_LIBM_PATH_V1
}

pub const CLANG_SYSROOT_SIGNED_INPUT_COUNT_V1: i64 = 6
pub const CLANG_TOOLCHAIN_SIGNED_INPUT_COUNT_V1: i64 = 9

fn _required_v1() -> [text]:
    [CLANG_SYSROOT_INCLUDE_MANIFEST_PATH_V1,
     CLANG_SYSROOT_LINKER_SCRIPT_PATH_V1, CLANG_SYSROOT_CRT0_PATH_V1,
     CLANG_SYSROOT_LIBC_PATH_V1, CLANG_SYSROOT_RUNTIME_PATH_V1,
     CLANG_SYSROOT_LIBM_PATH_V1]

pub fn clang_sysroot_signed_catalog_provision_v1(
    trusted_absolute_root: text,
    externally_signed_inputs: [SignedCatalogExternalInputV1]
) -> SignedCatalogBoundBundleV1:
    if externally_signed_inputs.len() != CLANG_SYSROOT_SIGNED_INPUT_COUNT_V1:
        return SignedCatalogBoundBundleV1(
            ok: false, reason: "sysroot-record-count", records: [], receipts: [])
    val required = _required_v1()
    for path in required:
        var matches: i64 = 0
        for input in externally_signed_inputs:
            if input.manifest_projection.entrypoint == path: matches = matches + 1
        if matches != 1:
            return SignedCatalogBoundBundleV1(
                ok: false, reason: "sysroot-record-identity",
                records: [], receipts: [])
    signed_catalog_bundle_provision_from_safe_root_v1(
        trusted_absolute_root, externally_signed_inputs)

pub fn clang_toolchain_signed_catalog_provision_v1(
    trusted_absolute_root: text,
    externally_signed_inputs: [SignedCatalogExternalInputV1]
) -> SignedCatalogBoundBundleV1:
    """Bind Clang, LLD, hello, and all six sysroot rows below one retained root."""
    if externally_signed_inputs.len() != CLANG_TOOLCHAIN_SIGNED_INPUT_COUNT_V1:
        return SignedCatalogBoundBundleV1(
            ok: false, reason: "toolchain-record-count", records: [], receipts: [])
    var required = ["/usr/bin/clang", "/usr/bin/ld.lld", "/work/hello.elf"]
    for path in _required_v1(): required.push(path)
    for path in required:
        var matches: i64 = 0
        for input in externally_signed_inputs:
            if input.manifest_projection.entrypoint == path: matches = matches + 1
        if matches != 1:
            return SignedCatalogBoundBundleV1(
                ok: false, reason: "toolchain-record-identity",
                records: [], receipts: [])
    signed_catalog_bundle_provision_from_safe_root_v1(
        trusted_absolute_root, externally_signed_inputs)
