## Checked rootfs backend metadata publication for staged image filesystems.
use std.io_runtime.{dir_create_all, file_write_exact, file_read_result}
use os.installer.image_builder_payloads.{image_rootfs_backend_payload, image_rootfs_boot_marker}

pub fn image_validate_rootfs_markers(rootfs_root: text, backend: text) -> Result<bool, text>:
    """Require both staged files to match this build's selected backend."""
    val config = file_read_result("{rootfs_root}/etc/rootfs.sdn")?
    if config != image_rootfs_backend_payload(backend):
        return Err("SimpleOS rootfs backend configuration mismatch")
    val marker = file_read_result("{rootfs_root}/SYS/ROOTFS.CFG")?
    if marker != image_rootfs_boot_marker(backend):
        return Err("SimpleOS rootfs boot marker mismatch")
    Ok(true)

pub fn image_stage_rootfs_markers(rootfs_root: text, backend: text) -> Result<bool, text>:
    """Replace stale metadata and verify actual files before admitting the stage."""
    if not dir_create_all("{rootfs_root}/etc") or not dir_create_all("{rootfs_root}/SYS"):
        return Err("SimpleOS rootfs marker directory creation failed")
    if not file_write_exact("{rootfs_root}/etc/rootfs.sdn", image_rootfs_backend_payload(backend)):
        return Err("SimpleOS rootfs backend configuration write failed")
    if not file_write_exact("{rootfs_root}/SYS/ROOTFS.CFG", image_rootfs_boot_marker(backend)):
        return Err("SimpleOS rootfs boot marker write failed")
    image_validate_rootfs_markers(rootfs_root, backend)
