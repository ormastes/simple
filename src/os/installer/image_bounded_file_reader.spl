## Descriptor-bound installer boundary for changeable hosted artifact files.

use os.installer.image_package_payload_policy.{IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1}
use std.io.{file_is_regular_no_follow}
use std.common.io.read_only_file_view.{read_only_file_view_read_beneath_bounded_v1}
use std.common.text_bytes.{bytes_to_text}

val IMAGE_MAX_PACKAGE_ARCHIVE_BYTES_V1: i64 = 16777216
val IMAGE_MAX_BUILD_STAMP_BYTES_V1: i64 = 65536
# Hard cap of the native no-follow descriptor reader (read_only_file_view).
val IMAGE_FACADE_MAX_BYTES_V1: i64 = 16777216
val IMAGE_BOUNDED_FILE_READER_UNAVAILABLE_V1 = "bounded-nofollow-fd-reader-unavailable"

fn _split_parent_leaf(path: text) -> (text, text):
    val i = path.last_index_of("/")
    if i < 0:
        return (".", path)
    if i == 0:
        return ("/", path.slice(1, path.len()))
    (path.slice(0, i), path.slice(i + 1, path.len()))

fn image_read_file_bounded_v1(
    path: text, max_bytes: i64, artifact_role: text,
) -> Result<[u8], text>:
    if artifact_role == "" or artifact_role.contains("\0") or artifact_role.contains("\n"):
        return Err("installer bounded reader received an invalid artifact role")
    if max_bytes <= 0 or max_bytes > IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1:
        return Err("{artifact_role} has an invalid read bound")
    if not file_is_regular_no_follow(path):
        return Err("{artifact_role} is missing, not regular, or is a symlink")

    # The size/path check above is only an early diagnostic. The read itself is
    # bound to ONE descriptor: the native owner retains the parent directory,
    # opens the leaf with openat+O_NOFOLLOW, fstat-bounds it and detects
    # growth/replacement during the read, never reopening the name (TOCTOU).
    # The owner caps at IMAGE_FACADE_MAX_BYTES_V1; larger artifacts and hosts
    # without secure beneath-open (Windows) stay fail-closed.
    if max_bytes > IMAGE_FACADE_MAX_BYTES_V1:
        return Err("{artifact_role}: {IMAGE_BOUNDED_FILE_READER_UNAVAILABLE_V1}")
    val (root, leaf) = _split_parent_leaf(path)
    if leaf == "":
        return Err("{artifact_role} has no file name")
    match read_only_file_view_read_beneath_bounded_v1(root, leaf, max_bytes):
        case Ok(bytes): Ok(bytes)
        case Err(why): Err("{artifact_role}: {IMAGE_BOUNDED_FILE_READER_UNAVAILABLE_V1} ({why})")

fn image_read_text_bounded_v1(
    path: text, max_bytes: i64, artifact_role: text,
) -> Result<text, text>:
    val bytes = image_read_file_bounded_v1(path, max_bytes, artifact_role)?
    Ok(bytes_to_text(bytes))

export IMAGE_MAX_PACKAGE_ARCHIVE_BYTES_V1, IMAGE_MAX_BUILD_STAMP_BYTES_V1
export IMAGE_FACADE_MAX_BYTES_V1
export IMAGE_BOUNDED_FILE_READER_UNAVAILABLE_V1
export image_read_file_bounded_v1, image_read_text_bounded_v1
