pub(package) fn hosted_safe_artifact_bundle_n_add_slot_v1(
    grant: HostedSafeArtifactBundleNGrantV1, slot: i64, source: text,
    payload_leaf: text, scr1_leaf: text,
) -> Result<(), HostedSafeArtifactBundleNFinishReceiptV1>:
    if not _hosted_safe_artifact_lock_v1():
        return Err(HostedSafeArtifactBundleNFinishReceiptV1(committed: false, rolled_back: false, durable: false, quarantined: true, artifact_count: 0, detail: "hosted-safe-io-owner-unavailable"))
