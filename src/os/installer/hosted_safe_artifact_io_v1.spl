        return Err(HostedSafeArtifactBundleNFinishReceiptV1(committed: false, rolled_back: false, durable: false, quarantined: true, artifact_count: 0, detail: "hosted-safe-io-owner-quarantined"))
    Ok(())

pub(package) fn hosted_safe_artifact_bundle_n_stage_descriptor_v1(
    grant: HostedSafeArtifactBundleNGrantV1, descriptor: [u8], max_bytes: i64,
) -> Result<(), HostedSafeArtifactBundleNFinishReceiptV1>:
    if not _hosted_safe_artifact_lock_v1():
        return Err(HostedSafeArtifactBundleNFinishReceiptV1(committed: false, rolled_back: false, durable: false, quarantined: true, artifact_count: 0, detail: "hosted-safe-io-owner-unavailable"))
    if not _hosted_safe_artifact_bundle_n_matches_locked_v1(grant):
        _ = _hosted_safe_artifact_unlock_v1()
        return Err(HostedSafeArtifactBundleNFinishReceiptV1(committed: false, rolled_back: false, durable: false, quarantined: false, artifact_count: 0, detail: "hosted-safe-bundle-n-invalid"))
    val expected = _hosted_safe_artifact_owner_v1.bundle_n_expected_mask
    if (not _hosted_safe_artifact_owner_v1.bundle_n_sealed or
        _hosted_safe_artifact_owner_v1.bundle_n_read_mask != expected or
        _hosted_safe_artifact_owner_v1.bundle_n_identity_mask != expected or
        _hosted_safe_artifact_owner_v1.bundle_n_scr1_mask != expected or
        (_hosted_safe_artifact_owner_v1.bundle_n_descriptor_staged_mask & 1) != 0 or
        descriptor.len() <= 0 or max_bytes <= 0 or
        max_bytes > HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1 or
        not hosted_safe_artifact_provider_result_bounded_v1(descriptor, max_bytes) or
        descriptor.len() > _hosted_safe_artifact_owner_v1.bundle_n_max_bytes -
            _hosted_safe_artifact_owner_v1.bundle_n_staged_bytes -
            _hosted_safe_artifact_owner_v1.bundle_n_scr1_bytes):
        return Err(_hosted_safe_artifact_bundle_n_rollback_locked_v1("hosted-safe-bundle-n-descriptor-invalid"))
    var status = 0i64
    unsafe(capabilities: [ffi]):
        status = rt_hosted_safe_artifact_bundle_n_stage_descriptor_v1(
            _hosted_safe_artifact_owner_v1.bundle_n_token, descriptor, max_bytes)
    if status != 1:
        return Err(_hosted_safe_artifact_bundle_n_detached_rejection_locked_v1("hosted-safe-bundle-n-descriptor-rejected"))
    _hosted_safe_artifact_owner_v1.bundle_n_descriptor_staged_mask =
        _hosted_safe_artifact_owner_v1.bundle_n_descriptor_staged_mask | 1
    _hosted_safe_artifact_owner_v1.bundle_n_descriptor_bytes =
        _hosted_safe_artifact_owner_v1.bundle_n_descriptor_bytes + descriptor.len()
    if not _hosted_safe_artifact_unlock_v1():
        return Err(HostedSafeArtifactBundleNFinishReceiptV1(committed: false, rolled_back: false, durable: false, quarantined: true, artifact_count: 0, detail: "hosted-safe-io-owner-quarantined"))
    Ok(())

pub(package) fn hosted_safe_artifact_bundle_n_stage_named_descriptor_v1(
    grant: HostedSafeArtifactBundleNGrantV1, descriptor_slot: i64,
    descriptor_leaf: text, descriptor: [u8], max_bytes: i64,
) -> Result<(), HostedSafeArtifactBundleNFinishReceiptV1>:
    if not _hosted_safe_artifact_lock_v1():
        return Err(HostedSafeArtifactBundleNFinishReceiptV1(committed: false, rolled_back: false, durable: false, quarantined: true, artifact_count: 0, detail: "hosted-safe-io-owner-unavailable"))
    if not _hosted_safe_artifact_bundle_n_matches_locked_v1(grant):
        _ = _hosted_safe_artifact_unlock_v1()
        return Err(HostedSafeArtifactBundleNFinishReceiptV1(committed: false, rolled_back: false, durable: false, quarantined: false, artifact_count: 0, detail: "hosted-safe-bundle-n-invalid"))
    val expected = _hosted_safe_artifact_owner_v1.bundle_n_expected_mask
    # Slot zero remains owned by stage_descriptor_v1.  The named extension is
    # deliberately fixed at one additional descriptor so copied grants cannot
    # turn the retained root into an unbounded staging registry.
    if (descriptor_slot != 1 or
        not _hosted_safe_artifact_owner_v1.bundle_n_sealed or
        _hosted_safe_artifact_owner_v1.bundle_n_read_mask != expected or
        _hosted_safe_artifact_owner_v1.bundle_n_identity_mask != expected or
        _hosted_safe_artifact_owner_v1.bundle_n_scr1_mask != expected or
        _hosted_safe_artifact_owner_v1.bundle_n_descriptor_expected_mask != 3 or
        _hosted_safe_artifact_owner_v1.bundle_n_descriptor_staged_mask != 1 or
        not _hosted_safe_artifact_bundle3_leaf_valid_v1(descriptor_leaf) or
        _hosted_safe_artifact_owner_v1.bundle_n_leaves.len() < 2 or
        descriptor_leaf != _hosted_safe_artifact_owner_v1.bundle_n_leaves[1] or
        descriptor.len() <= 0 or max_bytes <= 0 or
        max_bytes > HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1 or
        not hosted_safe_artifact_provider_result_bounded_v1(descriptor, max_bytes) or
        descriptor.len() > _hosted_safe_artifact_owner_v1.bundle_n_max_bytes -
            _hosted_safe_artifact_owner_v1.bundle_n_staged_bytes -
            _hosted_safe_artifact_owner_v1.bundle_n_scr1_bytes -
            _hosted_safe_artifact_owner_v1.bundle_n_descriptor_bytes):
        return Err(_hosted_safe_artifact_bundle_n_rollback_locked_v1(
            "hosted-safe-bundle-n-named-descriptor-invalid"))
    var status = 0i64
    unsafe(capabilities: [ffi]):
        status = rt_hosted_safe_artifact_bundle_n_stage_named_descriptor_v1(
            _hosted_safe_artifact_owner_v1.bundle_n_token, descriptor_slot,
            descriptor_leaf, descriptor, max_bytes)
    if status != 1:
        return Err(_hosted_safe_artifact_bundle_n_detached_rejection_locked_v1(
            "hosted-safe-bundle-n-named-descriptor-rejected"))
    _hosted_safe_artifact_owner_v1.bundle_n_descriptor_staged_mask = 3
    _hosted_safe_artifact_owner_v1.bundle_n_descriptor_bytes =
        _hosted_safe_artifact_owner_v1.bundle_n_descriptor_bytes + descriptor.len()
    if not _hosted_safe_artifact_unlock_v1():
        return Err(HostedSafeArtifactBundleNFinishReceiptV1(committed: false, rolled_back: false, durable: false, quarantined: true, artifact_count: 0, detail: "hosted-safe-io-owner-quarantined"))
    Ok(())

pub(package) fn hosted_safe_artifact_bundle_n_finish_v1(
    grant: HostedSafeArtifactBundleNGrantV1, commit: bool,
) -> Result<HostedSafeArtifactBundleNFinishReceiptV1, text>:
    if not _hosted_safe_artifact_lock_v1(): return Err("hosted-safe-io-owner-unavailable")
    if not _hosted_safe_artifact_bundle_n_matches_locked_v1(grant):
        _ = _hosted_safe_artifact_unlock_v1(); return Err("hosted-safe-bundle-n-invalid")
    if not commit:
        return Ok(_hosted_safe_artifact_bundle_n_rollback_locked_v1("hosted-safe-bundle-n-caller-rollback"))
    val expected = _hosted_safe_artifact_owner_v1.bundle_n_expected_mask
    if (not _hosted_safe_artifact_owner_v1.bundle_n_sealed or
        _hosted_safe_artifact_owner_v1.bundle_n_add_mask != expected or
        _hosted_safe_artifact_owner_v1.bundle_n_read_mask != expected or
        _hosted_safe_artifact_owner_v1.bundle_n_identity_mask != expected or
        _hosted_safe_artifact_owner_v1.bundle_n_scr1_mask != expected or
        _hosted_safe_artifact_owner_v1.bundle_n_descriptor_staged_mask !=
            _hosted_safe_artifact_owner_v1.bundle_n_descriptor_expected_mask):
        return Ok(_hosted_safe_artifact_bundle_n_rollback_locked_v1("hosted-safe-bundle-n-incomplete-rollback"))
    val count = _hosted_safe_artifact_owner_v1.bundle_n_count
    var status = 0i64
    unsafe(capabilities: [ffi]):
        status = rt_hosted_safe_artifact_bundle_n_finish_v1(
            _hosted_safe_artifact_owner_v1.bundle_n_token, true)
    _hosted_safe_artifact_bundle_n_clear_locked_v1()
    val committed = status == 1 or status == -2
    val rolled_back = status == -1
    val quarantined_status = status == -2 or status == -3 or
        (status != 1 and status != -1)
    if quarantined_status: _hosted_safe_artifact_owner_v1.quarantined = true
    var quarantined = quarantined_status
    if not _hosted_safe_artifact_unlock_v1(): quarantined = true
    Ok(HostedSafeArtifactBundleNFinishReceiptV1(
        committed: committed, rolled_back: rolled_back, durable: status == 1,
        quarantined: quarantined, artifact_count: if committed: count else: 0,
        detail: if status == 1: "hosted-safe-bundle-n-committed" else:
            if status == -1: "hosted-safe-bundle-n-commit-rejected-rolled-back" else:
                if status == -2: "hosted-safe-bundle-n-visible-not-durable" else:
                    "hosted-safe-bundle-n-cleanup-quarantined"))

