        _hosted_safe_artifact_owner_v1.bundle_n_leaves.contains(scr1_leaf)):
        return Err(_hosted_safe_artifact_bundle_n_rollback_locked_v1(
            "hosted-safe-bundle-n-add-invalid"))
    var status = 0i64
    unsafe(capabilities: [ffi]):
        status = rt_hosted_safe_artifact_bundle_n_add_slot_v1(
            _hosted_safe_artifact_owner_v1.bundle_n_token, slot, source,
            payload_leaf, scr1_leaf)
    if status != 1:
        return Err(_hosted_safe_artifact_bundle_n_detached_rejection_locked_v1(
            "hosted-safe-bundle-n-add-rejected"))
    _hosted_safe_artifact_owner_v1.bundle_n_add_mask =
        _hosted_safe_artifact_owner_v1.bundle_n_add_mask | bit
    _hosted_safe_artifact_owner_v1.bundle_n_sources.push(source)
    _hosted_safe_artifact_owner_v1.bundle_n_leaves.push(payload_leaf)
    _hosted_safe_artifact_owner_v1.bundle_n_leaves.push(scr1_leaf)
    if not _hosted_safe_artifact_unlock_v1():
        return Err(HostedSafeArtifactBundleNFinishReceiptV1(committed: false, rolled_back: false, durable: false, quarantined: true, artifact_count: 0, detail: "hosted-safe-io-owner-quarantined"))
