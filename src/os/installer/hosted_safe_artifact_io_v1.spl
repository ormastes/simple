    if (_hosted_safe_artifact_owner_v1.bundle_n_sealed or bit == 0 or
        (_hosted_safe_artifact_owner_v1.bundle_n_add_mask & bit) != 0 or
        not hosted_safe_artifact_relative_path_valid_v1(source) or
        source == _hosted_safe_artifact_owner_v1.bundle_n_bundle or
        _hosted_safe_artifact_owner_v1.bundle_n_sources.contains(source) or
        not _hosted_safe_artifact_bundle3_leaf_valid_v1(payload_leaf) or
        not _hosted_safe_artifact_bundle3_leaf_valid_v1(scr1_leaf) or
        payload_leaf == scr1_leaf or
