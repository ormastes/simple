"""Installer-owned safe build-time SCR1 producer for SimpleOS image media.

The trusted media owner hashes a potentially large artifact while retaining
its no-follow file handle, then writes `simpleos-artifact-identity-v1` below
the retained build root. This producer never reopens that artifact. It
snapshots only bounded control inputs below one retained no-follow root and
publishes SCR1 through the same safe owner.

Caller contract for x86, ARM, and RISC-V image builders:

1. Open the artifact beneath the builder's retained no-follow root.
2. From that same handle, stream SHA-256 and capture positive byte size plus a
   stable owner identity (for example device/inode/generation coordinates).
3. Before releasing the handle, publish a bounded receipt containing exactly:
   `schema`, `artifact_sha256`, `artifact_size`, `artifact_identity`,
   `canonical_path`, `target_os`, `target_arch`, `target_abi`, and
   `manifest_sam1_sha256`.
4. Place canonical SAM1, the receipt, raw 32-byte seed, trust config, and
   optional newline-delimited aliases beneath the same trusted root.
5. Invoke this app with relative paths using `--trusted-root`,
   `--manifest-sam1`, `--artifact-receipt`, `--signer-seed`, `--trust-config`,
   optional `--aliases-file`, and `--output-scr1`; embed the new SCR1 beside
   the exact retained artifact.

No existing media pipeline currently owns all of those real signing inputs,
so this module deliberately supplies no unsigned or synthetic invocation.
"""

use std.common.string_core.{bytes_to_text}
use std.common.crypto.ed25519.{pure_ed25519_keypair_from_seed, pure_ed25519_sign, pure_ed25519_verify}
use std.common.crypto.secure_memory.{secure_zero_u8_slots}
use std.common.crypto.sha256.{sha256_u8_hex, sha256_stream_v1_new, sha256_stream_v1_update, sha256_stream_v1_finish_hex}
use std.common.structural.execution.simple_artifact_manifest_v1_codec.{
    SIMPLE_ARTIFACT_MANIFEST_V1_MAX_SIGNING_BYTES,
    decode_simple_artifact_manifest_v1_signing_bytes,
    encode_simple_artifact_manifest_v1_signing_bytes}
use os.installer.hosted_safe_artifact_io_v1.{
    HostedSafeArtifactRootAuthorityV1,
    hosted_safe_artifact_root_acquire_v1, hosted_safe_artifact_root_close_v1,
    hosted_safe_artifact_read_once_v1, hosted_safe_artifact_publish_prepare_v1,
    hosted_safe_artifact_publish_redeem_v1,
    hosted_safe_artifact_bundle_begin_v1, hosted_safe_artifact_bundle_read_stage_v1,
    hosted_safe_artifact_bundle_identity_v1, hosted_safe_artifact_bundle_stage_scr1_v1,
    hosted_safe_artifact_bundle_finish_v1}
use os.installer.simplebox_signed_catalog_provisioner_v1.{
    SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1,
    SimpleboxSignedCatalogExternalCandidateV1,
    simplebox_signed_catalog_record_encode_v1}
use os.kernel.loader.executable_manifest_signature_verifier.{ExecutableManifestTrustedSignerV1}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootPolicyV1, InstalledArtifactBootRecordV1,
    installed_artifact_boot_policy_shape_valid_v1}

val _CONTROL_TEXT_MAX_V1: i64 = 262144
pub const SIGNED_CATALOG_TRUST_CONFIG_MAX_BYTES_V1: i64 = 16384

pub struct SignedCatalogRecordProduceRequestV1:
    trusted_absolute_root: text
    manifest_relative_path: text
    artifact_receipt_relative_path: text
    signer_seed_relative_path: text
    trust_config_relative_path: text
    aliases_relative_path: text
    output_scr1_relative_path: text
    expected_canonical_path: text
    expected_target_arch: text
pub(package) struct SignedCatalogBundleProduceRequestV1:
    trusted_absolute_root: text
    source_relative_path: text
    bundle_relative_path: text
    payload_leaf: text
    scr1_leaf: text
    manifest_relative_path: text
    signer_seed_relative_path: text
    trust_config_relative_path: text
    aliases_relative_path: text
    canonical_path: text
    target_arch: text
    max_artifact_bytes: i64

pub struct SignedCatalogRecordProduceResultV1:
    ok: bool
    reason: text
    receipt_line: text
pub(package) struct SignedCatalogEncodedRecordV1:
    bytes: [u8]
    receipt_line: text

pub(package) struct SignedCatalogEncodedBatch3V1:
    records: [[u8]]
pub(package) struct SignedCatalogEncodedBatchNV1:
    records: [[u8]]

fn _field(document: text, name: text) -> text:
    val prefix = name + "="
    var found = ""
    for raw_line in document.split("\n"):
        val line = raw_line.trim()
        if line.starts_with(prefix):
            if found != "": return ""
            found = line.substring(prefix.len(), line.len())
    found

fn _field_count(document: text, name: text) -> i64:
    val prefix = name + "="
    var count: i64 = 0
    for raw_line in document.split("\n"):
        if raw_line.trim().starts_with(prefix): count = count + 1
    count

fn _receipt_shape_valid(document: text) -> bool:
    val names = ["schema", "artifact_sha256", "artifact_size",
        "artifact_identity", "canonical_path", "target_os", "target_arch",
        "target_abi", "manifest_sam1_sha256"]
    for name in names:
        if _field_count(document, name) != 1: return false
    for raw_line in document.split("\n"):
        val line = raw_line.trim()
        if line != "":
            val parts = line.split("=")
            if parts.len() < 2 or not names.contains(parts[0]): return false
    true

fn _lower_sha256(value: text) -> bool:
    if value.len() != 64 or value == "0" * 64: return false
    for ch in value:
        if not ((ch >= '0' and ch <= '9') or (ch >= 'a' and ch <= 'f')): return false
    true

fn _positive_decimal(value: text) -> i64:
    if value == "": return -1
    var parsed: i64 = 0
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if code < 48 or code > 57: return -1
        val digit = code - 48
        if parsed > (0x7fffffffffffffff - digit) / 10: return -1
        parsed = parsed * 10 + digit
        index = index + 1
    if parsed <= 0: return -1
    parsed

fn _hex_nibble(value: text) -> i64:
    if value >= "0" and value <= "9": return value.char_code_at(0) - 48
    if value >= "a" and value <= "f": return value.char_code_at(0) - 87
    if value >= "A" and value <= "F": return value.char_code_at(0) - 55
    -1

fn _hex_decode(value: text) -> [u8]:
    if value.len() % 2 != 0: return []
    var out: [u8] = []
    var index: i64 = 0
    while index < value.len():
        val high = _hex_nibble(value.substring(index, index + 1))
        val low = _hex_nibble(value.substring(index + 1, index + 2))
        if high < 0 or low < 0: return []
        out.push((high * 16 + low).to_u8())
        index = index + 2
    out

fn _trust_key_id_valid_v1(value: text) -> bool:
    if value.len() == 0 or value.len() > 128: return false
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if code < 33 or code > 126 or code == 58: return false
        index = index + 1
    true

fn _trust_config_bytes_valid_v1(bytes: [u8]) -> bool:
    if bytes.len() == 0 or
        bytes.len() > SIGNED_CATALOG_TRUST_CONFIG_MAX_BYTES_V1:
        return false
    var index: i64 = 0
    while index < bytes.len():
        val byte = bytes[index]
        if byte != 10u8 and (byte < 32u8 or byte > 126u8): return false
        index = index + 1
    true

fn _trust_config_shape_valid_v1(document: text) -> bool:
    var count: i64 = 0
    for raw_line in document.split("\n"):
        val line = raw_line.trim()
        if line != "":
            if not line.starts_with("key_id=") and
                not line.starts_with("public_key_ed25519_hex="):
                return false
            count = count + 1
    count == 2 and _field_count(document, "key_id") == 1 and
        _field_count(document, "public_key_ed25519_hex") == 1

pub fn signed_catalog_trusted_signer_parse_v1(
    trust_bytes: [u8],
) -> Result<ExecutableManifestTrustedSignerV1, text>:
    """Parse one bounded SCR1 trust root without granting trust authority."""
    if not _trust_config_bytes_valid_v1(trust_bytes): return Err("trust-config-invalid")
    val trust = bytes_to_text(trust_bytes)
    if not _trust_config_shape_valid_v1(trust): return Err("trust-config-invalid")
    val key_id = _field(trust, "key_id")
    val public_key_hex = _field(trust, "public_key_ed25519_hex")
    if not _trust_key_id_valid_v1(key_id) or public_key_hex.len() != 64:
        return Err("trust-config-invalid")
    val public_key = _hex_decode(public_key_hex)
    if public_key.len() != 32: return Err("trust-config-invalid")
    Ok(ExecutableManifestTrustedSignerV1(
        key_id: key_id, public_key: public_key))

fn _hex_encode(value: [u8]) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    for byte in value:
        val number = byte.to_i64()
        out = out + digits.substring(number / 16, number / 16 + 1)
        out = out + digits.substring(number % 16, number % 16 + 1)
    out

fn _same_bytes(left: [u8], right: [u8]) -> bool:
    if left.len() != right.len(): return false
    var index: i64 = 0
    while index < left.len():
        if left[index] != right[index]: return false
        index = index + 1
    true
fn _same_i64(left: [i64], right: [i64]) -> bool:
    if left.len() != right.len(): return false
    var index: i64 = 0
    while index < left.len():
        if left[index] != right[index]: return false
        index = index + 1
    true

fn _wipe_seed(seed: [u8]):
    val _ = secure_zero_u8_slots(seed)

fn _aliases(bytes: [u8]) -> [text]:
    if bytes.len() == 0: return []
    var aliases: [text] = []
    for raw_line in bytes_to_text(bytes).split("\n"):
        val alias = raw_line.trim()
        if alias != "": aliases.push(alias)
    aliases

fn _produce(authority: HostedSafeArtifactRootAuthorityV1,
            manifest_relative: text, receipt_relative: text,
            seed_relative: text, trust_relative: text, aliases_relative: text,
            output_relative: text, expected_canonical_path: text,
            expected_target_arch: text) -> Result<text, text>:
    val receipt_bytes = hosted_safe_artifact_read_once_v1(
        authority, receipt_relative, _CONTROL_TEXT_MAX_V1)?
    val encoded = signed_catalog_encode_authenticated_receipt_v1(authority, manifest_relative, bytes_to_text(receipt_bytes), seed_relative, trust_relative, aliases_relative, output_relative, expected_canonical_path, expected_target_arch)?
    val grant = hosted_safe_artifact_publish_prepare_v1(authority, output_relative, encoded.bytes, SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1)?
    val published = hosted_safe_artifact_publish_redeem_v1(grant)?
    if not published.durable or published.byte_count != encoded.bytes.len(): return Err("scr1-publish-not-durable")
    Ok(encoded.receipt_line)

fn _signed_catalog_encode_authenticated_material_v1(
    sam1: [u8], receipt: text, seed: [u8], trust_bytes: [u8],
    alias_bytes: [u8], output_relative: text,
    expected_canonical_path: text = "",
    expected_target_arch: text = "",
) -> Result<SignedCatalogEncodedRecordV1, text>:
    if sam1.len() == 0 or receipt == "" or seed.len() != 32 or trust_bytes.len() == 0:
        return Err("empty-or-invalid-control-input")
    if not _receipt_shape_valid(receipt) or
        _field(receipt, "schema") != "simpleos-artifact-identity-v1":
        return Err("artifact-identity-receipt-schema")
    val artifact_hash = _field(receipt, "artifact_sha256")
    val artifact_size = _positive_decimal(_field(receipt, "artifact_size"))
    val artifact_identity = _field(receipt, "artifact_identity")
    val canonical_path = _field(receipt, "canonical_path")
    if expected_canonical_path != "" and canonical_path != expected_canonical_path:
        return Err("canonical-path-mismatch")
    val target_os = _field(receipt, "target_os")
    val target_arch = _field(receipt, "target_arch")
    if expected_target_arch != "" and target_arch != expected_target_arch:
        return Err("target-arch-mismatch")
    val target_abi = _field(receipt, "target_abi")
    val sam1_hash = _field(receipt, "manifest_sam1_sha256")
    if not _lower_sha256(artifact_hash) or artifact_size <= 0 or
        artifact_identity == "" or artifact_identity.len() > 512 or canonical_path == "" or
        sam1_hash != sha256_u8_hex(sam1) or target_os != "simpleos" or target_abi != "simpleos":
        return Err("artifact-identity-receipt-invalid")
    if target_arch != "x86_64" and target_arch != "x86" and
        target_arch != "aarch64" and target_arch != "arm" and
        target_arch != "riscv64" and target_arch != "riscv32":
        return Err("artifact-target-unsupported")

    val trusted_signer = signed_catalog_trusted_signer_parse_v1(trust_bytes)?
    val key_id = trusted_signer.key_id
    val public_key = pure_ed25519_keypair_from_seed(seed).1
    if not _same_bytes(public_key, trusted_signer.public_key):
        return Err("signer-not-provisioned-by-trust-config")

    val placeholder = "ed25519:" + key_id + ":" + ("0" * 128)
    val projection = decode_simple_artifact_manifest_v1_signing_bytes(sam1, placeholder)
    if not projection.?: return Err("manifest-sam1-invalid-or-noncanonical")
    val decoded = projection.unwrap()
    var manifest = decoded.manifest
    if decoded.image_hash != artifact_hash or manifest.content_hashes.len() == 0 or
        not manifest.content_hashes.contains(artifact_hash) or
        manifest.target.os != target_os or manifest.target.arch != target_arch or
        manifest.target.abi != target_abi or manifest.entrypoint != canonical_path:
        return Err("manifest-artifact-receipt-mismatch")
    val signing = encode_simple_artifact_manifest_v1_signing_bytes(manifest, artifact_hash)
    if not signing.ok or not _same_bytes(signing.bytes, sam1):
        return Err("manifest-canonical-roundtrip-failed")
    val signature = pure_ed25519_sign(seed, public_key, signing.bytes)
    if signature.len() != 64 or not pure_ed25519_verify(public_key, signing.bytes, signature):
        return Err("signature-self-verification-failed")
    val envelope = "ed25519:" + key_id + ":" + _hex_encode(signature)
    manifest.signature = envelope
    val candidate = SimpleboxSignedCatalogExternalCandidateV1(
        sam1_identity_sha256: sam1_hash,
        record: InstalledArtifactBootRecordV1(
            canonical_path: canonical_path, aliases: _aliases(alias_bytes),
            content_sha256: artifact_hash, detached_signature: envelope,
            expected_trust_root_sha256: sha256_u8_hex(public_key), manifest: manifest))
    val policy = InstalledArtifactBootPolicyV1(
        platform_target: manifest.target, required_canonical_paths: [canonical_path],
        trust_roots: [ExecutableManifestTrustedSignerV1(key_id: key_id, public_key: public_key)])
    if not installed_artifact_boot_policy_shape_valid_v1(policy, [candidate.record]):
        return Err("boot-policy-shape-rejected")
    val encoded = simplebox_signed_catalog_record_encode_v1(candidate)
    if not encoded.?: return Err("canonical-scr1-encode-rejected")
    val record_bytes = encoded.unwrap()
    Ok(SignedCatalogEncodedRecordV1(bytes: record_bytes,
        receipt_line: "simpleos_catalog_scr1=" + output_relative + " artifact_sha256=" + artifact_hash + " artifact_size=" + artifact_size.to_text() + " artifact_identity=" + artifact_identity))

pub(package) fn signed_catalog_encode_authenticated_receipt_v1(authority: HostedSafeArtifactRootAuthorityV1,
    manifest_relative: text, receipt: text, seed_relative: text,
    trust_relative: text, aliases_relative: text, output_relative: text,
    expected_canonical_path: text = "",
    expected_target_arch: text = "",
) -> Result<SignedCatalogEncodedRecordV1, text>:
    val sam1 = hosted_safe_artifact_read_once_v1(authority, manifest_relative, SIMPLE_ARTIFACT_MANIFEST_V1_MAX_SIGNING_BYTES)?
    val seed = hosted_safe_artifact_read_once_v1(authority, seed_relative, 32)?
    defer _wipe_seed(seed)
    val trust_bytes = hosted_safe_artifact_read_once_v1(
        authority, trust_relative, SIGNED_CATALOG_TRUST_CONFIG_MAX_BYTES_V1)?
    var alias_bytes: [u8] = []
    if aliases_relative != "":
        alias_bytes = hosted_safe_artifact_read_once_v1(
            authority, aliases_relative, _CONTROL_TEXT_MAX_V1)?
    _signed_catalog_encode_authenticated_material_v1(
        sam1, receipt, seed, trust_bytes, alias_bytes, output_relative,
        expected_canonical_path, expected_target_arch)

pub(package) fn signed_catalog_encode_authenticated_batch3_v1(
    manifests: [[u8]], receipts: [text], seed: [u8], trust: [u8],
    aliases: [[u8]], outputs: [text], canonical_paths: [text],
    expected_target_arch: text,
) -> Result<SignedCatalogEncodedBatch3V1, text>:
    """Encode exactly three records from one pre-snapshotted control set."""
    # The caller owns this already-snapshotted seed and is responsible for
    # wiping it after this batch returns.  Do not silently consume or mutate a
    # borrowed signing input here; callers may need one cleanup path covering
    # both encoding and transaction rollback.
    if manifests.len() != 3 or receipts.len() != 3 or aliases.len() != 3 or
        outputs.len() != 3 or canonical_paths.len() != 3 or seed.len() != 32:
        return Err("authenticated-batch3-shape")
    val encoded = signed_catalog_encode_authenticated_batch_n_v1(
        manifests, receipts, seed, trust, aliases, outputs, canonical_paths,
        expected_target_arch)?
    Ok(SignedCatalogEncodedBatch3V1(records: encoded.records))

pub(package) fn signed_catalog_encode_authenticated_batch_n_v1(
    manifests: [[u8]], receipts: [text], seed: [u8], trust: [u8],
    aliases: [[u8]], outputs: [text], canonical_paths: [text],
    expected_target_arch: text,
) -> Result<SignedCatalogEncodedBatchNV1, text>:
    """Encode one through sixteen records from pre-snapshotted controls."""
    # Keep this batch bounded so all caller-provided vectors are validated
    # before signing work begins and one malformed shape cannot partially run.
    val count = manifests.len()
    if count <= 0 or count > 16 or receipts.len() != count or
        aliases.len() != count or outputs.len() != count or
        canonical_paths.len() != count or seed.len() != 32:
        return Err("authenticated-batch-n-shape")
    var records: [[u8]] = []
    var index: i64 = 0
    while index < count:
        val encoded = _signed_catalog_encode_authenticated_material_v1(
            manifests[index], receipts[index], seed, trust, aliases[index],
            outputs[index], canonical_paths[index], expected_target_arch)?
        records.push(encoded.bytes)
        index = index + 1
    Ok(SignedCatalogEncodedBatchNV1(records: records))

pub fn signed_catalog_record_produce_v1(
    request: SignedCatalogRecordProduceRequestV1,
) -> SignedCatalogRecordProduceResultV1:
    if request.trusted_absolute_root == "" or
        request.manifest_relative_path == "" or
        request.artifact_receipt_relative_path == "" or
        request.signer_seed_relative_path == "" or
        request.trust_config_relative_path == "" or
        request.output_scr1_relative_path == "":
        return SignedCatalogRecordProduceResultV1(
            ok: false, reason: "missing-required-argument", receipt_line: "")
    match hosted_safe_artifact_root_acquire_v1(request.trusted_absolute_root):
        case Err(reason):
            SignedCatalogRecordProduceResultV1(
                ok: false, reason: reason, receipt_line: "")
        case Ok(authority):
            val produced = _produce(
                authority, request.manifest_relative_path,
                request.artifact_receipt_relative_path,
                request.signer_seed_relative_path,
                request.trust_config_relative_path,
                request.aliases_relative_path,
                request.output_scr1_relative_path,
                request.expected_canonical_path,
                request.expected_target_arch)
            val closed = hosted_safe_artifact_root_close_v1(authority)
            match closed:
                case Err(reason):
                    SignedCatalogRecordProduceResultV1(
                        ok: false, reason: reason, receipt_line: "")
                case Ok(_):
                    match produced:
                        case Err(reason):
                            SignedCatalogRecordProduceResultV1(
                                ok: false, reason: reason, receipt_line: "")
                        case Ok(line):
                            SignedCatalogRecordProduceResultV1(
                                ok: true, reason: "", receipt_line: line)

pub(package) fn signed_catalog_bundle_produce_v1(request: SignedCatalogBundleProduceRequestV1) -> SignedCatalogRecordProduceResultV1:
    val root = hosted_safe_artifact_root_acquire_v1(request.trusted_absolute_root)
    if val Err(reason) = root: return SignedCatalogRecordProduceResultV1(ok: false, reason: reason, receipt_line: "")
    val authority = root.unwrap()
    val begun = hosted_safe_artifact_bundle_begin_v1(authority, request.source_relative_path, request.bundle_relative_path, request.payload_leaf, request.scr1_leaf, request.max_artifact_bytes)
    if val Err(reason) = begun:
        _ = hosted_safe_artifact_root_close_v1(authority)
        return SignedCatalogRecordProduceResultV1(ok: false, reason: reason, receipt_line: "")
    val bundle = begun.unwrap()
    val before = hosted_safe_artifact_bundle_identity_v1(bundle)
    val stream = sha256_stream_v1_new()
    var count = 0i64
    var failure = ""
    while failure == "":
        val read = hosted_safe_artifact_bundle_read_stage_v1(bundle)
        if val Err(reason) = read: failure = reason
        else:
            val chunk = read.unwrap()
            if chunk.len() == 0: break
            if count > request.max_artifact_bytes - chunk.len() or not sha256_stream_v1_update(stream, chunk): failure = "bundle-hash-bound"
            else: count = count + chunk.len()
    val after = hosted_safe_artifact_bundle_identity_v1(bundle)
    if failure == "" and (before.is_err() or after.is_err() or not _same_i64(before.unwrap(), after.unwrap())): failure = "bundle-source-identity-changed"
    val digest = if failure == "": sha256_stream_v1_finish_hex(stream) else: nil
    var receipt_line = ""
    if failure == "" and digest != nil and count > 0:
        val identity = before.unwrap()
        val sam1 = hosted_safe_artifact_read_once_v1(authority, request.manifest_relative_path, SIMPLE_ARTIFACT_MANIFEST_V1_MAX_SIGNING_BYTES)
        if val Err(reason) = sam1: failure = reason
        else:
            val digest_text = digest ?? ""
            val scr1_path = request.bundle_relative_path + "/" + request.scr1_leaf
            val receipt = "schema=simpleos-artifact-identity-v1\nartifact_sha256={digest_text}\nartifact_size={count}\nartifact_identity=dev={identity[0]}:ino={identity[1]}:size={identity[2]}:mtime={identity[3]}.{identity[4]}\ncanonical_path={request.canonical_path}\ntarget_os=simpleos\ntarget_arch={request.target_arch}\ntarget_abi=simpleos\nmanifest_sam1_sha256={sha256_u8_hex(sam1.unwrap())}\n"
            val encoded = signed_catalog_encode_authenticated_receipt_v1(authority, request.manifest_relative_path, receipt, request.signer_seed_relative_path, request.trust_config_relative_path, request.aliases_relative_path, scr1_path, request.canonical_path, request.target_arch)
            if val Err(reason) = encoded: failure = reason
            else:
                val staged = hosted_safe_artifact_bundle_stage_scr1_v1(bundle, encoded.unwrap().bytes, SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1)
                if val Err(reason) = staged: failure = reason
                else: receipt_line = encoded.unwrap().receipt_line
    else if failure == "": failure = "bundle-digest-invalid"
    val finished = hosted_safe_artifact_bundle_finish_v1(bundle, failure == "")
    val closed = hosted_safe_artifact_root_close_v1(authority)
    if val Err(reason) = finished: failure = reason
    if val Err(reason) = closed: failure = reason
    if failure != "": return SignedCatalogRecordProduceResultV1(ok: false, reason: failure, receipt_line: "")
    val commit = finished.unwrap()
    if not commit.bundle_published or not commit.durable: return SignedCatalogRecordProduceResultV1(ok: false, reason: "bundle-not-durable", receipt_line: "")
    SignedCatalogRecordProduceResultV1(ok: true, reason: "", receipt_line: receipt_line)
