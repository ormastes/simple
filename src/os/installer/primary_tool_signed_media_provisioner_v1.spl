"""Authenticate and atomically publish externally signed primary-tool media.

The provisioner owns no signing key and never signs.  It streams exactly five
retained HostedSafeArtifact payloads through the bundle-N transaction, hashes
each bounded chunk, authenticates the supplied SCR1/PTRD metadata against
externally pinned trust, and returns paths plus metadata rather than payload
arrays for immediate ImageBuilder consumption.
"""

use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestTarget, SimpleArtifactManifest}
use std.common.crypto.ed25519.{pure_ed25519_verify}
use std.common.crypto.sha256.{
    sha256_u8_hex, sha256_stream_v1_new, sha256_stream_v1_update,
    sha256_stream_v1_finish_hex}
use std.common.structural.execution.simple_artifact_manifest_v1_codec.{
    encode_simple_artifact_manifest_v1_signing_bytes}
use os.kernel.arch.arch_context.{Architecture}
use os.installer.hosted_safe_artifact_io_v1.{
    HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1,
    HostedSafeArtifactRootAuthorityV1,
    HostedSafeArtifactBundleNGrantV1,
    HostedSafeArtifactBundleNFinishReceiptV1,
    hosted_safe_artifact_root_acquire_v1,
    hosted_safe_artifact_root_close_v1,
    hosted_safe_artifact_bundle_n_begin_v1,
    hosted_safe_artifact_bundle_n_add_slot_v1,
    hosted_safe_artifact_bundle_n_seal_v1,
    hosted_safe_artifact_bundle_n_slot_size_v1,
    hosted_safe_artifact_bundle_n_read_stage_v1,
    hosted_safe_artifact_bundle_n_slot_complete_v1,
    hosted_safe_artifact_bundle_n_identity_v1,
    hosted_safe_artifact_bundle_n_stage_scr1_v1,
    hosted_safe_artifact_bundle_n_stage_descriptor_v1,
    hosted_safe_artifact_bundle_n_finish_v1}
use os.installer.image_package_payload_policy.{
    IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1,
    image_native_executable_payload_admitted_v1}
use os.installer.signed_catalog_record_producer_v1.{
    signed_catalog_trusted_signer_parse_v1}
use os.installer.simplebox_signed_catalog_provisioner_v1.{
    SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1,
    SimpleboxSignedCatalogProvisionErrorV1,
    SimpleboxSignedCatalogProvisionResultV1,
    simplebox_signed_catalog_record_decode_v1,
    simplebox_signed_catalog_record_encode_v1}
use os.kernel.loader.simplebox_primary_tool_catalog_bundle_v1.{
    simplebox_primary_tool_catalog_bundle_plan_valid_v1}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootRecordV1}
use os.kernel.loader.primary_linux_tool_catalog_bundle_v1.{
    PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1,
    primary_linux_tool_catalog_required_paths_v1,
    primary_linux_tool_catalog_plan_v1,
    primary_linux_tool_catalog_plan_valid_v1}
use os.kernel.loader.primary_tool_release_descriptor_v1.{
    PRIMARY_TOOL_RELEASE_PAYLOAD_MAX_BYTES_V1,
    PRIMARY_TOOL_RELEASE_SCR1_MAX_BYTES_V1,
    PRIMARY_TOOL_RELEASE_MEDIA_MAX_BYTES_V1,
    primary_tool_release_descriptor_verify_v1,
    primary_tool_release_descriptor_verify_media_observations_v1}
use os.kernel.loader.primary_tool_release_descriptor_codec_v1.{
    PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1,
    decode_primary_tool_release_descriptor_v1,
    encode_primary_tool_release_descriptor_v1}

pub struct PrimaryToolSignedMediaRowV1:
    canonical_path: text
    source_relative_path: text
    payload_leaf: text
    scr1_leaf: text
    manifest_projection: SimpleArtifactManifest
    scr1_bytes: [u8]

pub struct PrimaryToolSignedMediaRequestV1:
    trusted_absolute_root: text
    bundle_relative_path: text
    descriptor_leaf: text
    target: ManifestTarget
    expected_release_id: text
    expected_signer_key_id: text
    trust_roots: [ExecutableManifestTrustedSignerV1]
    trust_config_bytes: [u8]
    rows: [PrimaryToolSignedMediaRowV1]
    descriptor_bytes: [u8]
    simplebox_input: SimpleboxSignedCatalogProvisionResultV1

pub struct PrimaryToolSignedMediaV1:
    target: ManifestTarget
    release_id: text
    signer_key_id: text
    trust_config_bytes: [u8]
    artifact_paths: [text]
    artifact_sha256: [text]
    artifact_lengths: [i64]
    native_admitted: [bool]
    scr1_bytes: [[u8]]
    scr1_sha256: [text]
    descriptor_bytes: [u8]
    records: [InstalledArtifactBootRecordV1]

pub enum PrimaryToolSignedMediaErrorV1:
    InvalidRequest
    UnsupportedTarget
    TrustRejected
    SimpleboxInputRejected
    SignedRecordRejected
    DescriptorRejected
    SafeRootRejected
    BundleBeginRejected
    BundleOperationRejected
    PayloadRejected
    PublicationRejected
    CleanupIndeterminate

fn _target_valid_v1(target: ManifestTarget) -> bool:
    target.os == "simpleos" and target.abi == "simpleos" and
        (target.arch == "x86_64" or target.arch == "aarch64" or
         target.arch == "riscv64")

fn _target_equal_v1(left: ManifestTarget, right: ManifestTarget) -> bool:
    left.os == right.os and left.arch == right.arch and left.abi == right.abi

fn _native_arch_v1(target: ManifestTarget) -> Architecture:
    if target.arch == "aarch64": return Architecture.Arm64
    if target.arch == "riscv64": return Architecture.Riscv64
    Architecture.X86_64

fn _copy_bytes_v1(value: [u8]) -> [u8]:
    var out: [u8] = []
    for byte in value: out.push(byte)
    out

fn _hex_nibble_v1(value: text) -> i64:
    if value >= "0" and value <= "9": return value.char_code_at(0) - 48
    if value >= "a" and value <= "f": return value.char_code_at(0) - 87
    if value >= "A" and value <= "F": return value.char_code_at(0) - 55
    -1

fn _signature_bytes_v1(value: text) -> [u8]:
    if value.len() != 128: return []
    var out: [u8] = []
    var index: i64 = 0
    while index < value.len():
        val high = _hex_nibble_v1(value.substring(index, index + 1))
        val low = _hex_nibble_v1(value.substring(index + 1, index + 2))
        if high < 0 or low < 0: return []
        out.push((high * 16 + low).to_u8())
        index = index + 2
    out

fn _roots_valid_v1(roots: [ExecutableManifestTrustedSignerV1]) -> bool:
    if roots.len() == 0 or roots.len() > 16: return false
    var index: i64 = 0
    while index < roots.len():
        val root = roots[index]
        if root.key_id.len() == 0 or root.key_id.len() > 128 or
            root.key_id.contains(":") or root.public_key.len() != 32:
            return false
        var prior: i64 = 0
        while prior < index:
            if roots[prior].key_id == root.key_id: return false
            prior = prior + 1
        index = index + 1
    true

fn _find_root_v1(
    roots: [ExecutableManifestTrustedSignerV1], key_id: text
) -> ExecutableManifestTrustedSignerV1?:
    for root in roots:
        if root.key_id == key_id: return Some(root)
    nil

fn _record_authenticated_v1(
    record: InstalledArtifactBootRecordV1,
    expected_path: text,
    target: ManifestTarget,
    roots: [ExecutableManifestTrustedSignerV1],
) -> bool:
    if record.canonical_path != expected_path or
        record.manifest.entrypoint != expected_path or
        not _target_equal_v1(record.manifest.target, target) or
        record.manifest.signature != record.detached_signature:
        return false
    val envelope = record.detached_signature.split(":")
    if envelope.len() != 3 or envelope[0] != "ed25519": return false
    val root = _find_root_v1(roots, envelope[1])
    if not root.?: return false
    val pinned = root.unwrap()
    if sha256_u8_hex(pinned.public_key) != record.expected_trust_root_sha256:
        return false
    val signature = _signature_bytes_v1(envelope[2])
    val signing = encode_simple_artifact_manifest_v1_signing_bytes(
        record.manifest, record.content_sha256)
    signature.len() == 64 and signing.ok and
        pure_ed25519_verify(pinned.public_key, signing.bytes, signature)

pub fn primary_tool_signed_media_record_authenticated_v1(
    record: InstalledArtifactBootRecordV1,
    expected_path: text,
    target: ManifestTarget,
    roots: [ExecutableManifestTrustedSignerV1],
) -> bool:
    """Pure cryptographic admission seam; grants no loader authority."""
    _record_authenticated_v1(record, expected_path, target, roots)

fn _finish_receipt_safe_v1(
    receipt: HostedSafeArtifactBundleNFinishReceiptV1
) -> bool:
    receipt.rolled_back and receipt.durable and not receipt.quarantined and
        not receipt.committed

pub fn primary_tool_signed_media_rollback_receipt_error_v1(
    receipt: HostedSafeArtifactBundleNFinishReceiptV1,
    preferred: PrimaryToolSignedMediaErrorV1,
) -> PrimaryToolSignedMediaErrorV1:
    if _finish_receipt_safe_v1(receipt): preferred
    else: PrimaryToolSignedMediaErrorV1.CleanupIndeterminate

pub fn primary_tool_signed_media_publication_receipt_valid_v1(
    receipt: HostedSafeArtifactBundleNFinishReceiptV1,
) -> bool:
    receipt.committed and receipt.durable and not receipt.rolled_back and
        not receipt.quarantined and
        receipt.artifact_count == PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1

fn _root_close_error_v1(
    authority: HostedSafeArtifactRootAuthorityV1,
    preferred: PrimaryToolSignedMediaErrorV1
) -> PrimaryToolSignedMediaErrorV1:
    if hosted_safe_artifact_root_close_v1(authority).is_err():
        return PrimaryToolSignedMediaErrorV1.CleanupIndeterminate
    preferred

fn _rollback_live_v1(
    authority: HostedSafeArtifactRootAuthorityV1,
    grant: HostedSafeArtifactBundleNGrantV1,
    preferred: PrimaryToolSignedMediaErrorV1
) -> PrimaryToolSignedMediaErrorV1:
    val finished = hosted_safe_artifact_bundle_n_finish_v1(grant, false)
    if val Err(_) = finished:
        _ = hosted_safe_artifact_root_close_v1(authority)
        return PrimaryToolSignedMediaErrorV1.CleanupIndeterminate
    val receipt = finished.unwrap()
    val close_error = _root_close_error_v1(authority, preferred)
    if close_error == PrimaryToolSignedMediaErrorV1.CleanupIndeterminate:
        return close_error
    primary_tool_signed_media_rollback_receipt_error_v1(receipt, preferred)

fn _after_consumed_failure_v1(
    authority: HostedSafeArtifactRootAuthorityV1,
    receipt: HostedSafeArtifactBundleNFinishReceiptV1,
    preferred: PrimaryToolSignedMediaErrorV1
) -> PrimaryToolSignedMediaErrorV1:
    val close_error = _root_close_error_v1(authority, preferred)
    if close_error == PrimaryToolSignedMediaErrorV1.CleanupIndeterminate:
        return close_error
    primary_tool_signed_media_rollback_receipt_error_v1(receipt, preferred)

fn _published_path_v1(root: text, bundle: text, leaf: text) -> text:
    val prefix = if root.ends_with("/"): root + bundle else: root + "/" + bundle
    prefix + "/" + leaf

pub fn primary_tool_signed_media_request_shape_v1(
    request: PrimaryToolSignedMediaRequestV1
) -> Result<(), PrimaryToolSignedMediaErrorV1>:
    """Pure, allocation-light structural gate shared by producers and tests."""
    if not _target_valid_v1(request.target):
        return Err(PrimaryToolSignedMediaErrorV1.UnsupportedTarget)
    if (request.rows.len() != PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1 or
        not request.trusted_absolute_root.starts_with("/") or
        request.bundle_relative_path == "" or
        request.descriptor_leaf == "" or request.expected_release_id == "" or
        request.expected_signer_key_id == "" or request.trust_config_bytes.len() == 0 or
        request.descriptor_bytes.len() == 0 or
        request.descriptor_bytes.len() >
            PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1):
        return Err(PrimaryToolSignedMediaErrorV1.InvalidRequest)
    if not _roots_valid_v1(request.trust_roots):
        return Err(PrimaryToolSignedMediaErrorV1.TrustRejected)
    val configured = signed_catalog_trusted_signer_parse_v1(
        request.trust_config_bytes)
    if (configured.is_err() or request.trust_roots.len() != 1 or
        configured.unwrap().key_id != request.trust_roots[0].key_id or
        configured.unwrap().public_key != request.trust_roots[0].public_key or
        configured.unwrap().key_id != request.expected_signer_key_id):
        return Err(PrimaryToolSignedMediaErrorV1.TrustRejected)
    val required = primary_linux_tool_catalog_required_paths_v1()
    if required.len() != PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1:
        return Err(PrimaryToolSignedMediaErrorV1.InvalidRequest)
    var index: i64 = 0
    while index < request.rows.len():
        val row = request.rows[index]
        if (row.canonical_path != required[index] or
            not _target_equal_v1(row.manifest_projection.target, request.target) or
            row.source_relative_path == "" or row.payload_leaf == "" or
            row.scr1_leaf == "" or row.payload_leaf == row.scr1_leaf or
            row.source_relative_path == request.bundle_relative_path or
            row.source_relative_path.starts_with(
                request.bundle_relative_path + "/") or
            request.bundle_relative_path.starts_with(
                row.source_relative_path + "/") or
            row.scr1_bytes.len() == 0 or
            row.scr1_bytes.len() > SIMPLEBOX_SIGNED_RECORD_MAX_BYTES_V1):
            return Err(PrimaryToolSignedMediaErrorV1.InvalidRequest)
        var prior: i64 = 0
        while prior < index:
            val old = request.rows[prior]
            if (old.source_relative_path == row.source_relative_path or
                old.payload_leaf == row.payload_leaf or old.scr1_leaf == row.scr1_leaf or
                old.payload_leaf == row.scr1_leaf or old.scr1_leaf == row.payload_leaf):
                return Err(PrimaryToolSignedMediaErrorV1.InvalidRequest)
            prior = prior + 1
        index = index + 1
    Ok(())

pub fn primary_tool_signed_media_simplebox_matches_v1(
    simplebox: SimpleboxSignedCatalogProvisionResultV1,
    row: PrimaryToolSignedMediaRowV1,
    record: InstalledArtifactBootRecordV1,
    scr1_sha256: text,
) -> bool:
    val sam1 = encode_simple_artifact_manifest_v1_signing_bytes(
        record.manifest, record.content_sha256)
    simplebox.ok and
        simplebox.error == SimpleboxSignedCatalogProvisionErrorV1.None and
        simplebox_primary_tool_catalog_bundle_plan_valid_v1(simplebox.plan) and
        simplebox.plan.records.len() == 1 and sam1.ok and
        _target_equal_v1(simplebox.plan.policy.platform_target, record.manifest.target) and
        simplebox.receipt.artifact_relative_path == row.source_relative_path and
        simplebox.receipt.artifact_sha256 == record.content_sha256 and
        simplebox.receipt.artifact_byte_count > 0 and
        simplebox.receipt.signed_record_relative_path != "" and
        simplebox.receipt.signed_record_sha256 == scr1_sha256 and
        simplebox.receipt.sam1_identity_sha256 == sha256_u8_hex(sam1.bytes) and
        simplebox.plan.records[0].content_sha256 == record.content_sha256 and
        simplebox.plan.records[0].canonical_path == record.canonical_path and
        simplebox.plan.records[0].aliases == record.aliases and
        simplebox.plan.records[0].detached_signature == record.detached_signature and
        simplebox.plan.records[0].expected_trust_root_sha256 ==
            record.expected_trust_root_sha256 and
        simplebox.plan.records[0].manifest == record.manifest

pub fn primary_tool_signed_media_provision_v1(
    request: PrimaryToolSignedMediaRequestV1
) -> Result<PrimaryToolSignedMediaV1, PrimaryToolSignedMediaErrorV1>:
    """Validate and durably publish one exact five-row signed release."""
    val shaped = primary_tool_signed_media_request_shape_v1(request)
    if val Err(error) = shaped: return Err(error)
    val required = primary_linux_tool_catalog_required_paths_v1()

    var records: [InstalledArtifactBootRecordV1] = []
    var scr1_sha256: [text] = []
    var pinned_scr1: [[u8]] = []
    var index: i64 = 0
    while index < request.rows.len():
        val row = request.rows[index]
        val decoded = simplebox_signed_catalog_record_decode_v1(
            row.scr1_bytes, row.manifest_projection)
        if not decoded.?:
            return Err(PrimaryToolSignedMediaErrorV1.SignedRecordRejected)
        val candidate = decoded.unwrap()
        val canonical = simplebox_signed_catalog_record_encode_v1(candidate)
        if (not canonical.? or canonical.unwrap() != row.scr1_bytes or
            not _record_authenticated_v1(
                candidate.record, required[index], request.target,
                request.trust_roots)):
            return Err(PrimaryToolSignedMediaErrorV1.SignedRecordRejected)
        records.push(candidate.record)
        scr1_sha256.push(sha256_u8_hex(row.scr1_bytes))
        pinned_scr1.push(_copy_bytes_v1(row.scr1_bytes))
        index = index + 1

    val catalog_plan = primary_linux_tool_catalog_plan_v1(
        request.target, request.trust_roots, records)
    if not primary_linux_tool_catalog_plan_valid_v1(catalog_plan):
        return Err(PrimaryToolSignedMediaErrorV1.SignedRecordRejected)
    val simplebox = request.simplebox_input
    if not primary_tool_signed_media_simplebox_matches_v1(
        simplebox, request.rows[0], records[0], scr1_sha256[0]):
        return Err(PrimaryToolSignedMediaErrorV1.SimpleboxInputRejected)

    val decoded_descriptor = decode_primary_tool_release_descriptor_v1(
        request.descriptor_bytes)
    if not decoded_descriptor.ok:
        return Err(PrimaryToolSignedMediaErrorV1.DescriptorRejected)
    val descriptor = decoded_descriptor.value
    val canonical_descriptor = encode_primary_tool_release_descriptor_v1(descriptor)
    if (not canonical_descriptor.ok or
        canonical_descriptor.bytes != request.descriptor_bytes or
        descriptor.release_id != request.expected_release_id or
        not primary_tool_release_descriptor_verify_v1(
            descriptor, request.trust_roots, request.target,
            request.expected_signer_key_id).ok):
        return Err(PrimaryToolSignedMediaErrorV1.DescriptorRejected)

    val root_result = hosted_safe_artifact_root_acquire_v1(
        request.trusted_absolute_root)
    if val Err(_) = root_result:
        return Err(PrimaryToolSignedMediaErrorV1.SafeRootRejected)
    val authority = root_result.unwrap()
    val begun = hosted_safe_artifact_bundle_n_begin_v1(
        authority, request.bundle_relative_path, request.descriptor_leaf,
        PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1,
        PRIMARY_TOOL_RELEASE_MEDIA_MAX_BYTES_V1)
    if val Err(_) = begun:
        return Err(_root_close_error_v1(
            authority, PrimaryToolSignedMediaErrorV1.BundleBeginRejected))
    val grant = begun.unwrap()

    index = 0
    while index < request.rows.len():
        val row = request.rows[index]
        val added = hosted_safe_artifact_bundle_n_add_slot_v1(
            grant, index, row.source_relative_path, row.payload_leaf, row.scr1_leaf)
        if val Err(receipt) = added:
            return Err(_after_consumed_failure_v1(
                authority, receipt,
                PrimaryToolSignedMediaErrorV1.BundleOperationRejected))
        index = index + 1
    val sealed = hosted_safe_artifact_bundle_n_seal_v1(grant)
    if val Err(receipt) = sealed:
        return Err(_after_consumed_failure_v1(
            authority, receipt,
            PrimaryToolSignedMediaErrorV1.BundleOperationRejected))

    var payload_sha256: [text] = []
    var payload_lengths: [i64] = []
    var native_admitted: [bool] = []
    index = 0
    while index < request.rows.len():
        val sized = hosted_safe_artifact_bundle_n_slot_size_v1(grant, index)
        if val Err(_) = sized:
            # A size error may have consumed the transaction internally.
            return Err(_root_close_error_v1(
                authority, PrimaryToolSignedMediaErrorV1.CleanupIndeterminate))
        val expected_size = sized.unwrap()
        if expected_size <= 0 or expected_size > PRIMARY_TOOL_RELEASE_PAYLOAD_MAX_BYTES_V1 or
            expected_size > IMAGE_MAX_NATIVE_PAYLOAD_BYTES_V1:
            return Err(_rollback_live_v1(
                authority, grant, PrimaryToolSignedMediaErrorV1.PayloadRejected))
        val stream = sha256_stream_v1_new()
        # Admission currently owns one complete executable image.  Materialize
        # only the active row, release it before advancing, and never retain it
        # in PrimaryToolSignedMediaV1.  Provider transfers remain <=16 MiB.
        var executable: [u8] = []
        var consumed = 0i64
        var complete = false
        while not complete:
            val remaining = expected_size - consumed
            if remaining <= 0:
                return Err(_rollback_live_v1(
                    authority, grant, PrimaryToolSignedMediaErrorV1.PayloadRejected))
            val chunk_bound = if remaining < HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1:
                remaining else: HOSTED_SAFE_ARTIFACT_MAX_BYTES_V1
            val read = hosted_safe_artifact_bundle_n_read_stage_v1(
                grant, index, chunk_bound)
            if val Err(receipt) = read:
                return Err(_after_consumed_failure_v1(
                    authority, receipt,
                    PrimaryToolSignedMediaErrorV1.BundleOperationRejected))
            val chunk = read.unwrap()
            if chunk.len() == 0 or chunk.len() > expected_size - consumed or
                not sha256_stream_v1_update(stream, chunk):
                return Err(_rollback_live_v1(
                    authority, grant, PrimaryToolSignedMediaErrorV1.PayloadRejected))
            consumed = consumed + chunk.len()
            for byte in chunk: executable.push(byte)
            val done = hosted_safe_artifact_bundle_n_slot_complete_v1(grant, index)
            if val Err(_) = done:
                return Err(_rollback_live_v1(
                    authority, grant, PrimaryToolSignedMediaErrorV1.BundleOperationRejected))
            complete = done.unwrap()
        if consumed != expected_size:
            return Err(_rollback_live_v1(
                authority, grant, PrimaryToolSignedMediaErrorV1.PayloadRejected))
        if index == 0 and consumed != simplebox.receipt.artifact_byte_count:
            return Err(_rollback_live_v1(
                authority, grant, PrimaryToolSignedMediaErrorV1.SimpleboxInputRejected))
        val identity = hosted_safe_artifact_bundle_n_identity_v1(grant, index)
        if val Err(receipt) = identity:
            return Err(_after_consumed_failure_v1(
                authority, receipt,
                PrimaryToolSignedMediaErrorV1.BundleOperationRejected))
        if identity.unwrap().len() != 6 or identity.unwrap()[2] != consumed:
            return Err(_rollback_live_v1(
                authority, grant, PrimaryToolSignedMediaErrorV1.PayloadRejected))
        val digest = sha256_stream_v1_finish_hex(stream)
        if not digest.? or digest.unwrap() != records[index].content_sha256:
            return Err(_rollback_live_v1(
                authority, grant, PrimaryToolSignedMediaErrorV1.PayloadRejected))
        if not image_native_executable_payload_admitted_v1(
            executable, _native_arch_v1(request.target)):
            return Err(_rollback_live_v1(
                authority, grant, PrimaryToolSignedMediaErrorV1.PayloadRejected))
        payload_sha256.push(digest.unwrap())
        payload_lengths.push(consumed)
        native_admitted.push(true)
        val staged = hosted_safe_artifact_bundle_n_stage_scr1_v1(
            grant, index, pinned_scr1[index], PRIMARY_TOOL_RELEASE_SCR1_MAX_BYTES_V1)
        if val Err(receipt) = staged:
            return Err(_after_consumed_failure_v1(
                authority, receipt,
                PrimaryToolSignedMediaErrorV1.BundleOperationRejected))
        index = index + 1

    var scr1_lengths: [i64] = []
    for bytes in pinned_scr1: scr1_lengths.push(bytes.len())
    if not primary_tool_release_descriptor_verify_media_observations_v1(
        descriptor, request.trust_roots, request.target,
        request.expected_signer_key_id, payload_sha256, payload_lengths,
        scr1_sha256, scr1_lengths).ok:
        return Err(_rollback_live_v1(
            authority, grant, PrimaryToolSignedMediaErrorV1.DescriptorRejected))
    val staged_descriptor = hosted_safe_artifact_bundle_n_stage_descriptor_v1(
        grant, request.descriptor_bytes,
        PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1)
    if val Err(receipt) = staged_descriptor:
        return Err(_after_consumed_failure_v1(
            authority, receipt,
            PrimaryToolSignedMediaErrorV1.BundleOperationRejected))
    val finished = hosted_safe_artifact_bundle_n_finish_v1(grant, true)
    if val Err(_) = finished:
        _ = hosted_safe_artifact_root_close_v1(authority)
        return Err(PrimaryToolSignedMediaErrorV1.CleanupIndeterminate)
    val publication = finished.unwrap()
    val close_error = _root_close_error_v1(
        authority, PrimaryToolSignedMediaErrorV1.PublicationRejected)
    if close_error == PrimaryToolSignedMediaErrorV1.CleanupIndeterminate:
        return Err(close_error)
    if not primary_tool_signed_media_publication_receipt_valid_v1(publication):
        return Err(if publication.quarantined:
            PrimaryToolSignedMediaErrorV1.CleanupIndeterminate else:
            PrimaryToolSignedMediaErrorV1.PublicationRejected)

    var artifact_paths: [text] = []
    for row in request.rows:
        artifact_paths.push(_published_path_v1(
            request.trusted_absolute_root, request.bundle_relative_path,
            row.payload_leaf))
    Ok(PrimaryToolSignedMediaV1(
        target: request.target, release_id: request.expected_release_id,
        signer_key_id: request.expected_signer_key_id,
        trust_config_bytes: _copy_bytes_v1(request.trust_config_bytes),
        artifact_paths: artifact_paths, artifact_sha256: payload_sha256,
        artifact_lengths: payload_lengths, native_admitted: native_admitted,
        scr1_bytes: pinned_scr1,
        scr1_sha256: scr1_sha256,
        descriptor_bytes: _copy_bytes_v1(request.descriptor_bytes),
        records: records))
