# Process-callable admission for the stable SimpleProviderQueryV1 entry point.
#
# This module deliberately does not parse either historical SMF header layout.
# The platform loader owns mapping/format validation; this boundary admits a
# provider only after artifact identity, policy, version, symbol, and executable
# address evidence all agree.  A dynSMF registry offset is never sufficient.

use os.posix.dynlib.{
    DynLibKind, dynlib_open, dynlib_symbol, dynlib_symbol_is_process_callable,
    dynlib_close, dynlib_is_valid
}
use os.posix.dynlib_sffi.{
    ProviderQueryCallV1, call_provider_query_v1,
    CliCommandCallV1, call_cli_command_v1
}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.nogc_sync_mut.composition.provider_contract.{
    SIMPLE_PROVIDER_OK, SimpleProviderQueryV1, simple_provider_query_error_v1
}
use std.nogc_sync_mut.composition.cli_command_wire.{CliCommandResultViewV1}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_bytes(path: text) -> [u8]

val SIMPLE_PROVIDER_QUERY_V1_SYMBOL: text = "simple_provider_query_v1"
val SIMPLE_CLI_COMMAND_INVOKE_V1_SYMBOL: text = "simple_cli_command_invoke_v1"

val PROVIDER_ADMISSION_OK: i32 = 0
val PROVIDER_ADMISSION_PATH_DENIED: i32 = 1
val PROVIDER_ADMISSION_ARTIFACT_MISSING: i32 = 2
val PROVIDER_ADMISSION_DIGEST_MISMATCH: i32 = 3
val PROVIDER_ADMISSION_CAPABILITY_DENIED: i32 = 4
val PROVIDER_ADMISSION_HOST_ABI_UNSUPPORTED: i32 = 5
val PROVIDER_ADMISSION_INTERFACE_UNSUPPORTED: i32 = 6
val PROVIDER_ADMISSION_LOAD_FAILED: i32 = 7
val PROVIDER_ADMISSION_QUERY_SYMBOL_MISSING: i32 = 8
val PROVIDER_ADMISSION_NOT_PROCESS_CALLABLE: i32 = 9

val PROVIDER_SESSION_OK: i32 = 0
val PROVIDER_SESSION_NOT_OPEN: i32 = 1
val PROVIDER_SESSION_QUERY_FAILED: i32 = 2
val PROVIDER_SESSION_PIN_UNKNOWN: i32 = 3
val PROVIDER_SESSION_CLOSE_PINNED: i32 = 4
val PROVIDER_SESSION_CLOSE_FAILED: i32 = 5
val PROVIDER_SESSION_CLI_SYMBOL_MISSING: i32 = 6
val PROVIDER_SESSION_CLI_CALL_FAILED: i32 = 7

class ProviderAdmissionRequestV1:
    artifact_path: text
    artifact_kind: text
    expected_artifact_digest: text
    granted_capability_bits: u64
    required_capability_bits: u64
    host_abi: u64
    minimum_host_abi: u64
    maximum_host_abi: u64
    requested_interface_major: u32
    requested_interface_minor: u32
    provided_interface_major: u32
    provided_interface_minor: u32

class ProviderCallableEvidenceV1:
    artifact_exists: bool
    artifact_digest: text
    loader_valid: bool
    query_symbol_address: i64
    query_symbol_process_callable: bool

class ProviderAdmissionResultV1:
    status: i32
    query_symbol_address: i64
    artifact_digest: text
    process_callable: bool
    reason: text

class ProviderLoaderSessionV1:
    library: DynLibKind
    admission: ProviderAdmissionResultV1
    var open: bool
    var next_pin_id: u64
    var live_pins: [u64]
    cli_invoke_symbol_address: i64
    cli_invoke_process_callable: bool

class ProviderDynamicAdmissionV1:
    admission: ProviderAdmissionResultV1
    session: ProviderLoaderSessionV1

class ProviderSessionQueryV1:
    status: i32
    pin_id: u64
    call: ProviderQueryCallV1
    reason: text

class ProviderSessionCliInvokeV1:
    status: i32
    pin_id: u64
    call: CliCommandCallV1
    reason: text

fn _provider_admission_result(status: i32, address: i64, digest: text, callable: bool, reason: text) -> ProviderAdmissionResultV1:
    ProviderAdmissionResultV1(
        status: status,
        query_symbol_address: address,
        artifact_digest: digest,
        process_callable: callable,
        reason: reason
    )

fn provider_artifact_digest_v1(bytes: [u8]) -> text:
    sha256_u8_hex(bytes)

fn provider_artifact_path_allowed_v1(path: text, kind: text) -> bool:
    if path == "" or path.contains("..") or path.contains("//") or path.contains("\\"):
        return false
    val approved_root = path.starts_with("build/providers/") or
        path.starts_with("/sys/providers/") or
        path.starts_with("/usr/lib/simple/providers/")
    if not approved_root:
        return false
    if kind == "smf":
        return path.ends_with(".smf")
    if kind == "native":
        return path.ends_with(".so") or path.ends_with(".dylib") or path.ends_with(".dll")
    false

fn provider_admit_evidence_v1(request: ProviderAdmissionRequestV1, evidence: ProviderCallableEvidenceV1) -> ProviderAdmissionResultV1:
    if not provider_artifact_path_allowed_v1(request.artifact_path, request.artifact_kind):
        return _provider_admission_result(PROVIDER_ADMISSION_PATH_DENIED, 0, evidence.artifact_digest, false, "path-denied")
    if not evidence.artifact_exists:
        return _provider_admission_result(PROVIDER_ADMISSION_ARTIFACT_MISSING, 0, "", false, "artifact-missing")
    if request.expected_artifact_digest.len() != 64 or evidence.artifact_digest != request.expected_artifact_digest:
        return _provider_admission_result(PROVIDER_ADMISSION_DIGEST_MISMATCH, 0, evidence.artifact_digest, false, "artifact-digest-mismatch")
    if (request.granted_capability_bits & request.required_capability_bits) != request.required_capability_bits:
        return _provider_admission_result(PROVIDER_ADMISSION_CAPABILITY_DENIED, 0, evidence.artifact_digest, false, "capability-denied")
    if request.host_abi < request.minimum_host_abi or request.host_abi > request.maximum_host_abi:
        return _provider_admission_result(PROVIDER_ADMISSION_HOST_ABI_UNSUPPORTED, 0, evidence.artifact_digest, false, "host-abi-unsupported")
    if request.requested_interface_major != request.provided_interface_major or request.requested_interface_minor > request.provided_interface_minor:
        return _provider_admission_result(PROVIDER_ADMISSION_INTERFACE_UNSUPPORTED, 0, evidence.artifact_digest, false, "interface-version-unsupported")
    if not evidence.loader_valid:
        return _provider_admission_result(PROVIDER_ADMISSION_LOAD_FAILED, 0, evidence.artifact_digest, false, "loader-failed")
    if evidence.query_symbol_address <= 0:
        return _provider_admission_result(PROVIDER_ADMISSION_QUERY_SYMBOL_MISSING, 0, evidence.artifact_digest, false, "query-symbol-missing")
    if not evidence.query_symbol_process_callable:
        return _provider_admission_result(PROVIDER_ADMISSION_NOT_PROCESS_CALLABLE, 0, evidence.artifact_digest, false, "query-symbol-not-process-callable")
    _provider_admission_result(PROVIDER_ADMISSION_OK, evidence.query_symbol_address, evidence.artifact_digest, true, "admitted")

fn provider_admit_dynamic_v1(request: ProviderAdmissionRequestV1) -> ProviderDynamicAdmissionV1:
    val exists = rt_file_exists(request.artifact_path)
    val bytes = if exists: rt_file_read_bytes(request.artifact_path) ?? [] else: []
    val digest = provider_artifact_digest_v1(bytes)
    if not exists:
        val missing = provider_admit_evidence_v1(request, ProviderCallableEvidenceV1(artifact_exists: false, artifact_digest: "", loader_valid: false, query_symbol_address: 0, query_symbol_process_callable: false))
        return ProviderDynamicAdmissionV1(admission: missing, session: _closed_provider_session(missing))
    val library = dynlib_open(request.artifact_path, 2)
    val address = dynlib_symbol(library, SIMPLE_PROVIDER_QUERY_V1_SYMBOL)
    val cli_address = dynlib_symbol(library, SIMPLE_CLI_COMMAND_INVOKE_V1_SYMBOL)
    val admission = provider_admit_evidence_v1(request, ProviderCallableEvidenceV1(
        artifact_exists: true,
        artifact_digest: digest,
        loader_valid: _provider_library_valid(library),
        query_symbol_address: address,
        query_symbol_process_callable: dynlib_symbol_is_process_callable(library, SIMPLE_PROVIDER_QUERY_V1_SYMBOL)
    ))
    if admission.status != PROVIDER_ADMISSION_OK:
        if dynlib_is_valid(library):
            dynlib_close(library)
        return ProviderDynamicAdmissionV1(admission: admission, session: _closed_provider_session(admission))
    ProviderDynamicAdmissionV1(
        admission: admission,
        session: ProviderLoaderSessionV1(
            library: library,
            admission: admission,
            open: true,
            next_pin_id: 1,
            live_pins: [],
            cli_invoke_symbol_address: cli_address,
            cli_invoke_process_callable: dynlib_symbol_is_process_callable(library, SIMPLE_CLI_COMMAND_INVOKE_V1_SYMBOL)
        )
    )

fn _closed_provider_session(admission: ProviderAdmissionResultV1) -> ProviderLoaderSessionV1:
    ProviderLoaderSessionV1(
        library: DynLibKind.Invalid,
        admission: admission,
        open: false,
        next_pin_id: 1,
        live_pins: [],
        cli_invoke_symbol_address: 0,
        cli_invoke_process_callable: false
    )

fn _provider_session_query_error(status: i32, reason: text) -> ProviderSessionQueryV1:
    ProviderSessionQueryV1(
        status: status,
        pin_id: 0,
        call: ProviderQueryCallV1(
            ok: false,
            call_status: -1,
            result: simple_provider_query_error_v1(-1),
            diagnostic: reason
        ),
        reason: reason
    )

fn provider_session_query_v1(session: ProviderLoaderSessionV1, request: SimpleProviderQueryV1) -> ProviderSessionQueryV1:
    if not session.open or session.admission.status != PROVIDER_ADMISSION_OK:
        return _provider_session_query_error(PROVIDER_SESSION_NOT_OPEN, "provider-session-not-open")
    val call = call_provider_query_v1(session.admission.query_symbol_address, request)
    if not call.ok:
        return ProviderSessionQueryV1(status: PROVIDER_SESSION_QUERY_FAILED, pin_id: 0, call: call, reason: call.diagnostic)
    if call.result.status != SIMPLE_PROVIDER_OK:
        return ProviderSessionQueryV1(status: PROVIDER_SESSION_QUERY_FAILED, pin_id: 0, call: call, reason: "provider-query-rejected")
    val pin_id = session.next_pin_id
    session.next_pin_id = pin_id + 1
    session.live_pins.push(pin_id)
    ProviderSessionQueryV1(status: PROVIDER_SESSION_OK, pin_id: pin_id, call: call, reason: "pinned")

fn provider_session_release_v1(session: ProviderLoaderSessionV1, pin_id: u64) -> i32:
    if not session.open or pin_id == 0:
        return PROVIDER_SESSION_PIN_UNKNOWN
    var found = false
    var retained: [u64] = []
    var i = 0
    while i < session.live_pins.len():
        if session.live_pins[i] == pin_id and not found:
            found = true
        else:
            retained.push(session.live_pins[i])
        i = i + 1
    if not found:
        return PROVIDER_SESSION_PIN_UNKNOWN
    session.live_pins = retained
    PROVIDER_SESSION_OK

fn _provider_session_has_pin_v1(session: ProviderLoaderSessionV1, pin_id: u64) -> bool:
    var i = 0
    while i < session.live_pins.len():
        if session.live_pins[i] == pin_id:
            return true
        i = i + 1
    false

fn _provider_session_cli_error(status: i32, pin_id: u64, reason: text) -> ProviderSessionCliInvokeV1:
    ProviderSessionCliInvokeV1(
        status: status,
        pin_id: pin_id,
        call: CliCommandCallV1(
            ok: false,
            call_status: -1,
            result: CliCommandResultViewV1(false, -1, "", "", reason),
            diagnostic: reason
        ),
        reason: reason
    )

fn provider_session_invoke_cli_v1(session: ProviderLoaderSessionV1,
        query: ProviderSessionQueryV1, command: text, args: [text],
        operation: u32, output_capacity: u32) -> ProviderSessionCliInvokeV1:
    if not session.open or query.status != PROVIDER_SESSION_OK:
        return _provider_session_cli_error(PROVIDER_SESSION_NOT_OPEN, query.pin_id, "provider-session-not-open")
    if query.pin_id == 0 or not _provider_session_has_pin_v1(session, query.pin_id):
        return _provider_session_cli_error(PROVIDER_SESSION_PIN_UNKNOWN, query.pin_id, "provider-session-pin-unknown")
    if session.cli_invoke_symbol_address <= 0 or not session.cli_invoke_process_callable:
        return _provider_session_cli_error(PROVIDER_SESSION_CLI_SYMBOL_MISSING, query.pin_id, "provider-cli-symbol-not-process-callable")
    val call = call_cli_command_v1(session.cli_invoke_symbol_address,
        query.call.result.interface_handle, query.call.result.provider_context,
        command, args, operation, output_capacity)
    if not call.ok:
        return ProviderSessionCliInvokeV1(PROVIDER_SESSION_CLI_CALL_FAILED, query.pin_id, call, call.diagnostic)
    ProviderSessionCliInvokeV1(PROVIDER_SESSION_OK, query.pin_id, call, "invoked")

fn provider_session_close_v1(session: ProviderLoaderSessionV1) -> i32:
    if not session.open:
        return PROVIDER_SESSION_NOT_OPEN
    if session.live_pins.len() > 0:
        return PROVIDER_SESSION_CLOSE_PINNED
    val status = dynlib_close(session.library)
    if status != 0:
        return PROVIDER_SESSION_CLOSE_FAILED
    session.open = false
    PROVIDER_SESSION_OK

fn _provider_library_valid(library: DynLibKind) -> bool:
    match library:
        DynLibKind.Invalid: false
        DynLibKind.Elf(_): true
        DynLibKind.Smf(_): true
        DynLibKind.Pe(_): true

export SIMPLE_PROVIDER_QUERY_V1_SYMBOL, SIMPLE_CLI_COMMAND_INVOKE_V1_SYMBOL
export PROVIDER_ADMISSION_OK, PROVIDER_ADMISSION_PATH_DENIED, PROVIDER_ADMISSION_ARTIFACT_MISSING
export PROVIDER_ADMISSION_DIGEST_MISMATCH, PROVIDER_ADMISSION_CAPABILITY_DENIED
export PROVIDER_ADMISSION_HOST_ABI_UNSUPPORTED, PROVIDER_ADMISSION_INTERFACE_UNSUPPORTED
export PROVIDER_ADMISSION_LOAD_FAILED, PROVIDER_ADMISSION_QUERY_SYMBOL_MISSING, PROVIDER_ADMISSION_NOT_PROCESS_CALLABLE
export PROVIDER_SESSION_OK, PROVIDER_SESSION_NOT_OPEN, PROVIDER_SESSION_QUERY_FAILED
export PROVIDER_SESSION_PIN_UNKNOWN, PROVIDER_SESSION_CLOSE_PINNED, PROVIDER_SESSION_CLOSE_FAILED
export PROVIDER_SESSION_CLI_SYMBOL_MISSING, PROVIDER_SESSION_CLI_CALL_FAILED
export ProviderAdmissionRequestV1, ProviderCallableEvidenceV1, ProviderAdmissionResultV1
export ProviderLoaderSessionV1, ProviderDynamicAdmissionV1, ProviderSessionQueryV1, ProviderSessionCliInvokeV1
export provider_artifact_digest_v1, provider_artifact_path_allowed_v1, provider_admit_evidence_v1, provider_admit_dynamic_v1
export provider_session_query_v1, provider_session_release_v1, provider_session_close_v1
export provider_session_invoke_cli_v1
