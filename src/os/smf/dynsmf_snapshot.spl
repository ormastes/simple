extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_bytes(path: text) -> [u8]

# Raw capture owner only. Authority is established later by validation in the
# session module; this module never manufactures an approval receipt.
fn dynsmf_snapshot_capture(path: text) -> ([u8], bool):
    if path == "" or not rt_file_exists(path):
        return ([], false)
    val data = rt_file_read_bytes(path) ?? []
    (data, true)

fn dynsmf_snapshot_request_error(entry_path: text, request_path: text, captured_path: text) -> text:
    if captured_path != request_path or entry_path != request_path:
        return "artifact snapshot path mismatch"
    if not request_path.ends_with(".smf"):
        return "not an smf artifact"
    ""

export dynsmf_snapshot_capture, dynsmf_snapshot_request_error
