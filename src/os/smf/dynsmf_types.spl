class DynSmfArtifactStatus:
    library_id: text
    path: text
    ready: bool
    reason: text
    byte_count: int
    magic_hex: text

    me to_text() -> text:
        self.library_id + ":" + self.path + ":" + self.ready.to_text() + ":" + self.reason + ":bytes" + self.byte_count.to_text() + ":magic" + self.magic_hex

export DynSmfArtifactStatus
