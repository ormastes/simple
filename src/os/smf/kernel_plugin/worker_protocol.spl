use std.nogc_async_mut.kernel_plugin.runtime.{KpfRequestHandleV1}

pub const KPF_WORKER_PROTOCOL_V1: u32 = 1

pub enum KpfWorkerFrameKind:
    Handshake
    HandshakeAccepted
    Submit
    Completion
    Cancel
    Quiesce
    Quiesced
    Close
    Closed

pub enum KpfWorkerOutcome:
    Accepted
    Empty
    WouldBlock
    ProtocolMismatch
    MalformedFrame
    FrameTooLarge
    CapabilityDenied
    StaleCompletion
    TimedOut
    WorkerCrashed
    Quiescing
    Closed

pub struct KpfWorkerFrameV1:
    protocol_version: u32
    kind: KpfWorkerFrameKind
    generation: i64
    session_epoch: i64
    request_slot: i64
    request_epoch: i64
    capability_bits: u64
    payload_length: i64
    payload: [u8]

pub struct KpfWorkerResultV1:
    outcome: KpfWorkerOutcome
    request: KpfRequestHandleV1
    payload: [u8]

pub fn kpf_worker_empty_request_v1() -> KpfRequestHandleV1:
    KpfRequestHandleV1(generation: 0, session_slot: -1, request_slot: -1, request_epoch: 0)

pub fn kpf_worker_empty_frame_v1() -> KpfWorkerFrameV1:
    KpfWorkerFrameV1(protocol_version: KPF_WORKER_PROTOCOL_V1,
        kind: KpfWorkerFrameKind.Close, generation: 0, session_epoch: 0,
        request_slot: -1, request_epoch: 0, capability_bits: 0,
        payload_length: 0, payload: [])

pub fn kpf_worker_validate_frame_v1(frame: KpfWorkerFrameV1,
        maximum_frame_bytes: i64) -> KpfWorkerOutcome:
    if frame.protocol_version != KPF_WORKER_PROTOCOL_V1:
        return KpfWorkerOutcome.ProtocolMismatch
    if frame.payload_length < 0 or frame.payload_length != frame.payload.len:
        return KpfWorkerOutcome.MalformedFrame
    if frame.payload_length > maximum_frame_bytes:
        return KpfWorkerOutcome.FrameTooLarge
    KpfWorkerOutcome.Accepted
