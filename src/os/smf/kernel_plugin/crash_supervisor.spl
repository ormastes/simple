use os.smf.kernel_plugin.worker_process.KpfWorkerProcessFacadeV1
use os.smf.kernel_plugin.worker_protocol.KpfWorkerOutcome

pub class KpfWorkerCrashSupervisorV1:
    timeout_ns: i64
    deadline_ns: i64
    var crash_count: i64
    var timeout_count: i64

impl KpfWorkerCrashSupervisorV1:
    pub static fn create(timeout_ns: i64) -> KpfWorkerCrashSupervisorV1:
        KpfWorkerCrashSupervisorV1(timeout_ns: timeout_ns, deadline_ns: 0,
            crash_count: 0, timeout_count: 0)

    me arm(now_ns: i64):
        self.deadline_ns = now_ns + self.timeout_ns

    me disarm():
        self.deadline_ns = 0

    me observe(process: KpfWorkerProcessFacadeV1, now_ns: i64) -> KpfWorkerOutcome:
        if not process.alive:
            self.crash_count = self.crash_count + 1
            return KpfWorkerOutcome.WorkerCrashed
        if self.deadline_ns > 0 and now_ns >= self.deadline_ns:
            self.timeout_count = self.timeout_count + 1
            process.terminate()
            return KpfWorkerOutcome.TimedOut
        KpfWorkerOutcome.Accepted
