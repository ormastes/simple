use os.smf.kernel_plugin.worker_protocol.*
use std.nogc_async_mut.kernel_plugin.runtime.KpfRequestHandleV1

pub const KPF_SHARED_MEMORY_WIRE_V1: u32 = 1

pub struct KpfSharedMemoryDescriptorV1:
    wire_version: u32
    protocol_version: u32
    kind: KpfWorkerFrameKind
    generation: i64
    session_epoch: i64
    request_slot: i64
    request_epoch: i64
    capability_bits: u64
    payload_offset: i64
    payload_length: i64

pub struct KpfSharedMemoryReadV1:
    outcome: KpfWorkerOutcome
    frame: KpfWorkerFrameV1

pub struct KpfSharedMemoryWorkerResultV1:
    outcome: KpfWorkerOutcome
    request: KpfRequestHandleV1
    payload: [u8]
    payload_length: i64

pub fn kpf_shared_memory_empty_descriptor_v1() -> KpfSharedMemoryDescriptorV1:
    KpfSharedMemoryDescriptorV1(wire_version: KPF_SHARED_MEMORY_WIRE_V1,
        protocol_version: KPF_WORKER_PROTOCOL_V1, kind: KpfWorkerFrameKind.Close,
        generation: 0, session_epoch: 0, request_slot: -1, request_epoch: 0,
        capability_bits: 0, payload_offset: 0, payload_length: 0)

pub fn kpf_shared_memory_validate_descriptor_v1(
        descriptor: KpfSharedMemoryDescriptorV1, storage_bytes: i64,
        expected_offset: i64, slot_payload_bytes: i64) -> KpfWorkerOutcome:
    if descriptor.wire_version != KPF_SHARED_MEMORY_WIRE_V1:
        return KpfWorkerOutcome.ProtocolMismatch
    if descriptor.protocol_version != KPF_WORKER_PROTOCOL_V1:
        return KpfWorkerOutcome.ProtocolMismatch
    if (storage_bytes < 0 or expected_offset < 0 or slot_payload_bytes < 0 or
            descriptor.payload_offset != expected_offset or
            descriptor.payload_length < 0 or
            descriptor.payload_length > slot_payload_bytes or
            descriptor.payload_offset > storage_bytes or
            descriptor.payload_length > storage_bytes - descriptor.payload_offset):
        return KpfWorkerOutcome.MalformedFrame
    KpfWorkerOutcome.Accepted
