# Compile-time host identity for executable SMF admission.
#
# This module deliberately performs no environment reads and starts no
# subprocesses. The values are folded into the loader for its build target.

@cfg(linux)
val SMF_HOST_PLATFORM_ID: u8 = 1
@cfg(windows)
val SMF_HOST_PLATFORM_ID: u8 = 2
@cfg(macos)
val SMF_HOST_PLATFORM_ID: u8 = 3
@cfg(freebsd)
val SMF_HOST_PLATFORM_ID: u8 = 4

@cfg(x86_64)
val SMF_HOST_ARCH_ID: u8 = 0
@cfg(arm64)
val SMF_HOST_ARCH_ID: u8 = 1
@cfg(x86)
val SMF_HOST_ARCH_ID: u8 = 2
@cfg(arm32)
val SMF_HOST_ARCH_ID: u8 = 3
@cfg(riscv64)
val SMF_HOST_ARCH_ID: u8 = 4
@cfg(riscv32)
val SMF_HOST_ARCH_ID: u8 = 5

fn smf_host_platform_id() -> u8:
    SMF_HOST_PLATFORM_ID

fn smf_host_arch_id() -> u8:
    SMF_HOST_ARCH_ID

fn smf_target_is_host_compatible(platform_id: u8, arch_id: u8) -> bool:
    (platform_id == 0 or platform_id == SMF_HOST_PLATFORM_ID) and
        arch_id == SMF_HOST_ARCH_ID

export smf_host_platform_id, smf_host_arch_id, smf_target_is_host_compatible
