use os.smf.smf_dynlib.{DynLoadRequest, smf_dlopen_admitted, smf_dlsym, smf_dlclose, smf_artifact_has_export, smf_artifact_has_exact_exports}
use os.smf.dynsmf_manifest_contract.{DynSmfManifestEntry}
use os.smf.aspect_pack_directory.{
    AspectPackLookupRequest,
    aspect_pack_directory_parse_from_outer_smf_bytes,
    aspect_pack_directory_validate_against_manifest
}
use std.common.crypto.sha256.{sha256_u8_hex}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_bytes(path: text) -> [u8]
extern fn rt_file_read_text(path: text) -> text
extern fn rt_hash_text(s: text) -> i64

val DYNSMF_FACET_REF_MAX_ISSUED: i64 = 16384
val DYNSMF_FACET_TOKEN_MAX: i64 = 9223372036854775807

class DynSmfPolicy:
    disabled_all: bool
    disabled_ids: [text]
    source: text

class DynSmfLoadedLibrary:
    id: text
    handle: int
    generation: int
    status: text
    symbol_registry: text
    path: text
    abi_version: text
    content_hash: text

# Module-private dynamic facet capability. Logical catalogs never carry it,
# callers cannot construct it, and its opaque token has meaning only through
# the issuing session's private registry.
struct DynSmfFacetRef:
    token: text

class DynSmfIssuedFacetRef:
    facet_id: text
    library_id: text
    export_symbol: text
    handle: int
    generation: int
    session_id: text
    interface_abi_hash: text
    path: text
    abi_version: text
    content_hash: text

class DynSmfTrustedFacetBinding:
    facet_id: text
    library_id: text
    export_symbol: text
    interface_abi_hash: text
    path: text
    abi_version: text
    pack_content_hash: text
    artifact_content_hash: text

class DynSmfEvidenceRow:
    library_id: text
    action: text
    policy_source: text
    status: text
    handle: int
    generation: int
    reason: text

    me to_text() -> text:
        return self.library_id + ":" + self.action + ":" + self.policy_source + ":" + self.status + ":" + self.reason + ":h" + self.handle.to_text() + ":g" + self.generation.to_text()

class DynSmfSession:
    session_id: text
    generation: int
    next_handle: int
    policy: DynSmfPolicy
    loaded: [DynSmfLoadedLibrary]
    evidence: [DynSmfEvidenceRow]
    _next_facet_token: i64
    _issued_facet_refs: Dict<text, DynSmfIssuedFacetRef>
    _trusted_facet_bindings: [DynSmfTrustedFacetBinding]

class DynSmfFacetLease:
    session: DynSmfSession
    facet_ref: DynSmfFacetRef?

class DynSmfBuildPlan:
    library_id: text
    source_module: text
    source_path: text
    output_path: text
    command: text
    status: text
    reason: text

class DynSmfArtifactStatus:
    library_id: text
    path: text
    ready: bool
    reason: text
    byte_count: int
    magic_hex: text

    me to_text() -> text:
        return self.library_id + ":" + self.path + ":" + self.ready.to_text() + ":" + self.reason + ":bytes" + self.byte_count.to_text() + ":magic" + self.magic_hex

fn dynsmf_default_manifest() -> [DynSmfManifestEntry]:
    [
        DynSmfManifestEntry(id: "file_io", path: "build/dynsmf/file_io.smf", source_module: "std.io", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["open", "close"]),
        DynSmfManifestEntry(id: "net_io", path: "build/dynsmf/net_io.smf", source_module: "std.net", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["connect", "close"]),
        DynSmfManifestEntry(id: "render2d", path: "build/dynsmf/render2d.smf", source_module: "std.render2d", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["draw"]),
        DynSmfManifestEntry(id: "web_renderer", path: "build/dynsmf/web_renderer.smf", source_module: "app.ui.render.html_widgets", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["render_html"]),
        DynSmfManifestEntry(id: "gui_renderer", path: "build/dynsmf/gui_renderer.smf", source_module: "app.ui.web.backend", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["render_gui"]),
        DynSmfManifestEntry(id: "tui_renderer", path: "build/dynsmf/tui_renderer.smf", source_module: "app.ui.render.tui_widgets", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["render_tui_tree"]),
        DynSmfManifestEntry(id: "ui_html", path: "build/dynsmf/ui_html.smf", source_module: "std.ui.html", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["render_html_ui"]),
        # Toolchain entries (on-demand only): qualification audit 2026-07-17 selected these
        # pre-existing seams so tooling changes avoid a full rebuild. default_autoload is
        # false for all five — they are invoked on demand, not startup libraries.
        DynSmfManifestEntry(id: "mcp_diag_tools", path: "build/dynsmf/mcp_diag_tools.smf", source_module: "app.mcp.main_lazy_diag_tools", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["format_new_diagnostics_block"]),
        DynSmfManifestEntry(id: "fmt_tool", path: "build/dynsmf/fmt_tool.smf", source_module: "compiler.tools.formatter", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["main"]),
        DynSmfManifestEntry(id: "lint_tool", path: "build/dynsmf/lint_tool.smf", source_module: "compiler.tools.lint", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["main"]),
        DynSmfManifestEntry(id: "fix_tool", path: "build/dynsmf/fix_tool.smf", source_module: "compiler.tools.fix", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["main"]),
        DynSmfManifestEntry(id: "todo_scan", path: "build/dynsmf/todo_scan.smf", source_module: "app.todo_scan", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["main"])
    ]

fn dynsmf_manifest_all_precompiled(manifest: [DynSmfManifestEntry]) -> bool:
    var idx = 0
    while idx < manifest.len():
        val entry = manifest[idx]
        if entry.artifact_kind != "precompiled_smf":
            return false
        if entry.path == "":
            return false
        if not entry.path.ends_with(".smf"):
            return false
        if entry.source_module == "":
            return false
        idx = idx + 1
    true

fn dynsmf_manifest_source_path(entry: DynSmfManifestEntry) -> text:
    if entry.id == "file_io":
        return "src/lib/nogc_sync_mut/io/file.spl"
    if entry.id == "net_io":
        return "src/lib/nogc_sync_mut/net.spl"
    if entry.id == "render2d":
        return "src/lib/gc_async_mut/gpu/engine2d/backend_lane.spl"
    if entry.id == "web_renderer":
        return "src/app/ui.render/html_widgets.spl"
    if entry.id == "gui_renderer":
        return "src/app/ui.web/backend.spl"
    if entry.id == "tui_renderer":
        return "src/app/ui.render/tui_widgets.spl"
    if entry.id == "ui_html":
        return "src/lib/common/ui/html_ui/dynsmf_entry.spl"
    ""

fn dynsmf_build_plan(entry: DynSmfManifestEntry) -> DynSmfBuildPlan:
    val source_path = dynsmf_manifest_source_path(entry)
    if entry.artifact_kind != "precompiled_smf":
        return DynSmfBuildPlan(library_id: entry.id, source_module: entry.source_module, source_path: source_path, output_path: entry.path, command: "", status: "invalid", reason: "not_precompiled_smf")
    if source_path == "":
        return DynSmfBuildPlan(library_id: entry.id, source_module: entry.source_module, source_path: source_path, output_path: entry.path, command: "", status: "invalid", reason: "unknown_source")
    if entry.path == "" or not entry.path.ends_with(".smf"):
        return DynSmfBuildPlan(library_id: entry.id, source_module: entry.source_module, source_path: source_path, output_path: entry.path, command: "", status: "invalid", reason: "invalid_output")
    val command = "bin/simple compile " + source_path + " -o " + entry.path
    DynSmfBuildPlan(library_id: entry.id, source_module: entry.source_module, source_path: source_path, output_path: entry.path, command: command, status: "ready", reason: "compile_to_smf")

fn dynsmf_build_plans(manifest: [DynSmfManifestEntry]) -> [DynSmfBuildPlan]:
    var plans: [DynSmfBuildPlan] = []
    var idx = 0
    while idx < manifest.len():
        plans.push(dynsmf_build_plan(manifest[idx]))
        idx = idx + 1
    plans

fn dynsmf_build_plans_ready(plans: [DynSmfBuildPlan]) -> bool:
    var idx = 0
    while idx < plans.len():
        if plans[idx].status != "ready":
            return false
        idx = idx + 1
    true

fn dynsmf_background_compile_action() -> text:
    "compile_background"

fn dynsmf_artifact_magic_hex(data: [u8]) -> text:
    if data.len() < 4:
        return "short"
    if data[0] == 83 and data[1] == 77 and data[2] == 70 and data[3] == 0:
        return "534d4600"
    "invalid"

fn dynsmf_artifact_has_smf_magic(data: [u8]) -> bool:
    data.len() >= 4 and data[0] == 83 and data[1] == 77 and data[2] == 70 and data[3] == 0

fn dynsmf_artifact_status_from_bytes(entry: DynSmfManifestEntry, file_present: bool, data: [u8]) -> DynSmfArtifactStatus:
    if entry.artifact_kind != "precompiled_smf":
        return DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: false, reason: "not_precompiled_smf", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))
    if entry.path == "":
        return DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: false, reason: "missing_path", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))
    if not file_present:
        return DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: false, reason: "missing_file", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))
    if data.len() < 4:
        return DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: false, reason: "too_short", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))
    if not dynsmf_artifact_has_smf_magic(data):
        return DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: false, reason: "invalid_magic", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))
    DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: true, reason: "smf_artifact_ready", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))

fn dynsmf_srchash_path(artifact_path: text) -> text:
    artifact_path + ".srchash"

fn dynsmf_source_hash_current(source_path: text) -> i64:
    val content = rt_file_read_text(source_path) ?? ""
    rt_hash_text(content)

fn dynsmf_source_hash_stored(artifact_path: text) -> i64:
    val sidecar = dynsmf_srchash_path(artifact_path)
    if not rt_file_exists(sidecar):
        return -1
    val raw = rt_file_read_text(sidecar) ?? ""
    if raw == "":
        return -1
    raw.trim().to_i64() ?? -1

fn dynsmf_artifact_status_with_hash(entry: DynSmfManifestEntry, file_present: bool, data: [u8], source_path: text) -> DynSmfArtifactStatus:
    val base = dynsmf_artifact_status_from_bytes(entry, file_present, data)
    if not base.ready:
        return base
    if source_path == "":
        return base
    val stored = dynsmf_source_hash_stored(entry.path)
    if stored == -1:
        return DynSmfArtifactStatus(library_id: base.library_id, path: base.path, ready: false, reason: "stale_source", byte_count: base.byte_count, magic_hex: base.magic_hex)
    val current = dynsmf_source_hash_current(source_path)
    if current != stored:
        return DynSmfArtifactStatus(library_id: base.library_id, path: base.path, ready: false, reason: "stale_source", byte_count: base.byte_count, magic_hex: base.magic_hex)
    base

fn dynsmf_artifact_status(entry: DynSmfManifestEntry) -> DynSmfArtifactStatus:
    if entry.path == "":
        return dynsmf_artifact_status_from_bytes(entry, false, [])
    if not rt_file_exists(entry.path):
        return dynsmf_artifact_status_from_bytes(entry, false, [])
    val data = rt_file_read_bytes(entry.path) ?? []
    val source_path = dynsmf_manifest_source_path(entry)
    dynsmf_artifact_status_with_hash(entry, true, data, source_path)

fn dynsmf_artifacts_ready(manifest: [DynSmfManifestEntry]) -> bool:
    var idx = 0
    while idx < manifest.len():
        if not dynsmf_artifact_status(manifest[idx]).ready:
            return false
        idx = idx + 1
    true

fn dynsmf_session_record_background_compile_for_status(
    session: DynSmfSession,
    entry: DynSmfManifestEntry,
    plan: DynSmfBuildPlan,
    artifact: DynSmfArtifactStatus,
    record_ready: bool,
    record_disabled: bool
) -> DynSmfSession:
    var out = session
    if dynsmf_id_disabled(out.policy, entry.id):
        if record_disabled:
            out.evidence.push(DynSmfEvidenceRow(library_id: entry.id, action: dynsmf_background_compile_action(), policy_source: out.policy.source, status: "skipped", handle: 0, generation: out.generation, reason: "disabled"))
        return out
    if plan.status != "ready":
        out.evidence.push(DynSmfEvidenceRow(library_id: entry.id, action: dynsmf_background_compile_action(), policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "invalid_" + plan.reason))
        return out
    if artifact.ready:
        if record_ready:
            out.evidence.push(DynSmfEvidenceRow(library_id: entry.id, action: dynsmf_background_compile_action(), policy_source: out.policy.source, status: "skipped", handle: 0, generation: out.generation, reason: "artifact_ready"))
        return out
    out.evidence.push(DynSmfEvidenceRow(library_id: entry.id, action: dynsmf_background_compile_action(), policy_source: out.policy.source, status: "queued", handle: 0, generation: out.generation, reason: "queued:" + plan.command))
    out

fn dynsmf_session_request_background_compiles_from_statuses(
    session: DynSmfSession,
    manifest: [DynSmfManifestEntry],
    statuses: [DynSmfArtifactStatus],
    record_ready: bool,
    record_disabled: bool
) -> DynSmfSession:
    var out = session
    var idx = 0
    while idx < manifest.len():
        val entry = manifest[idx]
        val plan = dynsmf_build_plan(entry)
        val artifact = if idx < statuses.len(): statuses[idx] else: dynsmf_artifact_status(entry)
        out = dynsmf_session_record_background_compile_for_status(out, entry, plan, artifact, record_ready, record_disabled)
        idx = idx + 1
    out

fn dynsmf_session_request_background_compiles(session: DynSmfSession, manifest: [DynSmfManifestEntry]) -> DynSmfSession:
    dynsmf_session_request_background_compiles_from_statuses(session, manifest, [], true, true)

fn dynsmf_session_queue_missing_background_compiles(session: DynSmfSession, manifest: [DynSmfManifestEntry]) -> DynSmfSession:
    dynsmf_session_request_background_compiles_from_statuses(session, manifest, [], false, false)

fn dynsmf_policy_default() -> DynSmfPolicy:
    DynSmfPolicy(disabled_all: false, disabled_ids: [], source: "default")

fn dynsmf_policy_from_args_env(args: [text], env_dynsmf: text, env_disable: text) -> DynSmfPolicy:
    var disabled_all = false
    var disabled_ids: [text] = []
    var source = "default"
    if env_dynsmf == "0":
        disabled_all = true
        source = "env:SIMPLE_DYNSMF"
    if env_disable != "":
        val ids = env_disable.split(",")
        var idx = 0
        while idx < ids.len():
            if ids[idx] != "":
                disabled_ids.push(ids[idx])
            idx = idx + 1
        source = "env:SIMPLE_DYNSMF_DISABLE"
    var arg_idx = 0
    while arg_idx < args.len():
        val arg = args[arg_idx]
        if arg == "--no-dynsmf":
            disabled_all = true
            source = "arg:--no-dynsmf"
        elif arg.starts_with("--disable-dynsmf="):
            val parts = arg.split("=")
            if parts.len() == 2:
                val ids = parts[1].split(",")
                var idx = 0
                while idx < ids.len():
                    if ids[idx] != "":
                        disabled_ids.push(ids[idx])
                    idx = idx + 1
                source = "arg:--disable-dynsmf"
        arg_idx = arg_idx + 1
    DynSmfPolicy(disabled_all: disabled_all, disabled_ids: disabled_ids, source: source)

fn _dynsmf_revoke_library_facet_refs(session: DynSmfSession, library_id: text) -> DynSmfSession:
    var out = session
    var retained: Dict<text, DynSmfIssuedFacetRef> = {}
    for token in out._issued_facet_refs.keys():
        val issued = out._issued_facet_refs[token]
        if issued.library_id != library_id:
            retained[token] = issued
    var trusted: [DynSmfTrustedFacetBinding] = []
    var trusted_index = 0
    while trusted_index < out._trusted_facet_bindings.len():
        val binding = out._trusted_facet_bindings[trusted_index]
        if binding.library_id != library_id:
            trusted.push(binding)
        trusted_index = trusted_index + 1
    out._issued_facet_refs = retained
    out._trusted_facet_bindings = trusted
    out

fn dynsmf_session_new(session_id: text, policy: DynSmfPolicy) -> DynSmfSession:
    val issued_facet_refs: Dict<text, DynSmfIssuedFacetRef> = {}
    DynSmfSession(session_id: session_id, generation: 1, next_handle: 100, policy: policy, loaded: [], evidence: [], _next_facet_token: 1, _issued_facet_refs: issued_facet_refs, _trusted_facet_bindings: [])

fn _dynsmf_facet_token_key(session_id: text, sequence: i64) -> text:
    # Length-prefixing makes the session/sequence boundary unambiguous. This
    # is an opaque module-private identity, not a cryptographic random value.
    session_id.len().to_text() + ":" + session_id + ":" + sequence.to_text()

fn dynsmf_id_disabled(policy: DynSmfPolicy, id: text) -> bool:
    if policy.disabled_all:
        return true
    var idx = 0
    while idx < policy.disabled_ids.len():
        if policy.disabled_ids[idx] == id:
            return true
        idx = idx + 1
    false

fn dynsmf_manifest_find(manifest: [DynSmfManifestEntry], id: text) -> DynSmfManifestEntry?:
    var idx = 0
    while idx < manifest.len():
        if manifest[idx].id == id:
            return manifest[idx]
        idx = idx + 1
    nil

fn dynsmf_symbol_registry(entry: DynSmfManifestEntry, handle: int) -> text:
    var rows: [text] = []
    var idx = 0
    while idx < entry.exports.len():
        rows.push(handle.to_text() + ":" + entry.exports[idx] + ":" + (idx + 1).to_text())
        idx = idx + 1
    rows.join(";")

fn dynsmf_session_add_evidence(session: DynSmfSession, row: DynSmfEvidenceRow) -> DynSmfSession:
    var out = session
    out.evidence.push(row)
    out

fn dynsmf_snapshot_artifact_bytes(data: [u8]) -> [u8]:
    var snapshot: [u8] = []
    for byte in data:
        snapshot.push(byte)
    snapshot

fn dynsmf_session_load_without_admission(session: DynSmfSession, manifest: [DynSmfManifestEntry], id: text) -> DynSmfSession:
    """Fail-closed compatibility path for callers that do not own exact bytes.

    Path validation cannot authorize executable mapping: reopening a path after
    validation would race the admitted object. Startup owners must retain their
    one digest-verified byte image and call `dynsmf_session_load_admitted`.
    """
    var out = session
    val entry_opt = dynsmf_manifest_find(manifest, id)
    if not entry_opt:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "unknown_library"))
    if dynsmf_id_disabled(out.policy, id):
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "skip", policy_source: out.policy.source, status: "skipped", handle: 0, generation: out.generation, reason: "disabled"))
    var loaded_idx = 0
    while loaded_idx < out.loaded.len():
        val existing = out.loaded[loaded_idx]
        if existing.id == id and existing.status == "loaded":
            return out
        loaded_idx = loaded_idx + 1
    dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "admitted_artifact_bytes_required"))

fn dynsmf_session_load(session: DynSmfSession, manifest: [DynSmfManifestEntry], id: text) -> DynSmfSession:
    dynsmf_session_load_without_admission(session, manifest, id)

fn dynsmf_session_load_checked(session: DynSmfSession, manifest: [DynSmfManifestEntry], id: text) -> DynSmfSession:
    dynsmf_session_load_without_admission(session, manifest, id)

fn dynsmf_session_load_admitted(
    session: DynSmfSession,
    id: text,
    trusted_request: AspectPackLookupRequest,
    artifact_bytes: [u8]
) -> DynSmfSession:
    """Load the exact bytes admitted by an explicit trusted aspect request."""
    var out = session
    val artifact = trusted_request.artifact
    val manifest = trusted_request.manifest
    val exact_bytes = dynsmf_snapshot_artifact_bytes(artifact_bytes)
    if dynsmf_id_disabled(out.policy, id):
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "skip", policy_source: out.policy.source, status: "skipped", handle: 0, generation: out.generation, reason: "disabled"))
    if id == "" or artifact.library_id != id or artifact.path == "" or artifact.content_hash == "":
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "artifact_identity_invalid"))
    if sha256_u8_hex(exact_bytes) != artifact.content_hash:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "artifact_content_hash_mismatch"))
    val parsed_outer = aspect_pack_directory_parse_from_outer_smf_bytes(exact_bytes)
    if not parsed_outer.ok:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "artifact_aspect_pack_invalid:" + parsed_outer.error_code))
    val trusted_admission = aspect_pack_directory_validate_against_manifest(
        parsed_outer.directory,
        trusted_request.catalog,
        trusted_request.manifest,
        trusted_request.artifact,
        trusted_request.export_contracts
    )
    if not trusted_admission.ok:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "trusted_aspect_admission_invalid"))
    var manifest_matches = 0
    var manifest_path = ""
    var manifest_abi = ""
    var manifest_exports: [text] = []
    var manifest_index = 0
    while manifest_index < manifest.len():
        if manifest[manifest_index].id == id:
            manifest_matches = manifest_matches + 1
            manifest_path = manifest[manifest_index].path
            manifest_abi = manifest[manifest_index].abi_version
            manifest_exports = manifest[manifest_index].exports
        manifest_index = manifest_index + 1
    if manifest_matches != 1 or manifest_path != artifact.path or manifest_abi == "":
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "manifest_artifact_identity_mismatch"))
    if not smf_artifact_has_exact_exports(exact_bytes, manifest_exports):
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "artifact_manifest_export_set_mismatch"))
    var trusted_matches = 0
    var trusted_index = 0
    while trusted_index < trusted_admission.facets.len():
        if trusted_admission.facets[trusted_index].library_id == id:
            trusted_matches = trusted_matches + 1
        trusted_index = trusted_index + 1
    if trusted_matches == 0:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "trusted_aspect_admission_empty"))
    var already_loaded = false
    var loaded_index = 0
    while loaded_index < out.loaded.len():
        val existing = out.loaded[loaded_index]
        if existing.id == id and existing.status == "loaded":
            if existing.path == artifact.path and existing.abi_version == manifest_abi and existing.content_hash == artifact.content_hash:
                already_loaded = true
            else:
                return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: existing.handle, generation: existing.generation, reason: "different_artifact_already_loaded"))
        loaded_index = loaded_index + 1
    if not already_loaded:
        val request = DynLoadRequest.lazy(id, artifact.path, out.session_id)
        val load = smf_dlopen_admitted(request, out.next_handle, exact_bytes)
        if not load.success:
            return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: load.error_msg))
        var action = "load"
        loaded_index = 0
        while loaded_index < out.loaded.len():
            val existing = out.loaded[loaded_index]
            if existing.id == id and existing.status == "unloaded":
                action = "reload"
            loaded_index = loaded_index + 1
        if action == "reload":
            out = _dynsmf_revoke_library_facet_refs(out, id)
        val handle = load.handle_id
        out.next_handle = out.next_handle + 1
        out.loaded.push(DynSmfLoadedLibrary(id: id, handle: handle, generation: out.generation, status: "loaded", symbol_registry: "", path: artifact.path, abi_version: manifest_abi, content_hash: artifact.content_hash))
        out.evidence.push(DynSmfEvidenceRow(library_id: id, action: action, policy_source: out.policy.source, status: "loaded", handle: handle, generation: out.generation, reason: "smf_dlopen_admitted"))
    trusted_index = 0
    while trusted_index < trusted_admission.facets.len():
        val trusted = trusted_admission.facets[trusted_index]
        if trusted.library_id == id:
            var duplicate = false
            var existing_index = 0
            while existing_index < out._trusted_facet_bindings.len():
                val existing = out._trusted_facet_bindings[existing_index]
                if (existing.facet_id == trusted.facet_id and existing.library_id == trusted.library_id and
                    existing.export_symbol == trusted.export_symbol and existing.interface_abi_hash == trusted.interface_abi_hash and
                    existing.path == artifact.path and existing.abi_version == trusted.library_abi_version and
                    existing.pack_content_hash == trusted.pack_content_hash and
                    existing.artifact_content_hash == artifact.content_hash):
                    duplicate = true
                existing_index = existing_index + 1
            if not duplicate:
                out._trusted_facet_bindings.push(DynSmfTrustedFacetBinding(
                    facet_id: trusted.facet_id,
                    library_id: trusted.library_id,
                    export_symbol: trusted.export_symbol,
                    interface_abi_hash: trusted.interface_abi_hash,
                    path: artifact.path,
                    abi_version: trusted.library_abi_version,
                    pack_content_hash: trusted.pack_content_hash,
                    artifact_content_hash: artifact.content_hash
                ))
        trusted_index = trusted_index + 1
    out

fn dynsmf_session_autoload(session: DynSmfSession, manifest: [DynSmfManifestEntry]) -> DynSmfSession:
    var out = session
    var idx = 0
    while idx < manifest.len():
        if manifest[idx].default_autoload:
            out = dynsmf_session_load(out, manifest, manifest[idx].id)
        idx = idx + 1
    out

fn dynsmf_session_autoload_checked(session: DynSmfSession, manifest: [DynSmfManifestEntry]) -> DynSmfSession:
    var out = session
    var idx = 0
    while idx < manifest.len():
        if manifest[idx].default_autoload:
            out = dynsmf_session_load_checked(out, manifest, manifest[idx].id)
        idx = idx + 1
    out

fn dynsmf_session_find_loaded(session: DynSmfSession, id: text) -> DynSmfLoadedLibrary?:
    var idx = 0
    while idx < session.loaded.len():
        val lib = session.loaded[idx]
        if lib.id == id:
            if lib.status == "loaded":
                return lib
        idx = idx + 1
    nil

fn _dynsmf_facet_lease_none(session: DynSmfSession) -> DynSmfFacetLease:
    DynSmfFacetLease(session: session, facet_ref: nil)

fn dynsmf_session_lookup_facet(session: DynSmfSession, request: AspectPackLookupRequest) -> DynSmfFacetLease:
    """Resolve one unambiguous dynamic facet through this session.

    The catalog supplies the explicit export symbol.  Lookup never derives a
    symbol from the facet id. The returned lease carries the updated session
    whose private registry owns the opaque reference.
    """
    val facet_id = request.facet_id
    # A caller-supplied nonempty session identity is the namespace for this
    # session-owned monotonic allocator. Empty identities cannot issue refs.
    if session.session_id == "" or facet_id == "":
        return _dynsmf_facet_lease_none(session)
    val admission = aspect_pack_directory_validate_against_manifest(
        request.directory,
        request.catalog,
        request.manifest,
        request.artifact,
        request.export_contracts
    )
    if not admission.ok:
        return _dynsmf_facet_lease_none(session)
    var facet_matches = 0
    var admitted_index = 0
    var library_id = ""
    var export_symbol = ""
    var interface_abi_hash = ""
    var pack_content_hash = ""
    var library_abi_version = ""
    while admitted_index < admission.facets.len():
        val entry = admission.facets[admitted_index]
        if entry.facet_id == facet_id:
            facet_matches = facet_matches + 1
            library_id = entry.library_id
            export_symbol = entry.export_symbol
            interface_abi_hash = entry.interface_abi_hash
            pack_content_hash = entry.pack_content_hash
            library_abi_version = entry.library_abi_version
        admitted_index = admitted_index + 1
    if facet_matches != 1:
        return _dynsmf_facet_lease_none(session)
    var trusted_matches = 0
    var trusted_index = 0
    while trusted_index < session._trusted_facet_bindings.len():
        val trusted = session._trusted_facet_bindings[trusted_index]
        if (trusted.facet_id == facet_id and trusted.library_id == library_id and
            trusted.export_symbol == export_symbol and trusted.interface_abi_hash == interface_abi_hash and
            trusted.path == request.artifact.path and trusted.abi_version == library_abi_version and
            trusted.pack_content_hash == pack_content_hash and
            trusted.artifact_content_hash == request.artifact.content_hash):
            trusted_matches = trusted_matches + 1
        trusted_index = trusted_index + 1
    if trusted_matches != 1:
        return _dynsmf_facet_lease_none(session)

    var loaded_matches = 0
    var handle = 0
    var generation = 0
    var registry = ""
    var loaded_path = ""
    var loaded_abi = ""
    var loaded_hash = ""
    var loaded_index = 0
    while loaded_index < session.loaded.len():
        val library = session.loaded[loaded_index]
        if (library.id == library_id and library.status == "loaded" and
            library.path == request.artifact.path and
            library.abi_version == library_abi_version and
            library.content_hash == request.artifact.content_hash):
            loaded_matches = loaded_matches + 1
            handle = library.handle
            generation = library.generation
            registry = library.symbol_registry
            loaded_path = library.path
            loaded_abi = library.abi_version
            loaded_hash = library.content_hash
        loaded_index = loaded_index + 1
    if loaded_matches != 1:
        return _dynsmf_facet_lease_none(session)
    val symbol = smf_dlsym(handle, export_symbol, registry)
    if not symbol.found:
        return _dynsmf_facet_lease_none(session)

    if session._issued_facet_refs.keys().len() >= DYNSMF_FACET_REF_MAX_ISSUED:
        return _dynsmf_facet_lease_none(session)
    if session._next_facet_token <= 0 or session._next_facet_token > DYNSMF_FACET_TOKEN_MAX:
        return _dynsmf_facet_lease_none(session)
    var out = session
    val sequence = out._next_facet_token
    val token = _dynsmf_facet_token_key(out.session_id, sequence)
    if out._issued_facet_refs.contains_key(token):
        return _dynsmf_facet_lease_none(session)
    if sequence == DYNSMF_FACET_TOKEN_MAX:
        out._next_facet_token = 0
    else:
        out._next_facet_token = sequence + 1
    out._issued_facet_refs[token] = DynSmfIssuedFacetRef(
        facet_id: facet_id,
        library_id: library_id,
        export_symbol: export_symbol,
        handle: handle,
        generation: generation,
        session_id: session.session_id,
        interface_abi_hash: interface_abi_hash,
        path: loaded_path,
        abi_version: loaded_abi,
        content_hash: loaded_hash
    )
    DynSmfFacetLease(session: out, facet_ref: DynSmfFacetRef(token: token))

fn dynsmf_session_validate_facet_ref(session: DynSmfSession, facet_ref: DynSmfFacetRef) -> bool:
    """True only while the exact registry-issued library generation is live."""
    if facet_ref.token == "" or not session._issued_facet_refs.contains_key(facet_ref.token):
        return false
    val issued = session._issued_facet_refs[facet_ref.token]
    if issued.session_id != session.session_id:
        return false
    if (issued.facet_id == "" or issued.library_id == "" or
        issued.export_symbol == "" or issued.interface_abi_hash == "" or
        issued.path == "" or issued.abi_version == "" or issued.content_hash == ""):
        return false
    if issued.handle <= 0 or issued.generation <= 0:
        return false
    var matches = 0
    var index = 0
    while index < session.loaded.len():
        val library = session.loaded[index]
        if (library.id == issued.library_id and library.status == "loaded" and
            library.handle == issued.handle and library.generation == issued.generation and
            library.path == issued.path and library.abi_version == issued.abi_version and
            library.content_hash == issued.content_hash):
            val symbol = smf_dlsym(library.handle, issued.export_symbol, library.symbol_registry)
            if symbol.found:
                matches = matches + 1
        index = index + 1
    matches == 1

fn dynsmf_session_symbol(session: DynSmfSession, id: text, symbol: text) -> DynSmfEvidenceRow:
    var idx = 0
    while idx < session.loaded.len():
        val lib = session.loaded[idx]
        if lib.id == id:
            if lib.status == "loaded":
                val sym = smf_dlsym(lib.handle, symbol, lib.symbol_registry)
                if sym.found:
                    return DynSmfEvidenceRow(library_id: id, action: "symbol", policy_source: session.policy.source, status: "ok", handle: lib.handle, generation: lib.generation, reason: symbol + "@" + sym.offset.to_text())
                return DynSmfEvidenceRow(library_id: id, action: "symbol", policy_source: session.policy.source, status: "missing", handle: lib.handle, generation: lib.generation, reason: sym.error_msg)
        idx = idx + 1
    DynSmfEvidenceRow(library_id: id, action: "symbol", policy_source: session.policy.source, status: "stale", handle: 0, generation: session.generation, reason: "unloaded")

fn dynsmf_session_record_symbol(session: DynSmfSession, id: text, symbol: text) -> DynSmfSession:
    dynsmf_session_add_evidence(session, dynsmf_session_symbol(session, id, symbol))

fn dynsmf_session_unload(session: DynSmfSession, id: text) -> DynSmfSession:
    var out = session
    var idx = 0
    var found = false
    var loaded: [DynSmfLoadedLibrary] = []
    while idx < out.loaded.len():
        val lib = out.loaded[idx]
        if lib.id == id:
            if lib.status == "loaded":
                val close = smf_dlclose(lib.handle)
                if close.success:
                    found = true
                    loaded.push(DynSmfLoadedLibrary(id: lib.id, handle: lib.handle, generation: lib.generation, status: "unloaded", symbol_registry: "", path: lib.path, abi_version: lib.abi_version, content_hash: lib.content_hash))
                    out.generation = out.generation + 1
                    out.evidence.push(DynSmfEvidenceRow(library_id: id, action: "unload", policy_source: out.policy.source, status: "unloaded", handle: lib.handle, generation: out.generation, reason: "smf_dlclose"))
                else:
                    loaded.push(lib)
                    out.evidence.push(DynSmfEvidenceRow(library_id: id, action: "unload", policy_source: out.policy.source, status: "failed", handle: lib.handle, generation: out.generation, reason: close.error_msg))
            else:
                loaded.push(lib)
        else:
            loaded.push(lib)
        idx = idx + 1
    if not found:
        out.evidence.push(DynSmfEvidenceRow(library_id: id, action: "unload", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "not_loaded"))
    else:
        out.loaded = loaded
        out = _dynsmf_revoke_library_facet_refs(out, id)
    out

