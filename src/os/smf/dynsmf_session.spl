use os.smf.smf_dynlib.{DynLoadRequest, DynLoadResult, smf_dlopen, smf_dlopen_bytes, smf_dlopen_frozen_exact_exports, smf_dlopen_frozen_exact_exports_protected_v3, smf_dynlib_next_available_handle, smf_dlsym, smf_dlclose, smf_artifact_has_exports}
use os.smf.dynsmf_snapshot.{dynsmf_snapshot_capture, dynsmf_snapshot_request_error}
use os.smf.dynsmf_types.{DynSmfArtifactStatus}
use os.smf.aspect_pack_directory.{AspectPackLookupRequest, aspect_pack_directory_parse_from_outer_smf_bytes, aspect_pack_directory_validate_against_manifest}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.aspect_pack.{apk_open_pack_v1, apk_load_module_v1}
use std.common.hash.runtime_text.{runtime_text_hash_v1}
use std.nogc_sync_mut.io_runtime.{file_exists, file_read_nullable}
# Compatibility re-export: callers historically import this value contract
# through dynsmf_session, while the canonical owner is manifest_contract.
export use os.smf.dynsmf_manifest_contract.{DynSmfManifestEntry}

val DYNSMF_FACET_REF_MAX_ISSUED: i64 = 16384
val DYNSMF_FACET_TOKEN_MAX: i64 = 9223372036854775807

class DynSmfPolicy:
    disabled_all: bool
    disabled_ids: [text]
    source: text
    _disabled_id_index: Dict<text, bool>

class DynSmfLoadedLibrary:
    id: text
    handle: int
    generation: int
    status: text
    symbol_registry: text
    path: text
    abi_version: text
    content_hash: text

struct DynSmfFacetRef:
    token: text

class DynSmfIssuedFacetRef:
    facet_id: text
    library_id: text
    export_symbol: text
    handle: int
    generation: int
    session_id: text
    interface_abi_hash: text
    path: text
    abi_version: text
    content_hash: text

class DynSmfTrustedFacetBinding:
    facet_id: text
    library_id: text
    export_symbol: text
    interface_abi_hash: text
    path: text
    abi_version: text
    pack_content_hash: text
    artifact_content_hash: text

class DynSmfEvidenceRow:
    library_id: text
    action: text
    policy_source: text
    status: text
    handle: int
    generation: int
    reason: text

    me to_text() -> text:
        return self.library_id + ":" + self.action + ":" + self.policy_source + ":" + self.status + ":" + self.reason + ":h" + self.handle.to_text() + ":g" + self.generation.to_text()

class DynSmfSession:
    session_id: text
    generation: int
    next_handle: int
    policy: DynSmfPolicy
    loaded: [DynSmfLoadedLibrary]
    evidence: [DynSmfEvidenceRow]
    _next_facet_token: i64
    _issued_facet_refs: Dict<text, DynSmfIssuedFacetRef>
    _issued_facet_tokens_by_library: Dict<text, [text]>
    _issued_facet_ref_count: i64
    _trusted_facet_bindings: Dict<text, DynSmfTrustedFacetBinding>
    _trusted_facet_keys_by_library: Dict<text, [text]>
    _loaded_indices: Dict<text, i64>
    _known_library_slots: Dict<text, i64>

class DynSmfFacetLease:
    session: DynSmfSession
    facet_ref: DynSmfFacetRef?

class DynSmfBuildPlan:
    library_id: text
    source_module: text
    source_path: text
    output_path: text
    command: text
    status: text
    reason: text

class DynSmfArtifactSnapshot:
    path: text
    data: [u8]
    file_present: bool

fn dynsmf_default_manifest() -> [DynSmfManifestEntry]:
    [
        DynSmfManifestEntry(id: "file_io", path: "build/dynsmf/file_io.smf", source_module: "std.io", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["open", "close"]),
        DynSmfManifestEntry(id: "net_io", path: "build/dynsmf/net_io.smf", source_module: "std.net", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["connect", "close"]),
        DynSmfManifestEntry(id: "render2d", path: "build/dynsmf/render2d.smf", source_module: "std.render2d", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["draw"]),
        DynSmfManifestEntry(id: "web_renderer", path: "build/dynsmf/web_renderer.smf", source_module: "app.ui.render.html_widgets", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["render_html"]),
        DynSmfManifestEntry(id: "gui_renderer", path: "build/dynsmf/gui_renderer.smf", source_module: "app.ui.web.backend", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["render_gui"]),
        DynSmfManifestEntry(id: "tui_renderer", path: "build/dynsmf/tui_renderer.smf", source_module: "app.ui.render.tui_widgets", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["render_tui_tree"]),
        DynSmfManifestEntry(id: "ui_html", path: "build/dynsmf/ui_html.smf", source_module: "std.ui.html", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["render_html_ui"]),
        # Toolchain entries (on-demand only): qualification audit 2026-07-17 selected these
        # pre-existing seams so tooling changes avoid a full rebuild. default_autoload is
        # false for all five — they are invoked on demand, not startup libraries.
        DynSmfManifestEntry(id: "mcp_diag_tools", path: "build/dynsmf/mcp_diag_tools.smf", source_module: "app.mcp.main_lazy_diag_tools", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["format_new_diagnostics_block"]),
        DynSmfManifestEntry(id: "fmt_tool", path: "build/dynsmf/fmt_tool.smf", source_module: "compiler.tools.formatter", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["main"]),
        # lint_tool exports lint_main, not main: main.spl no longer re-exports
        # a symbol literally named `main` (renamed 2026-08-01; see
        # doc/08_tracking/bug/test_runner_wildcard_imported_main_phantom_failure_2026-08-01.md).
        DynSmfManifestEntry(id: "lint_tool", path: "build/dynsmf/lint_tool.smf", source_module: "compiler.tools.lint", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["lint_main"]),
        DynSmfManifestEntry(id: "fix_tool", path: "build/dynsmf/fix_tool.smf", source_module: "compiler.tools.fix", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["main"]),
        DynSmfManifestEntry(id: "todo_scan", path: "build/dynsmf/todo_scan.smf", source_module: "app.todo_scan", artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["main"])
    ]

fn dynsmf_manifest_all_precompiled(manifest: [DynSmfManifestEntry]) -> bool:
    var idx = 0
    while idx < manifest.len():
        val entry = manifest[idx]
        if entry.artifact_kind != "precompiled_smf":
            return false
        if entry.path == "":
            return false
        if not entry.path.ends_with(".smf"):
            return false
        if entry.source_module == "":
            return false
        idx = idx + 1
    true

fn dynsmf_manifest_source_path(entry: DynSmfManifestEntry) -> text:
    if entry.id == "file_io":
        return "src/lib/nogc_sync_mut/io/file.spl"
    if entry.id == "net_io":
        return "src/lib/nogc_sync_mut/net.spl"
    if entry.id == "render2d":
        return "src/lib/gc_async_mut/gpu/engine2d/backend_lane.spl"
    if entry.id == "web_renderer":
        return "src/app/ui.render/html_widgets.spl"
    if entry.id == "gui_renderer":
        return "src/app/ui.web/backend.spl"
    if entry.id == "tui_renderer":
        return "src/app/ui.render/tui_widgets.spl"
    if entry.id == "ui_html":
        return "src/lib/common/ui/html_ui/dynsmf_entry.spl"
    if entry.id == "mcp_diag_tools":
        return "src/app/mcp/main_lazy_diag_tools.spl"
    if entry.id == "fmt_tool":
        return "src/compiler/90.tools/formatter/main.spl"
    if entry.id == "lint_tool":
        return "src/compiler/90.tools/lint/main.spl"
    if entry.id == "fix_tool":
        return "src/compiler/90.tools/fix/main.spl"
    if entry.id == "todo_scan":
        return "src/app/todo_scan/main.spl"
    ""

fn dynsmf_build_plan(entry: DynSmfManifestEntry) -> DynSmfBuildPlan:
    val source_path = dynsmf_manifest_source_path(entry)
    if entry.artifact_kind != "precompiled_smf":
        return DynSmfBuildPlan(library_id: entry.id, source_module: entry.source_module, source_path: source_path, output_path: entry.path, command: "", status: "invalid", reason: "not_precompiled_smf")
    if source_path == "":
        return DynSmfBuildPlan(library_id: entry.id, source_module: entry.source_module, source_path: source_path, output_path: entry.path, command: "", status: "invalid", reason: "unknown_source")
    if entry.path == "" or not entry.path.ends_with(".smf"):
        return DynSmfBuildPlan(library_id: entry.id, source_module: entry.source_module, source_path: source_path, output_path: entry.path, command: "", status: "invalid", reason: "invalid_output")
    val command = "bin/simple compile " + source_path + " -o " + entry.path
    DynSmfBuildPlan(library_id: entry.id, source_module: entry.source_module, source_path: source_path, output_path: entry.path, command: command, status: "ready", reason: "compile_to_smf")

fn dynsmf_build_plans(manifest: [DynSmfManifestEntry]) -> [DynSmfBuildPlan]:
    var plans: [DynSmfBuildPlan] = []
    var idx = 0
    while idx < manifest.len():
        plans.push(dynsmf_build_plan(manifest[idx]))
        idx = idx + 1
    plans

fn dynsmf_build_plans_ready(plans: [DynSmfBuildPlan]) -> bool:
    var idx = 0
    while idx < plans.len():
        if plans[idx].status != "ready":
            return false
        idx = idx + 1
    true

fn dynsmf_background_compile_action() -> text:
    "compile_background"

fn dynsmf_artifact_magic_hex(data: [u8]) -> text:
    if data.len() < 4:
        return "short"
    if data[0] == 83 and data[1] == 77 and data[2] == 70 and data[3] == 0:
        return "534d4600"
    "invalid"

fn dynsmf_artifact_has_smf_magic(data: [u8]) -> bool:
    data.len() >= 4 and data[0] == 83 and data[1] == 77 and data[2] == 70 and data[3] == 0

fn dynsmf_artifact_status_from_bytes(entry: DynSmfManifestEntry, file_present: bool, data: [u8]) -> DynSmfArtifactStatus:
    if entry.artifact_kind != "precompiled_smf":
        return DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: false, reason: "not_precompiled_smf", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))
    if entry.path == "":
        return DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: false, reason: "missing_path", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))
    if not file_present:
        return DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: false, reason: "missing_file", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))
    if data.len() < 4:
        return DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: false, reason: "too_short", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))
    if not dynsmf_artifact_has_smf_magic(data):
        return DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: false, reason: "invalid_magic", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))
    DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: true, reason: "smf_artifact_ready", byte_count: data.len(), magic_hex: dynsmf_artifact_magic_hex(data))

fn dynsmf_srchash_path(artifact_path: text) -> text:
    artifact_path + ".srchash"

fn dynsmf_source_hash_current(source_path: text) -> i64:
    val content = file_read_nullable(source_path) ?? ""
    runtime_text_hash_v1(content)

fn dynsmf_source_hash_stored(artifact_path: text) -> i64:
    val sidecar = dynsmf_srchash_path(artifact_path)
    if not file_exists(sidecar):
        return -1
    val raw = file_read_nullable(sidecar) ?? ""
    if raw == "":
        return -1
    raw.trim().to_i64() ?? -1

fn dynsmf_abi_path(artifact_path: text) -> text:
    artifact_path + ".abi"

fn dynsmf_abi_stored(artifact_path: text) -> text:
    val sidecar = dynsmf_abi_path(artifact_path)
    if not file_exists(sidecar):
        return ""
    val raw = file_read_nullable(sidecar) ?? ""
    raw.trim()

fn dynsmf_ifacehash_path(artifact_path: text) -> text:
    artifact_path + ".ifacehash"

# ponytail: heuristic line-level interface fingerprint — matches exported
# signature lines only (pub fn/struct/class/enum, trait, export), trimmed and
# hashed with the same stable Pure-Simple byte primitive as srchash. Good enough to
# tell "impl body changed" from "exported interface changed" for dynSMF
# staleness without pulling compiler internals into the os/smf layer. Upgrade
# path: reuse the compiler's SHB interface-hash extractor (src/compiler/80.driver/)
# once it is reachable from here.
fn dynsmf_interface_line_is_exported(trimmed_line: text) -> bool:
    trimmed_line.starts_with("pub fn") or trimmed_line.starts_with("pub struct") or
        trimmed_line.starts_with("pub class") or trimmed_line.starts_with("pub enum") or
        trimmed_line.starts_with("pub trait") or
        trimmed_line.starts_with("trait") or trimmed_line.starts_with("export")

fn dynsmf_interface_fingerprint(source_text: text) -> text:
    var rows: [text] = []
    val lines = source_text.split("\n")
    var idx = 0
    while idx < lines.len():
        val trimmed = lines[idx].trim()
        if dynsmf_interface_line_is_exported(trimmed):
            rows.push(trimmed)
        idx = idx + 1
    rows.join("\n")

fn dynsmf_interface_hash_of_text(source_text: text) -> i64:
    runtime_text_hash_v1(dynsmf_interface_fingerprint(source_text))

fn dynsmf_interface_hash_current(source_path: text) -> i64:
    val content = file_read_nullable(source_path) ?? ""
    dynsmf_interface_hash_of_text(content)

fn dynsmf_interface_hash_stored(artifact_path: text) -> i64:
    val sidecar = dynsmf_ifacehash_path(artifact_path)
    if not file_exists(sidecar):
        return -1
    val raw = file_read_nullable(sidecar) ?? ""
    if raw == "":
        return -1
    raw.trim().to_i64() ?? -1

# Known size of the hollow stub currently emitted by `simple compile -o
# *.smf` for ANY input (doc/08_tracking/bug/seed_compile_smf_stub_fail_open_2026-07-17.md):
# valid `SMF\0` magic, a tiny code section, and a single `main` symbol, always
# exactly this many bytes.
val dynsmf_known_stub_byte_count: int = 219

# ponytail: honesty floor applied to EVERY manifest entry, not only ones with
# an empty `exports` list. Reason: the hollow stub already contains a literal
# `main` symbol (see bug doc), so an entry whose required witness is exactly
# ["main"] (fmt_tool, fix_tool, todo_scan today) would trivially "pass" a
# name-only check against the very stub this feature exists to catch. The
# size floor is therefore unconditional (ANDed with the name witness below,
# not just a fallback for exports:[]) — a real artifact is expected to carry
# more than a no-op stub's payload regardless of how many exports it lists.
# Upgrade path: once the Rust emitter fix lands, replace this heuristic with
# an exact real-payload check (e.g. a compile-receipt sidecar) that does not
# depend on the current stub's specific byte count.
fn dynsmf_artifact_size_exceeds_stub_floor(data: [u8]) -> bool:
    data.len() > dynsmf_known_stub_byte_count

fn dynsmf_artifact_witnesses_exports(entry: DynSmfManifestEntry, data: [u8]) -> bool:
    if not dynsmf_artifact_size_exceeds_stub_floor(data):
        return false
    smf_artifact_has_exports(data, entry.exports)

fn dynsmf_artifact_status_with_hash(entry: DynSmfManifestEntry, file_present: bool, data: [u8], source_path: text) -> DynSmfArtifactStatus:
    val base = dynsmf_artifact_status_from_bytes(entry, file_present, data)
    if not base.ready:
        return base
    # Stub-artifact honesty check runs right after the magic check and
    # before the abi/hash sidecar checks below: a hollow artifact (no
    # witnessed exports) is invalid regardless of how fresh its sidecars
    # look. This is exactly today's real-world failure mode — the 219-byte
    # stub passes magic validation and can carry freshly-written abi/srchash/
    # ifacehash sidecars, yet executes nothing.
    if not dynsmf_artifact_witnesses_exports(entry, data):
        return DynSmfArtifactStatus(library_id: base.library_id, path: base.path, ready: false, reason: "stub_artifact", byte_count: base.byte_count, magic_hex: base.magic_hex)
    # abi_version enforcement is fail-closed: a missing or mismatched `.abi`
    # sidecar means the artifact must never be treated as loadable, even if
    # the srchash/ifacehash sidecars still look fresh. It needs no source
    # path, so it runs before the source-path guard below.
    val stored_abi = dynsmf_abi_stored(entry.path)
    if stored_abi == "" or stored_abi != entry.abi_version:
        return DynSmfArtifactStatus(library_id: base.library_id, path: base.path, ready: false, reason: "abi_mismatch", byte_count: base.byte_count, magic_hex: base.magic_hex)
    if source_path == "":
        return base
    val stored = dynsmf_source_hash_stored(entry.path)
    if stored == -1:
        return DynSmfArtifactStatus(library_id: base.library_id, path: base.path, ready: false, reason: "stale_source", byte_count: base.byte_count, magic_hex: base.magic_hex)
    val current = dynsmf_source_hash_current(source_path)
    if current == stored:
        return base
    # Whole-source hash moved. Use the interface-hash sidecar to tell an
    # impl-only edit (module-only rebuild is sufficient) apart from an
    # exported-interface edit (dependents need a rebuild too). When the
    # ifacehash sidecar itself is absent we cannot make that distinction, so
    # fall back to the original generic "stale_source" reason.
    val stored_iface = dynsmf_interface_hash_stored(entry.path)
    if stored_iface == -1:
        return DynSmfArtifactStatus(library_id: base.library_id, path: base.path, ready: false, reason: "stale_source", byte_count: base.byte_count, magic_hex: base.magic_hex)
    val current_iface = dynsmf_interface_hash_current(source_path)
    if current_iface == stored_iface:
        return DynSmfArtifactStatus(library_id: base.library_id, path: base.path, ready: false, reason: "stale_impl", byte_count: base.byte_count, magic_hex: base.magic_hex)
    DynSmfArtifactStatus(library_id: base.library_id, path: base.path, ready: false, reason: "stale_interface", byte_count: base.byte_count, magic_hex: base.magic_hex)

fn dynsmf_artifact_status(entry: DynSmfManifestEntry) -> DynSmfArtifactStatus:
    dynsmf_artifact_snapshot_status(entry, dynsmf_artifact_snapshot(entry))

fn dynsmf_artifact_snapshot_from_bytes(entry: DynSmfManifestEntry, file_present: bool, data: [u8]) -> DynSmfArtifactSnapshot:
    DynSmfArtifactSnapshot(path: entry.path, data: data, file_present: file_present)

fn dynsmf_artifact_snapshot(entry: DynSmfManifestEntry) -> DynSmfArtifactSnapshot:
    val captured = dynsmf_snapshot_capture(entry.path)
    dynsmf_artifact_snapshot_from_bytes(entry, captured.1, captured.0)

fn dynsmf_artifact_snapshot_status(entry: DynSmfManifestEntry, snapshot: DynSmfArtifactSnapshot) -> DynSmfArtifactStatus:
    if snapshot.path != entry.path:
        return DynSmfArtifactStatus(library_id: entry.id, path: entry.path, ready: false, reason: "snapshot_path_mismatch", byte_count: snapshot.data.len(), magic_hex: dynsmf_artifact_magic_hex(snapshot.data))
    dynsmf_artifact_status_with_hash(entry, snapshot.file_present, snapshot.data, dynsmf_manifest_source_path(entry))

fn dynsmf_open_snapshot(entry: DynSmfManifestEntry, req: DynLoadRequest, next_handle: int, snapshot: DynSmfArtifactSnapshot) -> DynLoadResult:
    # Validate the captured bytes exactly once, then logically open that same
    # capture. No caller-supplied `ready` receipt can bypass validation.
    val request_error = dynsmf_snapshot_request_error(entry.path, req.search_path, snapshot.path)
    if request_error != "":
        return DynLoadResult.fail(req.library_name, request_error)
    val status = dynsmf_artifact_snapshot_status(entry, snapshot)
    if not status.ready:
        return DynLoadResult.fail(req.library_name, "artifact_" + status.reason)
    smf_dlopen_bytes(req, next_handle, snapshot.data)

fn dynsmf_open_captured_bytes(entry: DynSmfManifestEntry, req: DynLoadRequest, next_handle: int, file_present: bool, data: [u8]) -> DynLoadResult:
    dynsmf_open_snapshot(entry, req, next_handle, dynsmf_artifact_snapshot_from_bytes(entry, file_present, data))

fn dynsmf_checked_open_entry(entry: DynSmfManifestEntry, req: DynLoadRequest, next_handle: int) -> DynLoadResult:
    val snapshot = dynsmf_artifact_snapshot(entry)
    dynsmf_open_snapshot(entry, req, next_handle, snapshot)

fn dynsmf_artifacts_ready(manifest: [DynSmfManifestEntry]) -> bool:
    var idx = 0
    while idx < manifest.len():
        if not dynsmf_artifact_status(manifest[idx]).ready:
            return false
        idx = idx + 1
    true

fn dynsmf_session_record_background_compile_for_status(
    session: DynSmfSession,
    entry: DynSmfManifestEntry,
    plan: DynSmfBuildPlan,
    artifact: DynSmfArtifactStatus,
    record_ready: bool,
    record_disabled: bool
) -> DynSmfSession:
    var out = session
    if dynsmf_id_disabled(out.policy, entry.id):
        if record_disabled:
            out.evidence.push(DynSmfEvidenceRow(library_id: entry.id, action: dynsmf_background_compile_action(), policy_source: out.policy.source, status: "skipped", handle: 0, generation: out.generation, reason: "disabled"))
        return out
    if plan.status != "ready":
        out.evidence.push(DynSmfEvidenceRow(library_id: entry.id, action: dynsmf_background_compile_action(), policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "invalid_" + plan.reason))
        return out
    if artifact.ready:
        if record_ready:
            out.evidence.push(DynSmfEvidenceRow(library_id: entry.id, action: dynsmf_background_compile_action(), policy_source: out.policy.source, status: "skipped", handle: 0, generation: out.generation, reason: "artifact_ready"))
        return out
    out.evidence.push(DynSmfEvidenceRow(library_id: entry.id, action: dynsmf_background_compile_action(), policy_source: out.policy.source, status: "queued", handle: 0, generation: out.generation, reason: "queued:" + plan.command))
    out

fn _dynsmf_session_request_background_compiles_core(
    session: DynSmfSession,
    manifest: [DynSmfManifestEntry],
    statuses: [DynSmfArtifactStatus],
    record_ready: bool,
    record_disabled: bool,
    autoload_only: bool
) -> DynSmfSession:
    var out = session
    var idx = 0
    while idx < manifest.len():
        val entry = manifest[idx]
        if not autoload_only or entry.default_autoload:
            val plan = dynsmf_build_plan(entry)
            val artifact = if idx < statuses.len(): statuses[idx] else: dynsmf_artifact_status(entry)
            out = dynsmf_session_record_background_compile_for_status(out, entry, plan, artifact, record_ready, record_disabled)
        idx = idx + 1
    out

fn dynsmf_session_request_background_compiles_from_statuses(
    session: DynSmfSession,
    manifest: [DynSmfManifestEntry],
    statuses: [DynSmfArtifactStatus],
    record_ready: bool,
    record_disabled: bool
) -> DynSmfSession:
    _dynsmf_session_request_background_compiles_core(
        session, manifest, statuses, record_ready, record_disabled, false)

fn dynsmf_session_request_background_compiles(session: DynSmfSession, manifest: [DynSmfManifestEntry]) -> DynSmfSession:
    dynsmf_session_request_background_compiles_from_statuses(session, manifest, [], true, true)

fn dynsmf_session_queue_missing_background_compiles(session: DynSmfSession, manifest: [DynSmfManifestEntry]) -> DynSmfSession:
    # Startup only pre-warms entries that startup itself will autoload. On-demand
    # entries (default_autoload:false, e.g. toolchain entries invoked lazily by
    # their own callers) are excluded here so plain startup evidence/behavior does
    # not regress when new on-demand entries are added to the manifest. They still
    # get their own build plan (dynsmf_build_plan/dynsmf_build_plans) for an
    # explicit/manual compile; this function just does not auto-queue a background
    # compile for them on every ordinary startup.
    _dynsmf_session_request_background_compiles_core(
        session, manifest, [], false, false, true)

fn dynsmf_policy_default() -> DynSmfPolicy:
    val disabled_index: Dict<text, bool> = {}
    DynSmfPolicy(disabled_all: false, disabled_ids: [], source: "default",
        _disabled_id_index: disabled_index)

fn dynsmf_policy_from_args_env(args: [text], env_dynsmf: text, env_disable: text) -> DynSmfPolicy:
    var disabled_all = false
    var disabled_ids: [text] = []
    var source = "default"
    if env_dynsmf == "0":
        disabled_all = true
        source = "env:SIMPLE_DYNSMF"
    if env_disable != "":
        val ids = env_disable.split(",")
        var idx = 0
        while idx < ids.len():
            if ids[idx] != "":
                disabled_ids.push(ids[idx])
            idx = idx + 1
        source = "env:SIMPLE_DYNSMF_DISABLE"
    var arg_idx = 0
    while arg_idx < args.len():
        val arg = args[arg_idx]
        if arg == "--no-dynsmf":
            disabled_all = true
            source = "arg:--no-dynsmf"
        elif arg.starts_with("--disable-dynsmf="):
            val parts = arg.split("=")
            if parts.len() == 2:
                val ids = parts[1].split(",")
                var idx = 0
                while idx < ids.len():
                    if ids[idx] != "":
                        disabled_ids.push(ids[idx])
                    idx = idx + 1
                source = "arg:--disable-dynsmf"
        arg_idx = arg_idx + 1
    var disabled_index: Dict<text, bool> = {}
    for id in disabled_ids:
        disabled_index[id] = true
    DynSmfPolicy(disabled_all: disabled_all, disabled_ids: disabled_ids,
        source: source, _disabled_id_index: disabled_index)

fn _dynsmf_facet_binding_key(facet_id: text, library_id: text,
    export_symbol: text, interface_abi_hash: text, path: text,
    abi_version: text, pack_content_hash: text, artifact_content_hash: text) -> text:
    facet_id.len().to_text() + ":" + facet_id +
        library_id.len().to_text() + ":" + library_id +
        export_symbol.len().to_text() + ":" + export_symbol +
        interface_abi_hash.len().to_text() + ":" + interface_abi_hash +
        path.len().to_text() + ":" + path +
        abi_version.len().to_text() + ":" + abi_version +
        pack_content_hash.len().to_text() + ":" + pack_content_hash +
        artifact_content_hash.len().to_text() + ":" + artifact_content_hash

fn _dynsmf_revoke_library_facet_refs(session: DynSmfSession, library_id: text) -> DynSmfSession:
    var out = session
    if out._issued_facet_tokens_by_library.has(library_id):
        for token in out._issued_facet_tokens_by_library[library_id]:
            if out._issued_facet_refs.has(token):
                out._issued_facet_refs = out._issued_facet_refs.remove(token)
                out._issued_facet_ref_count = out._issued_facet_ref_count - 1
        out._issued_facet_tokens_by_library = out._issued_facet_tokens_by_library.remove(library_id)
    if out._trusted_facet_keys_by_library.has(library_id):
        for key in out._trusted_facet_keys_by_library[library_id]:
            out._trusted_facet_bindings = out._trusted_facet_bindings.remove(key)
        out._trusted_facet_keys_by_library = out._trusted_facet_keys_by_library.remove(library_id)
    out

fn dynsmf_session_new(session_id: text, policy: DynSmfPolicy) -> DynSmfSession:
    val issued: Dict<text, DynSmfIssuedFacetRef> = {}
    val issued_by_library: Dict<text, [text]> = {}
    val loaded_indices: Dict<text, i64> = {}
    val known_library_slots: Dict<text, i64> = {}
    val trusted_facet_bindings: Dict<text, DynSmfTrustedFacetBinding> = {}
    val trusted_facet_keys_by_library: Dict<text, [text]> = {}
    DynSmfSession(session_id: session_id, generation: 1, next_handle: 100,
        policy: policy, loaded: [], evidence: [], _next_facet_token: 1,
        _issued_facet_refs: issued,
        _issued_facet_tokens_by_library: issued_by_library,
        _issued_facet_ref_count: 0,
        _trusted_facet_bindings: trusted_facet_bindings,
        _trusted_facet_keys_by_library: trusted_facet_keys_by_library,
        _loaded_indices: loaded_indices,
        _known_library_slots: known_library_slots)

fn dynsmf_session_issued_facet_ref_count(session: DynSmfSession) -> i64:
    session._issued_facet_ref_count

fn _dynsmf_facet_token_key(session_id: text, sequence: i64) -> text:
    session_id.len().to_text() + ":" + session_id + ":" + sequence.to_text()

fn dynsmf_id_disabled(policy: DynSmfPolicy, id: text) -> bool:
    if policy.disabled_all:
        return true
    policy._disabled_id_index.has(id)

fn dynsmf_manifest_find(manifest: [DynSmfManifestEntry], id: text) -> DynSmfManifestEntry?:
    var idx = 0
    while idx < manifest.len():
        if manifest[idx].id == id:
            return manifest[idx]
        idx = idx + 1
    nil

fn dynsmf_symbol_registry(entry: DynSmfManifestEntry, handle: int) -> text:
    var rows: [text] = []
    var idx = 0
    while idx < entry.exports.len():
        rows.push(handle.to_text() + ":" + entry.exports[idx] + ":" + (idx + 1).to_text())
        idx = idx + 1
    rows.join(";")

fn dynsmf_session_add_evidence(session: DynSmfSession, row: DynSmfEvidenceRow) -> DynSmfSession:
    var out = session
    out.evidence.push(row)
    out

fn dynsmf_session_snapshot_bytes(data: [u8]) -> [u8]:
    var out: [u8] = []
    for byte in data:
        out.push(byte)
    out

fn dynsmf_session_manifest_identity(request: AspectPackLookupRequest, id: text) -> DynSmfManifestEntry?:
    var found: DynSmfManifestEntry? = nil
    var matches = 0
    for entry in request.manifest:
        if entry.id == id:
            found = entry
            matches = matches + 1
    if matches == 1:
        return found
    nil

fn _dynsmf_session_load_admitted_impl_v3(session: DynSmfSession, id: text,
        trusted_request: AspectPackLookupRequest, artifact_bytes: [u8],
        protect_physical: bool) -> DynSmfSession:
    """Map only the exact byte image retained by the trust-registry owner."""
    var out = session
    if dynsmf_id_disabled(out.policy, id):
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "skip", policy_source: out.policy.source, status: "skipped", handle: 0, generation: out.generation, reason: "disabled"))
    val artifact = trusted_request.artifact
    val entry = dynsmf_session_manifest_identity(trusted_request, id) ?? return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "manifest_artifact_identity_mismatch"))
    if artifact.library_id != id or artifact.path != entry.path or artifact.content_hash == "":
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "artifact_identity_invalid"))
    val exact_bytes = dynsmf_session_snapshot_bytes(artifact_bytes)
    if sha256_u8_hex(exact_bytes) != artifact.content_hash:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "artifact_content_hash_mismatch"))
    val parsed = aspect_pack_directory_parse_from_outer_smf_bytes(exact_bytes)
    if not parsed.ok:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "artifact_aspect_pack_invalid:" + parsed.error_code))
    val admission = aspect_pack_directory_validate_against_manifest(parsed.directory, trusted_request.catalog, trusted_request.manifest, artifact, trusted_request.export_contracts)
    if not admission.ok:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "trusted_aspect_admission_invalid:" + admission.error_code))
    var selected_module = ""
    var selected_matches = 0
    for facet in admission.facets:
        if facet.library_id == id and facet.facet_id == trusted_request.facet_id:
            selected_module = facet.module_id
            selected_matches = selected_matches + 1
    if selected_matches != 1:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "trusted_aspect_facet_ambiguous"))
    val pack = apk_open_pack_v1(parsed.payload)
    if not pack.ok:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "artifact_aspect_pack_open_failed:" + pack.error_code))
    val module = apk_load_module_v1(parsed.payload, pack, selected_module)
    if not module.ok or not module.found:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "artifact_aspect_module_load_failed:" + module.error_code))
    var already_loaded = false
    if out._loaded_indices.has(id):
        val existing = out.loaded[out._loaded_indices[id]]
        if existing.path == artifact.path and existing.abi_version == entry.abi_version and existing.content_hash == artifact.content_hash:
            already_loaded = true
        else:
            return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: existing.handle, generation: existing.generation, reason: "different_artifact_already_loaded"))
    var admitted_for_library = 0
    for facet in admission.facets:
        if facet.library_id == id:
            admitted_for_library = admitted_for_library + 1
    if admitted_for_library == 0:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "trusted_aspect_admission_empty"))
    if not already_loaded:
        val action = if out._known_library_slots.has(id): "reload" else: "load"
        if action == "reload":
            out = _dynsmf_revoke_library_facet_refs(out, id)
        val request = DynLoadRequest.lazy(id, artifact.path, out.session_id)
        val reserved_handle = smf_dynlib_next_available_handle(out.next_handle)
        if reserved_handle <= 0:
            return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "no_available_handle"))
        # `module.payload` was freshly extracted from the session-owned frozen
        # outer image; do not clone it again at the mapper boundary.
        val load = if protect_physical:
            smf_dlopen_frozen_exact_exports_protected_v3(
                request, reserved_handle, module.payload, entry.exports)
        else:
            smf_dlopen_frozen_exact_exports(request, reserved_handle, module.payload, entry.exports)
        if not load.success:
            return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load_admitted", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: load.error_msg))
        out.next_handle = reserved_handle + 1
        val published = DynSmfLoadedLibrary(id: id, handle: load.handle_id,
            generation: out.generation, status: "loaded", symbol_registry: "",
            path: artifact.path, abi_version: entry.abi_version,
            content_hash: artifact.content_hash)
        val slot = if out._known_library_slots.has(id):
            out._known_library_slots[id]
        else:
            out.loaded.len()
        if slot == out.loaded.len():
            out.loaded.push(published)
        else:
            out.loaded[slot] = published
        out._loaded_indices[id] = slot
        out._known_library_slots[id] = slot
        out.evidence.push(DynSmfEvidenceRow(library_id: id, action: action, policy_source: out.policy.source, status: "loaded", handle: load.handle_id, generation: out.generation, reason: "smf_dlopen_admitted"))
    if (not already_loaded and (not out._loaded_indices.has(id) or
        out.loaded[out._loaded_indices[id]].content_hash != artifact.content_hash)):
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(
            library_id: id, action: "load_admitted", policy_source: out.policy.source,
            status: "failed", handle: 0, generation: out.generation,
            reason: "internal_load_publication_missing"))
    for facet in admission.facets:
        if facet.library_id == id:
            val key = _dynsmf_facet_binding_key(
                facet.facet_id, facet.library_id, facet.export_symbol,
                facet.interface_abi_hash, artifact.path, facet.library_abi_version,
                facet.pack_content_hash, artifact.content_hash)
            if not out._trusted_facet_bindings.has(key):
                val binding = DynSmfTrustedFacetBinding(
                    facet_id: facet.facet_id, library_id: facet.library_id,
                    export_symbol: facet.export_symbol, interface_abi_hash: facet.interface_abi_hash,
                    path: artifact.path, abi_version: facet.library_abi_version,
                    pack_content_hash: facet.pack_content_hash, artifact_content_hash: artifact.content_hash)
                out._trusted_facet_bindings[key] = binding
                var library_keys: [text] = []
                if out._trusted_facet_keys_by_library.has(id):
                    library_keys = out._trusted_facet_keys_by_library[id]
                library_keys.push(key)
                out._trusted_facet_keys_by_library[id] = library_keys
    out

fn dynsmf_session_load_admitted(session: DynSmfSession, id: text,
        trusted_request: AspectPackLookupRequest,
        artifact_bytes: [u8]) -> DynSmfSession:
    _dynsmf_session_load_admitted_impl_v3(
        session, id, trusted_request, artifact_bytes, false)

fn _dynsmf_session_load_entry_impl(session: DynSmfSession, entry: DynSmfManifestEntry, id: text, require_artifact: bool) -> DynSmfSession:
    var out = session
    if dynsmf_id_disabled(out.policy, id):
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "skip", policy_source: out.policy.source, status: "skipped", handle: 0, generation: out.generation, reason: "disabled"))
    if out._loaded_indices.has(id):
        return out
    val request = DynLoadRequest.lazy(entry.id, entry.path, out.session_id)
    val load = if require_artifact: dynsmf_checked_open_entry(entry, request, out.next_handle) else: smf_dlopen(request, out.next_handle)
    if not load.success:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: id, action: "load", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: load.error_msg))
    val handle = load.handle_id
    val action = if out._known_library_slots.has(id): "reload" else: "load"
    out.next_handle = out.next_handle + 1
    val published = DynSmfLoadedLibrary(id: id, handle: handle,
        generation: out.generation, status: "loaded",
        symbol_registry: dynsmf_symbol_registry(entry, handle), path: entry.path,
        abi_version: entry.abi_version, content_hash: "")
    val slot = if out._known_library_slots.has(id):
        out._known_library_slots[id]
    else:
        out.loaded.len()
    if slot == out.loaded.len():
        out.loaded.push(published)
    else:
        out.loaded[slot] = published
    out._loaded_indices[id] = slot
    out._known_library_slots[id] = slot
    out.evidence.push(DynSmfEvidenceRow(library_id: id, action: action, policy_source: out.policy.source, status: "loaded", handle: handle, generation: out.generation, reason: "smf_dlopen"))
    out

fn dynsmf_session_load_impl(session: DynSmfSession, manifest: [DynSmfManifestEntry], id: text, require_artifact: bool) -> DynSmfSession:
    val entry = dynsmf_manifest_find(manifest, id) ?? return dynsmf_session_add_evidence(
        session, DynSmfEvidenceRow(library_id: id, action: "load",
            policy_source: session.policy.source, status: "failed", handle: 0,
            generation: session.generation, reason: "unknown_library"))
    _dynsmf_session_load_entry_impl(session, entry, id, require_artifact)

fn dynsmf_session_load(session: DynSmfSession, manifest: [DynSmfManifestEntry], id: text) -> DynSmfSession:
    dynsmf_session_load_impl(session, manifest, id, false)

fn dynsmf_session_load_checked(session: DynSmfSession, manifest: [DynSmfManifestEntry], id: text) -> DynSmfSession:
    dynsmf_session_load_impl(session, manifest, id, true)

fn _dynsmf_session_autoload_impl(session: DynSmfSession, manifest: [DynSmfManifestEntry], require_artifact: bool) -> DynSmfSession:
    var out = session
    var first_indices: Dict<text, i64> = {}
    var idx = 0
    while idx < manifest.len():
        val id = manifest[idx].id
        if not first_indices.has(id):
            first_indices[id] = idx
        if manifest[idx].default_autoload:
            val entry = manifest[first_indices[id]]
            out = _dynsmf_session_load_entry_impl(out, entry, id, require_artifact)
        idx = idx + 1
    out

fn dynsmf_session_autoload(session: DynSmfSession, manifest: [DynSmfManifestEntry]) -> DynSmfSession:
    _dynsmf_session_autoload_impl(session, manifest, false)

fn dynsmf_session_autoload_checked(session: DynSmfSession, manifest: [DynSmfManifestEntry]) -> DynSmfSession:
    _dynsmf_session_autoload_impl(session, manifest, true)

fn dynsmf_session_find_loaded(session: DynSmfSession, id: text) -> DynSmfLoadedLibrary?:
    if session._loaded_indices.has(id):
        val lib = session.loaded[session._loaded_indices[id]]
        if lib.status == "loaded":
            return lib
    nil

fn _dynsmf_facet_lease_none(session: DynSmfSession) -> DynSmfFacetLease:
    DynSmfFacetLease(session: session, facet_ref: nil)

fn _dynsmf_session_first_use_facet_admitted_impl_v3(session: DynSmfSession,
        id: text, request: AspectPackLookupRequest, artifact_bytes: [u8],
        protect_physical: bool) -> DynSmfFacetLease:
    """Load an OS-admitted aspect image exactly once, then issue its typed facet lease.

    The cache-hit path does not copy, hash, parse, or remap `artifact_bytes`.
    Exact artifact identity is checked against the request manifest and live
    generation before delegating to the facet capability validator.
    """
    if id == "" or request.facet_id == "":
        return _dynsmf_facet_lease_none(session)
    val entry = dynsmf_session_manifest_identity(request, id) ?? return _dynsmf_facet_lease_none(session)
    val artifact = request.artifact
    if artifact.library_id != id or artifact.path != entry.path or artifact.content_hash == "":
        return _dynsmf_facet_lease_none(session)
    if session._loaded_indices.has(id):
        val library = session.loaded[session._loaded_indices[id]]
        if (library.status != "loaded" or library.path != artifact.path or
            library.abi_version != entry.abi_version or
            library.content_hash != artifact.content_hash):
            return _dynsmf_facet_lease_none(session)
        return dynsmf_session_lookup_facet(session, request)
    val loaded = _dynsmf_session_load_admitted_impl_v3(
        session, id, request, artifact_bytes, protect_physical)
    dynsmf_session_lookup_facet(loaded, request)

fn dynsmf_session_first_use_facet_admitted(session: DynSmfSession, id: text,
        request: AspectPackLookupRequest,
        artifact_bytes: [u8]) -> DynSmfFacetLease:
    _dynsmf_session_first_use_facet_admitted_impl_v3(
        session, id, request, artifact_bytes, false)

# Internal B-owner handoff. The physical C owner protects the newly published
# handle before releasing its gate, closing the legacy-close race at first use.
fn dynsmf_session_first_use_facet_admitted_protected_v3(
        session: DynSmfSession, id: text, request: AspectPackLookupRequest,
        artifact_bytes: [u8]) -> DynSmfFacetLease:
    _dynsmf_session_first_use_facet_admitted_impl_v3(
        session, id, request, artifact_bytes, true)

fn dynsmf_session_lookup_facet(session: DynSmfSession, request: AspectPackLookupRequest) -> DynSmfFacetLease:
    if session.session_id == "" or request.facet_id == "":
        return _dynsmf_facet_lease_none(session)
    val admission = aspect_pack_directory_validate_against_manifest(
        request.directory, request.catalog, request.manifest,
        request.artifact, request.export_contracts)
    if not admission.ok:
        return _dynsmf_facet_lease_none(session)
    var matches = 0
    var library_id = ""
    var export_symbol = ""
    var interface_abi_hash = ""
    var pack_content_hash = ""
    var library_abi_version = ""
    for facet in admission.facets:
        if facet.facet_id == request.facet_id:
            matches = matches + 1
            library_id = facet.library_id
            export_symbol = facet.export_symbol
            interface_abi_hash = facet.interface_abi_hash
            pack_content_hash = facet.pack_content_hash
            library_abi_version = facet.library_abi_version
    if matches != 1:
        return _dynsmf_facet_lease_none(session)
    val trusted_key = _dynsmf_facet_binding_key(
        request.facet_id, library_id, export_symbol, interface_abi_hash,
        request.artifact.path, library_abi_version, pack_content_hash,
        request.artifact.content_hash)
    if not session._trusted_facet_bindings.has(trusted_key):
        return _dynsmf_facet_lease_none(session)
    val trusted = session._trusted_facet_bindings[trusted_key]
    if (trusted.facet_id != request.facet_id or trusted.library_id != library_id or
        trusted.export_symbol != export_symbol or
        trusted.interface_abi_hash != interface_abi_hash or
        trusted.path != request.artifact.path or
        trusted.abi_version != library_abi_version or
        trusted.pack_content_hash != pack_content_hash or
        trusted.artifact_content_hash != request.artifact.content_hash):
        return _dynsmf_facet_lease_none(session)
    if not session._loaded_indices.has(library_id):
        return _dynsmf_facet_lease_none(session)
    val library = session.loaded[session._loaded_indices[library_id]]
    if (library.status != "loaded" or library.path != request.artifact.path or
        library.abi_version != library_abi_version or
        library.content_hash != request.artifact.content_hash or
        not smf_dlsym(library.handle, export_symbol, library.symbol_registry).found):
        return _dynsmf_facet_lease_none(session)
    if session._issued_facet_ref_count >= DYNSMF_FACET_REF_MAX_ISSUED:
        return _dynsmf_facet_lease_none(session)
    if session._next_facet_token <= 0 or session._next_facet_token > DYNSMF_FACET_TOKEN_MAX:
        return _dynsmf_facet_lease_none(session)
    var out = session
    val sequence = out._next_facet_token
    val token = _dynsmf_facet_token_key(out.session_id, sequence)
    if out._issued_facet_refs.contains_key(token):
        return _dynsmf_facet_lease_none(session)
    out._next_facet_token = if sequence == DYNSMF_FACET_TOKEN_MAX: 0 else: sequence + 1
    out._issued_facet_refs[token] = DynSmfIssuedFacetRef(
        facet_id: request.facet_id, library_id: library_id, export_symbol: export_symbol,
        handle: library.handle, generation: library.generation, session_id: session.session_id,
        interface_abi_hash: interface_abi_hash, path: request.artifact.path,
        abi_version: library_abi_version, content_hash: request.artifact.content_hash)
    var library_tokens: [text] = []
    if out._issued_facet_tokens_by_library.has(library_id):
        library_tokens = out._issued_facet_tokens_by_library[library_id]
    library_tokens.push(token)
    out._issued_facet_tokens_by_library[library_id] = library_tokens
    out._issued_facet_ref_count = out._issued_facet_ref_count + 1
    DynSmfFacetLease(session: out, facet_ref: DynSmfFacetRef(token: token))

fn dynsmf_session_validate_facet_ref(session: DynSmfSession, facet_ref: DynSmfFacetRef) -> bool:
    if facet_ref.token == "" or not session._issued_facet_refs.contains_key(facet_ref.token):
        return false
    val issued = session._issued_facet_refs[facet_ref.token]
    if issued.session_id != session.session_id or issued.handle <= 0 or issued.generation <= 0:
        return false
    if (issued.facet_id == "" or issued.library_id == "" or issued.export_symbol == "" or
        issued.interface_abi_hash == "" or issued.path == "" or issued.abi_version == "" or
        issued.content_hash == ""):
        return false
    if not session._loaded_indices.has(issued.library_id):
        return false
    val library = session.loaded[session._loaded_indices[issued.library_id]]
    library.status == "loaded" and library.handle == issued.handle and
        library.generation == issued.generation and library.path == issued.path and
        library.abi_version == issued.abi_version and
        library.content_hash == issued.content_hash and
        smf_dlsym(library.handle, issued.export_symbol, library.symbol_registry).found

fn dynsmf_session_release_facet_ref_v3(session: DynSmfSession,
        facet_ref: DynSmfFacetRef) -> DynSmfSession:
    """Consume exactly one issued facet reference without closing its library.

    The loader-owned V3 close authority uses this only after it has made the
    library Closing and drained every non-final query.  Keeping the library
    live here prevents a reference release from becoming a hidden dlclose.
    """
    if facet_ref.token == "" or not session._issued_facet_refs.has(facet_ref.token):
        return session
    var out = session
    val issued = out._issued_facet_refs[facet_ref.token]
    out._issued_facet_refs = out._issued_facet_refs.remove(facet_ref.token)
    if out._issued_facet_ref_count > 0:
        out._issued_facet_ref_count = out._issued_facet_ref_count - 1
    if out._issued_facet_tokens_by_library.has(issued.library_id):
        var retained: [text] = []
        for token in out._issued_facet_tokens_by_library[issued.library_id]:
            if token != facet_ref.token:
                retained.push(token)
        if retained.len() == 0:
            out._issued_facet_tokens_by_library =
                out._issued_facet_tokens_by_library.remove(issued.library_id)
        else:
            out._issued_facet_tokens_by_library[issued.library_id] = retained
    out

fn dynsmf_session_symbol(session: DynSmfSession, id: text, symbol: text) -> DynSmfEvidenceRow:
    if session._loaded_indices.has(id):
        val lib = session.loaded[session._loaded_indices[id]]
        if lib.status == "loaded":
            val sym = smf_dlsym(lib.handle, symbol, lib.symbol_registry)
            if sym.found:
                return DynSmfEvidenceRow(library_id: id, action: "symbol", policy_source: session.policy.source, status: "ok", handle: lib.handle, generation: lib.generation, reason: symbol + "@" + sym.offset.to_text())
            return DynSmfEvidenceRow(library_id: id, action: "symbol", policy_source: session.policy.source, status: "missing", handle: lib.handle, generation: lib.generation, reason: sym.error_msg)
    DynSmfEvidenceRow(library_id: id, action: "symbol", policy_source: session.policy.source, status: "stale", handle: 0, generation: session.generation, reason: "unloaded")

fn dynsmf_session_record_symbol(session: DynSmfSession, id: text, symbol: text) -> DynSmfSession:
    dynsmf_session_add_evidence(session, dynsmf_session_symbol(session, id, symbol))

fn dynsmf_session_unload(session: DynSmfSession, id: text) -> DynSmfSession:
    var out = session
    if not out._loaded_indices.has(id):
        out.evidence.push(DynSmfEvidenceRow(library_id: id, action: "unload", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "not_loaded"))
        return out
    val slot = out._loaded_indices[id]
    val lib = out.loaded[slot]
    val close = smf_dlclose(lib.handle)
    if not close.success:
        out.evidence.push(DynSmfEvidenceRow(library_id: id, action: "unload", policy_source: out.policy.source, status: "failed", handle: lib.handle, generation: out.generation, reason: close.error_msg))
        out.evidence.push(DynSmfEvidenceRow(library_id: id, action: "unload", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "not_loaded"))
        return out
    out.loaded[slot] = DynSmfLoadedLibrary(id: lib.id, handle: lib.handle,
        generation: lib.generation, status: "unloaded", symbol_registry: "",
        path: lib.path, abi_version: lib.abi_version, content_hash: lib.content_hash)
    out.generation = out.generation + 1
    out.evidence.push(DynSmfEvidenceRow(library_id: id, action: "unload",
        policy_source: out.policy.source, status: "unloaded", handle: lib.handle,
        generation: out.generation, reason: "smf_dlclose"))
    out._loaded_indices = out._loaded_indices.remove(id)
    _dynsmf_revoke_library_facet_refs(out, id)

# --- Phase B: config-driven dynload settings (presence/placement/activation) ---
# Three independent axes per research doc §5.1/§5.3/§5.4, expressed as
# val-constant text dispatch (not payload enums). The settings layer is an
# OVERLAY keyed by library_id so the existing DynSmfManifestEntry constructor
# contract (and every existing spec that builds entries) stays unchanged.
# Back-compat mapping: default_autoload:false == presence=auto +
# activation=first_use; default_autoload:true == presence=auto +
# activation=startup. Placement defaults to auto either way.

fn dynsmf_presence_off() -> text:
    "off"
fn dynsmf_presence_auto() -> text:
    "auto"
fn dynsmf_presence_on() -> text:
    "on"

fn dynsmf_placement_auto() -> text:
    "auto"
fn dynsmf_placement_static() -> text:
    "static"
fn dynsmf_placement_dynamic() -> text:
    "dynamic"

fn dynsmf_activation_startup() -> text:
    "startup"
fn dynsmf_activation_command() -> text:
    "command"
fn dynsmf_activation_first_use() -> text:
    "first_use"
fn dynsmf_activation_manual() -> text:
    "manual"

fn dynsmf_outcome_absent() -> text:
    "absent"
fn dynsmf_outcome_static() -> text:
    "static"
fn dynsmf_outcome_dynamic() -> text:
    "dynamic"
fn dynsmf_outcome_error() -> text:
    "error"

class DynSmfDynloadSetting:
    library_id: text
    presence: text
    placement: text
    activation: text

class DynSmfDynloadParse:
    ok: bool
    reason: text
    setting: DynSmfDynloadSetting

class DynSmfDynloadDecision:
    library_id: text
    outcome: text
    activation: text
    reason: text

    me to_text() -> text:
        return self.library_id + ":" + self.outcome + ":" + self.activation + ":" + self.reason

fn dynsmf_presence_valid(v: text) -> bool:
    v == dynsmf_presence_off() or v == dynsmf_presence_auto() or v == dynsmf_presence_on()

fn dynsmf_placement_valid(v: text) -> bool:
    v == dynsmf_placement_auto() or v == dynsmf_placement_static() or v == dynsmf_placement_dynamic()

fn dynsmf_activation_valid(v: text) -> bool:
    v == dynsmf_activation_startup() or v == dynsmf_activation_command() or
        v == dynsmf_activation_first_use() or v == dynsmf_activation_manual()

fn dynsmf_dynload_setting_default(entry: DynSmfManifestEntry) -> DynSmfDynloadSetting:
    val activation = if entry.default_autoload: dynsmf_activation_startup() else: dynsmf_activation_first_use()
    DynSmfDynloadSetting(library_id: entry.id, presence: dynsmf_presence_auto(), placement: dynsmf_placement_auto(), activation: activation)

# Parse a comma-separated `key=value` axis spec, e.g.
# "presence=off,placement=dynamic,activation=manual". Omitted axes keep the
# entry's back-compat defaults. Unknown keys and unknown values are hard
# parse failures (fail closed, no silent fallback to a default axis value).
fn dynsmf_dynload_setting_parse(entry: DynSmfManifestEntry, spec: text) -> DynSmfDynloadParse:
    var setting = dynsmf_dynload_setting_default(entry)
    val trimmed_spec = spec.trim()
    if trimmed_spec == "":
        return DynSmfDynloadParse(ok: true, reason: "defaults", setting: setting)
    val parts = trimmed_spec.split(",")
    var idx = 0
    while idx < parts.len():
        val part = parts[idx].trim()
        if part != "":
            val kv = part.split("=")
            if kv.len() != 2:
                return DynSmfDynloadParse(ok: false, reason: "malformed_axis:" + part, setting: setting)
            val key = kv[0].trim()
            val value = kv[1].trim()
            if key == "presence":
                if not dynsmf_presence_valid(value):
                    return DynSmfDynloadParse(ok: false, reason: "unknown_presence:" + value, setting: setting)
                setting.presence = value
            elif key == "placement":
                if not dynsmf_placement_valid(value):
                    return DynSmfDynloadParse(ok: false, reason: "unknown_placement:" + value, setting: setting)
                setting.placement = value
            elif key == "activation":
                if not dynsmf_activation_valid(value):
                    return DynSmfDynloadParse(ok: false, reason: "unknown_activation:" + value, setting: setting)
                setting.activation = value
            else:
                return DynSmfDynloadParse(ok: false, reason: "unknown_axis:" + key, setting: setting)
        idx = idx + 1
    DynSmfDynloadParse(ok: true, reason: "parsed", setting: setting)

fn dynsmf_dynload_setting_find(settings: [DynSmfDynloadSetting], id: text) -> DynSmfDynloadSetting?:
    var idx = 0
    while idx < settings.len():
        if settings[idx].library_id == id:
            return settings[idx]
        idx = idx + 1
    nil

# Resolution per research doc §5.3. static_impl_hash / configured_impl_hash
# use -1 as "unknown"; an unknown configured hash can never certify a static
# fold, so placement=auto falls through to dynamic (fail toward the external
# artifact, never toward a stale static pick). Unknown axis values resolve to
# an ERROR outcome — never to a silent default.
fn dynsmf_resolve_dynload(setting: DynSmfDynloadSetting, static_present: bool, static_impl_hash: i64, configured_impl_hash: i64) -> DynSmfDynloadDecision:
    if not dynsmf_presence_valid(setting.presence):
        return DynSmfDynloadDecision(library_id: setting.library_id, outcome: dynsmf_outcome_error(), activation: setting.activation, reason: "unknown_presence:" + setting.presence)
    if not dynsmf_placement_valid(setting.placement):
        return DynSmfDynloadDecision(library_id: setting.library_id, outcome: dynsmf_outcome_error(), activation: setting.activation, reason: "unknown_placement:" + setting.placement)
    if not dynsmf_activation_valid(setting.activation):
        return DynSmfDynloadDecision(library_id: setting.library_id, outcome: dynsmf_outcome_error(), activation: setting.activation, reason: "unknown_activation:" + setting.activation)
    if setting.presence == dynsmf_presence_off():
        return DynSmfDynloadDecision(library_id: setting.library_id, outcome: dynsmf_outcome_absent(), activation: setting.activation, reason: "presence_off")
    val static_hash_matches = static_present and configured_impl_hash != -1 and static_impl_hash == configured_impl_hash
    if setting.placement == dynsmf_placement_static():
        if not static_present:
            return DynSmfDynloadDecision(library_id: setting.library_id, outcome: dynsmf_outcome_error(), activation: setting.activation, reason: "static_required_missing")
        if not static_hash_matches:
            return DynSmfDynloadDecision(library_id: setting.library_id, outcome: dynsmf_outcome_error(), activation: setting.activation, reason: "static_required_stale")
        return DynSmfDynloadDecision(library_id: setting.library_id, outcome: dynsmf_outcome_static(), activation: setting.activation, reason: "static_pinned")
    if setting.placement == dynsmf_placement_dynamic():
        return DynSmfDynloadDecision(library_id: setting.library_id, outcome: dynsmf_outcome_dynamic(), activation: setting.activation, reason: "dynamic_pinned")
    if static_hash_matches:
        return DynSmfDynloadDecision(library_id: setting.library_id, outcome: dynsmf_outcome_static(), activation: setting.activation, reason: "auto_static_match")
    DynSmfDynloadDecision(library_id: setting.library_id, outcome: dynsmf_outcome_dynamic(), activation: setting.activation, reason: "auto_dynamic")

# Build the load plan for a manifest under a settings overlay. presence=off
# entries (e.g. an aspect log/trace pack) contribute ZERO plan rows — no
# registration residue at all. Error decisions ARE kept in the plan so a
# misconfigured entry is visible and fail-closed rather than silently loaded.
fn dynsmf_dynload_load_plan(manifest: [DynSmfManifestEntry], settings: [DynSmfDynloadSetting]) -> [DynSmfDynloadDecision]:
    var plan: [DynSmfDynloadDecision] = []
    var idx = 0
    while idx < manifest.len():
        val entry = manifest[idx]
        val found = dynsmf_dynload_setting_find(settings, entry.id)
        var setting = dynsmf_dynload_setting_default(entry)
        if found.?:
            setting = found!
        # No static table exists for dynSMF entries today: every entry is an
        # external precompiled artifact, so static_present=false and hashes
        # are unknown. placement=auto therefore resolves dynamic; a future
        # static-table provider passes real values via dynsmf_resolve_dynload.
        val decision = dynsmf_resolve_dynload(setting, false, -1, -1)
        if decision.outcome != dynsmf_outcome_absent():
            plan.push(decision)
        idx = idx + 1
    plan

fn dynsmf_dynload_plan_has_errors(plan: [DynSmfDynloadDecision]) -> bool:
    var idx = 0
    while idx < plan.len():
        if plan[idx].outcome == dynsmf_outcome_error():
            return true
        idx = idx + 1
    false

