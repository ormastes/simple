use std.common.string_core.{bytes_to_text}
use compiler.backend.linker.smf_reader_memory.{
    SmfReaderMemory,
    bytes_to_u32,
    bytes_to_u64
}
use compiler.loader.segment_mapper.{SegmentMapper}
use compiler.loader.smf_mmap_native.{
    native_reloc_write_i32,
    native_reloc_write_i64
}
use os.smf.host_target.{smf_target_is_host_compatible}
use std.common.structural.parallel_commit.executable_mapping_receipt.{
    ExecutableMappingReleaseOutcomeV1,
    ExecutableMappingReceiptV1,
    ExecutableMappingReleaseResultV1,
    executable_mapping_receipt_v1_same_identity,
    executable_mapping_release_result_v1,
}
use std.nogc_sync_mut.atomic.{AtomicI64, MemoryOrdering, atomic_i64_new}
use std.nogc_sync_mut.concurrent.thread.{thread_yield}

class LibraryRole:
    role_name: text
    is_pic: bool
    load_priority: int
    version: int

    me is_runtime() -> bool:
        return me.role_name == "runtime"

    me is_plugin() -> bool:
        return me.role_name == "plugin"

    me to_text() -> text:
        return "role:" + me.role_name + " pic=" + me.is_pic.to_text() + " v" + me.version.to_text()

    static fn runtime(ver: int) -> LibraryRole:
        return LibraryRole(role_name: "runtime", is_pic: true, load_priority: 0, version: ver)

    static fn plugin(ver: int) -> LibraryRole:
        return LibraryRole(role_name: "plugin", is_pic: true, load_priority: 10, version: ver)


class LinkNamespace:
    namespace_name: text
    process_id: int
    lib_count: int
    is_global: bool

    me is_process_local() -> bool:
        return me.is_global == false

    me to_text() -> text:
        return "ns:" + me.namespace_name + " pid=" + me.process_id.to_text() + " libs=" + me.lib_count.to_text()

    me add_lib() -> LinkNamespace:
        return LinkNamespace(namespace_name: me.namespace_name, process_id: me.process_id, lib_count: me.lib_count + 1, is_global: me.is_global)

    static fn global_ns() -> LinkNamespace:
        return LinkNamespace(namespace_name: "global", process_id: 0, lib_count: 0, is_global: true)

    static fn process_ns(name: text, pid: int) -> LinkNamespace:
        return LinkNamespace(namespace_name: name, process_id: pid, lib_count: 0, is_global: false)


class DynLoadRequest:
    library_name: text
    search_path: text
    load_mode: text
    namespace_ref: text

    me is_lazy() -> bool:
        return me.load_mode == "lazy"

    me is_eager() -> bool:
        return me.load_mode == "eager"

    me to_text() -> text:
        return "load:" + me.library_name + " mode=" + me.load_mode + " ns=" + me.namespace_ref

    static fn lazy(name: text, path: text, ns: text) -> DynLoadRequest:
        return DynLoadRequest(library_name: name, search_path: path, load_mode: "lazy", namespace_ref: ns)

    static fn eager(name: text, path: text, ns: text) -> DynLoadRequest:
        return DynLoadRequest(library_name: name, search_path: path, load_mode: "eager", namespace_ref: ns)


class DynLoadResult:
    library_name: text
    success: bool
    handle_id: int
    error_msg: text

    me is_loaded() -> bool:
        return me.success

    me is_error() -> bool:
        return me.success == false

    me to_text() -> text:
        if me.success:
            return "loaded:" + me.library_name + " handle=" + me.handle_id.to_text()
        return "error:" + me.library_name + " " + me.error_msg

    static fn ok(name: text, handle: int) -> DynLoadResult:
        return DynLoadResult(library_name: name, success: true, handle_id: handle, error_msg: "")

    static fn fail(name: text, err: text) -> DynLoadResult:
        return DynLoadResult(library_name: name, success: false, handle_id: 0, error_msg: err)

class DynSymResult:
    """Result of a symbol lookup in a loaded dynamic library.

    `offset` is retained for source compatibility. On success it contains
    the real mapped symbol address, never a manifest-derived offset.
    """
    symbol_name: text
    found: bool
    offset: int
    error_msg: text

    me is_found() -> bool:
        return me.found

    me to_text() -> text:
        if me.found:
            return "sym:" + me.symbol_name + " address=" + me.offset.to_text()
        return "sym-error:" + me.symbol_name + " " + me.error_msg

    static fn ok(name: text, off: int) -> DynSymResult:
        return DynSymResult(symbol_name: name, found: true, offset: off, error_msg: "")

    static fn fail(name: text, err: text) -> DynSymResult:
        return DynSymResult(symbol_name: name, found: false, offset: 0, error_msg: err)


class DynCloseResult:
    """Result of closing a dynamic library handle."""
    handle_id: int
    success: bool
    error_msg: text

    me is_ok() -> bool:
        return me.success

    me to_text() -> text:
        if me.success:
            return "closed:handle=" + me.handle_id.to_text()
        return "close-error:handle=" + me.handle_id.to_text() + " " + me.error_msg

    static fn ok(handle: int) -> DynCloseResult:
        return DynCloseResult(handle_id: handle, success: true, error_msg: "")

    static fn fail(handle: int, err: text) -> DynCloseResult:
        return DynCloseResult(handle_id: handle, success: false, error_msg: err)


# ============================================================================
# Admitted-byte SMF loader
#
# The caller owns identity/digest/ABI admission. This module owns executable
# loading. It never opens `search_path`: every parsed and mapped byte comes
# from the exact `admitted_bytes` value.
#
# SegmentMapper is the canonical loader W^X owner. A candidate remains RW
# through copy and relocation, is sealed RX once, and is published only after
# every seal succeeds.
# ============================================================================

val SMF_DYNLIB_HEADER_SIZE: i64 = 128
val SMF_DYNLIB_SECTION_SIZE: i64 = 64
val SMF_DYNLIB_SYMBOL_SIZE: i64 = 56
val SMF_DYNLIB_RELOC_SIZE: i64 = 24
val SMF_DYNLIB_MAX_SECTIONS: i64 = 4096
val SMF_DYNLIB_RELEASE_NATIVE_BUDGET_V3: i64 = 4095
val SMF_DYNLIB_MAX_SYMBOLS: i64 = 65536
val SMF_DYNLIB_I64_MAX: i64 = 9223372036854775807
val SMF_DYNLIB_I64_MIN: i64 = -9223372036854775807 - 1
val SMF_DYNLIB_I32_MIN: i64 = -2147483648
val SMF_DYNLIB_I32_MAX: i64 = 2147483647

struct DynSmfSection:
    index: i32
    wire_type: i32
    flags: i64
    file_offset: i64
    size: i64
    alignment: i64

struct DynSmfWireSymbol:
    name: text
    section_index: i32
    offset: i64
    size: i64
    exported: bool

struct DynSmfRelocation:
    offset: i64
    symbol_index: i64
    reloc_type: i32
    addend: i64

struct DynSmfValidatedArtifact:
    sections: [DynSmfSection]
    symbols: [DynSmfWireSymbol]
    relocations: [DynSmfRelocation]
    code_sections: [i32]

struct DynSmfLoadedLibrary:
    library_name: text
    owner_id: text
    exports: Dict<text, i64>
    mapping_receipts: [ExecutableMappingReceiptV1]
    # Canonical per-handle progress survives mapper terminal-ring churn until
    # the whole batch is complete. One slot corresponds to one receipt.
    released_receipts: [bool]
    release_attempt_ids: [i64]
    remaining_segments: i32
    close_pending: bool

class DynSmfMappingObservationV1:
    ok: bool
    reason: text
    handle_id: int
    mapper_instance_id: text
    mapping_receipts: [ExecutableMappingReceiptV1]

class DynSmfMappingReleaseV1:
    ok: bool
    reason: text
    handle_id: int
    results: [ExecutableMappingReleaseResultV1]
    attempted_count: i64
    fully_released: bool

# V3 keeps native completion in the dynlib owner. Public code receives only
# this owner-resolved coordinate, never mutable success/retry booleans.
struct DynSmfReleaseAttemptV3:
    opaque_attempt: i64

class DynSmfReleaseAttemptObservationV3:
    ok: bool
    reason: text
    handle_id: int
    attempt: DynSmfReleaseAttemptV3
    physical_complete: bool
    retryable: bool
    acknowledged: bool

class _DynSmfReleaseAttemptRowV3:
    attempt_id: i64
    handle_id: int
    completion: DynSmfMappingReleaseV1
    acknowledged: bool

var DYNSMF_MAPPER: SegmentMapper = SegmentMapper.new()
var DYNSMF_LIBRARIES: Dict<int, DynSmfLoadedLibrary> = {}
var DYNSMF_NEXT_HANDLE_HINT: int = 1
var _dynsmf_release_attempt_rows_v3: Dict<i64, _DynSmfReleaseAttemptRowV3> = {}
var _dynsmf_release_attempt_by_handle_v3: Dict<int, i64> = {}
var _dynsmf_release_next_attempt_v3: i64 = 1
var _dynsmf_owner_protected_handles_v3: Dict<int, bool> = {}
var _dynsmf_owner_release_armed_handles_v3: Dict<int, bool> = {}
val SMF_DYNLIB_OWNER_GATE_WAIT_V3: i64 = 65536
var _dynsmf_owner_gate_v3: AtomicI64 = atomic_i64_new(0)

fn _smf_dynlib_owner_enter_v3() -> bool:
    var waits: i64 = 0
    while waits < SMF_DYNLIB_OWNER_GATE_WAIT_V3:
        if _dynsmf_owner_gate_v3.compare_exchange(
                0, 1, MemoryOrdering.AcqRel, MemoryOrdering.Acquire):
            return true
        thread_yield()
        waits = waits + 1
    false

fn _smf_dynlib_owner_exit_v3() -> bool:
    _dynsmf_owner_gate_v3.compare_exchange(
        1, 0, MemoryOrdering.AcqRel, MemoryOrdering.Acquire)

# Internal B->C owner port. Protection is established atomically at load, but
# native release remains impossible until the exact dynSMF close reservation
# has entered Closing and reached its final retained query.
fn _smf_dynlib_arm_release_handle_v3(handle_id: int) -> bool:
    if not _smf_dynlib_owner_enter_v3():
        return false
    if (handle_id <= 0 or not DYNSMF_LIBRARIES.has(handle_id) or
            not _dynsmf_owner_protected_handles_v3.has(handle_id)):
        _ = _smf_dynlib_owner_exit_v3()
        return false
    _dynsmf_owner_release_armed_handles_v3[handle_id] = true
    _smf_dynlib_owner_exit_v3()

fn _smf_dynlib_next_available_handle_locked_v3(seed: int) -> int:
    val requested = if seed > 0: seed else: 1
    var candidate = if DYNSMF_NEXT_HANDLE_HINT > requested:
        DYNSMF_NEXT_HANDLE_HINT
    else:
        requested
    while DYNSMF_LIBRARIES.has(candidate):
        candidate = candidate + 1
        if candidate <= 0:
            return 0
    candidate

pub fn smf_dynlib_next_available_handle(seed: int) -> int:
    if not _smf_dynlib_owner_enter_v3():
        return 0
    val handle_id = _smf_dynlib_next_available_handle_locked_v3(seed)
    _ = _smf_dynlib_owner_exit_v3()
    handle_id

fn smf_dynlib_request_error(req: DynLoadRequest, next_handle: int) -> text:
    if req.library_name == "":
        return "empty library name"
    if req.search_path == "":
        return "empty search path"
    if not req.search_path.ends_with(".smf"):
        return "not an smf artifact"
    if next_handle <= 0:
        return "invalid handle seed"
    if DYNSMF_LIBRARIES.has(next_handle):
        return "handle already loaded"
    ""

fn smf_dynlib_range_valid(start: i64, size: i64, total: i64) -> bool:
    start >= 0 and size >= 0 and start <= total and size <= total - start

fn smf_dynlib_ranges_overlap(a_start: i64, a_size: i64, b_start: i64, b_size: i64) -> bool:
    a_size > 0 and b_size > 0 and a_start < b_start + b_size and b_start < a_start + a_size

fn smf_dynlib_magic_at(data: [u8], offset: i64) -> bool:
    smf_dynlib_range_valid(offset, 4, data.len()) and
        data[offset] == 83 and data[offset + 1] == 77 and
        data[offset + 2] == 70 and data[offset + 3] == 0

fn smf_dynlib_header_offset(data: [u8]) -> i64:
    if data.len() < SMF_DYNLIB_HEADER_SIZE:
        return -1
    val trailer = data.len() - SMF_DYNLIB_HEADER_SIZE
    val leading_magic = smf_dynlib_magic_at(data, 0)
    val trailer_magic = smf_dynlib_magic_at(data, trailer)
    if leading_magic and trailer_magic and trailer != 0:
        return -2
    if leading_magic:
        return 0
    if trailer_magic:
        return trailer
    -1

fn smf_dynlib_nonnegative_u64(data: [u8], offset: i64, field: text) -> Result<i64, text>:
    if not smf_dynlib_range_valid(offset, 8, data.len()):
        return Err("{field} is truncated")
    if ((data[offset + 7] as i64) & 0x80) != 0:
        return Err("{field} exceeds signed loader range")
    Ok(bytes_to_u64(data, offset) as i64)

fn smf_dynlib_signed_i64(data: [u8], offset: i64, field: text) -> Result<i64, text>:
    if not smf_dynlib_range_valid(offset, 8, data.len()):
        return Err("{field} is truncated")
    Ok(bytes_to_u64(data, offset) as i64)

fn smf_dynlib_checked_add(left: i64, right: i64) -> i64?:
    if right > 0 and left > SMF_DYNLIB_I64_MAX - right:
        return nil
    if right < 0 and left < SMF_DYNLIB_I64_MIN - right:
        return nil
    Some(left + right)

fn smf_dynlib_checked_sub(left: i64, right: i64) -> i64?:
    if right > 0 and left < SMF_DYNLIB_I64_MIN + right:
        return nil
    if right < 0 and left > SMF_DYNLIB_I64_MAX + right:
        return nil
    Some(left - right)

fn smf_dynlib_relocation_width(reloc_type: i32) -> i64:
    if reloc_type == 1: 8 else: 4

fn smf_dynlib_preflight_reader(data: [u8]) -> Result<SmfReaderMemory, text>:
    """Bound all outer-header/table work before the shared reader sees it."""
    val header_offset = smf_dynlib_header_offset(data)
    if header_offset == -2:
        return Err("ambiguous smf header")
    if header_offset < 0:
        return Err("invalid smf header")
    if data[header_offset + 4] != 1 or data[header_offset + 5] != 1:
        return Err("unsupported smf version")

    val section_count = bytes_to_u32(data, header_offset + 16) as i64
    val symbol_count = bytes_to_u32(data, header_offset + 36) as i64
    if section_count <= 0 or section_count > SMF_DYNLIB_MAX_SECTIONS:
        return Err("invalid section count")
    if symbol_count <= 0 or symbol_count > SMF_DYNLIB_MAX_SYMBOLS:
        return Err("invalid symbol count")

    val data_offset = bytes_to_u32(data, header_offset + 56) as i64
    val raw_sections = smf_dynlib_nonnegative_u64(data, header_offset + 20, "section table offset")?
    val raw_symbols = smf_dynlib_nonnegative_u64(data, header_offset + 28, "symbol table offset")?
    val sections_offset = smf_dynlib_checked_add(data_offset, raw_sections) ?? return Err("section table offset overflows")
    val symbols_offset = smf_dynlib_checked_add(data_offset, raw_symbols) ?? return Err("symbol table offset overflows")
    val sections_size = section_count * SMF_DYNLIB_SECTION_SIZE
    val symbols_size = symbol_count * SMF_DYNLIB_SYMBOL_SIZE
    if not smf_dynlib_range_valid(sections_offset, sections_size, data.len()):
        return Err("section table escapes admitted bytes")
    if not smf_dynlib_range_valid(symbols_offset, symbols_size, data.len()):
        return Err("symbol table escapes admitted bytes")
    if smf_dynlib_ranges_overlap(sections_offset, sections_size, header_offset, SMF_DYNLIB_HEADER_SIZE):
        return Err("section table overlaps smf header")
    if smf_dynlib_ranges_overlap(symbols_offset, symbols_size, header_offset, SMF_DYNLIB_HEADER_SIZE):
        return Err("symbol table overlaps smf header")
    if smf_dynlib_ranges_overlap(sections_offset, sections_size, symbols_offset, symbols_size):
        return Err("section and symbol tables overlap")
    SmfReaderMemory.from_data(data)

fn smf_dynlib_known_section_type(wire_type: i32) -> bool:
    (wire_type >= 1 and wire_type <= 9) or (wire_type >= 14 and wire_type <= 16)

fn smf_dynlib_name_from_table(data: [u8], start: i64, end: i64) -> Result<text, text>:
    if start < 0 or start >= end or end > data.len():
        return Err("symbol name offset escapes string table")
    var bytes: [u8] = []
    var index = start
    while index < end:
        val byte = data[index]
        if byte == 0:
            if bytes.len() == 0:
                return Err("empty symbol name")
            return Ok(bytes_to_text(bytes))
        bytes.push(byte)
        index = index + 1
    Err("unterminated symbol name")

fn smf_dynlib_validate_sections(reader: SmfReaderMemory) -> Result<[DynSmfSection], text>:
    val total = reader.data.len() as i64
    val count = reader.header.section_count as i64
    if count <= 0 or count > SMF_DYNLIB_MAX_SECTIONS:
        return Err("invalid section count")
    val table_size = count * SMF_DYNLIB_SECTION_SIZE
    if not smf_dynlib_range_valid(reader.sections_offset, table_size, total):
        return Err("section table escapes admitted bytes")
    if smf_dynlib_ranges_overlap(reader.sections_offset, table_size, reader.header.header_offset, SMF_DYNLIB_HEADER_SIZE):
        return Err("section table overlaps smf header")
    val symbol_table_size = (reader.header.symbol_count as i64) * SMF_DYNLIB_SYMBOL_SIZE

    var sections: [DynSmfSection] = []
    var ordered_offsets: [i64] = []
    var sizes_by_offset: Dict<i64, i64> = {}
    var indices_by_offset: Dict<i64, i32> = {}
    var index = 0i64
    while index < count:
        val entry = reader.sections_offset + index * SMF_DYNLIB_SECTION_SIZE
        val wire_type = reader.data[entry] as i32
        if not smf_dynlib_known_section_type(wire_type):
            return Err("unknown section type {wire_type}")
        val flags = bytes_to_u32(reader.data, entry + 4) as i64
        val raw_offset = smf_dynlib_nonnegative_u64(reader.data, entry + 8, "section {index} offset")?
        val file_offset = if reader.header.smf_data_offset > 0:
            smf_dynlib_checked_add(reader.header.smf_data_offset, raw_offset) ?? return Err("section {index} offset overflows")
        else:
            raw_offset
        val size = smf_dynlib_nonnegative_u64(reader.data, entry + 16, "section {index} size")?
        val alignment = smf_dynlib_nonnegative_u64(reader.data, entry + 32, "section {index} alignment")?
        if size <= 0 or not smf_dynlib_range_valid(file_offset, size, total):
            return Err("section {index} escapes admitted bytes")
        if alignment <= 0 or (alignment & (alignment - 1)) != 0:
            return Err("section {index} has invalid alignment")
        if smf_dynlib_ranges_overlap(file_offset, size, reader.sections_offset, table_size):
            return Err("section {index} overlaps section table")
        if smf_dynlib_ranges_overlap(file_offset, size, reader.header.header_offset, SMF_DYNLIB_HEADER_SIZE):
            return Err("section {index} overlaps smf header")
        if smf_dynlib_ranges_overlap(file_offset, size, reader.symbols_offset, symbol_table_size):
            return Err("section {index} overlaps symbol table")
        if wire_type == 6:
            if file_offset != reader.string_table_offset or size != reader.string_table_end - reader.string_table_offset:
                return Err("string-table section disagrees with reader bounds")
        elif smf_dynlib_ranges_overlap(file_offset, size, reader.string_table_offset, reader.string_table_end - reader.string_table_offset):
            return Err("section {index} overlaps string table")
        val section = DynSmfSection(
            index: index as i32,
            wire_type: wire_type,
            flags: flags,
            file_offset: file_offset,
            size: size,
            alignment: alignment
        )
        if sizes_by_offset.has(file_offset):
            return Err("section {index} overlaps section {indices_by_offset[file_offset]}")
        ordered_offsets.push(file_offset)
        sizes_by_offset[file_offset] = size
        indices_by_offset[file_offset] = section.index
        sections.push(section)
        index = index + 1

    ordered_offsets.sort()
    var ordered_index = 1
    while ordered_index < ordered_offsets.len():
        val previous_offset = ordered_offsets[ordered_index - 1]
        val current_offset = ordered_offsets[ordered_index]
        val previous_end = previous_offset + sizes_by_offset[previous_offset]
        if current_offset < previous_end:
            return Err(
                "section {indices_by_offset[current_offset]} overlaps section {indices_by_offset[previous_offset]}"
            )
        ordered_index = ordered_index + 1
    Ok(sections)

fn smf_dynlib_validate_symbols(reader: SmfReaderMemory, sections: [DynSmfSection]) -> Result<[DynSmfWireSymbol], text>:
    val total = reader.data.len() as i64
    val count = reader.header.symbol_count as i64
    if count <= 0 or count > SMF_DYNLIB_MAX_SYMBOLS:
        return Err("invalid symbol count")
    val table_size = count * SMF_DYNLIB_SYMBOL_SIZE
    if not smf_dynlib_range_valid(reader.symbols_offset, table_size, total):
        return Err("symbol table escapes admitted bytes")
    if smf_dynlib_ranges_overlap(reader.symbols_offset, table_size, reader.sections_offset, (reader.header.section_count as i64) * SMF_DYNLIB_SECTION_SIZE):
        return Err("symbol table overlaps section table")
    if smf_dynlib_ranges_overlap(reader.symbols_offset, table_size, reader.header.header_offset, SMF_DYNLIB_HEADER_SIZE):
        return Err("symbol table overlaps smf header")
    if reader.string_table_offset < reader.symbols_offset + table_size:
        return Err("string table overlaps symbol table")
    if reader.string_table_end <= reader.string_table_offset or reader.string_table_end > total:
        return Err("invalid string table range")
    if smf_dynlib_ranges_overlap(reader.string_table_offset, reader.string_table_end - reader.string_table_offset, reader.header.header_offset, SMF_DYNLIB_HEADER_SIZE):
        return Err("string table overlaps smf header")

    var symbols: [DynSmfWireSymbol] = []
    var seen_names: Dict<text, bool> = {}
    var exported_count = 0i64
    var index = 0i64
    while index < count:
        val entry = reader.symbols_offset + index * SMF_DYNLIB_SYMBOL_SIZE
        val name_offset = bytes_to_u32(reader.data, entry) as i64
        val string_table_size = reader.string_table_end - reader.string_table_offset
        if name_offset <= 0 or name_offset >= string_table_size:
            return Err("symbol name offset escapes string table")
        val name = smf_dynlib_name_from_table(
            reader.data,
            reader.string_table_offset + name_offset,
            reader.string_table_end
        )?
        if seen_names.has(name):
            return Err("duplicate symbol name {name}")
        val symbol_type = reader.data[entry + 8] as i32
        if symbol_type != 0:
            return Err("unsupported dynamic symbol type {symbol_type}")
        val binding = reader.data[entry + 9] as i32
        if binding > 2:
            return Err("invalid symbol binding {binding}")
        val section_index = (reader.data[entry + 41] as i32) | ((reader.data[entry + 42] as i32) << 8)
        val section_slot = section_index as i64
        if section_slot < 0 or section_slot >= sections.len():
            return Err("symbol {name} references missing section {section_index}")
        val section = sections[section_slot]
        if section.wire_type != 1:
            return Err("symbol {name} does not reference a code section")
        if (section.flags & 0x1) == 0 or (section.flags & 0x4) == 0 or (section.flags & 0x2) != 0:
            return Err("code section {section_index} violates read-execute policy")
        val offset = smf_dynlib_nonnegative_u64(reader.data, entry + 16, "symbol {name} offset")?
        val size = smf_dynlib_nonnegative_u64(reader.data, entry + 24, "symbol {name} size")?
        if size <= 0 or offset >= section.size or size > section.size - offset:
            return Err("symbol {name} escapes code section")
        val exported = binding == 1 or binding == 2
        if exported:
            exported_count = exported_count + 1
        symbols.push(DynSmfWireSymbol(
            name: name,
            section_index: section_index,
            offset: offset,
            size: size,
            exported: exported
        ))
        seen_names[name] = true
        index = index + 1

    val declared_exports = bytes_to_u32(reader.data, reader.header.header_offset + 40) as i64
    if exported_count <= 0:
        return Err("smf has no exported symbols")
    if declared_exports != exported_count:
        return Err("export count mismatch")
    Ok(symbols)

fn smf_dynlib_validate_relocations(reader: SmfReaderMemory, sections: [DynSmfSection], symbols: [DynSmfWireSymbol], code_sections: [i32]) -> Result<[DynSmfRelocation], text>:
    var reloc_section: DynSmfSection? = nil
    for section in sections:
        if section.wire_type == 5:
            if reloc_section != nil:
                return Err("multiple relocation sections are ambiguous")
            reloc_section = Some(section)
    if reloc_section == nil:
        return Ok([])
    if code_sections.len() != 1:
        return Err("relocations require exactly one code section")
    val section = reloc_section!
    if section.size % SMF_DYNLIB_RELOC_SIZE != 0:
        return Err("relocation section has trailing bytes")
    val code = sections[code_sections[0] as i64]
    var relocations: [DynSmfRelocation] = []
    var occupied_patch_indices: Dict<i64, i64> = {}
    var cursor = section.file_offset
    val end = section.file_offset + section.size
    while cursor < end:
        val offset = smf_dynlib_nonnegative_u64(reader.data, cursor, "relocation offset")?
        val symbol_index = bytes_to_u32(reader.data, cursor + 8) as i64
        val reloc_type = reader.data[cursor + 12] as i32
        val addend = smf_dynlib_signed_i64(reader.data, cursor + 16, "relocation addend")?
        if reloc_type < 1 or reloc_type > 5:
            return Err("unknown relocation type {reloc_type}")
        val patch_width = smf_dynlib_relocation_width(reloc_type)
        if offset >= code.size or patch_width > code.size - offset:
            return Err("relocation offset {offset} escapes code section")
        if symbol_index < 0 or symbol_index >= symbols.len():
            return Err("relocation symbol index {symbol_index} out of range")
        var patch_byte = offset
        val patch_end = offset + patch_width
        var overlap_index = -1i64
        while patch_byte < patch_end:
            if occupied_patch_indices.has(patch_byte):
                val candidate = occupied_patch_indices[patch_byte]
                if overlap_index < 0 or candidate < overlap_index:
                    overlap_index = candidate
            patch_byte = patch_byte + 1
        if overlap_index >= 0:
            return Err("overlapping relocation patches at {relocations[overlap_index].offset} and {offset}")
        patch_byte = offset
        while patch_byte < patch_end:
            occupied_patch_indices[patch_byte] = relocations.len()
            patch_byte = patch_byte + 1
        relocations.push(DynSmfRelocation(
            offset: offset,
            symbol_index: symbol_index,
            reloc_type: reloc_type,
            addend: addend
        ))
        cursor = cursor + SMF_DYNLIB_RELOC_SIZE
    Ok(relocations)

fn smf_dynlib_validate(data: [u8]) -> Result<DynSmfValidatedArtifact, text>:
    val reader = smf_dynlib_preflight_reader(data)?
    val header_offset = reader.header.header_offset
    val platform_id = data[header_offset + 6]
    val arch_id = data[header_offset + 7]
    if not smf_target_is_host_compatible(platform_id, arch_id):
        return Err("smf target mismatch: platform {platform_id} arch {arch_id}")
    if not reader.header.flags.executable:
        return Err("smf is not executable")
    if reader.data[header_offset + 12] != 0:
        return Err("compressed smf is unsupported")
    val sections = smf_dynlib_validate_sections(reader)?
    var code_sections: [i32] = []
    for section in sections:
        if section.wire_type == 1:
            if section.alignment > 4096:
                return Err("code section alignment exceeds mapper guarantee")
            code_sections.push(section.index)
    if code_sections.len() == 0:
        return Err("smf has no code section")
    val symbols = smf_dynlib_validate_symbols(reader, sections)?
    val relocations = smf_dynlib_validate_relocations(reader, sections, symbols, code_sections)?
    Ok(DynSmfValidatedArtifact(
        sections: sections,
        symbols: symbols,
        relocations: relocations,
        code_sections: code_sections
    ))

fn smf_dynlib_copy_section(data: [u8], section: DynSmfSection) -> [u8]:
    var bytes: [u8] = []
    var index = section.file_offset
    val end = section.file_offset + section.size
    while index < end:
        bytes.push(data[index])
        index = index + 1
    bytes

fn smf_dynlib_snapshot_bytes(data: [u8]) -> [u8]:
    var snapshot: [u8] = []
    for byte in data:
        snapshot.push(byte)
    snapshot

pub fn smf_artifact_has_export(data: [u8], export_name: text) -> bool:
    if export_name == "":
        return false
    val validated = match smf_dynlib_validate(data):
        case Ok(value): value
        case Err(_): return false
    for symbol in validated.symbols:
        if symbol.exported and symbol.name == export_name:
            return true
    false

pub fn smf_artifact_has_exports(data: [u8], export_names: [text]) -> bool:
    """Check a required export subset with one structural SMF validation."""
    if export_names.len() == 0:
        return true
    var required: Dict<text, bool> = {}
    var required_count = 0
    for name in export_names:
        if name == "":
            return false
        if not required.has(name):
            required[name] = false
            required_count = required_count + 1
    val validated = match smf_dynlib_validate(data):
        case Ok(value): value
        case Err(_): return false
    var found_count = 0
    for symbol in validated.symbols:
        if symbol.exported and required.has(symbol.name) and not required[symbol.name]:
            required[symbol.name] = true
            found_count = found_count + 1
            if found_count == required_count:
                return true
    false

fn smf_dynlib_validated_has_exact_exports(validated: DynSmfValidatedArtifact, expected: [text]) -> bool:
    # Build the manifest-side membership index once. The previous nested scan
    # was O(exported symbols * expected names) on every admission and made
    # large facet catalogs needlessly expensive during startup.
    var required: Dict<text, bool> = {}
    for name in expected:
        if name == "" or required.has(name):
            return false
        required[name] = false
    var exported_count = 0
    for symbol in validated.symbols:
        if symbol.exported:
            exported_count = exported_count + 1
            if not required.has(symbol.name) or required[symbol.name]:
                return false
            required[symbol.name] = true
    if exported_count != expected.len():
        return false
    true

pub fn smf_artifact_has_exact_exports(data: [u8], expected: [text]) -> bool:
    val validated = match smf_dynlib_validate(data):
        case Ok(value): value
        case Err(_): return false
    smf_dynlib_validated_has_exact_exports(validated, expected)

fn smf_dynlib_rollback(req: DynLoadRequest, owner_id: text, expected_segments: i32, error_message: text) -> DynLoadResult:
    val remaining_before = DYNSMF_MAPPER.owner_segment_count(owner_id)
    if remaining_before < 0 or remaining_before > expected_segments:
        return DynLoadResult.fail(req.library_name, error_message + "; rollback owner count {remaining_before} exceeds expected {expected_segments}")
    val already_removed = expected_segments - remaining_before
    val removed = DYNSMF_MAPPER.unmap_owner(owner_id)
    val total_removed = already_removed + removed
    if total_removed != expected_segments:
        return DynLoadResult.fail(req.library_name, error_message + "; rollback removed {total_removed} of {expected_segments} segments ({already_removed} already removed, {removed} removed now)")
    return DynLoadResult.fail(req.library_name, error_message)

fn smf_dynlib_apply_relocation(code_base: i64, relocation: DynSmfRelocation, target: i64) -> Result<(), text>:
    val patch_address = smf_dynlib_checked_add(code_base, relocation.offset) ?? return Err("relocation patch address overflows")
    if relocation.reloc_type == 1:
        val value = smf_dynlib_checked_add(target, relocation.addend) ?? return Err("absolute 64-bit relocation overflows")
        native_reloc_write_i64(code_base, relocation.offset, value)
        return Ok(())
    if relocation.reloc_type >= 2 and relocation.reloc_type <= 4:
        val delta = smf_dynlib_checked_sub(target, patch_address) ?? return Err("relative relocation delta overflows")
        val value = smf_dynlib_checked_add(delta, relocation.addend) ?? return Err("relative relocation addend overflows")
        if value < SMF_DYNLIB_I32_MIN or value > SMF_DYNLIB_I32_MAX:
            return Err("relative relocation does not fit i32")
        native_reloc_write_i32(code_base, relocation.offset, value as i32)
        return Ok(())
    if relocation.reloc_type == 5:
        val value = smf_dynlib_checked_add(target, relocation.addend) ?? return Err("absolute 32-bit relocation overflows")
        if value < SMF_DYNLIB_I32_MIN or value > SMF_DYNLIB_I32_MAX:
            return Err("absolute relocation does not fit i32")
        native_reloc_write_i32(code_base, relocation.offset, value as i32)
        return Ok(())
    Err("unknown relocation type")

pub fn smf_dlopen(req: DynLoadRequest, next_handle: int) -> DynLoadResult:
    """Fail-closed compatibility facade. Executable loads require admitted bytes."""
    val request_error = smf_dynlib_request_error(req, next_handle)
    if request_error != "":
        return DynLoadResult.fail(req.library_name, request_error)
    return DynLoadResult.fail(req.library_name, "admitted smf bytes required")

pub fn smf_dlopen_bytes(req: DynLoadRequest, next_handle: int, data: [u8]) -> DynLoadResult:
    """Fail-closed compatibility facade for path-independent byte callers.

    Captured bytes are not an admission receipt. Only the explicit
    `smf_dlopen_admitted` entry point may validate, map, relocate, and publish
    an executable handle through the W^X owner.
    """
    val _captured_byte_count = data.len()
    return smf_dlopen(req, next_handle)

pub fn smf_dlopen_checked(req: DynLoadRequest, next_handle: int) -> DynLoadResult:
    """Compatibility facade with no executable success path.

    A checked path is still only a path. It cannot prove that bytes mapped
    later are the bytes previously checked, so only `smf_dlopen_admitted` may
    publish a handle.
    """
    return smf_dlopen(req, next_handle)

pub fn smf_dlopen_admitted(req: DynLoadRequest, next_handle: int, admitted_bytes: [u8]) -> DynLoadResult:
    """Load exactly the admitted SMF byte image through the canonical W^X mapper."""
    val request_error = smf_dynlib_request_error(req, next_handle)
    if request_error != "":
        return DynLoadResult.fail(req.library_name, request_error)
    # Freeze one local image before parsing. Validation, section copy, and
    # relocation then consume the same bytes even if the caller retains a
    # mutable reference to its input array.
    val exact_bytes = smf_dynlib_snapshot_bytes(admitted_bytes)
    val validated = match smf_dynlib_validate(exact_bytes):
        case Ok(value): value
        case Err(err): return DynLoadResult.fail(req.library_name, err)
    return smf_dynlib_load_validated(req, next_handle, exact_bytes, validated)

pub fn smf_dlopen_admitted_exact_exports(req: DynLoadRequest, next_handle: int, admitted_bytes: [u8], expected_exports: [text]) -> DynLoadResult:
    """Validate, check the exact export set, and map one frozen image once."""
    val request_error = smf_dynlib_request_error(req, next_handle)
    if request_error != "":
        return DynLoadResult.fail(req.library_name, request_error)
    val exact_bytes = smf_dynlib_snapshot_bytes(admitted_bytes)
    smf_dlopen_frozen_exact_exports(req, next_handle, exact_bytes, expected_exports)

fn smf_dlopen_frozen_exact_exports(req: DynLoadRequest, next_handle: int, exact_bytes: [u8], expected_exports: [text]) -> DynLoadResult:
    """Map a payload already frozen by its owning trust boundary."""
    val validated = match smf_dynlib_validate(exact_bytes):
        case Ok(value): value
        case Err(err): return DynLoadResult.fail(req.library_name, err)
    if not smf_dynlib_validated_has_exact_exports(validated, expected_exports):
        return DynLoadResult.fail(req.library_name, "artifact_manifest_export_set_mismatch")
    return smf_dynlib_load_validated(req, next_handle, exact_bytes, validated)

# DynSmfOwned uses this owner port so a newly published mapping is protected
# against legacy close in the same physical-owner critical section. There is
# no observable unprotected interval between mapper publication and B-owner
# association.
fn smf_dlopen_frozen_exact_exports_protected_v3(req: DynLoadRequest,
        next_handle: int, exact_bytes: [u8], expected_exports: [text]
    ) -> DynLoadResult:
    val validated = match smf_dynlib_validate(exact_bytes):
        case Ok(value): value
        case Err(err): return DynLoadResult.fail(req.library_name, err)
    if not smf_dynlib_validated_has_exact_exports(validated, expected_exports):
        return DynLoadResult.fail(
            req.library_name, "artifact_manifest_export_set_mismatch")
    if not _smf_dynlib_owner_enter_v3():
        return DynLoadResult.fail(req.library_name,
            "dynsmf physical owner gate unavailable")
    val request_error = smf_dynlib_request_error(req, next_handle)
    if request_error != "":
        _ = _smf_dynlib_owner_exit_v3()
        return DynLoadResult.fail(req.library_name, request_error)
    val result = _smf_dynlib_load_validated_locked(
        req, next_handle, exact_bytes, validated, true)
    if not _smf_dynlib_owner_exit_v3():
        return DynLoadResult.fail(req.library_name,
            "dynsmf physical owner gate exit failed")
    result

fn _smf_dynlib_load_validated_locked(req: DynLoadRequest, next_handle: int,
        exact_bytes: [u8], validated: DynSmfValidatedArtifact,
        protect_handle: bool = false) -> DynLoadResult:
    val owner_id = "dynsmf-handle-" + next_handle.to_text()
    var mapped_count = 0i32
    for section_index in validated.code_sections:
        val section = validated.sections[section_index as i64]
        val bytes = smf_dynlib_copy_section(exact_bytes, section)
        match DYNSMF_MAPPER.map_segment_writable(owner_id, section.index, bytes, section.alignment):
            case Ok(_):
                mapped_count = mapped_count + 1
            case Err(err):
                return smf_dynlib_rollback(req, owner_id, mapped_count, err)

    var symbol_addresses: [i64] = []
    val retain_symbol_addresses = validated.relocations.len() > 0
    var exports: Dict<text, i64> = {}
    for symbol in validated.symbols:
        val address = match DYNSMF_MAPPER.bind_symbol(owner_id, symbol.section_index, symbol.name, symbol.offset, symbol.size):
            case Ok(value): value
            case Err(err): return smf_dynlib_rollback(req, owner_id, mapped_count, err)
        if retain_symbol_addresses:
            symbol_addresses.push(address)
        if symbol.exported:
            exports[symbol.name] = address

    if validated.relocations.len() > 0:
        val code_section = validated.code_sections[0]
        val code_base = DYNSMF_MAPPER.segment_base(owner_id, code_section)
        for relocation in validated.relocations:
            val target = symbol_addresses[relocation.symbol_index]
            match smf_dynlib_apply_relocation(code_base, relocation, target):
                case Ok(_): pass
                case Err(err): return smf_dynlib_rollback(req, owner_id, mapped_count, err)
    for code_section in validated.code_sections:
        match DYNSMF_MAPPER.end_relocation(owner_id, code_section):
            case Ok(_): pass
            case Err(err): return smf_dynlib_rollback(req, owner_id, mapped_count, err)

    var mapping_receipts: [ExecutableMappingReceiptV1] = []
    for code_section in validated.code_sections:
        match DYNSMF_MAPPER.mapping_receipt_v1(owner_id, code_section):
            case Ok(receipt): mapping_receipts.push(receipt)
            case Err(err):
                return smf_dynlib_rollback(req, owner_id, mapped_count, err)
    if mapping_receipts.len() != mapped_count as i64:
        return smf_dynlib_rollback(
            req, owner_id, mapped_count,
            "mapped segment receipt count mismatch")

    var released_receipts: [bool] = []
    var release_attempt_ids: [i64] = []
    for _ in mapping_receipts:
        released_receipts.push(false)
        release_attempt_ids.push(0)

    val success = DynLoadResult.ok(req.library_name, next_handle)
    DYNSMF_LIBRARIES[next_handle] = DynSmfLoadedLibrary(
        library_name: req.library_name,
        owner_id: owner_id,
        exports: exports,
        mapping_receipts: mapping_receipts,
        released_receipts: released_receipts,
        release_attempt_ids: release_attempt_ids,
        remaining_segments: mapped_count,
        close_pending: false)
    if protect_handle:
        _dynsmf_owner_protected_handles_v3[next_handle] = true
    if next_handle >= DYNSMF_NEXT_HANDLE_HINT:
        DYNSMF_NEXT_HANDLE_HINT = if next_handle == SMF_DYNLIB_I64_MAX: 1 else: next_handle + 1
    # Keep this native/global-state boundary explicit. The seed interpreter has
    # returned a default DynLoadResult for the implicit tail-expression form
    # after global dictionary publication.
    return success

fn smf_dynlib_load_validated(req: DynLoadRequest, next_handle: int,
        exact_bytes: [u8], validated: DynSmfValidatedArtifact) -> DynLoadResult:
    if not _smf_dynlib_owner_enter_v3():
        return DynLoadResult.fail(req.library_name,
            "dynsmf physical owner gate unavailable")
    val request_error = smf_dynlib_request_error(req, next_handle)
    if request_error != "":
        _ = _smf_dynlib_owner_exit_v3()
        return DynLoadResult.fail(req.library_name, request_error)
    val result = _smf_dynlib_load_validated_locked(
        req, next_handle, exact_bytes, validated)
    if not _smf_dynlib_owner_exit_v3():
        return DynLoadResult.fail(req.library_name,
            "dynsmf physical owner gate exit failed")
    result

fn _smf_dlsym_locked_v3(handle_id: int, symbol_name: text,
        registry: text) -> DynSymResult:
    """Resolve only addresses published from the admitted SMF symbol table.

    `registry` remains in the signature for compatibility and is deliberately
    ignored; caller-supplied text can never create a symbol.
    """
    val _ignored_registry = registry
    if handle_id <= 0:
        return DynSymResult.fail(symbol_name, "invalid handle")
    if symbol_name == "":
        return DynSymResult.fail("", "empty symbol name")
    if not DYNSMF_LIBRARIES.has(handle_id):
        return DynSymResult.fail(symbol_name, "unknown handle")
    val loaded = DYNSMF_LIBRARIES[handle_id]
    if loaded.close_pending:
        return DynSymResult.fail(symbol_name, "handle close pending")
    if not loaded.exports.has(symbol_name):
        return DynSymResult.fail(symbol_name, "symbol not exported by admitted smf")
    return DynSymResult.ok(symbol_name, loaded.exports[symbol_name])

pub fn smf_dlsym(handle_id: int, symbol_name: text,
        registry: text) -> DynSymResult:
    if not _smf_dynlib_owner_enter_v3():
        return DynSymResult.fail(symbol_name,
            "dynsmf physical owner gate unavailable")
    val symbol = _smf_dlsym_locked_v3(handle_id, symbol_name, registry)
    _ = _smf_dynlib_owner_exit_v3()
    symbol

fn _smf_dynlib_mapping_observation_error_v1(handle_id: int, reason: text
    ) -> DynSmfMappingObservationV1:
    DynSmfMappingObservationV1(
        ok: false, reason: reason, handle_id: handle_id,
        mapper_instance_id: "", mapping_receipts: [])

fn _smf_dynlib_mapping_observe_locked_v3(handle_id: int
    ) -> DynSmfMappingObservationV1:
    """Observe the immutable receipt batch retained by one live handle.

    The returned values are coordinates, not release authority. Only
    `smf_dynlib_release_mappings_v1` can invoke the canonical mapper owner.
    """
    if handle_id <= 0:
        return _smf_dynlib_mapping_observation_error_v1(
            handle_id, "invalid handle")
    if not DYNSMF_LIBRARIES.has(handle_id):
        return _smf_dynlib_mapping_observation_error_v1(
            handle_id, "unknown handle")
    val loaded = DYNSMF_LIBRARIES[handle_id]
    if loaded.mapping_receipts.len() == 0:
        return _smf_dynlib_mapping_observation_error_v1(
            handle_id, "handle has no mapping receipts")
    val instance_id = loaded.mapping_receipts[0].mapper_instance_id
    var receipts: [ExecutableMappingReceiptV1] = []
    for receipt in loaded.mapping_receipts:
        if receipt.mapper_instance_id != instance_id or
                receipt.owner_id != loaded.owner_id:
            return _smf_dynlib_mapping_observation_error_v1(
                handle_id, "handle mapping receipt identity mismatch")
        receipts.push(receipt)
    DynSmfMappingObservationV1(
        ok: true, reason: "", handle_id: handle_id,
        mapper_instance_id: instance_id, mapping_receipts: receipts)

pub fn smf_dynlib_mapping_observe_v1(handle_id: int
    ) -> DynSmfMappingObservationV1:
    if not _smf_dynlib_owner_enter_v3():
        return _smf_dynlib_mapping_observation_error_v1(
            handle_id, "dynsmf physical owner gate unavailable")
    val observed = _smf_dynlib_mapping_observe_locked_v3(handle_id)
    _ = _smf_dynlib_owner_exit_v3()
    observed

fn _smf_dynlib_receipt_batches_match_v1(
        left: [ExecutableMappingReceiptV1],
        right: [ExecutableMappingReceiptV1]) -> bool:
    if left.len() != right.len():
        return false
    var index = 0
    while index < left.len():
        if not executable_mapping_receipt_v1_same_identity(
                left[index], right[index]):
            return false
        index = index + 1
    true

fn _smf_dynlib_mapping_release_error_v1(handle_id: int, reason: text
    ) -> DynSmfMappingReleaseV1:
    DynSmfMappingReleaseV1(
        ok: false, reason: reason, handle_id: handle_id, results: [],
        attempted_count: 0, fully_released: false)

fn _smf_dynlib_release_mappings_locked_v3(handle_id: int,
        expected: [ExecutableMappingReceiptV1],
        native_budget: i64 = SMF_DYNLIB_MAX_SECTIONS
    ) -> DynSmfMappingReleaseV1:
    """Release a handle only through its retained exact mapper receipts.

    Successful receipt results are terminal inside SegmentMapper. A partial
    failure keeps this positive handle close-pending, and retrying the same
    batch skips every prior native free through AlreadyReleased results.
    """
    if handle_id <= 0:
        return _smf_dynlib_mapping_release_error_v1(
            handle_id, "invalid handle")
    if not DYNSMF_LIBRARIES.has(handle_id):
        return _smf_dynlib_mapping_release_error_v1(
            handle_id, "unknown handle")
    var loaded = DYNSMF_LIBRARIES[handle_id]
    if not _smf_dynlib_receipt_batches_match_v1(
            loaded.mapping_receipts, expected):
        return _smf_dynlib_mapping_release_error_v1(
            handle_id, "mapping receipt batch mismatch")
    if (loaded.released_receipts.len() != loaded.mapping_receipts.len() or
            loaded.release_attempt_ids.len() != loaded.mapping_receipts.len()):
        return _smf_dynlib_mapping_release_error_v1(
            handle_id, "mapping release progress is inconsistent")

    var results: [ExecutableMappingReleaseResultV1] = []
    var failed = 0
    var native_attempts: i64 = 0
    var index: i64 = 0
    while index < loaded.mapping_receipts.len():
        val receipt = loaded.mapping_receipts[index]
        if (not loaded.released_receipts[index] and
                native_attempts >= native_budget):
            failed = failed + 1
            index = index + 1
            continue
        val result = if loaded.released_receipts[index]:
            executable_mapping_release_result_v1(
                receipt, ExecutableMappingReleaseOutcomeV1.AlreadyReleased,
                0, 0, loaded.release_attempt_ids[index])
        else:
            DYNSMF_MAPPER.release_mapping_v1(receipt)
        if not loaded.released_receipts[index]:
            native_attempts = native_attempts + 1
        results.push(result)
        if result.outcome == ExecutableMappingReleaseOutcomeV1.Released or
                result.outcome == ExecutableMappingReleaseOutcomeV1.AlreadyReleased:
            loaded.released_receipts[index] = true
            loaded.release_attempt_ids[index] = result.attempt_id
        else:
            failed = failed + 1
        index = index + 1
    if failed > 0:
        loaded.remaining_segments = failed as i32
        loaded.close_pending = true
        DYNSMF_LIBRARIES[handle_id] = loaded
        return DynSmfMappingReleaseV1(
            ok: false, reason: "native mapping release incomplete",
            handle_id: handle_id, results: results,
            attempted_count: results.len(), fully_released: false)

    DYNSMF_LIBRARIES = DYNSMF_LIBRARIES.remove(handle_id)
    DynSmfMappingReleaseV1(
        ok: true, reason: "", handle_id: handle_id, results: results,
        attempted_count: results.len(), fully_released: true)

pub fn smf_dynlib_release_mappings_v1(handle_id: int,
        expected: [ExecutableMappingReceiptV1]) -> DynSmfMappingReleaseV1:
    if not _smf_dynlib_owner_enter_v3():
        return _smf_dynlib_mapping_release_error_v1(
            handle_id, "dynsmf physical owner gate unavailable")
    if _dynsmf_owner_protected_handles_v3.has(handle_id):
        _ = _smf_dynlib_owner_exit_v3()
        return _smf_dynlib_mapping_release_error_v1(
            handle_id, "dynsmf owner-authorized V3 release required")
    val released = _smf_dynlib_release_mappings_locked_v3(
        handle_id, expected)
    _ = _smf_dynlib_owner_exit_v3()
    released

fn _smf_dynlib_release_attempt_v3_from_row(
        row: _DynSmfReleaseAttemptRowV3) -> DynSmfReleaseAttemptObservationV3:
    DynSmfReleaseAttemptObservationV3(
        ok: row.completion.ok and row.completion.fully_released,
        reason: row.completion.reason, handle_id: row.handle_id,
        attempt: DynSmfReleaseAttemptV3(opaque_attempt: row.attempt_id),
        physical_complete: row.completion.ok and row.completion.fully_released,
        retryable: not row.completion.ok or not row.completion.fully_released,
        acknowledged: row.acknowledged)

fn _smf_dynlib_release_attempt_v3_error(handle_id: int, reason: text
    ) -> DynSmfReleaseAttemptObservationV3:
    DynSmfReleaseAttemptObservationV3(
        ok: false, reason: reason, handle_id: handle_id,
        attempt: DynSmfReleaseAttemptV3(opaque_attempt: 0),
        physical_complete: false, retryable: false, acknowledged: false)

fn _smf_dynlib_release_attempt_locked_v3(handle_id: int
    ) -> DynSmfReleaseAttemptObservationV3:
    """Make or resume one owner-retained physical release attempt.

    The mapping result never crosses this boundary.  A retry reuses the same
    attempt identity and the V1 mapper receipt owner already treats released
    segments as terminal, so a partial close cannot double-free a segment.
    """
    if handle_id <= 0:
        return _smf_dynlib_release_attempt_v3_error(handle_id, "invalid handle")
    if not _dynsmf_owner_protected_handles_v3.has(handle_id):
        return _smf_dynlib_release_attempt_v3_error(
            handle_id, "handle has no dynsmf close authority")
    if not _dynsmf_owner_release_armed_handles_v3.has(handle_id):
        return _smf_dynlib_release_attempt_v3_error(
            handle_id, "dynsmf close reservation has not armed release")
    if _dynsmf_release_attempt_by_handle_v3.has(handle_id):
        val known_id = _dynsmf_release_attempt_by_handle_v3[handle_id]
        if not _dynsmf_release_attempt_rows_v3.has(known_id):
            return _smf_dynlib_release_attempt_v3_error(
                handle_id, "release attempt owner is inconsistent")
        var known = _dynsmf_release_attempt_rows_v3[known_id]
        if known.acknowledged:
            return _smf_dynlib_release_attempt_v3_from_row(known)
        if known.completion.ok and known.completion.fully_released:
            return _smf_dynlib_release_attempt_v3_from_row(known)
        val observed = _smf_dynlib_mapping_observe_locked_v3(handle_id)
        if not observed.ok:
            return _smf_dynlib_release_attempt_v3_from_row(known)
        if observed.mapping_receipts.len() > SMF_DYNLIB_MAX_SECTIONS:
            return _smf_dynlib_release_attempt_v3_error(
                handle_id, "per-handle release progress exceeds 4096")
        known.completion = _smf_dynlib_release_mappings_locked_v3(
            handle_id, observed.mapping_receipts,
            SMF_DYNLIB_RELEASE_NATIVE_BUDGET_V3)
        _dynsmf_release_attempt_rows_v3[known_id] = known
        return _smf_dynlib_release_attempt_v3_from_row(known)
    if _dynsmf_release_next_attempt_v3 <= 0:
        return _smf_dynlib_release_attempt_v3_error(
            handle_id, "release attempt identity exhausted")
    val observed = _smf_dynlib_mapping_observe_locked_v3(handle_id)
    if not observed.ok:
        return _smf_dynlib_release_attempt_v3_error(handle_id, observed.reason)
    if observed.mapping_receipts.len() > SMF_DYNLIB_MAX_SECTIONS:
        return _smf_dynlib_release_attempt_v3_error(
            handle_id, "per-handle release progress exceeds 4096")
    val attempt_id = _dynsmf_release_next_attempt_v3
    _dynsmf_release_next_attempt_v3 = _dynsmf_release_next_attempt_v3 + 1
    val completion = _smf_dynlib_release_mappings_locked_v3(
        handle_id, observed.mapping_receipts,
        SMF_DYNLIB_RELEASE_NATIVE_BUDGET_V3)
    val row = _DynSmfReleaseAttemptRowV3(
        attempt_id: attempt_id, handle_id: handle_id, completion: completion,
        acknowledged: false)
    _dynsmf_release_attempt_rows_v3[attempt_id] = row
    _dynsmf_release_attempt_by_handle_v3[handle_id] = attempt_id
    _smf_dynlib_release_attempt_v3_from_row(row)

fn _smf_dynlib_release_attempt_for_loader_v3(handle_id: int
    ) -> DynSmfReleaseAttemptObservationV3:
    if not _smf_dynlib_owner_enter_v3():
        return _smf_dynlib_release_attempt_v3_error(
            handle_id, "dynsmf physical owner gate unavailable")
    val attempt = _smf_dynlib_release_attempt_locked_v3(handle_id)
    _ = _smf_dynlib_owner_exit_v3()
    attempt

fn _smf_dynlib_release_for_handle_observe_for_loader_v3(handle_id: int
    ) -> DynSmfReleaseAttemptObservationV3:
    if not _smf_dynlib_owner_enter_v3():
        return _smf_dynlib_release_attempt_v3_error(
            handle_id, "dynsmf physical owner gate unavailable")
    if not _dynsmf_release_attempt_by_handle_v3.has(handle_id):
        _ = _smf_dynlib_owner_exit_v3()
        return _smf_dynlib_release_attempt_v3_error(
            handle_id, "release attempt not yet published")
    val attempt_id = _dynsmf_release_attempt_by_handle_v3[handle_id]
    if not _dynsmf_release_attempt_rows_v3.has(attempt_id):
        _ = _smf_dynlib_owner_exit_v3()
        return _smf_dynlib_release_attempt_v3_error(
            handle_id, "release attempt owner is inconsistent")
    val observed = _smf_dynlib_release_attempt_v3_from_row(
        _dynsmf_release_attempt_rows_v3[attempt_id])
    _ = _smf_dynlib_owner_exit_v3()
    observed

fn _smf_dynlib_release_observe_for_owner_v3(attempt: DynSmfReleaseAttemptV3
    ) -> DynSmfReleaseAttemptObservationV3:
    val attempt_id = attempt.opaque_attempt
    if not _smf_dynlib_owner_enter_v3():
        return _smf_dynlib_release_attempt_v3_error(
            0, "dynsmf physical owner gate unavailable")
    if attempt_id <= 0 or not _dynsmf_release_attempt_rows_v3.has(attempt_id):
        _ = _smf_dynlib_owner_exit_v3()
        return _smf_dynlib_release_attempt_v3_error(0, "unknown release attempt")
    val observed = _smf_dynlib_release_attempt_v3_from_row(
        _dynsmf_release_attempt_rows_v3[attempt_id])
    _ = _smf_dynlib_owner_exit_v3()
    observed

fn _smf_dynlib_ack_release_for_loader_v3(
        attempt: DynSmfReleaseAttemptV3) -> bool:
    """Acknowledge a complete physical close after logical owners commit."""
    val attempt_id = attempt.opaque_attempt
    if not _smf_dynlib_owner_enter_v3():
        return false
    if attempt_id <= 0 or not _dynsmf_release_attempt_rows_v3.has(attempt_id):
        _ = _smf_dynlib_owner_exit_v3()
        return false
    var row = _dynsmf_release_attempt_rows_v3[attempt_id]
    if row.acknowledged:
        _ = _smf_dynlib_owner_exit_v3()
        return true
    if not row.completion.ok or not row.completion.fully_released:
        _ = _smf_dynlib_owner_exit_v3()
        return false
    row.acknowledged = true
    _dynsmf_release_attempt_rows_v3[attempt_id] = row
    _dynsmf_owner_protected_handles_v3 =
        _dynsmf_owner_protected_handles_v3.remove(row.handle_id)
    _dynsmf_owner_release_armed_handles_v3 =
        _dynsmf_owner_release_armed_handles_v3.remove(row.handle_id)
    _smf_dynlib_owner_exit_v3()

# Internal owner port: dynsmf_owned_v3 resolves this retained completion by
# attempt identity. It is intentionally not an input-taking result API.
pub fn _smf_dynlib_release_completion_v3(attempt: DynSmfReleaseAttemptV3
    ) -> DynSmfMappingReleaseV1?:
    val attempt_id = attempt.opaque_attempt
    if not _smf_dynlib_owner_enter_v3():
        return nil
    if attempt_id <= 0 or not _dynsmf_release_attempt_rows_v3.has(attempt_id):
        _ = _smf_dynlib_owner_exit_v3()
        return nil
    val completion = _dynsmf_release_attempt_rows_v3[attempt_id].completion
    _ = _smf_dynlib_owner_exit_v3()
    Some(completion)

pub fn smf_dlclose(handle_id: int) -> DynCloseResult:
    """Deterministically unmap every segment owned by a real loaded handle."""
    if not _smf_dynlib_owner_enter_v3():
        return DynCloseResult.fail(handle_id,
            "dynsmf physical owner gate unavailable")
    if _dynsmf_owner_protected_handles_v3.has(handle_id):
        _ = _smf_dynlib_owner_exit_v3()
        return DynCloseResult.fail(handle_id,
            "dynsmf owner-authorized V3 release required")
    val observed = _smf_dynlib_mapping_observe_locked_v3(handle_id)
    if not observed.ok:
        _ = _smf_dynlib_owner_exit_v3()
        return DynCloseResult.fail(handle_id, observed.reason)
    val released = _smf_dynlib_release_mappings_locked_v3(
        handle_id, observed.mapping_receipts)
    if not released.ok:
        _ = _smf_dynlib_owner_exit_v3()
        return DynCloseResult.fail(handle_id, released.reason)
    val result = DynCloseResult.ok(handle_id)
    _ = _smf_dynlib_owner_exit_v3()
    result
