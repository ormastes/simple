# Agent workload policy compiler.
#
# This is the control-plane adapter between an effective LLM profile and the
# shared WorkloadManifest contract.  It does not mint authority or launch a
# task.  The managed workload launcher remains the sole runtime mint seam.
#
# Broker-only policy dimensions deliberately fail closed here.  A profile that
# asks for raw network, secrets, UI capture/input, model access, or devices
# cannot be represented by ordinary kernel grants until its dedicated broker
# capability exists.

use os.security.llm_profiles.profile_registry.{
    LlmProfile, has_right,
    LLM_RIGHT_FS_READ, LLM_RIGHT_FS_WRITE, LLM_RIGHT_FS_EXEC,
    LLM_RIGHT_PROCESS_SPAWN, LLM_RIGHT_NET, LLM_RIGHT_SECRETS,
    LLM_RIGHT_UI_CLIPBOARD, LLM_RIGHT_UI_SCREENSHOT, LLM_RIGHT_DEVICE,
    LLM_RIGHT_MODEL_ACCESS
}
use os.kernel.types.capability_types.{CapabilityKind}
use os.kernel.ipc.cspace_spawn.{CapGrant}
use os.services.workload.workload_manifest.{
    WorkloadManifest, CompiledExecutionPolicy, compile_workload_manifest
}

pub struct AgentPolicySpec:
    workload: WorkloadManifest
    profile: LlmProfile
    allowed_child_depth: u64
    model_token_budget: u64
    tool_call_budget: u64
    approval_policy: text

pub struct CompiledAgentPolicy:
    execution: CompiledExecutionPolicy
    allowed_child_depth: u64
    model_token_budget: u64
    tool_call_budget: u64
    approval_policy: text

fn _root_allows(root: text, path: text) -> bool:
    if root == "" or path == "":
        return false
    if root == "/":
        return true
    if path == root:
        return true
    if path.len() <= root.len():
        return false
    path.starts_with(root + "/")

fn _any_root_allows(roots: [text], path: text) -> bool:
    for root in roots:
        if _root_allows(root, path):
            return true
    false

fn _profile_allows_grant(profile: LlmProfile, kind: CapabilityKind) -> bool:
    match kind:
        case CapabilityKind.FileRead(path):
            has_right(profile.rights, LLM_RIGHT_FS_READ) and
                _any_root_allows(profile.fs_read_roots, path)
        case CapabilityKind.FileWrite(path):
            has_right(profile.rights, LLM_RIGHT_FS_WRITE) and
                _any_root_allows(profile.fs_write_roots, path)
        case CapabilityKind.FileCreate(path):
            has_right(profile.rights, LLM_RIGHT_FS_WRITE) and
                _any_root_allows(profile.fs_write_roots, path)
        case CapabilityKind.FileExec(path):
            has_right(profile.rights, LLM_RIGHT_FS_EXEC) and
                _any_root_allows(profile.fs_exec_roots, path)
        case CapabilityKind.ProcessSpawn:
            has_right(profile.rights, LLM_RIGHT_PROCESS_SPAWN)
        case _:
            false

fn _requires_unimplemented_broker(profile: LlmProfile) -> bool:
    has_right(profile.rights, LLM_RIGHT_NET) or
        has_right(profile.rights, LLM_RIGHT_SECRETS) or
        has_right(profile.rights, LLM_RIGHT_UI_CLIPBOARD) or
        has_right(profile.rights, LLM_RIGHT_UI_SCREENSHOT) or
        has_right(profile.rights, LLM_RIGHT_DEVICE) or
        has_right(profile.rights, LLM_RIGHT_MODEL_ACCESS)

fn _agent_depth_limited_grant(grant_in: CapGrant, allowed_child_depth: u64) -> CapGrant:
    """Compile the agent's declared child-depth into ProcessSpawn lineage.

    The generic CSpace mint already makes `AttenuationSpec.depth_limit`
    authoritative. Applying it here means `allowed_child_depth` is not merely
    lifecycle metadata: any descendant spawn must consume the attenuated token
    depth and therefore cannot outlive the profile's delegation bound.
    """
    var grant = grant_in
    match grant.requested:
        case CapabilityKind.ProcessSpawn:
            var atten = grant.atten
            var depth_limit = allowed_child_depth as i64
            if atten.depth_limit >= 0 and atten.depth_limit < depth_limit:
                depth_limit = atten.depth_limit
            atten.depth_limit = depth_limit
            grant.atten = atten
        case _:
            pass
    grant

pub fn compile_agent_policy(spec: AgentPolicySpec) -> Result<CompiledAgentPolicy, text>:
    """Compile a profile-bounded agent execution policy, failing closed.

    Every requested workload grant must be justified by the effective profile's
    typed filesystem root or ProcessSpawn right.  Profile dimensions without a
    broker capability are rejected rather than silently converted into ambient
    authority.  Budgets are nonzero and model tokens may not exceed the profile
    ceiling.
    """
    if spec.allowed_child_depth == 0u64:
        return Err("agent requires a non-zero child depth")
    if spec.allowed_child_depth > 9223372036854775807u64:
        return Err("agent child depth exceeds kernel capability range")
    if spec.model_token_budget == 0u64 or spec.tool_call_budget == 0u64:
        return Err("agent requires non-zero model and tool budgets")
    if spec.approval_policy == "":
        return Err("agent requires an explicit approval policy")
    if spec.profile.max_tokens <= 0 or spec.model_token_budget > spec.profile.max_tokens as u64:
        return Err("agent model token budget exceeds profile ceiling")
    if spec.profile.max_wallclock_sec <= 0 or
        spec.workload.resources.wall_time_ms > spec.profile.max_wallclock_sec as u64 * 1000u64:
        return Err("agent wall time exceeds profile ceiling")
    if _requires_unimplemented_broker(spec.profile):
        return Err("agent profile requires a broker capability not implemented by the kernel")

    for grant in spec.workload.authority.grants:
        if not _profile_allows_grant(spec.profile, grant.requested):
            return Err("agent workload grant exceeds effective profile")

    var workload = spec.workload
    var grants: [CapGrant] = []
    for grant in workload.authority.grants:
        grants.push(_agent_depth_limited_grant(grant, spec.allowed_child_depth))
    workload.authority.grants = grants
    val execution = compile_workload_manifest(workload)
    if execution.is_err():
        return Err(execution.unwrap_err())
    Ok(CompiledAgentPolicy(
        execution: execution.unwrap(),
        allowed_child_depth: spec.allowed_child_depth,
        model_token_budget: spec.model_token_budget,
        tool_call_budget: spec.tool_call_budget,
        approval_policy: spec.approval_policy
    ))
