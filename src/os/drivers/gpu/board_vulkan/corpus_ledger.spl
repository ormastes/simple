# No-silent-truncation ledger for the board Vulkan conformance corpus.
#
# The thing every single-case comparison in this project answers is "does
# this one input agree at this boundary". None of them answer "did the
# corpus we CLAIM to have run actually run". A corpus can shrink silently in
# three ways: a case gets dropped from execution while still being declared
# (nobody notices because the remaining cases all pass), a case gets skipped
# with no reason recorded (so the skip can't be audited later), or the whole
# corpus quietly executes zero cases (a vacuous "0 failures" pass). This
# module makes each of those three shapes a hard ledger failure rather than
# something a clean summary line can hide.
#
# The ledger is deliberately pure accounting over declared/executed/skipped
# id sets plus a verdict map — it does not itself invoke any tool, so its
# failure modes can be proven with plain data (see the spec's sabotage
# proofs) independent of whether glslangValidator/spirv-val happen to be
# installed on the machine running the test.

pub struct SkipEntry:
    case_id: text
    reason: text

pub struct LedgerReport:
    declared: i64
    executed: i64
    skipped: i64
    no_verdict: i64
    ok: bool
    failure_reason: text

fn contains_text(items: [text], needle: text) -> bool:
    var found = false
    for item in items:
        if item == needle:
            found = true
    found

# declared_ids: every case id the corpus CLAIMS to cover.
# executed_ids: case ids that were actually run through the executor.
# skips: case ids that were deliberately not run, each with a named reason.
# verdict_ids: case ids for which a verdict (pass/fail/non_correspond_confirmed/
#   anomaly) was actually produced by the executor.
pub fn build_ledger(
    declared_ids: [text],
    executed_ids: [text],
    skips: [SkipEntry],
    verdict_ids: [text]
) -> LedgerReport:
    val declared = declared_ids.len()
    val executed = executed_ids.len()
    val skipped = skips.len()

    # Rule 1: a skip with an empty (or whitespace-only) reason is a failure —
    # an unexplained skip is indistinguishable from a silently dropped case.
    for skip in skips:
        if skip.reason.trim() == "":
            return LedgerReport(
                declared: declared, executed: executed, skipped: skipped, no_verdict: -1,
                ok: false,
                failure_reason: "empty skip reason for case '" + skip.case_id + "'"
            )

    # Rule 2: every declared id must be accounted for as either executed or
    # named-skipped. Nothing may vanish silently, and nothing "executed" may
    # be a phantom id that was never declared.
    var accounted = 0
    for case_id in declared_ids:
        val was_executed = contains_text(executed_ids, case_id)
        var was_skipped = false
        for skip in skips:
            if skip.case_id == case_id:
                was_skipped = true
        if was_executed:
            accounted = accounted + 1
        if was_skipped:
            accounted = accounted + 1
        if (not was_executed) and (not was_skipped):
            return LedgerReport(
                declared: declared, executed: executed, skipped: skipped, no_verdict: -1,
                ok: false,
                failure_reason: "declared case '" + case_id + "' was neither executed nor skipped-with-reason"
            )
        if was_executed and was_skipped:
            return LedgerReport(
                declared: declared, executed: executed, skipped: skipped, no_verdict: -1,
                ok: false,
                failure_reason: "case '" + case_id + "' is both executed and skipped — accounting is ambiguous"
            )

    if declared != executed + skipped:
        return LedgerReport(
            declared: declared, executed: executed, skipped: skipped, no_verdict: -1,
            ok: false,
            failure_reason: (
                "declared (" + declared.to_text() + ") != executed (" + executed.to_text()
                + ") + skipped (" + skipped.to_text() + ")"
            )
        )

    # Rule 3: zero executed cases is a failure even if nothing "failed" — a
    # corpus that ran nothing cannot support any conformance claim.
    if executed == 0:
        return LedgerReport(
            declared: declared, executed: executed, skipped: skipped, no_verdict: 0,
            ok: false,
            failure_reason: "zero executed cases — a corpus run must execute at least one case"
        )

    # Rule 4: every executed case must have produced a verdict. An executed
    # case with no verdict is a case that ran and then vanished before being
    # judged — the same silent-drop failure, one stage later.
    var no_verdict_count = 0
    for case_id in executed_ids:
        if not contains_text(verdict_ids, case_id):
            no_verdict_count = no_verdict_count + 1
    if no_verdict_count > 0:
        return LedgerReport(
            declared: declared, executed: executed, skipped: skipped, no_verdict: no_verdict_count,
            ok: false,
            failure_reason: no_verdict_count.to_text() + " executed case(s) produced no verdict"
        )

    LedgerReport(
        declared: declared, executed: executed, skipped: skipped, no_verdict: 0,
        ok: true, failure_reason: ""
    )
