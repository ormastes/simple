# Board Vulkan — Adreno A6xx-class command-stream encoder (Lane E1, stage 3
# "submit" of the per-SoC ladder in
# doc/03_plan/os/vulkan/board_vulkan_parallel_soc_lanes_2026-08-10.md).
#
# Counterpart: Mesa `turnip` (freedreno family). Replaces the 25-line profile
# stub in `backend_adreno.spl` with a real PM4/CP command-stream encoder for
# the A6xx generation (A650/RB5 and siblings).
#
# WHY THIS NEEDS NO HARDWARE: encoding a command stream is deterministic
# computation over a documented instruction format. The GPU is required only
# to EXECUTE the stream (stage 4, out of scope here) — not to produce the
# bytes turnip would produce for the identical submission. This file is the
# thin per-SoC backend; the SoC-neutral submission core described in
# doc/04_architecture/os/vulkan/simpleos_board_vulkan_driver_architecture_2026-08-10.md
# does not exist yet as a separate module (grepped: no `core` file under this
# directory) — that is a real, separate gap, not something this backend can
# manufacture. This file is written so that future core can drive it: every
# public function takes plain data (opcode/register/dword lists) and returns
# plain dword arrays, no per-backend state.
#
# === Packet format facts, with provenance and confidence ===
#
# Adreno's Command Processor (CP) since A5xx/A6xx uses two packet forms
# (superseding the older PKT0/PKT1/PKT3 PM4 scheme used on A3xx/A4xx):
#
#   PKT4 — register-range write. Writes `count` sequential 32-bit registers
#          starting at `regaddr`, payload = the register values themselves.
#   PKT7 — everything else (draws, state loads, events, NOP). `opcode`
#          selects the CP command; payload is opcode-specific.
#
# This is public, well-documented CP command-stream structure (freedreno /
# turnip open-source driver stack, Linux `drm/msm` UAPI counterpart). The
# exact bit layout below is transcribed from memory of the freedreno/turnip
# `adreno_pm4.xml`-derived headers and is marked CONFIDENT where the same
# constant recurs across multiple independent memories of that source, and
# UNCERTAIN where a single detail could not be cross-checked. Any UNCERTAIN
# field must be confirmed against a real `adreno_pm4.xml` (mesa3d.org
# `src/freedreno/registers/adreno_pm4.xml`) or a captured turnip trace before
# this encoder is trusted for real silicon.
#
#   PKT4 header (32-bit dword):
#     bits [31:28] = 0x4                    -- CP_TYPE4_PKT magic. CONFIDENT
#                                               (recurs identically across
#                                               every freedreno-derived source
#                                               excerpt this was learned from)
#     bits [26:27] = 0                      -- reserved/must-be-zero. UNCERTAIN
#                                               exact width; treated as MBZ
#     bits [8:25]  = regaddr (18 bits)      -- register offset. CONFIDENT on
#                                               bit position 8; UNCERTAIN on
#                                               the exact upper width (18 vs a
#                                               narrower field) — regaddr is
#                                               masked defensively below
#     bit  [7]     = 0                      -- reserved. UNCERTAIN
#     bits [0:6]   = count (7 bits)         -- number of register-value
#                                               dwords following. CONFIDENT
#                                               (7-bit count is the detail
#                                               most consistently recalled)
#
#   PKT7 header (32-bit dword):
#     bits [31:28] = 0x7                    -- CP_TYPE7_PKT magic. CONFIDENT
#     bits [24:27] = 0                      -- reserved/must-be-zero. UNCERTAIN
#                                               exact width
#     bit  [23]    = 1                      -- fixed flag bit seen set in every
#                                               PKT7 header recalled from that
#                                               source; exact semantic name
#                                               (some notes call it a
#                                               "count-valid" or predicate bit)
#                                               is UNCERTAIN — encoded as a
#                                               constant 1 here, never derived
#                                               from caller input
#     bits [16:22] = opcode (7 bits)        -- CP command opcode. CONFIDENT on
#                                               7-bit width (matches known
#                                               opcode values: CP_NOP=0x10,
#                                               CP_LOAD_STATE6=0x30,
#                                               CP_DRAW_INDX_OFFSET=0x38,
#                                               CP_SET_DRAW_STATE=0x43, all
#                                               <0x7F)
#     bits [14:15] = 0                      -- reserved. UNCERTAIN
#     bits [0:13]  = count (14 bits)        -- number of payload dwords
#                                               following. UNCERTAIN exact
#                                               width (14 vs a neighbouring
#                                               value); masked defensively
#
# Dword ORDER is header first, then payload dwords in the order the CP
# command defines them (PKT4: register values in ascending register-offset
# order; PKT7: opcode-defined operand order) — this is not a bit-layout
# guess, it is how every PM4-family command processor since PM4 R600 reads a
# ring buffer: sequentially, header-then-operands, no reordering.

pub val PKT4_TYPE_SHIFT: i64 = 28
pub val PKT4_TYPE_VALUE: i64 = 4
pub val PKT4_REGADDR_SHIFT: i64 = 8
pub val PKT4_REGADDR_MASK: i64 = 0x3FFFF
pub val PKT4_COUNT_MASK: i64 = 0x7F

pub val PKT7_TYPE_SHIFT: i64 = 28
pub val PKT7_TYPE_VALUE: i64 = 7
pub val PKT7_FIXED_FLAG_SHIFT: i64 = 23
pub val PKT7_OPCODE_SHIFT: i64 = 16
pub val PKT7_OPCODE_MASK: i64 = 0x7F
pub val PKT7_COUNT_MASK: i64 = 0x3FFF

# CP opcodes needed for the minimal submission below. Values are the
# well-known freedreno/turnip constants (CONFIDENT — small integers reused
# across many public tools such as `crashdec`/`fddec`).
pub val CP_NOP: i64 = 0x10
pub val CP_LOAD_STATE6: i64 = 0x30
pub val CP_DRAW_INDX_OFFSET: i64 = 0x38
pub val CP_SET_DRAW_STATE: i64 = 0x43

pub struct EncodeError:
    field_name: text
    message: text

fn encode_error(field_name: text, message: text) -> EncodeError:
    EncodeError(field_name: field_name, message: message)

# --- PKT4 (register write) ---

pub fn pkt4_header_checked(regaddr: i64, count: i64) -> Result<i64, EncodeError>:
    if regaddr < 0 or regaddr > PKT4_REGADDR_MASK:
        return Err(encode_error("regaddr", "regaddr out of 18-bit range for PKT4"))
    if count < 0 or count > PKT4_COUNT_MASK:
        return Err(encode_error("count", "count out of 7-bit range for PKT4"))
    val header = (PKT4_TYPE_VALUE << PKT4_TYPE_SHIFT) | (regaddr << PKT4_REGADDR_SHIFT) | count
    Ok(header)

pub fn pkt4_decode_type(header: i64) -> i64:
    (header >> PKT4_TYPE_SHIFT) & 0xF

pub fn pkt4_decode_regaddr(header: i64) -> i64:
    (header >> PKT4_REGADDR_SHIFT) & PKT4_REGADDR_MASK

pub fn pkt4_decode_count(header: i64) -> i64:
    header & PKT4_COUNT_MASK

# Encode a register-range write: header dword followed by `values` in
# ascending-register order, one dword per register.
pub fn encode_pkt4(regaddr: i64, values: [i64]) -> Result<[i64], EncodeError>:
    val header = pkt4_header_checked(regaddr, values.len())?
    var out: [i64] = [header]
    for v in values:
        out.push(v)
    Ok(out)

# --- PKT7 (CP command) ---

pub fn pkt7_header_checked(opcode: i64, count: i64) -> Result<i64, EncodeError>:
    if opcode < 0 or opcode > PKT7_OPCODE_MASK:
        return Err(encode_error("opcode", "opcode out of 7-bit range for PKT7"))
    if count < 0 or count > PKT7_COUNT_MASK:
        return Err(encode_error("count", "count out of 14-bit range for PKT7"))
    val header = (PKT7_TYPE_VALUE << PKT7_TYPE_SHIFT) | (1 << PKT7_FIXED_FLAG_SHIFT) | (opcode << PKT7_OPCODE_SHIFT) | count
    Ok(header)

pub fn pkt7_decode_type(header: i64) -> i64:
    (header >> PKT7_TYPE_SHIFT) & 0xF

pub fn pkt7_decode_opcode(header: i64) -> i64:
    (header >> PKT7_OPCODE_SHIFT) & PKT7_OPCODE_MASK

pub fn pkt7_decode_count(header: i64) -> i64:
    header & PKT7_COUNT_MASK

# Encode a CP command: header dword followed by `payload` operand dwords in
# the opcode-defined order (caller's responsibility — this function does not
# know per-opcode operand semantics, only the header framing).
pub fn encode_pkt7(opcode: i64, payload: [i64]) -> Result<[i64], EncodeError>:
    val header = pkt7_header_checked(opcode, payload.len())?
    var out: [i64] = [header]
    for v in payload:
        out.push(v)
    Ok(out)

# --- Minimal real submission ---
#
# A small but complete command stream: one register write (a placeholder
# viewport-scale style register at an arbitrary in-range offset — the exact
# GRAS_CL_VIEWPORT_* register offset is a further UNCERTAIN fact this file
# does not claim; `0x2000` is a stand-in register address, not a verified
# A6xx register number) followed by one indexed draw and a terminating NOP.
# This is deliberately small and correct rather than broad and speculative,
# per this lane's mandate.
pub fn adreno_minimal_submission() -> Result<[i64], EncodeError>:
    var out: [i64] = []
    val reg_write = encode_pkt4(0x2000, [1, 0, 0, 0])?
    for d in reg_write:
        out.push(d)
    # CP_DRAW_INDX_OFFSET operands here are placeholders (vertex count = 3,
    # a single triangle) — the real turnip operand encoding for this opcode
    # (primitive topology packed into which operand dword) is a further
    # UNCERTAIN fact, not claimed as verified.
    val draw = encode_pkt7(CP_DRAW_INDX_OFFSET, [0, 3])?
    for d in draw:
        out.push(d)
    val nop = encode_pkt7(CP_NOP, [])?
    for d in nop:
        out.push(d)
    Ok(out)
