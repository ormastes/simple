# Board Vulkan backend — Imagination IMG BXE-4-32 (StarFive JH7110 / VisionFive 2).
#
# Lane B2. Counterpart: Mesa `powervr`.
# Kernel interface is the powervr DRM UAPI plus the JH7110 firmware load; the
# GPU is behind its own power domain and clock tree, so probe order differs
# from every other lane here.
#
# The source-side PowerVR job envelope is pinned to the Linux UAPI and encoded
# fail-closed. Submission/readback remain false until firmware/device evidence.
#
# TODO(hw-gated): validate encoder_img_bxe.spl against a live PowerVR kernel,
# firmware, and device, then flip submit_implemented — see
# test/03_system/os/vulkan/board_vulkan_img_bxe_submit_readback_system_spec.spl
# and doc/08_tracking/bug/img_bxe_submit_encoder_envelope_only_no_kernel_uapi_verification_2026-08-11.md

use os.drivers.gpu.board_vulkan.soc_profile.{BoardGpuProfile, board_gpu_profile}

fn img_bxe_board_profile() -> BoardGpuProfile:
    board_gpu_profile(
        "starfive-jh7110",
        "img-bxe-4-32",
        "mesa-powervr",
        "mesa",
        "drm-powervr",
        "visionfive2",
        false,
        true,
        false,
        false
    )
