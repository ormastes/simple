# Board Vulkan readback boundary — `vulkan.present.readback_image@1`.
#
# This is the pixels a render actually produced. It is the one boundary in the
# board Vulkan architecture that genuinely requires the board (see
# doc/04_architecture/os/vulkan/simpleos_board_vulkan_driver_architecture_2026-08-10.md):
# SPIR-V and the command stream can be produced and compared on a host with no
# GPU, but a device-origin frame cannot be honestly faked on the CPU.
#
# This file owns exactly one thing: given an ExecutionReceipt for a candidate
# readback, decide pass/reject with a full-sentence reason naming the specific
# field that failed. It reuses `execution_receipt_gpu_gate_failures` from the
# frozen model rather than re-implementing the GPU gate, and adds the two
# additional readback-specific checks the plan calls for: the image bytes
# themselves must match the counterpart exactly (`image_exact`, no tolerance —
# see `board_vulkan_readback_relation`), and the receipt must be for THIS
# boundary's execution mode.
#
# Candidate viability note (2026-08-10): `src/os/compositor/vulkan_compositor_backend.spl`
# returns the literal string "vulkan_venus_session_not_implemented:qemu_only:board_gap_open"
# — SimpleOS has no board Vulkan render path today. `board_vulkan_readback_attempt_status`
# below is how that honestly surfaces as `unavailable`, never as a pass.
#
# Plan: doc/03_plan/os/vulkan/board_vulkan_parallel_soc_lanes_2026-08-10.md
# Model: src/lib/common/spec/evidence/counterpart/model.spl (frozen, do not edit)

use std.common.spec.evidence.counterpart.model.{
    CounterpartRelation,
    ExecutionReceipt, ProviderStatus,
    execution_receipt_gpu_gate_failures
}
use os.drivers.gpu.board_vulkan.boundary_readback_lavapipe_provider.{LavapipeReadbackResult}
use os.drivers.gpu.board_vulkan.soc_profile.{board_vulkan_boundary_readback}

# One readback candidate: the receipt describing how the frame was produced,
# plus the frame's bytes (a caller-chosen stable encoding, e.g. a pixel-hash
# string) and the same encoding for the reference frame from the deterministic
# software counterpart (lavapipe).
pub struct ReadbackCandidate:
    receipt: ExecutionReceipt
    candidate_image_bytes: text
    reference_image_bytes: text
    reference_status: ProviderStatus

pub fn readback_candidate_from_counterpart(
    receipt: ExecutionReceipt,
    candidate_image_bytes: text,
    counterpart: LavapipeReadbackResult
) -> ReadbackCandidate:
    ReadbackCandidate(
        receipt: receipt,
        candidate_image_bytes: candidate_image_bytes,
        reference_image_bytes: counterpart.reference_image_bytes,
        reference_status: counterpart.status
    )

# Readback is compared `image_exact` against the deterministic software
# reference. No tolerance: a software rasterizer is bit-reproducible, so any
# pixel difference is a real driver defect, not noise to average away.
pub fn board_vulkan_readback_relation() -> CounterpartRelation:
    CounterpartRelation.image_exact

# The full-sentence rejection reasons for one readback candidate. Every clause
# in the GPU receipt gate is reused verbatim from the frozen model so this file
# cannot quietly diverge from the shared gate; the image-exact check is added
# on top because the receipt alone does not prove the pixels agree.
pub fn readback_boundary_rejections(candidate: ReadbackCandidate) -> [text]:
    var failures: [text] = []
    for reason in execution_receipt_gpu_gate_failures(candidate.receipt):
        failures.push(readback_reason_sentence(reason))
    if candidate.reference_status != ProviderStatus.executed:
        failures.push("Rejected: the lavapipe counterpart did not execute and produce a device readback.")
    else if candidate.candidate_image_bytes != candidate.reference_image_bytes:
        failures.push("image_exact comparison failed: the candidate readback image does not byte-match the lavapipe reference image.")
    failures

# `execution_receipt_gpu_gate_failures` reports terse `field=value` tokens;
# expand each into the full sentence this boundary's gate promises, naming the
# exact field that failed.
fn readback_reason_sentence(reason: text) -> text:
    if reason.starts_with("submission_count"):
        return "Rejected: submission_count is not greater than 0, so no GPU submission was recorded for this readback."
    if reason == "fence_completed=false":
        return "Rejected: fence_completed is false, so the GPU fence for this submission never signalled completion."
    if reason == "device_origin_readback=false":
        return "Rejected: device_origin_readback is false, so the frame was not read back from the device — it cannot be a real readback."
    if reason == "fallback_used=true":
        return "Rejected: fallback_used is true, so this readback silently fell back to a non-device path instead of the board GPU."
    if reason.starts_with("dropped_events"):
        return "Rejected: dropped_events is not 0, so events were lost during this readback's execution."
    if reason.starts_with("execution_mode"):
        return "Rejected: execution_mode is not a GPU mode for this readback."
    if reason == "completed=false":
        return "Rejected: completed is false, so this readback's execution never finished."
    if reason == "device_identity is empty":
        return "Rejected: device_identity is empty, so no device could be identified for this readback."
    "Rejected: " + reason

pub fn readback_boundary_accepted(candidate: ReadbackCandidate) -> bool:
    readback_boundary_rejections(candidate).len() == 0

# ---------------------------------------------------------------------------
# Honest unavailability for the boundary itself (not a specific receipt).
#
# There is no fabricated candidate render path here. Given today's compositor
# backend status string, a real attempt to reach this boundary is unavailable
# — never silently accepted as a pass.
# ---------------------------------------------------------------------------

pub val BOARD_VULKAN_READBACK_NOT_IMPLEMENTED_MARKER: text = "vulkan_venus_session_not_implemented:qemu_only:board_gap_open"

pub enum ReadbackAttemptStatus:
    unavailable
    executed

pub fn readback_attempt_status_name(status: ReadbackAttemptStatus) -> text:
    match status:
        ReadbackAttemptStatus.unavailable => "unavailable"
        ReadbackAttemptStatus.executed => "executed"

# `compositor_status` is whatever `vulkan_compositor_backend.spl` reports for
# the current session. Today it is always the not-implemented marker, so this
# always returns `unavailable` — that IS the correct, honest verdict for the
# `vulkan.present.readback_image@1` boundary on SimpleOS today; it is not a
# gap in this gate.
pub fn board_vulkan_readback_attempt_status(compositor_status: text) -> ReadbackAttemptStatus:
    if compositor_status == BOARD_VULKAN_READBACK_NOT_IMPLEMENTED_MARKER:
        return ReadbackAttemptStatus.unavailable
    if compositor_status == "":
        return ReadbackAttemptStatus.unavailable
    ReadbackAttemptStatus.executed

pub fn board_vulkan_readback_boundary_id() -> text:
    board_vulkan_boundary_readback()
