# Board Vulkan backend — Qualcomm Adreno (A6xx class, e.g. RB5 / QRB5165).
#
# Lane B1. Counterpart: Mesa `turnip` (freedreno family).
# Kernel interface on a real board is the msm DRM UAPI (DRM_MSM_GEM_*,
# DRM_MSM_SUBMITQUEUE_*), not virtio-gpu — that is why this cannot be a
# continuation of the venus work.
#
# Nothing is implemented yet. The profile says so, and the counterpart plan
# turns "not implemented" into a rejection, never a pass.
#
# TODO(hw-gated): write a turnip-comparison adapter mirroring
# cmdstream_adapter_gen12.spl, then flip submit_implemented once an Adreno GPU
# is present — see
# test/03_system/os/vulkan/board_vulkan_adreno_submit_readback_system_spec.spl
# and doc/08_tracking/bug/board_vulkan_cross_arch_boundary_only_x86_64_proven_2026-08-11.md

use os.drivers.gpu.board_vulkan.soc_profile.{BoardGpuProfile, board_gpu_profile}

fn adreno_board_profile() -> BoardGpuProfile:
    board_gpu_profile(
        "qualcomm-qrb5165",
        "adreno-a650",
        "mesa-turnip",
        "mesa",
        "drm-msm",
        "rb5",
        false,
        true,
        false,
        false
    )
