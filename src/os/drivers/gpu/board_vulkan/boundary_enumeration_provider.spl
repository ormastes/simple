# Board Vulkan: provider wiring for the `vulkan.device.enumeration@1` boundary.
#
# Per plan rule 9 ("add a descriptor rather than editing central registries"),
# this file is new and does not touch
# src/lib/common/spec/evidence/counterpart/*.spl or any other shared registry.
# It only builds plan/source data using the existing counterpart model types.
#
# CANDIDATE (Simple): src/lib/nogc_async_mut/gpu/vulkan_icd_virtio.spl and
# src/os/drivers/gpu/gpu_vendor_probe.spl were read in full. Neither exposes a
# real vkEnumeratePhysicalDevices-equivalent:
#   - vulkan_icd_virtio.spl's `_venus_transport_send` (line 52-59) always
#     returns a fabricated VenusCallResult{is_ok:true, handle:<incrementing
#     counter>, payload_size:0} — no device name, no queue family data, no
#     memory heap/type data is ever produced anywhere in that file.
#   - gpu_vendor_probe.spl's five probes (Cuda/Amd/Intel/QualcommArm/RiscvSoft)
#     all hard-code `device_id: 0` in their `.probe()` constructors (e.g.
#     QualcommArmGpuProbe.probe() at line 143-153), which is defined as
#     "unavailable" by their own `is_available()` (`self.device_id > 0`).
# `candidate_enumeration_is_available()` below does NOT hard-code that
# verdict — it CALLS the real candidate functions (GpuVendorRegistry.probe_all
# and the real venus_icd_* transport calls) and derives the answer from their
# actual return values, so a future fix that makes either side report real
# data flips this function without anyone touching it. See
# doc/08_tracking/bug/vulkan_icd_virtio_and_gpu_probe_report_no_real_device_enumeration_2026-08-11.md.
#
# COUNTERPART (Mesa lavapipe, `lvp_icd.json`): real, hardware-free reference,
# executed as an ACTUAL subprocess every time this provider runs —
# `lavapipe_reference_enumeration()` below shells out to
#   VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json vulkaninfo
# via `shell()` (src/lib/nogc_sync_mut/io/process_ops.spl) and PARSES the real
# stdout into the canonical record — it is not a literal copied from a
# one-time manual read. If `vulkaninfo` or the lvp ICD is not present on the
# host running this provider, parsing fails closed: the function returns nil
# and the caller must treat the source as ProviderStatus.unavailable, never
# substitute a literal.
#
# anv (Intel, intel_icd.json), lavapipe (lvp_icd.json) and venus-via-Mesa
# (virtio_icd.json, when it decodes to a Mesa host driver) are ALL Mesa: one
# independence group, not three. See
# doc/04_architecture/os/vulkan/simpleos_board_vulkan_driver_architecture_2026-08-10.md
# "Independence groups matter here."

use std.common.spec.evidence.counterpart.model.{
    OracleAuthority,
    PlanSource,
    ProviderStatus,
    plan_source
}
use os.drivers.gpu.board_vulkan.boundary_enumeration_model.{
    DeviceEnumerationRecord,
    DeviceLimitRecord,
    MemoryHeapRecord,
    MemoryTypeRecord,
    QueueFamilyRecord,
    vulkan_enumeration_boundary_id
}
use os.drivers.gpu.gpu_vendor_probe.{GpuVendorRegistry}
use std.nogc_async_mut.gpu.vulkan_icd_virtio.{
    venus_icd_connect,
    venus_icd_create_device,
    venus_icd_create_instance,
    venus_icd_disconnect
}
use std.nogc_sync_mut.io.process_ops.{shell, ProcessResult}

pub fn vulkan_enumeration_mesa_independence_group() -> text:
    "mesa"

pub fn vulkan_enumeration_source_id_simple() -> text:
    "simple_board_driver"

pub fn vulkan_enumeration_source_id_lavapipe() -> text:
    "mesa_lavapipe"

# The candidate is never its own oracle: self_execution_mode is non-binding,
# matching the existing board_vulkan_plan_sources pattern in
# counterpart_plan.spl.
pub fn vulkan_enumeration_plan_sources() -> [PlanSource]:
    [
        plan_source(
            vulkan_enumeration_source_id_simple(),
            "simple.vulkan_icd_virtio",
            "device_enumeration",
            OracleAuthority.self_execution_mode,
            true
        ),
        plan_source(
            vulkan_enumeration_source_id_lavapipe(),
            "mesa-lavapipe",
            "device_enumeration",
            OracleAuthority.independent_reference,
            true
        )
    ]

# ---------------------------------------------------------------------------
# Candidate reader — honest AND non-tautological. Every check below executes
# the real candidate code and reads its actual return value; nothing here is
# a hard-coded constant standing in for "we know it's a stub".
# ---------------------------------------------------------------------------

# Real call into gpu_vendor_probe.spl: true only if some vendor probe's own
# device_id ends up > 0. Today every probe hard-codes device_id: 0, so this
# is false — but it is false because the CALL returned 0, not because this
# function says so.
fn _vendor_probe_reports_any_device() -> bool:
    val registry = GpuVendorRegistry.create()
    registry.probe_all() > 0

# Real call into vulkan_icd_virtio.spl's modeled Venus transport. A
# meaningful device-enumeration signal from Venus would show up as a
# non-zero `payload_size` on the create_device response (a real Venus
# VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES reply carries a payload).
# The modeled transport always returns payload_size: 0
# (`_venus_transport_send`, vulkan_icd_virtio.spl:52-59), so this reads that
# real return value rather than asserting it.
fn _venus_transport_reports_device_payload() -> bool:
    venus_icd_connect("/dev/vgpu0-probe", 4096)
    val instance = venus_icd_create_instance()
    if not instance.is_ok:
        venus_icd_disconnect()
        return false
    val device = venus_icd_create_device(instance.handle)
    venus_icd_disconnect()
    device.is_ok and device.payload_size > 0

pub fn candidate_enumeration_is_available() -> bool:
    _vendor_probe_reports_any_device() or _venus_transport_reports_device_payload()

pub fn candidate_enumeration_status() -> ProviderStatus:
    if candidate_enumeration_is_available():
        ProviderStatus.executed
    else:
        ProviderStatus.unavailable

# ---------------------------------------------------------------------------
# Counterpart execution — a REAL subprocess run of vulkaninfo against the
# lavapipe ICD, parsed into the canonical schema. No literal stands in for
# this: if the subprocess or the ICD is missing, parsing returns nil.
# ---------------------------------------------------------------------------

fn _lavapipe_vulkaninfo_command() -> text:
    "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json vulkaninfo 2>/dev/null"

fn _line_value_after(line: text, marker: text) -> text?:
    if not line.contains(marker):
        return nil
    val eq_parts = line.split("=")
    if eq_parts.len() < 2:
        return nil
    eq_parts[1].trim()

fn _first_value(lines: [text], marker: text) -> text?:
    for line in lines:
        if line.contains(marker):
            val value = _line_value_after(line, marker)
            if value.?:
                return value
    nil

fn _hex_digit_value(ch: text) -> i64:
    if ch >= "0" and ch <= "9":
        ch.char_code_at(0) - "0".char_code_at(0)
    else if ch >= "a" and ch <= "f":
        (ch.char_code_at(0) - "a".char_code_at(0)) + 10
    else if ch >= "A" and ch <= "F":
        (ch.char_code_at(0) - "A".char_code_at(0)) + 10
    else:
        0

fn _hex_to_i64(raw: text) -> i64:
    var text_value = raw.trim()
    if text_value.starts_with("0x") or text_value.starts_with("0X"):
        text_value = text_value[2:text_value.len()]
    var result: i64 = 0
    var i: i64 = 0
    while i < text_value.len():
        result = result * 16 + _hex_digit_value(text_value[i:i + 1])
        i = i + 1
    result

# Splits a `A | B | C` (or single-token) flags value into a trimmed list.
fn _split_flags(raw: text) -> [text]:
    var out: [text] = []
    for part in raw.split("|"):
        val trimmed = part.trim()
        if trimmed != "":
            out.push(trimmed)
    out

fn _find_block(lines: [text], start_marker: text, stop_markers: [text]) -> [text]:
    var collecting = false
    var block: [text] = []
    for line in lines:
        if collecting:
            var stop = false
            for stop_marker in stop_markers:
                if line.contains(stop_marker):
                    stop = true
            if stop:
                return block
            block.push(line)
        else if line.contains(start_marker):
            collecting = true
    block

fn _flag_lines(lines: [text], prefix: text) -> [text]:
    var out: [text] = []
    for line in lines:
        val trimmed = line.trim()
        if trimmed.starts_with(prefix):
            out.push(trimmed)
    out

# Parses one `vulkaninfo` transcript for GPU0 into the canonical schema.
# Returns nil (fail closed) if any required section is missing, rather than
# guessing or substituting a default — a partial parse is not evidence.
pub fn parse_vulkaninfo_lavapipe(output: text) -> DeviceEnumerationRecord?:
    if output.trim() == "":
        return nil
    val lines = output.split("\n")

    val device_name = _first_value(lines, "deviceName")
    val vendor_id_raw = _first_value(lines, "vendorID")
    val device_id_raw = _first_value(lines, "deviceID")
    val api_version_raw = _first_value(lines, "apiVersion")
    if not device_name.? or not vendor_id_raw.? or not device_id_raw.? or not api_version_raw.?:
        return nil

    val api_parts = api_version_raw.split(".")
    if api_parts.len() < 2:
        return nil

    val queue_count_raw = _first_value(lines, "queueCount")
    val queue_flags_raw = _first_value(lines, "queueFlags")
    if not queue_count_raw.? or not queue_flags_raw.?:
        return nil
    val queue_families = [
        QueueFamilyRecord(
            flags: _split_flags(queue_flags_raw),
            queue_count: queue_count_raw.to_i64()
        )
    ]

    val heap_block = _find_block(lines, "memoryHeaps[0]:", ["memoryTypes:", "VkPhysicalDeviceFeatures"])
    val heap_flags = _flag_lines(heap_block, "MEMORY_HEAP_")
    if heap_flags.len() == 0:
        return nil
    val memory_heaps = [
        MemoryHeapRecord(heap_index: 0, flags: heap_flags)
    ]

    val type_block = _find_block(lines, "memoryTypes[0]:", ["usable for:", "VkPhysicalDeviceFeatures"])
    val type_flags = _flag_lines(type_block, "MEMORY_PROPERTY_")
    if type_flags.len() == 0:
        return nil
    val memory_types = [
        MemoryTypeRecord(type_index: 0, heap_index: 0, flags: type_flags)
    ]

    var limits: [DeviceLimitRecord] = []
    for limit_name in [
        "maxImageDimension2D",
        "maxComputeWorkGroupInvocations",
        "maxMemoryAllocationCount"
    ]:
        val raw_value = _first_value(lines, limit_name)
        if raw_value.?:
            limits.push(DeviceLimitRecord(name: limit_name, value: raw_value.to_i64()))
    if limits.len() == 0:
        return nil

    DeviceEnumerationRecord(
        device_name: device_name,
        vendor_id: _hex_to_i64(vendor_id_raw),
        device_id: _hex_to_i64(device_id_raw),
        api_version_major: api_parts[0].to_i64(),
        api_version_minor: api_parts[1].to_i64(),
        queue_families: queue_families,
        memory_heaps: memory_heaps,
        memory_types: memory_types,
        limits: limits
    )

# Runs the real subprocess and parses its real output. nil means the run
# genuinely could not produce evidence (no vulkaninfo, no lvp ICD on this
# host) — callers must report ProviderStatus.unavailable for this source,
# never substitute a fixture.
pub fn lavapipe_reference_enumeration() -> DeviceEnumerationRecord?:
    val result: ProcessResult = shell(_lavapipe_vulkaninfo_command())
    if result.exit_code != 0:
        return nil
    parse_vulkaninfo_lavapipe(result.stdout)

pub fn lavapipe_source_status() -> ProviderStatus:
    if lavapipe_reference_enumeration().?:
        ProviderStatus.executed
    else:
        ProviderStatus.unavailable

pub fn vulkan_enumeration_boundary() -> text:
    vulkan_enumeration_boundary_id()
