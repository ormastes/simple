# Board Vulkan — SPIR-V boundary capture and counterpart provider descriptor.
#
# Boundary: `vulkan.shader.spirv_binary@1`.
# Candidate: compiler.backend.vulkan.spirv_builder.SpirvBuilder — the only
#   piece of Simple source that emits SPIR-V. It is a low-level instruction
#   builder (no GLSL/HLSL front end), so the fixture below drives it directly,
#   through its PUBLIC api only (typed helpers plus the raw `emit()` escape
#   hatch it already exposes for opcodes with no typed helper, the same way
#   the OpFunction line is built), to construct a module that mirrors what
#   glslangValidator emits for the equivalent GLSL compute shader —
#   INCLUDING glslang's unconditional, unreferenced `gl_WorkGroupSize`
#   builtin constant-composite and its `OpExtInstImport "GLSL.std.450"`. The
#   canonicalizer does not get to erase either of those on the candidate's
#   behalf (see boundary_spirv_canonicalize.spl); if the candidate is to agree
#   with glslang it has to actually emit them.
# Counterpart: /usr/bin/glslangValidator, a `process_bridge` provider,
#   independence group `khronos-glslang` (NOT `mesa` — glslang is Khronos's
#   own reference compiler, not a Mesa component). It compiles the
#   semantically equivalent GLSL compute shader source.
#
# Both binaries are additionally run through `spirv-val` BEFORE disassembly:
# an assembled module that is not valid SPIR-V is a captured failure, never
# silently compared. This is also the standing guard against the
# canonicalizer over-normalizing in the future — a canonical form that could
# only be produced by an invalid module would mean the earlier binary was
# already broken, and `spirv-val` catches that upstream of the text diff
# (e.g. a function body with no `OpLabel` fails `spirv-val` with "Return must
# appear in a block" even though `spirv-as` itself accepts it).
#
# `--target-env vulkan1.0` and SPIR-V 1.0 are used on both sides on purpose:
# it is the lowest common target both the builder (SpirvBuilder.create([1,0]))
# and glslangValidator's default support.

use plugins.backend_vulkan.vulkan.spirv_builder.{SpirvBuilder}
use std.nogc_sync_mut.io_runtime.{file_exists, mkdir_p, read_file, write_file}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.spec.evidence.counterpart.package_registry.{artifact_sha256_of_file}
use std.nogc_sync_mut.spec.evidence.counterpart.provider_registry.{
    ProviderRegistry,
    component_manifest,
    provider_manifest,
    provider_registry,
    provider_registry_register
}
use std.common.spec.evidence.counterpart.model.{ComponentManifest, ProviderKind, ProviderManifest}
use os.drivers.gpu.board_vulkan.soc_profile.{board_vulkan_boundary_spirv}
use os.drivers.gpu.board_vulkan.boundary_spirv_canonicalize.{spirv_canonical_text}

pub val SPIRV_BOUNDARY_TMP_DIR: text = "build/board_vulkan/spirv_boundary"
pub val SPIRV_AS_PATH: text = "/usr/bin/spirv-as"
pub val SPIRV_DIS_PATH: text = "/usr/bin/spirv-dis"
pub val SPIRV_VAL_PATH: text = "/usr/bin/spirv-val"
pub val GLSLANG_PATH: text = "/usr/bin/glslangValidator"

fn spirv_run(cmd: text, args: [text]) -> (text, text, i64):
    process_run_bounded(cmd, args, 30000, 4194304)

# === Candidate: build the minimal compute shader through SpirvBuilder ===
#
# Three independent fault-injection knobs, each used by exactly one spec
# scenario:
#   `bad_workgroup_z` — flips the Z workgroup-size LITERAL (1 -> 2): the
#       mandatory sabotage proof. A real value divergence.
#   `drop_label`       — omits `emit_label()` entirely: proves the comparison
#       cannot be fooled by a structurally invalid module (spirv-val catches
#       it before the text diff even runs).
#   `drop_extinst`     — omits the `OpExtInstImport` line: proves the
#       canonicalizer no longer treats an unreferenced-but-real instruction as
#       droppable debug noise.
pub fn spirv_candidate_module_text(bad_workgroup_z: bool, drop_label: bool, drop_extinst: bool) -> text:
    val builder = SpirvBuilder.create([1, 0])
    builder.emit_header()
    builder.emit_capabilities()
    if not drop_extinst:
        val ext_id = builder.alloc_id()
        builder.emit("{builder.id_str(ext_id)} = OpExtInstImport \"GLSL.std.450\"")
    builder.emit_extensions()
    builder.emit_memory_model()

    val main_id = builder.alloc_id()
    builder.emit_entry_point("main", main_id, [])
    val local_z = if bad_workgroup_z: 2 else: 1
    builder.emit_execution_mode(main_id, [1, 1, local_z])

    # Mirrors glslang's unconditional `gl_WorkGroupSize` builtin composite:
    # OpDecorate precedes the type/const declarations it targets, which is
    # a legitimate SPIR-V forward reference (the decorated id is only
    # DEFINED, never used as an operand, at the point of decoration).
    val composite_id = builder.alloc_id()
    builder.emit_decorate(composite_id, "BuiltIn WorkgroupSize")

    val void_id = builder.emit_type_void()
    val fn_type_id = builder.emit_type_function(void_id, [])
    val uint_id = builder.emit_type_int(32, false)
    val v3uint_id = builder.emit_type_vector(uint_id, 3)
    val uint1_id = builder.emit_const_int(uint_id, 1)
    builder.emit("{builder.id_str(composite_id)} = OpConstantComposite {builder.id_str(v3uint_id)} {builder.id_str(uint1_id)} {builder.id_str(uint1_id)} {builder.id_str(uint1_id)}")

    builder.emit("{builder.id_str(main_id)} = OpFunction {builder.id_str(void_id)} None {builder.id_str(fn_type_id)}")
    if not drop_label:
        builder.emit_label()
    builder.emit_return()
    builder.emit_function_end()
    builder.build()

# Assembles the candidate module, validates it, and disassembles it back.
# Returns (ok, canonical_disassembly_or_empty, detail). `ok == false` means
# the source is unavailable/crashed/invalid — never a silent pass.
pub fn spirv_candidate_disassembly(bad_workgroup_z: bool, drop_label: bool, drop_extinst: bool) -> (bool, text, text):
    if not file_exists(SPIRV_AS_PATH) or not file_exists(SPIRV_DIS_PATH) or not file_exists(SPIRV_VAL_PATH):
        return (false, "", "spirv-as/spirv-dis/spirv-val not installed at pinned paths")
    mkdir_p(SPIRV_BOUNDARY_TMP_DIR)
    val asm_path = SPIRV_BOUNDARY_TMP_DIR + "/candidate.spvasm"
    val bin_path = SPIRV_BOUNDARY_TMP_DIR + "/candidate.spv"
    write_file(asm_path, spirv_candidate_module_text(bad_workgroup_z, drop_label, drop_extinst))

    val (_as_out, as_err, as_code) = spirv_run(
        SPIRV_AS_PATH, ["--target-env", "vulkan1.0", "-o", bin_path, asm_path])
    if as_code != 0:
        return (false, "", "spirv-as exited " + as_code.to_text() + ": " + as_err)

    val (val_out, val_err, val_code) = spirv_run(SPIRV_VAL_PATH, [bin_path])
    if val_code != 0:
        return (false, "", "spirv-val rejected the candidate module: " + val_out + val_err)

    val (dis_out, dis_err, dis_code) = spirv_run(SPIRV_DIS_PATH, ["--no-header", bin_path])
    if dis_code != 0:
        return (false, "", "spirv-dis exited " + dis_code.to_text() + ": " + dis_err)
    (true, dis_out, "")

# === Counterpart: glslangValidator compiling the equivalent GLSL source ===

pub fn spirv_counterpart_glsl_source() -> text:
    "#version 450\nlayout(local_size_x=1, local_size_y=1, local_size_z=1) in;\nvoid main() {}\n"

pub fn spirv_counterpart_disassembly() -> (bool, text, text):
    if not file_exists(GLSLANG_PATH):
        return (false, "", "glslangValidator not installed at " + GLSLANG_PATH + ": unavailable, not a pass")
    if not file_exists(SPIRV_DIS_PATH) or not file_exists(SPIRV_VAL_PATH):
        return (false, "", "spirv-dis/spirv-val not installed at pinned paths")
    mkdir_p(SPIRV_BOUNDARY_TMP_DIR)
    val src_path = SPIRV_BOUNDARY_TMP_DIR + "/shader.comp"
    val bin_path = SPIRV_BOUNDARY_TMP_DIR + "/glslang.spv"
    write_file(src_path, spirv_counterpart_glsl_source())

    val (gl_out, gl_err, gl_code) = spirv_run(
        GLSLANG_PATH, ["-V", "--target-env", "vulkan1.0", "-S", "comp", "-o", bin_path, src_path])
    if gl_code != 0:
        return (false, "", "glslangValidator exited " + gl_code.to_text() + ": " + gl_out + gl_err)

    val (val_out, val_err, val_code) = spirv_run(SPIRV_VAL_PATH, [bin_path])
    if val_code != 0:
        return (false, "", "spirv-val rejected the counterpart module: " + val_out + val_err)

    val (dis_out, dis_err, dis_code) = spirv_run(SPIRV_DIS_PATH, ["--no-header", bin_path])
    if dis_code != 0:
        return (false, "", "spirv-dis exited " + dis_code.to_text() + ": " + dis_err)
    (true, dis_out, "")

# === Comparison ===
#
# Returns (agree, detail). `agree` is only ever true when BOTH sides captured
# (including spirv-val) successfully AND their canonical text matches; a
# capture failure on either side is reported as disagreement with the failing
# side's detail, never as a pass.
pub fn spirv_boundary_compare(bad_workgroup_z: bool, drop_label: bool, drop_extinst: bool) -> (bool, text):
    val (cand_ok, cand_raw, cand_detail) = spirv_candidate_disassembly(bad_workgroup_z, drop_label, drop_extinst)
    if not cand_ok:
        return (false, "candidate unavailable: " + cand_detail)
    val (cp_ok, cp_raw, cp_detail) = spirv_counterpart_disassembly()
    if not cp_ok:
        return (false, "counterpart unavailable: " + cp_detail)

    val cand_canon = spirv_canonical_text(cand_raw)
    val cp_canon = spirv_canonical_text(cp_raw)
    val agree = cand_canon == cp_canon
    val detail = "candidate:\n" + cand_canon + "\n---counterpart---\n" + cp_canon
    (agree, detail)

# Convenience for the common clean case.
pub fn spirv_boundary_compare_clean() -> (bool, text):
    spirv_boundary_compare(false, false, false)

# === Fixture-backed comparison (no subprocess) ===
#
# The full exec round trip (glslangValidator -> spirv-val -> spirv-dis, TWICE,
# once per side) measurably does not fit even a 900s test-worker budget under
# this host's load (see doc/08_tracking/bug/spirv_boundary_glslang_exec_exceeds_900s_daemon_budget_2026-08-11.md).
# So the everyday comparison here is against a COMMITTED fixture captured
# from a real glslangValidator run — provenance, exact commands, and hashes
# in test/fixtures/board_vulkan/spirv_boundary/glslang_minimal_compute.provenance.md.
# Every byte in the fixture originated from glslang, never from this
# candidate and never hand-authored; only the transport is deferred, not the
# source of truth. `spirv_boundary_compare` above (the live exec path) stays
# as the regeneration check that proves the fixture has not drifted from what
# glslang actually emits today.
pub val SPIRV_FIXTURE_PATH: text =
    "test/fixtures/board_vulkan/spirv_boundary/glslang_minimal_compute.spvdis"

pub fn spirv_fixture_disassembly() -> text:
    read_file(SPIRV_FIXTURE_PATH)

# Candidate side of the fixture-backed comparison: `SpirvBuilder.build()`'s
# own text output IS already in the same "%id = OpXxx ..." shape
# `spirv-dis --no-header` produces (it is the format `spirv-as` accepts), so
# no `spirv-as`/`spirv-dis` round trip is needed to get a canonicalizable
# text form — only the `; comment` header lines `build()` adds need
# stripping, which is dimension 4 (assembly_comments) in the canonicalizer.
pub fn spirv_boundary_compare_fixture(bad_workgroup_z: bool, drop_label: bool, drop_extinst: bool) -> (bool, text):
    if not file_exists(SPIRV_FIXTURE_PATH):
        return (false, "counterpart unavailable: fixture missing at " + SPIRV_FIXTURE_PATH)
    val cand_raw = spirv_candidate_module_text(bad_workgroup_z, drop_label, drop_extinst)
    val cp_raw = spirv_fixture_disassembly()
    val cand_canon = spirv_canonical_text(cand_raw)
    val cp_canon = spirv_canonical_text(cp_raw)
    val agree = cand_canon == cp_canon
    val detail = "candidate:\n" + cand_canon + "\n---fixture---\n" + cp_canon
    (agree, detail)

# === Counterpart provider registry descriptor ===
#
# Registered directly (not loaded from a `.sdn` file under
# `config/counterpart/providers/`) because this lane owns only
# `boundary_spirv*.spl`; the descriptor still uses exactly the same
# `provider_manifest`/`component_manifest` constructors any `.sdn`-loaded
# descriptor resolves to, so it goes through the identical
# `provider_manifest_rejections` gate.

pub fn spirv_glslang_component() -> ComponentManifest:
    component_manifest(
        "spirv_binary_glslang",
        board_vulkan_boundary_spirv(),
        "vulkan.shader.glsl_source@1",
        "vulkan.shader.spirv_binary@1",
        "deterministic_given_pinned_toolchain",
        ["byte_exact"],
        ["cpu_reference"]
    )

# The artifact hash is the SHA-256 of the actual installed executable this run
# will invoke, never a fabricated or copy-pasted value — a swapped binary
# changes this hash.
pub fn spirv_glslang_artifact_hash() -> text:
    artifact_sha256_of_file(GLSLANG_PATH)

pub fn spirv_glslang_manifest() -> ProviderManifest:
    provider_manifest(
        "glslang",
        ProviderKind.process_bridge,
        "khronos-glslang",
        1,
        "installed-host-toolchain",
        spirv_glslang_artifact_hash(),
        "Apache-2.0",
        [spirv_glslang_component()]
    )

pub fn spirv_glslang_registry() -> ProviderRegistry:
    provider_registry_register(
        provider_registry(), spirv_glslang_manifest(), GLSLANG_PATH, "")
