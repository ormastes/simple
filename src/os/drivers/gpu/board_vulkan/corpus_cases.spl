# Board Vulkan conformance corpus — case data.
#
# This is lane L7 of the board-Vulkan parallel conformance effort (Wave 4,
# "V7 CTS integration" first slice — see
# doc/03_plan/infra/counterpart/counterpart_conformance_parallel_agent_plan_2026-08-09.md).
#
# NOT the Khronos Vulkan CTS / dEQP. Full VK-GL-CTS is not installed on this
# host (checked: only glslangValidator, spirv-val, spirv-dis, vulkaninfo, and
# Mesa ICDs including lavapipe are present). This is a small, honest, authored
# corpus at the vulkan.shader.spirv_binary@1 boundary: it proves the
# accounting mechanism (corpus_ledger.spl) that keeps a conformance corpus
# from silently shrinking to the cases that happen to pass, and exercises a
# handful of deliberately hostile shader shapes. It is a corpus harness, not
# a conformance certification.

pub val BOUNDARY_SPIRV_BINARY: text = "vulkan.shader.spirv_binary@1"

# kind: "glsl_frag" (compile via glslangValidator then validate via
# spirv-val) or "spirv_binary" (validate the referenced .spv directly, no
# compile step).
#
# expected_relation: "correspond" (the case is expected to produce valid,
# accepted SPIR-V under this boundary) or "non_correspond" (the case is
# EXPECTED to fail validation — e.g. a deliberately corrupt binary — and is
# marked as such rather than forced to compare as if it should pass).
pub struct CorpusCase:
    case_id: text
    boundary: text
    kind: text
    source_path: text
    expected_relation: text
    hostile: bool
    note: text

pub fn board_vulkan_corpus() -> [CorpusCase]:
    [
        CorpusCase(
            case_id: "spirv_binary.empty_shader",
            boundary: BOUNDARY_SPIRV_BINARY,
            kind: "glsl_frag",
            source_path: "test/fixtures/board_vulkan_corpus/case_empty.frag",
            expected_relation: "correspond",
            hostile: true,
            note: "Empty entry point body — minimal legal shader, no bindings, no output writes."
        ),
        CorpusCase(
            case_id: "spirv_binary.unused_binding",
            boundary: BOUNDARY_SPIRV_BINARY,
            kind: "glsl_frag",
            source_path: "test/fixtures/board_vulkan_corpus/case_unused_binding.frag",
            expected_relation: "correspond",
            hostile: true,
            note: "Declares a uniform block binding that is never read in the shader body."
        ),
        CorpusCase(
            case_id: "spirv_binary.large_const_array",
            boundary: BOUNDARY_SPIRV_BINARY,
            kind: "glsl_frag",
            source_path: "test/fixtures/board_vulkan_corpus/case_large_const_array.frag",
            expected_relation: "correspond",
            hostile: true,
            note: "256-entry compile-time constant float array indexed at runtime-selected offsets."
        ),
        CorpusCase(
            case_id: "spirv_binary.reorderable_control_flow",
            boundary: BOUNDARY_SPIRV_BINARY,
            kind: "glsl_frag",
            source_path: "test/fixtures/board_vulkan_corpus/case_reorderable_control_flow.frag",
            expected_relation: "correspond",
            hostile: true,
            note: (
                "Two independent if/else branches over disjoint state — a legal "
                + "compiler may reorder or fuse them; SPIR-V byte-identity across "
                + "implementations is NOT expected, only validity."
            )
        ),
        CorpusCase(
            case_id: "spirv_binary.gpu_lane_arena_touch",
            boundary: BOUNDARY_SPIRV_BINARY,
            kind: "spirv_binary",
            source_path: "test/fixtures/gpu_lane/vulkan_arena_touch.spv",
            expected_relation: "correspond",
            hostile: false,
            note: "Reused existing repo fixture (sibling GPU lane), not re-authored."
        ),
        CorpusCase(
            case_id: "spirv_binary.gpu_lane_bounded_long_loop",
            boundary: BOUNDARY_SPIRV_BINARY,
            kind: "spirv_binary",
            source_path: "test/fixtures/gpu_lane/vulkan_bounded_long_loop.spv",
            expected_relation: "correspond",
            hostile: false,
            note: "Reused existing repo fixture (sibling GPU lane), not re-authored."
        ),
        CorpusCase(
            case_id: "spirv_binary.deliberately_corrupt",
            boundary: BOUNDARY_SPIRV_BINARY,
            kind: "spirv_binary",
            source_path: "test/fixtures/crypto/x25519mlkem768/invalid_magic.spv",
            expected_relation: "non_correspond",
            hostile: true,
            note: (
                "Deliberately corrupt binary (not a multiple of 4 bytes). Marked "
                + "non_correspond up front rather than forced through the same "
                + "pass/fail comparison as the valid cases: a validator that "
                + "accepted this would itself be the defect."
            )
        )
    ]
