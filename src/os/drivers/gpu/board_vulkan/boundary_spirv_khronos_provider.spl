# Board Vulkan — SPIR-V boundary, Khronos SPIRV-Tools normative-validity
# provider descriptor.
#
# Boundary: `vulkan.shader.spirv_binary@1`, same boundary id as
# `boundary_spirv_provider.spl` (the glslang structural-comparison lane), but
# a DIFFERENT judgement: this file never compares the candidate against
# glslang's output. It asks a narrower, more fundamental question first —
# can Khronos's OWN reference tools (`spirv-as`, `spirv-val`) consume what
# `SpirvBuilder` emits at all? `spirv-as` assembling the text is an
# independent parser accepting the candidate's syntax; `spirv-val` validating
# the resulting binary is a normative conformance judgement against the
# SPIR-V spec, made by the closest thing to an authority that exists for the
# format. Neither verdict derives from Simple's own code, and neither
# depends on glslang's GLSL front end — this boundary is independent of BOTH
# glslang and Mesa. Independence group: `khronos-spirv-tools`.
#
# This is deliberately NOT `byte_exact` against anything. Two different
# compilers legitimately produce different SPIR-V for equivalent source (see
# the correction in doc/03_plan/os/vulkan/board_vulkan_parallel_soc_lanes_2026-08-10.md
# this file's spec references). What IS checked, and checked with full
# rigor, is: does the candidate assemble, and does the assembled binary
# validate? A "no" to either is a real defect in Simple's SPIR-V emission,
# reported as such — never silently worked around here.

use compiler.backend.vulkan.spirv_builder.{SpirvBuilder}
use std.nogc_sync_mut.io_runtime.{file_exists, mkdir_p, write_file}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.spec.evidence.counterpart.package_registry.{artifact_sha256_of_file}
use std.nogc_sync_mut.spec.evidence.counterpart.provider_registry.{
    ProviderRegistry,
    component_manifest,
    provider_manifest,
    provider_registry,
    provider_registry_register
}
use std.common.spec.evidence.counterpart.model.{
    ComponentManifest,
    ExecutionReceipt,
    ExecutionMode,
    LogicalArtifact,
    ProviderKind,
    ProviderManifest,
    ProviderStatus,
    ProvenanceReceipt,
    logical_artifact,
    provider_status_name
}
use os.drivers.gpu.board_vulkan.soc_profile.{board_vulkan_boundary_spirv}

pub val SPIRV_KHRONOS_TMP_DIR: text = "build/board_vulkan/spirv_khronos_boundary"
pub val KHRONOS_SPIRV_AS_PATH: text = "/usr/bin/spirv-as"
pub val KHRONOS_SPIRV_VAL_PATH: text = "/usr/bin/spirv-val"

fn khronos_run(cmd: text, args: [text]) -> (text, text, i64):
    process_run_bounded(cmd, args, 30000, 4194304)

# === Provider manifest ===

pub fn spirv_khronos_component() -> ComponentManifest:
    component_manifest(
        "spirv_binary_khronos_validity",
        board_vulkan_boundary_spirv(),
        "vulkan.shader.spirv_assembly@1",
        "vulkan.shader.spirv_binary@1",
        "deterministic_given_pinned_toolchain",
        ["semantic_equal"],
        ["cpu_reference"]
    )

# The artifact hash is the SHA-256 of the actual installed `spirv-val`
# executable on THIS host — never a placeholder. `spirv-as` and `spirv-val`
# ship together from one SPIRV-Tools release, so hashing the validator alone
# is sufficient identity for the pair (both paths are also checked for
# presence separately below, and a mismatched pair from two different
# installs would fail one of the two subprocess calls immediately).
pub fn spirv_khronos_artifact_hash() -> text:
    artifact_sha256_of_file(KHRONOS_SPIRV_VAL_PATH)

pub fn spirv_khronos_manifest() -> ProviderManifest:
    provider_manifest(
        "khronos-spirv-tools",
        ProviderKind.process_bridge,
        "khronos-spirv-tools",
        1,
        "installed-host-toolchain",
        spirv_khronos_artifact_hash(),
        "Apache-2.0",
        [spirv_khronos_component()]
    )

pub fn spirv_khronos_registry() -> ProviderRegistry:
    provider_registry_register(
        provider_registry(), spirv_khronos_manifest(), KHRONOS_SPIRV_AS_PATH, "")

# Tool version string, parsed from `spirv-val --version` stdout (first line),
# for the provenance receipt. Empty when the tool is missing or the call
# fails — never fabricated.
pub fn spirv_khronos_tool_version() -> text:
    if not file_exists(KHRONOS_SPIRV_VAL_PATH):
        return ""
    val (out, _err, code) = khronos_run(KHRONOS_SPIRV_VAL_PATH, ["--version"])
    if code != 0:
        return ""
    val lines = out.split("\n")
    if lines.len() == 0:
        return ""
    lines[0]

# === Candidate module: the minimal compute shader, built directly through
# SpirvBuilder's public API (no GLSL/HLSL front end exists in Simple). ===
#
# `bad_op` sabotage knob: when true, corrupts one instruction (a bogus
# opcode with no operands) so both `spirv-as` and `spirv-val` are proven to
# be genuinely consulted rather than stubbed.
pub fn spirv_khronos_candidate_module_text(bad_op: bool) -> text:
    val builder = SpirvBuilder.create([1, 0])
    builder.emit_header()
    builder.emit_capabilities()
    builder.emit_extensions()
    builder.emit_memory_model()

    # IMPORTANT, and a real defect this file's spec records
    # (doc/08_tracking/bug/spirv_builder_emit_function_ignores_preallocated_
    # entry_point_id_2026-08-11.md): `SpirvBuilder.emit_function()` always
    # mints its OWN fresh id via `alloc_id()` — it has no variant that
    # accepts a caller-supplied id. `OpEntryPoint` must reference the
    # function's id, and SPIR-V's mandatory section order puts
    # OpEntryPoint/OpExecutionMode BEFORE the type/function section, so the
    # function's id has to be known and allocated up front. The only way to
    # reconcile both constraints with the builder's current public API is
    # exactly what the sibling `boundary_spirv_provider.spl` boundary
    # already does: pre-allocate the id with `alloc_id()`, use it for
    # `emit_entry_point`, and then emit the `OpFunction` line by hand via
    # the raw `emit()` escape hatch instead of calling `emit_function()` (a
    # call to `emit_function()` here would allocate a SECOND, unused id and
    # leave `main_id` undefined at its use site — verified failing with
    # spirv-val: "forward referenced IDs have not been defined" — a real
    # bug this file's own construction hit and is recording, not silently
    # working around).
    val main_id = builder.alloc_id()
    builder.emit_entry_point("main", main_id, [])
    builder.emit_execution_mode(main_id, [1, 1, 1])

    val void_id = builder.emit_type_void()
    val fn_type_id = builder.emit_type_function(void_id, [])

    builder.emit("{builder.id_str(main_id)} = OpFunction {builder.id_str(void_id)} None {builder.id_str(fn_type_id)}")
    builder.emit_label()
    if bad_op:
        # Deliberately malformed: not a real SPIR-V opcode. `spirv-as` must
        # reject this at assembly time, before validation is even reached.
        builder.emit("OpThisIsNotARealOpcode")
    builder.emit_return()
    builder.emit_function_end()
    builder.build()

# Assembles the candidate module and validates it. Returns
# (status, as_exit_code, as_stderr, val_exit_code, val_stderr, binary_path).
# A missing tool is `unavailable`, never a silent pass; a nonzero `spirv-as`
# exit is `crashed` (assembly rejected the module) reported with the real
# assembler diagnostic; a nonzero `spirv-val` exit on an assembled binary is
# also `crashed`, reported with the real validator diagnostic.
pub fn spirv_khronos_assemble_and_validate(bad_op: bool) -> (ProviderStatus, i64, text, i64, text, text):
    if not file_exists(KHRONOS_SPIRV_AS_PATH) or not file_exists(KHRONOS_SPIRV_VAL_PATH):
        return (ProviderStatus.unavailable, 0 - 1, "spirv-as/spirv-val not installed at pinned paths", 0 - 1, "", "")

    mkdir_p(SPIRV_KHRONOS_TMP_DIR)
    val asm_path = SPIRV_KHRONOS_TMP_DIR + "/khronos_candidate.spvasm"
    val bin_path = SPIRV_KHRONOS_TMP_DIR + "/khronos_candidate.spv"
    write_file(asm_path, spirv_khronos_candidate_module_text(bad_op))

    val (_as_out, as_err, as_code) = khronos_run(
        KHRONOS_SPIRV_AS_PATH, ["--target-env", "vulkan1.0", "-o", bin_path, asm_path])
    if as_code != 0:
        return (ProviderStatus.crashed, as_code, as_err, 0 - 1, "", bin_path)

    val (val_out, val_err, val_code) = khronos_run(KHRONOS_SPIRV_VAL_PATH, [bin_path])
    if val_code != 0:
        return (ProviderStatus.crashed, as_code, as_err, val_code, val_out + val_err, bin_path)

    (ProviderStatus.executed, as_code, as_err, val_code, val_out + val_err, bin_path)

# === Typed evidence: LogicalArtifact / ExecutionReceipt / ProvenanceReceipt ===
#
# Built only for a status == executed run; callers must check status first.
# `canonical_hash` here is the SHA-256 of the ASSEMBLED BINARY (not the
# source assembly text) — the artifact this boundary is actually vouching
# for is the thing spirv-val accepted.
pub fn spirv_khronos_logical_artifact(bin_path: text) -> LogicalArtifact:
    logical_artifact(
        board_vulkan_boundary_spirv(),
        "vulkan.shader.spirv_binary@1",
        1,
        1,
        artifact_sha256_of_file(bin_path),
        bin_path
    )

pub fn spirv_khronos_execution_receipt(status: ProviderStatus) -> ExecutionReceipt:
    ExecutionReceipt(
        provider_id: "khronos-spirv-tools",
        execution_mode: ExecutionMode.cpu_reference,
        device_identity: "host-cpu",
        queue_identity: "",
        submission_count: 1,
        fence_completed: true,
        device_origin_readback: false,
        fallback_used: false,
        dropped_events: 0,
        completed: status == ProviderStatus.executed
    )

pub fn spirv_khronos_provenance_receipt(bin_path: text) -> ProvenanceReceipt:
    ProvenanceReceipt(
        package_manifest_hash: spirv_khronos_artifact_hash(),
        provider_manifest_hash: spirv_khronos_artifact_hash(),
        input_hash: artifact_sha256_of_file(bin_path),
        converter_route_hash: "spirv-as->spirv-val",
        environment_profile: spirv_khronos_tool_version(),
        run_id: "spirv_khronos_boundary"
    )

# Convenience: full run in one call. `ok` is true only when status ==
# executed; `detail` always names the exact diagnostic on a non-executed
# run, never a bare "failed".
pub fn spirv_khronos_run(bad_op: bool) -> (bool, text):
    val (status, as_code, as_err, val_code, val_err, bin_path) = spirv_khronos_assemble_and_validate(bad_op)
    if status != ProviderStatus.executed:
        val detail = ("status=" + provider_status_name(status)
            + " spirv-as exit=" + as_code.to_text() + " stderr=" + as_err
            + " spirv-val exit=" + val_code.to_text() + " stderr=" + val_err)
        return (false, detail)
    (true, "spirv-as exit=0, spirv-val exit=0, binary=" + bin_path)
