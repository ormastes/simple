# Board Vulkan backend — Intel Gen12 / Xe-LP (UP Squared / UP 4000 class SBC).
#
# Lane B3. Counterpart: Mesa `anv`.
# Kernel interface is the i915 DRM UAPI. This is the cheapest board lane to
# bring up first: it is x86-64, so it shares the host toolchain, and the same
# silicon class is present on ordinary development hosts — which makes the
# cmdstream boundary comparable against anv without the board in the loop.
#
# The source-side Gen12/Xe command encoder and canonical adapter are
# implemented. Submission/readback remain false until live ANV evidence exists.
#
# TODO(hw-gated): capture a real anv command-stream (INTEL_DEBUG=bat/aubinator)
# and flip submit_implemented once an Intel GPU is present — see
# test/03_system/os/vulkan/board_vulkan_intel_gen12_submit_readback_system_spec.spl
# and doc/08_tracking/bug/cmdstream_boundary_no_intel_gpu_on_capture_host_2026-08-11.md

use os.drivers.gpu.board_vulkan.soc_profile.{BoardGpuProfile, board_gpu_profile}

fn intel_gen12_board_profile() -> BoardGpuProfile:
    board_gpu_profile(
        "intel-elkhart-lake",
        "intel-gen12-xe-lp",
        "mesa-anv",
        "mesa",
        "drm-i915",
        "up-4000",
        false,
        true,
        false,
        false
    )
