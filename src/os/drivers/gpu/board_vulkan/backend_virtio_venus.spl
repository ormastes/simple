# Board Vulkan backend — virtio-gpu / venus (QEMU only).
#
# Lane B0, and the migration target for the existing work. The venus driver
# design and the existing virtio-gpu entry point
# (src/os/drivers/gpu/virtio_gpu_entry.spl,
#  src/lib/nogc_async_mut/gpu/vulkan_icd_virtio.spl) are reclassified here:
# they are ONE backend behind the SoC-neutral board Vulkan core, not the
# architecture for board Vulkan.
#
# `qemu_only: true` is load-bearing, not a note. `board_profile_is_board_runnable`
# returns false for this profile by construction, so no aggregate over the
# backend table can report board coverage on the strength of venus.
#
# CORRECTED 2026-08-11 (was `virglrenderer`, which conflated two layers).
#
# The counterpart for THIS backend is Mesa's venus ICD — the guest-side Vulkan
# driver that does the same job as the candidate — so its independence group is
# `mesa`, exactly like turnip/anv/powervr. Grouping it separately would have
# double-counted references: a run comparing this backend against Mesa venus
# while another source used Mesa anv would have reported two independent
# references when there is one upstream tree.
#
# virglrenderer/vtest is NOT a counterpart implementation; it is the host-side
# transport the guest driver talks to, a separate upstream (`virglrenderer`),
# and lane L4 measured that it is not installed on this host at all. It is
# therefore recorded as an unavailable host-bridge dependency, not as the
# oracle for this backend.
#
# Caught by two lanes independently disagreeing with this file; the frame was
# wrong, not the lanes.

use os.drivers.gpu.board_vulkan.soc_profile.{BoardGpuProfile, board_gpu_profile}

fn virtio_venus_board_profile() -> BoardGpuProfile:
    board_gpu_profile(
        "qemu-virtio",
        "venus-virtio-gpu",
        "mesa-venus-guest",
        "mesa",
        "virtio-gpu",
        "qemu",
        true,
        true,
        false,
        false
    )
