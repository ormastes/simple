# Board Vulkan — host provider inventory (lane L4).
#
# The shared foundation the sibling SoC lanes (glslang, Mesa enumeration,
# lavapipe) stand on: a pinned inventory of the open-source Vulkan counterparts
# actually installed on THIS host, plus the independence-grouping rule that
# stops six wrappers over one upstream engine from being counted as six
# independent references.
#
# Every entry here was measured on the host, not invented: `version` comes from
# a real query (`dpkg -l`, `--version`, `nvidia-smi`), `artifact_hash` is a real
# sha256 of the pinned library/binary, and `license_spdx` is read from the
# package's own copyright file. A provider that could not be measured is
# `unavailable` — see `provider_inventory_unmeasured` — never assumed fine.
#
# Design: doc/04_architecture/os/vulkan/simpleos_board_vulkan_driver_architecture_2026-08-10.md
# Plan:   doc/03_plan/os/vulkan/board_vulkan_parallel_soc_lanes_2026-08-10.md
# Contracts: src/lib/common/spec/evidence/counterpart/model.spl (frozen, do not edit)

use std.common.spec.evidence.counterpart.model.{
    ComponentManifest,
    ProviderKind,
    ProviderManifest,
    COUNTERPART_ABI_VERSION,
    provider_manifest_rejections
}

# One nominal component per provider so `provider_manifest_rejections`'s
# "declares no components" clause does not fire on a real, otherwise-complete
# manifest. The sibling lanes (glslang, Mesa enumeration, lavapipe) register
# their own real components against their own boundaries; this inventory only
# needs to prove IDENTITY, not describe every stage a provider can execute.
fn inventory_probe_component(provider_id: text) -> ComponentManifest:
    ComponentManifest(
        component_id: provider_id + "-icd-identity",
        counterpart_boundary_id: "gpu.board_vulkan.host_inventory@1",
        input_schema_id: "board_vulkan.icd_identity.v1",
        output_schema_id: "board_vulkan.icd_identity.v1",
        stateful: false,
        reset_supported: true,
        deterministic_claim: "identity is pinned host state, not computed",
        supported_relations: ["byte_exact"],
        supported_execution_modes: ["cpu_reference"],
        capability_requirements: []
    )

# ---------------------------------------------------------------------------
# Independence groups
# ---------------------------------------------------------------------------
#
# anv (Intel), lavapipe (CPU), radv (AMD), nouveau (open NVIDIA), asahi (Apple
# GPU on Linux) and the virtio-gpu/venus guest driver are ALL built from the
# Mesa tree and share its shader compiler, WSI code, and much of its common
# infrastructure. Six ICDs, one independence group: `mesa`. Selecting any
# number of them never yields more than one independent reference.
#
# glslang is a separate upstream (Khronos reference compiler): `khronos-glslang`.
# virglrenderer/vtest (the host-side venus transport) is a separate upstream
# from the Mesa guest driver it carries: `virglrenderer`.
# NVIDIA's proprietary ICD is closed-source, built from neither Mesa nor
# glslang: `nvidia-proprietary`.
pub val INDEPENDENCE_GROUP_MESA: text = "mesa"
pub val INDEPENDENCE_GROUP_KHRONOS_GLSLANG: text = "khronos-glslang"
pub val INDEPENDENCE_GROUP_VIRGLRENDERER: text = "virglrenderer"
pub val INDEPENDENCE_GROUP_NVIDIA_PROPRIETARY: text = "nvidia-proprietary"

# ---------------------------------------------------------------------------
# Host inventory — measured 2026-08-10/11 on this development host
# ---------------------------------------------------------------------------
#
# Measurement commands (for reproduction, not executed by this module):
#   version:  `dpkg -l mesa-vulkan-drivers` / `glslangValidator --version` /
#             `nvidia-smi --query-gpu=driver_version --format=csv,noheader`
#   hash:     `sha256sum <pinned .so or binary>`
#   license:  `/usr/share/doc/<pkg>/copyright`

pub fn provider_anv() -> ProviderManifest:
    ProviderManifest(
        provider_id: "host-mesa-anv",
        provider_kind: ProviderKind.native_isolated_worker,
        independence_group: INDEPENDENCE_GROUP_MESA,
        abi_version: COUNTERPART_ABI_VERSION,
        version: "25.2.8-0ubuntu0.24.04.2",
        artifact_hash: "sha256:9ecefd82942c76e227075e01a6dc78318cbb210e7fd86d2bde145501539422e4",
        license_spdx: "MIT",
        components: [inventory_probe_component("host-mesa-anv")]
    )

