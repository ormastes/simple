# NVIDIA's proprietary ICD (`nvidia_icd.json`) resolves through
# `libGLX_nvidia.so.0` -> the pinned versioned library below. `nvidia-smi`
# succeeded on this host (driver 580.126.16), so this is genuinely usable, not
# merely installed. It is the ONLY independent reference on this host that is
# not Mesa and not glslang — see `provider_inventory_all_mesa_selection_is_one_reference`.
pub fn provider_nvidia_proprietary() -> ProviderManifest:
    ProviderManifest(
        provider_id: "host-nvidia-proprietary",
        provider_kind: ProviderKind.native_isolated_worker,
        independence_group: INDEPENDENCE_GROUP_NVIDIA_PROPRIETARY,
        abi_version: COUNTERPART_ABI_VERSION,
        version: "580.126.16",
        artifact_hash: "sha256:5592828b3c9bab5d18feadeb75d41136172f3681cadff3e2e2fc3997adc45abc",
        license_spdx: "LicenseRef-NVIDIA-Proprietary",
        components: [inventory_probe_component("host-nvidia-proprietary")]
    )

# virglrenderer/vtest (the HOST-side venus transport) is not installed as a
# discrete package on this host as of this measurement — no `libvirglrenderer`
# / `vtest` binary was found. Recorded `unavailable` rather than guessed.
# Not returned by `provider_inventory_all` for that reason; kept here only so
# the independence-group name has one canonical anchor point in this module.
pub val VIRGLRENDERER_NOTE: text = "virglrenderer/vtest not found installed on this host; unavailable, not measured"

pub fn provider_inventory_all() -> [ProviderManifest]:
    [
        provider_anv(),
        provider_lavapipe(),
        provider_radv(),
        provider_nouveau(),
        provider_asahi(),
        provider_venus_guest(),
        provider_glslang(),
        provider_nvidia_proprietary()
    ]

# ---------------------------------------------------------------------------
# Independence predicate — the point of this lane
# ---------------------------------------------------------------------------

# Given a set of selected providers, how many INDEPENDENT references do they
# actually constitute? Counted by distinct `independence_group`, never by
# provider count — six Mesa drivers selected together still return 1.
pub fn provider_inventory_independent_reference_count(selected: [ProviderManifest]) -> i64:
    var groups: [text] = []
    for manifest in selected:
        if manifest.independence_group != "":
            var seen = false
            for existing in groups:
                if existing == manifest.independence_group:
                    seen = true
            if not seen:
                groups.push(manifest.independence_group)
    groups.len()

# Every rejection across the whole measured inventory, using the frozen
# `provider_manifest_rejections` gate. A non-empty return here means a
# manifest in this file has an empty hash, wrong ABI, or missing license —
# never silently accepted.
pub fn provider_inventory_rejections() -> [text]:
    var failures: [text] = []
    for manifest in provider_inventory_all():
        for failure in provider_manifest_rejections(manifest):
            failures.push(manifest.provider_id + ": " + failure)
    failures
