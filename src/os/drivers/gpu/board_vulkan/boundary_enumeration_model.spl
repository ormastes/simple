# Board Vulkan: the `vulkan.device.enumeration@1` boundary schema.
#
# What a Vulkan implementation reports for vkEnumeratePhysicalDevices +
# vkGetPhysicalDeviceQueueFamilyProperties + vkGetPhysicalDeviceMemoryProperties
# + a named subset of vkGetPhysicalDeviceProperties.limits. This is a NEW
# boundary (lane L2) alongside the three in counterpart_plan.spl
# (vulkan.shader.spirv_binary@1, vulkan.submit.command_stream@1,
# vulkan.present.readback_image@1) — this one needs no board and no GPU:
# lavapipe (Mesa's software rasterizer) reports full, real enumeration data
# on the CPU, so it is the deterministic hardware-free counterpart.
#
# Architecture: doc/04_architecture/os/vulkan/simpleos_board_vulkan_driver_architecture_2026-08-10.md
# Model reused: src/lib/common/spec/evidence/counterpart/model.spl
#
# Relation: structural_equal, not byte_exact. Enumeration legitimately differs
# across physical devices (name, vendor/device IDs, exact byte-sized limits),
# so the CANONICAL projection below drops those dimensions before comparison
# and keeps only what a conformant implementation must agree on:
#   - queue family flag SETS and per-family queue COUNTS (sorted by flags)
#   - memory heap COUNT and each heap's flag set (sorted; byte size excluded)
#   - memory type COUNT and each type's flags + heap index (sorted)
#   - a named subset of limits, by NAME presence and relative ordering class,
#     never exact device-specific magnitude
# Excluded from comparison (recorded on the record for evidence, but not
# compared): device_name, vendor_id, device_id, api_version, and the raw i64
# value of every limit. Those are legitimately device/vendor-specific.

use std.common.spec.evidence.counterpart.model.{
    CounterpartRelation
}

pub fn vulkan_enumeration_boundary_id() -> text:
    "vulkan.device.enumeration@1"

# ---------------------------------------------------------------------------
# Schema
# ---------------------------------------------------------------------------

pub struct QueueFamilyRecord:
    flags: [text]
    queue_count: i64

pub struct MemoryHeapRecord:
    heap_index: i64
    flags: [text]

pub struct MemoryTypeRecord:
    type_index: i64
    heap_index: i64
    flags: [text]

pub struct DeviceLimitRecord:
    name: text
    value: i64

pub struct DeviceEnumerationRecord:
    device_name: text
    vendor_id: i64
    device_id: i64
    api_version_major: i64
    api_version_minor: i64
    queue_families: [QueueFamilyRecord]
    memory_heaps: [MemoryHeapRecord]
    memory_types: [MemoryTypeRecord]
    limits: [DeviceLimitRecord]

# ---------------------------------------------------------------------------
# Sorting — unstable order makes byte/structural comparison meaningless, so
# every collection is put into one canonical order before it is compared.
# Small, self-contained insertion sorts: these lists are always tiny
# (single-digit queue families / heaps / types / limits), so O(n^2) is fine
# and avoids taking on an external sort dependency for this boundary.
# ---------------------------------------------------------------------------

fn sorted_text_list(items: [text]) -> [text]:
    var out: [text] = []
    for item in items:
        out.push(item)
    var i: i64 = 1
    while i < out.len():
        val key = out[i]
        var j: i64 = i - 1
        while j >= 0 and out[j] > key:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = key
        i = i + 1
    out

fn flags_key(flags: [text]) -> text:
    val sorted_flags = sorted_text_list(flags)
    var key: text = ""
    for f in sorted_flags:
        key = key + f + "|"
    key

pub fn canonical_queue_family(record: QueueFamilyRecord) -> QueueFamilyRecord:
    QueueFamilyRecord(flags: sorted_text_list(record.flags), queue_count: record.queue_count)

pub fn canonical_memory_heap(record: MemoryHeapRecord) -> MemoryHeapRecord:
    MemoryHeapRecord(heap_index: record.heap_index, flags: sorted_text_list(record.flags))

pub fn canonical_memory_type(record: MemoryTypeRecord) -> MemoryTypeRecord:
    MemoryTypeRecord(
        type_index: record.type_index,
        heap_index: record.heap_index,
        flags: sorted_text_list(record.flags)
    )

fn sort_queue_families(items: [QueueFamilyRecord]) -> [QueueFamilyRecord]:
    var out: [QueueFamilyRecord] = []
    for item in items:
        out.push(canonical_queue_family(item))
    var i: i64 = 1
    while i < out.len():
        val key = out[i]
        val key_sort = flags_key(key.flags)
        var j: i64 = i - 1
        while j >= 0 and flags_key(out[j].flags) > key_sort:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = key
        i = i + 1
    out

fn sort_memory_heaps(items: [MemoryHeapRecord]) -> [MemoryHeapRecord]:
    var out: [MemoryHeapRecord] = []
    for item in items:
        out.push(canonical_memory_heap(item))
    var i: i64 = 1
    while i < out.len():
        val key = out[i]
        var j: i64 = i - 1
        while j >= 0 and out[j].heap_index > key.heap_index:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = key
        i = i + 1
    out

fn sort_memory_types(items: [MemoryTypeRecord]) -> [MemoryTypeRecord]:
    var out: [MemoryTypeRecord] = []
    for item in items:
        out.push(canonical_memory_type(item))
    var i: i64 = 1
    while i < out.len():
        val key = out[i]
        var j: i64 = i - 1
        while j >= 0 and out[j].type_index > key.type_index:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = key
        i = i + 1
    out

fn sort_limits(items: [DeviceLimitRecord]) -> [DeviceLimitRecord]:
    var out: [DeviceLimitRecord] = []
    for item in items:
        out.push(item)
    var i: i64 = 1
    while i < out.len():
        val key = out[i]
        var j: i64 = i - 1
        while j >= 0 and out[j].name > key.name:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = key
        i = i + 1
    out

# The comparable projection: drops device-specific dimensions (name, vendor
# id, device id, api version, exact limit magnitude) and canonicalizes order
# on everything that remains. This is what `structural_equal` actually
# compares — never the raw record, which legitimately differs per device.
pub struct ComparableEnumeration:
    queue_family_count: i64
    queue_families: [QueueFamilyRecord]
    memory_heap_count: i64
    memory_heaps: [MemoryHeapRecord]
    memory_type_count: i64
    memory_types: [MemoryTypeRecord]
    limit_names: [text]

pub fn comparable_projection(record: DeviceEnumerationRecord) -> ComparableEnumeration:
    var names: [text] = []
    for limit in record.limits:
        names.push(limit.name)
    ComparableEnumeration(
        queue_family_count: record.queue_families.len(),
        queue_families: sort_queue_families(record.queue_families),
        memory_heap_count: record.memory_heaps.len(),
        memory_heaps: sort_memory_heaps(record.memory_heaps),
        memory_type_count: record.memory_types.len(),
        memory_types: sort_memory_types(record.memory_types),
        limit_names: sorted_text_list(names)
    )

fn queue_family_text(record: QueueFamilyRecord) -> text:
    "count=" + record.queue_count.to_text() + " flags=" + flags_key(record.flags)

fn memory_heap_text(record: MemoryHeapRecord) -> text:
    "idx=" + record.heap_index.to_text() + " flags=" + flags_key(record.flags)

fn memory_type_text(record: MemoryTypeRecord) -> text:
    "idx=" + record.type_index.to_text() + " heap=" + record.heap_index.to_text() + " flags=" + flags_key(record.flags)

# A stable text encoding of the comparable projection. `structural_equal` at
# this boundary is implemented as this canonical text agreeing byte-for-byte
# between the two projections — canonicalization already removed the
# legitimately device-specific dimensions, so this comparison is meaningful.
pub fn comparable_projection_text(projection: ComparableEnumeration) -> text:
    var out: text = "queue_family_count=" + projection.queue_family_count.to_text() + "\n"
    for qf in projection.queue_families:
        out = out + queue_family_text(qf) + "\n"
    out = out + "memory_heap_count=" + projection.memory_heap_count.to_text() + "\n"
    for heap in projection.memory_heaps:
        out = out + memory_heap_text(heap) + "\n"
    out = out + "memory_type_count=" + projection.memory_type_count.to_text() + "\n"
    for mt in projection.memory_types:
        out = out + memory_type_text(mt) + "\n"
    out = out + "limits="
    for name in projection.limit_names:
        out = out + name + ","
    out

pub fn enumeration_records_structurally_equal(
    left: DeviceEnumerationRecord,
    right: DeviceEnumerationRecord
) -> bool:
    comparable_projection_text(comparable_projection(left)) == comparable_projection_text(comparable_projection(right))

pub fn vulkan_enumeration_relation() -> CounterpartRelation:
    CounterpartRelation.structural_equal
