# Board Vulkan conformance corpus — executor.
#
# Executes each CorpusCase (corpus_cases.spl) against the tools that
# genuinely exist on this host: glslangValidator (GLSL -> SPIR-V) and
# spirv-val (SPIR-V validation). No GPU is required — spirv-val is a static
# validator, so this boundary is deterministic and reproducible without any
# ICD (lavapipe/anv) being present.

use std.process.{run}
use os.drivers.gpu.board_vulkan.corpus_cases.{CorpusCase}

pub struct CaseVerdict:
    case_id: text
    verdict: text    # "pass" | "fail" | "non_correspond_confirmed" | "anomaly"
    detail: text

fn compile_glsl_to_spirv(source_path: text, out_spv_path: text) -> (bool, text):
    val result = run("glslangValidator", ["-V", source_path, "-o", out_spv_path])
    if result.exit_code != 0:
        return (false, "glslangValidator exit " + result.exit_code.to_text() + ": " + result.stdout + result.stderr)
    (true, "")

fn validate_spirv(spv_path: text) -> (bool, text):
    val result = run("spirv-val", [spv_path])
    if result.exit_code != 0:
        return (false, "spirv-val exit " + result.exit_code.to_text() + ": " + result.stdout + result.stderr)
    (true, "")

# scratch_dir: a writable directory this run may drop compiled .spv artifacts
# into (the caller's scratchpad — never a shared repo path).
pub fn run_case(test_case: CorpusCase, scratch_dir: text) -> CaseVerdict:
    if test_case.kind == "glsl_frag":
        val out_spv = scratch_dir + "/" + test_case.case_id + ".spv"
        val (compiled, compile_detail) = compile_glsl_to_spirv(test_case.source_path, out_spv)
        if not compiled:
            if test_case.expected_relation == "non_correspond":
                return CaseVerdict(case_id: test_case.case_id, verdict: "non_correspond_confirmed", detail: compile_detail)
            return CaseVerdict(case_id: test_case.case_id, verdict: "fail", detail: compile_detail)
        val (valid, validate_detail) = validate_spirv(out_spv)
        if valid:
            if test_case.expected_relation == "non_correspond":
                return CaseVerdict(case_id: test_case.case_id, verdict: "anomaly", detail: "expected non_correspond but validator accepted the artifact")
            return CaseVerdict(case_id: test_case.case_id, verdict: "pass", detail: "")
        if test_case.expected_relation == "non_correspond":
            return CaseVerdict(case_id: test_case.case_id, verdict: "non_correspond_confirmed", detail: validate_detail)
        return CaseVerdict(case_id: test_case.case_id, verdict: "fail", detail: validate_detail)
    if test_case.kind == "spirv_binary":
        val (valid, validate_detail) = validate_spirv(test_case.source_path)
        if valid:
            if test_case.expected_relation == "non_correspond":
                return CaseVerdict(case_id: test_case.case_id, verdict: "anomaly", detail: "expected non_correspond but validator accepted the artifact")
            return CaseVerdict(case_id: test_case.case_id, verdict: "pass", detail: "")
        if test_case.expected_relation == "non_correspond":
            return CaseVerdict(case_id: test_case.case_id, verdict: "non_correspond_confirmed", detail: validate_detail)
        return CaseVerdict(case_id: test_case.case_id, verdict: "fail", detail: validate_detail)
    CaseVerdict(case_id: test_case.case_id, verdict: "fail", detail: "unknown case kind: " + test_case.kind)

pub fn case_verdict_is_ok(v: CaseVerdict) -> bool:
    v.verdict == "pass" or v.verdict == "non_correspond_confirmed"
