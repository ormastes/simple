# Board Vulkan: SoC profile table and truthfulness gate.
#
# Answers doc/08_tracking/bug/simpleos_vulkan_board_gap_venus_is_qemu_only_2026-08-06.md:
# venus/virtio-gpu is ONE backend of a SoC-neutral core, not the architecture.
# Every other backend targets real silicon and declares, per stage, whether it
# is implemented. Nothing here claims a capability it does not have —
# `board_profile_false_claim` is the gate that makes an over-claim a red.
#
# Each SoC lane owns exactly one backend_*.spl file in this directory so the
# three board lanes can be developed in parallel without touching each other.
#
# Architecture: doc/04_architecture/os/vulkan/simpleos_board_vulkan_driver_architecture_2026-08-10.md

# `mesa_counterpart` names the open-source driver this backend is IO-compared
# against; `mesa_independence_group` is what stops two Mesa-derived providers
# from being counted as two independent references.
struct BoardGpuProfile:
    soc: text
    gpu: text
    mesa_counterpart: text
    mesa_independence_group: text
    kernel_iface: text
    board: text
    qemu_only: bool
    spirv_implemented: bool
    submit_implemented: bool
    readback_implemented: bool

fn board_gpu_profile(soc: text, gpu: text, mesa_counterpart: text, mesa_independence_group: text, kernel_iface: text, board: text, qemu_only: bool, spirv_implemented: bool, submit_implemented: bool, readback_implemented: bool) -> BoardGpuProfile:
    BoardGpuProfile(soc: soc, gpu: gpu, mesa_counterpart: mesa_counterpart, mesa_independence_group: mesa_independence_group, kernel_iface: kernel_iface, board: board, qemu_only: qemu_only, spirv_implemented: spirv_implemented, submit_implemented: submit_implemented, readback_implemented: readback_implemented)

# A profile is a false claim when it asserts a later pipeline stage without the
# stage it is built on, or when it claims a physical board while being a VM
# device interface. Both are the exact shapes the board-runnable rule forbids.
fn board_profile_false_claim(p: BoardGpuProfile) -> bool:
    (p.submit_implemented and not p.spirv_implemented) or (p.readback_implemented and not p.submit_implemented) or (p.qemu_only and p.board != "qemu") or (p.mesa_counterpart == "") or (p.mesa_independence_group == "")

# Board-runnable means: real silicon, and the whole SPIR-V -> submit -> readback
# chain implemented. Anything short of that is a documented gap, not a driver.
fn board_profile_is_board_runnable(p: BoardGpuProfile) -> bool:
    not p.qemu_only and p.spirv_implemented and p.submit_implemented and p.readback_implemented and not board_profile_false_claim(p)

fn _board_profile_bool(value: bool) -> text:
    if value:
        "true"
    else:
        "false"

fn board_profile_marker(p: BoardGpuProfile) -> text:
    "[board-vulkan] soc=" + p.soc +
        " gpu=" + p.gpu +
        " counterpart=" + p.mesa_counterpart +
        " group=" + p.mesa_independence_group +
        " kernel_iface=" + p.kernel_iface +
        " board=" + p.board +
        " qemu_only=" + _board_profile_bool(p.qemu_only) +
        " spirv=" + _board_profile_bool(p.spirv_implemented) +
        " submit=" + _board_profile_bool(p.submit_implemented) +
        " readback=" + _board_profile_bool(p.readback_implemented) +
        " board_runnable=" + _board_profile_bool(board_profile_is_board_runnable(p))

# ---------------------------------------------------------------------------
# Counterpart boundary IDs, shared by every SoC lane.
#
# Format is `<domain>.<mdsoc-layer>.<stage>@<schema-version>` per
# src/lib/common/spec/evidence/counterpart/model.spl. Three stages, chosen so
# the first needs no hardware at all and can gate correctness portably:
# ---------------------------------------------------------------------------

# SPIR-V binary produced from a shader source. Host-only, no GPU required.
fn board_vulkan_boundary_spirv() -> text:
    "vulkan.shader.spirv_binary@1"

# Vendor command stream produced for a submission. Needs the SoC ISA encoder,
# not the SoC itself, so it is comparable against Mesa on a host.
fn board_vulkan_boundary_cmdstream() -> text:
    "vulkan.submit.command_stream@1"

# Device-origin pixel readback. This one genuinely requires the board.
fn board_vulkan_boundary_readback() -> text:
    "vulkan.present.readback_image@1"
