# NvmeDriver bounded 4KiB burst and batch I/O.
use os.drivers.nvme.nvme_driver.*
use os.drivers.nvme._NvmeDriver.driver_class.*
use os.drivers.nvme.nvme_queue.{NvmeQueuePair}
use os.drivers.nvme.nvme_queue_notify.*
use os.drivers.nvme.nvme_transfer_command.{nvme_read_io_command_for_namespace, nvme_write_io_command_for_namespace}
use os.drivers.nvme.nvme_storage_model.{nvme_queue_is_system_reserved}
use std.io.dma.{SharedDmaBuffer, dma_shared_sync_cpu_to_device, dma_shared_sync_device_to_cpu}

val NVME_U64_MAX: u64 = 18446744073709551615u64

fn nvme_4k_lba_range_reason(lba: u64, sectors: u32, namespace_sectors: u64) -> text:
    val sector_count = sectors.to_u64()
    if sector_count == 0u64:
        return "NVMe: zero-sector 4K operation"
    if sector_count > namespace_sectors:
        return "NVMe: 4K operation beyond namespace capacity"
    if lba > namespace_sectors - sector_count:
        return "NVMe: 4K operation beyond namespace capacity"
    "ready"

fn nvme_4k_batch_byte_len(command_count: u64) -> Result<u64, text>:
    if command_count == 0u64:
        return Err("NVMe: empty 4K batch")
    if command_count > NVME_U64_MAX / 4096u64:
        return Err("NVMe: 4K batch byte length overflow")
    Ok(command_count * 4096u64)

fn nvme_4k_dma_slot_addr(base: u64, command_index: u64) -> Result<u64, text>:
    if command_index > NVME_U64_MAX / 4096u64:
        return Err("NVMe: 4K batch slot offset overflow")
    val offset = command_index * 4096u64
    if base > NVME_U64_MAX - offset:
        return Err("NVMe: 4K batch DMA address overflow")
    Ok(base + offset)

impl NvmeDriver:
    fn data_queue_depth_for_id(queue_id: u16) -> Result<u16, text>:
        if queue_id == self.io_queue.qid:
            return Ok(self.io_queue.depth)
        for existing in self.user_io_queues:
            if existing.qid == queue_id:
                return Ok(existing.depth)
        Err("NVMe: I/O queue not ready")

    me read_4k_shared_dma_burst_in_namespace_on_queue(nsid: u32, queue_id: u16, lba: u64, buf: SharedDmaBuffer) -> Result<bool, text>:
        """Read one 4KiB operation as one multi-sector NVMe command."""
        if not self.initialized:
            return Result.Err("NVMe: driver not initialized")
        val access_reason = self.raw_namespace_queue_access_reason(nsid, queue_id)
        if access_reason != "ready":
            return Result.Err(access_reason)
        if not buf.is_valid():
            return Result.Err("NVMe: invalid shared DMA buffer")
        val sector_size = self.namespace_sector_size(nsid)
        if sector_size.is_err():
            return Result.Err("NVMe: namespace not identified")
        if sector_size.unwrap() == 0u32 or (4096u32 % sector_size.unwrap()) != 0u32:
            return Result.Err("NVMe: burst sector size not 4K divisible")
        if buf.byte_len < 4096u64:
            return Result.Err("NVMe: shared DMA buffer too small")
        val sectors_per_4k = 4096u32 / sector_size.unwrap()
        val namespace_sectors = self.namespace_sector_count(nsid)
        if namespace_sectors.is_err():
            return Result.Err("NVMe: namespace not identified")
        val range_reason = nvme_4k_lba_range_reason(lba, sectors_per_4k, namespace_sectors.unwrap())
        if range_reason != "ready":
            return Result.Err(range_reason)

        val cmd_result = nvme_read_io_command_for_namespace(nsid, lba, sectors_per_4k, buf.device_addr, namespace_sectors.unwrap())
        if cmd_result.is_err():
            return Result.Err("NVMe: 4K read " + cmd_result.unwrap_err())
        val cmd = cmd_result.unwrap()
        var status: Result<u32, text> = Err("NVMe: I/O queue not ready")
        if queue_id == self.io_queue.qid:
            val cmd_id = self.io_queue.submit_command(
                cmd.opcode,
                cmd.nsid,
                cmd.prp1,
                cmd.prp2,
                cmd.cdw10,
                cmd.cdw11,
                cmd.cdw12
            )
            if cmd_id == 0xFFFFu16:
                return Result.Err("NVMe: 4K read submit failed")
            status = self.io_queue.wait_completions(1u32, CMD_TIMEOUT)
        else:
            var updated_queues: [NvmeQueuePair] = []
            var matched_queue = false
            for existing in self.user_io_queues:
                if existing.qid == queue_id:
                    var q = existing
                    val cmd_id = q.submit_command(
                        cmd.opcode,
                        cmd.nsid,
                        cmd.prp1,
                        cmd.prp2,
                        cmd.cdw10,
                        cmd.cdw11,
                        cmd.cdw12
                    )
                    if cmd_id == 0xFFFFu16:
                        return Result.Err("NVMe: 4K read submit failed")
                    status = q.wait_completions(1u32, CMD_TIMEOUT)
                    updated_queues.push(q)
                    matched_queue = true
                else:
                    updated_queues.push(existing)
            self.user_io_queues = updated_queues
            if not matched_queue:
                return Result.Err("NVMe: I/O queue not ready")
        if status.is_err():
            return Result.Err("NVMe: burst read " + status.unwrap_err())
        if status.unwrap() != 0u32:
            return Result.Err("NVMe: burst read error, status=" + status.unwrap().to_u64().to_text())
        dma_shared_sync_device_to_cpu(buf)
        if nvme_queue_is_system_reserved(queue_id):
            self.remember_system_namespace_raw_access(nsid)
        Result.Ok(true)

    me write_4k_shared_dma_burst_in_namespace_on_queue(nsid: u32, queue_id: u16, lba: u64, buf: SharedDmaBuffer) -> Result<bool, text>:
        """Write one 4KiB operation as one multi-sector NVMe command."""
        if not self.initialized:
            return Result.Err("NVMe: driver not initialized")
        val access_reason = self.raw_namespace_queue_access_reason(nsid, queue_id)
        if access_reason != "ready":
            return Result.Err(access_reason)
        if not buf.is_valid():
            return Result.Err("NVMe: invalid shared DMA buffer")
        val sector_size = self.namespace_sector_size(nsid)
        if sector_size.is_err():
            return Result.Err("NVMe: namespace not identified")
        if sector_size.unwrap() == 0u32 or (4096u32 % sector_size.unwrap()) != 0u32:
            return Result.Err("NVMe: burst sector size not 4K divisible")
        if buf.byte_len < 4096u64:
            return Result.Err("NVMe: shared DMA buffer too small")
        val sectors_per_4k = 4096u32 / sector_size.unwrap()
        val namespace_sectors = self.namespace_sector_count(nsid)
        if namespace_sectors.is_err():
            return Result.Err("NVMe: namespace not identified")
        val range_reason = nvme_4k_lba_range_reason(lba, sectors_per_4k, namespace_sectors.unwrap())
        if range_reason != "ready":
            return Result.Err(range_reason)

        dma_shared_sync_cpu_to_device(buf)
        val cmd_result = nvme_write_io_command_for_namespace(nsid, lba, sectors_per_4k, buf.device_addr, namespace_sectors.unwrap())
        if cmd_result.is_err():
            return Result.Err("NVMe: 4K write " + cmd_result.unwrap_err())
        val cmd = cmd_result.unwrap()
        var status: Result<u32, text> = Err("NVMe: I/O queue not ready")
        if queue_id == self.io_queue.qid:
            val cmd_id = self.io_queue.submit_command(
                cmd.opcode,
                cmd.nsid,
                cmd.prp1,
                cmd.prp2,
                cmd.cdw10,
                cmd.cdw11,
                cmd.cdw12
            )
            if cmd_id == 0xFFFFu16:
                return Result.Err("NVMe: 4K write submit failed")
            status = self.io_queue.wait_completions(1u32, CMD_TIMEOUT)
        else:
            var updated_queues: [NvmeQueuePair] = []
            var matched_queue = false
            for existing in self.user_io_queues:
                if existing.qid == queue_id:
                    var q = existing
                    val cmd_id = q.submit_command(
                        cmd.opcode,
                        cmd.nsid,
                        cmd.prp1,
                        cmd.prp2,
                        cmd.cdw10,
                        cmd.cdw11,
                        cmd.cdw12
                    )
                    if cmd_id == 0xFFFFu16:
                        return Result.Err("NVMe: 4K write submit failed")
                    status = q.wait_completions(1u32, CMD_TIMEOUT)
                    updated_queues.push(q)
                    matched_queue = true
                else:
                    updated_queues.push(existing)
            self.user_io_queues = updated_queues
            if not matched_queue:
                return Result.Err("NVMe: I/O queue not ready")
        if status.is_err():
            return Result.Err("NVMe: burst write " + status.unwrap_err())
        if status.unwrap() != 0u32:
            return Result.Err("NVMe: burst write error, status=" + status.unwrap().to_u64().to_text())
        if nvme_queue_is_system_reserved(queue_id):
            self.remember_system_namespace_raw_access(nsid)
        Result.Ok(true)

    me read_4k_shared_dma_batch_in_namespace_on_queue(nsid: u32, queue_id: u16, lbas: [u64], sector_size: u32, namespace_sectors: u64, buf: SharedDmaBuffer) -> Result<bool, text>:
        """Read multiple 4KiB operations into contiguous shared DMA slots."""
        if not self.initialized:
            return Result.Err("NVMe: driver not initialized")
        val access_reason = self.raw_namespace_queue_access_reason(nsid, queue_id)
        if access_reason != "ready":
            return Result.Err(access_reason)
        if lbas.len() == 0:
            return Result.Err("NVMe: empty read batch")
        if not buf.is_valid():
            return Result.Err("NVMe: invalid shared DMA buffer")
        if sector_size == 0u32 or (4096u32 % sector_size) != 0u32:
            return Result.Err("NVMe: batch sector size not 4K divisible")
        if namespace_sectors == 0u64:
            return Result.Err("NVMe: namespace not identified")
        val sectors_per_4k = 4096u32 / sector_size
        val command_count = lbas.len().to_u64()
        val queue_depth = self.data_queue_depth_for_id(queue_id)
        if queue_depth.is_err():
            return Result.Err(queue_depth.unwrap_err())
        if command_count >= queue_depth.unwrap().to_u64():
            return Result.Err("NVMe: batch exceeds queue depth commands=" + command_count.to_text() +
                " depth=" + queue_depth.unwrap().to_u64().to_text() + " ops=" + (lbas.len() as u64).to_text() +
                " sector_size=" + sector_size.to_u64().to_text() +
                " sectors_per_4k=" + sectors_per_4k.to_u64().to_text())
        val required_bytes = nvme_4k_batch_byte_len(command_count)
        if required_bytes.is_err():
            return Err(required_bytes.unwrap_err())
        if buf.byte_len < required_bytes.unwrap():
            return Result.Err("NVMe: shared DMA buffer too small")
        val total_commands = command_count.to_u32()

        var status: Result<u32, text> = Err("NVMe: I/O queue not ready")
        var op_index: i64 = 0
        if queue_id == self.io_queue.qid:
            while op_index < lbas.len():
                val base_lba = lbas[op_index]
                val range_reason = nvme_4k_lba_range_reason(base_lba, sectors_per_4k, namespace_sectors)
                if range_reason != "ready":
                    return Result.Err(range_reason)
                val slot_addr = nvme_4k_dma_slot_addr(buf.device_addr, op_index as u64)
                if slot_addr.is_err():
                    return Err(slot_addr.unwrap_err())
                val cmd_result = nvme_read_io_command_for_namespace(nsid, base_lba, sectors_per_4k, slot_addr.unwrap(), namespace_sectors)
                if cmd_result.is_err():
                    return Result.Err("NVMe: batch read " + cmd_result.unwrap_err())
                val cmd = cmd_result.unwrap()
                val cmd_id = self.io_queue.submit_command(
                    cmd.opcode,
                    cmd.nsid,
                    cmd.prp1,
                    cmd.prp2,
                    cmd.cdw10,
                    cmd.cdw11,
                    cmd.cdw12
                )
                if cmd_id == 0xFFFFu16:
                    return Result.Err("NVMe: batch read submit failed")
                op_index = op_index + 1
            status = self.io_queue.wait_completions(total_commands, CMD_TIMEOUT)
        else:
            var updated_queues: [NvmeQueuePair] = []
            var matched_queue = false
            for existing in self.user_io_queues:
                if existing.qid == queue_id:
                    var q = existing
                    while op_index < lbas.len():
                        val base_lba = lbas[op_index]
                        val range_reason = nvme_4k_lba_range_reason(base_lba, sectors_per_4k, namespace_sectors)
                        if range_reason != "ready":
                            return Result.Err(range_reason)
                        val slot_addr = nvme_4k_dma_slot_addr(buf.device_addr, op_index as u64)
                        if slot_addr.is_err():
                            return Err(slot_addr.unwrap_err())
                        val cmd_result = nvme_read_io_command_for_namespace(nsid, base_lba, sectors_per_4k, slot_addr.unwrap(), namespace_sectors)
                        if cmd_result.is_err():
                            return Result.Err("NVMe: batch read " + cmd_result.unwrap_err())
                        val cmd = cmd_result.unwrap()
                        val cmd_id = q.submit_command(
                            cmd.opcode,
                            cmd.nsid,
                            cmd.prp1,
                            cmd.prp2,
                            cmd.cdw10,
                            cmd.cdw11,
                            cmd.cdw12
                        )
                        if cmd_id == 0xFFFFu16:
                            return Result.Err("NVMe: batch read submit failed")
                        op_index = op_index + 1
                    status = q.wait_completions(total_commands, CMD_TIMEOUT)
                    updated_queues.push(q)
                    matched_queue = true
                else:
                    updated_queues.push(existing)
            self.user_io_queues = updated_queues
            if not matched_queue:
                return Result.Err("NVMe: I/O queue not ready")
        if status.is_err():
            return Result.Err("NVMe: batch read " + status.unwrap_err())
        if status.unwrap() != 0u32:
            return Result.Err("NVMe: batch read error, status=" + status.unwrap().to_u64().to_text())
        dma_shared_sync_device_to_cpu(buf)
        if nvme_queue_is_system_reserved(queue_id):
            self.remember_system_namespace_raw_access(nsid)
        Result.Ok(true)

    me write_4k_shared_dma_batch_in_namespace_on_queue(nsid: u32, queue_id: u16, lbas: [u64], sector_size: u32, namespace_sectors: u64, buf: SharedDmaBuffer) -> Result<bool, text>:
        """Write multiple 4KiB operations from contiguous shared DMA slots."""
        if not self.initialized:
            return Result.Err("NVMe: driver not initialized")
        val access_reason = self.raw_namespace_queue_access_reason(nsid, queue_id)
        if access_reason != "ready":
            return Result.Err(access_reason)
        if lbas.len() == 0:
            return Result.Err("NVMe: empty write batch")
        if not buf.is_valid():
            return Result.Err("NVMe: invalid shared DMA buffer")
        if sector_size == 0u32 or (4096u32 % sector_size) != 0u32:
            return Result.Err("NVMe: batch sector size not 4K divisible")
        if namespace_sectors == 0u64:
            return Result.Err("NVMe: namespace not identified")
        val sectors_per_4k = 4096u32 / sector_size
        val command_count = lbas.len().to_u64()
        val queue_depth = self.data_queue_depth_for_id(queue_id)
        if queue_depth.is_err():
            return Result.Err(queue_depth.unwrap_err())
        if command_count >= queue_depth.unwrap().to_u64():
            return Result.Err("NVMe: batch exceeds queue depth commands=" + command_count.to_text() +
                " depth=" + queue_depth.unwrap().to_u64().to_text() + " ops=" + (lbas.len() as u64).to_text() +
                " sector_size=" + sector_size.to_u64().to_text() +
                " sectors_per_4k=" + sectors_per_4k.to_u64().to_text())
        val required_bytes = nvme_4k_batch_byte_len(command_count)
        if required_bytes.is_err():
            return Err(required_bytes.unwrap_err())
        if buf.byte_len < required_bytes.unwrap():
            return Result.Err("NVMe: shared DMA buffer too small")
        val total_commands = command_count.to_u32()

        dma_shared_sync_cpu_to_device(buf)
        var status: Result<u32, text> = Err("NVMe: I/O queue not ready")
        var op_index: i64 = 0
        if queue_id == self.io_queue.qid:
            while op_index < lbas.len():
                val base_lba = lbas[op_index]
                val range_reason = nvme_4k_lba_range_reason(base_lba, sectors_per_4k, namespace_sectors)
                if range_reason != "ready":
                    return Result.Err(range_reason)
                val slot_addr = nvme_4k_dma_slot_addr(buf.device_addr, op_index as u64)
                if slot_addr.is_err():
                    return Err(slot_addr.unwrap_err())
                val cmd_result = nvme_write_io_command_for_namespace(nsid, base_lba, sectors_per_4k, slot_addr.unwrap(), namespace_sectors)
                if cmd_result.is_err():
                    return Result.Err("NVMe: batch write " + cmd_result.unwrap_err())
                val cmd = cmd_result.unwrap()
                val cmd_id = self.io_queue.submit_command(
                    cmd.opcode,
                    cmd.nsid,
                    cmd.prp1,
                    cmd.prp2,
                    cmd.cdw10,
                    cmd.cdw11,
                    cmd.cdw12
                )
                if cmd_id == 0xFFFFu16:
                    return Result.Err("NVMe: batch write submit failed")
                op_index = op_index + 1
            status = self.io_queue.wait_completions(total_commands, CMD_TIMEOUT)
        else:
            var updated_queues: [NvmeQueuePair] = []
            var matched_queue = false
            for existing in self.user_io_queues:
                if existing.qid == queue_id:
                    var q = existing
                    while op_index < lbas.len():
                        val base_lba = lbas[op_index]
                        val range_reason = nvme_4k_lba_range_reason(base_lba, sectors_per_4k, namespace_sectors)
                        if range_reason != "ready":
                            return Result.Err(range_reason)
                        val slot_addr = nvme_4k_dma_slot_addr(buf.device_addr, op_index as u64)
                        if slot_addr.is_err():
                            return Err(slot_addr.unwrap_err())
                        val cmd_result = nvme_write_io_command_for_namespace(nsid, base_lba, sectors_per_4k, slot_addr.unwrap(), namespace_sectors)
                        if cmd_result.is_err():
                            return Result.Err("NVMe: batch write " + cmd_result.unwrap_err())
                        val cmd = cmd_result.unwrap()
                        val cmd_id = q.submit_command(
                            cmd.opcode,
                            cmd.nsid,
                            cmd.prp1,
                            cmd.prp2,
                            cmd.cdw10,
                            cmd.cdw11,
                            cmd.cdw12
                        )
                        if cmd_id == 0xFFFFu16:
                            return Result.Err("NVMe: batch write submit failed")
                        op_index = op_index + 1
                    status = q.wait_completions(total_commands, CMD_TIMEOUT)
                    updated_queues.push(q)
                    matched_queue = true
                else:
                    updated_queues.push(existing)
            self.user_io_queues = updated_queues
            if not matched_queue:
                return Result.Err("NVMe: I/O queue not ready")
        if status.is_err():
            return Result.Err("NVMe: batch write " + status.unwrap_err())
        if status.unwrap() != 0u32:
            return Result.Err("NVMe: batch write error, status=" + status.unwrap().to_u64().to_text())
        if nvme_queue_is_system_reserved(queue_id):
            self.remember_system_namespace_raw_access(nsid)
        Result.Ok(true)
