# Semantic wrapper types for NVMe transfer command construction.
# Single-field value structs (no heap) so freestanding drivers can use them.
# Each keeps the width of the primitive it wraps; mixing them is a type error.

struct NvmeNamespaceId:
    value: u32

struct NvmeLba:
    value: u64

# Number of logical blocks in one transfer (NLB + 1).
struct NvmeSectorCount:
    value: u32

# Total logical blocks in a namespace (capacity).
struct NvmeNamespaceSectors:
    value: u64

export NvmeNamespaceId, NvmeLba, NvmeSectorCount, NvmeNamespaceSectors
