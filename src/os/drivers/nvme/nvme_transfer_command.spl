# Syscall-free NVMe I/O command construction shared by hosted and freestanding drivers.

use os.drivers.nvme.nvme_transfer_types.{NvmeNamespaceId, NvmeLba, NvmeSectorCount, NvmeNamespaceSectors}

struct NvmeIoCommand:
    opcode: u8
    nsid: NvmeNamespaceId
    prp1: u64
    prp2: u64
    cdw10: u32
    cdw11: u32
    cdw12: u32

val NVME_TRANSFER_OPCODE_FLUSH: u8 = 0x00
val NVME_TRANSFER_OPCODE_WRITE: u8 = 0x01
val NVME_TRANSFER_OPCODE_READ: u8 = 0x02
val NVME_TRANSFER_MAX_NLB_COUNT: u32 = 65536

fn nvme_io_lba_range_reason(lba: NvmeLba, count: NvmeSectorCount, sector_count: NvmeNamespaceSectors) -> text:
    if count.value == 0u32:
        return "nvme-io-zero-sector-count"
    if count.value > NVME_TRANSFER_MAX_NLB_COUNT:
        return "nvme-io-sector-count-too-large"
    val count_u64 = count.value.to_u64()
    if count_u64 > sector_count.value:
        return "nvme-io-beyond-namespace-capacity"
    val last_start = sector_count.value - count_u64
    if lba.value > last_start:
        return "nvme-io-beyond-namespace-capacity"
    "ready"

fn nvme_io_status_code(status_dw3: u32) -> u32:
    (status_dw3 >> 17) & 0x7FFu32

fn nvme_io_command(
    opcode: u8,
    nsid: NvmeNamespaceId,
    lba: NvmeLba,
    count: NvmeSectorCount,
    buf_phys: u64,
    sector_count: NvmeNamespaceSectors
) -> Result<NvmeIoCommand, text>:
    if nsid.value == 0u32:
        return Err("nvme-io-namespace-zero")
    val reason = nvme_io_lba_range_reason(lba, count, sector_count)
    if reason != "ready":
        return Err(reason)
    if buf_phys == 0u64:
        return Err("nvme-io-dma-buffer-zero")
    val lba_low = (lba.value & 0xFFFFFFFFu64).to_u32()
    val lba_high = (lba.value >> 32).to_u32()
    Ok(NvmeIoCommand(
        opcode: opcode,
        nsid: nsid,
        prp1: buf_phys,
        prp2: 0u64,
        cdw10: lba_low,
        cdw11: lba_high,
        cdw12: count.value - 1u32
    ))

fn nvme_read_io_command_for_namespace(nsid: NvmeNamespaceId, lba: NvmeLba, count: NvmeSectorCount, buf_phys: u64, sector_count: NvmeNamespaceSectors) -> Result<NvmeIoCommand, text>:
    nvme_io_command(NVME_TRANSFER_OPCODE_READ, nsid, lba, count, buf_phys, sector_count)

fn nvme_write_io_command_for_namespace(nsid: NvmeNamespaceId, lba: NvmeLba, count: NvmeSectorCount, buf_phys: u64, sector_count: NvmeNamespaceSectors) -> Result<NvmeIoCommand, text>:
    nvme_io_command(NVME_TRANSFER_OPCODE_WRITE, nsid, lba, count, buf_phys, sector_count)

fn nvme_read_io_command(lba: NvmeLba, count: NvmeSectorCount, buf_phys: u64, sector_count: NvmeNamespaceSectors) -> Result<NvmeIoCommand, text>:
    nvme_read_io_command_for_namespace(NvmeNamespaceId(value: 1u32), lba, count, buf_phys, sector_count)

fn nvme_write_io_command(lba: NvmeLba, count: NvmeSectorCount, buf_phys: u64, sector_count: NvmeNamespaceSectors) -> Result<NvmeIoCommand, text>:
    nvme_write_io_command_for_namespace(NvmeNamespaceId(value: 1u32), lba, count, buf_phys, sector_count)

fn nvme_flush_io_command_for_namespace(nsid: NvmeNamespaceId) -> Result<NvmeIoCommand, text>:
    if nsid.value == 0u32:
        return Err("nvme-io-namespace-zero")
    Ok(NvmeIoCommand(
        opcode: NVME_TRANSFER_OPCODE_FLUSH,
        nsid: nsid,
        prp1: 0u64,
        prp2: 0u64,
        cdw10: 0u32,
        cdw11: 0u32,
        cdw12: 0u32
    ))

fn nvme_flush_io_command() -> NvmeIoCommand:
    NvmeIoCommand(
        opcode: NVME_TRANSFER_OPCODE_FLUSH,
        nsid: NvmeNamespaceId(value: 1u32),
        prp1: 0u64,
        prp2: 0u64,
        cdw10: 0u32,
        cdw11: 0u32,
        cdw12: 0u32
    )

export NvmeIoCommand
export NVME_TRANSFER_OPCODE_FLUSH, NVME_TRANSFER_OPCODE_WRITE, NVME_TRANSFER_OPCODE_READ, NVME_TRANSFER_MAX_NLB_COUNT
export nvme_io_lba_range_reason, nvme_io_status_code, nvme_io_command
export nvme_read_io_command_for_namespace, nvme_write_io_command_for_namespace
export nvme_read_io_command, nvme_write_io_command
export nvme_flush_io_command_for_namespace, nvme_flush_io_command
