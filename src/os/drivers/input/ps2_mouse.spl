# PS/2 Mouse Driver
#
# Reads 3-byte (plain) or 4-byte (IntelliMouse, wheel) packets from the PS/2
# auxiliary device. Tracks absolute cursor position with screen bounds clamping.
#
# MDSOC: feature dimension, drivers layer
# Requires: CapabilityKind.PortIO(base: 0x60, count: 4) capability
#
# ISR/decode split (WS-C, C2 driver half)
# ---------------------------------------
# `isr_ingest()` is the ISR-safe half: read the status port, read at most ONE
# data byte, store it in the fixed-capacity `raw_ring`, return. No allocation,
# no `text`, no trait dispatch, no event construction. `decode_pending()` is the
# task-side half: it drains the ring, reassembles packets, and builds a
# `MouseEvent`. `poll()` is now literally "call `isr_ingest()` in a loop, then
# `decode_pending()`", so the polled and the (future) IRQ-driven path differ by
# exactly one line — who calls `isr_ingest`.
#
# Wheel sign convention (WS-C, C3) — POSITIVE = SCROLLED DOWN
# -----------------------------------------------------------
# The PS/2 wire protocol reports positive Z = wheel scrolled DOWN. Workstream
# B's `HostInputEvent.wheel` uses the SAME convention (positive = down).
# Therefore **NO LAYER NEGATES**: the Z byte's sign passes through this driver
# unchanged into `MouseEvent.wheel`, and unchanged again through the future
# HostInputEvent adapter.
#
# This is deliberate and load-bearing. An earlier draft of the plan said to
# "negate once at the adapter" on the assumption that the UI convention was
# +1 = up; it is not. Do not "fix" this by adding a negation anywhere — that
# would make the wheel scroll backwards end to end. `decode_wheel_z()` returns
# the raw PS/2-signed value and that is what ships.

use os.kernel.boot.cpu.{port_inb, port_outb}

# ============================================================================
# PS/2 Controller Constants
# ============================================================================

val MOUSE_DATA_PORT: u16 = 0x60
val MOUSE_STATUS_PORT: u16 = 0x64
val MOUSE_COMMAND_PORT: u16 = 0x64

# Status register bits
val MOUSE_STATUS_OUTPUT_FULL: u8 = 0x01
val MOUSE_STATUS_INPUT_FULL: u8 = 0x02
val MOUSE_STATUS_AUX_DATA: u8 = 0x20   # Bit 5: data is from aux (mouse)

# Controller commands
val CMD_ENABLE_AUX: u8 = 0xA8
val CMD_READ_CONFIG: u8 = 0x20
val CMD_WRITE_CONFIG: u8 = 0x60
val CMD_WRITE_AUX: u8 = 0xD4

# Mouse commands
val MOUSE_CMD_SET_DEFAULTS: u8 = 0xF6
val MOUSE_CMD_ENABLE_REPORTING: u8 = 0xF4
val MOUSE_CMD_SET_SAMPLE_RATE: u8 = 0xF3
val MOUSE_CMD_GET_DEVICE_ID: u8 = 0xF2
val MOUSE_CMD_RESET: u8 = 0xFF

# Mouse acknowledgement byte
val MOUSE_ACK: i64 = 0xFA

# Device IDs reported by the 0xF2 probe
val MOUSE_ID_PLAIN: i64 = 0x00        # 3-byte packets, no wheel
val MOUSE_ID_WHEEL: i64 = 0x03        # IntelliMouse: 4-byte packets, i8 Z
val MOUSE_ID_WHEEL_5BTN: i64 = 0x04   # IntelliMouse Explorer: 4-bit signed Z

# Raw byte ring capacity (ISR side; fixed, never reallocated)
val MOUSE_RING_CAPACITY: i64 = 64

# ============================================================================
# Data Structures
# ============================================================================

struct MouseState:
    """Current absolute mouse position and button state."""
    x: i64
    y: i64
    left_button: bool
    right_button: bool
    middle_button: bool
    dx: i64
    dy: i64
    screen_width: i64
    screen_height: i64

struct MouseEvent:
    """A single mouse event with position, deltas, and edge-triggered buttons."""
    x: i64
    y: i64
    dx: i64
    dy: i64
    left_pressed: bool
    right_pressed: bool
    middle_pressed: bool
    left_just_pressed: bool
    right_just_pressed: bool
    left_just_released: bool
    # Wheel detents for THIS event. POSITIVE = SCROLLED DOWN (see file header;
    # this matches both the PS/2 wire sign and HostInputEvent.wheel, so no
    # layer negates). Defaulted so the non-PS/2 producers (winit / virtio /
    # USB-HID backends) keep constructing MouseEvent unchanged until they gain
    # wheel support.
    wheel: i64 = 0

# ============================================================================
# Wheel decoding
# ============================================================================

fn decode_wheel_z(byte3: i64, dev_id: i64) -> i64:
    """Decode the Z (wheel) byte of a 4-byte IntelliMouse packet.

    Device ID 0x03 (IntelliMouse): byte 3 is a full signed i8.
    Device ID 0x04 (IntelliMouse Explorer): only the low nibble is the signed
    Z (4-bit two's complement); bits 4 and 5 are buttons 4 and 5, which this
    driver ignores for now.

    The returned sign is the RAW PS/2 sign and is NOT flipped anywhere:
    positive = wheel scrolled DOWN. See the file header.
    """
    if dev_id == MOUSE_ID_WHEEL_5BTN:
        val n = byte3 & 0x0F
        if n > 7:
            return n - 16
        return n
    val z = byte3 & 0xFF
    if z > 127:
        return z - 256
    z

# ============================================================================
# PS/2 Mouse Driver
# ============================================================================

class Ps2Mouse:
    """PS/2 mouse driver.

    Reads 3-byte packets from the PS/2 auxiliary device, tracks absolute
    cursor position with screen bounds clamping, and generates MouseEvents
    with edge-triggered button state.
    """
    state: MouseState
    prev_left: bool
    prev_right: bool
    packet_byte0: i64
    packet_byte1: i64
    packet_byte2: i64
    packet_byte3: i64
    packet_index: i64
    initialized: bool
    # IntelliMouse state (C3)
    has_wheel: bool
    dev_id: i64
    wheel: i64
    # ISR-side raw byte ring (C2). Fixed capacity, allocated once in create().
    raw_ring: [i64]
    raw_head: i64
    raw_tail: i64
    raw_count: i64
    raw_dropped: i64

impl Ps2Mouse:
    static fn create(screen_width: i64, screen_height: i64) -> Ps2Mouse:
        """Create a new PS/2 mouse driver for the given screen dimensions."""
        val initial_state = MouseState(
            x: screen_width / 2,
            y: screen_height / 2,
            left_button: false,
            right_button: false,
            middle_button: false,
            dx: 0,
            dy: 0,
            screen_width: screen_width,
            screen_height: screen_height
        )
        Ps2Mouse(
            state: initial_state,
            prev_left: false,
            prev_right: false,
            packet_byte0: 0,
            packet_byte1: 0,
            packet_byte2: 0,
            packet_byte3: 0,
            packet_index: 0,
            initialized: false,
            has_wheel: false,
            dev_id: MOUSE_ID_PLAIN,
            wheel: 0,
            raw_ring: [0; 64],
            raw_head: 0,
            raw_tail: 0,
            raw_count: 0,
            raw_dropped: 0
        )

    me init():
        """Initialize PS/2 auxiliary device for mouse input.

        Sequence:
        1. Enable auxiliary device (cmd 0xA8)
        2. Enable auxiliary interrupts in config byte
        3. Set defaults (0xF6)
        4. IntelliMouse sample-rate knock (200/100/80) + 0xF2 device-ID probe
        5. Enable data reporting (0xF4)
        """
        # Step 1: Enable the auxiliary device
        port_outb(MOUSE_COMMAND_PORT, CMD_ENABLE_AUX)
        self._wait_input()

        # Step 2: Read config byte, set bit 1 (enable aux interrupt),
        #         clear bit 5 (enable aux clock)
        port_outb(MOUSE_COMMAND_PORT, CMD_READ_CONFIG)
        self._wait_output()
        val config = port_inb(MOUSE_DATA_PORT)
        val new_config = (config | 0x02) & 0xDF   # Set bit 1, clear bit 5
        port_outb(MOUSE_COMMAND_PORT, CMD_WRITE_CONFIG)
        self._wait_input()
        port_outb(MOUSE_DATA_PORT, new_config)
        self._wait_input()

        # Step 3: Set defaults
        self._mouse_write(MOUSE_CMD_SET_DEFAULTS)
        self._mouse_read()   # ACK

        # Step 4: IntelliMouse enable — the magic sample-rate knock. A plain
        # PS/2 mouse ignores it and keeps reporting ID 0x00 / 3-byte packets;
        # a wheel mouse switches to ID 0x03 / 4-byte packets.
        self._enable_intellimouse()

        # Step 5: Enable data reporting
        self._mouse_write(MOUSE_CMD_ENABLE_REPORTING)
        self._mouse_read()   # ACK

        self.initialized = true

    me _enable_intellimouse():
        """Send the 200/100/80 sample-rate knock, then probe the device ID.

        Sequence (each command byte prefixed by CMD_WRITE_AUX on port 0x64 and
        ack-waited, which `_mouse_write` + `_mouse_read` already do):

            F3 C8 / F3 64 / F3 50   -> knock
            F2                      -> Get Device ID
            <id>                    -> 0x03 wheel, 0x04 wheel + 5 buttons,
                                       0x00 plain 3-byte mouse
            F3 64                   -> restore a sane 100 Hz sample rate

        Sets `self.dev_id` and `self.has_wheel`; packet length becomes
        `has_wheel ? 4 : 3` (see `_packet_length`).
        """
        self._set_sample_rate(200u8)
        self._set_sample_rate(100u8)
        self._set_sample_rate(80u8)

        self._mouse_write(MOUSE_CMD_GET_DEVICE_ID)
        self._mouse_read()              # ACK
        val id = self._mouse_read()     # device ID byte
        self.apply_device_id(id)

        # Restore a sane sample rate after the knock.
        self._set_sample_rate(100u8)

    me _set_sample_rate(rate: u8):
        """`F3 <rate>`, each byte ack-waited."""
        self._mouse_write(MOUSE_CMD_SET_SAMPLE_RATE)
        self._mouse_read()   # ACK
        self._mouse_write(rate)
        self._mouse_read()   # ACK

    me apply_device_id(id: i64):
        """Record the probed device ID and derive wheel support.

        Hardware-free seam: specs drive this directly to prove the enable
        sequence's decision table without touching a port.
        """
        self.dev_id = id
        self.has_wheel = (id == MOUSE_ID_WHEEL) or (id == MOUSE_ID_WHEEL_5BTN)

    fn packet_length() -> i64:
        """Bytes per packet: 4 on a wheel mouse, 3 otherwise."""
        if self.has_wheel:
            return 4
        3

    me poll() -> MouseEvent?:
        """Poll for available mouse data and return an event if a packet is ready.

        Exactly two steps: drain the hardware into the raw ring via the SAME
        `isr_ingest()` an interrupt handler will call, then decode. Under IRQ
        mode the ingest loop is simply not run here — that is the only
        difference between the two modes.
        """
        if not self.initialized:
            return nil

        var max_reads: i64 = 32  # Prevent infinite loop
        while max_reads > 0:
            max_reads = max_reads - 1
            if not self.isr_ingest():
                break

        self.decode_pending()

    me isr_ingest() -> bool:
        """ISR-safe half: read the status port, read at most ONE data byte.

        Returns true when a byte was captured. No allocation, no `text`, no
        trait dispatch, no event construction — the fixed `raw_ring` is
        preallocated in `create()`. On overflow the byte is dropped and
        `raw_dropped` is incremented (the ISR never blocks).
        """
        val status = port_inb(MOUSE_STATUS_PORT)
        val has_data = (status & MOUSE_STATUS_OUTPUT_FULL) != 0
        val is_aux = (status & MOUSE_STATUS_AUX_DATA) != 0
        if not has_data or not is_aux:
            return false
        val byte_val = port_inb(MOUSE_DATA_PORT).to_i64()
        self.feed_raw_byte(byte_val)
        true

    me feed_raw_byte(byte_val: i64) -> bool:
        """Push one raw byte into the ring. Returns false if it was dropped.

        This is the store half of `isr_ingest()`, split out so specs (and any
        replay harness) can drive the decoder without a live PS/2 controller.
        """
        if self.raw_count >= MOUSE_RING_CAPACITY:
            self.raw_dropped = self.raw_dropped + 1
            return false
        self.raw_ring[self.raw_tail] = byte_val
        self.raw_tail = (self.raw_tail + 1) % MOUSE_RING_CAPACITY
        self.raw_count = self.raw_count + 1
        true

    me _ring_pop() -> i64:
        """Remove and return the oldest raw byte. Caller checks `raw_count` first."""
        val v = self.raw_ring[self.raw_head]
        self.raw_head = (self.raw_head + 1) % MOUSE_RING_CAPACITY
        self.raw_count = self.raw_count - 1
        v

    me decode_pending() -> MouseEvent?:
        """Task-side half: drain the raw ring, reassembling packets.

        Returns the first completed `MouseEvent`, leaving any remaining bytes
        in the ring for the next call — which is exactly the old `poll()`
        contract (return as soon as one packet completes). Returns nil when
        the ring runs dry without completing a packet.
        """
        val plen = self.packet_length()
        while self.raw_count > 0:
            val byte_val = self._ring_pop()

            if self.packet_index == 0:
                # Byte 0: validate — bit 3 must be set (always 1)
                if (byte_val & 0x08) == 0:
                    # Out of sync, discard and re-sync
                    self.packet_index = 0
                    continue
                self.packet_byte0 = byte_val
                self.packet_index = 1
            elif self.packet_index == 1:
                self.packet_byte1 = byte_val
                self.packet_index = 2
            elif self.packet_index == 2:
                self.packet_byte2 = byte_val
                if plen == 3:
                    self.packet_byte3 = 0
                    self.packet_index = 0
                    return self._complete_packet()
                self.packet_index = 3
            else:
                self.packet_byte3 = byte_val
                self.packet_index = 0
                return self._complete_packet()

        return nil

    me _complete_packet() -> MouseEvent:
        """Parse the buffered packet and build the outgoing event."""
        self._process_packet()

        # Build event with edge-triggered button state
        val left_just = self.state.left_button and not self.prev_left
        val right_just = self.state.right_button and not self.prev_right
        val left_released = not self.state.left_button and self.prev_left

        val event = MouseEvent(
            x: self.state.x,
            y: self.state.y,
            dx: self.state.dx,
            dy: self.state.dy,
            left_pressed: self.state.left_button,
            right_pressed: self.state.right_button,
            middle_pressed: self.state.middle_button,
            left_just_pressed: left_just,
            right_just_pressed: right_just,
            left_just_released: left_released,
            wheel: self.wheel
        )

        # Update previous button state
        self.prev_left = self.state.left_button
        self.prev_right = self.state.right_button

        event

    me _mouse_write(byte_val: u8):
        """Write a command byte to the mouse via the PS/2 controller."""
        self._wait_input()
        port_outb(MOUSE_COMMAND_PORT, CMD_WRITE_AUX)
        self._wait_input()
        port_outb(MOUSE_DATA_PORT, byte_val)

    me _mouse_read() -> i64:
        """Read a response byte from the mouse."""
        self._wait_output()
        port_inb(MOUSE_DATA_PORT).to_i64()

    me _wait_input():
        """Wait until the PS/2 controller input buffer is empty."""
        var timeout: i64 = 100000
        while timeout > 0:
            val status = port_inb(MOUSE_STATUS_PORT)
            if (status & MOUSE_STATUS_INPUT_FULL) == 0:
                return
            timeout = timeout - 1

    me _wait_output():
        """Wait until the PS/2 controller output buffer has data."""
        var timeout: i64 = 100000
        while timeout > 0:
            val status = port_inb(MOUSE_STATUS_PORT)
            if (status & MOUSE_STATUS_OUTPUT_FULL) != 0:
                return
            timeout = timeout - 1

    me _process_packet():
        """Parse a PS/2 mouse packet and update state.

        Packet format:
          Byte 0: Y_overflow | X_overflow | Y_sign | X_sign | 1 | Middle | Right | Left
          Byte 1: X movement (unsigned, sign from byte 0 bit 4)
          Byte 2: Y movement (unsigned, sign from byte 0 bit 5)
          Byte 3: Z (wheel) — present only on a wheel mouse (has_wheel)
        """
        val flags = self.packet_byte0
        val raw_x = self.packet_byte1
        val raw_y = self.packet_byte2

        # Wheel. Sign passes through unchanged: positive = scrolled down.
        if self.has_wheel:
            self.wheel = decode_wheel_z(self.packet_byte3, self.dev_id)
        else:
            self.wheel = 0

        # Extract button state
        self.state.left_button = (flags & 0x01) != 0
        self.state.right_button = (flags & 0x02) != 0
        self.state.middle_button = (flags & 0x04) != 0

        # Check overflow bits — discard movement if overflow
        val x_overflow = (flags & 0x40) != 0
        val y_overflow = (flags & 0x80) != 0

        if x_overflow or y_overflow:
            self.state.dx = 0
            self.state.dy = 0
            return

        # Sign-extend X movement using bit 4 of flags
        var dx: i64 = raw_x
        val x_sign = (flags & 0x10) != 0
        if x_sign:
            # Negative: sign-extend from 8-bit to 64-bit
            dx = dx - 256

        # Sign-extend Y movement using bit 5 of flags
        var dy: i64 = raw_y
        val y_sign = (flags & 0x20) != 0
        if y_sign:
            dy = dy - 256

        # PS/2 Y axis is inverted (positive = up), screen Y is down
        dy = 0 - dy

        self.state.dx = dx
        self.state.dy = dy

        # Update absolute position with clamping
        var new_x = self.state.x + dx
        var new_y = self.state.y + dy

        # Clamp to screen bounds
        if new_x < 0:
            new_x = 0
        if new_x >= self.state.screen_width:
            new_x = self.state.screen_width - 1
        if new_y < 0:
            new_y = 0
        if new_y >= self.state.screen_height:
            new_y = self.state.screen_height - 1

        self.state.x = new_x
        self.state.y = new_y

    fn get_state() -> MouseState:
        """Get current mouse state (position + buttons)."""
        self.state

    fn is_initialized() -> bool:
        """Check if the mouse driver has been initialized."""
        self.initialized
