# Input Batch — the allocation-free drain target for `InputEventQueue`.
#
# Plan: doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md section 7
# ("Events") and section 0 (decisive milestone `allocations = 0` on a warm
# frame). The plan is explicit: `drain_into(batch)` NOT an allocating
# `drain()`, and "coalesce move/wheel, never down/up/key/text/focus/close".
#
# WHY THIS FILE EXISTS
# --------------------
# `InputEventQueue.drain()` (input_event.spl) builds a fresh `[HostInputEvent]`
# and `.push()`es into it once per event. Under the seed, `.push()` clones the
# whole backing array every time, so a 64-event frame is 64 allocations and
# O(n^2) copying -- on the warm-frame path the section-0 milestone measures.
# `InputBatch` is allocated ONCE at session scope and refilled in place, so a
# steady-state frame performs zero list allocations on the drain step.
#
# WHAT "COALESCE" MUST NEVER DO
# -----------------------------
# Merging a pointer MOVE with the move before it loses nothing: only the newest
# position matters. Merging a key press, a key release, a button press, or a
# button release DESTROYS USER INPUT -- a dropped keystroke or a click that
# never arrives. That is a correctness bug, not a perf trade. So the merge
# predicate is deliberately narrow and stated once, in
# `input_event_is_coalescable`:
#
#   coalescable  <=>  variant is Pointer AND button == HOST_BTN_NONE
#
# `button != HOST_BTN_NONE` is already the repo-wide discriminator for
# down/up (see host_input_event.spl:200, `if button != HOST_BTN_NONE: kind =
# if pressed: "down" else: "up"`), so this predicate is not a new convention.
# `Key` (which carries both down/up and the text character `ch`) and `Resize`
# are NEVER coalescable -- `Resize` is the ingress form of the window
# lifecycle class the plan groups with focus/close, and is left uncoalesced
# on purpose rather than "obviously mergeable".
#
# Two coalescable events merge only when they are the SAME kind: move+move
# (wheel == 0 on both) keeps the newer position; wheel+wheel (wheel != 0 on
# both) keeps the newer position and SUMS the notches, so scroll distance is
# conserved rather than dropped. A move never absorbs a wheel and vice versa.

use common.ui.host_input_event.{HostInputEvent, HOST_BTN_NONE, host_pointer_move}
use os.drivers.input.input_event.{InputEventQueue, INPUT_QUEUE_CAP}

val INPUT_BATCH_CAP: i64 = INPUT_QUEUE_CAP

fn input_event_is_coalescable(ev: HostInputEvent) -> bool:
    """True only for pointer move and pointer wheel.

    False for every pointer press/release, every key event (down, up, and the
    text character it carries), and every resize. A `true` here is a licence to
    DESTROY the older event, so the default answer is false."""
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel):
            return button == HOST_BTN_NONE
        _:
            return false

fn _input_event_is_wheel(ev: HostInputEvent) -> bool:
    """True for a coalescable pointer event that carries wheel notches."""
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel):
            return button == HOST_BTN_NONE and wheel != 0
        _:
            return false

fn input_event_merge(older: HostInputEvent, newer: HostInputEvent) -> HostInputEvent:
    """Merge two same-kind coalescable pointer events into one.

    Callers must have checked `input_event_can_merge` first. Position always
    comes from `newer`; wheel notches ACCUMULATE so scroll distance survives
    the merge."""
    match older:
        HostInputEvent.Pointer(ox, oy, obtn, opressed, owheel):
            match newer:
                HostInputEvent.Pointer(nx, ny, nbtn, npressed, nwheel):
                    return HostInputEvent.Pointer(
                        x: nx, y: ny, button: HOST_BTN_NONE,
                        pressed: npressed, wheel: owheel + nwheel
                    )
                _:
                    return newer
        _:
            return newer

fn input_event_can_merge(older: HostInputEvent, newer: HostInputEvent) -> bool:
    """True only when BOTH are coalescable AND of the same kind.

    A move never absorbs a wheel notch and a wheel never absorbs a move --
    they carry different information, so merging across the two would lose
    one of them."""
    if not input_event_is_coalescable(older):
        return false
    if not input_event_is_coalescable(newer):
        return false
    _input_event_is_wheel(older) == _input_event_is_wheel(newer)

class InputBatch:
    """A fixed-capacity, session-lived drain target.

    Created once; `refill_from` / `refill_coalesced_from` overwrite slots in
    place. `count` is the maintained live length -- the backing array's own
    length is always INPUT_BATCH_CAP and is never measured (Dict/len native
    pitfalls do not apply to arrays, but the counter is still the contract)."""
    slots: [HostInputEvent]
    count: i64
    coalesced: i64
    overflow: i64

impl InputBatch:
    static fn create() -> InputBatch:
        """Preallocate INPUT_BATCH_CAP slots. This is the ONLY allocation."""
        var s: [HostInputEvent] = []
        var i = 0
        # cpu-lane-loop-ok: one-time preallocation of the fixed batch backing
        while i < INPUT_BATCH_CAP:
            s = s.push(host_pointer_move(0 as i32, 0 as i32))
            i = i + 1
        InputBatch(slots: s, count: 0, coalesced: 0, overflow: 0)

    me reset():
        """Drop the live length back to zero without touching the backing
        array. Also clears the per-fill coalesced/overflow tallies."""
        self.count = 0
        self.coalesced = 0
        self.overflow = 0

    me len() -> i64:
        """Live event count. The maintained counter, never a measurement."""
        self.count

    me capacity() -> i64:
        """Fixed batch capacity."""
        INPUT_BATCH_CAP

    me backing_len() -> i64:
        """MEASURED length of the backing array, not the declared capacity.

        This is the one allocation-related fact the event path can actually
        observe from inside the language today: if a refill ever grew the
        batch, this number would move. It is NOT an allocation COUNT -- a
        real count needs runtime instrumentation, and until that exists the
        `allocations` claim is reported through F0's milestone gate as
        `blocked:unmeasured`, never as a fabricated zero."""
        self.slots.len().to_i64()

    me coalesced_count() -> i64:
        """How many events the last fill merged away. Always 0 for a verbatim
        `refill_from`."""
        self.coalesced

    me overflow_count() -> i64:
        """How many events the last fill could not store."""
        self.overflow

    me at(i: i64) -> HostInputEvent:
        """Read slot `i`. Out of range yields a zero move rather than trapping."""
        if i < 0 or i >= self.count:
            return host_pointer_move(0 as i32, 0 as i32)
        self.slots[i]

    me append(ev: HostInputEvent) -> bool:
        """Store one event verbatim. No merging, no allocation."""
        if self.count >= INPUT_BATCH_CAP:
            self.overflow = self.overflow + 1
            return false
        self.slots[self.count] = ev
        self.count = self.count + 1
        true

    me append_coalescing(ev: HostInputEvent) -> bool:
        """Store one event, merging it into the tail when -- and ONLY when --
        `input_event_can_merge` says the pair is a same-kind move/move or
        wheel/wheel. Every other event is appended verbatim."""
        if self.count > 0:
            val prev = self.slots[self.count - 1]
            if input_event_can_merge(prev, ev):
                self.slots[self.count - 1] = input_event_merge(prev, ev)
                self.coalesced = self.coalesced + 1
                return true
        self.append(ev)

impl InputEventQueue:
    me drain_into(batch: InputBatch) -> i64:
        """Move every queued event into `batch`, oldest first, allocating
        nothing. The plan's replacement for `drain()`.

        `count` is read ONCE up front and counted down locally, for the same
        reason `drain()` documents: a self-mutating `me` call driving its own
        loop condition never observes the decremented counter and spins until
        the execution limit aborts the run."""
        batch.reset()
        val n = self.count
        var i = 0
        # cpu-lane-loop-ok: bound is the queue count, at most INPUT_QUEUE_CAP
        while i < n:
            batch.append(self.buf[self.head])
            self.head = (self.head + 1) % INPUT_QUEUE_CAP
            i = i + 1
        self.count = 0
        batch.len()

    me drain_into_coalesced(batch: InputBatch) -> i64:
        """Like `drain_into`, but adjacent same-kind move/move and wheel/wheel
        pairs collapse. Key down, key up, key text, pointer press, pointer
        release and resize are ALWAYS appended verbatim -- dropping one of
        those is lost user input."""
        batch.reset()
        val n = self.count
        var i = 0
        # cpu-lane-loop-ok: bound is the queue count, at most INPUT_QUEUE_CAP
        while i < n:
            batch.append_coalescing(self.buf[self.head])
            self.head = (self.head + 1) % INPUT_QUEUE_CAP
            i = i + 1
        self.count = 0
        batch.len()

export INPUT_BATCH_CAP, InputBatch
export input_event_is_coalescable, input_event_can_merge, input_event_merge
