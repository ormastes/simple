# Pure-Simple modern VirtIO-input MMIO transport for QEMU virt machines.

use os.kernel.boot.mmio.{
    mmio_read8, mmio_write8, mmio_read16, mmio_write16,
    mmio_read32, mmio_write32
}
use os.drivers.virtio.virtio_input_wire.{
    VirtioInputEvent,
    VIRTIO_INPUT_DEVICE_KEYBOARD,
    VIRTIO_INPUT_DEVICE_POINTER
}

extern fn rt_dma_alloc(size: i64, dir_raw: i32) -> i64
extern fn rt_dma_free(handle: i64)
extern fn rt_dma_virt_of(handle: i64) -> i64
extern fn rt_dma_phys_of(handle: i64) -> i64
extern fn rt_dma_sync_for_device(handle: i64, dir_raw: i32)
extern fn rt_dma_sync_for_cpu(handle: i64, dir_raw: i32)
extern fn rt_memory_barrier()

val VIRTIO_INPUT_DEVICE_ID: u32 = 18u32
val VIRTIO_INPUT_DEVICE_CONTROLLER: u32 = 3u32
val VIRTIO_INPUT_QUEUE_SIZE: u16 = 8u16
val VIRTIO_INPUT_DMA_BYTES: i64 = 4096
val VIRTIO_INPUT_DESC_OFFSET: u64 = 0u64
val VIRTIO_INPUT_AVAIL_OFFSET: u64 = 128u64
val VIRTIO_INPUT_USED_OFFSET: u64 = 192u64
val VIRTIO_INPUT_EVENTS_OFFSET: u64 = 512u64
val VIRTIO_INPUT_EVENT_BYTES: u32 = 8u32

val VIRTIO_MMIO_MAGIC: u64 = 0x000u64
val VIRTIO_MMIO_VERSION: u64 = 0x004u64
val VIRTIO_MMIO_DEVICE_ID: u64 = 0x008u64
val VIRTIO_MMIO_DEVICE_FEATURES: u64 = 0x010u64
val VIRTIO_MMIO_DEVICE_FEATURES_SEL: u64 = 0x014u64
val VIRTIO_MMIO_DRIVER_FEATURES: u64 = 0x020u64
val VIRTIO_MMIO_DRIVER_FEATURES_SEL: u64 = 0x024u64
val VIRTIO_MMIO_QUEUE_SEL: u64 = 0x030u64
val VIRTIO_MMIO_QUEUE_NUM_MAX: u64 = 0x034u64
val VIRTIO_MMIO_QUEUE_NUM: u64 = 0x038u64
val VIRTIO_MMIO_QUEUE_READY: u64 = 0x044u64
val VIRTIO_MMIO_QUEUE_NOTIFY: u64 = 0x050u64
val VIRTIO_MMIO_INTERRUPT_STATUS: u64 = 0x060u64
val VIRTIO_MMIO_INTERRUPT_ACK: u64 = 0x064u64
val VIRTIO_MMIO_STATUS: u64 = 0x070u64
val VIRTIO_MMIO_QUEUE_DESC_LOW: u64 = 0x080u64
val VIRTIO_MMIO_QUEUE_DESC_HIGH: u64 = 0x084u64
val VIRTIO_MMIO_QUEUE_AVAIL_LOW: u64 = 0x090u64
val VIRTIO_MMIO_QUEUE_AVAIL_HIGH: u64 = 0x094u64
val VIRTIO_MMIO_QUEUE_USED_LOW: u64 = 0x0A0u64
val VIRTIO_MMIO_QUEUE_USED_HIGH: u64 = 0x0A4u64
val VIRTIO_INPUT_CFG_SELECT: u64 = 0x100u64
val VIRTIO_INPUT_CFG_SUBSEL: u64 = 0x101u64
val VIRTIO_INPUT_CFG_SIZE: u64 = 0x102u64
val VIRTIO_INPUT_CFG_DATA: u64 = 0x108u64

val VIRTIO_STATUS_ACKNOWLEDGE: u32 = 1u32
val VIRTIO_STATUS_DRIVER: u32 = 2u32
val VIRTIO_STATUS_DRIVER_OK: u32 = 4u32
val VIRTIO_STATUS_FEATURES_OK: u32 = 8u32
val VIRTIO_STATUS_FAILED: u32 = 128u32
val VIRTIO_INPUT_CFG_EV_BITS: u8 = 0x11u8
val VIRTIO_INPUT_CFG_ID_DEVIDS: u8 = 0x03u8
val EV_KEY_U8: u8 = 0x01u8
val EV_REL_U8: u8 = 0x02u8
val EV_ABS_U8: u8 = 0x03u8
val KEY_A_BIT: u16 = 30u16
val REL_X_BIT: u16 = 0u16
val REL_Y_BIT: u16 = 1u16
val BTN_LEFT_BIT: u16 = 0x110u16
val BTN_GAMEPAD_BIT: u16 = 0x130u16
val ABS_X_BIT: u16 = 0u16
val ABS_Y_BIT: u16 = 1u16

struct VirtioInputDma:
    handle: i64
    cpu: u64
    device: u64

class VirtioInputPollReceipt:
    available: bool
    event: VirtioInputEvent

fn virtio_input_mmio_layout_valid(cpu: u64, device: u64) -> bool:
    cpu != 0u64 and device != 0u64 and (cpu & 127u64) == 0u64 and (device & 127u64) == 0u64

fn virtio_input_event_length_valid(length: u32) -> bool:
    length == VIRTIO_INPUT_EVENT_BYTES

fn virtio_input_device_kind_from_caps(keyboard: bool, rel_x: bool, rel_y: bool, left: bool, abs_x: bool, abs_y: bool, gamepad: bool) -> u32:
    if abs_x and abs_y and gamepad: return VIRTIO_INPUT_DEVICE_CONTROLLER
    if (rel_x and rel_y) or (abs_x and abs_y): return VIRTIO_INPUT_DEVICE_POINTER
    if keyboard: return VIRTIO_INPUT_DEVICE_KEYBOARD
    0u32

fn virtio_input_device_kind_from_ids(vendor: u32, product: u32) -> u32:
    # QEMU virtio-input-hid.c assigns vendor 0x0627 and products 1/2/3 to
    # keyboard/mouse/tablet. Keep this as a fallback after generic caps.
    if vendor != 0x0627u32: return 0u32
    if product == 1u32: return VIRTIO_INPUT_DEVICE_KEYBOARD
    if product == 2u32 or product == 3u32: return VIRTIO_INPUT_DEVICE_POINTER
    0u32

fn _virtio_input_qemu_kind(base: u64) -> u32:
    mmio_write8(base + VIRTIO_INPUT_CFG_SELECT, VIRTIO_INPUT_CFG_ID_DEVIDS)
    mmio_write8(base + VIRTIO_INPUT_CFG_SUBSEL, 0u8)
    rt_memory_barrier()
    if mmio_read8(base + VIRTIO_INPUT_CFG_SIZE).to_u32() < 6u32: return 0u32
    val vendor = mmio_read16(base + VIRTIO_INPUT_CFG_DATA + 2u64).to_u32()
    val product = mmio_read16(base + VIRTIO_INPUT_CFG_DATA + 4u64).to_u32()
    virtio_input_device_kind_from_ids(vendor, product)

fn _virtio_input_config_has_bit(base: u64, event_type: u8, bit: u16) -> bool:
    mmio_write8(base + VIRTIO_INPUT_CFG_SELECT, VIRTIO_INPUT_CFG_EV_BITS)
    mmio_write8(base + VIRTIO_INPUT_CFG_SUBSEL, event_type)
    rt_memory_barrier()
    val bytes = mmio_read8(base + VIRTIO_INPUT_CFG_SIZE).to_u32()
    val byte_index = bit.to_u32() / 8u32
    if bytes == 0u32 or byte_index >= bytes or byte_index >= 128u32:
        return false
    val byte = mmio_read8(base + VIRTIO_INPUT_CFG_DATA + byte_index.to_u64())
    (byte & (1u8 << (bit.to_u32() & 7u32))) != 0u8

fn virtio_input_mmio_kind(base: u64) -> u32:
    val caps_kind = virtio_input_device_kind_from_caps(
        _virtio_input_config_has_bit(base, EV_KEY_U8, KEY_A_BIT),
        _virtio_input_config_has_bit(base, EV_REL_U8, REL_X_BIT),
        _virtio_input_config_has_bit(base, EV_REL_U8, REL_Y_BIT),
        _virtio_input_config_has_bit(base, EV_KEY_U8, BTN_LEFT_BIT),
        _virtio_input_config_has_bit(base, EV_ABS_U8, ABS_X_BIT),
        _virtio_input_config_has_bit(base, EV_ABS_U8, ABS_Y_BIT),
        _virtio_input_config_has_bit(base, EV_KEY_U8, BTN_GAMEPAD_BIT)
    )
    if caps_kind != 0u32: return caps_kind
    _virtio_input_qemu_kind(base)

fn _virtio_input_dma_create() -> VirtioInputDma:
    val handle = rt_dma_alloc(VIRTIO_INPUT_DMA_BYTES, 2)
    if handle < 0:
        return VirtioInputDma(handle: -1, cpu: 0u64, device: 0u64)
    val cpu = rt_dma_virt_of(handle).to_u64()
    val device = rt_dma_phys_of(handle).to_u64()
    if not virtio_input_mmio_layout_valid(cpu, device):
        rt_dma_free(handle)
        return VirtioInputDma(handle: -1, cpu: 0u64, device: 0u64)
    var offset: u64 = 0u64
    while offset < VIRTIO_INPUT_DMA_BYTES.to_u64():
        mmio_write32(cpu + offset, 0u32)
        offset = offset + 4u64
    VirtioInputDma(handle: handle, cpu: cpu, device: device)

class VirtioInputMmioDevice:
    base: u64
    kind: u32
    dma: VirtioInputDma
    last_used: u16
    next_avail: u16
    ready: bool

impl VirtioInputMmioDevice:
    static fn unavailable() -> VirtioInputMmioDevice:
        VirtioInputMmioDevice(base: 0u64, kind: 0u32, dma: VirtioInputDma(handle: -1, cpu: 0u64, device: 0u64), last_used: 0u16, next_avail: 0u16, ready: false)

    static fn start(base: u64) -> VirtioInputMmioDevice:
        var device = VirtioInputMmioDevice.unavailable()
        if base == 0u64 or mmio_read32(base + VIRTIO_MMIO_MAGIC) != 0x74726976u32 or
            mmio_read32(base + VIRTIO_MMIO_VERSION) != 2u32 or
            mmio_read32(base + VIRTIO_MMIO_DEVICE_ID) != VIRTIO_INPUT_DEVICE_ID:
            return device
        val kind = virtio_input_mmio_kind(base)
        if kind == 0u32: return device
        val dma = _virtio_input_dma_create()
        if dma.handle < 0: return device
        device = VirtioInputMmioDevice(base: base, kind: kind, dma: dma, last_used: 0u16, next_avail: VIRTIO_INPUT_QUEUE_SIZE, ready: false)
        mmio_write32(base + VIRTIO_MMIO_STATUS, 0u32)
        rt_memory_barrier()
        mmio_write32(base + VIRTIO_MMIO_STATUS, VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER)
        mmio_write32(base + VIRTIO_MMIO_DEVICE_FEATURES_SEL, 1u32)
        if (mmio_read32(base + VIRTIO_MMIO_DEVICE_FEATURES) & 1u32) == 0u32:
            device.shutdown()
            return device
        mmio_write32(base + VIRTIO_MMIO_DRIVER_FEATURES_SEL, 0u32)
        mmio_write32(base + VIRTIO_MMIO_DRIVER_FEATURES, 0u32)
        mmio_write32(base + VIRTIO_MMIO_DRIVER_FEATURES_SEL, 1u32)
        mmio_write32(base + VIRTIO_MMIO_DRIVER_FEATURES, 1u32)
        val feature_status = VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_FEATURES_OK
        mmio_write32(base + VIRTIO_MMIO_STATUS, feature_status)
        if (mmio_read32(base + VIRTIO_MMIO_STATUS) & VIRTIO_STATUS_FEATURES_OK) == 0u32:
            device.shutdown()
            return device
        mmio_write32(base + VIRTIO_MMIO_QUEUE_SEL, 0u32)
        val maximum = mmio_read32(base + VIRTIO_MMIO_QUEUE_NUM_MAX)
        if mmio_read32(base + VIRTIO_MMIO_QUEUE_READY) != 0u32 or maximum < VIRTIO_INPUT_QUEUE_SIZE.to_u32():
            device.shutdown()
            return device
        var index: u16 = 0u16
        while index < VIRTIO_INPUT_QUEUE_SIZE:
            val desc = dma.cpu + VIRTIO_INPUT_DESC_OFFSET + index.to_u64() * 16u64
            val event_device = dma.device + VIRTIO_INPUT_EVENTS_OFFSET + index.to_u64() * 8u64
            mmio_write32(desc, (event_device & 0xFFFFFFFFu64).to_u32())
            mmio_write32(desc + 4u64, (event_device >> 32).to_u32())
            mmio_write32(desc + 8u64, VIRTIO_INPUT_EVENT_BYTES)
            mmio_write16(desc + 12u64, 2u16)
            mmio_write16(desc + 14u64, 0u16)
            mmio_write16(dma.cpu + VIRTIO_INPUT_AVAIL_OFFSET + 4u64 + index.to_u64() * 2u64, index)
            index = index + 1u16
        mmio_write16(dma.cpu + VIRTIO_INPUT_AVAIL_OFFSET + 2u64, VIRTIO_INPUT_QUEUE_SIZE)
        rt_dma_sync_for_device(dma.handle, 2)
        mmio_write32(base + VIRTIO_MMIO_QUEUE_NUM, VIRTIO_INPUT_QUEUE_SIZE.to_u32())
        device._write_queue_address(VIRTIO_MMIO_QUEUE_DESC_LOW, dma.device + VIRTIO_INPUT_DESC_OFFSET)
        device._write_queue_address(VIRTIO_MMIO_QUEUE_AVAIL_LOW, dma.device + VIRTIO_INPUT_AVAIL_OFFSET)
        device._write_queue_address(VIRTIO_MMIO_QUEUE_USED_LOW, dma.device + VIRTIO_INPUT_USED_OFFSET)
        mmio_write32(base + VIRTIO_MMIO_QUEUE_READY, 1u32)
        if mmio_read32(base + VIRTIO_MMIO_QUEUE_READY) != 1u32:
            device.shutdown()
            return device
        mmio_write32(base + VIRTIO_MMIO_STATUS, feature_status | VIRTIO_STATUS_DRIVER_OK)
        device.ready = true
        mmio_write32(base + VIRTIO_MMIO_QUEUE_NOTIFY, 0u32)
        device

    fn _write_queue_address(low_offset: u64, address: u64):
        mmio_write32(self.base + low_offset, (address & 0xFFFFFFFFu64).to_u32())
        mmio_write32(self.base + low_offset + 4u64, (address >> 32).to_u32())

    # Allocation-free hot-path check. Bare-metal callers can spin on this
    # without allocating an absent receipt on every empty queue observation.
    me receipt_available() -> bool:
        if not self.ready: return false
        rt_dma_sync_for_cpu(self.dma.handle, 2)
        mmio_read16(self.dma.cpu + VIRTIO_INPUT_USED_OFFSET + 2u64) != self.last_used

    me poll_receipt() -> VirtioInputPollReceipt:
        val absent = VirtioInputPollReceipt(
            available: false,
            event: VirtioInputEvent(device_kind: self.kind, type_: 0u16, code: 0u16, value: 0u32, irq_status: 0u32)
        )
        if not self.ready: return absent
        if not self.receipt_available(): return absent
        val used_slot = self.dma.cpu + VIRTIO_INPUT_USED_OFFSET + 4u64 + (self.last_used % VIRTIO_INPUT_QUEUE_SIZE).to_u64() * 8u64
        val used_id = mmio_read32(used_slot)
        val used_len = mmio_read32(used_slot + 4u64)
        self.last_used = self.last_used + 1u16
        if used_id >= VIRTIO_INPUT_QUEUE_SIZE.to_u32() or not virtio_input_event_length_valid(used_len):
            self.shutdown()
            return absent
        val event_addr = self.dma.cpu + VIRTIO_INPUT_EVENTS_OFFSET + used_id.to_u64() * 8u64
        val event_type = mmio_read16(event_addr)
        val event_code = mmio_read16(event_addr + 2u64)
        val event_value = mmio_read32(event_addr + 4u64)
        val avail_slot = self.dma.cpu + VIRTIO_INPUT_AVAIL_OFFSET + 4u64 + (self.next_avail % VIRTIO_INPUT_QUEUE_SIZE).to_u64() * 2u64
        mmio_write16(avail_slot, used_id.to_u16())
        self.next_avail = self.next_avail + 1u16
        rt_dma_sync_for_device(self.dma.handle, 2)
        mmio_write16(self.dma.cpu + VIRTIO_INPUT_AVAIL_OFFSET + 2u64, self.next_avail)
        rt_memory_barrier()
        mmio_write32(self.base + VIRTIO_MMIO_QUEUE_NOTIFY, 0u32)
        val irq = mmio_read32(self.base + VIRTIO_MMIO_INTERRUPT_STATUS)
        if irq != 0u32: mmio_write32(self.base + VIRTIO_MMIO_INTERRUPT_ACK, irq)
        VirtioInputPollReceipt(
            available: true,
            event: VirtioInputEvent(device_kind: self.kind, type_: event_type, code: event_code, value: event_value, irq_status: irq)
        )

    me poll() -> VirtioInputEvent?:
        val receipt = self.poll_receipt()
        if not receipt.available: return nil
        receipt.event

    me shutdown():
        if self.base != 0u64:
            mmio_write32(self.base + VIRTIO_MMIO_STATUS, 0u32)
            rt_memory_barrier()
        if self.dma.handle >= 0:
            rt_dma_free(self.dma.handle)
        self.dma = VirtioInputDma(handle: -1, cpu: 0u64, device: 0u64)
        self.ready = false

fn virtio_input_mmio_find_kind(start: u64, slots: i64, stride: u64, wanted_kind: u32) -> VirtioInputMmioDevice:
    if start == 0u64 or slots <= 0 or slots > 256 or stride < 0x100u64:
        return VirtioInputMmioDevice.unavailable()
    var slot: i64 = 0
    while slot < slots:
        val base = start + slot.to_u64() * stride
        if mmio_read32(base + VIRTIO_MMIO_MAGIC) == 0x74726976u32 and
            mmio_read32(base + VIRTIO_MMIO_DEVICE_ID) == VIRTIO_INPUT_DEVICE_ID and
            virtio_input_mmio_kind(base) == wanted_kind:
            return VirtioInputMmioDevice.start(base)
        slot = slot + 1
    VirtioInputMmioDevice.unavailable()

export VIRTIO_INPUT_DEVICE_CONTROLLER, VIRTIO_INPUT_QUEUE_SIZE, VIRTIO_INPUT_EVENT_BYTES
export VirtioInputDma, VirtioInputPollReceipt, VirtioInputMmioDevice
export virtio_input_mmio_layout_valid, virtio_input_event_length_valid
export virtio_input_device_kind_from_caps, virtio_input_device_kind_from_ids
export virtio_input_mmio_kind, virtio_input_mmio_find_kind
