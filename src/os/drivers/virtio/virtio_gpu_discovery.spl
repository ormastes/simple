# VirtIO-GPU bounded DEVICE_CFG/shared-memory discovery
#
# This is the pure admission layer for the first Venus discovery slice. It
# consumes already-decoded PCI capability facts and recorded config/capset
# responses. It never submits Vulkan commands and never makes the compositor
# available.

use os.drivers.virtio.virtio_gpu_capset.{GpuCapset}
use os.drivers.virtio.virtio_gpu_regs.{
    VIRTIO_PCI_CAP_DEVICE_CFG, VIRTIO_PCI_CAP_SHARED_MEMORY_CFG,
    VIRTIO_GPU_SHM_ID_HOST_VISIBLE
}
use os.drivers.virtio.virtio_gpu_types.{
    VIRTIO_GPU_F_VIRGL, VIRTIO_GPU_F_RESOURCE_BLOB,
    VIRTIO_GPU_F_CONTEXT_INIT, VIRTIO_GPU_CAPSET_VENUS
}

pub val VIRTIO_GPU_PCI_CAP_VISIT_LIMIT: u32 = 48
pub val VIRTIO_GPU_CAPSET_COUNT_LIMIT: u32 = 64
pub val VIRTIO_GPU_CONFIG_GENERATION_RETRY_LIMIT: u32 = 3
pub val VIRTIO_GPU_CAPSET_PAYLOAD_LIMIT: u32 = 4072

pub enum VirtioGpuDiscoveryState:
    Unavailable
    TransportReady
    Partial
    VenusDiscovered
    Rejected

pub struct VirtioGpuPciCapability:
    cfg_type: u8
    bar: u8
    cap_id: u8
    cap_len: u8
    offset: u64
    length: u64
    source_offset: u8

pub struct VirtioGpuDeviceConfigSample:
    events_read: u32
    num_scanouts: u32
    num_capsets: u32
    generation_before: u8
    generation_after: u8

pub struct VirtioGpuDeviceConfig:
    mapped_address: u64
    events_read: u32
    num_scanouts: u32
    num_capsets: u32
    generation: u8
    attempts: u32

pub struct VirtioGpuSharedMemoryRegion:
    shmid: u8
    bar: u8
    phys_base: u64
    byte_len: u64
    source_offset: u8
    containment_proven: bool

pub struct VirtioGpuDiscoveryReceipt:
    state: VirtioGpuDiscoveryState
    reason: text
    capability_count: u32
    feature_mask: u32
    device_config: VirtioGpuDeviceConfig?
    host_visible_region: VirtioGpuSharedMemoryRegion?
    capsets: List<GpuCapset>
    venus_candidate: GpuCapset?
    complete: bool
    vulkan_executed: bool
    device_readback: bool
    fallback_used: bool

pub class VirtioGpuDiscoveryProvider:
    """Device-lifetime owner for one bounded discovery receipt.

    Hardware adapters supply decoded capability/config facts. The provider
    validates and caches one immutable receipt; reset invalidates it before a
    new device generation can be admitted.
    """
    bar_bases: List<u64>
    bar_sizes: List<u64>
    cached: VirtioGpuDiscoveryReceipt?

    static fn create(bar_bases: List<u64>, bar_sizes: List<u64>) -> VirtioGpuDiscoveryProvider:
        VirtioGpuDiscoveryProvider(bar_bases: bar_bases, bar_sizes: bar_sizes, cached: nil)

    me discover(
        capabilities: List<VirtioGpuPciCapability>,
        config_samples: List<VirtioGpuDeviceConfigSample>,
        feature_mask: u32,
        capsets: List<GpuCapset>
    ) -> VirtioGpuDiscoveryReceipt:
        val receipt = virtio_gpu_build_discovery_receipt(
            capabilities, self.bar_bases, self.bar_sizes,
            config_samples, feature_mask, capsets
        )
        self.cached = Some(receipt)
        receipt

    fn cached_receipt() -> VirtioGpuDiscoveryReceipt?:
        self.cached

    me reset():
        self.cached = nil

fn _discovery_receipt(
    state: VirtioGpuDiscoveryState,
    reason: text,
    capability_count: u32,
    feature_mask: u32,
    device_config: VirtioGpuDeviceConfig?,
    host_visible_region: VirtioGpuSharedMemoryRegion?,
    capsets: List<GpuCapset>,
    venus_candidate: GpuCapset?,
    complete: bool
) -> VirtioGpuDiscoveryReceipt:
    VirtioGpuDiscoveryReceipt(
        state: state,
        reason: reason,
        capability_count: capability_count,
        feature_mask: feature_mask,
        device_config: device_config,
        host_visible_region: host_visible_region,
        capsets: capsets,
        venus_candidate: venus_candidate,
        complete: complete,
        vulkan_executed: false,
        device_readback: false,
        fallback_used: false
    )

pub fn virtio_gpu_feature_conjunction_ready(feature_mask: u32) -> bool:
    val required = VIRTIO_GPU_F_VIRGL | VIRTIO_GPU_F_RESOURCE_BLOB | VIRTIO_GPU_F_CONTEXT_INIT
    (feature_mask & required) == required

pub fn virtio_gpu_validate_pci_capability(
    cap: VirtioGpuPciCapability,
    bar_sizes: List<u64>
) -> Result<bool, text>:
    if cap.bar >= 6:
        return Err("reserved-bar")
    if (cap.bar as u64) >= (bar_sizes.len() as u64):
        return Err("bar-containment-unproven")
    var minimum_len: u8 = 16
    if cap.cfg_type == VIRTIO_PCI_CAP_SHARED_MEMORY_CFG:
        minimum_len = 24
    if cap.cap_len < minimum_len:
        return Err("cap-too-short")
    if cap.length == 0:
        return Err("zero-length-capability")
    val bar_size = bar_sizes[cap.bar as i64]
    if bar_size == 0 or cap.offset > bar_size:
        return Err("bar-containment-unproven")
    if cap.length > bar_size - cap.offset:
        return Err("bar-containment-unproven")
    Ok(true)

pub fn virtio_gpu_device_config_address(
    cap: VirtioGpuPciCapability,
    bar_bases: List<u64>,
    bar_sizes: List<u64>
) -> Result<u64, text>:
    if cap.cfg_type != VIRTIO_PCI_CAP_DEVICE_CFG:
        return Err("not-device-config")
    val valid = virtio_gpu_validate_pci_capability(cap, bar_sizes)
    if valid.is_err():
        return Err(valid.unwrap_err())
    if (cap.bar as u64) >= (bar_bases.len() as u64):
        return Err("bar-base-missing")
    val base = bar_bases[cap.bar as i64]
    if base == 0:
        return Err("bar-base-missing")
    val address = base + cap.offset
    if address < base:
        return Err("address-overflow")
    Ok(address)

pub fn virtio_gpu_map_shared_memory(
    cap: VirtioGpuPciCapability,
    bar_bases: List<u64>,
    bar_sizes: List<u64>
) -> Result<VirtioGpuSharedMemoryRegion, text>:
    if cap.cfg_type != VIRTIO_PCI_CAP_SHARED_MEMORY_CFG:
        return Err("not-shared-memory")
    val valid = virtio_gpu_validate_pci_capability(cap, bar_sizes)
    if valid.is_err():
        return Err(valid.unwrap_err())
    if (cap.bar as u64) >= (bar_bases.len() as u64):
        return Err("bar-base-missing")
    val base = bar_bases[cap.bar as i64]
    if base == 0:
        return Err("bar-base-missing")
    val address = base + cap.offset
    if address < base:
        return Err("address-overflow")
    Ok(VirtioGpuSharedMemoryRegion(
        shmid: cap.cap_id,
        bar: cap.bar,
        phys_base: address,
        byte_len: cap.length,
        source_offset: cap.source_offset,
        containment_proven: true
    ))

pub fn virtio_gpu_admit_device_config(
    samples: List<VirtioGpuDeviceConfigSample>
) -> Result<VirtioGpuDeviceConfig, text>:
    var attempts: u32 = 0
    for sample in samples:
        if attempts >= VIRTIO_GPU_CONFIG_GENERATION_RETRY_LIMIT:
            break
        attempts = attempts + 1
        if sample.generation_before == sample.generation_after:
            if sample.num_capsets > VIRTIO_GPU_CAPSET_COUNT_LIMIT:
                return Err("capset-count-over-limit")
            return Ok(VirtioGpuDeviceConfig(
                mapped_address: 0,
                events_read: sample.events_read,
                num_scanouts: sample.num_scanouts,
                num_capsets: sample.num_capsets,
                generation: sample.generation_after,
                attempts: attempts
            ))
    Err("config-generation-unstable")

fn _duplicate_source_offset(caps: List<VirtioGpuPciCapability>, index: u64) -> bool:
    val source = caps[index as i64].source_offset
    var i: u64 = 0
    while i < index:
        if caps[i as i64].source_offset == source:
            return true
        i = i + 1
    false

pub fn virtio_gpu_build_discovery_receipt(
    capabilities: List<VirtioGpuPciCapability>,
    bar_bases: List<u64>,
    bar_sizes: List<u64>,
    config_samples: List<VirtioGpuDeviceConfigSample>,
    feature_mask: u32,
    capsets: List<GpuCapset>
) -> VirtioGpuDiscoveryReceipt:
    val cap_count = capabilities.len() as u32
    if cap_count > VIRTIO_GPU_PCI_CAP_VISIT_LIMIT:
        return _discovery_receipt(VirtioGpuDiscoveryState.Rejected, "pci-cap-limit", cap_count, feature_mask, nil, nil, [], nil, false)

    var device_cfg_seen = false
    var device_cfg_address: u64 = 0
    var host_region: VirtioGpuSharedMemoryRegion? = nil
    var i: u64 = 0
    while i < (capabilities.len() as u64):
        val cap = capabilities[i as i64]
        if _duplicate_source_offset(capabilities, i):
            return _discovery_receipt(VirtioGpuDiscoveryState.Rejected, "pci-cap-loop", cap_count, feature_mask, nil, nil, [], nil, false)
        if cap.cfg_type == VIRTIO_PCI_CAP_DEVICE_CFG:
            if device_cfg_seen:
                return _discovery_receipt(VirtioGpuDiscoveryState.Rejected, "device-config-duplicate", cap_count, feature_mask, nil, nil, [], nil, false)
            val mapped = virtio_gpu_device_config_address(cap, bar_bases, bar_sizes)
            if mapped.is_err():
                return _discovery_receipt(VirtioGpuDiscoveryState.Rejected, mapped.unwrap_err(), cap_count, feature_mask, nil, nil, [], nil, false)
            device_cfg_address = mapped.unwrap()
            device_cfg_seen = true
        elif cap.cfg_type == VIRTIO_PCI_CAP_SHARED_MEMORY_CFG:
            val mapped = virtio_gpu_map_shared_memory(cap, bar_bases, bar_sizes)
            if mapped.is_err():
                return _discovery_receipt(VirtioGpuDiscoveryState.Rejected, mapped.unwrap_err(), cap_count, feature_mask, nil, nil, [], nil, false)
            val region = mapped.unwrap()
            if region.shmid == VIRTIO_GPU_SHM_ID_HOST_VISIBLE:
                if host_region.?:
                    return _discovery_receipt(VirtioGpuDiscoveryState.Rejected, "host-visible-region-duplicate", cap_count, feature_mask, nil, nil, [], nil, false)
                host_region = Some(region)
        i = i + 1

    if not device_cfg_seen or device_cfg_address == 0:
        return _discovery_receipt(VirtioGpuDiscoveryState.Unavailable, "device-config-missing", cap_count, feature_mask, nil, host_region, [], nil, false)

    val admitted_config = virtio_gpu_admit_device_config(config_samples)
    if admitted_config.is_err():
        return _discovery_receipt(VirtioGpuDiscoveryState.Rejected, admitted_config.unwrap_err(), cap_count, feature_mask, nil, host_region, [], nil, false)
    var config = admitted_config.unwrap()
    config.mapped_address = device_cfg_address

    if (capsets.len() as u64) > (config.num_capsets as u64):
        return _discovery_receipt(VirtioGpuDiscoveryState.Rejected, "capset-response-overrun", cap_count, feature_mask, Some(config), host_region, capsets, nil, false)
    if (capsets.len() as u64) < (config.num_capsets as u64):
        return _discovery_receipt(VirtioGpuDiscoveryState.Partial, "capset-query-partial", cap_count, feature_mask, Some(config), host_region, capsets, nil, false)

    var venus: GpuCapset? = nil
    for capset in capsets:
        if capset.id == VIRTIO_GPU_CAPSET_VENUS:
            if venus.?:
                return _discovery_receipt(VirtioGpuDiscoveryState.Rejected, "venus-candidate-duplicate", cap_count, feature_mask, Some(config), host_region, capsets, nil, false)
            venus = Some(capset)

    if not virtio_gpu_feature_conjunction_ready(feature_mask):
        return _discovery_receipt(VirtioGpuDiscoveryState.TransportReady, "venus-features-incomplete", cap_count, feature_mask, Some(config), host_region, capsets, venus, true)
    if not host_region.?:
        return _discovery_receipt(VirtioGpuDiscoveryState.Partial, "host-visible-region-missing", cap_count, feature_mask, Some(config), host_region, capsets, venus, false)
    if not venus.?:
        return _discovery_receipt(VirtioGpuDiscoveryState.TransportReady, "venus-candidate-missing", cap_count, feature_mask, Some(config), host_region, capsets, nil, true)
    if venus!.max_size == 0:
        return _discovery_receipt(VirtioGpuDiscoveryState.Partial, "venus-candidate-empty", cap_count, feature_mask, Some(config), host_region, capsets, venus, false)
    if venus!.max_size > VIRTIO_GPU_CAPSET_PAYLOAD_LIMIT:
        return _discovery_receipt(VirtioGpuDiscoveryState.Partial, "capset-payload-over-limit", cap_count, feature_mask, Some(config), host_region, capsets, venus, false)

    _discovery_receipt(VirtioGpuDiscoveryState.VenusDiscovered, "venus-candidate-unclassified", cap_count, feature_mask, Some(config), host_region, capsets, venus, true)

export VirtioGpuDiscoveryState, VirtioGpuPciCapability, VirtioGpuDiscoveryProvider
export VirtioGpuDeviceConfigSample, VirtioGpuDeviceConfig
export VirtioGpuSharedMemoryRegion, VirtioGpuDiscoveryReceipt
export VIRTIO_GPU_PCI_CAP_VISIT_LIMIT, VIRTIO_GPU_CAPSET_COUNT_LIMIT
export VIRTIO_GPU_CONFIG_GENERATION_RETRY_LIMIT, VIRTIO_GPU_CAPSET_PAYLOAD_LIMIT
export virtio_gpu_feature_conjunction_ready, virtio_gpu_validate_pci_capability
export virtio_gpu_device_config_address, virtio_gpu_map_shared_memory
export virtio_gpu_admit_device_config, virtio_gpu_build_discovery_receipt
