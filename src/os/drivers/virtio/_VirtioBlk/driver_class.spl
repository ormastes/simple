# VirtIO-blk MMIO register/status constants, request/DMA structs, and VirtioBlkDriver class.
use os.drivers.virtio.virtio_blk.*
# VirtIO Block Device Driver
#
# MDSOC: feature dimension, drivers layer
# Implements BlockDevice trait for VirtIO block devices in QEMU.
#
# VirtIO-blk uses a single virtqueue for read/write requests.
# Each request: header (type, sector) → data buffer → status byte.

use os.drivers.virtio.virtio_common.{Virtqueue}
use os.kernel.boot.mmio.{mmio_read8, mmio_read16, mmio_read32, mmio_write8, mmio_write16, mmio_write32, mmio_read64}
use os.kernel.boot.mmio_hardware.{mmio_shared_clean_range, mmio_shared_invalidate_range}
use os.services.block_device.{BlockDevice}
use std.io.dma.{SharedDmaBuffer, dma_shared_sync_cpu_to_device, dma_shared_sync_device_to_cpu}
use os.kernel.log.klog_api.{log_init, log_info, log_warn, log_error, log_raw, log_raw_println}

# VirtIO MMIO probe constants for QEMU virt ARM acceptance lanes.
val VIRTIO_MMIO_BASE: u64 = 0x0A000000
val VIRTIO_MMIO_STRIDE: u64 = 0x200
val VIRTIO_MMIO_SLOTS: u64 = 32
val VIRTIO_MAGIC: u32 = 0x74726976     # "virt" little-endian
val VIRTIO_DEV_BLK: u32 = 2
val VIRTIO_MMIO_VERSION: u64 = 0x004
val VIRTIO_MMIO_DEVICE_ID: u64 = 0x008
val VIRTIO_MMIO_DEVICE_FEATURES: u64 = 0x010
val VIRTIO_MMIO_DEVICE_FEATURES_SEL: u64 = 0x014
val VIRTIO_MMIO_DRIVER_FEATURES: u64 = 0x020
val VIRTIO_MMIO_DRIVER_FEATURES_SEL: u64 = 0x024
val VIRTIO_MMIO_GUEST_PAGE_SIZE: u64 = 0x028
val VIRTIO_MMIO_QUEUE_SEL: u64 = 0x030
val VIRTIO_MMIO_QUEUE_NUM_MAX: u64 = 0x034
val VIRTIO_MMIO_QUEUE_NUM: u64 = 0x038
val VIRTIO_MMIO_QUEUE_ALIGN: u64 = 0x03C
val VIRTIO_MMIO_QUEUE_PFN: u64 = 0x040
val VIRTIO_MMIO_QUEUE_READY: u64 = 0x044
val VIRTIO_MMIO_QUEUE_NOTIFY: u64 = 0x050
val VIRTIO_MMIO_STATUS: u64 = 0x070
val VIRTIO_MMIO_QUEUE_DESC_LOW: u64 = 0x080
val VIRTIO_MMIO_QUEUE_DESC_HIGH: u64 = 0x084
val VIRTIO_MMIO_QUEUE_AVAIL_LOW: u64 = 0x090
val VIRTIO_MMIO_QUEUE_AVAIL_HIGH: u64 = 0x094
val VIRTIO_MMIO_QUEUE_USED_LOW: u64 = 0x0A0
val VIRTIO_MMIO_QUEUE_USED_HIGH: u64 = 0x0A4
val VIRTIO_STATUS_ACKNOWLEDGE: u32 = 1
val VIRTIO_STATUS_DRIVER: u32 = 2
val VIRTIO_STATUS_DRIVER_OK: u32 = 4
val VIRTIO_STATUS_FEATURES_OK: u32 = 8
val VIRTIO_STATUS_FAILED: u32 = 128
val VIRTQUEUE_SIZE: i32 = 128
val VIRTQ_DESC_F_NEXT: u16 = 1
val VIRTQ_DESC_F_WRITE: u16 = 2

# VirtIO block request types
val VIRTIO_BLK_T_IN: u32 = 0           # Read
val VIRTIO_BLK_T_OUT: u32 = 1          # Write
val VIRTIO_BLK_T_FLUSH: u32 = 4        # Flush

# VirtIO block status
val VIRTIO_BLK_S_OK: u8 = 0
val VIRTIO_BLK_S_IOERR: u8 = 1
val VIRTIO_BLK_S_UNSUPP: u8 = 2

# VirtIO block config offsets (from device base + 0x100)
val VIRTIO_BLK_CFG_CAPACITY: u64 = 0x100  # Total sectors (u64)
val VIRTIO_BLK_CFG_SEG_MAX: u64 = 0x10C
val VIRTIO_BLK_CFG_BLK_SIZE: u64 = 0x114  # Sector size

@repr("C")
struct VirtioBlkReqHeader:
    """VirtIO block request header (16 bytes)."""
    type_: u32          # VIRTIO_BLK_T_*
    reserved: u32
    sector: u64         # Starting sector (LBA)

struct VirtioBlkDmaRegion:
    """Caller-owned contiguous DMA region for zero-copy requests."""
    virt_addr: u64      # CPU-visible base address
    phys_addr: u64      # Device-visible base address
    total_len: u64      # Total allocated bytes (header + payload + status)

# ============================================================================
# VirtIO Block Driver
# ============================================================================

# Poll iterations before declaring a completion timeout (~1 s at typical QEMU speeds)
val BLK_COMPLETION_TIMEOUT_POLLS: u32 = 1000000

# Fixed early-boot DMA scratch area on QEMU virt. ARM fs-exec runs before the
# kernel syscall/device-service path is available, so this driver must not
# import userlib syscall helpers into the freestanding kernel closure.
val VIRTIO_BLK_DMA_BASE: u64 = 0x51000000
val VIRTIO_BLK_DMA_LIMIT: u64 = 0x52000000
var g_virtio_blk_dma_next: u64 = VIRTIO_BLK_DMA_BASE
var g_virtio_blk_mmio_base: u64 = 0
var g_virtio_blk_queue_size: u32 = 0
var g_virtio_blk_free_head: u32 = 0
var g_virtio_blk_last_used_idx: u32 = 0
var g_virtio_blk_desc_addr: u64 = 0
var g_virtio_blk_avail_addr: u64 = 0
var g_virtio_blk_used_addr: u64 = 0
var g_virtio_blk_last_read_bytes: [u8] = []
var g_virtio_blk_request_busy: bool = false
var g_virtio_blk_queue_quarantined: bool = false
var g_virtio_blk_completed_write_epoch: u64 = 0
var g_virtio_blk_durable_write_epoch: u64 = 0

pub fn virtio_blk_set_active_mmio_base(base: u64):
    g_virtio_blk_mmio_base = base

pub fn virtio_blk_set_last_read_bytes(bytes: [u8]):
    g_virtio_blk_last_read_bytes = bytes

# rt_memcpy: bulk copy from DMA virtual address to output buffer (zero-copy fast path).
# Destination is the slice data pointer extracted from the [u8] fat-pointer header.
# On the Simple baremetal runtime the fat pointer layout is: [data_ptr: u64, len: u64],
# so unsafe_addr_of(slice) + 8 dereferences to the actual data base address.
extern fn rt_memcpy(dest: i64, src: i64, len: i64)
extern fn unsafe_addr_of(ref: any) -> u64
extern fn rt_memory_barrier()
extern fn serial_println(msg: text)
extern fn rt_virtq_desc_write(base: u64, index: u64, addr_lo: u64, addr_hi: u64, len: u64, flags: u64, next: u64) -> u64
use std.io.dma.{dma_raw_bytes_to_array}
extern fn rt_arm_virtio_blk_mmio_read_u32(off: u64) -> u32
extern fn rt_arm_virtio_blk_mmio_read_u64(off: u64) -> u64
extern fn rt_arm_virtio_blk_mmio_write_u32(off: u64, value: u32)
extern fn rt_arm_virtq_used_idx() -> u32
extern fn rt_arm_virtq_push_avail(desc_idx: u32)
extern fn rt_arm_virtio_blk_status_u8() -> u32
extern fn rt_arm_virtq_reset()
extern fn rt_arm_virtio_blk_prepare_read(lba: u64)
extern fn rt_arm_virtio_blk_read_sector_direct(lba: u64) -> u32
extern fn rt_arm_virtio_blk_queue_base() -> u64
extern fn rt_arm_virtio_blk_dma_base() -> u64
extern fn rt_arm_virtio_blk_sector_bytes() -> [u8]
extern fn rt_arm_virtio_blk_set_mmio_base(base: u64)
extern fn rt_arm_virtio_blk_configure_queue(version: u32)
extern fn rt_arm_virtio_blk_wait_completion(timeout_polls: u32) -> u32
extern fn rt_arm_virtio_blk_request_owner_load() -> i64
extern fn rt_arm_virtio_blk_request_owner_compare_exchange(expected: i64, desired: i64) -> bool
extern fn rt_arm_virtio_blk_request_owner_store(value: i64)

struct VirtioBlkDmaAlloc:
    virt_addr: u64
    phys_addr: u64

fn _align_up_u64(value: u64, align: u64) -> u64:
    ((value + align - 1) / align) * align

fn _virtio_blk_zero(addr: u64, size: u64):
    var off: u64 = 0
    while off < size:
        mmio_write32(addr + off, 0)
        off = off + 4

fn _virtio_blk_sync_for_device(addr: u64, size: u64):
    """Publish one driver-owned bounded range before device ownership."""
    if size == 0: return
    mmio_shared_clean_range(addr, size)

fn _virtio_blk_sync_for_cpu(addr: u64, size: u64):
    """Discard stale cache lines after device ownership returns."""
    if size == 0: return
    mmio_shared_invalidate_range(addr, size)

fn _virtio_blk_alloc_dma(size: u64) -> Result<VirtioBlkDmaAlloc, text>:
    if not g_virtio_blk_request_busy:
        return Err("virtio-blk DMA allocation requires request ownership")
    val alloc_size: u64 = 1024
    if size == 0 or size > alloc_size:
        return Err("virtio-blk DMA request exceeds bounded scratch slot")
    val addr: u64 = VIRTIO_BLK_DMA_BASE
    g_virtio_blk_dma_next = addr + alloc_size
    _virtio_blk_zero(addr: addr, size: alloc_size)
    Result.Ok(VirtioBlkDmaAlloc(
        virt_addr: addr,
        phys_addr: addr
    ))

fn _virtio_blk_alloc_dma_addr(size: u64) -> u64:
    val alloc_size: u64 = 1024
    var addr: u64 = rt_arm_virtio_blk_dma_base()
    if addr == 0:
        val fallback = _virtio_blk_alloc_dma(size)
        if fallback.is_err():
            return 0
        addr = fallback.unwrap().virt_addr
    _virtio_blk_zero(addr, alloc_size)
    addr


fn _virtio_blk_free_dma(_virt_addr: u64, _size: u64) -> Result<bool, text>:
    # Early boot allocations are arena-backed and live until QEMU exits.
    Result.Ok(true)

fn _virtio_blk_base() -> u64:
    if g_virtio_blk_mmio_base != 0:
        return g_virtio_blk_mmio_base
    VIRTIO_MMIO_BASE

fn _virtio_blk_reg_read32(off: u64) -> u32:
    rt_arm_virtio_blk_mmio_read_u32(off)

fn _virtio_blk_reg_read64(off: u64) -> u64:
    rt_arm_virtio_blk_mmio_read_u64(off)

fn _virtio_blk_reg_write32(off: u64, value: u32):
    rt_arm_virtio_blk_mmio_write_u32(off, value)

fn _virtq_desc_addr(idx: u32) -> u64:
    g_virtio_blk_desc_addr + (idx.to_u64() * 16)

fn _virtq_setup(base: u64):
    g_virtio_blk_queue_size = 128
    g_virtio_blk_free_head = 0
    g_virtio_blk_last_used_idx = 0
    g_virtio_blk_desc_addr = base
    g_virtio_blk_avail_addr = base + 2048
    g_virtio_blk_used_addr = base + 4096
    g_virtio_blk_request_busy = false
    g_virtio_blk_queue_quarantined = false
    rt_arm_virtio_blk_request_owner_store(0)
    g_virtio_blk_completed_write_epoch = 0
    g_virtio_blk_durable_write_epoch = 0
    _virtio_blk_zero(addr: base, size: 8192)

    var i: u32 = 0
    while i + 1 < 128:
        mmio_write16(g_virtio_blk_desc_addr + (i.to_u64() * 16) + 14, (i + 1).to_u16())
        i = i + 1
    mmio_write16(g_virtio_blk_desc_addr + (127 * 16).to_u64() + 14, 128)
    mmio_write16(g_virtio_blk_avail_addr, 0)
    mmio_write16(g_virtio_blk_avail_addr + 2, 0)
    mmio_write16(g_virtio_blk_used_addr, 0)
    mmio_write16(g_virtio_blk_used_addr + 2, 0)
    _virtio_blk_sync_for_device(base, 8192)

fn _virtq_alloc_desc() -> i32:
    if g_virtio_blk_queue_quarantined:
        return -1
    if g_virtio_blk_free_head >= 128:
        return -1
    val idx = g_virtio_blk_free_head
    g_virtio_blk_free_head = mmio_read16(_virtq_desc_addr(idx) + 14).to_u32()
    idx.to_i32()

fn _virtq_free_desc(idx: u32):
    mmio_write16(_virtq_desc_addr(idx) + 14, g_virtio_blk_free_head.to_u16())
    g_virtio_blk_free_head = idx

fn _virtq_release_partial(desc0: i32, desc1: i32, desc2: i32):
    # Reverse allocation order so the original freelist order is restored.
    if desc2 >= 0:
        _virtq_free_desc(desc2.to_u32())
    if desc1 >= 0:
        _virtq_free_desc(desc1.to_u32())
    if desc0 >= 0:
        _virtq_free_desc(desc0.to_u32())

fn _virtio_blk_request_begin() -> Result<bool, text>:
    val owner_state = rt_arm_virtio_blk_request_owner_load()
    val acquired = if owner_state == 0:
        rt_arm_virtio_blk_request_owner_compare_exchange(0, 1)
    else:
        false
    val transition = virtio_blk_request_owner_transition(owner_state, acquired)
    if transition.is_err():
        return Err(transition.unwrap_err())
    g_virtio_blk_request_busy = true
    Ok(true)

fn _virtio_blk_request_completed():
    g_virtio_blk_request_busy = false
    rt_arm_virtio_blk_request_owner_store(0)

fn _virtio_blk_request_indeterminate():
    # A timed-out descriptor chain remains device-owned. Quarantine the queue,
    # then reset the device and wait for the reset acknowledgement before this
    # scoped call can return caller-owned DMA. VirtIO guarantees that reset
    # acknowledgement ends device access. If it never acknowledges, panic
    # instead of returning an aliased buffer to the caller.
    g_virtio_blk_queue_quarantined = true
    g_virtio_blk_request_busy = true
    rt_arm_virtio_blk_request_owner_store(2)
    _virtio_blk_reg_write32(VIRTIO_MMIO_STATUS, VIRTIO_STATUS_FAILED)
    rt_memory_barrier()
    _virtio_blk_reg_write32(VIRTIO_MMIO_STATUS, 0)
    rt_memory_barrier()
    var reset_poll: u32 = 0
    while reset_poll < BLK_COMPLETION_TIMEOUT_POLLS:
        if virtio_blk_reset_acknowledged(_virtio_blk_reg_read32(VIRTIO_MMIO_STATUS)):
            return
        reset_poll = reset_poll + 1
    panic("virtio-blk reset was not acknowledged; DMA ownership cannot return")

pub fn virtio_blk_validate_completion(last_used_idx: u32, observed_used_idx: u32, expected_head: u32, observed_head: u32) -> Result<u32, text>:
    val expected_used_idx = (last_used_idx + 1) & 0xFFFF
    if observed_used_idx != expected_used_idx:
        return Err("virtio-blk stale, duplicate, or skipped used-ring completion")
    if observed_head != expected_head:
        return Err("virtio-blk completion returned an unexpected descriptor head")
    Ok(observed_used_idx)

pub fn virtio_blk_request_owner_transition(observed_state: i64, acquired: bool) -> Result<i64, text>:
    if observed_state == 2:
        return Err("virtio-blk queue quarantined after indeterminate completion")
    if observed_state != 0 or not acquired:
        return Err("virtio-blk queue already owns an in-flight request")
    Ok(1)

pub fn virtio_blk_reset_acknowledged(device_status: u32) -> bool:
    device_status == 0

pub fn virtio_blk_descriptor_tail(flags: u32, next_desc: u32) -> u32:
    # VirtqDesc stores flags in the low 16 bits and next in the high 16 bits.
    (next_desc << 16) | (flags & 0xFFFF)

pub fn virtio_blk_dma_transfer_len(capacity_sectors: u64, lba: u64, count: u32, sector_size: u32, buffer_len: u64) -> Result<u64, text>:
    val count_u64 = count.to_u64()
    val sector_u64 = sector_size.to_u64()
    if count == 0 or sector_size == 0:
        return Err("virtio-blk DMA transfer must contain sectors")
    if capacity_sectors != 0 and (lba >= capacity_sectors or count_u64 > capacity_sectors - lba):
        return Err("virtio-blk DMA transfer exceeds device capacity")
    val data_len = count_u64 * sector_u64
    if data_len > 0xFFFFFFFFu64:
        return Err("virtio-blk DMA transfer exceeds descriptor length")
    if buffer_len < data_len:
        return Err("virtio-blk DMA buffer is too small")
    Ok(data_len)

pub fn virtio_blk_next_write_epoch(completed_write_epoch: u64) -> Result<u64, text>:
    if completed_write_epoch == 0xFFFFFFFFFFFFFFFFu64:
        return Err("virtio-blk write epoch exhausted")
    Ok(completed_write_epoch + 1u64)

pub fn virtio_blk_flush_transition(completed_write_epoch: u64, durable_write_epoch: u64, target_write_epoch: u64, device_ok: bool) -> Result<u64, text>:
    if not device_ok:
        return Err("virtio-blk FLUSH did not complete successfully")
    if target_write_epoch > completed_write_epoch:
        return Err("virtio-blk FLUSH cannot publish an incomplete write")
    if target_write_epoch < durable_write_epoch:
        return Err("virtio-blk FLUSH cannot move durability backward")
    Ok(target_write_epoch)

fn _virtq_push_avail(desc_idx: u32):
    # Snapshot the used-ring cursor before publishing. The ARM raw reader
    # (C owner) advances the same shared ring without updating this module's
    # cursor; a stale cursor makes _virtq_wait_completion validate the slot
    # the raw path already consumed and every trait-path read times out.
    _virtio_blk_sync_for_cpu(g_virtio_blk_used_addr, 4)
    g_virtio_blk_last_used_idx = mmio_read16(g_virtio_blk_used_addr + 2).to_u32()
    # Descriptor rows are driver-owned until this publication boundary.
    _virtio_blk_sync_for_device(g_virtio_blk_desc_addr, 2048)
    val avail_idx = mmio_read16(g_virtio_blk_avail_addr + 2)
    val ring_slot = g_virtio_blk_avail_addr + 4 + ((avail_idx.to_u64() % 128) * 2)
    mmio_write16(ring_slot, desc_idx.to_u16())
    rt_memory_barrier()
    mmio_write16(g_virtio_blk_avail_addr + 2, avail_idx + 1)
    _virtio_blk_sync_for_device(g_virtio_blk_avail_addr, 512)
    rt_memory_barrier()

fn _virtq_wait_completion(expected_head: u32, timeout_polls: u32) -> bool:
    var i: u32 = 0
    while i < timeout_polls:
        # Poll only the used-ring header. Invalidate the one returned element
        # after its index advances; scanning the whole ring on every poll turns
        # a timeout into gigabytes of needless cache maintenance.
        _virtio_blk_sync_for_cpu(g_virtio_blk_used_addr, 4)
        val used_idx = mmio_read16(g_virtio_blk_used_addr + 2)
        if used_idx.to_u32() != g_virtio_blk_last_used_idx:
            val used_slot = g_virtio_blk_last_used_idx.to_u64() % g_virtio_blk_queue_size.to_u64()
            val used_elem_addr = g_virtio_blk_used_addr + 4 + used_slot * 8
            _virtio_blk_sync_for_cpu(used_elem_addr, 8)
            val used_head = mmio_read32(used_elem_addr)
            val transition = virtio_blk_validate_completion(
                g_virtio_blk_last_used_idx,
                used_idx.to_u32(),
                expected_head,
                used_head)
            if transition.is_err():
                return false
            g_virtio_blk_last_used_idx = transition.unwrap()
            return true
        i = i + 1
    false

fn _virtq_wait_completion_early(timeout_polls: u32) -> bool:
    var i: u32 = 0
    while i < timeout_polls:
        val used_idx = rt_arm_virtq_used_idx()
        if used_idx != g_virtio_blk_last_used_idx:
            g_virtio_blk_last_used_idx = used_idx
            return true
        i = i + 1
    false

fn _virtio_blk_wait_status(status_addr: u64, timeout_polls: u32) -> bool:
    var i: u32 = 0
    while i < timeout_polls:
        _virtio_blk_sync_for_cpu(status_addr, 1)
        if mmio_read8(status_addr).to_u32() != 1:
            return true
        i = i + 1
    false

fn virtio_blk_last_read_bytes() -> [u8]:
    g_virtio_blk_last_read_bytes

pub struct VirtioBlkArmInitResult:
    driver: VirtioBlkDriver
    ok: bool

pub fn virtio_blk_arm_init(driver_in: VirtioBlkDriver) -> VirtioBlkArmInitResult:
    var driver = driver_in
    val magic = _virtio_blk_reg_read32(0)
    serial_println("[virtio-arm-init] magic={magic}")
    if magic == 0:
        serial_println("[virtio-arm-init] fail stage=magic_zero")
        return VirtioBlkArmInitResult(driver: driver, ok: false)

    val version = _virtio_blk_reg_read32(4)
    serial_println("[virtio-arm-init] version={version}")
    if version == 0:
        serial_println("[virtio-arm-init] fail stage=version_zero")
        return VirtioBlkArmInitResult(driver: driver, ok: false)

    val device_id = _virtio_blk_reg_read32(8)
    serial_println("[virtio-arm-init] device_id={device_id}")
    if device_id != 2:
        serial_println("[virtio-arm-init] fail stage=device_id")
        return VirtioBlkArmInitResult(driver: driver, ok: false)

    _virtio_blk_reg_write32(112, 0)
    _virtio_blk_reg_write32(112, 1)
    _virtio_blk_reg_write32(112, 3)

    _virtio_blk_reg_write32(20, 0)
    val features = _virtio_blk_reg_read32(16)
    _virtio_blk_reg_write32(36, 0)
    val negotiated = features & (1u32 << 9)
    _virtio_blk_reg_write32(32, negotiated)
    driver.flush_supported = negotiated != 0
    if version != 1:
        _virtio_blk_reg_write32(20, 1)
        val _features_hi = _virtio_blk_reg_read32(16)
        _virtio_blk_reg_write32(36, 1)
        _virtio_blk_reg_write32(32, 1)

    _virtio_blk_reg_write32(112, 11)
    val status = _virtio_blk_reg_read32(112)
    serial_println("[virtio-arm-init] status={status}")
    if (status & 8) == 0:
        _virtio_blk_reg_write32(112, 128)
        serial_println("[virtio-arm-init] fail stage=features_ok")
        return VirtioBlkArmInitResult(driver: driver, ok: false)

    _virtio_blk_reg_write32(48, 0)
    val max_queue = _virtio_blk_reg_read32(52)
    serial_println("[virtio-arm-init] max_queue={max_queue}")
    if max_queue == 0:
        serial_println("[virtio-arm-init] fail stage=max_queue")
        return VirtioBlkArmInitResult(driver: driver, ok: false)
    val queue_size: u32 = 128
    _virtio_blk_reg_write32(56, queue_size)

    val queue_base: u64 = rt_arm_virtio_blk_queue_base()
    _virtq_setup(queue_base)
    rt_arm_virtio_blk_configure_queue(version)
    _virtio_blk_reg_write32(112, 15)
    serial_println("[virtio-arm-init] queue_ready")

    driver.capacity_sectors = _virtio_blk_reg_read64(256)
    val blk_size = _virtio_blk_reg_read32(276)
    if blk_size > 0:
        driver.sector_size = blk_size

    driver.initialized = true
    driver.notif_id = 0
    serial_println("[virtio-arm-init] ok sector_size={driver.sector_size} capacity={driver.capacity_sectors}")
    VirtioBlkArmInitResult(driver: driver, ok: true)

pub fn virtio_blk_arm_read_sector(driver: VirtioBlkDriver, lba: u64, buffer: [u8]) -> Result<bool, text>:
    driver.read_sectors(lba, 1, buffer)

pub fn virtio_blk_arm_read_sector_bytes(driver: VirtioBlkDriver, lba: u64) -> [u8]:
    val result = driver.read_sector(lba)
    if result.is_err():
        return []
    result.unwrap()

class VirtioBlkDriver:
    """VirtIO block device driver.

    Provides sector-level read/write on a virtual disk.
    Used by FAT32 and other filesystem drivers.
    """
    base_addr: u64
    capacity_sectors: u64
    sector_size: u32
    initialized: bool
    flush_supported: bool
    notif_id: u64       # IRQ notification ID for interrupt-driven completion
