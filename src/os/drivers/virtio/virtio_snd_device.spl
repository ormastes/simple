# codex-impl
# Pure-Simple VirtIO sound queue and lifecycle owner.

use os.drivers.virtio.virtio_snd_protocol.{VirtioSndPcmRequest, virtio_snd_negotiate, virtio_snd_validate_pcm, virtio_snd_stream_transition, virtio_snd_completion, virtio_snd_decode_event}
use common.io.simple_device_event.{SimpleDeviceEventRing}

struct VirtioSndDeviceReceipt:
    status: text
    reason: text
    stream_id: i64
    generation: u64
    sequence: u64
    outstanding: i64

class VirtioSndDevice:
    negotiated: bool
    playback_available: bool
    capture_available: bool
    state: text
    stream_id: i64
    generation: u64
    next_sequence: u64
    max_outstanding: i64
    outstanding: i64
    submitted_periods: i64
    completed_periods: i64
    xrun_count: i64
    events: SimpleDeviceEventRing

impl VirtioSndDevice:
    static fn create(event_capacity: i64, max_outstanding: i64) -> VirtioSndDevice:
        var bounded = max_outstanding
        if bounded < 2:
            bounded = 2
        if bounded > 64:
            bounded = 64
        VirtioSndDevice(negotiated: false, playback_available: false, capture_available: false, state: "closed", stream_id: -1, generation: 1u64, next_sequence: 1u64, max_outstanding: bounded, outstanding: 0, submitted_periods: 0, completed_periods: 0, xrun_count: 0, events: SimpleDeviceEventRing.create(event_capacity))

    me negotiate(device_features: u64, playback_streams: i64, capture_streams: i64) -> VirtioSndDeviceReceipt:
        val result = virtio_snd_negotiate(device_features, playback_streams, capture_streams)
        if result.status != "accepted":
            return VirtioSndDeviceReceipt(status: result.status, reason: result.reason, stream_id: -1, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)
        self.negotiated = true
        self.playback_available = result.playback
        self.capture_available = result.capture
        VirtioSndDeviceReceipt(status: "accepted", reason: result.reason, stream_id: -1, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)

    me prepare(request: VirtioSndPcmRequest) -> VirtioSndDeviceReceipt:
        if not self.negotiated:
            return VirtioSndDeviceReceipt(status: "not-negotiated", reason: "device capabilities are unavailable", stream_id: request.stream_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)
        if request.direction == "playback" and not self.playback_available:
            return VirtioSndDeviceReceipt(status: "unsupported", reason: "playback stream unavailable", stream_id: request.stream_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)
        if request.direction == "capture" and not self.capture_available:
            return VirtioSndDeviceReceipt(status: "unsupported", reason: "capture stream unavailable", stream_id: request.stream_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)
        val validation = virtio_snd_validate_pcm(request)
        if validation.status != "accepted":
            return VirtioSndDeviceReceipt(status: validation.status, reason: validation.reason, stream_id: request.stream_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)
        val transition = virtio_snd_stream_transition(self.state, "prepare", self.generation)
        if transition.status != "accepted":
            return VirtioSndDeviceReceipt(status: transition.status, reason: transition.reason, stream_id: request.stream_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)
        self.state = transition.next_state
        self.generation = transition.generation
        self.stream_id = request.stream_id
        VirtioSndDeviceReceipt(status: "prepared", reason: validation.reason, stream_id: self.stream_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)

    me start() -> VirtioSndDeviceReceipt:
        val transition = virtio_snd_stream_transition(self.state, "start", self.generation)
        if transition.status == "accepted":
            self.state = transition.next_state
        VirtioSndDeviceReceipt(status: transition.status, reason: transition.reason, stream_id: self.stream_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)

    me submit(direction: text) -> VirtioSndDeviceReceipt:
        if self.state != "running":
            return VirtioSndDeviceReceipt(status: "invalid-state", reason: "stream is not running", stream_id: self.stream_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)
        if self.outstanding >= self.max_outstanding:
            self.xrun_count = self.xrun_count + 1
            self.events.publish(0u64, self.completed_periods as u64, self.stream_id, self.stream_id, self.next_sequence, "audio-xrun", "queue-full")
            return VirtioSndDeviceReceipt(status: "queue-full", reason: "bounded virtqueue is full", stream_id: self.stream_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)
        if direction != "playback" and direction != "capture":
            return VirtioSndDeviceReceipt(status: "invalid-direction", reason: "direction must be playback or capture", stream_id: self.stream_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)
        val sequence = self.next_sequence
        self.next_sequence = self.next_sequence + 1u64
        self.outstanding = self.outstanding + 1
        self.submitted_periods = self.submitted_periods + 1
        VirtioSndDeviceReceipt(status: "submitted", reason: direction, stream_id: self.stream_id, generation: self.generation, sequence: sequence, outstanding: self.outstanding)

    me complete(sequence: u64, completion_generation: u64, frames: i64, direction: text, monotonic_ns: u64) -> VirtioSndDeviceReceipt:
        val completion = virtio_snd_completion(sequence, self.stream_id, self.generation, completion_generation, frames, direction)
        if completion.status != "completed":
            return VirtioSndDeviceReceipt(status: completion.status, reason: completion.kind, stream_id: self.stream_id, generation: completion_generation, sequence: sequence, outstanding: self.outstanding)
        if self.outstanding <= 0:
            return VirtioSndDeviceReceipt(status: "unexpected-completion", reason: "no submitted period owns this completion", stream_id: self.stream_id, generation: self.generation, sequence: sequence, outstanding: self.outstanding)
        self.outstanding = self.outstanding - 1
        self.completed_periods = self.completed_periods + 1
        self.events.publish(monotonic_ns, self.completed_periods as u64, self.stream_id, self.stream_id, sequence, completion.kind, "completed")
        VirtioSndDeviceReceipt(status: "completed", reason: completion.kind, stream_id: self.stream_id, generation: self.generation, sequence: sequence, outstanding: self.outstanding)

    me handle_hardware_event(code: u32, data: u32, monotonic_ns: u64) -> VirtioSndDeviceReceipt:
        val event = virtio_snd_decode_event(code, data)
        if event.status == "unsupported":
            return VirtioSndDeviceReceipt(status: "unsupported", reason: event.kind, stream_id: event.target_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)
        if event.kind == "audio-period-elapsed" or event.kind == "audio-xrun":
            if event.target_id != self.stream_id:
                return VirtioSndDeviceReceipt(status: "stale-stream", reason: event.kind, stream_id: event.target_id, generation: self.generation, sequence: 0u64, outstanding: self.outstanding)
        if event.kind == "audio-xrun":
            self.xrun_count = self.xrun_count + 1
        val correlation = self.next_sequence
        val published = self.events.publish(monotonic_ns, self.completed_periods.to_u64(), event.target_id, event.target_id, correlation, event.kind, event.status)
        VirtioSndDeviceReceipt(status: published, reason: event.kind, stream_id: event.target_id, generation: self.generation, sequence: correlation, outstanding: self.outstanding)

    me reset(monotonic_ns: u64) -> VirtioSndDeviceReceipt:
        self.generation = self.generation + 1u64
        self.state = "lost"
        self.outstanding = 0
        self.events.publish(monotonic_ns, self.completed_periods as u64, self.stream_id, self.stream_id, self.next_sequence, "device-reset", "disconnected")
        VirtioSndDeviceReceipt(status: "disconnected", reason: "device generation invalidated", stream_id: self.stream_id, generation: self.generation, sequence: self.next_sequence, outstanding: 0)

    me shutdown(monotonic_ns: u64) -> VirtioSndDeviceReceipt:
        val cancelled = self.outstanding
        self.outstanding = 0
        self.state = "closed"
        self.negotiated = false
        self.generation = self.generation + 1u64
        self.events.shutdown(monotonic_ns, self.stream_id)
        VirtioSndDeviceReceipt(status: "completed", reason: "shutdown cancelled=" + cancelled.to_text(), stream_id: self.stream_id, generation: self.generation, sequence: self.next_sequence, outstanding: 0)
