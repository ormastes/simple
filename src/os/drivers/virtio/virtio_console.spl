# VirtIO Console / Serial Multiport Driver Core for Host-GPU Transport
#
# Owns VirtIO-console control events (VirtIO 1.x section 5.3.6.2), dynamic
# named-port queue binding atop VirtioConsoleQueueOwner (x86_64 PCI & RISC-V
# MMIO), incremental SHGF framed byte-stream reassembly/serialization, and
# fail-closed single-in-flight request/response correlation.

use os.drivers.virtio.virtio_console_queue_owner.{
    VIRTIO_CONSOLE_CONTROL_RX_SLOT,
    VIRTIO_CONSOLE_CONTROL_TX_SLOT,
    VIRTIO_CONSOLE_DATA_RX_SLOT,
    VIRTIO_CONSOLE_DATA_TX_SLOT,
    VIRTIO_CONSOLE_MAX_FRAME_BYTES,
    VirtioConsoleIrqReceipt,
    VirtioConsoleQueueLease,
    VirtioConsoleQueueOwner,
    VirtioConsoleQueueSelection
}
use common.gpu.simpleos_host_gpu_protocol.{simpleos_host_gpu_max_readback_bytes}
use common.gpu.simpleos_host_gpu_stream_protocol.{
    SIMPLEOS_HOST_GPU_STREAM_HEADER_BYTES,
    SIMPLEOS_HOST_GPU_STREAM_HELLO_REQUEST,
    SIMPLEOS_HOST_GPU_STREAM_HELLO_RESPONSE,
    SIMPLEOS_HOST_GPU_STREAM_SUBMIT_REQUEST,
    SIMPLEOS_HOST_GPU_STREAM_SUBMIT_RESPONSE,
    SIMPLEOS_HOST_GPU_STREAM_ERROR_RESPONSE,
    SimpleOsHostGpuStreamHeader,
    SimpleOsHostGpuStreamHeaderDecode,
    simpleos_host_gpu_stream_checksum_step,
    simpleos_host_gpu_stream_checksum_valid,
    simpleos_host_gpu_stream_header_decode,
    simpleos_host_gpu_stream_header_encode,
    simpleos_host_gpu_stream_response_correlates
}

val VIRTIO_CONSOLE_DEVICE_ID: u16 = 0x1003u16
val VIRTIO_CONSOLE_MODERN_DEVICE_ID: u16 = 0x1043u16
val VIRTIO_CONSOLE_MMIO_DEVICE_ID: u32 = 3u32
val VIRTIO_CONSOLE_F_MULTIPORT: u64 = 2u64

val VIRTIO_CONSOLE_DEVICE_READY: u16 = 0u16
val VIRTIO_CONSOLE_DEVICE_ADD: u16 = 1u16
val VIRTIO_CONSOLE_DEVICE_REMOVE: u16 = 2u16
val VIRTIO_CONSOLE_PORT_READY: u16 = 3u16
val VIRTIO_CONSOLE_CONSOLE_PORT: u16 = 4u16
val VIRTIO_CONSOLE_RESIZE: u16 = 5u16
val VIRTIO_CONSOLE_PORT_OPEN: u16 = 6u16
val VIRTIO_CONSOLE_PORT_NAME: u16 = 7u16

val VIRTIO_CONSOLE_CONTROL_HDR_BYTES: i64 = 8
val VIRTIO_CONSOLE_CONTROL_MAX_PAYLOAD: i64 = 256
val SIMPLEOS_HOST_GPU_PORT_NAME: text = "org.simple.hostgpu"

struct VirtioConsoleControlMessage:
    id: u32
    event: u16
    value: u16
    payload: [u8]

struct VirtioConsoleRxResult:
    complete: bool
    rejected: bool
    reason: text
    header: SimpleOsHostGpuStreamHeader?
    body: [u8]
    body_checksum: i64

fn _vc_push_le16(out: [u8], val16: u16) -> [u8]:
    var bytes = out
    val v = val16.to_u32()
    bytes.push((v & 0xFFu32).to_u8())
    bytes.push(((v >> 8u32) & 0xFFu32).to_u8())
    bytes

fn _vc_push_le32(out: [u8], val32: u32) -> [u8]:
    var bytes = out
    bytes.push((val32 & 0xFFu32).to_u8())
    bytes.push(((val32 >> 8u32) & 0xFFu32).to_u8())
    bytes.push(((val32 >> 16u32) & 0xFFu32).to_u8())
    bytes.push(((val32 >> 24u32) & 0xFFu32).to_u8())
    bytes

fn _vc_read_le16(bytes: [u8], offset: i64) -> u16:
    val b0 = bytes[offset].to_u32() & 0xFFu32
    val b1 = bytes[offset + 1].to_u32() & 0xFFu32
    (b0 | (b1 << 8u32)).to_u16()

fn _vc_read_le32(bytes: [u8], offset: i64) -> u32:
    val b0 = bytes[offset].to_u32() & 0xFFu32
    val b1 = bytes[offset + 1].to_u32() & 0xFFu32
    val b2 = bytes[offset + 2].to_u32() & 0xFFu32
    val b3 = bytes[offset + 3].to_u32() & 0xFFu32
    b0 | (b1 << 8u32) | (b2 << 16u32) | (b3 << 24u32)

fn _vc_bytes_equal_ascii(payload: [u8], expected: text) -> bool:
    # Trim optional trailing NUL byte emitted by QEMU virtserialport PORT_NAME.
    var len = payload.len().to_i64()
    while len > 0 and payload[len - 1] == 0u8:
        len = len - 1
    if len != expected.byte_len():
        return false
    var i: i64 = 0
    while i < len:
        if (payload[i].to_i64() & 0xFF) != (expected.byte_at(i).to_i64() & 0xFF):
            return false
        i = i + 1
    true

fn _vc_checksum_bytes(bytes: [u8]) -> i64:
    var sum: i64 = 0
    var i: i64 = 0
    while i < bytes.len():
        sum = simpleos_host_gpu_stream_checksum_step(sum, bytes[i])
        if sum < 0:
            return -1
        i = i + 1
    sum

fn virtio_console_control_event_valid(event: u16) -> bool:
    event <= VIRTIO_CONSOLE_PORT_NAME

fn virtio_console_control_encode(id: u32, event: u16, value: u16, payload: [u8]) -> [u8]:
    if not virtio_console_control_event_valid(event) or payload.len() > VIRTIO_CONSOLE_CONTROL_MAX_PAYLOAD:
        return []
    var out: [u8] = []
    out = _vc_push_le32(out, id)
    out = _vc_push_le16(out, event)
    out = _vc_push_le16(out, value)
    var i = 0
    while i < payload.len():
        out.push(payload[i])
        i = i + 1
    out

fn virtio_console_control_decode(bytes: [u8]) -> Result<VirtioConsoleControlMessage, text>:
    if bytes.len() < VIRTIO_CONSOLE_CONTROL_HDR_BYTES:
        return Err("control-short")
    if bytes.len() > VIRTIO_CONSOLE_CONTROL_HDR_BYTES + VIRTIO_CONSOLE_CONTROL_MAX_PAYLOAD:
        return Err("control-oversize")
    val id = _vc_read_le32(bytes, 0)
    val event = _vc_read_le16(bytes, 4)
    val value = _vc_read_le16(bytes, 6)
    if not virtio_console_control_event_valid(event):
        return Err("control-unknown-event")
    var payload: [u8] = []
    var i = VIRTIO_CONSOLE_CONTROL_HDR_BYTES
    while i < bytes.len():
        payload.push(bytes[i])
        i = i + 1
    Ok(VirtioConsoleControlMessage(id: id, event: event, value: value, payload: payload))

fn virtio_console_stream_checksum(bytes: [u8]) -> i64:
    _vc_checksum_bytes(bytes)

class VirtioSerialHostGpuPort:
    """Single-owner VirtIO-serial port driver for framed SimpleOS host-GPU RPC.

    Owns multi-queue negotiation via VirtioConsoleQueueOwner, dynamic named-port
    handshake for `org.simple.hostgpu`, incremental byte-stream RX reassembly
    (supporting split descriptors and coalesced frames), incremental body
    checksum validation, monotonic request deadlines, and fail-closed reset.
    """
    queue_owner: VirtioConsoleQueueOwner
    transport_kind: text
    device_ready_sent: bool
    port_discovered: bool
    port_named: bool
    port_ready_sent: bool
    host_open: bool
    port_name: text
    last_error: text
    pending_header: SimpleOsHostGpuStreamHeader?
    pending_deadline_us: i64
    rx_header_buf: [u8]
    rx_active_header: SimpleOsHostGpuStreamHeader?
    rx_body_buf: [u8]
    rx_body_checksum: i64
    rx_carry: [u8]

    static fn create_x86_pci(owner_id: u64, capacity: i64, port_id: u32, irq_vector: u32) -> VirtioSerialHostGpuPort:
        var owner = VirtioConsoleQueueOwner.create(owner_id, capacity)
        val status = owner.bind_x86_pci(port_id, irq_vector)
        VirtioSerialHostGpuPort(
            queue_owner: owner,
            transport_kind: "x86-pci",
            device_ready_sent: false,
            port_discovered: false,
            port_named: false,
            port_ready_sent: false,
            host_open: false,
            port_name: "",
            last_error: if status == "ready": "" else: status,
            pending_header: None,
            pending_deadline_us: 0,
            rx_header_buf: [],
            rx_active_header: None,
            rx_body_buf: [],
            rx_body_checksum: 0,
            rx_carry: []
        )

    static fn create_riscv_mmio(owner_id: u64, capacity: i64, port_id: u32, plic_irq: u32) -> VirtioSerialHostGpuPort:
        var owner = VirtioConsoleQueueOwner.create(owner_id, capacity)
        val status = owner.bind_riscv_mmio(port_id, plic_irq)
        VirtioSerialHostGpuPort(
            queue_owner: owner,
            transport_kind: "riscv-mmio",
            device_ready_sent: false,
            port_discovered: false,
            port_named: false,
            port_ready_sent: false,
            host_open: false,
            port_name: "",
            last_error: if status == "ready": "" else: status,
            pending_header: None,
            pending_deadline_us: 0,
            rx_header_buf: [],
            rx_active_header: None,
            rx_body_buf: [],
            rx_body_checksum: 0,
            rx_carry: []
        )

    fn is_configured() -> bool:
        self.queue_owner.configured

    fn is_open() -> bool:
        (self.queue_owner.configured and self.device_ready_sent and
            self.port_discovered and self.port_named and self.port_ready_sent and
            self.host_open and self.port_name == SIMPLEOS_HOST_GPU_PORT_NAME)

    fn transport_classifier() -> text:
        if self.is_open():
            "virtio-serial-framed"
        else:
            "virtio-serial-unimplemented"

    fn data_rx_queue_id() -> u16:
        self.queue_owner.queue_id(VIRTIO_CONSOLE_DATA_RX_SLOT)

    fn data_tx_queue_id() -> u16:
        self.queue_owner.queue_id(VIRTIO_CONSOLE_DATA_TX_SLOT)

    fn control_rx_queue_id() -> u16:
        self.queue_owner.queue_id(VIRTIO_CONSOLE_CONTROL_RX_SLOT)

    fn control_tx_queue_id() -> u16:
        self.queue_owner.queue_id(VIRTIO_CONSOLE_CONTROL_TX_SLOT)

    me acquire_data_rx(descriptor_id: i64, byte_count: i64) -> VirtioConsoleQueueLease:
        self.queue_owner.acquire(VIRTIO_CONSOLE_DATA_RX_SLOT, descriptor_id, byte_count)

    me acquire_data_tx(descriptor_id: i64, byte_count: i64) -> VirtioConsoleQueueLease:
        self.queue_owner.acquire(VIRTIO_CONSOLE_DATA_TX_SLOT, descriptor_id, byte_count)

    me acquire_control_rx(descriptor_id: i64, byte_count: i64) -> VirtioConsoleQueueLease:
        self.queue_owner.acquire(VIRTIO_CONSOLE_CONTROL_RX_SLOT, descriptor_id, byte_count)

    me acquire_control_tx(descriptor_id: i64, byte_count: i64) -> VirtioConsoleQueueLease:
        self.queue_owner.acquire(VIRTIO_CONSOLE_CONTROL_TX_SLOT, descriptor_id, byte_count)

    me complete_lease(lease: VirtioConsoleQueueLease) -> text:
        self.queue_owner.complete(lease)

    me record_irq(device_status: u32, used_queue_mask: u32) -> VirtioConsoleIrqReceipt:
        self.queue_owner.record_irq(device_status, used_queue_mask)

    me take_ready() -> VirtioConsoleQueueSelection:
        self.queue_owner.take_ready()

    me begin_control_handshake() -> Result<[u8], text>:
        if not self.queue_owner.configured:
            return Err("not-bound")
        self.device_ready_sent = true
        Ok(virtio_console_control_encode(0u32, VIRTIO_CONSOLE_DEVICE_READY, 1u16, []))

    me emit_port_ready() -> Result<[u8], text>:
        if not self.queue_owner.configured or not self.device_ready_sent:
            return Err("device-not-ready")
        if not self.port_discovered or not self.port_named:
            return Err("port-not-ready")
        self.port_ready_sent = true
        Ok(virtio_console_control_encode(self.queue_owner.port_id, VIRTIO_CONSOLE_PORT_READY, 1u16, []))

    me handle_control_bytes(bytes: [u8]) -> Result<u16, text>:
        if not self.queue_owner.configured:
            return Err("not-bound")
        val decoded = virtio_console_control_decode(bytes)
        if val Err(reason) = decoded:
            val _ = self.fail_closed_reset(reason, true)
            return Err(reason)
        val msg = decoded.unwrap()
        if msg.event == VIRTIO_CONSOLE_DEVICE_ADD:
            if msg.id == self.queue_owner.port_id:
                self.port_discovered = true
                return Ok(msg.event)
            return Ok(msg.event)
        if msg.event == VIRTIO_CONSOLE_DEVICE_REMOVE:
            if msg.id == self.queue_owner.port_id:
                self.port_discovered = false
                self.port_named = false
                self.port_ready_sent = false
                self.host_open = false
                self.port_name = ""
                val _ = self.fail_closed_reset("device-remove", true)
            return Ok(msg.event)
        if msg.event == VIRTIO_CONSOLE_PORT_NAME:
            if msg.id == self.queue_owner.port_id:
                if _vc_bytes_equal_ascii(msg.payload, SIMPLEOS_HOST_GPU_PORT_NAME):
                    self.port_name = SIMPLEOS_HOST_GPU_PORT_NAME
                    self.port_named = true
                else:
                    self.port_named = false
                    self.port_name = ""
            return Ok(msg.event)
        if msg.event == VIRTIO_CONSOLE_PORT_OPEN:
            if msg.id == self.queue_owner.port_id:
                if msg.value == 1u16:
                    if not self.port_discovered or not self.port_named or not self.port_ready_sent:
                        val _ = self.fail_closed_reset("port-open-before-ready", true)
                        return Err("port-open-before-ready")
                    self.host_open = true
                elif msg.value == 0u16:
                    self.host_open = false
                    val _ = self.fail_closed_reset("port-closed", true)
                else:
                    val _ = self.fail_closed_reset("invalid-port-open-value", true)
                    return Err("invalid-port-open-value")
            return Ok(msg.event)
        Ok(msg.event)

    me _clear_stream_state():
        self.pending_header = None
        self.pending_deadline_us = 0
        self.rx_header_buf = []
        self.rx_active_header = None
        self.rx_body_buf = []
        self.rx_body_checksum = 0
        self.rx_carry = []

    me fail_closed_reset(reason: text, device_quiesced: bool) -> text:
        self.last_error = reason
        self.host_open = false
        self._clear_stream_state()
        self.queue_owner.reset(device_quiesced)

    me expire_pending_if_past(now_us: i64) -> bool:
        if val Some(_) = self.pending_header:
            if now_us <= 0 or now_us > self.pending_deadline_us:
                val _ = self.fail_closed_reset("deadline-expired", true)
                return true
        false

    me build_stream_request_frame(req: SimpleOsHostGpuStreamHeader, body: [u8], now_us: i64, deadline_us: i64) -> Result<[u8], text>:
        if not self.is_open():
            return Err("port-not-open")
        if self.pending_header.?:
            return Err("request-in-flight")
        if now_us <= 0 or deadline_us <= now_us:
            return Err("invalid-deadline")
        if req.message_type != SIMPLEOS_HOST_GPU_STREAM_HELLO_REQUEST and req.message_type != SIMPLEOS_HOST_GPU_STREAM_SUBMIT_REQUEST:
            return Err("invalid-request-type")
        if body.len().to_i64() != req.body_bytes:
            return Err("body-length-mismatch")
        val sum = _vc_checksum_bytes(body)
        if not simpleos_host_gpu_stream_checksum_valid(sum, req.body_checksum):
            return Err("request-checksum-mismatch")
        val encoded = simpleos_host_gpu_stream_header_encode(req)
        if encoded.len() != SIMPLEOS_HOST_GPU_STREAM_HEADER_BYTES:
            return Err("invalid-request-header")
        var frame: [u8] = encoded
        var i = 0
        while i < body.len():
            frame.push(body[i])
            i = i + 1
        self.pending_header = Some(req)
        self.pending_deadline_us = deadline_us
        Ok(frame)

    me _reject_rx(reason: text) -> VirtioConsoleRxResult:
        val _ = self.fail_closed_reset(reason, true)
        VirtioConsoleRxResult(complete: false, rejected: true, reason: reason, header: None, body: [], body_checksum: -1)

    me _consume_stream_byte(b: u8, now_us: i64) -> VirtioConsoleRxResult?:
        if not self.rx_active_header.?:
            self.rx_header_buf.push(b)
            if self.rx_header_buf.len() < SIMPLEOS_HOST_GPU_STREAM_HEADER_BYTES:
                return None
            val decoded = simpleos_host_gpu_stream_header_decode(self.rx_header_buf)
            if not decoded.ok:
                return Some(self._reject_rx("header-" + decoded.reason))
            val hdr = decoded.header
            if val Some(req) = self.pending_header:
                if now_us <= 0 or now_us > self.pending_deadline_us:
                    return Some(self._reject_rx("deadline-expired"))
                if not simpleos_host_gpu_stream_response_correlates(req, hdr):
                    return Some(self._reject_rx("correlation-mismatch"))
            else:
                return Some(self._reject_rx("unsolicited-response"))
            self.rx_active_header = Some(hdr)
            self.rx_body_buf = []
            self.rx_body_checksum = 0
            if hdr.body_bytes == 0:
                if not simpleos_host_gpu_stream_checksum_valid(0, hdr.body_checksum):
                    return Some(self._reject_rx("body-checksum-mismatch"))
                self.pending_header = None
                self.pending_deadline_us = 0
                self.rx_header_buf = []
                self.rx_active_header = None
                return Some(VirtioConsoleRxResult(complete: true, rejected: false, reason: "ok", header: Some(hdr), body: [], body_checksum: 0))
            return None

        val hdr = self.rx_active_header.unwrap()
        self.rx_body_buf.push(b)
        self.rx_body_checksum = simpleos_host_gpu_stream_checksum_step(self.rx_body_checksum, b)
        if self.rx_body_checksum < 0:
            return Some(self._reject_rx("checksum-overflow"))
        if self.rx_body_buf.len() < hdr.body_bytes:
            return None
        if not simpleos_host_gpu_stream_checksum_valid(self.rx_body_checksum, hdr.body_checksum):
            return Some(self._reject_rx("body-checksum-mismatch"))
        val completed_body = self.rx_body_buf
        val completed_sum = self.rx_body_checksum
        self.pending_header = None
        self.pending_deadline_us = 0
        self.rx_header_buf = []
        self.rx_active_header = None
        self.rx_body_buf = []
        self.rx_body_checksum = 0
        Some(VirtioConsoleRxResult(complete: true, rejected: false, reason: "ok", header: Some(hdr), body: completed_body, body_checksum: completed_sum))

    me push_rx_bytes(chunk: [u8], now_us: i64) -> VirtioConsoleRxResult:
        if not self.is_open():
            return self._reject_rx("port-not-open")
        val max_chunk = simpleos_host_gpu_max_readback_bytes() + SIMPLEOS_HOST_GPU_STREAM_HEADER_BYTES
        if chunk.len().to_i64() > max_chunk:
            return self._reject_rx("rx-chunk-oversize")
        var combined: [u8] = []
        var ci = 0
        while ci < self.rx_carry.len():
            combined.push(self.rx_carry[ci])
            ci = ci + 1
        self.rx_carry = []
        var i = 0
        while i < chunk.len():
            combined.push(chunk[i])
            i = i + 1
        var idx = 0
        while idx < combined.len():
            if val Some(res) = self._consume_stream_byte(combined[idx], now_us):
                var rem = idx + 1
                while rem < combined.len():
                    self.rx_carry.push(combined[rem])
                    rem = rem + 1
                return res
            idx = idx + 1
        VirtioConsoleRxResult(complete: false, rejected: false, reason: "partial", header: None, body: [], body_checksum: self.rx_body_checksum)
