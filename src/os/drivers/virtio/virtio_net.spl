# VirtIO Network Device Driver — DeviceGrant-based PCI transport
#
# MDSOC: feature dimension, drivers layer
# Provides Ethernet frame send/receive for the network stack service.
# Uses two virtqueues: RX (queue 0) and TX (queue 1).
#
# VirtIO legacy PCI transport (BAR0 I/O register layout):
#   0x00 host_features, 0x04 guest_features, 0x08 queue_pfn,
#   0x0C queue_size, 0x0E queue_sel, 0x10 queue_notify,
#   0x12 status, 0x13 isr, 0x14 mac[6], 0x1A link_status
#
# All DMA buffers are allocated via syscall 84 (AllocDma).
# BAR0 is mapped via syscall 83 (MapBar).

# Split from src/os/drivers/virtio/virtio_net.spl to keep module cohesion under the 800-line source limit.
export use os.drivers.virtio._VirtioNet.driver_struct.{VIRTIO_PCI_HOST_FEATURES, VIRTIO_PCI_GUEST_FEATURES, VIRTIO_PCI_QUEUE_PFN, VIRTIO_PCI_QUEUE_SIZE, VIRTIO_PCI_QUEUE_SEL, VIRTIO_PCI_QUEUE_NOTIFY, VIRTIO_PCI_STATUS, VIRTIO_PCI_ISR, VIRTIO_NET_MAC_OFFSET, VIRTIO_NET_STATUS_OFFSET, VIRTIO_STATUS_ACKNOWLEDGE, VIRTIO_STATUS_DRIVER, VIRTIO_STATUS_DRIVER_OK, VIRTIO_STATUS_FEATURES_OK, VIRTIO_STATUS_FAILED, VIRTIO_NET_RX_QUEUE, VIRTIO_NET_TX_QUEUE, RX_BUFFER_COUNT, TX_BUFFER_COUNT, BUFFER_SIZE, VIRTIO_NET_HDR_SIZE, VIRTIO_NET_COMPLETION_POLL, VIRTIO_NET_COMPLETION_INTERRUPT, VIRTIO_NET_COMPLETION_AUTO, VIRTIO_NET_COMPLETION_POLL_LIMIT, VIRTIO_NET_TRANSPORT_PCI, VIRTIO_NET_TRANSPORT_ARM64_MMIO, virtqueue_desc_size, virtqueue_avail_size, virtqueue_used_size, virtqueue_total_size, VirtioNetDriver}
export use os.drivers.virtio._VirtioNet.driver_operations.{unsafe_addr_of, rt_arm64_virtio_net_init, rt_arm64_virtio_net_send, rt_arm64_virtio_net_recv, rt_arm64_virtio_net_mac_octet, rt_arm64_virtio_net_ready}
export use os.drivers.virtio._VirtioNet.dma_alloc_result.{DmaAllocResult}
