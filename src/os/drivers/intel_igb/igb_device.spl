# Intel igb (I210/I211) NIC Driver — NetworkDevice contract surface
#
# MDSOC: feature dimension, drivers layer.
#
# Plan: doc/03_plan/os/simpleos/hw_qemu/clang_board_bringup_x86_64_uefi.md P3.
# This is the INTERFACE half of P3.1: the device type and the five
# NetworkDevice methods the net stack and sshd already call on
# VirtioNetDriver, so neither needs any change when the real ring/BAR
# bring-up lands behind these same signatures.
#
# Honest state: no register access, no descriptor rings, no BAR mapping is
# implemented yet. A freshly constructed device therefore reports
# is_initialized() == false and link_up() == false, and every transfer
# entry point refuses rather than pretending success. Those values are the
# pre-hardware truth the acceptance spec pins; they flip only when the
# P3.1 legacy-descriptor-ring bring-up is written and proven under the
# real-firmware (OVMF pflash) igb QEMU gate of P3.2, then on the board.
#
# TODO(P3.1): implement legacy descriptor rings, single queue, polling
# (no MSI-X) against the I210/I211 register set, and populate mac_bytes
# from the device's RAL/RAH registers.

use os.drivers.virtio.network_device.{NetworkDevice}

struct IntelIgbDevice:
    """Intel I210/I211 gigabit NIC bound to the shared NetworkDevice contract.

    Constructed with no arguments before any hardware exists.
    """
    initialized: bool = false
    link: bool = false
    mac_bytes: [u8] = []

impl NetworkDevice for IntelIgbDevice:

    fn send_frame(data_virt: u64, data_phys: u64, len: u64) -> Result<bool, text>:
        """Transmit one Ethernet frame; refuses until the TX ring exists."""
        Err("intel-igb: tx descriptor ring not implemented")

    fn recv_frame(buf_virt: u64, buf_len: u64) -> u64:
        """Receive one Ethernet frame; 0 bytes until the RX ring exists."""
        0u64

    fn mac_address() -> [u8]:
        """Return the 6-byte MAC address; empty until RAL/RAH are read."""
        self.mac_bytes

    fn link_up() -> bool:
        """Link status latched by the (not yet written) STATUS poll."""
        self.link

    fn is_initialized() -> bool:
        """True only once BAR0 is mapped and the rings are armed."""
        self.initialized
