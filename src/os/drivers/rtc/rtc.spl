# CMOS RTC Driver
#
# Reads the real-time clock from standard CMOS ports 0x70/0x71.
# Register mode is read from CMOS status B before decoding the calendar.
#
# MDSOC: driver dimension, hardware layer

use os.kernel.arch_adapt.x86_port_io.{x86_port_inb, x86_port_outb}
use os.drivers.rtc.rtc_calendar_v1.{RtcRawCalendarV1, rtc_decode_utc_epoch_seconds_v1}
use std.nogc_sync_mut.atomic.{AtomicI64, MemoryOrdering, atomic_i64_new}
# CMOS RTC I/O ports
val RTC_INDEX_PORT: u16 = 0x70
val RTC_DATA_PORT: u16 = 0x71

# CMOS register addresses
val REG_SECONDS: u8 = 0x00
val REG_MINUTES: u8 = 0x02
val REG_HOURS: u8 = 0x04
val REG_DAY: u8 = 0x07
val REG_MONTH: u8 = 0x08
val REG_YEAR: u8 = 0x09
val REG_CENTURY: u8 = 0x32
val REG_STATUS_A: u8 = 0x0A
val REG_STATUS_B: u8 = 0x0B

# =========================================================================
# Low-Level Register Access
# =========================================================================

var _rtc_cmos_index_gate_v1: AtomicI64 = atomic_i64_new(0)

fn _rtc_try_enter_v1() -> bool:
    # A syscall must not wait forever if another CPU stops while owning CMOS.
    var attempts = 0
    while attempts < 4096:
        if _rtc_cmos_index_gate_v1.compare_exchange(
                0, 1, MemoryOrdering.AcqRel, MemoryOrdering.Acquire):
            return true
        attempts = attempts + 1
    false

fn _rtc_exit_v1():
    _rtc_cmos_index_gate_v1.store(0, MemoryOrdering.Release)

fn _rtc_read_register_owned_v1(reg: u8) -> u8:
    """Read a CMOS index/data pair while holding the RTC owner gate."""
    x86_port_outb(RTC_INDEX_PORT, reg)
    x86_port_inb(RTC_DATA_PORT)

fn _rtc_update_in_progress_owned_v1() -> bool:
    """Check whether an RTC update cycle is in progress.

    Bit 7 of Status Register A is set during an update.
    """
    val status = _rtc_read_register_owned_v1(REG_STATUS_A)
    (status & 0x80) != 0

fn _rtc_raw_calendar_owned_v1() -> RtcRawCalendarV1:
    RtcRawCalendarV1(
        status_b: _rtc_read_register_owned_v1(REG_STATUS_B),
        seconds: _rtc_read_register_owned_v1(REG_SECONDS),
        minutes: _rtc_read_register_owned_v1(REG_MINUTES),
        hours: _rtc_read_register_owned_v1(REG_HOURS),
        day: _rtc_read_register_owned_v1(REG_DAY),
        month: _rtc_read_register_owned_v1(REG_MONTH),
        year: _rtc_read_register_owned_v1(REG_YEAR),
        century: _rtc_read_register_owned_v1(REG_CENTURY)
    )

fn _rtc_same_raw_calendar_v1(a: RtcRawCalendarV1, b: RtcRawCalendarV1) -> bool:
    a.status_b == b.status_b and a.seconds == b.seconds and
        a.minutes == b.minutes and a.hours == b.hours and
        a.day == b.day and a.month == b.month and
        a.year == b.year and a.century == b.century

fn _rtc_read_utc_epoch_seconds_owned_v1() -> Result<u64, text>:
    var attempts = 0
    while attempts < 8:
        attempts = attempts + 1
        if _rtc_update_in_progress_owned_v1():
            continue
        val first = _rtc_raw_calendar_owned_v1()
        if _rtc_update_in_progress_owned_v1():
            continue
        val second = _rtc_raw_calendar_owned_v1()
        if _rtc_update_in_progress_owned_v1():
            continue
        if _rtc_same_raw_calendar_v1(first, second):
            return rtc_decode_utc_epoch_seconds_v1(second)
    Err("rtc-unstable-snapshot")

pub fn rtc_read_utc_epoch_seconds_v1() -> Result<u64, text>:
    """Read an x86 UTC RTC into Unix seconds with a bounded CMOS owner gate.

    The century byte at 0x32 is required. The caller must admit a platform
    whose RTC uses UTC and exposes that century register (the x86 QEMU profile
    does); other hardware needs its own RTC provider/century address.
    """
    if not _rtc_try_enter_v1():
        return Err("rtc-index-busy")
    val result = _rtc_read_utc_epoch_seconds_owned_v1()
    _rtc_exit_v1()
    result
