# Freestanding-safe HDA DMA ownership.
#
# The returned scalar address owns four runtime DMA handles.  No aggregate
# crosses the native boundary.

extern fn rt_alloc(size: i64) -> i64
extern fn rt_free(ptr: i64)
extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64
@unsafe(reason: "nonnull raw store; DMA allocation and bounds are caller-owned", capabilities: [ffi, raw_ptr])
extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)
extern fn rt_dma_alloc(size: i64, dir_raw: i32) -> i64
extern fn rt_dma_free(handle: i64)
extern fn rt_dma_virt_of(handle: i64) -> i64
extern fn rt_dma_phys_of(handle: i64) -> i64
extern fn rt_ptr_write_i16(addr: i64, offset: i64, value: i64) -> i64

val HDA_DMA_CORB: i64 = 0
val HDA_DMA_RIRB: i64 = 1
val HDA_DMA_BDL: i64 = 2
val HDA_DMA_PCM: i64 = 3
val HDA_DMA_RESOURCE_COUNT: i64 = 4

fn hda_dma_resource_size(kind: i64) -> i64:
    if kind == HDA_DMA_CORB:
        return 1024
    if kind == HDA_DMA_RIRB:
        return 2048
    if kind == HDA_DMA_BDL:
        return 64
    if kind == HDA_DMA_PCM:
        return 16384
    0

fn _hda_dma_direction(kind: i64) -> i32:
    if kind == HDA_DMA_RIRB:
        return 1
    0

fn hda_dma_resource_handle(resources: i64, kind: i64) -> i64:
    if resources == 0 or kind < 0 or kind >= HDA_DMA_RESOURCE_COUNT:
        return -1
    rt_ptr_read_i64(resources, kind * 8)

fn hda_dma_resource_virt(resources: i64, kind: i64) -> i64:
    val handle = hda_dma_resource_handle(resources, kind)
    if handle < 0:
        return 0
    rt_dma_virt_of(handle)

fn hda_dma_resource_phys(resources: i64, kind: i64) -> i64:
    val handle = hda_dma_resource_handle(resources, kind)
    if handle < 0:
        return 0
    rt_dma_phys_of(handle)

fn hda_dma_resources_destroy(resources: i64):
    if resources == 0:
        return
    var kind: i64 = 0
    while kind < HDA_DMA_RESOURCE_COUNT:
        val handle = hda_dma_resource_handle(resources, kind)
        if handle >= 0:
            rt_dma_free(handle)
            rt_ptr_write_i64(resources, kind * 8, -1)
        kind = kind + 1
    rt_free(resources)

fn hda_dma_resources_create() -> i64:
    val resources = rt_alloc(HDA_DMA_RESOURCE_COUNT * 8)
    if resources == 0:
        return 0
    var kind: i64 = 0
    while kind < HDA_DMA_RESOURCE_COUNT:
        rt_ptr_write_i64(resources, kind * 8, -1)
        kind = kind + 1
    kind = 0
    while kind < HDA_DMA_RESOURCE_COUNT:
        val handle = rt_dma_alloc(
            hda_dma_resource_size(kind),
            _hda_dma_direction(kind)
        )
        if handle < 0:
            hda_dma_resources_destroy(resources)
            return 0
        rt_ptr_write_i64(resources, kind * 8, handle)
        val virt = rt_dma_virt_of(handle)
        val phys = rt_dma_phys_of(handle)
        if (virt == 0 or phys == 0 or
            (virt & 127) != 0 or (phys & 127) != 0):
            hda_dma_resources_destroy(resources)
            return 0
        kind = kind + 1
    resources

fn hda_dma_prepare_silent_stream(resources: i64) -> bool:
    val bdl_virt = hda_dma_resource_virt(resources, HDA_DMA_BDL)
    val pcm_virt = hda_dma_resource_virt(resources, HDA_DMA_PCM)
    val pcm_phys = hda_dma_resource_phys(resources, HDA_DMA_PCM)
    if bdl_virt == 0 or pcm_virt == 0 or pcm_phys == 0:
        return false

    var offset: i64 = 0
    while offset < hda_dma_resource_size(HDA_DMA_PCM):
        rt_ptr_write_i64(pcm_virt, offset, 0)
        offset = offset + 8

    val period_bytes: i64 = 4096
    var period: i64 = 0
    while period < 4:
        val entry_offset = period * 16
        rt_ptr_write_i64(
            bdl_virt,
            entry_offset,
            pcm_phys + period * period_bytes
        )
        # BDL +8: u32 length, then u32 flags; flag bit0 requests IOC.
        rt_ptr_write_i64(
            bdl_virt,
            entry_offset + 8,
            (1 << 32) | period_bytes
        )
        period = period + 1
    true

fn hda_dma_write_pcm_i16(resources: i64, offset_frames: i64, channels: i64, samples: [i64]) -> i64:
    """Write one interleaved-PCM period into the HDA_DMA_PCM ring buffer.

    `samples` holds `channels`-interleaved 16-bit sample values (one i64 slot
    per sample, as submitted by simpleos_hda_submit_pcm_i16). `offset_frames`
    is the frame offset within the PCM buffer (a "frame" is one sample per
    channel). Writes stop at the buffer boundary rather than overrunning it.
    Returns the number of whole frames actually written -- the caller
    (simpleos_hda_submit_pcm_i16) treats a short count as a failed submission.

    Was declared/imported by audio_service.spl but never implemented anywhere
    in the tree (compile-time only, since neither engine ever reached this
    call in prior test runs) -- see
    doc/09_report/os/simpleos_2d_render_qemu_evidence_2026-08-07.md, the
    "Fix + re-run" section covering the 2026-08-08 freestanding-link
    fabricated-stub gate. Genuinely called from the desktop kernel entry's
    unconditional audio-offload boot logging (gui_entry_desktop.spl), so a
    weak return-0 stub would silently corrupt every PCM submission instead of
    honestly reporting a write failure.
    """
    val pcm_virt = hda_dma_resource_virt(resources, HDA_DMA_PCM)
    if pcm_virt == 0 or channels <= 0:
        return 0
    val pcm_size = hda_dma_resource_size(HDA_DMA_PCM)
    val base_byte_offset = offset_frames * channels * 2
    var written_frames: i64 = 0
    var i: i64 = 0
    val n = samples.len()
    while i < n:
        val byte_offset = base_byte_offset + i * 2
        if byte_offset + 2 > pcm_size:
            return written_frames
        rt_ptr_write_i16(pcm_virt, byte_offset, samples[i])
        i = i + 1
        if i % channels == 0:
            written_frames = written_frames + 1
    written_frames

export HDA_DMA_CORB, HDA_DMA_RIRB, HDA_DMA_BDL, HDA_DMA_PCM
export HDA_DMA_RESOURCE_COUNT, hda_dma_resource_size
export hda_dma_resources_create, hda_dma_resources_destroy
export hda_dma_resource_handle, hda_dma_resource_virt, hda_dma_resource_phys
export hda_dma_prepare_silent_stream, hda_dma_write_pcm_i16
