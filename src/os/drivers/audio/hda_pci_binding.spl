# Freestanding-safe Intel HDA PCI discovery.
#
# The PCI runtime owns enumeration. This module returns only a scalar index;
# callers read validated BAR/IRQ/BDF scalars through the accessors below.

extern fn rt_pci_device_count() -> i64
extern fn rt_pci_get_field(index: i64, field: i64) -> i64
extern fn rt_pci_read_bar0(index: i64) -> i64
extern fn rt_pci_enable_memory_bus_master(index: i64) -> i64

val HDA_PCI_NOT_FOUND: i64 = -1
val HDA_PCI_INVALID_RESOURCES: i64 = -2
val HDA_PCI_INVALID_COUNT: i64 = -3

fn _hda_pci_candidate(index: i64) -> bool:
    if index < 0:
        return false
    val class_code = rt_pci_get_field(index, 3)
    val subclass = rt_pci_get_field(index, 4)
    val vendor = rt_pci_get_field(index, 5)
    val device = rt_pci_get_field(index, 6)
    class_code == 4 and subclass == 3 and
        vendor > 0 and vendor < 65535 and
        device > 0 and device < 65535

fn _hda_pci_resources_valid(index: i64) -> bool:
    if not _hda_pci_candidate(index):
        return false
    val bar0 = _hda_pci_bar0_value(index)
    val irq = rt_pci_get_field(index, 7)
    bar0 >= 4096 and (bar0 & 4095) == 0 and irq > 0 and irq < 256

fn _hda_pci_bar0_value(index: i64) -> i64:
    val raw = rt_pci_read_bar0(index)
    if raw <= 0 or (raw & 1) != 0:
        return 0
    raw - (raw & 15)

fn hda_pci_find_index() -> i64:
    val count = rt_pci_device_count()
    if count < 0 or count > 256:
        return HDA_PCI_INVALID_COUNT
    var saw_candidate = false
    var index: i64 = 0
    while index < count:
        if _hda_pci_candidate(index):
            saw_candidate = true
            if _hda_pci_resources_valid(index):
                return index
        index = index + 1
    if saw_candidate:
        HDA_PCI_INVALID_RESOURCES
    else:
        HDA_PCI_NOT_FOUND

fn hda_pci_bar0(index: i64) -> i64:
    if not _hda_pci_resources_valid(index):
        return 0
    _hda_pci_bar0_value(index)

fn hda_pci_irq(index: i64) -> i64:
    if not _hda_pci_resources_valid(index):
        return 0
    rt_pci_get_field(index, 7)

fn hda_pci_bdf(index: i64) -> i64:
    if not _hda_pci_resources_valid(index):
        return 0
    val bus = rt_pci_get_field(index, 0)
    val device = rt_pci_get_field(index, 1)
    val function = rt_pci_get_field(index, 2)
    if (bus < 0 or bus > 255 or device < 0 or device > 31 or
        function < 0 or function > 7):
        return 0
    (bus << 16) | (device << 8) | function

fn hda_pci_vendor(index: i64) -> i64:
    if not _hda_pci_resources_valid(index):
        return 0
    rt_pci_get_field(index, 5)

fn hda_pci_device(index: i64) -> i64:
    if not _hda_pci_resources_valid(index):
        return 0
    rt_pci_get_field(index, 6)

fn hda_pci_enable(index: i64) -> bool:
    _hda_pci_resources_valid(index) and
        rt_pci_enable_memory_bus_master(index) == 1

export HDA_PCI_NOT_FOUND, HDA_PCI_INVALID_RESOURCES, HDA_PCI_INVALID_COUNT
export hda_pci_find_index, hda_pci_bar0, hda_pci_irq, hda_pci_bdf
export hda_pci_vendor, hda_pci_device, hda_pci_enable
