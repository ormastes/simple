# Architecture-selected PCI configuration access facade.

@cfg(x86_64)
use os.drivers.pci.pci_config_access_x86_64.{pci_read_config, pci_write_config}
@cfg(arm64)
use os.drivers.pci.pci_config_access_arm64.{pci_read_config, pci_write_config}
@cfg(riscv64)
use os.drivers.pci.pci_config_access_riscv64.{pci_read_config, pci_write_config}

export pci_read_config, pci_write_config
