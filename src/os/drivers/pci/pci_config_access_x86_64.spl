extern fn rt_port_inl(port: u16) -> u32
extern fn rt_port_outl(port: u16, value: u32)

val PCI_CONFIG_ADDR: u16 = 0xCF8
val PCI_CONFIG_DATA: u16 = 0xCFC

fn pci_config_addr(bus: u8, device: u8, func: u8, offset: u8) -> u32:
    val b = bus.to_u32()
    val d = device.to_u32()
    val f = func.to_u32()
    val o = offset.to_u32()
    (1u32 << 31) | (b << 16) | (d << 11) | (f << 8) | (o & 0xFCu32)

fn pci_read_config(bus: u8, device: u8, func: u8, offset: u8) -> u32:
    val addr = pci_config_addr(bus, device, func, offset)
    rt_port_outl(PCI_CONFIG_ADDR, addr)
    rt_port_inl(PCI_CONFIG_DATA)

fn pci_write_config(bus: u8, device: u8, func: u8, offset: u8, value: u32):
    val addr = pci_config_addr(bus, device, func, offset)
    rt_port_outl(PCI_CONFIG_ADDR, addr)
    rt_port_outl(PCI_CONFIG_DATA, value)

export pci_read_config, pci_write_config
