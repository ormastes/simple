use os.drivers.pci.pci_provider.{PciConfigTarget, pci_ecam_addr}
use os.kernel.boot.mmio_hardware.{mmio_read32, mmio_write32}

val PCI_ECAM_BASE: u64 = 0x30000000u64

fn pci_read_config(bus: u8, device: u8, func: u8, offset: u8) -> u32:
    mmio_read32(pci_ecam_addr(PCI_ECAM_BASE, PciConfigTarget(bus: bus, device: device, func: func, offset: offset.to_u16())))

fn pci_write_config(bus: u8, device: u8, func: u8, offset: u8, value: u32):
    mmio_write32(pci_ecam_addr(PCI_ECAM_BASE, PciConfigTarget(bus: bus, device: device, func: func, offset: offset.to_u16())), value)

export pci_read_config, pci_write_config
