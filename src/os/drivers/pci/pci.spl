# PCI Bus Enumeration — Configuration Space Access
#
# MDSOC: feature dimension, drivers layer
# Scans PCI bus for devices via I/O ports 0xCF8/0xCFC (x86 method 1).
# Used to discover VirtIO devices, network cards, GPU, etc.

@cfg(x86_64)
use os.kernel.arch_adapt.x86_port_io.{x86_port_inl, x86_port_outl}
@cfg(x86)
use os.kernel.arch_adapt.x86_port_io.{x86_port_inl, x86_port_outl}

use os.drivers.pci.pci_provider.{PciConfigTarget, pci_ecam_addr}
use os.kernel.boot.mmio.{mmio_read32, mmio_write32}
use os.kernel.boot.fdt_blob.{FdtBlob, fdt_find_compatible, fdt_node_reg}

# PCI configuration ports
val PCI_CONFIG_ADDR: u16 = 0xCF8
val PCI_CONFIG_DATA: u16 = 0xCFC

# ============================================================================
# PCI Device Identifier
# ============================================================================

struct PciDevice:
    """Discovered PCI device."""
    bus: u8
    device: u8
    func: u8
    vendor_id: u16
    device_id: u16
    class_code: u8
    subclass: u8
    prog_if: u8
    header_type: u8
    bar0: u32               # Base Address Register 0
    bar1: u32
    irq_line: u8

impl PciDevice:
    fn is_valid() -> bool:
        self.vendor_id != 0xFFFF

    fn is_bridge() -> bool:
        self.class_code == 0x06

    fn is_virtio() -> bool:
        self.vendor_id == 0x1AF4  # Red Hat VirtIO vendor

    fn description() -> text:
        "PCI {self.bus}:{self.device}.{self.func} vendor={self.vendor_id} device={self.device_id} class={self.class_code}:{self.subclass}"

# ============================================================================
# PCI Config Space Access
# ============================================================================

fn pci_config_addr(bus: u8, device: u8, func: u8, offset: u8) -> u32:
    """Build PCI config address for I/O method 1."""
    val b = bus.to_u32()
    val d = device.to_u32()
    val f = func.to_u32()
    val o = offset.to_u32()
    (1u32 << 31) | (b << 16) | (d << 11) | (f << 8) | (o & 0xFCu32)

@cfg(x86_64)
fn pci_read_config(bus: u8, device: u8, func: u8, offset: u8) -> u32:
    """Read 32-bit value from PCI config space."""
    val addr = pci_config_addr(bus, device, func, offset)
    x86_port_outl(PCI_CONFIG_ADDR, addr)
    x86_port_inl(PCI_CONFIG_DATA)

@cfg(x86)
fn pci_read_config(bus: u8, device: u8, func: u8, offset: u8) -> u32:
    """Read 32-bit value from PCI config space."""
    val addr = pci_config_addr(bus, device, func, offset)
    x86_port_outl(PCI_CONFIG_ADDR, addr)
    x86_port_inl(PCI_CONFIG_DATA)

@cfg(x86_64)
fn pci_write_config(bus: u8, device: u8, func: u8, offset: u8, value: u32):
    """Write 32-bit value to PCI config space."""
    val addr = pci_config_addr(bus, device, func, offset)
    x86_port_outl(PCI_CONFIG_ADDR, addr)
    x86_port_outl(PCI_CONFIG_DATA, value)

@cfg(x86)
fn pci_write_config(bus: u8, device: u8, func: u8, offset: u8, value: u32):
    """Write 32-bit value to PCI config space."""
    val addr = pci_config_addr(bus, device, func, offset)
    x86_port_outl(PCI_CONFIG_ADDR, addr)
    x86_port_outl(PCI_CONFIG_DATA, value)

var _pci_ecam_override_base: u64 = 0u64

# Platform PCI ECAM bases (QEMU virt ARM64 = 0x4010000000, QEMU virt RV64 = 0x30000000).
# Runtime DTB discovery overrides this via pci_configure_ecam_from_fdt / pci_set_ecam_base.
@cfg(arm64)
fn _pci_ecam_base() -> u64: 0x4010000000u64

@cfg(riscv64)
fn _pci_ecam_base() -> u64: 0x30000000u64

@cfg(x86_64)
fn _pci_ecam_base() -> u64: 0u64

@cfg(x86)
fn _pci_ecam_base() -> u64: 0u64

@cfg(riscv32)
fn _pci_ecam_base() -> u64: 0u64

@cfg(arm32)
fn _pci_ecam_base() -> u64: 0u64

@allow(primitive_api)  # reason: PCI ECAM hardware MMIO physical base address
pub fn pci_ecam_base() -> u64:
    """Return active PCI ECAM base (DTB/runtime override if non-zero, else arch default)."""
    if _pci_ecam_override_base != 0u64:
        return _pci_ecam_override_base
    _pci_ecam_base()

@allow(primitive_api)  # reason: PCI ECAM hardware MMIO physical base override
pub fn pci_set_ecam_base(base: u64):
    """Set or clear (0) runtime PCI ECAM base override."""
    _pci_ecam_override_base = base

@allow(primitive_api)  # reason: DTB PCI ECAM hardware MMIO physical base extraction
pub fn pci_ecam_base_from_fdt(blob: FdtBlob) -> u64:
    """Extract PCI ECAM base address from DTB 'pci-host-ecam-generic' node."""
    if not blob.valid():
        return 0u64
    val node = fdt_find_compatible(blob, ["pci-host-ecam-generic"], 0u64)
    if not node.found:
        return 0u64
    val reg = fdt_node_reg(blob, node, 0u64)
    if not reg.found:
        return 0u64
    reg.addr

@allow(primitive_api)  # reason: DTB PCI ECAM hardware MMIO physical base configuration
pub fn pci_configure_ecam_from_fdt(blob: FdtBlob) -> u64:
    """Discover PCI ECAM base from DTB and activate it if present."""
    val detected = pci_ecam_base_from_fdt(blob)
    if detected != 0u64:
        _pci_ecam_override_base = detected
    pci_ecam_base()

fn _pci_ecam_valid_coords(base: u64, device: u8, func: u8) -> bool:
    base != 0u64 and device < 32u8 and func < 8u8

fn _pci_ecam_default_addr(bus: u8, device: u8, func: u8, offset: u8) -> u64:
    if _pci_ecam_base() == 0u64:
        return 0u64
    val aligned = (offset & 0xFCu8).to_u16()
    pci_ecam_addr(_pci_ecam_base(), PciConfigTarget(bus: bus, device: device, func: func, offset: aligned))

@allow(primitive_api)  # reason: raw PCI ECAM MMIO config-space register read
pub fn pci_ecam_read_config_at(base: u64, bus: u8, device: u8, func: u8, offset: u8) -> u32:
    """Read aligned 32-bit PCI config dword at explicit ECAM base via MMIO."""
    if not _pci_ecam_valid_coords(base, device, func):
        return 0xFFFFFFFFu32
    val aligned = (offset & 0xFCu8).to_u16()
    val addr = pci_ecam_addr(base, PciConfigTarget(bus: bus, device: device, func: func, offset: aligned))
    mmio_read32(addr)

@allow(primitive_api)  # reason: raw PCI ECAM MMIO config-space register write
pub fn pci_ecam_write_config_at(base: u64, bus: u8, device: u8, func: u8, offset: u8, value: u32):
    """Write aligned 32-bit PCI config dword at explicit ECAM base via MMIO."""
    if not _pci_ecam_valid_coords(base, device, func):
        return
    val aligned = (offset & 0xFCu8).to_u16()
    val addr = pci_ecam_addr(base, PciConfigTarget(bus: bus, device: device, func: func, offset: aligned))
    mmio_write32(addr, value)

fn _pci_ecam_active_read(bus: u8, device: u8, func: u8, offset: u8) -> u32:
    if _pci_ecam_override_base != 0u64:
        return pci_ecam_read_config_at(_pci_ecam_override_base, bus, device, func, offset)
    if device >= 32u8 or func >= 8u8:
        return 0xFFFFFFFFu32
    val addr = _pci_ecam_default_addr(bus, device, func, offset)
    if addr == 0u64:
        return 0xFFFFFFFFu32
    mmio_read32(addr)

fn _pci_ecam_active_write(bus: u8, device: u8, func: u8, offset: u8, value: u32):
    if _pci_ecam_override_base != 0u64:
        pci_ecam_write_config_at(_pci_ecam_override_base, bus, device, func, offset, value)
        return
    if device >= 32u8 or func >= 8u8:
        return
    val addr = _pci_ecam_default_addr(bus, device, func, offset)
    if addr == 0u64:
        return
    mmio_write32(addr, value)

@cfg(arm64)
fn pci_read_config(bus: u8, device: u8, func: u8, offset: u8) -> u32:
    _pci_ecam_active_read(bus, device, func, offset)

@cfg(riscv64)
fn pci_read_config(bus: u8, device: u8, func: u8, offset: u8) -> u32:
    _pci_ecam_active_read(bus, device, func, offset)

@cfg(arm64)
fn pci_write_config(bus: u8, device: u8, func: u8, offset: u8, value: u32):
    _pci_ecam_active_write(bus, device, func, offset, value)

@cfg(riscv64)
fn pci_write_config(bus: u8, device: u8, func: u8, offset: u8, value: u32):
    _pci_ecam_active_write(bus, device, func, offset, value)

# riscv32/arm32: no PCI host wired; empty bus (all-ones reads, dropped writes).
@cfg(riscv32)
fn pci_read_config(bus: u8, device: u8, func: u8, offset: u8) -> u32:
    0xFFFFFFFFu32

@cfg(arm32)
fn pci_read_config(bus: u8, device: u8, func: u8, offset: u8) -> u32:
    0xFFFFFFFFu32

@cfg(riscv32)
fn pci_write_config(bus: u8, device: u8, func: u8, offset: u8, value: u32):
    pass_do_nothing("riscv32: no PCI host wired")

@cfg(arm32)
fn pci_write_config(bus: u8, device: u8, func: u8, offset: u8, value: u32):
    pass_do_nothing("arm32: no PCI host wired")

fn pci_read_vendor(bus: u8, device: u8, func: u8) -> u16:
    val raw = pci_read_config(bus, device, func, 0x00) & 0xFFFF
    raw.to_u16()

fn pci_read_device_id(bus: u8, device: u8, func: u8) -> u16:
    val raw = pci_read_config(bus, device, func, 0x00) >> 16
    raw.to_u16()

fn pci_read_class(bus: u8, device: u8, func: u8) -> u32:
    pci_read_config(bus, device, func, 0x08)

fn pci_read_header_type(bus: u8, device: u8, func: u8) -> u8:
    val raw = (pci_read_config(bus, device, func, 0x0C) >> 16) & 0xFF
    raw.to_u8()

fn pci_read_bar(bus: u8, device: u8, func: u8, bar_num: u8) -> u32:
    pci_read_config(bus, device, func, (0x10u32 + bar_num.to_u32() * 4u32).to_u8())

fn pci_read_irq(bus: u8, device: u8, func: u8) -> u8:
    val raw = pci_read_config(bus, device, func, 0x3C) & 0xFF
    raw.to_u8()

# ============================================================================
# PCI Bus Scanner
# ============================================================================

class PciBus:
    """PCI bus scanner and device registry."""
    devices: [PciDevice]

impl PciBus:
    static fn new() -> PciBus:
        PciBus(devices: [])

    me scan():
        """Enumerate all PCI devices on all buses."""
        var bus: u16 = 0
        while bus < 256u16:
            var dev: u8 = 0
            while dev < 32u8:
                val bus_u8 = bus.to_u8()
                self.scan_device(bus_u8, dev)
                dev = dev + 1
            bus = bus + 1

    me scan_device(bus: u8, device: u8):
        """Check if a device exists at bus:device and scan all functions."""
        val vendor = pci_read_vendor(bus, device, 0)
        if vendor == 0xFFFF:
            return  # No device

        val zero_func: u8 = 0
        self.scan_function(bus, device, zero_func)

        # Check for multi-function device
        val header_type = pci_read_header_type(bus, device, zero_func)
        if (header_type & 0x80) != 0:
            var func: u8 = 1
            while func < 8u8:
                val fv = pci_read_vendor(bus, device, func)
                if fv != 0xFFFF:
                    self.scan_function(bus, device, func)
                func = func + 1

    me scan_function(bus: u8, device: u8, func: u8):
        """Read device info for one PCI function."""
        val class_info = pci_read_class(bus, device, func)
        val cc_raw = (class_info >> 24) & 0xFF
        val class_code = cc_raw.to_u8()
        val sc_raw = (class_info >> 16) & 0xFF
        val subclass = sc_raw.to_u8()
        val pi_raw = (class_info >> 8) & 0xFF
        val prog_if = pi_raw.to_u8()
        val vid = pci_read_vendor(bus, device, func)
        val did = pci_read_device_id(bus, device, func)
        val htype = pci_read_header_type(bus, device, func)
        val b0 = pci_read_bar(bus, device, func, 0)
        val b1 = pci_read_bar(bus, device, func, 1)
        val irq = pci_read_irq(bus, device, func)
        val pci_dev = PciDevice(
            bus: bus,
            device: device,
            func: func,
            vendor_id: vid,
            device_id: did,
            class_code: class_code,
            subclass: subclass,
            prog_if: prog_if,
            header_type: htype,
            bar0: b0,
            bar1: b1,
            irq_line: irq
        )
        self.devices.push(pci_dev)

    fn find_by_vendor_device(vendor: u16, device_id: u16) -> PciDevice?:
        """Find first device matching vendor:device."""
        for dev in self.devices:
            if dev.vendor_id == vendor and dev.device_id == device_id:
                return dev
        nil

    fn find_virtio_devices() -> [PciDevice]:
        """Find all VirtIO devices."""
        var result: [PciDevice] = []
        for dev in self.devices:
            if dev.is_virtio():
                result.push(dev)
        result

    fn find_by_class(class_code: u8, subclass: u8) -> [PciDevice]:
        """Find devices by class/subclass."""
        var result: [PciDevice] = []
        for dev in self.devices:
            if dev.class_code == class_code and dev.subclass == subclass:
                result.push(dev)
        result

    fn device_count() -> i32:
        self.devices.len()

export PCI_CONFIG_ADDR, PCI_CONFIG_DATA
export PciDevice, PciBus
export pci_config_addr, pci_read_config, pci_write_config
export pci_read_vendor, pci_read_device_id, pci_read_class, pci_read_header_type, pci_read_bar, pci_read_irq
export pci_ecam_base, pci_set_ecam_base, pci_ecam_base_from_fdt, pci_configure_ecam_from_fdt
export pci_ecam_read_config_at, pci_ecam_write_config_at
