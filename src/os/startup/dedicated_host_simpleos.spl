# Native SimpleOS implementation of the dedicated host contract.
#
# Anonymous private mappings use the SimpleOS memory syscalls. Read-only file
# startup uses the VFS page-prewarm/materialization owner. File-backed mmap and
# shared mappings remain explicit unsupported results until the user ABI can
# carry the kernel's backing handle and offset without semantic downgrade.

use common.platform.dedicated_host.{
    DedicatedHost,
    HOST_MAP_FAILED,
    HostFilePreload,
    HostMapRequest,
    HostMappedRegion,
    host_file_preload_error,
    host_file_preload_success,
    host_map_error,
    host_map_is_anonymous_private,
    host_mapped_region_releasable,
    host_map_request_error,
    host_map_success,
    host_protection_error
}
use os.userlib.syscall_raw.{syscall}
use os.services.vfs.vfs_boot_init.{vfs_get_manager}
use os.services.vfs.vfs_init.{g_vfs_read_file_bytes}

pub class SimpleOsDedicatedHost:
    identity: text

    static fn create() -> SimpleOsDedicatedHost:
        SimpleOsDedicatedHost(identity: "simpleos")

pub fn simpleos_dedicated_host_map_request_error(request: HostMapRequest, page_size: i64 = 4096) -> text:
    val validation_error = host_map_request_error(request, page_size)
    if validation_error != "":
        return validation_error
    if not host_map_is_anonymous_private(request):
        return "simpleos-file-or-shared-mmap-unsupported"
    ""

impl DedicatedHost for SimpleOsDedicatedHost:
    fn host_name() -> text:
        self.identity

    fn page_size() -> i64:
        4096

    fn supports_file_backed_mmap() -> bool:
        false

    fn supports_shared_writable_mmap() -> bool:
        false

    me mmap(request: HostMapRequest) -> HostMappedRegion:
        val validation_error = simpleos_dedicated_host_map_request_error(request, self.page_size())
        if validation_error != "":
            val code = if validation_error == "simpleos-file-or-shared-mmap-unsupported": -95 else: -22
            return host_map_error(self.identity, code, validation_error)
        val address = syscall(
            10u64,
            request.address_hint as u64,
            request.length as u64,
            request.protection as u64,
            request.flags as u64,
            0u64
        )
        if address < 0:
            return host_map_error(self.identity, address, "simpleos-mmap-failed")
        host_map_success(self.identity, "simpleos-anonymous-private", address, request.length)

    me mprotect(region: HostMappedRegion, protection: i64) -> bool:
        if not host_mapped_region_releasable(region) or host_protection_error(protection) != "":
            return false
        syscall(12u64, region.address as u64, region.length as u64, protection as u64, 0u64, 0u64) == 0

    me munmap(region: HostMappedRegion) -> bool:
        if not host_mapped_region_releasable(region):
            return false
        syscall(11u64, region.address as u64, region.length as u64, 0u64, 0u64, 0u64) == 0

    me preload_readonly_file(path: text, page_size: i64) -> HostFilePreload:
        if path == "":
            return host_file_preload_error(path, self.identity, -22, "path-must-not-be-empty")
        if page_size <= 0:
            return host_file_preload_error(path, self.identity, -22, "page-size-must-be-positive")
        var vfs = vfs_get_manager()
        val warmed = vfs.preload_file_pages(path, page_size as u64)
        if warmed.is_err():
            return host_file_preload_error(path, self.identity, -5, warmed.unwrap_err())
        val bytes = g_vfs_read_file_bytes(path)
        if warmed.unwrap() > 0 and bytes.len() == 0:
            return host_file_preload_error(path, self.identity, -5, "vfs-preload-materialization-empty")
        host_file_preload_success(path, bytes, page_size, self.identity, "simpleos-vfs-prewarm", false)
