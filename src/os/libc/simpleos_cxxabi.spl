# SimpleOS C++ ABI canary surface.
#
# The linked C shim owns the exported ABI symbols today. This Simple mirror is
# the hardening/audit source of truth for the stack-guard policy: the guard is
# initialized from boot entropy, never from a fixed sentinel.

var g_stack_canary: u64 = 0

# @allow(primitive_api) C ABI mirror: unsigned-long address bit patterns and the explicit native-word width define the canary mixer arithmetic
pub fn simpleos_cxxabi_mix_stack_seed(address_seed: u64, word_bits: i64) -> Result<u64, text>:
    """Mix XORed fallback addresses at the C unsigned-long width.

    Mirrors simpleos_fallback_stack_seed without changing the entropy-provider
    ABI. ELF32 truncates at native-word arithmetic boundaries; ELF64 retains
    the original 33-bit-shift mixer. Both guarantee a nonzero guard.
    """
    if word_bits != 32 and word_bits != 64:
        return Err("stack canary word width must be 32 or 64")
    val mask: u64 = if word_bits == 32: 0xffffffff else: 0xffffffffffffffff
    val shift = if word_bits == 32: 16 else: 33
    var seed: u64 = (address_seed & mask) ^ 0x9E3779B9
    seed = seed ^ (seed >> shift)
    seed = (seed * 0x85EBCA6B) & mask
    seed = seed ^ (seed >> shift)
    if seed == 0: Ok(0xA5A55A5A) else: Ok(seed)

fn simpleos_cxxabi_canary_init(seed: u64) -> u64:
    """Install and return a non-zero stack canary seed."""
    if seed == 0:
        g_stack_canary = 0xA5A5A5A55A5A5A5A
    else:
        g_stack_canary = seed
    g_stack_canary

fn simpleos_cxxabi_canary_value() -> u64:
    """Return the current stack canary value."""
    g_stack_canary

fn simpleos_cxxabi_canary_ready() -> bool:
    """Return true once the canary has been initialized."""
    g_stack_canary != 0
