"""Deterministic bounded manifest builder for a staged Clang include tree."""

use std.nogc_sync_mut.ffi.io.{dir_exists, dir_list, file_size, file_read_bytes}
use std.nogc_sync_mut.io.file_ops.{file_is_regular_no_follow}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.string_core.{text_to_bytes}

pub const CLANG_INCLUDE_MANIFEST_MAX_ENTRIES_V1: i64 = 4096
pub const CLANG_INCLUDE_MANIFEST_MAX_DEPTH_V1: i64 = 32
pub const CLANG_INCLUDE_MANIFEST_MAX_FILE_BYTES_V1: i64 = 1048576
pub const CLANG_INCLUDE_MANIFEST_MAX_TREE_BYTES_V1: i64 = 67108864
pub val CLANG_INCLUDE_MANIFEST_GUEST_PATH_V1: text =
    "/usr/include/.simpleos-sysroot.merkle"

pub struct ClangIncludeManifestBuildV1:
    ok: bool
    reason: text
    content: text
    root_sha256: text
    entry_count: i64
    total_bytes: i64

fn _fail_v1(reason: text) -> ClangIncludeManifestBuildV1:
    ClangIncludeManifestBuildV1(
        ok: false, reason: reason, content: "", root_sha256: "",
        entry_count: 0, total_bytes: 0)

fn _name_safe_v1(name: text) -> bool:
    name != "" and name != "." and name != ".." and
        not name.contains("/") and not name.contains("\\") and
        not name.contains(" ") and not name.contains("\0") and
        not name.contains("\n") and not name.contains("\r") and
        not name.contains("\t")

fn _collect_v1(
    host_root: text, relative: text, depth: i64, mut paths: [text]
) -> text:
    if depth > CLANG_INCLUDE_MANIFEST_MAX_DEPTH_V1: return "depth-limit"
    val directory = if relative == "": host_root else: "{host_root}/{relative}"
    var names = dir_list(directory)
    names.sort()
    for name in names:
        if not _name_safe_v1(name): return "unsafe-entry-name"
        val child_relative = if relative == "": name else: "{relative}/{name}"
        val host_path = "{host_root}/{child_relative}"
        if dir_exists(host_path):
            val nested = _collect_v1(host_root, child_relative, depth + 1, paths)
            if nested != "": return nested
        else:
            if child_relative == ".simpleos-sysroot.merkle":
                return "manifest-self-entry"
            if paths.len() >= CLANG_INCLUDE_MANIFEST_MAX_ENTRIES_V1:
                return "entry-limit"
            paths.push(child_relative)
    ""

pub fn clang_include_manifest_build_v1(
    host_include_root: text, target_triple: text
) -> ClangIncludeManifestBuildV1:
    if host_include_root == "" or target_triple == "" or
       not dir_exists(host_include_root):
        return _fail_v1("invalid-root-or-target")
    var paths: [text] = []
    val collected = _collect_v1(host_include_root, "", 0, paths)
    if collected != "": return _fail_v1(collected)
    if paths.len() == 0: return _fail_v1("empty-include-tree")
    var canonical = "target={target_triple}\n"
    var total: i64 = 0
    for relative in paths:
        val host_path = "{host_include_root}/{relative}"
        if not file_is_regular_no_follow(host_path):
            return _fail_v1("header-not-regular-or-symlink")
        val size = file_size(host_path)
        # Empty regular headers are valid feature-disable shims.  The
        # no-follow regular-file check above distinguishes them from absence.
        if size < 0 or size > CLANG_INCLUDE_MANIFEST_MAX_FILE_BYTES_V1 or
           total > CLANG_INCLUDE_MANIFEST_MAX_TREE_BYTES_V1 - size:
            return _fail_v1("header-size-bound")
        val data = file_read_bytes(host_path)
        if data.len() != size: return _fail_v1("header-read-incomplete")
        val guest_path = "/usr/include/{relative}"
        canonical = canonical + sha256_u8_hex(data) + " " + guest_path + "\n"
        total = total + size
    val root = sha256_u8_hex(text_to_bytes(canonical))
    val content = "simpleos-include-tree-v1\ntarget={target_triple}\n" +
        "root_sha256={root}\nentry_count={paths.len()}\n" +
        canonical.slice("target={target_triple}\n".len(), canonical.len())
    ClangIncludeManifestBuildV1(
        ok: true, reason: "", content: content, root_sha256: root,
        entry_count: paths.len(), total_bytes: total)
