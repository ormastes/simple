# codex-impl
# Truthful catalog and receipts for SimpleOS server artifacts staged in FAT32.

use os.kernel.loader.fs_exec_receipt.{FsExecReceipt}

pub struct SimpleOsServerArtifact:
    pub id: text
    pub version: text
    pub sha256: text
    pub host_path: text
    pub filesystem_path: text

pub struct SimpleOsServerArtifactCheck:
    pub ok: bool
    pub reason: text

pub struct SimpleOsServerArtifactReceipt:
    pub id: text
    pub version: text
    pub sha256: text
    pub filesystem_path: text
    pub image_id: text
    pub image_sha256: text
    pub launch_id: text
    pub staged: bool
    pub runnable: bool
    pub pid: i64
    pub exit_code: i64
    pub reason: text

pub struct SimpleOsServerStagingEvidence:
    pub filesystem_path: text
    pub host_sha256: text
    pub filesystem_sha256: text
    pub byte_size: i64
    pub image_id: text
    pub image_sha256: text

pub struct SimpleOsServerSocketReceipt:
    pub artifact_id: text
    pub filesystem_path: text
    pub pid: i64
    pub image_id: text
    pub launch_id: text
    pub bind_address: text
    pub port: i64
    pub challenge: text
    pub response: text
    pub successful_exchanges: i64

pub struct SimpleOsServerLaunchEvidence:
    pub filesystem_path: text
    pub artifact_sha256: text
    pub image_id: text
    pub image_sha256: text
    pub launch_id: text
    pub pid: i64
    pub process_registered: bool
    pub start_observed: bool

pub fn simpleos_web_server_filesystem_path() -> text:
    "/SYS/APPS/WEBSRV.SMF"

pub fn simpleos_db_server_filesystem_path() -> text:
    "/SYS/APPS/DBSRV.SMF"

pub fn simpleos_web_server_artifact(version: text, sha256: text, host_path: text) -> SimpleOsServerArtifact:
    SimpleOsServerArtifact(
        id: "simple_web_server",
        version: version,
        sha256: sha256,
        host_path: host_path,
        filesystem_path: simpleos_web_server_filesystem_path()
    )

pub fn simpleos_db_server_artifact(version: text, sha256: text, host_path: text) -> SimpleOsServerArtifact:
    SimpleOsServerArtifact(
        id: "simple_db_server",
        version: version,
        sha256: sha256,
        host_path: host_path,
        filesystem_path: simpleos_db_server_filesystem_path()
    )

fn _is_lower_hex_sha256(value: text) -> bool:
    if value.len() != 64:
        return false
    for c in value:
        val digit = c >= '0' and c <= '9'
        val lower_hex = c >= 'a' and c <= 'f'
        if not digit and not lower_hex:
            return false
    true

pub fn simpleos_server_artifact_validate(artifact: SimpleOsServerArtifact) -> SimpleOsServerArtifactCheck:
    if artifact.id != "simple_web_server" and artifact.id != "simple_db_server":
        return SimpleOsServerArtifactCheck(ok: false, reason: "unknown-server-id")
    if artifact.version.trim() == "" or artifact.version == "latest":
        return SimpleOsServerArtifactCheck(ok: false, reason: "unpinned-version")
    if not _is_lower_hex_sha256(artifact.sha256):
        return SimpleOsServerArtifactCheck(ok: false, reason: "invalid-sha256")
    if artifact.host_path.trim() == "":
        return SimpleOsServerArtifactCheck(ok: false, reason: "empty-host-path")
    val expected_path = if artifact.id == "simple_web_server":
        simpleos_web_server_filesystem_path()
    else:
        simpleos_db_server_filesystem_path()
    if artifact.filesystem_path != expected_path:
        return SimpleOsServerArtifactCheck(ok: false, reason: "noncanonical-filesystem-path")
    SimpleOsServerArtifactCheck(ok: true, reason: "ok")

pub fn simpleos_server_artifact_staged_receipt(artifact: SimpleOsServerArtifact) -> SimpleOsServerArtifactReceipt:
    val check = simpleos_server_artifact_validate(artifact)
    if not check.ok:
        return SimpleOsServerArtifactReceipt(
            id: artifact.id, version: artifact.version, sha256: artifact.sha256,
            filesystem_path: artifact.filesystem_path, image_id: "", image_sha256: "",
            launch_id: "", staged: false, runnable: false,
            pid: 0, exit_code: -1, reason: check.reason
        )
    SimpleOsServerArtifactReceipt(
        id: artifact.id, version: artifact.version, sha256: artifact.sha256,
        filesystem_path: artifact.filesystem_path, image_id: "", image_sha256: "",
        launch_id: "", staged: false, runnable: false,
        pid: 0, exit_code: -1, reason: "staging-not-observed"
    )

pub fn simpleos_server_artifact_observed_staging_receipt(
    artifact: SimpleOsServerArtifact,
    evidence: SimpleOsServerStagingEvidence
) -> SimpleOsServerArtifactReceipt:
    val checked = simpleos_server_artifact_staged_receipt(artifact)
    if checked.reason != "staging-not-observed":
        return checked
    if evidence.filesystem_path != artifact.filesystem_path:
        var mismatch = checked
        mismatch.reason = "staging-filesystem-path-mismatch"
        return mismatch
    if evidence.host_sha256 != artifact.sha256 or
            evidence.filesystem_sha256 != artifact.sha256:
        var mismatch = checked
        mismatch.reason = "staging-content-hash-mismatch"
        return mismatch
    if evidence.byte_size <= 0:
        var empty = checked
        empty.reason = "staging-empty-artifact"
        return empty
    if evidence.image_id.trim() == "" or not _is_lower_hex_sha256(evidence.image_sha256):
        var unpinned = checked
        unpinned.reason = "staging-image-unpinned"
        return unpinned
    SimpleOsServerArtifactReceipt(
        id: artifact.id, version: artifact.version, sha256: artifact.sha256,
        filesystem_path: artifact.filesystem_path, image_id: evidence.image_id,
        image_sha256: evidence.image_sha256, launch_id: "", staged: true, runnable: false,
        pid: 0, exit_code: -1, reason: "staged-not-execution-proof"
    )

pub fn simpleos_server_artifact_execution_receipt(
    artifact: SimpleOsServerArtifact,
    staging: SimpleOsServerArtifactReceipt,
    execution: FsExecReceipt,
    socket: SimpleOsServerSocketReceipt
) -> SimpleOsServerArtifactReceipt:
    val artifact_check = simpleos_server_artifact_validate(artifact)
    if not artifact_check.ok:
        return simpleos_server_artifact_staged_receipt(artifact)
    if not staging.staged or staging.id != artifact.id or
            staging.version != artifact.version or staging.sha256 != artifact.sha256 or
            staging.filesystem_path != artifact.filesystem_path:
        var invalid_stage = staging
        invalid_stage.staged = false
        invalid_stage.runnable = false
        invalid_stage.pid = 0
        invalid_stage.exit_code = -1
        invalid_stage.launch_id = ""
        invalid_stage.reason = "staging-receipt-mismatch"
        return invalid_stage
    if execution.path != artifact.filesystem_path:
        var wrong_path = staging
        wrong_path.runnable = false
        wrong_path.reason = "execution-path-mismatch"
        return wrong_path
    if execution.pid <= 0 or not execution.process_registered or
            not execution.started or not execution.exited or execution.exit_code != 0:
        var failed = staging
        failed.runnable = false
        failed.pid = execution.pid
        failed.exit_code = execution.exit_code
        failed.reason = "filesystem-execution-not-proven"
        return failed
    if socket.artifact_id != artifact.id or
            socket.filesystem_path != artifact.filesystem_path or
            socket.pid != execution.pid or socket.image_id != staging.image_id or
            socket.launch_id.trim() == "":
        var wrong_socket = staging
        wrong_socket.runnable = false
        wrong_socket.pid = execution.pid
        wrong_socket.exit_code = execution.exit_code
        wrong_socket.reason = "socket-receipt-mismatch"
        return wrong_socket
    if socket.bind_address.trim() == "" or socket.port <= 0 or socket.port > 65535 or
            socket.challenge.trim() == "" or socket.response != socket.challenge or
            socket.successful_exchanges <= 0:
        var no_socket = staging
        no_socket.runnable = false
        no_socket.pid = execution.pid
        no_socket.exit_code = execution.exit_code
        no_socket.reason = "socket-capability-not-proven"
        return no_socket
    # An exited process can prove that filesystem execution happened, but it
    # cannot prove that a server remains runnable.  Live server promotion uses
    # simpleos_server_artifact_live_receipt and an independently observed
    # scheduler start plus a correlated socket exchange.
    SimpleOsServerArtifactReceipt(
        id: artifact.id, version: artifact.version, sha256: artifact.sha256,
        filesystem_path: artifact.filesystem_path, image_id: staging.image_id,
        image_sha256: staging.image_sha256, launch_id: socket.launch_id,
        staged: true, runnable: false,
        pid: execution.pid, exit_code: execution.exit_code, reason: "completed-not-live"
    )

pub fn simpleos_server_artifact_live_receipt(
    artifact: SimpleOsServerArtifact,
    staging: SimpleOsServerArtifactReceipt,
    launch: SimpleOsServerLaunchEvidence,
    socket: SimpleOsServerSocketReceipt
) -> SimpleOsServerArtifactReceipt:
    """Promote only a still-live, image-bound filesystem launch.

    This is a correlation gate, not an observer.  The QEMU collector must obtain
    the staging, scheduler-start and socket challenge evidence independently.
    """
    val artifact_check = simpleos_server_artifact_validate(artifact)
    if not artifact_check.ok:
        return simpleos_server_artifact_staged_receipt(artifact)
    if (not staging.staged or staging.id != artifact.id or
            staging.version != artifact.version or staging.sha256 != artifact.sha256 or
            staging.filesystem_path != artifact.filesystem_path or
            staging.image_id.trim() == "" or not _is_lower_hex_sha256(staging.image_sha256)):
        var invalid_stage = staging
        invalid_stage.staged = false
        invalid_stage.runnable = false
        invalid_stage.pid = 0
        invalid_stage.exit_code = -1
        invalid_stage.launch_id = ""
        invalid_stage.reason = "staging-receipt-mismatch"
        return invalid_stage
    if (launch.filesystem_path != artifact.filesystem_path or
            launch.artifact_sha256 != artifact.sha256 or
            launch.image_id != staging.image_id or launch.image_sha256 != staging.image_sha256):
        var mismatch = staging
        mismatch.runnable = false
        mismatch.reason = "launch-artifact-image-mismatch"
        return mismatch
    if (launch.launch_id.trim() == "" or launch.pid <= 0 or
            not launch.process_registered or not launch.start_observed):
        var absent = staging
        absent.runnable = false
        absent.pid = launch.pid
        absent.reason = "filesystem-live-start-not-proven"
        return absent
    if (socket.artifact_id != artifact.id or
            socket.filesystem_path != artifact.filesystem_path or
            socket.pid != launch.pid or socket.image_id != launch.image_id or
            socket.launch_id != launch.launch_id):
        var wrong_socket = staging
        wrong_socket.runnable = false
        wrong_socket.pid = launch.pid
        wrong_socket.reason = "socket-launch-correlation-mismatch"
        return wrong_socket
    if (socket.bind_address.trim() == "" or socket.port <= 0 or socket.port > 65535 or
            socket.challenge.trim() == "" or socket.response != socket.challenge or
            socket.successful_exchanges <= 0):
        var no_socket = staging
        no_socket.runnable = false
        no_socket.pid = launch.pid
        no_socket.reason = "socket-capability-not-proven"
        return no_socket
    SimpleOsServerArtifactReceipt(
        id: artifact.id, version: artifact.version, sha256: artifact.sha256,
        filesystem_path: artifact.filesystem_path, image_id: staging.image_id,
        image_sha256: staging.image_sha256, launch_id: launch.launch_id,
        staged: true, runnable: true, pid: launch.pid, exit_code: -1,
        reason: "live-listener-proven"
    )
