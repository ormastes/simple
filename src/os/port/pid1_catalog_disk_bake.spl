# PID1 catalogue FAT32 media producer.
#
# This is intentionally separate from the legacy demo/initramfs bake.  It
# consumes only the four target-built service images and emits the exact short
# physical aliases required by the freestanding FAT32 reader before generic
# VFS service routing exists.

use std.io_runtime as io
use os.port.disk_image.{DiskImageConfig, PayloadEntry, build}

extern fn rt_file_read_bytes(path: text) -> [u8]
extern fn rt_env_get(key: text) -> text?
extern fn rt_exit(code: i32) -> void

class CatalogPayload:
    environment_key: text
    default_relative_path: text
    fat_alias: text
    physical_path: text
    canonical_path: text

fn _rootfs() -> text:
    rt_env_get("SIMPLEOS_SERVICE_CATALOG_ROOTFS") ?? "build/os/rootfs"

fn _target() -> text:
    rt_env_get("SIMPLEOS_PID1_CATALOG_TARGET") ?? "riscv64-unknown-simpleos"

fn _test_net_fault_after_ready() -> bool:
    # The producer supplies this only for the explicit QEMU test-medium path.
    # Absent or malformed values are production-safe: no fault payload marker.
    (rt_env_get("SIMPLEOS_PID1_CATALOG_TEST_NET_FAULT_AFTER_READY") ?? "false") == "true"

fn _payloads() -> [CatalogPayload]:
    [
        CatalogPayload("SIMPLEOS_SERVICE_MANAGER_BINARY", "system/service_manager.smf", "INIT    SMF", "/SYSTEM/INIT.SMF", "/system/service_manager.smf"),
        CatalogPayload("SIMPLEOS_VFS_SERVICE_BINARY", "system/services/vfs.smf", "VFS     SMF", "/SYSTEM/SERVICES/VFS.SMF", "/system/services/vfs.smf"),
        CatalogPayload("SIMPLEOS_NET_SERVICE_BINARY", "system/services/net.smf", "NET     SMF", "/SYSTEM/SERVICES/NET.SMF", "/system/services/net.smf"),
        CatalogPayload("SIMPLEOS_HTTP_SERVICE_BINARY", "system/services/http.smf", "HTTP    SMF", "/SYSTEM/SERVICES/HTTP.SMF", "/system/services/http.smf")
    ]

fn _payload_path(spec: CatalogPayload) -> text:
    val override = rt_env_get(spec.environment_key) ?? ""
    if override != "":
        return override
    _rootfs() + "/" + spec.default_relative_path

fn _expected_machine(target: text) -> i64:
    if target == "riscv64-unknown-simpleos":
        return 243
    if target == "x86_64-unknown-simpleos":
        return 62
    -1

fn _target_elf_valid(bytes: [u8], target: text) -> bool:
    val machine = _expected_machine(target)
    if machine < 0 or bytes.len() < 20u64:
        return false
    if bytes[0u64] != 0x7Fu8 or bytes[1u64] != 0x45u8 or bytes[2u64] != 0x4Cu8 or bytes[3u64] != 0x46u8:
        return false
    if bytes[4u64] != 2u8 or bytes[5u64] != 1u8:
        return false
    bytes[18u64].to_i64() + bytes[19u64].to_i64() * 256 == machine

fn _load_catalog_entry(spec: CatalogPayload, target: text) -> Result<PayloadEntry, text>:
    val host_path = _payload_path(spec)
    if not io.file_exists(host_path):
        return Err("bake: PID1 requires " + spec.canonical_path + "; missing " + host_path)
    val bytes: [u8] = rt_file_read_bytes(host_path) ?? []
    if not _target_elf_valid(bytes, target):
        return Err("bake: PID1 requires a little-endian target ELF for " + spec.canonical_path)
    Ok(PayloadEntry(path: spec.fat_alias, data: bytes, guest_path: spec.physical_path))

pub fn bake_pid1_catalog(out_disk: text) -> Result<(), text>:
    val target = _target()
    if _expected_machine(target) < 0:
        return Err("bake: unsupported PID1 catalogue target: " + target)
    io.dir_create_all("build/os")
    var nested: [PayloadEntry] = []
    var manager_bytes: [u8] = []
    var index: u64 = 0u64
    for spec in _payloads():
        match _load_catalog_entry(spec, target):
            Ok(entry):
                if index == 0u64:
                    manager_bytes = entry.data
                nested.push(entry)
            Err(reason):
                return Err(reason)
        index = index + 1u64
    if manager_bytes.len() == 0u64:
        return Err("bake: PID1 service-manager image is empty")
    # Direct boot validates VERSION.TXT and a raw ELF BROWSMF.SMF before the
    # canonical PID1 route is queried.  This duplicates the real manager ELF;
    # it is not a launcher substitute or a lifecycle marker.
    val version: [u8] = [83u8, 105u8, 109u8, 112u8, 108u8, 101u8, 79u8, 83u8, 32u8, 80u8, 73u8, 68u8, 49u8, 10u8]
    var flat: [PayloadEntry] = [
        PayloadEntry(path: "VERSION TXT", data: version, guest_path: ""),
        PayloadEntry(path: "BROWSMFSMF ", data: manager_bytes, guest_path: "")
    ]
    if _test_net_fault_after_ready():
        # Physical test-media declaration; the harness requires this sentinel
        # before it expects a crash/restart sequence from the net payload.
        flat.push(PayloadEntry(
            path: "FAULTNETCFG", data: "net-fault-after-ready\n".bytes(), guest_path: ""
        ))
    var bytes: u64 = 0u64
    for entry in flat:
        bytes = bytes + entry.data.len().to_u64()
    for entry in nested:
        bytes = bytes + entry.data.len().to_u64()
    val size_mb = (bytes + 1048575u64) / 1048576u64 + 16u64
    match build(DiskImageConfig(size_mb: size_mb, payloads: flat, nested_payloads: nested), out_disk):
        Ok(()):
            print "bake: PID1 catalogue media written " + out_disk
            Ok(())
        Err(reason): Err("bake: PID1 catalogue disk_image.build failed: " + reason)

fn main():
    val out_disk = rt_env_get("SIMPLEOS_PID1_CATALOG_DISK") ?? "build/os/fat32-riscv64-pid1.img"
    match bake_pid1_catalog(out_disk):
        Ok(()): print "bake: PID1 catalogue ready " + out_disk
        Err(reason):
            print "bake FAILED: " + reason
            rt_exit(1)
