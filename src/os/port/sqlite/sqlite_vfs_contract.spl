# SQLite-over-SimpleOS VFS shim contract (pure-Simple model).
#
# Master plan §15 makes "port SQLite over a proper SimpleOS VFS" the first DB
# milestone because it stresses locking, shm, mmap, fsync, atomic rename, WAL,
# checkpoints and crash recovery (§8 durability contract). This module is NOT
# the port. It is the typed target: a pure-Simple model of the
# `sqlite3_vfs` / `sqlite3_io_methods` surface SQLite requires, mapping each
# call to the SimpleOS VFS/POSIX facility it needs and reporting, per method,
# an honest status (supported | partial | unsupported) driven by the real
# POSIX matrix in doc/02_requirements/os/posix_profiles.md.
#
# Honest-failure rule (mirrors Lane P5 / T2-C): a facility that is absent is
# reported unsupported here — never fake-supported. Shared mmap is absent by
# design, so xShmMap fails closed, which is what correctly gates WAL mode.
#
# No live IO, no extern rt_* additions: pure model + spec target.

# ---------------------------------------------------------------------------
# SQLite file lock ladder (sqlite3.h: SQLITE_LOCK_*).
# ---------------------------------------------------------------------------
pub enum SqliteLockLevel:
    LockNone
    LockShared
    LockReserved
    LockPending
    LockExclusive

pub fn sqlite_lock_level_name(level: SqliteLockLevel) -> text:
    match level:
        SqliteLockLevel.LockNone: "NONE"
        SqliteLockLevel.LockShared: "SHARED"
        SqliteLockLevel.LockReserved: "RESERVED"
        SqliteLockLevel.LockPending: "PENDING"
        SqliteLockLevel.LockExclusive: "EXCLUSIVE"

# SimpleOS advisory locking is BSD flock() (whole-file), per posix_profiles P5
# / Lane T2-C: LOCK_SH allows many shared holders, LOCK_EX requires no other
# holder, LOCK_UN releases; no real blocking primitive (conflicts fail closed
# with EWOULDBLOCK). Whole-file flock cannot express SQLite's byte-range
# RESERVED/PENDING bytes distinctly, so those collapse onto SH/EX and the
# distinction is only tracked in-process. Mapping is honest about that.
pub fn flock_op_for(level: SqliteLockLevel) -> text:
    match level:
        SqliteLockLevel.LockNone: "LOCK_UN"
        SqliteLockLevel.LockShared: "LOCK_SH"
        SqliteLockLevel.LockReserved: "LOCK_SH"
        SqliteLockLevel.LockPending: "LOCK_EX"
        SqliteLockLevel.LockExclusive: "LOCK_EX"

# True when the flock op is an exact whole-file equivalent of the SQLite level.
# RESERVED/PENDING are approximations (whole-file flock has no byte ranges).
pub fn flock_mapping_is_exact(level: SqliteLockLevel) -> bool:
    match level:
        SqliteLockLevel.LockNone: true
        SqliteLockLevel.LockShared: true
        SqliteLockLevel.LockReserved: false
        SqliteLockLevel.LockPending: false
        SqliteLockLevel.LockExclusive: true

# ---------------------------------------------------------------------------
# Underlying POSIX / block facility statuses (the real matrix, P5 + T2-C).
# ---------------------------------------------------------------------------
pub fn posix_flock_status() -> text:
    # Lane T2-C: real in-process advisory lock table, no blocking primitive.
    "partial"

pub fn posix_mmap_private_status() -> text:
    # MAP_PRIVATE anonymous: implemented (real syscall path).
    "supported"

pub fn posix_mmap_shared_status() -> text:
    # MAP_SHARED / file-backed: absent by design, fails closed EOPNOTSUPP.
    "unsupported"

pub fn posix_shm_status() -> text:
    # shm_open / shmget / shmat: absent (no symbols).
    "unsupported"

pub fn block_flush_status() -> text:
    # block_cache.flush_all exists; full §8 ordering/FUA/dir-fsync/torn-write
    # /power-loss recovery not yet proven, so the sync guarantee is partial.
    "partial"

# ---------------------------------------------------------------------------
# Durability characteristics the block layer currently publishes (§8 contract).
# These feed SQLite xSectorSize / xDeviceCharacteristics. Only what is actually
# published is reported true; unproven guarantees stay false (honest default).
# ---------------------------------------------------------------------------
pub struct BlockDurabilityFlags:
    sector_size: u32
    has_flush: bool             # fsync/flush path exists (block_cache.flush_all)
    has_atomic_write: bool      # SQLITE_IOCAP_ATOMIC family
    has_safe_append: bool       # SQLITE_IOCAP_SAFE_APPEND
    has_sequential: bool        # SQLITE_IOCAP_SEQUENTIAL
    powersafe_overwrite: bool   # SQLITE_IOCAP_POWERSAFE_OVERWRITE

pub fn published_durability_flags() -> BlockDurabilityFlags:
    BlockDurabilityFlags(
        sector_size: 512,
        has_flush: true,
        has_atomic_write: false,
        has_safe_append: false,
        has_sequential: false,
        powersafe_overwrite: false
    )

# ---------------------------------------------------------------------------
# Per-method contract report.
# ---------------------------------------------------------------------------
pub struct VfsMethodReport:
    method: text
    sosix_facility: text
    status: text        # "supported" | "partial" | "unsupported"
    reason: text

pub fn xopen_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xOpen",
        sosix_facility: "VFS open(path, flags) -> handle",
        status: "supported",
        reason: "FsDriver.open maps directly; O_CREAT/O_EXCL via FileFlags."
    )

pub fn xclose_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xClose",
        sosix_facility: "VFS close(handle)",
        status: "supported",
        reason: "FsDriver.close maps directly."
    )

pub fn xread_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xRead",
        sosix_facility: "VFS seek + read(handle, size)",
        status: "supported",
        reason: "FsDriver.seek then read; short read padded to SQLITE_IOERR_SHORT_READ."
    )

pub fn xwrite_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xWrite",
        sosix_facility: "VFS seek + write(handle, data)",
        status: "supported",
        reason: "FsDriver.seek then write."
    )

pub fn xtruncate_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xTruncate",
        sosix_facility: "VFS truncate(handle, size) — ABSENT in FsDriver trait",
        status: "unsupported",
        reason: "FsDriver surface exposes no truncate op. Blocks PRAGMA journal_mode=TRUNCATE only; default DELETE journal deletes the journal via xDelete and is unaffected."
    )

pub fn xsync_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xSync",
        sosix_facility: "block_cache flush / fsync + §8 flush-ordering guarantee",
        status: block_flush_status(),
        reason: "flush path exists; full §8 data-vs-metadata ordering, FUA, dir fsync, torn-write detection and power-loss recovery not yet proven."
    )

pub fn xfilesize_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xFileSize",
        sosix_facility: "VFS stat(path).size",
        status: "supported",
        reason: "FsNode size from stat."
    )

pub fn xlock_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xLock",
        sosix_facility: "flock LOCK_SH / LOCK_EX",
        status: posix_flock_status(),
        reason: "advisory flock table works, but whole-file flock cannot represent RESERVED/PENDING byte ranges and has no blocking (conflict fails closed EWOULDBLOCK)."
    )

pub fn xunlock_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xUnlock",
        sosix_facility: "flock LOCK_UN / downgrade to LOCK_SH",
        status: posix_flock_status(),
        reason: "release/downgrade via flock; downgrade EX->SH is a release+reacquire, not atomic."
    )

pub fn xcheckreservedlock_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xCheckReservedLock",
        sosix_facility: "flock holder query (in-process table)",
        status: posix_flock_status(),
        reason: "in-process table answers within one node; RESERVED is not distinguishable from SHARED at the whole-file flock layer."
    )

pub fn xfilecontrol_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xFileControl",
        sosix_facility: "opcode passthrough (SQLITE_FCNTL_*)",
        status: "partial",
        reason: "a subset (SIZE_HINT, HAS_MOVED, no-ops) is handled; unknown opcodes return SQLITE_NOTFOUND honestly."
    )

pub fn xsectorsize_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xSectorSize",
        sosix_facility: "block layer sector_size",
        status: "supported",
        reason: "returns the published BlockDurabilityFlags.sector_size."
    )

pub fn xdevicecharacteristics_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xDeviceCharacteristics",
        sosix_facility: "block layer durability flags (SQLITE_IOCAP_*)",
        status: "partial",
        reason: "only sector size is published; atomic-write / safe-append / sequential / powersafe-overwrite flags are not proven, so the method returns 0 for those bits (conservative, correct for durability)."
    )

pub fn xshm_map_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xShmMap",
        sosix_facility: "shared mmap (MAP_SHARED / shm_open) for the -wal-index",
        status: posix_mmap_shared_status(),
        reason: "MAP_SHARED and shm_open are absent by design and fail closed EOPNOTSUPP (posix_profiles P5). WAL's cross-process wal-index requires shared memory; reporting supported here would be dishonest and would let WAL corrupt."
    )

pub fn xshm_lock_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xShmLock",
        sosix_facility: "locks over the shared wal-index region",
        status: posix_mmap_shared_status(),
        reason: "depends on the shared mmap region that does not exist."
    )

pub fn xshm_barrier_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xShmBarrier",
        sosix_facility: "memory barrier over the shared wal-index region",
        status: posix_mmap_shared_status(),
        reason: "no shared region to barrier over."
    )

pub fn xshm_unmap_report() -> VfsMethodReport:
    VfsMethodReport(
        method: "xShmUnmap",
        sosix_facility: "unmap the shared wal-index region",
        status: posix_mmap_shared_status(),
        reason: "no shared region to unmap."
    )

pub fn all_method_reports() -> [VfsMethodReport]:
    [
        xopen_report(),
        xclose_report(),
        xread_report(),
        xwrite_report(),
        xtruncate_report(),
        xsync_report(),
        xfilesize_report(),
        xlock_report(),
        xunlock_report(),
        xcheckreservedlock_report(),
        xfilecontrol_report(),
        xsectorsize_report(),
        xdevicecharacteristics_report(),
        xshm_map_report(),
        xshm_lock_report(),
        xshm_barrier_report(),
        xshm_unmap_report()
    ]

pub fn method_report(name: text) -> VfsMethodReport:
    for r in all_method_reports():
        if r.method == name:
            return r
    VfsMethodReport(
        method: name,
        sosix_facility: "unknown",
        status: "unsupported",
        reason: "no such method modeled."
    )

pub fn count_with_status(s: text) -> i32:
    var n = 0
    for r in all_method_reports():
        if r.status == s:
            n = n + 1
    n

# ---------------------------------------------------------------------------
# SQLite journal-mode gating, driven honestly by the method statuses.
# ---------------------------------------------------------------------------

# DELETE (rollback-journal) mode critical path — does NOT need xTruncate or shm.
pub fn rollback_journal_critical_methods() -> [text]:
    [
        "xOpen",
        "xClose",
        "xRead",
        "xWrite",
        "xSync",
        "xFileSize",
        "xLock",
        "xUnlock",
        "xCheckReservedLock",
        "xSectorSize"
    ]

# Supported iff no critical-path method is unsupported. (Partial is acceptable:
# functional today, with the §8 durability-proof caveat carried separately.)
pub fn rollback_journal_mode_supported() -> bool:
    for name in rollback_journal_critical_methods():
        if method_report(name).status == "unsupported":
            return false
    true

# WAL mode requires the shared-memory wal-index (xShmMap). Gated directly on
# that method's honest status: unsupported -> WAL blocked.
pub fn wal_mode_supported() -> bool:
    xshm_map_report().status == "supported"

# The exact prerequisite WAL is waiting on.
pub fn wal_blocked_prerequisite() -> text:
    "shared mmap (MAP_SHARED / shm_open) for the -wal-index — POSIX Profile C facility, currently absent by design (fails closed EOPNOTSUPP, posix_profiles P5)."
