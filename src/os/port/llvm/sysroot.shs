#!/bin/sh
# Package SimpleOS sysroot for LLVM/Clang/Rust cross-compilation
#
# Layout:
#   sysroot/
#     include/              — C headers (simpleos_libc.h)
#     lib/                  — Static libraries (libsimpleos_c.a, crt0.o, compiler-rt)
#     lib/clang/<ver>/lib/  — Clang resource dir (compiler-rt builtins)
#     share/simpleos/       — Linker scripts
#
# Usage:
#   sh src/os/port/llvm/sysroot.shs
#
# Output: build/os/sysroot/

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
LIBC_DIR="$REPO_ROOT/src/os/libc"
LLVM_BUILD="$REPO_ROOT/build/os/llvm"
LLVM_SRC="${LLVM_SRC:-$HOME/llvm-project}"
TRIPLE="${SIMPLEOS_TARGET_TRIPLE:-${SIMPLE_TARGET:-x86_64-unknown-simpleos}}"
# Per-arch sysroot, matching simpleos_sysroot_dir() in
# src/compiler_rust/compiler/src/pipeline/native_project/linker.rs: x86_64 keeps
# the historical unsuffixed path, aarch64 gets its own. Before this, an aarch64
# run of this script wrote into the x86_64 sysroot — clobbering it while
# producing nothing at the path the linker actually reads for aarch64.
case "$TRIPLE" in
    aarch64-*) SYSROOT="${SIMPLEOS_SYSROOT:-$REPO_ROOT/build/os/sysroot-aarch64}" ;;
    *)         SYSROOT="$REPO_ROOT/build/os/sysroot" ;;
esac
LIBC_BUILD="$REPO_ROOT/build/os/libc-$TRIPLE"
LIBCXX_BUILD="$REPO_ROOT/build/os/libcxx-$TRIPLE"

echo "[sysroot] Building SimpleOS sysroot at $SYSROOT ..."

# Create layout
mkdir -p "$SYSROOT/include"
mkdir -p "$SYSROOT/lib"
mkdir -p "$SYSROOT/share/simpleos"
printf '%s\n' "$TRIPLE" > "$SYSROOT/share/simpleos/target-triple.txt"

# -- Headers ----------------------------------------------------------------

cp "$LIBC_DIR/simpleos_libc.h" "$SYSROOT/include/"

# Copy full include/ tree (signal.h, stdlib.h, sys/types.h, c++/, etc.)
if [ -d "$LIBC_DIR/include" ]; then
    cp -R "$LIBC_DIR/include/"* "$SYSROOT/include/"
    # Ensure subdirectories are present
    for subdir in sys netinet c++; do
        if [ -d "$LIBC_DIR/include/$subdir" ]; then
            mkdir -p "$SYSROOT/include/$subdir"
            cp -R "$LIBC_DIR/include/$subdir/"* "$SYSROOT/include/$subdir/"
        fi
    done
fi

if [ -d "$LLVM_SRC/libcxx/include" ]; then
    mkdir -p "$SYSROOT/include/c++/v1"
    cp -R "$LLVM_SRC/libcxx/include/"* "$SYSROOT/include/c++/v1/"
    cat > "$SYSROOT/include/c++/v1/__config_site" << 'CONFIGEOF'
#define _LIBCPP_HAS_THREADS 1
#define _LIBCPP_HAS_CLOCK_GETTIME 1
#define _LIBCPP_HAS_MONOTONIC_CLOCK 1
#define _LIBCPP_HAS_THREAD_API_PTHREAD 1
#define _LIBCPP_HAS_THREAD_API_EXTERNAL 0
#define _LIBCPP_HAS_THREAD_API_WIN32 0
#define _LIBCPP_HAS_RANDOM_DEVICE 1
#define _LIBCPP_HAS_LOCALIZATION 0
#define _LIBCPP_HAS_WIDE_CHARACTERS 1
#define _LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE 1
#define _LIBCPP_PSTL_BACKEND_SERIAL 1
#define _LIBCPP_HARDENING_MODE_DEFAULT (1 << 1)
CONFIGEOF
    if [ -f "$LLVM_SRC/libcxx/vendor/llvm/default_assertion_handler.in" ]; then
        cp "$LLVM_SRC/libcxx/vendor/llvm/default_assertion_handler.in" "$SYSROOT/include/c++/v1/__assertion_handler"
    fi
    echo "[sysroot] Installed libc++ headers"
else
    echo "[sysroot] NOTE: libc++ headers not found at $LLVM_SRC/libcxx/include"
fi

install_compiler_builtins_seed() {
    case "$TRIPLE" in
        aarch64-*)
            for candidate in \
                /usr/lib/android-sdk/ndk/*/toolchains/llvm/prebuilt/linux-x86_64/lib/clang/*/lib/baremetal/libclang_rt.builtins-aarch64.a \
                /usr/lib/gcc-cross/aarch64-linux-gnu/*/libgcc.a
            do
                if [ -f "$candidate" ]; then
                    cp "$candidate" "$SYSROOT/lib/libclang_rt.builtins-aarch64.a"
                    echo "[sysroot] Installed aarch64 compiler builtins seed"
                    return
                fi
            done
            echo "[sysroot] NOTE: aarch64 compiler builtins seed not found"
            ;;
    esac
}

# Count headers for verification
HEADER_COUNT=$(find "$SYSROOT/include" -name "*.h" -o -name "*.hpp" 2>/dev/null | wc -l | tr -d ' ')
echo "[sysroot] Installed $HEADER_COUNT headers"

# -- Libc -------------------------------------------------------------------

build_libc_runtime() {
    case "$TRIPLE" in
        x86_64-*)
            if [ ! -f "$LIBC_DIR/libsimpleos_c.a" ]; then
                echo "[sysroot] Building SimpleOS libc..."
                (cd "$LIBC_DIR" && make)
            fi
            cp "$LIBC_DIR/libsimpleos_c.a" "$SYSROOT/lib/libsimpleos_c.a"
            cp "$LIBC_DIR/simpleos_crt0.o" "$SYSROOT/lib/crt0.o"
            "${CC:-clang}" --target=x86_64-unknown-none-elf \
                -ffreestanding -nostdlib -fno-builtin -mno-red-zone \
                -fno-stack-protector -ffunction-sections -fdata-sections -O2 \
                -c "$LIBC_DIR/simpleos_entry.c" -o "$SYSROOT/lib/simple_entry.o"
            echo "[sysroot] Building SimpleOS Simple runtime ABI..."
            mkdir -p "$LIBC_BUILD"
            CC="${CC:-clang}"
            AR="${AR:-llvm-ar}"
            if ! command -v "$AR" >/dev/null 2>&1; then
                AR=ar
            fi
            "$CC" --target=x86_64-unknown-none-elf \
                -ffreestanding -nostdlib -fno-builtin -mno-red-zone \
                -fno-stack-protector -fno-exceptions -fno-unwind-tables \
                -fno-asynchronous-unwind-tables -ffunction-sections \
                -fdata-sections -O2 -Wall -Wextra -Wno-unused-parameter \
                -I "$LIBC_DIR/include" \
                -c "$LIBC_DIR/simpleos_simple_runtime.c" \
                -o "$LIBC_BUILD/simpleos_simple_runtime.o"
            rm -f "$SYSROOT/lib/libsimple_runtime_compat.a" "$SYSROOT/lib/libsimple_runtime.a"
            "$AR" rcs "$SYSROOT/lib/libsimple_runtime_compat.a" "$LIBC_BUILD/simpleos_simple_runtime.o"
            cp "$SYSROOT/lib/libsimple_runtime_compat.a" "$SYSROOT/lib/libsimple_runtime.a"

            # -- Real Simple runtime, cross-compiled for SimpleOS ------------
            # The compat shim above defines only 21 symbols and had drifted far
            # behind the symbol set the compiler actually emits, which broke the
            # SimpleOS payload link with 20 undefined rt_* symbols. This builds
            # the GENUINE runtime from src/runtime/*.c against the SimpleOS
            # sysroot headers instead of hand-maintaining a subset.
            #
            # One object per source file, deliberately: archive members are the
            # linker's granularity, so keeping them split means a reference to
            # (say) rt_sort does not drag in the socket/DNS code. Do NOT
            # partial-link (ld -r) these into a single blob, and do NOT merge
            # them into libsimpleos_c.a — a plain C/C++ link must never pull the
            # Simple runtime in. See
            # doc/08_tracking/bug/simpleos_libc_leaks_simple_runtime_syms_2026-08-06.md
            echo "[sysroot] Cross-compiling real Simple runtime for $TRIPLE..."
            RT_BUILD="$LIBC_BUILD/simple_runtime_native"
            mkdir -p "$RT_BUILD"
            RT_CFLAGS="--target=x86_64-unknown-none-elf -ffreestanding -nostdlib \
                -nostdlibinc -fno-builtin -mno-red-zone -fno-stack-protector \
                -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables \
                -ffunction-sections -fdata-sections -O2 -D__simpleos__=1 \
                -isystem $LIBC_DIR/include"
            RT_OBJS=""
            # startup/baremetal/runtime_log provides the real UART emitter
            # (rt_simpleos_log_emit + rt_log_target_device_write_bytes). On
            # x86_64 its COM1 path calls rt_port_outb/rt_port_inb, so
            # startup/baremetal/runtime_port_io must be built alongside it --
            # that TU is the single global owner of the rt_port_* family
            # (moved out of startup/baremetal/runtime_minimal.c on 2026-08-10,
            # which cannot be added here because its rt_read_cr3 /
            # rt_write_cr3 / rt_invlpg / rt_volatile_{read,write}_u{8,16,32,64}
            # would collide with runtime_native.o in this same archive).
            # runtime_native.c defines no rt_port_* at all, so there is no ODR
            # overlap. See
            # doc/08_tracking/bug/logging_surfaces_that_suppress_errors_by_default_family_2026-08-10.md
            for rt_src in runtime_native runtime_simd_utf8 runtime_contracts \
                          runtime_memory runtime_time runtime_timestamp \
                          runtime_pool runtime_memtrack \
                          runtime_simpleos_syscall_adapters \
                          startup/baremetal/runtime_port_io \
                          startup/baremetal/runtime_log
            do
                rt_obj="$RT_BUILD/$(basename "$rt_src").o"
                "$CC" $RT_CFLAGS -c "$REPO_ROOT/src/runtime/$rt_src.c" \
                    -o "$rt_obj" || {
                        echo "[sysroot] ERROR: failed to cross-compile $rt_src.c" >&2
                        exit 1
                    }
                RT_OBJS="$RT_OBJS $rt_obj"
            done
            rm -f "$SYSROOT/lib/libsimple_runtime_native.a"
            "$AR" rcs "$SYSROOT/lib/libsimple_runtime_native.a" $RT_OBJS
            echo "[sysroot] Built libsimple_runtime_native.a ($(echo $RT_OBJS | wc -w) members)"
            ;;
        aarch64-*)
            echo "[sysroot] Building SimpleOS libc for $TRIPLE..."
            mkdir -p "$LIBC_BUILD"
            CC="${CC:-clang}"
            AR="${AR:-llvm-ar}"
            if ! command -v "$AR" >/dev/null 2>&1; then
                AR=ar
            fi
            CFLAGS="--target=$TRIPLE --sysroot=$SYSROOT -ffreestanding -nostdlib -fno-builtin -fno-stack-protector -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -O2 -Wall -Wextra -Wno-unused-parameter -D__simpleos__=1 -I$LIBC_DIR/include"
            for src in \
                simpleos_libc.c simpleos_cli_args.c simpleos_math.c simpleos_math_ext.c simpleos_fs.c \
                simpleos_pthread.c simpleos_alloc.c simpleos_process.c \
                simpleos_string_ext.c simpleos_stdlib_ext.c \
                simpleos_time.c simpleos_printf_float.c simpleos_cxxabi.c \
                simpleos_dlmalloc.c simpleos_signal.c simpleos_libc_ext.c \
                simpleos_poll.c simpleos_process_wait.c \
                simpleos_pthread_rwlock.c simpleos_pthread_cond.c \
                simpleos_sched.c simpleos_epoll.c simpleos_eventfd.c \
                simpleos_timerfd.c simpleos_signalfd.c simpleos_inotify.c \
                simpleos_fs_walk.c simpleos_glob_stub.c simpleos_pwd_stub.c \
                simpleos_strfmon.c simpleos_fork.c simpleos_ipc.c \
                simpleos_socket.c simpleos_filelock.c simpleos_statvfs.c \
                simpleos_utsname.c simpleos_termios.c
            do
                "$CC" $CFLAGS -c "$LIBC_DIR/$src" -o "$LIBC_BUILD/${src%.c}.o"
            done
            cat > "$LIBC_BUILD/simpleos_setjmp_aarch64.S" << 'ASMEOF'
.section .text
.global setjmp
.type setjmp, %function
setjmp:
    stp x19, x20, [x0, #0]
    stp x21, x22, [x0, #16]
    stp x23, x24, [x0, #32]
    stp x29, x30, [x0, #48]
    mov x1, sp
    str x1, [x0, #64]
    mov x0, #0
    ret
.size setjmp, . - setjmp

.global _setjmp
.type _setjmp, %function
_setjmp:
    b setjmp
.size _setjmp, . - _setjmp

.global longjmp
.type longjmp, %function
longjmp:
    ldp x19, x20, [x0, #0]
    ldp x21, x22, [x0, #16]
    ldp x23, x24, [x0, #32]
    ldp x29, x30, [x0, #48]
    ldr x2, [x0, #64]
    mov sp, x2
    mov x0, x1
    cmp x0, #0
    cinc x0, x0, eq
    ret
.size longjmp, . - longjmp

.global _longjmp
.type _longjmp, %function
_longjmp:
    b longjmp
.size _longjmp, . - _longjmp
ASMEOF
            # Keep one authoritative AArch64 startup implementation.  The
            # canonical CRT validates and publishes the kernel-provided
            # argc/argv/envp stack before constructors or user code execute.
            "$CC" --target="$TRIPLE" -ffreestanding -nostdlib -c "$LIBC_DIR/simpleos_crt0_aarch64.S" -o "$LIBC_BUILD/simpleos_crt0.o"
            "$CC" --target="$TRIPLE" -ffreestanding -nostdlib -c "$LIBC_DIR/simpleos_syscall_aarch64.S" -o "$LIBC_BUILD/simpleos_syscall.o"
            "$CC" --target="$TRIPLE" -ffreestanding -nostdlib -c "$LIBC_BUILD/simpleos_setjmp_aarch64.S" -o "$LIBC_BUILD/simpleos_setjmp.o"
            rm -f "$SYSROOT/lib/libsimpleos_c.a"
            "$AR" rcs "$SYSROOT/lib/libsimpleos_c.a" "$LIBC_BUILD"/*.o
            cp "$LIBC_BUILD/simpleos_crt0.o" "$SYSROOT/lib/crt0.o"

            # -- Simple runtime ABI + real Simple C runtime ------------------
            # Third arch of the same defect family: this branch built libc and
            # three .S files and NOTHING for the Simple runtime, so the aarch64
            # payload could not link (x86_64 fixed in
            # doc/08_tracking/bug/simpleos_payload_link_missing_20_rt_symbols_2026-08-06.md,
            # riscv64 in scripts/os/simpleos-sysroot-riscv64.shs).
            #
            # Everything below builds into SUBDIRECTORIES of $LIBC_BUILD on
            # purpose: libsimpleos_c.a above is `ar`'d from "$LIBC_BUILD"/*.o,
            # which does not recurse. A top-level object here would leak the
            # Simple runtime into plain C/C++ links — the exact bug in
            # doc/08_tracking/bug/simpleos_libc_leaks_simple_runtime_syms_2026-08-06.md.
            ENTRY_BUILD="$LIBC_BUILD/entry"
            rm -rf "$ENTRY_BUILD"; mkdir -p "$ENTRY_BUILD"
            "$CC" $CFLAGS -ffunction-sections -fdata-sections \
                -c "$LIBC_DIR/simpleos_entry.c" \
                -o "$SYSROOT/lib/simple_entry.o"
            echo "[sysroot] Building SimpleOS Simple runtime ABI for $TRIPLE..."
            "$CC" $CFLAGS -ffunction-sections -fdata-sections \
                -c "$LIBC_DIR/simpleos_simple_runtime.c" \
                -o "$ENTRY_BUILD/simpleos_simple_runtime.o"
            rm -f "$SYSROOT/lib/libsimple_runtime_compat.a" "$SYSROOT/lib/libsimple_runtime.a"
            "$AR" rcs "$SYSROOT/lib/libsimple_runtime_compat.a" "$ENTRY_BUILD/simpleos_simple_runtime.o"
            cp "$SYSROOT/lib/libsimple_runtime_compat.a" "$SYSROOT/lib/libsimple_runtime.a"

            # One object per source file, deliberately: archive members are the
            # linker's granularity, so a reference to one runtime entry point
            # does not drag the rest in. Do NOT partial-link (ld -r) these, and
            # do NOT merge them into libsimpleos_c.a.
            echo "[sysroot] Cross-compiling real Simple runtime for $TRIPLE..."
            RT_BUILD="$LIBC_BUILD/simple_runtime_native"
            rm -rf "$RT_BUILD"; mkdir -p "$RT_BUILD"
            RT_CFLAGS="--target=$TRIPLE -ffreestanding -nostdlib -nostdlibinc \
                -fno-builtin -fno-stack-protector -fno-exceptions \
                -fno-unwind-tables -fno-asynchronous-unwind-tables \
                -ffunction-sections -fdata-sections -O2 -D__simpleos__=1 \
                -isystem $LIBC_DIR/include"
            RT_OBJS=""
            for rt_src in runtime_native runtime_simd_utf8 runtime_contracts \
                          runtime_memory runtime_time runtime_timestamp \
                          runtime_pool runtime_memtrack \
                          runtime_simpleos_syscall_adapters \
                          startup/baremetal/runtime_log
            do
                rt_obj="$RT_BUILD/$(basename "$rt_src").o"
                "$CC" $RT_CFLAGS -c "$REPO_ROOT/src/runtime/$rt_src.c" \
                    -o "$rt_obj" || {
                        echo "[sysroot] ERROR: failed to cross-compile $rt_src.c" >&2
                        exit 1
                    }
                RT_OBJS="$RT_OBJS $rt_obj"
            done
            rm -f "$SYSROOT/lib/libsimple_runtime_native.a"
            "$AR" rcs "$SYSROOT/lib/libsimple_runtime_native.a" $RT_OBJS
            echo "[sysroot] Built libsimple_runtime_native.a ($(echo $RT_OBJS | wc -w) members)"
            ;;
        *)
            echo "[sysroot] ERROR: libc runtime build is not wired for $TRIPLE" >&2
            exit 1
            ;;
    esac
}

build_libc_runtime
echo "[sysroot] Installed libsimpleos_c.a"
cp "$SYSROOT/lib/libsimpleos_c.a" "$SYSROOT/lib/libm.a"
echo "[sysroot] Installed libm.a"
install_compiler_builtins_seed

# -- libc++ runtime ----------------------------------------------------------

build_libcxx_runtime() {
    if [ ! -d "$LLVM_SRC/libcxx/src" ]; then
        echo "[sysroot] NOTE: libc++ sources not found at $LLVM_SRC/libcxx/src"
        return
    fi

    echo "[sysroot] Building libc++.a for $TRIPLE..."
    mkdir -p "$LIBCXX_BUILD"

    CXX="${CXX:-clang++}"
    AR="${AR:-llvm-ar}"
    if ! command -v "$AR" >/dev/null 2>&1; then
        AR=ar
    fi

    LIBCXX_FLAGS="--target=$TRIPLE --sysroot=$SYSROOT -std=c++23 -ffreestanding -nostdlib -nostdinc++ -fno-exceptions -fno-rtti -fvisibility=hidden -fvisibility-inlines-hidden -fsized-deallocation -D__simpleos__=1 -DLIBC_NAMESPACE=__llvm_libc -D_LIBCPP_BUILDING_LIBRARY -D_LIBCPP_BUILDING_HAS_NO_ABI_LIBRARY -D_LIBCPP_REMOVE_TRANSITIVE_INCLUDES -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS= -D_LIBCPP_PSTL_BACKEND_SERIAL=1 -D_LIBCPP_HAS_CLOCK_GETTIME=1 -I$LLVM_SRC/libcxx/src -I$LLVM_SRC/libc -isystem $SYSROOT/include/c++/v1 -isystem $SYSROOT/include"

    for src in \
        algorithm.cpp any.cpp bind.cpp call_once.cpp charconv.cpp chrono.cpp \
        error_category.cpp exception.cpp expected.cpp \
        filesystem/filesystem_clock.cpp filesystem/filesystem_error.cpp \
        filesystem/path.cpp functional.cpp hash.cpp memory.cpp \
        memory_resource.cpp new_handler.cpp new_helpers.cpp optional.cpp \
        print.cpp random.cpp random_shuffle.cpp ryu/d2fixed.cpp ryu/d2s.cpp \
        ryu/f2s.cpp stdexcept.cpp string.cpp system_error.cpp typeinfo.cpp \
        valarray.cpp variant.cpp vector.cpp verbose_abort.cpp \
        atomic.cpp barrier.cpp condition_variable_destructor.cpp \
        condition_variable.cpp future.cpp mutex_destructor.cpp mutex.cpp \
        shared_mutex.cpp thread.cpp
    do
        obj="$LIBCXX_BUILD/$(printf '%s' "$src" | tr '/.' '__').o"
        mkdir -p "$(dirname "$obj")"
        "$CXX" $LIBCXX_FLAGS -c "$LLVM_SRC/libcxx/src/$src" -o "$obj"
    done

    rm -f "$SYSROOT/lib/libc++.a"
    "$AR" rcs "$SYSROOT/lib/libc++.a" "$LIBCXX_BUILD"/*.o
    echo "[sysroot] Installed libc++.a"
}

build_libcxx_runtime

# -- libc++abi / libunwind (no-exceptions config) ----------------------------
# clang_static.shs's link line requires these two archives to exist. Every
# object clang_static links was compiled -fno-exceptions, so the "real"
# unwinder is never invoked at runtime; what's needed is only the ABI-level
# symbol set libc++.a references (__cxa_guard_*, __cxa_atexit helpers,
# type_info RTTI comparison, demangler, etc.), built from libcxxabi's own
# LIBCXXABI_ENABLE_EXCEPTIONS=OFF source list (see
# $LLVM_SRC/libcxxabi/src/CMakeLists.txt) so no cxa_exception.cpp /
# cxa_personality.cpp (the real Itanium unwind path) is pulled in.
build_libcxxabi_runtime() {
    if [ ! -d "$LLVM_SRC/libcxxabi/src" ]; then
        echo "[sysroot] NOTE: libcxxabi sources not found at $LLVM_SRC/libcxxabi/src"
        return
    fi
    echo "[sysroot] Building libc++abi.a (no-exceptions) for $TRIPLE..."
    LIBCXXABI_BUILD="$REPO_ROOT/build/os/libcxxabi-$TRIPLE"
    mkdir -p "$LIBCXXABI_BUILD"
    CXX="${CXX:-clang++}"
    AR="${AR:-llvm-ar}"
    command -v "$AR" >/dev/null 2>&1 || AR=ar
    LIBCXXABI_FLAGS="--target=$TRIPLE --sysroot=$SYSROOT -std=c++23 -ffreestanding -nostdlib -nostdinc++ -fno-exceptions -fno-rtti -fvisibility=hidden -fvisibility-inlines-hidden -fstrict-aliasing -D__simpleos__=1 -D_LIBCPP_BUILDING_LIBRARY -DHAVE___CXA_THREAD_ATEXIT_IMPL=0 -I$LLVM_SRC/libcxxabi/include -I$LLVM_SRC/libcxxabi/src -I$LLVM_SRC/libcxx/src -isystem $SYSROOT/include/c++/v1 -isystem $SYSROOT/include"
    for src in \
        cxa_aux_runtime.cpp cxa_default_handlers.cpp cxa_demangle.cpp \
        cxa_exception_storage.cpp cxa_guard.cpp cxa_handlers.cpp \
        cxa_vector.cpp cxa_virtual.cpp cxa_noexception.cpp \
        stdlib_exception.cpp stdlib_stdexcept.cpp stdlib_typeinfo.cpp \
        abort_message.cpp fallback_malloc.cpp private_typeinfo.cpp
    do
        obj="$LIBCXXABI_BUILD/$(printf '%s' "$src" | tr '/.' '__').o"
        # private_typeinfo.cpp IMPLEMENTS the RTTI comparison runtime itself
        # (dynamic_cast/typeid on __class_type_info etc.), so it needs -frtti
        # even though every consumer of libc++abi is built -fno-rtti.
        # libcxxabi's own CMakeLists forces this per-file too.
        PERFILE_FLAGS="$LIBCXXABI_FLAGS"
        case "$src" in
            private_typeinfo.cpp) PERFILE_FLAGS="$(printf '%s' "$LIBCXXABI_FLAGS" | sed 's/-fno-rtti/-frtti/')" ;;
        esac
        "$CXX" $PERFILE_FLAGS -c "$LLVM_SRC/libcxxabi/src/$src" -o "$obj"
    done
    rm -f "$SYSROOT/lib/libc++abi.a"
    "$AR" rcs "$SYSROOT/lib/libc++abi.a" "$LIBCXXABI_BUILD"/*.o
    echo "[sysroot] Installed libc++abi.a"
}

# libunwind: with every object -fno-exceptions, nothing in the closure calls
# a real _Unwind_* entry point (verified: cxa_noexception.cpp only touches the
# _Unwind_Exception *type*, never links against libunwind symbols — see
# doc/08_tracking/bug for the B1 witness lane). clang_static.shs's link line
# still names libunwind.a explicitly inside --start-group/--end-group, so an
# archive must exist; ld treats an archive that resolves nothing as a no-op.
# Building it for real (rather than shipping an empty archive) costs little
# and removes the risk that some clang/LLVM TU does reference a real
# _Unwind_* symbol, so it is built from libunwind's own source list.
build_libunwind_runtime() {
    if [ ! -d "$LLVM_SRC/libunwind/src" ]; then
        echo "[sysroot] NOTE: libunwind sources not found at $LLVM_SRC/libunwind/src"
        return
    fi
    echo "[sysroot] Building libunwind.a for $TRIPLE..."
    LIBUNWIND_BUILD="$REPO_ROOT/build/os/libunwind-$TRIPLE"
    mkdir -p "$LIBUNWIND_BUILD"
    CXX="${CXX:-clang++}"
    CC="${CC:-clang}"
    AR="${AR:-llvm-ar}"
    command -v "$AR" >/dev/null 2>&1 || AR=ar
    LIBUNWIND_FLAGS="--target=$TRIPLE --sysroot=$SYSROOT -ffreestanding -nostdlib -nostdinc++ -fno-exceptions -fno-rtti -fvisibility=hidden -fvisibility-inlines-hidden -D__simpleos__=1 -D_LIBUNWIND_IS_BAREMETAL -D_LIBUNWIND_HAS_NO_THREADS -I$LLVM_SRC/libunwind/include -isystem $SYSROOT/include"
    for src in libunwind.cpp UnwindLevel1.c UnwindLevel1-gcc-ext.c Unwind-sjlj.c; do
        obj="$LIBUNWIND_BUILD/$(printf '%s' "$src" | tr '/.' '__').o"
        case "$src" in
            *.cpp) "$CXX" -std=c++17 $LIBUNWIND_FLAGS -c "$LLVM_SRC/libunwind/src/$src" -o "$obj" ;;
            *.c)   "$CC" $LIBUNWIND_FLAGS -c "$LLVM_SRC/libunwind/src/$src" -o "$obj" ;;
        esac
    done
    rm -f "$SYSROOT/lib/libunwind.a"
    "$AR" rcs "$SYSROOT/lib/libunwind.a" "$LIBUNWIND_BUILD"/*.o
    echo "[sysroot] Installed libunwind.a"
}

build_libcxxabi_runtime
build_libunwind_runtime

# -- CRT objects ------------------------------------------------------------

echo "[sysroot] Installed crt0.o"

# -- Compiler-rt builtins (if available) ------------------------------------

if [ -d "$LLVM_BUILD/compiler-rt" ]; then
    find "$LLVM_BUILD/compiler-rt" -name "*.a" -exec cp {} "$SYSROOT/lib/" \;
    echo "[sysroot] Installed compiler-rt builtins"
else
    echo "[sysroot] NOTE: compiler-rt not yet built — run build.shs compiler-rt later"
fi

# -- Linker script ----------------------------------------------------------

cat > "$SYSROOT/share/simpleos/simpleos.ld" << 'LDEOF'
/* SimpleOS x86_64 userspace linker script
 *
 * Text starts at 0x40000000 (1 GiB). Relocated out of [0x08000000,~0x16400000)
 * so the ring-3 payload never overlaps the kernel .bss band when the kernel is
 * linked at the 128 MiB base required for GRUB-EFI/OVMF boot (the large merged
 * ring-3 kernel has a ~211 MiB NOBITS .bss reaching ~0x16400000 at that base).
 * 1 GiB stays in canonical low-half user space and inside PML4[0] (< 512 GiB),
 * so the private-low clone + copy-on-map path is unchanged. QEMU `-kernel`
 * lanes (kernel at 1 MiB) are unaffected — payload is simply higher.
 * Static linking only.
 */
ENTRY(_start)

SECTIONS {
    . = 0x40000000;

    .text : {
        *(.text.entry)
        *(.text .text.*)
    }

    . = ALIGN(4096);
    .rodata : {
        *(.rodata .rodata.*)
    }

    /* C++ exception unwinding tables. libunwind (built with
     * _LIBUNWIND_IS_BAREMETAL) locates these via the boundary symbols below
     * for static SimpleOS ELF executables — there is no dynamic loader / no
     * dl_iterate_phdr, so the sections must be KEPT (not discarded). */
    . = ALIGN(8);
    .eh_frame_hdr : {
        __eh_frame_hdr_start = .;
        KEEP(*(.eh_frame_hdr))
        __eh_frame_hdr_end = .;
    }

    . = ALIGN(8);
    .eh_frame : {
        __eh_frame_start = .;
        KEEP(*(.eh_frame))
        __eh_frame_end = .;
    }

    . = ALIGN(4096);
    .data : {
        *(.data .data.*)
        *(.sdata .sdata.*)
    }

    /* Non-relaxable GOTPCREL loads (e.g. cmov <ptr>@GOTPCREL(%rip)) need a
     * correctly-based GOT even in a static -no-pie link. Place .got/.got.plt
     * here (NOT in /DISCARD/) so the slots have valid load addresses and lld
     * bakes the absolute target VAs into them. */
    . = ALIGN(8);
    .got : {
        *(.got) *(.got.*)
    }

    . = ALIGN(8);
    .got.plt : {
        *(.got.plt)
    }

    . = ALIGN(16);
    .init_array : {
        __init_array_start = .;
        KEEP(*(.init_array .init_array.*))
        __init_array_end = .;
    }

    . = ALIGN(16);
    .fini_array : {
        __fini_array_start = .;
        KEEP(*(.fini_array .fini_array.*))
        __fini_array_end = .;
    }

    . = ALIGN(16);
    .tdata : {
        _tls_start = .;
        *(.tdata .tdata.*)
    }

    . = ALIGN(16);
    .tbss : {
        *(.tbss .tbss.*)
        _tls_end = .;
    }

    . = ALIGN(4096);
    .bss : {
        __bss_start = .;
        *(.bss .bss.*)
        *(.sbss .sbss.*)
        *(COMMON)
        __bss_end = .;
    }

    _end = .;

    /DISCARD/ : {
        *(.comment)
        *(.note .note.*)
        *(.plt)
        *(.rela.plt)
    }
}
LDEOF
echo "[sysroot] Installed linker script"

# -- Summary ----------------------------------------------------------------

echo "[sysroot] Sysroot ready: $SYSROOT"
echo "[sysroot] Contents:"
ls -la "$SYSROOT/include/" 2>/dev/null || true
ls -la "$SYSROOT/lib/"     2>/dev/null || true
ls -la "$SYSROOT/share/simpleos/" 2>/dev/null || true
