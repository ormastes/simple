# mkfs.nvfs — build the current NVFS POSIX DBFS-backed root image.
#
# Usage:
#   <admitted-simple> run src/os/port/mkfs_nvfs.spl -- [output] [sectors]
#
# The image identifies the compatibility provider honestly: NVFS superblocks
# select the root, while DBFS owns the persistent namespace and byte storage.

use std.nogc_sync_mut.io_runtime.{get_args}
use os.port.nvfs_image.{
    NvfsImageConfig, NvfsImageSeed, build_nvfs_rootfs_image,
    NVFS_IMAGE_PROVIDER
}
use std.process

extern fn rt_text_to_bytes(s: text) -> [u8]

val DEFAULT_OUTPUT: text = "build/os/simpleos_nvfs_root.img"
val DEFAULT_SIZE_SECTORS: u64 = 65536u64

fn _mkfs_nvfs_seeds() -> [NvfsImageSeed]:
    [
        NvfsImageSeed(
            name: "/etc/motd",
            data: rt_text_to_bytes("SimpleOS NVFS POSIX root ({NVFS_IMAGE_PROVIDER})\n")
        ),
        NvfsImageSeed(
            name: "/README",
            data: rt_text_to_bytes(
                "This image uses the {NVFS_IMAGE_PROVIDER} compatibility provider.\n" +
                "NVFS selects the root; DBFS persists its namespace and bytes.\n"
            )
        ),
    ]

# `fn main(args: [text])` is not honoured by the current toolchain: invoked with
# arguments it fails semantic analysis, and invoked without them `args.len()`
# reads uninitialised memory.  Read the argv vector explicitly instead.
# See doc/08_tracking/bug/main_args_parameter_unsupported_breaks_mkfs_tools_2026-08-24.md
fn _user_args() -> [text]:
    val raw = get_args()
    var out: [text] = []
    var i = 1
    while i < raw.len():
        if raw[i] != "--":
            out.push(raw[i])
        i = i + 1
    return out

fn main():
    val args = _user_args()
    val output = if args.len() > 0: args[0] else: DEFAULT_OUTPUT
    val size_sectors = if args.len() > 1: args[1].to_i64().to_u64() else: DEFAULT_SIZE_SECTORS
    val cfg = NvfsImageConfig(size_sectors: size_sectors, seeds: _mkfs_nvfs_seeds())
    match build_nvfs_rootfs_image(cfg, output):
        case Ok(_):
            print "mkfs.nvfs: wrote {output} ({size_sectors} sectors; provider={NVFS_IMAGE_PROVIDER})"
        case Err(e):
            print "mkfs.nvfs: FAILED: {e}"
            process.exit(1)
