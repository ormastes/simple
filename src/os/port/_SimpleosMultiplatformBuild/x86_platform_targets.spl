# SimpleOS x86 family platform descriptors.
# Kept separate because the x86_64 NVMe and board lanes are substantially
# larger than the other immutable catalog rows.

use os.kernel.arch.arch_context.{Architecture}
use os.port._SimpleosMultiplatformBuild.build_target_contracts.{
    SimpleOsPlatformBuildTarget, SimpleOsNativeImplementationKind,
    SimpleOsStandaloneAsmPolicy, SimpleOsFirmwareContractKind,
    SimpleOsImageLayoutKind, SimpleOsLaneKind,
    _x86_toolchain_apps, _x86_64_c_flags, _x86_32_c_flags,
    _x86_32_asm_flags, _common_asm_flags, _lane_contract
}
use os.port._SimpleosMultiplatformBuild.platform_target_firmware_contract.{
    _userland_firmware_contract
}
use std.common.contracts.execution.simpleos_target_v1.{
    SIMPLEOS_TARGET_V1_X86_64_TRIPLE, SIMPLEOS_TARGET_V1_X86_64_ABI,
    SIMPLEOS_TARGET_V1_X86_64_FIRMWARE, SIMPLEOS_TARGET_V1_I686_TRIPLE,
    SIMPLEOS_TARGET_V1_I686_ABI, SIMPLEOS_TARGET_V1_I686_FIRMWARE
}

fn _simpleos_x86_64_platform_target() -> SimpleOsPlatformBuildTarget:
    SimpleOsPlatformBuildTarget(
        name: "x86_64-simpleos",
        aliases: ["x86_64", "amd64", "x64"],
        arch: Architecture.X86_64,
        arch_name: "x86_64",
        bits: 64,
        isa: "x86_64",
        abi: "sysv",
        float_abi: "sse2",
        userland_target: SIMPLEOS_TARGET_V1_X86_64_TRIPLE,
        userland_abi: SIMPLEOS_TARGET_V1_X86_64_ABI,
        userland_firmware_contract: _userland_firmware_contract(SIMPLEOS_TARGET_V1_X86_64_FIRMWARE),
        native_target: "x86_64-unknown-none",
        clang_target: "x86_64-unknown-none-elf",
        qemu_system: "qemu-system-x86_64",
        qemu_machine: "q35",
        qemu_cpu: "qemu64",
        qemu_serial_kind: "com1",
        qemu_serial_base: 0x3F8u64,
        boot_firmware_contract: SimpleOsFirmwareContractKind.LimineBios,
        default_image_layout: SimpleOsImageLayoutKind.Fat32Disk,
        board_adapter_id: "x86_pc_bios_uefi",
        linker_script: "examples/09_embedded/simple_os/arch/x86_64/linker.ld",
        default_entry: "examples/09_embedded/simple_os/arch/x86_64/os_entry.spl",
        output: "build/os/simpleos_x86_64.elf",
        platform_slug: "x86_64",
        kernel_output: "build/os/simpleos_x86_64.elf",
        disk_image_output: "build/os/fat32-x86_64.img",
        staged_toolchain_apps: _x86_toolchain_apps(),
        qemu_smoke_lane: _lane_contract(
            "x86_64-smoke",
            SimpleOsLaneKind.Smoke,
            SimpleOsFirmwareContractKind.LimineBios,
            SimpleOsImageLayoutKind.KernelOnly,
            "examples/09_embedded/simple_os/arch/x86_64/boot_stage1_entry.spl",
            "examples/09_embedded/simple_os/arch/x86_64/linker.ld",
            "build/os/simpleos_x86_64.elf",
            "512M",
            "",
            ["-device", "isa-debug-exit,iobase=0xf4,iosize=0x04", "-vga", "std"],
            10000,
            [],
            [],
            "",
            "build/os/simpleos_x86_64.elf"
        ),
        qemu_acceptance_lane: _lane_contract(
            "x86_64-q35-nvme-fat32-smf",
            SimpleOsLaneKind.FsExec,
            SimpleOsFirmwareContractKind.LimineBios,
            SimpleOsImageLayoutKind.Fat32Disk,
            "examples/09_embedded/simple_os/arch/x86_64/fs_exec_entry.spl",
            "examples/09_embedded/simple_os/arch/x86_64/linker.ld",
            "build/os/simpleos_x86_64_fs_exec.elf",
            "512M",
            "",
            [
                "-machine", "q35",
                "-device", "isa-debug-exit,iobase=0xf4,iosize=0x04",
                "-device", "nvme,id=fsexec,serial=x86-64-fs-exec",
                "-drive", "file=build/os/fat32-x86_64.img,if=none,id=fsexecns1,format=raw",
                "-device", "nvme-ns,drive=fsexecns1,bus=fsexec,nsid=1"
            ],
            60000,
            [],
            [],
            "",
            "build/os/fat32-x86_64.img"
        ),
        qemu_additional_lanes: [
            _lane_contract(
                "x86_64-q35-pure-nvme-perf",
                SimpleOsLaneKind.Smoke,
                SimpleOsFirmwareContractKind.LimineBios,
                SimpleOsImageLayoutKind.Fat32Disk,
                "examples/09_embedded/simple_os/arch/x86_64/q35_pure_nvme_perf_entry.spl",
                "examples/09_embedded/simple_os/arch/x86_64/linker.ld",
                "build/os/simpleos_x86_64_pure_nvme_perf.elf",
                "512M",
                "",
                [
                    "-device", "isa-debug-exit,iobase=0xf4,iosize=0x04",
                    "-device", "nvme,id=pureperf,serial=pure-simple-perf",
                    "-drive", "file=build/os/fat32-x86_64.img,if=none,id=pureperfns1,format=raw",
                    "-device", "nvme-ns,drive=pureperfns1,bus=pureperf,nsid=1",
                    "-drive", "file=build/test-artifacts/simpleos-q35-smoke/q35_user_namespace.img,if=none,id=pureperfns2,format=raw",
                    "-device", "nvme-ns,drive=pureperfns2,bus=pureperf,nsid=2",
                    "-netdev", "user,id=net0",
                    "-device", "virtio-net-pci,netdev=net0"
                ],
                30000,
                [],
                [
                    "storage_provider=simple-driver",
                    "network_provider=simple-driver",
                    "storage_placement=user-space-driver",
                    "system_storage_placement=system-driver",
                    "network_placement=user-space-driver",
                    "storage_namespace=non-secure-resource-namespace",
                    "network_namespace=non-secure-resource-namespace",
                    "storage_grant=resource-grant-set:tok=",
                    "network_grant=resource-grant-set:tok=",
                    "common_driver_logic=shared",
                    "user_namespace_assignment=hardware-data-queue",
                    "user_namespace_mode=user-assigned",
                    "user_namespace_queue_id=",
                    "user_namespace_direct_io=read-write-through",
                    "user_namespace_shared_interface=fat32,nvfs,dbfs",
                    "user_namespace_conflict_policy=active-lease-checked",
                    "nvme_perf reason=ready",
                    "direct_io_path=nvme-lease-shared-dma-4k",
                    "fat32_extent_source=freestanding-fat32-extents",
                    "nvfs_extent_source=freestanding-dbfs-arena",
                    "dbfs_extent_source=freestanding-dbfs-arena",
                    "fs_consumers=fat32,nvfs,dbfs",
                    "fat32_direct_io=read-write-through",
                    "nvfs_direct_io=read-write-through",
                    "dbfs_direct_io=read-write-through",
                    "c_bridge_used=false",
                    "allocation_per_io=false"
                ],
                "x86_pc_bios_uefi",
                "build/os/fat32-x86_64.img"
            )
        ],
        board_lane: _lane_contract(
            "x86_64-pc-bios-uefi",
            SimpleOsLaneKind.BoardCompileSmoke,
            SimpleOsFirmwareContractKind.LimineUefi,
            SimpleOsImageLayoutKind.BoardBundle,
            "examples/09_embedded/simple_os/arch/x86_64/os_entry.spl",
            "examples/09_embedded/simple_os/arch/x86_64/linker.ld",
            "build/os/simpleos_x86_64.elf",
            "",
            "",
            [],
            0,
            _x86_toolchain_apps(),
            [],
            "x86_pc_bios_uefi",
            "build/os/fat32-x86_64.img"
        ),
        source_roots: ["src", "examples"],
        boot_c_sources: [
            "examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_boot_stdout.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_interrupt_control.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_startup_handoff.c"
        ],
        boot_asm_sources: ["examples/09_embedded/simple_os/arch/x86_64/boot/crt0.s"],
        grandfathered_native_sources: [
            "examples/09_embedded/simple_os/arch/x86_64/boot/ap_trampoline.s",
            "examples/09_embedded/simple_os/arch/x86_64/boot/auto_stubs.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/collections.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/curve25519_ring_helper.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/ed25519_verify_helper.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/context_switch.s",
            "examples/09_embedded/simple_os/arch/x86_64/boot/enter_user_first.s",
            "examples/09_embedded/simple_os/arch/x86_64/boot/glass_render.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/hashmap.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/primitives.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/rt_extras.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/syscall_entry.s",
            "examples/09_embedded/simple_os/arch/x86_64/boot/tls13_aes256_gcm_helper.c",
            "examples/09_embedded/simple_os/arch/x86_64/boot/type_stubs.c"
        ],
        boot_impl_kind: SimpleOsNativeImplementationKind.StandaloneAsm,
        runtime_impl_kind: SimpleOsNativeImplementationKind.Simple,
        standalone_asm_policy: SimpleOsStandaloneAsmPolicy.EntryStubsOnly,
        c_flags: _x86_64_c_flags(),
        asm_flags: _common_asm_flags("x86_64-unknown-none-elf"),
        link_flags: ["-nostdlib", "-static", "-z", "max-page-size=0x1000"],
        notes: "64-bit x86 Multiboot1 baremetal kernel and hosted-wrapper lane"
    )

fn _simpleos_i686_platform_target() -> SimpleOsPlatformBuildTarget:
    SimpleOsPlatformBuildTarget(
        name: "i686-simpleos",
        aliases: ["x86_32", "x86", "i386", "i686"],
        arch: Architecture.X86,
        arch_name: "x86",
        bits: 32,
        isa: "i686",
        abi: "cdecl",
        float_abi: "soft",
        userland_target: SIMPLEOS_TARGET_V1_I686_TRIPLE,
        userland_abi: SIMPLEOS_TARGET_V1_I686_ABI,
        userland_firmware_contract: _userland_firmware_contract(SIMPLEOS_TARGET_V1_I686_FIRMWARE),
        native_target: "i686-unknown-none",
        clang_target: "i686-unknown-none-elf",
        qemu_system: "qemu-system-i386",
        qemu_machine: "pc",
        qemu_cpu: "qemu32",
        qemu_serial_kind: "com1",
        qemu_serial_base: 0x3F8u64,
        boot_firmware_contract: SimpleOsFirmwareContractKind.LimineBios,
        default_image_layout: SimpleOsImageLayoutKind.Fat32Disk,
        board_adapter_id: "",
        linker_script: "examples/09_embedded/simple_os/arch/x86_32/linker.ld",
        default_entry: "examples/09_embedded/simple_os/arch/x86_32/browser_probe_entry.spl",
        output: "build/os/simpleos_x86_32.elf",
        platform_slug: "x86_32",
        kernel_output: "build/os/simpleos_x86_32.elf",
        disk_image_output: "build/os/fat32-x86_32.img",
        staged_toolchain_apps: _x86_toolchain_apps(),
        qemu_smoke_lane: _lane_contract(
            "x86_32-smoke",
            SimpleOsLaneKind.Smoke,
            SimpleOsFirmwareContractKind.LimineBios,
            SimpleOsImageLayoutKind.KernelOnly,
            "examples/09_embedded/simple_os/arch/x86_32/browser_probe_entry.spl",
            "examples/09_embedded/simple_os/arch/x86_32/linker.ld",
            "build/os/simpleos_x86_32.elf",
            "128M",
            "",
            ["-device", "isa-debug-exit,iobase=0xf4,iosize=0x04"],
            10000,
            [],
            [],
            "",
            "build/os/simpleos_x86_32.elf"
        ),
        qemu_acceptance_lane: _lane_contract(
            "x86_32-initrd-fat32-smf",
            SimpleOsLaneKind.FsExec,
            SimpleOsFirmwareContractKind.LimineBios,
            SimpleOsImageLayoutKind.Fat32Disk,
            "examples/09_embedded/simple_os/arch/x86_32/initrd_fs_exec_probe_entry.spl",
            "examples/09_embedded/simple_os/arch/x86_32/linker.ld",
            "build/os/simpleos_x86_32_initrd_fs_exec_probe.elf",
            "128M",
            "",
            ["-initrd", "build/os/fat32-x86_32.img", "-device", "isa-debug-exit,iobase=0xf4,iosize=0x04"],
            60000,
            [],
            [
                "[x86_32 fs] initrd fat32 ok",
                "[x86_32 fs] hello_world smf ok",
                "[x86_32 fs] browser smf ok",
                "[x86_32 fs] x86_32 payload ok",
                "[x86_32 fs] app execution ok"
            ],
            "",
            "build/os/fat32-x86_32.img"
        ),
        qemu_additional_lanes: [],
        board_lane: nil,
        source_roots: ["src", "examples"],
        boot_c_sources: ["examples/09_embedded/simple_os/arch/x86_32/boot/baremetal_stubs.c"],
        boot_asm_sources: [
            "examples/09_embedded/simple_os/arch/x86_32/boot/crt0.s",
            "examples/09_embedded/simple_os/arch/x86_32/boot/enter_user_first.s"
        ],
        grandfathered_native_sources: [],
        boot_impl_kind: SimpleOsNativeImplementationKind.NativeC,
        runtime_impl_kind: SimpleOsNativeImplementationKind.Simple,
        standalone_asm_policy: SimpleOsStandaloneAsmPolicy.BroadNativeSurface,
        c_flags: _x86_32_c_flags(),
        asm_flags: _x86_32_asm_flags(),
        link_flags: ["-nostdlib", "-static", "-Wl,-m,elf_i386"],
        notes: "32-bit x86 Multiboot1 lane; build C/ASM boot objects with i686 freestanding flags"
    )
