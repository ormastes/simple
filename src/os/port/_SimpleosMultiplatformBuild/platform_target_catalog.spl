# SimpleOS multi-platform build — the platform build-target catalog
# (per-architecture reference data for all supported lanes).
# SimpleOS Multi-Platform Build Catalog
#
# Centralizes target triples, C/ASM boot inputs, and freestanding compiler
# flags for SimpleOS kernel and boot-wrapper binaries.

use os.kernel.arch.arch_context.{Architecture}
use os.port._SimpleosMultiplatformBuild.build_target_contracts.{
    SimpleOsPlatformBuildTarget, SimpleOsNativeImplementationKind,
    SimpleOsStandaloneAsmPolicy, SimpleOsFirmwareContractKind,
    SimpleOsImageLayoutKind, SimpleOsLaneKind,
    _arm_toolchain_apps, _riscv_toolchain_apps,
    _aarch64_c_flags, _arm32_c_flags,
    _riscv64_c_flags, _riscv32_c_flags, _common_asm_flags, _lane_contract
}
use os.port._SimpleosMultiplatformBuild.platform_target_firmware_contract.{
    _userland_firmware_contract
}
use os.port._SimpleosMultiplatformBuild.x86_platform_targets.{
    _simpleos_x86_64_platform_target, _simpleos_i686_platform_target
}
use std.common.contracts.execution.simpleos_target_v1.{
    SIMPLEOS_TARGET_V1_AARCH64_TRIPLE, SIMPLEOS_TARGET_V1_AARCH64_ABI,
    SIMPLEOS_TARGET_V1_AARCH64_FIRMWARE, SIMPLEOS_TARGET_V1_ARMV7_TRIPLE,
    SIMPLEOS_TARGET_V1_ARMV7_ABI, SIMPLEOS_TARGET_V1_ARMV7_FIRMWARE,
    SIMPLEOS_TARGET_V1_RISCV64GC_TRIPLE, SIMPLEOS_TARGET_V1_RISCV64GC_ABI,
    SIMPLEOS_TARGET_V1_RISCV64GC_FIRMWARE, SIMPLEOS_TARGET_V1_RISCV32IMAC_TRIPLE,
    SIMPLEOS_TARGET_V1_RISCV32IMAC_ABI, SIMPLEOS_TARGET_V1_RISCV32IMAC_FIRMWARE
}

# Keep this registry single-source but uncached: descriptor and lane nodes are
# mutable classes, so a shared cache would let one caller corrupt later reads.
# Lookup scans remain bounded to the eight first-class rows. A safe cache needs
# an immutable descriptor type (and therefore no invalidation path).
fn simpleos_platform_targets() -> [SimpleOsPlatformBuildTarget]:
    """Return fresh first-class SimpleOS binary build target descriptors."""
    [
        _simpleos_x86_64_platform_target(),
        _simpleos_i686_platform_target(),
        SimpleOsPlatformBuildTarget(
            name: "aarch64-simpleos",
            aliases: ["arm64", "aarch64"],
            arch: Architecture.Arm64,
            arch_name: "aarch64",
            bits: 64,
            isa: "aarch64",
            abi: "aapcs64",
            float_abi: "hard",
            userland_target: SIMPLEOS_TARGET_V1_AARCH64_TRIPLE,
            userland_abi: SIMPLEOS_TARGET_V1_AARCH64_ABI,
            userland_firmware_contract: _userland_firmware_contract(SIMPLEOS_TARGET_V1_AARCH64_FIRMWARE),
            native_target: "aarch64-unknown-none",
            clang_target: "aarch64-unknown-none-elf",
            qemu_system: "qemu-system-aarch64",
            qemu_machine: "virt",
            qemu_cpu: "cortex-a72",
            qemu_serial_kind: "pl011",
            qemu_serial_base: 0x09000000u64,
            boot_firmware_contract: SimpleOsFirmwareContractKind.RawLoader,
            default_image_layout: SimpleOsImageLayoutKind.VirtioFat32,
            board_adapter_id: "arm64_u_boot_dtb_sbc",
            linker_script: "src/os/kernel/arch/arm64/linker.ld",
            default_entry: "src/os/kernel/arch/arm64/boot.spl",
            output: "build/os/simpleos_aarch64.elf",
            platform_slug: "arm64",
            kernel_output: "build/os/simpleos_aarch64.elf",
            disk_image_output: "build/os/fat32-arm64.img",
            staged_toolchain_apps: _arm_toolchain_apps(),
            qemu_smoke_lane: _lane_contract(
                "arm64-smoke",
                SimpleOsLaneKind.Smoke,
                SimpleOsFirmwareContractKind.RawLoader,
                SimpleOsImageLayoutKind.KernelOnly,
                "src/os/kernel/arch/arm64/boot.spl",
                "src/os/kernel/arch/arm64/linker.ld",
                "build/os/simpleos_aarch64.elf",
                "128M",
                "",
                [],
                10000,
                [],
                [],
                "",
                "build/os/simpleos_aarch64.elf"
            ),
            qemu_acceptance_lane: _lane_contract(
                "arm64-virtio-fat32-smf",
                SimpleOsLaneKind.FsExec,
                SimpleOsFirmwareContractKind.RawLoader,
                SimpleOsImageLayoutKind.VirtioFat32,
                "examples/09_embedded/simple_os/arch/arm64/fs_exec_entry.spl",
                "examples/09_embedded/simple_os/arch/arm64/fs_exec_linker.ld",
                "build/os/simpleos_arm64_fs_exec.elf",
                "384M",
                "",
                [
                    "-global", "virtio-mmio.force-legacy=false",
                    "-drive", "file=build/os/fat32-arm64.img,if=none,id=armdisk,format=raw",
                    "-device", "virtio-blk-device,drive=armdisk",
                    "-semihosting-config", "enable=on,target=native"
                ],
                60000,
                _arm_toolchain_apps(),
                [],
                "",
                "build/os/fat32-arm64.img"
            ),
            qemu_additional_lanes: [
                _lane_contract(
                    "arm64-virtio-smoke",
                    SimpleOsLaneKind.Smoke,
                    SimpleOsFirmwareContractKind.RawLoader,
                    SimpleOsImageLayoutKind.VirtioFat32,
                    "examples/09_embedded/simple_os/arch/arm64/smoke_entry.spl",
                    "examples/09_embedded/simple_os/arch/arm64/fs_exec_linker.ld",
                    "build/os/simpleos_arm64_smoke.elf",
                    "384M",
                    "",
                    [
                        "-global", "virtio-mmio.force-legacy=false",
                        "-drive", "file=build/os/fat32-arm64.img,if=none,id=armdisk,format=raw",
                        "-device", "virtio-blk-device,drive=armdisk",
                        "-semihosting-config", "enable=on,target=native"
                    ],
                    60000,
                    [],
                    [],
                    "",
                    "build/os/fat32-arm64.img"
                )
            ],
            board_lane: _lane_contract(
                "arm64-u-boot-dtb-board",
                SimpleOsLaneKind.BoardCompileSmoke,
                SimpleOsFirmwareContractKind.UBootDtb,
                SimpleOsImageLayoutKind.BoardBundle,
                "examples/09_embedded/simple_os/arch/arm64/fs_exec_entry.spl",
                "examples/09_embedded/simple_os/arch/arm64/fs_exec_linker.ld",
                "build/os/simpleos_arm64_fs_exec.elf",
                "",
                "",
                [],
                0,
                _arm_toolchain_apps(),
                [],
                "arm64_u_boot_dtb_sbc",
                "build/os/fat32-arm64.img"
            ),
            source_roots: ["src", "examples"],
            boot_c_sources: [
                "examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c",
                "examples/09_embedded/simple_os/arch/arm64/boot/baremetal_uart_stdout.c"
            ],
            boot_asm_sources: [
                "examples/09_embedded/simple_os/arch/arm64/boot/crt0.S",
                "examples/09_embedded/simple_os/arch/arm64/boot/baremetal_interrupt_control.S",
                "src/os/kernel/arch/arm64/boot/crt0.S"
            ],
            grandfathered_native_sources: [],
            boot_impl_kind: SimpleOsNativeImplementationKind.NativeC,
            runtime_impl_kind: SimpleOsNativeImplementationKind.Simple,
            standalone_asm_policy: SimpleOsStandaloneAsmPolicy.BroadNativeSurface,
            c_flags: _aarch64_c_flags(),
            asm_flags: _common_asm_flags("aarch64-unknown-none-elf"),
            link_flags: ["-nostdlib", "-static"],
            notes: "64-bit ARM virt-machine kernel lane"
        ),
        SimpleOsPlatformBuildTarget(
            name: "armv7-simpleos",
            aliases: ["arm32", "armv7"],
            arch: Architecture.Arm32,
