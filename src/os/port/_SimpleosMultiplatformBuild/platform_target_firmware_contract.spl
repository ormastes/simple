# SimpleOS target-profile firmware mapping.
#
# This owner keeps the target-contract strings and catalog enum representation
# aligned without requiring descriptor modules to import the public hub.

use os.port._SimpleosMultiplatformBuild.build_target_contracts.{SimpleOsFirmwareContractKind}
use std.common.contracts.execution.simpleos_target_v1.{
    SIMPLEOS_TARGET_V1_X86_64_FIRMWARE, SIMPLEOS_TARGET_V1_I686_FIRMWARE,
    SIMPLEOS_TARGET_V1_AARCH64_FIRMWARE, SIMPLEOS_TARGET_V1_ARMV7_FIRMWARE,
    SIMPLEOS_TARGET_V1_RISCV64GC_FIRMWARE, SIMPLEOS_TARGET_V1_RISCV32IMAC_FIRMWARE
}

fn _userland_firmware_contract(profile: text) -> SimpleOsFirmwareContractKind:
    if profile == SIMPLEOS_TARGET_V1_X86_64_FIRMWARE or
       profile == SIMPLEOS_TARGET_V1_I686_FIRMWARE:
        return SimpleOsFirmwareContractKind.LimineBios
    if profile == SIMPLEOS_TARGET_V1_AARCH64_FIRMWARE or
       profile == SIMPLEOS_TARGET_V1_ARMV7_FIRMWARE:
        return SimpleOsFirmwareContractKind.RawLoader
    if profile == SIMPLEOS_TARGET_V1_RISCV64GC_FIRMWARE or
       profile == SIMPLEOS_TARGET_V1_RISCV32IMAC_FIRMWARE:
        return SimpleOsFirmwareContractKind.OpenSbi
    panic("unknown SimpleOS target-contract firmware profile: {profile}")
