## SimpleOS Cross-Compilation Bootstrap Script
##
## Builds the Simple compiler for SimpleOS from a host machine.
## Cross-compiles the Rust seed, then runs staged bootstrap targeting SimpleOS.
##
## Usage:
##   bin/simple run src/os/port/bootstrap_cross.spl -- --target simpleos-x86_64
##   bin/simple run src/os/port/bootstrap_cross.spl -- --target aarch64-simpleos
##   bin/simple run src/os/port/bootstrap_cross.spl -- --status
##   bin/simple run src/os/port/bootstrap_cross.spl -- --package

# Split from src/os/port/bootstrap_cross.spl to keep module cohesion under the 800-line source limit.
use std.fs
use std.process
use std.text
use os.port.simpleos_multiplatform_build.{simpleos_platform_userland_target}

export use os.port._BootstrapCross.cross_compile_stages.{sys_get_args, rt_env_get, rt_file_write_text, rt_exit, SIMPLEOS_X86_64_SELECTOR, SIMPLEOS_X86_64_GUEST_LANE, SUPPORTED_TARGETS, SUPPORTED_TARGET_ALIASES, normalize_target_selector, target_selector_name, rust_target_spec_name, rust_cargo_target_alias, is_recognized_target, RUST_SEED_DIR, DEFAULT_BUILD_DIR, DEFAULT_SYSROOT, IN_GUEST_SYSROOT, CROSS_LINK_MAX_ATTEMPTS, path_exists, path_is_dir, parent_dir, base_name, ensure_dir, file_size_mb, file_size_bytes, env_get_text, effective_sysroot, default_sysroot_for_target, SIMPLEOS_EXCLUDED_SOURCE_SUBTREES, is_simpleos_excluded, filter_simpleos_sources, expand_lib_sources, simpleos_lib_source_args, CrossConfig, emit_stage_seed_wrapper, parse_args, print_status, bootstrap_artifact_status, ensure_sysroot, cross_compile_seed, build_stage_cross_with_retry}
export use os.port._BootstrapCross.cross_bootstrap_pipeline.{sys_get_args, rt_env_get, rt_file_write_text, rt_exit, build_stage_cross, package_bootstrap, run_cross_bootstrap, print_usage, is_supported_target, retry_transient, cross_bootstrap_main}

# Keep the executable entrypoint in the public facade. Re-exported functions
# are available to importers, but the script runner only invokes a `main`
# declared by the requested root module.
fn main():
    cross_bootstrap_main()
