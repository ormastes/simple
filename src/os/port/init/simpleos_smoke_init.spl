## SimpleOS in-guest smoke /sbin/init
##
## Installed into the initramfs as `/sbin/init`. When SimpleOS boots via
## `-append init=/sbin/init` it runs this program, which drives the 5
## verification checks from `.claude/plans/mutable-giggling-raccoon.md`
## and writes tagged output to the serial console so the host orchestrator
## (src/os/port/e2e_verify.spl) can grep for pass markers.
##
## IMPORTANT: SimpleOS kernel today has no POSIX fork/exec. Where we would
## normally spawn a child (simple --version, simple test, native-build,
## clang, llvm-nm, the rust hello ELF) we emit a `SKIP: <reason>` tag so
## the host does not receive a fabricated pass. The real implementation
## drops in once the kernel gains a user-process spawn path (see
## Deferred / Out-of-Scope in the plan, kernel features: fork, execve,
## waitpid, VM fork-on-write).

use std.fs
use std.process
use std.io_runtime.{ dir_create_all }
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.common.crypto.sha256.{sha256_u8_hex}
use os.sosix.qemu_fs_toolchain_evidence_v1.*

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_read_bytes(path: text) -> [u8]
extern fn rt_text_to_bytes(value: text) -> [u8]

val HELLO_C = "/usr/share/test/hello.c"
val HELLO_OBJ = "/tmp/hello.o"
val HELLO_RUST_ELF = "/usr/share/test/hello_rust"
val CORPUS_DIR = "/src/test/bootstrap_corpus"
val SIMPLE_BIN = "/usr/bin/simple"
val STAGE2_OUT = "/build/stage2_native/simple"
val STAGE3_OUT = "/build/stage3_native/simple"

val TRIVIAL_SRC_DIR = "/tmp"
val TRIVIAL_SRC_FILE = "/tmp/sosix-hello.spl"
val TRIVIAL_OUTPUT = "/tmp/sosix-hello"
val SOSIX_EVIDENCE_HOST = "linux"
val SOSIX_EVIDENCE_ARCH = "x86_64"

fn _toolchain_nonce() -> text:
    env_get("SOSIX_QEMU_NONCE")

fn _hello_output(nonce: text) -> text:
    "hello-" + nonce

fn banner():
    print "SIMPLEOS_SMOKE_INIT_STARTED"
    print "--- SimpleOS smoke init v1 ---"

fn can_exec() -> bool:
    fs.exists(SIMPLE_BIN)

fn step_simple_version(have_exec: bool):
    if not have_exec:
        print "SIMPLE_VERSION: SKIP (kernel exec unsupported)"
        return
    if not fs.exists(SIMPLE_BIN):
        print "SIMPLE_VERSION: SKIP (missing {SIMPLE_BIN})"
        return
    val r = process.run(SIMPLE_BIN, ["--version"])
    if r.exit_code != 0:
        print "SIMPLE_VERSION: FAIL (exit {r.exit_code})"
        return
    print "SIMPLE_FROM_FS_VERSION_OK"

fn step_bootstrap_corpus(have_exec: bool):
    if not have_exec:
        print "BOOTSTRAP_CORPUS_SKIP reason=no-exec"
        return
    if not fs.dir_exists(CORPUS_DIR):
        print "BOOTSTRAP_CORPUS_SKIP reason=missing-dir:{CORPUS_DIR}"
        return
    val r = process.run(SIMPLE_BIN, ["test", CORPUS_DIR])
    if r.exit_code == 0:
        print "BOOTSTRAP_CORPUS_OK"
    else:
        print "BOOTSTRAP_CORPUS_FAIL exit={r.exit_code}"

fn native_build_once(out_path: text) -> bool:
    val args: [text] = [
        "native-build",
        "--source", "/src/compiler",
        "--source", "/src/lib",
        "--source", "/src/app",
        "--entry", "/src/app/cli/main.spl",
        "-o", out_path,
        "--opt-level=aggressive",
    ]
    val r = process.run(SIMPLE_BIN, args)
    r.exit_code == 0

fn step_selfhost(have_exec: bool):
    if not have_exec:
        print "STAGE2_EQ_STAGE3_SKIP reason=no-exec"
        return
    if not fs.exists(SIMPLE_BIN):
        print "STAGE2_EQ_STAGE3_SKIP reason=missing-simple"
        return
    if not native_build_once(STAGE2_OUT):
        print "STAGE2_EQ_STAGE3_FAIL phase=stage2"
        return
    if not native_build_once(STAGE3_OUT):
        print "STAGE2_EQ_STAGE3_FAIL phase=stage3"
        return
    val cmp = process.run("cmp", [STAGE2_OUT, STAGE3_OUT])
    if cmp.exit_code == 0:
        print "STAGE2_EQ_STAGE3_OK"
    else:
        print "STAGE2_EQ_STAGE3_FAIL phase=cmp exit={cmp.exit_code}"

fn step_clang_smoke(have_exec: bool):
    if not have_exec:
        print "SMOKE_CLANG_SKIP reason=no-exec"
        return
    if not fs.exists("/usr/bin/clang"):
        print "SMOKE_CLANG_SKIP reason=missing-clang"
        return
    if not fs.exists(HELLO_C):
        print "SMOKE_CLANG_SKIP reason=missing-source"
        return
    val compile = process.run(
        "/usr/bin/clang",
        [
            "--target=x86_64-simpleos",
            "--sysroot=/usr",
            "-c", HELLO_C,
            "-o", HELLO_OBJ,
        ],
    )
    if compile.exit_code != 0:
        print "SMOKE_CLANG_FAIL phase=compile exit={compile.exit_code}"
        return
    val nm = process.run("/usr/bin/llvm-nm", [HELLO_OBJ])
    if nm.exit_code != 0:
        print "SMOKE_CLANG_FAIL phase=nm exit={nm.exit_code}"
        return
    print "SMOKE_CLANG_OK"

fn step_rust_smoke(have_exec: bool):
    if not have_exec:
        print "SMOKE_RUST_SKIP reason=no-exec"
        return
    if not fs.exists(HELLO_RUST_ELF):
        print "SMOKE_RUST_SKIP reason=missing-elf:{HELLO_RUST_ELF}"
        return
    val r = process.run(HELLO_RUST_ELF, [])
    if r.exit_code == 0 and r.stdout.contains("hello from rust"):
        print "SMOKE_RUST_OK"
        print r.stdout.trim()
    else:
        print "SMOKE_RUST_FAIL exit={r.exit_code}"

fn step_trivial_self_host(have_exec: bool):
    """Write a trivial .spl, compile it with /usr/bin/simple, run the output."""
    if not have_exec:
        print "TRIVIAL_SELFHOST_SKIP reason=no-exec"
        return
    if not fs.exists(SIMPLE_BIN):
        print "TRIVIAL_SELFHOST_SKIP reason=missing-simple"
        return
    val nonce = _toolchain_nonce()
    if nonce == "":
        print "TRIVIAL_SELFHOST_FAIL phase=nonce"
        return
    val version_result = process.run(SIMPLE_BIN, ["--version"])
    if version_result.exit_code != 0 or version_result.stdout.trim() == "":
        print "TRIVIAL_SELFHOST_FAIL phase=version exit={version_result.exit_code}"
        return
    val version_atom = version_result.stdout.trim().replace(" ", "-")
    val expected_output = _hello_output(nonce)
    print sosix_fs_toolchain_begin_v1(SOSIX_EVIDENCE_HOST, SOSIX_EVIDENCE_ARCH, nonce)
    print sosix_fs_compiler_version_v1(SIMPLE_BIN, version_atom, nonce)
    # Create the source directory and write the trivial program.
    if not dir_create_all(TRIVIAL_SRC_DIR):
        print "TRIVIAL_SELFHOST_FAIL phase=mkdir"
        return
    val src_content = "fn main():\n    print \"" + expected_output + "\"\n"
    if not rt_file_write_text(TRIVIAL_SRC_FILE, src_content):
        print "TRIVIAL_SELFHOST_FAIL phase=write-src"
        return
    val interpreted_source_bytes = rt_file_read_bytes(TRIVIAL_SRC_FILE)
    val interpreted_source_sha = sha256_u8_hex(interpreted_source_bytes)
    print sosix_fs_source_read_v1("interpreter", TRIVIAL_SRC_FILE, interpreted_source_sha)
    # Prove the filesystem-loaded interpreter before exercising native build.
    val interpreted = process.run(SIMPLE_BIN, [TRIVIAL_SRC_FILE])
    val interpreted_stdout = interpreted.stdout.trim()
    if interpreted.exit_code != 0 or interpreted_stdout != expected_output:
        print "TRIVIAL_SELFHOST_FAIL phase=interpret exit={interpreted.exit_code}"
        return
    val interpreted_stdout_sha = sha256_u8_hex(rt_text_to_bytes(interpreted_stdout))
    print interpreted_stdout
    print sosix_fs_interpreter_hello_v1(
        nonce, interpreted_source_sha, interpreted_stdout, interpreted_stdout_sha)
    print "TRIVIAL_INTERPRETER_OK"
    val compiler_source_bytes = rt_file_read_bytes(TRIVIAL_SRC_FILE)
    val compiler_source_sha = sha256_u8_hex(compiler_source_bytes)
    if compiler_source_sha != interpreted_source_sha:
        print "TRIVIAL_SELFHOST_FAIL phase=source-changed"
        return
    print sosix_fs_source_read_v1("compiler", TRIVIAL_SRC_FILE, compiler_source_sha)
    # Compile the trivial program to a filesystem ELF using the installed target toolchain.
    val compile_args: [text] = [
        "compile",
        "--native",
        TRIVIAL_SRC_FILE,
        "-o", TRIVIAL_OUTPUT,
    ]
    val cr = process.run(SIMPLE_BIN, compile_args)
    if cr.exit_code != 0:
        print "TRIVIAL_SELFHOST_FAIL phase=compile exit={cr.exit_code}"
        return
    # Verify the output binary exists.
    if not fs.exists(TRIVIAL_OUTPUT):
        print "TRIVIAL_SELFHOST_FAIL phase=missing-binary"
        return
    val compiled_bytes = rt_file_read_bytes(TRIVIAL_OUTPUT)
    val compiled_sha = sha256_u8_hex(compiled_bytes)
    print sosix_fs_compiler_output_v1(TRIVIAL_OUTPUT, compiler_source_sha, compiled_sha)
    val loader_bytes = rt_file_read_bytes(TRIVIAL_OUTPUT)
    val loader_sha = sha256_u8_hex(loader_bytes)
    if loader_sha != compiled_sha:
        print "TRIVIAL_SELFHOST_FAIL phase=executable-changed"
        return
    print sosix_fs_exec_read_v1(TRIVIAL_OUTPUT, loader_sha)
    # Run the compiled binary and check its output.
    val rr = process.run(TRIVIAL_OUTPUT, [])
    val loader_stdout = rr.stdout.trim()
    if rr.exit_code != 0 or loader_stdout != expected_output:
        print "TRIVIAL_SELFHOST_FAIL phase=run exit={rr.exit_code}"
        return
    val loader_stdout_sha = sha256_u8_hex(rt_text_to_bytes(loader_stdout))
    print loader_stdout
    print sosix_fs_loader_hello_v1(nonce, loader_sha, loader_stdout, loader_stdout_sha)
    print "TRIVIAL_LOADER_OK"
    print sosix_fs_compiled_hello_v1(nonce, compiled_sha, loader_stdout, loader_stdout_sha)
    print sosix_fs_toolchain_end_v1(
        SOSIX_EVIDENCE_HOST, SOSIX_EVIDENCE_ARCH, nonce,
        compiler_source_sha, compiled_sha)
    print "TRIVIAL_SELFHOST_OK"

fn halt():
    print "SIMPLEOS_SMOKE_INIT_DONE"
    # Serial-driver flush; a real shutdown hook would go here once
    # SimpleOS exposes one. For now we exit the init task — the kernel
    # will panic-halt, which QEMU captures as exit code 0 under -nographic.
    process.exit(0)

fn main():
    banner()
    val have_exec = can_exec()
    if not have_exec:
        print "NOTE: in-guest process exec unavailable; each step emits SKIP."
    step_simple_version(have_exec)
    step_bootstrap_corpus(have_exec)
    step_selfhost(have_exec)
    step_clang_smoke(have_exec)
    step_rust_smoke(have_exec)
    step_trivial_self_host(have_exec)
    halt()
