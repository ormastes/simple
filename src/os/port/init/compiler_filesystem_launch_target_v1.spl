# Canonical target decision shared by the filesystem-loaded Simple and Clang
# launch paths.  Keep architecture spelling at this boundary: SimpleOS uses
# riscv64gc as its platform identity while Clang accepts riscv64 plus explicit
# ISA/ABI flags.

use app.simpleos_tool.guest_target.{simpleos_guest_target_current}

pub class SimpleOsCompilerFsLaunchTargetV1:
    valid: bool
    arch: text
    platform_triple: text
    compiler_triple: text
    clang_isa_args: [text]
    reason: text

fn _invalid_compiler_fs_launch_target_v1(
    triple: text,
) -> SimpleOsCompilerFsLaunchTargetV1:
    SimpleOsCompilerFsLaunchTargetV1(
        valid: false,
        arch: "",
        platform_triple: triple,
        compiler_triple: "",
        clang_isa_args: [],
        reason: "unsupported-simpleos-target",
    )

pub fn simpleos_compiler_fs_launch_target_v1(
    triple: text,
) -> SimpleOsCompilerFsLaunchTargetV1:
    if triple == "x86_64-unknown-simpleos":
        return SimpleOsCompilerFsLaunchTargetV1(
            valid: true,
            arch: "x86_64",
            platform_triple: triple,
            compiler_triple: triple,
            clang_isa_args: [],
            reason: "",
        )
    if triple == "aarch64-unknown-simpleos":
        return SimpleOsCompilerFsLaunchTargetV1(
            valid: true,
            arch: "arm64",
            platform_triple: triple,
            compiler_triple: triple,
            clang_isa_args: [],
            reason: "",
        )
    if triple == "riscv64gc-unknown-simpleos":
        return SimpleOsCompilerFsLaunchTargetV1(
            valid: true,
            arch: "riscv64",
            platform_triple: triple,
            compiler_triple: "riscv64-unknown-simpleos",
            clang_isa_args: ["-march=rv64gc", "-mabi=lp64d"],
            reason: "",
        )
    _invalid_compiler_fs_launch_target_v1(triple)

pub fn simpleos_compiler_fs_current_launch_target_v1(
) -> SimpleOsCompilerFsLaunchTargetV1:
    # `simpleos_guest_target_current` is the existing userland authority.  It
    # reads the architecture-local `simpleos_guest_arch_id` implementation
    # linked by crt0/libc, then returns the canonical immutable guest target.
    val selected = simpleos_guest_target_current()
    if selected.is_err():
        return _invalid_compiler_fs_launch_target_v1("")
    simpleos_compiler_fs_launch_target_v1(selected.unwrap().triple)

export SimpleOsCompilerFsLaunchTargetV1
export simpleos_compiler_fs_launch_target_v1
export simpleos_compiler_fs_current_launch_target_v1
