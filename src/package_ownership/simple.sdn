# Frozen cold-index package ownership. This file is an SCV-tracked simple.sdn;
# ordinary project traversal does not consume its ownership_v1 extension.
project:
  name: simple-cold-package-ownership-policy
  version: 1
  type: metadata
  language: Simple

ownership_v1:
  schema: 1
  rules:
    app: "src/app|simple.app|src/app/simple.sdn|simple-app"
    compiler: "src/compiler|simple.compiler|src/compiler/simple.sdn|simple-compiler"
    compiler_common: "src/compiler/00.common|simple.compiler.common|src/compiler/00.common/simple.sdn|simple-compiler-common"
    compiler_rust: "src/compiler_rust|simple.compiler_rust|src/compiler_rust/simple.sdn|simple-rust-runtime"
    compositions: "src/compositions|simple.compositions||"
    generated: "src/generated|simple.generated||"
    hardware: "src/hardware|simple.hardware||"
    i18n: "src/i18n|simple.i18n||"
    lib: "src/lib|simple.std|src/lib/simple.sdn|simple-std"
    os: "src/os|simple.os||"
    plugins: "src/plugins|simple.plugins||"
    plugins_backend_wasm: "src/plugins/backend_wasm|simple.backend_wasm|src/plugins/backend_wasm/simple.sdn|simple-backend-wasm"
    runtime: "src/runtime|simple.runtime|src/runtime/simple.sdn|simple.runtime"
    test_fixture: "src/test_fixture|simple.test_fixture||"
    tool: "src/tool|simple.tool||"
    tooling: "src/tooling|simple.tooling||"
    type: "src/type|simple.type||"
    unit: "src/unit|simple.unit||"
    verification: "src/verification|simple.verification||"
    examples_tooling: "examples/10_tooling|simple.examples.tooling||"
