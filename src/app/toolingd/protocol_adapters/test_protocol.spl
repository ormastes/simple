use std.common.lint_kernel.output.common.lint_output_quote
use app.toolingd.protocol_adapters.model.*
use app.toolingd.protocol_adapters.lsp.ToolingLspEdgeV1

pub fn tooling_test_discover_v1(tests: [ToolingTestDescriptorV1]) -> ToolingTestDiscoveryResultV1:
    var body = "{\"tests\":["
    for index in 0..tests.len():
        if index > 0:
            body = body + ","
        val item = tests[index]
        body = body + "{\"id\":" + item.test_id.to_string() + ",\"label\":" + lint_output_quote(item.label) + ",\"revision\":" + item.revision.to_string() + "}"
    body = body + "]}"
    ToolingTestDiscoveryResultV1(status: ToolingEdgeStatusV1.Ok, response_json: body)

pub fn tooling_test_run_v1(edge: ToolingLspEdgeV1, test: ToolingTestDescriptorV1) -> ToolingTestRunResultV1:
    val begun = edge.begin_diagnostics(test.document, test.revision, test.content_digest)
    val body = if begun.status == ToolingEdgeStatusV1.Ok: "{\"testId\":" + test.test_id.to_string() + ",\"state\":\"started\",\"reusedAnalysis\":" + (if begun.reused: "true" else: "false") + "}" else: "{\"testId\":" + test.test_id.to_string() + ",\"state\":\"rejected\"}"
    ToolingTestRunResultV1(status: begun.status, ticket: begun.ticket, reused: begun.reused, response_json: body)
