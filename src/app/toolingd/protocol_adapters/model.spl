use std.common.kernel_plugin.ids.KpfDigest256
use app.toolingd.protocol.{ToolingDaemonStatusV1, ToolingConnectionHandleV1, ToolingDocumentSessionHandleV1, ToolingAnalysisTicketV1}

pub enum ToolingEdgeStatusV1:
    Ok
    UnsupportedProtocol
    MalformedFrame
    IncompleteFrame
    StaleRevision
    Cancelled
    CapacityExceeded
    Rejected

pub struct ToolingEdgeFrameResultV1:
    status: ToolingEdgeStatusV1
    body: text
    consumed_bytes: u64

pub struct ToolingLspInitializeResultV1:
    status: ToolingEdgeStatusV1
    connection: ToolingConnectionHandleV1
    response_json: text

pub struct ToolingLspAnalysisResultV1:
    status: ToolingEdgeStatusV1
    ticket: ToolingAnalysisTicketV1
    reused: bool

pub struct ToolingLspPublishResultV1:
    status: ToolingEdgeStatusV1
    canonical_result_id: text
    response_json: text

pub struct ToolingTestDescriptorV1:
    test_id: u64
    label: text
    document: ToolingDocumentSessionHandleV1
    revision: u64
    content_digest: KpfDigest256

pub struct ToolingTestDiscoveryResultV1:
    status: ToolingEdgeStatusV1
    response_json: text

pub struct ToolingTestRunResultV1:
    status: ToolingEdgeStatusV1
    ticket: ToolingAnalysisTicketV1
    reused: bool
    response_json: text

pub fn tooling_edge_status(status: ToolingDaemonStatusV1) -> ToolingEdgeStatusV1:
    match status:
        case ToolingDaemonStatusV1.Ok: ToolingEdgeStatusV1.Ok
        case ToolingDaemonStatusV1.UnsupportedProtocol: ToolingEdgeStatusV1.UnsupportedProtocol
        case ToolingDaemonStatusV1.RevisionStale: ToolingEdgeStatusV1.StaleRevision
        case ToolingDaemonStatusV1.Cancelled: ToolingEdgeStatusV1.Cancelled
        case ToolingDaemonStatusV1.CapacityExceeded: ToolingEdgeStatusV1.CapacityExceeded
        case _: ToolingEdgeStatusV1.Rejected
