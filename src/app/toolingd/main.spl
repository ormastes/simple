use std.cli.cli_util.{get_cli_args}
use app.toolingd.protocol.{TOOLINGD_PROTOCOL_MAJOR_V1, TOOLINGD_PROTOCOL_MINOR_V1}

fn main() -> i64:
    val args = get_cli_args()
    if args.len() == 0 or args[0] == "--help" or args[0] == "-h":
        print "toolingd --version"
        print "KPF tooling daemon protocol endpoint"
        return 0
    if args[0] == "--version" or args[0] == "-v":
        print "toolingd protocol {TOOLINGD_PROTOCOL_MAJOR_V1}.{TOOLINGD_PROTOCOL_MINOR_V1}"
        return 0
    print "toolingd: unsupported option"
    1
