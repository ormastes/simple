use std.common.kernel_plugin.ids.{KpfDigest256}
use std.common.lint_kernel.model.DiagnosticV1
use std.tooling_kernel.{ToolingDocumentSnapshotV1}

pub val TOOLINGD_PROTOCOL_MAJOR_V1: u32 = 1
pub val TOOLINGD_PROTOCOL_MINOR_V1: u32 = 0

pub enum ToolingDaemonStatusV1:
    Ok
    UnsupportedProtocol
    CapacityExceeded
    ConnectionNotFound
    DocumentNotFound
    RevisionStale
    SnapshotMismatch
    LanguageMismatch
    GenerationMismatch
    Cancelled
    Disconnected

pub struct ToolingProtocolVersionV1:
    major: u32
    minor: u32

pub struct ToolingConnectionHandleV1:
    slot: i64
    epoch: u64

pub struct ToolingDocumentSessionHandleV1:
    slot: i64
    epoch: u64
    connection: ToolingConnectionHandleV1

pub struct ToolingAnalysisTicketV1:
    slot: i64
    epoch: u64
    document: ToolingDocumentSessionHandleV1
    revision: u64
    content_digest: KpfDigest256

pub struct ToolingConnectResultV1:
    status: ToolingDaemonStatusV1
    connection: ToolingConnectionHandleV1
    negotiated: ToolingProtocolVersionV1

pub struct ToolingOpenDocumentSessionResultV1:
    status: ToolingDaemonStatusV1
    document: ToolingDocumentSessionHandleV1

pub struct ToolingBeginAnalysisResultV1:
    status: ToolingDaemonStatusV1
    ticket: ToolingAnalysisTicketV1

pub struct ToolingPublishDiagnosticsResultV1:
    status: ToolingDaemonStatusV1
    accepted_count: u32

pub struct ToolingOpenDocumentSessionV1:
    snapshot: ToolingDocumentSnapshotV1
    provider_generation: u64

pub struct ToolingBeginAnalysisV1:
    document: ToolingDocumentSessionHandleV1
    revision: u64
    content_digest: KpfDigest256

pub struct ToolingPublishDiagnosticsV1:
    ticket: ToolingAnalysisTicketV1
    diagnostics: [DiagnosticV1]

pub fn tooling_protocol_version_v1() -> ToolingProtocolVersionV1:
    ToolingProtocolVersionV1(major: TOOLINGD_PROTOCOL_MAJOR_V1, minor: TOOLINGD_PROTOCOL_MINOR_V1)

pub fn tooling_invalid_connection_v1() -> ToolingConnectionHandleV1:
    ToolingConnectionHandleV1(slot: -1, epoch: 0)

pub fn tooling_invalid_document_session_v1() -> ToolingDocumentSessionHandleV1:
    ToolingDocumentSessionHandleV1(slot: -1, epoch: 0, connection: tooling_invalid_connection_v1())

pub fn tooling_invalid_analysis_ticket_v1() -> ToolingAnalysisTicketV1:
    ToolingAnalysisTicketV1(slot: -1, epoch: 0, document: tooling_invalid_document_session_v1(), revision: 0, content_digest: KpfDigest256(w0: 0, w1: 0, w2: 0, w3: 0))
