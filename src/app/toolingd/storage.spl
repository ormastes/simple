"""Centralized storage projection for tooling daemon sessions and indexes."""

use std.common.storage_roots.{CanonicalPath, StableEnvironment, StoragePathError}
use std.nogc_sync_mut.storage_roots.tooling_paths.{tooling_workspace_path, tooling_shared_cache_path, tooling_child_environment}

pub fn toolingd_session_path(session: text, item: text) -> Result<CanonicalPath, StoragePathError>:
    tooling_workspace_path("toolingd", session, item)

pub fn toolingd_index_path(schema: text, identity: text) -> Result<CanonicalPath, StoragePathError>:
    tooling_shared_cache_path("toolingd-index", schema, identity)

pub fn toolingd_child_environment() -> Result<StableEnvironment, StoragePathError>:
    tooling_child_environment("simple:toolingd")
