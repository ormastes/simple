use app.spipe_knowledge_provider.transport_types.{ProviderTransportLimitsV1, provider_transport_limits_valid_v1}

# A protocol-1.0 payload remains segmented. The encoder validates the declared
# total once and never joins the segments into a second frame-sized allocation.
struct ProviderSegmentedBytesV1:
    segments: [[u8]]
    total_bytes: i64

struct ProviderFrameWriteLoanV1:
    bytes: [u8]
    offset: i64
    remaining_bytes: i64

fn _frame_hex_digit(value: i64) -> u8:
    if value < 10:
        return (48 + value).to_u8()
    (87 + value).to_u8()

fn _frame_header(payload_bytes: i64) -> [u8]:
    var header: [u8] = []
    var shift = 28
    while shift >= 0:
        val digit = (payload_bytes >> shift) & 15
        header.push(_frame_hex_digit(digit))
        shift = shift - 4
    header

class ProviderFrameEncoderV1:
    payload: ProviderSegmentedBytesV1
    limits: ProviderTransportLimitsV1
    header: [u8]
    var header_offset: i64
    var segment_index: i64
    var segment_offset: i64
    var written_bytes: i64
    var offer_active: bool
    var offered_bytes: i64

    static fn configured(payload: ProviderSegmentedBytesV1, limits: ProviderTransportLimitsV1) -> Result<ProviderFrameEncoderV1, text>:
        if not provider_transport_limits_valid_v1(limits):
            return Err("invalid_transport_limits")
        if payload.total_bytes < 0:
            return Err("invalid_payload_length")
        if payload.total_bytes > limits.max_frame_bytes:
            return Err("frame_too_large")
        # Eight hexadecimal digits can encode at most 2^32 - 1 bytes.
        if payload.total_bytes > 4294967295:
            return Err("frame_too_large")
        var exact_total: i64 = 0
        for segment in payload.segments:
            val segment_bytes = segment.len()
            if segment_bytes > payload.total_bytes - exact_total:
                return Err("payload_length_mismatch")
            exact_total = exact_total + segment_bytes
        if exact_total != payload.total_bytes:
            return Err("payload_length_mismatch")
        Ok(ProviderFrameEncoderV1(payload: payload, limits: limits,
            header: _frame_header(payload.total_bytes), header_offset: 0,
            segment_index: 0, segment_offset: 0, written_bytes: 0,
            offer_active: false, offered_bytes: 0))

    fn complete() -> bool:
        self.header_offset == 8 and self.written_bytes == self.payload.total_bytes

    me next_write(maximum_bytes: i64) -> ProviderFrameWriteLoanV1:
        self.offer_active = false
        self.offered_bytes = 0
        if maximum_bytes <= 0 or self.complete():
            return ProviderFrameWriteLoanV1(bytes: [], offset: 0,
                remaining_bytes: 0)
        var allowed = maximum_bytes
        if allowed > self.limits.write_chunk_bytes:
            allowed = self.limits.write_chunk_bytes
        if allowed <= 0:
            return ProviderFrameWriteLoanV1(bytes: [], offset: 0,
                remaining_bytes: 0)
        if self.header_offset < 8:
            val available = 8 - self.header_offset
            if allowed > available: allowed = available
            self.offer_active = true
            self.offered_bytes = allowed
            return ProviderFrameWriteLoanV1(bytes: self.header,
                offset: self.header_offset, remaining_bytes: allowed)
        var index = self.segment_index
        var offset = self.segment_offset
        while (index < self.payload.segments.len() and
                offset >= self.payload.segments[index].len()):
            index = index + 1
            offset = 0
        if index >= self.payload.segments.len():
            return ProviderFrameWriteLoanV1(bytes: [], offset: 0,
                remaining_bytes: 0)
        val segment = self.payload.segments[index]
        val available = segment.len() - offset
        if allowed > available: allowed = available
        self.offer_active = true
        self.offered_bytes = allowed
        ProviderFrameWriteLoanV1(bytes: segment, offset: offset,
            remaining_bytes: allowed)

    me advance(written_bytes: i64) -> Result<(), text>:
        if written_bytes < 0:
            return Err("invalid_write_progress")
        if not self.offer_active or written_bytes > self.offered_bytes:
            return Err("invalid_write_progress")
        if written_bytes == 0:
            return Ok(())
        if self.header_offset < 8:
            self.header_offset = self.header_offset + written_bytes
            self.offered_bytes = self.offered_bytes - written_bytes
            if self.offered_bytes == 0: self.offer_active = false
            return Ok(())
        while (self.segment_index < self.payload.segments.len() and
                self.segment_offset >= self.payload.segments[self.segment_index].len()):
            self.segment_index = self.segment_index + 1
            self.segment_offset = 0
        if self.segment_index >= self.payload.segments.len():
            return Err("invalid_write_progress")
        self.segment_offset = self.segment_offset + written_bytes
        self.written_bytes = self.written_bytes + written_bytes
        self.offered_bytes = self.offered_bytes - written_bytes
        if self.offered_bytes == 0: self.offer_active = false
        Ok(())
