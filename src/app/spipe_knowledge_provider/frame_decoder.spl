# Incremental protocol-1.0 frame decoder.
#
# The decoder owns the sole framing cursor. Each payload event moves one fresh,
# bounded chunk to the caller, so no unenforceable borrowed-array lifetime is
# claimed and the decoder never accumulates the complete payload.
use app.spipe_knowledge_provider.transport_types.{ProviderTransportLimitsV1, provider_transport_limits_valid_v1}

struct ProviderFrameCompletionV1:
    payload_bytes: i64
    first_header_at_ms: i64
    completed_at_ms: i64

struct ProviderFramePayloadChunkV1:
    bytes: [u8]
    offset: i64
    count: i64
    frame_payload_offset: i64

struct ProviderFrameDecodeEventV1:
    kind: text
    declared_payload_bytes: i64?
    payload: ProviderFramePayloadChunkV1?

impl ProviderFrameDecodeEventV1:
    static fn none_before_header() -> ProviderFrameDecodeEventV1:
        ProviderFrameDecodeEventV1(kind: "none",
            declared_payload_bytes: nil, payload: nil)

    static fn none_after_header(declared: i64) -> ProviderFrameDecodeEventV1:
        ProviderFrameDecodeEventV1(kind: "none",
            declared_payload_bytes: declared, payload: nil)

    static fn header(declared: i64) -> ProviderFrameDecodeEventV1:
        ProviderFrameDecodeEventV1(kind: "header",
            declared_payload_bytes: declared, payload: nil)

    static fn payload_event(declared: i64,
                            chunk: ProviderFramePayloadChunkV1) -> ProviderFrameDecodeEventV1:
        ProviderFrameDecodeEventV1(kind: "payload",
            declared_payload_bytes: declared, payload: chunk)

struct ProviderFrameDecodeStepV1:
    consumed_bytes: i64
    state: text
    event: ProviderFrameDecodeEventV1
    error_code: text

class ProviderFrameDecoderV1:
    limits: ProviderTransportLimitsV1
    var header_bytes: [u8]
    var header_bytes_read: i64
    var declared_payload_bytes: i64
    var payload_bytes_read: i64
    var first_header_at_ms: i64
    var completed_at_ms: i64
    var state_value: text

    static fn configured(limits: ProviderTransportLimitsV1) -> Result<ProviderFrameDecoderV1, text>:
        if not provider_transport_limits_valid_v1(limits):
            return Err("invalid_transport_limits")
        Ok(ProviderFrameDecoderV1(limits: limits, header_bytes: [],
            header_bytes_read: 0, declared_payload_bytes: 0,
            payload_bytes_read: 0, first_header_at_ms: 0,
            completed_at_ms: 0, state_value: "header"))

    fn state() -> text:
        self.state_value

    fn _event_none() -> ProviderFrameDecodeEventV1:
        if self.header_bytes_read < 8:
            return ProviderFrameDecodeEventV1.none_before_header()
        ProviderFrameDecodeEventV1.none_after_header(self.declared_payload_bytes)

    me _fail(consumed: i64, code: text) -> ProviderFrameDecodeStepV1:
        self.state_value = "error"
        ProviderFrameDecodeStepV1(consumed_bytes: consumed, state: self.state_value,
            event: self._event_none(), error_code: code)

    me push(bytes: [u8], offset: i64,
            observed_at_ms: i64) -> ProviderFrameDecodeStepV1:
        if self.state_value == "error":
            return ProviderFrameDecodeStepV1(consumed_bytes: 0,
                state: self.state_value, event: self._event_none(),
                error_code: "decoder_failed")
        if self.state_value == "complete":
            return ProviderFrameDecodeStepV1(consumed_bytes: 0,
                state: self.state_value, event: self._event_none(),
                error_code: "frame_complete")
        if offset < 0 or offset > bytes.len() or observed_at_ms < 0:
            return self._fail(0, "invalid_input")

        if self.header_bytes_read < 8:
            var consumed = 0
            while self.header_bytes_read < 8 and offset + consumed < bytes.len():
                val byte = bytes[offset + consumed]
                val valid_digit = (byte >= 48u8 and byte <= 57u8) or
                    (byte >= 97u8 and byte <= 102u8)
                if not valid_digit:
                    return self._fail(consumed + 1, "malformed_frame")
                if self.header_bytes_read == 0:
                    self.first_header_at_ms = observed_at_ms
                self.header_bytes.push(byte)
                self.header_bytes_read = self.header_bytes_read + 1
                consumed = consumed + 1
            if self.header_bytes_read < 8:
                return ProviderFrameDecodeStepV1(consumed_bytes: consumed,
                    state: self.state_value,
                    event: ProviderFrameDecodeEventV1.none_before_header(),
                    error_code: "")

            var declared = 0
            var i = 0
            while i < 8:
                val byte = self.header_bytes[i]
                val digit = if byte <= 57u8: (byte - 48u8) as i64 else: (byte - 97u8 + 10u8) as i64
                declared = declared * 16 + digit
                i = i + 1
            self.declared_payload_bytes = declared
            if declared > self.limits.max_frame_bytes:
                return self._fail(consumed, "frame_too_large")
            if declared == 0:
                self.completed_at_ms = observed_at_ms
                self.state_value = "complete"
            else:
                self.state_value = "payload"
            return ProviderFrameDecodeStepV1(consumed_bytes: consumed,
                state: self.state_value,
                event: ProviderFrameDecodeEventV1.header(declared),
                error_code: "")

        val remaining = self.declared_payload_bytes - self.payload_bytes_read
        val available = bytes.len() - offset
        var count = available
        if count > remaining: count = remaining
        if count > self.limits.read_chunk_bytes: count = self.limits.read_chunk_bytes
        if count <= 0:
            return ProviderFrameDecodeStepV1(consumed_bytes: 0,
                state: self.state_value, event: self._event_none(), error_code: "")

        var chunk_bytes: [u8] = []
        var i = 0
        while i < count:
            chunk_bytes.push(bytes[offset + i])
            i = i + 1
        val frame_offset = self.payload_bytes_read
        self.payload_bytes_read = self.payload_bytes_read + count
        if self.payload_bytes_read == self.declared_payload_bytes:
            self.completed_at_ms = observed_at_ms
            self.state_value = "complete"
        val chunk = ProviderFramePayloadChunkV1(bytes: chunk_bytes, offset: 0,
            count: count, frame_payload_offset: frame_offset)
        ProviderFrameDecodeStepV1(consumed_bytes: count, state: self.state_value,
            event: ProviderFrameDecodeEventV1.payload_event(
                self.declared_payload_bytes, chunk), error_code: "")

    me take_complete() -> Result<ProviderFrameCompletionV1, text>:
        if self.state_value != "complete": return Err("incomplete_frame")
        val completion = ProviderFrameCompletionV1(
            payload_bytes: self.declared_payload_bytes,
            first_header_at_ms: self.first_header_at_ms,
            completed_at_ms: self.completed_at_ms)
        self.header_bytes = []
        self.header_bytes_read = 0
        self.declared_payload_bytes = 0
        self.payload_bytes_read = 0
        self.first_header_at_ms = 0
        self.completed_at_ms = 0
        self.state_value = "header"
        Ok(completion)
