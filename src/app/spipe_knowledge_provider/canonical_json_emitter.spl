use app.spipe_knowledge_provider.response_plan.{ProviderResponsePlanV1, ProviderStepLimitsV1, ProviderWorkStepKindV1}
use app.spipe_knowledge_provider.response_plan.{PROVIDER_JSON_MAX_STEP_INSTRUCTIONS_V1, PROVIDER_JSON_MAX_STEP_BYTES_V1, PROVIDER_JSON_MAX_SEGMENT_BYTES_V1}
use app.spipe_knowledge_provider.response_plan.provider_response_plan_v1
use app.spipe_knowledge_provider.segmented_byte_sink.ProviderSegmentedByteSinkV1
use app.spipe_knowledge_provider.segmented_bytes.ProviderSegmentedBytesV1
use app.spipe_knowledge_provider.streaming_sha256.Sha256StreamV1
use app.spipe_knowledge_provider.work_control.{ProviderBudgetPort, ProviderCheckpointPort, ProviderCheckpointProgressV1}

struct ProviderJsonEmitCursorFrameV1:
    kind: text
    var members: i64

# This is the complete speculative state for byte generation. A step copies it
# once, advances only that trial, and publishes the copy only after every child
# capability accepts the identical scratch slice.
class ProviderJsonEmitCursorV1:
    var instruction_cursor: i64
    var stack: [ProviderJsonEmitCursorFrameV1]
    var started: bool
    var prefix: [u8]
    var prefix_cursor: i64
    var value_bytes: [u8]
    var value_cursor: i64
    var escaped: [u8]
    var escaped_cursor: i64
    var suffix: [u8]
    var suffix_cursor: i64

    static fn initial() -> ProviderJsonEmitCursorV1:
        ProviderJsonEmitCursorV1(instruction_cursor: 0, stack: [],
            started: false, prefix: [], prefix_cursor: 0,
            value_bytes: [], value_cursor: 0, escaped: [], escaped_cursor: 0,
            suffix: [], suffix_cursor: 0)

    fn complete(plan: ProviderResponsePlanV1) -> bool:
        self.instruction_cursor == plan.instructions.len() and not self.started

    me next_byte(plan: ProviderResponsePlanV1) -> u8?:
        if self.complete(plan): return nil
        if not self.started:
            val item = plan.instructions[self.instruction_cursor]
            self.prefix = []
            self.value_bytes = []
            self.suffix = []
            self.prefix_cursor = 0
            self.value_cursor = 0
            self.escaped = []
            self.escaped_cursor = 0
            self.suffix_cursor = 0
            if item.kind == "object_key":
                val top = self.stack.len() - 1
                if self.stack[top].members > 0: self.prefix.push(44u8)
                self.prefix.push(34u8)
                self.value_bytes = item.text_value.unwrap().bytes()
                self.suffix = [34u8, 58u8]
            else:
                val closes = item.kind == "object_close" or item.kind == "array_close"
                if not closes and self.stack.len() > 0 and
                        self.stack[self.stack.len() - 1].kind == "array" and
                        self.stack[self.stack.len() - 1].members > 0:
                    self.prefix.push(44u8)
                if item.kind == "object_open": self.suffix = [123u8]
                elif item.kind == "object_close": self.suffix = [125u8]
                elif item.kind == "array_open": self.suffix = [91u8]
                elif item.kind == "array_close": self.suffix = [93u8]
                elif item.kind == "string":
                    self.prefix.push(34u8)
                    self.value_bytes = item.text_value.unwrap().bytes()
                    self.suffix = [34u8]
                elif item.kind == "integer":
                    self.suffix = item.integer_value.unwrap().to_text().bytes()
                elif item.kind == "boolean":
                    self.suffix = (if item.boolean_value.unwrap(): "true" else: "false").bytes()
                else: self.suffix = "null".bytes()
            self.started = true

        if self.prefix_cursor < self.prefix.len():
            val byte = self.prefix[self.prefix_cursor]
            self.prefix_cursor = self.prefix_cursor + 1
            return byte
        if self.escaped_cursor < self.escaped.len():
            val byte = self.escaped[self.escaped_cursor]
            self.escaped_cursor = self.escaped_cursor + 1
            return byte
        if self.value_cursor < self.value_bytes.len():
            self.escaped = _emit_escape_byte(self.value_bytes[self.value_cursor])
            self.value_cursor = self.value_cursor + 1
            self.escaped_cursor = 1
            return self.escaped[0]

        # Every instruction has a non-empty suffix. Completing its final byte
        # also completes the event, so cap accounting cannot defer the event
        # into a zero-byte call.
        val byte = self.suffix[self.suffix_cursor]
        self.suffix_cursor = self.suffix_cursor + 1
        if self.suffix_cursor == self.suffix.len():
            val kind = plan.instructions[self.instruction_cursor].kind
            if kind == "object_open" or kind == "array_open":
                self.stack.push(ProviderJsonEmitCursorFrameV1(
                    kind: if kind == "object_open": "object" else: "array",
                    members: 0))
            elif kind == "object_close" or kind == "array_close":
                self.stack.pop()
                if self.stack.len() > 0:
                    val top = self.stack.len() - 1
                    self.stack[top].members = self.stack[top].members + 1
            elif kind != "object_key" and self.stack.len() > 0:
                val top = self.stack.len() - 1
                self.stack[top].members = self.stack[top].members + 1
            self.instruction_cursor = self.instruction_cursor + 1
            self.started = false
        byte

struct ProviderCanonicalJsonOutputV1:
    bytes: ProviderSegmentedBytesV1
    payload_sha256: text

fn _emit_escape_byte(byte: u8) -> [u8]:
    if byte == 34u8: return [92u8, 34u8]
    if byte == 92u8: return [92u8, 92u8]
    if byte == 8u8: return [92u8, 98u8]
    if byte == 9u8: return [92u8, 116u8]
    if byte == 10u8: return [92u8, 110u8]
    if byte == 12u8: return [92u8, 102u8]
    if byte == 13u8: return [92u8, 114u8]
    if byte < 32u8:
        val digits = "0123456789abcdef".bytes()
        return [92u8, 117u8, 48u8, 48u8,
            digits[(byte as i64) / 16], digits[(byte as i64) % 16]]
    [byte]

fn _emit_update_blocks(partial_length: i64, count: i64) -> i64:
    (partial_length + count) / 64

fn _emit_finish_blocks(partial_length: i64) -> i64:
    if partial_length > 55: 2 else: 1

fn _emit_hash_bounded_bytes(partial_length: i64, maximum_blocks: i64) -> i64:
    # A 4096-byte step can compress at most 64 data blocks. The larger bound
    # lets the normal byte quantum remain authoritative without arithmetic on
    # an untrusted enormous requested block limit.
    var blocks = maximum_blocks
    if blocks > 64: blocks = 64
    ((blocks + 1) * 64 - 1) - partial_length

# Deterministic port-boundary fault plan used by focused verification and by
# owner-level fault campaigns. The index is the number of fully committed
# chunks before the targeted call, so a failed trial never advances it.
struct ProviderEmitterFaultInjectionV1:
    stage: text
    chunk_index: i64
    reason: text

fn _emit_fault_valid(fault: ProviderEmitterFaultInjectionV1) -> bool:
    (fault.stage == "sink" or fault.stage == "sha_update" or
        fault.stage == "checkpoint" or fault.stage == "sha_finalize") and
        fault.chunk_index >= 0 and fault.reason != ""

class ProviderCanonicalJsonEmitterV1:
    plan: ProviderResponsePlanV1
    var cursor: ProviderJsonEmitCursorV1
    var emitted_total: i64
    # The emitter is the sole operational owner after configured returns.
    # Step trials are isolated value copies and are discarded on any failure.
    var sink: ProviderSegmentedByteSinkV1
    var sha: Sha256StreamV1
    var budget: ProviderBudgetPort
    var checkpoint: ProviderCheckpointPort
    var digest: text
    fault: ProviderEmitterFaultInjectionV1?
    var committed_chunks: i64
    var terminal_kind: text
    var terminal_reason: text

    static fn configured(plan: ProviderResponsePlanV1, segment_bytes: i64,
                         sha: Sha256StreamV1, budget: ProviderBudgetPort,
                         checkpoint: ProviderCheckpointPort) -> Result<ProviderCanonicalJsonEmitterV1, text>:
        ProviderCanonicalJsonEmitterV1.configured_with_fault(plan,
            segment_bytes, sha, budget, checkpoint, nil)

    static fn configured_with_fault(plan: ProviderResponsePlanV1,
                         segment_bytes: i64, sha: Sha256StreamV1,
                         budget: ProviderBudgetPort,
                         checkpoint: ProviderCheckpointPort,
                         fault: ProviderEmitterFaultInjectionV1?) \
            -> Result<ProviderCanonicalJsonEmitterV1, text>:
        val checked_plan = provider_response_plan_v1(
            plan.instructions, plan.maximum_output_bytes)?
        if checked_plan.predicted_encoded_bytes != plan.predicted_encoded_bytes:
            return Err("invalid_response_plan")
        if segment_bytes <= 0 or segment_bytes > PROVIDER_JSON_MAX_SEGMENT_BYTES_V1:
            return Err("invalid_sink_limits")
        if val configured_fault = fault:
            if not _emit_fault_valid(configured_fault):
                return Err("invalid_fault_injection")
        val sink = ProviderSegmentedByteSinkV1.configured(
            segment_bytes, checked_plan.maximum_output_bytes)?
        Ok(ProviderCanonicalJsonEmitterV1(plan: checked_plan,
            cursor: ProviderJsonEmitCursorV1.initial(), emitted_total: 0,
            sink: sink, sha: sha, budget: budget, checkpoint: checkpoint,
            digest: "", fault: fault, committed_chunks: 0,
            terminal_kind: "", terminal_reason: ""))

    fn _fault_reason(stage: text) -> text?:
        if val injected = self.fault:
            if injected.stage == stage and
                    injected.chunk_index == self.committed_chunks:
                return injected.reason
        nil

    me _failed(reason: text) -> Result<ProviderWorkStepKindV1, text>:
        if self.terminal_kind == "":
            self.terminal_kind = "failed"
            self.terminal_reason = reason
            # Previously committed staging becomes unreachable; trial child
            # mutations were never installed on this owner.
            self.sink.segments = []
            self.sink.byte_count = 0
            self.digest = ""
        Err(self.terminal_reason)

    me step(limits: ProviderStepLimitsV1) -> Result<ProviderWorkStepKindV1, text>:
        if self.terminal_kind == "failed": return Err(self.terminal_reason)
        if self.terminal_kind == "taken": return Err("json_output_taken")
        if self.terminal_kind == "ready":
            return Ok(ProviderWorkStepKindV1(kind: "ready",
                produced_bytes: 0, produced_events: 0))
        if limits.max_bytes <= 0 or limits.max_json_events <= 0 or
                limits.max_unicode_scalars <= 0 or limits.max_sha_blocks <= 0 or
                limits.max_comparisons <= 0 or limits.max_output_bytes <= 0:
            return self._failed("invalid_step_limits")
        if self.emitted_total < 0 or
                self.emitted_total > self.plan.predicted_encoded_bytes:
            return self._failed("invalid_response_plan")

        var byte_limit = limits.max_bytes
        if byte_limit > limits.max_output_bytes: byte_limit = limits.max_output_bytes
        if byte_limit > PROVIDER_JSON_MAX_STEP_BYTES_V1:
            byte_limit = PROVIDER_JSON_MAX_STEP_BYTES_V1
        val remaining = self.plan.predicted_encoded_bytes - self.emitted_total
        if byte_limit > remaining: byte_limit = remaining
        val hash_byte_limit = _emit_hash_bounded_bytes(
            self.sha.partial_length, limits.max_sha_blocks)
        if byte_limit > hash_byte_limit: byte_limit = hash_byte_limit

        var event_limit = limits.max_json_events
        if event_limit > PROVIDER_JSON_MAX_STEP_INSTRUCTIONS_V1:
            event_limit = PROVIDER_JSON_MAX_STEP_INSTRUCTIONS_V1
        val first_instruction = self.cursor.instruction_cursor
        var trial_cursor = self.cursor
        var scratch: [u8] = []
        while scratch.len() < byte_limit and
                trial_cursor.instruction_cursor - first_instruction < event_limit:
            val maybe_next = trial_cursor.next_byte(self.plan)
            if maybe_next == nil: break
            scratch.push(maybe_next.unwrap())
        val events = trial_cursor.instruction_cursor - first_instruction
        if scratch.len() == 0:
            return self._failed("json_emit_no_progress")

        if scratch.len() > remaining:
            return self._failed("invalid_response_plan")
        val prospective_total = self.emitted_total + scratch.len()
        val done = trial_cursor.complete(self.plan)
        if done and prospective_total != self.plan.predicted_encoded_bytes:
            return self._failed("invalid_response_plan")
        if not done and prospective_total == self.plan.predicted_encoded_bytes:
            return self._failed("invalid_response_plan")

        val update_blocks = _emit_update_blocks(self.sha.partial_length, scratch.len())
        var required_blocks = update_blocks
        if done:
            val partial_after = (self.sha.partial_length + scratch.len()) % 64
            required_blocks = required_blocks + _emit_finish_blocks(partial_after)
        if required_blocks > limits.max_sha_blocks:
            return self._failed("limit_exceeded")

        # Child-created result pattern: none of these copies is installed on
        # the canonical emitter until the whole deterministic fan-out passes.
        var trial_sink = self.sink
        var trial_sha = self.sha
        var trial_budget = self.budget
        var trial_checkpoint = self.checkpoint
        val sink_fault = self._fault_reason("sink")
        if sink_fault != nil: return self._failed(sink_fault.unwrap())
        val appended = trial_sink.append(scratch, 0, scratch.len(), trial_budget)
        if appended.is_err(): return self._failed(appended.unwrap_err())
        val update_fault = self._fault_reason("sha_update")
        if update_fault != nil: return self._failed(update_fault.unwrap())
        val hashed = trial_sha.update_bounded(
            scratch, 0, scratch.len(), trial_budget, trial_checkpoint)
        if hashed.is_err(): return self._failed(hashed.unwrap_err())
        val checkpoint_fault = self._fault_reason("checkpoint")
        if checkpoint_fault != nil:
            return self._failed(checkpoint_fault.unwrap())
        val checked = trial_checkpoint.checkpoint(ProviderCheckpointProgressV1(
            stage: "canonical_json_emit", bytes: scratch.len(), events: events,
            scalars: 0, hash_blocks: update_blocks, comparisons: 0))
        if checked.is_err(): return self._failed(checked.unwrap_err())

        var trial_digest = ""
        if done:
            if prospective_total != self.plan.predicted_encoded_bytes or
                    trial_sink.total_bytes() != self.plan.predicted_encoded_bytes:
                return self._failed("invalid_response_plan")
            val finalize_fault = self._fault_reason("sha_finalize")
            if finalize_fault != nil:
                return self._failed(finalize_fault.unwrap())
            val finalized = trial_sha.finish(trial_budget, trial_checkpoint)
            if finalized.is_err(): return self._failed(finalized.unwrap_err())
            trial_digest = finalized.unwrap()

        # The only commit point. Cursor (including stack/escape substate),
        # sink, SHA, budget, checkpoint, count, and digest advance together.
        self.cursor = trial_cursor
        self.sink = trial_sink
        self.sha = trial_sha
        self.budget = trial_budget
        self.checkpoint = trial_checkpoint
        self.emitted_total = prospective_total
        self.committed_chunks = self.committed_chunks + 1
        if done:
            self.digest = trial_digest
            self.terminal_kind = "ready"
        Ok(ProviderWorkStepKindV1(kind: if done: "ready" else: "continue",
            produced_bytes: scratch.len(), produced_events: events))

    fn is_ready() -> bool: self.terminal_kind == "ready"
    fn publishable() -> bool:
        self.terminal_kind == "ready" and
            self.emitted_total == self.plan.predicted_encoded_bytes and
            self.sink.total_bytes() == self.plan.predicted_encoded_bytes
    fn failure_reason() -> text: self.terminal_reason
    fn total_bytes() -> i64: self.emitted_total

    me take() -> Result<ProviderCanonicalJsonOutputV1, text>:
        if self.terminal_kind == "failed": return Err(self.terminal_reason)
        if self.terminal_kind == "taken": return Err("json_output_taken")
        if not self.publishable(): return Err("json_output_not_ready")
        val owned_bytes = ProviderSegmentedBytesV1(
            segments: self.sink.segments, total_bytes: self.sink.byte_count)
        val owned_digest = self.digest
        self.sink.segments = []
        self.sink.byte_count = 0
        self.digest = ""
        self.terminal_kind = "taken"
        Ok(ProviderCanonicalJsonOutputV1(bytes: owned_bytes,
            payload_sha256: owned_digest))

export ProviderCanonicalJsonEmitterV1, ProviderCanonicalJsonOutputV1
export ProviderEmitterFaultInjectionV1
