use app.spipe_knowledge_provider.lexical.{apply_snapshot_delta_controlled}
use app.spipe_knowledge_provider.durable_records.{response_hash, candidate_commitment_preimage, candidate_root_from_commitment}
use std.common.search.snapshot.{SearchSnapshot, SearchIndexDelta}
use app.spipe_knowledge_provider.query_clock.{QueryClockPort, SystemQueryClockV1, query_stop_reason}

fn _candidate_check(clock: QueryClockPort, request_id: text,
                    admitted_at_ms: i64,
                    deadline_ms: i64) -> Result<(), text>:
    val reason = query_stop_reason(clock, request_id, admitted_at_ms, deadline_ms)
    if reason != "": return Err(reason)
    Ok(())

# Pure candidate construction capsule.  It receives immutable current-state
# arrays and returns an owner result; durable mutation remains service-owned.
class CandidateBindingV1:
    static fn document_bindings_controlled(snapshot: SearchSnapshot,
                                current_document_ids: [text],
                                current_document_hashes: [text],
                                current_document_hash_preimages: [text],
                                delta: SearchIndexDelta, revision: text,
                                operation_ids: [text], operation_hashes: [text],
                                operation_hash_preimages: [text],
                                request_id: text, admitted_at_ms: i64,
                                deadline_ms: i64,
                                clock: QueryClockPort) -> Result<(SearchSnapshot, [text], [text]), text>:
        _candidate_check(clock, request_id, admitted_at_ms, deadline_ms)?
        if operation_ids.len() != operation_hashes.len() or
                operation_ids.len() != operation_hash_preimages.len():
            return Err("invalid_request")
        val staged = apply_snapshot_delta_controlled(snapshot, delta, "",
            revision, request_id, admitted_at_ms, deadline_ms, clock)?
        var hashes: [text] = []
        var hash_preimages: [text] = []
        var d = 0
        while d < staged.documents.len():
            _candidate_check(clock, request_id, admitted_at_ms, deadline_ms)?
            val id = staged.documents[d].id
            var hash = ""
            var hash_preimage = ""
            var current = 0
            while current < current_document_ids.len():
                _candidate_check(clock, request_id, admitted_at_ms, deadline_ms)?
                if current_document_ids[current] == id:
                    if current < current_document_hashes.len():
                        hash = current_document_hashes[current]
                    if current < current_document_hash_preimages.len():
                        hash_preimage = current_document_hash_preimages[current]
                current = current + 1
            var i = 0
            while i < operation_ids.len():
                _candidate_check(clock, request_id, admitted_at_ms, deadline_ms)?
                if operation_ids[i] == id:
                    hash = operation_hashes[i]
                    hash_preimage = operation_hash_preimages[i]
                i = i + 1
            _candidate_check(clock, request_id, admitted_at_ms, deadline_ms)?
            if hash == "" or hash_preimage == "" or
                    response_hash(hash_preimage) != hash:
                return Err("snapshot_corrupt")
            hashes.push(hash)
            hash_preimages.push(hash_preimage)
            d = d + 1
        Ok((staged, hashes, hash_preimages))

    static fn document_bindings(snapshot: SearchSnapshot,
                                current_document_ids: [text],
                                current_document_hashes: [text],
                                current_document_hash_preimages: [text],
                                delta: SearchIndexDelta, revision: text,
                                operation_ids: [text], operation_hashes: [text],
                                operation_hash_preimages: [text]) -> Result<(SearchSnapshot, [text], [text]), text>:
        CandidateBindingV1.document_bindings_controlled(snapshot,
            current_document_ids, current_document_hashes,
            current_document_hash_preimages, delta, revision, operation_ids,
            operation_hashes, operation_hash_preimages, "", -1, 0,
            SystemQueryClockV1.configured())

    static fn transition_binding_controlled(base_root: text,
                                 snapshot: SearchSnapshot,
                                 current_document_ids: [text],
                                 current_document_hashes: [text],
                                 current_document_hash_preimages: [text],
                                 delta: SearchIndexDelta,
                                 operations_preimage: text, outcome: text,
                                 operation_ids: [text], operation_hashes: [text],
                                 operation_hash_preimages: [text],
                                 request_id: text, admitted_at_ms: i64,
                                 deadline_ms: i64,
                                 clock: QueryClockPort) -> Result<(text, text), text>:
        val bound = CandidateBindingV1.document_bindings_controlled(snapshot,
            current_document_ids, current_document_hashes,
            current_document_hash_preimages, delta, "candidate",
            operation_ids, operation_hashes, operation_hash_preimages,
            request_id, admitted_at_ms, deadline_ms, clock)?
        _candidate_check(clock, request_id, admitted_at_ms, deadline_ms)?
        val preimage = candidate_commitment_preimage(operations_preimage,
            bound.0.documents, bound.1)?
        _candidate_check(clock, request_id, admitted_at_ms, deadline_ms)?
        val root = candidate_root_from_commitment(base_root, outcome, preimage)?
        _candidate_check(clock, request_id, admitted_at_ms, deadline_ms)?
        Ok((root, preimage))

    static fn transition_binding(base_root: text, snapshot: SearchSnapshot,
                                 current_document_ids: [text],
                                 current_document_hashes: [text],
                                 current_document_hash_preimages: [text],
                                 delta: SearchIndexDelta,
                                 operations_preimage: text, outcome: text,
                                 operation_ids: [text], operation_hashes: [text],
                                 operation_hash_preimages: [text]) -> Result<(text, text), text>:
        CandidateBindingV1.transition_binding_controlled(base_root, snapshot,
            current_document_ids, current_document_hashes,
            current_document_hash_preimages, delta, operations_preimage,
            outcome, operation_ids, operation_hashes,
            operation_hash_preimages, "", -1, 0,
            SystemQueryClockV1.configured())
