# Public wire ownership and host-binding types.
use app.spipe_knowledge_provider.protocol.{provider_encode_frame}
use app.spipe_knowledge_provider.service.{SpipeProviderServiceV1}
use app.spipe_knowledge_provider.wire_json.{wire_valid_workspace_id, wire_valid_snapshot_id, wire_valid_hash}

struct ProviderWireDispatchV1:
    write_response: bool
    close_transport: bool
    stop_after_write: bool
    frame: text

struct ProviderWireOwnedDispatchV1:
    service: SpipeProviderServiceV1
    outcome: ProviderWireDispatchV1

struct ProviderHostBindingV1:
    workspace: text
    snapshot_id: text
    scope_digest: text
    provider_generation: i64

impl ProviderHostBindingV1:
    static fn create(workspace: text, snapshot_id: text,
                     scope_digest: text) -> Result<ProviderHostBindingV1, text>:
        if not wire_valid_workspace_id(workspace) or
                not wire_valid_snapshot_id(snapshot_id) or
                not wire_valid_hash(scope_digest):
            return Err("invalid_host_binding")
        Ok(ProviderHostBindingV1(workspace: workspace,
            snapshot_id: snapshot_id, scope_digest: scope_digest,
            provider_generation: 1))

    static fn create_with_generation(workspace: text, snapshot_id: text,
                                     scope_digest: text,
                                     provider_generation: i64) -> Result<ProviderHostBindingV1, text>:
        if not wire_valid_workspace_id(workspace) or
                not wire_valid_snapshot_id(snapshot_id) or
                not wire_valid_hash(scope_digest) or provider_generation <= 0:
            return Err("invalid_host_binding")
        Ok(ProviderHostBindingV1(workspace: workspace,
            snapshot_id: snapshot_id, scope_digest: scope_digest,
            provider_generation: provider_generation))

struct ProviderCandidateExpiryOwnedV1:
    service: SpipeProviderServiceV1
    receipt: text

struct ProviderInitializeCanonicalV1:
    request_id: text
    operation: text

struct ProviderInitializeBindingV1:
    request_id: text
    workspace: text
    snapshot_id: text
    scope_digest: text
    logical_root: text
    provider_generation: i64

impl ProviderWireDispatchV1:
    static fn silent_close() -> ProviderWireDispatchV1:
        ProviderWireDispatchV1(write_response: false, close_transport: true, stop_after_write: false, frame: "")

    static fn response(payload: text, stop: bool) -> ProviderWireDispatchV1:
        val framed = provider_encode_frame(payload)
        if val Ok(frame) = framed:
            return ProviderWireDispatchV1(write_response: true, close_transport: false, stop_after_write: stop, frame: frame)
        ProviderWireDispatchV1.silent_close()

fn provider_owned_silent(service: SpipeProviderServiceV1) -> ProviderWireOwnedDispatchV1:
    ProviderWireOwnedDispatchV1(service: service,
        outcome: ProviderWireDispatchV1.silent_close())

fn provider_owned_response(payload: text, stop: bool,
                           service: SpipeProviderServiceV1) -> ProviderWireOwnedDispatchV1:
    ProviderWireOwnedDispatchV1(service: service,
        outcome: ProviderWireDispatchV1.response(payload, stop))
