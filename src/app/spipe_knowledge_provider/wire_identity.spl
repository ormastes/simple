# Canonical candidate identity contract.
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.string_core.{text_to_bytes}
use app.spipe_knowledge_provider.wire_json.{wire_json_string}

fn candidate_uid_domain_bytes(canonical: text) -> [u8]:
    var bytes = text_to_bytes("SPKC-CANDIDATE-UID-V1\0")
    val size = canonical.bytes().len()
    var shift = 56
    while shift >= 0:
        bytes.push(((size >> shift) & 255) as u8)
        shift = shift - 8
    val payload = canonical.bytes()
    var i = 0
    while i < payload.len():
        bytes.push(payload[i])
        i = i + 1
    bytes

fn candidate_uid_preimage(workspace: text, snapshot: text, scope_digest: text,
                          base_logical_root: text, candidate_logical_root: text,
                          apply_payload_hash: text) -> text:
    "{\"apply_payload_hash\":" + wire_json_string(apply_payload_hash) +
        ",\"base_logical_root\":" + wire_json_string(base_logical_root) +
        ",\"candidate_logical_root\":" + wire_json_string(candidate_logical_root) +
        ",\"scope_digest\":" + wire_json_string(scope_digest) +
        ",\"snapshot\":" + wire_json_string(snapshot) +
        ",\"workspace\":" + wire_json_string(workspace) + "}"

fn provider_candidate_uid(workspace: text, snapshot: text, scope_digest: text,
                          base_logical_root: text, candidate_logical_root: text,
                          apply_payload_hash: text) -> text:
    val record = candidate_uid_preimage(workspace, snapshot, scope_digest,
        base_logical_root, candidate_logical_root, apply_payload_hash)
    "cand-" + sha256_u8_hex(candidate_uid_domain_bytes(record))

export candidate_uid_preimage, candidate_uid_domain_bytes, provider_candidate_uid
