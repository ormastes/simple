# Single-owner request lifecycle authority for cooperative provider sessions.
# Handles and permits are immutable capabilities; only this owner mutates the
# bounded registry and closes cancellation/deadline eligibility.
use app.spipe_knowledge_provider.query_clock.{QueryClockPort}
use app.spipe_knowledge_provider.work_control.{ProviderRequestControlHandleV1}
use app.spipe_knowledge_provider.wire_json.{wire_valid_id, wire_valid_hash}

struct ProviderCommitAdmissionPermitV1:
    request_id: text
    registration_generation: i64
    intent_hash: text
    permit_id: text

struct ProviderCancelResultV1:
    disposition: text
    target_request_id: text

trait ProviderRequestControlPort:
    me register(request_id: text, first_header_at_ms: i64,
                requested_deadline_ms: i64,
                intent_hash: text) -> Result<ProviderRequestControlHandleV1, text>
    me cancel(cancel_request_id: text,
              target_request_id: text) -> Result<ProviderCancelResultV1, text>
    me try_commit_admission(request: ProviderRequestControlHandleV1,
                            intent_hash: text) -> Result<ProviderCommitAdmissionPermitV1, text>
    me complete(permit: ProviderCommitAdmissionPermitV1,
                outcome_hash: text) -> Result<(), text>

# The session/bootstrap composition owns the token authority. Request workers
# never receive it, so a handle and intent hash are insufficient to fabricate
# an admission permit.
trait ProviderPermitAuthorityPort:
    me issue(request_id: text, registration_generation: i64,
             intent_hash: text) -> Result<text, text>

class ProviderRequestControlOwnerV1 with ProviderRequestControlPort:
    clock: QueryClockPort
    maximum_requests: i64
    permit_authority: ProviderPermitAuthorityPort
    var next_generation: i64
    var request_ids: [text]
    var generations: [i64]
    var intent_hashes: [text]
    var first_header_times_ms: [i64]
    var requested_deadlines_ms: [i64]
    var absolute_deadlines_ms: [i64]
    var last_clock_observations_ms: [i64]
    var deadline_closed: [bool]
    var states: [text]
    var permit_ids: [text]
    var outcome_hashes: [text]

    static fn configured(clock: QueryClockPort,
                         maximum_requests: i64,
                         permit_authority: ProviderPermitAuthorityPort) -> Result<ProviderRequestControlOwnerV1, text>:
        if maximum_requests <= 0: return Err("invalid_request_capacity")
        Ok(ProviderRequestControlOwnerV1(clock: clock,
            maximum_requests: maximum_requests,
            permit_authority: permit_authority,
            next_generation: 1,
            request_ids: [], generations: [], intent_hashes: [],
            first_header_times_ms: [], requested_deadlines_ms: [],
            absolute_deadlines_ms: [], last_clock_observations_ms: [],
            deadline_closed: [], states: [], permit_ids: [],
            outcome_hashes: []))

    fn _index(request_id: text) -> i64:
        for i in 0..self.request_ids.len():
            if self.request_ids[i] == request_id: return i
        -1

    me register(request_id: text, first_header_at_ms: i64,
                requested_deadline_ms: i64,
                intent_hash: text) -> Result<ProviderRequestControlHandleV1, text>:
        if not wire_valid_id(request_id) or not wire_valid_hash(intent_hash):
            return Err("invalid_request_registration")
        if requested_deadline_ms < 1 or requested_deadline_ms > 30000:
            return Err("invalid_request_deadline")
        if first_header_at_ms < 0 or
            first_header_at_ms > 9223372036854775807 - requested_deadline_ms:
            return Err("request_deadline_overflow")
        if self._index(request_id) >= 0: return Err("duplicate_request_id")
        if self.request_ids.len() >= self.maximum_requests:
            return Err("request_registry_full")
        if self.next_generation <= 0 or
            self.next_generation == 9223372036854775807:
            return Err("request_generation_exhausted")

        val absolute_deadline = first_header_at_ms + requested_deadline_ms
        val observed_at = self.clock.now_ms()
        if observed_at < first_header_at_ms: return Err("monotonic_clock_error")
        if observed_at >= absolute_deadline: return Err("deadline_exceeded")

        val generation = self.next_generation
        self.request_ids.push(request_id)
        self.generations.push(generation)
        self.intent_hashes.push(intent_hash)
        self.first_header_times_ms.push(first_header_at_ms)
        self.requested_deadlines_ms.push(requested_deadline_ms)
        self.absolute_deadlines_ms.push(absolute_deadline)
        self.last_clock_observations_ms.push(observed_at)
        self.deadline_closed.push(false)
        self.states.push("running")
        self.permit_ids.push("")
        self.outcome_hashes.push("")
        self.next_generation = generation + 1
        Ok(ProviderRequestControlHandleV1(request_id: request_id,
            registration_generation: generation))

    me cancel(cancel_request_id: text,
              target_request_id: text) -> Result<ProviderCancelResultV1, text>:
        if not wire_valid_id(cancel_request_id) or
            not wire_valid_id(target_request_id):
            return Err("invalid_cancel_request")
        val index = self._index(target_request_id)
        if index < 0:
            return Ok(ProviderCancelResultV1(disposition: "target_not_found",
                target_request_id: target_request_id))
        val state = self.states[index]
        if state == "cancel_requested" or state == "commit_admitted" or
            state == "completed":
            return Ok(ProviderCancelResultV1(disposition: "already_complete",
                target_request_id: target_request_id))
        if state != "registered" and state != "running":
            return Err("invalid_request_state")
        self.states[index] = "cancel_requested"
        Ok(ProviderCancelResultV1(disposition: "cancelled",
            target_request_id: target_request_id))

    me try_commit_admission(request: ProviderRequestControlHandleV1,
                            intent_hash: text) -> Result<ProviderCommitAdmissionPermitV1, text>:
        val index = self._index(request.request_id)
        if index < 0 or request.registration_generation <= 0 or
            self.generations[index] != request.registration_generation:
            return Err("invalid_request_control_handle")
        if not wire_valid_hash(intent_hash) or
            self.intent_hashes[index] != intent_hash:
            return Err("intent_hash_mismatch")

        # Cancellation wins when cancellation and deadline are both visible.
        val state = self.states[index]
        if state == "cancel_requested": return Err("cancelled")
        if state == "commit_admitted" or state == "completed":
            return Err("already_complete")
        if state != "registered" and state != "running":
            return Err("invalid_request_state")
        if self.deadline_closed[index]: return Err("deadline_exceeded")

        val observed_at = self.clock.now_ms()
        if observed_at < self.last_clock_observations_ms[index]:
            return Err("monotonic_clock_error")
        # Record every accepted observation, including an expired one. A later
        # regressing clock therefore cannot resurrect deadline eligibility.
        self.last_clock_observations_ms[index] = observed_at
        if observed_at >= self.absolute_deadlines_ms[index]:
            self.deadline_closed[index] = true
            return Err("deadline_exceeded")

        val permit_id = self.permit_authority.issue(request.request_id,
            request.registration_generation, intent_hash)?
        if not wire_valid_id(permit_id): return Err("invalid_permit_authority")
        for existing in self.permit_ids:
            if existing != "" and existing == permit_id:
                return Err("duplicate_permit_id")
        self.permit_ids[index] = permit_id
        self.states[index] = "commit_admitted"
        Ok(ProviderCommitAdmissionPermitV1(request_id: request.request_id,
            registration_generation: request.registration_generation,
            intent_hash: intent_hash, permit_id: permit_id))

    me complete(permit: ProviderCommitAdmissionPermitV1,
                outcome_hash: text) -> Result<(), text>:
        val index = self._index(permit.request_id)
        if index < 0 or permit.registration_generation <= 0 or
            self.generations[index] != permit.registration_generation:
            return Err("invalid_commit_admission_permit")
        if not wire_valid_hash(permit.intent_hash) or
            self.intent_hashes[index] != permit.intent_hash or
            permit.permit_id == "" or self.permit_ids[index] != permit.permit_id:
            return Err("invalid_commit_admission_permit")
        if not wire_valid_hash(outcome_hash): return Err("invalid_outcome_hash")
        if self.states[index] == "completed": return Err("already_complete")
        if self.states[index] != "commit_admitted":
            return Err("invalid_request_state")
        self.outcome_hashes[index] = outcome_hash
        self.states[index] = "completed"
        Ok(())

    fn request_state(request_id: text) -> text:
        val index = self._index(request_id)
        if index < 0: return "unknown"
        self.states[index]

    fn recorded_outcome_hash(request_id: text) -> text:
        val index = self._index(request_id)
        if index < 0: return ""
        self.outcome_hashes[index]

    fn request_count() -> i64: self.request_ids.len()

export ProviderCommitAdmissionPermitV1, ProviderCancelResultV1
export ProviderPermitAuthorityPort
export ProviderRequestControlPort, ProviderRequestControlOwnerV1
