# Query receipt, cursor, pagination, filter, explanation, and statistics owner.
use std.common.json.parser.{json_parse_with_error}
use std.common.json.object_ops.{json_object_get}
use std.common.json.array_ops.{json_array_get, json_array_length}
use std.common.json.types.{json_get_type, json_to_string}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.string_core.{text_to_bytes}
use std.common.base_encoding.base64.{base64url_encode, base64url_decode_strict}
use std.common.search.generated.unicode_17_0_0.{unicode_normalize_nfc}
use std.common.search.analyzer.{analyze_text}
use std.common.search.document.{SearchFacet, SearchHit}
use std.common.search.query.{SearchQuery}
use std.io_runtime.{time_now_monotonic_ms, platform_name}
use app.io.sysinfo_ops.{process_peak_rss_kb}
use app.spipe_knowledge_provider.lifecycle.{provider_generation_id}
use app.spipe_knowledge_provider.service.{SpipeProviderServiceV1}
use app.spipe_knowledge_provider.lexical.{explain_snapshot_lexical_bounded, explain_snapshot_lexical_controlled, document_matches_query_controlled, matched_fields_snapshot_lexical, matched_fields_snapshot_lexical_controlled, search_snapshot_lexical_controlled}
use app.spipe_knowledge_provider.query_clock.{QueryClockPort, query_stop_reason}
use app.spipe_knowledge_provider.wire_types.{ProviderWireOwnedDispatchV1, provider_owned_response}
use app.spipe_knowledge_provider.wire_json.{wire_jtext, wire_jint, wire_jbool, wire_has_exact_keys, wire_valid_id, wire_valid_hash, wire_json_string, wire_canonical_json_value}

val MAX_QUERY_BYTES: i64 = 4096
val MAX_QUERY_TOKENS: i64 = 128
val MAX_EXPLANATION_BYTES_PER_HIT: i64 = 65536
val MAX_PAGE_BYTES: i64 = 524288

fn wire_explanation_exceeds_limit(explanation: text) -> bool:
    explanation.bytes().len() > MAX_EXPLANATION_BYTES_PER_HIT

fn wire_page_exceeds_limit(page: text) -> bool:
    page.bytes().len() > MAX_PAGE_BYTES

fn wire_stats_supported_on_platform(name: text) -> bool:
    # The current runtime counter is backed by Linux /proc/self/status.  Keep
    # the negotiated capability false everywhere else until that platform has
    # a measured owner implementation; a missing counter must never be
    # represented as a successful zero-valued statistic.
    name == "linux"

fn wire_stats_capability_available() -> bool:
    wire_stats_supported_on_platform(platform_name())

fn _valid_query_receipt_id(value: text) -> bool:
    value.bytes().len() == 67 and value.starts_with("qr-") and
        wire_valid_hash("sha256:" + value.substring(3))

fn _domain_bytes(domain: text, canonical: text) -> [u8]:
    var bytes = text_to_bytes(domain)
    val size = canonical.bytes().len()
    var shift = 56
    while shift >= 0:
        bytes.push(((size >> shift) & 255) as u8)
        shift = shift - 8
    val payload = canonical.bytes()
    var i = 0
    while i < payload.len():
        bytes.push(payload[i])
        i = i + 1
    bytes

fn _domain_hash(domain: text, canonical: text) -> text:
    "sha256:" + sha256_u8_hex(_domain_bytes(domain, canonical))

fn _query_hash(payload: any, operation: text) -> Result<text, text>:
    val canonical = "{\"operation\":" + wire_json_string(operation) +
        ",\"payload\":" + wire_canonical_json_value(payload)? + "}"
    Ok(_domain_hash("SPKC-QUERY-PAYLOAD-V1\0", canonical))

fn _search_binding_hash(payload: any) -> Result<text, text>:
    val canonical = "{\"explain\":" +
        (if wire_jbool(payload, "explain", false): "true" else: "false") +
        ",\"filters\":" + wire_canonical_json_value(json_object_get(payload, "filters"))? +
        ",\"limit\":" + wire_jint(payload, "limit", -1).to_text() +
        ",\"query_text\":" + wire_json_string(wire_jtext(payload, "query_text")) + "}"
    Ok(_domain_hash("SPKC-SEARCH-CURSOR-BINDING-V1\0", canonical))

fn wire_query_receipt_valid(service: SpipeProviderServiceV1, root: any,
                            operation: text, payload: any) -> bool:
    val receipt = json_object_get(root, "query_receipt")
    if not wire_has_exact_keys(receipt, ["schema", "receipt_id", "key_id", "authority_id", "authority_generation", "request_id", "operation", "provider_generation", "workspace", "snapshot", "scope_digest", "logical_root", "query_hash", "issued_at_ms", "expires_at_ms", "policy_version", "policy_digest", "revocation_generation", "signature"]):
        return false
    val query_hash = _query_hash(payload, operation)
    if val Err(_) = query_hash: return false
    val issued_at = wire_jint(receipt, "issued_at_ms", -1)
    val expires_at = wire_jint(receipt, "expires_at_ms", -1)
    val observed_at = service.receipt_authority.now_ms()
    if wire_jtext(receipt, "schema") != "spipe-query-receipt-v1" or
            not _valid_query_receipt_id(wire_jtext(receipt, "receipt_id")) or
            wire_jtext(receipt, "key_id") != service.receipt_authority.key_id() or
            wire_jtext(receipt, "authority_id") != service.receipt_authority.authority_id() or
            wire_jint(receipt, "authority_generation", -1) != service.receipt_authority.authority_generation() or
            wire_jtext(receipt, "request_id") != wire_jtext(root, "request_id") or
            wire_jtext(receipt, "operation") != operation or
            wire_jtext(receipt, "provider_generation") != provider_generation_id(service.state.provider_generation) or
            wire_jtext(receipt, "workspace") != service.state.workspace or
            wire_jtext(receipt, "snapshot") != service.state.snapshot_id or
            wire_jtext(receipt, "scope_digest") != service.state.scope_digest or
            wire_jtext(receipt, "logical_root") != service.state.logical_root or
            wire_jtext(receipt, "query_hash") != query_hash.unwrap() or
            wire_jtext(receipt, "policy_digest") != service.state.scope_digest or
            wire_jint(receipt, "policy_version", -1) != 1 or
            wire_jint(receipt, "revocation_generation", -1) != 0 or
            issued_at < 0 or expires_at < issued_at or issued_at > observed_at or
            expires_at < observed_at:
        return false
    val unsigned = "{\"authority_generation\":" + wire_jint(receipt, "authority_generation", -1).to_text() +
        ",\"authority_id\":" + wire_json_string(wire_jtext(receipt, "authority_id")) +
        ",\"expires_at_ms\":" + wire_jint(receipt, "expires_at_ms", -1).to_text() +
        ",\"issued_at_ms\":" + wire_jint(receipt, "issued_at_ms", -1).to_text() +
        ",\"key_id\":" + wire_json_string(wire_jtext(receipt, "key_id")) +
        ",\"logical_root\":" + wire_json_string(wire_jtext(receipt, "logical_root")) +
        ",\"operation\":" + wire_json_string(operation) +
        ",\"policy_digest\":" + wire_json_string(wire_jtext(receipt, "policy_digest")) +
        ",\"policy_version\":" + wire_jint(receipt, "policy_version", -1).to_text() +
        ",\"provider_generation\":" + wire_json_string(provider_generation_id(service.state.provider_generation)) +
        ",\"query_hash\":" + wire_json_string(query_hash.unwrap()) +
        ",\"request_id\":" + wire_json_string(wire_jtext(receipt, "request_id")) +
        ",\"revocation_generation\":" + wire_jint(receipt, "revocation_generation", -1).to_text() +
        ",\"schema\":\"spipe-query-receipt-v1\",\"scope_digest\":" + wire_json_string(service.state.scope_digest) +
        ",\"snapshot\":" + wire_json_string(service.state.snapshot_id) +
        ",\"workspace\":" + wire_json_string(service.state.workspace) + "}"
    val expected_id = _domain_hash("SPKC-QUERY-RECEIPT-V1\0", unsigned).replace("sha256:", "qr-")
    wire_jtext(receipt, "receipt_id") == expected_id and
        service.receipt_authority.verify(_domain_bytes("SPKC-QUERY-RECEIPT-V1\0", unsigned),
                                         wire_jtext(receipt, "signature"))

fn wire_echo_query_receipt(response: text, root: any) -> text:
    val receipt = wire_canonical_json_value(json_object_get(root, "query_receipt"))
    if val Ok(encoded) = receipt:
        return response.replace("\"query_receipt\":null", "\"query_receipt\":" + encoded)
    response

fn wire_sign_query_receipt(service: SpipeProviderServiceV1, request_id: text,
                           operation: text, canonical_payload: text) -> Result<text, text>:
    if not service.lifecycle_available() or (operation != "search" and operation != "explain"):
        return Err("provider_unavailable")
    val parsed = json_parse_with_error(canonical_payload)
    if parsed.1 != "" or json_get_type(parsed.0) != "object":
        return Err("invalid_request")
    val canonical = wire_canonical_json_value(parsed.0)?
    if canonical != canonical_payload: return Err("invalid_request")
    val query_hash = _query_hash(parsed.0, operation)?
    val issued_at = service.receipt_authority.now_ms()
    val expires_at = issued_at + 30000
    val unsigned = "{\"authority_generation\":" + service.receipt_authority.authority_generation().to_text() +
        ",\"authority_id\":" + wire_json_string(service.receipt_authority.authority_id()) +
        ",\"expires_at_ms\":" + expires_at.to_text() + ",\"issued_at_ms\":" + issued_at.to_text() +
        ",\"key_id\":" + wire_json_string(service.receipt_authority.key_id()) +
        ",\"logical_root\":" + wire_json_string(service.state.logical_root) +
        ",\"operation\":" + wire_json_string(operation) + ",\"policy_digest\":" + wire_json_string(service.state.scope_digest) +
        ",\"policy_version\":1,\"provider_generation\":" + wire_json_string(provider_generation_id(service.state.provider_generation)) +
        ",\"query_hash\":" + wire_json_string(query_hash) + ",\"request_id\":" + wire_json_string(request_id) +
        ",\"revocation_generation\":0,\"schema\":\"spipe-query-receipt-v1\",\"scope_digest\":" + wire_json_string(service.state.scope_digest) +
        ",\"snapshot\":" + wire_json_string(service.state.snapshot_id) + ",\"workspace\":" + wire_json_string(service.state.workspace) + "}"
    val receipt_id = _domain_hash("SPKC-QUERY-RECEIPT-V1\0", unsigned).replace("sha256:", "qr-")
    val signature = service.receipt_authority.sign(_domain_bytes("SPKC-QUERY-RECEIPT-V1\0", unsigned))?
    val with_id = unsigned.replace("\"request_id\":", "\"receipt_id\":" + wire_json_string(receipt_id) + ",\"request_id\":")
    Ok(with_id.replace("\"snapshot\":", "\"signature\":" + wire_json_string(signature) + ",\"snapshot\":"))

fn _unsigned_utf8_less(left: text, right: text) -> bool:
    val a = left.bytes()
    val b = right.bytes()
    var i = 0
    while i < a.len() and i < b.len():
        if a[i] < b[i]: return true
        if a[i] > b[i]: return false
        i = i + 1
    a.len() < b.len()

fn _query_check(clock: QueryClockPort, request_id: text,
                admitted_at_ms: i64, deadline_ms: i64) -> Result<(), text>:
    val reason = query_stop_reason(clock, request_id, admitted_at_ms, deadline_ms)
    if reason != "": return Err(reason)
    Ok(())

fn _decode_filters(payload: any, request_id: text,
                   admitted_at_ms: i64, deadline_ms: i64,
                   clock: QueryClockPort) -> Result<[SearchFacet], text>:
    val array = json_object_get(payload, "filters")
    if json_get_type(array) != "array" or json_array_length(array) > 32:
        return Err("invalid_request")
    var out: [SearchFacet] = []
    var previous_name = ""
    var i = 0
    while i < json_array_length(array):
        _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
        val filter = json_array_get(array, i)
        if not wire_has_exact_keys(filter, ["name", "values"]): return Err("invalid_request")
        val name = wire_jtext(filter, "name")
        val values = json_object_get(filter, "values")
        if not wire_valid_id(name) or (previous_name != "" and not _unsigned_utf8_less(previous_name, name)) or
                json_get_type(values) != "array" or json_array_length(values) < 1 or
                json_array_length(values) > 64:
            return Err("invalid_request")
        var previous_value = ""
        var v = 0
        while v < json_array_length(values):
            _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
            val maybe_value = json_to_string(json_array_get(values, v))
            if maybe_value == nil: return Err("invalid_request")
            val value = maybe_value.unwrap()
            _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
            if unicode_normalize_nfc(value) != value or
                    (v > 0 and not _unsigned_utf8_less(previous_value, value)):
                return Err("invalid_request")
            out.push(SearchFacet.of(name, value))
            previous_value = value
            v = v + 1
        previous_name = name
        i = i + 1
    Ok(out)

fn _success(service: SpipeProviderServiceV1, request_id: text,
            operation: text, result: text) -> text:
    "{\"ok\":true,\"operation\":" + wire_json_string(operation) +
        ",\"operation_receipt\":null,\"protocol\":{\"major\":1,\"minor\":0},\"provider_generation\":" +
        wire_json_string(provider_generation_id(service.state.provider_generation)) +
        ",\"query_receipt\":null,\"request_id\":" + wire_json_string(request_id) +
        ",\"result\":" + result + ",\"scope_digest\":" + wire_json_string(service.state.scope_digest) +
        ",\"snapshot\":" + wire_json_string(service.state.snapshot_id) +
        ",\"workspace\":" + wire_json_string(service.state.workspace) + "}"

fn _error(service: SpipeProviderServiceV1, root: any, request_id: text,
          operation: text, code: text, message: text) -> ProviderWireOwnedDispatchV1:
    provider_owned_response(wire_echo_query_receipt(
        service.bound_error(request_id, operation, code, message), root), false, service)

fn wire_deadline_exceeded_at(admitted_at_ms: i64, deadline_ms: i64,
                             observed_at_ms: i64) -> bool:
    admitted_at_ms < 0 or deadline_ms < 1 or observed_at_ms < admitted_at_ms or
        observed_at_ms - admitted_at_ms >= deadline_ms

fn wire_deadline_exceeded(admitted_at_ms: i64, deadline_ms: i64) -> bool:
    wire_deadline_exceeded_at(admitted_at_ms, deadline_ms,
                              time_now_monotonic_ms())

fn _cursor_unsigned(service: SpipeProviderServiceV1, binding_hash: text,
                    query_receipt_id: text,
                    limit: i64, explain: bool, next_rank: i64,
                    issued_at_ms: i64, expires_at_ms: i64) -> text:
    "{\"authority_generation\":" + service.receipt_authority.authority_generation().to_text() +
        ",\"authority_id\":" + wire_json_string(service.receipt_authority.authority_id()) +
        ",\"expires_at_ms\":" + expires_at_ms.to_text() +
        ",\"explain\":" + (if explain: "true" else: "false") +
        ",\"issued_at_ms\":" + issued_at_ms.to_text() +
        ",\"key_id\":" + wire_json_string(service.receipt_authority.key_id()) +
        ",\"limit\":" + limit.to_text() +
        ",\"logical_root\":" + wire_json_string(service.state.logical_root) +
        ",\"next_rank\":" + next_rank.to_text() +
        ",\"provider_generation\":" + wire_json_string(provider_generation_id(service.state.provider_generation)) +
        ",\"query_binding_hash\":" + wire_json_string(binding_hash) +
        ",\"query_receipt_id\":" + wire_json_string(query_receipt_id) +
        ",\"scope_digest\":" + wire_json_string(service.state.scope_digest) +
        ",\"snapshot\":" + wire_json_string(service.state.snapshot_id) +
        ",\"workspace\":" + wire_json_string(service.state.workspace) + "}"

fn _encode_cursor(service: SpipeProviderServiceV1, binding_hash: text,
                  query_receipt_id: text,
                  limit: i64, explain: bool, next_rank: i64) -> Result<text, text>:
    if not _valid_query_receipt_id(query_receipt_id):
        return Err("stale_cursor")
    val issued = service.receipt_authority.now_ms()
    val unsigned = _cursor_unsigned(service, binding_hash, query_receipt_id,
                                    limit, explain,
                                    next_rank, issued, issued + 30000)
    val signature = service.receipt_authority.sign(
        _domain_bytes("SPKC-SEARCH-CURSOR-V1\0", unsigned))?
    val closed = unsigned.replace("\"snapshot\":", "\"signature\":" +
        wire_json_string(signature) + ",\"snapshot\":")
    Ok(base64url_encode(closed))

fn _decode_cursor(service: SpipeProviderServiceV1, cursor: text,
                  binding_hash: text, limit: i64,
                  explain: bool) -> Result<i64, text>:
    if cursor == "" or cursor.bytes().len() > 8192: return Err("stale_cursor")
    val decoded = base64url_decode_strict(cursor)
    if val Err(_) = decoded: return Err("stale_cursor")
    if base64url_encode(decoded.unwrap()) != cursor: return Err("stale_cursor")
    val parsed = json_parse_with_error(decoded.unwrap())
    if parsed.1 != "" or not wire_has_exact_keys(parsed.0,
            ["authority_generation", "authority_id", "expires_at_ms", "explain",
             "issued_at_ms", "key_id", "limit", "logical_root", "next_rank",
             "provider_generation", "query_binding_hash", "query_receipt_id", "scope_digest", "signature",
             "snapshot", "workspace"]):
        return Err("stale_cursor")
    val issued = wire_jint(parsed.0, "issued_at_ms", -1)
    val expires = wire_jint(parsed.0, "expires_at_ms", -1)
    val observed_at = service.receipt_authority.now_ms()
    val next_rank = wire_jint(parsed.0, "next_rank", -1)
    val query_receipt_id = wire_jtext(parsed.0, "query_receipt_id")
    val unsigned = _cursor_unsigned(service, binding_hash, query_receipt_id,
                                    limit, explain,
                                    next_rank, issued, expires)
    val canonical = wire_canonical_json_value(parsed.0)
    if val Err(_) = canonical: return Err("stale_cursor")
    if canonical.unwrap() != decoded.unwrap() or
            wire_jint(parsed.0, "authority_generation", -1) != service.receipt_authority.authority_generation() or
            wire_jtext(parsed.0, "authority_id") != service.receipt_authority.authority_id() or
            wire_jtext(parsed.0, "key_id") != service.receipt_authority.key_id() or
            wire_jtext(parsed.0, "logical_root") != service.state.logical_root or
            wire_jtext(parsed.0, "provider_generation") != provider_generation_id(service.state.provider_generation) or
            wire_jtext(parsed.0, "query_binding_hash") != binding_hash or
            not _valid_query_receipt_id(query_receipt_id) or
            wire_jtext(parsed.0, "scope_digest") != service.state.scope_digest or
            wire_jtext(parsed.0, "snapshot") != service.state.snapshot_id or
            wire_jtext(parsed.0, "workspace") != service.state.workspace or
            wire_jint(parsed.0, "limit", -1) != limit or
            wire_jbool(parsed.0, "explain", not explain) != explain or
            issued < 0 or expires < issued or issued > observed_at or expires < observed_at or
            next_rank < 1 or not service.receipt_authority.verify(
                _domain_bytes("SPKC-SEARCH-CURSOR-V1\0", unsigned),
                wire_jtext(parsed.0, "signature")):
        return Err("stale_cursor")
    Ok(next_rank)

fn _matched_fields_json(service: SpipeProviderServiceV1, query: SearchQuery,
                        document_id: text, request_id: text,
                        admitted_at_ms: i64, deadline_ms: i64,
                        clock: QueryClockPort) -> Result<text, text>:
    val matched = matched_fields_snapshot_lexical_controlled(
        service.state.snapshot_value, query, document_id, request_id,
        admitted_at_ms, deadline_ms, clock)?
    var encoded: [text] = []
    var i = 0
    while i < matched.len():
        _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
        encoded.push(wire_json_string(matched[i]))
        i = i + 1
    Ok("[" + encoded.join(",") + "]")

fn _hit_json(service: SpipeProviderServiceV1, hit: SearchHit,
             query: SearchQuery, include_explanation: bool,
             request_id: text, admitted_at_ms: i64, deadline_ms: i64,
             clock: QueryClockPort) -> Result<text, text>:
    val explanation = if include_explanation:
        explain_snapshot_lexical_controlled(service.state.snapshot_value, query,
            hit.document_id, service.state.scope_digest,
            service.state.logical_root, request_id, admitted_at_ms,
            deadline_ms, clock)?
    else: "null"
    if include_explanation and wire_explanation_exceeds_limit(explanation):
        return Err("limit_exceeded")
    val matched_fields = _matched_fields_json(service, query, hit.document_id,
        request_id, admitted_at_ms, deadline_ms, clock)?
    Ok("{\"document_id\":" + wire_json_string(hit.document_id) +
        ",\"explanation\":" + explanation + ",\"matched_fields\":" + matched_fields +
        ",\"score_milli\":" + hit.score.raw_value().to_text() +
        ",\"source_rank\":" + hit.rank.to_text() + "}")

fn _search_result(rows: [text], logical_root: text,
                  next_cursor_json: text, exhausted: bool) -> text:
    "{\"exhausted\":" + (if exhausted: "true" else: "false") +
        ",\"hits\":[" + rows.join(",") + "],\"logical_root\":" +
        wire_json_string(logical_root) + ",\"next_cursor\":" + next_cursor_json + "}"

fn wire_dispatch_search(service: SpipeProviderServiceV1, root: any,
                        payload: any, request_id: text,
                        admitted_at_ms: i64, deadline_ms: i64,
                        clock: QueryClockPort) -> ProviderWireOwnedDispatchV1:
    if not wire_has_exact_keys(payload, ["query_text", "filters", "limit", "cursor", "explain"]) or
            json_get_type(json_object_get(payload, "explain")) != "boolean":
        return _error(service, root, request_id, "search", "invalid_request", "invalid search payload")
    if val Err(reason) = _query_check(clock, request_id, admitted_at_ms,
                                     deadline_ms):
        return _error(service, root, request_id, "search", reason,
                      "request stopped before search decode")
    val query_text = wire_jtext(payload, "query_text")
    val limit = wire_jint(payload, "limit", -1)
    if json_get_type(json_object_get(payload, "query_text")) != "string" or
            unicode_normalize_nfc(query_text) != query_text or
            limit < 1 or limit > 1000:
        return _error(service, root, request_id, "search", "invalid_request", "invalid search bounds")
    if val Err(reason) = _query_check(clock, request_id, admitted_at_ms,
                                     deadline_ms):
        return _error(service, root, request_id, "search", reason,
                      "request stopped during search decode")
    if query_text.bytes().len() > MAX_QUERY_BYTES or
            analyze_text(query_text).len() > MAX_QUERY_TOKENS:
        return _error(service, root, request_id, "search", "limit_exceeded", "query limit exceeded")
    val filters = _decode_filters(payload, request_id, admitted_at_ms,
                                  deadline_ms, clock)
    if val Err(reason) = filters:
        return _error(service, root, request_id, "search", reason, "invalid search filters")
    if analyze_text(query_text).len() == 0 and filters.unwrap().len() == 0:
        return _error(service, root, request_id, "search", "invalid_request", "empty query requires a filter")
    val binding_hash = _search_binding_hash(payload)
    if val Err(_) = binding_hash:
        return _error(service, root, request_id, "search", "invalid_request", "invalid search binding")
    var next_rank = 1
    val raw_cursor = json_object_get(payload, "cursor")
    if json_get_type(raw_cursor) == "string":
        val cursor = json_to_string(raw_cursor)
        if cursor == nil: return _error(service, root, request_id, "search", "stale_cursor", "cursor is stale")
        val decoded_rank = _decode_cursor(service, cursor.unwrap(), binding_hash.unwrap(),
                                          limit, wire_jbool(payload, "explain", false))
        if val Err(_) = decoded_rank:
            return _error(service, root, request_id, "search", "stale_cursor", "cursor is stale")
        next_rank = decoded_rank.unwrap()
    elif json_get_type(raw_cursor) != "null":
        return _error(service, root, request_id, "search", "stale_cursor", "cursor is stale")
    if val Err(reason) = _query_check(clock, request_id, admitted_at_ms,
                                     deadline_ms):
        return _error(service, root, request_id, "search", reason,
                      "request stopped before search execution")
    val include_explanation = wire_jbool(payload, "explain", false)
    # Fetch one ranked witness beyond this page rather than globally truncating
    # the result set to max_hits.  The witness decides exhaustion while the
    # public page itself remains bounded to at most 1,000 hits/524,288 bytes.
    # Later cursors request a longer stable prefix of the same root-bound order.
    var ranked_prefix = next_rank - 1 + limit + 1
    val corpus_documents = service.state.snapshot_value.documents.len()
    if ranked_prefix > corpus_documents: ranked_prefix = corpus_documents
    val query = SearchQuery.of(query_text, filters.unwrap(), ranked_prefix,
                               "", include_explanation)
    if not service.state.request_allowed():
        return _error(service, root, request_id, "search",
                      "handshake_required", "search rejected")
    val searched = search_snapshot_lexical_controlled(
        service.state.snapshot_value, query, ranked_prefix, request_id,
        admitted_at_ms, deadline_ms, clock)
    if val Err(reason) = searched:
        val code = if reason == "empty_query": "invalid_request" else: reason
        return _error(service, root, request_id, "search", code, "search rejected")
    val hits = searched.unwrap()
    val start = next_rank - 1
    if start > hits.len():
        return _error(service, root, request_id, "search", "stale_cursor", "cursor is stale")
    var desired_stop = start + limit
    if desired_stop > hits.len(): desired_stop = hits.len()
    val query_receipt_id = wire_jtext(json_object_get(root, "query_receipt"), "receipt_id")
    var rows: [text] = []
    var stop = start
    var cursor_json = "null"
    while stop < desired_stop:
        if val Err(reason) = _query_check(clock, request_id, admitted_at_ms,
                                         deadline_ms):
            return _error(service, root, request_id, "search", reason,
                          "request stopped during result construction")
        val row = _hit_json(service, hits[stop], query, include_explanation,
                            request_id, admitted_at_ms, deadline_ms, clock)
        if val Err(reason) = row:
            return _error(service, root, request_id, "search", reason, "search explanation failed")
        var candidate_rows = rows
        candidate_rows.push(row.unwrap())
        val candidate_stop = stop + 1
        val candidate_exhausted = candidate_stop >= hits.len()
        var candidate_cursor_json = "null"
        if not candidate_exhausted:
            if val Err(reason) = _query_check(clock, request_id,
                    admitted_at_ms, deadline_ms):
                return _error(service, root, request_id, "search", reason,
                              "request stopped before cursor signing")
            val encoded = _encode_cursor(service, binding_hash.unwrap(),
                query_receipt_id, limit, include_explanation, candidate_stop + 1)
            if val Err(_) = encoded:
                return _error(service, root, request_id, "search", "provider_unavailable", "cursor signing unavailable")
            candidate_cursor_json = wire_json_string(encoded.unwrap())
        val candidate_result = _search_result(candidate_rows,
            service.state.logical_root, candidate_cursor_json, candidate_exhausted)
        if val Err(reason) = _query_check(clock, request_id, admitted_at_ms,
                                         deadline_ms):
            return _error(service, root, request_id, "search", reason,
                          "request stopped during page serialization")
        if wire_page_exceeds_limit(candidate_result):
            if rows.len() == 0:
                return _error(service, root, request_id, "search", "limit_exceeded", "page limit exceeded")
            break
        rows = candidate_rows
        stop = candidate_stop
        cursor_json = candidate_cursor_json
    if val Err(reason) = _query_check(clock, request_id, admitted_at_ms,
                                     deadline_ms):
        return _error(service, root, request_id, "search", reason,
                      "request stopped before read linearization")
    val exhausted = stop >= hits.len()
    if not exhausted and cursor_json == "null":
        val encoded = _encode_cursor(service, binding_hash.unwrap(),
            query_receipt_id, limit, include_explanation, stop + 1)
        if val Err(_) = encoded:
            return _error(service, root, request_id, "search", "provider_unavailable", "cursor signing unavailable")
        cursor_json = wire_json_string(encoded.unwrap())
    val result = _search_result(rows, service.state.logical_root,
                                cursor_json, exhausted)
    provider_owned_response(wire_echo_query_receipt(
        _success(service, request_id, "search", result), root), false, service)

fn wire_dispatch_explain(service: SpipeProviderServiceV1, root: any,
                         payload: any, request_id: text,
                         admitted_at_ms: i64, deadline_ms: i64,
                         clock: QueryClockPort) -> ProviderWireOwnedDispatchV1:
    if not wire_has_exact_keys(payload, ["document_id", "query_text", "filters"]):
        return _error(service, root, request_id, "explain", "invalid_request", "invalid explain payload")
    val document_id = wire_jtext(payload, "document_id")
    val query_text = wire_jtext(payload, "query_text")
    if not wire_valid_id(document_id) or
            json_get_type(json_object_get(payload, "query_text")) != "string" or
            unicode_normalize_nfc(query_text) != query_text:
        return _error(service, root, request_id, "explain", "invalid_request", "invalid explain bounds")
    if query_text.bytes().len() > MAX_QUERY_BYTES or
            analyze_text(query_text).len() > MAX_QUERY_TOKENS:
        return _error(service, root, request_id, "explain", "limit_exceeded", "query limit exceeded")
    val filters = _decode_filters(payload, request_id, admitted_at_ms,
                                  deadline_ms, clock)
    if val Err(reason) = filters:
        return _error(service, root, request_id, "explain", reason, "invalid explain filters")
    if analyze_text(query_text).len() == 0 and filters.unwrap().len() == 0:
        return _error(service, root, request_id, "explain", "invalid_request", "empty query requires a filter")
    if val Err(reason) = _query_check(clock, request_id, admitted_at_ms,
                                     deadline_ms):
        return _error(service, root, request_id, "explain", reason,
                      "request stopped before explanation")
    val query = SearchQuery.of(query_text, filters.unwrap(), 1000, "", true)
    val matches = document_matches_query_controlled(
        service.state.snapshot_value, query, document_id, request_id,
        admitted_at_ms, deadline_ms, clock)
    if val Err(reason) = matches:
        val code = if reason == "empty_query": "invalid_request" else: reason
        return _error(service, root, request_id, "explain", code, "document not found")
    if not matches.unwrap():
        return _error(service, root, request_id, "explain",
                      "snapshot_not_found", "document not found")
    val explanation = explain_snapshot_lexical_controlled(
        service.state.snapshot_value, query, document_id,
        service.state.scope_digest, service.state.logical_root, request_id,
        admitted_at_ms, deadline_ms, clock)
    if val Err(reason) = explanation:
        return _error(service, root, request_id, "explain", reason, "explanation failed")
    if val Err(reason) = _query_check(clock, request_id, admitted_at_ms,
                                     deadline_ms):
        return _error(service, root, request_id, "explain", reason,
                      "request stopped after explanation")
    if wire_explanation_exceeds_limit(explanation.unwrap()):
        return _error(service, root, request_id, "explain", "limit_exceeded", "explanation limit exceeded")
    val result = "{\"document_id\":" + wire_json_string(document_id) +
        ",\"explanation\":" + explanation.unwrap() + ",\"logical_root\":" +
        wire_json_string(service.state.logical_root) + "}"
    provider_owned_response(wire_echo_query_receipt(
        _success(service, request_id, "explain", result), root), false, service)

fn _scope_field_names(service: SpipeProviderServiceV1,
                      request_id: text,
                      admitted_at_ms: i64,
                      deadline_ms: i64,
                      clock: QueryClockPort) -> Result<[text], text>:
    val canonical = ["identifier", "title", "heading", "classification", "body"]
    var names: [text] = []
    var c = 0
    while c < canonical.len():
        _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
        var found = false
        var d = 0
        while d < service.state.snapshot_value.documents.len():
            _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
            var f = 0
            while f < service.state.snapshot_value.documents[d].fields.len():
                _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
                if service.state.snapshot_value.documents[d].fields[f].name == canonical[c]:
                    found = true
                f = f + 1
            d = d + 1
        if found: names.push(canonical[c])
        c = c + 1
    Ok(names)

fn wire_field_stats(service: SpipeProviderServiceV1,
                    request_id: text, admitted_at_ms: i64,
                    deadline_ms: i64,
                    clock: QueryClockPort) -> Result<text, text>:
    val names = _scope_field_names(service, request_id, admitted_at_ms,
                                   deadline_ms, clock)?
    var rows: [text] = []
    var f = 0
    while f < names.len():
        _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
        var total = 0
        # BM25 N is the complete live corpus cardinality for every authorized
        # field. A live document without this field contributes length zero;
        # it is not removed from N or the average-length denominator.
        val n = service.state.snapshot_value.documents.len()
        var d = 0
        while d < service.state.snapshot_value.documents.len():
            _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
            var field_index = 0
            while field_index < service.state.snapshot_value.documents[d].fields.len():
                _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
                val field = service.state.snapshot_value.documents[d].fields[field_index]
                if field.name == names[f]:
                    total = total + analyze_text(field.value).len()
                field_index = field_index + 1
            d = d + 1
        val average = if n == 0: 0 else: (total * 1000000) / n
        rows.push("{\"N\":" + n.to_text() + ",\"average_length_scaled\":" +
            average.to_text() + ",\"field\":" + wire_json_string(names[f]) +
            ",\"total_length\":" + total.to_text() + "}")
        f = f + 1
    Ok("[" + rows.join(",") + "]")

fn _snapshot_index_bytes(service: SpipeProviderServiceV1,
                         request_id: text,
                         admitted_at_ms: i64,
                         deadline_ms: i64,
                         clock: QueryClockPort) -> Result<i64, text>:
    # The Wave 4 implementation keeps the searchable snapshot itself as its
    # lexical index and has no separate postings/cache allocation.  Count the
    # exact UTF-8 payload bytes retained by that index; never substitute a
    # constant or a source-file size.
    val snapshot = service.state.snapshot_value
    var total = snapshot.snapshot_id.bytes().len() +
        snapshot.revision.bytes().len() + snapshot.score_contract.bytes().len() +
        snapshot.analyzer.cache_key().bytes().len()
    var d = 0
    while d < snapshot.documents.len():
        _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
        val document = snapshot.documents[d]
        total = total + document.id.bytes().len() + document.revision.bytes().len()
        var f = 0
        while f < document.fields.len():
            _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
            total = total + document.fields[f].name.bytes().len() +
                document.fields[f].value.bytes().len() + 8
            f = f + 1
        var m = 0
        while m < document.metadata.len():
            _query_check(clock, request_id, admitted_at_ms, deadline_ms)?
            total = total + document.metadata[m].name.bytes().len() +
                document.metadata[m].value.bytes().len()
            m = m + 1
        d = d + 1
    Ok(total)

fn wire_dispatch_stats(service: SpipeProviderServiceV1, payload: any,
                       request_id: text, admitted_at_ms: i64,
                       deadline_ms: i64,
                       clock: QueryClockPort) -> ProviderWireOwnedDispatchV1:
    if not wire_has_exact_keys(payload, ["logical_root"]) or
            not wire_valid_hash(wire_jtext(payload, "logical_root")):
        return provider_owned_response(service.bound_error(request_id, "stats",
            "invalid_request", "invalid stats payload"), false, service)
    if not wire_stats_capability_available():
        return provider_owned_response(service.bound_error(request_id, "stats",
            "unsupported_capability", "stats unavailable on this platform"),
            false, service)
    val requested_root = wire_jtext(payload, "logical_root")
    if requested_root != service.state.logical_root:
        return provider_owned_response(service.bound_error(request_id, "stats",
            "snapshot_not_found", "logical index not found"), false, service)
    if val Err(reason) = _query_check(clock, request_id, admitted_at_ms,
                                     deadline_ms):
        return provider_owned_response(service.bound_error(request_id, "stats",
            reason, "request stopped before stats"), false, service)
    val stats = service.stats()
    if val Err(reason) = stats:
        return provider_owned_response(service.bound_error(request_id, "stats",
            reason, "stats rejected"), false, service)
    val field_stats = wire_field_stats(service, request_id, admitted_at_ms,
                                       deadline_ms, clock)
    if val Err(reason) = field_stats:
        return provider_owned_response(service.bound_error(request_id, "stats",
            reason, "stats collection failed"), false, service)
    val index_bytes = _snapshot_index_bytes(service, request_id,
                                            admitted_at_ms, deadline_ms, clock)
    if val Err(reason) = index_bytes:
        return provider_owned_response(service.bound_error(request_id, "stats",
            reason, "stats collection failed"), false, service)
    val peak_rss_kib = process_peak_rss_kb()
    if val Err(reason) = _query_check(clock, request_id, admitted_at_ms,
                                     deadline_ms):
        return provider_owned_response(service.bound_error(request_id, "stats",
            reason, "request stopped during stats"), false, service)
    if peak_rss_kib <= 0 or peak_rss_kib > 8796093022207:
        return provider_owned_response(service.bound_error(request_id, "stats",
            "provider_unavailable", "peak RSS measurement unavailable"), false, service)
    # No query/result cache exists in this implementation; zero is the
    # measured allocated cache size, not an estimate.
    val result = "{\"cache_bytes\":0,\"document_count\":" + stats.unwrap().0.to_text() +
        ",\"field_stats\":" + field_stats.unwrap() +
        ",\"index_bytes\":" + index_bytes.unwrap().to_text() +
        ",\"logical_root\":" + wire_json_string(requested_root) +
        ",\"peak_rss_bytes\":" + (peak_rss_kib * 1024).to_text() + "}"
    provider_owned_response(_success(service, request_id, "stats", result), false, service)
