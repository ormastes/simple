# Explicit composition ports for trusted signing and durable lifecycle state.
# Wire requests can never supply private keys or filesystem paths.
use std.common.crypto.ed25519.{ed25519_pubkey, pure_ed25519_sign, pure_ed25519_verify}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.string_core.{text_to_bytes}
use std.common.base_encoding.base64.{base64url_encode_i64_bytes}
use app.io.mod.{file_exists, file_read_regular_no_follow_bounded, file_atomic_write, file_fsync, directory_fsync, file_lock, file_unlock, dir_create_all, current_time_ms}
use std.common.json.parser.{json_parse_with_error}
use std.common.json.object_ops.{json_object_get, json_object_keys, json_object_has}
use std.common.json.types.{json_get_type, json_to_string, json_to_number}
use std.common.json.serializer.{json_escape_string}
use std.common.search.generated.unicode_17_0_0.{unicode_normalize_nfc}

trait ReceiptAuthorityPort:
    fn available(self) -> bool
    fn key_id(self) -> text
    fn authority_id(self) -> text
    fn authority_generation(self) -> i64
    fn now_ms(self) -> i64
    fn sign(self, message: [u8]) -> Result<text, text>
    fn verify(self, message: [u8], signature_hex: text) -> bool

# Candidate expiry is a parent-authoritative lifecycle action, not a client
# operation receipt.  It therefore has its own explicitly composed authority
# even when both authorities use the same Ed25519 implementation.
trait CandidateAuthorityPort:
    fn available(self) -> bool
    fn key_id(self) -> text
    fn authority_id(self) -> text
    fn authority_generation(self) -> i64
    fn now_ms(self) -> i64
    fn sign(self, message: [u8]) -> Result<text, text>
    fn verify(self, message: [u8], signature_text: text) -> bool

# Candidate lifecycle ordering is deliberately independent from receipt time.
# The parent service owns this mutable authority and assigns every persisted
# transition timestamp before handing a record to durable storage.
trait CandidateTransitionAuthorityPort:
    fn available(self) -> bool
    me next_recorded_at_ms(observed_ms: i64) -> Result<i64, text>

class DeterministicCandidateTransitionAuthorityV1 with CandidateTransitionAuthorityPort:
    enabled: bool
    last_recorded_at_ms: i64

    static fn unavailable() -> DeterministicCandidateTransitionAuthorityV1:
        DeterministicCandidateTransitionAuthorityV1(enabled: false,
            last_recorded_at_ms: 0)

    static fn test_only(initial_ms: i64) -> Result<DeterministicCandidateTransitionAuthorityV1, text>:
        if initial_ms < 0: return Err("invalid_transition_authority")
        Ok(DeterministicCandidateTransitionAuthorityV1(enabled: true,
            last_recorded_at_ms: initial_ms))

    fn available() -> bool: self.enabled
    me next_recorded_at_ms(observed_ms: i64) -> Result<i64, text>:
        if not self.enabled or observed_ms < 0:
            return Err("transition_authority_unavailable")
        val next = if observed_ms > self.last_recorded_at_ms:
            observed_ms
        else:
            self.last_recorded_at_ms + 1
        self.last_recorded_at_ms = next
        Ok(next)

class SystemCandidateTransitionAuthorityV1 with CandidateTransitionAuthorityPort:
    enabled: bool
    last_recorded_at_ms: i64

    static fn configured() -> SystemCandidateTransitionAuthorityV1:
        SystemCandidateTransitionAuthorityV1(enabled: true,
            last_recorded_at_ms: 0)

    fn available() -> bool: self.enabled
    me next_recorded_at_ms(observed_ms: i64) -> Result<i64, text>:
        if not self.enabled or observed_ms < 0:
            return Err("transition_authority_unavailable")
        val wall = current_time_ms()
        var next = observed_ms
        if wall > next: next = wall
        if next <= self.last_recorded_at_ms:
            next = self.last_recorded_at_ms + 1
        self.last_recorded_at_ms = next
        Ok(next)

fn _receipt_text(value: any, key: text) -> text:
    val item = json_to_string(json_object_get(value, key))
    if item == nil: "" else: item

fn _receipt_int(value: any, key: text) -> i64:
    val item = json_to_number(json_object_get(value, key))
    if item == nil: 0 - 1 else: item as i64

fn _quote(value: text) -> text: "\"" + json_escape_string(value) + "\""

fn _lower_hex(value: text, size: i64) -> bool:
    if value.len() != size: return false
    val digits = "0123456789abcdef"
    var i = 0
    while i < value.len():
        if not digits.contains(value.slice(i, i + 1)): return false
        i = i + 1
    true

fn _hash_text(value: text) -> bool:
    value.starts_with("sha256:") and
        _lower_hex(value.slice(7, value.len()), 64)

fn _prefixed_hash(value: text, prefix: text) -> bool:
    value.starts_with(prefix) and _lower_hex(value.slice(prefix.len(), value.len()), 64)

fn _id_text(value: text) -> bool:
    val bytes = value.bytes()
    if bytes.len() < 1 or bytes.len() > 128 or
            unicode_normalize_nfc(value) != value: return false
    var i = 0
    while i < bytes.len():
        val byte = bytes[i] as i64
        if byte < 32 or byte == 127: return false
        if byte == 194 and i + 1 < bytes.len():
            val following = bytes[i + 1] as i64
            if following >= 128 and following <= 159: return false
        i = i + 1
    true

# Operation receipts expose the wire generation identifier, never the local
# integer slot used by the current in-process provider implementation.
fn provider_generation_id(generation: i64) -> text:
    if generation < 0: return ""
    val digits = "0123456789abcdef"
    var value = generation
    var encoded = ""
    var i = 0
    while i < 32:
        encoded = digits.slice(value % 16, value % 16 + 1) + encoded
        value = value / 16
        i = i + 1
    if value != 0: return ""
    "pg-" + encoded

fn _provider_generation_valid(value: text) -> bool:
    value.starts_with("pg-") and _lower_hex(value.slice(3, value.len()), 32)

fn _snapshot_id(value: text) -> bool:
    value.starts_with("spks1-") and
        _lower_hex(value.slice(6, value.len()), 64)

fn _workspace_id(value: text) -> bool:
    value.starts_with("WS-") and _id_text(value)

fn _wire_nonnegative(value: i64) -> bool:
    value >= 0 and value <= 9007199254740991

fn _signature_text(value: text) -> bool:
    if value.len() != 86: return false
    val decoded = _base64url_decode_bytes_strict(value)
    if val Err(_) = decoded: return false
    decoded.unwrap().len() == 64

# Wave 4 receipts are minted for one day.  A bounded five-minute skew permits
# independently observed authority clocks without admitting arbitrary future
# audit records.
fn _receipt_time_error(issued_at_ms: i64, expires_at_ms: i64,
                       observed_at_ms: i64) -> text:
    if not _wire_nonnegative(issued_at_ms) or
            not _wire_nonnegative(expires_at_ms) or
            not _wire_nonnegative(observed_at_ms): return "time_range"
    if expires_at_ms < issued_at_ms: return "time_range"
    if expires_at_ms - issued_at_ms > 86400000: return "duration"
    if issued_at_ms > observed_at_ms + 300000: return "future_issued"
    if expires_at_ms < observed_at_ms: return "expired"
    ""

# The shared strict decoder returns text and therefore cannot preserve an
# arbitrary Ed25519 signature. Decode directly to bytes and require canonical
# unpadded base64url by round-tripping the result.
fn _base64url_value(byte: u8) -> i64:
    val value = byte as i64
    if value >= 65 and value <= 90: return value - 65
    if value >= 97 and value <= 122: return value - 97 + 26
    if value >= 48 and value <= 57: return value - 48 + 52
    if value == 45: return 62
    if value == 95: return 63
    0 - 1

fn _base64url_decode_bytes_strict(encoded: text) -> Result<[u8], text>:
    val input = encoded.bytes()
    if input.len() % 4 == 1: return Err("invalid_signature_encoding")
    var out: [u8] = []
    var accumulator = 0
    var bits = 0
    var i = 0
    while i < input.len():
        val value = _base64url_value(input[i])
        if value < 0: return Err("invalid_signature_encoding")
        accumulator = (accumulator << 6) | value
        bits = bits + 6
        if bits >= 8:
            bits = bits - 8
            out.push(((accumulator >> bits) & 255) as u8)
            # Retain only the partial next byte. Without this mask the
            # accumulator grows for the entire Ed25519 signature and
            # overflows before the final sextets are decoded.
            if bits == 0:
                accumulator = 0
            else:
                accumulator = accumulator & ((1 << bits) - 1)
        i = i + 1
    var normalized: [i64] = []
    i = 0
    while i < out.len():
        normalized.push(out[i] as i64)
        i = i + 1
    if base64url_encode_i64_bytes(normalized) != encoded:
        return Err("invalid_signature_encoding")
    Ok(out)

fn _signed_bytes(domain: text, canonical: text) -> [u8]:
    var bytes = text_to_bytes(domain)
    val size = canonical.bytes().len()
    var shift = 56
    while shift >= 0:
        bytes.push(((size >> shift) & 255) as u8)
        shift = shift - 8
    val payload = canonical.bytes()
    var i = 0
    while i < payload.len():
        bytes.push(payload[i])
        i = i + 1
    bytes

# The signer and validator must never maintain parallel receipt encoders.  This
# function is the single canonical unsigned representation used for both the
# receipt id and Ed25519 domain bytes.
fn operation_receipt_unsigned(authority_generation: i64, authority_id: text,
                              base_logical_root: text, candidate_uid_json: text,
                              expires_at_ms: i64, issued_at_ms: i64, key_id: text,
                              operation: text, operation_id: text, outcome: text,
                              payload_hash: text, policy_digest: text,
                              policy_version: i64, provider_generation: text,
                              result_logical_root: text, revocation_generation: i64,
                              scope_digest: text, snapshot: text, workspace: text) -> text:
    "{\"authority_generation\":" + authority_generation.to_text() +
        ",\"authority_id\":" + _quote(authority_id) +
        ",\"base_logical_root\":" + _quote(base_logical_root) +
        ",\"candidate_uid\":" + candidate_uid_json +
        ",\"expires_at_ms\":" + expires_at_ms.to_text() +
        ",\"issued_at_ms\":" + issued_at_ms.to_text() +
        ",\"key_id\":" + _quote(key_id) +
        ",\"operation\":" + _quote(operation) +
        ",\"operation_id\":" + _quote(operation_id) +
        ",\"outcome\":" + _quote(outcome) +
        ",\"payload_hash\":" + _quote(payload_hash) +
        ",\"policy_digest\":" + _quote(policy_digest) +
        ",\"policy_version\":" + policy_version.to_text() +
        ",\"provider_generation\":" + _quote(provider_generation) +
        ",\"result_logical_root\":" + _quote(result_logical_root) +
        ",\"revocation_generation\":" + revocation_generation.to_text() +
        ",\"schema\":\"spipe-operation-receipt-v1\",\"scope_digest\":" + _quote(scope_digest) +
        ",\"snapshot\":" + _quote(snapshot) +
        ",\"workspace\":" + _quote(workspace) + "}"

fn operation_receipt_domain_bytes(canonical_unsigned: text) -> [u8]:
    _signed_bytes("SPKC-OPERATION-RECEIPT-V1\0", canonical_unsigned)

fn operation_receipt_id(canonical_unsigned: text) -> text:
    "or-" + sha256_u8_hex(operation_receipt_domain_bytes(canonical_unsigned))

fn operation_receipt_validation_error(authority: ReceiptAuthorityPort,
                                      receipt_text: text) -> text:
    val parsed = json_parse_with_error(receipt_text)
    if parsed.1 != "": return "parse"
    if json_get_type(parsed.0) != "object": return "type"
    if json_object_keys(parsed.0).len() != 22: return "key_count"
    val value = parsed.0
    val required = ["authority_generation", "authority_id", "base_logical_root", "candidate_uid",
        "expires_at_ms", "issued_at_ms", "key_id", "operation", "operation_id", "outcome",
        "payload_hash", "policy_digest", "policy_version", "provider_generation", "receipt_id",
        "result_logical_root", "revocation_generation", "schema", "scope_digest", "signature",
        "snapshot", "workspace"]
    var i = 0
    while i < required.len():
        if not json_object_has(value, required[i]): return "missing_" + required[i]
        i = i + 1
    if _receipt_text(value, "schema") != "spipe-operation-receipt-v1": return "schema"
    if _receipt_text(value, "key_id") != authority.key_id(): return "key_id"
    if _receipt_text(value, "authority_id") != authority.authority_id(): return "authority_id"
    if _receipt_int(value, "authority_generation") != authority.authority_generation(): return "authority_generation"
    if not _prefixed_hash(_receipt_text(value, "key_id"), "ed25519:"): return "key_id_format"
    if not _id_text(_receipt_text(value, "authority_id")): return "authority_id_format"
    if _receipt_int(value, "authority_generation") <= 0 or
            not _wire_nonnegative(_receipt_int(value, "authority_generation")):
        return "authority_generation_format"
    if not _id_text(_receipt_text(value, "operation_id")): return "operation_id"
    val operation = _receipt_text(value, "operation")
    val outcome = _receipt_text(value, "outcome")
    if operation != "index_apply" and operation != "index_publish": return "operation"
    if operation == "index_apply" and outcome != "applied" and outcome != "no_op": return "outcome"
    if operation == "index_publish" and outcome != "published" and outcome != "aborted" and outcome != "stale_base": return "outcome"
    if not _provider_generation_valid(_receipt_text(value, "provider_generation")): return "provider_generation"
    if not _workspace_id(_receipt_text(value, "workspace")): return "workspace"
    if not _snapshot_id(_receipt_text(value, "snapshot")): return "snapshot"
    if not _hash_text(_receipt_text(value, "scope_digest")): return "scope_digest"
    if not _hash_text(_receipt_text(value, "base_logical_root")): return "base_logical_root"
    if not _hash_text(_receipt_text(value, "result_logical_root")): return "result_logical_root"
    if not _hash_text(_receipt_text(value, "payload_hash")): return "payload_hash"
    if not _hash_text(_receipt_text(value, "policy_digest")): return "policy_digest"
    if _receipt_int(value, "policy_version") != 1: return "policy_version"
    if _receipt_int(value, "revocation_generation") != 0: return "revocation_generation"
    if _receipt_text(value, "policy_digest") != _receipt_text(value, "scope_digest"):
        return "policy_digest_binding"
    val time_error = _receipt_time_error(_receipt_int(value, "issued_at_ms"),
        _receipt_int(value, "expires_at_ms"), authority.now_ms())
    if time_error != "": return time_error
    # An abort or stale-base decision preserves the logical root observed at
    # terminalization time.  A sibling may already have published after this
    # candidate's base was captured, so those outcomes are not required to
    # return the candidate's historical base root.
    if outcome == "no_op" and
            _receipt_text(value, "base_logical_root") != _receipt_text(value, "result_logical_root"):
        return "outcome_root"
    val raw_candidate = json_object_get(value, "candidate_uid")
    if json_get_type(raw_candidate) != "null" and not _id_text(_receipt_text(value, "candidate_uid")): return "candidate_uid"
    if not _signature_text(_receipt_text(value, "signature")): return "signature_format"
    val candidate = if json_get_type(raw_candidate) == "null": "null" else: _quote(_receipt_text(value, "candidate_uid"))
    val unsigned = operation_receipt_unsigned(
        _receipt_int(value, "authority_generation"), _receipt_text(value, "authority_id"),
        _receipt_text(value, "base_logical_root"), candidate,
        _receipt_int(value, "expires_at_ms"), _receipt_int(value, "issued_at_ms"),
        _receipt_text(value, "key_id"), _receipt_text(value, "operation"),
        _receipt_text(value, "operation_id"), _receipt_text(value, "outcome"),
        _receipt_text(value, "payload_hash"), _receipt_text(value, "policy_digest"),
        _receipt_int(value, "policy_version"), _receipt_text(value, "provider_generation"),
        _receipt_text(value, "result_logical_root"), _receipt_int(value, "revocation_generation"),
        _receipt_text(value, "scope_digest"), _receipt_text(value, "snapshot"),
        _receipt_text(value, "workspace"))
    val signing = operation_receipt_domain_bytes(unsigned)
    val expected = operation_receipt_id(unsigned)
    if _receipt_text(value, "receipt_id") != expected: return "receipt_id"
    if not _prefixed_hash(_receipt_text(value, "receipt_id"), "or-"): return "receipt_id_format"
    val canonical_with_id = unsigned.replace("\"result_logical_root\":", "\"receipt_id\":" + _quote(expected) + ",\"result_logical_root\":")
    val canonical_complete = canonical_with_id.replace("\"snapshot\":", "\"signature\":" + _quote(_receipt_text(value, "signature")) + ",\"snapshot\":")
    if canonical_complete != receipt_text: return "canonical"
    if not authority.verify(signing, _receipt_text(value, "signature")): return "signature"
    ""

# P6 gap-closure note (correction §2.5): this is NOT a wire receipt shape and
# is never itself serialized -- the actual signed wire receipt stays raw JSON
# text built field-by-field in `wire_receipt.spl`/`operation_receipt_unsigned`
# per the rich §14.16/14.17 candidate-lifecycle schema (12+ fields: operation,
# provider_generation, workspace, snapshot, base/result_logical_root,
# policy_version, policy_digest, revocation_generation, ...). P0's
# `std.common.search.snapshot.OperationReceiptV1` is a distinct, smaller
# 6-field decoded value object {operation_id, payload_hash, scope_digest,
# outcome, result_hash, signature} used by the SearchProviderAdapter (P5) --
# renaming this class to that name would be a false equivalence, not an
# adoption, since the field sets do not overlap 1:1 (no `result_hash`/
# `receipt_id` here; extra base/result_logical_root, policy_*, snapshot,
# workspace, provider_generation fields there are absent from P0's type).
# Divergence filed rather than forced: this struct stays local as what it
# actually is, a client-supplied *expected-value* comparator for
# `validate_bound_operation_receipt`, not a receipt encoding.
class OperationReceiptBindingV1:
    operation: text
    outcome: text
    provider_generation: text
    workspace: text
    snapshot: text
    scope_digest: text
    base_logical_root: text
    result_logical_root: text
    payload_hash: text
    policy_version: i64
    policy_digest: text
    revocation_generation: i64

fn operation_receipt_binding_error(receipt_text: text,
                                   expected: OperationReceiptBindingV1) -> text:
    val parsed = json_parse_with_error(receipt_text)
    if parsed.1 != "" or json_get_type(parsed.0) != "object": return "parse"
    val value = parsed.0
    if _receipt_text(value, "operation") != expected.operation: return "binding_operation"
    if _receipt_text(value, "outcome") != expected.outcome: return "binding_outcome"
    if _receipt_text(value, "provider_generation") != expected.provider_generation: return "binding_provider_generation"
    if _receipt_text(value, "workspace") != expected.workspace: return "binding_workspace"
    if _receipt_text(value, "snapshot") != expected.snapshot: return "binding_snapshot"
    if _receipt_text(value, "scope_digest") != expected.scope_digest: return "binding_scope_digest"
    if _receipt_text(value, "base_logical_root") != expected.base_logical_root: return "binding_base_logical_root"
    if _receipt_text(value, "result_logical_root") != expected.result_logical_root: return "binding_result_logical_root"
    if _receipt_text(value, "payload_hash") != expected.payload_hash: return "binding_payload_hash"
    if _receipt_int(value, "policy_version") != expected.policy_version: return "binding_policy_version"
    if _receipt_text(value, "policy_digest") != expected.policy_digest: return "binding_policy_digest"
    if _receipt_int(value, "revocation_generation") != expected.revocation_generation: return "binding_revocation_generation"
    ""

fn validate_bound_operation_receipt(authority: ReceiptAuthorityPort,
                                    receipt_text: text,
                                    expected: OperationReceiptBindingV1) -> bool:
    operation_receipt_validation_error(authority, receipt_text) == "" and
        operation_receipt_binding_error(receipt_text, expected) == ""

fn validate_operation_receipt(authority: ReceiptAuthorityPort,
                              receipt_text: text) -> bool:
    operation_receipt_validation_error(authority, receipt_text) == ""

fn validate_candidate_expiry_receipt(authority: CandidateAuthorityPort,
                                     receipt_text: text) -> bool:
    val parsed = json_parse_with_error(receipt_text)
    if parsed.1 != "" or json_get_type(parsed.0) != "object" or
            json_object_keys(parsed.0).len() != 20:
        return false
    val value = parsed.0
    val required = ["apply_operation_id", "apply_receipt_id",
        "authority_generation", "authority_id", "base_logical_root",
        "candidate_expires_at_ms", "candidate_logical_root", "candidate_uid",
        "expired_at_ms", "key_id", "outcome", "policy_digest",
        "policy_version", "receipt_id", "revocation_generation", "schema",
        "scope_digest", "signature", "snapshot", "workspace"]
    var i = 0
    while i < required.len():
        if not json_object_has(value, required[i]): return false
        i = i + 1
    val candidate_expires = _receipt_int(value, "candidate_expires_at_ms")
    val expired_at = _receipt_int(value, "expired_at_ms")
    val observed_at = authority.now_ms()
    if _receipt_text(value, "schema") != "spipe-candidate-expiry-receipt-v1" or
            _receipt_text(value, "key_id") != authority.key_id() or
            _receipt_text(value, "authority_id") != authority.authority_id() or
            _receipt_int(value, "authority_generation") != authority.authority_generation() or
            _receipt_text(value, "outcome") != "expired" or
            not _prefixed_hash(_receipt_text(value, "key_id"), "ed25519:") or
            not _id_text(_receipt_text(value, "authority_id")) or
            not _wire_nonnegative(_receipt_int(value, "authority_generation")) or
            _receipt_int(value, "authority_generation") <= 0 or
            not _id_text(_receipt_text(value, "apply_operation_id")) or
            not _prefixed_hash(_receipt_text(value, "apply_receipt_id"), "or-") or
            not _id_text(_receipt_text(value, "candidate_uid")) or
            not _workspace_id(_receipt_text(value, "workspace")) or
            not _snapshot_id(_receipt_text(value, "snapshot")) or
            not _hash_text(_receipt_text(value, "scope_digest")) or
            not _hash_text(_receipt_text(value, "base_logical_root")) or
            not _hash_text(_receipt_text(value, "candidate_logical_root")) or
            not _hash_text(_receipt_text(value, "policy_digest")) or
            _receipt_text(value, "policy_digest") != _receipt_text(value, "scope_digest") or
            _receipt_int(value, "policy_version") != 1 or
            _receipt_int(value, "revocation_generation") != 0 or
            not _wire_nonnegative(candidate_expires) or
            not _wire_nonnegative(expired_at) or
            not _wire_nonnegative(observed_at) or
            expired_at < candidate_expires or
            (observed_at <= 9007199254740991 - 300000 and
             expired_at > observed_at + 300000) or
            not _prefixed_hash(_receipt_text(value, "receipt_id"), "cer-") or
            not _signature_text(_receipt_text(value, "signature")):
        return false
    val unsigned = "{\"apply_operation_id\":" + _quote(_receipt_text(value, "apply_operation_id")) +
        ",\"apply_receipt_id\":" + _quote(_receipt_text(value, "apply_receipt_id")) +
        ",\"authority_generation\":" + _receipt_int(value, "authority_generation").to_text() +
        ",\"authority_id\":" + _quote(_receipt_text(value, "authority_id")) +
        ",\"base_logical_root\":" + _quote(_receipt_text(value, "base_logical_root")) +
        ",\"candidate_expires_at_ms\":" + _receipt_int(value, "candidate_expires_at_ms").to_text() +
        ",\"candidate_logical_root\":" + _quote(_receipt_text(value, "candidate_logical_root")) +
        ",\"candidate_uid\":" + _quote(_receipt_text(value, "candidate_uid")) +
        ",\"expired_at_ms\":" + _receipt_int(value, "expired_at_ms").to_text() +
        ",\"key_id\":" + _quote(_receipt_text(value, "key_id")) +
        ",\"outcome\":\"expired\",\"policy_digest\":" + _quote(_receipt_text(value, "policy_digest")) +
        ",\"policy_version\":" + _receipt_int(value, "policy_version").to_text() +
        ",\"revocation_generation\":" + _receipt_int(value, "revocation_generation").to_text() +
        ",\"schema\":\"spipe-candidate-expiry-receipt-v1\",\"scope_digest\":" + _quote(_receipt_text(value, "scope_digest")) +
        ",\"snapshot\":" + _quote(_receipt_text(value, "snapshot")) +
        ",\"workspace\":" + _quote(_receipt_text(value, "workspace")) + "}"
    val signing = _signed_bytes("SPKC-CANDIDATE-EXPIRY-RECEIPT-V1\0", unsigned)
    val expected = "cer-" + sha256_u8_hex(signing)
    val canonical_with_id = unsigned.replace("\"revocation_generation\":",
        "\"receipt_id\":" + _quote(expected) + ",\"revocation_generation\":")
    val canonical_complete = canonical_with_id.replace("\"snapshot\":",
        "\"signature\":" + _quote(_receipt_text(value, "signature")) +
        ",\"snapshot\":")
    _receipt_text(value, "receipt_id") == expected and
        canonical_complete == receipt_text and
        authority.verify(signing, _receipt_text(value, "signature"))

trait DurableLifecyclePort:
    fn available(self) -> bool
    fn load(self) -> Result<text, text>
    fn commit(self, canonical_state: text) -> Result<(), text>
    fn commit_if_unchanged(self, expected_sha256: text,
                           canonical_state: text) -> Result<(), text>
    # Generation quarantine is a monotonic provider-generation tombstone.
    # Implementations serialize it with lifecycle CAS so exactly one durable
    # ordering decides whether a lifecycle success or generation close wins.
    fn load_generation_quarantine(self,
                                  provider_generation: i64) -> Result<text, text>
    fn commit_generation_quarantine(self,
                                    provider_generation: i64,
                                    canonical_record: text) -> Result<(), text>

# The lifecycle file is rewritten transactionally, so this bound caps both
# startup memory and the cost of every mutation. Quarantine records are one
# closed request-bound receipt and use a smaller independent ceiling.
val PROVIDER_LIFECYCLE_MAX_BYTES = 16 * 1024 * 1024
val PROVIDER_GENERATION_QUARANTINE_MAX_BYTES = 64 * 1024
val PROVIDER_LIFECYCLE_MAX_REPLAY_ROWS = 4096
val PROVIDER_LIFECYCLE_MAX_CANDIDATE_ROWS = 2048
val PROVIDER_LIFECYCLE_MAX_PUBLICATION_ROWS = 2048

val _EMPTY_LIFECYCLE_V1 = "{\"candidates\":{},\"replay\":{},\"roots\":{},\"schema\":\"spipe-provider-lifecycle-store-v1\"}"

fn _bounded_optional_regular(path: text, max_bytes: i64,
                             missing_value: text) -> Result<text, text>:
    # Existence preserves the optional-file contract only. Actual bytes are
    # admitted by one no-follow open/fstat/read, so replacement, symlink,
    # directory, or oversized-file races still fail closed.
    if not file_exists(path): return Ok(missing_value)
    val loaded = file_read_regular_no_follow_bounded(path, max_bytes)
    if val Err(_) = loaded: return Err("snapshot_corrupt")
    Ok(loaded.unwrap())

fn _lifecycle_state_size_valid(value: text) -> bool:
    value.bytes().len() <= PROVIDER_LIFECYCLE_MAX_BYTES

fn _quarantine_record_size_valid(value: text) -> bool:
    value.bytes().len() <= PROVIDER_GENERATION_QUARANTINE_MAX_BYTES

fn _u8_hex(bytes: [u8]) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < bytes.len():
        val value = bytes[i] as i64
        out = out + digits.slice(value / 16, value / 16 + 1) + digits.slice(value % 16, value % 16 + 1)
        i = i + 1
    out

fn _hex_u8(value: text) -> [u8]:
    val digits = "0123456789abcdef"
    var out: [u8] = []
    var i = 0
    while i + 1 < value.len():
        val high_text = value.slice(i, i + 1)
        val low_text = value.slice(i + 1, i + 2)
        var high = 0 - 1
        var low = 0 - 1
        var d = 0
        while d < 16:
            if digits.slice(d, d + 1) == high_text: high = d
            if digits.slice(d, d + 1) == low_text: low = d
            d = d + 1
        if high < 0 or low < 0:
            return []
        out.push(((high * 16) + low) as u8)
        i = i + 2
    out

class PureEd25519ReceiptAuthorityV1 with ReceiptAuthorityPort, CandidateAuthorityPort:
    enabled: bool
    private_seed: [u8]
    public_key: [u8]
    authority_name: text
    generation: i64

    static fn unavailable() -> PureEd25519ReceiptAuthorityV1:
        PureEd25519ReceiptAuthorityV1(enabled: false, private_seed: [], public_key: [], authority_name: "", generation: 0)

    static fn test_only(seed: [u8], authority_name: text, generation: i64) -> Result<PureEd25519ReceiptAuthorityV1, text>:
        if seed.len() != 32 or not _id_text(authority_name) or generation <= 0 or
                not _wire_nonnegative(generation):
            return Err("invalid_receipt_authority")
        Ok(PureEd25519ReceiptAuthorityV1(enabled: true, private_seed: seed, public_key: ed25519_pubkey(seed), authority_name: authority_name, generation: generation))

    fn available() -> bool: self.enabled
    fn key_id() -> text: if self.enabled: "ed25519:" + sha256_u8_hex(self.public_key) else: ""
    fn authority_id() -> text: self.authority_name
    fn authority_generation() -> i64: self.generation
    fn now_ms() -> i64: if self.enabled: 1 else: 0
    fn sign(message: [u8]) -> Result<text, text>:
        if not self.enabled:
            return Err("provider_unavailable")
        var signature: [i64] = []
        val raw = pure_ed25519_sign(self.private_seed, self.public_key, message)
        var i = 0
        while i < raw.len():
            signature.push(raw[i] as i64)
            i = i + 1
        Ok(base64url_encode_i64_bytes(signature))
    fn verify(message: [u8], signature_hex: text) -> bool:
        if not self.enabled:
            return false
        val decoded = _base64url_decode_bytes_strict(signature_hex)
        if val Err(_) = decoded:
            return false
        val signature = decoded.unwrap()
        signature.len() == 64 and pure_ed25519_verify(self.public_key, message, signature)

# Production composition keeps key material explicit and obtains time only
# through the repository-owned app I/O facade. Wire input cannot construct it.
class SystemEd25519ReceiptAuthorityV1 with ReceiptAuthorityPort, CandidateAuthorityPort:
    enabled: bool
    private_seed: [u8]
    public_key: [u8]
    authority_name: text
    generation: i64

    static fn configured(seed: [u8], authority_name: text,
                         generation: i64) -> Result<SystemEd25519ReceiptAuthorityV1, text>:
        if seed.len() != 32 or not _id_text(authority_name) or generation <= 0 or
                not _wire_nonnegative(generation):
            return Err("invalid_receipt_authority")
        Ok(SystemEd25519ReceiptAuthorityV1(enabled: true, private_seed: seed,
            public_key: ed25519_pubkey(seed), authority_name: authority_name,
            generation: generation))

    fn available() -> bool: self.enabled
    fn key_id() -> text: if self.enabled: "ed25519:" + sha256_u8_hex(self.public_key) else: ""
    fn authority_id() -> text: self.authority_name
    fn authority_generation() -> i64: self.generation
    fn now_ms() -> i64: if self.enabled: current_time_ms() else: 0
    fn sign(message: [u8]) -> Result<text, text>:
        if not self.enabled:
            return Err("provider_unavailable")
        var signature: [i64] = []
        val raw = pure_ed25519_sign(self.private_seed, self.public_key, message)
        var i = 0
        while i < raw.len():
            signature.push(raw[i] as i64)
            i = i + 1
        Ok(base64url_encode_i64_bytes(signature))
    fn verify(message: [u8], signature_text: text) -> bool:
        if not self.enabled:
            return false
        val decoded = _base64url_decode_bytes_strict(signature_text)
        if val Err(_) = decoded:
            return false
        val signature = decoded.unwrap()
        signature.len() == 64 and pure_ed25519_verify(self.public_key, message, signature)

class FileDurableLifecycleV1 with DurableLifecyclePort:
    enabled: bool
    directory: text

    static fn unavailable() -> FileDurableLifecycleV1:
        FileDurableLifecycleV1(enabled: false, directory: "")

    static fn configured_absolute(directory: text) -> Result<FileDurableLifecycleV1, text>:
        if directory == "" or not directory.starts_with("/") or directory.contains(".."):
            return Err("invalid_lifecycle_directory")
        Ok(FileDurableLifecycleV1(enabled: true, directory: directory))

    fn available() -> bool: self.enabled
    fn load() -> Result<text, text>:
        if not self.enabled:
            return Err("provider_unavailable")
        val path = self.directory + "/provider-lifecycle-v1.json"
        _bounded_optional_regular(path, PROVIDER_LIFECYCLE_MAX_BYTES,
                                  _EMPTY_LIFECYCLE_V1)
    fn load_generation_quarantine(provider_generation: i64) -> Result<text, text>:
        if not self.enabled:
            return Err("provider_unavailable")
        val generation = provider_generation_id(provider_generation)
        if generation == "": return Err("invalid_provider_generation")
        val path = self.directory + "/provider-generation-quarantine-v1-" +
            generation + ".json"
        _bounded_optional_regular(path,
            PROVIDER_GENERATION_QUARANTINE_MAX_BYTES, "")
    fn commit(canonical_state: text) -> Result<(), text>:
        if not self.enabled:
            return Err("provider_unavailable")
        if not _lifecycle_state_size_valid(canonical_state):
            return Err("limit_exceeded")
        if not dir_create_all(self.directory):
            return Err("storage_error")
        val path = self.directory + "/provider-lifecycle-v1.json"
        # Request code performs its deadline check immediately before this
        # linearization boundary. Never hide another ten-second wait inside the
        # port; a busy lock returns promptly and is mapped to a closed error.
        val lock_handle = file_lock(path + ".lock", 0)
        if lock_handle < 0:
            return Err("storage_busy")
        val wrote = file_atomic_write(path, canonical_state)
        val file_synced = if wrote: file_fsync(path) else: false
        val directory_synced = if file_synced: directory_fsync(self.directory) else: false
        val released = file_unlock(lock_handle)
        if not wrote or not file_synced or not directory_synced or not released:
            return Err("storage_error")
        Ok(())

    fn commit_if_unchanged(expected_sha256: text,
                           canonical_state: text) -> Result<(), text>:
        if not self.enabled:
            return Err("provider_unavailable")
        if not _lifecycle_state_size_valid(canonical_state):
            return Err("limit_exceeded")
        if not dir_create_all(self.directory):
            return Err("storage_error")
        val path = self.directory + "/provider-lifecycle-v1.json"
        val lock_handle = file_lock(path + ".lock", 0)
        if lock_handle < 0:
            return Err("storage_busy")
        val loaded = _bounded_optional_regular(path,
            PROVIDER_LIFECYCLE_MAX_BYTES, _EMPTY_LIFECYCLE_V1)
        if val Err(reason) = loaded:
            val _ = file_unlock(lock_handle)
            return Err(reason)
        val current = loaded.unwrap()
        if sha256_u8_hex(text_to_bytes(current)) != expected_sha256:
            val _ = file_unlock(lock_handle)
            return Err("lifecycle_conflict")
        # Generation closure and lifecycle success share this lock. Once the
        # tombstone wins, no later candidate/replay transaction may commit.
        # Checking the lifecycle etag first lets an earlier lifecycle winner
        # remain authoritative and be recovered by the caller before closure.
        val parsed_state = json_parse_with_error(canonical_state)
        if parsed_state.1 != "" or json_get_type(parsed_state.0) != "object":
            val _ = file_unlock(lock_handle)
            return Err("snapshot_corrupt")
        val provider_generation = _receipt_int(parsed_state.0,
            "provider_generation")
        if provider_generation >= 0:
            val generation = provider_generation_id(provider_generation)
            if generation == "":
                val _ = file_unlock(lock_handle)
                return Err("snapshot_corrupt")
            val quarantine_path = self.directory +
                "/provider-generation-quarantine-v1-" + generation + ".json"
            val quarantine = _bounded_optional_regular(quarantine_path,
                PROVIDER_GENERATION_QUARANTINE_MAX_BYTES, "")
            if val Err(reason) = quarantine:
                val _ = file_unlock(lock_handle)
                return Err(reason)
            if quarantine.unwrap() != "":
                val _ = file_unlock(lock_handle)
                return Err("fatal_provider_error")
        val wrote = file_atomic_write(path, canonical_state)
        val file_synced = if wrote: file_fsync(path) else: false
        val directory_synced = if file_synced: directory_fsync(self.directory) else: false
        val released = file_unlock(lock_handle)
        if not wrote or not file_synced or not directory_synced or not released:
            return Err("storage_error")
        Ok(())

    fn commit_generation_quarantine(provider_generation: i64,
                                    canonical_record: text) -> Result<(), text>:
        if not self.enabled:
            return Err("provider_unavailable")
        val generation = provider_generation_id(provider_generation)
        if generation == "" or canonical_record == "":
            return Err("storage_error")
        if not _quarantine_record_size_valid(canonical_record):
            return Err("limit_exceeded")
        if not dir_create_all(self.directory): return Err("storage_error")
        val path = self.directory + "/provider-generation-quarantine-v1-" +
            generation + ".json"
        # Use the lifecycle lock, not a sibling lock. This is the single
        # linearization domain for generation closure and lifecycle success.
        val lifecycle_path = self.directory + "/provider-lifecycle-v1.json"
        val lock_handle = file_lock(lifecycle_path + ".lock", 0)
        if lock_handle < 0: return Err("storage_busy")
        val loaded = _bounded_optional_regular(path,
            PROVIDER_GENERATION_QUARANTINE_MAX_BYTES, "")
        if val Err(reason) = loaded:
            val _ = file_unlock(lock_handle)
            return Err(reason)
        val existing = loaded.unwrap()
        if existing != "" and existing != canonical_record:
            val _ = file_unlock(lock_handle)
            return Err("snapshot_corrupt")
        val wrote = if existing == canonical_record:
            true
        else:
            file_atomic_write(path, canonical_record)
        val file_synced = if wrote: file_fsync(path) else: false
        val directory_synced = if file_synced:
            directory_fsync(self.directory)
        else:
            false
        val released = file_unlock(lock_handle)
        if not wrote or not file_synced or not directory_synced or not released:
            return Err("storage_error")
        Ok(())
