# Bounded canonical-output sink. The request owner supplies its budget port on
# every append, so output and allocation admission precede all storage changes.
use app.spipe_knowledge_provider.segmented_bytes.ProviderSegmentedBytesV1
use app.spipe_knowledge_provider.work_control.{ProviderBudgetPort, ProviderBudgetChargeV1, provider_budget_category_output_bytes, provider_budget_category_logical_allocations}

trait ProviderByteSinkPort:
    me append(bytes: [u8], offset: i64, count: i64,
              budget: ProviderBudgetPort) -> Result<(), text>
    fn total_bytes() -> i64

class ProviderSegmentedByteSinkV1 with ProviderByteSinkPort:
    segment_bytes: i64
    maximum_bytes: i64
    var segments: [[u8]]
    var byte_count: i64

    static fn configured(segment_bytes: i64, maximum_bytes: i64) -> Result<ProviderSegmentedByteSinkV1, text>:
        if segment_bytes <= 0 or maximum_bytes <= 0:
            return Err("invalid_sink_limits")
        if segment_bytes > maximum_bytes:
            return Err("invalid_sink_limits")
        Ok(ProviderSegmentedByteSinkV1(segment_bytes: segment_bytes,
            maximum_bytes: maximum_bytes, segments: [], byte_count: 0))

    fn total_bytes() -> i64:
        self.byte_count

    fn _required_segments(count: i64) -> i64:
        if count == 0: return 0
        var remaining = count
        if self.segments.len() > 0:
            val last_bytes = self.segments[self.segments.len() - 1].len()
            val available = self.segment_bytes - last_bytes
            if remaining <= available: return 0
            remaining = remaining - available
        # remaining is positive. This form avoids addition overflow.
        1 + (remaining - 1) / self.segment_bytes

    me append(bytes: [u8], offset: i64, count: i64,
              budget: ProviderBudgetPort) -> Result<(), text>:
        if offset < 0 or count < 0 or offset > bytes.len():
            return Err("invalid_input")
        if count > bytes.len() - offset:
            return Err("invalid_input")
        if self.byte_count < 0 or self.byte_count > self.maximum_bytes:
            return Err("internal_error")
        if count > self.maximum_bytes - self.byte_count:
            return Err("limit_exceeded")
        if count == 0: return Ok(())

        val allocations = self._required_segments(count)
        var charges = [ProviderBudgetChargeV1(
            category: provider_budget_category_output_bytes(),
            amount: count)]
        if allocations > 0:
            charges.push(ProviderBudgetChargeV1(
                category: provider_budget_category_logical_allocations(),
                amount: allocations))
        # One request-owner transaction admits all logical work before the
        # first segment allocation or byte append. Failure changes no counter.
        budget.charge_all(charges)?

        var consumed = 0
        while consumed < count:
            if self.segments.len() == 0 or
                    self.segments[self.segments.len() - 1].len() == self.segment_bytes:
                self.segments.push([])
            val segment_index = self.segments.len() - 1
            val available = self.segment_bytes - self.segments[segment_index].len()
            var copied = count - consumed
            if copied > available: copied = available
            var index = 0
            while index < copied:
                self.segments[segment_index].push(bytes[offset + consumed + index])
                index = index + 1
            consumed = consumed + copied
        self.byte_count = self.byte_count + count
        Ok(())

    me take() -> ProviderSegmentedBytesV1:
        val owned = ProviderSegmentedBytesV1(
            segments: self.segments, total_bytes: self.byte_count)
        # Clearing the sole producer owner invalidates its access to the moved
        # segment collection. A subsequent append allocates fresh segments.
        self.segments = []
        self.byte_count = 0
        owned

export ProviderByteSinkPort, ProviderSegmentedByteSinkV1
