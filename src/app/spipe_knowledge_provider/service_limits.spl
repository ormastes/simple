# Closed count and lifecycle-capacity rules for the provider state owner.
use std.common.json.object_ops.{json_object_get}
use std.common.json.array_ops.{json_array_get, json_array_length}
use std.common.json.types.{json_get_type}
use std.common.search.document.{SearchDocument}
use app.spipe_knowledge_provider.durable_records.{ProviderCandidateV1, stored_text, stored_int, closed_object, restore_document, validate_publications}
use app.spipe_knowledge_provider.lifecycle.{PROVIDER_LIFECYCLE_MAX_BYTES, PROVIDER_LIFECYCLE_MAX_REPLAY_ROWS, PROVIDER_LIFECYCLE_MAX_CANDIDATE_ROWS, PROVIDER_LIFECYCLE_MAX_PUBLICATION_ROWS}
use app.spipe_knowledge_provider.wire_json.{wire_valid_workspace_id, wire_valid_snapshot_id, wire_valid_hash}

val SPIPE_PROVIDER_MAX_LIVE_DOCUMENTS: i64 = 1000000

fn provider_live_document_count_valid(count: i64) -> bool:
    count >= 0 and count <= SPIPE_PROVIDER_MAX_LIVE_DOCUMENTS

# The service owner is the sole authority for live searchable allocations.
# The current snapshot and every staged candidate consume the same bounded
# budget. Terminal candidates remain durable history but release their live
# allocation reservation.
fn provider_live_document_allocation_count(current_documents: i64,
                                           candidates: [ProviderCandidateV1]) -> Result<i64, text>:
    if not provider_live_document_count_valid(current_documents):
        return Err("limit_exceeded")
    var total = current_documents
    var i = 0
    while i < candidates.len():
        if candidates[i].state == "staged":
            val candidate_documents = candidates[i].snapshot.documents.len()
            if not provider_live_document_count_valid(candidate_documents) or
                    candidate_documents > SPIPE_PROVIDER_MAX_LIVE_DOCUMENTS - total:
                return Err("limit_exceeded")
            total = total + candidate_documents
        i = i + 1
    Ok(total)

fn provider_candidate_document_allocation_available(current_documents: i64,
                                                     candidates: [ProviderCandidateV1],
                                                     candidate_documents: i64) -> bool:
    if not provider_live_document_count_valid(candidate_documents): return false
    val allocated = provider_live_document_allocation_count(current_documents,
                                                             candidates)
    if val Err(_) = allocated: return false
    candidate_documents <= SPIPE_PROVIDER_MAX_LIVE_DOCUMENTS - allocated.unwrap()

fn provider_restored_live_document_allocation_count(current_root: text,
                                                     candidates: [ProviderCandidateV1]) -> Result<i64, text>:
    var current_documents = 0
    var current_found = current_root == "sha256:" + "0" * 64
    var i = 0
    while i < candidates.len():
        if candidates[i].state == "published" and
                candidates[i].candidate_root == current_root:
            if current_found: return Err("snapshot_corrupt")
            current_found = true
            current_documents = candidates[i].snapshot.documents.len()
        i = i + 1
    if not current_found: return Err("snapshot_corrupt")
    provider_live_document_allocation_count(current_documents, candidates)

fn provider_active_live_document_allocation_count(current_root: text,
                                                   current_documents: i64,
                                                   candidates: [ProviderCandidateV1]) -> Result<i64, text>:
    if current_root != "sha256:" + "0" * 64:
        return provider_restored_live_document_allocation_count(current_root,
                                                                 candidates)
    provider_live_document_allocation_count(current_documents, candidates)

fn provider_active_candidate_document_allocation_available(current_root: text,
                                                            current_documents: i64,
                                                            candidates: [ProviderCandidateV1],
                                                            candidate_documents: i64) -> bool:
    val allocated = provider_active_live_document_allocation_count(current_root,
        current_documents, candidates)
    if val Err(_) = allocated: return false
    provider_candidate_document_allocation_available(allocated.unwrap(), [],
                                                     candidate_documents)

fn provider_lifecycle_size_valid(canonical_state: text) -> bool:
    canonical_state.bytes().len() <= PROVIDER_LIFECYCLE_MAX_BYTES

fn provider_lifecycle_capacity_available(replay_rows: i64,
                                         candidates: [ProviderCandidateV1],
                                         add_replay: i64,
                                         add_candidates: i64,
                                         add_publications: i64) -> bool:
    if replay_rows < 0 or add_replay < 0 or add_candidates < 0 or
            add_publications < 0 or
            replay_rows + add_replay > PROVIDER_LIFECYCLE_MAX_REPLAY_ROWS or
            candidates.len() + add_candidates > PROVIDER_LIFECYCLE_MAX_CANDIDATE_ROWS:
        return false
    var publications = 0
    var i = 0
    while i < candidates.len():
        if candidates[i].state == "published": publications = publications + 1
        i = i + 1
    publications + add_publications <= PROVIDER_LIFECYCLE_MAX_PUBLICATION_ROWS

struct ProviderLifecycleRestoreHeaderV1:
    raw_replay: any
    raw_candidates: any
    raw_publications: any
    workspace: text
    snapshot: text
    scope_digest: text
    provider_generation: i64

fn provider_lifecycle_restore_header(root: any) -> Result<ProviderLifecycleRestoreHeaderV1, text>:
    if not closed_object(root, ["candidates", "current_logical_root", "provider_generation", "publications", "replay", "schema", "scope_digest", "snapshot", "workspace"]):
        return Err("snapshot_corrupt")
    val raw_replay = json_object_get(root, "replay")
    val raw_candidates = json_object_get(root, "candidates")
    val raw_publications = json_object_get(root, "publications")
    val workspace = stored_text(root, "workspace")
    val snapshot = stored_text(root, "snapshot")
    val scope_digest = stored_text(root, "scope_digest")
    val provider_generation = stored_int(root, "provider_generation", 0)
    if not wire_valid_workspace_id(workspace) or
            not wire_valid_snapshot_id(snapshot) or
            not wire_valid_hash(scope_digest) or provider_generation <= 0 or
            provider_generation > 9007199254740991 or
            json_get_type(raw_replay) != "array" or
            json_get_type(raw_candidates) != "array" or
            json_get_type(raw_publications) != "array":
        return Err("snapshot_corrupt")
    if json_array_length(raw_replay) > PROVIDER_LIFECYCLE_MAX_REPLAY_ROWS or
            json_array_length(raw_candidates) > PROVIDER_LIFECYCLE_MAX_CANDIDATE_ROWS or
            json_array_length(raw_publications) > PROVIDER_LIFECYCLE_MAX_PUBLICATION_ROWS:
        return Err("limit_exceeded")
    Ok(ProviderLifecycleRestoreHeaderV1(raw_replay: raw_replay,
        raw_candidates: raw_candidates, raw_publications: raw_publications,
        workspace: workspace, snapshot: snapshot, scope_digest: scope_digest,
        provider_generation: provider_generation))

struct ProviderRestoredDocumentsV1:
    documents: [SearchDocument]
    hashes: [text]
    hash_preimages: [text]

fn provider_restore_candidate_documents(raw_documents: any,
                                        scope_digest: text) -> Result<ProviderRestoredDocumentsV1, text>:
    if json_get_type(raw_documents) != "array" or
            not provider_live_document_count_valid(json_array_length(raw_documents)):
        return Err("snapshot_corrupt")
    var documents: [SearchDocument] = []
    var hashes: [text] = []
    var hash_preimages: [text] = []
    var ids: [text] = []
    var i = 0
    while i < json_array_length(raw_documents):
        val restored = restore_document(json_array_get(raw_documents, i),
                                        scope_digest)?
        if ids.contains(restored.0.id): return Err("snapshot_corrupt")
        ids.push(restored.0.id)
        documents.push(restored.0)
        hashes.push(restored.1)
        hash_preimages.push(restored.2)
        i = i + 1
    Ok(ProviderRestoredDocumentsV1(documents: documents, hashes: hashes,
        hash_preimages: hash_preimages))

fn provider_publication_state_bound(raw_publications: any,
                                    candidates: [ProviderCandidateV1],
                                    current_root: text) -> Result<i64, text>:
    val validation = validate_publications(raw_publications, candidates)?
    var published = 0
    var i = 0
    while i < candidates.len():
        if candidates[i].state == "published": published = published + 1
        i = i + 1
    val root_bound = (validation.0 == 0 and
        current_root == "sha256:" + "0" * 64) or
        (validation.0 > 0 and current_root == validation.1)
    if validation.0 != published or not root_bound:
        return Err("snapshot_corrupt")
    Ok(validation.2)
