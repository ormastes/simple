use std.common.search.analyzer.{AnalyzerIdentity}
use std.common.search.snapshot.{SearchSnapshot}

struct ProviderCapabilitiesV1:
    lexical: bool
    exact: bool
    explain: bool
    incremental: bool
    phrase: bool
    regex: bool
    wildcard: bool
    semantic: bool
    duplicate_candidates: bool
    symbols_snapshot: bool

impl ProviderCapabilitiesV1:
    static fn simple_lexical() -> ProviderCapabilitiesV1:
        ProviderCapabilitiesV1(
            lexical: true, exact: true, explain: true, incremental: true,
            phrase: false, regex: false, wildcard: false, semantic: false,
            duplicate_candidates: false, symbols_snapshot: false,
        )

class SpipeProviderStateV1:
    initialized: bool
    shutting_down: bool
    generation_quarantined: bool
    provider_generation: i64
    workspace: text
    snapshot_id: text
    scope_digest: text
    logical_root: text
    snapshot_value: SearchSnapshot
    capabilities_value: ProviderCapabilitiesV1
    known_request_ids: [text]
    pending_request_ids: [text]
    completed_request_ids: [text]
    cancelled_request_ids: [text]

    static fn empty() -> SpipeProviderStateV1:
        SpipeProviderStateV1(
            initialized: false, shutting_down: false,
            generation_quarantined: false, provider_generation: 0,
            workspace: "", snapshot_id: "", scope_digest: "",
            logical_root: "",
            snapshot_value: SearchSnapshot.of("", "", AnalyzerIdentity.spipe_v1(), []),
            capabilities_value: ProviderCapabilitiesV1.simple_lexical(),
            known_request_ids: [], pending_request_ids: [],
            completed_request_ids: [],
            cancelled_request_ids: [],
        )

    # State-owner constructor used at the initialize ownership boundary.
    # Keeping the complete class construction in this module avoids both
    # nested receiver mutation and cross-module partial class construction.
    static fn initialized_bound(workspace: text, snapshot_id: text,
                                scope_digest: text, provider_generation: i64,
                                logical_root: text,
                                snapshot_value: SearchSnapshot,
                                capabilities: ProviderCapabilitiesV1,
                                cancelled_request_ids: [text],
                                generation_quarantined: bool) -> SpipeProviderStateV1:
        SpipeProviderStateV1(
            initialized: true, shutting_down: false,
            generation_quarantined: generation_quarantined,
            provider_generation: provider_generation,
            workspace: workspace, snapshot_id: snapshot_id,
            scope_digest: scope_digest, logical_root: logical_root,
            snapshot_value: snapshot_value,
            capabilities_value: capabilities,
            known_request_ids: [], pending_request_ids: [],
            completed_request_ids: [],
            cancelled_request_ids: cancelled_request_ids,
        )

    fn capabilities() -> ProviderCapabilitiesV1:
        self.capabilities_value

    fn request_allowed() -> bool:
        self.initialized and not self.shutting_down and
            not self.generation_quarantined

    me quarantine_generation():
        self.generation_quarantined = true

    fn request_cancelled(request_id: text) -> bool:
        var i = 0
        while i < self.cancelled_request_ids.len():
            if self.cancelled_request_ids[i] == request_id:
                return true
            i = i + 1
        false

    me admit_request(request_id: text):
        if not self.known_request_ids.contains(request_id):
            self.known_request_ids.push(request_id)
            self.pending_request_ids.push(request_id)

    me complete_request(request_id: text):
        if self.known_request_ids.contains(request_id) and
                not self.completed_request_ids.contains(request_id):
            self.completed_request_ids.push(request_id)

    me cancel(target_request_id: text) -> Result<text, text>:
        if target_request_id == "" or not self.known_request_ids.contains(target_request_id):
            return Err("cancel_target_not_found")
        if self.completed_request_ids.contains(target_request_id) or
                self.request_cancelled(target_request_id):
            return Ok("already_complete")
        if not self.pending_request_ids.contains(target_request_id):
            return Err("cancel_target_not_found")
        self.cancelled_request_ids.push(target_request_id)
        Ok("cancelled")

    me shutdown() -> Result<text, text>:
        if self.shutting_down:
            return Err("shutdown_in_progress")
        self.shutting_down = true
        Ok("shutdown")
