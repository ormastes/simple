# SPipe knowledge provider v1 wire primitives.
# The provider is a persistent length-framed JSON process. This module keeps
# framing separate from request execution so malformed input can fail closed.
use std.common.string_core.{text_to_bytes}

val SPIPE_PROVIDER_PROTOCOL_MAJOR: i64 = 1
val SPIPE_PROVIDER_PROTOCOL_MINOR: i64 = 0
val SPIPE_PROVIDER_MAX_FRAME_BYTES: i64 = 1048576

struct ProviderFrameReadV1:
    ok: bool
    payload: text
    error_code: text

impl ProviderFrameReadV1:
    static fn success(payload: text) -> ProviderFrameReadV1:
        ProviderFrameReadV1(ok: true, payload: payload, error_code: "")

    static fn failure(code: text) -> ProviderFrameReadV1:
        ProviderFrameReadV1(ok: false, payload: "", error_code: code)

fn _hex_digit(value: i64) -> text:
    val digits = "0123456789abcdef"
    digits.slice(value, value + 1)

fn provider_frame_header(payload_length: i64) -> Result<text, text>:
    if payload_length < 0 or payload_length > SPIPE_PROVIDER_MAX_FRAME_BYTES:
        return Err("frame_too_large")
    var value = payload_length
    var chars: [text] = []
    var i = 0
    while i < 8:
        chars.push(_hex_digit(value % 16))
        value = value / 16
        i = i + 1
    Ok(chars[7] + chars[6] + chars[5] + chars[4] + chars[3] + chars[2] + chars[1] + chars[0])

fn _hex_value(ch: text) -> i64:
    val digits = "0123456789abcdef"
    var i = 0
    while i < 16:
        if digits.slice(i, i + 1) == ch:
            return i
        i = i + 1
    0 - 1

fn provider_parse_frame(frame: text) -> ProviderFrameReadV1:
    if frame.len() < 8:
        return ProviderFrameReadV1.failure("malformed_frame")
    var length = 0
    var i = 0
    while i < 8:
        val digit = _hex_value(frame.slice(i, i + 1))
        if digit < 0:
            return ProviderFrameReadV1.failure("malformed_frame")
        length = (length * 16) + digit
        i = i + 1
    if length > SPIPE_PROVIDER_MAX_FRAME_BYTES:
        return ProviderFrameReadV1.failure("frame_too_large")
    if frame.len() != length + 8:
        return ProviderFrameReadV1.failure("malformed_frame")
    ProviderFrameReadV1.success(frame.slice(8, frame.len()))

fn provider_encode_frame(canonical_payload: text) -> Result<text, text>:
    val header = provider_frame_header(text_to_bytes(canonical_payload).len())?
    Ok(header + canonical_payload)

fn provider_json_escape(value: text) -> text:
    value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")

fn provider_prebinding_error(request_id: text, operation: text, code: text, message: text) -> text:
    "{\"error\":{\"code\":\"{provider_json_escape(code)}\",\"message\":\"{provider_json_escape(message)}\",\"retryable\":false},\"ok\":false,\"operation\":\"{provider_json_escape(operation)}\",\"protocol\":{\"major\":1,\"minor\":0},\"request_id\":\"{provider_json_escape(request_id)}\"}"

fn provider_error_retryable(code: text) -> bool:
    code == "deadline_exceeded" or code == "internal_error" or
        code == "provider_unavailable" or code == "semantic_unavailable"

fn provider_closed_error_code(reason: text) -> text:
    # §14.18: `invalid_utf8` and `frame_too_large` are TransportDiagnosticV1
    # codes -- local, payload-free evidence that must close the connection
    # silently and can NEVER be serialized as a ProviderErrorV1 response.
    # They are deliberately absent from `declared` below (production code
    # never passes them here today; this is defense-in-depth so a future
    # caller that did could not smuggle either through as-is -- the
    # fallthrough below maps any unrecognized reason to "internal_error").
    val declared = ["invalid_request", "noncanonical_json",
        "limit_exceeded", "protocol_unsupported",
        "handshake_required", "incompatible_contract", "binding_mismatch",
        "unsupported_capability", "unsupported_scope", "snapshot_not_found",
        "snapshot_conflict", "snapshot_corrupt", "invalid_corpus_n",
        "invalid_document_frequency", "invalid_average_length",
        "invalid_denominator", "invalid_parallel_arrays",
        "invalid_logarithm_input", "score_overflow", "unauthorized",
        "stale_cursor", "stale_base", "operation_conflict",
        "candidate_missing", "candidate_expired", "candidate_aborted",
        "deadline_exceeded", "cancelled", "cancel_target_not_found",
        "semantic_unavailable", "semantic_mismatch", "provider_unavailable",
        "internal_error", "fatal_provider_error"]
    if declared.contains(reason): return reason
    if reason == "empty_query" or reason == "unknown_operation":
        return "invalid_request"
    if reason == "invalid_cursor": return "stale_cursor"
    if reason == "candidate_mismatch": return "binding_mismatch"
    if reason == "candidate_published" or reason == "candidate_stale_base":
        return "stale_base"
    if reason == "document_not_found": return "snapshot_not_found"
    if reason == "signing_failed" or reason == "receipt_authority_unavailable" or
            reason == "transition_authority_unavailable":
        return "provider_unavailable"
    if reason == "storage_busy" or reason == "storage_error" or
            reason == "lifecycle_conflict":
        return "internal_error"
    "internal_error"

fn provider_bound_error(request_id: text, operation: text, generation: text,
                        workspace: text, snapshot: text, scope_digest: text,
                        code: text, message: text) -> text:
    val closed_code = provider_closed_error_code(code)
    val retryable = if provider_error_retryable(closed_code): "true" else: "false"
    "{\"error\":{\"code\":\"{provider_json_escape(closed_code)}\",\"message\":\"{provider_json_escape(message)}\",\"retryable\":" + retryable + "},\"ok\":false,\"operation\":\"{provider_json_escape(operation)}\",\"operation_receipt\":null,\"protocol\":{\"major\":1,\"minor\":0},\"provider_generation\":\"{provider_json_escape(generation)}\",\"query_receipt\":null,\"request_id\":\"{provider_json_escape(request_id)}\",\"scope_digest\":\"{provider_json_escape(scope_digest)}\",\"snapshot\":\"{provider_json_escape(snapshot)}\",\"workspace\":\"{provider_json_escape(workspace)}\"}"
