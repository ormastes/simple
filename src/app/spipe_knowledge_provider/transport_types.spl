# Frozen protocol-independent transport records for provider protocol 1.0.

val ProviderByteIoStatusV1: [text] = ["data", "timeout", "eof", "error"]

struct ProviderTransportLimitsV1:
    max_frame_bytes: i64
    read_chunk_bytes: i64
    write_chunk_bytes: i64
    max_queued_requests: i64
    max_pending_bytes: i64
    ingress_timeout_ms: i64
    output_timeout_ms: i64

struct ProviderByteReadV1:
    status: text
    bytes: [u8]
    detail: text

struct ProviderByteWriteV1:
    status: text
    written_bytes: i64
    detail: text

fn provider_transport_limits_v1() -> ProviderTransportLimitsV1:
    ProviderTransportLimitsV1(
        max_frame_bytes: 1048576,
        read_chunk_bytes: 16384,
        write_chunk_bytes: 16384,
        max_queued_requests: 16,
        max_pending_bytes: 2097152,
        ingress_timeout_ms: 30000,
        output_timeout_ms: 30000)

fn provider_transport_limits_valid_v1(limits: ProviderTransportLimitsV1) -> bool:
    limits.max_frame_bytes > 0 and limits.max_frame_bytes <= 1048576 and
        limits.read_chunk_bytes > 0 and
        limits.read_chunk_bytes <= limits.max_frame_bytes and
        limits.write_chunk_bytes > 0 and
        limits.write_chunk_bytes <= limits.max_frame_bytes and
        limits.max_queued_requests >= 0 and limits.max_queued_requests <= 16 and
        limits.max_pending_bytes >= limits.max_frame_bytes and
        limits.max_pending_bytes <= 2097152 and
        limits.ingress_timeout_ms > 0 and limits.ingress_timeout_ms <= 30000 and
        limits.output_timeout_ms > 0 and limits.output_timeout_ms <= 30000

export ProviderByteIoStatusV1, ProviderTransportLimitsV1
export ProviderByteReadV1, ProviderByteWriteV1
export provider_transport_limits_v1, provider_transport_limits_valid_v1
