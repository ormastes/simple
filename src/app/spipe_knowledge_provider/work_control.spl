# Request-scoped cooperative work-control vocabulary.  The session owner binds
# request identity once when constructing a checkpoint adapter; leaf algorithms
# receive no ambient clock, cancellation handle, or mutable service reference.

struct ProviderRequestControlHandleV1:
    request_id: text
    registration_generation: i64

struct ProviderBudgetChargeV1:
    category: text
    amount: i64

struct ProviderBudgetLimitV1:
    category: text
    limit: i64

trait ProviderBudgetPort:
    me charge(charge: ProviderBudgetChargeV1) -> Result<(), text>
    me charge_all(charges: [ProviderBudgetChargeV1]) -> Result<(), text>
    fn consumed(category: text) -> i64
    fn limit(category: text) -> i64

struct ProviderCheckpointProgressV1:
    stage: text
    bytes: i64
    events: i64
    scalars: i64
    hash_blocks: i64
    comparisons: i64

trait ProviderCheckpointPort:
    me checkpoint(progress: ProviderCheckpointProgressV1) -> Result<(), text>

fn provider_budget_category_raw_bytes() -> text: "raw_bytes"
fn provider_budget_category_decoded_bytes() -> text: "decoded_bytes"
fn provider_budget_category_output_bytes() -> text: "output_bytes"
fn provider_budget_category_json_events() -> text: "json_events"
fn provider_budget_category_json_depth() -> text: "json_depth"
fn provider_budget_category_normalization_carry() -> text: "normalization_carry"
fn provider_budget_category_case_carry() -> text: "case_carry"
fn provider_budget_category_token_carry() -> text: "token_carry"
fn provider_budget_category_tokens() -> text: "tokens"
fn provider_budget_category_terms() -> text: "terms"
fn provider_budget_category_candidates() -> text: "candidates"
fn provider_budget_category_comparisons() -> text: "comparisons"
fn provider_budget_category_logical_allocations() -> text: "logical_allocations"
fn provider_budget_category_durable_record_bytes() -> text: "durable_record_bytes"
fn provider_budget_category_hash_blocks() -> text: "hash_blocks"
fn provider_budget_category_scalars() -> text: "scalars"

fn provider_budget_category_valid_v1(category: text) -> bool:
    category == "raw_bytes" or category == "decoded_bytes" or
        category == "output_bytes" or category == "json_events" or
        category == "json_depth" or category == "normalization_carry" or
        category == "case_carry" or category == "token_carry" or
        category == "tokens" or category == "terms" or
        category == "candidates" or category == "comparisons" or
        category == "logical_allocations" or
        category == "durable_record_bytes" or category == "hash_blocks" or
        category == "scalars"

class ProviderBoundedBudgetV1 with ProviderBudgetPort:
    categories: [text]
    limits: [i64]
    var consumed_values: [i64]
    var closed: bool

    static fn configured(entries: [ProviderBudgetLimitV1]) -> Result<ProviderBoundedBudgetV1, text>:
        var categories: [text] = []
        var limits: [i64] = []
        var consumed_values: [i64] = []
        for entry in entries:
            if not provider_budget_category_valid_v1(entry.category):
                return Err("unknown_budget_category")
            if entry.limit < 0: return Err("invalid_budget_limit")
            for existing in categories:
                if existing == entry.category:
                    return Err("duplicate_budget_category")
            categories = categories.push(entry.category)
            limits = limits.push(entry.limit)
            consumed_values = consumed_values.push(0)
        Ok(ProviderBoundedBudgetV1(categories: categories, limits: limits,
            consumed_values: consumed_values, closed: false))

    fn _index(category: text) -> i64:
        for i in 0..self.categories.len():
            if self.categories[i] == category: return i
        -1

    me charge(charge: ProviderBudgetChargeV1) -> Result<(), text>:
        self.charge_all([charge])

    me charge_all(charges: [ProviderBudgetChargeV1]) -> Result<(), text>:
        if self.closed: return Err("budget_closed")
        if charges.len() == 0: return Err("invalid_budget_charge")

        # Aggregate into owner-local scratch state.  No live counter changes
        # until every category, amount, sum, and configured limit is valid.
        var aggregate: [i64] = []
        for _category in self.categories: aggregate = aggregate.push(0)
        for charge in charges:
            if charge.amount <= 0: return Err("invalid_budget_charge")
            val index = self._index(charge.category)
            if index < 0: return Err("unknown_budget_category")
            val prior = aggregate[index]
            if charge.amount > 9223372036854775807 - prior:
                return Err("budget_charge_overflow")
            aggregate[index] = prior + charge.amount

        for i in 0..self.categories.len():
            val current = self.consumed_values[i]
            val maximum = self.limits[i]
            # Subtraction is safe because configured limits and all committed
            # counters are non-negative.  Validate the whole batch first.
            if current > maximum or aggregate[i] > maximum - current:
                return Err("limit_exceeded")

        for i in 0..self.categories.len():
            self.consumed_values[i] = self.consumed_values[i] + aggregate[i]
        Ok(())

    fn consumed(category: text) -> i64:
        val index = self._index(category)
        if index < 0: return -1
        self.consumed_values[index]

    fn limit(category: text) -> i64:
        val index = self._index(category)
        if index < 0: return -1
        self.limits[index]

    me close():
        self.closed = true

class ProviderDeterministicCheckpointV1 with ProviderCheckpointPort:
    request: ProviderRequestControlHandleV1
    maximum_progress: ProviderCheckpointProgressV1
    fail_after_checkpoints: i64
    failure_reason: text
    var checkpoint_count: i64
    var closed: bool

    static fn configured(request: ProviderRequestControlHandleV1,
                         maximum_progress: ProviderCheckpointProgressV1,
                         fail_after_checkpoints: i64,
                         failure_reason: text) -> Result<ProviderDeterministicCheckpointV1, text>:
        if request.request_id == "" or request.registration_generation <= 0:
            return Err("invalid_request_control_handle")
        if not _provider_checkpoint_progress_valid(maximum_progress):
            return Err("invalid_checkpoint_limit")
        if fail_after_checkpoints < -1:
            return Err("invalid_checkpoint_limit")
        if failure_reason != "" and failure_reason != "cancelled" and
            failure_reason != "deadline_exceeded" and
            failure_reason != "limit_exceeded" and
            failure_reason != "internal_error":
            return Err("invalid_checkpoint_failure")
        Ok(ProviderDeterministicCheckpointV1(request: request,
            maximum_progress: maximum_progress,
            fail_after_checkpoints: fail_after_checkpoints,
            failure_reason: failure_reason, checkpoint_count: 0,
            closed: false))

    me checkpoint(progress: ProviderCheckpointProgressV1) -> Result<(), text>:
        if self.closed: return Err("checkpoint_closed")
        if not _provider_checkpoint_progress_valid(progress):
            return Err("invalid_checkpoint_progress")
        if progress.bytes > self.maximum_progress.bytes or
            progress.events > self.maximum_progress.events or
            progress.scalars > self.maximum_progress.scalars or
            progress.hash_blocks > self.maximum_progress.hash_blocks or
            progress.comparisons > self.maximum_progress.comparisons:
            return Err("limit_exceeded")
        if self.checkpoint_count == 9223372036854775807:
            return Err("internal_error")
        if self.fail_after_checkpoints >= 0 and
            self.checkpoint_count >= self.fail_after_checkpoints:
            if self.failure_reason == "": return Err("internal_error")
            return Err(self.failure_reason)
        self.checkpoint_count = self.checkpoint_count + 1
        Ok(())

    fn bound_request() -> ProviderRequestControlHandleV1:
        self.request

    me close():
        self.closed = true

fn _provider_checkpoint_progress_valid(progress: ProviderCheckpointProgressV1) -> bool:
    progress.stage != "" and progress.bytes >= 0 and progress.events >= 0 and
        progress.scalars >= 0 and progress.hash_blocks >= 0 and
        progress.comparisons >= 0

export ProviderRequestControlHandleV1
export ProviderBudgetChargeV1, ProviderBudgetLimitV1, ProviderBudgetPort
export ProviderCheckpointProgressV1, ProviderCheckpointPort
export ProviderBoundedBudgetV1, ProviderDeterministicCheckpointV1
export provider_budget_category_valid_v1
export provider_budget_category_raw_bytes, provider_budget_category_decoded_bytes
export provider_budget_category_output_bytes, provider_budget_category_json_events
export provider_budget_category_json_depth, provider_budget_category_normalization_carry
export provider_budget_category_case_carry, provider_budget_category_token_carry
export provider_budget_category_tokens, provider_budget_category_terms
export provider_budget_category_candidates, provider_budget_category_comparisons
export provider_budget_category_logical_allocations
export provider_budget_category_durable_record_bytes
export provider_budget_category_hash_blocks, provider_budget_category_scalars
