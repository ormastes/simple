# gen_cache_model — SDN -> Lean generator for the cache protocol formal model (C6).
#
# Reads the normative schema src/compiler/80.driver/cache/schema/cache_protocol.sdn
# and emits, under src/verification/cache_protocol/:
#   src/CacheProtocol/Generated/Model.lean       (structures + canonical encoder + injectivity core)
#   src/CacheProtocol/Generated/Visibility.lean  (one *_change_visible per KEY field,
#                                                 one *_absent per excluded_from_key entry)
#   src/CacheProtocol/Generated/Golden.lean      (cross-language golden vectors, machine-checked)
#   golden/golden_vectors.sdn                    (same vectors for the Simple side)
#
# Durable manual proofs live in src/CacheProtocol/Theorems/ — NEVER written here.
# Run from the repo root:  bin/simple run src/app/gen_cache_model/main.spl
# Success is signalled by the LAST stdout line: "GEN OK". Anything else is failure.

use std.common.crypto.sha256.{sha256_text}
use std.common.crypto.types.{text_to_bytes}

extern fn rt_file_read_text(path: text) -> text
use std.io_runtime.{file_write}

val SCHEMA_PATH = "src/compiler/80.driver/cache/schema/cache_protocol.sdn"
val TMPL_DIR = "src/app/gen_cache_model/templates"
val OUT_DIR = "src/verification/cache_protocol"

# ---------------------------------------------------------------------------
# Small text helpers
# ---------------------------------------------------------------------------

fn extract(line: text, key: text) -> text:
    val marker = key + ":"
    val parts = line.split(marker)
    if parts.len() < 2:
        return ""
    var rest = parts[1]
    val c1 = rest.split(",")
    rest = c1[0]
    val c2 = rest.split("}")
    rest = c2[0]
    val out = rest.trim()
    out

# snake_case -> camelCase check helper not needed; schema carries both name and tag.

# ---------------------------------------------------------------------------
# Schema parsing
# ---------------------------------------------------------------------------

struct Field:
    name: text
    tag: text
    typ: text

fn parse_canonical_order(lines: [text]) -> [Field]:
    var rows: [Field] = []
    var inside = false
    for line in lines:
        val t = line.trim()
        if not inside:
            if t == "canonical_order:":
                inside = true
        else:
            if t.starts_with("- {"):
                val name = extract(t, "name")
                val tag = extract(t, "tag")
                val typ = extract(t, "type")
                val cls = extract(t, "class")
                if cls != "KEY":
                    print "GEN ERROR: canonical_order row with class != KEY: {name}"
                    return []
                rows.push(Field(name, tag, typ))
            elif t.starts_with("#"):
                pass
            else:
                inside = false
    rows

fn parse_excluded(lines: [text]) -> [text]:
    var names: [text] = []
    var inside = false
    for line in lines:
        val t = line.trim()
        if not inside:
            if t == "excluded_from_key:":
                inside = true
        else:
            if t.starts_with("- {"):
                names.push(extract(t, "name"))
            elif t.starts_with("#"):
                pass
            else:
                inside = false
    names

fn parse_result_kind_values(lines: [text]) -> [text]:
    var vals: [text] = []
    var inside = false
    var buf = ""
    for line in lines:
        if not inside:
            if line.contains("values: [interpreter_module"):
                inside = true
                val parts = line.split("[")
                buf = parts[1]
        else:
            buf = buf + " " + line.trim()
        if inside and buf.contains("]"):
            val body0 = buf.split("]")
            val body = body0[0]
            val items = body.split(",")
            for it in items:
                val v = it.trim()
                if v != "":
                    vals.push(v)
            return vals
    vals

# ---------------------------------------------------------------------------
# Lean rendering per field type
# ---------------------------------------------------------------------------

fn lean_type(typ: text) -> text:
    if typ == "digest":
        return "Sha"
    if typ == "text":
        return "String"
    if typ == "u32":
        return "Nat"
    if typ == "set<text>" or typ == "set<digest>":
        return "List String"
    if typ == "set<dep>":
        return "List Dep"
    if typ == "result_kind":
        return "ResultKind"
    "UNSUPPORTED_TYPE_{typ}"

# canonKey assignment value for a field
fn canon_value(tag: text, typ: text) -> text:
    if typ == "set<text>" or typ == "set<digest>":
        return "sortStrs k.{tag}"
    if typ == "set<dep>":
        return "sortDeps k.{tag}"
    "k.{tag}"

# encode leaf for a field
fn encode_leaf(tag: text, typ: text) -> text:
    if typ == "u32":
        return ".nat k.{tag}"
    if typ == "set<text>" or typ == "set<digest>":
        return ".strs (sortStrs k.{tag})"
    if typ == "set<dep>":
        return ".deps (sortDeps k.{tag})"
    if typ == "result_kind":
        return ".str k.{tag}.name"
    ".str k.{tag}"

# wire leaf for a field
fn wire_leaf(tag: text, typ: text) -> text:
    if typ == "u32":
        return "sNat k.{tag}"
    if typ == "set<text>" or typ == "set<digest>":
        return "sSeq ((sortStrs k.{tag}).map sStr)"
    if typ == "set<dep>":
        return "sSeq ((sortDeps k.{tag}).map sDep)"
    if typ == "result_kind":
        return "sStr k.{tag}.name"
    "sStr k.{tag}"

# hypothesis reference on canonKey projections in *_change_visible statements
fn vis_side(kvar: text, tag: text, typ: text) -> text:
    if typ == "set<text>" or typ == "set<digest>":
        return "sortStrs {kvar}.{tag}"
    if typ == "set<dep>":
        return "sortDeps {kvar}.{tag}"
    "{kvar}.{tag}"

# ---------------------------------------------------------------------------
# Section generators (each returns a block of lines joined by \n)
# ---------------------------------------------------------------------------

fn gen_result_kind_ctors(vals: [text]) -> text:
    var out = ""
    for v in vals:
        out = out + "  | {v}\n"
    out.trim_end()

fn gen_result_kind_name_arms(vals: [text]) -> text:
    var out = ""
    for v in vals:
        out = out + "  | .{v} => \"{v}\"\n"
    out.trim_end()

fn gen_actionkey_fields(fields: [Field]) -> text:
    var out = ""
    var pos = 1
    for f in fields:
        out = out + "  {f.tag} : {lean_type(f.typ)}  -- pos {pos} {f.name}\n"
        pos = pos + 1
    out.trim_end()

fn gen_canonkey_fields(fields: [Field]) -> text:
    var out = ""
    for f in fields:
        out = out + "  {f.tag} : {lean_type(f.typ)}\n"
    out.trim_end()

fn gen_canonkey_assigns(fields: [Field]) -> text:
    var out = ""
    for f in fields:
        out = out + "  , {f.tag} := {canon_value(f.tag, f.typ)}\n"
    out.trim_end()

fn gen_encode_fields(fields: [Field]) -> text:
    var out = ""
    val n = fields.len()
    var i = 0
    for f in fields:
        if i == n - 1:
            out = out + "    Canon.tag \"{f.tag}\" ({encode_leaf(f.tag, f.typ)})\n"
        else:
            out = out + "    Canon.pair (.tag \"{f.tag}\" ({encode_leaf(f.tag, f.typ)})) <|\n"
        i = i + 1
    out.trim_end()

fn gen_wire_fields(fields: [Field]) -> text:
    var out = ""
    var i = 0
    for f in fields:
        if i == 0:
            out = out + "    [ sField \"{f.tag}\" ({wire_leaf(f.tag, f.typ)})\n"
        else:
            out = out + "    , sField \"{f.tag}\" ({wire_leaf(f.tag, f.typ)})\n"
        i = i + 1
    out = out + "    ]"
    out

fn hyp_list(count: i64) -> text:
    # "h0, h1, ..., h<count-1>"
    var out = ""
    var i = 0
    while i < count:
        if i > 0:
            out = out + ", "
        out = out + "h{i}"
        i = i + 1
    out

fn gen_edc_proof(fields: [Field]) -> text:
    val total = fields.len() + 1  # + domain
    var out = "  obtain ⟨" + hyp_list(total) + "⟩ := h\n"
    # simp list: replace the hypothesis of any result_kind field with its
    # name-injectivity-lifted version.
    var simps = ""
    var i = 0
    while i < total:
        var href = "h{i}"
        if i > 0:
            val f = fields[i - 1]
            if f.typ == "result_kind":
                out = out + "  have h{i}k : k1.{f.tag} = k2.{f.tag} := ResultKind.name_inj _ _ h{i}\n"
                href = "h{i}k"
        if i > 0:
            simps = simps + ", "
        simps = simps + href
        i = i + 1
    out = out + "  simp only [canonKey, " + simps + "]"
    out

fn gen_cde_proof(fields: [Field]) -> text:
    val total = fields.len() + 1
    var out = "  have h0 := congrArg CanonKey.domain h\n"
    var i = 1
    for f in fields:
        out = out + "  have h{i} := congrArg CanonKey.{f.tag} h\n"
        i = i + 1
    var hs = ""
    i = 0
    while i < total:
        if i > 0:
            hs = hs + " "
        hs = hs + "h{i}"
        i = i + 1
    out = out + "  simp only [canonKey] at " + hs + "\n"
    out = out + "  simp only [encode, " + hyp_list(total) + "]"
    out

fn gen_visibility_theorems(fields: [Field]) -> text:
    var out = ""
    # position 0: domain
    out = out + "theorem domain_change_visible (k1 k2 : ActionKey)\n"
    out = out + "    (h : k1.domain ≠ k2.domain) : encode k1 ≠ encode k2 :=\n"
    out = out + "  field_change_visible CanonKey.domain k1 k2 h\n\n"
    for f in fields:
        val lhs = vis_side("k1", f.tag, f.typ)
        val rhs = vis_side("k2", f.tag, f.typ)
        out = out + "theorem {f.name}_change_visible (k1 k2 : ActionKey)\n"
        out = out + "    (h : {lhs} ≠ {rhs}) : encode k1 ≠ encode k2 :=\n"
        out = out + "  field_change_visible CanonKey.{f.tag} k1 k2 h\n\n"
    out.trim_end() + "\n"

fn gen_excluded_fields(names: [text]) -> text:
    var out = ""
    for n in names:
        out = out + "  {n} : String := \"\"\n"
    out.trim_end()

fn gen_absent_theorems(names: [text], tmpl: text) -> text:
    var out = ""
    for n in names:
        var th = tmpl.replace("@NAME@", n)
        out = out + th + "\n"
    out.trim_end() + "\n"

# ---------------------------------------------------------------------------
# Wire encoder (mirrors action_key.spl canon_* — used ONLY to compute golden
# vector expectations; nothing here is emitted as Simple code)
# ---------------------------------------------------------------------------

fn g_str(s: text) -> text:
    "S" + "{s.len()}" + ":" + s

fn g_nat(n: i64) -> text:
    "N" + "{n}" + ";"

fn g_field(tag: text, v: text) -> text:
    "F" + "{tag.len()}" + ":" + tag + v

fn g_seq(items: [text]) -> text:
    var body = ""
    for item in items:
        body = body + item
    "Q" + "{items.len()}" + ":" + body

# Byte-wise lexicographic order — mirrors action_key_text_lt / Lean String `<`.
fn g_text_lt(a: text, b: text) -> bool:
    val ab = text_to_bytes(a)
    val bb = text_to_bytes(b)
    val an = ab.len()
    val bn = bb.len()
    var i = 0
    while i < an and i < bn:
        val ca = ab[i] as i64
        val cb = bb[i] as i64
        if ca < cb:
            return true
        if ca > cb:
            return false
        i = i + 1
    an < bn

fn g_text_le(a: text, b: text) -> bool:
    if g_text_lt(a, b):
        return true
    a == b

fn g_sort(items: [text]) -> [text]:
    var out: [text] = []
    for item in items:
        var next: [text] = []
        var placed = false
        for d in out:
            if not placed and g_text_le(item, d):
                next.push(item)
                placed = true
            next.push(d)
        if not placed:
            next.push(item)
        out = next
    out

# Golden key: 21 field values. Sets are given possibly-unsorted; deps as
# parallel arrays (module ids and iface digests, index-paired).
struct GKey:
    domain: text
    compiler_exe: text
    live_compiler_src: text
    schema_version: i64
    target_triple: text
    host_arch: text
    cfg_features: [text]
    stdlib_variant: text
    runtime_family: text
    source_content: text
    resolution_witness: text
    dep_mods: [text]
    dep_ifaces: [text]
    macro_root: text
    aop_selection: text
    ct_env_inputs: [text]
    schema_digest: text
    aop_surface_root: text
    aop_candidate_partition_roots: [text]
    aop_weave_root: text
    block_manifest_roots: [text]
    result_kind: text

# Mirrors action_dep_le: lexicographic on (module_id, iface_digest).
fn g_dep_le(am: text, ai: text, bm: text, bi: text) -> bool:
    if g_text_lt(am, bm):
        return true
    if am == bm:
        return g_text_le(ai, bi)
    false

fn g_sorted_dep_items(mods: [text], ifaces: [text]) -> [text]:
    # insertion sort on index-paired (module_id, iface_digest) arrays,
    # then emit the canonical dep encoding per pair.
    var sm: [text] = []
    var si: [text] = []
    var i = 0
    while i < mods.len():
        var nm: [text] = []
        var ni: [text] = []
        var placed = false
        var j = 0
        while j < sm.len():
            if not placed and g_dep_le(mods[i], ifaces[i], sm[j], si[j]):
                nm.push(mods[i])
                ni.push(ifaces[i])
                placed = true
            nm.push(sm[j])
            ni.push(si[j])
            j = j + 1
        if not placed:
            nm.push(mods[i])
            ni.push(ifaces[i])
        sm = nm
        si = ni
        i = i + 1
    var items: [text] = []
    var p = 0
    while p < sm.len():
        var one: [text] = []
        one.push(g_field("moduleId", g_str(sm[p])))
        one.push(g_field("ifaceDigest", g_str(si[p])))
        items.push(g_seq(one))
        p = p + 1
    items
fn g_wire(k: GKey) -> text:
    var cfg_items: [text] = []
    for c in g_sort(k.cfg_features):
        cfg_items.push(g_str(c))
    var env_items: [text] = []
    for e in g_sort(k.ct_env_inputs):
        env_items.push(g_str(e))
    var aop_items: [text] = []
    for a in g_sort(k.aop_candidate_partition_roots):
        aop_items.push(g_str(a))
    var blk_items: [text] = []
    for b in g_sort(k.block_manifest_roots):
        blk_items.push(g_str(b))
    val dep_items = g_sorted_dep_items(k.dep_mods, k.dep_ifaces)

    var inner: [text] = []
    inner.push(g_field("compilerExe", g_str(k.compiler_exe)))
    inner.push(g_field("liveCompilerSrc", g_str(k.live_compiler_src)))
    inner.push(g_field("schemaVersion", g_nat(k.schema_version)))
    inner.push(g_field("targetTriple", g_str(k.target_triple)))
    inner.push(g_field("hostArch", g_str(k.host_arch)))
    inner.push(g_field("cfgFeatures", g_seq(cfg_items)))
    inner.push(g_field("stdlibVariant", g_str(k.stdlib_variant)))
    inner.push(g_field("runtimeFamily", g_str(k.runtime_family)))
    inner.push(g_field("sourceContent", g_str(k.source_content)))
    inner.push(g_field("resolutionWitness", g_str(k.resolution_witness)))
    inner.push(g_field("deps", g_seq(dep_items)))
    inner.push(g_field("macroRoot", g_str(k.macro_root)))
    inner.push(g_field("aopSelection", g_str(k.aop_selection)))
    inner.push(g_field("ctEnvInputs", g_seq(env_items)))
    inner.push(g_field("schemaDigest", g_str(k.schema_digest)))
    inner.push(g_field("aopSurfaceRoot", g_str(k.aop_surface_root)))
    inner.push(g_field("aopCandidatePartitionRoots", g_seq(aop_items)))
    inner.push(g_field("aopWeaveRoot", g_str(k.aop_weave_root)))
    inner.push(g_field("blockManifestRoots", g_seq(blk_items)))
    inner.push(g_field("resultKind", g_str(k.result_kind)))
    g_field(k.domain, g_seq(inner))

fn lean_str_list(items: [text]) -> text:
    var out = "["
    var i = 0
    for it in items:
        if i > 0:
            out = out + ", "
        out = out + "\"{it}\""
        i = i + 1
    out + "]"

fn lean_dep_list(mods: [text], ifaces: [text]) -> text:
    var out = "["
    var i = 0
    while i < mods.len():
        if i > 0:
            out = out + ", "
        out = out + "⟨\"{mods[i]}\", \"{ifaces[i]}\"⟩"
        i = i + 1
    out + "]"

fn golden_assigns(k: GKey) -> text:
    var out = "domain := \"{k.domain}\"\n"
    out = out + "  , compilerExe := \"{k.compiler_exe}\"\n"
    out = out + "  , liveCompilerSrc := \"{k.live_compiler_src}\"\n"
    out = out + "  , schemaVersion := {k.schema_version}\n"
    out = out + "  , targetTriple := \"{k.target_triple}\"\n"
    out = out + "  , hostArch := \"{k.host_arch}\"\n"
    out = out + "  , cfgFeatures := {lean_str_list(k.cfg_features)}\n"
    out = out + "  , stdlibVariant := \"{k.stdlib_variant}\"\n"
    out = out + "  , runtimeFamily := \"{k.runtime_family}\"\n"
    out = out + "  , sourceContent := \"{k.source_content}\"\n"
    out = out + "  , resolutionWitness := \"{k.resolution_witness}\"\n"
    out = out + "  , deps := {lean_dep_list(k.dep_mods, k.dep_ifaces)}\n"
    out = out + "  , macroRoot := \"{k.macro_root}\"\n"
    out = out + "  , aopSelection := \"{k.aop_selection}\"\n"
    out = out + "  , ctEnvInputs := {lean_str_list(k.ct_env_inputs)}\n"
    out = out + "  , schemaDigest := \"{k.schema_digest}\"\n"
    out = out + "  , aopSurfaceRoot := \"{k.aop_surface_root}\"\n"
    out = out + "  , aopCandidatePartitionRoots := {lean_str_list(k.aop_candidate_partition_roots)}\n"
    out = out + "  , aopWeaveRoot := \"{k.aop_weave_root}\"\n"
    out = out + "  , blockManifestRoots := {lean_str_list(k.block_manifest_roots)}\n"
    out = out + "  , resultKind := .{k.result_kind}"
    out

# ---------------------------------------------------------------------------
# Template expansion
# ---------------------------------------------------------------------------

fn expand(tmpl: text, markers: [text], blocks: [text]) -> text:
    var out = ""
    val lines = tmpl.split("\n")
    for line in lines:
        val t = line.trim()
        var replaced = false
        var i = 0
        while i < markers.len():
            if t == markers[i]:
                out = out + blocks[i] + "\n"
                replaced = true
            i = i + 1
        if not replaced:
            out = out + line + "\n"
    # avoid trailing extra newline drift: template already ends with newline
    out.trim_end() + "\n"

fn main():
    val schema = rt_file_read_text(SCHEMA_PATH)
    if schema == "":
        print "GEN ERROR: cannot read {SCHEMA_PATH}"
        return
    val lines = schema.split("\n")

    val fields = parse_canonical_order(lines)
    val excluded = parse_excluded(lines)
    val rk_values = parse_result_kind_values(lines)

    if fields.len() != 20:
        print "GEN ERROR: expected 20 canonical_order rows, got {fields.len()}"
        return
    if excluded.len() < 20:
        print "GEN ERROR: suspiciously few excluded_from_key rows: {excluded.len()}"
        return
    if rk_values.len() < 5:
        print "GEN ERROR: result_kind values not found ({rk_values.len()})"
        return

    val sentinel = sha256_text("Q0:")

    # ---- golden vectors -----------------------------------------------------
    val gv1 = GKey("simple/interpreter-module/v2", "ce-digest", "lcs-digest", 2,
                   "x86_64-unknown-linux-gnu", "x86_64",
                   ["a_feature", "z_feature"], "nogc_async_mut", "nogc",
                   "src-digest", "rw-digest",
                   ["mod_a", "mod_b"], ["iface_a", "iface_b"],
                   "macro-digest", "aop-digest", ["CT_A=1", "CT_B=2"],
                   "schema-digest", sentinel, [], sentinel, [],
                   "interpreter_module")
    # same SET content, reversed element order -> must produce identical bytes
    val gv2 = GKey("simple/interpreter-module/v2", "ce-digest", "lcs-digest", 2,
                   "x86_64-unknown-linux-gnu", "x86_64",
                   ["z_feature", "a_feature"], "nogc_async_mut", "nogc",
                   "src-digest", "rw-digest",
                   ["mod_b", "mod_a"], ["iface_b", "iface_a"],
                   "macro-digest", "aop-digest", ["CT_B=2", "CT_A=1"],
                   "schema-digest", sentinel, [], sentinel, [],
                   "interpreter_module")
    # fully-populated v2 suffix, unsorted new set fields
    val gv3 = GKey("simple/interpreter-module/v2", "ce2", "lcs2", 2,
                   "riscv64-unknown-linux-gnu", "riscv64",
                   ["f1"], "nogc_sync_mut", "nogc",
                   "src2", "rw2",
                   ["m1"], ["i1"],
                   "mr2", "aop2", [],
                   "sd2", "surface-root", ["p2", "p1"], "weave-root",
                   ["b2", "b1"], "object_file")

    val w1 = g_wire(gv1)
    val w2 = g_wire(gv2)
    val w3 = g_wire(gv3)
    if w1 != w2:
        print "GEN ERROR: reordered-set golden vectors disagree; sort is broken"
        return

    # ---- Model.lean ---------------------------------------------------------
    val model_tmpl = rt_file_read_text(TMPL_DIR + "/model.lean.tmpl")
    if model_tmpl == "":
        print "GEN ERROR: missing model.lean.tmpl"
        return
    var model = expand(model_tmpl,
        ["@@RESULT_KIND_CTORS@@", "@@RESULT_KIND_NAME_ARMS@@",
         "@@ACTIONKEY_FIELDS@@", "@@CANONKEY_FIELDS@@", "@@CANONKEY_ASSIGNS@@",
         "@@ENCODE_FIELDS@@", "@@EDC_PROOF@@", "@@CDE_PROOF@@",
         "@@EXCLUDED_FIELDS@@", "@@WIRE_FIELDS@@"],
        [gen_result_kind_ctors(rk_values), gen_result_kind_name_arms(rk_values),
         gen_actionkey_fields(fields), gen_canonkey_fields(fields),
         gen_canonkey_assigns(fields), gen_encode_fields(fields),
         gen_edc_proof(fields), gen_cde_proof(fields),
         gen_excluded_fields(excluded), gen_wire_fields(fields)])
    model = model.replace("@@SENTINEL@@", sentinel)

    # ---- Visibility.lean ----------------------------------------------------
    val vis_tmpl = rt_file_read_text(TMPL_DIR + "/visibility.lean.tmpl")
    val absent_tmpl0 = rt_file_read_text(TMPL_DIR + "/absent_theorem.tmpl")
    if vis_tmpl == "" or absent_tmpl0 == "":
        print "GEN ERROR: missing visibility templates"
        return
    val absent_tmpl = absent_tmpl0.trim_end()
    val vis = expand(vis_tmpl,
        ["@@VISIBILITY_THEOREMS@@", "@@ABSENT_THEOREMS@@"],
        [gen_visibility_theorems(fields), gen_absent_theorems(excluded, absent_tmpl)])

    # ---- Golden.lean --------------------------------------------------------
    val golden_tmpl = rt_file_read_text(TMPL_DIR + "/golden.lean.tmpl")
    val gd_tmpl0 = rt_file_read_text(TMPL_DIR + "/golden_def.tmpl")
    if golden_tmpl == "" or gd_tmpl0 == "":
        print "GEN ERROR: missing golden templates"
        return
    val gd_tmpl = gd_tmpl0.trim_end()

    var defs = ""
    var d1 = gd_tmpl.replace("@NAME@", "goldenV1Sentinel")
    d1 = d1.replace("@ASSIGNS@", golden_assigns(gv1))
    var d2 = gd_tmpl.replace("@NAME@", "goldenV2Reordered")
    d2 = d2.replace("@ASSIGNS@", golden_assigns(gv2))
    var d3 = gd_tmpl.replace("@NAME@", "goldenV2Full")
    d3 = d3.replace("@ASSIGNS@", golden_assigns(gv3))
    defs = d1 + "\n" + d2 + "\n" + d3 + "\n"

    var ths = ""
    ths = ths + "set_option maxRecDepth 100000 in\n"
    ths = ths + "theorem golden_vector_1 : wire goldenV1Sentinel =\n    \"" + w1 + "\" := by decide\n\n"
    ths = ths + "set_option maxRecDepth 100000 in\n"
    ths = ths + "theorem golden_vector_2 : wire goldenV2Full =\n    \"" + w3 + "\" := by decide\n"
    val golden = expand(golden_tmpl,
        ["@@GOLDEN_DEFS@@", "@@GOLDEN_THEOREMS@@"],
        [defs, ths])

    # ---- golden_vectors.sdn -------------------------------------------------
    var sdn = "# GENERATED by src/app/gen_cache_model/main.spl — cross-language golden vectors\n"
    sdn = sdn + "golden_vectors:\n"
    sdn = sdn + "  schema_version: 2\n"
    sdn = sdn + "  sentinel_digest: {sentinel}\n"
    sdn = sdn + "  vectors:\n"
    sdn = sdn + "    - name: goldenV1Sentinel\n"
    sdn = sdn + "      wire: {w1}\n"
    sdn = sdn + "      sha256: {sha256_text(w1)}\n"
    sdn = sdn + "    - name: goldenV2Reordered\n"
    sdn = sdn + "      note: same set content as goldenV1Sentinel, reordered; wire must be identical\n"
    sdn = sdn + "      wire: {w2}\n"
    sdn = sdn + "      sha256: {sha256_text(w2)}\n"
    sdn = sdn + "    - name: goldenV2Full\n"
    sdn = sdn + "      wire: {w3}\n"
    sdn = sdn + "      sha256: {sha256_text(w3)}\n"

    # ---- write --------------------------------------------------------------
    if not file_write(OUT_DIR + "/src/CacheProtocol/Generated/Model.lean", model):
        print "GEN ERROR: write Model.lean failed"
        return
    if not file_write(OUT_DIR + "/src/CacheProtocol/Generated/Visibility.lean", vis):
        print "GEN ERROR: write Visibility.lean failed"
        return
    if not file_write(OUT_DIR + "/src/CacheProtocol/Generated/Golden.lean", golden):
        print "GEN ERROR: write Golden.lean failed"
        return
    if not file_write(OUT_DIR + "/golden/golden_vectors.sdn", sdn):
        print "GEN ERROR: write golden_vectors.sdn failed"
        return

    print "generated: 20 key fields + domain, {excluded.len()} excluded, {rk_values.len()} result kinds"
    print "GEN OK"

main()
