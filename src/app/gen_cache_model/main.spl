# gen_cache_model — C6 generator: cache_protocol.sdn -> shared cache model.
#
# Reads the frozen schema (schema_version 2) and emits:
#   1. src/verification/cache_protocol/src/CacheProtocol/Generated/Model.lean
#        Lean structures + canonical model + injectivity core
#   2. src/verification/cache_protocol/src/CacheProtocol/Generated/FieldTheorems.lean
#        one field-visibility theorem per canonical_order entry (+ domain),
#        one field-absence theorem per excluded_from_key entry
#   3. src/verification/cache_protocol/src/CacheProtocol/Generated/Golden.lean
#        cross-language golden vectors: expected byte strings computed HERE by
#        the Simple-side canonical encoder; Lean re-derives them at lake build
#   4. src/app/gen_cache_model/generated/action_key_v2.spl
#        Simple v2 struct + canonical encoder (byte format = action_key.spl)
#   5. src/app/gen_cache_model/generated/golden_vectors.txt
#        the same vectors, for the shell-side comparison in
#        scripts/check/check-cache-protocol-formal.shs
#
# Regeneration may overwrite Generated/* and generated/*; it must NEVER touch
# src/verification/cache_protocol/src/CacheProtocol/Theorems/*.
#
# Usage:
#   bin/simple run src/app/gen_cache_model/main.spl [--omit-field <name>]
# --omit-field deliberately drops one canonical field from the generated
# theorem set; the coverage gate MUST then fail (that is its self-test).

use std.common.base_encoding.utilities.{text_to_bytes}

extern fn rt_cli_get_args() -> [text]
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_write_text(path: text, content: text) -> bool

val SCHEMA_PATH = "src/compiler/80.driver/cache/schema/cache_protocol.sdn"
val LEAN_GEN_DIR = "src/verification/cache_protocol/src/CacheProtocol/Generated"
val SPL_GEN_DIR = "src/app/gen_cache_model/generated"

struct SchemaField:
    pos: i64
    name: text
    tag: text
    ftype: text

struct ExcludedField:
    name: text
    klass: text

# ---------------------------------------------------------------------------
# Schema parsing (line-based; the canonical_order entries are one per line)
# ---------------------------------------------------------------------------

fn extract_value(line: text, key: text) -> text:
    # find "key:" then take token up to ',' or '}'
    val marker = key + ":"
    val idx = line.index_of(marker)
    if idx < 0:
        return ""
    var rest = line.substring(idx + marker.len(), line.len())
    rest = rest.trim()
    var out = ""
    var depth = 0
    for ch in rest.chars():
        if ch == "<":
            depth = depth + 1
        if ch == ">":
            depth = depth - 1
        if depth == 0 and (ch == "," or ch == "}"):
            break
        out = out + ch
    out.trim()

fn parse_schema(content: text) -> ([SchemaField], [ExcludedField]):
    var fields: [SchemaField] = []
    var excluded: [ExcludedField] = []
    var in_canon = false
    var in_excl = false
    for line in content.split("\n"):
        val t = line.trim()
        if t.starts_with("canonical_order:"):
            in_canon = true
            in_excl = false
            continue
        if t.starts_with("excluded_from_key:"):
            in_excl = true
            in_canon = false
            continue
        if in_canon:
            if t.starts_with("- {"):
                val pos_s = extract_value(t, "pos")
                val f = SchemaField(
                    pos: pos_s.to_i64(),
                    name: extract_value(t, "name"),
                    tag: extract_value(t, "tag"),
                    ftype: extract_value(t, "type"))
                fields.push(f)
            else:
                if not t.starts_with("#") and t != "":
                    in_canon = false
        if in_excl:
            if t.starts_with("- {"):
                excluded.push(ExcludedField(
                    name: extract_value(t, "name"),
                    klass: extract_value(t, "class")))
            else:
                if not t.starts_with("#") and t != "":
                    in_excl = false
    (fields, excluded)

# ---------------------------------------------------------------------------
# Type maps
# ---------------------------------------------------------------------------

fn lean_type_of(ftype: text) -> text:
    if ftype == "digest":
        return "Sha"
    if ftype == "u32":
        return "Nat"
    if ftype == "text":
        return "String"
    if ftype == "set<text>":
        return "List String"
    if ftype == "set<digest>":
        return "List Sha"
    if ftype == "set<dep>":
        return "List Dep"
    if ftype == "result_kind":
        return "ResultKind"
    "String"

fn spl_type_of(ftype: text) -> text:
    if ftype == "u32":
        return "i64"
    if ftype == "set<text>" or ftype == "set<digest>":
        return "[text]"
    if ftype == "set<dep>":
        return "[ActionDep]"
    if ftype == "result_kind":
        return "text"
    "text"

# nat-typed excluded fields (schema carries no types for excluded entries)
fn excluded_lean_type(name: text) -> text:
    val nats = ["pull_request_number", "timestamp", "watcher_generation",
                "runtime_activation_generation", "jit_address",
                "loader_generation", "last_access_time", "access_count",
                "unique_retained_bytes", "recomputation_cost_ms",
                "artifact_size_bytes", "ttl_deadline", "refcount_approx",
                "block_id"]
    for n in nats:
        if n == name:
            return "Nat"
    if name == "worktree_dirty":
        return "Bool"
    "String"

fn join_lines(lines: [text]) -> text:
    var out = ""
    for l in lines:
        out = out + l + "\n"
    out

# ---------------------------------------------------------------------------
# Canonical byte encoder (mirror of action_key.spl canon_* — same framing).
# Used ONLY to compute the golden-vector expected strings.
# ---------------------------------------------------------------------------

fn canon_str(s: text) -> text:
    "S" + "{s.len()}" + ":" + s

fn canon_nat(n: i64) -> text:
    "N" + "{n}" + ";"

fn canon_field(tag: text, encoded_value: text) -> text:
    "F" + "{tag.len()}" + ":" + tag + encoded_value

fn canon_seq(items: [text]) -> text:
    var body = ""
    for item in items:
        body = body + item
    "Q" + "{items.len()}" + ":" + body

fn text_lt(a: text, b: text) -> bool:
    val ab = text_to_bytes(a)
    val bb = text_to_bytes(b)
    var i = 0
    while i < ab.len() and i < bb.len():
        val ca = ab[i] as i64
        val cb = bb[i] as i64
        if ca < cb:
            return true
        if ca > cb:
            return false
        i = i + 1
    ab.len() < bb.len()

fn sort_texts(items: [text]) -> [text]:
    var out: [text] = []
    for item in items:
        var placed = false
        var next: [text] = []
        for s in out:
            if not placed and (text_lt(item, s) or item == s):
                next.push(item)
                placed = true
            next.push(s)
        if not placed:
            next.push(item)
        out = next
    out

struct GoldenDep:
    module_id: text
    iface_digest: text

fn canon_dep(d: GoldenDep) -> text:
    var items: [text] = []
    items.push(canon_field("moduleId", canon_str(d.module_id)))
    items.push(canon_field("ifaceDigest", canon_str(d.iface_digest)))
    canon_seq(items)

fn sort_deps(items: [GoldenDep]) -> [GoldenDep]:
    var out: [GoldenDep] = []
    for item in items:
        var placed = false
        var next: [GoldenDep] = []
        for d in out:
            var le = false
            if text_lt(item.module_id, d.module_id):
                le = true
            if item.module_id == d.module_id:
                if text_lt(item.iface_digest, d.iface_digest) or item.iface_digest == d.iface_digest:
                    le = true
            if not placed and le:
                next.push(item)
                placed = true
            next.push(d)
        if not placed:
            next.push(item)
        out = next
    out

# One golden vector key: all 21 fields, scalar fields as texts.
struct GoldenKey:
    domain: text
    compiler_exe: text
    live_compiler_src: text
    schema_version: i64
    target_triple: text
    host_arch: text
    cfg_features: [text]
    stdlib_variant: text
    runtime_family: text
    source_content: text
    resolution_witness: text
    deps: [GoldenDep]
    macro_root: text
    aop_selection: text
    ct_env_inputs: [text]
    schema_digest: text
    aop_surface_root: text
    aop_candidate_partition_roots: [text]
    aop_weave_root: text
    block_manifest_roots: [text]
    result_kind: text

fn golden_encode(k: GoldenKey) -> text:
    var cfg_items: [text] = []
    for c in sort_texts(k.cfg_features):
        cfg_items.push(canon_str(c))
    var env_items: [text] = []
    for e in sort_texts(k.ct_env_inputs):
        env_items.push(canon_str(e))
    var dep_items: [text] = []
    for d in sort_deps(k.deps):
        dep_items.push(canon_dep(d))
    var root_items: [text] = []
    for r in sort_texts(k.aop_candidate_partition_roots):
        root_items.push(canon_str(r))
    var block_items: [text] = []
    for b in sort_texts(k.block_manifest_roots):
        block_items.push(canon_str(b))

    var inner: [text] = []
    inner.push(canon_field("compilerExe", canon_str(k.compiler_exe)))
    inner.push(canon_field("liveCompilerSrc", canon_str(k.live_compiler_src)))
    inner.push(canon_field("schemaVersion", canon_nat(k.schema_version)))
    inner.push(canon_field("targetTriple", canon_str(k.target_triple)))
    inner.push(canon_field("hostArch", canon_str(k.host_arch)))
    inner.push(canon_field("cfgFeatures", canon_seq(cfg_items)))
    inner.push(canon_field("stdlibVariant", canon_str(k.stdlib_variant)))
    inner.push(canon_field("runtimeFamily", canon_str(k.runtime_family)))
    inner.push(canon_field("sourceContent", canon_str(k.source_content)))
    inner.push(canon_field("resolutionWitness", canon_str(k.resolution_witness)))
    inner.push(canon_field("deps", canon_seq(dep_items)))
    inner.push(canon_field("macroRoot", canon_str(k.macro_root)))
    inner.push(canon_field("aopSelection", canon_str(k.aop_selection)))
    inner.push(canon_field("ctEnvInputs", canon_seq(env_items)))
    inner.push(canon_field("schemaDigest", canon_str(k.schema_digest)))
    inner.push(canon_field("aopSurfaceRoot", canon_str(k.aop_surface_root)))
    inner.push(canon_field("aopCandidatePartitionRoots", canon_seq(root_items)))
    inner.push(canon_field("aopWeaveRoot", canon_str(k.aop_weave_root)))
    inner.push(canon_field("blockManifestRoots", canon_seq(block_items)))
    inner.push(canon_field("resultKind", canon_str(k.result_kind)))
    canon_field(k.domain, canon_seq(inner))

fn golden_vectors() -> [GoldenKey]:
    var out: [GoldenKey] = []
    # vector 1: plain, empty sets, sentinel-suffix era
    out.push(GoldenKey(
        domain: "simple/interpreter-module/v2",
        compiler_exe: "ce1", live_compiler_src: "lcs1", schema_version: 2,
        target_triple: "x86_64-unknown-linux-gnu", host_arch: "x86_64",
        cfg_features: [], stdlib_variant: "nogc_async", runtime_family: "nogc",
        source_content: "sc1", resolution_witness: "rw1", deps: [],
        macro_root: "mr1", aop_selection: "aop1", ct_env_inputs: [],
        schema_digest: "sent", aop_surface_root: "sent",
        aop_candidate_partition_roots: [], aop_weave_root: "sent",
        block_manifest_roots: [], result_kind: "interpreter_module"))
    # vector 2: unsorted sets everywhere — encoder must sort
    out.push(GoldenKey(
        domain: "simple/interpreter-module/v2",
        compiler_exe: "ce2", live_compiler_src: "lcs2", schema_version: 2,
        target_triple: "aarch64-unknown-linux-gnu", host_arch: "aarch64",
        cfg_features: ["zeta", "alpha"], stdlib_variant: "common",
        runtime_family: "gc",
        source_content: "sc2", resolution_witness: "rw2",
        deps: [GoldenDep(module_id: "m2", iface_digest: "i2"),
               GoldenDep(module_id: "m1", iface_digest: "i1")],
        macro_root: "mr2", aop_selection: "aop2",
        ct_env_inputs: ["B=2", "A=1"],
        schema_digest: "sd2", aop_surface_root: "asr2",
        aop_candidate_partition_roots: ["p2", "p1"], aop_weave_root: "awr2",
        block_manifest_roots: ["b2", "b1"], result_kind: "mir_module"))
    # vector 3: framing hazard — values that look like tags/frames
    out.push(GoldenKey(
        domain: "simple/interpreter-module/v2",
        compiler_exe: "F3:abc", live_compiler_src: "Q0:", schema_version: 0,
        target_triple: "S1:x", host_arch: "N7;",
        cfg_features: ["Q1:"], stdlib_variant: "", runtime_family: "",
        source_content: "", resolution_witness: "",
        deps: [GoldenDep(module_id: "", iface_digest: "")],
        macro_root: "", aop_selection: "", ct_env_inputs: [],
        schema_digest: "", aop_surface_root: "",
        aop_candidate_partition_roots: [], aop_weave_root: "",
        block_manifest_roots: [], result_kind: "link_product"))
    out

# ---------------------------------------------------------------------------
# Lean emit helpers
# ---------------------------------------------------------------------------

fn encode_line(tag: text, ftype: text) -> text:
    if ftype == "digest" or ftype == "text":
        return "    Canon.pair (.tag \"{tag}\" (.str k.{tag})) <|"
    if ftype == "u32":
        return "    Canon.pair (.tag \"{tag}\" (.nat k.{tag})) <|"
    if ftype == "set<text>" or ftype == "set<digest>":
        return "    Canon.pair (.tag \"{tag}\" (.strs (sortStrs k.{tag}))) <|"
    if ftype == "set<dep>":
        return "    Canon.pair (.tag \"{tag}\" (.deps (sortDeps k.{tag}))) <|"
    if ftype == "result_kind":
        return "    Canon.pair (.tag \"{tag}\" (.str k.{tag}.name)) <|"
    "    -- UNSUPPORTED TYPE {ftype}"

fn canon_assign(tag: text, ftype: text) -> text:
    if ftype == "set<text>" or ftype == "set<digest>":
        return "  , {tag} := sortStrs k.{tag}"
    if ftype == "set<dep>":
        return "  , {tag} := sortDeps k.{tag}"
    "  , {tag} := k.{tag}"

fn item_line(tag: text, ftype: text) -> text:
    if ftype == "digest" or ftype == "text":
        return "  , canonField \"{tag}\" (canonStr k.{tag})"
    if ftype == "u32":
        return "  , canonField \"{tag}\" (canonNat k.{tag})"
    if ftype == "set<text>" or ftype == "set<digest>":
        return "  , canonField \"{tag}\" (canonSeq ((sortStrs k.{tag}).map canonStr))"
    if ftype == "set<dep>":
        return "  , canonField \"{tag}\" (canonSeq ((sortDeps k.{tag}).map canonDep))"
    if ftype == "result_kind":
        return "  , canonField \"{tag}\" (canonStr k.{tag}.name)"
    "  -- UNSUPPORTED TYPE {ftype}"

fn hname(i: i64) -> text:
    "h{i}"

fn emit_model(fields: [SchemaField]) -> text:
    var l: [text] = []
    l.push("/-")
    l.push("  CacheProtocol.Generated.Model — GENERATED FILE. Do not edit by hand.")
    l.push("  Generated by src/app/gen_cache_model/main.spl from")
    l.push("  src/compiler/80.driver/cache/schema/cache_protocol.sdn (schema_version 2).")
    l.push("  Regeneration may overwrite Generated/*; it must never touch Theorems/*.")
    l.push("")
    l.push("  Assumptions stated, not proved: sha256 collision resistance (digest")
    l.push("  collision is treated as encode-equality); injectivity of the byte-level")
    l.push("  length-prefixed framing (proven injectivity is at the Canon term level;")
    l.push("  cross-language agreement is pinned by Generated/Golden.lean vectors).")
    l.push("  All proofs in this file are complete — no sorry, no admit, no axioms.")
    l.push("-/")
    l.push("namespace CacheProtocol")
    l.push("")
    l.push("abbrev Sha := String")
    l.push("")
    l.push("structure Dep where")
    l.push("  moduleId    : String")
    l.push("  ifaceDigest : Sha")
    l.push("  deriving DecidableEq, Repr")
    l.push("")
    l.push("/-- result_kind enum — encoded by NAME, never by ordinal. -/")
    l.push("inductive ResultKind where")
    l.push("  | interpreterModule | mirModule | objectFile | interfaceSummary")
    l.push("  | diagnostics | aopWeaveArtifact | adviceArtifact | aspectPack")
    l.push("  | blockTransferResult | functionSummary | linkProduct")
    l.push("  deriving DecidableEq, Repr")
    l.push("")
    l.push("def ResultKind.name : ResultKind → String")
    l.push("  | .interpreterModule   => \"interpreter_module\"")
    l.push("  | .mirModule           => \"mir_module\"")
    l.push("  | .objectFile          => \"object_file\"")
    l.push("  | .interfaceSummary    => \"interface_summary\"")
    l.push("  | .diagnostics         => \"diagnostics\"")
    l.push("  | .aopWeaveArtifact    => \"aop_weave_artifact\"")
    l.push("  | .adviceArtifact      => \"advice_artifact\"")
    l.push("  | .aspectPack          => \"aspect_pack\"")
    l.push("  | .blockTransferResult => \"block_transfer_result\"")
    l.push("  | .functionSummary     => \"function_summary\"")
    l.push("  | .linkProduct         => \"link_product\"")
    l.push("")
    l.push("theorem ResultKind.name_inj : ∀ a b : ResultKind, name a = name b → a = b := by")
    l.push("  intro a b h")
    l.push("  cases a <;> cases b <;> first | rfl | simp [name] at h")
    l.push("")
    l.push("/-- The 21-field v2 ActionKey (schema canonical_order; domain is pos 0). -/")
    l.push("structure ActionKey where")
    l.push("  domain : String")
    for f in fields:
        l.push("  {f.tag} : {lean_type_of(f.ftype)}")
    l.push("  deriving DecidableEq, Repr")
    l.push("")
    l.push("inductive Canon where")
    l.push("  | str  : String → Canon")
    l.push("  | nat  : Nat → Canon")
    l.push("  | tag  : String → Canon → Canon")
    l.push("  | pair : Canon → Canon → Canon")
    l.push("  | strs : List String → Canon")
    l.push("  | deps : List Dep → Canon")
    l.push("  deriving DecidableEq, Repr")
    l.push("")
    l.push("def depLe (a b : Dep) : Bool :=")
    l.push("  decide (a.moduleId < b.moduleId) ||")
    l.push("  (a.moduleId == b.moduleId &&")
    l.push("    (decide (a.ifaceDigest < b.ifaceDigest) || a.ifaceDigest == b.ifaceDigest))")
    l.push("")
    l.push("def insDep (a : Dep) : List Dep → List Dep")
    l.push("  | []      => [a]")
    l.push("  | b :: bs => if depLe a b then a :: b :: bs else b :: insDep a bs")
    l.push("")
    l.push("def sortDeps : List Dep → List Dep")
    l.push("  | []       => []")
    l.push("  | a :: as' => insDep a (sortDeps as')")
    l.push("")
    l.push("def strLe (a b : String) : Bool := decide (a < b) || a == b")
    l.push("")
    l.push("def insStr (a : String) : List String → List String")
    l.push("  | []      => [a]")
    l.push("  | b :: bs => if strLe a b then a :: b :: bs else b :: insStr a bs")
    l.push("")
    l.push("def sortStrs : List String → List String")
    l.push("  | []       => []")
    l.push("  | a :: as' => insStr a (sortStrs as')")
    l.push("")
    l.push("/-- Canonical key: every set-typed field normalised. -/")
    l.push("structure CanonKey where")
    l.push("  domain : String")
    for f in fields:
        l.push("  {f.tag} : {lean_type_of(f.ftype)}")
    l.push("  deriving DecidableEq, Repr")
    l.push("")
    l.push("def canonKey (k : ActionKey) : CanonKey :=")
    l.push("  {{ domain := k.domain")
    for f in fields:
        l.push(canon_assign(f.tag, f.ftype))
    l.push("  }}")
    l.push("")
    l.push("/-- The v2 canonical encoder: every schema field exactly once, tagged,")
    l.push("    in canonical_order; set fields sorted; result_kind by name. -/")
    l.push("def encode (k : ActionKey) : Canon :=")
    l.push("  Canon.tag k.domain <|")
    var i = 0
    for f in fields:
        if i == fields.len() - 1:
            # last field: terminal tag, no pair
            if f.ftype == "result_kind":
                l.push("    Canon.tag \"{f.tag}\" (.str k.{f.tag}.name)")
            else:
                l.push("    Canon.tag \"{f.tag}\" (.str k.{f.tag})")
        else:
            l.push(encode_line(f.tag, f.ftype))
        i = i + 1
    l.push("")
    l.push("theorem encode_determines_canon (k1 k2 : ActionKey)")
    l.push("    (h : encode k1 = encode k2) : canonKey k1 = canonKey k2 := by")
    l.push("  simp only [encode, Canon.tag.injEq, Canon.pair.injEq, Canon.str.injEq,")
    l.push("             Canon.nat.injEq, Canon.strs.injEq, Canon.deps.injEq,")
    l.push("             true_and] at h")
    var obtain = "  obtain ⟨hd"
    i = 0
    for f in fields:
        obtain = obtain + ", " + hname(f.pos)
        i = i + 1
    obtain = obtain + "⟩ := h"
    l.push(obtain)
    # result_kind is the last field; its hypothesis is over names
    val last = fields[fields.len() - 1]
    var rkfix = ""
    if last.ftype == "result_kind":
        l.push("  have hrk : k1.{last.tag} = k2.{last.tag} :=")
        l.push("    ResultKind.name_inj _ _ {hname(last.pos)}")
        rkfix = "hrk"
    var closing = "  simp only [canonKey, hd"
    for f in fields:
        if f.ftype == "result_kind":
            closing = closing + ", " + rkfix
        else:
            closing = closing + ", " + hname(f.pos)
    closing = closing + "]"
    l.push(closing)
    l.push("")
    l.push("theorem canon_determines_encode (k1 k2 : ActionKey)")
    l.push("    (h : canonKey k1 = canonKey k2) : encode k1 = encode k2 := by")
    l.push("  have hd : k1.domain = k2.domain := congrArg CanonKey.domain h")
    for f in fields:
        if f.ftype == "set<text>" or f.ftype == "set<digest>":
            l.push("  have {hname(f.pos)} : sortStrs k1.{f.tag} = sortStrs k2.{f.tag} := congrArg CanonKey.{f.tag} h")
        elif f.ftype == "set<dep>":
            l.push("  have {hname(f.pos)} : sortDeps k1.{f.tag} = sortDeps k2.{f.tag} := congrArg CanonKey.{f.tag} h")
        else:
            l.push("  have {hname(f.pos)} : k1.{f.tag} = k2.{f.tag} := congrArg CanonKey.{f.tag} h")
    var fin = "  simp only [encode, hd"
    for f in fields:
        fin = fin + ", " + hname(f.pos)
    fin = fin + "]"
    l.push(fin)
    l.push("")
    l.push("theorem encode_eq_iff_canon (k1 k2 : ActionKey) :")
    l.push("    encode k1 = encode k2 ↔ canonKey k1 = canonKey k2 :=")
    l.push("  ⟨encode_determines_canon k1 k2, canon_determines_encode k1 k2⟩")
    l.push("")
    l.push("-- Byte-level rendering — mirrors action_key.spl canon_* framing exactly.")
    l.push("def canonStr (s : String) : String := \"S\" ++ toString s.length ++ \":\" ++ s")
    l.push("def canonNat (n : Nat) : String := \"N\" ++ toString n ++ \";\"")
    l.push("def canonField (tag v : String) : String := \"F\" ++ toString tag.length ++ \":\" ++ tag ++ v")
    l.push("def canonSeq (items : List String) : String :=")
    l.push("  \"Q\" ++ toString items.length ++ \":\" ++ String.join items")
    l.push("def canonDep (d : Dep) : String :=")
    l.push("  canonSeq [canonField \"moduleId\" (canonStr d.moduleId),")
    l.push("            canonField \"ifaceDigest\" (canonStr d.ifaceDigest)]")
    l.push("")
    l.push("/-- The v1 inner field items (positions 1..14), byte-identical to")
    l.push("    action_key.spl's `inner` list. -/")
    l.push("def innerItemsV1 (k : ActionKey) : List String :=")
    var first = true
    for f in fields:
        if f.pos <= 14:
            var line = item_line(f.tag, f.ftype)
            if first:
                line = "  [" + line.substring(4, line.len())
                first = false
            l.push(line)
    l.push("  ]")
    l.push("")
    l.push("/-- All v2 inner field items (positions 1..20). -/")
    l.push("def innerItems (k : ActionKey) : List String :=")
    l.push("  innerItemsV1 k ++")
    first = true
    for f in fields:
        if f.pos >= 15:
            var line2 = item_line(f.tag, f.ftype)
            if first:
                line2 = "  [" + line2.substring(4, line2.len())
                first = false
            l.push(line2)
    l.push("  ]")
    l.push("")
    l.push("/-- Byte-level v2 encoding: field(domain, seq(inner 1..20)). -/")
    l.push("def encodeString (k : ActionKey) : String :=")
    l.push("  canonField k.domain (canonSeq (innerItems k))")
    l.push("")
    l.push("/-- PREFIX FREEZE, byte level: the first 14 inner items of the v2 encoding")
    l.push("    are exactly the v1 inner items. -/")
    l.push("theorem innerItems_take_14_is_v1 (k : ActionKey) :")
    l.push("    (innerItems k).take 14 = innerItemsV1 k := rfl")
    l.push("")
    l.push("structure Entry where")
    l.push("  key      : ActionKey")
    l.push("  artifact : Nat")
    l.push("  deriving Repr")
    l.push("")
    l.push("def WellFormed (realize : CanonKey → Nat) (tbl : List Entry) : Prop :=")
    l.push("  ∀ e ∈ tbl, e.artifact = realize (canonKey e.key)")
    l.push("")
    l.push("def lookup (tbl : List Entry) (k : ActionKey) : Option Nat :=")
    l.push("  (tbl.find? (fun e => decide (encode e.key = encode k))).map (·.artifact)")
    l.push("")
    l.push("end CacheProtocol")
    join_lines(l)

fn visibility_hyp(tag: text, ftype: text) -> text:
    if ftype == "set<text>" or ftype == "set<digest>":
        return "sortStrs k1.{tag} ≠ sortStrs k2.{tag}"
    if ftype == "set<dep>":
        return "sortDeps k1.{tag} ≠ sortDeps k2.{tag}"
    "k1.{tag} ≠ k2.{tag}"

fn emit_field_theorems(fields: [SchemaField], excluded: [ExcludedField], omit: text) -> text:
    var l: [text] = []
    l.push("/-")
    l.push("  CacheProtocol.Generated.FieldTheorems — GENERATED FILE. Do not edit.")
    l.push("  Generated by src/app/gen_cache_model/main.spl from cache_protocol.sdn.")
    l.push("  One `<name>_change_visible` per canonical_order entry (+ domain), one")
    l.push("  `<name>_absent` per excluded_from_key entry. The coverage gate")
    l.push("  (scripts/check/check-cache-protocol-formal.shs) matches these names")
    l.push("  against the schema. All proofs complete — no sorry, no axioms.")
    l.push("-/")
    l.push("import CacheProtocol.Generated.Model")
    l.push("")
    l.push("namespace CacheProtocol")
    l.push("")
    l.push("private theorem field_change_visible {{α}} (proj : CanonKey → α) (k1 k2 : ActionKey)")
    l.push("    (h : proj (canonKey k1) ≠ proj (canonKey k2)) : encode k1 ≠ encode k2 := by")
    l.push("  intro he")
    l.push("  exact h (congrArg proj (encode_determines_canon k1 k2 he))")
    l.push("")
    l.push("-- pos 0")
    l.push("theorem domain_change_visible (k1 k2 : ActionKey)")
    l.push("    (h : k1.domain ≠ k2.domain) : encode k1 ≠ encode k2 :=")
    l.push("  field_change_visible CanonKey.domain k1 k2 h")
    for f in fields:
        if f.name == omit:
            l.push("")
            l.push("-- pos {f.pos} ({f.name}) DELIBERATELY OMITTED via --omit-field")
            continue
        l.push("")
        l.push("-- pos {f.pos}")
        l.push("theorem {f.name}_change_visible (k1 k2 : ActionKey)")
        l.push("    (h : {visibility_hyp(f.tag, f.ftype)}) : encode k1 ≠ encode k2 :=")
        l.push("  field_change_visible CanonKey.{f.tag} k1 k2 h")
    l.push("")
    l.push("-- excluded_from_key — negative (field-absent) theorems. The build env")
    l.push("-- carries every excluded field beside the key; the encoder reads ONLY")
    l.push("-- the key, so changing any excluded field is invisible to identity.")
    l.push("structure BuildEnv where")
    l.push("  key : ActionKey")
    for x in excluded:
        l.push("  {x.name} : {excluded_lean_type(x.name)}  -- {x.klass}")
    l.push("  block_id : Nat  -- mir::BlockId, LOCAL_STATE (freeze §2, forbidden identity source)")
    l.push("  deriving Repr")
    l.push("")
    l.push("/-- The identity of a build is the encoding of its key — nothing else. -/")
    l.push("def encodeEnv (e : BuildEnv) : Canon := encode e.key")
    for x in excluded:
        l.push("")
        l.push("theorem {x.name}_absent (e : BuildEnv) (v : {excluded_lean_type(x.name)}) :")
        l.push("    encodeEnv {{ e with {x.name} := v }} = encodeEnv e := rfl")
    l.push("")
    l.push("theorem block_id_absent (e : BuildEnv) (v : Nat) :")
    l.push("    encodeEnv {{ e with block_id := v }} = encodeEnv e := rfl")
    l.push("")
    l.push("end CacheProtocol")
    join_lines(l)

fn lean_str_lit(s: text) -> text:
    var out = "\""
    for ch in s.chars():
        if ch == "\"":
            out = out + "\\\""
        elif ch == "\\":
            out = out + "\\\\"
        else:
            out = out + ch
    out + "\""

fn lean_rk(rk: text) -> text:
    if rk == "interpreter_module":
        return ".interpreterModule"
    if rk == "mir_module":
        return ".mirModule"
    if rk == "object_file":
        return ".objectFile"
    if rk == "link_product":
        return ".linkProduct"
    ".interpreterModule"

fn lean_list(items: [text]) -> text:
    var out = "["
    var first = true
    for it in items:
        if not first:
            out = out + ", "
        out = out + lean_str_lit(it)
        first = false
    out + "]"

fn lean_deps(ds: [GoldenDep]) -> text:
    var out = "["
    var first = true
    for d in ds:
        if not first:
            out = out + ", "
        out = out + "Dep.mk " + lean_str_lit(d.module_id) + " " + lean_str_lit(d.iface_digest)
        first = false
    out + "]"

fn emit_golden(vectors: [GoldenKey]) -> text:
    var l: [text] = []
    l.push("/-")
    l.push("  CacheProtocol.Generated.Golden — GENERATED FILE. Do not edit.")
    l.push("  Cross-language golden vectors: the expected strings below were computed")
    l.push("  by the SIMPLE-side canonical encoder (src/app/gen_cache_model/main.spl,")
    l.push("  mirroring action_key.spl's canon_* framing). `lake build` re-derives")
    l.push("  each via the Lean encoder and proves byte equality — this file IS the")
    l.push("  correspondence check between the two implementations.")
    l.push("-/")
    l.push("import CacheProtocol.Generated.Model")
    l.push("")
    l.push("namespace CacheProtocol")
    var i = 1
    for k in vectors:
        val expected = golden_encode(k)
        l.push("")
        l.push("def gv{i} : ActionKey :=")
        l.push("  {{ domain := {lean_str_lit(k.domain)}")
        l.push("  , compilerExe := {lean_str_lit(k.compiler_exe)}")
        l.push("  , liveCompilerSrc := {lean_str_lit(k.live_compiler_src)}")
        l.push("  , schemaVersion := {k.schema_version}")
        l.push("  , targetTriple := {lean_str_lit(k.target_triple)}")
        l.push("  , hostArch := {lean_str_lit(k.host_arch)}")
        l.push("  , cfgFeatures := {lean_list(k.cfg_features)}")
        l.push("  , stdlibVariant := {lean_str_lit(k.stdlib_variant)}")
        l.push("  , runtimeFamily := {lean_str_lit(k.runtime_family)}")
        l.push("  , sourceContent := {lean_str_lit(k.source_content)}")
        l.push("  , resolutionWitness := {lean_str_lit(k.resolution_witness)}")
        l.push("  , deps := {lean_deps(k.deps)}")
        l.push("  , macroRoot := {lean_str_lit(k.macro_root)}")
        l.push("  , aopSelection := {lean_str_lit(k.aop_selection)}")
        l.push("  , ctEnvInputs := {lean_list(k.ct_env_inputs)}")
        l.push("  , schemaDigest := {lean_str_lit(k.schema_digest)}")
        l.push("  , aopSurfaceRoot := {lean_str_lit(k.aop_surface_root)}")
        l.push("  , aopCandidatePartitionRoots := {lean_list(k.aop_candidate_partition_roots)}")
        l.push("  , aopWeaveRoot := {lean_str_lit(k.aop_weave_root)}")
        l.push("  , blockManifestRoots := {lean_list(k.block_manifest_roots)}")
        l.push("  , resultKind := {lean_rk(k.result_kind)} }}")
        l.push("")
        l.push("-- Simple-side encoder produced this exact byte string.")
        l.push("set_option maxRecDepth 100000 in")
        l.push("theorem golden_vector_{i} :")
        l.push("    encodeString gv{i} = {lean_str_lit(expected)} := by")
        l.push("  decide")
        i = i + 1
    l.push("")
    l.push("end CacheProtocol")
    join_lines(l)

fn emit_spl(fields: [SchemaField]) -> text:
    var l: [text] = []
    l.push("# GENERATED FILE — do not edit. Emitted by src/app/gen_cache_model/main.spl")
    l.push("# from src/compiler/80.driver/cache/schema/cache_protocol.sdn (v2).")
    l.push("#")
    l.push("# v2 ActionKey struct + canonical encoder. Byte framing is IDENTICAL to")
    l.push("# src/compiler/80.driver/cache/action_key.spl (canon_str/nat/field/seq);")
    l.push("# the v1 canon_* helpers there are the reusable originals (C1 owns them).")
    l.push("# This file must not be imported by the compiler until C1 wires it.")
    l.push("")
    l.push("struct ActionDepV2:")
    l.push("    module_id: text")
    l.push("    iface_digest: text")
    l.push("")
    l.push("struct ActionKeyV2:")
    l.push("    domain: text")
    for f in fields:
        var st = spl_type_of(f.ftype)
        if st == "[ActionDep]":
            st = "[ActionDepV2]"
        l.push("    {f.name}: {st}")
    l.push("")
    l.push("fn akv2_canon_str(s: text) -> text:")
    l.push("    \"S\" + \"{{s.len()}}\" + \":\" + s")
    l.push("")
    l.push("fn akv2_canon_nat(n: i64) -> text:")
    l.push("    \"N\" + \"{{n}}\" + \";\"")
    l.push("")
    l.push("fn akv2_canon_field(tag: text, v: text) -> text:")
    l.push("    \"F\" + \"{{tag.len()}}\" + \":\" + tag + v")
    l.push("")
    l.push("fn akv2_canon_seq(items: [text]) -> text:")
    l.push("    var body = \"\"")
    l.push("    for item in items:")
    l.push("        body = body + item")
    l.push("    \"Q\" + \"{{items.len()}}\" + \":\" + body")
    l.push("")
    l.push("fn akv2_text_lt(a: text, b: text) -> bool:")
    l.push("    val ab = text_to_bytes(a)")
    l.push("    val bb = text_to_bytes(b)")
    l.push("    var i = 0")
    l.push("    while i < ab.len() and i < bb.len():")
    l.push("        val ca = ab[i] as i64")
    l.push("        val cb = bb[i] as i64")
    l.push("        if ca < cb:")
    l.push("            return true")
    l.push("        if ca > cb:")
    l.push("            return false")
    l.push("        i = i + 1")
    l.push("    ab.len() < bb.len()")
    l.push("")
    l.push("fn akv2_sort_texts(items: [text]) -> [text]:")
    l.push("    var out: [text] = []")
    l.push("    for item in items:")
    l.push("        var placed = false")
    l.push("        var next: [text] = []")
    l.push("        for s in out:")
    l.push("            if not placed and (akv2_text_lt(item, s) or item == s):")
    l.push("                next.push(item)")
    l.push("                placed = true")
    l.push("            next.push(s)")
    l.push("        if not placed:")
    l.push("            next.push(item)")
    l.push("        out = next")
    l.push("    out")
    l.push("")
    l.push("fn akv2_canon_dep(d: ActionDepV2) -> text:")
    l.push("    var items: [text] = []")
    l.push("    items.push(akv2_canon_field(\"moduleId\", akv2_canon_str(d.module_id)))")
    l.push("    items.push(akv2_canon_field(\"ifaceDigest\", akv2_canon_str(d.iface_digest)))")
    l.push("    akv2_canon_seq(items)")
    l.push("")
    l.push("fn akv2_sort_deps(items: [ActionDepV2]) -> [ActionDepV2]:")
    l.push("    var out: [ActionDepV2] = []")
    l.push("    for item in items:")
    l.push("        var placed = false")
    l.push("        var next: [ActionDepV2] = []")
    l.push("        for d in out:")
    l.push("            var le = false")
    l.push("            if akv2_text_lt(item.module_id, d.module_id):")
    l.push("                le = true")
    l.push("            if item.module_id == d.module_id:")
    l.push("                if akv2_text_lt(item.iface_digest, d.iface_digest) or item.iface_digest == d.iface_digest:")
    l.push("                    le = true")
    l.push("            if not placed and le:")
    l.push("                next.push(item)")
    l.push("                placed = true")
    l.push("            next.push(d)")
    l.push("        if not placed:")
    l.push("            next.push(item)")
    l.push("        out = next")
    l.push("    out")
    l.push("")
    l.push("# Fixed sentinel for SPEC_FORWARD digest fields: sha256 of the empty")
    l.push("# canonical seq (schema v2_encoding_until_backed).")
    l.push("fn action_key_v2_sentinel() -> text:")
    l.push("    sha256_text(akv2_canon_seq([]))")
    l.push("")
    l.push("fn action_key_v2_encode(key: ActionKeyV2) -> text:")
    l.push("    var inner: [text] = []")
    for f in fields:
        if f.ftype == "digest" or f.ftype == "text" or f.ftype == "result_kind":
            l.push("    inner.push(akv2_canon_field(\"{f.tag}\", akv2_canon_str(key.{f.name})))")
        elif f.ftype == "u32":
            l.push("    inner.push(akv2_canon_field(\"{f.tag}\", akv2_canon_nat(key.{f.name})))")
        elif f.ftype == "set<dep>":
            l.push("    var dep_items_{f.pos}: [text] = []")
            l.push("    for d in akv2_sort_deps(key.{f.name}):")
            l.push("        dep_items_{f.pos}.push(akv2_canon_dep(d))")
            l.push("    inner.push(akv2_canon_field(\"{f.tag}\", akv2_canon_seq(dep_items_{f.pos})))")
        else:
            l.push("    var set_items_{f.pos}: [text] = []")
            l.push("    for s in akv2_sort_texts(key.{f.name}):")
            l.push("        set_items_{f.pos}.push(akv2_canon_str(s))")
            l.push("    inner.push(akv2_canon_field(\"{f.tag}\", akv2_canon_seq(set_items_{f.pos})))")
    l.push("    akv2_canon_field(key.domain, akv2_canon_seq(inner))")
    l.push("")
    l.push("fn action_key_v2_digest(key: ActionKeyV2) -> text:")
    l.push("    sha256_text(action_key_v2_encode(key))")
    join_lines(l)

fn emit_vectors_txt(vectors: [GoldenKey]) -> text:
    var l: [text] = []
    var i = 1
    for k in vectors:
        l.push("vector_{i} {golden_encode(k)}")
        i = i + 1
    join_lines(l)

fn main() -> Int:
    val args = rt_cli_get_args()
    var omit = ""
    var i = 0
    while i < args.len():
        if args[i] == "--omit-field" and i + 1 < args.len():
            omit = args[i + 1]
        i = i + 1

    val content = rt_file_read_text(SCHEMA_PATH)
    if content == "":
        print "ERROR — could not read {SCHEMA_PATH}"
        return 2
    val (fields, excluded) = parse_schema(content)
    if fields.len() != 20:
        print "ERROR — expected 20 canonical_order fields, parsed {fields.len()}"
        return 2
    if excluded.len() != 26:
        print "ERROR — expected 26 excluded_from_key fields, parsed {excluded.len()}"
        return 2

    val vectors = golden_vectors()

    if not rt_file_write_text("{LEAN_GEN_DIR}/Model.lean", emit_model(fields)):
        print "ERROR — write Model.lean failed"
        return 2
    if not rt_file_write_text("{LEAN_GEN_DIR}/FieldTheorems.lean", emit_field_theorems(fields, excluded, omit)):
        print "ERROR — write FieldTheorems.lean failed"
        return 2
    if not rt_file_write_text("{LEAN_GEN_DIR}/Golden.lean", emit_golden(vectors)):
        print "ERROR — write Golden.lean failed"
        return 2
    if not rt_file_write_text("{SPL_GEN_DIR}/action_key_v2.spl", emit_spl(fields)):
        print "ERROR — write action_key_v2.spl failed"
        return 2
    if not rt_file_write_text("{SPL_GEN_DIR}/golden_vectors.txt", emit_vectors_txt(vectors)):
        print "ERROR — write golden_vectors.txt failed"
        return 2

    if omit != "":
        print "generated WITH --omit-field {omit} (gate self-test mode)"
    print "PASS — generated 20 fields, {excluded.len()} excluded, {vectors.len()} golden vectors"
    0
