use std.cli.cli_util.{get_cli_args}
use app.provider_cli.entry.{provider_cli_execute_v1}

fn main() -> i64:
    val result = provider_cli_execute_v1(get_cli_args())
    if result.output != "":
        print result.output
    if result.diagnostic != "":
        print "provider-cli: " + result.diagnostic
    result.exit_code
