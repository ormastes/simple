# Recorded test-status counts, read from doc/08_tracking/test/test_result.md.
#
# One reader for every summary metric, in ONE place, so a category cannot be
# added to the report and silently missed by a surface. Both the text output
# and the v2 JSON go through this — they cannot disagree.

use std.nogc_sync_mut.io.process_ops.{process_run}
use std.nogc_sync_mut.io.file_ops.{file_exists}

struct TestStatusCounts:
    total: i64
    passed: i64
    failed: i64
    # GENUINE skips only: the host could not run it (no GPU, no QEMU,
    # wrong platform). In-development is NOT a skip and never lands here —
    # a tagged spec EXECUTES, only its verdict is neutralised.
    skipped: i64
    pending: i64
    # Tagged `@tag:in-development`, ran, failed as expected. Its own
    # category: never folded into `passed`, never folded into `skipped`,
    # never dropped from the total.
    in_development: i64
    # Tagged, ran, and PASSED. Good news that must not be silent: the test
    # is ready to be promoted by deleting the tag. Kept apart from the
    # neutralised count so "ready to promote" cannot hide inside "not
    # working yet".
    in_development_unexpected: i64
    # Tagged but could not LOAD (syntax error, unresolved import). A spec
    # defect, NOT unfinished work — the tag buys amnesty for failing
    # assertions, never for a file the loader could not read. It FAILS the
    # run and must never be absorbed into `in_development`; doing so is
    # exactly how the tag would become a place broken files go to stop
    # being counted. See `std.spec.in_development.classify_in_development`.
    in_development_broken: i64
    # Whatever the report accounts for in no named category. Surfaced rather
    # than swallowed — a silent remainder is how a category goes missing.
    unclassified: i64

val TEST_RESULT_PATH = "doc/08_tracking/test/test_result.md"

fn _run_cmd(cmd: text) -> text:
    val result = process_run("sh", ["-c", cmd])
    if result.2 == 0:
        result.0.trim()
    else:
        ""

fn test_result_metric(metric: text) -> i64:
    if not file_exists(TEST_RESULT_PATH):
        return 0
    val cmd = "grep -m1 -E '^\\| {metric} \\|' {TEST_RESULT_PATH} | grep -oE '[0-9]+' | head -1"
    _run_cmd(cmd).to_int() ?? 0

fn read_test_status_counts() -> TestStatusCounts:
    val total = test_result_metric("Total")
    val passed = test_result_metric("Passed")
    val failed = test_result_metric("Failed")
    var skipped = test_result_metric("Skipped")
    if skipped == 0:
        skipped = test_result_metric("Skipped \\(host-unavailable\\)")
    val pending = test_result_metric("Pending")
    val indev = test_result_metric("In Development")
    val indev_unexpected = test_result_metric("In Development \\(unexpected pass\\)")
    val indev_broken = test_result_metric("In Development \\(broken\\)")
    var other = test_result_metric("Other")
    if other == 0:
        # `broken` is counted inside `failed` by the runner (it FAILS the
        # run), so it is deliberately NOT added again here — double-counting
        # it would manufacture a phantom negative remainder.
        val named = passed + failed + skipped + pending + indev + indev_unexpected
        if total > named:
            other = total - named
    TestStatusCounts(
        total: total, passed: passed, failed: failed, skipped: skipped,
        pending: pending, in_development: indev,
        in_development_unexpected: indev_unexpected,
        in_development_broken: indev_broken,
        unclassified: other
    )

export TestStatusCounts, TEST_RESULT_PATH, test_result_metric, read_test_status_counts
