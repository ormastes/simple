# Deterministic JSON projection for StatsInventoryV2.

use app.stats.types (StatsInventoryV2)
use app.stats.test_status.{TestStatusCounts}

fn stats_json_escape(value: text) -> text:
    value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")

# `status` carries the recorded pass/fail/in-development counts. It is a
# parameter rather than something this projection reads for itself, so this
# module stays a pure projection and the counts come from the single reader
# in `app.stats.test_status` that the text output also uses.
fn stats_json_v2(inventory: StatsInventoryV2, status: TestStatusCounts) -> text:
    var out = "{\"schema\":\"simple.stats.v2\",\"markdown_files\":{inventory.markdown_files},\"projects\":["
    var first = true
    for row in inventory.projects:
        if not first: out = out + ","
        first = false
        out = out + "{\"name\":\"{stats_json_escape(row.name)}\",\"total_files\":{row.total_files},\"total_sloc\":{row.total_sloc},\"source_files\":{row.source_files},\"source_sloc\":{row.source_sloc},\"test_files\":{row.test_files},\"test_sloc\":{row.test_sloc}}"
    out = out + "],\"focus_areas\":["
    first = true
    for row in inventory.focus_areas:
        if not first: out = out + ","
        first = false
        out = out + "{\"name\":\"{stats_json_escape(row.name)}\",\"source_files\":{row.source_files},\"source_sloc\":{row.source_sloc},\"test_files\":{row.test_files},\"test_sloc\":{row.test_sloc}}"
    out = out + "],\"languages\":["
    first = true
    for row in inventory.languages:
        if not first: out = out + ","
        first = false
        out = out + "{\"name\":\"{stats_json_escape(row.name)}\",\"files\":{row.files},\"sloc\":{row.sloc}}"
    out = out + "],\"test_surfaces\":["
    first = true
    for row in inventory.test_surfaces:
        if not first: out = out + ","
        first = false
        out = out + "{\"name\":\"{stats_json_escape(row.name)}\",\"files\":{row.files},\"runnable_sloc\":{row.runnable_sloc}}"
    out = out + "],\"quality\":["
    first = true
    for row in inventory.quality:
        if not first: out = out + ","
        first = false
        out = out + "{\"metric\":\"{stats_json_escape(row.metric)}\",\"status\":\"{stats_json_escape(row.status)}\",\"source\":\"{stats_json_escape(row.source)}\",\"measured_at\":\"{stats_json_escape(row.measured_at)}\",\"summary\":\"{stats_json_escape(row.summary)}\"}"
    out = out + "],\"test_status\":{\"total\":{status.total},\"passed\":{status.passed},\"failed\":{status.failed},\"skipped\":{status.skipped},\"pending\":{status.pending},\"in_development\":{status.in_development},\"in_development_unexpected\":{status.in_development_unexpected},\"in_development_broken\":{status.in_development_broken},\"unclassified\":{status.unclassified}}"
    out + "}"

export stats_json_escape, stats_json_v2
