# Markdown rendering for `simple stats` project reports.

use std.nogc_sync_mut.io.file_ops.{file_write}
use app.stats.types.{StatsInventoryV2}

fn stats_report_path(args: [text]) -> text:
    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "--no-report":
            return ""
        if arg == "--report" and i + 1 < args.len():
            return args[i + 1]
        if arg.starts_with("--report="):
            return arg[9:]
        i = i + 1
    "doc/09_report/project_statistics.md"

fn stats_markdown(
    project_rows: [[text]],
    language_rows: [[text]],
    simple_src_files: i64,
    simple_src_sloc: i64,
    simple_test_files: i64,
    simple_test_sloc: i64,
    unit_specs: i64,
    integration_specs: i64,
    system_specs: i64,
    other_specs: i64,
    md_files: i64,
    md_test_files: i64,
    md_test_sloc: i64,
    comment_test_files: i64,
    comment_test_sloc: i64,
    tests_total: i64,
    tests_passed: i64,
    feature_total: i64,
    feature_done: i64,
    feature_current: i64,
    feature_requested: i64,
    public_items: i64,
    documented_items: i64
) -> text:
    var md = "# Project Statistics\n\n"
    md = md + "> Generated by `simple stats`. TLDR Markdown companions and vendored/third-party source are excluded.\n\n"
    md = md + "## Project LOC\n\n"
    md = md + "| Project | Simple files | Simple SLOC |\n|---|---:|---:|\n"
    for row in project_rows:
        md = md + "| {row[0]} | {row[1]} | {row[2]} |\n"

    md = md + "\n## Languages\n\n"
    md = md + "| Language | Files | SLOC |\n|---|---:|---:|\n"
    for row in language_rows:
        md = md + "| {row[0]} | {row[1]} | {row[2]} |\n"

    md = md + "\n## Test Inventory\n\n"
    md = md + "| Test form | Files | Runnable LOC |\n|---|---:|---:|\n"
    md = md + "| SSpec/SPipe (`*_spec.spl`) | {simple_test_files} | {simple_test_sloc} |\n"
    md = md + "| Markdown fenced tests | {md_test_files} | {md_test_sloc} |\n"
    md = md + "| Source comment SDoctests (`>>>`) | {comment_test_files} | {comment_test_sloc} |\n\n"
    md = md + "SSpec tiers: **{unit_specs} unit**, **{integration_specs} integration**, **{system_specs} system**, **{other_specs} other**.\n\n"
    md = md + "Simple production source: **{simple_src_files} files / {simple_src_sloc} SLOC**. "
    md = md + "Markdown documentation: **{md_files} files** (excluding `*_tldr.md`).\n\n"

    var pass_rate = 0
    if tests_total > 0:
        pass_rate = (tests_passed * 100) / tests_total
    var doc_rate = 0
    if public_items > 0:
        doc_rate = (documented_items * 100) / public_items

    md = md + "## Features and Coverage\n\n"
    md = md + "| Metric | Value |\n|---|---:|\n"
    md = md + "| Features total | {feature_total} |\n"
    md = md + "| Features done | {feature_done} |\n"
    md = md + "| Features current | {feature_current} |\n"
    md = md + "| Features requested | {feature_requested} |\n"
    md = md + "| Recorded tests passed | {tests_passed} / {tests_total} ({pass_rate}%) |\n"
    md = md + "| Public API documentation | {documented_items} / {public_items} ({doc_rate}%) |\n\n"
    md = md + "Coverage values are derived from repository tracking artifacts; they are not presented as fresh execution evidence.\n"
    md

fn write_stats_markdown(path: text, content: text) -> bool:
    if path == "":
        return true
    file_write(path, content)

# Pure V2 projections.  The inventory owns classification and evidence truth;
# these functions only arrange that normalized data for durable outputs.
fn stats_markdown_v2(inventory: StatsInventoryV2) -> text:
    var md = "# Project Statistics\n\n"
    md = md + "> Generated by `simple stats`. Owned code only; generated, vendored, and `*_tldr.md` files are excluded.\n\n"
    md = md + "## Project Totals\n\n"
    md = md + "| Project | Total files | Total SLOC |\n"
    md = md + "|---|---:|---:|\n"
    for row in inventory.projects:
        md = md + "| {row.name} | {row.total_files} | {row.total_sloc} |\n"

    md = md + "\n## Source and Test Split\n\n"
    md = md + "| Project | Source files | Source SLOC | Test files | Test SLOC |\n"
    md = md + "|---|---:|---:|---:|---:|\n"
    for row in inventory.projects:
        md = md + "| {row.name} | {row.source_files} | {row.source_sloc} | {row.test_files} | {row.test_sloc} |\n"

    md = md + "\n## Focus Areas (non-additive)\n\n"
    md = md + "Firmware and RISC-V focus rows overlap portfolio ownership and must not be summed into portfolio totals.\n\n"
    md = md + "| Focus | Source files | Source SLOC | Test files | Test SLOC |\n"
    md = md + "|---|---:|---:|---:|---:|\n"
    for row in inventory.focus_areas:
        md = md + "| {row.name} | {row.source_files} | {row.source_sloc} | {row.test_files} | {row.test_sloc} |\n"

    md = md + "\n## Languages\n\n| Language | Files | SLOC |\n|---|---:|---:|\n"
    for row in inventory.languages:
        md = md + "| {row.name} | {row.files} | {row.sloc} |\n"

    md = md + "\n## Test Inventory\n\n| Test surface | Files | Runnable SLOC |\n|---|---:|---:|\n"
    for row in inventory.test_surfaces:
        md = md + "| {row.name} | {row.files} | {row.runnable_sloc} |\n"
    md = md + "\nMarkdown documentation: **{inventory.markdown_files} files**, excluding TLDR companions.\n"

    md = md + "\n## Quality Evidence\n\n| Metric | Status | Source | Measured at | Summary |\n|---|---|---|---|---|\n"
    if inventory.quality.len() == 0:
        md = md + "| Quality analysis | unavailable | not requested | — | Run with `--quality=summary` or `--quality=full`. |\n"
    for evidence in inventory.quality:
        md = md + "| {evidence.metric} | {evidence.status} | {evidence.source} | {evidence.measured_at} | {evidence.summary} |\n"
    md = md + "\nQuality values are evidence records, not implied fresh execution results.\n"
    md

fn stats_tldr_markdown_v2(inventory: StatsInventoryV2) -> text:
    var total_files = 0
    var total_sloc = 0
    var source_sloc = 0
    var test_sloc = 0
    for row in inventory.projects:
        total_files = total_files + row.total_files
        total_sloc = total_sloc + row.total_sloc
        source_sloc = source_sloc + row.source_sloc
        test_sloc = test_sloc + row.test_sloc

    var test_files = 0
    var runnable_test_sloc = 0
    for row in inventory.test_surfaces:
        test_files = test_files + row.files
        runnable_test_sloc = runnable_test_sloc + row.runnable_sloc

    var md = "# Project Statistics — TLDR\n\n"
    md = md + "| Portfolio | Value |\n|---|---:|\n"
    md = md + "| Owned files | {total_files} |\n| Owned SLOC | {total_sloc} |\n"
    md = md + "| Source SLOC | {source_sloc} |\n| Project test SLOC | {test_sloc} |\n"
    md = md + "| Runnable test files | {test_files} |\n| Runnable test LOC | {runnable_test_sloc} |\n"
    md = md + "| Markdown files (non-TLDR) | {inventory.markdown_files} |\n\n"
    md = md + "## Quality\n\n"
    if inventory.quality.len() == 0:
        md = md + "Quality evidence: **unavailable (not requested)**.\n"
    for evidence in inventory.quality:
        md = md + "- **{evidence.metric}: {evidence.status}** — {evidence.summary} ({evidence.source}, {evidence.measured_at})\n"
    md = md + "\nFocus rows such as firmware and RISC-V are overlapping views and are not included twice.\n"
    md

fn stats_slides_markdown_v2(inventory: StatsInventoryV2) -> text:
    var total_files = 0
    var total_sloc = 0
    var source_sloc = 0
    var test_sloc = 0
    for row in inventory.projects:
        total_files = total_files + row.total_files
        total_sloc = total_sloc + row.total_sloc
        source_sloc = source_sloc + row.source_sloc
        test_sloc = test_sloc + row.test_sloc

    var md = "Project Statistics\n@layout: section\n@notes: simpleos-default-theme\nSimpleOS engineering portfolio\nOwned-code inventory and quality evidence\n\n---\n\n"
    md = md + "Portfolio\n- **{total_files}** owned files\n- **{total_sloc}** total SLOC\n- **{source_sloc}** source SLOC\n- **{test_sloc}** project test SLOC\n- **{inventory.markdown_files}** non-TLDR Markdown files\n\n---\n\n"
    md = md + "Projects\n| Project | Source SLOC | Test SLOC |\n|---|---:|---:|\n"
    for row in inventory.projects:
        md = md + "| {row.name} | {row.source_sloc} | {row.test_sloc} |\n"
    md = md + "\n---\n\nTests\n| Surface | Files | Runnable LOC |\n|---|---:|---:|\n"
    for row in inventory.test_surfaces:
        md = md + "| {row.name} | {row.files} | {row.runnable_sloc} |\n"
    md = md + "\n---\n\nQuality\n"
    if inventory.quality.len() == 0:
        md = md + "- Quality evidence unavailable: analysis was not requested.\n"
    for evidence in inventory.quality:
        md = md + "- **{evidence.metric} — {evidence.status}:** {evidence.summary}\n"
    md = md + "\n---\n\nRisks\n- Stale and unavailable evidence is never rendered as zero or PASS.\n- Focus areas overlap portfolio ownership and are non-additive.\n\n---\n\n"
    md = md + "Methodology\n- One normalized `StatsInventoryV2` drives every output.\n- Generated, vendored, and TLDR companion files are excluded.\n- Quality rows retain source and measurement time.\n"
    md
