# Native Tauri runner entry.
#
# The Tauri shell (tools/tauri-shell) spawns the Simple side as
#   <simple-bin> run src/app/ui/main.spl tauri <entry.ui.sdn>
# This native binary accepts the same argv shape: it scans argv for the
# .ui.sdn token and runs the full Tauri app loop (render IPC + stdin events).
# It exists because the interpreted seed lane cannot load the current UI
# graph on macOS (native-only thread/db externs and newer frontend syntax in
# the transitively imported modules); the native runtime provides both.

use app.ui.tauri.app.{run_tauri}
use std.sffi.cli.{cli_get_args}

fn main() -> i64:
    val args = cli_get_args()
    var file_path = ""
    for arg in args:
        if arg.ends_with(".ui.sdn"):
            file_path = arg
    if file_path == "":
        print "ui-tauri-native: no .ui.sdn entry in argv"
        return 1
    return run_tauri(file_path, 3000)
