# SPipe Documentation Generator (Written in Simple)
#
# Extracts markdown documentation from spipe test files ("""...""" blocks)
# and generates comprehensive BDD-style documentation in doc/06_spec/
#
# Modules:
#   common.spl   — Types, log helpers, filesystem aliases
#   parser.spl   — Parser, metadata extraction, validation, test structure
#   generator.spl — Doc generation, index generation
#
# Usage: spipe-docgen <spec_files...> [--output <dir>]

use std.cli.cli_util (get_cli_args)

# Import from split modules
use app.spipe_docgen.common.*
use app.spipe_docgen.parser.{parse_spipe_file, extract_metadata, validate_spec}
use app.spipe_docgen.generator.*
use app.spipe_docgen.showcase.{generate_evidence_showcases}
use app.spipe_docgen.evidence_manifest.{
    render_evidence_manifest,
    validate_evidence_artifact_files
}
use std.spec.scenario_evidence_manifest.{
    scenario_evidence_manifest_from_sdn
}
use std.spec.scenario_evidence_manifest_io.{
    scenario_evidence_manifest_path_for_spec
}

# ============================================================================
# MAIN ENTRY POINT
# ============================================================================

fn print_spec_status(doc: SspecDoc, validation: ValidationResult):
    val filename = get_file_stem(doc.file_path)

    if validation.docs_present:
        if validation.warnings.len() == 0:
            print "  OK {filename} ({validation.doc_lines} lines)"
        else:
            print "  WARN  {filename} ({validation.doc_lines} lines, {validation.warnings.len()} warnings)"
            for warning in validation.warnings:
                print "      -> {warning}"
    else:
        print "  AUTO {filename} - Auto-generated from test structure"

fn print_summary(stats: DocStats):
    print ""
    print "============================================================"
    print "Summary:"
    print "  Complete documentation: {stats.specs_with_docs}/{stats.total_specs}"

    var stub_percent = 0
    if stats.total_specs > 0:
        stub_percent = (stats.specs_without_docs * 100) / stats.total_specs
    print "  Stubs: {stats.specs_without_docs}/{stats.total_specs} ({stub_percent}%)"
    print "  Total documentation: {stats.total_doc_lines} lines"

    if stats.total_warnings > 0:
        print "  Warnings: {stats.total_warnings}"

    print "============================================================"

fn append_evidence_manifest(
    spec_path: text,
    manual_path: text
) -> Result<bool, text>:
    val manifest_path = scenario_evidence_manifest_path_for_spec(spec_path)
    if not native_fs_exists(manifest_path):
        return Ok(false)
    val manifest = validate_evidence_artifact_files(
        scenario_evidence_manifest_from_sdn(
            native_fs_read_string(manifest_path)
        )?
    )?
    if manifest.spec_path != spec_path:
        return Err("evidence manifest spec_path mismatch: " + manifest_path)
    if manifest.generated_manual_path != manual_path:
        return Err("evidence manifest manual path mismatch: " + manifest_path)
    val rendered = render_evidence_manifest(manifest)?
    val merged = native_fs_read_string(manual_path).trim_end() +
        "\n\n---\n\n" + rendered
    if not native_fs_write_string(manual_path, merged):
        return Err("failed to write evidence manual: " + manual_path)
    Ok(true)

fn print_usage():
    print "SPipe Documentation Generator"
    print ""
    print "Usage: spipe-docgen <spec_file>... [--output <dir>]"
    print "       spipe-docgen --showcase [--inventory <path>]"
    print ""
    print "Arguments:"
    print "  <spec_file>...    One or more spipe files (*_spec.spl)"
    print ""
    print "Options:"
    print "  --output <dir>    Output directory (default: doc/06_spec)"
    print "  -o <dir>          Short form of --output"
    print "  --no-index        Do not regenerate INDEX.md"
    print "  --showcase        Generate root and subproject evidence status regions"
    print "  --inventory PATH  Showcase inventory (default: config/evidence_showcase.sdn)"
    print "  --help, -h        Show this help message"
    print ""
    print "Features:"
    print "  - Extracts \"\"\"...\"\"\" documentation blocks"
    print "  - Parses #[id(...)] feature attributes"
    print "  - Extracts metadata (Feature ID, Category, Status, Difficulty)"
    print "  - Extracts describe/context/it test structure"
    print "  - Generates per-feature .md files"
    print "  - Generates categorized INDEX.md"
    print "  - Validates documentation quality"
    print ""
    print "Example:"
    print "  spipe-docgen tests/system/*_spec.spl"
    print "  spipe-docgen tests/specs/*.spl --output doc/06_spec"
    print "  spipe-docgen --showcase"

fn run_showcase_generation(args: [text]) -> i64:
    var inventory_path = "config/evidence_showcase.sdn"
    var seen_showcase = false
    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "spipe-docgen" or arg == "spipe_docgen":
            i = i + 1
        elif arg == "--showcase":
            if seen_showcase:
                spipe_err("--showcase may be provided only once")
                return 2
            seen_showcase = true
            i = i + 1
        elif arg == "--inventory":
            if i + 1 >= args.len() or args[i + 1].starts_with("-"):
                spipe_err("--inventory requires a path")
                return 2
            inventory_path = args[i + 1]
            i = i + 2
        else:
            spipe_err("--showcase cannot be combined with spec generation option: {arg}")
            return 2
    match generate_evidence_showcases(inventory_path):
        case Ok(written):
            print "DONE Generated {written} evidence showcase page(s)"
            0
        case Err(message):
            spipe_err("Evidence showcase generation failed: {message}")
            1

fn run_spipe_docgen(args: [text]) -> i64:
    # Parse arguments
    if args.len() == 0:
        print_usage()
        return 1

    var help_count = 0
    var normalized_count = 0
    var help_i = 0
    if args[0] == "spipe-docgen" or args[0] == "spipe_docgen":
        help_i = 1
    while help_i < args.len():
        val arg = args[help_i]
        normalized_count = normalized_count + 1
        if arg == "--help" or arg == "-h":
            help_count = help_count + 1
        help_i = help_i + 1
    if help_count > 0:
        if help_count != 1 or normalized_count != 1:
            spipe_err("--help must be used alone")
            print_usage()
            return 2
        print_usage()
        return 0

    var showcase_count = 0
    for arg in args:
        if arg == "--showcase":
            showcase_count = showcase_count + 1
    if showcase_count > 0:
        return run_showcase_generation(args)

    # Extract output directory
    var output_dir = "doc/06_spec"
    var generate_index = true
    var spec_files = []
    var had_error = false

    var j = 0
    while j < args.len():
        val arg = args[j]
        if arg == "spipe-docgen" or arg == "spipe_docgen":
            j = j + 1
        elif arg == "--output" or arg == "-o":
            if j + 1 < args.len() and not args[j + 1].starts_with("-"):
                output_dir = args[j + 1]
                j = j + 2
            else:
                spipe_err("--output requires a directory")
                had_error = true
                j = j + 1
        elif arg == "--no-index":
            generate_index = false
            j = j + 1
        elif not arg.starts_with("-"):
            spec_files.push(arg)
            j = j + 1
        else:
            spipe_err("Unknown option: {arg}")
            had_error = true
            j = j + 1

    if had_error:
        return 1

    if spec_files.len() == 0:
        spipe_err("No spec files provided")
        print ""
        print_usage()
        return 1

    # Create output directory (ignore errors if it already exists)
    native_fs_create_dir(output_dir)

    print ""
    print "Generating BDD documentation..."
    print "  Input files: {spec_files.len()}"
    print "  Output dir: {output_dir}"
    print ""
    print "Processing specs:"

    var stats = DocStats.empty()
    var entries = []
    var docs_written = 0

    # Parse and process all spipe files
    for file_path in spec_files:
        spipe_dbg("processing: {file_path}")
        val parse_result = parse_spipe_file(file_path)
        spipe_dbg("parse complete for: {file_path}")
        match parse_result:
            case Err(e):
                spipe_err("Failed to parse {file_path}: {e}")
                had_error = true
            case Ok(parsed):
                spipe_dbg("matched Ok, extracting metadata")
                # Extract metadata
                val metadata = extract_metadata(parsed)
                spipe_dbg("metadata extracted")
                val doc_with_meta = SspecDoc(
                    file_path: parsed.file_path,
                    raw_content: parsed.raw_content,
                    doc_blocks: parsed.doc_blocks,
                    feature_title: parsed.feature_title,
                    feature_ids: parsed.feature_ids,
                    metadata: metadata
                )

                # Validate
                val validation = validate_spec(doc_with_meta)

                # Update stats
                stats = DocStats(
                    total_specs: stats.total_specs + 1,
                    specs_with_docs: stats.specs_with_docs + (if validation.docs_present: 1 else: 0),
                    specs_without_docs: stats.specs_without_docs + (if validation.docs_present: 0 else: 1),
                    total_doc_lines: stats.total_doc_lines + validation.doc_lines,
                    total_warnings: stats.total_warnings + validation.warnings.len()
                )

                # Print progress
                print_spec_status(doc_with_meta, validation)

                # Generate individual doc
                val file_name = get_file_stem(file_path)
                var output_filename = "{file_name}.md"
                val gen_result = generate_feature_doc(doc_with_meta, output_dir)
                match gen_result:
                    case Err(e):
                        spipe_warn("Failed to generate doc for {file_path}: {e}")
                        had_error = true
                    case Ok(path):
                        match append_evidence_manifest(file_path, path):
                            case Err(e):
                                spipe_warn("Failed to render evidence for {file_path}: {e}")
                                had_error = true
                            case Ok(_):
                                docs_written = docs_written + 1
                                output_filename = relative_path_from_output(output_dir, path)

                # Create feature entry for INDEX
                var title = humanize_filename(file_name)
                if doc_with_meta.feature_title != "":
                    title = doc_with_meta.feature_title
                var category = infer_category_from_path(file_path)
                if metadata.category != "":
                    category = metadata.category

                # Compute test counts for status
                val test_counts = count_test_items(parsed.raw_content)
                val total_it = test_counts[0]
                val skip_it = test_counts[1]
                val pending_it = test_counts[2]

                var status_str = metadata.status
                if status_str == "":
                    status_str = "Auto-generated"
                    if validation.docs_present:
                        if validation.doc_lines >= 200:
                            status_str = "Complete"
                        elif validation.doc_lines >= 50:
                            status_str = "Partial"
                        else:
                            status_str = "Minimal"

                var difficulty_str = "N/A"
                if metadata.difficulty != "":
                    difficulty_str = metadata.difficulty
                val coverage_val = calculate_coverage(validation.doc_lines)

                entries.push(FeatureEntry(
                    title: title,
                    filename: output_filename,
                    status: status_str,
                    difficulty: difficulty_str,
                    coverage: "{coverage_val}%",
                    doc_lines: validation.doc_lines,
                    category: category,
                    test_count: total_it + skip_it + pending_it
                ))

    # Generate INDEX.md
    if (generate_index and not had_error and stats.specs_without_docs == 0 and
        stats.total_specs == spec_files.len() and docs_written == spec_files.len()):
        val index_result = generate_index_page(entries, output_dir, stats)
        match index_result:
            case Err(e):
                spipe_warn("Failed to generate INDEX.md: {e}")
                had_error = true
            case Ok(_):
                pass

    # Print summary
    print_summary(stats)

    val success = (not had_error and stats.specs_without_docs == 0 and
        stats.total_specs == spec_files.len() and docs_written == spec_files.len())
    if success:
        print "DONE Generated {docs_written} docs ({stats.specs_with_docs} complete, 0 stubs)"
        return 0
    print "FAILED Generated {docs_written}/{spec_files.len()} docs ({stats.specs_without_docs} stubs)"
    1

fn main() -> i64:
    # get_cli_args() already strips program name and script path
    run_spipe_docgen(get_cli_args())
