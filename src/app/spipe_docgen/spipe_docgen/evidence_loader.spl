# SDN sidecar input boundary for spipe_docgen. Sidecar fields are caller claims;
# this process has no owner-admission API, so all rendered content is explicit
# unverified context and can never receive a verified badge here.
use std.common.spec.evidence.model.{EvidenceAudience}
use std.common.spec.evidence.format.sidecar_sdn.{
    EvidenceSidecar, EvidenceSidecarSource, EVIDENCE_SIDECAR_V1_SCHEMA,
    decode_evidence_sidecar_v2, import_legacy_evidence_sidecar_v1
}
use std.common.spec.evidence.manual_render.{render_blocks}
use app.spipe_docgen.common.{native_fs_read_string, native_fs_exists}
use std.nogc_sync_mut.io.env_ops.{env_get}

pub fn evidence_sidecar_path(spec_path: text) -> text:
    val dir = env_get("SIMPLE_SPEC_EVIDENCE_DIR")
    if dir == "":
        return spec_path + ".evidence.sdn"
    dir + "/" + spec_path + ".evidence.sdn"

# V1 is selected only by its explicit legacy key/value schema marker. Every
# other input is parsed only as SDN v2; a failed v2 parse never retries v1.
pub fn parse_evidence_sidecar(content: text) -> Result<EvidenceSidecar, text>:
    val trimmed = content.trim()
    if trimmed == "":
        return Err("evidence sidecar is empty")
    if trimmed.starts_with("schema=" + EVIDENCE_SIDECAR_V1_SCHEMA):
        return import_legacy_evidence_sidecar_v1(content)
    decode_evidence_sidecar_v2(content)

# No local claim can create a verified badge. Until the runner exposes an
# independent sealed admission value, every sidecar fragment is visibly
# unverified, including v2 records with complete-looking hash strings.
pub fn load_evidence_fragment(spec_path: text, audience: EvidenceAudience) -> Result<[text], text>:
    val sidecar_path = evidence_sidecar_path(spec_path)
    if not native_fs_exists(sidecar_path):
        return Ok([])
    val content = native_fs_read_string(sidecar_path)
    val sidecar = parse_evidence_sidecar(content)?
    if sidecar.blocks.len() == 0:
        return Ok([])
    var rendered: [text] = []
    if sidecar.source == EvidenceSidecarSource.HistoricalV1:
        rendered.push("> **Historical v1 evidence, unverified:** imported from the legacy key/value sidecar format.")
    else:
        rendered.push("> **Unverified evidence:** sidecar claims have not been admitted against an independently observed subject, producer, artifact bytes, definition, or expectation.")
    rendered.push("")
    for line in render_blocks(sidecar.blocks, audience):
        rendered.push(line)
    Ok(rendered)
