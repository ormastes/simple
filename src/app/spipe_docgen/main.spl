# Compatibility entrypoint for src/app/spipe_docgen/spipe_docgen/main.spl.
#
# Keep argument acquisition at the delegated entry boundary. Besides making
# ownership explicit, this lets the driver's argument-sensitive source policy
# select the interpreter path until JIT argument propagation has parity.

extern fn rt_cli_get_args() -> [text]

use app.spipe_docgen.spipe_docgen.main.{run_spipe_docgen}

fn main() -> i64:
    val raw = rt_cli_get_args()
    var args: [text] = []
    var index = 0
    for arg in raw:
        # File delegation prefixes the compatibility entry path. Direct
        # in-process callers already supply only logical docgen arguments.
        if index > 0 or not arg.ends_with("/spipe_docgen/main.spl"):
            args = args.push(arg)
        index = index + 1
    run_spipe_docgen(args)
