# Simple Slides Application
#
# Presentation editor with slide thumbnails, canvas, and speaker notes.

use common.ui.widget.{WidgetNode, UITree, UIEvent}
use common.ui.builder.{column, row, panel, label, text_widget, button, dropdown, scroll, textarea, statusbar, build_tree_with_title, with_flex}
use common.ui.theme_registry.{ThemeId, theme_id_key}
use common.ui.ios.builder.{navigation_bar}
use nogc_sync_mut.ui.theme_package.{load_default_theme_package}
use app.office.slides.slide.{Presentation, Slide, empty_presentation, blank_slide, add_slide_element, slide_count, current_slide, slide_layout_display_name, create_slide_from_layout_id}
use app.office.slides.render.{render_slide_thumbnail, render_slide_canvas}
use app.office.slides.layout_registry.{slide_layout_registry_display_names, slide_layout_registry_has}
use app.office.slides.element_kind_registry.{create_slide_element_by_kind}
use common.office.number.{office_parse_non_negative_i32}
use std.editor.extensions.host.{extension_host_ensure_command_activated}

# =========================================================================
# Application Class
# =========================================================================

class SlidesApp:
    presentation: Presentation
    selected_element: text
    editing_notes: bool
    modified: bool
    file_path: text
    selected_layout_id: text

impl SlidesApp:

    static fn new() -> SlidesApp:
        """Create a new Slides app with an empty presentation."""
        return SlidesApp(
            presentation: empty_presentation("Untitled Presentation"),
            selected_element: "",
            editing_notes: false,
            modified: false,
            file_path: "",
            selected_layout_id: "blank"
        )

    me build_ui() -> UITree:
        """Build the full Slides editor UI tree."""
        val pres = me.presentation
        val total = slide_count(pres)
        val cur = current_slide(pres)
        val slide_num = pres.active_slide + 1

        # Navigation bar
        val present_btn = button("btn_present", "Present", "present")
        val save_btn = button("btn_save", "Save", "save")
        val nav = navigation_bar("nav", "Simple Slides", [], [present_btn, save_btn])

        # Toolbar row
        val add_text_btn = button("btn_add_text", "+Text", "add_text")
        val add_image_btn = button("btn_add_image", "+Image", "add_image")
        val add_shape_btn = button("btn_add_shape", "+Shape", "add_shape")
        # Activate-before-read seam (doc/08_tracking/bug/
        # builtin_extensions_activate_eagerly_2026-07-30.md fix direction #1,
        # minimum alternative): the layout dropdown reads the registry
        # directly, so a registry-backed extension layout (e.g. slides_ext.spl
        # "title_diagram") must be activated before this listing is built, not
        # only when a slide is actually created from it.
        extension_host_ensure_command_activated("slides.layout.titleDiagram")
        val layout_drop = dropdown("layout_dropdown", slide_layout_registry_display_names())
        val toolbar = row("toolbar", [add_text_btn, add_image_btn, add_shape_btn, layout_drop])

        # Slide thumbnails panel (left sidebar)
        var thumb_items: [WidgetNode] = []
        var s_idx: i32 = 0
        for slide in pres.slides:
            val thumb_text = render_slide_thumbnail(slide, s_idx)
            var thumb_label = label("thumb_{s_idx}", thumb_text)
            if s_idx == pres.active_slide:
                thumb_label = thumb_label.set_prop("selected", "true")
            thumb_items.push(thumb_label)
            s_idx = s_idx + 1
        val add_slide_btn = button("btn_add_slide", "+ New Slide", "add_slide")
        thumb_items.push(add_slide_btn)
        var slide_list = scroll("slide_list", 400, thumb_items)
        slide_list = with_flex(slide_list, 1)

        # Canvas panel (main area)
        var canvas_children: [WidgetNode] = []
        if cur != nil:
            val widgets = render_slide_canvas(cur)
            for w in widgets:
                canvas_children.push(w)
        else:
            canvas_children.push(label("canvas_empty", "No slides"))
        var canvas = panel("canvas", "Slide {slide_num}", canvas_children)
        canvas = with_flex(canvas, 4)

        # Main row: sidebar + canvas
        val main_row = row("main_row", [slide_list, canvas])

        # Notes panel
        val notes_val = if cur != nil: cur.notes else: ""
        val notes_area = textarea("notes_area", notes_val, "Speaker notes...", 3)
        val notes_panel = panel("notes_panel", "Notes", [notes_area])

        # Layout name for status
        val layout_name = if cur != nil: slide_layout_display_name(cur.layout) else: "None"

        # Status bar
        val status = statusbar("statusbar",
            "Slide {slide_num} of {total} | {layout_name}",
            if me.modified: "Modified" else: "Saved"
        )

        val root = column("root", [nav, toolbar, main_row, notes_panel, status])
        # Look up the workspace default theme package first (ThemeService is
        # not landed yet -- see plan §3 L5); IOSLight is the final fallback.
        val resolved_theme_id = load_default_theme_package().id
        val theme_key = if resolved_theme_id == "": theme_id_key(ThemeId.IOSLight) else: resolved_theme_id
        return build_tree_with_title(root, "Simple Slides", theme_key)

    me handle_event(event: UIEvent):
        """Handle UI events for the Slides editor."""
        match event:
            UIEvent.Action(name):
                match name:
                    "add_slide":
                        me.add_slide(me.selected_layout_id)
                    "add_text":
                        me._add_element_by_kind("text_box", 100, 100, 300, 60)
                    "add_image":
                        me._add_element_by_kind("image", 100, 100, 400, 300)
                    "add_shape":
                        me._add_element_by_kind("shape", 150, 150, 200, 150)
                    "delete_slide":
                        me.delete_slide(me.presentation.active_slide)
                    "save":
                        me.modified = false
                    _:
                        if name.starts_with("navigate_"):
                            val idx_str = name.substring(9)
                            val idx = office_parse_non_negative_i32(idx_str)
                            me.navigate_slide(idx)
                        elif name.starts_with("select_layout_"):
                            val layout_id = name.substring(14)
                            extension_host_ensure_command_activated("slides.layout.titleDiagram")
                            if slide_layout_registry_has(layout_id):
                                me.selected_layout_id = layout_id
            _:
                pass_do_nothing("non-action UI events do not affect the slide editor")

    me _add_element_by_kind(kind_id: text, x: i32, y: i32, w: i32, h: i32):
        """Add an element to the current slide by element_kind_registry id.
        Unknown kind ids (should not happen for the builtin toolbar buttons)
        are a silent no-op -- the registry is the single source of truth for
        which kind ids exist."""
        val cur = current_slide(me.presentation)
        if cur != nil:
            val el_id = "el_{kind_id}_{cur.elements.len()}"
            match create_slide_element_by_kind(kind_id, el_id, x, y, w, h):
                Ok(el):
                    val updated = add_slide_element(cur, el)
                    me._replace_current_slide(updated)
                    me.modified = true
                Err(_):
                    pass_do_nothing("unknown element kind id -- nothing to add")

    me add_slide(layout_id: text):
        """Add a new slide with the given layout_registry id after the
        current slide. Falls back to a blank slide if the id is unknown."""
        val total = slide_count(me.presentation)
        val new_id = "slide_{total}"
        var new_slide = blank_slide(new_id)
        match create_slide_from_layout_id(layout_id, new_id):
            Ok(s):
                new_slide = s
            Err(_):
                pass_do_nothing("unknown layout id -- fall back to a blank slide")
        var new_slides: [Slide] = []
        var idx: i32 = 0
        var inserted = false
        for s in me.presentation.slides:
            new_slides.push(s)
            if idx == me.presentation.active_slide and not inserted:
                new_slides.push(new_slide)
                inserted = true
            idx = idx + 1
        if not inserted:
            new_slides.push(new_slide)
        me.presentation = Presentation(
            title: me.presentation.title,
            slides: new_slides,
            active_slide: me.presentation.active_slide + 1,
            theme_name: me.presentation.theme_name
        )
        me.modified = true

    me delete_slide(index: i32):
        """Delete the slide at the given index. Keeps at least one slide."""
        val total = slide_count(me.presentation)
        if total <= 1:
            return
        var new_slides: [Slide] = []
        var idx: i32 = 0
        for s in me.presentation.slides:
            if idx != index:
                new_slides.push(s)
            idx = idx + 1
        val new_active = if index >= new_slides.len(): new_slides.len() - 1 else: index
        me.presentation = Presentation(
            title: me.presentation.title,
            slides: new_slides,
            active_slide: new_active,
            theme_name: me.presentation.theme_name
        )
        me.modified = true

    me navigate_slide(index: i32):
        """Navigate to the slide at the given index."""
        val total = slide_count(me.presentation)
        if index < 0 or index >= total:
            return
        me.presentation = Presentation(
            title: me.presentation.title,
            slides: me.presentation.slides,
            active_slide: index,
            theme_name: me.presentation.theme_name
        )

    me _replace_current_slide(updated: Slide):
        """Replace the current slide with an updated version."""
        var new_slides: [Slide] = []
        var idx: i32 = 0
        for s in me.presentation.slides:
            if idx == me.presentation.active_slide:
                new_slides.push(updated)
            else:
                new_slides.push(s)
            idx = idx + 1
        me.presentation = Presentation(
            title: me.presentation.title,
            slides: new_slides,
            active_slide: me.presentation.active_slide,
            theme_name: me.presentation.theme_name
        )
