# Word Document Rendering
#
# Render document blocks as UI widgets for display.
#
# Built against the real `attributed_text` model (DocBlock { kind, spans }
# with the BlockKind enum) — see `word/html_render.spl`, which renders the
# same model to HTML and documents this as the canonical shape.

use common.ui.widget.{WidgetNode}
use common.ui.builder.{text_widget}
use common.rich_text.attributed_text.{DocBlock, BlockKind, spans_to_plain_text}

# =========================================================================
# Block Rendering
# =========================================================================

fn _block_prefix(kind: BlockKind, content: text) -> text:
    """Return the display text for a block, with a markdown-style prefix
    matching the block's kind (heading level, bullet/ordered marker, quote)."""
    match kind:
        case Paragraph: content
        case Heading1: "# {content}"
        case Heading2: "## {content}"
        case Heading3: "### {content}"
        case BulletItem: "- {content}"
        case OrderedItem: "1. {content}"
        case CodeBlock: content
        case Quote: "> {content}"
        case FootnoteDef: content

fn _block_style_tag(kind: BlockKind) -> text:
    """Map a block kind to a style/type tag for the widget's `block_type` prop."""
    match kind:
        case Paragraph: "paragraph"
        case Heading1: "heading_1"
        case Heading2: "heading_2"
        case Heading3: "heading_3"
        case BulletItem: "bullet_list"
        case OrderedItem: "numbered_list"
        case CodeBlock: "code_block"
        case Quote: "quote"
        case FootnoteDef: "footnote"

fn render_block(block: DocBlock, index: i32) -> WidgetNode:
    """Convert a DocBlock into a WidgetNode for display.

    Each block kind gets an appropriate text representation:
      Paragraph            -> plain text
      Heading1/2/3         -> "# title" / "## title" / "### title"
      BulletItem           -> "- item"
      OrderedItem          -> "1. item"
      CodeBlock            -> code text verbatim
      Quote                -> "> " prefix
      FootnoteDef          -> plain text
    """
    val widget_id = "block_{index}"
    val content = spans_to_plain_text(block.spans)
    val display_text = _block_prefix(block.kind, content)
    val block_type = _block_style_tag(block.kind)
    return _styled_text(widget_id, display_text, block_type)

# =========================================================================
# Document Rendering
# =========================================================================

fn render_document(blocks: [DocBlock]) -> [WidgetNode]:
    """Render all blocks in a document as a list of WidgetNodes."""
    var widgets: [WidgetNode] = []
    var idx: i32 = 0
    for block in blocks:
        val widget = render_block(block, idx)
        widgets = widgets.push(widget)
        idx = idx + 1
    return widgets

# =========================================================================
# Internal Helpers
# =========================================================================

fn _styled_text(id: text, content: text, block_type: text) -> WidgetNode:
    """Create a text widget annotated with its block type for styling."""
    var node = text_widget(id, content)
    node = node.set_prop("block_type", block_type)
    return node
