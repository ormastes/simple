# Spreadsheet ASCII width conversion. Input and output use UTF-8.
use std.common.string_builder.{RtStringBuilder}

pub fn asc_text(s: text) -> text:
    """Convert full-width ASCII and U+3000 to half-width, preserving other text."""
    _convert_ascii_width(s, false)

pub fn jis_text(s: text) -> text:
    """Convert half-width ASCII and space to full-width, preserving other text."""
    _convert_ascii_width(s, true)

fn _convert_ascii_width(s: text, full_width: bool) -> text:
    var out = RtStringBuilder.new()
    var offset: i64 = 0
    while offset < s.len():
        var end = offset + 1
        while end < s.len():
            val next_byte = s.byte_at(end)
            if next_byte < 0x80 or next_byte > 0xBF:
                break
            end = end + 1
        val ch = s.slice(offset, end)
        # Decode only this complete character, never the preceding UTF-8 prefix.
        val code = ch.char_code_at(0)
        if full_width:
            if code >= 0x0021 and code <= 0x007E:
                val converted = code + 0xFEE0
                out.push(converted.chr())
            elif code == 0x0020:
                val converted = 0x3000
                out.push(converted.chr())
            else:
                out.push(ch)
        else:
            if code >= 0xFF01 and code <= 0xFF5E:
                val converted = code - 0xFEE0
                out.push(converted.chr())
            elif code == 0x3000:
                out.push(" ")
            else:
                out.push(ch)
        offset = end
    out.finish()
