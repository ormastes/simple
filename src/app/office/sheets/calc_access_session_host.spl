# Opt-in Calc semantic UI transport adapter.
#
# Only this module imports the shared test/access HTTP transport.  It composes
# CalcSessionHost, so terminal keys and semantic actions still mutate one
# controller, UISession, workbook, history, and rendered frame.

use app.office.sheets.calc_session_host.{CalcSessionHost}
use app.ui.test_api.handler.{UiTestActionResult}
use app.ui.standalone.bootstrap.{StandaloneOptions, standalone_handle_stream_with_action_result}
use std.nogc_sync_mut.io.tcp.{TcpListener}

extern fn rt_terminal_enable_raw_mode() -> bool
extern fn rt_terminal_disable_raw_mode() -> bool

fn run_calc_access_session_host(port: i32, in_path: text) -> i32:
    val address = "127.0.0.1:" + port.to_text()
    match TcpListener.bind(address):
        Err(e):
            print "Error: Calc UI access bind failed: {e}"
            return 1
        Ok(listener):
            var host = CalcSessionHost.open(in_path)
            print "[calc] UI access ready on http://{address}/api/test/ready"
            if not rt_terminal_enable_raw_mode():
                print "Error: Calc TUI requires a terminal with raw-mode support"
                return 1
            host.start_terminal_input()
            host.redraw()
            val opts = StandaloneOptions.new_with_title(address, "Simple Calc TUI")
            val inject = \event:
                host.controller.apply_ui_event_to_session(host.session, event)
                host.redraw()
            val inject_action = \event:
                val result = host.controller.apply_ui_event_to_session(host.session, event)
                host.redraw()
                UiTestActionResult(ok: result.ok, code: result.code)
            while host.running:
                match listener.accept_timeout(25):
                    Ok(stream):
                        # Bound partial clients so terminal input remains live.
                        stream.set_read_timeout(1000)
                        stream.set_write_timeout(1000)
                        standalone_handle_stream_with_action_result(
                            stream, host.session, inject, inject_action, opts
                        )
                    Err(_):
                        pass_dn
                host.drain_terminal_bytes()
            host.input_bytes.close()
            if not rt_terminal_disable_raw_mode():
                print "Error: Calc terminal restoration failed"
                return 1
            print "bye"
            0

export run_calc_access_session_host
