"""Hosted raw-terminal adapter for the portable Calc TUI model."""

use app.office.sheets.calc_tui.{calc_tui_new, calc_tui_frame, calc_tui_apply_byte}
use app.office.sheets.sheet_io.{sheet_load, sheet_save}

extern fn rt_stdin_read_byte() -> i64
extern fn rt_terminal_enable_raw_mode() -> bool
extern fn rt_terminal_disable_raw_mode() -> bool

fn run_calc_tui(path: text) -> i32:
    var state = calc_tui_new(sheet_load(path))
    if not rt_terminal_enable_raw_mode():
        print "Error: interactive Calc requires a terminal with raw-mode support"
        return 1
    print calc_tui_frame(state, path, true)
    while not state.quit:
        state = calc_tui_apply_byte(state, rt_stdin_read_byte())
        if state.dirty:
            val _ = sheet_save(state.sheet, path)
        if not state.quit and state.pending_escape == 0:
            print calc_tui_frame(state, path, true)
    val restored = rt_terminal_disable_raw_mode()
    if not restored:
        print "Error: terminal restoration failed"
        return 1
    0

export run_calc_tui
