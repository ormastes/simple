"""Command owner for the standalone Calc-first Office binary."""

use app.office.sheets.calc_tui.{run_calc_frame_once}
use app.office.sheets.calc_tui_host.{run_calc_tui}

struct CalcCliOptions:
    path: text
    tui: bool
    frame_once: bool

fn parse_calc_cli(args: [text]) -> Result<CalcCliOptions, text>:
    var path = "untitled.csv"
    var tui = false
    var frame_once = false
    var index = 0
    while index < args.len():
        val arg = args[index]
        if arg == "--tui":
            tui = true
        elif arg == "--frame-once":
            frame_once = true
        elif arg == "--help" or arg == "-h":
            return Err("help")
        elif arg.starts_with("--"):
            return Err("unknown option '{arg}'")
        else:
            path = arg
        index = index + 1
    if not tui and not frame_once:
        return Err("one of --tui or --frame-once is required")
    Ok(CalcCliOptions(path: path, tui: tui, frame_once: frame_once))

fn calc_cli_usage():
    print "Usage: office calc [FILE.csv|.ods|.xlsx] (--tui|--frame-once)"

fn run_calc_cli(args: [text]) -> i32:
    val parsed = parse_calc_cli(args)
    match parsed:
        case Err(message):
            if message != "help": print "Error: {message}"
            calc_cli_usage()
            return if message == "help": 0 else: 1
        case Ok(options):
            if options.frame_once:
                return run_calc_frame_once(options.path)
            run_calc_tui(options.path)

export CalcCliOptions, parse_calc_cli, calc_cli_usage, run_calc_cli
