"""Command owner for the standalone Calc-first Office binary."""

use app.office.sheets.calc_tui.{run_calc_frame_once}
use app.office.sheets.calc_tui_host.{run_calc_tui}
use app.office.sheets.calc_access_session_host.{run_calc_access_session_host}

struct CalcCliOptions:
    path: text
    tui: bool
    frame_once: bool
    access_port: i32

fn parse_calc_cli(args: [text]) -> Result<CalcCliOptions, text>:
    var path = "untitled.csv"
    var tui = false
    var frame_once = false
    var access_port = 0
    var index = 0
    while index < args.len():
        val arg = args[index]
        if arg == "--tui":
            tui = true
        elif arg == "--frame-once":
            frame_once = true
        elif arg == "--ui-access-port":
            if index + 1 >= args.len():
                return Err("--ui-access-port requires a port")
            access_port = args[index + 1].to_i32()
            if access_port <= 0 or access_port > 65535:
                return Err("UI access port must be between 1 and 65535")
            index = index + 1
        elif arg == "--help" or arg == "-h":
            return Err("help")
        elif arg.starts_with("--"):
            return Err("unknown option '{arg}'")
        else:
            path = arg
        index = index + 1
    if not tui and not frame_once:
        return Err("one of --tui or --frame-once is required")
    if tui and frame_once:
        return Err("--tui and --frame-once are mutually exclusive")
    if access_port > 0 and not tui:
        return Err("--ui-access-port requires --tui")
    Ok(CalcCliOptions(path: path, tui: tui, frame_once: frame_once, access_port: access_port))

fn calc_cli_usage():
    print "Usage: office calc [FILE.csv|.ods|.xlsx] (--tui [--ui-access-port N]|--frame-once)"

fn run_calc_cli(args: [text]) -> i32:
    val parsed = parse_calc_cli(args)
    match parsed:
        case Err(message):
            if message != "help": print "Error: {message}"
            calc_cli_usage()
            return if message == "help": 0 else: 1
        case Ok(options):
            if options.frame_once:
                return run_calc_frame_once(options.path)
            if options.access_port > 0:
                return run_calc_access_session_host(options.access_port, options.path)
            run_calc_tui(options.path)

export CalcCliOptions, parse_calc_cli, calc_cli_usage, run_calc_cli
