use app.buildrunner.scv_cli_options_v1.{build_runner_scv_options_v1}
use app.buildrunner.scv_session_v1.{BuildRunnerScvSessionV1, build_runner_scv_session_open_v1,
    build_runner_scv_source_root_v1, build_runner_scv_source_paths_v1}
use app.buildrunner.cli_files_v1.{builder_cli_hash_outputs_v1, builder_cli_input_error_v1, builder_cli_inputs_match_v1, builder_cli_publish_v1, builder_cli_resolve_roots_v1}
use app.buildrunner.database_session.{BuildRunnerDatabaseSessionV1, build_runner_database_session_open_v1}
# The manager owns every canonical transition and published output. Worker
# processes own isolated attempt directories and return encoded receipts.
use app.io.args_ops.{get_args}
use app.io.env_ops.{cwd, host_os}
use app.io.file_ops.{file_exists, file_read, file_read_regular_no_follow_bounded,
    file_atomic_write, file_lock, file_unlock, file_copy, file_delete,
    file_hash_sha256, file_is_regular_no_follow, file_publish_noreplace,
    secure_temp_dir, path_absolute}
use std.nogc_sync_mut.io_runtime.{dir_exists, dir_remove}
use app.io.dir_ops.{dir_create_all}
use app.io.time_ops.{sleep_ms}
use app.bootstrap_builder.cli_args.{BuilderCliV1, builder_cli_parse_v1}
use app.bootstrap_builder.process_port.{BuilderProcessPortV1, builder_process_portable_v1}
use app.bootstrap_builder.contracts.{BuildInputV1, BuildTaskV1, BuildResultV1, BuildRunV1, builder_task_identity_v1, builder_validate_result_v1}
use app.bootstrap_builder.codec.{builder_read_run_v1, builder_read_result_v1, builder_write_result_v1,
    builder_encode_result_v1}
use app.buildrunner.runner.{BuildRunnerV1, build_runner_start, build_runner_ready, build_runner_dependencies_ready, build_runner_host_slots, build_runner_dispatch, build_runner_reap, build_runner_unresolved, build_runner_accept, build_runner_resume, build_runner_done, build_runner_succeeded, build_runner_output_error, build_runner_encode_v1, build_runner_decode_v1}
use app.bootstrap_builder.worker.{builder_worker_execute_v1, builder_worker_environment_digest_v1}
use app.bootstrap_builder.failure_policy.{builder_failure_class_v1}
use app.bootstrap_builder.phase_admission.{managed_phase_cli_v1}
use app.bootstrap_builder.grouped_native_run.{NativeGroupedCapacityV1}
use app.bootstrap_builder.link_inputs.{builder_link_inputs_match_v1,
    builder_regular_input_parents_safe_v1}
use app.bootstrap_builder.transport.{BuilderAttemptV1, builder_transport_start_v1,
    builder_transport_recover_v1, builder_transport_poll_v1, builder_transport_cancel_v1,
    builder_transport_collect_v1, builder_transport_reaped_v1,
    builder_transport_prune_terminal_inputs_v1,
    builder_transport_prune_failed_inputs_v1}

fn builder_cli_persist_v1(state: BuildRunnerV1, directory: text) -> bool:
    val payload = build_runner_encode_v1(state)
    payload != "" and file_atomic_write(directory + "/journal.sdn", payload)

fn builder_cli_restore_v1(task: BuildTaskV1, cached: BuildResultV1, run: BuildRunV1,
        directory: text, source_root: text, output_root: text, process: BuilderProcessPortV1,
        scv: BuildRunnerScvSessionV1? = nil) -> bool:
    # A damaged published copy need not discard a valid immutable attempt.
    # Recovery proves the old compiler tree was reaped before we collect files.
    for host in run.hosts:
        if host.id == cached.host_id:
            match builder_transport_recover_v1(task, host, directory, process):
                case Err(_): return false
                case Ok(attempt):
                    if builder_transport_poll_v1(attempt) < 0: return false
                    match builder_transport_collect_v1(attempt):
                        case Err(_): return false
                        case Ok(receipt):
                            if receipt.status != "OK" or builder_validate_result_v1(task, receipt) != "": return false
                            val observed = builder_cli_hash_outputs_v1(task,
                                attempt.local_root + "/work", process)
                            if build_runner_output_error(task, cached, observed) != "": return false
                            if not builder_cli_inputs_match_v1(task, source_root, scv): return false
                            return builder_cli_publish_v1(task, cached, attempt.local_root,
                                output_root, process)
    false

fn builder_cli_cancel_v1(attempts: [BuilderAttemptV1]) -> bool:
    var all_reaped = true
    for attempt in attempts:
        if not builder_transport_cancel_v1(attempt): all_reaped = false
    all_reaped

fn builder_cli_prune_success_v1(task: BuildTaskV1, receipt: BuildResultV1,
        run: BuildRunV1, state_root: text, source_root: text, output_root: text,
        process: BuilderProcessPortV1) -> text:
    # Legacy runs publish into the source tree and retain their original
    # attempt layout. The isolated local inventory lane opts into pruning.
    if output_root == source_root: return ""
    for host in run.hosts:
        if host.id == receipt.host_id:
            if host.transport != "local": return ""
            val root = state_root + "/attempts/" + task.id + "/" + str(task.attempt) + "/" + host.id
            val attempt = BuilderAttemptV1(task_id: task.id, attempt: task.attempt,
                host: host, pid: 0, local_root: root, remote_root: "", error: "",
                identity_digest: builder_task_identity_v1(task), process: process)
            return match builder_transport_prune_terminal_inputs_v1(task, attempt, receipt, output_root):
                case Ok(_deleted): ""
                case Err(reason): reason
    "input prune host is unknown"

fn builder_cli_prune_failure_v1(task: BuildTaskV1, receipt: BuildResultV1,
        run: BuildRunV1, state_root: text, source_root: text,
        output_root: text, process: BuilderProcessPortV1) -> text:
    if output_root == source_root: return ""
    for host in run.hosts:
        if host.id == receipt.host_id:
            if host.transport != "local": return ""
            val root = state_root + "/attempts/" + task.id + "/" +
                str(task.attempt) + "/" + host.id
            val attempt = BuilderAttemptV1(task_id: task.id,
                attempt: task.attempt, host: host, pid: 0,
                local_root: root, remote_root: "", error: "",
                identity_digest: builder_task_identity_v1(task),
                process: process)
            return match builder_transport_prune_failed_inputs_v1(
                    task, attempt, receipt, source_root, output_root):
                case Ok(_deleted): ""
                case Err(reason): reason
    "failed input prune host is unknown"

fn builder_cli_failure_v1(task: BuildTaskV1, host: text, status: text, code: i64) -> BuildResultV1:
    BuildResultV1(task_id: task.id, attempt: task.attempt, identity_digest: builder_task_identity_v1(task), host_id: host, status: status, exit_code: code, outputs: [], cache_hits: -1, cache_misses: -1, cache_stores: -1)

fn builder_cli_readmit_failures_v1(state: BuildRunnerV1, config: BuilderCliV1,
        source_root: text, process: BuilderProcessPortV1,
        database: BuildRunnerDatabaseSessionV1?, scv: BuildRunnerScvSessionV1? = nil) -> i64:
    var admitted_failures = 0
    for index in 0..state.tasks.len():
        if state.statuses[index] == "UNRESOLVED": return -1
        if state.statuses[index] != "FAILED": continue
        val task = state.tasks[index]
        if not builder_cli_inputs_match_v1(task, source_root, scv): return -1
        val retained = match builder_read_result_v1(config.state + "/receipts/" + task.id + ".sdn"):
            Ok(value): value
            Err(_): return -1
        if builder_validate_result_v1(task, retained) != "": return -1
        var admitted_failure = false
        for host in state.run.hosts:
            if host.id != state.host_ids[index] or host.id != retained.host_id: continue
            val root = config.state + "/attempts/" + task.id + "/" + str(task.attempt) + "/" + host.id
            val attempt = BuilderAttemptV1(task_id: task.id, attempt: task.attempt,
                host: host, pid: 0, local_root: root, remote_root: "", error: "",
                identity_digest: builder_task_identity_v1(task), process: process)
            val failure_class = builder_failure_class_v1(retained.status,
                retained.exit_code, builder_transport_reaped_v1(attempt))
            if host.transport != "local" or
                    (failure_class != "compile-failure" and failure_class != "compiler-crash"): return -1
            val collected = match builder_transport_collect_v1(attempt):
                Ok(value): value
                Err(_): return -1
            if builder_encode_result_v1(collected) != builder_encode_result_v1(retained): return -1
            if val session = database:
                match session.record(task, retained, [], attempt):
                    Ok(_): pass
                    Err(_): return -1
            admitted_failure = true
        if not admitted_failure: return -1
        admitted_failures = admitted_failures + 1
    admitted_failures

fn builder_cli_run_locked_v1(run: BuildRunV1, config: BuilderCliV1, process: BuilderProcessPortV1,
        database: BuildRunnerDatabaseSessionV1?, scv: BuildRunnerScvSessionV1? = nil) -> i64:
    var state = build_runner_start(run)
    if state.error != "":
        print "builder: {state.error}"
        return 2
    var source_root = config.source_root
    if source_root == "": source_root = cwd()
    val output_root = if config.output_root == "": source_root else: config.output_root
    val journal = config.state + "/journal.sdn"
    if file_exists(journal):
        match build_runner_decode_v1(run, file_read(journal)):
            case Ok(restored): state = restored
            case Err(message):
                print "builder: cannot resume: {message}"
                return 2
    if not dir_create_all(config.state + "/receipts"):
        print "builder: cannot create receipt directory"
        return 2
    var active: [BuilderAttemptV1] = []
    var unknown: [BuilderAttemptV1] = []
    var reused = 0
    var prune_failed = false
    # Revalidate every available completed dependency before attaching an
    # interrupted live descendant. This loop is bounded by the DAG size.
    var cache_changed = true
    var cache_round = 0
    while cache_changed and cache_round < state.tasks.len():
        cache_changed = false
        cache_round = cache_round + 1
        for index in 0..state.tasks.len():
            if state.statuses[index] == "PENDING" and build_runner_dependencies_ready(state, index):
                val task = state.tasks[index]
                val path = config.state + "/receipts/" + task.id + ".sdn"
                if file_exists(path) and builder_cli_inputs_match_v1(task, source_root, scv):
                    match builder_read_result_v1(path):
                        case Ok(cached):
                            if cached.status == "OK" and builder_validate_result_v1(task, cached) == "":
                                var observed = builder_cli_hash_outputs_v1(task, output_root, process)
                                if build_runner_output_error(task, cached, observed) != "":
                                    if builder_cli_restore_v1(task, cached, run, config.state,
                                            source_root, output_root, process, scv):
                                        observed = builder_cli_hash_outputs_v1(task, output_root, process)
                                        print "builder: {task.id} restored=verified-artifact"
                                if build_runner_output_error(task, cached, observed) == "":
                                    state = build_runner_resume(state, cached, observed)
                                    if val session = database:
                                        match session.record_cached(run, task, cached, observed, process):
                                            Ok(_): pass
                                            Err(reason): state.error = reason
                                    val prune_error = if state.error == "":
                                        builder_cli_prune_success_v1(task, cached, run, config.state, source_root, output_root, process)
                                    else: ""
                                    if prune_error != "":
                                        prune_failed = true
                                        print "builder: {task.id} terminal input cleanup failed: {prune_error}"
                                    reused = reused + 1
                                    cache_changed = true
                        case Err(_): ()
    for index in 0..state.tasks.len():
        if state.statuses[index] == "RUNNING":
            val task = state.tasks[index]
            for host in run.hosts:
                if host.id == state.host_ids[index]:
                    match builder_transport_recover_v1(task, host, config.state, process):
                        case Ok(attempt): active = active.push(attempt)
                        case Err(message):
                            # Earlier recovery already acquired worker authority.
                            # Request its bounded cleanup before dropping local
                            # handles; the unchanged journal retains every lease
                            # when this or the unresolved worker needs recovery.
                            val cleaned = builder_cli_cancel_v1(active)
                            print "builder: live attempt recovery remains unresolved: {message}; recovered cleanup={cleaned}"
                            return 2
            if not build_runner_dependencies_ready(state, index) or not builder_cli_inputs_match_v1(task, source_root, scv):
                val cleaned = builder_cli_cancel_v1(active)
                print "builder: recovered task has unverified dependencies; cleanup={cleaned}"
                return 2
    if not builder_cli_persist_v1(state, config.state):
        val cleaned = builder_cli_cancel_v1(active)
        print "builder: recovery journal write failed; cleanup={cleaned}"
        return 2
    # Recover owned live attempts first so an invalid retained failure can
    # cancel them. No new task may launch until this replay gate succeeds.
    if builder_cli_readmit_failures_v1(state, config, source_root, process, database, scv) < 0:
        val cleaned = builder_cli_cancel_v1(active)
        print "builder: retained failure authority invalid; cleanup={cleaned}"
        return 2
    while not build_runner_done(state):
        if file_exists(config.state + "/cancel.request"):
            val cleaned = builder_cli_cancel_v1(active)
            val unknown_cleaned = builder_cli_cancel_v1(unknown)
            print "builder: cancelled; worker cleanup confirmed={cleaned}; unknown cleanup={unknown_cleaned}"
            return 130
        var changed = false
        # Manifest order gives deterministic commit ordering for this poll batch.
        var remaining: [BuilderAttemptV1] = []
        for attempt in active:
            val exit_code = builder_transport_poll_v1(attempt)
            if exit_code == -2:
                remaining = remaining.push(attempt)
            elif exit_code == -1:
                # Observation failure is NOT proof of process death.
                # Retain the reserved RUNNING slot but stop polling this handle
                # repeatedly. Independent tasks may use other available slots.
                unknown = unknown.push(attempt)
                state.error = "worker observation authority unresolved"
                print "builder: {attempt.task_id} observation unresolved; retaining owned attempt"
            else:
                state = build_runner_reap(state, attempt.task_id, attempt.attempt)
                var index = 0
                while index < state.tasks.len() and state.tasks[index].id != attempt.task_id:
                    index = index + 1
                if index >= state.tasks.len():
                    state.error = "transport returned unknown task"
                else:
                    val task = state.tasks[index]
                    var receipt = builder_cli_failure_v1(task, attempt.host.id, "CRASHED", exit_code)
                    var collected_ok = false
                    match builder_transport_collect_v1(attempt):
                        case Ok(collected):
                            receipt = collected
                            collected_ok = true
                        case Err(message):
                            # A transport/receipt fetch error is not compiler
                            # failure. Preserve this attempt for later recovery.
                            state = build_runner_unresolved(state, task.id, task.attempt)
                            unknown = unknown.push(attempt)
                            state.error = "worker result collection authority unresolved"
                            print "builder: {task.id} result collection unresolved: {message}"
                    if collected_ok:
                        if not builder_cli_inputs_match_v1(task, source_root, scv):
                            state.error = "producer/input changed during execution of " + task.id
                        val observed = builder_cli_hash_outputs_v1(task,
                            attempt.local_root + "/work", process)
                        state = build_runner_accept(state, receipt, observed)
                        if state.error == "" and receipt.status == "OK":
                            if not builder_cli_publish_v1(task, receipt, attempt.local_root,
                                    output_root, process):
                                state.error = "cannot publish verified task output"
                        if state.error == "" and not builder_write_result_v1(config.state + "/receipts/" + task.id + ".sdn", receipt):
                            state.error = "cannot persist admitted result"
                        if state.error == "" and builder_failure_class_v1(receipt.status,
                                receipt.exit_code, builder_transport_reaped_v1(attempt)) == "infrastructure-abort":
                            state.error = "worker admission, resource or containment failure for " + task.id
                        if state.error == "":
                            if val session = database:
                                match session.record(task, receipt, observed, attempt):
                                    Ok(_): pass
                                    Err(reason): state.error = reason
                        if state.error == "" and receipt.status == "OK":
                            val prune_error = builder_cli_prune_success_v1(task, receipt,
                                run, config.state, source_root, output_root, process)
                            if prune_error != "":
                                prune_failed = true
                                print "builder: {task.id} terminal input cleanup failed: {prune_error}"
                        if state.error == "" and receipt.status != "OK":
                            val prune_error = builder_cli_prune_failure_v1(task, receipt,
                                run, config.state, source_root, output_root, process)
                            if prune_error != "":
                                prune_failed = true
                                print "builder: {task.id} failed input cleanup deferred: {prune_error}"
                        if state.error == "":
                            print "builder: {attempt.task_id} attempt={attempt.attempt} status={receipt.status}"
                changed = true
        active = remaining
        if state.error != "":
            val cleaned = builder_cli_cancel_v1(active)
            val unknown_cleaned = builder_cli_cancel_v1(unknown)
            val saved = builder_cli_persist_v1(state, config.state)
            print "builder: {state.error}; cleanup={cleaned}; unknown cleanup={unknown_cleaned}; journal={saved}"
            return 2
        # Dispatch only after dependencies have been admitted and published.
        for index in build_runner_ready(state):
            val task = state.tasks[index]
            val input_error = builder_cli_input_error_v1(task, source_root, scv)
            if input_error != "":
                state.error = "producer/input digest mismatch for " + task.id + ": " + input_error
                break
            val cached_path = config.state + "/receipts/" + task.id + ".sdn"
            var cache_hit = false
            if file_exists(cached_path):
                match builder_read_result_v1(cached_path):
                    case Ok(cached):
                        val observed = builder_cli_hash_outputs_v1(task, output_root, process)
                        if cached.status == "OK" and builder_validate_result_v1(task, cached) == "" and build_runner_output_error(task, cached, observed) == "":
                            state = build_runner_resume(state, cached, observed)
                            if val session = database:
                                match session.record_cached(run, task, cached, observed, process):
                                    Ok(_): pass
                                    Err(reason): state.error = reason
                            val prune_error = if state.error == "":
                                builder_cli_prune_success_v1(task, cached, run, config.state, source_root, output_root, process)
                            else: ""
                            if prune_error != "":
                                prune_failed = true
                                print "builder: {task.id} terminal input cleanup failed: {prune_error}"
                            cache_hit = true
                            reused = reused + 1
                            changed = true
                            print "builder: {task.id} cache=verified-hit"
                    case Err(message):
                        print "builder: {task.id} cache=miss reason={message}"
            if state.error != "": break
            if not cache_hit:
                for host in run.hosts:
                    if build_runner_host_slots(state, host.id) > 0:
                        state = build_runner_dispatch(state, index, host.id)
                        # Journal BEFORE spawning. An interrupted dispatch is
                        # never silently retried without process ownership.
                        if not builder_cli_persist_v1(state, config.state):
                            state.error = "cannot persist dispatch intent"
                            break
                        val attempt = builder_transport_start_v1(task, host, source_root, config.state, process,
                            build_runner_scv_source_root_v1(scv), build_runner_scv_source_paths_v1(scv, task))
                        if file_exists(config.state + "/cancel.request"):
                            if attempt.pid > 0: active = active.push(attempt)
                            val cleaned = builder_cli_cancel_v1(active)
                            val unknown_cleaned = builder_cli_cancel_v1(unknown)
                            print "builder: cancelled during dispatch; worker cleanup confirmed={cleaned}; unknown cleanup={unknown_cleaned}"
                            return 130
                        if attempt.error != "":
                            # Transport must guarantee no live process on a
                            # failed start; otherwise it returns a live handle.
                            state = build_runner_reap(state, task.id, task.attempt)
                            val failed = builder_cli_failure_v1(task, host.id, "ERROR", 1)
                            state = build_runner_accept(state, failed, [])
                            if state.error == "" and not builder_write_result_v1(config.state + "/receipts/" + task.id + ".sdn", failed):
                                state.error = "cannot persist launch failure"
                            print "builder: {task.id} launch failed: {attempt.error}"
                            state.error = "transport launch failed for " + task.id + ": " + attempt.error
                        else:
                            active = active.push(attempt)
                            print "builder: {task.id} dispatched host={host.id} attempt={task.attempt}"
                        changed = true
                        break
            if state.error != "": break
        if state.error != "":
            val cleaned = builder_cli_cancel_v1(active)
            val saved = builder_cli_persist_v1(state, config.state)
            print "builder: {state.error}; cleanup={cleaned}; journal={saved}"
            return 2
        if changed and not builder_cli_persist_v1(state, config.state):
            val cleaned = builder_cli_cancel_v1(active)
            print "builder: journal write failed; cleanup={cleaned}"
            return 2
        if active.len() == 0 and not changed and not build_runner_done(state):
            print "builder: no further runnable work; unresolved owned attempts={unknown.len()}"
            return 2
        if active.len() > 0: sleep_ms(100)
    val succeeded = build_runner_succeeded(state)
    print "builder: completed success={succeeded} verified_cache_hits={reused}"
    if prune_failed: return 2
    if succeeded:
        if val session = database:
            if session.settle(state).is_err(): return 2
        return 0
    # Recheck the actual terminal evidence before exit 1 permits continuation.
    val admitted_failures = builder_cli_readmit_failures_v1(state, config, source_root, process, database, scv)
    if admitted_failures <= 0: return 2
    if val session = database:
        if session.settle(state).is_err(): return 2
    1

fn builder_cli_run_v1(run: BuildRunV1, config: BuilderCliV1, process: BuilderProcessPortV1,
        scv_plan: text = "") -> i64:
    val resolved = match builder_cli_resolve_roots_v1(config, process):
        case Ok(value): value
        case Err(message):
            print "builder: {message}"
            return 2
    if not dir_create_all(resolved.state):
        print "builder: cannot create state directory"
        return 2
    # Kernel-owned lock is released on crash; never delete/recreate its inode.
    val lock = file_lock(resolved.state + "/manager.lock", 1)
    if lock < 0:
        print "builder: another manager owns this state directory"
        return 2
    val source_root = if resolved.source_root == "": cwd() else: resolved.source_root
    val scv = match build_runner_scv_session_open_v1(run, resolved, scv_plan, false):
        case Ok(value): value
        case Err(reason):
            print "buildrunner: SCV source session refused: {reason}"
            file_unlock(lock)
            return 2
    val database = match build_runner_database_session_open_v1(run, resolved.state, source_root):
        Ok(value): value
        Err(reason):
            print "buildrunner: task database open failed: {reason}"
            file_unlock(lock)
            return 2
    var code = builder_cli_run_locked_v1(run, resolved, process, database, scv)
    if val session = database:
        # Only ordinary terminal returns prove that no unknown live trees remain.
        # Infrastructure/cancellation retain the lease for supervised recovery.
        if code == 0 or code == 1:
            match session.finish():
                Ok(revision): print "buildrunner: task database revision={revision}"
                Err(reason):
                    print "buildrunner: task database finalization failed: {reason}"
                    code = 2
    file_unlock(lock)
    code

# Read-only post-run admission. A published file alone is insufficient: each
# task must have a matching completed journal row, immutable result receipt,
# exact tree-reap proof, and the same verified output inside the attempt.
# Read-only settlement proof for an unsuccessful dependency task. This never
# certifies compiler content, output usability, or successful package/index work.
fn build_runner_verify_settled_v1(run: BuildRunV1, config: BuilderCliV1,
        process: BuilderProcessPortV1, scv_plan: text = "") -> i64:
    val resolved = match builder_cli_resolve_roots_v1(config, process):
        Ok(value): value
        Err(_): return 2
    val lock = file_lock(resolved.state + "/manager.lock", 1)
    if lock < 0: return 2
    val scv = match build_runner_scv_session_open_v1(run, resolved, scv_plan, true):
        case Ok(value): value
        case Err(_):
            file_unlock(lock)
            return 2
    val code = builder_cli_verify_settled_locked_v1(run, resolved, process, scv)
    file_unlock(lock)
    code

fn builder_cli_verify_settled_locked_v1(run: BuildRunV1, resolved: BuilderCliV1,
        process: BuilderProcessPortV1, scv: BuildRunnerScvSessionV1? = nil) -> i64:
    val journal = match file_read_regular_no_follow_bounded(resolved.state + "/journal.sdn", 16777216):
        Ok(value): value
        Err(_): return 2
    val state = match build_runner_decode_v1(run, journal):
        Ok(value): value
        Err(_): return 2
    if file_exists(resolved.state + "/cancel.request"): return 2
    val journal_rows = journal.split("\n")
    for index in 0..state.tasks.len():
        val task = state.tasks[index]
        # Decode deliberately normalizes UNRESOLVED to RUNNING for recovery.
        # Settlement queries must preserve the original refusal boundary.
        val recorded_status = journal_rows[index + 1].split("\t")[2]
        if recorded_status != "FAILED" and recorded_status != "SUCCEEDED": return 2
        if not builder_cli_inputs_match_v1(task, resolved.source_root, scv): return 2
        val retained = match builder_read_result_v1(resolved.state + "/receipts/" + task.id + ".sdn"):
            Ok(value): value
            Err(_): return 2
        if builder_validate_result_v1(task, retained) != "" or
                retained.host_id != state.host_ids[index] or
                retained.status == "TIMEOUT" or retained.exit_code == 124 or retained.exit_code == 125:
            return 2
        var found = false
        for host in run.hosts:
            if host.id != retained.host_id: continue
            if host.transport != "local": return 2
            val root = resolved.state + "/attempts/" + task.id + "/" + str(task.attempt) + "/" + host.id
            val attempt = BuilderAttemptV1(task_id: task.id, attempt: task.attempt,
                host: host, pid: 0, local_root: root, remote_root: "", error: "",
                identity_digest: builder_task_identity_v1(task), process: process)
            # A not-started receipt is not evidence of a settled index run.
            if not builder_transport_reaped_v1(attempt): return 2
            val collected = match builder_transport_collect_v1(attempt):
                Ok(value): value
                Err(_): return 2
            if builder_encode_result_v1(collected) != builder_encode_result_v1(retained): return 2
            found = true
        if not found: return 2
    val current = match file_read_regular_no_follow_bounded(resolved.state + "/journal.sdn", 16777216):
        Ok(value): value
        Err(_): return 2
    if current != journal or file_exists(resolved.state + "/cancel.request"): return 2
    print "builder: settled tasks={state.tasks.len()}; output qualification not asserted"
    0
fn builder_cli_verify_v1(run: BuildRunV1, config: BuilderCliV1, process: BuilderProcessPortV1,
        scv_plan: text = "") -> i64:
    val resolved = match builder_cli_resolve_roots_v1(config, process):
        case Ok(value): value
        case Err(message):
            print "builder: {message}"
            return 2
    val lock = file_lock(resolved.state + "/manager.lock", 1)
    if lock < 0: return 2
    val scv = match build_runner_scv_session_open_v1(run, resolved, scv_plan, true):
        case Ok(value): value
        case Err(_):
            file_unlock(lock)
            return 2
    val code = builder_cli_verify_locked_v1(run, resolved, process, scv)
    file_unlock(lock)
    code

fn builder_cli_verify_locked_v1(run: BuildRunV1, resolved: BuilderCliV1,
        process: BuilderProcessPortV1, scv: BuildRunnerScvSessionV1? = nil) -> i64:
    val journal = match file_read_regular_no_follow_bounded(resolved.state + "/journal.sdn", 16777216):
        case Ok(value): value
        case Err(message):
            print "builder: journal unavailable: {message}"
            return 2
    val state = match build_runner_decode_v1(run, journal):
        case Ok(value): value
        case Err(message):
            print "builder: journal invalid: {message}"
            return 2
    val lines = journal.split("\n")
    for index in 0..state.tasks.len():
        val task = state.tasks[index]
        val fields = lines[index + 1].split("\t")
        if fields[2] != "SUCCEEDED":
            print "builder: task is not completed: {task.id}"
            return 1
        val input_error = builder_cli_input_error_v1(task, resolved.source_root, scv)
        if input_error != "":
            print "builder: source input differs: {task.id}: {input_error}"
            return 1
        val cached = match builder_read_result_v1(resolved.state + "/receipts/" + task.id + ".sdn"):
            case Ok(value): value
            case Err(message):
                print "builder: task receipt unavailable: {task.id}: {message}"
                return 1
        if cached.status != "OK" or cached.host_id != state.host_ids[index] or
                builder_validate_result_v1(task, cached) != "":
            print "builder: task receipt is not admitted: {task.id}"
            return 1
        var host_found = false
        for host in run.hosts:
            if host.id == cached.host_id:
                host_found = true
                if host.transport != "local":
                    print "builder: verify requires a local retained attempt: {task.id}"
                    return 2
                val attempt_root = resolved.state + "/attempts/" + task.id + "/" +
                    str(task.attempt) + "/" + host.id
                val attempt = BuilderAttemptV1(task_id: task.id, attempt: task.attempt,
                    host: host, pid: 0, local_root: attempt_root, remote_root: "", error: "",
                    identity_digest: builder_task_identity_v1(task), process: process)
                if not builder_transport_reaped_v1(attempt):
                    print "builder: exact terminal proof unavailable: {task.id}"
                    return 1
                val collected = match builder_transport_collect_v1(attempt):
                    case Ok(value): value
                    case Err(message):
                        print "builder: attempt result unavailable: {task.id}: {message}"
                        return 1
                if builder_encode_result_v1(collected) != builder_encode_result_v1(cached):
                    print "builder: attempt and published result differ: {task.id}"
                    return 1
        if not host_found:
            print "builder: task host is unknown: {task.id}"
            return 1
        val observed = builder_cli_hash_outputs_v1(task, resolved.output_root, process)
        if build_runner_output_error(task, cached, observed) != "":
            print "builder: published output differs: {task.id}"
            return 1
    print "builder: verified tasks={state.tasks.len()}"
    0

fn build_runner_cli_main_v1(process: BuilderProcessPortV1,
        phase_capacity: NativeGroupedCapacityV1? = nil) -> i64:
    # Compiled native application argv; avoid the general CLI command facade,
    # which links unrelated compiler/formatter command providers into this tool.
    val raw_args = get_args()
    var args: [text] = []
    for index in 1..raw_args.len():
        args = args.push(raw_args[index])
    if args.len() > 0 and (args[0] == "managed-phases" or args[0] == "managed-phases-verify" or args[0] == "managed-tasks" or args[0] == "managed-tasks-verify" or args[0] == "managed-tasks-phase1-barrier" or args[0] == "managed-tasks-next-producer" or args[0] == "managed-tasks-next-hello"):
        if phase_capacity == nil:
            print "builder: composed phase capacity authority is unavailable"
            return 2
        return managed_phase_cli_v1(args, process, phase_capacity!)
    if args.len() == 1 and args[0] == "task-environment-digest":
        match builder_worker_environment_digest_v1():
            Ok(digest):
                print digest
                return 0
            Err(reason):
                print "buildrunner: {reason}"
                return 2
    val scv_options = match build_runner_scv_options_v1(args):
        case Ok(value): value
        case Err(reason):
            print "buildrunner: {reason}"
            return 2
    val config = builder_cli_parse_v1(scv_options.args)
    if config.error != "":
        print "builder: {config.error}"
        return 2
    if config.command == "--help" or config.command == "-h":
        print "buildrunner run --manifest FILE --state DIR [--source-root DIR] [--output-root DIR]"
        print "buildrunner verify --manifest FILE --state DIR [--source-root DIR] [--output-root DIR]"
        print "buildrunner verify-settled --manifest FILE --state DIR [--source-root DIR] [--output-root DIR]"
        print "source snapshot opt-in for run/verify/verify-settled: --scv-session FILE"
        print "buildrunner check --manifest FILE"
        print "buildrunner worker --request FILE --attempt-root DIR --host ID"
        return 0
    if config.command == "worker":
        return builder_worker_execute_v1(config.request, config.attempt_root, config.host)
    match builder_read_run_v1(config.manifest):
        case Err(message):
            print "builder: {message}"
            return 2
        case Ok(run):
            if config.command == "check":
                print "builder: manifest valid tasks={run.tasks.len()} hosts={run.hosts.len()}"
                return 0
            if config.command == "verify": return builder_cli_verify_v1(run, config, process, scv_options.session_file)
            if config.command == "verify-settled": return build_runner_verify_settled_v1(run, config, process, scv_options.session_file)
            return builder_cli_run_v1(run, config, process, scv_options.session_file)

export build_runner_cli_main_v1
export build_runner_verify_settled_v1

export builder_cli_run_locked_v1
