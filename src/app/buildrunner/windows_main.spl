# Explicit Windows process ownership; no cfg-dependent import discovery needed.
use app.buildrunner.cli.{build_runner_cli_main_v1}
use app.bootstrap_builder.process_port_windows.{builder_process_windows_v1}
use app.bootstrap_builder.grouped_native_run.{NativeGroupedCapacityV1}
use app.bootstrap_builder.native_group_windows_main.{native_group_windows_capacity_v1}

fn build_runner_windows_main_v1() -> i64:
    build_runner_cli_main_v1(builder_process_windows_v1(),
        Some(NativeGroupedCapacityV1(native_group_windows_capacity_v1)))

fn main() -> i64:
    build_runner_windows_main_v1()

export build_runner_windows_main_v1
