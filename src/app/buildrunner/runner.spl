# Canonical build adapter over the shared parent-owned task scheduler.
export use std.common.task_runner.scheduler.{
    TaskRunnerV1 as BuildRunnerV1,
    task_runner_start as build_runner_start,
    task_runner_task_index as build_runner_task_index,
    task_runner_host_slots as build_runner_host_slots,
    task_runner_dependencies_ready as build_runner_dependencies_ready,
    task_runner_ready as build_runner_ready,
    task_runner_dispatch as build_runner_dispatch,
    task_runner_cache_ready as build_runner_cache_ready,
    task_runner_reap as build_runner_reap,
    task_runner_accept as build_runner_accept,
    task_runner_resume as build_runner_resume,
    task_runner_unresolved as build_runner_unresolved,
    task_runner_done as build_runner_done,
    task_runner_succeeded as build_runner_succeeded,
    task_runner_output_error as build_runner_output_error,
    task_runner_encode_v1 as build_runner_encode_v1,
    task_runner_decode_v1 as build_runner_decode_v1
}
