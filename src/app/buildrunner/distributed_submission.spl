# Internal service admission; authenticated authority/observations arrive from host facets.
# This facade never spawns a worker or treats a duplicate as permission to retry.
use std.common.build_manager.contracts.{BuildTaskV1, BuildHostV1}
use std.common.contracts.distributed_control_v2.*
use std.common.contracts.distributed_control_codec_v2.distributed_encode_operation_v2
use std.common.contracts.distributed_operation_state_v2.{distributed_operation_initial_v2,
    distributed_operation_duplicate_v2, distributed_operation_transition_v2}
use std.common.task_runner.distributed_operation_journal_v2.{DistributedOperationJournalV2,
    distributed_operation_journal_lookup_v2, distributed_operation_journal_commit_v2}
use app.buildrunner.distributed_admission.distributed_build_admission_v2

# Capsule-private owner token; never expose this record through a client wire codec.
struct ManagedBuildAdmissionV2:
    journal: DistributedOperationJournalV2
    disposition: text
    state: text
    outcome_digest: text

fn distributed_build_submit_v2(owner: DistributedOperationJournalV2,
        grant: ExecutionGrantV2, request: OperationEnvelopeV2, task: BuildTaskV1,
        host: BuildHostV1, requested: ExecutionEnvironmentV2, observed: ExecutionEnvironmentV2,
        now: i64, policy_revision: i64, revocation_epoch: i64,
        session_generation: i64) -> Result<ManagedBuildAdmissionV2, text>:
    # Reauthorization precedes both first admission and retained-state disclosure.
    val reason = distributed_build_admission_v2(grant, request, task, host, requested,
        observed, now, policy_revision, revocation_epoch, session_generation)
    if reason != "": return Err(reason)
    val envelope = distributed_encode_operation_v2(request)?
    match distributed_operation_journal_lookup_v2(owner, request.id):
        case Ok(prior):
            val disposition = distributed_operation_duplicate_v2(prior, envelope)
            if disposition == "OPERATION_PAYLOAD_MISMATCH" or disposition == "OPERATION_STATE_INVALID":
                return Err(disposition)
            return Ok(ManagedBuildAdmissionV2(owner, disposition, prior.state, prior.outcome_digest))
        case Err(error):
            if error != "OPERATION_NOT_FOUND": return Err(error)
    val initial = distributed_operation_initial_v2(envelope)?
    # WAL CURRENT publication occurs before returning a newly admitted request.
    val committed = distributed_operation_journal_commit_v2(owner, initial)?
    Ok(ManagedBuildAdmissionV2(committed, "NEWLY_ADMITTED", initial.state, ""))

# Command owner calls this immediately before dispatch. Admission alone is not
# an execution claim; changed/expired authority must not start a queued task.
fn distributed_build_begin_v2(owner: DistributedOperationJournalV2,
        grant: ExecutionGrantV2, request: OperationEnvelopeV2, task: BuildTaskV1,
        host: BuildHostV1, requested: ExecutionEnvironmentV2, observed: ExecutionEnvironmentV2,
        now: i64, policy_revision: i64, revocation_epoch: i64,
        session_generation: i64) -> Result<DistributedOperationJournalV2, text>:
    val reason = distributed_build_admission_v2(grant, request, task, host, requested,
        observed, now, policy_revision, revocation_epoch, session_generation)
    if reason != "": return Err(reason)
    val envelope = distributed_encode_operation_v2(request)?
    val prior = distributed_operation_journal_lookup_v2(owner, request.id)?
    val disposition = distributed_operation_duplicate_v2(prior, envelope)
    if disposition != "ALREADY_ADMITTED": return Err(disposition)
    val executing = distributed_operation_transition_v2(prior, "executing", "")?
    distributed_operation_journal_commit_v2(owner, executing)
