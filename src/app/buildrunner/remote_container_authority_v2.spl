# The shared remote-container completion AUTHORITY body (milestone_0030 13.1): grant+approval, execution-host key,
# separate roles, operation, task, resources, host, operation id, assignment, authorization digests and time. It is used
# by the V3 completion verify (remote_container_authority_v3) and the Host-signed reset-failure receipt verify
# (remote_container_reset_failure_signed_v3). milestone_0060: the V2 completion record, its codec and its verify were
# retired with the rest of the V2 remote-container path; only this body (and its V2 type names) remains.
use std.common.build_manager.contracts.{BuildTaskV1, builder_task_identity_v1, builder_validate_task_v1}
use std.common.build_manager.codec.builder_encode_task_v1
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2,
    DistributedSignedApprovalV2}
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2,
    distributed_grant_digest_v2}
use app.llm_caret.workbench.distributed_grant_verification_v2.{DistributedAuthorityKeyV2,
    distributed_authority_key_check_v2, distributed_verify_grant_approval_v2}
use std.common.crypto.sha256.sha256_text

# Same checks in the same order as when this body was extracted from the V2 verify.
struct RemoteContainerAuthorityClaimV2:
    task_identity: text
    host_id: text
    assignment_digest: text
    controller_epoch: i64
    operation_id: text
    request_digest: text
    grant_digest: text
    signer_id: text
    key_revision: i64
    completed_at: i64

struct RemoteContainerAuthorityExpectedV2:
    task_identity: text
    host_id: text
    assignment_digest: text
    controller_epoch: i64
    operation_id: text

fn remote_container_completion_authority_v2(claim: RemoteContainerAuthorityClaimV2,
        signed: DistributedSignedGrantV2, approval: DistributedSignedApprovalV2,
        issuer: DistributedAuthorityKeyV2, approver: DistributedAuthorityKeyV2,
        host_key: DistributedAuthorityKeyV2, request: OperationEnvelopeV2,
        task: BuildTaskV1, expected: RemoteContainerAuthorityExpectedV2, now: i64,
        policy_revision: i64, revocation_epoch: i64, session_generation: i64) -> Result<bool, text>:
    val grant = distributed_verify_grant_approval_v2(signed, approval, issuer, approver,
        request, now, policy_revision, revocation_epoch, session_generation)?
    val host_error = distributed_authority_key_check_v2(host_key, "execution-host",
        claim.signer_id, claim.key_revision, grant, now, policy_revision, revocation_epoch)
    if host_error != "": return Err(host_error)
    if host_key.public_key == issuer.public_key or host_key.public_key == approver.public_key:
        return Err("CONTAINER_COMPLETION_ROLES_NOT_SEPARATE")
    if request.operation != "build" and request.operation != "test":
        return Err("CONTAINER_COMPLETION_OPERATION_DENIED")
    if builder_validate_task_v1(task) != "": return Err("CONTAINER_COMPLETION_TASK_INVALID")
    if request.payload_digest != sha256_text(builder_encode_task_v1(task)) or
            claim.task_identity != builder_task_identity_v1(task) or claim.task_identity != expected.task_identity:
        return Err("CONTAINER_COMPLETION_TASK_MISMATCH")
    if task.timeout_ms != request.duration_ms or task.memory_limit_bytes != request.memory_bytes or
            task.memory_policy != "enforce": return Err("CONTAINER_COMPLETION_RESOURCE_MISMATCH")
    if claim.host_id != request.host_id or claim.host_id != expected.host_id:
        return Err("CONTAINER_COMPLETION_HOST_MISMATCH")
    if claim.operation_id != request.id or claim.operation_id != expected.operation_id:
        return Err("CONTAINER_COMPLETION_OPERATION_MISMATCH")
    if claim.assignment_digest != expected.assignment_digest or claim.controller_epoch != expected.controller_epoch:
        return Err("CONTAINER_COMPLETION_ASSIGNMENT_STALE")
    val request_wire = distributed_encode_operation_v2(request)?
    val grant_digest = distributed_grant_digest_v2(grant)?
    if claim.request_digest != sha256_text(request_wire) or claim.grant_digest != grant_digest:
        return Err("CONTAINER_COMPLETION_AUTHORIZATION_MISMATCH")
    if claim.completed_at > now or claim.completed_at >= grant.expires_at:
        return Err("CONTAINER_COMPLETION_TIME_INVALID")
    Ok(true)

export RemoteContainerAuthorityClaimV2, RemoteContainerAuthorityExpectedV2, remote_container_completion_authority_v2
