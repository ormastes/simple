# milestone_0030 DESIGN 13.5, completed by milestone_0038: the L6 reset-failure receipt under V3. A run a service restart
# lost, or whose teardown failed, is NOT a passed run: the operation is journaled `failed` bound to the receipt digest and a
# receipt can never yield `completed`. Stages and who builds them:
#   service-restart  the Host answers a reaped run with the error code `linux-host-remote-build-reaped-incomplete`; the
#                    CONTROLLER builds the receipt (reap `absent-run-lost`, empty native id and binding digest) from its OWN
#                    admitted task, policy and authority digests. Unsigned: the Host no longer holds the run.
#   destroy-absence  the HOST emits it: Destroy not ok after a normal exit (reap `incomplete`, native id set)
#   cancel-absence   the HOST emits it: a self-cancel's Destroy not ok after Create (reap `incomplete`, native id set)
#   cancel-identity  the HOST emits it: a self-cancel's stop/destroy not ok with no Create (reap `identity-unresolved`)
# milestone_0040 adds the other Host-observable wedge points (all HOST-emitted, same V3 wire, same signature domain):
#   prepare-wedge, create-wedge                       (reap `identity-unresolved`, no native id: no Create was accepted)
#   configuration-wedge, start-wedge, inspect-wedge   (reap `incomplete`, native id set)
#   stop-absence, cancel-stop-absence                 (Stop not ok with no cancel cause / after Create; `incomplete`, native id)
# The stage set is CLOSED: an unknown stage is refused, so an older controller refuses a newer Host's receipt and the run
# settles by the generic wedged verdict instead of being misread. Enable errors (no binding digest exists before a successful
# enable), settle/source-return/host-settle (retried, not wedges) and read/finalize (self-cancel causes) have no stage.
# A Host stage always carries `workspace_binding_digest`, the enable-time binding of the fresh epoch, and travels inside the
# execution-host-signed envelope of remote_container_reset_failure_signed_v3.spl; the unsigned receipt of such a stage is
# refused at accept. No PID, signal or synthetic tree-reap observation is carried.
use app.buildrunner.remote_evidence_v1.RemoteEvidencePolicyV1
use std.common.build_manager.contracts.{BuildTaskV1, builder_task_identity_v1, builder_identifier_valid_v1,
    builder_digest_valid_v1}
use std.common.build_manager.codec.builder_wire_line_v1
use std.common.crypto.sha256.sha256_text

struct RemoteContainerResetFailureV3:
    task_identity: text
    host_id: text
    assignment_digest: text
    controller_epoch: i64
    operation_id: text
    request_digest: text
    grant_digest: text
    workspace_binding_digest: text
    stage: text
    reason: text
    reap: text
    native_id: text

# The closed stage set: ONE table for reason, reap and runtime-id rule, so validate, the Host constructor and the encoder
# cannot drift. A stage outside it has no reason and is refused everywhere (an older controller refuses a newer Host's stage
# the same way, which falls back to the generic wedged settle).
fn remote_container_reset_reason_v3(stage: text) -> text:
    if stage == "destroy-absence": return "REMOTE_CONTAINER_ABSENCE_UNRESOLVED"
    if stage == "cancel-identity": return "REMOTE_CONTAINER_CANCEL_IDENTITY_UNRESOLVED"
    if stage == "cancel-absence": return "REMOTE_CONTAINER_CANCEL_ABSENCE_UNRESOLVED"
    if stage == "service-restart": return "REMOTE_CONTAINER_SERVICE_RESTART_RUN_LOST"
    if stage == "stop-absence": return "REMOTE_CONTAINER_STOP_ABSENCE_UNRESOLVED"
    if stage == "cancel-stop-absence": return "REMOTE_CONTAINER_CANCEL_STOP_ABSENCE_UNRESOLVED"
    if stage == "prepare-wedge": return "REMOTE_CONTAINER_PREPARE_WEDGED"
    if stage == "create-wedge": return "REMOTE_CONTAINER_CREATE_WEDGED"
    if stage == "configuration-wedge": return "REMOTE_CONTAINER_CONFIGURATION_WEDGED"
    if stage == "start-wedge": return "REMOTE_CONTAINER_START_WEDGED"
    if stage == "inspect-wedge": return "REMOTE_CONTAINER_INSPECT_WEDGED"
    ""

# A runtime id exists only where Create returned an identity; the pre-Create stages and the restart have none.
fn remote_container_reset_stage_has_native_v3(stage: text) -> bool:
    if stage == "service-restart" or stage == "cancel-identity" or stage == "prepare-wedge" or stage == "create-wedge":
        return false
    true

fn remote_container_reset_reap_v3(stage: text) -> text:
    if stage == "service-restart": return "absent-run-lost"
    if stage == "cancel-identity" or stage == "prepare-wedge" or stage == "create-wedge": return "identity-unresolved"
    "incomplete"

fn remote_container_reset_failure_validate_v3(receipt: RemoteContainerResetFailureV3) -> Result<(), text>:
    if not builder_digest_valid_v1(receipt.task_identity) or not builder_identifier_valid_v1(receipt.host_id) or
            not builder_digest_valid_v1(receipt.assignment_digest) or receipt.controller_epoch < 1 or
            not builder_identifier_valid_v1(receipt.operation_id) or
            not builder_digest_valid_v1(receipt.request_digest) or not builder_digest_valid_v1(receipt.grant_digest):
        return Err("REMOTE_RESET_FAILURE_IDENTITY_INVALID")
    val expected = remote_container_reset_reason_v3(receipt.stage)
    if expected == "" or receipt.reason != expected: return Err("REMOTE_RESET_FAILURE_STAGE_INVALID")
    val restart = receipt.stage == "service-restart"
    if restart:
        if receipt.workspace_binding_digest != "": return Err("REMOTE_RESET_FAILURE_IDENTITY_INVALID")
    elif not builder_digest_valid_v1(receipt.workspace_binding_digest):
        return Err("REMOTE_RESET_FAILURE_IDENTITY_INVALID")
    if remote_container_reset_stage_has_native_v3(receipt.stage):
        if not builder_digest_valid_v1(receipt.native_id): return Err("REMOTE_RESET_FAILURE_RUNTIME_INVALID")
    elif receipt.native_id != "":
        return Err("REMOTE_RESET_FAILURE_RUNTIME_INVALID")
    if receipt.reap != remote_container_reset_reap_v3(receipt.stage): return Err("REMOTE_RESET_FAILURE_REAP_INVALID")
    Ok(())

# Constructed only from the admitted task/policy and the controller's own operation/grant digests, never from arriving
# claims: the service-restart receipt, with an empty runtime identity and an empty workspace binding.
fn remote_container_reset_failure_new_v3(task: BuildTaskV1, policy: RemoteEvidencePolicyV1, request_digest: text,
        grant_digest: text) -> Result<RemoteContainerResetFailureV3, text>:
    val receipt = RemoteContainerResetFailureV3(task_identity: builder_task_identity_v1(task), host_id: policy.host_id,
        assignment_digest: policy.assignment_digest, controller_epoch: policy.controller_epoch,
        operation_id: policy.operation_id, request_digest: request_digest, grant_digest: grant_digest,
        workspace_binding_digest: "", stage: "service-restart", reason: "REMOTE_CONTAINER_SERVICE_RESTART_RUN_LOST",
        reap: "absent-run-lost", native_id: "")
    remote_container_reset_failure_validate_v3(receipt)?
    Ok(receipt)

# The Host's constructor (called by the Host port from its verified open record and its own observations): a Host stage
# only, with the enable-time binding digest and the runtime id Create returned (empty for cancel-identity).
fn remote_container_reset_failure_host_new_v3(task: BuildTaskV1, policy: RemoteEvidencePolicyV1, request_digest: text,
        grant_digest: text, workspace_binding_digest: text, stage: text,
        native_id: text) -> Result<RemoteContainerResetFailureV3, text>:
    if stage == "service-restart": return Err("REMOTE_RESET_FAILURE_STAGE_INVALID")
    val receipt = RemoteContainerResetFailureV3(task_identity: builder_task_identity_v1(task), host_id: policy.host_id,
        assignment_digest: policy.assignment_digest, controller_epoch: policy.controller_epoch,
        operation_id: policy.operation_id, request_digest: request_digest, grant_digest: grant_digest,
        workspace_binding_digest: workspace_binding_digest, stage: stage, reason: remote_container_reset_reason_v3(stage),
        reap: remote_container_reset_reap_v3(stage), native_id: native_id)
    remote_container_reset_failure_validate_v3(receipt)?
    Ok(receipt)

fn remote_container_reset_failure_encode_v3(receipt: RemoteContainerResetFailureV3) -> Result<text, text>:
    remote_container_reset_failure_validate_v3(receipt)?
    var wire = builder_wire_line_v1("SIMPLE-REMOTE-RESET-FAILURE-3")
    for field in [receipt.task_identity, receipt.host_id, receipt.assignment_digest, str(receipt.controller_epoch),
            receipt.operation_id, receipt.request_digest, receipt.grant_digest, receipt.workspace_binding_digest,
            receipt.stage, receipt.reason, receipt.reap, receipt.native_id]:
        wire = wire + builder_wire_line_v1(field)
    Ok(wire)

fn remote_container_reset_failure_digest_v3(receipt: RemoteContainerResetFailureV3) -> Result<text, text>:
    Ok(sha256_text(remote_container_reset_failure_encode_v3(receipt)?))

# The parent compares the receipt to its own admitted task, policy and the currently verified operation/grant
# digests before anything is journaled. The binding digest is host-attested (the controller cannot know it).
fn remote_container_reset_failure_bind_v3(task: BuildTaskV1, policy: RemoteEvidencePolicyV1,
        receipt: RemoteContainerResetFailureV3, request_digest: text, grant_digest: text) -> Result<(), text>:
    remote_container_reset_failure_validate_v3(receipt)?
    if receipt.task_identity != builder_task_identity_v1(task) or receipt.host_id != policy.host_id or
            receipt.assignment_digest != policy.assignment_digest or
            receipt.controller_epoch != policy.controller_epoch or receipt.operation_id != policy.operation_id:
        return Err("REMOTE_RESET_FAILURE_BINDING_DIFFERS")
    if receipt.request_digest != request_digest or receipt.grant_digest != grant_digest:
        return Err("REMOTE_RESET_FAILURE_AUTHORITY_DIFFERS")
    Ok(())

# Controller result of accept_reset_failure_v3: always an ERROR outcome bound to the receipt digest.
struct RemoteResetFailedResultV3:
    status: text
    stage: text
    reason: text
    reap: text
    root: text
    digest: text

export RemoteContainerResetFailureV3, RemoteResetFailedResultV3
export remote_container_reset_failure_new_v3, remote_container_reset_failure_host_new_v3, remote_container_reset_failure_encode_v3
export remote_container_reset_failure_digest_v3
export remote_container_reset_failure_bind_v3, remote_container_reset_failure_validate_v3
