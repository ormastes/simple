"""Optional SCV argv seam; legacy BuilderCliV1 and worker protocol stay intact."""
pub struct BuildRunnerScvOptionsV1:
    args: [text]
    session_file: text

pub fn build_runner_scv_options_v1(args: [text]) -> Result<BuildRunnerScvOptionsV1, text>:
    var ordinary: [text] = []
    var session = ""
    var index = 0
    while index < args.len():
        if args[index] == "--scv-session":
            if session != "": return Err("duplicate --scv-session")
            if index + 1 >= args.len() or args[index + 1] == "" or args[index + 1].starts_with("--"):
                return Err("--scv-session requires a file")
            session = args[index + 1]
            index = index + 2
        else:
            ordinary.push(args[index])
            index = index + 1
    if session != "" and (ordinary.len() == 0 or not ["run", "verify", "verify-settled"].contains(ordinary[0])):
        return Err("--scv-session is valid only for run, verify, or verify-settled")
    Ok(BuildRunnerScvOptionsV1(args: ordinary, session_file: session))

export BuildRunnerScvOptionsV1, build_runner_scv_options_v1
