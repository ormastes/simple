"""Native-compatible hosted Simple HTTP server with asynchronous SSR."""

use std.cli.cli_util.{get_cli_args}
use std.http_server.server.{HttpServer}
use app.simple_web_server.config.{parse_hosted_web_cli, hosted_web_server_config, hosted_web_registry}

fn _hosted_web_usage() -> text:
    "simple-web-server [--listen ADDR] [--workers N] [--max-connections N] " +
    "[--max-body-bytes N] [--read-timeout-ms N] [--write-timeout-ms N] " +
    "[--idle-timeout-ms N] [--drain-timeout-ms N] [--ssr-path PATH] " +
    "[--width N] [--height N] [--backend auto|cpu] " +
    "[--launch-id NONCE] [--simpleos] " +
    "[--tls-cert FILE --tls-key FILE] [--check]"

fn main():
    val args = get_cli_args()
    val parsed = parse_hosted_web_cli(args)
    if not parsed.valid():
        print("simple-web-server: {parsed.error}")
        print(_hosted_web_usage())
        return
    if parsed.config.show_help:
        print(_hosted_web_usage())
        return

    val server_config = hosted_web_server_config(parsed.config)
    val registry = match hosted_web_registry(parsed.config):
        Ok(value): value
        Err(message):
            print("simple-web-server: {message}")
            return
    if parsed.config.check_only:
        print("simple-web-server: configuration valid")
        return

    if parsed.config.simpleos:
        print("SIMPLEOS_SERVER_LAUNCH artifact=simple_web_server path=/SYS/APPS/WEBSRV.SMF launch_id={parsed.config.launch_id}")

    var server = HttpServer.new(server_config)
    server.set_handler_registry(registry)
    match server.start():
        Ok(_): server.wait()
        Err(error): print("simple-web-server: startup failed: {error}")
