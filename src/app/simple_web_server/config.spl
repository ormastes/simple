"""Validated configuration for the hosted Simple web/SSR executable."""

use std.http_server.types.{ServerConfig, LocationConfig, default_server_config, default_location_config}
use std.http_server.handler.{HandlerRegistry}
use std.gc_async_mut.http_server.ssr_submitter.{SsrAsyncConfig, register_ssr_async_handler}

val HOSTED_SSR_HANDLER: text = "server-render"

class HostedWebCli:
    listen_addr: text
    worker_count: i64
    max_connections: i64
    max_body_bytes: i64
    read_timeout_ms: i64
    write_timeout_ms: i64
    idle_timeout_ms: i64
    drain_timeout_ms: i64
    ssr_path: text
    ssr_width: i32
    ssr_height: i32
    ssr_backend: text
    tls_cert_path: text
    tls_key_path: text
    launch_id: text
    simpleos: bool
    check_only: bool
    show_help: bool

class HostedWebParse:
    config: HostedWebCli
    error: text

    fn valid() -> bool:
        self.error == ""

fn default_hosted_web_cli() -> HostedWebCli:
    HostedWebCli(
        listen_addr: "127.0.0.1:8080",
        worker_count: 0,
        max_connections: 10000,
        max_body_bytes: 1048576,
        read_timeout_ms: 15000,
        write_timeout_ms: 15000,
        idle_timeout_ms: 60000,
        drain_timeout_ms: 10000,
        ssr_path: "/render",
        ssr_width: 1280,
        ssr_height: 720,
        ssr_backend: "auto",
        tls_cert_path: "",
        tls_key_path: "",
        launch_id: "",
        simpleos: false,
        check_only: false,
        show_help: false
    )

fn _hosted_parse_i64(raw: text, option: text, minimum: i64, maximum: i64) -> Result<i64, text>:
    val parsed = raw.to_int() ?? -1
    if parsed < minimum or parsed > maximum:
        return Err("{option} must be between {minimum} and {maximum}")
    Ok(parsed)

fn _hosted_next(args: [text], index: i64, option: text) -> Result<text, text>:
    if index + 1 >= args.len():
        return Err("{option} requires a value")
    Ok(args[index + 1])

fn _hosted_launch_id_valid(value: text) -> bool:
    (value.len() > 0 and value.len() <= 128 and
        not value.contains(" ") and not value.contains("\n") and
        not value.contains("\r") and not value.contains("\t"))

fn parse_hosted_web_cli(args: [text]) -> HostedWebParse:
    var config = default_hosted_web_cli()
    var i = 0
    while i < args.len():
        val option = args[i]
        if option == "--help" or option == "-h":
            config.show_help = true
            i = i + 1
            continue
        if option == "--check":
            config.check_only = true
            i = i + 1
            continue
        if option == "--simpleos":
            config.simpleos = true
            i = i + 1
            continue

        val raw = match _hosted_next(args, i, option):
            Ok(value): value
            Err(message): return HostedWebParse(config: config, error: message)
        match option:
            "--listen": config.listen_addr = raw
            "--ssr-path": config.ssr_path = raw
            "--backend": config.ssr_backend = raw
            "--tls-cert": config.tls_cert_path = raw
            "--tls-key": config.tls_key_path = raw
            "--launch-id": config.launch_id = raw
            "--workers":
                match _hosted_parse_i64(raw, option, 0, 256):
                    Ok(value): config.worker_count = value
                    Err(message): return HostedWebParse(config: config, error: message)
            "--max-connections":
                match _hosted_parse_i64(raw, option, 1, 1000000):
                    Ok(value): config.max_connections = value
                    Err(message): return HostedWebParse(config: config, error: message)
            "--max-body-bytes":
                match _hosted_parse_i64(raw, option, 1, 67108864):
                    Ok(value): config.max_body_bytes = value
                    Err(message): return HostedWebParse(config: config, error: message)
            "--read-timeout-ms":
                match _hosted_parse_i64(raw, option, 100, 300000):
                    Ok(value): config.read_timeout_ms = value
                    Err(message): return HostedWebParse(config: config, error: message)
            "--write-timeout-ms":
                match _hosted_parse_i64(raw, option, 100, 300000):
                    Ok(value): config.write_timeout_ms = value
                    Err(message): return HostedWebParse(config: config, error: message)
            "--idle-timeout-ms":
                match _hosted_parse_i64(raw, option, 100, 600000):
                    Ok(value): config.idle_timeout_ms = value
                    Err(message): return HostedWebParse(config: config, error: message)
            "--drain-timeout-ms":
                match _hosted_parse_i64(raw, option, 100, 120000):
                    Ok(value): config.drain_timeout_ms = value
                    Err(message): return HostedWebParse(config: config, error: message)
            "--width":
                match _hosted_parse_i64(raw, option, 1, 8192):
                    Ok(value): config.ssr_width = value.to_i32()
                    Err(message): return HostedWebParse(config: config, error: message)
            "--height":
                match _hosted_parse_i64(raw, option, 1, 8192):
                    Ok(value): config.ssr_height = value.to_i32()
                    Err(message): return HostedWebParse(config: config, error: message)
            _:
                return HostedWebParse(config: config, error: "unknown option: {option}")
        i = i + 2

    if config.simpleos:
        if not _hosted_launch_id_valid(config.launch_id):
            return HostedWebParse(config: config,
                error: "--simpleos requires a non-whitespace --launch-id of at most 128 bytes")
        if config.tls_cert_path != "" or config.tls_key_path != "":
            return HostedWebParse(config: config,
                error: "--simpleos TLS is unavailable; refusing an unsupported encrypted listener")
        if config.listen_addr == "127.0.0.1:8080":
            config.listen_addr = "0.0.0.0:8080"
        # The current SimpleOS TCP bridge is caller-owned and single-core.
        # Normalize instead of entering hosted threads or GPU discovery.
        config.worker_count = 1
        config.ssr_backend = "cpu"

    if config.listen_addr == "":
        return HostedWebParse(config: config, error: "--listen must not be empty")
    if not config.ssr_path.starts_with("/"):
        return HostedWebParse(config: config, error: "--ssr-path must start with /")
    if config.ssr_backend != "auto" and config.ssr_backend != "cpu":
        return HostedWebParse(config: config, error: "--backend must be auto or cpu until GPU admission evidence passes")
    if (config.tls_cert_path == "") != (config.tls_key_path == ""):
        return HostedWebParse(config: config, error: "--tls-cert and --tls-key must be supplied together")
    val loopback = config.listen_addr.starts_with("127.") or
        config.listen_addr.starts_with("localhost:") or config.listen_addr.starts_with("[::1]:")
    if not config.simpleos and not loopback and config.tls_cert_path == "":
        return HostedWebParse(config: config,
            error: "non-loopback listeners require --tls-cert and --tls-key")
    HostedWebParse(config: config, error: "")

fn hosted_web_server_config(cli: HostedWebCli) -> ServerConfig:
    var location = default_location_config()
    location.pattern = cli.ssr_path
    location.match_type = "exact"
    location.handler_type = HOSTED_SSR_HANDLER

    var config = default_server_config()
    config.listen_addr = cli.listen_addr
    config.worker_count = cli.worker_count
    config.max_connections = cli.max_connections
    config.client_max_body_size = cli.max_body_bytes
    config.read_timeout_ms = cli.read_timeout_ms
    config.write_timeout_ms = cli.write_timeout_ms
    config.idle_timeout_ms = cli.idle_timeout_ms
    config.drain_timeout_ms = cli.drain_timeout_ms
    config.locations = [location]
    config.tls_enabled = cli.tls_cert_path != ""
    config.tls_cert_path = cli.tls_cert_path
    config.tls_key_path = cli.tls_key_path
    config.tls_min_version = "1.3"
    config

fn hosted_web_registry(cli: HostedWebCli) -> Result<HandlerRegistry, text>:
    var registry = HandlerRegistry.new()
    val ssr_config = SsrAsyncConfig.production(
        cli.ssr_width, cli.ssr_height, cli.max_body_bytes, cli.ssr_backend
    )
    if not register_ssr_async_handler(registry, HOSTED_SSR_HANDLER, ssr_config):
        return Err("failed to register hosted SSR handler")
    Ok(registry)

export HostedWebCli, HostedWebParse, HOSTED_SSR_HANDLER
export default_hosted_web_cli, parse_hosted_web_cli
export hosted_web_server_config, hosted_web_registry
