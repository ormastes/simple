"""Single-owner loopback lane of the hosted web server as its own entry.

Same lane as `simple-web-server --single-owner` (POST /ingest, GET /health,
optional AVX vector provider), without the async SSR/GPU closure of main.spl,
so it native-builds as a small binary for the AVX server system perf test."""
use std.cli.cli_util.{get_cli_args}
use app.simple_web_server.cli.{parse_hosted_web_cli}
use app.simple_web_server.vector_lane.{hosted_single_owner_serve}

fn main():
    val parsed = parse_hosted_web_cli(get_cli_args())
    if not parsed.valid():
        print("simple-web-server-vector: {parsed.error}")
        return
    var config = parsed.config
    config.single_owner = true
    if config.check_only:
        print("simple-web-server-vector: configuration valid")
        return
    val _ = hosted_single_owner_serve(config)
