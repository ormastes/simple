use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget, ManifestResourceLimits, SimpleArtifactManifest}
use std.common.contracts.execution.simpleos_executable_admission_v1.{ExecutableAdmissionDecisionV1, ExecutableAdmissionV1}
use os.kernel.loader.executable_crypto_authority.{executable_manifest_signing_body_v1}

extern fn rt_file_write_bytes(path: text, data: [u8]) -> bool

fn _positive(value: text) -> u64:
    val parsed = value.to_i64()
    if parsed <= 0: panic("rv64-auth-contract: invalid positive coordinate")
    parsed.to_u64()

fn main():
    val args = get_cli_args()
    if args.len() != 9:
        panic("rv64-auth-contract: expected OUTPUT IMAGE_HASH KERNEL_HASH TRUST_HASH MOUNT_ID MOUNT_GEN FILE_ID FILE_GEN")
    val target = ManifestTarget(os: "simpleos", arch: "riscv64", abi: "simpleos")
    val manifest = SimpleArtifactManifest(
        format_version: 1, artifact_kind: "elf", target: target, entrypoint: "main",
        required_abi_features: ["elf64", "w_xor_x"], required_services: [],
        required_capabilities: 69u32,
        resource_limits: ManifestResourceLimits(max_memory_bytes: 0, max_open_handles: 0, max_threads: 0, cpu_budget_us: 0),
        namespace_template: "app_default", native_libraries: [], smf_libraries: [],
        interpreter: "", argument_schema: [], startup_preloads: [],
        content_hashes: [args[2]], signature: "ed25519:rv64-qemu-acceptance-v1", debug_identity: "")
    val admission = ExecutableAdmissionV1(
        schema_version: 1, admission_id: "rv64-qemu-fs-exec-v1",
        decision: ExecutableAdmissionDecisionV1.Admitted, rejection_reason: "",
        image_hash: args[2], manifest_hash: args[2], kernel_hash: args[3],
        trust_root_hash: args[4], trust_epoch: 1u64, target: target,
        firmware_profile: "opensbi-qemu-virt", compiler_identity: "admitted-stage2",
        source_identity: "retained-source-tree", config_identity: "rv64-authenticated-fs-exec-v1",
        mount_id: _positive(args[5]), mount_generation: _positive(args[6]),
        file_id: _positive(args[7]), file_generation: _positive(args[8]),
        effective_capabilities: 69u32)
    if not rt_file_write_bytes(args[1], executable_manifest_signing_body_v1(manifest, admission, args[2])):
        panic("rv64-auth-contract: cannot write canonical body")
