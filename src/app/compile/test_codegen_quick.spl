use app.compile.c_codegen (generate_c_code)
use std.io_runtime.{read_file_text_result}

fn main():
    val source = match read_file_text_result("examples/native_v2_test.spl"):
        case Ok(value): value
        case Err(error):
            print "ERROR: could not read examples/native_v2_test.spl: {error}"
            return
    val c_code = generate_c_code(source)
    print c_code
