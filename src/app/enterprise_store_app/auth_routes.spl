"""
# Enterprise Web App — bearer-token auth entry + request throttling

Lane `.spipe/simple_enterprise_suite` W5-A. `store_app_handle_bearer` is the
production entry: it resolves the `SessionContext` FROM an
`Authorization: Bearer <token>` header via the durable session store
(`std.enterprise_session`) instead of taking an explicit session — the
explicit-session `store_app_handle` stays for tests and remains the single
hardened route path underneath.

Dispatch prelude order (before ANY route logic):
0. request limits — `http_core.body_decision` (oversize 413, chunked 501,
   smuggling/duplicate-header 400) applies to EVERY request including the
   unauthenticated auth routes (W9-D).
1. request throttle — fixed-window counter keyed `tenant|token-or-anon`
   (general window) or `tenant|login:user` (stricter anti-brute-force window
   for POST /auth/login). A login is charged to BOTH windows: the per-user
   key is a caller-controlled form field, so the tenant-wide anonymous window
   is what bounds a rotating-user credential-stuffing flood (W9-D).
   Over-limit -> 429 with the shared security headers.
   A rejected request records nothing, so a burst cannot extend its lockout.
2. POST /auth/login — form `user`/`secret`; issues a durable session and
   returns `token=<tok>` in the body (no cookies). Failure is a GENERIC 401
   (`invalid-credentials`) for both unknown user and wrong secret.
3. POST /auth/logout — revokes the bearer token (insert-only revocation row).
4. everything else — bearer token resolved to an active SessionContext or
   401 (missing/expired/revoked), then delegated to `store_app_handle`.

Determinism: the caller supplies `now_epoch` and login `entropy` — this
module never reads a wall clock or randomness.
"""

use std.common.net.http_core.{MAX_BODY_SIZE, body_decision}
use std.nogc_sync_mut.http_server.types.{HttpResponse, HttpStatus}
use std.nogc_sync_mut.enterprise_store.store.{EnterpriseStore}
use std.nogc_sync_mut.enterprise_sale.foundation.{TenantContext, ActorContext, SessionContext}
use std.nogc_sync_mut.enterprise_session.session.{
    session_issue, session_revoke, session_resolve
}
use std.nogc_sync_mut.enterprise_session.throttle.{throttle_admit}
use app.enterprise_store_app.web_common.{form_value, secured}
use app.enterprise_store_app.main.{store_app_handle}

# Fixed-window throttle policy (seconds, max requests per window).
fn throttle_general_window() -> i64:
    60
fn throttle_general_limit() -> i64:
    30
fn throttle_login_window() -> i64:
    60
fn throttle_login_limit() -> i64:
    5

fn bearer_token(headers: [(text, text)]) -> text:
    for h in headers:
        if h.0 == "Authorization" and h.1.starts_with("Bearer "):
            return h.1.slice(7, h.1.len())
    ""

fn too_many() -> HttpResponse:
    secured(HttpResponse.error(HttpStatus.TooManyRequests, "rate-limited: retry later"))

fn unauthorized() -> HttpResponse:
    secured(HttpResponse.error(HttpStatus.Unauthorized, "invalid-credentials"))

# store_app_handle_bearer — production entry; see module doc for the prelude.
fn store_app_handle_bearer(store: EnterpriseStore, tenant: TenantContext, method: text, path: text, headers: [(text, text)], body: text, now_epoch: i64, entropy: text) -> HttpResponse:
    # 0. request limits FIRST — the auth routes are the only UNAUTHENTICATED
    #    surface, so they must not be the one place that skips `body_decision`.
    #    Before W9-D only `store_app_handle` applied it, so an anonymous caller
    #    could post an arbitrarily large / smuggling-shaped body to
    #    /auth/login and /auth/logout.
    val decision = body_decision(headers, MAX_BODY_SIZE, false)
    if decision.0 != "":
        val status = if decision.0.starts_with("413"):
            HttpStatus.PayloadTooLarge
        elif decision.0.starts_with("501"):
            HttpStatus.NotImplemented
        else:
            HttpStatus.BadRequest
        return secured(HttpResponse.error(status, decision.0))
    if method == "POST" and path == "/auth/login":
        # Tenant-wide anonymous window FIRST: the per-user lockout below is
        # keyed on a caller-controlled form field, so rotating `user` evaded
        # every limit (credential stuffing / login flood, W9-D).
        if not throttle_admit(store, tenant.tenant_id + "|anon", now_epoch, throttle_general_window(), throttle_general_limit()):
            return too_many()
        val user = form_value(body, "user")
        val key = tenant.tenant_id + "|login:" + user
        if not throttle_admit(store, key, now_epoch, throttle_login_window(), throttle_login_limit()):
            return too_many()
        val ttl_text = form_value(body, "ttl")
        var ttl: i64 = 3600
        if ttl_text != "":
            var digits = true
            for ch in ttl_text:
                if ch < "0" or ch > "9":
                    digits = false
            if digits:
                ttl = int(ttl_text)
        val r = session_issue(store, tenant.tenant_id, user, form_value(body, "secret"), now_epoch, ttl, entropy)
        if not r.ok:
            return unauthorized()
        return secured(HttpResponse.html("token=" + r.detail))
    val token = bearer_token(headers)
    var gsuffix = token
    if gsuffix == "":
        gsuffix = "anon"
    val gkey = tenant.tenant_id + "|" + gsuffix
    if not throttle_admit(store, gkey, now_epoch, throttle_general_window(), throttle_general_limit()):
        return too_many()
    if method == "POST" and path == "/auth/logout":
        val resolved = session_resolve(store, tenant.tenant_id, token, now_epoch)
        if not resolved.0.active:
            return unauthorized()
        session_revoke(store, tenant.tenant_id, token)
        return secured(HttpResponse.html("<p class=\"result\">logged-out</p>"))
    val resolved = session_resolve(store, tenant.tenant_id, token, now_epoch)
    if not resolved.0.active:
        return unauthorized()
    val who = ActorContext(actor_id: resolved.0.actor_id, role: resolved.1)
    store_app_handle(store, resolved.0, tenant, who, method, path, headers, body)

export store_app_handle_bearer, bearer_token
