# Standalone SimpleOS source pipeline. Keep this facade concrete: importing the
# generic CompilerDriver retains every optional backend in the guest binary.

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.desugar.desugar_async.{desugar_module}
use compiler.frontend.desugar.collection_desugar.{desugar_collections_static}
use compiler.core.parser_preprocessor.{_pp_preprocess_conditionals}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.backend.backend.interpreter.{InterpreterBackendImpl}
use compiler.backend.backend.backend_types.{compileoptions_release_options}
use compiler.backend.backend.llvm_codegen_adapter.{llvm_compile_module_direct_compiled, llvm_translate_module_direct_ir}
use compiler.backend.backend.simpleos_guest_link.{link_simpleos_guest_external_for_target}
use app.simpleos_tool.guest_target.{SimpleOsGuestTarget, simpleos_guest_target_current, simpleos_guest_target_valid, simpleos_guest_target_configure, simpleos_guest_user_context}
use app.io.mod.{file_hash_sha256, file_rename, file_size_raw, getpid}
use std.common.structural.digest.hash256.{hash256_hex_valid, hash256_is_zero}

extern fn rt_file_read_text_rv(path: text) -> text
use std.io_runtime.{file_write_bytes}
use std.io_runtime.{file_write}
use std.io_runtime.{file_delete}

fn publish_fresh_candidate(candidate: text, output: text, artifact_kind: text) -> bool:
    """Atomically publish and bind success to the final pathname's bytes."""
    val candidate_size = file_size_raw(candidate)
    val candidate_sha256 = file_hash_sha256(candidate)
    if (candidate_size <= 0 or
            not hash256_hex_valid(candidate_sha256) or
            hash256_is_zero(candidate_sha256)):
        file_delete(candidate)
        print "error: {artifact_kind} is missing or invalid: {candidate}"
        return false
    if not file_rename(candidate, output):
        file_delete(candidate)
        print "error: cannot publish {artifact_kind}: {output}"
        return false
    # Rename success alone is not terminal evidence on every filesystem
    # backend.  Re-open the published name and require the exact staged
    # identity so callers cannot report success for a missing, substituted, or
    # truncated output after publication.
    val published_size = file_size_raw(output)
    val published_sha256 = file_hash_sha256(output)
    if (published_size != candidate_size or
            published_sha256 != candidate_sha256):
        file_delete(output)
        print "error: published {artifact_kind} identity mismatch: {output}"
        return false
    true

fn require_user_context(phase: text, target: SimpleOsGuestTarget) -> bool:
    if not simpleos_guest_user_context():
        print "[simpleos-user-context] FAIL phase={phase} arch={target.arch}"
        return false
    print "[simpleos-user-context] phase={phase} arch={target.arch} status=ok"
    true

fn lower_standalone_file(path: text, target: SimpleOsGuestTarget) -> Result<HirModule, text>:
    val source = rt_file_read_text_rv(path)
    if not require_user_context("post-read", target):
        return Err("filesystem syscall did not return to a valid user context")
    if source == "":
        return Err("cannot read source or source is empty: {path}")
    var parsed = parse_and_build_module(_pp_preprocess_conditionals(source), path)
    parsed = desugar_module(parsed)
    desugar_collections_static(0, 0)
    var lowering: HirLowering = HirLowering.with_filename(path)
    val hir = lowering.lower_module(parsed)
    if lowering.errors.len() > 0:
        return Err(lowering.errors[0].message)
    Ok(hir)

pub fn simpleos_interpret_file(path: text) -> i64:
    val selected = simpleos_guest_target_current()
    if selected.is_err():
        print "error: {selected.unwrap_err()}"
        return 1
    simpleos_interpret_file_for_target(path, selected.unwrap())

pub fn simpleos_interpret_file_for_target(path: text, target: SimpleOsGuestTarget) -> i64:
    if not simpleos_guest_target_valid(target):
        print "error: invalid SimpleOS guest target descriptor"
        return 1
    val lowered = lower_standalone_file(path, target)
    if lowered.is_err():
        print "error: {lowered.unwrap_err()}"
        return 1
    val interpreted = InterpreterBackendImpl.new().interpret_hir_module(lowered.unwrap())
    match interpreted:
        case Ok(_): 0
        case Err(error):
            print "error: {error.message}"
            1

pub fn simpleos_compile_native_file(path: text, output: text, emit_object: bool, emit_llvm: bool) -> i64:
    val selected = simpleos_guest_target_current()
    if selected.is_err():
        print "error: {selected.unwrap_err()}"
        return 1
    simpleos_compile_native_file_for_target(path, output, emit_object, emit_llvm, selected.unwrap())

pub fn simpleos_compile_native_file_for_target(path: text, output: text, emit_object: bool, emit_llvm: bool, target: SimpleOsGuestTarget) -> i64:
    if not simpleos_guest_target_configure(target):
        print "error: failed to configure the SimpleOS native toolchain"
        return 1
    val lowered = lower_standalone_file(path, target)
    if lowered.is_err():
        print "[simpleos-compile] phase=hir-error"
        print "error: {lowered.unwrap_err()}"
        return 1
    val hir: HirModule = lowered.unwrap()
    print "[simpleos-compile] phase=hir-ok"
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    if mir_lowering.errors.len() > 0:
        print "[simpleos-compile] phase=mir-error"
        print "error: {mir_lowering.errors[0].message}"
        return 1
    if mir.functions.len() == 0:
        print "error: source produced no functions"
        return 1

    var options = compileoptions_release_options()
    options.target = target.codegen_target
    # Every compiler mode writes to an unpublished sibling first.  Object and
    # LLVM-IR output used to write the requested path directly, allowing an
    # interrupted write to expose a truncated artifact while executable output
    # already had atomic publication.  A SimpleOS CLI invocation owns one PID,
    # so the process-qualified sibling also prevents stale cross-run reuse.
    val process_id = getpid()
    val candidate_output = output + ".candidate-" + process_id.to_text()
    file_delete(candidate_output)
    if emit_llvm:
        print "[simpleos-compile] phase=mir-ok"
        val llvm_ir = llvm_translate_module_direct_ir(options, mir)
        print "[simpleos-compile] phase=ir-ready bytes={llvm_ir.len()}"
        if not file_write(candidate_output, llvm_ir):
            file_delete(candidate_output)
            print "error: cannot stage LLVM IR: {output}"
            return 1
        if not require_user_context("post-write", target):
            file_delete(candidate_output)
            return 1
        return if publish_fresh_candidate(
            candidate_output, output, "LLVM IR"): 0 else: 1
    val compiled = llvm_compile_module_direct_compiled(options, mir)
    if compiled.is_err():
        print "error: {compiled.unwrap_err().message}"
        return 1

    val object_path = if emit_object: candidate_output else: "/tmp/SIMPLEUSR-" + process_id.to_text() + ".O"
    if not emit_object:
        file_delete(object_path)
    if not file_write_bytes(object_path, compiled.unwrap().object_code):
        # Both modes own an unpublished process-qualified object.  In direct
        # object mode this is `candidate_output`; a short/failed write may
        # still have created it, so leaving cleanup to executable-link mode
        # leaks a partial candidate that a later same-PID invocation can see.
        file_delete(object_path)
        print "error: cannot write object: {object_path}"
        return 1
    if not require_user_context("post-write", target):
        file_delete(object_path)
        return 1
    if emit_object:
        return if publish_fresh_candidate(
            candidate_output, output, "object file"): 0 else: 1
    # Link into an unpublished process-qualified path.  The requested output
    # remains authoritative until a fresh executable from this invocation has
    # a nonempty SHA-256 identity and can be atomically published.  This policy
    # is shared by x86_64, AArch64, and RISC-V rather than delegated to their
    # different linker implementations.
    val linked = link_simpleos_guest_external_for_target(
        target.arch, target.compiler_triple, [object_path], candidate_output)
    file_delete(object_path)
    match linked:
        case Ok(_):
            if publish_fresh_candidate(
                candidate_output, output, "linked executable"): 0 else: 1
        case Err(error):
            file_delete(candidate_output)
            print "error: {error}"
            1
