# Focused Simple compiler/interpreter/loader entrypoint for SimpleOS.
#
# This deliberately exposes only the language operations required on the guest;
# desktop and host-service commands belong to the full CLI, not this target.

use app.simpleos_tool.focused_pipeline.{simpleos_compile_native_file_for_target, simpleos_interpret_file_for_target}
use app.simpleos_tool.guest_target.{SimpleOsGuestTarget, simpleos_guest_target_current}
use app.io.args_ops.{get_args}

fn compile_native(args: [text], target: SimpleOsGuestTarget) -> i64:
    var source = ""
    var output = ""
    var emit_object = false
    var emit_llvm = false
    var i = 2
    while i < args.len():
        if args[i] == "--native":
            i = i + 1
            continue
        elif args[i] == "--emit-object":
            emit_object = true
        elif args[i] == "--emit-llvm":
            emit_llvm = true
        elif args[i] == "-o" and i + 1 < args.len():
            i = i + 1
            output = args[i]
        elif args[i].starts_with("-"):
            print "error: unsupported compile option: {args[i]}"
            return 2
        elif source == "":
            source = args[i]
        else:
            print "error: compile accepts one source file"
            return 2
        i = i + 1

    if source == "" or output == "":
        print "usage: simple compile [--native|--emit-object|--emit-llvm] <source.spl> -o <output>"
        return 2
    if emit_object and emit_llvm:
        print "error: choose one emit mode"
        return 2

    simpleos_compile_native_file_for_target(source, output, emit_object, emit_llvm, target)

fn main() -> i64:
    val args = get_args()
    if args.len() < 2:
        print "usage: simple [--version|compile [--native|--emit-object|--emit-llvm] <source> -o <output>|<file.spl>]"
        return 2

    val command = args[1]
    if command == "--version":
        print "Simple v1.0.0-RC"
        return 0
    val selected = simpleos_guest_target_current()
    if selected.is_err():
        print "error: {selected.unwrap_err()}"
        return 1
    val target = selected.unwrap()
    if command == "compile":
        return compile_native(args, target)
    simpleos_interpret_file_for_target(command, target)
