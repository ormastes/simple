# Simple CLI - todo-scan command
# Pure Simple implementation - scans source for TODO/FIXME comments
#
# Detects both formatted and unformatted TODOs:
#   Formatted:   # TODO: [area][priority] description [#issue]
#   Unformatted: # TODO: description (assigned area=general, priority=P3)

use std.cli.cli_util (get_cli_args)
use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
use app.io.mod (dir_walk, file_read, file_exists, file_write, dir_create_all, cwd, is_dir)
use std.log.{error}
use std.nogc_sync_mut.sffi.io.{path_absolute}

fn print_help():
    print "Usage: simple todo-scan [options]"
    print ""
    print "Scan source files for TODO/FIXME comments and update TODO tracking files."
    print ""
    print "Options:"
    print "  --json       Output summary as JSON"
    for line in log_options_help():
        print "  {line}"
    print "  -h, --help   Show this help"

fn _is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--surface=") or arg.starts_with("--progress=")

fn _json_escape(value: text) -> text:
    val slashes = value.replace("\\", "\\\\")
    val quotes = slashes.replace("\"", "\\\"")
    quotes.replace("\n", "\\n")

# ============================================================================
# Data Types
# ============================================================================

struct TodoEntry:
    id: i64
    keyword: text      # TODO or FIXME
    area: text          # runtime, stdlib, compiler, etc.
    priority: text      # P0, P1, P2, P3
    description: text
    file: text
    line: i64
    issue: text         # GitHub issue number (optional)
    blocked: text       # Blocked by issues (optional)
    status: text        # open, blocked, in_progress, closed
    valid: bool         # citation verified at last scan; carried through merges

# ============================================================================
# Scanner
# ============================================================================

fn should_skip_file(content: text) -> bool:
    val lines = content.split("\n")
    var i = 0
    for line in lines:
        if i >= 20:
            return false
        val trimmed = line.trim()
        if trimmed.contains("skip_todo"):
            return true
        i = i + 1
    false

fn scan_file(file_path: text, start_id: i64) -> [TodoEntry]:
    var results: [TodoEntry] = []
    val content = file_read(file_path) ?? ""
    if should_skip_file(content):
        return results
    val is_markdown = file_path.ends_with(".md")
    val lines = content.split("\n")
    var line_num = 0
    var current_id = start_id
    var in_code_block = false
    for line in lines:
        line_num = line_num + 1
        val trimmed = line.trim()

        # Track fenced code blocks in markdown files
        if is_markdown:
            if trimmed.starts_with("```"):
                in_code_block = not in_code_block
                continue
            if in_code_block:
                continue

        # Detect TODO or FIXME in comments
        var keyword = ""
        var rest = ""

        # Simple/Python-style comments
        if trimmed.starts_with("# TODO:"):
            keyword = "TODO"
            var r1 = trimmed[7:]
            rest = r1.trim()
        elif trimmed.starts_with("# FIXME:"):
            keyword = "FIXME"
            var r2 = trimmed[8:]
            rest = r2.trim()
        # Rust/C-style comments
        elif trimmed.starts_with("// TODO:"):
            keyword = "TODO"
            var r3 = trimmed[8:]
            rest = r3.trim()
        elif trimmed.starts_with("// FIXME:"):
            keyword = "FIXME"
            var r4 = trimmed[9:]
            rest = r4.trim()

        if keyword.len() == 0:
            continue

        # Parse formatted TODO: [area][priority] description [#issue] [blocked:#n]
        val parsed = parse_todo_text(rest)

        # A TODO carrying `[blocked:<reason>]` is not actionable work; record it
        # as `blocked` so a rescan cannot flatten curated blocked rows to `open`.
        var entry_status = "open"
        if parsed.blocked.len() > 0:
            entry_status = "blocked"

        results.push(TodoEntry(
            id: current_id,
            keyword: keyword,
            area: parsed.area,
            priority: parsed.priority,
            description: parsed.description,
            file: file_path,
            line: line_num,
            issue: parsed.issue,
            blocked: parsed.blocked,
            status: entry_status,
            valid: true
        ))
        current_id = current_id + 1
    results

struct ParsedTodo:
    area: text
    priority: text
    description: text
    issue: text
    blocked: text

fn parse_todo_text(input: text) -> ParsedTodo:
    var area = "general"
    var priority = "P3"
    var description = input
    var issue = ""
    var blocked = ""

    var remaining = input

    # Try to parse [area][priority] prefix
    if remaining.starts_with("["):
        val close1 = remaining.index_of("]")
        if close1 > 0:
            area = remaining[1:close1]
            var after1 = remaining[close1 + 1:]
            remaining = after1.trim()

            if remaining.starts_with("["):
                val close2 = remaining.index_of("]")
                if close2 > 0:
                    priority = remaining[1:close2]
                    var after2 = remaining[close2 + 1:]
                    remaining = after2.trim()
                    # Normalize priority aliases
                    if priority == "critical":
                        priority = "P0"
                    elif priority == "high":
                        priority = "P1"
                    elif priority == "medium":
                        priority = "P2"
                    elif priority == "low":
                        priority = "P3"

    # Extract [#issue] from end
    val issue_start = remaining.index_of("[#")
    if issue_start >= 0:
        val after_issue = remaining[issue_start:]
        val issue_end_rel = after_issue.index_of("]")
        if issue_end_rel > 0:
            issue = after_issue[2:issue_end_rel]
            # Keep the text AFTER the tag too: truncating here dropped a
            # trailing `[blocked:...]` tag, so an issue-tagged TODO was never
            # recorded as blocked.
            val issue_tail = after_issue[issue_end_rel + 1:]
            var before_issue = remaining[0:issue_start] + issue_tail
            remaining = before_issue.trim()

    # Extract [blocked:#n,#m] from end
    val blocked_start = remaining.index_of("[blocked:")
    if blocked_start >= 0:
        val after_blocked = remaining[blocked_start:]
        val blocked_end_rel = after_blocked.index_of("]")
        if blocked_end_rel > 0:
            blocked = after_blocked[9:blocked_end_rel]
            val blocked_tail = after_blocked[blocked_end_rel + 1:]
            var before_blocked = remaining[0:blocked_start] + blocked_tail
            remaining = before_blocked.trim()

    description = remaining

    ParsedTodo(area: area, priority: priority, description: description, issue: issue, blocked: blocked)

# ============================================================================
# File Discovery
# ============================================================================

fn real_path(path: text) -> text:
    """Symlink-resolved (`realpath`) spelling of `path`.

    `path_absolute` is realpath, so every alias of one physical file
    collapses onto a single string. Without it the same file is handed to the
    scanner once per spelling and every TODO in it is counted once per
    spelling: `dir_walk` emits symlinked FILES under the alias name today,
    and the repo's directory symlinks (`src/compiler/driver -> 80.driver`,
    `src/std -> src/lib`, the `test/*/compiler` mirrors) duplicate whole
    subtrees on any walker that descends them — which is how the committed
    `todo_db.sdn` ended up with both `src/compiler/80.driver/...` and
    `src/compiler/driver/...` rows for one TODO. Falls back to the walked
    path when the file cannot be resolved (e.g. a dangling symlink), which
    keeps that spelling as its own identity instead of collapsing every
    failure onto ""."""
    val resolved = path_absolute(path) ?? ""
    if resolved == "":
        return path.replace("\\", "/")
    resolved.replace("\\", "/")

fn collect_source_files(root: text) -> [text]:
    """Physical source files under the scan roots — one entry per real file.

    Deduplicated by REAL path, never by the walked string, and the retained
    spelling is the real path so the report points at a file that exists."""
    var files: [text] = []
    var seen: Dict<text, bool> = {}
    val real_root_prefix = real_path(root) + "/"
    val scan_dirs = ["src", "test", "doc", ".claude/skills"]

    for scan_dir in scan_dirs:
        val full_path = "{root}/{scan_dir}"
        if not is_dir(full_path):
            continue
        val walked = dir_walk(full_path)
        for f in walked:
            if not should_scan(f):
                continue
            val physical = real_path(f)
            if seen.contains_key(physical):
                continue
            seen[physical] = true
            # Keep the physical spelling for in-tree files; an out-of-tree
            # symlink target stays reported under the walked path so the
            # report keeps pointing inside the repo.
            if physical.starts_with(real_root_prefix):
                files.push(physical)
            else:
                files.push(f)
    files

fn should_scan(path: text) -> bool:
    # Skip build artifacts, hidden dirs, etc.
    if path.contains("/target/"):
        return false
    if path.contains("/build/"):
        return false
    if path.contains("/.git/"):
        return false
    if path.contains("/node_modules/"):
        return false
    if path.contains("/archive/"):
        return false

    # Only scan known source file types
    if path.ends_with(".spl"):
        return true
    if path.ends_with(".md"):
        return true
    false

# ============================================================================
# Committed DB merge — stable ids, curated rows survive a rescan
# ============================================================================

fn _digit_value(c: text) -> i64:
    "0123456789".index_of(c)

fn _to_i64(s0: text) -> i64:
    """Parse a non-negative integer; -1 signals invalid. Committed ids and
    line numbers are never negative, so the sentinel cannot collide."""
    val s = s0.trim()
    if s.len() == 0:
        return -1
    var n: i64 = 0
    var i: i64 = 0
    while i < s.len():
        val d = _digit_value(s[i:i + 1])
        if d < 0:
            return -1
        n = n * 10 + d
        i = i + 1
    n

fn _take_field(rest: text) -> (text, text):
    """Split one `field, remainder` pair off a committed-db row tail."""
    val sep = rest.index_of(", ")
    if sep < 0:
        return (rest.trim(), "")
    (rest[0:sep].trim(), rest[sep + 2:])

fn _empty_entry() -> TodoEntry:
    TodoEntry(id: -1, keyword: "", area: "", priority: "", description: "",
        file: "", line: -1, issue: "", blocked: "", status: "", valid: false)

fn parse_db_row(line: text) -> TodoEntry:
    """Parse one committed-db row in the exact shape written by write_todo_db.

    Returns the `_empty_entry()` sentinel (id -1) for the table header, blank
    lines, and anything that does not match; the reader drops those rows, so a
    hand-edited or older-format line degrades to being ignored instead of
    crashing the scan. Descriptions cannot contain a double quote (the writer
    escapes them), so the first quote after the description start is always
    its terminator."""
    val t = line.trim()
    if t.len() == 0:
        return _empty_entry()
    if _digit_value(t[0:1]) < 0:
        return _empty_entry()
    val (id_s, r1) = _take_field(t)
    val id = _to_i64(id_s)
    if id < 0:
        return _empty_entry()
    val (keyword, r2) = _take_field(r1)
    val (area, r3) = _take_field(r2)
    val (priority, r4) = _take_field(r3)
    if not r4.starts_with("\""):
        return _empty_entry()
    val desc_body = r4[1:]
    val desc_end = desc_body.index_of("\"")
    if desc_end < 0:
        return _empty_entry()
    val description = desc_body[0:desc_end]
    val r5 = desc_body[desc_end + 1:]
    if not r5.starts_with(", "):
        return _empty_entry()
    val (file, r6) = _take_field(r5[2:])
    val (line_s, r7) = _take_field(r6)
    val line = _to_i64(line_s)
    if line < 0:
        return _empty_entry()
    val (issue, r8) = _take_field(r7)
    if not r8.starts_with("\""):
        return _empty_entry()
    val blocked_body = r8[1:]
    val blocked_end = blocked_body.index_of("\"")
    if blocked_end < 0:
        return _empty_entry()
    val blocked = blocked_body[0:blocked_end]
    val r9 = blocked_body[blocked_end + 1:]
    if not r9.starts_with(", "):
        return _empty_entry()
    val (status, r10) = _take_field(r9[2:])
    val valid = r10.trim() == "true"
    TodoEntry(id: id, keyword: keyword, area: area, priority: priority,
        description: description, file: file, line: line, issue: issue,
        blocked: blocked, status: status, valid: valid)

fn read_todo_db(path: text) -> [TodoEntry]:
    var rows: [TodoEntry] = []
    val content = file_read(path) ?? ""
    if content.len() == 0:
        return rows
    for line in content.split("\n"):
        val row = parse_db_row(line)
        if row.id >= 0:
            rows.push(row)
    rows

fn _normalize_description(s: text) -> text:
    """Trim and collapse whitespace runs so incidental hand-edits (double
    spaces, trailing space) cannot orphan a row from its marker."""
    var parts: [text] = []
    for p in s.split(" "):
        if p.len() > 0:
            parts.push(p)
    parts.join(" ")

fn todo_key(file: text, description: text) -> text:
    """Stable merge identity: file path + normalized description. The line
    number is deliberately NOT part of the key — markers drift within a file,
    and the merge re-points the line instead of treating drift as a brand-new
    todo (the old behavior renumbered every id on each run)."""
    file.trim() + "\n" + _normalize_description(description)

struct MergeResult:
    entries: [TodoEntry]
    carried: i64   # committed rows matched to a live marker
    added: i64     # live markers with no committed row
    closed: i64    # committed open rows whose marker vanished

fn merge_entries(existing: [TodoEntry], scanned: [TodoEntry]) -> MergeResult:
    """Merge a fresh scan with the committed db.

    A committed row whose key matches a live marker keeps its id and every
    curated field (keyword/area/priority/issue/blocked/status/valid); only
    file/line are refreshed, so line drift repairs itself. A committed row
    whose marker vanished is marked `closed` — never deleted, never
    renumbered; curated non-open rows (blocked/in_progress/closed) are
    preserved as-is, because a hand-authored row whose text does not appear
    verbatim in source must survive the scan. A live marker with no committed
    row is appended with a fresh id past the current max — ids are never
    reused."""
    var used: [bool] = []
    var ui: i64 = 0
    while ui < scanned.len():
        used.push(false)
        ui = ui + 1

    var merged: [TodoEntry] = []
    var max_id: i64 = -1
    var carried: i64 = 0
    var closed_count: i64 = 0

    for row in existing:
        if row.id > max_id:
            max_id = row.id
        val k = todo_key(row.file, row.description)
        var si: i64 = 0
        var found: i64 = -1
        while si < scanned.len() and found < 0:
            if used[si] == false:
                if todo_key(scanned[si].file, scanned[si].description) == k:
                    found = si
            si = si + 1
        if found >= 0:
            used[found] = true
            carried = carried + 1
            val s = scanned[found]
            merged.push(TodoEntry(
                id: row.id, keyword: row.keyword, area: row.area,
                priority: row.priority, description: row.description,
                file: s.file, line: s.line, issue: row.issue,
                blocked: row.blocked, status: row.status, valid: row.valid))
        else:
            var status = row.status
            if status == "open":
                status = "closed"
                closed_count = closed_count + 1
            merged.push(TodoEntry(
                id: row.id, keyword: row.keyword, area: row.area,
                priority: row.priority, description: row.description,
                file: row.file, line: row.line, issue: row.issue,
                blocked: row.blocked, status: status, valid: row.valid))

    var added: i64 = 0
    var si2: i64 = 0
    while si2 < scanned.len():
        if used[si2] == false:
            max_id = max_id + 1
            added = added + 1
            val e = scanned[si2]
            merged.push(TodoEntry(
                id: max_id, keyword: e.keyword, area: e.area,
                priority: e.priority, description: e.description,
                file: e.file, line: e.line, issue: e.issue,
                blocked: e.blocked, status: e.status, valid: true))
        si2 = si2 + 1

    MergeResult(entries: merged, carried: carried, added: added, closed: closed_count)

# ============================================================================
# Output: SDN Database
# ============================================================================

fn write_todo_db(entries: [TodoEntry], output_path: text):
    var lines: [text] = []
    lines.push("todos |id, keyword, area, priority, description, file, line, issue, blocked, status, valid|")

    for entry in entries:
        val desc_escaped = entry.description.replace("\"", "'")
        val valid_text = if entry.valid: "true" else: "false"
        lines.push("    {entry.id}, {entry.keyword}, {entry.area}, {entry.priority}, \"{desc_escaped}\", {entry.file}, {entry.line}, {entry.issue}, \"{entry.blocked}\", {entry.status}, {valid_text}")

    val content = lines.join("\n") + "\n"
    file_write(output_path, content)

# ============================================================================
# Output: Markdown Report
# ============================================================================

fn write_todo_md(entries: [TodoEntry], output_path: text):
    var lines: [text] = []
    lines.push("# TODO Tracking")
    lines.push("")

    # Count stats
    var open_count = 0
    var blocked_count = 0
    var p0_count = 0
    var p1_count = 0

    for entry in entries:
        if entry.status == "open":
            open_count = open_count + 1
        if entry.blocked.len() > 0:
            blocked_count = blocked_count + 1
        if entry.priority == "P0":
            p0_count = p0_count + 1
        if entry.priority == "P1":
            p1_count = p1_count + 1

    lines.push("**Total:** {entries.len()} items | **Open:** {open_count} | **Blocked:** {blocked_count}")
    lines.push("")

    # By priority
    lines.push("## By Priority")
    lines.push("")
    lines.push("| Priority | Count |")
    lines.push("|----------|-------|")

    var p_counts = {}
    for entry in entries:
        val p = entry.priority
        if p_counts.has(p):
            p_counts[p] = p_counts[p] + 1
        else:
            p_counts[p] = 1

    for p_key in ["P0", "P1", "P2", "P3"]:
        val p_count = if p_counts.has(p_key): p_counts[p_key] else: 0
        lines.push("| {p_key} | {p_count} |")

    lines.push("")

    # By area
    lines.push("## By Area")
    lines.push("")
    lines.push("| Area | Count |")
    lines.push("|------|-------|")

    var a_counts = {}
    for entry in entries:
        val a = entry.area
        if a_counts.has(a):
            a_counts[a] = a_counts[a] + 1
        else:
            a_counts[a] = 1

    for a_key in a_counts.keys():
        lines.push("| {a_key} | {a_counts[a_key]} |")

    lines.push("")

    # P0 Critical section
    if p0_count > 0:
        lines.push("## P0 Critical")
        lines.push("")
        for entry in entries:
            if entry.priority == "P0":
                val issue_text = if entry.issue.len() > 0: " [#{entry.issue}]" else: ""
                lines.push("- [{entry.keyword}] **{entry.description}**{issue_text} - `{entry.file}:{entry.line}`")
        lines.push("")

    # P1 High section
    if p1_count > 0:
        lines.push("## P1 High Priority")
        lines.push("")
        for entry in entries:
            if entry.priority == "P1":
                val issue_text = if entry.issue.len() > 0: " [#{entry.issue}]" else: ""
                lines.push("- [{entry.keyword}] {entry.description}{issue_text} - `{entry.file}:{entry.line}`")
        lines.push("")

    # All TODOs
    lines.push("## All TODOs")
    lines.push("")
    lines.push("| # | Type | Area | Priority | Description | File | Line |")
    lines.push("|---|------|------|----------|-------------|------|------|")
    for entry in entries:
        lines.push("| {entry.id} | {entry.keyword} | {entry.area} | {entry.priority} | {entry.description} | `{entry.file}` | {entry.line} |")

    val content = lines.join("\n") + "\n"
    file_write(output_path, content)

# ============================================================================
# Main Entry Point
# ============================================================================

fn main() -> i64:
    val args = get_cli_args()
    val log_opts = parse_log_options(args)
    if not log_opts.valid:
        error("todo-scan", log_opts.error)
        return 1

    var as_json = log_opts.log_mode == "json"
    var ai = 0
    while ai < args.len():
        val arg = args[ai]
        if arg == "-h" or arg == "--help":
            print_help()
            return 0
        elif arg == "--json" or arg == "--log-mode=json":
            as_json = true
        elif arg == "--log-mode" or arg == "--surface" or arg == "--progress":
            ai = ai + 1
        elif _is_log_option(arg):
            pass
        ai = ai + 1

    val root = cwd()
    if not as_json:
        print "Scanning TODOs from {root}"

    # Collect source files
    val files = collect_source_files(root)
    if not as_json:
        print "Found {files.len()} source files to scan"

    # Scan all files
    var entries: [TodoEntry] = []
    var next_id = 0

    # `collect_source_files` reports symlink-resolved paths, so strip the
    # resolved root as well as the literal one (they differ when the checkout
    # itself is reached through a symlink).
    val root_prefix = root + "/"
    val prefix_len = root_prefix.len()
    val real_root_prefix = real_path(root) + "/"
    val real_prefix_len = real_root_prefix.len()
    for f in files:
        val file_entries = scan_file(f, next_id)
        for entry in file_entries:
            # Make path relative by stripping root prefix
            var rel_path = entry.file
            if rel_path.starts_with(real_root_prefix):
                rel_path = rel_path[real_prefix_len:]
            elif rel_path.starts_with(root_prefix):
                rel_path = rel_path[prefix_len:]
            entries.push(TodoEntry(
                id: entry.id,
                keyword: entry.keyword,
                area: entry.area,
                priority: entry.priority,
                description: entry.description,
                file: rel_path,
                line: entry.line,
                issue: entry.issue,
                blocked: entry.blocked,
                status: entry.status
            ))
        next_id = next_id + file_entries.len()

    if log_opts.progress != "summary":
        val progress_line = render_progress(log_opts.progress, files.len(), files.len(), "todo-scan")
        if progress_line != "":
            print progress_line

    if not as_json:
        print "Scan complete: {entries.len()} TODOs found"

    # Write outputs
    dir_create_all("{root}/doc/08_tracking/todo")

    # Merge with the committed db: curated rows (statuses, blocked reasons,
    # closed history) and every existing id must survive the scan. Without
    # this the db is rebuilt from the fresh scan alone, renumbering every id
    # and dropping every hand-maintained row.
    val db_path = "{root}/doc/08_tracking/todo/todo_db.sdn"
    var existing: [TodoEntry] = []
    if file_exists(db_path):
        existing = read_todo_db(db_path)
    val merged = merge_entries(existing, entries)
    write_todo_db(merged.entries, db_path)
    if not as_json:
        print "Database saved to {db_path}"
        print "Merge: {merged.carried} carried, {merged.added} new, {merged.closed} closed"

    val md_path = "{root}/doc/TODO.md"
    write_todo_md(entries, md_path)
    if as_json:
        val root_json = _json_escape(root)
        val db_json = _json_escape(db_path)
        val md_json = _json_escape(md_path)
        print "{\"command\":\"todo-scan\",\"status\":\"ok\",\"root\":\"{root_json}\",\"files\":{files.len()},\"todos\":{entries.len()},\"db\":\"{db_json}\",\"markdown\":\"{md_json}\"}"
    else:
        print "Generated docs to {md_path}"

    0
