"""
# sj daemon — request handler
"""

use std.io_runtime
use std.service.traits
use std.service.lease_manager
use app.sj_daemon.forbidden
use app.sj_daemon.git_mimic
use app.sj_daemon.jj_exec
use app.sj_daemon.submodule_policy
use std.scv.jj_adapter.{scv_jj_exec}

extern fn rt_getpid() -> i64

struct CommandResponse:
    exit_code: i64
    stdout: text
    stderr: text
    classification: text
    lease_kind: i64

struct SjRequestHandler:
    repo_path: text
    max_hold_ms: i64
    lease_manager: LeaseManager

fn sj_request_handler_new(repo_path: text, max_hold_ms: i64) -> SjRequestHandler:
    SjRequestHandler(
        repo_path: repo_path,
        max_hold_ms: max_hold_ms,
        lease_manager: lease_manager_new()
    )

fn _split_words(input: text) -> [text]:
    val raw = input.split(" ")
    var out: [text] = []
    var i = 0i64
    while i < raw.len():
        if raw[i].len() > 0i64:
            out.push(raw[i])
        i = i + 1i64
    out

fn _drop_first(words: [text]) -> [text]:
    var out: [text] = []
    var i = 1i64
    while i < words.len():
        out.push(words[i])
        i = i + 1i64
    out

fn _json_escape(s: text) -> text:
    s

fn response_json(resp: CommandResponse) -> text:
    "{\"exit_code\":{resp.exit_code},\"stdout\":\"{_json_escape(resp.stdout)}\",\"stderr\":\"{_json_escape(resp.stderr)}\",\"classification\":\"{resp.classification}\",\"lease_kind\":{resp.lease_kind}}"

fn handle_cli_args(handler: SjRequestHandler, argv: [text], pid: i64) -> CommandResponse:
    val policy = check_forbidden(argv)
    if not policy.allowed:
        return CommandResponse(
            exit_code: policy.exit_code,
            stdout: "",
            stderr: policy.message,
            classification: "forbidden",
            lease_kind: LEASE_EXCLUSIVE
        )

    val plan = translate(argv)
    val lease = if plan.lease_kind == LEASE_SHARED:
        try_acquire_shared(handler.lease_manager, pid, 5000i64)
    else:
        try_acquire_exclusive(handler.lease_manager, pid, handler.max_hold_ms)
    if not lease.ok:
        return CommandResponse(
            exit_code: 75i64,
            stdout: "",
            stderr: lease.busy_message,
            classification: plan.classification,
            lease_kind: plan.lease_kind
        )

    val sub = classify_submodule(argv)
    # SCV-IMPL-B-02: jj commands are now EXECUTED through the mutating adapter
    # (std.scv.jj_adapter) rather than merely built and echoed back as stdout.
    # Before this change every branch below pushed `build_command(...)` — a
    # string — so `sj raw jj log -r @` printed the command instead of a commit
    # id and always exited 0. Execution happens here, INSIDE the lease (the
    # release below is deliberately after this loop); a refusal from the version
    # pin surfaces as exit_code 2 with the adapter's ERROR line on stderr.
    # Non-jj (git / raw passthrough) commands keep the previous build-only
    # behaviour — they are the git_mimic lane, out of B-02's scope.
    #
    # BEHAVIOURAL DELTA A REVIEWER MUST SEE: because the translator maps
    # `sj git push --bookmark X` to the string "jj git push --bookmark X", that
    # path now really PUSHES where before it only echoed the command. This is
    # sj's documented purpose (CLAUDE.md's land flow), and check_forbidden above
    # still runs first — but note check_forbidden only inspects argv when
    # argv[0] == "git", so `sj raw jj git push ...` reaches execution ungated.
    # Deliberately NOT gated further here: push policy belongs to B-01, the
    # transaction owner. Flagged for B-01 rather than silently widened.
    var outputs: [text] = []
    var exec_errors: [text] = []
    var exec_code = 0i64
    var i = 0i64
    while i < plan.commands.len():
        val cmd = plan.commands[i]
        if cmd.starts_with("jj "):
            # NOTE: translate() joins argv into a string, so re-splitting here
            # loses quoting for multi-word arguments. That loss is pre-existing
            # in the translator and is not introduced by B-02; callers needing
            # exact argv should use the typed std.scv.jj_adapter API directly.
            val jj_argv = _drop_first(_split_words(cmd))
            val res = scv_jj_exec(handler.repo_path, jj_argv)
            if res.stdout.len() > 0i64:
                outputs.push(res.stdout.trim_end())
            if res.stderr.len() > 0i64:
                exec_errors.push(res.stderr.trim_end())
            if not res.ok:
                exec_code = res.exit_code
        else:
            outputs.push(cmd)
        i = i + 1i64
    if sub.auto_pin_cmd.len() > 0i64:
        outputs.push(sub.auto_pin_cmd)

    val _released = release_lease(handler.lease_manager, lease.lease_id)
    var stderr = plan.warning
    if stderr.len() == 0i64:
        stderr = sub.warning
    else if sub.warning.len() > 0i64:
        stderr = stderr + "\n" + sub.warning
    if exec_errors.len() > 0i64:
        val joined = exec_errors.join("\n")
        if stderr.len() == 0i64:
            stderr = joined
        else:
            stderr = stderr + "\n" + joined
    CommandResponse(
        exit_code: exec_code,
        stdout: outputs.join("\n"),
        stderr: stderr,
        classification: plan.classification,
        lease_kind: plan.lease_kind
    )

impl RequestHandler for SjRequestHandler:
    fn handle(self, req: text) -> text:
        response_json(handle_cli_args(self, _split_words(req), rt_getpid()))
