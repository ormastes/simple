"""
# sj daemon — forbidden verb policy
"""

use std.io_runtime

struct PolicyResult:
    allowed: bool
    exit_code: i64
    message: text

fn policy_allow() -> PolicyResult:
    PolicyResult(allowed: true, exit_code: 0i64, message: "")

fn policy_forbid(message: text) -> PolicyResult:
    PolicyResult(allowed: false, exit_code: 1i64, message: message)

fn _has_arg(argv: [text], needle: text) -> bool:
    var i = 0i64
    while i < argv.len():
        if argv[i] == needle:
            return true
        i = i + 1i64
    false

fn _is_protected_ref(value: text) -> bool:
    var name = value
    if name.starts_with("+"):
        name = name[1:]
    val sides = name.split(":")
    for side in sides:
        var ref = side
        if ref.starts_with("refs/heads/"):
            ref = ref[11:]
        elif ref.starts_with("refs/tags/"):
            ref = ref[10:]
        if ref == "main" or ref.starts_with("release/") or ref.starts_with("candidate/") or ref.starts_with("v"):
            return true
    false

fn _is_work_destination(value: text) -> bool:
    var name = value
    if name.starts_with("+"):
        return false
    val sides = name.split(":")
    if sides.len() > 1i64:
        name = sides[sides.len() - 1i64]
    if name.starts_with("refs/heads/"):
        name = name[11:]
    if not name.starts_with("work/") or name.len() > 96i64 or name.ends_with("/") or name.contains("..") or name.contains("//"):
        return false
    for ch in name.chars():
        if not ((ch >= "a" and ch <= "z") or (ch >= "0" and ch <= "9") or ch == "/" or ch == "-" or ch == "_" or ch == "."):
            return false
    true

fn _protected_arg_present(argv: [text], start: i64) -> bool:
    var i = start
    while i < argv.len():
        if _is_protected_ref(argv[i]):
            return true
        i = i + 1i64
    false

fn _work_push_is_explicit(argv: [text]) -> bool:
    if _has_arg(argv, "--delete") or _has_arg(argv, "-d") or _has_arg(argv, "--mirror") or _has_arg(argv, "--all") or _has_arg(argv, "--tags"):
        return false
    if _has_arg(argv, "--force") or _has_arg(argv, "-f") or _has_arg(argv, "--force-with-lease") or _has_arg(argv, "--force-if-includes"):
        return false
    var found = false
    var i = 2i64
    while i < argv.len():
        val arg = argv[i]
        if arg == "--bookmark":
            if i + 1i64 >= argv.len() or not _is_work_destination(argv[i + 1i64]):
                return false
            found = true
            i = i + 2i64
        elif arg == "--set-upstream" or arg == "-u":
            i = i + 1i64
        elif arg.starts_with("-"):
            i = i + 1i64
        elif i == 2i64:
            # The first positional argument is the remote. A ref is mandatory.
            i = i + 1i64
        else:
            if not _is_work_destination(arg):
                return false
            found = true
            i = i + 1i64
    found

fn _raw_mutation(argv: [text]) -> bool:
    if argv.len() < 3i64 or argv[0i64] != "raw":
        return false
    if argv[1i64] == "git":
        val verb = argv[2i64]
        return verb == "push" or verb == "tag" or verb == "update-ref" or verb == "branch"
    if argv[1i64] == "jj":
        val verb = argv[2i64]
        if verb == "bookmark" or verb == "tag":
            return true
        return verb == "git" and argv.len() > 3i64 and argv[3i64] == "push"
    false

fn _git_tag_is_read_only(argv: [text]) -> bool:
    if argv.len() == 2i64:
        return true
    var i = 2i64
    while i < argv.len():
        val arg = argv[i]
        if not (arg == "-l" or arg == "--list" or arg == "--contains" or
                arg == "--points-at" or arg == "--sort" or arg.starts_with("--format")):
            return false
        i = i + 1i64
    true

fn _git_branch_is_read_only(argv: [text]) -> bool:
    if argv.len() == 2i64:
        return true
    var i = 2i64
    while i < argv.len():
        val arg = argv[i]
        if not (arg == "-a" or arg == "--all" or arg == "-r" or arg == "--remotes" or
                arg == "--list" or arg == "--show-current" or arg == "--contains" or
                arg == "--merged" or arg == "--no-merged" or arg.starts_with("--format")):
            return false
        i = i + 1i64
    true

fn check_forbidden(argv: [text]) -> PolicyResult:
    if argv.len() < 2i64:
        return policy_allow()
    if _raw_mutation(argv):
        return policy_forbid("ERROR[FORBIDDEN]: raw Git/JJ ref mutation is denied. Use an owned work/* session branch; protected refs require the integration or release authority.")
    if argv[0i64] == "bookmark" and (argv[1i64] == "set" or argv[1i64] == "move" or argv[1i64] == "create" or argv[1i64] == "delete" or argv[1i64] == "forget" or argv[1i64] == "rename") and _protected_arg_present(argv, 2i64):
        return policy_forbid("ERROR[FORBIDDEN]: direct mutation of a protected bookmark is denied; submit an owned work/* branch to the integration authority.")
    if argv[0i64] == "tag" and argv[1i64] != "list" and _protected_arg_present(argv, 2i64):
        return policy_forbid("ERROR[FORBIDDEN]: direct release-tag mutation is denied; the release authority creates signed immutable tags after admission.")
    if argv[0i64] != "git":
        return policy_allow()

    val verb = argv[1i64]
    if verb == "rebase" and _has_arg(argv, "-i"):
        return policy_forbid("ERROR[FORBIDDEN]: git rebase -i is not supported here. Use sj split, sj squash --into, or sj rebase --onto instead.")
    if verb == "push" and not _work_push_is_explicit(argv):
        return policy_forbid("ERROR[FORBIDDEN]: push requires one explicit owned work/* destination. Protected refs, deletion, bulk push, via-worktree, and force variants require authority and are denied here.")
    if (verb == "update-ref" or (verb == "tag" and not _git_tag_is_read_only(argv)) or
        (verb == "branch" and not _git_branch_is_read_only(argv))):
        return policy_forbid("ERROR[FORBIDDEN]: raw ref mutation is denied. Use typed work/* bookmark operations or the integration/release authority.")
    if verb == "checkout" and argv.len() == 2i64:
        return policy_forbid("ERROR[FORBIDDEN]: bare 'git checkout' with no arguments is not meaningful in a jj-managed repo. Use sj git checkout <rev> or sj git checkout -b <branch> [base]")
    if verb == "filter-branch":
        return policy_forbid("ERROR[FORBIDDEN]: git filter-branch rewrites history outside jj's operation log. Use sj raw git filter-branch only if you accept the risk.")
    if verb == "stash":
        return policy_forbid("ERROR[FORBIDDEN]: use 'jj new -m wip-<topic>' instead - jj's working-copy-as-commit makes stash unnecessary")
    policy_allow()
