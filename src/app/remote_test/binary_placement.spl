# Target-filesystem placement and command rendering for remote Simple execution.

fn remote_simple_binary_path(remote_os: text, configured: text) -> Result<text, text>:
    """Resolve the interpreter/compiler path in the remote filesystem."""
    val requested = configured.trim()
    val platform = remote_os.trim().lower()
    if requested != "" and requested.lower() != "auto":
        if (platform == "windows" or platform == "win" or platform == "linux" or
                platform == "simpleos" or platform == "simple-os") and configured != requested:
            return Err("explicit remote Simple binary path must not have outer whitespace")
        if (platform == "windows" or platform == "win") and
                not _remote_path_is_absolute(requested, true):
            return Err("explicit remote Windows Simple binary path must be absolute")
        if (platform == "windows" or platform == "win") and
                not _remote_path_has_file_leaf(requested, true):
            return Err("explicit remote Windows Simple binary path must name a file")
        if (platform == "linux" or platform == "simpleos" or
                platform == "simple-os") and not _remote_path_is_absolute(requested, false):
            return Err("explicit remote POSIX Simple binary path must be absolute")
        if (platform == "linux" or platform == "simpleos" or
                platform == "simple-os") and not _remote_path_has_file_leaf(requested, false):
            return Err("explicit remote POSIX Simple binary path must name a file")
        return Ok(requested)
    if platform == "linux": return Ok("/usr/local/bin/simple")
    if platform == "windows" or platform == "win": return Ok("C:\\Program Files\\Simple\\simple.exe")
    if platform == "simpleos" or platform == "simple-os": return Ok("/usr/bin/simple")
    Err("remote-test cannot place the Simple binary for remote OS '{remote_os}'; use --remote-os linux|windows|simpleos or an explicit --simple-bin path")

fn _remote_posix_quote(value: text) -> text:
    "'" + value.replace("'", "'\"'\"'") + "'"

fn _remote_posix_parent(value: text) -> text:
    val slash = value.last_index_of("/") ?? -1
    if slash <= 0: return "/"
    value[0:slash]

fn _remote_powershell_quote(value: text) -> text:
    "'" + value.replace("'", "''") + "'"

fn _remote_windows_command_value(value: text) -> Result<text, text>:
    if value.contains("\"") or value.contains("\r") or value.contains("\n"):
        return Err("remote-test Windows command values cannot contain quotes or line breaks")
    Ok(_remote_powershell_quote(value))

fn _remote_windows_same_path(left: text, right: text) -> bool:
    _remote_normalize_path(left, true) == _remote_normalize_path(right, true)

fn _remote_path_is_absolute(value: text, windows: bool) -> bool:
    val path = if windows: value.replace("\\", "/") else: value
    if windows:
        val drive = if path.len() > 0: path[0:1].lower() else: ""
        return path.starts_with("//") or
            (path.len() >= 3 and drive >= "a" and drive <= "z" and
                path[1:2] == ":" and path[2:3] == "/")
    path.starts_with("/")

fn _remote_path_has_file_leaf(value: text, windows: bool) -> bool:
    val lexical = if windows: value.replace("\\", "/") else: value
    if lexical.ends_with("/"): return false
    val normalized = _remote_normalize_path(value, windows)
    if windows and normalized.len() >= 3 and normalized[1:3] == ":/":
        return normalized.len() > 3 and _remote_windows_file_path_valid(lexical, false)
    if windows and normalized.starts_with("//"):
        # A UNC file needs server, share, and leaf components.
        val unc_tail = normalized.substring(2)
        val unc_parts = unc_tail.split("/")
        return unc_parts.len() >= 3 and _remote_windows_file_path_valid(lexical, true)
    normalized != "/" and normalized != "" and _remote_posix_file_path_valid(lexical)

fn _remote_posix_file_path_valid(value: text) -> bool:
    for character in value.chars():
        val code = character.char_code_at(0)
        if code < 32 or code == 127: return false
    true

fn _remote_windows_component_syntax_valid(component: text) -> bool:
    if component == "" or component.ends_with(".") or component.ends_with(" "):
        return false
    if component.contains(":") or component.contains("<") or component.contains(">") or
            component.contains("\"") or component.contains("|") or component.contains("?") or
            component.contains("*"):
        return false
    true

fn _remote_windows_component_valid(component: text) -> bool:
    if not _remote_windows_component_syntax_valid(component): return false
    val stem = component.lower().split(".")[0]
    if stem == "con" or stem == "prn" or stem == "aux" or stem == "nul" or
            stem == "conin$" or stem == "conout$" or stem == "clock$":
        return false
    if stem.len() == 4 and (stem.starts_with("com") or stem.starts_with("lpt")):
        val suffix = stem[3:4]
        if suffix >= "1" and suffix <= "9": return false
    true

fn _remote_windows_file_path_valid(value: text, unc: bool) -> bool:
    val slash_path = value.replace("\\", "/")
    if slash_path.starts_with("//?/") or slash_path.starts_with("//./"):
        return false
    for character in slash_path.chars():
        val code = character.char_code_at(0)
        if code < 32 or code == 127: return false
    val tail = if unc: slash_path.substring(2) else: slash_path.substring(3)
    val parts = tail.split("/")
    val first_file_component: i64 = if unc: 2 else: 0
    if parts.len() <= first_file_component: return false
    if unc and (not _remote_windows_component_syntax_valid(parts[0]) or
            not _remote_windows_component_syntax_valid(parts[1])):
        return false
    var i = first_file_component
    while i < parts.len():
        # Repeated separators are harmless lexical aliases and normalize away.
        if parts[i] != "" and parts[i] != "." and parts[i] != ".." and
                not _remote_windows_component_valid(parts[i]):
            return false
        i = i + 1
    _remote_windows_component_valid(parts[parts.len() - 1])

fn _remote_normalize_path(value: text, windows: bool) -> text:
    """Lexically normalize a target path without consulting the local host."""
    var path = if windows: value.replace("\\", "/") else: value
    var prefix = ""
    if windows and path.len() >= 2 and path[1:2] == ":":
        prefix = path[0:2].lower() + "/"
        path = path.substring(2)
    elif windows and path.starts_with("//"):
        prefix = "//"
        path = path.substring(2)
    elif path.starts_with("/"):
        prefix = "/"
        path = path.substring(1)
    var parts: [text] = []
    for part in path.split("/"):
        if part == "" or part == ".": continue
        if part == "..":
            if parts.len() > 0 and parts[parts.len() - 1] != "..":
                parts.pop()
            elif prefix == "":
                parts = parts.push(part)
        else:
            parts = parts.push(if windows: part.lower() else: part)
    prefix + parts.join("/")

fn _remote_validate_staging_path(remote_os: text, staged_path: text,
        destination: text) -> Result<bool, text>:
    val staged = staged_path.trim()
    if staged == "": return Err("remote Simple staging path is empty")
    val temporary = destination + ".remote-test-new"
    val platform = remote_os.trim().lower()
    if platform == "windows" or platform == "win":
        if staged_path != staged:
            return Err("remote Windows Simple staging path must not have outer whitespace")
        if not _remote_path_is_absolute(staged, true) or
                not _remote_path_is_absolute(destination, true):
            return Err("remote Windows Simple staging and installed paths must be absolute")
        if not _remote_path_has_file_leaf(staged, true) or
                not _remote_path_has_file_leaf(destination, true):
            return Err("remote Windows Simple staging and installed paths must name files")
        if _remote_windows_same_path(staged, destination) or
                _remote_windows_same_path(staged, temporary):
            return Err("remote Simple staging path must differ from the installed and publication paths")
    else:
        if staged_path != staged:
            return Err("remote POSIX Simple staging path must not have outer whitespace")
        if not _remote_path_is_absolute(staged, false) or
                not _remote_path_is_absolute(destination, false):
            return Err("remote POSIX Simple staging and installed paths must be absolute")
        if not _remote_path_has_file_leaf(staged, false) or
                not _remote_path_has_file_leaf(destination, false):
            return Err("remote POSIX Simple staging and installed paths must name files")
        val normalized = _remote_normalize_path(staged, false)
        if normalized == _remote_normalize_path(destination, false) or
                normalized == _remote_normalize_path(temporary, false):
            return Err("remote Simple staging path must differ from the installed and publication paths")
    Ok(true)

fn remote_simple_test_command(remote_os: text, configured: text,
        test_path: text) -> Result<text, text>:
    """Render a target-specific quoted remote `simple test` command."""
    val binary = remote_simple_binary_path(remote_os, configured)
    if binary.is_err(): return Err(binary.unwrap_err())
    val platform = remote_os.trim().lower()
    if platform == "windows" or platform == "win":
        val executable = _remote_windows_command_value(binary.unwrap())
        if executable.is_err(): return Err(executable.unwrap_err())
        val test = _remote_windows_command_value(test_path)
        if test.is_err(): return Err(test.unwrap_err())
        return Ok("powershell.exe -NoProfile -NonInteractive -Command \"& " +
            executable.unwrap() + " test " + test.unwrap() +
            " --no-session-daemon --sequential 2>&1; exit $LASTEXITCODE\"")
    if platform == "linux" or platform == "simpleos" or platform == "simple-os":
        return Ok(_remote_posix_quote(binary.unwrap()) + " test " +
            _remote_posix_quote(test_path) + " --no-session-daemon --sequential 2>&1")
    Err("remote-test cannot render a command for remote OS '{remote_os}'")

fn remote_simple_stage_guard_command(remote_os: text, configured: text,
        staged_path: text) -> Result<text, text>:
    """Render the pre-upload absence guard for staging and publication leaves."""
    val binary = remote_simple_binary_path(remote_os, configured)
    if binary.is_err(): return Err(binary.unwrap_err())
    val destination = binary.unwrap()
    val staging = _remote_validate_staging_path(remote_os, staged_path, destination)
    if staging.is_err(): return Err(staging.unwrap_err())
    val temporary_path = destination + ".remote-test-new"
    val platform = remote_os.trim().lower()
    if platform == "windows" or platform == "win":
        val stage = _remote_windows_command_value(staged_path)
        if stage.is_err(): return Err(stage.unwrap_err())
        val temporary = _remote_windows_command_value(temporary_path)
        if temporary.is_err(): return Err(temporary.unwrap_err())
        return Ok("powershell.exe -NoProfile -NonInteractive -Command \"$ErrorActionPreference = 'Stop'; " +
            "$stage = " + stage.unwrap() + "; $tmp = " + temporary.unwrap() + "; " +
            "if (($null -ne (Get-Item -LiteralPath $stage -Force -ErrorAction SilentlyContinue)) -or " +
            "($null -ne (Get-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue))) " +
            "{ Write-Error 'remote-test staging or publication path already exists'; exit 73 }\"")
    if platform == "linux" or platform == "simpleos" or platform == "simple-os":
        val stage = _remote_posix_quote(staged_path)
        val temporary = _remote_posix_quote(temporary_path)
        return Ok("if [ -e " + stage + " ] || [ -L " + stage + " ] || [ -e " +
            temporary + " ] || [ -L " + temporary + " ]; then " +
            "echo 'remote-test staging or publication path already exists' >&2; exit 73; fi")
    Err("remote-test cannot render a staging guard for remote OS '{remote_os}'")

fn _remote_sha256_valid(digest: text) -> bool:
    if digest.len() != 64: return false
    var i: i64 = 0
    while i < digest.len():
        val ch = digest[i:i + 1]
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return false
        i = i + 1
    true

fn remote_simple_stage_verify_command(remote_os: text, staged_path: text,
        expected_sha256: text) -> Result<text, text>:
    """Render a target-side digest check for the uploaded interpreter."""
    val digest = expected_sha256.trim().lower()
    if not _remote_sha256_valid(digest):
        return Err("remote Simple expected SHA-256 must be 64 hexadecimal digits")
    val platform = remote_os.trim().lower()
    if platform == "windows" or platform == "win":
        if staged_path != staged_path.trim() or
                not _remote_path_is_absolute(staged_path, true) or
                not _remote_path_has_file_leaf(staged_path, true):
            return Err("remote Windows Simple staging path must be an exact absolute file path")
        val stage = _remote_windows_command_value(staged_path)
        if stage.is_err(): return Err(stage.unwrap_err())
        return Ok("powershell.exe -NoProfile -NonInteractive -Command \"$ErrorActionPreference = 'Stop'; " +
            "$actual = (Get-FileHash -LiteralPath " + stage.unwrap() + " -Algorithm SHA256).Hash.ToLowerInvariant(); " +
            "if ($actual -ne '" + digest + "') { Write-Error 'remote-test uploaded Simple SHA-256 mismatch'; exit 74 }\"")
    if platform == "linux" or platform == "simpleos" or platform == "simple-os":
        if staged_path != staged_path.trim() or
                not _remote_path_is_absolute(staged_path, false) or
                not _remote_path_has_file_leaf(staged_path, false):
            return Err("remote POSIX Simple staging path must be an exact absolute file path")
        val stage = _remote_posix_quote(staged_path)
        return Ok("actual=$(sha256sum -- " + stage + ") || exit 74; actual=${actual%% *}; " +
            "if [ \"$actual\" != '" + digest + "' ]; then " +
            "echo 'remote-test uploaded Simple SHA-256 mismatch' >&2; exit 74; fi")
    Err("remote-test cannot verify an uploaded binary for remote OS '{remote_os}'")

fn remote_simple_stage_cleanup_command(remote_os: text,
        staged_path: text) -> Result<text, text>:
    """Render best-effort cleanup for a staging leaf owned by this upload."""
    val platform = remote_os.trim().lower()
    if platform == "windows" or platform == "win":
        if staged_path != staged_path.trim() or
                not _remote_path_is_absolute(staged_path, true) or
                not _remote_path_has_file_leaf(staged_path, true):
            return Err("remote Windows Simple staging cleanup path must be an exact absolute file path")
        val stage = _remote_windows_command_value(staged_path)?
        return Ok("powershell.exe -NoProfile -NonInteractive -Command \"$ErrorActionPreference = 'Stop'; " +
            "$item = Get-Item -LiteralPath " + stage + " -Force -ErrorAction SilentlyContinue; " +
            "if ($null -eq $item) { exit 0 }; " +
            "if ($item.PSIsContainer -or (($item.Attributes -band " +
            "[System.IO.FileAttributes]::ReparsePoint) -ne 0)) " +
            "{ Write-Error 'remote-test refuses to clean a non-regular staging path'; exit 77 }; " +
            "Remove-Item -LiteralPath " + stage + " -Force\"")
    if platform == "linux" or platform == "simpleos" or platform == "simple-os":
        if staged_path != staged_path.trim() or
                not _remote_path_is_absolute(staged_path, false) or
                not _remote_path_has_file_leaf(staged_path, false):
            return Err("remote POSIX Simple staging cleanup path must be an exact absolute file path")
        val stage = _remote_posix_quote(staged_path)
        return Ok("if [ -L " + stage + " ] || { [ -e " + stage +
            " ] && [ ! -f " + stage + " ]; }; then " +
            "echo 'remote-test refuses to clean a non-regular staging path' >&2; exit 77; fi; " +
            "if [ -f " + stage + " ]; then rm -f -- " + stage + "; fi")
    Err("remote-test cannot clean an uploaded binary for remote OS '{remote_os}'")

fn remote_simple_publication_cleanup_command(remote_os: text,
        configured: text) -> Result<text, text>:
    """Render regular-file-only cleanup for a failed publication sibling."""
    val binary = remote_simple_binary_path(remote_os, configured)?
    val temporary = binary + ".remote-test-new"
    val platform = remote_os.trim().lower()
    if platform == "windows" or platform == "win":
        val path = _remote_windows_command_value(temporary)?
        return Ok("powershell.exe -NoProfile -NonInteractive -Command \"$ErrorActionPreference = 'Stop'; " +
            "$item = Get-Item -LiteralPath " + path + " -Force -ErrorAction SilentlyContinue; " +
            "if ($null -eq $item) { exit 0 }; " +
            "if ($item.PSIsContainer -or (($item.Attributes -band " +
            "[System.IO.FileAttributes]::ReparsePoint) -ne 0)) " +
            "{ Write-Error 'remote-test refuses to clean a non-regular publication path'; exit 78 }; " +
            "Remove-Item -LiteralPath " + path + " -Force\"")
    if platform == "linux" or platform == "simpleos" or platform == "simple-os":
        val path = _remote_posix_quote(temporary)
        return Ok("if [ -L " + path + " ] || { [ -e " + path +
            " ] && [ ! -f " + path + " ]; }; then " +
            "echo 'remote-test refuses to clean a non-regular publication path' >&2; exit 78; fi; " +
            "if [ -f " + path + " ]; then rm -f -- " + path + "; fi")
    Err("remote-test cannot clean a publication sibling for remote OS '{remote_os}'")

fn remote_simple_install_command(remote_os: text, configured: text,
        staged_path: text, expected_sha256: text) -> Result<text, text>:
    """Publish an uploaded binary at the target-owned Simple path.

    The caller uploads to `staged_path` first. Publication uses a sibling
    temporary file so a failed copy or permission change cannot replace a
    working interpreter with a partial binary.
    """
    val binary = remote_simple_binary_path(remote_os, configured)
    if binary.is_err(): return Err(binary.unwrap_err())
    val digest = expected_sha256.trim().lower()
    if not _remote_sha256_valid(digest):
        return Err("remote Simple expected SHA-256 must be 64 hexadecimal digits")
    val destination = binary.unwrap()
    val staging = _remote_validate_staging_path(remote_os, staged_path, destination)
    if staging.is_err(): return Err(staging.unwrap_err())
    val platform = remote_os.trim().lower()
    if platform == "windows" or platform == "win":
        val source = _remote_windows_command_value(staged_path)
        if source.is_err(): return Err(source.unwrap_err())
        val target = _remote_windows_command_value(destination)
        if target.is_err(): return Err(target.unwrap_err())
        return Ok("powershell.exe -NoProfile -NonInteractive -Command \"$ErrorActionPreference = 'Stop'; " +
            "$src = " + source.unwrap() + "; $dst = " + target.unwrap() + "; " +
            "$tmp = $dst + '.remote-test-new'; " +
            "New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dst) | Out-Null; " +
            "$input = [System.IO.File]::OpenRead($src); try { " +
            "$output = [System.IO.File]::Open($tmp, [System.IO.FileMode]::CreateNew, " +
            "[System.IO.FileAccess]::Write, [System.IO.FileShare]::None); try { " +
            "$input.CopyTo($output); $output.Flush($true) } finally { $output.Dispose() } " +
            "} finally { $input.Dispose() }; " +
            "$actual = (Get-FileHash -LiteralPath $tmp -Algorithm SHA256).Hash.ToLowerInvariant(); " +
            "if ($actual -ne '" + digest + "') { Remove-Item -LiteralPath $tmp -Force; " +
            "Write-Error 'remote-test publication copy SHA-256 mismatch'; exit 75 }; " +
            "$existing = Get-Item -LiteralPath $dst -Force -ErrorAction SilentlyContinue; " +
            "if (($null -ne $existing) -and ($existing.PSIsContainer -or " +
            "(($existing.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0))) " +
            "{ Remove-Item -LiteralPath $tmp -Force; " +
            "Write-Error 'remote-test installed path is not a regular non-reparse file'; exit 76 }; " +
            "Remove-Item -LiteralPath $src -Force; " +
            "if ($null -ne $existing) " +
            "{ [System.IO.File]::Replace($tmp, $dst, $null, $true) } " +
            "else { [System.IO.File]::Move($tmp, $dst) }\"")
    if platform == "linux" or platform == "simpleos" or platform == "simple-os":
        val source = _remote_posix_quote(staged_path)
        val target = _remote_posix_quote(destination)
        val parent = _remote_posix_quote(_remote_posix_parent(destination))
        val temporary = _remote_posix_quote(destination + ".remote-test-new")
        return Ok("mkdir -p -- " + parent + " && (set -C; : > " + temporary +
            ") && cp -- " + source + " " + temporary + " && chmod 0755 -- " + temporary +
            " && { actual=$(sha256sum -- " +
            temporary + ") || { rm -f -- " + temporary + "; exit 75; }; " +
            "actual=${actual%% *}; if [ \"$actual\" != '" + digest + "' ]; then rm -f -- " +
            temporary + "; echo 'remote-test publication copy SHA-256 mismatch' >&2; exit 75; fi; }" +
            " && { if [ -L " + target + " ] || { [ -e " + target + " ] && [ ! -f " +
            target + " ]; }; then rm -f -- " + temporary + "; " +
            "echo 'remote-test installed path is not a regular file' >&2; exit 76; fi; }" +
            " && rm -f -- " + source +
            " && mv -fT -- " + temporary + " " + target)
    Err("remote-test cannot render an install command for remote OS '{remote_os}'")

export remote_simple_binary_path, remote_simple_test_command
export remote_simple_stage_guard_command, remote_simple_stage_verify_command
export remote_simple_stage_cleanup_command, remote_simple_publication_cleanup_command
export remote_simple_install_command
