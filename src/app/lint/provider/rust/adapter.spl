use os.tooling.rust_analyzer_worker.model.{RustAnalysisState, RustAnalysisResultV1}
use common.lint_kernel.model.{LintVerdict}

pub fn rust_result_verdict(result: RustAnalysisResultV1) -> LintVerdict:
    match result.state:
        RustAnalysisState.Complete:
            if result.diagnostics.len() == 0: return LintVerdict.CompleteClean
            LintVerdict.CompleteWithFindings
        RustAnalysisState.Partial: LintVerdict.Partial
        RustAnalysisState.Cancelled: LintVerdict.Cancelled
        RustAnalysisState.TimedOut: LintVerdict.Failed
        RustAnalysisState.Failed: LintVerdict.Failed
