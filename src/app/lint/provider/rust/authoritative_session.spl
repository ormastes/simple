use app.lint.provider.rust.worker.{RustLintWorkerConfigV1, run_rust_lint_worker}
use common.kernel_plugin.ids.{KpfDigest256, KpfId128}
use common.lint_kernel.model.{AnalysisCoverageV1, ArtifactKeyV1, DiagnosticV1, LintRunResultV1, SourceSpanV1, lint_run_result}
use common.lint_kernel.output.model.{LintEditMetadataV1, LintFixApplicabilityV1, LintOutputLocationV1, LintRelatedLocationV1, LintTextEditV1, NormalizedLintDiagnosticV1, NormalizedLintOutputV1}
use os.smf.kernel_plugin.worker_process.{KpfWorkerProcessFacadeV1}
use os.tooling.rust_analyzer_worker.model.{RustAnalysisResultV1, RustAnalysisState, RustDiagnosticV1, RustSuggestionApplicability, RustToolchainIdentityV1}

pub enum RustToolingSessionStateV1:
    Created
    Ready
    Draining
    Closed
    Failed

pub enum RustToolingPublicationStateV1:
    Published
    Stale
    Cancelled
    Incomplete
    Failed

pub struct RustToolingRequestV1:
    generation: u64
    revision: u64
    cancellation_epoch: u64

pub struct RustToolingPublicationV1:
    state: RustToolingPublicationStateV1
    request: RustToolingRequestV1
    identity: RustToolchainIdentityV1
    output: NormalizedLintOutputV1

fn stable_hash(value: text, salt: u64) -> u64:
    var hash = 1469598103934665603u64 ^ salt
    var index = 0
    while index < value.len():
        hash = (hash ^ value.char_code_at(index).to_u64()) * 1099511628211u64
        index = index + 1
    hash

fn stable_id(value: text) -> KpfId128:
    KpfId128(hi: stable_hash(value, 0), lo: stable_hash(value, 1099511628211u64))

fn stable_digest(value: text) -> KpfDigest256:
    KpfDigest256(
        w0: stable_hash(value, 0),
        w1: stable_hash(value, 1),
        w2: stable_hash(value, 2),
        w3: stable_hash(value, 3)
    )

fn empty_identity() -> RustToolchainIdentityV1:
    RustToolchainIdentityV1(cargo_version: "", rustc_version: "", clippy_version: "", rust_analyzer_version: "", workspace_fingerprint: "", configuration_fingerprint: "")

fn identity_complete(identity: RustToolchainIdentityV1) -> bool:
    identity.cargo_version != "" and identity.rustc_version != "" and
        identity.clippy_version != "" and identity.rust_analyzer_version != "" and
        identity.workspace_fingerprint != "" and identity.configuration_fingerprint != ""

fn toolchain_matches(expected: RustToolchainIdentityV1, actual: RustToolchainIdentityV1) -> bool:
    expected.cargo_version == actual.cargo_version and
        expected.rustc_version == actual.rustc_version and
        expected.clippy_version == actual.clippy_version

fn severity(level: text) -> u32:
    if level == "error": return 1
    if level == "warning": return 2
    if level == "note": return 3
    4

fn applicability(value: RustSuggestionApplicability) -> LintFixApplicabilityV1:
    match value:
        RustSuggestionApplicability.MachineApplicable: LintFixApplicabilityV1.MachineApplicable
        RustSuggestionApplicability.MaybeIncorrect: LintFixApplicabilityV1.MaybeIncorrect
        RustSuggestionApplicability.HasPlaceholders: LintFixApplicabilityV1.HasPlaceholders
        RustSuggestionApplicability.Unspecified: LintFixApplicabilityV1.Unspecified

fn normalize_diagnostic(diagnostic: RustDiagnosticV1, identity: RustToolchainIdentityV1, revision: u64) -> NormalizedLintDiagnosticV1:
    val language_id = stable_id("language.rust")
    val provider_id = stable_id("provider.rust.toolchain")
    val workspace_id = stable_id(identity.workspace_fingerprint)
    val path_id = stable_id(diagnostic.span.file_name)
    val configuration_digest = stable_digest(identity.configuration_fingerprint)
    val artifact = ArtifactKeyV1(workspace_id: workspace_id, language_id: language_id, path_id: path_id, target_id: stable_id("rust.target"), configuration_digest: configuration_digest)
    val span = SourceSpanV1(artifact: artifact, revision: revision, start_byte: diagnostic.span.byte_start, end_byte: diagnostic.span.byte_end)
    val location = LintOutputLocationV1(span: span, uri: diagnostic.span.file_name, start_line: diagnostic.span.line_start, start_column: diagnostic.span.column_start, end_line: diagnostic.span.line_end, end_column: diagnostic.span.column_end)
    var fixes: [LintTextEditV1] = []
    var related: [LintRelatedLocationV1] = []
    var conflict_group = 1u64
    for suggestion in diagnostic.suggestions:
        val suggestion_span = SourceSpanV1(artifact: artifact, revision: revision, start_byte: suggestion.span.byte_start, end_byte: suggestion.span.byte_end)
        val suggestion_location = LintOutputLocationV1(span: suggestion_span, uri: suggestion.span.file_name, start_line: suggestion.span.line_start, start_column: suggestion.span.column_start, end_line: suggestion.span.line_end, end_column: suggestion.span.column_end)
        val metadata = LintEditMetadataV1(provider_id: provider_id, language_id: language_id, expected_snapshot_digest: stable_digest(identity.workspace_fingerprint + ":" + revision.to_string()), conflict_group: conflict_group, applicability: applicability(suggestion.applicability))
        fixes.push(LintTextEditV1(location: suggestion_location, replacement: suggestion.replacement, metadata: metadata))
        conflict_group = conflict_group + 1
    for child in diagnostic.children:
        for child_span in child.spans:
            val related_span = SourceSpanV1(artifact: artifact, revision: revision, start_byte: child_span.byte_start, end_byte: child_span.byte_end)
            val related_location = LintOutputLocationV1(span: related_span, uri: child_span.file_name, start_line: child_span.line_start, start_column: child_span.column_start, end_line: child_span.line_end, end_column: child_span.column_end)
            related.push(LintRelatedLocationV1(location: related_location, message: child.message))
    val rule_name = if diagnostic.code == "": "rust.compiler" else: diagnostic.code
    val canonical = DiagnosticV1(rule_id: stable_id(rule_name), provider_id: provider_id, severity: severity(diagnostic.level), category: 1, primary_span: span, message_id: stable_id(diagnostic.message), fix_digest: stable_digest(rule_name + ":" + diagnostic.message))
    NormalizedLintDiagnosticV1(diagnostic: canonical, location: location, rule_name: rule_name, message: diagnostic.message, help: "", related: related, fixes: fixes)

fn normalized_output(result: RustAnalysisResultV1, revision: u64) -> NormalizedLintOutputV1:
    var diagnostics: [NormalizedLintDiagnosticV1] = []
    var error_count = 0u32
    var warning_count = 0u32
    for diagnostic in result.diagnostics:
        diagnostics.push(normalize_diagnostic(diagnostic, result.identity, revision))
        if diagnostic.level == "error": error_count = error_count + 1
        elif diagnostic.level == "warning": warning_count = warning_count + 1
    val complete = result.state == RustAnalysisState.Complete and not result.truncated and result.malformed_record_count == 0
    val cancelled = result.state == RustAnalysisState.Cancelled
    val failed = result.state == RustAnalysisState.Failed or result.state == RustAnalysisState.TimedOut
    val coverage = AnalysisCoverageV1(
        requested_unit_count: 1, admitted_unit_count: if identity_complete(result.identity): 1 else: 0,
        completed_unit_count: if complete: 1 else: 0,
        partial_unit_count: if result.state == RustAnalysisState.Partial or result.truncated or result.malformed_record_count > 0: 1 else: 0,
        not_analyzed_unit_count: if failed: 1 else: 0,
        requested_rule_count: 1, completed_rule_count: if complete: 1 else: 0,
        skipped_rule_count: if complete: 0 else: 1,
        requested_phase_bits: 3, completed_phase_bits: if complete: 3 else: 0,
        provider_receipt_digest: stable_digest(result.identity.configuration_fingerprint),
        input_revision_digest: stable_digest(result.identity.workspace_fingerprint + ":" + revision.to_string())
    )
    val run_result = lint_run_result(coverage, diagnostics.len().to_u32(), error_count, warning_count, cancelled, failed)
    NormalizedLintOutputV1(result: run_result, diagnostics: diagnostics)

pub class RustAuthoritativeToolingSessionV1:
    generation: u64
    latest_revision: u64
    cancellation_epoch: u64
    cancelled_through_revision: u64
    identity: RustToolchainIdentityV1
    supervisor: KpfWorkerProcessFacadeV1
    var state: RustToolingSessionStateV1

impl RustAuthoritativeToolingSessionV1:
    pub static fn create(generation: u64, queue_capacity: i64) -> RustAuthoritativeToolingSessionV1:
        RustAuthoritativeToolingSessionV1(generation: generation, latest_revision: 0, cancellation_epoch: 0, cancelled_through_revision: 0, identity: empty_identity(), supervisor: KpfWorkerProcessFacadeV1.create(queue_capacity), state: RustToolingSessionStateV1.Created)

    me start(identity: RustToolchainIdentityV1) -> bool:
        if self.state != RustToolingSessionStateV1.Created or not self.supervisor.alive or not identity_complete(identity):
            self.state = RustToolingSessionStateV1.Failed
            return false
        self.identity = identity
        self.state = RustToolingSessionStateV1.Ready
        true

    me begin_revision(revision: u64) -> RustToolingRequestV1:
        if self.state != RustToolingSessionStateV1.Ready or revision <= self.latest_revision:
            return RustToolingRequestV1(generation: 0, revision: 0, cancellation_epoch: self.cancellation_epoch)
        self.latest_revision = revision
        RustToolingRequestV1(generation: self.generation, revision: revision, cancellation_epoch: self.cancellation_epoch)

    me cancel(request: RustToolingRequestV1):
        if request.generation != self.generation: return
        if request.revision > self.cancelled_through_revision:
            self.cancelled_through_revision = request.revision
        self.cancellation_epoch = self.cancellation_epoch + 1

    me publish(request: RustToolingRequestV1, result: RustAnalysisResultV1) -> RustToolingPublicationV1:
        val output = normalized_output(result, request.revision)
        if self.state != RustToolingSessionStateV1.Ready:
            return RustToolingPublicationV1(state: RustToolingPublicationStateV1.Failed, request: request, identity: result.identity, output: output)
        if request.generation != self.generation or request.revision != self.latest_revision:
            return RustToolingPublicationV1(state: RustToolingPublicationStateV1.Stale, request: request, identity: result.identity, output: output)
        if request.revision <= self.cancelled_through_revision or request.cancellation_epoch != self.cancellation_epoch or result.state == RustAnalysisState.Cancelled:
            return RustToolingPublicationV1(state: RustToolingPublicationStateV1.Cancelled, request: request, identity: result.identity, output: output)
        if result.state != RustAnalysisState.Complete or result.truncated or result.malformed_record_count > 0 or not identity_complete(result.identity):
            return RustToolingPublicationV1(state: RustToolingPublicationStateV1.Incomplete, request: request, identity: result.identity, output: output)
        RustToolingPublicationV1(state: RustToolingPublicationStateV1.Published, request: request, identity: result.identity, output: output)

    me run_lint(config: RustLintWorkerConfigV1, request: RustToolingRequestV1) -> RustToolingPublicationV1:
        val cancelled = request.generation != self.generation or request.revision <= self.cancelled_through_revision or request.cancellation_epoch != self.cancellation_epoch
        val receipt = run_rust_lint_worker(config, cancelled)
        val worker_identity = receipt.result.identity
        val authoritative_identity = RustToolchainIdentityV1(
            cargo_version: worker_identity.cargo_version,
            rustc_version: worker_identity.rustc_version,
            clippy_version: worker_identity.clippy_version,
            rust_analyzer_version: self.identity.rust_analyzer_version,
            workspace_fingerprint: worker_identity.workspace_fingerprint,
            configuration_fingerprint: worker_identity.configuration_fingerprint
        )
        val authoritative_result = RustAnalysisResultV1(
            state: if toolchain_matches(self.identity, authoritative_identity): receipt.result.state else: RustAnalysisState.Partial,
            diagnostics: receipt.result.diagnostics,
            malformed_record_count: receipt.result.malformed_record_count,
            truncated: receipt.result.truncated,
            stderr_text: if toolchain_matches(self.identity, authoritative_identity): receipt.result.stderr_text else: receipt.result.stderr_text + "\nexact Rust toolchain identity mismatch"
        )
        self.publish(request, authoritative_result)

    me drain():
        if self.state == RustToolingSessionStateV1.Ready:
            self.state = RustToolingSessionStateV1.Draining
            self.supervisor.terminate()

    me close():
        if self.state == RustToolingSessionStateV1.Ready: self.drain()
        if self.state == RustToolingSessionStateV1.Draining or self.state == RustToolingSessionStateV1.Failed:
            self.state = RustToolingSessionStateV1.Closed
