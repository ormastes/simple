use app.lint.provider.cpp.model.{CppAnalysisState, CppToolFailure, CppToolResultV1, CppToolchainFingerprintV1, CompileCommandSelectionV1, TranslationUnitConfigReceiptV1, cpp_empty_config_receipt_v1}
use os.tooling.clang_worker.runner.{ClangWorkerLimitsV1, run_clang_tidy_worker_v1}

pub fn run_selected_clang_tidy_v1(selection: CompileCommandSelectionV1, command: text, arguments: [text], revision: u64, toolchain: CppToolchainFingerprintV1, limits: ClangWorkerLimitsV1) -> CppToolResultV1:
    if selection.state != CppAnalysisState.Complete or selection.receipt == nil:
        val failure_state = if selection.state == CppAnalysisState.Partial: CppAnalysisState.Partial else: CppAnalysisState.NotAnalyzed
        return CppToolResultV1(failure_state, CppToolFailure.None, [], 0, selection.reason, cpp_empty_config_receipt_v1(), toolchain)
    if val receipt = selection.receipt:
        return run_clang_tidy_worker_v1(command, arguments, revision, receipt, toolchain, limits)
    CppToolResultV1(CppAnalysisState.NotAnalyzed, CppToolFailure.None, [], 0, "compile command receipt unavailable", cpp_empty_config_receipt_v1(), toolchain)
