use app.mir_field_contract_probe.records.{Entry, Table, load_table, list_tables}

fn main() -> i64:
    var total: i64 = 0
    match load_table():
        case Some(table):
            # WORKAROUND(mcp-mir-array-field-erasure-20261012): restore imported aggregate types.
            val typed_table: Table = table
            val rows: [Entry] = typed_table.rows
            for row in rows:
                val typed_row: Entry = row
                total = total + typed_row.value
        case nil:
            return 42
    for table in list_tables():
        val typed_table: Table = table
        val rows: [Entry] = typed_table.rows
        for row in rows:
            val typed_row: Entry = row
            total = total + typed_row.value
    if total != 19:
        return 43
    0
