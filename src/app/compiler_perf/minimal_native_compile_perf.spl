"""Fail-closed minimal native-compile performance campaign.

The campaign admits only an explicitly receipted pure-Simple self-hosted
compiler. It never discovers or falls back to a bootstrap seed.
"""

use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.nogc_sync_mut.io.file_ops.{
    file_delete,
    file_exists,
    file_hash_sha256,
    file_read,
    file_size_raw,
    file_write
}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}

pub struct MinimalCompileDecision:
    accepted: bool
    reason: text

pub struct MinimalCompileCampaignRequest:
    compiler_path: text
    admission_receipt_path: text
    expected_compiler_sha256: text
    fixture_path: text
    work_dir: text
    time_path: text
    timeout_ms: i64
    run_count: i64
    baseline_p50_us: i64
    baseline_p95_us: i64
    baseline_max_rss_kb: i64

pub struct MinimalCompileCampaignResult:
    status: text
    reason: text
    sample_count: i64
    p50_us: i64
    p95_us: i64
    max_rss_kb: i64
    artifact_sha256: text

fn _decision(accepted: bool, reason: text) -> MinimalCompileDecision:
    MinimalCompileDecision(accepted: accepted, reason: reason)

fn _receipt_has_line(receipt: text, expected: text) -> bool:
    for line in receipt.split("\n"):
        if line.trim() == expected:
            return true
    false

pub fn minimal_compile_admission_decision(
    compiler_path: text,
    expected_sha256: text,
    observed_sha256: text,
    version_stdout: text,
    admission_receipt: text
) -> MinimalCompileDecision:
    if compiler_path == "":
        return _decision(false, "compiler-path-missing")
    if expected_sha256.len() != 64 or observed_sha256.len() != 64:
        return _decision(false, "compiler-sha256-invalid")
    if expected_sha256 != observed_sha256:
        return _decision(false, "compiler-sha256-mismatch")

    if version_stdout.trim() == "":
        return _decision(false, "compiler-version-empty")
    val version_lower = version_stdout.to_lower()
    if version_lower.contains("rust seed") or version_lower.contains("bootstrap seed"):
        return _decision(false, "rust-seed-rejected")
    if admission_receipt == "":
        return _decision(false, "admission-receipt-missing")
    if not _receipt_has_line(admission_receipt, "schema=compiler-minimal-native-compile-admission-v1"):
        return _decision(false, "admission-schema-mismatch")
    if not _receipt_has_line(admission_receipt, "runtime=pure-simple-self-hosted"):
        return _decision(false, "runtime-not-pure-simple-self-hosted")
    if not _receipt_has_line(admission_receipt, "runtime_probe=pass"):
        return _decision(false, "runtime-probe-not-passed")
    if not _receipt_has_line(admission_receipt, "rust_seed_used=false"):
        return _decision(false, "rust-seed-exclusion-unproved")
    if not _receipt_has_line(admission_receipt, "compiler_path=" + compiler_path):
        return _decision(false, "compiler-path-unbound")
    if not _receipt_has_line(admission_receipt, "compiler_sha256=" + observed_sha256):
        return _decision(false, "compiler-sha256-unbound")
    _decision(true, "admitted")

pub fn minimal_compile_artifact_decision(
    compile_exit_code: i64,
    artifact_exists: bool,
    artifact_size: i64,
    artifact_sha256: text,
    execution_exit_code: i64
) -> MinimalCompileDecision:
    if compile_exit_code != 0:
        return _decision(false, "native-build-failed")
    if not artifact_exists:
        return _decision(false, "artifact-missing")
    if artifact_size <= 300:
        return _decision(false, "artifact-too-small")
    if artifact_sha256.len() != 64:
        return _decision(false, "artifact-sha256-invalid")
    if execution_exit_code != 0:
        return _decision(false, "artifact-execution-failed")
    _decision(true, "artifact-admitted")

pub fn minimal_compile_budget_decision(
    baseline_p50_us: i64,
    baseline_p95_us: i64,
    baseline_max_rss_kb: i64,
    observed_p50_us: i64,
    observed_p95_us: i64,
    observed_max_rss_kb: i64
) -> MinimalCompileDecision:
    if (baseline_p50_us <= 0 or baseline_p95_us <= 0 or
            baseline_max_rss_kb <= 0):
        return _decision(false, "baseline-invalid")
    if observed_p50_us <= 0 or observed_p95_us <= 0 or observed_max_rss_kb <= 0:
        return _decision(false, "observation-invalid")
    if observed_p50_us * 100 > baseline_p50_us * 120:
        return _decision(false, "p50-regression")
    if observed_p95_us * 100 > baseline_p95_us * 120:
        return _decision(false, "p95-regression")
    if observed_max_rss_kb * 100 > baseline_max_rss_kb * 110:
        return _decision(false, "rss-regression")
    _decision(true, "within-budget")

fn _sorted_i64(values: [i64]) -> [i64]:
    var sorted = values
    var i = 1
    while i < sorted.len():
        val item = sorted[i]
        var j = i
        while j > 0 and sorted[j - 1] > item:
            sorted[j] = sorted[j - 1]
            j = j - 1
        sorted[j] = item
        i = i + 1
    sorted

fn _campaign_result(
    status: text,
    reason: text,
    sample_count: i64,
    p50_us: i64,
    p95_us: i64,
    max_rss_kb: i64,
    artifact_sha256: text
) -> MinimalCompileCampaignResult:
    MinimalCompileCampaignResult(
        status: status,
        reason: reason,
        sample_count: sample_count,
        p50_us: p50_us,
        p95_us: p95_us,
        max_rss_kb: max_rss_kb,
        artifact_sha256: artifact_sha256
    )

pub fn minimal_compile_campaign_report_text(
    request: MinimalCompileCampaignRequest,
    result: MinimalCompileCampaignResult,
    compiler_sha256: text,
    fixture_sha256: text
) -> text:
    [
        "schema=compiler-minimal-native-compile-report-v1",
        "status=" + result.status,
        "reason=" + result.reason,
        "compiler_path=" + request.compiler_path,
        "compiler_sha256=" + compiler_sha256,
        "fixture_path=" + request.fixture_path,
        "fixture_sha256=" + fixture_sha256,
        "run_count=" + "{result.sample_count}",
        "timeout_ms=" + "{request.timeout_ms}",
        "baseline_p50_us=" + "{request.baseline_p50_us}",
        "baseline_p95_us=" + "{request.baseline_p95_us}",
        "baseline_max_rss_kb=" + "{request.baseline_max_rss_kb}",
        "observed_p50_us=" + "{result.p50_us}",
        "observed_p95_us=" + "{result.p95_us}",
        "observed_max_rss_kb=" + "{result.max_rss_kb}",
        "artifact_sha256=" + result.artifact_sha256,
        "time_limit_percent=120",
        "rss_limit_percent=110",
        "rust_seed_used=false"
    ].join("\n") + "\n"

fn _write_campaign_report(
    request: MinimalCompileCampaignRequest,
    result: MinimalCompileCampaignResult,
    compiler_sha256: text,
    fixture_sha256: text
) -> MinimalCompileCampaignResult:
    val report_path = request.work_dir + "/minimal-native-compile-perf.receipt"
    if not file_write(
        report_path,
        minimal_compile_campaign_report_text(
            request, result, compiler_sha256, fixture_sha256
        )
    ):
        return _campaign_result(
            "fail", "report-write-failed", result.sample_count,
            result.p50_us, result.p95_us, result.max_rss_kb,
            result.artifact_sha256
        )
    result

pub fn run_minimal_native_compile_campaign(
    request: MinimalCompileCampaignRequest
) -> MinimalCompileCampaignResult:
    if request.run_count != 5:
        return _campaign_result("blocked", "run-count-must-be-five", 0, 0, 0, 0, "")
    if request.timeout_ms <= 0:
        return _campaign_result("blocked", "timeout-invalid", 0, 0, 0, 0, "")
    if not file_exists(request.compiler_path):
        return _campaign_result("blocked", "compiler-missing", 0, 0, 0, 0, "")
    if not file_exists(request.admission_receipt_path):
        return _campaign_result("blocked", "admission-receipt-missing", 0, 0, 0, 0, "")
    if not file_exists(request.fixture_path):
        return _campaign_result("blocked", "fixture-missing", 0, 0, 0, 0, "")
    if not file_exists(request.time_path):
        return _campaign_result("blocked", "time-tool-missing", 0, 0, 0, 0, "")
    if not dir_create_all(request.work_dir):
        return _campaign_result("blocked", "work-dir-unavailable", 0, 0, 0, 0, "")

    val observed_compiler_sha256 = file_hash_sha256(request.compiler_path)
    val fixture_sha256 = file_hash_sha256(request.fixture_path)
    if fixture_sha256.len() != 64:
        return _campaign_result("blocked", "fixture-sha256-invalid", 0, 0, 0, 0, "")
    val admission_receipt = file_read(request.admission_receipt_path)
    val (version_out, version_err, version_exit) = process_run_bounded(
        request.compiler_path, ["--version"], request.timeout_ms, 65536
    )
    if version_exit != 0:
        return _campaign_result(
            "blocked", "compiler-version-probe-failed:" + version_err.trim(),
            0, 0, 0, 0, ""
        )
    val admission = minimal_compile_admission_decision(
        request.compiler_path,
        request.expected_compiler_sha256,
        observed_compiler_sha256,
        version_out,
        admission_receipt
    )
    if not admission.accepted:
        return _campaign_result("blocked", admission.reason, 0, 0, 0, 0, "")

    var elapsed_samples: [i64] = []
    var max_rss_kb = 0
    var artifact_sha256 = ""
    var run_index = 0
    while run_index < request.run_count:
        val output_path = request.work_dir + "/minimal-native-" + "{run_index}"
        val rss_path = output_path + ".rss"
        if file_exists(output_path):
            file_delete(output_path)
        if file_exists(rss_path):
            file_delete(rss_path)

        val args = [
            "-f", "%M", "-o", rss_path,
            request.compiler_path,
            "native-build", request.fixture_path,
            "--backend", "cranelift",
            "--no-incremental",
            "--output", output_path
        ]
        val started_us = time_now_unix_micros()
        val (_, _, compile_exit) = process_run_bounded(
            request.time_path, args, request.timeout_ms, 65536
        )
        val elapsed_us = time_now_unix_micros() - started_us
        val rss_kb = if file_exists(rss_path):
            file_read(rss_path).trim().to_int() ?? -1
        else:
            -1

        var execution_exit: i64 = -1
        var observed_artifact_size: i64 = -1
        var observed_artifact_sha256 = ""
        if file_exists(output_path):
            observed_artifact_size = file_size_raw(output_path)
            observed_artifact_sha256 = file_hash_sha256(output_path)
            val (_, _, artifact_exit) = process_run_bounded(
                output_path, [], request.timeout_ms, 65536
            )
            execution_exit = artifact_exit

        val artifact = minimal_compile_artifact_decision(
            compile_exit,
            file_exists(output_path),
            observed_artifact_size,
            observed_artifact_sha256,
            execution_exit
        )
        if not artifact.accepted:
            return _campaign_result(
                "fail", artifact.reason, elapsed_samples.len(), 0, 0,
                max_rss_kb, observed_artifact_sha256
            )
        if elapsed_us <= 0 or rss_kb <= 0:
            return _campaign_result(
                "fail", "measurement-invalid", elapsed_samples.len(), 0, 0,
                max_rss_kb, observed_artifact_sha256
            )

        elapsed_samples.push(elapsed_us)
        if rss_kb > max_rss_kb:
            max_rss_kb = rss_kb
        artifact_sha256 = observed_artifact_sha256
        run_index = run_index + 1

    val sorted = _sorted_i64(elapsed_samples)
    val p50_us = sorted[2]
    val p95_us = sorted[4]
    val budget = minimal_compile_budget_decision(
        request.baseline_p50_us,
        request.baseline_p95_us,
        request.baseline_max_rss_kb,
        p50_us,
        p95_us,
        max_rss_kb
    )
    if not budget.accepted:
        return _write_campaign_report(
            request,
            _campaign_result(
                "fail", budget.reason, elapsed_samples.len(), p50_us, p95_us,
                max_rss_kb, artifact_sha256
            ),
            observed_compiler_sha256,
            fixture_sha256
        )
    _write_campaign_report(
        request,
        _campaign_result(
            "pass", "within-budget", elapsed_samples.len(), p50_us, p95_us,
            max_rss_kb, artifact_sha256
        ),
        observed_compiler_sha256,
        fixture_sha256
    )
