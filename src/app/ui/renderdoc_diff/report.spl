"""`diff.sdn` and `diff.md` rendering (MDSOC+ presentation layer).

Both documents carry the same facts; neither computes anything. The verdict line is
LAST in each so a caller can read it with `tail -1`.
"""

use app.ui.renderdoc_diff.align.{RdocDiff, rdoc_diff_verdict}
use app.ui.renderdoc_diff.events.{RdocEventSet}

fn rdoc_diff_sdn(a: RdocEventSet, b: RdocEventSet, diff: RdocDiff) -> text:
    var out = "renderdoc_diff\n"
    out = out + "    capture_a: " + a.capture + "\n"
    out = out + "    capture_b: " + b.capture + "\n"
    out = out + "    events_a: " + a.events.len().to_text() + "\n"
    out = out + "    events_b: " + b.events.len().to_text() + "\n"
    out = out + "    aligned: " + diff.aligned.to_text() + "\n"
    out = out + "    divergent: " + diff.divergent.to_text() + "\n"
    out = out + "    first_divergent: " + diff.first_divergent.to_text() + "\n"
    out = out + "    first_divergent_class: " + diff.first_divergent_class + "\n"
    out = out + "    thumbs_present: " + diff.thumbs_present.to_text() + "\n"
    out = out + "    error: " + diff.error + "\n"
    out = out + "type_counts |event_type, count_a, count_b|\n"
    var i = 0
    while i < diff.type_counts.len():
        val row = diff.type_counts[i]
        out = out + "    " + row.event_type + ", " + row.count_a.to_text() + ", "
            + row.count_b.to_text() + "\n"
        i = i + 1
    out = out + "divergences |event_id, peer_event_id, event_type, name, class, thumb_mismatch_pct, detail|\n"
    i = 0
    while i < diff.divergences.len():
        val d = diff.divergences[i]
        out = out + "    " + d.event_id.to_text() + ", " + d.peer_event_id.to_text() + ", "
            + d.event_type + ", " + d.name + ", " + d.divergence_class + ", "
            + d.thumb_mismatch_pct.to_text() + ", \"" + d.detail + "\"\n"
        i = i + 1
    out + rdoc_diff_verdict(diff) + "\n"

fn rdoc_diff_md(a: RdocEventSet, b: RdocEventSet, diff: RdocDiff) -> text:
    var out = "# RenderDoc capture diff\n\n"
    out = out + "- side A capture: `" + a.capture + "` (" + a.events.len().to_text() + " events)\n"
    out = out + "- side B capture: `" + b.capture + "` (" + b.events.len().to_text() + " events)\n"
    out = out + "- aligned: " + diff.aligned.to_text() + ", divergent: " + diff.divergent.to_text() + "\n"
    out = out + "- thumbnails present: " + diff.thumbs_present.to_text() + "\n\n"
    out = out + "## Event counts per type\n\n"
    out = out + "| type | side A | side B |\n|---|---|---|\n"
    var i = 0
    while i < diff.type_counts.len():
        val row = diff.type_counts[i]
        out = out + "| " + row.event_type + " | " + row.count_a.to_text() + " | "
            + row.count_b.to_text() + " |\n"
        i = i + 1
    out = out + "\n## Divergences\n\n"
    if diff.divergences.len() == 0:
        out = out + "None.\n"
    else:
        out = out + "| event | peer | type | name | class | thumb mismatch % | detail |\n"
        out = out + "|---|---|---|---|---|---|---|\n"
        i = 0
        while i < diff.divergences.len():
            val d = diff.divergences[i]
            out = out + "| " + d.event_id.to_text() + " | " + d.peer_event_id.to_text() + " | "
                + d.event_type + " | " + d.name + " | " + d.divergence_class + " | "
                + d.thumb_mismatch_pct.to_text() + " | " + d.detail + " |\n"
            i = i + 1
    out = out + "\nAlignment rule: exact signature, then render-target dims+format, then"
    out = out + " ordinal pairing only when the unmatched remainders are equal in size.\n\n"
    out + rdoc_diff_verdict(diff) + "\n"
