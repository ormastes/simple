# Upstream-Skia web reference comparison: receipt classification.
#
# AUTHORITY for the two rules of
# `scripts/check/check-skia-web-reference-compare.shs`; the shell lane carries a
# twin so a runner needs no Simple binary to classify.
#
#   1. A scene is `match` only when the Skia worker exited 0, the receipt's
#      `pixel_sha256` is the digest of the retained pixel file, and that digest
#      equals the Simple web oracle digest for the scene. A failed worker or a
#      missing digest is `blocked`; a receipt that does not describe its own
#      pixel file is `receipt-digest-mismatch`. Neither is ever a match.
#   2. The lane verdict is PASS only when at least one scene matched and none
#      failed; zero scenes examined is ERROR, never PASS.

fn skia_scene_status(worker_rc: i64, receipt_sha: text, file_sha: text, oracle_sha: text) -> text:
    if worker_rc != 0 or receipt_sha == "" or file_sha == "" or oracle_sha == "":
        return "blocked"
    if receipt_sha != file_sha:
        return "receipt-digest-mismatch"
    if file_sha != oracle_sha:
        return "mismatch"
    "match"

fn skia_lane_verdict(scenes_checked: i64, scenes_match: i64, scenes_failed: i64) -> text:
    if scenes_checked <= 0:
        return "ERROR — nothing was checked"
    if scenes_failed > 0 or scenes_match <= 0:
        return "FAIL — {scenes_checked} scene(s) checked, {scenes_failed} failed, {scenes_match} matched the Simple web oracle"
    "PASS — {scenes_match} scene(s) compared, upstream Skia readback equals the Simple web oracle, 0 mismatching"

fn skia_lane_exit_code(verdict: text) -> i64:
    if verdict.starts_with("PASS"):
        return 0
    if verdict.starts_with("FAIL"):
        return 1
    2

export skia_scene_status, skia_lane_verdict, skia_lane_exit_code
