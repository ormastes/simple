# Shared-WM TUI backend entry.
#
# Backend entries are SEPARATE PROGRAM ENTRIES: `src/app/ui/backend_loader.spl`
# spawns them with `process_run(simple_bin, ["run", <entry path>, ...])`. That
# process boundary is what keeps the shared-WM route's heavy import closure
# (`os.compositor` -> os/drivers, os/kernel, lib/skia) out of the ordinary
# `simple ui tui` closure -- see REQ-UI-SLIM-004 / REQ-UI-SLIM-009 and
# src/app/ui.tui/shared_wm_route.spl for why the split is at the module
# boundary rather than inside one module.
#
# NOT YET SELECTABLE: `_backend_entry_path` (src/app/ui/backend_loader.spl:14-29)
# has no "tui_shared_wm" key, so nothing spawns this entry today. Adding that
# key is owned by the backend_loader lane.

use app.ui.backend_entry_args.{ui_backend_entry_args}
use app.ui.tui.shared_wm_route.{run_tui_routed}

fn main() -> i64:
    val args = ui_backend_entry_args()
    run_tui_routed(args.file_path)
