"""S2 — Chrome-backed, Engine2D-composited HTML/CSS catalog showcase.

Pipeline per tab: shared catalog page -> Chrome dynlib (`create` -> `load_html` ->
`resize` -> `render_frame` -> `read_pixels_into`) -> BGRA -> Engine2D ARGB
`draw_image` on the requested backend -> `read_pixels` -> `build/chrome-showcase/<tab>.ppm`,
with one `key=value` receipt at `build/chrome-showcase/receipt.env`.

The catalog is generated from the 4K lane's own inventory and fixture — this file does NOT
author a second catalog. The pages land in `examples/06_io/ui/web_catalog/` with a
`catalog.sdn` index so the Simple web renderer showcase consumes byte-identical input.

HONEST SCOPE ON THIS HOST: there is no CEF drop, so `create()` cannot succeed and the
composited frame is the twin's deterministic test pattern. Every such run records
`frame_source=stub-pattern`, a non-empty `reason`, and verdict `environment-blocked`.
Engine2D, the PPM writer and the receipt still run end to end, which is what S3 measures.

RUNTIME GAP (recorded, not worked around): `simple_chrome_render_read_pixels_into` writes
into a caller-owned OUT buffer, and the host dynlib facade has no bounded out-byte-buffer
call — `spl_wffi_call_i64_with_bytes` passes bytes IN only. Wiring a real Chrome frame
therefore needs a facade addition (`spl_wffi_call_i64_into_bytes`), filed in the lane
state. No new `rt_*` is introduced here.
"""

use std.io_runtime.{dir_create_all, env_get, file_exists, file_hash_sha256_or_empty,
    file_read, file_write, file_write_bytes, time_now_unix_micros}
use std.gc_async_mut.gpu.browser_engine.web_renderable_feature_inventory.{
    web_renderable_feature_inventory, web_renderable_feature_inventory_apply_to_showcase}
use std.gpu.engine2d.engine.{Engine2D}
use app.ui.chrome_showcase.catalog.{CHROME_CATALOG_DIR, CHROME_CATALOG_INDEX,
    CHROME_CATALOG_SOURCE, chrome_catalog_tabs, chrome_catalog_file_for,
    chrome_catalog_page, chrome_catalog_index_text}
use app.ui.chrome_showcase.frame.{chrome_frame_stub_image, chrome_frame_nonblank,
    chrome_frame_ppm_bytes}
use app.ui.chrome_showcase.receipt.{ChromeShowcaseReceipt, ChromeShowcaseTabRow,
    chrome_showcase_receipt_text, CHROME_SHOWCASE_FRAME_STUB}

val CHROME_SHOWCASE_OUT_DIR: text = "build/chrome-showcase"
val CHROME_SHOWCASE_LIB: text = "build/chrome-render/libsimple_chrome_render.dylib"
val CHROME_SHOWCASE_LIB_SO: text = "build/chrome-render/libsimple_chrome_render.so"

fn _env_or(key: text, fallback: text) -> text:
    val raw = env_get(key)
    if raw == "":
        return fallback
    raw

fn _env_i64(key: text, fallback: i64) -> i64:
    val raw = env_get(key)
    if raw == "":
        return fallback
    val parsed = raw.to_i64()
    if parsed <= 0:
        return fallback
    parsed

"""The built shim, or "" when this host has none. Never fabricates a path."""
fn _chrome_library_path() -> text:
    if file_exists(CHROME_SHOWCASE_LIB):
        return CHROME_SHOWCASE_LIB
    if file_exists(CHROME_SHOWCASE_LIB_SO):
        return CHROME_SHOWCASE_LIB_SO
    ""

"""Writes the shared catalog and returns a digest of everything it wrote.

The digest goes into the receipt as `catalog_sha256`: it is what lets S3 assert the Chrome
and Simple showcases consumed the SAME catalog rather than two similar ones.
"""
fn _write_catalog(tabs: [text]) -> text:
    val inventory = web_renderable_feature_inventory()
    val composed = web_renderable_feature_inventory_apply_to_showcase(
        file_read(CHROME_CATALOG_SOURCE), inventory)
    val _made = dir_create_all(CHROME_CATALOG_DIR)
    var joined = ""
    for tab in tabs:
        val page = chrome_catalog_page(composed, tab)
        if page == "":
            print "[chrome-showcase] catalog page missing for tab " + tab
        val path = CHROME_CATALOG_DIR + "/" + chrome_catalog_file_for(tab)
        val _written = file_write(path, page)
        joined = joined + path + ":" + page.len().to_text() + ";"
    val _index = file_write(CHROME_CATALOG_INDEX,
        chrome_catalog_index_text(inventory.version, tabs))
    joined

fn _catalog_digest() -> text:
    file_hash_sha256_or_empty(CHROME_CATALOG_INDEX)

fn main() -> i64:
    val requested = _env_or("SIMPLE_2D_BACKEND", "cpu_simd")
    val width = _env_i64("SIMPLE_CHROME_SHOWCASE_WIDTH", 320)
    val height = _env_i64("SIMPLE_CHROME_SHOWCASE_HEIGHT", 180)
    val tabs = chrome_catalog_tabs()

    val out_dir = _env_or("SIMPLE_CHROME_SHOWCASE_OUT", CHROME_SHOWCASE_OUT_DIR)

    val _catalog = _write_catalog(tabs)
    val _made = dir_create_all(out_dir)

    val library_path = _chrome_library_path()
    var backend_stage = "blocked:no-cef-drop"
    var frame_source = CHROME_SHOWCASE_FRAME_STUB
    var reason = "no-cef-drop"
    var lib_sha256 = ""
    if library_path != "":
        lib_sha256 = file_hash_sha256_or_empty(library_path)
        # The shim is present but CEF is not: `create()` answers
        # CHROME_RENDER_E_BACKEND_UNAVAILABLE, and the readback out-buffer facade is
        # missing besides. Both are recorded, neither is simulated as success.
        backend_stage = "blocked:backend-unavailable"
        reason = "no-cef-drop:shim-present-cef-absent"

    var engine = Engine2D.create_with_backend_fast(width.to_i32(), height.to_i32(), requested)
    val reported = engine.backend_name()
    print "[chrome-showcase] engine2d requested=" + requested + " reported=" + reported

    var rows: [ChromeShowcaseTabRow] = []
    var tab_index: i64 = 0
    for tab in tabs:
        val started = time_now_unix_micros()
        val source_image = chrome_frame_stub_image(width, height, tab_index)
        engine.clear(4278190080u32)
        engine.draw_image(0i32, 0i32, width.to_i32(), height.to_i32(), source_image)
        engine.present()
        val composited = engine.read_pixels()
        val elapsed_ms = (time_now_unix_micros() - started) / 1000
        val ppm_path = out_dir + "/" + tab + ".ppm"
        val wrote = file_write_bytes(ppm_path, chrome_frame_ppm_bytes(composited, width, height))
        var recorded_path = ppm_path
        if not wrote:
            recorded_path = ""
        rows.push(ChromeShowcaseTabRow(tab: tab, wall_ms: elapsed_ms,
            pixels: composited.len(), nonblank: chrome_frame_nonblank(composited),
            ppm_path: recorded_path))
        tab_index = tab_index + 1
    engine.shutdown()

    val binary_path = _env_or("SIMPLE_SHOWCASE_BINARY", "")
    val receipt = ChromeShowcaseReceipt(
        binary_path: binary_path,
        binary_size: _env_i64("SIMPLE_SHOWCASE_BINARY_SIZE", 0),
        binary_mtime: _env_i64("SIMPLE_SHOWCASE_BINARY_MTIME", 0),
        chrome_lib_sha256: lib_sha256,
        backend_stage: backend_stage,
        engine2d_backend_requested: requested,
        engine2d_backend_reported: reported,
        inventory_version: web_renderable_feature_inventory().version,
        catalog_sha256: _catalog_digest(),
        viewport_width: width, viewport_height: height,
        frame_source: frame_source, reason: reason, timed_out: false, rows: rows)
    val body = chrome_showcase_receipt_text(receipt)
    val _written = file_write(out_dir + "/receipt.env", body)
    print body
    0
