# CSS-layout geometry differential: Chrome (reference) vs the pure-Simple web
# renderer, keyed by an identical nth-path scheme on both sides.
#
# Chrome side is produced by scripts/check/check-chrome-layout-geometry-diff.shs
# (a <script> appended to a copy of the page emits GEOM| lines into a <pre>,
# harvested with --headless=new --dump-dom). Simple side is the LAID-OUT
# ELEMENT list from simple_web_layout_element_geometry_lines(html, w, h) -- one
# row per element, paintless boxes included, so both sides enumerate the same
# set (round 9; before that the Simple side read Draw IR COMMANDS and dropped
# every box that painted nothing).
#
# Verdict is the LAST line of stdout. 0 elements compared is ERROR, never PASS.
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_element_geometry_lines,
    simple_web_layout_last_render_degraded,
    simple_web_layout_last_render_degrade_reason}
use app.wm_compare_host.cli_util.{get_cli_args}
use app.wm_compare_host.file_ops.{file_read_text, file_write}

struct GeomBox:
    key: text
    tag: text
    x: i32
    y: i32
    w: i32
    h: i32
    features: text

fn _to_i32(raw: text) -> i32:
    if raw == "":
        return 0
    var s = raw
    var neg = false
    if s.starts_with("-"):
        neg = true
        s = s.substring(1, s.len())
    var digits = ""
    var i = 0
    var stop = false
    while i < s.len():
        val ch = s.substring(i, i + 1)
        if not stop:
            if ch >= "0" and ch <= "9":
                digits = digits + ch
            elif ch == ".":
                stop = true
        i = i + 1
    if digits == "":
        return 0
    val v = digits.to_i32()
    if neg: 0 - v else: v

fn _abs(v: i32) -> i32:
    if v < 0: 0 - v else: v

# An element that generates NO BOX is reported by `getBoundingClientRect()` as
# the all-zero rect, because there is no box whose corners could be returned.
# That is a REPORTING CONVENTION, not a position: Chrome is saying "this
# element has no geometry", not "this element sits at the viewport origin with
# zero size".
#
# Comparing a real Simple position against that convention produces a delta
# equal to Chrome's own zeros plus Simple's whole position, and round 19
# measured what that costs: ONE `<wbr>` deep in the `html` catalog page carried
# `dx=180 dy=9781 dw=1 dh=1` = 9963, which was **80% of that page's entire Σ**
# and had been silently inflating this series' headline percentages for at
# least two rounds. It is not layout error; it is the instrument comparing two
# different kinds of thing.
#
# Census over all eight harvested `*.geom.txt` (round 20, Run A) — the set is
# NOT wbr-only, and is not guessable from the tag alone:
#
#   html         path:0/0/4/2/86/1/0/0   wbr      (a break opportunity)
#   animation    path:0/0/4/0            span     (fallback child of <audio>)
#   animation    path:0/0/5/0            span     (fallback child of <video>)
#   forms-media  path:0/0/1/3/0/0        option   (inside a closed <select>)
#   forms-media  path:0/0/1/3/0/1        option
#
# Three distinct causes, one convention. `<br>` is NOT in this set — it has a
# real rect in Chrome — so a tag-name allowlist would be both wrong and
# unmaintainable. The rule keys on what Chrome actually REPORTS.
#
# The comparison rule, therefore:
#   * Chrome boxless + Simple boxless-or-absent -> agreement. Compared, not
#     mismatched. This is the state a correct engine is in.
#   * Chrome boxless + Simple emits a real box  -> a mismatch of kind
#     `extra_box`, counted ONCE, with all four deltas recorded as 0 so the Σ
#     metric sees the defect's WEIGHT (one wrong box) rather than the
#     magnitude of coordinates Chrome never claimed.
#
# What this deliberately does NOT do: it never lets a Simple all-zero box off
# where Chrome reported a real one. That direction is a genuine layout failure
# (an element that was never laid out) and stays a full-Σ mismatch — the
# `boxless-control-*` selftest fixtures pin exactly that asymmetry.
pub fn chrome_reports_no_box(b: GeomBox) -> bool:
    b.x == 0 and b.y == 0 and b.w == 0 and b.h == 0

# Chrome says the element is NOT RENDERED, whatever rect it also reported.
#
# `chrome_reports_no_box` above keys on the rect being all-zero, which is the
# shape a boxless element (<wbr>, <br>) takes. It does NOT cover the other way
# an element can fail to be rendered: Blink FORCE-LAYS-OUT a
# content-visibility:hidden subtree when script measures a descendant, so such
# an element reports a PHANTOM, fully non-zero rect at the position it would
# occupy if it were rendered.
#
# Measured on forms-media's `<details id="details">` (which carries NO `open`
# attribute), Chrome 152, one page, both states side by side:
#
#     d1  rect=0,100,900,18  vis=true   <- <details>, SUMMARY height only
#     p1  rect=0,134,900,18  vis=false  <- the <p>: PHANTOM, and it OVERLAPS...
#     after1 rect=0,118,900,18          <- ...the following sibling
#     d1::details-content content-visibility = hidden
#
# The <p> is not in flow: the <details> is summary-height, the next sibling
# starts immediately after it, and the <p>'s rect lands on top of that sibling.
# Simple's zero-size box for it is CORRECT, and the 864 Σ the differ charged
# for that row was measuring a property of Chrome's measurement API, not a
# layout defect.
#
# `checkVisibility()` is the right ground truth and is precisely scoped —
# verified on a probe page rather than assumed: it is false for `display:none`
# and for a content-visibility:hidden subtree, and stays TRUE for
# `visibility:hidden` (`rect=0,0,68,18 cv=true`) and `opacity:0`
# (`rect=72,0,80,18 cv=true`), both of which DO occupy layout space and must
# keep being compared at full Σ.
#
# A row Chrome reports as not-rendered joins the SAME arm as a boxless one, so
# the asymmetry that arm already enforces carries over unchanged: Simple
# emitting a REAL box where Chrome renders nothing is still a mismatch
# (`extra_box`). This rule can only forgive Simple for NOT drawing something
# Chrome also does not draw.
pub fn chrome_reports_not_rendered(b: GeomBox) -> bool:
    b.features.contains("rendered=false")

# Simple paints nothing for this element.
#
# Deliberately WEAKER than `chrome_reports_no_box`, and used ONLY in the
# not-rendered arm. That predicate demands all four values be zero, which is the
# right test for a boxless element; here the question is different — Simple
# still walks a not-rendered element and hands it a flow POSITION, then gives it
# no size. On forms-media's closed <details> it emits `45,375,0,0`: a real
# origin, zero extent. A box with no width and no height paints nothing wherever
# its origin sits, so zero EXTENT is the honest test of "renders nothing".
#
# This does not weaken the arm's control: a Simple box with any real extent
# fails this predicate and is still reported as `extra_box`.
pub fn simple_renders_nothing(b: GeomBox) -> bool:
    b.w == 0 and b.h == 0

# --- Chrome side -----------------------------------------------------------

pub fn parse_chrome_geom(dump: text) -> [GeomBox]:
    var out: [GeomBox] = []
    val lines = dump.split("\n")
    var i = 0
    while i < lines.len():
        val line = lines[i].trim()
        if line.starts_with("GEOM|"):
            val parts = line.split("|")
            if parts.len() >= 7:
                var features = ""
                var p = 7
                while p < parts.len():
                    if features != "":
                        features = features + ";"
                    features = features + parts[p]
                    p = p + 1
                out.push(GeomBox(
                    key: parts[1], tag: parts[2],
                    x: _to_i32(parts[3]), y: _to_i32(parts[4]),
                    w: _to_i32(parts[5]), h: _to_i32(parts[6]),
                    features: features))
        i = i + 1
    out

# --- Simple side -----------------------------------------------------------

# Rebuilds the nth-path key from the Draw IR parent chain. Draw IR carries
# component_id/parent_id plus a `tag` computed-style prop, which is enough to
# recover the element tree without touching the renderer internals.
pub fn simple_geom_boxes(html: text, width: i32, height: i32) -> [GeomBox]:
    """Enumerates the LAID-OUT ELEMENTS, not the Draw IR commands.

    Until round 9 this walked `render_html_to_draw_ir(...)`'s command list, so a
    box that paints nothing produced no command and entered no list, while
    Chrome's side keeps every element (`document.body.querySelectorAll('*')`).
    Measured on the eight catalog pages that asymmetry was worth exactly ONE
    row; the 236 elements the differ could not compare were the `<li>` desync,
    and that turned out to be a TREE-CONSTRUCTION defect fixed in
    html_tree_builder.spl — see
    doc/08_tracking/bug/web_geometry_differ_li_reparented_desyncs_nth_paths_2026-09-13.md.

    The renderer now hands over one row per layout element, keyed by its own
    canonical nth-path function, so the Simple side cannot silently compare a
    subset of what Chrome reports: `missing_in_simple` is 0 on all 8 pages."""
    var out: [GeomBox] = []
    if html == "":
        return out
    val lines = simple_web_layout_element_geometry_lines(html, width, height)
    var i = 0
    while i < lines.len():
        val parts = lines[i].split("|")
        if parts.len() >= 7 and parts[0] == "GEOM":
            out.push(GeomBox(
                key: parts[1], tag: parts[2],
                x: _to_i32(parts[3]), y: _to_i32(parts[4]),
                w: _to_i32(parts[5]), h: _to_i32(parts[6]),
                features: ""))
        i = i + 1
    out

# --- Diff ------------------------------------------------------------------

struct GeomDiffRow:
    key: text
    tag: text
    dx: i32
    dy: i32
    dw: i32
    dh: i32
    feature: text
    chrome_features: text
    inherited: bool

struct GeomDiffResult:
    compared: i32
    mismatched: i32
    root_mismatched: i32
    inherited_mismatched: i32
    missing_in_simple: i32
    missing_in_chrome: i32
    rows: [GeomDiffRow]
    extra_keys: [text]

# A Simple side on which EVERY box is (0,0,0,0) is not a page that mismatches
# everywhere -- it is a page that was never laid out, and the only honest
# verdict for it is "nothing was checked".
#
# Round 13 (2026-09-14) found this shape sitting in three rounds of recorded
# metrics. The runner binary predated a `rt_engine2d_blend_cov_span_u32` extern
# that the layout module had begun declaring; an unregistered extern answers
# silent nil, the renderer emitted 432 boxes of which 432 were (0,0,0,0),
# `missing_in_simple` was 0 because every KEY was still present, and the differ
# reported 430 mismatches whose delta was exactly Chrome's own geometry. That
# table was then read as a layout defect and filed as one. Nothing upstream can
# be relied on to notice this, which is why the check lives here.
#
# One box is not enough to judge on -- a single-element page could legitimately
# be a zero-sized box -- so the rule needs at least two.
pub fn all_boxes_degenerate(boxes: [GeomBox]) -> bool:
    if boxes.len() < 2:
        return false
    for b in boxes:
        if b.x != 0 or b.y != 0 or b.w != 0 or b.h != 0:
            return false
    true

fn _has(haystack: text, needle: text) -> bool:
    haystack.contains(needle)

# Classifies a mismatch into the CSS feature most likely responsible, reading
# Chrome's computed style (the reference side) so a Simple-side style gap
# cannot hide the cluster.
pub fn classify_feature(chrome_features: text) -> text:
    val f = chrome_features
    # The PARENT's formatting context wins: an ol/li inside a flex container is
    # a flex-item sizing bug, not a box-sizing bug, and its own display is
    # block. Classifying on the box's own display first buckets every such row
    # under the catch-all `* { box-sizing: border-box }` rule instead.
    if _has(f, "parent-display=flex") or _has(f, "parent-display=inline-flex"):
        return "flex-item"
    if _has(f, "parent-display=grid") or _has(f, "parent-display=inline-grid"):
        return "grid-item"
    if _has(f, "parent-display=table-row") or _has(f, "parent-display=table"):
        return "table-cell"
    if _has(f, "display=grid") or _has(f, "display=inline-grid"):
        return "grid"
    if _has(f, "display=flex") or _has(f, "display=inline-flex"):
        return "flex"
    if _has(f, "display=table"):
        return "table"
    if _has(f, "position=absolute") or _has(f, "position=fixed") or _has(f, "position=sticky"):
        return "position"
    if _has(f, "float=left") or _has(f, "float=right"):
        return "float"
    if _has(f, "display=inline-block"):
        return "inline-block"
    if _has(f, "display=inline"):
        return "inline"
    if _has(f, "overflow=hidden") or _has(f, "overflow=auto") or _has(f, "overflow=scroll"):
        return "overflow"
    if _has(f, "white-space=pre") or _has(f, "white-space=nowrap"):
        return "white-space"
    # There is deliberately NO box-sizing bucket. `* { box-sizing: border-box }`
    # is near-universal in the catalog CSS, so classifying on it captured the
    # largest bucket (54 root mismatches) and pointed at a property that cannot
    # change an auto-height block's height at all. Those rows are block flow.
    "block-flow"

# "path:0/1/2" -> "path:0/1"; "path:0" -> "path:"; "path:" -> "".
pub fn parent_key(key: text) -> text:
    if key == "" or key == "path:":
        return ""
    var cut = -1
    var i = 0
    while i < key.len():
        if key.substring(i, i + 1) == "/":
            cut = i
        i = i + 1
    if cut < 0:
        return "path:"
    key.substring(0, cut)

fn _find_key(boxes: [GeomBox], key: text) -> i32:
    var i = 0
    while i < boxes.len():
        if boxes[i].key == key:
            return i
        i = i + 1
    -1

fn _index_of_text(keys: [text], key: text) -> i32:
    var i = 0
    while i < keys.len():
        if keys[i] == key:
            return i
        i = i + 1
    -1

pub fn geometry_diff(chrome: [GeomBox], simple: [GeomBox], tolerance: i32) -> GeomDiffResult:
    # Signed deltas for EVERY compared element, mismatched or not: a child that
    # merely carries its parent's displacement is one bug, not two, and without
    # this a single misplaced flex container is counted once per descendant and
    # swamps the ranked feature table.
    var ckeys: [text] = []
    var sdx: [i32] = []
    var sdy: [i32] = []
    var sdw: [i32] = []
    var sdh: [i32] = []
    var rows: [GeomDiffRow] = []
    var compared = 0
    var mismatched = 0
    var missing_in_simple = 0
    var extra_box = 0
    var i = 0
    while i < chrome.len():
        val c = chrome[i]
        val j = _find_key(simple, c.key)
        val c_not_rendered = chrome_reports_not_rendered(c)
        if chrome_reports_no_box(c) or c_not_rendered:
            # Chrome generates no box here (see `chrome_reports_no_box`). The
            # element IS compared — it is not skipped, or a Simple-only box
            # could hide in the gap — but it is compared against "no box"
            # rather than against the coordinates 0,0,0,0.
            compared = compared + 1
            # A not-rendered element is excused when Simple gives it no EXTENT
            # (it may still carry a flow origin); a boxless one keeps the
            # stricter all-four-zero test it has always had.
            val simple_draws_it = if c_not_rendered:
                    j >= 0 and not simple_renders_nothing(simple[j])
                else:
                    j >= 0 and not chrome_reports_no_box(simple[j])
            if simple_draws_it:
                extra_box = extra_box + 1
                rows.push(GeomDiffRow(
                    key: c.key, tag: c.tag, dx: 0, dy: 0, dw: 0, dh: 0,
                    feature: "extra_box", chrome_features: c.features,
                    inherited: false))
            # Simple absent or likewise boxless: the two agree. Note that an
            # ABSENT Simple row is agreement only in this arm -- everywhere
            # else a missing Simple box is still `missing_in_simple`.
        elif j < 0:
            missing_in_simple = missing_in_simple + 1
            rows.push(GeomDiffRow(key: c.key, tag: c.tag, dx: -1, dy: -1,
                                  dw: -1, dh: -1, feature: "missing-in-simple",
                                  chrome_features: c.features, inherited: false))
        else:
            val s = simple[j]
            compared = compared + 1
            ckeys.push(c.key)
            sdx.push(c.x - s.x)
            sdy.push(c.y - s.y)
            sdw.push(c.w - s.w)
            sdh.push(c.h - s.h)
        i = i + 1
    var root_mismatched = 0
    var inherited_mismatched = 0
    var n = 0
    while n < ckeys.len():
        val dx = _abs(sdx[n])
        val dy = _abs(sdy[n])
        val dw = _abs(sdw[n])
        val dh = _abs(sdh[n])
        if dx > tolerance or dy > tolerance or dw > tolerance or dh > tolerance:
            mismatched = mismatched + 1
            val p = _index_of_text(ckeys, parent_key(ckeys[n]))
            # All four signed deltas equal to the parent's: the child is simply
            # carried by the parent's error (an li inside a mis-sized flex item
            # repeats both the offset AND the width), so it is the same bug.
            val inherited = (
                p >= 0 and sdx[p] == sdx[n] and sdy[p] == sdy[n] and
                sdw[p] == sdw[n] and sdh[p] == sdh[n]
            )
            if inherited:
                inherited_mismatched = inherited_mismatched + 1
            else:
                root_mismatched = root_mismatched + 1
            val ci = _find_key(chrome, ckeys[n])
            rows.push(GeomDiffRow(
                key: ckeys[n], tag: chrome[ci].tag, dx: dx, dy: dy, dw: dw, dh: dh,
                feature: classify_feature(chrome[ci].features),
                chrome_features: chrome[ci].features, inherited: inherited))
        n = n + 1
    # An `extra_box` is a real defect and is counted once, as a ROOT mismatch:
    # a box that should not exist cannot be "inherited" from a parent's offset,
    # because its whole delta is its existence rather than its position.
    mismatched = mismatched + extra_box
    root_mismatched = root_mismatched + extra_box
    var extra_keys: [text] = []
    var k = 0
    while k < simple.len():
        if _find_key(chrome, simple[k].key) < 0:
            extra_keys.push(simple[k].key + "(" + simple[k].tag + ")")
        k = k + 1
    GeomDiffResult(compared: compared, mismatched: mismatched,
                   root_mismatched: root_mismatched,
                   inherited_mismatched: inherited_mismatched,
                   missing_in_simple: missing_in_simple,
                   missing_in_chrome: extra_keys.len(), rows: rows,
                   extra_keys: extra_keys)

pub fn diff_sdn(page: text, result: GeomDiffResult) -> text:
    var out = "geometry_diff:\n  page: " + page + "\n"
    out = out + "  compared: " + result.compared.to_string() + "\n"
    out = out + "  mismatched: " + result.mismatched.to_string() + "\n"
    out = out + "  root_mismatched: " + result.root_mismatched.to_string() + "\n"
    out = out + "  inherited_mismatched: " + result.inherited_mismatched.to_string() + "\n"
    out = out + "  missing_in_simple: " + result.missing_in_simple.to_string() + "\n"
    out = out + "  missing_in_chrome: " + result.missing_in_chrome.to_string() + "\n"
    out = out + "  extra_keys:\n"
    var e = 0
    while e < result.extra_keys.len():
        out = out + "    - " + result.extra_keys[e] + "\n"
        e = e + 1
    out = out + "  rows:\n"
    var i = 0
    while i < result.rows.len():
        val r = result.rows[i]
        out = out + "    - key: " + r.key + "\n      tag: " + r.tag +
              "\n      feature: " + r.feature +
              "\n      dx: " + r.dx.to_string() +
              "\n      dy: " + r.dy.to_string() +
              "\n      dw: " + r.dw.to_string() +
              "\n      dh: " + r.dh.to_string() +
              "\n      inherited: " + r.inherited.to_text() +
              "\n      chrome_features: \"" + r.chrome_features + "\"\n"
        i = i + 1
    out

pub fn diff_md(page: text, result: GeomDiffResult) -> text:
    var out = "# Geometry diff — " + page + "\n\n"
    out = out + "- compared: " + result.compared.to_string() + "\n"
    out = out + "- mismatched: " + result.mismatched.to_string() +
          " (root " + result.root_mismatched.to_string() +
          ", inherited " + result.inherited_mismatched.to_string() + ")\n"
    out = out + "- missing in Simple: " + result.missing_in_simple.to_string() + "\n"
    out = out + "- missing in Chrome (Simple-only boxes): " +
          result.missing_in_chrome.to_string() + "\n"
    var e = 0
    while e < result.extra_keys.len() and e < 40:
        out = out + "  - " + result.extra_keys[e] + "\n"
        e = e + 1
    out = out + "\n## Root mismatches (a child repeating its parent's offset is excluded)\n\n"
    out = out + "| key | tag | feature | dx | dy | dw | dh |\n|---|---|---|---|---|---|---|\n"
    var i = 0
    var shown = 0
    while i < result.rows.len() and shown < 200:
        val r = result.rows[i]
        # missing-in-simple rows are listed separately below: on a long page
        # they outnumber the geometry mismatches 17:1 and would push every real
        # delta out of the 200-row cap.
        if not r.inherited and r.feature != "missing-in-simple":
            shown = shown + 1
            out = out + "| " + r.key + " | " + r.tag + " | " + r.feature + " | " +
                  r.dx.to_string() + " | " + r.dy.to_string() + " | " +
                  r.dw.to_string() + " | " + r.dh.to_string() + " |\n"
        i = i + 1
    out = out + "\n## Elements Chrome laid out that Simple emitted no box for (first 40)\n\n"
    var m = 0
    var listed = 0
    while m < result.rows.len() and listed < 40:
        if result.rows[m].feature == "missing-in-simple":
            listed = listed + 1
            out = out + "- " + result.rows[m].key + " (" + result.rows[m].tag + ")\n"
        m = m + 1
    out

# --- selftest --------------------------------------------------------------

# Three hand-written fixtures: identical geometry, one element shifted on y,
# and one element present in Chrome but absent from Simple.
pub fn selftest_report() -> text:
    var failures = 0
    var log = ""

    val identical_chrome = parse_chrome_geom(
        "GEOM|path:|body|0|0|900|600|display=block\n" +
        "GEOM|path:0|div|10|10|100|50|display=block\n")
    val identical_simple = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "div", x: 10, y: 10, w: 100, h: 50, features: "")
    ]
    val r1 = geometry_diff(identical_chrome, identical_simple, 1)
    if r1.compared != 2 or r1.mismatched != 0 or r1.missing_in_simple != 0:
        failures = failures + 1
        log = log + "selftest identical: FAIL (compared=" + r1.compared.to_string() +
              " mismatched=" + r1.mismatched.to_string() + ")\n"
    else:
        log = log + "selftest identical: PASS (2 compared, 0 mismatched)\n"

    val shifted_simple = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "div", x: 10, y: 24, w: 100, h: 50, features: "")
    ]
    val r2 = geometry_diff(identical_chrome, shifted_simple, 1)
    if r2.compared != 2 or r2.mismatched != 1 or r2.rows.len() != 1:
        failures = failures + 1
        log = log + "selftest delta-y: FAIL (mismatched=" + r2.mismatched.to_string() + ")\n"
    elif r2.rows[0].dy != 14:
        failures = failures + 1
        log = log + "selftest delta-y: FAIL (dy=" + r2.rows[0].dy.to_string() + ")\n"
    else:
        log = log + "selftest delta-y: PASS (1 mismatch, dy=14)\n"

    val truncated_simple = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: "")
    ]
    val r3 = geometry_diff(identical_chrome, truncated_simple, 1)
    if r3.missing_in_simple != 1 or r3.compared != 1:
        failures = failures + 1
        log = log + "selftest missing-element: FAIL (missing=" +
              r3.missing_in_simple.to_string() + ")\n"
    else:
        log = log + "selftest missing-element: PASS (1 missing in Simple)\n"

    # A child that only repeats its parent's offset is ONE bug, not two.
    val nested_chrome = parse_chrome_geom(
        "GEOM|path:|body|0|0|900|600|display=block\n" +
        "GEOM|path:0|div|10|10|100|50|display=block\n" +
        "GEOM|path:0/0|span|10|10|100|50|display=block\n")
    val nested_simple = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "div", x: 10, y: 40, w: 100, h: 50, features: ""),
        GeomBox(key: "path:0/0", tag: "span", x: 10, y: 40, w: 100, h: 50, features: "")
    ]
    val r4 = geometry_diff(nested_chrome, nested_simple, 1)
    if r4.mismatched != 2 or r4.root_mismatched != 1 or r4.inherited_mismatched != 1:
        failures = failures + 1
        log = log + "selftest inherited-delta: FAIL (root=" +
              r4.root_mismatched.to_string() + " inherited=" +
              r4.inherited_mismatched.to_string() + ")\n"
    else:
        log = log + "selftest inherited-delta: PASS (2 mismatched, 1 root, 1 inherited)\n"

    # An all-zero Simple side is a page that was never laid out, and must be
    # recognised as such rather than reported as "everything mismatches".
    # Both halves are checked: the degenerate side must be caught, and a real
    # side that merely CONTAINS a zero box must not be.
    val degenerate = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 0, h: 0, features: ""),
        GeomBox(key: "path:0", tag: "div", x: 0, y: 0, w: 0, h: 0, features: "")
    ]
    if not all_boxes_degenerate(degenerate) or all_boxes_degenerate(nested_simple):
        failures = failures + 1
        log = log + "selftest all-zero-side: FAIL\n"
    else:
        log = log + "selftest all-zero-side: PASS (degenerate caught, real side kept)\n"

    # --- boxless elements (round 20) ---------------------------------------
    # Chrome reports an element that generates no box as the all-zero rect.
    # Four fixtures, and the two CONTROLS are the load-bearing half: without
    # them this rule would also swallow a Simple side that failed to lay an
    # element out at all, which is the opposite defect.
    val boxless_chrome = parse_chrome_geom(
        "GEOM|path:|body|0|0|900|600|display=block\n" +
        "GEOM|path:0|div|10|10|100|50|display=block\n" +
        "GEOM|path:0/0|wbr|0|0|0|0|display=inline\n")

    # (a) Chrome boxless, Simple emits no row for it at all -> agreement.
    val boxless_agree = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "div", x: 10, y: 10, w: 100, h: 50, features: "")
    ]
    val r5 = geometry_diff(boxless_chrome, boxless_agree, 1)
    if r5.compared != 3 or r5.mismatched != 0 or r5.missing_in_simple != 0:
        failures = failures + 1
        log = log + "selftest boxless-agreement: FAIL (compared=" +
              r5.compared.to_string() + " mismatched=" +
              r5.mismatched.to_string() + " missing=" +
              r5.missing_in_simple.to_string() + ")\n"
    else:
        log = log + "selftest boxless-agreement: PASS (3 compared, 0 mismatched, 0 missing)\n"

    # (b) Chrome boxless, Simple emits a REAL box -> one extra_box mismatch
    # whose four deltas are 0, so the Sigma metric weighs it as one defect and
    # not as the magnitude of a position Chrome never claimed.
    val boxless_extra = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "div", x: 10, y: 10, w: 100, h: 50, features: ""),
        GeomBox(key: "path:0/0", tag: "wbr", x: 180, y: 9781, w: 1, h: 1, features: "")
    ]
    val r6 = geometry_diff(boxless_chrome, boxless_extra, 1)
    var r6_row = -1
    var r6i = 0
    while r6i < r6.rows.len():
        if r6.rows[r6i].feature == "extra_box":
            r6_row = r6i
        r6i = r6i + 1
    if r6.compared != 3 or r6.mismatched != 1 or r6.root_mismatched != 1 or r6_row < 0:
        failures = failures + 1
        log = log + "selftest boxless-extra-box: FAIL (mismatched=" +
              r6.mismatched.to_string() + " root=" +
              r6.root_mismatched.to_string() + ")\n"
    elif r6.rows[r6_row].dx != 0 or r6.rows[r6_row].dy != 0 or
         r6.rows[r6_row].dw != 0 or r6.rows[r6_row].dh != 0:
        failures = failures + 1
        log = log + "selftest boxless-extra-box: FAIL (deltas not zeroed: dy=" +
              r6.rows[r6_row].dy.to_string() + ")\n"
    else:
        log = log + "selftest boxless-extra-box: PASS (1 extra_box, all deltas 0)\n"

    # (c) CONTROL, opposite direction: Chrome reports a REAL box and Simple's
    # is all-zero. That is an element Simple never laid out -- a genuine layout
    # failure -- and it must stay a FULL-magnitude mismatch, never be excused
    # as "boxless". This is the fixture that stops the rule widening.
    val boxless_control_simple_zero = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "div", x: 0, y: 0, w: 0, h: 0, features: ""),
        GeomBox(key: "path:0/0", tag: "wbr", x: 0, y: 0, w: 0, h: 0, features: "")
    ]
    val r7 = geometry_diff(boxless_chrome, boxless_control_simple_zero, 1)
    var r7_div = -1
    var r7i = 0
    while r7i < r7.rows.len():
        if r7.rows[r7i].key == "path:0":
            r7_div = r7i
        r7i = r7i + 1
    if r7.mismatched != 1 or r7_div < 0:
        failures = failures + 1
        log = log + "selftest boxless-control-simple-zero: FAIL (mismatched=" +
              r7.mismatched.to_string() + ")\n"
    elif r7.rows[r7_div].dx != 10 or r7.rows[r7_div].dy != 10 or
         r7.rows[r7_div].dw != 100 or r7.rows[r7_div].dh != 50:
        failures = failures + 1
        log = log + "selftest boxless-control-simple-zero: FAIL (deltas suppressed: dy=" +
              r7.rows[r7_div].dy.to_string() + ")\n"
    else:
        log = log + "selftest boxless-control-simple-zero: PASS (real box vs zero still full-Sigma)\n"

    # (d) CONTROL: Chrome reports a REAL box and Simple emits NO row. Absence
    # is agreement ONLY under the boxless arm; here it must still be
    # `missing_in_simple`, exactly as fixture 3 asserts for the pre-round-20
    # path.
    val boxless_control_absent = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0/0", tag: "wbr", x: 0, y: 0, w: 0, h: 0, features: "")
    ]
    val r8 = geometry_diff(boxless_chrome, boxless_control_absent, 1)
    if r8.missing_in_simple != 1:
        failures = failures + 1
        log = log + "selftest boxless-control-absent: FAIL (missing=" +
              r8.missing_in_simple.to_string() + ")\n"
    else:
        log = log + "selftest boxless-control-absent: PASS (real box absent is still missing_in_simple)\n"

    # --- not-rendered elements (round 22) ----------------------------------
    # Chrome reports a fully NON-ZERO phantom rect for an element it does not
    # render (a content-visibility:hidden subtree, e.g. the children of a closed
    # <details>). Every fixture below carries a real rect, so the boxless arm
    # above cannot reach any of them — only `rendered=false` can.
    val notrendered_chrome = parse_chrome_geom(
        "GEOM|path:|body|0|0|900|600|display=block|rendered=true\n" +
        "GEOM|path:0|details|45|365|810|24|display=block|rendered=true\n" +
        "GEOM|path:0/0|summary|45|365|810|24|display=block|rendered=true\n" +
        "GEOM|path:0/1|p|45|405|810|24|display=block|rendered=false\n")

    # (e) Chrome not-rendered (phantom rect), Simple emits a ZERO-SIZE box at a
    # position of its own -- the exact forms-media shape. This is agreement:
    # neither engine renders the element. Before this rule it was a full-Sigma
    # mismatch worth 864.
    val notrendered_agree = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "details", x: 45, y: 365, w: 810, h: 24, features: ""),
        GeomBox(key: "path:0/0", tag: "summary", x: 45, y: 365, w: 810, h: 24, features: ""),
        GeomBox(key: "path:0/1", tag: "p", x: 45, y: 375, w: 0, h: 0, features: "")
    ]
    val r9 = geometry_diff(notrendered_chrome, notrendered_agree, 1)
    if r9.compared != 4 or r9.mismatched != 0:
        failures = failures + 1
        log = log + "selftest not-rendered-agreement: FAIL (compared=" +
              r9.compared.to_string() + " mismatched=" +
              r9.mismatched.to_string() + ")\n"
    else:
        log = log + "selftest not-rendered-agreement: PASS (4 compared, 0 mismatched)\n"

    # (f) CONTROL that stops the rule widening: Chrome does not render it and
    # Simple draws a REAL box. Simple is rendering something Chrome does not, so
    # this stays a mismatch -- `extra_box`, deltas zeroed. If this fixture ever
    # passes as agreement, the rule has become "ignore the row", which is the
    # compensating-error state this arm exists to avoid.
    val notrendered_extra = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "details", x: 45, y: 365, w: 810, h: 24, features: ""),
        GeomBox(key: "path:0/0", tag: "summary", x: 45, y: 365, w: 810, h: 24, features: ""),
        GeomBox(key: "path:0/1", tag: "p", x: 45, y: 405, w: 810, h: 24, features: "")
    ]
    val r10 = geometry_diff(notrendered_chrome, notrendered_extra, 1)
    if r10.mismatched != 1:
        failures = failures + 1
        log = log + "selftest not-rendered-control-extra-box: FAIL (mismatched=" +
              r10.mismatched.to_string() + ")\n"
    else:
        log = log + "selftest not-rendered-control-extra-box: PASS (Simple box Chrome does not render is still a mismatch)\n"

    # (g) CONTROL that pins the rule's SCOPE: a `rendered=true` row with a real
    # rect is compared at full Sigma exactly as before. This is the fixture that
    # proves the new predicate reads the flag rather than matching the tag or
    # forgiving every row that carries a `rendered=` field at all --
    # visibility:hidden and opacity:0 elements are `rendered=true` in Chrome and
    # must keep their deltas.
    val notrendered_control_visible = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "details", x: 45, y: 365, w: 810, h: 24, features: ""),
        GeomBox(key: "path:0/0", tag: "summary", x: 45, y: 465, w: 810, h: 24, features: ""),
        GeomBox(key: "path:0/1", tag: "p", x: 45, y: 375, w: 0, h: 0, features: "")
    ]
    val r11 = geometry_diff(notrendered_chrome, notrendered_control_visible, 1)
    if r11.mismatched != 1:
        failures = failures + 1
        log = log + "selftest not-rendered-control-visible-row: FAIL (mismatched=" +
              r11.mismatched.to_string() + ")\n"
    else:
        log = log + "selftest not-rendered-control-visible-row: PASS (rendered=true row still compared at full Sigma)\n"

    if failures == 0:
        log + "SELFTEST PASS — 12 fixture(s) checked"
    else:
        log + "SELFTEST FAIL — " + failures.to_string() + " of 12 fixture(s) failed"

fn main():
    val args = get_cli_args()
    val selftest = selftest_report()
    print(selftest)
    if selftest.contains("SELFTEST FAIL"):
        print("ERROR — nothing was checked (selftest failed)")
        return
    if args.len() == 0:
        return
    if args[0] == "selftest":
        return
    # simple-geom <html> [width] [height] — dump the Simple side only, in the
    # same GEOM| shape Chrome's walker emits, so a per-element delta can be
    # read with its SIGN (the diff rows carry |delta| by design).
    if args[0] == "simple-geom":
        if args.len() < 2:
            print("ERROR — nothing was checked (usage: simple-geom <html> [w] [h])")
            return
        val sg_w = if args.len() > 2: args[2].to_i32() else: 900
        val sg_h = if args.len() > 3: args[3].to_i32() else: 760
        val sg_boxes = simple_geom_boxes(file_read_text(args[1]), sg_w, sg_h)
        for b in sg_boxes:
            print("GEOM|" + b.key + "|" + b.tag + "|" + b.x.to_string() + "|" +
                  b.y.to_string() + "|" + b.w.to_string() + "|" + b.h.to_string())
        print("simple_boxes=" + sg_boxes.len().to_string())
        return
    # diff <html> <chrome-geom> <out-prefix> [width] [height]
    if args.len() < 4:
        print("ERROR — nothing was checked (usage: diff <html> <chrome-geom> <out-prefix> [w] [h])")
        return
    val html_path = args[1]
    val geom_path = args[2]
    val out_prefix = args[3]
    val width = if args.len() > 4: args[4].to_i32() else: 900
    val height = if args.len() > 5: args[5].to_i32() else: 760
    val html = file_read_text(html_path)
    val dump = file_read_text(geom_path)
    val chrome = parse_chrome_geom(dump)
    val simple = simple_geom_boxes(html, width, height)
    # A render that tripped its wall-clock budget is TRUNCATED, not laid out:
    # every node past the break keeps renderer_default_style() and contributes
    # a box that is wrong for a reason that has nothing to do with CSS. Reading
    # such a run as a geometry comparison is exactly how round 13's numbers
    # became void, so this is fail-closed rather than a warning. The break is
    # total on html.html (node 46 of 883 => all-zero side) but need not be:
    # a break at node 800 leaves a plausible-looking table that is still a
    # measurement of the deadline, not of the layout.
    if simple_web_layout_last_render_degraded():
        print("chrome_boxes=" + chrome.len().to_string())
        print("simple_boxes=" + simple.len().to_string())
        print("ERROR — nothing was checked (the Simple render for " + html_path +
              " tripped its wall-clock render budget (" +
              simple_web_layout_last_render_degrade_reason() +
              "); the layout is truncated, not slow. Raise " +
              "SIMPLE_WEB_RENDER_BUDGET_MS — SIMPLE_TIMEOUT_SECONDS does NOT " +
              "disable the render budget)")
        return
    if all_boxes_degenerate(simple):
        print("chrome_boxes=" + chrome.len().to_string())
        print("simple_boxes=" + simple.len().to_string())
        print("ERROR — nothing was checked (every Simple box is 0x0 at 0,0 for " +
              html_path + "; the page was not laid out. Run with " +
              "SIMPLE_EXECUTION_MODE=interpreter and SIMPLE_TIMEOUT_SECONDS=0)")
        return
    val result = geometry_diff(chrome, simple, 1)
    file_write(out_prefix + ".sdn", diff_sdn(html_path, result))
    file_write(out_prefix + ".md", diff_md(html_path, result))
    print("chrome_boxes=" + chrome.len().to_string())
    print("simple_boxes=" + simple.len().to_string())
    print("compared=" + result.compared.to_string())
    print("mismatched=" + result.mismatched.to_string())
    print("root_mismatched=" + result.root_mismatched.to_string())
    print("inherited_mismatched=" + result.inherited_mismatched.to_string())
    print("missing_in_simple=" + result.missing_in_simple.to_string())
    print("missing_in_chrome=" + result.missing_in_chrome.to_string())
    if result.compared == 0:
        print("ERROR — nothing was checked (0 element(s) compared for " + html_path + ")")
    else:
        print("PASS — " + result.compared.to_string() + " element(s) compared, " +
              result.mismatched.to_string() + " mismatched")
