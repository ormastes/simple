"""Shared HTML catalog: one standalone page per showcase tab, plus a tab-bar page.

Pure text transforms over the canonical fixture
`examples/06_io/ui/browser_common_elements_showcase.html` AFTER the 4K lane's
`web_renderable_feature_inventory_apply_to_showcase` has filled its panel slots. This
module does NOT author a second inventory or a second generator: it slices the one composed
document the Simple lane already uses, so both showcases consume byte-identical pages.

The catalog is written to `examples/06_io/ui/web_catalog/` as plain `.html` plus a
`catalog.sdn` index of `tab -> file`; the Simple web renderer showcase consumes the same
directory.
"""

pub val CHROME_CATALOG_DIR: text = "examples/06_io/ui/web_catalog"
pub val CHROME_CATALOG_INDEX: text = "examples/06_io/ui/web_catalog/catalog.sdn"
pub val CHROME_CATALOG_SOURCE: text = "examples/06_io/ui/browser_common_elements_showcase.html"

"""The seven canonical panel tabs, in the fixture's own tablist order."""
pub fn chrome_catalog_panel_tabs() -> [text]:
    ["overview", "html", "css-layout", "css-paint", "forms-media", "animation", "evidence"]

"""Panel tabs plus the synthetic `tab-bar` page. This is the catalog's page set."""
pub fn chrome_catalog_tabs() -> [text]:
    var tabs = chrome_catalog_panel_tabs()
    tabs.push("tab-bar")
    tabs

"""File name (not path) that a tab's page is written to."""
pub fn chrome_catalog_file_for(tab: text) -> text:
    tab + ".html"

fn _between(source: text, open_marker: text, close_marker: text) -> text:
    val start = source.index_of(open_marker)
    if start < 0:
        return ""
    val rest_from = start + open_marker.len()
    val tail = source.substring(rest_from, source.len())
    val end = tail.index_of(close_marker)
    if end < 0:
        return ""
    tail.substring(0, end)

"""The fixture's shared `<style>` body, reused verbatim by every catalog page."""
pub fn chrome_catalog_shared_style(source: text) -> text:
    _between(source, "<style>", "</style>")

"""The fixture's tablist `<nav>` markup, including its own opening tag."""
pub fn chrome_catalog_tablist_markup(source: text) -> text:
    val inner = _between(source, "<nav class=\"tabs\"", "</nav>")
    if inner == "":
        return ""
    "<nav class=\"tabs\"" + inner + "</nav>"

"""One tab panel `<section>` lifted out of the composed document, `hidden` removed.

`hidden` must go: the catalog page shows exactly one panel, and a hidden panel paints
nothing, which would make every tab's frame legitimately blank and therefore useless as
evidence.
"""
pub fn chrome_catalog_panel_markup(source: text, tab: text) -> text:
    val open_marker = "<section id=\"panel-" + tab + "\""
    val start = source.index_of(open_marker)
    if start < 0:
        return ""
    val tail = source.substring(start, source.len())
    val close_marker = "\n  </section>"
    val end = tail.index_of(close_marker)
    if end < 0:
        return ""
    val block = tail.substring(0, end + close_marker.len())
    block.replace(" hidden>", ">")

"""A standalone, self-contained page for one catalog tab."""
pub fn chrome_catalog_page(source: text, tab: text) -> text:
    var body = ""
    if tab == "tab-bar":
        body = chrome_catalog_tablist_markup(source)
    else:
        body = chrome_catalog_panel_markup(source, tab)
    if body == "":
        return ""
    var out = "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
    out = out + "<title>Simple Web Catalog — " + tab + "</title>\n<style>"
    out = out + chrome_catalog_shared_style(source)
    out = out + "</style>\n</head>\n<body data-catalog-tab=\"" + tab + "\">\n<main>\n"
    out = out + body
    out = out + "\n</main>\n</body>\n</html>\n"
    out

"""The `catalog.sdn` index body: inventory version plus a `tab -> file -> sha256` row.

Each row carries the page's OWN digest, so a digest of this one file transitively binds
every page byte. That is what makes `catalog_sha256` in the showcase receipt a real claim
that both showcases consumed the same catalog, rather than just the same index.

`digests` is parallel to `tabs`; a shorter list yields empty digests, which the consistency
check below rejects.
"""
pub fn chrome_catalog_index_text(inventory_version: text, tabs: [text], digests: [text]) -> text:
    var out = "# Shared HTML catalog consumed by BOTH the Chrome dynlib showcase and the\n"
    out = out + "# Simple web renderer showcase. Generated by src/app/ui/chrome_showcase.\n"
    out = out + "web_catalog:\n"
    out = out + "  inventory_version: " + inventory_version + "\n"
    out = out + "  source: " + CHROME_CATALOG_SOURCE + "\n"
    out = out + "  tabs:\n"
    var index: i64 = 0
    for tab in tabs:
        var digest = ""
        if index < digests.len():
            digest = digests[index]
        out = out + "    - tab: " + tab + "\n"
        out = out + "      file: " + chrome_catalog_file_for(tab) + "\n"
        out = out + "      sha256: " + digest + "\n"
        index = index + 1
    out

"""Per-page sha256 values listed by a rendered `catalog.sdn` body, in order."""
pub fn chrome_catalog_index_digests(body: text) -> [text]:
    var digests: [text] = []
    for line in body.split("\n"):
        val trimmed = line.trim()
        if trimmed.starts_with("sha256: "):
            digests.push(trimmed.substring(8, trimmed.len()))
    digests

"""Tab names listed by a rendered `catalog.sdn` body, in order."""
pub fn chrome_catalog_index_tabs(body: text) -> [text]:
    var tabs: [text] = []
    for line in body.split("\n"):
        val trimmed = line.trim()
        if trimmed.starts_with("- tab: "):
            tabs.push(trimmed.substring(7, trimmed.len()))
    tabs

"""File names listed by a rendered `catalog.sdn` body, in order."""
pub fn chrome_catalog_index_files(body: text) -> [text]:
    var files: [text] = []
    for line in body.split("\n"):
        val trimmed = line.trim()
        if trimmed.starts_with("file: "):
            files.push(trimmed.substring(6, trimmed.len()))
    files

"""True only when the index names every expected tab, in order, with its own file name.

Consistency is checked in BOTH directions: an index row for a page that was not generated
and a generated page with no index row are each a failure, because either one lets the two
showcases silently consume different page sets.
"""
pub fn chrome_catalog_index_consistent(body: text, expected_tabs: [text]) -> bool:
    val tabs = chrome_catalog_index_tabs(body)
    val files = chrome_catalog_index_files(body)
    if tabs.len() != expected_tabs.len() or files.len() != expected_tabs.len():
        return false
    val digests = chrome_catalog_index_digests(body)
    if digests.len() != expected_tabs.len():
        return false
    var index: i64 = 0
    while index < expected_tabs.len():
        if tabs[index] != expected_tabs[index]:
            return false
        if files[index] != chrome_catalog_file_for(expected_tabs[index]):
            return false
        # A row with no digest binds no bytes, so it is not a consistent index.
        if digests[index] == "":
            return false
        index = index + 1
    true
