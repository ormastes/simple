# svim shared editor core
#
# Editor-native public vocabulary backed by a shared session model.
# This v1 foundation keeps editing logic in the core so host TUI and
# future shells can reuse the same state and command surface.

# Split from src/app/svim/core.spl to keep module cohesion under the 800-line source limit.
export use app.svim._SvimCore.model.{rt_file_read_text, BufferId, WindowId, TabId, AnchorId, SvimMode, svim_mode_name, Cursor, Selection, ModeState, RegisterEntry, RegisterBank, JumpLocation, JumpList, QuickfixItem, QuickfixList, DiagnosticItem, EditorEvent, RpcRequest, RpcResponse, CommandRequest, CommandResult, SvimViewport, svim_command, svim_rpc_request, svim_diagnostic, SvimPiece, PieceTable, AnchorEntry, AnchorTracker, BufferSnapshot, SvimBuffer, SvimWindow, SvimTabpage, SvimSession}
export use app.svim._SvimCore.session_commands.{rt_file_read_text, rt_file_write_text}
export use app.svim._SvimCore.session_operators.{rt_file_read_text}
export use app.svim._SvimCore.text_ops.{rt_file_read_text, svim_snapshot_text, svim_parse_normal_command}
