"""Centralized worktree-local storage for SVIM editor sessions."""

use std.common.storage_roots.{CanonicalPath, StoragePathError}
use std.nogc_sync_mut.storage_roots.tooling_paths.{tooling_workspace_path}

pub fn svim_session_path(session: text, item: text) -> Result<CanonicalPath, StoragePathError>:
    tooling_workspace_path("svim", session, item)
