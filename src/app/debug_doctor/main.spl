# debug-doctor — print the REAL per-target debug/profile capability matrix.
#
#   bin/simple run src/app/debug_doctor/main.spl
#   bin/simple run src/app/debug_doctor/main.spl -- <program.spl>
#
# Design: doc/05_design/app/tools/unified_debug_profile_capability_architecture_2026-08-09.md §1.5, §5
# Plan:   doc/03_plan/agent_tasks/unified_debug_profile_capability_parallel_plan_2026-08-09.md (P11)
#
# Run-script form rather than a `bin/simple <subcommand>`: the plan leaves the
# choice to the implementer and this is the lighter path — a new subcommand
# would have to be threaded through src/app/cli/_CliMain/main_and_help.spl,
# dispatch/table.spl, surface_alignment.spl and bootstrap_check.spl (four
# contested files, plus a bootstrap before the deployed binary would answer
# to the name at all). The script needs none of that and runs today.
#
# Every row is produced by constructing the real thing and calling it:
# the GPU rows are live *LaneSession.probe() results from THIS machine, and
# the host profile cell is an elapsed time actually measured while the doctor
# runs. Nothing here is a static table. A target with no landed DebugTarget
# says so, and names the stream that will provide it, rather than claiming a
# capability that nothing implements.

use std.debug_doctor.matrix.{
    RegisteredCapability, CapabilityRegistry, doctor_rows, render_doctor_matrix, doctor_detail_lines,
    row_is_attachable, row_can_debug, doctor_capabilities_v1, render_doctor_capabilities_v1
}
use std.notebook.gpu_mode_probe_live.{LiveGpuBackendProbe}
use std.notebook.gpu_config.{load_project_gpu_config}
use std.notebook.gpu_mode_resolver.{resolve_gpu_mode_spec}
use std.cli.cli_util (get_cli_args)
use app.dap.host_debug_target.{HostDebugTarget}
use std.common.debug.capability.{CapLevel}
use std.nogc_sync_mut.io.file_ops.{file_exists}
use app.cli.bootstrap_identity.{bootstrap_version}
use app.debug_doctor.profile_v1.{
    DebugDoctorProfileV1, load_debug_doctor_profile_v1, evaluate_debug_doctor_profile_v1
}

pub fn debug_doctor_registry(program: text) -> CapabilityRegistry:
    var registry = CapabilityRegistry.create()
    if program != "" and file_exists(program):
        var target = HostDebugTarget.launch(program)
        val state = target.state()
        if target.kind() == "host" and target.debug_level() == CapLevel.Native and state.pc_kind == "line":
            registry.register(RegisteredCapability(
                target: "host",
                debug_level: "native",
                debug_detail: "line",
                # This live check constructs only DebugTarget. Do not infer a
                # ProfileTarget merely because host debugging is reachable.
                profile_level: "unavailable",
                profile_detail: "no live ProfileTarget probe performed",
            ))
        target.detach()
    registry

fn _run_debug_doctor_v1(program: text, profile: DebugDoctorProfileV1?) -> i64:
    print("simple debug-doctor — debug/profile capability matrix")
    print("")

    # The registry starts empty; P3/P6/P8 register their targets as they land.
    # An empty registry is not an error, it is the truthful state of the tree.
    var registry = debug_doctor_registry(program)
    var probe = LiveGpuBackendProbe.create()

    val rows = doctor_rows(registry, probe, program)
    print(render_doctor_matrix(rows))
    print("")
    val reports = doctor_capabilities_v1(rows, bootstrap_version())
    print(render_doctor_capabilities_v1(reports))
    print("")
    val details = doctor_detail_lines(rows)
    if details != "":
        print("detail:")
        print(details)
        print("")

    var attachable = 0
    var debuggable = 0
    for row in rows:
        if row_is_attachable(row):
            attachable = attachable + 1
        if row_can_debug(row):
            debuggable = debuggable + 1
    print("attachable targets: {attachable} of {rows.len()}")
    print("targets with a usable DebugTarget: {debuggable} of {rows.len()}")

    # What a bare `gpu` tag resolves to on this host, right now, using the
    # project's own `gpu:` config section and the same live probe.
    val config = load_project_gpu_config()
    print("")
    print("gpu config: backend={config.backend} submode={config.submode} arch={config.arch}  (simple.sdn `gpu:` section)")
    val resolved = resolve_gpu_mode_spec("gpu", config, probe)
    if resolved.error != "":
        print("bare `gpu` tag resolves to: <error>")
        print(resolved.error)
    else:
        print("bare `gpu` tag resolves to: {resolved.spec}  (target {resolved.target})")
    val host = resolve_gpu_mode_spec("", config, probe)
    print("no tag resolves to: host lane (spec \"{host.spec}\")")
    if val required = profile:
        val health = evaluate_debug_doctor_profile_v1(required, reports)
        val status = if health.healthy: "healthy" else: "unhealthy"
        print("")
        print("DebugDoctorHealthV1: status={status} checked={health.checked} failures={health.failures.len()}")
        for failure in health.failures:
            print("  failure={failure}")
        if not health.healthy:
            return 3
    0

pub fn debug_doctor_main(program: text) -> i64:
    _run_debug_doctor_v1(program, nil)

pub fn debug_doctor_profile_main(profile_path: text) -> i64:
    val loaded = load_debug_doctor_profile_v1(profile_path)
    if not loaded.ok:
        print("DebugDoctorHealthV1: status=invalid checked=0 failures=1")
        print("  failure=" + loaded.error)
        return 2
    _run_debug_doctor_v1(loaded.profile.program, Some(loaded.profile))

fn _doctor_program_arg() -> text:
    val args = get_cli_args()
    var i = 0
    while i < args.len():
        val arg = args[i]
        if (arg.ends_with(".spl") or arg.ends_with(".sdn")) and not arg.contains("debug_doctor/main.spl"):
            return arg
        i = i + 1
    ""

fn main() -> i64:
    val argument = _doctor_program_arg()
    if argument.ends_with(".sdn"):
        return debug_doctor_profile_main(argument)
    debug_doctor_main(argument)
