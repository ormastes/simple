# Jupyter Kernel for Simple Language
# JSON-lines protocol over stdin/stdout — all-in-one (no cross-module imports)
#
# Protocol: Python wrapper sends JSON-lines on stdin, kernel replies on stdout
# Message format: {"channel":"shell","msg_type":"...","msg_id":"...","session":"...","content":{...}}

extern fn input() -> text
extern fn stdout_write(s: text)
extern fn stdout_flush()
use std.io_runtime.{get_args}

use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
use std.log.{error}
use std.notebook.types.{CellResult}
use std.notebook.session_manager.{KernelSessionManager}
use std.notebook.local_exec.{LocalExecFactory}
use std.notebook.lsp_bridge.{LspBridge}
use app.simple_lab.export_sdoctest.{export_notebook_file}
use std.notebook.magics.{MagicsState, MagicsResult, dispatch_magics}

# ============================================================================
# JSON Helpers (inlined to avoid cross-module issues)
# ============================================================================

fn Q() -> text:
    "\""

fn LB() -> text:
    "{"

fn RB() -> text:
    "}"

fn SB_L() -> text:
    "["

fn SB_R() -> text:
    "]"

fn escape_json(s: text) -> text:
    var result = s
    result = result.replace(r"\", r"\\")
    result = result.replace(Q(), r"\" + Q())
    result = result.replace("\n", r"\n")
    result = result.replace("\r", r"\r")
    result = result.replace("\t", r"\t")
    result

fn js(s: text) -> text:
    Q() + escape_json(s) + Q()

fn jp(key: text, value: text) -> text:
    Q() + key + Q() + ":" + value

fn jo1(p1: text) -> text:
    LB() + p1 + RB()

fn jo2(p1: text, p2: text) -> text:
    LB() + p1 + "," + p2 + RB()

fn jo3(p1: text, p2: text, p3: text) -> text:
    LB() + p1 + "," + p2 + "," + p3 + RB()

fn jo4(p1: text, p2: text, p3: text, p4: text) -> text:
    LB() + p1 + "," + p2 + "," + p3 + "," + p4 + RB()

fn jo5(p1: text, p2: text, p3: text, p4: text, p5: text) -> text:
    LB() + p1 + "," + p2 + "," + p3 + "," + p4 + "," + p5 + RB()

fn extract_field(json: text, key: text) -> text:
    val search = Q() + key + Q() + ":"
    val idx = json.index_of(search)
    if idx < 0:
        return ""
    val start = idx + search.len()
    val after = json.substring(start)
    val trimmed = after.trim()
    if trimmed.starts_with(Q()):
        # Parse JSON string value, handling escape sequences
        var result_parts: [text] = []
        var pos = 1
        var escaped = false
        while pos < trimmed.len():
            val ch = trimmed.char_at(pos)
            if escaped:
                if ch == Q():
                    result_parts.push(Q())
                elif ch == "n":
                    result_parts.push("\n")
                elif ch == "r":
                    result_parts.push("\r")
                elif ch == "t":
                    result_parts.push("\t")
                elif ch == r"\":
                    result_parts.push(r"\")
                else:
                    result_parts.push(ch)
                escaped = false
            elif ch == r"\":
                escaped = true
            elif ch == Q():
                break
            else:
                result_parts.push(ch)
            pos = pos + 1
        return result_parts.join("")
    else:
        var parts: [text] = []
        for ch in trimmed:
            if ch == "," or ch == RB() or ch == SB_R() or ch == " " or ch == "\n":
                break
            parts.push(ch)
        return parts.join("")

# ============================================================================
# Session state — owned by KernelSessionManager (K1) over a LocalExec (K2)
# lane executor. main.spl is now a thin JSON-lines front-end: it registers
# one implicit "default" kernel session on the `interpreter` lane at startup
# and routes every execute_request through the manager, which owns the
# accumulation/rollback/delta logic (moved to
# src/lib/nogc_sync_mut/notebook/local_exec.spl — behavior is bit-identical
# to the pre-K2 module-level implementation this replaces).
# ============================================================================

const DEFAULT_SESSION_ID: text = "default"

var SESSION_MANAGER: KernelSessionManager = KernelSessionManager.create(LocalExecFactory())

# Lazily started on the first complete_request/inspect_request (design §5.1) —
# most notebook sessions never trigger completion, so paying the LSP
# subprocess's startup cost for every kernel is wasteful.
var LSP_BRIDGE: LspBridge? = nil

fn session_init():
    SESSION_MANAGER.create_session(DEFAULT_SESSION_ID, "interpreter")

fn get_or_start_lsp_bridge() -> LspBridge:
    if val bridge = LSP_BRIDGE:
        return bridge
    val bridge = LspBridge.start()
    LSP_BRIDGE = bridge
    bridge

fn cursor_pos_to_line_col(code: text, cursor_pos: i64) -> (i64, i64):
    """Jupyter's complete_request/inspect_request give a flat character
    offset into `code`; the LSP wants 0-indexed (line, col)."""
    var line = 0
    var col = 0
    var i = 0
    while i < cursor_pos and i < code.len():
        if code.char_at(i) == "\n":
            line = line + 1
            col = 0
        else:
            col = col + 1
        i = i + 1
    (line, col)

# Per-session magics state (%budget/%timeout/%onfault) — currently a single
# implicit session, matching SESSION_MANAGER/LSP_BRIDGE's own scope.
var MAGICS_STATE: MagicsState = MagicsState.create()

fn session_execute(code: text, exec_count: i64) -> (text, text, bool):
    val magics: MagicsResult = dispatch_magics(SESSION_MANAGER, DEFAULT_SESSION_ID, MAGICS_STATE, code)
    if magics.error != "":
        return ("", magics.error, false)
    if magics.code.trim() == "":
        # Magics-only cell (e.g. bare %reset, %lanes, %mode): nothing left
        # to execute — the magic's own confirmation/table IS the output.
        return (magics.message, "", true)
    val result: CellResult = SESSION_MANAGER.execute_cell(DEFAULT_SESSION_ID, magics.code, "cell_{exec_count}", magics.cell_mode_override)
    if result.is_ok():
        var output = result.stdout_delta
        if magics.message != "":
            output = magics.message + "\n" + output
        return (output, "", true)
    ("", result.error, false)

fn session_is_complete(code: text) -> text:
    val trimmed = code.trim()
    if trimmed == "":
        return "complete"
    if trimmed.ends_with(":"):
        return "incomplete"
    "complete"

# ============================================================================
# Kernel state
# ============================================================================

var KERNEL_RUNNING: bool = true
var EXECUTION_COUNT: i64 = 0

fn send_message(channel: text, msg_type: text, parent_msg_id: text, content: text):
    val msg = jo4(
        jp("channel", js(channel)),
        jp("msg_type", js(msg_type)),
        jp("parent_msg_id", js(parent_msg_id)),
        jp("content", content)
    )
    stdout_write(msg + "\n")
    stdout_flush()

fn send_status(parent_msg_id: text, state: text):
    val content = jo1(jp("execution_state", js(state)))
    send_message("iopub", "status", parent_msg_id, content)

fn handle_kernel_info(msg_id: text):
    send_status(msg_id, "busy")
    val lang_info = jo5(
        jp("name", js("simple")),
        jp("version", js("0.2.0")),
        jp("mimetype", js("text/x-simple")),
        jp("file_extension", js(".spl")),
        jp("pygments_lexer", js("text"))
    )
    val content = jo5(
        jp("status", js("ok")),
        jp("protocol_version", js("5.4")),
        jp("implementation", js("simple-kernel")),
        jp("implementation_version", js("0.1.0")),
        jp("language_info", lang_info)
    )
    send_message("shell", "kernel_info_reply", msg_id, content)
    send_status(msg_id, "idle")

fn handle_execute(msg_id: text, raw_msg: text):
    send_status(msg_id, "busy")
    EXECUTION_COUNT = EXECUTION_COUNT + 1
    val code = extract_field(raw_msg, "code")

    val input_content = jo2(
        jp("code", js(code)),
        jp("execution_count", str(EXECUTION_COUNT))
    )
    send_message("iopub", "execute_input", msg_id, input_content)

    val (output, error, success) = session_execute(code, EXECUTION_COUNT)

    if success:
        if output.trim() != "":
            val stream_content = jo2(
                jp("name", js("stdout")),
                jp("text", js(output))
            )
            send_message("iopub", "stream", msg_id, stream_content)
        val reply_content = jo2(
            jp("status", js("ok")),
            jp("execution_count", str(EXECUTION_COUNT))
        )
        send_message("shell", "execute_reply", msg_id, reply_content)
    else:
        val err_content = jo3(
            jp("ename", js("ExecutionError")),
            jp("evalue", js(error)),
            jp("traceback", SB_L() + js(error) + SB_R())
        )
        send_message("iopub", "error", msg_id, err_content)
        val reply_content = jo3(
            jp("status", js("error")),
            jp("execution_count", str(EXECUTION_COUNT)),
            jp("ename", js("ExecutionError"))
        )
        send_message("shell", "execute_reply", msg_id, reply_content)

    send_status(msg_id, "idle")

fn handle_is_complete(msg_id: text, raw_msg: text):
    val code = extract_field(raw_msg, "code")
    val status = session_is_complete(code)
    val content = jo1(jp("status", js(status)))
    send_message("shell", "is_complete_reply", msg_id, content)

fn handle_shutdown(msg_id: text):
    val content = jo2(
        jp("status", js("ok")),
        jp("restart", "false")
    )
    send_message("shell", "shutdown_reply", msg_id, content)
    KERNEL_RUNNING = false

fn handle_comm_info(msg_id: text):
    val content = jo2(
        jp("status", js("ok")),
        jp("comms", LB() + RB())
    )
    send_message("shell", "comm_info_reply", msg_id, content)

# ============================================================================
# complete_request / inspect_request (design §5.1: forwarded to the Simple
# LSP over a session-long subprocess; positions mapped from cell text).
# ============================================================================

fn json_string_array(items: [text]) -> text:
    var parts: [text] = []
    for item in items:
        parts.push(js(item))
    SB_L() + parts.join(",") + SB_R()

fn handle_complete(msg_id: text, raw_msg: text):
    val code = extract_field(raw_msg, "code")
    val cursor_pos = extract_field(raw_msg, "cursor_pos").trim().to_i64() ?? 0
    val (line, col) = cursor_pos_to_line_col(code, cursor_pos)
    val bridge = get_or_start_lsp_bridge()
    val matches = bridge.complete(code, line, col)
    val content = jo5(
        jp("matches", json_string_array(matches)),
        jp("cursor_start", str(cursor_pos)),
        jp("cursor_end", str(cursor_pos)),
        jp("metadata", LB() + RB()),
        jp("status", js("ok"))
    )
    send_message("shell", "complete_reply", msg_id, content)

fn handle_inspect(msg_id: text, raw_msg: text):
    val code = extract_field(raw_msg, "code")
    val cursor_pos = extract_field(raw_msg, "cursor_pos").trim().to_i64() ?? 0
    val (line, col) = cursor_pos_to_line_col(code, cursor_pos)
    val bridge = get_or_start_lsp_bridge()
    val hover_text = bridge.inspect(code, line, col)
    val found = hover_text.trim() != ""
    var data = LB() + RB()
    if found:
        data = jo1(jp("text/plain", js(hover_text)))
    val content = jo4(
        jp("status", js("ok")),
        jp("found", if found: "true" else: "false"),
        jp("data", data),
        jp("metadata", LB() + RB())
    )
    send_message("shell", "inspect_reply", msg_id, content)

# ============================================================================
# interrupt_request (control channel) — design §5.1: NotebookExecutor.interrupt()
# on the session's active lane. This kernel currently only ever runs the
# "interpreter" lane (design §5.3 escalation applies to the other lanes'
# executors; the local lane's interrupt() is itself still a no-op per K2 —
# tracked there, not a new gap this handler introduces).
# ============================================================================

fn handle_interrupt(msg_id: text):
    val diag = SESSION_MANAGER.interrupt_session(DEFAULT_SESSION_ID, "interpreter")
    # Jupyter interrupt semantics: interrupting an idle kernel (no cell has
    # run yet, so no cached executor exists for this lane) is a no-op
    # success, not an error — only an unknown-session diagnostic is a real
    # failure here.
    val is_idle_noop = diag.starts_with("No active executor for mode:")
    val status = if diag == "" or is_idle_noop: "ok" else: "error"
    val content = jo1(jp("status", js(status)))
    send_message("control", "interrupt_reply", msg_id, content)

# ============================================================================
# comm `simple_lane` (design §5.1): lane list + statuses + current mode; a
# set-mode command runs `%mode` server-side. Powers the JupyterLab lane
# picker (design §6) once wired there (X3).
# ============================================================================

const SIMPLE_LANE_COMM_TARGET: text = "simple_lane"

fn extract_object_field(json: text, key: text) -> text:
    """Like extract_field, but for a nested object/array value: scans
    balanced braces/brackets from the first `{`/`[` after the key instead
    of stopping at the first inner comma."""
    val search = Q() + key + Q() + ":"
    val idx = json.index_of(search)
    if idx < 0:
        return ""
    val start = idx + search.len()
    val after = json.substring(start)
    val trimmed = after.trim()
    if trimmed == "":
        return ""
    val open_ch = trimmed.char_at(0)
    if open_ch != "{" and open_ch != SB_L():
        return ""
    val close_ch = if open_ch == "{": RB() else: SB_R()
    var depth = 0
    var i = 0
    var in_str = false
    while i < trimmed.len():
        val ch = trimmed.char_at(i)
        if in_str:
            if ch == r"\":
                i = i + 1
            elif ch == Q():
                in_str = false
        else:
            if ch == Q():
                in_str = true
            elif ch == open_ch:
                depth = depth + 1
            elif ch == close_ch:
                depth = depth - 1
                if depth == 0:
                    return trimmed.substring(0, i + 1)
        i = i + 1
    ""

fn lane_status_content() -> text:
    jo2(
        jp("mode", js(SESSION_MANAGER.default_mode_of(DEFAULT_SESSION_ID))),
        jp("lanes", json_string_array(["interpreter"]))
    )

# ============================================================================
# comm `simple_export` (X4, design §7.3/§7.4): receives an
# {"action":"export_sdoctest","in_path":...,"out_path":...} request (sent as
# the comm_open payload by tools/jupyter/labextension/src/export.ts's
# "Export notebook as SDoctest" command) and runs the shared L1 exporter
# (src/app/simple_lab/export_sdoctest.spl `export_notebook_file`) against it,
# replying with {"status":"ok","out_path":...} or
# {"status":"error","error":...} over the same comm.
# ============================================================================

const SIMPLE_EXPORT_COMM_TARGET: text = "simple_export"

fn handle_export_request(comm_id: text, data: text):
    val in_path = extract_field(data, "in_path")
    val out_path = extract_field(data, "out_path")
    val result = export_notebook_file(in_path, out_path)
    match result:
        case Ok(_):
            send_comm_msg(comm_id, jo2(jp("status", js("ok")), jp("out_path", js(out_path))))
        case Err(msg):
            send_comm_msg(comm_id, jo2(jp("status", js("error")), jp("error", js(msg))))

fn send_comm_msg(comm_id: text, data: text):
    val content = jo2(
        jp("comm_id", js(comm_id)),
        jp("data", data)
    )
    send_message("iopub", "comm_msg", "", content)

fn handle_comm_open(raw_msg: text):
    val target = extract_field(raw_msg, "target_name")
    val comm_id = extract_field(raw_msg, "comm_id")
    if target == SIMPLE_LANE_COMM_TARGET:
        send_comm_msg(comm_id, lane_status_content())
    elif target == SIMPLE_EXPORT_COMM_TARGET:
        handle_export_request(comm_id, extract_object_field(raw_msg, "data"))

fn handle_comm_msg(raw_msg: text):
    val comm_id = extract_field(raw_msg, "comm_id")
    val data = extract_object_field(raw_msg, "data")
    if extract_field(data, "action") == "export_sdoctest":
        handle_export_request(comm_id, data)
        return
    val new_mode = extract_field(data, "set_mode")
    if new_mode.trim() != "":
        SESSION_MANAGER.set_default_mode(DEFAULT_SESSION_ID, new_mode.trim())
    send_comm_msg(comm_id, lane_status_content())

fn kernel_main():
    session_init()
    while KERNEL_RUNNING:
        val line = input() ?? ""
        if line == "":
            KERNEL_RUNNING = false
            continue

        val msg_type = extract_field(line, "msg_type")
        val msg_id = extract_field(line, "msg_id")

        if msg_type == "kernel_info_request":
            handle_kernel_info(msg_id)
        elif msg_type == "execute_request":
            handle_execute(msg_id, line)
        elif msg_type == "is_complete_request":
            handle_is_complete(msg_id, line)
        elif msg_type == "shutdown_request":
            handle_shutdown(msg_id)
        elif msg_type == "comm_info_request":
            handle_comm_info(msg_id)
        elif msg_type == "complete_request":
            handle_complete(msg_id, line)
        elif msg_type == "inspect_request":
            handle_inspect(msg_id, line)
        elif msg_type == "interrupt_request":
            handle_interrupt(msg_id)
        elif msg_type == "comm_open":
            handle_comm_open(line)
        elif msg_type == "comm_msg":
            handle_comm_msg(line)

fn print_usage():
    print "Simple Jupyter Kernel"
    print ""
    print "Usage: simple jupyter-kernel [options]"
    print ""
    print "Runs the Simple JSON-lines Jupyter kernel over stdin/stdout."
    print ""
    print "Options:"
    print "  -h, --help            Show this help"
    print ""
    print "Shared log options:"
    for line in log_options_help():
        print "  {line}"

fn jupyter_kernel_is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--surface=") or arg.starts_with("--progress=")

fn jupyter_kernel_clean_args(args: [text]) -> [text]:
    var cleaned: [text] = []
    var i = 0
    while i < args.len():
        val arg = args[i]
        if jupyter_kernel_is_log_option(arg):
            if arg == "--log-mode" or arg == "--surface" or arg == "--progress":
                i = i + 1
        else:
            cleaned.push(arg)
        i = i + 1
    cleaned

fn jupyter_kernel_get_args() -> [text]:
    val all_args = get_args()
    var args: [text] = []
    var found = false
    var i = 0
    while i < all_args.len():
        if found:
            args.push(all_args[i])
        elif all_args[i] == "jupyter-kernel" or all_args[i] == "jupyter_kernel":
            found = true
        i = i + 1
    if found:
        return args

    var start_idx = 0
    i = 0
    while i < all_args.len():
        if all_args[i].ends_with("/app/jupyter_kernel/main.spl") or all_args[i] == "src/app/jupyter_kernel/main.spl":
            start_idx = i + 1
        i = i + 1
    i = start_idx
    while i < all_args.len():
        args.push(all_args[i])
        i = i + 1
    args

fn main() -> i64:
    val raw_args = jupyter_kernel_get_args()
    val log_opts = parse_log_options(raw_args)
    if not log_opts.valid:
        error("jupyter-kernel", log_opts.error)
        return 1

    val args = jupyter_kernel_clean_args(raw_args)
    if args.len() == 0:
        if log_opts.log_mode == "json":
            print "{\"command\":\"jupyter-kernel\",\"status\":\"ready\"}"
            return 0
    elif args[0] == "--help" or args[0] == "-h":
        val progress = render_progress(log_opts.progress, 0, 1, "usage")
        if progress != "":
            print progress
        print_usage()
        return 0
    elif args[0].starts_with("-"):
        if log_opts.log_mode == "json":
            print "{\"command\":\"jupyter-kernel\",\"status\":\"error\",\"error\":\"unknown option\"}"
            return 1
        print "Error: Unknown option: {args[0]}"
        print_usage()
        return 1

    kernel_main()
    0
