# Fail-closed projection for check worker process results.

fn check_worker_failure_diagnostic(
    worker_bin: text,
    code: i32,
    stdout: text,
    stderr: text
) -> text:
    if code == 0 or stdout.trim() != "" or stderr.trim() != "":
        return ""
    "ERROR: check worker '{worker_bin}' failed with exit status {code} without diagnostics"

fn check_worker_public_exit_code(code: i32) -> i64:
    # Runtime execution failures use negative sentinels. Returning one from
    # main wraps to shell status 255 and loses the distinction from a program
    # that intentionally returned 255. Publish an ordinary failure instead.
    if code < 0: 1 else: code as i64
