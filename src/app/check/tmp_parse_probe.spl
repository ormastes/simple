use compiler.core.parser.{parse_module, parser_has_errors, parser_get_errors}
extern fn rt_stderr_write(s: text)
fn probe(m: text):
    unsafe(capabilities: [ffi]):
        rt_stderr_write("PROBE " + m + "\n")

fn main() -> i64:
    probe("start")
    val src = "fn f() -> i64:\n    42\n"
    val m = parse_module(src)
    probe("parsed")
    val bad = parser_has_errors(m)
    probe("haserr={bad}")
    0

main()
