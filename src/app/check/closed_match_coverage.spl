# closed_match_coverage -- driver for scripts/check/check-closed-match-coverage.shs
#
# For each .spl given (or each entry of `--list <file>`), runs the REAL
# pipeline -- parse_full_frontend -> HirLowering.lower_module ->
# enum_contract_check_module -- at the `critical` assurance profile and prints
# one machine-readable line per fact:
#
#   MODULE <name> <path>
#   ENUM <name> contract=<closed|evolving|none>
#   MATCH <enum> <fn> line=<n> exhaustive=<0|1> wildcard=<0|1> contracted=<0|1>
#   DIAG <code> <enum> <detail>
#   PARSE-FAIL <path>
#   SUMMARY modules=<n> matches=<n> contracted=<n> non_exhaustive=<n> wildcard_closed_critical=<n>
#
# `non_exhaustive` counts contracted matches whose static coverage is
# incomplete under critical (wildcard does not count); `wildcard_closed_critical`
# counts E-CLOSED-001 diagnostics (a wildcard over a @closed enum hiding
# uncovered variants). The script reads only these lines.
#
# Accumulators are module-level for the same reason any_escape_census.spl's
# are: a returned aggregate is mis-typed by the seed at the call site
# (doc/08_tracking/bug/seed_helper_return_type_mistyped_as_tuple_2026-08-21.md).

use compiler.frontend.{parse_full_frontend}
use compiler.common.config.{Logger}
use compiler.hir.hir_lowering.*
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurfacesByName}
use compiler.hir.hir_types.{HirModule}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.semantics.enum_contract.{
    EnumContractKind, EnumContract, enum_contract_table, enum_contract_check_module
}
use std.nogc_sync_mut.cli.{get_cli_args}

var N_MODULES: i64 = 0
var N_MATCHES: i64 = 0
var N_CONTRACTED: i64 = 0
var N_NON_EXHAUSTIVE: i64 = 0
var N_WILDCARD_CLOSED: i64 = 0

fn module_name_of(path: text) -> text:
    val parts: [text] = path.split("/")
    val base: text = parts[parts.len() - 1]
    val stem: [text] = base.split(".")
    if stem.len() == 0:
        return base
    stem[0]

fn flag(b: bool) -> text:
    if b: "1" else: "0"

fn contract_name(kind: EnumContractKind) -> text:
    match kind:
        case EnumContractKind.Closed: "closed"
        case EnumContractKind.Evolving(bits, unknown): "evolving"

fn check_one(path: text) -> i64:
    val content = rt_file_read_text(path) ?? ""
    if content == "":
        print "PARSE-FAIL {path}"
        return 0
    val mod_name = module_name_of(path)
    val pm = parse_full_frontend(content, path, mod_name, Logger(level: 0))
    val surfaces = ModuleSurfacesByName.empty()
    var lowering = hirlowering_for_module("", surfaces)
    val hm: HirModule = lowering.lower_module(pm)
    print "MODULE {mod_name} {path}"
    N_MODULES = N_MODULES + 1

    val profile = AssuranceStrictness.Critical
    val table = enum_contract_table(hm)
    val fallback = EnumContract(enum_name: "", kind: EnumContractKind.Closed)
    for e in hm.enums.values():
        var c = "none"
        if table.has(e.name):
            val contract: EnumContract = table.lookup_or(e.name, fallback)
            c = contract_name(contract.kind)
        print "ENUM {e.name} contract={c}"

    val report = enum_contract_check_module(hm, profile)
    for site in report.sites:
        val cov = site.coverage
        val contracted = table.has(cov.enum_name)
        val exhaustive = cov.is_exhaustive_for(profile, contracted)
        print "MATCH {cov.enum_name} {site.function_name} line={site.line} exhaustive={flag(exhaustive)} wildcard={flag(cov.has_wildcard)} contracted={flag(contracted)}"
        N_MATCHES = N_MATCHES + 1
        if contracted:
            N_CONTRACTED = N_CONTRACTED + 1
            if not exhaustive:
                N_NON_EXHAUSTIVE = N_NON_EXHAUSTIVE + 1
    for d in report.diags:
        print "DIAG {d.code} {d.enum_name} {d.detail}"
        if d.code == "E-CLOSED-001":
            N_WILDCARD_CLOSED = N_WILDCARD_CLOSED + 1
    0

fn main() -> i64:
    val args = get_cli_args()
    var i = 0
    while i < args.len():
        val a = args[i]
        if a == "--list":
            if i + 1 < args.len():
                val listing = rt_file_read_text(args[i + 1]) ?? ""
                for line in listing.split("\n"):
                    val entry = line.trim()
                    if entry != "":
                        val _ = check_one(entry)
                i = i + 1
        elif a.ends_with(".spl"):
            val _ = check_one(a)
        i = i + 1
    print "SUMMARY modules={N_MODULES} matches={N_MATCHES} contracted={N_CONTRACTED} non_exhaustive={N_NON_EXHAUSTIVE} wildcard_closed_critical={N_WILDCARD_CLOSED}"
    0
