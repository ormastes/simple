"""Standalone Office executable entry.

The binary is built once by a self-host compiler. Running it never invokes a
compiler, source interpreter, bootstrap seed, or the unified Simple CLI.
"""

use std.sffi.cli.{cli_get_args}
use app.office.calc_cli.{run_calc_cli}
use app.office.mod.{run_office}

fn _user_args() -> [text]:
    val raw = cli_get_args()
    var start = 1
    if raw.len() > start and raw[start] == "run":
        start = start + 1
    if raw.len() > start and raw[start].ends_with(".spl"):
        start = start + 1
    if raw.len() > start and raw[start] == "--":
        start = start + 1
    if raw.len() > start and raw[start] == "office":
        start = start + 1
    var out: [text] = []
    var index = start
    while index < raw.len():
        out.push(raw[index])
        index = index + 1
    out

fn _usage():
    print "Usage: office <launcher|word|writer|sheets|calc|slides|mail|planner|counter> [OPTIONS]"
    print "       office calc [FILE] (--tui [--ui-access-port N]|--gui [--ui-access-port N]|--frame-once)"

fn _is_office_suite_cmd(cmd: text) -> bool:
    cmd == "launcher" or cmd == "word" or cmd == "writer" or cmd == "sheets" or cmd == "slides" or cmd == "mail" or cmd == "planner" or cmd == "counter"

fn main() -> i64:
    val args = _user_args()
    if args.len() == 0 or args[0] == "--help" or args[0] == "-h":
        _usage()
        return 0
    if args[0] == "calc":
        var calc_args: [text] = []
        var index = 1
        while index < args.len():
            calc_args.push(args[index])
            index = index + 1
        return run_calc_cli(calc_args).to_i64()
    if _is_office_suite_cmd(args[0]):
        return run_office(args).to_i64()
    print "Error: unknown Office command '{args[0]}'"
    _usage()
    return 1
