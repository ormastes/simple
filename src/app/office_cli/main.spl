"""Standalone Office executable entry.

The binary is built once by a self-host compiler. Running it never invokes a
compiler, source interpreter, bootstrap seed, or the unified Simple CLI.
"""

use std.sffi.cli.{cli_get_args}
use app.office.calc_cli.{run_calc_cli}

fn _user_args() -> [text]:
    val raw = cli_get_args()
    var start = 1
    if raw.len() > 1 and raw[1] == "office":
        start = 2
    var out: [text] = []
    var index = start
    while index < raw.len():
        out.push(raw[index])
        index = index + 1
    out

fn _usage():
    print "Usage: office calc [FILE] (--tui [--ui-access-port N]|--frame-once)"

fn main() -> i64:
    val args = _user_args()
    if args.len() == 0 or args[0] == "--help" or args[0] == "-h":
        _usage()
        return 0
    if args[0] != "calc":
        print "Error: unknown Office command '{args[0]}'"
        _usage()
        return 1
    var calc_args: [text] = []
    var index = 1
    while index < args.len():
        calc_args.push(args[index])
        index = index + 1
    run_calc_cli(calc_args).to_i64()
