# app.tracking_doc.stable_write — idempotent writes for generated tracking docs.
#
# bug-gen / todo-gen / task-gen / feature-gen stamp `**Generated:** <today>`
# into every markdown they emit. Rewriting unconditionally made a clean-tree
# regeneration non-idempotent: on any day other than the last regen the
# pre-commit `require_generated_tracking_staged` step saw dozens of changed
# files whose only difference was the date, and refused the commit. A doc is
# now rewritten only when something other than the Generated stamp changed.

use app.io.mod.{file_exists, file_read, file_write}

val GENERATED_PREFIX: text = "**Generated:**"

fn strip_generated_stamp(content: text) -> text:
    """Content with every `**Generated:** ...` line removed (CRLF tolerant)."""
    var kept: [text] = []
    for line in content.split("\n"):
        val bare = line.replace("\r", "")
        if not bare.trim().starts_with(GENERATED_PREFIX):
            kept.push(bare)
    kept.join("\n")

fn write_generated_doc(path: text, content: text) -> bool:
    """Write `content` unless `path` already differs only in its Generated
    stamp. Returns true when the file was (re)written."""
    if file_exists(path):
        val old = file_read(path)
        if strip_generated_stamp(old) == strip_generated_stamp(content):
            return false
    file_write(path, content)
    true

export strip_generated_stamp, write_generated_doc
