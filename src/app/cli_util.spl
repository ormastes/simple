# CLI Utilities - Shared helpers for CLI argument processing
# Used by all app/*/main.spl command implementations

use app.io.mod (cli_get_args, cwd, file_exists, file_read, exit)
use std.log.{error}

export get_cli_args, find_manifest_path, parse_csv_fields
export load_manifest_or_exit, parse_dependency_entry
export args_after_named_command
export arg_is_entry_script, strip_entry_script

fn arg_is_entry_script(arg: text, entry_rel: text) -> bool:
    """
    True only when `arg` names the caller's OWN entry script.

    `entry_rel` is the repo-relative entry path without the `src/` prefix,
    e.g. "app/check_dbs/main.spl". Accepted forms are the bare path, the
    `src/`-prefixed path, and any absolute path ending in that exact path
    component chain.

    A bare filename-suffix test on `main.spl` is NOT equivalent: under a compiled
    application a legitimate user argument such as "build/h_main.spl" or
    "other/main.spl" matches the suffix and is silently swallowed, misrouting
    the command. Matching the full entry path cannot do that.
    """
    if arg == entry_rel:
        return true
    if arg == "src/" + entry_rel:
        return true
    if arg.ends_with("/" + entry_rel):
        return true
    false

fn strip_entry_script(raw: [text], entry_rel: text) -> [text]:
    """
    Drop the program name and, when present, the caller's own entry script.

    Pure over `raw` so the routing decision is testable without a process.

    Example:
        strip_entry_script(["simple", "src/app/add/main.spl", "--help"],
            "app/add/main.spl")
        Returns: ["--help"]

        strip_entry_script(["add", "build/h_main.spl"], "app/add/main.spl")
        Returns: ["build/h_main.spl"]     # NOT swallowed
    """
    var start_idx = 1
    if raw.len() > 1 and arg_is_entry_script(raw[1], entry_rel):
        start_idx = 2

    var args: [text] = []
    var i = start_idx
    while i < raw.len():
        args = args.push(raw[i])
        i = i + 1
    args

fn get_cli_args(entry_rel: text) -> [text]:
    """
    Extract command-line arguments, skipping program name and entry script.

    Each caller names its own entry script (`entry_rel`, e.g.
    "app/check_dbs/main.spl") so that interpreted and compiled invocations
    agree and no user argument is mistaken for the entry script.

    Example:
        Raw args: ["simple_runtime", "src/app/add/main.spl", "--help", "package"]
        get_cli_args("app/add/main.spl") -> ["--help", "package"]
    """
    strip_entry_script(cli_get_args(), entry_rel)

fn find_manifest_path() -> text:
    """
    Find the package manifest file (simple.sdn or simple.toml) in current directory.

    Searches for manifest files in order of preference:
    1. simple.sdn (preferred SDN format)
    2. simple.toml (legacy TOML format)

    Returns:
        Path to manifest file, or empty string if not found

    Used by: install, update, list, tree, lock commands
    """
    val cwd_path = cwd()
    val sdn_path = "{cwd_path}/simple.sdn"
    if file_exists(sdn_path):
        return sdn_path
    val toml_path = "{cwd_path}/simple.toml"
    if file_exists(toml_path):
        return toml_path
    ""

fn parse_csv_fields(line: text) -> [text]:
    """
    Parse CSV-like fields with quote and escape handling.

    Supports:
    - Comma-separated values
    - Quoted strings (preserves spaces, commas inside quotes)
    - Escape sequences (backslash escaping)

    Example:
        parse_csv_fields('id, "Hello, World", value')
        Returns: ["id", "Hello, World", "value"]

    Used by: feature_gen, task_gen, todo_gen, spec_coverage
    """
    # NOTE: text.len() is a BYTE count while text[i] indexes by CHARACTER, so a
    # multi-byte character (e.g. an em-dash) makes a byte-length loop bound run
    # past the last character index. Decode to a character array up front and
    # stay character-based throughout.
    val chars = line.chars()
    val char_count = chars.len()
    var fields: [text] = []
    var i = 0
    var current = ""
    var in_quote = false

    while i < char_count:
        val ch = chars[i]
        if in_quote:
            if ch == "\\" and i + 1 < char_count:
                current = current + chars[i + 1]
                i = i + 2
                continue
            if ch == "\"":
                in_quote = false
                i = i + 1
                continue
            current = current + ch
        else:
            if ch == "\"":
                in_quote = true
                i = i + 1
                continue
            if ch == ",":
                fields.push(current.trim())
                current = ""
                i = i + 1
                continue
            current = current + ch
        i = i + 1

    fields.push(current.trim())
    fields

fn load_manifest_or_exit() -> text:
    """
    Load manifest file content, or print error and exit if not found.

    Convenience wrapper that combines manifest finding, error checking,
    and file reading into a single call.

    Returns:
        Manifest file content

    Used by: list, tree, update commands
    """
    val manifest_path = find_manifest_path()
    if manifest_path == "":
        error("cli_util", "no simple.sdn or simple.toml found in current directory")
        exit(1)
    file_read(manifest_path)

fn parse_dependency_entry(trimmed: text, deps: [(text, text)]) -> [(text, text)]:
    """
    Parse a single dependency entry line and add to deps list.

    Handles lines in format: "package_name: version"
    Validates package name (no spaces) before adding.

    Example:
        parse_dependency_entry("http: 2.0", [])
        Returns: [("http", "2.0")]

    Used by: list, tree, update dependency parsing
    """
    if trimmed.contains(":"):
        val parts = trimmed.split(":")
        if parts.len() >= 2:
            val name = parts[0].trim()
            val version = parts[1].trim()
            if name != "" and not name.contains(" "):
                return deps.push((name, version))
    deps

fn args_after_named_command(raw: [text], entry_suffix: text, command_name: text) -> [text]:
    """
    Slice the raw process arguments down to whatever follows the entry
    script or the dispatched command name.

    Scans `raw` for the first element that either ends with `entry_suffix`
    (the entry script's own filename, e.g. "vscode_entry.spl") or exactly
    matches `command_name` (the dispatched subcommand name, e.g. "vscode"),
    and returns everything after it. Used by thin `simple <tool>` entry
    points (vscode, electron, security, ...) that each re-derive their own
    argument slice from the same raw arg vector.

    Example:
        args_after_named_command(["simple", "vscode_entry.spl", "build", "x.spl"],
            "vscode_entry.spl", "vscode")
        Returns: ["build", "x.spl"]
    """
    var args: [text] = []
    var start = 1
    var i = 0
    while i < raw.len():
        if raw[i].ends_with(entry_suffix) or raw[i] == command_name:
            start = i + 1
            break
        i = i + 1
    i = start
    while i < raw.len():
        args.push(raw[i])
        i = i + 1
    args
