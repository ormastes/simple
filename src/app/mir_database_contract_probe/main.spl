use std.database.core.{parse_sdn_table, SdnTable, SdnRow}

fn main() -> i64:
    match parse_sdn_table("probe | key , value |\nalpha, 17\n"):
        case Some(table):
            val typed_table: SdnTable = table
            val columns: [text] = typed_table.columns
            if columns.len() != 2:
                return 51
            if columns[0] != "key" or columns[1] != "value":
                return 52
            val rows: [SdnRow] = typed_table.rows
            var count: i64 = 0
            for untyped_row in rows:
                val row: SdnRow = untyped_row
                if (row.get("key") ?? "") != "alpha":
                    return 53
                if (row.get("value") ?? "") != "17":
                    return 54
                count = count + 1
            if count != 1:
                return 55
        case nil:
            return 56
    0
