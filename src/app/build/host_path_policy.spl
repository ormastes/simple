# Shared host absolute path and containment policy for src/app/build modules.
# Accepts normalized POSIX `/...` paths anywhere, and Windows `<drive>:/...` or
# `<drive>:\...` host paths when running on a Windows host, while preserving
# strict segment character, traversal, NUL, and newline rejection.

use std.nogc_sync_mut.fs.host_path.{host_is_windows_host}

fn _host_is_ascii_alpha(ch: text) -> bool:
    (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z")

fn _host_is_strict_ident_char(ch: text) -> bool:
    (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
        (ch >= "0" and ch <= "9") or ch == "_" or ch == "-" or ch == "."

fn _host_segments_valid_v1(
    norm: text,
    strict_segments: bool,
    reject_spaces: bool,
    max_seg_len: i64
) -> bool:
    val parts = norm.split("/")
    var i: i64 = 1
    while i < parts.len():
        val seg = parts[i]
        if seg == "" or seg == "." or seg == ".." or seg.byte_len() > max_seg_len:
            return false
        if reject_spaces and seg.contains(" "):
            return false
        if strict_segments:
            if seg.starts_with("-"):
                return false
            for ch in seg.chars():
                if not _host_is_strict_ident_char(ch):
                    return false
        i = i + 1
    true

@allow(primitive_api)  # host drive-prefix predicate
pub fn build_host_has_drive_prefix_v1(path: text) -> bool:
    if not host_is_windows_host():
        return false
    if path.byte_len() < 3:
        return false
    val first = path.substring(0, 1)
    val colon = path.substring(1, 2)
    val sep = path.substring(2, 3)
    _host_is_ascii_alpha(first) and colon == ":" and (sep == "/" or sep == "\\")

pub fn build_host_path_normalize_v1(path: text) -> text:
    if build_host_has_drive_prefix_v1(path):
        return path.replace("\\", "/")
    path

@allow(primitive_api)  # host absolute-path validation boundary with explicit bounds
pub fn build_host_abs_path_valid_v1(
    path: text,
    strict_segments: bool,
    reject_spaces: bool = false,
    max_len: i64 = 4096,
    max_seg_len: i64 = 255
) -> bool:
    if path == "" or path.contains("\n") or path.contains("\r") or
            path.contains("\x00") or path.contains("|"):
        return false
    val has_drive = build_host_has_drive_prefix_v1(path)
    if not has_drive:
        if not path.starts_with("/") or path.contains("\\") or path.contains(":"):
            return false
    val norm = if has_drive: path.replace("\\", "/") else: path
    if norm.byte_len() > max_len:
        return false
    if has_drive:
        if norm.byte_len() < 4 or norm.substring(2).contains(":"):
            return false
    elif norm.byte_len() < 2:
        return false
    if norm.ends_with("/") or norm.contains("//"):
        return false
    _host_segments_valid_v1(norm, strict_segments, reject_spaces, max_seg_len)

@allow(primitive_api)  # strict POSIX absolute-path validation boundary
pub fn build_posix_abs_path_valid_v1(
    path: text,
    strict_segments: bool = true,
    max_len: i64 = 4096,
    max_seg_len: i64 = 128
) -> bool:
    if not path.starts_with("/") or path.byte_len() < 2 or path.byte_len() > max_len:
        return false
    if path.ends_with("/") or path.contains("//") or path.contains("\\") or
            path.contains(":") or path.contains("|") or
            path.contains("\n") or path.contains("\r") or path.contains("\x00"):
        return false
    _host_segments_valid_v1(path, strict_segments, true, max_seg_len)

@allow(primitive_api)  # path containment predicate
pub fn build_host_path_is_descendant_v1(path: text, root: text) -> bool:
    val norm_path = build_host_path_normalize_v1(path)
    val norm_root = build_host_path_normalize_v1(root)
    norm_path.starts_with(norm_root + "/")

@allow(primitive_api)  # path overlap predicate
pub fn build_host_paths_overlap_v1(left: text, right: text) -> bool:
    val norm_left = build_host_path_normalize_v1(left)
    val norm_right = build_host_path_normalize_v1(right)
    norm_left == norm_right or
        norm_left.starts_with(norm_right + "/") or
        norm_right.starts_with(norm_left + "/")

pub fn build_host_path_parent_v1(path: text) -> text:
    val norm = build_host_path_normalize_v1(path)
    val slash = norm.last_index_of("/")
    if slash < 0:
        return "."
    if slash == 0:
        return "/"
    if build_host_has_drive_prefix_v1(norm) and slash <= 2:
        return norm.substring(0, 3)
    norm.substring(0, slash)

export build_host_has_drive_prefix_v1, build_host_path_normalize_v1
export build_host_abs_path_valid_v1, build_posix_abs_path_valid_v1
export build_host_path_is_descendant_v1, build_host_paths_overlap_v1
export build_host_path_parent_v1
