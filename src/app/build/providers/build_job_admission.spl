# App-owned seam between one fenced build attempt, Simple Orchestrator Job,
# and an observed Simple Container provider. Control metadata is portable;
# this V1 worker capability proves only a Linux OCI execution environment.
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1}
use app.build.scheduler.worker_capability.{BuildWorkerCapabilityV1,
    encode_build_worker_capability_v1}
use app.build.scheduler.worker_execution_profile.{
    build_worker_execution_profile_problem_v1}
use std.common.crypto.sha256.{sha256_text}
use std.common.contracts.orchestration.ci_v1.{JobV1}

struct BuildJobAdmissionV1:
    ready: bool
    reason: text
    controller_os: text
    execution_os: text
    provider_id: text

fn _build_job_reject_v1(reason: text, controller_os: text) -> BuildJobAdmissionV1:
    BuildJobAdmissionV1(false, reason, controller_os, "", "")

fn _build_job_command_matches_v1(actual: [text], expected: [text]) -> bool:
    if actual.len() != expected.len() or actual.len() == 0: return false
    var i: i64 = 0
    while i < actual.len():
        if actual[i] != expected[i]: return false
        i = i + 1
    true

fn admit_build_job_v1(request: BuildWorkerRequestV1,
        capability: BuildWorkerCapabilityV1, job: JobV1,
        controller_os: text) -> BuildJobAdmissionV1:
    """Admit exact Job metadata for a trusted, nonce-bound Linux worker report.

    The caller must authenticate the capability over pinned SSH. The worker
    rechecks its installed config and live provider at execution time.
    """
    val request_wire = encode_build_worker_request_v1(request)
    if not ["linux", "macos", "windows", "freebsd", "openbsd", "netbsd",
            "simpleos"].contains(
            controller_os) or request_wire == "" or
       encode_build_worker_capability_v1(capability) == "":
        return _build_job_reject_v1("identity-invalid", controller_os)
    if request.attempt.worker_id != capability.worker_id or
       job.meta.name != request.attempt.attempt_id or
       job.backoff_limit != 0:
        return _build_job_reject_v1("attempt-or-retry-mismatch", controller_os)
    if not job.meta.labels.contains_key("simple-build-request-digest") or
       job.meta.labels["simple-build-request-digest"] !=
           sha256_text(request_wire):
        return _build_job_reject_v1("request-digest-mismatch", controller_os)
    val pod = job.template
    if pod.os_name != capability.execution_os:
        return _build_job_reject_v1("execution-os-mismatch", controller_os)
    if pod.runtime_class != "native-container" or
       pod.network_profile != "endpoint-v1":
        return _build_job_reject_v1("runtime-class-unsupported", controller_os)
    if capability.execution_os != "linux" or
       capability.provider_id != "linux-oci-v1":
        return _build_job_reject_v1("provider-unsupported", controller_os)
    if pod.containers.len() != 1:
        return _build_job_reject_v1("container-count-invalid", controller_os)
    val container = pod.containers[0]
    if container.image != capability.image or
       container.artifact_set_ref != "" or container.args.len() != 0 or
       container.ports.len() != 0 or
       not _build_job_command_matches_v1(container.command,
           request.action.argv):
        return _build_job_reject_v1("container-identity-mismatch", controller_os)
    val action_tool = request.action.toolchain
    val worker_tool = capability.toolchain
    if action_tool.version != worker_tool.version or
       action_tool.executable_digest != worker_tool.executable_digest or
       action_tool.behavior_digest != worker_tool.behavior_digest or
       action_tool.provider_abi_digest != worker_tool.provider_abi_digest or
       action_tool.runtime_digest != worker_tool.runtime_digest or
       action_tool.sysroot_digest != worker_tool.sysroot_digest or
       action_tool.target_triple != worker_tool.target_triple or
       request.action.sandbox_digest != capability.sandbox_digest or
       request.action.resource_policy_digest !=
           capability.resource_policy_digest:
        return _build_job_reject_v1("toolchain-or-policy-mismatch", controller_os)
    val profile_problem = build_worker_execution_profile_problem_v1(
        request.action, capability.compiler_entry)
    if profile_problem != "":
        return _build_job_reject_v1(profile_problem, controller_os)
    val resources = container.resources
    val exact_cpu = request.cpu_tokens * 1000
    val exact_memory = request.attempt.memory_budget_bytes
    if request.cpu_tokens > capability.cpu_limit or
       exact_memory > capability.memory_limit or
       resources.cpu_request_millis != exact_cpu or
       resources.cpu_limit_millis != exact_cpu or
       resources.memory_request_bytes != exact_memory or
       resources.memory_limit_bytes != exact_memory:
        return _build_job_reject_v1("resource-mismatch", controller_os)
    BuildJobAdmissionV1(true, "", controller_os,
        capability.execution_os, capability.provider_id)

export BuildJobAdmissionV1, admit_build_job_v1
