# Build CLI Entry Point
# Handles the 'build' subcommand from the main CLI dispatcher.
# Dispatches to the native compilation pipeline or quality sub-tools
# based on the first positional argument:
#   (no arg / flags only) → native-build pipeline
#   bootstrap             → native-build pipeline (3-stage self-compilation)
#   lint                  → linter
#   fmt                   → formatter
#   check                 → parser/type-check pass
#   simpleos [arch...]    → build per-arch SimpleOS Simple toolchain (opt-in)

use app.io.cli_compile.{cli_native_build}
use app.io.cli_commands.{cli_run_lint, cli_run_fmt}
use app.cli.check.{run_check}
use app.clean.main.{auto_clean_on_build_start}
use app.io.mod.{process_run, env_get, env_set, dir_create_all, file_exists, file_write, file_append, file_hash_sha256, time_now_unix_micros, ExecutionResourceClass, execution_resource_scope, begin_current_execution_resource_scope, end_current_execution_resource_scope}
use std.nogc_sync_mut.io.crypto_sffi.{hash_sha256}
use std.io_runtime.{getpid}
use std.common.perf.execution_metrics.{ResourceUsage, ResourceEvidenceQuality, evaluate_resource_budget, resource_evidence_quality_name, termination_cause_name, decision_status_name}
use app.build.bootstrap_receipt_planner.{plan_bootstrap_authorization}
use app.build.targets.targets_cli.{
    target_arg, build_explain_requested, run_target_explain,
    run_target_execution
}

fn build_simpleos_targets(arches: [text]) -> i64:
    """`bin/simple build simpleos [arch...]` — build the per-arch SimpleOS Simple
    toolchain (x86_64/aarch64/riscv64-unknown-simpleos) via the CI builder, which
    native-builds each target, verifies it with a fail-closed readelf gate, and
    installs it to bin/release/<arch>-unknown-simpleos/simple. Opt-in on purpose:
    a plain `bin/simple build` stays host-only and fast. Optional args filter the
    arch set (passed through to the builder)."""
    var run_args: [text] = ["scripts/ci/build-simpleos-toolchain.shs"]
    var i = 0
    while i < arches.len():
        run_args.push(arches[i])
        i = i + 1
    var out = ""
    var err = ""
    var rc: i64 = 0
    # ponytail: capture+print (not streamed); a multi-minute build shows output
    # only at the end. Switch to an inherit-stdio exec if progress UX matters.
    (out, err, rc) = process_run("sh", run_args)
    if out.len() > 0:
        print(out)
    if err.len() > 0:
        print(err)
    return rc

fn _build_arg_value(args: [text], name: text) -> text:
    var i = 0
    while i + 1 < args.len():
        if args[i] == name:
            return args[i + 1]
        i = i + 1
    ""

fn _build_args_identity(args: [text]) -> text:
    var parts: [text] = []
    for arg in args:
        parts.push("{arg.len()}:{arg}")
    # Keep semantic arguments ordered, then append every environment dimension
    # that can make two otherwise identical builds statistically incompatible.
    # Missing dimensions remain explicit instead of disappearing from identity.
    val dimensions = [
        "scenario=native-build",
        "machine=" + _build_machine_environment_id(),
        "target=" + _build_metric_env("SIMPLE_TARGET"),
        "optimization=" + _build_metric_env("SIMPLE_OPT_LEVEL"),
        "cache=" + _build_metric_env("SIMPLE_CACHE_STATE"),
        "bootstrap=" + _build_metric_env("SIMPLE_BOOTSTRAP_STAGE"),
        "concurrency=" + _build_metric_env("SIMPLE_BUILD_CONCURRENCY"),
        "aspects=" + _build_metric_env("SIMPLE_ASPECT_PLAN_DIGEST"),
        "compiler=" + _build_metric_env("SIMPLE_COMPILER_DIGEST"),
        "runtime=" + _build_metric_env("SIMPLE_RUNTIME_DIGEST"),
        "schema=execution-metrics-2"
    ]
    for dimension in dimensions:
        parts.push("{dimension.len()}:{dimension}")
    parts.join("|")

fn _build_metric_env(name: text) -> text:
    val value = env_get(name)
    if value == "": "unavailable" else: value

fn _build_machine_environment_id() -> text:
    val declared = env_get("SIMPLE_MACHINE_CLASS")
    if declared != "":
        return "declared=" + declared
    val host = if env_get("HOSTNAME") != "": env_get("HOSTNAME") else: _build_metric_env("COMPUTERNAME")
    val os_name = if env_get("RUNNER_OS") != "": env_get("RUNNER_OS") else: _build_metric_env("OS")
    val arch = if env_get("RUNNER_ARCH") != "": env_get("RUNNER_ARCH") elif env_get("HOSTTYPE") != "": env_get("HOSTTYPE") else: _build_metric_env("PROCESSOR_ARCHITECTURE")
    "fallback-host={host};os={os_name};arch={arch}"

fn _build_sdn_text(value: text) -> text:
    "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n") + "\""

fn _build_metrics_begin(args: [text]) -> (text, text, text, text, i64):
    val started = time_now_unix_micros()
    val run_id = "build-{getpid()}-{started}"
    val root = "build/perf"
    val spans_path = root + "/spans/" + run_id + ".sdn"
    if not dir_create_all(root + "/spans"):
        return (run_id, "", env_get("SIMPLE_EXECUTION_METRICS_FILE"), env_get("SIMPLE_EVIDENCE_RUN_ID"), started)
    val subjects_path = root + "/build_subjects.sdn"
    if not file_exists(subjects_path):
        val _ = file_write(subjects_path, "# version: execution-metrics-2\nsubjects |subject_id, subject_kind, policy_id, required_phase_set_id|\n    broad-native-build, build, declared-default, compiler-required-v1\n")
    val runs_path = root + "/build_runs.sdn"
    if not file_exists(runs_path):
        val _ = file_write(runs_path, "# version: execution-metrics-2\nruns |run_id, subject_id, cohort_id, started_micros, ended_micros, status, wall_ms, user_cpu_ms, system_cpu_ms, peak_tree_charge_bytes, pids_peak, evidence_quality, termination, budget_status, budget_reason, spans_digest, artifact_path, artifact_digest|\n")
    val previous_metrics = env_get("SIMPLE_EXECUTION_METRICS_FILE")
    val previous_run_id = env_get("SIMPLE_EVIDENCE_RUN_ID")
    if not env_set("SIMPLE_EXECUTION_METRICS_FILE", spans_path) or not env_set("SIMPLE_EVIDENCE_RUN_ID", run_id):
        return (run_id, "", previous_metrics, previous_run_id, started)
    (run_id, spans_path, previous_metrics, previous_run_id, started)

fn _build_metrics_finish(args: [text], run_id: text, spans_path: text, previous_metrics: text, previous_run_id: text, started: i64, status: i64, usage: ResourceUsage, budget_status: text, budget_reason: text):
    val ended = time_now_unix_micros()
    val _restore_metrics = env_set("SIMPLE_EXECUTION_METRICS_FILE", previous_metrics)
    val _restore_run = env_set("SIMPLE_EVIDENCE_RUN_ID", previous_run_id)
    if spans_path == "":
        return
    val output_path = _build_arg_value(args, "--output")
    val spans_digest = if file_exists(spans_path): file_hash_sha256(spans_path) else: "unavailable"
    val artifact_digest = if output_path != "" and file_exists(output_path): file_hash_sha256(output_path) else: "unavailable"
    val cohort_id = hash_sha256(_build_args_identity(args))
    val status_name = if status == 0: "complete" else: "failure"
    val line = "    {run_id}, broad-native-build, {cohort_id}, {started}, {ended}, {status_name}, {usage.wall_ms}, {usage.user_cpu_ms}, {usage.system_cpu_ms}, {usage.peak_tree_charge_bytes}, {usage.pids_peak}, {resource_evidence_quality_name(usage.evidence_quality)}, {termination_cause_name(usage.termination)}, {budget_status}, {_build_sdn_text(budget_reason)}, {spans_digest}, {_build_sdn_text(output_path)}, {artifact_digest}\n"
    val _ = file_append("build/perf/build_runs.sdn", line)

fn handle_build(args: [text]) -> i64:
    """Dispatch the 'build' subcommand to the appropriate pipeline."""
    val subcmd = if args.len() > 0: args[0] else: ""

    if subcmd == "lint":
        return cli_run_lint(args[1:])

    if subcmd == "fmt":
        return cli_run_fmt(args[1:])

    if subcmd == "check":
        return run_check(args[1:])

    if subcmd == "simpleos":
        return build_simpleos_targets(args[1:])

    if subcmd == "bootstrap":
        return plan_bootstrap_authorization(args[1:])

    # Named-target explain requests are read-only. Build requests execute only
    # the resolved target closure and never fall through to the broad pipeline.
    val tname = target_arg(args)
    if tname.len() > 0:
        if build_explain_requested(args):
            return run_target_explain(".", tname)
        return run_target_execution(".", tname)

    if build_explain_requested(args):
        print("build-explain-error: --target <name> required")
        return 2

    # Auto temp/cache cleanup only for an actual broad build. Planning and
    # explain commands above remain read-only.
    auto_clean_on_build_start()

    # Ordinary build invokes the native-build pipeline. Bootstrap is handled by
    # the receipt-only planner above and never falls through to native-build.
    # Prepend "native-build" so cli_native_build can identify and skip it.
    var native_args: [text] = ["native-build"]
    val pass_args = args
    var k = 0
    while k < pass_args.len():
        native_args.push(pass_args[k])
        k = k + 1
    # Propagate the pipeline's exit code explicitly. `bin/simple build bootstrap`
    # must fail (nonzero) when a stage fails; relying on implicit last-expression
    # return here previously let a failed native-build stage surface as exit 0.
    val (metrics_run_id, spans_path, previous_metrics, previous_run_id, metrics_started) = _build_metrics_begin(native_args)
    val build_scope = execution_resource_scope(ExecutionResourceClass.Bootstrap, 0, 1_048_576)
    val scope_lease = begin_current_execution_resource_scope(build_scope)
    val result = cli_native_build(native_args)
    val usage = end_current_execution_resource_scope(scope_lease, result)
    val budget = evaluate_resource_budget(usage, build_scope.budget)
    val budget_status = if usage.evidence_quality == ResourceEvidenceQuality.Unavailable: "incomplete" else: decision_status_name(budget.status)
    val budget_reason = if usage.evidence_quality == ResourceEvidenceQuality.Unavailable: "whole-build cgroup scope unavailable" else: budget.reason
    _build_metrics_finish(native_args, metrics_run_id, spans_path, previous_metrics, previous_run_id, metrics_started, result, usage, budget_status, budget_reason)
    result
