# Standalone entrypoint for the exact-parent submodule admission probe.
# Production launchers should execute a cached compiled artifact.
use app.io.mod.{get_args}
use app.build.submodule_cli.{run_submodule_verify}

fn main() -> i64:
    var args = get_args()
    if args.len() > 0 and (args[0].ends_with("submodule_verify_main.spl") or
            args[0].ends_with("simple-submodule-verify") or
            args[0].ends_with("simple-submodule-verify.exe")):
        args = args[1:]
    if args.len() > 0 and args[0] == "--":
        args = args[1:]
    run_submodule_verify(args)
