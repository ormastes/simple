# A protected CI caller supplies current observations and policy independently
# of these candidate wire bytes. Decoding does not authenticate provenance.
use app.build.gate_receipt_wire_v1.{parse_gate_receipt_wire_v1}
use app.build.signed_build_admission.{SignedBuildExpectationV2,
    SignedBuildAdmissionV1}
use app.build.signed_build_ci_observation.{SignedBuildCiObservationV1,
    verify_observed_signed_build_ci_candidate_v1}
use app.build.signed_build_signature_provider.{SignedBuildSshProviderConfigV2}
use app.build.signed_build_verifier.{SignedBuildFileDecisionV2}

fn verify_observed_signed_build_ci_wire_candidate_v1(
        observed: SignedBuildCiObservationV1,
        receipt_wire: text, signature_text: text,
        gate_wire: [u8], expected: SignedBuildExpectationV2,
        protected_manifest_text: text, protected_manifest_digest: text,
        protected_issuer: text, ssh: SignedBuildSshProviderConfigV2,
        downloaded_path: text, private_artifact_parent: text,
        artifact_limit: i64) -> SignedBuildFileDecisionV2:
    """Decode gate data and defer all admission checks to the CI controller."""
    val parsed = parse_gate_receipt_wire_v1(gate_wire)
    if parsed == nil:
        return SignedBuildFileDecisionV2(SignedBuildAdmissionV1(
            "FULL_BUILD", "ci-observation: invalid-gate-receipt-wire"),
            "", "")
    verify_observed_signed_build_ci_candidate_v1(observed, receipt_wire,
        signature_text, parsed.unwrap(), expected, protected_manifest_text,
        protected_manifest_digest, protected_issuer, ssh, downloaded_path,
        private_artifact_parent, artifact_limit)

export verify_observed_signed_build_ci_wire_candidate_v1
