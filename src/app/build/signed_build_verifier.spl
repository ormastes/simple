# Base-owned decision controller. Provider results are privileged inputs, never
# fields decoded from the untrusted receipt. This module performs no signature
# cryptography or gate execution: the trusted caller must obtain those results
# from its pinned providers for this exact digest and candidate expectation.
# Artifact bytes are an owned snapshot; downstream reuse must consume this same
# snapshot (or a caller-pinned immutable object), never reopen a mutable path.
# V1 is a compatibility library only. A future GitHub controller must use V2,
# independently derive expectations, and authenticate its providers. Neither
# entrypoint here executes a live signature provider or reports GitHub status.
use app.build.signed_build_admission.{
    SignedBuildExpectationV1, SignedBuildTrustObservationV1,
    SignedBuildAdmissionV1, signed_build_receipt_digest_v1,
    validate_signed_build_admission_v1, SignedBuildExpectationV2, SignedBuildReceiptV2,
    signed_build_receipt_digest_v2, validate_signed_build_admission_v2
}
use app.build.signed_build_wire.{parse_signed_build_receipt_wire_v1, parse_signed_build_receipt_wire_v2}
use std.common.crypto.sha256.{sha256_u8_hex}
use app.build.signed_build_stream.{
    SignedBuildArtifactStreamV2, signed_build_artifact_stream_finish_v2
}
use app.build.signed_build_artifact_snapshot.{
    snapshot_signed_build_artifact_v2}
use app.io.mod.{dir_remove_all}

# Resource ceiling for both in-memory controllers, independent of receipt data.
# Artifacts above 16 MiB cannot be reused through the byte-array APIs. The V2
# streaming entrypoint supports larger protected limits without whole-file arrays.
# FUNCTIONAL GAP: retrieval and immutable artifact handoff are still caller-owned.
# app.io.mod file_hash_sha256(path) and file_size_raw(path) independently reopen
# mutable names and return no pinned immutable handle. Matching pre/post sizes or
# hashes cannot prevent replacement after verification and before consumption.
# TODO: add a facade-owned immutable snapshot handle consumed by both the
# stream producer and downstream handoff before a live controller admits files.
val SIGNED_BUILD_VERIFIER_MAX_ARTIFACT_BYTES_V1 = 16777216

struct SignedBuildSignatureResultV1:
    status: text
    payload_digest: text
    signer_id: text
    signer_scope: text
    authorization_status: text
    revocation_status: text
    protected_policy_digest: text
    checker_digest: text

struct SignedBuildGateResultV1:
    status: text
    receipt_digest: text
    base_revision: text
    head_revision: text
    candidate_tree: text
    protected_policy_digest: text
    checker_digest: text

fn _verification_full_build_v1(reason: text) -> SignedBuildAdmissionV1:
    SignedBuildAdmissionV1("FULL_BUILD", reason)

fn verify_signed_build_bytes_v1(
    wire: text, expected: SignedBuildExpectationV1,
    signature: SignedBuildSignatureResultV1, gates: SignedBuildGateResultV1,
    artifact_bytes: [u8], artifact_limit: i64
) -> SignedBuildAdmissionV1:
    """Derive admission observations from trusted provider results and bytes.

    Only a protected caller may supply expected/signature/gates/artifact_limit.
    Missing, failed, unknown or differently bound provider results fail closed.
    This result authorizes only the supplied byte snapshot, not an artifact URL.
    """
    if artifact_limit <= 0 or
            artifact_limit > SIGNED_BUILD_VERIFIER_MAX_ARTIFACT_BYTES_V1:
        return _verification_full_build_v1("invalid-artifact-limit")
    val parsed = parse_signed_build_receipt_wire_v1(wire)
    if parsed == nil:
        return _verification_full_build_v1("invalid-receipt-wire")
    val receipt = parsed.unwrap()
    if receipt.artifact_length > artifact_limit or
            artifact_bytes.len() > artifact_limit or
            artifact_bytes.len() != receipt.artifact_length:
        return _verification_full_build_v1("artifact-size-mismatch")
    if signature.signer_id.len() > 512 or signature.signer_scope.len() > 512 or
            signature.status != "VERIFIED" or
            signature.authorization_status != "AUTHORIZED" or
            signature.revocation_status != "CLEAR" or
            signature.payload_digest != signed_build_receipt_digest_v1(receipt) or
            signature.protected_policy_digest != expected.protected_policy_digest or
            signature.checker_digest != expected.checker_digest:
        return _verification_full_build_v1("signature-provider-rejected")
    if gates.status != "VERIFIED" or
            gates.receipt_digest != expected.mandatory_gate_receipt_digest or
            gates.base_revision != expected.base_revision or
            gates.head_revision != expected.head_revision or
            gates.candidate_tree != expected.candidate_tree or
            gates.protected_policy_digest != expected.protected_policy_digest or
            gates.checker_digest != expected.checker_digest:
        return _verification_full_build_v1("gate-provider-rejected")
    val digest = sha256_u8_hex(artifact_bytes)
    val trust = SignedBuildTrustObservationV1(
        signature_valid: signature.status == "VERIFIED",
        signer_authorized: signature.authorization_status == "AUTHORIZED",
        signer_revoked: signature.revocation_status != "CLEAR",
        verified_payload_digest: signature.payload_digest,
        verified_signer_id: signature.signer_id,
        verified_signer_scope: signature.signer_scope,
        mandatory_gate_receipt_valid: gates.status == "VERIFIED",
        verified_gate_receipt_digest: gates.receipt_digest,
        artifact_retrieved: artifact_bytes.len() > 0,
        artifact_digest: digest, artifact_length: artifact_bytes.len()
    )
    validate_signed_build_admission_v1(receipt, expected, trust)

export SIGNED_BUILD_VERIFIER_MAX_ARTIFACT_BYTES_V1
export SignedBuildSignatureResultV1, SignedBuildGateResultV1
export verify_signed_build_bytes_v1

struct SignedBuildGateResultV2:
    repository_full_name: text
    pull_request_number: i64
    build: SignedBuildGateResultV1

fn verify_signed_build_bytes_v2(
    wire: text, expected: SignedBuildExpectationV2,
    signature: SignedBuildSignatureResultV1, gates: SignedBuildGateResultV2,
    artifact_bytes: [u8], artifact_limit: i64
) -> SignedBuildAdmissionV1:
    """V2 controller with independently supplied repository/PR expectations.

    Signature results must cover signed_build_receipt_digest_v2. Provider
    records remain privileged inputs; receipt metadata cannot supply them.
    """
    if artifact_limit <= 0 or
            artifact_limit > SIGNED_BUILD_VERIFIER_MAX_ARTIFACT_BYTES_V1:
        return _verification_full_build_v1("invalid-artifact-limit")
    val parsed = parse_signed_build_receipt_wire_v2(wire)
    if parsed == nil:
        return _verification_full_build_v1("invalid-receipt-wire")
    val receipt = parsed.unwrap()
    val build = receipt.build
    if build.artifact_length > artifact_limit or
            artifact_bytes.len() > artifact_limit or
            artifact_bytes.len() != build.artifact_length:
        return _verification_full_build_v1("artifact-size-mismatch")
    _verify_signed_build_observed_v2(receipt, expected, signature, gates,
        sha256_u8_hex(artifact_bytes), artifact_bytes.len())

fn verify_signed_build_stream_v2(
    wire: text, expected: SignedBuildExpectationV2,
    signature: SignedBuildSignatureResultV1, gates: SignedBuildGateResultV2,
    mut stream: SignedBuildArtifactStreamV2
) -> SignedBuildAdmissionV1:
    """Finish a protected caller-owned stream and validate exact V2 evidence.

    The caller creates and feeds the stream under its own resource policy and
    must hand the identical immutable artifact to consumers. This does not
    authenticate a mutable pathname or perform live signature verification.
    """
    val parsed = parse_signed_build_receipt_wire_v2(wire)
    if parsed == nil:
        return _verification_full_build_v1("invalid-receipt-wire")
    val receipt = parsed.unwrap()
    val artifact = signed_build_artifact_stream_finish_v2(stream,
        receipt.build.artifact_length, receipt.build.artifact_digest)
    if artifact.decision != "VERIFIED":
        return _verification_full_build_v1(artifact.reason)
    _verify_signed_build_observed_v2(receipt, expected, signature, gates,
        artifact.digest, artifact.length)

fn _verify_signed_build_observed_v2(
    receipt: SignedBuildReceiptV2, expected: SignedBuildExpectationV2,
    signature: SignedBuildSignatureResultV1, gates: SignedBuildGateResultV2,
    artifact_digest: text, artifact_length: i64
) -> SignedBuildAdmissionV1:
    # Only local byte hashing or the finished stream supplies these observations.
    val policy = expected.build
    val gate = gates.build
    if receipt.repository_full_name != expected.repository_full_name or
            receipt.pull_request_number != expected.pull_request_number:
        return _verification_full_build_v1("repository-pr-mismatch")
    if signature.signer_id.len() > 512 or signature.signer_scope.len() > 512 or
            signature.status != "VERIFIED" or
            signature.authorization_status != "AUTHORIZED" or
            signature.revocation_status != "CLEAR" or
            signature.payload_digest != signed_build_receipt_digest_v2(receipt) or
            signature.protected_policy_digest != policy.protected_policy_digest or
            signature.checker_digest != policy.checker_digest:
        return _verification_full_build_v1("signature-provider-rejected")
    if gates.repository_full_name != expected.repository_full_name or
            gates.pull_request_number != expected.pull_request_number or
            gate.status != "VERIFIED" or
            gate.receipt_digest != policy.mandatory_gate_receipt_digest or
            gate.base_revision != policy.base_revision or
            gate.head_revision != policy.head_revision or
            gate.candidate_tree != policy.candidate_tree or
            gate.protected_policy_digest != policy.protected_policy_digest or
            gate.checker_digest != policy.checker_digest:
        return _verification_full_build_v1("gate-provider-rejected")
    val trust = SignedBuildTrustObservationV1(
        signature_valid: signature.status == "VERIFIED",
        signer_authorized: signature.authorization_status == "AUTHORIZED",
        signer_revoked: signature.revocation_status != "CLEAR",
        verified_payload_digest: signature.payload_digest,
        verified_signer_id: signature.signer_id,
        verified_signer_scope: signature.signer_scope,
        mandatory_gate_receipt_valid: gate.status == "VERIFIED",
        verified_gate_receipt_digest: gate.receipt_digest,
        artifact_retrieved: artifact_length > 0,
        artifact_digest: artifact_digest,
        artifact_length: artifact_length
    )
    validate_signed_build_admission_v2(receipt, expected, trust)

export SignedBuildGateResultV2, verify_signed_build_bytes_v2
export verify_signed_build_stream_v2

struct SignedBuildFileDecisionV2:
    admission: SignedBuildAdmissionV1
    snapshot_root: text
    artifact_path: text

fn verify_signed_build_private_artifact_v2(
    wire: text, expected: SignedBuildExpectationV2,
    signature: SignedBuildSignatureResultV1, gates: SignedBuildGateResultV2,
    downloaded_path: text, private_parent: text,
    artifact_limit: i64
) -> SignedBuildFileDecisionV2:
    """Admit only a private byte snapshot and return that exact consumer path.

    The protected caller owns downloaded_path and private_parent, obtains the
    signature/gate provider results independently, and consumes artifact_path
    from this decision without reopening downloaded_path.
    """
    val parsed = parse_signed_build_receipt_wire_v2(wire)
    if parsed == nil:
        return SignedBuildFileDecisionV2(
            _verification_full_build_v1("invalid-receipt-wire"), "", "")
    val copied = snapshot_signed_build_artifact_v2(downloaded_path,
        private_parent, artifact_limit)
    if not copied.ready:
        return SignedBuildFileDecisionV2(
            _verification_full_build_v1(copied.reason), "", "")
    val admitted = _verify_signed_build_observed_v2(parsed.unwrap(), expected,
        signature, gates, copied.digest, copied.length)
    if admitted.decision != "REUSE":
        dir_remove_all(copied.snapshot_root)
        return SignedBuildFileDecisionV2(admitted, "", "")
    SignedBuildFileDecisionV2(admitted, copied.snapshot_root,
        copied.snapshot_path)

export SignedBuildFileDecisionV2, verify_signed_build_private_artifact_v2
