# Named build target resolution — ordered dependency closure.
#
# First slice of the targeted-build plan: resolution only, no compilation
# wiring. `resolve_target` returns the transitive dependency closure of a
# named target in topological order (every dependency before its dependent),
# with a deterministic tie-break by target name, and the requested target last.
#
# Fail-closed: an unknown name or a dependency cycle returns a named error and
# an EMPTY order — never a partial or defaulted plan.

use app.build.targets.build_targets.{TargetSet, find_target, find_cycle}

struct ResolvePlan:
    order: [text]
    error: text

fn _sorted_names(names: [text]) -> [text]:
    """Insertion-sort a copy of `names` ascending — the deterministic tie-break
    for sibling dependencies. Local copy: `sort` variants write back."""
    var out: [text] = []
    var i = 0
    while i < names.len():
        val v = names[i]
        var pos = 0
        while pos < out.len() and out[pos] < v:
            pos = pos + 1
        var next: [text] = []
        var k = 0
        while k < out.len():
            if k == pos:
                next.push(v)
            next.push(out[k])
            k = k + 1
        if pos >= out.len():
            next.push(v)
        out = next
        i = i + 1
    out

fn _contains_name(names: [text], v: text) -> bool:
    var i = 0
    while i < names.len():
        if names[i] == v:
            return true
        i = i + 1
    false

fn resolve_target(ts: TargetSet, name: text) -> ResolvePlan:
    """Ordered dependency closure of `name`, dependencies first.

    Deterministic: sibling dependencies are visited in ascending name order, so
    the same target set always produces the same order. Returns an empty order
    with a named error for an unknown target name or a dependency cycle."""
    var order: [text] = []
    val root = find_target(ts, name)
    if root < 0:
        return ResolvePlan(order, "target-error: unknown-target: " + name)
    val cycle = find_cycle(ts)
    if cycle.len() > 0:
        return ResolvePlan(order, "target-error: dependency-cycle: " + cycle)

    # Iterative post-order DFS (arrays are value types — no recursive helper).
    var node_stack: [i64] = []
    var edge_stack: [i64] = []
    node_stack.push(root)
    edge_stack.push(0)
    while node_stack.len() > 0:
        val top = node_stack[node_stack.len() - 1]
        val ei = edge_stack[edge_stack.len() - 1]
        val deps = _sorted_names(ts.targets[top].deps)
        if ei < deps.len():
            edge_stack[edge_stack.len() - 1] = ei + 1
            val j = find_target(ts, deps[ei])
            if j >= 0 and not _contains_name(order, deps[ei]):
                node_stack.push(j)
                edge_stack.push(0)
            elif j < 0:
                return ResolvePlan(order, "target-error: unknown-dep: " + ts.targets[top].name + " -> " + deps[ei])
        else:
            val nm = ts.targets[top].name
            if not _contains_name(order, nm):
                order.push(nm)
            node_stack.pop()
            edge_stack.pop()
    ResolvePlan(order, "")

fn format_target_plan(name: text, plan: ResolvePlan) -> text:
    """One-line plan rendering: `target-plan: <name>: a, b, c`."""
    var joined = ""
    var i = 0
    while i < plan.order.len():
        joined = if i == 0: plan.order[i] else: joined + ", " + plan.order[i]
        i = i + 1
    "target-plan: " + name + ": " + joined
