# Named build targets — parser and fail-closed validation.
#
# First slice of the targeted-build plan
# (doc/03_plan/compiler/build_system/targeted_build_interface_compat_minimal_bootstrap_2026-08-10.md).
# Parses a `build.sdn` / `targets.sdn` targets section declaring named targets:
#
#     target compiler:
#         kind: binary
#         entry: src/app/cli/main.spl
#
#     target compiler_tests:
#         kind: test
#         entry: test/01_unit/compiler/x_spec.spl
#         depends: compiler
#
# `depends:` accepts a comma-separated inline list or indented child lines.
#
# Validation is fail-closed: every rejection is a distinct named error and
# nothing is silently defaulted. Error codes (stable, one per line):
#
#     target-error: duplicate-name: <name>
#     target-error: missing-entry: <name>: <path>
#     target-error: unknown-dep: <name> -> <dep>
#     target-error: invalid-kind: <name>: <kind>
#     target-error: missing-field: <name>: <field>
#     target-error: dependency-cycle: a -> b -> a
#     target-error: parse: <detail>
#
# This module is self-contained on purpose: it does not read or import the
# driver-side target graph owned by another lane.

use std.io_runtime.{file_exists, file_read}

struct BuildTarget:
    name: text
    kind: text
    entry: text
    output: text
    deps: [text]

struct BuildGroup:
    name: text
    is_default: bool
    members: [text]

struct TargetSet:
    targets: [BuildTarget]
    errors: [text]
    groups: [BuildGroup]
    includes: [text]

fn _strip_comment(line: text) -> text:
    """Drop a trailing `#` comment. Target files carry no `#` in paths."""
    if line.contains("#"):
        val parts = line.split("#")
        return parts[0]
    line

fn _indent_of(line: text) -> i64:
    """Count leading spaces (tabs are rejected by the caller as a parse error)."""
    var n: i64 = 0
    while n < line.len() and line[n:n + 1] == " ":
        n = n + 1
    n

fn _split_list(value: text) -> [text]:
    """Split a comma-separated inline list, dropping empty entries."""
    var out: [text] = []
    if value.trim().len() == 0:
        return out
    val parts = value.split(",")
    var i = 0
    while i < parts.len():
        val item = parts[i].trim()
        if item.len() > 0:
            out.push(item)
        i = i + 1
    out

fn is_valid_kind(kind: text) -> bool:
    """Supported independently publishable target kinds."""
    kind == "binary" or kind == "library" or kind == "shared" or kind == "test"

fn parse_targets_text(src: text) -> TargetSet:
    """Parse the targets declarations out of a build.sdn/targets.sdn body.

    Pure text -> TargetSet. Does not touch the filesystem; entry-existence and
    dep-name/cycle validation happen in `validate_targets`. Non-`target`
    top-level sections are ignored so this can share a build.sdn with other
    sections.

    Also parses two top-level directives: `include: <path>` (recorded, resolved
    by `load_targets_file`) and `group <name>:` blocks with `default:` and
    `members:` (inline list or indented child lines)."""
    var targets: [BuildTarget] = []
    var errors: [text] = []
    var groups: [BuildGroup] = []
    var includes: [text] = []
    val lines = src.split("\n")

    var in_group = false
    var grp_name = ""
    var grp_default = false
    var grp_members: [text] = []
    var members_block = false

    var in_target = false
    var cur_name = ""
    var cur_kind = ""
    var cur_entry = ""
    var cur_output = ""
    var cur_deps: [text] = []
    var deps_block = false

    var i = 0
    while i <= lines.len():
        # A sentinel pass (i == len) flushes the last open target.
        val raw = if i < lines.len(): lines[i] else: "target __eof_sentinel__:"
        val line = _strip_comment(raw)
        val stripped = line.trim()
        if stripped.len() == 0:
            i = i + 1
            continue
        if line.contains("\t"):
            errors.push("target-error: parse: tab indentation at line " + (i + 1).to_text())
            i = i + 1
            continue

        val indent = _indent_of(line)

        if indent == 0:
            if in_target:
                targets.push(BuildTarget(cur_name, cur_kind, cur_entry, cur_output, cur_deps))
                in_target = false
            if in_group:
                groups.push(BuildGroup(grp_name, grp_default, grp_members))
                in_group = false
            deps_block = false
            members_block = false
            if stripped.starts_with("include:"):
                val inc = stripped[8:].trim()
                if inc.len() == 0:
                    errors.push("target-error: parse: empty include at line " + (i + 1).to_text())
                else:
                    includes.push(inc)
                i = i + 1
                continue
            if stripped.starts_with("group "):
                val ghead = stripped[6:].trim()
                if not ghead.ends_with(":") or ghead.len() < 2:
                    errors.push("target-error: parse: bad group header at line " + (i + 1).to_text())
                    i = i + 1
                    continue
                in_group = true
                grp_name = ghead[0:ghead.len() - 1].trim()
                grp_default = false
                grp_members = []
                i = i + 1
                continue
            if stripped.starts_with("target "):
                val head = stripped[7:].trim()
                if not head.ends_with(":"):
                    errors.push("target-error: parse: missing ':' after target name at line " + (i + 1).to_text())
                    i = i + 1
                    continue
                val nm = head[0:head.len() - 1].trim()
                if nm == "__eof_sentinel__":
                    i = i + 1
                    continue
                if nm.len() == 0:
                    errors.push("target-error: parse: empty target name at line " + (i + 1).to_text())
                    i = i + 1
                    continue
                in_target = true
                cur_name = nm
                cur_kind = ""
                cur_entry = ""
                cur_output = ""
                cur_deps = []
            i = i + 1
            continue

        if in_group:
            if members_block and not stripped.contains(":"):
                grp_members.push(stripped)
                i = i + 1
                continue
            if not stripped.contains(":"):
                errors.push("target-error: parse: expected 'key: value' at line " + (i + 1).to_text())
                i = i + 1
                continue
            val gkey = stripped.split(":")[0].trim()
            val gval = stripped[gkey.len() + 1:].trim()
            members_block = false
            if gkey == "default":
                if gval == "true":
                    grp_default = true
                elif gval == "false":
                    grp_default = false
                else:
                    errors.push("target-error: parse: group " + grp_name + " default must be true or false")
            elif gkey == "members":
                val ms = _split_list(gval)
                var m = 0
                while m < ms.len():
                    grp_members.push(ms[m])
                    m = m + 1
                members_block = ms.len() == 0
            else:
                errors.push("target-error: parse: unknown key '" + gkey + "' in group " + grp_name)
            i = i + 1
            continue

        if not in_target:
            i = i + 1
            continue

        if deps_block and not stripped.contains(":"):
            cur_deps.push(stripped)
            i = i + 1
            continue

        if not stripped.contains(":"):
            errors.push("target-error: parse: expected 'key: value' at line " + (i + 1).to_text())
            i = i + 1
            continue

        val kv = stripped.split(":")
        val key = kv[0].trim()
        var value = ""
        var k = 1
        while k < kv.len():
            value = if k == 1: kv[k] else: value + ":" + kv[k]
            k = k + 1
        value = value.trim()
        deps_block = false

        if key == "kind":
            cur_kind = value
        elif key == "entry":
            cur_entry = value
        elif key == "output":
            cur_output = value
        elif key == "depends" or key == "deps":
            val inline = _split_list(value)
            var d = 0
            while d < inline.len():
                cur_deps.push(inline[d])
                d = d + 1
            deps_block = inline.len() == 0
        else:
            errors.push("target-error: parse: unknown key '" + key + "' in target " + cur_name)
        i = i + 1

    TargetSet(targets, errors, groups, includes)

fn find_target(ts: TargetSet, name: text) -> i64:
    """Index of `name` in the target list, or -1."""
    var i = 0
    while i < ts.targets.len():
        if ts.targets[i].name == name:
            return i
        i = i + 1
    -1

fn find_cycle(ts: TargetSet) -> text:
    """First dependency cycle in the set as `a -> b -> a`, or "" if acyclic.

    Iterative DFS with an explicit node stack plus a per-node state marker set:
    state[i] is 0 = unvisited, 1 = on the current stack, 2 = fully explored.
    Iterative (not recursive) because arrays are value types here — a recursive
    helper would mutate its own copy of the marker set."""
    var state: [i64] = []
    var i = 0
    while i < ts.targets.len():
        state.push(0)
        i = i + 1

    var start = 0
    while start < ts.targets.len():
        if state[start] == 0:
            var node_stack: [i64] = []
            var edge_stack: [i64] = []
            node_stack.push(start)
            edge_stack.push(0)
            state[start] = 1
            while node_stack.len() > 0:
                val top = node_stack[node_stack.len() - 1]
                val ei = edge_stack[edge_stack.len() - 1]
                val deps = ts.targets[top].deps
                if ei < deps.len():
                    edge_stack[edge_stack.len() - 1] = ei + 1
                    val j = find_target(ts, deps[ei])
                    if j >= 0:
                        if state[j] == 1:
                            # Close the path at the node already on the stack.
                            var path = ""
                            var s = 0
                            var started = false
                            while s < node_stack.len():
                                if node_stack[s] == j:
                                    started = true
                                if started:
                                    val nm = ts.targets[node_stack[s]].name
                                    path = if path.len() == 0: nm else: path + " -> " + nm
                                s = s + 1
                            return path + " -> " + ts.targets[j].name
                        if state[j] == 0:
                            state[j] = 1
                            node_stack.push(j)
                            edge_stack.push(0)
                else:
                    state[top] = 2
                    node_stack.pop()
                    edge_stack.pop()
        start = start + 1
    ""

fn validate_targets(ts: TargetSet, repo_root: text) -> [text]:
    """Full fail-closed validation. Returns every error found (never throws).

    Checks, each a distinct named error: parse errors carried in from the
    parser, duplicate name, missing/invalid kind, missing entry field, entry
    file not on disk, unknown dep name, dependency cycle."""
    var errors: [text] = []
    var e = 0
    while e < ts.errors.len():
        errors.push(ts.errors[e])
        e = e + 1

    var i = 0
    while i < ts.targets.len():
        val t = ts.targets[i]
        var j = 0
        while j < i:
            if ts.targets[j].name == t.name:
                errors.push("target-error: duplicate-name: " + t.name)
            j = j + 1
        if t.kind.len() == 0:
            errors.push("target-error: missing-field: " + t.name + ": kind")
        elif not is_valid_kind(t.kind):
            errors.push("target-error: invalid-kind: " + t.name + ": " + t.kind)
        if t.entry.len() == 0:
            errors.push("target-error: missing-field: " + t.name + ": entry")
        else:
            val abs = if t.entry.starts_with("/"): t.entry else: repo_root + "/" + t.entry
            if not file_exists(abs):
                errors.push("target-error: missing-entry: " + t.name + ": " + t.entry)
        if t.output.starts_with("/"):
            errors.push("target-error: unsafe-output: " + t.name + ": " + t.output)
        elif t.output.contains(".."):
            errors.push("target-error: unsafe-output: " + t.name + ": " + t.output)
        var d = 0
        while d < t.deps.len():
            if find_target(ts, t.deps[d]) < 0:
                errors.push("target-error: unknown-dep: " + t.name + " -> " + t.deps[d])
            d = d + 1
        i = i + 1

    var g = 0
    while g < ts.groups.len():
        val grp = ts.groups[g]
        var h = 0
        while h < g:
            if ts.groups[h].name == grp.name:
                errors.push("target-error: duplicate-group: " + grp.name)
            h = h + 1
        var m = 0
        while m < grp.members.len():
            if find_target(ts, grp.members[m]) < 0:
                errors.push("target-error: unknown-group-member: " + grp.name + " -> " + grp.members[m])
            m = m + 1
        g = g + 1

    val cycle = find_cycle(ts)
    if cycle.len() > 0:
        errors.push("target-error: dependency-cycle: " + cycle)
    errors

fn group_targets(ts: TargetSet, group: text) -> [text]:
    """Member target names of every group named `group` (empty if none)."""
    var out: [text] = []
    var g = 0
    while g < ts.groups.len():
        if ts.groups[g].name == group:
            var m = 0
            while m < ts.groups[g].members.len():
                out.push(ts.groups[g].members[m])
                m = m + 1
        g = g + 1
    out

fn default_group_targets(ts: TargetSet) -> [text]:
    """Targets a default build selects: members of `default: true` groups.

    A file that declares no group keeps the pre-group meaning: every target."""
    var out: [text] = []
    if ts.groups.len() == 0:
        var i = 0
        while i < ts.targets.len():
            out.push(ts.targets[i].name)
            i = i + 1
        return out
    var g = 0
    while g < ts.groups.len():
        if ts.groups[g].is_default:
            var m = 0
            while m < ts.groups[g].members.len():
                out.push(ts.groups[g].members[m])
                m = m + 1
        g = g + 1
    out

fn normalize_include_path(p: text) -> text:
    """Use `/` on every host so one config reads the same everywhere."""
    p.replace("\\", "/")

fn _dir_of(path: text) -> text:
    val p = normalize_include_path(path)
    var i = p.len() - 1
    while i >= 0:
        if p[i:i + 1] == "/":
            return p[0:i]
        i = i - 1
    "."

fn _canonical_path(p: text) -> text:
    """Collapse `.` and `..` segments so one file always has one spelling."""
    val n = normalize_include_path(p)
    val absolute = n.starts_with("/")
    val parts = n.split("/")
    var out: [text] = []
    var i = 0
    while i < parts.len():
        val s = parts[i]
        if s == "" or s == ".":
            i = i + 1
            continue
        if s == ".." and out.len() > 0 and out[out.len() - 1] != "..":
            out.pop()
        else:
            out.push(s)
        i = i + 1
    var r = ""
    var j = 0
    while j < out.len():
        r = if j == 0: out[j] else: r + "/" + out[j]
        j = j + 1
    if absolute: "/" + r else: r

fn _resolve_include(including: text, inc: text) -> text:
    val n = normalize_include_path(inc)
    if n.starts_with("/") or (n.len() > 1 and n[1:2] == ":"):
        return _canonical_path(n)
    _canonical_path(_dir_of(including) + "/" + n)

fn load_targets_file(path: text, repo_root: text) -> TargetSet:
    """Read and parse a targets file, following `include:` directives.

    A missing file yields a parse error, not an empty default — absence must
    never look like 'no targets declared'. Includes resolve relative to the
    including file; a cycle or a missing include is a named error."""
    var targets: [BuildTarget] = []
    var errors: [text] = []
    var groups: [BuildGroup] = []
    var includes: [text] = []
    if not file_exists(path):
        errors.push("target-error: parse: targets file not found: " + path)
        return TargetSet(targets, errors, groups, includes)

    # Iterative walk (arrays are value types; no recursive accumulator).
    # Each stack entry carries its include chain for cycle reporting.
    var stack_path: [text] = []
    var stack_chain: [text] = []
    # Include-once: a file reached twice by a diamond is parsed once.
    var visited: [text] = []
    stack_path.push(_canonical_path(path))
    stack_chain.push("")
    while stack_path.len() > 0:
        val cur = stack_path[stack_path.len() - 1]
        val chain = stack_chain[stack_chain.len() - 1]
        stack_path.pop()
        stack_chain.pop()
        if visited.contains(cur):
            continue
        visited.push(cur)
        val ts = parse_targets_text(file_read(cur))
        var k = 0
        while k < ts.targets.len():
            targets.push(ts.targets[k])
            k = k + 1
        k = 0
        while k < ts.errors.len():
            errors.push(ts.errors[k])
            k = k + 1
        k = 0
        while k < ts.groups.len():
            groups.push(ts.groups[k])
            k = k + 1
        val here = if chain.len() == 0: cur else: chain + " -> " + cur
        k = 0
        while k < ts.includes.len():
            val child = _resolve_include(cur, ts.includes[k])
            if here.split(" -> ").contains(child):
                errors.push("target-error: include-cycle: " + here + " -> " + child)
            elif visited.contains(child):
                k = k + 1
                continue
            elif not file_exists(child):
                errors.push("target-error: include-missing: " + cur + ": " + ts.includes[k])
            else:
                includes.push(child)
                stack_path.push(child)
                stack_chain.push(here)
            k = k + 1
    TargetSet(targets, errors, groups, includes)
