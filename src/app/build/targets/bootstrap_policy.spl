# codex-impl
# Pure typed bootstrap authorization policy. The enclosing shell admission
# binds the remaining evidence and is the only stage-start authority.

use app.build.targets.build_explain.{BootstrapReason, bootstrap_reason_name}

val BOOTSTRAP_RECEIPT_SCHEMA_V2 = "simple-bootstrap-authorization-v2"
val BOOTSTRAP_RECEIPT_PRODUCER_V2 = "simple-build-planner-v2"
val BOOTSTRAP_STAGE3_TARGET_V2 = "//bootstrap:stage3"
val BOOTSTRAP_STAGE4_TARGET_V2 = "//bootstrap:stage4"

fn bootstrap_reason_from_name(name: text) -> BootstrapReason:
    match name:
        case "seed-missing": BootstrapReason.SeedMissing
        case "seed-corrupt": BootstrapReason.SeedCorrupt
        case "seed-target-unsupported": BootstrapReason.SeedTargetUnsupported
        case "seed-cannot-parse-required-language-feature": BootstrapReason.SeedCannotParseRequiredLanguageFeature
        case "seed-cannot-lower-required-compiler-feature": BootstrapReason.SeedCannotLowerRequiredCompilerFeature
        case "bootstrap-runtime-abi-major-changed": BootstrapReason.BootstrapRuntimeAbiMajorChanged
        case "bootstrap-artifact-format-major-changed": BootstrapReason.BootstrapArtifactFormatMajorChanged
        case "bootstrap-core-interface-major-changed": BootstrapReason.BootstrapCoreInterfaceMajorChanged
        case "self-host-convergence-check": BootstrapReason.SelfHostConvergenceCheck
        case "release-trust-verification": BootstrapReason.ReleaseTrustVerification
        case "diverse-double-compilation": BootstrapReason.DiverseDoubleCompilation
        case "verify-landed-compiler-fix": BootstrapReason.VerifyLandedCompilerFix
        case _: BootstrapReason.None

fn bootstrap_reason_is_explicit(reason: BootstrapReason) -> bool:
    reason != BootstrapReason.None

fn bootstrap_reason_allowed_v2(target: text, reason: BootstrapReason) -> bool:
    if target == BOOTSTRAP_STAGE3_TARGET_V2:
        return reason == BootstrapReason.SeedMissing or
            reason == BootstrapReason.SeedCorrupt or
            reason == BootstrapReason.SeedTargetUnsupported or
            reason == BootstrapReason.SeedCannotParseRequiredLanguageFeature or
            reason == BootstrapReason.SeedCannotLowerRequiredCompilerFeature or
            reason == BootstrapReason.BootstrapRuntimeAbiMajorChanged or
            reason == BootstrapReason.BootstrapArtifactFormatMajorChanged or
            reason == BootstrapReason.BootstrapCoreInterfaceMajorChanged or
            reason == BootstrapReason.VerifyLandedCompilerFix
    target == BOOTSTRAP_STAGE4_TARGET_V2 and
        (reason == BootstrapReason.SelfHostConvergenceCheck or
        reason == BootstrapReason.ReleaseTrustVerification or
        reason == BootstrapReason.DiverseDoubleCompilation)

fn bootstrap_sha256_is_canonical_v2(value: text) -> bool:
    if value.len() != 64:
        return false
    var i = 0
    while i < value.len():
        if not "0123456789abcdef".contains(value.substring(i, i + 1)):
            return false
        i = i + 1
    true

fn bootstrap_authorization_receipt_v2(target: text, reason: BootstrapReason,
        parent_sha256: text, runtime_sha256: text, closure_sha256: text,
        planner_sha256: text) -> text:
    if not bootstrap_reason_allowed_v2(target, reason) or
            not bootstrap_sha256_is_canonical_v2(parent_sha256) or
            not bootstrap_sha256_is_canonical_v2(runtime_sha256) or
            not bootstrap_sha256_is_canonical_v2(closure_sha256) or
            not bootstrap_sha256_is_canonical_v2(planner_sha256):
        return ""
    BOOTSTRAP_RECEIPT_SCHEMA_V2 +
        "|producer=" + BOOTSTRAP_RECEIPT_PRODUCER_V2 +
        "|target=" + target + "|reason=" + bootstrap_reason_name(reason) +
        "|parent_sha256=" + parent_sha256 +
        "|runtime_sha256=" + runtime_sha256 +
        "|source_closure_sha256=" + closure_sha256 +
        "|planner_sha256=" + planner_sha256
