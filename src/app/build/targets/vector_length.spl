# Runtime vector-length (VL) query for SVE/RVV (backend_contracts.sdn
# `vector_length: {mode: vl_agnostic, query: runtime}`).
#
# SVE/RVV code is vector-length-agnostic: the length is never a build-time
# constant, it is read from the running host. The values come from
# `detect_capabilities()` (RVV: `vlenb` CSR; SVE: kernel default VL). 0 means
# unsupported or unknown, never a guessed length.

use compiler.types.simd_capabilities.{detect_capabilities}

pub fn vector_length_bits_for(arch: text, has_sve: bool, sve_bits: i64, has_v: bool, rvv_bits: i64) -> i64:
    """Pure selection: the VL (bits) for `arch`, or 0 when the extension is absent."""
    if arch == "aarch64" and has_sve: return sve_bits
    if arch == "riscv64" and has_v: return rvv_bits
    0

pub fn vector_length_valid(arch: text, bits: i64) -> bool:
    """SVE: multiple of 128, 128..2048. RVV: power of two."""
    if bits <= 0: return false
    if arch == "aarch64": return bits % 128 == 0 and bits <= 2048
    if arch == "riscv64": return (bits & (bits - 1)) == 0
    false

pub fn vector_length_bits(arch: text) -> i64:
    """Runtime read on the running host; 0 for other arches or a mismatched host."""
    if arch != "aarch64" and arch != "riscv64": return 0
    val f = detect_capabilities()
    val bits = vector_length_bits_for(arch, f.has_sve, f.sve_vector_length.to_i64(), f.has_v, f.vlen.to_i64())
    if bits > 0 and not vector_length_valid(arch, bits): return 0
    bits

pub fn vector_length_query_contract_error(mode: text, query: text) -> text:
    if mode != "vl_agnostic" or query != "runtime":
        return "target-error: vector-length-query: " + mode + "/" + query + ": must be vl_agnostic/runtime"
    ""
