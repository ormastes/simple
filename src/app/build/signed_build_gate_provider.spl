# Protected controller bridge from complete gate observations to the signed
# build verifier. Only the protected checker may construct `observed`; a
# candidate-supplied GateReceipt is self-attestation, not execution evidence.
use app.build.gate_receipt.{GateReceipt, GateReceiptExpectation,
    validate_gate_receipt_v1, gate_receipt_digest_v1}
use app.build.signed_build_admission.{SignedBuildExpectationV2}
use app.build.signed_build_verifier.{SignedBuildGateResultV1,
    SignedBuildGateResultV2}
use app.sj.gate_manifest.{parse_gate_manifest}
use std.common.crypto.sha256.{sha256_text}

val SIGNED_BUILD_GATE_MANIFEST_HEADER_V2 =
    "must_check_gates |id, tier, push_blocking, mode, command, ci_job, inputs, description|"

fn _gate_manifest_row_has_eight_fields_v2(line: text) -> bool:
    var quoted = false
    var separators = 0
    var i = 0
    while i < line.len():
        val code = line.char_code_at(i)
        if code == 34:
            if quoted and i + 1 < line.len() and
                    line.char_code_at(i + 1) == 34:
                i = i + 1
            else:
                quoted = not quoted
        elif code == 44 and not quoted:
            separators = separators + 1
        i = i + 1
    not quoted and separators == 7

struct SignedBuildGateProbeV2:
    verified: bool
    reason: text
    gates: SignedBuildGateResultV2

fn _gate_rejected_v2(reason: text) -> SignedBuildGateProbeV2:
    SignedBuildGateProbeV2(false, reason, SignedBuildGateResultV2(
        "", 0, SignedBuildGateResultV1("REJECTED", "", "", "", "",
            "", "")))

fn verify_protected_gate_receipt_v2(
    receipt: GateReceipt, expected: SignedBuildExpectationV2,
    protected_mandatory_ids: [text], protected_issuer: text
) -> SignedBuildGateProbeV2:
    """Bind exact candidate gates to the signed build's expected digest.

    The controller must derive mandatory IDs and issuer from its protected
    base policy and collect observations through its own checker. Neither may
    be copied from the submitted build or gate receipt.
    """
    val policy = expected.build
    val gate_expected = GateReceiptExpectation(
        policy.base_revision, policy.head_revision, policy.candidate_tree,
        policy.protected_policy_digest, policy.checker_digest,
        policy.submodule_closure_digest, protected_issuer,
        protected_mandatory_ids)
    val validation = validate_gate_receipt_v1(receipt, gate_expected)
    if validation.verdict != "PASS":
        return _gate_rejected_v2("mandatory-gates-" + validation.verdict)
    # Signed-build reuse skips mandatory work. Applicability exemptions need
    # their own protected policy proof before they can authorize that skip.
    for row in receipt.observed:
        if row.status != "PASS":
            return _gate_rejected_v2("mandatory-gate-not-passed:" + row.id)
    val digest = gate_receipt_digest_v1(receipt)
    if digest == "" or digest != policy.mandatory_gate_receipt_digest:
        return _gate_rejected_v2("gate-receipt-digest-mismatch")
    SignedBuildGateProbeV2(true, "verified", SignedBuildGateResultV2(
        expected.repository_full_name, expected.pull_request_number,
        SignedBuildGateResultV1("VERIFIED", digest, policy.base_revision,
            policy.head_revision, policy.candidate_tree,
            policy.protected_policy_digest, policy.checker_digest)))

fn verify_protected_bootstrap_gates_v2(
    receipt: GateReceipt, expected: SignedBuildExpectationV2,
    protected_manifest_text: text, protected_manifest_digest: text,
    protected_issuer: text
) -> SignedBuildGateProbeV2:
    """Conservatively require every bootstrap gate in pinned base policy.

    The caller must obtain manifest bytes and digest independently from the
    protected base, never from the candidate checkout or build receipt.
    The registry marks push blocking, not bootstrap mandatory status. Requiring
    every bootstrap row avoids silently omitting required rows until that
    distinction is encoded in protected policy. Other required CI contexts
    continue to run in their own jobs.
    """
    if protected_manifest_text.len() == 0 or
            protected_manifest_text.len() > 1048576 or
            sha256_text(protected_manifest_text) != protected_manifest_digest:
        return _gate_rejected_v2("protected-manifest-digest-mismatch")
    var header_count = 0
    var row_count = 0
    for raw in protected_manifest_text.split("\n"):
        val line = raw.trim()
        if line == "" or line.starts_with("#"):
            continue
        if line.starts_with("must_check_gates"):
            if line != SIGNED_BUILD_GATE_MANIFEST_HEADER_V2:
                return _gate_rejected_v2("protected-manifest-header-invalid")
            header_count = header_count + 1
        else:
            if header_count != 1 or
                    not _gate_manifest_row_has_eight_fields_v2(line):
                return _gate_rejected_v2("protected-manifest-row-shape-invalid")
            row_count = row_count + 1
    if header_count != 1 or row_count == 0:
        return _gate_rejected_v2("protected-manifest-shape-invalid")
    val rows = parse_gate_manifest(protected_manifest_text)
    if rows.len() != row_count:
        return _gate_rejected_v2("protected-manifest-row-count-mismatch")
    var all_ids: [text] = []
    var mandatory_ids: [text] = []
    for row in rows:
        if row.gate_id == "" or row.command == "" or
                all_ids.contains(row.gate_id):
            return _gate_rejected_v2("protected-manifest-row-invalid")
        all_ids.push(row.gate_id)
        if row.tier == "bootstrap":
            mandatory_ids.push(row.gate_id)
    if mandatory_ids.len() == 0:
        return _gate_rejected_v2("empty-protected-bootstrap-gates")
    verify_protected_gate_receipt_v2(receipt, expected,
        mandatory_ids, protected_issuer)

export SignedBuildGateProbeV2, verify_protected_gate_receipt_v2
export verify_protected_bootstrap_gates_v2
