# Pure Clang policy decision. The caller must obtain these observations from a
# complete invocation capture and a provider-qualified immutable snapshot.
# An observation digest is the provider-versioned full macro definition identity,
# including state, replacement tokens, parameters, origin, and order.
use std.common.crypto.sha256.{sha256_text}

val CLANG_POLICY_STAMP_SCHEMA_V1 = "simple-clang-effective-policy-v1"

struct ClangMacroRuleV1:
    name: text
    kind: text                  # fixed | variants
    allowed_definition_digests: [text]

struct ClangMacroObservationV1:
    name: text
    definition_digest: text
    origin: text
    consumer: text

struct ClangPolicyExceptionV1:
    id: text
    name: text
    origin: text
    consumer: text
    variation_permission: text # allow_variation
    cache_mode: text            # complex | none

struct ClangPolicyContextV1:
    target: text
    profile: text
    immutable_snapshot_digest: text
    protected_policy_digest: text
    invocation_digest: text
    toolchain_digest: text
    complete_context_digest: text
    boundary_kind: text        # tu | native-prefix | pch | pcm | bmi
    entry_observations_complete: bool
    dependency_observations_complete: bool
    boundary_qualified: bool
    rules: [ClangMacroRuleV1]
    observations: [ClangMacroObservationV1]
    exceptions: [ClangPolicyExceptionV1]

struct ClangPolicyDecisionV1:
    verdict: text              # ACCEPT | REJECT
    cache_mode: text           # strict | complex | none | prohibited
    stamp_digest: text         # empty when rejected
    reason: text

fn _digest(value: text) -> bool:
    if value.len() != 64:
        return false
    var i = 0
    while i < value.len():
        val c = value[i:i + 1]
        if not ((c >= "0" and c <= "9") or (c >= "a" and c <= "f")):
            return false
        i = i + 1
    true

fn _id(value: text) -> bool:
    value.len() > 0 and value == value.trim() and
        not value.contains("\n") and not value.contains("\r") and
        not value.contains("|")

fn _contains(values: [text], value: text) -> bool:
    var i = 0
    while i < values.len():
        if values[i] == value:
            return true
        i = i + 1
    false

fn _reject(reason: text) -> ClangPolicyDecisionV1:
    ClangPolicyDecisionV1("REJECT", "prohibited", "", reason)

fn _supported_boundary(kind: text) -> bool:
    kind == "tu" or kind == "native-prefix" or kind == "pch" or
        kind == "pcm" or kind == "bmi"

fn _rule_valid(rule: ClangMacroRuleV1) -> bool:
    if not _id(rule.name) or
            (rule.kind != "fixed" and rule.kind != "variants") or
            rule.allowed_definition_digests.len() == 0:
        return false
    if rule.kind == "fixed" and rule.allowed_definition_digests.len() != 1:
        return false
    var seen: [text] = []
    var i = 0
    while i < rule.allowed_definition_digests.len():
        val digest = rule.allowed_definition_digests[i]
        if not _digest(digest) or _contains(seen, digest) or
                (seen.len() > 0 and digest <= seen[seen.len() - 1]):
            return false
        seen.push(digest)
        i = i + 1
    true

fn _exception_valid(row: ClangPolicyExceptionV1) -> bool:
    _id(row.id) and _id(row.name) and _id(row.origin) and
        _id(row.consumer) and row.variation_permission == "allow_variation" and
        (row.cache_mode == "complex" or row.cache_mode == "none")

# The caller supplies exact, resolved origin and consumer identities. No glob or
# basename matching is done here: a different file cannot inherit an exception.
pub fn evaluate_clang_policy_v1(ctx: ClangPolicyContextV1) -> ClangPolicyDecisionV1:
    """Reject unknown variation; return the exact effective policy identity."""
    if not _id(ctx.target) or not _id(ctx.profile) or
            not _digest(ctx.immutable_snapshot_digest) or
            not _digest(ctx.protected_policy_digest) or
            not _digest(ctx.invocation_digest) or
            not _digest(ctx.toolchain_digest) or
            not _digest(ctx.complete_context_digest):
        return _reject("incomplete-action-identity")
    if not _supported_boundary(ctx.boundary_kind) or not ctx.boundary_qualified:
        return _reject("unsupported-boundary")
    if not ctx.entry_observations_complete or
            not ctx.dependency_observations_complete:
        return _reject("incomplete-observation")

    var rule_names: [text] = []
    var i = 0
    while i < ctx.rules.len():
        val rule = ctx.rules[i]
        if not _rule_valid(rule) or _contains(rule_names, rule.name) or
                (rule_names.len() > 0 and rule.name <= rule_names[rule_names.len() - 1]):
            return _reject("invalid-or-duplicate-rule")
        rule_names.push(rule.name)
        i = i + 1
    var exception_ids: [text] = []
    i = 0
    while i < ctx.exceptions.len():
        val row = ctx.exceptions[i]
        if not _exception_valid(row) or _contains(exception_ids, row.id) or
                (exception_ids.len() > 0 and row.id <= exception_ids[exception_ids.len() - 1]):
            return _reject("invalid-or-duplicate-exception")
        exception_ids.push(row.id)
        i = i + 1

    var mode = "strict"
    var seen_observations: [text] = []
    i = 0
    while i < ctx.observations.len():
        val observation = ctx.observations[i]
        if not _id(observation.name) or not _digest(observation.definition_digest) or
                not _id(observation.origin) or not _id(observation.consumer):
            return _reject("invalid-observation")
        val observation_key = sha256_text(observation.name + "|" +
            sha256_text(observation.origin) + sha256_text(observation.consumer))
        val ordered_key = observation.name + "|" + observation.origin + "|" +
            observation.consumer
        if i > 0:
            val previous = ctx.observations[i - 1]
            val previous_key = previous.name + "|" + previous.origin + "|" +
                previous.consumer
            if ordered_key <= previous_key:
                return _reject("noncanonical-observation-order")
        if _contains(seen_observations, observation_key):
            return _reject("duplicate-observation")
        seen_observations.push(observation_key)

        var rule_found = false
        var rule_allowed = false
        var j = 0
        while j < ctx.rules.len():
            val rule = ctx.rules[j]
            if rule.name == observation.name:
                rule_found = true
                rule_allowed = _contains(rule.allowed_definition_digests,
                    observation.definition_digest)
            j = j + 1
        var exception_mode = ""
        j = 0
        while j < ctx.exceptions.len():
            val row = ctx.exceptions[j]
            if row.name == observation.name and row.origin == observation.origin and
                    row.consumer == observation.consumer:
                if exception_mode != "":
                    return _reject("ambiguous-exception")
                exception_mode = row.cache_mode
            j = j + 1
        if not rule_allowed:
            if exception_mode == "" or (rule_found and
                    ctx.rules.len() > 0 and _fixed_rule(ctx.rules, observation.name)):
                return _reject("undeclared-or-forbidden-variation")
        if exception_mode == "none":
            mode = "none"
        elif exception_mode == "complex" and mode != "none":
            mode = "complex"
        i = i + 1

    # Every fixed rule must be observed, including a provider identity for the
    # explicitly undefined state. Missing observations cannot certify a default.
    i = 0
    while i < ctx.rules.len():
        if ctx.rules[i].kind == "fixed":
            var found = false
            var j = 0
            while j < ctx.observations.len():
                if ctx.observations[j].name == ctx.rules[i].name:
                    found = true
                j = j + 1
            if not found:
                return _reject("missing-fixed-definition")
        i = i + 1

    val stamp = sha256_text(CLANG_POLICY_STAMP_SCHEMA_V1 + "|" +
        sha256_text(ctx.target) + sha256_text(ctx.profile) +
        ctx.immutable_snapshot_digest + ctx.protected_policy_digest +
        ctx.invocation_digest + ctx.toolchain_digest +
        ctx.complete_context_digest + _effective_rows_digest(ctx) +
        sha256_text(ctx.boundary_kind) +
        sha256_text(mode))
    ClangPolicyDecisionV1("ACCEPT", mode, stamp, "admitted")

fn _fixed_rule(rules: [ClangMacroRuleV1], name: text) -> bool:
    var i = 0
    while i < rules.len():
        if rules[i].name == name and rules[i].kind == "fixed":
            return true
        i = i + 1
    false

fn _effective_rows_digest(ctx: ClangPolicyContextV1) -> text:
    # Framed hash chains make row order and every admitted identity explicit.
    # The protected root is still supplied independently by the trusted caller.
    var root = sha256_text("simple-clang-policy-rows-v1")
    var i = 0
    while i < ctx.rules.len():
        val rule = ctx.rules[i]
        var allowed = sha256_text("simple-clang-allowed-v1")
        var j = 0
        while j < rule.allowed_definition_digests.len():
            allowed = sha256_text(allowed + rule.allowed_definition_digests[j])
            j = j + 1
        root = sha256_text(root + "R" + sha256_text(rule.name) +
            sha256_text(rule.kind) + allowed)
        i = i + 1
    i = 0
    while i < ctx.exceptions.len():
        val row = ctx.exceptions[i]
        root = sha256_text(root + "E" + sha256_text(row.id) +
            sha256_text(row.name) + sha256_text(row.origin) +
            sha256_text(row.consumer) + sha256_text(row.variation_permission) +
            sha256_text(row.cache_mode))
        i = i + 1
    i = 0
    while i < ctx.observations.len():
        val observation = ctx.observations[i]
        root = sha256_text(root + "O" + sha256_text(observation.name) +
            observation.definition_digest + sha256_text(observation.origin) +
            sha256_text(observation.consumer))
        i = i + 1
    root

export CLANG_POLICY_STAMP_SCHEMA_V1, ClangMacroRuleV1
export ClangMacroObservationV1, ClangPolicyExceptionV1
export ClangPolicyContextV1, ClangPolicyDecisionV1, evaluate_clang_policy_v1
