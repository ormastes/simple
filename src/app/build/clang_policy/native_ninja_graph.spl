# Exact two-file CMake/Ninja graph observation for the first native adapter.
# Dynamic include/subninja/dyndep graphs require a separate complete-closure
# observer. A digest is approved only when supplied from protected policy.
use app.io.mod.{file_read_regular_no_follow_bounded}
use std.common.crypto.sha256.{sha256_text}

val CLANG_NINJA_GRAPH_FILE_MAX_BYTES_V1: i64 = 8388608

struct ClangNinjaGraphObservationV1:
    valid: bool
    reason: text
    graph_digest: text
    build_wire: text
    rules_wire: text

fn _graph_reject_v1(reason: text) -> ClangNinjaGraphObservationV1:
    ClangNinjaGraphObservationV1(false, reason, "", "", "")

fn observe_clang_ninja_graph_v1(build_root: text) -> ClangNinjaGraphObservationV1:
    """Hash exact CMake build/rules files and reject unsupported graph closure."""
    if not build_root.starts_with("/") or build_root.len() < 2 or
       build_root.len() > 4096 or build_root.ends_with("/") or
       build_root.contains("//") or build_root.contains("\n") or
       build_root.contains("\r") or build_root.contains("\x00"):
        return _graph_reject_v1("build-root-invalid")
    for part in build_root.split("/"):
        if part == "." or part == "..":
            return _graph_reject_v1("build-root-invalid")
    val build = file_read_regular_no_follow_bounded(
        build_root + "/build.ninja", CLANG_NINJA_GRAPH_FILE_MAX_BYTES_V1)
    val rules = file_read_regular_no_follow_bounded(
        build_root + "/CMakeFiles/rules.ninja",
        CLANG_NINJA_GRAPH_FILE_MAX_BYTES_V1)
    if build.is_err() or rules.is_err() or
       build.unwrap().len() == 0 or rules.unwrap().len() == 0:
        return _graph_reject_v1("native-graph-unavailable")
    var include_count: i64 = 0
    for raw in build.unwrap().split("\n"):
        val line = raw.trim()
        if line.starts_with("#"): continue
        if line.starts_with("include"):
            if line != "include CMakeFiles/rules.ninja":
                return _graph_reject_v1("native-graph-include-unsupported")
            include_count = include_count + 1
        elif line.starts_with("subninja") or
             line.starts_with("dyndep"):
            return _graph_reject_v1("native-graph-dynamic-unsupported")
    if include_count != 1:
        return _graph_reject_v1("native-graph-include-count-invalid")
    for raw in rules.unwrap().split("\n"):
        val line = raw.trim()
        if line.starts_with("#"): continue
        if line.starts_with("include") or line.starts_with("subninja") or
           line.starts_with("dyndep"):
            return _graph_reject_v1("native-rules-closure-unsupported")
    val digest = sha256_text("simple-clang-ninja-graph-v1|" +
        sha256_text(build.unwrap()) + sha256_text(rules.unwrap()))
    ClangNinjaGraphObservationV1(true, "exact-two-file-graph", digest,
        build.unwrap(), rules.unwrap())

fn _graph_rule_present_v1(rules_wire: text, name: text) -> bool:
    for raw in rules_wire.split("\n"):
        if raw == "rule " + name: return true
    false

fn _graph_cmake_archive_rule_v1(name: text) -> bool:
    name.starts_with("C_STATIC_LIBRARY_LINKER__") or
        name.starts_with("CXX_STATIC_LIBRARY_LINKER__") or
        name.starts_with("OBJC_STATIC_LIBRARY_LINKER__") or
        name.starts_with("OBJCXX_STATIC_LIBRARY_LINKER__")

fn validate_clang_ninja_target_map_v1(build_root: text,
        output_relative: text, stamp_relative: text,
        object_relatives: [text]) -> ClangNinjaGraphObservationV1:
    """Require the pinned CMake archive edge to consume exactly mapped objects.

    This V1 parser rejects escaped, continued, implicit and variable-derived
    paths on selected edges. It does not authenticate the compiler/archiver
    command; protected policy must bind that separate execution closure.
    """
    val graph = observe_clang_ninja_graph_v1(build_root)
    if not graph.valid: return graph
    if output_relative == "" or stamp_relative == "" or
       object_relatives.len() == 0:
        return _graph_reject_v1("native-target-map-invalid")
    var producer_counts: [i64] = []
    for _relative in object_relatives: producer_counts.push(0)
    var target_count: i64 = 0
    var direct_objects: [text] = []
    # Reject unsupported Ninja lexical forms before selecting any edge. A
    # continued variable value can contain text resembling a build edge, and
    # a variable-derived output can hide the actual archive edge.
    for raw in graph.build_wire.split("\n"):
        val line = raw.trim()
        if line.ends_with("$"):
            return _graph_reject_v1("native-graph-continuation-unsupported")
        if line.starts_with("build "):
            if not raw.starts_with("build "):
                return _graph_reject_v1("native-graph-indented-edge-unsupported")
            val head = raw.split(":")[0]
            if head.contains("$"):
                return _graph_reject_v1("native-graph-variable-output-unsupported")
    for raw in graph.rules_wire.split("\n"):
        val line = raw.trim()
        if line.ends_with("$"):
            return _graph_reject_v1("native-rules-continuation-unsupported")
        if line.starts_with("rule "):
            if not raw.starts_with("rule ") or raw.contains("$"):
                return _graph_reject_v1("native-rules-declaration-unsupported")
    for raw in graph.build_wire.split("\n"):
        val line = raw.trim()
        if not raw.starts_with("build "): continue
        val edge = line.split(":")
        if edge.len() < 2: continue
        val lhs = edge[0][6:]
        var selected_target = false
        var selected_object: i64 = -1
        for output in lhs.split(" "):
            if output == output_relative: selected_target = true
            var i: i64 = 0
            while i < object_relatives.len():
                if output == object_relatives[i]: selected_object = i
                i = i + 1
        if not selected_target and selected_object < 0: continue
        if edge.len() != 2 or line.contains("$") or
           line.contains("\t") or lhs.contains("|"):
            return _graph_reject_v1("native-target-edge-unsupported")
        val outputs = lhs.split(" ")
        if outputs.len() != 1 or outputs[0] == "":
            return _graph_reject_v1("native-target-multiple-outputs")
        val rhs = edge[1].trim().split(" ")
        if rhs.len() == 0 or rhs[0] == "" or
           not _graph_rule_present_v1(graph.rules_wire, rhs[0]):
            return _graph_reject_v1("native-target-rule-unavailable")
        if selected_object >= 0:
            if rhs[0] == "phony":
                return _graph_reject_v1("native-object-phony-producer")
            producer_counts[selected_object] =
                producer_counts[selected_object] + 1
            if producer_counts[selected_object] != 1:
                return _graph_reject_v1("native-object-duplicate-producer")
            continue
        if not _graph_cmake_archive_rule_v1(rhs[0]):
            return _graph_reject_v1("native-target-rule-unsupported")
        if rhs.len() < 2:
            return _graph_reject_v1("native-target-object-map-incomplete")
        target_count = target_count + 1
        if target_count != 1:
            return _graph_reject_v1("native-target-duplicate-producer")
        var order_only = false
        var order_count: i64 = 0
        var i: i64 = 1
        while i < rhs.len():
            val operand = rhs[i]
            if operand == "" or operand == "|" or operand == "|@":
                return _graph_reject_v1("native-target-input-unsupported")
            if operand == "||":
                if order_only:
                    return _graph_reject_v1("native-target-order-invalid")
                order_only = true
            elif order_only:
                if operand != stamp_relative:
                    return _graph_reject_v1("native-target-order-unsupported")
                order_count = order_count + 1
                if order_count != 1:
                    return _graph_reject_v1("native-target-order-invalid")
            else:
                if not (operand.ends_with(".o") or operand.ends_with(".obj")):
                    return _graph_reject_v1("native-target-nonobject-input")
                for prior in direct_objects:
                    if prior == operand:
                        return _graph_reject_v1("native-target-duplicate-input")
                direct_objects.push(operand)
            i = i + 1
        if order_only and order_count != 1:
            return _graph_reject_v1("native-target-order-invalid")
    if target_count != 1 or direct_objects.len() != object_relatives.len():
        return _graph_reject_v1("native-target-object-map-incomplete")
    var i: i64 = 0
    while i < object_relatives.len():
        if producer_counts[i] != 1:
            return _graph_reject_v1("native-object-producer-missing")
        var found = false
        for operand in direct_objects:
            if operand == object_relatives[i]: found = true
        if not found:
            return _graph_reject_v1("native-target-object-map-incomplete")
        i = i + 1
    graph

export CLANG_NINJA_GRAPH_FILE_MAX_BYTES_V1
export ClangNinjaGraphObservationV1, observe_clang_ninja_graph_v1
export validate_clang_ninja_target_map_v1
