# Top-level decision made before accepting a CMake/Ninja no-op. The adapter is
# responsible for writing the returned dependency stamp, making the native graph
# observe it, and proving any required action actually ran before publication.
use std.common.crypto.sha256.{sha256_text}
use app.build.clang_policy.evaluator.{ClangPolicyDecisionV1}

struct ClangNativeNoopInputV1:
    policy: ClangPolicyDecisionV1
    native_dependency_installed: bool
    observed_native_stamp_digest: text
    prior_accepted_stamp_digest: text
    prior_accepted_output_digest: text
    observed_output_digest: text
    request_digest: text
    prior_request_digest: text
    request_sequence: i64       # trusted controller, monotonic per target
    prior_request_sequence: i64
    can_force_native_action: bool

struct ClangNativeNoopDecisionV1:
    action: text                 # ADMIT_NOOP | REBUILD_REQUIRED | REJECT
    required_dependency_digest: text
    reason: text

fn _sha256(value: text) -> bool:
    if value.len() != 64:
        return false
    var i = 0
    while i < value.len():
        val c = value[i:i + 1]
        if not ((c >= "0" and c <= "9") or (c >= "a" and c <= "f")):
            return false
        i = i + 1
    true

fn _reject(reason: text) -> ClangNativeNoopDecisionV1:
    ClangNativeNoopDecisionV1("REJECT", "", reason)

pub fn decide_clang_native_noop_v1(
    input: ClangNativeNoopInputV1
) -> ClangNativeNoopDecisionV1:
    """Admit only an exact current policy stamp; otherwise require native work."""
    if input.policy.verdict != "ACCEPT" or
            not _sha256(input.policy.stamp_digest) or
            (input.policy.cache_mode != "strict" and
             input.policy.cache_mode != "complex" and
             input.policy.cache_mode != "none"):
        return _reject("policy-not-admitted")
    if not input.native_dependency_installed:
        return _reject("native-policy-dependency-missing")
    if not _sha256(input.request_digest):
        return _reject("missing-request-identity")
    if input.prior_request_digest != "" and
            not _sha256(input.prior_request_digest):
        return _reject("invalid-prior-request")
    if input.observed_native_stamp_digest != "" and
            not _sha256(input.observed_native_stamp_digest):
        return _reject("invalid-native-stamp")
    if input.prior_accepted_stamp_digest != "" and
            not _sha256(input.prior_accepted_stamp_digest):
        return _reject("invalid-prior-stamp")
    if input.prior_accepted_output_digest != "" and
            not _sha256(input.prior_accepted_output_digest):
        return _reject("invalid-prior-output")
    if input.observed_output_digest != "" and
            not _sha256(input.observed_output_digest):
        return _reject("invalid-observed-output")

    var required = input.policy.stamp_digest
    if input.policy.cache_mode == "none":
        if input.prior_request_sequence < 0 or
                input.request_sequence <= input.prior_request_sequence or
                input.request_digest == input.prior_request_digest:
            return _reject("repeated-request-identity")
        # The invocation identity changes on every explicit build request.
        # This invalidates the enclosing TU/object, not just a header cache.
        required = sha256_text("simple-clang-none-request-v1|" +
            input.policy.stamp_digest + input.request_digest +
            sha256_text("{input.request_sequence}"))
    if input.policy.cache_mode != "none" and
            input.prior_accepted_stamp_digest == input.policy.stamp_digest and
            input.observed_native_stamp_digest == required and
            _sha256(input.prior_accepted_output_digest) and
            input.observed_output_digest == input.prior_accepted_output_digest:
        return ClangNativeNoopDecisionV1("ADMIT_NOOP", required, "exact-current-policy")
    if not input.can_force_native_action:
        return _reject("native-rebuild-unenforceable")
    ClangNativeNoopDecisionV1("REBUILD_REQUIRED", required,
        "fresh-semantic-action-required")

export ClangNativeNoopInputV1, ClangNativeNoopDecisionV1
export decide_clang_native_noop_v1
