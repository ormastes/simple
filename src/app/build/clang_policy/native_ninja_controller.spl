# Compose one admitted policy decision, retained build ownership, Ninja, and
# exact output bytes. The protected caller supplies the policy decision, map
# pin, prior receipt digest, and installed Ninja identity independently.
use app.build.clang_policy.native_noop_gate.{ClangNativeNoopDecisionV1}
use app.build.clang_policy.native_rebuild_barrier.{
    parse_clang_native_object_map_v1,
    begin_clang_native_rebuild_barrier_v1,
    close_clang_native_rebuild_barrier_v1}
use app.build.clang_policy.native_ninja_graph.{observe_clang_ninja_graph_v1}
use app.io.mod.{file_is_regular_no_follow, file_hash_sha256,
    file_read_regular_no_follow_bounded,
    file_read_regular_no_follow_bounded_bytes, process_run_bounded}
use std.common.crypto.sha256.{sha256_u8_hex}

val CLANG_NINJA_OUTPUT_MAX_BYTES_V1: i64 = 134217728
val CLANG_NINJA_LOG_MAX_BYTES_V1: i64 = 4194304

struct ClangNinjaBuildResultV1:
    verdict: text              # REUSED | BUILT | REJECTED
    reason: text
    output_digest: text
    native_graph_digest: text
    output_bytes: [u8]
    native_stdout: text
    native_stderr: text
    native_exit_code: i64

fn _ninja_reject_v1(reason: text, stdout: text,
        stderr: text, code: i64) -> ClangNinjaBuildResultV1:
    ClangNinjaBuildResultV1("REJECTED", reason, "", "", [],
        stdout, stderr, code)

fn _ninja_sha256_v1(value: text) -> bool:
    if value.len() != 64: return false
    for ch in value.chars():
        if not ((ch >= "0" and ch <= "9") or
                (ch >= "a" and ch <= "f")):
            return false
    true

fn _ninja_absolute_path_v1(path: text) -> bool:
    if not path.starts_with("/") or path.len() < 2 or
       path.len() > 4096 or path.ends_with("/") or
       path.contains("//") or path.contains("\n") or
       path.contains("\r") or path.contains("\x00"):
        return false
    for part in path.split("/"):
        if part == "." or part == "..": return false
    true

fn run_clang_ninja_policy_build_v1(
        decision: ClangNativeNoopDecisionV1,
        build_root: text, protected_target: text,
        object_map_wire: text, protected_map_digest: text,
        protected_graph_digest: text,
        prior_accepted_output_digest: text,
        ninja_path: text, protected_ninja_digest: text,
        timeout_ms: i64, output_max_bytes: i64
        ) -> ClangNinjaBuildResultV1:
    """Return locked, byte-captured output only after exact native admission.

    The caller must provide a protected complete object map, approved native
    graph digest, immutable policy decision and prior receipt. Every builder
    must honor the build-root lock. The installed Ninja binary and its
    ancestors must remain immutable through this call.
    A reporting/publishing caller consumes output_bytes, not the old pathname.
    """
    if decision.action != "ADMIT_NOOP" and
       decision.action != "REBUILD_REQUIRED":
        return _ninja_reject_v1("policy-not-admitted", "", "", -1)
    if not _ninja_absolute_path_v1(ninja_path) or
       not file_is_regular_no_follow(ninja_path) or
       not _ninja_sha256_v1(protected_ninja_digest) or
       not _ninja_sha256_v1(protected_graph_digest) or
       file_hash_sha256(ninja_path) != protected_ninja_digest or
       timeout_ms < 1 or timeout_ms > 3600000 or
       output_max_bytes < 1 or
       output_max_bytes > CLANG_NINJA_OUTPUT_MAX_BYTES_V1:
        return _ninja_reject_v1("ninja-or-limits-invalid", "", "", -1)
    val mapping = parse_clang_native_object_map_v1(object_map_wire)
    if not mapping.valid or mapping.target != protected_target:
        return _ninja_reject_v1("protected-object-map-invalid", "", "", -1)
    val lease = begin_clang_native_rebuild_barrier_v1(decision, build_root,
        protected_target, object_map_wire, protected_map_digest,
        protected_graph_digest,
        prior_accepted_output_digest)
    if not lease.ready:
        return _ninja_reject_v1("native-barrier: " + lease.reason,
            "", "", -1)
    var stdout = ""
    var stderr = ""
    var exit_code: i64 = 0
    if lease.requires_native_action:
        val (run_stdout, run_stderr, run_code) = process_run_bounded(ninja_path,
            ["-C", build_root, mapping.accepted_output_relative],
            timeout_ms, CLANG_NINJA_LOG_MAX_BYTES_V1)
        stdout = run_stdout
        stderr = run_stderr
        exit_code = run_code
        if exit_code != 0 or stdout.len() >= CLANG_NINJA_LOG_MAX_BYTES_V1 or
           stderr.len() >= CLANG_NINJA_LOG_MAX_BYTES_V1:
            close_clang_native_rebuild_barrier_v1(lease)
            return _ninja_reject_v1("native-action-failed-or-log-bounded",
                stdout, stderr, exit_code)
        for relative in mapping.object_relatives:
            if not file_is_regular_no_follow(build_root + "/" + relative):
                close_clang_native_rebuild_barrier_v1(lease)
                return _ninja_reject_v1("native-object-not-produced",
                    stdout, stderr, exit_code)
    val stamp_path = build_root + "/" + mapping.stamp_relative
    val stamp = file_read_regular_no_follow_bounded(stamp_path, 128)
    if stamp.is_err() or
       stamp.unwrap() != decision.required_dependency_digest + "\n":
        close_clang_native_rebuild_barrier_v1(lease)
        return _ninja_reject_v1("native-stamp-changed", stdout,
            stderr, exit_code)
    val output_path = build_root + "/" + mapping.accepted_output_relative
    val snapshot = file_read_regular_no_follow_bounded_bytes(output_path,
        output_max_bytes)
    if snapshot.is_err() or snapshot.unwrap().len() == 0:
        close_clang_native_rebuild_barrier_v1(lease)
        return _ninja_reject_v1("accepted-output-unavailable", stdout,
            stderr, exit_code)
    val bytes = snapshot.unwrap()
    val digest = sha256_u8_hex(bytes)
    if not lease.requires_native_action and
       digest != prior_accepted_output_digest:
        close_clang_native_rebuild_barrier_v1(lease)
        return _ninja_reject_v1("accepted-output-changed", stdout,
            stderr, exit_code)
    val final_graph = observe_clang_ninja_graph_v1(build_root)
    if not final_graph.valid or
       final_graph.graph_digest != protected_graph_digest or
       file_hash_sha256(ninja_path) != protected_ninja_digest:
        close_clang_native_rebuild_barrier_v1(lease)
        return _ninja_reject_v1("native-graph-or-tool-changed", stdout,
            stderr, exit_code)
    if not close_clang_native_rebuild_barrier_v1(lease):
        return _ninja_reject_v1("build-owner-release-failed", stdout,
            stderr, exit_code)
    ClangNinjaBuildResultV1(if lease.requires_native_action: "BUILT" else: "REUSED",
        "native-output-captured", digest, protected_graph_digest,
        bytes, stdout, stderr, exit_code)

export CLANG_NINJA_OUTPUT_MAX_BYTES_V1, CLANG_NINJA_LOG_MAX_BYTES_V1
export ClangNinjaBuildResultV1, run_clang_ninja_policy_build_v1
