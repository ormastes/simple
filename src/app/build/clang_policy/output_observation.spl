# Capture one native artifact before a Clang policy no-op decision. The caller
# supplies an authenticated prior acceptance and keeps the returned bytes for
# publication; it must not reopen the original pathname after admission.
use app.io.mod.{file_read_regular_no_follow_bounded_bytes}
use app.build.clang_policy.native_noop_gate.{ClangNativeNoopInputV1,
    ClangNativeNoopDecisionV1, decide_clang_native_noop_v1}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.nogc_sync_mut.io.sffi_common.{is_absolute_path}

val CLANG_NATIVE_OUTPUT_MAX_BYTES_V1: i64 = 134217728

struct ClangNativeObservedNoopV1:
    decision: ClangNativeNoopDecisionV1
    observed_digest: text
    snapshot_bytes: [u8]
    observation_problem: text

fn _output_path_valid_v1(path: text) -> bool:
    if not is_absolute_path(path) or path.len() > 4096 or
       path.contains("\n") or path.contains("\r") or
       path.contains("\x00"):
        return false
    val normalized = path.replace("\\", "/")
    if normalized.ends_with("/") or normalized.contains("//"):
        return false
    for part in normalized.split("/"):
        if part == "." or part == "..": return false
    true

fn _output_observation_reject_v1(reason: text) -> ClangNativeObservedNoopV1:
    ClangNativeObservedNoopV1(
        ClangNativeNoopDecisionV1("REJECT", "", reason), "", [], reason)

fn observe_and_decide_clang_native_noop_v1(
        input: ClangNativeNoopInputV1,
        output_path: text,
        accepted_output_path: text,
        max_bytes: i64) -> ClangNativeObservedNoopV1:
    """Read one exact native output and preserve its admitted byte snapshot.

    Trusted controller must bind accepted_output_path and prior digest to the
    same target/action and hold exclusive build ownership. This V1 adapter
    covers one required artifact; multi-output actions need a full manifest.
    """
    if not _output_path_valid_v1(output_path) or
       not _output_path_valid_v1(accepted_output_path) or
       output_path != accepted_output_path or max_bytes <= 0 or
       max_bytes > CLANG_NATIVE_OUTPUT_MAX_BYTES_V1:
        return _output_observation_reject_v1("output-binding-invalid")
    var observed_input = input
    # A caller-provided digest cannot stand in for a current byte observation.
    observed_input.observed_output_digest = ""
    val read = file_read_regular_no_follow_bounded_bytes(output_path,
        max_bytes)
    if read.is_err() or read.unwrap().len() == 0:
        val decision = decide_clang_native_noop_v1(observed_input)
        return ClangNativeObservedNoopV1(decision, "", [],
            "output-unreadable-or-empty")
    val bytes = read.unwrap()
    val digest = sha256_u8_hex(bytes)
    observed_input.observed_output_digest = digest
    val decision = decide_clang_native_noop_v1(observed_input)
    if decision.action == "ADMIT_NOOP":
        return ClangNativeObservedNoopV1(decision, digest, bytes, "")
    ClangNativeObservedNoopV1(decision, digest, [], "")

export CLANG_NATIVE_OUTPUT_MAX_BYTES_V1, ClangNativeObservedNoopV1
export observe_and_decide_clang_native_noop_v1
