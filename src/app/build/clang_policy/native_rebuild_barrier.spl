# Owner-held invalidation barrier for CMake/Ninja objects. A protected map
# binds one target, one stamp and the complete set of its object files. The
# lease must stay open through native execution and result acceptance.
use app.build.clang_policy.native_noop_gate.{ClangNativeNoopDecisionV1}
use app.build.clang_policy.stamp_writer.{write_clang_native_stamp_v1}
use app.build.clang_policy.native_ninja_graph.{validate_clang_ninja_target_map_v1}
use app.io.mod.{is_dir, file_exists, file_is_regular_no_follow,
    file_create_exclusive, file_delete, file_hash_sha256,
    file_lock, file_unlock}
use std.nogc_sync_mut.sffi.io.{path_absolute}
use std.common.crypto.sha256.{sha256_text}

val CLANG_NATIVE_OBJECT_MAP_MAX_BYTES_V1: i64 = 65536
val CLANG_NATIVE_OBJECT_MAP_MAX_FILES_V1: i64 = 256

struct ClangNativeObjectMapV1:
    valid: bool
    reason: text
    target: text
    stamp_relative: text
    accepted_output_relative: text
    object_relatives: [text]

class ClangNativeRebuildLeaseV1:
    ready: bool
    reason: text
    required_digest: text
    requires_native_action: bool
    invalidated_count: i64
    lock_handle: i64

    me close() -> bool:
        if self.lock_handle < 0 or not self.ready: return false
        val released = file_unlock(self.lock_handle)
        self.lock_handle = -1
        self.ready = false
        released

fn _object_map_reject_v1(reason: text) -> ClangNativeObjectMapV1:
    ClangNativeObjectMapV1(false, reason, "", "", "", [])

fn _native_barrier_reject_v1(reason: text) -> ClangNativeRebuildLeaseV1:
    ClangNativeRebuildLeaseV1(false, reason, "", false, 0, -1)

fn _native_build_root_v1(path: text) -> bool:
    if not path.starts_with("/") or path.len() < 2 or
       path.len() > 4096 or path.ends_with("/") or path.contains("//") or
       path.contains("\n") or path.contains("\r") or
       path.contains("\x00"):
        return false
    for part in path.split("/"):
        if part == "." or part == "..": return false
    true

fn _native_relative_v1(path: text) -> bool:
    if path == "" or path.len() > 1024 or path.starts_with("/") or
       path.ends_with("/") or path.contains("//") or path.contains("\\"):
        return false
    for part in path.split("/"):
        if part == "" or part == "." or part == ".." or
           part.starts_with("-") or part.len() > 128:
            return false
        for ch in part.chars():
            if (ch >= "a" and ch <= "z") or
               (ch >= "A" and ch <= "Z") or
               (ch >= "0" and ch <= "9") or
               ch == "_" or ch == "-" or ch == "." or ch == "+" or
               ch == "@":
                continue
            return false
    true

fn parse_clang_native_object_map_v1(wire: text) -> ClangNativeObjectMapV1:
    """Require one canonical protected target map with ordered unique objects."""
    if wire.len() == 0 or wire.len() > CLANG_NATIVE_OBJECT_MAP_MAX_BYTES_V1 or
       not wire.ends_with("\n") or wire.contains("\r") or
       wire.contains("\x00"):
        return _object_map_reject_v1("object-map-wire-invalid")
    val lines = wire[0:wire.len() - 1].split("\n")
    if lines.len() < 6 or lines.len() > CLANG_NATIVE_OBJECT_MAP_MAX_FILES_V1 + 5 or
       lines[0] != "simple-clang-native-object-map-v1" or
       not lines[1].starts_with("target=") or
       not lines[2].starts_with("stamp=") or
       not lines[3].starts_with("accepted-output=") or
       not lines[4].starts_with("object-count="):
        return _object_map_reject_v1("object-map-shape-invalid")
    val target = lines[1][7:]
    val stamp = lines[2][6:]
    val accepted_output = lines[3][16:]
    val count_text = lines[4][13:]
    if target == "" or target.len() > 128 or
       not _native_relative_v1(target) or target.contains("/") or
       not _native_relative_v1(stamp) or not stamp.ends_with(".stamp") or
       not _native_relative_v1(accepted_output) or
       accepted_output == stamp or
       count_text == "" or count_text.len() > 3:
        return _object_map_reject_v1("object-map-fields-invalid")
    for ch in count_text.chars():
        if ch < "0" or ch > "9":
            return _object_map_reject_v1("object-map-count-invalid")
    val count = count_text.to_i64() ?? -1
    if count < 1 or count > CLANG_NATIVE_OBJECT_MAP_MAX_FILES_V1 or
       count.to_text() != count_text or lines.len() != count + 5:
        return _object_map_reject_v1("object-map-count-invalid")
    var objects: [text] = []
    var prior = ""
    var i: i64 = 5
    while i < lines.len():
        if not lines[i].starts_with("object="):
            return _object_map_reject_v1("object-map-row-invalid")
        val path = lines[i][7:]
        if not _native_relative_v1(path) or
           not (path.ends_with(".o") or path.ends_with(".obj")) or
           (prior != "" and path <= prior) or path == stamp or
           path == accepted_output:
            return _object_map_reject_v1("object-map-object-invalid")
        objects.push(path)
        prior = path
        i = i + 1
    ClangNativeObjectMapV1(true, "", target, stamp,
        accepted_output, objects)

fn _native_parents_unredirected_v1(root: text, relative: text) -> bool:
    # This detects ordinary symlinked ancestors on POSIX. The current
    # path_absolute ABI can fall back to the input on realpath failure, so
    # this is not yet a hostile-filesystem admission proof.
    if not is_dir(root): return false
    val root_resolved = unsafe(capabilities: [ffi]):
        path_absolute(root)
    if root_resolved != root: return false
    val parts = relative.split("/")
    var prefix = root
    var i: i64 = 0
    while i + 1 < parts.len():
        prefix = prefix + "/" + parts[i]
        if not is_dir(prefix): return false
        val resolved = unsafe(capabilities: [ffi]):
            path_absolute(prefix)
        if resolved != prefix: return false
        i = i + 1
    true

fn _prove_object_absent_v1(path: text) -> bool:
    # Exclusive create distinguishes a missing entry from a dangling symlink;
    # file_exists alone follows the symlink and would misreport absence.
    if not file_create_exclusive(path, ""): return false
    if not file_is_regular_no_follow(path): return false
    file_delete(path) and not file_exists(path)

fn begin_clang_native_rebuild_barrier_v1(decision: ClangNativeNoopDecisionV1,
        build_root: text, protected_target: text,
        object_map_wire: text, protected_map_digest: text,
        protected_graph_digest: text,
        prior_accepted_output_digest: text
        ) -> ClangNativeRebuildLeaseV1:
    """Hold build ownership until caller completes Ninja and accepts output.

    The caller supplies map and graph digests from independently protected policy and
    ensures every permitted builder honors this lock. Candidate input must
    never select build_root, target or the approved map digest.
    """
    if decision.action != "ADMIT_NOOP" and
       decision.action != "REBUILD_REQUIRED":
        return _native_barrier_reject_v1("policy-not-admitted")
    if not _native_build_root_v1(build_root) or not is_dir(build_root) or
       not _native_relative_v1(protected_target) or
       protected_target.contains("/") or
       protected_map_digest.len() != 64 or
       protected_graph_digest.len() != 64 or
       sha256_text(object_map_wire) != protected_map_digest:
        return _native_barrier_reject_v1("protected-object-map-mismatch")
    val mapping = parse_clang_native_object_map_v1(object_map_wire)
    if not mapping.valid or mapping.target != protected_target:
        return _native_barrier_reject_v1("protected-object-map-invalid")
    val lock = file_lock(build_root + "/.simple-clang-build.lock", 1)
    if lock < 0:
        return _native_barrier_reject_v1("build-owner-unavailable")
    if not _native_parents_unredirected_v1(build_root,
            mapping.stamp_relative) or
       not _native_parents_unredirected_v1(build_root,
            mapping.accepted_output_relative):
        file_unlock(lock)
        return _native_barrier_reject_v1("build-path-ancestor-redirected")
    for relative in mapping.object_relatives:
        if not _native_parents_unredirected_v1(build_root, relative):
            file_unlock(lock)
            return _native_barrier_reject_v1("build-path-ancestor-redirected")
    val graph = validate_clang_ninja_target_map_v1(build_root,
        mapping.accepted_output_relative, mapping.stamp_relative,
        mapping.object_relatives)
    if not graph.valid or graph.graph_digest != protected_graph_digest:
        file_unlock(lock)
        return _native_barrier_reject_v1("native-graph-unapproved")
    val stamp_path = build_root + "/" + mapping.stamp_relative
    val output_path = build_root + "/" + mapping.accepted_output_relative
    # Validate the entire map before the stamp or any existing object changes.
    # Exclusive creation also catches dangling symlinks that file_exists misses.
    if decision.action == "REBUILD_REQUIRED":
        if not file_is_regular_no_follow(stamp_path) and
           not _prove_object_absent_v1(stamp_path):
            file_unlock(lock)
            return _native_barrier_reject_v1("native-stamp-not-regular")
        if not file_is_regular_no_follow(output_path) and
           not _prove_object_absent_v1(output_path):
            file_unlock(lock)
            return _native_barrier_reject_v1("accepted-output-not-regular")
        for relative in mapping.object_relatives:
            val object_path = build_root + "/" + relative
            if not file_is_regular_no_follow(object_path) and
               not _prove_object_absent_v1(object_path):
                file_unlock(lock)
                return _native_barrier_reject_v1("object-not-regular")
    val stamped = write_clang_native_stamp_v1(decision, stamp_path)
    if not stamped.ready:
        file_unlock(lock)
        return _native_barrier_reject_v1("native-stamp: " + stamped.reason)
    if decision.action == "ADMIT_NOOP":
        if prior_accepted_output_digest.len() != 64 or
           not file_is_regular_no_follow(output_path) or
           file_hash_sha256(output_path) != prior_accepted_output_digest:
            file_unlock(lock)
            return _native_barrier_reject_v1("accepted-output-changed")
        for relative in mapping.object_relatives:
            if not file_is_regular_no_follow(build_root + "/" + relative):
                file_unlock(lock)
                return _native_barrier_reject_v1("native-object-unavailable")
        return ClangNativeRebuildLeaseV1(true, "exact-current-policy",
            stamped.required_digest, false, 0, lock)
    var removed: i64 = 0
    for relative in mapping.object_relatives:
        val object_path = build_root + "/" + relative
        if file_is_regular_no_follow(object_path):
            if not file_delete(object_path):
                file_unlock(lock)
                return _native_barrier_reject_v1("object-invalidation-failed")
            removed = removed + 1
        elif file_exists(object_path):
            file_unlock(lock)
            return _native_barrier_reject_v1("object-not-regular")
        if not _prove_object_absent_v1(object_path):
            file_unlock(lock)
            return _native_barrier_reject_v1("object-absence-unverified")
    # A future-dated prior output could otherwise let Ninja report no work
    # despite the forced object invalidation. It also must not retain a hardlink.
    if file_is_regular_no_follow(output_path):
        if not file_delete(output_path):
            file_unlock(lock)
            return _native_barrier_reject_v1("accepted-output-invalidation-failed")
    if not _prove_object_absent_v1(output_path):
        file_unlock(lock)
        return _native_barrier_reject_v1("accepted-output-absence-unverified")
    ClangNativeRebuildLeaseV1(true, "native-output-and-objects-invalidated",
        stamped.required_digest, true, removed, lock)

fn close_clang_native_rebuild_barrier_v1(
        lease: ClangNativeRebuildLeaseV1) -> bool:
    lease.close()

export CLANG_NATIVE_OBJECT_MAP_MAX_BYTES_V1
export CLANG_NATIVE_OBJECT_MAP_MAX_FILES_V1
export ClangNativeObjectMapV1, ClangNativeRebuildLeaseV1
export parse_clang_native_object_map_v1
export begin_clang_native_rebuild_barrier_v1
export close_clang_native_rebuild_barrier_v1
