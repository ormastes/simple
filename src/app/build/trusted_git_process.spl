# Run repository admission Git commands without inherited Git configuration,
# credential helpers, aliases or transport rewrites. The fixed POSIX paths
# are a qualified host adapter; an unavailable path fails closed.
use app.io.mod.{process_run_bounded}

fn run_isolated_build_git_v1(args: [text], timeout_ms: i64,
        output_max: i64) -> (text, text, i64):
    if args.len() == 0 or args.len() > 64 or timeout_ms <= 0 or
       timeout_ms > 300000 or output_max <= 0 or output_max > 33554432:
        return ("", "isolated-git-arguments-invalid", -1)
    var full: [text] = ["-i", "PATH=/usr/bin:/bin", "HOME=/dev/null",
        "XDG_CONFIG_HOME=/dev/null", "GIT_CONFIG_NOSYSTEM=1",
        "GIT_CONFIG_SYSTEM=/dev/null", "GIT_CONFIG_GLOBAL=/dev/null",
        "GIT_CONFIG_COUNT=0", "GIT_TERMINAL_PROMPT=0",
        "GIT_ASKPASS=/bin/false", "/usr/bin/git"]
    for arg in args:
        if arg.len() == 0 or arg.len() > 8192 or arg.contains("\x00"):
            return ("", "isolated-git-argument-invalid", -1)
        full.push(arg)
    process_run_bounded("/usr/bin/env", full, timeout_ms, output_max)

export run_isolated_build_git_v1
