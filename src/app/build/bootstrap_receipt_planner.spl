# Bootstrap authorization receipt planner.
# Kept independent from the native-build CLI closure so a bootstrap seed can
# emit a diagnostic authorization leaf without parsing the compiler being rebuilt.

use app.io.mod.{file_write}
use app.build.targets.bootstrap_policy.{
    BOOTSTRAP_STAGE4_TARGET_V2, bootstrap_reason_from_name,
    bootstrap_reason_is_explicit, bootstrap_authorization_receipt_v2
}

pub fn normalize_bootstrap_receipt_args(args: [text]) -> [text]:
    """Strip only the seed runner's bootstrap receipt entry path."""
    if args.len() > 0:
        if args[0].ends_with("src/app/build/bootstrap_receipt_main.spl"):
            return args[1:]
        if args[0].ends_with("src\\app\\build\\bootstrap_receipt_main.spl"):
            return args[1:]
    args

pub fn plan_bootstrap_authorization(args: [text]) -> i64:
    """Emit authorization only; this function never starts a bootstrap stage."""
    var reason_name = ""
    var receipt_path = ""
    var bootstrap_target = BOOTSTRAP_STAGE4_TARGET_V2
    var parent_sha = ""
    var runtime_sha = ""
    var closure_sha = ""
    var planner_sha = ""
    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg.starts_with("--bootstrap-reason="):
            reason_name = arg[19:]
        elif arg.starts_with("--bootstrap-receipt="):
            receipt_path = arg[20:]
        elif arg.starts_with("--bootstrap-target="):
            bootstrap_target = arg[19:]
        elif arg.starts_with("--parent-compiler-sha256="):
            parent_sha = arg[25:]
        elif arg.starts_with("--runtime-snapshot-sha256="):
            runtime_sha = arg[26:]
        elif arg.starts_with("--planner-source-closure-sha256="):
            closure_sha = arg[32:]
        elif arg.starts_with("--planner-sha256="):
            planner_sha = arg[17:]
        else:
            print("bootstrap-policy-error: unsupported-planner-argument: " + arg)
            return 2
        i = i + 1
    val reason = bootstrap_reason_from_name(reason_name)
    if not bootstrap_reason_is_explicit(reason):
        print("bootstrap-policy-error: typed-reason-required; use --bootstrap-reason=<typed-reason>")
        return 2
    if receipt_path.trim().len() == 0:
        print("bootstrap-policy-error: receipt-path-required; use --bootstrap-receipt=<path>")
        return 2
    val receipt = bootstrap_authorization_receipt_v2(
        bootstrap_target, reason, parent_sha, runtime_sha, closure_sha, planner_sha
    )
    if receipt.len() == 0 or not file_write(receipt_path, receipt + "\n"):
        print("bootstrap-policy-error: receipt-write-failed: " + receipt_path)
        return 2
    print("bootstrap-plan: execution=not-attempted receipt=" + receipt_path + " reason=" + reason_name)
    0
