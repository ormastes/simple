# Canonical, bounded text envelope for SignedBuildReceiptV1. A caller must
# verify the signature over signed_build_receipt_digest_v1 before admission.
use app.build.signed_build_admission.{
    SIGNED_BUILD_RECEIPT_SCHEMA_V1, SignedBuildReceiptV1,
    SIGNED_BUILD_RECEIPT_SCHEMA_V2, SignedBuildReceiptV2,
    signed_build_repository_valid_v2
}

val SIGNED_BUILD_WIRE_MAX_LENGTH_V1 = 4096

fn _wire_keys_v1() -> [text]:
    [
        "schema", "base_revision", "head_revision", "candidate_tree",
        "target_id", "execution_platform", "output_target",
        "toolchain_digest", "action_digest", "input_manifest_digest",
        "submodule_closure_digest", "protected_policy_digest", "checker_digest",
        "mandatory_gate_receipt_digest", "artifact_digest", "artifact_length",
        "artifact_locator", "signer_id", "signer_scope", "issued_at_utc",
        "expires_at_utc"
    ]

fn _wire_values_v1(receipt: SignedBuildReceiptV1) -> [text]:
    [
        receipt.schema, receipt.base_revision, receipt.head_revision,
        receipt.candidate_tree, receipt.target_id, receipt.execution_platform,
        receipt.output_target, receipt.toolchain_digest, receipt.action_digest,
        receipt.input_manifest_digest, receipt.submodule_closure_digest,
        receipt.protected_policy_digest, receipt.checker_digest,
        receipt.mandatory_gate_receipt_digest, receipt.artifact_digest,
        receipt.artifact_length.to_text(), receipt.artifact_locator,
        receipt.signer_id, receipt.signer_scope, receipt.issued_at_utc,
        receipt.expires_at_utc
    ]

fn _wire_scalar_v1(value: text) -> bool:
    if value.len() == 0 or value.len() > 512 or value != value.trim():
        return false
    var i = 0
    while i < value.len():
        val ch = value[i:i + 1]
        if ch < " " or ch > "~" or ch == "|":
            return false
        i = i + 1
    true

fn _wire_hex_v1(value: text, allow_sha1: bool) -> bool:
    if value.len() != 64 and (not allow_sha1 or value.len() != 40):
        return false
    var i = 0
    while i < value.len():
        val ch = value[i:i + 1]
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return false
        i = i + 1
    true

fn _wire_timestamp_v1(value: text) -> bool:
    if value.len() != 20 or value[4:5] != "-" or value[7:8] != "-" or
            value[10:11] != "T" or value[13:14] != ":" or
            value[16:17] != ":" or value[19:20] != "Z":
        return false
    var i = 0
    while i < value.len():
        if i != 4 and i != 7 and i != 10 and i != 13 and i != 16 and i != 19:
            val ch = value[i:i + 1]
            if ch < "0" or ch > "9":
                return false
        i = i + 1
    val year = value[0:4].to_i64() ?? 0
    val month = value[5:7].to_i64() ?? 0
    val day = value[8:10].to_i64() ?? 0
    val hour = value[11:13].to_i64() ?? -1
    val minute = value[14:16].to_i64() ?? -1
    val second = value[17:19].to_i64() ?? -1
    if year <= 0 or month < 1 or month > 12 or day < 1 or
            hour < 0 or hour > 23 or minute < 0 or minute > 59 or
            second < 0 or second > 59:
        return false
    val leap = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
    val days = if month == 2: (if leap: 29 else: 28)
        elif month == 4 or month == 6 or month == 9 or month == 11: 30
        else: 31
    day <= days

fn _wire_values_valid_v1(values: [text]) -> bool:
    if values.len() != 21 or values[0] != SIGNED_BUILD_RECEIPT_SCHEMA_V1:
        return false
    var i = 0
    while i < values.len():
        if not _wire_scalar_v1(values[i]):
            return false
        i = i + 1
    if not _wire_hex_v1(values[1], true) or
            not _wire_hex_v1(values[2], true) or
            not _wire_hex_v1(values[3], true):
        return false
    i = 7
    while i <= 14:
        if not _wire_hex_v1(values[i], false):
            return false
        i = i + 1
    val artifact_length = values[15].to_i64() ?? 0
    if artifact_length <= 0 or artifact_length.to_text() != values[15]:
        return false
    _wire_timestamp_v1(values[19]) and _wire_timestamp_v1(values[20]) and
        values[19] < values[20]

fn signed_build_receipt_wire_v1(receipt: SignedBuildReceiptV1) -> text:
    """Serialize validated receipt fields in the one accepted V1 wire form."""
    val values = _wire_values_v1(receipt)
    if not _wire_values_valid_v1(values):
        return ""
    val keys = _wire_keys_v1()
    var payload = ""
    var i = 0
    while i < keys.len():
        payload = payload + keys[i] + "=" + values[i] + "\n"
        i = i + 1
    if payload.len() > SIGNED_BUILD_WIRE_MAX_LENGTH_V1:
        return ""
    payload

fn parse_signed_build_receipt_wire_v1(payload: text) -> Option<SignedBuildReceiptV1>:
    """Reject noncanonical, extra, missing, malformed or oversized fields."""
    if payload.len() == 0 or payload.len() > SIGNED_BUILD_WIRE_MAX_LENGTH_V1 or
            not payload.ends_with("\n") or payload.contains("\r"):
        return nil
    val lines = payload[0:payload.len() - 1].split("\n")
    val keys = _wire_keys_v1()
    if lines.len() != keys.len():
        return nil
    var values: [text] = []
    var i = 0
    while i < keys.len():
        val prefix = keys[i] + "="
        if not lines[i].starts_with(prefix):
            return nil
        values.push(lines[i][prefix.len():])
        i = i + 1
    if not _wire_values_valid_v1(values):
        return nil
    val receipt = SignedBuildReceiptV1(
        schema: values[0], base_revision: values[1], head_revision: values[2],
        candidate_tree: values[3], target_id: values[4],
        execution_platform: values[5], output_target: values[6],
        toolchain_digest: values[7], action_digest: values[8],
        input_manifest_digest: values[9], submodule_closure_digest: values[10],
        protected_policy_digest: values[11], checker_digest: values[12],
        mandatory_gate_receipt_digest: values[13], artifact_digest: values[14],
        artifact_length: values[15].to_i64() ?? 0,
        artifact_locator: values[16], signer_id: values[17],
        signer_scope: values[18], issued_at_utc: values[19],
        expires_at_utc: values[20]
    )
    if signed_build_receipt_wire_v1(receipt) != payload:
        return nil
    Some(receipt)

export SIGNED_BUILD_WIRE_MAX_LENGTH_V1
export signed_build_receipt_wire_v1, parse_signed_build_receipt_wire_v1

val SIGNED_BUILD_WIRE_MAX_LENGTH_V2 = 4608

fn signed_build_receipt_wire_v2(receipt: SignedBuildReceiptV2) -> text:
    """Canonical V2 wire binds repository/PR before the existing build fields."""
    if receipt.schema != SIGNED_BUILD_RECEIPT_SCHEMA_V2 or
            not signed_build_repository_valid_v2(receipt.repository_full_name) or
            receipt.pull_request_number <= 0:
        return ""
    val build_wire = signed_build_receipt_wire_v1(receipt.build)
    if build_wire == "":
        return ""
    val prefix = "schema=" + SIGNED_BUILD_RECEIPT_SCHEMA_V1 + "\n"
    val wire = "schema=" + SIGNED_BUILD_RECEIPT_SCHEMA_V2 + "\n" +
        "repository_full_name=" + receipt.repository_full_name + "\n" +
        "pull_request_number=" + receipt.pull_request_number.to_text() + "\n" +
        build_wire[prefix.len():]
    if wire.len() > SIGNED_BUILD_WIRE_MAX_LENGTH_V2:
        return ""
    wire

fn parse_signed_build_receipt_wire_v2(payload: text) -> Option<SignedBuildReceiptV2>:
    """Strict V2 parser; V1 payloads cannot enter this admission path."""
    val prefix = "schema=" + SIGNED_BUILD_RECEIPT_SCHEMA_V2 + "\n"
    if payload.len() > SIGNED_BUILD_WIRE_MAX_LENGTH_V2 or
            not payload.starts_with(prefix) or not payload.ends_with("\n") or
            payload.contains("\r"):
        return nil
    val lines = payload[0:payload.len() - 1].split("\n")
    if lines.len() != 23 or
            not lines[1].starts_with("repository_full_name=") or
            not lines[2].starts_with("pull_request_number="):
        return nil
    val repository = lines[1][21:]
    val number_text = lines[2][20:]
    val number = number_text.to_i64() ?? 0
    if not signed_build_repository_valid_v2(repository) or number <= 0 or
            number.to_text() != number_text:
        return nil
    val offset = prefix.len() + lines[1].len() + lines[2].len() + 2
    val build_wire = "schema=" + SIGNED_BUILD_RECEIPT_SCHEMA_V1 + "\n" + payload[offset:]
    if val build = parse_signed_build_receipt_wire_v1(build_wire):
        val receipt = SignedBuildReceiptV2(SIGNED_BUILD_RECEIPT_SCHEMA_V2,
            repository, number, build)
        if signed_build_receipt_wire_v2(receipt) == payload:
            return Some(receipt)
    nil

export SIGNED_BUILD_WIRE_MAX_LENGTH_V2
export signed_build_receipt_wire_v2, parse_signed_build_receipt_wire_v2
