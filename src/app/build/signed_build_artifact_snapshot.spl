# Copy a downloaded artifact into a private controller-owned directory before
# verifying it. The caller must own both source and destination directories;
# only the returned snapshot path may be handed to a consuming build job.
use app.io.mod.{secure_temp_dir, dir_remove_all, directory_fsync,
    file_is_regular_no_follow, file_size_raw, file_copy, file_fsync,
    file_hash_sha256}

val SIGNED_BUILD_PRIVATE_MAX_BYTES_V2: i64 = 1073741824

struct SignedBuildPrivateArtifactV2:
    ready: bool
    reason: text
    snapshot_root: text
    snapshot_path: text
    digest: text
    length: i64

fn _private_snapshot_reject_v2(reason: text,
        root: text) -> SignedBuildPrivateArtifactV2:
    if root != "" and not dir_remove_all(root):
        return SignedBuildPrivateArtifactV2(false, reason + "-cleanup-failed",
            root, "", "", 0)
    SignedBuildPrivateArtifactV2(false, reason, "", "", "", 0)

fn _private_snapshot_path_v2(path: text) -> bool:
    path.starts_with("/") and path.len() > 1 and path.len() <= 4096 and
        not path.ends_with("/") and not path.contains("//") and
        not path.contains("\n") and not path.contains("\r") and
        not path.split("/").contains(".") and
        not path.split("/").contains("..")

fn snapshot_signed_build_artifact_v2(source_path: text,
        private_parent: text, max_bytes: i64) -> SignedBuildPrivateArtifactV2:
    """Return a durable private copy, bounded and hashed from the copied bytes."""
    if not _private_snapshot_path_v2(source_path) or
       not _private_snapshot_path_v2(private_parent) or
       max_bytes <= 0 or max_bytes > SIGNED_BUILD_PRIVATE_MAX_BYTES_V2 or
       not file_is_regular_no_follow(source_path):
        return _private_snapshot_reject_v2("source-or-policy-invalid", "")
    val source_size = file_size_raw(source_path)
    if source_size <= 0 or source_size > max_bytes:
        return _private_snapshot_reject_v2("source-size-invalid", "")
    val created = secure_temp_dir(private_parent, "signed-build-artifact")
    if created.is_err():
        return _private_snapshot_reject_v2("snapshot-directory-unavailable", "")
    val root = created.unwrap()
    val output = root + "/artifact"
    if not directory_fsync(private_parent) or
       not file_copy(source_path, output):
        return _private_snapshot_reject_v2("snapshot-copy-failed", root)
    val copied_size = file_size_raw(output)
    if not file_is_regular_no_follow(output) or copied_size <= 0 or
       copied_size > max_bytes or copied_size != source_size:
        return _private_snapshot_reject_v2("snapshot-size-invalid", root)
    val digest = file_hash_sha256(output)
    if digest.len() != 64 or not file_fsync(output) or
       not directory_fsync(root):
        return _private_snapshot_reject_v2("snapshot-not-durable", root)
    SignedBuildPrivateArtifactV2(true, "", root, output, digest, copied_size)

export SIGNED_BUILD_PRIVATE_MAX_BYTES_V2, SignedBuildPrivateArtifactV2
export snapshot_signed_build_artifact_v2
