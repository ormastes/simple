# Exact-pin Git adapter for a selected parent tree. Each remote fetch uses a
# fresh private repository and an explicit, policy-declared URL and SHA.
use app.io.mod.{file_read, dir_remove_all, dir_create_all}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir}
use app.build.trusted_git_process.{run_isolated_build_git_v1}
use app.build.submodule_inventory.{
    SelectedGitlinkV1, SubmoduleDeclarationV1, SubmodulePolicyV1,
    PinReachabilityV1, SubmoduleExceptionV1, SubmoduleInventoryV1,
    selected_submodule_inventory_v1, submodule_branch_ref_valid_v1
}

val SUBMODULE_GIT_TIMEOUT_MS = 15000
val SUBMODULE_GIT_OUTPUT_MAX = 33554432
val SUBMODULE_REMOTE_OUTPUT_MAX = 262144

struct SubmoduleGitProbeV1:
    status: text
    reason: text
    parent_tree: text
    inventory: SubmoduleInventoryV1
    observations: [PinReachabilityV1]

struct _RemotePinEvidenceV1:
    verified: bool
    branch_tip: text

fn _reject_git_probe(reason: text) -> SubmoduleGitProbeV1:
    SubmoduleGitProbeV1("REJECT", reason, "",
        SubmoduleInventoryV1("REJECT", reason, []), [])

fn _hex_oid(value: text) -> bool:
    if value.len() != 40 and value.len() != 64:
        return false
    var i = 0
    while i < value.len():
        val ch = value[i:i + 1]
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return false
        i = i + 1
    true

fn _safe_git_path(path: text) -> bool:
    if path == "" or path.starts_with("/") or path.starts_with("./") or
            path.contains("..") or path.contains("\\") or
            path.contains("\n") or path.contains("\r") or
            path.contains("\t") or path.contains("|"):
        return false
    true

fn _git(repo: text, args: [text], output_max: i64) -> (text, text, i64):
    # A local replace ref must never substitute a different tree for the
    # caller's exact parent SHA or a different object for the fetched pin.
    var full: [text] = ["--no-replace-objects", "-C", repo]
    var i = 0
    while i < args.len():
        full.push(args[i])
        i = i + 1
    run_isolated_build_git_v1(full, SUBMODULE_GIT_TIMEOUT_MS, output_max)

# Require an exact complete output. The bounded process facade may truncate
# stdout while the child exits 0, so output at the cap is never accepted.
fn _complete(out: text, code: i64, cap: i64) -> bool:
    code == 0 and out.len() < cap

fn parse_parent_gitlinks_v1(tree_listing: text) -> [SelectedGitlinkV1]:
    """Parse mode-160000 entries from complete `git ls-tree -r` output."""
    var links: [SelectedGitlinkV1] = []
    val lines = tree_listing.split("\n")
    var i = 0
    while i < lines.len():
        val line = lines[i]
        if line != "":
            val fields = line.split("\t")
            if fields.len() != 2:
                return []
            val meta = fields[0].split(" ")
            if meta.len() != 3:
                return []
            if meta[0] == "160000":
                if meta[1] != "commit" or not _hex_oid(meta[2]) or
                        not _safe_git_path(fields[1]):
                    return []
                links.push(SelectedGitlinkV1(fields[1], meta[2]))
        i = i + 1
    links

fn submodule_remote_tree_has_nested_or_invalid_v1(tree_listing: text) -> bool:
    """Reject a fetched pin with nested gitlinks or malformed tree output.

    V1 policy has no transitive pin rows. A clean top-level fetch alone must
    not claim full selected closure when the fetched commit selects children.
    """
    if tree_listing == "" or tree_listing.len() >= SUBMODULE_GIT_OUTPUT_MAX:
        return true
    val lines = tree_listing.split("\n")
    for line in lines:
        if line == "": continue
        val fields = line.split("\t")
        if fields.len() != 2 or fields[1] == "": return true
        val meta = fields[0].split(" ")
        if meta.len() != 3 or not _hex_oid(meta[2]): return true
        if meta[0] == "160000": return true
        if meta[1] != "blob" or
           not ["100644", "100755", "120000"].contains(meta[0]):
            return true
    false

fn parse_parent_gitmodules_v1(source: text) -> [SubmoduleDeclarationV1]:
    """Extract path and URL pairs from Git's tree-owned .gitmodules text."""
    var declarations: [SubmoduleDeclarationV1] = []
    var path = ""
    var url = ""
    var active = false
    var bad = false
    val lines = source.split("\n")
    var i = 0
    while i < lines.len():
        val line = lines[i].trim()
        if line.starts_with("[submodule "):
            if active:
                if not _safe_git_path(path) or url == "":
                    bad = true
                else:
                    declarations.push(SubmoduleDeclarationV1(path, url))
            active = true
            path = ""
            url = ""
        elif active and not line.starts_with("#") and not line.starts_with(";"):
            val fields = line.split("=")
            if fields.len() == 2:
                val key = fields[0].trim()
                val value = fields[1].trim()
                if key == "path":
                    if path != "":
                        bad = true
                    path = value
                elif key == "url":
                    if url != "":
                        bad = true
                    url = value
        i = i + 1
    if active:
        if not _safe_git_path(path) or url == "":
            bad = true
        else:
            declarations.push(SubmoduleDeclarationV1(path, url))
    if bad:
        return []
    declarations

fn _policy_row(path: text, pin: text, url: text, role: text,
        required: text, provenance: text, canary: text,
        approved_branch: text) -> SubmodulePolicyV1:
    SubmodulePolicyV1(path, pin, url, role, required == "true", provenance,
        canary, approved_branch)

fn _policy_fields_valid(pin: text, url: text, role: text,
        required: text, provenance: text, canary: text,
        approved_branch: text, reachability: text,
        fetch_by_default: text) -> bool:
    _hex_oid(pin) and url != "" and role != "" and
        (required == "true" or required == "false") and
        provenance != "" and canary != "" and
        submodule_branch_ref_valid_v1(approved_branch) and
        (reachability == "" or reachability == "unverified") and
        (fetch_by_default == "" or fetch_by_default == required)

fn parse_submodule_policy_v1(source: text) -> [SubmodulePolicyV1]:
    """Read the selected_submodule rows in the bounded repository policy."""
    var policies: [SubmodulePolicyV1] = []
    var path = ""
    var pin = ""
    var url = ""
    var role = ""
    var required = ""
    var provenance = ""
    var canary = ""
    var approved_branch = ""
    var reachability = ""
    var fetch_by_default = ""
    var seen_keys: [text] = []
    var bad = false
    val lines = source.split("\n")
    var i = 0
    while i < lines.len():
        val line = lines[i].trim()
        if line == "" or line.starts_with("#"):
            i = i + 1
            continue
        if line.starts_with("selected_submodule ") and line.ends_with(":"):
            if path != "":
                if not _policy_fields_valid(pin, url, role, required,
                        provenance, canary, approved_branch, reachability,
                        fetch_by_default):
                    bad = true
                else:
                    policies.push(_policy_row(path, pin, url, role, required,
                        provenance, canary, approved_branch))
            path = line[19:line.len() - 1]
            pin = ""
            url = ""
            role = ""
            required = ""
            provenance = ""
            canary = ""
            approved_branch = ""
            reachability = ""
            fetch_by_default = ""
            seen_keys = []
            if not _safe_git_path(path):
                bad = true
        elif path != "":
            val fields = line.split(":")
            if fields.len() < 2:
                bad = true
            else:
                val key = fields[0].trim()
                val value = line[fields[0].len() + 1:line.len()].trim()
                if fields[0] != key or value == "" or seen_keys.contains(key):
                    bad = true
                else:
                    seen_keys.push(key)
                    if key == "pin":
                        pin = value
                    elif key == "url":
                        url = value
                    elif key == "role":
                        role = value
                    elif key == "required":
                        required = value
                    elif key == "provenance":
                        provenance = value
                    elif key == "canary":
                        canary = value
                    elif key == "branch":
                        approved_branch = value
                    elif key == "reachability":
                        reachability = value
                    elif key == "fetch_by_default":
                        fetch_by_default = value
                    else:
                        bad = true
        else:
            bad = true
        i = i + 1
    if path != "":
        if not _policy_fields_valid(pin, url, role, required,
                provenance, canary, approved_branch, reachability,
                fetch_by_default):
            bad = true
        else:
            policies.push(_policy_row(path, pin, url, role, required,
                provenance, canary, approved_branch))
    if bad:
        return []
    policies

fn validate_parent_submodule_closure_v1(
        links: [SelectedGitlinkV1],
        declarations: [SubmoduleDeclarationV1],
        policies: [SubmodulePolicyV1]) -> text:
    """Require policy for every parent gitlink before fetching any pin."""
    if links.len() == 0:
        return "no-parent-gitlinks"
    for link in links:
        if not _safe_git_path(link.path) or not _hex_oid(link.pin):
            return "invalid-parent-gitlink"
        var link_count = 0
        for other in links:
            if other.path == link.path:
                link_count = link_count + 1
        if link_count != 1:
            return "duplicate-parent-gitlink"
        var declaration_count = 0
        var declared_url = ""
        for declaration in declarations:
            if declaration.path == link.path:
                declaration_count = declaration_count + 1
                declared_url = declaration.url
        if declaration_count != 1 or declared_url == "":
            return "missing-or-duplicate-parent-declaration"
        var policy_count = 0
        for policy in policies:
            if policy.path == link.path:
                policy_count = policy_count + 1
                if policy.pin != link.pin or policy.url != declared_url:
                    return "parent-policy-pin-or-url-mismatch"
        if policy_count != 1:
            return "missing-or-duplicate-parent-policy"
    for policy in policies:
        var selected = false
        for link in links:
            if link.path == policy.path:
                selected = true
        if not selected:
            return "policy-for-unselected-path"
    ""

fn _fetch_exact_pin_v1(url: text, pin: text, canary: text,
        approved_branch: text) -> _RemotePinEvidenceV1:
    # Restrict transport and canary syntax before any remote access. Git's
    # archive and cat-file path forms must not accept option or revision data.
    if not url.starts_with("https://") or url.contains("\n") or
            url.contains("\r") or not _hex_oid(pin) or
            not _safe_git_path(canary) or
            not submodule_branch_ref_valid_v1(approved_branch):
        return _RemotePinEvidenceV1(false, "")
    val temp = match secure_temp_dir("/tmp", "simple-submodule-pin-"):
        case Ok(path): path
        case Err(_): return _RemotePinEvidenceV1(false, "")
    var verified = false
    var branch_tip = ""
    val template = temp + "/empty-template"
    if not dir_create_all(template):
        dir_remove_all(temp)
        return _RemotePinEvidenceV1(false, "")
    val (init_out, _init_err, init_code) = _git(temp,
        ["init", "--bare", "--quiet", "--template=" + template], 4096)
    if _complete(init_out, init_code, 4096):
        val (fetch_out, _fetch_err, fetch_code) = _git(temp,
            ["-c", "protocol.file.allow=never", "fetch", "--no-tags",
                "--depth=1", url, pin], SUBMODULE_REMOTE_OUTPUT_MAX)
        if _complete(fetch_out, fetch_code, SUBMODULE_REMOTE_OUTPUT_MAX):
            val (head_out, _head_err, head_code) = _git(temp,
                ["rev-parse", "--verify", "FETCH_HEAD^\{commit\}"], 4096)
            if _complete(head_out, head_code, 4096) and head_out.trim() == pin:
                val (kind_out, _kind_err, kind_code) = _git(temp,
                    ["cat-file", "-t", pin], 4096)
                if _complete(kind_out, kind_code, 4096) and
                        kind_out.trim() == "commit":
                    val (canary_out, _canary_err, canary_code) = _git(temp,
                        ["cat-file", "-t", pin + ":" + canary], 4096)
                    if _complete(canary_out, canary_code, 4096) and
                       canary_out.trim() == "blob":
                        # Fetch the approved branch from the same declared
                        # remote. An exact-SHA fetch alone proves availability,
                        # not membership in the protected update line.
                        val (branch_out, _branch_err, branch_code) = _git(temp,
                            ["-c", "protocol.file.allow=never", "fetch",
                                "--no-tags", url, approved_branch],
                            SUBMODULE_REMOTE_OUTPUT_MAX)
                        if _complete(branch_out, branch_code,
                                SUBMODULE_REMOTE_OUTPUT_MAX):
                            val (tip_out, _tip_err, tip_code) = _git(temp,
                                ["rev-parse", "--verify", "FETCH_HEAD^\{commit\}"],
                                4096)
                            if _complete(tip_out, tip_code, 4096) and
                                    _hex_oid(tip_out.trim()):
                                branch_tip = tip_out.trim()
                                val (ancestor_out, _ancestor_err,
                                    ancestor_code) = _git(temp,
                                    ["merge-base", "--is-ancestor", pin,
                                        branch_tip], 4096)
                                if _complete(ancestor_out, ancestor_code,
                                        4096):
                                    val (nested_out, _nested_err,
                                        nested_code) = _git(temp,
                                        ["ls-tree", "-r", "--full-tree", pin],
                                        SUBMODULE_GIT_OUTPUT_MAX)
                                    verified = _complete(nested_out,
                                        nested_code, SUBMODULE_GIT_OUTPUT_MAX) and
                                        not submodule_remote_tree_has_nested_or_invalid_v1(
                                            nested_out)
    val cleaned = dir_remove_all(temp)
    _RemotePinEvidenceV1(verified and cleaned,
        if verified and cleaned: branch_tip else: "")

fn probe_selected_submodules_v1(repo: text, parent_commit: text,
        policy_path: text, select_optional: [text]) -> SubmoduleGitProbeV1:
    """Fetch selected parent-tree pins from declared URLs in clean repos."""
    if not _hex_oid(parent_commit) or repo == "" or policy_path == "":
        return _reject_git_probe("invalid-input")
    val (tree_out, _tree_err, tree_code) = _git(repo,
        ["rev-parse", "--verify", parent_commit + "^\{tree\}"], 4096)
    if not _complete(tree_out, tree_code, 4096):
        return _reject_git_probe("parent-tree-unavailable")
    val tree = tree_out.trim()
    if not _hex_oid(tree):
        return _reject_git_probe("invalid-parent-tree")
    val (links_out, _links_err, links_code) = _git(repo,
        ["ls-tree", "-r", "--full-tree", tree], SUBMODULE_GIT_OUTPUT_MAX)
    if not _complete(links_out, links_code, SUBMODULE_GIT_OUTPUT_MAX):
        return _reject_git_probe("gitlink-list-unavailable-or-truncated")
    val all_links = parse_parent_gitlinks_v1(links_out)
    if all_links.len() == 0:
        return _reject_git_probe("no-parent-gitlinks")
    val (modules_out, _modules_err, modules_code) = _git(repo,
        ["show", tree + ":.gitmodules"], SUBMODULE_GIT_OUTPUT_MAX)
    if not _complete(modules_out, modules_code, SUBMODULE_GIT_OUTPUT_MAX):
        return _reject_git_probe("gitmodules-unavailable-or-truncated")
    val declarations = parse_parent_gitmodules_v1(modules_out)
    if declarations.len() == 0:
        return _reject_git_probe("invalid-gitmodules")
    val policy_source = file_read(policy_path) ?? ""
    if policy_source == "" or policy_source.len() >= SUBMODULE_GIT_OUTPUT_MAX:
        return _reject_git_probe("policy-unavailable-or-oversized")
    val policies = parse_submodule_policy_v1(policy_source)
    if policies.len() == 0:
        return _reject_git_probe("invalid-policy")
    val closure_problem = validate_parent_submodule_closure_v1(
        all_links, declarations, policies)
    if closure_problem != "":
        return _reject_git_probe(closure_problem)
    # Resolve the complete explicit selection before performing any fetch.
    var i = 0
    while i < select_optional.len():
        var matched_optional = false
        var j = 0
        while j < policies.len():
            if policies[j].path == select_optional[i] and not policies[j].required:
                matched_optional = true
            j = j + 1
        if not matched_optional:
            return _reject_git_probe("unknown-optional-selection")
        i = i + 1
    i = 0
    while i < policies.len():
        var duplicate = false
        var j = 0
        while j < i:
            if policies[j].path == policies[i].path:
                duplicate = true
            j = j + 1
        if duplicate:
            return _reject_git_probe("duplicate-policy-path")
        i = i + 1
    var links: [SelectedGitlinkV1] = []
    var selected_policies: [SubmodulePolicyV1] = []
    var observations: [PinReachabilityV1] = []
    i = 0
    while i < policies.len():
        val policy = policies[i]
        var selected = policy.required
        var j = 0
        while j < select_optional.len():
            if select_optional[j] == policy.path:
                selected = true
            j = j + 1
        if selected:
            var matches = 0
            j = 0
            while j < all_links.len():
                if all_links[j].path == policy.path:
                    links.push(all_links[j])
                    matches = matches + 1
                j = j + 1
            if matches != 1:
                return _reject_git_probe("selected-gitlink-missing-or-duplicate")
            selected_policies.push(policy)
            # Probe only after comparing the policy URL and pin with the
            # parent tree's declaration and gitlink.
            var declaration_count = 0
            var declaration_matches = false
            j = 0
            while j < declarations.len():
                if declarations[j].path == policy.path:
                    declaration_count = declaration_count + 1
                    declaration_matches = declarations[j].url == policy.url
                j = j + 1
            if declaration_count != 1 or not declaration_matches or
                    policy.pin != links[links.len() - 1].pin:
                return _reject_git_probe("selected-parent-policy-mismatch")
            val fetched = _fetch_exact_pin_v1(policy.url, policy.pin,
                policy.canary, policy.approved_branch)
            observations.push(PinReachabilityV1(policy.path, policy.pin,
                policy.url, policy.provenance, policy.canary,
                fetched.verified, fetched.verified, fetched.verified,
                policy.approved_branch, fetched.branch_tip,
                fetched.verified))
            if not fetched.verified:
                return _reject_git_probe("selected-pin-clean-fetch-unverified")
        i = i + 1
    if links.len() == 0:
        return _reject_git_probe("empty-selection")
    val inventory = selected_submodule_inventory_v1(
        links, declarations, selected_policies, observations, [])
    if inventory.status != "STRUCTURAL_ONLY":
        return _reject_git_probe(inventory.reason)
    SubmoduleGitProbeV1("CLEAN_FETCH_VERIFIED",
        "exact-pin-canary-and-approved-branch-verified",
        tree, inventory, observations)

export SubmoduleGitProbeV1, parse_parent_gitlinks_v1
export submodule_remote_tree_has_nested_or_invalid_v1
export parse_parent_gitmodules_v1, parse_submodule_policy_v1
export validate_parent_submodule_closure_v1
export probe_selected_submodules_v1
