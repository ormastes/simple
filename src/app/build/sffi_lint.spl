"""
## Purpose and audience
Build-time diagnostics for SFFI/driver attribute usage. Audience: the driver
lane owner closing
doc/03_plan/os/driver/driver_framework_module_level_sugar.md Phase 4, and the
acceptance spec
test/03_system/plan_acceptance/driver_framework_module_level_sugar_spec.spl,
which pins this module's interface.

## Operator workflow
Run over one lowered module and read the findings back as text lines:

    use app.build.sffi_lint.{lint_module_driver_attr}
    for finding in lint_module_driver_attr(module):
        print(finding)

An empty list means the module's driver attributes are consistent.

## Compatibility and limitations
The rule below is a whole-module check: whether a `@driver(...)` attribute has
matching op functions can only be decided after the module's exports are
known, so it runs on lowered HIR rather than on the token stream.

TODO(driver lane, REQ-PLAN-DRIVER-SUGAR-005): HIR does not yet attach a
`ModuleAttr` to `HirModule`, so `_module_driver_attr` cannot read one and this
rule reports nothing on any real module today. The attribute-attachment half
lands with Phase 1 of the plan named above; the rule body here is already the
shape it needs.
"""

use compiler.hir.hir_definitions.{HirModule, ModuleAttr}
use compiler.mir.synthetic_driver_codegen.{collect_module_driver_ops, driver_trait_op_names}

# Warn when a module carries `@driver(...)` but exports no function matching
# the Driver trait surface, i.e. the sugar would synthesize an empty DriverOps
# record and register a driver that can do nothing.
#
# Returns one finding text per problem; an empty list means the module is
# clean. A module that carries no `@driver(...)` attribute at all is clean by
# definition -- there is nothing to be inconsistent with.
fn lint_module_driver_attr(module: HirModule) -> [text]:
    var findings: [text] = []
    if val attr = _module_driver_attr(module):
        if attr.manifest.?:
            val ops = collect_module_driver_ops(module)
            if ops.len() == 0:
                findings.push("warning[DRIVER-SUGAR-001]: module `" + module.name
                              + "` carries @driver(...) but exports no function named "
                              + _op_surface_text()
                              + "; the synthesized DriverOps record would be empty")
    findings

fn _op_surface_text() -> text:
    var out = ""
    val names = driver_trait_op_names()
    var i = 0
    while i < names.len():
        if i > 0:
            out = out + "/"
        out = out + names[i]
        i = i + 1
    out

# The module-level `@driver(...)` attribute, or absent when the module carries
# none. HirModule has no attribute field yet (see the module TODO), so today
# every module reads as carrying none.
fn _module_driver_attr(module: HirModule) -> ModuleAttr?:
    nil
