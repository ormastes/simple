# A base-owned CI controller supplies the expectation and trust observation.
# This pure validator decides whether a local build may replace duplicate work.
# It does not verify SSH signatures, retrieve artifacts, or report GitHub status.
use compiler.common.cache.canonical_identity.{canon_str, canon_field, canon_seq}
use std.common.crypto.sha256.{sha256_text}

val SIGNED_BUILD_RECEIPT_SCHEMA_V1 = "simple-signed-build-receipt-v1"

struct SignedBuildReceiptV1:
    schema: text
    base_revision: text
    head_revision: text
    candidate_tree: text
    target_id: text
    execution_platform: text
    output_target: text
    toolchain_digest: text
    action_digest: text
    input_manifest_digest: text
    submodule_closure_digest: text
    protected_policy_digest: text
    checker_digest: text
    mandatory_gate_receipt_digest: text
    artifact_digest: text
    artifact_length: i64
    artifact_locator: text
    signer_id: text
    signer_scope: text
    issued_at_utc: text
    expires_at_utc: text

struct SignedBuildExpectationV1:
    base_revision: text
    head_revision: text
    candidate_tree: text
    target_id: text
    execution_platform: text
    output_target: text
    toolchain_digest: text
    action_digest: text
    input_manifest_digest: text
    submodule_closure_digest: text
    protected_policy_digest: text
    checker_digest: text
    mandatory_gate_receipt_digest: text
    allowed_signer_id: text
    allowed_signer_scope: text
    now_utc: text
    max_expires_at_utc: text

struct SignedBuildTrustObservationV1:
    signature_valid: bool
    signer_authorized: bool
    signer_revoked: bool
    verified_payload_digest: text
    verified_signer_id: text
    verified_signer_scope: text
    mandatory_gate_receipt_valid: bool
    verified_gate_receipt_digest: text
    artifact_retrieved: bool
    artifact_digest: text
    artifact_length: i64

struct SignedBuildAdmissionV1:
    decision: text
    reason: text

fn _full_build_v1(reason: text) -> SignedBuildAdmissionV1:
    SignedBuildAdmissionV1("FULL_BUILD", reason)

fn _hex_digest_v1(value: text) -> bool:
    if value.len() != 64:
        return false
    var i = 0
    while i < value.len():
        val ch = value[i:i + 1]
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return false
        i = i + 1
    true

fn _revision_v1(value: text) -> bool:
    if value.len() != 40 and value.len() != 64:
        return false
    var i = 0
    while i < value.len():
        val ch = value[i:i + 1]
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return false
        i = i + 1
    true

fn _field_v1(value: text) -> bool:
    value != "" and value == value.trim() and not value.contains("\n") and
        not value.contains("\r") and not value.contains("|")

fn _timestamp_v1(value: text) -> bool:
    if value.len() != 20 or value[4:5] != "-" or value[7:8] != "-" or
            value[10:11] != "T" or value[13:14] != ":" or
            value[16:17] != ":" or value[19:20] != "Z":
        return false
    var i = 0
    while i < value.len():
        if i != 4 and i != 7 and i != 10 and i != 13 and i != 16 and i != 19:
            val ch = value[i:i + 1]
            if ch < "0" or ch > "9":
                return false
        i = i + 1
    val year = value[0:4].to_i64() ?? 0
    val month = value[5:7].to_i64() ?? 0
    val day = value[8:10].to_i64() ?? 0
    val hour = value[11:13].to_i64() ?? -1
    val minute = value[14:16].to_i64() ?? -1
    val second = value[17:19].to_i64() ?? -1
    if year <= 0 or month < 1 or month > 12 or day < 1 or
            hour < 0 or hour > 23 or minute < 0 or minute > 59 or
            second < 0 or second > 59:
        return false
    val leap = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
    val days = if month == 2: (if leap: 29 else: 28)
        elif month == 4 or month == 6 or month == 9 or month == 11: 30
        else: 31
    day <= days

fn signed_build_receipt_digest_v1(receipt: SignedBuildReceiptV1) -> text:
    """Digest the exact versioned receipt fields expected under a signature."""
    if receipt.schema != SIGNED_BUILD_RECEIPT_SCHEMA_V1:
        return ""
    sha256_text(canon_field(SIGNED_BUILD_RECEIPT_SCHEMA_V1, canon_seq([
        canon_str(receipt.base_revision), canon_str(receipt.head_revision),
        canon_str(receipt.candidate_tree), canon_str(receipt.target_id),
        canon_str(receipt.execution_platform), canon_str(receipt.output_target),
        canon_str(receipt.toolchain_digest), canon_str(receipt.action_digest),
        canon_str(receipt.input_manifest_digest),
        canon_str(receipt.submodule_closure_digest),
        canon_str(receipt.protected_policy_digest), canon_str(receipt.checker_digest),
        canon_str(receipt.mandatory_gate_receipt_digest),
        canon_str(receipt.artifact_digest), canon_str(receipt.artifact_length.to_text()),
        canon_str(receipt.artifact_locator), canon_str(receipt.signer_id),
        canon_str(receipt.signer_scope), canon_str(receipt.issued_at_utc),
        canon_str(receipt.expires_at_utc)
    ])))

fn validate_signed_build_admission_v1(
    receipt: SignedBuildReceiptV1, expected: SignedBuildExpectationV1,
    trust: SignedBuildTrustObservationV1
) -> SignedBuildAdmissionV1:
    """REUSE only for exact, authenticated and byte-verified build evidence.

    All other outcomes require the ordinary remote build. The caller still
    runs and reports the required GitHub job context in either case.
    """
    if receipt.schema != SIGNED_BUILD_RECEIPT_SCHEMA_V1:
        return _full_build_v1("unsupported-schema")
    if not _revision_v1(expected.base_revision) or
            not _revision_v1(expected.head_revision) or
            not _revision_v1(expected.candidate_tree):
        return _full_build_v1("invalid-trusted-revision")
    if receipt.base_revision != expected.base_revision or
            receipt.head_revision != expected.head_revision or
            receipt.candidate_tree != expected.candidate_tree:
        return _full_build_v1("candidate-mismatch")
    if not _field_v1(expected.target_id) or
            not _field_v1(expected.execution_platform) or
            not _field_v1(expected.output_target) or
            receipt.target_id != expected.target_id or
            receipt.execution_platform != expected.execution_platform or
            receipt.output_target != expected.output_target:
        return _full_build_v1("build-target-mismatch")
    if not _hex_digest_v1(expected.toolchain_digest) or
            not _hex_digest_v1(expected.action_digest) or
            not _hex_digest_v1(expected.input_manifest_digest) or
            receipt.toolchain_digest != expected.toolchain_digest or
            receipt.action_digest != expected.action_digest or
            receipt.input_manifest_digest != expected.input_manifest_digest:
        return _full_build_v1("build-input-mismatch")
    if not _hex_digest_v1(expected.submodule_closure_digest) or
            not _hex_digest_v1(expected.protected_policy_digest) or
            not _hex_digest_v1(expected.checker_digest) or
            not _hex_digest_v1(expected.mandatory_gate_receipt_digest) or
            receipt.submodule_closure_digest != expected.submodule_closure_digest or
            receipt.protected_policy_digest != expected.protected_policy_digest or
            receipt.checker_digest != expected.checker_digest or
            receipt.mandatory_gate_receipt_digest != expected.mandatory_gate_receipt_digest:
        return _full_build_v1("policy-mismatch")
    if not trust.mandatory_gate_receipt_valid or
            trust.verified_gate_receipt_digest != receipt.mandatory_gate_receipt_digest:
        return _full_build_v1("mandatory-gates-incomplete")
    if not _field_v1(expected.allowed_signer_id) or
            not _field_v1(expected.allowed_signer_scope) or
            receipt.signer_id != expected.allowed_signer_id or
            receipt.signer_scope != expected.allowed_signer_scope or
            trust.verified_signer_id != receipt.signer_id or
            trust.verified_signer_scope != receipt.signer_scope or
            trust.verified_payload_digest != signed_build_receipt_digest_v1(receipt) or
            not trust.signature_valid or not trust.signer_authorized or
            trust.signer_revoked:
        return _full_build_v1("signer-untrusted")
    if not _timestamp_v1(expected.now_utc) or
            not _timestamp_v1(expected.max_expires_at_utc) or
            not _timestamp_v1(receipt.issued_at_utc) or
            not _timestamp_v1(receipt.expires_at_utc) or
            receipt.issued_at_utc > expected.now_utc or
            receipt.expires_at_utc <= expected.now_utc or
            receipt.expires_at_utc > expected.max_expires_at_utc:
        return _full_build_v1("receipt-expired")
    if not _field_v1(receipt.artifact_locator) or
            not _hex_digest_v1(receipt.artifact_digest) or
            receipt.artifact_length <= 0 or not trust.artifact_retrieved or
            trust.artifact_digest != receipt.artifact_digest or
            trust.artifact_length != receipt.artifact_length:
        return _full_build_v1("artifact-unverified")
    SignedBuildAdmissionV1("REUSE", "exact-build-evidence")

export SIGNED_BUILD_RECEIPT_SCHEMA_V1, SignedBuildReceiptV1
export SignedBuildExpectationV1, SignedBuildTrustObservationV1
export SignedBuildAdmissionV1, validate_signed_build_admission_v1
export signed_build_receipt_digest_v1

# V2 is the only receipt schema eligible for a future GitHub controller.
# The nested V1 build value reuses its exact field validation; it is not a
# separately trusted receipt and its digest alone never authenticates V2.
val SIGNED_BUILD_RECEIPT_SCHEMA_V2 = "simple-signed-build-receipt-v2"

struct SignedBuildReceiptV2:
    schema: text
    repository_full_name: text
    pull_request_number: i64
    build: SignedBuildReceiptV1

struct SignedBuildExpectationV2:
    repository_full_name: text
    pull_request_number: i64
    build: SignedBuildExpectationV1

fn signed_build_repository_valid_v2(repository: text) -> bool:
    if repository.len() < 3 or repository.len() > 201:
        return false
    val parts = repository.split("/")
    if parts.len() != 2:
        return false
    for part in parts:
        if part == "" or part == "." or part == "..":
            return false
        var i = 0
        while i < part.len():
            val ch = part[i:i + 1]
            if not ((ch >= "a" and ch <= "z") or
                    (ch >= "0" and ch <= "9") or ch == "-" or
                    ch == "_" or ch == "."):
                return false
            i = i + 1
    true

fn signed_build_receipt_digest_v2(receipt: SignedBuildReceiptV2) -> text:
    """Sign the V2 domain and repository/PR identity with the entire build."""
    if receipt.schema != SIGNED_BUILD_RECEIPT_SCHEMA_V2 or
            not signed_build_repository_valid_v2(receipt.repository_full_name) or
            receipt.pull_request_number <= 0:
        return ""
    val build_digest = signed_build_receipt_digest_v1(receipt.build)
    if build_digest == "":
        return ""
    sha256_text(canon_field(SIGNED_BUILD_RECEIPT_SCHEMA_V2, canon_seq([
        canon_str(receipt.repository_full_name),
        canon_str(receipt.pull_request_number.to_text()), canon_str(build_digest)
    ])))

fn validate_signed_build_admission_v2(
    receipt: SignedBuildReceiptV2, expected: SignedBuildExpectationV2,
    trust: SignedBuildTrustObservationV1
) -> SignedBuildAdmissionV1:
    """V2 identity admission; signature observation must cover the V2 digest."""
    if receipt.schema != SIGNED_BUILD_RECEIPT_SCHEMA_V2:
        return _full_build_v1("unsupported-schema")
    if not signed_build_repository_valid_v2(expected.repository_full_name) or
            expected.pull_request_number <= 0:
        return _full_build_v1("invalid-trusted-repository-pr")
    if receipt.repository_full_name != expected.repository_full_name or
            receipt.pull_request_number != expected.pull_request_number:
        return _full_build_v1("repository-pr-mismatch")
    val digest = signed_build_receipt_digest_v2(receipt)
    if digest == "" or trust.verified_payload_digest != digest:
        return _full_build_v1("signer-untrusted")
    # V2 digest has now authenticated the nested build. Rebind only the local
    # observation used by the shared V1 field validator, never provider output.
    val build_trust = SignedBuildTrustObservationV1(
        signature_valid: trust.signature_valid,
        signer_authorized: trust.signer_authorized,
        signer_revoked: trust.signer_revoked,
        verified_payload_digest: signed_build_receipt_digest_v1(receipt.build),
        verified_signer_id: trust.verified_signer_id,
        verified_signer_scope: trust.verified_signer_scope,
        mandatory_gate_receipt_valid: trust.mandatory_gate_receipt_valid,
        verified_gate_receipt_digest: trust.verified_gate_receipt_digest,
        artifact_retrieved: trust.artifact_retrieved,
        artifact_digest: trust.artifact_digest, artifact_length: trust.artifact_length
    )
    validate_signed_build_admission_v1(receipt.build, expected.build, build_trust)

export SIGNED_BUILD_RECEIPT_SCHEMA_V2, SignedBuildReceiptV2, SignedBuildExpectationV2
export signed_build_repository_valid_v2, signed_build_receipt_digest_v2
export validate_signed_build_admission_v2
