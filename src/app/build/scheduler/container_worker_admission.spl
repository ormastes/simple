# Preliminary, pure app boundary between build actions and orchestration resources.
# Callers must authenticate capabilities, probe provenance and guest/image platform,
# verify immutable bytes, then separately enforce execution and output mounts.
use compiler.common.build_contract.{ActionSpec, AttemptSpec, NodeCapabilities,
    ToolchainManifest, action_spec_digest_v1, input_manifest_digest_v1}
use std.common.contracts.orchestration.resource_v1.{PodSpecV1}
use std.common.contracts.container.runtime_v1.{RuntimeProviderContractV1, RuntimeProbeV1}

struct BuildWorkerEnvironmentV1:
    physical_host_os: text
    physical_host_arch: text
    execution_os: text
    execution_arch: text
    guest_id: text
    provider: RuntimeProviderContractV1
    probe: RuntimeProbeV1
    isolated: bool
    toolchain: ToolchainManifest
    verified_snapshot_digest: text
    verified_input_manifest_digest: text
    verified_artifact_digest: text
    artifact_digest: text
    sandbox_digest: text
    current_fence: i64

struct BuildWorkerAdmissionV1:
    admitted: bool
    reason: text
    action_digest: text
    attempt_id: text
    fence: i64

fn _reject_build_worker_v1(reason: text) -> BuildWorkerAdmissionV1:
    BuildWorkerAdmissionV1(false, reason, "", "", 0)

fn _known_build_os_v1(os_name: text) -> bool:
    ["linux", "windows", "macos", "freebsd", "simpleos"].contains(os_name)

fn _sha256_hex_v1(digest: text) -> bool:
    if digest.len() != 64:
        return false
    var i: i64 = 0
    while i < digest.len():
        val c = digest[i:i + 1]
        if not ((c >= "0" and c <= "9") or (c >= "a" and c <= "f")):
            return false
        i = i + 1
    true

fn _locked_image_matches_v1(image: text, digest: text) -> bool:
    val marker = "@sha256:"
    val at = image.index_of(marker)
    if at < 1 or image.contains("\n") or image.contains("\r"):
        return false
    val digest_start = at + marker.len()
    image.len() == digest_start + 64 and image.substring(digest_start, image.len()) == digest

fn _same_toolchain_v1(a: ToolchainManifest, b: ToolchainManifest) -> bool:
    a.version == b.version and a.executable_digest == b.executable_digest and
        a.behavior_digest == b.behavior_digest and
        a.provider_abi_digest == b.provider_abi_digest and
        a.runtime_digest == b.runtime_digest and
        a.sysroot_digest == b.sysroot_digest and
        a.target_triple == b.target_triple

fn admit_container_build_worker_v1(action: ActionSpec, attempt: AttemptSpec,
        node: NodeCapabilities, pod: PodSpecV1,
        env: BuildWorkerEnvironmentV1, expected_fence: i64) -> BuildWorkerAdmissionV1:
    """Validate a proposed execution without launching it or attesting its result."""
    val digest = action_spec_digest_v1(action)
    if digest == "":
        return _reject_build_worker_v1("action-invalid")
    if attempt.version != 1 or node.version != 1 or attempt.action_digest != digest or
       attempt.attempt_id == "" or attempt.worker_id == "" or
       attempt.worker_id != node.node_id or attempt.retry_number < 0 or
       attempt.memory_budget_bytes <= 0 or expected_fence <= 0 or
       env.current_fence != expected_fence:
        return _reject_build_worker_v1("attempt-or-fence-invalid")
    if node.memory_capacity_bytes < attempt.memory_budget_bytes or
       not node.target_triples.contains(action.toolchain.target_triple) or
       not node.provider_abi_digests.contains(action.toolchain.provider_abi_digest):
        return _reject_build_worker_v1("node-capability-mismatch")
    if not _known_build_os_v1(env.physical_host_os) or
       not _known_build_os_v1(env.execution_os) or
       env.physical_host_arch == "" or env.execution_arch == "" or
       pod.os_name != env.execution_os:
        return _reject_build_worker_v1("execution-platform-mismatch")
    # The current Linux OCI leaf executes on its physical Linux host. A guest ID
    # alone cannot attest a VM agent or its provider, so cross-host execution
    # remains unqualified until that adapter exists.
    if env.physical_host_os != env.execution_os or
       env.physical_host_arch != env.execution_arch:
        return _reject_build_worker_v1("guest-provider-unqualified")
    if env.guest_id != "":
        return _reject_build_worker_v1("guest-evidence-inconsistent")
    # Only the Linux OCI provider has a concrete hosted container implementation.
    # A positive probe is necessary; the caller must independently trust its source.
    if pod.runtime_class != "native-container" or pod.network_profile != "endpoint-v1" or
       env.execution_os != "linux" or
       env.provider.version != 1 or env.provider.provider_id != "linux-oci-v1" or
       not env.provider.supports_recovery or not env.provider.supports_logs or
       env.probe.provider != env.provider.provider_id or
       not ["docker", "podman"].contains(env.probe.engine) or
       (env.probe.engine == "docker" and env.probe.privilege != "root") or
       (env.probe.engine == "podman" and env.probe.privilege != "rootless") or
       not env.probe.engine_present or not env.probe.healthy or
       not env.probe.launch_capable or not env.isolated:
        return _reject_build_worker_v1("provider-unsupported")
    if not _same_toolchain_v1(action.toolchain, env.toolchain):
        return _reject_build_worker_v1("toolchain-mismatch")
    if env.verified_snapshot_digest != action.snapshot.snapshot_digest or
       env.verified_input_manifest_digest != input_manifest_digest_v1(action.inputs) or
       env.sandbox_digest != action.sandbox_digest or
       not _sha256_hex_v1(env.artifact_digest) or
       env.verified_artifact_digest != env.artifact_digest:
        return _reject_build_worker_v1("immutable-input-mismatch")
    if pod.containers.len() != 1:
        return _reject_build_worker_v1("pod-shape-unsupported")
    val container = pod.containers[0]
    if container.name == "" or container.ports.len() != 0 or
       container.command != action.argv or container.args.len() != 0 or
       container.resources.cpu_request_millis < 0 or
       container.resources.cpu_request_millis > container.resources.cpu_limit_millis or
       container.resources.memory_request_bytes < 0 or
       container.resources.memory_limit_bytes != attempt.memory_budget_bytes or
       container.resources.memory_limit_bytes > node.memory_capacity_bytes or
       container.resources.memory_request_bytes > container.resources.memory_limit_bytes or
       container.resources.cpu_limit_millis <= 0 or
       container.resources.cpu_limit_millis > 92233720368547758:
        return _reject_build_worker_v1("pod-shape-unsupported")
    for arg in container.command:
        if arg == "" or arg.contains("\n") or arg.contains("\r"):
            return _reject_build_worker_v1("pod-shape-unsupported")
    # Linux OCI currently receives an image directly. ArtifactSetRef needs a
    # separately qualified materialization adapter before it can be admitted.
    if _locked_image_matches_v1(container.image, env.artifact_digest) and
       container.artifact_set_ref == "":
        return BuildWorkerAdmissionV1(true, "ok", digest, attempt.attempt_id, expected_fence)
    _reject_build_worker_v1("artifact-identity-mismatch")

export BuildWorkerEnvironmentV1, BuildWorkerAdmissionV1, admit_container_build_worker_v1
