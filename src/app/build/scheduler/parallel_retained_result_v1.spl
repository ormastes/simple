# Conditional parent-side verifier for an isolated transport child's files.
# The caller must independently establish that all child writers have stopped.
use app.build.scheduler.parallel_transport_wire_v1.{
    ParallelTransportFileV1, ParallelTransportHandoffV1,
    ParallelTransportObservationV1, parallel_transport_handoff_digest_v1,
    PARALLEL_TRANSPORT_MAX_RESULT_BYTES_V1}
use app.build.scheduler.parallel_retained_result_plan_v1.{
    plan_parallel_retained_result_v1}
use app.build.scheduler.trusted_result_download.{BuildResultFetchV1,
    plan_build_result_download_budget_v1}
use app.build.scheduler.worker_request.{parse_build_worker_request_v1,
    encode_build_worker_request_v1}
use app.build.scheduler.dispatch_wire.{encode_build_dispatch_v1}
use app.build.scheduler.trusted_worker_invocation.{
    validate_build_worker_reply_v1}
use app.build.scheduler.worker_output.{verify_build_outputs_v1,
    BUILD_OUTPUT_MANIFEST_MAX_BYTES_V1,
    BUILD_OUTPUT_MAX_DIAGNOSTIC_BYTES_V1}
use app.build.scheduler.worker_failure_proof.{
    parse_build_worker_failure_proof_v1, BUILD_WORKER_FAILURE_PROOF_MAX_V1}
use std.common.io.read_only_file_view.{read_only_file_view_open_v1,
    read_only_file_view_read_v1, read_only_file_view_close_v1}
use std.common.io.file_read_policy.{FileReadPolicyV1}
use std.async.cancellation.{CancellationToken}
use std.common.crypto.sha256.{sha256_text, sha256_stream_v1_new,
    sha256_stream_v1_update, sha256_stream_v1_finish_hex}
use std.nogc_sync_mut.io.file.{FileHandle}
use app.io.mod.{secure_temp_dir, dir_create_all, dir_remove_all,
    file_hash_sha256, file_is_regular_no_follow, file_size_raw,
    file_read_regular_no_follow_bounded}

val PARALLEL_RETAINED_MAX_FILE_BYTES_V1: i64 = 268435456
val PARALLEL_RETAINED_COPY_CHUNK_BYTES_V1: u64 = 1048576u64

struct ParallelRetainedResultV1:
    verified: bool
    reason: text
    fetch: BuildResultFetchV1

fn _retained_failure_v1(reason: text,
        stage_root: text) -> ParallelRetainedResultV1:
    var detail = reason
    if stage_root != "" and not dir_remove_all(stage_root):
        detail = detail + ";stage-cleanup-failed"
    ParallelRetainedResultV1(false, detail,
        BuildResultFetchV1(false, false, detail, "", "", "", ""))

fn _retained_path_v1(path: text) -> bool:
    if not path.starts_with("/") or path.len() < 2 or path.len() > 4096 or
       path.ends_with("/") or path.contains("//") or path.contains("\0"):
        return false
    val parts = path.split("/")
    var i: i64 = 1
    while i < parts.len():
        val item = parts[i]
        if item == "" or item == "." or item == "..": return false
        i = i + 1
    true

fn _retained_file_limit_v1(path: text) -> i64:
    if path == "outputs/result.wire": return 4096
    if path == "outputs/manifest.wire":
        return BUILD_OUTPUT_MANIFEST_MAX_BYTES_V1
    if path == "outputs/diagnostics":
        return BUILD_OUTPUT_MAX_DIAGNOSTIC_BYTES_V1
    if path == "outputs/failure-proof.wire":
        return BUILD_WORKER_FAILURE_PROOF_MAX_V1
    PARALLEL_RETAINED_MAX_FILE_BYTES_V1

fn _copy_retained_file_v1(child_root: text, output_root: text,
        file: ParallelTransportFileV1, handoff_digest: text) -> text:
    val limit = _retained_file_limit_v1(file.relative_path)
    if file.byte_count < 0 or file.byte_count > limit:
        return "result-file-limit"
    val opened = read_only_file_view_open_v1(child_root,
        file.relative_path, handoff_digest, FileReadPolicyV1.buffered)
    if opened.is_err(): return "result-file-open"
    var view = opened.unwrap()
    if view.identity.size != file.byte_count.to_u64():
        val _ = read_only_file_view_close_v1(view)
        return "result-file-size"
    val target = output_root + "/" +
        file.relative_path["outputs/".len():]
    val created = FileHandle.create(target)
    if created.is_err():
        val _ = read_only_file_view_close_v1(view)
        return "result-stage-write"
    var stage = created.unwrap()
    val stream = sha256_stream_v1_new()
    val cancellation = CancellationToken.new()
    var offset: u64 = 0u64
    var error = ""
    while offset < view.identity.size:
        val remaining = view.identity.size - offset
        val length = if remaining > PARALLEL_RETAINED_COPY_CHUNK_BYTES_V1:
            PARALLEL_RETAINED_COPY_CHUNK_BYTES_V1 else: remaining
        val read = read_only_file_view_read_v1(&view, offset,
            length, cancellation)
        if read.is_err():
            error = "result-file-read"
            break
        val bytes = read.unwrap().bytes
        if bytes.len().to_u64() != length or
           not sha256_stream_v1_update(stream, bytes):
            error = "result-file-read"
            break
        if stage.write_all(bytes).is_err():
            error = "result-stage-write"
            break
        offset = offset + length
    if error == "":
        val digest = sha256_stream_v1_finish_hex(stream)
        if digest == nil or digest.unwrap() != file.sha256:
            error = "result-file-digest"
    val stage_closed = stage.close()
    val view_closed = read_only_file_view_close_v1(view)
    if error != "": return error
    if stage_closed.is_err() or view_closed.is_err():
        return "result-file-close"
    if not file_is_regular_no_follow(target) or
       file_size_raw(target) != file.byte_count or
       file_hash_sha256(target) != file.sha256:
        return "result-stage-verify"
    ""

fn verify_parallel_retained_result_v1(handoff: ParallelTransportHandoffV1,
        observation: ParallelTransportObservationV1,
        local_state_dir: text,
        child_writers_stopped: bool) -> ParallelRetainedResultV1:
    """Verify child bytes only after a trusted parent stops all child writers.

    No Mac writer-cessation proof is supplied here. A boolean from a child or
    process-group leader alone must never be treated as that parent proof.
    """
    if not child_writers_stopped:
        return _retained_failure_v1("child-writers-not-stopped", "")
    val plan = plan_parallel_retained_result_v1(handoff, observation)
    if not plan.valid:
        return _retained_failure_v1(plan.reason, "")
    if plan.total_bytes > PARALLEL_TRANSPORT_MAX_RESULT_BYTES_V1 or
       not _retained_path_v1(local_state_dir) or
       local_state_dir == handoff.result_root or
       local_state_dir.starts_with(handoff.result_root + "/") or
       handoff.result_root.starts_with(local_state_dir + "/"):
        return _retained_failure_v1("result-root-or-budget-invalid", "")
    val request = parse_build_worker_request_v1(handoff.request_wire)
    if request == nil:
        return _retained_failure_v1("request-invalid", "")
    val created = secure_temp_dir(local_state_dir, "parallel-retained")
    if created.is_err():
        return _retained_failure_v1("stage-unavailable", "")
    val stage_root = created.unwrap()
    val output_root = stage_root + "/outputs"
    if not dir_create_all(output_root):
        return _retained_failure_v1("output-stage-unavailable", stage_root)
    val handoff_digest = parallel_transport_handoff_digest_v1(handoff)
    for file in observation.result_files:
        val error = _copy_retained_file_v1(handoff.result_root, output_root,
            file, handoff_digest)
        if error != "": return _retained_failure_v1(error, stage_root)
    val result_text = file_read_regular_no_follow_bounded(output_root +
        "/result.wire", 4096)
    val manifest_text = file_read_regular_no_follow_bounded(output_root +
        "/manifest.wire", BUILD_OUTPUT_MANIFEST_MAX_BYTES_V1)
    val diagnostics = file_read_regular_no_follow_bounded(output_root +
        "/diagnostics", BUILD_OUTPUT_MAX_DIAGNOSTIC_BYTES_V1)
    if result_text.is_err() or manifest_text.is_err() or diagnostics.is_err() or
       result_text.unwrap() != observation.worker_result_wire:
        return _retained_failure_v1("result-metadata-invalid", stage_root)
    val current = request.unwrap()
    val dispatch = encode_build_dispatch_v1(current.action, current.attempt,
        current.fence, current.cpu_tokens, current.fd_tokens)
    val reply = validate_build_worker_reply_v1(dispatch, result_text.unwrap())
    if not reply.received or reply.result == nil:
        return _retained_failure_v1("result-candidate-invalid", stage_root)
    val candidate = reply.result.unwrap().candidate
    if candidate.success != plan.success:
        return _retained_failure_v1("result-outcome-mismatch", stage_root)
    if candidate.success:
        val budget = plan_build_result_download_budget_v1(current,
            manifest_text.unwrap(), candidate.output_manifest_digest)
        if not budget.valid:
            return _retained_failure_v1(budget.reason, stage_root)
        val observed = verify_build_outputs_v1(current.action,
            current.attempt, current.fence, output_root,
            diagnostics.unwrap(), manifest_text.unwrap(),
            candidate.output_manifest_digest)
        if not observed.valid or
           observed.diagnostic_digest != candidate.diagnostic_digest:
            return _retained_failure_v1("result-output-invalid", stage_root)
        return ParallelRetainedResultV1(true, "",
            BuildResultFetchV1(true, true, "", stage_root, output_root,
                observed.manifest_digest, result_text.unwrap()))
    if manifest_text.unwrap() != "" or
       candidate.output_manifest_digest != "" or
       sha256_text(diagnostics.unwrap()) != candidate.diagnostic_digest:
        return _retained_failure_v1("failure-candidate-invalid", stage_root)
    val proof = file_read_regular_no_follow_bounded(output_root +
        "/failure-proof.wire", BUILD_WORKER_FAILURE_PROOF_MAX_V1)
    if proof.is_err():
        return _retained_failure_v1("failure-proof-invalid", stage_root)
    val parsed = parse_build_worker_failure_proof_v1(proof.unwrap())
    if parsed == nil or
       parsed.unwrap().request_digest != sha256_text(
           encode_build_worker_request_v1(current)) or
       parsed.unwrap().attempt_id != current.attempt.attempt_id or
       parsed.unwrap().fence != current.fence or
       parsed.unwrap().result_digest != sha256_text(result_text.unwrap()):
        return _retained_failure_v1("failure-proof-mismatch", stage_root)
    ParallelRetainedResultV1(true, "",
        BuildResultFetchV1(true, false, "", stage_root, "", "",
            result_text.unwrap()))

export PARALLEL_RETAINED_MAX_FILE_BYTES_V1
export ParallelRetainedResultV1, verify_parallel_retained_result_v1
