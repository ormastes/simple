# Administrator-side preflight for a separately approved graph-plan digest.
use app.build.scheduler.parent_graph_plan_cli.{load_parent_graph_plan_v1}
use app.build.scheduler.parent_issued_graph_wire.{
    encode_parent_issued_graph_wire_v1}
use app.build.scheduler.parent_issued_graph_store.{
    publish_issued_parent_graph_v1}
use app.build.scheduler.parent_issued_plan_store.{ParentIssuedPlanPublishV1}

fn issue_approved_parent_graph_v1(trusted_root: text,
        approved_plan_digest: text, manifest_path: text,
        manifest_digest: text,
        config_paths: [text]) -> ParentIssuedPlanPublishV1:
    """Issue only a graph preflight matching independent administrator approval.

    The caller must authenticate approval and own the installed trusted root.
    A candidate-provided digest or writable directory grants no authority.
    """
    val loaded = load_parent_graph_plan_v1(approved_plan_digest,
        manifest_path, manifest_digest, config_paths)
    if not loaded.valid:
        return ParentIssuedPlanPublishV1(false, false,
            "issued-graph-preflight: " + loaded.reason, "")
    val wire = encode_parent_issued_graph_wire_v1(
        approved_plan_digest, manifest_path, manifest_digest,
        config_paths)
    if wire == "":
        return ParentIssuedPlanPublishV1(false, false,
            "issued-graph-record-invalid", "")
    publish_issued_parent_graph_v1(trusted_root, wire)

export issue_approved_parent_graph_v1
