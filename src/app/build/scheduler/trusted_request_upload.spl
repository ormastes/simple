# Upload a complete worker request only after declared bytes are in place.
# The final ready marker is the remote worker's sole request-open signal.
# Partial uploads retain their attempt ID and are never retried in place.
use app.io.mod.{secure_temp_dir, file_atomic_write, dir_remove_all,
    process_run_bounded}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1,
    BuildSftpPlanV1,
    plan_build_input_sftp_v1, transfer_build_inputs_sftp_v1,
    plan_build_input_sftp_with_cas_v1,
    transfer_build_inputs_sftp_with_cas_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1}
use app.build.scheduler.worker_ready.{BUILD_WORKER_CONTROL_DIRECTORY_V1,
    encode_build_worker_ready_v1, worker_ready_control_collision_v1}
use std.common.crypto.sha256.{sha256_text}

struct BuildRequestUploadPlanV1:
    valid: bool
    reason: text
    request_wire: text
    request_digest: text
    ready_wire: text
    remote_attempt_root: text
    input_plan: BuildSftpPlanV1

struct BuildRequestUploadV1:
    ready: bool
    reason: text
    request_digest: text
    remote_attempt_root: text

fn _upload_reject_v1(reason: text) -> BuildRequestUploadPlanV1:
    BuildRequestUploadPlanV1(false, reason, "", "", "", "",
        BuildSftpPlanV1(false, reason, "", "", 0, 0))

fn _plan_build_request_upload_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, source_root: text,
        cas_root: text, use_cas: bool) -> BuildRequestUploadPlanV1:
    """Check the whole request and reserve its remote control directory."""
    val request_wire = encode_build_worker_request_v1(request)
    val ready_wire = encode_build_worker_ready_v1(request)
    if request_wire == "" or ready_wire == "":
        return _upload_reject_v1("request-invalid")
    for item in request.action.inputs.source_inputs:
        if worker_ready_control_collision_v1(item.logical_path):
            return _upload_reject_v1("control-path-collision")
    for item in request.action.inputs.generated_inputs:
        if worker_ready_control_collision_v1(item.logical_path):
            return _upload_reject_v1("control-path-collision")
    for item in request.action.inputs.dependency_outputs:
        if worker_ready_control_collision_v1(item.output_path):
            return _upload_reject_v1("control-path-collision")
    val inputs = if use_cas:
        plan_build_input_sftp_with_cas_v1(config, request.action,
            request.attempt, source_root, cas_root)
    else:
        plan_build_input_sftp_v1(config, request.action,
            request.attempt, source_root)
    if not inputs.valid:
        return _upload_reject_v1(inputs.reason)
    BuildRequestUploadPlanV1(true, "", request_wire,
        sha256_text(request_wire), ready_wire, inputs.remote_attempt_root,
        inputs)

fn plan_build_request_upload_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, source_root: text) -> BuildRequestUploadPlanV1:
    _plan_build_request_upload_v1(config, request, source_root, "", false)

fn plan_build_request_upload_with_cas_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, source_root: text,
        cas_root: text) -> BuildRequestUploadPlanV1:
    _plan_build_request_upload_v1(config, request, source_root, cas_root, true)

fn _transfer_build_request_sftp_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, source_root: text,
        cas_root: text, use_cas: bool,
        local_state_dir: text) -> BuildRequestUploadV1:
    """Upload inputs, request and marker in that order; return no authority."""
    val plan = _plan_build_request_upload_v1(config, request, source_root,
        cas_root, use_cas)
    if not plan.valid:
        return BuildRequestUploadV1(false, plan.reason, "", "")
    val inputs = if use_cas:
        transfer_build_inputs_sftp_with_cas_v1(config, request.action,
            request.attempt, source_root, cas_root, local_state_dir)
    else:
        transfer_build_inputs_sftp_v1(config, request.action,
            request.attempt, source_root, local_state_dir)
    if not inputs.transferred:
        return BuildRequestUploadV1(false, inputs.reason, "", "")
    val created = secure_temp_dir(local_state_dir, "build-request-sftp")
    if created.is_err():
        return BuildRequestUploadV1(false, "request-stage-unavailable", "", "")
    val root = created.unwrap()
    val request_file = root + "/request.wire"
    val ready_file = root + "/ready"
    val batch_file = root + "/transfer.batch"
    val remote_control = plan.remote_attempt_root + "/" +
        BUILD_WORKER_CONTROL_DIRECTORY_V1
    val batch = "mkdir " + remote_control + "\n" +
        "put " + request_file + " " + remote_control + "/request.wire\n" +
        "put " + ready_file + " " + remote_control + "/ready\n"
    if not file_atomic_write(request_file, plan.request_wire) or
       not file_atomic_write(ready_file, plan.ready_wire) or
       not file_atomic_write(batch_file, batch):
        dir_remove_all(root)
        return BuildRequestUploadV1(false, "request-stage-failed", "", "")
    val node = config.node
    val args = ["-F", "none", "-b", batch_file, "-o", "BatchMode=yes",
        "-o", "StrictHostKeyChecking=yes", "-o",
        "UserKnownHostsFile=" + node.known_hosts_path,
        "-o", "GlobalKnownHostsFile=none", "-o", "UpdateHostKeys=no",
        "-o", "IdentityAgent=none", "-o", "IdentitiesOnly=yes",
        "-o", "HostKeyAlias=" + node.worker_id,
        "-o", "ClearAllForwardings=yes", "-o", "ForwardAgent=no",
        "-o", "ForwardX11=no", "-o", "ConnectTimeout=5",
        "-P", node.port.to_text(), "-i", node.identity_path,
        "-S", node.ssh_executable, node.user + "@" + node.host]
    val (stdout, stderr, code) = process_run_bounded(
        config.sftp_executable, args, 300000, 8192)
    val cleaned = dir_remove_all(root)
    if code != 0 or stdout.len() >= 8192 or stderr.len() >= 8192 or
       not cleaned:
        return BuildRequestUploadV1(false, "request-upload-failed", "", "")
    BuildRequestUploadV1(true, "", plan.request_digest,
        plan.remote_attempt_root)

fn transfer_build_request_sftp_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, source_root: text,
        local_state_dir: text) -> BuildRequestUploadV1:
    _transfer_build_request_sftp_v1(config, request, source_root,
        "", false, local_state_dir)

fn transfer_build_request_sftp_with_cas_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, source_root: text,
        cas_root: text, local_state_dir: text) -> BuildRequestUploadV1:
    _transfer_build_request_sftp_v1(config, request, source_root,
        cas_root, true, local_state_dir)

export BuildRequestUploadPlanV1, BuildRequestUploadV1
export plan_build_request_upload_v1, transfer_build_request_sftp_v1
export plan_build_request_upload_with_cas_v1
export transfer_build_request_sftp_with_cas_v1
