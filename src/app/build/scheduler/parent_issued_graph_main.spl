# Restricted installed entrypoint for administrator-issued complete graphs.
use app.io.mod.{get_args}
use std.sffi.platform.{platform_name_raw}
use app.build.scheduler.parent_issued_root.{PARENT_ISSUED_ROOT_V1}
use app.build.scheduler.parent_issued_graph_store.{
    load_issued_parent_graph_v1}
use app.build.scheduler.parent_graph_plan_cli.{run_parent_graph_plan_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}

struct ParentIssuedGraphArgsV1:
    valid: bool
    record_digest: text

fn parse_parent_issued_graph_args_v1(args: [text]) -> ParentIssuedGraphArgsV1:
    var remaining = args
    if remaining.len() > 0 and
       (remaining[0].ends_with("parent_issued_graph_main.spl") or
        remaining[0].ends_with("simple_dist_build_issued_graph_parent")):
        remaining = remaining[1:]
    if remaining.len() > 0 and remaining[0] == "--":
        remaining = remaining[1:]
    if remaining.len() != 2 or remaining[0] != "--issued-plan" or
       not scheduler_action_digest_valid_v1(remaining[1]):
        return ParentIssuedGraphArgsV1(false, "")
    ParentIssuedGraphArgsV1(true, remaining[1])

fn main() -> i64:
    val platform = platform_name_raw()
    if platform != "linux" and platform != "macos":
        print("issued-graph: BLOCKED reason=host-unsupported")
        return 2
    val command = parse_parent_issued_graph_args_v1(get_args())
    if not command.valid:
        print("issued-graph: BLOCKED reason=expected-issued-plan-digest-only")
        return 2
    val loaded = load_issued_parent_graph_v1(PARENT_ISSUED_ROOT_V1,
        command.record_digest)
    if not loaded.valid or loaded.record == nil:
        print("issued-graph: BLOCKED reason=record-unavailable-or-invalid")
        return 1
    val record = loaded.record.unwrap()
    run_parent_graph_plan_v1(record.plan_digest, record.manifest_path,
        record.manifest_digest, record.config_paths)

export ParentIssuedGraphArgsV1, parse_parent_issued_graph_args_v1
