# Fixed binary fixture comparison only. This module cannot qualify a Docker
# lifecycle or produce production verifier evidence. The current provider lacks
# the endpoint and lifecycle observations needed to open an attach source safely.
use std.common.crypto.sha256.{sha256_u8_hex}
use app.build.scheduler.docker_attach_source.{DockerAttachCaptureV1}
use app.build.scheduler.docker_attach_http.{docker_attach_exact_id_v1}

# Fixture contract: stdout = 00 41 ff 0a; stderr = 80 42 00 0a.
# Each stream is exactly four bytes, including its trailing LF and embedded NUL.
# The hashes are independent constants, never derived from captured output.
val DOCKER_ATTACH_FIXTURE_STDOUT_SHA256_V1 = "3b7b5c24762be65b2e2cdb1e260f2acc9e6a3006bb53311cffb7ec84be8c6f9b"
val DOCKER_ATTACH_FIXTURE_STDERR_SHA256_V1 = "0a8a39e7640fc53b98eff618f051488dd0db5bed2fe13833e157a0576db54742"

# An empty result means only that the supplied bytes match this fixture. This
# function does not attest that capture or container identity came from Docker.
fn docker_attach_fixture_bytes_error_v1(expected_container_id: text, capture: DockerAttachCaptureV1) -> text:
    if not docker_attach_exact_id_v1(expected_container_id):
        return "fixture: expected exact lowercase 64-hex container ID"
    if capture.container_id != expected_container_id:
        return "fixture: capture container ID mismatch"
    if not capture.transport_eof:
        return "fixture: transport EOF missing"
    if capture.output_complete:
        return "fixture: unsupported general output completeness claim"
    if capture.decoded.stdout_bytes.len() != 4:
        return "fixture: stdout byte count mismatch"
    if capture.decoded.stderr_bytes.len() != 4:
        return "fixture: stderr byte count mismatch"
    if sha256_u8_hex(capture.decoded.stdout_bytes) != DOCKER_ATTACH_FIXTURE_STDOUT_SHA256_V1:
        return "fixture: stdout SHA256 mismatch"
    if sha256_u8_hex(capture.decoded.stderr_bytes) != DOCKER_ATTACH_FIXTURE_STDERR_SHA256_V1:
        return "fixture: stderr SHA256 mismatch"
    ""

export DOCKER_ATTACH_FIXTURE_STDOUT_SHA256_V1, DOCKER_ATTACH_FIXTURE_STDERR_SHA256_V1
export docker_attach_fixture_bytes_error_v1
