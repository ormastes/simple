# Pure consistency check over copied evidence. Admission here is not a live,
# authenticated N2 result: the caller must prove invocation provenance, retain
# raw receipts, and qualify the complete hook or preflight process tree.
use app.build.scheduler.n2_latency_numeric.{n2_numeric_target_met_v1}
use std.common.crypto.sha256.{sha256_text}

pub struct N2FeedbackFixtureV1:
    kind: text
    fixture_sha256: text
    candidate_tree: text
    source_revision: text
    outgoing_ref_manifest_sha256: text
    runtime_sha256: text
    toolchain_sha256: text
    policy_sha256: text
    host_id: text
    warm: bool
    outgoing_ref_count: i64
    required_gate_digest: text
    required_gate_count: i64

pub struct N2FeedbackSampleV1:
    ordinal: i64
    fixture_sha256: text
    candidate_tree: text
    source_revision: text
    outgoing_ref_manifest_sha256: text
    runtime_sha256: text
    toolchain_sha256: text
    policy_sha256: text
    host_id: text
    warm: bool
    wall_ms: i64
    outcome: text
    executed_gate_digest: text
    executed_gate_count: i64
    peak_memory_kind: text
    peak_memory_bytes: i64
    bytes_transferred: i64
    queue_ms: i64
    admission_ms: i64
    action_ms: i64
    transfer_ms: i64
    publication_ms: i64
    action_cache_hits: i64
    receipt_cache_hits: i64

pub struct N2FeedbackDecisionV1:
    admitted: bool
    reason: text
    sample_count: i64
    p50_ms: i64
    p95_ms: i64
    p99_ms: i64
    numeric_target_met: bool

fn _n2_reject_v1(reason: text, count: i64) -> N2FeedbackDecisionV1:
    N2FeedbackDecisionV1(false, reason, count, -1, -1, -1, false)

fn _n2_hex_v1(value: text, width: i64) -> bool:
    if value.len() != width: return false
    for ch in value.chars():
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return false
    true

fn _n2_tree_v1(value: text) -> bool:
    _n2_hex_v1(value, 40) or _n2_hex_v1(value, 64)

fn _n2_host_v1(value: text) -> bool:
    if value.len() == 0 or value.len() > 128 or value == "." or value == "..":
        return false
    for ch in value.chars():
        if (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
           (ch >= "0" and ch <= "9") or ch == "-" or ch == "_" or ch == ".":
            continue
        return false
    true

fn _n2_bounded_v1(value: i64, maximum: i64) -> bool:
    value >= 0 and value <= maximum

fn _n2_rank_v1(sorted: [i64], percentile: i64) -> i64:
    val rank = (percentile * sorted.len() + 99) / 100
    sorted[rank - 1]

pub fn check_n2_feedback_evidence_v1(fixture: N2FeedbackFixtureV1,
        samples: [N2FeedbackSampleV1]) -> N2FeedbackDecisionV1:
    """Check copied sample consistency; a true result is not live N2 PASS."""
    val count = samples.len()
    if fixture.kind != "staged-hook" and fixture.kind != "pre-push-one-ref" and
       fixture.kind != "warm-preflight":
        return _n2_reject_v1("n2-kind-invalid", count)
    if not _n2_hex_v1(fixture.fixture_sha256, 64) or
       not _n2_tree_v1(fixture.candidate_tree) or
       not _n2_tree_v1(fixture.source_revision) or
       not _n2_hex_v1(fixture.outgoing_ref_manifest_sha256, 64) or
       not _n2_hex_v1(fixture.runtime_sha256, 64) or
       not _n2_hex_v1(fixture.toolchain_sha256, 64) or
       not _n2_hex_v1(fixture.policy_sha256, 64) or
       not _n2_hex_v1(fixture.required_gate_digest, 64) or
       not _n2_host_v1(fixture.host_id):
        return _n2_reject_v1("n2-fixture-invalid", count)
    val empty_refs = sha256_text("")
    if (fixture.kind == "pre-push-one-ref" and
            (fixture.outgoing_ref_count != 1 or
             fixture.outgoing_ref_manifest_sha256 == empty_refs)) or
       (fixture.kind != "pre-push-one-ref" and
            (fixture.outgoing_ref_count != 0 or
             fixture.outgoing_ref_manifest_sha256 != empty_refs)) or
       (fixture.kind == "warm-preflight" and not fixture.warm):
        return _n2_reject_v1("n2-fixture-scope-invalid", count)
    if fixture.required_gate_count <= 0 or fixture.required_gate_count > 4096:
        return _n2_reject_v1("n2-required-gates-invalid", count)
    if count < 20 or count > 1024:
        return _n2_reject_v1("n2-sample-count-invalid", count)

    var sorted: [i64] = []
    var index: i64 = 0
    while index < count:
        val sample = samples[index]
        if sample.ordinal != index + 1:
            return _n2_reject_v1("n2-sample-ordinal-invalid", count)
        if sample.fixture_sha256 != fixture.fixture_sha256 or
           sample.candidate_tree != fixture.candidate_tree or
           sample.source_revision != fixture.source_revision or
           sample.outgoing_ref_manifest_sha256 !=
               fixture.outgoing_ref_manifest_sha256 or
           sample.runtime_sha256 != fixture.runtime_sha256 or
           sample.toolchain_sha256 != fixture.toolchain_sha256 or
           sample.policy_sha256 != fixture.policy_sha256 or
           sample.host_id != fixture.host_id or
           sample.warm != fixture.warm:
            return _n2_reject_v1("n2-sample-binding-invalid", count)
        if sample.outcome != "pass" or
           sample.executed_gate_digest != fixture.required_gate_digest or
           sample.executed_gate_count != fixture.required_gate_count:
            return _n2_reject_v1("n2-sample-gates-invalid", count)
        if sample.peak_memory_kind != "private" and
           sample.peak_memory_kind != "unique" and
           sample.peak_memory_kind != "pss":
            return _n2_reject_v1("n2-memory-kind-invalid", count)
        if not _n2_bounded_v1(sample.wall_ms, 3600000) or
           sample.peak_memory_bytes <= 0 or
           sample.peak_memory_bytes > 1000000000000000 or
           not _n2_bounded_v1(sample.bytes_transferred, 1000000000000000) or
           not _n2_bounded_v1(sample.queue_ms, 3600000) or
           sample.queue_ms > sample.wall_ms or
           not _n2_bounded_v1(sample.admission_ms, 3600000) or
           sample.admission_ms > sample.wall_ms or
           not _n2_bounded_v1(sample.action_ms, 3600000) or
           sample.action_ms > sample.wall_ms or
           not _n2_bounded_v1(sample.transfer_ms, 3600000) or
           sample.transfer_ms > sample.wall_ms or
           not _n2_bounded_v1(sample.publication_ms, 3600000) or
           sample.publication_ms > sample.wall_ms or
           not _n2_bounded_v1(sample.action_cache_hits, 1000000) or
           not _n2_bounded_v1(sample.receipt_cache_hits, 1000000):
            return _n2_reject_v1("n2-sample-metric-invalid", count)
        sorted.push(sample.wall_ms)
        index = index + 1

    # Insertion sort keeps the bounded 20..1024 sample contract self-contained.
    index = 1
    while index < count:
        val value = sorted[index]
        var cursor = index - 1
        while cursor >= 0 and sorted[cursor] > value:
            sorted[cursor + 1] = sorted[cursor]
            cursor = cursor - 1
        sorted[cursor + 1] = value
        index = index + 1
    val p50 = _n2_rank_v1(sorted, 50)
    val p95 = _n2_rank_v1(sorted, 95)
    val p99 = _n2_rank_v1(sorted, 99)
    val met = n2_numeric_target_met_v1(fixture.kind, p95).unwrap()
    if not met:
        return N2FeedbackDecisionV1(false, "n2-numeric-target-missed", count,
            p50, p95, p99, false)
    N2FeedbackDecisionV1(true, "n2-copied-evidence-consistent", count,
        p50, p95, p99, true)

export N2FeedbackFixtureV1, N2FeedbackSampleV1, N2FeedbackDecisionV1
export check_n2_feedback_evidence_v1
