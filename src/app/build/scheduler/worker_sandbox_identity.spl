# Pure identity of the administrator-approved OCI execution profile.
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use std.common.crypto.sha256.{sha256_text}

fn _sandbox_token_v1(value: text) -> bool:
    if value == "" or value.len() > 128 or value == "." or value == ".." or
       value.starts_with("-"):
        return false
    for c in value.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "-" or c == "_" or c == ".":
            continue
        return false
    true

fn _sandbox_path_v1(value: text) -> bool:
    if not value.starts_with("/") or value.len() > 4096 or value.ends_with("/"):
        return false
    val segments = value.split("/")
    var i: i64 = 1
    while i < segments.len():
        if not _sandbox_token_v1(segments[i]): return false
        i = i + 1
    true

fn build_worker_sandbox_digest_v1(image: text, engine: text,
        compiler_entry: text) -> text:
    """Bind the exact image and effective OCI execution profile to the action."""
    val marker = image.index_of("@sha256:")
    if marker < 1 or not scheduler_action_digest_valid_v1(image[marker + 8:]) or
       not ["podman", "docker"].contains(engine) or
       not _sandbox_path_v1(compiler_entry):
        return ""
    sha256_text("simple-build-sandbox-v1\n" +
        "engine=" + engine + "\nimage=" + image + "\n" +
        "entrypoint=" + compiler_entry + "\nnetwork=none\n" +
        "filesystem=read-only\ninputs=/simple-build/inputs:ro\n" +
        "outputs=/simple-build/outputs:rw\nworkdir=/simple-build/outputs\n")

export build_worker_sandbox_digest_v1
