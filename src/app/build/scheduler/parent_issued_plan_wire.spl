# Canonical content for one administrator-issued staged build launch record.
# Parsing this wire checks shape only; trusted-root lookup and publication are
# separate authority boundaries. V1 paths are restricted POSIX absolutes.
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}

val PARENT_ISSUED_PLAN_MAX_BYTES_V1: i64 = 131072
val PARENT_ISSUED_PLAN_MAX_CONFIGS_V1: i64 = 16

struct ParentIssuedPlanWireV1:
    valid: bool
    reason: text
    plan_digest: text
    template_path: text
    template_digest: text
    config_paths: [text]

fn _issued_reject_v1(reason: text) -> ParentIssuedPlanWireV1:
    ParentIssuedPlanWireV1(false, reason, "", "", "", [])

fn _issued_path_token_v1(value: text) -> bool:
    if value == "" or value.len() > 128 or value == "." or value == ".." or
       value.starts_with("-"):
        return false
    for ch in value.chars():
        if (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
           (ch >= "0" and ch <= "9") or ch == "-" or ch == "_" or ch == ".":
            continue
        return false
    true

fn issued_plan_path_valid_v1(path: text) -> bool:
    if not path.starts_with("/") or path.len() < 2 or path.len() > 4096 or
       path.ends_with("/"):
        return false
    val parts = path.split("/")
    var i: i64 = 1
    while i < parts.len():
        if not _issued_path_token_v1(parts[i]): return false
        i = i + 1
    true

fn encode_parent_issued_plan_wire_v1(plan_digest: text,
        template_path: text, template_digest: text,
        config_paths: [text]) -> text:
    if not scheduler_action_digest_valid_v1(plan_digest) or
       not scheduler_action_digest_valid_v1(template_digest) or
       not issued_plan_path_valid_v1(template_path) or
       config_paths.len() == 0 or
       config_paths.len() > PARENT_ISSUED_PLAN_MAX_CONFIGS_V1:
        return ""
    var seen: [text] = []
    var wire = "simple-parent-staged-launch-v1\n" +
        "plan-digest=" + plan_digest + "\n" +
        "template=" + template_digest + "|" + template_path + "\n" +
        "config-count=" + config_paths.len().to_text() + "\n"
    for path in config_paths:
        if not issued_plan_path_valid_v1(path) or seen.contains(path): return ""
        seen.push(path)
        wire = wire + "config=" + path + "\n"
    if wire.len() > PARENT_ISSUED_PLAN_MAX_BYTES_V1: return ""
    wire

fn parse_parent_issued_plan_wire_v1(wire: text) -> ParentIssuedPlanWireV1:
    if wire.len() == 0 or wire.len() > PARENT_ISSUED_PLAN_MAX_BYTES_V1 or
       not wire.ends_with("\n") or wire.contains("\r") or
       wire.contains("\x00"):
        return _issued_reject_v1("issued-plan-wire-invalid")
    val lines = wire[0:wire.len() - 1].split("\n")
    if lines.len() < 5 or
       lines[0] != "simple-parent-staged-launch-v1" or
       not lines[1].starts_with("plan-digest=") or
       not lines[2].starts_with("template=") or
       not lines[3].starts_with("config-count="):
        return _issued_reject_v1("issued-plan-shape-invalid")
    val plan_digest = lines[1][12:]
    val template_fields = lines[2][9:].split("|")
    val count_text = lines[3][13:]
    if template_fields.len() != 2 or count_text == "" or
       count_text.len() > 2:
        return _issued_reject_v1("issued-plan-fields-invalid")
    for ch in count_text.chars():
        if ch < "0" or ch > "9":
            return _issued_reject_v1("issued-plan-count-invalid")
    val count = count_text.to_i64() ?? -1
    if count < 1 or count > PARENT_ISSUED_PLAN_MAX_CONFIGS_V1 or
       count.to_text() != count_text or lines.len() != count + 4:
        return _issued_reject_v1("issued-plan-count-invalid")
    var paths: [text] = []
    var i: i64 = 4
    while i < lines.len():
        if not lines[i].starts_with("config="):
            return _issued_reject_v1("issued-plan-config-invalid")
        paths.push(lines[i][7:])
        i = i + 1
    val canonical = encode_parent_issued_plan_wire_v1(plan_digest,
        template_fields[1], template_fields[0], paths)
    if canonical == "" or canonical != wire:
        return _issued_reject_v1("issued-plan-noncanonical")
    ParentIssuedPlanWireV1(true, "", plan_digest,
        template_fields[1], template_fields[0], paths)

export PARENT_ISSUED_PLAN_MAX_BYTES_V1, PARENT_ISSUED_PLAN_MAX_CONFIGS_V1
export ParentIssuedPlanWireV1, encode_parent_issued_plan_wire_v1
export parse_parent_issued_plan_wire_v1
export issued_plan_path_valid_v1
