# Invoke one preinstalled Simple build worker on a pinned trusted SSH node.
# The request file is transferred separately; the worker must verify its full
# contents and ready marker before execution. This transport only accepts a
# bounded result claim. The parent owner still decides publication.
use app.io.mod.{process_run_bounded}
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1,
    trusted_ssh_node_problem_v1}
use app.build.scheduler.dispatch_wire.{BuildResultEnvelopeV1,
    parse_build_dispatch_v1, parse_build_result_v1,
    BUILD_DISPATCH_WIRE_MAX_V1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use app.build.scheduler.worker_capability.{BuildWorkerCapabilityV1,
    parse_build_worker_capability_v1}

struct TrustedWorkerCommandV1:
    node: TrustedSshNodeV1
    remote_executable: text
    timeout_ms: i64

struct BuildWorkerInvocationV1:
    valid: bool
    reason: text
    args: [text]

struct BuildWorkerReplyV1:
    received: bool
    reason: text
    result: BuildResultEnvelopeV1?
    result_wire: text

struct BuildWorkerCancelAckV1:
    acknowledged: bool
    reason: text

struct BuildWorkerCleanupReplyV1:
    acknowledged: bool
    reason: text

struct BuildWorkerCapabilityReplyV1:
    received: bool
    reason: text
    capability: BuildWorkerCapabilityV1?

fn _worker_command_segment_v1(segment: text) -> bool:
    if segment == "" or segment == "." or segment == ".." or
       segment.len() > 128 or segment.starts_with("-"):
        return false
    for c in segment.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "_" or c == "-" or c == ".":
            continue
        return false
    true

fn _worker_command_path_v1(path: text) -> bool:
    if not path.starts_with("/") or path.len() < 2 or path.len() > 4096 or
       path.ends_with("/") or path.contains("//"):
        return false
    val parts = path.split("/")
    var i: i64 = 1
    while i < parts.len():
        if not _worker_command_segment_v1(parts[i]):
            return false
        i = i + 1
    true

fn _worker_invocation_reject_v1(reason: text) -> BuildWorkerInvocationV1:
    BuildWorkerInvocationV1(false, reason, [])

fn plan_build_worker_capability_ssh_v1(config: TrustedWorkerCommandV1,
        nonce: text) -> BuildWorkerInvocationV1:
    """Query the fixed remote worker through pinned SSH before dispatch."""
    if not scheduler_action_digest_valid_v1(nonce):
        return _worker_invocation_reject_v1("nonce-invalid")
    if not _worker_command_path_v1(config.remote_executable) or
       config.timeout_ms < 1000 or config.timeout_ms > 3600000:
        return _worker_invocation_reject_v1("worker-command-invalid")
    val node_problem = trusted_ssh_node_problem_v1(config.node)
    if node_problem != "":
        return _worker_invocation_reject_v1("node-" + node_problem)
    val node = config.node
    val args = ["-F", "none", "-o", "BatchMode=yes", "-o",
        "StrictHostKeyChecking=yes", "-o",
        "UserKnownHostsFile=" + node.known_hosts_path, "-o",
        "GlobalKnownHostsFile=none", "-o", "UpdateHostKeys=no", "-o",
        "IdentityAgent=none", "-o", "IdentitiesOnly=yes", "-o",
        "HostKeyAlias=" + node.worker_id, "-o", "ClearAllForwardings=yes",
        "-o", "ForwardAgent=no", "-o", "ForwardX11=no", "-o",
        "ConnectTimeout=5", "-p", node.port.to_text(), "-i",
        node.identity_path, "-l", node.user, "-T", "-n", "--", node.host,
        config.remote_executable, "--capabilities", "--nonce", nonce]
    BuildWorkerInvocationV1(true, "", args)

fn query_build_worker_capability_ssh_v1(config: TrustedWorkerCommandV1,
        nonce: text) -> BuildWorkerCapabilityReplyV1:
    """Accept only a current nonce-bound report from the pinned SSH endpoint."""
    val plan = plan_build_worker_capability_ssh_v1(config, nonce)
    if not plan.valid:
        return BuildWorkerCapabilityReplyV1(false, plan.reason, nil)
    val (stdout, stderr, code) = process_run_bounded(
        config.node.ssh_executable, plan.args, config.timeout_ms, 8192)
    if code != 0 or stdout.len() == 0 or stdout.len() > 4096 or
       stderr.len() >= 8192:
        return BuildWorkerCapabilityReplyV1(false, "worker-capability-unavailable", nil)
    val parsed = parse_build_worker_capability_v1(stdout)
    if parsed == nil:
        return BuildWorkerCapabilityReplyV1(false, "worker-capability-invalid", nil)
    val cap = parsed.unwrap()
    if cap.worker_id != config.node.worker_id or cap.nonce != nonce:
        return BuildWorkerCapabilityReplyV1(false, "worker-capability-mismatch", nil)
    BuildWorkerCapabilityReplyV1(true, "", cap)

fn plan_build_worker_ssh_v1(config: TrustedWorkerCommandV1,
        dispatch_wire: text, request_digest: text) -> BuildWorkerInvocationV1:
    """Build a fixed remote command from a validated dispatch and local policy."""
    val dispatch = parse_build_dispatch_v1(dispatch_wire)
    if dispatch == nil:
        return _worker_invocation_reject_v1("dispatch-invalid")
    val envelope = dispatch.unwrap()
    if envelope.worker_id != config.node.worker_id or
       not scheduler_action_digest_valid_v1(request_digest):
        return _worker_invocation_reject_v1("worker-or-request-mismatch")
    if not _worker_command_path_v1(config.remote_executable) or
       config.timeout_ms < 1000 or config.timeout_ms > 3600000:
        return _worker_invocation_reject_v1("worker-command-invalid")
    val node_problem = trusted_ssh_node_problem_v1(config.node)
    if node_problem != "":
        return _worker_invocation_reject_v1("node-" + node_problem)
    # OpenSSH sends the suffix through the remote account's shell. Every
    # interpolated token is restricted to plain shell-safe ASCII above or by
    # parse_build_dispatch_v1; the executable is never taken from a request.
    val node = config.node
    val args = ["-F", "none", "-o", "BatchMode=yes", "-o",
        "StrictHostKeyChecking=yes", "-o",
        "UserKnownHostsFile=" + node.known_hosts_path, "-o",
        "GlobalKnownHostsFile=none", "-o", "UpdateHostKeys=no", "-o",
        "IdentityAgent=none", "-o", "IdentitiesOnly=yes", "-o",
        "HostKeyAlias=" + node.worker_id, "-o", "ClearAllForwardings=yes",
        "-o", "ForwardAgent=no", "-o", "ForwardX11=no", "-o",
        "ConnectTimeout=5", "-p", node.port.to_text(), "-i",
        node.identity_path, "-l", node.user, "-T", "-n", "--", node.host,
        config.remote_executable, "--attempt", envelope.attempt_id,
        "--request-digest", request_digest]
    BuildWorkerInvocationV1(true, "", args)

fn invoke_build_worker_ssh_v1(config: TrustedWorkerCommandV1,
        dispatch_wire: text, request_digest: text) -> BuildWorkerReplyV1:
    """Return a matching worker claim; never accept or publish its outputs."""
    val plan = plan_build_worker_ssh_v1(config, dispatch_wire, request_digest)
    if not plan.valid:
        return BuildWorkerReplyV1(false, plan.reason, nil, "")
    val (stdout, stderr, code) = process_run_bounded(
        config.node.ssh_executable, plan.args, config.timeout_ms, 8192)
    if code != 0 or stdout.len() == 0 or
       stdout.len() > BUILD_DISPATCH_WIRE_MAX_V1 or stderr.len() >= 8192:
        return BuildWorkerReplyV1(false, "worker-command-failed", nil, "")
    validate_build_worker_reply_v1(dispatch_wire, stdout)

fn plan_build_worker_status_ssh_v1(config: TrustedWorkerCommandV1,
        dispatch_wire: text, request_digest: text) -> BuildWorkerInvocationV1:
    """Query the pinned worker for an existing result without executing it."""
    val launch = plan_build_worker_ssh_v1(config, dispatch_wire, request_digest)
    if not launch.valid:
        return launch
    var args = launch.args[0:launch.args.len() - 4]
    args.push("--status")
    for item in launch.args[launch.args.len() - 4:]:
        args.push(item)
    BuildWorkerInvocationV1(true, "", args)

fn status_build_worker_ssh_v1(config: TrustedWorkerCommandV1,
        dispatch_wire: text, request_digest: text) -> BuildWorkerReplyV1:
    """Read a stopped worker's candidate; never issue a second launch."""
    val plan = plan_build_worker_status_ssh_v1(config, dispatch_wire,
        request_digest)
    if not plan.valid:
        return BuildWorkerReplyV1(false, plan.reason, nil, "")
    val (stdout, stderr, code) = process_run_bounded(
        config.node.ssh_executable, plan.args, config.timeout_ms, 8192)
    if code != 0 or stdout.len() == 0 or
       stdout.len() > BUILD_DISPATCH_WIRE_MAX_V1 or stderr.len() >= 8192:
        return BuildWorkerReplyV1(false, "worker-status-unavailable", nil, "")
    validate_build_worker_reply_v1(dispatch_wire, stdout)

fn plan_build_worker_cancel_ssh_v1(config: TrustedWorkerCommandV1,
        dispatch_wire: text, request_digest: text) -> BuildWorkerInvocationV1:
    """Ask the fixed worker to tombstone an unstarted fenced attempt."""
    val launch = plan_build_worker_ssh_v1(config, dispatch_wire, request_digest)
    val dispatch = parse_build_dispatch_v1(dispatch_wire)
    if not launch.valid or dispatch == nil:
        return launch
    var args = launch.args[0:launch.args.len() - 4]
    args.push("--cancel")
    for item in launch.args[launch.args.len() - 4:]:
        args.push(item)
    args.push("--fence")
    args.push(dispatch.unwrap().fence.to_text())
    BuildWorkerInvocationV1(true, "", args)

fn cancel_unstarted_build_worker_ssh_v1(config: TrustedWorkerCommandV1,
        dispatch_wire: text, request_digest: text) -> BuildWorkerCancelAckV1:
    """Accept only an exact durable tombstone acknowledgement from pinned SSH."""
    val plan = plan_build_worker_cancel_ssh_v1(config, dispatch_wire,
        request_digest)
    val dispatch = parse_build_dispatch_v1(dispatch_wire)
    if not plan.valid or dispatch == nil:
        return BuildWorkerCancelAckV1(false, "cancel-plan-invalid")
    val expected = "simple-build-cancelled-v1|" +
        dispatch.unwrap().attempt_id + "|" + request_digest + "|" +
        dispatch.unwrap().fence.to_text() + "\n"
    val (stdout, stderr, code) = process_run_bounded(
        config.node.ssh_executable, plan.args, config.timeout_ms, 8192)
    if code != 0 or stdout != expected or stderr.len() >= 8192:
        return BuildWorkerCancelAckV1(false, "cancel-not-acknowledged")
    BuildWorkerCancelAckV1(true, "")

fn plan_build_worker_cleanup_ssh_v1(config: TrustedWorkerCommandV1,
        dispatch_wire: text, request_digest: text,
        result_digest: text) -> BuildWorkerInvocationV1:
    """Construct only the pinned, identity-bound cleanup command."""
    val launch = plan_build_worker_ssh_v1(config, dispatch_wire, request_digest)
    val dispatch = parse_build_dispatch_v1(dispatch_wire)
    if not launch.valid: return launch
    if dispatch == nil or not scheduler_action_digest_valid_v1(result_digest):
        return _worker_invocation_reject_v1("cleanup-result-invalid")
    var args = launch.args[0:launch.args.len() - 4]
    args.push("--ack")
    for item in launch.args[launch.args.len() - 4:]: args.push(item)
    args.push("--fence")
    args.push(dispatch.unwrap().fence.to_text())
    args.push("--result-digest")
    args.push(result_digest)
    BuildWorkerInvocationV1(true, "", args)

fn acknowledge_build_worker_cleanup_ssh_v1(config: TrustedWorkerCommandV1,
        dispatch_wire: text, request_digest: text,
        result_digest: text) -> BuildWorkerCleanupReplyV1:
    """Accept only the exact durable ACK from the pinned worker."""
    val plan = plan_build_worker_cleanup_ssh_v1(config, dispatch_wire,
        request_digest, result_digest)
    val dispatch = parse_build_dispatch_v1(dispatch_wire)
    if not plan.valid or dispatch == nil:
        return BuildWorkerCleanupReplyV1(false, "cleanup-plan-invalid")
    val expected = "simple-build-cleaned-v1|" +
        dispatch.unwrap().attempt_id + "|" + request_digest + "|" +
        dispatch.unwrap().fence.to_text() + "|" + result_digest + "\n"
    val (stdout, stderr, code) = process_run_bounded(
        config.node.ssh_executable, plan.args, config.timeout_ms, 8192)
    if code != 0 or stdout != expected or stderr.len() >= 8192:
        return BuildWorkerCleanupReplyV1(false, "cleanup-not-acknowledged")
    BuildWorkerCleanupReplyV1(true, "")

fn validate_build_worker_reply_v1(dispatch_wire: text,
        result_wire: text) -> BuildWorkerReplyV1:
    """Bind a candidate to this dispatch before owner-side validation."""
    val expected = parse_build_dispatch_v1(dispatch_wire)
    if expected == nil:
        return BuildWorkerReplyV1(false, "dispatch-invalid", nil, "")
    val result = parse_build_result_v1(result_wire)
    if result == nil:
        return BuildWorkerReplyV1(false, "worker-result-invalid", nil, "")
    val reply = result.unwrap()
    val dispatch = expected.unwrap()
    if reply.candidate.action_digest != dispatch.action_digest or
       reply.candidate.attempt_id != dispatch.attempt_id or
       reply.candidate.worker_id != dispatch.worker_id or
       reply.fence != dispatch.fence:
        return BuildWorkerReplyV1(false, "worker-result-mismatch", nil, "")
    BuildWorkerReplyV1(true, "", reply, result_wire)

export TrustedWorkerCommandV1, BuildWorkerInvocationV1, BuildWorkerReplyV1
export plan_build_worker_ssh_v1, invoke_build_worker_ssh_v1
export plan_build_worker_status_ssh_v1, status_build_worker_ssh_v1
export BuildWorkerCancelAckV1, plan_build_worker_cancel_ssh_v1
export cancel_unstarted_build_worker_ssh_v1
export BuildWorkerCleanupReplyV1, plan_build_worker_cleanup_ssh_v1
export acknowledge_build_worker_cleanup_ssh_v1
export validate_build_worker_reply_v1
export BuildWorkerCapabilityReplyV1, plan_build_worker_capability_ssh_v1
export query_build_worker_capability_ssh_v1
