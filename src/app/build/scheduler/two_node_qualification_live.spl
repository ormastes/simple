# Operator-only live graph qualification. Approval and native digest come from
# administrator policy, not the candidate graph or a worker response.
use app.io.mod.{file_is_regular_no_follow, file_hash_sha256,
    file_size_raw, file_copy, file_fsync, secure_temp_dir, dir_remove_all,
    process_run_bounded, time_now_unix_micros}
use std.nogc_sync_mut.package_sffi.{set_permissions}
use std.nogc_sync_mut.io.crypto_sffi.{random_hex}
use app.build.scheduler.parent_issued_root.{PARENT_ISSUED_ROOT_V1}
use app.build.scheduler.parent_issued_graph_store.{load_issued_parent_graph_v1}
use app.build.scheduler.parent_graph_plan_cli.{load_parent_graph_plan_v1}
use app.build.scheduler.parent_graph_plan.{prepare_parent_graph_plan_v1}
use app.build.scheduler.parent_graph_request.{ParentGraphRequestV1}
use app.build.scheduler.trusted_worker_invocation.{
    query_build_worker_capability_ssh_v1}
use app.build.scheduler.two_node_qualification.{TwoNodeQualificationV1,
    audit_two_node_graph_v1}
use app.build.scheduler.owner.{scheduler_owner_open_v1,
    scheduler_owner_close_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}

struct TwoNodeLiveFixtureV1:
    native_path: text
    native_digest: text
    issued_record_digest: text
    producer_digest: text
    consumer_digest: text
    producer_worker: text
    consumer_worker: text
    producer_output: text
    producer_output_digest: text
    consumer_output: text
    consumer_output_digest: text

struct TwoNodeLiveQualificationV1:
    status: text
    reason: text
    native_digest: text
    producer_provider: text
    consumer_provider: text
    producer_attempt: text
    consumer_attempt: text
    attempt_count: i64
    elapsed_ms: i64

fn _live_blocked_v1(reason: text) -> TwoNodeLiveQualificationV1:
    TwoNodeLiveQualificationV1("BLOCKED", reason, "", "", "", "", "", 0, 0)

fn _live_audit_v1(fixture: TwoNodeLiveFixtureV1,
        graph: ParentGraphRequestV1,
        owner_root: text, cas_root: text) -> TwoNodeQualificationV1:
    audit_two_node_graph_v1(owner_root, graph, cas_root,
        fixture.producer_digest, fixture.consumer_digest,
        fixture.producer_worker, fixture.consumer_worker,
        fixture.producer_output, fixture.producer_output_digest,
        fixture.consumer_output, fixture.consumer_output_digest)

fn two_node_proposed_attempt_v1(output: text, action_digest: text) -> text:
    val prefix = "parent-graph: PROPOSED attempt="
    val suffix = " action=" + action_digest
    var result = ""
    for line in output.split("\n"):
        if line.starts_with(prefix) and line.ends_with(suffix):
            val attempt = line[prefix.len():line.len() - suffix.len()]
            if attempt == "" or result != "": return ""
            result = attempt
    result

fn qualify_issued_two_node_graph_v1(
        fixture: TwoNodeLiveFixtureV1) -> TwoNodeLiveQualificationV1:
    """Run a cold issued graph twice and inspect durable independent evidence.

    This must run as an unprivileged operator on a provisioned Linux/macOS
    controller with two authenticated Linux OCI workers. It cannot provision
    policy, grant credentials or turn absent fixtures into a passing result.
    """
    if not fixture.native_path.ends_with(
            "/simple_dist_build_issued_graph_parent") or
       not scheduler_action_digest_valid_v1(fixture.native_digest) or
       not scheduler_action_digest_valid_v1(fixture.issued_record_digest) or
       not file_is_regular_no_follow(fixture.native_path) or
       file_size_raw(fixture.native_path) <= 0 or
       file_size_raw(fixture.native_path) > 536870912 or
       file_hash_sha256(fixture.native_path) != fixture.native_digest:
        return _live_blocked_v1("issued-native-unavailable-or-unpinned")
    val issued = load_issued_parent_graph_v1(PARENT_ISSUED_ROOT_V1,
        fixture.issued_record_digest)
    if not issued.valid or issued.record == nil:
        return _live_blocked_v1("issued-graph-record-unavailable")
    val record = issued.record.unwrap()
    val loaded = load_parent_graph_plan_v1(record.plan_digest,
        record.manifest_path, record.manifest_digest, record.config_paths)
    if not loaded.valid or loaded.plan == nil:
        return _live_blocked_v1("issued-graph-preflight-invalid")
    val prepared = prepare_parent_graph_plan_v1(loaded.plan.unwrap(),
        loaded.manifest_wire, loaded.request_wires)
    if not prepared.valid or prepared.graph == nil or
       prepared.workers.len() != 2 or
       prepared.graph.unwrap().actions.len() != 2:
        return _live_blocked_v1("two-node-graph-invalid")
    # The issued config order is not the graph's producer/consumer order.
    var producer_index: i64 = -1
    var consumer_index: i64 = -1
    var worker_index: i64 = 0
    while worker_index < prepared.workers.len():
        val worker_id = prepared.workers[worker_index].node.ssh.node.worker_id
        if worker_id == fixture.producer_worker:
            producer_index = worker_index
        if worker_id == fixture.consumer_worker:
            consumer_index = worker_index
        worker_index = worker_index + 1
    if fixture.producer_worker == "" or fixture.consumer_worker == "" or
       producer_index < 0 or consumer_index < 0 or
       producer_index == consumer_index:
        return _live_blocked_v1("two-node-policy-mismatch")
    val first = prepared.workers[producer_index]
    val second = prepared.workers[consumer_index]
    if first.owner_root != second.owner_root or
       first.node.retained_cas_root != second.node.retained_cas_root:
        return _live_blocked_v1("two-node-policy-mismatch")
    val first_nonce = random_hex(32) ?? ""
    val second_nonce = random_hex(32) ?? ""
    val first_cap = query_build_worker_capability_ssh_v1(first.node.ssh,
        first_nonce)
    val second_cap = query_build_worker_capability_ssh_v1(second.node.ssh,
        second_nonce)
    if not first_cap.received or first_cap.capability == nil or
       not second_cap.received or second_cap.capability == nil:
        return _live_blocked_v1("two-worker-capability-unavailable")
    val producer_cap = first_cap.capability.unwrap()
    val consumer_cap = second_cap.capability.unwrap()
    if producer_cap.execution_os != "linux" or
       consumer_cap.execution_os != "linux" or
       producer_cap.provider_id != "linux-oci-v1" or
       consumer_cap.provider_id != "linux-oci-v1" or
       producer_cap.image == "" or consumer_cap.image == "":
        return _live_blocked_v1("two-worker-oci-provider-unqualified")
    val owner = scheduler_owner_open_v1(first.owner_root)
    if owner.error != "" or owner.state.error != "":
        return _live_blocked_v1("owner-unavailable")
    val prior_attempts = owner.state.ledger.attempts.len()
    val prior_accepts = owner.state.ledger.accepted.len()
    val prior_failures = owner.state.ledger.failures.len()
    val prior_fences = owner.state.ledger.fences.len()
    if not scheduler_owner_close_v1(owner):
        return _live_blocked_v1("owner-release-failed")
    if prior_attempts != 0 or prior_accepts != 0 or prior_failures != 0 or
       prior_fences != 0:
        return _live_blocked_v1("dedicated-cold-owner-not-empty")
    # Capture exact approved bytes in a private directory before execution.
    # The administrator-owned source path and ancestors must remain immutable
    # during capture; hashing the captured copy admits only approved bytes.
    val stage_result = secure_temp_dir("/tmp", "simple-dist-qual-")
    if stage_result.is_err():
        return _live_blocked_v1("native-capture-unavailable")
    val stage = stage_result.unwrap()
    val captured = stage + "/simple_dist_build_issued_graph_parent"
    val private_mode: i64 = 0o700
    if not file_copy(fixture.native_path, captured) or
       not file_is_regular_no_follow(captured) or
       file_size_raw(captured) <= 0 or
       file_size_raw(captured) > 536870912 or
       file_hash_sha256(captured) != fixture.native_digest or
       not set_permissions(captured, private_mode.to_i32()) or
       not file_fsync(captured):
        dir_remove_all(stage)
        return _live_blocked_v1("native-capture-mismatch")
    val started = time_now_unix_micros()
    val (_first_out, _first_err, first_code) = process_run_bounded(
        captured,
        ["--issued-plan", fixture.issued_record_digest], 900000, 8192)
    if first_code != 0 or _first_out.len() >= 8192 or
       _first_err.len() >= 8192:
        dir_remove_all(stage)
        return _live_blocked_v1("issued-graph-first-run-incomplete")
    val first_audit = _live_audit_v1(fixture, prepared.graph.unwrap(),
        first.owner_root, first.node.retained_cas_root)
    if first_audit.status != "AUDIT_READY":
        dir_remove_all(stage)
        return _live_blocked_v1("first-run-audit: " + first_audit.reason)
    val proposed_producer = two_node_proposed_attempt_v1(_first_out,
        fixture.producer_digest)
    val proposed_consumer = two_node_proposed_attempt_v1(_first_out,
        fixture.consumer_digest)
    if proposed_producer == "" or proposed_consumer == "" or
       proposed_producer != first_audit.producer_attempt or
       proposed_consumer != first_audit.consumer_attempt or
       _first_out.contains("parent-graph: RESUMING"):
        dir_remove_all(stage)
        return _live_blocked_v1("cold-attempt-attribution-mismatch")
    val (_second_out, _second_err, second_code) = process_run_bounded(
        captured,
        ["--issued-plan", fixture.issued_record_digest], 900000, 8192)
    if second_code != 0 or _second_out.len() >= 8192 or
       _second_err.len() >= 8192:
        dir_remove_all(stage)
        return _live_blocked_v1("issued-graph-repeat-incomplete")
    val repeat = _live_audit_v1(fixture, prepared.graph.unwrap(),
        first.owner_root, first.node.retained_cas_root)
    if repeat.status != "AUDIT_READY" or
       repeat.durable_attempt_count != first_audit.durable_attempt_count or
       repeat.durable_accepted_count != first_audit.durable_accepted_count or
       repeat.producer_attempt != first_audit.producer_attempt or
       repeat.consumer_attempt != first_audit.consumer_attempt or
       _second_out.contains("parent-graph: PROPOSED") or
       _second_out.contains("parent-graph: RESUMING"):
        dir_remove_all(stage)
        return _live_blocked_v1("repeat-created-attempt-or-lost-evidence")
    if not dir_remove_all(stage):
        return _live_blocked_v1("captured-native-cleanup-incomplete")
    val elapsed = (time_now_unix_micros() - started) / 1000
    TwoNodeLiveQualificationV1("PASS", "cold-graph-and-repeat-admitted",
        fixture.native_digest, producer_cap.engine + ":" +
            producer_cap.provider_id, consumer_cap.engine + ":" +
            consumer_cap.provider_id, repeat.producer_attempt,
        repeat.consumer_attempt, repeat.durable_attempt_count, elapsed)

export TwoNodeLiveFixtureV1, TwoNodeLiveQualificationV1
export qualify_issued_two_node_graph_v1, two_node_proposed_attempt_v1
