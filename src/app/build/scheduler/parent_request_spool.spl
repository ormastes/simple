# Durable parent copy of the exact request, written after journal admission and
# before any network transfer. The scheduler owner exclusively holds the root.
# A missing spool after restart proves this driver did not begin upload.
use app.io.mod.{dir_create_all, directory_fsync, file_create_exclusive,
    file_exists, file_fsync, file_read_regular_no_follow_bounded,
    file_is_regular_no_follow, file_size_raw, file_read}
use app.build.scheduler.owner.{SchedulerOwnerV1}
use app.build.scheduler.ledger.{SchedulerAttemptV1, SchedulerLedgerV1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    BUILD_WORKER_REQUEST_MAX_BYTES_V1, encode_build_worker_request_v1,
    parse_build_worker_request_v1}
use std.common.crypto.sha256.{sha256_text}

struct BuildParentRequestSpoolV1:
    persisted: bool
    reason: text
    request_digest: text

struct BuildParentRequestRecoveryV1:
    recovered: bool
    reason: text
    request: BuildWorkerRequestV1?
    request_digest: text

fn _parent_request_matches_attempt_fields_v1(request: BuildWorkerRequestV1,
        attempt: SchedulerAttemptV1) -> bool:
    """Check all dispatch facts persisted in the fenced scheduler ledger."""
    request.attempt.action_digest == attempt.action_digest and
        request.attempt.attempt_id == attempt.attempt_id and
        request.attempt.worker_id == attempt.worker_id and
        request.attempt.memory_budget_bytes == attempt.memory_bytes and
        request.fence == attempt.fence and
        request.cpu_tokens == attempt.cpu_tokens and
        request.fd_tokens == attempt.fd_tokens and
        encode_build_worker_request_v1(request) != ""

fn parent_request_matches_active_attempt_v1(request: BuildWorkerRequestV1,
        attempt: SchedulerAttemptV1) -> bool:
    attempt.active and _parent_request_matches_attempt_fields_v1(request,
        attempt)

fn parent_request_matches_completed_attempt_v1(request: BuildWorkerRequestV1,
        ledger: SchedulerLedgerV1) -> bool:
    """Require one matching inactive attempt and durable result publication.

    Cancellation and unrelated infrastructure failures do not prove the
    worker produced a result, so neither authorizes an acknowledgement.
    """
    var matched_attempts = 0
    for attempt in ledger.attempts:
        if attempt.attempt_id == request.attempt.attempt_id:
            if attempt.active or
               not _parent_request_matches_attempt_fields_v1(request, attempt):
                return false
            matched_attempts = matched_attempts + 1
    if matched_attempts != 1:
        return false
    var completed = 0
    for accepted in ledger.accepted:
        if accepted.accepted_attempt_id == request.attempt.attempt_id and
           accepted.action_digest == request.attempt.action_digest and
           accepted.version == 1 and
           scheduler_action_digest_valid_v1(accepted.output_manifest_digest) and
           scheduler_action_digest_valid_v1(accepted.broker_receipt_digest):
            completed = completed + 1
    for failure in ledger.failures:
        if failure.attempt_id == request.attempt.attempt_id and
           failure.action_digest == request.attempt.action_digest and
           failure.worker_id == request.attempt.worker_id and
           failure.fence == request.fence and
           ["compiler-failure", "action-failure-unclassified"].contains(
               failure.classification) and
           scheduler_action_digest_valid_v1(failure.diagnostic_digest):
            completed = completed + 1
    completed == 1

fn _parent_request_path_v1(owner: SchedulerOwnerV1,
        attempt_id: text) -> text:
    owner.root + "/requests/" + attempt_id + ".wire"

fn _parent_intent_path_v1(owner: SchedulerOwnerV1,
        attempt_id: text) -> text:
    owner.root + "/requests/" + attempt_id + ".intent"

fn _parent_intent_token_v1(value: text) -> bool:
    if value == "" or value == "." or value == ".." or value.len() > 128:
        return false
    for c in value.chars():
        if not ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
               (c >= "0" and c <= "9") or c == "_" or c == "-" or c == "."):
            return false
    true

fn _parent_intent_wire_v1(action_digest: text, attempt_id: text,
        worker_id: text) -> text:
    "simple-build-intent-v1\naction=" + action_digest +
        "\nattempt=" + attempt_id + "\nworker=" + worker_id +
        "\nspool-before-upload=1\n"

fn persist_parent_build_intent_v1(owner: SchedulerOwnerV1,
        action_digest: text, attempt_id: text,
        worker_id: text) -> BuildParentRequestSpoolV1:
    """Reserve a unique attempt ID with the spool-first protocol before admission."""
    if owner.lock_handle < 0 or owner.error != "" or owner.state.error != "" or
       not scheduler_action_digest_valid_v1(action_digest) or
       not _parent_intent_token_v1(attempt_id) or
       not _parent_intent_token_v1(worker_id):
        return BuildParentRequestSpoolV1(false, "intent-invalid", "")
    for attempt in owner.state.ledger.attempts:
        if attempt.attempt_id == attempt_id:
            return BuildParentRequestSpoolV1(false, "attempt-already-admitted", "")
    val directory = owner.root + "/requests"
    val created = not file_exists(directory)
    if not dir_create_all(directory) or
       (created and not directory_fsync(owner.root)):
        return BuildParentRequestSpoolV1(false, "intent-directory-not-durable", "")
    val wire = _parent_intent_wire_v1(action_digest, attempt_id, worker_id)
    val path = _parent_intent_path_v1(owner, attempt_id)
    if not file_create_exclusive(path, wire):
        return BuildParentRequestSpoolV1(false, "intent-collision", "")
    if not file_fsync(path) or not directory_fsync(directory):
        return BuildParentRequestSpoolV1(false, "intent-not-durable", "")
    BuildParentRequestSpoolV1(true, "", sha256_text(wire))

fn parent_build_intent_matches_attempt_v1(owner: SchedulerOwnerV1,
        attempt: SchedulerAttemptV1) -> bool:
    """Only a private exact intent proves this attempt used the new protocol."""
    if owner.lock_handle < 0 or owner.error != "" or owner.state.error != "" or
       not _parent_intent_token_v1(attempt.attempt_id) or
       not _parent_intent_token_v1(attempt.worker_id):
        return false
    val path = _parent_intent_path_v1(owner, attempt.attempt_id)
    val expected = _parent_intent_wire_v1(attempt.action_digest,
        attempt.attempt_id, attempt.worker_id)
    # The journal/requests root is private to the exclusive owner. Bound size
    # and reject a symlink leaf before reading the exact durable marker.
    file_is_regular_no_follow(path) and file_size_raw(path) == expected.len() and
        file_read(path) == expected

fn _parent_spool_active_v1(owner: SchedulerOwnerV1,
        request: BuildWorkerRequestV1) -> bool:
    if owner.lock_handle < 0 or owner.error != "" or owner.state.error != "":
        return false
    for attempt in owner.state.ledger.attempts:
        if parent_request_matches_active_attempt_v1(request, attempt):
            return true
    false

fn persist_parent_build_request_v1(owner: SchedulerOwnerV1,
        request: BuildWorkerRequestV1) -> BuildParentRequestSpoolV1:
    """Create and sync one immutable request before upload; never overwrite."""
    val wire = encode_build_worker_request_v1(request)
    if wire == "" or not _parent_spool_active_v1(owner, request):
        return BuildParentRequestSpoolV1(false, "attempt-not-current", "")
    val directory = owner.root + "/requests"
    val created = not file_exists(directory)
    if not dir_create_all(directory) or
       (created and not directory_fsync(owner.root)):
        return BuildParentRequestSpoolV1(false, "spool-directory-not-durable", "")
    val path = _parent_request_path_v1(owner, request.attempt.attempt_id)
    if not file_create_exclusive(path, wire):
        return BuildParentRequestSpoolV1(false, "spool-collision", "")
    if not file_fsync(path) or not directory_fsync(directory):
        return BuildParentRequestSpoolV1(false, "spool-not-durable", "")
    BuildParentRequestSpoolV1(true, "", sha256_text(wire))

fn _recover_parent_build_request_mode_v1(owner: SchedulerOwnerV1,
        attempt_id: text, completed: bool) -> BuildParentRequestRecoveryV1:
    if owner.lock_handle < 0 or owner.error != "" or owner.state.error != "" or
       attempt_id == "" or attempt_id.len() > 128:
        return BuildParentRequestRecoveryV1(false, "owner-or-id-invalid", nil, "")
    for c in attempt_id.chars():
        if not ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
               (c >= "0" and c <= "9") or c == "_" or c == "-" or c == "."):
            return BuildParentRequestRecoveryV1(false, "attempt-id-invalid", nil, "")
    val read = file_read_regular_no_follow_bounded(
        _parent_request_path_v1(owner, attempt_id),
        BUILD_WORKER_REQUEST_MAX_BYTES_V1)
    if read.is_err():
        return BuildParentRequestRecoveryV1(false, "spool-missing-or-invalid", nil, "")
    val request = parse_build_worker_request_v1(read.unwrap())
    if request == nil or
       request.unwrap().attempt.attempt_id != attempt_id or
       encode_build_worker_request_v1(request.unwrap()) != read.unwrap():
        return BuildParentRequestRecoveryV1(false, "spool-not-canonical", nil, "")
    val bound = if completed:
        parent_request_matches_completed_attempt_v1(request.unwrap(),
            owner.state.ledger)
    else:
        _parent_spool_active_v1(owner, request.unwrap())
    if not bound:
        return BuildParentRequestRecoveryV1(false, "spool-not-current", nil, "")
    BuildParentRequestRecoveryV1(true, "", request, sha256_text(read.unwrap()))

fn recover_parent_build_request_v1(owner: SchedulerOwnerV1,
        attempt_id: text) -> BuildParentRequestRecoveryV1:
    """Only return the canonical spooled request for a still-current fence."""
    _recover_parent_build_request_mode_v1(owner, attempt_id, false)

fn recover_completed_parent_build_request_v1(owner: SchedulerOwnerV1,
        attempt_id: text) -> BuildParentRequestRecoveryV1:
    """Read an exact spool only after durable accepted or compiler failure."""
    _recover_parent_build_request_mode_v1(owner, attempt_id, true)

export BuildParentRequestSpoolV1, BuildParentRequestRecoveryV1
export parent_request_matches_active_attempt_v1
export parent_request_matches_completed_attempt_v1
export persist_parent_build_intent_v1, parent_build_intent_matches_attempt_v1
export persist_parent_build_request_v1, recover_parent_build_request_v1
export recover_completed_parent_build_request_v1
