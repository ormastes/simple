# A protected cold-link template names producers without guessing their output
# bytes. It is not an executable ActionSpec until parent resolution succeeds.
use compiler.common.build_contract.{ActionSpec, validate_action_spec_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}

val PARENT_LINK_MAX_INPUTS_V1: i64 = 128

struct ParentLinkInputV1:
    producer_action_digest: text
    output_path: text
    argv_index: i64

struct ParentLinkTemplateV1:
    base_action: ActionSpec
    ordered_inputs: [ParentLinkInputV1]

fn _parent_link_output_name_v1(value: text) -> bool:
    if value == "" or value.len() > 128 or value == "." or value == ".." or
       value.starts_with("-"):
        return false
    for c in value.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "-" or c == "_" or c == ".":
            continue
        return false
    true

fn parent_link_template_problem_v1(template: ParentLinkTemplateV1) -> text:
    val action = template.base_action
    if action.kind != "link" or validate_action_spec_v1(action) != "ok" or
       action.inputs.declared_dependency_actions.len() != 0 or
       action.inputs.dependency_outputs.len() != 0 or
       action.argv.len() < 2 or action.argv.len() > 256 or
       template.ordered_inputs.len() == 0 or
       template.ordered_inputs.len() > PARENT_LINK_MAX_INPUTS_V1:
        return "link-template-shape-invalid"
    var prior_index: i64 = 0
    var names: [text] = []
    var producers: [text] = []
    for item in template.ordered_inputs:
        if not scheduler_action_digest_valid_v1(
                item.producer_action_digest) or
           not _parent_link_output_name_v1(item.output_path) or
           item.argv_index <= prior_index or
           item.argv_index >= action.argv.len() or
           action.argv[item.argv_index] != item.output_path:
            return "link-template-input-invalid"
        var i: i64 = 0
        while i < names.len():
            if names[i] == item.output_path and
               producers[i] != item.producer_action_digest:
                return "link-template-output-ambiguous"
            i = i + 1
        if not names.contains(item.output_path):
            names.push(item.output_path)
            producers.push(item.producer_action_digest)
        prior_index = item.argv_index
    var index: i64 = 1
    while index < action.argv.len():
        if names.contains(action.argv[index]):
            var bound = false
            for item in template.ordered_inputs:
                if item.argv_index == index:
                    bound = true
            if not bound: return "link-template-operand-unbound"
        index = index + 1
    ""

export PARENT_LINK_MAX_INPUTS_V1
export ParentLinkInputV1, ParentLinkTemplateV1
export parent_link_template_problem_v1
