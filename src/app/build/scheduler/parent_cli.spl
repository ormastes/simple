# Protected, one-shot parent adapter. The administrator owns this config and
# its parent directories; the request wire supplies data, never node policy.
use app.io.mod.{file_read_regular_no_follow_bounded}
use app.build.scheduler.worker_request.{BUILD_WORKER_REQUEST_MAX_BYTES_V1}
use app.build.scheduler.parent_graph_manifest.{
    PARENT_GRAPH_MANIFEST_MAX_BYTES_V1, parse_parent_graph_manifest_v1}
use app.build.scheduler.parent_graph_request.{
    PARENT_GRAPH_MAX_WIRE_BYTES_V1, admit_parent_graph_requests_v1,
    select_next_parent_graph_request_v1}
use app.build.scheduler.owner.{scheduler_owner_open_v1,
    scheduler_owner_close_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use app.build.scheduler.parent_remote_service.{run_parent_remote_build_intent_v1,
    run_parent_remote_action_v1,
    resume_parent_remote_attempt_v1,
    cancel_unstarted_parent_remote_attempt_v1}
use app.build.scheduler.parent_artifact_export.{
    ParentArtifactExportV1, export_accepted_build_object_v1,
    export_accepted_build_policy_row_v1}
use app.build.scheduler.parent_artifact_export_policy.{
    PARENT_EXPORT_POLICY_MAX_BYTES_V1,
    parse_parent_artifact_export_policy_v1,
    select_parent_artifact_export_policy_v1}
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1}
use app.build.scheduler.trusted_worker_invocation.{TrustedWorkerCommandV1}
use app.build.scheduler.distributed_attempt.{DistributedBuildNodeV1,
    DistributedBuildAttemptV1}
use app.build.scheduler.ledger.{SchedulerCapacityV1}
use compiler.common.build_contract.{NodeCapabilities}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.crypto_sffi.{random_hex}

pub val DIST_BUILD_CONFIG_MAX_BYTES_V1: i64 = 16384

struct DistBuildConfigV1:
    request_path: text
    graph_path: text
    owner_root: text
    node: DistributedBuildNodeV1
    capabilities: NodeCapabilities
    protected_trust_domain: text
    capacity: SchedulerCapacityV1
    export_root: text
    export_policy_path: text
    export_policy_digest: text

struct DistBuildCliArgumentsV1:
    valid: bool
    operation: text
    config_path: text
    attempt_id: text
    action_digest: text
    output_name: text
    destination_leaf: text
    policy_id: text

fn dist_build_exit_code_v1(result: DistributedBuildAttemptV1) -> i64:
    """A build succeeds only when the parent durably published its output."""
    if result.completed and result.published and
       not result.failure_recorded and not result.reconciliation_required:
        return 0
    1

fn dist_build_export_exit_code_v1(result: ParentArtifactExportV1) -> i64:
    """Only a durable object with no unresolved lock fault is CLI success."""
    if result.published and result.durable and
       (result.reason == "" or result.reason == "stage-cleanup-pending"):
        return 0
    1

fn dist_build_export_allowed_v1(config: DistBuildConfigV1,
        operation: text) -> bool:
    if operation == "export":
        return config.export_root != "" and config.export_policy_path == "" and
            config.export_policy_digest == ""
    if operation == "export-policy":
        return config.export_root != "" and config.export_policy_path != "" and
            config.export_policy_digest != ""
    false

fn _dist_cli_reason_v1(reason: text) -> text:
    val clean = reason.replace("\n", " ").replace("\r", " ")
    if clean.len() > 160: clean[0:160] else: clean

fn _dist_cli_cleanup_note_v1(reason: text) -> text:
    if reason.contains("cleanup-pending: "): " cleanup=pending" else: ""

fn _dist_cli_report_export_v1(result: ParentArtifactExportV1,
        action_digest: text, destination_leaf: text) -> i64:
    if dist_build_export_exit_code_v1(result) == 0:
        val cleanup_note = if result.reason == "stage-cleanup-pending":
            " cleanup=pending" else: ""
        print("dist-build: EXPORTED action={action_digest} object={destination_leaf} digest={result.output_digest}{cleanup_note}")
        return 0
    val reason = _dist_cli_reason_v1(result.reason)
    val status = if result.published: "INCOMPLETE" else: "BLOCKED"
    print("dist-build: {status} reason={reason} published={result.published} durable={result.durable}")
    1

fn _dist_token_v1(value: text) -> bool:
    if value == "" or value.len() > 128 or value == "." or value == ".." or
       value.starts_with("-"):
        return false
    for c in value.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "-" or c == "_" or c == ".":
            continue
        return false
    true

fn _dist_path_v1(value: text) -> bool:
    if not value.starts_with("/") or value.len() < 2 or
       value.len() > 4096 or value.ends_with("/"):
        return false
    val parts = value.split("/")
    var i: i64 = 1
    while i < parts.len():
        if not _dist_token_v1(parts[i]): return false
        i = i + 1
    true

fn _dist_nat_v1(value: text, maximum: i64, zero_ok: bool) -> i64:
    if value == "" or value.len() > 16: return -1
    for c in value.chars():
        if c < "0" or c > "9": return -1
    val number = value.to_i64() ?? -1
    if number < 0 or number > maximum or number.to_text() != value or
       (number == 0 and not zero_ok):
        return -1
    number

fn parse_dist_build_cli_args_v1(args: [text]) -> DistBuildCliArgumentsV1:
    """Parse singleton/graph build, read-only status, or cancellation."""
    val invalid = DistBuildCliArgumentsV1(false, "", "", "", "", "", "", "")
    if (args.len() != 2 and args.len() != 3 and args.len() != 4 and
        args.len() != 6) or
       args[0] != "--config" or not _dist_path_v1(args[1]):
        return invalid
    if args.len() == 2:
        return DistBuildCliArgumentsV1(true, "build", args[1], "", "", "", "", "")
    if args.len() == 3:
        if args[2] == "--next":
            return DistBuildCliArgumentsV1(true, "next", args[1], "", "", "", "", "")
        return invalid
    if args.len() == 6:
        if args[2] == "--export" and
           scheduler_action_digest_valid_v1(args[3]) and
           _dist_token_v1(args[4]) and _dist_token_v1(args[5]) and
           (args[4].ends_with(".o") or args[4].ends_with(".obj")) and
           (args[5].ends_with(".o") or args[5].ends_with(".obj")):
            return DistBuildCliArgumentsV1(true, "export", args[1], "",
                args[3], args[4], args[5], "")
        return invalid
    if args[2] == "--action" and
       scheduler_action_digest_valid_v1(args[3]):
        return DistBuildCliArgumentsV1(true, "graph", args[1], "",
            args[3], "", "", "")
    if args[2] == "--export-policy" and _dist_token_v1(args[3]):
        return DistBuildCliArgumentsV1(true, "export-policy", args[1],
            "", "", "", "", args[3])
    if not ["--status", "--cancel"].contains(args[2]) or
       not _dist_token_v1(args[3]):
        return invalid
    DistBuildCliArgumentsV1(true,
        if args[2] == "--status": "status" else: "cancel",
        args[1], args[3], "", "", "", "")

fn parse_dist_build_config_v1(wire: text) -> DistBuildConfigV1?:
    """Accept only the fixed, bounded administrator configuration wire."""
    if wire.len() == 0 or wire.len() > DIST_BUILD_CONFIG_MAX_BYTES_V1 or
       not wire.ends_with("\n") or wire.contains("\r") or wire.contains("\x00"):
        return nil
    val header = wire.split("\n")[0]
    if header != "simple-dist-build-parent-v1" and
       header != "simple-dist-build-parent-v2" and
       header != "simple-dist-build-parent-v3" and
       header != "simple-dist-build-parent-v4":
        return nil
    val first_key = if header == "simple-dist-build-parent-v1": "request" else: "graph"
    var keys = [first_key, "owner", "source", "state", "cas",
        "ssh-executable", "ssh-digest", "sftp-executable", "sftp-digest",
        "known-hosts", "known-hosts-digest", "identity", "identity-digest",
        "worker-id", "host", "user", "port", "remote-executable", "inbox",
        "trust-domain", "target-triple", "provider-abi", "worker-memory",
        "scheduler-cpu", "scheduler-memory", "scheduler-memory-reserve",
        "scheduler-fd", "timeout-ms"]
    if header == "simple-dist-build-parent-v3" or
       header == "simple-dist-build-parent-v4":
        keys.push("export-root")
    if header == "simple-dist-build-parent-v4":
        keys.push("export-policy")
        keys.push("export-policy-digest")
    val lines = wire[0:wire.len() - 1].split("\n")
    if lines.len() != keys.len() + 1 or lines[0] != header:
        return nil
    var values: [text] = []
    var i: i64 = 0
    while i < keys.len():
        val prefix = keys[i] + "="
        if not lines[i + 1].starts_with(prefix): return nil
        val value = lines[i + 1][prefix.len():]
        if value == "" or value.len() > 4096 or value.contains("="):
            return nil
        values.push(value)
        i = i + 1
    for index in [0, 1, 2, 3, 4, 5, 7, 9, 11, 17, 18]:
        if not _dist_path_v1(values[index]): return nil
    for index in [13, 14, 15, 19, 20]:
        if not _dist_token_v1(values[index]): return nil
    for index in [6, 8, 10, 12, 21]:
        if not scheduler_action_digest_valid_v1(values[index]): return nil
    if (header == "simple-dist-build-parent-v3" or
        header == "simple-dist-build-parent-v4") and
       not _dist_path_v1(values[28]):
        return nil
    if header == "simple-dist-build-parent-v4" and
       (not _dist_path_v1(values[29]) or
        not scheduler_action_digest_valid_v1(values[30])):
        return nil
    val port = _dist_nat_v1(values[16], 65535, false)
    val worker_memory = _dist_nat_v1(values[22], 1000000000000000, false)
    val cpu = _dist_nat_v1(values[23], 1000000, false)
    val memory = _dist_nat_v1(values[24], 1000000000000000, false)
    val reserve = _dist_nat_v1(values[25], 1000000000000000, true)
    val fd = _dist_nat_v1(values[26], 1000000, false)
    val timeout = _dist_nat_v1(values[27], 3600000, false)
    if port < 0 or worker_memory < 0 or cpu < 0 or memory < 0 or
       reserve < 0 or reserve >= memory or fd < 0 or timeout < 1000:
        return nil
    val ssh = TrustedSshNodeV1(values[13], values[14], values[15], port,
        values[5], values[6], values[9], values[10], values[11], values[12])
    val node = DistributedBuildNodeV1(
        TrustedWorkerCommandV1(ssh, values[17], timeout),
        TrustedSftpConfigV1(ssh, values[7], values[8], values[18]),
        values[2], values[3], values[4])
    DistBuildConfigV1(
        if header == "simple-dist-build-parent-v1": values[0] else: "",
        if header != "simple-dist-build-parent-v1": values[0] else: "",
        values[1], node,
        NodeCapabilities(1, values[13], [values[20]], [values[21]],
            values[19], worker_memory), values[19],
        SchedulerCapacityV1(cpu, memory, reserve, fd),
        if header == "simple-dist-build-parent-v3" or
           header == "simple-dist-build-parent-v4": values[28] else: "",
        if header == "simple-dist-build-parent-v4": values[29] else: "",
        if header == "simple-dist-build-parent-v4": values[30] else: "")

fn run_dist_build_cli_v1(args: [text]) -> i64:
    """Build once or reconcile one attempt using protected configuration."""
    val command = parse_dist_build_cli_args_v1(args)
    if not command.valid:
        print("dist-build: BLOCKED reason=expected-config-next-action-status-cancel-or-export")
        return 2
    val config_read = file_read_regular_no_follow_bounded(command.config_path,
        DIST_BUILD_CONFIG_MAX_BYTES_V1)
    if config_read.is_err():
        print("dist-build: BLOCKED reason=config-unreadable")
        return 1
    val parsed = parse_dist_build_config_v1(config_read.unwrap())
    if parsed == nil:
        print("dist-build: BLOCKED reason=config-invalid")
        return 1
    val config = parsed.unwrap()
    if ((command.operation == "graph" or command.operation == "next") and
        config.graph_path == "") or
       (command.operation == "build" and config.request_path == ""):
        print("dist-build: BLOCKED reason=config-operation-mismatch")
        return 1
    if command.operation == "export":
        if not dist_build_export_allowed_v1(config, "export"):
            print("dist-build: BLOCKED reason=legacy-export-disabled-or-unconfigured")
            return 1
        val exported = export_accepted_build_object_v1(config.owner_root,
            config.node.retained_cas_root, command.action_digest,
            command.output_name, config.export_root,
            command.destination_leaf)
        return _dist_cli_report_export_v1(exported,
            command.action_digest, command.destination_leaf)
    if command.operation == "export-policy":
        if not dist_build_export_allowed_v1(config, "export-policy"):
            print("dist-build: BLOCKED reason=export-policy-not-configured")
            return 1
        val read = file_read_regular_no_follow_bounded(
            config.export_policy_path, PARENT_EXPORT_POLICY_MAX_BYTES_V1)
        if read.is_err() or sha256_text(read.unwrap()) != config.export_policy_digest:
            print("dist-build: BLOCKED reason=export-policy-unreadable-or-changed")
            return 1
        val policy = parse_parent_artifact_export_policy_v1(read.unwrap())
        val selected = select_parent_artifact_export_policy_v1(policy,
            command.policy_id)
        if selected == nil:
            print("dist-build: BLOCKED reason=export-policy-row-unavailable")
            return 1
        val row = selected.unwrap()
        val exported = export_accepted_build_policy_row_v1(config.owner_root,
            config.node.retained_cas_root, config.export_root, row)
        return _dist_cli_report_export_v1(exported,
            row.action_digest, row.destination_leaf)
    if command.operation == "cancel":
        val cancelled = cancel_unstarted_parent_remote_attempt_v1(
            config.owner_root, command.attempt_id, config.node)
        if cancelled.completed and not cancelled.reconciliation_required and
           cancelled.reason == "cancelled-before-start":
            print("dist-build: CANCELLED attempt={command.attempt_id}")
            return 0
        val cancel_reason = _dist_cli_reason_v1(cancelled.reason)
        print("dist-build: INCOMPLETE reason={cancel_reason} reconciliation={cancelled.reconciliation_required}")
        return 1
    if command.operation == "status":
        val status = resume_parent_remote_attempt_v1(config.owner_root,
            command.attempt_id, config.node)
        if dist_build_exit_code_v1(status) == 0:
            print("dist-build: COMPLETED published=true attempt={command.attempt_id}{_dist_cli_cleanup_note_v1(status.reason)}")
            return 0
        val status_reason = _dist_cli_reason_v1(status.reason)
        val status_label = if status.failure_recorded: "FAILED" else: "INCOMPLETE"
        print("dist-build: {status_label} reason={status_reason} reconciliation={status.reconciliation_required}")
        return 1
    if command.operation == "graph" or command.operation == "next":
        val graph_read = file_read_regular_no_follow_bounded(config.graph_path,
            PARENT_GRAPH_MANIFEST_MAX_BYTES_V1)
        if graph_read.is_err():
            print("dist-build: BLOCKED reason=graph-manifest-unreadable")
            return 1
        val manifest = parse_parent_graph_manifest_v1(graph_read.unwrap())
        if not manifest.valid:
            print("dist-build: BLOCKED reason={manifest.reason}")
            return 1
        var wires: [text] = []
        var total_bytes: i64 = 0
        for entry in manifest.entries:
            val read = file_read_regular_no_follow_bounded(entry.path,
                BUILD_WORKER_REQUEST_MAX_BYTES_V1)
            if read.is_err() or sha256_text(read.unwrap()) != entry.digest:
                print("dist-build: BLOCKED reason=graph-request-unreadable-or-changed")
                return 1
            total_bytes = total_bytes + read.unwrap().len()
            if total_bytes > PARENT_GRAPH_MAX_WIRE_BYTES_V1:
                print("dist-build: BLOCKED reason=graph-wire-bound")
                return 1
            wires.push(read.unwrap())
        val graph = admit_parent_graph_requests_v1(wires,
            command.action_digest, config.node.ssh.node.worker_id, 0)
        if not graph.valid or
           (command.operation == "graph" and graph.selected == nil):
            val graph_block_reason = _dist_cli_reason_v1(graph.reason)
            print("dist-build: BLOCKED reason={graph_block_reason}")
            return 1
        var selected = graph.selected
        var action_digest = command.action_digest
        var attempt_id = ""
        var retry_number: i64 = 0
        if command.operation == "next":
            val nonce = random_hex(16) ?? ""
            if nonce.len() != 32:
                print("dist-build: BLOCKED reason=attempt-random-unavailable")
                return 1
            attempt_id = "dist-" + nonce
            val owner = scheduler_owner_open_v1(config.owner_root)
            if owner.error != "":
                print("dist-build: INCOMPLETE reason=owner-unavailable")
                return 1
            val choice = select_next_parent_graph_request_v1(graph,
                owner.state.ledger, config.node.ssh.node.worker_id,
                config.capabilities, config.capacity, attempt_id, 0)
            if not scheduler_owner_close_v1(owner):
                print("dist-build: INCOMPLETE reason=owner-close-before-selection")
                return 1
            if choice.reason == "graph-complete":
                print("dist-build: COMPLETED graph=true")
                return 0
            if not choice.ready or choice.request == nil:
                val choice_reason = _dist_cli_reason_v1(choice.reason)
                print("dist-build: INCOMPLETE reason={choice_reason}")
                return 1
            selected = choice.request
            action_digest = choice.request.unwrap().attempt.action_digest
            retry_number = choice.retry_number
        else:
            attempt_id = selected.unwrap().attempt.attempt_id
            retry_number = selected.unwrap().attempt.retry_number
        print("dist-build: PROPOSED attempt={attempt_id} action={action_digest}")
        val result = run_parent_remote_action_v1(graph.actions,
            action_digest, attempt_id, retry_number, config.owner_root, config.node,
            config.capabilities, config.protected_trust_domain,
            config.capacity, 0)
        if dist_build_exit_code_v1(result) == 0:
            print("dist-build: COMPLETED published=true attempt={attempt_id} action={action_digest}{_dist_cli_cleanup_note_v1(result.reason)}")
            return 0
        val graph_reason = _dist_cli_reason_v1(result.reason)
        val graph_status = if result.failure_recorded: "FAILED" else: "INCOMPLETE"
        print("dist-build: {graph_status} attempt={attempt_id} reason={graph_reason} reconciliation={result.reconciliation_required}")
        return 1
    val request_read = file_read_regular_no_follow_bounded(config.request_path,
        BUILD_WORKER_REQUEST_MAX_BYTES_V1)
    if request_read.is_err():
        print("dist-build: BLOCKED reason=request-unreadable")
        return 1
    val result = run_parent_remote_build_intent_v1(request_read.unwrap(),
        config.owner_root, config.node, config.capabilities,
        config.protected_trust_domain, config.capacity, 0)
    if dist_build_exit_code_v1(result) == 0:
        print("dist-build: COMPLETED published={result.published} failure-recorded={result.failure_recorded} reconciliation={result.reconciliation_required}{_dist_cli_cleanup_note_v1(result.reason)}")
        return 0
    val bounded = _dist_cli_reason_v1(result.reason)
    val status = if result.failure_recorded: "FAILED" else: "INCOMPLETE"
    print("dist-build: {status} reason={bounded} reconciliation={result.reconciliation_required}")
    1

export DIST_BUILD_CONFIG_MAX_BYTES_V1, DistBuildConfigV1
export DistBuildCliArgumentsV1, parse_dist_build_cli_args_v1
export parse_dist_build_config_v1, run_dist_build_cli_v1
export dist_build_exit_code_v1, dist_build_export_exit_code_v1
export dist_build_export_allowed_v1
