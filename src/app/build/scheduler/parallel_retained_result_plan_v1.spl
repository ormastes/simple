# Pure inventory check before a parent reads or retains child-produced bytes.
# No file metadata here is trusted until the parent hashes the actual files.
use app.build.scheduler.parallel_transport_wire_v1.{
    ParallelTransportHandoffV1, ParallelTransportObservationV1,
    check_parallel_transport_observation_binding_v1}
use app.build.scheduler.worker_request.{parse_build_worker_request_v1}
use app.build.scheduler.dispatch_wire.{parse_build_result_v1}
use app.build.scheduler.worker_output.{BUILD_OUTPUT_MAX_FILES_V1}
use compiler.common.cache.canonical_identity.{canonical_identity_sort_texts}

struct ParallelRetainedResultPlanV1:
    valid: bool
    reason: text
    success: bool
    required_paths: [text]
    total_bytes: i64

fn _retained_reject_v1(reason: text) -> ParallelRetainedResultPlanV1:
    ParallelRetainedResultPlanV1(false, reason, false, [], 0)

fn _retained_output_name_v1(name: text) -> bool:
    if name == "" or name == "." or name == ".." or name.len() > 128 or
       name.starts_with("-") or
       ["result.wire", "manifest.wire", "diagnostics",
        "failure-proof.wire"].contains(name):
        return false
    for ch in name.chars():
        if (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
           (ch >= "0" and ch <= "9") or ch == "_" or ch == "-" or ch == ".":
            continue
        return false
    true

fn plan_parallel_retained_result_v1(handoff: ParallelTransportHandoffV1,
        observation: ParallelTransportObservationV1) ->
        ParallelRetainedResultPlanV1:
    """Require an exact declared file inventory, without reading any bytes."""
    if not check_parallel_transport_observation_binding_v1(handoff,
            observation):
        return _retained_reject_v1("transport-binding-invalid")
    if observation.status != "FETCHED":
        return _retained_reject_v1("observation-incomplete")
    val request = parse_build_worker_request_v1(handoff.request_wire)
    val result = parse_build_result_v1(observation.worker_result_wire)
    if request == nil or result == nil:
        return _retained_reject_v1("result-claim-invalid")
    val outputs = request.unwrap().action.output_paths
    if outputs.len() == 0 or outputs.len() > BUILD_OUTPUT_MAX_FILES_V1:
        return _retained_reject_v1("declared-output-count-invalid")
    var seen: [text] = []
    for name in outputs:
        if not _retained_output_name_v1(name) or seen.contains(name):
            return _retained_reject_v1("declared-output-invalid")
        seen.push(name)
    var required: [text] = ["outputs/result.wire",
        "outputs/manifest.wire", "outputs/diagnostics"]
    val success = result.unwrap().candidate.success
    if success:
        for name in outputs:
            required.push("outputs/" + name)
    else:
        required.push("outputs/failure-proof.wire")
    required = canonical_identity_sort_texts(required)
    if observation.result_files.len() != required.len() or
       observation.result_files.len() > handoff.max_output_files:
        return _retained_reject_v1("result-inventory-count-invalid")
    var total: i64 = 0
    var i: i64 = 0
    while i < required.len():
        val file = observation.result_files[i]
        if file.relative_path != required[i]:
            return _retained_reject_v1("result-inventory-mismatch")
        if not success and file.relative_path == "outputs/manifest.wire" and
           file.byte_count != 0:
            return _retained_reject_v1("failure-manifest-not-empty")
        if file.byte_count > handoff.max_output_bytes - total:
            return _retained_reject_v1("result-byte-limit")
        total = total + file.byte_count
        i = i + 1
    ParallelRetainedResultPlanV1(true, "", success, required, total)

export ParallelRetainedResultPlanV1, plan_parallel_retained_result_v1
