"""Pure admission and frozen-receipt policy for the parent transport owner.

Inputs are snapshots from the parent's V4 lease, never child-supplied claims.
This predicate does not acknowledge a receipt or establish writer cessation by
itself: the owner must successfully acknowledge through that same live lease
before exposing child output. A provider's absence of leader-only restriction
is only admission eligibility; exact tree evidence remains mandatory below.
The parent supplies fresh monotonic milliseconds immediately before acceptance.
"""

use std.nogc_sync_mut.io.process_observation_v4.{ProcessObservationCapabilitiesV4}
use std.common.process.observation_v4.{
    ProcessObservationReceiptV4, ProcessObservationStreamV4,
    ProcessObservationStreamStateV4, ProcessObservationFailurePhaseV4,
    ProcessObservationFailureReasonV4, ProcessObservationClockKindV4,
    POV4_VALID_REQUEST, POV4_VALID_CLOCK, POV4_VALID_TREE_CONTROL,
    POV4_VALIDITY_MASK, POV4_CAP_EXACT_TREE,
    freeze_process_observation_receipt_v4
}

# Capability ABI from runtime_process_owned.c. The exact-tree bit is reserved
# but not advertised by the current hosted provider.
val TRANSPORT_REQUIRED_BASE_CAPABILITIES_V1: i64 = 155
val TRANSPORT_KNOWN_CAPABILITIES_V1: i64 = 1023
val TRANSPORT_LEADER_ONLY_CAPABILITY_V1: i64 = 256

# required_capture_bytes is the aggregate stdout + stderr budget, not per pipe.
pub fn parallel_transport_supervisor_capabilities_v1(
        caps: ProcessObservationCapabilitiesV4,
        required_capture_bytes: i64, required_live_tickets: i64) -> bool:
    caps.available and caps.runtime_error == 0 and
        required_capture_bytes > 0 and required_live_tickets > 0 and
        caps.max_capture_bytes >= required_capture_bytes and
        caps.max_live_tickets >= required_live_tickets and
        caps.max_caller_wait_ns > 0 and caps.capability_bits > 0 and
        (caps.capability_bits & ~TRANSPORT_KNOWN_CAPABILITIES_V1) == 0 and
        (caps.capability_bits & TRANSPORT_REQUIRED_BASE_CAPABILITIES_V1) == TRANSPORT_REQUIRED_BASE_CAPABILITIES_V1 and
        (caps.capability_bits & POV4_CAP_EXACT_TREE) != 0 and
        (caps.capability_bits & TRANSPORT_LEADER_ONLY_CAPABILITY_V1) == 0

fn transport_exact_eof_v1(stream: ProcessObservationStreamV4, payload: [u8]) -> bool:
    stream.state == ProcessObservationStreamStateV4.Eof and
        stream.errno_value == 0 and stream.seen_bytes == payload.len() and
        stream.retained_bytes == payload.len() and stream.delivered_bytes == payload.len()

pub fn parallel_transport_frozen_accept_v1(receipt: ProcessObservationReceiptV4,
        now_tick_ms: i64, deadline_tick_ms: i64) -> bool:
    if now_tick_ms < 0 or deadline_tick_ms <= 0 or now_tick_ms >= deadline_tick_ms:
        return false
    if freeze_process_observation_receipt_v4(receipt).is_err():
        return false
    val packet = receipt.packet
    val required_validity = POV4_VALID_REQUEST | POV4_VALID_CLOCK | POV4_VALID_TREE_CONTROL
    if packet.validity_bits < 0 or (packet.validity_bits & ~POV4_VALIDITY_MASK) != 0 or
            (packet.validity_bits & required_validity) != required_validity or
            packet.request_id_high <= 0 or packet.request_id_low <= 0 or
            packet.ticket_high <= 0 or packet.ticket_low <= 0 or packet.pid <= 0:
        return false
    if not packet.tree_control_available or not packet.tree_empty or
            not packet.leader_reaped or packet.request_started_ns < 0 or
            packet.prepared_ns < packet.request_started_ns or
            packet.process_started_ns < packet.prepared_ns or
            packet.leader_waited_ns < packet.exec_confirmed_ns or
            packet.tree_empty_ns < packet.process_started_ns:
        return false
    if packet.clock_kind != ProcessObservationClockKindV4.Monotonic or
            packet.clock_nominal_resolution_ns <= 0 or packet.clock_effective_resolution_ns <= 0 or
            packet.execution_deadline_ns <= packet.request_started_ns or
            packet.kill_deadline_ns < packet.execution_deadline_ns or
            packet.cleanup_deadline_ns < packet.kill_deadline_ns or
            packet.leader_waited_ns >= packet.execution_deadline_ns or
            packet.tree_empty_ns >= packet.execution_deadline_ns:
        return false
    if packet.exit_code != 0 or packet.signal_number != 0 or packet.raw_wait_status != 0 or
            packet.failure_phase != ProcessObservationFailurePhaseV4.Unknown or
            packet.failure_reason != ProcessObservationFailureReasonV4.Unknown or
            packet.errno_value != 0 or packet.exec_errno != 0 or packet.limit_event_bits != 0 or
            packet.term_attempted or packet.term_sent or packet.kill_attempted or packet.kill_sent:
        return false
    transport_exact_eof_v1(packet.stdout, receipt.stdout) and
        transport_exact_eof_v1(packet.stderr, receipt.stderr)

export parallel_transport_supervisor_capabilities_v1, parallel_transport_frozen_accept_v1
