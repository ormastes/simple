# Artifact-byte ownership building block; this module never executes artifacts.
# Caller must protect export_root, state_dir, its build-attempts parent, and all
# path ancestors from replacement. Root separation below is lexical; protected
# ancestors must not alias these disjoint trees through symlinks or mounts.
# O_NOFOLLOW protects the source leaf, not ancestors. A source writer can change
# bytes during read: the digest authenticates the captured bytes, not an atomic
# filesystem snapshot. Same-user mutation of the private stage is out of scope.
use app.io.mod.{file_read_regular_no_follow_bounded_bytes,
    file_create_exclusive, file_write_bytes, secure_temp_dir, file_fsync,
    directory_fsync, dir_remove_all, dir_create_all, file_exists, is_dir}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.nogc_sync_mut.package_sffi.{set_permissions}
use std.nogc_sync_mut.sffi.fs.{file_mode}

val DIST_EXEC_ARTIFACT_SNAPSHOT_MAX_BYTES_V1: i64 = 67108864

struct DistExecArtifactSnapshotV1:
    ready: bool
    reason: text
    root: text
    artifact_path: text
    artifact_sha256: text
    artifact_bytes: i64
    cleanup_pending: bool
    cleanup_removed: bool
    build_input_root: text = ""
    build_output_root: text = ""

fn _artifact_snapshot_pod_v1(pod_uid: text) -> bool:
    if pod_uid.len() <= 0 or pod_uid.len() > 96 or pod_uid == "." or pod_uid == ".." or pod_uid.starts_with("-"):
        return false
    for c in pod_uid.chars():
        if ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
                (c >= "0" and c <= "9") or c == "." or c == "_" or c == "-"):
            continue
        return false
    true

fn _artifact_snapshot_path_v1(path: text) -> bool:
    if (path.len() <= 1 or path.len() > 4096 or
            not path.starts_with("/") or path.ends_with("/") or path.contains("//")):
        return false
    val parts = path.split("/")
    var i: i64 = 1
    while i < parts.len():
        val part = parts[i]
        if (part.len() <= 0 or part.len() > 255 or part == "." or
                part == ".." or part.starts_with("-")):
            return false
        for c in part.chars():
            if ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
                    (c >= "0" and c <= "9") or c == "_" or c == "-" or c == "."):
                continue
            return false
        i = i + 1
    true

fn _artifact_snapshot_digest_v1(digest: text) -> bool:
    if digest.len() != 64: return false
    for c in digest.chars():
        if (c >= "0" and c <= "9") or (c >= "a" and c <= "f"):
            continue
        return false
    true

fn _artifact_snapshot_reject_v1(reason: text, root: text,
        state_root: text, already_removed: bool = false) -> DistExecArtifactSnapshotV1:
    if root != "":
        if not already_removed and not dir_remove_all(root):
            # Retain ownership on cleanup uncertainty, including partial removal.
            return DistExecArtifactSnapshotV1(false, reason + "-cleanup-failed",
                root, root + "/inputs/artifact", "", 0, true, false,
                root + "/inputs", root + "/outputs")
        if file_exists(root):
            return DistExecArtifactSnapshotV1(false, reason + "-cleanup-still-present",
                root, root + "/inputs/artifact", "", 0, true, false,
                root + "/inputs", root + "/outputs")
        if not directory_fsync(state_root):
            # Even an absent stage remains owned until its deletion is durable.
            return DistExecArtifactSnapshotV1(false, reason + "-cleanup-sync-failed",
                root, root + "/inputs/artifact", "", 0, true, true,
                root + "/inputs", root + "/outputs")
    DistExecArtifactSnapshotV1(false, reason, "", "", "", 0, false, false)

fn prepare_dist_exec_artifact_snapshot_v1(state_dir: text, pod_uid: text,
        attempt: i64, export_root: text, export_path: text, expected_sha256: text,
        max_artifact_bytes: i64) -> DistExecArtifactSnapshotV1:
    """Capture digest-pinned bytes into a caller-owned private stage.

    The protected export root is explicit caller authorization. The source must
    be a strict descendant of it, and export/state roots must be disjoint.
    The positive byte cap is explicit caller policy. The source uses one bounded
    regular-file O_NOFOLLOW read, without a separate path stat/open race. Caller
    must release a successful root, or retain/retry any cleanup_pending root.
    """
    val state_root = state_dir + "/build-attempts"
    if (not _artifact_snapshot_path_v1(export_path) or
            not _artifact_snapshot_path_v1(export_root) or
            not _artifact_snapshot_path_v1(state_dir) or state_root.len() > 3900):
        return _artifact_snapshot_reject_v1("artifact-snapshot-path-invalid", "", state_root)
    if not export_path.starts_with(export_root + "/"):
        return _artifact_snapshot_reject_v1("artifact-snapshot-export-outside-root", "", state_root)
    if (state_dir == export_root or state_dir.starts_with(export_root + "/") or
            export_root.starts_with(state_dir + "/")):
        return _artifact_snapshot_reject_v1("artifact-snapshot-roots-overlap", "", state_root)
    if not _artifact_snapshot_pod_v1(pod_uid) or attempt <= 0:
        return _artifact_snapshot_reject_v1("artifact-snapshot-attempt-invalid", "", state_root)
    if max_artifact_bytes <= 0 or max_artifact_bytes > DIST_EXEC_ARTIFACT_SNAPSHOT_MAX_BYTES_V1:
        return _artifact_snapshot_reject_v1("artifact-snapshot-limit-invalid", "", state_root)
    if not _artifact_snapshot_digest_v1(expected_sha256):
        return _artifact_snapshot_reject_v1("artifact-snapshot-digest-invalid", "", state_root)
    val read = file_read_regular_no_follow_bounded_bytes(export_path, max_artifact_bytes)
    if read.is_err():
        return _artifact_snapshot_reject_v1("artifact-snapshot-source-unavailable", "", state_root)
    val payload = read.unwrap()
    if (payload.len() <= 0 or payload.len() > max_artifact_bytes or
            sha256_u8_hex(payload) != expected_sha256):
        return _artifact_snapshot_reject_v1("artifact-snapshot-source-mismatch", "", state_root)
    if not is_dir(state_dir) or not dir_create_all(state_root) or not directory_fsync(state_dir):
        return _artifact_snapshot_reject_v1("artifact-snapshot-stage-unavailable", "", state_root)
    val created = secure_temp_dir(state_root, pod_uid + "-" + attempt.to_text())
    if created.is_err():
        return _artifact_snapshot_reject_v1("artifact-snapshot-stage-unavailable", "", state_root)
    val root = created.unwrap()
    val inputs = root + "/inputs"
    val outputs = root + "/outputs"
    if not dir_create_all(inputs) or not dir_create_all(outputs):
        return _artifact_snapshot_reject_v1("artifact-snapshot-directory-failed", root, state_root)
    val destination = inputs + "/artifact"
    # The facade exposes exclusive text creation only. Reserve an empty leaf
    # exclusively, then write binary bytes inside the fresh private directory.
    # This is not an exclusive binary write on a single descriptor.
    if not file_create_exclusive(destination, ""):
        return _artifact_snapshot_reject_v1("artifact-snapshot-create-failed", root, state_root)
    if not file_write_bytes(destination, payload):
        return _artifact_snapshot_reject_v1("artifact-snapshot-write-failed", root, state_root)
    val executable_mode: i64 = 0o755
    if not set_permissions(destination, executable_mode.to_i32()) or
            file_mode(destination) != executable_mode:
        return _artifact_snapshot_reject_v1("artifact-snapshot-mode-failed", root, state_root)
    if (not file_fsync(destination) or not directory_fsync(inputs) or
            not directory_fsync(outputs) or not directory_fsync(root) or
            not directory_fsync(state_root)):
        return _artifact_snapshot_reject_v1("artifact-snapshot-sync-failed", root, state_root)
    val staged = file_read_regular_no_follow_bounded_bytes(destination, max_artifact_bytes)
    if staged.is_err():
        return _artifact_snapshot_reject_v1("artifact-snapshot-reread-failed", root, state_root)
    val staged_bytes = staged.unwrap()
    if staged_bytes.len() != payload.len() or sha256_u8_hex(staged_bytes) != expected_sha256:
        return _artifact_snapshot_reject_v1("artifact-snapshot-stage-mismatch", root, state_root)
    DistExecArtifactSnapshotV1(true, "", root, destination, expected_sha256,
        staged_bytes.len(), false, false, inputs, outputs)

fn release_dist_exec_artifact_snapshot_v1(snapshot: DistExecArtifactSnapshotV1,
        state_dir: text, pod_uid: text, attempt: i64) -> DistExecArtifactSnapshotV1:
    """Release an owned stage; keep the root in the result if cleanup fails.

    Only pass values returned by this module and the trusted original POSIX
    state root. These records are ownership bookkeeping, not unforgeable
    capabilities. Discard prior copies on release. Prefix confinement cannot
    authenticate ownership of another stage with the same valid leaf grammar.
    """
    val state_root = state_dir + "/build-attempts"
    val prefix = state_root + "/" + pod_uid + "-" + attempt.to_text() + "-"
    if (not _artifact_snapshot_path_v1(state_dir) or
            not _artifact_snapshot_pod_v1(pod_uid) or attempt <= 0 or
            not _artifact_snapshot_path_v1(snapshot.root) or
            not snapshot.root.starts_with(prefix) or
            snapshot.root.len() != prefix.len() + 6 or
            snapshot.artifact_path != snapshot.root + "/inputs/artifact" or
            snapshot.build_input_root != snapshot.root + "/inputs" or
            snapshot.build_output_root != snapshot.root + "/outputs" or
            snapshot.ready == snapshot.cleanup_pending or
            (snapshot.cleanup_removed and not snapshot.cleanup_pending)):
        return DistExecArtifactSnapshotV1(false, "artifact-snapshot-release-invalid",
            snapshot.root, snapshot.artifact_path, snapshot.artifact_sha256,
            snapshot.artifact_bytes, true, snapshot.cleanup_removed,
            snapshot.build_input_root, snapshot.build_output_root)
    val suffix = snapshot.root[prefix.len():snapshot.root.len()]
    for c in suffix.chars():
        if ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
                (c >= "0" and c <= "9")):
            continue
        return DistExecArtifactSnapshotV1(false, "artifact-snapshot-release-invalid",
            snapshot.root, snapshot.artifact_path, snapshot.artifact_sha256,
            snapshot.artifact_bytes, true, snapshot.cleanup_removed,
            snapshot.build_input_root, snapshot.build_output_root)
    _artifact_snapshot_reject_v1("artifact-snapshot-released", snapshot.root,
        state_root, snapshot.cleanup_removed)

export DistExecArtifactSnapshotV1, prepare_dist_exec_artifact_snapshot_v1
export release_dist_exec_artifact_snapshot_v1
export DIST_EXEC_ARTIFACT_SNAPSHOT_MAX_BYTES_V1
