# Fixed-fixture adapter for a trusted local Docker daemon. Caller pins the
# daemon/socket and API version and supplies create/inspect evidence for the
# exact newly-created, never-started container ID and Tty=false.
# Open BEFORE starting that container. Log replay is disabled.
# Open sends the request; call establish() and require success BEFORE start.
# After start, capture() may block until the container closes its stream.
# EOF proves stream termination only, never successful execution or complete
# build output. Reconcile independently with exact-ID wait/inspect evidence.
use app.build.scheduler.docker_unix_byte_transport.{DockerUnixByteStreamV1}
use app.build.scheduler.docker_attach_frames.{DockerAttachDecodedV1}
use app.build.scheduler.docker_attach_http.{docker_attach_exact_id_v1, parse_docker_attach_http_v1}
use app.io.time_ops.{time_now_nanos}

struct DockerAttachCaptureV1:
    container_id: text
    decoded: DockerAttachDecodedV1
    transport_eof: bool
    output_complete: bool

class DockerAttachSourceV1:
    stream: DockerUnixByteStreamV1
    container_id: text
    capture_started: bool
    establish_started: bool
    headers_ready: bool
    prefix_bytes: [u8]
    syscall_timeout_ms: i64
    aggregate_timeout_ms: i64

    static fn open(socket_path: text, api_version: text, container_id: text, tty: bool, syscall_timeout_ms: i64, aggregate_timeout_ms: i64) -> Result<DockerAttachSourceV1, text>:
        if tty:
            return Err("docker attach source: Tty=false required")
        if syscall_timeout_ms < 1 or syscall_timeout_ms > 60000:
            return Err("docker attach source: syscall timeout must be 1..60000 ms")
        if aggregate_timeout_ms < 1 or aggregate_timeout_ms > 60000:
            return Err("docker attach source: aggregate timeout must be 1..60000 ms")
        if not docker_attach_exact_id_v1(container_id):
            return Err("docker attach source: exact lowercase 64-hex container ID required")
        # Syntactic bound only; daemon support must be established separately.
        if not api_version.starts_with("v1.") or api_version.len() < 4 or api_version.len() > 6:
            return Err("docker attach source: pinned v1.<decimal> API version required")
        val minor = api_version[3:]
        if minor.len() > 1 and minor.starts_with("0"):
            return Err("docker attach source: noncanonical API version")
        for c in minor.chars():
            if c < "0" or c > "9":
                return Err("docker attach source: invalid API version")
        var stream = DockerUnixByteStreamV1.connect(socket_path, syscall_timeout_ms, syscall_timeout_ms)?
        val request = "POST /{api_version}/containers/{container_id}/attach?logs=0&stream=1&stdin=0&stdout=1&stderr=1 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
        match stream.write_all(request.bytes()):
            Ok(sent):
                Ok(DockerAttachSourceV1(stream, container_id, false, false, false, [], syscall_timeout_ms, aggregate_timeout_ms))
            Err(message):
                match stream.close():
                    Ok(closed): Err(message)
                    Err(close_error): Err("{message}; {close_error}")

    # Separate caller-selected aggregate budgets for establish and capture. Clock
    # failures/backward movement fail closed. Shrink each read timeout to the
    # remaining whole milliseconds and check again after every blocking read.
    # Local Unix connect has its own bounded timeout in the transport.
    me fn bound_read_deadline(started_ns: i64) -> Result<bool, text>:
        val now_ns = time_now_nanos()
        if started_ns < 0 or now_ns < started_ns:
            return Err("docker attach source: invalid monotonic clock")
        val elapsed_ns = now_ns - started_ns
        val budget_ns = self.aggregate_timeout_ms * 1000000
        if elapsed_ns >= budget_ns:
            return Err("docker attach source: aggregate deadline exceeded")
        val remaining_ms = (budget_ns - elapsed_ns) / 1000000
        if remaining_ms < 1:
            return Err("docker attach source: aggregate deadline exhausted")
        self.stream.read_timeout_ms = self.syscall_timeout_ms
        if remaining_ms < self.syscall_timeout_ms:
            self.stream.read_timeout_ms = remaining_ms
        Ok(true)

    me fn establish() -> Result<bool, text>:
        if self.establish_started:
            return Err("docker attach source: establishment already attempted")
        self.establish_started = true
        val started_ns = time_now_nanos()
        var cursor: i64 = 0
        while self.prefix_bytes.len() < 8192:
            val before_read = self.bound_read_deadline(started_ns)?
            val chunk = self.stream.read_chunk(4096)?
            val after_read = self.bound_read_deadline(started_ns)?
            if chunk.eof:
                return Err("docker attach source: EOF before response headers")
            for byte in chunk.bytes:
                self.prefix_bytes.push(byte)
            while cursor + 3 < self.prefix_bytes.len() and cursor + 4 <= 8192:
                if (self.prefix_bytes[cursor] == 13 and self.prefix_bytes[cursor + 1] == 10 and
                        self.prefix_bytes[cursor + 2] == 13 and self.prefix_bytes[cursor + 3] == 10):
                    val header_end = cursor + 4
                    # Empty framed body is syntactically valid, so reuse the
                    # strict parser before allowing the caller to start.
                    val parsed = parse_docker_attach_http_v1(self.prefix_bytes[:header_end], false)?
                    val after_parse = self.bound_read_deadline(started_ns)?
                    self.headers_ready = true
                    return Ok(true)
                cursor = cursor + 1
        Err("docker attach source: response header cap exceeded")

    # One capture attempt per source. On all outcomes caller explicitly closes
    # this single owner; do not copy its underlying stream/descriptor.
    # Wire, syscall, and aggregate elapsed-time caps bound capture work.
    me fn capture() -> Result<DockerAttachCaptureV1, text>:
        if not self.headers_ready:
            return Err("docker attach source: establish response before start and capture")
        if self.capture_started:
            return Err("docker attach source: capture already attempted")
        self.capture_started = true
        val started_ns = time_now_nanos()
        var bytes = self.prefix_bytes
        var reads: i64 = 0
        while reads < 4096:
            val before_read = self.bound_read_deadline(started_ns)?
            val chunk = self.stream.read_chunk(4096)?
            val after_read = self.bound_read_deadline(started_ns)?
            reads = reads + 1
            if chunk.eof:
                val decoded = parse_docker_attach_http_v1(bytes, false)?
                val after_parse = self.bound_read_deadline(started_ns)?
                if decoded.stdout_bytes.len() == 0 and decoded.stderr_bytes.len() == 0:
                    return Err("docker attach source: fixed fixture produced no payload")
                return Ok(DockerAttachCaptureV1(self.container_id, decoded, true, false))
            if chunk.bytes.len() > 1089536 - bytes.len():
                return Err("docker attach source: wire cap exceeded")
            for byte in chunk.bytes:
                bytes.push(byte)
        Err("docker attach source: read count cap exceeded; EOF not established")

    me fn close() -> Result<bool, text>:
        self.stream.close()

export DockerAttachCaptureV1, DockerAttachSourceV1
