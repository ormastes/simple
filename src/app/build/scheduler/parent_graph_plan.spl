# Complete-graph execution identity and pure preflight. The graph manifest
# transitively pins exact request wires; ordered configuration bytes pin the
# administrator's worker, transport, owner and retained-CAS policy.
use app.build.scheduler.parent_cli.{DistBuildConfigV1,
    DIST_BUILD_CONFIG_MAX_BYTES_V1, parse_dist_build_config_v1}
use app.build.scheduler.parent_graph_manifest.{
    PARENT_GRAPH_MANIFEST_MAX_BYTES_V1, parse_parent_graph_manifest_v1}
use app.build.scheduler.parent_graph_request.{ParentGraphRequestV1,
    PARENT_GRAPH_MAX_REQUESTS_V1, admit_parent_graph_requests_v1}
use app.build.scheduler.parent_graph_runner.{
    parent_graph_workers_valid_v1}
use app.build.scheduler.worker_request.{BUILD_WORKER_REQUEST_MAX_BYTES_V1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use compiler.common.cache.canonical_identity.{canon_field, canon_seq,
    canon_str}
use std.common.crypto.sha256.{sha256_text}

val PARENT_GRAPH_PLAN_MAX_WORKERS_V1: i64 = 16

struct ParentGraphPlanV1:
    manifest_digest: text
    config_wires: [text]
    expected_plan_digest: text

struct ParentGraphPreparedV1:
    valid: bool
    reason: text
    graph: ParentGraphRequestV1?
    workers: [DistBuildConfigV1]

fn _graph_plan_reject_v1(reason: text) -> ParentGraphPreparedV1:
    ParentGraphPreparedV1(false, reason, nil, [])

fn parent_graph_plan_digest_v1(plan: ParentGraphPlanV1) -> text:
    """Canonical complete-graph identity; caller supplies approval separately."""
    if not scheduler_action_digest_valid_v1(plan.manifest_digest) or
       plan.config_wires.len() == 0 or
       plan.config_wires.len() > PARENT_GRAPH_PLAN_MAX_WORKERS_V1:
        return ""
    var config_hashes: [text] = []
    var graph_path = ""
    for wire in plan.config_wires:
        if wire.len() == 0 or wire.len() > DIST_BUILD_CONFIG_MAX_BYTES_V1:
            return ""
        val config = parse_dist_build_config_v1(wire)
        if config == nil or config.unwrap().graph_path == "": return ""
        if graph_path != "" and config.unwrap().graph_path != graph_path:
            return ""
        graph_path = config.unwrap().graph_path
        config_hashes.push(canon_str(sha256_text(wire)))
    sha256_text(canon_field("simple/parent-graph-plan/v1", canon_seq([
        canon_str(plan.manifest_digest), canon_seq(config_hashes)])))

fn prepare_parent_graph_plan_v1(plan: ParentGraphPlanV1,
        manifest_wire: text,
        request_wires: [text]) -> ParentGraphPreparedV1:
    """Check one approved graph/config identity before opening the owner."""
    val identity = parent_graph_plan_digest_v1(plan)
    if identity == "" or identity != plan.expected_plan_digest:
        return _graph_plan_reject_v1("graph-plan-digest-mismatch")
    if manifest_wire.len() == 0 or
       manifest_wire.len() > PARENT_GRAPH_MANIFEST_MAX_BYTES_V1 or
       sha256_text(manifest_wire) != plan.manifest_digest:
        return _graph_plan_reject_v1("graph-manifest-digest-mismatch")
    val manifest = parse_parent_graph_manifest_v1(manifest_wire)
    if not manifest.valid or request_wires.len() != manifest.entries.len() or
       request_wires.len() > PARENT_GRAPH_MAX_REQUESTS_V1:
        return _graph_plan_reject_v1("graph-manifest-invalid")
    var i: i64 = 0
    while i < request_wires.len():
        val wire = request_wires[i]
        if wire.len() == 0 or wire.len() > BUILD_WORKER_REQUEST_MAX_BYTES_V1 or
           sha256_text(wire) != manifest.entries[i].digest:
            return _graph_plan_reject_v1("graph-request-digest-mismatch")
        i = i + 1
    var workers: [DistBuildConfigV1] = []
    for wire in plan.config_wires:
        val parsed = parse_dist_build_config_v1(wire)
        if parsed == nil:
            return _graph_plan_reject_v1("graph-config-invalid")
        workers.push(parsed.unwrap())
    val graph = admit_parent_graph_requests_v1(request_wires, "",
        workers[0].node.ssh.node.worker_id, 0)
    if not graph.valid:
        return _graph_plan_reject_v1("graph-invalid: " + graph.reason)
    if not parent_graph_workers_valid_v1(graph, workers):
        return _graph_plan_reject_v1("graph-worker-policy-invalid")
    ParentGraphPreparedV1(true, "", graph, workers)

export PARENT_GRAPH_PLAN_MAX_WORKERS_V1
export ParentGraphPlanV1, ParentGraphPreparedV1
export parent_graph_plan_digest_v1, prepare_parent_graph_plan_v1
