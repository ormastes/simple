# A narrow, authenticated reachability check for a trusted Linux build node.
# The caller owns an immutable, private configuration directory for these
# pinned files. The current file facade checks no-follow and hashes in
# separate operations, so it cannot defend against a hostile path swap.
# This probe does not grant action execution or result publication authority.
use app.io.mod.{file_is_regular_no_follow, file_read_regular_no_follow_bounded,
    file_hash_sha256, file_size_raw, process_run_bounded}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}

struct TrustedSshNodeV1:
    worker_id: text
    host: text
    user: text
    port: i64
    ssh_executable: text
    ssh_digest: text
    known_hosts_path: text
    known_hosts_digest: text
    identity_path: text
    identity_digest: text

struct TrustedSshProbeV1:
    connected: bool
    reason: text
    worker_id: text

fn _ssh_name_v1(value: text, allow_dot: bool) -> bool:
    if value.len() == 0 or value.len() > 128:
        return false
    for c in value.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "_" or c == "-" or
           (allow_dot and c == "."):
            continue
        return false
    not value.starts_with("-") and not value.starts_with(".")

fn _ssh_path_v1(path: text) -> bool:
    if not path.starts_with("/") or path.len() > 4096 or path.contains("\n") or
       path.contains("\r") or path.contains("\x00"):
        return false
    true

fn _ssh_file_problem_v1(path: text, digest: text, max_bytes: i64) -> text:
    if not _ssh_path_v1(path) or not scheduler_action_digest_valid_v1(digest):
        return "path-or-digest-invalid"
    if not file_is_regular_no_follow(path):
        return "not-regular"
    val size = file_size_raw(path)
    if size <= 0 or size > max_bytes:
        return "size-invalid"
    if file_hash_sha256(path) != digest:
        return "digest-mismatch"
    ""

fn trusted_ssh_node_problem_v1(node: TrustedSshNodeV1) -> text:
    if not _ssh_name_v1(node.worker_id, true):
        return "worker-id-invalid"
    if not _ssh_name_v1(node.host, true):
        return "host-invalid"
    if not _ssh_name_v1(node.user, false):
        return "user-invalid"
    if node.port < 1 or node.port > 65535:
        return "port-invalid"
    val ssh_problem = _ssh_file_problem_v1(node.ssh_executable, node.ssh_digest, 67108864)
    if ssh_problem != "":
        return "ssh-executable-" + ssh_problem
    val hosts_problem = _ssh_file_problem_v1(node.known_hosts_path, node.known_hosts_digest, 65536)
    if hosts_problem != "":
        return "known-hosts-" + hosts_problem
    val identity_problem = _ssh_file_problem_v1(node.identity_path, node.identity_digest, 65536)
    if identity_problem != "":
        return "identity-" + identity_problem
    val lines = file_read_regular_no_follow_bounded(node.known_hosts_path, 65536)
    if lines.is_err():
        return "known-hosts-unreadable"
    for line in lines.unwrap().split("\n"):
        if line.starts_with(node.worker_id + " ssh-ed25519 ") and
           line.len() <= 8192:
            return ""
    "worker-host-key-missing"

fn trusted_ssh_node_valid_v1(node: TrustedSshNodeV1) -> bool:
    trusted_ssh_node_problem_v1(node) == ""

fn probe_trusted_ssh_node_v1(node: TrustedSshNodeV1) -> TrustedSshProbeV1:
    val problem = trusted_ssh_node_problem_v1(node)
    if problem != "":
        return TrustedSshProbeV1(false, problem, node.worker_id)
    val args = ["-F", "none", "-o", "BatchMode=yes", "-o",
        "StrictHostKeyChecking=yes", "-o",
        "UserKnownHostsFile=" + node.known_hosts_path, "-o",
        "GlobalKnownHostsFile=none", "-o", "UpdateHostKeys=no", "-o",
        "IdentityAgent=none", "-o", "IdentitiesOnly=yes", "-o",
        "HostKeyAlias=" + node.worker_id, "-o", "ClearAllForwardings=yes",
        "-o", "ForwardAgent=no", "-o", "ForwardX11=no", "-o",
        "ConnectTimeout=5", "-p", node.port.to_text(), "-i",
        node.identity_path, "-l", node.user, "-T", "-n", "--", node.host,
        "/bin/true"]
    val (stdout, stderr, exit_code) = process_run_bounded(
        node.ssh_executable, args, 10000, 8192)
    if exit_code != 0 or stdout.len() != 0 or stderr.len() > 8192:
        return TrustedSshProbeV1(false, "ssh-probe-failed", node.worker_id)
    TrustedSshProbeV1(true, "", node.worker_id)
