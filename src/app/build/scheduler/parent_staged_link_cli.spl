# Protected CLI adapter for the staged compile-to-link controller. Every file
# read is bounded and no-follow; administrator-owned ancestors remain required.
use app.io.mod.{file_read_regular_no_follow_bounded}
use app.build.scheduler.parent_cli.{DistBuildConfigV1,
    DIST_BUILD_CONFIG_MAX_BYTES_V1, parse_dist_build_config_v1}
use app.build.scheduler.parent_graph_manifest.{
    PARENT_GRAPH_MANIFEST_MAX_BYTES_V1, parse_parent_graph_manifest_v1}
use app.build.scheduler.worker_request.{BUILD_WORKER_REQUEST_MAX_BYTES_V1}
use app.build.scheduler.parent_link_template_wire.{
    load_pinned_parent_link_template_v1}
use app.build.scheduler.parent_staged_link.{ParentStagedLinkPlanV1,
    prepare_parent_staged_link_v1, run_parent_staged_link_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use std.common.crypto.sha256.{sha256_text}

val STAGED_LINK_CLI_MAX_WORKERS_V1: i64 = 16

struct ParentStagedLinkCliArgsV1:
    valid: bool
    expected_plan_digest: text
    template_path: text
    template_digest: text
    config_paths: [text]

struct ParentStagedLinkLoadV1:
    valid: bool
    reason: text
    plan: ParentStagedLinkPlanV1?
    manifest_wire: text
    request_wires: [text]

fn _staged_load_reject_v1(reason: text) -> ParentStagedLinkLoadV1:
    ParentStagedLinkLoadV1(false, reason, nil, "", [])

fn _staged_cli_path_v1(value: text) -> bool:
    if not value.starts_with("/") or value.len() < 2 or
       value.len() > 4096 or value.ends_with("/") or
       value.contains("//"):
        return false
    val parts = value.split("/")
    var i: i64 = 1
    while i < parts.len():
        if parts[i] == "" or parts[i] == "." or parts[i] == ".." or
           parts[i].contains("\n") or parts[i].contains("\r") or
           parts[i].contains("\x00"):
            return false
        i = i + 1
    true

fn parent_staged_link_cli_selected_v1(args: [text]) -> bool:
    for item in args:
        if item == "--staged-plan-digest": return true
    false

fn parse_parent_staged_link_cli_args_v1(args: [text]) -> ParentStagedLinkCliArgsV1:
    val invalid = ParentStagedLinkCliArgsV1(false, "", "", "", [])
    var remaining = args
    if remaining.len() > 0 and
       (remaining[0].ends_with("parent_graph_runner_main.spl") or
        remaining[0].ends_with("simple_dist_build_parent") or
        remaining[0].ends_with("simple_dist_build_parent.exe")):
        remaining = remaining[1:]
    if remaining.len() > 0 and remaining[0] == "--":
        remaining = remaining[1:]
    if remaining.len() < 8 or
       remaining.len() > 6 + STAGED_LINK_CLI_MAX_WORKERS_V1 * 2 or
       remaining[0] != "--staged-plan-digest" or
       not scheduler_action_digest_valid_v1(remaining[1]) or
       remaining[2] != "--template" or
       not _staged_cli_path_v1(remaining[3]) or
       remaining[4] != "--template-digest" or
       not scheduler_action_digest_valid_v1(remaining[5]):
        return invalid
    var paths: [text] = []
    var i: i64 = 6
    while i < remaining.len():
        if remaining[i] != "--config" or i + 1 >= remaining.len() or
           not _staged_cli_path_v1(remaining[i + 1]):
            return invalid
        paths.push(remaining[i + 1])
        i = i + 2
    if paths.len() == 0 or paths.len() > STAGED_LINK_CLI_MAX_WORKERS_V1:
        return invalid
    ParentStagedLinkCliArgsV1(true, remaining[1], remaining[3],
        remaining[5], paths)

fn load_parent_staged_link_cli_v1(args: [text]) -> ParentStagedLinkLoadV1:
    """Load and preflight one exact staged plan without opening its owner."""
    val command = parse_parent_staged_link_cli_args_v1(args)
    if not command.valid:
        return _staged_load_reject_v1("arguments-invalid")
    var configs: [DistBuildConfigV1] = []
    var config_wires: [text] = []
    for path in command.config_paths:
        val read = file_read_regular_no_follow_bounded(path,
            DIST_BUILD_CONFIG_MAX_BYTES_V1)
        if read.is_err():
            return _staged_load_reject_v1("config-unreadable")
        val wire = read.unwrap()
        val parsed = parse_dist_build_config_v1(wire)
        if parsed == nil or parsed.unwrap().graph_path == "":
            return _staged_load_reject_v1("config-invalid-or-not-graph")
        configs.push(parsed.unwrap())
        config_wires.push(wire)
    val graph_path = configs[0].graph_path
    for config in configs:
        if config.graph_path != graph_path:
            return _staged_load_reject_v1("config-graph-path-mismatch")
    val loaded = load_pinned_parent_link_template_v1(
        command.template_path, command.template_digest)
    if not loaded.valid or loaded.template == nil or loaded.attempt == nil:
        return _staged_load_reject_v1("template-invalid")
    val manifest_read = file_read_regular_no_follow_bounded(graph_path,
        PARENT_GRAPH_MANIFEST_MAX_BYTES_V1)
    if manifest_read.is_err():
        return _staged_load_reject_v1("graph-unreadable")
    val manifest_wire = manifest_read.unwrap()
    val manifest = parse_parent_graph_manifest_v1(manifest_wire)
    if not manifest.valid or manifest.entries.len() >= 256:
        return _staged_load_reject_v1("producer-manifest-invalid")
    var request_wires: [text] = []
    for entry in manifest.entries:
        val read = file_read_regular_no_follow_bounded(entry.path,
            BUILD_WORKER_REQUEST_MAX_BYTES_V1)
        if read.is_err() or sha256_text(read.unwrap()) != entry.digest:
            return _staged_load_reject_v1("producer-request-mismatch")
        request_wires.push(read.unwrap())
    val plan = ParentStagedLinkPlanV1(sha256_text(manifest_wire),
        loaded.template_wire_digest, config_wires,
        loaded.template.unwrap(), loaded.attempt.unwrap(),
        loaded.cpu_tokens, loaded.fd_tokens,
        command.expected_plan_digest)
    val prepared = prepare_parent_staged_link_v1(plan, manifest_wire,
        request_wires)
    if not prepared.valid:
        return _staged_load_reject_v1(prepared.reason)
    ParentStagedLinkLoadV1(true, "", plan, manifest_wire,
        request_wires)

fn run_parent_staged_link_cli_v1(args: [text]) -> i64:
    val loaded = load_parent_staged_link_cli_v1(args)
    if not loaded.valid or loaded.plan == nil:
        val reason = loaded.reason.replace("\n", " ").replace("\r", " ")
        print("parent-staged-link: BLOCKED reason={reason}")
        if loaded.reason == "arguments-invalid": return 2
        return 1
    val result = run_parent_staged_link_v1(loaded.plan.unwrap(),
        loaded.manifest_wire, loaded.request_wires, 0)
    if result.complete:
        print("parent-staged-link: COMPLETED accepted={result.accepted_count} attempt={result.last_attempt_id}")
        return 0
    val reason = result.reason.replace("\n", " ").replace("\r", " ")
    print("parent-staged-link: INCOMPLETE reason={reason} accepted={result.accepted_count} attempt={result.last_attempt_id} reconciliation={result.reconciliation_required}")
    1

export STAGED_LINK_CLI_MAX_WORKERS_V1
export ParentStagedLinkCliArgsV1, ParentStagedLinkLoadV1
export parent_staged_link_cli_selected_v1
export parse_parent_staged_link_cli_args_v1, load_parent_staged_link_cli_v1
export run_parent_staged_link_cli_v1
