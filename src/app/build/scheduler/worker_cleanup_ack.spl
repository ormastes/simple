# Cleanup is a separate worker operation. The permanent binding and ACK
# markers prevent either a second launch or a conflicting cleanup request.
use app.io.mod.{file_read_regular_no_follow_bounded, file_exists,
    file_create_exclusive, file_fsync, directory_fsync, file_lock,
    file_unlock, dir_remove_all}
use app.build.scheduler.worker_execute.{LocalBuildWorkerConfigV1,
    local_build_worker_request_problem_v1}
use app.build.scheduler.worker_ready.{read_ready_build_worker_v1}
use app.build.scheduler.dispatch_wire.{parse_build_result_v1,
    BUILD_DISPATCH_WIRE_MAX_V1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use app.build.scheduler.worker_attempt_binding.{
    parse_worker_attempt_binding_v1}
use std.nogc_async_mut.container.providers.linux.oci_runtime_v1.{
    LinuxOciRuntimeProviderV1, LinuxOciRequestV1}
use std.common.crypto.sha256.{sha256_text}

struct BuildWorkerCleanupAckV1:
    acknowledged: bool
    reason: text
    wire: text

fn _cleanup_reject_v1(reason: text) -> BuildWorkerCleanupAckV1:
    BuildWorkerCleanupAckV1(false, reason, "")

fn _cleanup_token_v1(value: text) -> bool:
    if value == "" or value == "." or value == ".." or
       value.len() > 128 or value.starts_with("-"):
        return false
    for c in value.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "-" or c == "_" or c == ".":
            continue
        return false
    true

fn _cleanup_marker_v1(config: LocalBuildWorkerConfigV1,
        attempt_id: text, phase: text) -> text:
    config.state_dir + "/worker-attempt-" + attempt_id + ".ack-" + phase

fn _cleanup_mark_v1(path: text, directory: text, wire: text) -> bool:
    if file_exists(path):
        val prior = file_read_regular_no_follow_bounded(path, 1024)
        if prior.is_err() or prior.unwrap() != wire: return false
    elif not file_create_exclusive(path, wire):
        return false
    file_fsync(path) and directory_fsync(directory)

fn _cleanup_ack_wire_v1(attempt_id: text, request_digest: text,
        fence: i64, result_digest: text) -> text:
    "simple-build-cleaned-v1|" + attempt_id + "|" + request_digest +
        "|" + fence.to_text() + "|" + result_digest + "\n"

fn _cleanup_locked_v1(config: LocalBuildWorkerConfigV1,
        attempt_id: text, request_digest: text, fence: i64,
        result_digest: text, boot_id: text) -> BuildWorkerCleanupAckV1:
    val binding_path = config.state_dir + "/worker-attempt-" + attempt_id + ".binding"
    val binding_read = file_read_regular_no_follow_bounded(binding_path, 8192)
    if binding_read.is_err(): return _cleanup_reject_v1("binding-unavailable")
    val binding = parse_worker_attempt_binding_v1(binding_read.unwrap(),
        config.state_dir, request_digest, config.worker_id, attempt_id,
        fence, boot_id, config.provider_generation, config.engine,
        config.image, false)
    if not binding.valid: return _cleanup_reject_v1(binding.reason)
    val stage = binding.stage
    val native_id = binding.native_id
    val marker_wire = "simple-worker-cleanup-v1\nrequest=" + request_digest +
        "\nresult=" + result_digest + "\nattempt=" + attempt_id +
        "\nfence=" + fence.to_text() + "\nbinding=" +
        binding.digest + "\n"
    val requested_path = _cleanup_marker_v1(config, attempt_id, "requested")
    val terminal_path = _cleanup_marker_v1(config, attempt_id, "terminal")
    val absent_path = _cleanup_marker_v1(config, attempt_id, "absent")
    val cleaned_path = _cleanup_marker_v1(config, attempt_id, "cleaned")
    val ack_wire = _cleanup_ack_wire_v1(attempt_id, request_digest,
        fence, result_digest)
    if file_exists(cleaned_path):
        if not _cleanup_mark_v1(cleaned_path, config.state_dir, marker_wire):
            return _cleanup_reject_v1("cleaned-marker-mismatch")
        return BuildWorkerCleanupAckV1(true, "", ack_wire)
    # A completed tombstone may be replayed after a reboot or policy change.
    # Every path that can still destroy or remove bytes needs current identity.
    val current = parse_worker_attempt_binding_v1(binding_read.unwrap(),
        config.state_dir, request_digest, config.worker_id, attempt_id,
        fence, boot_id, config.provider_generation, config.engine,
        config.image, true)
    if not current.valid: return _cleanup_reject_v1(current.reason)
    if not file_exists(requested_path):
        val ready = read_ready_build_worker_v1(config.inbox_root, attempt_id,
            config.worker_id, request_digest)
        if ready == nil or ready.unwrap().fence != fence:
            return _cleanup_reject_v1("ready-request-mismatch")
        val request = ready.unwrap()
        if local_build_worker_request_problem_v1(config, request) != "":
            return _cleanup_reject_v1("request-policy-invalid")
        val result_read = file_read_regular_no_follow_bounded(
            config.inbox_root + "/" + attempt_id +
                "/.simple-control/results/result.wire",
            BUILD_DISPATCH_WIRE_MAX_V1)
        if result_read.is_err() or sha256_text(result_read.unwrap()) != result_digest:
            return _cleanup_reject_v1("result-digest-mismatch")
        val parsed = parse_build_result_v1(result_read.unwrap())
        if parsed == nil or
           parsed.unwrap().candidate.action_digest != request.attempt.action_digest or
           parsed.unwrap().candidate.attempt_id != attempt_id or
           parsed.unwrap().candidate.worker_id != config.worker_id or
           parsed.unwrap().fence != fence:
            return _cleanup_reject_v1("result-identity-mismatch")
    if not _cleanup_mark_v1(requested_path, config.state_dir, marker_wire):
        return _cleanup_reject_v1("requested-marker-not-durable")
    if not file_exists(absent_path):
        val ready = read_ready_build_worker_v1(config.inbox_root, attempt_id,
            config.worker_id, request_digest)
        if ready == nil or ready.unwrap().fence != fence:
            return _cleanup_reject_v1("ready-request-for-recovery-unavailable")
        val request = ready.unwrap()
        val oci = LinuxOciRequestV1(pod_uid: attempt_id, attempt: fence,
            operation_id: "build-" + fence.to_text(), image: config.image,
            bundle_path: "", command: request.action.argv, args: [],
            timeout_ms: config.timeout_ms,
            cpu_limit_millis: request.cpu_tokens * 1000,
            memory_limit_bytes: request.attempt.memory_budget_bytes,
            pid_limit: config.pid_limit, network_policy: "none",
            filesystem_policy: "read-only", build_input_root: stage + "/inputs",
            build_output_root: stage + "/outputs")
        val provider = LinuxOciRuntimeProviderV1.new("linux", config.engine,
            config.state_dir, boot_id, config.provider_generation, true,
            config.timeout_ms)
        val intent = provider.intent_for(oci)
        if intent.native_id != native_id or
           intent.operation_id != oci.operation_id or
           intent.node_boot_id != boot_id or
           intent.provider_generation != config.provider_generation or
           intent.engine != config.engine:
            return _cleanup_reject_v1("provider-intent-mismatch")
        val recovered = provider.recover(oci)
        if recovered.status == "ok":
            val state = recovered.state
            if state.identity.native_id != native_id or
               state.identity.operation_id != oci.operation_id or
               state.identity.node_boot_id != boot_id or
               state.identity.provider_generation != config.provider_generation or
               (state.phase != "exited" and state.phase != "stopped" and
                state.phase != "destroyed"):
                return _cleanup_reject_v1("container-not-terminal-or-identity-mismatch")
            if state.phase != "destroyed":
                if not _cleanup_mark_v1(terminal_path, config.state_dir, marker_wire):
                    return _cleanup_reject_v1("terminal-marker-not-durable")
                val destroyed = provider.destroy(oci, false)
                if destroyed.status != "ok":
                    return _cleanup_reject_v1("container-destroy-unconfirmed: " +
                        destroyed.reason)
        elif recovered.reason != "native-recover-not-found" or
             not file_exists(terminal_path) or
             not _cleanup_mark_v1(terminal_path, config.state_dir, marker_wire):
            return _cleanup_reject_v1("container-absence-unconfirmed")
        val provider_intent = config.state_dir + "/runtime-intent-" +
            attempt_id + "-" + fence.to_text() + "-" +
            config.provider_generation.to_text()
        if recovered.status == "ok" and
           (not file_fsync(provider_intent) or not directory_fsync(config.state_dir)):
            return _cleanup_reject_v1("provider-intent-not-durable")
        if not _cleanup_mark_v1(absent_path, config.state_dir, marker_wire):
            return _cleanup_reject_v1("absent-marker-not-durable")
    elif not _cleanup_mark_v1(absent_path, config.state_dir, marker_wire):
        return _cleanup_reject_v1("absent-marker-mismatch")
    val stage_parent = config.state_dir + "/build-attempts"
    if file_exists(stage) and not dir_remove_all(stage):
        return _cleanup_reject_v1("stage-remove-failed")
    if not directory_fsync(stage_parent):
        return _cleanup_reject_v1("stage-parent-not-durable")
    val inbox = config.inbox_root + "/" + attempt_id
    if file_exists(inbox) and not dir_remove_all(inbox):
        return _cleanup_reject_v1("inbox-remove-failed")
    if not directory_fsync(config.inbox_root):
        return _cleanup_reject_v1("inbox-parent-not-durable")
    if not _cleanup_mark_v1(cleaned_path, config.state_dir, marker_wire):
        return _cleanup_reject_v1("cleaned-marker-not-durable")
    BuildWorkerCleanupAckV1(true, "", ack_wire)

fn acknowledge_build_worker_cleanup_v1(config: LocalBuildWorkerConfigV1,
        attempt_id: text, request_digest: text, fence: i64,
        result_digest: text) -> BuildWorkerCleanupAckV1:
    """Retire only this stopped, parent-acknowledged worker attempt."""
    if not _cleanup_token_v1(attempt_id) or
       not scheduler_action_digest_valid_v1(request_digest) or
       not scheduler_action_digest_valid_v1(result_digest) or
       fence <= 0 or fence > 1000000000 or
       not file_exists(config.state_dir):
        return _cleanup_reject_v1("ack-arguments-invalid")
    val os_read = file_read_regular_no_follow_bounded("/proc/sys/kernel/ostype", 64)
    val boot_read = file_read_regular_no_follow_bounded(
        "/proc/sys/kernel/random/boot_id", 128)
    if os_read.is_err() or boot_read.is_err() or
       os_read.unwrap().trim() != "Linux" or
       not _cleanup_token_v1(boot_read.unwrap().trim()):
        return _cleanup_reject_v1("linux-boot-identity-invalid")
    val handle = file_lock(config.state_dir + "/worker.lock", 1)
    if handle < 0: return _cleanup_reject_v1("worker-busy")
    val result = _cleanup_locked_v1(config, attempt_id, request_digest,
        fence, result_digest, boot_read.unwrap().trim())
    if not file_unlock(handle): return _cleanup_reject_v1("worker-unlock-failed")
    result

export BuildWorkerCleanupAckV1, acknowledge_build_worker_cleanup_v1
