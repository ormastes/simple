# Operator-only cold compile-to-link qualification from one issued staged plan.
use app.io.mod.{file_is_regular_no_follow, file_hash_sha256, file_size_raw,
    file_copy, file_fsync, secure_temp_dir, dir_remove_all,
    process_run_bounded, time_now_unix_micros, file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.package_sffi.{set_permissions}
use std.nogc_sync_mut.io.crypto_sffi.{random_hex}
use std.common.crypto.sha256.{sha256_text}
use app.build.scheduler.parent_issued_root.{PARENT_ISSUED_ROOT_V1}
use app.build.scheduler.parent_issued_plan_store.{load_issued_parent_plan_v1}
use app.build.scheduler.parent_staged_link_cli.{load_parent_staged_link_cli_v1}
use app.build.scheduler.parent_staged_link.{ParentStagedLinkPlanV1,
    prepare_parent_staged_link_v1}
use app.build.scheduler.parent_link_resolution.{
    ParentLinkResolutionV1, resolve_parent_link_v1,
    resolved_parent_link_request_v1}
use app.build.scheduler.parent_graph_request.{ParentGraphRequestV1,
    admit_parent_graph_requests_v1}
use app.build.scheduler.parent_cli.{DistBuildConfigV1}
use app.build.scheduler.worker_request.{encode_build_worker_request_v1}
use app.build.scheduler.owner.{scheduler_owner_open_v1,
    scheduler_owner_close_v1}
use app.build.scheduler.ledger.{SchedulerLedgerV1, SchedulerAttemptV1,
    scheduler_ledger_valid_v1}
use app.build.scheduler.parent_cleanup_pending.{parent_cleanup_acked_v1}
use app.build.scheduler.two_node_qualification.{
    TwoNodeQualificationV1, audit_two_node_graph_v1}
use app.build.scheduler.parent_artifact_export_policy.{
    ParentArtifactExportPolicyRowV1, PARENT_EXPORT_POLICY_MAX_BYTES_V1,
    parse_parent_artifact_export_policy_v1,
    select_parent_artifact_export_policy_v1}
use app.build.scheduler.parent_artifact_export.{
    export_accepted_build_policy_row_v1}
use app.build.scheduler.worker_execution_profile.{
    build_worker_execution_profile_problem_v1}
use app.build.scheduler.trusted_worker_invocation.{
    query_build_worker_capability_ssh_v1}
use app.build.scheduler.worker_capability.{BuildWorkerCapabilityV1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use compiler.common.build_contract.{AcceptedResult, action_spec_digest_v1}

val TWO_NODE_STAGED_NATIVE_MAX_BYTES_V1: i64 = 536870912
val TWO_NODE_STAGED_RUN_TIMEOUT_MS_V1: i64 = 900000
val TWO_NODE_STAGED_CAPTURE_MODE_V1: i32 = 0o700
val TWO_NODE_STAGED_EXEC_RESULT_MAX_BYTES_V1: i64 = 4096

struct TwoNodeStagedFixtureV1:
    native_path: text
    native_digest: text
    issued_record_digest: text
    producer_action_digest: text
    producer_worker_id: text
    link_worker_id: text
    export_policy_path: text
    export_policy_digest: text
    export_policy_row_id: text
    verifier_path: text
    verifier_digest: text
    verifier_stdout_digest: text
    verifier_policy_digest: text

struct TwoNodeStagedQualificationV1:
    status: text
    reason: text
    native_digest: text
    issued_record_digest: text
    producer_action_digest: text
    link_action_digest: text
    producer_attempt_id: text
    link_attempt_id: text
    producer_output_digest: text
    executable_digest: text
    executable_path: text
    verifier_digest: text
    attempt_count: i64
    accepted_count: i64
    elapsed_ms: i64

struct _StagedProposalV1:
    attempt_id: text
    action_digest: text

struct _StagedLoadedV1:
    valid: bool
    reason: text
    plan: ParentStagedLinkPlanV1?
    graph: ParentGraphRequestV1?
    workers: [DistBuildConfigV1]
    request_wires: [text]

fn _staged_blocked_v1(reason: text) -> TwoNodeStagedQualificationV1:
    TwoNodeStagedQualificationV1("BLOCKED", reason, "", "", "", "", "",
        "", "", "", "", "", 0, 0, 0)

fn _staged_audit_v1(owner_root: text, graph: ParentGraphRequestV1,
        cas_root: text, fixture: TwoNodeStagedFixtureV1,
        link_digest: text, producer_output: text,
        producer_output_digest: text, link_output: text,
        link_output_digest: text) -> TwoNodeQualificationV1:
    audit_two_node_graph_v1(owner_root, graph, cas_root,
        fixture.producer_action_digest, link_digest,
        fixture.producer_worker_id, fixture.link_worker_id,
        producer_output, producer_output_digest, link_output,
        link_output_digest)

fn _staged_proposals_v1(output: text) -> [_StagedProposalV1]?:
    val prefix = "parent-graph: PROPOSED attempt="
    var rows: [_StagedProposalV1] = []
    for line in output.split("\n"):
        if line.starts_with(prefix):
            val marker = " action="
            val marker_at = line.index_of(marker)
            if marker_at < prefix.len(): return nil
            val attempt = line[prefix.len():marker_at]
            val action = line[marker_at + marker.len():]
            if attempt == "" or not scheduler_action_digest_valid_v1(action):
                return nil
            for prior in rows:
                if prior.attempt_id == attempt: return nil
            rows.push(_StagedProposalV1(attempt, action))
    rows

fn _staged_accepted_v1(ledger: SchedulerLedgerV1,
        action_digest: text) -> AcceptedResult?:
    var found: AcceptedResult? = nil
    for row in ledger.accepted:
        if row.action_digest == action_digest:
            if found != nil: return nil
            found = row
    found

fn _staged_attempt_v1(ledger: SchedulerLedgerV1,
        accepted: AcceptedResult) -> SchedulerAttemptV1?:
    var found: SchedulerAttemptV1? = nil
    for row in ledger.attempts:
        if row.attempt_id == accepted.accepted_attempt_id and
           row.action_digest == accepted.action_digest:
            if found != nil: return nil
            found = row
    found

fn _staged_worker_capability_ok_v1(config: DistBuildConfigV1,
        nonce: text) -> BuildWorkerCapabilityV1?:
    val reply = query_build_worker_capability_ssh_v1(config.node.ssh,
        nonce)
    if not reply.received or reply.capability == nil: return nil
    val cap = reply.capability.unwrap()
    if cap.worker_id != config.node.ssh.node.worker_id or
       cap.nonce != nonce or cap.execution_os != "linux" or
       cap.provider_id != "linux-oci-v1" or
       not ["podman", "docker"].contains(cap.engine) or cap.image == "" or
       not cap.image.contains("@sha256:") or cap.provider_generation <= 0 or
       cap.boot_id == "":
        return nil
    cap

fn _staged_capture_v1(source: text, digest: text, destination: text) -> bool:
    file_is_regular_no_follow(source) and file_size_raw(source) > 0 and
        file_size_raw(source) <= TWO_NODE_STAGED_NATIVE_MAX_BYTES_V1 and
        file_hash_sha256(source) == digest and file_copy(source, destination) and
        file_is_regular_no_follow(destination) and
        file_size_raw(destination) > 0 and
        file_size_raw(destination) <= TWO_NODE_STAGED_NATIVE_MAX_BYTES_V1 and
        file_hash_sha256(destination) == digest and
        set_permissions(destination, TWO_NODE_STAGED_CAPTURE_MODE_V1) and
        file_fsync(destination)

fn _staged_resolved_operands_v1(plan: ParentStagedLinkPlanV1,
        producer_graph: ParentGraphRequestV1,
        producer_action_digest: text,
        resolved: ParentLinkResolutionV1) -> text:
    if not resolved.valid or resolved.action == nil or
       resolved.action_digest == "" or
       action_spec_digest_v1(resolved.action.unwrap()) != resolved.action_digest:
        return ""
    val action = resolved.action.unwrap()
    if action.argv.len() == 0 or plan.template.ordered_inputs.len() == 0 or
       resolved.action_digest == action_spec_digest_v1(plan.template.base_action):
        return ""
    for item in plan.template.ordered_inputs:
        if item.producer_action_digest != producer_action_digest or
           item.argv_index < 0 or item.argv_index >= action.argv.len() or
           action.argv[item.argv_index] !=
               "/simple-build/inputs/" + item.output_path:
            return ""
        var producer_declares_output = false
        for producer in producer_graph.actions:
            if producer.action_digest == item.producer_action_digest and
               producer.spec.output_paths.contains(item.output_path):
                producer_declares_output = true
        if not producer_declares_output: return ""
        var dependency_found = false
        for dependency in action.inputs.dependency_outputs:
            if dependency.action_digest == item.producer_action_digest and
               dependency.output_path == item.output_path and
               scheduler_action_digest_valid_v1(dependency.content_digest):
                dependency_found = true
        if not dependency_found: return ""
    resolved.action_digest

fn _staged_load_v1(fixture: TwoNodeStagedFixtureV1) -> _StagedLoadedV1:
    val issued = load_issued_parent_plan_v1(PARENT_ISSUED_ROOT_V1,
        fixture.issued_record_digest)
    if not issued.valid or issued.record == nil:
        return _StagedLoadedV1(false, "issued-record-unavailable",
            nil, nil, [], [])
    val record = issued.record.unwrap()
    var args: [text] = ["--staged-plan-digest", record.plan_digest,
        "--template", record.template_path,
        "--template-digest", record.template_digest]
    for path in record.config_paths:
        args.push("--config")
        args.push(path)
    val loaded = load_parent_staged_link_cli_v1(args)
    if not loaded.valid or loaded.plan == nil:
        return _StagedLoadedV1(false, "issued-staged-plan-invalid",
            nil, nil, [], [])
    val prepared = prepare_parent_staged_link_v1(loaded.plan.unwrap(),
        loaded.manifest_wire, loaded.request_wires)
    if not prepared.valid or prepared.graph == nil:
        return _StagedLoadedV1(false, "staged-preflight-invalid",
            nil, nil, [], [])
    _StagedLoadedV1(true, "", loaded.plan, prepared.graph,
        prepared.workers, loaded.request_wires)

fn _staged_owner_empty_v1(owner_root: text) -> bool:
    val owner = scheduler_owner_open_v1(owner_root)
    if owner.error != "" or owner.state.error != "": return false
    val ledger = owner.state.ledger
    val empty = scheduler_ledger_valid_v1(ledger) and
        ledger.attempts.len() == 0 and ledger.fences.len() == 0 and
        ledger.accepted.len() == 0 and ledger.failures.len() == 0
    scheduler_owner_close_v1(owner) and empty

fn _staged_link_graph_v1(plan: ParentStagedLinkPlanV1,
        producer_graph: ParentGraphRequestV1, request_wires: [text],
        resolved: ParentLinkResolutionV1) -> ParentGraphRequestV1?:
    if producer_graph.requests.len() != 1 or request_wires.len() != 1:
        return nil
    if encode_build_worker_request_v1(producer_graph.requests[0]) !=
       request_wires[0]:
        return nil
    val request = resolved_parent_link_request_v1(resolved,
        plan.link_attempt, 1, plan.link_cpu_tokens, plan.link_fd_tokens)
    if request == nil: return nil
    var wires = request_wires
    wires.push(encode_build_worker_request_v1(request.unwrap()))
    val graph = admit_parent_graph_requests_v1(wires,
        resolved.action_digest, plan.link_attempt.worker_id, 0)
    if not graph.valid or graph.actions.len() != 2: return nil
    graph

fn _staged_policy_row_v1(fixture: TwoNodeStagedFixtureV1,
        worker: DistBuildConfigV1, link_digest: text,
        link_target: text
        ) -> ParentArtifactExportPolicyRowV1?:
    if worker.export_root == "" or
       worker.export_policy_path != fixture.export_policy_path or
       worker.export_policy_digest != fixture.export_policy_digest:
        return nil
    val read = file_read_regular_no_follow_bounded(
        fixture.export_policy_path, PARENT_EXPORT_POLICY_MAX_BYTES_V1)
    if read.is_err() or sha256_text(read.unwrap()) != fixture.export_policy_digest:
        return nil
    val policy = parse_parent_artifact_export_policy_v1(read.unwrap())
    val selected = select_parent_artifact_export_policy_v1(policy,
        fixture.export_policy_row_id)
    if selected == nil: return nil
    val row = selected.unwrap()
    if row.kind != "executable" or row.mode != 0o755 or
       row.action_digest != link_digest or
       row.target_triple != link_target:
        return nil
    row

fn _staged_verify_executable_v1(fixture: TwoNodeStagedFixtureV1,
        artifact_path: text, artifact_digest: text,
        captured_verifier: text) -> bool:
    if not file_is_regular_no_follow(artifact_path) or
       file_hash_sha256(artifact_path) != artifact_digest or
       file_hash_sha256(captured_verifier) != fixture.verifier_digest:
        return false
    val (stdout, stderr, code) = process_run_bounded(captured_verifier,
        ["--artifact", artifact_path, "--artifact-sha256", artifact_digest,
         "--policy-sha256", fixture.verifier_policy_digest],
        TWO_NODE_STAGED_RUN_TIMEOUT_MS_V1,
        TWO_NODE_STAGED_EXEC_RESULT_MAX_BYTES_V1)
    val expected = "simple-dist-exec-result-v1\n" +
        "artifact-sha256=" + artifact_digest + "\n" +
        "exit-code=0\nstdout-sha256=" + fixture.verifier_stdout_digest +
        "\nisolation=linux-oci-v1\n"
    code == 0 and stdout == expected and stderr == "" and
        stdout.len() <= TWO_NODE_STAGED_EXEC_RESULT_MAX_BYTES_V1 and
        file_hash_sha256(captured_verifier) == fixture.verifier_digest and
        file_is_regular_no_follow(artifact_path) and
        file_hash_sha256(artifact_path) == artifact_digest

fn qualify_issued_two_node_staged_v1(
        fixture: TwoNodeStagedFixtureV1) -> TwoNodeStagedQualificationV1:
    """Qualify compile/link and a pinned verifier receipt, then check repeat.

    The receipt binds the verifier bytes and its exact response. The verifier's
    isolation claim is not independently established by this controller.
    """
    if not fixture.native_path.ends_with(
            "/simple_dist_build_issued_parent") or
       not scheduler_action_digest_valid_v1(fixture.native_digest) or
       not scheduler_action_digest_valid_v1(fixture.issued_record_digest) or
       not scheduler_action_digest_valid_v1(fixture.producer_action_digest) or
       not scheduler_action_digest_valid_v1(fixture.export_policy_digest) or
       not scheduler_action_digest_valid_v1(fixture.verifier_digest) or
       not scheduler_action_digest_valid_v1(fixture.verifier_stdout_digest) or
       not scheduler_action_digest_valid_v1(fixture.verifier_policy_digest) or
       fixture.producer_worker_id == "" or fixture.link_worker_id == "" or
       fixture.producer_worker_id == fixture.link_worker_id or
       not fixture.verifier_path.starts_with("/"):
        return _staged_blocked_v1("fixture-invalid-or-unpinned")
    val started = time_now_unix_micros()
    val loaded = _staged_load_v1(fixture)
    if not loaded.valid: return _staged_blocked_v1(loaded.reason)
    if loaded.plan == nil or loaded.graph == nil:
        return _staged_blocked_v1("issued-plan-load-incomplete")
    val plan = loaded.plan.unwrap()
    val producer_graph = loaded.graph.unwrap()
    val workers = loaded.workers
    val request_wires = loaded.request_wires
    if workers.len() != 2 or producer_graph.actions.len() != 1 or
       producer_graph.requests.len() != 1 or request_wires.len() != 1 or
       producer_graph.actions[0].action_digest != fixture.producer_action_digest or
       producer_graph.actions[0].spec.kind != "compile" or
       plan.template.base_action.kind != "link" or
       producer_graph.requests[0].attempt.worker_id != fixture.producer_worker_id or
       plan.link_attempt.worker_id != fixture.link_worker_id:
        return _staged_blocked_v1("producer-link-identity-or-shape-mismatch")
    val producer_action = producer_graph.actions[0].spec
    var producer_config: DistBuildConfigV1? = nil
    var link_config: DistBuildConfigV1? = nil
    for worker in workers:
        if worker.node.ssh.node.worker_id == fixture.producer_worker_id:
            producer_config = worker
        if worker.node.ssh.node.worker_id == fixture.link_worker_id:
            link_config = worker
    if producer_config == nil or link_config == nil or
       producer_config.unwrap().owner_root != link_config.unwrap().owner_root or
       producer_config.unwrap().node.retained_cas_root !=
           link_config.unwrap().node.retained_cas_root:
        return _staged_blocked_v1("distinct-protected-workers-unavailable")
    val producer_nonce = random_hex(32) ?? ""
    val link_nonce = random_hex(32) ?? ""
    if producer_nonce == "" or link_nonce == "" or producer_nonce == link_nonce:
        return _staged_blocked_v1("nonce-bound-linux-oci-worker-unavailable")
    val producer_cap = _staged_worker_capability_ok_v1(
        producer_config.unwrap(), producer_nonce)
    val link_cap = _staged_worker_capability_ok_v1(
        link_config.unwrap(), link_nonce)
    if producer_cap == nil or link_cap == nil:
        return _staged_blocked_v1("nonce-bound-linux-oci-worker-unavailable")
    if producer_action.argv.len() == 0 or
       build_worker_execution_profile_problem_v1(producer_action,
           producer_cap.unwrap().compiler_entry) != "" or
       producer_cap.unwrap().toolchain.executable_digest !=
           producer_action.toolchain.executable_digest or
       producer_cap.unwrap().toolchain.behavior_digest !=
           producer_action.toolchain.behavior_digest or
       producer_cap.unwrap().toolchain.provider_abi_digest !=
           producer_action.toolchain.provider_abi_digest or
       producer_cap.unwrap().toolchain.runtime_digest !=
           producer_action.toolchain.runtime_digest or
       producer_cap.unwrap().toolchain.sysroot_digest !=
           producer_action.toolchain.sysroot_digest or
       producer_cap.unwrap().toolchain.target_triple !=
           producer_action.toolchain.target_triple:
        return _staged_blocked_v1("producer-compile-profile-unsupported")
    val link_action = plan.template.base_action
    if build_worker_execution_profile_problem_v1(link_action,
           link_cap.unwrap().compiler_entry) != "" or
       link_cap.unwrap().toolchain.executable_digest !=
           link_action.toolchain.executable_digest or
       link_cap.unwrap().toolchain.behavior_digest !=
           link_action.toolchain.behavior_digest or
       link_cap.unwrap().toolchain.provider_abi_digest !=
           link_action.toolchain.provider_abi_digest or
       link_cap.unwrap().toolchain.runtime_digest !=
           link_action.toolchain.runtime_digest or
       link_cap.unwrap().toolchain.sysroot_digest !=
           link_action.toolchain.sysroot_digest or
       link_cap.unwrap().toolchain.target_triple !=
           link_action.toolchain.target_triple:
        return _staged_blocked_v1("link-worker-profile-mismatch")
    val owner_root = producer_config.unwrap().owner_root
    val cas_root = producer_config.unwrap().node.retained_cas_root
    if not _staged_owner_empty_v1(owner_root):
        return _staged_blocked_v1("dedicated-owner-not-empty")
    val stage_result = secure_temp_dir("/tmp", "simple-staged-qual-")
    if stage_result.is_err():
        return _staged_blocked_v1("private-capture-directory-unavailable")
    val stage = stage_result.unwrap()
    val captured_native = stage + "/simple_dist_build_issued_parent"
    val captured_verifier = stage + "/simple_dist_exec_verifier"
    if not _staged_capture_v1(fixture.native_path,
            fixture.native_digest, captured_native) or
       not _staged_capture_v1(fixture.verifier_path,
            fixture.verifier_digest, captured_verifier):
        dir_remove_all(stage)
        return _staged_blocked_v1("pinned-native-or-verifier-capture-failed")
    val (_first_out, _first_err, first_code) = process_run_bounded(
        captured_native, ["--issued-plan", fixture.issued_record_digest],
        TWO_NODE_STAGED_RUN_TIMEOUT_MS_V1, 32768)
    if first_code != 0 or _first_out.len() >= 32768 or
       _first_err.len() >= 32768:
        dir_remove_all(stage)
        return _staged_blocked_v1("cold-issued-parent-run-incomplete")
    val proposals = _staged_proposals_v1(_first_out)
    if proposals == nil or proposals.unwrap().len() != 2 or
       _first_out.contains("RESUMING"):
        dir_remove_all(stage)
        return _staged_blocked_v1("cold-proposal-attribution-unavailable")
    val producer_proposal = proposals.unwrap()[0]
    val link_proposal = proposals.unwrap()[1]
    if producer_proposal.action_digest != fixture.producer_action_digest or
       producer_proposal.attempt_id == link_proposal.attempt_id:
        dir_remove_all(stage)
        return _staged_blocked_v1("cold-producer-proposal-mismatch")
    val owner_after_first = scheduler_owner_open_v1(owner_root)
    if owner_after_first.error != "" or owner_after_first.state.error != "":
        dir_remove_all(stage)
        return _staged_blocked_v1("owner-unavailable-after-cold-run")
    val ledger = owner_after_first.state.ledger
    if not scheduler_ledger_valid_v1(ledger) or
       ledger.attempts.len() != 2 or ledger.accepted.len() != 2 or
       ledger.failures.len() != 0 or ledger.fences.len() != 2:
        scheduler_owner_close_v1(owner_after_first)
        dir_remove_all(stage)
        return _staged_blocked_v1("cold-owner-ledger-not-exactly-two-successes")
    val producer_accepted = _staged_accepted_v1(ledger,
        fixture.producer_action_digest)
    if producer_accepted == nil or
       producer_accepted.unwrap().accepted_attempt_id !=
           producer_proposal.attempt_id:
        scheduler_owner_close_v1(owner_after_first)
        dir_remove_all(stage)
        return _staged_blocked_v1("producer-acceptance-attribution-mismatch")
    val producer_attempt = _staged_attempt_v1(ledger,
        producer_accepted.unwrap())
    if producer_attempt == nil or producer_attempt.unwrap().active or
       producer_attempt.unwrap().worker_id != fixture.producer_worker_id:
        scheduler_owner_close_v1(owner_after_first)
        dir_remove_all(stage)
        return _staged_blocked_v1("producer-attempt-worker-mismatch")
    val resolved = resolve_parent_link_v1(plan.template, ledger, cas_root)
    if not resolved.valid or resolved.action == nil:
        scheduler_owner_close_v1(owner_after_first)
        dir_remove_all(stage)
        return _staged_blocked_v1("dynamic-link-resolution-failed")
    val link_digest = _staged_resolved_operands_v1(plan,
        producer_graph, fixture.producer_action_digest, resolved)
    if link_digest == "" or link_proposal.action_digest != link_digest:
        scheduler_owner_close_v1(owner_after_first)
        dir_remove_all(stage)
        return _staged_blocked_v1("dynamic-link-proposal-mismatch")
    val dependencies = resolved.action.unwrap().inputs.dependency_outputs
    if dependencies.len() == 0 or
       dependencies[0].action_digest != fixture.producer_action_digest or
       not scheduler_action_digest_valid_v1(dependencies[0].content_digest):
        scheduler_owner_close_v1(owner_after_first)
        dir_remove_all(stage)
        return _staged_blocked_v1("retained-producer-output-digest-missing")
    val dependency = dependencies[0]
    val combined = _staged_link_graph_v1(plan, producer_graph,
        request_wires, resolved)
    if combined == nil:
        scheduler_owner_close_v1(owner_after_first)
        dir_remove_all(stage)
        return _staged_blocked_v1("resolved-link-graph-invalid")
    val link_accepted = _staged_accepted_v1(ledger, link_digest)
    if link_accepted == nil or
       link_accepted.unwrap().accepted_attempt_id != link_proposal.attempt_id:
        scheduler_owner_close_v1(owner_after_first)
        dir_remove_all(stage)
        return _staged_blocked_v1("link-acceptance-attribution-mismatch")
    val link_attempt = _staged_attempt_v1(ledger, link_accepted.unwrap())
    if link_attempt == nil or link_attempt.unwrap().active or
       link_attempt.unwrap().worker_id != fixture.link_worker_id or
       producer_attempt.unwrap().attempt_id == link_attempt.unwrap().attempt_id:
        scheduler_owner_close_v1(owner_after_first)
        dir_remove_all(stage)
        return _staged_blocked_v1("link-attempt-worker-mismatch")
    if not parent_cleanup_acked_v1(owner_after_first,
            producer_attempt.unwrap().attempt_id) or
       not parent_cleanup_acked_v1(owner_after_first,
            link_attempt.unwrap().attempt_id):
        scheduler_owner_close_v1(owner_after_first)
        dir_remove_all(stage)
        return _staged_blocked_v1("worker-cleanup-ack-incomplete")
    val first_attempt_count = ledger.attempts.len()
    val first_accepted_count = ledger.accepted.len()
    val audit_link_output = _staged_policy_row_v1(fixture,
        link_config.unwrap(), link_digest,
        resolved.action.unwrap().toolchain.target_triple)
    if audit_link_output == nil or
       not combined.unwrap().actions[1].spec.output_paths.contains(
           audit_link_output.unwrap().output_name):
        scheduler_owner_close_v1(owner_after_first)
        dir_remove_all(stage)
        return _staged_blocked_v1("pinned-executable-export-row-unavailable")
    if not scheduler_owner_close_v1(owner_after_first):
        dir_remove_all(stage)
        return _staged_blocked_v1("owner-release-after-cold-audit-failed")
    val exported = export_accepted_build_policy_row_v1(owner_root, cas_root,
        link_config.unwrap().export_root, audit_link_output.unwrap())
    if not exported.published or not exported.durable or
       exported.output_digest == "" or exported.destination == "" or
       file_hash_sha256(exported.destination) != exported.output_digest:
        dir_remove_all(stage)
        val export_reason = if exported.reason == "executable-format-unsupported":
            "protected-executable-format-rejected" else:
            "protected-executable-export-failed: " + exported.reason
        return _staged_blocked_v1(export_reason)
    if not _staged_verify_executable_v1(fixture, exported.destination,
            exported.output_digest, captured_verifier):
        dir_remove_all(stage)
        return _staged_blocked_v1("pinned-executable-verifier-receipt-failed")
    val audit = _staged_audit_v1(owner_root, combined.unwrap(), cas_root,
        fixture, link_digest, dependency.output_path,
        dependency.content_digest, audit_link_output.unwrap().output_name,
        exported.output_digest)
    if audit.status != "AUDIT_READY":
        dir_remove_all(stage)
        return _staged_blocked_v1("durable-two-node-audit: " + audit.reason)
    val (_repeat_stdout, _repeat_stderr, repeat_code) = process_run_bounded(captured_native,
        ["--issued-plan", fixture.issued_record_digest],
        TWO_NODE_STAGED_RUN_TIMEOUT_MS_V1, 32768)
    if repeat_code != 0 or _repeat_stdout.len() >= 32768 or
       _repeat_stderr.len() >= 32768 or
       _repeat_stdout.contains("parent-graph: PROPOSED") or
       _repeat_stdout.contains("parent-graph: RESUMING"):
        dir_remove_all(stage)
        return _staged_blocked_v1("repeat-created-attempt-or-incomplete")
    val repeat_owner = scheduler_owner_open_v1(owner_root)
    if repeat_owner.error != "" or repeat_owner.state.error != "":
        dir_remove_all(stage)
        return _staged_blocked_v1("owner-unavailable-after-repeat")
    val repeat_ledger = repeat_owner.state.ledger
    val unchanged = scheduler_ledger_valid_v1(repeat_ledger) and
        repeat_ledger.attempts.len() == first_attempt_count and
        repeat_ledger.accepted.len() == first_accepted_count and
        repeat_ledger.fences.len() == ledger.fences.len() and
        repeat_ledger.failures.len() == ledger.failures.len()
    val repeat_resolved = resolve_parent_link_v1(plan.template,
        repeat_ledger, cas_root)
    val repeat_link_digest = _staged_resolved_operands_v1(plan,
        producer_graph, fixture.producer_action_digest, repeat_resolved)
    val repeat_close = scheduler_owner_close_v1(repeat_owner)
    if not unchanged or repeat_link_digest != link_digest or not repeat_close:
        dir_remove_all(stage)
        return _staged_blocked_v1("repeat-changed-ledger-or-resolved-link")
    if not file_is_regular_no_follow(exported.destination) or
       file_hash_sha256(exported.destination) != exported.output_digest:
        dir_remove_all(stage)
        return _staged_blocked_v1("exported-executable-changed")
    if not dir_remove_all(stage):
        return _staged_blocked_v1("private-capture-cleanup-incomplete")
    val elapsed = (time_now_unix_micros() - started) / 1000
    TwoNodeStagedQualificationV1("PASS",
        "cold-staged-link-pinned-verifier-receipt-and-repeat-qualified",
        fixture.native_digest, fixture.issued_record_digest,
        fixture.producer_action_digest, link_digest,
        producer_attempt.unwrap().attempt_id, link_attempt.unwrap().attempt_id,
        dependency.content_digest, exported.output_digest,
        exported.destination, fixture.verifier_digest,
        first_attempt_count, first_accepted_count, elapsed)

export TwoNodeStagedFixtureV1, TwoNodeStagedQualificationV1
export qualify_issued_two_node_staged_v1
