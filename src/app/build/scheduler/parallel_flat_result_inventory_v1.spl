# Child-side flat output inventory. A parent must still verify pinned bytes.
use app.io.mod.{file_is_regular_no_follow, process_run_bounded}

val PARALLEL_FLAT_INVENTORY_MAX_FILES_V1: i64 = 131
val PARALLEL_FLAT_INVENTORY_CAPTURE_BYTES_V1: i64 = 1048576

struct ParallelFlatResultInventoryV1:
    valid: bool
    reason: text

fn _flat_inventory_reject_v1(reason: text) -> ParallelFlatResultInventoryV1:
    ParallelFlatResultInventoryV1(false, reason)

fn _flat_inventory_token_v1(value: text) -> bool:
    if value == "" or value == "." or value == ".." or
       value.len() > 128 or value.starts_with("-"):
        return false
    for ch in value.chars():
        if (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
           (ch >= "0" and ch <= "9") or ch == "_" or ch == "-" or
           ch == ".":
            continue
        return false
    true

fn _flat_inventory_root_v1(root: text) -> bool:
    if not root.starts_with("/") or root.len() < 2 or root.len() > 4096 or
       root.ends_with("/") or root.contains("//"):
        return false
    val parts = root.split("/")
    var index: i64 = 1
    while index < parts.len():
        if not _flat_inventory_token_v1(parts[index]): return false
        index = index + 1
    true

fn check_parallel_flat_result_inventory_v1(outputs_root: text,
        expected_names: [text]) -> ParallelFlatResultInventoryV1:
    """Claim exactly one flat set of regular result files, without trust."""
    if not _flat_inventory_root_v1(outputs_root) or
       expected_names.len() == 0 or
       expected_names.len() > PARALLEL_FLAT_INVENTORY_MAX_FILES_V1:
        return _flat_inventory_reject_v1("inventory-arguments-invalid")
    var expected_paths: [text] = []
    for name in expected_names:
        if not _flat_inventory_token_v1(name) or
           expected_paths.contains(outputs_root + "/" + name):
            return _flat_inventory_reject_v1("inventory-name-invalid")
        expected_paths.push(outputs_root + "/" + name)
    if not file_is_regular_no_follow("/usr/bin/find"):
        return _flat_inventory_reject_v1("find-unavailable")
    val (stdout, stderr, code) = process_run_bounded("/usr/bin/find",
        ["-P", outputs_root, "-print"], 15000,
        PARALLEL_FLAT_INVENTORY_CAPTURE_BYTES_V1)
    if code != 0 or stderr != "" or stdout == "" or
       stdout.bytes().len() >= PARALLEL_FLAT_INVENTORY_CAPTURE_BYTES_V1 or
       not stdout.ends_with("\n") or stdout.contains("\r") or
       stdout.contains("\0"):
        return _flat_inventory_reject_v1("find-output-invalid")
    val lines = stdout[0:stdout.len() - 1].split("\n")
    if lines.len() != expected_paths.len() + 1:
        return _flat_inventory_reject_v1("inventory-count-mismatch")
    var root_count: i64 = 0
    var seen: [text] = []
    for path in lines:
        if path == outputs_root:
            root_count = root_count + 1
        elif expected_paths.contains(path) and not seen.contains(path):
            seen.push(path)
        else:
            return _flat_inventory_reject_v1("inventory-path-mismatch")
    if root_count != 1 or seen.len() != expected_paths.len():
        return _flat_inventory_reject_v1("inventory-path-mismatch")
    for path in expected_paths:
        if not file_is_regular_no_follow(path):
            return _flat_inventory_reject_v1("inventory-file-invalid")
    ParallelFlatResultInventoryV1(true, "")

export ParallelFlatResultInventoryV1
export check_parallel_flat_result_inventory_v1
