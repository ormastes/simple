# Fixed administrator policy. No artifact is ever executed on the host.
# Trusted precondition: /etc/simple, engine, export/state roots and every
# ancestor are administrator-owned, non-symlink directories inaccessible to
# untrusted writers. A leaf O_NOFOLLOW read does not establish this precondition.
use app.io.mod.{get_args, env_get, file_read_regular_no_follow_bounded,
    file_is_regular_no_follow, file_hash_sha256}
use std.common.crypto.sha256.{sha256_text}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}

val DIST_EXEC_VERIFIER_CONFIG_PATH_V1 = "/etc/simple/dist-exec-verifier.v1"
val DIST_EXEC_VERIFIER_CONFIG_MAX_BYTES_V1: i64 = 8192

pub struct DistExecVerifierConfigV1:
    engine: text
    engine_path: text
    engine_digest: text
    image: text
    state_root: text
    export_root: text
    timeout_ms: i64
    cpu_limit_millis: i64
    memory_limit_bytes: i64
    pid_limit: i64
    provider_generation: i64
    stdout_limit_bytes: i64
    worker_path: text
    worker_digest: text

pub struct DistExecVerifierResultV1:
    status: text
    reason: text
    receipt: text
    retained_stage: text

fn _dist_exec_blocked_v1(reason: text) -> DistExecVerifierResultV1:
    DistExecVerifierResultV1("BLOCKED", reason, "", "")

pub fn dist_exec_verifier_path_valid_v1(path: text) -> bool:
    if not path.starts_with("/") or path == "/" or path.ends_with("/") or
       path.len() > 2048 or path.contains("//"):
        return false
    for component in path[1:].split("/"):
        if component == "." or component == ".." or component == "": return false
        for ch in component.chars():
            if not ((ch >= "a" and ch <= "z") or
                    (ch >= "A" and ch <= "Z") or
                    (ch >= "0" and ch <= "9") or
                    ch == "-" or ch == "_" or ch == "."):
                return false
    true

fn _dist_exec_positive_v1(raw: text, maximum: i64) -> i64:
    if raw == "" or raw.len() > 18: return -1
    for ch in raw.chars():
        if ch < "0" or ch > "9": return -1
    val value = raw.to_i64() ?? -1
    if value <= 0 or value > maximum or value.to_text() != raw: return -1
    value

pub fn parse_dist_exec_verifier_config_v1(wire: text) -> Result<DistExecVerifierConfigV1, text>:
    """Parse an exact ordered policy; duplicate/unknown keys are rejected."""
    if wire.len() == 0 or wire.len() > DIST_EXEC_VERIFIER_CONFIG_MAX_BYTES_V1 or
       not wire.ends_with("\n") or wire.contains("\r") or wire.contains("\x00"):
        return Err("policy-wire-invalid")
    val rows = wire[0:wire.len() - 1].split("\n")
    val keys = ["engine=", "engine-path=", "engine-sha256=", "image=",
        "state-root=", "export-root=", "timeout-ms=", "cpu-limit-millis=",
        "memory-limit-bytes=", "pid-limit=", "provider-generation=",
        "stdout-limit-bytes=", "trusted-ancestors=", "worker-path=", "worker-sha256="]
    if rows.len() != keys.len() + 1 or rows[0] != "simple-dist-exec-verifier-v1":
        return Err("policy-header-or-count-invalid")
    var values: [text] = []
    var index: i64 = 0
    while index < keys.len():
        if not rows[index + 1].starts_with(keys[index]): return Err("policy-key-invalid")
        values.push(rows[index + 1][keys[index].len():])
        index = index + 1
    if not ["podman", "docker"].contains(values[0]) or
       not dist_exec_verifier_path_valid_v1(values[1]) or
       not values[1].ends_with("/" + values[0]) or
       not scheduler_action_digest_valid_v1(values[2]):
        return Err("policy-engine-invalid")
    val image_parts = values[3].split("@sha256:")
    if image_parts.len() != 2 or image_parts[0] == "" or
       not scheduler_action_digest_valid_v1(image_parts[1]):
        return Err("policy-image-unpinned")
    for ch in image_parts[0].chars():
        if not ((ch >= "a" and ch <= "z") or (ch >= "0" and ch <= "9") or
                ch == "." or ch == "-" or ch == "_" or ch == "/" or ch == ":"):
            return Err("policy-image-invalid")
    if not dist_exec_verifier_path_valid_v1(values[4]) or
       not dist_exec_verifier_path_valid_v1(values[5]) or values[4] == values[5] or
       values[4].starts_with(values[5] + "/") or
       values[5].starts_with(values[4] + "/") or
       values[12] != "administrator-owned-no-symlinks-no-untrusted-writers":
        return Err("policy-roots-or-trust-invalid")
    if values[13] != "/usr/local/bin/simple_dist_exec_worker" or
       not scheduler_action_digest_valid_v1(values[14]):
        return Err("policy-worker-unpinned")
    val timeout = _dist_exec_positive_v1(values[6], 60000)
    val cpu = _dist_exec_positive_v1(values[7], 64000)
    val memory = _dist_exec_positive_v1(values[8], 68719476736)
    val pids = _dist_exec_positive_v1(values[9], 4096)
    val generation = _dist_exec_positive_v1(values[10], 999999999999999999)
    val output = _dist_exec_positive_v1(values[11], 16777216)
    if timeout < 0 or cpu < 0 or memory < 0 or pids < 0 or generation < 0 or output < 0:
        return Err("policy-resource-limit-invalid")
    Ok(DistExecVerifierConfigV1(values[0], values[1], values[2], values[3],
        values[4], values[5], timeout, cpu, memory, pids, generation, output,
        values[13], values[14]))

pub fn dist_exec_verifier_args_valid_v1(args: [text]) -> bool:
    args.len() == 6 and args[0] == "--artifact" and
        args[2] == "--artifact-sha256" and args[4] == "--policy-sha256" and
        dist_exec_verifier_path_valid_v1(args[1]) and
        scheduler_action_digest_valid_v1(args[3]) and
        scheduler_action_digest_valid_v1(args[5])

pub fn dist_exec_verifier_policy_binding_v1(wire: text, digest: text) -> bool:
    scheduler_action_digest_valid_v1(digest) and sha256_text(wire) == digest

pub fn dist_exec_verifier_export_allowed_v1(config: DistExecVerifierConfigV1,
        artifact: text) -> bool:
    dist_exec_verifier_path_valid_v1(artifact) and
        artifact.starts_with(config.export_root + "/")

pub fn run_dist_exec_verifier_v1(args: [text]) -> DistExecVerifierResultV1:
    if not dist_exec_verifier_args_valid_v1(args):
        return _dist_exec_blocked_v1("expected-artifact-artifact-sha256-policy-sha256")
    val read = file_read_regular_no_follow_bounded(
        DIST_EXEC_VERIFIER_CONFIG_PATH_V1, DIST_EXEC_VERIFIER_CONFIG_MAX_BYTES_V1)
    if read.is_err(): return _dist_exec_blocked_v1("administrator-policy-unavailable")
    val wire = read.unwrap()
    if not dist_exec_verifier_policy_binding_v1(wire, args[5]):
        return _dist_exec_blocked_v1("administrator-policy-digest-mismatch")
    val parsed = parse_dist_exec_verifier_config_v1(wire)
    if parsed.is_err(): return _dist_exec_blocked_v1(parsed.unwrap_err())
    val config = parsed.unwrap()
    if not dist_exec_verifier_export_allowed_v1(config, args[1]):
        return _dist_exec_blocked_v1("artifact-outside-export-root")
    if not file_is_regular_no_follow(args[1]) or file_hash_sha256(args[1]) != args[3]:
        return _dist_exec_blocked_v1("artifact-not-regular-or-digest-mismatch")
    val engine_directory = config.engine_path[0:config.engine_path.len() - config.engine.len() - 1]
    if (env_get("PATH") ?? "") != engine_directory or
       not file_is_regular_no_follow(config.engine_path) or
       file_hash_sha256(config.engine_path) != config.engine_digest:
        return _dist_exec_blocked_v1("engine-path-or-digest-mismatch")
    # Unqualified parent bridge: the image-resident dist_exec_worker captures
    # bytes using pinned V4 observation. This parent does not yet provision its
    # separate security domain/cgroup, consume its committed result, or prove
    # OCI destruction. Reject BEFORE any side effects. OCI logs cannot replace
    # a worker result: exact invocation bytes do not prove retained log history.
    return _dist_exec_blocked_v1("isolated-worker-parent-bridge-unqualified")

fn main() -> i64:
    var args = get_args()
    if args.len() == 7 and (args[0].ends_with("/simple_dist_exec_verifier") or
            args[0] == "simple_dist_exec_verifier" or
            args[0].ends_with("/dist_exec_verifier_main.spl")):
        args = args[1:]
    val result = run_dist_exec_verifier_v1(args)
    # No success receipt exists while the required provider capability is absent.
    print("dist-exec-verifier: {result.status} reason={result.reason}")
    2

export DistExecVerifierConfigV1, DistExecVerifierResultV1
export dist_exec_verifier_path_valid_v1, parse_dist_exec_verifier_config_v1
export dist_exec_verifier_args_valid_v1, dist_exec_verifier_policy_binding_v1
export dist_exec_verifier_export_allowed_v1, run_dist_exec_verifier_v1
