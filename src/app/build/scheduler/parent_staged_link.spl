# Two-phase parent graph: complete producer requests first, then construct a
# link request from accepted retained outputs. No unresolved link is dispatched.
use app.build.scheduler.parent_cli.{DistBuildConfigV1,
    DIST_BUILD_CONFIG_MAX_BYTES_V1, parse_dist_build_config_v1}
use app.build.scheduler.parent_graph_manifest.{
    PARENT_GRAPH_MANIFEST_MAX_BYTES_V1, parse_parent_graph_manifest_v1}
use app.build.scheduler.parent_graph_request.{ParentGraphRequestV1,
    admit_parent_graph_requests_v1}
use app.build.scheduler.parent_graph_runner.{ParentGraphRunV1,
    run_parent_graph_v1}
use app.build.scheduler.parent_link_template.{ParentLinkTemplateV1,
    parent_link_template_problem_v1}
use app.build.scheduler.parent_link_resolution.{ParentLinkResolutionV1,
    resolve_parent_link_from_owner_v1, resolved_parent_link_request_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    BUILD_WORKER_REQUEST_MAX_BYTES_V1, encode_build_worker_request_v1}
use app.build.scheduler.worker_execution_profile.{
    build_worker_execution_profile_problem_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use compiler.common.build_contract.{AttemptSpec, action_spec_digest_v1}
use compiler.common.cache.canonical_identity.{canon_str, canon_nat,
    canon_field, canon_seq}
use std.common.crypto.sha256.{sha256_text}

val PARENT_STAGED_LINK_MAX_WORKERS_V1: i64 = 16

struct ParentStagedLinkPlanV1:
    producer_manifest_digest: text
    template_wire_digest: text
    worker_config_wires: [text]
    template: ParentLinkTemplateV1
    link_attempt: AttemptSpec
    link_cpu_tokens: i64
    link_fd_tokens: i64
    expected_plan_digest: text

struct ParentStagedLinkPreparedV1:
    valid: bool
    reason: text
    graph: ParentGraphRequestV1?
    workers: [DistBuildConfigV1]

fn _staged_reject_v1(reason: text) -> ParentStagedLinkPreparedV1:
    ParentStagedLinkPreparedV1(false, reason, nil, [])

fn _staged_result_v1(reason: text, accepted: i64,
        attempt_id: text, reconcile: bool) -> ParentGraphRunV1:
    ParentGraphRunV1(false, reason, accepted, attempt_id, reconcile)

fn parent_staged_link_plan_digest_v1(plan: ParentStagedLinkPlanV1) -> text:
    """Canonical identity for the protected graph, template and worker policy."""
    if not scheduler_action_digest_valid_v1(
            plan.producer_manifest_digest) or
       not scheduler_action_digest_valid_v1(plan.template_wire_digest) or
       parent_link_template_problem_v1(plan.template) != "" or
       plan.worker_config_wires.len() == 0 or
       plan.worker_config_wires.len() > PARENT_STAGED_LINK_MAX_WORKERS_V1 or
       plan.link_attempt.version != 1 or
       plan.link_attempt.action_digest != "" or
       plan.link_attempt.attempt_id == "" or
       plan.link_attempt.worker_id == "" or
       plan.link_attempt.retry_number != 0 or
       plan.link_attempt.priority < 0 or
       plan.link_attempt.memory_budget_bytes <= 0 or
       plan.link_cpu_tokens <= 0 or plan.link_fd_tokens <= 0:
        return ""
    var config_ids: [text] = []
    for wire in plan.worker_config_wires:
        if wire.len() == 0 or wire.len() > DIST_BUILD_CONFIG_MAX_BYTES_V1 or
           parse_dist_build_config_v1(wire) == nil:
            return ""
        config_ids.push(canon_str(sha256_text(wire)))
    var operands: [text] = []
    for item in plan.template.ordered_inputs:
        operands.push(canon_seq([canon_str(item.producer_action_digest),
            canon_str(item.output_path), canon_nat(item.argv_index)]))
    val attempt = plan.link_attempt
    var checked_attempt = attempt
    checked_attempt.action_digest = action_spec_digest_v1(
        plan.template.base_action)
    if encode_build_worker_request_v1(BuildWorkerRequestV1(
            plan.template.base_action, checked_attempt, 1,
            plan.link_cpu_tokens, plan.link_fd_tokens)) == "":
        return ""
    sha256_text(canon_field("simple/parent-staged-link/v1", canon_seq([
        canon_str(plan.producer_manifest_digest),
        canon_str(plan.template_wire_digest),
        canon_seq(config_ids),
        canon_str(action_spec_digest_v1(plan.template.base_action)),
        canon_seq(operands),
        canon_str(attempt.attempt_id), canon_str(attempt.worker_id),
        canon_nat(attempt.retry_number), canon_nat(attempt.priority),
        canon_nat(attempt.memory_budget_bytes),
        canon_nat(plan.link_cpu_tokens), canon_nat(plan.link_fd_tokens)])))

fn prepare_parent_staged_link_v1(plan: ParentStagedLinkPlanV1,
        producer_manifest_wire: text,
        producer_request_wires: [text]) -> ParentStagedLinkPreparedV1:
    """Verify one pinned plan and its complete producer closure before work."""
    val identity = parent_staged_link_plan_digest_v1(plan)
    if identity == "" or identity != plan.expected_plan_digest:
        return _staged_reject_v1("staged-plan-digest-mismatch")
    if producer_manifest_wire.len() == 0 or
       producer_manifest_wire.len() > PARENT_GRAPH_MANIFEST_MAX_BYTES_V1 or
       sha256_text(producer_manifest_wire) != plan.producer_manifest_digest:
        return _staged_reject_v1("staged-producer-manifest-mismatch")
    val manifest = parse_parent_graph_manifest_v1(producer_manifest_wire)
    if not manifest.valid or
       producer_request_wires.len() != manifest.entries.len() or
       producer_request_wires.len() >= 256:
        return _staged_reject_v1("staged-producer-graph-invalid")
    var i: i64 = 0
    while i < producer_request_wires.len():
        val wire = producer_request_wires[i]
        if wire.len() == 0 or wire.len() > BUILD_WORKER_REQUEST_MAX_BYTES_V1 or
           sha256_text(wire) != manifest.entries[i].digest:
            return _staged_reject_v1("staged-producer-request-mismatch")
        i = i + 1
    var workers: [DistBuildConfigV1] = []
    for wire in plan.worker_config_wires:
        val parsed = parse_dist_build_config_v1(wire)
        if parsed == nil:
            return _staged_reject_v1("staged-worker-config-invalid")
        workers.push(parsed.unwrap())
    val graph = admit_parent_graph_requests_v1(producer_request_wires,
        "", workers[0].node.ssh.node.worker_id, 0)
    if not graph.valid:
        return _staged_reject_v1("staged-producer-graph: " + graph.reason)
    for item in plan.template.ordered_inputs:
        var found = false
        var output_declared = false
        for request in graph.requests:
            if request.attempt.action_digest == item.producer_action_digest:
                found = true
                output_declared = request.action.output_paths.contains(
                    item.output_path)
        if not found:
            return _staged_reject_v1("staged-template-producer-missing")
        if not output_declared:
            return _staged_reject_v1("staged-template-output-undeclared")
    for request in graph.requests:
        if request.attempt.attempt_id == plan.link_attempt.attempt_id:
            return _staged_reject_v1("staged-attempt-id-collision")
    var link_worker_found = false
    val link_action = plan.template.base_action
    if build_worker_execution_profile_problem_v1(link_action,
            link_action.argv[0]) != "":
        return _staged_reject_v1("staged-link-profile-unsupported")
    for worker in workers:
        if worker.node.ssh.node.worker_id == plan.link_attempt.worker_id:
            if link_worker_found or
               not worker.capabilities.target_triples.contains(
                   link_action.toolchain.target_triple) or
               not worker.capabilities.provider_abi_digests.contains(
                   link_action.toolchain.provider_abi_digest) or
               plan.link_attempt.memory_budget_bytes >
                   worker.capabilities.memory_capacity_bytes or
               plan.link_cpu_tokens > worker.capacity.cpu_tokens or
               plan.link_fd_tokens > worker.capacity.fd_tokens or
               plan.link_attempt.memory_budget_bytes >
                   worker.capacity.memory_bytes -
                   worker.capacity.memory_reserve_bytes:
                return _staged_reject_v1("staged-link-worker-ineligible")
            link_worker_found = true
    if not link_worker_found:
        return _staged_reject_v1("staged-link-worker-missing")
    # The same worker policy is checked again by the whole-graph runner.
    ParentStagedLinkPreparedV1(true, "", graph, workers)

fn derive_parent_staged_link_graph_v1(plan: ParentStagedLinkPlanV1,
        prepared: ParentStagedLinkPreparedV1,
        producer_request_wires: [text],
        resolved: ParentLinkResolutionV1) -> ParentGraphRequestV1?:
    if not prepared.valid or prepared.graph == nil or
       not resolved.valid or resolved.action == nil or
       producer_request_wires.len() != prepared.graph.unwrap().requests.len():
        return nil
    val request = resolved_parent_link_request_v1(resolved,
        plan.link_attempt, 1, plan.link_cpu_tokens, plan.link_fd_tokens)
    if request == nil: return nil
    var wires: [text] = []
    var i: i64 = 0
    while i < producer_request_wires.len():
        if producer_request_wires[i] != encode_build_worker_request_v1(
                prepared.graph.unwrap().requests[i]):
            return nil
        wires.push(producer_request_wires[i])
        i = i + 1
    val link_wire = encode_build_worker_request_v1(request.unwrap())
    if link_wire == "": return nil
    wires.push(link_wire)
    val combined = admit_parent_graph_requests_v1(wires,
        resolved.action_digest, plan.link_attempt.worker_id, 0)
    if not combined.valid or
       combined.actions.len() != prepared.graph.unwrap().actions.len() + 1:
        return nil
    combined

fn run_parent_staged_link_v1(plan: ParentStagedLinkPlanV1,
        producer_manifest_wire: text,
        producer_request_wires: [text], now_tick: i64) -> ParentGraphRunV1:
    """Run producers, then derive and run the link from accepted bytes."""
    val prepared = prepare_parent_staged_link_v1(plan,
        producer_manifest_wire, producer_request_wires)
    if not prepared.valid or prepared.graph == nil:
        return _staged_result_v1(prepared.reason, 0, "", false)
    val workers = prepared.workers
    val producers = run_parent_graph_v1(prepared.graph.unwrap(),
        workers, now_tick)
    if not producers.complete: return producers
    val resolved = resolve_parent_link_from_owner_v1(plan.template,
        workers[0].owner_root, workers[0].node.retained_cas_root)
    if not resolved.valid:
        return _staged_result_v1("staged-link: " + resolved.reason,
            producers.accepted_count, producers.last_attempt_id, false)
    val combined = derive_parent_staged_link_graph_v1(plan, prepared,
        producer_request_wires, resolved)
    if combined == nil:
        return _staged_result_v1("staged-link-graph-invalid",
            producers.accepted_count, producers.last_attempt_id, false)
    run_parent_graph_v1(combined.unwrap(), workers, now_tick)

export PARENT_STAGED_LINK_MAX_WORKERS_V1
export ParentStagedLinkPlanV1, ParentStagedLinkPreparedV1
export parent_staged_link_plan_digest_v1, prepare_parent_staged_link_v1
export run_parent_staged_link_v1
