# Convert one canonical, caller-provided build request into the scheduler's
# action record. The parent still owns dependency admission and publication.
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1}
use app.build.scheduler.planner.{SchedulerActionV1}
use compiler.common.build_contract.{action_spec_digest_v1}

struct ParentActionAdmissionV1:
    accepted: bool
    reason: text
    action: SchedulerActionV1?

fn _parent_action_reject_v1(reason: text) -> ParentActionAdmissionV1:
    ParentActionAdmissionV1(false, reason, nil)

fn _admit_parent_action_v1(request: BuildWorkerRequestV1,
        protected_worker_id: text, expected_fence: i64,
        queued_tick: i64, enforce_fence: bool) -> ParentActionAdmissionV1:
    if protected_worker_id == "" or queued_tick < 0 or
       (enforce_fence and expected_fence <= 0):
        return _parent_action_reject_v1("parent-policy-invalid")
    if encode_build_worker_request_v1(request) == "":
        return _parent_action_reject_v1("request-invalid")
    val digest = action_spec_digest_v1(request.action)
    if digest == "" or request.attempt.action_digest != digest:
        return _parent_action_reject_v1("action-digest-mismatch")
    if request.attempt.worker_id != protected_worker_id:
        return _parent_action_reject_v1("worker-mismatch")
    if enforce_fence and request.fence != expected_fence:
        return _parent_action_reject_v1("fence-mismatch")
    if request.cpu_tokens <= 0 or request.fd_tokens <= 0 or
       request.attempt.memory_budget_bytes <= 0:
        return _parent_action_reject_v1("resource-invalid")
    val action = SchedulerActionV1(digest, request.action,
        request.action.inputs.declared_dependency_actions,
        request.attempt.priority, queued_tick, request.cpu_tokens,
        request.attempt.memory_budget_bytes, request.fd_tokens)
    ParentActionAdmissionV1(true, "", action)

fn admit_parent_action_request_v1(request: BuildWorkerRequestV1,
        protected_worker_id: text, expected_fence: i64,
        queued_tick: i64) -> ParentActionAdmissionV1:
    """Accept a complete request for this worker and the owner's next fence."""
    _admit_parent_action_v1(request, protected_worker_id,
        expected_fence, queued_tick, true)

fn admit_parent_action_intent_v1(request: BuildWorkerRequestV1,
        protected_worker_id: text, queued_tick: i64) -> ParentActionAdmissionV1:
    """Convert canonical request data while the parent allocates its fence.

    The request wire's fence is structurally checked by its codec but is not
    authoritative for this intent route. The owner creates the actual worker
    request after allocating a current fence under its lock.
    """
    _admit_parent_action_v1(request, protected_worker_id, 0,
        queued_tick, false)

export ParentActionAdmissionV1, admit_parent_action_request_v1
export admit_parent_action_intent_v1
