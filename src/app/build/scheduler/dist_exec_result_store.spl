# Bounded ingestion only: every returned byte and receipt remains UNTRUSTED.
# Snapshot records are forgeable bookkeeping, not capabilities. The caller must
# supply its original snapshot/attempt identity, protect all path ancestors from
# symlink/mount replacement, and quiesce output writers before this read.
# Leaf O_NOFOLLOW does not provide directory confinement or an atomic snapshot.
use app.io.mod.{file_read_regular_no_follow_bounded,
    file_read_regular_no_follow_bounded_bytes}
use app.build.scheduler.dist_exec_artifact_snapshot.{DistExecArtifactSnapshotV1}
use app.build.scheduler.dist_exec_result.{DistExecWorkerResultV1,
    parse_dist_exec_committed_pointer_v1, parse_dist_exec_worker_result_v1}

pub struct DistExecUntrustedStoredResultV1:
    result: DistExecWorkerResultV1
    stdout: [u8]

fn _result_store_component_v1(value: text, cap: i64) -> bool:
    if (value.len() <= 0 or value.len() > cap or value == "." or
            value == ".." or value.starts_with("-")):
        return false
    for ch in value.chars():
        if ((ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
                (ch >= "0" and ch <= "9") or ch == "_" or ch == "-" or ch == "."):
            continue
        return false
    true

fn _result_store_path_v1(path: text) -> bool:
    if path.len() <= 1 or path.len() > 4096 or not path.starts_with("/"):
        return false
    val parts = path.split("/")
    var index: i64 = 1
    while index < parts.len():
        if not _result_store_component_v1(parts[index], 255): return false
        index = index + 1
    true

pub fn read_dist_exec_untrusted_result_v1(snapshot: DistExecArtifactSnapshotV1,
        state_dir: text, pod_uid: text, attempt: i64, expected_nonce: text,
        output_byte_cap: i64) -> Result<DistExecUntrustedStoredResultV1, text>:
    """Read fixed committed/receipt/stdout leaves with strict wire validation.

    This proves byte consistency only. It does not authenticate worker identity,
    V4 binding, OCI destruction, ownership, or production verifier acceptance.
    Unreferenced directory entries are not enumerated. Extra pointer/receipt
    fields and stdout bytes are rejected by the canonical parser and byte cap.
    """
    if output_byte_cap <= 0 or output_byte_cap > 16777216:
        return Err("result-store-limit-invalid")
    if (not snapshot.ready or snapshot.cleanup_pending or snapshot.cleanup_removed or
            snapshot.reason != "" or snapshot.artifact_bytes <= 0 or
            snapshot.artifact_bytes > 67108864 or
            not _result_store_path_v1(state_dir) or
            not _result_store_component_v1(pod_uid, 96) or attempt <= 0 or
            not _result_store_path_v1(snapshot.root)):
        return Err("result-store-snapshot-invalid")
    val prefix = state_dir + "/build-attempts/" + pod_uid + "-" + attempt.to_text() + "-"
    if (not snapshot.root.starts_with(prefix) or snapshot.root.len() != prefix.len() + 6 or
            snapshot.build_input_root != snapshot.root + "/inputs" or
            snapshot.build_output_root != snapshot.root + "/outputs" or
            snapshot.artifact_path != snapshot.build_input_root + "/artifact"):
        return Err("result-store-attempt-mismatch")
    for ch in snapshot.root[prefix.len():].chars():
        if not ((ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
                (ch >= "0" and ch <= "9")):
            return Err("result-store-attempt-mismatch")
    val pointer_read = file_read_regular_no_follow_bounded(
        snapshot.build_output_root + "/committed", 128)
    if pointer_read.is_err(): return Err("result-store-pointer-unavailable")
    val pointer = pointer_read.unwrap()
    val leaf = parse_dist_exec_committed_pointer_v1(pointer, expected_nonce)?
    val result_root = snapshot.build_output_root + "/" + leaf
    if result_root.len() + 11 > 4096: return Err("result-store-path-invalid")
    val receipt_read = file_read_regular_no_follow_bounded(result_root + "/receipt", 1024)
    if receipt_read.is_err(): return Err("result-store-receipt-unavailable")
    val stdout_read = file_read_regular_no_follow_bounded_bytes(
        result_root + "/stdout.bin", output_byte_cap)
    if stdout_read.is_err(): return Err("result-store-stdout-unavailable")
    val stdout = stdout_read.unwrap()
    val parsed = parse_dist_exec_worker_result_v1(pointer, receipt_read.unwrap(),
        stdout, expected_nonce, snapshot.artifact_sha256, output_byte_cap)?
    Ok(DistExecUntrustedStoredResultV1(parsed, stdout))

export DistExecUntrustedStoredResultV1, read_dist_exec_untrusted_result_v1
