# Validate a parent-authored transport handoff before any child network work.
# This module never opens a journal, launches a worker, or deletes a path.
use app.build.scheduler.parallel_transport_wire_v1.{
    ParallelTransportHandoffV1, parse_parallel_transport_handoff_v1,
    parallel_transport_handoff_digest_v1,
    PARALLEL_TRANSPORT_WIRE_MAX_BYTES_V1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    parse_build_worker_request_v1, encode_build_worker_request_v1}
use app.build.scheduler.prepared_upload.{PreparedBuildUploadV1}
use app.build.scheduler.trusted_sftp.{BUILD_SFTP_MAX_FILES_V1,
    BUILD_SFTP_MAX_FILE_BYTES_V1, BUILD_SFTP_MAX_TOTAL_BYTES_V1}
use app.build.scheduler.trusted_request_upload.{plan_build_request_upload_v1}
use app.build.scheduler.worker_ready.{BUILD_WORKER_CONTROL_DIRECTORY_V1,
    BUILD_WORKER_READY_MARKER_MAX_BYTES_V1,
    encode_build_worker_ready_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use std.common.io.read_only_file_view.{read_only_file_view_open_v1,
    read_only_file_view_read_v1, read_only_file_view_close_v1}
use std.common.io.file_read_policy.{FileReadPolicyV1}
use std.async.cancellation.{CancellationToken}
use std.common.text_bytes.{bytes_to_text}
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex,
    sha256_stream_v1_new, sha256_stream_v1_update,
    sha256_stream_v1_finish_hex}

val CHILD_INPUT_HASH_CHUNK_BYTES_V1: u64 = 1048576u64

struct ParallelTransportChildInputV1:
    valid: bool
    reason: text
    handoff: ParallelTransportHandoffV1?
    request: BuildWorkerRequestV1?
    prepared: PreparedBuildUploadV1?

fn _child_input_reject_v1(reason: text) -> ParallelTransportChildInputV1:
    ParallelTransportChildInputV1(false, reason, nil, nil, nil)

fn _child_input_read_v1(root: text, relative_path: text,
        maximum: i64, snapshot_digest: text) -> text?:
    val opened = read_only_file_view_open_v1(root, relative_path,
        snapshot_digest, FileReadPolicyV1.buffered)
    if opened.is_err(): return nil
    var view = opened.unwrap()
    if view.identity.size == 0u64 or
       view.identity.size > maximum.to_u64():
        val _ = read_only_file_view_close_v1(view)
        return nil
    val read = read_only_file_view_read_v1(&view, 0u64,
        view.identity.size, CancellationToken.new())
    val closed = read_only_file_view_close_v1(view)
    if read.is_err() or closed.is_err(): return nil
    val bytes = read.unwrap().bytes
    val value = bytes_to_text(bytes)
    if value.bytes() != bytes: return nil
    Some(value)

fn _child_input_pinned_size_v1(root: text, relative_path: text,
        expected_digest: text, snapshot_digest: text,
        remaining: i64) -> i64:
    if not scheduler_action_digest_valid_v1(expected_digest) or
       remaining < 0:
        return -1
    val opened = read_only_file_view_open_v1(root, relative_path,
        snapshot_digest, FileReadPolicyV1.buffered)
    if opened.is_err(): return -1
    var view = opened.unwrap()
    if view.identity.size > BUILD_SFTP_MAX_FILE_BYTES_V1.to_u64() or
       view.identity.size > remaining.to_u64():
        val _ = read_only_file_view_close_v1(view)
        return -1
    val size = view.identity.size
    val stream = sha256_stream_v1_new()
    val cancellation = CancellationToken.new()
    var offset: u64 = 0u64
    var valid = true
    while offset < size:
        val remaining_bytes = size - offset
        val length = if remaining_bytes > CHILD_INPUT_HASH_CHUNK_BYTES_V1:
            CHILD_INPUT_HASH_CHUNK_BYTES_V1
        else:
            remaining_bytes
        val read = read_only_file_view_read_v1(&view, offset, length,
            cancellation)
        if read.is_err():
            valid = false
            break
        val bytes = read.unwrap().bytes
        if bytes.len().to_u64() != length or
           not sha256_stream_v1_update(stream, bytes):
            valid = false
            break
        offset = offset + length
    val digest = if valid: sha256_stream_v1_finish_hex(stream) else: nil
    val closed = read_only_file_view_close_v1(view)
    if not valid or closed.is_err() or digest == nil or
       digest.unwrap() != expected_digest:
        return -1
    size.to_i64()

fn validate_parallel_transport_child_input_v1(handoff_wire: [u8],
        expected_handoff_digest: text) -> ParallelTransportChildInputV1:
    """Rebuild exactly the prepared upload authorized by the parent digest."""
    if handoff_wire.len() == 0 or
       handoff_wire.len() > PARALLEL_TRANSPORT_WIRE_MAX_BYTES_V1:
        return _child_input_reject_v1("handoff-size-invalid")
    if not scheduler_action_digest_valid_v1(expected_handoff_digest) or
       sha256_u8_hex(handoff_wire) != expected_handoff_digest:
        return _child_input_reject_v1("handoff-digest-mismatch")
    val handoff = parse_parallel_transport_handoff_v1(handoff_wire)
    if not handoff.valid or handoff.approved_node == nil or
       handoff.input_batch == nil or handoff.control_batch == nil or
       parallel_transport_handoff_digest_v1(handoff) !=
           expected_handoff_digest:
        return _child_input_reject_v1("handoff-invalid")
    val request = parse_build_worker_request_v1(handoff.request_wire)
    if request == nil or
       encode_build_worker_request_v1(request.unwrap()) !=
           handoff.request_wire or
       sha256_text(handoff.request_wire) != handoff.request_digest or
       request.unwrap().attempt.worker_id !=
           handoff.approved_node.unwrap().ssh.node.worker_id:
        return _child_input_reject_v1("request-binding-invalid")
    val root = handoff.prepared_root
    val input = handoff.input_batch.unwrap()
    val control = handoff.control_batch.unwrap()
    val input_text = _child_input_read_v1(root, "inputs.batch", 65536,
        expected_handoff_digest)
    val control_text = _child_input_read_v1(root, "control.batch", 65536,
        expected_handoff_digest)
    val request_text = _child_input_read_v1(root, "request.wire", 262144,
        expected_handoff_digest)
    val ready_text = _child_input_read_v1(root, "ready",
        BUILD_WORKER_READY_MARKER_MAX_BYTES_V1, expected_handoff_digest)
    if input_text == nil or control_text == nil or request_text == nil or
       ready_text == nil:
        return _child_input_reject_v1("prepared-file-invalid")
    if input_text.unwrap().bytes().len() != input.byte_count or
       sha256_text(input_text.unwrap()) != input.sha256 or
       control_text.unwrap().bytes().len() != control.byte_count or
       sha256_text(control_text.unwrap()) != control.sha256 or
       request_text.unwrap() != handoff.request_wire or
       ready_text.unwrap() != encode_build_worker_ready_v1(
           request.unwrap()):
        return _child_input_reject_v1("prepared-file-mismatch")
    val current = request.unwrap()
    val snapshot_root = root + "/inputs"
    val count = current.action.inputs.source_inputs.len() +
        current.action.inputs.generated_inputs.len() +
        current.action.inputs.dependency_outputs.len()
    if count == 0 or count > BUILD_SFTP_MAX_FILES_V1:
        return _child_input_reject_v1("prepared-input-count-invalid")
    var seen: [text] = []
    var total: i64 = 0
    for item in current.action.inputs.source_inputs:
        if seen.contains(item.logical_path):
            return _child_input_reject_v1("prepared-input-duplicate")
        seen.push(item.logical_path)
        val size = _child_input_pinned_size_v1(snapshot_root,
            item.logical_path, item.content_digest,
            expected_handoff_digest, BUILD_SFTP_MAX_TOTAL_BYTES_V1 - total)
        if size < 0: return _child_input_reject_v1("prepared-input-invalid")
        total = total + size
    for item in current.action.inputs.generated_inputs:
        if seen.contains(item.logical_path):
            return _child_input_reject_v1("prepared-input-duplicate")
        seen.push(item.logical_path)
        val size = _child_input_pinned_size_v1(snapshot_root,
            item.logical_path, item.content_digest,
            expected_handoff_digest, BUILD_SFTP_MAX_TOTAL_BYTES_V1 - total)
        if size < 0: return _child_input_reject_v1("prepared-input-invalid")
        total = total + size
    for item in current.action.inputs.dependency_outputs:
        if seen.contains(item.output_path):
            return _child_input_reject_v1("prepared-input-duplicate")
        seen.push(item.output_path)
        val size = _child_input_pinned_size_v1(snapshot_root,
            item.output_path, item.content_digest,
            expected_handoff_digest, BUILD_SFTP_MAX_TOTAL_BYTES_V1 - total)
        if size < 0: return _child_input_reject_v1("prepared-input-invalid")
        total = total + size
    val plan = plan_build_request_upload_v1(
        handoff.approved_node.unwrap().sftp, current, snapshot_root)
    if not plan.valid or plan.request_wire != handoff.request_wire or
       plan.request_digest != handoff.request_digest or
       plan.ready_wire != ready_text.unwrap() or
       plan.input_plan.batch != input_text.unwrap():
        return _child_input_reject_v1("prepared-plan-mismatch")
    val remote_control = plan.remote_attempt_root + "/" +
        BUILD_WORKER_CONTROL_DIRECTORY_V1
    val canonical_control = "mkdir " + remote_control + "\n" +
        "put " + root + "/request.wire " + remote_control +
        "/request.wire\n" +
        "put " + root + "/ready " + remote_control + "/ready\n"
    if control_text.unwrap() != canonical_control:
        return _child_input_reject_v1("control-batch-mismatch")
    val prepared = PreparedBuildUploadV1(true, "", root, plan,
        root + "/inputs.batch", root + "/control.batch",
        canonical_control)
    ParallelTransportChildInputV1(true, "", handoff, request, prepared)

export ParallelTransportChildInputV1
export validate_parallel_transport_child_input_v1
