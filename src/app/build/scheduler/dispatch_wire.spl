# Bounded metadata only. Snapshot, toolchain, input, output, and diagnostic
# bytes travel separately and must be checked against these digest claims.
# The transport binds the caller to worker_id; the parent ledger alone decides
# whether a candidate's attempt and fence are current and may be published.
use compiler.common.build_contract.{ActionSpec, AttemptSpec, ActionResultCandidate,
    action_spec_digest_v1, input_manifest_digest_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}

val BUILD_DISPATCH_WIRE_MAX_V1 = 4096

struct BuildDispatchEnvelopeV1:
    action_digest: text
    input_manifest_digest: text
    snapshot_digest: text
    tool_executable_digest: text
    tool_behavior_digest: text
    provider_abi_digest: text
    runtime_digest: text
    sysroot_digest: text
    target_triple: text
    attempt_id: text
    worker_id: text
    retry_number: i64
    priority: i64
    fence: i64
    cpu_tokens: i64
    memory_budget_bytes: i64
    fd_tokens: i64

struct BuildResultEnvelopeV1:
    candidate: ActionResultCandidate
    fence: i64

fn _wire_id_v1(value: text) -> bool:
    if value.len() == 0 or value.len() > 128:
        return false
    var i: i64 = 0
    while i < value.len():
        val c = value[i:i + 1]
        if not ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
                (c >= "0" and c <= "9") or c == "-" or c == "_" or c == "."):
            return false
        i = i + 1
    true

fn _wire_nat_v1(value: text, positive: bool) -> bool:
    if value == "" or value.len() > 19 or (value.len() > 1 and value[0:1] == "0"):
        return false
    var i: i64 = 0
    while i < value.len():
        if value[i:i + 1] < "0" or value[i:i + 1] > "9":
            return false
        i = i + 1
    val number = value.to_i64() ?? -1
    number >= 0 and (not positive or number > 0) and number.to_text() == value

fn _dispatch_keys_v1() -> [text]:
    ["action", "inputs", "snapshot", "tool-executable", "tool-behavior",
     "provider-abi", "runtime", "sysroot", "target-triple", "attempt",
     "worker", "retry", "priority", "fence", "cpu", "memory", "fds"]

fn _dispatch_values_v1(envelope: BuildDispatchEnvelopeV1) -> [text]:
    [envelope.action_digest, envelope.input_manifest_digest,
     envelope.snapshot_digest, envelope.tool_executable_digest,
     envelope.tool_behavior_digest, envelope.provider_abi_digest,
     envelope.runtime_digest, envelope.sysroot_digest, envelope.target_triple,
     envelope.attempt_id, envelope.worker_id, envelope.retry_number.to_text(),
     envelope.priority.to_text(), envelope.fence.to_text(),
     envelope.cpu_tokens.to_text(), envelope.memory_budget_bytes.to_text(),
     envelope.fd_tokens.to_text()]

fn _dispatch_values_valid_v1(v: [text]) -> bool:
    if v.len() != 17:
        return false
    var i: i64 = 0
    while i < 8:
        if not scheduler_action_digest_valid_v1(v[i]):
            return false
        i = i + 1
    _wire_id_v1(v[8]) and _wire_id_v1(v[9]) and _wire_id_v1(v[10]) and
        _wire_nat_v1(v[11], false) and _wire_nat_v1(v[12], false) and
        _wire_nat_v1(v[13], true) and _wire_nat_v1(v[14], true) and
        _wire_nat_v1(v[15], true) and _wire_nat_v1(v[16], true) and
        (v[11].to_i64() ?? -1) <= 1000000 and
        (v[12].to_i64() ?? -1) <= 1000000 and
        (v[13].to_i64() ?? 0) <= 1000000000 and
        (v[14].to_i64() ?? 0) <= 1000000 and
        (v[16].to_i64() ?? 0) <= 1000000

fn _wire_write_v1(schema: text, keys: [text], values: [text]) -> text:
    var out = schema + "\n"
    var i: i64 = 0
    while i < keys.len():
        out = out + keys[i] + "=" + values[i] + "\n"
        i = i + 1
    if out.len() > BUILD_DISPATCH_WIRE_MAX_V1: "" else: out

fn _wire_read_v1(wire: text, schema: text, keys: [text]) -> [text]:
    if wire.len() == 0 or wire.len() > BUILD_DISPATCH_WIRE_MAX_V1 or
            not wire.ends_with("\n") or wire.contains("\r"):
        return []
    val lines = wire[0:wire.len() - 1].split("\n")
    if lines.len() != keys.len() + 1 or lines[0] != schema:
        return []
    var values: [text] = []
    var i: i64 = 0
    while i < keys.len():
        val prefix = keys[i] + "="
        if not lines[i + 1].starts_with(prefix):
            return []
        values.push(lines[i + 1][prefix.len():])
        i = i + 1
    values

fn encode_build_dispatch_v1(action: ActionSpec, attempt: AttemptSpec,
                            fence: i64, cpu_tokens: i64, fd_tokens: i64) -> text:
    """Encode derived action identities and a parent-admitted attempt."""
    if attempt.version != 1 or action.version != 1:
        return ""
    val digest = action_spec_digest_v1(action)
    if digest == "" or digest != attempt.action_digest or
            action.inputs.snapshot_digest != action.snapshot.snapshot_digest:
        return ""
    val envelope = BuildDispatchEnvelopeV1(digest, input_manifest_digest_v1(action.inputs),
        action.snapshot.snapshot_digest, action.toolchain.executable_digest,
        action.toolchain.behavior_digest, action.toolchain.provider_abi_digest,
        action.toolchain.runtime_digest, action.toolchain.sysroot_digest,
        action.toolchain.target_triple, attempt.attempt_id, attempt.worker_id,
        attempt.retry_number, attempt.priority, fence, cpu_tokens,
        attempt.memory_budget_bytes, fd_tokens)
    val values = _dispatch_values_v1(envelope)
    if not _dispatch_values_valid_v1(values):
        return ""
    _wire_write_v1("simple-build-dispatch-v1", _dispatch_keys_v1(), values)

fn parse_build_dispatch_v1(wire: text) -> BuildDispatchEnvelopeV1?:
    val v = _wire_read_v1(wire, "simple-build-dispatch-v1", _dispatch_keys_v1())
    if not _dispatch_values_valid_v1(v):
        return nil
    BuildDispatchEnvelopeV1(v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7],
        v[8], v[9], v[10], v[11].to_i64() ?? 0, v[12].to_i64() ?? 0,
        v[13].to_i64() ?? 0, v[14].to_i64() ?? 0, v[15].to_i64() ?? 0,
        v[16].to_i64() ?? 0)

fn _result_keys_v1() -> [text]:
    ["action", "attempt", "worker", "fence", "outcome", "output-manifest",
     "diagnostics"]

fn _result_values_valid_v1(v: [text]) -> bool:
    v.len() == 7 and scheduler_action_digest_valid_v1(v[0]) and
        _wire_id_v1(v[1]) and _wire_id_v1(v[2]) and _wire_nat_v1(v[3], true) and
        (v[3].to_i64() ?? 0) <= 1000000000 and
        (v[4] == "success" or v[4] == "failure") and
        (scheduler_action_digest_valid_v1(v[5]) or
         (v[4] == "failure" and v[5] == "")) and
        scheduler_action_digest_valid_v1(v[6])

fn encode_build_result_v1(candidate: ActionResultCandidate, fence: i64) -> text:
    """Encode a result claim, never a PASS or accepted publication."""
    if candidate.version != 1:
        return ""
    val values = [candidate.action_digest, candidate.attempt_id,
        candidate.worker_id, fence.to_text(),
        if candidate.success: "success" else: "failure",
        candidate.output_manifest_digest, candidate.diagnostic_digest]
    if not _result_values_valid_v1(values):
        return ""
    _wire_write_v1("simple-build-result-candidate-v1", _result_keys_v1(), values)

fn parse_build_result_v1(wire: text) -> BuildResultEnvelopeV1?:
    val v = _wire_read_v1(wire, "simple-build-result-candidate-v1", _result_keys_v1())
    if not _result_values_valid_v1(v):
        return nil
    BuildResultEnvelopeV1(ActionResultCandidate(1, v[0], v[1], v[2], v[5],
        v[6], v[4] == "success"), v[3].to_i64() ?? 0)

export BUILD_DISPATCH_WIRE_MAX_V1, BuildDispatchEnvelopeV1, BuildResultEnvelopeV1
export encode_build_dispatch_v1, parse_build_dispatch_v1
export encode_build_result_v1, parse_build_result_v1
