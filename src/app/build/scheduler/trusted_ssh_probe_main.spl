# Diagnostic entrypoint for a configured trusted node. All file digests are
# supplied by the parent and checked before the OpenSSH process is started.
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1,
    probe_trusted_ssh_node_v1}

fn main() -> i64:
    var args = get_args()
    if args.len() > 0 and
       (args[0].ends_with("trusted_ssh_probe_main.spl") or
        args[0].ends_with("trusted_ssh_probe_main.exe")):
        args = args[1:]
    if args.len() > 0 and args[0] == "--":
        args = args[1:]
    if args.len() != 10:
        print("trusted-ssh-probe: BLOCKED reason=expected-ten-arguments")
        return 2
    val port = args[3].to_i64() ?? -1
    val node = TrustedSshNodeV1(args[0], args[1], args[2], port,
        args[4], args[5], args[6], args[7], args[8], args[9])
    val result = probe_trusted_ssh_node_v1(node)
    if not result.connected:
        print("trusted-ssh-probe: BLOCKED reason={result.reason}")
        return 1
    print("trusted-ssh-probe: CONNECTED worker={result.worker_id}")
    0
