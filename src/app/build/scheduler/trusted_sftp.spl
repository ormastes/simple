# Binary-safe declared-input transfer to one trusted Linux worker inbox.
# SFTP creates a new attempt directory and copies bytes; worker_materialize
# must hash every received file before it can become a read-only build input.
# The configured inbox is private to the remote worker account.
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1,
    trusted_ssh_node_valid_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use compiler.common.build_contract.{ActionSpec, AttemptSpec,
    action_spec_digest_v1}
use app.io.mod.{file_is_regular_no_follow, file_size_raw, file_hash_sha256,
    file_read_regular_no_follow_bounded, secure_temp_dir, file_atomic_write,
    dir_remove_all, process_run_bounded}
use compiler.driver.cache.binary_object_cas.{binary_object_cas_blob_path}
use app.build.scheduler.retained_binary_cas.{retained_binary_cas_verify_v1}

val BUILD_SFTP_MAX_FILES_V1: i64 = 256
val BUILD_SFTP_MAX_FILE_BYTES_V1: i64 = 268435456
val BUILD_SFTP_MAX_TOTAL_BYTES_V1: i64 = 1073741824
val BUILD_SFTP_MAX_BATCH_BYTES_V1: i64 = 65536

struct TrustedSftpConfigV1:
    node: TrustedSshNodeV1
    sftp_executable: text
    sftp_digest: text
    remote_inbox_root: text

struct BuildSftpPlanV1:
    valid: bool
    reason: text
    batch: text
    remote_attempt_root: text
    files: i64
    bytes: i64

struct BuildSftpTransferV1:
    transferred: bool
    reason: text
    remote_attempt_root: text
    files: i64
    bytes: i64

fn _sftp_reject_v1(reason: text) -> BuildSftpPlanV1:
    BuildSftpPlanV1(false, reason, "", "", 0, 0)

fn _sftp_segment_v1(value: text) -> bool:
    if value.len() == 0 or value.len() > 128 or value == "." or value == ".." or
       value.starts_with("-"):
        return false
    for c in value.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "_" or c == "-" or c == ".":
            continue
        return false
    true

fn _sftp_path_v1(path: text, absolute: bool) -> bool:
    if path.len() == 0 or path.len() > 4096 or
       path.starts_with("/") != absolute or path.ends_with("/") or
       path.contains("//"):
        return false
    val segments = path.split("/")
    var i: i64 = if absolute: 1 else: 0
    while i < segments.len():
        if not _sftp_segment_v1(segments[i]):
            return false
        i = i + 1
    true

fn _sftp_add_file_v1(batch: text, directories: [text],
        local: text, remote_root: text,
        logical_path: text, expected_digest: text,
        total: i64) -> (text, [text], i64, text):
    if not _sftp_path_v1(logical_path, false) or
       not scheduler_action_digest_valid_v1(expected_digest):
        return (batch, directories, total, "input-path-or-digest-invalid")
    if not _sftp_path_v1(local, true) or
       not file_is_regular_no_follow(local):
        return (batch, directories, total, "input-not-regular")
    val size = file_size_raw(local)
    if size < 0 or size > BUILD_SFTP_MAX_FILE_BYTES_V1 or
       size > BUILD_SFTP_MAX_TOTAL_BYTES_V1 - total:
        return (batch, directories, total, "input-size-invalid")
    if file_hash_sha256(local) != expected_digest:
        return (batch, directories, total, "input-digest-mismatch")
    var next_batch = batch
    var next_dirs = directories
    val segments = logical_path.split("/")
    var parent = remote_root
    var i: i64 = 0
    while i + 1 < segments.len():
        parent = parent + "/" + segments[i]
        if not next_dirs.contains(parent):
            next_batch = next_batch + "mkdir " + parent + "\n"
            next_dirs.push(parent)
        i = i + 1
    next_batch = next_batch + "put " + local + " " + remote_root +
        "/" + logical_path + "\n"
    if next_batch.len() > BUILD_SFTP_MAX_BATCH_BYTES_V1:
        return (batch, directories, total, "batch-bound")
    (next_batch, next_dirs, total + size, "")

fn _plan_build_input_sftp_v1(config: TrustedSftpConfigV1,
        action: ActionSpec, attempt: AttemptSpec,
        source_root: text, cas_root: text,
        use_cas: bool) -> BuildSftpPlanV1:
    """Plan a bounded SFTP batch without starting a network process."""
    val digest = action_spec_digest_v1(action)
    if digest == "" or attempt.version != 1 or
       attempt.action_digest != digest or
       attempt.worker_id != config.node.worker_id or
       not _sftp_segment_v1(attempt.attempt_id):
        return _sftp_reject_v1("attempt-invalid")
    if not trusted_ssh_node_valid_v1(config.node) or
       not _sftp_path_v1(config.sftp_executable, true) or
       not file_is_regular_no_follow(config.sftp_executable) or
       not scheduler_action_digest_valid_v1(config.sftp_digest) or
       file_hash_sha256(config.sftp_executable) != config.sftp_digest or
       not _sftp_path_v1(config.remote_inbox_root, true) or
       not _sftp_path_v1(source_root, true) or
       (use_cas and not _sftp_path_v1(cas_root, true)):
        return _sftp_reject_v1("transport-config-invalid")
    if action.inputs.env_inputs.len() != 0:
        return _sftp_reject_v1("environment-unmaterialized")
    val count = action.inputs.source_inputs.len() +
        action.inputs.generated_inputs.len() +
        action.inputs.dependency_outputs.len()
    if count <= 0 or count > BUILD_SFTP_MAX_FILES_V1:
        return _sftp_reject_v1("input-count-invalid")
    val remote_root = config.remote_inbox_root + "/" + attempt.attempt_id
    var batch = "mkdir " + remote_root + "\n"
    var directories: [text] = []
    var total: i64 = 0
    for item in action.inputs.source_inputs:
        val (next_batch, next_dirs, next_total, problem) = _sftp_add_file_v1(
            batch, directories, source_root + "/" + item.logical_path, remote_root,
            item.logical_path, item.content_digest, total)
        if problem != "": return _sftp_reject_v1(problem)
        batch = next_batch
        directories = next_dirs
        total = next_total
    for item in action.inputs.generated_inputs:
        val (next_batch, next_dirs, next_total, problem) = _sftp_add_file_v1(
            batch, directories, source_root + "/" + item.logical_path, remote_root,
            item.logical_path, item.content_digest, total)
        if problem != "": return _sftp_reject_v1(problem)
        batch = next_batch
        directories = next_dirs
        total = next_total
    for item in action.inputs.dependency_outputs:
        val local = if use_cas:
            binary_object_cas_blob_path(cas_root, item.content_digest)
        else:
            source_root + "/" + item.output_path
        if use_cas and (local == "" or
                not retained_binary_cas_verify_v1(cas_root,
                    item.output_path, item.content_digest)):
            return _sftp_reject_v1("dependency-object-unavailable")
        val (next_batch, next_dirs, next_total, problem) = _sftp_add_file_v1(
            batch, directories, local, remote_root,
            item.output_path, item.content_digest, total)
        if problem != "": return _sftp_reject_v1(problem)
        batch = next_batch
        directories = next_dirs
        total = next_total
    BuildSftpPlanV1(true, "", batch, remote_root, count, total)

fn plan_build_input_sftp_v1(config: TrustedSftpConfigV1,
        action: ActionSpec, attempt: AttemptSpec,
        source_root: text) -> BuildSftpPlanV1:
    _plan_build_input_sftp_v1(config, action, attempt, source_root, "", false)

fn plan_build_input_sftp_with_cas_v1(config: TrustedSftpConfigV1,
        action: ActionSpec, attempt: AttemptSpec,
        source_root: text, cas_root: text) -> BuildSftpPlanV1:
    """Use accepted retained CAS bytes for dependency outputs."""
    _plan_build_input_sftp_v1(config, action, attempt, source_root,
        cas_root, true)

fn _transfer_build_inputs_sftp_v1(config: TrustedSftpConfigV1,
        plan: BuildSftpPlanV1,
        local_state_dir: text) -> BuildSftpTransferV1:
    if not plan.valid:
        return BuildSftpTransferV1(false, plan.reason, "", 0, 0)
    if not _sftp_path_v1(local_state_dir, true):
        return BuildSftpTransferV1(false, "local-state-dir-invalid", "", 0, 0)
    val created = secure_temp_dir(local_state_dir, "build-sftp")
    if created.is_err():
        return BuildSftpTransferV1(false, "batch-directory-unavailable", "", 0, 0)
    val batch_root = created.unwrap()
    val batch_file = batch_root + "/transfer.batch"
    if not file_atomic_write(batch_file, plan.batch):
        dir_remove_all(batch_root)
        return BuildSftpTransferV1(false, "batch-write-failed", "", 0, 0)
    val node = config.node
    val args = ["-F", "none", "-b", batch_file, "-o", "BatchMode=yes",
        "-o", "StrictHostKeyChecking=yes", "-o",
        "UserKnownHostsFile=" + node.known_hosts_path,
        "-o", "GlobalKnownHostsFile=none", "-o", "UpdateHostKeys=no",
        "-o", "IdentityAgent=none", "-o", "IdentitiesOnly=yes",
        "-o", "HostKeyAlias=" + node.worker_id,
        "-o", "ClearAllForwardings=yes", "-o", "ForwardAgent=no",
        "-o", "ForwardX11=no", "-o", "ConnectTimeout=5",
        "-P", node.port.to_text(), "-i", node.identity_path,
        "-S", node.ssh_executable, node.user + "@" + node.host]
    val (stdout, stderr, code) = process_run_bounded(
        config.sftp_executable, args, 300000, 8192)
    val cleaned = dir_remove_all(batch_root)
    if code != 0 or stdout.len() >= 8192 or stderr.len() >= 8192 or
       not cleaned:
        return BuildSftpTransferV1(false, "sftp-transfer-failed", "", 0, 0)
    BuildSftpTransferV1(true, "", plan.remote_attempt_root,
        plan.files, plan.bytes)

fn transfer_prepared_build_inputs_sftp_v1(config: TrustedSftpConfigV1,
        plan: BuildSftpPlanV1, batch_file: text) -> BuildSftpTransferV1:
    """Send one already prepared batch without rereading input payloads."""
    if not plan.valid or not _sftp_path_v1(batch_file, true) or
       plan.batch.len() == 0 or plan.batch.len() > BUILD_SFTP_MAX_BATCH_BYTES_V1:
        return BuildSftpTransferV1(false, "prepared-batch-invalid", "", 0, 0)
    val batch = file_read_regular_no_follow_bounded(batch_file,
        BUILD_SFTP_MAX_BATCH_BYTES_V1)
    if batch.is_err() or batch.unwrap() != plan.batch or
       not trusted_ssh_node_valid_v1(config.node) or
       not file_is_regular_no_follow(config.sftp_executable) or
       file_hash_sha256(config.sftp_executable) != config.sftp_digest:
        return BuildSftpTransferV1(false, "prepared-batch-changed", "", 0, 0)
    val node = config.node
    val args = ["-F", "none", "-b", batch_file, "-o", "BatchMode=yes",
        "-o", "StrictHostKeyChecking=yes", "-o",
        "UserKnownHostsFile=" + node.known_hosts_path,
        "-o", "GlobalKnownHostsFile=none", "-o", "UpdateHostKeys=no",
        "-o", "IdentityAgent=none", "-o", "IdentitiesOnly=yes",
        "-o", "HostKeyAlias=" + node.worker_id,
        "-o", "ClearAllForwardings=yes", "-o", "ForwardAgent=no",
        "-o", "ForwardX11=no", "-o", "ConnectTimeout=5",
        "-P", node.port.to_text(), "-i", node.identity_path,
        "-S", node.ssh_executable, node.user + "@" + node.host]
    val (stdout, stderr, code) = process_run_bounded(
        config.sftp_executable, args, 300000, 8192)
    if code != 0 or stdout.len() >= 8192 or stderr.len() >= 8192:
        return BuildSftpTransferV1(false, "sftp-transfer-failed", "", 0, 0)
    BuildSftpTransferV1(true, "", plan.remote_attempt_root,
        plan.files, plan.bytes)

fn transfer_build_inputs_sftp_v1(config: TrustedSftpConfigV1,
        action: ActionSpec, attempt: AttemptSpec,
        source_root: text, local_state_dir: text) -> BuildSftpTransferV1:
    val plan = plan_build_input_sftp_v1(config, action, attempt, source_root)
    _transfer_build_inputs_sftp_v1(config, plan, local_state_dir)

fn transfer_build_inputs_sftp_with_cas_v1(config: TrustedSftpConfigV1,
        action: ActionSpec, attempt: AttemptSpec,
        source_root: text, cas_root: text,
        local_state_dir: text) -> BuildSftpTransferV1:
    val plan = plan_build_input_sftp_with_cas_v1(config, action, attempt,
        source_root, cas_root)
    _transfer_build_inputs_sftp_v1(config, plan, local_state_dir)

export BUILD_SFTP_MAX_FILES_V1, BUILD_SFTP_MAX_FILE_BYTES_V1
export BUILD_SFTP_MAX_TOTAL_BYTES_V1, BUILD_SFTP_MAX_BATCH_BYTES_V1
export TrustedSftpConfigV1, BuildSftpPlanV1, BuildSftpTransferV1
export plan_build_input_sftp_v1, transfer_build_inputs_sftp_v1
export plan_build_input_sftp_with_cas_v1
export transfer_build_inputs_sftp_with_cas_v1
export transfer_prepared_build_inputs_sftp_v1
