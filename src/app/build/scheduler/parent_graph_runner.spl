# Bounded whole-graph driver. The owner journal, not this loop, is the mutable
# authority. Each step reopens it after the prior remote attempt is committed.
use app.build.scheduler.parent_cli.{DistBuildConfigV1}
use app.build.scheduler.parent_graph_request.{ParentGraphRequestV1,
    select_next_parent_graph_request_v1}
use app.build.scheduler.ledger.{SchedulerLedgerV1,
    scheduler_ledger_valid_v1}
use app.build.scheduler.owner.{SchedulerOwnerV1, scheduler_owner_open_v1,
    scheduler_owner_close_v1}
use app.build.scheduler.parent_reconciliation.{
    reconcile_unstarted_parent_attempt_v1}
use app.build.scheduler.parent_action_admission.{
    admit_parent_action_intent_v1}
use app.build.scheduler.parent_remote_service.{run_parent_remote_action_v1,
    resume_parent_remote_attempt_v1}
use app.build.scheduler.distributed_attempt.{distributed_build_node_consistent_v1}
use std.nogc_sync_mut.io.crypto_sffi.{random_hex}
use compiler.common.build_contract.{action_spec_digest_v1}

struct ParentGraphStepV1:
    action: text              # COMPLETE | RESUME | DISPATCH | BLOCKED
    reason: text
    worker_index: i64
    action_digest: text
    attempt_id: text
    retry_number: i64

struct ParentGraphRunV1:
    complete: bool
    reason: text
    accepted_count: i64
    last_attempt_id: text
    reconciliation_required: bool

fn _graph_step_v1(action: text, reason: text, worker_index: i64,
        action_digest: text, attempt_id: text,
        retry_number: i64) -> ParentGraphStepV1:
    ParentGraphStepV1(action, reason, worker_index, action_digest,
        attempt_id, retry_number)

fn _graph_run_v1(complete: bool, reason: text, accepted_count: i64,
        attempt_id: text, reconcile: bool) -> ParentGraphRunV1:
    ParentGraphRunV1(complete, reason, accepted_count, attempt_id, reconcile)

fn _graph_accepted_count_v1(graph: ParentGraphRequestV1,
        ledger: SchedulerLedgerV1) -> i64:
    var count: i64 = 0
    for action in graph.actions:
        for accepted in ledger.accepted:
            if accepted.action_digest == action.action_digest:
                count = count + 1
    count

fn _graph_worker_index_v1(workers: [DistBuildConfigV1],
        worker_id: text) -> i64:
    var i: i64 = 0
    while i < workers.len():
        if workers[i].node.ssh.node.worker_id == worker_id:
            return i
        i = i + 1
    -1

fn _graph_reconcile_unstarted_v1(owner: SchedulerOwnerV1,
        graph: ParentGraphRequestV1) -> text:
    # Snapshot only this graph's approved active attempts before revoke mutates
    # the owner's ledger. An unrelated graph sharing the root is never touched.
    var active_ids: [text] = []
    for attempt in owner.state.ledger.attempts:
        if not attempt.active:
            continue
        for request in graph.requests:
            if attempt.action_digest == request.attempt.action_digest and
               attempt.worker_id == request.attempt.worker_id:
                active_ids.push(attempt.attempt_id)
    if active_ids.len() == 0:
        return ""
    # A copied graph.valid bit is not proof that requests still describe the
    # paired actions. Validate the whole pairing before the first mutation.
    var seen_actions: [text] = []
    var pair_index: i64 = 0
    while pair_index < graph.actions.len():
        val expected = graph.actions[pair_index]
        val request = graph.requests[pair_index]
        val admitted = admit_parent_action_intent_v1(request,
            request.attempt.worker_id, expected.queued_tick)
        if seen_actions.contains(expected.action_digest) or
           not admitted.accepted or admitted.action == nil or
           action_spec_digest_v1(expected.spec) != expected.action_digest:
            return "graph-request-action-mismatch"
        val derived = admitted.action.unwrap()
        if derived.action_digest != expected.action_digest or
           derived.priority != expected.priority or
           derived.cpu_tokens != expected.cpu_tokens or
           derived.memory_bytes != expected.memory_bytes or
           derived.fd_tokens != expected.fd_tokens or
           derived.queued_tick != expected.queued_tick or
           derived.dependencies.len() != expected.dependencies.len():
            return "graph-request-action-mismatch"
        for dependency in derived.dependencies:
            if not expected.dependencies.contains(dependency):
                return "graph-request-action-mismatch"
        seen_actions.push(expected.action_digest)
        pair_index = pair_index + 1
    for attempt_id in active_ids:
        val recovery = reconcile_unstarted_parent_attempt_v1(owner,
            attempt_id)
        if not recovery.resolved and
           recovery.reason != "spooled-attempt-needs-worker-status" and
           recovery.reason != "spool-protocol-unproven":
            return "startup-reconciliation: " + recovery.reason
    ""

fn parent_graph_workers_valid_v1(graph: ParentGraphRequestV1,
        workers: [DistBuildConfigV1]) -> bool:
    if not graph.valid or graph.actions.len() == 0 or
       graph.requests.len() != graph.actions.len() or
       workers.len() == 0 or workers.len() > 256:
        return false
    val first = workers[0]
    if first.graph_path == "" or first.owner_root == "" or
       first.protected_trust_domain == "":
        return false
    var seen: [text] = []
    for worker in workers:
        val id = worker.node.ssh.node.worker_id
        if id == "" or seen.contains(id) or
           worker.graph_path != first.graph_path or
           worker.owner_root != first.owner_root or
           worker.protected_trust_domain != first.protected_trust_domain or
           worker.node.retained_cas_root != first.node.retained_cas_root or
           worker.capacity.cpu_tokens != first.capacity.cpu_tokens or
           worker.capacity.memory_bytes != first.capacity.memory_bytes or
           worker.capacity.memory_reserve_bytes !=
               first.capacity.memory_reserve_bytes or
           worker.capacity.fd_tokens != first.capacity.fd_tokens or
           worker.capabilities.node_id != id or
           worker.capabilities.trust_domain != first.protected_trust_domain or
           not distributed_build_node_consistent_v1(worker.node):
            return false
        seen.push(id)
    for request in graph.requests:
        if not seen.contains(request.attempt.worker_id):
            return false
    true

fn plan_parent_graph_step_v1(graph: ParentGraphRequestV1,
        ledger: SchedulerLedgerV1, workers: [DistBuildConfigV1],
        attempt_id: text, now_tick: i64) -> ParentGraphStepV1:
    """Choose one durable next step; never infer success from a remote reply."""
    if not parent_graph_workers_valid_v1(graph, workers) or
       not scheduler_ledger_valid_v1(ledger):
        return _graph_step_v1("BLOCKED", "graph-or-worker-policy-invalid",
            -1, "", "", 0)
    var active_count: i64 = 0
    var active_worker: i64 = -1
    var active_action = ""
    var active_attempt = ""
    for attempt in ledger.attempts:
        if attempt.active:
            for action in graph.actions:
                if attempt.action_digest == action.action_digest:
                    val worker_index = _graph_worker_index_v1(workers,
                        attempt.worker_id)
                    if worker_index < 0:
                        return _graph_step_v1("BLOCKED",
                            "graph-active-worker-unavailable", -1,
                            "", "", 0)
                    if active_count == 0:
                        active_worker = worker_index
                        active_action = attempt.action_digest
                        active_attempt = attempt.attempt_id
                    active_count = active_count + 1
    if active_count > 0:
        return _graph_step_v1("RESUME", "active-attempt", active_worker,
            active_action, active_attempt, 0)
    if _graph_accepted_count_v1(graph, ledger) == graph.actions.len():
        return _graph_step_v1("COMPLETE", "graph-complete", -1,
            "", "", 0)
    if attempt_id == "" or now_tick < 0:
        return _graph_step_v1("BLOCKED", "attempt-or-clock-invalid",
            -1, "", "", 0)
    var reason = "graph-no-ready-action"
    var best_worker: i64 = -1
    var best_digest = ""
    var best_priority: i64 = -1
    var best_retry: i64 = 0
    var i: i64 = 0
    while i < workers.len():
        val worker = workers[i]
        val choice = select_next_parent_graph_request_v1(graph, ledger,
            worker.node.ssh.node.worker_id, worker.capabilities,
            worker.capacity, attempt_id, now_tick)
        if choice.ready and choice.request != nil:
            val digest = choice.request.unwrap().attempt.action_digest
            for action in graph.actions:
                if action.action_digest == digest:
                    val age = if now_tick > action.queued_tick:
                        now_tick - action.queued_tick else: 0
                    val priority = action.priority + age
                    if best_worker < 0 or priority > best_priority or
                       (priority == best_priority and digest < best_digest):
                        best_worker = i
                        best_digest = digest
                        best_priority = priority
                        best_retry = choice.retry_number
        if choice.reason != "graph-no-action-for-worker" and
           choice.reason != "graph-no-ready-action":
            reason = choice.reason
        i = i + 1
    if best_worker >= 0:
        return _graph_step_v1("DISPATCH", "ready", best_worker,
            best_digest, attempt_id, best_retry)
    _graph_step_v1("BLOCKED", reason, -1, "", "", 0)

fn run_parent_graph_v1(graph: ParentGraphRequestV1,
        workers: [DistBuildConfigV1], now_tick: i64) -> ParentGraphRunV1:
    """Run accepted dependencies in sequence; stop on failure or uncertainty.

    The protected caller has pinned the graph manifest and every request wire.
    Worker configs and their ancestor directories are administrator-owned.
    An uncertain remote attempt remains active for a later resume invocation.
    """
    if not parent_graph_workers_valid_v1(graph, workers):
        return _graph_run_v1(false, "graph-or-worker-policy-invalid", 0,
            "", false)
    val bound = graph.actions.len() * 4 + 1
    var transitions: i64 = 0
    var last_attempt = ""
    var last_accepted_count: i64 = 0
    while transitions < bound:
        val owner = scheduler_owner_open_v1(workers[0].owner_root)
        if owner.error != "":
            return _graph_run_v1(false, "owner: " + owner.error, 0,
                last_attempt, true)
        val recovery_problem = _graph_reconcile_unstarted_v1(owner, graph)
        if recovery_problem != "":
            val closed = scheduler_owner_close_v1(owner)
            return _graph_run_v1(false,
                if closed: recovery_problem else: "owner-close-after-recovery",
                last_accepted_count, last_attempt, true)
        val ledger = owner.state.ledger
        val accepted = _graph_accepted_count_v1(graph, ledger)
        last_accepted_count = accepted
        val nonce = random_hex(16) ?? ""
        val attempt_id = if nonce.len() == 32: "dist-" + nonce else: ""
        val step = plan_parent_graph_step_v1(graph, ledger, workers,
            attempt_id, now_tick)
        if not scheduler_owner_close_v1(owner):
            return _graph_run_v1(false, "owner-close-before-step", accepted,
                last_attempt, true)
        if step.action == "COMPLETE":
            return _graph_run_v1(true, "graph-complete", accepted,
                last_attempt, false)
        if step.action == "BLOCKED":
            return _graph_run_v1(false, step.reason, accepted,
                last_attempt, false)
        val worker = workers[step.worker_index]
        last_attempt = step.attempt_id
        if step.action == "RESUME":
            print("parent-graph: RESUMING attempt={step.attempt_id} action={step.action_digest}")
        else:
            print("parent-graph: PROPOSED attempt={step.attempt_id} action={step.action_digest}")
        val result = if step.action == "RESUME":
            resume_parent_remote_attempt_v1(worker.owner_root,
                step.attempt_id, worker.node)
        else:
            run_parent_remote_action_v1(graph.actions, step.action_digest,
                step.attempt_id, step.retry_number, worker.owner_root,
                worker.node, worker.capabilities,
                worker.protected_trust_domain, worker.capacity, now_tick)
        if not result.completed or not result.published or
           result.failure_recorded or result.reconciliation_required:
            return _graph_run_v1(false, result.reason, accepted,
                last_attempt, result.reconciliation_required)
        transitions = transitions + 1
    _graph_run_v1(false, "graph-transition-bound", last_accepted_count,
        last_attempt, false)

export ParentGraphStepV1, ParentGraphRunV1
export parent_graph_workers_valid_v1, plan_parent_graph_step_v1
export run_parent_graph_v1
