# Local Docker byte-stream SFFI owner. The caller must trust the socket path,
# its ancestor directories, and the daemon; connect supplies no peer identity.
# ASCII paths are limited to 103 bytes for macOS/Linux sockaddr_un portability.
# Connect uses a bounded nonblocking native call and returns a blocking stream.
# Read timeout is 1..60000 ms per syscall. Write timeout is a 1..60000 ms
# monotonic budget for the complete byte array, including partial sends.
# Buffers are limited to 1 MiB. Writes use the hosted runtime's SIGPIPE-safe
# socket send; unsupported runtimes return an error before accepting bytes.
# Stream values must have one owner: do not copy, share, or close their fd.
# Explicit close is required. A failed close retains state but the native ABI
# cannot prove whether the OS consumed the fd; do not blindly retry on EINTR.
# Native byte-array lowering requires separate compiled integration evidence.
use app.io.time_ops.{time_now_nanos}

@unsafe(reason: "bounded Unix connect returns an owned descriptor or negative sentinel", capabilities: [ffi])
extern fn rt_unix_socket_connect_timeout(path: text, timeout_ms: i64) -> i64
@unsafe(reason: "raw owned bytes; nil is failure, empty array is EOF", capabilities: [ffi])
extern fn rt_io_tcp_read(fd: i64, size: i64) -> [u8]?
@unsafe(reason: "raw socket send suppresses SIGPIPE and returns byte count or failure", capabilities: [ffi])
extern fn rt_io_socket_send_nosigpipe(fd: i64, data: [u8]) -> i64
@unsafe(reason: "raw socket timeout mutation can fail", capabilities: [ffi])
extern fn rt_io_tcp_set_read_timeout(fd: i64, ms: i64) -> bool
@unsafe(reason: "raw socket timeout mutation can fail", capabilities: [ffi])
extern fn rt_io_tcp_set_write_timeout(fd: i64, ms: i64) -> bool
@unsafe(reason: "raw close consumes descriptor on success; failure is ambiguous", capabilities: [ffi])
extern fn rt_io_tcp_close(fd: i64) -> bool

struct DockerUnixChunkV1:
    bytes: [u8]
    eof: bool

class DockerUnixByteStreamV1:
    fd: i64
    read_timeout_ms: i64
    write_timeout_ms: i64

    static fn connect(path: text, read_timeout_ms: i64, write_timeout_ms: i64) -> Result<DockerUnixByteStreamV1, text>:
        if not path.starts_with("/") or path.len() < 2 or path.len() > 103:
            return Err("docker socket: absolute path of 2..103 ASCII bytes required")
        for c in path.chars():
            if c < " " or c > "~":
                return Err("docker socket: path must contain printable ASCII only")
        if read_timeout_ms < 1 or read_timeout_ms > 60000:
            return Err("docker socket: read timeout must be 1..60000 ms")
        if write_timeout_ms < 1 or write_timeout_ms > 60000:
            return Err("docker socket: write timeout must be 1..60000 ms")
        val fd = unsafe(capabilities: [ffi]):
            rt_unix_socket_connect_timeout(path, read_timeout_ms)
        if fd < 0:
            return Err("docker socket: connect failed")
        # Apply the read timeout before I/O, keeping the returned stream owner
        # available if setsockopt fails; constructor errors cannot carry an fd.
        Ok(DockerUnixByteStreamV1(fd, read_timeout_ms, write_timeout_ms))

    me fn write_all(bytes: [u8]) -> Result<bool, text>:
        if self.fd < 0:
            return Err("docker socket: stream is closed")
        if bytes.len() > 1048576:
            return Err("docker socket: write exceeds 1048576 byte cap")
        if bytes.len() == 0:
            return Ok(true)
        val started_ns = time_now_nanos()
        val budget_ns = self.write_timeout_ms * 1000000
        var sent: i64 = 0
        while sent < bytes.len():
            val before_ns = time_now_nanos()
            if before_ns < started_ns or before_ns - started_ns >= budget_ns:
                return Err("docker socket: aggregate write deadline exceeded")
            val remaining_ms = (budget_ns - (before_ns - started_ns)) / 1000000
            if remaining_ms < 1:
                return Err("docker socket: aggregate write deadline exhausted")
            val configured = unsafe(capabilities: [ffi]):
                rt_io_tcp_set_write_timeout(self.fd, remaining_ms)
            if not configured:
                return Err("docker socket: write timeout setup failed")
            val written = unsafe(capabilities: [ffi]):
                rt_io_socket_send_nosigpipe(self.fd, bytes[sent:])
            val after_ns = time_now_nanos()
            if after_ns < before_ns or after_ns - started_ns >= budget_ns:
                return Err("docker socket: aggregate write deadline exceeded")
            if written <= 0 or written > bytes.len() - sent:
                return Err("docker socket: write failed or incomplete")
            sent = sent + written
        Ok(true)

    me fn read_chunk(max_bytes: i64) -> Result<DockerUnixChunkV1, text>:
        if self.fd < 0:
            return Err("docker socket: stream is closed")
        if max_bytes < 1 or max_bytes > 1048576:
            return Err("docker socket: read cap must be 1..1048576 bytes")
        val configured = unsafe(capabilities: [ffi]):
            rt_io_tcp_set_read_timeout(self.fd, self.read_timeout_ms)
        if not configured:
            return Err("docker socket: read timeout setup failed")
        val chunk = unsafe(capabilities: [ffi]):
            rt_io_tcp_read(self.fd, max_bytes)
        if chunk == nil:
            return Err("docker socket: read failed or timed out; EOF not established")
        val bytes = chunk!
        if bytes.len() > max_bytes:
            return Err("docker socket: native read exceeded requested cap")
        Ok(DockerUnixChunkV1(bytes, bytes.len() == 0))

    me fn close() -> Result<bool, text>:
        if self.fd < 0:
            return Ok(true)
        val closed = unsafe(capabilities: [ffi]):
            rt_io_tcp_close(self.fd)
        if not closed:
            return Err("docker socket: close failed; descriptor ownership unresolved")
        self.fd = -1
        Ok(true)

export DockerUnixByteStreamV1, DockerUnixChunkV1
