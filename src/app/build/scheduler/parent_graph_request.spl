# Admit a protected set of complete request templates as one scheduler graph.
# The selected worker binding is checked against administrator node policy;
# other templates supply action/dependency identity, not dispatch authority.
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    parse_build_worker_request_v1}
use app.build.scheduler.parent_action_admission.{admit_parent_action_intent_v1}
use app.build.scheduler.planner.{SchedulerActionV1,
    scheduler_action_digest_valid_v1, plan_ready_actions_v1}
use app.build.scheduler.ledger.{SchedulerLedgerV1, SchedulerCapacityV1,
    scheduler_ledger_valid_v1, admit_attempt_v1,
    scheduler_next_retry_number_v1, scheduler_worker_busy_v1}
use compiler.common.build_contract.{NodeCapabilities}

val PARENT_GRAPH_MAX_REQUESTS_V1: i64 = 256
pub val PARENT_GRAPH_MAX_WIRE_BYTES_V1: i64 = 16777216
val PARENT_GRAPH_AUTO_MAX_ATTEMPTS_V1: i64 = 3

struct ParentGraphRequestV1:
    valid: bool
    reason: text
    actions: [SchedulerActionV1]
    requests: [BuildWorkerRequestV1]
    selected: BuildWorkerRequestV1?

struct ParentGraphChoiceV1:
    ready: bool
    reason: text
    request: BuildWorkerRequestV1?
    retry_number: i64

fn _graph_request_reject_v1(reason: text) -> ParentGraphRequestV1:
    ParentGraphRequestV1(false, reason, [], [], nil)

fn _graph_choice_reject_v1(reason: text) -> ParentGraphChoiceV1:
    ParentGraphChoiceV1(false, reason, nil, 0)

fn admit_parent_graph_requests_v1(wires: [text],
        selected_action_digest: text, protected_worker_id: text,
        queued_tick: i64) -> ParentGraphRequestV1:
    """Validate a complete DAG before a selected action reaches owner admission.

    The caller must read the request wires from an administrator-owned stable
    graph manifest. This function cannot certify a compiler's input closure;
    each ActionSpec must already carry authoritative complete discovery.
    """
    if wires.len() == 0 or wires.len() > PARENT_GRAPH_MAX_REQUESTS_V1 or
       (selected_action_digest != "" and
        not scheduler_action_digest_valid_v1(selected_action_digest)) or
       protected_worker_id == "" or queued_tick < 0 or
       queued_tick > 1000000000:
        return _graph_request_reject_v1("graph-policy-invalid")
    var actions: [SchedulerActionV1] = []
    var requests: [BuildWorkerRequestV1] = []
    var attempt_ids: [text] = []
    var selected: BuildWorkerRequestV1? = nil
    var total_bytes: i64 = 0
    for wire in wires:
        total_bytes = total_bytes + wire.len()
        if total_bytes > PARENT_GRAPH_MAX_WIRE_BYTES_V1:
            return _graph_request_reject_v1("graph-wire-bound")
        val parsed = parse_build_worker_request_v1(wire)
        if parsed == nil:
            return _graph_request_reject_v1("graph-request-invalid")
        val request = parsed.unwrap()
        if attempt_ids.contains(request.attempt.attempt_id):
            return _graph_request_reject_v1("graph-attempt-duplicate")
        attempt_ids.push(request.attempt.attempt_id)
        val admitted = admit_parent_action_intent_v1(request,
            request.attempt.worker_id, queued_tick)
        if not admitted.accepted or admitted.action == nil:
            return _graph_request_reject_v1("graph-action: " + admitted.reason)
        for previous in actions:
            if previous.action_digest == admitted.action.unwrap().action_digest:
                return _graph_request_reject_v1("graph-action-duplicate")
        actions.push(admitted.action.unwrap())
        requests.push(request)
        if request.attempt.action_digest == selected_action_digest:
            if request.attempt.worker_id != protected_worker_id:
                return _graph_request_reject_v1("graph-selected-worker-mismatch")
            selected = request
    if selected_action_digest != "" and selected == nil:
        return _graph_request_reject_v1("graph-selected-action-missing")
    val plan = plan_ready_actions_v1(actions, [], [], queued_tick)
    if plan.error != "":
        return _graph_request_reject_v1(plan.error)
    ParentGraphRequestV1(true, "", actions, requests, selected)

fn select_next_parent_graph_request_v1(graph: ParentGraphRequestV1,
        ledger: SchedulerLedgerV1, protected_worker_id: text,
        capabilities: NodeCapabilities, capacity: SchedulerCapacityV1,
        attempt_id: text,
        now_tick: i64) -> ParentGraphChoiceV1:
    """Choose one worker-assigned ready action from a current ledger snapshot.

    This is advisory. The final owner must recheck readiness, capacity, retry
    number and attempt identity under its exclusive lock before admission.
    """
    if not graph.valid or protected_worker_id == "" or attempt_id == "" or
       capabilities.version != 1 or
       capabilities.node_id != protected_worker_id or
       capabilities.memory_capacity_bytes <= 0 or
       not scheduler_ledger_valid_v1(ledger):
        return _graph_choice_reject_v1("graph-selection-invalid")
    if capacity.cpu_tokens <= 0 or capacity.memory_bytes <= 0 or
       capacity.fd_tokens <= 0 or capacity.memory_reserve_bytes < 0 or
       capacity.memory_reserve_bytes >= capacity.memory_bytes:
        return _graph_choice_reject_v1("graph-capacity-invalid")
    var accepted: [text] = []
    var active: [text] = []
    var cpu_left = capacity.cpu_tokens
    var memory_left = capacity.memory_bytes - capacity.memory_reserve_bytes
    var fd_left = capacity.fd_tokens
    for item in ledger.accepted:
        for action in graph.actions:
            if action.action_digest == item.action_digest:
                accepted.push(item.action_digest)
    for item in ledger.attempts:
        if item.attempt_id == attempt_id:
            return _graph_choice_reject_v1("graph-attempt-id-reused")
        if item.active:
            for action in graph.actions:
                if action.action_digest == item.action_digest:
                    active.push(item.action_digest)
            cpu_left = cpu_left - item.cpu_tokens
            memory_left = memory_left - item.memory_bytes
            fd_left = fd_left - item.fd_tokens
    if cpu_left < 0 or memory_left < 0 or fd_left < 0:
        return _graph_choice_reject_v1("graph-capacity-overcommitted")
    val plan = plan_ready_actions_v1(graph.actions, accepted, active, now_tick)
    if plan.error != "":
        return _graph_choice_reject_v1(plan.error)
    if plan.ready.len() == 0:
        if accepted.len() == graph.actions.len():
            return _graph_choice_reject_v1("graph-complete")
        return _graph_choice_reject_v1("graph-no-ready-action")
    if scheduler_worker_busy_v1(ledger, protected_worker_id):
        return _graph_choice_reject_v1("graph-worker-busy")
    var assigned = false
    var policy_match = false
    var fits = false
    var retry_limited = false
    for digest in plan.ready:
        for request in graph.requests:
            if request.attempt.action_digest == digest and
               request.attempt.worker_id == protected_worker_id:
                assigned = true
                if not capabilities.target_triples.contains(
                        request.action.toolchain.target_triple) or
                   not capabilities.provider_abi_digests.contains(
                        request.action.toolchain.provider_abi_digest) or
                   request.attempt.memory_budget_bytes >
                        capabilities.memory_capacity_bytes:
                    continue
                policy_match = true
                if request.cpu_tokens <= cpu_left and
                   request.attempt.memory_budget_bytes <= memory_left and
                   request.fd_tokens <= fd_left:
                    fits = true
                    var deterministic_failure = false
                    for failure in ledger.failures:
                        if failure.action_digest == digest and
                           ["compiler-failure", "source-diagnostic"].contains(
                               failure.classification):
                            deterministic_failure = true
                    if deterministic_failure:
                        continue
                    val next_retry = scheduler_next_retry_number_v1(ledger,
                        digest)
                    if next_retry >= PARENT_GRAPH_AUTO_MAX_ATTEMPTS_V1:
                        retry_limited = true
                        continue
                    val dry = admit_attempt_v1(ledger, graph.actions, digest,
                        attempt_id, protected_worker_id, capacity, now_tick)
                    if not dry.admitted or dry.error != "":
                        val dry_reason = if dry.error == "": "graph-dry-run-rejected" else: dry.error
                        return _graph_choice_reject_v1(dry_reason)
                    return ParentGraphChoiceV1(true, "", request, next_retry)
    if not assigned:
        return _graph_choice_reject_v1("graph-no-action-for-worker")
    if not policy_match:
        return _graph_choice_reject_v1("graph-worker-policy-mismatch")
    if not fits:
        return _graph_choice_reject_v1("graph-capacity-exhausted")
    if retry_limited:
        return _graph_choice_reject_v1("graph-retry-limit")
    _graph_choice_reject_v1("graph-retry-requires-explicit-action")

export PARENT_GRAPH_MAX_REQUESTS_V1, PARENT_GRAPH_MAX_WIRE_BYTES_V1
export PARENT_GRAPH_AUTO_MAX_ATTEMPTS_V1
export ParentGraphRequestV1, admit_parent_graph_requests_v1
export ParentGraphChoiceV1, select_next_parent_graph_request_v1
