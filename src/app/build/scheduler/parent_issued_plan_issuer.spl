# Administrator-side preflight for an already approved staged-plan digest.
# Approval is external: this module must run with a separately trusted policy
# decision and a protected store root. It never derives its own authority.
use app.build.scheduler.parent_staged_link_cli.{
    load_parent_staged_link_cli_v1}
use app.build.scheduler.parent_issued_plan_wire.{
    encode_parent_issued_plan_wire_v1}
use app.build.scheduler.parent_issued_plan_store.{
    ParentIssuedPlanPublishV1, publish_issued_parent_plan_v1}

fn issue_approved_parent_staged_plan_v1(trusted_root: text,
        approved_plan_digest: text, template_path: text,
        template_digest: text,
        config_paths: [text]) -> ParentIssuedPlanPublishV1:
    """Publish only an exact complete preflight matching independent approval.

    The caller must authenticate the approval and control trusted_root; a
    candidate-provided digest or writable directory cannot approve itself.
    """
    var args: [text] = ["--staged-plan-digest", approved_plan_digest,
        "--template", template_path,
        "--template-digest", template_digest]
    for path in config_paths:
        args.push("--config")
        args.push(path)
    val loaded = load_parent_staged_link_cli_v1(args)
    if not loaded.valid:
        return ParentIssuedPlanPublishV1(false, false,
            "issued-plan-preflight: " + loaded.reason, "")
    val wire = encode_parent_issued_plan_wire_v1(
        approved_plan_digest, template_path, template_digest,
        config_paths)
    if wire == "":
        return ParentIssuedPlanPublishV1(false, false,
            "issued-plan-record-invalid", "")
    publish_issued_parent_plan_v1(trusted_root, wire)

export issue_approved_parent_staged_plan_v1
