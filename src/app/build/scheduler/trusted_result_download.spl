# Retrieve only declared files from one trusted worker's completed attempt.
# SFTP writes to a fresh private parent directory. Hashes and the full output
# manifest are reconstructed locally before any candidate can be published.
# The worker account and its private inbox remain inside the trusted domain.
use app.io.mod.{secure_temp_dir, dir_create_all, dir_remove_all,
    file_atomic_write, file_is_regular_no_follow, file_hash_sha256,
    file_size_raw,
    file_read_regular_no_follow_bounded, process_run_bounded}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1}
use app.build.scheduler.trusted_ssh.{trusted_ssh_node_valid_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1}
use app.build.scheduler.worker_ready.{BUILD_WORKER_CONTROL_DIRECTORY_V1}
use app.build.scheduler.dispatch_wire.{encode_build_dispatch_v1}
use app.build.scheduler.trusted_worker_invocation.{validate_build_worker_reply_v1}
use app.build.scheduler.worker_output.{verify_build_outputs_v1,
    BUILD_OUTPUT_MAX_FILES_V1, BUILD_OUTPUT_MANIFEST_MAX_BYTES_V1,
    BUILD_OUTPUT_MAX_DIAGNOSTIC_BYTES_V1, BUILD_OUTPUT_MAX_TOTAL_BYTES_V1}
use app.build.scheduler.worker_failure_proof.{
    parse_build_worker_failure_proof_v1,
    BUILD_WORKER_FAILURE_PROOF_MAX_V1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use compiler.common.cache.canonical_identity.{canonical_identity_sort_texts}
use std.common.crypto.sha256.{sha256_text}
use std.io_runtime.{platform_name}

struct BuildResultFetchPlanV1:
    valid: bool
    reason: text
    batch: text
    remote_result_root: text
    output_count: i64

struct BuildResultFetchV1:
    verified: bool
    success: bool
    reason: text
    stage_root: text
    output_root: text
    verified_manifest_digest: text
    result_wire: text

struct BuildResultDownloadBudgetV1:
    valid: bool
    reason: text
    output_sizes: [i64]

struct BuildResultTransferLimitsV1:
    max_total_bytes: i64
    max_file_bytes: i64
    max_files: i64

val BUILD_RESULT_DEFAULT_TOTAL_BYTES_V1: i64 = 1074860032

fn _result_default_limits_v1() -> BuildResultTransferLimitsV1:
    BuildResultTransferLimitsV1(BUILD_RESULT_DEFAULT_TOTAL_BYTES_V1,
        BUILD_OUTPUT_MAX_TOTAL_BYTES_V1, BUILD_OUTPUT_MAX_FILES_V1 + 3)

fn _result_limits_valid_v1(limits: BuildResultTransferLimitsV1) -> bool:
    limits.max_total_bytes > 0 and
    limits.max_total_bytes <= BUILD_RESULT_DEFAULT_TOTAL_BYTES_V1 and
    limits.max_file_bytes > 0 and
    limits.max_file_bytes <= BUILD_OUTPUT_MAX_TOTAL_BYTES_V1 and
    limits.max_files > 0 and
    limits.max_files <= BUILD_OUTPUT_MAX_FILES_V1 + 3

fn _result_fetch_reject_v1(reason: text) -> BuildResultFetchPlanV1:
    BuildResultFetchPlanV1(false, reason, "", "", 0)

fn _result_segment_v1(value: text) -> bool:
    if value == "" or value == "." or value == ".." or
       value.len() > 128 or value.starts_with("-"):
        return false
    for c in value.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "_" or c == "-" or c == ".":
            continue
        return false
    true

fn _result_path_v1(path: text) -> bool:
    if not path.starts_with("/") or path.len() < 2 or path.len() > 4096 or
       path.ends_with("/") or path.contains("//"):
        return false
    val parts = path.split("/")
    var i: i64 = 1
    while i < parts.len():
        if not _result_segment_v1(parts[i]):
            return false
        i = i + 1
    true

fn plan_build_result_sftp_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, local_output_root: text) -> BuildResultFetchPlanV1:
    """Name a bounded declared result set; never trust worker-chosen paths."""
    if encode_build_worker_request_v1(request) == "" or
       request.attempt.worker_id != config.node.worker_id or
       not _result_segment_v1(request.attempt.attempt_id) or
       not _result_path_v1(config.remote_inbox_root) or
       not _result_path_v1(local_output_root):
        return _result_fetch_reject_v1("request-or-path-invalid")
    if not trusted_ssh_node_valid_v1(config.node) or
       not _result_path_v1(config.sftp_executable) or
       not file_is_regular_no_follow(config.sftp_executable) or
       not scheduler_action_digest_valid_v1(config.sftp_digest) or
       file_hash_sha256(config.sftp_executable) != config.sftp_digest:
        return _result_fetch_reject_v1("transport-config-invalid")
    val outputs = request.action.output_paths
    if outputs.len() == 0 or outputs.len() > BUILD_OUTPUT_MAX_FILES_V1:
        return _result_fetch_reject_v1("output-count-invalid")
    val remote = config.remote_inbox_root + "/" +
        request.attempt.attempt_id + "/" +
        BUILD_WORKER_CONTROL_DIRECTORY_V1 + "/results"
    var batch = "get " + remote + "/result.wire " +
        local_output_root + "/result.wire\n"
    batch = batch + "get " + remote + "/manifest.wire " +
        local_output_root + "/manifest.wire\n"
    batch = batch + "get " + remote + "/diagnostics " +
        local_output_root + "/diagnostics\n"
    for name in outputs:
        if not _result_segment_v1(name) or
           ["result.wire", "manifest.wire", "diagnostics",
            "failure-proof.wire"].contains(name):
            return _result_fetch_reject_v1("output-name-invalid")
        batch = batch + "get " + remote + "/" + name + " " +
            local_output_root + "/" + name + "\n"
    if batch.len() > 65536:
        return _result_fetch_reject_v1("batch-bound")
    BuildResultFetchPlanV1(true, "", batch, remote, outputs.len())

fn _result_download_failure_v1(reason: text, root: text) -> BuildResultFetchV1:
    if root != "" and not dir_remove_all(root):
        return BuildResultFetchV1(false, false, reason + "-cleanup-failed", root,
            "", "", "")
    BuildResultFetchV1(false, false, reason, "", "", "", "")

fn plan_build_result_metadata_sftp_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, local_output_root: text) -> BuildResultFetchPlanV1:
    """Read metadata before any success-output download budget is trusted."""
    val full = plan_build_result_sftp_v1(config, request, local_output_root)
    if not full.valid:
        return full
    val remote = full.remote_result_root
    val batch = "get " + remote + "/result.wire " +
        local_output_root + "/result.wire\n" +
        "get " + remote + "/manifest.wire " +
        local_output_root + "/manifest.wire\n" +
        "get " + remote + "/diagnostics " +
        local_output_root + "/diagnostics\n"
    BuildResultFetchPlanV1(true, "", batch, remote, 0)

fn plan_build_failure_sftp_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, local_output_root: text) -> BuildResultFetchPlanV1:
    """Fetch fixed failure metadata and the versioned terminal proof."""
    val metadata = plan_build_result_metadata_sftp_v1(config, request,
        local_output_root)
    if not metadata.valid: return metadata
    BuildResultFetchPlanV1(true, "",
        metadata.batch + "get " + metadata.remote_result_root +
            "/failure-proof.wire " + local_output_root +
            "/failure-proof.wire\n",
        metadata.remote_result_root, 0)

fn _run_result_batch_v1(config: TrustedSftpConfigV1,
        batch_file: text, max_file_bytes: i64) -> bool:
    # The host shells differ: observed macOS /bin/sh uses 1024-byte blocks,
    # while Debian /bin/sh uses 512-byte blocks. Fail closed on other hosts.
    # Each batch has one output, or only the fixed metadata destinations.
    if max_file_bytes <= 0 or max_file_bytes > BUILD_OUTPUT_MAX_TOTAL_BYTES_V1:
        return false
    val host = platform_name()
    val block_bytes = if host == "macos": 1024
        elif host == "linux": 512
        else: 0
    if block_bytes == 0:
        return false
    val node = config.node
    val args = ["-F", "none", "-b", batch_file, "-o", "BatchMode=yes",
        "-o", "StrictHostKeyChecking=yes", "-o",
        "UserKnownHostsFile=" + node.known_hosts_path,
        "-o", "GlobalKnownHostsFile=none", "-o", "UpdateHostKeys=no",
        "-o", "IdentityAgent=none", "-o", "IdentitiesOnly=yes",
        "-o", "HostKeyAlias=" + node.worker_id,
        "-o", "ClearAllForwardings=yes", "-o", "ForwardAgent=no",
        "-o", "ForwardX11=no", "-o", "ConnectTimeout=5",
        "-P", node.port.to_text(), "-i", node.identity_path,
        "-S", node.ssh_executable, node.user + "@" + node.host]
    # The block-rounded shell limit may permit one final partial block beyond
    # max_file_bytes. Callers verify the exact on-disk size before acceptance.
    val blocks = (max_file_bytes + block_bytes - 1) / block_bytes
    val shell_args = ["-c", "ulimit -f \"$1\" || exit 1; shift; exec \"$@\"",
        "build-sftp", blocks.to_text(), config.sftp_executable] + args
    val (stdout, stderr, code) = process_run_bounded(
        "/bin/sh", shell_args, 300000, 8192)
    code == 0 and stdout.len() < 8192 and stderr.len() < 8192

fn _result_get_metadata_v1(config: TrustedSftpConfigV1,
        remote_root: text, output_root: text, batch_file: text,
        name: text, protocol_cap: i64, remaining: i64,
        limits: BuildResultTransferLimitsV1) -> text?:
    var cap = protocol_cap
    if cap > limits.max_file_bytes: cap = limits.max_file_bytes
    if cap > remaining: cap = remaining
    if cap <= 0: return nil
    val path = output_root + "/" + name
    val batch = "get " + remote_root + "/" + name + " " + path + "\n"
    if not file_atomic_write(batch_file, batch) or
       not _run_result_batch_v1(config, batch_file, cap):
        return nil
    val read = file_read_regular_no_follow_bounded(path, cap)
    if read.is_err() or not file_is_regular_no_follow(path) or
       file_size_raw(path) != read.unwrap().bytes().len():
        return nil
    Some(read.unwrap())

struct _ResultMetadataSetV1:
    valid: bool
    result_wire: text
    manifest_wire: text
    diagnostics: text
    failure_proof: text
    total_bytes: i64

fn _result_metadata_reject_v1() -> _ResultMetadataSetV1:
    _ResultMetadataSetV1(false, "", "", "", "", 0)

fn _result_read_metadata_v1(output_root: text, name: text,
        cap: i64) -> text?:
    val path = output_root + "/" + name
    val read = file_read_regular_no_follow_bounded(path, cap)
    if read.is_err() or not file_is_regular_no_follow(path) or
       file_size_raw(path) != read.unwrap().bytes().len():
        return nil
    Some(read.unwrap())

fn _result_metadata_set_v1(config: TrustedSftpConfigV1,
        remote_root: text, output_root: text, batch_file: text,
        failure: bool, limits: BuildResultTransferLimitsV1) ->
        _ResultMetadataSetV1:
    var names = ["result.wire", "manifest.wire", "diagnostics"]
    if failure: names.push("failure-proof.wire")
    var values: [text] = []
    var remaining = limits.max_total_bytes
    val defaults = _result_default_limits_v1()
    val legacy_batch = limits.max_total_bytes == defaults.max_total_bytes and
        limits.max_file_bytes == defaults.max_file_bytes and
        limits.max_files == defaults.max_files
    if legacy_batch:
        var batch = ""
        for name in names:
            batch = batch + "get " + remote_root + "/" + name + " " +
                output_root + "/" + name + "\n"
        if not file_atomic_write(batch_file, batch) or
           not _run_result_batch_v1(config, batch_file,
               BUILD_OUTPUT_MAX_DIAGNOSTIC_BYTES_V1):
            return _result_metadata_reject_v1()
    for name in names:
        val cap = if name == "result.wire": 4096
            elif name == "manifest.wire": BUILD_OUTPUT_MANIFEST_MAX_BYTES_V1
            elif name == "diagnostics": BUILD_OUTPUT_MAX_DIAGNOSTIC_BYTES_V1
            else: BUILD_WORKER_FAILURE_PROOF_MAX_V1
        val read = if legacy_batch:
            _result_read_metadata_v1(output_root, name, cap)
        else:
            _result_get_metadata_v1(config, remote_root, output_root,
                batch_file, name, cap, remaining, limits)
        if read == nil or read.unwrap().bytes().len() > remaining:
            return _result_metadata_reject_v1()
        remaining = remaining - read.unwrap().bytes().len()
        values.push(read.unwrap())
    val proof = if failure: values[3] else: ""
    _ResultMetadataSetV1(true, values[0], values[1], values[2], proof,
        limits.max_total_bytes - remaining)

fn plan_build_result_download_budget_v1(request: BuildWorkerRequestV1,
        manifest: text, claimed_digest: text) -> BuildResultDownloadBudgetV1:
    """Require exact ordered output claims and a bounded aggregate before fetch."""
    if manifest.len() == 0 or manifest.len() > BUILD_OUTPUT_MANIFEST_MAX_BYTES_V1 or
       sha256_text(manifest) != claimed_digest or not manifest.ends_with("\n"):
        return BuildResultDownloadBudgetV1(false, "manifest-invalid", [])
    val names = canonical_identity_sort_texts(request.action.output_paths)
    if names.len() == 0 or names.len() > BUILD_OUTPUT_MAX_FILES_V1:
        return BuildResultDownloadBudgetV1(false, "output-count-invalid", [])
    val lines = manifest[0:manifest.len() - 1].split("\n")
    if lines.len() != 7 + names.len() or
       lines[0] != "simple-build-output-manifest-v1" or
       lines[1] != "action=" + request.attempt.action_digest or
       lines[2] != "attempt=" + request.attempt.attempt_id or
       lines[3] != "worker=" + request.attempt.worker_id or
       lines[4] != "fence=" + request.fence.to_text() or
       not lines[5].starts_with("diagnostics=") or
       not scheduler_action_digest_valid_v1(lines[5][12:]) or
       lines[6] != "count=" + names.len().to_text():
        return BuildResultDownloadBudgetV1(false, "manifest-header-invalid", [])
    var sizes: [i64] = []
    var total: i64 = 0
    var i: i64 = 0
    while i < names.len():
        if not _result_segment_v1(names[i]) or
           (i > 0 and names[i] == names[i - 1]):
            return BuildResultDownloadBudgetV1(false, "output-name-invalid", [])
        val parts = lines[7 + i].split("|")
        if parts.len() != 3 or parts[0] != names[i] or
           not scheduler_action_digest_valid_v1(parts[2]):
            return BuildResultDownloadBudgetV1(false, "output-row-invalid", [])
        val size = parts[1].to_i64() ?? -1
        if size <= 0 or size.to_text() != parts[1] or
           size > BUILD_OUTPUT_MAX_TOTAL_BYTES_V1 - total:
            return BuildResultDownloadBudgetV1(false, "output-size-invalid", [])
        sizes.push(size)
        total = total + size
        i = i + 1
    BuildResultDownloadBudgetV1(true, "", sizes)

fn plan_build_result_download_budget_limited_v1(
        request: BuildWorkerRequestV1, manifest: text,
        claimed_digest: text, metadata_bytes: i64,
        limits: BuildResultTransferLimitsV1) -> BuildResultDownloadBudgetV1:
    """Apply a child handoff budget before fetching any declared output."""
    if not _result_limits_valid_v1(limits) or metadata_bytes < 0 or
       request.action.output_paths.len() + 3 > limits.max_files or
       metadata_bytes > limits.max_total_bytes:
        return BuildResultDownloadBudgetV1(false, "transfer-limit-invalid", [])
    val budget = plan_build_result_download_budget_v1(request, manifest,
        claimed_digest)
    if not budget.valid: return budget
    var total = metadata_bytes
    for size in budget.output_sizes:
        if size > limits.max_file_bytes or
           size > limits.max_total_bytes - total:
            return BuildResultDownloadBudgetV1(false,
                "transfer-byte-limit", [])
        total = total + size
    budget

fn fetch_build_result_sftp_limited_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, local_state_dir: text,
        expected_result_wire: text,
        limits: BuildResultTransferLimitsV1) -> BuildResultFetchV1:
    """Fetch and compare result bytes; immutable retention remains separate."""
    if not _result_path_v1(local_state_dir) or
       not _result_limits_valid_v1(limits) or
       request.action.output_paths.len() + 3 > limits.max_files:
        return _result_download_failure_v1("local-state-invalid", "")
    val created = secure_temp_dir(local_state_dir, "build-result-sftp")
    if created.is_err():
        return _result_download_failure_v1("stage-unavailable", "")
    val root = created.unwrap()
    val outputs = root + "/outputs"
    if not dir_create_all(outputs):
        return _result_download_failure_v1("output-stage-unavailable", root)
    val plan = plan_build_result_sftp_v1(config, request, outputs)
    if not plan.valid:
        return _result_download_failure_v1(plan.reason, root)
    val batch_file = root + "/transfer.batch"
    val metadata = _result_metadata_set_v1(config, plan.remote_result_root,
        outputs, batch_file, false, limits)
    if not metadata.valid:
        return _result_download_failure_v1("metadata-invalid", root)
    var remaining = limits.max_total_bytes - metadata.total_bytes
    if metadata.result_wire != expected_result_wire:
        return _result_download_failure_v1("ssh-sftp-result-mismatch", root)
    val dispatch = encode_build_dispatch_v1(request.action, request.attempt,
        request.fence, request.cpu_tokens, request.fd_tokens)
    val reply = validate_build_worker_reply_v1(dispatch,
        metadata.result_wire)
    if not reply.received or reply.result == nil or
       not reply.result.unwrap().candidate.success:
        return _result_download_failure_v1("candidate-invalid", root)
    val budget = plan_build_result_download_budget_limited_v1(request,
        metadata.manifest_wire,
        reply.result.unwrap().candidate.output_manifest_digest,
        metadata.total_bytes, limits)
    if not budget.valid:
        return _result_download_failure_v1(budget.reason, root)
    val sorted = canonical_identity_sort_texts(request.action.output_paths)
    var output_index: i64 = 0
    while output_index < sorted.len():
        val name = sorted[output_index]
        val batch = "get " + plan.remote_result_root + "/" + name +
            " " + outputs + "/" + name + "\n"
        val size = budget.output_sizes[output_index]
        if size > limits.max_file_bytes or size > remaining:
            return _result_download_failure_v1("transfer-byte-limit", root)
        if not file_atomic_write(batch_file, batch) or
           not _run_result_batch_v1(config, batch_file,
               size) or
           not file_is_regular_no_follow(outputs + "/" + name) or
           file_size_raw(outputs + "/" + name) != size:
            return _result_download_failure_v1("output-download-failed", root)
        remaining = remaining - size
        output_index = output_index + 1
    val observed = verify_build_outputs_v1(request.action, request.attempt,
        request.fence, outputs, metadata.diagnostics, metadata.manifest_wire,
        reply.result.unwrap().candidate.output_manifest_digest)
    if not observed.valid:
        return _result_download_failure_v1(observed.reason, root)
    if observed.diagnostic_digest != reply.result.unwrap().candidate.diagnostic_digest:
        return _result_download_failure_v1("diagnostic-mismatch", root)
    BuildResultFetchV1(true, true, "", root, outputs,
        observed.manifest_digest, metadata.result_wire)

fn fetch_build_failure_sftp_limited_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, local_state_dir: text,
        expected_result_wire: text,
        limits: BuildResultTransferLimitsV1) -> BuildResultFetchV1:
    """Retain bounded failure diagnostics without expecting output files."""
    if not _result_path_v1(local_state_dir) or
       not _result_limits_valid_v1(limits) or limits.max_files < 4:
        return _result_download_failure_v1("local-state-invalid", "")
    val created = secure_temp_dir(local_state_dir, "build-failure-sftp")
    if created.is_err():
        return _result_download_failure_v1("stage-unavailable", "")
    val root = created.unwrap()
    val outputs = root + "/outputs"
    if not dir_create_all(outputs):
        return _result_download_failure_v1("output-stage-unavailable", root)
    val plan = plan_build_failure_sftp_v1(config, request, outputs)
    if not plan.valid:
        return _result_download_failure_v1(plan.reason, root)
    val batch_file = root + "/transfer.batch"
    val metadata = _result_metadata_set_v1(config, plan.remote_result_root,
        outputs, batch_file, true, limits)
    if not metadata.valid:
        return _result_download_failure_v1("metadata-invalid", root)
    if metadata.result_wire != expected_result_wire:
        return _result_download_failure_v1("ssh-sftp-result-mismatch", root)
    val dispatch = encode_build_dispatch_v1(request.action, request.attempt,
        request.fence, request.cpu_tokens, request.fd_tokens)
    val reply = validate_build_worker_reply_v1(dispatch,
        metadata.result_wire)
    if not reply.received or reply.result == nil or
       reply.result.unwrap().candidate.success or metadata.manifest_wire != "" or
       reply.result.unwrap().candidate.output_manifest_digest != "" or
       sha256_text(metadata.diagnostics) !=
           reply.result.unwrap().candidate.diagnostic_digest:
        return _result_download_failure_v1("failure-candidate-invalid", root)
    val proof = parse_build_worker_failure_proof_v1(
        metadata.failure_proof)
    if proof == nil:
        return _result_download_failure_v1("failure-proof-invalid", root)
    val confirmed = proof.unwrap()
    if confirmed.request_digest != sha256_text(
            encode_build_worker_request_v1(request)) or
       confirmed.attempt_id != request.attempt.attempt_id or
       confirmed.fence != request.fence or
       confirmed.result_digest != sha256_text(metadata.result_wire):
        return _result_download_failure_v1("failure-proof-mismatch", root)
    BuildResultFetchV1(true, false, "", root, "", "",
        metadata.result_wire)

fn fetch_build_result_sftp_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, local_state_dir: text,
        expected_result_wire: text) -> BuildResultFetchV1:
    fetch_build_result_sftp_limited_v1(config, request, local_state_dir,
        expected_result_wire, _result_default_limits_v1())

fn fetch_build_failure_sftp_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, local_state_dir: text,
        expected_result_wire: text) -> BuildResultFetchV1:
    fetch_build_failure_sftp_limited_v1(config, request, local_state_dir,
        expected_result_wire, _result_default_limits_v1())

export BuildResultFetchPlanV1, BuildResultFetchV1
export BuildResultDownloadBudgetV1, plan_build_result_download_budget_v1
export BuildResultTransferLimitsV1
export plan_build_result_download_budget_limited_v1
export plan_build_result_sftp_v1, plan_build_failure_sftp_v1
export plan_build_result_metadata_sftp_v1
export fetch_build_result_sftp_v1, fetch_build_failure_sftp_v1
export fetch_build_result_sftp_limited_v1, fetch_build_failure_sftp_limited_v1
