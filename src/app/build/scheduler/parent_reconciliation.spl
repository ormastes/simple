# Startup-only recovery for an admission that never reached request upload.
# A spooled request may have reached the worker and needs remote status proof;
# do not release its fence or capacity from a timeout or missing heartbeat.
use app.io.mod.{file_exists}
use app.build.scheduler.owner.{SchedulerOwnerV1}
use app.build.scheduler.parent_request_spool.{
    parent_build_intent_matches_attempt_v1}

struct BuildParentReconciliationV1:
    resolved: bool
    revoked: bool
    reason: text
    new_fence: i64

fn _reconciliation_id_valid_v1(value: text) -> bool:
    if value == "" or value.len() > 128 or value == "." or value == "..":
        return false
    for c in value.chars():
        if not ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
               (c >= "0" and c <= "9") or c == "_" or c == "-" or c == "."):
            return false
    true

fn reconcile_unstarted_parent_attempt_v1(owner: SchedulerOwnerV1,
        attempt_id: text) -> BuildParentReconciliationV1:
    """Durably revoke only a replayed attempt that has no request spool."""
    if owner.lock_handle < 0 or owner.error != "" or owner.state.error != "" or
       not owner.recovery_phase or not _reconciliation_id_valid_v1(attempt_id):
        return BuildParentReconciliationV1(false, false,
            "startup-owner-required", 0)
    var found = false
    var intent_matched = false
    for attempt in owner.state.ledger.attempts:
        if attempt.attempt_id == attempt_id and attempt.active:
            found = true
            intent_matched = parent_build_intent_matches_attempt_v1(owner,
                attempt)
    if not found:
        return BuildParentReconciliationV1(false, false,
            "attempt-not-active", 0)
    if not intent_matched:
        return BuildParentReconciliationV1(false, false,
            "spool-protocol-unproven", 0)
    # The driver creates and syncs this file before any upload. The owner root
    # is trusted, locked and never concurrently mutated during startup replay.
    if file_exists(owner.root + "/requests/" + attempt_id + ".wire"):
        return BuildParentReconciliationV1(false, false,
            "spooled-attempt-needs-worker-status", 0)
    val revoked = owner.revoke(attempt_id)
    if not revoked.acknowledged:
        return BuildParentReconciliationV1(false, false,
            "revoke: " + revoked.error, 0)
    BuildParentReconciliationV1(true, true, "", revoked.fence)

export BuildParentReconciliationV1, reconcile_unstarted_parent_attempt_v1
