# Freeze all uploaded bytes before scheduler admission. Source/generated bytes
# come from the trusted snapshot root; dependency bytes come from retained CAS.
# The prepared SFTP batches contain only private snapshot paths and are never
# rebuilt after the parent reserves capacity.
use app.io.mod.{secure_temp_dir, dir_create_all, dir_remove_all,
    file_atomic_write, file_fsync, file_hash_sha256, file_size_raw,
    file_is_regular_no_follow}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1,
    BuildSftpPlanV1, transfer_prepared_build_inputs_sftp_v1,
    BUILD_SFTP_MAX_FILES_V1, BUILD_SFTP_MAX_FILE_BYTES_V1,
    BUILD_SFTP_MAX_TOTAL_BYTES_V1}
use app.build.scheduler.trusted_request_upload.{BuildRequestUploadPlanV1,
    BuildRequestUploadV1, plan_build_request_upload_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1}
use app.build.scheduler.worker_ready.{BUILD_WORKER_CONTROL_DIRECTORY_V1,
    worker_ready_control_collision_v1}
use compiler.driver.cache.binary_object_cas.{binary_object_cas_blob_path}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use std.common.io.read_only_file_view.{read_only_file_view_open_v1,
    read_only_file_view_read_v1, read_only_file_view_close_v1}
use std.common.io.file_read_policy.{FileReadPolicyV1}
use std.async.cancellation.{CancellationToken}
use std.nogc_sync_mut.io.file.{FileHandle}
use std.common.crypto.sha256.{sha256_text, sha256_stream_v1_new,
    sha256_stream_v1_update, sha256_stream_v1_finish_hex}

val PREPARED_SNAPSHOT_COPY_CHUNK_BYTES_V1: u64 = 1048576u64

struct PreparedBuildUploadV1:
    ready: bool
    reason: text
    root: text
    plan: BuildRequestUploadPlanV1
    input_batch_path: text
    control_batch_path: text
    control_batch: text

fn _empty_upload_plan_v1() -> BuildRequestUploadPlanV1:
    BuildRequestUploadPlanV1(false, "unprepared", "", "", "", "",
        BuildSftpPlanV1(false, "unprepared", "", "", 0, 0))

fn _prepared_reject_v1(reason: text, root: text) -> PreparedBuildUploadV1:
    var final_reason = reason
    var retained_root = ""
    if root != "" and not dir_remove_all(root):
        final_reason = reason + "-cleanup-failed"
        retained_root = root
    PreparedBuildUploadV1(false, final_reason, retained_root,
        _empty_upload_plan_v1(), "", "", "")

fn _snapshot_segment_v1(segment: text) -> bool:
    if segment == "" or segment == "." or segment == ".." or
       segment.len() > 128 or segment.starts_with("-"):
        return false
    for c in segment.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "_" or c == "-" or c == ".":
            continue
        return false
    true

fn _snapshot_path_v1(path: text, absolute: bool) -> bool:
    if path == "" or path.len() > 4096 or
       path.starts_with("/") != absolute or path.ends_with("/") or
       path.contains("//"):
        return false
    val parts = path.split("/")
    var i: i64 = if absolute: 1 else: 0
    while i < parts.len():
        if not _snapshot_segment_v1(parts[i]): return false
        i = i + 1
    true

fn _snapshot_put_v1(source_root: text, source: text,
        snapshot_root: text,
        logical: text, digest: text, total: i64) -> (i64, text):
    if not _snapshot_path_v1(logical, false) or
       worker_ready_control_collision_v1(logical):
        return (total, "snapshot-logical-path-invalid")
    if not _snapshot_path_v1(source_root, true) or
       not _snapshot_path_v1(source, true) or
       not scheduler_action_digest_valid_v1(digest) or
       total < 0 or total > BUILD_SFTP_MAX_TOTAL_BYTES_V1:
        return (total, "snapshot-source-unavailable")
    val opened = read_only_file_view_open_v1(source_root, source,
        digest, FileReadPolicyV1.buffered)
    if opened.is_err(): return (total, "snapshot-source-unavailable")
    var view = opened.unwrap()
    val size = view.identity.size
    if size > BUILD_SFTP_MAX_FILE_BYTES_V1.to_u64() or
       size > (BUILD_SFTP_MAX_TOTAL_BYTES_V1 - total).to_u64():
        val _ = read_only_file_view_close_v1(view)
        return (total, "snapshot-source-size-invalid")
    val parts = logical.split("/")
    var parent = snapshot_root
    var i: i64 = 0
    while i + 1 < parts.len():
        parent = parent + "/" + parts[i]
        if not dir_create_all(parent):
            val _ = read_only_file_view_close_v1(view)
            return (total, "snapshot-directory-unavailable")
        i = i + 1
    val destination = snapshot_root + "/" + logical
    val created = FileHandle.create(destination)
    if created.is_err():
        val _ = read_only_file_view_close_v1(view)
        return (total, "snapshot-write-mismatch")
    var destination_handle = created.unwrap()
    val stream = sha256_stream_v1_new()
    val cancellation = CancellationToken.new()
    var offset: u64 = 0u64
    var error = ""
    while offset < size:
        val remaining = size - offset
        val length = if remaining > PREPARED_SNAPSHOT_COPY_CHUNK_BYTES_V1:
            PREPARED_SNAPSHOT_COPY_CHUNK_BYTES_V1 else: remaining
        val read = read_only_file_view_read_v1(&view, offset, length,
            cancellation)
        if read.is_err():
            error = "snapshot-source-unavailable"
            break
        val chunk = read.unwrap().bytes
        if chunk.len().to_u64() != length or
           not sha256_stream_v1_update(stream, chunk):
            error = "snapshot-source-unavailable"
            break
        if destination_handle.write_all(chunk).is_err():
            error = "snapshot-write-mismatch"
            break
        offset = offset + length
    if error == "":
        val observed = sha256_stream_v1_finish_hex(stream)
        if observed == nil or observed.unwrap() != digest:
            error = "snapshot-source-digest-mismatch"
    val destination_closed = destination_handle.close()
    val source_closed = read_only_file_view_close_v1(view)
    if error != "": return (total, error)
    if destination_closed.is_err() or source_closed.is_err():
        return (total, "snapshot-write-mismatch")
    val size_i64 = size.to_i64()
    if not file_is_regular_no_follow(destination) or
       file_size_raw(destination) != size_i64 or
       file_hash_sha256(destination) != digest or
       not file_fsync(destination):
        return (total, "snapshot-write-mismatch")
    (total + size_i64, "")

fn prepare_build_request_upload_v1(config: TrustedSftpConfigV1,
        request: BuildWorkerRequestV1, source_root: text,
        retained_cas_root: text,
        private_parent: text) -> PreparedBuildUploadV1:
    """Create one private immutable-byte snapshot before intent or admission."""
    if not _snapshot_path_v1(source_root, true) or
       not _snapshot_path_v1(retained_cas_root, true) or
       not _snapshot_path_v1(private_parent, true):
        return _prepared_reject_v1("snapshot-root-invalid", "")
    val count = request.action.inputs.source_inputs.len() +
        request.action.inputs.generated_inputs.len() +
        request.action.inputs.dependency_outputs.len()
    if count <= 0 or count > BUILD_SFTP_MAX_FILES_V1:
        return _prepared_reject_v1("snapshot-input-count-invalid", "")
    val created = secure_temp_dir(private_parent, "build-upload-snapshot")
    if created.is_err():
        return _prepared_reject_v1("snapshot-directory-unavailable", "")
    val root = created.unwrap()
    val snapshot_root = root + "/inputs"
    if not dir_create_all(snapshot_root):
        return _prepared_reject_v1("snapshot-directory-unavailable", root)
    var total: i64 = 0
    var seen: [text] = []
    for item in request.action.inputs.source_inputs:
        if seen.contains(item.logical_path):
            return _prepared_reject_v1("snapshot-duplicate-path", root)
        seen.push(item.logical_path)
        val (next_total, problem) = _snapshot_put_v1(
            source_root,
            source_root + "/" + item.logical_path, snapshot_root,
            item.logical_path, item.content_digest, total)
        if problem != "": return _prepared_reject_v1(problem, root)
        total = next_total
    for item in request.action.inputs.generated_inputs:
        if seen.contains(item.logical_path):
            return _prepared_reject_v1("snapshot-duplicate-path", root)
        seen.push(item.logical_path)
        val (next_total, problem) = _snapshot_put_v1(
            source_root,
            source_root + "/" + item.logical_path, snapshot_root,
            item.logical_path, item.content_digest, total)
        if problem != "": return _prepared_reject_v1(problem, root)
        total = next_total
    for item in request.action.inputs.dependency_outputs:
        if seen.contains(item.output_path):
            return _prepared_reject_v1("snapshot-duplicate-path", root)
        seen.push(item.output_path)
        val cas_path = binary_object_cas_blob_path(retained_cas_root,
            item.content_digest)
        if cas_path == "":
            return _prepared_reject_v1("dependency-object-unavailable", root)
        val (next_total, problem) = _snapshot_put_v1(retained_cas_root,
            cas_path,
            snapshot_root, item.output_path, item.content_digest, total)
        if problem != "": return _prepared_reject_v1(problem, root)
        total = next_total
    val plan = plan_build_request_upload_v1(config, request, snapshot_root)
    if not plan.valid:
        return _prepared_reject_v1(plan.reason, root)
    val input_batch_path = root + "/inputs.batch"
    val request_path = root + "/request.wire"
    val ready_path = root + "/ready"
    val control_batch_path = root + "/control.batch"
    val remote_control = plan.remote_attempt_root + "/" +
        BUILD_WORKER_CONTROL_DIRECTORY_V1
    val control_batch = "mkdir " + remote_control + "\n" +
        "put " + request_path + " " + remote_control + "/request.wire\n" +
        "put " + ready_path + " " + remote_control + "/ready\n"
    if not file_atomic_write(input_batch_path, plan.input_plan.batch) or
       not file_atomic_write(request_path, plan.request_wire) or
       not file_atomic_write(ready_path, plan.ready_wire) or
       not file_atomic_write(control_batch_path, control_batch) or
       not file_fsync(input_batch_path) or not file_fsync(request_path) or
       not file_fsync(ready_path) or not file_fsync(control_batch_path):
        return _prepared_reject_v1("prepared-batch-unavailable", root)
    PreparedBuildUploadV1(true, "", root, plan,
        input_batch_path, control_batch_path, control_batch)

fn transfer_prepared_build_request_v1(config: TrustedSftpConfigV1,
        prepared: PreparedBuildUploadV1) -> BuildRequestUploadV1:
    """Perform only remote work after admission; caller releases the snapshot."""
    if not prepared.ready or prepared.root == "" or
       prepared.plan.request_digest != sha256_text(prepared.plan.request_wire):
        return BuildRequestUploadV1(false, "prepared-upload-invalid", "", "")
    val inputs = transfer_prepared_build_inputs_sftp_v1(config,
        prepared.plan.input_plan, prepared.input_batch_path)
    if not inputs.transferred:
        return BuildRequestUploadV1(false, inputs.reason, "", "")
    val control = BuildSftpPlanV1(true, "", prepared.control_batch,
        prepared.plan.remote_attempt_root, 2,
        prepared.plan.request_wire.len() + prepared.plan.ready_wire.len())
    val uploaded = transfer_prepared_build_inputs_sftp_v1(config,
        control, prepared.control_batch_path)
    if not uploaded.transferred:
        return BuildRequestUploadV1(false, uploaded.reason, "", "")
    BuildRequestUploadV1(true, "", prepared.plan.request_digest,
        prepared.plan.remote_attempt_root)

fn release_prepared_build_request_v1(prepared: PreparedBuildUploadV1) -> bool:
    # A failed preparation can retain its private root when cleanup itself
    # failed. The caller must still be able to retry removal by that exact root.
    prepared.root != "" and dir_remove_all(prepared.root)

export PreparedBuildUploadV1, prepare_build_request_upload_v1
export transfer_prepared_build_request_v1, release_prepared_build_request_v1
