# Image-resident worker. This entrypoint is ONLY for the isolated verifier OCI
# image, never the exported artifact's host. The parent must pin image + worker,
# confine the worker separately from the artifact, and destroy OCI before using
# these files. Unavailable V4 cgroup isolation fails closed, without downgrade.
use app.io.mod.{get_args, file_write_bytes, file_create_exclusive, file_fsync,
    directory_fsync, file_hash_sha256, secure_temp_dir}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.process.observation_v4.{ProcessObservationRequestV4,
    ProcessObservationReceiptV4, ProcessObservationFailureReasonV4,
    ProcessObservationStatusV4, ProcessObservationEnforcementKindV4,
    ProcessObservationDescendantPolicyV4, freeze_process_observation_receipt_v4}
use std.nogc_sync_mut.io.process_observation_v4.{OwnedExecutablePin,
    OwnedCwdPinV4, process_observation_capabilities_v4,
    process_observation_start_pinned_v4}
# Reuse the byte-accurate frozen-receipt/ack owner, NOT OCI logs invocation.
use std.nogc_async_mut.container.providers.linux.oci_exact_logs_v1.{
    OciExactLogSessionV1, OciExactLogStartFailureV1, OciExactLogBytesV1,
    oci_exact_log_stream_complete_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}

val DIST_EXEC_WORKER_ARTIFACT_V1 = "/simple-build/inputs/artifact"
val DIST_EXEC_WORKER_OUTPUT_V1 = "/simple-build/outputs"

pub fn dist_exec_worker_hex_v1(bytes: [u8]) -> text:
    val digits = "0123456789abcdef"
    var output = ""
    for byte in bytes:
        val number = byte.to_i64()
        output = output + digits[number / 16:number / 16 + 1] +
            digits[number % 16:number % 16 + 1]
    output

fn dist_exec_worker_nonce_valid_v1(nonce: text) -> bool:
    if nonce.len() != 32: return false
    for ch in nonce.chars():
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return false
    true

pub fn dist_exec_worker_args_valid_v1(args: [text]) -> bool:
    if args.len() != 8 or args[0] != "--artifact-sha256" or
       args[2] != "--nonce" or args[4] != "--wall-ms" or
       args[6] != "--stream-limit-bytes" or
       not scheduler_action_digest_valid_v1(args[1]) or
       not dist_exec_worker_nonce_valid_v1(args[3]): return false
    val wall = args[5].to_i64() ?? -1
    val limit = args[7].to_i64() ?? -1
    wall > 0 and wall <= 60000 and wall.to_text() == args[5] and
        limit > 0 and limit <= 16777216 and limit.to_text() == args[7]

fn start_dist_exec_worker_v1(digest: text, wall_ms: i64,
        limit: i64) -> Result<OciExactLogSessionV1, OciExactLogStartFailureV1>:
    if not scheduler_action_digest_valid_v1(digest) or wall_ms <= 0 or
       wall_ms > 60000 or limit <= 0 or limit > 16777216:
        return Err(OciExactLogStartFailureV1.without_pins("worker-arguments-invalid"))
    val caps = match process_observation_capabilities_v4():
        case Ok(value): value
        case Err(reason): return Err(OciExactLogStartFailureV1.without_pins(reason))
    if not caps.available or caps.runtime_error != 0 or
       caps.max_capture_bytes < limit or caps.max_caller_wait_ns <= 0:
        return Err(OciExactLogStartFailureV1.without_pins("worker-v4-unavailable"))
    # Owned runtime ABI currently advertises POV4_CAP_LEADER_ONLY (1 << 8).
    # It rejects Cgroup requests and hardcodes tree_empty=false. Reject before
    # pins or child startup; absence of this bit still requires runtime proof.
    if (caps.capability_bits & 256) != 0:
        return Err(OciExactLogStartFailureV1.without_pins("worker-descendant-containment-unavailable"))
    var executable = match OwnedExecutablePin.pin(DIST_EXEC_WORKER_ARTIFACT_V1):
        case Ok(pin): pin
        case Err(reason): return Err(OciExactLogStartFailureV1.without_pins(reason))
    val measured = match executable.digest():
        case Ok(value): value
        case Err(reason): return Err(OciExactLogStartFailureV1(reason, Some(executable), None))
    if measured.len() != 32 or dist_exec_worker_hex_v1(measured) != digest:
        return Err(OciExactLogStartFailureV1("worker-artifact-pin-mismatch", Some(executable), None))
    var cwd = match OwnedCwdPinV4.pin(DIST_EXEC_WORKER_OUTPUT_V1):
        case Ok(pin): pin
        case Err(reason): return Err(OciExactLogStartFailureV1(reason, Some(executable), None))
    val request = ProcessObservationRequestV4(
        argv: [DIST_EXEC_WORKER_ARTIFACT_V1], environment: [],
        canonical_cwd: DIST_EXEC_WORKER_OUTPUT_V1,
        canonical_pinned_directory: DIST_EXEC_WORKER_OUTPUT_V1,
        executable_pin: 0, executable_digest: [], cwd_pin_claim: 0,
        cwd_identity_digest: [], capability_bits: caps.capability_bits,
        wall_budget_ns: wall_ms * 1000000, term_grace_ns: 1000000000,
        cleanup_budget_ns: 10000000000, stdout_limit_bytes: limit,
        stderr_limit_bytes: limit, memory_limit_bytes: 0,
        enforcement_kind: ProcessObservationEnforcementKindV4.None,
        descendant_policy: ProcessObservationDescendantPolicyV4.Cgroup,
        max_clock_resolution_ns: 1000000)
    val started = match process_observation_start_pinned_v4(executable, cwd, request):
        case Ok(value): value
        case Err(reason): return Err(OciExactLogStartFailureV1(reason, Some(executable), Some(cwd)))
    if started.receipt.packet.status == ProcessObservationStatusV4.Rejected:
        return Err(OciExactLogStartFailureV1("worker-v4-request-rejected", Some(executable), Some(cwd)))
    Ok(OciExactLogSessionV1(lease: started.lease, executable: executable,
        cwd: cwd, executable_sha256: measured, max_wait_ns: caps.max_caller_wait_ns,
        acknowledged: false, pending_output: None))

pub fn dist_exec_worker_receipt_v1(nonce: text, artifact_digest: text,
        output: OciExactLogBytesV1) -> Result<text, text>:
    if not dist_exec_worker_nonce_valid_v1(nonce) or
       not scheduler_action_digest_valid_v1(artifact_digest) or
       dist_exec_worker_hex_v1(output.executable_sha256) != artifact_digest or
       output.stderr.len() != 0 or output.stdout_sha256 != sha256_u8_hex(output.stdout) or
       output.stderr_sha256 != sha256_u8_hex(output.stderr) or
       output.receipt_binding.len() != 32:
        return Err("worker-output-binding-invalid")
    Ok("simple-dist-exec-worker-result-v1\nnonce=" + nonce +
        "\nartifact-sha256=" + artifact_digest + "\nexit-code=0\nstdout-bytes=" +
        output.stdout.len().to_text() + "\nstdout-sha256=" + output.stdout_sha256 +
        "\nstderr-bytes=0\nv4-binding=" + dist_exec_worker_hex_v1(output.receipt_binding) + "\n")

fn publish_dist_exec_worker_v1(nonce: text, digest: text,
        output: OciExactLogBytesV1) -> Result<text, text>:
    val receipt = dist_exec_worker_receipt_v1(nonce, digest, output)?
    # Create AFTER confirmed cgroup empty. Never overwrite artifact-created
    # paths or publish a receipt before bytes have reached durable storage.
    val stage = secure_temp_dir(DIST_EXEC_WORKER_OUTPUT_V1, "result-" + nonce)?
    val stdout_path = stage + "/stdout.bin"
    if not file_write_bytes(stdout_path, output.stdout) or not file_fsync(stdout_path) or
       file_hash_sha256(stdout_path) != output.stdout_sha256 or
       not file_create_exclusive(stage + "/receipt", receipt) or
       not file_fsync(stage + "/receipt") or not directory_fsync(stage) or
       not directory_fsync(DIST_EXEC_WORKER_OUTPUT_V1):
        return Err("worker-result-persistence-failed")
    # Fixed exclusive pointer is the commit marker, published last. A hostile
    # precreated marker fails; it is never interpreted as successful output.
    if not file_create_exclusive(DIST_EXEC_WORKER_OUTPUT_V1 + "/committed", stage + "\n") or
       not file_fsync(DIST_EXEC_WORKER_OUTPUT_V1 + "/committed") or
       not directory_fsync(DIST_EXEC_WORKER_OUTPUT_V1):
        return Err("worker-commit-marker-failed")
    Ok(stage)

fn main() -> i64:
    var args = get_args()
    if args.len() == 9 and (args[0].ends_with("/simple_dist_exec_worker") or
            args[0] == "simple_dist_exec_worker"):
        args = args[1:]
    if not dist_exec_worker_args_valid_v1(args): return 2
    val started = start_dist_exec_worker_v1(args[1], args[5].to_i64() ?? -1,
        args[7].to_i64() ?? -1)
    var session = match started:
        case Ok(value): value
        case Err(value):
            var failure = value
            val cleanup = failure.cleanup()
            # Parent must destroy the whole OCI attempt even if cleanup fails.
            return 2
    # Collect once in this owner scope; do not copy mutable lease authority
    # into a helper argument. No engine/log argv builder is used here.
    val receipt = match session.lease.collect(session.max_wait_ns):
        case Ok(value): value
        case Err(reason):
            val cancelled = session.cancel()
            val cleanup = session.finish_cleanup(session.max_wait_ns)
            return 2
    val frozen = match freeze_process_observation_receipt_v4(receipt):
        case Ok(value): value
        case Err(reason):
            val cancelled = session.cancel()
            val cleanup = session.finish_cleanup(session.max_wait_ns)
            return 2
    if not receipt.packet.tree_control_available or not receipt.packet.tree_empty or
       receipt.packet.exit_code != 0 or receipt.packet.signal_number != 0 or
       receipt.packet.failure_reason != ProcessObservationFailureReasonV4.Unknown or
       receipt.packet.errno_value != 0 or receipt.packet.limit_event_bits != 0 or
       receipt.packet.term_attempted or receipt.packet.kill_attempted or
       not oci_exact_log_stream_complete_v1(receipt.packet.stdout, receipt.stdout) or
       not oci_exact_log_stream_complete_v1(receipt.packet.stderr, receipt.stderr) or
       receipt.stderr.len() != 0:
        val cancelled = session.cancel()
        val cleanup = session.finish_cleanup(session.max_wait_ns)
        return 2
    val output = OciExactLogBytesV1(receipt.stdout, receipt.stderr,
        sha256_u8_hex(receipt.stdout), sha256_u8_hex(receipt.stderr),
        session.executable_sha256, receipt.binding_digest)
    val ack = session.lease.acknowledge(frozen)
    if ack.is_err():
        val cleanup = session.finish_cleanup(session.max_wait_ns)
        return 2
    session.acknowledged = true
    session.pending_output = Some(output)
    val closed = session.close_pins()
    if closed.is_err():
        val cleanup = session.close_pins()
        return 2
    val published = publish_dist_exec_worker_v1(args[3], args[1], output)
    if published.is_err(): return 2
    0

export dist_exec_worker_hex_v1, dist_exec_worker_args_valid_v1
export dist_exec_worker_receipt_v1
