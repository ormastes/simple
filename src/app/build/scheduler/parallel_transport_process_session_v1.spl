"""Parent-owned isolated transport process; no production dispatch integration.

Retain a session or start failure until its explicit cleanup succeeds. Staged
handoff storage remains parent-owned throughout and is never removed here.
Only finish returns child bytes, after exact-tree policy AND live lease ack.
Protected executable/state paths are caller trust inputs, not child claims.

Integration blocker: process_observation_owner_start_pinned_v4 can return Err
after a native launch if receipt decoding/ticket validation fails, without
returning its native lease. Such failures are quarantined here, not recoverable
cleanup successes. Fix that owner boundary before enabling a production caller.
The current leader-only provider is rejected by admission before launch.
"""
use app.build.scheduler.parallel_transport_handoff_stage_v1.{StagedParallelTransportHandoffV1}
use app.build.scheduler.parallel_transport_wire_v1.{
    parse_parallel_transport_handoff_v1, PARALLEL_TRANSPORT_WIRE_MAX_BYTES_V1}
use app.build.scheduler.parallel_transport_supervisor_policy_v1.{
    parallel_transport_supervisor_capabilities_v1, parallel_transport_frozen_accept_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use app.io.mod.{file_read_regular_no_follow_bounded_bytes}
use std.io_runtime.{time_now_monotonic_ms}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.process.observation_v4.{
    ProcessObservationRequestV4, ProcessObservationStatusV4,
    ProcessObservationEnforcementKindV4, ProcessObservationDescendantPolicyV4,
    freeze_process_observation_receipt_v4,
    freeze_process_observation_cleanup_receipt_v4}
use std.nogc_sync_mut.io.process_observation_v4.{
    OwnedExecutablePin, OwnedCwdPinV4, ProcessObservationLeaseV4,
    process_observation_capabilities_v4, process_observation_start_pinned_v4}

pub struct ParallelTransportProcessLimitsV1:
    stream_limit_bytes: i64
    term_grace_ns: i64
    cleanup_budget_ns: i64
    required_live_tickets: i64

pub struct ParallelTransportProcessBytesV1:
    stdout: [u8]
    stderr: [u8]
    receipt_binding: [u8]
    executable_sha256: [u8]
    handoff_digest: text

pub fn parallel_transport_process_limits_valid_v1(limits: ParallelTransportProcessLimitsV1) -> bool:
    limits.stream_limit_bytes > 0 and limits.stream_limit_bytes <= 1048576 and
        limits.term_grace_ns >= 0 and limits.term_grace_ns <= 5000000000 and
        limits.cleanup_budget_ns > 0 and limits.cleanup_budget_ns <= 10000000000 and
        limits.required_live_tickets > 0

fn transport_process_path_valid_v1(path: text) -> bool:
    if not path.starts_with("/") or path.len() < 2 or path.len() > 4096 or
            path.contains("\0") or path.contains("//") or path.ends_with("/"):
        return false
    val parts = path.split("/")
    for part in parts[1:]:
        if part == "." or part == ".." or part == "": return false
    true

# This owner also represents partial startup. Failed close retains its pin.
pub class ParallelTransportProcessStartFailureV1:
    var reason: text
    staged: StagedParallelTransportHandoffV1
    var launch_uncertain: bool
    var executable: Option<OwnedExecutablePin>
    var cwd: Option<OwnedCwdPinV4>

    me fn cleanup() -> Result<text, text>:
        # The V4 facade can fail decoding after native launch and return no
        # lease. Keep every available owner; only an owner-layer repair can
        # resolve this uncertainty. In particular, never delete either root.
        if self.launch_uncertain:
            return Err("unowned-launch-uncertain;retain-pins-and-staged-handoff")
        var failure = ""
        match self.executable:
            case Some(owner):
                var pin = owner
                val result = pin.close()
                self.executable = Some(pin)
                match result:
                    case Ok(closed):
                        if closed: self.executable = None
                        else: failure = "executable-close-incomplete"
                    case Err(reason): failure = reason
            case None: pass
        match self.cwd:
            case Some(owner):
                var pin = owner
                val result = pin.close()
                self.cwd = Some(pin)
                match result:
                    case Ok(closed):
                        if closed: self.cwd = None
                        else: failure = failure + ";cwd-close-incomplete"
                    case Err(reason): failure = failure + ";" + reason
            case None: pass
        if failure != "": return Err(failure)
        Ok("pins-closed;staged-handoff-retained")

pub class ParallelTransportProcessSessionV1:
    var lease: ProcessObservationLeaseV4
    var pins: ParallelTransportProcessStartFailureV1
    executable_sha256: [u8]
    deadline_tick_ms: i64
    max_wait_ns: i64
    var acknowledged: bool
    var pending_output: Option<ParallelTransportProcessBytesV1>

    # Never leak the cancellation receipt's unvalidated child bytes.
    pub fn cancel(self) -> Result<text, text>:
        val receipt = self.lease.cancel(0)?
        Ok("cancellation-requested;collect-required")

    me fn finish(wait_ns: i64) -> Result<ParallelTransportProcessBytesV1, text>:
        if self.acknowledged:
            val closed = self.pins.cleanup()?
            match self.pending_output:
                case Some(output): return Ok(output)
                case None: return Err("transport-session-discarded")
        if wait_ns < 0 or wait_ns > self.max_wait_ns:
            return Err("transport-wait-outside-capability")
        val receipt = self.lease.collect(wait_ns)?
        val frozen = freeze_process_observation_receipt_v4(receipt)?
        if not parallel_transport_frozen_accept_v1(receipt,
                time_now_monotonic_ms(), self.deadline_tick_ms):
            return Err("transport-exact-tree-receipt-rejected")
        val acknowledged = self.lease.acknowledge(frozen)?
        self.acknowledged = true
        val output = ParallelTransportProcessBytesV1(stdout: receipt.stdout,
            stderr: receipt.stderr, receipt_binding: receipt.binding_digest,
            executable_sha256: self.executable_sha256,
            handoff_digest: self.pins.staged.digest)
        self.pending_output = Some(output)
        val closed = self.pins.cleanup()?
        Ok(output)

    # Cleanup acknowledgement releases native resources, never result authority.
    # The parent must not treat this message as an exact-tree completion proof
    # or remove staged/result roots based on cleanup-only acknowledgement.
    me fn finish_cleanup(wait_ns: i64) -> Result<text, text>:
        if self.acknowledged:
            return self.pins.cleanup()
        if wait_ns < 0 or wait_ns > self.max_wait_ns:
            return Err("transport-wait-outside-capability")
        val receipt = self.lease.collect(wait_ns)?
        match freeze_process_observation_receipt_v4(receipt):
            case Ok(frozen):
                val acknowledged = self.lease.acknowledge(frozen)?
            case Err(reason):
                val cleanup = freeze_process_observation_cleanup_receipt_v4(receipt)?
                val acknowledged = self.lease.acknowledge_cleanup(cleanup)?
        self.acknowledged = true
        self.pending_output = None
        self.pins.cleanup()

pub fn start_parallel_transport_process_v1(staged: StagedParallelTransportHandoffV1,
        protected_child_path: text, expected_sha256: [u8], approved_state_dir: text,
        deadline_tick_ms: i64, limits: ParallelTransportProcessLimitsV1) ->
        Result<ParallelTransportProcessSessionV1, ParallelTransportProcessStartFailureV1>:
    var owner = ParallelTransportProcessStartFailureV1(reason: "transport-input-invalid",
        staged: staged, launch_uncertain: false, executable: None, cwd: None)
    if not staged.ready or not transport_process_path_valid_v1(protected_child_path) or
            not transport_process_path_valid_v1(approved_state_dir) or
            not transport_process_path_valid_v1(staged.root) or
            not staged.root.starts_with(approved_state_dir + "/") or
            staged.handoff_path != staged.root + "/handoff.wire" or
            not scheduler_action_digest_valid_v1(staged.digest) or
            expected_sha256.len() != 32 or
            not parallel_transport_process_limits_valid_v1(limits):
        return Err(owner)
    # Admission precedes all pin acquisition and all native launch operations.
    val capabilities = match process_observation_capabilities_v4():
        case Ok(caps): caps
        case Err(reason):
            owner.reason = reason
            return Err(owner)
    if not parallel_transport_supervisor_capabilities_v1(capabilities,
            limits.stream_limit_bytes * 2, limits.required_live_tickets):
        owner.reason = "transport-exact-tree-provider-unavailable"
        return Err(owner)
    val read = file_read_regular_no_follow_bounded_bytes(staged.handoff_path,
        PARALLEL_TRANSPORT_WIRE_MAX_BYTES_V1)
    if read.is_err():
        owner.reason = "transport-handoff-unavailable"
        return Err(owner)
    val bytes = read.unwrap()
    val handoff = parse_parallel_transport_handoff_v1(bytes)
    if sha256_u8_hex(bytes) != staged.digest or not handoff.valid or
            handoff.approved_node == nil or handoff.deadline_tick != deadline_tick_ms:
        owner.reason = "transport-handoff-binding-mismatch"
        return Err(owner)
    if handoff.approved_node.unwrap().local_state_dir != approved_state_dir:
        owner.reason = "transport-state-root-mismatch"
        return Err(owner)
    val executable = match OwnedExecutablePin.pin(protected_child_path):
        case Ok(pin): pin
        case Err(reason):
            owner.reason = reason
            return Err(owner)
    owner.executable = Some(executable)
    val digest = executable.digest()
    if digest.is_err() or digest.unwrap() != expected_sha256:
        owner.reason = "transport-executable-digest-mismatch"
        return Err(owner)
    val cwd = match OwnedCwdPinV4.pin(approved_state_dir):
        case Ok(pin): pin
        case Err(reason):
            owner.reason = reason
            return Err(owner)
    owner.cwd = Some(cwd)
    val now_tick_ms = time_now_monotonic_ms()
    # Bound the subtraction/conversion and use the remaining absolute budget.
    if now_tick_ms < 0 or deadline_tick_ms <= now_tick_ms or
            deadline_tick_ms > 1000000000000000 or
            deadline_tick_ms - now_tick_ms > 60000:
        owner.reason = "transport-deadline-invalid"
        return Err(owner)
    val request = ProcessObservationRequestV4(
        argv: [protected_child_path, "--handoff", staged.handoff_path, "--digest", staged.digest],
        environment: [], canonical_cwd: approved_state_dir,
        canonical_pinned_directory: approved_state_dir,
        executable_pin: 0, executable_digest: [], cwd_pin_claim: 0,
        cwd_identity_digest: [], capability_bits: capabilities.capability_bits,
        wall_budget_ns: (deadline_tick_ms - now_tick_ms) * 1000000,
        term_grace_ns: limits.term_grace_ns, cleanup_budget_ns: limits.cleanup_budget_ns,
        stdout_limit_bytes: limits.stream_limit_bytes,
        stderr_limit_bytes: limits.stream_limit_bytes, memory_limit_bytes: 0,
        enforcement_kind: ProcessObservationEnforcementKindV4.None,
        descendant_policy: ProcessObservationDescendantPolicyV4.Cgroup,
        max_clock_resolution_ns: 1000000)
    val started = match process_observation_start_pinned_v4(executable, cwd, request):
        case Ok(value): value
        case Err(reason):
            owner.reason = "unowned-launch-uncertain;" + reason
            owner.launch_uncertain = true
            return Err(owner)
    if started.receipt.packet.status == ProcessObservationStatusV4.Rejected:
        owner.reason = "transport-native-request-rejected"
        return Err(owner)
    # Running, CleanupPending, and ProviderFailed all retain the returned lease.
    Ok(ParallelTransportProcessSessionV1(lease: started.lease, pins: owner,
        executable_sha256: expected_sha256, deadline_tick_ms: deadline_tick_ms,
        max_wait_ns: capabilities.max_caller_wait_ns,
        acknowledged: false, pending_output: None))

export ParallelTransportProcessLimitsV1, ParallelTransportProcessBytesV1
export ParallelTransportProcessStartFailureV1, ParallelTransportProcessSessionV1
export parallel_transport_process_limits_valid_v1, start_parallel_transport_process_v1
