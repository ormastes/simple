# Stage the declared byte inputs for one trusted Linux OCI build attempt.
# The source root and state directory are private, stable owner inputs. This
# layer verifies copied bytes; it cannot prove that compiler discovery listed
# every source read or protect against a hostile parent-directory symlink swap.
use app.io.mod.{dir_create_all, dir_remove_all, secure_temp_dir,
    file_is_regular_no_follow, file_size_raw, file_hash_sha256, file_copy}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use compiler.common.build_contract.{ActionSpec, AttemptSpec,
    action_spec_digest_v1, input_manifest_digest_v1}

val BUILD_WORKER_MAX_INPUT_BYTES_V1: i64 = 268435456
val BUILD_WORKER_MAX_TOTAL_BYTES_V1: i64 = 1073741824
val BUILD_WORKER_MAX_INPUTS_V1: i64 = 256

struct BuildInputStageV1:
    staged: bool
    reason: text
    stage_root: text
    input_root: text
    output_root: text
    input_manifest_digest: text
    input_bytes: i64

struct _BuildInputCopyV1:
    reason: text
    size: i64

fn _worker_stage_name_v1(value: text) -> bool:
    if value.len() == 0 or value.len() > 128 or value.starts_with("-"):
        return false
    for c in value.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "-" or c == "_" or c == ".":
            continue
        return false
    true

fn _worker_stage_path_v1(path: text) -> bool:
    path.starts_with("/") and path.len() > 1 and path.len() <= 4096 and
        not path.ends_with("/") and not path.contains("//") and
        not path.contains("\n") and not path.contains("\r") and
        not path.split("/").contains(".") and
        not path.split("/").contains("..")

fn _worker_stage_reject_v1(root: text, reason: text) -> BuildInputStageV1:
    if root != "" and not dir_remove_all(root):
        return BuildInputStageV1(false, reason + "-cleanup-failed", root,
            "", "", "", 0)
    BuildInputStageV1(false, reason, "", "", "", "", 0)

fn _worker_copy_input_v1(source_root: text, input_root: text,
        logical_path: text, digest: text) -> _BuildInputCopyV1:
    if not scheduler_action_digest_valid_v1(digest):
        return _BuildInputCopyV1("input-digest-invalid", 0)
    val source = source_root + "/" + logical_path
    val destination = input_root + "/" + logical_path
    if not file_is_regular_no_follow(source):
        return _BuildInputCopyV1("input-not-regular", 0)
    val size = file_size_raw(source)
    if size < 0 or size > BUILD_WORKER_MAX_INPUT_BYTES_V1:
        return _BuildInputCopyV1("input-size-invalid", 0)
    if file_hash_sha256(source) != digest:
        return _BuildInputCopyV1("input-digest-mismatch", 0)
    val slash = destination.last_index_of("/")
    if slash < input_root.len() or
       not dir_create_all(destination[0:slash]):
        return _BuildInputCopyV1("input-parent-unavailable", 0)
    if not file_copy(source, destination) or
       not file_is_regular_no_follow(destination) or
       file_size_raw(destination) != size or
       file_hash_sha256(destination) != digest:
        return _BuildInputCopyV1("input-copy-mismatch", 0)
    _BuildInputCopyV1("", size)

fn stage_build_inputs_v1(action: ActionSpec, attempt: AttemptSpec,
        pod_uid: text, attempt_number: i64, source_root: text,
        state_dir: text) -> BuildInputStageV1:
    """Make a private attempt mount with independently checked listed bytes.

    The caller retains the resulting private directory until the container
    stops and must separately attest snapshot and discovery completeness.
    """
    val action_digest = action_spec_digest_v1(action)
    if action_digest == "" or attempt.version != 1 or
       attempt.action_digest != action_digest or
       not _worker_stage_name_v1(pod_uid) or attempt_number <= 0 or
       attempt_number > 1000000000 or
       not _worker_stage_path_v1(source_root) or
       not _worker_stage_path_v1(state_dir):
        return _worker_stage_reject_v1("", "attempt-or-root-invalid")
    if action.inputs.env_inputs.len() != 0:
        return _worker_stage_reject_v1("", "environment-unmaterialized")
    val count = action.inputs.source_inputs.len() +
        action.inputs.generated_inputs.len() +
        action.inputs.dependency_outputs.len()
    if count <= 0 or count > BUILD_WORKER_MAX_INPUTS_V1:
        return _worker_stage_reject_v1("", "input-count-invalid")
    val parent = state_dir + "/build-attempts"
    if not dir_create_all(parent):
        return _worker_stage_reject_v1("", "attempt-parent-unavailable")
    val created = secure_temp_dir(parent,
        pod_uid + "-" + attempt_number.to_text())
    if created.is_err():
        return _worker_stage_reject_v1("", "attempt-directory-unavailable")
    val root = created.unwrap()
    val input_root = root + "/inputs"
    val output_root = root + "/outputs"
    if not dir_create_all(input_root) or not dir_create_all(output_root):
        return _worker_stage_reject_v1(root, "attempt-mounts-unavailable")
    var total: i64 = 0
    for item in action.inputs.source_inputs:
        val copied = _worker_copy_input_v1(source_root, input_root,
            item.logical_path, item.content_digest)
        if copied.reason != "" or copied.size > BUILD_WORKER_MAX_TOTAL_BYTES_V1 - total:
            return _worker_stage_reject_v1(root,
                if copied.reason != "": copied.reason else: "input-total-bound")
        total = total + copied.size
    for item in action.inputs.generated_inputs:
        val copied = _worker_copy_input_v1(source_root, input_root,
            item.logical_path, item.content_digest)
        if copied.reason != "" or copied.size > BUILD_WORKER_MAX_TOTAL_BYTES_V1 - total:
            return _worker_stage_reject_v1(root,
                if copied.reason != "": copied.reason else: "input-total-bound")
        total = total + copied.size
    for item in action.inputs.dependency_outputs:
        val copied = _worker_copy_input_v1(source_root, input_root,
            item.output_path, item.content_digest)
        if copied.reason != "" or copied.size > BUILD_WORKER_MAX_TOTAL_BYTES_V1 - total:
            return _worker_stage_reject_v1(root,
                if copied.reason != "": copied.reason else: "input-total-bound")
        total = total + copied.size
    BuildInputStageV1(true, "", root, input_root, output_root,
        input_manifest_digest_v1(action.inputs), total)

export BUILD_WORKER_MAX_INPUT_BYTES_V1, BUILD_WORKER_MAX_TOTAL_BYTES_V1
export BUILD_WORKER_MAX_INPUTS_V1, BuildInputStageV1, stage_build_inputs_v1
