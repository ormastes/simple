# Protected CLI entrypoint for running one complete parent build graph.
use app.io.mod.{get_args, file_read_regular_no_follow_bounded}
use app.build.scheduler.parent_cli.{DistBuildConfigV1,
    DIST_BUILD_CONFIG_MAX_BYTES_V1, parse_dist_build_config_v1}
use app.build.scheduler.worker_request.{BUILD_WORKER_REQUEST_MAX_BYTES_V1}
use app.build.scheduler.parent_graph_manifest.{
    ParentGraphManifestV1, PARENT_GRAPH_MANIFEST_MAX_BYTES_V1,
    parse_parent_graph_manifest_v1}
use app.build.scheduler.parent_graph_request.{
    ParentGraphRequestV1, PARENT_GRAPH_MAX_WIRE_BYTES_V1,
    admit_parent_graph_requests_v1}
use app.build.scheduler.parent_graph_runner.{run_parent_graph_v1}
use app.build.scheduler.parent_staged_link_cli.{
    parent_staged_link_cli_selected_v1, run_parent_staged_link_cli_v1}
use std.common.crypto.sha256.{sha256_text}

val PARENT_GRAPH_RUNNER_MAX_WORKERS_V1: i64 = 16

struct ParentGraphRunnerArgsV1:
    valid: bool
    graph_manifest_digest: text
    config_paths: [text]

fn _parent_graph_runner_digest_v1(value: text) -> bool:
    if value.len() != 64: return false
    for ch in value.chars():
        if not ((ch >= "0" and ch <= "9") or
                (ch >= "a" and ch <= "f")):
            return false
    true

fn parse_parent_graph_runner_args_v1(args: [text]) -> ParentGraphRunnerArgsV1:
    val invalid = ParentGraphRunnerArgsV1(false, "", [])
    var remaining = args
    if remaining.len() > 0 and
       (remaining[0].ends_with("parent_graph_runner_main.spl") or
        remaining[0].ends_with("simple-parent-graph-runner") or
        remaining[0].ends_with("parent_graph_runner_main.exe") or
        remaining[0].ends_with("simple-parent-graph-runner.exe") or
        remaining[0].ends_with("simple_dist_build_parent") or
        remaining[0].ends_with("simple_dist_build_parent.exe")):
        remaining = remaining[1:]
    if remaining.len() > 0 and remaining[0] == "--":
        remaining = remaining[1:]
    if remaining.len() < 4 or
       remaining.len() > PARENT_GRAPH_RUNNER_MAX_WORKERS_V1 * 2 + 2 or
       remaining[0] != "--graph-digest" or
       not _parent_graph_runner_digest_v1(remaining[1]):
        return invalid
    val graph_digest = remaining[1]
    var paths: [text] = []
    var i: i64 = 2
    while i < remaining.len():
        if remaining[i] != "--config" or i + 1 >= remaining.len(): return invalid
        val path = remaining[i + 1]
        if not path.starts_with("/") or path.len() < 2 or
           path.len() > 4096 or path.ends_with("/"):
            return invalid
        paths.push(path)
        i = i + 2
    if paths.len() == 0 or paths.len() > PARENT_GRAPH_RUNNER_MAX_WORKERS_V1:
        return invalid
    ParentGraphRunnerArgsV1(true, graph_digest, paths)

fn _parent_graph_runner_load_workers_v1(paths: [text]) -> [DistBuildConfigV1]?:
    var workers: [DistBuildConfigV1] = []
    for path in paths:
        val read = file_read_regular_no_follow_bounded(path,
            DIST_BUILD_CONFIG_MAX_BYTES_V1)
        if read.is_err(): return nil
        val config = parse_dist_build_config_v1(read.unwrap())
        if config == nil or config.unwrap().graph_path == "": return nil
        workers.push(config.unwrap())
    workers

fn load_pinned_parent_graph_manifest_v1(path: text,
        protected_digest: text) -> ParentGraphManifestV1?:
    if not _parent_graph_runner_digest_v1(protected_digest): return nil
    val manifest_read = file_read_regular_no_follow_bounded(path,
        PARENT_GRAPH_MANIFEST_MAX_BYTES_V1)
    if manifest_read.is_err() or
       sha256_text(manifest_read.unwrap()) != protected_digest:
        return nil
    val manifest = parse_parent_graph_manifest_v1(manifest_read.unwrap())
    if not manifest.valid: return nil
    manifest

fn _parent_graph_runner_graph_v1(worker: DistBuildConfigV1,
        protected_digest: text) -> ParentGraphRequestV1?:
    val pinned_manifest = load_pinned_parent_graph_manifest_v1(
        worker.graph_path, protected_digest)
    if pinned_manifest == nil: return nil
    val manifest = pinned_manifest.unwrap()
    var wires: [text] = []
    var total_bytes: i64 = 0
    for entry in manifest.entries:
        val request_read = file_read_regular_no_follow_bounded(entry.path,
            BUILD_WORKER_REQUEST_MAX_BYTES_V1)
        if request_read.is_err() or
           sha256_text(request_read.unwrap()) != entry.digest:
            return nil
        val wire = request_read.unwrap()
        total_bytes = total_bytes + wire.len()
        if total_bytes > PARENT_GRAPH_MAX_WIRE_BYTES_V1: return nil
        wires.push(wire)
    val graph = admit_parent_graph_requests_v1(wires, "",
        worker.node.ssh.node.worker_id, 0)
    if not graph.valid: return nil
    graph

fn main() -> i64:
    val args = get_args()
    if parent_staged_link_cli_selected_v1(args):
        return run_parent_staged_link_cli_v1(args)
    val command = parse_parent_graph_runner_args_v1(args)
    if not command.valid:
        print("parent-graph: BLOCKED reason=expected-graph-digest-and-one-to-sixteen-config-paths")
        return 2
    val workers = _parent_graph_runner_load_workers_v1(command.config_paths)
    if workers == nil:
        print("parent-graph: BLOCKED reason=config-unreadable-invalid-or-not-graph")
        return 1
    val configs = workers.unwrap()
    val graph = _parent_graph_runner_graph_v1(configs[0],
        command.graph_manifest_digest)
    if graph == nil:
        print("parent-graph: BLOCKED reason=graph-manifest-or-request-invalid")
        return 1
    val result = run_parent_graph_v1(graph.unwrap(), configs, 0)
    if result.complete:
        print("parent-graph: COMPLETED accepted={result.accepted_count} attempt={result.last_attempt_id}")
        return 0
    val reason = result.reason.replace("\n", " ").replace("\r", " ")
    print("parent-graph: INCOMPLETE reason={reason} accepted={result.accepted_count} attempt={result.last_attempt_id} reconciliation={result.reconciliation_required}")
    1

export ParentGraphRunnerArgsV1, parse_parent_graph_runner_args_v1
export load_pinned_parent_graph_manifest_v1
