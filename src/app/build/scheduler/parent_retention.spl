# Parent-side immutable retention for the first binary-output Linux build path.
# A downloaded result is only a candidate until every declared binary output,
# manifest and diagnostic blob is reverified in content-addressed storage.
use app.io.mod.{file_read_regular_no_follow_bounded,
    file_read_regular_no_follow_bounded_bytes, file_fsync, directory_fsync}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1}
use app.build.scheduler.trusted_result_download.{BuildResultFetchV1}
use app.build.scheduler.trusted_worker_invocation.{validate_build_worker_reply_v1}
use app.build.scheduler.dispatch_wire.{encode_build_dispatch_v1}
use app.build.scheduler.worker_failure_proof.{
    parse_build_worker_failure_proof_v1,
    BUILD_WORKER_FAILURE_PROOF_MAX_V1}
use app.build.scheduler.worker_output.{verify_build_outputs_v1,
    BUILD_OUTPUT_MANIFEST_MAX_BYTES_V1, BUILD_OUTPUT_MAX_DIAGNOSTIC_BYTES_V1}
use compiler.driver.cache.binary_object_cas.{binary_object_cas_blob_path}
use app.build.scheduler.retained_binary_cas.{retained_binary_cas_put_v1,
    retained_binary_cas_verify_v1}
use compiler.driver.cache.cas_store.{cas_put, cas_get, cas_blob_path}
use compiler.common.cache.canonical_identity.{canonical_identity_sort_texts}
use std.common.crypto.sha256.{sha256_text}

pub val BUILD_PARENT_MAX_BINARY_OUTPUT_BYTES_V1: i64 = 268435456

struct RetainedBuildResultV1:
    retained: bool
    reason: text
    output_manifest_digest: text
    output_digests: [text]
    manifest_blob_digest: text
    diagnostic_blob_digest: text

struct RetainedBuildFailureV1:
    retained: bool
    reason: text
    diagnostic_blob_digest: text

fn _retention_reject_v1(reason: text) -> RetainedBuildResultV1:
    RetainedBuildResultV1(false, reason, "", [], "", "")

fn _retention_root_v1(path: text) -> bool:
    path.starts_with("/") and path.len() > 1 and path.len() <= 4096 and
        not path.ends_with("/") and not path.contains("//") and
        not path.contains("\n") and not path.contains("\r") and
        not path.split("/").contains(".") and
        not path.split("/").contains("..")

fn _retention_parent_v1(path: text) -> text:
    val slash = path.last_index_of("/")
    if slash == 0: "/" else: path[0:slash]

fn _retention_sync_blob_v1(root: text, digest: text,
        binary: bool) -> bool:
    # The root is a dedicated, non-GC parent store. Sync the payload and every
    # directory that may have been created by the CAS put before journal commit.
    val namespace = if binary: "objects" else: "cas"
    val path = if binary: binary_object_cas_blob_path(root, digest)
        else: cas_blob_path(root, digest)
    if path == "" or not file_fsync(path):
        return false
    directory_fsync(root + "/" + namespace + "/sha256/" + digest[0:2]) and
        directory_fsync(root + "/" + namespace + "/sha256") and
        directory_fsync(root + "/" + namespace) and
        directory_fsync(root) and directory_fsync(_retention_parent_v1(root))

fn retain_verified_build_result_v1(request: BuildWorkerRequestV1,
        fetch: BuildResultFetchV1, cas_root: text) -> RetainedBuildResultV1:
    """Recheck and retain all success bytes before the owner may publish."""
    if not fetch.verified or not fetch.success or fetch.output_root == "" or
       encode_build_worker_request_v1(request) == "" or
       not _retention_root_v1(fetch.stage_root) or
       not _retention_root_v1(fetch.output_root) or
       not _retention_root_v1(cas_root):
        return _retention_reject_v1("input-invalid")
    val dispatch = encode_build_dispatch_v1(request.action, request.attempt,
        request.fence, request.cpu_tokens, request.fd_tokens)
    val reply = validate_build_worker_reply_v1(dispatch, fetch.result_wire)
    if not reply.received or reply.result == nil or
       not reply.result.unwrap().candidate.success:
        return _retention_reject_v1("candidate-invalid")
    val manifest = file_read_regular_no_follow_bounded(
        fetch.output_root + "/manifest.wire", BUILD_OUTPUT_MANIFEST_MAX_BYTES_V1)
    val diagnostics = file_read_regular_no_follow_bounded(
        fetch.output_root + "/diagnostics", BUILD_OUTPUT_MAX_DIAGNOSTIC_BYTES_V1)
    if manifest.is_err() or diagnostics.is_err():
        return _retention_reject_v1("metadata-unavailable")
    val observed = verify_build_outputs_v1(request.action, request.attempt,
        request.fence, fetch.output_root, diagnostics.unwrap(),
        manifest.unwrap(), reply.result.unwrap().candidate.output_manifest_digest)
    if not observed.valid or observed.manifest_digest != fetch.verified_manifest_digest or
       observed.diagnostic_digest != reply.result.unwrap().candidate.diagnostic_digest:
        return _retention_reject_v1("observation-mismatch")
    val names = canonical_identity_sort_texts(request.action.output_paths)
    val lines = manifest.unwrap()[0:manifest.unwrap().len() - 1].split("\n")
    if lines.len() != names.len() + 7:
        return _retention_reject_v1("manifest-layout-invalid")
    var output_digests: [text] = []
    var i: i64 = 0
    for name in names:
        val bytes = file_read_regular_no_follow_bounded_bytes(
            fetch.output_root + "/" + name, BUILD_PARENT_MAX_BINARY_OUTPUT_BYTES_V1)
        if bytes.is_err():
            return _retention_reject_v1("binary-output-unavailable")
        val digest = retained_binary_cas_put_v1(cas_root, name, bytes.unwrap())
        val row = lines[i + 7].split("|")
        if row.len() != 3 or row[0] != name or
           row[1] != bytes.unwrap().len().to_text() or row[2] != digest or
           digest == "" or not _retention_sync_blob_v1(cas_root, digest, true) or
           not retained_binary_cas_verify_v1(cas_root, name, digest):
            return _retention_reject_v1("binary-output-not-retained")
        output_digests.push(digest)
        i = i + 1
    val manifest_digest = cas_put(cas_root, manifest.unwrap())
    val diagnostic_digest = cas_put(cas_root, diagnostics.unwrap())
    if manifest_digest != observed.manifest_digest or
       diagnostic_digest != observed.diagnostic_digest:
        return _retention_reject_v1("metadata-not-retained")
    if not _retention_sync_blob_v1(cas_root, manifest_digest, false) or
       not _retention_sync_blob_v1(cas_root, diagnostic_digest, false):
        return _retention_reject_v1("metadata-not-durable")
    val retained_manifest = cas_get(cas_root, manifest_digest)
    val retained_diagnostics = cas_get(cas_root, diagnostic_digest)
    if retained_manifest == nil or retained_diagnostics == nil or
       retained_manifest.unwrap() != manifest.unwrap() or
       retained_diagnostics.unwrap() != diagnostics.unwrap():
        return _retention_reject_v1("metadata-not-retained")
    RetainedBuildResultV1(true, "", observed.manifest_digest,
        output_digests, manifest_digest, diagnostic_digest)

fn retain_verified_build_failure_v1(request: BuildWorkerRequestV1,
        fetch: BuildResultFetchV1, cas_root: text) -> RetainedBuildFailureV1:
    """Keep exact failed-action diagnostics before an unclassified journal row."""
    if not fetch.verified or fetch.success or fetch.output_root != "" or
       encode_build_worker_request_v1(request) == "" or
       not _retention_root_v1(fetch.stage_root) or
       not _retention_root_v1(cas_root):
        return RetainedBuildFailureV1(false, "input-invalid", "")
    val dispatch = encode_build_dispatch_v1(request.action, request.attempt,
        request.fence, request.cpu_tokens, request.fd_tokens)
    val reply = validate_build_worker_reply_v1(dispatch, fetch.result_wire)
    if not reply.received or reply.result == nil or
       reply.result.unwrap().candidate.success or
       reply.result.unwrap().candidate.output_manifest_digest != "":
        return RetainedBuildFailureV1(false, "candidate-invalid", "")
    val output_root = fetch.stage_root + "/outputs"
    val manifest = file_read_regular_no_follow_bounded(
        output_root + "/manifest.wire", BUILD_OUTPUT_MANIFEST_MAX_BYTES_V1)
    val diagnostics = file_read_regular_no_follow_bounded(
        output_root + "/diagnostics", BUILD_OUTPUT_MAX_DIAGNOSTIC_BYTES_V1)
    val proof_read = file_read_regular_no_follow_bounded(
        output_root + "/failure-proof.wire",
        BUILD_WORKER_FAILURE_PROOF_MAX_V1)
    if manifest.is_err() or diagnostics.is_err() or manifest.unwrap() != "" or
       sha256_text(diagnostics.unwrap()) !=
           reply.result.unwrap().candidate.diagnostic_digest:
        return RetainedBuildFailureV1(false, "diagnostics-mismatch", "")
    if proof_read.is_err():
        return RetainedBuildFailureV1(false, "failure-proof-unavailable", "")
    val proof = parse_build_worker_failure_proof_v1(proof_read.unwrap())
    if proof == nil:
        return RetainedBuildFailureV1(false, "failure-proof-invalid", "")
    val confirmed = proof.unwrap()
    if confirmed.request_digest != sha256_text(
            encode_build_worker_request_v1(request)) or
       confirmed.attempt_id != request.attempt.attempt_id or
       confirmed.fence != request.fence or
       confirmed.result_digest != sha256_text(fetch.result_wire):
        return RetainedBuildFailureV1(false, "failure-proof-mismatch", "")
    val digest = cas_put(cas_root, diagnostics.unwrap())
    if digest != reply.result.unwrap().candidate.diagnostic_digest or
       not _retention_sync_blob_v1(cas_root, digest, false):
        return RetainedBuildFailureV1(false, "diagnostics-not-durable", "")
    val retained = cas_get(cas_root, digest)
    if retained == nil or retained.unwrap() != diagnostics.unwrap():
        return RetainedBuildFailureV1(false, "diagnostics-not-retained", "")
    RetainedBuildFailureV1(true, "", digest)

export BUILD_PARENT_MAX_BINARY_OUTPUT_BYTES_V1
export RetainedBuildResultV1, RetainedBuildFailureV1
export retain_verified_build_result_v1, retain_verified_build_failure_v1
