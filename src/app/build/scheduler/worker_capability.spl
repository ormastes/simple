# Canonical, bounded capability metadata. Observation belongs to the host leaf;
# request admission still checks local policy at launch.
use app.build.scheduler.worker_sandbox_identity.{build_worker_sandbox_digest_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use compiler.common.build_contract.{ToolchainManifest}

val BUILD_WORKER_CAPABILITY_MAX_BYTES_V1: i64 = 4096

struct BuildWorkerCapabilityV1:
    worker_id: text
    execution_os: text
    execution_arch: text
    boot_id: text
    provider_generation: i64
    provider_id: text
    engine: text
    privilege: text
    image: text
    compiler_entry: text
    toolchain: ToolchainManifest
    sandbox_digest: text
    resource_policy_digest: text
    cpu_limit: i64
    memory_limit: i64
    nonce: text

fn _cap_token_v1(value: text) -> bool:
    if value == "" or value.len() > 128 or value == "." or value == ".." or
       value.starts_with("-"):
        return false
    for c in value.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "-" or c == "_" or c == ".":
            continue
        return false
    true

fn _cap_image_v1(image: text) -> bool:
    if image.len() < 73 or image.len() > 512 or image.starts_with("-"):
        return false
    val marker = image.index_of("@sha256:")
    if marker < 1 or marker + 8 + 64 != image.len() or
       not scheduler_action_digest_valid_v1(image[marker + 8:]):
        return false
    for c in image.chars():
        if c <= " " or c == "\x7f": return false
    true

fn _cap_path_v1(path: text) -> bool:
    if not path.starts_with("/") or path.len() > 512 or path.ends_with("/"):
        return false
    val segments = path.split("/")
    var i: i64 = 1
    while i < segments.len():
        if not _cap_token_v1(segments[i]): return false
        i = i + 1
    true

fn _cap_nat_v1(value: text, maximum: i64) -> i64:
    if value == "" or value.len() > 16: return -1
    for c in value.chars():
        if c < "0" or c > "9": return -1
    val number = value.to_i64() ?? -1
    if number <= 0 or number > maximum or number.to_text() != value: return -1
    number

fn _cap_keys_v1() -> [text]:
    ["worker", "execution-os", "execution-arch", "boot-id",
     "provider-generation", "provider-id", "engine", "privilege", "image",
     "compiler-entry",
     "tool-executable", "tool-behavior", "provider-abi", "runtime", "sysroot",
     "target", "sandbox", "resource-policy", "cpu", "memory", "nonce"]

fn _cap_values_v1(cap: BuildWorkerCapabilityV1) -> [text]:
    [cap.worker_id, cap.execution_os, cap.execution_arch, cap.boot_id,
     cap.provider_generation.to_text(), cap.provider_id, cap.engine, cap.privilege,
     cap.image, cap.compiler_entry, cap.toolchain.executable_digest,
     cap.toolchain.behavior_digest,
     cap.toolchain.provider_abi_digest, cap.toolchain.runtime_digest,
     cap.toolchain.sysroot_digest, cap.toolchain.target_triple,
     cap.sandbox_digest, cap.resource_policy_digest, cap.cpu_limit.to_text(),
     cap.memory_limit.to_text(), cap.nonce]

fn encode_build_worker_capability_v1(cap: BuildWorkerCapabilityV1) -> text:
    """Encode bounded canonical capability metadata, or empty for invalid input."""
    val values = _cap_values_v1(cap)
    if not _cap_token_v1(values[0]) or values[1] != "linux" or
       not _cap_token_v1(values[2]) or not _cap_token_v1(values[3]) or
       cap.provider_generation <= 0 or cap.provider_generation > 1000000000 or
       values[5] != "linux-oci-v1" or
       not ["podman", "docker"].contains(values[6]) or
       ((values[6] == "podman" and values[7] != "rootless") or
        (values[6] == "docker" and values[7] != "root")) or
       not _cap_image_v1(values[8]) or not _cap_path_v1(values[9]) or
       cap.toolchain.version != 1 or not _cap_token_v1(values[15]) or
       cap.sandbox_digest != build_worker_sandbox_digest_v1(
           cap.image, cap.engine, cap.compiler_entry) or
       cap.cpu_limit <= 0 or cap.cpu_limit > 1000000 or
       cap.memory_limit <= 0 or cap.memory_limit > 1000000000000000:
        return ""
    for index in [10, 11, 12, 13, 14, 16, 17, 20]:
        if not scheduler_action_digest_valid_v1(values[index]): return ""
    val keys = _cap_keys_v1()
    var wire = "simple-build-worker-capability-v1\n"
    var i: i64 = 0
    while i < keys.len():
        wire = wire + keys[i] + "=" + values[i] + "\n"
        i = i + 1
    if wire.len() > BUILD_WORKER_CAPABILITY_MAX_BYTES_V1: return ""
    wire

fn parse_build_worker_capability_v1(wire: text) -> BuildWorkerCapabilityV1?:
    """Accept only the exact canonical V1 wire with one trailing newline."""
    if wire.len() == 0 or wire.len() > BUILD_WORKER_CAPABILITY_MAX_BYTES_V1 or
       not wire.ends_with("\n") or wire.contains("\r") or wire.contains("\x00"):
        return nil
    val keys = _cap_keys_v1()
    val lines = wire[0:wire.len() - 1].split("\n")
    if lines.len() != keys.len() + 1 or
       lines[0] != "simple-build-worker-capability-v1":
        return nil
    var values: [text] = []
    var i: i64 = 0
    while i < keys.len():
        val prefix = keys[i] + "="
        if not lines[i + 1].starts_with(prefix): return nil
        values.push(lines[i + 1][prefix.len():])
        i = i + 1
    val generation = _cap_nat_v1(values[4], 1000000000)
    val cpu = _cap_nat_v1(values[18], 1000000)
    val memory = _cap_nat_v1(values[19], 1000000000000000)
    if generation < 0 or cpu < 0 or memory < 0: return nil
    val cap = BuildWorkerCapabilityV1(values[0], values[1], values[2], values[3],
        generation, values[5], values[6], values[7], values[8], values[9],
        ToolchainManifest(1, values[10], values[11], values[12], values[13],
            values[14], values[15]), values[16], values[17], cpu, memory,
        values[20])
    if encode_build_worker_capability_v1(cap) != wire: return nil
    cap

export BuildWorkerCapabilityV1, BUILD_WORKER_CAPABILITY_MAX_BYTES_V1
export encode_build_worker_capability_v1, parse_build_worker_capability_v1
